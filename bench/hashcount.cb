// Benchmark: counting keys in a HashMap<String, u32>. The same workload
// as hashcount.rs, written the same way.

import std;

fn main()
{
    HashMap<String, u32> counts = HashMap::new();
    Rng rng = Rng::new(12345);
    foreach (i in 0..200000)
    {
        *HashMap::entry(&mut counts, sprintf("w%v", Rng::below(&mut rng, 5000)), 0) += 1;
    }
    printf("%v\n", HashMap::len(&counts));
}
