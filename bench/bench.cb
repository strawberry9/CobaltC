// Benchmark: two CPU-bound workloads, matched line for line by bench.rs.
//   1. Sieve of Eratosthenes over a Vec<bool> up to 100,000,000.
//   2. Longest Collatz chain for starting values below 1,000,000.

import std;

fn sieve_count(usize limit) : u64
{
    Vec<bool> is_prime = Vec::new();
    usize i = 0;
    while (i < limit)
    {
        Vec::push(&mut is_prime, i >= 2);
        i = i + 1;
    }
    usize p = 2;
    while (p * p < limit)
    {
        if (*Vec::index_shared(&is_prime, p))
        {
            usize m = p * p;
            while (m < limit)
            {
                *Vec::index_exclusive(&mut is_prime, m) = false;
                m = m + p;
            }
        }
        p = p + 1;
    }
    u64 n = 0;
    usize k = 0;
    while (k < limit)
    {
        if (*Vec::index_shared(&is_prime, k))
        {
            n = n + 1;
        }
        k = k + 1;
    }
    n
}

fn collatz_len(u64 start) : u64
{
    u64 x = start;
    u64 steps = 1;
    while (x != 1)
    {
        if (x % 2 == 0)
        {
            x = x / 2;
        }
        else
        {
            x = 3 * x + 1;
        }
        steps = steps + 1;
    }
    steps
}

fn main()
{
    printf("primes below 100000000: ");
    printf("%d\n", sieve_count(100000000));

    u64 best = 0;
    u64 best_start = 0;
    u64 s = 1;
    while (s < 1000000)
    {
        u64 len = collatz_len(s);
        if (len > best)
        {
            best = len;
            best_start = s;
        }
        s = s + 1;
    }
    printf("longest collatz chain below 1000000: start %d, length %d\n", best_start, best);
}
