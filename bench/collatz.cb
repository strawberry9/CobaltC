// Benchmark: the Collatz half of bench.cb on its own -- the longest
// chain for starting values below 1,000,000. Matched by collatz.rs.

import std;

fn collatz_len(u64 start) : u64
{
    u64 x = start;
    u64 steps = 1;
    while (x != 1)
    {
        if (x % 2 == 0)
        {
            x = x / 2;
        }
        else
        {
            x = 3 * x + 1;
        }
        steps = steps + 1;
    }
    steps
}

fn main()
{
    u64 best = 0;
    u64 s = 1;
    while (s < 1000000)
    {
        u64 len = collatz_len(s);
        if (len > best)
        {
            best = len;
        }
        s = s + 1;
    }
    printf("%d\n", best);
}
