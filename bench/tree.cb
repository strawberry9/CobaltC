// Benchmark: a binary search tree of Boxes, built and summed
// recursively. The same workload as tree.rs, written the same way.

import std;

struct Node
{
    i64 key;
    Option<Box<Node>> left;
    Option<Box<Node>> right;
}

fn insert(ref<Node, exclusive> n, i64 k)
{
    if (k < n.key)
    {
        match (&mut n.left)
        {
            Some(b) : insert(Box::get_mut(b), k),
            None    : n.left = Some(Box::new(Node { .key = k, .left = None, .right = None })),
        }
    }
    else
    {
        match (&mut n.right)
        {
            Some(b) : insert(Box::get_mut(b), k),
            None    : n.right = Some(Box::new(Node { .key = k, .left = None, .right = None })),
        }
    }
}

fn sum(ref<Node, shared> n) : i64
{
    i64 s = n.key;
    if (Some(b) = &n.left)
    {
        s += sum(Box::get(b));
    }
    if (Some(b) = &n.right)
    {
        s += sum(Box::get(b));
    }
    s
}

fn main()
{
    Node root = Node { .key = 500000, .left = None, .right = None };
    Rng rng = Rng::new(99);
    foreach (i in 0..60000)
    {
        insert(&mut root, narrow_wrapping<i64>(Rng::below(&mut rng, 1000000)));
    }
    printf("sum %v\n", sum(&root));
}
