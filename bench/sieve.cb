// Benchmark: the sieve half of bench.cb on its own -- the number of
// primes below 100,000,000, over a Vec<bool>. Matched by sieve.rs.

import std;

fn sieve_count(usize limit) : u64
{
    Vec<bool> is_prime = Vec::new();
    usize i = 0;
    while (i < limit)
    {
        Vec::push(&mut is_prime, i >= 2);
        i = i + 1;
    }
    usize p = 2;
    while (p * p < limit)
    {
        if (*Vec::index_shared(&is_prime, p))
        {
            usize m = p * p;
            while (m < limit)
            {
                *Vec::index_exclusive(&mut is_prime, m) = false;
                m = m + p;
            }
        }
        p = p + 1;
    }
    u64 n = 0;
    usize k = 0;
    while (k < limit)
    {
        if (*Vec::index_shared(&is_prime, k))
        {
            n = n + 1;
        }
        k = k + 1;
    }
    n
}

fn main()
{
    printf("%d\n", sieve_count(100000000));
}
