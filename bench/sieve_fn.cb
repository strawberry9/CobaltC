// Benchmark: sieve.cb's workload, with the work in functions that take the
// vector by reference -- the number of primes below 100,000,000. Matched by
// sieve_fn.rs.

import std;

fn fill(ref<Vec<bool>, exclusive> is_prime, usize limit)
{
    foreach (i in 0..limit)
    {
        Vec::push(is_prime, i >= 2);
    }
}

fn mark(ref<Vec<bool>, exclusive> is_prime, usize limit)
{
    usize p = 2;
    while (p * p < limit)
    {
        if (is_prime[p])
        {
            for (usize m = p * p; m < limit; m += p)
            {
                is_prime[m] = false;
            }
        }
        p += 1;
    }
}

fn count(ref<Vec<bool>, shared> is_prime) : u64
{
    u64 n = 0;
    foreach (k in 0..Vec::len(is_prime))
    {
        if (is_prime[k])
        {
            n += 1;
        }
    }
    n
}

fn main()
{
    usize limit = 100000000;
    Vec<bool> is_prime = Vec::new();
    fill(&mut is_prime, limit);
    mark(&mut is_prime, limit);
    printf("%d\n", count(&is_prime));
}
