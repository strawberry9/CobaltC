// Benchmark: collatz.cb with its chain arithmetic asking to wrap rather
// than be checked -- CobaltC's explicit route to unchecked arithmetic
// (spec/06 rule.arith.alt). It measures what the overflow checks cost,
// without changing the language. Matched by collatz_wrapping.rs.

import std;

fn collatz_len(u64 start) : u64
{
    u64 x = start;
    u64 steps = 1;
    while (x != 1)
    {
        if (x % 2 == 0)
        {
            x = x / 2;
        }
        else
        {
            x = wrapping_add(wrapping_mul(3, x), 1);
        }
        steps = wrapping_add(steps, 1);
    }
    steps
}

fn main()
{
    u64 best = 0;
    u64 s = 1;
    while (s < 1000000)
    {
        u64 len = collatz_len(s);
        if (len > best)
        {
            best = len;
        }
        s = s + 1;
    }
    printf("%d\n", best);
}
