// Benchmark: strings in a Vec and a HashMap -- built, counted, sorted,
// summed. The same workload as strings.rs, written the same way.

import std;

fn main()
{
    Vec<String> words = Vec::new();
    Rng rng = Rng::new(12345);
    foreach (i in 0..100000)
    {
        Vec::push(&mut words, sprintf("w%v", Rng::below(&mut rng, 5000)));
    }
    HashMap<String, u32> counts = HashMap::new();
    foreach (w in &words)
    {
        *HashMap::entry(&mut counts, String::clone(w), 0) += 1;
    }
    Vec::sort(&mut words);
    usize total = 0;
    foreach (w in &words)
    {
        total += String::len(w);
    }
    printf("%v distinct, %v bytes, first %v\n", HashMap::len(&counts), total, &words[0]);
}
