// Benchmark: records updated in place through exclusive references.
// The same workload as records.rs, written the same way.

import std;

struct Particle
{
    i64 x;
    i64 y;
    i64 vx;
    i64 vy;
}

fn step(ref<Particle, exclusive> p)
{
    p.x += p.vx;
    p.y += p.vy;
    if (p.x < 0 || p.x > 10000)
    {
        p.vx = -p.vx;
    }
    if (p.y < 0 || p.y > 10000)
    {
        p.vy = -p.vy;
    }
}

fn energy(ref<Vec<Particle>, shared> ps) : i64
{
    i64 e = 0;
    foreach (p in ps)
    {
        e += p.vx * p.vx + p.vy * p.vy;
    }
    e
}

fn main()
{
    Vec<Particle> ps = Vec::new();
    foreach (k in 0..2000: i64)
    {
        Vec::push(&mut ps, Particle { .x = k * 5, .y = k * 3, .vx = k % 7 - 3, .vy = k % 5 - 2 });
    }
    foreach (t in 0..500)
    {
        foreach (i in 0..Vec::len(&ps))
        {
            step(&mut ps[i]);
        }
    }
    printf("energy %v, first at %v %v\n", energy(&ps), ps[0].x, ps[0].y);
}
