// Hello CobaltC
//
// Shows: a string literal is a `str`, a plain *value* like an integer --
// no allocation, no owner, nothing to free -- and valid UTF-8 by
// construction, because the literal syntax cannot express anything else.
// `print` is an ordinary prelude function; the one `unsafe` write lives
// inside it, so this program never writes `unsafe` itself.

import std;

fn main()
{
    str greeting = "Hello, CobaltC!\n";
    str copy = greeting;                    // copied, not moved: a str is a value
    printf("%v", copy);

    str word = "caf\u{e9}";                 // é is one character but two UTF-8 bytes
    printf("%v is %v bytes long\n", word, str_len(word));
}
