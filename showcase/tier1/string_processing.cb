// String Processing
//
// Shows: CobaltC's two text types. A `str` literal is a constant value;
// a `String` is owned text that is *always* valid UTF-8: the only ways to
// make one copy a `str` or validate bytes, and validation is a `Result`.
// Bytes from anywhere else stay bytes until they pass that check.

import std;

fn is_vowel(u8 c) : bool
{
    c == b'a' || c == b'e' || c == b'i' || c == b'o' || c == b'u'
}

// ASCII upper-casing into new bytes; other bytes are copied unchanged.
fn shout(str s) : Vec<u8>
{
    Vec<u8> v = Vec::new();
    foreach (i in 0..str_len(s))
    {
        Vec::push(&mut v, ascii_to_upper(str_byte(s, i)));
    }
    v
}

fn main()
{
    str text = "the quick brown fox jumps over the lazy dog";
    u64 vowels = 0;
    u64 words = 1;
    foreach (i in 0..str_len(text))
    {
        u8 c = str_byte(text, i);
        if (is_vowel(c))
        {
            vowels += 1;
        }
        if (c == b' ')
        {
            words += 1;
        }
    }
    printf("%v\n  words: %v, vowels: %v\n", text, words, vowels);

    // Bytes that are valid UTF-8 become a String...
    match (String::from_utf8(shout(text)))
    {
        Ok(loud) :
        {
            printf("%v\n", &loud);
        },
        Err(_)   :
        {
            printf("unexpected: invalid UTF-8\n");
        },
    }

    // ...and bytes that are not are refused, with the offset of the problem.
    Vec<u8> bad = Vec::new();
    Vec::push(&mut bad, b'h');
    Vec::push(&mut bad, b'i');
    Vec::push(&mut bad, 255);                  // never valid in UTF-8
    match (String::from_utf8(bad))
    {
        Ok(_)  :
        {
            printf("unexpected: accepted\n");
        },
        Err(e) :
        {
            printf("rejected: invalid UTF-8 at byte %v\n", e.offset);
        },
    }

    String owned = "caf\u{e9}";  // from a str: already valid, just copied
    printf("String::from_str(\"café\") has %v bytes and %v characters\n",
        String::len(&owned), Vec::len(&String::chars(&owned)));   // é is two bytes, one character
}
