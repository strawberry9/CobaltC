// Showcase: an inclusive range reaches the end of its type.
//
// `foreach (b in 0..=255: u8)` visits every byte value, 255 included, with a
// `u8` counter that never overflows. The half-open `0..256` cannot be
// written for a `u8` (256 is not one), and C's `for (uint8_t b = 0; b <= 255;
// b++)` never ends, since `b++` at 255 wraps to 0. `lo..=hi` stops at `hi`;
// when `hi` is below `lo` it runs no turn.

import std;

fn main()
{
    u32 control = 0;
    u32 printable = 0;
    u32 high = 0;
    foreach (b in 0..=255: u8)
    {
        if (b < 32 || b == 127)
        {
            control += 1;
        }
        else if (b < 127)
        {
            printable += 1;
        }
        else
        {
            high += 1;
        }
    }
    printf("bytes: %v control, %v printable, %v above 127\n", control, printable, high);

    // Every value of i8, both ends included: -128 + ... + 127.
    i32 sum = 0;
    u32 count = 0;
    foreach (x in min_value<i8>()..=max_value<i8>())
    {
        sum += widen<i32>(x);
        count += 1;
    }
    printf("i8: %v values, summing to %v\n", count, sum);

    // 1 to 10, the last one counted, and a range whose top is below its bottom.
    u64 product = 1;
    foreach (k in 1..=10: u64)
    {
        product *= k;
    }
    u32 turns = 0;
    foreach (k in 5..=4: u32)
    {
        turns += 1;
    }
    printf("10! = %v; 5..=4 runs %v turns\n", product, turns);
}
