// Mutable Vector
//
// Shows: a growable `Vec` that owns its elements, changed only through an
// *exclusive* reference (`&mut`). There is no `mut` on variables:
// mutability belongs to the access path. `pop` hands elements back as an
// `Option`, so "empty" is a value, not a crash.

import std;

fn show(ref<Vec<i32>, shared> v)
{
    printf("[");
    foreach (i, x in v)
    {
        if (i > 0)
        {
            printf(", ");
        }
        printf("%v", x);
    }
    printf("]\n");
}

// Doubles every element in place through one exclusive borrow.
fn double_all(ref<Vec<i32>, exclusive> v)
{
    foreach (slot in v)
    {
        *slot *= 2;
    }
}

fn main()
{
    Vec<i32> v = Vec::new();
    foreach (n in 1..6: i32)
    {
        Vec::push(&mut v, n);
    }
    show(&v);
    double_all(&mut v);
    show(&v);

    printf("popping:");
    while (Some(x) = Vec::pop(&mut v))          // until pop gives None
    {
        printf(" %v", x);
    }
    printf("\nlength now %v\n", Vec::len(&v));
}                                       // v is destroyed here: its buffer is freed
