// Result / Error Propagation
//
// Shows: recoverable failure is a `Result` value, and `?` passes an error
// up to the caller in one character. There are no exceptions: every
// function that can fail says so in its return type, and the error type
// is an ordinary enum carrying where it went wrong.

import std;

enum ParseError
{
    Empty,
    BadDigit(usize),        // the position of the offending character
    TooLarge
}

fn digit(str s, usize at) : Result<u32, ParseError>
{
    u8 c = str_byte(s, at);
    if (c < 48 || c > 57)
    {
        return Err(BadDigit(at));
    }
    Ok(widen<u32>(c - 48))
}

fn parse(str s) : Result<u32, ParseError>
{
    usize n = str_len(s);
    if (n == 0)
    {
        return Err(Empty);
    }
    u32 value = 0;
    usize i = 0;
    while (i < n)
    {
        u32 d = digit(s, i)?;                   // a bad digit returns from parse, error and all
        value = match (checked_mul(value, 10))
        {
            Some(v) : v,
            None :
            {
                return Err(TooLarge);
            },
        };
        value = match (checked_add(value, d))
        {
            Some(v) : v,
            None :
            {
                return Err(TooLarge);
            },
        };
        i = i + 1;
    }
    Ok(value)
}

// Two parses and a sum: either one's failure is this function's failure.
fn add_strings(str a, str b) : Result<u32, ParseError>
{
    u32 x = parse(a)?;
    u32 y = parse(b)?;
    match (checked_add(x, y))
    {
        Some(s) : Ok(s),
        None : Err(TooLarge),
    }
}

fn report(str a, str b)
{
    printf("\"%v\" + \"%v\" -> ", a, b);
    match (add_strings(a, b))
    {
        Ok(v) :
        {
            printf("%v", v);
        },
        Err(e) :
        {
            match (e)
            {
                Empty :
                {
                    printf("error: empty input");
                },
                BadDigit(at) :
                {
                    printf("error: not a digit at position %v", at);
                },
                TooLarge :
                {
                    printf("error: does not fit in u32");
                },
            }
        },
    }
    printf("\n");
}

fn main()
{
    report("1200", "34");
    report("12x4", "1");
    report("7", "");
    report("4000000000", "300000000");
}
