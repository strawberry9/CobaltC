// Generic Function
//
// Shows: generics without traits. A generic body may only store, move,
// pass and borrow its `T` -- nothing that needs to know what `T` is -- so
// every instantiation that type-checks is correct by construction. Type
// arguments are inferred from arguments or from the expected type.

import std;

struct Pair<A, B>
{
    A first;
    B second;
}

fn make_pair<A, B>(A a, B b) : Pair<A, B>
{
    Pair { .first = a, .second = b }
}

// One reference parameter, so the returned reference needs no annotation:
// it is known to borrow from `p`.
fn first_of<A, B>(ref<Pair<A, B>, shared> p) : ref<A, shared>
{
    &p.first
}

fn swap<T>(ref<T, exclusive> x, ref<T, exclusive> y)
{
    auto t = *x;
    *x = *y;
    *y = t;
}

fn repeat<T>(T x, usize n) : Vec<T>
{
    Vec<T> v = Vec::new();
    usize i = 0;
    while (i < n)
    {
        Vec::push(&mut v, x);
        i = i + 1;
    }
    v
}

fn main()
{
    auto p = make_pair(42, true);                 // Pair<i32, bool>, inferred
    printf("first of (42, true) = ");
    printf("%v", *first_of(&p));
    printf("\n");

    i64 x = 1;
    i64 y = 2;
    swap(&mut x, &mut y);                         // T = i64
    printf("after swap: x = %v, y = %v\n", x, y);

    Vec<u8> dashes = repeat(45: u8, 10);          // T = u8; 45 is '-'
    match (String::from_utf8(dashes))             // bytes print as text once they are a String
    {
        Ok(line) : printf("%v", &line),
        Err(_) : printf("not text"),
    }
    printf("\n");

    Vec<Pair<i32, i32>> points = repeat(make_pair(3, 4), 2);   // T = Pair<i32, i32>
    printf("repeated pairs: %v\n", Vec::len(&points));
}
