// Fibonacci
//
// Shows: checked arithmetic as a tool. `checked_add` returns `None` the
// moment a u64 would overflow, so the program can find, exactly, the
// largest Fibonacci number a u64 holds -- no wraparound, no guessing.

import std;

fn main()
{
    u64 a = 0;
    u64 b = 1;
    printf("the first 15:");
    foreach (k in 0..15)
    {
        printf(" %v", a);
        u64 next = a + b;
        a = b;
        b = next;
    }
    printf("\n");

    // Keep going until the next step would not fit.
    // The loop runs while the pattern matches: `None` ends it.
    a = 0;
    b = 1;
    u64 n = 0;
    while (Some(next) = checked_add(a, b))
    {
        a = b;
        b = next;
        n += 1;
    }
    printf("fib(%v) = %v is the largest Fibonacci number in a u64\n", n + 1, b);
}
