// Enum Calculator
//
// Shows: data-carrying enums and exhaustive `match`, with failure as a
// value. Division by zero and overflow are not crashes here: the
// calculator uses the `checked_` operations and returns a `Result`
// whose error is itself an enum.

import std;

struct Operands
{
    i64 a;
    i64 b;
}

enum Op
{
    Add(Operands),
    Sub(Operands),
    Mul(Operands),
    Div(Operands),
    Negate(i64)
}

enum CalcError
{
    DivideByZero,
    Overflow
}

fn fits(Option<i64> r) : Result<i64, CalcError>
{
    match (r)
    {
        Some(v) : Ok(v),
        None : Err(Overflow),
    }
}

fn eval(Op op) : Result<i64, CalcError>
{
    match (op)
    {
        Add(o) : fits(checked_add(o.a, o.b)),
        Sub(o) : fits(checked_sub(o.a, o.b)),
        Mul(o) : fits(checked_mul(o.a, o.b)),
        Div(o) :
        {
            if (o.b == 0)
            {
                return Err(DivideByZero);
            }
            fits(checked_div(o.a, o.b))       // i64::MIN / -1 overflows too
        },
        Negate(x) : fits(checked_sub(0, x)),
    }
}

fn show(str label, Op op)
{
    printf("%v = ", label);
    match (eval(op))
    {
        Ok(v) :
        {
            printf("%v", v);
        },
        Err(e) :
        {
            match (e)
            {
                DivideByZero :
                {
                    printf("error: division by zero");
                },
                Overflow :
                {
                    printf("error: overflow");
                },
            }
        },
    }
    printf("\n");
}

fn main()
{
    i64 big = 9223372036854775807;
    show("7 + 5", Add(Operands { .a = 7, .b = 5 }));
    show("7 - 12", Sub(Operands { .a = 7, .b = 12 }));
    show("6 * 7", Mul(Operands { .a = 6, .b = 7 }));
    show("100 / 7", Div(Operands { .a = 100, .b = 7 }));
    show("1 / 0", Div(Operands { .a = 1, .b = 0 }));
    show("max * 2", Mul(Operands { .a = big, .b = 2 }));
    show("-(-5)", Negate(-5));
}
