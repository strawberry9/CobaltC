// Array Sum
//
// Shows: fixed-size arrays with bounds-checked indexing, and checked
// arithmetic -- `+` on integers can never wrap silently. Where overflow
// is a real possibility, `checked_add` makes it a value (`Option`) the
// program must look at.

import std;

fn main()
{
    auto data = [3, 1, 4, 1, 5, 9, 2, 6];      // array<i32, 8>
    i32 sum = 0;
    usize i = 0;
    while (i < 8)
    {
        sum = sum + data[i];                   // data[8] would be diag.index-out-of-bounds
        i = i + 1;
    }
    printf("sum of 3 1 4 1 5 9 2 6 = %v\n", sum);

    // Values large enough that a plain `+` would fault with
    // diag.arith-overflow; checked_add reports it instead.
    array<i32, 4> big = [1_000_000_000, 1_000_000_000, 1_000_000_000, 7];
    i32 total = 0;
    usize k = 0;
    while (k < 4)
    {
        match (checked_add(total, big[k]))
        {
            Some(t) :
            {
                total = t;
            },
            None :
            {
                printf("adding element %v would overflow i32; the total so far is %v\n", k, total);
                return;
            },
        }
        k = k + 1;
    }
}
