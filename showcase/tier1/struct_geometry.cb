// Struct Geometry
//
// Shows: plain structs are values -- assigning one copies it, `==`
// compares field by field -- and functions are attached to a type with
// `fn Type::name`. Reading through a shared reference can never change
// what it points at.

import std;

struct Point
{
    i64 x;
    i64 y;
}

struct Rect
{
    Point low;
    Point high;
}

fn Rect::new(Point a, Point b) : Rect
{
    Rect {
        .low = Point { .x = if (a.x < b.x) { a.x } else { b.x }, .y = if (a.y < b.y) { a.y } else { b.y } },
        .high = Point { .x = if (a.x < b.x) { b.x } else { a.x }, .y = if (a.y < b.y) { b.y } else { a.y } }
    }
}

fn Rect::area(ref<Rect, shared> r) : i64
{
    (r.high.x - r.low.x) * (r.high.y - r.low.y)
}

fn Rect::contains(ref<Rect, shared> r, Point p) : bool
{
    p.x >= r.low.x && p.x <= r.high.x && p.y >= r.low.y && p.y <= r.high.y
}

fn show_point(Point p)
{
    printf("(%v, %v)", p.x, p.y);
}

fn main()
{
    auto p = Point { .x = 1, .y = 2 };
    auto q = p;                                  // a copy, not a move: Point is plain data
    q.x = 10;
    printf("p = ");
    show_point(p);
    printf(", q = ");
    show_point(q);
    printf("\n");
    printf("p == q? ");
    printf("%v", if (p == q) { "yes" } else { "no" });
    printf("; p == (1, 2)? ");
    printf("%v", if (p == Point { .x = 1, .y = 2 }) { "yes" } else { "no" });
    printf("\n");

    auto r = Rect::new(Point { .x = 5, .y = 7 }, Point { .x = -1, .y = 2 });
    printf("rectangle from ");
    show_point(r.low);
    printf(" to ");
    show_point(r.high);
    printf(", area ");
    printf("%v", Rect::area(&r));
    printf("\n");
    printf("contains (0, 3)? ");
    printf("%v", if (Rect::contains(&r, Point { .x = 0, .y = 3 })) { "yes" } else { "no" });
    printf("; contains (6, 3)? ");
    printf("%v", if (Rect::contains(&r, Point { .x = 6, .y = 3 })) { "yes" } else { "no" });
    printf("\n");
}
