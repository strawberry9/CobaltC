// FizzBuzz
//
// Shows: enums with payloads and exhaustive `match`. Classifying and
// printing are separate steps joined by a type, and forgetting a case
// in the `match` is a compile-time error, not a silent gap.

import std;

enum Word
{
    Fizz,
    Buzz,
    FizzBuzz,
    Number(u32)
}

fn classify(u32 n) : Word
{
    if (n % 15 == 0)
    {
        FizzBuzz
    }
    else if (n % 3 == 0)
    {
        Fizz
    }
    else if (n % 5 == 0)
    {
        Buzz
    }
    else
    {
        Number(n)
    }
}

fn say(Word w)
{
    match (w)
    {
        Fizz :
        {
            printf("Fizz");
        },
        Buzz :
        {
            printf("Buzz");
        },
        FizzBuzz :
        {
            printf("FizzBuzz");
        },
        Number(n) :
        {
            printf("%v", n);
        },
    }
}

fn main()
{
    u32 n = 1;
    while (n <= 20)
    {
        say(classify(n));
        printf("\n");
        n = n + 1;
    }
}
