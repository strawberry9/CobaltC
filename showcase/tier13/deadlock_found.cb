// Deadlock found
//
// Shows: two threads that lock two mutexes in opposite orders. In most
// languages that hangs, sometimes, forever. Here the thread whose wait
// would close the cycle faults with `diag.deadlock` at once, contained
// to that thread; the other then finds the mutex the failed thread held
// poisoned (`diag.mutex-poisoned`), since that thread may have left its
// interior half-changed. Neither outcome depends on timing, and the
// program goes on to report both. The fix is the usual one: take locks
// in one order everywhere.

import std;

fn transfer(
    ref<mutex<i64>, shared> from,
    ref<mutex<i64>, shared> to,
    i64 amount,
    ref<Channel<u8>, shared> mine,
    ref<Channel<u8>, shared> theirs,
) : i64
{
    auto a = lock(from);
    _ = Channel::send(mine, 1);                 // I hold my first lock...
    _ = Channel::recv(theirs);                  // ...and so do you
    auto b = lock(to);
    *a -= amount;
    *b += amount;
    *a
}

fn main()
{
    auto alice = Mutex::new(100: i64);
    auto bob = Mutex::new(100: i64);
    Channel<u8> c1 = Channel::new(1);
    Channel<u8> c2 = Channel::new(1);
    auto t1 = spawn(transfer, &alice, &bob, 10, &c1, &c2);
    auto t2 = spawn(transfer, &bob, &alice, 20, &c2, &c1);
    Vec<String> seen = Vec::new();
    foreach (r in [try_join(t1), try_join(t2)])
    {
        match (r)
        {
            Ok(v)  : Vec::push(&mut seen, sprintf("finished with %v", v)),
            Err(f) : Vec::push(&mut seen, ThreadFailure::diagnostic(&f)),
        }
    }
    Vec::sort(&mut seen);
    foreach (s in &seen)
    {
        printf("a transfer: %s\n", s);
    }
}
