// Tokens
//
// Shows: where randomness comes from. A session token must be unguessable,
// so its 32 bytes come from the operating system's secure source
// (`os_random_bytes`), never from `Rng`, whose whole future can be worked
// out from a few outputs. The bytes differ on every run, so this program
// prints only what is always true of them: the token's length as hex, and
// that two tokens differ. `Rng::from_os()` seeds an ordinary `Rng` from the
// same source — a different shuffle each run, still not a secret — while
// `Rng::new(42)` gives the same sequence everywhere, for tests.

import std;

fn token_hex() : String
{
    Vec<u8> bytes = Vec::filled(32, 0: u8);
    os_random_bytes(&mut bytes[0..$]);
    String hex = String::new();
    foreach (b in &bytes)
    {
        String::appendf(&mut hex, "%02x", *b);
    }
    hex
}

fn main()
{
    String a = token_hex();
    String b = token_hex();
    printf("token: %u hex digits\n", String::len(&a));
    printf("two tokens differ: %v\n", !String::eq(&a, &b));
    Rng fixed = Rng::new(42);
    Rng again = Rng::new(42);
    printf("Rng::new(42) twice, same first draw: %v\n", Rng::next_u64(&mut fixed) == Rng::next_u64(&mut again));
    Rng fresh = Rng::from_os();
    Vec<u32> deck = Vec::from_fn(10, [](usize i) : u32 { narrow<u32>(i) });
    usize i = Vec::len(&deck);
    while (i > 1)
    {
        usize j = narrow<usize>(Rng::below(&mut fresh, widen<u64>(i)));
        i -= 1;
        Vec::swap(&mut deck, i, j);
    }
    u32 sum = 0;
    foreach (c in &deck)
    {
        sum += *c;
    }
    printf("a shuffled deck of 10 still sums to %u\n", sum);
}
