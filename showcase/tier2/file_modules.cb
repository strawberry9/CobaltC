// Modules in Files
//
// Shows: a module's body can live in a file of its own. `module ledger
// "./file_modules/ledger.cb";` declares the module here and takes its
// items from that file, exactly as if they were written between braces.
// Files nest: ledger.cb declares `money` from a file beside it, found
// relative to ledger.cb. Privacy crosses files unchanged: an Account's
// balance is private to `ledger`, so the only way to change it is through
// the functions `ledger` exports, which never let it go negative.

import std;

module ledger "./file_modules/ledger.cb";

import ledger;                        // ledger's exports by their short names: Account, Refused, ...
import ledger::money;                 // and the nested module by its last name

fn show(ref<Account, shared> a)
{
    printf("  ");
    printf("%v", Account::owner(a));
    printf(": ");
    money::print_cents(Account::balance(a));
    printf("\n");
}

fn explain(Result<i64, Refused> r)
{
    match (r)
    {
        Ok(balance) :
        {
            printf("ok, balance ");
            money::print_cents(balance);
            printf("\n");
        },
        Err(e) : match (e)
        {
            NotPositive : printf("refused: the amount must be positive\n"),
            Insufficient(short) :
            {
                printf("refused: short by ");
                money::print_cents(short);
                printf("\n");
            },
        },
    }
}

fn main()
{
    ledger::money::main();            // the module file's `main` is an ordinary function

    Account alice = Account::open("alice");
    Account bob = Account::open("bob");
    printf("alice deposits $25.00: ");
    explain(Account::deposit(&mut alice, 2500));
    printf("alice pays bob $12.75: ");
    explain(Account::transfer(&mut alice, &mut bob, 1275));
    printf("bob pays alice $20.00: ");
    explain(Account::transfer(&mut bob, &mut alice, 2000));
    printf("alice pays bob $0.00: ");
    explain(Account::transfer(&mut alice, &mut bob, 0));
    show(&alice);
    show(&bob);

    // alice.cents = 1000000;         // ✗ diag.name-not-visible (static): the balance is ledger's
    // Account::transfer(&mut alice, &mut alice, 1);
    //                                // ✗ diag.aliasing-conflict (dynamic): one account cannot be both sides
}
