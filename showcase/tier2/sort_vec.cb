// Sorting a Vec
//
// Shows: in-place algorithms under the aliasing rules. Insertion sort
// reads one element (a copy of a plain value) and writes another through
// a fresh exclusive borrow each time -- never two conflicting references
// at once -- and every index is bounds-checked. The same generic-free
// code sorts records by a key.

import std;

struct Planet
{
    str name;
    u64 moons;
}

fn sort_numbers(ref<Vec<i64>, exclusive> v)
{
    usize i = 1;
    while (i < Vec::len(&*v))
    {
        i64 key = *Vec::index_shared(&*v, i);
        usize j = i;
        while (j > 0 && *Vec::index_shared(&*v, j - 1) > key)
        {
            i64 moved = *Vec::index_shared(&*v, j - 1);
            *Vec::index_exclusive(v, j) = moved;
            j = j - 1;
        }
        *Vec::index_exclusive(v, j) = key;
        i = i + 1;
    }
}

fn sort_by_moons(ref<Vec<Planet>, exclusive> v)
{
    usize i = 1;
    while (i < Vec::len(&*v))
    {
        Planet key = *Vec::index_shared(&*v, i);      // a plain struct: copied
        usize j = i;
        while (j > 0 && Vec::index_shared(&*v, j - 1).moons > key.moons)
        {
            Planet moved = *Vec::index_shared(&*v, j - 1);
            *Vec::index_exclusive(v, j) = moved;
            j = j - 1;
        }
        *Vec::index_exclusive(v, j) = key;
        i = i + 1;
    }
}

fn main()
{
    Vec<i64> v = Vec::new();
    auto input = [31, -4, 15, 92, 6, 5, -35, 89, 7, 0, 23, 8];
    foreach (x in input)
    {
        Vec::push(&mut v, widen<i64>(x));
    }
    sort_numbers(&mut v);
    printf("sorted:");
    foreach (x in &v)
    {
        printf(" %v", x);
    }
    printf("\n");

    Vec<Planet> ps = Vec::new();
    Vec::push(&mut ps, Planet { .name = "Jupiter", .moons = 95 });
    Vec::push(&mut ps, Planet { .name = "Earth", .moons = 1 });
    Vec::push(&mut ps, Planet { .name = "Mars", .moons = 2 });
    Vec::push(&mut ps, Planet { .name = "Venus", .moons = 0 });
    Vec::push(&mut ps, Planet { .name = "Saturn", .moons = 146 });
    sort_by_moons(&mut ps);
    printf("by moons:");
    foreach (p in &ps)
    {
        printf(" %v(%v)", p.name, p.moons);
    }
    printf("\n");
}
