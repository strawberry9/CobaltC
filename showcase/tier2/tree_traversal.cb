// Tree Traversal
//
// Shows: a binary search tree in an arena, with `Option<usize>` for
// "no child" -- there is no null. Insertion walks the tree through a
// shared borrow, then writes one link through an exclusive borrow;
// traversals are plain recursion over shared borrows.

import std;

struct Node
{
    i64 key;
    Option<usize> left;
    Option<usize> right;
}

struct Bst
{
    Vec<Node> nodes;
    Option<usize> root;
}

fn Bst::insert(ref<Bst, exclusive> t, i64 key)
{
    Vec::push(&mut t.nodes, Node { .key = key, .left = None, .right = None });
    usize fresh = Vec::len(&t.nodes) - 1;
    match (t.root)
    {
        None :
        {
            t.root = Some(fresh);
        },
        Some(r) :
        {
            usize at = r;
            bool placed = false;
            while (!placed)
            {
                Node here = *Vec::index_shared(&t.nodes, at);     // a copy: the borrow ends here
                if (key < here.key)
                {
                    match (here.left)
                    {
                        Some(next) :
                        {
                            at = next;
                        },
                        None :
                        {
                            Vec::index_exclusive(&mut t.nodes, at).left = Some(fresh);
                            placed = true;
                        },
                    }
                }
                else
                {
                    match (here.right)
                    {
                        Some(next) :
                        {
                            at = next;
                        },
                        None :
                        {
                            Vec::index_exclusive(&mut t.nodes, at).right = Some(fresh);
                            placed = true;
                        },
                    }
                }
            }
        },
    }
}

fn Bst::in_order(ref<Bst, shared> t, Option<usize> at)
{
    match (at)
    {
        None :
        {
        },
        Some(i) :
        {
            Node n = *Vec::index_shared(&t.nodes, i);
            Bst::in_order(t, n.left);
            printf(" %v", n.key);
            Bst::in_order(t, n.right);
        },
    }
}

fn Bst::pre_order(ref<Bst, shared> t, Option<usize> at)
{
    match (at)
    {
        None :
        {
        },
        Some(i) :
        {
            Node n = *Vec::index_shared(&t.nodes, i);
            printf(" %v", n.key);
            Bst::pre_order(t, n.left);
            Bst::pre_order(t, n.right);
        },
    }
}

fn Bst::height(ref<Bst, shared> t, Option<usize> at) : u64
{
    match (at)
    {
        None : 0,
        Some(i) :
        {
            Node n = *Vec::index_shared(&t.nodes, i);
            u64 l = Bst::height(t, n.left);
            u64 r = Bst::height(t, n.right);
            1 + if (l > r) { l } else { r }
        },
    }
}

fn main()
{
    auto t = Bst { .nodes = Vec::new(), .root = None };
    auto keys = [50, 30, 70, 20, 40, 60, 80, 35, 45, 65];
    foreach (k in keys)
    {
        Bst::insert(&mut t, widen<i64>(k));
    }
    printf("in order:");
    Bst::in_order(&t, t.root);
    printf("\npre order:");
    Bst::pre_order(&t, t.root);
    printf("\nheight: ");
    printf("%v", Bst::height(&t, t.root));
    printf("\n");
}
