// Parallel Computation
//
// Shows: data-parallel work with no shared mutable state at all. Each
// thread gets its range by value, computes on its own, and hands the
// answer back through `join` -- which is the only way to get it, and
// waits for it. Compiled by cobc, the threads run on separate cores.

import std;

fn is_prime(u64 n) : bool
{
    if (n < 2)
    {
        return false;
    }
    u64 d = 2;
    while (d * d <= n)
    {
        if (n % d == 0)
        {
            return false;
        }
        d = d + 1;
    }
    true
}

fn count_primes(u64 from, u64 to) : u64
{
    u64 count = 0;
    u64 n = from;
    while (n < to)
    {
        if (is_prime(n))
        {
            count = count + 1;
        }
        n = n + 1;
    }
    count
}

fn main()
{
    u64 limit = 40000;
    u64 quarter = limit / 4;
    auto h1 = spawn(count_primes, 0, quarter);
    auto h2 = spawn(count_primes, quarter, 2 * quarter);
    auto h3 = spawn(count_primes, 2 * quarter, 3 * quarter);
    auto h4 = spawn(count_primes, 3 * quarter, limit);
    u64 c1 = join(h1);
    u64 c2 = join(h2);
    u64 c3 = join(h3);
    u64 c4 = join(h4);
    printf("primes below 40000, by quarter: %v + %v + %v + %v = ", c1, c2, c3, c4);
    printf("%v\n", c1 + c2 + c3 + c4);
}
