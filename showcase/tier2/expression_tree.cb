// Expression Tree Evaluator
//
// Shows: a recursive data structure without pointers. The tree lives in
// an arena -- a Vec of nodes addressed by index -- so ownership is a
// single Vec, evaluation recurses through shared borrows of it, and
// errors (division by zero) come back as `Result` values.

import std;

struct Kids
{
    usize left;
    usize right;
}

enum Node
{
    Num(i64),
    Add(Kids),
    Sub(Kids),
    Mul(Kids),
    Div(Kids)
}

struct Tree
{
    Vec<Node> nodes;
}

fn Tree::add(ref<Tree, exclusive> t, Node n) : usize
{
    Vec::push(&mut t.nodes, n);
    Vec::len(&t.nodes) - 1
}

fn Tree::eval(ref<Tree, shared> t, usize at) : Result<i64, str>
{
    match (*Vec::index_shared(&t.nodes, at))
    {
        Num(v) : Ok(v),
        Add(k) : Ok(Tree::eval(t, k.left)? + Tree::eval(t, k.right)?),
        Sub(k) : Ok(Tree::eval(t, k.left)? - Tree::eval(t, k.right)?),
        Mul(k) : Ok(Tree::eval(t, k.left)? * Tree::eval(t, k.right)?),
        Div(k) :
        {
            i64 d = Tree::eval(t, k.right)?;
            if (d == 0)
            {
                return Err("division by zero");
            }
            Ok(Tree::eval(t, k.left)? / d)
        },
    }
}

fn Tree::show(ref<Tree, shared> t, usize at)
{
    match (*Vec::index_shared(&t.nodes, at))
    {
        Num(v) :
        {
            printf("%v", v);
        },
        Add(k) :
        {
            Tree::show_op(t, k, " + ");
        },
        Sub(k) :
        {
            Tree::show_op(t, k, " - ");
        },
        Mul(k) :
        {
            Tree::show_op(t, k, " * ");
        },
        Div(k) :
        {
            Tree::show_op(t, k, " / ");
        },
    }
}

fn Tree::show_op(ref<Tree, shared> t, Kids k, str op)
{
    printf("(");
    Tree::show(t, k.left);
    printf("%v", op);
    Tree::show(t, k.right);
    printf(")");
}

fn report(ref<Tree, shared> t, usize root)
{
    Tree::show(t, root);
    printf(" = ");
    match (Tree::eval(t, root))
    {
        Ok(v) :
        {
            printf("%v", v);
        },
        Err(why) :
        {
            printf("error: %v", why);
        },
    }
    printf("\n");
}

fn main()
{
    auto t = Tree { .nodes = Vec::new() };
    // (3 + 4) * (10 - 2 / 1)
    usize three = Tree::add(&mut t, Num(3));
    usize four = Tree::add(&mut t, Num(4));
    usize ten = Tree::add(&mut t, Num(10));
    usize two = Tree::add(&mut t, Num(2));
    usize one = Tree::add(&mut t, Num(1));
    usize sum = Tree::add(&mut t, Add(Kids { .left = three, .right = four }));
    usize quot = Tree::add(&mut t, Div(Kids { .left = two, .right = one }));
    usize diff = Tree::add(&mut t, Sub(Kids { .left = ten, .right = quot }));
    usize root = Tree::add(&mut t, Mul(Kids { .left = sum, .right = diff }));
    report(&t, root);

    // 7 / (4 - 4)
    usize seven = Tree::add(&mut t, Num(7));
    usize zero = Tree::add(&mut t, Sub(Kids { .left = four, .right = four }));
    usize bad = Tree::add(&mut t, Div(Kids { .left = seven, .right = zero }));
    report(&t, bad);
}
