// Mutex Counter
//
// Shows: the only way to share mutable state between threads is a
// `mutex`, whose interior is reachable only through the guard `lock`
// returns. The guard is a resource: the lock is released when the guard
// is destroyed, at the end of its block -- no unlock to forget.

import std;

fn worker(ref<mutex<u64>, shared> counter, u64 times) : u64
{
    u64 i = 0;
    while (i < times)
    {
        auto g = lock(counter);
        *g = *g + 1;
        i = i + 1;
    }                                        // g destroyed each iteration: unlocked
    times
}

fn main()
{
    auto counter = Mutex::new(0: u64);
    u64 expected = 0;
    {
        auto a = spawn(worker, &counter, 250);
        auto b = spawn(worker, &counter, 300);
        auto c = spawn(worker, &counter, 350);
        auto d = spawn(worker, &counter, 100);
        expected = join(a) + join(b) + join(c) + join(d);
    }
    printf("four threads added %v increments; the counter reads ", expected);
    printf("%v", *lock(&counter));
    printf("\n");
}
