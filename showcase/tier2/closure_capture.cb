// Closure Capture
//
// Shows: closures list what they capture, and the compiler checks the
// list against the body. A capture is a *borrow* unless the closure is
// `move`: a borrowing closure that writes holds an exclusive borrow for
// as long as it lives, and a `move` closure owns what it captured --
// including resources, which are destroyed with it.

import std;

resource struct Ticket
{
    u64 id;
}

fn Ticket::drop(ref<Ticket, exclusive> self)
{
    printf("  (ticket %v released)\n", self.id);
}

fn apply(fn(i64) : i64 f, i64 x) : i64
{
    f(x)
}

fn main()
{
    // Borrow capture, read-only: `offset` stays usable alongside it.
    i64 offset = 100;
    auto add = [offset](i64 x)
    {
        x + offset
    };
    printf("add(5) = ");
    printf("%v", add(5));
    printf(", offset is still %v\n", offset);

    // Borrow capture that writes: an exclusive borrow of `count` while
    // `bump` lives; `count` is readable again once the block ends.
    u64 count = 0;
    {
        auto bump = [count]()
        {
            count = count + 1;
        };
        bump();
        bump();
        bump();
    }
    printf("bumped %v times\n", count);

    // A closure as a `fn` value, passed to a function.
    printf("apply(add, 1) = ");
    printf("%v", apply(add, 1));
    printf("\n");

    // Move capture of a resource: the closure owns the ticket.
    auto t = Ticket { .id = 7 };
    {
        auto show = move [t]()
        {
            t.id
        };
        printf("closure holds ticket ");
        printf("%v", show());
        printf("\n");
    }                                        // the closure ends, and the ticket with it
    printf("done\n");
}
