// ledger.cb -- the body of module `ledger`, declared in file_modules.cb.
// A module file holds items only; it is not a program of its own.

import std;                           // imports act per module, so this one imports std too

// Another file-backed module, found relative to *this* file's directory.
export module money "./money.cb";

export enum Refused
{
    NotPositive,
    Insufficient(i64),                // the shortfall, in cents
}

// The fields are not exported: only code inside `ledger` can read or
// write them, so the balance changes only through the functions below.
export struct Account
{
    str owner;
    i64 cents;
}

export fn Account::open(str owner) : Account
{
    Account { .owner = owner, .cents = 0 }
}

export fn Account::owner(ref<Account, shared> a) : str
{
    a.owner
}

export fn Account::balance(ref<Account, shared> a) : i64
{
    a.cents
}

// Returns the new balance.
export fn Account::deposit(ref<Account, exclusive> a, i64 cents) : Result<i64, Refused>
{
    if (cents <= 0)
    {
        return Err(NotPositive);
    }
    a.cents = a.cents + cents;
    Ok(a.cents)
}

// Moves money between two accounts; never lets `from` go negative.
// Returns `from`'s new balance.
export fn Account::transfer(ref<Account, exclusive> from, ref<Account, exclusive> to, i64 cents) : Result<i64, Refused>
{
    if (cents <= 0)
    {
        return Err(NotPositive);
    }
    if (from.cents < cents)
    {
        return Err(Insufficient(cents - from.cents));
    }
    from.cents = from.cents - cents;
    to.cents = to.cents + cents;
    Ok(from.cents)
}
