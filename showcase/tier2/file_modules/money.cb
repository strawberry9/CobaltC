// money.cb -- the body of module `ledger::money`, declared in ledger.cb.

import std;

// Cents as dollars: 1275 prints as $12.75.
export fn print_cents(i64 cents)
{
    i64 c = cents;
    if (c < 0)
    {
        printf("-");
        c = -c;
    }
    printf("$%d.%02d", c / 100, c % 100);
}

// A module file is a list of items, not a program: this `main` is the
// ordinary function `ledger::money::main`, and it runs only when called.
export fn main()
{
    printf("money self-check: ");
    print_cents(1275);
    printf(" ");
    print_cents(-5);
    printf("\n");
}
