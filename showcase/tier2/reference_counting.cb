// Reference Counting
//
// Shows: shared ownership is a library type, not a language feature.
// `Rc<T>` is written in CobaltC itself (spec/21) over raw memory: each
// `Rc::clone` is another owner, and the value is destroyed exactly once,
// when the last owner goes away. `Rc::get` lends it out read-only.

import std;

resource struct Config
{
    str name;
    u64 level;
}

fn Config::drop(ref<Config, exclusive> self)
{
    printf("Config \"%v\" destroyed\n", self.name);
}

fn describe(str who, ref<Rc<Config>, shared> c)
{
    auto cfg = Rc::get(c);
    printf("%v sees %v at level %v\n", who, cfg.name, cfg.level);
}

fn main()
{
    auto shared_cfg = Rc::new(Config { .name = "production", .level = 3 });
    {
        auto a = Rc::clone(&shared_cfg);
        auto b = Rc::clone(&shared_cfg);
        describe("owner a", &a);
        describe("owner b", &b);
        printf("a and b go out of scope...\n");
    }
    describe("the original", &shared_cfg);
    printf("the last owner goes out of scope...\n");
}
