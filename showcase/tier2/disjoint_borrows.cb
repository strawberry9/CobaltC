// Disjoint Mutable Borrows
//
// Shows: CobaltC tracks borrows by *path*, not by variable. Two exclusive
// references into different fields of one struct -- or different elements
// of one array -- can be live at the same time, because they cannot
// overlap. Two into the *same* field could not: that is
// diag.aliasing-conflict.

import std;

struct Account
{
    i64 balance;
    i64 fees;
}

// Needs two exclusive references at once; the caller supplies disjoint ones.
fn charge(ref<i64, exclusive> from, ref<i64, exclusive> to, i64 amount)
{
    *from = *from - amount;
    *to = *to + amount;
}

fn main()
{
    auto acct = Account { .balance = 100, .fees = 0 };
    {
        auto b = &mut acct.balance;          // exclusive path to .balance
        auto f = &mut acct.fees;             // exclusive path to .fees -- disjoint, so allowed
        *b = *b - 10;
        *f = *f + 10;
    }
    charge(&mut acct.balance, &mut acct.fees, 5);
    printf("balance %v, fees %v\n", acct.balance, acct.fees);

    auto cells = [1, 2, 3, 4];
    {
        auto first = &mut cells[0];          // literal indices: provably different elements
        auto last = &mut cells[3];
        auto t = *first;
        *first = *last;
        *last = t;
    }
    printf("cells after swapping the ends:");
    foreach (c in &cells)
    {
        printf(" %v", c);
    }
    printf("\n");
}
