// Vec of Vecs
//
// Shows: resources inside resources. Each row of Pascal's triangle is a
// Vec<u64> owned by the outer Vec<Vec<u64>>; pushing a row *moves* it in
// (the local `row` is gone afterwards), and destroying the outer Vec
// destroys every row -- nothing to free by hand, nothing freed twice.

import std;

fn main()
{
    Vec<Vec<u64>> triangle = Vec::new();
    foreach (n in 0..12)
    {
        Vec<u64> row = Vec::new();
        foreach (k in 0..n + 1)
        {
            u64 value = if (k == 0 || k == n) { 1 } else { triangle[n - 1][k - 1] + triangle[n - 1][k] };
            Vec::push(&mut row, value);
        }
        Vec::push(&mut triangle, row);           // row moves into the triangle
    }

    foreach (r, row in &triangle)
    {
        printf("%*s", (12 - r) * 2, "");        // `*`: the width is an argument
        foreach (x in row)
        {
            printf("%4d", x);
        }
        printf("\n");
    }
}                                                // the triangle and all its rows are freed here
