// Scope Destruction (deterministic cleanup)
//
// Shows: a resource is destroyed at a moment you can point to -- the end
// of its block, last declared first; the end of the statement, for a
// temporary; or earlier, with `drop`. A moved value is destroyed once,
// by its new owner. There is no garbage collector and no leak.

import std;

resource struct Tracer
{
    str name;
}

fn Tracer::drop(ref<Tracer, exclusive> self)
{
    printf("  drop %v\n", self.name);
}

fn make(str name) : Tracer
{
    Tracer { .name = name }
}

fn consume(Tracer t)
{
    printf("  consume got %v\n", t.name);
}                                          // t is destroyed here, by its new owner

fn main()
{
    printf("block:\n");
    {
        auto a = make("a");
        auto b = make("b");
        auto c = make("c");
    }                                      // c, then b, then a

    printf("early drop:\n");
    {
        auto x = make("x");
        auto y = make("y");
        drop(x);                           // x now, not at the block's end
        printf("  end of block\n");
    }

    printf("move:\n");
    {
        auto m = make("moved");
        consume(m);                        // m's destructor runs inside consume, once
        printf("  back in main\n");
    }

    printf("temporary:\n");
    str name = make("temp").name;          // the temporary Tracer ends with this statement
    printf("  its name was ");
    printf("%v", name);                           // a str is a value: it outlives the Tracer
    printf("\n");
    printf("done\n");
}
