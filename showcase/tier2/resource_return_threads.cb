// Resource Return Across Threads
//
// Shows: owned data crosses thread boundaries by *moving*. A Vec passed to
// `spawn` belongs to the new thread (the spawning thread can no longer
// touch it); a String built in a thread comes back through `join`, owned
// by the joiner. Nothing is shared, so nothing needs a lock.

import std;

fn total(Vec<u64> numbers) : u64
{
    u64 sum = 0;
    foreach (x in &numbers)
    {
        sum = sum + *x;
    }
    sum
}                                              // numbers is destroyed here, in the worker thread

fn build_report(u64 n) : Vec<String>
{
    Vec<String> lines = Vec::new();
    Vec::push(&mut lines, String::from_str("report"));
    u64 i = 0;
    while (i < n)
    {
        Vec::push(&mut lines, String::from_str(if (i % 2 == 0) { "even line" } else { "odd line" }));
        i = i + 1;
    }
    lines
}

fn main()
{
    Vec<u64> data = Vec::new();
    u64 k = 1;
    while (k <= 100)
    {
        Vec::push(&mut data, k);
        k = k + 1;
    }
    auto h = spawn(total, data);               // data moves to the worker
    // Vec::len(&data) here would be diag.stale-binding: data has moved.
    printf("sum computed in another thread: ");
    printf("%v", join(h));
    printf("\n");

    auto r = spawn(build_report, 3);
    Vec<String> lines = join(r);               // the Vec and its Strings are now ours
    printf("lines received: %v\n", Vec::len(&lines));
    foreach (line in &lines)
    {
        printf("  %v bytes\n", String::len(line));
    }
}
