$ calc "2 * (3 + 4.5) / -0.5"
2 * (3 + 4.5) / -0.5 = -30.0
[exit 0]
$ calc "1.5e3 - 0.25 * 4"
1.5e3 - 0.25 * 4 = 1499.0
[exit 0]
$ calc "-(2 - 10) * 0.1"
-(2 - 10) * 0.1 = 0.8
[exit 0]
$ calc "2 * (3 + 4"
calc: the expression ends too early
  2 * (3 + 4
            ^
[exit 1]
$ calc "12 + 3.4.5"
calc: malformed number
  12 + 3.4.5
          ^
[exit 1]
$ calc "7 $ 2"
calc: unexpected character
  7 $ 2
    ^
[exit 1]
$ calc "1 / (2 - 2)"
calc: division by zero
[exit 2]
$ calc 1 + 2
usage: calc EXPRESSION   (one argument; quote it)
[exit 3]
