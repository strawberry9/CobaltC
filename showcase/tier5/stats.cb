// stats -- summary statistics of the numbers given as arguments.
//
//     stats 3 1 4 1 5 9 2 6
//
// Shows: program arguments (`arg_count`, `arg`, with `Result::unwrap_or`
// for one that is not UTF-8), `parse<f64>` and what its `ParseError` says, a line of output built with `String::append`,
// and `main`'s value as the exit status: 0 for a result, 1 for an
// argument that is not a number, 2 for no arguments at all. Every
// failure is a value the program reports; nothing here can crash.

import std;

// The error message for an argument that did not parse, naming the
// argument and the byte where it stopped being a number.
fn describe(usize i, ref<String, shared> text, ParseError e) : String
{
    String m = String::new();
    String::append(&mut m, "stats: argument ");
    String::append(&mut m, i + 1);
    String::append(&mut m, " (\"");
    String::append(&mut m, text);
    String::append(&mut m, "\") ");
    match (e)
    {
        Empty :
        {
            String::append(&mut m, "is empty");
        },
        Invalid(k) :
        {
            String::append(&mut m, "is not a number: byte ");
            String::append(&mut m, k);
            String::append(&mut m, " cannot continue one");
        },
        OutOfRange :
        {
            String::append(&mut m, "is too large for an f64");
        },
    }
    String::append(&mut m, "\n");
    m
}

// Insertion sort, in place: each element is read through a shared
// reborrow, `&*v`, and written back through `index_exclusive`, one
// borrow at a time.
fn sort(ref<Vec<f64>, exclusive> v)
{
    usize i = 1;
    while (i < Vec::len(&*v))
    {
        f64 x = *Vec::index_shared(&*v, i);
        usize j = i;
        while (j > 0 && *Vec::index_shared(&*v, j - 1) > x)
        {
            f64 prev = *Vec::index_shared(&*v, j - 1);
            *Vec::index_exclusive(v, j) = prev;
            j = j - 1;
        }
        *Vec::index_exclusive(v, j) = x;
        i = i + 1;
    }
}

fn line(str label, f64 value) : String
{
    String s = String::from_str(label);
    String::append(&mut s, value);
    String::append(&mut s, "\n");
    s
}

fn main() : u8
{
    usize n = arg_count();
    if (n == 0)
    {
        eprintf("usage: stats NUMBER...\n");
        return 2;
    }
    Vec<f64> xs = Vec::new();
    usize i = 0;
    while (i < n)
    {
        String text = Result::unwrap_or(arg(i), String::from_str("(not UTF-8)"));
        match (parse<f64>(&text))
        {
            Ok(x) :
            {
                Vec::push(&mut xs, x);
            },
            Err(e) :
            {
                String m = describe(i, &text, e);
                eprintf("%v", &m);
                return 1;
            },
        }
        i = i + 1;
    }
    sort(&mut xs);
    f64 sum = 0.0;
    i = 0;
    while (i < n)
    {
        sum = sum + *Vec::index_shared(&xs, i);
        i = i + 1;
    }
    f64 median = if (n % 2 == 1)
    {
        *Vec::index_shared(&xs, n / 2)
    }
    else
    {
        (*Vec::index_shared(&xs, n / 2 - 1) + *Vec::index_shared(&xs, n / 2)) / 2.0
    };
    String count = String::from_str("count  ");
    String::append(&mut count, n);
    String::append(&mut count, "\n");
    printf("%v", &count);
    String a = line("min    ", *Vec::index_shared(&xs, 0));
    printf("%v", &a);
    String b = line("max    ", *Vec::index_shared(&xs, n - 1));
    printf("%v", &b);
    String c = line("sum    ", sum);
    printf("%v", &c);
    String d = line("mean   ", sum / to_float<f64>(n));
    printf("%v", &d);
    String e = line("median ", median);
    printf("%v", &e);
    0
}
