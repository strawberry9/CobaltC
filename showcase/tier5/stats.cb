// stats -- summary statistics of the numbers given as arguments.
//
//     stats 3 1 4 1 5 9 2 6
//
// Shows: program arguments (`arg_count`, `arg`, with `Result::unwrap_or`
// for one that is not UTF-8), `String::parse<f64>` and what its `ParseError` says,
// `Vec::sort_by` with the order passed as a closure (an `f64` has no order
// of its own for `Vec::sort`: a NaN is not less, equal or greater), and
// `main`'s value as the exit status: 0 for a result, 1 for an argument
// that is not a number, 2 for no arguments at all. Every failure is a
// value the program reports; nothing here can crash.

import std;

// The error message for an argument that did not parse, naming the
// argument and the byte where it stopped being a number.
fn report(usize i, ref<String, shared> text, ParseError e)
{
    eprintf("stats: argument %v (\"%s\") ", i + 1, text);
    match (e)
    {
        Empty      : eprintf("is empty"),
        Invalid(k) : eprintf("is not a number: byte %v cannot continue one", k),
        OutOfRange : eprintf("is too large for an f64"),
    }
    eprintf("\n");
}

fn main() : u8
{
    usize n = arg_count();
    if (n == 0)
    {
        eprintf("usage: stats NUMBER...\n");
        return 2;
    }
    Vec<f64> xs = Vec::new();
    foreach (i in 0..n)
    {
        String text = Result::unwrap_or(arg(i), String::from_str("(not UTF-8)"));
        match (String::parse<f64>(&text))
        {
            Ok(x)  : Vec::push(&mut xs, x),
            Err(e) :
            {
                report(i, &text, e);
                return 1;
            },
        }
    }
    Vec::sort_by(&mut xs, [](ref<f64, shared> a, ref<f64, shared> b) : bool { *a < *b });
    f64 sum = 0.0;
    foreach (x in &xs)
    {
        sum += *x;
    }
    f64 median = if (n % 2 == 1) { xs[n / 2] } else { (xs[n / 2 - 1] + xs[n / 2]) / 2.0 };
    printf("count  %v\n", n);
    printf("min    %v\n", xs[0]);
    printf("max    %v\n", xs[n - 1]);
    printf("sum    %v\n", sum);
    printf("mean   %v\n", sum / to_float<f64>(n));
    printf("median %v\n", median);
    0
}
