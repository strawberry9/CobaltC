# One run per line: leading NAME=value words are the run's environment
# variables, and the rest the arguments `run_all.sh` gives banner.cb.
"Harbour notes"
BANNER_WIDTH=40 BANNER_CHAR=═ "Harbour notes"
BANNER_STYLE=rule BANNER_CHAR=- "Ferry times"
(none)
BANNER_WIDTH=wide "Harbour notes"
BANNER_WIDTH=8 "Harbour notes"
BANNER_CHAR=ab "Harbour notes"
BANNER_CHAR= "Harbour notes"
BANNER_CHAR=$'\xff' "Harbour notes"
BANNER_STYLE=fancy "Harbour notes"
BANNER_WIDTH=12 "Harbour notes"
