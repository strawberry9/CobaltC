$ banner "Harbour notes"
******************************
*       Harbour notes        *
******************************
[exit 0]
$ BANNER_WIDTH=40 BANNER_CHAR=═ banner "Harbour notes"
════════════════════════════════════════
═            Harbour notes             ═
════════════════════════════════════════
[exit 0]
$ BANNER_STYLE=rule BANNER_CHAR=- banner "Ferry times"
------------------------------
         Ferry times
------------------------------
[exit 0]
$ banner
******************************
*           tier9            *
******************************
[exit 0]
$ BANNER_WIDTH=wide banner "Harbour notes"
banner: BANNER_WIDTH=wide is not a number
[exit 2]
$ BANNER_WIDTH=8 banner "Harbour notes"
banner: BANNER_WIDTH=8 is outside 10 to 80
[exit 2]
$ BANNER_CHAR=ab banner "Harbour notes"
banner: BANNER_CHAR="ab" must be exactly one character
[exit 2]
$ BANNER_CHAR= banner "Harbour notes"
banner: BANNER_CHAR="" must be exactly one character
[exit 2]
$ BANNER_CHAR=$'\xff' banner "Harbour notes"
banner: BANNER_CHAR is not UTF-8 (byte 0)
[exit 2]
$ BANNER_STYLE=fancy banner "Harbour notes"
banner: BANNER_STYLE=fancy is neither box nor rule
[exit 2]
$ BANNER_WIDTH=12 banner "Harbour notes"
banner: "Harbour notes" is 13 characters; BANNER_WIDTH=12 leaves room for 8
[exit 1]
