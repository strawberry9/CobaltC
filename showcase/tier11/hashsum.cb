// hashsum
//
// Shows: a checksum tool over `std::crypto`, the way `sha256sum` is one.
// It reads all of standard input at once (`read_all_bytes`), hashes it
// with SHA-256, SHA-384 or SHA-512 (`-a`), and writes the digest in hex
// (`to_hex`) or base64 (`-b`). A `HashKind` names the algorithm, so one
// `hash(kind, data)` call serves all three. A bad option is an error
// message and `exit(2)` from where it is found, not threaded back to
// `main` (D-0150).
//
//     hashsum [-a sha256|sha384|sha512] [-b] < FILE

import std;

fn usage(StringView why) : HashKind
{
    eprintf("hashsum: %s\nusage: hashsum [-a sha256|sha384|sha512] [-b] < FILE\n", why);
    exit(2)
}

fn algorithm(StringView name) : HashKind
{
    if (name == "sha256")
    {
        return Sha2_256;
    }
    if (name == "sha384")
    {
        return Sha2_384;
    }
    if (name == "sha512")
    {
        return Sha2_512;
    }
    usage("unknown algorithm")
}

fn main() : u8
{
    HashKind kind = Sha2_256;
    str label = "sha256";
    bool base64 = false;
    usize i = 0;
    while (i < arg_count())
    {
        String a = Result::unwrap_or(arg(i), "");
        if (a == "-b")
        {
            base64 = true;
        }
        else if (a == "-a" && i + 1 < arg_count())
        {
            String name = Result::unwrap_or(arg(i + 1), "");
            kind = algorithm(String::as_view(&name));
            label = match (kind)
            {
                Sha1     : "sha1",
                Sha2_256 : "sha256",
                Sha2_384 : "sha384",
                Sha2_512 : "sha512",
            };
            i += 1;
        }
        else
        {
            usage("unknown option");
        }
        i += 1;
    }
    Vec<u8> data = match (read_all_bytes())
    {
        Ok(d)  : d,
        Err(e) :
        {
            eprintf("hashsum: %s\n", FileError::text(&e));
            return 1;
        },
    };
    Vec<u8> digest = hash(kind, &data[0..$]);
    String text = if (base64) { base64_encode(&digest[0..$]) } else { to_hex(&digest[0..$]) };
    printf("%s  %s (%u bytes)\n", &text, label, Vec::len(&data));
    0
}
