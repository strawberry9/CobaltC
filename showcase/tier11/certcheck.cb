fn one(str pem) : Certificate
{
    Vec<Certificate> v = certificates_from_pem(StringView::of(pem));
    Vec::remove(&mut v, 0)
}

fn key_text(ref<CertKey, shared> k) : str
{
    match (k)
    {
        RsaKey(_)      : "RSA",
        EcKey(e) : match (e.curve)
        {
            P256 : "EC P-256",
            P384 : "EC P-384",
        },
        Ed25519Key(_)  : "Ed25519",
        UnsupportedKey : "unsupported",
    }
}

fn scheme_text(ref<SignatureScheme, shared> s) : str
{
    match (s)
    {
        RsaPkcs1(_)          : "RSA PKCS #1 v1.5",
        RsaPss(_)            : "RSA-PSS",
        Ecdsa(_)             : "ECDSA",
        Ed25519              : "Ed25519",
        UnsupportedSignature : "unsupported",
    }
}

fn summary(str what, ref<Certificate, shared> c)
{
    printf(
        "%-13s CN=%s  key %s, signed with %s, CA %v, valid %04d-%02d-%02d to %04d-%02d-%02d",
        what,
        &c.common_name,
        key_text(&c.key),
        scheme_text(&c.scheme),
        c.is_ca,
        c.not_before.year,
        c.not_before.month,
        c.not_before.day,
        c.not_after.year,
        c.not_after.month,
        c.not_after.day,
    );
    foreach (n in &c.dns_names)
    {
        printf(", %s", n);
    }
    foreach (a in &c.ip_addresses)
    {
        printf(", %s", &IpAddr::text(a));
    }
    printf("\n");
}

fn check(str what, Result<void, CertError> r)
{
    match (r)
    {
        Ok(_)  : printf("  %-40s trusted\n", what),
        Err(e) : printf("  %-40s refused: %s\n", what, CertError::text(&e)),
    }
}

fn main()
{
    Certificate root = one(ROOT);
    Certificate intermediate = one(INTERMEDIATE);
    Certificate server = one(SERVER);
    Certificate short_lived = one(SHORT_LIVED);
    summary("root", &root);
    summary("intermediate", &intermediate);
    summary("server", &server);
    summary("short-lived", &short_lived);
    TrustStore roots = TrustStore::new();
    TrustStore::add(&mut roots, Certificate::clone(&root));
    Vec<Certificate> chain = Vec::new();
    Vec::push(&mut chain, Certificate::clone(&intermediate));
    DateTime when = Option::unwrap(DateTime::new(2030, 6, 1, 12, 0, 0));
    printf("\nchecked at %s:\n", &DateTime::to_iso(&when));
    check("test.example", verify_chain(&server, &chain[0..$], &roots, "test.example", &when));
    array<str, 5> hosts = ["api.wild.example", "a.b.wild.example", "127.0.0.1", "10.0.0.1", "evil.example"];
    foreach (host in &hosts)
    {
        printf(
            "  %-40s %s\n",
            *host,
            if (Certificate::matches_host(
                &server,
                StringView::of(*host),
            )) { "name matches" } else { "refused: certificate is not for this host" },
        );
    }
    check("short-lived certificate", verify_chain(&short_lived, &chain[0..$], &roots, "test.example", &when));
    Vec<Certificate> none = Vec::new();
    check("without the intermediate", verify_chain(&server, &none[0..$], &roots, "test.example", &when));
    TrustStore nobody = TrustStore::new();
    check("with no trusted roots", verify_chain(&server, &chain[0..$], &nobody, "test.example", &when));
}
