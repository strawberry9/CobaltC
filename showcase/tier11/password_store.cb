// A password store
//
// Shows: storing passwords the way current guidance says to. Each is
// hashed with Argon2id, which costs memory as well as time, and kept as a
// PHC string ($argon2id$v=19$m=…,t=…,p=…$salt$hash) that records its own
// parameters and salt, so `verify_password` needs nothing else and the
// parameters can be raised later. One account still has an old PBKDF2
// record; it is checked the old way and upgraded at its next good login.
// A login for an unknown name does the same work as a real one, so its
// timing does not reveal which names exist. API tokens, being random and
// long, need no slow hash: a keyed BLAKE2b digest of each is stored.
//
// The parameters and salts are fixed and small so the output is the same
// every run and the interpreter is quick; real code calls
// `hash_password`, which draws a fresh salt and uses 19 MiB.

import std;

// base64 without padding, as PHC strings write it.
fn b64(slice<u8, shared> bytes) : String
{
    String s = base64_encode(bytes);
    while (String::ends_with(&s, "="))
    {
        String::truncate(&mut s, String::len(&s) - 1);
    }
    s
}

fn argon2_record(StringView password, slice<u8, shared> salt) : String
{
    Vec<u8> digest = argon2id(StringView::as_bytes(password), salt, 1, 64, 1, 24);
    String out = String::from_str("$argon2id$v=19$m=64,t=1,p=1$");
    String::append(&mut out, String::as_view(&b64(salt)));
    String::append(&mut out, "$");
    String::append(&mut out, String::as_view(&b64(&digest[0..$])));
    out
}

// The old scheme this store used before: PBKDF2-HMAC-SHA-256.
fn pbkdf2_record(StringView password, slice<u8, shared> salt) : String
{
    Vec<u8> digest = pbkdf2(Sha2_256, StringView::as_bytes(password), salt, 200, 32);
    String out = String::from_str("$pbkdf2-sha256$i=200$");
    String::append(&mut out, String::as_view(&b64(salt)));
    String::append(&mut out, "$");
    String::append(&mut out, String::as_view(&b64(&digest[0..$])));
    out
}

fn pbkdf2_check(StringView record, StringView password) : bool
{
    Vec<StringView> parts = StringView::split(record, "$");
    if (Vec::len(&parts) != 5 || !StringView::eq(parts[1], "pbkdf2-sha256"))
    {
        return false;
    }
    String padded_salt = String::from_view(parts[3]);
    while (String::len(&padded_salt) % 4 != 0)
    {
        String::push_ascii(&mut padded_salt, b'=');
    }
    Vec<u8> salt = Result::unwrap_or(base64_decode(String::as_view(&padded_salt)), Vec::new());
    String again = pbkdf2_record(password, &salt[0..$]);
    digest_eq(StringView::as_bytes(String::as_view(&again)), StringView::as_bytes(record))
}

struct Account
{
    String name;
    String record;
}

// A fixed per-user salt for the demonstration; really 16 bytes of
// `os_random_bytes`.
fn demo_salt(str name) : Vec<u8>
{
    Vec<u8> seed = Vec::from_slice(&b"demo salt for "[0..$]);
    Vec::extend_from(&mut seed, StringView::as_bytes(StringView::of(name)));
    Vec::from_slice(&sha256(&seed[0..$])[0..16])
}

// A record that matches no password, verified for unknown names.
const str DECOY = "$argon2id$v=19$m=64,t=1,p=1$ZGVjb3lkZWNveWRlY295$AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA";

enum Login
{
    Welcome,
    WelcomeUpgraded,
    Refused,
}

fn login(ref<Vec<Account>, exclusive> store, StringView name, StringView password) : Login
{
    for (usize i = 0; i < Vec::len(store); i += 1)
    {
        if (store[i].name == name)
        {
            // The view of the record ends with this block, before the
            // record is replaced: overwriting what a live view still sees
            // is the aliasing fault CobaltC reports.
            {
                StringView record = String::as_view(&store[i].record);
                if (StringView::starts_with(record, "$argon2id$"))
                {
                    return if (verify_password(record, StringView::as_bytes(password))) { Welcome } else { Refused };
                }
                if (!pbkdf2_check(record, password))
                {
                    return Refused;
                }
            }
            // Good password under the old scheme: replace the record.
            Vec<u8> salt = demo_salt("carol, upgraded");
            overwrite(&mut store[i].record, argon2_record(password, &salt[0..$]));
            return WelcomeUpgraded;
        }
    }
    // The same work as a wrong password, so the time tells nothing.
    _ = verify_password(DECOY, StringView::as_bytes(password));
    Refused
}

fn try_login(ref<Vec<Account>, exclusive> store, str name, str password)
{
    str verdict = match (login(store, StringView::of(name), StringView::of(password)))
    {
        Welcome         : "welcome",
        WelcomeUpgraded : "welcome (record upgraded to Argon2id)",
        Refused         : "refused",
    };
    printf("  %-6s %-24s %s\n", name, password, verdict);
}

fn main() : u8
{
    Vec<Account> store = Vec::new();
    array<str, 3> names = ["alice", "bob", "dave"];
    array<str, 3> passwords = ["correct horse battery", "Tr0ub4dor&3", "correct horse battery"];
    for (usize i = 0; i < 3; i += 1)
    {
        Vec<u8> salt = demo_salt(names[i]);
        Vec::push(
            &mut store,
            Account { .name = String::from_str(names[i]), .record = argon2_record(
                StringView::of(passwords[i]),
                &salt[0..$],
            ) },
        );
    }
    Vec<u8> carol_salt = demo_salt("carol");
    Vec::push(
        &mut store,
        Account { .name = String::from_str("carol"), .record = pbkdf2_record("letmein2019", &carol_salt[0..$]) },
    );
    printf("stored records:\n");
    foreach (a in &store)
    {
        printf("  %-6s %s\n", &a.name, &a.record);
    }
    printf("  (alice and dave share a password; their salts make the records differ)\n\nlogins:\n");
    try_login(&mut store, "alice", "correct horse battery");
    try_login(&mut store, "alice", "correct horse batterY");
    try_login(&mut store, "bob", "Tr0ub4dor&3");
    try_login(&mut store, "eve", "anything");
    try_login(&mut store, "carol", "letmein");
    try_login(&mut store, "carol", "letmein2019");
    printf("  carol's record is now %s\n", &store[3].record);
    try_login(&mut store, "carol", "letmein2019");

    // A record another implementation wrote (Python's argon2-cffi, with
    // two lanes): the parameters come from the string.
    StringView foreign = "$argon2id$v=19$m=64,t=1,p=2$UFrMR9dIXVY$9Ovz4hZBCsn5wOejdF0dDQ";
    printf(
        "\nargon2-cffi's hash of \"pw-one\": %v, of \"pw-two\": %v\n",
        verify_password(foreign, &b"pw-one"[0..$]),
        verify_password(foreign, &b"pw-two"[0..$]),
    );
    printf("not an Argon2id string: %v\n", verify_password("$2b$12$notargon", &b"pw-one"[0..$]));

    // API tokens: 32 random bytes each, so a fast keyed hash suffices.
    Vec<u8> server_key = Vec::from_slice(&sha256(&b"demo server key"[0..$])[0..$]);
    Vec<u8> token = Vec::from_slice(&sha512(&b"demo token"[0..$])[0..32]);
    String shown = to_hex(&token[0..$]);
    Blake2b mac = Blake2b::new_keyed(&server_key[0..$], 32);
    Blake2b::update(&mut mac, &token[0..$]);
    Vec<u8> stored = Blake2b::finish(mac);
    printf("\nAPI token given out once: %s\n", &shown);
    printf("server keeps only:        %s\n", &to_hex(&stored[0..$]));
    Vec<u8> presented = Result::unwrap_or(from_hex(String::as_view(&shown)), Vec::new());
    Blake2b check = Blake2b::new_keyed(&server_key[0..$], 32);
    Blake2b::update(&mut check, &presented[0..$]);
    printf("presented token matches:  %v\n", digest_eq(&Blake2b::finish(check)[0..$], &stored[0..$]));
    0
}
