// Big numbers
//
// Shows: `BigUint`, integers as large as memory allows, for the arithmetic
// public-key cryptography is made of and for exact answers no `u128`
// holds. A `BigUint` owns its digits, so it is a resource: a running value
// is replaced with `overwrite`, and a division is taken apart by
// destructuring its `quotient` and `remainder`. Computed here: 52!, the
// 300th Fibonacci number, a probable-prime test (Fermat, base 3) of
// Mersenne numbers 2^p - 1, and a textbook RSA round trip with small primes
// (illustration only: real keys are thousands of bits and use padding).

import std;

fn factorial(u64 n) : BigUint
{
    BigUint f = BigUint::from_u64(1);
    for (u64 i = 2; i <= n; i += 1)
    {
        overwrite(&mut f, BigUint::mul(&f, &BigUint::from_u64(i)));
    }
    f
}

fn fibonacci(usize n) : BigUint
{
    BigUint a = BigUint::zero();
    BigUint b = BigUint::from_u64(1);
    for (usize i = 0; i < n; i += 1)
    {
        BigUint next = BigUint::add(&a, &b);
        overwrite(&mut a, b);
        b = next;
    }
    a
}

// 3^(m-1) mod m == 1 holds for every prime m (Fermat); a composite rarely
// passes.
fn probably_prime(ref<BigUint, shared> m) : bool
{
    BigUint one = BigUint::from_u64(1);
    BigUint r = BigUint::mod_pow(&BigUint::from_u64(3), &BigUint::sub(m, &one), m);
    BigUint::eq(&r, &one)
}

fn main()
{
    BigUint f = factorial(52);
    String digits = BigUint::text(&f);
    printf("52! = %s\n    (%u digits: the ways to order a deck of cards)\n", &digits, String::len(&digits));
    printf("F(300) = %s\n", &BigUint::text(&fibonacci(300)));
    array<u64, 8> exponents = [61, 67, 89, 101, 107, 127, 149, 521];
    foreach (p in &exponents)
    {
        BigUint m = BigUint::sub(&BigUint::shift_left(&BigUint::from_u64(1), narrow<usize>(*p)), &BigUint::from_u64(1));
        printf(
            "2^%u - 1 (%u bits): %s\n",
            *p,
            BigUint::bit_len(&m),
            if (probably_prime(&m)) { "probably prime" } else { "composite" },
        );
    }
    // Textbook RSA: n = p·q, e = 65537, d = e⁻¹ mod (p-1)(q-1).
    BigUint p = Result::unwrap_or(BigUint::parse("4294967291"), BigUint::zero());
    BigUint q = Result::unwrap_or(BigUint::parse("4294967279"), BigUint::zero());
    BigUint n = BigUint::mul(&p, &q);
    BigUint e = BigUint::from_u64(65537);
    BigUint d = Result::unwrap_or(BigUint::parse("9331878932546167513"), BigUint::zero());
    BigUint message = BigUint::from_bytes_be(&b"hello!"[0..$]);
    BigUint cipher = BigUint::mod_pow(&message, &e, &n);
    BigUint back = BigUint::mod_pow(&cipher, &d, &n);
    printf(
        "n = %s\nmessage %s -> %s -> %s (%s)\n",
        &BigUint::text(&n),
        &BigUint::text(&message),
        &BigUint::text(&cipher),
        &BigUint::text(&back),
        &Result::unwrap_or(String::from_utf8(BigUint::to_bytes_be(&back)), String::new()),
    );
    BigDivision { quotient, remainder } = BigUint::div_rem(&f, &n);
    printf("52! = %s·n + %s\n", &BigUint::text(&quotient), &BigUint::text(&remainder));
}
