// Calling C: the maths library
//
// Shows: `extern fn` declares a C function by name; calling it is
// `unsafe`, because the language cannot see inside it. Only plain types
// cross the boundary (integers, floats, bool, raw pointers), and what
// comes back is a *claim*: a real f64, but whether it is the right one is
// for the program to check when it matters -- as the Pythagorean test
// below does.

import std;

extern fn sqrt(f64 x) : f64;
extern fn cbrt(f64 x) : f64;
extern fn pow(f64 x, f64 y) : f64;
extern fn hypot(f64 x, f64 y) : f64;
extern fn floor(f64 x) : f64;

fn main()
{
    printf("  n      sqrt(n)    cbrt(n)    n^1.5\n");
    i32 n = 1;
    while (n <= 8)
    {
        f64 x = to_float<f64>(n);
        f64 s = unsafe { sqrt(x) };
        f64 c = unsafe { cbrt(x) };
        f64 p = unsafe { pow(x, 1.5) };
        // Six places, rounded: `%v` would give every digit, and the C
        // library's last digits may differ between platforms.
        printf("  %v  %.6f  %.6f  %.6f\n", n, s, c, p);
        n = n + 1;
    }

    // Integer right triangles with legs below 25: hypot's claim is
    // accepted only when the result is exactly a whole number.
    printf("right triangles with integer sides:");
    i32 a = 1;
    while (a < 25)
    {
        i32 b = a;
        while (b < 25)
        {
            f64 h = unsafe { hypot(to_float<f64>(a), to_float<f64>(b)) };
            if (unsafe { floor(h) } == h)
            {
                printf(" (%v,%v,", a, b);
                printf("%v", to_int<i64>(h));      // checked: faults if h were not representable
                printf(")");
            }
            b = b + 1;
        }
        a = a + 1;
    }
    printf("\n");
}
