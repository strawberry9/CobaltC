// From Claim to Fact
//
// Shows: CobaltC's trust-transition pattern. A value from C -- here the C
// library's `rand` -- is a claim: an i32 whose meaning the language cannot
// know. A small validator turns it into a typed fact or an error, and
// only the fact is used. `narrow` and `checked_` conversions do the
// checking; nothing is assumed.

import std;

extern fn srand(u32 seed);
extern fn rand() : i32;

enum Die
{
    One,
    Two,
    Three,
    Four,
    Five,
    Six
}

enum BadRoll
{
    Negative(i32)
}

// C documents rand() as 0..=RAND_MAX; the validator does not take that on
// trust, and maps an accepted value onto a die face.
fn roll(i32 claim) : Result<Die, BadRoll>
{
    if (claim < 0)
    {
        return Err(Negative(claim));
    }
    i32 r = claim % 6;
    Ok(if (r == 0) { One } else if (r == 1) { Two } else if (r == 2) { Three } else if (r == 3) { Four } else if (r == 4) { Five } else { Six })
}

fn face(Die d) : u64
{
    match (d)
    {
        One : 1,
        Two : 2,
        Three : 3,
        Four : 4,
        Five : 5,
        Six : 6,
    }
}

fn main()
{
    unsafe
    {
        srand(2026);                        // a fixed seed: the same sequence every run
    }
    array<u64, 6> counts = [0, 0, 0, 0, 0, 0];
    u64 total = 0;
    printf("first rolls:");
    u32 i = 0;
    while (i < 600)
    {
        i32 claim = unsafe { rand() };
        match (roll(claim))
        {
            Ok(d) :
            {
                u64 f = face(d);
                if (i < 12)
                {
                    printf(" %v", f);
                }
                counts[narrow<usize>(f - 1)] = counts[narrow<usize>(f - 1)] + 1;
                total = total + f;
            },
            Err(e) :
            {
                match (e)
                {
                    Negative(v) :
                    {
                        printf("\nrejected a negative claim: %v", v);
                    },
                }
            },
        }
        i = i + 1;
    }
    printf("\nhistogram of 600 rolls:\n");
    foreach (k, n in &counts)
    {
        printf("  %v: %v\n", k + 1, n);
    }
    printf("mean roll: %v\n", to_float<f64>(total) / 600.0);
}
