// From Claim to Fact
//
// Shows: CobaltC's trust-transition pattern. A value from C -- here the C
// library's `rand` -- is a claim: an i32 whose meaning the language cannot
// know. A small validator turns it into a typed fact or an error, and
// only the fact is used. `checked_narrow` does the checking -- a negative
// claim fits no u32 -- and the die's faces are an enum with codes, so a
// number becomes a face only through `Die::from_code`; nothing is assumed.

import std;

extern fn srand(u32 seed);
extern fn rand() : i32;

enum Die : u8
{
    One = 1,
    Two,
    Three,
    Four,
    Five,
    Six,
}

enum BadRoll
{
    Negative(i32)
}

// C documents rand() as 0..=RAND_MAX; the validator does not take that on
// trust, and maps an accepted value onto a die face.
fn roll(i32 claim) : Result<Die, BadRoll>
{
    u32 v = Option::ok_or(checked_narrow<u32>(claim), Negative(claim))?;   // None: it was negative
    Ok(Option::unwrap(Die::from_code(narrow<u8>(v % 6) + 1)))              // 1 to 6: always a face
}

fn face(Die d) : u64
{
    widen<u64>(Die::code(d))
}

fn main()
{
    unsafe
    {
        srand(2026);                        // a fixed seed: the same sequence every run
    }
    array<u64, 6> counts = [0, 0, 0, 0, 0, 0];
    u64 total = 0;
    printf("first rolls:");
    foreach (i in 0..600)
    {
        i32 claim = unsafe { rand() };
        match (roll(claim))
        {
            Ok(d)            :
            {
                u64 f = face(d);
                if (i < 12)
                {
                    printf(" %v", f);
                }
                counts[narrow<usize>(f - 1)] += 1;
                total += f;
            },
            Err(Negative(v)) : printf("\nrejected a negative claim: %v", v),
        }
    }
    printf("\nhistogram of 600 rolls:\n");
    foreach (k, n in &counts)
    {
        printf("  %v: %v\n", k + 1, n);
    }
    printf("mean roll: %v\n", to_float<f64>(total) / 600.0);
}
