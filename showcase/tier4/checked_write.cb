// The One Real Extern: write
//
// Shows: every byte a CobaltC program prints goes through a single extern
// in the prelude, `write(buf, len) : isize` -- `print` is a thin safe
// wrapper around it. Called directly, its result is a claim ("this many
// bytes were written"), and a careful program checks the claim instead
// of assuming it.

import std;

// Writes the bytes and checks what `write` claims happened.
fn emit(rawptr<u8> p, usize n) : Result<usize, isize>
{
    isize claimed = unsafe { write(p, n) };
    if (claimed != reinterpret<isize>(n))
    {
        return Err(claimed);               // a short or failed write, reported, not ignored
    }
    Ok(n)
}

fn main()
{
    auto line1 = b"raw bytes, ";
    auto line2 = b"written with the write extern\n";
    usize total = 0;
    match (emit(reinterpret_ptr<u8>(rawptr_of(&line1)), 11))
    {
        Ok(n) :
        {
            total = total + n;
        },
        Err(c) :
        {
            printf("\nshort write: %v", c);
        },
    }
    match (emit(reinterpret_ptr<u8>(rawptr_of(&line2)), 30))
    {
        Ok(n) :
        {
            total = total + n;
        },
        Err(c) :
        {
            printf("\nshort write: %v", c);
        },
    }
    printf("each claim checked; %v bytes confirmed\n", total);
}
