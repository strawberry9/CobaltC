// Shortest Paths
//
// Shows: Dijkstra's algorithm with `std`'s `PriorityQueue`. A struct whose
// fields are all keys is itself a key, ordered field by field, so a
// `PriorityQueue<Item>` with `dist` first needs no comparison function:
// `pop` gives the nearest town still waiting. Distances are
// `Option<u64>`, not a sentinel "infinity", so an unreachable town is a
// `None` the program must handle (`if (Some(d) = …)`), and every path
// cost is summed with `checked_add`.

import std;

struct Edge
{
    usize to;
    u64 km;
}

struct Item                                                  // a key: ordered by dist, then node
{
    u64 dist;
    usize node;
}

// ---- the graph ----

fn road(ref<Vec<Vec<Edge>>, exclusive> g, usize a, usize b, u64 km)
{
    Vec::push(&mut g[a], Edge { .to = b, .km = km });
    Vec::push(&mut g[b], Edge { .to = a, .km = km });
}

fn main()
{
    array<str, 8> towns = ["Ashford", "Bramley", "Cotton", "Dunmore", "Elstow", "Fairley", "Glenn", "Harrow"];
    Vec<Vec<Edge>> g = Vec::from_fn(8, [](usize i) : Vec<Edge> { Vec::new() });   // no roads yet
    road(&mut g, 0, 1, 7);
    road(&mut g, 0, 2, 9);
    road(&mut g, 0, 5, 14);
    road(&mut g, 1, 2, 10);
    road(&mut g, 1, 3, 15);
    road(&mut g, 2, 3, 11);
    road(&mut g, 2, 5, 2);
    road(&mut g, 3, 4, 6);
    road(&mut g, 4, 5, 9);
    // Harrow (7) has no roads at all; Glenn (6) only to Harrow.
    road(&mut g, 6, 7, 3);

    Vec<Option<u64>> dist = Vec::filled(8, None);
    Vec<Option<usize>> prev = Vec::filled(8, None);
    Vec<bool> done = Vec::filled(8, false);

    usize start = 0;
    dist[start] = Some(0);
    PriorityQueue<Item> waiting = PriorityQueue::new();     // the nearest first
    PriorityQueue::push(&mut waiting, Item { .dist = 0, .node = start });
    while (Some(it) = PriorityQueue::pop(&mut waiting))      // until no town is waiting
    {
        if (done[it.node])
        {
            continue;
        }
        done[it.node] = true;
        foreach (e in &g[it.node])
        {
            if (Some(d) = checked_add(it.dist, e.km))
            {
                bool better = if (Some(old) = dist[e.to]) { d < old } else { true };
                if (better)
                {
                    dist[e.to] = Some(d);
                    prev[e.to] = Some(it.node);
                    PriorityQueue::push(&mut waiting, Item { .dist = d, .node = e.to });
                }
            }
            else
            {
                printf("a path length overflowed u64\n");
            }
        }
    }

    printf("from %v:\n", towns[start]);
    foreach (t, town in &towns)
    {
        printf("  %v", town);
        if (Some(d) = dist[t])
        {
            printf(": %v km via ", d);
            // Walk the predecessors back to the start, then print the route forwards.
            Vec<usize> route = Vec::new();
            usize at = t;
            Vec::push(&mut route, at);
            while (Some(p) = prev[at])
            {
                Vec::push(&mut route, p);
                at = p;
            }
            Vec::reverse(&mut route);
            foreach (i, r in &route)
            {
                printf("%v%v", if (i > 0) { " > " } else { "" }, towns[*r]);
            }
            printf("\n");
        }
        else
        {
            printf(": unreachable\n");
        }
    }
}
