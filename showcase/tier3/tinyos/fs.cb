// fs.cb -- a small in-memory filesystem: named files of bytes.

import std;

struct File
{
    Vec<u8> name;
    Vec<u8> data;
}

export struct Fs
{
    Vec<File> files;
}

export fn Fs::new() : Fs
{
    Fs { .files = Vec::new() }
}

fn same(ref<Vec<u8>, shared> a, ref<Vec<u8>, shared> b) : bool
{
    if (Vec::len(a) != Vec::len(b))
    {
        return false;
    }
    usize i = 0;
    while (i < Vec::len(a))
    {
        if (*Vec::index_shared(a, i) != *Vec::index_shared(b, i))
        {
            return false;
        }
        i = i + 1;
    }
    true
}

// The descriptor of the file called `name`, created empty if it is new.
export fn Fs::open(ref<Fs, exclusive> fs, Vec<u8> name) : u32
{
    foreach (i, file in &fs.files)
    {
        if (same(&file.name, &name))
        {
            return narrow<u32>(i);
        }
    }
    Vec::push(&mut fs.files, File { .name = name, .data = Vec::new() });
    narrow<u32>(Vec::len(&fs.files) - 1)
}

export fn Fs::valid(ref<Fs, shared> fs, u32 fd) : bool
{
    widen<usize>(fd) < Vec::len(&fs.files)
}

export fn Fs::append(ref<Fs, exclusive> fs, u32 fd, u8 b)
{
    auto file = Vec::index_exclusive(&mut fs.files, widen<usize>(fd));
    Vec::push(&mut file.data, b);
}

export fn Fs::size(ref<Fs, shared> fs, u32 fd) : u32
{
    auto file = Vec::index_shared(&fs.files, widen<usize>(fd));
    narrow<u32>(Vec::len(&file.data))
}

export fn Fs::byte_at(ref<Fs, shared> fs, u32 fd, u32 pos) : u8
{
    auto file = Vec::index_shared(&fs.files, widen<usize>(fd));
    *Vec::index_shared(&file.data, widen<usize>(pos))
}

export fn Fs::count(ref<Fs, shared> fs) : usize
{
    Vec::len(&fs.files)
}

// A copy of a file's name, for listing.
export fn Fs::name(ref<Fs, shared> fs, u32 fd) : Vec<u8>
{
    Vec<u8> out = Vec::new();
    auto f = Vec::index_shared(&fs.files, widen<usize>(fd));
    foreach (b in &f.name)
    {
        Vec::push(&mut out, *b);
    }
    out
}
