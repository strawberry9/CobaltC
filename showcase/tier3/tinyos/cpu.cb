// cpu.cb -- the instruction set, the CPU that runs it, and an assembler.
//
// Instructions are bytes in a process's own memory, fetched through its
// page table like every other access. Registers are u32 and arithmetic
// wraps, as hardware does, so it says `wrapping_add`.
//
//   op  bytes  instruction
//    1   6     li   rd, imm32         rd = imm
//    2   4     add  rd, ra, rb        rd = ra + rb
//    3   4     sub  rd, ra, rb        rd = ra - rb
//    4   3     addi rd, imm8          rd = rd + imm
//    5   3     lb   rd, ra            rd = mem[ra]
//    6   3     sb   ra, rb            mem[ra] = rb (low byte)
//    7   3     jmp  addr16
//    8   4     jz   ra, addr16        jump if ra == 0
//    9   4     jnz  ra, addr16        jump if ra != 0
//   10   2     sys  n                 system call n: arguments r1..r3, result r0
//   11   2     push ra                sp = sp - 4; mem32[sp] = ra
//   12   2     pop  rd                rd = mem32[sp]; sp = sp + 4
//   13   3     mov  rd, ra
//   14   4     slt  rd, ra, rb        rd = 1 if ra < rb, else 0
//   15   3     call addr16            push the return address, jump
//   16   1     ret                    pop the return address, jump

import std;

// Why the CPU stopped: a system call, or a fault the kernel must handle.
export enum Trap
{
    Sys(u8),
    PageFault(u32),
    Illegal(u8),
}

fn length(u8 op) : u32
{
    array<u32, 17> lengths = [0, 6, 4, 4, 3, 3, 3, 3, 4, 4, 2, 2, 2, 3, 4, 3, 1];
    if (op > 16)
    {
        return 0;
    }
    lengths[widen<usize>(op)]
}

fn reg(u8 b) : usize
{
    widen<usize>(b & 7)                               // a 3-bit register field
}

fn push32(ref<machine::Cpu, exclusive> c, ref<memory::AddressSpace, shared> s, ref<machine::Ram, exclusive> ram, u32 v) : bool
{
    c.sp = wrapping_sub(c.sp, 4);
    u32 i = 0;
    while (i < 4)
    {
        if (!memory::AddressSpace::store(s, ram, c.sp + i, narrow_wrapping<u8>(v >> (8 * i))))
        {
            return false;
        }
        i = i + 1;
    }
    true
}

fn pop32(ref<machine::Cpu, exclusive> c, ref<memory::AddressSpace, shared> s, ref<machine::Ram, shared> ram, ref<bool, exclusive> ok) : u32
{
    u32 v = 0;
    u32 i = 0;
    while (i < 4)
    {
        match (memory::AddressSpace::load(s, ram, c.sp + i))
        {
            Some(b) : v = v | (widen<u32>(b) << (8 * i)),
            None : *ok = false,
        }
        i = i + 1;
    }
    c.sp = c.sp + 4;
    v
}

// Runs one instruction. None: carry on; Some(trap): the kernel's turn.
export fn step(ref<machine::Cpu, exclusive> c, ref<memory::AddressSpace, shared> s, ref<machine::Ram, exclusive> ram) : Option<Trap>
{
    u32 pc = c.pc;
    array<u8, 6> b = [0, 0, 0, 0, 0, 0];
    match (memory::AddressSpace::load(s, &*ram, pc))
    {
        None : return Some(PageFault(pc)),
        Some(op) : b[0] = op,
    }
    u32 len = length(b[0]);
    if (len == 0)
    {
        return Some(Illegal(b[0]));
    }
    u32 k = 1;
    while (k < len)
    {
        match (memory::AddressSpace::load(s, &*ram, pc + k))
        {
            None : return Some(PageFault(pc + k)),
            Some(x) : b[narrow<usize>(k)] = x,
        }
        k = k + 1;
    }
    c.pc = pc + len;
    u8 op = b[0];
    u32 addr16 = widen<u32>(b[1]) | (widen<u32>(b[2]) << 8);
    u32 branch = widen<u32>(b[2]) | (widen<u32>(b[3]) << 8);
    if (op == 1)
    {
        c.r[reg(b[1])] = widen<u32>(b[2]) | (widen<u32>(b[3]) << 8) | (widen<u32>(b[4]) << 16) | (widen<u32>(b[5]) << 24);
    }
    else if (op == 2)
    {
        c.r[reg(b[1])] = wrapping_add(c.r[reg(b[2])], c.r[reg(b[3])]);
    }
    else if (op == 3)
    {
        c.r[reg(b[1])] = wrapping_sub(c.r[reg(b[2])], c.r[reg(b[3])]);
    }
    else if (op == 4)
    {
        c.r[reg(b[1])] = wrapping_add(c.r[reg(b[1])], widen<u32>(b[2]));
    }
    else if (op == 5)
    {
        u32 va = c.r[reg(b[2])];
        match (memory::AddressSpace::load(s, &*ram, va))
        {
            None : return Some(PageFault(va)),
            Some(x) : c.r[reg(b[1])] = widen<u32>(x),
        }
    }
    else if (op == 6)
    {
        u32 va = c.r[reg(b[1])];
        if (!memory::AddressSpace::store(s, ram, va, narrow_wrapping<u8>(c.r[reg(b[2])])))
        {
            return Some(PageFault(va));
        }
    }
    else if (op == 7)
    {
        c.pc = addr16;
    }
    else if (op == 8)
    {
        if (c.r[reg(b[1])] == 0)
        {
            c.pc = branch;
        }
    }
    else if (op == 9)
    {
        if (c.r[reg(b[1])] != 0)
        {
            c.pc = branch;
        }
    }
    else if (op == 10)
    {
        return Some(Sys(b[1]));
    }
    else if (op == 11)
    {
        u32 v = c.r[reg(b[1])];
        if (!push32(c, s, ram, v))
        {
            return Some(PageFault(c.sp));
        }
    }
    else if (op == 12)
    {
        bool ok = true;
        u32 v = pop32(c, s, &*ram, &mut ok);
        if (!ok)
        {
            return Some(PageFault(c.sp - 4));
        }
        c.r[reg(b[1])] = v;
    }
    else if (op == 13)
    {
        c.r[reg(b[1])] = c.r[reg(b[2])];
    }
    else if (op == 14)
    {
        c.r[reg(b[1])] = if (c.r[reg(b[2])] < c.r[reg(b[3])]) { 1 } else { 0 };
    }
    else if (op == 15)
    {
        u32 ret = c.pc;
        if (!push32(c, s, ram, ret))
        {
            return Some(PageFault(c.sp));
        }
        c.pc = addr16;
    }
    else
    {
        bool ok = true;
        u32 v = pop32(c, s, &*ram, &mut ok);
        if (!ok)
        {
            return Some(PageFault(c.sp - 4));
        }
        c.pc = v;
    }
    None
}

// ---- an assembler: code at virtual address 0, data at 0x800 ----

export fn data_base() : u32
{
    2048
}

export struct Asm
{
    export Vec<u8> code;
    export Vec<u8> data;
    export u32 entry;                                 // where execution starts
}

export fn Asm::new() : Asm
{
    Asm { .code = Vec::new(), .data = Vec::new(), .entry = 0 }
}

// Execution starts at the next instruction.
export fn Asm::start_here(ref<Asm, exclusive> a)
{
    a.entry = Asm::here(&*a);
}

// The address the next instruction will have.
export fn Asm::here(ref<Asm, shared> a) : u32
{
    narrow<u32>(Vec::len(&a.code))
}

fn emit(ref<Asm, exclusive> a, u32 x)
{
    Vec::push(&mut a.code, narrow<u8>(x));             // checked: every field fits a byte
}

fn emit16(ref<Asm, exclusive> a, u32 x)
{
    emit(a, x & 255);
    emit(a, x >> 8);
}

// Places a string in the data area; returns its virtual address.
export fn Asm::string(ref<Asm, exclusive> a, str s) : u32
{
    u32 at = data_base() + narrow<u32>(Vec::len(&a.data));
    usize i = 0;
    while (i < str_len(s))
    {
        Vec::push(&mut a.data, str_byte(s, i));
        i = i + 1;
    }
    at
}

export fn Asm::li(ref<Asm, exclusive> a, u32 rd, u32 imm)
{
    emit(a, 1);
    emit(a, rd);
    emit16(a, imm & 65535);
    emit16(a, imm >> 16);
}

export fn Asm::add(ref<Asm, exclusive> a, u32 rd, u32 ra, u32 rb)
{
    emit(a, 2);
    emit(a, rd);
    emit(a, ra);
    emit(a, rb);
}

export fn Asm::sub(ref<Asm, exclusive> a, u32 rd, u32 ra, u32 rb)
{
    emit(a, 3);
    emit(a, rd);
    emit(a, ra);
    emit(a, rb);
}

export fn Asm::addi(ref<Asm, exclusive> a, u32 rd, u32 imm)
{
    emit(a, 4);
    emit(a, rd);
    emit(a, imm);
}

export fn Asm::lb(ref<Asm, exclusive> a, u32 rd, u32 ra)
{
    emit(a, 5);
    emit(a, rd);
    emit(a, ra);
}

export fn Asm::sb(ref<Asm, exclusive> a, u32 ra, u32 rb)
{
    emit(a, 6);
    emit(a, ra);
    emit(a, rb);
}

export fn Asm::jmp(ref<Asm, exclusive> a, u32 target)
{
    emit(a, 7);
    emit16(a, target);
}

// A conditional jump whose target is not known yet: returns where to patch.
export fn Asm::jz(ref<Asm, exclusive> a, u32 ra) : u32
{
    emit(a, 8);
    emit(a, ra);
    u32 at = Asm::here(&*a);
    emit16(a, 0);
    at
}

export fn Asm::jnz_to(ref<Asm, exclusive> a, u32 ra, u32 target)
{
    emit(a, 9);
    emit(a, ra);
    emit16(a, target);
}

// Points the jump at `at` to the current address.
export fn Asm::land(ref<Asm, exclusive> a, u32 at)
{
    u32 target = Asm::here(&*a);
    *Vec::index_exclusive(&mut a.code, narrow<usize>(at)) = narrow<u8>(target & 255);
    *Vec::index_exclusive(&mut a.code, narrow<usize>(at + 1)) = narrow<u8>(target >> 8);
}

export fn Asm::sys(ref<Asm, exclusive> a, u32 n)
{
    emit(a, 10);
    emit(a, n);
}

export fn Asm::push(ref<Asm, exclusive> a, u32 ra)
{
    emit(a, 11);
    emit(a, ra);
}

export fn Asm::pop(ref<Asm, exclusive> a, u32 rd)
{
    emit(a, 12);
    emit(a, rd);
}

export fn Asm::mov(ref<Asm, exclusive> a, u32 rd, u32 ra)
{
    emit(a, 13);
    emit(a, rd);
    emit(a, ra);
}

export fn Asm::slt(ref<Asm, exclusive> a, u32 rd, u32 ra, u32 rb)
{
    emit(a, 14);
    emit(a, rd);
    emit(a, ra);
    emit(a, rb);
}

export fn Asm::call(ref<Asm, exclusive> a, u32 target)
{
    emit(a, 15);
    emit16(a, target);
}

export fn Asm::ret(ref<Asm, exclusive> a)
{
    emit(a, 16);
}
