// ASCII Sierpinski Triangle
//
// Shows: bitwise operators with CobaltC's precedence -- unlike C, `&`
// binds tighter than `==`, so `x & y == 0` means `(x & y) == 0`, the
// reading everyone intends. A cell is filled exactly when its column and
// row share no set bit (Pascal's triangle mod 2).

import std;

fn main()
{
    u32 size = 32;
    u32 y = 0;
    while (y < size)
    {
        u32 pad = size - y;
        while (pad > 0)
        {
            printf(" ");
            pad = pad - 1;
        }
        u32 x = 0;
        while (x <= y)
        {
            printf("%v", if (x & (y - x) == 0) { "* " } else { "  " });
            x = x + 1;
        }
        printf("\n");
        y = y + 1;
    }
}
