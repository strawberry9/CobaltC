// Matrix Multiplication
//
// Shows: fixed-size arrays are values with a size in their type --
// `array<array<i64, 3>, 3>` -- copied on assignment and bounds-checked on
// indexing, with no heap involved. Raising the Fibonacci matrix to a
// power uses checked arithmetic, so a result that would not fit is
// reported, never wrapped.

import std;

fn mul3(array<array<i64, 3>, 3> a, array<array<i64, 3>, 3> b) : array<array<i64, 3>, 3>
{
    array<array<i64, 3>, 3> c = [[0, 0, 0], [0, 0, 0], [0, 0, 0]];
    usize i = 0;
    while (i < 3)
    {
        usize j = 0;
        while (j < 3)
        {
            i64 sum = 0;
            usize k = 0;
            while (k < 3)
            {
                sum = sum + a[i][k] * b[k][j];
                k = k + 1;
            }
            c[i][j] = sum;
            j = j + 1;
        }
        i = i + 1;
    }
    c
}

fn show3(array<array<i64, 3>, 3> m)
{
    usize i = 0;
    while (i < 3)
    {
        printf("  ");
        usize j = 0;
        while (j < 3)
        {
            i64 v = m[i][j];
            printf("%v", if (v < 0) { "" } else { " " });
            printf("%v", if (v > -10 && v < 10) { "  " } else if (v > -100 && v < 100) { " " } else { "" });
            printf("%v", v);
            j = j + 1;
        }
        printf("\n");
        i = i + 1;
    }
}

// The 2x2 Fibonacci matrix [[1, 1], [1, 0]] to the n-th power holds
// fib(n) in its corner; overflow is caught by checked_mul/checked_add.
fn fib_power(u32 n) : Option<i64>
{
    array<i64, 4> r = [1, 0, 0, 1];              // identity, row-major 2x2
    array<i64, 4> m = [1, 1, 1, 0];
    u32 e = n;
    while (e > 0)
    {
        if (e % 2 == 1)
        {
            r = mul2(r, m)?;
        }
        e = e / 2;
        if (e > 0)
        {
            m = mul2(m, m)?;                     // only square when a higher bit still needs it
        }
    }
    Some(r[1])
}

fn mul2(array<i64, 4> a, array<i64, 4> b) : Option<array<i64, 4>>
{
    i64 p = checked_add(checked_mul(a[0], b[0])?, checked_mul(a[1], b[2])?)?;
    i64 q = checked_add(checked_mul(a[0], b[1])?, checked_mul(a[1], b[3])?)?;
    i64 r = checked_add(checked_mul(a[2], b[0])?, checked_mul(a[3], b[2])?)?;
    i64 s = checked_add(checked_mul(a[2], b[1])?, checked_mul(a[3], b[3])?)?;
    Some([p, q, r, s])
}

fn main()
{
    array<array<i64, 3>, 3> a = [[1, 2, 3], [4, 5, 6], [7, 8, 9]];   // the literals take i64 from the declaration
    array<array<i64, 3>, 3> b = [[9, 8, 7], [6, 5, 4], [3, 2, 1]];
    printf("A x B =\n");
    show3(mul3(a, b));

    array<array<i64, 3>, 3> rot = [[0, -1, 0], [1, 0, 0], [0, 0, 1]];   // a quarter turn about z
    auto twice = mul3(rot, rot);
    auto four = mul3(twice, twice);
    printf("a quarter turn applied four times is the identity? ");
    array<array<i64, 3>, 3> identity = [[1, 0, 0], [0, 1, 0], [0, 0, 1]];
    printf("%v", if (four == identity) { "yes" } else { "no" });
    printf("\n");

    u32 n = 90;
    printf("fib(90) = ");
    match (fib_power(n))
    {
        Some(f) :
        {
            printf("%v", f);
        },
        None :
        {
            printf("overflow");
        },
    }
    printf("; fib(100) = ");
    match (fib_power(100))
    {
        Some(f) :
        {
            printf("%v", f);
        },
        None :
        {
            printf("does not fit in i64 (checked arithmetic caught it)");
        },
    }
    printf("\n");
}
