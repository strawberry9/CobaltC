// ASCII Mandelbrot
//
// Shows: IEEE-754 floating point with no implicit conversions -- every
// int/float crossing is a named call (`to_float`) -- and deterministic
// output: the same bits from the interpreter and from native code.

import std;

fn main()
{
    str shades = " .:-=+*#%@";
    i32 rows = 22;
    i32 cols = 64;
    i32 y = 0;
    while (y < rows)
    {
        i32 x = 0;
        while (x < cols)
        {
            f64 cr = -2.2 + to_float<f64>(x) * 3.0 / to_float<f64>(cols);
            f64 ci = -1.2 + to_float<f64>(y) * 2.4 / to_float<f64>(rows);
            f64 zr = 0.0;
            f64 zi = 0.0;
            i32 n = 0;
            while (n < 60 && zr * zr + zi * zi < 4.0)
            {
                f64 t = zr * zr - zi * zi + cr;
                zi = 2.0 * zr * zi + ci;
                zr = t;
                n = n + 1;
            }
            usize shade = if (n == 60) { 9 } else { narrow<usize>(n % 9) };
            auto one = [str_byte(shades, shade)];
            unsafe
            {
                write(reinterpret_ptr<u8>(rawptr_of(&one)), 1);
            }
            x = x + 1;
        }
        printf("\n");
        y = y + 1;
    }
}
