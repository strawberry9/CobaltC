// Stack Abstraction
//
// Shows: encapsulation with modules. `Stack<T>` is exported but its field
// is private to the module, so outside code can only use the operations
// it offers -- `s.items` from here would be diag.name-not-visible. It is
// generic, and it works the same for plain values and for resources
// (Strings move in and move back out; nothing is copied or leaked).

import std;

module stack
{
    import std;

    export struct Stack<T>
    {
        Vec<T> items;                       // private: not exported
    }

    export fn Stack::new<T>() : Stack<T>
    {
        Stack { .items = Vec::new() }
    }

    export fn Stack::push<T>(ref<Stack<T>, exclusive> s, T x)
    {
        Vec::push(&mut s.items, x);
    }

    export fn Stack::pop<T>(ref<Stack<T>, exclusive> s) : Option<T>
    {
        Vec::pop(&mut s.items)
    }

    export fn Stack::depth<T>(ref<Stack<T>, shared> s) : usize
    {
        Vec::len(&s.items)
    }
}

import stack::Stack;

// Brackets balance if every closer matches the most recent opener.
fn balanced(str text) : bool
{
    Stack<u8> open = Stack::new();
    usize i = 0;
    while (i < str_len(text))
    {
        u8 c = str_byte(text, i);
        if (c == 40 || c == 91 || c == 123)                 // ( [ {
        {
            Stack::push(&mut open, c);
        }
        else if (c == 41 || c == 93 || c == 125)            // ) ] }
        {
            u8 want = if (c == 41) { 40 } else if (c == 93) { 91 } else { 123 };
            match (Stack::pop(&mut open))
            {
                Some(o) :
                {
                    if (o != want)
                    {
                        return false;
                    }
                },
                None :
                {
                    return false;
                },
            }
        }
        i = i + 1;
    }
    Stack::depth(&open) == 0
}

fn main()
{
    array<str, 4> samples = ["(a[b]{c})", "([)]", "((1)", "{[()()]}"];
    foreach (s in samples)
    {
        printf("%v", s);
        printf("%v", if (balanced(s)) { "  balanced\n" } else { "  not balanced\n" });
    }

    Stack<String> names = Stack::new();
    Stack::push(&mut names, String::from_str("first"));
    Stack::push(&mut names, String::from_str("second"));
    Stack::push(&mut names, String::from_str("third"));
    printf("popping owned strings:");
    bool more = true;
    while (more)
    {
        match (Stack::pop(&mut names))
        {
            Some(s) :                           // s moved out of the stack, now ours
            {
                printf(" %v", &s);
            },
            None :
            {
                more = false;
            },
        }
    }
    printf("\n");
}
