// Sudoku
//
// Shows: arrays are values. The board is an `array<array<u8, 9>, 9>`, and
// each guess works on its own copy (`Board next = board;` copies all 81
// cells), so backtracking needs no undo step: a failed guess simply drops
// its copy. Every `b[r][c]` is bounds-checked; with a literal index the
// check happens before the program runs. The counter of guesses is passed
// down by `&mut`, the one thing all the copies share. Candidate digits are
// bit sets, counted with `count_ones`; `fit & bit != 0` means
// `(fit & bit) != 0` in CobaltC.

import std;

// The digits already used in each row, column and 3x3 box, one bit per
// digit (bit v for digit v).
struct Used
{
    array<u16, 9> rows;
    array<u16, 9> cols;
    array<u16, 9> boxes;
}

fn used(ref<array<array<u8, 9>, 9>, shared> b) : Used
{
    Used u = Used { .rows = [0, 0, 0, 0, 0, 0, 0, 0, 0], .cols = [0, 0, 0, 0, 0, 0, 0, 0, 0], .boxes = [0, 0, 0, 0, 0, 0, 0, 0, 0] };
    foreach (r in 0..9)
    {
        foreach (c in 0..9)
        {
            u16 bit = (1: u16) << widen<u32>(b[r][c]);  // a shift amount is always a u32
            u.rows[r] |= bit;
            u.cols[c] |= bit;
            u.boxes[r / 3 * 3 + c / 3] |= bit;
        }
    }
    u
}

// The digits that fit at (r, c), as bits 1..9.
fn candidates(ref<Used, shared> u, usize r, usize c) : u16
{
    ~(u.rows[r] | u.cols[c] | u.boxes[r / 3 * 3 + c / 3]) & 1022   // 1022: bits 1..9
}

// The solved board, or None if this board has no solution. Each step
// fills the empty cell with the fewest digits that fit, which keeps the
// search small.
fn solve(array<array<u8, 9>, 9> board, ref<u64, exclusive> guesses) : Option<array<array<u8, 9>, 9>>
{
    Used u = used(&board);
    usize best_r = 9;                            // 9: no empty cell found yet
    usize best_c = 0;
    u32 best_count = 10;
    foreach (r in 0..9)
    {
        foreach (c in 0..9)
        {
            if (board[r][c] == 0)
            {
                u32 count = count_ones(candidates(&u, r, c));   // the digits that fit
                if (count == 0)
                {
                    return None;                 // a cell nothing fits: backtrack
                }
                if (count < best_count)
                {
                    best_count = count;
                    best_r = r;
                    best_c = c;
                }
            }
        }
    }
    if (best_r == 9)
    {
        return Some(board);                      // no empty cell left
    }
    u16 fit = candidates(&u, best_r, best_c);
    foreach (v in 1..10: u8)
    {
        if (fit & ((1: u16) << widen<u32>(v)) != 0)
        {
            *guesses += 1;
            array<array<u8, 9>, 9> next = board; // a copy: board is untouched
            next[best_r][best_c] = v;
            if (Some(done) = solve(next, guesses))
            {
                return Some(done);
            }
        }
    }
    None
}

fn show(ref<array<array<u8, 9>, 9>, shared> b)
{
    foreach (r in 0..9)
    {
        if (r == 3 || r == 6)
        {
            printf("  ------+-------+------\n");
        }
        printf(" ");
        foreach (c in 0..9)
        {
            if (c == 3 || c == 6)
            {
                printf(" |");
            }
            printf(" ");
            if (b[r][c] == 0)
            {
                printf(".");
            }
            else
            {
                printf("%v", b[r][c]);
            }
        }
        printf("\n");
    }
}

fn main()
{
    array<array<u8, 9>, 9> puzzle = [
        [5, 3, 0, 0, 7, 0, 0, 0, 0],
        [6, 0, 0, 1, 9, 5, 0, 0, 0],
        [0, 9, 8, 0, 0, 0, 0, 6, 0],
        [8, 0, 0, 0, 6, 0, 0, 0, 3],
        [4, 0, 0, 8, 0, 3, 0, 0, 1],
        [7, 0, 0, 0, 2, 0, 0, 0, 6],
        [0, 6, 0, 0, 0, 0, 2, 8, 0],
        [0, 0, 0, 4, 1, 9, 0, 0, 5],
        [0, 0, 0, 0, 8, 0, 0, 7, 9]
    ];
    printf("puzzle:\n");
    show(&puzzle);
    u64 guesses = 0;
    match (solve(puzzle, &mut guesses))          // puzzle is copied in, and stays as it was
    {
        Some(solved) :
        {
            printf("\nsolved after %v guesses:\n", guesses);
            show(&solved);
        },
        None         : printf("\nno solution\n"),
    }
    printf("\nthe puzzle is unchanged: its top-left cells are still %v, ", puzzle[0][0]);
    printf("%v, %v\n", puzzle[0][1], puzzle[0][2]);
}
