// Hexadecimal Printer
//
// Shows: CobaltC defines how values are laid out in memory -- little-
// endian two's-complement integers, IEEE-754 floats, structs field by
// field -- so looking at the bytes of a value is meaningful, not
// undefined. Getting at them is `unsafe`: the raw-pointer reads are the
// one place this program asserts something the language cannot check.

import std;

struct Header
{
    u32 magic;
    u16 version;
    u16 flags;           // no padding anywhere: 4 + 2 + 2 bytes
}

// One raw byte to standard output: `printf` writes text and numbers, and
// the ASCII column needs the bytes themselves, so this uses `write` the
// way `std` does.
fn put(u8 b)
{
    auto buf = [b];
    unsafe
    {
        write(reinterpret_ptr<u8>(rawptr_of(&buf)), 1);
    }
}

// Prints `n` bytes starting at `p`.
fn dump(str label, rawptr<u8> p, usize n)
{
    printf("%v:", label);
    usize i = 0;
    while (i < n)
    {
        unsafe
        {
            printf(" %02x", *(p + reinterpret<isize>(i)));
        }
        i = i + 1;
    }
    printf("\n");
}

fn main()
{
    // A classic hex dump with an ASCII column.
    auto text = b"CobaltC\x00\x01\x7f\xff!";
    printf("offset  bytes                                ascii\n");
    printf("000000 ");
    foreach (b in &text)
    {
        printf(" %02x", b);
    }
    printf("  |");
    foreach (c in text)
    {
        put(if (c >= 32 && c < 127) { c } else { 46 });          // '.' for the unprintable
    }
    printf("|\n\n");

    i32 minus_two = -2;
    u64 counting = 0x0123_4567_89AB_CDEF;
    f64 one_and_a_half = 1.5;
    auto h = Header { .magic = 0x6162_6F43, .version = 3, .flags = 256 };   // magic's bytes spell "Coba"
    dump("i32 -2          ", reinterpret_ptr<u8>(rawptr_of(&minus_two)), sizeof<i32>());
    dump("u64 0x01..ef    ", reinterpret_ptr<u8>(rawptr_of(&counting)), sizeof<u64>());
    dump("f64 1.5         ", reinterpret_ptr<u8>(rawptr_of(&one_and_a_half)), sizeof<f64>());
    dump("Header          ", reinterpret_ptr<u8>(rawptr_of(&h)), sizeof<Header>());
}
