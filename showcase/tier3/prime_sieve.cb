// Prime Sieve
//
// Shows: the Sieve of Eratosthenes over a `Vec<bool>`, every access
// bounds-checked, every write through an exclusive borrow of the Vec.
// The sieve is built by one function and only read by the others --
// the types say so (`&mut` versus `&`).

import std;

fn sieve(usize limit) : Vec<bool>
{
    Vec<bool> is_prime = Vec::new();
    usize i = 0;
    while (i < limit)
    {
        Vec::push(&mut is_prime, i >= 2);
        i = i + 1;
    }
    usize p = 2;
    while (p * p < limit)
    {
        if (*Vec::index_shared(&is_prime, p))
        {
            usize m = p * p;
            while (m < limit)
            {
                *Vec::index_exclusive(&mut is_prime, m) = false;
                m = m + p;
            }
        }
        p = p + 1;
    }
    is_prime
}

fn count(ref<Vec<bool>, shared> s) : u64
{
    u64 n = 0;
    foreach (prime in s)
    {
        if (*prime)
        {
            n = n + 1;
        }
    }
    n
}

fn main()
{
    usize limit = 50000;
    Vec<bool> s = sieve(limit);
    printf("primes below 50000: ");
    printf("%v", count(&s));
    printf("\n");

    printf("the last five:");
    usize found = 0;
    usize i = limit - 1;
    array<usize, 5> last = [0, 0, 0, 0, 0];
    while (found < 5)
    {
        if (*Vec::index_shared(&s, i))
        {
            last[4 - found] = i;
            found = found + 1;
        }
        i = i - 1;
    }
    foreach (p in &last)
    {
        printf(" %v", p);
    }
    printf("\n");

    u64 twins = 0;
    usize t = 3;
    while (t + 2 < limit)
    {
        if (*Vec::index_shared(&s, t) && *Vec::index_shared(&s, t + 2))
        {
            twins = twins + 1;
        }
        t = t + 2;
    }
    printf("twin prime pairs below 50000: %v\n", twins);
}
