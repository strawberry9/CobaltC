// Prime Sieve
//
// Shows: the Sieve of Eratosthenes over a `Vec<bool>`, every access
// bounds-checked, every write through an exclusive borrow of the Vec.
// The sieve is built by one function and only read by the others --
// the types say so (`&mut` versus `&`).

import std;

fn sieve(usize limit) : Vec<bool>
{
    Vec<bool> is_prime = Vec::from_fn(limit, [](usize i) : bool { i >= 2 });   // element i is `i >= 2`
    usize p = 2;
    while (p * p < limit)
    {
        if (is_prime[p])
        {
            usize m = p * p;
            while (m < limit)
            {
                is_prime[m] = false;
                m += p;
            }
        }
        p += 1;
    }
    is_prime
}

fn count(ref<Vec<bool>, shared> s) : u64
{
    u64 n = 0;
    foreach (prime in s)
    {
        if (*prime)
        {
            n += 1;
        }
    }
    n
}

fn main()
{
    usize limit = 50000;
    Vec<bool> s = sieve(limit);
    printf("primes below 50000: ");
    printf("%v", count(&s));
    printf("\n");

    printf("the last five:");
    usize found = 0;
    usize i = limit - 1;
    array<usize, 5> last = [0, 0, 0, 0, 0];
    while (found < 5)
    {
        if (s[i])
        {
            last[4 - found] = i;
            found += 1;
        }
        i -= 1;
    }
    foreach (p in &last)
    {
        printf(" %v", p);
    }
    printf("\n");

    u64 twins = 0;
    for (usize t = 3; t + 2 < limit; t += 2)            // odd t only
    {
        if (s[t] && s[t + 2])
        {
            twins += 1;
        }
    }
    printf("twin prime pairs below 50000: %v\n", twins);
}
