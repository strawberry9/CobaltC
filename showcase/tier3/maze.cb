// Maze
//
// Shows: breadth-first search with `std`'s `Queue`. `push_back` adds a
// square to visit and `pop_front` takes the one that has waited longest,
// so squares are reached in order of distance from the start and the
// first path found to the exit is a shortest one. Each square remembers
// the square it was reached from as an `Option<usize>` — `None` for the
// start and for every square never reached — so walking the path back
// can only follow squares the search really visited, and a maze with no
// way out is a `None` the caller must handle, not a sentinel. The maze
// is text: rows of `str`, copied byte by byte into a `Vec<u8>` that the
// path is drawn on and printed through `String::push_ascii`.

import std;

struct Maze
{
    Vec<u8> cells;                                  // row by row
    usize width;
    usize height;
}

fn Maze::from_rows(slice<str, shared> rows) : Maze
{
    Vec<u8> cells = Vec::new();
    foreach (row in rows)
    {
        foreach (i in 0..str_len(*row))
        {
            Vec::push(&mut cells, str_byte(*row, i));
        }
    }
    Maze { .cells = cells, .width = str_len(rows[0]), .height = slice_len(rows) }
}

fn Maze::print(ref<Maze, shared> m)
{
    foreach (r in 0..m.height)
    {
        String line = String::new();
        foreach (c in 0..m.width)
        {
            String::push_ascii(&mut line, m.cells[r * m.width + c]);
        }
        printf("  %s\n", &line);
    }
}

// The squares one step from `at` that are inside the maze and not wall.
fn Maze::open_neighbours(ref<Maze, shared> m, usize at) : Vec<usize>
{
    usize w = m.width;
    usize row = at / w;
    usize col = at % w;
    array<Option<usize>, 4> steps = [
        if (row > 0) { Some(at - w) } else { None },
        if (row + 1 < m.height) { Some(at + w) } else { None },
        if (col > 0) { Some(at - 1) } else { None },
        if (col + 1 < w) { Some(at + 1) } else { None },
    ];
    Vec<usize> out = Vec::new();
    foreach (s in steps)
    {
        if (Some(n) = s)
        {
            if (m.cells[n] != b'#')
            {
                Vec::push(&mut out, n);
            }
        }
    }
    out
}

// Finds a shortest path from `S` to `E` and draws it with `.`: the number
// of steps, or `None` when the exit cannot be reached (or either is missing).
fn Maze::solve(ref<Maze, exclusive> m) : Option<usize>
{
    usize start = Vec::index_of(&m.cells, &b'S')?;
    usize exit = Vec::index_of(&m.cells, &b'E')?;
    Vec<Option<usize>> from = Vec::filled(Vec::len(&m.cells), None);
    Vec<bool> seen = Vec::filled(Vec::len(&m.cells), false);
    Queue<usize> todo = Queue::new();
    seen[start] = true;
    Queue::push_back(&mut todo, start);
    while (Some(at) = Queue::pop_front(&mut todo))  // the square that has waited longest
    {
        if (at == exit)
        {
            break;
        }
        foreach (n in Maze::open_neighbours(&*m, at))
        {
            if (!seen[n])
            {
                seen[n] = true;
                from[n] = Some(at);
                Queue::push_back(&mut todo, n);
            }
        }
    }
    if (!seen[exit])
    {
        return None;
    }
    // Back from the exit to the start, drawing the path between them.
    usize steps = 0;
    usize at = exit;
    while (Some(p) = from[at])
    {
        steps += 1;
        if (p != start)
        {
            m.cells[p] = b'.';
        }
        at = p;
    }
    Some(steps)
}

fn run(str name, slice<str, shared> rows)
{
    Maze m = Maze::from_rows(rows);
    printf("%s:\n", name);
    match (Maze::solve(&mut m))
    {
        Some(steps) :
        {
            Maze::print(&m);
            printf("  out in %d steps\n\n", steps);
        },
        None        :
        {
            Maze::print(&m);
            printf("  no way out\n\n");
        },
    }
}

fn main()
{
    array<str, 9> garden = [
        "#####################",
        "#S    #       #     #",
        "# ### # ##### # ### #",
        "#   #   #   #   #   #",
        "### ##### # ####### #",
        "#   #     #     #   #",
        "# ### ######### # # #",
        "#       #         #E#",
        "#####################",
    ];
    array<str, 5> cellar = [
        "###########",
        "#S  #     #",
        "### # ### #",
        "#   #   #E#",
        "###########",
    ];
    run("the garden", &garden[0..$]);
    run("the cellar", &cellar[0..$]);
}
