$ static_site $TMP
GET   /                            200 text/html; charset=utf-8   43 bytes  <h1>Welcome</h1>
GET   /style.css                   200 text/css                   32 bytes  body { font: 16px sans-serif; }
GET   /logo.svg                    200 image/svg+xml              62 bytes  <svg xmlns="http://www.w3.org/2000/svg"><circle r="4"/></svg>
GET   /docs/                       200 text/html; charset=utf-8   14 bytes  <h1>Docs</h1>
GET   /docs/release%20notes.txt    200 text/plain; charset=utf-8   21 bytes  1.4.0: HTTP arrived.
HEAD  /index.html                  200 text/html; charset=utf-8   43 bytes  
GET   /missing.html                404 text/plain                 10 bytes  not found
GET   /../etc/passwd               400 text/plain                  8 bytes  refused
GET   /docs/%2e%2e/%2e%2e/etc/passwd 400 text/plain                  8 bytes  refused
server: 0
[exit 0]
