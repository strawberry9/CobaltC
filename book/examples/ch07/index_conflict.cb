import std;

fn set_and_read(ref<i32, exclusive> a, ref<i32, shared> b) : i32
{
    *a = 1;                           // ✗ at run time when i == j
    *b
}

fn main()
{
    array<i32, 3> v = [0, 0, 0];
    usize i = 0;
    while (i < 3)
    {
        usize j = 2 - i;
        printf("%v\n", set_and_read(&mut v[i], &v[j]));    // decided by i and j
        i = i + 1;
    }
}
