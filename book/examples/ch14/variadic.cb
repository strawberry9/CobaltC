import std;

unsafe extern fn snprintf(rawptr<u8> buf, usize n, rawptr<u8> fmt, ...) : i32;

fn main()
{
    rawptr<u8> buf = Result::expect(allocate(64, 1), "allocate");
    i32 count = 3;
    f64 average = 2.5;
    unsafe
    {
        snprintf(buf, 64, str_ptr("%d items, average %.2f"), count, average);
    }
    printf("%s\n", &Result::expect(unsafe { String::from_c(buf) }, "utf8"));
    unsafe
    {
        deallocate(buf, 64, 1);
    }
}
