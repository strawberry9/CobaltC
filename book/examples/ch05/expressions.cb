import std;

fn main()
{
    i32 n = 7;
    str parity = if (n % 2 == 0) { "even" } else { "odd" };     // if is an expression

    i32 squared =                     // a block is an expression: its last line is its value
    {
        i32 t = n * n;
        t
    };

    i32 clamped = if (n < 0)
    {
        0
    }
    else if (n > 5)
    {
        5
    }
    else
    {
        n
    };

    printf("%v is %v; squared %v; clamped %v\n", n, parity, squared, clamped);
}
