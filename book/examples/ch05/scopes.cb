import std;

fn main()
{
    i32 x = 1;
    {
        i32 y = x + 1;                // y lives until this block ends
        i32 x = 100;                  // an inner x hides the outer one here
        printf("inner %v %v\n", x, y);
    }
    printf("outer %v\n", x);          // the outer x, untouched
    printf("%v\n", y);                // ✗ y's block has ended
}
