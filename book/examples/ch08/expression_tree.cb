import std;

// An expression tree: a number, or an operator over two smaller trees.
enum Expr
{
    Num(f64),
    Neg(Box<Expr>),
    Bin { u8 op; Box<Expr> a; Box<Expr> b; },
}

fn eval(ref<Expr, shared> e) : f64
{
    match (e)
    {
        Expr::Num(v)           : *v,
        Expr::Neg(*x)          : -eval(x),
        Expr::Bin { op, a, b } :
        {
            f64 x = eval(Box::get(a));
            f64 y = eval(Box::get(b));
            match (*op)
            {
                b'+' : x + y,
                b'-' : x - y,
                b'*' : x * y,
                _    : x / y,
            }
        },
    }
}

fn main()
{
    // (1 + 2) * -4
    Expr sum = Expr::Bin { .op = b'+', .a = Box::new(Expr::Num(1.0)), .b = Box::new(Expr::Num(2.0)) };
    Expr e = Expr::Bin { .op = b'*', .a = Box::new(sum), .b = Box::new(Expr::Neg(Box::new(Expr::Num(4.0)))) };
    printf("%v\n", eval(&e));
}
