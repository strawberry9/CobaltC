import std;

fn total(Vec<i32> v) : i32            // takes the vector: it is destroyed when total ends
{
    i32 t = 0;
    foreach (x in v)
    {
        t += x;
    }
    t
}

fn main()
{
    Vec<i32> nums = Vec::new();
    Vec::push(&mut nums, 4);
    Vec::push(&mut nums, 5);
    printf("%v\n", total(nums));      // nums moves into the call
    printf("%v\n", Vec::len(&nums));  // ✗ nums no longer owns anything
}
