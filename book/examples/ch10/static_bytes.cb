import std;

struct Format
{
    str name;
    slice<u8, shared> magic;
}

fn main()
{
    array<Format, 2> known = [
        Format { .name = "png", .magic = b"\x89PNG" },
        Format { .name = "zip", .magic = b"PK\x03\x04" },
    ];
    foreach (f in &known)
    {
        printf("%v: %v bytes, first %v\n", f.name, slice_len(f.magic), f.magic[0]);
    }
}
