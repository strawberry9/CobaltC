// `std::crypto` (spec/21 §2m, D-0151 to D-0170, D-0187): cryptography,
// in four submodules, each re-exported here so `sha256`, `hmac`,
// `aes_gcm_seal` and `ed25519_sign` are `std::crypto`'s own names, and
// `std`'s: `digest` (the digests, `digest_eq`, `crc32`), `kdf` (HMAC, HKDF,
// PBKDF2, Argon2id, password hashing), `aead` (ChaCha20-Poly1305,
// AES-GCM) and `pk` (X25519, P-256/P-384, ECDSA, Ed25519, RSA). Written in
// CobaltC, so both implementations compute exactly this. Keys and nonces
// come from `os_random_bytes` (D-0142). What every submodule needs stays
// here, private to `std`.

fn hash_len(HashKind kind) : usize
{
    match (kind)
    {
        Sha1     : 20,
        Sha2_256 : 32,
        Sha2_384 : 48,
        Sha2_512 : 64,
    }
}

// The block size of a hash, which HMAC pads its key to.
fn block_len(HashKind kind) : usize
{
    match (kind)
    {
        Sha1     : 64,
        Sha2_256 : 64,
        _        : 128,
    }
}

// The positions G mixes, four per call, eight calls per round (RFC 7693
// §3.2): the columns, then the diagonals.
const array<u8, 32> BLAKE2B_G = [
    0,
    4,
    8,
    12,
    1,
    5,
    9,
    13,
    2,
    6,
    10,
    14,
    3,
    7,
    11,
    15,
    0,
    5,
    10,
    15,
    1,
    6,
    11,
    12,
    2,
    7,
    8,
    13,
    3,
    4,
    9,
    14,
];

export module digest "crypto/digest.cb";
export module kdf "crypto/kdf.cb";
export module aead "crypto/aead.cb";
export module pk "crypto/pk.cb";

export import std::crypto::digest;
export import std::crypto::kdf;
export import std::crypto::aead;
export import std::crypto::pk;
