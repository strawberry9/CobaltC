// `std::database` (spec/21 §2q, D-0180, D-0187): database clients, one
// submodule per server, each re-exported here: `postgres` (the `Pg*`
// items). What they share is declared here: SCRAM-SHA-256 (RFC 5802, RFC
// 7677), the SASL mechanism PostgreSQL and others authenticate with.

// ---- SCRAM-SHA-256 (RFC 5802, RFC 7677), the client side ----

// The salted password: PBKDF2 over HMAC-SHA-256, 32 bytes. The password
// is used as given; `saslprep` prepares it first (the PostgreSQL client
// does).
/// The SCRAM-SHA-256 salted password: PBKDF2 over HMAC-SHA-256 of `password` and `salt`, 32 bytes.
///
/// `iterations` is the server's count. The password is used as given: RFC 5802 prepares it with SASLprep
/// first (`saslprep`), as the PostgreSQL client does before `Scram::respond`.
export fn scram_salted_password(StringView password, slice<u8, shared> salt, usize iterations) : Vec<u8>
{
    pbkdf2(Sha2_256, StringView::as_bytes(password), salt, iterations, 32)
}

// One SCRAM-SHA-256 exchange, without channel binding: `start` with the
// user (its "," and "=" escaped; PostgreSQL ignores it and is sent "")
// and the client's nonce, `client_first` to send, `respond` to the
// server's first message gives the client's final message, `verify`
// checks the server's.
// Exported so the exchange can be checked against RFC 7677's vectors and
// so a program can speak it to another server.
/// The client's side of one SCRAM-SHA-256 exchange (RFC 5802, RFC 7677), without channel binding.
///
/// The steps in order: `Scram::start`, send `Scram::client_first`, answer the server's first message with
/// `Scram::respond`, then check the server's final message with `Scram::verify`. The PostgreSQL client uses
/// it; it is exported so a program can speak the exchange to another server.
export struct Scram
{
    String client_nonce;
    String client_first_bare;
    Vec<u8> server_signature;
}

/// A new exchange for `user` with the client's nonce `client_nonce`.
///
/// `,` and `=` in `user` are escaped as `=2C` and `=3D`. The nonce should be fresh random text for each
/// exchange, such as the base64 of bytes from `os_random_bytes`. PostgreSQL ignores the user, and its client
/// sends `""`.
export fn Scram::start(StringView user, StringView client_nonce) : Scram
{
    String bare = "n=";
    foreach (c in StringView::as_bytes(user))
    {
        if (*c == b',')
        {
            String::append(&mut bare, "=2C");
        }
        else if (*c == b'=')
        {
            String::append(&mut bare, "=3D");
        }
        else
        {
            String::push_ascii(&mut bare, *c);
        }
    }
    String::append(&mut bare, ",r=");
    String::append(&mut bare, client_nonce);
    Scram { .client_nonce = String::copy(client_nonce), .client_first_bare = bare, .server_signature = Vec::new() }
}

// `n,,n=<user>,r=<nonce>`: no channel binding.
/// The client's first message, `n,,n=USER,r=NONCE`: no channel binding.
export fn Scram::client_first(ref<Scram, shared> s) : String
{
    String m = "n,,";
    String::append(&mut m, &s.client_first_bare);
    m
}

fn attribute(slice<StringView, shared> parts, str name) : Option<StringView>
{
    foreach (p in parts)
    {
        if (StringView::starts_with(*p, StringView::of(name)))
        {
            return Some(&(*p)[2..$]);
        }
    }
    None
}

// The client's final message for the server's first (`r=…,s=…,i=…`):
// the proof of `password`. `AuthFailed` when the server's nonce does not
// begin with the client's, `ProtocolViolation` when the message is malformed or
// asks for an extension.
/// The client's final message, carrying the proof of `password`, for the server's first message.
///
/// `server_first` is the server's `r=…,s=…,i=…`. Remembers the signature `Scram::verify` then expects.
/// `Err(AuthFailed)` when the server's nonce does not begin with the client's and add to it;
/// `Err(ProtocolViolation)` when the message is malformed, asks for an extension (`m=`), gives an iteration
/// count of 0 or a salt that is not base64.
export fn Scram::respond(
    ref<Scram, exclusive> s,
    StringView server_first,
    StringView password,
) : Result<String, PgError>
{
    Vec<StringView> parts = StringView::split(server_first, ",");
    if (Option::is_some(&attribute(&parts, "m=")))
    {
        return Err(ProtocolViolation);
    }
    StringView nonce = Option::ok_or(attribute(&parts, "r="), ProtocolViolation)?;
    StringView salt_text = Option::ok_or(attribute(&parts, "s="), ProtocolViolation)?;
    StringView iter_text = Option::ok_or(attribute(&parts, "i="), ProtocolViolation)?;
    if (!StringView::starts_with(
        nonce,
        &s.client_nonce,
    ) || StringView::len(nonce) <= StringView::len(&s.client_nonce))
    {
        return Err(AuthFailed);
    }
    Vec<u8> salt = match (base64_decode(salt_text))
    {
        Ok(v)  : v,
        Err(_) : return Err(ProtocolViolation),
    };
    usize iterations = match (StringView::parse<usize>(iter_text))
    {
        Ok(n)  : n,
        Err(_) : return Err(ProtocolViolation),
    };
    if (iterations == 0)
    {
        return Err(ProtocolViolation);
    }
    Vec<u8> salted = scram_salted_password(password, &salt, iterations);
    array<u8, 32> client_key = hmac_sha256(&salted, b"Client Key");
    array<u8, 32> stored_key = sha256(&client_key);
    String without_proof = "c=biws,r=";
    String::append(&mut without_proof, nonce);
    String auth = String::clone(&s.client_first_bare);
    String::append(&mut auth, ",");
    String::append(&mut auth, server_first);
    String::append(&mut auth, ",");
    String::append(&mut auth, &without_proof);
    array<u8, 32> client_signature = hmac_sha256(&stored_key, StringView::as_bytes(&auth));
    Vec<u8> proof = Vec::new();
    for (usize i = 0; i < 32; i += 1)
    {
        Vec::push(&mut proof, client_key[i] ^ client_signature[i]);
    }
    array<u8, 32> server_key = hmac_sha256(&salted, b"Server Key");
    array<u8, 32> server_signature = hmac_sha256(&server_key, StringView::as_bytes(&auth));
    overwrite(&mut s.server_signature, Vec::from_slice(&server_signature));
    String::append(&mut without_proof, ",p=");
    String::append(&mut without_proof, &base64_encode(&proof));
    Ok(without_proof)
}

// Whether the server's final message (`v=…`) carries the signature the
// exchange expects; false for anything else (an `e=` error among them),
// and false before `respond` has computed the signature to expect.
/// Whether the server's final message (`v=…`) carries the signature this exchange expects.
///
/// `false` for anything else, an `e=` error among them, and `false` before `Scram::respond` has succeeded
/// (there is no signature to expect yet).
export fn Scram::verify(ref<Scram, shared> s, StringView server_final) : bool
{
    if (Vec::len(&s.server_signature) == 0 || !StringView::starts_with(server_final, "v="))
    {
        return false;
    }
    match (base64_decode(&server_final[2..$]))
    {
        Ok(v)  : digest_eq(&v, &s.server_signature),
        Err(_) : false,
    }
}

/// RFC 7677's exchange with the iteration count 4, and the server's signature checked.
unittest "Scram: a whole exchange"
{
    Scram s = Scram::start("user", "rOprNGfwEbeRWgbNEkqO");
    assert(Scram::client_first(&s) == "n,,n=user,r=rOprNGfwEbeRWgbNEkqO");
    String first = "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,";
    String::append(&mut first, "s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4");
    String reply = Result::unwrap(Scram::respond(&mut s, &first, "pencil"));
    assert(StringView::ends_with(&reply, ",p=0ByS2g6XZEtov8MR140MFRsEfy8/X+bacfpPofVtKjE="));
    assert(Scram::verify(&s, "v=ITrN4zX09+hsD398Qk6ol73eg0shWPnOWwnwS83jitc="));
    assert(!Scram::verify(&s, "e=invalid-proof"));
}

// ---- SASLprep (RFC 4013) ----
//
// D-0336: the preparation SCRAM applies to a password (RFC 5802 §2.2)
// and PostgreSQL to the passwords it stores: stringprep (RFC 3454) with
// the SASLprep profile, over Unicode 3.2. Tables generated from Python's
// `unicodedata.ucd_3_2_0` and `stringprep` (impl/tools/gen_saslprep.py),
// so no library is linked.

// The hexadecimal number `t` (a table entry's part).
fn sasl_hex(StringView t) : u32
{
    u32 v = 0;
    foreach (c in StringView::as_bytes(t))
    {
        u32 d = if (*c >= b'a') { widen<u32>(*c - b'a') + 10 } else { widen<u32>(*c - b'0') };
        v = v * 16 + d;
    }
    v
}

// Whether `cp` is in a table of ranges (`lo-hi;` or `cp;`).
fn sasl_in(str table, u32 cp) : bool
{
    foreach (e in StringView::split(StringView::of(table), ";"))
    {
        if (StringView::len(e) == 0)
        {
            continue;
        }
        match (StringView::find(e, "-"))
        {
            Some(d) :
            {
                if (cp >= sasl_hex(&e[0..d]) && cp <= sasl_hex(&e[d + 1..$]))
                {
                    return true;
                }
            },
            None    : if (cp == sasl_hex(e)) { return true; },
        }
    }
    false
}

// A table of `key=value` entries, the key one code point or two (`a,b`)
// packed into a u64, the values the code points after `=`.
fn sasl_map(str table) : HashMap<u64, Vec<u32>>
{
    HashMap<u64, Vec<u32>> m = HashMap::new();
    foreach (e in StringView::split(StringView::of(table), ";"))
    {
        usize eq = match (StringView::find(e, "="))
        {
            Some(i) : i,
            None    : continue,
        };
        u64 key = 0;
        foreach (k in StringView::split(&e[0..eq], ","))
        {
            key = (key << 21) | widen<u64>(sasl_hex(k));
        }
        Vec<u32> v = Vec::new();
        foreach (x in StringView::split(&e[eq + 1..$], ","))
        {
            Vec::push(&mut v, sasl_hex(x));
        }
        _ = HashMap::insert(&mut m, key, v);
    }
    m
}

// Hangul syllables (Unicode 3.2 §3.12): decomposed and composed by
// arithmetic, not by the tables.
const u32 HANGUL_S = 0xAC00;
const u32 HANGUL_L = 0x1100;
const u32 HANGUL_V = 0x1161;
const u32 HANGUL_T = 0x11A7;
const u32 HANGUL_COUNT = 11172;

// NFKC (UAX #15, Unicode 3.2): the compatibility decomposition, the
// canonical order of combining marks, then canonical composition.
fn sasl_nfkc(ref<Vec<u32>, shared> input) : Vec<u32>
{
    HashMap<u64, Vec<u32>> nfkd = sasl_map(SASLPREP_NFKD);
    HashMap<u64, Vec<u32>> ccc = sasl_map(SASLPREP_CCC);
    HashMap<u64, Vec<u32>> compose = sasl_map(SASLPREP_COMPOSE);
    Vec<u32> d = Vec::new();
    foreach (c in input)
    {
        u32 cp = *c;
        if (cp >= HANGUL_S && cp < HANGUL_S + HANGUL_COUNT)
        {
            u32 s = cp - HANGUL_S;
            Vec::push(&mut d, HANGUL_L + s / 588);
            Vec::push(&mut d, HANGUL_V + (s % 588) / 28);
            if (s % 28 != 0)
            {
                Vec::push(&mut d, HANGUL_T + s % 28);
            }
        }
        else
        {
            match (HashMap::get(&nfkd, widen<u64>(cp)))
            {
                Some(m) : Vec::extend_from(&mut d, m),
                None    : Vec::push(&mut d, cp),
            }
        }
    }
    // Each combining mark after the starter before it, by class (stable).
    usize n = Vec::len(&d);
    Vec<u32> class = Vec::new();
    foreach (c in &d)
    {
        u32 k = match (HashMap::get(&ccc, widen<u64>(*c)))
        {
            Some(v) : v[0],
            None    : 0,
        };
        Vec::push(&mut class, k);
    }
    for (usize i = 1; i < n; i += 1)
    {
        usize j = i;
        while (j > 0 && class[j] != 0 && class[j - 1] > class[j])
        {
            Vec::swap(&mut d, j - 1, j);
            Vec::swap(&mut class, j - 1, j);
            j -= 1;
        }
    }
    if (n == 0)
    {
        return d;
    }
    Vec<u32> out = Vec::new();
    Vec::push(&mut out, d[0]);
    usize starter = 0;
    u32 last = if (class[0] == 0) { 0 } else { 256 };
    for (usize i = 1; i < n; i += 1)
    {
        u32 c = d[i];
        u32 cc = class[i];
        u32 s = out[starter];
        Option<u32> composite = None;
        if (s >= HANGUL_L && s < HANGUL_L + 19 && c >= HANGUL_V && c < HANGUL_V + 21)
        {
            composite = Some(HANGUL_S + ((s - HANGUL_L) * 21 + (c - HANGUL_V)) * 28);
        }
        else if (s >= HANGUL_S && s < HANGUL_S + HANGUL_COUNT && (s - HANGUL_S) % 28 == 0 && c > HANGUL_T && c < HANGUL_T + 28)
        {
            composite = Some(s + (c - HANGUL_T));
        }
        else if (Some(m) = HashMap::get(&compose, (widen<u64>(s) << 21) | widen<u64>(c)))
        {
            composite = Some(m[0]);
        }
        // Composed unless a mark of the same or a higher class, or a
        // starter, stands between (blocked).
        if (Some(k) = composite)
        {
            if (last < cc || last == 0)
            {
                out[starter] = k;
                continue;
            }
        }
        if (cc == 0)
        {
            starter = Vec::len(&out);
        }
        last = cc;
        Vec::push(&mut out, c);
    }
    out
}

// D-0336: SASLprep (RFC 4013), step by step as PostgreSQL's own
// (src/common/saslprep.c), which both the server (for the passwords it
// stores) and libpq (for the password it sends) run: where that differs
// from a literal reading of the RFCs, PostgreSQL's reading is followed,
// since a password prepared differently cannot log in.
/// `text` prepared by SASLprep (RFC 4013), as PostgreSQL prepares the passwords it stores and libpq the
/// password it sends; `None` when the result is prohibited.
///
/// The steps of stringprep (RFC 3454) with the SASLprep profile, over Unicode 3.2, in the order and on the
/// text PostgreSQL's own SASLprep uses: ASCII text comes back unchanged, controls included; otherwise the
/// non-ASCII spaces of table C.1.2 (no-break space, U+200B zero width space and the others) become U+0020
/// and the characters of table B.1 (soft hyphen, zero-width joiners, variation selectors) are removed;
/// `None` when nothing is left; then `None` when the mapped text holds a character of the prohibited
/// tables (C.1.2, C.2.1, C.2.2, C.3 to C.9: controls, private use, non-characters, surrogates, tagging and
/// the bidirectional controls) or a code point Unicode 3.2 leaves unassigned (table A.1, the rule for stored
/// strings), or breaks the bidirectional rule (text with a right-to-left character holds no left-to-right
/// one and begins and ends with a right-to-left one); these checks read the mapped text before
/// normalisation, as PostgreSQL's do. The result is the mapped text normalised to NFKC (with Corrigendum #4,
/// as every Unicode version after 3.2). A client that gets `None` uses the password as given, as libpq does.
export fn saslprep(StringView text) : Option<String>
{
    bool ascii = true;
    foreach (b in StringView::as_bytes(text))
    {
        if (*b >= 0x80)
        {
            ascii = false;
        }
    }
    if (ascii)
    {
        return Some(String::copy(text));
    }
    // C.1.2 before B.1: U+200B is in both, and PostgreSQL makes it a space.
    Vec<u32> mapped = Vec::new();
    foreach (ch in StringView::chars(text))
    {
        u32 cp = Option::unwrap(StringView::code_point(ch));
        if (sasl_in(SASLPREP_C12, cp))
        {
            Vec::push(&mut mapped, 0x20);
        }
        else if (!sasl_in(SASLPREP_B1, cp))
        {
            Vec::push(&mut mapped, cp);
        }
    }
    usize n = Vec::len(&mapped);
    if (n == 0)
    {
        return None;
    }
    bool randal = false;
    bool l = false;
    foreach (c in &mapped)
    {
        if (sasl_in(SASLPREP_PROHIBITED, *c) || sasl_in(SASLPREP_UNASSIGNED, *c))
        {
            return None;
        }
        if (sasl_in(SASLPREP_RANDAL, *c))
        {
            randal = true;
        }
        if (sasl_in(SASLPREP_L, *c))
        {
            l = true;
        }
    }
    if (randal && (l || !sasl_in(SASLPREP_RANDAL, mapped[0]) || !sasl_in(SASLPREP_RANDAL, mapped[n - 1])))
    {
        return None;
    }
    Vec<u32> norm = sasl_nfkc(&mapped);
    String out = String::new();
    foreach (c in &norm)
    {
        String::push_code_point(&mut out, *c);
    }
    Some(out)
}

/// RFC 4013 §3's examples, a Hangul syllable kept composed, and a decomposed accent composed.
unittest "saslprep: the RFC's examples"
{
    assert(Option::unwrap(saslprep("I\u{AD}X")) == "IX");
    assert(Option::unwrap(saslprep("user")) == "user");
    assert(Option::unwrap(saslprep("USER")) == "USER");
    assert(Option::unwrap(saslprep("\u{AA}")) == "a");
    assert(Option::unwrap(saslprep("\u{2168}")) == "IX");
    assert(Option::unwrap(saslprep("\u{7}")) == "\u{7}");
    assert(Option::is_none(&saslprep("\u{627}1")));
    assert(Option::unwrap(saslprep("a\u{A0}b")) == "a b");
    assert(Option::unwrap(saslprep("\u{D55C}")) == "\u{D55C}");
    assert(Option::unwrap(saslprep("e\u{301}")) == "\u{E9}");
    assert(Option::is_none(&saslprep("\u{221}\u{A0}x")));
}

/// Where PostgreSQL's SASLprep reads the RFCs its own way: U+200B (in both C.1.2 and B.1) becomes a space,
/// a text of mapped-to-nothing characters only is refused, the checks read the text before NFKC (U+0340
/// is refused though it normalises to U+0300; U+2122 is not left-to-right though "TM" is), and the
/// decompositions are Corrigendum #4's.
unittest "saslprep: as PostgreSQL's"
{
    assert(Option::unwrap(saslprep("x\u{200B}z")) == "x z");
    assert(Option::is_none(&saslprep("\u{AD}\u{200D}")));
    assert(Option::is_none(&saslprep("e\u{340}")));
    assert(Option::unwrap(saslprep("\u{5D0}\u{2122}\u{5D0}")) == "\u{5D0}TM\u{5D0}");
    assert(Option::unwrap(saslprep("\u{2F868}")) == "\u{36FC}");
}

// ---- SASLprep tables: generated by impl/tools/gen_saslprep.py, do not edit ----
// From Python's unicodedata.ucd_3_2_0 and stringprep (Unicode 3.2, as RFC 3454 and
// RFC 4013 define them; the decompositions with Corrigendum #4, as PostgreSQL applies
// them). Only code points Unicode 3.2 assigns. Entries are hexadecimal code points,
// each ended by `;`.

// The full compatibility decomposition (NFKD) of each code point that has one, Hangul syllables apart: `cp=d1,d2,...`.
const str SASLPREP_NFKD =
    "a0=20;a8=20,308;aa=61;af=20,304;b2=32;b3=33;b4=20,301;b5=3bc;b8=20,327;b9=31;ba=6f;bc=31,2044,34"
    ";bd=31,2044,32;be=33,2044,34;c0=41,300;c1=41,301;c2=41,302;c3=41,303;c4=41,308;c5=41,30a;c7=43,3"
    "27;c8=45,300;c9=45,301;ca=45,302;cb=45,308;cc=49,300;cd=49,301;ce=49,302;cf=49,308;d1=4e,303;d2="
    "4f,300;d3=4f,301;d4=4f,302;d5=4f,303;d6=4f,308;d9=55,300;da=55,301;db=55,302;dc=55,308;dd=59,301"
    ";e0=61,300;e1=61,301;e2=61,302;e3=61,303;e4=61,308;e5=61,30a;e7=63,327;e8=65,300;e9=65,301;ea=65"
    ",302;eb=65,308;ec=69,300;ed=69,301;ee=69,302;ef=69,308;f1=6e,303;f2=6f,300;f3=6f,301;f4=6f,302;f"
    "5=6f,303;f6=6f,308;f9=75,300;fa=75,301;fb=75,302;fc=75,308;fd=79,301;ff=79,308;100=41,304;101=61"
    ",304;102=41,306;103=61,306;104=41,328;105=61,328;106=43,301;107=63,301;108=43,302;109=63,302;10a"
    "=43,307;10b=63,307;10c=43,30c;10d=63,30c;10e=44,30c;10f=64,30c;112=45,304;113=65,304;114=45,306;"
    "115=65,306;116=45,307;117=65,307;118=45,328;119=65,328;11a=45,30c;11b=65,30c;11c=47,302;11d=67,3"
    "02;11e=47,306;11f=67,306;120=47,307;121=67,307;122=47,327;123=67,327;124=48,302;125=68,302;128=4"
    "9,303;129=69,303;12a=49,304;12b=69,304;12c=49,306;12d=69,306;12e=49,328;12f=69,328;130=49,307;13"
    "2=49,4a;133=69,6a;134=4a,302;135=6a,302;136=4b,327;137=6b,327;139=4c,301;13a=6c,301;13b=4c,327;1"
    "3c=6c,327;13d=4c,30c;13e=6c,30c;13f=4c,b7;140=6c,b7;143=4e,301;144=6e,301;145=4e,327;146=6e,327;"
    "147=4e,30c;148=6e,30c;149=2bc,6e;14c=4f,304;14d=6f,304;14e=4f,306;14f=6f,306;150=4f,30b;151=6f,3"
    "0b;154=52,301;155=72,301;156=52,327;157=72,327;158=52,30c;159=72,30c;15a=53,301;15b=73,301;15c=5"
    "3,302;15d=73,302;15e=53,327;15f=73,327;160=53,30c;161=73,30c;162=54,327;163=74,327;164=54,30c;16"
    "5=74,30c;168=55,303;169=75,303;16a=55,304;16b=75,304;16c=55,306;16d=75,306;16e=55,30a;16f=75,30a"
