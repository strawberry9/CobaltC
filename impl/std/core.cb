// `std::core` (spec/21 §0, §3b): `Option`, `Result`, `AllocError`, and
// the functions every program uses whatever it does. `assert` and
// `Result::map_err` are realized natively by both implementations.

/// A value that may be absent: `Some(T)` holds one, `None` holds nothing.
///
/// In `std` after `import std;`, unqualified, as are its variants.
export enum Option<T>
{
    Some(T),
    None,
}

/// The outcome of an operation that can fail: `Ok(T)` holds the value, `Err(E)` the error.
///
/// `?` on a `Result` returns an `Err` from the enclosing function. In `std` after `import std;`,
/// unqualified, as are its variants.
export enum Result<T, E>
{
    Ok(T),
    Err(E),
}

/// The error `allocate` returns when memory cannot be had; it carries nothing.
export struct AllocError
{
}

/// The value in `o`, or `d` when `o` is `None`.
///
/// An unused `d` is destroyed at the call's end.
export fn Option::unwrap_or<T>(Option<T> o, T d) : T
{
    match (o)
    {
        Some(v) : v,
        None    : d,
    }
}

// D-0114: an Option as a Result, so `?` applies: the value, or `e` as
// the error. `e` is built before the call; unused, it ends with the
// statement.
/// `o` as a `Result`: `Ok` of its value, or `Err(e)` when `o` is `None`, so `?` applies.
///
/// `e` is evaluated before the call; unused, it ends with the statement.
export fn Option::ok_or<T, E>(Option<T> o, E e) : Result<T, E>
{
    match (o)
    {
        Some(v) : Ok(v),
        None    : Err(e),
    }
}

/// `None` becomes `Err` of the given error; `Some` becomes `Ok`.
unittest "Option::ok_or: None becomes the error"
{
    Option<i32> none = None;
    Result<i32, u8> r = Option::ok_or(none, 7);
    match (r)
    {
        Ok(_)  : assert(false),
        Err(e) : assert(e == 7),
    }
    assert(Result::is_ok(&Option::ok_or(Some(5), 7)));
}

// D-0205: the value if there is one; the error, if any, ends here.
/// The value in `r` as an `Option`: `Some` of it, or `None` when `r` is `Err`.
///
/// The error, if any, is destroyed at the call's end.
export fn Result::ok<T, E>(Result<T, E> r) : Option<T>
{
    match (r)
    {
        Ok(v)  : Some(v),
        Err(_) : None,
    }
}

/// An `Err` becomes `None` and an `Ok` becomes `Some`.
unittest "Result::ok: dropping the error"
{
    Result<i32, u8> bad = Err(4);
    assert(Result::unwrap_or(bad, 0) == 0);
    Result<i32, u8> good = Ok(9);
    Option<i32> o = Result::ok(good);
    assert(Option::is_some(&o) && Option::unwrap(o) == 9);
}

/// The value in `r`, or `d` when `r` is `Err`.
///
/// An unused `d` or error is destroyed at the call's end.
export fn Result::unwrap_or<T, E>(Result<T, E> r, T d) : T
{
    match (r)
    {
        Ok(v)  : v,
        Err(_) : d,
    }
}

// D-0082: the value, or the fault `diag.unwrap-failed` (with the given
// message, for `expect`) when there is none.
/// The value in `o`.
///
/// Faults (`unwrap_failed`) when `o` is `None`. `Option::expect` gives the fault a message of your own;
/// `Option::unwrap_or` gives a default instead.
export fn Option::unwrap<T>(Option<T> o) : T
{
    match (o)
    {
        Some(v) : v,
        None    : fault(unwrap_failed, "`Option::unwrap` found `None`"),
    }
}

/// The value in `o`, faulting with `message` when there is none.
///
/// Faults (`unwrap_failed`, showing `message`) when `o` is `None`.
export fn Option::expect<T>(Option<T> o, str message) : T
{
    match (o)
    {
        Some(v) : v,
        None    : fault(unwrap_failed, message),
    }
}

/// The value in `r`.
///
/// Faults (`unwrap_failed`) when `r` is `Err`; the error's payload is destroyed. `Result::expect` gives the
/// fault a message of your own.
export fn Result::unwrap<T, E>(Result<T, E> r) : T
{
    match (r)
    {
        Ok(v)  : v,
        Err(_) : fault(unwrap_failed, "`Result::unwrap` found `Err`"),
    }
}

/// The value in `r`, faulting with `message` when `r` is an error.
///
/// Faults (`unwrap_failed`, showing `message`) when `r` is `Err`; the error's payload is destroyed.
export fn Result::expect<T, E>(Result<T, E> r, str message) : T
{
    match (r)
    {
        Ok(v)  : v,
        Err(_) : fault(unwrap_failed, message),
    }
}

// D-0073: which variant, without taking the value.
/// Whether `o` is `Some`, without consuming it.
export fn Option::is_some<T>(ref<Option<T>, shared> o) : bool
{
    match (o)
    {
        Some(_) : true,
        None    : false,
    }
}

/// Whether `o` is `None`, without consuming it.
export fn Option::is_none<T>(ref<Option<T>, shared> o) : bool
{
    !Option::is_some(o)
}

/// Whether `r` is `Ok`, without consuming it.
export fn Result::is_ok<T, E>(ref<Result<T, E>, shared> r) : bool
{
    match (r)
    {
        Ok(_)  : true,
        Err(_) : false,
    }
}

/// Whether `r` is `Err`, without consuming it.
export fn Result::is_err<T, E>(ref<Result<T, E>, shared> r) : bool
{
    !Result::is_ok(r)
}

// Exchanging values behind references (`rule.stdlib.swap`, spec/21 §3b,
// D-0048). Moving out of a borrowed place is refused, so a program cannot
// exchange two values it holds only by reference; these do it inside
// `std`. `swap_places` is a std-only intrinsic: it exchanges the two
// places' contents (a resource stays owned by the place it is now in).
/// Exchanges the values behind `a` and `b`.
///
/// A program cannot move a value out of a place it reaches through a reference, so it cannot exchange two
/// fields of a borrowed struct itself; this does. Nothing is copied or destroyed: a resource is now owned by
/// the place it is in. Each place is written as `*a = v` would write it: a live reference that conflicts with
/// either one, such as a shared reborrow of `*a`, makes the exchange fault. For two elements of one `Vec` or
/// slice, use `Vec::swap` or `slice_swap`, which check the bounds and allow `i == j`.
export fn swap<T>(ref<T, exclusive> a, ref<T, exclusive> b)
{
    swap_places(a, b);
}

// Puts v in *r and returns what was there.
/// Puts `v` in `*r` and returns what was there.
///
/// `swap` with a fresh value. `overwrite` destroys the old value instead of returning it.
export fn replace<T>(ref<T, exclusive> r, T v) : T
{
    auto old = v;
    swap_places(r, &mut old);
    old
}

/// `replace` hands back the old value; `swap` exchanges two places.
unittest "replace: the old value comes back"
{
    i32 a = 1;
    i32 old = replace(&mut a, 2);
    assert(old == 1 && a == 2);
    i32 b = 3;
    swap(&mut a, &mut b);
    assert(a == 3 && b == 2);
}

// D-0080: puts v in *r and destroys what was there, where the call is.
/// Puts `v` in `*r` and destroys what was there, at the call.
///
/// The way to assign over a place that holds a resource, which plain assignment refuses.
export fn overwrite<T>(ref<T, exclusive> r, T v)
{
    drop(replace(r, v));
}
