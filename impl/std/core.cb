// `std::core` (spec/21 §0, §3b): `Option`, `Result`, `AllocError`, and
// the functions every program uses whatever it does. `assert` and
// `Result::map_err` are realized natively by both implementations.

export enum Option<T>
{
    Some(T),
    None,
}

export enum Result<T, E>
{
    Ok(T),
    Err(E),
}

export struct AllocError
{
}

export fn Option::unwrap_or<T>(Option<T> o, T d) : T
{
    match (o)
    {
        Some(v) : v,
        None    : d,
    }
}

// D-0114: an Option as a Result, so `?` applies: the value, or `e` as
// the error. `e` is built before the call; unused, it ends with the
// statement.
export fn Option::ok_or<T, E>(Option<T> o, E e) : Result<T, E>
{
    match (o)
    {
        Some(v) : Ok(v),
        None    : Err(e),
    }
}

export fn Result::unwrap_or<T, E>(Result<T, E> r, T d) : T
{
    match (r)
    {
        Ok(v)  : v,
        Err(_) : d,
    }
}

// D-0082: the value, or the fault `diag.unwrap-failed` (with the given
// message, for `expect`) when there is none.
export fn Option::unwrap<T>(Option<T> o) : T
{
    match (o)
    {
        Some(v) : v,
        None    : fault(unwrap_failed, "`Option::unwrap` found `None`"),
    }
}

export fn Option::expect<T>(Option<T> o, str message) : T
{
    match (o)
    {
        Some(v) : v,
        None    : fault(unwrap_failed, message),
    }
}

export fn Result::unwrap<T, E>(Result<T, E> r) : T
{
    match (r)
    {
        Ok(v)  : v,
        Err(_) : fault(unwrap_failed, "`Result::unwrap` found `Err`"),
    }
}

export fn Result::expect<T, E>(Result<T, E> r, str message) : T
{
    match (r)
    {
        Ok(v)  : v,
        Err(_) : fault(unwrap_failed, message),
    }
}

// D-0073: which variant, without taking the value.
export fn Option::is_some<T>(ref<Option<T>, shared> o) : bool
{
    match (o)
    {
        Some(_) : true,
        None    : false,
    }
}

export fn Option::is_none<T>(ref<Option<T>, shared> o) : bool
{
    !Option::is_some(o)
}

export fn Result::is_ok<T, E>(ref<Result<T, E>, shared> r) : bool
{
    match (r)
    {
        Ok(_)  : true,
        Err(_) : false,
    }
}

export fn Result::is_err<T, E>(ref<Result<T, E>, shared> r) : bool
{
    !Result::is_ok(r)
}

// Exchanging values behind references (`rule.stdlib.swap`, spec/21 §3b,
// D-0048). Moving out of a borrowed place is refused, so a program cannot
// exchange two values it holds only by reference; these do it inside
// `std`. `swap_places` is a std-only intrinsic: it exchanges the two
// places' contents (a resource stays owned by the place it is now in).
export fn swap<T>(ref<T, exclusive> a, ref<T, exclusive> b)
{
    swap_places(a, b);
}

// Puts v in *r and returns what was there.
export fn replace<T>(ref<T, exclusive> r, T v) : T
{
    auto old = v;
    swap_places(r, &mut old);
    old
}

// D-0080: puts v in *r and destroys what was there, where the call is.
export fn overwrite<T>(ref<T, exclusive> r, T v)
{
    drop(replace(r, v));
}

// D-0091: the numeric functions, over D-0090's bounds.

// The smaller of two values (`a` when they are equal).
export fn min<T: ordered>(T a, T b) : T
{
    if (b < a) { b } else { a }
}

// The larger of two values (`a` when they are equal).
export fn max<T: ordered>(T a, T b) : T
{
    if (b > a) { b } else { a }
}

// The magnitude: checked (`abs` of a signed type's minimum overflows);
// `abs(-0.0)` is `0.0`, and a NaN stays a NaN.
export fn abs<T: number>(T x) : T
{
    if (x < 0 || x == 0) { 0 - x } else { x }
}

// `base` to the power `exp` (`pow(x, 0)` is 1), by squaring: checked,
// and overflowing only when the result does.
export fn pow<T: number>(T base, u32 exp) : T
{
    T r = 1;
    T b = base;
    u32 e = exp;
    while (e > 0)
    {
        if ((e & 1) == 1) { r = r * b; }
        e = e >> 1;
        if (e > 0) { b = b * b; }
    }
    r
}
