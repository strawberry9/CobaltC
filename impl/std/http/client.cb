// `std::http::client` (spec/21 §2p, D-0173, D-0187): `HttpClient`,
// `http_get` and `http_post`: fetching a URL or posting to one, following
// redirects and decoding chunked bodies, with limits on what it will
// read, over a plain or a TLS connection.

// ---- the client (D-0173) ----

// What a client carries from request to request: the roots `https`
// verifies against (the system's, loaded at the first https request, or
// a store the program puts there), the timeout for connecting and for
// each read and write, how many redirects to follow, the most a body may
// be, and headers sent with every request. A program that makes several
// https requests keeps one client, so the roots are loaded once.
// D-0195: with `keep_alive` set, the client keeps the last connection open
// when the server allows it, and sends the next request to the same origin
// on it; otherwise (the default) each request has a connection of its own.
/// An HTTP/1.1 client: the settings and the state it carries from request to request.
///
/// - `roots`: the trusted roots https verifies servers against; `None` until the first https request
///   loads the system's (`TrustStore::system`), or a store the program puts there.
/// - `timeout_ms`: the timeout for connecting and for each read and write, in milliseconds.
/// - `max_redirects`: how many redirects `send` follows; 0 follows none, and `send` gives the 3xx response
///   itself (its `Location` and `Set-Cookie` there to read).
/// - `max_body`: the most bytes a response body may have, after decompression too (`TooLarge` beyond).
/// - `headers`: sent with every request; a request's own header of the same name replaces one.
/// - `keep_alive`: when set, the last connection is kept open while the server allows, and the next
///   request to the same origin goes on it; when not (the default), each request has its own connection.
///
/// A program that makes several https requests keeps one client, so the roots are loaded once.
export struct HttpClient
{
    export Option<TrustStore> roots;
    export u64 timeout_ms;
    export usize max_redirects;
    export usize max_body;
    export Vec<Header> headers;
    export bool keep_alive;
    Option<IdleConn> idle;
}

// A connection kept for the next request to `origin` (scheme://host:port).
struct IdleConn
{
    String origin;
    Reader r;
}

// A client with no roots loaded yet, a 30 s timeout, up to 10 redirects,
// a 16 MiB body limit, and a `User-Agent` header.
/// A client with the default settings.
///
/// No roots loaded yet, a 30 s timeout, up to 10 redirects, a 16 MiB body limit, `keep_alive` off, and
/// the headers `User-Agent` and `Accept-Encoding: gzip, deflate`.
export fn HttpClient::new() : HttpClient
{
    Vec<Header> headers = Vec::new();
    Vec::push(&mut headers, Header::new("User-Agent", "CobaltC-std-http/1"));
    Vec::push(&mut headers, Header::new("Accept-Encoding", "gzip, deflate"));
    HttpClient { .roots = None, .timeout_ms = 30000, .max_redirects = 10, .max_body = 16777216, .headers = headers, .keep_alive = false, .idle = None }
}

/// A new client's settings are fields a program may change before sending.
unittest "HttpClient::new: the defaults"
{
    HttpClient c = HttpClient::new();
    assert(c.timeout_ms == 30000 && c.max_redirects == 10 && !c.keep_alive);
    assert(Option::is_none(&c.roots));
    assert(Option::is_some(&find_header(&c.headers, "user-agent")));
    c.max_body = 1_048_576;
}

fn method_has_body(StringView m) : bool
{
    (m == "POST") || (m == "PUT") || (m == "PATCH")
}

// Opens a connection to `u`: TCP, then TLS for https, the system roots
// loaded into the client the first time they are needed.
fn open_connection(ref<HttpClient, exclusive> c, ref<Url, shared> u) : Result<Conn, HttpError>
{
    bool secure = (u.scheme == "https");
    if (!secure && u.scheme != "http")
    {
        return Err(UnsupportedScheme);
    }
    if (secure && Option::is_none(&c.roots))
    {
        match (TrustStore::system())
        {
            Ok(t)  : overwrite(&mut c.roots, Some(t)),
            Err(_) : return Err(NoRoots),
        }
    }
    // A bracketed IPv6 host loses its brackets for resolution.
    String host = String::clone(&u.host);
    if (StringView::starts_with(&host, "[") && StringView::ends_with(&host, "]"))
    {
        overwrite(&mut host, String::copy(&u.host[1..StringView::len(&u.host) - 1]));
    }
    Vec<SocketAddr> addrs = match (IpAddr::parse(&host))
    {
        Ok(ip) :
        {
            Vec<SocketAddr> one = Vec::new();
            Vec::push(&mut one, SocketAddr::new(ip, u.port));
            one
        },
        Err(_) : match (resolve(&host, u.port))
        {
            Ok(a)  : a,
            Err(e) : return Err(HttpNetFailure(e)),
        },
    };
    if (Vec::len(&addrs) == 0)
    {
        return Err(HttpNetFailure(UnknownHost));
    }
    NetError last = Failed;
    for (usize i = 0; i < Vec::len(&addrs); i += 1)
    {
        TcpStream tcp = match (TcpStream::connect_timeout(addrs[i], c.timeout_ms))
        {
            Ok(t)  : t,
            Err(e) :
            {
                last = e;
                continue;
            },
        };
        TcpStream::set_read_timeout_ms(&mut tcp, c.timeout_ms);
        TcpStream::set_write_timeout_ms(&mut tcp, c.timeout_ms);
        TcpStream::set_nodelay(&mut tcp, true);
        if (!secure)
        {
            return Ok(Plain(tcp));
        }
        ref<TrustStore, shared> roots = match (&c.roots)
        {
            Some(r) : r,
            None    : return Err(NoRoots),
        };
        return match (TlsStream::client(tcp, &host, roots))
        {
            Ok(s)  : Ok(Secure(s)),
            Err(e) : Err(HttpTlsFailure(e)),
        };
    }
    Err(HttpNetFailure(last))
}

// The headers that carry credentials: never sent after a redirect has left
// the request's origin (D-0232), as browsers and curl do.
// The fields `send` writes itself, from the URL, the body and the client's
// settings, so none taken from the headers can frame the message another
// way (report 299: a `Transfer-Encoding` beside the `Content-Length`).
fn is_framing(StringView name) : bool
{
    name_eq(name, "host") || name_eq(name, "content-length") || name_eq(name, "connection") || name_eq(name, "transfer-encoding")
}

fn is_credential(StringView name) : bool
{
    name_eq(name, "authorization") || name_eq(name, "proxy-authorization") || name_eq(name, "cookie")
}

// The request as bytes: the request line, the Host, the client's and the
// request's headers (the request's win), a Content-Length for a body,
// and Connection: close unless the client keeps connections alive.
fn request_bytes(
    ref<HttpClient, shared> c,
    ref<Request, shared> req,
    ref<Url, shared> u,
    StringView method,
    slice<u8, shared> body,
    bool with_content,
    bool credentials,
) : Result<Vec<u8>, HttpError>
{
    // The method is a token and every header a valid field, so nothing
    // taken from data can end a line of the request and start another
    // (the URL's parts are checked by `Url::parse`).
    if (!is_token(method))
    {
        return Err(BadMessage);
    }
    String head = String::copy(method);
    String::append(&mut head, " ");
    String::append(&mut head, &Url::target(u));
    String::append(&mut head, " HTTP/1.1\r\nHost: ");
    String::append(&mut head, &host_text(u));
    String::append(&mut head, "\r\n");
    foreach (h in &c.headers)
    {
        StringView name = &h.name;
        bool kept = (credentials || !is_credential(name)) && !is_framing(name);
        if (kept && !has_header(&req.headers, name))
        {
            write_field(&mut head, h)?;
        }
    }
    foreach (h in &req.headers)
    {
        if (is_framing(&h.name))
        {
            continue;
        }
        // After a redirect to another origin, no credentials go there.
        if (!credentials && is_credential(&h.name))
        {
            continue;
        }
        // After a redirect that dropped the body, its Content-Type goes too.
        if (!with_content && name_eq(&h.name, "content-type"))
        {
            continue;
        }
        write_field(&mut head, h)?;
    }
    if (slice_len(body) > 0 || method_has_body(method))
    {
        String::append(&mut head, "Content-Length: ");
        String::append(&mut head, slice_len(body));
        String::append(&mut head, "\r\n");
    }
    if (!c.keep_alive)
    {
        String::append(&mut head, "Connection: close\r\n");
    }
    String::append(&mut head, "\r\n");
    Vec<u8> out = String::into_bytes(head);
    Vec::extend_from(&mut out, body);
    Ok(out)
}

fn not_content_encoding(ref<Header, shared> h) : bool
{
    !name_eq(&h.name, "content-encoding") && !name_eq(&h.name, "content-length")
}

// The status line `HTTP/1.x NNN reason`.
struct StatusLine
{
    u16 status;
    String reason;
}

fn parse_status_line(StringView line) : Result<StatusLine, HttpError>
{
    if (!StringView::starts_with(line, "HTTP/1.") || StringView::len(line) < 12)
    {
        return Err(BadMessage);
    }
    // The version, the space, the three digits and the space are ASCII
    // (RFC 9112 §4): a byte of 128 or more among them is a malformed line,
    // not a place to cut a character in two (found by the hostile-input
    // round, D-0211).
    for (usize i = 0; i < 13 && i < StringView::len(line); i += 1)
    {
        if (line.bytes[i] >= 128)
        {
            return Err(BadMessage);
        }
    }
    u16 status = match (StringView::parse<u16>(&line[9..12]))
    {
        Ok(v)  : v,
        Err(_) : return Err(BadMessage),
    };
    if (status < 100 || status > 599)
    {
        return Err(BadMessage);
    }
    String reason = if (StringView::len(line) > 13)
    {
        String::copy(&line[13..$])
    }
    else { String::new() };
    Ok(StatusLine { .status = status, .reason = reason })
}

fn origin_of(ref<Url, shared> u) : String
{
    String o = String::clone(&u.scheme);
    String::append(&mut o, "://");
    String::append(&mut o, &host_text(u));
    o
}

// The methods whose effect is the same however often they are sent
// (RFC 9110 §9.2.2).
fn idempotent(StringView method) : bool
{
    method == "GET" || method == "HEAD" || method == "PUT" || method == "DELETE" || method == "OPTIONS" || method == "TRACE"
}

// The most interim (1xx) responses read past before a final one.
const usize MAX_INTERIM = 16;

// One exchange: on the kept connection to `u`'s origin if there is one
// (D-0195), again on a fresh one if that connection turns out closed
// before any of the response arrived and the method is idempotent; else on
// a fresh connection.
fn exchange(
    ref<HttpClient, exclusive> c,
    ref<Request, shared> req,
    ref<Url, shared> u,
    StringView method,
    slice<u8, shared> body,
    bool with_content,
    bool credentials,
) : Result<Response, HttpError>
{
    Vec<u8> bytes = request_bytes(c, req, u, method, body, with_content, credentials)?;
    String want = origin_of(u);
    if (Some(ic) = replace(&mut c.idle, None))
    {
        IdleConn { origin, r } = ic;
        if (origin == want)
        {
            if (Some(resp) = exchange_on(c, r, true, &bytes, u, method)?)
            {
                return Ok(resp);
            }
            // Closed with nothing answered: the server may still have
            // acted on the request, so only an idempotent one is sent
            // again (RFC 9110 §9.2.2) -- a POST twice could do twice what
            // it asks.
            if (!idempotent(method))
            {
                return Err(ConnectionClosed);
            }
        }
        else
        {
            conn_close(&mut r.conn);
        }
    }
    Reader fresh = Reader { .conn = open_connection(c, u)?, .buf = Vec::new(), .at = 0, .deadline_ns = 0 };
    match (exchange_on(c, fresh, false, &bytes, u, method)?)
    {
        Some(resp) : Ok(resp),
        None       : Err(ConnectionClosed),
    }
}

// The exchange on `r`. None when `r` was a kept connection (`reused`) that
// failed before any of the response arrived: the caller tries a fresh one.
fn exchange_on(
    ref<HttpClient, exclusive> c,
    Reader r,
    bool reused,
    slice<u8, shared> bytes,
    ref<Url, shared> u,
    StringView method,
) : Result<Option<Response>, HttpError>
{
    match (conn_write(&mut r.conn, bytes))
    {
        Ok(_)  : {},
        Err(e) :
        {
            if (reused)
            {
                return Ok(None);
            }
            return Err(e);
        },
    }
    bool first = true;
    // Interim 1xx responses (a 100 Continue) are read past, up to
    // MAX_INTERIM of them: a server sending them without end would hold
    // the request for ever, each one arriving within the read timeout.
    usize interim = 0;
    while (true)
    {
        String line = match (http_line(&mut r, MAX_HEAD))
        {
            Ok(Some(l)) : l,
            Ok(None)    :
            {
                if (reused && first)
                {
                    return Ok(None);
                }
                return Err(ConnectionClosed);
            },
            Err(e)      :
            {
                if (reused && first && Vec::len(&r.buf) == 0)
                {
                    return Ok(None);
                }
                return Err(e);
            },
        };
        first = false;
        bool http11 = StringView::starts_with(&line, "HTTP/1.1");
        StatusLine { status, reason } = parse_status_line(&line)?;
        Vec<Header> headers = read_headers(&mut r, StringView::len(&line) + 2)?;
        if (status >= 100 && status < 200)
        {
            interim += 1;
            if (interim > MAX_INTERIM)
            {
                return Err(BadMessage);
            }
            continue;
        }
        // RFC 9112 §6.1: an HTTP/1.0 message with `Transfer-Encoding` has
        // faulty framing.
        if (!http11 && count_header(&headers, "transfer-encoding") > 0)
        {
            return Err(BadMessage);
        }
        bool no_body = (method == "HEAD") || status == 204 || status == 304;
        BodyLength how = if (no_body) { NoBody } else { body_length(&headers, true)? };
        bool until_close = match (how)
        {
            UntilClose : true,
            _          : false,
        };
        Vec<u8> data = read_body(&mut r, how, c.max_body)?;
        // Kept when asked for, allowed (HTTP/1.1, no `Connection: close`),
        // the body's end known without the connection's, and nothing more
        // read than the response.
        bool keep = c.keep_alive && http11 && !until_close && r.at == Vec::len(&r.buf) && !connection_has(&headers, "close");
        if (keep)
        {
            c.idle = Some(IdleConn { .origin = String::clone(&origin_of(u)), .r = r });
        }
        else
        {
            conn_close(&mut r.conn);
        }
        // D-0183: a body sent compressed (`Content-Encoding: gzip` or
        // `deflate`, which the client offers) arrives decoded, within
        // `max_body`, and the header is dropped so the response reads as
        // a plain one.
        bool strip = false;
        if (!no_body)
        {
            if (Some(enc) = find_header(&headers, "content-encoding"))
            {
                StringView e = StringView::trim(enc);
                Option<Result<Vec<u8>, CompressError>> decoded = if (name_eq(e, "gzip") || name_eq(e, "x-gzip"))
                {
                    Some(gunzip(&data, c.max_body))
                }
                else if (name_eq(e, "deflate"))
                {
                    Some(match (zlib_inflate(&data, c.max_body))
                    {
                        Ok(v)  : Ok(v),
                        Err(_) : inflate(&data, c.max_body),
                    })
                }
                else { None };
                if (Some(d) = decoded)
                {
                    overwrite(&mut data, match (d)
                    {
                        Ok(v)         : v,
                        Err(Oversize) : return Err(TooLarge),
                        Err(_)        : return Err(BadMessage),
                    });
                    strip = true;
                }
            }
        }
        if (strip)
        {
            Vec::retain(&mut headers, not_content_encoding);
        }
        return Ok(Some(Response { .status = status, .reason = reason, .headers = headers, .body = data }));
    }
}

// Whether `t` starts with a scheme and its `:` (RFC 3986 §3.1: a letter,
// then letters, digits, `+`, `-` and `.`).
fn has_scheme(StringView t) : bool
{
    slice<u8, shared> b = StringView::as_bytes(t);
    if (slice_len(b) == 0 || !ascii_is_alpha(b[0]))
    {
        return false;
    }
    for (usize i = 1; i < slice_len(b); i += 1)
    {
        u8 c = b[i];
        if (c == b':')
        {
            return true;
        }
        if (!ascii_is_alnum(c) && c != b'+' && c != b'-' && c != b'.')
        {
            return false;
        }
    }
    false
}

// RFC 3986 §5.2.4: an absolute path with its `.` and `..` segments
// removed (a `..` above the root stays at the root).
fn remove_dot_segments(StringView path) : String
{
    Vec<StringView> out = Vec::new();
    Vec<StringView> segs = StringView::split(&path[1..$], "/");
    usize n = Vec::len(&segs);
    for (usize i = 0; i < n; i += 1)
    {
        StringView s = segs[i];
        bool last = i + 1 == n;
        if (s == ".")
        {
            if (last)
            {
                Vec::push(&mut out, "");
            }
        }
        else if (s == "..")
        {
            _ = Vec::pop(&mut out);
            if (last)
            {
                Vec::push(&mut out, "");
            }
        }
        else
        {
            Vec::push(&mut out, s);
        }
    }
    String r = String::new();
    foreach (s in &out)
    {
        String::push_ascii(&mut r, b'/');
        String::append(&mut r, *s);
    }
    if (StringView::len(&r) == 0)
    {
        String::push_ascii(&mut r, b'/');
    }
    r
}

// `location` (a URI reference, RFC 9110 §10.2.2) resolved against `base`
// as RFC 3986 §5.2 resolves one: with a scheme, it is absolute; `//` starts
// a network path on the base's scheme; `/` an absolute path; `?` a new
// query on the base's path; empty the base itself; anything else a path
// merged with the base path's directory. Dot segments are removed and
// the fragment is dropped.
fn redirect_target(ref<Url, shared> base, StringView location) : Result<Url, HttpError>
{
    StringView loc = location;
    if (Some(h) = StringView::find(loc, "#"))
    {
        loc = &loc[0..h];
    }
    if (has_scheme(loc))
    {
        return Url::parse(loc);
    }
    String text = String::clone(&base.scheme);
    String::append(&mut text, ":");
    if (StringView::starts_with(loc, "//"))
    {
        String::append(&mut text, loc);
        return Url::parse(&text);
    }
    String::append(&mut text, "//");
    String::append(&mut text, &host_text(base));
    StringView rel_path = loc;
    Option<StringView> rel_query = None;
    if (Some(q) = StringView::find(loc, "?"))
    {
        rel_path = &loc[0..q];
        rel_query = Some(&loc[q + 1..$]);
    }
    if (StringView::len(rel_path) == 0)
    {
        String::append(&mut text, &base.path);
        match (rel_query)
        {
            Some(q) :
            {
                String::append(&mut text, "?");
                String::append(&mut text, q);
            },
            None    :
            {
                if (StringView::len(&base.query) > 0)
                {
                    String::append(&mut text, "?");
                    String::append(&mut text, &base.query);
                }
            },
        }
        return Url::parse(&text);
    }
    String merged = String::new();
    if (StringView::starts_with(rel_path, "/"))
    {
        String::append(&mut merged, rel_path);
    }
    else
    {
        StringView path = &base.path;
        usize dir = 0;
        slice<u8, shared> pb = StringView::as_bytes(path);
        for (usize i = 0; i < slice_len(pb); i += 1)
        {
            if (pb[i] == b'/')
            {
                dir = i + 1;
            }
        }
        String::append(&mut merged, &path[0..dir]);
        String::append(&mut merged, rel_path);
    }
    String::append(&mut text, &remove_dot_segments(&merged));
    if (Some(q) = rel_query)
    {
        String::append(&mut text, "?");
        String::append(&mut text, q);
    }
    Url::parse(&text)
}

/// RFC 3986 §5.4's normal examples, on the base `http://a/b/c/d;p?q`, and a `://` inside a query.
unittest "redirect_target: reference resolution"
{
    Url base = Result::unwrap(Url::parse("http://a/b/c/d;p?q"));
    assert(Url::text(&Result::unwrap(redirect_target(&base, "g"))) == "http://a/b/c/g");
    assert(Url::text(&Result::unwrap(redirect_target(&base, "./g/"))) == "http://a/b/c/g/");
    assert(Url::text(&Result::unwrap(redirect_target(&base, "/g"))) == "http://a/g");
    assert(Url::text(&Result::unwrap(redirect_target(&base, "//g"))) == "http://g/");
    assert(Url::text(&Result::unwrap(redirect_target(&base, "?y"))) == "http://a/b/c/d;p?y");
    assert(Url::text(&Result::unwrap(redirect_target(&base, "g?y"))) == "http://a/b/c/g?y");
    assert(Url::text(&Result::unwrap(redirect_target(&base, "#s"))) == "http://a/b/c/d;p?q");
    assert(Url::text(&Result::unwrap(redirect_target(&base, ".."))) == "http://a/b/");
    assert(Url::text(&Result::unwrap(redirect_target(&base, "../../../g"))) == "http://a/g");
    assert(Url::text(&Result::unwrap(redirect_target(&base, "/./g/.."))) == "http://a/");
    assert(Url::text(&Result::unwrap(redirect_target(&base, "/login?next=http://e.com/"))) == "http://a/login?next=http://e.com/");
    assert(Url::text(&Result::unwrap(redirect_target(&base, "https://x:8443/y"))) == "https://x:8443/y");
}

// Sends `req`, following up to `max_redirects` redirects (301, 302 and
// 303 by GET without the body, 307 and 308 with the method and body
// kept), and gives the final response. With `keep_alive` (D-0195) a
// request to the origin of the last one reuses its connection.
/// Sends `req` and gives the final response, following redirects.
///
/// - `req.url` is absolute; a scheme other than `http` or `https` is `Err(UnsupportedScheme)`. The
///   host's addresses are tried in turn.
/// - The request carries `Host`, the client's headers and then the request's own (`Host`,
///   `Content-Length`, `Connection` and `Transfer-Encoding`, the client's or the request's, are ignored:
///   `send` frames the body itself), `Content-Length` when the body is not
///   empty or the method is POST, PUT or PATCH, and `Connection: close` unless `keep_alive` is set.
/// - A method that is not a token, or a header (the client's or the request's) whose name is not a token
///   or whose value holds a control byte other than the tab, is `Err(BadMessage)` before anything is
///   sent: a CR LF taken from data would otherwise end the line and inject headers or a second request.
/// - Interim responses (status 1xx) are read past, up to 16 of them; one more is `Err(BadMessage)`. A
///   body sent with `Content-Encoding: gzip` or `deflate` arrives decoded.
/// - A 301, 302 or 303 with a `Location` is followed by GET without the body (HEAD stays HEAD), a 307 or
///   308 with the method and body kept; a redirect without `Location` is given as it is. `Location` is a
///   URI reference resolved against the request's URL as RFC 3986 §5 resolves one (an absolute URL, `//`
///   and a host, an absolute path, `?` and a query, or a path relative to the current one, with `.` and
///   `..` segments removed); its fragment is dropped. With `max_redirects` 0 no redirect is followed and
///   the 3xx response is given; otherwise one redirect more than `max_redirects` is
///   `Err(TooManyRedirects)`. Once a redirect leaves the request's origin
///   (scheme, host and port), `Authorization`, `Proxy-Authorization` and `Cookie`, the client's and the
///   request's, are not sent again.
/// - On a kept connection that proves closed before any of the response arrives, an idempotent request
///   (GET, HEAD, PUT, DELETE, OPTIONS, TRACE) is sent again on a fresh connection; another is
///   `Err(ConnectionClosed)`, since the server may have acted on it.
/// - Network and TLS failures are `Err(HttpNetFailure(e))` and `Err(HttpTlsFailure(e))`; see `HttpError`
///   for the rest.
export fn HttpClient::send(ref<HttpClient, exclusive> c, ref<Request, shared> req) : Result<Response, HttpError>
{
    Url u = Url::parse(&req.url)?;
    String method = String::clone(&req.method);
    Vec<u8> body = Vec::clone(&req.body);
    usize hops = 0;
    bool with_content = true;
    String first_origin = origin_of(&u);
    bool credentials = true;
    while (true)
    {
        Response resp = exchange(c, req, &u, &method, &body, with_content, credentials)?;
        bool redirect = resp.status == 301 || resp.status == 302 || resp.status == 303 || resp.status == 307 || resp.status == 308;
        if (!redirect)
        {
            return Ok(resp);
        }
        // Report 310: a limit of 0 follows none, and the redirect is the
        // answer (a login's 302 and its cookie, a link checker's Location).
        if (c.max_redirects == 0)
        {
            return Ok(resp);
        }
        StringView location = match (Response::header(&resp, "location"))
        {
            Some(l) : l,
            None    : return Ok(resp),
        };
        if (hops == c.max_redirects)
        {
            return Err(TooManyRedirects);
        }
        hops += 1;
        Url next = redirect_target(&u, location)?;
        overwrite(&mut u, next);
        // Once a redirect leaves the first origin, credentials stay behind,
        // even if a later one comes back.
        if (origin_of(&u) != first_origin)
        {
            credentials = false;
        }
        if (resp.status != 307 && resp.status != 308 && method != "HEAD")
        {
            overwrite(&mut method, "GET");
            Vec::clear(&mut body);
            with_content = false;
        }
    }
}

// A GET of `url` with a fresh default client.
/// Sends a GET of `url` with a fresh `HttpClient::new()` and gives the response.
///
/// For https each call loads the system's roots again; a program that makes several requests keeps an
/// `HttpClient`.
export fn http_get(StringView url) : Result<Response, HttpError>
{
    HttpClient c = HttpClient::new();
    Request req = Request::new("GET", url);
    HttpClient::send(&mut c, &req)
}

// A POST of `body` as `content_type` to `url` with a fresh default client.
/// Sends a POST of `body` to `url`, with `Content-Type: content_type`, from a fresh default client.
///
/// As `http_get`, a program that makes several requests keeps an `HttpClient`.
export fn http_post(StringView url, StringView content_type, slice<u8, shared> body) : Result<Response, HttpError>
{
    HttpClient c = HttpClient::new();
    Request req = Request::new("POST", url);
    Vec::push(&mut req.headers, Header::new("Content-Type", content_type));
    Vec::extend_from(&mut req.body, body);
    HttpClient::send(&mut c, &req)
}
