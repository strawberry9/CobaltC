// `std::random` (spec/21 §0): `Rng`, and the operating system's secure
// random bytes (D-0142).

// D-0120: a reproducible pseudo-random sequence: xoshiro256** seeded
// through splitmix64, exactly as spec/21 `[Rng]` writes it. Not for
// cryptography.
/// A general-purpose pseudo-random generator: xoshiro256** seeded through splitmix64.
///
/// The same seed gives the same sequence in every implementation, so a run can be reproduced. Not suitable
/// for cryptographic purposes: its state is recoverable from its output, so it must not produce keys, tokens
/// or nonces; use `os_random_bytes` for those.
export struct Rng
{
    u64 s0;
    u64 s1;
    u64 s2;
    u64 s3;
}

fn Rng::rotl(u64 x, u32 k) : u64
{
    (x << k) | (x >> (64 - k))
}

fn Rng::splitmix(ref<u64, exclusive> state) : u64
{
    *state = wrapping_add(*state, 0x9E3779B97F4A7C15);
    u64 z = *state;
    z = wrapping_mul(z ^ (z >> 30), 0xBF58476D1CE4E5B9);
    z = wrapping_mul(z ^ (z >> 27), 0x94D049BB133111EB);
    z ^ (z >> 31)
}

/// A generator seeded from `seed`; equal seeds give equal sequences.
///
/// `Rng::from_os` seeds one unpredictably instead.
export fn Rng::new(u64 seed) : Rng
{
    u64 state = seed;
    u64 a = Rng::splitmix(&mut state);
    u64 b = Rng::splitmix(&mut state);
    u64 c = Rng::splitmix(&mut state);
    u64 d = Rng::splitmix(&mut state);
    Rng { .s0 = a, .s1 = b, .s2 = c, .s3 = d }
}

/// The next 64 pseudo-random bits from `r`.
export fn Rng::next_u64(ref<Rng, exclusive> r) : u64
{
    u64 result = wrapping_mul(Rng::rotl(wrapping_mul(r.s1, 5), 7), 9);
    u64 t = r.s1 << 17;
    r.s2 = r.s2 ^ r.s0;
    r.s3 = r.s3 ^ r.s1;
    r.s1 = r.s1 ^ r.s2;
    r.s0 = r.s0 ^ r.s3;
    r.s2 = r.s2 ^ t;
    r.s3 = Rng::rotl(r.s3, 45);
    result
}

// 0 .. n, each value equally likely: a draw in the top partial block of
// 2^64 is rejected and drawn again. `n` = 0 is `diag.div-by-zero`.
/// A pseudo-random number from 0 up to, not including, `n`, each value equally likely.
///
/// Unbiased: a draw that would favour some values is rejected and drawn again. Faults (`div_by_zero`) when
/// `n` is 0.
export fn Rng::below(ref<Rng, exclusive> r, u64 n) : u64
{
    u64 reject_under = wrapping_sub(0, n) % n;
    u64 x = Rng::next_u64(r);
    while (x < reject_under)
    {
        x = Rng::next_u64(r);
    }
    x % n
}

// 0.0 <= x < 1.0 from the top 53 bits of one draw.
/// A pseudo-random `f64` with `0.0 <= x < 1.0`, from the top 53 bits of one draw.
export fn Rng::unit_f64(ref<Rng, exclusive> r) : f64
{
    to_float<f64>(Rng::next_u64(r) >> 11) / 9007199254740992.0
}

/// Two generators with one seed agree; `below` and `unit_f64` stay in their ranges.
unittest "Rng: reproducible draws in range"
{
    Rng a = Rng::new(42);
    Rng b = Rng::new(42);
    assert(Rng::next_u64(&mut a) == Rng::next_u64(&mut b));
    for (usize i = 0; i < 100; i += 1)
    {
        assert(Rng::below(&mut a, 6) < 6);
        f64 x = Rng::unit_f64(&mut a);
        assert(x >= 0.0 && x < 1.0);
    }
}

// D-0142: bytes from the operating system's cryptographically secure
// source, for keys, tokens and nonces, and for seeding `Rng`; the bytes
// are unpredictable. `diag.entropy-unavailable` when the system has no
// such source (none of the systems either tool runs on lacks one).
// trusted: [Extern-Call] os_random writes n bytes of b's buffer, reserved just above, where no element object lies.
fn os_random_vec(usize n) : Vec<u8>
{
    Vec<u8> b = Vec::new();
    while (b.cap < n)
    {
        Vec::grow(&mut b);
    }
    if (n > 0)
    {
        isize r = unsafe
        {
            os_random(reinterpret_ptr<u8>(b.ptr), n)
        };
        if (r != 0)
        {
            fault(entropy_unavailable);
        }
    }
    b.len = n;
    b
}

// Fills `out` with secure random bytes.
/// Fills `out` with bytes from the operating system's cryptographically secure source.
///
/// Suitable for keys, tokens and nonces, and for seeding `Rng`. Faults (`entropy_unavailable`) when the
/// system has no such source.
export fn os_random_bytes(slice<u8, exclusive> out)
{
    Vec<u8> b = os_random_vec(slice_len(out));
    for (usize i = 0; i < slice_len(out); i += 1)
    {
        out[i] = b[i];
    }
}

// A secure random `u64`.
/// A `u64` from the operating system's cryptographically secure source.
///
/// Faults (`entropy_unavailable`) when the system has no such source.
export fn os_random_u64() : u64
{
    Vec<u8> b = os_random_vec(8);
    read_le<u64>(&b[0..$], 0)
}

// An `Rng` seeded from the operating system's secure source, so each run
// draws a different sequence. The sequence itself is still `Rng`'s: not
// for cryptography.
/// A generator seeded from the operating system's secure source, so each run draws a different sequence.
///
/// The sequence itself is still `Rng`'s, so it is still not for cryptographic purposes.
export fn Rng::from_os() : Rng
{
    Rng::new(os_random_u64())
}

// D-0181: the elements of `s` in a uniformly random order (Fisher-Yates:
// each position swapped with one drawn by `below` from itself and those
// before it), moved by `slice_swap`, so none is copied. The same seed
// gives the same order in every implementation.
/// Puts the elements of `s` in a uniformly random order drawn from `r`.
///
/// Fisher-Yates over `Rng::below`; elements are exchanged, never copied. The same seed gives the same order
/// in every implementation.
export fn Rng::shuffle<T>(ref<Rng, exclusive> r, slice<T, exclusive> s)
{
    usize n = slice_len(s);
    for (usize i = n; i > 1; i -= 1)
    {
        usize j = narrow<usize>(Rng::below(r, widen<u64>(i)));
        slice_swap(s, i - 1, j);
    }
}

/// Shuffling a whole `Vec` through a slice of it keeps every element.
unittest "Rng::shuffle: a Vec through its slice"
{
    Rng r = Rng::new(7);
    Vec<i32> v = Vec::new();
    for (i32 i = 1; i <= 5; i += 1)
    {
        Vec::push(&mut v, i);
    }
    Rng::shuffle(&mut r, &mut v[0..$]);
    assert(Vec::len(&v) == 5 && Vec::contains(&v, &3));
}

// D-0181: a version 4 UUID (RFC 9562 §5.4) from the operating system's
// secure source, as text: `xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx`,
// lowercase, `y` one of 8, 9, a, b. An identifier that no one else will
// draw.
/// A version 4 UUID (RFC 9562) from the operating system's secure source, as 36 lowercase characters.
///
/// The form is `xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx`, with `y` one of `8`, `9`, `a`, `b`. Faults
/// (`entropy_unavailable`) when the system has no secure source.
export fn uuid_v4() : String
{
    Vec<u8> b = os_random_vec(16);
    b[6] = (b[6] & 0x0F) | 0x40;
    b[8] = (b[8] & 0x3F) | 0x80;
    String hex = to_hex(&b[0..$]);
    String out = String::new();
    String::reserve(&mut out, 36);
    String::append(&mut out, String::view(&hex, 0, 8));
    String::append(&mut out, "-");
    String::append(&mut out, String::view(&hex, 8, 12));
    String::append(&mut out, "-");
    String::append(&mut out, String::view(&hex, 12, 16));
    String::append(&mut out, "-");
    String::append(&mut out, String::view(&hex, 16, 20));
    String::append(&mut out, "-");
    String::append(&mut out, String::view(&hex, 20, 32));
    out
}

/// The version digit `4` stands at position 14, after the second hyphen.
unittest "uuid_v4: the shape of the text"
{
    String id = uuid_v4();
    assert(String::len(&id) == 36);
    assert(StringView::eq_str(String::view(&id, 8, 9), "-"));
    assert(StringView::eq_str(String::view(&id, 14, 15), "4"));
}
