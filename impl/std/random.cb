// `std::random` (spec/21 §3d): `Rng`.

// D-0120: a reproducible pseudo-random sequence: xoshiro256** seeded
// through splitmix64, exactly as spec/21 `[Rng]` writes it. Not for
// cryptography.
export struct Rng
{
    u64 s0;
    u64 s1;
    u64 s2;
    u64 s3;
}

fn Rng::rotl(u64 x, u32 k) : u64
{
    (x << k) | (x >> (64 - k))
}

fn Rng::splitmix(ref<u64, exclusive> state) : u64
{
    *state = wrapping_add(*state, 0x9E3779B97F4A7C15);
    u64 z = *state;
    z = wrapping_mul(z ^ (z >> 30), 0xBF58476D1CE4E5B9);
    z = wrapping_mul(z ^ (z >> 27), 0x94D049BB133111EB);
    z ^ (z >> 31)
}

export fn Rng::new(u64 seed) : Rng
{
    u64 state = seed;
    u64 a = Rng::splitmix(&mut state);
    u64 b = Rng::splitmix(&mut state);
    u64 c = Rng::splitmix(&mut state);
    u64 d = Rng::splitmix(&mut state);
    Rng { .s0 = a, .s1 = b, .s2 = c, .s3 = d }
}

export fn Rng::next_u64(ref<Rng, exclusive> r) : u64
{
    u64 result = wrapping_mul(Rng::rotl(wrapping_mul(r.s1, 5), 7), 9);
    u64 t = r.s1 << 17;
    r.s2 = r.s2 ^ r.s0;
    r.s3 = r.s3 ^ r.s1;
    r.s1 = r.s1 ^ r.s2;
    r.s0 = r.s0 ^ r.s3;
    r.s2 = r.s2 ^ t;
    r.s3 = Rng::rotl(r.s3, 45);
    result
}

// 0 .. n, each value equally likely: a draw in the top partial block of
// 2^64 is rejected and drawn again. `n` = 0 is `diag.div-by-zero`.
export fn Rng::below(ref<Rng, exclusive> r, u64 n) : u64
{
    u64 reject_under = wrapping_sub(0, n) % n;
    u64 x = Rng::next_u64(r);
    while (x < reject_under)
    {
        x = Rng::next_u64(r);
    }
    x % n
}

// 0.0 <= x < 1.0 from the top 53 bits of one draw.
export fn Rng::unit_f64(ref<Rng, exclusive> r) : f64
{
    to_float<f64>(Rng::next_u64(r) >> 11) / 9007199254740992.0
}
