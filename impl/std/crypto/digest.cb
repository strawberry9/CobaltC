// D-0119: CRC-32/IEEE (polynomial 0x04C11DB7, reflected 0xEDB88320,
// initial value and final xor 0xFFFFFFFF, input and output reflected):
// the checksum of zlib, PNG, gzip and Ethernet; crc32("123456789") is
// 0xCBF43926. Eight bytes at a time by tables (`CRC32_T`), the same value
// as spec/21 `[CRC32]`'s bit-by-bit definition. Here beside the
// hashes (D-0177), but not cryptographic: it detects accidental corruption,
// and anyone can make data with a chosen CRC.
/// The CRC-32 checksum of `data`, as zlib, PNG, gzip and Ethernet compute it.
///
/// CRC-32/IEEE: polynomial 0x04C11DB7 (reflected 0xEDB88320), initial value and final exclusive or
/// 0xFFFFFFFF, input and output reflected; computed eight bytes at a time from tables.
///
/// It is not cryptographic: it detects accidental corruption, and anyone can make data with any CRC they
/// choose. To detect tampering, use a hash or a MAC.
export fn crc32(slice<u8, shared> data) : u32
{
    u32 crc = 0xFFFFFFFF;
    usize n = slice_len(data);
    usize i = 0;
    // Eight bytes a step (report 147: bit by bit ran at an eighth of zlib's speed).
    while (n - i >= 8)
    {
        u32 word = widen<u32>(data[i]) | (widen<u32>(data[i + 1]) << 8) | (widen<u32>(data[i + 2]) << 16) | (widen<u32>(data[i + 3]) << 24);
        u32 lo = crc ^ word;
        u32 a = CRC32_T[1792 + widen<usize>(lo & 0xFF)] ^ CRC32_T[1536 + widen<usize>((lo >> 8) & 0xFF)];
        u32 b = CRC32_T[1280 + widen<usize>((lo >> 16) & 0xFF)] ^ CRC32_T[1024 + widen<usize>(lo >> 24)];
        u32 c = CRC32_T[768 + widen<usize>(data[i + 4])] ^ CRC32_T[512 + widen<usize>(data[i + 5])];
        u32 d = CRC32_T[256 + widen<usize>(data[i + 6])] ^ CRC32_T[widen<usize>(data[i + 7])];
        crc = a ^ b ^ c ^ d;
        i += 8;
    }
    while (i < n)
    {
        crc = (crc >> 8) ^ CRC32_T[widen<usize>((crc ^ widen<u32>(data[i])) & 0xFF)];
        i += 1;
    }
    crc ^ 0xFFFFFFFF
}

/// The checksum of `123456789` is CRC-32's published check value.
unittest "crc32: the check value"
{
    assert(crc32(b"123456789") == 0xCBF43926);
}

// Whether two digests (or MACs) are the same bytes, in a time that depends
// only on their lengths: every byte is compared, however early they
// differ, so a sender guessing a MAC learns nothing from how long the
// check took. Use this, never `==`, to check a MAC that arrived.
/// Whether `a` and `b` have the same length and the same bytes, in a time that depends on the lengths alone.
///
/// Every byte is compared, however early they differ, so a sender guessing a MAC learns nothing from how long
/// the check took. A program that checks a MAC or a digest it received compares with this, never `==`. Slices
/// of different lengths are `false`.
export fn digest_eq(slice<u8, shared> a, slice<u8, shared> b) : bool
{
    if (slice_len(a) != slice_len(b))
    {
        return false;
    }
    u8 acc = 0;
    for (usize i = 0; i < slice_len(a); i += 1)
    {
        acc = acc | (a[i] ^ b[i]);
    }
    acc == 0
}

/// Equal bytes of different lengths are not equal.
unittest "digest_eq: the lengths must match too"
{
    array<u8, 3> a = [1, 2, 3];
    array<u8, 4> b = [1, 2, 3, 0];
    assert(digest_eq(&a, &b[0..3]));
    assert(!digest_eq(&a, &b));
}
