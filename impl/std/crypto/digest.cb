// `std::crypto::digest` (spec/21 §2m, D-0187): the digests. SHA-256 (FIPS
// 180-4, D-0151), SHA-384 and SHA-512 (D-0157), SHA-1 (D-0181, legacy),
// BLAKE2b (D-0170), `HashKind` and `Hasher` for a hash chosen at run time
// (D-0166), `digest_eq`, which compares digests in the same time whatever
// they hold, and `crc32` (D-0119, D-0177), a checksum that is not
// cryptographic. Written in CobaltC.

const array<u32, 64> SHA256_K = [
    0x428a2f98,
    0x71374491,
    0xb5c0fbcf,
    0xe9b5dba5,
