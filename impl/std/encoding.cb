// `std::encoding` (spec/21 §0, §2d, §2r, D-0197, D-0198): data formats
// and encodings of bytes as text, one submodule each, each re-exported
// here: `json` (`Json`, `JsonMember`), a value model read from text and
// written back; `hex` (`to_hex`, `from_hex`) and `base64`
// (`base64_encode`, `base64_decode`), bytes as text and back. Compression
// is `std::compress`.

export module json "encoding/json.cb";
export module hex "encoding/hex.cb";
export module base64 "encoding/base64.cb";

export import std::encoding::json;
export import std::encoding::hex;
export import std::encoding::base64;
