// `std::encoding::base64` (spec/21 §2g, D-0151, D-0198): bytes as base64
// text (RFC 4648 §4) and back. Errors are `std::text`'s `ParseError`.

// The bytes in base64 (RFC 4648 §4: `A`-`Z`, `a`-`z`, `0`-`9`, `+`, `/`,
// padded with `=` to a multiple of four characters).
/// The bytes in base64 (RFC 4648 §4), padded with `=` to a multiple of four characters.
///
/// The alphabet is the standard one: `A`-`Z`, `a`-`z`, `0`-`9`, `+` and `/`.
export fn base64_encode(slice<u8, shared> bytes) : String
{
    str alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    Vec<u8> out = Vec::new();
    usize n = slice_len(bytes);
    Vec::reserve(&mut out, (n + 2) / 3 * 4);
    usize i = 0;
    while (i + 3 <= n)
    {
        u32 v = (widen<u32>(bytes[i]) << 16) | (widen<u32>(bytes[i + 1]) << 8) | widen<u32>(bytes[i + 2]);
        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 18) & 63)));
        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 12) & 63)));
        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 6) & 63)));
        Vec::push(&mut out, str_byte(alphabet, narrow<usize>(v & 63)));
        i += 3;
    }
    if (n - i == 1)
    {
        u32 v = widen<u32>(bytes[i]) << 16;
        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 18) & 63)));
        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 12) & 63)));
        Vec::push(&mut out, b'=');
        Vec::push(&mut out, b'=');
    }
    else if (n - i == 2)
    {
        u32 v = (widen<u32>(bytes[i]) << 16) | (widen<u32>(bytes[i + 1]) << 8);
        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 18) & 63)));
        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 12) & 63)));
        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 6) & 63)));
        Vec::push(&mut out, b'=');
    }
    String { .bytes = out }
}

// The value of a base64 character; 255 for any other byte (`=` included).
fn base64_value(u8 b) : u8
{
    if (b >= b'A' && b <= b'Z')
    {
        return b - b'A';
    }
    if (b >= b'a' && b <= b'z')
    {
        return b - b'a' + 26;
    }
    if (b >= b'0' && b <= b'9')
    {
        return b - b'0' + 52;
    }
    if (b == b'+')
    {
        return 62;
    }
    if (b == b'/')
    {
        return 63;
    }
    255
}

// Reads base64 as `base64_encode` writes it, padding required: `Ok` of the
// empty vector for "", `Err(Invalid(i))` at the first byte that is not a
// base64 character (a `=` before the final one or two is one), or at the
// last character before the padding when it leaves bits that are not
// zero, or at the length when it is not a multiple of four.
/// The bytes the base64 `text` spells, read as `base64_encode` writes it.
///
/// Padding is required. Empty text gives no bytes.
///
/// - `Err(Invalid(len))` when the length is not a multiple of four.
/// - `Err(Invalid(i))` at the first byte that is not a base64 character; a `=` before the final one or two is
///   such a byte.
/// - `Err(Invalid(i))` at the last character before the padding when it leaves bits over that are not
///   zero: `"QR=="` is refused, since `base64_encode` writes `"A"` as `"QQ=="`. Each byte string has one
///   text.
export fn base64_decode(StringView text) : Result<Vec<u8>, ParseError>
{
    base64_decode_bytes(text.bytes)
}

/// Padding is part of the text: a `=` inside it is an error, and so are bits it leaves over that are not zero.
unittest "base64_decode: padding"
{
    StringView text = "hi!?";
    String e = base64_encode(StringView::as_bytes(text));
    assert(e == "aGkhPw==");
    Vec<u8> d = Result::unwrap(base64_decode(String::as_view(&e)));
    assert(Vec::len(&d) == 4);
    match (base64_decode("aG=hPw=="))
    {
        Err(Invalid(i)) : assert(i == 2),
        _               : assert(false),
    }
    match (base64_decode("QR=="))
    {
        Err(Invalid(i)) : assert(i == 1),
        _               : assert(false),
    }
}

// `base64_decode` on the bytes (as `hex_decode`).
fn base64_decode_bytes(slice<u8, shared> b) : Result<Vec<u8>, ParseError>
{
    usize n = slice_len(b);
    Vec<u8> out = Vec::new();
    if (n == 0)
    {
        return Ok(Vec::new());
    }
    if (n % 4 != 0)
    {
        return Err(Invalid(n));
    }
    usize pad = 0;
    if (b[n - 1] == b'=')
    {
        pad = 1;
        if (b[n - 2] == b'=')
        {
            pad = 2;
        }
    }
    Vec::reserve(&mut out, n / 4 * 3);
    for (usize i = 0; i < n; i += 4)
    {
        u32 v = 0;
        for (usize j = 0; j < 4; j += 1)
        {
            u8 c = b[i + j];
            if (c == b'=' && i + j >= n - pad)
            {
                v = v << 6;
            }
            else
            {
                u8 d = base64_value(c);
                if (d == 255)
                {
                    return Err(Invalid(i + j));
                }
                v = (v << 6) | widen<u32>(d);
            }
        }
        // D-0232: the bits padding leaves over are zero, as `base64_encode`
        // writes them (RFC 4648 §3.5): one text for each byte string.
        if (i + 4 == n && ((pad == 1 && (v & 0xff) != 0) || (pad == 2 && (v & 0xffff) != 0)))
        {
            return Err(Invalid(n - 1 - pad));
        }
        Vec::push(&mut out, narrow_wrapping<u8>(v >> 16));
        if (i + 4 < n || pad < 2)
        {
            Vec::push(&mut out, narrow_wrapping<u8>(v >> 8));
        }
        if (i + 4 < n || pad < 1)
        {
            Vec::push(&mut out, narrow_wrapping<u8>(v));
        }
    }
    Ok(out)
}
