// `std::fs` (spec/21 §2e, §2e′, D-0176): files and the file system. Reading
// and writing whole files (`read_file`, `write_file`, `read_bytes`,
// `write_bytes`), open files (`File`), the one error of input and output
// (`FileError`, D-0134), directories, paths and file metadata. Moved here
// from `std::io` and `std::sys` (D-0176); `import std;` sees every item by
// its short name as before.

// D-0134: the one error of input and output, for files and for standard
// input alike.
/// The error of every input and output operation of `std`, for files and standard input alike.
///
/// - `NotFound`: no such file, or a directory on the path does not exist.
/// - `Denied`: the environment refuses the operation.
/// - `Io`: any other failure (the path names a directory, a device error, …).
/// - `Utf8(e)`: the bytes read are not UTF-8; `e` gives the offset of the first byte that is not.
export enum FileError
{
    NotFound,
    Denied,
    Io,
    Utf8(Utf8Error),
}

// D-0033 (6): the value, or `d` when there is none; an unused `d` (or
// `Err` payload) is destroyed like any other.
// D-0117: each std error as a sentence for a person, a `str` (the
// offsets inside `Utf8Error` and `ParseError::Invalid` stay reachable by
// `match`).
/// The error as a short phrase for a person (`not found`, `permission denied`).
export fn FileError::text(ref<FileError, shared> e) : str
{
    match (e)
    {
        NotFound : "not found",
        Denied   : "permission denied",
        Io       : "input/output error",
        Utf8(_)  : "not UTF-8",
    }
}

/// The text is a phrase to print after a path or a message.
unittest "FileError::text: a phrase to print"
{
    FileError e = FileError::NotFound;
    assert(FileError::text(&e) == "not found");
}

// trusted: [Extern-Call] file_read into [buf, cap), an allocation of this function; [Rawptr-Read] of the n <= cap bytes it filled; [Deallocate] of that allocation, once on each path.
/// The whole contents of the file at `path`, as text.
///
/// A relative path is resolved against the working directory. `Err(Utf8(e))` when the bytes are not UTF-8,
/// `e` giving the offset of the first that is not; `Err(NotFound)` when no such file exists; `Err(Denied)`
/// when the environment refuses; `Err(Io)` for any other failure (a directory, a device error). Use
/// `read_bytes` for bytes that need not be text, and `File` for a file too large to hold.
export fn read_file(StringView path) : Result<String, FileError>
{
    rawptr<u8> p = StringView::ptr(path);
    usize pn = StringView::len(path);
    usize cap = 4096;
    while (true)
    {
        rawptr<u8> buf = match (allocate(cap, 1))
        {
            Ok(b)  : b,
            Err(_) : fault(alloc_failure),
        };
        isize n = unsafe
        {
            file_read(p, pn, buf, cap)
        };
        if (n >= 0 && reinterpret<usize>(n) <= cap)
        {
            usize len = reinterpret<usize>(n);
            Vec<u8> bytes = Vec::new();
            usize i = 0;
            while (i < len)
            {
                u8 b = unsafe
                {
                    *(buf + reinterpret<isize>(i))
                };
                Vec::push(&mut bytes, b);
                i = i + 1;
            }
            unsafe
            {
                deallocate(buf, cap, 1);
            }
            return match (String::from_utf8(bytes))
            {
                Ok(s)  : Ok(s),
                Err(e) : Err(FileError::Utf8(e)),
            };
        }
        unsafe
        {
            deallocate(buf, cap, 1);
        }
        if (n < 0)
        {
            return Err(file_error(n));
        }
        // Longer than `cap`: again, with room for all of it.
        cap = reinterpret<usize>(n);
    }
}

// trusted: [Extern-Call] file_write reads the path's and the text's bytes, which the views keep live for the call.
/// Makes the file at `path` hold exactly `text`, creating it or replacing its contents.
///
/// `Err(NotFound)` when a directory on the path does not exist; `Err(Denied)` when the environment refuses
/// the write; `Err(Io)` for any other failure.
export fn write_file(StringView path, StringView text) : Result<void, FileError>
{
    isize r = unsafe
    {
        file_write(StringView::ptr(path), StringView::len(path), StringView::ptr(text), StringView::len(text))
    };
    if (r < 0)
    {
        return Err(file_error(r));
    }
    Ok(())
}

// An open file (`rule.stdlib.file-handle`, spec/21 §2e, D-0054): its
// bytes read and written in order from a position, which `seek` moves.
// Its destructor closes it; `close` closes it and reports a failure.
/// An open file, read and written in order from a position that `seek` moves.
///
/// Every `File` comes from `File::open`, `create`, `append`, `open_rw` or `create_new`. Positions are `u64`,
/// so a file larger than the address space is still addressed. Reading and writing are buffered; the bytes
/// written reach the file no later than the next operation on it, any other file-system operation of the
/// program, the start of a child process, or the program's end.
///
/// Destroying a `File` closes it without making it durable and without reporting a failure; a program
/// that must know its bytes were stored calls `File::close`.
export resource struct File
{
    usize id;
    bool open;                          // false once close has closed it
}

// `file_error` for `file_at`'s codes.
fn file_error_at(i64 code) : FileError
{
    if (code == -1)
    {
        return FileError::NotFound;
    }
    if (code == -2)
    {
        return FileError::Denied;
    }
    FileError::Io
}

// trusted: [Extern-Call] file_op(open) reads the path's bytes, which the view keeps live.
fn File::start(StringView path, usize mode) : Result<File, FileError>
{
    isize r = unsafe
    {
        file_op(0, mode, StringView::ptr(path), StringView::len(path))
    };
    if (r < 0)
    {
        return Err(file_error(r));
    }
    Ok(File { .id = reinterpret<usize>(r), .open = true })
}

// For reading; the file must exist.
/// Opens the existing file at `path` for reading, at position 0.
///
/// `Err(NotFound)` when there is no such file; `Err(Denied)` when the environment refuses; `Err(Io)` for
/// any other failure (the path names a directory).
export fn File::open(StringView path) : Result<File, FileError>
{
    File::start(path, 0)
}

// For writing, from empty: created, or its contents discarded.
/// Opens the file at `path` for writing from empty, creating it or discarding its contents.
///
/// `Err(NotFound)` when a directory on the path does not exist; `Err(Denied)`, `Err(Io)` as `File::open`'s.
/// Use `File::create_new` when an existing file must not be overwritten.
export fn File::create(StringView path) : Result<File, FileError>
{
    File::start(path, 1)
}

// For writing at its end, created if it does not exist.
/// Opens the file at `path` for writing at its end, creating it if it does not exist.
///
/// Every write lands at the end of the file.
export fn File::append(StringView path) : Result<File, FileError>
{
    File::start(path, 2)
}

// For reading and writing, created if it does not exist, its contents kept.
/// Opens the file at `path` for reading and writing, creating it if it does not exist, its contents kept.
///
/// The position starts at 0; a write lands at the position reading has reached.
export fn File::open_rw(StringView path) : Result<File, FileError>
{
    File::start(path, 3)
}

// Appends exactly `want` bytes of what `file_op` reads, or fewer at the end.
// trusted: [Extern-Call] file_op(read) writes buf's spare capacity [len, len + want), reserved by the caller, where no element object lies.
fn File::take(ref<File, exclusive> f, ref<Vec<u8>, exclusive> buf, usize want) : Result<usize, FileError>
{
    while (buf.cap - buf.len < want)
    {
        Vec::grow(buf);
    }
    isize r = unsafe
    {
        file_op(3, f.id, reinterpret_ptr<u8>(buf.ptr + reinterpret<isize>(buf.len)), want)
    };
    if (r < 0)
    {
        return Err(file_error(r));
    }
    usize n = reinterpret<usize>(r);
    buf.len = buf.len + n;
    Ok(n)
}

// Appends up to `max` bytes to `buf` (at most a MiB, and fewer only at the
// end) and returns how many: 0 only at the end, when max > 0.
/// Appends up to `max` bytes from the file's position to the end of `buf` and returns how many.
///
/// At most a MiB is read at a time, whatever `max` is; fewer bytes come only at the end of the file, and
/// `Ok(0)` (for a `max` above 0) means the end. `Err(Io)` on a file opened only for writing.
export fn File::read(ref<File, exclusive> f, ref<Vec<u8>, exclusive> buf, usize max) : Result<usize, FileError>
{
    usize want = if (max > 1_048_576)
    {
        1_048_576
    }
    else
    {
        max
    };
    File::take(f, buf, want)
}

// Appends the rest of the file to `buf` and returns how many bytes.
/// Appends the rest of the file, from its position, to the end of `buf` and returns how many bytes.
export fn File::read_to_end(ref<File, exclusive> f, ref<Vec<u8>, exclusive> buf) : Result<usize, FileError>
{
    usize total = 0;
    while (true)
    {
        usize n = match (File::read(f, buf, 65_536))
        {
            Ok(n)  : n,
            Err(e) : return Err(e),
        };
        if (n == 0)
        {
            break;
        }
        total = total + n;
    }
    Ok(total)
}

// The next line without its '\n', nor a '\r' just before it (D-0092),
// as `read_line` reads standard input; None at the end of the file.
// trusted: [Extern-Call] file_op with no buffer: it touches no program storage.
/// The next line of the file, without its final `'\n'` or one `'\r'` just before it.
///
/// `Ok(None)` at the end of the file. A last line with no `'\n'` is still a line. `Err(Utf8(e))` when the
/// line is not UTF-8, `e`'s offset counted from the line's start; `Err(Io)` on a file opened only for
/// writing. Lines end as `read_line` on standard input ends them.
export fn File::read_line(ref<File, exclusive> f) : Result<Option<String>, FileError>
{
    isize r = unsafe
    {
        file_op(4, f.id, dangling<u8>(), 0)
    };
    if (r < 0)
    {
        return Err(file_error(r));
    }
    if (r == 0)
    {
        return Ok(None);
    }
    Vec<u8> bytes = Vec::new();
    usize n = match (File::take(f, &mut bytes, reinterpret<usize>(r)))
    {
        Ok(n)  : n,
        Err(e) : return Err(e),
    };
    if (n > 0 && bytes[n - 1] == 10)
    {
        Vec::pop(&mut bytes);
        if (n > 1 && bytes[n - 2] == 13)
        {
            Vec::pop(&mut bytes);
        }
    }
    match (String::from_utf8(bytes))
    {
        Ok(s)  : Ok(Some(s)),
        Err(e) : Err(FileError::Utf8(e)),
    }
}

// Writes all of `data` at the file's position (at its end, for append).
// trusted: [Extern-Call] file_op(write) reads the n bytes the slice covers and keeps live.
/// Writes all of `data` at the file's position, or at its end for a file opened by `File::append`.
///
/// The file grows as needed and the position moves past the bytes written. Writes are buffered (see `File`);
/// a failure the environment reports late is reported by the file's next operation. `Err(Io)` on a file
/// opened only for reading.
export fn File::write(ref<File, exclusive> f, slice<u8, shared> data) : Result<void, FileError>
{
    usize n = slice_len(data);
    if (n == 0)
    {
        return Ok(());
    }
    isize r = unsafe
    {
        file_op(5, f.id, rawptr_of(&data[0]), n)
    };
    if (r < 0)
    {
        return Err(file_error(r));
    }
    Ok(())
}

// D-0134: writes the text at the file's position.
/// Writes the bytes of `text` at the file's position, as `File::write` does.
export fn File::write_text(ref<File, exclusive> f, StringView text) : Result<void, FileError>
{
    File::write(f, text.bytes)
}

// `File::printf(f, format, …)` (D-0059) is `File::write_formatted(f,
// $fmt(format, …))` after `modres`, as `String::appendf` is
// `String::append` of it.
// trusted: [Extern-Call] file_op(write) reads the str's n bytes, program data.
fn File::write_formatted(ref<File, exclusive> f, str text) : Result<void, FileError>
{
    usize n = str_len(text);
    if (n == 0)
    {
        return Ok(());
    }
    isize r = unsafe
    {
        file_op(5, f.id, str_ptr(text), n)
    };
    if (r < 0)
    {
        return Err(file_error(r));
    }
    Ok(())
}

// Moves the position to byte `pos` from the start.
// trusted: [Extern-Call] file_at with no buffer: it touches no program storage.
/// Moves the file's position to byte `pos` from the start.
///
/// A position beyond the end is allowed: reading there gives 0 bytes, and writing there extends the file.
export fn File::seek(ref<File, exclusive> f, u64 pos) : Result<void, FileError>
{
    i64 r = unsafe
    {
        file_at(6, f.id, pos)
    };
    if (r < 0)
    {
        return Err(file_error_at(r));
    }
    Ok(())
}

// The file's length in bytes.
// trusted: [Extern-Call] file_at with no buffer: it touches no program storage.
/// The file's length in bytes.
export fn File::len(ref<File, shared> f) : Result<u64, FileError>
{
    i64 r = unsafe
    {
        file_at(7, f.id, 0)
    };
    if (r < 0)
    {
        return Err(file_error_at(r));
    }
    Ok(reinterpret<u64>(r))
}

// D-0181: for writing, created only if nothing is there: `Ok(None)` when
// a file (or a directory) of that name already exists, so two programs
// that race to make the same file see one win. A lock file, a pid file,
// a file that must never be overwritten.
// trusted: [Extern-Call] file_op(open) reads the path's bytes, which the view keeps live.
/// Opens a new file at `path` for writing, only if nothing is there yet.
///
/// `Ok(None)` when a file or a directory of that name already exists, and nothing is changed, so of two
/// programs that race to make the same file exactly one wins: a lock file, a pid file, a file that must
/// never be overwritten. `Err(NotFound)` when a directory above `path` does not exist; other errors as
/// `File::create`'s.
export fn File::create_new(StringView path) : Result<Option<File>, FileError>
{
    isize r = unsafe
    {
        file_op(0, 4, StringView::ptr(path), StringView::len(path))
    };
    if (r == -4)
    {
        return Ok(None);
    }
    if (r < 0)
    {
        return Err(file_error(r));
    }
    Ok(Some(File { .id = reinterpret<usize>(r), .open = true }))
}

// D-0181: everything written so far made durable: handed to the
// operating system and by it to the device, so it survives a crash or a
// power loss from here on. The write-then-rename pattern flushes before
// the rename.
// trusted: [Extern-Call] file_op with no buffer: it touches no program storage.
/// Makes everything written to the file so far durable.
///
/// The bytes are handed to the operating system and by it to the device, and from then on survive a crash
/// or a power loss; the write-then-rename pattern flushes before the rename. `Err(Io)` on a file open only
/// for reading, or when the device fails.
export fn File::flush(ref<File, exclusive> f) : Result<void, FileError>
{
    isize r = unsafe
    {
        file_op(8, f.id, dangling<u8>(), 0)
    };
    if (r < 0)
    {
        return Err(file_error(r));
    }
    Ok(())
}

// D-0181: the position the next read or write starts at, in bytes from
// the start.
// trusted: [Extern-Call] file_at with no buffer: it touches no program storage.
/// The byte the next read or write starts at, counted from the start of the file.
///
/// It is 0 when the file is opened (for `File::append`, the length once something is written) and is moved
/// by every read, `read_line`, write and `seek`.
export fn File::position(ref<File, shared> f) : Result<u64, FileError>
{
    i64 r = unsafe
    {
        file_at(9, f.id, 0)
    };
    if (r < 0)
    {
        return Err(file_error_at(r));
    }
    Ok(reinterpret<u64>(r))
}

// Closes the file. A file open for writing is first made durable, so a
// failure the environment reports late is reported here.
// trusted: [Extern-Call] file_op with no buffer: it touches no program storage.
/// Closes the file, first making a file open for writing durable, and reports any failure.
///
/// `Err(e)` when the environment reports a failure, including one for bytes written earlier; the file is
/// closed all the same. Destroying a `File` closes it too, but reports nothing.
export fn File::close(File f) : Result<void, FileError>
{
    f.open = false;
    isize r = unsafe
    {
        file_op(1, f.id, dangling<u8>(), 0)
    };
    if (r < 0)
    {
        return Err(file_error(r));
    }
    Ok(())
}

// trusted: [Extern-Call] file_op with no buffer: it touches no program storage.
/// Closes an open file when its `File` is destroyed, without making it durable or reporting a failure.
///
/// The destructor; programs do not call it, and call `File::close` to learn whether the bytes were stored.
export fn File::drop(ref<File, exclusive> self)
{
    if (self.open)
    {
        isize r = unsafe
        {
            file_op(2, self.id, dangling<u8>(), 0)
        };
    }
}

// The whole file's bytes, as `read_file` reads its text.
/// The whole contents of the file at `path`, as bytes.
///
/// The errors are `File::open`'s and `File::read_to_end`'s. Use `read_file` for text.
export fn read_bytes(StringView path) : Result<Vec<u8>, FileError>
{
    File f = match (File::open(path))
    {
        Ok(f)  : f,
        Err(e) : return Err(e),
    };
    Vec<u8> bytes = Vec::new();
    match (File::read_to_end(&mut f, &mut bytes))
    {
        Ok(_)  : Ok(bytes),
        Err(e) : Err(e),
    }
}

// Makes the file hold exactly `data`, as `write_file` does its text.
/// Makes the file at `path` hold exactly `data`, creating it or replacing its contents.
///
/// The errors are `File::create`'s and `File::write`'s. Use `write_file` for text.
export fn write_bytes(StringView path, slice<u8, shared> data) : Result<void, FileError>
{
    File f = match (File::create(path))
    {
        Ok(f)  : f,
        Err(e) : return Err(e),
    };
    File::write(&mut f, data)
}

// What a path names (`rule.stdlib.fs`, D-0061): a file and its length in
// bytes, a directory, or something else (a device, a socket, …).
/// What a path names, as `path_kind` and `file_info` report it.
///
/// - `File(n)`: a file of `n` bytes.
/// - `Dir`: a directory.
/// - `Other`: something else, such as a device or a socket.
export enum PathKind
{
    File(u64),
    Dir,
    Other,
}

// trusted: [Extern-Call] fs_op reads the two views' bytes, which the views keep live.
fn fs_path_op(usize op, StringView a, StringView b) : isize
{
    unsafe
    {
        fs_op(op, StringView::ptr(a), StringView::len(a), StringView::ptr(b), StringView::len(b))
    }
}

// Makes a directory: Ok(true) when it was made, Ok(false) when a
// directory was already there (so it is safe to call again).
/// Makes the directory `path`, whose parent must exist.
///
/// `Ok(true)` when it was made; `Ok(false)` when a directory was already there, so it is safe to call
/// again. `Err(NotFound)` when the parent does not exist; `Err(Io)` when something that is not a directory
/// is at `path`. Use `make_dir_all` to make the missing parents too.
export fn make_dir(StringView path) : Result<bool, FileError>
{
    isize r = fs_path_op(0, path, "");
    if (r < 0)
    {
        return Err(file_error(r));
    }
    Ok(r == 1)
}

/// Removes the file at `path`.
///
/// `Err(NotFound)` when there is none.
export fn remove_file(StringView path) : Result<void, FileError>
{
    isize r = fs_path_op(1, path, "");
    if (r < 0)
    {
        return Err(file_error(r));
    }
    Ok(())
}

// Removes an empty directory.
/// Removes the empty directory at `path`.
///
/// `Err(Io)` when it is not empty; `Err(NotFound)` when there is none. Use `remove_dir_all` to remove a
/// directory and everything in it.
export fn remove_dir(StringView path) : Result<void, FileError>
{
    isize r = fs_path_op(2, path, "");
    if (r < 0)
    {
        return Err(file_error(r));
    }
    Ok(())
}

// Renames (moves) `from` to `to`, replacing a file at `to`.
/// Renames (moves) what is at `from` to `to`, replacing a file at `to`.
export fn rename(StringView from, StringView to) : Result<void, FileError>
{
    isize r = fs_path_op(3, from, to);
    if (r < 0)
    {
        return Err(file_error(r));
    }
    Ok(())
}

// The names in a directory (not `.` or `..`), sorted by their bytes.
/// The names of the entries of the directory `path`, sorted by their bytes.
///
/// The names are entry names, not paths (join them to `path` with `path_join`), and never `.` or `..`.
/// `Err(Utf8(e))` for a name that is not UTF-8.
export fn list_dir(StringView path) : Result<Vec<String>, FileError>
{
    Vec<u8> all = match (fs_answer(0, StringView::ptr(path), StringView::len(path)))
    {
        Ok(b)  : b,
        Err(c) : return Err(file_error(c)),
    };
    Vec<String> names = Vec::new();
    Vec<u8> name = Vec::new();
    foreach (b in &all)
    {
        match (*b)
        {
            0 :
            {
                Vec<u8> done = replace(&mut name, Vec::new());
                match (String::from_utf8(done))
                {
                    Ok(n)  : Vec::push(&mut names, n),
                    Err(e) : return Err(FileError::Utf8(e)),
                }
            },
            c : Vec::push(&mut name, c),
        }
    }
    Ok(names)
}

// What `path` names; `Err(NotFound)` when nothing does.
/// What `path` names: a file and its length, a directory, or something else.
///
/// A symbolic link is followed. `Err(NotFound)` when nothing is at `path`.
export fn path_kind(StringView path) : Result<PathKind, FileError>
{
    Vec<u8> b = match (fs_answer(1, StringView::ptr(path), StringView::len(path)))
    {
        Ok(b)  : b,
        Err(c) : return Err(file_error(c)),
    };
    u64 len = 0;
    usize i = 8;
    while (i > 0)
    {
        len = (len << 8) | widen<u64>(b[i]);
        i -= 1;
    }
    match (b[0])
    {
        0 : Ok(File(len)),
        1 : Ok(Dir),
        _ : Ok(Other),
    }
}

// `base` and then `tail`, with the platform's separator between; an
// absolute `tail` replaces `base`.
/// The path `base` followed by `tail`, with the platform's separator between them.
///
/// No separator is added after one `base` already ends with. An absolute `tail` is returned alone. Reads the
/// text only, never the file system.
export fn path_join(StringView base, StringView tail) : String
{
    Option::unwrap_or(path_text(base, tail, 0), String::from_view(tail))
}

// All but the last part: `None` for a root or an empty path; the empty
// path for a single relative name.
/// The path `p` without its last part.
///
/// `None` for a root or the empty path; the empty path for a single relative name. Reads the text only,
/// never the file system; the grammar is the platform's (`\` also separates parts on Windows).
export fn path_parent(StringView p) : Option<String>
{
    path_text(p, "", 1)
}

/// A single relative name has the empty path as its parent; the empty path has none.
unittest "path_parent: a single name"
{
    assert(Option::unwrap(path_parent("notes.txt")) == "");
    assert(Option::is_none(&path_parent("")));
}

// The last part: `None` when it is `..`, or there is none (`/`, ``).
/// The last part of the path `p`.
///
/// `None` when the last part is `..`, or when there is none (`/`, the empty path). Reads the text only.
export fn path_file_name(StringView p) : Option<String>
{
    path_text(p, "", 2)
}

/// A path ending in `..` has no file name.
unittest "path_file_name: a final .."
{
    assert(Option::unwrap(path_file_name("src/main.cb")) == "main.cb");
    assert(Option::is_none(&path_file_name("src/..")));
}

// The file name without its extension (`archive.tar` of `archive.tar.gz`;
// `.bashrc` of `.bashrc`).
/// The file name of `p` without its extension (`archive.tar` of `archive.tar.gz`).
///
/// A name whose only dot is its first byte has no extension, so its stem is the whole name (`.bashrc`).
/// Reads the text only.
export fn path_stem(StringView p) : Option<String>
{
    path_text(p, "", 3)
}

/// Only the last extension is removed, and a leading dot does not start one.
unittest "path_stem: the last dot"
{
    assert(Option::unwrap(path_stem("archive.tar.gz")) == "archive.tar");
    assert(Option::unwrap(path_stem(".bashrc")) == ".bashrc");
}

// The file name's extension, without its dot (`gz` of `archive.tar.gz`);
// `None` when there is none (a name with no dot, or only a leading one).
/// The extension of the file name of `p`, without its dot (`gz` of `archive.tar.gz`).
///
/// `None` when there is none: a name with no dot, or whose only dot is its first byte. Reads the text only.
export fn path_extension(StringView p) : Option<String>
{
    path_text(p, "", 4)
}

/// A name with no dot, or only a leading one, has no extension.
unittest "path_extension: no extension"
{
    assert(Option::unwrap(path_extension("archive.tar.gz")) == "gz");
    assert(Option::is_none(&path_extension(".bashrc")));
    assert(Option::is_none(&path_extension("README")));
}

/// Whether `p` names a place without the working directory.
///
/// By the platform's grammar: a leading `/` on Unix; `C:\` or `\\server\share\` on Windows. Reads the text
/// only.
export fn path_is_absolute(StringView p) : bool
{
    match (path_result(5, p, ""))
    {
        Ok(r)  : r == 1,
        Err(_) : false,
    }
}

// The path with `.` parts removed and `x/..` resolved where `x` is a
// name, by its text alone (a link is not followed); a leading `..` stays,
// `/..` is `/`, and nothing left is `.`.
/// The path `p` with every `.` part removed and every `x/..` (`x` a name) resolved.
///
/// By the text alone: a link is not followed, so the result can name another place than `p` when `x` is a
/// link. A leading `..` stays, `/..` is `/`, and a path with no part left is `.`. Use `path_canonical` to
/// ask the file system.
export fn path_normalize(StringView p) : String
{
    Option::unwrap_or(path_text(p, "", 6), String::from_view(p))
}

/// `.` parts go, a name and its following `..` cancel, and an empty result is `.`.
unittest "path_normalize: . and .."
{
    assert(path_normalize("a/./b/../c") == path_join("a", "c"));
    assert(path_normalize("../x/..") == "..");
    assert(path_normalize("a/..") == ".");
}

// The absolute path the operating system resolves `p` to, every link
// followed; `p` must exist.
/// The absolute path the operating system resolves `p` to, with every link followed.
///
/// `p` must exist: `Err(NotFound)` when nothing is at `p`; `Err(Utf8(e))` when the result is not UTF-8.
export fn path_canonical(StringView p) : Result<String, FileError>
{
    Vec<u8> b = match (byte_answer(0, 7, 0, p.bytes, StringView::of("").bytes))
    {
        Ok(b)  : b,
        Err(c) : return Err(code_error(c)),
    };
    match (String::from_utf8(b))
    {
        Ok(s)  : Ok(s),
        Err(e) : Err(FileError::Utf8(e)),
    }
}

// What `file_info` tells: the kind (as `path_kind`'s), the length in
// bytes, the last modification in seconds since 1970-01-01T00:00:00Z,
// and whether the file is read-only.
/// What `file_info` reports of a path.
///
/// - `kind`: what the path names, as `path_kind` gives it.
/// - `len`: the length in bytes.
/// - `modified_unix`: the last modification, in whole seconds since 1970-01-01T00:00:00Z (rounded down).
/// - `readonly`: whether the file is read-only.
export struct FileInfo
{
    export PathKind kind;
    export u64 len;
    export i64 modified_unix;
    export bool readonly;
}

// Following a symbolic link, as `path_kind` does.
/// The kind, length, modification time and read-only state of what is at `path`.
///
/// A symbolic link is followed, as `path_kind` follows it. `Err(NotFound)` when nothing is at `path`.
export fn file_info(StringView path) : Result<FileInfo, FileError>
{
    Vec<u8> b = match (byte_answer(0, 8, 0, path.bytes, StringView::of("").bytes))
    {
        Ok(b)  : b,
        Err(c) : return Err(code_error(c)),
    };
    u64 len = read_le<u64>(&b[0..$], 1);
    PathKind kind = match (b[0])
    {
        0 : File(len),
        1 : Dir,
        _ : Other,
    };
    Ok(FileInfo { .kind = kind, .len = len, .modified_unix = read_le<i64>(&b[0..$], 9), .readonly = b[17] != 0 })
}

// Copies the file `from` to `to`, replacing a file there; the number of
// bytes copied.
/// Copies the file `from` to `to`, replacing a file there, and returns the number of bytes copied.
export fn copy_file(StringView from, StringView to) : Result<u64, FileError>
{
    i64 n = path_result(9, from, to)?;
    Ok(reinterpret<u64>(n))
}

// D-0272: `to` given `from`'s permissions, for the write-then-rename
// pattern (a file written beside another and renamed over it).
/// Gives what is at `to` the permissions of what is at `from`: on Unix the mode bits, on Windows the
/// read-only flag.
///
/// For the write-then-rename pattern: a file written beside the original and renamed over it keeps the
/// original's permissions only when they are copied to it before the rename. `Err(NotFound)` when nothing
/// is at `from` or at `to`.
export fn copy_permissions(StringView from, StringView to) : Result<void, FileError>
{
    path_result(17, from, to)?;
    Ok(())
}

/// The permissions of one file given to another.
unittest "copy_permissions: one file's permissions given to another"
{
    String tmp = temp_dir();
    String dir = path_join(String::as_view(&tmp), String::as_view(&sprintf("cb-perm-%v", process_id())));
    _ = make_dir_all(String::as_view(&dir));
    String a = path_join(String::as_view(&dir), "a.txt");
    String b = path_join(String::as_view(&dir), "b.txt");
    _ = write_file(String::as_view(&a), "a");
    _ = write_file(String::as_view(&b), "b");
    assert(Result::is_ok(&copy_permissions(String::as_view(&a), String::as_view(&b))));
    bool ra = Result::unwrap(file_info(String::as_view(&a))).readonly;
    bool rb = Result::unwrap(file_info(String::as_view(&b))).readonly;
    assert(ra == rb);
    String gone = path_join(String::as_view(&dir), "gone.txt");
    assert(Result::is_err(&copy_permissions(String::as_view(&gone), String::as_view(&b))));
    _ = remove_dir_all(String::as_view(&dir));
}

// Makes the directory and every missing directory above it; `Ok` when it
// is there already.
/// Makes the directory `path` and every missing directory above it.
///
/// `Ok(())` when they are all there already.
export fn make_dir_all(StringView path) : Result<void, FileError>
{
    path_result(10, path, "")?;
    Ok(())
}

// Removes the directory and everything in it.
/// Removes the directory `path` and everything in it.
///
/// `Err(NotFound)` when nothing is at `path`.
export fn remove_dir_all(StringView path) : Result<void, FileError>
{
    path_result(11, path, "")?;
    Ok(())
}
