// `std::time` (spec/21 §2j, D-0140): dates and times of day in UTC, the
// wall clock in milliseconds, and the machine's local time (D-0147).
// Calendar arithmetic written in CobaltC: the proleptic Gregorian
// calendar, no leap seconds; the local offset is the platform's. Elapsed
// time is measured with `monotonic_ns`, never with the wall clock, which
// may be changed while a program runs.

// A moment in UTC: a date of the proleptic Gregorian calendar (`year` 0
// is 1 BC) and a time of day to the second. Any field values can be
// written in a struct literal; `DateTime::new` checks them, and
// `DateTime::to_unix` faults on a value that names no moment.
/// A moment in UTC: a date of the proleptic Gregorian calendar and a time of day to the second.
///
/// `year` 0 is 1 BC and -1 is 2 BC; there are no leap seconds, so every day has 86,400 seconds. Any field
/// values can be written in a struct literal: `DateTime::new` checks them, and `DateTime::to_unix` faults
/// on a value that names no moment. Keep moments in UTC and convert with `DateTime::to_local` only for
/// display.
export struct DateTime
{
    export i64 year;
    export u8 month;
    export u8 day;
    export u8 hour;
    export u8 minute;
    export u8 second;
}

/// A year outside 0 to 9999 is written with its sign and at least four digits.
unittest "DateTime: a negative year"
{
    DateTime t = DateTime { .year = -1, .month = 3, .day = 1, .hour = 9, .minute = 5, .second = 0 };
    String s = DateTime::to_iso(&t);
    assert(s == "-0001-03-01T09:05:00Z");
}

/// A day of the week, `Monday` to `Sunday`.
export enum Weekday
{
    Monday,
    Tuesday,
    Wednesday,
    Thursday,
    Friday,
    Saturday,
    Sunday,
}

// The quotient rounded down and the remainder with the divisor's sign
// (`/` and `%` round towards zero); `d` > 0.
fn floor_div(i64 n, i64 d) : i64
{
    i64 q = n / d;
    if (n % d < 0)
    {
        q -= 1;
    }
    q
}

fn floor_mod(i64 n, i64 d) : i64
{
    i64 r = n % d;
    if (r < 0)
    {
        r += d;
    }
    r
}

fn leap_year(i64 y) : bool
{
    floor_mod(y, 4) == 0 && (floor_mod(y, 100) != 0 || floor_mod(y, 400) == 0)
}

fn days_in_month(i64 y, u8 m) : u8
{
    if (m == 2)
    {
        if (leap_year(y))
        {
            return 29;
        }
        return 28;
    }
    if (m == 4 || m == 6 || m == 9 || m == 11)
    {
        return 30;
    }
    31
}

fn DateTime::valid(ref<DateTime, shared> t) : bool
{
    t.month >= 1 && t.month <= 12 && t.day >= 1 && t.day <= days_in_month(
        t.year,
        t.month,
    ) && t.hour < 24 && t.minute < 60 && t.second < 60
}

// D-0140: the moment `s` seconds after 1970-01-01T00:00:00Z (before it
// when negative). Every `i64` names one, so this never fails. The days
// are converted by H. Hinnant's `civil_from_days`.
/// The moment `s` seconds after 1970-01-01T00:00:00Z, or before it when `s` is negative.
///
/// Every `i64` names a moment, so this never fails.
export fn DateTime::from_unix(i64 s) : DateTime
{
    i64 z = floor_div(s, 86400) + 719468;
    i64 secs = floor_mod(s, 86400);
    i64 era = floor_div(z, 146097);
    i64 doe = z - era * 146097;
    i64 yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    i64 doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    i64 mp = (5 * doy + 2) / 153;
    i64 d = doy - (153 * mp + 2) / 5 + 1;
    i64 m = mp + 3;
    if (mp >= 10)
    {
        m = mp - 9;
    }
    i64 y = yoe + era * 400;
    if (m <= 2)
    {
        y += 1;
    }
    DateTime { .year = y, .month = narrow<u8>(m), .day = narrow<u8>(d), .hour = narrow<u8>(secs / 3600), .minute = narrow<u8>(secs % 3600 / 60), .second = narrow<u8>(secs % 60) }
}

/// A negative count names a moment before 1970, and `to_unix` gives the count back.
unittest "DateTime::from_unix: before 1970"
{
    DateTime t = DateTime::from_unix(-1);
    assert(t.year == 1969 && t.month == 12 && t.day == 31);
    assert(t.hour == 23 && t.minute == 59 && t.second == 59);
    assert(DateTime::to_unix(&t) == -1);
}

// The moment now, by the wall clock, to the second.
/// The moment now by the wall clock, to the second: `DateTime::from_unix(unix_seconds())`.
export fn DateTime::now() : DateTime
{
    DateTime::from_unix(unix_seconds())
}

// The `DateTime` with these fields, or `None` when they name no moment
// (a month 13, a 30 February, an hour 24, a second 60).
/// The `DateTime` with these fields, or `None` when they name no moment.
///
/// `None` for a month 13, a 30 February, a 29 February in a common year, an hour 24 or a second 60. A leap
/// year is divisible by 4 and not by 100, or by 400.
export fn DateTime::new(i64 year, u8 month, u8 day, u8 hour, u8 minute, u8 second) : Option<DateTime>
{
    DateTime t = DateTime { .year = year, .month = month, .day = day, .hour = hour, .minute = minute, .second = second };
    if (!DateTime::valid(&t))
    {
        return None;
    }
    Some(t)
}

/// 29 February exists only in a leap year.
unittest "DateTime::new: 29 February"
{
    Option<DateTime> leap = DateTime::new(2024, 2, 29, 0, 0, 0);
    Option<DateTime> common = DateTime::new(2023, 2, 29, 0, 0, 0);
    assert(Option::is_some(&leap));
    assert(Option::is_none(&common));
}

// The seconds since 1970-01-01T00:00:00Z, `from_unix`'s inverse (H.
// Hinnant's `days_from_civil`). A `DateTime` whose fields name no moment,
// or one too far from 1970 for an `i64`, is `diag.invalid-datetime`.
/// The seconds from 1970-01-01T00:00:00Z to the moment `t`, negative before it; the inverse of `from_unix`.
///
/// Faults (`invalid_datetime`) when the fields of `t` name no moment, or when the count does not fit in an
/// `i64`.
export fn DateTime::to_unix(ref<DateTime, shared> t) : i64
    requires
    {
        DateTime::valid(t), invalid_datetime;
    }
{
    match (DateTime::unix_checked(t))
    {
        Some(v) : v,
        None    : fault(invalid_datetime),
    }
}

// `to_unix` of a valid `t`, or `None` when the count does not fit in an
// `i64`: what the readers (`from_iso`, `unix_ms_from_iso`) check, so text
// never reaches `to_unix`'s fault (report 217).
fn DateTime::unix_checked(ref<DateTime, shared> t) : Option<i64>
{
    i64 m = widen<i64>(t.month);
    i64 y = t.year;
    if (m <= 2)
    {
        y = match (checked_sub(y, 1))
        {
            Some(v) : v,
            None    : return None,
        };
    }
    i64 era = floor_div(y, 400);
    i64 yoe = y - era * 400;
    i64 mp = m + 9;
    if (m > 2)
    {
        mp = m - 3;
    }
    i64 doy = (153 * mp + 2) / 5 + widen<i64>(t.day) - 1;
    i64 doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    i64 secs = widen<i64>(t.hour) * 3600 + widen<i64>(t.minute) * 60 + widen<i64>(t.second);
    Option<i64> days = match (checked_mul(era, 146097))
    {
        Some(e) : checked_add(e, doe - 719468),
        None    : None,
    };
    // Before 1970 the day after is multiplied, and the seconds counted back
    // from it, so the earliest `i64` second is reached without overflow.
    Option<i64> s = match (days)
    {
        Some(d) : if (d < 0)
        {
            match (checked_mul(d + 1, 86400))
            {
                Some(x) : checked_add(x, secs - 86400),
                None    : None,
            }
        }
        else
        {
            match (checked_mul(d, 86400))
            {
                Some(x) : checked_add(x, secs),
                None    : None,
            }
        },
        None : None,
    };
    s
}

// The day of the week (1970-01-01 was a Thursday). The calendar repeats
// every 400 years, a whole number of weeks, so any year is reduced to one
// near 2000 first and no `DateTime` is too far from 1970 for this.
/// The day of the week of the date of `t`.
///
/// Defined for every valid `t`, however far from 1970. Faults (`invalid_datetime`) when the date of `t`
/// names no day.
export fn DateTime::weekday(ref<DateTime, shared> t) : Weekday
{
    DateTime near = DateTime { .year = 2000 + floor_mod(
        t.year,
        400,
    ), .month = t.month, .day = t.day, .hour = 0, .minute = 0, .second = 0 };
    i64 days = DateTime::to_unix(&near) / 86400;
    match (floor_mod(days + 3, 7))
    {
        0 : Monday,
        1 : Tuesday,
        2 : Wednesday,
        3 : Thursday,
        4 : Friday,
        5 : Saturday,
        _ : Sunday,
    }
}

/// 1970-01-01 was a Thursday.
unittest "DateTime::weekday: 1970-01-01"
{
    DateTime t = DateTime::from_unix(0);
    Weekday w = DateTime::weekday(&t);
    assert(Weekday::text(&w) == "Thursday");
}

/// The day's English name (`Monday`).
export fn Weekday::text(ref<Weekday, shared> w) : str
{
    match (w)
    {
        Monday    : "Monday",
        Tuesday   : "Tuesday",
        Wednesday : "Wednesday",
        Thursday  : "Thursday",
        Friday    : "Friday",
        Saturday  : "Saturday",
        Sunday    : "Sunday",
    }
}

// ISO 8601 in UTC: `2026-10-03T10:17:00Z`. A year outside 0 ..= 9999 is
// written with its sign and at least four digits (`-0001`, `+10000`).
/// The moment in ISO 8601 form in UTC, such as `2026-10-03T10:17:00Z`.
///
/// Each field is zero-padded to its width. A year outside 0 ..= 9999 is written with its sign and at least
/// four digits (`-0001`, `+10000`). Use `iso_from_unix_ms` for a timestamp with milliseconds.
export fn DateTime::to_iso(ref<DateTime, shared> t) : String
{
    String out = String::new();
    if (t.year >= 0 && t.year <= 9999)
    {
        String::appendf(&mut out, "%04d", t.year);
    }
    else if (t.year > 9999)
    {
        String::appendf(&mut out, "+%d", t.year);
    }
    else
    {
        String::appendf(&mut out, "-%04u", wrapping_sub(0: u64, reinterpret<u64>(t.year)));
    }
    String::appendf(&mut out, "-%02d-%02dT%02d:%02d:%02dZ", t.month, t.day, t.hour, t.minute, t.second);
    out
}

// The number in the `n` digits at `at`, or the position of the first
// byte that is not a digit.
fn iso_digits(StringView v, usize at, usize n) : Result<i64, usize>
{
    i64 x = 0;
    for (usize i = at; i < at + n; i += 1)
    {
        if (i >= slice_len(v.bytes) || !ascii_is_digit(v.bytes[i]))
        {
            return Err(i);
        }
        x = x * 10 + widen<i64>(v.bytes[i] - 48);
    }
    Ok(x)
}

// Whether byte `at` is `c`; a missing byte is not.
fn iso_byte(StringView v, usize at, u8 c) : bool
{
    at < slice_len(v.bytes) && v.bytes[at] == c
}

// Reads `YYYY-MM-DDTHH:MM:SSZ`, or a date alone, `YYYY-MM-DD`, as its
// midnight; the seconds may carry a fraction (`:37.25Z`, D-0181), which
// `from_iso` drops and `unix_ms_from_iso` keeps to the millisecond.
// Reports 240 and 304: RFC 3339's other forms too: a space (or `t`) for
// the `T`, `z` for `Z`, an offset `+HH:MM` or `-HH:MM` (`to_iso_local`'s,
// converted to UTC), `+HH` and `+HHMM` (PostgreSQL's `timestamptz` text),
// or no zone at all (`timestamp` text: the fields as written, since a
// `DateTime` knows no zone). A year is four digits, or
// a sign and four or more. `Invalid(i)` gives the first byte that does
// not fit (the length when the text stops short); `OutOfRange` a field
// that names no moment (a month 13, a 29 February in a common year, a
// second 60) or a year beyond `i64`.
/// Reads a moment in ISO 8601 / RFC 3339 form (`to_iso`'s, `to_iso_local`'s), or a date alone (`YYYY-MM-DD`)
/// as its midnight.
///
/// The year is four digits, or a sign and four or more. The date and the time are parted by `T` (or `t`, or a
/// space, as PostgreSQL writes them), and the time is `HH:MM:SS`. The seconds may carry a fraction
/// (`:37.25Z`), which is dropped; `unix_ms_from_iso` keeps it to the millisecond. The zone is `Z` (or `z`),
/// an offset from UTC, `+HH:MM`, `-HH:MM`, `+HH` or `+HHMM`, by which the moment is converted to UTC
/// (`2024-03-10T03:30:00-04:00` is `2024-03-10T07:30:00Z`), or nothing: a time without a zone is read as its
/// fields as written (a `DateTime` knows no zone; `std::time` takes it as UTC). No other form is read.
///
/// - `Err(Empty)` for the empty text.
/// - `Err(Invalid(i))`: byte `i` is the first that does not fit the form (the length when the text stops
///   short).
/// - `Err(OutOfRange)`: the fields name no moment (a month 13, a 29 February in a common year, a second
///   60, an offset of 24 hours or more or with a minute past 59), or the moment is too far from 1970 for `to_unix` (its seconds do not fit in an `i64`), so a
///   `DateTime` read here can always be converted.
export fn DateTime::from_iso(StringView text) : Result<DateTime, ParseError>
{
    u16 ms = 0;
    DateTime::read_iso(text, &mut ms)
}

/// A date alone reads as its midnight; a time without seconds stops short and is `Invalid` at its end.
unittest "DateTime::from_iso: a date alone, a short time"
{
    match (DateTime::from_iso("2026-10-03"))
    {
        Ok(t)  : assert(t.day == 3 && t.hour == 0),
        Err(_) : assert(false),
    }
    match (DateTime::from_iso("2026-10-03T10:17"))
    {
        Err(Invalid(i)) : assert(i == 16),
        _               : assert(false),
    }
}

/// Reports 240 and 304: an offset converts to UTC, and PostgreSQL's `timestamptz` text reads.
unittest "DateTime::from_iso: offsets and a space for the T"
{
    String z = DateTime::to_iso(&Result::unwrap(DateTime::from_iso("2024-03-10T03:30:00-04:00")));
    assert(z == "2024-03-10T07:30:00Z");
    z = DateTime::to_iso(&Result::unwrap(DateTime::from_iso("2023-11-15 09:13:20+11")));
    assert(z == "2023-11-14T22:13:20Z");
    z = DateTime::to_iso(&Result::unwrap(DateTime::from_iso("2023-11-14 22:13:20")));
    assert(z == "2023-11-14T22:13:20Z");
    z = DateTime::to_iso(&Result::unwrap(DateTime::from_iso("2020-01-01T00:10:00+0530")));
    assert(z == "2019-12-31T18:40:00Z");
    assert(unix_ms_from_iso("2023-11-14 22:13:20.5+00") == Ok(1700000000500));
    match (DateTime::from_iso("2024-03-10T03:30:00+24:00"))
    {
        Err(OutOfRange) : {},
        _               : assert(false),
    }
    match (DateTime::from_iso("2024-03-10T03:30:00+4"))
    {
        Err(Invalid(i)) : assert(i == 21),
        _               : assert(false),
    }
}

// `from_iso`, with the milliseconds of the fraction (rounded down) in
// `ms`.
fn DateTime::read_iso(StringView text, ref<u16, exclusive> ms) : Result<DateTime, ParseError>
{
    usize n = slice_len(text.bytes);
    if (n == 0)
    {
        return Err(Empty);
    }
    usize i = 0;
    bool negative = false;
    bool signed = false;
    if (text.bytes[0] == b'+' || text.bytes[0] == b'-')
    {
        negative = text.bytes[0] == b'-';
        signed = true;
        i = 1;
    }
    usize start = i;
    i64 year = 0;
    bool too_big = false;
    while (i < n && ascii_is_digit(text.bytes[i]))
    {
        i64 d = widen<i64>(text.bytes[i] - 48);
        year = match (checked_mul(year, 10))
        {
            Some(y) : match (checked_add(y, d))
            {
                Some(z) : z,
                None    :
                {
                    too_big = true;
                    0
                },
            },
            None :
            {
                too_big = true;
                0
            },
        };
        i += 1;
    }
    if (i - start < 4)
    {
        return Err(Invalid(i));
    }
    if (!signed && i - start > 4)
    {
        return Err(Invalid(start + 4));
    }
    if (negative)
    {
        year = 0 - year;
    }
    if (!iso_byte(text, i, b'-'))
    {
        return Err(Invalid(i));
    }
    i64 month = match (iso_digits(text, i + 1, 2))
    {
        Ok(x)   : x,
        Err(at) : return Err(Invalid(at)),
    };
    if (!iso_byte(text, i + 3, b'-'))
    {
        return Err(Invalid(i + 3));
    }
    i64 day = match (iso_digits(text, i + 4, 2))
    {
        Ok(x)   : x,
        Err(at) : return Err(Invalid(at)),
    };
    i += 6;
    i64 hour = 0;
    i64 minute = 0;
    i64 second = 0;
    i64 offset = 0;
    if (i < n)
    {
        if (!iso_byte(text, i, b'T') && !iso_byte(text, i, b't') && !iso_byte(text, i, b' '))
        {
            return Err(Invalid(i));
        }
        hour = match (iso_digits(text, i + 1, 2))
        {
            Ok(x)   : x,
            Err(at) : return Err(Invalid(at)),
        };
        if (!iso_byte(text, i + 3, b':'))
        {
            return Err(Invalid(i + 3));
        }
        minute = match (iso_digits(text, i + 4, 2))
        {
            Ok(x)   : x,
            Err(at) : return Err(Invalid(at)),
        };
        if (!iso_byte(text, i + 6, b':'))
        {
            return Err(Invalid(i + 6));
        }
        second = match (iso_digits(text, i + 7, 2))
        {
            Ok(x)   : x,
            Err(at) : return Err(Invalid(at)),
        };
        i += 9;
        if (iso_byte(text, i, b'.'))
        {
            usize start_frac = i + 1;
            i = start_frac;
            u16 scale = 100;
            u16 frac = 0;
            while (i < n && ascii_is_digit(text.bytes[i]))
            {
                frac = frac + widen<u16>(text.bytes[i] - 48) * scale;
                scale = scale / 10;
                i += 1;
            }
            if (i == start_frac)
            {
                return Err(Invalid(i));
            }
            *ms = frac;
        }
        if (iso_byte(text, i, b'Z') || iso_byte(text, i, b'z'))
        {
            i += 1;
        }
        else if (iso_byte(text, i, b'+') || iso_byte(text, i, b'-'))
        {
            i64 sign = if (text.bytes[i] == b'-') { -1 } else { 1 };
            i64 oh = match (iso_digits(text, i + 1, 2))
            {
                Ok(x)   : x,
                Err(at) : return Err(Invalid(at)),
            };
            i += 3;
            i64 om = 0;
            if (iso_byte(text, i, b':'))
            {
                om = match (iso_digits(text, i + 1, 2))
                {
                    Ok(x)   : x,
                    Err(at) : return Err(Invalid(at)),
                };
                i += 3;
            }
            else if (i < n)
            {
                om = match (iso_digits(text, i, 2))
                {
                    Ok(x)   : x,
                    Err(at) : return Err(Invalid(at)),
                };
                i += 2;
            }
            if (oh > 23 || om > 59)
            {
                return Err(OutOfRange);
            }
            offset = sign * (oh * 3600 + om * 60);
        }
        if (i < n)
        {
            return Err(Invalid(i));
        }
    }
    if (too_big)
    {
        return Err(OutOfRange);
    }
    match (DateTime::new(
        year,
        narrow<u8>(month),
        narrow<u8>(day),
        narrow<u8>(hour),
        narrow<u8>(minute),
        narrow<u8>(second),
    ))
    {
        // A moment too far from 1970 for `to_unix` is out of range too, so
        // a `DateTime` read from text can always be converted.
        Some(t) : match (DateTime::unix_checked(&t))
        {
            Some(s) : if (offset == 0)
            {
                Ok(t)
            }
            else
            {
                DateTime::utc_of(s, offset)
            },
            None : Err(OutOfRange),
        },
        None : Err(OutOfRange),
    }
}

// The moment `s` seconds of a local time `offset` seconds ahead of UTC,
// in UTC: `OutOfRange` when it is too far from 1970 for `to_unix`.
fn DateTime::utc_of(i64 s, i64 offset) : Result<DateTime, ParseError>
{
    match (checked_sub(s, offset))
    {
        Some(u) :
        {
            DateTime r = DateTime::from_unix(u);
            if (Option::is_some(&DateTime::unix_checked(&r))) { Ok(r) } else { Err(OutOfRange) }
        },
        None    : Err(OutOfRange),
    }
}

// Whether `a` and `b` are the same moment.
/// Whether `a` and `b` are the same moment, every field equal.
export fn DateTime::eq(ref<DateTime, shared> a, ref<DateTime, shared> b) : bool
{
    a.year == b.year && a.month == b.month && a.day == b.day && a.hour == b.hour && a.minute == b.minute && a.second == b.second
}

// Whether `a` is earlier than `b`; fits `Vec::sort_by`.
/// Whether `a` is earlier than `b`, comparing the fields in order of significance.
///
/// For valid values this is the order of `to_unix`. It fits `Vec::sort_by`.
export fn DateTime::less(ref<DateTime, shared> a, ref<DateTime, shared> b) : bool
{
    if (a.year != b.year)
    {
        return a.year < b.year;
    }
    if (a.month != b.month)
    {
        return a.month < b.month;
    }
    if (a.day != b.day)
    {
        return a.day < b.day;
    }
    if (a.hour != b.hour)
    {
        return a.hour < b.hour;
    }
    if (a.minute != b.minute)
    {
        return a.minute < b.minute;
    }
    a.second < b.second
}

/// `less` orders moments by time, and `eq` tells them apart.
unittest "DateTime::less: ordering"
{
    DateTime a = DateTime::from_unix(100);
    DateTime b = DateTime::from_unix(160);
    assert(DateTime::less(&a, &b));
    assert(!DateTime::less(&b, &a));
    assert(!DateTime::eq(&a, &b));
}

// The wall clock in milliseconds since 1970-01-01T00:00:00Z.
// trusted: [Extern-Call] clock_read touches no program storage.
/// The wall clock in milliseconds since 1970-01-01T00:00:00Z, rounded down.
///
/// `unix_ms() / 1000` is `unix_seconds()` when read together. The wall clock may be changed while the
/// program runs; measure elapsed time with `monotonic_ns`.
export fn unix_ms() : i64
{
    unsafe
    {
        clock_read(2)
    }
}

// D-0147: how many seconds the machine's local time is ahead of UTC
// (behind, when negative) at the moment `unix` seconds after
// 1970-01-01T00:00:00Z, daylight saving included, by the operating
// system's rule for the zone the program runs in. For a moment the system
// has no rule for, the offset now.
// trusted: [Extern-Call] tz_offset touches no program storage.
/// How many seconds the machine's local time is ahead of UTC at the moment `unix` seconds after 1970.
///
/// Negative when local time is behind UTC; daylight saving included, by the operating system's rule for the
/// zone the program runs in. Between -64800 and 64800. For a moment the system has no rule for, the offset
/// now. It differs between machines, and on one machine between moments.
export fn local_offset_seconds(i64 unix) : i64
{
    unsafe
    {
        tz_offset(unix)
    }
}

// The moment `t` (in UTC) written in the machine's local time. The result
// is a `DateTime` like any other and knows nothing of its zone: print its
// fields, not `to_iso` (which writes `Z`), and keep the UTC value for
// arithmetic. A moment within a day of an `i64` limit is
// `diag.invalid-datetime`.
/// The moment `t`, given in UTC, written in the machine's local time.
///
/// The result is a `DateTime` like any other and knows nothing of its zone: print its fields, not `to_iso`
/// (which writes `Z`; `DateTime::to_iso_local` writes a local time with its offset), and keep the UTC value
/// for arithmetic, since `to_unix` of the result is the moment plus the offset. Faults (`invalid_datetime`)
/// when `t` names no moment, or when the moment is within a day of an `i64` limit.
export fn DateTime::to_local(ref<DateTime, shared> t) : DateTime
{
    i64 s = DateTime::to_unix(t);
    match (checked_add(s, local_offset_seconds(s)))
    {
        Some(v) : DateTime::from_unix(v),
        None    : fault(invalid_datetime),
    }
}

// Report 057: the local time with its offset, the form a log line or a
// report wants, so no program writes `to_iso(to_local(t))`, a local time
// marked `Z`.
/// The moment `t`, given in UTC, in ISO 8601 form in the machine's local time with its offset from UTC.
///
/// Such as `2024-03-10T03:30:00-04:00` for `2024-03-10T07:30:00Z` in New York; `+00:00` where local time is
/// UTC. The text names the same moment as `to_iso`'s, so `DateTime::from_iso` and any other reader of ISO 8601
/// get `t` back (an offset
/// that is not a whole number of minutes, which no zone has used since 1972, is cut to the minute, and the
/// time with it). The offset is `local_offset_seconds`'s at that moment. Faults as `DateTime::to_local`.
export fn DateTime::to_iso_local(ref<DateTime, shared> t) : String
{
    i64 s = DateTime::to_unix(t);
    i64 off = local_offset_seconds(s);
    off = off - off % 60;
    DateTime local = match (checked_add(s, off))
    {
        Some(v) : DateTime::from_unix(v),
        None    : fault(invalid_datetime),
    };
    String out = DateTime::to_iso(&local);
    _ = Vec::pop(&mut out.bytes);   // the `Z`
    i64 m = if (off < 0) { 0 - off / 60 } else { off / 60 };
    String::appendf(&mut out, "%s%02d:%02d", if (off < 0) { "-" } else { "+" }, m / 60, m % 60);
    out
}

// The clocks (D-0061, moved here from `std::sys` by D-0176): a monotonic
// count for measuring durations, the wall clock in seconds, and sleeping.

// A monotonic clock, in nanoseconds from an arbitrary start: for measuring
// how long something takes; it never goes backwards.
// trusted: [Extern-Call] clock_read touches no program storage.
/// Nanoseconds on a monotonic clock, from a start fixed for the whole program.
///
/// The clock never goes backwards, so the difference of two readings measures how long something took. Its
/// values mean nothing else; use `unix_ms` for the time of day.
export fn monotonic_ns() : u64
{
    reinterpret<u64>(unsafe
    {
        clock_read(0)
    })
}

// The wall clock: whole seconds since 1970-01-01 00:00 UTC.
// trusted: [Extern-Call] clock_read touches no program storage.
/// The wall clock: whole seconds since 1970-01-01T00:00:00Z.
///
/// The wall clock may be changed while the program runs; measure elapsed time with `monotonic_ns`.
export fn unix_seconds() : i64
{
    unsafe
    {
        clock_read(1)
    }
}

// D-0124: the calling thread does nothing for at least `ms` milliseconds;
// other threads run meanwhile.
// trusted: [Extern-Call] sleep_ns touches no program storage.
/// Makes the calling thread do nothing for at least `ms` milliseconds; other threads run meanwhile.
export fn sleep_ms(u64 ms)
{
    i64 ignored = unsafe
    {
        sleep_ns(wrapping_mul(ms, 1000000))
    };
}

// ---- D-0181: milliseconds in ISO text, and HTTP dates ----

// `to_iso` of the moment `ms` milliseconds after 1970-01-01T00:00:00Z,
// with the milliseconds: `2026-10-07T12:34:56.789Z`. A log line's or a
// JSON document's timestamp.
/// The moment `ms` milliseconds after 1970-01-01T00:00:00Z in `to_iso`'s form, with milliseconds.
///
/// The form is `2026-10-07T12:34:56.789Z`, a log line's or a JSON document's timestamp. A negative `ms`
/// is before 1970, the milliseconds still counted forward within their second.
export fn iso_from_unix_ms(i64 ms) : String
{
    i64 s = floor_div(ms, 1000);
    i64 frac = floor_mod(ms, 1000);
    DateTime t = DateTime::from_unix(s);
    String out = DateTime::to_iso(&t);
    String::truncate(&mut out, StringView::len(&out) - 1);
    String::appendf(&mut out, ".%03dZ", frac);
    out
}

/// One millisecond before 1970 is the last millisecond of 1969.
unittest "iso_from_unix_ms: before 1970"
{
    assert(iso_from_unix_ms(-1) == "1969-12-31T23:59:59.999Z");
}

// `from_iso`'s text as milliseconds since 1970-01-01T00:00:00Z, a
// fraction of the seconds kept to the millisecond (`.5` is 500, `.1234`
// is 123). The errors are `from_iso`'s; a moment beyond `i64`
// milliseconds is `OutOfRange`.
/// The milliseconds since 1970-01-01T00:00:00Z of a moment in `DateTime::from_iso`'s form.
///
/// A fraction of the seconds is kept to the millisecond: its first three digits, fewer filled with zeros,
/// further digits ignored (`.5` is 500, `.1234` is 123). The errors are `from_iso`'s; `Err(OutOfRange)`
/// also when the milliseconds do not fit in an `i64`.
export fn unix_ms_from_iso(StringView text) : Result<i64, ParseError>
{
    u16 ms = 0;
    DateTime t = DateTime::read_iso(text, &mut ms)?;
    match (checked_mul(DateTime::to_unix(&t), 1000))   // read_iso refused a `t` whose seconds do not fit
    {
        Some(x) : match (checked_add(x, widen<i64>(ms)))
        {
            Some(y) : Ok(y),
            None    : Err(OutOfRange),
        },
        None : Err(OutOfRange),
    }
}

/// A fraction is read to the millisecond, shorter ones filled and longer ones cut.
unittest "unix_ms_from_iso: fractions"
{
    assert(unix_ms_from_iso("1970-01-01T00:00:01.5Z") == Ok(1500));
    assert(unix_ms_from_iso("1970-01-01T00:00:00.1239Z") == Ok(123));
}

fn month_name(u8 m) : str
{
    match (m)
    {
        1  : "Jan",
        2  : "Feb",
        3  : "Mar",
        4  : "Apr",
        5  : "May",
        6  : "Jun",
        7  : "Jul",
        8  : "Aug",
        9  : "Sep",
        10 : "Oct",
        11 : "Nov",
        _  : "Dec",
    }
}

fn month_number(StringView name) : Option<u8>
{
    for (u8 m = 1; m <= 12; m += 1)
    {
        if (name == month_name(m))
        {
            return Some(m);
        }
    }
    None
}

// The moment in HTTP's date form (RFC 9110 §5.6.7, the IMF-fixdate):
// `Sun, 06 Nov 1994 08:49:37 GMT`, as the `Date`, `Last-Modified` and
// `Expires` headers carry it. The year is written in four digits
// (`diag.invalid-datetime` outside 0 ..= 9999).
/// The moment in HTTP's date form, such as `Sun, 06 Nov 1994 08:49:37 GMT`.
///
/// The form (RFC 9110 §5.6.7, the IMF-fixdate) is what the `Date`, `Last-Modified` and `Expires` headers
/// carry. Faults (`invalid_datetime`) for a year outside 0 ..= 9999, or fields that name no moment.
export fn DateTime::to_http_date(ref<DateTime, shared> t) : String
    requires
    {
        t.year >= 0 && t.year <= 9999, invalid_datetime;
    }
{
    Weekday w = DateTime::weekday(t);
    str day = Weekday::text(&w);
    String out = String::new();
    String::append(&mut out, &StringView::of(day)[0..3]);
    String::appendf(
        &mut out,
        ", %02d %s %04d %02d:%02d:%02d GMT",
        t.day,
        month_name(t.month),
        t.year,
        t.hour,
        t.minute,
        t.second,
    );
    out
}

/// The weekday and month are written as three-letter English names.
unittest "DateTime::to_http_date: the IMF-fixdate"
{
    DateTime t = DateTime::from_unix(784111777);
    assert(DateTime::to_http_date(&t) == "Sun, 06 Nov 1994 08:49:37 GMT");
}

// The words of `text` and where each starts.
fn http_date_words(StringView text, ref<Vec<usize>, exclusive> starts) : Vec<StringView> from text
{
    Vec<StringView> out = Vec::new();
    usize n = slice_len(text.bytes);
    usize i = 0;
    while (i < n)
    {
        while (i < n && ascii_is_space(text.bytes[i]))
        {
            i += 1;
        }
        usize start = i;
        while (i < n && !ascii_is_space(text.bytes[i]))
        {
            i += 1;
        }
        if (i > start)
        {
            Vec::push(&mut out, &text[start..i]);
            Vec::push(starts, start);
        }
    }
    out
}

// `hh:mm:ss` into its parts.
fn http_time(StringView w, ref<u8, exclusive> h, ref<u8, exclusive> m, ref<u8, exclusive> s) : bool
{
    if (StringView::len(w) != 8 || !iso_byte(w, 2, b':') || !iso_byte(w, 5, b':'))
    {
        return false;
    }
    i64 a = match (iso_digits(w, 0, 2)) { Ok(x) : x, Err(_) : return false };
    i64 b = match (iso_digits(w, 3, 2)) { Ok(x) : x, Err(_) : return false };
    i64 c = match (iso_digits(w, 6, 2)) { Ok(x) : x, Err(_) : return false };
    *h = narrow<u8>(a);
    *m = narrow<u8>(b);
    *s = narrow<u8>(c);
    true
}

// Reads an HTTP date in any of the three forms a recipient must accept
// (RFC 9110 §5.6.7): `Sun, 06 Nov 1994 08:49:37 GMT` (the one to send),
// the obsolete `Sunday, 06-Nov-94 08:49:37 GMT` (a two-digit year: 70 to
// 99 are the 1900s, 00 to 69 the 2000s) and `Sun Nov  6 08:49:37 1994`.
// The weekday is not checked against the date. `Invalid(i)` names the
// first word that does not fit; `OutOfRange` fields that name no moment.
/// Reads an HTTP date in any of the three forms a recipient must accept (RFC 9110 §5.6.7).
///
/// The forms are `Sun, 06 Nov 1994 08:49:37 GMT` (the one to send), the obsolete RFC 850
/// `Sunday, 06-Nov-94 08:49:37 GMT` (a two-digit year: 70 to 99 are 1970 to 1999, 00 to 69 are 2000 to
/// 2069) and asctime's `Sun Nov  6 08:49:37 1994`. The words are separated by ASCII whitespace; the weekday
/// is not checked against the date.
///
/// - `Err(Empty)` when the text has no words.
/// - `Err(Invalid(i))`: `i` is the start of the first word that does not fit (a zone other than `GMT`, a word
///   after the last), or the text's length when it stops short.
/// - `Err(OutOfRange)`: the fields name no moment.
export fn DateTime::from_http_date(StringView text) : Result<DateTime, ParseError>
{
    Vec<usize> at = Vec::new();
    Vec<StringView> w = http_date_words(text, &mut at);
    if (Vec::len(&w) == 0)
    {
        return Err(Empty);
    }
    i64 year = 0;
    u8 month = 0;
    u8 day = 0;
    u8 hour = 0;
    u8 minute = 0;
    u8 second = 0;
    // The form is told by its first words; then each word is checked in
    // order, so the error names the first that does not fit, the text's
    // length when a word is missing, and the start of a word after the last
    // (report 157).
    usize n = Vec::len(&w);
    usize end = StringView::len(text);
    usize words = 0;
    if (StringView::ends_with(w[0], ",") && n >= 2 && iso_byte(w[1], 2, b'-'))
    {
        // RFC 850: `Sunday, 06-Nov-94 08:49:37 GMT`.
        words = 4;
        StringView d = w[1];
        if (StringView::len(d) != 9 || !iso_byte(d, 6, b'-')) { return Err(Invalid(at[1])); }
        day = match (iso_digits(d, 0, 2)) { Ok(x) : narrow<u8>(x), Err(_) : return Err(Invalid(at[1])) };
        month = match (month_number(&d[3..6])) { Some(m) : m, None : return Err(Invalid(at[1])) };
        i64 yy = match (iso_digits(d, 7, 2)) { Ok(x) : x, Err(_) : return Err(Invalid(at[1])) };
        year = if (yy >= 70) { 1900 + yy } else { 2000 + yy };
        if (n < 3) { return Err(Invalid(end)); }
        if (!http_time(w[2], &mut hour, &mut minute, &mut second)) { return Err(Invalid(at[2])); }
        if (n < 4) { return Err(Invalid(end)); }
        if (w[3] != "GMT") { return Err(Invalid(at[3])); }
    }
    else if (StringView::ends_with(w[0], ","))
    {
        // IMF-fixdate: `Sun, 06 Nov 1994 08:49:37 GMT`.
        words = 6;
        if (n < 2) { return Err(Invalid(end)); }
        day = match (iso_digits(w[1], 0, 2)) { Ok(x) : narrow<u8>(x), Err(_) : return Err(Invalid(at[1])) };
        if (StringView::len(w[1]) != 2) { return Err(Invalid(at[1])); }
        if (n < 3) { return Err(Invalid(end)); }
        month = match (month_number(w[2])) { Some(m) : m, None : return Err(Invalid(at[2])) };
        if (n < 4) { return Err(Invalid(end)); }
        year = match (iso_digits(w[3], 0, 4)) { Ok(x) : x, Err(_) : return Err(Invalid(at[3])) };
        if (StringView::len(w[3]) != 4) { return Err(Invalid(at[3])); }
        if (n < 5) { return Err(Invalid(end)); }
        if (!http_time(w[4], &mut hour, &mut minute, &mut second)) { return Err(Invalid(at[4])); }
        if (n < 6) { return Err(Invalid(end)); }
        if (w[5] != "GMT") { return Err(Invalid(at[5])); }
    }
    else
    {
        // asctime: `Sun Nov  6 08:49:37 1994`.
        words = 5;
        if (n < 2) { return Err(Invalid(end)); }
        month = match (month_number(w[1])) { Some(m) : m, None : return Err(Invalid(at[1])) };
        if (n < 3) { return Err(Invalid(end)); }
        usize dl = StringView::len(w[2]);
        if (dl == 0 || dl > 2) { return Err(Invalid(at[2])); }
        day = match (iso_digits(w[2], 0, dl)) { Ok(x) : narrow<u8>(x), Err(_) : return Err(Invalid(at[2])) };
        if (n < 4) { return Err(Invalid(end)); }
        if (!http_time(w[3], &mut hour, &mut minute, &mut second)) { return Err(Invalid(at[3])); }
        if (n < 5) { return Err(Invalid(end)); }
        year = match (iso_digits(w[4], 0, 4)) { Ok(x) : x, Err(_) : return Err(Invalid(at[4])) };
        if (StringView::len(w[4]) != 4) { return Err(Invalid(at[4])); }
    }
    if (n > words)
    {
        return Err(Invalid(at[words]));
    }
    match (DateTime::new(year, month, day, hour, minute, second))
    {
        Some(t) : Ok(t),
        None    : Err(OutOfRange),
    }
}

/// In the RFC 850 form, a two-digit year from 70 to 99 is in the 1900s.
unittest "DateTime::from_http_date: a two-digit year"
{
    match (DateTime::from_http_date("Sunday, 06-Nov-94 08:49:37 GMT"))
    {
        Ok(t)  : assert(t.year == 1994 && t.month == 11 && t.day == 6),
        Err(_) : assert(false),
    }
}
