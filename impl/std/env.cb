// `std::env` (spec/21 §2c, D-0176): the program's arguments and its
// environment -- environment variables and the current, temporary and home
// directories. Moved here from `std::sys` (D-0176).

/// Copies at most `len` bytes of argument `i` to `buf` and returns the argument's whole length.
///
/// Returns -1, storing nothing, when there is no argument `i`; a call with `len` 0 only asks whether
/// argument `i` exists and how long it is. Called inside `unsafe`: `[buf, buf + len)` must be storage
/// outside every live object. For an argument's bytes whatever they are; `arg` is the safe way to read one.
export unsafe extern fn arg_bytes(usize i, rawptr<u8> buf, usize len) : isize;

// trusted: [Extern-Call] arg_bytes with no buffer (dangling, 0): it stores nothing and answers the length.
/// The number of the program's arguments, not counting the program's own name.
export fn arg_count() : usize
{
    usize i = 0;
    while (true)
    {
        isize n = unsafe
        {
            arg_bytes(i, dangling<u8>(), 0)
        };
        if (n < 0)
        {
            break;
        }
        i = i + 1;
    }
    i
}

// trusted: [Extern-Call] arg_bytes into [p, len), the allocation made just above; [Rawptr-Read] of each byte it filled; [Deallocate] of that one allocation.
/// Argument `i` of the program, counted from 0 for the first after the program's own name.
///
/// `Err(e)` when the argument is not UTF-8, `e.offset` being the bad byte's offset within it; use
/// `arg_bytes` for such an argument. Faults (`index_out_of_bounds`) when `i >= arg_count()`.
export fn arg(usize i) : Result<String, Utf8Error>
{
    isize n = unsafe
    {
        arg_bytes(i, dangling<u8>(), 0)
    };
    if (n < 0)
    {
        fault(index_out_of_bounds);
    }
    usize len = reinterpret<usize>(n);
    rawptr<u8> p = match (allocate(len, 1))
    {
        Ok(p)  : p,
        Err(_) : fault(alloc_failure),
    };
    Vec<u8> bytes = Vec::new();
    unsafe
    {
        arg_bytes(i, p, len);
    }
    usize j = 0;
    while (j < len)
    {
        u8 b = unsafe
        {
            *(p + reinterpret<isize>(j))
        };
        Vec::push(&mut bytes, b);
        j = j + 1;
    }
    if (len > 0)
    {
        unsafe
        {
            deallocate(p, len, 1);
        }
    }
    String::from_utf8(bytes)
}

// An environment variable's value; None when it is not set.
/// The value of the environment variable `name`.
///
/// `Ok(None)` when it is not set; `Err(e)` when its value is not UTF-8, `e` giving the offset of the first
/// byte that is not.
export fn env_var(StringView name) : Result<Option<String>, Utf8Error>
{
    match (fs_answer(2, StringView::ptr(name), StringView::len(name)))
    {
        Ok(b) : match (String::from_utf8(b))
        {
            Ok(v)  : Ok(Some(v)),
            Err(e) : Err(e),
        },
        Err(_) : Ok(None),
    }
}

// The working directory, against which a relative path is resolved.
/// The working directory, against which a relative path is resolved.
///
/// `Err(Utf8(e))` when its name is not UTF-8.
export fn current_dir() : Result<String, FileError>
{
    Vec<u8> b = match (fs_answer(3, dangling<u8>(), 0))
    {
        Ok(b)  : b,
        Err(c) : return Err(file_error(c)),
    };
    match (String::from_utf8(b))
    {
        Ok(s)  : Ok(s),
        Err(e) : Err(FileError::Utf8(e)),
    }
}

// Makes `path` the working directory, against which relative paths are
// resolved from now on, in every thread.
/// Makes `path` the working directory, against which relative paths are resolved from now on.
///
/// The change is seen by every thread of the program.
export fn set_current_dir(StringView path) : Result<void, FileError>
{
    path_result(12, path, "")?;
    Ok(())
}

// The operating system's directory for temporary files.
/// The operating system's directory for temporary files.
///
/// A byte sequence in it that is not UTF-8 is replaced with U+FFFD.
export fn temp_dir() : String
{
    Option::unwrap_or(path_text("", "", 13), String::new())
}

// The user's home directory: `HOME`, or `USERPROFILE` on Windows; `None`
// when neither is set.
/// The user's home directory: the variable `HOME`, or `USERPROFILE` on Windows.
///
/// `None` when it is not set. A byte sequence that is not UTF-8 is replaced with U+FFFD.
export fn home_dir() : Option<String>
{
    path_text("", "", 14)
}

// D-0181: the path of the running program's own executable, as the
// operating system reports it (absolute, links followed): a program
// finds the files installed beside it from here.
/// The path of the running program's own executable, absolute and with links followed.
///
/// A program finds the files installed beside it from here. `Err(Utf8(e))` when the path is not UTF-8;
/// `Err(Io)` when the operating system cannot say.
export fn current_exe() : Result<String, FileError>
{
    match (byte_answer(0, 15, 0, StringView::of("").bytes, StringView::of("").bytes))
    {
        Ok(v) : match (String::from_utf8(v))
        {
            Ok(s)  : Ok(s),
            Err(e) : Err(FileError::Utf8(e)),
        },
        Err(c) : Err(code_error(c)),
    }
}

// D-0181: the machine's host name, as the operating system knows it:
// what a log line or a service's registration names the machine by.
/// The machine's host name, as the operating system knows it.
///
/// What a log line or a service's registration names the machine by. `Err(Utf8(e))` when it is not UTF-8;
/// `Err(Io)` when the operating system cannot say.
export fn hostname() : Result<String, FileError>
{
    match (byte_answer(0, 16, 0, StringView::of("").bytes, StringView::of("").bytes))
    {
        Ok(v) : match (String::from_utf8(v))
        {
            Ok(s)  : Ok(s),
            Err(e) : Err(FileError::Utf8(e)),
        },
        Err(c) : Err(code_error(c)),
    }
}

// ---- D-0184: command-line options ----
//
// The arguments read as options and positional arguments, declared as
// they are read: each `flag` or `option` call names what it takes from
// the arguments and adds a line to `help`; `finish` gives what is left
// and refuses an option nobody declared. `--name`, `--name=value`,
// `--name value` and `-s value` are read; `--` ends the options, and a
// lone `-` is an argument.
/// The program's arguments, read as options and positional arguments.
///
/// Each `Args::flag`, `Args::option` or `Args::options` call names an option, takes its occurrences from
/// the arguments and adds a line to `Args::help`; `Args::finish` then gives the arguments left and refuses
/// any option nobody declared. `--name`, `--name=value`, `--name value`, `-s` and `-s value` are read; `--`
/// ends the options, and a lone `-` is an argument.
export struct Args
{
    String usage;
    Vec<String> items;
    Vec<bool> used;
    usize end_of_options;               // the index of `--`, or the count
    Vec<String> specs;                  // for `help`: `-s, --name VALUE`
    Vec<String> helps;
}

// The program's arguments (`arg(0)` on), with the usage line `help`
// shows (`prog [options] FILE…`); `Err` for an argument that is not
// UTF-8.
/// The program's arguments, from `arg(0)` on, with the usage line that `Args::help` shows.
///
/// The usage line is the text after `Usage: `, such as `prog [options] FILE`.
///
/// `Err(e)` for the first argument that is not UTF-8.
export fn Args::new(StringView usage) : Result<Args, Utf8Error>
{
    Vec<String> items = Vec::new();
    for (usize i = 0; i < arg_count(); i += 1)
    {
        Vec::push(&mut items, arg(i)?);
    }
    Ok(Args::from(items, usage))
}

// `Args` over the arguments given, for a program that has them from
// elsewhere, or a test.
/// The arguments `items`, read as `Args::new` reads the program's own.
///
/// For arguments that come from elsewhere, or a test.
export fn Args::from(Vec<String> items, StringView usage) : Args
{
    usize n = Vec::len(&items);
    usize end = n;
    for (usize i = 0; i < n; i += 1)
    {
        if (items[i] == "--")
        {
            end = i;
            break;
        }
    }
    Vec<bool> used = Vec::filled(n, false);
    if (end < n)
    {
        used[end] = true;
    }
    Args { .usage = String::from_view(usage), .items = items, .used = used, .end_of_options = end, .specs = Vec::new(), .helps = Vec::new() }
}

/// A flag and an option are taken from the arguments, and `finish` gives what is left.
unittest "Args::from: flags, options, the rest"
{
    Vec<String> items = Vec::new();
    Vec::push(&mut items, String::from_str("-v"));
    Vec::push(&mut items, String::from_str("--out=a.txt"));
    Vec::push(&mut items, String::from_str("in.txt"));
    Args a = Args::from(items, "prog [options] FILE");
    assert(Args::flag(&mut a, "verbose", "v", "say more"));
    assert(Option::unwrap(Args::option(&mut a, "out", "o", "FILE", "where to write")) == "a.txt");
    Vec<String> rest = Result::unwrap(Args::finish(&mut a));
    assert(Vec::len(&rest) == 1 && rest[0] == "in.txt");
}

// Whether item `i` is the option `--name` (or `-short`): exactly, or,
// for `with_value`, as `--name=…`.
fn Args::is_option(ref<Args, shared> a, usize i, str name, str short, bool with_value) : bool
{
    StringView item = String::as_view(&a.items[i]);
    if (Some(rest) = StringView::strip_prefix(item, "--"))
    {
        if (StringView::eq_str(rest, name))
        {
            return true;
        }
        if (with_value)
        {
            if (Some(after) = StringView::strip_prefix(rest, StringView::of(name)))
            {
                return StringView::starts_with(after, "=");
            }
        }
        return false;
    }
    str_len(short) > 0 && StringView::len(item) == 2 && item.bytes[0] == b'-' && item.bytes[1] == str_byte(short, 0)
}

fn Args::spec(ref<Args, exclusive> a, str name, str short, str value_name, str help)
{
    String spec = String::new();
    if (str_len(short) > 0)
    {
        String::append(&mut spec, "-");
        String::append(&mut spec, short);
        String::append(&mut spec, ", ");
    }
    else
    {
        String::append(&mut spec, "    ");
    }
    String::append(&mut spec, "--");
    String::append(&mut spec, name);
    if (str_len(value_name) > 0)
    {
        String::append(&mut spec, " ");
        String::append(&mut spec, value_name);
    }
    Vec::push(&mut a.specs, spec);
    Vec::push(&mut a.helps, String::from_str(help));
}

// Whether `--name` or `-short` (one letter, or `""` for none) is among
// the arguments; every occurrence is taken. `help` is its line in `help`.
/// Whether `--name` or `-short` is among the arguments before `--`.
///
/// `short` is one letter, or `""` for none; `help` is the option's line in `Args::help`. Every occurrence
/// is taken, so `Args::finish` does not see it.
export fn Args::flag(ref<Args, exclusive> a, str name, str short, str help) : bool
{
    Args::spec(a, name, short, "", help);
    bool found = false;
    for (usize i = 0; i < a.end_of_options; i += 1)
    {
        if (!a.used[i] && Args::is_option(a, i, name, short, false))
        {
            a.used[i] = true;
            found = true;
        }
    }
    found
}

/// After `--`, an argument that looks like an option is a positional argument.
unittest "Args::flag: after --"
{
    Vec<String> items = Vec::new();
    Vec::push(&mut items, String::from_str("--"));
    Vec::push(&mut items, String::from_str("-v"));
    Args a = Args::from(items, "prog [options] FILE");
    assert(!Args::flag(&mut a, "verbose", "v", "say more"));
    Vec<String> rest = Result::unwrap(Args::finish(&mut a));
    assert(Vec::len(&rest) == 1 && rest[0] == "-v");
}

// Every value given for `--name` (as `--name=value` or `--name value`)
// or `-short value`, in order; a `--name` as the last argument, with no
// value, is left for `finish` to refuse.
/// Every value given for the option `--name` or `-short`, in order.
///
/// A value is given as `--name=value`, `--name value` or `-s value`; each is taken, the value with it.
/// `value_name` names the value in `Args::help` (`FILE`). A `--name` or `-s` that is the last argument,
/// just before `--`, or followed by an argument an earlier declaration took (a flag's `-v`), has no value
/// and is left for `Args::finish` to refuse.
export fn Args::options(ref<Args, exclusive> a, str name, str short, str value_name, str help) : Vec<String>
{
    Args::spec(a, name, short, value_name, help);
    Vec<String> out = Vec::new();
    for (usize i = 0; i < a.end_of_options; i += 1)
    {
        if (a.used[i] || !Args::is_option(a, i, name, short, true))
        {
            continue;
        }
        StringView item = String::as_view(&a.items[i]);
        if (Some(eq) = StringView::find(item, "="))
        {
            if (StringView::starts_with(item, "--"))
            {
                a.used[i] = true;
                Vec::push(&mut out, String::from_view(StringView::sub(item, eq + 1, StringView::len(item))));
                continue;
            }
        }
        // D-0232: an item another declaration took is no value; the option
        // is then left for `finish`, as one given without its value.
        if (i + 1 < Vec::len(&a.items) && i + 1 != a.end_of_options && !a.used[i + 1])
        {
            a.used[i] = true;
            a.used[i + 1] = true;
            Vec::push(&mut out, String::clone(&a.items[i + 1]));
        }
    }
    out
}

// The value of `--name` (the last one given), or `None`.
/// The value of the option `--name` or `-short`, the last one when it is given more than once.
///
/// `None` when it is not given. Takes its arguments as `Args::options` does.
export fn Args::option(ref<Args, exclusive> a, str name, str short, str value_name, str help) : Option<String>
{
    Vec<String> all = Args::options(a, name, short, value_name, help);
    Vec::pop(&mut all)
}

// The arguments that are not options, in order (everything after `--`
// among them); `Err(message)` naming the first argument that looks like
// an option but was not declared, or an option that is missing its
// value, for the program to print.
/// The arguments no declaration took, in order, every argument after `--` among them.
///
/// `Err(message)` for the first argument before `--` that starts with `-` and is not a lone `-`:
/// `unknown option --x`, or `missing a value for --x` for a declared option given without its value. The
/// message is for the program to print, usually followed by `Args::help`.
export fn Args::finish(ref<Args, exclusive> a) : Result<Vec<String>, String>
{
    Vec<String> out = Vec::new();
    for (usize i = 0; i < Vec::len(&a.items); i += 1)
    {
        if (a.used[i])
        {
            continue;
        }
        StringView item = String::as_view(&a.items[i]);
        if (i < a.end_of_options && StringView::len(item) > 1 && StringView::starts_with(item, "-"))
        {
            bool declared = false;
            foreach (s in &a.specs)
            {
                // `-s, --name VALUE`: a declared option given without its
                // value is one of its spec's words (`--ver` is not in
                // `--verbose`'s).
                foreach (w in StringView::split(String::as_view(s), " "))
                {
                    StringView word = if (StringView::ends_with(w, ","))
                    {
                        &w[0 .. StringView::len(w) - 1]
                    }
                    else
                    {
                        w
                    };
                    if (word == item)
                    {
                        declared = true;
                    }
                }
            }
            String m = String::new();
            String::append(&mut m, if (declared) { "missing a value for " } else { "unknown option " });
            String::append(&mut m, item);
            return Err(m);
        }
        Vec::push(&mut out, String::clone(&a.items[i]));
    }
    Ok(out)
}

/// An option nobody declared is refused with a message naming it.
unittest "Args::finish: an undeclared option"
{
    Vec<String> items = Vec::new();
    Vec::push(&mut items, String::from_str("--colour"));
    Args a = Args::from(items, "prog");
    match (Args::finish(&mut a))
    {
        Err(m) : assert(m == "unknown option --colour"),
        Ok(_)  : assert(false),
    }
}

// An argument a flag took is no option's value.
unittest "Args::options: a taken argument is no value"
{
    Vec<String> items = Vec::new();
    Vec::push(&mut items, String::from_str("-o"));
    Vec::push(&mut items, String::from_str("-v"));
    Args a = Args::from(items, "prog");
    assert(Args::flag(&mut a, "verbose", "v", "say more"));
    assert(Option::is_none(&Args::option(&mut a, "out", "o", "FILE", "where")));
    match (Args::finish(&mut a))
    {
        Err(m) : assert(m == "missing a value for -o"),
        Ok(_)  : assert(false),
    }
}

// A prefix of a declared option is not that option.
unittest "Args::finish: a prefix of a declared option"
{
    Vec<String> items = Vec::new();
    Vec::push(&mut items, String::from_str("--ver"));
    Vec::push(&mut items, String::from_str("--out"));
    Args a = Args::from(items, "prog");
    _ = Args::flag(&mut a, "verbose", "v", "say more");
    match (Args::finish(&mut a))
    {
        Err(m) : assert(m == "unknown option --ver"),
        Ok(_)  : assert(false),
    }
}

// The usage line and one line per option declared so far, aligned.
/// The usage line and one aligned line per option declared so far, ready to print.
export fn Args::help(ref<Args, shared> a) : String
{
    String out = String::from_str("Usage: ");
    String::append(&mut out, &a.usage);
    String::append(&mut out, "\n");
    if (Vec::len(&a.specs) == 0)
    {
        return out;
    }
    String::append(&mut out, "\nOptions:\n");
    usize width = 0;
    foreach (s in &a.specs)
    {
        width = max(width, String::len(s));
    }
    for (usize i = 0; i < Vec::len(&a.specs); i += 1)
    {
        String::append(&mut out, "  ");
        String::append(&mut out, &a.specs[i]);
        for (usize k = String::len(&a.specs[i]); k < width + 2; k += 1)
        {
            String::append(&mut out, " ");
        }
        String::append(&mut out, &a.helps[i]);
        String::append(&mut out, "\n");
    }
    out
}

/// Each option gets a line of its spec, padded to the longest spec, and its help.
unittest "Args::help: the layout"
{
    Args a = Args::from(Vec::new(), "prog FILE");
    bool verbose = Args::flag(&mut a, "verbose", "v", "say more");
    Option<String> out = Args::option(&mut a, "out", "", "FILE", "where to write");
    String h = Args::help(&a);
    assert(h == "Usage: prog FILE\n\nOptions:\n"
                "  -v, --verbose   say more\n"
                "      --out FILE  where to write\n");
}
