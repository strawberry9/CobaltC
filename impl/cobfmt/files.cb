// Finding files, keeping backups, writing safely
// (`private/cobfmt-proposal.md` §5, §6).

import std;

// The `.cb` files under `dir`, sorted; hidden directories and `target/`
// skipped.
export fn collect(StringView dir, ref<Vec<String>, exclusive> out)
{
    Vec<String> names = match (list_dir(dir))
    {
        Ok(v)  : v,
        Err(_) : return,
    };
    foreach (name in &names)
    {
        String p = path_join(dir, name);
        bool is_dir = match (path_kind(&p))
        {
            Ok(Dir) : true,
            _       : false,
        };
        if (is_dir)
        {
            if (StringView::starts_with(name, ".") || *name == "target")
            {
                continue;
            }
            collect(&p, out);
        }
        else if (StringView::ends_with(name, ".cb"))
        {
            Vec::push(out, p);
        }
    }
}

export fn exists(StringView p) : bool
{
    Result::is_ok(&path_kind(p))
}

export fn is_dir(StringView p) : bool
{
    match (path_kind(p))
    {
        Ok(Dir) : true,
        _       : false,
    }
}

// `name` in `dir`, or `name` alone when `dir` is empty.
fn in_dir(StringView dir, StringView name) : String
{
    if (StringView::len(dir) == 0)
    {
        return String::copy(name);
    }
    path_join(dir, name)
}

fn dir_of(StringView path) : String
{
    Option::unwrap_or(path_parent(path), String::new())
}

fn name_of(StringView path) : String
{
    Option::unwrap_or(path_file_name(path), String::new())
}

// The first free backup name beside `path`: `NAME.cb.format.bak`, then
// `NAME.cb.format.bak.1`, `.2`, … — an existing one is never overwritten.
export fn backup_name(StringView path) : String
{
    String base = name_of(path);
    String::append(&mut base, ".format.bak");
    String dir = dir_of(path);
    String first = in_dir(&dir, &base);
    if (!exists(&first))
    {
        return first;
    }
    u32 k = 1;
    while (true)
    {
        String p = in_dir(&dir, &sprintf("%s.%v", &base, k));
        if (!exists(&p))
        {
            return p;
        }
        k += 1;
    }
    String::new()
}

// Writes `contents` to a new file at `p` and makes it durable.
fn write_new(File f, StringView contents) : Result<void, FileError>
{
    File::write_text(&mut f, contents)?;
    File::flush(&mut f)?;
    File::close(f)
}

// Writes the backup and makes sure it is on disk before the file changes;
// its name, or why it could not be written.
export fn backup(StringView path, StringView contents) : Result<String, String>
{
    String b = backup_name(path);
    File f = match (File::create_new(&b))
    {
        Ok(Some(f)) : f,
        Ok(None)    : return Err(sprintf("%s exists", &b)),
        Err(e)      : return Err(String::copy(FileError::text(&e))),
    };
    match (write_new(f, contents))
    {
        Ok(_)  : Ok(b),
        Err(e) : Err(String::copy(FileError::text(&e))),
    }
}

// Why `path` may not be rewritten, or None: a read-only file is left as it
// is (it is often so on purpose: vendored or generated code).
export fn not_writable(StringView path) : Option<String>
{
    match (file_info(path))
    {
        Ok(i)  : if (i.readonly) { Some("not writable (read-only); file left as it was") } else { None },
        Err(e) : Some(String::copy(FileError::text(&e))),
    }
}

// Replaces `path`'s contents in place, so the file stays the one it was: a
// symbolic link stays a link and its target is what changes, a file with
// several names (hard links) keeps them all, and its owner and permissions
// are kept. The new contents are first made durable in a temporary file in
// the file's own directory: a run interrupted while the file is rewritten
// leaves them whole there (`.NAME.cobfmt-PID.tmp`), and the temporary file
// is removed once the file holds them. Renaming the temporary file over the
// path, as before, replaced a link with a copy and split hard links.
export fn replace_file(StringView path, StringView contents) : Result<void, String>
{
    // The file itself, a link followed: its directory holds the temporary.
    String real = match (path_canonical(path))
    {
        Ok(r)  : r,
        Err(e) : return Err(String::copy(FileError::text(&e))),
    };
    String d = dir_of(&real);
    String dir = if (StringView::len(&d) == 0) { "." } else { d };
    String name = name_of(&real);
    String tmp = path_join(&dir, &sprintf(".%s.cobfmt-%v.tmp", &name, process_id()));
    File f = match (File::create(&tmp))
    {
        Ok(f)  : f,
        Err(e) : return Err(String::copy(FileError::text(&e))),
    };
    match (write_new(f, contents))
    {
        Ok(_)  : {},
        Err(e) :
        {
            _ = remove_file(&tmp);
            return Err(String::copy(FileError::text(&e)));
        },
    }
    // The file opened for writing from empty: the same file, its contents
    // replaced.
    File g = match (File::create(&real))
    {
        Ok(g)  : g,
        Err(e) :
        {
            _ = remove_file(&tmp);
            return Err(String::copy(FileError::text(&e)));
        },
    };
    match (write_new(g, contents))
    {
        Ok(_)  :
        {
            _ = remove_file(&tmp);
            Ok(())
        },
        Err(e) : Err(sprintf("%s; the formatted text is in %s", FileError::text(&e), &tmp)),
    }
}
