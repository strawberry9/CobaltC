#!/bin/sh
# clang under AddressSanitizer and UBSan, for `cobc --cc` (impl/fuzz/run.py).
# Run what it builds under `setarch -R` where ASLR makes sanitized binaries
# fail at startup (seen with clang 14 on Linux 6.8).
exec clang -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined "$@"
