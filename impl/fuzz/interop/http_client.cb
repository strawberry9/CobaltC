// Interop (WI-7): std::http's client against another server. Usage:
// http_client URL... Fetches each URL with one `HttpClient` (kept alive
// between them) and prints `status bytes` per URL, or `ERR <text>`.
import std;

fn main() : u8
{
    HttpClient c = HttpClient::new();
    u8 failures = 0;
    for (usize i = 0; i < arg_count(); i += 1)
    {
        String url = Result::unwrap(arg(i));
        Request req = Request::new("GET", String::as_view(&url));
        match (HttpClient::send(&mut c, &req))
        {
            Ok(r)  : printf("%v %v\n", r.status, Vec::len(&r.body)),
            Err(e) :
            {
                printf("ERR %v\n", HttpError::text(&e));
                failures += 1;
            },
        }
    }
    failures
}
