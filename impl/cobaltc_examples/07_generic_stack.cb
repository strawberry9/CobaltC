// 07_generic_stack.cb -- A generic Stack<T> built on Vec<T>.
//
// Generic structs and functions are monomorphised per instantiation.
// Functions named `Type::name` are ordinary functions, called with
// the full path (there is no method syntax). Option<T> carries the
// "empty stack" case, and `match` forces the caller to handle it.

import std;

struct Stack<T>
{
    Vec<T> items;
}

fn Stack::new<T>() : Stack<T>
{
    Stack { .items = Vec::new() }
}

fn Stack::push<T>(ref<Stack<T>, exclusive> s, T x)
{
    Vec::push(&mut s.items, x);
}

fn Stack::pop<T>(ref<Stack<T>, exclusive> s) : Option<T>
{
    Vec::pop(&mut s.items)
}

fn Stack::depth<T>(ref<Stack<T>, shared> s) : usize
{
    Vec::len(&s.items)
}

// Evaluate a reverse-Polish expression: each entry is either a
// number to push or an operator to apply to the top two entries.
enum Token
{
    Num(i64),
    Add,
    Mul,
    Sub,
}

fn apply(ref<Stack<i64>, exclusive> st, Token t)
{
    match (t)
    {
        Num(n) : Stack::push(st, n),
        Add :
        {
            i64 b = match (Stack::pop(st)) { Some(v) : v, None : 0 };
            i64 a = match (Stack::pop(st)) { Some(v) : v, None : 0 };
            Stack::push(st, a + b);
        },
        Mul :
        {
            i64 b = match (Stack::pop(st)) { Some(v) : v, None : 0 };
            i64 a = match (Stack::pop(st)) { Some(v) : v, None : 0 };
            Stack::push(st, a * b);
        },
        Sub :
        {
            i64 b = match (Stack::pop(st)) { Some(v) : v, None : 0 };
            i64 a = match (Stack::pop(st)) { Some(v) : v, None : 0 };
            Stack::push(st, a - b);
        },
    }
}

fn main()
{
    // (3 + 4) * (10 - 2) = 56, in reverse Polish: 3 4 + 10 2 - *
    Vec<Token> program = Vec::new();
    Vec::push(&mut program, Num(3));
    Vec::push(&mut program, Num(4));
    Vec::push(&mut program, Add);
    Vec::push(&mut program, Num(10));
    Vec::push(&mut program, Num(2));
    Vec::push(&mut program, Sub);
    Vec::push(&mut program, Mul);

    Stack<i64> st = Stack::new();
    foreach (t in &program)
    {
        apply(&mut st, *t);
    }
    printf("%d\n", Stack::depth(&st));   // 1
    match (Stack::pop(&mut st))
    {
        Some(v) : printf("%d\n", v),           // 56
        None : printf("-1\n"),
    }

    // A stack of a different type, from the same definition.
    Stack<bool> flags = Stack::new();
    Stack::push(&mut flags, true);
    Stack::push(&mut flags, false);
    printf("%d\n", Stack::depth(&flags));   // 2
}
