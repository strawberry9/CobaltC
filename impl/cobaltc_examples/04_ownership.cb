// 04_ownership.cb -- Resources, moves, borrows and deterministic destruction.
//
// A `resource struct` has a destructor (`Type::drop`) that the language
// runs exactly once, when the owner goes out of scope, in reverse
// declaration order (spec/07). Each Tag prints its letter when it is
// destroyed, so the output shows the order the language guarantees.
//
// Expected output, one letter per line:
//   c        <- `inner` block ends: its local is destroyed first
//   b        <- `take` returns: the parameter it was given is destroyed there
//   d        <- main ends: locals go in reverse order, d before a
//   a

import std;

resource struct Tag
{
    str letter;
}

fn Tag::drop(ref<Tag, exclusive> self)
{
    printf("%s\n", self.letter);
}

// Takes ownership: the caller can no longer use the value it passed.
fn take(Tag t)
{
    // t is destroyed here, when this frame ends.
}

// Borrows: the caller keeps ownership and can go on using the value.
fn peek(ref<Tag, shared> t) : str
{
    t.letter
}

fn main()
{
    Tag a = Tag { .letter = "a" };
    Tag b = Tag { .letter = "b" };
    {
        Tag c = Tag { .letter = "c" };
        str seen = peek(&c);          // shared borrow, c still owned here
    }                                // c destroyed: prints "c"
    take(b);                         // b moved into take, destroyed there: prints "b"
    // Vec::len(&b) here would be diag.stale-binding (static): b was moved.
    Tag d = Tag { .letter = "d" };
    str again = peek(&a);
}                                    // d then a destroyed: prints "d", "a"
