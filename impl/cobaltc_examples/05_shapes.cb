// 05_shapes.cb -- Enums with payloads, exhaustive match, floating point.
//
// `match` must cover every variant (spec/16 §4); the first arm's type
// sets the type of the rest. Floats have no implicit conversions, so
// `to_float` and `to_int` are spelled out.

import std;

struct Rect
{
    f64 w;
    f64 h;
}

enum Shape
{
    Circle(f64),
    Square(f64),
    Rectangle(Rect),
}

fn area(ref<Shape, shared> s) : f64
{
    match (*s)
    {
        Circle(r) : 3.14159265 * r * r,
        Square(side) : side * side,
        Rectangle(rc) : rc.w * rc.h,
    }
}

fn main()
{
    Vec<Shape> shapes = Vec::new();
    Vec::push(&mut shapes, Circle(5.0));
    Vec::push(&mut shapes, Square(4.0));
    Vec::push(&mut shapes, Rectangle(Rect { .w = 2.5, .h = 8.0 }));

    f64 total = 0.0;
    foreach (s in &shapes)
    {
        f64 a = area(s);
        printf("%.2f\n", a);        // 78.54, 16.00, 20.00
        total = total + a;
    }
    printf("%.2f\n", total);        // 114.54
}
