// 11_checked_arithmetic.cb -- Overflow is never silent.
//
// Plain `+` on a u8 that would exceed 255 is a fault that terminates
// the program (spec/06). Programs choose what they want instead:
// `checked_*` returns an Option, `wrapping_*` wraps, `saturating_*`
// clamps. `narrow` faults on values outside the target range, and
// `narrow_wrapping` truncates.

import std;

fn print_option(Option<u8> o)
{
    match (o)
    {
        Some(v) : printf("%d\n", v),
        None : printf("none\n"),
    }
}

fn main()
{
    u8 big = 250;

    print_option(checked_add(big, 5));       // 255
    print_option(checked_add(big, 6));       // none
    printf("%d\n", wrapping_add(big, 10));         // 4
    printf("%d\n", saturating_add(big, 10));       // 255
    printf("%d\n", saturating_sub(3: u8, 10));     // 0

    i32 wide = 300;
    printf("%d\n", narrow_wrapping<u8>(wide));     // 44

    match (checked_mul(16: u8, 16))
    {
        Some(v) : printf("%d\n", v),
        None : printf("0\n"),                      // 0: 256 does not fit
    }

    // Division checks too: checked_div never faults on zero.
    match (checked_div(7: u8, 0))
    {
        Some(v) : printf("%d\n", v),
        None : printf("255\n"),                    // 255
    }

    // The last line would be a dynamic fault, diag.arith-overflow,
    // and the program would stop here with a diagnostic. Uncomment to see it.
    // u8 boom = big + 10;
}
