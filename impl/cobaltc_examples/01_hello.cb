// 01_hello.cb -- Hello, world.
//
// A string literal is a `str` value (spec/21 §2a) and `printf` is a
// function of `std` that writes its bytes through the `write` extern.
// The trusted call and its `unsafe` block live inside `std`, so this
// program contains neither.

import std;

fn main()
{
    printf("Hello, CobaltC!\n");
}
