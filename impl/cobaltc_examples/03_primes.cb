// 03_primes.cb -- Sieve of Eratosthenes, printing the primes below 100.
//
// A Vec<bool> is the sieve, made with `Vec::filled`. `composite[m] = true`
// writes one slot through an exclusive borrow of the Vec that lasts only
// for that statement, so the next iteration may borrow again (spec/08,
// sequential borrows); every index is bounds-checked.

import std;

fn sieve(usize limit) : Vec<bool>
{
    Vec<bool> composite = Vec::filled(limit, false);
    usize p = 2;
    while (p * p < limit)
    {
        if (!composite[p])
        {
            for (usize m = p * p; m < limit; m += p)
            {
                composite[m] = true;
            }
        }
        p += 1;
    }
    composite
}

fn main()
{
    usize limit = 100;
    auto composite = sieve(limit);
    usize count = 0;
    foreach (n in 2..limit)
    {
        if (!composite[n])
        {
            printf("%d ", n);
            count += 1;
        }
    }
    printf("\n%d\n", count);         // 25 primes below 100
}
