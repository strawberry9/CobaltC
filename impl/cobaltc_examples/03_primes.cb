// 03_primes.cb -- Sieve of Eratosthenes, printing the primes below 100.
//
// A Vec<bool> is the sieve. Vec::index_exclusive hands back an
// exclusive reference to one slot, and writing through it is an
// ordinary `*r = v`. The borrow lasts only for that statement, so the
// next iteration may borrow again (spec/08, sequential borrows).

import std;

fn sieve(usize limit) : Vec<bool>
{
    Vec<bool> composite = Vec::new();
    usize i = 0;
    while (i < limit)
    {
        Vec::push(&mut composite, false);
        i = i + 1;
    }
    usize p = 2;
    while (p * p < limit)
    {
        if (!*Vec::index_shared(&composite, p))
        {
            usize m = p * p;
            while (m < limit)
            {
                *Vec::index_exclusive(&mut composite, m) = true;
                m = m + p;
            }
        }
        p = p + 1;
    }
    composite
}

fn main()
{
    usize limit = 100;
    auto composite = sieve(limit);
    usize n = 2;
    usize count = 0;
    while (n < limit)
    {
        if (!*Vec::index_shared(&composite, n))
        {
            printf("%d ", n);
            count = count + 1;
        }
        n = n + 1;
    }
    printf("\n%d\n", count);         // 25 primes below 100
}
