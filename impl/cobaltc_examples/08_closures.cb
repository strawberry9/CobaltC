// 08_closures.cb -- Closures, captures, and functions as values.
//
// A closure lists what it captures. `[x]` borrows x; `move [v]` moves
// v into the closure, after which the original name is stale. Named
// functions are values too, with type `fn(args) : ret`, so higher-
// order helpers like `map_in_place` take either.

import std;

fn print_vec(ref<Vec<i64>, shared> v)
{
    foreach (x in v)
    {
        printf("%d ", x);
    }
    printf("\n");
}

fn map_in_place(ref<Vec<i64>, exclusive> v, fn(i64) : i64 f)
{
    foreach (slot in v)
    {
        *slot = f(*slot);
    }
}

fn fold(ref<Vec<i64>, shared> v, i64 init, fn(i64, i64) : i64 f) : i64
{
    i64 acc = init;
    foreach (x in v)
    {
        acc = f(acc, *x);
    }
    acc
}

fn square(i64 x) : i64
{
    x * x
}

fn add(i64 a, i64 b) : i64
{
    a + b
}

fn main()
{
    Vec<i64> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    Vec::push(&mut v, 3);
    Vec::push(&mut v, 4);
    print_vec(&v);                              // 1 2 3 4

    // A named function as a value.
    map_in_place(&mut v, square);
    print_vec(&v);                              // 1 4 9 16

    // A closure borrowing a local.
    i64 offset = 100;
    auto shift = [offset](i64 x)
    {
        x + offset
    };
    map_in_place(&mut v, shift);
    print_vec(&v);                              // 101 104 109 116

    i64 total = fold(&v, 0, add);
    printf("%d\n", total);                      // 430

    // A move closure owns its capture; the closure's field is the
    // only place the Vec now lives, and it is destroyed with the closure.
    auto count = move [v]()
    {
        Vec::len(&v)
    };
    usize n = count();
    printf("%d\n", n);                          // 4
    // print_vec(&v) here would be diag.stale-binding (static): v was moved.
}
