// 13_geometry.cb -- Not a program: the body of the `geo` module that
// 13_modules.cb declares with `module geo "./13_geometry.cb";`
// (spec/17 §5). Its top level is anonymous; the declaring file names
// it. Only `export` items are visible from there.

export struct Rect
{
    export f64 w;                    // field visibility is per field: 13_modules.cb builds a Rect
    export f64 h;
}

export fn area(Rect r) : f64
{
    r.w * r.h
}

export fn perimeter(Rect r) : f64
{
    2.0 * (r.w + r.h)
}

fn unused_private() : f64        // invisible to 13_modules.cb
{
    0.0
}
