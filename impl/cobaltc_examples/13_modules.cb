// 13_modules.cb -- A program spanning two files. `module geo "…";` is
// the inline `module geo { … }` with 13_geometry.cb's items as the
// body (spec/17 §5, rule.module.file); `import` then works across the
// boundary exactly as it does within one file. Run this file, not the
// other: `coby 13_modules.cb`.

import std;

module geo "./13_geometry.cb";

import geo::Rect;

fn main()
{
    Rect r = Rect { .w = 3.0, .h = 4.0 };
    printf("%.0f\n", geo::area(r));      // 12
    printf("%.0f\n", geo::perimeter(r)); // 14
    // printf("%.0f\n", geo::unused_private());   // diag.name-not-visible: not export
}
