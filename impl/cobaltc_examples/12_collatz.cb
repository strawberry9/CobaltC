// 12_collatz.cb -- Longest Collatz chain under 10000, with a memo table.
//
// A Vec<u32> memoises chain lengths for starting points below the
// limit, so each number is resolved once. Values can climb above the
// limit mid-chain; those steps are counted without being cached.

import std;

fn chain_length(u64 start, ref<Vec<u32>, exclusive> memo) : u32
{
    usize limit = Vec::len(&*memo);      // reborrow the exclusive ref as shared
    u64 n = start;
    u32 steps = 0;
    while (n != 1)
    {
        if (n < widen<u64>(limit))
        {
            u32 known = *Vec::index_shared(&*memo, narrow<usize>(n));
            if (known != 0)
            {
                steps = steps + known;
                break;
            }
        }
        n = if (n % 2 == 0)
        {
            n / 2
        }
        else
        {
            3 * n + 1
        };
        steps = steps + 1;
    }
    if (start < widen<u64>(limit))
    {
        *Vec::index_exclusive(memo, narrow<usize>(start)) = steps;
    }
    steps
}

fn main()
{
    usize limit = 10000;
    Vec<u32> memo = Vec::new();
    usize i = 0;
    while (i < limit)
    {
        Vec::push(&mut memo, 0);
        i = i + 1;
    }
    *Vec::index_exclusive(&mut memo, 1) = 0;

    u64 best_start = 1;
    u32 best_len = 0;
    u64 s = 1;
    while (s < widen<u64>(limit))
    {
        u32 len = chain_length(s, &mut memo);
        if (len > best_len)
        {
            best_len = len;
            best_start = s;
        }
        s = s + 1;
    }
    printf("%d\n", best_start);      // 6171
    printf("%d\n", best_len);        // 261
}
