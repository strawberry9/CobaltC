import std;

// Tests beside the code they test (D-0230). `coby 14_unittest.cb` runs
// the program; `coby --unittest 14_unittest.cb` (or `cobc --unittest
// --run`) runs its `unittest` blocks instead, each in a thread of its
// own, and reports each one.

/// The Roman numeral for `n`, from 1 to 3999; `None` outside that range.
fn to_roman(u32 n) : Option<String>
{
    if (n == 0 || n > 3999)
    {
        return None;
    }
    array<u32, 13> values = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1];
    array<str, 13> names = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"];
    String out = String::new();
    u32 left = n;
    foreach (i in 0..13)
    {
        while (left >= values[i])
        {
            String::append(&mut out, StringView::of(names[i]));
            left -= values[i];
        }
    }
    Some(out)
}

/// The numerals for a few numbers, each digit's forms among them.
unittest "to_roman: digits"
{
    assert(Option::unwrap(to_roman(1)) == "I");
    assert(Option::unwrap(to_roman(4)) == "IV");
    assert(Option::unwrap(to_roman(9)) == "IX");
    assert(Option::unwrap(to_roman(14)) == "XIV");
    assert(Option::unwrap(to_roman(1994)) == "MCMXCIV");
    assert(Option::unwrap(to_roman(3999)) == "MMMCMXCIX");
}

unittest "to_roman: out of range"
{
    assert(Option::is_none(&to_roman(0)));
    assert(Option::is_none(&to_roman(4000)));
}

// A test sees the module's private items, and may loop like any code.
unittest "to_roman: below 1000, at most 12 letters"
{
    foreach (n in 1..1000)
    {
        String r = Option::unwrap(to_roman(narrow<u32>(n)));
        assert(String::len(&r) <= 12, "%v is %v", n, &r);
    }
}

fn main()
{
    printf("%v\n", &Option::unwrap(to_roman(2026)));
}
