// 02_fizzbuzz.cb -- FizzBuzz from 1 to 30.
//
// Shows `foreach` over a range, `if`/`else if`, the `%` operator, and
// `printf` for both the fixed words and the numbers.

import std;

fn main()
{
    foreach (i in 1..31)                  // 1 to 30: the upper bound is left out
    {
        if (i % 15 == 0)
        {
            printf("FizzBuzz\n");
        }
        else if (i % 3 == 0)
        {
            printf("Fizz\n");
        }
        else if (i % 5 == 0)
        {
            printf("Buzz\n");
        }
        else
        {
            printf("%d\n", i);
        }
    }
}
