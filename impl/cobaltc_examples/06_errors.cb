// 06_errors.cb -- Result, the `?` operator, and map_err.
//
// Parsing a decimal number from bytes can fail in two ways. Each
// failure is a variant of ParseError; `?` returns the Err straight out
// of the enclosing function (spec/18), so the happy path reads like
// straight-line code. map_err converts one error type into another
// at the boundary between layers.

import std;

enum ParseError
{
    Empty,
    BadDigit(u8),
}

fn digit(u8 b) : Result<u32, ParseError>
{
    if (b < 48 || b > 57)
    {
        return Err(BadDigit(b));
    }
    Ok(widen<u32>(b - 48))
}

fn parse_u32(ref<Vec<u8>, shared> text) : Result<u32, ParseError>
{
    if (Vec::len(text) == 0)
    {
        return Err(Empty);
    }
    u32 acc = 0;
    foreach (b in text)
    {
        u32 d = digit(*b)?;
        acc = acc * 10 + d;
    }
    Ok(acc)
}

// The outer layer only cares about an error code.
fn code(ParseError e) : i32
{
    match (e)
    {
        Empty : 1,
        BadDigit(_) : 2,
    }
}

fn parse_or_code(ref<Vec<u8>, shared> text) : Result<u32, i32>
{
    map_err(parse_u32(text), code)
}

fn report(ref<Vec<u8>, shared> text)
{
    match (parse_or_code(text))
    {
        Ok(v) :
        {
            printf("ok %d\n", v);
        },
        Err(c) :
        {
            printf("err %d\n", c);
        },
    }
}

fn main()
{
    Vec<u8> good = Vec::new();
    Vec::push(&mut good, 52);        // "4"
    Vec::push(&mut good, 50);        // "2"
    report(&good);                   // ok 42

    Vec<u8> bad = Vec::new();
    Vec::push(&mut bad, 52);
    Vec::push(&mut bad, 120);        // "4x"
    report(&bad);                    // err 2

    Vec<u8> empty = Vec::new();
    report(&empty);                  // err 1
}
