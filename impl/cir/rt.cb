// Protocol CIR (step T4, stage C): the runtime-entry table. One row for each
// `cb_…` name the lowering writes in its C or a pass asks about, in the order
// of the names' bytes; a row's id is its place in that order from 1 (0: no
// runtime entry), and its properties are what the passes ask today by name
// lists and string tests, one bit each. A call node carries its callee's id
// (`PNode::rt`): set by the constructor that built it, or looked up by
// `classify` (`rt_lookup`).
//
// Written by `impl/cir/tools/gen_rt.py` from `passes.cb`'s lists, `gen.cb`'s
// `quiet_cells` and the lowering's string literals: change those, then run
// it again (the passes' name sets are made of the same lists).

import std;

// The entry records nothing in a scope or a frame (`passes::FREE_NAMES`).
export const u32 RP_FREE = 1;
// The entry records in the innermost statement scope (`passes::SCOPE_NAMES`).
export const u32 RP_SCOPE = 2;
// The entry records nothing in a decided program (`passes::DECIDED_FREE_NAMES`).
export const u32 RP_DECIDED_FREE = 4;
// The entry is a check that goes when its token is known 0 (`passes::ZERO_DROP`).
export const u32 RP_ZERO_DROP = 8;
// The entry leaves what `elide_implied_checks_nodes` knows as it is (`passes::IMPLIED_PURE`).
export const u32 RP_IMPLIED_PURE = 16;
// The entry cannot call back into the program (`passes::LEAF_NAMES`).
export const u32 RP_LEAF = 32;
// The entry reads no location (`passes::LOCATION_PURE`).
export const u32 RP_LOC_PURE = 64;
// The entry carries its own location as its last arguments (`passes::reads_location`).
export const u32 RP_OWN_LOC = 128;
// The entry binds into, stamps or ends something in a frame (`passes::FRAME_USE_NAMES`).
export const u32 RP_FRAME_USE = 256;
// The entry can put an object over raw cells or start a thread (`gen::quiet_cells`).
export const u32 RP_MAKER = 512;
// The entry is an element's borrow, a maker where paths are kept (`gen::quiet_cells`).
export const u32 RP_MAKER_KEPT = 1024;
// The entry is a path check: `cb_read`, `cb_borrow_unminted`, `cb_borrow_check`.
export const u32 RP_PATH_CHECK = 2048;
// The entry is a frame's push or pop as `elide_empty_frames_nodes` takes it out.
export const u32 RP_FRAME_LINE = 4096;
// The entry is a push or pop `resolve_scopes_nodes` writes for a scope marker.
export const u32 RP_SCOPE_LINE = 8192;
// The entry puts a value in flight or takes one (`pprog::ground_native_nodes`).
export const u32 RP_FLIGHT = 16384;

// No runtime entry.
export const u16 RT_NONE = 0;
export const u16 RT_ABSORB = 1;
export const u16 RT_ABSORB_REFS = 2;
export const u16 RT_ALLOCATE = 3;
