// CONFORMANCE-CASE
// facility: conf.mutex-shared-across-threads
// kind: positive
// expect: ok

import std;
fn inc(ref<mutex<i32>, shared> m)
{
    auto g = lock(m);
    *g = *g + 1;
}
fn main()
{
    if (!({ auto m = Mutex::new(0); auto h = spawn(inc, &m); { auto g = lock(&m); *g = *g + 1; } join(h); *lock(&m) == 2 }))
    {
        1 /(1 - 1);
    }
}
