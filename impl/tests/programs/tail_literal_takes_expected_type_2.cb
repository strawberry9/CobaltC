// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// Previously pinned as a known limitation for the implicit tail.

import std;
fn k(Option<i32> o) : i64
{
    match (o) { Some(_) : 8000000000, None : 9000000000, }
}
fn main()
{
    if (!({ i64 b = { 10000000000 }; k(None) == 9000000000 && b == 10000000000 }))
    {
        1 /(1 - 1);
    }
}
