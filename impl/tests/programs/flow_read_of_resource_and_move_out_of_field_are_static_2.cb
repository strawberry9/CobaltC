// CONFORMANCE-CASE
// facility: conf.read-of-resource-rejected, conf.move-out-of-field-rejected
// kind: negative
// expect: diag.move-out-of-field (static)
// covers: conf.read-of-resource-rejected
// covers: conf.move-out-of-field-rejected

import std;
struct P { Vec<i32> a; }
fn main()
{
    auto p = P { .a = Vec::new() };
    auto q = p.a;
}
