// CONFORMANCE-CASE
// facility: conf.string-append-text
// kind: positive
// expect: ok
//
// CHG-0041: text conversions (`rule.stdlib.text`).

import std;
fn main()
{
    if (!({ String s = String::new(); String::append(&mut s, 42); String::append(&mut s, " "); String::append(&mut s, 2.5); StringView::len(&s) == 6 }))
    {
        1 /(1 - 1);
    }
}
