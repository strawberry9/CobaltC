// CONFORMANCE-CASE
// facility: conf.slice-swap-sort-strings
// kind: positive
// expect: ok

import std;
fn sort(slice<String, exclusive> s)
{
    for (usize i = 1; i < slice_len(s); i += 1) { usize j = i; while (j > 0 && StringView::len(&s[j - 1]) > StringView::len(&s[j])) { slice_swap(s, j - 1, j); j -= 1; } }
}
fn main()
{
    if (!({ Vec<String> v = Vec::new(); Vec::push(&mut v, String::copy("ccc")); Vec::push(&mut v, String::copy("a")); Vec::push(&mut v, String::copy("bb")); sort(&mut v[0..$]); StringView::len(&v[0]) == 1 && StringView::len(&v[2]) == 3 }))
    {
        assert(false);
    }
}
