// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// Still allowed: a nested block, a closure's parameter, an `if`-pattern's
// binder in an inner block, sibling regions.

import std;
fn main()
{
    if (!({ Option<i32> o = Some(1); i32 v = 7; if (Some(v) = o) { { i32 v = 9; } } v == 7 }))
    {
        assert(false);
    }
}
