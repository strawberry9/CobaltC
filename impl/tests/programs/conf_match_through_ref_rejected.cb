// CONFORMANCE-CASE
// facility: conf.match-through-ref-rejected
// kind: negative
// expect: diag.move-out-of-field (static)
//
// [Match-Move-Through-Ref]: a resource payload cannot be bound
// through a reference or a projection.
// Payload-less and `_` arms may inspect a resource enum through a reference.

import std;
enum E { Has(Vec<i32>), Empty }
fn f(ref<E, shared> e) : usize
{
    match (*e) { Has(x) : Vec::len(&x), Empty : 0, }
}
fn main()
{
    auto e = E::Has(Vec::new());
    f(&e);
}
