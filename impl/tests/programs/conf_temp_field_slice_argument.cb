// CONFORMANCE-CASE
// facility: conf.temp-field-slice-argument
// kind: positive
// expect: ok

import std;
struct T { Vec<i32> v; }
fn t() : T
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 7);
    Vec::push(&mut v, 8);
    T { .v = v }
}
fn sum(slice<i32, shared> s) : i32
{
    s[0] + s[1]
}
fn main()
{
    if (!(sum(&t().v[0..2]) == 15))
    {
        assert(false);
    }
}
