// CONFORMANCE-CASE
// facility: conf.queue-empty
// kind: positive
// expect: ok
//
// D-0137: `Queue` and `PriorityQueue`.

import std;
fn main()
{
    if (!({ Queue<i32> q = Queue::new(); Queue::len(&q) == 0 && Option::is_none(&Queue::pop_front(&mut q)) && Option::is_none(&Queue::pop_back(&mut q)) && Option::is_none(&Queue::front(&q)) }))
    {
        1 /(1 - 1);
    }
}
