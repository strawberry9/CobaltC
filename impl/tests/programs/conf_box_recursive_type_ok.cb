// CONFORMANCE-CASE
// facility: conf.box-recursive-type-ok
// kind: positive
// expect: ok

import std;
struct Node { i32 v; Option<Box<Node>> next; }
fn main()
{
    if (!({ Option<Box<Node>> l = None; l = Some(Box::new(Node { .v = 1, .next = l })); l = Some(Box::new(Node { .v = 2, .next = l })); match (l) { Some(b) : Box::get(&b).v == 2, None : false } }))
    {
        1 /(1 - 1);
    }
}
