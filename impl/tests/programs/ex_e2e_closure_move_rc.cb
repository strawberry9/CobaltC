// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// → `conf.e2e-closure-move-rc`.

import std;
fn main()
{
    Vec<i32> payload = Vec::new();
    Vec::push(&mut payload, 7);
    auto a = Rc::new(payload);
    auto f = move [a]() { Vec::len(Rc::get(&a)) };
    usize x = f();
    usize y = f();
    if (x != 1) { assert(false); }
    if (y != 1) { assert(false); }
    drop(f);
}
