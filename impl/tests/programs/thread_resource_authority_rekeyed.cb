// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// Top-level statements only (a `join` nested inside an expression
// tree cannot be resumed by the current blocking mechanism).

import std;
fn make() : Vec<i32>
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 5);
    v
}
fn takes(Vec<i32> v) : usize
{
    Vec::len(&v)
}
fn main()
{
    auto h1 = spawn(make);
    auto v1 = join(h1);
    usize n = Vec::len(&v1);
    drop(v1);
    Vec<i32> w = Vec::new();
    Vec::push(&mut w, 3);
    auto h2 = spawn(takes, w);
    usize m = join(h2);
    if (n + m != 2) { 1 /(1 - 1); }
}
