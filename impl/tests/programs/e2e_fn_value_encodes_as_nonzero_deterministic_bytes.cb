// CONFORMANCE-CASE
// kind: positive
// expect: ok
// expect-stdout-hex: 07000000
//
// The test asserted the fn value's 8 bytes are not all zero, the tag's 4
// bytes after them, and that two runs wrote the same bytes; the program
// checks the first itself and writes the tag's bytes. Not carried over: the
// same bytes in two runs.
//
// A `fn` value once had no byte encoding; a struct field holding a
// named `fn` value silently encoded as all zeros, which would make every
// distinct function compare equal if ever compared through a raw
// byte view -- [Repr-Fn] (spec/06 sec 4) requires an injective
// image. This checks only that the
// bytes are real (not all zero);
// the test also ran twice to confirm they
// were not randomized per process.

import std;
fn double(i32 x) : i32
{
    x * 2
}
struct Holder { fn(i32) : i32 cb; i32 tag; }
fn main()
{
    Holder h = Holder { .cb = double, .tag = 7 };
    rawptr<u8> p = reinterpret_ptr<u8>(rawptr_of(&h));
    usize len = sizeof<Holder>();
    u8 any = 0;
    unsafe { usize i = 0; while (i < 8) { any = any | *(p + i); i = i + 1; } } if (any == 0) { 1 /(1 - 1); } isize n = unsafe { stdout_write(p + 8, 4) };
}
