// CONFORMANCE-CASE
// facility: conf.string-truncate, conf.string-truncate-inside-character
// kind: negative
// expect: diag.not-char-boundary (dynamic)
// covers: conf.string-truncate-inside-character

import std;
fn main()
{
    String t = String::copy("héllo");
    String::truncate(&mut t, 2);
}
