// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// u128's true range is [0, 2^128-1]. An earlier implementation
// held every integer in a signed 128-bit value, and a u128 above
// 2^127-1 did not fit; the upper half
// is representable, and this test used to pin the old
// limitation (a legal literal rejected as out of range).

import std;
fn main()
{
    if (!({ u128 big = 340282366920938463463374607431768211455; u128 half = 170141183460469231731687303715884105728; big > half && half + (half - 1) == big && big / half == 1 && wrapping_add(big, 1: u128) == 0 && saturating_add(big, 5: u128) == big && narrow<u64>(half >> 64) == 9223372036854775808 }))
    {
        1 /(1 - 1);
    }
}
