// CONFORMANCE-CASE
// facility: conf.vec-swap
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ Vec<String> v = Vec::new(); Vec::push(&mut v, String::copy("a")); Vec::push(&mut v, String::copy("bb")); Vec::swap(&mut v, 0, 1); Vec::swap(&mut v, 1, 1); StringView::len(&v[0]) == 2 }))
    {
        assert(false);
    }
}
