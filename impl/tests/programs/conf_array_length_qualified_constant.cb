// CONFORMANCE-CASE
// facility: conf.array-length-qualified-constant
// kind: positive
// expect: ok
//
// D-0105: a module's exported constant as an array length.

import std;
module geom { export const usize DIM = 3; }
fn main()
{
    if (!({ array<i32, geom::DIM> a = [7; geom::DIM]; a[2] == 7 }))
    {
        assert(false);
    }
}
