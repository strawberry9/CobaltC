// CONFORMANCE-CASE
// facility: conf.temp-field-borrow-argument
// kind: positive
// expect: ok
//
// D-0103: parts of temporaries.

import std;
struct T { String name; } fn t() : T
{
    T { .name = String::copy("hello") }
}
fn main()
{
    if (!(StringView::len(&t().name) == 5))
    {
        1 /(1 - 1);
    }
}
