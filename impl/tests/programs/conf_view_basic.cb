// CONFORMANCE-CASE
// facility: conf.view-basic
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ String line = "  hello, world  "; StringView w = &line[2..7]; StringView r = &w[1..$]; StringView::len(w) == 5 && StringView::len(r) == 4 && StringView::len(&line[0..$]) == 16 }))
    {
        1 /(1 - 1);
    }
}
