// CONFORMANCE-CASE
// facility: conf.temp-borrow-escape-stale
// kind: negative
// expect: diag.destroy-while-aliased (static)
//
// D-0282: a reference into a temporary kept past its statement is
// refuted before the run, as D-0135 names it.

import std;
fn first(ref<Vec<i32>, shared> v) : Option<ref<i32, shared>> { if (Vec::len(v) == 0) { None } else { Some(Vec::index_shared(v, 0)) } } fn make() : Vec<i32>
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 42);
    v
}
fn main()
{
    Option<ref<i32, shared>> o = first(&make());
    match (o) { Some(r) : { i32 k = *r; }, None : {}, }
}
