// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// conf.elision-single-param-ok and friends: the exempted shapes.

import std;
fn id(ref<i32, shared> p) : ref<i32, shared> { p }
fn main()
{
    if (!({ i32 x = 1; auto y = id(&x); { i32 z = 2; auto y2 = &*y; if (*y2 + z != 3) { assert(false); } } * y == 1 }))
    {
        assert(false);
    }
}
