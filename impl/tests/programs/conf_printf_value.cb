// CONFORMANCE-CASE
// facility: conf.printf-value
// kind: positive
// expect: ok
//
// CHG-0047 (D-0039): printf is the one way to write output.

import std;
fn main()
{
    if (!({ String s = sprintf("%v|%-3v|%3v|%v", 0.1, 7, "ab", false); StringView::len(&s) == 17 }))
    {
        1 /(1 - 1);
    }
}
