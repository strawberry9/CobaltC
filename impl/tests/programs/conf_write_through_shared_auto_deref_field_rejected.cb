// CONFORMANCE-CASE
// kind: negative
// expect: diag.write-through-shared (static)
//
// `r.field = v` -- auto-deref field write, no explicit `*` at all.

import std;
struct Pt { i32 x; }
fn tamper(ref<Pt, shared> r) : i32
{
    r.x = 99;
    r.x
}
fn main()
{
    Pt p = Pt { .x = 5 };
    tamper(&p);
    if (p.x != 99) { 1 /(1 - 1); }
}
