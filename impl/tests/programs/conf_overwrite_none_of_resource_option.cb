// CONFORMANCE-CASE
// facility: conf.overwrite-none-of-resource-option
// kind: positive
// expect: ok

import std;
fn fill(ref<Option<String>, exclusive> o)
{
    *o = Some(String::copy("ab"));
}
fn main()
{
    if (!({ Option<String> o = None; fill(&mut o); Option<String> p = None; p = Some(String::copy("c")); match (&o) { Some(s) : StringView::len(s) == 2, None : false } }))
    {
        assert(false);
    }
}
