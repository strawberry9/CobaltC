// CONFORMANCE-CASE
// facility: conf.elision-conflict-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)

import std;
struct Pair { i32 a; i32 b; } fn first(ref<Pair, shared> p) : ref<i32, shared> { &p.a } fn main()
{
    auto pr = Pair { .a = 1, .b = 2 };
    auto y = first(&pr);
    pr.a = 3;
    i32 v = *y;
}
