// CONFORMANCE-CASE
// facility: conf.string-append-self-conflict
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// D-0284: a borrow given to `append`'s type parameter is a reference
// argument, so the pair is refuted before the run.

import std;
fn main()
{
    String s = "a";
    String::append(&mut s, &s);
}
