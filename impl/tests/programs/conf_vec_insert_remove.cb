// CONFORMANCE-CASE
// facility: conf.vec-insert-remove
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ Vec<i32> v = Vec::new(); Vec::push(&mut v, 1); Vec::push(&mut v, 3); Vec::insert(&mut v, 1, 2); Vec::insert(&mut v, 0, 0); i32 r = Vec::remove(&mut v, 3); r * 10 + v[2] == 32 }))
    {
        assert(false);
    }
}
