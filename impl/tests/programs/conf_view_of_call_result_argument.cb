// CONFORMANCE-CASE
// facility: conf.view-of-call-result-argument
// kind: positive
// expect: ok
//
// D-0135: a `String` a call returns, viewed as an argument.

import std;
fn w() : String
{
    String::copy("abc")
}
fn main()
{
    if (!(StringView::len(&w()[0..$]) == 3 && StringView::find(&String::copy("xabc"), &w()[1..$]) == Some(2)))
    {
        1 /(1 - 1);
    }
}
