// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// conf.elision-single-param-ok and friends: the exempted shapes.

import std;
struct Pair { i32 a; i32 b; }
fn first(ref<Pair, shared> p) : ref<i32, shared> { &p.a }
fn main()
{
    if (!({ Pair pr = Pair { .a = 1, .b = 2 }; auto y = first(&pr); *y == 1 }))
    {
        assert(false);
    }
}
