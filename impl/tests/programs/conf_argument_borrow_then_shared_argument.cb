// CONFORMANCE-CASE
// facility: conf.argument-borrow-then-shared-argument
// kind: positive
// expect: ok
//
// D-0107: an argument's borrow is pending until bound.

import std;
fn put(ref<i32, exclusive> p, i32 v)
{
    *p = v;
}
fn read(ref<i32, shared> r) : i32
{
    *r
}
fn main()
{
    if (!({ i32 x = 1; put(&mut x, read(&x) + 1); x == 2 }))
    {
        1 /(1 - 1);
    }
}
