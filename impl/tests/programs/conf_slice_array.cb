// CONFORMANCE-CASE
// facility: conf.slice-array
// kind: positive
// expect: ok
//
// CHG-0055 (D-0047): slices, `$`, indexing a Vec.

import std;
fn main()
{
    if (!({ auto a = [10, 20, 30, 40, 50]; auto s = &a[1..4]; slice_len(s) == 3 && s[0] == 20 && s[2] == 40 }))
    {
        1 /(1 - 1);
    }
}
