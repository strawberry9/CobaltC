// CONFORMANCE-CASE
// facility: conf.string-less-sort, conf.view-ordering
// kind: positive
// expect: ok
// covers: conf.view-ordering
//
// D-0076: text order and truncation.
// D-0312 `[Cmp-Text]`: two texts of different types are ordered by their bytes too.

import std;
fn main()
{
    if (!({ Vec<String> v = Vec::new(); Vec::push(&mut v, String::copy("pear")); Vec::push(&mut v, String::copy("app")); Vec::push(&mut v, String::copy("apple")); Vec::sort_by(&mut v, [](ref<String, shared> a, ref<String, shared> b) { *a < *b }); v[0] == "app" && v[2] == "pear" }))
    {
        assert(false);
    }
}
