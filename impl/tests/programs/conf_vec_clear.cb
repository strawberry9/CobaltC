// CONFORMANCE-CASE
// facility: conf.vec-clear
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ Vec<String> v = Vec::new(); Vec::push(&mut v, String::copy("a")); Vec::clear(&mut v); Vec::push(&mut v, String::copy("b")); Vec::len(&v) == 1 }))
    {
        assert(false);
    }
}
