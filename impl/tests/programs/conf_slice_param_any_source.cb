import std;
fn sum(slice<i32, shared> s) : i32
{
    i32 t = 0;
    foreach (x in s) { t += *x; } t
}
fn main()
{
    if (!({ auto a = [1, 2, 3]; Vec<i32> v = Vec::new(); Vec::push(&mut v, 10); sum(&a[0..$]) + sum(&v[0..$]) == 16 }))
    {
        1 /(1 - 1);
    }
}
