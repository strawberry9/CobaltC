// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// ---------- Borrow-capture closures: captured names resolve *through*
// the capture reference (spec/15 [Closure-Call]: `x_i` means
// `*self.f_i`). The captured name used to be an alias of the
// referent itself, so the body's own write to an exclusively
// captured variable found the closure's capture reference as a live
// non-ancestor exclusive path and was rejected. The name now reaches
// the referent through the capture reference, which is the
// access's ancestor.

import std;
fn main()
{
    if (!({ Vec<i32> v = Vec::new(); { auto p = [v](i32 x) { Vec::push(&mut v, x); }; p(1); p(2); } Vec::len(&v) == 2 }))
    {
        1 /(1 - 1);
    }
}
