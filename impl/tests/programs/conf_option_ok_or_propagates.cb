// CONFORMANCE-CASE
// facility: conf.option-ok-or-propagates
// kind: positive
// expect: ok

import std;
fn twice(Option<i32> o) : Result<i32, str> { i32 v = Option::ok_or(o, "none")?; Ok(v * 2) }
fn main()
{
    if (!(Result::unwrap_or(twice(Some(4)), 0) + match (twice(None)) { Ok(_) : 0, Err(e) : narrow<i32>(str_len(e)), } == 12))
    {
        assert(false);
    }
}
