// CONFORMANCE-CASE
// facility: conf.temp-borrow-binding-rejected
// kind: negative
// expect: diag.borrow-of-non-place (static)
//
// An argument of a call that returns a reference could carry it out.

import std;
fn make() : Vec<i32>
{
    Vec::new()
}
fn main()
{
    usize n = Vec::len(Vec::index_shared(&make(), 0));
}
