// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// ---------- Blocking at any depth: join/lock/handle sweeps
// wait in place, so a wait nested inside a helper call or inside an
// expression works, an unjoined handle's sweep really waits, and
// threads interleave.

import std;
fn work(i32 n) : i32
{
    n * 2
}
fn helper() : i32
{
    i32 before = 1;
    auto h = spawn(work, 21);
    i32 r = join(h);
    before + r
}
fn main()
{
    if (!({ auto h = spawn(work, 5); helper() + helper() + join(h) == 96 }))
    {
        assert(false);
    }
}
