// CONFORMANCE-CASE
// facility: conf.read-file-not-found
// kind: positive
// expect: ok
//
// CHG-0043: files (`rule.stdlib.file`); the round trip is a file case.

import std;
fn main()
{
    if (!({ String p = "/nonexistent-cobaltc-dir/x.txt"; bool nf = match (read_file(&p[0..$])) { Ok(_) : false, Err(e) : match (e) { NotFound : true, _ : false } }; nf }))
    {
        assert(false);
    }
}
