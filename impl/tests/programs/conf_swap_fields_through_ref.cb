// CONFORMANCE-CASE
// facility: conf.swap-fields-through-ref
// kind: positive
// expect: ok

import std;
struct P { String l; String r; }
fn flip(ref<P, exclusive> p)
{
    swap(&mut p.l, &mut p.r);
}
fn main()
{
    if (!({ P p = P { .l = String::copy("a"), .r = String::copy("bc") }; flip(&mut p); StringView::len(&p.l) == 2 }))
    {
        assert(false);
    }
}
