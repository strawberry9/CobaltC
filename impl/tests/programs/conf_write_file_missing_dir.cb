// CONFORMANCE-CASE
// facility: conf.write-file-missing-dir
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ String p = "/nonexistent-cobaltc-dir/x.txt"; String t = "x"; bool nf = match (write_file(&p[0..$], &t[0..$])) { Ok(_) : false, Err(e) : match (e) { NotFound : true, _ : false } }; nf }))
    {
        assert(false);
    }
}
