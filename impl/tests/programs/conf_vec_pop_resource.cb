// CONFORMANCE-CASE
// facility: conf.vec-pop-resource
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ Vec<Vec<i32>> v = Vec::new(); Vec::push(&mut v, Vec::new()); match (Vec::pop(&mut v)) { Some(inner) : Vec::len(&inner) == 0, None : false, } }))
    {
        1 /(1 - 1);
    }
}
