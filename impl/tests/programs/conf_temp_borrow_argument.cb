// CONFORMANCE-CASE
// facility: conf.temp-borrow-argument
// kind: positive
// expect: ok
//
// D-0073 / CHG-0086.

import std;
fn total(ref<Vec<i32>, shared> v) : usize
{
    Vec::len(v)
}
fn make() : Vec<i32>
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    v
}
fn main()
{
    if (!({ total(&make()) == 1 }))
    {
        assert(false);
    }
}
