// CONFORMANCE-CASE
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// Previously failed for the same reason as `ex_e2e_vec_realloc_stale_ref`
// (the `clash` scan's ancestor exemption was transient, not
// persistent) -- fixed by recording each reference's ancestors.
// → `conf.e2e-vec-pop-push-reuse-stale-ref` (closes finding F-05,
// `CHG-0019`: `Vec::pop` releases its slot for every element type,
// so the reused slot's hazard is caught dynamically, never silent).
// D-0282: kept in a struct a call makes (D-0290: what it holds is `?`),
// as the frame-held form is refuted before the run.

import std;
fn hazard(ref<Vec<i32>, exclusive> v) : i32
{
    auto r = Vec::index_shared(&*v, 2);
    Vec::pop(v);
    *r
}
fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 10);
    hazard(&mut v);
}
