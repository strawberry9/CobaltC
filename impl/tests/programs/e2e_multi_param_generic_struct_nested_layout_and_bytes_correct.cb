// CONFORMANCE-CASE
// kind: positive
// expect: ok
// expect-stdout-hex: 010000000200000003000000

import std;
struct Pair<A, B> { A a; B b; }
fn main()
{
    Pair<i32, Pair<i32, i32>> p = Pair { .a = 1, .b = Pair { .a = 2, .b = 3 } };
    usize sz = sizeof<Pair<i32, Pair<i32, i32>>>();
    rawptr<u8> rp = reinterpret_ptr<u8>(rawptr_of(&p));
    isize n = unsafe { stdout_write(rp, sz) };
}
