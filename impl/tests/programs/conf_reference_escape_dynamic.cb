// CONFORMANCE-CASE
// facility: conf.reference-escape-dynamic
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// The store goes through `*h`, invisible to the static rule; the
// dead reference faults at use.

import std;
struct H { ref<i32, shared> r; } fn f(ref<H, exclusive> h)
{
    i32 x = 1;
    h.r = &x;
}
fn main()
{
    i32 y = 0;
    auto hh = H { .r = &y };
    f(&mut hh);
    i32 z = *hh.r;
}
