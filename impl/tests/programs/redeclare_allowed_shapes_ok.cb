// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// Still allowed: a nested block, a closure's parameter, an `if`-pattern's
// binder in an inner block, sibling regions.

import std;
fn main()
{
    if (!({ i32 x = 1; { i32 x = 2; } { i32 x = 3; } auto f = [](i32 x) { x }; f(5) + x == 6 }))
    {
        assert(false);
    }
}
