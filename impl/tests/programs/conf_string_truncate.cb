// CONFORMANCE-CASE
// facility: conf.string-truncate, conf.string-truncate-inside-character
// kind: positive
// expect: ok
// covers: conf.string-truncate-inside-character

import std;
fn main()
{
    if (!({ String t = String::copy("héllo"); String::truncate(&mut t, 3); t == "hé" }))
    {
        assert(false);
    }
}
