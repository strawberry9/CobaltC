// CONFORMANCE-CASE
// facility: conf.ref-binding-ends-at-last-use
// kind: positive
// expect: ok
//
// D-0111: a reference binding ends after its last use.

import std;
fn main()
{
    String cur = "abc";
    slice<u8, shared> b = StringView::as_bytes(&cur);
    usize n = slice_len(b);
    String::clear(&mut cur);
}
