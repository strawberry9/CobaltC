// CONFORMANCE-CASE
// facility: conf.foreach-consumed
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ Vec<String> v = Vec::new(); Vec::push(&mut v, String::copy("ab")); Vec::push(&mut v, String::copy("cde")); usize n = 0; foreach (s in v) { n += StringView::len(&s); } n == 5 }))
    {
        assert(false);
    }
}
