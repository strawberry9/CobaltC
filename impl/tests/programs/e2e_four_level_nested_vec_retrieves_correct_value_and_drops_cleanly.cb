// CONFORMANCE-CASE
// kind: positive
// expect: ok

import std;

fn main()
{
    Vec<Vec<Vec<Vec<i32>>>> v0 = Vec::new();
    Vec<Vec<Vec<i32>>> v1 = Vec::new();
    Vec<Vec<i32>> v2 = Vec::new();
    Vec<i32> v3 = Vec::new();
    Vec::push(&mut v3, 99);
    Vec::push(&mut v2, v3);
    Vec::push(&mut v1, v2);
    Vec::push(&mut v0, v1);
    {
        auto r1 = Vec::index_shared(&v0, 0);
        auto r2 = Vec::index_shared(r1, 0);
        auto r3 = Vec::index_shared(r2, 0);
        auto r4 = Vec::index_shared(r3, 0);
        if (*r4 != 99) { 1 /(1 - 1); }
    }
}
