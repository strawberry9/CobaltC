// CONFORMANCE-CASE
// kind: positive
// expect: ok
// expect-stdout-hex: 00000000010000000a000000000000000200000014000000
// D-0326: the second element holds Some(2), not None, whose payload bytes are unspecified (spec/06
// [Repr-Enum]: Clang leaves them as they were); every byte written is then defined.

import std;
struct Foo { Option<i32> a; i32 b; }
fn main()
{
    Foo f1 = Foo { .a = Some(1), .b = 10 };
    Foo f2 = Foo { .a = Some(2), .b = 20 };
    auto arr = [f1, f2];
    usize sz = sizeof<array<Foo, 2>>();
    rawptr<u8> p = reinterpret_ptr<u8>(rawptr_of(&arr));
    isize n = unsafe { stdout_write(p, sz) };
}
