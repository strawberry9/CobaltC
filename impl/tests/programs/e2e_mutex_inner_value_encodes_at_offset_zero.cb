// CONFORMANCE-CASE
// kind: positive
// expect: ok
// expect-stdout-hex: 2a000000
//
// The test asserted the first four bytes of the output and that it was 16
// bytes long; the program writes those four and checks `len` (sizeof) is 16
// itself.
//
// A mutex once had no byte representation at all -- [Repr-Mutex]
// (spec/06 sec 4) requires the inner value at offset 0: the
// bytes of a mutex<T> begin with the bytes of its T, which the
// program writes out here
// (2a 00 00 00 for 42).
// [Sizeof-Mutex]: `struct { i32 inner; usize state; }` per
// [Layout-Struct] -- the state at offset 8, 16 bytes in all.

import std;
fn main()
{
    mutex<i32> m = Mutex::new(42);
    rawptr<u8> p = reinterpret_ptr<u8>(rawptr_of(&m));
    usize len = sizeof<mutex<i32>>();
    if (len != 16) { assert(false); }
    isize n = unsafe { stdout_write(p, 4) };
}
