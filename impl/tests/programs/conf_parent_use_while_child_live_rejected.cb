// CONFORMANCE-CASE
// facility: conf.parent-use-while-child-live-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// D-0071: `r2` holds `deriv(r2, *r1, shared)`, which the write
// through `r1` overlaps (`r2` is used after it: D-0275 ends an unused
// reborrow at its last use).

import std;
fn main()
{
    i32 x = 1;
    auto r1 = &mut x;
    auto r2 = &*r1;
    *r1 = 2;
    i32 k = *r2;
}
