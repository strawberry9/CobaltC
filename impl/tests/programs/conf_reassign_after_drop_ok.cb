// CONFORMANCE-CASE
// facility: conf.reassign-after-drop-ok
// kind: positive
// expect: ok
//
// D-0033 (1): `[Assign-Reestablish]`.

import std;
fn main()
{
    if (!({ Vec<i32> v = Vec::new(); drop(v); v = Vec::new(); Vec::push(&mut v, 1); Vec::len(&v) == 1 }))
    {
        1 /(1 - 1);
    }
}
