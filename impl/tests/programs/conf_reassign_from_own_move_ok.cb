// CONFORMANCE-CASE
// facility: conf.reassign-from-own-move-ok
// kind: positive
// expect: ok

import std;
fn grow(Vec<i32> v) : Vec<i32>
{
    Vec<i32> w = v;
    Vec::push(&mut w, 7);
    w
}
fn main()
{
    if (!({ Vec<i32> v = Vec::new(); v = grow(v); v = grow(v); Vec::len(&v) == 2 }))
    {
        1 /(1 - 1);
    }
}
