// CONFORMANCE-CASE
// facility: conf.reborrow-field-through-param-rejected, conf.spawn-exclusive-read-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
// covers: conf.reborrow-field-through-param-rejected
// covers: conf.spawn-exclusive-read-rejected
//
// D-0071: `deriv` through referent roots, match-by-reference binders,
// and spawn handles until `join`.

import std;
struct P { i32 a; i32 b; } fn f(ref<P, exclusive> p) : i32
{
    auto a = &mut p.a;
    p.a = 3;
    *a
}
fn main()
{
    P q = P { .a = 1, .b = 2 };
    f(&mut q);
}
