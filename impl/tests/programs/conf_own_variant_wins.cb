// CONFORMANCE-CASE
// facility: conf.own-variant-wins
// kind: positive
// expect: ok
//
// CHG-0041: a program's own variants before imported ones (`spec/17`
// clauses (4) and (4b)).

import std;
enum Shape { Dot(i32), Empty }
fn main()
{
    if (!({ Shape s = Empty; i32 v = match (s) { Dot(x) : x, Empty : 5 }; v == 5 }))
    {
        1 /(1 - 1);
    }
}
