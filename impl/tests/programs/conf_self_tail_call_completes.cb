// CONFORMANCE-CASE
// facility: conf.self-tail-call-completes
// kind: positive
// expect: ok
//
// The program runs on the implementation's own stack, whatever its size,
// and must complete.
//
// D-0309 `[Call-Self-Tail]`: a self tail call is no level of nesting; deeper
// than this stack holds as nested calls.

import std;
fn down(u64 n) : bool
{
    if (n == 0) { true } else { down(n - 1) }
}
fn main()
{
    bool b = down(300000);
    assert(b);
}
