// CONFORMANCE-CASE
// facility: conf.overwrite-some-of-resource-option-dynamic
// kind: negative
// expect: diag.overwrite-of-live-resource (static)
// D-0340 (CHG-0483) §4: `o` holds `Some(…)` here, so `=` is refused at the check.

import std;
fn main()
{
    Option<Channel<u8>> o = Some(Channel::new(1));
    o = Some(Channel::new(2));
}
