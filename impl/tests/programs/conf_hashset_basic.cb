// CONFORMANCE-CASE
// facility: conf.hashset-basic
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ HashSet<String> s = HashSet::new(); bool a = HashSet::insert(&mut s, String::copy("x")); bool b = HashSet::insert(&mut s, String::copy("x")); String k = "x"; a && !b && HashSet::len(&s) == 1 && HashSet::remove(&mut s, &k) && HashSet::len(&s) == 0 }))
    {
        assert(false);
    }
}
