// CONFORMANCE-CASE
// facility: conf.return-bare-in-arm
// kind: positive
// expect: ok
//
// `'return' expr?` before `,` (a match arm of a void function).

import std;
fn f(Option<i32> o)
{
    match (o)
    {
        Some(_) : {},
        None    : return,
    }
}
fn main()
{
    f(None);
    f(Some(1));
}
