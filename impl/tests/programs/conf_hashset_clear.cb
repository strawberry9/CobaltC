// CONFORMANCE-CASE
// facility: conf.hashset-clear
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ HashSet<i32> s = HashSet::new(); HashSet::insert(&mut s, 1); HashSet::insert(&mut s, 2); HashSet::clear(&mut s); HashSet::len(&s) == 0 && HashSet::insert(&mut s, 1) }))
    {
        1 /(1 - 1);
    }
}
