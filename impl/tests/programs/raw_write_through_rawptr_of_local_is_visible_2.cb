import std;
struct P { i32 a; i32 b; }
fn main()
{
    if (!({ P s = P { .a = 1, .b = 2 }; auto q = rawptr_of(&mut s.b); unsafe { *q = 20; } s.b == 20 && s.a == 1 }))
    {
        1 /(1 - 1);
    }
}
