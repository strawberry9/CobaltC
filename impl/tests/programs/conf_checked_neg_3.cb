// CONFORMANCE-CASE
// facility: conf.checked-neg, conf.checked-neg-unsigned
// kind: positive
// expect: ok
// covers: conf.checked-neg-unsigned

import std;
fn main()
{
    if (!({ Option::unwrap_or(checked_neg(0: u8), 9: u8) + Option::unwrap_or(checked_neg(3: u8), 9: u8) == 9 }))
    {
        assert(false);
    }
}
