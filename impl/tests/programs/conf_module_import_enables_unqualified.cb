// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// `import p;` makes `p`'s last segment resolve, unqualified, within the
// importing module (`rule.module.use`) -- `helper` is not declared at
// the root at all, so without the `import` this would be
// `diag.unbound-name`.

import std;

module m
{
    export fn helper() : i32
    {
        42
    }
}
import m::helper;
fn main()
{
    helper();
}
