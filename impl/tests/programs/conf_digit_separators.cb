// CONFORMANCE-CASE
// facility: conf.digit-separators
// kind: positive
// expect: ok
//
// CHG-0051 (D-0043): digit separators.

import std;
fn main()
{
    if (!({ u64 a = 1_000_000; u32 b = 0xFFFF_0000; u8 c = 0b1010_0101; f64 d = 1_234.567_8e1_0; a == 1000000 && b == 4294901760 && c == 165 && d == 12345678000000.0 }))
    {
        assert(false);
    }
}
