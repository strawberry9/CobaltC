// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// conf.unbounded-type-parameter-rejected; rejected at the
// declaration, so also for an uncalled generic.
// What a bare T may do: be stored, passed, referenced, moved.

import std;
struct W<T> { T v; } fn wrap<T>(T x) : W<T>
{
    W { .v = x }
}
fn pass<T>(T x) : T
{
    auto r = &x;
    wrap(x).v
}
fn main()
{
    i32 y = pass(4);
    if (y != 4) { 1 /(1 - 1); }
}
