// CONFORMANCE-CASE
// facility: conf.quiet-replace-ok
// kind: positive
// expect: ok
//
// D-0194: a quiet type's live value is replaced.

import std;
fn main()
{
    if (!({ Vec<i32> v = Vec::new(); Vec::push(&mut v, 1); v = Vec::new(); String s = "a"; s = String::copy("bc"); Vec::len(&v) == 0 && StringView::len(&s) == 2 }))
    {
        1 /(1 - 1);
    }
}
