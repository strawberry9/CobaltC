// CONFORMANCE-CASE
// facility: conf.hashmap-insert-replaces
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ HashMap<str, i32> m = HashMap::new(); HashMap::insert(&mut m, "a", 1); i32 old = Option::unwrap_or(HashMap::insert(&mut m, "a", 2), 0); str k = "a"; i32 now = match (HashMap::get(&m, k)) { Some(v) : *v, None : 0 }; old == 1 && now == 2 && HashMap::len(&m) == 1 }))
    {
        assert(false);
    }
}
