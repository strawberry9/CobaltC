// CONFORMANCE-CASE
// facility: conf.foreach-map-position
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ HashMap<str, i32> m = HashMap::new(); HashMap::insert(&mut m, "a", 1); HashMap::insert(&mut m, "b", 2); usize last = 9; foreach (i, k, v in &m) { last = i; } last == 1 }))
    {
        assert(false);
    }
}
