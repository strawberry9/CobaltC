// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// The fix to type compatibility is symmetric and applies in several
// places beyond the one that surfaced it (function body against
// return type) -- this exercises the same [T-Never] rule via an
// if/else where one arm is a bare `return` (Never) and the other is
// a real value, a shape the checker was already meant to
// support ("an if/else if chain's final else arm").

import std;
fn h(bool c) : i32
{
    if (c) { return 7; } else {}
    3
}
fn main()
{
    if (!(h(true) == 7 && h(false) == 3))
    {
        assert(false);
    }
}
