// CONFORMANCE-CASE
// facility: conf.hashmap-basic
// kind: positive
// expect: ok
//
// CHG-0049 (D-0041): hash tables.

import std;
fn main()
{
    if (!({ HashMap<i32, bool> m = HashMap::new(); HashMap::insert(&mut m, 5, true); i32 k = 5; i32 j = 6; HashMap::len(&m) == 1 && HashMap::contains(&m, k) && !HashMap::contains(&m, j) }))
    {
        1 /(1 - 1);
    }
}
