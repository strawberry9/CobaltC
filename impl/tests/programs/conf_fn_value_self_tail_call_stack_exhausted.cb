// CONFORMANCE-CASE
// facility: conf.fn-value-self-tail-call-stack-exhausted
// kind: negative
// expect: diag.stack-exhausted (dynamic)
//
// The program runs on the implementation's own stack, whatever its
// size: a hundred million nested calls exhaust it, and the fault is
// diag.stack-exhausted.
//
// `[Call-Stack-Exhausted]` through a `fn` value, and through mutual tail
// calls (§2a condition 1).

import std;
fn down(u64 n) : bool
{
    fn(u64) : bool g = down;
    if (n == 0) { true } else { g(n - 1) }
}
fn main()
{
    bool b = down(100000000);
}
