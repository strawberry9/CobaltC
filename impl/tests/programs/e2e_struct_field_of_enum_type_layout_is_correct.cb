// CONFORMANCE-CASE
// kind: positive
// expect: ok
// expect-stdout-hex: 000000000700000063000000
//
// A struct field whose type is an enum -- exercises a struct's
// layout over a field whose size and alignment are an enum's, not
// just a bare enum value. Foo { Option<i32> a; i32 b; }: a at
// offset 0 (size 8), b at offset 8 (size 4) -- 12 bytes total.

import std;
struct Foo { Option<i32> a; i32 b; }
fn main()
{
    Foo f = Foo { .a = Some(7), .b = 99 };
    rawptr<u8> p = reinterpret_ptr<u8>(rawptr_of(&f));
    usize len = sizeof<Foo>();
    isize n = unsafe { stdout_write(p, len) };
}
