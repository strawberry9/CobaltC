// CONFORMANCE-CASE
// facility: conf.string-compare-while-exclusive-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// D-0108: a compared `String` is borrowed shared, so a live exclusive
// borrow of it conflicts.

import std;
fn main()
{
    String a = "x";
    String b = "y";
    ref<String, exclusive> m = &mut a;
    bool z = a < b;
    String::push_ascii(m, 65);
}
