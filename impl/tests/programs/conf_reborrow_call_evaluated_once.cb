// CONFORMANCE-CASE
// facility: conf.reborrow-call-evaluated-once
// kind: positive
// expect: ok
//
// Tier 6 findings (conformance 3.38.0): `&mut *f(k)`'s call was once
// evaluated twice, and a statement's temporaries left alive after a `return`.

import std;
fn main()
{
    if (!({ HashMap<String, u32> m = HashMap::new(); String k = "a"; *HashMap::entry(&mut m, &k, 0) += 1; HashMap::len(&m) == 1 }))
    {
        assert(false);
    }
}
