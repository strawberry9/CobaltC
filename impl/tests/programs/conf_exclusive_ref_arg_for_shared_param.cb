// CONFORMANCE-CASE
// facility: conf.exclusive-ref-arg-for-shared-param
// kind: positive
// expect: ok

import std;
fn n(ref<Vec<i32>, exclusive> v) : usize
{
    Vec::push(v, 1);
    Vec::len(v)
}
fn main()
{
    if (!({ Vec<i32> v = Vec::new(); n(&mut v) == 1 }))
    {
        1 /(1 - 1);
    }
}
