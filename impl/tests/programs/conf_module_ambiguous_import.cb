// CONFORMANCE-CASE
// kind: negative
// expect: diag.ambiguous-name (static)
//
// `[Resolve-Ambiguous]`: two `import`s whose last segment is the same
// name yield more than one candidate.

import std;

module a
{
    export fn helper() : i32
    {
        1
    }
}
module b
{
    export fn helper() : i32
    {
        2
    }
}
import a::helper;
import b::helper;
fn main()
{
    helper();
}
