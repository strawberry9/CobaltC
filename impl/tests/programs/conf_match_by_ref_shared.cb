// CONFORMANCE-CASE
// facility: conf.match-by-ref-shared
// kind: positive
// expect: ok
//
// CHG-0054 (D-0046): match through a reference.

import std;
fn main()
{
    if (!({ Option<i32> o = Some(4); i32 x = match (&o) { Some(n) : *n, None : 0 }; x == 4 && Option::unwrap_or(o, 0) == 4 }))
    {
        assert(false);
    }
}
