// CONFORMANCE-CASE
// facility: conf.string-into-bytes-roundtrip
// kind: positive
// expect: ok

import std;
fn main()
{
    Vec<u8> b = Vec::new();
    Vec::push(&mut b, 104);
    Vec::push(&mut b, 105);
    auto s = match (String::from_utf8(b)) { Ok(v) : v, Err(_) : String::copy(""), };
    usize n1 = StringView::len(&s);
    auto bytes2 = String::into_bytes(s);
    usize n2 = Vec::len(&bytes2);
    if (n1 != 2) { 1 /(1 - 1); } if (n2 != 2) { 1 /(1 - 1); }
}
