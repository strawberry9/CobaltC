// CONFORMANCE-CASE
// facility: conf.option-result-predicates
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ Option<i32> o = Some(1); Result<i32, str> r = Err("e"); Option::is_some(&o) && !Option::is_none(&o) && Result::is_err(&r) && !Result::is_ok(&r) }))
    {
        1 /(1 - 1);
    }
}
