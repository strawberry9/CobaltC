// CONFORMANCE-CASE
// facility: conf.cross-thread-write-conflict
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `conf.cross-thread-write-conflict`: the thread holds its borrow of `x`
// until `join(h)`, so the write is refuted statically (D-0071) rather
// than depending on whether the thread has finished.

import std;
fn w(ref<i32, shared> r) : i32
{
    *r
}
fn main()
{
    i32 x = 1;
    auto h = spawn(w, &x);
    x = 2;
    join(h);
}
