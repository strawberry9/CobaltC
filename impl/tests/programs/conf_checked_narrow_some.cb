// CONFORMANCE-CASE
// facility: conf.checked-narrow-some
// kind: positive
// expect: ok
//
// D-0122: `checked_narrow<T>(v) : Option<T>`.

import std;
fn main()
{
    if (!({ u64 big = 70000; Option::unwrap_or(checked_narrow<u32>(big), 0) + widen<u32>(Option::unwrap_or(checked_narrow<u16>(big), 1)) == 70001 }))
    {
        assert(false);
    }
}
