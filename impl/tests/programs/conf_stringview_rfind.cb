// CONFORMANCE-CASE
// facility: conf.stringview-rfind
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ String s = "a-b-c"; usize n = Option::unwrap_or(StringView::rfind(&s, "-"), 99) + Option::unwrap_or(StringView::rfind(&s, "x"), 100); n == 103 }))
    {
        assert(false);
    }
}
