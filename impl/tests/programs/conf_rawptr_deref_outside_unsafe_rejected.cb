// CONFORMANCE-CASE
// facility: conf.rawptr-deref-outside-unsafe-rejected
// kind: negative
// expect: diag.trusted-outside-unsafe (static)
//
// ---------- 7. Trust boundaries ----------
// `[Unsafe-Rejected]` is `disposition: rejected` -- a whole-program
// static fact (the offending deref need not even run), not merely a
// dynamic fault.

import std;
fn f(rawptr<i32> p) : i32
{
    *p
}
fn main()
{
    i32 x = 7;
    f(rawptr_of(&x));
}
