// CONFORMANCE-CASE
// kind: positive
// expect: ok

import std;
fn count(ref<mutex<i32>, shared> m) : i32
{
    i32 i = 0;
    while (i < 50) { { auto g = lock(m); *g = *g + 1; } i = i + 1; } 0
}
fn main()
{
    if (!({ auto m = Mutex::new(0); auto h = spawn(count, &m); i32 i = 0; while (i < 50) { { auto g = lock(&m); *g = *g + 1; } i = i + 1; } join(h); *lock(&m) == 100 }))
    {
        1 /(1 - 1);
    }
}
