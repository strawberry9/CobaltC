// CONFORMANCE-CASE
// facility: conf.option-ok-or
// kind: positive
// expect: ok
//
// D-0114: `Option::ok_or`.

import std;
fn main()
{
    if (!({ Option<i32> n = None; Result::unwrap_or(Option::ok_or(Some(5), "none"), 0) + Result::unwrap_or(Option::ok_or(n, "none"), 7) == 12 }))
    {
        assert(false);
    }
}
