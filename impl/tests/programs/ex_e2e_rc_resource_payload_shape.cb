// CONFORMANCE-CASE
// facility: conf.e2e-rc-resource-payload
// kind: positive
// expect: ok
// covers: conf.e2e-rc-resource-payload

import std;
fn main()
{
    Vec<i32> payload = Vec::new();
    Vec::push(&mut payload, 42);
    auto a = Rc::new(payload);
    auto b = Rc::clone(&a);
    usize n = Vec::len(Rc::get(&b));
    if (n != 1) { assert(false); }
    drop(a);
    usize m = Vec::len(Rc::get(&b));
    if (m != 1) { assert(false); }
    drop(b);
}
