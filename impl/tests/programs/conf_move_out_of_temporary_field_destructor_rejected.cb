// CONFORMANCE-CASE
// facility: conf.move-out-of-temporary-field-destructor-rejected
// kind: negative
// expect: diag.move-out-of-field (static)

import std;
resource struct W { Vec<i32> v; } fn W::drop(ref<W, exclusive> self)
{
}
fn mk() : W
{
    W { .v = Vec::new() }
}
fn main()
{
    Vec<i32> x = mk().v;
}
