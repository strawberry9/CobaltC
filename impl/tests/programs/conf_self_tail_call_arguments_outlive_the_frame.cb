// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// `[Call-Self-Tail]`'s arguments are read before the frame ends: a shared
// and an exclusive reference parameter handed on as they are, and a struct
// built for the call (a statement's temporary).

import std;
struct P { u64 a; u64 b; }
fn sum(ref<Vec<u64>, shared> v, usize i, u64 acc) : u64
{
    if (i < Vec::len(v)) { sum(v, i + 1, acc + v[i]) } else { acc }
}
fn fill(ref<Vec<u64>, exclusive> v, u64 n)
{
    if (n > 0) { Vec::push(v, n); fill(v, n - 1); }
}
fn pair(P p, u64 n) : u64
{
    if (n == 0) { p.a * 1000000 + p.b } else { pair(P { .a = p.b, .b = p.a + 1 }, n - 1) }
}
fn main()
{
    Vec<u64> v = Vec::new();
    fill(&mut v, 1000);
    assert(Vec::len(&v) == 1000);
    assert(sum(&v, 0, 0) == 500500);
    assert(pair(P { .a = 0, .b = 0 }, 1001) == 500000501);
}
