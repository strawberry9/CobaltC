// CONFORMANCE-CASE
// facility: conf.recursion-ten-thousand-deep
// kind: positive
// expect: ok
//
// The test this case came from ran it on a thread with a 1 GiB stack
// and asserted success; the static pass was not asserted.
//
// D-0077: stack exhaustion is a fault. Ten thousand calls deep is
// within the stack a program has, so
// the deep case is run as a program of its own, end to end,
// and must reach its end.
// (An earlier implementation needed a larger stack reservation
// for this in an unoptimised build.)

import std;
fn depth(u64 n) : u64
{
    if (n == 0) { 0 } else { 1 + depth(n - 1) }
}
fn main()
{
    u64 d = depth(10000);
    if (d != 10000) { assert(false); }
}
