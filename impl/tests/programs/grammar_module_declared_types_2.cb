// CONFORMANCE-CASE
// kind: positive
// expect: ok

import std;
module geom { export struct Point { export i32 x; export i32 y; } } import geom::Point;
fn dist(ref<Point, shared> p) : i32
{
    p.x + p.y
}
fn main()
{
    if (!({ Point p = Point { .x = 3, .y = 4 }; dist(&p) == 7 }))
    {
        1 /(1 - 1);
    }
}
