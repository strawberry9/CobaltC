// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// `[Literal-Negated]` for i128 once accepted only the minimum
// itself: every other negated i128 literal, `-1` included, was
// diag.literal-out-of-range.

import std;
fn main()
{
    if (!({ i128 x = -1; x + 1 == 0 }))
    {
        assert(false);
    }
}
