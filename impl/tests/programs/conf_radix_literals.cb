// CONFORMANCE-CASE
// facility: conf.radix-literals
// kind: positive
// expect: ok
//
// CHG-0044 (D-0035): radix literals, compound assignment, `for`.

import std;
fn main()
{
    if (!({ u8 a = 0xFF; u8 b = 0b1010; u8 c = 0o17; widen<u32>(a) + widen<u32>(b) + widen<u32>(c) == 280 }))
    {
        assert(false);
    }
}
