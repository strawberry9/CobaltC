// CONFORMANCE-CASE
// facility: conf.priority-queue-generic-key-checked
// kind: negative
// expect: diag.type-mismatch (static)

import std;
fn keep<T>(T x)
{
    PriorityQueue<T> q = PriorityQueue::new();
    PriorityQueue::push(&mut q, x);
}
fn main()
{
    Vec<i32> v = Vec::new();
    keep(v);
}
