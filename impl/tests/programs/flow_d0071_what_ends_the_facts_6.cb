// CONFORMANCE-CASE
// facility: conf.reborrow-disjoint-field-ok, conf.reborrow-reassigned-ok, conf.match-by-ref-after-arm-ok, conf.spawn-borrow-after-join-ok, conf.spawn-join-in-branch-dynamic
// kind: positive
// expect: ok
// covers: conf.reborrow-disjoint-field-ok
// covers: conf.reborrow-reassigned-ok
// covers: conf.match-by-ref-after-arm-ok
// covers: conf.spawn-borrow-after-join-ok
// covers: conf.spawn-join-in-branch-dynamic
//
// A disjoint field through the same reference.
// Assigning the reference moves its referent root.
// The binder's fact ends with its arm.
// `join` ends the handle's facts; a disjoint range is no conflict.
// A handle moved elsewhere takes its facts with it.

import std;
fn w(slice<i32, shared> s) : usize
{
    slice_len(s)
}
fn main()
{
    if (!({ array<i32, 4> a = [1, 2, 3, 4]; auto h = spawn(w, &a[0 .. 2]); a[3] = 9; join(h) == 2 }))
    {
        assert(false);
    }
}
