// CONFORMANCE-CASE
// facility: conf.variant-temp-borrow-argument, conf.variant-borrow-outside-argument-rejected
// kind: positive
// expect: ok
// covers: conf.variant-borrow-outside-argument-rejected
//
// CHG-0130: a variant without a payload borrowed as an argument.

import std;
fn some(ref<Option<i32>, shared> o) : bool
{
    Option::is_some(o)
}
fn main()
{
    if (!(!some(&None) && some(&Some(1))))
    {
        1 /(1 - 1);
    }
}
