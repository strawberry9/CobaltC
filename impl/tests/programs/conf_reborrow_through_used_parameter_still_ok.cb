// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// The ancestor exemption that `token_ancestors` provides is
// unaffected: a sub-borrow formed by dereferencing an exclusive
// reference parameter is still its descendant.

import std;
fn read_len(ref<Vec<i32>, exclusive> v) : usize
{
    usize k = Vec::len(&*v);
    auto shared_view = &*v;
    Vec::len(shared_view) + k
}
fn main()
{
    if (!({ Vec<i32> v = Vec::new(); Vec::push(&mut v, 1); read_len(&mut v) == 2 }))
    {
        assert(false);
    }
}
