// CONFORMANCE-CASE
// kind: positive
// expect: ok
// expect-stdout-hex: 0000000041000000
//
// Regression test: an enum once had no byte encoding
// (found immediately after fixing the analogous gap for
// arrays). Per [Layout-Enum]/[Repr-Enum] (spec/06 §7, spec/16 §1)
// with this implementation's documented DW=4: Some(65:i32) on
// Option<i32> is discriminant 0 (variants numbered from 0 in
// declaration order: Some, None) at offset 0..4, payload 65 at
// offset 4..8 (payload-off = round_up(4, alignof(i32)=4) = 4) --
// 8 bytes total, little-endian.

import std;
fn main()
{
    Option<i32> o = Some(65);
    rawptr<u8> p = reinterpret_ptr<u8>(rawptr_of(&o));
    usize len = sizeof<Option<i32>>();
    isize n = unsafe { stdout_write(p, len) };
}
