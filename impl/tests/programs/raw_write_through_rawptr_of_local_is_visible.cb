// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// ---------- Dynamic fidelity: a local's own cells behind rawptr_of,
// drop through a reference, tail-position expected types, and
// per-thread destroy authority.

import std;
fn main()
{
    if (!({ i32 x = 7; auto p = rawptr_of(&mut x); unsafe { *p = 9; } bool a = x == 9; x = 11; bool b = unsafe { *p == 11 }; a && b }))
    {
        assert(false);
    }
}
