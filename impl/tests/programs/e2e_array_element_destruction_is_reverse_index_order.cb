// CONFORMANCE-CASE
// kind: positive
// expect: ok
// expect-stdout-hex: 030201

import std;
resource struct Tagged { u8 tag; }
fn Tagged::drop(ref<Tagged, exclusive> self)
{
    auto buf = [self.tag];
    rawptr<u8> p = reinterpret_ptr<u8>(rawptr_of(&buf));
    unsafe { stdout_write(p, 1); }
}
fn main()
{
    array<Tagged, 3> arr = [Tagged { .tag = 1 }, Tagged { .tag = 2 }, Tagged { .tag = 3 }];
}
