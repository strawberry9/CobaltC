// CONFORMANCE-CASE
// kind: positive
// expect: ok
// expect-stdout-hex: 01000000
//
// The test asserted only the first four bytes of the output (the
// discriminant); the program writes those four (`stdout_write(p, 4)` for
// `stdout_write(p, len)`).
//
// None is variant index 1 (declared second); a payload-less variant
// has no bytes of its own to check, only that the discriminant is
// right and the call doesn't corrupt/panic.

import std;
fn main()
{
    Option<i32> o = None;
    rawptr<u8> p = reinterpret_ptr<u8>(rawptr_of(&o));
    usize len = sizeof<Option<i32>>();
    isize n = unsafe { stdout_write(p, 4) };
}
