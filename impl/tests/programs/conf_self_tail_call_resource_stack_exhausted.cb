// CONFORMANCE-CASE
// facility: conf.self-tail-call-resource-stack-exhausted
// kind: negative
// expect: diag.stack-exhausted (dynamic)
//
// The program runs on the implementation's own stack, whatever its
// size: a hundred million nested calls exhaust it, and the fault is
// diag.stack-exhausted.
//
// §2a condition 4: a frame holding a resource is a level of nesting.

import std;
fn down(u64 n) : u64
{
    String s = String::new();
    if (n == 0) { 0 } else { down(n - 1) }
}
fn main()
{
    u64 d = down(100000000);
}
