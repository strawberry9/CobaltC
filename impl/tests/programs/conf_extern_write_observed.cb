// CONFORMANCE-CASE
// facility: conf.extern-write-observed
// kind: positive
// expect: ok

import std;
fn send(rawptr<u8> p, usize n) : isize
{
    unsafe { stdout_write(p, n) }
}
fn main()
{
    auto message = [104:u8, 101:u8, 108:u8, 108:u8, 111:u8, 10:u8];
    auto p = reinterpret_ptr<u8>(rawptr_of(&message));
    send(p, 6);
}
