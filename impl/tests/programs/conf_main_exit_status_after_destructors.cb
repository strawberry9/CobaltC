// CONFORMANCE-CASE
// facility: conf.main-exit-status-after-destructors
// kind: positive
// expect: exit 3
// expect-stdout-hex: 64726f707065640a
//
// The destructor runs before the status is reported: `dropped` is
// printed and the process exits 3.

import std;
resource struct S { i32 x; }
fn S::drop(ref<S, exclusive> self)
{
    printf("dropped\n");
}
fn main() : u8
{
    S s = S { .x = 1 };
    return 3;
}
