// CONFORMANCE-CASE
// facility: conf.slice-through-returned-ref
// kind: positive
// expect: ok

import std;
fn first(ref<Vec<i32>, shared> v) : ref<Vec<i32>, shared> { v }
fn main()
{
    if (!({ Vec<i32> v = Vec::new(); Vec::push(&mut v, 1); Vec::push(&mut v, 2); Vec::push(&mut v, 3); slice_len(&first(&v)[0 .. 2]) == 2 }))
    {
        1 /(1 - 1);
    }
}
