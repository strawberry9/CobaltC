// CONFORMANCE-CASE
// facility: conf.reclaim-two-paths-clash
// kind: negative
// expect: diag.aliasing-conflict (dynamic)

import std;
fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 7);
    auto p = rawptr_of(Vec::index_shared(&v, 0));
    unsafe { auto r1 = &mut reclaim<i32>(p); auto r2 = &reclaim<i32>(p); }
}
