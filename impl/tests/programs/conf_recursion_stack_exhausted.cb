// CONFORMANCE-CASE
// facility: conf.recursion-stack-exhausted
// kind: negative
// expect: diag.stack-exhausted (dynamic)
//
// The program runs on the implementation's own stack, whatever its size:
// a hundred million nested calls exhaust it.

import std;
fn depth(u64 n) : u64
{
    if (n == 0) { 0 } else { 1 + depth(n - 1) }
}
fn main()
{
    u64 d = depth(100000000);
}
