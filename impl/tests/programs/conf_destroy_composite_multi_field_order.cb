// CONFORMANCE-CASE
// facility: conf.destroy-composite-multi-field-order
// kind: positive
// expect: ok
//
// The order itself is asserted byte-for-byte by
// 16-aggregates/struct_field_destruction_reverse_order.cb.

import std;
struct Pair { Vec<i32> a; Vec<i32> b; }
fn main()
{
    Vec<i32> va = Vec::new();
    Vec::push(&mut va, 1);
    Vec<i32> vb = Vec::new();
    Vec::push(&mut vb, 2);
    Pair p = Pair { .a = va, .b = vb };
}
