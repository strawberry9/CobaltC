// CONFORMANCE-CASE
// facility: conf.destructure-rest
// kind: positive
// expect: ok
//
// D-0104: destructuring with `..` and renaming.

import std;
struct S { i32 a; i32 b; i32 c; }
fn main()
{
    if (!({ S s = S { .a = 1, .b = 2, .c = 3 }; S { b, .. } = s; b == 2 }))
    {
        1 /(1 - 1);
    }
}
