// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// Still allowed: a nested block, a closure's parameter, an `if`-pattern's
// binder in an inner block, sibling regions.

import std;
fn main()
{
    if (!({ i32 n = 0; for (i32 i = 0; i < 2; i += 1) { { i32 i = 9; n += i; } } n == 18 }))
    {
        assert(false);
    }
}
