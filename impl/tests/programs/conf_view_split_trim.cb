// CONFORMANCE-CASE
// facility: conf.view-split-trim
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ String s = " a, bb ,c "; Vec<StringView> p = StringView::split(StringView::trim(&s[0..$]), ","); Vec::len(&p) == 3 && StringView::trim(p[1]) == "bb" && p[2] == "c" }))
    {
        assert(false);
    }
}
