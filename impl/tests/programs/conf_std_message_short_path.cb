// CONFORMANCE-CASE
// facility: conf.std-message-short-path
// kind: negative
// expect: diag.type-mismatch (static)
//
// The test asserted the static rejection ("a mismatch") and the text of its
// message: it names `Vec<i32>`, not `collections`. A header states the
// diagnostic's id and phase only, so the message is not checked here.
//
// CHG-0164 (D-0136): a message names a `std` item by its shortest path,
// whichever path the program wrote.

import std;
fn main()
{
    std::collections::Vec<i32> v = Vec::new();
    i32 x = v;
}
