// CONFORMANCE-CASE
// facility: conf.array-repeat, conf.array-repeat-inferred, conf.array-trailing-comma
// kind: positive
// expect: ok
// covers: conf.array-repeat-inferred
// covers: conf.array-trailing-comma
//
// D-0072: `[v; N]`, a trailing comma, `checked_neg`.

import std;
fn main()
{
    if (!({ i32 k = 0; auto a = [{ k += 1; k }; 4]; a[3] == 1 && k == 1 }))
    {
        1 /(1 - 1);
    }
}
