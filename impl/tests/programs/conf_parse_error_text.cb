// CONFORMANCE-CASE
// facility: conf.parse-error-text
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ String s = "12x"; String t = String::new(); str a = match (StringView::parse<i32>(&s)) { Ok(_) : "", Err(e) : ParseError::text(&e), }; str b = match (StringView::parse<i32>(&t)) { Ok(_) : "", Err(e) : ParseError::text(&e), }; str_len(a) * 10 + str_len(b) == 125 }))
    {
        1 /(1 - 1);
    }
}
