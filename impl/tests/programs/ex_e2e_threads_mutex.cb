// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// → `conf.e2e-threads-mutex-total`. The case checks the functional
// result (`a + b == 7`), which holds under any interleaving of the
// threads; the interleaving itself, which the
// spec's own text discusses, is not observed.

import std;

fn worker(ref<mutex<i32>, shared> m, i32 n) : i32
{
    i32 i = 0;
    while (i < n)
    {
        auto g = lock(m);
        *g = *g + 1;
        i = i + 1;
    }
    n
}
fn main()
{
    auto m = Mutex::new(0);
    auto h1 = spawn(worker, &m, 3);
    auto h2 = spawn(worker, &m, 4);
    i32 a = join(h1);
    i32 b = join(h2);
    i32 total = *lock(&m);
    if (total != 7) { 1 /(1 - 1); }
}
