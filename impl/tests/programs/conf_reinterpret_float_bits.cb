// CONFORMANCE-CASE
// facility: conf.reinterpret-float-bits
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!(reinterpret<u32>(1.0: f32) == 0x3f80_0000: u32 && reinterpret<i64>(-0.0) == min_value<i64>() && reinterpret<f64>(reinterpret<u64>(2.5)) == 2.5))
    {
        assert(false);
    }
}
