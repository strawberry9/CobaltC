// CONFORMANCE-CASE
// kind: negative
// expect: diag.borrow-exceeds-source (static)
//
// conf.exclusive-from-shared-rejected, conf.write-through-shared-rejected

import std;
fn tamper(ref<i32, shared> r) : i32
{
    auto rm = &mut *r;
    *rm = 99;
    *rm
}
fn main()
{
    i32 x = 5;
    tamper(&x);
}
