// CONFORMANCE-CASE
// facility: conf.foreach-borrowed
// kind: positive
// expect: ok
//
// CHG-0050 (D-0042): foreach.

import std;
fn main()
{
    if (!({ Vec<i32> v = Vec::new(); Vec::push(&mut v, 3); Vec::push(&mut v, 4); i32 s = 0; foreach (x in &v) { s += *x; } s == 7 && Vec::len(&v) == 2 }))
    {
        1 /(1 - 1);
    }
}
