// CONFORMANCE-CASE
// facility: conf.closure-drop-through-self-rejected
// kind: positive
// expect: ok
//
// [Destroy-Projection] on `self.f_i`; moving the captured resource
// out is the same rule.
// Calling an item by its bare name inside a closure is not a capture
// (previously a false diag.capture-list-mismatch).

import std;
fn helper(i32 x) : i32
{
    x + 1
}
fn main()
{
    if (!({ i32 k = 2; auto f = [k]() { helper(k) + narrow<i32>(sizeof<u8>()) }; auto g = [k]() { Option<i32> o = Some(k); match (o) { Some(v) : v, None : 0, } }; f() + g() == 6 }))
    {
        1 /(1 - 1);
    }
}
