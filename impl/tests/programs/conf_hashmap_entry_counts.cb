// CONFORMANCE-CASE
// facility: conf.hashmap-entry-counts
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ HashMap<u8, u32> m = HashMap::new(); for (u8 i = 0; i < 100; i += 1) { *HashMap::entry(&mut m, i % 7, 0) += 1; } u8 k = 0; HashMap::len(&m) == 7 && *HashMap::value_at(&m, 0) == 15 && *HashMap::key_at(&m, 6) == 6 }))
    {
        assert(false);
    }
}
