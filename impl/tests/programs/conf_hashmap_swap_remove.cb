// CONFORMANCE-CASE
// facility: conf.hashmap-swap-remove
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ HashMap<i32, i32> m = HashMap::new(); HashMap::insert(&mut m, 1, 10); HashMap::insert(&mut m, 2, 20); HashMap::insert(&mut m, 3, 30); i32 k = 1; i32 v = Option::unwrap_or(HashMap::swap_remove(&mut m, k), 0); v == 10 && *HashMap::key_at(&m, 0) == 3 && *HashMap::key_at(&m, 1) == 2 }))
    {
        1 /(1 - 1);
    }
}
