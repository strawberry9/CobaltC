// CONFORMANCE-CASE
// facility: conf.match-move-arm-consumes
// kind: negative
// expect: diag.stale-binding (static)
//
// D-0087: `o` may have been moved (one arm consumed it), so the second
// match is refuted.

import std;
fn main()
{
    Option<String> o = Some(String::copy("a"));
    match (o) { Some(s) : {}, None : {}, } match (&o) { Some(s) : {}, None : {}, }
}
