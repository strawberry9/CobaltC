// CONFORMANCE-CASE
// facility: conf.return-ends-statement-temporaries
// kind: positive
// expect: ok

import std;
fn look(ref<Vec<String>, shared> v) : i32
{
    match (Some(Vec::index_shared(v, 0))) { Some(r) : { return 1; }, None : {}, } 0
}
fn main()
{
    if (!({ Vec<String> v = Vec::new(); Vec::push(&mut v, String::copy("x")); look(&v) == 1 }))
    {
        1 /(1 - 1);
    }
}
