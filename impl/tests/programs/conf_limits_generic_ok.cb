// CONFORMANCE-CASE
// facility: conf.limits-generic-ok
// kind: positive
// expect: ok

import std;
fn or_max<T>(Option<T> r) : T
{
    match (r) { Some(x) : x, None : max_value<T>(), }
}
fn main()
{
    if (!(or_max(checked_add(max_value<u8>(), 1: u8)) == 255))
    {
        assert(false);
    }
}
