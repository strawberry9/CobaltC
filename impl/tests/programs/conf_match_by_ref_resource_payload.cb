// CONFORMANCE-CASE
// facility: conf.match-by-ref-resource-payload
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ Option<String> o = Some(String::copy("abc")); usize n = match (&o) { Some(s) : StringView::len(s), None : 0 }; String t = Option::unwrap_or(o, String::new()); n == 3 && StringView::len(&t) == 3 }))
    {
        assert(false);
    }
}
