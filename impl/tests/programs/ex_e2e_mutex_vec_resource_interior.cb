// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// Previously failed for the same reason as `ex_e2e_vec_realloc_stale_ref`
// (the `clash` scan's ancestor exemption was transient, not
// persistent) -- fixed by recording each reference's ancestors.
// → `conf.e2e-mutex-vec-resource-interior`.

import std;
fn main()
{
    Vec<i32> inner = Vec::new();
    auto m = Mutex::new(inner);
    {
        auto g = lock(&m);
        Vec::push(&mut *g, 1);
        Vec::push(&mut *g, 2);
        usize n = Vec::len(&*g);
        if (n != 2) { 1 /(1 - 1); }
    }
}
