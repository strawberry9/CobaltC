// CONFORMANCE-CASE
// facility: conf.match-by-ref-box-tree
// kind: positive
// expect: ok

import std;
enum T { Leaf(i32), Node(Box<T>) } fn depth(ref<T, shared> t) : i32
{
    match (t) { Leaf(v) : *v, Node(b) : 1 + depth(Box::get(b)), }
}
fn main()
{
    if (!({ T t = Node(Box::new(Node(Box::new(Leaf(40))))); depth(&t) == 42 }))
    {
        1 /(1 - 1);
    }
}
