// CONFORMANCE-CASE
// facility: conf.exclusive-slice-arg-for-shared-param
// kind: positive
// expect: ok

import std;
fn total(slice<i64, shared> s) : i64
{
    i64 t = 0;
    foreach (x in s) { t += *x; }
    t
}
fn bump(slice<i64, exclusive> s)
{
    s[0] = total(s);
}
fn main()
{
    if (!({ array<i64, 3> a = [1, 2, 3]; bump(&mut a[0..$]); a[0] == 6 }))
    {
        assert(false);
    }
}
