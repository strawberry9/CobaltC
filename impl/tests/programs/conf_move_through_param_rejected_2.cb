// CONFORMANCE-CASE
// facility: conf.move-through-param-rejected
// kind: negative
// expect: diag.move-while-aliased (static)
//
// D-0282: moving out through a reference is refuted before the run.
// A plain value through a reference is copied, as ever.

import std;
fn dup<T>(ref<T, shared> r) : T
{
    *r
}
fn main()
{
    String x = "a";
    String y = dup(&x);
}
