// CONFORMANCE-CASE
// facility: conf.foreach-over-map-err-propagate
// kind: positive
// expect: ok
//
// `foreach` over `Result::map_err(…)?`: the mapped Result keeps its type.

import std;
fn mk() : Result<Vec<i32>, i32> { Vec<i32> v = Vec::new(); Vec::push(&mut v, 5); Ok(v) }
fn f() : Result<i32, String> { i32 s = 0; foreach (x in Result::map_err(mk(), [](i32 e) : String { sprintf("%d", e) })?) { s += x; } Ok(s) }
fn main()
{
    if (!(Result::unwrap(f()) == 5))
    {
        1 /(1 - 1);
    }
}
