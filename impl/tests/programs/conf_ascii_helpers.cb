// CONFORMANCE-CASE
// facility: conf.ascii-helpers
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!(ascii_is_digit(b'7') && !ascii_is_digit(b'x') && ascii_is_alpha(b'Q') && ascii_is_space(b'\t') && ascii_to_lower(b'A') == b'a' && ascii_to_upper(b'z') == b'Z' && ascii_to_lower(b'1') == b'1'))
    {
        assert(false);
    }
}
