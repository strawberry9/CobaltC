// CONFORMANCE-CASE
// facility: conf.foreach-hashset
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ HashSet<u8> h = HashSet::new(); HashSet::insert(&mut h, 4); HashSet::insert(&mut h, 5); u8 s = 0; foreach (x in &h) { s += *x; } s == 9 }))
    {
        assert(false);
    }
}
