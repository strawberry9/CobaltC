// CONFORMANCE-CASE
// facility: conf.str-value-view-local
// kind: positive
// expect: ok
//
// D-0302: a `str` value where a `StringView` is declared is a view of it.

import std;
fn main()
{
    if (!({ str t = "abc"; StringView v = t; StringView::len(v) == 3 }))
    {
        assert(false);
    }
}
