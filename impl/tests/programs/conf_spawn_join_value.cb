// CONFORMANCE-CASE
// facility: conf.spawn-join-value
// kind: positive
// expect: ok
//
// ---------- 12. Concurrency ----------
// `spawn`/`join`/`lock` run on real threads of the system:
// genuine OS scheduling,
// not a simulation.

import std;
fn work(i32 n) : i32
{
    n * 2
}
fn main()
{
    auto h = spawn(work, 21);
    if (join(h) != 42) { assert(false); }
}
