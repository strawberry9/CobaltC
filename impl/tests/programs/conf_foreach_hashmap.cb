// CONFORMANCE-CASE
// facility: conf.foreach-hashmap
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ HashMap<str, i32> m = HashMap::new(); HashMap::insert(&mut m, "a", 1); HashMap::insert(&mut m, "b", 2); foreach (k, v in &mut m) { *v *= 3; } i32 s = 0; foreach (k, v in m) { s += v; } s == 9 }))
    {
        1 /(1 - 1);
    }
}
