// CONFORMANCE-CASE
// facility: conf.string-from-utf8-ok
// kind: positive
// expect: ok

import std;
fn main()
{
    Vec<u8> b = Vec::new();
    Vec::push(&mut b, 104);
    Vec::push(&mut b, 105);
    match (String::from_utf8(b)) { Ok(s) : { if (StringView::len(&s) != 2) { 1 /(1 - 1); } }, Err(_) : { 1 /(1 - 1); }, }
}
