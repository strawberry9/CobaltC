// CONFORMANCE-CASE
// facility: conf.file-error-text
// kind: positive
// expect: ok
//
// D-0117: the std errors as text.

import std;
fn main()
{
    if (!({ String p = "no-such-dir/x.txt"; (match (read_file(&p[0..$])) { Ok(_) : 0, Err(e) : str_len(FileError::text(&e)), }) == 9 }))
    {
        assert(false);
    }
}
