// CONFORMANCE-CASE
// facility: conf.self-tail-call-borrowed-local-stack-exhausted
// kind: negative
// expect: diag.stack-exhausted (dynamic)
//
// The program runs on the implementation's own stack, whatever its
// size: a hundred million nested calls exhaust it, and the fault is
// diag.stack-exhausted.
//
// §2a condition 5: a frame whose binding is borrowed is a level of nesting.

import std;
fn down(u64 n) : u64
{
    u64 x = n;
    ref<u64, shared> r = &x;
    if (*r == 0) { 0 } else { down(n - 1) }
}
fn main()
{
    u64 d = down(100000000);
}
