// CONFORMANCE-CASE
// facility: conf.destructor-on-plain-type-rejected
// kind: positive
// expect: ok
//
// D-0075: a destructor needs a resource type.

import std;
resource struct R { u32 id; }
fn R::drop(ref<R, exclusive> self)
{
}
fn main()
{
    if (!({ R r = R { .id = 1 }; true }))
    {
        assert(false);
    }
}
