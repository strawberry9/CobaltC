// CONFORMANCE-CASE
// facility: conf.temp-borrow-in-condition
// kind: positive
// expect: ok

import std;
fn find(ref<Vec<i32>, shared> v, ref<i32, shared> x) : Option<usize>
{
    None
}
fn make_one() : i32
{
    1
}
fn main()
{
    if (!({ Vec<i32> v = Vec::new(); bool c = true; c && Option::is_none(&find(&v, &make_one())) }))
    {
        assert(false);
    }
}
