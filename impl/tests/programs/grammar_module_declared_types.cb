// CONFORMANCE-CASE
// kind: positive
// expect: ok

import std;
module geom
{
    export struct Point { export i32 x; export i32 y; }
    export enum Shape { Dot, Circle(i32) }
    export fn make(i32 x) : Point
    {
        Point { .x = x, .y = 0 }
    }
    export fn radius(Shape s) : i32
    {
        match (s) { Dot : 0, Circle(r) : r, }
    }
}
fn main()
{
    if (!({ geom::Point p = geom::Point { .x = 3, .y = 4 }; auto q = geom::make(1); geom::Shape s = geom::Shape::Circle(2); p.x + p.y + q.x + geom::radius(s) == 10 }))
    {
        assert(false);
    }
}
