// CONFORMANCE-CASE
// facility: conf.destructure-two-of-one-type
// kind: positive
// expect: ok

import std;
struct E { u64 w; u64 s; }
fn main()
{
    if (!({ E p = E { .w = 3, .s = 1 }; E q = E { .w = 4, .s = 2 }; E { w: wp, .. } = p; E { w: wq, .. } = q; wp + wq == 7 }))
    {
        1 /(1 - 1);
    }
}
