// CONFORMANCE-CASE
// facility: conf.closure-generic-inferred
// kind: positive
// expect: ok

import std;
fn map_all<T>(ref<Vec<u32>, shared> xs, fn(u32) : T f) : Vec<T>
{
    Vec<T> out = Vec::new();
    foreach (x in xs) { Vec::push(&mut out, f(*x)); }
    out
}
fn big(u32 x) : bool
{
    x > 3
}
fn main()
{
    if (!({ Vec<u32> xs = Vec::new(); Vec::push(&mut xs, 4); Vec<bool> ys = map_all(&xs, [](u32 x) { x > 3 }); Vec<bool> zs = map_all(&xs, big); ys[0] && zs[0] }))
    {
        assert(false);
    }
}
