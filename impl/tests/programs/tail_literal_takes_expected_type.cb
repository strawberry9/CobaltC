// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// Previously pinned as a known limitation for the implicit tail.

import std;
fn g() : i64
{
    5000000000
}
fn h(bool c) : i64
{
    if (c) { 6000000000 } else { 7000000000 }
}
fn main()
{
    if (!(g() == 5000000000 && h(true) == 6000000000 && h(false) == 7000000000))
    {
        assert(false);
    }
}
