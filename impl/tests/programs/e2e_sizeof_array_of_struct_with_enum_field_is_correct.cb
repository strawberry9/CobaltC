// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// ---------- Sanity-pass regressions on the byte encoding of the
// remaining kinds of type and value, found by systematically auditing
// every kind of type against its encoding after the Array and Enum
// fixes. Each of these was
// empirically confirmed broken before the
// fix it now guards.
// Root-cause bug: the size and alignment of an array type were
// once computed by a routine that
// could not see user-declared struct/enum layouts -- so
// sizeof<array<Foo,2>>() silently returned 0 even though the
// encoding of the array's bytes
// was fine all along. Foo { Option<i32> a; i32 b; } is 12 bytes;
// array<Foo,2> must be 24.

import std;
struct Foo { Option<i32> a; i32 b; }
fn main()
{
    usize sz = sizeof<array<Foo, 2>>();
    if (sz != 24) { assert(false); }
}
