// CONFORMANCE-CASE
// facility: conf.temp-borrow-joined-result
// kind: positive
// expect: ok

import std;
fn mk(u32 n) : Vec<u32>
{
    Vec<u32> v = Vec::new();
    Vec::push(&mut v, n);
    v
}
fn total(ref<Vec<u32>, shared> v) : u32
{
    v[0]
}
fn main()
{
    if (!({ auto h = spawn(mk, 7); total(&join(h)) == 7 }))
    {
        assert(false);
    }
}
