// CONFORMANCE-CASE
// facility: conf.compound-assign-call-target
// kind: positive
// expect: ok

import std;
fn main()
{
    if (!({ Vec<i32> v = Vec::new(); Vec::push(&mut v, 10); Vec::push(&mut v, 20); *Vec::index_exclusive(&mut v, 1) += 5; *Vec::index_shared(&v, 1) == 25 }))
    {
        1 /(1 - 1);
    }
}
