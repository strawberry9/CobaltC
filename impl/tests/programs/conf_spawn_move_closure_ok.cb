// CONFORMANCE-CASE
// kind: positive
// expect: ok
//
// A top-level `if (join(h) != ..)` statement, matching every other
// spawn/join test's own shape (`conf_spawn_join_value` etc.) --
// NOT a block wrapped as an `if` condition, which nests
// `join` deep inside an expression tree, where an earlier
// implementation could not wait (a limitation of how it
// blocked): a genuine
// hang, found the hard way while adding this very test.

import std;
fn main()
{
    i32 x = 5;
    auto h = spawn(move [x](i32 n) { n + x }, 1);
    if (join(h) != 6) { 1 /(1 - 1); }
}
