import std;
fn main()
{
    if (!({ i64 x = 5000000000; auto a = if (x > 1) { x } else { 0 }; auto b = if (x < 1) { 0 } else { x }; a + b == 10000000000 }))
    {
        1 /(1 - 1);
    }
}
