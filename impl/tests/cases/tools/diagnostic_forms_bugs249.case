# 344: a moved closure is not advised `clone`.
file p344.cb
import std;
fn apply(fn(i32) : String f, i32 x) : String
{
    f(x)
}
fn main()
{
    String unit = "kg";
    auto fmt = move [unit](i32 x) : String { sprintf("%v %v", x, &unit) };
    String a = apply(fmt, 1);
    String b = apply(fmt, 2);
    printf("%v / %v\n", &a, &b);
}
end
run $COBC --check p344.cb
status 1
stderr-has a function value has no copy
stderr-lacks clone(&fmt)

# 345: a literal at an unbounded type parameter, where it is written.
