# 248: a plain value where an `Option` is declared is wrapped.
file p248.cb
import std;
fn find(ref<Vec<i32>, shared> v, i32 x) : Option<usize>
{
    foreach (i, y in v)
    {
        if (*y == x)
        {
            return i;
        }
    }
    None
}
fn main()
{
    Option<i32> o = 5;
    _ = find(&Vec::new<i32>(), 1);
}
end
run $COBC --check p248.cb
status 1
stderr-has `Some(i)`
stderr-has `Some(5)`
stderr-lacks rule.arith.convert

