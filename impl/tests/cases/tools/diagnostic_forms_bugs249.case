# 283: the missing `from` clause, at the function that lacks it.
file p283.cb
import std;
struct Config { HashMap<String, String> values; }
fn Config::get(ref<Config, shared> c, StringView key) : Option<StringView>
{
    match (HashMap::get(&c.values, key))
    {
        Some(v) : Some(StringView::trim(v)),
        None    : None,
    }
}
fn Config::get_or(ref<Config, shared> c, StringView key, StringView dflt) : StringView from c, dflt
{
    Option::unwrap_or(Config::get(c, key), dflt)
}
fn main()
{
    Config c = Config { .values = HashMap::new() };
    printf("[%v]\n", Config::get_or(&c, "host", "localhost"));
}
end
run $COBC --check p283.cb
status 1
stderr-has error[diag.lifetime-elision-ambiguous]
stderr-has `from c, key`

# 294: a variant pattern without its enum.
file p294.cb
import std;
enum Kind
{
    Checking,
    Savings { u32 rate_bp; },
}
fn rate(Kind k) : u32
{
    if (Savings { rate_bp } = k)
    {
        return rate_bp;
    }
    0
}
fn main()
{
    printf("%v\n", rate(Kind::Savings { .rate_bp = 450 }));
}
end
run $COBC --check p294.cb
status 1
stderr-has `Kind::Savings { rate_bp }`

