# 251, 244: the body's last expression, and why it gives the wrong type.
file p251.cb
import std;
fn sign(i32 x) : i32
{
    if (x > 0)
    {
        return 1;
    }
    else if (x < 0)
    {
        return -1;
    }
}
fn add(i32 a, i32 b) : i32
{
    a + b;
}
fn save(StringView path) : Result<void, FileError>
{
    write_file(path, "data")?;
    printf("saved\n");
}
fn main()
{
    printf("%d %d\n", sign(2), add(1, 2));
    _ = save("x");
}
end
run $COBC --check p251.cb
status 1
stderr-has p251.cb:4:5
stderr-has this `if` has no `else`
stderr-has p251.cb:15:5
stderr-has a block's value is its last expression, written without `;`
stderr-has end the body with `Ok(())`
file p244.cb
import std;
fn main() : u8
{
    printf("hello\n");
}
end
run $COBC --check p244.cb
status 1
stderr-has end the body with `0`
stderr-lacks without `;`

