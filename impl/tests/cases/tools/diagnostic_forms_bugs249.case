# 257: the comma after the last arm may be left out (D-0337).
file p257.cb
import std;
enum Color { Red, Green }
fn main()
{
    Color c = Color::Green;
    i32 n = match (c)
    {
        Red   : 1,
        Green : 2
    };
    printf("%d\n", n);
}
end
run $COBC --run p257.cb
status 0
stdout-is 2\n

# 258: C's `break;` at the end of a `match` arm in a loop warns.
file p258.cb
import std;
fn main()
{
    foreach (cmd in 0..4)
    {
        match (cmd)
        {
            1 : { printf("one\n"); break; },
            2 : { printf("two\n"); break },
            _ : { printf("cmd %d\n", cmd); },
        }
    }
}
end
run $COBC --check p258.cb
status 0
stderr-has warning[diag.match-arm-break]
stderr-has p258.cb:8:36

