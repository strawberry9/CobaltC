# 241: a key held by reference in generic code: the `_ref` lookup.
file p241.cb
import std;
fn count_known<K>(ref<HashMap<K, i32>, shared> m, slice<K, shared> keys) : usize
{
    usize n = 0;
    foreach (k in keys)
    {
        if (HashMap::contains(m, *k))
        {
            n += 1;
        }
    }
    n
}
fn main()
{
    HashMap<String, i32> b = HashMap::new();
    Vec<String> ks = Vec::new();
    Vec::push(&mut ks, "x");
    printf("%v\n", count_known(&b, &ks));
}
end
run $COBC --check p241.cb
status 1
stderr-has `HashMap::contains_ref(…, k)`
stderr-lacks `&x`

