# 348: a closure captures a variable whole.
file p348.cb
import std;
struct Store { Vec<u32> items; u32 min; }
fn Store::prune(ref<Store, exclusive> s)
{
    Vec::retain(&mut s.items, [s](ref<u32, shared> x) : bool { *x >= s.min });
}
fn main()
{
    Store st = Store { .items = Vec::from_slice(&[1: u32, 5, 10]), .min = 4 };
    Store::prune(&mut st);
}
end
run $COBC --check p348.cb
status 1
stderr-has `auto min = s.min;`

# 349, 261: a function called through a type parameter.
file p349.cb
import std;
fn speak_all<T>(ref<T, shared> x)
{
    T::speak(x);
}
fn dup<T: clone>(ref<T, shared> x) : T
{
    T::clone(x)
}
fn main()
{
    speak_all(&1);
    _ = dup(&2);
}
end
run $COBC --check p349.cb
status 1
