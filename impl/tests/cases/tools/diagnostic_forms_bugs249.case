# 269, 270: no warning in a generic body's instantiation; `a - b >= 0`.
file p269.cb
import std;
fn sign_of<T: integer>(T x) : i32
{
    if (x < 0) { -1 } else if (x == 0) { 0 } else { 1 }
}
fn main()
{
    u32 stock = 5;
    u32 ordered = 3;
    if (stock - ordered >= 0)
    {
        printf("%v %v\n", sign_of(-7: i64), sign_of(Vec::len(&Vec::from_slice(&[1, 2]))));
    }
}
end
run $COBC --check p269.cb
status 0
stderr-has `stock >= ordered`
stderr-lacks `x` is a `usize`
stderr-lacks the value

