# The front end's messages for common slips (reports 241-349 of the push after
# Update 207): each names the form to write, with the program's own text, and
# none gives a repair line that does not fit. One program a slip.

# 249: `?` on a plain value; on a `Result` in an `Option` function.
file p249a.cb
import std;
fn read_count(ref<Vec<i32>, shared> v) : Result<usize, String>
{
    usize n = Vec::len(v)?;
    Ok(n)
}
fn main()
{
    _ = read_count(&Vec::new<i32>());
}
end
run $COBC --check p249a.cb
status 1
stderr-has `?` takes a `Result` or an `Option`, and this is a `usize`
stderr-lacks rule.arith.convert
file p249b.cb
import std;
fn port(StringView s) : Option<u16>
{
    u16 p = StringView::parse<u16>(s)?;
    Some(p)
}
fn main()
{
    printf("%v\n", Option::unwrap(port("80")));
}
end
run $COBC --check p249b.cb
status 1
stderr-has `Result::ok(r)?`

# 250: `printf(&name)`, `{}`, `%s` of a number.
file p250.cb
import std;
fn main()
{
    String name = "ann";
    i32 age = 30;
    printf(&name);
    printf("{} is {}\n", &name, age);
}
end
