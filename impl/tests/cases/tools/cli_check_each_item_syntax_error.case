# D-0321: a syntax error ends its item and the next is parsed; brackets that
# do not balance stop the parse at the first error (and no count is given).
file p.cb
import std;
fn f() : usize { 1 + }
struct P { usize a; };
fn g() : usize { 2usize }
fn main() { }
end
run $COBC --check p.cb
stderr-lines 3 error[diag.syntax-error]
stderr-ends \n3 errors\n
file q.cb
import std;
fn f() : usize { 1 + 
fn g() : usize { 2usize }
fn main() { }
end
run $COBC --check q.cb
stderr-lines 1 error[
stderr-lacks \ errors
