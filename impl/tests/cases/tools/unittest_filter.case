# D-0230: `--unittest-filter TEXT` runs only the tests whose name contains
# it, before or after `--unittest`; a filter that matches none is an error.
file t.cb
import std;

fn twice(i32 x) : i32
{
    x * 2
}

unittest "twice: small"
{
    assert(twice(2) == 4);
}

unittest
{
    assert(twice(3) == 7, "3 twice is %v", twice(3));
}

unittest "twice: overflow faults"
{
    i32 big = 2147483647;
    i32 _ = twice(big);
}

unittest "twice: zero"
{
    assert(twice(0) == 0);
}

fn main()
{
    printf("main\n");
}
end
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --unittest --unittest-filter "twice: " --cc $CC --run t.cb
status 1
stdout-ends 3 tests: 2 passed, 1 failed, 1 filtered out\n
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --unittest-filter zero --unittest --cc $CC --run t.cb
status 0
stdout-is test t.cb:24 twice: zero ... ok\n1 test: 1 passed, 0 failed, 3 filtered out\n
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --unittest --unittest-filter nothing --cc $CC --run t.cb
status 1
stdout-empty
stderr-is unittest: no test's name contains "nothing" (4 tests in all)\n
