# `--check` of several files reports each rejected one and a missing one
# (exit 2); with no file, the message says `--check` needs one (bug 035).
file a.cb
fn main()
{
    i32 x = true;
}
end
file b.cb
fn main()
{
    i32 y = "s";
}
end
run $COBC --check a.cb b.cb gone.cb
status 2
stderr-has a.cb: rejected
stderr-has b.cb: rejected
stderr-has cobc: gone.cb: no such file or directory
run $COBC --check
status 2
stderr-has cobc: --check needs a FILE.cb or a directory after it
