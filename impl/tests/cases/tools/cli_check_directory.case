# `--check DIR`: a module file is checked with the program that declares it,
# and a hidden directory is passed over; named on its own, a module file is
# checked as a program: it has no `main`.
file prog.cb
module m "./lib/m.cb";

fn main()
{
    m::f();
}
end
file lib/m.cb
export fn f()
{
}
end
file .hidden/bad.cb
fn main(
end
run $COBC --check .
status 0
run $COBC --check prog.cb lib/m.cb
status 1
stderr-has m.cb: rejected
stderr-has diag.no-main
