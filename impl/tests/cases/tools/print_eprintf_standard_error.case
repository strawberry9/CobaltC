# `eprintf` (spec/21 `rule.stdlib.format` [Eprintf]): its text goes to
# standard error, and nothing else does.
copy impl/conformance/21-standard-library-semantics/eprintf_stderr_ok.cb eprintf_stderr_ok.cb
run $COBC --cc $CC --run eprintf_stderr_ok.cb
status 0
stdout-is out 1\nout 2.5\n
stderr-is warning: odd input at line 7\n
