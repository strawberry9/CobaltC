# WI-9 (D-0228): `1` is the 62nd character of the line and its 64th byte (a
# tab and two two-byte `é` before it): the column counts characters, and the
# caret's padding keeps the tab and is a space for each other one (a tab and
# 60 spaces).
file t.cb
import std;

fn main()
{
	StringView v = StringView::of("éé"); bool b = true; i32 x = 1 + b;
}
end
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --run t.cb
status 1
stderr-has \ --> t.cb:5:62\n
stderr-has \  | \t                                                            ^\n
