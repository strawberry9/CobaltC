# Issue 023 ([Bidi-Controls], spec/22 1): a bidirectional control character
# in a comment or a string literal ("Trojan Source") is a syntax error naming
# it; the escape `\u{202E}` in a string stays allowed. cobfmt refuses it too.
file c.cb
import std;

fn main()
{
    bool is_admin = false;
    /*‮ } ⁦if (is_admin)⁩ ⁦ begin admins only */
        printf("You are an admin.\n");
    /* end admins only ‮ { ⁦*/
}
end
file s.cb
import std;

fn main()
{
    str level = "user‮ ⁦// Check if admin⁩ ⁦";
    printf("%v\n", str_len(level));
}
end
file e.cb
import std;

fn main()
{
    String rlo = "\u{202E}";
    printf("%v\n", StringView::len(&rlo));
}
end
run env NO_COLOR=1 $COBC --check c.cb
status 1
stderr-starts error[diag.syntax-error]: the bidirectional control character U+202E (RIGHT-TO-LEFT OVERRIDE) is not allowed in source text
stderr-has --> c.cb:6:
run env NO_COLOR=1 $COBC --check s.cb
status 1
stderr-has U+202E (RIGHT-TO-LEFT OVERRIDE)
stderr-has in a string literal write it as
run $COBC --cc $CC --run e.cb
status 0
stdout-is 3\n
run $BIN/cobfmt --check c.cb
status 2
