# WI-9 (D-0228): `--explain`, or COBALTC_EXPLAIN=1, adds the registry entry
# (the rule, where to read more) after the short form, which has none.
file e.cb
import std;

fn main()
{
    i32 x = 2147483647 + 1;
}
end
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --run e.cb
status 1
stderr-lacks rule:
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --explain --run e.cb
status 1
stderr-starts-as 1
stderr-has \n  rule:      `[Arith-Checked-Overflow]`
stderr-has \  see: spec/examples.md ->\s
run env NO_COLOR=1 env COBALTC_EXPLAIN=1 $COBC --run e.cb
status 1
stderr-starts-as 1
stderr-has \n  rule:      `[Arith-Checked-Overflow]`
stderr-has \  see: spec/examples.md ->\s
