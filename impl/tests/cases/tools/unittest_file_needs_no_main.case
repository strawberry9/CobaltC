# D-0230: a file of tests needs no `main` under `--unittest`; run as a
# program, it has none.
file lib.cb
import std;

export fn inc(i32 x) : i32
{
    x + 1
}

unittest "inc"
{
    assert(inc(1) == 2);
}
end
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --unittest --cc $CC --run lib.cb
status 0
stdout-is test lib.cb:8 inc ... ok\n1 test: 1 passed, 0 failed\n
stderr-empty
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --cc $CC --run lib.cb
status 1
stderr-starts error[diag.no-main]
