# D-0323: a statement of a generic body reached by two instantiations gives
# one error (two statements: two `error[` lines).
file p.cb
import std;

fn f<T>(T a) : usize
{
    usize n = nope;
    u8 m = also_nope;
    n
}

fn main()
{
    _ = f(1: i32);
    _ = f(true);
}
end
run $COBC --check p.cb
stderr-lines 2 error[
