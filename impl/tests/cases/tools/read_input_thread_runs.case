# Input read by a program that also runs a thread: the read does not keep the
# thread from running, and both finish, under each C compiler.
file read_thread.cb
import std;

fn count(u64 n) : u64
{
    u64 s = 0;
    u64 i = 0;
    while (i < n)
    {
        s = s + i;
        i = i + 1;
    }
    s
}

fn main()
{
    auto h = spawn(count, 1000);
    match (read_line())
    {
        Ok(o) : match (o)
        {
            Some(line) : printf("%v ", &line),
            None : printf("none "),
        },
        Err(_) : printf("err "),
    }
    printf("%v\n", join(h));
}
end
stdin hello\n
run $COBC --cc $CC --run read_thread.cb
stdout-is hello 499500\n
