# D-0178 (spec/21 `rule.stdlib.print` [Print-Buffer]): standard output is
# buffered, and a write to standard error writes it out first, so with both
# streams sent to one file the program's order is kept.
platform unix
copy impl/conformance/21-standard-library-semantics/stdout_buffer_order_ok.cb order.cb
run sh -c "$COBC --cc $CC --run order.cb > both.txt 2>&1"
status 0
file-is both.txt a\nb\nc\n
