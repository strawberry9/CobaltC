# WI-9 (D-0228): a syntax error names its column and shows the line with a
# caret under the token.
file y.cb
import std;

fn main()
{
    i32 x = 1 +;
}
end
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --run y.cb
status 1
stderr-starts error[diag.syntax-error]: expected an expression, found `;`\n --> y.cb:5:16\n  |\n5 |     i32 x = 1 +;\n  |                ^\n
