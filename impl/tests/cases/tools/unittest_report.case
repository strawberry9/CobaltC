# D-0230: `--unittest`, the report of a test run and its status: each test,
# a failure's fault, the run going on after it, the count; the program itself
# runs `main`, and no test (`cobc --run`, under each C compiler).
file t.cb
import std;

fn twice(i32 x) : i32
{
    x * 2
}

unittest "twice: small"
{
    assert(twice(2) == 4);
}

unittest
{
    assert(twice(3) == 7, "3 twice is %v", twice(3));
}

unittest "twice: overflow faults"
{
    i32 big = 2147483647;
    i32 _ = twice(big);
}

unittest "twice: zero"
{
    assert(twice(0) == 0);
}

fn main()
{
    printf("main\n");
}
end
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --unittest --cc $CC --run t.cb
status 1
stderr-empty
stdout-is test t.cb:8 twice: small ... ok\ntest t.cb:13 ... FAILED\nfault[diag.assert-failed]: 3 twice is 6 (6 == 7)\n  --> t.cb:15:5\n   |\n15 |     assert(twice(3) == 7, "3 twice is %v", twice(3));\n   |     ^^^^^^\n   = repair: the program's own condition names what was assumed; find why it did not hold\ntest t.cb:18 twice: overflow faults ... FAILED\nfault[diag.arith-overflow]: 2147483647 * 2 is outside `i32` (-2147483648 to 2147483647)\n --> t.cb:5:7\n  |\n5 |     x * 2\n  |       ^\n  = repair: widen, or use `wrapping_`/`saturating_`/`checked_`\ntest t.cb:24 twice: zero ... ok\n4 tests: 2 passed, 2 failed\n
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --cc $CC --run t.cb
status 0
stdout-is main\n
stderr-empty
