# WI-9 (D-0228): a fault is located by its line and column, the line shown
# with carets under the call (the program `cobc --run` builds, under each C
# compiler).
file d.cb
import std;

fn main()
{
    i32 a = 2147483647;
    i32 b = narrow<i32>(arg_count()) + 1;
    printf("%v\n", a + b);
}
end
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --cc $CC --run d.cb
status 1
stderr-starts fault[diag.arith-overflow]: arithmetic overflow\n --> d.cb:7:5\n  |\n7 |     printf("%v\\n", a + b);\n  |     ^^^^^^\n  = repair:\s
