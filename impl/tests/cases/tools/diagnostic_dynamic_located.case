# WI-9 (D-0228): a fault is located by its line and column, the line shown
# with a caret under the operator that faulted, the one `+` of the line
# (report 252; the program `cobc --run` builds, under each C compiler).
file d.cb
import std;

fn main()
{
    i32 a = 2147483647;
    i32 b = narrow<i32>(arg_count()) + 1;
    printf("%v\n", a + b);
}
end
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --cc $CC --run d.cb
status 1
stderr-starts fault[diag.arith-overflow]: 2147483647 + 1 is outside `i32` (-2147483648 to 2147483647)\n --> d.cb:7:22\n  |\n7 |     printf("%v\\n", a + b);\n  |                      ^\n  = repair:\s
