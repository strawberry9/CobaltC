# `--warn-shadow` (CHG-0333): a note per item of the program whose name hides
# an imported one, at its file and line; nothing else changes (`cobc --run`
# and `cobc --check`).
file shadow.cb
import std;

fn min(i64 a, i64 b) : i64
{
    if (a < b) { a } else { b }
}

fn main()
{
    printf("%v\n", min(3: i64, 2: i64));
}
end
run $COBC --warn-shadow --cc $CC --run shadow.cb
status 0
stdout-is 2\n
stderr-has note: fn `min` of this program hides `std::min`
stderr-has --> shadow.cb:3
run $COBC --cc $CC --run shadow.cb
status 0
stderr-empty
run $COBC --warn-shadow --check shadow.cb
status 0
stderr-has hides `std::min`
