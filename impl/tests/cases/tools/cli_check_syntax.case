# `--check-syntax` (CHG-0346): whether one text parses, as cobfmt asks it; a
# program the static pass would reject still parses, and a module file is
# found relative to `--origin` when the text comes on standard input (a
# module's syntax error reported where it is); without one, from the current
# directory, and where it cannot be found, the text is parsed alone. A
# missing file, no file, or two: usage errors.
file lib/m.cb
export fn f()
{
}
end
file prog.cb
module m "./lib/m.cb";

fn main()
{
    i32 x = true;
}
end
file bad.cb
fn main()
{
    x = ;
}
end
run $COBC --check-syntax prog.cb
status 0
stdout-empty
stderr-empty
run $COBC --check-syntax bad.cb
status 1
stderr-is bad.cb:3: expected an expression, found `;` (column 9)\n
file lib/m.cb
export fn f(
{
}
end
stdin module m "./lib/m.cb";\n\nfn main()\n{\n    i32 x = true;\n}\n
run $COBC --check-syntax --origin prog.cb -
status 1
stderr-has m.cb:2:
stdin module m "./lib/m.cb";\n\nfn main()\n{\n    i32 x = true;\n}\n
run $COBC --check-syntax -
status 1
stderr-has m.cb:2:
stdin module m "./lib/m.cb";\n\nfn main()\n{\n    i32 x = true;\n}\n
run in lib $COBC --check-syntax -
status 0
run $COBC --check-syntax gone.cb
status 2
run $COBC --check-syntax
status 2
run $COBC --check-syntax a.cb b.cb
status 2
