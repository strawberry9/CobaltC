# CHG-0451: `--doc` of a built-in function, `--doc language`, `--doc --find`,
# and a name that names nothing listing the items with a part of it.
# (`--find stdin` finds one item, `stdin_read`.)
run $COBC --doc widen
status 0
stdout-starts fn widen<U>(T x) : U\n    in `the language`
run $COBC --doc spawn
status 0
stdout-has handle<R>
run $COBC --doc language
status 0
stdout-has fn slice_len(
stdout-has fn join<T>(
run $COBC --doc --find stdin
status 0
stdout-has stdin_read
stdout-ends \sitem\n
run $COBC --doc --find nothing_like_this_anywhere
status 1
run $COBC --doc read_to_string
status 1
stderr-has items with a part of that name:
stderr-has fn read_line()
