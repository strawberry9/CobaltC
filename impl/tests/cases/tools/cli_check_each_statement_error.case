# D-0321, D-0323: every independent static error in one report, one for each
# item, and within a body each statement's that stands on its own, in source
# order, the first as before (the first, third and fourth `error[` lines are
# checked), then the count.
file p.cb
import std;

fn f() : usize
{
    true
}

fn g() : bool
{
    3
}

fn main()
{
    usize x = nope;
    u8 y = also_nope;
}
end
run $COBC --check p.cb
status 1
stderr-lines 4 error[
stderr-line 1 "`f` returns `usize`" error[
stderr-line 3 "`nope`" error[
stderr-line 4 "`also_nope`" error[
stderr-ends \n4 errors\n
