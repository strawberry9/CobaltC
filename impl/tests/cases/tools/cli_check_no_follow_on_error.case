# D-0323: what a failed statement declares or leaves unknown, and what
# follows a failed `return`, gives no second error; the report says when a
# statement was not checked; past ten errors, ten are shown and the count
# (`cobc --check`). Written by gen/cli_follow_on.py.
file typed.cb
import std;

fn main()
{
    usize x = nope;
    printf("%v\n", x + 1);
}
end
run $COBC --check typed.cb
stderr-lines 1 error[
stderr-lacks note: statements
file auto.cb
import std;

fn main()
{
    auto x = 3 + true;
    printf("%v\n", x + 1);
    u8 z = later_nope;
}
end
run $COBC --check auto.cb
stderr-lines 2 error[
stderr-ends \n2 errors\nnote: statements that depend on a failed statement were not checked\n
file init.cb
import std;

fn main()
{
    i32 w;
    if (arg_count() > 0) { w = bad; } else { w = 1; }
    printf("%v\n", w);
}
end
run $COBC --check init.cb
stderr-lines 1 error[
stderr-ends \nnote: statements that depend on a failed statement were not checked\n
file ret.cb
import std;

fn main()
{
    return nope;
    u8 z = also_nope;
}
end
run $COBC --check ret.cb
stderr-lines 1 error[
file eleven.cb
import std;

fn main()
{
    u8 v0 = nope0;
    u8 v1 = nope1;
    u8 v2 = nope2;
    u8 v3 = nope3;
    u8 v4 = nope4;
    u8 v5 = nope5;
    u8 v6 = nope6;
    u8 v7 = nope7;
    u8 v8 = nope8;
    u8 v9 = nope9;
    u8 v10 = nope10;
}
end
run $COBC --check eleven.cb
stderr-lines 10 error[
