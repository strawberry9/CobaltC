# The front end's messages for common slips (reports 047-231 of the push after
# Update 206): each names the form to write, and none gives a repair line that
# does not fit. One program a slip.

# 047: a `foreach` binder over `StringView::split`'s parts is printed through.
file p047.cb
import std;
fn main()
{
    Vec<StringView> words = StringView::split("alpha,beta", ",");
    foreach (w in &words)
    {
        printf("%s %v\n", w, w);
    }
}
end
run $COBC --run p047.cb
status 0
stdout-is alpha alpha\nbeta beta\n

# 050: near names, by case and by spelling.
file p050.cb
import std;
struct P { i32 x; i32 y; }
fn main()
{
    P p = P { .x = 1, .y = 2 };
    printf("%v\n", p.X);
    StringView s = "ab";
    printf("%v\n", StringView::lenght(s));
    auto m = Hashmap::new();
}
end
run $COBC --check p050.cb
status 1
stderr-has `P` has no field `X`; did you mean `x`?
stderr-has did you mean `StringView::len`?
stderr-has did you mean `HashMap::new`?

# 053: a float exponent names `powf`.
file p053.cb
import std;
fn main()
{
    printf("%v\n", pow(1.05, 2.5));
}
end
run $COBC --check p053.cb
status 1
stderr-has for a floating-point exponent use `powf(x, y)`

# 055: two comparisons in an argument list are comparisons.
file p055.cb
import std;
fn main()
{
    i32 a = 1;
    i32 b = 2;
    i32 c = 3;
    i32 d = 0;
    printf("%v %v\n", a < b, c > d);
}
end
run $COBC --run p055.cb
status 0
stdout-is true true\n

# 058: `==` on a `Vec` names `Vec::eq`.
