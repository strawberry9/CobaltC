# 084: `&s` of a binder that is a reference already.
file p084.cb
import std;
fn main()
{
    String out = String::new();
    Option<String> name = Some("ada");
    match (&name)
    {
        Some(s) : String::append(&mut out, &s),
        None    : {},
    }
}
end
run $COBC --check p084.cb
status 1
stderr-has so write it without `&`
stderr-lacks = repair

