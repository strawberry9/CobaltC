# 120 and 231: a library with tests is checked as its tests are; the errors
# of externs and of bodies are all reported.
file lib120.cb
import std;
fn add(i32 a, i32 b) : i32
{
    a + b
}
unittest "add"
{
    assert(add(1, 2) == 3);
}
end
run $COBC --check lib120.cb
status 0
file p231.cb
import std;
unsafe extern fn set_name(String s);
unsafe extern fn set_tags(Vec<u8> t);
fn f() : i32
{
    "x"
}
fn main()
{
}
end
run $COBC --check p231.cb
status 1
stderr-has `set_name` cannot cross to C
stderr-has `set_tags` cannot cross to C
stderr-has `f` returns `i32`, but its body gives `str`
