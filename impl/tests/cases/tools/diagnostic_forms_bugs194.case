# 068 and 125: the warnings, the program accepted.
file p068.cb
import std;
fn main()
{
    usize n = 3;
    i32 count = 0;
    while (n >= 0)
    {
        break;
    }
    count == count + 1;
}
end
run $COBC --check p068.cb
status 0
stderr-has warning[diag.comparison-constant]: this comparison is always true: `n` is a `usize`
stderr-has warning[diag.no-effect]: this `==` compares, and its result is not used

