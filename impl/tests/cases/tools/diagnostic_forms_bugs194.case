stderr-lacks \\xNN` and `\\u

# 087, 088, 193: a reference, a value, an array, as each is passed.
file p087.cb
import std;
fn count(StringView w) : usize
{
    StringView::len(w)
}
fn total(slice<i32, shared> s) : i32
{
    0
}
fn main()
{
    HashMap<u64, String> names = HashMap::new();
    u64 id = 7;
    _ = HashMap::get(&names, &id);
    Vec<StringView> ws = StringView::split("a b", " ");
    foreach (w in &ws)
    {
        _ = count(w);
    }
    array<i32, 3> a = [1, 2, 3];
    _ = total(a);
}
end
run $COBC --check p087.cb
status 1
stderr-has pass the value itself: `id`, without `&`
stderr-has pass its value, `*w`
stderr-has lend it: `&a`

