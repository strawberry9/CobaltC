# The static pass checks `std`'s items as a program reaches them; this is
# where `std` itself is verified whole: with `COBALTC_CHECK_ALL=1` every item
# is checked, and an empty program must still be accepted (`cobc --run`).
file empty.cb
fn main()
{
}
end
run env COBALTC_CHECK_ALL=1 $COBC --cc $CC --run empty.cb
status 0
stderr-empty
