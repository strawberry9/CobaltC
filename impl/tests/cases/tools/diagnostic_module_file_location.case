# WI-9 (D-0228): an error in a file-backed module names that file, its line
# and column, and shows its line.
file main.cb
import std;

module m "./m.cb";

fn main()
{
    m::go();
}
end
file m.cb
export fn go()
{
    bool b = true;
    i32 x = 1 + b;
}
end
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --run main.cb
status 1
stderr-has \ --> m.cb:4:13\n  |\n4 |     i32 x = 1 + b;\n  |             ^\n
