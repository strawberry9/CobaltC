# WI-9 (D-0228): a fault inside `std` (`Option::unwrap`) is reported at the
# program's line that called it, under each C compiler.
file u.cb
import std;

fn main()
{
    Option<i32> o = None;
    i32 x = Option::unwrap(o);
    printf("%v\n", x);
}
end
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --cc $CC --run u.cb
status 1
stderr-starts fault[diag.unwrap-failed]:\s
stderr-has \ --> u.cb:6:5\n
