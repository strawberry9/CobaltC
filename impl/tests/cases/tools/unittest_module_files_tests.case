# D-0230: a module file's tests run where it is declared, and see its
# private items.
file main.cb
import std;

module m "./m.cb";

unittest "root"
{
    assert(m::one() == 1);
}

fn main()
{
}
end
file m.cb
import std;

fn hidden() : i32
{
    1
}

export fn one() : i32
{
    hidden()
}

unittest "hidden"
{
    assert(hidden() == 1);
}
end
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --unittest --cc $CC --run main.cb
status 0
stdout-is test m.cb:13 hidden ... ok\ntest main.cb:5 root ... ok\n2 tests: 2 passed, 0 failed\n
stderr-empty
