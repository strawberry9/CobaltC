# D-0299: `--certificate FILE` with `--check`, and with a run (`cobc --run`):
# what the static pass decided, body by body, the file written either way. A
# rejected program names its diagnostic; a directory is refused.
file prog.cb
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    bump(&mut x);
    printf("%v\n", x);
}
end
run $COBC --certificate c.txt --check prog.cb
status 0
file-starts c.txt CobaltC certificate 1\ntool: cobc\nprogram: prog.cb\nverdict: static pass: every body decided (
file-has c.txt \nfn main: decided\n
file-has c.txt \nfn bump: decided\n
run $COBC --certificate c2.txt --cc $CC --run prog.cb
status 0
stdout-is 2\n
file-has c2.txt \nfn main: decided\n
file bad.cb
import std;

fn main()
{
    i32 x = 1;
    auto r = &mut x;
    printf("%v\n", x);
    *r = 2;
}
end
run $COBC --certificate c3.txt --check bad.cb
status 1
file-has c3.txt \nverdict: rejected: diag.aliasing-conflict\n
run $COBC --certificate c4.txt --check .
status 2
