# Every program in impl/cobaltc_examples/ runs to completion, and one with
# tests (a line that begins `unittest`) passes them (D-0230: the report's
# last line counts no failure); under each C compiler. A file without a
# root `fn main` (a module body such as 13_geometry.cb) is not a program
# and is skipped; the file that declares it exercises it. Written by
# gen/examples_run.py, which lists the directory's files; run it again when
# one is added (`--check` says whether this file is current).
copy impl/cobaltc_examples/01_hello.cb 01_hello.cb
copy impl/cobaltc_examples/02_fizzbuzz.cb 02_fizzbuzz.cb
copy impl/cobaltc_examples/03_primes.cb 03_primes.cb
copy impl/cobaltc_examples/04_ownership.cb 04_ownership.cb
copy impl/cobaltc_examples/05_shapes.cb 05_shapes.cb
copy impl/cobaltc_examples/06_errors.cb 06_errors.cb
copy impl/cobaltc_examples/07_generic_stack.cb 07_generic_stack.cb
copy impl/cobaltc_examples/08_closures.cb 08_closures.cb
copy impl/cobaltc_examples/09_threads.cb 09_threads.cb
copy impl/cobaltc_examples/10_shared_rc.cb 10_shared_rc.cb
copy impl/cobaltc_examples/11_checked_arithmetic.cb 11_checked_arithmetic.cb
copy impl/cobaltc_examples/12_collatz.cb 12_collatz.cb
copy impl/cobaltc_examples/13_geometry.cb 13_geometry.cb
copy impl/cobaltc_examples/13_modules.cb 13_modules.cb
copy impl/cobaltc_examples/14_unittest.cb 14_unittest.cb
run $COBC --cc $CC --run 01_hello.cb
status 0
run $COBC --cc $CC --run 02_fizzbuzz.cb
status 0
run $COBC --cc $CC --run 03_primes.cb
status 0
run $COBC --cc $CC --run 04_ownership.cb
status 0
run $COBC --cc $CC --run 05_shapes.cb
status 0
run $COBC --cc $CC --run 06_errors.cb
status 0
run $COBC --cc $CC --run 07_generic_stack.cb
status 0
run $COBC --cc $CC --run 08_closures.cb
status 0
run $COBC --cc $CC --run 09_threads.cb
status 0
run $COBC --cc $CC --run 10_shared_rc.cb
status 0
run $COBC --cc $CC --run 11_checked_arithmetic.cb
status 0
run $COBC --cc $CC --run 12_collatz.cb
status 0
run $COBC --cc $CC --run 13_modules.cb
status 0
run $COBC --cc $CC --run 14_unittest.cb
status 0
run $COBC --unittest --cc $CC --run 14_unittest.cb
status 0
stdout-ends \spassed, 0 failed\n
