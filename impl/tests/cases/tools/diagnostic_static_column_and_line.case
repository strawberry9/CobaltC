# WI-9 (D-0228): the form a static diagnostic is shown in: its column, the
# line shown with a caret under the token, the repair (`cobc --run FILE`,
# without colour, COBALTC_EXPLAIN off).
file s.cb
import std;

fn main()
{
    bool b = true;
    i32 x = 1 + b;
}
end
run env NO_COLOR=1 env COBALTC_EXPLAIN=0 $COBC --run s.cb
status 1
stderr-is error[diag.type-mismatch]: the operands are `i32` and `bool`; convert one (`widen`, `narrow`, `to_float`)\n --> s.cb:6:13\n  |\n6 |     i32 x = 1 + b;\n  |             ^\n  = repair: convert explicitly (`rule.arith.convert`) or fix the types\n
