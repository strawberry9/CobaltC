# D-0285: a program the first lowering finds decided is lowered again
# knowing it: the C says so (`CB_DECIDED`), a view copied and walked in a
# function needs no object and its statements no scopes, and the program
# ends as its first lowering does (COBALTC_DECIDED=0), under both C compilers.
file prog.cb
import std;

fn count(StringView v) : u64
{
    u64 n = 0;
    foreach (c in StringView::chars(v))
    {
        n += 1;
    }
    n
}

fn main()
{
    String s = String::copy("héllo");
    StringView v = &s;
    printf("%v %v\n", count(v), count(&v[0..1]));
}
end
run env COBALTC_DECIDED=1 $COBC -v --keep-c --cc $CC -o d prog.cb
status 0
stderr-has lowered pathless and decided (D-0284, D-0285)
file-starts d.c #define CB_PATHLESS 1\n#define CB_DECIDED 1\n
cut d.c count.c "static uint64_t f_count(struct s_std__StringView p_v)\n{" "\n}\n"
file-lacks count.c cb_new(
file-lacks count.c cb_stmt_push
file-lacks count.c cb_copy_datum(
run ./d
status 0
stdout-is 5 1\n
run env COBALTC_DECIDED=0 $COBC -v --keep-c --cc $CC -o p prog.cb
status 0
stderr-has lowered pathless (D-0284)
file-starts p.c #define CB_PATHLESS 1\n
file-lacks p.c #define CB_DECIDED
run ./p
status 0
stdout-is 5 1\n
