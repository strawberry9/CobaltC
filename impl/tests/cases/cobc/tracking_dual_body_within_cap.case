fn main()
{
    Vec<u8> v = Vec::filled(10, 3: u8);
    Acc a = Acc { .sum = 0, .n = 0 };
    feed(&mut a, &v[0..$]);
    feed_big(&mut a, &v[2..6]);
    printf("%v %v\n", a.sum, a.n);
}
end
run env COBALTC_PATHLESS=0 $COBC --keep-c -o prog prog.cb
status 0
file-like prog.c \ f_feed__fast(…)\n
file-like prog.c \ f_feed__slow(…)\n
file-like prog.c \ f_feed(…)\n
file-lacks prog.c \ f_feed_big__fast(
file-lacks prog.c \ f_feed_big__slow(
file-like prog.c \ f_feed_big(…)\n
run ./prog
stdout-is 30 2110\n
