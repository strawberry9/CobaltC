# CHG-0486: a label is a join for the pass that drops implied checks. The
# right operand of `&&` is not evaluated here, so its read of `p.x` is not
# made, and the read after it faults on the second pass, where `keep` holds
# `&mut p.x`: one line printed, the fault at the read.
file l1.cb
import std;

struct P
{
    i32 x;
    i32 y;
}

fn main()
{
    P p = P { .x = 1, .y = 2 };
    Option<ref<i32, exclusive>> keep = None;
    usize k = 0;
    while (k < 2)
    {
        bool big = k > 5 && p.x > 3;
        i32 b = p.x;
        printf("%d\n", b);
        if (big)
        {
            k += 1;
        }
        keep = Some(&mut p.x);
        k += 1;
    }
    match (keep)
    {
        Some(r) : *r = 5,
        None    : {},
    }
}
end
run $COBC --cc $CC --run l1.cb
status 1
stdout-is 1\n
stderr-has diag.aliasing-conflict
stderr-has l1.cb:17:9
