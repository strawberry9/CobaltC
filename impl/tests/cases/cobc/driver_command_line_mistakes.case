# Bug 035: a mistake on the command line says what is wrong with which
# argument, and points to --help, instead of printing the whole usage.
file p.cb
import std;

fn main()
{
}
end
run $COBC -O 9 --run p.cb
status 2
stderr-starts cobc: -O 9: the optimisation level is 0, 1, 2, 3, s or g\n
stderr-has Try `cobc --help`
run $COBC -Ofast p.cb
status 2
stderr-starts cobc: -Ofast: the optimisation level
run $COBC --explore abc p.cb
status 2
stderr-starts cobc: --explore abc: a whole number above 0 is expected\n
run $COBC --bogus-flag p.cb
status 2
stderr-starts cobc: unknown option --bogus-flag\n
run $COBC --run --check p.cb
status 2
stderr-starts cobc: --check must be the first argument
run $COBC p.cb q.cb
status 2
stderr-starts cobc: q.cb: a second FILE.cb
run $COBC -o
status 2
stderr-starts cobc: -o needs a file name after it\n
