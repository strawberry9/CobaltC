# D-0309: a frame's notes (D-0269, `cb_nt`) are kept only where the program
# can spawn a thread (`drop_unused_notes`): a program that never calls
# `cb_spawn` has none, and one that does keeps them. Both give the output
# recorded here under gcc and clang, writing nothing to standard error.
file alone.cb
import std;

fn count(usize limit) : u64
{
    Vec<bool> marks = Vec::filled(limit, true);
    String name = String::copy("marks");
    for (usize m = 0; m < limit; m += 3)
    {
        marks[m] = false;
    }
    u64 n = 0;
    foreach (k in 0..limit)
    {
        if (marks[k])
        {
            n += 1;
        }
    }
    n + narrow<u64>(StringView::len(&name))
}

fn main()
{
    printf("%v\n", count(1000));
}
end
file threaded.cb
import std;

fn count(usize limit) : u64
{
    Vec<bool> marks = Vec::filled(limit, true);
    for (usize m = 0; m < limit; m += 3)
    {
        marks[m] = false;
    }
    u64 n = 0;
    foreach (k in 0..limit)
    {
        if (marks[k])
        {
            n += 1;
        }
    }
    n
}

fn main()
{
    u64 a = join(spawn(count, 1000));
    printf("%v %v\n", a, count(30));
}
end
run $COBC --emit-c -o alone.c alone.cb
status 0
file-lacks alone.c cb_nt[
run $COBC --cc $CC -o alone alone.cb
status 0
run ./alone
stdout-is 671\n
stderr-empty
run $COBC --emit-c -o threaded.c threaded.cb
status 0
file-has threaded.c cb_nt[
run $COBC --cc $CC -o threaded threaded.cb
status 0
run ./threaded
stdout-is 666 20\n
stderr-empty
