# 313: the same `&mut` lent to `spawn` on each round of a loop, the
# handles kept past the round: refused, naming the binding.
file lend_loop.cb
import std;

fn worker(ref<u64, exclusive> c)
{
    *c += 1;
}

fn main()
{
    u64 count = 0;
    {
        Vec<handle<void>> hs = Vec::new();
        foreach (i in 0..4)
        {
            Vec::push(&mut hs, spawn(worker, &mut count));
        }
    }
    printf("count %v\n", count);
}
end
run $COBC --check lend_loop.cb
status 1
stderr-has `count` may still be lent exclusively to a thread
# ... while a handle that ends with its round may lend it again.
file lend_round.cb
import std;

fn worker(ref<u64, exclusive> c)
{
    *c += 1;
}

fn main()
{
    u64 count = 0;
    foreach (i in 0..4)
    {
        auto h = spawn(worker, &mut count);
        join(h);
    }
    printf("count %v\n", count);
}
end
run $COBC --run lend_round.cb
status 0
stdout-is count 4\n
# 318: a resource moved out of a lock guard, whole or a field: refused,
# naming the exchange.
file guard_move.cb
import std;

fn take_batch(ref<mutex<Vec<String>>, shared> queue) : Vec<String>
{
    auto g = lock(queue);
    Vec<String> batch = *g;
    batch
}

fn main()
{
    mutex<Vec<String>> queue = Mutex::new(Vec::new());
    printf("%v\n", Vec::len(&take_batch(&queue)));
}
end
run $COBC --check guard_move.cb
status 1
stderr-has diag.move-while-aliased
stderr-has replace(&mut *g,
file guard_field.cb
import std;

struct Job
{
    String name;
    u32 tries;
}

fn main()
{
    mutex<Job> m = Mutex::new(Job { .name = "a", .tries = 0 });
    auto g = lock(&m);
    String n = g.name;
    printf("%s\n", &n);
}
end
