# The static pass and the two build forms on the reports of the push after
# Update 207 (265, 266, 267, 268, 273, 290, 291, 292, 293, 313, 318, 320,
# 346): correct programs the checker refused or the forms disagreed on, run
# in the default form and with --all-checks; programs that passed the check
# and always (or by timing) faulted, refused now.
#
# 265: a view, or a `Vec` of views or shared references, declared before
# the text it refers to ends after the block's last statement, before the
# block's exit destroys that text, in both forms.
file views_before_text.cb
import std;

fn main()
{
    Vec<StringView> words = Vec::new();
    String line = "alpha beta gamma";
    words = StringView::split(&line, " ");
    printf("%v words, first %s\n", Vec::len(&words), words[0]);
    {
        StringView best = "";
        String a = "alpha";
        best = &a;
        printf("%s\n", best);
    }
    {
        Vec<ref<String, shared>> names = Vec::new();
        String b = "x";
        Vec::push(&mut names, &b);
        printf("%s\n", names[0]);
    }
}
end
run $COBC --run views_before_text.cb
status 0
stdout-is 3 words, first alpha\nalpha\nx\n
run $COBC --all-checks --run views_before_text.cb
status 0
stdout-is 3 words, first alpha\nalpha\nx\n
# 266: copies of a `move` closure that writes none of its captures share
# its box and are called at once from two threads, its `self` shared (in
# the closure's body, and in the runtime's light borrow of the box).
file closure_copies.cb
import std;

fn apply_many(fn(i32) : i32 f, i32 n) : i32
{
    i32 t = 0;
    foreach (i in 0..n)
    {
        t += f(i);
    }
    t
}

fn main()
{
    i32 k = 3;
    fn(i32) : i32 s = move [k](i32 x) : i32 { x * k };
    handle<i32> a = spawn(apply_many, s, 1000);
    handle<i32> b = spawn(apply_many, s, 1000);
    printf("%v\n", join(a) + join(b));
}
end
run $COBC --run closure_copies.cb
status 0
stdout-is 2997000\n
run $COBC --explore 6 closure_copies.cb
status 0
run $COBC --all-checks --run closure_copies.cb
status 0
stdout-is 2997000\n
# 267: a view copied out of a field through an exclusive reference refers
# to the text, not to the field, which may then be advanced from it.
file view_field_advance.cb
import std;

struct Cursor
{
    StringView rest;
    u32 n;
}

fn skip_one(ref<Cursor, exclusive> c)
{
    StringView r = c.rest;
    c.rest = &r[1..$];
}

fn skip_count(ref<Cursor, exclusive> c)
{
    StringView r = c.rest;
    c.n += 1;
    c.rest = &r[1..$];
}

fn main()
{
    String text = "abcd";
    Cursor c = Cursor { .rest = &text, .n = 0 };
    skip_one(&mut c);
    skip_count(&mut c);
    printf("%s %v\n", c.rest, c.n);
}
end
run $COBC --run view_field_advance.cb
status 0
stdout-is cd 1\n
run $COBC --all-checks --run view_field_advance.cb
status 0
stdout-is cd 1\n
# 268: a reference last used in an `else if` condition ends there, and at
# the start of the branches before it that do not name it, in both forms.
file else_if_end.cb
import std;

fn main()
{
    Vec<u32> w = Vec::from_slice(&[1: u32, 1]);
    ref<u32, shared> it = &w[0];
    if (*it == 0)
    {
        w[1] = 7;
    }
    else if (*it == 1)
    {
        w[0] = 9;
    }
    ref<u32, shared> jt = &w[1];
    if (*jt == 5)
    {
        w[0] = 1;
    }
    else if (*jt == 6)
    {
        w[0] = 2;
    }
    else
    {
        w[1] = 3;
    }
    printf("%v %v\n", w[0], w[1]);
}
end
run $COBC --run else_if_end.cb
status 0
stdout-is 9 3\n
run $COBC --all-checks --run else_if_end.cb
status 0
stdout-is 9 3\n
# ... and one named again in a later branch is not ended early.
file else_if_late.cb
import std;

fn main()
{
    u32 x = 1;
    ref<u32, shared> it = &x;
    if (*it == 0)
    {
        x = 7;
    }
    else if (*it == 1)
    {
        x = 9;
        printf("%v\n", *it);
    }
}
end
run $COBC --check else_if_late.cb
status 1
stderr-has still borrows
# 273: a `match` on a local does not fold the local's known value into
