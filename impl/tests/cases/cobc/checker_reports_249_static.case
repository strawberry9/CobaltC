# 290: `slice_len(&v)` read in the statement that writes `v` borrows
# nothing past the read, in both forms.
file len_write.cb
import std;

fn main()
{
    Vec<u8> v = Vec::from_slice(&[1: u8, 2, 3]);
    v[slice_len(&v) - 1] = 9;
    Vec<u32> w = Vec::from_slice(&[4: u32, 5]);
    w[0] = w[slice_len(&w) - 1];
    Vec::push(&mut w, narrow<u32>(slice_len(&w)));
    Vec::insert(&mut w, slice_len(&w), 8);
    array<u32, 3> a = [1, 2, 3];
    a[slice_len(&a) - 1] = 7;
    printf("%v %v %v %v %v %v\n", v[2], w[0], w[2], w[3], a[2], slice_len(&w));
}
end
run $COBC --run len_write.cb
status 0
stdout-is 9 5 2 8 7 4\n
run $COBC --all-checks --run len_write.cb
status 0
stdout-is 9 5 2 8 7 4\n
