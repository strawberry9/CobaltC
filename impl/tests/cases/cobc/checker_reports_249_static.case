# 346: `==` of two references to a `T: eq` is identity, warned of.
file ref_identity.cb
import std;

fn contains<T: eq>(slice<T, shared> xs, ref<T, shared> v) : bool
{
    foreach (x in xs)
    {
        if (x == v)
        {
            return true;
        }
    }
    false
}

fn main()
{
    Vec<String> w = Vec::new();
    Vec::push(&mut w, "b");
    String s = "b";
    printf("%v\n", contains(&w, &s));
}
end
run $COBC --check ref_identity.cb
status 0
stderr-has warning[diag.reference-identity]
stderr-has `*x == *v`
