file escape_vec.cb
import std;

fn words() : Vec<StringView>
{
    String src = sprintf("%s %s", "hello", "world");
    StringView::split_whitespace(&src)
}

fn main()
{
    Vec<StringView> w = words();
    printf("%v\n", Vec::len(&w));
}
end
run $COBC --check escape_vec.cb
status 1
stderr-has diag.reference-escapes-scope
stderr-has `src`
file escape_struct.cb
import std;

struct Tok
{
    StringView text;
}

fn lex() : Vec<Tok>
{
    String src = sprintf("%s %s", "hello", "world");
    Vec<Tok> out = Vec::new();
    foreach (w in StringView::split_whitespace(&src))
    {
        Vec::push(&mut out, Tok { .text = w });
    }
    out
}

fn main()
{
    Vec<Tok> toks = lex();
    printf("%v\n", Vec::len(&toks));
}
end
run $COBC --check escape_struct.cb
status 1
stderr-has diag.reference-escapes-scope
# ... while views of a parameter's text are returned.
file views_of_param.cb
import std;

struct Tok
{
    StringView text;
}

fn lex(StringView src) : Vec<Tok>
{
    Vec<Tok> out = Vec::new();
    foreach (w in StringView::split_whitespace(src))
    {
        Vec::push(&mut out, Tok { .text = w });
    }
    out
}

fn words(ref<String, shared> s) : Vec<StringView>
{
    StringView::split_whitespace(s)
}

fn main()
{
    String s = "a b c";
    printf("%v %v\n", Vec::len(&lex(&s)), Vec::len(&words(&s)));
}
end
run $COBC --run views_of_param.cb
status 0
stdout-is 3 3\n
# 292: a binder or reference last named in one branch of a nested `if`
# ends there after its last mention, in both forms.
file binder_nested.cb
import std;

enum Mode
{
    Normal,
    Insert(String),
}

struct Ed
{
    Mode mode;
    Vec<String> lines;
}

fn finish(ref<Ed, exclusive> e, u8 k)
{
    match (&e.mode)
    {
        Normal      : {},
        Insert(buf) :
        {
            if (k == b'\n')
            {
                Vec::push(&mut e.lines, String::clone(buf));
                e.mode = Normal;
            }
        },
    }
}

enum T
{
    Num(f64),
    End,
}

struct P
{
    T cur;
    u32 n;
}

fn advance(ref<P, exclusive> p)
{
    p.cur = End;
    p.n += 1;
}

fn f(ref<P, exclusive> p, bool go) : f64
{
    if (T::Num(x) = &p.cur)
    {
        if (go)
        {
            f64 v = *x;
            advance(p);
            return v;
        }
    }
    0.0
}

fn g(ref<P, exclusive> p, bool go) : f64
{
    if (T::Num(x) = &p.cur)
    {
        if (go)
        {
            advance(p);
        }
        else
        {
            f64 v = *x;
            advance(p);
            return v;
        }
    }
    0.0
}

fn main()
{
    Ed e = Ed { .mode = Insert("hello"), .lines = Vec::new() };
    finish(&mut e, b'\n');
    P p = P { .cur = T::Num(2.5), .n = 0 };
    P q = P { .cur = T::Num(1.5), .n = 0 };
    f64 a = f(&mut p, true);
    f64 b = g(&mut q, false);
    printf("%v %v %v %v %v\n", Vec::len(&e.lines), a, p.n, b, q.n);
}
end
run $COBC --run binder_nested.cb
status 0
stdout-is 1 2.5 1 1.5 1\n
run $COBC --all-checks --run binder_nested.cb
status 0
stdout-is 1 2.5 1 1.5 1\n
# ... and one named after the write in the same branch is still refused.
file binder_nested_late.cb
import std;

enum Mode
{
    Normal,
    Insert(String),
}

fn finish(ref<Mode, exclusive> m, bool k) : usize
{
    match (&*m)
    {
        Normal      : 0,
        Insert(buf) :
        {
            if (k)
            {
                *m = Normal;
                printf("%s\n", buf);
                return 2;
            }
            1
        },
    }
}

fn main()
{
    Mode m = Insert("hello");
    printf("%v\n", finish(&mut m, true));
}
end
run $COBC --check binder_nested_late.cb
status 1
stderr-has still borrows
# 293: `slice_len` of a borrowed `const` array.
file const_len.cb
import std;

const array<str, 3> NAMES = ["a", "b", "c"];

fn count(slice<str, shared> s) : usize
{
    slice_len(s)
}

fn main()
{
    printf("%v %v\n", count(&NAMES), slice_len(&NAMES));
    foreach (i in 0..slice_len(&NAMES))
    {
        printf("%s", NAMES[i]);
    }
    printf("\n");
}
end
