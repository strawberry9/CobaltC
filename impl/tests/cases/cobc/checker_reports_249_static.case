# ... and the exchange works.
file guard_replace.cb
import std;

fn take_batch(ref<mutex<Vec<String>>, shared> queue) : Vec<String>
{
    auto g = lock(queue);
    replace(&mut *g, Vec::new())
}

fn main()
{
    mutex<Vec<String>> queue = Mutex::new(Vec::new());
    {
        auto g = lock(&queue);
        Vec::push(&mut *g, "job");
    }
    Vec<String> b = take_batch(&queue);
    printf("%v\n", Vec::len(&b));
}
end
run $COBC --run guard_replace.cb
status 0
stdout-is 1\n
