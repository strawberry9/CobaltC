# Report 073: a `match` on text of more than 64 arms, each a text literal but
# a last catch-all, finds its arm by a binary search of the literals in byte
# order (two tables of the function's own and `cb_bytes_cmp`), not by
# comparing each in turn: the C compiler's time grew about tenfold per
# doubling past 8,000 arms (16,000: 136 s of GCC, 4.4 s in this form). The
# right arm for each literal: the empty text, prefixes of each other, a
# non-ASCII one (bytes above 0x7f sort after ASCII), the first and the last;
# a miss goes to the catch-all; a `String` scrutinee moved into the binder of
# the catch-all; `break` and `continue` in an arm go to the loop around the
# `match`; a literal arm's statement-form body. Under --all-checks too, and
# the C has the table.
file m.cb
import std;
fn kind(StringView w) : u32
{
    match (w)
    {
        "" : 0, "a" : 1, "ab" : 2, "abc" : 3, "b" : 4, "é" : 5, "z" : 6, "zz" : 7, "~" : 8, "A" : 9, "kw0" : 10, "kw1" : 11, "kw2" : 12, "kw3" : 13, "kw4" : 14, "kw5" : 15, "kw6" : 16, "kw7" : 17, "kw8" : 18, "kw9" : 19, "kw10" : 20, "kw11" : 21, "kw12" : 22, "kw13" : 23, "kw14" : 24, "kw15" : 25, "kw16" : 26, "kw17" : 27, "kw18" : 28, "kw19" : 29, "kw20" : 30, "kw21" : 31, "kw22" : 32, "kw23" : 33, "kw24" : 34, "kw25" : 35, "kw26" : 36, "kw27" : 37, "kw28" : 38, "kw29" : 39, "kw30" : 40, "kw31" : 41, "kw32" : 42, "kw33" : 43, "kw34" : 44, "kw35" : 45, "kw36" : 46, "kw37" : 47, "kw38" : 48, "kw39" : 49, "kw40" : 50, "kw41" : 51, "kw42" : 52, "kw43" : 53, "kw44" : 54, "kw45" : 55, "kw46" : 56, "kw47" : 57, "kw48" : 58, "kw49" : 59, "kw50" : 60, "kw51" : 61, "kw52" : 62, "kw53" : 63, "kw54" : 64, "kw55" : 65, "kw56" : 66, "kw57" : 67, "kw58" : 68, "kw59" : 69, "kw60" : 70, "kw61" : 71, "kw62" : 72, "kw63" : 73, "kw64" : 74, "kw65" : 75, "kw66" : 76, "kw67" : 77, "kw68" : 78, "kw69" : 79, "kw70" : 80, "kw71" : 81, "kw72" : 82, "kw73" : 83, "kw74" : 84, "kw75" : 85, "kw76" : 86, "kw77" : 87, "kw78" : 88, "kw79" : 89, "kw80" : 90, "kw81" : 91, "kw82" : 92, "kw83" : 93, "kw84" : 94, "kw85" : 95, "kw86" : 96, "kw87" : 97, "kw88" : 98, "kw89" : 99,
        _ : 999,
    }
}
fn own(String s) : String
{
    match (s)
    {
        "" : String::copy("lit0"), "a" : String::copy("lit1"), "ab" : String::copy("lit2"), "abc" : String::copy("lit3"), "b" : String::copy("lit4"), "é" : String::copy("lit5"), "z" : String::copy("lit6"), "zz" : String::copy("lit7"), "~" : String::copy("lit8"), "A" : String::copy("lit9"), "kw0" : String::copy("lit10"), "kw1" : String::copy("lit11"), "kw2" : String::copy("lit12"), "kw3" : String::copy("lit13"), "kw4" : String::copy("lit14"), "kw5" : String::copy("lit15"), "kw6" : String::copy("lit16"), "kw7" : String::copy("lit17"), "kw8" : String::copy("lit18"), "kw9" : String::copy("lit19"), "kw10" : String::copy("lit20"), "kw11" : String::copy("lit21"), "kw12" : String::copy("lit22"), "kw13" : String::copy("lit23"), "kw14" : String::copy("lit24"), "kw15" : String::copy("lit25"), "kw16" : String::copy("lit26"), "kw17" : String::copy("lit27"), "kw18" : String::copy("lit28"), "kw19" : String::copy("lit29"), "kw20" : String::copy("lit30"), "kw21" : String::copy("lit31"), "kw22" : String::copy("lit32"), "kw23" : String::copy("lit33"), "kw24" : String::copy("lit34"), "kw25" : String::copy("lit35"), "kw26" : String::copy("lit36"), "kw27" : String::copy("lit37"), "kw28" : String::copy("lit38"), "kw29" : String::copy("lit39"), "kw30" : String::copy("lit40"), "kw31" : String::copy("lit41"), "kw32" : String::copy("lit42"), "kw33" : String::copy("lit43"), "kw34" : String::copy("lit44"), "kw35" : String::copy("lit45"), "kw36" : String::copy("lit46"), "kw37" : String::copy("lit47"), "kw38" : String::copy("lit48"), "kw39" : String::copy("lit49"), "kw40" : String::copy("lit50"), "kw41" : String::copy("lit51"), "kw42" : String::copy("lit52"), "kw43" : String::copy("lit53"), "kw44" : String::copy("lit54"), "kw45" : String::copy("lit55"), "kw46" : String::copy("lit56"), "kw47" : String::copy("lit57"), "kw48" : String::copy("lit58"), "kw49" : String::copy("lit59"), "kw50" : String::copy("lit60"), "kw51" : String::copy("lit61"), "kw52" : String::copy("lit62"), "kw53" : String::copy("lit63"), "kw54" : String::copy("lit64"), "kw55" : String::copy("lit65"), "kw56" : String::copy("lit66"), "kw57" : String::copy("lit67"), "kw58" : String::copy("lit68"), "kw59" : String::copy("lit69"), "kw60" : String::copy("lit70"), "kw61" : String::copy("lit71"), "kw62" : String::copy("lit72"), "kw63" : String::copy("lit73"), "kw64" : String::copy("lit74"), "kw65" : String::copy("lit75"), "kw66" : String::copy("lit76"), "kw67" : String::copy("lit77"), "kw68" : String::copy("lit78"), "kw69" : String::copy("lit79"), "kw70" : String::copy("lit80"), "kw71" : String::copy("lit81"), "kw72" : String::copy("lit82"), "kw73" : String::copy("lit83"), "kw74" : String::copy("lit84"), "kw75" : String::copy("lit85"), "kw76" : String::copy("lit86"), "kw77" : String::copy("lit87"), "kw78" : String::copy("lit88"), "kw79" : String::copy("lit89"), "kw80" : String::copy("lit90"), "kw81" : String::copy("lit91"), "kw82" : String::copy("lit92"), "kw83" : String::copy("lit93"), "kw84" : String::copy("lit94"), "kw85" : String::copy("lit95"), "kw86" : String::copy("lit96"), "kw87" : String::copy("lit97"), "kw88" : String::copy("lit98"), "kw89" : String::copy("lit99"),
        other : other,
    }
}
fn main()
{
    auto probe = ["", "a", "ab", "abc", "abcd", "b", "é", "z", "zz", "~", "A", "kw0", "kw89", "kw90", "k", "kw4", "kw45"];
    foreach (p in &probe)
    {
        printf("%v ", kind(*p));
    }
    printf("\n");
    printf("%s %s\n", &own(String::copy("kw7")), &own(String::copy("none")));
    u32 total = 0;
    foreach (p in &probe)
    {
        match (*p)
        {
            "" : { total += 0; }, "a" : { total += 1; }, "ab" : { total += 2; }, "abc" : { total += 3; }, "b" : continue, "é" : { total += 5; }, "z" : break, "zz" : { total += 7; }, "~" : { total += 8; }, "A" : { total += 9; }, "kw0" : { total += 10; }, "kw1" : { total += 11; }, "kw2" : { total += 12; }, "kw3" : { total += 13; }, "kw4" : { total += 14; }, "kw5" : { total += 15; }, "kw6" : { total += 16; }, "kw7" : { total += 17; }, "kw8" : { total += 18; }, "kw9" : { total += 19; }, "kw10" : { total += 20; }, "kw11" : { total += 21; }, "kw12" : { total += 22; }, "kw13" : { total += 23; }, "kw14" : { total += 24; }, "kw15" : { total += 25; }, "kw16" : { total += 26; }, "kw17" : { total += 27; }, "kw18" : { total += 28; }, "kw19" : { total += 29; }, "kw20" : { total += 30; }, "kw21" : { total += 31; }, "kw22" : { total += 32; }, "kw23" : { total += 33; }, "kw24" : { total += 34; }, "kw25" : { total += 35; }, "kw26" : { total += 36; }, "kw27" : { total += 37; }, "kw28" : { total += 38; }, "kw29" : { total += 39; }, "kw30" : { total += 40; }, "kw31" : { total += 41; }, "kw32" : { total += 42; }, "kw33" : { total += 43; }, "kw34" : { total += 44; }, "kw35" : { total += 45; }, "kw36" : { total += 46; }, "kw37" : { total += 47; }, "kw38" : { total += 48; }, "kw39" : { total += 49; }, "kw40" : { total += 50; }, "kw41" : { total += 51; }, "kw42" : { total += 52; }, "kw43" : { total += 53; }, "kw44" : { total += 54; }, "kw45" : { total += 55; }, "kw46" : { total += 56; }, "kw47" : { total += 57; }, "kw48" : { total += 58; }, "kw49" : { total += 59; }, "kw50" : { total += 60; }, "kw51" : { total += 61; }, "kw52" : { total += 62; }, "kw53" : { total += 63; }, "kw54" : { total += 64; }, "kw55" : { total += 65; }, "kw56" : { total += 66; }, "kw57" : { total += 67; }, "kw58" : { total += 68; }, "kw59" : { total += 69; }, "kw60" : { total += 70; }, "kw61" : { total += 71; }, "kw62" : { total += 72; }, "kw63" : { total += 73; }, "kw64" : { total += 74; }, "kw65" : { total += 75; }, "kw66" : { total += 76; }, "kw67" : { total += 77; }, "kw68" : { total += 78; }, "kw69" : { total += 79; }, "kw70" : { total += 80; }, "kw71" : { total += 81; }, "kw72" : { total += 82; }, "kw73" : { total += 83; }, "kw74" : { total += 84; }, "kw75" : { total += 85; }, "kw76" : { total += 86; }, "kw77" : { total += 87; }, "kw78" : { total += 88; }, "kw79" : { total += 89; }, "kw80" : { total += 90; }, "kw81" : { total += 91; }, "kw82" : { total += 92; }, "kw83" : { total += 93; }, "kw84" : { total += 94; }, "kw85" : { total += 95; }, "kw86" : { total += 96; }, "kw87" : { total += 97; }, "kw88" : { total += 98; }, "kw89" : { total += 99; },
            _ : { total += 1000; },
        }
        total += 1;
    }
    printf("%v\n", total);
}
end
run $COBC --run m.cb
status 0
stdout-is 0 1 2 3 999 4 5 6 7 8 9 10 99 999 999 14 55 \nlit17 none\n1017\n
run $COBC --all-checks --run m.cb
status 0
stdout-is 0 1 2 3 999 4 5 6 7 8 9 10 99 999 999 14 55 \nlit17 none\n1017\n
run $COBC --emit-c m.cb
status 0
stdout-has static const cb_str mtab
