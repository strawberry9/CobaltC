# A loop over a struct's `Vec` field in a function where a closure names the
# struct is not confined (`--report-tracking` with the record kept).
file prog.cb
import std;

struct H
{
    Vec<i64> v;
}

fn captured() : i64
{
    H h = H { .v = Vec::new() };
    i64 t = 0;
    foreach (i in 0..Vec::len(&h.v))
    {
        t += h.v[i]; // c
    }
    auto f = [h]() : usize { Vec::len(&h.v) * 0 };
    t + narrow<i64>(f())
}

fn main()
{
    printf("%v\n", captured());
}
end
run env COBALTC_PATHLESS=0 $COBC --report-tracking prog.cb
status 0
lists-line prog.cb // c
