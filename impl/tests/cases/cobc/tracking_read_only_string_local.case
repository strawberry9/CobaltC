# A `String` local only ever handed to readers has no runtime object: the
# received object's record ends at once and the local is dropped where it
# ends. So has one also appended to by `std`'s builders (D-0196); one lent
# `&mut` to a function of the program keeps its object (`--report-tracking`
# with the record kept).
file prog.cb
import std;

fn reads(usize n) : usize
{
    usize t = 0;
    foreach (i in 0..n)
    {
        String s = sprintf("%v", i); // r
        t += StringView::len(&s);
    }
    t
}

fn grows(usize n) : usize
{
    usize t = 0;
    foreach (i in 0..n)
    {
        String s = sprintf("%v", i); // a
        String::append(&mut s, "!");
        t += StringView::len(&s);
    }
    t
}

fn touch(ref<String, exclusive> s)
{
    String::append(s, "?");
}

fn lent(usize n) : usize
{
    usize t = 0;
    foreach (i in 0..n)
    {
        String s = sprintf("%v", i); // g
        touch(&mut s);
        t += StringView::len(&s);
    }
    t
}

fn main()
{
    printf("%v %v %v\n", reads(3), grows(3), lent(3));
}
end
run env COBALTC_PATHLESS=0 $COBC --report-tracking prog.cb
status 0
listed-lacks prog.cb "// r" "bind x"
listed-lacks prog.cb "// r" "move_to x"
listed-lacks prog.cb "// a" "bind x"
listed-lacks prog.cb "// a" "move_to x"
listed-has prog.cb "// g" "bind x"
