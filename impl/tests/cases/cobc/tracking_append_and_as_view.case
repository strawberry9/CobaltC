# `String::append(&mut s, x)` for a local `s`: the borrow is checked and none
# is minted; `&t` handed to a function that only reads the view: its checks,
# and no path, slot or object (`--report-tracking` with the record kept).
file prog.cb
import std;

fn reads(StringView s) : usize
{
    StringView::len(s)
}

fn main()
{
    String out = String::new();
    String text = "abc";
    usize total = 0;
    foreach (i in 0..3)
    {
        String::append(&mut out, i); // n
        String::append(&mut out, ","); // l
        total += reads(&text); // v
    }
    printf("%v %v\n", StringView::len(&out), total);
}
end
run env COBALTC_PATHLESS=0 $COBC --report-tracking prog.cb
status 0
listed-lacks prog.cb "// n" " borrow x"
listed-lacks prog.cb "// n" " borrow_range x"
listed-lacks prog.cb "// n" " new x"
listed-lacks prog.cb "// n" " store_ref x"
listed-lacks prog.cb "// n" " absorb x"
listed-lacks prog.cb "// l" " borrow x"
listed-lacks prog.cb "// l" " borrow_range x"
listed-lacks prog.cb "// l" " new x"
listed-lacks prog.cb "// l" " store_ref x"
listed-lacks prog.cb "// l" " absorb x"
listed-lacks prog.cb "// v" " borrow x"
listed-lacks prog.cb "// v" " borrow_range x"
listed-lacks prog.cb "// v" " new x"
listed-lacks prog.cb "// v" " store_ref x"
listed-lacks prog.cb "// v" " absorb x"
