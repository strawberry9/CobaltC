# A confined vector passed to a confining helper, or pushed onto, beside a
# plain local whose last use is that call (the local is moved into the call,
# `Scan::block`): the vector stays confined, so the helper runs its unchecked
# copy and nothing in `main` or the helper is tracked (`--report-tracking`
# with the record kept).
file prog.cb
import std;

fn mark(ref<Vec<bool>, exclusive> v, usize limit)
{
    foreach (m in 0..limit)
    {
        v[m] = false; // mark
    }
}

fn main()
{
    usize n = 100;
    Vec<bool> v = Vec::new();
    foreach (i in 0..100)
    {
        Vec::push(&mut v, true); // fill
    }
    bool b = true;
    Vec::push(&mut v, b); // push
    mark(&mut v, n); // call
    printf("%v\n", v[5]); // read
}
end
run env COBALTC_PATHLESS=0 $COBC --report-tracking prog.cb
status 0
omits-line prog.cb // mark
omits-line prog.cb // fill
omits-line prog.cb // push
omits-line prog.cb // call
omits-line prog.cb // read
