# Report 080: a closure that captures a local, kept in a `Vec` or a
# `HashMap` inside an inner block, lets the local go when the container
# ends (its element's end ends the closure stored there, and the borrows
# its captures hold), as a struct field or an `Option` does; so does one
# popped from a `Vec`. Default form and --all-checks, under each C
# compiler.
file v.cb
import std;

fn main()
{
    u32 clicks = 0;
    {
        Vec<fn(u32)> handlers = Vec::new();
        Vec::push(&mut handlers, [clicks](u32 n) { clicks += n; });
        (handlers[0])(5);
    }
    printf("%v\n", clicks);
    {
        HashMap<u32, fn(u32)> hs = HashMap::new();
        _ = HashMap::insert(&mut hs, 1, [clicks](u32 n) { clicks += n; });
    }
    clicks += 1;
    {
        Vec<fn(u32)> reads = Vec::new();
        Vec::push(&mut reads, [clicks](u32 n) { printf("%v\n", clicks + n); });
        (reads[0])(1);
    }
    clicks = 3;
    {
        Vec<fn(u32)> more = Vec::new();
        Vec::push(&mut more, [clicks](u32 n) { clicks += n; });
        fn(u32) f = Option::unwrap(Vec::pop(&mut more));
        f(2);
    }
    printf("%v\n", clicks);
}
end
run $COBC --cc $CC -o v v.cb
status 0
run ./v
status 0
stdout-is 5\n7\n5\n
run $COBC --cc $CC --all-checks -o va v.cb
status 0
run ./va
status 0
stdout-is 5\n7\n5\n
