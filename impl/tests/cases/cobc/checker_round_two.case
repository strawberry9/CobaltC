# The second round of the push after Update 206 (reports 109, 114, 136,
# 183, and the view escaping a guard found with 136).
#
# A view a `match` (or `if (P = e)`) binder holds of the scrutinee's
# temporary (here a lock's guard) may be used in the arm, but a copy of it
# used after the `match` is refused (D-0135): the guard is gone.
file escape.cb
import std;

fn leak(ref<mutex<HashMap<u64, String>>, shared> m, u64 k) : usize
{
    StringView kept = "";
    match (HashMap::get(&*lock(m), k))
    {
        Some(n) : { kept = n; },
        None    : {},
    }
    StringView::len(kept)
}

fn main()
{
    HashMap<u64, String> h = HashMap::new();
    HashMap::insert(&mut h, 1, "abc");
    mutex<HashMap<u64, String>> m = Mutex::new(h);
    printf("%v\n", leak(&m, 1));
}
end
run $COBC --check escape.cb
status 1
stderr-has `kept` holds a view of a temporary of the `match`
file escape_if.cb
import std;

fn leak(ref<mutex<HashMap<u64, String>>, shared> m, u64 k) : usize
{
    StringView kept = "";
    if (Some(n) = HashMap::get(&*lock(m), k))
    {
        kept = n;
    }
    StringView::len(kept)
}

fn main()
{
    mutex<HashMap<u64, String>> m = Mutex::new(HashMap::new());
    printf("%v\n", leak(&m, 1));
}
end
run $COBC --check escape_if.cb
status 1
stderr-has `kept` holds a view of a temporary of the `match`
# 136: the `if (P = e)` form and the `match` form agree.
file guarded.cb
import std;

fn with_match(ref<mutex<HashMap<u64, String>>, shared> m, u64 k) : usize
{
    match (HashMap::get(&*lock(m), k))
    {
        Some(n) : StringView::len(n),
        None    : 0,
    }
}

fn with_if(ref<mutex<HashMap<u64, String>>, shared> m, u64 k) : usize
{
    if (Some(n) = HashMap::get(&*lock(m), k))
    {
        StringView t = n;
        return StringView::len(t);
    }
    0
}

fn main()
{
    HashMap<u64, String> h = HashMap::new();
    HashMap::insert(&mut h, 1, "abc");
    mutex<HashMap<u64, String>> m = Mutex::new(h);
    printf("%v %v\n", with_match(&m, 1), with_if(&m, 1));
}
end
run $COBC --run guarded.cb
status 0
stdout-is 3 3\n
run $COBC --all-checks --run guarded.cb
status 0
stdout-is 3 3\n
# 114: a reference whose last use is an `if`'s condition ends there, in
# the checker and in the run, so the write in the branch is accepted by both
# forms; one used in the branch too still conflicts.
file condend.cb
import std;

fn main()
{
    Vec<u32> v = Vec::from_slice(&[0: u32, 1]);
    ref<u32, shared> it = &v[0];
    if (*it == 0)
    {
        v[0] = 5;
    }
    printf("%v\n", v[0]);
}
end
run $COBC --run condend.cb
status 0
stdout-is 5\n
run $COBC --all-checks --run condend.cb
status 0
stdout-is 5\n
file condend_used.cb
import std;

fn main()
{
    Vec<u32> v = Vec::from_slice(&[0: u32, 1]);
