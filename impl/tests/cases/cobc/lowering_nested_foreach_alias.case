# A foreach over a Vec reference nested in another, an outer element's field compared with the inner
# element (`l.start <= *s`): cobc once numbered a copied node with the id `synth` had just given (the counter
# taken before stepping by `number_expr`, after by `synth`), and the id-keyed facts read the inner element as
# the outer's: C that GCC and Clang reject. Found building the model in CobaltC (D-0326).
file t.cb
import std;

struct Loop
{
    usize start;
    usize end;
}

struct P
{
    Vec<Loop> loops;
    Vec<Vec<usize>> mentions;
}

fn live(ref<P, shared> p, usize id, usize at) : bool
{
    ref<Vec<usize>, shared> ms = &p.mentions[id];
    foreach (l in &p.loops)
    {
        if (l.start <= at && at < l.end)
        {
            foreach (s in ms)
            {
                if (l.start <= *s && *s < l.end)
                {
                    return true;
                }
            }
        }
    }
    false
}

fn main()
{
    P p = P { .loops = Vec::new(), .mentions = Vec::new() };
    Vec::push(&mut p.loops, Loop { .start = 1, .end = 9 });
    Vec<usize> m = Vec::new();
    Vec::push(&mut m, 3);
    Vec::push(&mut p.mentions, m);
    printf("%v\n", live(&p, 0, 5));
}
end
run $COBC --cc $CC --run t.cb
status 0
stdout-is true\n
