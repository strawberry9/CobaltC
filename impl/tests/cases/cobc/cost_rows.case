# D-0315, `spec/14` §6 "The cost contract": a decided program whose values all end
# in the program's own code keeps no cleanup bookkeeping: `--report-tracking` says
# it is decided and lists no line.
copy impl/conformance/07-resource-authority/drop_plain_local_ok.cb p0.cb
run $COBC --report-tracking p0.cb
status 0
stdout-starts no run-time tracking
stdout-lacks .cb:
copy impl/conformance/11-initialization/destructure_memory_only_ok.cb p1.cb
run $COBC --report-tracking p1.cb
status 0
stdout-starts no run-time tracking
stdout-lacks .cb:
copy impl/conformance/14-control-flow/foreach_by_value_memory_only_ok.cb p2.cb
run $COBC --report-tracking p2.cb
status 0
stdout-starts no run-time tracking
