# D-0189: a function whose one reference is to a struct, looping over the
# struct's `Vec` field, gets a dual body (`__fast`, `__slow`: defined, a line
# naming it that ends its signature); a field also borrowed whole (`&g.cells`
# handed to a function) does not (no `f_other__fast` in the C at all). With
# the record kept.
file prog.cb
import std;

struct G
{
    Vec<i64> cells;
    i64 total;
}

fn count(ref<Vec<i64>, shared> v) : usize
{
    Vec::len(v)
}

fn step(ref<G, exclusive> g)
{
    for (usize i = 0; i < Vec::len(&g.cells); i += 1)
    {
        g.cells[i] = g.cells[i] + 1;
        g.total += g.cells[i];
    }
}

fn other(ref<G, exclusive> g)
{
    for (usize i = 0; i < count(&g.cells); i += 1)
    {
        g.total += g.cells[i];
    }
}

fn main()
{
    G g = G { .cells = Vec::filled(10, 1: i64), .total = 0 };
    step(&mut g);
    other(&mut g);
    printf("%v\n", g.total);
}
end
run env COBALTC_PATHLESS=0 $COBC --keep-c -o prog prog.cb
status 0
file-like prog.c \ f_step__fast(…)\n
file-like prog.c \ f_step__slow(…)\n
file-lacks prog.c \ f_other__fast(
run ./prog
stdout-is 40\n
