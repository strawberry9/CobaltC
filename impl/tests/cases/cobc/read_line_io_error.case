# `read_line`'s `Err(Io)` (spec/21 `rule.stdlib.read`), which a conformance
# case's `stdin-hex:` header cannot produce: standard input here is a
# directory, so reading it fails.
platform unix
file read_io.cb
import std;

fn main()
{
    match (read_line())
    {
        Ok(_) :
        {
            printf("ok\n");
        },
        Err(e) :
        {
            match (e)
            {
                Io :
                {
                    printf("io\n");
                },
                Utf8(_) :
                {
                    printf("utf8\n");
                },
                _ :
                {
                    printf("other\n");
                },
            }
        },
    }
}
end
run sh -c "$COBC --cc $CC --run read_io.cb < ."
status 0
stdout-is io\n
