# A closure with no written result type whose body ends in a `return` has the
# type of the value it returns (the checker's open item F30): the back end
# learned the type from the body's own value, which is `never` there, and the
# compiler stopped where the result was printed. A body that returns from two
# places, and one whose value is an open variant, beside it.
file c.cb
import std;

fn main()
{
    auto f = []() { return 5; };
    auto g = [](i32 x) { if (x > 2) { return x * 2; } return x; };
    Option<i32> o = Some(4);
    auto h = [o]() { i32 v = o?; Some(v + 1) };
    printf("%v %v %v\n", f(), g(3), g(1));
    match (h())
    {
        Some(x) : printf("%v\n", x),
        None    : printf("none\n"),
    }
}
end
run $COBC --run c.cb
status 0
stdout-is 5 6 1\n5\n
run $COBC --all-checks --run c.cb
status 0
stdout-is 5 6 1\n5\n
