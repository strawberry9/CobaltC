# Report 065: the arithmetic fault names both operands and the type for `+`,
# `-` and `*` of every integer type at its edges (the minimum and maximum,
# a negative second operand, the minimum times -1, products past the type),
# the operands rebuilt from the wrapped result or the double-width product.
# Under each C compiler.
file a.cb
import std;

// Opaque to the static pass: the operands are known only when the program runs.
fn keep<T>(T v) : T
{
    if (arg_count() > 9)
    {
        fault(assert_failed);
    }
    v
}

fn main()
{
    usize k = Result::unwrap(StringView::parse<usize>(&Result::unwrap(arg(0))));
    if (k == 0) { i8 x = keep(127: i8); i8 y = keep(1: i8); printf("%v\n", x + y); }
    if (k == 1) { i8 x = keep(min_value<i8>()); i8 y = keep(1: i8); printf("%v\n", x - y); }
    if (k == 2) { i8 x = keep(min_value<i8>()); i8 y = keep((0: i8 - 1)); printf("%v\n", x + y); }
