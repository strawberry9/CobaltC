# `extern "…";` (spec/20 `rule.trust.extern-code`, D-0030) as `cobc` reads it:
# each error reported at its declaration (`main.cb:3`, but for a C file that
# fails to compile), with its exit status, under both C compilers. Each
# program is run from the case's directory, not its own. Written by
# gen/extern_errors.py from its table.
file e0/broken.c
int f(void) { return 1 }
end
file e0/ok.c
int ok(void) { return 1; }
end
file e0/main.cb
import std;

extern "./absent.c";

fn main()
{

}
end
run $COBC --cc $CC --run $DIR/e0/main.cb
status 2
stderr-has cobc: extern "./absent.c": no such file
stderr-has at\s
stderr-has main.cb:3
