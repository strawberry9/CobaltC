# By default `cobc` compiles the program's C as one file with no link-time
# optimisation (impl/build.sh builds the compiler so, as impl/bootstrap/boot.c
# builds it from the seed): GCC is given no `-flto`. `--lto` asks for the C in
# parts linked with link-time optimisation: GCC is given `-flto` (a program
# this small stays one part). The program runs the same either way. The
# option `--one-unit`, which asked for what is now the default, is gone: its
# message says so.
platform unix
file p.cb
import std;

fn main()
{
    printf("%v\n", 6 * 7);
}
end
run $COBC --cc gcc -v -o one p.cb
status 0
stderr-lacks -flto
run ./one
stdout-is 42\n
run $COBC --cc gcc -v --lto -o whole p.cb
status 0
stderr-has -flto
run ./whole
stdout-is 42\n
run $COBC --one-unit -o other p.cb
status 2
stderr-has unknown option --one-unit: the program's C is compiled as one file by default; --lto builds it in parts
