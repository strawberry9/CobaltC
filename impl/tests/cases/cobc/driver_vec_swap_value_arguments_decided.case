# CHG-0382: a call whose later argument is a borrow formed in place
# (`std::Vec::swap`'s `swap_places(&mut (*v)[i], &mut (*v)[j])`), or whose
# earlier argument is a value (`f(x, f(x, 1))`), leaves nothing to the run:
# the program is decided, and ends as recorded here.
file prog.cb
import std;

fn f(i64 a, i64 b) : i64
{
    a + b
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    Vec::swap(&mut v, 0, 1);
    i64 x = 2;
    printf("%v %v %v\n", v[0], v[1], f(x, f(x, 1)));
}
end
run $COBC -v --cc $CC -o prog prog.cb
status 0
stderr-has lowered pathless and decided (D-0284, D-0285)
run ./prog
status 0
stdout-is 2 1 5\n
