# `cobc --emit-cir=core`: core CIR as text. Every function instance the
# program reaches, its body with each expression's type after its place,
# the instances its calls resolve to, the closures and the verdict.
file a.cb
import std;

struct P
{
    i32 x;
    i32 y;
}

fn sum(ref<Vec<P>, shared> v) : i64
{
    i64 t = 0;
    foreach (p in v)
    {
        t += widen<i64>(p.x + p.y);
    }
    t
}

fn main()
{
    Vec<P> v = Vec::new();
    Vec::push(&mut v, P { .x = 1, .y = 2 });
    auto twice = [](i64 n) : i64 { n * 2 };
    printf("%v\n", twice(sum(&v)));
}
end
run $COBC --emit-cir=core a.cb
status 0
stdout-starts (cir core 1)\n(verdict decided)\n(fn main : void\n
stdout-has  (resolves std::Vec::push<P>)\n
stdout-has  (resolves sum)\n
stdout-has (fn sum : i64\n (param v : ref<Vec<P>, shared>)\n
stdout-has (fn std::Vec::push<P> : void native\n
stdout-has (structlit @22:23 : P P <>
stdout-has (binary @23:36 : i64 *
stdout-has (closure 1 (i64) : i64)\n
run $COBC --emit-cir=core -o a.cir a.cb
status 0
stdout-empty
file-starts a.cir (cir core 1)\n

# `cobc --emit-cir=proto` and `cobc --from-cir`: protocol CIR, the lowered
# program as the emitter takes it, written by one run and printed as C by
# another: the same C, byte for byte, as `--emit-c` writes.
run $COBC --emit-c --c-name prog.c -o direct.c a.cb
status 0
run $COBC --emit-cir=proto -o a.proto a.cb
status 0
file-starts a.proto (cir proto 1)\n(decided 1)\n(text fwd
file-has a.proto \n(unit 0
run $COBC --from-cir --c-name prog.c -o back.c a.proto
status 0
same-files direct.c back.c
file b.proto
(cir proto 1)
(decided 1)
(unit 0 1)
decl 0 6
x = 1;
(end)
end
run $COBC --from-cir -o bad.c b.proto
status 2
stderr-has a node's kind is not what its text reads as
