# `--explain` with `--run` (CHG-0467): the program's fault is shown with its
# whole entry, as `COBALTC_EXPLAIN=1` in the program's environment shows it;
# without either, the short form.
file p.cb
import std;

fn pick(ref<Vec<i32>, shared> v, usize i) : i32
{
    return v[i];
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    printf("%d\n", pick(&v, 7));
}
end
run $COBC --explain --run p.cb
status 1
stderr-starts fault[diag.index-out-of-bounds]
stderr-has invariant:
run env COBALTC_EXPLAIN=1 $COBC --run p.cb
status 1
same-stderr-as 1
run $COBC --run p.cb
status 1
stderr-starts fault[diag.index-out-of-bounds]
stderr-lacks invariant:
