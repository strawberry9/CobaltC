# WI-11: with `-O0 -g` and a sanitizer (impl/fuzz/clang-asan), a memory error
# in the program's own (unsafe) code is reported at its `.cb` line. A missing
# clang or AddressSanitizer runtime fails the case. `setarch -R`: clang 14's
# sanitized binaries can fail at start under ASLR.
platform unix
copy impl/fuzz/clang-asan clang-asan
run chmod +x clang-asan
status 0
file over.cb
import std;

struct P
{
    i64 x;
    i64 y;
}

fn main()
{
    match (allocate(sizeof<i64>(), alignof<i64>()))
    {
        Ok(b)  :
        {
            rawptr<P> p = reinterpret_ptr<P>(b);
            unsafe
            {
                (*p).y = 40;
            }
        },
        Err(_) :
        {
        },
    }
}
end
run $COBC -O0 -g --cc $DIR/clang-asan -o over over.cb
status 0
run setarch -R ./over
stderr-has heap-buffer-overflow
stderr-has over.cb:18
