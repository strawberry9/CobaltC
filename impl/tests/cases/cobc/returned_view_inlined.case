# CHG-0372: a sub-view a function returns keeps its holder in the caller however the
# C compiler lays out the callee's storage (GCC at -O1, and LTO above -O0, inline
# `head`); compiled at -O1 and -O2, the fault is expected each time.
platform unix
file held.cb
import std;

struct Held
{
    StringView v;
}

fn head(StringView v) : StringView
{
    &v[0 .. 1]
}

fn main()
{
    String s = "hello";
    Held h = Held { .v = head(&s) };
    if (arg_count() > 9)
    {
        h = Held { .v = "x" };
    }
    printf("%v\n", h.v);
    String::append(&mut s, "!");
    printf("%v\n", h.v);
}
end
run $COBC -O1 --cc $CC -o rv held.cb
status 0
run ./rv
stdout-is h\n
stderr-starts fault[diag.aliasing-conflict]
run $COBC -O2 --cc $CC -o rv held.cb
status 0
run ./rv
stdout-is h\n
stderr-starts fault[diag.aliasing-conflict]
