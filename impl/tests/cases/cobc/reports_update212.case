# 445: `foreach (d in &K)` over a constant array.
file f445.cb
import std;

const array<u8, 3> DAYS = [31, 28, 31];

fn main()
{
    u32 t = 0;
    foreach (d in &DAYS)
    {
        t += widen<u32>(*d);
    }
    printf("%v\n", t);
}
end
