# 396: views of a trimmed line's parts kept, with an early `continue`.
file f396.cb
import std;

fn keys(StringView text) : Vec<StringView> from text
{
    Vec<StringView> out = Vec::new();
    foreach (raw in StringView::lines(text))
    {
        StringView line = StringView::trim(raw);
        match (StringView::find(line, "="))
        {
            Some(i) : Vec::push(&mut out, StringView::trim(&line[0..i])),
            None    : continue,
        }
    }
    out
}

fn main()
{
    String t = "a = 1\nb= 2\n";
    Vec<StringView> ks = keys(&t);
    foreach (k in &ks)
    {
        printf("[%s]\n", *k);
    }
}
end
run $COBC --run f396.cb
status 0
stdout-is [a]\n[b]\n
# 396, soundness: such a view of a text the program then writes is still refused.
file f396s.cb
import std;

fn main()
{
    String s = "  ab  ";
    Vec<StringView> out = Vec::new();
    {
        StringView v = &s;
        Vec::push(&mut out, StringView::trim(&v[0..4]));
    }
    String::append(&mut s, "a longer tail so that the buffer grows");
    printf("%s\n", out[0]);
}
end
run $COBC --check f396s.cb
status 1
stderr-has diag.aliasing-conflict
# 415: copying views out of a field through an exclusive reference holds the
# views, shared, not the whole struct.
file f415.cb
import std;

struct Cur
{
    Option<StringView> peeked;
    usize pos;
}

fn bump(ref<Cur, exclusive> c) : usize
{
    Option<StringView> t = c.peeked;
    c.pos += 1;
    match (t)
    {
        Some(s) : StringView::len(s),
        None    : 0,
    }
}

fn main()
{
    String src = "hello";
    Cur c = Cur { .peeked = Some(&src), .pos = 0 };
    usize n = bump(&mut c);
    printf("%v %v\n", n, c.pos);
}
end
run $COBC --run f415.cb
status 0
stdout-is 5 1\n
# 437: a literal beside a generic body's `foreach` index takes the index's type.
file f437.cb
import std;

fn numbered<T>(ref<Vec<T>, shared> items) : usize
{
    usize last = 0;
    foreach (i, x in items)
    {
        last = i + 1;
    }
    last
}

fn main()
{
    Vec<u8> v = Vec::from_slice(&[1: u8, 2]);
    printf("%v\n", numbered(&v));
}
end
run $COBC --run f437.cb
status 0
stdout-is 2\n
