# D-0341: correct programs accepted, certain faults refused (the improvements
# D-0340 left).
# 418: a cursor reference reassigned after the element it read is written:
# both builds run it.
file f418.cb
import std;

struct Step
{
    usize next;
    u32 cost;
    bool visited;
}

fn walk(ref<Vec<Step>, exclusive> steps) : u32
{
    u32 total = 0;
    usize i = 0;
    ref<Step, shared> cur = &steps[0];
    while (!cur.visited)
    {
        total += cur.cost;
        usize nx = cur.next;
        steps[i].visited = true;
        i = nx;
        cur = &steps[i];
    }
    total
}

fn main()
{
    Vec<Step> s = Vec::new();
    Vec::push(&mut s, Step { .next = 2, .cost = 1, .visited = false });
    Vec::push(&mut s, Step { .next = 0, .cost = 10, .visited = false });
    Vec::push(&mut s, Step { .next = 1, .cost = 100, .visited = false });
    printf("%v\n", walk(&mut s));
}
end
run $COBC --run f418.cb
status 0
stdout-is 111\n
run $COBC --all-checks --run f418.cb
status 0
stdout-is 111\n
# 418: the straight-line form, literal indices, accepted by the check.
file f418b.cb
import std;

fn main()
{
    Vec<i32> v = Vec::from_slice(&[1, 2]);
    ref<i32, shared> cur = &v[0];
    i32 a = *cur;
    v[0] = 5;
    cur = &v[1];
    printf("%v %v\n", a, *cur);
}
end
run $COBC --run f418b.cb
status 0
stdout-is 1 2\n
# 392: views of a text, the text written, then an element read: refused.
file f392.cb
import std;

fn main()
{
    String text = "first line\nsecond line\n";
    Vec<StringView> lines = StringView::lines(&text);
    String::append(&mut text, "a much longer tail, so that the buffer grows\n");
    printf("%s\n", lines[0]);
}
end
run $COBC --check f392.cb
status 1
stderr-has diag.aliasing-conflict
# 392: a struct field holding the views.
file f392s.cb
import std;

struct Holder
{
    Vec<StringView> lines;
}

fn main()
{
    String text = "first line\nsecond";
    Holder h = Holder { .lines = StringView::lines(&text) };
    String::append(&mut text, " and a much longer tail that makes the String grow");
    printf("%s\n", h.lines[0]);
}
end
run $COBC --check f392s.cb
status 1
stderr-has diag.aliasing-conflict
# 409: each branch fixes one type argument.
file f409.cb
import std;

fn main()
{
    usize n = 3;
    auto r = if (n > 1) { Ok(true) } else { Err("short") };
    match (r)
    {
        Ok(b)  : printf("%v\n", b),
        Err(e) : printf("%s\n", e),
    }
}
end
run $COBC --run f409.cb
status 0
stdout-is true\n
# A branch its known condition never takes holds no fault.
file fdead.cb
import std;

fn main()
{
    if (!(1: i32 <= 1: i32))
    {
        printf("%v\n", 1 / (1 - 1));
    }
    printf("ok\n");
}
end
run $COBC --run fdead.cb
status 0
stdout-is ok\n
