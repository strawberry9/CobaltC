# 417: an arm binder used only in an `if` condition ends after it.
file f417.cb
import std;

enum State
{
    Reading(String),
    Done,
}

fn feed(ref<State, exclusive> st)
{
    match (st)
    {
        Reading(buf) :
        {
            if (StringView::len(buf) > 3)
            {
                overwrite(st, Done);
            }
        },
        Done : {},
    }
}

fn main()
{
    State st = Reading("hello");
    feed(&mut st);
    match (&st)
    {
        Done       : printf("done\n"),
        Reading(_) : printf("reading\n"),
    }
}
end
run $COBC --run f417.cb
status 0
stdout-is done\n
run $COBC --all-checks --run f417.cb
status 0
stdout-is done\n
