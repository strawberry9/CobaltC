# D-0178 ([Print-Buffer]): a compiled program's standard output is
# buffered, and a write to standard error writes it out first, so with
# both streams sent to one file the program's order is kept.
platform unix
file order.cb
import std;

fn main()
{
    printf("a\n");
    eprintf("b\n");
    printf("c\n");
}
end
run sh -c "$COBC --cc $CC --run order.cb > both.txt 2>&1"
status 0
file-is both.txt a\nb\nc\n
