# CHG-0485: an empty array literal never faults the compiler. Where nothing
# gives its element type it is refused (`auto x = [];`,
# `diag.cannot-infer-type-parameter`); where the call's types give it, as
# the slice parameter's element type, it is accepted.
file e1.cb
import std;

fn main()
{
    auto x = [];
    printf("%d\n", 1);
}
end
run $COBC --check e1.cb
status 1
stderr-has diag.cannot-infer-type-parameter
stderr-lacks unwrap-failed
file e2.cb
import std;

fn main()
{
    Vec<i32> v = Vec::from_slice(&[]);
    printf("%v\n", Vec::len(&v));
}
end
run $COBC --cc $CC --run e2.cb
status 0
stdout-is 0\n
file e3.cb
import std;

fn main()
{
    Vec<i32> v = Vec::from_slice<i32>(&[]);
    Vec::push(&mut v, 4);
    printf("%v %v\n", Vec::len(&v), v[0]);
}
end
run $COBC --cc $CC --run e3.cb
status 0
stdout-is 1 4\n
