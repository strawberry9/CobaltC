# `--warn-shadow` (CHG-0333): the note, with `--run` and with `--check`, the
# flag before or after `--check`; the exit status unchanged.
file shadow.cb
import std;

struct Option
{
    bool some;
}

fn main()
{
    Option o = Option { .some = true };
    printf("%v\n", o.some);
}
end
run $COBC --warn-shadow --run shadow.cb
status 0
stdout-is true\n
stderr-has note: struct `Option` of this program hides `std::Option`
stderr-has --> shadow.cb:3
run $COBC --check --warn-shadow shadow.cb
status 0
stderr-has hides `std::Option`
run $COBC --warn-shadow --check shadow.cb
status 0
stderr-has hides `std::Option`
run $COBC --check shadow.cb
status 0
stderr-empty
