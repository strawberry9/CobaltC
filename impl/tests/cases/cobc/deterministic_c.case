# The C cobc writes for a program depends on the program alone (the session
# findings of 2026-11-06: facts keyed by a freed expression's address); the
# case is emitted four times and every C must be the same, and decided.
copy impl/conformance/14-control-flow/foreach_view_loops_checked_alike_ok.cb case.cb
run $COBC --emit-c --c-name case.c -o c0.c case.cb
status 0
file-has c0.c #define CB_DECIDED 1
run $COBC --emit-c --c-name case.c -o c1.c case.cb
status 0
file-has c1.c #define CB_DECIDED 1
run $COBC --emit-c --c-name case.c -o c2.c case.cb
status 0
file-has c2.c #define CB_DECIDED 1
run $COBC --emit-c --c-name case.c -o c3.c case.cb
status 0
file-has c3.c #define CB_DECIDED 1
same-files c0.c c1.c
same-files c0.c c2.c
same-files c0.c c3.c
