# 414: a closure without `move` returned through a binding; with `move` it is fine.
file f414.cb
import std;

fn adder(i32 k) : fn(i32) : i32
{
    auto f = [k](i32 x) : i32 { x + k };
    f
}

fn main()
{
    printf("%v\n", adder(2)(3));
}
end
run $COBC --check f414.cb
status 1
stderr-has diag.reference-escapes-scope
file f414m.cb
import std;

fn adder(i32 k) : fn(i32) : i32
{
    auto f = move [k](i32 x) : i32 { x + k };
    f
}

fn main()
{
    printf("%v\n", adder(2)(3));
}
end
run $COBC --run f414m.cb
status 0
stdout-is 5\n
# 394: views of a loop-local text kept after the loop.
file f394.cb
import std;

fn main()
{
    Vec<StringView> words = Vec::new();
    foreach (n in 0..2)
    {
        String line = sprintf("a b %v", n);
        foreach (w in StringView::split_whitespace(&line))
        {
            Vec::push(&mut words, w);
        }
    }
    printf("%v\n", Vec::len(&words));
}
end
run $COBC --check f394.cb
status 1
stderr-has diag.destroy-while-aliased
# 392: a Vec of views of a text, then the text changed, then an element read:
# refused at the check (D-0341 §2.2: the read faults whatever the Vec holds).
file f392.cb
import std;

fn main()
{
    String text = "first line\nsecond line\n";
    Vec<StringView> lines = StringView::lines(&text);
    String::append(&mut text, "a much longer tail, so that the buffer grows\n");
    printf("%s\n", lines[0]);
}
end
run $COBC --check f392.cb
status 1
stderr-has diag.aliasing-conflict
# 413: `Option<R>` assigned in a loop; the first assignment after `= None` is fine.
file f413.cb
import std;

resource struct Conn
{
    usize id;
}

fn Conn::drop(ref<Conn, exclusive> self)
{
    printf("close %v\n", self.id);
}

fn main()
{
    Option<Conn> current = None;
    current = Some(Conn { .id = 0 });
    foreach (i in 1..3)
    {
        current = Some(Conn { .id = i });
    }
}
end
run $COBC --check f413.cb
status 1
stderr-has diag.overwrite-of-live-resource
file f413ok.cb
import std;

resource struct Conn
{
    usize id;
}

fn Conn::drop(ref<Conn, exclusive> self)
{
    printf("close %v\n", self.id);
}

fn main()
{
    Option<Conn> current = None;
    current = Some(Conn { .id = 1 });
    foreach (i in 2..4)
    {
        overwrite(&mut current, Some(Conn { .id = i }));
    }
}
end
run $COBC --run f413ok.cb
status 0
stdout-has close 3
# 380: a handle whose thread gives a Result, ending unjoined.
file f380.cb
import std;

fn save(i32 n) : Result<void, String>
{
    if (n > 0)
    {
        return Err("disk full");
    }
    Ok(())
}

fn main()
{
    {
        auto h = spawn(save, 2);
    }
    printf("all saved\n");
}
end
run $COBC --check f380.cb
status 1
stderr-has diag.result-discarded
# 380: one in a Vec ends unjoined after Err: the run faults.
file f380v.cb
import std;

fn save(i32 n) : Result<void, String>
{
    if (n > 0)
    {
        return Err("disk full");
    }
    Ok(())
}

fn main()
{
    {
        Vec<handle<Result<void, String>>> hs = Vec::new();
        Vec::push(&mut hs, spawn(save, 2));
    }
    printf("all saved\n");
}
end
run $COBC --run f380v.cb
status 1
stderr-has diag.result-discarded
# 382: a returned handle whose thread borrows a local.
file f382.cb
import std;

fn count(ref<Atomic<u64>, shared> c) : u64
{
    Atomic::fetch_add(c, 1)
}

fn start() : handle<u64>
{
    Atomic<u64> c = Atomic::new(0: u64);
    spawn(count, &c)
}

fn main()
{
    handle<u64> h = start();
    printf("%v\n", join(h));
}
end
run $COBC --check f382.cb
status 1
stderr-has diag.reference-escapes-scope
# 381: the same `&mut` element lent to threads on each round.
file f381.cb
import std;

fn worker(ref<u64, exclusive> c)
{
    *c += 1;
}

fn main()
{
    Vec<u64> counts = Vec::filled(2, 0: u64);
    {
        Vec<handle<void>> hs = Vec::new();
        foreach (i in 0..4)
        {
            Vec::push(&mut hs, spawn(worker, &mut counts[0]));
        }
    }
    printf("count %v\n", counts[0]);
}
end
run $COBC --check f381.cb
status 1
stderr-has diag.aliasing-conflict
# 390: a guard passed to spawn.
file f390.cb
import std;

fn finish(guard<Vec<str>> g)
{
    Vec::push(&mut *g, "done");
}

fn main()
{
    mutex<Vec<str>> m = Mutex::new(Vec::new());
    auto h = spawn(finish, lock(&m));
    join(h);
}
end
run $COBC --check f390.cb
status 1
stderr-has diag.thread-affine-moved
