# 409: an `auto` `if` whose branches each fix one type argument compiles (D-0341 §2.3).
file f409b.cb
import std;

fn main()
{
    usize n = 3;
    auto r = if (n > 1) { Ok(true) } else { Err("short") };
    match (r)
    {
        Ok(b)  : printf("%v\n", b),
        Err(e) : printf("%s\n", e),
    }
}
end
