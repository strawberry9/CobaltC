# 399: `: never` as a function's result.
file f399.cb
import std;

fn die(StringView msg) : never
{
    eprintf("%s\n", msg);
    exit(2);
}

fn main()
{
    i32 n = 3;
    String name = if (n > 5) { "big" } else { die("usage: f399 NAME") };
    printf("%s\n", &name);
}
end
run $COBC --run f399.cb
status 2
stderr-has usage: f399 NAME
