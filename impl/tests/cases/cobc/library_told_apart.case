# A library is not a program, and a program is not a library: each is refused
# as the other, with the way out named (`--emit-c` of a library too, which
# once failed an assertion of the compiler's own). The default output name:
# `lib<stem>.a` beside the source, and its header and the runtime with it.
file lib.cb
import std;

extern fn one() : u32
{
    1
}
end
file prog.cb
import std;

fn main()
{
    printf("1\n");
}
end
run $COBC lib.cb
status 2
stderr-has is a library
stderr-has cobc --lib -o liblib.a lib.cb
run $COBC --emit-c -o lib.c lib.cb
status 2
stderr-has is a library
stderr-has cobc --lib -o liblib.a lib.cb
run $COBC --lib prog.cb
status 2
stderr-has has no `main`
run $COBC --lib --run lib.cb
status 2
run $COBC --lib lib.cb
status 0
exists liblib.a
exists lib.h
exists libcbrt.a
