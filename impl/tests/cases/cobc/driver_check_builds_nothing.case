# `--check`: the front end and the `extern "…";` files; no C is written,
# compiled or linked.
file ok.cb
import std;

fn main()
{
    printf("hi\n");
}
end
run $COBC --check ok.cb
status 0
stdout-empty
stderr-empty
absent ok
absent ok.c
file ext.cb
extern "./gone.c";

fn main()
{
}
end
run $COBC --check ext.cb
status 2
stderr-has extern "./gone.c": no such file
stderr-has ext.cb:1
# A rejected program: the static diagnostic a build prints, exit 1.
file bad.cb
fn main()
{
    i32 x = true;
}
end
run $COBC --check bad.cb
status 1
run $COBC bad.cb
same-stderr-as 3
# No other option goes with it.
run $COBC --check -O2 ok.cb
status 2
run $COBC --check
status 2
# `--check-syntax` (CHG-0346): the parser alone.
run $COBC --check-syntax bad.cb
status 0
file broken.cb
fn main()
{
    x = ;
}
end
run $COBC --check-syntax broken.cb
status 1
stderr-is broken.cb:3: expected an expression, found `;` (column 9)\n
run $COBC --check-syntax
status 2
