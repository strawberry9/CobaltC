# Bug 024: the generated C is written in cobc's own temporary directory, so
# `cobc shapes.cb` beside the program's own `shapes.c` (`extern
# "./shapes.c";`) builds it and leaves `shapes.c` alone; it was overwritten
# by the generated C and then deleted. `-o` naming one of the program's own
# files, and `--keep-c` beside a C file cobc did not write, are refused.
file shapes.c
#include <stdint.h>
/* hand-written: area of a rectangle */
int32_t area(int32_t w, int32_t h) { return w * h; }
end
file shapes.cb
import std;

extern "./shapes.c";

unsafe extern fn area(i32 w, i32 h) : i32;

fn main()
{
    printf("%v\n", unsafe { area(6, 7) });
}
end
file tool.c
/* precious notes */
end
run $COBC --cc $CC shapes.cb
status 0
run ./shapes
stdout-is 42\n
file-starts shapes.c #include <stdint.h>\n/* hand-written
run $COBC --cc $CC -o shapes.cb shapes.cb
status 2
stderr-has cannot write the executable to shapes.cb: that is one of the program's own files
file-starts shapes.cb import std;
run $COBC --cc $CC -o shapes.c shapes.cb
status 2
stderr-has one of the program's own files
file-starts shapes.c #include <stdint.h>
run $COBC --cc $CC --keep-c -o shapes shapes.cb
status 2
stderr-has --keep-c cannot write shapes.c: that is one of the program's own files
file-starts shapes.c #include <stdint.h>
run $COBC --cc $CC --keep-c -o tool shapes.cb
status 2
stderr-has a file is there that cobc did not write
file-is tool.c /* precious notes */\n
run $COBC --cc $CC --keep-c -o geo shapes.cb
status 0
file-has geo.c cbrt -- the CobaltC runtime's C interface
run $COBC --cc $CC --keep-c -o geo shapes.cb
status 0
