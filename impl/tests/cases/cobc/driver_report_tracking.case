# `--report-tracking`: nothing is compiled; the lines that still carry
# run-time tracking are listed, a loop's first, and a confined loop is not
# among them. (`v` is moved into another binding after its loop, so no
# analysis can prove its loop's reads; `w` is confined.) Decided (D-0284),
# the program keeps no record and the report says so; with the record kept
# (COBALTC_PATHLESS=0), the listing: what the record would cost.
file prog.cb
import std;

fn main()
{
    Vec<i64> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    i64 first = 7;
    i64 t = 0;
    foreach (i in 0..Vec::len(&v))
    {
        t += v[i];
    }
    Vec<i64> w = Vec::new();
    Vec::push(&mut w, 3);
    foreach (i in 0..Vec::len(&w))
    {
        t += w[i];
    }
    Vec<i64> keep = v;
    printf("%v %v %v\n", t, first, Vec::len(&keep));
}
end
run $COBC --report-tracking prog.cb
status 0
stdout-starts no run-time tracking: every conflict is decided
run env COBALTC_PATHLESS=0 $COBC --report-tracking prog.cb
status 0
stdout-starts The program keeps a record of references: COBALTC_PATHLESS=0
stdout-line 4 prog.cb:12
stdout-line 4 loop
stdout-line 4 "t += v[i];"
stdout-lacks prog.cb:18\s
absent prog
absent prog.c
