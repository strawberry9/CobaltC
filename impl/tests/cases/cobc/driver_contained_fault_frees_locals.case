# D-0269: a contained fault's unwind ends the objectless locals (D-0200) of
# the frames it folds, whose ends are C statements the unwind's jump leaves
# unrun. Observable only as memory: LeakSanitizer reports nothing for a pool
# whose jobs fault, and the program's output is the one recorded here. A
# missing clang or AddressSanitizer runtime fails the case. `setarch -R`:
# clang 14's sanitized binaries can fail at start under ASLR.
platform unix
copy impl/fuzz/clang-asan clang-asan
run chmod +x clang-asan
status 0
copy impl/conformance/19-concurrency/contained_fault_frees_objectless_locals_ok.cb pool.cb
run $COBC -O0 -g --cc $DIR/clang-asan -o pool pool.cb
status 0
run setarch -R ./pool
stderr-lacks LeakSanitizer
stderr-lacks AddressSanitizer
status 0
stdout-is [end 1][diag.index-out-of-bounds][end 2][end 3][diag.index-out-of-bounds][end 4][end 5][diag.index-out-of-bounds][end 6]\nok 15 failed 3\n
