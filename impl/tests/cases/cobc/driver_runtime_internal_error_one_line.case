# RT-001: a failure inside the runtime (here a deliberate misuse: C code that
# pops the runtime's frames until none is left) ends the program: the runtime
# (D-0326) reports an internal error in one line, status 4, and walks no
# stack.
platform unix
file trigger.c
extern void cb_frame_pop(void);
int trigger_panic(int x)
{
    for (int i = 0; i < 1000; i++)
        cb_frame_pop();
    return x;
}
end
file prog.cb
import std;

extern "./trigger.c";
unsafe extern fn trigger_panic(i32 x) : i32;

fn main()
{
    i32 r = 0;
    unsafe { r = trigger_panic(1); }
    printf("after %v\n", r);
}
end
run $COBC --cc $CC -o prog prog.cb
status 0
run ./prog
status 4
stderr-has cbrt: internal: frame pop on an empty stack
