# CHG-0436: a `fn` value's call thunk whose type only one code can reach calls
# that code directly (`single_target_thunks`). The program has one type with
# two targets (a fn item and a closure: the dispatch stays), and types with
# one each: a closure capturing nothing, one capturing a value, and a fn
# item. Each is called through its thunk; the output is the same under both C
# compilers, and the thunks take the forms expected (a thunk's body: from
# `cb_call_<type>__i(void *h` to the next closing brace).
file st.cb
import std;

fn twice(u64 x) : u64
{
    x * 2
}

fn apply(fn(u64) : u64 f, u64 x) : u64
{
    f(x)
}

fn pick(fn(u32) : u32 f, u32 x) : u32
{
    f(x)
}

fn lift(fn(u16) : u64 f) : u64
{
    f(2)
}

fn u32_double(u32 x) : u32
{
    x * 2
}

fn less(fn(ref<u32, shared>, ref<u32, shared>) : bool f, u32 x, u32 y) : bool
{
    f(&x, &y)
}

fn main()
{
    u64 k = 40;
    u64 a = apply(twice, 5);
    u64 b = apply([](u64 x) : u64 { x + 1 }, 5);
    u32 c = pick(u32_double, 21);
    u64 d = lift([k](u16 x) : u64 { k + widen<u64>(x) });
    bool e = less([](ref<u32, shared> p, ref<u32, shared> q) : bool { *p < *q }, 3, 4);
    printf("%v %v %v %v %v\n", a, b, c, d, e);
}
end
run $COBC --cc $CC -o st st.cb
status 0
run ./st
status 0
stdout-is 10 6 42 42 true\n
run $COBC --emit-c -o st.c st.cb
status 0
# Two targets: the box's kind and code decide.
cut st.c two.c "cb_call_fnu64_u64__i(void *h" "\n}\n"
file-has two.c b->closure == 2u
file-has two.c b->code
# A fn item alone: called by name, with no box read.
cut st.c item.c "cb_call_fnu32_u32__i(void *h" "\n}\n"
file-has item.c f_u32_double)(a0)
file-lacks item.c b->code
# A closure capturing a value: its code, with the box's `self`.
cut st.c cap.c "cb_call_fnu16_u64__i(void *h" "\n}\n"
file-has cap.c cb_call_self(b->root)
file-has cap.c ))cl_
file-lacks cap.c b->code
# A closure capturing nothing.
cut st.c pure.c "cb_call_fnrefs_u32_refs_u32_bool__i(void *h" "\n}\n"
file-has pure.c ))cl_
file-lacks pure.c b->code
