# `cobc foo.cb` writes `foo`; when `foo` is a directory (one holding the
# program's module files, say), it must say so and write nothing, not leave
# the linker to fail with "cannot open output file". (The directory is made
# by writing a file into it.)
file prog.cb
import std;

fn main()
{
    printf("hi\n");
}
end
file prog/keep.txt
end
run $COBC prog.cb
status 2
stderr-has that is a directory
stderr-has -o
absent prog.c
