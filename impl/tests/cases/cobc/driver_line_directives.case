# WI-11: `#line` directives name the program's lines in the generated C, and
# `--no-line-directives` leaves them out; the C is otherwise the same. Both C
# compilers build what they number.
file prog.cb
import std;

fn add(i32 a, i32 b) : i32
{
    i32 c = a + b;
    return c;
}

fn main() : u8
{
    i32 x = add(1, 2);
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, x);
    printf("%v\n", v[0]);
    return 0;
}
end
run $COBC --keep-c --cc $CC -o a prog.cb
status 0
run ./a
stdout-is 3\n
run $COBC --keep-c --cc $CC -o b --no-line-directives prog.cb
status 0
run ./b
stdout-is 3\n
# Every statement of the program's own functions is named.
file-has a.c #line 5 "prog.cb"\n
file-has a.c #line 6 "prog.cb"\n
file-has a.c #line 11 "prog.cb"\n
file-has a.c #line 12 "prog.cb"\n
file-has a.c #line 13 "prog.cb"\n
file-has a.c #line 14 "prog.cb"\n
file-has a.c #line 15 "prog.cb"\n
# After a function, the C's own numbering resumes.
c-line-resumes a.c a.c
file-lacks b.c #line
drop-lines a.c a-stripped.c "#line "
same-files a-stripped.c b.c
