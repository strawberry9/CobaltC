# `match (HashMap::get_mut(…)) { Some(c) : *c += 1, None : … }` and the
# `foreach` over `String` keys it is fed by: no object for the match's
# `Option`, no binding object, no element path per word (`--report-tracking`
# with the record kept).
file prog.cb
import std;

fn main()
{
    Vec<String> words = Vec::new();
    Vec::push(&mut words, String::copy("a"));
    HashMap<String, u32> counts = HashMap::new();
    foreach (w in &words)
    {
        match (HashMap::get_mut(&mut counts, w)) // m
        {
            Some(c) : *c += 1, // s
            None    : { _ = HashMap::insert(&mut counts, String::clone(w), 1); },
        }
    }
    printf("%v\n", HashMap::len(&counts));
}
end
run env COBALTC_PATHLESS=0 $COBC --report-tracking prog.cb
status 0
listed-lacks prog.cb "// m" "new x"
listed-lacks prog.cb "// m" "bind x"
listed-lacks prog.cb "// m" "recv_datum x"
listed-lacks prog.cb "// m" "elem_borrow x"
listed-lacks prog.cb "// m" "store_ref x"
listed-lacks prog.cb "// m" "load_ref x"
omits-line prog.cb // s
listed-lacks prog.cb "foreach (w in &words)" "frame_hold x2"
