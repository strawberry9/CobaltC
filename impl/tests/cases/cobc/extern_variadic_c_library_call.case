# Report 228, D-0339: a C library function with a variable argument list
# (`snprintf`), declared with `...`, is called as a variadic function: a
# `double` argument arrives intact at every optimisation level. Declared
# with the call's arguments in place of `...` (the D-0336 form), it is
# refused and the message says to add `...`. Under each C compiler.
file v.cb
import std;

unsafe extern fn snprintf(rawptr<u8> buf, usize n, rawptr<u8> fmt, ...) : i32;

fn report(rawptr<u8> buf, i32 count, f64 avg) : String
{
    unsafe
    {
        snprintf(buf, 64, str_ptr("%d items, average %.3f"), count, avg);
    }
    Result::expect(unsafe { String::from_c(buf) }, "utf8")
}

fn main()
{
    rawptr<u8> buf = Result::expect(allocate(64, 1), "allocate");
    printf("%s\n", &report(buf, 10, 0.125));
    unsafe
    {
        deallocate(buf, 64, 1);
    }
}
end
file old.cb
import std;

unsafe extern fn snprintf(rawptr<u8> buf, usize n, rawptr<u8> fmt, i32 count, f64 avg) : i32;

fn main()
{
}
end
run $COBC --check old.cb
status 1
stderr-has diag.extern-variadic-without-ellipsis
stderr-has with its 3 fixed parameters and then `...`
run $COBC --cc $CC -o v v.cb
status 0
run ./v
status 0
stdout-is 10 items, average 0.125\n
run $COBC --cc $CC -O 0 -o v0 v.cb
status 0
run ./v0
status 0
stdout-is 10 items, average 0.125\n
