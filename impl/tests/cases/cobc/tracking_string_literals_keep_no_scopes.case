# A block's frame and statement scope are left out when nothing is bound or
# tracked in them, whatever text the block writes: a string literal is data.
# Two loops alike but for appending a literal or a `str` local get the same
# number of scope operations (`cb_frame_push`, `cb_stmt_push`) in their
# functions' bodies (from the definition's line to its closing brace), under
# both C compilers, with the record kept.
file prog.cb
import std;

fn lit(ref<String, exclusive> s)
{
    foreach (i in 0..3)
    {
        String::append(s, ",");
    }
}

fn var(ref<String, exclusive> s, str sep)
{
    foreach (i in 0..3)
    {
        String::append(s, sep);
    }
}

fn main()
{
    String s = String::new();
    lit(&mut s);
    var(&mut s, ",");
    printf("%v\n", &s);
}
end
run env COBALTC_PATHLESS=0 $COBC --cc $CC --keep-c -o prog prog.cb
status 0
cut prog.c lit.c "\n…void f_lit(…)\n" "\n}\n"
cut prog.c var.c "\n…void f_var(…)\n" "\n}\n"
same-count lit.c var.c cb_frame_push cb_stmt_push
