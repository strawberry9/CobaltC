# Linkage: the program's own functions are `static` (the C compiler may
# inline them), `main` is not, and a program whose loop calls pure-`std`
# functions (`Vec::push`, `Vec::len`, the element accessor) builds and runs.
# (A C line that begins with a text: `\n` before it.)
file prog.cb
import std;

fn step(ref<i64, exclusive> x)
{
    *x += 1;
}

fn main()
{
    Vec<i64> v = Vec::new();
    foreach (i in 0..10)
    {
        Vec::push(&mut v, narrow<i64>(i));
    }
    i64 t = 0;
    foreach (i in 0..Vec::len(&v))
    {
        step(&mut t);
        t += v[i];
    }
    printf("%v\n", t);
}
end
run $COBC --keep-c -o prog prog.cb
status 0
file-has prog.c \nstatic void f_step(
file-has prog.c \nvoid f_main(
run ./prog
stdout-is 55\n
