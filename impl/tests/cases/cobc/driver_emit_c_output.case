# `--emit-c -o OUT` writes to OUT the C that standard output gets, its
# `#line` directives naming OUT unless `--c-name` names another; `-o -` is
# standard output; the options come in either order; a program the static
# pass rejects gets its diagnostic and status 1, and OUT is not written.
file prog.cb
import std;

fn main()
{
    printf("hi\n");
}
end
run $COBC --emit-c --c-name out.c prog.cb
status 0
stdout-has \ "out.c"\n
save-stdout named.c
run $COBC --emit-c -o out.c prog.cb
status 0
stdout-empty
same-files out.c named.c
run $COBC --emit-c -o other.c --c-name out.c prog.cb
status 0
same-files other.c named.c
run $COBC --emit-c prog.cb
run $COBC --emit-c -o - prog.cb
status 0
stdout-lines 1+
same-stdout-as 4
file bad.cb
fn main()
{
    u8 x = true;
}
end
run $COBC --emit-c -o bad.c bad.cb
status 1
stderr-has diag.type-mismatch
absent bad.c
run $COBC --emit-c -o x.c
status 2
