# From the push after Update 206: generic lookups by a key held (086),
# `StringView` ordered and compared in generic code (098), a `from` clause's
# probe-only parameter copied or captured (183), and two arguments that kept a decided program's
# records (131: arithmetic in `spawn`; 174: an `if` beside a view holder).
file generic.cb
import std;

fn count_known<K>(ref<HashMap<K, i32>, shared> m, slice<K, shared> keys) : usize
{
    usize n = 0;
    foreach (k in keys)
    {
        if (HashMap::contains_ref(m, k))
        {
            n += 1;
        }
    }
    n
}

fn holds<T: eq>(ref<Vec<T>, shared> v, ref<T, shared> x) : bool
{
    Vec::contains_ref(v, x)
}

fn main()
{
    HashMap<String, i32> m = HashMap::new();
    HashMap::insert(&mut m, "a", 1);
    Vec<String> ks = Vec::new();
    Vec::push(&mut ks, "a");
    Vec::push(&mut ks, "b");
    HashMap<u32, i32> n = HashMap::new();
    HashMap::insert(&mut n, 3, 1);
    array<u32, 2> nk = [3, 4];
    Vec<u32> u = Vec::from_slice(&[1: u32, 2]);
    u32 two = 2;
    String text = "pear fig apple fig";
    Vec<StringView> words = StringView::split(&text, " ");
    Vec::sort(&mut words);
    StringView fig = "fig";
    printf("%v %v %v %v %v\n", count_known(&m, &ks[0..$]), count_known(&n, &nk[0..$]), holds(&u, &two), words[0], Vec::contains(&words, &fig));
}
end
run $COBC --run generic.cb
status 0
stdout-is 1 1 true apple true\n
run $COBC --all-checks --run generic.cb
status 0
stdout-is 1 1 true apple true\n
file probe.cb
import std;

struct Entry
{
    String key;
    u32 v;
}

fn lookup(ref<Vec<Entry>, shared> entries, StringView path) : Option<ref<Entry, shared>> from entries
{
    StringView key = path;
    match (Vec::position(entries, [key](ref<Entry, shared> e) : bool { e.key == key }))
    {
        Some(i) : Some(&entries[i]),
        None    : None,
    }
}

fn main()
{
    Vec<Entry> es = Vec::new();
    Vec::push(&mut es, Entry { .key = "x", .v = 4 });
    printf("%v\n", Option::unwrap(lookup(&es, "x")).v);
}
end
run $COBC --run probe.cb
status 0
stdout-is 4\n
run $COBC --all-checks --run probe.cb
status 0
stdout-is 4\n
file decided.cb
import std;

struct Reader
{
    StringView text;
    usize at;
}

fn esc(ref<Reader, exclusive> r, usize n, ref<String, exclusive> out) : Result<void, u8>
{
    r.at += n;
    String::push_ascii(out, b'x');
    Ok(())
}

fn basic(ref<Reader, exclusive> r, bool small) : Result<String, u8>
{
    String out = String::new();
    esc(r, if (small) { 4 } else { 8 }, &mut out)?;
    Ok(out)
}

fn sum(slice<u64, shared> v, u64 id) : u64
{
    u64 s = id;
    foreach (x in v)
    {
        s += *x;
    }
    s
}

fn main()
{
    String src = "abc";
    Reader r = Reader { .text = &src, .at = 0 };
    _ = basic(&mut r, true);
    Vec<u64> v = Vec::from_slice(&[1: u64, 2]);
    u64 id = 1;
    auto t = spawn(sum, &v[0..$], id + 1);
    printf("%v %v\n", r.at, join(t));
}
end
run $COBC --report-tracking decided.cb
status 0
stdout-has no run-time tracking
