# A shared reference to an element held across a loop: the loop's reads meet
# only shared paths, so they are bounds-checked only. An exclusive element
# borrow in the function keeps every access tracked (`--report-tracking`
# with the record kept).
file prog.cb
import std;

fn build(usize n) : Vec<i64>
{
    Vec<i64> v = Vec::new();
    foreach (i in 0..n)
    {
        Vec::push(&mut v, narrow<i64>(i));
    }
    v
}

fn held(usize n) : i64
{
    Vec<i64> v = build(n);
    ref<i64, shared> first = &v[0];
    i64 t = 0;
    foreach (i in 0..Vec::len(&v))
    {
        t += v[i]; // held
    }
    t + *first
}

fn excl(usize n) : i64
{
    Vec<i64> v = build(n);
    ref<i64, exclusive> e = &mut v[0];
    *e = 1;
    i64 t = 0;
    foreach (i in 1..Vec::len(&v))
    {
        t += v[i]; // excl
    }
    t
}

fn main()
{
    printf("%v %v\n", held(3), excl(3));
}
end
run env COBALTC_PATHLESS=0 $COBC --report-tracking prog.cb
status 0
omits-line prog.cb // held
lists-line prog.cb // excl
