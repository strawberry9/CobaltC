# Report 174: a program that calls `Toml::parse` keeps no run-time tracking
# on its account. `TomlReader::basic` passed an `if` expression beside the
# `ref` to its reader, which made the analysis keep the record for the
# whole program; std binds it first now. The program here never runs the
# parse unless asked, as a server reading its configuration would.
file prog.cb
import std;

fn main()
{
    if (arg_count() > 1)
    {
        match (Toml::parse("name = \"\\u00e9\"\nport = 0x1F90\n"))
        {
            Ok(t)  : printf("%v\n", Vec::len(Option::unwrap(Toml::as_table(&t)))),
            Err(_) : printf("bad\n"),
        }
    }
    usize total = 0;
    foreach (i in 0..1000)
    {
        total += i;
    }
    printf("%v\n", total);
}
end
run $COBC --report-tracking prog.cb
status 0
stdout-starts no run-time tracking: every conflict is decided
absent prog
