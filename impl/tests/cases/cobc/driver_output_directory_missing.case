# Bug 025: an output in a directory that does not exist is a message and
# status 2, before anything is compiled; it was cobc's own `unwrap-failed`
# on writing the C.
file p.cb
import std;

fn main()
{
    printf("hi\n");
}
end
run $COBC --cc $CC -o missing_dir/p p.cb
status 2
stderr-starts cobc: cannot write the executable to missing_dir
stderr-lacks unwrap
absent missing_dir
