# What cobc proves, seen in what it leaves for the runtime to track:
# `--report-tracking` (with the record kept, COBALTC_PATHLESS=0) lists, per
# source line, the tracking calls written in the C. A `Vec` field of a local
# struct, used only by indexing and `Vec::len`: its elements are read with
# the bounds check alone. The same loop in a function that also pushes to the
# field, or borrows its element, keeps its checks.
file prog.cb
import std;

struct H
{
    Vec<i64> v;
    i64 n;
}

fn only(usize n) : i64
{
    H h = H { .v = Vec::new(), .n = 0 };
    i64 t = 0;
    foreach (i in 0..Vec::len(&h.v))
    {
        t += h.v[i]; // only
    }
    h.n = narrow<i64>(n);
    t + h.n
}

fn pushed(usize n) : i64
{
    H h = H { .v = Vec::new(), .n = 0 };
    Vec::push(&mut h.v, narrow<i64>(n));
    i64 t = 0;
    foreach (i in 0..Vec::len(&h.v))
    {
        t += h.v[i]; // pushed
    }
    t
}

fn borrowed(usize n) : i64
{
    H h = H { .v = Vec::new(), .n = 0 };
    i64 t = 0;
    foreach (i in 0..Vec::len(&h.v))
    {
        ref<i64, shared> e = &h.v[i];
        t += *e + h.v[i]; // borrowed
    }
    t + narrow<i64>(n)
}

fn main()
{
    printf("%v %v %v\n", only(1), pushed(2), borrowed(3));
}
end
run env COBALTC_PATHLESS=0 $COBC --report-tracking prog.cb
status 0
omits-line prog.cb // only
lists-line prog.cb // pushed
lists-line prog.cb // borrowed
