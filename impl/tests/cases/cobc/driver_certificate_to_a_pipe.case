# Bug 027: the certificate's own file is opened once, at the end, so a pipe
# reads the certificate (not the raw records the checker writes as it goes)
# and cobc does not wait for a second reader of a FIFO.
platform unix
file p.cb
import std;

fn main()
{
    printf("hi\n");
}
end
run sh -c "{ $COBC --certificate /dev/stdout --check p.cb; echo $? > status.txt; } | cat > cert.txt"
file-is status.txt 0\n
file-starts cert.txt CobaltC certificate 1\n
file-lacks cert.txt end\n
run sh -c "mkfifo c.fifo && { cat c.fifo > fifo.txt & } && $COBC --certificate c.fifo --check p.cb && wait"
status 0
file-starts fifo.txt CobaltC certificate 1\n
