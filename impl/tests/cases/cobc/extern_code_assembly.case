# D-0258: an assembly file is foreign code too, assembled by the C compiler:
# `.S` through the preprocessor (so it can choose the calling convention with
# `#ifdef _WIN32`), `.s` as it is.
file vendor/addmul.S
        .text
#ifdef _WIN32
        .globl addmul
addmul:
        movq %rcx, %rax
        imulq %rdx, %rax
        addq %r8, %rax
        ret
#else
        .globl addmul
addmul:
        movq %rdi, %rax
        imulq %rsi, %rax
        addq %rdx, %rax
        ret
        .section .note.GNU-stack,"",@progbits
#endif
end
file vendor/seven.s
        .text
        .globl seven
seven:
        movl $7, %eax
        ret
end
file main.cb
import std;

extern "./vendor/addmul.S";
extern "./vendor/seven.s";

unsafe extern fn addmul(u64 a, u64 b, u64 c) : u64;
unsafe extern fn seven() : i32;

fn main()
{
    printf("%v %v\n", unsafe { addmul(4, 5, 3) }, unsafe { seven() });
}
end
run $COBC --cc $CC -o $DIR/main.bin $DIR/main.cb
status 0
run $DIR/main.bin
status 0
stdout-is 23 7\n
