# `cobc --one-unit` compiles the program's C as one file with no link-time
# optimisation (impl/build.sh builds the compiler so, as impl/bootstrap/boot.c
# builds it from the seed): GCC is given no `-flto`, which it is given by
# default. The program runs the same either way.
platform unix
file p.cb
import std;

fn main()
{
    printf("%v\n", 6 * 7);
}
end
run $COBC --cc gcc -v --one-unit -o one p.cb
status 0
stderr-lacks -flto
run ./one
stdout-is 42\n
run $COBC --cc gcc -v -o whole p.cb
status 0
stderr-has -flto
run ./whole
stdout-is 42\n
