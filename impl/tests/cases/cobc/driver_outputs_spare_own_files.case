# Reports 138, 139, 137. `--emit-c -o` never writes over one of the
# program's own files (its source, a module, a C file it names with
# `extern`) nor a `.cb` name. `--certificate FILE` empties nothing before
# the command line and the program are known good: a forgotten FILE (the
# program's name in its place) is refused, a usage error leaves the earlier
# certificate as it was, a file that is not a certificate is refused, and no
# raw file is left behind. `--explore`'s replay command carries the
# options that change the checks and the program's arguments.
file prog.cb
import std;

module m "./m.cb";

fn main()
{
    printf("%v\n", m::seven());
}
end
file m.cb
export fn seven() : i32
{
    7
}
end
file args.cb
import std;

fn main()
{
    if (arg_count() == 0)
    {
        printf("no arguments\n");
        exit(2);
    }
    printf("argument %v\n", &Result::unwrap(arg(0)));
}
end
run $COBC --emit-c -o prog.cb prog.cb
status 2
stderr-has that is one of the program's own files
file-starts prog.cb import std;
run $COBC --emit-c -o m.cb prog.cb
status 2
file-starts m.cb export fn seven()
run $COBC --emit-c -o other.cb prog.cb
status 2
absent other.cb
run $COBC --certificate prog.cb
status 2
stderr-has FILE names a CobaltC source
file-starts prog.cb import std;
run $COBC --certificate cert.txt --check prog.cb
status 0
file-starts cert.txt CobaltC certificate 1\n
run $COBC --certificate cert.txt --check prog.cb prog.cb
status 2
file-starts cert.txt CobaltC certificate 1\n
run $COBC --certificate cert.txt --check missing.cb
status 2
file-starts cert.txt CobaltC certificate 1\n
run $COBC --certificate m.cb.txt --check prog.cb
status 0
run $COBC --certificate args.cb.bak --check prog.cb
status 0
run sh -c "cp m.cb data.txt; $COBC --certificate data.txt --check prog.cb"
status 2
stderr-has a file is there that is not a certificate cobc wrote
file-starts data.txt export fn seven()
run $COBC --explore 2 --all-checks args.cb "an input.txt"
status 0
stdout-has replay: cobc --all-checks --schedule-seed 1 args.cb 'an input.txt'
