# `printf("%v", &s)` of a `String` local named by no other argument: read
# where it is formatted (no path minted), and for a local only read and
# printed, no object at all; the same `String` twice is borrowed
# (`--report-tracking` with the record kept).
file prog.cb
import std;

fn main()
{
    foreach (i in 0..3)
    {
        String s = sprintf("row %v", i); // s
        printf("%v|", &s); // p
    }
    String t = String::new();
    String::append(&mut t, 1);
    printf("%v\n", &t); // t
    printf("%v %v\n", &t, &t); // tt
}
end
run env COBALTC_PATHLESS=0 $COBC --report-tracking prog.cb
status 0
listed-lacks prog.cb "// s" "bind x"
omits-line prog.cb // p
listed-lacks prog.cb "// t" " borrow x"
listed-has prog.cb "// tt" "borrow x2"
