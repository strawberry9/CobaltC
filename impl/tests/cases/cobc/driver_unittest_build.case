# D-0230: `cobc --unittest` builds the program's tests; the test program
# reports them (its report, recorded here: status 1, ending "3 tests: 2
# passed, 1 failed"), under both C compilers, with -o kept and with --run;
# without --unittest, the program: `main`, and no test.
file t.cb
import std;

fn twice(i32 x) : i32
{
    x * 2
}

unittest "twice: small"
{
    assert(twice(2) == 4);
}

unittest
{
    assert(twice(3) == 7, "3 twice is %v", twice(3));
}

unittest "twice: zero"
{
    assert(twice(0) == 0);
}

fn main()
{
    printf("main\n");
}
end
run $COBC --unittest --cc $CC -o tests t.cb
status 0
run env NO_COLOR=1 ./tests
status 1
stdout-is test t.cb:8 twice: small ... ok\ntest t.cb:13 ... FAILED\nfault[diag.assert-failed]: 3 twice is 6 (6 == 7)\n  --> t.cb:15:5\n   |\n15 |     assert(twice(3) == 7, "3 twice is %v", twice(3));\n   |     ^^^^^^\n   = repair: the program's own condition names what was assumed; find why it did not hold\ntest t.cb:18 twice: zero ... ok\n3 tests: 2 passed, 1 failed\n
run $COBC --unittest --unittest-filter zero --cc $CC --run t.cb
status 0
stdout-is test t.cb:18 twice: zero ... ok\n1 test: 1 passed, 0 failed, 2 filtered out\n
run $COBC --cc $CC --run t.cb
stdout-is main\n
