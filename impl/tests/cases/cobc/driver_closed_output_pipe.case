# A reader that stops early (`cobc --explore 3 p.cb | head -1`) is not an
# internal error: the tool ends quietly, status 1, as a Unix tool does at a
# closed pipe. The pipe's reader here (`true`) ends before `cobc` has
# compiled; the shell keeps cobc's status and standard error in files.
platform unix
file p.cb
import std;

fn main()
{
    printf("x\n");
}
end
run sh -c "{ $COBC --explore 3 p.cb 2> err.txt; echo $? > status.txt; } | true"
exists err.txt
file-is status.txt 1\n
file-lacks err.txt internal error
