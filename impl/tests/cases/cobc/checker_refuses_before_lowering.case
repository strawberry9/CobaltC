# Programs the checker passed that then failed in the compiler or the C
# compiler, or computed a wrong value (reports 104, 105, 106, 107, 142,
# 159 of the push after Update 206): each is refused at the check now.
#
# 104: an extern call's arguments are of its declared parameter types.
file ext.cb
import std;

unsafe extern fn abs(i32 x) : i32;

fn main()
{
    i64 offset = -5000000003;
    String name = "x";
    unsafe
    {
        printf("%d\n", abs(offset));
    }
    unsafe
    {
        printf("%d\n", abs(&name));
    }
    unsafe
    {
        printf("%d\n", abs(1, 2));
    }
}
end
run $COBC --check ext.cb
status 1
stderr-has argument 1 (`x`) is `i64`, but the parameter is `i32`
stderr-has argument 1 (`x`) is `ref<String, shared>`, but the parameter is `i32`
stderr-has `abs` takes 1 argument, and this call passes 2
# 105: a suffixed literal has its suffix's type as an argument too.
file lit.cb
import std;

fn f(u8 x) : u8
{
    x
}

fn pair<T>(T a, T b) : T
{
    b
}

fn main()
{
    printf("%v\n", f(300: u16));
    Vec<u8> v = Vec::new();
    Vec::push(&mut v, 70000: u32);
    printf("%v\n", pair(1: i32, 5000000000: i64));
    auto g = [](u8 x) : u8 { x };
    printf("%v %v\n", g(300: u16), f(200));
}
end
run $COBC --check lit.cb
status 1
stderr-has argument 1 (`x`) is `u16`, but the parameter is `u8`
stderr-has argument 2 (`x`) is `u32`, but the parameter is `u8`
stderr-has argument 2 (`b`) is `i64`, but the parameter is `i32`
stderr-has argument 1 is `u16`, but the function value's parameter is `u8`
# 106: a diverging `then` branch gives the `if` the other branch's type.
file ret.cb
import std;

fn sign(i32 x) : i32
{
    if (x > 0) { return 1; }
    else if (x < 0) { return -1; }
}

fn main()
{
    printf("%v\n", sign(2));
}
end
run $COBC --check ret.cb
status 1
stderr-has `sign` returns `i32`, but its body gives `void`
# 107: a variant called with the wrong number of values.
file unit.cb
import std;

enum Msg
{
    Quit,
    Move(i32),
}

fn main()
{
    Msg m = Quit();
    Msg n = Move();
    printf("%v %v\n", m, n);
}
end
run $COBC --check unit.cb
status 1
stderr-has `Quit` carries no value: write `Quit`, without `()`
stderr-has `Move` carries one value: write `Move(value)`
# 142 and 159: a payload-less variant written as a value is of its enum,
# so `widen` and `String::append` refuse it as they refuse a binding of it.
file enumval.cb
import std;

enum Level : u8 { Low = 1, Mid, High = 10 }

enum Color
{
    Red,
    Green,
}

fn main()
{
    u32 code = widen<u32>(Level::High);
    String s = "colour: ";
    String::append(&mut s, Color::Green);
    printf("%v %v\n", code, &s);
}
end
run $COBC --check enumval.cb
status 1
stderr-has `widen` converts a number, not `Level`
stderr-has not an enum such as `Color`; `String::appendf(&mut s, "%v", x)` writes its variant's name
