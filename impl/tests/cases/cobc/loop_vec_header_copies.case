# A loop that names a confined `Vec` local only to index it or ask its length
# reads the vector's `ptr` and `len` from copies made before it
# (`hoist_vec_headers`), a nested loop from its own, and a loop that reads
# none of its copies keeps none; one that pushes onto it, assigns it or hands
# it on reads the vector's header as before. The emitted C copies exactly the
# vectors it may: `a`'s loop, `c`'s inner loop, `e`'s loop, in that order (a
# copy is a line `… *hp… = (l_NAME_N).ptr;`; three in all, the one of `a`
# first, `c`'s second, `e`'s last); not `b` (pushed onto), `d` (assigned) or
# the inner `c` (declared in the loop), and not `c`'s outer loop, which
# indexes it only in the inner one (a copy no access reads is taken out). The
# program's output and its bounds fault (with its location, recorded here)
# are the same under gcc and clang.
file h.cb
import std;

fn sum(ref<Vec<u64>, shared> v) : u64
{
    u64 s = 0;
    foreach (x in v)
    {
        s += *x;
    }
    s
}

fn main() : u8
{
    Vec<u64> a = Vec::filled(10, 1);
    // Fixed header: written and read by index.
    for (usize i = 1; i < Vec::len(&a); i += 1)
    {
        a[i] = a[i - 1] * 2;
    }
    printf("%d\n", a[9]);
    // A push inside: the header changes, no copy may be used.
    Vec<u64> b = Vec::new();
    Vec::push(&mut b, 1);
    usize k = 0;
    while (k < 40)
    {
        Vec::push(&mut b, b[k] + 1);
        k += 1;
    }
    printf("%d %d\n", Vec::len(&b), b[40]);
    // Nested loops, an inner shadowing name.
    Vec<u8> c = Vec::filled(16, 0);
    for (usize i = 0; i < 16; i += 1)
    {
        for (usize j = i; j < 16; j += 1)
        {
            c[j] = c[j] + 1;
        }
        Vec<u8> c = Vec::filled(2, 7);
        c[1] = 9;
        printf("%d", c[1]);
    }
    printf("\n%d %d\n", c[0], c[15]);
    // Reassigned inside: no copy.
    Vec<u64> d = Vec::filled(3, 5);
    for (usize r = 0; r < 3; r += 1)
    {
        d[0] = d[0] + 1;
        if (r == 1)
        {
            d = Vec::filled(5, 2);
        }
    }
    printf("%d %d\n", Vec::len(&d), d[0]);
    printf("%d\n", sum(&a));
    // Out of bounds in a copied loop.
    Vec<bool> e = Vec::filled(5, true);
    usize n = 0;
    for (usize m = 0; m < 8; m += 1)
    {
        if (e[m])
        {
            n += 1;
        }
    }
    printf("%d\n", n);
    0
}
end
run $COBC --emit-c -o h.c h.cb
status 0
file-count h.c 3 " *hp…= (l_…).ptr;\n"
cut h.c from-a.c " *hp…= (l_a_…).ptr;\n" ""
file-count from-a.c 3 " *hp…= (l_…).ptr;\n"
cut h.c from-c.c " *hp…= (l_c_…).ptr;\n" ""
file-count from-c.c 2 " *hp…= (l_…).ptr;\n"
cut h.c from-e.c " *hp…= (l_e_…).ptr;\n" ""
file-count from-e.c 1 " *hp…= (l_…).ptr;\n"
run $COBC --cc $CC -o h h.cb
status 0
run ./h
stdout-is 512\n41 41\n9999999999999999\n1 16\n5 3\n1023\n
stderr-starts fault[diag.index-out-of-bounds]
stderr-has h.cb:62:13\n
