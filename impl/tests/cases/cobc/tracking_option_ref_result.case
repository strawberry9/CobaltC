# A match on a function of the program's own returning `Option<ref<T>>`: the
# reference is received alone, with no temporary object (`--report-tracking`
# with the record kept).
file prog.cb
import std;

fn first(ref<Vec<i64>, exclusive> v) : Option<ref<i64, exclusive>>
{
    if (Vec::len(v) == 0)
    {
        return None;
    }
    Some(&mut v[0])
}

fn main()
{
    Vec<i64> v = Vec::new();
    Vec::push(&mut v, 1);
    foreach (i in 0..3)
    {
        match (first(&mut v)) // m
        {
            Some(x) : { *x += 1; *x *= 2; },
            None    : { },
        }
    }
    printf("%v\n", v[0]);
}
end
run env COBALTC_PATHLESS=0 $COBC --report-tracking prog.cb
status 0
listed-has prog.cb "// m" recv_datum_tok
listed-lacks prog.cb "// m" "new x"
listed-lacks prog.cb "// m" "move_to x"
listed-lacks prog.cb "// m" "store_ref x"
