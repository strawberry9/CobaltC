# Report 066: `Result::unwrap` and `Result::expect` on an `Err` name the
# error in their fault: what `%v` prints of it (a number, `bool`, text, a
# `String`, an enum's variant name), else its type. Under each C compiler.
file u.cb
import std;

struct ConfigError
{
    i32 line;
}

fn main()
{
    String what = Result::unwrap(arg(0));
    if (what == "file") { _ = Result::unwrap(read_file("/no/such/config.toml")); }
    if (what == "expect") { _ = Result::expect(read_file("/no/such/config.toml"), "reading the config"); }
    if (what == "int") { Result<i32, i32> r = Err(7); _ = Result::unwrap(r); }
    if (what == "text") { Result<i32, String> r = Err(sprintf("bad %v", 3)); _ = Result::unwrap(r); }
    if (what == "struct") { Result<i32, ConfigError> r = Err(ConfigError { .line = 4 }); _ = Result::unwrap(r); }
    if (what == "ok") { Result<i32, ConfigError> r = Ok(5); printf("%v\n", Result::unwrap(r)); }
}
end
run $COBC --cc $CC -o u u.cb
status 0
run ./u file
status 1
stderr-has fault[diag.unwrap-failed]: `Result::unwrap` found `Err`: NotFound
run ./u expect
status 1
stderr-has fault[diag.unwrap-failed]: reading the config: NotFound
run ./u int
status 1
stderr-has fault[diag.unwrap-failed]: `Result::unwrap` found `Err`: 7
run ./u text
status 1
stderr-has fault[diag.unwrap-failed]: `Result::unwrap` found `Err`: bad 3
run ./u struct
status 1
stderr-has fault[diag.unwrap-failed]: `Result::unwrap` found `Err`: a `ConfigError`
run ./u ok
status 0
stdout-is 5\n
