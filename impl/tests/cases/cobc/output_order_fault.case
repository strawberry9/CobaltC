# A fault's report writes the buffered standard output out first.
platform unix
file fault.cb
import std;

fn main()
{
    printf("before\n");
    Vec<i32> v = Vec::new();
    printf("%v\n", v[0]);
}
end
run sh -c "$COBC --cc $CC --run fault.cb > both.txt 2>&1"
status 1
file-starts both.txt before\nfault[diag.index-out-of-bounds]
