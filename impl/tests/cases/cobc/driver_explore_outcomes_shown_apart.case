# Reports 274, 275: `--explore` shows a later outcome from the first line
# where it differs from the first outcome's, and marks a cut; the replay
# command of an explored test program has `--unittest`.
file p.cb
import std;

fn worker(ref<mutex<Vec<u32>>, shared> log, u32 id)
{
    auto g = lock(log);
    Vec::push(&mut *g, id);
}

fn main()
{
    foreach (i in 0..10)
    {
        printf("setup step %v\n", i);
    }
    mutex<Vec<u32>> log = Mutex::new(Vec::new());
    handle<void> a = spawn(worker, &log, 1);
    handle<void> b = spawn(worker, &log, 2);
    join(a);
    join(b);
    auto g = lock(&log);
    printf("first to finish: %v\n", g[0]);
}
end
file t.cb
import std;

fn bump(ref<mutex<u32>, shared> m)
{
    auto g = lock(m);
    *g += 1;
}

unittest "two threads bump"
{
    mutex<u32> m = Mutex::new(0);
    handle<void> a = spawn(bump, &m);
    handle<void> b = spawn(bump, &m);
    join(a);
    join(b);
    assert(*lock(&m) == 2);
}
end
run $COBC --cc $CC --explore 20 p.cb
status 1
stdout-has | setup step 7\n  | ... 3 more lines\n
stdout-has | (lines 1-10 as the first outcome's)\n  | first to finish:
run $COBC --cc $CC --unittest --explore 2 t.cb
status 0
stdout-has -- replay: cobc --unittest --schedule-seed 1 t.cb\n
run $COBC --cc $CC --unittest --schedule-seed 1 t.cb
status 0
