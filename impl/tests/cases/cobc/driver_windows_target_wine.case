# D-0255: from Linux, `--target x86_64-pc-windows-gnu` writes `p.exe` with
# MinGW-w64's GCC, and `--run` runs it under COBALTC_RUNNER (an empty one is
# none: `env COBALTC_RUNNER=`). A missing MinGW-w64, Wine or Windows runtime
# fails the case.
platform unix
file p.cb
import std;

fn main() : u8
{
    printf("%v %v\n", arg_count(), 6 * 7);
    3
}
end
run $COBC --target x86_64-pc-windows-gnu p.cb
status 0
exists p.exe
# --run without a runner says what it needs.
run env COBALTC_RUNNER= $COBC --target x86_64-pc-windows-gnu --run p.cb
status 2
stderr-has COBALTC_RUNNER
run env COBALTC_RUNNER=wine64 env WINEDEBUG=-all $COBC --target x86_64-pc-windows-gnu --run p.cb a b
status 3
stdout-is 2 42\n
