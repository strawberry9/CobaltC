# A module file read alone (`cobc --check-syntax`, `cobfmt`) that declares a
# local of a generic type from a sibling module: `Holder<i32> h = …;` is a
# declaration by `spec/22` §2 disambiguation (4) (a generic-argument list and
# a name begin no expression), though the file declares no `Holder`. Before
# the session findings of 2026-11-06 it was `expected ;`, so `cobfmt --check
# DIR` could never be clean for such a project. The formatter is the one
# built beside the compiler ($BIN).
file box.cb
import std;

export struct Holder<T>
{
    export T value;
}
end
file user.cb
import std;
import box;

export fn make() : i32
{
    Holder<i32> h = Holder { .value = 3 };
    Vec<Holder<i32>> v;
    h.value
}
end
file m.cb
import std;

module box "box.cb";
module user "user.cb";

fn main()
{
    printf("%v\n", user::make());
}
end
run $COBC --check-syntax user.cb
status 0
run $BIN/cobfmt --check user.cb
status 0
