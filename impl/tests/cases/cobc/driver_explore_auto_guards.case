# The guide's counter with its guards held through `auto` (cb_lock_bare): --explore must
# reach both outcomes (Update 193: cb_lock_bare passed no turn).
file counter.cb
import std;

fn bump(ref<mutex<i64>, shared> m)
{
    i64 seen = 0;
    {
        auto g = lock(m);
        seen = *g;
    }
    auto g = lock(m);
    *g = seen + 1;
}

fn main()
{
    mutex<i64> m = Mutex::new(0: i64);
    {
        auto a = spawn(bump, &m);
        auto b = spawn(bump, &m);
    }
    auto g = lock(&m);
    printf("total %v\n", *g);
}
end
run $COBC --cc $CC --explore 50 counter.cb
status 1
stdout-has 2 distinct outcomes
stdout-has total 1
stdout-has total 2
