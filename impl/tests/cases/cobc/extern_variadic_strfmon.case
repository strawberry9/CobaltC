# Report 228: `strfmon` takes a variable argument list. Declared with
# `...` it is called as a variadic function: `1.5` prints as `1.50` (it
# printed 0.06 through a fixed prototype). The older form that lists the
# call's arguments (D-0336) is refused since D-0339. glibc's `strfmon`, so
# Unix only. Under each C compiler.
platform unix
file a.cb
import std;

unsafe extern fn strfmon(rawptr<u8> s, usize max, rawptr<u8> format, ...) : isize;

fn main()
{
    rawptr<u8> buf = Result::expect(allocate(128, 1), "allocate");
    unsafe
    {
        strfmon(buf, 128, str_ptr("%!.2n and %!.1n"), 1.5, 2.25);
    }
    printf("%s\n", &Result::expect(unsafe { String::from_c(buf) }, "utf8"));
    unsafe
    {
        deallocate(buf, 128, 1);
    }
}
end
file b.cb
import std;

unsafe extern fn strfmon(rawptr<u8> s, usize max, rawptr<u8> format, f64 v) : isize;

fn main()
{
    rawptr<u8> buf = Result::expect(allocate(128, 1), "allocate");
    unsafe
    {
        strfmon(buf, 128, str_ptr("%!.2n"), 1.5);
    }
    printf("%s\n", &Result::expect(unsafe { String::from_c(buf) }, "utf8"));
    unsafe
    {
        deallocate(buf, 128, 1);
    }
}
end
run $COBC --cc $CC -o a a.cb
status 0
run ./a
status 0
stdout-is 1.50 and 2.2\n
run $COBC --cc $CC -o b b.cb
status 1
stderr-has diag.extern-variadic-without-ellipsis
