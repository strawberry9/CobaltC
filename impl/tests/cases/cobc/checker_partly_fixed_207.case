# The static pass on the partly fixed reports of Update 207 (108, 109,
# 114, 183, 229) and report 311 of Update 208: programs that passed the
# check and faulted, refused now; correct programs refused, accepted now;
# the two build forms in agreement; divide-and-conquer threads decided.
# 108: a resource field of a slice's element is reached through a
# reference (the slice), so it is not moved out: refused as through a
# `ref` or a `ref<Vec>`.
file slice_field_move.cb
import std;

struct Person
{
    String name;
    i32 age;
}

fn d(slice<Person, shared> ps) : String
{
    ps[0].name
}

fn main()
{
    Vec<Person> v = Vec::new();
    Vec::push(&mut v, Person { .name = "Ada", .age = 36 });
    String n = d(&v);
    printf("%s\n", &n);
}
end
run $COBC --check slice_field_move.cb
status 1
stderr-has diag.move-out-of-field
stderr-has `ps[0].name` is reached through a reference
# 108: a copy, an exchange and a plain field through a slice are taken.
file slice_field_ok.cb
import std;

struct Person
{
    String name;
    i32 age;
}

// Accepted: copies, references, exchanges and plain values.
fn ok1(slice<Person, shared> ps) : String
{
    String::clone(&ps[0].name)
}

fn ok2(slice<Person, exclusive> ps) : String
{
    replace(&mut ps[0].name, String::copy("x"))
}

fn ok3(slice<Person, shared> ps) : i32
{
    ps[0].age
}

fn main()
{
    Vec<Person> v = Vec::new();
    Vec::push(&mut v, Person { .name = "Ada", .age = 36 });
    String a = ok1(&v);
    String b = ok2(&mut v);
    printf("%s %s %s %d\n", &a, &b, &v[0].name, ok3(&v));
}
end
run $COBC --run slice_field_ok.cb
status 0
stdout-is Ada Ada x 36\n
run $COBC --all-checks --run slice_field_ok.cb
status 0
stdout-is Ada Ada x 36\n
