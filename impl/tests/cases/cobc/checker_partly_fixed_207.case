# 109: a `move` closure binding, and one whose capture outlives the
# container, are stored.
file closure_binding_ok.cb
import std;
fn main()
{
    Vec<fn() : usize> fs = Vec::new();
    foreach (i in 0..3)
    {
        auto c = move [i]() : usize { i * 10 };
        Vec::push(&mut fs, c);
    }
    usize k = 4;
    foreach (j in 0..2)
    {
        auto d = [k]() : usize { k * 10 };
        Vec::push(&mut fs, d);
        fs[0] = [k]() : usize { k + 1 };
    }
    foreach (f in &fs)
    {
        printf("%d\n", (*f)());
    }
}
end
run $COBC --run closure_binding_ok.cb
status 0
stdout-is 5\n10\n20\n40\n40\n
run $COBC --all-checks --run closure_binding_ok.cb
status 0
stdout-is 5\n10\n20\n40\n40\n
# 114: a reference used only in a `match`'s integer or `bool` scrutinee
# ends once the scrutinee is read, as after an `if`'s condition: the arm's
# write is taken in both forms.
file match_scrutinee_ends.cb
import std;

fn main()
{
    Vec<u32> v = Vec::from_slice(&[0: u32, 1]);
    ref<u32, shared> it = &v[0];
    match (*it)
    {
        0 : { v[0] = 5; },
        _ : {},
    }
    printf("%v\n", v[0]);
    ref<u32, shared> r = &v[1];
    match (*r + 1)
    {
        2 : { v[1] = 7; },
        n : { v[1] = n; },
    }
    printf("%v\n", v[1]);
    bool flag = true;
    ref<bool, shared> f = &flag;
    match (*f)
    {
        true  : { flag = false; },
        false : {},
    }
    printf("%v\n", flag);
}
end
run $COBC --run match_scrutinee_ends.cb
status 0
stdout-is 5\n7\nfalse\n
run $COBC --all-checks --run match_scrutinee_ends.cb
status 0
stdout-is 5\n7\nfalse\n
# 114: named in the arm after the write, it is still live there.
file match_arm_uses_ref.cb
import std;

// The reference is named in an arm after the write: still live there.
fn main()
{
    Vec<u32> v = Vec::from_slice(&[0: u32, 1]);
    ref<u32, shared> it = &v[0];
    match (*it)
    {
        0 : { v[0] = 5; printf("%v\n", *it); },
        _ : {},
    }
    printf("%v\n", v[0]);
}
end
run $COBC --check match_arm_uses_ref.cb
status 1
stderr-has diag.aliasing-conflict
stderr-has `it` still borrows `v[0]`
# 183: a pattern test on a probe-only parameter (`if (Some(rest) =
# StringView::strip_prefix(path, "x."))`, and in a `match`) whose binder only
# feeds comparisons is a probe.
file from_pattern_probe.cb
import std;

struct Entry
{
    String key;
    String value;
}

// The value for `path` ("x.key" or "key").
fn lookup(ref<Vec<Entry>, shared> entries, StringView path) : Option<ref<String, shared>> from entries
{
    if (Some(rest) = StringView::strip_prefix(path, "x."))
    {
        foreach (e in entries)
        {
            if (e.key == rest)
            {
                return Some(&e.value);
            }
        }
        return None;
    }
    foreach (e in entries)
    {
        if (e.key == path)
        {
            return Some(&e.value);
        }
    }
    None
}

fn lookup2(ref<Vec<Entry>, shared> entries, StringView path) : Option<ref<String, shared>> from entries
{
    match (StringView::strip_prefix(path, "x."))
    {
        Some(rest) :
        {
            foreach (e in entries)
            {
                if (StringView::len(rest) > 0 && e.key == rest)
                {
                    return Some(&e.value);
                }
            }
            None
        },
        None       : None,
    }
}

fn main()
{
    Vec<Entry> es = Vec::new();
    Vec::push(&mut es, Entry { .key = "port", .value = "8080" });
    match (lookup(&es, "x.port"))
    {
        Some(v) : printf("%s\n", v),
        None    : printf("none\n"),
    }
    match (lookup2(&es, "x.port"))
    {
        Some(v) : printf("%s\n", v),
        None    : printf("none\n"),
    }
}
end
run $COBC --run from_pattern_probe.cb
status 0
stdout-is 8080\n8080\n
run $COBC --all-checks --run from_pattern_probe.cb
status 0
stdout-is 8080\n8080\n
# 183: a binder returned keeps the parameter.
file from_pattern_kept.cb
import std;

// Must stay refused: the binder escapes into the result.
fn bad(ref<String, shared> s, StringView path) : Option<StringView> from s
{
    if (Some(rest) = StringView::strip_prefix(path, "x."))
    {
        return Some(rest);
    }
    Some(&s[0..1])
}

fn bad2(ref<String, shared> s, StringView path) : StringView from s
{
    StringView r = &s[0..1];
    match (StringView::strip_prefix(path, "x."))
    {
        Some(rest) :
        {
            r = rest;
        },
        None       : {},
    }
    r
}

fn main()
{
    String s = String::copy("ab");
    printf("%v\n", Option::is_some(&bad(&s, "x.y")));
    printf("%s\n", bad2(&s, "x.y"));
}
end
run $COBC --check from_pattern_kept.cb
status 1
stderr-has diag.result-source-kept
stderr-has keeps `path` here
