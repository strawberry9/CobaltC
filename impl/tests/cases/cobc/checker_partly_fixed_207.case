# 311: two ranges of one slice that meet at a local no statement writes
# (`[0 .. mid]`, `[mid .. n]`) are disjoint: lent to two threads, the
# function is decided.
file split_spawn.cb
import std;

// Splits `s` in halves, gives each half to a thread while `depth > 0`,
// and at the leaves does plain work on the elements.
fn work(slice<u64, exclusive> s, usize depth)
{
    usize n = slice_len(s);
    if (depth > 0)
    {
        usize mid = n / 2;
        auto a = spawn(work, &mut s[0..mid], depth - 1);
        auto b = spawn(work, &mut s[mid..n], depth - 1);
        join(a);
        join(b);
        return;
    }
    foreach (round in 0..20)
    {
        for (usize i = 0; i < n; i += 1)
        {
            s[i] = wrapping_add(wrapping_mul(s[i], 3), 1);
        }
    }
}

fn main()
{
    usize depth = 0;
    if (arg_count() > 0)
    {
        depth = Result::unwrap(StringView::parse<usize>(&Result::unwrap(arg(0))));
    }
    Vec<u64> v = Vec::filled(400000, 1: u64);
    u64 t0 = monotonic_ns();
    work(&mut v, depth);
    printf("depth %v: %v ms, v[7] = %v\n", depth, (monotonic_ns() - t0) / 1000000, v[7]);
}
end
run $COBC --report-tracking split_spawn.cb
status 0
stdout-has no run-time tracking
run $COBC -o split split_spawn.cb
status 0
run ./split 2
status 0
stdout-has v[7] = 5230176601
# 311: `mid` written between the two borrows: the ranges overlap, and
# the run finds it in both forms.
file split_written.cb
import std;

fn work(slice<u64, exclusive> s, usize depth)
{
    foreach (i in 0..slice_len(s))
    {
        s[i] = s[i] + widen<u64>(depth);
    }
}

// `mid` is written between the two borrows: the two ranges overlap.
fn split(slice<u64, exclusive> s)
{
    usize n = slice_len(s);
    usize mid = n / 2;
    auto a = spawn(work, &mut s[0..mid], 1);
    mid = mid - 1;
    auto b = spawn(work, &mut s[mid..n], 2);
    join(a);
    join(b);
}

fn main()
{
    Vec<u64> v = Vec::filled(8, 1: u64);
    split(&mut v);
    printf("%v\n", v[3]);
}
end
run $COBC --run split_written.cb
status 1
stderr-has diag.aliasing-conflict
run $COBC --all-checks --run split_written.cb
status 1
stderr-has diag.aliasing-conflict
# 311: a second binding of the name, and one declared in a loop, give
# no key.
file split_shadowed.cb
import std;

fn work(slice<u64, exclusive> s, usize depth)
{
    foreach (i in 0..slice_len(s))
    {
        s[i] = s[i] + widen<u64>(depth);
    }
}

// Two bindings named `mid`: the second range starts at the inner one.
fn split(slice<u64, exclusive> s)
{
    usize n = slice_len(s);
    usize mid = n / 2;
    auto a = spawn(work, &mut s[0..mid], 1);
    {
        usize mid = 1;
        auto b = spawn(work, &mut s[mid..n], 2);
        join(b);
    }
    join(a);
}

// Declared in a loop: each pass has its own `m`, and a handle of one pass
// outlives it.
fn looped(slice<u64, exclusive> s)
{
    usize n = slice_len(s);
    Vec<handle<void>> hs = Vec::new();
    foreach (k in 0..2)
    {
        usize m = n / 2 - k;
        if (k == 0)
        {
            Vec::push(&mut hs, spawn(work, &mut s[0..m], 1));
        }
        else
        {
            Vec::push(&mut hs, spawn(work, &mut s[m..n], 2));
        }
    }
    foreach (h in hs)
    {
        join(h);
    }
}

fn main()
{
    Vec<u64> v = Vec::filled(8, 1: u64);
    split(&mut v);
    printf("%v\n", v[3]);
    looped(&mut v);
    printf("%v\n", v[3]);
}
end
run $COBC --run split_shadowed.cb
status 1
stderr-has diag.aliasing-conflict
run $COBC --all-checks --run split_shadowed.cb
status 1
stderr-has diag.aliasing-conflict
# 311: declared in a loop.
file split_looped.cb
import std;

fn work(slice<u64, exclusive> s, usize depth)
{
    foreach (i in 0..slice_len(s))
    {
        s[i] = s[i] + widen<u64>(depth);
    }
}

// Two bindings named `mid`: the second range starts at the inner one.
fn split(slice<u64, exclusive> s)
{
    usize n = slice_len(s);
    usize mid = n / 2;
    auto a = spawn(work, &mut s[0..mid], 1);
    {
        usize mid = 1;
        auto b = spawn(work, &mut s[mid..n], 2);
        join(b);
    }
    join(a);
}

// Declared in a loop: each pass has its own `m`, and a handle of one pass
// outlives it.
fn looped(slice<u64, exclusive> s)
{
    usize n = slice_len(s);
    Vec<handle<void>> hs = Vec::new();
    foreach (k in 0..2)
    {
        usize m = n / 2 - k;
        if (k == 0)
        {
            Vec::push(&mut hs, spawn(work, &mut s[0..m], 1));
        }
        else
        {
            Vec::push(&mut hs, spawn(work, &mut s[m..n], 2));
        }
    }
    foreach (h in hs)
    {
        join(h);
    }
}

fn main()
{
    Vec<u64> v = Vec::filled(8, 1: u64);
    looped(&mut v);
    printf("%v\n", v[3]);
}
end
run $COBC --run split_looped.cb
status 1
stderr-has diag.aliasing-conflict
run $COBC --all-checks --run split_looped.cb
status 1
stderr-has diag.aliasing-conflict
