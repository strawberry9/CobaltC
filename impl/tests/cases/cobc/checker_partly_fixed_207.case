# 229: a block's `String` value borrowed where a `StringView` is declared,
# as `&String::copy(...)` is.
file block_text_argument.cb
import std;

fn width(StringView s) : usize
{
    StringView::len(s)
}

fn main()
{
    printf("%v\n", StringView::len(&String::copy("abcd")));
    printf("%v\n", StringView::len(&{ String::copy("abcd") }));
    printf("%v\n", width(&unsafe { String::copy("abcde") }));
    printf("%v\n", width(&{ String::copy("ab") }));
}
end
run $COBC --run block_text_argument.cb
status 0
stdout-is 4\n4\n5\n2\n
run $COBC --all-checks --run block_text_argument.cb
status 0
stdout-is 4\n4\n5\n2\n
