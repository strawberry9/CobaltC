}
end
run $COBC --check f441.cb
status 1
stderr-has `None` is a variant, a value, not a variable
file f442.cb
import std;

static Atomic<u32> HITS = 0;

fn main()
{
    Atomic::fetch_add(&HITS, 1);
    HITS = Atomic::new(5: u32);
    printf("%v\n", Atomic::load(&HITS));
}
end
run $COBC --check f442.cb
status 1
stderr-has diag.static-assigned
file f443.cb
import std;

fn less(ref<i32, shared> a, ref<i32, shared> b) : bool
{
    *a < *b
}

fn apply(ref<fn(ref<i32, shared>, ref<i32, shared>) : bool, shared> f, i32 x, i32 y) : bool
{
    (*f)(&x, &y)
}

fn main()
{
    printf("%v\n", apply(&less, 1, 2));
}
end
run $COBC --check f443.cb
status 1
stderr-has is a function, a value of a `fn(…)` type, not a place
