# 374: `exit` in a test fails the run.
file f374.cb
import std;

fn die_if_negative(i32 n) : i32
{
    if (n < 0)
    {
        eprintf("negative\n");
        exit(0);
    }
    n
}

unittest "first"
{
    assert(die_if_negative(1) == 1);
}

unittest "calls exit"
{
    assert(die_if_negative(-1) == 99);
}

unittest "never runs?"
{
    assert(false);
}
end
run $COBC --unittest --run f374.cb
status 1
stdout-has `exit(0)` was called during the test
# 356: overwriting a live resource element of a `Vec` is refused.
file f356.cb
import std;

resource struct Res
{
    i32 id;
}

fn Res::drop(ref<Res, exclusive> self)
{
    printf("drop %v\n", self.id);
}

fn main()
{
    Vec<Res> v = Vec::new();
    Vec::push(&mut v, Res { .id = 1 });
    v[0] = Res { .id = 2 };
    printf("after element\n");
}
end
run $COBC --check f356.cb
status 1
stderr-has diag.overwrite-of-live-resource
