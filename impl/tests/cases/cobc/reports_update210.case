# The reports of Update 209's round fixed in the checker and the lowering
# (D-0339): programs `--check` accepted that read freed memory, gave wrong
# results or crashed cobc are refused or run correctly; `drop` of an
# element is a move; a variant literal is checked against the type
# parameters the other arguments fix; assignments that change nothing are
# refused; a shift's literal is an `i32`; a `spawn` statement is warned.
# 392: a struct field holding views keeps its text borrowed: the write
# faults in the default build instead of reading freed memory.
file f392.cb
import std;

struct Doc
{
    String text;
    Vec<StringView> lines;
}

fn main()
{
    Doc d = Doc { .text = "first line\nsecond line\n", .lines = Vec::new() };
    d.lines = StringView::lines(&d.text);
    String::append(&mut d.text, "a much longer tail, so that the String's buffer is reallocated and freed\n");
    printf("%s|%s\n", d.lines[0], d.lines[1]);
}
end
run $COBC --check f392.cb
status 0
run $COBC --run f392.cb
status 1
stderr-has diag.aliasing-conflict
# 407: `&b[0]` of a parameter `from a` leaves out is a kept use of `b`.
file f407.cb
import std;


fn el(ref<Vec<u64>, shared> a, ref<Vec<u64>, shared> b) : ref<u64, shared> from a
{
    &b[0]
}

fn main()
{
    Vec<u64> a = Vec::from_slice(&[1: u64, 2, 3]);
    ref<u64, shared> e = &a[0];
    {
        Vec<u64> b = Vec::from_slice(&[7: u64, 8, 9]);
        e = el(&a, &b);
    }
    Vec<u64> c = Vec::from_slice(&[555: u64, 666, 777]);
    printf("%v\n", *e);
}
end
run $COBC --check f407.cb
status 1
stderr-has diag.result-source-kept
# 439: `drop(v[0])` moves a `String` out of an element: refused.
file f439.cb
import std;

fn main()
{
    Vec<String> v = Vec::new();
    Vec::push(&mut v, "a");
    Vec::push(&mut v, "b");
    drop(v[0]);
    printf("%v %v\n", Vec::len(&v), &v[0]);
}
end
run $COBC --check f439.cb
status 1
stderr-has diag.move-out-of-field
# 408: `Ok(small)` is checked against the `T` the closure fixes.
file f408.cb
import std;

fn map_ok<T, E, U>(Result<T, E> r, fn(T) : U f) : Result<U, E>
{
    match (r)
    {
        Ok(v) : Ok(f(v)),
        Err(e) : Err(e),
    }
}

fn main()
{
    u8 small = 200;
    Result<f64, i32> m = map_ok(Ok(small), [](f64 x) : f64 { x * 2.0 });
    printf("%v\n", Result::unwrap(m));
}
end
run $COBC --check f408.cb
status 1
stderr-has `Ok` holds a `f64`, but this is `u8`
file f408b.cb
import std;

fn map_ok<T, E, U>(Result<T, E> r, fn(T) : U f) : Result<U, E>
{
    match (r)
    {
        Ok(v) : Ok(f(v)),
        Err(e) : Err(e),
    }
}

fn main()
{
    Result<usize, i32> m = map_ok(Ok("hello"), [](String s) : usize { StringView::len(&s) });
    printf("%v\n", Result::unwrap(m));
}
end
run $COBC --run f408b.cb
status 0
stdout-is 5\n
# 440, 441, 442, 443: assignments that change nothing, or a static.
file f440.cb
import std;

const array<u8, 12> DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];

fn days_in(i64 year, usize month) : u8
{
    if (year % 4 == 0 && (year % 100 != 0 || year % 400 == 0))
    {
        DAYS[1] = 29;            // accepted by --check; changes nothing
    }
    DAYS[month - 1]
}

fn main()
{
    printf("%v\n", days_in(2024, 2));
}
end
run $COBC --check f440.cb
status 1
stderr-has is a constant, which stands for its value
file f441.cb
import std;

fn main()
{
