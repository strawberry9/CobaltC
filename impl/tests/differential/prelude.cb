// The prelude every generated program starts with: helpers the random
// statements call.

import std;

export fn prelude() : String
{
    String s = String::new();
    String::append(&mut s, "import std;\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn byte(u8 b)\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    auto buf = [b];\n");
    String::append(&mut s, "    rawptr<u8> p = reinterpret_ptr<u8>(rawptr_of(&buf));\n");
    String::append(&mut s, "    unsafe\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        stdout_write(p, 1);\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn digits(u64 n)\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    if (n >= 10)\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        digits(n / 10);\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "    byte(narrow<u8>(n % 10) + 48);\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn show(i64 n)\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    if (n < 0)\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        printf(\"-\");\n");
    String::append(&mut s, "        digits(wrapping_sub(0: u64, reinterpret<u64>(n)));\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "    else\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        digits(reinterpret<u64>(n));\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "    printf(\"\\n\");\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn showu(u64 n)\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    digits(n);\n");
    String::append(&mut s, "    printf(\"\\n\");\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "resource struct Tracer\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    i32 id;\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn Tracer::drop(ref<Tracer, exclusive> self)\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    printf(\"drop \");\n");
    String::append(&mut s, "    show(widen<i64>(self.id));\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn make(i32 id) : Tracer\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    Tracer { .id = id }\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn sum(ref<Vec<i32>, shared> v) : i64\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    i64 s = 0;\n");
    String::append(&mut s, "    usize i = 0;\n");
    String::append(&mut s, "    while (i < Vec::len(v))\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        s = s + widen<i64>(*Vec::index_shared(v, i));\n");
    String::append(&mut s, "        i = i + 1;\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "    s\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn fill(ref<Vec<i32>, exclusive> v, i32 n)\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    i32 k = 0;\n");
    String::append(&mut s, "    while (k < n)\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        Vec::push(v, k * 3 - 4);\n");
    String::append(&mut s, "        k = k + 1;\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn set(ref<Vec<i32>, exclusive> v, usize i, i32 x)\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    *Vec::index_exclusive(v, i) = x;\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn takes(Vec<i32> v) : usize\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    Vec::len(&v)\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn fill_twice(ref<Vec<i32>, exclusive> v, i32 n)\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    fill(v, n);\n");
    String::append(&mut s, "    fill(&mut *v, n);\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn sum_from(ref<Vec<i32>, shared> v, usize i) : i64\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    if (i >= Vec::len(v))\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        0\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "    else\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        widen<i64>(*Vec::index_shared(v, i)) + sum_from(v, i + 1)\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn first_ref(ref<Vec<i32>, shared> v) : ref<i32, shared>\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    Vec::index_shared(v, 0)\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn copy_first(ref<Vec<i32>, exclusive> a, ref<Vec<i32>, shared> b)\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    if (Vec::len(b) > 0)\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        Vec::push(a, *Vec::index_shared(b, 0));\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn tally(ref<HashMap<i64, i64>, exclusive> m, i64 k)\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    *HashMap::entry(m, k, 0) += 1;\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn mget(ref<HashMap<i64, i64>, shared> m, i64 k) : i64\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    match (HashMap::get(m, k))\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        Some(v) : *v,\n");
    String::append(&mut s, "        None : 0 - 1,\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "struct Pt\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    i32 x;\n");
    String::append(&mut s, "    i32 y;\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn grow_pts(ref<Vec<Pt>, exclusive> v) : i32\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    usize n = 0;\n");
    String::append(&mut s, "    while (n < 40)\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        Vec::push(v, Pt { .x = 1, .y = 2 });\n");
    String::append(&mut s, "        n = n + 1;\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "    3\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn two(i32 a, i32 b) : i64\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    widen<i64>(a) * 1000 + widen<i64>(b)\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn vcount(StringView s, str t) : i64\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    i64 n = 0;\n");
    String::append(&mut s, "    StringView rest = s;\n");
    String::append(&mut s, "    while (Some(i) = StringView::find(rest, StringView::of(t)))\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        n = n + 1;\n");
    String::append(&mut s, "        rest = &rest[i + 1..$];\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "    n * 100 + widen<i64>(narrow<i32>(StringView::len(s)))\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn owned_total(Vec<i32> v) : Vec<i32>\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    i64 t = 0;\n");
    String::append(&mut s, "    usize i = 0;\n");
    String::append(&mut s, "    while (i < Vec::len(&v))\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        t = t + widen<i64>(v[i]);\n");
    String::append(&mut s, "        i = i + 1;\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "    show(t);\n");
    String::append(&mut s, "    v\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn mword(ref<String, shared> s, usize i) : i64\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    auto parts = StringView::split(&(*s)[0..$], \" \");\n");
    String::append(&mut s, "    match (StringView::parse<i64>(parts[i]))\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        Ok(n) : n,\n");
    String::append(&mut s, "        Err(_) : 0 - 2,\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn bump(ref<i32, exclusive> p, i32 k)\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    *p = *p + k;\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "struct Hold\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    ref<i32, exclusive> r;\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn bump_hold(Hold h)\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    *h.r = *h.r + 1;\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn read_hold(ref<Hold, shared> h) : i32\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    *h.r\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn add_locked(ref<mutex<i64>, shared> m, i64 k)\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    auto g = lock(m);\n");
    String::append(&mut s, "    *g = *g + k;\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn sum_chan(ref<Channel<i64>, shared> ch) : i64\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    i64 s = 0;\n");
    String::append(&mut s, "    while (Some(x) = Channel::recv(ch))\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        s = s + x;\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "    s\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn take_refs(ref<Channel<ref<i32, exclusive>>, shared> ch)\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    while (Some(r) = Channel::recv(ch))\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        *r = *r + 100;\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn apply_mut(ref<fn(i32) : i32, exclusive> f, i32 k) : i32\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    (*f)(k)\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn apply_shared(ref<fn(i32) : i32, shared> f, i32 k) : i32\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    (*f)(k)\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn sum_refs(ref<Vec<ref<i32, shared>>, shared> rs) : i64\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    i64 s = 0;\n");
    String::append(&mut s, "    usize i = 0;\n");
    String::append(&mut s, "    while (i < Vec::len(rs))\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        s = s + widen<i64>(**Vec::index_shared(rs, i));\n");
    String::append(&mut s, "        i = i + 1;\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "    s\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    String::append(&mut s, "fn take_holds(ref<Channel<Hold>, shared> ch)\n");
    String::append(&mut s, "{\n");
    String::append(&mut s, "    while (Some(h) = Channel::recv(ch))\n");
    String::append(&mut s, "    {\n");
    String::append(&mut s, "        *h.r = *h.r + 10;\n");
    String::append(&mut s, "    }\n");
    String::append(&mut s, "}\n");
    String::append(&mut s, "\n");
    s
}
