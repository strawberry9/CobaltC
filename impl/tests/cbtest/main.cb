// cbtest — the CobaltC test runner, written in CobaltC (D-0326, phase D).
//
//   cbtest conformance [--cobc PATH] [--cc CC]... [--root DIR]
//                      [--shard I/N] [--slow] [--cpu SECS] [--wall SECS]
//   cbtest rows [the same options; --repo DIR for the repository's root]
//
// `conformance`: the file-based suite (impl/conformance), compiled and run
// by `cobc --run` under each `--cc` (default gcc and clang), each case's
// outcome against its header and its output against the case's recorded
// `.expect` file. `--shard I/N` runs the cases whose place in the sorted list is I-1
// modulo N. With COBALTC_RESULT_STORE and COBALTC_TOOLCHAIN_KEY set (the
// gate sets both, D-0307), runs that met their check are kept and not made
// again. `rows`: every row of spec/conformance.md (rows.cb), assembled and
// run the same way, against its stated outcome and phase. Exit status 0 when every case run passed, 1 when one did not, 2
// for a usage error.

import std;

module host "./host.cb";
module cases "./cases.cb";
module store "./store.cb";
module suite "./suite.cb";
module rows "./rows.cb";
module script "./script.cb";

import store;
import suite;
import rows;
import script;

// Every `.case` file under `dir`.
fn find_case_files(StringView dir, ref<Vec<String>, exclusive> out)
{
    Vec<String> names = match (list_dir(dir))
    {
        Ok(n)  : n,
        Err(_) : return,
    };
    foreach (n in &names)
    {
        String p = path_join(dir, n);
        match (path_kind(&p))
        {
            Ok(k)  :
            {
                match (k)
                {
                    PathKind::Dir     : find_case_files(&p, out),
                    PathKind::File(_) :
                    {
                        if (StringView::ends_with(n, ".case"))
                        {
                            Vec::push(out, p);
                        }
                    },
                    _                 : {},
                }
            },
            Err(_) : {},
        }
    }
}

fn usage() : u8
{
    eprintf("usage: cbtest (conformance | rows | cases) [--cobc PATH] [--cc CC]... [--root DIR] [--shard I/N] [--slow] [--cpu SECS] [--wall SECS]\n");
    2
}

fn env_or(str name, StringView fallback) : String
{
    match (env_var(name))
    {
        Ok(Some(v)) : if (StringView::len(&v) > 0) { v } else { String::copy(fallback) },
        _           : String::copy(fallback),
    }
}

// The settings of the compiler and the runtime that change how a case is
// compiled or run. A kept result is a result under these too: the store's
// key takes each one that is set (D-0307; without them `COBALTC_ALL_CHECKS=1
// cbtest conformance` answered from the results the default form had left).
// impl/tests/checks/store_env.py holds this list to the names the sources
// read.
const array<str, 19> RUN_SETTINGS = [
    "COBALTC_ALL_CHECKS",
    "COBALTC_CHECK_ALL",
    "COBALTC_RECORD",
    "COBALTC_VERIFY",
    "COBALTC_BOOTSTRAP_UPTO",
    "COBALTC_BOOTSTRAP_FORM",
    "COBALTC_PATHLESS",
    "COBALTC_DECIDED",
    "COBALTC_RUNNER",
    "COBALTC_SCHEDULE_SEED",
    "COBALTC_TEXT_LINTS",
    "COBALTC_WARN_SHADOW",
    "COBALTC_ALLOW_DEPRECATED",
    "COBALTC_EXPLAIN",
    "COBALTC_STD_FN_VALUES",
    "COBALTC_TRACE_EVENTS",
    "COBALTC_RT_STATS",
    "COBALTC_REPLAY_TRACE",
    "COBALTC_TEST_INTERNAL_ERROR",
];

// The toolchain's key with the settings that are set; empty stays empty (no
// store).
fn key_with_settings(String key) : String
{
    if (StringView::len(&key) == 0)
    {
        return key;
    }
    String out = key;
    for (usize i = 0; i < 19; i += 1)
    {
        match (env_var(RUN_SETTINGS[i]))
        {
            Ok(Some(v)) : String::append(&mut out, &sprintf("\u{0}%s=%s", RUN_SETTINGS[i], &v)),
            _           : {},
        }
    }
    out
}

fn main() : u8
{
    Vec<String> a = Vec::new();
    for (usize i = 0; i < arg_count(); i += 1)
    {
        match (arg(i))
        {
            Ok(s)  : Vec::push(&mut a, s),
            Err(_) : return usage(),
        }
    }
    if (Vec::len(&a) < 1 || (a[0] != "conformance" && a[0] != "rows" && a[0] != "cases" && a[0] != "record"))
    {
        return usage();
    }
    bool want_rows = a[0] == "rows";
    bool on_windows = path_join("a", "b") == "a\\b";
    Ctx c = Ctx {
        .cobc = path_join("impl", &path_join("target", &path_join("release", "cobc"))),
        .ccs = Vec::new(),
        .st = Store::off(),
        .shard_i = 1,
        .shard_n = 1,
        .slow = false,
        .on_windows = on_windows,
        .tmp_base = env_or(if (on_windows) { "TEMP" } else { "TMPDIR" }, if (on_windows) { "." } else { "/tmp" }),
        .cpu_secs = 300,
        .wall_secs = 600,
        .expect_dir = "",
    };
    String root = path_join("impl", "conformance");
    // The repository's root (the rows' files are relative to it).
    String repo = ".";
    // `record`'s output directory.
    String out_dir = "";
    usize i = if (a[0] == "record" && Vec::len(&a) > 1 && a[1] == "rows") { 2 } else { 1 };
    while (i < Vec::len(&a))
    {
        ref<String, shared> o = &a[i];
        bool takes = *o == "--cobc" || *o == "--cc" || *o == "--root" || *o == "--repo" || *o == "--out" || *o == "--shard" || *o == "--cpu" || *o == "--wall";
        if (takes && i + 1 >= Vec::len(&a))
        {
            return usage();
        }
        if (*o == "--cobc")
        {
            c.cobc = String::clone(&a[i + 1]);
        }
        else if (*o == "--cc")
        {
            Vec::push(&mut c.ccs, String::clone(&a[i + 1]));
        }
        else if (*o == "--root")
        {
            root = String::clone(&a[i + 1]);
        }
        else if (*o == "--out")
        {
            out_dir = String::clone(&a[i + 1]);
        }
        else if (*o == "--repo")
        {
            repo = String::clone(&a[i + 1]);
        }
        else if (*o == "--shard")
        {
            Vec<StringView> p = StringView::split(&a[i + 1], "/");
            if (Vec::len(&p) != 2)
            {
                return usage();
            }
            c.shard_i = Result::unwrap_or(StringView::parse<usize>(p[0]), 0);
            c.shard_n = Result::unwrap_or(StringView::parse<usize>(p[1]), 0);
            if (c.shard_i < 1 || c.shard_n < 1 || c.shard_i > c.shard_n)
            {
                return usage();
            }
        }
        else if (*o == "--cpu")
        {
            c.cpu_secs = Result::unwrap_or(StringView::parse<i64>(&a[i + 1]), 300);
        }
        else if (*o == "--wall")
        {
            c.wall_secs = Result::unwrap_or(StringView::parse<i64>(&a[i + 1]), 600);
        }
        else if (*o == "--slow")
        {
            c.slow = true;
            i += 1;
            continue;
        }
        else
        {
            return usage();
        }
        i += 2;
    }
    if (Vec::len(&c.ccs) == 0)
    {
        Vec::push(&mut c.ccs, "gcc");
        Vec::push(&mut c.ccs, "clang");
    }
    c.st = Store { .dir = env_or("COBALTC_RESULT_STORE", ""), .tool_key = key_with_settings(env_or("COBALTC_TOOLCHAIN_KEY", "")) };
    String abs_root = Result::unwrap_or(path_canonical(&root), String::clone(&root));
    repo = Result::unwrap_or(path_canonical(&repo), String::clone(&repo));
    // Each case runs in its own directory: the tools by their absolute paths.
    c.cobc = Result::unwrap_or(path_canonical(&c.cobc), String::clone(&c.cobc));
    bool bad = false;
    if (a[0] == "record")
    {
        // `record --out DIR`: each case's run, the C compilers' runs
        // agreeing, written as DIR/…/NAME.expect (D-0326, phase E).
        if (StringView::len(&out_dir) == 0)
        {
            return usage();
        }
        Tally t = if (Vec::len(&a) > 1 && a[1] == "rows") { record_rows(&c, &repo, &out_dir) } else { record(&c, &abs_root, &out_dir) };
        eprintf("cbtest record: %v recorded, %v not run here, %v disagree\n", t.passed, Vec::len(&t.skipped), Vec::len(&t.failed));
        foreach (f in &t.failed)
        {
            eprintf("  DISAGREE %s\n", f);
        }
        return if (Vec::len(&t.failed) > 0) { 1 } else { 0 };
    }
    if (a[0] == "cases")
    {
        // `cases`: every `.case` file under the root (script.cb); a case that
        // names `$CC` runs under each C compiler, any other once.
        Vec<String> files = Vec::new();
        find_case_files(&abs_root, &mut files);
        Vec::sort(&mut files);
        usize passed = 0;
        usize failed = 0;
        for (usize k = 0; k < Vec::len(&files); k += 1)
        {
            if (k % c.shard_n != c.shard_i - 1)
            {
                continue;
            }
            String text = Result::unwrap_or(read_file(&files[k]), "");
            if (skipped_here(&text, c.on_windows))
            {
                eprintf("  skipped %s: its `platform` line names another platform\n", &files[k]);
                continue;
            }
            usize times = if (StringView::contains(&text, "$CC")) { Vec::len(&c.ccs) } else { 1 };
            for (usize j = 0; j < times; j += 1)
            {
                Tools t = Tools { .cobc = String::clone(&c.cobc), .cc = String::clone(&c.ccs[j]), .tmp_base = String::clone(&c.tmp_base), .repo = String::clone(&repo), .cpu_secs = c.cpu_secs, .wall_secs = c.wall_secs };
                match (run_case(&t, &files[k], k * 8 + j))
                {
                    Some(f) :
                    {
                        failed += 1;
                        eprintf("  FAILED %s [%s]: %s\n", &files[k], &c.ccs[j], &f);
                    },
                    None    : passed += 1,
                }
            }
        }
        eprintf("cbtest cases: %v passed, %v failed\n", passed, failed);
        return if (failed > 0) { 1 } else { 0 };
    }
    foreach (cc in &c.ccs)
    {
        Tally t = if (want_rows) { spec_rows(&c, &repo, cc) } else { conformance(&c, &abs_root, cc) };
        eprintf("cbtest %s [%s]: %v passed, %v skipped, %v failed\n", &a[0], cc, t.passed, Vec::len(&t.skipped), Vec::len(&t.failed));
        foreach (s in &t.skipped)
        {
            eprintf("  skipped %s\n", s);
        }
        foreach (f in &t.failed)
        {
            eprintf("  FAILED %s\n", f);
        }
        if (Vec::len(&t.failed) > 0 || t.passed * c.shard_n < (if (want_rows) { 100 } else { 20 }))
        {
            bad = true;
        }
    }
    if (bad) { 1 } else { 0 }
}
