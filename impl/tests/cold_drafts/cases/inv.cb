import std;

struct Item
{
    String name;
    u32 qty;
    f64 price;
}

fn total<T: number>(slice<T, shared> xs) : T
{
    T sum = 0;
    foreach (x in xs) { sum += *x; }
    sum
}

fn find(ref<Vec<Item>, shared> items, StringView name) : Option<ref<Item, shared>>
{
    foreach (it in items)
    {
        if (String::eq(&it.name, name)) { return Some(it); }
    }
    None
}

fn main() : i32
{
    Vec<Item> items = Vec::new();
    Vec::push(&mut items, Item { .name = String::from("bolt"), .qty = 120, .price = 0.25 });
    Vec::push(&mut items, Item { .name = String::from("nut"), .qty = 0, .price = 0.1 });
    Vec::push(&mut items, Item { .name = String::from("gear"), .qty = 7, .price = 12.5 });

    Vec::retain(&mut items, [](ref<Item, shared> it) : bool { it.qty > 0 });
    Vec::sort_by(&mut items, [](ref<Item, shared> a, ref<Item, shared> b) : bool { a.price < b.price });

    Vec<f64> values = Vec::new();
    foreach (it in &items)
    {
        Vec::push(&mut values, to_float<f64>(it.qty) * it.price);
    }
    printf("total value %.2f over %d items\n", total(&values[..]), Vec::len(&items));

    u32 threshold = 10;
    usize low = Vec::count(&items, [threshold](ref<Item, shared> it) : bool { it.qty < threshold });
    printf("%d low\n", low);

    match (find(&items, "gear"))
    {
        Some(it) : printf("gear: %d at %.2f\n", it.qty, it.price),
        None : printf("no gear\n"),
    }
    0
}
