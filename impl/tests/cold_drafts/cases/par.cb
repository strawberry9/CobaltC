import std;

fn is_prime(u64 n) : bool
{
    if (n < 2) { return false; }
    u64 d = 2;
    while (d * d <= n)
    {
        if (n % d == 0) { return false; }
        d += 1;
    }
    true
}

fn main() : i32
{
    u64 limit = 200000;
    u64 workers = 4;
    Channel<u64> ch = Channel::new();
    Vec<handle<void>> hs = Vec::new();
    foreach (w in 0..workers)
    {
        Channel<u64> tx = Channel::clone(&ch);
        u64 lo = w * limit / workers;
        u64 hi = (w + 1) * limit / workers;
        Vec::push(&mut hs, spawn(move [tx, lo, hi]() {
            u64 count = 0;
            foreach (n in lo..hi) { if (is_prime(n)) { count += 1; } }
            Channel::send(&tx, count);
        }));
    }
    u64 total = 0;
    foreach (i in 0..workers) { total += Channel::recv(&ch); }
    foreach (h in hs) { join(h); }
    printf("%d primes below %d\n", total, limit);
    0
}
