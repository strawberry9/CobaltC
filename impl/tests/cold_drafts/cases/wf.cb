import std;

struct Entry
{
    String word;
    usize count;
}

fn is_letter(u8 c) : bool
{
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z')
}

fn lower(u8 c) : u8
{
    if (c >= b'A' && c <= b'Z') { c + 32 } else { c }
}

fn main() : i32
{
    String text = read_to_string(stdin())?;
    HashMap<String, usize> counts = HashMap::new();
    String cur = String::new();
    foreach (c in String::bytes(&text))
    {
        if (is_letter(c))
        {
            String::push(&mut cur, lower(c));
        }
        else if (String::len(&cur) > 0)
        {
            if (Some(n) = HashMap::get_mut(&mut counts, &cur))
            {
                *n += 1;
            }
            else
            {
                HashMap::insert(&mut counts, String::clone(&cur), 1);
            }
            String::clear(&mut cur);
        }
    }
    Vec<Entry> entries = Vec::new();
    foreach (k, v in &counts)
    {
        Vec::push(&mut entries, Entry { .word = String::clone(k), .count = *v });
    }
    Vec::sort_by(&mut entries, [](ref<Entry, shared> a, ref<Entry, shared> b) : bool { a.count > b.count });
    usize shown = 0;
    foreach (e in &entries)
    {
        if (shown == 10) { break; }
        printf("%8d %s\n", e.count, &e.word);
        shown += 1;
    }
    0
}
