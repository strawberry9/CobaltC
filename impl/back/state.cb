// A call made elsewhere as one text, `CALLEE(ARGS)`, whose place knows the
// callee's length `callee`: `TYPE NAME = CALL;`. With `callee` 0 the text is
// no plain call (a choice between two calls): an expression.
export fn em_decl_called(ref<Fx, exclusive> x, StringView ty, StringView name, StringView call, usize callee)
{
    if (callee == 0)
    {
        pe_decl_init(&mut x.out, x.ind * 4, ty, true, name, call, false);
    }
    else
    {
        pe_decl_called(&mut x.out, x.ind * 4, ty, true, name, call, callee);
    }
}

// `CALL;` for such a call; with `callee` 0, an expression's statement, read
// as a line is.
export fn em_called(ref<Fx, exclusive> x, StringView call, usize callee)
{
    if (callee == 0)
    {
        pe_eval(&mut x.out, x.ind * 4, call);
    }
    else
    {
        pe_called(&mut x.out, x.ind * 4, call, callee);
    }
}

// A line of statements made elsewhere (a drop replayed at a scope's end):
// one call with its `;` is a call's node, anything else is read as a line is.
export fn em_line(ref<Fx, exclusive> x, StringView line)
{
    match (StringView::strip_suffix(line, ";"))
    {
        Some(v) : pe_eval(&mut x.out, x.ind * 4, v),
        None    : pbuf_emit(&mut x.out, x.ind * 4, line),
    }
}

// `VALUE;`: a call, or another expression read as a line is.
export fn em_eval(ref<Fx, exclusive> x, StringView value)
{
    pe_eval(&mut x.out, x.ind * 4, value);
}

// A match arm's head: the arm's test opens its block, `if (TEST) {`, or with
// no test the block alone, `{`; an arm chained to the one before it starts
// `else `, a line that opens a block.
export fn em_arm(ref<Fx, exclusive> x, bool chained, ref<Option<String>, shared> test)
{
    match (test)
    {
        Some(c) :
        {
            if (chained)
            {
                pe_open(&mut x.out, x.ind * 4, &sprintf("else if (%s) {", c));
            }
            else
            {
                pe_if(&mut x.out, x.ind * 4, c);
            }
        },
        None    :
        {
            if (chained)
            {
                pe_open(&mut x.out, x.ind * 4, "else {");
            }
            else
            {
                pe_block(&mut x.out, x.ind * 4);
            }
        },
    }
}

// `(void)(VALUE);`
export fn em_void(ref<Fx, exclusive> x, StringView value)
{
    pe_void(&mut x.out, x.ind * 4, value);
}

