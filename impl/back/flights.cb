// D-0286: values between functions in a decided program, which travel with
// no object: a by-value argument or a result is handed over as its bytes,
// the sender's record of it ended (`cb_forget_obj`), and the receiver takes
// it objectless or gives it an object of its own (`cb_new`).

import std;
import ast;
import state;
import layout;
import passes;
import natives;
import gen;
import rt;

// A resource argument leaves for a by-value parameter: in flight
// (`cb_send`); in a decided program, as its value alone, its object's
// record ended here (an inert value, `inert_c`, has none).
export fn give_arg(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<V, shared> t, str what)
{
    // D-0315 (step 4): a pending noted temporary is taken here.
    noted_take(x, &t.c);
    match (&t.obj)
    {
        Some(o) :
        {
            if (g.decided)
            {
                em_rt1(x, RT_FORGET_OBJ, o);
            }
            else
            {
                em_rt1(x, RT_SEND, o);
            }
        },
        None    :
        {
            if (!(g.decided && HashSet::contains(&x.inert_c, &t.c)))
            {
                eprintf("cobc: a resource argument without an object: %s (`%s`)\n", what, &t.c);
                assert(false, "cobc: a resource argument without an object");
            }
        },
    }
}

// D-0286: the call `e`, if it is one, gives its resource result to the
// consumer about to lower it with no object (`finish_call`). Unless nothing
// is evaluated between the call and the consumer (`last`), only a result
// whose end frees memory alone (`objectless_type`): a fault in a later
// argument or field leaves its bytes unfreed, which no code of the program
// sees. (The call is keyed by `args_key`.)
// D-0315 (step 4): an array literal's identity for `raw_arm`: its first
// element's id under its own bit.
export fn array_key(ref<Vec<Expr>, shared> es) : usize
{
    (1 << 59) | es[0].id
}

export fn arm_inert(ref<Gen, shared> g, ref<Fx, exclusive> x, ref<Expr, shared> e, bool last)
{
    if (!g.decided)
    {
        return;
    }
    // D-0315: a `match`, an `if`, a block or a `?` whose value is taken so:
    // its sink raw where its value's end frees memory alone, the value given
    // with no object (`match_sink_obj_var`).
    ref<Expr, shared> s = strip_parens(e);
    x.raw_arm_last = last;
    match (&s.kind)
    {
        ExprKind::EMatch(m)      : x.raw_arm = arms_key(&Box::get(m).arms),
        ExprKind::EIf(ie)        : x.raw_arm = Some(Box::get(ie).cond.id),
        ExprKind::EBlock(b)      : x.raw_arm = Some(block_id(b)),
        ExprKind::EUnsafe(b)     : x.raw_arm = Some(block_id(b)),
        ExprKind::EPropagate(_)  : x.raw_arm = Some(s.id),
        ExprKind::EStructLit(sl) :
        {
            match (struct_key(&Box::get(sl).fields))
            {
                Some(k) : x.raw_arm = Some(k),
                None    : {},
            }
        },
        // D-0315 (step 4): an array literal, by its elements (`array_key`).
        ExprKind::EArrayLit(es)  :
        {
            if (Vec::len(es) > 0)
            {
                x.raw_arm = Some(array_key(es));
            }
        },
        _                        : {},
    }
    match (&s.kind)
    {
        ExprKind::ECall(c) :
        {
            // D-0315 (step 4): an empty container owns nothing a later fault
            // could leave unended (`empty_ctor`).
            bool l = last || (Vec::len(&Box::get(c).args) == 0 && empty_ctor(g, x, &Box::get(c).callee));
            x.inert_result = Some(InertResult { .key = args_key(&Box::get(c).args), .last = l });
        },
        _                  : {},
    }
}

// D-0315 (step 4): `std`'s `Vec::new`, `HashMap::new`, `HashSet::new`,
// `Queue::new` or `String::new`, named by `callee`.
export fn empty_ctor(ref<Gen, shared> g, ref<Fx, exclusive> x, ref<Expr, shared> callee) : bool
{
    ref<PathExpr, shared> p = match (&callee.kind)
    {
        ExprKind::EPath(p) : Box::get(p),
        _                  : return false,
    };
    if (Vec::len(&p.segs) == 1 && is_bound(x, &p.segs[0]))
    {
        return false;
    }
    String k = join_segs(&p.segs);
    if (!HashMap::contains(&g.prog.table.fns, &k))
    {
        k = sprintf("std::%s", &k);
    }
    if (!(k == "std::Vec::new" || k == "std::HashMap::new" || k == "std::HashSet::new" || k == "std::Queue::new" || k
        == "std::String::new"))
    {
        return false;
    }
    match (HashMap::get(&g.prog.table.fns, &k))
    {
        Some(f) : in_prelude(&k, f),
        None    : false,
    }
}

// D-0315: a struct literal's identity for `raw_arm`: its first field's
// value; none for a literal with no field.
export fn struct_key(ref<Vec<FieldInit>, shared> fields) : Option<usize>
{
    if (Vec::len(fields) > 0) { Some(fields[0].value.id) } else { None }
}

// D-0315: the object of `v`: its own, or, for an inert value (no object,
// `inert_c`) whose consumer needs one, an object given it here, where it
// lands. None for a value of neither kind.
export fn materialize(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<V, shared> v, usize line) : Option<String>
{
    if (Option::is_some(&v.obj))
    {
        return clone(&v.obj);
    }
    if (!HashSet::contains(&x.inert_c, &v.c))
    {
        return None;
    }
    u32 tid = type_id(g, &v.ty);
    String lc = loc(g, x.std_body, line);
    String o = fresh(g, "o");
    em_decl_rt3(x, "uint64_t", &o, RT_NEW, &sprintf("&%s", &v.c), &sprintf("%vu", tid), &lc);
    Some(o)
}

// A decided program's by-value argument `e` that calls a function of the
// program with a `__raw` form (`raw_ret_ok`): its name. Not a local's call
// (a `fn` value), nor one whose own arguments name the function (their calls
// would take the raw form first, `finish_call`).
export fn raw_arg_call(ref<Gen, exclusive> g, ref<Fx, shared> x, ref<Expr, shared> e) : Option<String>
{
    if (!g.decided)
    {
        return None;
    }
    ref<CallExpr, shared> c = match (&strip_parens(e).kind)
    {
        ExprKind::ECall(c) : Box::get(c),
        _                  : return None,
    };
    ref<PathExpr, shared> p = match (&c.callee.kind)
    {
        ExprKind::EPath(p) : Box::get(p),
        _                  : return None,
    };
    if (Vec::len(&p.segs) != 1 || Vec::len(&p.targs) != 0 || is_bound(x, &p.segs[0]))
    {
        return None;
    }
    foreach (a in &c.args)
    {
        if (mentions(a, &p.segs[0]))
        {
            return None;
        }
    }
    if (raw_ret_ok(g, &p.segs[0])) { Some(String::clone(&p.segs[0])) } else { None }
}

// `e` is a place rooted at a `foreach` read alias (`foreach_alias`): `x.f`,
// `x.v[i]`, `(*x).f` for an aliased element `x`.
export fn alias_rooted(ref<Fx, shared> x, ref<Expr, shared> e) : bool
{
    ref<Expr, shared> c = e;
    while (true)
    {
        match (&c.kind)
        {
            ExprKind::EField(f)  : c = &Box::get(f).e,
            ExprKind::EIndex(ix) : c = &Box::get(ix).a,
            ExprKind::EDeref(d)  : c = Box::get(d),
            ExprKind::EParen(i)  : c = Box::get(i),
            ExprKind::EPath(p)   : return Vec::len(&Box::get(p).segs) == 1 && HashMap::contains(&x.elem_alias, &Box::get(p).segs[0]),
            _                    : return false,
        }
    }
    false
}

// `&x` in a decided program, `p` its place: a whole plain local that shared
// borrows alone pinned (`resolve_pinned`'s `ws`), so it has no object and
// every check on it is proven (`unchecked`); the borrow is its address.
export fn whole_plain_borrow(ref<Gen, shared> g, ref<Mode, shared> mode, ref<Expr, shared> inner, ref<P, shared> p) : bool
{
    bool shared = match (mode)
    {
        Mode::Shared    : true,
        Mode::Exclusive : false,
    };
    bool whole_name = match (&inner.kind)
    {
        ExprKind::EPath(ip) : Vec::len(&Box::get(ip).segs) == 1,
        _                   : false,
    };
    g.decided && shared && p.is_binding && Vec::len(&p.projs) == 0 && Option::is_none(&p.base) && Option::is_none(&p.raw) && !is_never(
        &p.ty,
    ) && whole_name
}

// D-0286: `e` builds an aggregate itself (a struct literal, or a variant),
// which `objectless` makes with no object.
export fn literal_expr(ref<Gen, shared> g, ref<Fx, shared> x, ref<Expr, shared> e) : bool
{
    match (&strip_parens(e).kind)
    {
        ExprKind::EStructLit(_) : true,
        ExprKind::EPath(p)      :
        {
            ref<Vec<String>, shared> segs = &Box::get(p).segs;
            if (Vec::len(segs) == 1 && is_bound(x, &segs[0]))
            {
                return false;
            }
            Option::is_some(&variant_of(g, segs))
        },
        ExprKind::ECall(c)      :
        {
            match (&Box::get(c).callee.kind)
            {
                ExprKind::EPath(p) :
                {
                    ref<Vec<String>, shared> segs = &Box::get(p).segs;
                    if (Vec::len(segs) == 1 && is_bound(x, &segs[0]))
                    {
                        return false;
                    }
                    if (HashMap::contains(&g.prog.table.fns, &String::join(segs, "::")))
                    {
                        return false;
                    }
                    Option::is_some(&variant_of(g, segs))
                },
                _                  : false,
            }
        },
        _                       : false,
    }
}

// D-0294: `e` is `Box::new(…)`, `std`'s (`lower_box_new`).
export fn box_new_expr(ref<Gen, shared> g, ref<Fx, shared> x, ref<Expr, shared> e) : bool
{
    ref<CallExpr, shared> c = match (&strip_parens(e).kind)
    {
        ExprKind::ECall(c) : Box::get(c),
        _                  : return false,
    };
    ref<Vec<String>, shared> segs = match (&c.callee.kind)
    {
        ExprKind::EPath(p) : &Box::get(p).segs,
        _                  : return false,
    };
    if (Vec::len(&c.args) != 1 || (Vec::len(segs) == 1 && is_bound(x, &segs[0])))
    {
        return false;
    }
    String k0 = String::join(segs, "::");
    String k = if (HashMap::contains(&g.prog.table.fns, &k0)) { k0 } else { sprintf("std::%s", &k0) };
    if (k != "std::Box::new")
    {
        return false;
    }
    match (HashMap::get(&g.prog.table.fns, &k))
    {
        Some(f) : in_prelude(&k, f),
        None    : false,
    }
}

// D-0286: `e` is `x.f…` for an objectless local `x`.
// D-0315 (step 4): `e` is `x.f[i].g…` for an objectless local `x`, through
// fields and indexes.
export fn objectless_root_through(ref<Fx, shared> x, ref<Expr, shared> e) : bool
{
    ref<Expr, shared> r = strip_parens(e);
    while (true)
    {
        match (&r.kind)
        {
            ExprKind::EField(f) : r = strip_parens(&Box::get(f).e),
            ExprKind::EIndex(i) : r = strip_parens(&Box::get(i).a),
            _                   : break,
        }
    }
    match (path_name(r))
    {
        Some(n) :
        {
            match (lookup_ref(x, &n))
            {
                Some(b) :
                {
                    bool local = match (&b.kind)
                    {
                        BindKind::Local : true,
                        _               : false,
                    };
                    local && HashSet::contains(&x.objectless_c, &b.c)
                },
                None    : false,
            }
        },
        None    : false,
    }
}

export fn objectless_root(ref<Fx, shared> x, ref<Expr, shared> e) : bool
{
    ref<Expr, shared> r = strip_parens(e);
    while (true)
    {
        match (&r.kind)
        {
            ExprKind::EField(f) : r = strip_parens(&Box::get(f).e),
            _                   : break,
        }
    }
    match (path_name(r))
    {
        Some(n) :
        {
            match (lookup_ref(x, &n))
            {
                Some(b) :
                {
                    bool local = match (&b.kind)
                    {
                        BindKind::Local : true,
                        _               : false,
                    };
                    local && HashSet::contains(&x.objectless_c, &b.c)
                },
                None    : false,
            }
        },
        None    : false,
    }
}

// A call's resource result `t` arrives: received from flight; in a decided
// program, given an object where it lands. The object's name.
export fn take_result(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> t,
    ref<Type, shared> ty,
    usize line,
) : String
{
    String o = fresh(g, "o");
    if (g.decided)
    {
        u32 tid = type_id(g, ty);
        String lc = loc(g, x.std_body, line);
        em_decl_rt3(x, "uint64_t", &o, RT_NEW, &sprintf("&%s", t), &sprintf("%vu", tid), &lc);
    }
    else
    {
        em_decl_rt1(x, "uint64_t", &o, RT_RECV, &sprintf("&%s", t));
    }
    o
}

// A resource parameter's C name and its type's id (`ground_native_nodes`'s `tids`).
export struct ParamTid
{
    export String name;
    export u32 tid;
}

// `s` with its bytes `i..j` replaced by `to`.
export fn splice(ref<String, shared> s, usize i, usize j, StringView to) : String
{
    StringView v = s;
    String out = String::copy(&v[0..i]);
    String::append(&mut out, to);
    String::append(&mut out, &v[j..$]);
    out
}

export fn find_from(ref<String, shared> s, usize at, StringView needle) : Option<usize>
{
    StringView v = s;
    match (StringView::find(&v[at..$], needle))
    {
        Some(k) : Some(at + k),
        None    : None,
    }
}

export fn ident_name(StringView name) : bool
{
    if (StringView::len(name) == 0)
    {
        return false;
    }
    foreach (c in StringView::as_bytes(name))
    {
        if (!(ascii_is_alnum(*c) || *c == b'_'))
        {
            return false;
        }
    }
    true
}

// The statement `st` (`call(x…`) stands at `i`, the position of its `x`.
export fn stmt_at(ref<String, shared> s, usize i, ref<String, shared> st) : bool
{
    usize k = match (StringView::find(st, "("))
    {
        Some(k) : k + 1,
        None    : 0,
    };
    if (i < k)
    {
        return false;
    }
    StringView v = s;
    StringView::starts_with(&v[i - k..$], st)
}

// The positions of `x` as a whole identifier in `s`.
export fn ident_positions(ref<String, shared> s, ref<String, shared> x) : Vec<usize>
{
    slice<u8, shared> b = StringView::as_bytes(s);
    usize n = slice_len(b);
    usize xn = StringView::len(x);
    Vec<usize> out = Vec::new();
    usize at = 0;
    while (true)
    {
        usize i = match (find_from(s, at, x))
        {
            Some(i) : i,
            None    : break,
        };
        usize j = i + xn;
        bool before = i == 0 || !(ascii_is_alnum(b[i - 1]) || b[i - 1] == b'_');
        bool after = j >= n || !(ascii_is_alnum(b[j]) || b[j] == b'_');
        if (before && after)
        {
            Vec::push(&mut out, i);
        }
        at = j;
    }
    out
}

// One line for `tidy` (with or without its indentation): `None` when it is
// only empty statements, else the line with each run of them as one.
export fn tidy_line(StringView body) : Option<String>
{
    StringView t = StringView::trim(body);
    if (StringView::len(t) > 0)
    {
        bool empty_stmt = true;
        foreach (c in StringView::as_bytes(t))
        {
            if (*c != b';' && *c != b' ')
            {
                empty_stmt = false;
            }
        }
        if (empty_stmt)
        {
            return None;
        }
    }
    String l = String::copy(body);
    while (StringView::contains(&l, "; ;"))
    {
        l = StringView::replace(&l, "; ;", ";");
    }
    while (StringView::contains(&l, ";;") && !StringView::contains(&l, "for ("))
    {
        l = StringView::replace(&l, ";;", ";");
    }
    Some(l)
}
