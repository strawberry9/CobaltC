// The object cache, as impl/cobc/src/cache.rs keeps it: pure-`std`
// functions compiled once, kept, and linked into every later program that
// uses them.
//
// A program's C (`Generated`) comes in units, one per lowered function. A
// unit is cacheable when it is a `std` function instantiated at `std` types
// alone: its text is then the same in every program, so its object code is
// too. Each such unit is compiled in a translation unit of its own -- the
// runtime's header, the declarations it refers to (closed over the structs'
// fields), and the unit -- and the object is kept under a key that hashes
// that text with the C compiler, its options, the runtime's stamp and this
// compiler. What is not cacheable is one translation unit compiled every
// time; everything is linked together.
//
// `COBC_CACHE=off` disables the cache (one translation unit); `COBC_CACHE=<dir>`
// names its directory; by default it is `cobc-cache` beside the executable.

import std;
import state;
import passes;
import gen;
import build_info;
import driverbase;
import target;

export struct Inputs
{
    export String cc;
    export String opt;
    export Option<String> arch;
    // `-g`: debug information in every object.
    export bool debug;
    export String cache_dir;
    export String work_dir;
    // What cobc asks of the C compiler once (`cc_flags`, `cc_identity`).
    export CcFacts facts;
}

export struct Built
{
    export Vec<String> objects;
    export usize compiled;
    export usize reused;
}

// The cache directory, or None when the cache is off. `bootstrap_form` is
// cobc's `lower::bootstrap_form()`: a D-0274 stage switched off.
export fn dir(bool bootstrap_form) : Option<String>
{
    // D-0274: the bootstrap form is one translation unit.
    if (bootstrap_form)
    {
        return None;
    }
    match (env_var("COBC_CACHE"))
    {
        Ok(Some(v)) :
        {
            if (v == "off" || v == "0" || String::len(&v) == 0)
            {
                return None;
            }
            Some(v)
        },
        _ : match (exe_dir())
        {
            Ok(d)  : Some(pjoin(String::as_view(&d), "cobc-cache")),
            Err(_) : None,
        },
    }
}

export fn cc_flags_base() : Vec<String>
{
    Vec<String> v = Vec::new();
    foreach (f in ["-std=gnu11", "-ffp-contract=off", "-fno-optimize-sibling-calls", "-w"])
    {
        Vec::push(&mut v, String::from_str(f));
    }
    v
}

// What cobc asks the C compiler once per run (`OnceLock`): its identity and
// the flags it is given.
export struct CcFacts
{
    export String identity;
    export Vec<String> flags;
}

// `cc_identity` and `cc_flags`: `CC_FLAGS`, and `-fno-optimize-crc` where
// `cc` accepts it. GCC 15 added a pass (on from -O2) that replaces a
// bit-at-a-time CRC loop with a table or carry-less multiply; GCC 16.1 gets
// the loop wrong in the form cobc writes it. GCC before 15 and Clang refuse
// the flag.
export fn cc_facts(StringView cc) : CcFacts
{
    String identity = cc_identity(cc);
    bool off = false;
    if (!String::contains(&identity, "clang"))
    {
        Cmd c = Cmd::new(cc);
        foreach (a in ["-fno-optimize-crc", "-fsyntax-only", "-x", "c", "-"])
        {
            Cmd::arg(&mut c, StringView::of(a));
        }
        off = match (Cmd::output(&c))
        {
            Ok(o)  : o.status == 0,
            Err(_) : false,
        };
    }
    Vec<String> v = cc_flags_base();
    if (off)
    {
        Vec::push(&mut v, String::from_str("-fno-optimize-crc"));
    }
    CcFacts { .identity = identity, .flags = v }
}

// The C compiler's identity for the key: the first line of `cc --version`.
fn cc_identity(StringView cc) : String
{
    Cmd c = Cmd::new(cc);
    Cmd::arg(&mut c, "--version");
    String text = match (Cmd::output(&c))
    {
        Ok(o)  : lossy(&o.stdout[0..$]),
        Err(_) : String::new(),
    };
    Vec<StringView> lines = String::lines(&text);
    StringView first = if (Vec::len(&lines) > 0) { lines[0] } else { StringView::of("") };
    sprintf("%v %v", cc, first)
}

// This compiler's identity: its executable's size and modification time (a
// rebuilt compiler may lower differently), and the runtime's stamp.
fn cobc_identity() : String
{
    match (current_exe())
    {
        Ok(e)  :
        {
            match (file_info(String::as_view(&e)))
            {
                Ok(m)  :
                {
                    i64 t = if (m.modified_unix < 0) { 0 } else { m.modified_unix };
                    return sprintf("%v:%v:%v", m.len, t, CBRT_STAMP);
                },
                Err(_) : {},
            }
        },
        Err(_) : {},
    }
    String::from_str(CBRT_STAMP)
}

fn fnv1a64(u64 seed, StringView bytes) : u64
{
    u64 h = seed;
    foreach (b in StringView::as_bytes(bytes))
    {
        h = wrapping_mul(h ^ widen<u64>(*b), 0x0000_0100_0000_01b3);
    }
    h
}

fn hex16(u64 v) : String
{
    str digits = "0123456789abcdef";
    String s = String::new();
    for (u32 i = 0; i < 16; i += 1)
    {
        u64 d = (v >> (60 - 4 * i)) & 15;
        String::push_ascii(&mut s, StringView::as_bytes(StringView::of(digits))[narrow<usize>(d)]);
    }
    s
}

fn ident_start(u8 c) : bool
{
    c == b'_' || (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z')
}

fn ident_byte(u8 c) : bool
{
    ident_start(c) || (c >= b'0' && c <= b'9')
}

// Every C identifier in `text`.
export fn identifiers(StringView text) : HashSet<String>
{
    HashSet<String> out = HashSet::new();
    slice<u8, shared> b = StringView::as_bytes(text);
    usize n = StringView::len(text);
    usize i = 0;
    while (i < n)
    {
        if (ident_start(b[i]))
        {
            usize start = i;
            while (i < n && ident_byte(b[i]))
            {
                i += 1;
            }
            HashSet::insert(&mut out, String::from_view(StringView::sub(text, start, i)));
        }
        else
        {
            i += 1;
        }
    }
    out
}

struct NameLine
{
    String name;
    String line;
}

// The declarations of a program's C, by name.
struct Decls
{
    // Struct name, its forward declaration line.
    Vec<NameLine> fwd;
    // Struct name, its definition (with its static asserts).
    Vec<NameLine> type_blocks;
    // Each block's text hash, for the key.
    Vec<u64> type_hashes;
    HashMap<String, usize> type_index;
    // The blocks each block mentions.
    Vec<Vec<usize>> type_refs;
    // Literal name, its definition line.
    HashMap<String, String> strings;
    // Function name, its prototype line.
    Vec<NameLine> protos;
    // Thunk name, a prototype made from its definition.
    HashMap<String, String> thunk_protos;
}

// A function definition's first line: at the start of a line, not a
// declaration, and followed by the line `{`.
export fn is_definition(StringView line, Option<StringView> next) : bool
{
    bool brace = match (next)
    {
        Some(n) : StringView::eq_str(n, "{"),
        None    : false,
    };
    if (!brace || StringView::len(line) == 0)
    {
        return false;
    }
    u8 c = StringView::as_bytes(line)[0];
    c != b' ' && c != b'{' && c != b'}' && c != b'#' && StringView::ends_with(
        line,
        ")",
    ) && !StringView::starts_with(line, "static ")
}

export fn name_before_paren(StringView line) : Option<StringView>
{
    usize open = match (StringView::find(line, "("))
    {
        Some(k) : k,
        None    : return None,
    };
    StringView head = StringView::sub(line, 0, open);
    usize end = StringView::len(StringView::trim_end(head));
    slice<u8, shared> hb = StringView::as_bytes(head);
    usize start = end;
    while (start > 0 && ident_byte(hb[start - 1]))
    {
        start -= 1;
    }
    if (start == end) { None } else { Some(StringView::sub(head, start, end)) }
}

fn sorted_usize(ref<Vec<usize>, exclusive> v)
{
    Vec::sort(v);
}

fn decls(ref<Generated, shared> gen) : Decls
{
    Vec<NameLine> fwd = Vec::new();
    {
        Vec<StringView> lines = String::lines(&gen.fwd);
        foreach (l in &lines)
        {
            match (StringView::strip_prefix(*l, "struct "))
            {
                Some(rest) :
                {
                    match (StringView::strip_suffix(rest, ";"))
                    {
                        Some(name) : Vec::push(&mut fwd, NameLine {
                            .name = String::from_view(StringView::trim(name)),
                            .line = String::from_view(*l),
                        }),
                        None : {},
                    }
                },
                None       : {},
            }
        }
    }
    Vec<NameLine> type_blocks = Vec::new();
    {
        Vec<StringView> lines = String::lines(&gen.types);
        foreach (l in &lines)
        {
            match (StringView::strip_prefix(*l, "struct "))
            {
                Some(rest) :
                {
                    if (StringView::contains(*l, "{"))
                    {
                        slice<u8, shared> rb = StringView::as_bytes(rest);
                        usize e = 0;
                        while (e < StringView::len(rest) && rb[e] != b' ' && rb[e] != b'{')
                        {
                            e += 1;
                        }
                        Vec::push(&mut type_blocks, NameLine {
                            .name = String::from_view(StringView::sub(rest, 0, e)),
                            .line = sprintf("%v\n", *l),
                        });
                        continue;
                    }
                },
                None       : {},
            }
            usize nb = Vec::len(&type_blocks);
            if (nb > 0 && StringView::len(StringView::trim(*l)) > 0)
            {
                String::append(&mut type_blocks[nb - 1].line, *l);
                String::push_ascii(&mut type_blocks[nb - 1].line, b'\n');
            }
        }
    }
    HashMap<String, usize> type_index = HashMap::new();
    for (usize i = 0; i < Vec::len(&type_blocks); i += 1)
    {
        HashMap::insert(&mut type_index, String::clone(&type_blocks[i].name), i);
    }
    // The blocks each struct definition mentions (its fields' structs).
    Vec<Vec<usize>> type_refs = Vec::new();
    foreach (tb in &type_blocks)
    {
        HashSet<String> ids = identifiers(String::as_view(&tb.line));
        Vec<usize> v = Vec::new();
        for (usize k = 0; k < HashMap::len(&type_index); k += 1)
        {
            if (HashSet::contains(&ids, HashMap::key_at(&type_index, k)))
            {
                Vec::push(&mut v, *HashMap::value_at(&type_index, k));
            }
        }
        sorted_usize(&mut v);
        Vec::push(&mut type_refs, v);
    }
    HashMap<String, String> strings = HashMap::new();
    {
        Vec<StringView> lines = String::lines(&gen.strings);
        foreach (l in &lines)
        {
            match (StringView::strip_prefix(*l, "static const uint8_t "))
            {
                Some(rest) :
                {
                    match (StringView::find(rest, "["))
                    {
                        Some(e) :
                        {
                            _ = HashMap::insert(
                                &mut strings,
                                String::from_view(StringView::sub(rest, 0, e)),
                                String::from_view(*l),
                            );
                        },
                        None    : {},
                    }
                },
                None       : {},
            }
        }
    }
    Vec<NameLine> protos = Vec::new();
    {
        Vec<StringView> lines = String::lines(&gen.protos);
        foreach (l in &lines)
        {
            match (name_before_paren(*l))
            {
                Some(name) : Vec::push(
                    &mut protos,
                    NameLine { .name = String::from_view(name), .line = String::from_view(*l) },
                ),
                None : {},
            }
        }
    }
    Vec<u64> type_hashes = Vec::new();
    foreach (tb in &type_blocks)
    {
        Vec::push(&mut type_hashes, fnv1a64(0xcbf2_9ce4_8422_2325, String::as_view(&tb.line)));
    }
    HashMap<String, String> thunk_protos = HashMap::new();
    {
        Vec<StringView> lines = String::lines(&gen.thunks);
        foreach (l in &lines)
        {
            bool lead = false;
            if (StringView::len(*l) > 0)
            {
                u8 c = StringView::as_bytes(*l)[0];
                lead = c == b' ' || c == b'{' || c == b'}';
            }
            if (!lead && StringView::ends_with(*l, ")") && StringView::contains(*l, "("))
            {
                match (name_before_paren(*l))
                {
                    Some(name) :
                    {
                        _ = HashMap::insert(&mut thunk_protos, String::from_view(name), sprintf("%v;", *l));
                    },
                    None       : {},
                }
            }
        }
    }
    Decls {
        .fwd = fwd,
        .type_blocks = type_blocks,
        .type_hashes = type_hashes,
        .type_index = type_index,
        .type_refs = type_refs,
        .strings = strings,
        .protos = protos,
        .thunk_protos = thunk_protos,
    }
}

// What a unit's translation unit is made of: the struct blocks (closed over
// their fields), and the names of the literals, prototypes and thunk
// prototypes it mentions. The key is a hash over these parts' texts, so the
// text itself is assembled only for a unit that must be compiled.
struct Needs
{
    Vec<usize> types;
    HashSet<String> names;
}

fn needs(ref<Decls, shared> d, StringView unit) : Needs
{
    HashSet<String> ids = identifiers(unit);
    Vec<usize> want = Vec::new();
    HashSet<usize> seen = HashSet::new();
    Vec<usize> stack = Vec::new();
    for (usize k = 0; k < HashMap::len(&d.type_index); k += 1)
    {
        if (HashSet::contains(&ids, HashMap::key_at(&d.type_index, k)))
        {
            Vec::push(&mut stack, *HashMap::value_at(&d.type_index, k));
        }
    }
    while (true)
    {
        usize i = match (Vec::pop(&mut stack))
        {
            Some(i) : i,
            None    : break,
        };
        if (!HashSet::insert(&mut seen, i))
        {
            continue;
        }
        Vec::push(&mut want, i);
        foreach (j in &d.type_refs[i])
        {
            Vec::push(&mut stack, *j);
        }
    }
    sorted_usize(&mut want);
    Needs { .types = want, .names = ids }
}

fn wanted_names(ref<Decls, shared> d, ref<Needs, shared> n) : HashSet<String>
{
    HashSet<String> w = HashSet::new();
    foreach (i in &n.types)
    {
        HashSet::insert(&mut w, String::clone(&d.type_blocks[*i].name));
    }
    w
}

fn sort_strings(ref<Vec<String>, exclusive> v)
{
    Vec::sort(v);
}

fn key_for(ref<Decls, shared> d, StringView unit, ref<Needs, shared> n, StringView salt) : String
{
    // Everything the key takes from the program's declarations is sorted
    // first: the program reaches types and functions in an order of its
    // own, and a key that followed that order named one unit twice.
    u64 h = fnv1a64(0xcbf2_9ce4_8422_2325, salt);
    h = fnv1a64(h, unit);
    Vec<u64> types = Vec::new();
    foreach (i in &n.types)
    {
        Vec::push(&mut types, d.type_hashes[*i]);
    }
    Vec::sort(&mut types);
    foreach (t in &types)
    {
        h = fnv1a64(h ^ *t, "t");
    }
    HashSet<String> wanted = wanted_names(d, n);
    Vec<String> fwd = Vec::new();
    foreach (f in &d.fwd)
    {
        if (HashSet::contains(&wanted, &f.name) || HashSet::contains(&n.names, &f.name))
        {
            Vec::push(&mut fwd, String::clone(&f.line));
        }
    }
    sort_strings(&mut fwd);
    foreach (l in &fwd)
    {
        h = fnv1a64(h, String::as_view(l));
    }
    Vec<String> lits = Vec::new();
    for (usize k = 0; k < HashMap::len(&d.strings); k += 1)
    {
        if (HashSet::contains(&n.names, HashMap::key_at(&d.strings, k)))
        {
            Vec::push(&mut lits, String::clone(HashMap::value_at(&d.strings, k)));
        }
    }
    sort_strings(&mut lits);
    foreach (l in &lits)
    {
        h = fnv1a64(h, String::as_view(l));
    }
    Vec<String> protos = Vec::new();
    foreach (p in &d.protos)
    {
        if (HashSet::contains(&n.names, &p.name))
        {
            Vec::push(&mut protos, String::clone(&p.line));
        }
    }
    sort_strings(&mut protos);
    foreach (l in &protos)
    {
        h = fnv1a64(h, String::as_view(l));
    }
    Vec<String> thunks = Vec::new();
    for (usize k = 0; k < HashMap::len(&d.thunk_protos); k += 1)
    {
        if (HashSet::contains(&n.names, HashMap::key_at(&d.thunk_protos, k)))
        {
            Vec::push(&mut thunks, String::clone(HashMap::value_at(&d.thunk_protos, k)));
        }
    }
    sort_strings(&mut thunks);
    foreach (t in &thunks)
    {
        h = fnv1a64(h, String::as_view(t));
    }
    // A second, independent hash of the unit alone widens the key.
    u64 g2 = fnv1a64(0x9E37_79B9_7F4A_7C15, unit);
    sprintf("%s%s", &hex16(h), &hex16(g2 ^ fnv1a64(0x1234_5678_9abc_def0, salt)))
}

struct NamedLit
{
    String name;
    String line;
}

// The translation unit of one cacheable unit: the runtime's header, what
// the unit refers to, and the unit.
fn translation_unit(ref<Decls, shared> d, StringView unit, ref<Needs, shared> n) : String
{
    ref<HashSet<String>, shared> ids = &n.names;
    HashSet<String> wanted = wanted_names(d, n);
    String out = String::new();
    String::reserve(&mut out, StringView::len(unit) + 8192);
    String::append(&mut out, generated_header());
    String::append(&mut out, "\n/* ---- types ---- */\n");
    foreach (f in &d.fwd)
    {
        if (HashSet::contains(&wanted, &f.name) || HashSet::contains(ids, &f.name))
        {
            String::append(&mut out, &f.line);
            String::push_ascii(&mut out, b'\n');
        }
    }
    foreach (i in &n.types)
    {
        String::append(&mut out, &d.type_blocks[*i].line);
    }
    String::append(&mut out, "\n/* ---- string literals ---- */\n");
    // Sorted by name (and line): `(&str, &str)` pairs, as cobc sorts them.
    Vec<String> lits = Vec::new();
    for (usize k = 0; k < HashMap::len(&d.strings); k += 1)
    {
        if (HashSet::contains(ids, HashMap::key_at(&d.strings, k)))
        {
            Vec::push(
                &mut lits,
                sprintf("%s\u{0}%s", HashMap::key_at(&d.strings, k), HashMap::value_at(&d.strings, k)),
            );
        }
    }
    sort_strings(&mut lits);
    foreach (l in &lits)
    {
        StringView v = String::as_view(l);
        usize z = Option::expect(StringView::find(v, "\u{0}"), "a name and a line");
        String::append(&mut out, StringView::sub(v, z + 1, StringView::len(v)));
        String::push_ascii(&mut out, b'\n');
    }
    String::append(&mut out, "\n/* ---- functions ---- */\n");
    foreach (p in &d.protos)
    {
        if (HashSet::contains(ids, &p.name))
        {
            String::append(&mut out, &p.line);
            String::push_ascii(&mut out, b'\n');
        }
    }
    Vec<String> thunks = Vec::new();
    for (usize k = 0; k < HashMap::len(&d.thunk_protos); k += 1)
    {
        if (HashSet::contains(ids, HashMap::key_at(&d.thunk_protos, k)))
        {
            Vec::push(&mut thunks, String::clone(HashMap::value_at(&d.thunk_protos, k)));
        }
    }
    sort_strings(&mut thunks);
    foreach (p in &thunks)
    {
        String::append(&mut out, p);
        String::push_ascii(&mut out, b'\n');
    }
    String::push_ascii(&mut out, b'\n');
    String::append(&mut out, unit);
    out
}

// The longest cached function, in lines, that the program's translation
// unit also gets an inline-only copy of (`inline_copies`).
const usize INLINE_LINES = 50;

struct Def
{
    String name;
    String text;
}

// The function definitions of a cacheable unit, each its name and text, or
// None if the unit holds anything else at file scope.
fn definitions(StringView text) : Option<Vec<Def>>
{
    Vec<StringView> lines = StringView::split(text, "\n");
    Vec<Def> out = Vec::new();
    usize offset = 0;
    usize i = 0;
    while (i < Vec::len(&lines))
    {
        StringView l = lines[i];
        if (StringView::len(l) == 0)
        {
            offset += 1;
            i += 1;
            continue;
        }
        Option<StringView> next = if (i + 1 < Vec::len(&lines)) { Some(lines[i + 1]) } else { None };
        if (!is_definition(l, next))
        {
            return None;
        }
        usize start = offset;
        StringView name = match (name_before_paren(l))
        {
            Some(nm) : nm,
            None     : return None,
        };
        // The body ends at the first `}` at the start of a line.
        usize j = i + 1;
        while (j < Vec::len(&lines) && !StringView::eq_str(lines[j], "}"))
        {
            j += 1;
        }
        if (j == Vec::len(&lines))
        {
            return None;
        }
        for (usize k = i; k <= j; k += 1)
        {
            offset += StringView::len(lines[k]) + 1;
        }
        usize end = if (offset < StringView::len(text)) { offset } else { StringView::len(text) };
        Vec::push(
            &mut out,
            Def { .name = String::from_view(name), .text = String::from_view(StringView::sub(text, start, end)) },
        );
        i = j + 1;
    }
    Some(out)
}

fn line_count(ref<String, shared> s) : usize
{
    Vec::len(&String::lines(s))
}

// Inline-only copies of the small cached functions the program's own code
// calls (and those such a copy calls): each definition made
// `extern inline __attribute__((gnu_inline))`, which the C compiler may
// inline but never emits, so a call it does not inline still goes to the
// cached object.
fn inline_copies(ref<Generated, shared> gen) : String
{
    Vec<Def> small = Vec::new();
    foreach (u in &gen.units)
    {
        if (!u.cacheable)
        {
            continue;
        }
        match (definitions(String::as_view(&u.text)))
        {
            Some(defs) :
            {
                foreach (d in &defs)
                {
                    if (line_count(&d.text) <= INLINE_LINES && !hands_runtime_an_address(String::as_view(&d.text)))
                    {
                        Vec::push(&mut small, clone(d));
                    }
                }
            },
            None       : {},
        }
    }
    HashSet<String> wanted = HashSet::new();
    foreach (u in &gen.units)
    {
        if (!u.cacheable)
        {
            add_all(&mut wanted, identifiers(String::as_view(&u.text)));
        }
    }
    add_all(&mut wanted, identifiers(String::as_view(&gen.thunks)));
    add_all(&mut wanted, identifiers(String::as_view(&gen.descs)));
    add_all(&mut wanted, identifiers(String::as_view(&gen.tail)));
    Vec<bool> taken = Vec::filled(Vec::len(&small), false);
    while (true)
    {
        bool more = false;
        for (usize k = 0; k < Vec::len(&small); k += 1)
        {
            if (!taken[k] && HashSet::contains(&wanted, &small[k].name))
            {
                taken[k] = true;
                more = true;
                add_all(&mut wanted, identifiers(String::as_view(&small[k].text)));
            }
        }
        if (!more)
        {
            break;
        }
    }
    String out = String::new();
    for (usize k = 0; k < Vec::len(&small); k += 1)
    {
        if (taken[k])
        {
            String::append(&mut out, "extern inline __attribute__((gnu_inline)) ");
            String::append(&mut out, &small[k].text);
            String::push_ascii(&mut out, b'\n');
        }
    }
    out
}

fn add_all(ref<HashSet<String>, exclusive> into, HashSet<String> from)
{
    for (usize k = 0; k < HashSet::len(&from); k += 1)
    {
        HashSet::insert(into, String::clone(HashSet::key_at(&from, k)));
    }
}

// Whether a function hands the runtime an address (`cb_new(&r, …)`): the
// runtime keys objects and reference slots by address, and once gcc
// inlined such a copy it reused the dead locals' stack slots. Such a
// function stays a call into its cached object.
fn hands_runtime_an_address(StringView text) : bool
{
    Vec<StringView> lines = StringView::lines(text);
    foreach (line in &lines)
    {
        StringView s = *line;
        while (true)
        {
            usize i = match (StringView::find(s, "cb_"))
            {
                Some(k) : k,
                None    : break,
            };
            StringView rest = StringView::sub(s, i + 3, StringView::len(s));
            slice<u8, shared> rb = StringView::as_bytes(rest);
            usize name = 0;
            while (name < StringView::len(rest) && ident_byte(rb[name]))
            {
                name += 1;
            }
            StringView after = StringView::sub(rest, name, StringView::len(rest));
            if (StringView::starts_with(after, "("))
            {
                StringView call = match (StringView::find(after, ";"))
                {
                    Some(k) : StringView::sub(after, 0, k),
                    None    : after,
                };
                if (StringView::contains(call, "&"))
                {
                    return true;
                }
            }
            s = after;
        }
    }
    false
}

// The program's own translation unit: everything that is not cached.
fn program_unit(ref<Generated, shared> gen) : String
{
    String out = String::new();
    String::append(&mut out, generated_header());
    String::append(&mut out, "\n/* ---- types ---- */\n");
    String::append(&mut out, &gen.fwd);
    String::append(&mut out, &gen.types);
    String::append(&mut out, "\n/* ---- string literals ---- */\n");
    String::append(&mut out, &gen.strings);
    String::append(&mut out, "\n/* ---- functions ---- */\n");
    String::append(&mut out, &gen.protos);
    String::append(&mut out, "\n/* ---- call thunks for fn values ---- */\n");
    String::append(&mut out, &gen.thunks);
    String::append(&mut out, "\n/* ---- type descriptors ---- */\n");
    String::append(&mut out, &gen.descs);
    // After the thunks: a copy may call a `cb_eq_…` function, which has no
    // prototype of its own.
    String::append(&mut out, "\n/* ---- inline-only copies of cached std functions ---- */\n");
    String::append(&mut out, &inline_copies(gen));
    foreach (u in &gen.units)
    {
        if (!u.cacheable)
        {
            String::append(&mut out, &u.text);
        }
    }
    String::append(&mut out, &gen.tail);
    out
}

export fn compile_one(ref<Inputs, shared> inp, StringView c_path, StringView obj) : Result<void, String>
{
    Cmd cmd = Cmd::new(String::as_view(&inp.cc));
    foreach (f in &inp.facts.flags)
    {
        Cmd::arg(&mut cmd, String::as_view(f));
    }
    Cmd::arg(&mut cmd, String::as_view(&inp.opt));
    match (&inp.arch)
    {
        Some(a) : Cmd::arg(&mut cmd, String::as_view(a)),
        None    : {},
    }
    if (inp.debug)
    {
        Cmd::arg(&mut cmd, "-g");
    }
    Cmd::arg(&mut cmd, "-c");
    Cmd::arg(&mut cmd, "-o");
    Cmd::arg(&mut cmd, obj);
    Cmd::arg(&mut cmd, c_path);
    show(&cmd);
    Output out = match (Cmd::output(&cmd))
    {
        Ok(o)  : o,
        Err(e) : return Err(sprintf("cannot run the C compiler `%s`: %v", &inp.cc, io_text(&e))),
    };
    if (out.status != 0)
    {
        return Err(sprintf("%s%s failed on %v (kept for inspection)", &lossy(&out.stderr[0..$]), &inp.cc, c_path));
    }
    Ok(())
}

// Puts the whole object `tmp` under its final name `obj`, never over one
// already there: another compiler may have placed the same object (the key
// names its text, so the two are alike) and be linking it at this moment.
// cobc makes a hard link, which fails where the name exists, so the first
// to arrive wins; std has no hard links, so cbc takes cobc's fallback for a
// file system without them: a rename to a name still missing, and a copy as
// the last resort.
fn place(StringView tmp, StringView obj)
{
    if (!is_file(obj))
    {
        if (!is_file(obj) && Result::is_ok(&rename(tmp, obj)))
        {
            return;
        }
        if (!is_file(obj))
        {
            match (read_bytes(tmp))
            {
                Ok(bytes) :
                {
                    _ = write_bytes(obj, &bytes[0..$]);
                },
                Err(_)    : {},
            }
        }
    }
    _ = remove_file(tmp);
}

// One compilation of `build`: a C file, its object, whether the object is
// a cached one.
struct Job
{
    String c_path;
    String obj;
    bool cached;
}

// A worker of `build`: takes the next job until none is left.
fn worker(
    ref<Inputs, shared> inp,
    ref<Vec<Job>, shared> jobs,
    ref<Atomic<usize>, shared> next,
    ref<mutex<Vec<String>>, shared> errors,
) : u8
{
    while (true)
    {
        usize i = Atomic::fetch_add(next, 1);
        if (i >= Vec::len(jobs))
        {
            break;
        }
        ref<Job, shared> j = &jobs[i];
        // A cached object is compiled beside its final name, under a name of
        // this process's own, and renamed into place only when whole, so a
        // reader never sees a partial object.
        // (`KEY.o` -> `KEY.o.PID-I.tmp`, cobc's `with_extension`.)
        String tmp = if (j.cached) { sprintf("%s.%v-%v.tmp", &j.obj, process_id(), i) } else { String::clone(&j.obj) };
        match (compile_one(inp, String::as_view(&j.c_path), String::as_view(&tmp)))
        {
            Ok(_)  :
            {
                if (j.cached)
                {
                    place(String::as_view(&tmp), String::as_view(&j.obj));
                }
            },
            Err(e) :
            {
                if (j.cached)
                {
                    _ = remove_file(String::as_view(&tmp));
                }
                auto g = lock(errors);
                Vec::push(&mut *g, e);
            },
        }
    }
    0
}

// Compiles the program: cacheable units from the cache or into it (the
// missing ones in parallel), the rest as one unit; gives the objects to link.
export fn build(ref<Generated, shared> gen, ref<Inputs, shared> inp, bool bootstrap_form) : Result<Built, String>
{
    match (make_dir_all(String::as_view(&inp.cache_dir)))
    {
        Ok(_)  : {},
        Err(e) : return Err(sprintf("cannot create the object cache %s: %v", &inp.cache_dir, io_text(&e))),
    }
    Decls d = decls(gen);
    bool all_checks = env_flag("COBALTC_ALL_CHECKS");
    String salt = sprintf(
        "%s\n%s\n%s\n%s\n%s\n%v%v",
        &inp.facts.identity,
        &inp.opt,
        &Option::unwrap_or(clone(&inp.arch), String::new()),
        &String::join(&inp.facts.flags[0..$], " "),
        &cobc_identity(),
        if (bootstrap_form) { "bootstrap" } else if (all_checks) { "all-checks" } else { "" },
        if (inp.debug) { "\n-g" } else { "" },
    );
    Vec<String> objects = Vec::new();
    // (C file to write and compile, object)
    Vec<Job> todo = Vec::new();
    Vec<String> texts = Vec::new();
    usize reused = 0;
    foreach (u in &gen.units)
    {
        if (!u.cacheable)
        {
            continue;
        }
        Needs n = needs(&d, String::as_view(&u.text));
        String key = key_for(&d, String::as_view(&u.text), &n, String::as_view(&salt));
        String obj = pjoin(String::as_view(&inp.cache_dir), String::as_view(&sprintf("%s.o", &key)));
        if (is_file(String::as_view(&obj)))
        {
            reused += 1;
        }
        else
        {
            String c_path = pjoin(String::as_view(&inp.work_dir), String::as_view(&sprintf("%s.c", &key)));
            Vec::push(&mut todo, Job { .c_path = c_path, .obj = String::clone(&obj), .cached = true });
            Vec::push(&mut texts, translation_unit(&d, String::as_view(&u.text), &n));
        }
        Vec::push(&mut objects, obj);
    }
    String prog_c = pjoin(String::as_view(&inp.work_dir), "program.c");
    String prog_o = pjoin(String::as_view(&inp.work_dir), "program.o");
    match (write_file(
        String::as_view(&prog_c),
        String::as_view(&settle_lines(&program_unit(gen), String::as_view(&prog_c))),
    ))
    {
        Ok(_)  : {},
        Err(e) : return Err(sprintf("cannot write %s: %v", &prog_c, io_text(&e))),
    }
    for (usize k = 0; k < Vec::len(&todo); k += 1)
    {
        match (write_file(String::as_view(&todo[k].c_path), String::as_view(&texts[k])))
        {
            Ok(_)  : {},
            Err(e) : return Err(sprintf("cannot write %s: %v", &todo[k].c_path, io_text(&e))),
        }
    }
    // The program's unit and the missing cached units, compiled in parallel,
    // as many at a time as there are processors.
    Vec<Job> jobs = Vec::new();
    Vec::push(&mut jobs, Job { .c_path = String::clone(&prog_c), .obj = String::clone(&prog_o), .cached = false });
    foreach (t in &todo)
    {
        Vec::push(&mut jobs, clone(t));
    }
    usize threads = cpu_count();
    if (threads < 1)
    {
        threads = 1;
    }
    if (threads > Vec::len(&jobs))
    {
        threads = Vec::len(&jobs);
    }
    Atomic<usize> next = Atomic::new(0: usize);
    mutex<Vec<String>> errors = Mutex::new(Vec::new());
    {
        Vec<handle<u8>> hs = Vec::new();
        for (usize t = 0; t < threads; t += 1)
        {
            Vec::push(&mut hs, spawn(worker, inp, &jobs, &next, &errors));
        }
        while (true)
        {
            match (Vec::pop(&mut hs))
            {
                Some(h) :
                {
                    _ = join(h);
                },
                None    : break,
            }
        }
    }
    {
        auto g = lock(&errors);
        if (Vec::len(&*g) > 0)
        {
            return Err(String::clone(&(*g)[0]));
        }
    }
    usize compiled = Vec::len(&todo);
    Vec<String> all = Vec::new();
    Vec::push(&mut all, prog_o);
    Vec::append(&mut all, objects);
    Ok(Built { .objects = all, .compiled = compiled, .reused = reused })
}
