// The platform functions cbc's driver needs and `std` does not offer, in
// impl/selfhost/cbc/host.c (Linux and Windows): whether a stream is a
// terminal (cobc: `std::io::IsTerminal`), the console's ANSI mode
// (`diagnostics::enable_ansi`), standard input gathered by a thread nothing
// waits for (`explore_runs`' reader), and a started program's guard
// (`child_guard`, `job_guard`).

import std;

extern "./host.c";

unsafe extern fn cbc_host_isatty(i64 fd) : i64;
unsafe extern fn cbc_host_enable_ansi() : i64;
unsafe extern fn cbc_host_stdout_closed() : i64;
unsafe extern fn cbc_host_input_start();
unsafe extern fn cbc_host_input_wait(u64 have, u64 ms) : u64;
unsafe extern fn cbc_host_input_byte(u64 i) : i64;
unsafe extern fn cbc_host_guard(u64 pid, i64 secs) : u64;
unsafe extern fn cbc_host_unguard(u64 h);

// Whether the stream `fd` (0, 1 or 2) is a terminal.
// trusted: [Extern-Call] cbc_host_isatty reads no memory of the program.
export fn is_terminal(i64 fd) : bool
{
    unsafe
    {
        cbc_host_isatty(fd) != 0
    }
}

// trusted: [Extern-Call] cbc_host_enable_ansi reads no memory of the program.
export fn enable_ansi() : bool
{
    unsafe
    {
        cbc_host_enable_ansi() != 0
    }
}

// Whether standard output is a pipe nobody reads any more (Linux; never
// known elsewhere), where cobc's `print!` fails and it ends with status 1.
// trusted: [Extern-Call] cbc_host_stdout_closed reads no memory of the program.
export fn stdout_closed() : bool
{
    unsafe
    {
        cbc_host_stdout_closed() != 0
    }
}

// Starts gathering standard input as it arrives (once); a terminal's is
// taken as ended at once.
// trusted: [Extern-Call] cbc_host_input_start reads no memory of the program.
export fn input_start()
{
    unsafe
    {
        cbc_host_input_start();
    }
}

// What has arrived of standard input: its length, and whether it has ended.
export struct InputState
{
    export usize len;
    export bool ended;
}

// Waits up to `ms` milliseconds for more than `have` bytes, or the end.
// trusted: [Extern-Call] cbc_host_input_wait reads no memory of the program.
export fn input_wait(usize have, u64 ms) : InputState
{
    u64 r = unsafe
    {
        cbc_host_input_wait(widen<u64>(have), ms)
    };
    u64 top = 1: u64 << 63;
    InputState { .len = narrow<usize>(r & (top - 1)), .ended = (r & top) != 0 }
}

// The input's bytes `[from, to)`, all arrived (`input_wait`).
// trusted: [Extern-Call] cbc_host_input_byte reads no memory of the program.
export fn input_bytes(usize from, usize to) : Vec<u8>
{
    Vec<u8> out = Vec::new();
    for (usize i = from; i < to; i += 1)
    {
        i64 b = unsafe
        {
            cbc_host_input_byte(widen<u64>(i))
        };
        if (b < 0)
        {
            break;
        }
        Vec::push(&mut out, narrow<u8>(b));
    }
    out
}

// cobc's `child_guard` and `job_guard` for a started program `pid` (std has
// no hook between fork and exec): its CPU time limited to `secs` when set
// (Linux), or a job that ends it when cbc ends, with that much processor
// time if set (Windows). The guard to release, or 0.
// trusted: [Extern-Call] cbc_host_guard reads no memory of the program.
export fn guard_child(u64 pid, Option<i64> secs) : u64
{
    i64 s = match (secs)
    {
        Some(v) : v,
        None    : -1,
    };
    unsafe
    {
        cbc_host_guard(pid, s)
    }
}

// trusted: [Extern-Call] cbc_host_unguard reads no memory of the program.
export fn unguard_child(u64 h)
{
    unsafe
    {
        cbc_host_unguard(h);
    }
}
