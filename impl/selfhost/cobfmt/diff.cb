// A unified diff of two texts, by lines (for `--diff`), as
// impl/cobfmt/src/diff.rs gives it: the longest common subsequence, then
// hunks with three lines of context.

import std;

// The lines as Rust's `str::lines` gives them: split at `\n`, a `\r`
// before it dropped, no empty line after a final `\n`.
fn lines_of(StringView t) : Vec<StringView>
{
    Vec<StringView> out = Vec::new();
    slice<u8, shared> b = StringView::as_bytes(t);
    usize n = StringView::len(t);
    usize start = 0;
    for (usize i = 0; i < n; i += 1)
    {
        if (b[i] == b'\n')
        {
            usize end = if (i > start && b[i - 1] == b'\r') { i - 1 } else { i };
            Vec::push(&mut out, StringView::sub(t, start, end));
            start = i + 1;
        }
    }
    if (start < n)
    {
        usize end = if (b[n - 1] == b'\r') { n - 1 } else { n };
        Vec::push(&mut out, StringView::sub(t, start, end));
    }
    out
}

// One step of the edit script: `' '` kept, `'-'` removed, `'+'` added,
// at line `i` of the first text and `j` of the second.
struct Op
{
    u8 kind;
    usize i;
    usize j;
}

export fn unified(StringView a, StringView b, StringView name) : String
{
    Vec<StringView> x = lines_of(a);
    Vec<StringView> y = lines_of(b);
    usize n = Vec::len(&x);
    usize m = Vec::len(&y);
    // lcs[i * (m + 1) + j]: the common length of x[i..] and y[j..].
    usize w = m + 1;
    Vec<u32> lcs = Vec::filled((n + 1) * w, 0);
    usize i = n;
    while (i > 0)
    {
        i -= 1;
        usize j = m;
        while (j > 0)
        {
            j -= 1;
            lcs[i * w + j] = if (StringView::eq(x[i], y[j]))
            {
                lcs[(i + 1) * w + j + 1] + 1
            }
            else if (lcs[(i + 1) * w + j] >= lcs[i * w + j + 1])
            {
                lcs[(i + 1) * w + j]
            }
            else
            {
                lcs[i * w + j + 1]
            };
        }
    }
    Vec<Op> ops = Vec::new();
    usize p = 0;
    usize q = 0;
    while (p < n || q < m)
    {
        if (p < n && q < m && StringView::eq(x[p], y[q]))
        {
            Vec::push(&mut ops, Op { .kind = b' ', .i = p, .j = q });
            p += 1;
            q += 1;
        }
        else if (q < m && (p == n || lcs[p * w + q + 1] >= lcs[(p + 1) * w + q]))
        {
            Vec::push(&mut ops, Op { .kind = b'+', .i = p, .j = q });
            q += 1;
        }
        else
        {
            Vec::push(&mut ops, Op { .kind = b'-', .i = p, .j = q });
            p += 1;
        }
    }
    String out = sprintf("--- %v\n+++ %v (formatted)\n", name, name);
    usize ctx = 3;
    usize no = Vec::len(&ops);
    usize k = 0;
    while (k < no)
    {
        if (ops[k].kind == b' ')
        {
            k += 1;
            continue;
        }
        // A hunk: from `ctx` lines before this change to `ctx` after the
        // last change within reach.
        usize start = if (k > ctx) { k - ctx } else { 0 };
        usize end = k;
        usize last_change = k;
        while (end < no)
        {
            if (ops[end].kind != b' ')
            {
                last_change = end;
            }
            else if (end - last_change > 2 * ctx)
            {
                break;
            }
            end += 1;
        }
        end = if (last_change + ctx + 1 < no) { last_change + ctx + 1 } else { no };
        usize a_len = 0;
        usize b_len = 0;
        for (usize o = start; o < end; o += 1)
        {
            if (ops[o].kind != b'+')
            {
                a_len += 1;
            }
            if (ops[o].kind != b'-')
            {
                b_len += 1;
            }
        }
        String::appendf(&mut out, "@@ -%v,%v +%v,%v @@\n", ops[start].i + 1, a_len, ops[start].j + 1, b_len);
        for (usize o = start; o < end; o += 1)
        {
            Op op = ops[o];
            String::push_ascii(&mut out, op.kind);
            String::append(&mut out, if (op.kind == b'+') { y[op.j] } else { x[op.i] });
            String::push_ascii(&mut out, b'\n');
        }
        k = end;
    }
    out
}
