// What a text literal the type checker typed as `String` is
// (D-0149, D-0162, D-0312 `[Coerce-Text]`): `String::copy_str(L)`. The
// checker's other rewrites are typecheck.cb's `rw_expr`, as
// impl/src/views.rs's `rewrite_literals_as_string` does them.

import std;
import ast;

// `L` as `std::String::copy_str(L)`.
export fn wrap_owned(ref<Expr, exclusive> e)
{
    usize line = e.line;
    usize col = e.col;
    ExprKind lit = replace(&mut e.kind, ExprKind::EUnit);
    Vec<String> segs = Vec::new();
    Vec::push(&mut segs, "std");
    Vec::push(&mut segs, "String");
    Vec::push(&mut segs, "copy_str");
    Expr callee = mk(ExprKind::EPath(Box::new(PathExpr { .segs = segs, .targs = Vec::new() })), line, col);
    Vec<Expr> args = Vec::new();
    Vec::push(&mut args, mk(lit, line, col));
    e.kind = ExprKind::ECall(Box::new(CallExpr { .callee = callee, .args = args }));
}
