// The abstract syntax of CobaltC, as coby's parser builds it
// (impl/src/ast.rs), node for node. A CobaltC variant carries one
// payload, so a Rust variant with several parts carries a struct of them,
// boxed where the type is recursive. Every value here is `clone` by
// derivation (D-0116), as the parser needs (`p op= e` writes `p` twice).

import std;

export enum Mode
{
    Shared,
    Exclusive,
}

export enum IntTy
{
    I8,
    I16,
    I32,
    I64,
    I128,
    U8,
    U16,
    U32,
    U64,
    U128,
    Isize,
    Usize,
}

export enum Type
{
    TInt(IntTy),
    TF32,
    TF64,
    TBool,
    TStr,
    TVoid,
    TNever,
    TRef(Box<ModedTy>),
    TSlice(Box<ModedTy>),
    TRawptr(Box<Type>),
    TArray(Box<SizedTy>),
    TSimd(Box<SizedTy>),
    TFn(Box<FnTy>),
    THandle(Box<Type>),
    TMutex(Box<Type>),
    TGuard(Box<Type>),
    TNamed(Box<NamedTy>),
    TClosure(u64),
}

export struct ModedTy
{
    export Type inner;
    export Mode mode;
}

export struct SizedTy
{
    export Type inner;
    export u128 n;
}

export struct FnTy
{
    export Vec<Type> params;
    export Type ret;
}

export struct NamedTy
{
    export String name;
    export Vec<Type> args;
}

export enum Bound
{
    BEq,
    BOrdered,
    BNumber,
    BInteger,
    BClone,
    BPlain,
}

export struct ParamDecl
{
    export Type ty;
    export String name;
}

export struct FieldDecl
{
    export bool export_;
    export Type ty;
    export String name;
    export Option<u32> width;
}

export struct VariantDecl
{
    export String name;
    export Option<Type> payload;
}

export struct FnDecl
{
    export bool export_;
    export Option<String> assoc_type;
    export String name;
    export Vec<String> type_params;
    export Vec<Option<Bound>> type_bounds;
    export Vec<ParamDecl> params;
    export Type ret;
    export Block body;
    export usize line;
    export bool is_const;
    export bool auto_type;
    export bool derived;
    export bool c_entry;
}

export struct ExternDecl
{
    export bool export_;
    export String name;
    export Vec<ParamDecl> params;
    export Type ret;
    export usize line;
}

export struct StaticDecl
{
    export bool export_;
    export String name;
    export Type ty;
    export Expr init;
    export usize line;
}

export struct StructDecl
{
    export bool export_;
    export bool resource_;
    export String name;
    export Vec<String> type_params;
    export Vec<FieldDecl> fields;
    export usize line;
    export Option<IntTy> bits;
    export Option<u64> align;
}

export struct EnumDecl
{
    export bool export_;
    export bool resource_;
    export String name;
    export Vec<String> type_params;
    export Vec<VariantDecl> variants;
    export usize line;
}

export struct ModuleItem
{
    export bool export_;
    export String name;
    export Vec<Item> items;
    export usize line;
}

export struct ImportItem
{
    export bool export_;
    export String path;
    export usize line;
}

export struct ExternCodeItem
{
    export String code;
    export usize line;
}

export enum Item
{
    IFn(Box<FnDecl>),
    IExtern(Box<ExternDecl>),
    IStatic(Box<StaticDecl>),
    IStruct(Box<StructDecl>),
    IEnum(Box<EnumDecl>),
    IModule(Box<ModuleItem>),
    IImport(Box<ImportItem>),
    IExternCode(Box<ExternCodeItem>),
}

export struct Block
{
    export Vec<Stmt> stmts;
    export Option<Box<Expr>> tail;
}

export struct LetStmt
{
    export Option<Type> ty;
    export String name;
    export Option<Expr> init;
    export usize line;
    export usize col;
}

export struct DestructureStmt
{
    export String struct_name;
    export Vec<String> fields;
    export Vec<String> names;
    export bool rest;
    export Expr init;
}

export enum Stmt
{
    SLet(Box<LetStmt>),
    SDestructure(Box<DestructureStmt>),
    SExpr(Box<Expr>),
    SBlockLike(Box<Expr>),
}

export struct Arm
{
    export Option<String> variant;
    export Vec<String> nested;
    export Option<String> binder;
    export Option<Box<Expr>> lit;
    export Box<Expr> body;
}

export enum UnOp
{
    Neg,
    Not,
    BitNot,
}

export enum BinOp
{
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    Shl,
    Shr,
    BitAnd,
    BitOr,
    BitXor,
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
    And,
    Or,
}

export struct IntLit
{
    export u128 v;
    export Option<String> sfx;
}

export struct FloatLit
{
    export f64 v;
    export Option<String> sfx;
}

export struct PathExpr
{
    export Vec<String> segs;
    export Vec<Type> targs;
}

export struct FieldInit
{
    export String name;
    export Expr value;
}

export struct StructLitExpr
{
    export Vec<String> segs;
    export Vec<Type> targs;
    export Vec<FieldInit> fields;
}

export struct RepeatExpr
{
    export Expr value;
    export u128 n;
}

export struct UnaryExpr
{
    export UnOp op;
    export Expr e;
}

export struct BinaryExpr
{
    export BinOp op;
    export Expr a;
    export Expr b;
}

export struct BorrowExpr
{
    export Mode mode;
    export Expr e;
}

export struct SliceExpr
{
    export Mode mode;
    export Expr base;
    export Expr lo;
    export Expr hi;
}

export struct FieldExpr
{
    export Expr e;
    export String name;
}

export struct PairExpr
{
    export Expr a;
    export Expr b;
}

export struct CallExpr
{
    export Expr callee;
    export Vec<Expr> args;
}

export struct IfExpr
{
    export Expr cond;
    export Block then_;
    export Option<Expr> else_;
}

export struct WhileExpr
{
    export Expr cond;
    export Block body;
    export Option<Expr> step;
}

export struct MatchExpr
{
    export Expr scrut;
    export Vec<Arm> arms;
}

export struct ClosureExpr
{
    export bool is_move;
    export Vec<String> captures;
    export Vec<ParamDecl> params;
    export Option<Type> ret;
    export Block body;
}

export enum ExprKind
{
    EInt(Box<IntLit>),
    EFloat(Box<FloatLit>),
    EStr(String),
    EBool(bool),
    EUnit,
    EPath(Box<PathExpr>),
    EStructLit(Box<StructLitExpr>),
    EArrayLit(Vec<Expr>),
    EArrayRepeat(Box<RepeatExpr>),
    EUnary(Box<UnaryExpr>),
    EBinary(Box<BinaryExpr>),
    EBorrow(Box<BorrowExpr>),
    ESliceOf(Box<SliceExpr>),
    EDollar,
    EDeref(Box<Expr>),
    EField(Box<FieldExpr>),
    EIndex(Box<PairExpr>),
    ECall(Box<CallExpr>),
    EAssign(Box<PairExpr>),
    EPropagate(Box<Expr>),
    EBlock(Block),
    EUnsafe(Block),
    EIf(Box<IfExpr>),
    EWhile(Box<WhileExpr>),
    EMatch(Box<MatchExpr>),
    EReturn(Option<Box<Expr>>),
    EBreak,
    EContinue,
    EClosure(Box<ClosureExpr>),
    EParen(Box<Expr>),
}

export struct Expr
{
    export ExprKind kind;
    export usize line;
    export usize col;
    // The node's identity for the facts the type checker records (coby
    // keys them by the node's address): 0 until `items::number` gives
    // every expression of the program its own.
    export usize id;
}

export struct UnitTest
{
    export Vec<String> module_;
    export String fn_name;
    export Option<String> name;
    export usize line;
}

export struct Program
{
    export Vec<Item> items;
    export Vec<UnitTest> tests;
}

// ---- small helpers ----

export fn mk(ExprKind kind, usize line, usize col) : Expr
{
    Expr { .kind = kind, .line = line, .col = col, .id = 0 }
}

export fn path1(StringView name, usize line, usize col) : Expr
{
    Vec<String> segs = Vec::new();
    Vec::push(&mut segs, String::from_view(name));
    mk(ExprKind::EPath(Box::new(PathExpr { .segs = segs, .targs = Vec::new() })), line, col)
}

export fn int_lit(u128 v, usize line, usize col) : Expr
{
    mk(ExprKind::EInt(Box::new(IntLit { .v = v, .sfx = None })), line, col)
}

export fn binary(BinOp op, Expr a, Expr b, usize line, usize col) : Expr
{
    mk(ExprKind::EBinary(Box::new(BinaryExpr { .op = op, .a = a, .b = b })), line, col)
}

export fn assign(Expr a, Expr b, usize line, usize col) : Expr
{
    mk(ExprKind::EAssign(Box::new(PairExpr { .a = a, .b = b })), line, col)
}

export fn call(StringView f, Vec<Expr> args, usize line, usize col) : Expr
{
    mk(ExprKind::ECall(Box::new(CallExpr { .callee = path1(f, line, col), .args = args })), line, col)
}

export fn let_stmt(Option<Type> ty, StringView name, Option<Expr> init, usize line, usize col) : Stmt
{
    Stmt::SLet(Box::new(LetStmt { .ty = ty, .name = String::from_view(name), .init = init, .line = line, .col = col }))
}

export fn block_of(Vec<Stmt> stmts, Option<Expr> tail) : Block
{
    match (tail)
    {
        Some(t) : Block { .stmts = stmts, .tail = Some(Box::new(t)) },
        None    : Block { .stmts = stmts, .tail = None },
    }
}

export fn int_ty_name(IntTy t) : str
{
    match (t)
    {
        IntTy::I8    : "i8",
        IntTy::I16   : "i16",
        IntTy::I32   : "i32",
        IntTy::I64   : "i64",
        IntTy::I128  : "i128",
        IntTy::U8    : "u8",
        IntTy::U16   : "u16",
        IntTy::U32   : "u32",
        IntTy::U64   : "u64",
        IntTy::U128  : "u128",
        IntTy::Isize : "isize",
        IntTy::Usize : "usize",
    }
}

export fn int_ty_from(StringView s) : Option<IntTy>
{
    match (s)
    {
        "i8"    : Some(IntTy::I8),
        "i16"   : Some(IntTy::I16),
        "i32"   : Some(IntTy::I32),
        "i64"   : Some(IntTy::I64),
        "i128"  : Some(IntTy::I128),
        "u8"    : Some(IntTy::U8),
        "u16"   : Some(IntTy::U16),
        "u32"   : Some(IntTy::U32),
        "u64"   : Some(IntTy::U64),
        "u128"  : Some(IntTy::U128),
        "isize" : Some(IntTy::Isize),
        "usize" : Some(IntTy::Usize),
        _       : None,
    }
}

export fn int_ty_signed(IntTy t) : bool
{
    t == IntTy::I8 || t == IntTy::I16 || t == IntTy::I32 || t == IntTy::I64 || t == IntTy::I128 || t == IntTy::Isize
}

// The width in bits, a pointer's being `addr` bits.
export fn int_ty_bits(IntTy t, u32 addr) : u32
{
    match (t)
    {
        IntTy::I8    : 8,
        IntTy::U8    : 8,
        IntTy::I16   : 16,
        IntTy::U16   : 16,
        IntTy::I32   : 32,
        IntTy::U32   : 32,
        IntTy::I64   : 64,
        IntTy::U64   : 64,
        IntTy::I128  : 128,
        IntTy::U128  : 128,
        IntTy::Isize : addr,
        IntTy::Usize : addr,
    }
}

export fn bound_from(StringView s) : Option<Bound>
{
    match (s)
    {
        "eq"      : Some(Bound::BEq),
        "ordered" : Some(Bound::BOrdered),
        "number"  : Some(Bound::BNumber),
        "integer" : Some(Bound::BInteger),
        "clone"   : Some(Bound::BClone),
        "plain"   : Some(Bound::BPlain),
        _         : None,
    }
}

export fn bound_name(Bound b) : str
{
    match (b)
    {
        Bound::BEq      : "eq",
        Bound::BOrdered : "ordered",
        Bound::BNumber  : "number",
        Bound::BInteger : "integer",
        Bound::BClone   : "clone",
        Bound::BPlain   : "plain",
    }
}

fn mode_word(Mode m) : str
{
    if (m == Mode::Shared) { "shared" } else { "exclusive" }
}

// A type as messages show it (`Type`'s `Display`): `std::` and a local
// type's `$k` left out of a name.
export fn type_display(ref<Type, shared> t) : String
{
    String o = String::new();
    type_write(&mut o, t);
    o
}

fn type_list(ref<String, exclusive> o, ref<Vec<Type>, shared> ts)
{
    for (usize i = 0; i < Vec::len(ts); i += 1)
    {
        if (i > 0)
        {
            String::append(o, ", ");
        }
        type_write(o, &ts[i]);
    }
}

fn type_write(ref<String, exclusive> o, ref<Type, shared> t)
{
    match (t)
    {
        Type::TInt(i)     : String::append(o, int_ty_name(*i)),
        Type::TF32        : String::append(o, "f32"),
        Type::TF64        : String::append(o, "f64"),
        Type::TBool       : String::append(o, "bool"),
        Type::TStr        : String::append(o, "str"),
        Type::TVoid       : String::append(o, "void"),
        Type::TNever      : String::append(o, "never"),
        Type::TRef(m)     :
        {
            ref<ModedTy, shared> x = Box::get(m);
            String::append(o, "ref<");
            type_write(o, &x.inner);
            String::appendf(o, ", %s>", mode_word(x.mode));
        },
        Type::TSlice(m)   :
        {
            ref<ModedTy, shared> x = Box::get(m);
            String::append(o, "slice<");
            type_write(o, &x.inner);
            String::appendf(o, ", %s>", mode_word(x.mode));
        },
        Type::TRawptr(x)  :
        {
            String::append(o, "rawptr<");
            type_write(o, Box::get(x));
            String::append(o, ">");
        },
        Type::TArray(s)   :
        {
            ref<SizedTy, shared> x = Box::get(s);
            String::append(o, "array<");
            type_write(o, &x.inner);
            String::appendf(o, ", %v>", x.n);
        },
        Type::TSimd(s)    :
        {
            ref<SizedTy, shared> x = Box::get(s);
            String::append(o, "simd<");
            type_write(o, &x.inner);
            String::appendf(o, ", %v>", x.n);
        },
        Type::TFn(f)      :
        {
            ref<FnTy, shared> x = Box::get(f);
            String::append(o, "fn(");
            type_list(o, &x.params);
            String::append(o, ") : ");
            type_write(o, &x.ret);
        },
        Type::THandle(x)  :
        {
            String::append(o, "handle<");
            type_write(o, Box::get(x));
            String::append(o, ">");
        },
        Type::TMutex(x)   :
        {
            String::append(o, "mutex<");
            type_write(o, Box::get(x));
            String::append(o, ">");
        },
        Type::TGuard(x)   :
        {
            String::append(o, "guard<");
            type_write(o, Box::get(x));
            String::append(o, ">");
        },
        Type::TNamed(n)   :
        {
            ref<NamedTy, shared> x = Box::get(n);
            StringView name = String::as_view(&x.name);
            name = Option::unwrap_or(StringView::strip_prefix(name, "std::"), name);
            match (StringView::find(name, "$"))
            {
                Some(k) : name = StringView::sub(name, 0, k),
                None    : {},
            }
            String::append(o, name);
            if (Vec::len(&x.args) > 0)
            {
                String::append(o, "<");
                type_list(o, &x.args);
                String::append(o, ">");
            }
        },
        Type::TClosure(_) : String::append(o, "closure"),
    }
}

export fn named(StringView name, Vec<Type> args) : Type
{
    Type::TNamed(Box::new(NamedTy { .name = String::from_view(name), .args = args }))
}

// A literal expression, which takes its type from its context (D-0037,
// `ast.rs`): an unsuffixed (or `byte`) literal, and the arithmetic and
// bitwise operators over such.
export fn is_literal_expr(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EInt(b)    :
        {
            match (&Box::get(b).sfx)
            {
                Some(s) : *s == "byte",
                None    : true,
            }
        },
        ExprKind::EFloat(b)  : Option::is_none(&Box::get(b).sfx),
        ExprKind::EParen(x)  : is_literal_expr(Box::get(x)),
        ExprKind::EUnary(b)  :
        {
            ref<UnaryExpr, shared> x = Box::get(b);
            (x.op == UnOp::Neg || x.op == UnOp::BitNot) && is_literal_expr(&x.e)
        },
        ExprKind::EBinary(b) :
        {
            ref<BinaryExpr, shared> x = Box::get(b);
            BinOp o = x.op;
            if (o == BinOp::Add || o == BinOp::Sub || o == BinOp::Mul || o == BinOp::Div || o == BinOp::Rem || o == BinOp::BitAnd || o == BinOp::BitOr || o == BinOp::BitXor)
            {
                return is_literal_expr(&x.a) && is_literal_expr(&x.b);
            }
            if (o == BinOp::Shl || o == BinOp::Shr)
            {
                return is_literal_expr(&x.a);
            }
            false
        },
        _                    : false,
    }
}

fn types_eq(ref<Vec<Type>, shared> a, ref<Vec<Type>, shared> b) : bool
{
    if (Vec::len(a) != Vec::len(b))
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(a); i += 1)
    {
        if (!type_eq(&a[i], &b[i]))
        {
            return false;
        }
    }
    true
}

// `ast.rs`'s `Type == Type`: the same type, written the same way.
export fn type_eq(ref<Type, shared> a, ref<Type, shared> b) : bool
{
    match (a)
    {
        Type::TInt(x) : match (b)
        {
            Type::TInt(y) : *x == *y,
            _             : false,
        },
        Type::TF32 : match (b)
        {
            Type::TF32 : true,
            _          : false,
        },
        Type::TF64 : match (b)
        {
            Type::TF64 : true,
            _          : false,
        },
        Type::TBool : match (b)
        {
            Type::TBool : true,
            _           : false,
        },
        Type::TStr : match (b)
        {
            Type::TStr : true,
            _          : false,
        },
        Type::TVoid : match (b)
        {
            Type::TVoid : true,
            _           : false,
        },
        Type::TNever : match (b)
        {
            Type::TNever : true,
            _            : false,
        },
        Type::TRef(x) : match (b)
        {
            Type::TRef(y) : Box::get(x).mode == Box::get(y).mode && type_eq(&Box::get(x).inner, &Box::get(y).inner),
            _             : false,
        },
        Type::TSlice(x) : match (b)
        {
            Type::TSlice(y) : Box::get(x).mode == Box::get(y).mode && type_eq(&Box::get(x).inner, &Box::get(y).inner),
            _               : false,
        },
        Type::TRawptr(x) : match (b)
        {
            Type::TRawptr(y) : type_eq(Box::get(x), Box::get(y)),
            _                : false,
        },
        Type::TArray(x) : match (b)
        {
            Type::TArray(y) : Box::get(x).n == Box::get(y).n && type_eq(&Box::get(x).inner, &Box::get(y).inner),
            _               : false,
        },
        Type::TSimd(x) : match (b)
        {
            Type::TSimd(y) : Box::get(x).n == Box::get(y).n && type_eq(&Box::get(x).inner, &Box::get(y).inner),
            _              : false,
        },
        Type::TFn(x) : match (b)
        {
            Type::TFn(y) : types_eq(
                &Box::get(x).params,
                &Box::get(y).params,
            ) && type_eq(&Box::get(x).ret, &Box::get(y).ret),
            _ : false,
        },
        Type::THandle(x) : match (b)
        {
            Type::THandle(y) : type_eq(Box::get(x), Box::get(y)),
            _                : false,
        },
        Type::TMutex(x) : match (b)
        {
            Type::TMutex(y) : type_eq(Box::get(x), Box::get(y)),
            _               : false,
        },
        Type::TGuard(x) : match (b)
        {
            Type::TGuard(y) : type_eq(Box::get(x), Box::get(y)),
            _               : false,
        },
        Type::TNamed(x) : match (b)
        {
            Type::TNamed(y) : String::eq(
                &Box::get(x).name,
                &Box::get(y).name,
            ) && types_eq(&Box::get(x).args, &Box::get(y).args),
            _ : false,
        },
        Type::TClosure(x) : match (b)
        {
            Type::TClosure(y) : *x == *y,
            _                 : false,
        },
    }
}

// `Type::qualified`: as `type_display`, except that a named type keeps its
// module (`std::Vec<i64>`), for two types that show alike (CHG-0333).
export fn type_qualified(ref<Type, shared> t) : String
{
    match (t)
    {
        Type::TNamed(b)  :
        {
            ref<NamedTy, shared> x = Box::get(b);
            StringView name = String::as_view(&x.name);
            match (StringView::find(name, "$"))
            {
                Some(k) : name = StringView::sub(name, 0, k),
                None    : {},
            }
            String o = String::from_view(name);
            if (Vec::len(&x.args) > 0)
            {
                String::append(&mut o, "<");
                for (usize i = 0; i < Vec::len(&x.args); i += 1)
                {
                    if (i > 0)
                    {
                        String::append(&mut o, ", ");
                    }
                    String::append(&mut o, &type_qualified(&x.args[i]));
                }
                String::append(&mut o, ">");
            }
            o
        },
        Type::TRef(b)    : sprintf("ref<%s, %s>", &type_qualified(&Box::get(b).inner), mode_word(Box::get(b).mode)),
        Type::TSlice(b)  : sprintf("slice<%s, %s>", &type_qualified(&Box::get(b).inner), mode_word(Box::get(b).mode)),
        Type::TRawptr(b) : sprintf("rawptr<%s>", &type_qualified(Box::get(b))),
        Type::TArray(b)  : sprintf("array<%s, %v>", &type_qualified(&Box::get(b).inner), Box::get(b).n),
        Type::THandle(b) : sprintf("handle<%s>", &type_qualified(Box::get(b))),
        Type::TMutex(b)  : sprintf("mutex<%s>", &type_qualified(Box::get(b))),
        Type::TGuard(b)  : sprintf("guard<%s>", &type_qualified(Box::get(b))),
        _                : type_display(t),
    }
}

export struct ShownPair
{
    export String a;
    export String b;
}

// `Type::shown_apart`: two types for one message, as `type_display` shows
// them, unless they show alike while being different types.
export fn shown_apart(ref<Type, shared> a, ref<Type, shared> b) : ShownPair
{
    String sa = type_display(a);
    String sb = type_display(b);
    if (String::eq(&sa, &sb) && !type_eq(a, b))
    {
        return ShownPair { .a = type_qualified(a), .b = type_qualified(b) };
    }
    ShownPair { .a = sa, .b = sb }
}

// A type as an exact key: two types have one code exactly when
// `type_eq` holds (`HashSet<(String, Vec<Type>)>` keys).
export fn type_code(ref<Type, shared> t) : String
{
    String o = String::new();
    code_write(&mut o, t);
    o
}

fn code_write(ref<String, exclusive> o, ref<Type, shared> t)
{
    match (t)
    {
        Type::TInt(i)     : String::append(o, int_ty_name(*i)),
        Type::TF32        : String::append(o, "f32"),
        Type::TF64        : String::append(o, "f64"),
        Type::TBool       : String::append(o, "bool"),
        Type::TStr        : String::append(o, "str"),
        Type::TVoid       : String::append(o, "void"),
        Type::TNever      : String::append(o, "never"),
        Type::TRef(b)     :
        {
            String::appendf(o, "&%s(", mode_word(Box::get(b).mode));
            code_write(o, &Box::get(b).inner);
            String::append(o, ")");
        },
        Type::TSlice(b)   :
        {
            String::appendf(o, "[%s(", mode_word(Box::get(b).mode));
            code_write(o, &Box::get(b).inner);
            String::append(o, ")");
        },
        Type::TRawptr(b)  :
        {
            String::append(o, "*(");
            code_write(o, Box::get(b));
            String::append(o, ")");
        },
        Type::TArray(b)   :
        {
            String::appendf(o, "a%v(", Box::get(b).n);
            code_write(o, &Box::get(b).inner);
            String::append(o, ")");
        },
        Type::TSimd(b)    :
        {
            String::appendf(o, "v%v(", Box::get(b).n);
            code_write(o, &Box::get(b).inner);
            String::append(o, ")");
        },
        Type::TFn(b)      :
        {
            String::append(o, "fn(");
            ref<FnTy, shared> f = Box::get(b);
            for (usize i = 0; i < Vec::len(&f.params); i += 1)
            {
                code_write(o, &f.params[i]);
                String::append(o, ",");
            }
            String::append(o, ")");
            code_write(o, &f.ret);
        },
        Type::THandle(b)  :
        {
            String::append(o, "h(");
            code_write(o, Box::get(b));
            String::append(o, ")");
        },
        Type::TMutex(b)   :
        {
            String::append(o, "m(");
            code_write(o, Box::get(b));
            String::append(o, ")");
        },
        Type::TGuard(b)   :
        {
            String::append(o, "g(");
            code_write(o, Box::get(b));
            String::append(o, ")");
        },
        Type::TNamed(b)   :
        {
            ref<NamedTy, shared> x = Box::get(b);
            String::appendf(o, "n%v:%s(", String::len(&x.name), &x.name);
            for (usize i = 0; i < Vec::len(&x.args); i += 1)
            {
                code_write(o, &x.args[i]);
                String::append(o, ",");
            }
            String::append(o, ")");
        },
        Type::TClosure(k) : String::appendf(o, "c%v", *k),
    }
}

// The codes of a list of types, one key.
export fn types_code(ref<Vec<Type>, shared> ts) : String
{
    String o = String::new();
    for (usize i = 0; i < Vec::len(ts); i += 1)
    {
        code_write(&mut o, &ts[i]);
        String::append(&mut o, ";");
    }
    o
}
