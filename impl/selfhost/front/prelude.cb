    "\n                return Err(Oversize);\n            }\n            Vec::extend_from(out, &data[r.at..r"
    ".at + len]);\n            r.at += len;\n        }\n        else if (kind == 1)\n        {\n            in"
    "flate_codes(&mut r, out, &fixed_lit, &fixed_dist, max)?;\n        }\n        else if (kind == 2)\n     "
    "   {\n            Option<Huffman> lit = None;\n            Option<Huffman> dist = None;\n            re"
    "ad_dynamic(&mut r, &mut lit, &mut dist)?;\n            inflate_codes(&mut r, out, &Option::unwrap(lit"
    "), &Option::unwrap(dist), max)?;\n        }\n        else\n        {\n            return Err(Corrupt(r.a"
    "t));\n        }\n        if (last == 1)\n        {\n            // The bits left in the reader's buffer "
    "belong to no block; the\n            // position after the block is the next whole byte.\n            "
    "return Ok(r.at);\n        }\n    }\n}export fn inflate(slice<u8, shared> data, usize max) : Result<Vec<"
    "u8>, CompressError>\n{\n    Vec<u8> out = Vec::new();\n    inflate_from(data, 0, &mut out, max)?;\n    O"
    "k(out)\n}fn BitWriter::put(ref<BitWriter, exclusive> w, u32 value, u32 n)\n{\n    w.bits = w.bits | (wi"
    "den<u64>(value) << w.count);\n    w.count += n;\n    while (w.count >= 8)\n    {\n        Vec::push(&mut"
    " w.out, narrow_wrapping<u8>(w.bits));\n        w.bits = w.bits >> 8;\n        w.count -= 8;\n    }\n}fn "
    "BitWriter::put_code(ref<BitWriter, exclusive> w, u32 code, u32 len)\n{\n    u32 rev = 0;\n    for (u32 "
    "i = 0; i < len; i += 1)\n    {\n        rev = (rev << 1) | ((code >> i) & 1);\n    }\n    BitWriter::put"
    "(w, rev, len);\n}fn BitWriter::flush(ref<BitWriter, exclusive> w)\n{\n    if (w.count > 0)\n    {\n      "
    "  Vec::push(&mut w.out, narrow_wrapping<u8>(w.bits));\n        w.bits = 0;\n        w.count = 0;\n    }"
    "\n}fn code_lengths(slice<u32, shared> freq, usize limit) : Vec<u8>\n{\n    usize n = slice_len(freq);\n "
    "   Vec<u8> lengths = Vec::filled(n, 0: u8);\n    Vec<u32> f = Vec::from_slice(freq);\n    usize used ="
    " 0;\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (f[i] > 0)\n        {\n            used += 1"
    ";\n        }\n    }\n    if (used == 0)\n    {\n        return lengths;\n    }\n    if (used == 1)\n    {\n  "
    "      for (usize i = 0; i < n; i += 1)\n        {\n            if (f[i] > 0)\n            {\n           "
    "     lengths[i] = 1;\n            }\n        }\n        return lengths;\n    }\n    while (true)\n    {\n  "
    "      // Nodes 0..n are the symbols, n.. the merges; each node's weight,\n        // parent and depth"
    ".\n        Vec<u64> weight = Vec::new();\n        Vec<usize> parent = Vec::new();\n        Vec<bool> al"
    "ive = Vec::new();\n        for (usize i = 0; i < n; i += 1)\n        {\n            Vec::push(&mut weig"
    "ht, widen<u64>(f[i]));\n            Vec::push(&mut parent, 0);\n            Vec::push(&mut alive, f[i]"
    " > 0);\n        }\n        usize live = used;\n        while (live > 1)\n        {\n            usize a ="
    " n * 2;\n            usize b = n * 2;\n            for (usize i = 0; i < Vec::len(&weight); i += 1)\n  "
    "          {\n                if (!alive[i])\n                {\n                    continue;\n         "
    "       }\n                if (a == n * 2 || weight[i] < weight[a])\n                {\n                "
    "    b = a;\n                    a = i;\n                }\n                else if (b == n * 2 || weigh"
    "t[i] < weight[b])\n                {\n                    b = i;\n                }\n            }\n     "
    "       usize m = Vec::len(&weight);\n            Vec::push(&mut weight, weight[a] + weight[b]);\n     "
    "       Vec::push(&mut parent, 0);\n            Vec::push(&mut alive, true);\n            alive[a] = fa"
    "lse;\n            alive[b] = false;\n            parent[a] = m;\n            parent[b] = m;\n           "
    " live -= 1;\n        }\n        usize root = Vec::len(&weight) - 1;\n        usize deepest = 0;\n       "
    " for (usize i = 0; i < n; i += 1)\n        {\n            if (f[i] == 0)\n            {\n               "
    " continue;\n            }\n            usize d = 0;\n            usize at = i;\n            while (at !="
    " root)\n            {\n                at = parent[at];\n                d += 1;\n            }\n        "
    "    lengths[i] = narrow<u8>(d);\n            if (d > deepest)\n            {\n                deepest ="
    " d;\n            }\n        }\n        if (deepest <= limit)\n        {\n            return lengths;\n    "
    "    }\n        for (usize i = 0; i < n; i += 1)\n        {\n            if (f[i] > 0)\n            {\n   "
    "             f[i] = (f[i] >> 1) | 1;\n            }\n        }\n    }\n}fn canonical_codes(slice<u8, sha"
    "red> lengths) : Vec<u32>\n{\n    array<u32, 16> count = [0; 16];\n    for (usize i = 0; i < slice_len(l"
    "engths); i += 1)\n    {\n        count[widen<usize>(lengths[i])] += 1;\n    }\n    count[0] = 0;\n    arr"
    "ay<u32, 16> next = [0; 16];\n    u32 code = 0;\n    for (usize len = 1; len < 16; len += 1)\n    {\n    "
    "    code = (code + count[len - 1]) << 1;\n        next[len] = code;\n    }\n    Vec<u32> codes = Vec::f"
    "illed(slice_len(lengths), 0: u32);\n    for (usize i = 0; i < slice_len(lengths); i += 1)\n    {\n     "
    "   usize l = widen<usize>(lengths[i]);\n        if (l != 0)\n        {\n            codes[i] = next[l];"
    "\n            next[l] += 1;\n        }\n    }\n    codes\n}fn length_code(usize len) : usize\n{\n    usize "
    "c = 28;\n    for (usize i = 0; i < 28; i += 1)\n    {\n        if (len < widen<usize>(LENGTH_BASE[i + 1"
    "]))\n        {\n            c = i;\n            break;\n        }\n    }\n    c\n}fn distance_code(usize d)"
    " : usize\n{\n    usize c = 29;\n    for (usize i = 0; i < 29; i += 1)\n    {\n        if (d < widen<usize"
    ">(DIST_BASE[i + 1]))\n        {\n            c = i;\n            break;\n        }\n    }\n    c\n}fn hash3"
    "(slice<u8, shared> d, usize i) : usize\n{\n    ((widen<usize>(d[i]) << 10) ^ (widen<usize>(d[i + 1]) <"
    "< 5) ^ widen<usize>(d[i + 2])) & (HASH_SIZE - 1)\n}fn token_counts(slice<Token, shared> tokens) : Tok"
    "enCounts\n{\n    array<u32, 286> lit = [0; 286];\n    array<u32, 30> dist = [0; 30];\n    u64 extra = 0;"
    "\n    for (usize k = 0; k < slice_len(tokens); k += 1)\n    {\n        u16 l = tokens[k].lit;\n        l"
    "it[widen<usize>(l)] += 1;\n        if (l >= 256)\n        {\n            dist[widen<usize>(tokens[k].di"
    "st_code)] += 1;\n            extra += widen<u64>(tokens[k].len_extra_bits) + widen<u64>(tokens[k].dis"
    "t_extra_bits);\n        }\n    }\n    TokenCounts { .lit = lit, .dist = dist, .extra = extra }\n}fn writ"
    "e_block(ref<BitWriter, exclusive> w, slice<Token, shared> tokens, slice<u8, shared> raw, bool last)\n"
    "{\n    // Frequencies, with the end-of-block symbol.\n    TokenCounts counts = token_counts(tokens);\n "
    "   Vec<u32> lf = Vec::from_slice(&counts.lit[0..$]);\n    Vec<u32> df = Vec::from_slice(&counts.dist["
    "0..$]);\n    lf[256] += 1;\n    Vec<u8> ll = code_lengths(&lf[0..$], 15);\n    Vec<u8> dl = code_length"
    "s(&df[0..$], 15);\n    // The fixed code's lengths, for its cost.\n    Vec<u8> fl = Vec::filled(288, 8"
    ": u8);\n    for (usize i = 144; i < 256; i += 1)\n    {\n        fl[i] = 9;\n    }\n    for (usize i = 25"
    "6; i < 280; i += 1)\n    {\n        fl[i] = 7;\n    }\n    u64 extra = counts.extra;\n    u64 cost_fixed "
    "= extra;\n    u64 cost_dyn = extra;\n    for (usize i = 0; i < 286; i += 1)\n    {\n        cost_fixed +"
    "= widen<u64>(lf[i]) * widen<u64>(fl[i]);\n        cost_dyn += widen<u64>(lf[i]) * widen<u64>(ll[i]);\n"
    "    }\n    for (usize i = 0; i < 30; i += 1)\n    {\n        cost_fixed += widen<u64>(df[i]) * 5;\n     "
    "   cost_dyn += widen<u64>(df[i]) * widen<u64>(dl[i]);\n    }\n    // The dynamic header: the code leng"
    "ths run-length coded.\n    usize nlen = 286;\n    while (nlen > 257 && ll[nlen - 1] == 0)\n    {\n      "
    "  nlen -= 1;\n    }\n    usize ndist = 30;\n    while (ndist > 1 && dl[ndist - 1] == 0)\n    {\n        n"
    "dist -= 1;\n    }\n    Vec<u8> all = Vec::new();\n    Vec::extend_from(&mut all, &ll[0..nlen]);\n    Vec"
    "::extend_from(&mut all, &dl[0..ndist]);\n    // Run-length symbols: (symbol, extra value, extra bits)"
    ".\n    Vec<u8> rl_sym = Vec::new();\n    Vec<u8> rl_val = Vec::new();\n    Vec<u8> rl_bits = Vec::new()"
    ";\n    usize i = 0;\n    while (i < Vec::len(&all))\n    {\n        u8 v = all[i];\n        usize run = 1"
    ";\n        while (i + run < Vec::len(&all) && all[i + run] == v)\n        {\n            run += 1;\n    "
    "    }\n        if (v == 0 && run >= 3)\n        {\n            usize r = if (run > 138) { 138 } else { "
    "run };\n            if (r <= 10)\n            {\n                Vec::push(&mut rl_sym, 17);\n          "
    "      Vec::push(&mut rl_val, narrow<u8>(r - 3));\n                Vec::push(&mut rl_bits, 3);\n       "
    "     }\n            else\n            {\n                Vec::push(&mut rl_sym, 18);\n                Ve"
    "c::push(&mut rl_val, narrow<u8>(r - 11));\n                Vec::push(&mut rl_bits, 7);\n            }\n"
    "            i += r;\n        }\n        else if (v != 0 && run >= 4)\n        {\n            Vec::push(&"
    "mut rl_sym, v);\n            Vec::push(&mut rl_val, 0);\n            Vec::push(&mut rl_bits, 0);\n     "
    "       usize r = if (run - 1 > 6) { 6 } else { run - 1 };\n            Vec::push(&mut rl_sym, 16);\n  "
    "          Vec::push(&mut rl_val, narrow<u8>(r - 3));\n            Vec::push(&mut rl_bits, 2);\n       "
    "     i += 1 + r;\n        }\n        else\n        {\n            Vec::push(&mut rl_sym, v);\n           "
    " Vec::push(&mut rl_val, 0);\n            Vec::push(&mut rl_bits, 0);\n            i += 1;\n        }\n  "
    "  }\n    Vec<u32> cf = Vec::filled(19, 0: u32);\n    foreach (s in &rl_sym)\n    {\n        cf[widen<usi"
    "ze>(*s)] += 1;\n    }\n    Vec<u8> cl = code_lengths(&cf[0..$], 7);\n    usize ncode = 19;\n    while (n"
    "code > 4 && cl[widen<usize>(CLEN_ORDER[ncode - 1])] == 0)\n    {\n        ncode -= 1;\n    }\n    cost_d"
    "yn += 14 + widen<u64>(ncode) * 3;\n    for (usize k = 0; k < Vec::len(&rl_sym); k += 1)\n    {\n       "
    " cost_dyn += widen<u64>(cl[widen<usize>(rl_sym[k])]) + widen<u64>(rl_bits[k]);\n    }\n    u64 cost_st"
    "ored = widen<u64>(slice_len(raw)) * 8 + 40 * (widen<u64>(slice_len(raw)) / 65535 + 1);\n    if (cost_"
    "stored <= cost_fixed && cost_stored <= cost_dyn)\n    {\n        // Stored blocks of at most 65535 byt"
    "es, the last marked.\n        usize at = 0;\n        while (true)\n        {\n            usize take = i"
    "f (slice_len(raw) - at > 65535) { 65535 } else { slice_len(raw) - at };\n            bool final = las"
    "t && at + take == slice_len(raw);\n            BitWriter::put(w, if (final) { 1 } else { 0 }, 1);\n   "
    "         BitWriter::put(w, 0, 2);\n            BitWriter::flush(w);\n            Vec::push_le(&mut w.o"
    "ut, narrow<u16>(take));\n            Vec::push_le(&mut w.out, narrow<u16>(take ^ 0xFFFF));\n          "
    "  Vec::extend_from(&mut w.out, &raw[at..at + take]);\n            at += take;\n            if (at >= s"
    "lice_len(raw))\n            {\n                return;\n            }\n        }\n    }\n    BitWriter::pu"
    "t(w, if (last) { 1 } else { 0 }, 1);\n    Vec<u32> lcodes = Vec::new();\n    Vec<u8> llens = Vec::new("
    ");\n    Vec<u32> dcodes = Vec::new();\n    Vec<u8> dlens = Vec::new();\n    if (cost_fixed <= cost_dyn)"
    "\n    {\n        BitWriter::put(w, 1, 2);\n        overwrite(&mut lcodes, canonical_codes(&fl[0..$]));\n"
