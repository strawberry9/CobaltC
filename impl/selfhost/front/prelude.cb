    ">(ref<Atomic<T>, shared> a, T n) : T\n{\n    atomic_op(a, 8, n, 0)\n}export fn Atomic::fetch_or<T: inte"
    "ger>(ref<Atomic<T>, shared> a, T n) : T\n{\n    atomic_op(a, 9, n, 0)\n}export fn Atomic::fetch_xor<T: "
    "integer>(ref<Atomic<T>, shared> a, T n) : T\n{\n    atomic_op(a, 10, n, 0)\n}unittest \"Atomic::fetch_ad"
    "d: a counter shared by threads\"\n{\n    Atomic<u64> hits = Atomic::new(0: u64);\n    {\n        Vec<hand"
    "le<u64>> hs = Vec::new();\n        foreach (k in 0..8)\n        {\n            Vec::push(&mut hs, spawn"
    "(Atomic::fetch_add<u64>, &hits, 5: u64));\n        }\n        while (Vec::len(&hs) > 0)\n        {\n    "
    "        _ = join(Option::unwrap(Vec::pop(&mut hs)));\n        }\n    }\n    assert(Atomic::load(&hits) "
