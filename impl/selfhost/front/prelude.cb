    "     lo + width\n            }\n            else\n            {\n                n\n            };\n      "
    "      usize hi = if (n - mid > width)\n            {\n                mid + width\n            }\n      "
    "      else\n            {\n                n\n            };\n            usize l = lo;\n            usiz"
    "e r = mid;\n            usize k = lo;\n            while (k < hi)\n            {\n                // Fro"
    "m the left run unless the right one's element is\n                // strictly less: equal elements ke"
    "ep their order.\n                bool take_left = l < mid && (r >= hi || !less(Vec::index_shared(v, a"
    "[r]), Vec::index_shared(v, a[l])));\n                if (take_left)\n                {\n               "
    "     b[k] = a[l];\n                    l += 1;\n                }\n                else\n               "
