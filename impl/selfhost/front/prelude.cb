    " + 1]) << 8) | (widen<u32>(key[4 * i + 2]) << 16) | (widen<u32>(key[4 * i + 3]) << 24);\n    }\n    u8"
    " rcon = 1;\n    for (usize word = nk; word < 4 * (rounds + 1); word += 1)\n    {\n        u32 t = w[wor"
    "d - 1];\n        if (word % nk == 0)\n        {\n            t = narrow_wrapping<u32>(aes_sbox_bytes(wi"
