    "opening\"\n{\n    array<u8, 16> key = [0; 16];\n    array<u8, 12> nonce = [0; 12];\n    array<u8, 16> pla"
    "in = [0; 16];\n    Vec<u8> none = Vec::new();\n    Vec<u8> sealed = aes_gcm_seal(&key, &nonce, &none, "
    "&plain);\n    String want = \"0388dace60b6a392f328c2b971b2fe78\";\n    String::append(&mut want, \"ab6e47"
    "d42cec13bdf53a67b21257bddf\");\n    assert((to_hex(&sealed) == want));\n    Vec<u8> opened = Option::un"
    "wrap(aes_gcm_open(&key, &nonce, &none, &sealed));\n    assert(slice_eq(&opened, &plain));\n    assert("
    "Option::is_none(&aes_gcm_open(&key, &nonce, b\"aad\", &sealed)));\n}export fn aes_gcm_open(\n    slice<u"
    "8, shared> key,\n    slice<u8, shared> nonce,\n    slice<u8, shared> aad,\n    slice<u8, shared> sealed"
    ",\n) : Option<Vec<u8>>\n{\n    array<u8, 16> j0 = gcm_j0(nonce);\n    AesKey k = aes_expand(key);\n    us"
    "ize n = slice_len(sealed);\n    if (n < 16)\n    {\n        return None;\n    }\n    array<u8, 16> want ="
    " gcm_tag(&k, j0, aad, &sealed[0..n - 16]);\n    if (!digest_eq(&want, &sealed[n - 16..n]))\n    {\n    "
    "    return None;\n    }\n    Some(gcm_ctr(&k, j0, &sealed[0..n - 16]))\n}fn fe_carry(array<u64, 5> f) :"
    " array<u64, 5>\n{\n    array<u64, 5> r = f;\n    for (usize i = 0; i < 4; i += 1)\n    {\n        r[i + 1"
    "] += r[i] >> 51;\n        r[i] = r[i] & FE_MASK;\n    }\n    u64 c = r[4] >> 51;\n    r[4] = r[4] & FE_M"
    "ASK;\n    r[0] += c * 19;\n    r[1] += r[0] >> 51;\n    r[0] = r[0] & FE_MASK;\n    r\n}fn fe_add(array<u"
    "64, 5> a, array<u64, 5> b) : array<u64, 5>\n{\n    fe_carry([a[0] + b[0], a[1] + b[1], a[2] + b[2], a["
    "3] + b[3], a[4] + b[4]])\n}fn fe_sub(array<u64, 5> a, array<u64, 5> b) : array<u64, 5>\n{\n    fe_carry"
    "([\n        a[0] + 0x1fffffffffffb4 - b[0],\n        a[1] + 0x1ffffffffffffc - b[1],\n        a[2] + 0x"
    "1ffffffffffffc - b[2],\n        a[3] + 0x1ffffffffffffc - b[3],\n        a[4] + 0x1ffffffffffffc - b[4"
    "],\n    ])\n}fn fe_mul(array<u64, 5> a, array<u64, 5> b) : array<u64, 5>\n{\n    u128 a0 = widen<u128>(a"
    "[0]);\n    u128 a1 = widen<u128>(a[1]);\n    u128 a2 = widen<u128>(a[2]);\n    u128 a3 = widen<u128>(a["
    "3]);\n    u128 a4 = widen<u128>(a[4]);\n    u128 b0 = widen<u128>(b[0]);\n    u128 b1 = widen<u128>(b[1"
    "]);\n    u128 b2 = widen<u128>(b[2]);\n    u128 b3 = widen<u128>(b[3]);\n    u128 b4 = widen<u128>(b[4]"
    ");\n    u128 b1_19 = b1 * 19;\n    u128 b2_19 = b2 * 19;\n    u128 b3_19 = b3 * 19;\n    u128 b4_19 = b4"
    " * 19;\n    u128 t0 = a0 * b0 + a1 * b4_19 + a2 * b3_19 + a3 * b2_19 + a4 * b1_19;\n    u128 t1 = a0 *"
    " b1 + a1 * b0 + a2 * b4_19 + a3 * b3_19 + a4 * b2_19;\n    u128 t2 = a0 * b2 + a1 * b1 + a2 * b0 + a3"
    " * b4_19 + a4 * b3_19;\n    u128 t3 = a0 * b3 + a1 * b2 + a2 * b1 + a3 * b0 + a4 * b4_19;\n    u128 t4"
    " = a0 * b4 + a1 * b3 + a2 * b2 + a3 * b1 + a4 * b0;\n    u128 m = 0x7ffffffffffff;\n    t1 += t0 >> 51"
    ";\n    t2 += t1 >> 51;\n    t3 += t2 >> 51;\n    t4 += t3 >> 51;\n    u128 r0 = (t0 & m) + (t4 >> 51) * "
    "19;\n    u128 r1 = (t1 & m) + (r0 >> 51);\n    array<u64, 5> r = [\n        narrow<u64>(r0 & m),\n      "
    "  narrow<u64>(r1),\n        narrow<u64>(t2 & m),\n        narrow<u64>(t3 & m),\n        narrow<u64>(t4 "
    "& m),\n    ];\n    fe_carry(r)\n}fn fe_cswap(ref<array<u64, 5>, exclusive> a, ref<array<u64, 5>, exclus"
    "ive> b, u64 swap)\n{\n    u64 mask = wrapping_sub(0, swap);\n    for (usize i = 0; i < 5; i += 1)\n    {"
    "\n        u64 x = mask & (a[i] ^ b[i]);\n        a[i] = a[i] ^ x;\n        b[i] = b[i] ^ x;\n    }\n}fn f"
