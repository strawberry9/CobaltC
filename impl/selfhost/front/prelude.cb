    " array<u64, 8> q = [0; 8];\n    for (usize p = 0; p < 8; p += 1)\n    {\n        q[p] = (t >> narrow<u3"
    "2>(8 * p)) & 0xff;\n    }\n    q = aes_sbox_ct(q);\n    u64 r = 0;\n    for (usize p = 0; p < 8; p += 1)"
