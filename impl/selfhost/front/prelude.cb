    "et_ptr<u8>(b.ptr), n)\n        };\n        if (r != 0)\n        {\n            fault(entropy_unavailable"
    ");\n        }\n    }\n    b.len = n;\n    b\n}export fn os_random_bytes(slice<u8, exclusive> out)\n{\n    V"
    "ec<u8> b = os_random_vec(slice_len(out));\n    for (usize i = 0; i < slice_len(out); i += 1)\n    {\n  "
    "      out[i] = b[i];\n    }\n}export fn os_random_u64() : u64\n{\n    Vec<u8> b = os_random_vec(8);\n    "
    "read_le<u64>(&b[0..$], 0)\n}export fn Rng::from_os() : Rng\n{\n    Rng::new(os_random_u64())\n}export fn"
    " Rng::shuffle<T>(ref<Rng, exclusive> r, slice<T, exclusive> s)\n{\n    usize n = slice_len(s);\n    for"
    " (usize i = n; i > 1; i -= 1)\n    {\n        usize j = narrow<usize>(Rng::below(r, widen<u64>(i)));\n "
    "       slice_swap(s, i - 1, j);\n    }\n}unittest \"Rng::shuffle: a Vec through its slice\"\n{\n    Rng r "
