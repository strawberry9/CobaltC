    "e if (s >= 257)\n            {\n                if (f == 1)\n                {\n                    v = "
    "widen<u32>(tokens[k].len_extra);\n                    n = widen<u32>(tokens[k].len_extra_bits);\n     "
    "           }\n                else if (f == 2)\n                {\n                    usize d = widen<"
    "usize>(tokens[k].dist_code);\n                    u32 code = dcodes[d];\n                    n = widen"
    "<u32>(dlens[d]);\n                    for (u32 i = 0; i < n; i += 1)\n                    {\n          "
    "              v = (v << 1) | ((code >> i) & 1);\n                    }\n                }\n            "
    "    else\n                {\n                    v = widen<u32>(tokens[k].dist_extra);\n               "
    "     n = widen<u32>(tokens[k].dist_extra_bits);\n                }\n            }\n            if (n =="
    " 0)\n            {\n                continue;\n            }\n            bits = bits | (widen<u64>(v) <"
    "< count);\n            count += n;\n            while (count >= 8)\n            {\n                Vec::"
    "push(&mut out, narrow_wrapping<u8>(bits));\n                bits = bits >> 8;\n                count -"
    "= 8;\n            }\n        }\n    }\n    BitOut { .buf = out, .acc = bits, .nacc = count }\n}fn deflate"
    "_scan(slice<u8, shared> data, Vec<usize> head, Vec<usize> prev, Vec<Token> tokens, usize start) : De"
    "flateScan\n{\n    usize n = slice_len(data);\n    usize i = start;\n    while (i < n && Vec::len(&tokens"
    ") < MAX_TOKENS)\n    {\n        usize best_len = 0;\n        usize best_dist = 0;\n        if (i + 3 <= "
    "n)\n        {\n            usize h = ((widen<usize>(data[i]) << 10) ^ (widen<usize>(data[i + 1]) << 5)"
    " ^ widen<usize>(data[i + 2])) & (HASH_SIZE - 1);\n            usize cand = head[h];\n            usize"
    " chain = 0;\n            usize limit = if (n - i > 258) { 258 } else { n - i };\n            while (ca"
    "nd != max_value<usize>() && i - cand <= WINDOW && chain < CHAIN_LIMIT)\n            {\n               "
    " if (data[cand + best_len] == data[i + best_len])\n                {\n                    usize l = 0;"
    "\n                    while (l < limit && data[cand + l] == data[i + l])\n                    {\n      "
    "                  l += 1;\n                    }\n                    if (l > best_len)\n              "
    "      {\n                        best_len = l;\n                        best_dist = i - cand;\n        "
    "                if (l == limit)\n                        {\n                            break;\n       "
    "                 }\n                    }\n                }\n                usize next = prev[cand & "
    "(WINDOW - 1)];\n                if (next == max_value<usize>() || next >= cand)\n                {\n   "
    "                 break;\n                }\n                cand = next;\n                chain += 1;\n "
    "           }\n            prev[i & (WINDOW - 1)] = head[h];\n            head[h] = i;\n        }\n      "
    "  if (best_len >= 3)\n        {\n            usize lc = length_code(best_len);\n            usize dc = "
    "distance_code(best_dist);\n            Vec::push(&mut tokens, Token {\n                .lit = narrow<u"
    "16>(257 + lc),\n                .len_extra = narrow<u16>(best_len - widen<usize>(LENGTH_BASE[lc])),\n "
    "               .len_extra_bits = LENGTH_EXTRA[lc],\n                .dist_code = narrow<u8>(dc),\n    "
    "            .dist_extra = narrow<u16>(best_dist - widen<usize>(DIST_BASE[dc])),\n                .dis"
    "t_extra_bits = DIST_EXTRA[dc],\n            });\n            // The bytes inside the match enter the h"
    "ash chains too.\n            for (usize k = 1; k < best_len; k += 1)\n            {\n                if"
    " (i + k + 3 <= n)\n                {\n                    usize h = ((widen<usize>(data[i + k]) << 10)"
    " ^ (widen<usize>(data[i + k + 1]) << 5) ^ widen<usize>(data[i + k + 2])) & (HASH_SIZE - 1);\n        "
    "            prev[(i + k) & (WINDOW - 1)] = head[h];\n                    head[h] = i + k;\n           "
    "     }\n            }\n            i += best_len;\n        }\n        else\n        {\n            Vec::pu"
    "sh(\n                &mut tokens,\n                Token { .lit = widen<u16>(data[i]), .len_extra = 0,"
    " .len_extra_bits = 0, .dist_code = 0, .dist_extra = 0, .dist_extra_bits = 0 },\n            );\n      "
    "      i += 1;\n        }\n    }\n    DeflateScan { .head = head, .prev = prev, .tokens = tokens, .end ="
    " i }\n}export fn deflate(slice<u8, shared> data) : Vec<u8>\n{\n    BitWriter w = BitWriter { .out = Vec"
    "::new(), .bits = 0, .count = 0 };\n    usize n = slice_len(data);\n    if (n == 0)\n    {\n        // On"
    "e empty fixed block.\n        BitWriter::put(&mut w, 1, 1);\n        BitWriter::put(&mut w, 1, 2);\n   "
    "     BitWriter::put(&mut w, 0, 7);\n        BitWriter::flush(&mut w);\n        BitWriter { out, bits, "
    "count } = w;\n        return out;\n    }\n    Vec<usize> heads = Vec::filled(HASH_SIZE, max_value<usize"
    ">());\n    Vec<usize> chains = Vec::filled(WINDOW, max_value<usize>());\n    DeflateScan s = DeflateSc"
    "an { .head = heads, .prev = chains, .tokens = Vec::new(), .end = 0 };\n    while (s.end < n)\n    {\n  "
    "      usize block_start = s.end;\n        DeflateScan { head, prev, tokens, end } = s;\n        s = de"
    "flate_scan(data, head, prev, tokens, end);\n        write_block(&mut w, &s.tokens[0..$], &data[block_"
    "start..s.end], s.end >= n);\n        Vec::clear(&mut s.tokens);\n    }\n    BitWriter::flush(&mut w);\n "
    "   BitWriter { out, bits, count } = w;\n    out\n}unittest \"deflate: empty data, and adler32\"\n{\n    Ve"
    "c<u8> nothing = Vec::new();\n    Vec<u8> empty = deflate(&nothing[0..$]);\n    assert(Vec::len(&empty)"
    " == 2 && empty[0] == 0x03 && empty[1] == 0x00);\n    assert(Vec::len(&Result::unwrap(inflate(&empty[0"
    "..$], 0))) == 0);\n    assert(adler32(&b\"Wikipedia\"[0..$]) == 300286872);\n    assert(adler32(&nothing"
    "[0..$]) == 1);\n}export fn adler32(slice<u8, shared> data) : u32\n{\n    u32 a = 1;\n    u32 b = 0;\n    "
    "usize i = 0;\n    usize n = slice_len(data);\n    while (i < n)\n    {\n        // 5552 bytes at a time "
    "fit the sums in a `u32` before reducing.\n        usize end = if (n - i > 5552) { i + 5552 } else { n"
    " };\n        while (i < end)\n        {\n            a += widen<u32>(data[i]);\n            b += a;\n    "
    "        i += 1;\n        }\n        a = a % 65521;\n        b = b % 65521;\n    }\n    (b << 16) | a\n}exp"
    "ort fn zlib_deflate(slice<u8, shared> data) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n    Vec::push("
    "&mut out, 0x78);\n    Vec::push(&mut out, 0x9C);\n    Vec::append(&mut out, deflate(data));\n    Vec::p"
    "ush_be(&mut out, adler32(data));\n    out\n}export fn zlib_inflate(slice<u8, shared> data, usize max) "
    ": Result<Vec<u8>, CompressError>\n{\n    if (slice_len(data) < 6)\n    {\n        return Err(Truncated);"
    "\n    }\n    u8 cmf = data[0];\n    u8 flg = data[1];\n    if ((cmf & 0x0F) != 8 || (widen<u32>(cmf) * 2"
    "56 + widen<u32>(flg)) % 31 != 0 || (flg & 0x20) != 0)\n    {\n        return Err(Corrupt(0));\n    }\n  "
    "  Vec<u8> out = Vec::new();\n    usize end = inflate_from(data, 2, &mut out, max)?;\n    if (end + 4 >"
    " slice_len(data))\n    {\n        return Err(Truncated);\n    }\n    if (read_be<u32>(data, end) != adle"
    "r32(&out[0..$]))\n    {\n        return Err(Corrupt(end));\n    }\n    Ok(out)\n}unittest \"zlib_inflate: "
    "a wrong checksum\"\n{\n    Vec<u8> z = zlib_deflate(&b\"hello hello hello\"[0..$]);\n    usize last = Vec:"
    ":len(&z) - 1;\n    z[last] = z[last] ^ 1;\n    match (zlib_inflate(&z[0..$], 100))\n    {\n        Err(C"
    "orrupt(at)) : assert(at == last - 3),\n        _                : assert(false),\n    }\n}export fn gzi"
    "p(slice<u8, shared> data) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n    array<u8, 10> header = [0x1F"
    ", 0x8B, 8, 0, 0, 0, 0, 0, 0, 255];\n    Vec::extend_from(&mut out, &header[0..$]);\n    Vec::append(&m"
    "ut out, deflate(data));\n    Vec::push_le(&mut out, crc32(data));\n    Vec::push_le(&mut out, narrow_w"
    "rapping<u32>(slice_len(data)));\n    out\n}export fn gunzip(slice<u8, shared> data, usize max) : Resul"
    "t<Vec<u8>, CompressError>\n{\n    Vec<u8> out = Vec::new();\n    usize at = 0;\n    usize n = slice_len("
    "data);\n    while (true)\n    {\n        if (at + 10 > n)\n        {\n            return Err(Truncated);\n"
    "        }\n        if (data[at] != 0x1F || data[at + 1] != 0x8B || data[at + 2] != 8)\n        {\n     "
    "       return Err(Corrupt(at));\n        }\n        u8 flags = data[at + 3];\n        usize p = at + 10"
    ";\n        if ((flags & 4) != 0)\n        {\n            if (p + 2 > n)\n            {\n                r"
    "eturn Err(Truncated);\n            }\n            p += 2 + widen<usize>(read_le<u16>(data, p));\n      "
    "  }\n        if ((flags & 8) != 0)\n        {\n            while (p < n && data[p] != 0)\n            {\n"
    "                p += 1;\n            }\n            p += 1;\n        }\n        if ((flags & 16) != 0)\n "
    "       {\n            while (p < n && data[p] != 0)\n            {\n                p += 1;\n           "
    " }\n            p += 1;\n        }\n        if ((flags & 2) != 0)\n        {\n            p += 2;\n       "
    " }\n        if (p > n)\n        {\n            return Err(Truncated);\n        }\n        usize before = "
    "Vec::len(&out);\n        usize end = inflate_from(data, p, &mut out, max)?;\n        if (end + 8 > n)\n"
    "        {\n            return Err(Truncated);\n        }\n        if (read_le<u32>(\n            data,\n "
    "           end,\n        ) != crc32(&out[before..$]) || read_le<u32>(data, end + 4) != narrow_wrappin"
    "g<u32>(Vec::len(&out) - before))\n        {\n            return Err(Corrupt(end));\n        }\n        a"
    "t = end + 8;\n        if (at >= n)\n        {\n            return Ok(out);\n        }\n    }\n}unittest \"g"
    "unzip: round trip and the size limit\"\n{\n    Vec<u8> data = Vec::filled(1000, b'a');\n    Vec<u8> pack"
    "ed = gzip(&data[0..$]);\n    assert(Vec::len(&packed) < 100);\n    Vec<u8> back = Result::unwrap(gunzi"
    "p(&packed[0..$], 1000));\n    assert(Vec::len(&back) == 1000 && back[999] == b'a');\n    match (gunzip"
    "(&packed[0..$], 999))\n    {\n        Err(Oversize) : {},\n        _             : assert(false),\n    }"
    "\n}export fn NulError::text(ref<NulError, shared> e) : str\n{\n    \"holds a NUL byte\"\n}export fn CStrin"
    "g::from_bytes(slice<u8, shared> b) : Result<CString, NulError>\n{\n    usize n = slice_len(b);\n    Vec"
    "<u8> bytes = Vec::new();\n    Vec::reserve(&mut bytes, n + 1);\n    for (usize i = 0; i < n; i += 1)\n "
    "   {\n        if (b[i] == 0)\n        {\n            return Err(NulError { .offset = i });\n        }\n  "
    "      Vec::push(&mut bytes, b[i]);\n    }\n    Vec::push(&mut bytes, 0);\n    Ok(CString { .bytes = byt"
    "es })\n}export fn CString::new(StringView s) : Result<CString, NulError>\n{\n    CString::from_bytes(St"
    "ringView::as_bytes(s))\n}export fn CString::ptr(ref<CString, shared> c) : rawptr<u8>\n{\n    rawptr_of("
    "&c.bytes[0])\n}export fn CString::len(ref<CString, shared> c) : usize\n{\n    Vec::len(&c.bytes) - 1\n}e"
    "xport fn CString::as_bytes(ref<CString, shared> c) : slice<u8, shared>\n{\n    &c.bytes[0 .. Vec::len("
    "&c.bytes) - 1]\n}export fn copy_to_raw<T: plain>(slice<T, shared> s, rawptr<T> p)\n{\n    usize n = sli"
    "ce_len(s);\n    if (n == 0)\n    {\n        return;\n    }\n    if (p == null_rawptr<T>())\n    {\n        "
    "fault(null_pointer);\n    }\n    // trusted: [Copy-Raw] of the slice's n * sizeof<T>() bytes (readable"
    ": the slice's own path covers them) to `p`, the caller's assertion in its `unsafe` that `p` has room"
    " for them and that no live object's cells lie there (a [Trusted-Call], spec/20 §1); T is `plain`, s"
    "o the bytes are the elements.\n    unsafe\n    {\n        copy_raw(reinterpret_ptr<u8>(p), reinterpret_"
    "ptr<u8>(rawptr_of(&s[0])), n * sizeof<T>());\n    }\n}export fn is_null<T>(rawptr<T> p) : bool\n{\n    p"
    " == null_rawptr<T>()\n}";

