    "= 1;\n    }\n    usize width = 1;\n    while (width < n)\n    {\n        usize lo = 0;\n        while (lo "
    "< n)\n        {\n            usize mid = if (n - lo > width)\n            {\n                lo + width\n"
    "            }\n            else\n            {\n                n\n            };\n            usize hi ="
    " if (n - mid > width)\n            {\n                mid + width\n            }\n            else\n     "
    "       {\n                n\n            };\n            usize l = lo;\n            usize r = mid;\n     "
    "       usize k = lo;\n            while (k < hi)\n            {\n                bool take_left = l < m"
    "id && (r >= hi || !key_less_at(v, a[r], a[l]));\n                if (take_left)\n                {\n   "
    "                 b[k] = a[l];\n                    l += 1;\n                }\n                else\n   "
    "             {\n                    b[k] = a[r];\n                    r += 1;\n                }\n      "
    "          k += 1;\n            }\n            lo = hi;\n        }\n        swap(&mut a, &mut b);\n       "
    " width = if (width > n)\n        {\n            n\n        }\n        else\n        {\n            width *"
