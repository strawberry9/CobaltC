    "y[0..$], block);\n    assert(String::eq_str(&to_hex(&out[0..$]), \"69c4e0d86a7b0430d8cdb78070b4c55a\"))"
    ";\n}fn gcm_block(slice<u8, shared> b, usize at) : u128\n{\n    u128 x = 0;\n    for (usize i = 0; i < 16"
    "; i += 1)\n    {\n        u8 v = if (at + i < slice_len(b)) { b[at + i] } else { 0 };\n        x = (x <"
    "< 8) | widen<u128>(v);\n    }\n    x\n}fn ghash_bmul64(u64 x, u64 y) : u64\n{\n    u64 x0 = x & 0x1111111"
