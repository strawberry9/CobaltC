    "ag[4 * i + 3] = narrow_wrapping<u8>(w[i] >> 24);\n    }\n    tag\n}export fn poly1305(slice<u8, shared>"
    " key, slice<u8, shared> message) : array<u8, 16>\n{\n    if (slice_len(key) != 32)\n    {\n        fault"
