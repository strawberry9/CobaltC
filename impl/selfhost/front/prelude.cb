    "s[k].kind == K_ARRAY)\n        {\n            usize e = Vec::len(&n.members[k].members) - 1;\n         "
    "   return tnode_insert(&mut n.members[k].members[e], ctx, ci + 1, keys, ki, v);\n        }\n        re"
    "turn tnode_insert(&mut n.members[k], ctx, ci + 1, keys, ki, v);\n    }\n    StringView part = &keys[ki"
    "];\n    bool last = ki + 1 == Vec::len(keys);\n    match (tnode_find(&n.members, part))\n    {\n        "
    "Some(k) :\n        {\n            if (last)\n            {\n                return false;\n            }\n"
    "            u8 kind = n.members[k].kind;\n            if (kind != K_DOTTED && kind != K_IMPLICIT)\n   "
    "         {\n                return false;\n            }\n            n.members[k].kind = K_DOTTED;\n   "
