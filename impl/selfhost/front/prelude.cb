    "::new(),\n    } }\n}export fn Hasher::update(ref<Hasher, exclusive> h, slice<u8, shared> data)\n{\n    m"
    "atch (h.kind)\n    {\n        Sha1     : Sha1::update(&mut h.s1, data),\n        Sha2_256 : Sha256::upd"
    "ate(&mut h.s256, data),\n        _        : Sha512::update(&mut h.s512, data),\n    }\n}export fn Hashe"
    "r::finish(Hasher h) : Vec<u8>\n{\n    match (h.kind)\n    {\n        Sha1     : Vec::from_slice(&Sha1::f"
    "inish(h.s1)[0..$]),\n        Sha2_256 : Vec::from_slice(&Sha256::finish(h.s256)[0..$]),\n        Sha2_"
    "384 : Vec::from_slice(&Sha384::finish(Sha384 { .inner = h.s512 })[0..$]),\n        Sha2_512 : Vec::fr"
    "om_slice(&Sha512::finish(h.s512)[0..$]),\n    }\n}fn blake2b_block(array<u64, 8> h, array<u8, 128> blk"
    ", u64 length, bool last) : array<u64, 8>\n{\n    array<u64, 16> m = [0; 16];\n    for (usize i = 0; i <"
    " 16; i += 1)\n    {\n        u64 x = 0;\n        for (usize j = 0; j < 8; j += 1)\n        {\n           "
    " x = x | (widen<u64>(blk[8 * i + j]) << narrow<u32>(8 * j));\n        }\n        m[i] = x;\n    }\n    a"
    "rray<u64, 16> v = [0; 16];\n    for (usize i = 0; i < 8; i += 1)\n    {\n        v[i] = h[i];\n        v"
    "[8 + i] = BLAKE2B_IV[i];\n    }\n    v[12] = v[12] ^ length;\n    if (last)\n    {\n        v[14] = ~v[14"
    "];\n    }\n    for (usize r = 0; r < 12; r += 1)\n    {\n        usize o = 16 * (r % 10);\n        for (u"
    "size g = 0; g < 8; g += 1)\n        {\n            usize a = widen<usize>(BLAKE2B_G[4 * g]);\n         "
    "   usize b = widen<usize>(BLAKE2B_G[4 * g + 1]);\n            usize c = widen<usize>(BLAKE2B_G[4 * g "
    "+ 2]);\n            usize d = widen<usize>(BLAKE2B_G[4 * g + 3]);\n            u64 x = m[widen<usize>("
    "BLAKE2B_SIGMA[o + 2 * g])];\n            u64 y = m[widen<usize>(BLAKE2B_SIGMA[o + 2 * g + 1])];\n     "
    "       v[a] = wrapping_add(wrapping_add(v[a], v[b]), x);\n            v[d] = rotate_right(v[d] ^ v[a]"
    ", 32);\n            v[c] = wrapping_add(v[c], v[d]);\n            v[b] = rotate_right(v[b] ^ v[c], 24)"
    ";\n            v[a] = wrapping_add(wrapping_add(v[a], v[b]), y);\n            v[d] = rotate_right(v[d]"
    " ^ v[a], 16);\n            v[c] = wrapping_add(v[c], v[d]);\n            v[b] = rotate_right(v[b] ^ v["
    "c], 63);\n        }\n    }\n    array<u64, 8> out = h;\n    for (usize i = 0; i < 8; i += 1)\n    {\n     "
    "   out[i] = h[i] ^ v[i] ^ v[8 + i];\n    }\n    out\n}fn blake2b_absorb(Blake2b s, slice<u8, shared> da"
    "ta) : Blake2b\n{\n    usize at = 0;\n    usize n = slice_len(data);\n    while (at < n)\n    {\n        if"
    " (s.fill == 128)\n        {\n            s.length += 128;\n            s.h = blake2b_block(s.h, s.block"
    ", s.length, false);\n            s.fill = 0;\n        }\n        usize take = min(128 - s.fill, n - at)"
    ";\n        for (usize i = 0; i < take; i += 1)\n        {\n            s.block[s.fill + i] = data[at + "
    "i];\n        }\n        s.fill += take;\n        at += take;\n    }\n    s\n}export fn Blake2b::new_keyed("
    "slice<u8, shared> key, usize out_len) : Blake2b\n{\n    usize klen = slice_len(key);\n    if (out_len ="
    "= 0 || out_len > 64 || klen > 64)\n    {\n        fault(crypto_length);\n    }\n    array<u64, 8> h = BL"
    "AKE2B_IV;\n    h[0] = h[0] ^ 0x01010000 ^ (widen<u64>(klen) << 8) ^ widen<u64>(out_len);\n    Blake2b "
    "s = Blake2b { .h = h, .block = [0; 128], .fill = 0, .length = 0, .out_len = out_len };\n    if (klen "
    "> 0)\n    {\n        for (usize i = 0; i < klen; i += 1)\n        {\n            s.block[i] = key[i];\n  "
    "      }\n        s.fill = 128;\n    }\n    s\n}export fn Blake2b::new(usize out_len) : Blake2b\n{\n    Vec"
    "<u8> none = Vec::new();\n    Blake2b::new_keyed(&none[0..$], out_len)\n}export fn Blake2b::update(ref<"
    "Blake2b, exclusive> s, slice<u8, shared> data)\n{\n    *s = blake2b_absorb(*s, data);\n}export fn Blake"
    "2b::finish(Blake2b s) : Vec<u8>\n{\n    s.length += widen<u64>(s.fill);\n    for (usize i = s.fill; i <"
    " 128; i += 1)\n    {\n        s.block[i] = 0;\n    }\n    s.h = blake2b_block(s.h, s.block, s.length, tr"
    "ue);\n    Vec<u8> out = Vec::new();\n    for (usize i = 0; i < s.out_len; i += 1)\n    {\n        Vec::p"
    "ush(&mut out, narrow_wrapping<u8>(s.h[i / 8] >> narrow<u32>(8 * (i % 8))));\n    }\n    out\n}export fn"
    " blake2b(slice<u8, shared> data, usize out_len) : Vec<u8>\n{\n    Blake2b s = Blake2b::new(out_len);\n "
    "   Blake2b::update(&mut s, data);\n    Blake2b::finish(s)\n}unittest \"blake2b: the published vector fo"
    "r abc\"\n{\n    Vec<u8> d = blake2b(&b\"abc\"[0..$], 64);\n    String want = \"ba80a53f981c4d0d6a2797b69f12"
    "f6e94c212f14685ac4b74b12bb6fdbffa2d1\";\n    String::append(&mut want, \"7d87c5392aab792dc252d5de4533cc"
    "9518d38aa8dbf1925ab92386edd4009923\");\n    assert(String::eq(&to_hex(&d[0..$]), &want));\n}export fn c"
    "rc32(slice<u8, shared> data) : u32\n{\n    u32 crc = 0xFFFFFFFF;\n    for (usize i = 0; i < slice_len(d"
    "ata); i += 1)\n    {\n        crc = crc ^ widen<u32>(data[i]);\n        for (u32 k = 0; k < 8; k += 1)\n"
    "        {\n            if ((crc & 1) == 1)\n            {\n                crc = (crc >> 1) ^ 0xEDB8832"
    "0;\n            }\n            else\n            {\n                crc = crc >> 1;\n            }\n      "
    "  }\n    }\n    crc ^ 0xFFFFFFFF\n}unittest \"crc32: the check value\"\n{\n    assert(crc32(&b\"123456789\"[0"
    "..$]) == 0xCBF43926);\n}export fn digest_eq(slice<u8, shared> a, slice<u8, shared> b) : bool\n{\n    if"
    " (slice_len(a) != slice_len(b))\n    {\n        return false;\n    }\n    u8 acc = 0;\n    for (usize i ="
    " 0; i < slice_len(a); i += 1)\n    {\n        acc = acc | (a[i] ^ b[i]);\n    }\n    acc == 0\n}unittest "
    "\"digest_eq: the lengths must match too\"\n{\n    array<u8, 3> a = [1, 2, 3];\n    array<u8, 4> b = [1, 2"
    ", 3, 0];\n    assert(digest_eq(&a[0..$], &b[0..3]));\n    assert(!digest_eq(&a[0..$], &b[0..$]));\n}exp"
    "ort fn HmacSha256::new(slice<u8, shared> key) : HmacSha256\n{\n    array<u8, 64> k = [0; 64];\n    if ("
    "slice_len(key) > 64)\n    {\n        array<u8, 32> d = sha256(key);\n        for (usize i = 0; i < 32; "
    "i += 1)\n        {\n            k[i] = d[i];\n        }\n    }\n    else\n    {\n        for (usize i = 0; "
    "i < slice_len(key); i += 1)\n        {\n            k[i] = key[i];\n        }\n    }\n    array<u8, 64> i"
    "pad = [0; 64];\n    array<u8, 64> opad = [0; 64];\n    for (usize i = 0; i < 64; i += 1)\n    {\n       "
    " ipad[i] = k[i] ^ 0x36;\n        opad[i] = k[i] ^ 0x5c;\n    }\n    Sha256 inner = Sha256::new();\n    S"
    "ha256::update(&mut inner, &ipad[0..$]);\n    Sha256 outer = Sha256::new();\n    Sha256::update(&mut ou"
    "ter, &opad[0..$]);\n    HmacSha256 { .inner = inner, .outer = outer }\n}export fn HmacSha256::update(r"
    "ef<HmacSha256, exclusive> m, slice<u8, shared> data)\n{\n    Sha256::update(&mut m.inner, data);\n}expo"
    "rt fn HmacSha256::finish(HmacSha256 m) : array<u8, 32>\n{\n    array<u8, 32> inner_digest = Sha256::fi"
    "nish(m.inner);\n    Sha256 outer = m.outer;\n    Sha256::update(&mut outer, &inner_digest[0..$]);\n    "
    "Sha256::finish(outer)\n}export fn hmac_sha256(slice<u8, shared> key, slice<u8, shared> data) : array<"
    "u8, 32>\n{\n    HmacSha256 m = HmacSha256::new(key);\n    HmacSha256::update(&mut m, data);\n    HmacSha"
    "256::finish(m)\n}unittest \"hmac_sha256: an RFC 4231 vector\"\n{\n    array<u8, 32> mac = hmac_sha256(&b\""
    "Jefe\"[0..$], &b\"what do ya want for nothing?\"[0..$]);\n    String hex = to_hex(&mac[0..$]);\n    asser"
    "t(hex == \"5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843\");\n}export fn hkdf_extrac"
    "t(slice<u8, shared> salt, slice<u8, shared> ikm) : array<u8, 32>\n{\n    if (slice_len(salt) == 0)\n   "
    " {\n        array<u8, 32> zero = [0; 32];\n        return hmac_sha256(&zero[0..$], ikm);\n    }\n    hma"
    "c_sha256(salt, ikm)\n}export fn hkdf_expand(slice<u8, shared> prk, slice<u8, shared> info, usize len)"
    " : Vec<u8>\n{\n    if (len > 8160)\n    {\n        fault(hkdf_length);\n    }\n    Vec<u8> out = Vec::new("
    ");\n    Vec::reserve(&mut out, len);\n    array<u8, 32> t = [0; 32];\n    usize have = 0;\n    u8 counte"
    "r = 1;\n    while (Vec::len(&out) < len)\n    {\n        HmacSha256 m = HmacSha256::new(prk);\n        H"
    "macSha256::update(&mut m, &t[0..have]);\n        HmacSha256::update(&mut m, info);\n        array<u8, "
    "1> c = [counter];\n        HmacSha256::update(&mut m, &c[0..$]);\n        t = HmacSha256::finish(m);\n "
    "       have = 32;\n        for (usize i = 0; i < 32 && Vec::len(&out) < len; i += 1)\n        {\n      "
    "      Vec::push(&mut out, t[i]);\n        }\n        if (Vec::len(&out) < len)\n        {\n            c"
    "ounter += 1;\n        }\n    }\n    out\n}export fn hkdf_sha256(slice<u8, shared> salt, slice<u8, shared"
    "> ikm, slice<u8, shared> info, usize len) : Vec<u8>\n{\n    array<u8, 32> prk = hkdf_extract(salt, ikm"
    ");\n    hkdf_expand(&prk[0..$], info, len)\n}unittest \"hkdf_sha256: RFC 5869 test case A.3\"\n{\n    Vec<"
    "u8> ikm = Vec::filled(22, 0x0b: u8);\n    Vec<u8> none = Vec::new();\n    Vec<u8> okm = hkdf_sha256(&n"
    "one[0..$], &ikm[0..$], &none[0..$], 42);\n    String want = \"8da4e775a563c18f715f802a063c5a31b8a11f5c"
    "5ee1879ec345\";\n    String::append(&mut want, \"4e5f3c738d2d9d201395faa4b61a96c8\");\n    assert(String:"
    ":eq(&to_hex(&okm[0..$]), &want));\n}export fn hkdf_expand_label(slice<u8, shared> secret, StringView "
    "label, slice<u8, shared> context, usize len) : Vec<u8>\n{\n    // Over 65535 is over 255 blocks of eve"
    "ry hash: `hkdf_length`, as\n    // `hkdf_expand` would say, not the narrowing below.\n    if (len > 65"
    "_535)\n    {\n        fault(hkdf_length);\n    }\n    Vec<u8> info = Vec::new();\n    Vec::push_be(&mut i"
    "nfo, narrow<u16>(len));\n    Vec::push(&mut info, narrow<u8>(6 + StringView::len(label)));\n    Vec::e"
    "xtend_from(&mut info, &b\"tls13 \"[0..$]);\n    Vec::extend_from(&mut info, label.bytes);\n    Vec::push"
    "(&mut info, narrow<u8>(slice_len(context)));\n    Vec::extend_from(&mut info, context);\n    hkdf_expa"
    "nd(secret, &info[0..$], len)\n}export fn Hmac::new(HashKind kind, slice<u8, shared> key) : Hmac\n{\n   "
    " usize b = block_len(kind);\n    Vec<u8> k = Vec::filled(b, 0: u8);\n    if (slice_len(key) > b)\n    {"
    "\n        Vec<u8> d = hash(kind, key);\n        for (usize i = 0; i < Vec::len(&d); i += 1)\n        {\n"
    "            k[i] = d[i];\n        }\n    }\n    else\n    {\n        for (usize i = 0; i < slice_len(key)"
    "; i += 1)\n        {\n            k[i] = key[i];\n        }\n    }\n    Vec<u8> ipad = Vec::filled(b, 0: "
    "u8);\n    array<u8, 128> opad = [0; 128];\n    for (usize i = 0; i < b; i += 1)\n    {\n        ipad[i] "
    "= k[i] ^ 0x36;\n        opad[i] = k[i] ^ 0x5c;\n    }\n    Hasher inner = Hasher::new(kind);\n    Hasher"
    "::update(&mut inner, &ipad[0..$]);\n    Hmac { .inner = inner, .outer_key = opad }\n}export fn Hmac::u"
    "pdate(ref<Hmac, exclusive> m, slice<u8, shared> data)\n{\n    Hasher::update(&mut m.inner, data);\n}exp"
    "ort fn Hmac::finish(Hmac m) : Vec<u8>\n{\n    HashKind kind = m.inner.kind;\n    Vec<u8> inner_digest ="
    " Hasher::finish(m.inner);\n    Hasher outer = Hasher::new(kind);\n    Hasher::update(&mut outer, &m.ou"
    "ter_key[0..block_len(kind)]);\n    Hasher::update(&mut outer, &inner_digest[0..$]);\n    Hasher::finis"
    "h(outer)\n}export fn hmac(HashKind kind, slice<u8, shared> key, slice<u8, shared> data) : Vec<u8>\n{\n "
    "   Hmac m = Hmac::new(kind, key);\n    Hmac::update(&mut m, data);\n    Hmac::finish(m)\n}unittest \"hma"
    "c: an RFC 4231 vector over SHA-512\"\n{\n    Vec<u8> mac = hmac(Sha2_512, &b\"Jefe\"[0..$], &b\"what do ya"
    " want for nothing?\"[0..$]);\n    String want = \"164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270"
    "cd7ea250554\";\n    String::append(&mut want, \"9758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070"
    "a38bce737\");\n    assert(String::eq(&to_hex(&mac[0..$]), &want));\n}export fn hkdf_extract_with(HashKi"
    "nd kind, slice<u8, shared> salt, slice<u8, shared> ikm) : Vec<u8>\n{\n    if (slice_len(salt) == 0)\n  "
    "  {\n        Vec<u8> zero = Vec::filled(hash_len(kind), 0: u8);\n        return hmac(kind, &zero[0..$]"
    ", ikm);\n    }\n    hmac(kind, salt, ikm)\n}export fn hkdf_expand_with(HashKind kind, slice<u8, shared>"
    " prk, slice<u8, shared> info, usize len) : Vec<u8>\n{\n    usize h = hash_len(kind);\n    if (len > 255"
    " * h)\n    {\n        fault(hkdf_length);\n    }\n    Vec<u8> out = Vec::new();\n    Vec::reserve(&mut ou"
    "t, len);\n    Vec<u8> t = Vec::new();\n    u8 counter = 1;\n    while (Vec::len(&out) < len)\n    {\n    "
    "    Hmac m = Hmac::new(kind, prk);\n        Hmac::update(&mut m, &t[0..$]);\n        Hmac::update(&mut"
    " m, info);\n        array<u8, 1> c = [counter];\n        Hmac::update(&mut m, &c[0..$]);\n        overw"
    "rite(&mut t, Hmac::finish(m));\n        for (usize i = 0; i < h && Vec::len(&out) < len; i += 1)\n    "
    "    {\n            Vec::push(&mut out, t[i]);\n        }\n        if (Vec::len(&out) < len)\n        {\n "
    "           counter += 1;\n        }\n    }\n    out\n}export fn hkdf_with(\n    HashKind kind,\n    slice<"
    "u8, shared> salt,\n    slice<u8, shared> ikm,\n    slice<u8, shared> info,\n    usize len,\n) : Vec<u8>\n"
    "{\n    Vec<u8> prk = hkdf_extract_with(kind, salt, ikm);\n    hkdf_expand_with(kind, &prk[0..$], info,"
    " len)\n}export fn hkdf_expand_label_with(\n    HashKind kind,\n    slice<u8, shared> secret,\n    String"
    "View label,\n    slice<u8, shared> context,\n    usize len,\n) : Vec<u8>\n{\n    // Over 65535 is over 25"
    "5 blocks of every hash: `hkdf_length`, as\n    // `hkdf_expand` would say, not the narrowing below.\n "
    "   if (len > 65_535)\n    {\n        fault(hkdf_length);\n    }\n    Vec<u8> info = Vec::new();\n    Vec:"
    ":push_be(&mut info, narrow<u16>(len));\n    Vec::push(&mut info, narrow<u8>(6 + StringView::len(label"
    ")));\n    Vec::extend_from(&mut info, &b\"tls13 \"[0..$]);\n    Vec::extend_from(&mut info, label.bytes)"
    ";\n    Vec::push(&mut info, narrow<u8>(slice_len(context)));\n    Vec::extend_from(&mut info, context)"
    ";\n    hkdf_expand_with(kind, secret, &info[0..$], len)\n}export fn pbkdf2(\n    HashKind kind,\n    sli"
    "ce<u8, shared> password,\n    slice<u8, shared> salt,\n    usize iterations,\n    usize len,\n) : Vec<u8"
    ">\n{\n    if (iterations == 0)\n    {\n        fault(kdf_parameters);\n    }\n    if (match (kind) { Sha2_"
    "256 : true, _ : false })\n    {\n        return pbkdf2_sha256(password, salt, iterations, len);\n    }\n"
    "    Hmac base = Hmac::new(kind, password);\n    Vec<u8> out = Vec::new();\n    u32 block = 1;\n    whil"
    "e (Vec::len(&out) < len)\n    {\n        Hmac first = base;\n        Hmac::update(&mut first, salt);\n  "
    "      Vec<u8> counter = Vec::new();\n        Vec::push_be(&mut counter, block);\n        Hmac::update("
    "&mut first, &counter[0..$]);\n        Vec<u8> u = Hmac::finish(first);\n        Vec<u8> t = Vec::clone"
    "(&u);\n        for (usize j = 1; j < iterations; j += 1)\n        {\n            Hmac m = base;\n       "
    "     Hmac::update(&mut m, &u[0..$]);\n            overwrite(&mut u, Hmac::finish(m));\n            for"
    " (usize i = 0; i < Vec::len(&t); i += 1)\n            {\n                t[i] = t[i] ^ u[i];\n         "
    "   }\n        }\n        for (usize i = 0; i < Vec::len(&t) && Vec::len(&out) < len; i += 1)\n        {"
    "\n            Vec::push(&mut out, t[i]);\n        }\n        block += 1;\n    }\n    out\n}unittest \"pbkdf"
    "2: an RFC 6070 vector\"\n{\n    Vec<u8> dk = pbkdf2(Sha1, &b\"password\"[0..$], &b\"salt\"[0..$], 2, 20);\n "
    "   assert(to_hex(&dk[0..$]) == \"ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957\");\n}fn pbkdf2_sha256(slice<"
    "u8, shared> password, slice<u8, shared> salt, usize iterations, usize len) : Vec<u8>\n{\n    HmacSha25"
    "6 base = HmacSha256::new(password);\n    Vec<u8> out = Vec::new();\n    u32 block = 1;\n    while (Vec:"
    ":len(&out) < len)\n    {\n        HmacSha256 first = base;\n        HmacSha256::update(&mut first, salt"
    ");\n        array<u8, 4> counter = [\n            narrow_wrapping<u8>(block >> 24),\n            narrow"
    "_wrapping<u8>(block >> 16),\n            narrow_wrapping<u8>(block >> 8),\n            narrow_wrapping"
    "<u8>(block),\n        ];\n        HmacSha256::update(&mut first, &counter[0..$]);\n        array<u8, 32"
    "> u = HmacSha256::finish(first);\n        array<u8, 32> t = u;\n        for (usize j = 1; j < iteratio"
    "ns; j += 1)\n        {\n            HmacSha256 m = base;\n            HmacSha256::update(&mut m, &u[0.."
    "$]);\n            u = HmacSha256::finish(m);\n            for (usize i = 0; i < 32; i += 1)\n          "
    "  {\n                t[i] = t[i] ^ u[i];\n            }\n        }\n        for (usize i = 0; i < 32 && "
    "Vec::len(&out) < len; i += 1)\n        {\n            Vec::push(&mut out, t[i]);\n        }\n        blo"
    "ck += 1;\n    }\n    out\n}fn argon2_h_prime(usize out_len, slice<u8, shared> x) : Vec<u8>\n{\n    Vec<u8"
    "> prefix = Vec::new();\n    Vec::push_le(&mut prefix, narrow<u32>(out_len));\n    if (out_len <= 64)\n "
    "   {\n        Blake2b b = Blake2b::new(out_len);\n        Blake2b::update(&mut b, &prefix[0..$]);\n    "
    "    Blake2b::update(&mut b, x);\n        return Blake2b::finish(b);\n    }\n    usize r = (out_len + 31"
    ") / 32 - 2;\n    Blake2b b = Blake2b::new(64);\n    Blake2b::update(&mut b, &prefix[0..$]);\n    Blake2"
    "b::update(&mut b, x);\n    Vec<u8> v = Blake2b::finish(b);\n    Vec<u8> out = Vec::from_slice(&v[0..32"
    "]);\n    for (usize i = 1; i < r; i += 1)\n    {\n        overwrite(&mut v, blake2b(&v[0..$], 64));\n   "
    "     Vec::extend_from(&mut out, &v[0..32]);\n    }\n    Vec<u8> last = blake2b(&v[0..$], out_len - 32 "
    "* r);\n    Vec::extend_from(&mut out, &last[0..$]);\n    out\n}fn argon2_p(array<u64, 16> v) : array<u6"
    "4, 16>\n{\n    u64 lo = 0xffffffff;\n    for (usize g = 0; g < 8; g += 1)\n    {\n        usize a = widen"
    "<usize>(BLAKE2B_G[4 * g]);\n        usize b = widen<usize>(BLAKE2B_G[4 * g + 1]);\n        usize c = w"
    "iden<usize>(BLAKE2B_G[4 * g + 2]);\n        usize d = widen<usize>(BLAKE2B_G[4 * g + 3]);\n        v[a"
    "] = wrapping_add(wrapping_add(v[a], v[b]), wrapping_mul(2, (v[a] & lo) * (v[b] & lo)));\n        v[d]"
    " = rotate_right(v[d] ^ v[a], 32);\n        v[c] = wrapping_add(wrapping_add(v[c], v[d]), wrapping_mul"
    "(2, (v[c] & lo) * (v[d] & lo)));\n        v[b] = rotate_right(v[b] ^ v[c], 24);\n        v[a] = wrappi"
    "ng_add(wrapping_add(v[a], v[b]), wrapping_mul(2, (v[a] & lo) * (v[b] & lo)));\n        v[d] = rotate_"
    "right(v[d] ^ v[a], 16);\n        v[c] = wrapping_add(wrapping_add(v[c], v[d]), wrapping_mul(2, (v[c] "
    "& lo) * (v[d] & lo)));\n        v[b] = rotate_right(v[b] ^ v[c], 63);\n    }\n    v\n}fn argon2_g(array<"
    "u64, 128> x, array<u64, 128> y) : array<u64, 128>\n{\n    array<u64, 128> r = [0; 128];\n    for (usize"
    " i = 0; i < 128; i += 1)\n    {\n        r[i] = x[i] ^ y[i];\n    }\n    array<u64, 128> q = r;\n    for "
    "(usize row = 0; row < 8; row += 1)\n    {\n        array<u64, 16> v = [0; 16];\n        for (usize i = "
    "0; i < 16; i += 1)\n        {\n            v[i] = q[16 * row + i];\n        }\n        v = argon2_p(v);\n"
    "        for (usize i = 0; i < 16; i += 1)\n        {\n            q[16 * row + i] = v[i];\n        }\n  "
    "  }\n    for (usize col = 0; col < 8; col += 1)\n    {\n        array<u64, 16> v = [0; 16];\n        for"
    " (usize j = 0; j < 8; j += 1)\n        {\n            v[2 * j] = q[16 * j + 2 * col];\n            v[2 "
    "* j + 1] = q[16 * j + 2 * col + 1];\n        }\n        v = argon2_p(v);\n        for (usize j = 0; j <"
    " 8; j += 1)\n        {\n            q[16 * j + 2 * col] = v[2 * j];\n            q[16 * j + 2 * col + 1"
    "] = v[2 * j + 1];\n        }\n    }\n    for (usize i = 0; i < 128; i += 1)\n    {\n        q[i] = q[i] ^"
    " r[i];\n    }\n    q\n}fn argon2_get(slice<u64, shared> b) : array<u64, 128>\n{\n    array<u64, 128> out "
    "= [0; 128];\n    for (usize i = 0; i < 128; i += 1)\n    {\n        out[i] = b[i];\n    }\n    out\n}fn ar"
    "gon2_put(slice<u64, exclusive> b, array<u64, 128> v, bool xor)\n{\n    for (usize i = 0; i < 128; i +="
    " 1)\n    {\n        b[i] = if (xor) { b[i] ^ v[i] } else { v[i] };\n    }\n}fn argon2_load(ref<Vec<u64>,"
    " shared> mem, usize block) : array<u64, 128>\n{\n    argon2_get(&mem[128 * block..128 * block + 128])\n"
    "}export fn argon2id(\n    slice<u8, shared> password,\n    slice<u8, shared> salt,\n    usize iteration"
    "s,\n    usize memory_kib,\n    usize parallelism,\n    usize len,\n) : Vec<u8>\n{\n    if (iterations == 0"
    " || parallelism == 0 || parallelism > 255 || memory_kib < 8 * parallelism || len < 4 || slice_len(sa"
    "lt) < 8)\n    {\n        fault(kdf_parameters);\n    }\n    usize lanes = parallelism;\n    usize q = (me"
    "mory_kib / (4 * lanes)) * 4;\n    usize m_prime = q * lanes;\n    usize seg = q / 4;\n    // H0 (§3.2)"
    ".\n    Blake2b h = Blake2b::new(64);\n    Vec<u8> head = Vec::new();\n    Vec::push_le(&mut head, narro"
    "w<u32>(lanes));\n    Vec::push_le(&mut head, narrow<u32>(len));\n    Vec::push_le(&mut head, narrow<u3"
    "2>(memory_kib));\n    Vec::push_le(&mut head, narrow<u32>(iterations));\n    Vec::push_le(&mut head, 0"
    "x13: u32);\n    Vec::push_le(&mut head, 2: u32);\n    Vec::push_le(&mut head, narrow<u32>(slice_len(pa"
    "ssword)));\n    Blake2b::update(&mut h, &head[0..$]);\n    Blake2b::update(&mut h, password);\n    Vec<"
    "u8> mid = Vec::new();\n    Vec::push_le(&mut mid, narrow<u32>(slice_len(salt)));\n    Blake2b::update("
    "&mut h, &mid[0..$]);\n    Blake2b::update(&mut h, salt);\n    array<u8, 8> none = [0; 8];\n    Blake2b:"
    ":update(&mut h, &none[0..$]);\n    Vec<u8> h0 = Blake2b::finish(h);\n    Vec<u64> mem = Vec::filled(12"
    "8 * m_prime, 0: u64);\n    for (usize l = 0; l < lanes; l += 1)\n    {\n        for (usize col = 0; col"
    " < 2; col += 1)\n        {\n            Vec<u8> input = Vec::clone(&h0);\n            Vec::push_le(&mut"
    " input, narrow<u32>(col));\n            Vec::push_le(&mut input, narrow<u32>(l));\n            Vec<u8>"
    " block = argon2_h_prime(1024, &input[0..$]);\n            for (usize i = 0; i < 128; i += 1)\n        "
    "    {\n                mem[128 * (l * q + col) + i] = read_le<u64>(&block[0..$], 8 * i);\n            "
    "}\n        }\n    }\n    array<u64, 128> zero = [0; 128];\n    for (usize r = 0; r < iterations; r += 1)"
    "\n    {\n        for (usize s = 0; s < 4; s += 1)\n        {\n            for (usize l = 0; l < lanes; l"
    " += 1)\n            {\n                bool independent = r == 0 && s < 2;\n                array<u64, "
    "128> addresses = [0; 128];\n                array<u64, 128> input = [0; 128];\n                input[0"
    "] = widen<u64>(r);\n                input[1] = widen<u64>(l);\n                input[2] = widen<u64>(s"
    ");\n                input[3] = widen<u64>(m_prime);\n                input[4] = widen<u64>(iterations)"
    ";\n                input[5] = 2;\n                usize start_i = if (r == 0 && s == 0) { 2 } else { 0"
    " };\n                for (usize i = start_i; i < seg; i += 1)\n                {\n                    u"
    "size j = s * seg + i;\n                    usize prev = if (j == 0) { q - 1 } else { j - 1 };\n       "
    "             u64 pseudo = 0;\n                    if (independent)\n                    {\n            "
    "            if (i % 128 == 0 || i == start_i)\n                        {\n                            "
    "input[6] = widen<u64>(i / 128 + 1);\n                            addresses = argon2_g(zero, argon2_g("
    "zero, input));\n                        }\n                        pseudo = addresses[i % 128];\n      "
    "              }\n                    else\n                    {\n                        pseudo = mem["
    "128 * (l * q + prev)];\n                    }\n                    u64 j1 = pseudo & 0xffffffff;\n     "
    "               u64 j2 = pseudo >> 32;\n                    usize ref_lane = if (r == 0 && s == 0) { l"
    " } else { narrow<usize>(j2 % widen<u64>(lanes)) };\n                    usize w = 0;\n                "
    "    if (r == 0)\n                    {\n                        w = if (ref_lane == l) { s * seg + i -"
    " 1 } else { s * seg - (if (i == 0) { 1 } else { 0 }) };\n                    }\n                    el"
    "se\n                    {\n                        w = if (ref_lane == l) { q - seg + i - 1 } else { q"
    " - seg - (if (i == 0) { 1 } else { 0 }) };\n                    }\n                    u64 x = (j1 * j"
    "1) >> 32;\n                    u64 y = narrow<u64>((widen<u128>(w) * widen<u128>(x)) >> 32);\n        "
    "            usize z = w - 1 - narrow<usize>(y);\n                    usize start = if (r == 0) { 0 } "
    "else { ((s + 1) % 4) * seg };\n                    usize ref_col = (start + z) % q;\n                 "
    "   array<u64, 128> fresh = argon2_g(\n                        argon2_load(&mem, l * q + prev),\n      "
    "                  argon2_load(&mem, ref_lane * q + ref_col),\n                    );\n                "
    "    usize at = 128 * (l * q + j);\n                    argon2_put(&mut mem[at..at + 128], fresh, r > "
    "0);\n                }\n            }\n        }\n    }\n    array<u64, 128> c = [0; 128];\n    for (usize"
    " l = 0; l < lanes; l += 1)\n    {\n        for (usize k = 0; k < 128; k += 1)\n        {\n            c["
    "k] = c[k] ^ mem[128 * (l * q + q - 1) + k];\n        }\n    }\n    Vec<u8> c_bytes = Vec::new();\n    fo"
    "r (usize k = 0; k < 128; k += 1)\n    {\n        Vec::push_le(&mut c_bytes, c[k]);\n    }\n    argon2_h_"
    "prime(len, &c_bytes[0..$])\n}fn b64_unpadded(slice<u8, shared> bytes) : String\n{\n    String s = base6"
    "4_encode(bytes);\n    usize n = StringView::len(&s);\n    while (n > 0 && String::as_bytes(&s)[n - 1] "
    "== 0x3d)\n    {\n        n -= 1;\n    }\n    String::truncate(&mut s, n);\n    s\n}fn b64_decode_unpadded("
    "StringView text) : Option<Vec<u8>>\n{\n    String padded = String::from_view(text);\n    while (StringV"
    "iew::len(&padded) % 4 != 0)\n    {\n        String::push_ascii(&mut padded, 0x3d);\n    }\n    match (ba"
    "se64_decode(&padded))\n    {\n        Ok(v)  : Some(v),\n        Err(_) : None,\n    }\n}export fn hash_p"
    "assword(slice<u8, shared> password) : String\n{\n    array<u8, 16> salt = [0; 16];\n    os_random_bytes"
    "(&mut salt[0..$]);\n    Vec<u8> digest = argon2id(password, &salt[0..$], 2, 19456, 1, 32);\n    String"
    " out = \"$argon2id$v=19$m=19456,t=2,p=1$\";\n    String::append(&mut out, &b64_unpadded(&salt[0..$]));\n"
    "    String::append(&mut out, \"$\");\n    String::append(&mut out, &b64_unpadded(&digest[0..$]));\n    o"
    "ut\n}export fn verify_password(StringView stored, slice<u8, shared> password) : bool\n{\n    Vec<String"
    "View> parts = StringView::split(stored, \"$\");\n    if (Vec::len(&parts) != 6 || StringView::len(parts"
    "[0]) != 0 || !StringView::eq(\n        parts[1],\n        \"argon2id\",\n    ) || !StringView::eq(parts[2"
    "], \"v=19\"))\n    {\n        return false;\n    }\n    Vec<StringView> params = StringView::split(parts[3"
    "], \",\");\n    if (Vec::len(&params) != 3 || !StringView::starts_with(\n        params[0],\n        \"m=\""
    ",\n    ) || !StringView::starts_with(params[1], \"t=\") || !StringView::starts_with(params[2], \"p=\"))\n "
    "   {\n        return false;\n    }\n    usize m = match (StringView::parse<usize>(&params[0][2..$]))\n  "
    "  {\n        Ok(v)  : v,\n        Err(_) : return false,\n    };\n    usize t = match (StringView::parse"
    "<usize>(&params[1][2..$]))\n    {\n        Ok(v)  : v,\n        Err(_) : return false,\n    };\n    usize"
    " p = match (StringView::parse<usize>(&params[2][2..$]))\n    {\n        Ok(v)  : v,\n        Err(_) : r"
    "eturn false,\n    };\n    Vec<u8> salt = match (b64_decode_unpadded(parts[4]))\n    {\n        Some(v) :"
    " v,\n        None    : return false,\n    };\n    Vec<u8> want = match (b64_decode_unpadded(parts[5]))\n"
    "    {\n        Some(v) : v,\n        None    : return false,\n    };\n    if (t == 0 || p == 0 || p > 25"
    "5 || m < 8 * p || Vec::len(&want) < 4 || Vec::len(&salt) < 8)\n    {\n        return false;\n    }\n    "
    "Vec<u8> got = argon2id(password, &salt[0..$], t, m, p, Vec::len(&want));\n    digest_eq(&got[0..$], &"
    "want[0..$])\n}unittest \"verify_password: what is not a hash is false\"\n{\n    assert(!verify_password(\""
    "not a password hash\", &b\"secret\"[0..$]));\n    StringView no_memory = \"$argon2id$v=19$m=0,t=1,p=1$c2F"
    "sdHNhbHQ$AAAAAA\";\n    assert(!verify_password(no_memory, &b\"secret\"[0..$]));\n}fn crypto_check_length"
    "s(slice<u8, shared> key, slice<u8, shared> nonce)\n{\n    if (slice_len(key) != 32 || slice_len(nonce)"
    " != 12)\n    {\n        fault(crypto_length);\n    }\n}fn chacha_quarter(ref<array<u32, 16>, exclusive> "
    "x, usize a, usize b, usize c, usize d)\n{\n    x[a] = wrapping_add(x[a], x[b]);\n    x[d] = rotate_left"
    "(x[d] ^ x[a], 16);\n    x[c] = wrapping_add(x[c], x[d]);\n    x[b] = rotate_left(x[b] ^ x[c], 12);\n   "
    " x[a] = wrapping_add(x[a], x[b]);\n    x[d] = rotate_left(x[d] ^ x[a], 8);\n    x[c] = wrapping_add(x["
    "c], x[d]);\n    x[b] = rotate_left(x[b] ^ x[c], 7);\n}fn chacha_block(slice<u8, shared> key, slice<u8,"
    " shared> nonce, u32 counter) : array<u8, 64>\n{\n    array<u32, 16> s = [0; 16];\n    s[0] = 0x61707865"
    ";\n    s[1] = 0x3320646e;\n    s[2] = 0x79622d32;\n    s[3] = 0x6b206574;\n    for (usize i = 0; i < 8; "
    "i += 1)\n    {\n        s[4 + i] = read_le<u32>(key, 4 * i);\n    }\n    s[12] = counter;\n    for (usize"
    " i = 0; i < 3; i += 1)\n    {\n        s[13 + i] = read_le<u32>(nonce, 4 * i);\n    }\n    array<u32, 16"
    "> x = s;\n    for (usize round = 0; round < 10; round += 1)\n    {\n        chacha_quarter(&mut x, 0, 4"
    ", 8, 12);\n        chacha_quarter(&mut x, 1, 5, 9, 13);\n        chacha_quarter(&mut x, 2, 6, 10, 14);"
    "\n        chacha_quarter(&mut x, 3, 7, 11, 15);\n        chacha_quarter(&mut x, 0, 5, 10, 15);\n       "
    " chacha_quarter(&mut x, 1, 6, 11, 12);\n        chacha_quarter(&mut x, 2, 7, 8, 13);\n        chacha_q"
    "uarter(&mut x, 3, 4, 9, 14);\n    }\n    array<u8, 64> out = [0; 64];\n    for (usize i = 0; i < 16; i "
    "+= 1)\n    {\n        u32 w = wrapping_add(x[i], s[i]);\n        out[4 * i] = narrow_wrapping<u8>(w);\n "
    "       out[4 * i + 1] = narrow_wrapping<u8>(w >> 8);\n        out[4 * i + 2] = narrow_wrapping<u8>(w "
    ">> 16);\n        out[4 * i + 3] = narrow_wrapping<u8>(w >> 24);\n    }\n    out\n}export fn chacha20(sli"
    "ce<u8, shared> key, slice<u8, shared> nonce, u32 counter, slice<u8, shared> data) : Vec<u8>\n{\n    cr"
    "ypto_check_lengths(key, nonce);\n    usize n = slice_len(data);\n    if (widen<u64>(n) > (widen<u64>(m"
    "ax_value<u32>()) - widen<u64>(counter) + 1) * 64)\n    {\n        fault(crypto_length);\n    }\n    Vec<"
    "u8> out = Vec::new();\n    Vec::reserve(&mut out, n);\n    u32 block = counter;\n    usize at = 0;\n    "
    "while (at < n)\n    {\n        array<u8, 64> ks = chacha_block(key, nonce, block);\n        usize take "
    "= min(64, n - at);\n        for (usize i = 0; i < take; i += 1)\n        {\n            Vec::push(&mut "
    "out, data[at + i] ^ ks[i]);\n        }\n        at += take;\n        if (at < n)\n        {\n            "
    "block += 1;\n        }\n    }\n    out\n}unittest \"chacha20: the same operation decrypts\"\n{\n    array<u8"
    ", 32> key = [9; 32];\n    array<u8, 12> nonce = [0; 12];\n    Vec<u8> hidden = chacha20(&key[0..$], &n"
    "once[0..$], 1, &b\"attack at dawn\"[0..$]);\n    Vec<u8> back = chacha20(&key[0..$], &nonce[0..$], 1, &"
    "hidden[0..$]);\n    assert(slice_eq(&back[0..$], &b\"attack at dawn\"[0..$]));\n}fn Poly1305::new(slice<"
    "u8, shared> key) : Poly1305\n{\n    u64 m26 = 0x3ffffff;\n    array<u64, 5> r = [0; 5];\n    r[0] = wide"
    "n<u64>(read_le<u32>(key, 0)) & m26;\n    r[1] = (widen<u64>(read_le<u32>(key, 3)) >> 2) & 0x3ffff03;\n"
    "    r[2] = (widen<u64>(read_le<u32>(key, 6)) >> 4) & 0x3ffc0ff;\n    r[3] = (widen<u64>(read_le<u32>("
    "key, 9)) >> 6) & 0x3f03fff;\n    r[4] = (widen<u64>(read_le<u32>(key, 12)) >> 8) & 0x00fffff;\n    arr"
    "ay<u64, 4> pad = [0; 4];\n    for (usize i = 0; i < 4; i += 1)\n    {\n        pad[i] = widen<u64>(read"
    "_le<u32>(key, 16 + 4 * i));\n    }\n    Poly1305 { .h = [0; 5], .r = r, .pad = pad }\n}fn Poly1305::blo"
    "ck(ref<Poly1305, exclusive> p, slice<u8, shared> m, u64 hibit)\n{\n    p.h = poly1305_blocks(p.h, p.r,"
    " m, hibit);\n}fn poly1305_blocks(array<u64, 5> h, array<u64, 5> r, slice<u8, shared> m, u64 hibit) : "
    "array<u64, 5>\n{\n    u64 m26 = 0x3ffffff;\n    u64 r0 = r[0];\n    u64 r1 = r[1];\n    u64 r2 = r[2];\n  "
    "  u64 r3 = r[3];\n    u64 r4 = r[4];\n    u64 s1 = r1 * 5;\n    u64 s2 = r2 * 5;\n    u64 s3 = r3 * 5;\n "
    "   u64 s4 = r4 * 5;\n    u64 h0 = h[0];\n    u64 h1 = h[1];\n    u64 h2 = h[2];\n    u64 h3 = h[3];\n    "
    "u64 h4 = h[4];\n    for (usize at = 0; at + 16 <= slice_len(m); at += 16)\n    {\n        // The little"
    "-endian words at 0, 3, 6, 9 and 12.\n        array<u64, 5> t = [0; 5];\n        for (usize k = 0; k < "
    "5; k += 1)\n        {\n            usize o = at + 3 * k;\n            t[k] = widen<u64>(m[o]) | (widen<"
    "u64>(m[o + 1]) << 8) | (widen<u64>(m[o + 2]) << 16) | (widen<u64>(m[o + 3]) << 24);\n        }\n      "
    "  h0 += t[0] & m26;\n        h1 += (t[1] >> 2) & m26;\n        h2 += (t[2] >> 4) & m26;\n        h3 += "
    "(t[3] >> 6) & m26;\n        h4 += (t[4] >> 8) | hibit;\n        u64 d0 = h0 * r0 + h1 * s4 + h2 * s3 +"
    " h3 * s2 + h4 * s1;\n        u64 d1 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2;\n        u64 d2"
    " = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3;\n        u64 d3 = h0 * r3 + h1 * r2 + h2 * r1 + h"
    "3 * r0 + h4 * s4;\n        u64 d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0;\n        u64 c = "
    "d0 >> 26;\n        h0 = d0 & m26;\n        d1 += c;\n        c = d1 >> 26;\n        h1 = d1 & m26;\n     "
    "   d2 += c;\n        c = d2 >> 26;\n        h2 = d2 & m26;\n        d3 += c;\n        c = d3 >> 26;\n    "
    "    h3 = d3 & m26;\n        d4 += c;\n        c = d4 >> 26;\n        h4 = d4 & m26;\n        h0 += c * 5"
    ";\n        c = h0 >> 26;\n        h0 = h0 & m26;\n        h1 += c;\n    }\n    [h0, h1, h2, h3, h4]\n}fn P"
    "oly1305::update_padded(ref<Poly1305, exclusive> p, slice<u8, shared> data)\n{\n    usize n = slice_len"
    "(data);\n    usize at = n - n % 16;\n    if (at > 0)\n    {\n        Poly1305::block(p, &data[0..at], 1 "
    "<< 24);\n    }\n    if (at < n)\n    {\n        array<u8, 16> last = [0; 16];\n        for (usize i = 0; "
    "at + i < n; i += 1)\n        {\n            last[i] = data[at + i];\n        }\n        Poly1305::block("
    "p, &last[0..$], 1 << 24);\n    }\n}fn Poly1305::update_last(ref<Poly1305, exclusive> p, slice<u8, shar"
    "ed> data)\n{\n    usize n = slice_len(data);\n    usize at = 0;\n    while (at + 16 <= n)\n    {\n        "
    "Poly1305::block(p, &data[at..at + 16], 1 << 24);\n        at += 16;\n    }\n    if (at < n)\n    {\n     "
    "   array<u8, 16> last = [0; 16];\n        for (usize i = 0; at + i < n; i += 1)\n        {\n           "
    " last[i] = data[at + i];\n        }\n        last[n - at] = 1;\n        Poly1305::block(p, &last[0..$],"
    " 0);\n    }\n}fn Poly1305::finish(Poly1305 p) : array<u8, 16>\n{\n    u64 m26 = 0x3ffffff;\n    u64 h0 = "
    "p.h[0];\n    u64 h1 = p.h[1];\n    u64 h2 = p.h[2];\n    u64 h3 = p.h[3];\n    u64 h4 = p.h[4];\n    u64 "
    "c = h1 >> 26;\n    h1 = h1 & m26;\n    h2 += c;\n    c = h2 >> 26;\n    h2 = h2 & m26;\n    h3 += c;\n    "
    "c = h3 >> 26;\n    h3 = h3 & m26;\n    h4 += c;\n    c = h4 >> 26;\n    h4 = h4 & m26;\n    h0 += c * 5;\n"
    "    c = h0 >> 26;\n    h0 = h0 & m26;\n    h1 += c;\n    // g = h + 5 - 2^130; it is chosen when it doe"
    "s not go below zero.\n    u64 g0 = h0 + 5;\n    c = g0 >> 26;\n    g0 = g0 & m26;\n    u64 g1 = h1 + c;\n"
    "    c = g1 >> 26;\n    g1 = g1 & m26;\n    u64 g2 = h2 + c;\n    c = g2 >> 26;\n    g2 = g2 & m26;\n    u"
    "64 g3 = h3 + c;\n    c = g3 >> 26;\n    g3 = g3 & m26;\n    u64 g4 = wrapping_sub(h4 + c, 0x4000000);\n "
    "   u64 take_g = wrapping_sub(g4 >> 63, 1);\n    u64 take_h = ~take_g;\n    h0 = (h0 & take_h) | (g0 & "
    "take_g);\n    h1 = (h1 & take_h) | (g1 & take_g);\n    h2 = (h2 & take_h) | (g2 & take_g);\n    h3 = (h"
    "3 & take_h) | (g3 & take_g);\n    h4 = (h4 & take_h) | (g4 & take_g);\n    u64 m32 = 0xffffffff;\n    u"
    "64 w0 = (h0 | (h1 << 26)) & m32;\n    u64 w1 = ((h1 >> 6) | (h2 << 20)) & m32;\n    u64 w2 = ((h2 >> 1"
    "2) | (h3 << 14)) & m32;\n    u64 w3 = ((h3 >> 18) | (h4 << 8)) & m32;\n    u64 f = w0 + p.pad[0];\n    "
    "w0 = f & m32;\n    f = w1 + p.pad[1] + (f >> 32);\n    w1 = f & m32;\n    f = w2 + p.pad[2] + (f >> 32)"
    ";\n    w2 = f & m32;\n    f = w3 + p.pad[3] + (f >> 32);\n    w3 = f & m32;\n    array<u64, 4> w = [w0, "
    "w1, w2, w3];\n    array<u8, 16> tag = [0; 16];\n    for (usize i = 0; i < 4; i += 1)\n    {\n        tag"
    "[4 * i] = narrow_wrapping<u8>(w[i]);\n        tag[4 * i + 1] = narrow_wrapping<u8>(w[i] >> 8);\n      "
    "  tag[4 * i + 2] = narrow_wrapping<u8>(w[i] >> 16);\n        tag[4 * i + 3] = narrow_wrapping<u8>(w[i"
    "] >> 24);\n    }\n    tag\n}export fn poly1305(slice<u8, shared> key, slice<u8, shared> message) : arra"
    "y<u8, 16>\n{\n    if (slice_len(key) != 32)\n    {\n        fault(crypto_length);\n    }\n    Poly1305 p ="
    " Poly1305::new(key);\n    Poly1305::update_last(&mut p, message);\n    Poly1305::finish(p)\n}unittest \""
    "poly1305: the RFC 8439 vector\"\n{\n    StringView k = \"85d6be7857556d337f4452fe42d506a80103808afb0db2f"
    "d4abff6af4149f51b\";\n    Vec<u8> key = Result::unwrap(from_hex(k));\n    array<u8, 16> tag = poly1305("
    "&key[0..$], &b\"Cryptographic Forum Research Group\"[0..$]);\n    assert(to_hex(&tag[0..$]) == \"a8061dc"
    "1305136c6c22b8baf0c0127a9\");\n}fn aead_tag(\n    slice<u8, shared> key,\n    slice<u8, shared> nonce,\n "
    "   slice<u8, shared> aad,\n    slice<u8, shared> ciphertext,\n) : array<u8, 16>\n{\n    array<u8, 64> bl"
    "ock0 = chacha_block(key, nonce, 0);\n    Poly1305 p = Poly1305::new(&block0[0..32]);\n    Poly1305::up"
    "date_padded(&mut p, aad);\n    Poly1305::update_padded(&mut p, ciphertext);\n    Vec<u8> lengths = Vec"
