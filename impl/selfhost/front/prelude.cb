    "c::len(&d) == 48);\n    assert(digest_eq(&d[0..$], &hash(Sha2_384, &b\"abc\"[0..$])[0..$]));\n}export fn"
    " Hasher::new(HashKind kind) : Hasher\n{\n    Hasher { .kind = kind, .s1 = Sha1::new(), .s256 = Sha256:"
