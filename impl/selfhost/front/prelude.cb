    "())\n    {\n        return None;\n    }\n    usize last = Vec::len(&m.keys) - 1;\n    if (e != last)\n    "
    "{\n        // The last entry's slot names e from now on.\n        usize t = HashMap::find(&*m, Vec::in"
    "dex_shared(&m.keys, last));\n        *Vec::index_exclusive(&mut m.slots, t) = e;\n    }\n    auto k_las"
    "t = Vec::remove_at(&mut m.keys, last);\n    auto v_last = Vec::remove_at(&mut m.values, last);\n    au"
    "to v = if (e != last)\n    {\n        drop(Vec::replace(&mut m.keys, e, k_last));\n        Vec::replace"
    "(&mut m.values, e, v_last)\n    }\n    else\n    {\n        drop(k_last);\n        v_last\n    };\n    Hash"
    "Map::unslot(m, s);\n    Some(v)\n}export fn HashMap::remove<K, V>(ref<HashMap<K, V>, exclusive> m, ref"
    "<K, shared> k) : Option<V>\n{\n    usize s = HashMap::find(&*m, k);\n    HashMap::remove_slot(m, s)\n}fn"
    " HashMap::remove_slot<K, V>(ref<HashMap<K, V>, exclusive> m, usize s) : Option<V>\n{\n    usize e = *V"
    "ec::index_shared(&m.slots, s);\n    if (e == max_value<usize>())\n    {\n        return None;\n    }\n   "
    " HashMap::unslot(m, s);\n    drop(Vec::remove_at(&mut m.keys, e));\n    auto v = Vec::remove_at(&mut m"
    ".values, e);\n    // Entries after e moved down by one.\n    usize i = 0;\n    while (i < Vec::len(&m.s"
    "lots))\n    {\n        usize x = *Vec::index_shared(&m.slots, i);\n        if (x != max_value<usize>() "
    "&& x > e)\n        {\n            *Vec::index_exclusive(&mut m.slots, i) = x - 1;\n        }\n        i "
    "= i + 1;\n    }\n    Some(v)\n}fn HashMap::find_str<V>(ref<HashMap<String, V>, shared> m, str k) : usiz"
    "e\n{\n    usize mask = Vec::len(&m.slots) - 1;\n    usize i = narrow_wrapping<usize>(key_hash(&k)) & ma"
    "sk;\n    bool searching = true;\n    while (searching)\n    {\n        usize e = *Vec::index_shared(&m.s"
    "lots, i);\n        if (e == max_value<usize>())\n        {\n            searching = false;\n        }\n  "
    "      else if (String::eq_str(Vec::index_shared(&m.keys, e), k))\n        {\n            searching = f"
    "alse;\n        }\n        else\n        {\n            i = (i + 1) & mask;\n        }\n    }\n    i\n}export"
    " fn HashMap::get_str<V>(ref<HashMap<String, V>, shared> m, str k) : Option<ref<V, shared>>\n{\n    usi"
    "ze e = *Vec::index_shared(&m.slots, HashMap::find_str(m, k));\n    if (e == max_value<usize>())\n    {"
