    "    }\n    }\n    i\n}fn HashMap::seek<K, V>(ref<HashMap<K, V>, shared> m, probe<K> k) : usize\n{\n    us"
    "ize mask = Vec::len(&m.slots) - 1;\n    usize i = narrow_wrapping<usize>(key_hash(k)) & mask;\n    boo"
    "l searching = true;\n    while (searching)\n    {\n        usize e = *Vec::index_shared(&m.slots, i);\n "
    "       if (e == max_value<usize>())\n        {\n            searching = false;\n        }\n        else "
    "if (key_eq(Vec::index_shared(&m.keys, e), k))\n        {\n            searching = false;\n        }\n   "
    "     else\n        {\n            i = (i + 1) & mask;\n        }\n    }\n    i\n}fn HashMap::index_of<K, V"
    ">(ref<HashMap<K, V>, shared> m, probe<K> k) : usize\n{\n    *Vec::index_shared(&m.slots, HashMap::seek"
    "(m, k))\n}fn HashMap::has_key<K, V>(ref<HashMap<K, V>, shared> m, ref<K, shared> k) : bool\n{\n    *Vec"
    "::index_shared(&m.slots, HashMap::find(m, k)) != max_value<usize>()\n}fn HashMap::reslot<K, V>(ref<Ha"
    "shMap<K, V>, exclusive> m, usize n)\n{\n    usize old = Vec::len(&m.slots);\n    usize i = 0;\n    while"
    " (i < n)\n    {\n        if (i < old)\n        {\n            *Vec::index_exclusive(&mut m.slots, i) = m"
    "ax_value<usize>();\n        }\n        else\n        {\n            Vec::push(&mut m.slots, max_value<us"
    "ize>());\n        }\n        i = i + 1;\n    }\n    usize e = 0;\n    while (e < Vec::len(&m.keys))\n    {"
    "\n        usize s = HashMap::find(&*m, Vec::index_shared(&m.keys, e));\n        *Vec::index_exclusive("
    "&mut m.slots, s) = e;\n        e = e + 1;\n    }\n}fn HashMap::reserve_one<K, V>(ref<HashMap<K, V>, exc"
    "lusive> m)\n{\n    usize n = Vec::len(&m.slots);\n    if ((Vec::len(&m.keys) + 1) * 4 > n * 3)\n    {\n  "
    "      HashMap::reslot(m, n * 2);\n    }\n}export fn HashMap::insert<K, V>(ref<HashMap<K, V>, exclusive"
    "> m, K k, V v) : Option<V>\n{\n    HashMap::reserve_one(m);\n    usize s = HashMap::find(&*m, &k);\n    "
    "usize e = *Vec::index_shared(&m.slots, s);\n    if (e == max_value<usize>())\n    {\n        *Vec::inde"
    "x_exclusive(&mut m.slots, s) = Vec::len(&m.keys);\n        Vec::push(&mut m.keys, k);\n        Vec::pu"
    "sh(&mut m.values, v);\n        return None;\n    }\n    Some(Vec::replace(&mut m.values, e, v))\n}unitte"
    "st \"HashMap::insert: replacing a value\"\n{\n    HashMap<i32, i32> m = HashMap::new();\n    HashMap::ins"
    "ert(&mut m, 5, 50);\n    HashMap::insert(&mut m, 7, 70);\n    assert(Option::unwrap(HashMap::insert(&m"
    "ut m, 5, 55)) == 50);\n    assert(HashMap::len(&m) == 2);\n    assert(*HashMap::key_at(&m, 0) == 5 && "
    "*HashMap::value_at(&m, 0) == 55);\n}export fn HashMap::entry<K, V>(ref<HashMap<K, V>, exclusive> m, p"
    "robe<K> k, V fresh) : ref<V, exclusive>\n{\n    HashMap::reserve_one(m);\n    usize s = HashMap::seek(&"
    "*m, k);\n    usize e = *Vec::index_shared(&m.slots, s);\n    if (e == max_value<usize>())\n    {\n      "
    "  e = Vec::len(&m.keys);\n        *Vec::index_exclusive(&mut m.slots, s) = e;\n        Vec::push(&mut "
    "m.keys, probe_key(k));\n        Vec::push(&mut m.values, fresh);\n    }\n    Vec::index_exclusive(&mut "
    "m.values, e)\n}unittest \"HashMap::entry: counting\"\n{\n    HashMap<i32, i32> counts = HashMap::new();\n "
    "   Vec<i32> words = Vec::new();\n    Vec::push(&mut words, 3);\n    Vec::push(&mut words, 1);\n    Vec:"
    ":push(&mut words, 3);\n    foreach (w in &words)\n    {\n        *HashMap::entry(&mut counts, *w, 0) +="
    " 1;\n    }\n    i32 three = 3;\n    assert(*Option::unwrap(HashMap::get(&counts, three)) == 2);\n}export"
    " fn HashMap::get<K, V>(ref<HashMap<K, V>, shared> m, probe<K> k) : Option<ref<V, shared>> from m\n{\n "
    "   usize e = HashMap::index_of(m, k);\n    if (e == max_value<usize>())\n    {\n        return None;\n  "
    "  }\n    Some(Vec::index_shared(&m.values, e))\n}export fn HashMap::get_mut<K, V>(ref<HashMap<K, V>, e"
    "xclusive> m, probe<K> k) : Option<ref<V, exclusive>> from m\n{\n    usize e = HashMap::index_of(&*m, k"
    ");\n    if (e == max_value<usize>())\n    {\n        return None;\n    }\n    Some(Vec::index_exclusive(&"
    "mut m.values, e))\n}export fn HashMap::contains<K, V>(ref<HashMap<K, V>, shared> m, probe<K> k) : boo"
    "l\n{\n    HashMap::index_of(m, k) != max_value<usize>()\n}fn HashMap::unslot<K, V>(ref<HashMap<K, V>, e"
    "xclusive> m, usize s)\n{\n    usize mask = Vec::len(&m.slots) - 1;\n    usize i = s;\n    usize j = s;\n "
    "   bool shifting = true;\n    while (shifting)\n    {\n        j = (j + 1) & mask;\n        usize e = *V"
    "ec::index_shared(&m.slots, j);\n        if (e == max_value<usize>())\n        {\n            shifting ="
    " false;\n        }\n        else\n        {\n            usize home = narrow_wrapping<usize>(key_hash(Ve"
    "c::index_shared(&m.keys, e))) & mask;\n            // The entry in j may move back to i unless its ho"
    "me lies in (i, j], cyclically.\n            bool stays = if (i <= j)\n            {\n                ho"
    "me > i && home <= j\n            }\n            else\n            {\n                home > i || home <="
    " j\n            };\n            if (!stays)\n            {\n                *Vec::index_exclusive(&mut m"
    ".slots, i) = e;\n                i = j;\n            }\n        }\n    }\n    *Vec::index_exclusive(&mut "
    "m.slots, i) = max_value<usize>();\n}export fn HashMap::swap_remove<K, V>(ref<HashMap<K, V>, exclusive"
    "> m, probe<K> k) : Option<V>\n{\n    usize s = HashMap::seek(&*m, k);\n    usize e = *Vec::index_shared"
    "(&m.slots, s);\n    if (e == max_value<usize>())\n    {\n        return None;\n    }\n    usize last = Ve"
    "c::len(&m.keys) - 1;\n    if (e != last)\n    {\n        // The last entry's slot names e from now on.\n"
    "        usize t = HashMap::find(&*m, Vec::index_shared(&m.keys, last));\n        *Vec::index_exclusiv"
    "e(&mut m.slots, t) = e;\n    }\n    auto k_last = Vec::remove_at(&mut m.keys, last);\n    auto v_last ="
    " Vec::remove_at(&mut m.values, last);\n    auto v = if (e != last)\n    {\n        drop(Vec::replace(&m"
    "ut m.keys, e, k_last));\n        Vec::replace(&mut m.values, e, v_last)\n    }\n    else\n    {\n        "
    "drop(k_last);\n        v_last\n    };\n    HashMap::unslot(m, s);\n    Some(v)\n}export fn HashMap::remov"
    "e<K, V>(ref<HashMap<K, V>, exclusive> m, probe<K> k) : Option<V>\n{\n    usize s = HashMap::seek(&*m, "
    "k);\n    HashMap::remove_slot(m, s)\n}unittest \"HashMap::remove: order kept\"\n{\n    HashMap<i32, bool> "
    "a = HashMap::new();\n    HashMap::insert(&mut a, 1, true);\n    HashMap::insert(&mut a, 2, true);\n    "
    "HashMap::insert(&mut a, 3, true);\n    HashMap<i32, bool> b = HashMap::clone(&a);\n    i32 one = 1;\n  "
    "  HashMap::remove(&mut a, one);\n    assert(*HashMap::key_at(&a, 0) == 2 && *HashMap::key_at(&a, 1) ="
    "= 3);\n    HashMap::swap_remove(&mut b, one);\n    assert(*HashMap::key_at(&b, 0) == 3 && *HashMap::ke"
    "y_at(&b, 1) == 2);\n}fn HashMap::remove_slot<K, V>(ref<HashMap<K, V>, exclusive> m, usize s) : Option"
    "<V>\n{\n    usize e = *Vec::index_shared(&m.slots, s);\n    if (e == max_value<usize>())\n    {\n        "
    "return None;\n    }\n    HashMap::unslot(m, s);\n    drop(Vec::remove_at(&mut m.keys, e));\n    auto v ="
    " Vec::remove_at(&mut m.values, e);\n    // Entries after e moved down by one.\n    usize i = 0;\n    wh"
    "ile (i < Vec::len(&m.slots))\n    {\n        usize x = *Vec::index_shared(&m.slots, i);\n        if (x "
    "!= max_value<usize>() && x > e)\n        {\n            *Vec::index_exclusive(&mut m.slots, i) = x - 1"
    ";\n        }\n        i = i + 1;\n    }\n    Some(v)\n}unittest \"HashMap::get: literal key\"\n{\n    HashMap"
    "<String, i32> m = HashMap::new();\n    HashMap::insert(&mut m, \"apple\", 3);\n    assert(*Option::unwra"
    "p(HashMap::get(&m, \"apple\")) == 3);\n    assert(!HashMap::contains(&m, \"pear\"));\n}fn HashMap::drain<K"
    ", V>(HashMap<K, V> m) : HashDrain<K, V>\n{\n    HashDrain { .m = m, .next = 0 }\n}fn HashDrain::total<K"
    ", V>(ref<HashDrain<K, V>, shared> d) : usize\n{\n    d.m.keys.len\n}fn HashDrain::take_key<K, V>(ref<Ha"
    "shDrain<K, V>, exclusive> d) : K\n{\n    Vec::take_raw(&mut d.m.keys, d.next)\n}fn HashDrain::take_valu"
    "e<K, V>(ref<HashDrain<K, V>, exclusive> d) : V\n{\n    auto v = Vec::take_raw(&mut d.m.values, d.next)"
    ";\n    d.next = d.next + 1;\n    v\n}fn HashDrain::drop<K, V>(ref<HashDrain<K, V>, exclusive> self)\n{\n "
    "   while (self.next < self.m.keys.len)\n    {\n        drop(Vec::take_raw(&mut self.m.keys, self.next)"
    ");\n        drop(Vec::take_raw(&mut self.m.values, self.next));\n        self.next = self.next + 1;\n  "
    "  }\n    self.m.keys.len = 0;\n    self.m.values.len = 0;\n}export fn HashSet::new<K>() : HashSet<K>\n{\n"
    "    HashSet { .map = HashMap::new() }\n}export fn HashSet::len<K>(ref<HashSet<K>, shared> s) : usize\n"
    "{\n    HashMap::len(&s.map)\n}export fn HashSet::insert<K>(ref<HashSet<K>, exclusive> s, K k) : bool\n{"
    "\n    match (HashMap::insert(&mut s.map, k, true))\n    {\n        Some(_) : false,\n        None    : t"
    "rue,\n    }\n}unittest \"HashSet::insert: duplicate\"\n{\n    HashSet<i32> s = HashSet::new();\n    assert("
    "HashSet::insert(&mut s, 4));\n    assert(!HashSet::insert(&mut s, 4));\n    assert(HashSet::len(&s) =="
    " 1);\n}export fn HashSet::clone<K: clone>(ref<HashSet<K>, shared> s) : HashSet<K>\n{\n    HashSet { .ma"
    "p = HashMap::clone(&s.map) }\n}export fn HashSet::union<K: clone>(ref<HashSet<K>, shared> a, ref<Hash"
    "Set<K>, shared> b) : HashSet<K>\n{\n    HashSet<K> out = HashSet::clone(a);\n    foreach (i in 0..HashS"
    "et::len(b))\n    {\n        ref<K, shared> k = HashSet::key_at(b, i);\n        if (!HashMap::has_key(&a"
    ".map, k))\n        {\n            HashSet::insert(&mut out, clone(k));\n        }\n    }\n    out\n}unitte"
    "st \"HashSet::union: order\"\n{\n    HashSet<i32> a = HashSet::new();\n    HashSet<i32> b = HashSet::new("
    ");\n    HashSet::insert(&mut a, 3);\n    HashSet::insert(&mut a, 1);\n    HashSet::insert(&mut b, 2);\n "
    "   HashSet::insert(&mut b, 3);\n    HashSet<i32> u = HashSet::union(&a, &b);\n    assert(HashSet::len("
