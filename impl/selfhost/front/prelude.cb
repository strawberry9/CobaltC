    "bool last = false;\n    unsafe\n    {\n        last = Atomic::fetch_sub(&reclaim<ArcBox<T>>(self.ptr).c"
    "ount, 1) == 1;\n    }\n    if (last)\n    {\n        unsafe\n        {\n            overwrite(&mut reclaim"
    "<ArcBox<T>>(self.ptr).value, None);   // the value ends now, on this thread\n        }\n        ArcBox"
    "::release_weak<T>(self.ptr);\n    }\n}fn ArcBox::release_weak<T>(rawptr<ArcBox<T>> p)\n{\n    bool last "
    "= false;\n    unsafe\n    {\n        last = Atomic::fetch_sub(&reclaim<ArcBox<T>>(p).weak, 1) == 1;\n   "
    " }\n    if (last)\n    {\n        unsafe\n        {\n            drop(reclaim<ArcBox<T>>(p));\n           "
