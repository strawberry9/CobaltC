    " Err(found) : { n = found; },\n            }\n        }\n    }\n    None\n}export fn ArcWeak::clone<T>(re"
    "f<ArcWeak<T>, shared> w) : ArcWeak<T>\n{\n    unsafe\n    {\n        _ = Atomic::fetch_add(&reclaim<ArcB"
    "ox<T>>(w.ptr).weak, 1);\n    }\n    ArcWeak { .ptr = w.ptr }\n}export fn ArcWeak::drop<T>(ref<ArcWeak<T"
    ">, exclusive> self)\n{\n    ArcBox::release_weak<T>(self.ptr);\n}unittest \"ArcWeak::upgrade: after the "
