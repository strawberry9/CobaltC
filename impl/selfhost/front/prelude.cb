    "& 0x8888888888888888;\n    u64 y0 = y & 0x1111111111111111;\n    u64 y1 = y & 0x2222222222222222;\n    "
    "u64 y2 = y & 0x4444444444444444;\n    u64 y3 = y & 0x8888888888888888;\n    u64 z0 = wrapping_mul(x0, "
    "y0) ^ wrapping_mul(x1, y3) ^ wrapping_mul(x2, y2) ^ wrapping_mul(x3, y1);\n    u64 z1 = wrapping_mul("
    "x0, y1) ^ wrapping_mul(x1, y0) ^ wrapping_mul(x2, y3) ^ wrapping_mul(x3, y2);\n    u64 z2 = wrapping_"
    "mul(x0, y2) ^ wrapping_mul(x1, y1) ^ wrapping_mul(x2, y0) ^ wrapping_mul(x3, y3);\n    u64 z3 = wrapp"
    "ing_mul(x0, y3) ^ wrapping_mul(x1, y2) ^ wrapping_mul(x2, y1) ^ wrapping_mul(x3, y0);\n    (z0 & 0x11"
    "11111111111111) | (z1 & 0x2222222222222222) | (z2 & 0x4444444444444444) | (z3 & 0x8888888888888888)\n"
    "}fn ghash_rev64(u64 x) : u64\n{\n    u64 v = ((x & 0x5555555555555555) << 1) | ((x >> 1) & 0x555555555"
    "5555555);\n    v = ((v & 0x3333333333333333) << 2) | ((v >> 2) & 0x3333333333333333);\n    v = ((v & 0"
    "x0f0f0f0f0f0f0f0f) << 4) | ((v >> 4) & 0x0f0f0f0f0f0f0f0f);\n    v = ((v & 0x00ff00ff00ff00ff) << 8) "
    "| ((v >> 8) & 0x00ff00ff00ff00ff);\n    v = ((v & 0x0000ffff0000ffff) << 16) | ((v >> 16) & 0x0000fff"
    "f0000ffff);\n    (v << 32) | (v >> 32)\n}fn ghash_mul(u128 x, u128 y) : u128\n{\n    u64 x1 = narrow_wra"
    "pping<u64>(x >> 64);\n    u64 x0 = narrow_wrapping<u64>(x);\n    u64 y1 = narrow_wrapping<u64>(y >> 64"
    ");\n    u64 y0 = narrow_wrapping<u64>(y);\n    u64 x0r = ghash_rev64(x0);\n    u64 x1r = ghash_rev64(x1"
    ");\n    u64 y0r = ghash_rev64(y0);\n    u64 y1r = ghash_rev64(y1);\n    u64 z0 = ghash_bmul64(x0, y0);\n"
    "    u64 z1 = ghash_bmul64(x1, y1);\n    u64 z2 = ghash_bmul64(x0 ^ x1, y0 ^ y1);\n    u64 z0h = ghash_"
    "bmul64(x0r, y0r);\n    u64 z1h = ghash_bmul64(x1r, y1r);\n    u64 z2h = ghash_bmul64(x0r ^ x1r, y0r ^ "
    "y1r);\n    z2 = z2 ^ z0 ^ z1;\n    z2h = z2h ^ z0h ^ z1h;\n    z0h = ghash_rev64(z0h) >> 1;\n    z1h = g"
    "hash_rev64(z1h) >> 1;\n    z2h = ghash_rev64(z2h) >> 1;\n    u64 v0 = z0;\n    u64 v1 = z0h ^ z2;\n    u"
    "64 v2 = z1 ^ z2h;\n    u64 v3 = z1h;\n    v3 = (v3 << 1) | (v2 >> 63);\n    v2 = (v2 << 1) | (v1 >> 63)"
    ";\n    v1 = (v1 << 1) | (v0 >> 63);\n    v0 = v0 << 1;\n    v2 = v2 ^ v0 ^ (v0 >> 1) ^ (v0 >> 2) ^ (v0 "
    ">> 7);\n    v1 = v1 ^ (v0 << 63) ^ (v0 << 62) ^ (v0 << 57);\n    v3 = v3 ^ v1 ^ (v1 >> 1) ^ (v1 >> 2) "
    "^ (v1 >> 7);\n    v2 = v2 ^ (v1 << 63) ^ (v1 << 62) ^ (v1 << 57);\n    (widen<u128>(v3) << 64) | widen"
    "<u128>(v2)\n}fn ghash_update(u128 y, u128 h, slice<u8, shared> data) : u128\n{\n    u128 acc = y;\n    f"
    "or (usize at = 0; at < slice_len(data); at += 16)\n    {\n        acc = ghash_mul(acc ^ gcm_block(data"
    ", at), h);\n    }\n    acc\n}fn gcm_bytes(u128 x) : array<u8, 16>\n{\n    array<u8, 16> b = [0; 16];\n    "
    "for (usize i = 0; i < 16; i += 1)\n    {\n        b[i] = narrow_wrapping<u8>(x >> narrow<u32>(8 * (15 "
    "- i)));\n    }\n    b\n}fn gcm_ctr(ref<AesKey, shared> key, array<u8, 16> j0, slice<u8, shared> data) :"
    " Vec<u8>\n{\n    Vec<u8> out = Vec::from_slice(data);\n    array<u8, 64> cb = [0; 64];\n    for (usize k"
    " = 0; k < 4; k += 1)\n    {\n        for (usize i = 0; i < 12; i += 1)\n        {\n            cb[16 * k"
    " + i] = j0[i];\n        }\n    }\n    // The counter, kept apart from the blocks (whose last four bytes"
    " it is).\n    u32 c = (widen<u32>(j0[12]) << 24) | (widen<u32>(j0[13]) << 16) | (widen<u32>(j0[14]) <"
    "< 8) | widen<u32>(j0[15]);\n    for (usize at = 0; at < slice_len(data); at += 64)\n    {\n        for "
    "(usize k = 0; k < 4; k += 1)\n        {\n            c = wrapping_add(c, 1);\n            for (usize i "
    "= 0; i < 4; i += 1)\n            {\n                cb[16 * k + 12 + i] = narrow_wrapping<u8>(c >> nar"
    "row<u32>(24 - 8 * i));\n            }\n        }\n        array<u8, 64> ks = aes_unpack(aes_encrypt4(ke"
    "y, aes_pack(cb)));\n        for (usize i = 0; i < 64 && at + i < slice_len(data); i += 1)\n        {\n "
    "           out[at + i] = out[at + i] ^ ks[i];\n        }\n    }\n    out\n}fn gcm_tag(\n    ref<AesKey, s"
    "hared> key,\n    array<u8, 16> j0,\n    slice<u8, shared> aad,\n    slice<u8, shared> ciphertext,\n) : a"
    "rray<u8, 16>\n{\n    u128 h = gcm_block(&aes_block(key, [0; 16])[0..$], 0);\n    u128 y = ghash_update("
    "ghash_update(0, h, aad), h, ciphertext);\n    u128 lengths = (widen<u128>(slice_len(aad)) * 8) << 64 "
    "| widen<u128>(slice_len(ciphertext)) * 8;\n    y = ghash_mul(y ^ lengths, h);\n    gcm_bytes(y ^ gcm_b"
    "lock(&aes_block(key, j0)[0..$], 0))\n}fn gcm_j0(slice<u8, shared> nonce) : array<u8, 16>\n{\n    if (sl"
    "ice_len(nonce) != 12)\n    {\n        fault(crypto_length);\n    }\n    array<u8, 16> j = [0; 16];\n    f"
    "or (usize i = 0; i < 12; i += 1)\n    {\n        j[i] = nonce[i];\n    }\n    j[15] = 1;\n    j\n}export f"
    "n aes_gcm_seal(\n    slice<u8, shared> key,\n    slice<u8, shared> nonce,\n    slice<u8, shared> aad,\n "
    "   slice<u8, shared> plaintext,\n) : Vec<u8>\n{\n    array<u8, 16> j0 = gcm_j0(nonce);\n    AesKey k = a"
    "es_expand(key);\n    Vec<u8> out = gcm_ctr(&k, j0, plaintext);\n    array<u8, 16> tag = gcm_tag(&k, j0"
    ", aad, &out[0..$]);\n    Vec::extend_from(&mut out, &tag[0..$]);\n    out\n}unittest \"aes_gcm_seal: a p"
    "ublished vector and its opening\"\n{\n    array<u8, 16> key = [0; 16];\n    array<u8, 12> nonce = [0; 12"
    "];\n    array<u8, 16> plain = [0; 16];\n    Vec<u8> none = Vec::new();\n    Vec<u8> sealed = aes_gcm_se"
    "al(&key[0..$], &nonce[0..$], &none[0..$], &plain[0..$]);\n    String want = String::from_str(\"0388dac"
    "e60b6a392f328c2b971b2fe78\");\n    String::append(&mut want, \"ab6e47d42cec13bdf53a67b21257bddf\");\n    "
    "assert(String::eq(&to_hex(&sealed[0..$]), &want));\n    Vec<u8> opened = Option::unwrap(aes_gcm_open("
    "&key[0..$], &nonce[0..$], &none[0..$], &sealed[0..$]));\n    assert(slice_eq(&opened[0..$], &plain[0."
    ".$]));\n    assert(Option::is_none(&aes_gcm_open(&key[0..$], &nonce[0..$], &b\"aad\"[0..$], &sealed[0.."
    "$])));\n}export fn aes_gcm_open(\n    slice<u8, shared> key,\n    slice<u8, shared> nonce,\n    slice<u8"
    ", shared> aad,\n    slice<u8, shared> sealed,\n) : Option<Vec<u8>>\n{\n    array<u8, 16> j0 = gcm_j0(non"
    "ce);\n    AesKey k = aes_expand(key);\n    usize n = slice_len(sealed);\n    if (n < 16)\n    {\n        "
    "return None;\n    }\n    array<u8, 16> want = gcm_tag(&k, j0, aad, &sealed[0..n - 16]);\n    if (!diges"
    "t_eq(&want[0..$], &sealed[n - 16..n]))\n    {\n        return None;\n    }\n    Some(gcm_ctr(&k, j0, &se"
    "aled[0..n - 16]))\n}fn fe_carry(array<u64, 5> f) : array<u64, 5>\n{\n    array<u64, 5> r = f;\n    for ("
    "usize i = 0; i < 4; i += 1)\n    {\n        r[i + 1] += r[i] >> 51;\n        r[i] = r[i] & FE_MASK;\n   "
    " }\n    u64 c = r[4] >> 51;\n    r[4] = r[4] & FE_MASK;\n    r[0] += c * 19;\n    r[1] += r[0] >> 51;\n  "
    "  r[0] = r[0] & FE_MASK;\n    r\n}fn fe_add(array<u64, 5> a, array<u64, 5> b) : array<u64, 5>\n{\n    fe"
    "_carry([a[0] + b[0], a[1] + b[1], a[2] + b[2], a[3] + b[3], a[4] + b[4]])\n}fn fe_sub(array<u64, 5> a"
    ", array<u64, 5> b) : array<u64, 5>\n{\n    fe_carry([\n        a[0] + 0x1fffffffffffb4 - b[0],\n        "
    "a[1] + 0x1ffffffffffffc - b[1],\n        a[2] + 0x1ffffffffffffc - b[2],\n        a[3] + 0x1ffffffffff"
    "ffc - b[3],\n        a[4] + 0x1ffffffffffffc - b[4],\n    ])\n}fn fe_mul(array<u64, 5> a, array<u64, 5>"
    " b) : array<u64, 5>\n{\n    u128 a0 = widen<u128>(a[0]);\n    u128 a1 = widen<u128>(a[1]);\n    u128 a2 "
    "= widen<u128>(a[2]);\n    u128 a3 = widen<u128>(a[3]);\n    u128 a4 = widen<u128>(a[4]);\n    u128 b0 ="
    " widen<u128>(b[0]);\n    u128 b1 = widen<u128>(b[1]);\n    u128 b2 = widen<u128>(b[2]);\n    u128 b3 = "
    "widen<u128>(b[3]);\n    u128 b4 = widen<u128>(b[4]);\n    u128 b1_19 = b1 * 19;\n    u128 b2_19 = b2 * "
    "19;\n    u128 b3_19 = b3 * 19;\n    u128 b4_19 = b4 * 19;\n    u128 t0 = a0 * b0 + a1 * b4_19 + a2 * b3"
    "_19 + a3 * b2_19 + a4 * b1_19;\n    u128 t1 = a0 * b1 + a1 * b0 + a2 * b4_19 + a3 * b3_19 + a4 * b2_1"
    "9;\n    u128 t2 = a0 * b2 + a1 * b1 + a2 * b0 + a3 * b4_19 + a4 * b3_19;\n    u128 t3 = a0 * b3 + a1 *"
    " b2 + a2 * b1 + a3 * b0 + a4 * b4_19;\n    u128 t4 = a0 * b4 + a1 * b3 + a2 * b2 + a3 * b1 + a4 * b0;"
    "\n    u128 m = 0x7ffffffffffff;\n    t1 += t0 >> 51;\n    t2 += t1 >> 51;\n    t3 += t2 >> 51;\n    t4 +="
    " t3 >> 51;\n    u128 r0 = (t0 & m) + (t4 >> 51) * 19;\n    u128 r1 = (t1 & m) + (r0 >> 51);\n    array<"
    "u64, 5> r = [\n        narrow<u64>(r0 & m),\n        narrow<u64>(r1),\n        narrow<u64>(t2 & m),\n   "
    "     narrow<u64>(t3 & m),\n        narrow<u64>(t4 & m),\n    ];\n    fe_carry(r)\n}fn fe_cswap(ref<array"
    "<u64, 5>, exclusive> a, ref<array<u64, 5>, exclusive> b, u64 swap)\n{\n    u64 mask = wrapping_sub(0, "
    "swap);\n    for (usize i = 0; i < 5; i += 1)\n    {\n        u64 x = mask & (a[i] ^ b[i]);\n        a[i]"
    " = a[i] ^ x;\n        b[i] = b[i] ^ x;\n    }\n}fn fe_invert(array<u64, 5> z) : array<u64, 5>\n{\n    arr"
    "ay<u64, 5> r = [1, 0, 0, 0, 0];\n    for (usize k = 0; k < 255; k += 1)\n    {\n        usize i = 254 -"
    " k;\n        r = fe_mul(r, r);\n        if (i >= 5 || i == 3 || i == 1 || i == 0)\n        {\n          "
    "  r = fe_mul(r, z);\n        }\n    }\n    r\n}fn fe_from_bytes(slice<u8, shared> s) : array<u64, 5>\n{\n "
    "   [\n        read_le<u64>(s, 0) & FE_MASK,\n        (read_le<u64>(s, 6) >> 3) & FE_MASK,\n        (rea"
    "d_le<u64>(s, 12) >> 6) & FE_MASK,\n        (read_le<u64>(s, 19) >> 1) & FE_MASK,\n        (read_le<u64"
    ">(s, 24) >> 12) & FE_MASK,\n    ]\n}fn fe_to_bytes(array<u64, 5> f) : array<u8, 32>\n{\n    array<u64, 5"
    "> h = fe_carry(fe_carry(f));\n    // q is 1 exactly when h ≥ p: h + 19 then reaches 2^255.\n    u64 "
    "q = (h[0] + 19) >> 51;\n    q = (h[1] + q) >> 51;\n    q = (h[2] + q) >> 51;\n    q = (h[3] + q) >> 51;"
    "\n    q = (h[4] + q) >> 51;\n    h[0] += 19 * q;\n    for (usize i = 0; i < 4; i += 1)\n    {\n        h["
    "i + 1] += h[i] >> 51;\n        h[i] = h[i] & FE_MASK;\n    }\n    h[4] = h[4] & FE_MASK;\n    array<u64,"
    " 4> w = [\n        h[0] | (h[1] << 51),\n        (h[1] >> 13) | (h[2] << 38),\n        (h[2] >> 26) | ("
    "h[3] << 25),\n        (h[3] >> 39) | (h[4] << 12),\n    ];\n    array<u8, 32> out = [0; 32];\n    for (u"
    "size i = 0; i < 4; i += 1)\n    {\n        for (usize j = 0; j < 8; j += 1)\n        {\n            out["
    "8 * i + j] = narrow_wrapping<u8>(w[i] >> narrow<u32>(8 * j));\n        }\n    }\n    out\n}fn x25519_lad"
    "der(slice<u8, shared> scalar, slice<u8, shared> u) : array<u8, 32>\n{\n    array<u8, 32> k = [0; 32];\n"
    "    for (usize i = 0; i < 32; i += 1)\n    {\n        k[i] = scalar[i];\n    }\n    k[0] = k[0] & 248;\n "
    "   k[31] = (k[31] & 127) | 64;\n    array<u64, 5> x1 = fe_from_bytes(u);\n    array<u64, 5> x2 = [1, 0"
