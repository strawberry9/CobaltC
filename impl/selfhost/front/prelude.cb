    "ttest \"Arc: shared by threads, destroyed once\"\n{\n    Arc<mutex<u32>> a = Arc::new(Mutex::new(0: u32)"
    ");\n    Vec<handle<void>> hs = Vec::new();\n    for (u32 i = 0; i < 4; i += 1)\n    {\n        Vec::push"
    "(&mut hs, spawn(move [](Arc<mutex<u32>> h)\n        {\n            auto g = lock(Arc::get(&h));\n      "
    "      *g += 1;\n        }, Arc::clone(&a)));\n    }\n    ArcWeak<mutex<u32>> w = Arc::downgrade(&a);\n  "
    "  drop(a);                                  // the workers' handles keep the value\n    foreach (h in"
