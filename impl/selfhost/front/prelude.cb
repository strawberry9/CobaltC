    "      event_op(2, ch.can_recv, seen);\n        }\n    }\n}export fn Channel::try_recv<T>(ref<Channel<T>"
    ", shared> ch) : Result<Option<T>, void>\n{\n    auto g = lock(&ch.state);\n    if (g.count > 0)\n    {\n "
