    "5: i32);\n    assert(Result::unwrap(Atomic::compare_exchange(&a, 5, 9)) == 5);\n    match (Atomic::com"
    "pare_exchange(&a, 5, 1))\n    {\n        Ok(_)    : assert(false),\n        Err(now) : assert(now == 9)"
    ",\n    }\n    assert(Atomic::swap(&a, 2) == 9);\n    Atomic::store(&a, 7);\n    assert(Atomic::load(&a) "
    "== 7);\n}unittest \"Atomic::fetch_or: flags and wrapping\"\n{\n    Atomic<u8> f = Atomic::new(0: u8);\n   "
    " _ = Atomic::fetch_or(&f, 0x05);\n    _ = Atomic::fetch_and(&f, 0x0c);\n    _ = Atomic::fetch_xor(&f, "
    "0x0f);\n    assert(Atomic::load(&f) == 0x0b);\n    assert(Atomic::fetch_add_wrapping(&f, 250) == 0x0b)"
    ";\n    assert(Atomic::load(&f) == 5);\n    assert(Atomic::fetch_sub_wrapping(&f, 6) == 5);\n    assert("
    "Atomic::load(&f) == 255);\n}export fn Atomic::fetch_max<T: integer>(ref<Atomic<T>, shared> a, T v) : "
    "T\n{\n    T current = Atomic::load(a);\n    while (current < v)\n    {\n        match (Atomic::compare_ex"
    "change(a, current, v))\n        {\n            Ok(_)      : return current,\n            Err(found) : c"
    "urrent = found,\n        }\n    }\n    current\n}export fn Atomic::fetch_min<T: integer>(ref<Atomic<T>, "
    "shared> a, T v) : T\n{\n    T current = Atomic::load(a);\n    while (current > v)\n    {\n        match ("
    "Atomic::compare_exchange(a, current, v))\n        {\n            Ok(_)      : return current,\n        "
    "    Err(found) : current = found,\n        }\n    }\n    current\n}export fn Atomic::fetch_update<T: int"
    "eger>(ref<Atomic<T>, shared> a, fn(T) : Option<T> f) : Result<T, T>\n{\n    T current = Atomic::load(a"
    ");\n    while (true)\n    {\n        match (f(current))\n        {\n            None : return Err(current"
    "),\n            Some(new) : match (Atomic::compare_exchange(a, current, new))\n            {\n         "
    "       Ok(_)      : return Ok(current),\n                Err(found) : current = found,\n            },"
    "\n        }\n    }\n}export fn Atomic::wait<T: integer>(ref<Atomic<T>, shared> a, T expected)\n{\n    whi"
    "le (true)\n    {\n        u64 seen = atomic_wait_op(a, 0, 0);\n        if (Atomic::load(a) != expected)"
    "\n        {\n            return;\n        }\n        _ = atomic_wait_op(a, 1, seen);\n    }\n}export fn At"
    "omic::notify_one<T: integer>(ref<Atomic<T>, shared> a)\n{\n    _ = atomic_wait_op(a, 2, 0);\n}export fn"
    " Atomic::notify_all<T: integer>(ref<Atomic<T>, shared> a)\n{\n    _ = atomic_wait_op(a, 3, 0);\n}fn boo"
    "l_byte(bool b) : u8\n{\n    if (b)\n    {\n        1\n    }\n    else\n    {\n        0\n    }\n}export fn Ato"
    "micBool::new(bool v) : AtomicBool\n{\n    AtomicBool { .atomic_flag = Atomic::new(bool_byte(v)) }\n}exp"
    "ort fn AtomicBool::load(ref<AtomicBool, shared> f) : bool\n{\n    Atomic::load(&f.atomic_flag) != 0\n}e"
    "xport fn AtomicBool::store(ref<AtomicBool, shared> f, bool v)\n{\n    Atomic::store(&f.atomic_flag, bo"
    "ol_byte(v));\n}export fn AtomicBool::swap(ref<AtomicBool, shared> f, bool v) : bool\n{\n    Atomic::swa"
    "p(&f.atomic_flag, bool_byte(v)) != 0\n}export fn AtomicBool::compare_exchange(ref<AtomicBool, shared>"
    " f, bool expected, bool new) : Result<bool, bool>\n{\n    match (Atomic::compare_exchange(&f.atomic_fl"
    "ag, bool_byte(expected), bool_byte(new)))\n    {\n        Ok(_)      : Ok(expected),\n        Err(found"
    ") : Err(found != 0),\n    }\n}export fn AtomicBool::fetch_and(ref<AtomicBool, shared> f, bool v) : boo"
    "l\n{\n    Atomic::fetch_and(&f.atomic_flag, bool_byte(v)) != 0\n}export fn AtomicBool::fetch_or(ref<Ato"
    "micBool, shared> f, bool v) : bool\n{\n    Atomic::fetch_or(&f.atomic_flag, bool_byte(v)) != 0\n}export"
    " fn AtomicBool::fetch_xor(ref<AtomicBool, shared> f, bool v) : bool\n{\n    Atomic::fetch_xor(&f.atomi"
    "c_flag, bool_byte(v)) != 0\n}export fn AtomicBool::wait(ref<AtomicBool, shared> f, bool expected)\n{\n "
    "   Atomic::wait(&f.atomic_flag, bool_byte(expected));\n}export fn AtomicBool::notify_one(ref<AtomicBo"
    "ol, shared> f)\n{\n    Atomic::notify_one(&f.atomic_flag);\n}export fn AtomicBool::notify_all(ref<Atomi"
    "cBool, shared> f)\n{\n    Atomic::notify_all(&f.atomic_flag);\n}export fn AtomicPtr::new<T>(rawptr<T> p"
    ") : AtomicPtr<T>\n{\n    AtomicPtr { .atomic_ptr = p }\n}export fn AtomicPtr::load<T>(ref<AtomicPtr<T>,"
    " shared> a) : rawptr<T>\n{\n    atomic_op(a, 0, null_rawptr<T>(), null_rawptr<T>())\n}export fn AtomicP"
    "tr::store<T>(ref<AtomicPtr<T>, shared> a, rawptr<T> p)\n{\n    _ = atomic_op(a, 1, p, null_rawptr<T>()"
    ");\n}export fn AtomicPtr::swap<T>(ref<AtomicPtr<T>, shared> a, rawptr<T> p) : rawptr<T>\n{\n    atomic_"
    "op(a, 2, p, null_rawptr<T>())\n}export fn AtomicPtr::compare_exchange<T>(\n    ref<AtomicPtr<T>, share"
    "d> a,\n    rawptr<T> expected,\n    rawptr<T> new,\n) : Result<rawptr<T>, rawptr<T>>\n{\n    rawptr<T> fo"
    "und = atomic_op(a, 3, expected, new);\n    if (found == expected)\n    {\n        Ok(found)\n    }\n    e"
    "lse\n    {\n        Err(found)\n    }\n}export fn atomic_fence()\n{\n    cpu_op(0);\n}export fn spin_hint()"
    "\n{\n    cpu_op(1);\n}unittest \"Atomic::fetch_max: extremes and updates\"\n{\n    Atomic<i32> a = Atomic::"
    "new(10: i32);\n    assert(Atomic::fetch_max(&a, 4) == 10);\n    assert(Atomic::fetch_max(&a, 25) == 10"
    ");\n    assert(Atomic::fetch_min(&a, 30) == 25);\n    assert(Atomic::fetch_min(&a, -3) == 25);\n    ass"
    "ert(Atomic::load(&a) == -3);\n    assert(Result::unwrap(Atomic::fetch_update(&a, [](i32 x) : Option<i"
    "32> { Some(x * 2) })) == -3);\n    match (Atomic::fetch_update(&a, [](i32 x) : Option<i32> { None }))"
    "\n    {\n        Ok(_)  : assert(false),\n        Err(v) : assert(v == -6),\n    }\n}unittest \"Atomic::wa"
    "it: woken by notify_all\"\n{\n    AtomicBool done = AtomicBool::new(false);\n    {\n        handle<void> "
    "h = spawn(move [](ref<AtomicBool, shared> d)\n        {\n            AtomicBool::store(d, true);\n     "
    "       AtomicBool::notify_all(d);\n        }, &done);\n        AtomicBool::wait(&done, false);\n       "
    " join(h);\n    }\n    assert(AtomicBool::load(&done));\n    assert(AtomicBool::swap(&done, false));\n}ex"
    "port fn Barrier::new(usize parties) : Barrier\n{\n    if (parties == 0)\n    {\n        fault(barrier_ze"
    "ro_parties);\n    }\n    Barrier { .parties = parties, .arrived = Atomic::new(0: usize), .generation ="
    " Atomic::new(0: usize) }\n}export fn Barrier::wait(ref<Barrier, shared> b) : bool\n{\n    usize round ="
    " Atomic::load(&b.generation);\n    if (Atomic::fetch_add(&b.arrived, 1) + 1 == b.parties)\n    {\n     "
    "   Atomic::store(&b.arrived, 0);\n        _ = Atomic::fetch_add_wrapping(&b.generation, 1);\n        A"
    "tomic::notify_all(&b.generation);\n        return true;\n    }\n    while (Atomic::load(&b.generation) "
    "== round)\n    {\n        Atomic::wait(&b.generation, round);\n    }\n    false\n}unittest \"Barrier::wait"
    ": rounds, one leader each\"\n{\n    Barrier b = Barrier::new(4);\n    Atomic<u32> leaders = Atomic::new("
    "0: u32);\n    Atomic<u32> seen = Atomic::new(0: u32);\n    Vec<handle<void>> hs = Vec::new();\n    for "
    "(u32 i = 0; i < 4; i += 1)\n    {\n        Vec::push(&mut hs, spawn(move [](\n            ref<Barrier, "
    "shared> b,\n            ref<Atomic<u32>, shared> leaders,\n            ref<Atomic<u32>, shared> seen,\n"
    "            u32 id,\n        )\n        {\n            for (u32 round = 0; round < 3; round += 1)\n     "
    "       {\n                _ = Atomic::fetch_add(seen, 1);\n                if (Barrier::wait(b))\n     "
    "           {\n                    _ = Atomic::fetch_add(leaders, 1);\n                    assert(Atomi"
    "c::load(seen) == 4 * (round + 1));   // everyone wrote before anyone read\n                }\n        "
    "        _ = Barrier::wait(b);                                 // the read phase ends together too\n  "
    "          }\n        }, &b, &leaders, &seen, i));\n    }\n    foreach (h in hs)\n    {\n        join(h);\n"
    "    }\n    assert(Atomic::load(&leaders) == 3 && Atomic::load(&seen) == 12);\n}export fn Semaphore::ne"
    "w(usize permits) : Semaphore\n{\n    Semaphore { .permits = Atomic::new(permits) }\n}export fn Semaphor"
    "e::acquire(ref<Semaphore, shared> s)\n{\n    usize n = Atomic::load(&s.permits);\n    while (true)\n    "
    "{\n        if (n == 0)\n        {\n            Atomic::wait(&s.permits, 0);\n            n = Atomic::loa"
    "d(&s.permits);\n            continue;\n        }\n        match (Atomic::compare_exchange(&s.permits, n"
    ", n - 1))\n        {\n            Ok(_)      : { return; },\n            Err(found) : { n = found; },\n "
    "       }\n    }\n}export fn Semaphore::try_acquire(ref<Semaphore, shared> s) : bool\n{\n    usize n = At"
    "omic::load(&s.permits);\n    while (n != 0)\n    {\n        match (Atomic::compare_exchange(&s.permits,"
    " n, n - 1))\n        {\n            Ok(_)      : { return true; },\n            Err(found) : { n = foun"
    "d; },\n        }\n    }\n    false\n}export fn Semaphore::release(ref<Semaphore, shared> s)\n{\n    _ = At"
    "omic::fetch_add(&s.permits, 1);\n    Atomic::notify_one(&s.permits);\n}export fn Semaphore::available("
    "ref<Semaphore, shared> s) : usize\n{\n    Atomic::load(&s.permits)\n}unittest \"Semaphore: a bound and a"
    " hand-over\"\n{\n    Semaphore limit = Semaphore::new(2);\n    Atomic<u32> active = Atomic::new(0: u32);"
    "\n    Atomic<u32> peak = Atomic::new(0: u32);\n    Vec<handle<void>> hs = Vec::new();\n    for (u32 i ="
    " 0; i < 6; i += 1)\n    {\n        Vec::push(&mut hs, spawn(move [](\n            ref<Semaphore, shared"
    "> limit,\n            ref<Atomic<u32>, shared> active,\n            ref<Atomic<u32>, shared> peak,\n   "
    "     )\n        {\n            Semaphore::acquire(limit);\n            _ = Atomic::fetch_max(peak, Atom"
    "ic::fetch_add(active, 1) + 1);\n            _ = Atomic::fetch_sub(active, 1);\n            Semaphore::"
    "release(limit);\n        }, &limit, &active, &peak));\n    }\n    foreach (h in hs)\n    {\n        join("
    "h);\n    }\n    assert(Atomic::load(&peak) <= 2 && Semaphore::available(&limit) == 2);\n    assert(Sema"
    "phore::try_acquire(&limit) && Semaphore::try_acquire(&limit) && !Semaphore::try_acquire(&limit));\n\n "
    "   Semaphore events = Semaphore::new(0);\n    handle<u32> h = spawn(move [](ref<Semaphore, shared> e)"
    " : u32\n    {\n        Semaphore::acquire(e);\n        Semaphore::acquire(e);\n        Semaphore::acquir"
    "e(e);\n        3\n    }, &events);\n    Semaphore::release(&events);\n    Semaphore::release(&events);\n "
    "   Semaphore::release(&events);\n    assert(join(h) == 3 && Semaphore::available(&events) == 0);\n}fn "
    "OnceRun::drop(ref<OnceRun, exclusive> self)\n{\n    if (!self.done)\n    {\n        Atomic::store(&self."
    "once.state, 0);\n        Atomic::notify_all(&self.once.state);\n    }\n}export fn Once::new() : Once\n{\n"
    "    Once { .state = Atomic::new(0: u8) }\n}export fn Once::call(ref<Once, shared> o, fn() f)\n{\n    wh"
    "ile (true)\n    {\n        match (Atomic::compare_exchange(&o.state, 0, 1))\n        {\n            Ok(_"
    ")  :\n            {\n                OnceRun run = OnceRun { .once = o, .done = false };\n             "
    "   f();\n                run.done = true;\n                Atomic::store(&o.state, 2);\n               "
    " Atomic::notify_all(&o.state);\n                return;\n            },\n            Err(s) :\n         "
    "   {\n                if (s == 2)\n                {\n                    return;\n                }\n   "
    "             Atomic::wait(&o.state, 1);\n            },\n        }\n    }\n}export fn Once::is_done(ref<"
    "Once, shared> o) : bool\n{\n    Atomic::load(&o.state) == 2\n}unittest \"Once::call: once among four thr"
    "eads\"\n{\n    Once o = Once::new();\n    Atomic<u32> runs = Atomic::new(0: u32);\n    Vec<handle<bool>> "
    "hs = Vec::new();\n    for (u32 i = 0; i < 4; i += 1)\n    {\n        Vec::push(&mut hs, spawn(move [](r"
    "ef<Once, shared> o, ref<Atomic<u32>, shared> runs) : bool\n        {\n            Once::call(o, [runs]"
    "() { _ = Atomic::fetch_add(runs, 1); });\n            Once::is_done(o)\n        }, &o, &runs));\n    }\n"
    "    foreach (h in hs)\n    {\n        assert(join(h));\n    }\n    assert(Atomic::load(&runs) == 1 && On"
    "ce::is_done(&o));\n}fn Rng::rotl(u64 x, u32 k) : u64\n{\n    (x << k) | (x >> (64 - k))\n}fn Rng::splitm"
    "ix(ref<u64, exclusive> state) : u64\n{\n    *state = wrapping_add(*state, 0x9E3779B97F4A7C15);\n    u64"
    " z = *state;\n    z = wrapping_mul(z ^ (z >> 30), 0xBF58476D1CE4E5B9);\n    z = wrapping_mul(z ^ (z >>"
    " 27), 0x94D049BB133111EB);\n    z ^ (z >> 31)\n}export fn Rng::new(u64 seed) : Rng\n{\n    u64 state = s"
    "eed;\n    u64 a = Rng::splitmix(&mut state);\n    u64 b = Rng::splitmix(&mut state);\n    u64 c = Rng::"
    "splitmix(&mut state);\n    u64 d = Rng::splitmix(&mut state);\n    Rng { .s0 = a, .s1 = b, .s2 = c, .s"
    "3 = d }\n}export fn Rng::next_u64(ref<Rng, exclusive> r) : u64\n{\n    u64 result = wrapping_mul(Rng::r"
    "otl(wrapping_mul(r.s1, 5), 7), 9);\n    u64 t = r.s1 << 17;\n    r.s2 = r.s2 ^ r.s0;\n    r.s3 = r.s3 ^"
    " r.s1;\n    r.s1 = r.s1 ^ r.s2;\n    r.s0 = r.s0 ^ r.s3;\n    r.s2 = r.s2 ^ t;\n    r.s3 = Rng::rotl(r.s"
    "3, 45);\n    result\n}export fn Rng::below(ref<Rng, exclusive> r, u64 n) : u64\n{\n    u64 reject_under "
    "= wrapping_sub(0, n) % n;\n    u64 x = Rng::next_u64(r);\n    while (x < reject_under)\n    {\n        x"
    " = Rng::next_u64(r);\n    }\n    x % n\n}export fn Rng::unit_f64(ref<Rng, exclusive> r) : f64\n{\n    to_"
    "float<f64>(Rng::next_u64(r) >> 11) / 9007199254740992.0\n}unittest \"Rng: reproducible draws in range\""
    "\n{\n    Rng a = Rng::new(42);\n    Rng b = Rng::new(42);\n    assert(Rng::next_u64(&mut a) == Rng::next"
    "_u64(&mut b));\n    for (usize i = 0; i < 100; i += 1)\n    {\n        assert(Rng::below(&mut a, 6) < 6"
    ");\n        f64 x = Rng::unit_f64(&mut a);\n        assert(x >= 0.0 && x < 1.0);\n    }\n}fn os_random_v"
    "ec(usize n) : Vec<u8>\n{\n    Vec<u8> b = Vec::new();\n    while (b.cap < n)\n    {\n        Vec::grow(&m"
