    ";\n    usize hi = v.len;\n    while (lo < hi)\n    {\n        usize mid = lo + (hi - lo) / 2;\n        if"
    " (less(Vec::index_shared(v, mid), key))\n        {\n            lo = mid + 1;\n        }\n        else\n "
    "       {\n            hi = mid;\n        }\n    }\n    if (lo < v.len && !less(key, Vec::index_shared(v,"
