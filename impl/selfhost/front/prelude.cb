    " db, em[i] ^ db_mask[i]);\n    }\n    db[0] = db[0] & top_mask;\n    usize ps_len = em_len - h_len - s_"
    "len - 2;\n    for (usize i = 0; i < ps_len; i += 1)\n    {\n        if (db[i] != 0)\n        {\n         "
    "   return false;\n        }\n    }\n    if (db[ps_len] != 1)\n    {\n        return false;\n    }\n    Vec<"
