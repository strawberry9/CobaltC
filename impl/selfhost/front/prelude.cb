    ";\n    Json::set(&mut doc, \"b\", JsonArray(Vec::new()));\n    Json::set(&mut doc, \"a\", JsonBool(true));"
    "\n    String t = Json::text(&doc);\n    assert(t == \"{\\\"a\\\":true,\\\"b\\\":[]}\");\n}export fn Json::push(re"
    "f<Json, exclusive> j, Json v)\n{\n    match (j)\n    {\n        JsonArray(items) : Vec::push(items, v),\n"
    "        _                : assert(false, \"Json::push on a value that is not an array\"),\n    }\n}expor"
    "t fn to_hex(slice<u8, shared> bytes) : String\n{\n    str digits = \"0123456789abcdef\";\n    Vec<u8> out"
    " = Vec::new();\n    Vec::reserve(&mut out, slice_len(bytes) * 2);\n    for (usize i = 0; i < slice_len"
    "(bytes); i += 1)\n    {\n        Vec::push(&mut out, str_byte(digits, widen<usize>(bytes[i] >> 4)));\n "
    "       Vec::push(&mut out, str_byte(digits, widen<usize>(bytes[i] & 15)));\n    }\n    String { .bytes"
    " = out }\n}fn hex_value(u8 b) : u8\n{\n    if (b >= b'0' && b <= b'9')\n    {\n        return b - b'0';\n "
    "   }\n    if (b >= b'a' && b <= b'f')\n    {\n        return b - b'a' + 10;\n    }\n    if (b >= b'A' && "
    "b <= b'F')\n    {\n        return b - b'A' + 10;\n    }\n    255\n}export fn from_hex(StringView text) : "
    "Result<Vec<u8>, ParseError>\n{\n    hex_decode(text.bytes)\n}unittest \"from_hex: either case in, lowerc"
    "ase out\"\n{\n    Vec<u8> b = Result::unwrap(from_hex(\"00FFa0\"));\n    assert(Vec::len(&b) == 3);\n    as"
    "sert(b[1] == 255);\n    String h = to_hex(&b);\n    assert(h == \"00ffa0\");\n    match (from_hex(\"abc\"))"
    "\n    {\n        Err(Invalid(i)) : assert(i == 3),\n        _               : assert(false),\n    }\n}fn "
    "hex_decode(slice<u8, shared> b) : Result<Vec<u8>, ParseError>\n{\n    usize n = slice_len(b);\n    if ("
    "n == 0)\n    {\n        return Err(Empty);\n    }\n    Vec<u8> out = Vec::new();\n    Vec::reserve(&mut o"
    "ut, n / 2);\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (hex_value(b[i]) == 255)\n        {"
    "\n            return Err(Invalid(i));\n        }\n    }\n    if (n % 2 != 0)\n    {\n        return Err(In"
    "valid(n));\n    }\n    for (usize i = 0; i < n; i += 2)\n    {\n        Vec::push(&mut out, (hex_value(b"
    "[i]) << 4) | hex_value(b[i + 1]));\n    }\n    Ok(out)\n}export fn base64_encode(slice<u8, shared> byte"
    "s) : String\n{\n    str alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";"
    "\n    Vec<u8> out = Vec::new();\n    usize n = slice_len(bytes);\n    Vec::reserve(&mut out, (n + 2) / "
    "3 * 4);\n    usize i = 0;\n    while (i + 3 <= n)\n    {\n        u32 v = (widen<u32>(bytes[i]) << 16) |"
    " (widen<u32>(bytes[i + 1]) << 8) | widen<u32>(bytes[i + 2]);\n        Vec::push(&mut out, str_byte(al"
    "phabet, narrow<usize>((v >> 18) & 63)));\n        Vec::push(&mut out, str_byte(alphabet, narrow<usize"
    ">((v >> 12) & 63)));\n        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 6) & 63)));\n"
    "        Vec::push(&mut out, str_byte(alphabet, narrow<usize>(v & 63)));\n        i += 3;\n    }\n    if"
    " (n - i == 1)\n    {\n        u32 v = widen<u32>(bytes[i]) << 16;\n        Vec::push(&mut out, str_byte"
    "(alphabet, narrow<usize>((v >> 18) & 63)));\n        Vec::push(&mut out, str_byte(alphabet, narrow<us"
    "ize>((v >> 12) & 63)));\n        Vec::push(&mut out, b'=');\n        Vec::push(&mut out, b'=');\n    }\n"
    "    else if (n - i == 2)\n    {\n        u32 v = (widen<u32>(bytes[i]) << 16) | (widen<u32>(bytes[i + "
    "1]) << 8);\n        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 18) & 63)));\n        V"
    "ec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 12) & 63)));\n        Vec::push(&mut out, s"
    "tr_byte(alphabet, narrow<usize>((v >> 6) & 63)));\n        Vec::push(&mut out, b'=');\n    }\n    Strin"
    "g { .bytes = out }\n}fn base64_value(u8 b) : u8\n{\n    if (b >= b'A' && b <= b'Z')\n    {\n        retur"
    "n b - b'A';\n    }\n    if (b >= b'a' && b <= b'z')\n    {\n        return b - b'a' + 26;\n    }\n    if ("
    "b >= b'0' && b <= b'9')\n    {\n        return b - b'0' + 52;\n    }\n    if (b == b'+')\n    {\n        r"
    "eturn 62;\n    }\n    if (b == b'/')\n    {\n        return 63;\n    }\n    255\n}export fn base64_decode(S"
    "tringView text) : Result<Vec<u8>, ParseError>\n{\n    base64_decode_bytes(text.bytes)\n}unittest \"base6"
    "4_decode: padding\"\n{\n    StringView text = \"hi!?\";\n    String e = base64_encode(StringView::as_bytes"
    "(text));\n    assert(e == \"aGkhPw==\");\n    Vec<u8> d = Result::unwrap(base64_decode(&e));\n    assert("
    "Vec::len(&d) == 4);\n    match (base64_decode(\"aG=hPw==\"))\n    {\n        Err(Invalid(i)) : assert(i ="
