    "ueue::pop(&mut q)) == 5);\n    assert(Option::is_none(&PriorityQueue::pop(&mut q)));\n}export fn Prior"
    "ityQueue::clear<T>(ref<PriorityQueue<T>, exclusive> q)\n{\n    Vec::clear(&mut q.items);\n    Vec::clea"
    "r(&mut q.seqs);\n    q.next = 0;\n}export fn Vec::push_le<T: integer>(ref<Vec<u8>, exclusive> out, T x"
    ")\n{\n    usize n = sizeof<T>();\n    for (usize k = 0; k < n; k += 1)\n    {\n        Vec::push(out, nar"
    "row_wrapping<u8>(x >> narrow<u32>(8 * k)));\n    }\n}export fn Vec::push_be<T: integer>(ref<Vec<u8>, e"
    "xclusive> out, T x)\n{\n    usize n = sizeof<T>();\n    for (usize k = 0; k < n; k += 1)\n    {\n        "
    "Vec::push(out, narrow_wrapping<u8>(x >> narrow<u32>(8 * (n - 1 - k))));\n    }\n}export fn read_le<T: "
    "integer>(slice<u8, shared> s, usize at) : T\n{\n    usize n = sizeof<T>();\n    if (at > slice_len(s) |"
    "| slice_len(s) - at < n)\n    {\n        fault(index_out_of_bounds);\n    }\n    T acc = 0;\n    for (usi"
    "ze k = 0; k < n; k += 1)\n    {\n        acc = acc | (narrow_wrapping<T>(s[at + k]) << narrow<u32>(8 *"
    " k));\n    }\n    acc\n}unittest \"read_le: round trip\"\n{\n    Vec<u8> out = Vec::new();\n    Vec::push_be"
    "(&mut out, 0x0102: u16);\n    Vec::push_le(&mut out, -2: i16);\n    assert(out[0] == 0x01 && out[1] =="
    " 0x02 && out[2] == 0xfe && out[3] == 0xff);\n    assert(read_be<u16>(&out[0..$], 0) == 0x0102);\n    a"
    "ssert(read_le<i16>(&out[0..$], 2) == -2);\n}export fn read_be<T: integer>(slice<u8, shared> s, usize "
    "at) : T\n{\n    usize n = sizeof<T>();\n    if (at > slice_len(s) || slice_len(s) - at < n)\n    {\n     "
    "   fault(index_out_of_bounds);\n    }\n    T acc = 0;\n    for (usize k = 0; k < n; k += 1)\n    {\n     "
    "   acc = acc | (narrow_wrapping<T>(s[at + k]) << narrow<u32>(8 * (n - 1 - k)));\n    }\n    acc\n}expor"
    "t fn slice_parts<T>(slice<T, exclusive> s, usize parts) : Vec<slice<T, exclusive>>\n{\n    Vec<slice<T"
    ", exclusive>> out = Vec::new();\n    if (parts == 0)\n    {\n        return out;\n    }\n    usize n = sl"
    "ice_len(s);\n    usize at = 0;\n    for (usize k = 0; k < parts; k += 1)\n    {\n        usize size = n "
    "/ parts;\n        if (k < n % parts)\n        {\n            size += 1;\n        }\n        Vec::push(&mu"
    "t out, &mut s[at..at + size]);\n        at += size;\n    }\n    out\n}unittest \"slice_parts: lengths\"\n{\n"
    "    array<i32, 5> a = [1, 2, 3, 4, 5];\n    Vec<slice<i32, exclusive>> parts = slice_parts(&mut a[0.."
    "$], 2);\n    assert(Vec::len(&parts) == 2);\n    assert(slice_len(parts[0]) == 3 && slice_len(parts[1]"
    ") == 2);\n}export fn slice_swap<T>(slice<T, exclusive> s, usize i, usize j)\n{\n    if (i >= slice_len("
    "s) || j >= slice_len(s))\n    {\n        fault(index_out_of_bounds);\n    }\n    if (i != j)\n    {\n     "
    "   swap_places(&mut s[i], &mut s[j]);\n    }\n}export fn ParseError::text(ref<ParseError, shared> e) :"
    " str\n{\n    match (e)\n    {\n        Empty      : \"empty\",\n        Invalid(_) : \"not a number\",\n      "
    "  OutOfRange : \"out of range\",\n    }\n}export fn Utf8Error::text(ref<Utf8Error, shared> e) : str\n{\n  "
    "  \"not UTF-8\"\n}fn utf8_error_at(slice<u8, shared> b) : usize\n{\n    usize n = slice_len(b);\n    usize"
    " i = 0;\n    while (i < n)\n    {\n        u8 c0 = b[i];\n        usize width =\n            if (c0 < 128"
    ")\n            {\n                1\n            }\n            else if ((c0 & 224) == 192 && c0 >= 194)"
    "\n            {\n                2\n            }\n            else if ((c0 & 240) == 224)\n            {"
    "\n                3\n            }\n            else if ((c0 & 248) == 240 && c0 <= 244)\n            {\n"
    "                4\n            }\n            else\n            {\n                return i;\n           "
    " };\n        if (i + width > n)\n        {\n            return i;\n        }\n        usize k = 1;\n      "
    "  while (k < width)\n        {\n            u8 c = b[i + k];\n            if ((c & 192) != 128)\n       "
    "     {\n                return i + k;\n            }\n            k = k + 1;\n        }\n        if (widt"
    "h == 3)\n        {\n            u8 c1 = b[i + 1];\n            if ((c0 == 224 && c1 < 160) || (c0 == 23"
    "7 && c1 >= 160))\n            {\n                return i;\n            }\n        }\n        if (width ="
    "= 4)\n        {\n            u8 c1 = b[i + 1];\n            if ((c0 == 240 && c1 < 144) || (c0 == 244 &"
    "& c1 >= 144))\n            {\n                return i;\n            }\n        }\n        i = i + width;"
    "\n    }\n    n\n}export fn String::from_utf8(Vec<u8> bytes) : Result<String, Utf8Error>\n{\n    usize at "
    "= utf8_error_at(&bytes[0..$]);\n    if (at < Vec::len(&bytes))\n    {\n        return Err(Utf8Error { ."
    "offset = at });\n    }\n    Ok(String { .bytes = bytes })\n}unittest \"String::from_utf8: the offset of "
    "the bad byte\"\n{\n    Vec<u8> b = Vec::new();\n    Vec::push(&mut b, b'o');\n    Vec::push(&mut b, b'k')"
    ";\n    Vec::push(&mut b, 0xff: u8);\n    match (String::from_utf8(b))\n    {\n        Ok(_)  : assert(fa"
    "lse),\n        Err(e) : assert(e.offset == 2),\n    }\n}export fn StringView::from_utf8(slice<u8, share"
    "d> bytes) : Result<StringView, Utf8Error>\n{\n    usize at = utf8_error_at(bytes);\n    if (at < slice_"
    "len(bytes))\n    {\n        return Err(Utf8Error { .offset = at });\n    }\n    Ok(StringView { .bytes ="
    " bytes })\n}export fn String::from_c(rawptr<u8> p) : Result<String, Utf8Error>\n{\n    Vec<u8> b = unsa"
    "fe\n    {\n        Vec::from_c_bytes(p)\n    };\n    String::from_utf8(b)\n}export fn String::len(ref<Str"
    "ing, shared> s) : usize\n{\n    Vec::len(&s.bytes)\n}export fn String::into_bytes(String s) : Vec<u8>\n{"
    "\n    String { bytes } = s;\n    bytes\n}export fn String::from_str(str s) : String\n{\n    Vec<u8> v = V"
    "ec::new();\n    usize n = str_len(s);\n    Vec::reserve(&mut v, n);\n    usize i = 0;\n    while (i < n)"
    "\n    {\n        Vec::push(&mut v, str_byte(s, i));\n        i = i + 1;\n    }\n    String { .bytes = v }"
    "\n}export fn String::new() : String\n{\n    String { .bytes = Vec::new() }\n}export fn String::as_bytes("
    "ref<String, shared> s) : ref<Vec<u8>, shared>\n{\n    &s.bytes\n}export fn String::reserve(ref<String, "
    "exclusive> s, usize n)\n{\n    Vec::reserve(&mut s.bytes, n);\n}export fn String::clone(ref<String, sha"
    "red> s) : String\n{\n    String c = String::new();\n    String::append_string(&mut c, s);\n    c\n}export"
    " fn ascii_is_digit(u8 b) : bool\n{\n    b >= b'0' && b <= b'9'\n}export fn ascii_is_upper(u8 b) : bool\n"
    "{\n    b >= b'A' && b <= b'Z'\n}export fn ascii_is_lower(u8 b) : bool\n{\n    b >= b'a' && b <= b'z'\n}ex"
    "port fn ascii_is_alpha(u8 b) : bool\n{\n    ascii_is_upper(b) || ascii_is_lower(b)\n}export fn ascii_is"
    "_alnum(u8 b) : bool\n{\n    ascii_is_alpha(b) || ascii_is_digit(b)\n}export fn ascii_is_space(u8 b) : b"
    "ool\n{\n    b == b' ' || (b >= 9: u8 && b <= 13: u8)\n}export fn ascii_to_lower(u8 b) : u8\n{\n    if (as"
    "cii_is_upper(b)) { b + 32 } else { b }\n}export fn ascii_to_upper(u8 b) : u8\n{\n    if (ascii_is_lower"
    "(b)) { b - 32 } else { b }\n}export fn String::to_ascii_lower(ref<String, shared> s) : String\n{\n    S"
    "tring c = String::new();\n    foreach (b in &s.bytes)\n    {\n        Vec::push(&mut c.bytes, ascii_to_"
    "lower(*b));\n    }\n    c\n}unittest \"String::to_ascii_lower: only ASCII changes\"\n{\n    String s = \"Hel"
    "lo, World 1\";\n    String l = String::to_ascii_lower(&s);\n    assert(l == \"hello, world 1\");\n    asse"
    "rt(ascii_to_upper(b'q') == b'Q');\n    assert(!ascii_is_alpha(0xc3: u8));\n}export fn String::to_ascii"
    "_upper(ref<String, shared> s) : String\n{\n    String c = String::new();\n    foreach (b in &s.bytes)\n "
    "   {\n        Vec::push(&mut c.bytes, ascii_to_upper(*b));\n    }\n    c\n}export fn String::eq(ref<Stri"
    "ng, shared> a, ref<String, shared> b) : bool\n{\n    String::view(a, 0, String::len(a)) == String::vie"
    "w(b, 0, String::len(b))\n}export fn String::eq_str(ref<String, shared> a, str t) : bool\n{\n    String:"
    ":view(a, 0, String::len(a)) == t\n}export fn String::push_ascii(ref<String, exclusive> s, u8 b)\n{\n   "
    " if (b >= 128)\n    {\n        fault(not_ascii);\n    }\n    Vec::push(&mut s.bytes, b);\n}export fn Stri"
    "ng::clear(ref<String, exclusive> s)\n{\n    Vec::clear(&mut s.bytes);\n}export fn String::less(ref<Stri"
    "ng, shared> a, ref<String, shared> b) : bool\n{\n    StringView::less(String::view(a, 0, String::len(a"
    ")), String::view(b, 0, String::len(b)))\n}export fn String::truncate(ref<String, exclusive> s, usize "
    "n)\n{\n    if (n > Vec::len(&s.bytes))\n    {\n        fault(index_out_of_bounds);\n    }\n    if (!String"
    "View::boundary(&s.bytes[0 .. $], n))\n    {\n        fault(not_char_boundary);\n    }\n    while (Vec::l"
    "en(&s.bytes) > n)\n    {\n        drop(Vec::pop(&mut s.bytes));\n    }\n}unittest \"String::truncate: at "
    "a character boundary\"\n{\n    String s = \"caf\\u{e9}\";\n    String::truncate(&mut s, 3);\n    assert(s =="
    " \"caf\");\n}unittest \"StringView: views of views\"\n{\n    String s = \"hello world\";\n    StringView w = &"
    "s[6 .. $];\n    assert(w == \"world\");\n    StringView o = &w[0 .. 1];\n    assert(o == \"w\");\n}fn String"
    "View::boundary(slice<u8, shared> b, usize i) : bool\n{\n    i == 0 || i == slice_len(b) || (b[i] & 0xC"
    "0: u8) != 0x80: u8\n}export fn StringView::of(str s) : StringView\n{\n    StringView { .bytes = str_sli"
    "ce(s) }\n}fn StringView::ptr(StringView v) : rawptr<u8>\n{\n    if (slice_len(v.bytes) == 0)\n    {\n    "
    "    return dangling<u8>();\n    }\n    rawptr_of(&v.bytes[0])\n}export fn String::view(ref<String, shar"
    "ed> s, usize lo, usize hi) : StringView\n{\n    slice<u8, shared> all = &s.bytes[0..$];\n    if (lo > h"
    "i || hi > slice_len(all))\n    {\n        fault(index_out_of_bounds);\n    }\n    if (!StringView::bound"
    "ary(all, lo) || !StringView::boundary(all, hi))\n    {\n        fault(not_char_boundary);\n    }\n    St"
    "ringView { .bytes = &all[lo..hi] }\n}export fn StringView::sub(StringView v, usize lo, usize hi) : St"
    "ringView\n{\n    if (lo > hi || hi > slice_len(v.bytes))\n    {\n        fault(index_out_of_bounds);\n   "
    " }\n    if (!StringView::boundary(v.bytes, lo) || !StringView::boundary(v.bytes, hi))\n    {\n        f"
    "ault(not_char_boundary);\n    }\n    StringView { .bytes = &v.bytes[lo..hi] }\n}export fn StringView::l"
    "en(StringView v) : usize\n{\n    slice_len(v.bytes)\n}export fn StringView::less(StringView a, StringVi"
    "ew b) : bool\n{\n    usize n = slice_len(a.bytes);\n    usize m = slice_len(b.bytes);\n    usize i = 0;\n"
    "    while (i < n && i < m)\n    {\n        if (a.bytes[i] != b.bytes[i])\n        {\n            return "
    "a.bytes[i] < b.bytes[i];\n        }\n        i += 1;\n    }\n    n < m\n}unittest \"StringView::less: a pr"
    "efix first\"\n{\n    assert(StringView::less(\"ab\", \"abc\"));\n    assert(StringView::less(\"B\", \"a\"));\n   "
    " assert(!StringView::less(\"b\", \"b\"));\n}export fn StringView::eq(StringView a, StringView b) : bool\n{"
    "\n    usize n = slice_len(a.bytes);\n    if (n != slice_len(b.bytes))\n    {\n        return false;\n    "
    "}\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (a.bytes[i] != b.bytes[i])\n        {\n       "
    "     return false;\n        }\n    }\n    true\n}export fn StringView::as_bytes(StringView v) : slice<u8"
    ", shared>\n{\n    v.bytes\n}export fn String::eq_view(ref<String, shared> a, StringView v) : bool\n{\n   "
    " StringView::eq(String::as_view(a), v)\n}export fn StringView::eq_str(StringView a, str t) : bool\n{\n "
    "   usize n = slice_len(a.bytes);\n    if (n != str_len(t))\n    {\n        return false;\n    }\n    for "
    "(usize i = 0; i < n; i += 1)\n    {\n        if (a.bytes[i] != str_byte(t, i))\n        {\n            r"
    "eturn false;\n        }\n    }\n    true\n}fn StringView::at(StringView v, usize at, StringView t) : boo"
    "l\n{\n    usize m = slice_len(t.bytes);\n    if (at + m > slice_len(v.bytes))\n    {\n        return fals"
    "e;\n    }\n    for (usize j = 0; j < m; j += 1)\n    {\n        if (v.bytes[at + j] != t.bytes[j])\n     "
    "   {\n            return false;\n        }\n    }\n    true\n}export fn StringView::find(StringView v, St"
    "ringView t) : Option<usize>\n{\n    usize n = slice_len(v.bytes);\n    usize m = slice_len(t.bytes);\n  "
    "  if (m > n)\n    {\n        return None;\n    }\n    for (usize i = 0; i <= n - m; i += 1)\n    {\n      "
    "  if (StringView::at(v, i, t))\n        {\n            return Some(i);\n        }\n    }\n    None\n}unitt"
    "est \"StringView::find: positions and the empty text\"\n{\n    assert(StringView::contains(\"abc\", \"\"));\n"
    "    assert(StringView::find(\"abcabc\", \"c\") == Some(2: usize));\n    assert(StringView::find(\"abc\", \"d"
    "\") == None);\n}export fn StringView::starts_with(StringView v, StringView t) : bool\n{\n    StringView:"
    ":at(v, 0, t)\n}export fn StringView::ends_with(StringView v, StringView t) : bool\n{\n    usize n = sli"
    "ce_len(v.bytes);\n    usize m = slice_len(t.bytes);\n    m <= n && StringView::at(v, n - m, t)\n}export"
    " fn StringView::contains(StringView v, StringView t) : bool\n{\n    StringView::find(v, t) != None\n}fn"
    " StringView::space(u8 b) : bool\n{\n    b == b' ' || (b >= 9: u8 && b <= 13: u8)\n}export fn StringView"
    "::trim_start(StringView v) : StringView\n{\n    usize n = slice_len(v.bytes);\n    usize i = 0;\n    whi"
    "le (i < n && StringView::space(v.bytes[i]))\n    {\n        i += 1;\n    }\n    StringView::sub(v, i, n)"
    "\n}export fn StringView::trim_end(StringView v) : StringView\n{\n    usize n = slice_len(v.bytes);\n    "
    "while (n > 0 && StringView::space(v.bytes[n - 1]))\n    {\n        n -= 1;\n    }\n    StringView::sub(v"
    ", 0, n)\n}export fn StringView::trim(StringView v) : StringView\n{\n    // `trim_end(trim_start(v))`: t"
    "he same range, taken once.\n    usize n = slice_len(v.bytes);\n    usize i = 0;\n    while (i < n && St"
    "ringView::space(v.bytes[i]))\n    {\n        i += 1;\n    }\n    while (n > i && StringView::space(v.byt"
    "es[n - 1]))\n    {\n        n -= 1;\n    }\n    StringView::sub(v, i, n)\n}export fn StringView::split(St"
    "ringView v, str sep) : Vec<StringView>\n{\n    Vec<StringView> out = Vec::new();\n    usize n = slice_l"
    "en(v.bytes);\n    usize m = str_len(sep);\n    if (m == 0)\n    {\n        Vec::push(&mut out, v);\n     "
    "   return out;\n    }\n    StringView sv = StringView::of(sep);\n    usize start = 0;\n    usize i = 0;\n"
    "    while (i + m <= n)\n    {\n        if (StringView::at(v, i, sv))\n        {\n            Vec::push(&"
    "mut out, StringView::sub(v, start, i));\n            i += m;\n            start = i;\n        }\n       "
    " else\n        {\n            i += 1;\n        }\n    }\n    Vec::push(&mut out, StringView::sub(v, start"
    ", n));\n    out\n}unittest \"StringView::split: empty fields\"\n{\n    StringView line = \"a,,b\";\n    Vec<S"
    "tringView> parts = StringView::split(line, \",\");\n    assert(Vec::len(&parts) == 3);\n    assert(parts"
    "[1] == \"\");\n    assert(parts[2] == \"b\");\n}export fn StringView::char_count(StringView v) : usize\n{\n "
    "   usize n = 0;\n    for (usize i = 0; i < slice_len(v.bytes); i += 1)\n    {\n        if ((v.bytes[i] "
    "& 0xc0) != 0x80)\n        {\n            n += 1;\n        }\n    }\n    n\n}export fn StringView::chars(St"
    "ringView v) : Vec<StringView>\n{\n    Vec<StringView> out = Vec::new();\n    usize n = slice_len(v.byte"
    "s);\n    usize start = 0;\n    foreach (i in 1..n + 1)\n    {\n        if (StringView::boundary(v.bytes,"
    " i))\n        {\n            Vec::push(&mut out, StringView { .bytes = &v.bytes[start..i] });\n        "
    "    start = i;\n        }\n    }\n    out\n}export fn StringView::replace(StringView v, StringView from,"
    " StringView to) : String\n{\n    usize n = slice_len(v.bytes);\n    usize m = slice_len(from.bytes);\n  "
    "  if (m == 0)\n    {\n        return String::from_view(v);\n    }\n    String out = String::new();\n    u"
    "size start = 0;\n    usize i = 0;\n    while (i + m <= n)\n    {\n        if (StringView::at(v, i, from)"
    ")\n        {\n            String::append_view(&mut out, StringView { .bytes = &v.bytes[start..i] });\n "
    "           String::append_view(&mut out, to);\n            i += m;\n            start = i;\n        }\n "
    "       else\n        {\n            i += 1;\n        }\n    }\n    String::append_view(&mut out, StringVi"
    "ew { .bytes = &v.bytes[start..n] });\n    out\n}unittest \"StringView::replace: no overlaps\"\n{\n    Stri"
    "ng r = StringView::replace(\"aaa\", \"aa\", \"b\");\n    assert(r == \"ba\");\n    String same = StringView::r"
    "eplace(\"abc\", \"\", \"x\");\n    assert(same == \"abc\");\n}export fn StringView::join(slice<StringView, sha"
    "red> parts, StringView sep) : String\n{\n    String out = String::new();\n    foreach (i, p in parts)\n "
    "   {\n        if (i > 0)\n        {\n            String::append_view(&mut out, sep);\n        }\n        "
    "String::append_view(&mut out, *p);\n    }\n    out\n}unittest \"StringView::join: separators between\"\n{\n"
    "    Vec<StringView> parts = Vec::new();\n    Vec::push(&mut parts, StringView::of(\"a\"));\n    Vec::pus"
    "h(&mut parts, StringView::of(\"b\"));\n    Vec::push(&mut parts, StringView::of(\"c\"));\n    String j = S"
    "tringView::join(&parts[0..$], \", \");\n    assert(j == \"a, b, c\");\n}export fn String::join(slice<Strin"
    "g, shared> parts, StringView sep) : String\n{\n    String out = String::new();\n    foreach (i, p in pa"
    "rts)\n    {\n        if (i > 0)\n        {\n            String::append_view(&mut out, sep);\n        }\n  "
    "      String::append_string(&mut out, p);\n    }\n    out\n}export fn String::from_view(StringView v) :"
    " String\n{\n    String { .bytes = Vec::from_slice(v.bytes) }\n}export fn String::as_view(ref<String, sh"
    "ared> s) : StringView\n{\n    &(*s)[0..$]\n}export fn String::find(ref<String, shared> s, StringView t)"
    " : Option<usize>\n{\n    StringView::find(&(*s)[0..$], t)\n}export fn String::starts_with(ref<String, s"
    "hared> s, StringView t) : bool\n{\n    StringView::starts_with(&(*s)[0..$], t)\n}export fn String::ends"
    "_with(ref<String, shared> s, StringView t) : bool\n{\n    StringView::ends_with(&(*s)[0..$], t)\n}expor"
    "t fn String::trim(ref<String, shared> s) : StringView\n{\n    StringView::trim(&(*s)[0..$])\n}export fn"
    " String::trim_start(ref<String, shared> s) : StringView\n{\n    StringView::trim_start(&(*s)[0..$])\n}e"
    "xport fn String::trim_end(ref<String, shared> s) : StringView\n{\n    StringView::trim_end(&(*s)[0..$]"
    ")\n}export fn String::split(ref<String, shared> s, str sep) : Vec<StringView>\n{\n    StringView::split"
    "(&(*s)[0..$], sep)\n}export fn String::char_count(ref<String, shared> s) : usize\n{\n    StringView::ch"
    "ar_count(&(*s)[0..$])\n}export fn String::chars(ref<String, shared> s) : Vec<StringView>\n{\n    String"
    "View::chars(&(*s)[0..$])\n}unittest \"String::chars: bytes and characters\"\n{\n    String s = \"h\\u{e9}!\""
    ";\n    assert(String::len(&s) == 4);\n    assert(String::char_count(&s) == 3);\n    Vec<StringView> cs "
    "= String::chars(&s);\n    assert(StringView::len(cs[1]) == 2);\n    assert(StringView::code_point(cs[1"
    "]) == Some(0xe9: u32));\n}export fn String::contains(ref<String, shared> s, StringView t) : bool\n{\n  "
    "  StringView::contains(&(*s)[0..$], t)\n}export fn String::replace(ref<String, shared> s, StringView "
    "from, StringView to) : String\n{\n    StringView::replace(&(*s)[0..$], from, to)\n}export fn StringView"
    "::strip_prefix(StringView v, StringView t) : Option<StringView>\n{\n    if (StringView::starts_with(v,"
    " t))\n    {\n        return Some(StringView::sub(v, StringView::len(t), StringView::len(v)));\n    }\n  "
    "  None\n}unittest \"StringView::strip_prefix: an option's value\"\n{\n    StringView a = \"--name=value\";\n"
    "    assert(Option::unwrap(StringView::strip_prefix(a, \"--name=\")) == \"value\");\n    assert(Option::is"
    "_none(&StringView::strip_prefix(a, \"--other=\")));\n}export fn StringView::strip_suffix(StringView v, "
    "StringView t) : Option<StringView>\n{\n    if (StringView::ends_with(v, t))\n    {\n        return Some("
    "StringView::sub(v, 0, StringView::len(v) - StringView::len(t)));\n    }\n    None\n}export fn StringVie"
    "w::lines(StringView v) : Vec<StringView>\n{\n    Vec<StringView> out = Vec::new();\n    usize n = slice"
    "_len(v.bytes);\n    usize start = 0;\n    while (true)\n    {\n        usize i = byte_index_from(v.bytes"
    ", start, b'\\n');\n        if (i >= n)\n        {\n            break;\n        }\n        usize end = if ("
    "i > start && v.bytes[i - 1] == b'\\r') { i - 1 } else { i };\n        Vec::push(&mut out, StringView::"
    "sub(v, start, end));\n        start = i + 1;\n    }\n    if (start < n)\n    {\n        Vec::push(&mut ou"
    "t, StringView::sub(v, start, n));\n    }\n    out\n}unittest \"StringView::lines: line endings\"\n{\n    St"
    "ringView text = \"one\\r\\ntwo\\n\\nthree\\n\";\n    Vec<StringView> ls = StringView::lines(text);\n    asser"
    "t(Vec::len(&ls) == 4);\n    assert(ls[0] == \"one\");\n    assert(ls[2] == \"\");\n    assert(ls[3] == \"thr"
    "ee\");\n}fn byte_index_from(slice<u8, shared> b, usize at, u8 c) : usize\n{\n    usize i = at;\n    while"
    " (i < slice_len(b) && b[i] != c)\n    {\n        i += 1;\n    }\n    i\n}fn space_run_end(slice<u8, share"
    "d> b, usize at, bool space) : usize\n{\n    usize i = at;\n    while (i < slice_len(b) && ascii_is_spac"
    "e(b[i]) == space)\n    {\n        i += 1;\n    }\n    i\n}export fn StringView::split_whitespace(StringVi"
    "ew v) : Vec<StringView>\n{\n    Vec<StringView> out = Vec::new();\n    usize n = slice_len(v.bytes);\n  "
    "  usize i = 0;\n    while (i < n)\n    {\n        i = space_run_end(v.bytes, i, true);\n        usize st"
    "art = i;\n        i = space_run_end(v.bytes, i, false);\n        if (i > start)\n        {\n            "
    "Vec::push(&mut out, StringView::sub(v, start, i));\n        }\n    }\n    out\n}unittest \"StringView::sp"
    "lit_whitespace: runs of spaces\"\n{\n    Vec<StringView> w = StringView::split_whitespace(\"  to  be\\tor"
    " \");\n    assert(Vec::len(&w) == 3);\n    assert(w[0] == \"to\");\n    assert(w[2] == \"or\");\n}export fn S"
    "tringView::code_point(StringView v) : Option<u32>\n{\n    usize n = slice_len(v.bytes);\n    if (n == 0"
    ")\n    {\n        return None;\n    }\n    u8 b = v.bytes[0];\n    if (b < 0x80)\n    {\n        return Som"
    "e(widen<u32>(b));\n    }\n    // The view's bytes are UTF-8 (`[View-Form]`), so a lead byte's\n    // c"
    "ontinuation bytes are there.\n    if ((b & 0xE0) == 0xC0)\n    {\n        return Some((widen<u32>(b & 0"
    "x1F) << 6) | widen<u32>(v.bytes[1] & 0x3F));\n    }\n    if ((b & 0xF0) == 0xE0)\n    {\n        return "
    "Some((widen<u32>(b & 0x0F) << 12) | (widen<u32>(v.bytes[1] & 0x3F) << 6) | widen<u32>(v.bytes[2] & 0"
    "x3F));\n    }\n    Some((widen<u32>(b & 0x07) << 18) | (widen<u32>(v.bytes[1] & 0x3F) << 12) | (widen<"
    "u32>(v.bytes[2] & 0x3F) << 6) | widen<u32>(v.bytes[3] & 0x3F))\n}export fn String::push_code_point(re"
    "f<String, exclusive> s, u32 cp)\n{\n    u32 c = if ((cp >= 0xD800 && cp <= 0xDFFF) || cp > 0x10FFFF) {"
    " 0xFFFD } else { cp };\n    if (c < 0x80)\n    {\n        Vec::push(&mut s.bytes, narrow<u8>(c));\n    }"
    "\n    else if (c < 0x800)\n    {\n        Vec::push(&mut s.bytes, 0xC0 | narrow<u8>(c >> 6));\n        V"
    "ec::push(&mut s.bytes, 0x80 | narrow<u8>(c & 0x3F));\n    }\n    else if (c < 0x10000)\n    {\n        V"
    "ec::push(&mut s.bytes, 0xE0 | narrow<u8>(c >> 12));\n        Vec::push(&mut s.bytes, 0x80 | narrow<u8"
    ">((c >> 6) & 0x3F));\n        Vec::push(&mut s.bytes, 0x80 | narrow<u8>(c & 0x3F));\n    }\n    else\n  "
    "  {\n        Vec::push(&mut s.bytes, 0xF0 | narrow<u8>(c >> 18));\n        Vec::push(&mut s.bytes, 0x8"
    "0 | narrow<u8>((c >> 12) & 0x3F));\n        Vec::push(&mut s.bytes, 0x80 | narrow<u8>((c >> 6) & 0x3F"
    "));\n        Vec::push(&mut s.bytes, 0x80 | narrow<u8>(c & 0x3F));\n    }\n}unittest \"String::push_code"
    "_point: a surrogate\"\n{\n    String s = String::new();\n    String::push_code_point(&mut s, 0x41);\n    "
    "String::push_code_point(&mut s, 0xD800);\n    assert(s == \"A\\u{fffd}\");\n}export fn String::strip_pref"
    "ix(ref<String, shared> s, StringView t) : Option<StringView>\n{\n    StringView::strip_prefix(&(*s)[0."
    ".$], t)\n}export fn String::strip_suffix(ref<String, shared> s, StringView t) : Option<StringView>\n{\n"
    "    StringView::strip_suffix(&(*s)[0..$], t)\n}export fn String::lines(ref<String, shared> s) : Vec<S"
    "tringView>\n{\n    StringView::lines(&(*s)[0..$])\n}export fn String::split_whitespace(ref<String, shar"
    "ed> s) : Vec<StringView>\n{\n    StringView::split_whitespace(&(*s)[0..$])\n}fn Parts::split(StringView"
    " v, str sep) : Parts\n{\n    Parts { .v = v, .sep = sep, .at = 0, .lo = 0, .hi = 0, .taken = 0, .kind "
    "= 0, .done = false }\n}fn Parts::lines(StringView v) : Parts\n{\n    Parts { .v = v, .sep = \"\", .at = 0"
    ", .lo = 0, .hi = 0, .taken = 0, .kind = 1, .done = slice_len(v.bytes) == 0 }\n}fn Parts::words(String"
    "View v) : Parts\n{\n    usize at = space_run_end(v.bytes, 0, true);\n    Parts { .v = v, .sep = \"\", .at"
    " = at, .lo = 0, .hi = 0, .taken = 0, .kind = 2, .done = at >= slice_len(v.bytes) }\n}fn Parts::chars("
    "StringView v) : Parts\n{\n    Parts { .v = v, .sep = \"\", .at = 0, .lo = 0, .hi = 0, .taken = 0, .kind "
    "= 3, .done = slice_len(v.bytes) == 0 }\n}fn Parts::string_split(ref<String, shared> s, str sep) : Par"
    "ts\n{\n    Parts::split(&(*s)[0..$], sep)\n}fn Parts::string_lines(ref<String, shared> s) : Parts\n{\n   "
    " Parts::lines(&(*s)[0..$])\n}fn Parts::string_words(ref<String, shared> s) : Parts\n{\n    Parts::words"
    "(&(*s)[0..$])\n}fn Parts::string_chars(ref<String, shared> s) : Parts\n{\n    Parts::chars(&(*s)[0..$])"
    "\n}fn Parts::bound(Parts p) : usize\n{\n    if (p.done) { p.taken } else { p.taken + 1 }\n}fn Parts::nex"
    "t(Parts p) : Parts\n{\n    usize n = slice_len(p.v.bytes);\n    usize lo = p.at;\n    usize hi = n;\n    "
    "p.taken = p.taken + 1;\n    if (p.kind == 0)\n    {\n        usize m = str_len(p.sep);\n        match (i"
    "f (m == 0) { None } else { StringView::find(StringView::sub(p.v, lo, n), StringView::of(p.sep)) })\n "
    "       {\n            Some(i) :\n            {\n                hi = lo + i;\n                p.at = hi "
    "+ m;\n            },\n            None    : p.done = true,\n        }\n    }\n    else if (p.kind == 1)\n "
    "   {\n        usize i = byte_index_from(p.v.bytes, lo, b'\\n');\n        if (i >= n)\n        {\n        "
    "    p.done = true;\n        }\n        else\n        {\n            hi = if (i > lo && p.v.bytes[i - 1] "
    "== b'\\r') { i - 1 } else { i };\n            p.at = i + 1;\n            p.done = p.at >= n;\n        }\n"
    "    }\n    else if (p.kind == 2)\n    {\n        hi = space_run_end(p.v.bytes, lo, false);\n        p.at"
    " = space_run_end(p.v.bytes, hi, true);\n        p.done = p.at >= n;\n    }\n    else\n    {\n        hi ="
    " lo + 1;\n        while (!StringView::boundary(p.v.bytes, hi))\n        {\n            hi += 1;\n       "
    " }\n        p.at = hi;\n        p.done = hi >= n;\n    }\n    p.lo = lo;\n    p.hi = hi;\n    p\n}unittest "
    "\"StringView::lines: a foreach takes the parts as it goes\"\n{\n    StringView text = \"one\\r\\ntwo\\n\\nthr"
    "ee\\n\";\n    Vec<StringView> ls = StringView::lines(text);\n    usize n = 0;\n    foreach (i, l in Strin"
    "gView::lines(text))\n    {\n        assert(l == ls[i]);\n        n += 1;\n    }\n    assert(n == 4);\n    "
    "n = 0;\n    foreach (w in StringView::split_whitespace(\"  to  be\\tor \"))\n    {\n        n += StringVie"
    "w::len(w);\n    }\n    assert(n == 6);\n    n = 0;\n    foreach (f in StringView::split(\"a,,b\", \",\"))\n  "
    "  {\n        n += 1;\n    }\n    assert(n == 3);\n}export fn String::code_point(ref<String, shared> s) :"
    " Option<u32>\n{\n    StringView::code_point(&(*s)[0..$])\n}export fn StringView::parse<T>(StringView v)"
    " : Result<T, ParseError>\n{\n    parse_bytes<T>(StringView::ptr(v), StringView::len(v))\n}unittest \"Str"
    "ingView::parse: no white space\"\n{\n    StringView v = \" 42 \";\n    assert(StringView::parse<u32>(v) =="
    " Err(Invalid(0)));\n    assert(StringView::parse<u32>(StringView::trim(v)) == Ok(42));\n}fn String::ap"
    "pend_view(ref<String, exclusive> s, StringView v)\n{\n    foreach (x in v.bytes)\n    {\n        Vec::pu"
    "sh(&mut s.bytes, *x);\n    }\n}export fn String::append<T>(ref<String, exclusive> s, T x)\n{\n    append"
    "_native(s, x);\n}unittest \"String::append: numbers as printf writes them\"\n{\n    String s = \"x = \";\n  "
    "  String::append(&mut s, 1.0);\n    String::append(&mut s, \", n = \");\n    String::append(&mut s, 42: "
    "u8);\n    assert(s == \"x = 1.0, n = 42\");\n}fn String::append_str(ref<String, exclusive> s, str t)\n{\n "
    "   usize n = str_len(t);\n    usize i = 0;\n    while (i < n)\n    {\n        Vec::push(&mut s.bytes, st"
    "r_byte(t, i));\n        i = i + 1;\n    }\n}fn String::append_string(ref<String, exclusive> s, ref<Stri"
    "ng, shared> t)\n{\n    usize n = t.bytes.len;\n    Vec::reserve(&mut s.bytes, n);\n    usize i = 0;\n    "
    "while (i < n)\n    {\n        u8 b = unsafe\n        {\n            *(reinterpret_ptr<u8>(t.bytes.ptr) +"
    " reinterpret<isize>(i))\n        };\n        Vec::push(&mut s.bytes, b);\n        i = i + 1;\n    }\n}fn "
    "String::append_text<T>(ref<String, exclusive> s, T x)\n{\n    rawptr<u8> p = match (allocate(64, 1))\n "
    "   {\n        Ok(p)  : p,\n        Err(_) : fault(alloc_failure),\n    };\n    usize n = unsafe\n    {\n  "
    "      text_write(x, p)\n    };\n    usize i = 0;\n    while (i < n)\n    {\n        u8 b = unsafe\n       "
    " {\n            *(p + reinterpret<isize>(i))\n        };\n        Vec::push(&mut s.bytes, b);\n        i"
    " = i + 1;\n    }\n    unsafe\n    {\n        deallocate(p, 64, 1);\n    }\n}export fn String::parse<T>(ref"
    "<String, shared> s) : Result<T, ParseError>\n{\n    parse_bytes<T>(reinterpret_ptr<u8>(s.bytes.ptr), s"
    ".bytes.len)\n}unittest \"String::parse: the three errors\"\n{\n    String a = \"12x4\";\n    assert(String::"
    "parse<i32>(&a) == Err(Invalid(2)));\n    String b = \"300\";\n    assert(String::parse<u8>(&b) == Err(Ou"
    "tOfRange));\n    String c = \"\";\n    assert(String::parse<i32>(&c) == Err(Empty));\n    String d = \"-17"
    "\";\n    assert(String::parse<i32>(&d) == Ok(-17));\n}fn parse_bytes<T>(rawptr<u8> p, usize n) : Result"
    "<T, ParseError>\n{\n    isize code = unsafe\n    {\n        parse_check<T>(p, n)\n    };\n    if (code == "
    "-1)\n    {\n        auto v = unsafe\n        {\n            parse_value<T>(p, n)\n        };\n        retu"
    "rn Ok(v);\n    }\n    if (code == -2)\n    {\n        return Err(Empty);\n    }\n    if (code == -3)\n    {"
    "\n        return Err(OutOfRange);\n    }\n    Err(Invalid(reinterpret<usize>(code)))\n}export fn flush_s"
    "tdout()\n{\n    unsafe\n    {\n        stdout_flush();\n    }\n}export fn read_line() : Result<Option<Stri"
    "ng>, FileError>\n{\n    Vec<u8> bytes = Vec::new();\n    bool any = false;\n    while (true)\n    {\n     "
    "   Vec::reserve(&mut bytes, 128);\n        isize n = unsafe\n        {\n            stdin_read_line(rei"
    "nterpret_ptr<u8>(bytes.ptr + reinterpret<isize>(bytes.len)), bytes.cap - bytes.len)\n        };\n     "
    "   if (n < 0)\n        {\n            return Err(FileError::Io);\n        }\n        if (n == 0)\n       "
    " {\n            break;\n        }\n        any = true;\n        bytes.len = bytes.len + reinterpret<usiz"
    "e>(n);\n        if (bytes[bytes.len - 1] == 10)\n        {\n            Vec::pop(&mut bytes);\n         "
    "   if (bytes.len > 0 && bytes[bytes.len - 1] == 13)\n            {\n                Vec::pop(&mut byte"
    "s);\n            }\n            break;\n        }\n    }\n    if (!any)\n    {\n        return Ok(None);\n  "
    "  }\n    match (String::from_utf8(bytes))\n    {\n        Ok(s)  : Ok(Some(s)),\n        Err(e) : Err(Fi"
    "leError::Utf8(e)),\n    }\n}export fn read_all_bytes() : Result<Vec<u8>, FileError>\n{\n    Vec<u8> out "
    "= Vec::new();\n    while (true)\n    {\n        while (out.cap - out.len < 65_536)\n        {\n          "
    "  Vec::grow(&mut out);\n        }\n        isize n = unsafe\n        {\n            stdin_read(reinterpr"
    "et_ptr<u8>(out.ptr + reinterpret<isize>(out.len)), out.cap - out.len)\n        };\n        if (n < 0)\n"
    "        {\n            return Err(FileError::Io);\n        }\n        if (n == 0)\n        {\n           "
    " break;\n        }\n        out.len = out.len + reinterpret<usize>(n);\n    }\n    Ok(out)\n}export fn re"
    "ad_all() : Result<String, FileError>\n{\n    Vec<u8> b = read_all_bytes()?;\n    match (String::from_ut"
    "f8(b))\n    {\n        Ok(s)  : Ok(s),\n        Err(e) : Err(FileError::Utf8(e)),\n    }\n}fn print_str(s"
    "tr s)\n{\n    unsafe\n    {\n        stdout_write(str_ptr(s), str_len(s));\n    }\n}fn print_string(ref<St"
    "ring, shared> s)\n{\n    unsafe\n    {\n        stdout_write(reinterpret_ptr<u8>(s.bytes.ptr), s.bytes.l"
    "en);\n    }\n}fn eprint_str(str s)\n{\n    unsafe\n    {\n        stderr_write(str_ptr(s), str_len(s));\n  "
    "  }\n}export fn FileError::text(ref<FileError, shared> e) : str\n{\n    match (e)\n    {\n        NotFoun"
    "d : \"not found\",\n        Denied   : \"permission denied\",\n        Io       : \"input/output error\",\n  "
    "      Utf8(_)  : \"not UTF-8\",\n    }\n}unittest \"FileError::text: a phrase to print\"\n{\n    FileError e"
    " = FileError::NotFound;\n    assert(FileError::text(&e) == \"not found\");\n}export fn read_file(StringV"
    "iew path) : Result<String, FileError>\n{\n    rawptr<u8> p = StringView::ptr(path);\n    usize pn = Str"
    "ingView::len(path);\n    usize cap = 4096;\n    while (true)\n    {\n        rawptr<u8> buf = match (all"
    "ocate(cap, 1))\n        {\n            Ok(b)  : b,\n            Err(_) : fault(alloc_failure),\n        "
    "};\n        isize n = unsafe\n        {\n            file_read(p, pn, buf, cap)\n        };\n        if ("
    "n >= 0 && reinterpret<usize>(n) <= cap)\n        {\n            usize len = reinterpret<usize>(n);\n   "
    "         Vec<u8> bytes = Vec::new();\n            usize i = 0;\n            while (i < len)\n          "
    "  {\n                u8 b = unsafe\n                {\n                    *(buf + reinterpret<isize>(i"
    "))\n                };\n                Vec::push(&mut bytes, b);\n                i = i + 1;\n         "
    "   }\n            unsafe\n            {\n                deallocate(buf, cap, 1);\n            }\n       "
    "     return match (String::from_utf8(bytes))\n            {\n                Ok(s)  : Ok(s),\n         "
    "       Err(e) : Err(FileError::Utf8(e)),\n            };\n        }\n        unsafe\n        {\n         "
    "   deallocate(buf, cap, 1);\n        }\n        if (n < 0)\n        {\n            return Err(file_error"
    "(n));\n        }\n        // Longer than `cap`: again, with room for all of it.\n        cap = reinterp"
    "ret<usize>(n);\n    }\n}export fn write_file(StringView path, StringView text) : Result<void, FileErro"
    "r>\n{\n    isize r = unsafe\n    {\n        file_write(StringView::ptr(path), StringView::len(path), Str"
    "ingView::ptr(text), StringView::len(text))\n    };\n    if (r < 0)\n    {\n        return Err(file_error"
    "(r));\n    }\n    Ok(())\n}fn file_error_at(i64 code) : FileError\n{\n    if (code == -1)\n    {\n        r"
    "eturn FileError::NotFound;\n    }\n    if (code == -2)\n    {\n        return FileError::Denied;\n    }\n "
    "   FileError::Io\n}fn File::start(StringView path, usize mode) : Result<File, FileError>\n{\n    isize "
    "r = unsafe\n    {\n        file_op(0, mode, StringView::ptr(path), StringView::len(path))\n    };\n    i"
    "f (r < 0)\n    {\n        return Err(file_error(r));\n    }\n    Ok(File { .id = reinterpret<usize>(r), "
    ".open = true })\n}export fn File::open(StringView path) : Result<File, FileError>\n{\n    File::start(p"
    "ath, 0)\n}export fn File::create(StringView path) : Result<File, FileError>\n{\n    File::start(path, 1"
    ")\n}export fn File::append(StringView path) : Result<File, FileError>\n{\n    File::start(path, 2)\n}exp"
    "ort fn File::open_rw(StringView path) : Result<File, FileError>\n{\n    File::start(path, 3)\n}fn File:"
    ":take(ref<File, exclusive> f, ref<Vec<u8>, exclusive> buf, usize want) : Result<usize, FileError>\n{\n"
    "    while (buf.cap - buf.len < want)\n    {\n        Vec::grow(buf);\n    }\n    isize r = unsafe\n    {\n"
    "        file_op(3, f.id, reinterpret_ptr<u8>(buf.ptr + reinterpret<isize>(buf.len)), want)\n    };\n  "
    "  if (r < 0)\n    {\n        return Err(file_error(r));\n    }\n    usize n = reinterpret<usize>(r);\n   "
    " buf.len = buf.len + n;\n    Ok(n)\n}export fn File::read(ref<File, exclusive> f, ref<Vec<u8>, exclusi"
    "ve> buf, usize max) : Result<usize, FileError>\n{\n    usize want = if (max > 1_048_576)\n    {\n       "
    " 1_048_576\n    }\n    else\n    {\n        max\n    };\n    File::take(f, buf, want)\n}export fn File::rea"
    "d_to_end(ref<File, exclusive> f, ref<Vec<u8>, exclusive> buf) : Result<usize, FileError>\n{\n    usize"
    " total = 0;\n    while (true)\n    {\n        usize n = match (File::read(f, buf, 65_536))\n        {\n  "
    "          Ok(n)  : n,\n            Err(e) : return Err(e),\n        };\n        if (n == 0)\n        {\n "
    "           break;\n        }\n        total = total + n;\n    }\n    Ok(total)\n}export fn File::read_lin"
    "e(ref<File, exclusive> f) : Result<Option<String>, FileError>\n{\n    isize r = unsafe\n    {\n        f"
    "ile_op(4, f.id, dangling<u8>(), 0)\n    };\n    if (r < 0)\n    {\n        return Err(file_error(r));\n  "
    "  }\n    if (r == 0)\n    {\n        return Ok(None);\n    }\n    Vec<u8> bytes = Vec::new();\n    usize n"
    " = match (File::take(f, &mut bytes, reinterpret<usize>(r)))\n    {\n        Ok(n)  : n,\n        Err(e)"
    " : return Err(e),\n    };\n    if (n > 0 && bytes[n - 1] == 10)\n    {\n        Vec::pop(&mut bytes);\n  "
    "      if (n > 1 && bytes[n - 2] == 13)\n        {\n            Vec::pop(&mut bytes);\n        }\n    }\n "
    "   match (String::from_utf8(bytes))\n    {\n        Ok(s)  : Ok(Some(s)),\n        Err(e) : Err(FileErr"
    "or::Utf8(e)),\n    }\n}export fn File::write(ref<File, exclusive> f, slice<u8, shared> data) : Result<"
    "void, FileError>\n{\n    usize n = slice_len(data);\n    if (n == 0)\n    {\n        return Ok(());\n    }"
    "\n    isize r = unsafe\n    {\n        file_op(5, f.id, rawptr_of(&data[0]), n)\n    };\n    if (r < 0)\n "
    "   {\n        return Err(file_error(r));\n    }\n    Ok(())\n}export fn File::write_text(ref<File, exclu"
    "sive> f, StringView text) : Result<void, FileError>\n{\n    File::write(f, text.bytes)\n}fn File::write"
    "_formatted(ref<File, exclusive> f, str text) : Result<void, FileError>\n{\n    usize n = str_len(text)"
    ";\n    if (n == 0)\n    {\n        return Ok(());\n    }\n    isize r = unsafe\n    {\n        file_op(5, f"
    ".id, str_ptr(text), n)\n    };\n    if (r < 0)\n    {\n        return Err(file_error(r));\n    }\n    Ok(("
    "))\n}export fn File::seek(ref<File, exclusive> f, u64 pos) : Result<void, FileError>\n{\n    i64 r = un"
    "safe\n    {\n        file_at(6, f.id, pos)\n    };\n    if (r < 0)\n    {\n        return Err(file_error_a"
    "t(r));\n    }\n    Ok(())\n}export fn File::len(ref<File, shared> f) : Result<u64, FileError>\n{\n    i64"
    " r = unsafe\n    {\n        file_at(7, f.id, 0)\n    };\n    if (r < 0)\n    {\n        return Err(file_er"
    "ror_at(r));\n    }\n    Ok(reinterpret<u64>(r))\n}export fn File::create_new(StringView path) : Result<"
    "Option<File>, FileError>\n{\n    isize r = unsafe\n    {\n        file_op(0, 4, StringView::ptr(path), S"
    "tringView::len(path))\n    };\n    if (r == -4)\n    {\n        return Ok(None);\n    }\n    if (r < 0)\n  "
    "  {\n        return Err(file_error(r));\n    }\n    Ok(Some(File { .id = reinterpret<usize>(r), .open ="
    " true }))\n}export fn File::flush(ref<File, exclusive> f) : Result<void, FileError>\n{\n    isize r = u"
    "nsafe\n    {\n        file_op(8, f.id, dangling<u8>(), 0)\n    };\n    if (r < 0)\n    {\n        return E"
    "rr(file_error(r));\n    }\n    Ok(())\n}export fn File::position(ref<File, shared> f) : Result<u64, Fil"
    "eError>\n{\n    i64 r = unsafe\n    {\n        file_at(9, f.id, 0)\n    };\n    if (r < 0)\n    {\n        r"
    "eturn Err(file_error_at(r));\n    }\n    Ok(reinterpret<u64>(r))\n}export fn File::close(File f) : Resu"
    "lt<void, FileError>\n{\n    f.open = false;\n    isize r = unsafe\n    {\n        file_op(1, f.id, dangli"
    "ng<u8>(), 0)\n    };\n    if (r < 0)\n    {\n        return Err(file_error(r));\n    }\n    Ok(())\n}export"
    " fn File::drop(ref<File, exclusive> self)\n{\n    if (self.open)\n    {\n        isize r = unsafe\n      "
    "  {\n            file_op(2, self.id, dangling<u8>(), 0)\n        };\n    }\n}export fn read_bytes(String"
    "View path) : Result<Vec<u8>, FileError>\n{\n    File f = match (File::open(path))\n    {\n        Ok(f) "
    " : f,\n        Err(e) : return Err(e),\n    };\n    Vec<u8> bytes = Vec::new();\n    match (File::read_t"
    "o_end(&mut f, &mut bytes))\n    {\n        Ok(_)  : Ok(bytes),\n        Err(e) : Err(e),\n    }\n}export "
    "fn write_bytes(StringView path, slice<u8, shared> data) : Result<void, FileError>\n{\n    File f = mat"
    "ch (File::create(path))\n    {\n        Ok(f)  : f,\n        Err(e) : return Err(e),\n    };\n    File::w"
    "rite(&mut f, data)\n}fn fs_path_op(usize op, StringView a, StringView b) : isize\n{\n    unsafe\n    {\n "
    "       fs_op(op, StringView::ptr(a), StringView::len(a), StringView::ptr(b), StringView::len(b))\n   "
    " }\n}export fn make_dir(StringView path) : Result<bool, FileError>\n{\n    isize r = fs_path_op(0, path"
    ", \"\");\n    if (r < 0)\n    {\n        return Err(file_error(r));\n    }\n    Ok(r == 1)\n}export fn remov"
    "e_file(StringView path) : Result<void, FileError>\n{\n    isize r = fs_path_op(1, path, \"\");\n    if (r"
    " < 0)\n    {\n        return Err(file_error(r));\n    }\n    Ok(())\n}export fn remove_dir(StringView pat"
    "h) : Result<void, FileError>\n{\n    isize r = fs_path_op(2, path, \"\");\n    if (r < 0)\n    {\n        r"
    "eturn Err(file_error(r));\n    }\n    Ok(())\n}export fn rename(StringView from, StringView to) : Resul"
    "t<void, FileError>\n{\n    isize r = fs_path_op(3, from, to);\n    if (r < 0)\n    {\n        return Err("
    "file_error(r));\n    }\n    Ok(())\n}export fn list_dir(StringView path) : Result<Vec<String>, FileErro"
    "r>\n{\n    Vec<u8> all = match (fs_answer(0, StringView::ptr(path), StringView::len(path)))\n    {\n    "
    "    Ok(b)  : b,\n        Err(c) : return Err(file_error(c)),\n    };\n    Vec<String> names = Vec::new("
    ");\n    Vec<u8> name = Vec::new();\n    foreach (b in &all)\n    {\n        match (*b)\n        {\n       "
    "     0 :\n            {\n                Vec<u8> done = replace(&mut name, Vec::new());\n              "
    "  match (String::from_utf8(done))\n                {\n                    Ok(n)  : Vec::push(&mut name"
    "s, n),\n                    Err(e) : return Err(FileError::Utf8(e)),\n                }\n            },"
    "\n            c : Vec::push(&mut name, c),\n        }\n    }\n    Ok(names)\n}export fn path_kind(StringV"
    "iew path) : Result<PathKind, FileError>\n{\n    Vec<u8> b = match (fs_answer(1, StringView::ptr(path),"
    " StringView::len(path)))\n    {\n        Ok(b)  : b,\n        Err(c) : return Err(file_error(c)),\n    }"
    ";\n    u64 len = 0;\n    usize i = 8;\n    while (i > 0)\n    {\n        len = (len << 8) | widen<u64>(b["
    "i]);\n        i -= 1;\n    }\n    match (b[0])\n    {\n        0 : Ok(File(len)),\n        1 : Ok(Dir),\n  "
    "      _ : Ok(Other),\n    }\n}export fn path_join(StringView base, StringView tail) : String\n{\n    Opt"
    "ion::unwrap_or(path_text(base, tail, 0), String::from_view(tail))\n}export fn path_parent(StringView "
    "p) : Option<String>\n{\n    path_text(p, \"\", 1)\n}unittest \"path_parent: a single name\"\n{\n    assert(Op"
    "tion::unwrap(path_parent(\"notes.txt\")) == \"\");\n    assert(Option::is_none(&path_parent(\"\")));\n}expor"
    "t fn path_file_name(StringView p) : Option<String>\n{\n    path_text(p, \"\", 2)\n}unittest \"path_file_na"
    "me: a final ..\"\n{\n    assert(Option::unwrap(path_file_name(\"src/main.cb\")) == \"main.cb\");\n    assert"
    "(Option::is_none(&path_file_name(\"src/..\")));\n}export fn path_stem(StringView p) : Option<String>\n{\n"
    "    path_text(p, \"\", 3)\n}unittest \"path_stem: the last dot\"\n{\n    assert(Option::unwrap(path_stem(\"a"
    "rchive.tar.gz\")) == \"archive.tar\");\n    assert(Option::unwrap(path_stem(\".bashrc\")) == \".bashrc\");\n}"
    "export fn path_extension(StringView p) : Option<String>\n{\n    path_text(p, \"\", 4)\n}unittest \"path_ex"
    "tension: no extension\"\n{\n    assert(Option::unwrap(path_extension(\"archive.tar.gz\")) == \"gz\");\n    a"
    "ssert(Option::is_none(&path_extension(\".bashrc\")));\n    assert(Option::is_none(&path_extension(\"READ"
    "ME\")));\n}export fn path_is_absolute(StringView p) : bool\n{\n    match (path_result(5, p, \"\"))\n    {\n "
    "       Ok(r)  : r == 1,\n        Err(_) : false,\n    }\n}export fn path_normalize(StringView p) : Stri"
    "ng\n{\n    Option::unwrap_or(path_text(p, \"\", 6), String::from_view(p))\n}unittest \"path_normalize: . a"
    "nd ..\"\n{\n    assert(path_normalize(\"a/./b/../c\") == path_join(\"a\", \"c\"));\n    assert(path_normalize("
    "\"../x/..\") == \"..\");\n    assert(path_normalize(\"a/..\") == \".\");\n}export fn path_canonical(StringView"
    " p) : Result<String, FileError>\n{\n    Vec<u8> b = match (byte_answer(0, 7, 0, p.bytes, StringView::o"
    "f(\"\").bytes))\n    {\n        Ok(b)  : b,\n        Err(c) : return Err(code_error(c)),\n    };\n    match"
    " (String::from_utf8(b))\n    {\n        Ok(s)  : Ok(s),\n        Err(e) : Err(FileError::Utf8(e)),\n    "
    "}\n}export fn file_info(StringView path) : Result<FileInfo, FileError>\n{\n    Vec<u8> b = match (byte_"
    "answer(0, 8, 0, path.bytes, StringView::of(\"\").bytes))\n    {\n        Ok(b)  : b,\n        Err(c) : re"
    "turn Err(code_error(c)),\n    };\n    u64 len = read_le<u64>(&b[0..$], 1);\n    PathKind kind = match ("
    "b[0])\n    {\n        0 : File(len),\n        1 : Dir,\n        _ : Other,\n    };\n    Ok(FileInfo { .kin"
    "d = kind, .len = len, .modified_unix = read_le<i64>(&b[0..$], 9), .readonly = b[17] != 0 })\n}export "
    "fn copy_file(StringView from, StringView to) : Result<u64, FileError>\n{\n    i64 n = path_result(9, f"
    "rom, to)?;\n    Ok(reinterpret<u64>(n))\n}export fn copy_permissions(StringView from, StringView to) :"
    " Result<void, FileError>\n{\n    path_result(17, from, to)?;\n    Ok(())\n}unittest \"copy_permissions: o"
    "ne file's permissions given to another\"\n{\n    String tmp = temp_dir();\n    String dir = path_join(St"
    "ring::as_view(&tmp), String::as_view(&sprintf(\"cb-perm-%v\", process_id())));\n    _ = make_dir_all(St"
    "ring::as_view(&dir));\n    String a = path_join(String::as_view(&dir), \"a.txt\");\n    String b = path_"
    "join(String::as_view(&dir), \"b.txt\");\n    _ = write_file(String::as_view(&a), \"a\");\n    _ = write_fi"
    "le(String::as_view(&b), \"b\");\n    assert(Result::is_ok(&copy_permissions(String::as_view(&a), String"
    "::as_view(&b))));\n    bool ra = Result::unwrap(file_info(String::as_view(&a))).readonly;\n    bool rb"
    " = Result::unwrap(file_info(String::as_view(&b))).readonly;\n    assert(ra == rb);\n    String gone = "
    "path_join(String::as_view(&dir), \"gone.txt\");\n    assert(Result::is_err(&copy_permissions(String::as"
    "_view(&gone), String::as_view(&b))));\n    _ = remove_dir_all(String::as_view(&dir));\n}export fn make"
    "_dir_all(StringView path) : Result<void, FileError>\n{\n    path_result(10, path, \"\")?;\n    Ok(())\n}ex"
    "port fn remove_dir_all(StringView path) : Result<void, FileError>\n{\n    path_result(11, path, \"\")?;\n"
    "    Ok(())\n}export fn arg_count() : usize\n{\n    usize i = 0;\n    while (true)\n    {\n        isize n "
    "= unsafe\n        {\n            arg_bytes(i, dangling<u8>(), 0)\n        };\n        if (n < 0)\n       "
    " {\n            break;\n        }\n        i = i + 1;\n    }\n    i\n}export fn arg(usize i) : Result<Stri"
    "ng, Utf8Error>\n{\n    isize n = unsafe\n    {\n        arg_bytes(i, dangling<u8>(), 0)\n    };\n    if (n"
    " < 0)\n    {\n        fault(index_out_of_bounds);\n    }\n    usize len = reinterpret<usize>(n);\n    raw"
    "ptr<u8> p = match (allocate(len, 1))\n    {\n        Ok(p)  : p,\n        Err(_) : fault(alloc_failure)"
    ",\n    };\n    Vec<u8> bytes = Vec::new();\n    unsafe\n    {\n        arg_bytes(i, p, len);\n    }\n    us"
    "ize j = 0;\n    while (j < len)\n    {\n        u8 b = unsafe\n        {\n            *(p + reinterpret<i"
    "size>(j))\n        };\n        Vec::push(&mut bytes, b);\n        j = j + 1;\n    }\n    if (len > 0)\n   "
    " {\n        unsafe\n        {\n            deallocate(p, len, 1);\n        }\n    }\n    String::from_utf8"
    "(bytes)\n}export fn env_var(StringView name) : Result<Option<String>, Utf8Error>\n{\n    match (fs_answ"
    "er(2, StringView::ptr(name), StringView::len(name)))\n    {\n        Ok(b) : match (String::from_utf8("
    "b))\n        {\n            Ok(v)  : Ok(Some(v)),\n            Err(e) : Err(e),\n        },\n        Err("
    "_) : Ok(None),\n    }\n}export fn current_dir() : Result<String, FileError>\n{\n    Vec<u8> b = match (f"
    "s_answer(3, dangling<u8>(), 0))\n    {\n        Ok(b)  : b,\n        Err(c) : return Err(file_error(c))"
    ",\n    };\n    match (String::from_utf8(b))\n    {\n        Ok(s)  : Ok(s),\n        Err(e) : Err(FileErr"
    "or::Utf8(e)),\n    }\n}export fn set_current_dir(StringView path) : Result<void, FileError>\n{\n    path"
    "_result(12, path, \"\")?;\n    Ok(())\n}export fn temp_dir() : String\n{\n    Option::unwrap_or(path_text("
    "\"\", \"\", 13), String::new())\n}export fn home_dir() : Option<String>\n{\n    path_text(\"\", \"\", 14)\n}expo"
    "rt fn current_exe() : Result<String, FileError>\n{\n    match (byte_answer(0, 15, 0, StringView::of(\"\""
    ").bytes, StringView::of(\"\").bytes))\n    {\n        Ok(v) : match (String::from_utf8(v))\n        {\n   "
    "         Ok(s)  : Ok(s),\n            Err(e) : Err(FileError::Utf8(e)),\n        },\n        Err(c) : E"
    "rr(code_error(c)),\n    }\n}export fn hostname() : Result<String, FileError>\n{\n    match (byte_answer("
    "0, 16, 0, StringView::of(\"\").bytes, StringView::of(\"\").bytes))\n    {\n        Ok(v) : match (String::"
    "from_utf8(v))\n        {\n            Ok(s)  : Ok(s),\n            Err(e) : Err(FileError::Utf8(e)),\n  "
    "      },\n        Err(c) : Err(code_error(c)),\n    }\n}export fn Args::new(StringView usage) : Result<"
    "Args, Utf8Error>\n{\n    Vec<String> items = Vec::new();\n    for (usize i = 0; i < arg_count(); i += 1"
    ")\n    {\n        Vec::push(&mut items, arg(i)?);\n    }\n    Ok(Args::from(items, usage))\n}export fn Ar"
    "gs::from(Vec<String> items, StringView usage) : Args\n{\n    usize n = Vec::len(&items);\n    usize end"
    " = n;\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (items[i] == \"--\")\n        {\n           "
    " end = i;\n            break;\n        }\n    }\n    Vec<bool> used = Vec::filled(n, false);\n    if (end"
    " < n)\n    {\n        used[end] = true;\n    }\n    Args { .usage = String::from_view(usage), .items = i"
    "tems, .used = used, .end_of_options = end, .specs = Vec::new(), .helps = Vec::new() }\n}unittest \"Arg"
    "s::from: flags, options, the rest\"\n{\n    Vec<String> items = Vec::new();\n    Vec::push(&mut items, S"
    "tring::from_str(\"-v\"));\n    Vec::push(&mut items, String::from_str(\"--out=a.txt\"));\n    Vec::push(&m"
    "ut items, String::from_str(\"in.txt\"));\n    Args a = Args::from(items, \"prog [options] FILE\");\n    as"
    "sert(Args::flag(&mut a, \"verbose\", \"v\", \"say more\"));\n    assert(Option::unwrap(Args::option(&mut a,"
    " \"out\", \"o\", \"FILE\", \"where to write\")) == \"a.txt\");\n    Vec<String> rest = Result::unwrap(Args::fin"
    "ish(&mut a));\n    assert(Vec::len(&rest) == 1 && rest[0] == \"in.txt\");\n}fn Args::is_option(ref<Args,"
    " shared> a, usize i, str name, str short, bool with_value) : bool\n{\n    StringView item = String::as"
    "_view(&a.items[i]);\n    if (Some(rest) = StringView::strip_prefix(item, \"--\"))\n    {\n        if (Str"
    "ingView::eq_str(rest, name))\n        {\n            return true;\n        }\n        if (with_value)\n  "
    "      {\n            if (Some(after) = StringView::strip_prefix(rest, StringView::of(name)))\n        "
    "    {\n                return StringView::starts_with(after, \"=\");\n            }\n        }\n        re"
    "turn false;\n    }\n    str_len(short) > 0 && StringView::len(item) == 2 && item.bytes[0] == b'-' && i"
    "tem.bytes[1] == str_byte(short, 0)\n}fn Args::spec(ref<Args, exclusive> a, str name, str short, str v"
    "alue_name, str help)\n{\n    String spec = String::new();\n    if (str_len(short) > 0)\n    {\n        St"
    "ring::append(&mut spec, \"-\");\n        String::append(&mut spec, short);\n        String::append(&mut "
    "spec, \", \");\n    }\n    else\n    {\n        String::append(&mut spec, \"    \");\n    }\n    String::appen"
    "d(&mut spec, \"--\");\n    String::append(&mut spec, name);\n    if (str_len(value_name) > 0)\n    {\n    "
    "    String::append(&mut spec, \" \");\n        String::append(&mut spec, value_name);\n    }\n    Vec::pu"
    "sh(&mut a.specs, spec);\n    Vec::push(&mut a.helps, String::from_str(help));\n}export fn Args::flag(r"
    "ef<Args, exclusive> a, str name, str short, str help) : bool\n{\n    Args::spec(a, name, short, \"\", he"
    "lp);\n    bool found = false;\n    for (usize i = 0; i < a.end_of_options; i += 1)\n    {\n        if (!"
    "a.used[i] && Args::is_option(a, i, name, short, false))\n        {\n            a.used[i] = true;\n    "
    "        found = true;\n        }\n    }\n    found\n}unittest \"Args::flag: after --\"\n{\n    Vec<String> i"
    "tems = Vec::new();\n    Vec::push(&mut items, String::from_str(\"--\"));\n    Vec::push(&mut items, Stri"
    "ng::from_str(\"-v\"));\n    Args a = Args::from(items, \"prog [options] FILE\");\n    assert(!Args::flag(&"
    "mut a, \"verbose\", \"v\", \"say more\"));\n    Vec<String> rest = Result::unwrap(Args::finish(&mut a));\n  "
    "  assert(Vec::len(&rest) == 1 && rest[0] == \"-v\");\n}export fn Args::options(ref<Args, exclusive> a, "
    "str name, str short, str value_name, str help) : Vec<String>\n{\n    Args::spec(a, name, short, value_"
    "name, help);\n    Vec<String> out = Vec::new();\n    for (usize i = 0; i < a.end_of_options; i += 1)\n "
    "   {\n        if (a.used[i] || !Args::is_option(a, i, name, short, true))\n        {\n            conti"
    "nue;\n        }\n        StringView item = String::as_view(&a.items[i]);\n        if (Some(eq) = String"
    "View::find(item, \"=\"))\n        {\n            if (StringView::starts_with(item, \"--\"))\n            {\n"
    "                a.used[i] = true;\n                Vec::push(&mut out, String::from_view(StringView::"
    "sub(item, eq + 1, StringView::len(item))));\n                continue;\n            }\n        }\n      "
    "  // D-0232: an item another declaration took is no value; the option\n        // is then left for `f"
    "inish`, as one given without its value.\n        if (i + 1 < Vec::len(&a.items) && i + 1 != a.end_of_"
    "options && !a.used[i + 1])\n        {\n            a.used[i] = true;\n            a.used[i + 1] = true;"
    "\n            Vec::push(&mut out, String::clone(&a.items[i + 1]));\n        }\n    }\n    out\n}export fn"
    " Args::option(ref<Args, exclusive> a, str name, str short, str value_name, str help) : Option<String"
    ">\n{\n    Vec<String> all = Args::options(a, name, short, value_name, help);\n    Vec::pop(&mut all)\n}e"
    "xport fn Args::finish(ref<Args, exclusive> a) : Result<Vec<String>, String>\n{\n    Vec<String> out = "
    "Vec::new();\n    for (usize i = 0; i < Vec::len(&a.items); i += 1)\n    {\n        if (a.used[i])\n     "
    "   {\n            continue;\n        }\n        StringView item = String::as_view(&a.items[i]);\n       "
    " if (i < a.end_of_options && StringView::len(item) > 1 && StringView::starts_with(item, \"-\"))\n      "
    "  {\n            bool declared = false;\n            foreach (s in &a.specs)\n            {\n           "
    "     // `-s, --name VALUE`: a declared option given without its\n                // value is one of i"
    "ts spec's words (`--ver` is not in\n                // `--verbose`'s).\n                foreach (w in "
    "StringView::split(String::as_view(s), \" \"))\n                {\n                    StringView word = "
    "if (StringView::ends_with(w, \",\"))\n                    {\n                        &w[0 .. StringView:"
    ":len(w) - 1]\n                    }\n                    else\n                    {\n                  "
    "      w\n                    };\n                    if (word == item)\n                    {\n         "
    "               declared = true;\n                    }\n                }\n            }\n            St"
    "ring m = String::new();\n            String::append(&mut m, if (declared) { \"missing a value for \" } "
    "else { \"unknown option \" });\n            String::append(&mut m, item);\n            return Err(m);\n  "
    "      }\n        Vec::push(&mut out, String::clone(&a.items[i]));\n    }\n    Ok(out)\n}unittest \"Args::"
    "finish: an undeclared option\"\n{\n    Vec<String> items = Vec::new();\n    Vec::push(&mut items, String"
    "::from_str(\"--colour\"));\n    Args a = Args::from(items, \"prog\");\n    match (Args::finish(&mut a))\n  "
    "  {\n        Err(m) : assert(m == \"unknown option --colour\"),\n        Ok(_)  : assert(false),\n    }\n}"
    "unittest \"Args::options: a taken argument is no value\"\n{\n    Vec<String> items = Vec::new();\n    Vec"
    "::push(&mut items, String::from_str(\"-o\"));\n    Vec::push(&mut items, String::from_str(\"-v\"));\n    A"
    "rgs a = Args::from(items, \"prog\");\n    assert(Args::flag(&mut a, \"verbose\", \"v\", \"say more\"));\n    a"
    "ssert(Option::is_none(&Args::option(&mut a, \"out\", \"o\", \"FILE\", \"where\")));\n    match (Args::finish("
    "&mut a))\n    {\n        Err(m) : assert(m == \"missing a value for -o\"),\n        Ok(_)  : assert(false"
    "),\n    }\n}unittest \"Args::finish: a prefix of a declared option\"\n{\n    Vec<String> items = Vec::new("
    ");\n    Vec::push(&mut items, String::from_str(\"--ver\"));\n    Vec::push(&mut items, String::from_str("
    "\"--out\"));\n    Args a = Args::from(items, \"prog\");\n    _ = Args::flag(&mut a, \"verbose\", \"v\", \"say m"
    "ore\");\n    match (Args::finish(&mut a))\n    {\n        Err(m) : assert(m == \"unknown option --ver\"),\n"
    "        Ok(_)  : assert(false),\n    }\n}export fn Args::help(ref<Args, shared> a) : String\n{\n    Stri"
    "ng out = String::from_str(\"Usage: \");\n    String::append(&mut out, &a.usage);\n    String::append(&mu"
    "t out, \"\\n\");\n    if (Vec::len(&a.specs) == 0)\n    {\n        return out;\n    }\n    String::append(&m"
    "ut out, \"\\nOptions:\\n\");\n    usize width = 0;\n    foreach (s in &a.specs)\n    {\n        width = max("
    "width, String::len(s));\n    }\n    for (usize i = 0; i < Vec::len(&a.specs); i += 1)\n    {\n        St"
    "ring::append(&mut out, \"  \");\n        String::append(&mut out, &a.specs[i]);\n        for (usize k = "
    "String::len(&a.specs[i]); k < width + 2; k += 1)\n        {\n            String::append(&mut out, \" \")"
    ";\n        }\n        String::append(&mut out, &a.helps[i]);\n        String::append(&mut out, \"\\n\");\n "
    "   }\n    out\n}unittest \"Args::help: the layout\"\n{\n    Args a = Args::from(Vec::new(), \"prog FILE\");\n"
    "    bool verbose = Args::flag(&mut a, \"verbose\", \"v\", \"say more\");\n    Option<String> out = Args::op"
    "tion(&mut a, \"out\", \"\", \"FILE\", \"where to write\");\n    String h = Args::help(&a);\n    assert(h == \"U"
    "sage: prog FILE\\n\\nOptions:\\n\"\n                \"  -v, --verbose   say more\\n\"\n                \"     "
    " --out FILE  where to write\\n\");\n}export fn Rc::new<T>(T v) : Rc<T>\n{\n    rawptr<u8> p = match (allo"
    "cate(sizeof<RcBox<T>>(), alignof<RcBox<T>>()))\n    {\n        Ok(p)  : p,\n        Err(_) : fault(allo"
    "c_failure),\n    };\n    rawptr<RcBox<T>> bp = reinterpret_ptr<RcBox<T>>(p);\n    unsafe\n    {\n        "
    "*bp = RcBox { .count = 1, .weak = 0, .value = Some(v) };\n    }\n    Rc { .ptr = bp }\n}export fn Rc::c"
