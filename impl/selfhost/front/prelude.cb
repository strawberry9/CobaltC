    " i = 0;\n    while (i < 8)\n    {\n        Vec::push(&mut m.slots, max_value<usize>());\n        i = i +"
    " 1;\n    }\n}export fn HashMap::len<K, V>(ref<HashMap<K, V>, shared> m) : usize\n{\n    Vec::len(&m.keys"
