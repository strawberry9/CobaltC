    "ec<u8> lengths = Vec::new();\n    Vec::push_le(&mut lengths, widen<u64>(slice_len(aad)));\n    Vec::pu"
    "sh_le(&mut lengths, widen<u64>(slice_len(ciphertext)));\n    Poly1305::block(&mut p, &lengths, 1 << 2"
