    ",\n    }), Vec::new())\n}export fn rsa_verify_pkcs1v15(\n    ref<RsaPublicKey, shared> key,\n    HashKin"
    "d kind,\n    slice<u8, shared> digest,\n    slice<u8, shared> signature,\n) : bool\n{\n    usize k = (Big"
    "Uint::bit_len(&key.n) + 7) / 8;\n    if (slice_len(signature) != k || slice_len(digest) != hash_len(k"
    "ind))\n    {\n        return false;\n    }\n    Vec<u8> prefix = digest_info_prefix(kind);\n    usize t_l"
    "en = Vec::len(&prefix) + slice_len(digest);\n    if (k < t_len + 11)\n    {\n        return false;\n    "
    "}\n    Vec<u8> want = Vec::new();\n    Vec::push(&mut want, 0);\n    Vec::push(&mut want, 1);\n    for ("
    "usize i = 0; i < k - t_len - 3; i += 1)\n    {\n        Vec::push(&mut want, 0xff);\n    }\n    Vec::pus"
    "h(&mut want, 0);\n    Vec::extend_from(&mut want, &prefix);\n    Vec::extend_from(&mut want, digest);\n"
    "    match (rsa_open(key, signature, k))\n    {\n        Some(em) : digest_eq(&em, &want),\n        None"
    "     : false,\n    }\n}fn mgf1(HashKind kind, slice<u8, shared> seed, usize len) : Vec<u8>\n{\n    Vec<u"
    "8> out = Vec::new();\n    u32 counter = 0;\n    while (Vec::len(&out) < len)\n    {\n        Vec<u8> inp"
    "ut = Vec::from_slice(seed);\n        Vec::push_be(&mut input, counter);\n        Vec<u8> h = hash(kind"
    ", &input);\n        for (usize i = 0; i < Vec::len(&h) && Vec::len(&out) < len; i += 1)\n        {\n   "
    "         Vec::push(&mut out, h[i]);\n        }\n        counter += 1;\n    }\n    out\n}export fn rsa_ver"
    "ify_pss(\n    ref<RsaPublicKey, shared> key,\n    HashKind kind,\n    slice<u8, shared> digest,\n    sli"
    "ce<u8, shared> signature,\n) : bool\n{\n    usize mod_bits = BigUint::bit_len(&key.n);\n    usize k = (m"
    "od_bits + 7) / 8;\n    usize h_len = hash_len(kind);\n    usize s_len = h_len;\n    if (slice_len(signa"
    "ture) != k || slice_len(digest) != h_len || mod_bits < 2)\n    {\n        return false;\n    }\n    usiz"
    "e em_bits = mod_bits - 1;\n    usize em_len = (em_bits + 7) / 8;\n    if (em_len < h_len + s_len + 2)\n"
    "    {\n        return false;\n    }\n    Vec<u8> em = match (rsa_open(key, signature, em_len))\n    {\n  "
    "      Some(e) : e,\n        None    : return false,\n    };\n    if (em[em_len - 1] != 0xbc)\n    {\n    "
    "    return false;\n    }\n    usize db_len = em_len - h_len - 1;\n    u32 unused = narrow<u32>(8 * em_l"
    "en - em_bits);\n    u8 top_mask = narrow_wrapping<u8>((0xff: u32) >> unused);\n    if ((em[0] & ~top_m"
    "ask) != 0)\n    {\n        return false;\n    }\n    Vec<u8> db_mask = mgf1(kind, &em[db_len..db_len + h"
    "_len], db_len);\n    Vec<u8> db = Vec::new();\n    for (usize i = 0; i < db_len; i += 1)\n    {\n       "
    " Vec::push(&mut db, em[i] ^ db_mask[i]);\n    }\n    db[0] = db[0] & top_mask;\n    usize ps_len = em_l"
    "en - h_len - s_len - 2;\n    for (usize i = 0; i < ps_len; i += 1)\n    {\n        if (db[i] != 0)\n    "
    "    {\n            return false;\n        }\n    }\n    if (db[ps_len] != 1)\n    {\n        return false;"
    "\n    }\n    Vec<u8> m2 = Vec::filled(8, 0: u8);\n    Vec::extend_from(&mut m2, digest);\n    Vec::exten"
    "d_from(&mut m2, &db[db_len - s_len..$]);\n    Vec<u8> h2 = hash(kind, &m2);\n    digest_eq(&h2, &em[db"
    "_len..db_len + h_len])\n}fn field_of(EcCurve c, bool order) : Field\n{\n    match (c)\n    {\n        P25"
    "6 : if (order)\n        {\n            Field { .m = [\n                0xf3b9cac2fc632551,\n            "
    "    0xbce6faada7179e84,\n                0xffffffffffffffff,\n                0xffffffff00000000,\n    "
    "            0x0000000000000000,\n                0x0000000000000000,\n            ], .n = 4, .minv = 0"
    "xccd1c8aaee00bc4f, .r2 = [\n                0x83244c95be79eea2,\n                0x4699799c49bd6fa6,\n "
    "               0x2845b2392b6bec59,\n                0x66e12d94f3d95620,\n                0x00000000000"
    "00000,\n                0x0000000000000000,\n            ] }\n        }\n        else\n        {\n        "
    "    Field { .m = [\n                0xffffffffffffffff,\n                0x00000000ffffffff,\n         "
    "       0x0000000000000000,\n                0xffffffff00000001,\n                0x0000000000000000,\n "
    "               0x0000000000000000,\n            ], .n = 4, .minv = 0x0000000000000001, .r2 = [\n      "
    "          0x0000000000000003,\n                0xfffffffbffffffff,\n                0xfffffffffffffffe"
    ",\n                0x00000004fffffffd,\n                0x0000000000000000,\n                0x00000000"
    "00000000,\n            ] }\n        },\n        P384 : if (order)\n        {\n            Field { .m = [\n"
    "                0xecec196accc52973,\n                0x581a0db248b0a77a,\n                0xc7634d81f4"
    "372ddf,\n                0xffffffffffffffff,\n                0xffffffffffffffff,\n                0xff"
    "ffffffffffffff,\n            ], .n = 6, .minv = 0x6ed46089e88fdc45, .r2 = [\n                0x2d319b2"
    "419b409a9,\n                0xff3d81e5df1aa419,\n                0xbc3e483afcb82947,\n                0"
    "xd40d49174aab1cc5,\n                0x3fb05b7a28266895,\n                0x0c84ee012b39bf21,\n         "
    "   ] }\n        }\n        else\n        {\n            Field { .m = [\n                0x00000000fffffff"
    "f,\n                0xffffffff00000000,\n                0xfffffffffffffffe,\n                0xfffffff"
    "fffffffff,\n                0xffffffffffffffff,\n                0xffffffffffffffff,\n            ], .n"
    " = 6, .minv = 0x0000000100000001, .r2 = [\n                0xfffffffe00000001,\n                0x0000"
    "000200000000,\n                0xfffffffe00000000,\n                0x0000000200000000,\n              "
    "  0x0000000000000001,\n                0x0000000000000000,\n            ] }\n        },\n    }\n}fn mont_"
    "mul(ref<Field, shared> f, array<u64, 6> a, array<u64, 6> b) : array<u64, 6>\n{\n    usize n = f.n;\n   "
    " array<u64, 8> t = [0; 8];\n    for (usize i = 0; i < n; i += 1)\n    {\n        u128 c = 0;\n        fo"
    "r (usize j = 0; j < n; j += 1)\n        {\n            u128 x = widen<u128>(t[j]) + widen<u128>(a[j]) "
    "* widen<u128>(b[i]) + c;\n            t[j] = narrow_wrapping<u64>(x);\n            c = x >> 64;\n      "
    "  }\n        u128 y = widen<u128>(t[n]) + c;\n        t[n] = narrow_wrapping<u64>(y);\n        t[n + 1]"
    " = narrow_wrapping<u64>(y >> 64);\n        u64 k = wrapping_mul(t[0], f.minv);\n        u128 z = widen"
    "<u128>(t[0]) + widen<u128>(k) * widen<u128>(f.m[0]);\n        c = z >> 64;\n        for (usize j = 1; "
    "j < n; j += 1)\n        {\n            u128 x = widen<u128>(t[j]) + widen<u128>(k) * widen<u128>(f.m[j"
    "]) + c;\n            t[j - 1] = narrow_wrapping<u64>(x);\n            c = x >> 64;\n        }\n        u"
    "128 w = widen<u128>(t[n]) + c;\n        t[n - 1] = narrow_wrapping<u64>(w);\n        t[n] = t[n + 1] +"
    " narrow_wrapping<u64>(w >> 64);\n    }\n    array<u64, 6> r = [0; 6];\n    for (usize j = 0; j < n; j +"
    "= 1)\n    {\n        r[j] = t[j];\n    }\n    // r - m unless r (with its carry t[n]) is below m: chosen"
    " by a mask.\n    Borrowed d = f_sub_borrow(f, r, f.m);\n    f_select(wrapping_sub(0, (1 - t[n]) & d.bo"
    "rrow), r, d.v)\n}fn f_less(ref<Field, shared> f, array<u64, 6> a, array<u64, 6> b) : bool\n{\n    usize"
    " i = f.n;\n    while (i > 0)\n    {\n        i -= 1;\n        if (a[i] != b[i])\n        {\n            re"
    "turn a[i] < b[i];\n        }\n    }\n    false\n}fn f_sub_borrow(ref<Field, shared> f, array<u64, 6> a, "
    "array<u64, 6> b) : Borrowed\n{\n    array<u64, 6> r = [0; 6];\n    u64 borrow = 0;\n    for (usize i = 0"
    "; i < f.n; i += 1)\n    {\n        u128 x = wrapping_sub(wrapping_sub(widen<u128>(a[i]), widen<u128>(b"
    "[i])), widen<u128>(borrow));\n        r[i] = narrow_wrapping<u64>(x);\n        borrow = narrow_wrappin"
    "g<u64>(x >> 127);\n    }\n    Borrowed { .v = r, .borrow = borrow }\n}fn f_sub_raw(ref<Field, shared> f"
    ", array<u64, 6> a, array<u64, 6> b) : array<u64, 6>\n{\n    f_sub_borrow(f, a, b).v\n}fn f_select(u64 m"
    "ask, array<u64, 6> a, array<u64, 6> b) : array<u64, 6>\n{\n    array<u64, 6> r = [0; 6];\n    for (usiz"
    "e i = 0; i < 6; i += 1)\n    {\n        r[i] = (a[i] & mask) | (b[i] & ~mask);\n    }\n    r\n}fn f_add(r"
    "ef<Field, shared> f, array<u64, 6> a, array<u64, 6> b) : array<u64, 6>\n{\n    array<u64, 6> r = [0; 6"
    "];\n    u64 carry = 0;\n    for (usize i = 0; i < f.n; i += 1)\n    {\n        u128 s = widen<u128>(a[i]"
    ") + widen<u128>(b[i]) + widen<u128>(carry);\n        r[i] = narrow_wrapping<u64>(s);\n        carry = "
    "narrow_wrapping<u64>(s >> 64);\n    }\n    Borrowed d = f_sub_borrow(f, r, f.m);\n    f_select(wrapping"
    "_sub(0, (1 - carry) & d.borrow), r, d.v)\n}fn f_sub(ref<Field, shared> f, array<u64, 6> a, array<u64,"
    " 6> b) : array<u64, 6>\n{\n    Borrowed d = f_sub_borrow(f, a, b);\n    array<u64, 6> m = f_select(wrap"
    "ping_sub(0, d.borrow), f.m, [0; 6]);\n    f_add_raw(f, d.v, m)\n}fn f_add_raw(ref<Field, shared> f, ar"
    "ray<u64, 6> a, array<u64, 6> b) : array<u64, 6>\n{\n    array<u64, 6> r = [0; 6];\n    u64 carry = 0;\n "
    "   for (usize i = 0; i < f.n; i += 1)\n    {\n        u128 s = widen<u128>(a[i]) + widen<u128>(b[i]) +"
    " widen<u128>(carry);\n        r[i] = narrow_wrapping<u64>(s);\n        carry = narrow_wrapping<u64>(s "
    ">> 64);\n    }\n    r\n}fn f_is_zero(ref<Field, shared> f, array<u64, 6> a) : bool\n{\n    u64 acc = 0;\n "
    "   for (usize i = 0; i < f.n; i += 1)\n    {\n        acc = acc | a[i];\n    }\n    acc == 0\n}fn f_to_mo"
    "nt(ref<Field, shared> f, array<u64, 6> a) : array<u64, 6>\n{\n    mont_mul(f, a, f.r2)\n}fn f_from_mont"
    "(ref<Field, shared> f, array<u64, 6> a) : array<u64, 6>\n{\n    mont_mul(f, a, [1, 0, 0, 0, 0, 0])\n}fn"
    " f_invert(ref<Field, shared> f, array<u64, 6> a) : array<u64, 6>\n{\n    array<u64, 6> e = f_sub_raw(f"
    ", f.m, [2, 0, 0, 0, 0, 0]);\n    array<u64, 6> r = f_to_mont(f, [1, 0, 0, 0, 0, 0]);\n    usize bits ="
    " 64 * f.n;\n    usize i = bits;\n    while (i > 0)\n    {\n        i -= 1;\n        r = mont_mul(f, r, r)"
    ";\n        if (((e[i / 64] >> narrow<u32>(i % 64)) & 1) == 1)\n        {\n            r = mont_mul(f, r"
    ", a);\n        }\n    }\n    r\n}fn f_from_be(ref<Field, shared> f, slice<u8, shared> b) : Option<array<"
    "u64, 6>>\n{\n    usize len = slice_len(b);\n    if (len > 8 * f.n)\n    {\n        return None;\n    }\n   "
    " array<u64, 6> r = [0; 6];\n    for (usize k = 0; k < len; k += 1)\n    {\n        usize pos = len - 1 "
    "- k;\n        r[k / 8] = r[k / 8] | (widen<u64>(b[pos]) << narrow<u32>(8 * (k % 8)));\n    }\n    if (!"
    "f_less(f, r, f.m))\n    {\n        return None;\n    }\n    Some(r)\n}fn f_bit(array<u64, 6> a, usize i) "
    ": bool\n{\n    ((a[i / 64] >> narrow<u32>(i % 64)) & 1) == 1\n}fn f_small(ref<Field, shared> f, u64 k, "
    "array<u64, 6> a) : array<u64, 6>\n{\n    array<u64, 6> r = a;\n    u32 top = 63 - leading_zeros(k);\n   "
    " u32 i = top;\n    while (i > 0)\n    {\n        i -= 1;\n        r = f_add(f, r, r);\n        if (((k >>"
    " i) & 1) == 1)\n        {\n            r = f_add(f, r, a);\n        }\n    }\n    r\n}fn jac_double(ref<Fi"
    "eld, shared> f, Jacobian q) : Jacobian\n{\n    if (f_is_zero(f, q.z) || f_is_zero(f, q.y))\n    {\n     "
    "   return Jacobian { .x = q.x, .y = q.y, .z = [0; 6] };\n    }\n    array<u64, 6> delta = mont_mul(f, "
    "q.z, q.z);\n    array<u64, 6> gamma = mont_mul(f, q.y, q.y);\n    array<u64, 6> beta = mont_mul(f, q.x"
    ", gamma);\n    array<u64, 6> alpha = f_small(f, 3, mont_mul(f, f_sub(f, q.x, delta), f_add(f, q.x, de"
    "lta)));\n    array<u64, 6> x3 = f_sub(f, mont_mul(f, alpha, alpha), f_small(f, 8, beta));\n    array<u"
    "64, 6> yz = f_add(f, q.y, q.z);\n    array<u64, 6> z3 = f_sub(f, f_sub(f, mont_mul(f, yz, yz), gamma)"
    ", delta);\n    array<u64, 6> y3 = f_sub(\n        f,\n        mont_mul(f, alpha, f_sub(f, f_small(f, 4,"
    " beta), x3)),\n        f_small(f, 8, mont_mul(f, gamma, gamma)),\n    );\n    Jacobian { .x = x3, .y = "
    "y3, .z = z3 }\n}fn jac_add(ref<Field, shared> f, Jacobian a, Jacobian b) : Jacobian\n{\n    if (f_is_ze"
    "ro(f, a.z))\n    {\n        return b;\n    }\n    if (f_is_zero(f, b.z))\n    {\n        return a;\n    }\n "
    "   array<u64, 6> z1z1 = mont_mul(f, a.z, a.z);\n    array<u64, 6> z2z2 = mont_mul(f, b.z, b.z);\n    a"
    "rray<u64, 6> u1 = mont_mul(f, a.x, z2z2);\n    array<u64, 6> u2 = mont_mul(f, b.x, z1z1);\n    array<u"
    "64, 6> s1 = mont_mul(f, mont_mul(f, a.y, b.z), z2z2);\n    array<u64, 6> s2 = mont_mul(f, mont_mul(f,"
    " b.y, a.z), z1z1);\n    array<u64, 6> h = f_sub(f, u2, u1);\n    array<u64, 6> r = f_small(f, 2, f_sub"
    "(f, s2, s1));\n    if (f_is_zero(f, h))\n    {\n        if (f_is_zero(f, r))\n        {\n            retu"
    "rn jac_double(f, a);\n        }\n        return Jacobian { .x = a.x, .y = a.y, .z = [0; 6] };\n    }\n  "
    "  array<u64, 6> h2 = f_small(f, 2, h);\n    array<u64, 6> i = mont_mul(f, h2, h2);\n    array<u64, 6> "
    "j = mont_mul(f, h, i);\n    array<u64, 6> v = mont_mul(f, u1, i);\n    array<u64, 6> x3 = f_sub(f, f_s"
    "ub(f, mont_mul(f, r, r), j), f_small(f, 2, v));\n    array<u64, 6> y3 = f_sub(f, mont_mul(f, r, f_sub"
    "(f, v, x3)), f_small(f, 2, mont_mul(f, s1, j)));\n    array<u64, 6> zs = f_add(f, a.z, b.z);\n    arra"
    "y<u64, 6> z3 = mont_mul(f, f_sub(f, f_sub(f, mont_mul(f, zs, zs), z1z1), z2z2), h);\n    Jacobian { ."
    "x = x3, .y = y3, .z = z3 }\n}fn jac_table(ref<Field, shared> f, Jacobian p) : Vec<Jacobian>\n{\n    Vec"
    "<Jacobian> t = Vec::new();\n    Vec::push(&mut t, Jacobian { .x = p.x, .y = p.y, .z = [0; 6] });\n    "
    "Vec::push(&mut t, p);\n    for (usize i = 2; i < 16; i += 1)\n    {\n        Jacobian next = if (i % 2 "
    "== 0) { jac_double(f, t[i / 2]) } else { jac_add(f, t[i - 1], p) };\n        Vec::push(&mut t, next);"
    "\n    }\n    t\n}fn f_nibble(array<u64, 6> a, usize w) : usize\n{\n    narrow<usize>((a[w / 16] >> narrow"
    "<u32>(4 * (w % 16))) & 15)\n}fn jac_twin(ref<Field, shared> f, array<u64, 6> u1, Jacobian g, array<u6"
    "4, 6> u2, Jacobian q, usize bits) : Jacobian\n{\n    Vec<Jacobian> tg = jac_table(f, g);\n    Vec<Jacob"
    "ian> tq = jac_table(f, q);\n    Jacobian acc = tg[0];\n    usize w = bits / 4;\n    while (w > 0)\n    {"
    "\n        w -= 1;\n        for (usize k = 0; k < 4; k += 1)\n        {\n            acc = jac_double(f, "
    "acc);\n        }\n        usize d1 = f_nibble(u1, w);\n        usize d2 = f_nibble(u2, w);\n        if ("
    "d1 != 0)\n        {\n            acc = jac_add(f, acc, tg[d1]);\n        }\n        if (d2 != 0)\n       "
    " {\n            acc = jac_add(f, acc, tq[d2]);\n        }\n    }\n    acc\n}fn jac_twin_bits(\n    ref<Fie"
    "ld, shared> f,\n    array<u64, 6> u1,\n    Jacobian g,\n    array<u64, 6> u2,\n    Jacobian q,\n    usize"
    " bits,\n) : Jacobian\n{\n    Jacobian gq = jac_add(f, g, q);\n    Jacobian acc = Jacobian { .x = g.x, .y"
    " = g.y, .z = [0; 6] };\n    usize i = bits;\n    while (i > 0)\n    {\n        i -= 1;\n        acc = jac"
    "_double(f, acc);\n        bool b1 = f_bit(u1, i);\n        bool b2 = f_bit(u2, i);\n        if (b1 && b"
    "2)\n        {\n            acc = jac_add(f, acc, gq);\n        }\n        else if (b1)\n        {\n       "
    "     acc = jac_add(f, acc, g);\n        }\n        else if (b2)\n        {\n            acc = jac_add(f,"
    " acc, q);\n        }\n    }\n    acc\n}fn curve_hex(ref<Field, shared> f, str hex) : array<u64, 6>\n{\n   "
    " Vec<u8> b = Result::unwrap_or(from_hex(StringView::of(hex)), Vec::new());\n    Option::unwrap(f_from"
    "_be(f, &b))\n}fn der_positive_int(slice<u8, shared> d, usize at) : Option<DerSpan>\n{\n    if (at + 2 >"
    " slice_len(d) || d[at] != 0x02)\n    {\n        return None;\n    }\n    usize len = widen<usize>(d[at +"
    " 1]);\n    usize start = at + 2;\n    if (len == 0 || len > 0x7f || start + len > slice_len(d))\n    {\n"
    "        return None;\n    }\n    if ((d[start] & 0x80) != 0)\n    {\n        return None;\n    }\n    if ("
    "len > 1 && d[start] == 0 && (d[start + 1] & 0x80) == 0)\n    {\n        return None;\n    }\n    // A le"
    "ading zero byte only marks the number positive.\n    usize from = if (d[start] == 0 && len > 1) { sta"
    "rt + 1 } else { start };\n    Some(DerSpan { .start = from, .end = start + len })\n}export fn ecdsa_ve"
    "rify(\n    EcCurve curve,\n    slice<u8, shared> public_key,\n    slice<u8, shared> digest,\n    slice<u"
    "8, shared> signature,\n) : bool\n{\n    Field fp = field_of(curve, false);\n    Field fn_ = field_of(cur"
    "ve, true);\n    usize size = 8 * fp.n;\n    if (slice_len(public_key) != 1 + 2 * size || public_key[0]"
    " != 0x04)\n    {\n        return false;\n    }\n    array<u64, 6> qx = match (f_from_be(&fp, &public_key"
    "[1..1 + size]))\n    {\n        Some(v) : f_to_mont(&fp, v),\n        None    : return false,\n    };\n  "
    "  array<u64, 6> qy = match (f_from_be(&fp, &public_key[1 + size..$]))\n    {\n        Some(v) : f_to_m"
    "ont(&fp, v),\n        None    : return false,\n    };\n    str b_hex = match (curve)\n    {\n        P256"
    " : \"5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b\",\n        P384 : \"b3312fa7e23ee"
    "7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef\",\n    };\n    arr"
    "ay<u64, 6> b = f_to_mont(&fp, curve_hex(&fp, b_hex));\n    // y² = x³ - 3x + b\n    array<u64, 6> lh"
    "s = mont_mul(&fp, qy, qy);\n    array<u64, 6> rhs = f_add(&fp, f_sub(&fp, mont_mul(&fp, mont_mul(&fp,"
    " qx, qx), qx), f_small(&fp, 3, qx)), b);\n    if (!f_is_zero(&fp, f_sub(&fp, lhs, rhs)))\n    {\n      "
    "  return false;\n    }\n    usize sl = slice_len(signature);\n    if (sl < 8 || signature[0] != 0x30 ||"
    " signature[1] > 0x7f || widen<usize>(signature[1]) != sl - 2)\n    {\n        return false;\n    }\n    "
    "DerSpan rs = match (der_positive_int(signature, 2))\n    {\n        Some(v) : v,\n        None    : ret"
    "urn false,\n    };\n    DerSpan ss = match (der_positive_int(signature, rs.end))\n    {\n        Some(v)"
    " : v,\n        None    : return false,\n    };\n    if (ss.end != sl)\n    {\n        return false;\n    }"
    "\n    array<u64, 6> r = match (f_from_be(&fn_, &signature[rs.start..rs.end]))\n    {\n        Some(v) :"
    " v,\n        None    : return false,\n    };\n    array<u64, 6> s = match (f_from_be(&fn_, &signature[s"
    "s.start..ss.end]))\n    {\n        Some(v) : v,\n        None    : return false,\n    };\n    if (f_is_ze"
    "ro(&fn_, r) || f_is_zero(&fn_, s))\n    {\n        return false;\n    }\n    // e: the digest's leftmost"
    " 8·size bits (the order's bit length is the\n    // prime's for both curves), reduced once below n.\n"
    "    usize take = min(slice_len(digest), size);\n    array<u64, 6> e = [0; 6];\n    for (usize k = 0; k"
    " < take; k += 1)\n    {\n        usize pos = take - 1 - k;\n        e[k / 8] = e[k / 8] | (widen<u64>(d"
    "igest[pos]) << narrow<u32>(8 * (k % 8)));\n    }\n    if (!f_less(&fn_, e, fn_.m))\n    {\n        e = f"
    "_sub_raw(&fn_, e, fn_.m);\n    }\n    array<u64, 6> w = f_invert(&fn_, f_to_mont(&fn_, s));\n    array<"
    "u64, 6> u1 = f_from_mont(&fn_, mont_mul(&fn_, f_to_mont(&fn_, e), w));\n    array<u64, 6> u2 = f_from"
    "_mont(&fn_, mont_mul(&fn_, f_to_mont(&fn_, r), w));\n    str gx = match (curve)\n    {\n        P256 : "
    "\"6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296\",\n        P384 : \"aa87ca22be8b0537"
    "8eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7\",\n    };\n    str gy"
    " = match (curve)\n    {\n        P256 : \"4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf5"
    "1f5\",\n        P384 : \"3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e81"
    "9d7a431d7c90ea0e5f\",\n    };\n    array<u64, 6> one = f_to_mont(&fp, [1, 0, 0, 0, 0, 0]);\n    Jacobian"
    " g = Jacobian { .x = f_to_mont(\n        &fp,\n        curve_hex(&fp, gx),\n    ), .y = f_to_mont(&fp, "
    "curve_hex(&fp, gy)), .z = one };\n    Jacobian q = Jacobian { .x = qx, .y = qy, .z = one };\n    Jacob"
    "ian p = jac_twin(&fp, u1, g, u2, q, size * 8);\n    if (f_is_zero(&fp, p.z))\n    {\n        return fal"
    "se;\n    }\n    // x mod n = r, without inverting Z: x = X/Z², and x mod n is r exactly\n    // when x"
    " is r or (as x < p < 2n for both curves) r + n, the latter only\n    // possible when r + n < p. So c"
    "ompare X with r·Z² and (r + n)·Z².\n    array<u64, 6> z2 = mont_mul(&fp, p.z, p.z);\n    if (f_is_"
    "zero(&fp, f_sub(&fp, p.x, mont_mul(&fp, f_to_mont(&fp, r), z2))))\n    {\n        return true;\n    }\n "
    "   array<u64, 6> rn = f_add_raw(&fp, r, fn_.m);\n    if (f_less(&fn_, rn, fp.m) && f_less(&fn_, r, rn"
    "))\n    {\n        return f_is_zero(&fp, f_sub(&fp, p.x, mont_mul(&fp, f_to_mont(&fp, rn), z2)));\n    "
    "}\n    false\n}fn curve_b_hex(EcCurve c) : str\n{\n    match (c)\n    {\n        P256 : \"5ac635d8aa3a93e7b"
    "3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b\",\n        P384 : \"b3312fa7e23ee7e4988e056be3f82d1918"
    "1d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef\",\n    }\n}fn curve_base(ref<Field, sha"
    "red> fp, EcCurve c) : Jacobian\n{\n    str gx = match (c)\n    {\n        P256 : \"6b17d1f2e12c4247f8bce6"
    "e563a440f277037d812deb33a0f4a13945d898c296\",\n        P384 : \"aa87ca22be8b05378eb1c71ef320ad746e1d3b6"
    "28ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7\",\n    };\n    str gy = match (c)\n    {\n    "
    "    P256 : \"4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5\",\n        P384 : \"3617d"
    "e4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f\",\n    };"
    "\n    Jacobian { .x = f_to_mont(\n        fp,\n        curve_hex(fp, gx),\n    ), .y = f_to_mont(fp, cur"
    "ve_hex(fp, gy)), .z = f_to_mont(fp, [1, 0, 0, 0, 0, 0]) }\n}fn curve_point(ref<Field, shared> fp, EcC"
    "urve c, slice<u8, shared> public_key) : Option<Jacobian>\n{\n    usize size = 8 * fp.n;\n    if (slice_"
    "len(public_key) != 1 + 2 * size || public_key[0] != 0x04)\n    {\n        return None;\n    }\n    array"
    "<u64, 6> qx = f_to_mont(fp, f_from_be(fp, &public_key[1..1 + size])?);\n    array<u64, 6> qy = f_to_m"
    "ont(fp, f_from_be(fp, &public_key[1 + size..$])?);\n    array<u64, 6> b = f_to_mont(fp, curve_hex(fp,"
    " curve_b_hex(c)));\n    array<u64, 6> lhs = mont_mul(fp, qy, qy);\n    array<u64, 6> rhs = f_add(fp, f"
    "_sub(fp, mont_mul(fp, mont_mul(fp, qx, qx), qx), f_small(fp, 3, qx)), b);\n    if (!f_is_zero(fp, f_s"
    "ub(fp, lhs, rhs)))\n    {\n        return None;\n    }\n    Some(Jacobian { .x = qx, .y = qy, .z = f_to_"
    "mont(fp, [1, 0, 0, 0, 0, 0]) })\n}fn jac_select(u64 mask, Jacobian a, Jacobian b) : Jacobian\n{\n    Ja"
    "cobian { .x = f_select(mask, a.x, b.x), .y = f_select(mask, a.y, b.y), .z = f_select(mask, a.z, b.z)"
    " }\n}fn limbs7_add(array<u64, 7> a, array<u64, 7> b) : array<u64, 7>\n{\n    array<u64, 7> r = [0; 7];\n"
    "    u64 carry = 0;\n    for (usize i = 0; i < 7; i += 1)\n    {\n        u128 s = widen<u128>(a[i]) + w"
    "iden<u128>(b[i]) + widen<u128>(carry);\n        r[i] = narrow_wrapping<u64>(s);\n        carry = narro"
    "w_wrapping<u64>(s >> 64);\n    }\n    r\n}fn ec_mul(ref<Field, shared> fp, ref<Field, shared> fn_, arra"
    "y<u64, 6> k, Jacobian p) : Jacobian\n{\n    usize bits = 64 * fp.n;\n    array<u64, 7> n7 = [fn_.m[0], "
    "fn_.m[1], fn_.m[2], fn_.m[3], fn_.m[4], fn_.m[5], 0];\n    array<u64, 7> k1 = limbs7_add([k[0], k[1],"
    " k[2], k[3], k[4], k[5], 0], n7);\n    array<u64, 7> k2 = limbs7_add(k1, n7);\n    // k + n when that "
    "reaches 2^bits, k + 2n otherwise: bit `bits` is set\n    // and nothing above it.\n    u64 mask = wrap"
    "ping_sub(0, k1[bits / 64] & 1);\n    array<u64, 7> kh = [0; 7];\n    for (usize i = 0; i < 7; i += 1)\n"
    "    {\n        kh[i] = (k1[i] & mask) | (k2[i] & ~mask);\n    }\n    Jacobian acc = p;\n    usize i = bi"
    "ts;\n    while (i > 0)\n    {\n        i -= 1;\n        acc = jac_double(fp, acc);\n        Jacobian sum "
    "= jac_add(fp, acc, p);\n        u64 bit = (kh[i / 64] >> narrow<u32>(i % 64)) & 1;\n        acc = jac_"
    "select(wrapping_sub(0, bit), sum, acc);\n    }\n    acc\n}fn limbs_be(array<u64, 6> a, usize len) : Vec"
    "<u8>\n{\n    Vec<u8> b = Vec::filled(len, 0: u8);\n    for (usize i = 0; i < len; i += 1)\n    {\n       "
    " b[len - 1 - i] = narrow_wrapping<u8>(a[i / 8] >> narrow<u32>(8 * (i % 8)));\n    }\n    b\n}fn ec_scal"
    "ar(ref<Field, shared> fn_, slice<u8, shared> private_key) : Option<array<u64, 6>>\n{\n    if (slice_le"
    "n(private_key) != 8 * fn_.n)\n    {\n        fault(crypto_length);\n    }\n    match (f_from_be(fn_, pri"
    "vate_key))\n    {\n        Some(k) : if (f_is_zero(fn_, k)) { None } else { Some(k) },\n        None   "
    " : None,\n    }\n}fn ec_affine(ref<Field, shared> fp, Jacobian q) : array<array<u64, 6>, 2>\n{\n    arra"
    "y<u64, 6> zinv = f_invert(fp, q.z);\n    array<u64, 6> zinv2 = mont_mul(fp, zinv, zinv);\n    array<u6"
    "4, 6> x = f_from_mont(fp, mont_mul(fp, q.x, zinv2));\n    array<u64, 6> y = f_from_mont(fp, mont_mul("
    "fp, q.y, mont_mul(fp, zinv2, zinv)));\n    [x, y]\n}export fn ec_private_key(EcCurve curve) : Vec<u8>\n"
    "{\n    Field fn_ = field_of(curve, true);\n    Vec<u8> k = Vec::filled(8 * fn_.n, 0: u8);\n    while (t"
    "rue)\n    {\n        os_random_bytes(&mut k);\n        if (Option::is_some(&ec_scalar(&fn_, &k)))\n     "
    "   {\n            return k;\n        }\n    }\n}export fn ec_public_key(EcCurve curve, slice<u8, shared>"
    " private_key) : Option<Vec<u8>>\n{\n    Field fp = field_of(curve, false);\n    Field fn_ = field_of(cu"
    "rve, true);\n    array<u64, 6> k = ec_scalar(&fn_, private_key)?;\n    usize size = 8 * fp.n;\n    arra"
    "y<array<u64, 6>, 2> xy = ec_affine(&fp, ec_mul(&fp, &fn_, k, curve_base(&fp, curve)));\n    Vec<u8> o"
    "ut = Vec::new();\n    Vec::push(&mut out, 0x04);\n    Vec::extend_from(&mut out, &limbs_be(xy[0], size"
    "));\n    Vec::extend_from(&mut out, &limbs_be(xy[1], size));\n    Some(out)\n}unittest \"ec_public_key: "
    "a scalar outside [1, n-1] has none\"\n{\n    array<u8, 32> zero = [0; 32];\n    assert(Option::is_none(&"
    "ec_public_key(P256, &zero)));\n    array<u8, 32> above = [0xff; 32];\n    assert(Option::is_none(&ec_p"
    "ublic_key(P256, &above)));\n}export fn ecdh(EcCurve curve, slice<u8, shared> private_key, slice<u8, s"
    "hared> public_key) : Option<Vec<u8>>\n{\n    Field fp = field_of(curve, false);\n    Field fn_ = field_"
    "of(curve, true);\n    array<u64, 6> k = ec_scalar(&fn_, private_key)?;\n    Jacobian q = curve_point(&"
    "fp, curve, public_key)?;\n    Jacobian r = ec_mul(&fp, &fn_, k, q);\n    if (f_is_zero(&fp, r.z))\n    "
    "{\n        return None;\n    }\n    Some(limbs_be(ec_affine(&fp, r)[0], 8 * fp.n))\n}export fn p256_priv"
    "ate_key() : array<u8, 32>\n{\n    Vec<u8> k = ec_private_key(P256);\n    array<u8, 32> out = [0; 32];\n "
    "   for (usize i = 0; i < 32; i += 1)\n    {\n        out[i] = k[i];\n    }\n    out\n}export fn p256_publ"
    "ic_key(slice<u8, shared> private_key) : Option<array<u8, 65>>\n{\n    Vec<u8> q = ec_public_key(P256, "
    "private_key)?;\n    array<u8, 65> out = [0; 65];\n    for (usize i = 0; i < 65; i += 1)\n    {\n        "
    "out[i] = q[i];\n    }\n    Some(out)\n}export fn p256_ecdh(slice<u8, shared> private_key, slice<u8, sha"
    "red> public_key) : Option<array<u8, 32>>\n{\n    Vec<u8> z = ecdh(P256, private_key, public_key)?;\n   "
    " array<u8, 32> out = [0; 32];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        out[i] = z[i];\n   "
    " }\n    Some(out)\n}fn digest_scalar(ref<Field, shared> fn_, slice<u8, shared> digest, usize size) : a"
    "rray<u64, 6>\n{\n    usize take = min(slice_len(digest), size);\n    array<u64, 6> e = [0; 6];\n    for "
    "(usize k = 0; k < take; k += 1)\n    {\n        usize pos = take - 1 - k;\n        e[k / 8] = e[k / 8] "
    "| (widen<u64>(digest[pos]) << narrow<u32>(8 * (k % 8)));\n    }\n    if (!f_less(fn_, e, fn_.m))\n    {"
    "\n        e = f_sub_raw(fn_, e, fn_.m);\n    }\n    e\n}fn der_push_uint(ref<Vec<u8>, exclusive> out, sl"
    "ice<u8, shared> v)\n{\n    usize from = 0;\n    while (from + 1 < slice_len(v) && v[from] == 0)\n    {\n "
    "       from += 1;\n    }\n    bool pad = (v[from] & 0x80) != 0;\n    Vec::push(out, 0x02);\n    Vec::pus"
    "h(out, narrow<u8>(slice_len(v) - from + (if (pad) { 1 } else { 0 })));\n    if (pad)\n    {\n        Ve"
    "c::push(out, 0);\n    }\n    Vec::extend_from(out, &v[from..$]);\n}export fn ecdsa_sign(EcCurve curve, "
    "slice<u8, shared> private_key, slice<u8, shared> digest) : Option<Vec<u8>>\n{\n    Field fp = field_of"
    "(curve, false);\n    Field fn_ = field_of(curve, true);\n    usize size = 8 * fp.n;\n    array<u64, 6> "
    "x = ec_scalar(&fn_, private_key)?;\n    HashKind kind = match (curve)\n    {\n        P256 : Sha2_256,\n"
    "        P384 : Sha2_384,\n    };\n    array<u64, 6> e = digest_scalar(&fn_, digest, size);\n    Vec<u8>"
    " x_bytes = limbs_be(x, size);\n    Vec<u8> e_bytes = limbs_be(e, size);\n    Jacobian g = curve_base(&"
    "fp, curve);\n    array<u64, 6> xm = f_to_mont(&fn_, x);\n    array<u64, 6> em = f_to_mont(&fn_, e);\n  "
    "  // RFC 6979 §3.2 steps b to h.\n    usize hlen = hash_len(kind);\n    Vec<u8> v = Vec::filled(hlen,"
    " 1: u8);\n    Vec<u8> key = Vec::filled(hlen, 0: u8);\n    for (u8 round = 0; round < 2; round += 1)\n "
    "   {\n        Hmac m = Hmac::new(kind, &key);\n        Hmac::update(&mut m, &v);\n        array<u8, 1> "
    "sep = [round];\n        Hmac::update(&mut m, &sep);\n        Hmac::update(&mut m, &x_bytes);\n        H"
    "mac::update(&mut m, &e_bytes);\n        overwrite(&mut key, Hmac::finish(m));\n        overwrite(&mut "
    "v, hmac(kind, &key, &v));\n    }\n    while (true)\n    {\n        overwrite(&mut v, hmac(kind, &key, &v"
    "));\n        // T is V itself: the hash is as long as the order for both curves.\n        Option<array"
    "<u64, 6>> candidate = f_from_be(&fn_, &v[0..size]);\n        if (Some(k) = candidate)\n        {\n     "
    "       if (!f_is_zero(&fn_, k))\n            {\n                array<u64, 6> r = ec_affine(&fp, ec_mu"
    "l(&fp, &fn_, k, g))[0];\n                if (!f_less(&fn_, r, fn_.m))\n                {\n             "
    "       r = f_sub_raw(&fn_, r, fn_.m);\n                }\n                if (!f_is_zero(&fn_, r))\n   "
    "             {\n                    array<u64, 6> kinv = f_invert(&fn_, f_to_mont(&fn_, k));\n        "
    "            array<u64, 6> rx = mont_mul(&fn_, f_to_mont(&fn_, r), xm);\n                    array<u64"
    ", 6> s = f_from_mont(&fn_, mont_mul(&fn_, kinv, f_add(&fn_, em, rx)));\n                    if (!f_is"
    "_zero(&fn_, s))\n                    {\n                        Vec<u8> body = Vec::new();\n           "
    "             der_push_uint(&mut body, &limbs_be(r, size));\n                        der_push_uint(&mu"
    "t body, &limbs_be(s, size));\n                        Vec<u8> out = Vec::new();\n                     "
    "   Vec::push(&mut out, 0x30);\n                        Vec::push(&mut out, narrow<u8>(Vec::len(&body)"
    "));\n                        Vec::extend_from(&mut out, &body);\n                        return Some(o"
    "ut);\n                    }\n                }\n            }\n        }\n        Hmac m = Hmac::new(kind"
    ", &key);\n        Hmac::update(&mut m, &v);\n        array<u8, 1> zero = [0];\n        Hmac::update(&mu"
    "t m, &zero);\n        overwrite(&mut key, Hmac::finish(m));\n        overwrite(&mut v, hmac(kind, &key"
    ", &v));\n    }\n}fn fe_neg(array<u64, 5> a) : array<u64, 5>\n{\n    fe_sub([0, 0, 0, 0, 0], a)\n}fn fe_is"
    "_zero(array<u64, 5> a) : bool\n{\n    array<u8, 32> b = fe_to_bytes(a);\n    u8 acc = 0;\n    for (usize"
    " i = 0; i < 32; i += 1)\n    {\n        acc = acc | b[i];\n    }\n    acc == 0\n}fn fe_eq(array<u64, 5> a"
    ", array<u64, 5> b) : bool\n{\n    fe_is_zero(fe_sub(a, b))\n}fn fe_select(u64 mask, array<u64, 5> a, ar"
    "ray<u64, 5> b) : array<u64, 5>\n{\n    array<u64, 5> r = [0; 5];\n    for (usize i = 0; i < 5; i += 1)\n"
    "    {\n        r[i] = (a[i] & mask) | (b[i] & ~mask);\n    }\n    r\n}fn fe_pow_p58(array<u64, 5> z) : a"
    "rray<u64, 5>\n{\n    array<u64, 5> r = [1, 0, 0, 0, 0];\n    for (usize k = 0; k < 252; k += 1)\n    {\n "
    "       usize i = 251 - k;\n        r = fe_mul(r, r);\n        if (i != 1)\n        {\n            r = fe"
    "_mul(r, z);\n        }\n    }\n    r\n}fn ed_identity() : Ed\n{\n    Ed { .x = [0, 0, 0, 0, 0], .y = [1, 0"
    ", 0, 0, 0], .z = [1, 0, 0, 0, 0], .t = [0, 0, 0, 0, 0] }\n}fn ed_base() : Ed\n{\n    Ed { .x = ED_BX, ."
    "y = ED_BY, .z = [1, 0, 0, 0, 0], .t = fe_mul(ED_BX, ED_BY) }\n}fn ed_add(Ed p, Ed q) : Ed\n{\n    array"
    "<u64, 5> a = fe_mul(fe_sub(p.y, p.x), fe_sub(q.y, q.x));\n    array<u64, 5> b = fe_mul(fe_add(p.y, p."
    "x), fe_add(q.y, q.x));\n    array<u64, 5> c = fe_mul(fe_mul(p.t, ED_2D), q.t);\n    array<u64, 5> d = "
    "fe_mul(fe_add(p.z, p.z), q.z);\n    array<u64, 5> e = fe_sub(b, a);\n    array<u64, 5> f = fe_sub(d, c"
    ");\n    array<u64, 5> g = fe_add(d, c);\n    array<u64, 5> h = fe_add(b, a);\n    Ed { .x = fe_mul(e, f"
    "), .y = fe_mul(g, h), .z = fe_mul(f, g), .t = fe_mul(e, h) }\n}fn ed_double(Ed p) : Ed\n{\n    array<u6"
    "4, 5> a = fe_mul(p.x, p.x);\n    array<u64, 5> b = fe_mul(p.y, p.y);\n    array<u64, 5> zz = fe_mul(p."
    "z, p.z);\n    array<u64, 5> c = fe_add(zz, zz);\n    array<u64, 5> h = fe_add(a, b);\n    array<u64, 5>"
    " xy = fe_add(p.x, p.y);\n    array<u64, 5> e = fe_sub(h, fe_mul(xy, xy));\n    array<u64, 5> g = fe_su"
    "b(a, b);\n    array<u64, 5> f = fe_add(c, g);\n    Ed { .x = fe_mul(e, f), .y = fe_mul(g, h), .z = fe_"
    "mul(f, g), .t = fe_mul(e, h) }\n}fn ed_select(u64 mask, Ed a, Ed b) : Ed\n{\n    Ed { .x = fe_select(\n "
    "       mask,\n        a.x,\n        b.x,\n    ), .y = fe_select(mask, a.y, b.y), .z = fe_select(mask, a"
    ".z, b.z), .t = fe_select(mask, a.t, b.t) }\n}fn ed_mul(slice<u8, shared> scalar, Ed p) : Ed\n{\n    Ed "
    "acc = ed_identity();\n    usize i = 256;\n    while (i > 0)\n    {\n        i -= 1;\n        acc = ed_dou"
    "ble(acc);\n        Ed sum = ed_add(acc, p);\n        u64 bit = widen<u64>((scalar[i / 8] >> narrow<u32"
    ">(i % 8)) & 1);\n        acc = ed_select(wrapping_sub(0, bit), sum, acc);\n    }\n    acc\n}fn ed_encode"
    "(Ed p) : array<u8, 32>\n{\n    array<u64, 5> zinv = fe_invert(p.z);\n    array<u8, 32> out = fe_to_byte"
    "s(fe_mul(p.y, zinv));\n    array<u8, 32> xb = fe_to_bytes(fe_mul(p.x, zinv));\n    out[31] = out[31] |"
    " ((xb[0] & 1) << 7);\n    out\n}fn ed_decode(slice<u8, shared> b) : Option<Ed>\n{\n    array<u64, 5> y ="
    " fe_from_bytes(b);\n    array<u8, 32> canon = fe_to_bytes(y);\n    u8 diff = 0;\n    for (usize i = 0; "
    "i < 31; i += 1)\n    {\n        diff = diff | (canon[i] ^ b[i]);\n    }\n    diff = diff | (canon[31] ^ "
    "(b[31] & 0x7f));\n    if (diff != 0)\n    {\n        return None;\n    }\n    u8 sign = b[31] >> 7;\n    a"
    "rray<u64, 5> y2 = fe_mul(y, y);\n    array<u64, 5> u = fe_sub(y2, [1, 0, 0, 0, 0]);\n    array<u64, 5>"
    " v = fe_add(fe_mul(ED_D, y2), [1, 0, 0, 0, 0]);\n    array<u64, 5> v3 = fe_mul(fe_mul(v, v), v);\n    "
    "array<u64, 5> v7 = fe_mul(fe_mul(v3, v3), v);\n    array<u64, 5> x = fe_mul(fe_mul(u, v3), fe_pow_p58"
    "(fe_mul(u, v7)));\n    array<u64, 5> vx2 = fe_mul(v, fe_mul(x, x));\n    if (!fe_eq(vx2, u))\n    {\n   "
    "     if (!fe_eq(vx2, fe_neg(u)))\n        {\n            return None;\n        }\n        x = fe_mul(x, "
    "ED_SQRT_M1);\n    }\n    array<u8, 32> xb = fe_to_bytes(x);\n    if ((xb[0] & 1) == 0 && sign == 1 && f"
    "e_is_zero(x))\n    {\n        return None;\n    }\n    if ((xb[0] & 1) != sign)\n    {\n        x = fe_neg"
    "(x);\n    }\n    Some(Ed { .x = x, .y = y, .z = [1, 0, 0, 0, 0], .t = fe_mul(x, y) })\n}fn ed_order() :"
    " Field\n{\n    Field { .m = [\n        0x5812631a5cf5d3ed,\n        0x14def9dea2f79cd6,\n        0x000000"
    "0000000000,\n        0x1000000000000000,\n        0x0000000000000000,\n        0x0000000000000000,\n    "
    "], .n = 4, .minv = 0xd2b51da312547e1b, .r2 = [\n        0xa40611e3449c0f01,\n        0xd00e1ba76885934"
    "7,\n        0xceec73d217f5be65,\n        0x0399411b7c309a3d,\n        0x0000000000000000,\n        0x000"
    "0000000000000,\n    ] }\n}fn le_limbs(slice<u8, shared> b) : array<u64, 6>\n{\n    array<u64, 6> r = [0;"
    " 6];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        r[i / 8] = r[i / 8] | (widen<u64>(b[i]) << "
    "narrow<u32>(8 * (i % 8)));\n    }\n    r\n}fn sc_mont(ref<Field, shared> fl, array<u64, 6> a) : array<u"
    "64, 6>\n{\n    mont_mul(fl, a, fl.r2)\n}fn sc_from_hash(ref<Field, shared> fl, slice<u8, shared> h) : a"
    "rray<u64, 6>\n{\n    array<u64, 6> lo = sc_mont(fl, le_limbs(&h[0..32]));\n    array<u64, 6> hi = sc_mo"
    "nt(fl, sc_mont(fl, le_limbs(&h[32..64])));\n    f_add(fl, lo, hi)\n}fn sc_bytes(ref<Field, shared> fl,"
    " array<u64, 6> m) : array<u8, 32>\n{\n    array<u64, 6> a = f_from_mont(fl, m);\n    array<u8, 32> out "
    "= [0; 32];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        out[i] = narrow_wrapping<u8>(a[i / 8]"
    " >> narrow<u32>(8 * (i % 8)));\n    }\n    out\n}fn ed_expand(slice<u8, shared> private_key) : EdExpand"
    "ed\n{\n    if (slice_len(private_key) != 32)\n    {\n        fault(crypto_length);\n    }\n    array<u8, 6"
    "4> h = sha512(private_key);\n    array<u8, 32> s = [0; 32];\n    array<u8, 32> prefix = [0; 32];\n    f"
    "or (usize i = 0; i < 32; i += 1)\n    {\n        s[i] = h[i];\n        prefix[i] = h[32 + i];\n    }\n   "
    " s[0] = s[0] & 248;\n    s[31] = (s[31] & 127) | 64;\n    EdExpanded { .scalar = s, .prefix = prefix }"
    "\n}export fn ed25519_private_key() : array<u8, 32>\n{\n    array<u8, 32> k = [0; 32];\n    os_random_byt"
    "es(&mut k);\n    k\n}export fn ed25519_public_key(slice<u8, shared> private_key) : array<u8, 32>\n{\n   "
    " EdExpanded e = ed_expand(private_key);\n    ed_encode(ed_mul(&e.scalar, ed_base()))\n}export fn ed255"
    "19_sign(slice<u8, shared> private_key, slice<u8, shared> message) : array<u8, 64>\n{\n    EdExpanded e"
    " = ed_expand(private_key);\n    Field fl = ed_order();\n    array<u8, 32> a = ed_encode(ed_mul(&e.scal"
    "ar, ed_base()));\n    Sha512 hr = Sha512::new();\n    Sha512::update(&mut hr, &e.prefix);\n    Sha512::"
    "update(&mut hr, message);\n    array<u64, 6> r = sc_from_hash(&fl, &Sha512::finish(hr));\n    array<u8"
    ", 32> r_bytes = sc_bytes(&fl, r);\n    array<u8, 32> big_r = ed_encode(ed_mul(&r_bytes, ed_base()));\n"
    "    Sha512 hk = Sha512::new();\n    Sha512::update(&mut hk, &big_r);\n    Sha512::update(&mut hk, &a);"
    "\n    Sha512::update(&mut hk, message);\n    array<u64, 6> k = sc_from_hash(&fl, &Sha512::finish(hk));"
    "\n    array<u64, 6> s = f_add(&fl, r, mont_mul(&fl, k, sc_mont(&fl, le_limbs(&e.scalar))));\n    array"
    "<u8, 32> s_bytes = sc_bytes(&fl, s);\n    array<u8, 64> out = [0; 64];\n    for (usize i = 0; i < 32; "
    "i += 1)\n    {\n        out[i] = big_r[i];\n        out[32 + i] = s_bytes[i];\n    }\n    out\n}export fn "
    "ed25519_verify(slice<u8, shared> public_key, slice<u8, shared> message, slice<u8, shared> signature)"
    " : bool\n{\n    if (slice_len(public_key) != 32 || slice_len(signature) != 64)\n    {\n        return fa"
    "lse;\n    }\n    Ed a = match (ed_decode(public_key))\n    {\n        Some(p) : p,\n        None    : ret"
    "urn false,\n    };\n    Ed big_r = match (ed_decode(&signature[0..32]))\n    {\n        Some(p) : p,\n   "
    "     None    : return false,\n    };\n    Field fl = ed_order();\n    array<u64, 6> s = le_limbs(&signa"
    "ture[32..64]);\n    if (!f_less(&fl, s, fl.m))\n    {\n        return false;\n    }\n    Sha512 hk = Sha5"
    "12::new();\n    Sha512::update(&mut hk, &signature[0..32]);\n    Sha512::update(&mut hk, public_key);\n"
    "    Sha512::update(&mut hk, message);\n    array<u8, 32> k = sc_bytes(&fl, sc_from_hash(&fl, &Sha512:"
    ":finish(hk)));\n    array<u8, 32> lhs = ed_encode(ed_mul(&signature[32..64], ed_base()));\n    array<u"
    "8, 32> rhs = ed_encode(ed_add(big_r, ed_mul(&k, a)));\n    digest_eq(&lhs, &rhs)\n}fn limbs_of(ref<Big"
    "Uint, shared> a, usize n) : Vec<u64>\n{\n    Vec<u8> be = BigUint::to_bytes_be_padded(a, 8 * n);\n    V"
    "ec<u64> out = Vec::filled(n, 0: u64);\n    for (usize i = 0; i < 8 * n; i += 1)\n    {\n        out[i /"
    " 8] = out[i / 8] | (widen<u64>(be[8 * n - 1 - i]) << narrow<u32>(8 * (i % 8)));\n    }\n    out\n}fn bi"
    "guint_of(ref<Vec<u64>, shared> limbs) : BigUint\n{\n    usize n = Vec::len(limbs);\n    Vec<u8> be = Ve"
    "c::filled(8 * n, 0: u8);\n    for (usize i = 0; i < 8 * n; i += 1)\n    {\n        be[8 * n - 1 - i] = "
    "narrow_wrapping<u8>(limbs[i / 8] >> narrow<u32>(8 * (i % 8)));\n    }\n    BigUint::from_bytes_be(&be)"
    "\n}fn mont_new(ref<BigUint, shared> modulus) : Mont\n{\n    usize n = (BigUint::bit_len(modulus) + 63) "
    "/ 64;\n    Vec<u64> m = limbs_of(modulus, n);\n    // m⁻¹ mod 2^64 by Newton's iteration from the o"
    "dd m's own low limb.\n    u64 inv = 1;\n    for (usize i = 0; i < 7; i += 1)\n    {\n        inv = wrapp"
    "ing_mul(inv, wrapping_sub(2, wrapping_mul(m[0], inv)));\n    }\n    BigUint one = BigUint::from_u64(1)"
    ";\n    BigUint r2 = BigUint::rem(&BigUint::shift_left(&one, 128 * n), modulus);\n    Mont { .m = m, .n"
    " = n, .minv = wrapping_sub(0, inv), .r2 = limbs_of(&r2, n) }\n}fn mont_mul_v(ref<Mont, shared> f, ref"
    "<Vec<u64>, shared> a, ref<Vec<u64>, shared> b) : Vec<u64>\n{\n    usize n = f.n;\n    Vec<u64> t = Vec:"
    ":filled(n + 2, 0: u64);\n    for (usize i = 0; i < n; i += 1)\n    {\n        u128 c = 0;\n        u128 "
    "bi = widen<u128>(b[i]);\n        for (usize j = 0; j < n; j += 1)\n        {\n            u128 x = wide"
    "n<u128>(t[j]) + widen<u128>(a[j]) * bi + c;\n            t[j] = narrow_wrapping<u64>(x);\n            "
    "c = x >> 64;\n        }\n        u128 y = widen<u128>(t[n]) + c;\n        t[n] = narrow_wrapping<u64>(y"
    ");\n        t[n + 1] = narrow_wrapping<u64>(y >> 64);\n        u64 k = wrapping_mul(t[0], f.minv);\n   "
    "     u128 kk = widen<u128>(k);\n        u128 z = widen<u128>(t[0]) + kk * widen<u128>(f.m[0]);\n      "
    "  c = z >> 64;\n        for (usize j = 1; j < n; j += 1)\n        {\n            u128 x = widen<u128>(t"
    "[j]) + kk * widen<u128>(f.m[j]) + c;\n            t[j - 1] = narrow_wrapping<u64>(x);\n            c ="
    " x >> 64;\n        }\n        u128 w = widen<u128>(t[n]) + c;\n        t[n - 1] = narrow_wrapping<u64>("
    "w);\n        t[n] = t[n + 1] + narrow_wrapping<u64>(w >> 64);\n    }\n    // t - m unless t (with its c"
    "arry) is below m: chosen by a mask.\n    Vec<u64> r = Vec::filled(n, 0: u64);\n    u64 borrow = 0;\n   "
    " for (usize j = 0; j < n; j += 1)\n    {\n        u128 x = wrapping_sub(wrapping_sub(widen<u128>(t[j])"
    ", widen<u128>(f.m[j])), widen<u128>(borrow));\n        r[j] = narrow_wrapping<u64>(x);\n        borrow"
    " = narrow_wrapping<u64>(x >> 127);\n    }\n    u64 keep = wrapping_sub(0, (1 - t[n]) & borrow);\n    fo"
    "r (usize j = 0; j < n; j += 1)\n    {\n        r[j] = (t[j] & keep) | (r[j] & ~keep);\n    }\n    r\n}fn "
    "mont_pow(ref<Mont, shared> f, ref<BigUint, shared> base, ref<BigUint, shared> exp) : BigUint\n{\n    b"
    "iguint_of(&mont_pow_limbs(f, &limbs_of(base, f.n), exp))\n}fn mont_pow_limbs(ref<Mont, shared> f, ref"
    "<Vec<u64>, shared> base, ref<BigUint, shared> exp) : Vec<u64>\n{\n    usize n = f.n;\n    Vec<u64> one "
    "= Vec::filled(n, 0: u64);\n    one[0] = 1;\n    Vec<u64> one_m = mont_mul_v(f, &one, &f.r2);\n    Vec<u"
    "64> base_m = mont_mul_v(f, base, &f.r2);\n    Vec<Vec<u64>> table = Vec::new();\n    Vec::push(&mut ta"
    "ble, Vec::clone(&one_m));\n    for (usize i = 1; i < 16; i += 1)\n    {\n        Vec<u64> next = mont_m"
    "ul_v(f, &table[i - 1], &base_m);\n        Vec::push(&mut table, next);\n    }\n    Vec<u64> e = limbs_o"
    "f(exp, n);\n    Vec<u64> acc = Vec::clone(&one_m);\n    usize windows = 16 * n;\n    usize w = windows;"
    "\n    while (w > 0)\n    {\n        w -= 1;\n        for (usize s = 0; s < 4; s += 1)\n        {\n        "
    "    overwrite(&mut acc, mont_mul_v(f, &acc, &acc));\n        }\n        u64 bits = (e[w / 16] >> narro"
    "w<u32>(4 * (w % 16))) & 15;\n        Vec<u64> entry = Vec::filled(n, 0: u64);\n        for (u64 i = 0;"
    " i < 16; i += 1)\n        {\n            u64 x = i ^ bits;\n            u64 mask = wrapping_sub(((x | w"
    "rapping_sub(0, x)) >> 63), 1);\n            for (usize j = 0; j < n; j += 1)\n            {\n          "
    "      entry[j] = entry[j] | (table[narrow<usize>(i)][j] & mask);\n            }\n        }\n        ove"
    "rwrite(&mut acc, mont_mul_v(f, &acc, &entry));\n    }\n    mont_mul_v(f, &acc, &one)\n}export fn RsaPri"
    "vateKey::new(BigUint n, BigUint e, BigUint d, BigUint p, BigUint q) : Option<RsaPrivateKey>\n{\n    Bi"
    "gUint one = BigUint::from_u64(1);\n    BigUint two = BigUint::from_u64(2);\n    if (!BigUint::less(&tw"
    "o, &p) || !BigUint::less(&two, &q) || !BigUint::bit(&p, 0) || !BigUint::bit(&q, 0))\n    {\n        re"
    "turn None;\n    }\n    if (!BigUint::eq(&BigUint::mul(&p, &q), &n))\n    {\n        return None;\n    }\n "
    "   BigUint p1 = BigUint::sub(&p, &one);\n    BigUint q1 = BigUint::sub(&q, &one);\n    BigUint ed = Bi"
    "gUint::mul(&e, &d);\n    if (!BigUint::eq(&BigUint::rem(&ed, &p1), &one) || !BigUint::eq(&BigUint::re"
    "m(&ed, &q1), &one))\n    {\n        return None;\n    }\n    BigUint dp = BigUint::rem(&d, &p1);\n    Big"
    "Uint dq = BigUint::rem(&d, &q1);\n    BigUint qinv = BigUint::mod_inverse(&q, &p)?;\n    Some(RsaPriva"
    "teKey { .n = n, .e = e, .d = d, .p = p, .q = q, .dp = dp, .dq = dq, .qinv = qinv })\n}unittest \"RsaPr"
    "ivateKey::new: parts that do not fit are refused\"\n{\n    BigUint n = BigUint::from_u64(3233);\n    Big"
    "Uint e = BigUint::from_u64(17);\n    BigUint p = BigUint::from_u64(61);\n    BigUint q = BigUint::from"
    "_u64(53);\n    Option<RsaPrivateKey> good = RsaPrivateKey::new(n, e, BigUint::from_u64(2753), p, q);\n"
    "    assert(Option::is_some(&good));\n    Option<RsaPrivateKey> bad = RsaPrivateKey::new(\n        BigU"
    "int::from_u64(3233),\n        BigUint::from_u64(17),\n        BigUint::from_u64(2754),\n        BigUint"
    "::from_u64(61),\n        BigUint::from_u64(53),\n    );\n    assert(Option::is_none(&bad));\n}export fn "
    "RsaPrivateKey::public_key(ref<RsaPrivateKey, shared> key) : RsaPublicKey\n{\n    RsaPublicKey { .n = B"
    "igUint::clone(&key.n), .e = BigUint::clone(&key.e) }\n}fn limbs_sub_mod(ref<Mont, shared> f, ref<Vec<"
    "u64>, shared> a, ref<Vec<u64>, shared> b) : Vec<u64>\n{\n    usize n = f.n;\n    Vec<u64> r = Vec::fill"
    "ed(n, 0: u64);\n    u64 borrow = 0;\n    for (usize j = 0; j < n; j += 1)\n    {\n        u128 x = wrapp"
    "ing_sub(wrapping_sub(widen<u128>(a[j]), widen<u128>(b[j])), widen<u128>(borrow));\n        r[j] = nar"
    "row_wrapping<u64>(x);\n        borrow = narrow_wrapping<u64>(x >> 127);\n    }\n    // Add m back where"
    " it borrowed.\n    u64 mask = wrapping_sub(0, borrow);\n    u64 carry = 0;\n    for (usize j = 0; j < n"
    "; j += 1)\n    {\n        u128 x = widen<u128>(r[j]) + widen<u128>(f.m[j] & mask) + widen<u128>(carry)"
    ";\n        r[j] = narrow_wrapping<u64>(x);\n        carry = narrow_wrapping<u64>(x >> 64);\n    }\n    r"
    "\n}fn rsa_private_op(ref<RsaPrivateKey, shared> key, ref<BigUint, shared> m) : BigUint\n{\n    Mont mp "
    "= mont_new(&key.p);\n    Mont mq = mont_new(&key.q);\n    usize np = mp.n;\n    usize nq = mq.n;\n    //"
    " m1 = m^dp mod p, m2 = m^dq mod q (m reduced: public values).\n    Vec<u64> m1 = mont_pow_limbs(&mp, "
    "&limbs_of(&BigUint::rem(m, &key.p), np), &key.dp);\n    Vec<u64> m2 = mont_pow_limbs(&mq, &limbs_of(&"
    "BigUint::rem(m, &key.q), nq), &key.dq);\n    // h = qinv·(m1 - m2 mod p) mod p, on p's arithmetic.\n "
    "   Vec<u64> m2_mod_p = limbs_of(&BigUint::rem(&biguint_of(&m2), &key.p), np);\n    Vec<u64> diff = li"
    "mbs_sub_mod(&mp, &m1, &m2_mod_p);\n    Vec<u64> qinv_m = mont_mul_v(&mp, &limbs_of(&key.qinv, np), &m"
    "p.r2);\n    Vec<u64> h = mont_mul_v(&mp, &diff, &qinv_m);\n    // s = m2 + h·q: a plain product over "
    "limbs, then the sum.\n    Vec<u64> q_limbs = limbs_of(&key.q, nq);\n    Vec<u64> s = Vec::filled(np + "
    "nq + 1, 0: u64);\n    for (usize i = 0; i < np; i += 1)\n    {\n        u128 carry = 0;\n        u128 hi"
    " = widen<u128>(h[i]);\n        for (usize j = 0; j < nq; j += 1)\n        {\n            u128 x = widen"
    "<u128>(s[i + j]) + hi * widen<u128>(q_limbs[j]) + carry;\n            s[i + j] = narrow_wrapping<u64>"
    "(x);\n            carry = x >> 64;\n        }\n        s[i + nq] = narrow_wrapping<u64>(carry);\n    }\n "
    "   u128 c = 0;\n    for (usize j = 0; j < np + nq + 1; j += 1)\n    {\n        u128 x = widen<u128>(s[j"
    "]) + (if (j < nq) { widen<u128>(m2[j]) } else { 0 }) + c;\n        s[j] = narrow_wrapping<u64>(x);\n  "
    "      c = x >> 64;\n    }\n    BigUint result = biguint_of(&s);\n    // Checked against the public key:"
    " a wrong result would leak the\n    // primes, so a key that fails is used without the CRT instead.\n "
    "   if (BigUint::eq(&BigUint::mod_pow(&result, &key.e, &key.n), m))\n    {\n        return result;\n    "
    "}\n    Mont mn = mont_new(&key.n);\n    mont_pow(&mn, m, &key.d)\n}fn pkcs1v15_encode(HashKind kind, sl"
    "ice<u8, shared> digest, usize k) : Vec<u8>\n{\n    Vec<u8> prefix = digest_info_prefix(kind);\n    usiz"
    "e t_len = Vec::len(&prefix) + slice_len(digest);\n    if (slice_len(digest) != hash_len(kind) || k < "
    "t_len + 11)\n    {\n        fault(crypto_length);\n    }\n    Vec<u8> em = Vec::new();\n    Vec::push(&mu"
    "t em, 0);\n    Vec::push(&mut em, 1);\n    for (usize i = 0; i < k - t_len - 3; i += 1)\n    {\n        "
    "Vec::push(&mut em, 0xff);\n    }\n    Vec::push(&mut em, 0);\n    Vec::extend_from(&mut em, &prefix);\n "
    "   Vec::extend_from(&mut em, digest);\n    em\n}export fn rsa_sign_pkcs1v15(ref<RsaPrivateKey, shared>"
    " key, HashKind kind, slice<u8, shared> digest) : Vec<u8>\n{\n    usize k = (BigUint::bit_len(&key.n) +"
    " 7) / 8;\n    Vec<u8> em = pkcs1v15_encode(kind, digest, k);\n    BigUint s = rsa_private_op(key, &Big"
    "Uint::from_bytes_be(&em));\n    BigUint::to_bytes_be_padded(&s, k)\n}export fn rsa_sign_pss(ref<RsaPri"
    "vateKey, shared> key, HashKind kind, slice<u8, shared> digest) : Vec<u8>\n{\n    usize mod_bits = BigU"
    "int::bit_len(&key.n);\n    usize k = (mod_bits + 7) / 8;\n    usize h_len = hash_len(kind);\n    usize "
    "em_bits = mod_bits - 1;\n    usize em_len = (em_bits + 7) / 8;\n    if (slice_len(digest) != h_len || "
    "em_len < 2 * h_len + 2)\n    {\n        fault(crypto_length);\n    }\n    Vec<u8> salt = Vec::filled(h_l"
    "en, 0: u8);\n    os_random_bytes(&mut salt);\n    Vec<u8> m2 = Vec::filled(8, 0: u8);\n    Vec::extend_"
    "from(&mut m2, digest);\n    Vec::extend_from(&mut m2, &salt);\n    Vec<u8> h = hash(kind, &m2);\n    us"
    "ize db_len = em_len - h_len - 1;\n    Vec<u8> db = Vec::filled(db_len - h_len - 1, 0: u8);\n    Vec::p"
    "ush(&mut db, 1);\n    Vec::extend_from(&mut db, &salt);\n    Vec<u8> mask = mgf1(kind, &h, db_len);\n  "
    "  Vec<u8> em = Vec::new();\n    for (usize i = 0; i < db_len; i += 1)\n    {\n        Vec::push(&mut em"
    ", db[i] ^ mask[i]);\n    }\n    u32 unused = narrow<u32>(8 * em_len - em_bits);\n    em[0] = em[0] & na"
    "rrow_wrapping<u8>((0xff: u32) >> unused);\n    Vec::extend_from(&mut em, &h);\n    Vec::push(&mut em, "
    "0xbc);\n    BigUint s = rsa_private_op(key, &BigUint::from_bytes_be(&em));\n    BigUint::to_bytes_be_p"
    "added(&s, k)\n}fn small_primes() : Vec<u32>\n{\n    Vec<u32> out = Vec::new();\n    for (u32 c = 3; c < "
    "1000; c += 2)\n    {\n        bool prime = true;\n        for (usize i = 0; i < Vec::len(&out) && out[i"
    "] * out[i] <= c; i += 1)\n        {\n            if (c % out[i] == 0)\n            {\n                pr"
    "ime = false;\n                break;\n            }\n        }\n        if (prime)\n        {\n           "
    " Vec::push(&mut out, c);\n        }\n    }\n    out\n}fn probably_prime(ref<BigUint, shared> c, ref<Vec<"
    "u32>, shared> primes, usize rounds) : bool\n{\n    for (usize i = 0; i < Vec::len(primes); i += 1)\n   "
    " {\n        BigUint p = BigUint::from_u64(widen<u64>(primes[i]));\n        if (BigUint::is_zero(&BigUi"
    "nt::rem(c, &p)))\n        {\n            return BigUint::eq(c, &p);\n        }\n    }\n    BigUint one = "
    "BigUint::from_u64(1);\n    BigUint c1 = BigUint::sub(c, &one);\n    usize a = 0;\n    while (!BigUint::"
    "bit(&c1, a))\n    {\n        a += 1;\n    }\n    BigUint m = BigUint::shift_right(&c1, a);\n    Mont f = "
    "mont_new(c);\n    usize k = (BigUint::bit_len(c) + 7) / 8;\n    Vec<u8> rb = Vec::filled(k, 0: u8);\n  "
    "  BigUint two = BigUint::from_u64(2);\n    for (usize round = 0; round < rounds; round += 1)\n    {\n  "
    "      os_random_bytes(&mut rb);\n        BigUint b = BigUint::add(\n            &BigUint::rem(&BigUint"
    "::from_bytes_be(&rb), &BigUint::sub(c, &BigUint::from_u64(3))),\n            &two,\n        );\n       "
    " BigUint z = mont_pow(&f, &b, &m);\n        if (BigUint::eq(&z, &one) || BigUint::eq(&z, &c1))\n      "
    "  {\n            continue;\n        }\n        bool witness = true;\n        for (usize j = 1; j < a; j "
    "+= 1)\n        {\n            overwrite(&mut z, BigUint::rem(&BigUint::mul(&z, &z), c));\n            i"
    "f (BigUint::eq(&z, &c1))\n            {\n                witness = false;\n                break;\n     "
    "       }\n            if (BigUint::eq(&z, &one))\n            {\n                return false;\n        "
    "    }\n        }\n        if (witness)\n        {\n            return false;\n        }\n    }\n    true\n}f"
    "n random_prime(usize bits, ref<BigUint, shared> e, ref<Vec<u32>, shared> primes) : BigUint\n{\n    usi"
    "ze k = (bits + 7) / 8;\n    Vec<u8> rb = Vec::filled(k, 0: u8);\n    BigUint one = BigUint::from_u64(1"
    ");\n    while (true)\n    {\n        os_random_bytes(&mut rb);\n        BigUint c = BigUint::from_bytes_"
    "be(&rb);\n        // Exactly `bits` bits with the top two set, and odd.\n        BigUint top = BigUint"
    "::shift_left(&one, bits - 1);\n        BigUint second = BigUint::shift_left(&one, bits - 2);\n        "
    "BigUint mask = BigUint::sub(&BigUint::shift_left(&one, bits), &one);\n        BigUint c2 = BigUint::r"
    "em(&c, &BigUint::add(&mask, &one));\n        BigUint c3 = BigUint::add(&BigUint::rem(&c2, &second), &"
    "BigUint::add(&top, &second));\n        if (!BigUint::bit(&c3, 0))\n        {\n            overwrite(&mu"
    "t c3, BigUint::add(&c3, &one));\n        }\n        BigUint c4 = BigUint::sub(&c3, &one);\n        if ("
    "BigUint::is_zero(&BigUint::rem(&c4, e)))\n        {\n            continue;\n        }\n        if (proba"
    "bly_prime(&c3, primes, 5))\n        {\n            return c3;\n        }\n    }\n}export fn rsa_generate_"
    "key(usize bits) : RsaPrivateKey\n{\n    if (bits < 1024 || bits > 8192 || bits % 64 != 0)\n    {\n      "
    "  fault(crypto_length);\n    }\n    Vec<u32> primes = small_primes();\n    BigUint e = BigUint::from_u6"
    "4(65537);\n    BigUint one = BigUint::from_u64(1);\n    while (true)\n    {\n        BigUint p = random_"
    "prime(bits / 2, &e, &primes);\n        BigUint q = random_prime(bits / 2, &e, &primes);\n        if (B"
    "igUint::eq(&p, &q))\n        {\n            continue;\n        }\n        BigUint n = BigUint::mul(&p, &"
    "q);\n        BigUint p1 = BigUint::sub(&p, &one);\n        BigUint q1 = BigUint::sub(&q, &one);\n      "
    "  BigUint phi = BigUint::mul(&p1, &q1);\n        BigUint d = match (BigUint::mod_inverse(&e, &phi))\n "
    "       {\n            Some(v) : v,\n            None    : continue,\n        };\n        if (Some(key) ="
    " RsaPrivateKey::new(n, BigUint::clone(&e), d, p, q))\n        {\n            return key;\n        }\n   "
    " }\n}export fn CertError::text(ref<CertError, shared> e) : str\n{\n    match (e)\n    {\n        BadEncod"
    "ing          : \"malformed certificate\",\n        Expired              : \"certificate expired\",\n      "
    "  NotYetValid          : \"certificate not yet valid\",\n        UnknownAuthority     : \"certificate si"
    "gned by an unknown authority\",\n        HostMismatch         : \"certificate is not for this host\",\n  "
    "      BadSignature         : \"certificate signature does not verify\",\n        NotAuthority         :"
    " \"issuer is not a certificate authority\",\n        UnsupportedAlgorithm : \"unsupported key or signatu"
    "re algorithm\",\n        UnhandledCritical    : \"unhandled critical extension\",\n        WrongUsage    "
    "       : \"certificate not usable for a TLS server\",\n        ChainTooLong         : \"certificate chai"
    "n too long\",\n    }\n}export fn der_read(slice<u8, shared> buf, usize at) : Option<Der>\n{\n    usize n "
    "= slice_len(buf);\n    if (at + 2 > n)\n    {\n        return None;\n    }\n    u8 tag = buf[at];\n    if "
    "((tag & 0x1f) == 0x1f)\n    {\n        return None;\n    }\n    u8 first = buf[at + 1];\n    usize len = "
    "0;\n    usize start = at + 2;\n    if (first < 0x80)\n    {\n        len = widen<usize>(first);\n    }\n  "
    "  else\n    {\n        usize count = widen<usize>(first & 0x7f);\n        if (count == 0 || count > 4 |"
    "| start + count > n || buf[start] == 0)\n        {\n            return None;\n        }\n        for (us"
    "ize i = 0; i < count; i += 1)\n        {\n            len = (len << 8) | widen<usize>(buf[start + i]);"
    "\n        }\n        if (len < 0x80)\n        {\n            return None;\n        }\n        start += cou"
    "nt;\n    }\n    if (len > n - start)\n    {\n        return None;\n    }\n    Some(Der { .tag = tag, .star"
    "t = start, .end = start + len, .next = start + len })\n}unittest \"der_read: an element, its child, an"
    "d a long form refused\"\n{\n    array<u8, 5> der = [0x30, 0x03, 0x02, 0x01, 0x05];\n    Der seq = Option"
    "::unwrap(der_read(&der, 0));\n    assert(seq.tag == 0x30 && seq.start == 2 && seq.end == 5 && seq.nex"
    "t == 5);\n    Der int = Option::unwrap(der_read(&der, seq.start));\n    assert(int.tag == 0x02 && der["
    "int.start] == 5);\n    array<u8, 4> long_form = [0x04, 0x81, 0x01, 0x00];\n    assert(Option::is_none("
    "&der_read(&long_form, 0)));\n}fn der_expect(slice<u8, shared> buf, usize at, u8 tag) : Result<Der, Ce"
    "rtError>\n{\n    match (der_read(buf, at))\n    {\n        Some(d) : if (d.tag == tag) { Ok(d) } else { "
    "Err(BadEncoding) },\n        None    : Err(BadEncoding),\n    }\n}fn der_bytes(slice<u8, shared> buf, D"
    "er d) : Vec<u8>\n{\n    Vec::from_slice(&buf[d.start..d.end])\n}fn der_eq_hex(slice<u8, shared> buf, De"
    "r d, str hex) : bool\n{\n    Vec<u8> want = Result::unwrap_or(from_hex(StringView::of(hex)), Vec::new("
    "));\n    d.end - d.start == Vec::len(&want) && digest_eq(&buf[d.start..d.end], &want)\n}fn hash_oid(sl"
    "ice<u8, shared> buf, Der d) : Option<HashKind>\n{\n    if (der_eq_hex(buf, d, \"608648016503040201\"))\n "
    "   {\n        return Some(Sha2_256);\n    }\n    if (der_eq_hex(buf, d, \"608648016503040202\"))\n    {\n  "
    "      return Some(Sha2_384);\n    }\n    if (der_eq_hex(buf, d, \"608648016503040203\"))\n    {\n        r"
    "eturn Some(Sha2_512);\n    }\n    None\n}fn signature_algorithm(slice<u8, shared> buf, Der alg) : Resul"
    "t<SignatureScheme, CertError>\n{\n    Der oid = der_expect(buf, alg.start, 0x06)?;\n    if (der_eq_hex("
    "buf, oid, \"2a864886f70d01010b\"))\n    {\n        return Ok(RsaPkcs1(Sha2_256));\n    }\n    if (der_eq_h"
    "ex(buf, oid, \"2a864886f70d01010c\"))\n    {\n        return Ok(RsaPkcs1(Sha2_384));\n    }\n    if (der_e"
    "q_hex(buf, oid, \"2a864886f70d01010d\"))\n    {\n        return Ok(RsaPkcs1(Sha2_512));\n    }\n    if (de"
    "r_eq_hex(buf, oid, \"2a8648ce3d040302\"))\n    {\n        return Ok(Ecdsa(Sha2_256));\n    }\n    if (der_"
    "eq_hex(buf, oid, \"2a8648ce3d040303\"))\n    {\n        return Ok(Ecdsa(Sha2_384));\n    }\n    if (der_eq"
    "_hex(buf, oid, \"2a8648ce3d040304\"))\n    {\n        return Ok(Ecdsa(Sha2_512));\n    }\n    if (der_eq_h"
    "ex(buf, oid, \"2b6570\"))\n    {\n        return Ok(Ed25519);\n    }\n    if (der_eq_hex(buf, oid, \"2a8648"
    "86f70d01010a\"))\n    {\n        // RSASSA-PSS-params: [0] hashAlgorithm, [1] maskGenAlgorithm,\n       "
    " // [2] saltLength; the hash must be SHA-2 and MGF1 over it, and the\n        // salt as long as the "
    "digest.\n        Der params = der_expect(buf, oid.next, 0x30)?;\n        Der h0 = der_expect(buf, para"
    "ms.start, 0xa0)?;\n        Der h_alg = der_expect(buf, h0.start, 0x30)?;\n        Der h_oid = der_expe"
    "ct(buf, h_alg.start, 0x06)?;\n        HashKind kind = match (hash_oid(buf, h_oid))\n        {\n        "
    "    Some(k) : k,\n            None    : return Ok(UnsupportedSignature),\n        };\n        return Ok"
    "(RsaPss(kind));\n    }\n    Ok(UnsupportedSignature)\n}fn der_text(slice<u8, shared> buf, Der d) : Opti"
    "on<String>\n{\n    if (d.tag != 0x0c && d.tag != 0x13 && d.tag != 0x16 && d.tag != 0x14)\n    {\n       "
    " return None;\n    }\n    match (String::from_utf8(der_bytes(buf, d)))\n    {\n        Ok(s)  : Some(s),"
    "\n        Err(_) : None,\n    }\n}fn common_name_of(slice<u8, shared> buf, Der name) : String\n{\n    Str"
    "ing cn = String::new();\n    usize at = name.start;\n    while (at < name.end)\n    {\n        Der set ="
    " match (der_read(buf, at))\n        {\n            Some(d) : d,\n            None    : return cn,\n     "
    "   };\n        usize inner = set.start;\n        while (inner < set.end)\n        {\n            Der atv"
    " = match (der_read(buf, inner))\n            {\n                Some(d) : d,\n                None    :"
    " return cn,\n            };\n            if (Some(oid) = der_read(buf, atv.start))\n            {\n     "
    "           if (oid.tag == 0x06 && der_eq_hex(buf, oid, \"550403\"))\n                {\n                "
    "    if (Some(v) = der_read(buf, oid.next))\n                    {\n                        if (Some(t)"
    " = der_text(buf, v))\n                        {\n                            overwrite(&mut cn, t);\n  "
    "                      }\n                    }\n                }\n            }\n            inner = at"
    "v.next;\n        }\n        at = set.next;\n    }\n    cn\n}fn digits(slice<u8, shared> b, usize at, usiz"
    "e n) : Option<i64>\n{\n    i64 x = 0;\n    for (usize i = at; i < at + n; i += 1)\n    {\n        if (i >"
    "= slice_len(b) || !ascii_is_digit(b[i]))\n        {\n            return None;\n        }\n        x = x "
    "* 10 + widen<i64>(b[i] - b'0');\n    }\n    Some(x)\n}fn der_time(slice<u8, shared> buf, Der d) : Resul"
    "t<DateTime, CertError>\n{\n    slice<u8, shared> t = &buf[d.start..d.end];\n    usize n = slice_len(t);"
    "\n    i64 year = 0;\n    usize at = 0;\n    if (d.tag == 0x17 && n == 13)\n    {\n        i64 yy = match "
    "(digits(t, 0, 2))\n        {\n            Some(y) : y,\n            None    : return Err(BadEncoding),\n"
    "        };\n        year = if (yy < 50) { 2000 + yy } else { 1900 + yy };\n        at = 2;\n    }\n    e"
    "lse if (d.tag == 0x18 && n == 15)\n    {\n        year = match (digits(t, 0, 4))\n        {\n           "
    " Some(y) : y,\n            None    : return Err(BadEncoding),\n        };\n        at = 4;\n    }\n    el"
    "se\n    {\n        return Err(BadEncoding);\n    }\n    if (t[n - 1] != b'Z')\n    {\n        return Err(B"
    "adEncoding);\n    }\n    Option<i64> mo = digits(t, at, 2);\n    Option<i64> dd = digits(t, at + 2, 2);"
    "\n    Option<i64> hh = digits(t, at + 4, 2);\n    Option<i64> mi = digits(t, at + 6, 2);\n    Option<i6"
    "4> ss = digits(t, at + 8, 2);\n    if (Some(m) = mo)\n    {\n        if (Some(day) = dd)\n        {\n    "
    "        if (Some(h) = hh)\n            {\n                if (Some(min) = mi)\n                {\n      "
    "              if (Some(sec) = ss)\n                    {\n                        if (m <= 12 && day <"
    "= 31 && h <= 23 && min <= 59 && sec <= 59)\n                        {\n                            if "
    "(Some(dt) = DateTime::new(\n                                year,\n                                nar"
    "row<u8>(m),\n                                narrow<u8>(day),\n                                narrow<"
    "u8>(h),\n                                narrow<u8>(min),\n                                narrow<u8>("
    "sec),\n                            ))\n                            {\n                                r"
    "eturn Ok(dt);\n                            }\n                        }\n                    }\n        "
    "        }\n            }\n        }\n    }\n    Err(BadEncoding)\n}fn public_key_of(slice<u8, shared> buf"
    ", Der spki) : Result<CertKey, CertError>\n{\n    Der alg = der_expect(buf, spki.start, 0x30)?;\n    Der"
    " bits = der_expect(buf, alg.next, 0x03)?;\n    if (bits.end == bits.start || buf[bits.start] != 0)\n  "
    "  {\n        return Err(BadEncoding);\n    }\n    usize key_start = bits.start + 1;\n    Der oid = der_e"
    "xpect(buf, alg.start, 0x06)?;\n    if (der_eq_hex(buf, oid, \"2a864886f70d010101\"))\n    {\n        Der "
    "seq = der_expect(buf, key_start, 0x30)?;\n        Der n = der_expect(buf, seq.start, 0x02)?;\n        "
    "Der e = der_expect(buf, n.next, 0x02)?;\n        return Ok(RsaKey(RsaPublicKey { .n = BigUint::from_b"
    "ytes_be(&buf[n.start..n.end]), .e = BigUint::from_bytes_be(&buf[e.start..e.end]) }));\n    }\n    if ("
    "der_eq_hex(buf, oid, \"2a8648ce3d0201\"))\n    {\n        Der curve = der_expect(buf, oid.next, 0x06)?;\n"
    "        Vec<u8> point = Vec::from_slice(&buf[key_start..bits.end]);\n        if (der_eq_hex(buf, curv"
    "e, \"2a8648ce3d030107\"))\n        {\n            return Ok(EcKey(EcPublicKey { .curve = P256, .point = "
    "point }));\n        }\n        if (der_eq_hex(buf, curve, \"2b81040022\"))\n        {\n            return "
    "Ok(EcKey(EcPublicKey { .curve = P384, .point = point }));\n        }\n    }\n    if (der_eq_hex(buf, oi"
    "d, \"2b6570\"))\n    {\n        if (bits.end - key_start != 32)\n        {\n            return Err(BadEnco"
    "ding);\n        }\n        array<u8, 32> k = [0; 32];\n        for (usize i = 0; i < 32; i += 1)\n      "
    "  {\n            k[i] = buf[key_start + i];\n        }\n        return Ok(Ed25519Key(k));\n    }\n    Ok("
    "UnsupportedKey)\n}export fn Certificate::parse(slice<u8, shared> der) : Result<Certificate, CertError"
    ">\n{\n    Der cert = der_expect(der, 0, 0x30)?;\n    if (cert.next != slice_len(der))\n    {\n        ret"
    "urn Err(BadEncoding);\n    }\n    Der tbs = der_expect(der, cert.start, 0x30)?;\n    Der outer_alg = de"
    "r_expect(der, tbs.next, 0x30)?;\n    Der sig_bits = der_expect(der, outer_alg.next, 0x03)?;\n    if (s"
    "ig_bits.next != cert.end || sig_bits.end == sig_bits.start || der[sig_bits.start] != 0)\n    {\n      "
    "  return Err(BadEncoding);\n    }\n    SignatureScheme scheme = signature_algorithm(der, outer_alg)?;\n"
    "    usize at = tbs.start;\n    Der first = match (der_read(der, at))\n    {\n        Some(d) : d,\n     "
    "   None    : return Err(BadEncoding),\n    };\n    if (first.tag == 0xa0)\n    {\n        at = first.nex"
    "t;\n    }\n    Der serial = der_expect(der, at, 0x02)?;\n    Der inner_alg = der_expect(der, serial.nex"
    "t, 0x30)?;\n    // The signature algorithm inside the signed part must be the outer one.\n    if (inne"
    "r_alg.end - inner_alg.start != outer_alg.end - outer_alg.start || !digest_eq(\n        &der[inner_alg"
    ".start..inner_alg.end],\n        &der[outer_alg.start..outer_alg.end],\n    ))\n    {\n        return Er"
    "r(BadEncoding);\n    }\n    Der issuer = der_expect(der, inner_alg.next, 0x30)?;\n    Der validity = de"
    "r_expect(der, issuer.next, 0x30)?;\n    Der nb = match (der_read(der, validity.start))\n    {\n        "
    "Some(d) : d,\n        None    : return Err(BadEncoding),\n    };\n    Der na = match (der_read(der, nb."
    "next))\n    {\n        Some(d) : d,\n        None    : return Err(BadEncoding),\n    };\n    DateTime not"
    "_before = der_time(der, nb)?;\n    DateTime not_after = der_time(der, na)?;\n    Der subject = der_exp"
    "ect(der, validity.next, 0x30)?;\n    Der spki = der_expect(der, subject.next, 0x30)?;\n    CertKey key"
    " = public_key_of(der, spki)?;\n    Certificate c = Certificate { .der = Vec::from_slice(der), .tbs = "
    "Vec::from_slice(&der[cert.start..tbs.next]), .issuer = Vec::from_slice(&der[inner_alg.next..issuer.n"
    "ext]), .subject = Vec::from_slice(&der[validity.next..subject.next]), .common_name = common_name_of("
    "\n        der,\n        subject,\n    ), .not_before = not_before, .not_after = not_after, .dns_names ="
    " Vec::new(), .ip_addresses = Vec::new(), .is_ca = false, .max_path_len = -1, .can_sign_certificates "
    "= true, .server_auth = true, .unhandled_critical = false, .key = key, .scheme = scheme, .signature ="
    " Vec::from_slice(&der[sig_bits.start + 1..sig_bits.end]) };\n    at = spki.next;\n    while (at < tbs."
    "end)\n    {\n        Der field = match (der_read(der, at))\n        {\n            Some(d) : d,\n        "
    "    None    : return Err(BadEncoding),\n        };\n        if (field.tag == 0xa3)\n        {\n         "
    "   Der exts = der_expect(der, field.start, 0x30)?;\n            usize e_at = exts.start;\n            "
    "while (e_at < exts.end)\n            {\n                Der ext = der_expect(der, e_at, 0x30)?;\n      "
    "          Der oid = der_expect(der, ext.start, 0x06)?;\n                usize v_at = oid.next;\n      "
    "          bool critical = false;\n                Der maybe = match (der_read(der, v_at))\n           "
    "     {\n                    Some(d) : d,\n                    None    : return Err(BadEncoding),\n     "
    "           };\n                if (maybe.tag == 0x01)\n                {\n                    critical "
    "= maybe.end > maybe.start && der[maybe.start] != 0;\n                    v_at = maybe.next;\n         "
    "       }\n                Der value = der_expect(der, v_at, 0x04)?;\n                if (der_eq_hex(de"
    "r, oid, \"551d11\"))\n                {\n                    Der names = der_expect(der, value.start, 0x"
    "30)?;\n                    usize n_at = names.start;\n                    while (n_at < names.end)\n   "
    "                 {\n                        Der g = match (der_read(der, n_at))\n                     "
    "   {\n                            Some(d) : d,\n                            None    : return Err(BadEn"
    "coding),\n                        };\n                        if (g.tag == 0x82)\n                     "
    "   {\n                            if (Ok(s) = String::from_utf8(der_bytes(der, g)))\n                 "
    "           {\n                                Vec::push(&mut c.dns_names, s);\n                       "
    "     }\n                        }\n                        else if (g.tag == 0x87)\n                   "
    "     {\n                            usize len = g.end - g.start;\n                            if (len "
    "== 4)\n                            {\n                                Vec::push(\n                     "
    "               &mut c.ip_addresses,\n                                    V4([der[g.start], der[g.star"
    "t + 1], der[g.start + 2], der[g.start + 3]]),\n                                );\n                   "
    "         }\n                            else if (len == 16)\n                            {\n           "
    "                     array<u8, 16> a = [0; 16];\n                                for (usize i = 0; i "
    "< 16; i += 1)\n                                {\n                                    a[i] = der[g.sta"
    "rt + i];\n                                }\n                                Vec::push(&mut c.ip_addre"
    "sses, V6(a));\n                            }\n                        }\n                        n_at ="
    " g.next;\n                    }\n                }\n                else if (der_eq_hex(der, oid, \"551d"
    "13\"))\n                {\n                    Der bc = der_expect(der, value.start, 0x30)?;\n          "
    "          usize b_at = bc.start;\n                    if (b_at < bc.end)\n                    {\n      "
    "                  Der x = match (der_read(der, b_at))\n                        {\n                    "
    "        Some(d) : d,\n                            None    : return Err(BadEncoding),\n                "
    "        };\n                        if (x.tag == 0x01)\n                        {\n                    "
    "        c.is_ca = x.end > x.start && der[x.start] != 0;\n                            b_at = x.next;\n "
    "                       }\n                    }\n                    if (b_at < bc.end)\n              "
    "      {\n                        Der pl = der_expect(der, b_at, 0x02)?;\n                        i64 v"
    " = 0;\n                        for (usize i = pl.start; i < pl.end && i < pl.start + 4; i += 1)\n     "
    "                   {\n                            v = (v << 8) | widen<i64>(der[i]);\n                "
    "        }\n                        c.max_path_len = v;\n                    }\n                }\n      "
    "          else if (der_eq_hex(der, oid, \"551d0f\"))\n                {\n                    Der ku = de"
    "r_expect(der, value.start, 0x03)?;\n                    // Bit 5, keyCertSign, of the first byte afte"
    "r the\n                    // unused-bits count.\n                    c.can_sign_certificates = ku.end"
    " - ku.start >= 2 && (der[ku.start + 1] & 0x04) != 0;\n                }\n                else if (der_"
    "eq_hex(der, oid, \"551d25\"))\n                {\n                    Der eku = der_expect(der, value.st"
    "art, 0x30)?;\n                    bool server = false;\n                    usize k_at = eku.start;\n  "
    "                  while (k_at < eku.end)\n                    {\n                        Der p = der_e"
    "xpect(der, k_at, 0x06)?;\n                        if (der_eq_hex(der, p, \"2b06010505070301\") || der_e"
    "q_hex(der, p, \"551d2500\"))\n                        {\n                            server = true;\n    "
    "                    }\n                        k_at = p.next;\n                    }\n                 "
    "   c.server_auth = server;\n                }\n                else if (critical && !der_eq_hex(der, o"
    "id, \"551d20\") && !der_eq_hex(der, oid, \"551d1e\"))\n                {\n                    // An unknow"
    "n critical extension; certificate policies\n                    // and name constraints are tolerated"
    " unread (D-0160).\n                    c.unhandled_critical = true;\n                }\n               "
    " e_at = ext.next;\n            }\n        }\n        at = field.next;\n    }\n    Ok(c)\n}export fn certif"
    "icates_from_pem(StringView text) : Vec<Certificate>\n{\n    Vec<Certificate> out = Vec::new();\n    Str"
    "ingView begin = \"-----BEGIN CERTIFICATE-----\";\n    StringView end = \"-----END CERTIFICATE-----\";\n   "
    " usize at = 0;\n    usize n = StringView::len(text);\n    while (at < n)\n    {\n        StringView rest"
    " = &text[at..n];\n        usize b = match (StringView::find(rest, begin))\n        {\n            Some("
    "i) : i,\n            None    : break,\n        };\n        StringView body = &rest[b + StringView::len("
    "begin)..$];\n        usize e = match (StringView::find(body, end))\n        {\n            Some(i) : i,"
    "\n            None    : break,\n        };\n        String b64 = String::new();\n        StringView bloc"
    "k = &body[0..e];\n        // A byte that is not ASCII (so not base64 either) makes the block\n        "
    "// malformed: skipped, like one whose base64 does not decode.\n        bool clean = true;\n        for"
    " (usize i = 0; i < StringView::len(block); i += 1)\n        {\n            u8 c = block.bytes[i];\n    "
    "        if (c >= 128)\n            {\n                clean = false;\n                break;\n          "
    "  }\n            if (!ascii_is_space(c))\n            {\n                String::push_ascii(&mut b64, c"
    ");\n            }\n        }\n        if (clean)\n        {\n            if (Ok(der) = base64_decode(&b64"
    "))\n            {\n                if (Ok(cert) = Certificate::parse(&der))\n                {\n        "
    "            Vec::push(&mut out, cert);\n                }\n            }\n        }\n        at = at + b"
    " + StringView::len(begin) + e + StringView::len(end);\n    }\n    out\n}unittest \"certificates_from_pem"
    ": a malformed block is skipped\"\n{\n    StringView text = \"junk\\n-----BEGIN CERTIFICATE-----\\nnot base"
    "64!\\n-----END CERTIFICATE-----\\n\";\n    Vec<Certificate> certs = certificates_from_pem(text);\n    ass"
    "ert(Vec::len(&certs) == 0);\n}export fn TrustStore::new() : TrustStore\n{\n    TrustStore { .roots = Ve"
    "c::new() }\n}export fn TrustStore::add(ref<TrustStore, exclusive> t, Certificate root)\n{\n    Vec::pus"
    "h(&mut t.roots, root);\n}export fn TrustStore::from_pem_file(StringView path) : Result<TrustStore, Fi"
    "leError>\n{\n    String text = read_file(path)?;\n    Ok(TrustStore { .roots = certificates_from_pem(&t"
    "ext) })\n}export fn TrustStore::system() : Result<TrustStore, FileError>\n{\n    array<str, 5> paths = "
    "[\n        \"/etc/ssl/certs/ca-certificates.crt\",\n        \"/etc/pki/tls/certs/ca-bundle.crt\",\n        "
    "\"/etc/ssl/ca-bundle.pem\",\n        \"/etc/ssl/cert.pem\",\n        \"/usr/local/etc/openssl/cert.pem\",\n  "
    "  ];\n    foreach (p in &paths)\n    {\n        if (Ok(t) = TrustStore::from_pem_file(StringView::of(*p"
    ")))\n        {\n            if (Vec::len(&t.roots) > 0)\n            {\n                return Ok(t);\n  "
    "          }\n        }\n    }\n    Err(NotFound)\n}export fn verify_signature(\n    ref<CertKey, shared> "
    "key,\n    ref<SignatureScheme, shared> scheme,\n    slice<u8, shared> message,\n    slice<u8, shared> s"
    "ignature,\n) : bool\n{\n    match (scheme)\n    {\n        RsaPkcs1(h) : match (key)\n        {\n          "
    "  RsaKey(k) : rsa_verify_pkcs1v15(k, *h, &hash(*h, message), signature),\n            _         : fal"
    "se,\n        },\n        RsaPss(h) : match (key)\n        {\n            RsaKey(k) : rsa_verify_pss(k, *"
    "h, &hash(*h, message), signature),\n            _         : false,\n        },\n        Ecdsa(h) : matc"
    "h (key)\n        {\n            EcKey(k) : ecdsa_verify(k.curve, &k.point, &hash(*h, message), signatu"
    "re),\n            _        : false,\n        },\n        Ed25519 : match (key)\n        {\n            Ed"
    "25519Key(k) : ed25519_verify(k, message, signature),\n            _             : false,\n        },\n "
    "       UnsupportedSignature : false,\n    }\n}fn ascii_lower_eq(StringView a, StringView b) : bool\n{\n "
    "   if (StringView::len(a) != StringView::len(b))\n    {\n        return false;\n    }\n    for (usize i "
    "= 0; i < StringView::len(a); i += 1)\n    {\n        u8 x = a.bytes[i];\n        u8 y = b.bytes[i];\n   "
    "     if (ascii_is_upper(x))\n        {\n            x += 32;\n        }\n        if (ascii_is_upper(y))\n"
    "        {\n            y += 32;\n        }\n        if (x != y)\n        {\n            return false;\n   "
    "     }\n    }\n    true\n}fn name_matches(StringView pattern, StringView host) : bool\n{\n    if (StringV"
    "iew::starts_with(pattern, \"*.\"))\n    {\n        StringView suffix = &pattern[1..$];\n        match (St"
    "ringView::find(host, \".\"))\n        {\n            Some(dot) : dot > 0 && ascii_lower_eq(\n            "
    "    suffix,\n                &host[dot..$],\n            ) && Option::is_some(&StringView::find(&suffi"
    "x[1..$], \".\")),\n            None : false,\n        }\n    }\n    else\n    {\n        ascii_lower_eq(patt"
    "ern, host)\n    }\n}export fn Certificate::matches_host(ref<Certificate, shared> c, StringView host) :"
    " bool\n{\n    if (Ok(ip) = IpAddr::parse(host))\n    {\n        foreach (a in &c.ip_addresses)\n        {"
    "\n            if (IpAddr::text(a) == IpAddr::text(&ip))\n            {\n                return true;\n  "
    "          }\n        }\n        return false;\n    }\n    StringView h = if (StringView::ends_with(\n    "
    "    host,\n        \".\",\n    )) { &host[0..StringView::len(host) - 1] } else { host };\n    foreach (n "
    "in &c.dns_names)\n    {\n        if (name_matches(n, h))\n        {\n            return true;\n        }\n"
    "    }\n    false\n}fn check_time(ref<Certificate, shared> c, ref<DateTime, shared> now) : Result<void,"
    " CertError>\n{\n    if (DateTime::less(now, &c.not_before))\n    {\n        return Err(NotYetValid);\n   "
    " }\n    if (DateTime::less(&c.not_after, now))\n    {\n        return Err(Expired);\n    }\n    if (c.unh"
    "andled_critical)\n    {\n        return Err(UnhandledCritical);\n    }\n    Ok(())\n}fn same_bytes(ref<Ve"
    "c<u8>, shared> a, ref<Vec<u8>, shared> b) : bool\n{\n    Vec::len(a) == Vec::len(b) && digest_eq(a, b)"
    "\n}export fn verify_chain(\n    ref<Certificate, shared> leaf,\n    slice<Certificate, shared> intermed"
    "iates,\n    ref<TrustStore, shared> roots,\n    StringView host,\n    ref<DateTime, shared> now,\n) : Re"
    "sult<void, CertError>\n{\n    if (!Certificate::matches_host(leaf, host))\n    {\n        return Err(Hos"
    "tMismatch);\n    }\n    if (!leaf.server_auth)\n    {\n        return Err(WrongUsage);\n    }\n    check_t"
    "ime(leaf, now)?;\n    Certificate current = Certificate::clone(leaf);\n    usize below = 0;\n    CertEr"
    "ror last = UnknownAuthority;\n    for (usize depth = 0; depth < 10; depth += 1)\n    {\n        foreach"
    " (r in &roots.roots)\n        {\n            if (same_bytes(\n                &r.subject,\n             "
    "   &current.issuer,\n            ) && verify_signature(&r.key, &current.scheme, &current.tbs, &curren"
    "t.signature))\n            {\n                if (!r.is_ca || !r.can_sign_certificates)\n              "
    "  {\n                    last = NotAuthority;\n                    continue;\n                }\n       "
    "         if (Err(e) = check_time(r, now))\n                {\n                    last = e;\n          "
    "          continue;\n                }\n                return Ok(());\n            }\n        }\n       "
    " Option<Certificate> next = None;\n        for (usize i = 0; i < slice_len(intermediates); i += 1)\n  "
    "      {\n            ref<Certificate, shared> m = &intermediates[i];\n            if (same_bytes(&m.su"
    "bject, &current.issuer) && !same_bytes(&m.der, &current.der))\n            {\n                if (!ver"
    "ify_signature(&m.key, &current.scheme, &current.tbs, &current.signature))\n                {\n        "
    "            last = BadSignature;\n                    continue;\n                }\n                if "
    "(!m.is_ca || !m.can_sign_certificates)\n                {\n                    return Err(NotAuthority"
    ");\n                }\n                if (m.max_path_len >= 0 && narrow<i64>(below) > m.max_path_len)"
    "\n                {\n                    return Err(NotAuthority);\n                }\n                c"
    "heck_time(m, now)?;\n                overwrite(&mut next, Some(Certificate::clone(m)));\n             "
    "   break;\n            }\n        }\n        match (next)\n        {\n            Some(n) :\n            {"
    "\n                overwrite(&mut current, n);\n                below += 1;\n            },\n            "
    "None    : return Err(last),\n        }\n    }\n    Err(ChainTooLong)\n}fn der_push_len(ref<Vec<u8>, excl"
    "usive> out, usize len)\n{\n    if (len < 0x80)\n    {\n        Vec::push(out, narrow<u8>(len));\n        "
    "return;\n    }\n    usize count = 1;\n    while ((len >> narrow<u32>(8 * count)) != 0)\n    {\n        co"
    "unt += 1;\n    }\n    Vec::push(out, 0x80 | narrow<u8>(count));\n    for (usize i = 0; i < count; i += "
    "1)\n    {\n        Vec::push(out, narrow_wrapping<u8>(len >> narrow<u32>(8 * (count - 1 - i))));\n    }"
    "\n}fn der_wrap(u8 tag, slice<u8, shared> content) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n    Vec::"
    "push(&mut out, tag);\n    der_push_len(&mut out, slice_len(content));\n    Vec::extend_from(&mut out, "
    "content);\n    out\n}fn der_uint(slice<u8, shared> v) : Vec<u8>\n{\n    usize from = 0;\n    while (from "
    "+ 1 < slice_len(v) && v[from] == 0)\n    {\n        from += 1;\n    }\n    Vec<u8> content = Vec::new();"
    "\n    if (slice_len(v) == 0 || (v[from] & 0x80) != 0)\n    {\n        Vec::push(&mut content, 0);\n    }"
    "\n    Vec::extend_from(&mut content, &v[from..$]);\n    der_wrap(0x02, &content)\n}fn der_big(ref<BigUi"
    "nt, shared> a) : Vec<u8>\n{\n    der_uint(&BigUint::to_bytes_be(a))\n}fn der_oid_hex(str hex) : Vec<u8>"
    "\n{\n    Vec<u8> b = Result::unwrap_or(from_hex(StringView::of(hex)), Vec::new());\n    der_wrap(0x06, "
    "&b)\n}fn der_bit_string(slice<u8, shared> bytes) : Vec<u8>\n{\n    Vec<u8> content = Vec::new();\n    Ve"
    "c::push(&mut content, 0);\n    Vec::extend_from(&mut content, bytes);\n    der_wrap(0x03, &content)\n}f"
    "n curve_oid_hex(EcCurve c) : str\n{\n    match (c)\n    {\n        P256 : \"2a8648ce3d030107\",\n        P3"
    "84 : \"2b81040022\",\n    }\n}fn key_algorithm(ref<CertKey, shared> key) : Vec<u8>\n{\n    Vec<u8> content"
    " = match (key)\n    {\n        RsaKey(_)      :\n        {\n            Vec<u8> c = der_oid_hex(\"2a86488"
    "6f70d010101\");\n            Vec::push(&mut c, 0x05);\n            Vec::push(&mut c, 0x00);\n           "
    " c\n        },\n        EcKey(k)       :\n        {\n            Vec<u8> c = der_oid_hex(\"2a8648ce3d0201"
    "\");\n            Vec::extend_from(&mut c, &der_oid_hex(curve_oid_hex(k.curve)));\n            c\n      "
    "  },\n        Ed25519Key(_)  : der_oid_hex(\"2b6570\"),\n        UnsupportedKey : Vec::new(),\n    };\n   "
    " der_wrap(0x30, &content)\n}export fn CertKey::to_der(ref<CertKey, shared> key) : Option<Vec<u8>>\n{\n "
    "   Vec<u8> bits = match (key)\n    {\n        RsaKey(k)      :\n        {\n            Vec<u8> seq = der"
    "_big(&k.n);\n            Vec::extend_from(&mut seq, &der_big(&k.e));\n            der_wrap(0x30, &seq)"
    "\n        },\n        EcKey(k)       : Vec::clone(&k.point),\n        Ed25519Key(k)  : Vec::from_slice("
    "k),\n        UnsupportedKey : return None,\n    };\n    Vec<u8> content = key_algorithm(key);\n    Vec::"
    "extend_from(&mut content, &der_bit_string(&bits));\n    Some(der_wrap(0x30, &content))\n}export fn Cer"
    "tKey::from_der(slice<u8, shared> der) : Result<CertKey, CertError>\n{\n    Der spki = der_expect(der, "
    "0, 0x30)?;\n    if (spki.next != slice_len(der))\n    {\n        return Err(BadEncoding);\n    }\n    mat"
    "ch (public_key_of(der, spki)?)\n    {\n        UnsupportedKey : Err(UnsupportedAlgorithm),\n        k  "
    "            : Ok(k),\n    }\n}fn pem_block(StringView text, slice<str, shared> labels) : Result<Vec<u8"
    ">, CertError>\n{\n    // The earliest BEGIN line of any of the labels.\n    Option<usize> first = None;"
    "\n    usize at = 0;\n    for (usize i = 0; i < slice_len(labels); i += 1)\n    {\n        String begin ="
    " \"-----BEGIN \";\n        String::append(&mut begin, labels[i]);\n        String::append(&mut begin, \"-"
    "----\");\n        if (Some(v) = StringView::find(text, &begin))\n        {\n            if (Option::is_n"
    "one(&first) || v < at)\n            {\n                first = Some(i);\n                at = v;\n      "
    "      }\n        }\n    }\n    usize i = match (first)\n    {\n        Some(i) : i,\n        None    :\n   "
    "     {\n            if (Option::is_some(&StringView::find(text, \"-----BEGIN ENCRYPTED PRIVATE KEY----"
    "-\")))\n            {\n                return Err(UnsupportedAlgorithm);\n            }\n            retu"
    "rn Err(BadEncoding);\n        },\n    };\n    String begin = \"-----BEGIN \";\n    String::append(&mut beg"
    "in, labels[i]);\n    String::append(&mut begin, \"-----\");\n    String end = \"-----END \";\n    String::a"
    "ppend(&mut end, labels[i]);\n    String::append(&mut end, \"-----\");\n    StringView body = &text[at + "
    "StringView::len(&begin)..$];\n    usize e = match (StringView::find(body, &end))\n    {\n        Some(v"
    ") : v,\n        None    : return Err(BadEncoding),\n    };\n    String b64 = String::new();\n    StringV"
    "iew block = &body[0..e];\n    for (usize k = 0; k < StringView::len(block); k += 1)\n    {\n        u8 "
    "c = block.bytes[k];\n        if (c >= 128)\n        {\n            return Err(BadEncoding);\n        }\n "
    "       if (!ascii_is_space(c))\n        {\n            String::push_ascii(&mut b64, c);\n        }\n    "
    "}\n    match (base64_decode(&b64))\n    {\n        Ok(der) : Ok(der),\n        Err(_)  : Err(BadEncoding"
    "),\n    }\n}fn pem_of(str label, slice<u8, shared> der) : String\n{\n    String out = \"-----BEGIN \";\n   "
    " String::append(&mut out, label);\n    String::append(&mut out, \"-----\\n\");\n    String b64 = base64_e"
    "ncode(der);\n    usize n = StringView::len(&b64);\n    for (usize at = 0; at < n; at += 64)\n    {\n    "
    "    String::append(&mut out, &b64[at..min(at + 64, n)]);\n        String::append(&mut out, \"\\n\");\n   "
    " }\n    String::append(&mut out, \"-----END \");\n    String::append(&mut out, label);\n    String::appen"
    "d(&mut out, \"-----\\n\");\n    out\n}export fn CertKey::from_pem(StringView text) : Result<CertKey, Cert"
    "Error>\n{\n    array<str, 1> labels = [\"PUBLIC KEY\"];\n    Vec<u8> der = pem_block(text, &labels)?;\n   "
    " CertKey::from_der(&der)\n}export fn CertKey::to_pem(ref<CertKey, shared> key) : Option<String>\n{\n   "
    " Some(pem_of(\"PUBLIC KEY\", &CertKey::to_der(key)?))\n}unittest \"CertKey::to_pem: read back by from_pe"
    "m\"\n{\n    CertKey key = Ed25519Key([0x42; 32]);\n    String pem = Option::unwrap(CertKey::to_pem(&key)"
    ");\n    assert(StringView::starts_with(&pem, \"-----BEGIN PUBLIC KEY-----\\n\"));\n    match (CertKey::fr"
    "om_pem(&pem))\n    {\n        Ok(Ed25519Key(k)) : assert(k[0] == 0x42 && k[31] == 0x42),\n        _    "
    "             : assert(false),\n    }\n}export fn PrivateKey::public_key(ref<PrivateKey, shared> key) :"
    " CertKey\n{\n    match (key)\n    {\n        RsaPrivate(k)     : RsaKey(RsaPrivateKey::public_key(k)),\n "
    "       EcPrivate(k) : EcKey(EcPublicKey { .curve = k.curve, .point = Option::unwrap_or(\n            "
    "ec_public_key(k.curve, &k.scalar),\n            Vec::new(),\n        ) }),\n        Ed25519Private(k) :"
    " Ed25519Key(ed25519_public_key(k)),\n    }\n}fn rsa_private_of(slice<u8, shared> buf, usize at) : Resu"
    "lt<PrivateKey, CertError>\n{\n    Der seq = der_expect(buf, at, 0x30)?;\n    Der version = der_expect(b"
    "uf, seq.start, 0x02)?;\n    Der n = der_expect(buf, version.next, 0x02)?;\n    Der e = der_expect(buf,"
    " n.next, 0x02)?;\n    Der d = der_expect(buf, e.next, 0x02)?;\n    Der p = der_expect(buf, d.next, 0x0"
    "2)?;\n    Der q = der_expect(buf, p.next, 0x02)?;\n    match (RsaPrivateKey::new(\n        BigUint::fro"
    "m_bytes_be(&buf[n.start..n.end]),\n        BigUint::from_bytes_be(&buf[e.start..e.end]),\n        BigU"
    "int::from_bytes_be(&buf[d.start..d.end]),\n        BigUint::from_bytes_be(&buf[p.start..p.end]),\n    "
    "    BigUint::from_bytes_be(&buf[q.start..q.end]),\n    ))\n    {\n        Some(k) : Ok(RsaPrivate(k)),\n"
    "        None    : Err(BadEncoding),\n    }\n}fn ec_private_of(slice<u8, shared> buf, usize at, Option<"
    "EcCurve> curve) : Result<PrivateKey, CertError>\n{\n    Der seq = der_expect(buf, at, 0x30)?;\n    Der "
    "version = der_expect(buf, seq.start, 0x02)?;\n    Der scalar = der_expect(buf, version.next, 0x04)?;\n"
    "    Option<EcCurve> found = curve;\n    usize p_at = scalar.next;\n    while (p_at < seq.end)\n    {\n  "
    "      Der field = match (der_read(buf, p_at))\n        {\n            Some(v) : v,\n            None   "
    " : return Err(BadEncoding),\n        };\n        if (field.tag == 0xa0)\n        {\n            Der oid "
    "= der_expect(buf, field.start, 0x06)?;\n            if (der_eq_hex(buf, oid, \"2a8648ce3d030107\"))\n   "
    "         {\n                found = Some(P256);\n            }\n            else if (der_eq_hex(buf, oi"
    "d, \"2b81040022\"))\n            {\n                found = Some(P384);\n            }\n            else\n "
    "           {\n                return Err(UnsupportedAlgorithm);\n            }\n        }\n        p_at "
    "= field.next;\n    }\n    EcCurve c = match (found)\n    {\n        Some(v) : v,\n        None    : retur"
    "n Err(UnsupportedAlgorithm),\n    };\n    Vec<u8> k = Vec::from_slice(&buf[scalar.start..scalar.end]);"
    "\n    usize want = if (c == P256) { 32 } else { 48 };\n    if (Vec::len(&k) != want || Option::is_none"
    "(&ec_public_key(c, &k)))\n    {\n        return Err(BadEncoding);\n    }\n    Ok(EcPrivate(EcPrivateKey "
    "{ .curve = c, .scalar = k }))\n}export fn PrivateKey::from_der(slice<u8, shared> der) : Result<Privat"
    "eKey, CertError>\n{\n    Der seq = der_expect(der, 0, 0x30)?;\n    if (seq.next != slice_len(der))\n    "
    "{\n        return Err(BadEncoding);\n    }\n    Der version = der_expect(der, seq.start, 0x02)?;\n    De"
    "r second = match (der_read(der, version.next))\n    {\n        Some(v) : v,\n        None    : return E"
    "rr(BadEncoding),\n    };\n    if (second.tag == 0x02)\n    {\n        return rsa_private_of(der, 0);\n   "
    " }\n    if (second.tag == 0x04)\n    {\n        return ec_private_of(der, 0, None);\n    }\n    if (secon"
    "d.tag != 0x30)\n    {\n        return Err(BadEncoding);\n    }\n    Der oid = der_expect(der, second.sta"
    "rt, 0x06)?;\n    Der key = der_expect(der, second.next, 0x04)?;\n    if (der_eq_hex(der, oid, \"2a86488"
    "6f70d010101\"))\n    {\n        return rsa_private_of(der, key.start);\n    }\n    if (der_eq_hex(der, oi"
    "d, \"2a8648ce3d0201\"))\n    {\n        Der curve = der_expect(der, oid.next, 0x06)?;\n        if (der_eq"
    "_hex(der, curve, \"2a8648ce3d030107\"))\n        {\n            return ec_private_of(der, key.start, Som"
    "e(P256));\n        }\n        if (der_eq_hex(der, curve, \"2b81040022\"))\n        {\n            return e"
    "c_private_of(der, key.start, Some(P384));\n        }\n        return Err(UnsupportedAlgorithm);\n    }\n"
    "    if (der_eq_hex(der, oid, \"2b6570\"))\n    {\n        Der inner = der_expect(der, key.start, 0x04)?;"
    "\n        if (inner.end - inner.start != 32 || inner.next != key.end)\n        {\n            return Er"
    "r(BadEncoding);\n        }\n        array<u8, 32> seed = [0; 32];\n        for (usize i = 0; i < 32; i "
    "+= 1)\n        {\n            seed[i] = der[inner.start + i];\n        }\n        return Ok(Ed25519Priva"
    "te(seed));\n    }\n    Err(UnsupportedAlgorithm)\n}export fn PrivateKey::to_der(ref<PrivateKey, shared>"
    " key) : Vec<u8>\n{\n    CertKey public = PrivateKey::public_key(key);\n    Vec<u8> inner = match (key)\n"
    "    {\n        RsaPrivate(k)     :\n        {\n            BigUint one = BigUint::from_u64(1);\n        "
    "    BigUint p1 = BigUint::sub(&k.p, &one);\n            BigUint q1 = BigUint::sub(&k.q, &one);\n      "
    "      Vec<u8> seq = der_uint([0: u8]);\n            Vec::extend_from(&mut seq, &der_big(&k.n));\n     "
    "       Vec::extend_from(&mut seq, &der_big(&k.e));\n            Vec::extend_from(&mut seq, &der_big(&"
    "k.d));\n            Vec::extend_from(&mut seq, &der_big(&k.p));\n            Vec::extend_from(&mut seq"
    ", &der_big(&k.q));\n            Vec::extend_from(&mut seq, &der_big(&BigUint::rem(&k.d, &p1)));\n     "
    "       Vec::extend_from(&mut seq, &der_big(&BigUint::rem(&k.d, &q1)));\n            Vec::extend_from("
    "\n                &mut seq,\n                &der_big(&Option::unwrap_or(BigUint::mod_inverse(&k.q, &k"
    ".p), BigUint::zero())),\n            );\n            der_wrap(0x30, &seq)\n        },\n        EcPrivate"
    "(k)      :\n        {\n            Vec<u8> seq = der_uint([1: u8]);\n            Vec::extend_from(&mut "
    "seq, &der_wrap(0x04, &k.scalar));\n            Vec<u8> point = match (&public)\n            {\n        "
    "        EcKey(pk) : Vec::clone(&pk.point),\n                _         : Vec::new(),\n            };\n  "
    "          Vec::extend_from(&mut seq, &der_wrap(0xa1, &der_bit_string(&point)));\n            der_wrap"
    "(0x30, &seq)\n        },\n        Ed25519Private(k) : der_wrap(0x04, k),\n    };\n    Vec<u8> content = "
    "der_uint([0: u8]);\n    Vec::extend_from(&mut content, &key_algorithm(&public));\n    Vec::extend_from"
    "(&mut content, &der_wrap(0x04, &inner));\n    der_wrap(0x30, &content)\n}export fn PrivateKey::from_pe"
    "m(StringView text) : Result<PrivateKey, CertError>\n{\n    array<str, 3> labels = [\"PRIVATE KEY\", \"RSA"
    " PRIVATE KEY\", \"EC PRIVATE KEY\"];\n    Vec<u8> der = pem_block(text, &labels)?;\n    PrivateKey::from_"
    "der(&der)\n}unittest \"PrivateKey::from_pem: an encrypted key is not read\"\n{\n    StringView text = \"--"
    "---BEGIN ENCRYPTED PRIVATE KEY-----\\nAAAA\\n-----END ENCRYPTED PRIVATE KEY-----\\n\";\n    match (Privat"
    "eKey::from_pem(text))\n    {\n        Err(UnsupportedAlgorithm) : assert(true),\n        _             "
    "            : assert(false),\n    }\n}export fn PrivateKey::to_pem(ref<PrivateKey, shared> key) : Stri"
    "ng\n{\n    pem_of(\"PRIVATE KEY\", &PrivateKey::to_der(key))\n}export fn sign(\n    ref<PrivateKey, shared"
    "> key,\n    ref<SignatureScheme, shared> scheme,\n    slice<u8, shared> message,\n) : Option<Vec<u8>>\n{"
    "\n    match (scheme)\n    {\n        RsaPkcs1(h) : match (key)\n        {\n            RsaPrivate(k) : So"
    "me(rsa_sign_pkcs1v15(k, *h, &hash(*h, message))),\n            _             : None,\n        },\n     "
    "   RsaPss(h) : match (key)\n        {\n            RsaPrivate(k) : Some(rsa_sign_pss(k, *h, &hash(*h, "
    "message))),\n            _             : None,\n        },\n        Ecdsa(h) : match (key)\n        {\n  "
    "          EcPrivate(k) : ecdsa_sign(k.curve, &k.scalar, &hash(*h, message)),\n            _          "
    "  : None,\n        },\n        Ed25519 : match (key)\n        {\n            Ed25519Private(k) : Some(Ve"
    "c::from_slice(&ed25519_sign(k, message))),\n            _                 : None,\n        },\n        "
    "UnsupportedSignature : None,\n    }\n}unittest \"sign: a key of another kind gives None\"\n{\n    PrivateK"
    "ey key = Ed25519Private([1; 32]);\n    SignatureScheme scheme = RsaPss(Sha2_256);\n    assert(Option::"
    "is_none(&sign(&key, &scheme, b\"message\")));\n}export fn TlsError::text(ref<TlsError, shared> e) : str"
    "\n{\n    match (e)\n    {\n        TlsNetFailure(n) : NetError::text(n),\n        CertRejected(c)  : Cert"
    "Error::text(c),\n        HandshakeFailed  : \"TLS handshake failed\",\n        ProtocolError    : \"TLS p"
    "rotocol violation\",\n        PeerAlert(code) : match (*code)\n        {\n            40  : \"the peer re"
    "fused the handshake (alert 40): it supports none of the suites (ChaCha20-Poly1305, AES-128-GCM, AES-"
    "256-GCM) or key exchanges (X25519, P-256, P-384) offered\",\n            42  : \"the peer refused a cer"
    "tificate (alert 42)\",\n            70  : \"the peer does not speak TLS 1.3 (alert 70)\",\n            80"
    "  : \"the peer failed internally (alert 80)\",\n            109 : \"the peer requires an extension that "
    "was not sent (alert 109)\",\n            112 : \"the peer does not know the name asked for (alert 112)\""
    ",\n            _   : \"the peer sent a TLS alert\",\n        },\n        RecordRejected   : \"a TLS record"
    " did not authenticate\",\n    }\n}unittest \"TlsError::text: alerts and network failures\"\n{\n    TlsError"
    " e = PeerAlert(70);\n    assert(TlsError::text(&e) == \"the peer does not speak TLS 1.3 (alert 70)\");\n"
    "    TlsError n = TlsNetFailure(Refused);\n    assert(TlsError::text(&n) == \"connection refused\");\n}fn"
    " suite_hash(u16 suite) : HashKind\n{\n    if (suite == 0x1302) { Sha2_384 } else { Sha2_256 }\n}fn suit"
    "e_key_len(u16 suite) : usize\n{\n    if (suite == 0x1301) { 16 } else { 32 }\n}fn keys_from(slice<u8, s"
    "hared> secret, u16 suite) : RecordKeys\n{\n    Vec<u8> none = Vec::new();\n    HashKind kind = suite_ha"
    "sh(suite);\n    RecordKeys {\n        .key = hkdf_expand_label_with(kind, secret, \"key\", &none, suite_"
    "key_len(suite)),\n        .iv = hkdf_expand_label_with(kind, secret, \"iv\", &none, 12),\n        .seq ="
    " 0,\n        .secret = Vec::from_slice(secret),\n        .suite = suite,\n    }\n}fn record_nonce(ref<Re"
    "cordKeys, shared> k) : Vec<u8>\n{\n    Vec<u8> n = Vec::clone(&k.iv);\n    for (usize i = 0; i < 8; i +"
    "= 1)\n    {\n        n[4 + i] = n[4 + i] ^ narrow_wrapping<u8>(k.seq >> narrow<u32>(56 - 8 * i));\n    "
    "}\n    n\n}export fn TlsStream::peer_certificate(ref<TlsStream, shared> s) : Option<ref<Certificate, s"
    "hared>>\n{\n    match (&s.peer)\n    {\n        Some(c) : Some(c),\n        None    : None,\n    }\n}export"
    " fn TlsStream::peer_addr(ref<TlsStream, shared> s) : SocketAddr\n{\n    TcpStream::peer_addr(&s.tcp)\n}"
    "export fn TlsStream::local_addr(ref<TlsStream, shared> s) : SocketAddr\n{\n    TcpStream::local_addr(&"
    "s.tcp)\n}fn read_record(ref<TcpStream, exclusive> tcp) : Result<Record, TlsError>\n{\n    Vec<u8> heade"
    "r = Vec::new();\n    match (TcpStream::read_exact(tcp, &mut header, 5))\n    {\n        Ok(_)  : {},\n  "
    "      Err(e) : return Err(TlsNetFailure(e)),\n    }\n    usize len = widen<usize>(read_be<u16>(&header"
    ", 3));\n    if (len > 16384 + 256)\n    {\n        return Err(ProtocolError);\n    }\n    Vec<u8> body = "
    "Vec::new();\n    match (TcpStream::read_exact(tcp, &mut body, len))\n    {\n        Ok(_)  : {},\n      "
    "  Err(e) : return Err(TlsNetFailure(e)),\n    }\n    Ok(Record { .kind = header[0], .header = header, "
    ".body = body })\n}fn write_all(ref<TcpStream, exclusive> tcp, slice<u8, shared> data) : Result<void, "
    "TlsError>\n{\n    match (TcpStream::write(tcp, data))\n    {\n        Ok(_)  : Ok(()),\n        Err(e) : "
    "Err(TlsNetFailure(e)),\n    }\n}fn seal_record(ref<RecordKeys, exclusive> k, u8 kind, slice<u8, shared"
    "> content) : Vec<u8>\n{\n    Vec<u8> inner = Vec::from_slice(content);\n    Vec::push(&mut inner, kind)"
    ";\n    Vec<u8> header = Vec::new();\n    Vec::push(&mut header, 23);\n    Vec::push_be(&mut header, 0x0"
    "303: u16);\n    Vec::push_be(&mut header, narrow<u16>(Vec::len(&inner) + 16));\n    Vec<u8> nonce = re"
    "cord_nonce(k);\n    Vec<u8> sealed = if (k.suite != 0x1303)\n    {\n        aes_gcm_seal(&k.key, &nonce"
    ", &header, &inner)\n    }\n    else\n    {\n        chacha20_poly1305_seal(&k.key, &nonce, &header, &inn"
    "er)\n    };\n    k.seq += 1;\n    Vec::extend_from(&mut header, &sealed);\n    header\n}fn open_record(re"
    "f<RecordKeys, exclusive> k, ref<Record, shared> r) : Result<Inner, TlsError>\n{\n    if (r.kind != 23)"
    "\n    {\n        return Err(ProtocolError);\n    }\n    Vec<u8> nonce = record_nonce(k);\n    Option<Vec<"
    "u8>> opened = if (k.suite != 0x1303)\n    {\n        aes_gcm_open(&k.key, &nonce, &r.header, &r.body)\n"
    "    }\n    else\n    {\n        chacha20_poly1305_open(&k.key, &nonce, &r.header, &r.body)\n    };\n    V"
    "ec<u8> plain = match (opened)\n    {\n        Some(p) : p,\n        None    : return Err(RecordRejected"
    "),\n    };\n    k.seq += 1;\n    usize n = Vec::len(&plain);\n    while (n > 0 && plain[n - 1] == 0)\n   "
    " {\n        n -= 1;\n    }\n    if (n == 0 || n - 1 > 16384)\n    {\n        return Err(ProtocolError);\n "
    "   }\n    u8 kind = plain[n - 1];\n    Vec::truncate(&mut plain, n - 1);\n    Ok(Inner { .kind = kind, "
    ".content = plain })\n}fn transcript_add(ref<Handshake, exclusive> hs, slice<u8, shared> msg)\n{\n    Ha"
    "sher::update(&mut hs.t256, msg);\n    Hasher::update(&mut hs.t384, msg);\n}fn next_message(\n    ref<Ha"
    "ndshake, exclusive> hs,\n    ref<TcpStream, exclusive> tcp,\n    ref<Option<RecordKeys>, exclusive> ke"
    "ys,\n) : Result<Vec<u8>, TlsError>\n{\n    while (Vec::len(&hs.buffer) < 4 || Vec::len(&hs.buffer) < 4 "
    "+ (widen<usize>(hs.buffer[1]) << 16 | widen<usize>(hs.buffer[2]) << 8 | widen<usize>(hs.buffer[3])))"
    "\n    {\n        Record r = read_record(tcp)?;\n        if (r.kind == 20)\n        {\n            // A co"
    "mpatibility ChangeCipherSpec (RFC 8446 §D.4): ignored.\n            continue;\n        }\n        if ("
    "r.kind == 21)\n        {\n            if (Vec::len(&r.body) == 2)\n            {\n                return"
    " Err(PeerAlert(r.body[1]));\n            }\n            return Err(ProtocolError);\n        }\n        m"
    "atch (keys)\n        {\n            Some(k) :\n            {\n                Inner i = open_record(k, &"
    "r)?;\n                if (i.kind == 21)\n                {\n                    return Err(PeerAlert(if"
    " (Vec::len(&i.content) == 2) { i.content[1] } else { 0 }));\n                }\n                if (i."
    "kind != 22)\n                {\n                    return Err(ProtocolError);\n                }\n     "
    "           Vec::extend_from(&mut hs.buffer, &i.content);\n            },\n            None    :\n      "
    "      {\n                if (r.kind != 22)\n                {\n                    return Err(ProtocolE"
    "rror);\n                }\n                Vec::extend_from(&mut hs.buffer, &r.body);\n            },\n "
    "       }\n    }\n    usize len = 4 + (widen<usize>(hs.buffer[1]) << 16 | widen<usize>(hs.buffer[2]) <<"
    " 8 | widen<usize>(hs.buffer[3]));\n    Vec<u8> msg = Vec::from_slice(&hs.buffer[0..len]);\n    Vec<u8>"
    " rest = Vec::from_slice(&hs.buffer[len..$]);\n    overwrite(&mut hs.buffer, rest);\n    transcript_add"
    "(hs, &msg);\n    Ok(msg)\n}fn push_u24(ref<Vec<u8>, exclusive> v, usize n)\n{\n    Vec::push(v, narrow<u"
    "8>(n >> 16));\n    Vec::push(v, narrow_wrapping<u8>(n >> 8));\n    Vec::push(v, narrow_wrapping<u8>(n)"
    ");\n}fn push_extension(ref<Vec<u8>, exclusive> out, u16 kind, slice<u8, shared> data)\n{\n    Vec::push"
    "_be(out, kind);\n    Vec::push_be(out, narrow<u16>(slice_len(data)));\n    Vec::extend_from(out, data)"
    ";\n}fn client_hello(\n    StringView server_name,\n    slice<u8, shared> random,\n    slice<u8, shared> "
    "session,\n    u16 group,\n    slice<u8, shared> public_key,\n    slice<u8, shared> cookie,\n) : Vec<u8>\n"
    "{\n    Vec<u8> ext = Vec::new();\n    if (Result::is_err(&IpAddr::parse(server_name)))\n    {\n        V"
    "ec<u8> sni = Vec::new();\n        Vec::push_be(&mut sni, narrow<u16>(StringView::len(server_name) + 3"
    "));\n        Vec::push(&mut sni, 0);\n        Vec::push_be(&mut sni, narrow<u16>(StringView::len(serve"
    "r_name)));\n        Vec::extend_from(&mut sni, server_name.bytes);\n        push_extension(&mut ext, 0"
    "x0000, &sni);\n    }\n    array<u8, 8> groups = [0x00, 0x06, 0x00, 0x1d, 0x00, 0x17, 0x00, 0x18];\n    "
    "push_extension(&mut ext, 0x000a, &groups);\n    array<u8, 20> algs = [\n        0x00,\n        0x12,\n  "
    "      0x04,\n        0x03,\n        0x05,\n        0x03,\n        0x08,\n        0x04,\n        0x08,\n    "
    "    0x05,\n        0x08,\n        0x06,\n        0x08,\n        0x07,\n        0x04,\n        0x01,\n      "
    "  0x05,\n        0x01,\n        0x06,\n        0x01,\n    ];\n    push_extension(&mut ext, 0x000d, &algs)"
    ";\n    array<u8, 3> versions = [0x02, 0x03, 0x04];\n    push_extension(&mut ext, 0x002b, &versions);\n "
    "   Vec<u8> share = Vec::new();\n    Vec::push_be(&mut share, narrow<u16>(4 + slice_len(public_key)));"
    "\n    Vec::push_be(&mut share, group);\n    Vec::push_be(&mut share, narrow<u16>(slice_len(public_key)"
    "));\n    Vec::extend_from(&mut share, public_key);\n    push_extension(&mut ext, 0x0033, &share);\n    "
    "if (slice_len(cookie) > 0)\n    {\n        push_extension(&mut ext, 0x002c, cookie);\n    }\n    Vec<u8>"
    " body = Vec::new();\n    Vec::push_be(&mut body, 0x0303: u16);\n    Vec::extend_from(&mut body, random"
    ");\n    Vec::push(&mut body, 32);\n    Vec::extend_from(&mut body, session);\n    array<u8, 8> suites ="
    " [0x00, 0x06, 0x13, 0x03, 0x13, 0x01, 0x13, 0x02];\n    Vec::extend_from(&mut body, &suites);\n    Vec"
    "::push(&mut body, 1);\n    Vec::push(&mut body, 0);\n    Vec::push_be(&mut body, narrow<u16>(Vec::len("
    "&ext)));\n    Vec::extend_from(&mut body, &ext);\n    Vec<u8> msg = Vec::new();\n    Vec::push(&mut msg"
    ", 1);\n    push_u24(&mut msg, Vec::len(&body));\n    Vec::extend_from(&mut msg, &body);\n    msg\n}fn se"
    "rver_hello(slice<u8, shared> sh, slice<u8, shared> session) : Result<ServerHello, TlsError>\n{\n    us"
    "ize n = slice_len(sh);\n    if (n < 4 + 2 + 32 + 1 || sh[0] != 2)\n    {\n        return Err(ProtocolEr"
    "ror);\n    }\n    // HelloRetryRequest's fixed random.\n    Vec<u8> hrr = Result::unwrap_or(\n        fr"
    "om_hex(\"cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c\"),\n        Vec::new(),\n    "
    ");\n    bool retry = digest_eq(&sh[6..38], &hrr);\n    usize at = 38;\n    usize sid_len = widen<usize>"
    "(sh[at]);\n    if (sid_len != slice_len(session) || at + 1 + sid_len + 3 + 2 > n || !digest_eq(\n     "
    "   &sh[at + 1..at + 1 + sid_len],\n        session,\n    ))\n    {\n        return Err(ProtocolError);\n "
    "   }\n    at = at + 1 + sid_len;\n    u16 suite = read_be<u16>(sh, at);\n    if ((suite != 0x1303 && su"
    "ite != 0x1301 && suite != 0x1302) || sh[at + 2] != 0)\n    {\n        return Err(HandshakeFailed);\n   "
    " }\n    at += 3;\n    usize ext_end = at + 2 + widen<usize>(read_be<u16>(sh, at));\n    if (ext_end != "
    "n)\n    {\n        return Err(ProtocolError);\n    }\n    at += 2;\n    bool tls13 = false;\n    Option<u1"
    "6> group = None;\n    Vec<u8> share = Vec::new();\n    Vec<u8> cookie = Vec::new();\n    while (at + 4 "
    "<= ext_end)\n    {\n        u16 kind = read_be<u16>(sh, at);\n        usize len = widen<usize>(read_be<"
    "u16>(sh, at + 2));\n        usize start = at + 4;\n        if (start + len > ext_end)\n        {\n      "
    "      return Err(ProtocolError);\n        }\n        if (kind == 0x002b)\n        {\n            tls13 ="
    " len == 2 && sh[start] == 0x03 && sh[start + 1] == 0x04;\n        }\n        else if (kind == 0x0033)\n"
    "        {\n            if (len < 2)\n            {\n                return Err(ProtocolError);\n        "
    "    }\n            u16 g = read_be<u16>(sh, start);\n            if (g != 0x001d && g != 0x0017 && g !"
    "= 0x0018)\n            {\n                return Err(HandshakeFailed);\n            }\n            group"
    " = Some(g);\n            if (!retry)\n            {\n                usize want = if (g == 0x001d) { 32"
    " } else if (g == 0x0017) { 65 } else { 97 };\n                if (len != 4 + want || widen<usize>(rea"
    "d_be<u16>(sh, start + 2)) != want)\n                {\n                    return Err(HandshakeFailed)"
    ";\n                }\n                overwrite(&mut share, Vec::from_slice(&sh[start + 4..start + len"
    "]));\n            }\n            else if (len != 2)\n            {\n                return Err(ProtocolE"
    "rror);\n            }\n        }\n        else if (kind == 0x002c && retry)\n        {\n            overw"
    "rite(&mut cookie, Vec::from_slice(&sh[start..start + len]));\n        }\n        at = start + len;\n   "
    " }\n    if (!tls13)\n    {\n        return Err(HandshakeFailed);\n    }\n    match (group)\n    {\n        "
    "Some(g) : Ok(ServerHello { .retry = retry, .suite = suite, .group = g, .share = share, .cookie = coo"
    "kie }),\n        None    : Err(HandshakeFailed),\n    }\n}fn handshake_record(slice<u8, shared> msg, u1"
    "6 version) : Vec<u8>\n{\n    Vec<u8> rec = Vec::new();\n    Vec::push(&mut rec, 22);\n    Vec::push_be(&"
    "mut rec, version);\n    Vec::push_be(&mut rec, narrow<u16>(slice_len(msg)));\n    Vec::extend_from(&mu"
    "t rec, msg);\n    rec\n}fn transcript_hash(ref<Handshake, shared> hs) : Vec<u8>\n{\n    match (hs.kind)\n"
    "    {\n        Sha2_384 : Hasher::finish(hs.t384),\n        _        : Hasher::finish(hs.t256),\n    }\n"
    "}fn derive_secret(HashKind kind, slice<u8, shared> secret, StringView label, slice<u8, shared> trans"
    "cript) : Vec<u8>\n{\n    hkdf_expand_label_with(kind, secret, label, transcript, slice_len(secret))\n}f"
    "n certificate_list(slice<u8, shared> m) : Result<Vec<Certificate>, TlsError>\n{\n    usize n = slice_l"
    "en(m);\n    if (n < 8 || m[0] != 11 || m[4] != 0)\n    {\n        return Err(ProtocolError);\n    }\n    "
    "usize at = 5;\n    usize list_end = at + 3 + (widen<usize>(m[at]) << 16 | widen<usize>(m[at + 1]) << "
    "8 | widen<usize>(m[at + 2]));\n    if (list_end != n)\n    {\n        return Err(ProtocolError);\n    }\n"
    "    at += 3;\n    Vec<Certificate> out = Vec::new();\n    while (at < list_end)\n    {\n        if (at +"
    " 3 > list_end)\n        {\n            return Err(ProtocolError);\n        }\n        usize len = widen<"
    "usize>(m[at]) << 16 | widen<usize>(m[at + 1]) << 8 | widen<usize>(m[at + 2]);\n        usize start = "
    "at + 3;\n        if (start + len + 2 > list_end)\n        {\n            return Err(ProtocolError);\n   "
    "     }\n        match (Certificate::parse(&m[start..start + len]))\n        {\n            Ok(c)  : Vec"
    "::push(&mut out, c),\n            Err(e) : return Err(CertRejected(e)),\n        }\n        usize ext_l"
    "en = widen<usize>(read_be<u16>(m, start + len));\n        at = start + len + 2 + ext_len;\n    }\n    i"
    "f (Vec::len(&out) == 0)\n    {\n        return Err(HandshakeFailed);\n    }\n    Ok(out)\n}fn certificate"
    "_verify_ok(slice<u8, shared> m, ref<Certificate, shared> leaf, slice<u8, shared> transcript) : bool\n"
    "{\n    if (slice_len(m) < 8 || m[0] != 15)\n    {\n        return false;\n    }\n    u16 code = read_be<u"
    "16>(m, 4);\n    usize len = widen<usize>(read_be<u16>(m, 6));\n    if (8 + len != slice_len(m))\n    {\n"
    "        return false;\n    }\n    SignatureScheme scheme = UnsupportedSignature;\n    bool curve_ok = t"
    "rue;\n    if (code == 0x0403 || code == 0x0503)\n    {\n        EcCurve want = if (code == 0x0403) { P2"
    "56 } else { P384 };\n        curve_ok = match (&leaf.key)\n        {\n            EcKey(k) : k.curve =="
    " want,\n            _        : false,\n        };\n        scheme = Ecdsa(if (code == 0x0403) { Sha2_25"
    "6 } else { Sha2_384 });\n    }\n    else if (code == 0x0804)\n    {\n        scheme = RsaPss(Sha2_256);\n"
    "    }\n    else if (code == 0x0805)\n    {\n        scheme = RsaPss(Sha2_384);\n    }\n    else if (code "
    "== 0x0806)\n    {\n        scheme = RsaPss(Sha2_512);\n    }\n    else if (code == 0x0807)\n    {\n       "
    " scheme = Ed25519;\n    }\n    if (!curve_ok)\n    {\n        return false;\n    }\n    Vec<u8> content = "
    "Vec::filled(64, 0x20: u8);\n    Vec::extend_from(&mut content, b\"TLS 1.3, server CertificateVerify\");"
    "\n    Vec::push(&mut content, 0);\n    Vec::extend_from(&mut content, transcript);\n    verify_signatur"
    "e(&leaf.key, &scheme, &content, &m[8..$])\n}fn finished_data(HashKind kind, slice<u8, shared> secret,"
    " slice<u8, shared> transcript) : Vec<u8>\n{\n    Vec<u8> none = Vec::new();\n    Vec<u8> key = hkdf_exp"
    "and_label_with(kind, secret, \"finished\", &none, slice_len(secret));\n    hmac(kind, &key, transcript)"
    "\n}export fn TlsStream::client(\n    TcpStream tcp,\n    StringView server_name,\n    ref<TrustStore, sh"
    "ared> roots,\n) : Result<TlsStream, TlsError>\n{\n    array<u8, 32> private_key = x25519_private_key();"
    "\n    array<u8, 32> public_key = x25519_public_key(&private_key);\n    array<u8, 32> random = [0; 32];"
    "\n    os_random_bytes(&mut random);\n    array<u8, 32> session = [0; 32];\n    os_random_bytes(&mut ses"
    "sion);\n    Handshake hs = Handshake { .buffer = Vec::new(), .t256 = Hasher::new(Sha2_256), .t384 = H"
    "asher::new(Sha2_384), .kind = Sha2_256 };\n    Vec<u8> none = Vec::new();\n    Vec<u8> ch = client_hel"
    "lo(server_name, &random, &session, 0x001d, &public_key, &none);\n    transcript_add(&mut hs, &ch);\n  "
    "  write_all(&mut tcp, &handshake_record(&ch, 0x0301))?;\n    Option<RecordKeys> plain = None;\n    Vec"
    "<u8> sh = next_message(&mut hs, &mut tcp, &mut plain)?;\n    ServerHello hello = server_hello(&sh, &s"
    "ession)?;\n    hs.kind = suite_hash(hello.suite);\n    HashKind kind = hs.kind;\n    Vec<u8> ec_key = V"
    "ec::new();\n    if (hello.retry)\n    {\n        // A HelloRetryRequest (RFC 8446 §4.1.4): it may only"
    " ask for a\n        // group this client offered without a share, P-256 or P-384. The\n        // tran"
    "script restarts from message_hash(ClientHello1) ‖\n        // HelloRetryRequest, under the suite's "
    "hash.\n        if ((hello.group != 0x0017 && hello.group != 0x0018) || Vec::len(&hs.buffer) != 0)\n   "
    "     {\n            return Err(HandshakeFailed);\n        }\n        EcCurve curve = if (hello.group =="
    " 0x0017) { P256 } else { P384 };\n        Vec<u8> ch_hash = hash(kind, &ch);\n        array<u8, 4> hea"
    "d = [254, 0, 0, narrow<u8>(Vec::len(&ch_hash))];\n        Handshake restarted = Handshake { .buffer ="
    " Vec::new(), .t256 = Hasher::new(Sha2_256), .t384 = Hasher::new(Sha2_384), .kind = kind };\n        t"
    "ranscript_add(&mut restarted, &head);\n        transcript_add(&mut restarted, &ch_hash);\n        tran"
    "script_add(&mut restarted, &sh);\n        overwrite(&mut ec_key, ec_private_key(curve));\n        Vec<"
    "u8> ec_public = Option::unwrap(ec_public_key(curve, &ec_key));\n        Vec<u8> ch2 = client_hello(\n "
    "           server_name,\n            &random,\n            &session,\n            hello.group,\n        "
    "    &ec_public,\n            &hello.cookie,\n        );\n        transcript_add(&mut restarted, &ch2);\n"
    "        overwrite(&mut hs, restarted);\n        write_all(&mut tcp, &handshake_record(&ch2, 0x0303))?"
    ";\n        Vec<u8> sh2 = next_message(&mut hs, &mut tcp, &mut plain)?;\n        ServerHello second = s"
    "erver_hello(&sh2, &session)?;\n        if (second.retry || second.group != hello.group || second.suit"
    "e != hello.suite)\n        {\n            return Err(HandshakeFailed);\n        }\n        overwrite(&mu"
    "t hello, second);\n    }\n    else if (hello.group != 0x001d)\n    {\n        return Err(HandshakeFailed"
    ");\n    }\n    u16 suite = hello.suite;\n    Vec<u8> shared = Vec::new();\n    if (hello.group == 0x001d"
    ")\n    {\n        match (x25519(&private_key, &hello.share))\n        {\n            Some(z) : Vec::exte"
    "nd_from(&mut shared, &z),\n            None    : return Err(HandshakeFailed),\n        }\n    }\n    els"
    "e\n    {\n        EcCurve curve = if (hello.group == 0x0017) { P256 } else { P384 };\n        match (ec"
    "dh(curve, &ec_key, &hello.share))\n        {\n            Some(z) : overwrite(&mut shared, z),\n       "
    "     None    : return Err(HandshakeFailed),\n        }\n    }\n    // The key schedule (RFC 8446 §7.1)"
    ", under the suite's hash.\n    Vec<u8> empty_hash = hash(kind, &none);\n    Vec<u8> zeros = Vec::fille"
    "d(Vec::len(&empty_hash), 0: u8);\n    Vec<u8> early = hkdf_extract_with(kind, &none, &zeros);\n    Vec"
    "<u8> derived = derive_secret(kind, &early, \"derived\", &empty_hash);\n    Vec<u8> handshake_secret = h"
    "kdf_extract_with(kind, &derived, &shared);\n    Vec<u8> th = transcript_hash(&hs);\n    Vec<u8> c_hs ="
    " derive_secret(kind, &handshake_secret, \"c hs traffic\", &th);\n    Vec<u8> s_hs = derive_secret(kind,"
    " &handshake_secret, \"s hs traffic\", &th);\n    Option<RecordKeys> server_keys = Some(keys_from(&s_hs,"
    " suite));\n    Vec<u8> ee = next_message(&mut hs, &mut tcp, &mut server_keys)?;\n    if (Vec::len(&ee)"
    " < 6 || ee[0] != 8)\n    {\n        return Err(ProtocolError);\n    }\n    Vec<u8> cm = next_message(&mu"
    "t hs, &mut tcp, &mut server_keys)?;\n    Vec<Certificate> chain = certificate_list(&cm)?;\n    Certifi"
    "cate leaf = Vec::remove(&mut chain, 0);\n    DateTime now = DateTime::now();\n    match (verify_chain("
    "&leaf, &chain, roots, server_name, &now))\n    {\n        Ok(_)  : {},\n        Err(e) : return Err(Cer"
    "tRejected(e)),\n    }\n    Vec<u8> th_cert = transcript_hash(&hs);\n    Vec<u8> cv = next_message(&mut "
    "hs, &mut tcp, &mut server_keys)?;\n    if (!certificate_verify_ok(&cv, &leaf, &th_cert))\n    {\n      "
    "  return Err(HandshakeFailed);\n    }\n    Vec<u8> th_cv = transcript_hash(&hs);\n    Vec<u8> fin = nex"
    "t_message(&mut hs, &mut tcp, &mut server_keys)?;\n    Vec<u8> want = finished_data(kind, &s_hs, &th_c"
    "v);\n    if (Vec::len(&fin) != 4 + Vec::len(&want) || fin[0] != 20 || !digest_eq(&fin[4..$], &want))\n"
    "    {\n        return Err(HandshakeFailed);\n    }\n    if (Vec::len(&hs.buffer) != 0)\n    {\n        re"
    "turn Err(ProtocolError);\n    }\n    Vec<u8> th_fin = transcript_hash(&hs);\n    Vec<u8> derived2 = der"
    "ive_secret(kind, &handshake_secret, \"derived\", &empty_hash);\n    Vec<u8> master = hkdf_extract_with("
    "kind, &derived2, &zeros);\n    Vec<u8> c_ap = derive_secret(kind, &master, \"c ap traffic\", &th_fin);\n"
    "    Vec<u8> s_ap = derive_secret(kind, &master, \"s ap traffic\", &th_fin);\n    // The client's flight"
    ": a compatibility ChangeCipherSpec, then Finished\n    // under the client handshake keys.\n    array<"
    "u8, 6> ccs = [20, 0x03, 0x03, 0x00, 0x01, 0x01];\n    write_all(&mut tcp, &ccs)?;\n    Vec<u8> mine = "
    "finished_data(kind, &c_hs, &th_fin);\n    Vec<u8> cfin = Vec::new();\n    Vec::push(&mut cfin, 20);\n  "
    "  push_u24(&mut cfin, Vec::len(&mine));\n    Vec::extend_from(&mut cfin, &mine);\n    RecordKeys clien"
    "t_hs = keys_from(&c_hs, suite);\n    Vec<u8> out = seal_record(&mut client_hs, 22, &cfin);\n    write_"
    "all(&mut tcp, &out)?;\n    Ok(TlsStream {\n        .tcp = tcp,\n        .send = keys_from(&c_ap, suite)"
    ",\n        .recv = keys_from(&s_ap, suite),\n        .pending = Vec::new(),\n        .pending_at = 0,\n "
    "       .closed = false,\n        .peer = Some(leaf),\n    })\n}export fn TlsStream::connect(\n    Socket"
    "Addr addr,\n    StringView server_name,\n    ref<TrustStore, shared> roots,\n) : Result<TlsStream, TlsE"
    "rror>\n{\n    match (TcpStream::connect(addr))\n    {\n        Ok(tcp) : TlsStream::client(tcp, server_n"
    "ame, roots),\n        Err(e)  : Err(TlsNetFailure(e)),\n    }\n}export fn TlsStream::write(ref<TlsStrea"
    "m, exclusive> s, slice<u8, shared> data) : Result<void, TlsError>\n{\n    usize at = 0;\n    usize n = "
    "slice_len(data);\n    while (at < n)\n    {\n        usize take = min(n - at, 16384);\n        Vec<u8> r"
    "ec = seal_record(&mut s.send, 23, &data[at..at + take]);\n        write_all(&mut s.tcp, &rec)?;\n     "
    "   at += take;\n    }\n    Ok(())\n}export fn TlsStream::write_text(ref<TlsStream, exclusive> s, String"
    "View text) : Result<void, TlsError>\n{\n    TlsStream::write(s, text.bytes)\n}fn TlsStream::fill(ref<Tl"
    "sStream, exclusive> s) : Result<void, TlsError>\n{\n    while (s.pending_at >= Vec::len(&s.pending) &&"
    " !s.closed)\n    {\n        Record r = read_record(&mut s.tcp)?;\n        if (r.kind == 20)\n        {\n "
    "           continue;\n        }\n        Inner { kind, content } = open_record(&mut s.recv, &r)?;\n    "
    "    if (kind == 23)\n        {\n            overwrite(&mut s.pending, content);\n            s.pending_"
    "at = 0;\n        }\n        else if (kind == 21)\n        {\n            if (Vec::len(&content) == 2 && "
    "content[1] == 0)\n            {\n                s.closed = true;\n            }\n            else\n     "
    "       {\n                return Err(PeerAlert(if (Vec::len(&content) == 2) { content[1] } else { 0 }"
    "));\n            }\n        }\n        else if (kind == 22)\n        {\n            usize at = 0;\n       "
    "     while (at + 4 <= Vec::len(&content))\n            {\n                u8 t = content[at];\n        "
    "        usize len = widen<usize>(content[at + 1]) << 16 | widen<usize>(content[at + 2]) << 8 | widen"
    "<usize>(content[at + 3]);\n                if (at + 4 + len > Vec::len(&content))\n                {\n "
    "                   return Err(ProtocolError);\n                }\n                if (t == 24)\n       "
    "         {\n                    if (len != 1)\n                    {\n                        return Er"
    "r(ProtocolError);\n                    }\n                    Vec<u8> none = Vec::new();\n             "
    "       HashKind kind = suite_hash(s.recv.suite);\n                    Vec<u8> next = hkdf_expand_labe"
    "l_with(\n                        kind,\n                        &s.recv.secret,\n                      "
    "  \"traffic upd\",\n                        &none,\n                        Vec::len(&s.recv.secret),\n  "
    "                  );\n                    overwrite(&mut s.recv, keys_from(&next, s.recv.suite));\n   "
    "                 if (content[at + 4] == 1)\n                    {\n                        array<u8, 5"
    "> reply = [24, 0, 0, 1, 0];\n                        Vec<u8> rec = seal_record(&mut s.send, 22, &repl"
    "y);\n                        write_all(&mut s.tcp, &rec)?;\n                        Vec<u8> mine = hkd"
    "f_expand_label_with(\n                            kind,\n                            &s.send.secret,\n "
    "                           \"traffic upd\",\n                            &none,\n                       "
    "     Vec::len(&s.send.secret),\n                        );\n                        overwrite(&mut s.s"
    "end, keys_from(&mine, s.send.suite));\n                    }\n                }\n                else i"
    "f (t != 4)\n                {\n                    return Err(ProtocolError);\n                }\n      "
    "          at = at + 4 + len;\n            }\n        }\n        else\n        {\n            return Err(P"
    "rotocolError);\n        }\n    }\n    Ok(())\n}export fn TlsStream::read(ref<TlsStream, exclusive> s, re"
    "f<Vec<u8>, exclusive> buf, usize max) : Result<usize, TlsError>\n{\n    if (max == 0)\n    {\n        re"
    "turn Ok(0);\n    }\n    TlsStream::fill(s)?;\n    usize have = Vec::len(&s.pending) - s.pending_at;\n   "
    " usize take = min(have, max);\n    Vec::extend_from(buf, &s.pending[s.pending_at..s.pending_at + take"
    "]);\n    s.pending_at += take;\n    Ok(take)\n}export fn TlsStream::read_exact(\n    ref<TlsStream, excl"
    "usive> s,\n    ref<Vec<u8>, exclusive> buf,\n    usize n,\n) : Result<void, TlsError>\n{\n    usize got ="
    " 0;\n    while (got < n)\n    {\n        usize k = TlsStream::read(s, buf, n - got)?;\n        if (k == "
    "0)\n        {\n            return Err(TlsNetFailure(Closed));\n        }\n        got += k;\n    }\n    Ok"
    "(())\n}export fn TlsStream::read_line(ref<TlsStream, exclusive> s) : Result<Option<String>, TlsError>"
    "\n{\n    Vec<u8> line = Vec::new();\n    while (true)\n    {\n        TlsStream::fill(s)?;\n        usize "
    "n = Vec::len(&s.pending);\n        if (s.pending_at >= n)\n        {\n            if (Vec::len(&line) ="
    "= 0)\n            {\n                return Ok(None);\n            }\n            break;\n        }\n     "
    "   usize i = s.pending_at;\n        while (i < n && s.pending[i] != 10)\n        {\n            i += 1;"
    "\n        }\n        if (i < n)\n        {\n            Vec::extend_from(&mut line, &s.pending[s.pending"
    "_at..i]);\n            s.pending_at = i + 1;\n            break;\n        }\n        Vec::extend_from(&m"
    "ut line, &s.pending[s.pending_at..n]);\n        s.pending_at = n;\n    }\n    usize k = Vec::len(&line)"
    ";\n    if (k > 0 && line[k - 1] == 13)\n    {\n        Vec::pop(&mut line);\n    }\n    match (String::fr"
    "om_utf8(line))\n    {\n        Ok(t)  : Ok(Some(t)),\n        Err(e) : Err(TlsNetFailure(NotUtf8(e))),\n"
    "    }\n}export fn TlsStream::close(ref<TlsStream, exclusive> s) : Result<void, TlsError>\n{\n    array<"
    "u8, 2> alert = [1, 0];\n    Vec<u8> rec = seal_record(&mut s.send, 21, &alert);\n    write_all(&mut s."
    "tcp, &rec)\n}fn u16_list(slice<u8, shared> b, usize start, usize end, ref<Vec<u16>, exclusive> out) :"
    " bool\n{\n    if ((end - start) % 2 != 0)\n    {\n        return false;\n    }\n    usize at = start;\n    "
    "while (at < end)\n    {\n        Vec::push(out, read_be<u16>(b, at));\n        at += 2;\n    }\n    true\n"
    "}fn client_hello_parse(slice<u8, shared> m) : Result<ClientHello, TlsError>\n{\n    usize n = slice_le"
    "n(m);\n    if (n < 4 + 2 + 32 + 1 || m[0] != 1)\n    {\n        return Err(ProtocolError);\n    }\n    us"
    "ize at = 38;\n    usize sid_len = widen<usize>(m[at]);\n    if (sid_len > 32 || at + 1 + sid_len + 2 >"
    " n)\n    {\n        return Err(ProtocolError);\n    }\n    Vec<u8> session = Vec::from_slice(&m[at + 1.."
    "at + 1 + sid_len]);\n    at = at + 1 + sid_len;\n    usize suites_len = widen<usize>(read_be<u16>(m, a"
    "t));\n    at += 2;\n    if (at + suites_len + 1 > n)\n    {\n        return Err(ProtocolError);\n    }\n  "
    "  Vec<u16> suites = Vec::new();\n    if (!u16_list(m, at, at + suites_len, &mut suites))\n    {\n      "
    "  return Err(ProtocolError);\n    }\n    at += suites_len;\n    usize comp_len = widen<usize>(m[at]);\n "
    "   at += 1 + comp_len;\n    ClientHello ch = ClientHello {\n        .session = session,\n        .suite"
    "s = suites,\n        .groups = Vec::new(),\n        .schemes = Vec::new(),\n        .share_groups = Vec"
    "::new(),\n        .shares = Vec::new(),\n        .tls13 = false,\n        .has_cookie = false,\n    };\n "
    "   if (at == n)\n    {\n        return Ok(ch);\n    }\n    if (at + 2 > n)\n    {\n        return Err(Prot"
    "ocolError);\n    }\n    usize ext_end = at + 2 + widen<usize>(read_be<u16>(m, at));\n    if (ext_end !="
    " n)\n    {\n        return Err(ProtocolError);\n    }\n    at += 2;\n    while (at + 4 <= ext_end)\n    {\n"
    "        u16 kind = read_be<u16>(m, at);\n        usize len = widen<usize>(read_be<u16>(m, at + 2));\n "
    "       usize start = at + 4;\n        if (start + len > ext_end)\n        {\n            return Err(Pro"
    "tocolError);\n        }\n        if (kind == 0x002b)\n        {\n            // supported_versions: a 1-"
    "byte length and the versions.\n            if (len < 1 || widen<usize>(m[start]) + 1 != len)\n        "
    "    {\n                return Err(ProtocolError);\n            }\n            Vec<u16> versions = Vec::"
    "new();\n            if (!u16_list(m, start + 1, start + len, &mut versions))\n            {\n          "
    "      return Err(ProtocolError);\n            }\n            foreach (v in &versions)\n            {\n  "
    "              if (*v == 0x0304)\n                {\n                    ch.tls13 = true;\n             "
    "   }\n            }\n        }\n        else if (kind == 0x000a || kind == 0x000d)\n        {\n          "
    "  if (len < 2 || widen<usize>(read_be<u16>(m, start)) + 2 != len)\n            {\n                retu"
    "rn Err(ProtocolError);\n            }\n            Vec<u16> list = Vec::new();\n            if (!u16_li"
    "st(m, start + 2, start + len, &mut list))\n            {\n                return Err(ProtocolError);\n "
    "           }\n            if (kind == 0x000a)\n            {\n                overwrite(&mut ch.groups,"
    " list);\n            }\n            else\n            {\n                overwrite(&mut ch.schemes, list"
    ");\n            }\n        }\n        else if (kind == 0x0033)\n        {\n            if (len < 2 || wid"
    "en<usize>(read_be<u16>(m, start)) + 2 != len)\n            {\n                return Err(ProtocolError"
    ");\n            }\n            usize p = start + 2;\n            while (p + 4 <= start + len)\n         "
    "   {\n                u16 g = read_be<u16>(m, p);\n                usize klen = widen<usize>(read_be<u"
    "16>(m, p + 2));\n                if (p + 4 + klen > start + len)\n                {\n                  "
    "  return Err(ProtocolError);\n                }\n                Vec::push(&mut ch.share_groups, g);\n "
    "               Vec::push(&mut ch.shares, Vec::from_slice(&m[p + 4..p + 4 + klen]));\n                "
    "p += 4 + klen;\n            }\n            if (p != start + len)\n            {\n                return "
    "Err(ProtocolError);\n            }\n        }\n        else if (kind == 0x002c)\n        {\n            c"
    "h.has_cookie = true;\n        }\n        at = start + len;\n    }\n    if (at != ext_end)\n    {\n        "
    "return Err(ProtocolError);\n    }\n    Ok(ch)\n}fn send_plain_alert(ref<TcpStream, exclusive> tcp, u8 c"
    "ode)\n{\n    array<u8, 7> rec = [21, 0x03, 0x03, 0, 2, 2, code];\n    _ = TcpStream::write(tcp, &rec);\n"
    "}fn server_hello_bytes(\n    slice<u8, shared> random,\n    slice<u8, shared> session,\n    u16 suite,\n"
    "    u16 group,\n    slice<u8, shared> share,\n    bool retry,\n) : Vec<u8>\n{\n    Vec<u8> ext = Vec::new"
    "();\n    array<u8, 2> v13 = [0x03, 0x04];\n    push_extension(&mut ext, 0x002b, &v13);\n    Vec<u8> ks "
    "= Vec::new();\n    Vec::push_be(&mut ks, group);\n    if (!retry)\n    {\n        Vec::push_be(&mut ks, "
    "narrow<u16>(slice_len(share)));\n        Vec::extend_from(&mut ks, share);\n    }\n    push_extension(&"
    "mut ext, 0x0033, &ks);\n    Vec<u8> body = Vec::new();\n    Vec::push_be(&mut body, 0x0303: u16);\n    "
    "Vec::extend_from(&mut body, random);\n    Vec::push(&mut body, narrow<u8>(slice_len(session)));\n    V"
    "ec::extend_from(&mut body, session);\n    Vec::push_be(&mut body, suite);\n    Vec::push(&mut body, 0)"
    ";\n    Vec::push_be(&mut body, narrow<u16>(Vec::len(&ext)));\n    Vec::extend_from(&mut body, &ext);\n "
    "   Vec<u8> msg = Vec::new();\n    Vec::push(&mut msg, 2);\n    push_u24(&mut msg, Vec::len(&body));\n  "
    "  Vec::extend_from(&mut msg, &body);\n    msg\n}fn send_handshake(\n    ref<TcpStream, exclusive> tcp,\n"
    "    ref<RecordKeys, exclusive> keys,\n    ref<Handshake, exclusive> hs,\n    slice<u8, shared> msg,\n) "
    ": Result<void, TlsError>\n{\n    transcript_add(hs, msg);\n    usize at = 0;\n    while (at < slice_len("
    "msg))\n    {\n        usize take = min(slice_len(msg) - at, 16384);\n        Vec<u8> rec = seal_record("
    "keys, 22, &msg[at..at + take]);\n        write_all(tcp, &rec)?;\n        at += take;\n    }\n    Ok(())\n"
    "}fn server_scheme(ref<PrivateKey, shared> key, ref<Vec<u16>, shared> offered) : Option<u16>\n{\n    u1"
    "6 want = match (key)\n    {\n        RsaPrivate(_)     : 0x0804,\n        EcPrivate(k)      : if (k.cur"
    "ve == P256) { 0x0403 } else { 0x0503 },\n        Ed25519Private(_) : 0x0807,\n    };\n    foreach (s in"
    " offered)\n    {\n        if (*s == want)\n        {\n            return Some(want);\n        }\n    }\n   "
    " None\n}fn scheme_of(u16 code) : SignatureScheme\n{\n    if (code == 0x0403) { Ecdsa(Sha2_256) }\n    el"
    "se if (code == 0x0503) { Ecdsa(Sha2_384) }\n    else if (code == 0x0807) { Ed25519 }\n    else { RsaPs"
    "s(Sha2_256) }\n}export fn TlsStream::server(\n    TcpStream tcp,\n    ref<PrivateKey, shared> key,\n    "
    "slice<Certificate, shared> chain,\n) : Result<TlsStream, TlsError>\n{\n    if (slice_len(chain) == 0)\n "
    "   {\n        return Err(HandshakeFailed);\n    }\n    Handshake hs = Handshake { .buffer = Vec::new(),"
    " .t256 = Hasher::new(Sha2_256), .t384 = Hasher::new(Sha2_384), .kind = Sha2_256 };\n    Option<Record"
    "Keys> plain = None;\n    Vec<u8> chm = next_message(&mut hs, &mut tcp, &mut plain)?;\n    ClientHello "
    "ch = client_hello_parse(&chm)?;\n    if (!ch.tls13)\n    {\n        send_plain_alert(&mut tcp, 70);\n   "
    "     return Err(HandshakeFailed);\n    }\n    // The suite: the client's first that this server has.\n "
    "   u16 suite = 0;\n    foreach (s in &ch.suites)\n    {\n        if (suite == 0 && (*s == 0x1303 || *s "
    "== 0x1301 || *s == 0x1302))\n        {\n            suite = *s;\n        }\n    }\n    u16 scheme_code = "
    "match (server_scheme(key, &ch.schemes))\n    {\n        Some(c) : c,\n        None    : 0,\n    };\n    i"
    "f (suite == 0 || scheme_code == 0)\n    {\n        send_plain_alert(&mut tcp, 40);\n        return Err("
    "HandshakeFailed);\n    }\n    hs.kind = suite_hash(suite);\n    HashKind kind = hs.kind;\n    // The gro"
    "up: the client's first key share for a group this server\n    // has; else a HelloRetryRequest for th"
    "e first group it supports.\n    u16 group = 0;\n    Vec<u8> client_share = Vec::new();\n    for (usize "
    "i = 0; i < Vec::len(&ch.share_groups) && group == 0; i += 1)\n    {\n        u16 g = ch.share_groups[i"
    "];\n        if (g == 0x001d || g == 0x0017 || g == 0x0018)\n        {\n            group = g;\n         "
    "   overwrite(&mut client_share, Vec::clone(&ch.shares[i]));\n        }\n    }\n    Vec<u8> session = Ve"
    "c::clone(&ch.session);\n    if (group == 0)\n    {\n        u16 ask = 0;\n        foreach (g in &ch.grou"
    "ps)\n        {\n            if (ask == 0 && (*g == 0x001d || *g == 0x0017 || *g == 0x0018))\n          "
    "  {\n                ask = *g;\n            }\n        }\n        if (ask == 0 || ch.has_cookie)\n       "
    " {\n            send_plain_alert(&mut tcp, 40);\n            return Err(HandshakeFailed);\n        }\n  "
    "      // RFC 8446 §4.1.4: the transcript restarts from\n        // message_hash(ClientHello1) ‖ He"
    "lloRetryRequest.\n        Vec<u8> ch_hash = hash(kind, &chm);\n        array<u8, 4> head = [254, 0, 0,"
    " narrow<u8>(Vec::len(&ch_hash))];\n        Handshake restarted = Handshake { .buffer = Vec::new(), .t"
    "256 = Hasher::new(Sha2_256), .t384 = Hasher::new(Sha2_384), .kind = kind };\n        transcript_add(&"
    "mut restarted, &head);\n        transcript_add(&mut restarted, &ch_hash);\n        Vec<u8> hrr_random "
    "= Result::unwrap_or(\n            from_hex(\"cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c"
    "8a8339c\"),\n            Vec::new(),\n        );\n        Vec<u8> none = Vec::new();\n        Vec<u8> hrr"
    " = server_hello_bytes(&hrr_random, &session, suite, ask, &none, true);\n        transcript_add(&mut r"
    "estarted, &hrr);\n        overwrite(&mut hs, restarted);\n        write_all(&mut tcp, &handshake_recor"
    "d(&hrr, 0x0303))?;\n        Vec<u8> chm2 = next_message(&mut hs, &mut tcp, &mut plain)?;\n        Clie"
    "ntHello ch2 = client_hello_parse(&chm2)?;\n        bool suite_ok = false;\n        foreach (s in &ch2."
    "suites)\n        {\n            if (*s == suite)\n            {\n                suite_ok = true;\n      "
    "      }\n        }\n        for (usize i = 0; i < Vec::len(&ch2.share_groups) && group == 0; i += 1)\n "
    "       {\n            if (ch2.share_groups[i] == ask)\n            {\n                group = ask;\n    "
    "            overwrite(&mut client_share, Vec::clone(&ch2.shares[i]));\n            }\n        }\n      "
    "  if (group == 0 || !suite_ok || !ch2.tls13 || !same_session(&ch2.session, &session))\n        {\n    "
    "        send_plain_alert(&mut tcp, 47);\n            return Err(HandshakeFailed);\n        }\n    }\n   "
    " // This server's share and the shared secret.\n    Vec<u8> public_key = Vec::new();\n    Vec<u8> shar"
    "ed = Vec::new();\n    if (group == 0x001d)\n    {\n        array<u8, 32> private_key = x25519_private_k"
    "ey();\n        Vec::extend_from(&mut public_key, &x25519_public_key(&private_key));\n        match (x2"
    "5519(&private_key, &client_share))\n        {\n            Some(z) : Vec::extend_from(&mut shared, &z)"
    ",\n            None    :\n            {\n                send_plain_alert(&mut tcp, 47);\n              "
    "  return Err(HandshakeFailed);\n            },\n        }\n    }\n    else\n    {\n        EcCurve curve ="
    " if (group == 0x0017) { P256 } else { P384 };\n        Vec<u8> ec_key = ec_private_key(curve);\n      "
    "  overwrite(&mut public_key, Option::unwrap(ec_public_key(curve, &ec_key)));\n        match (ecdh(cur"
    "ve, &ec_key, &client_share))\n        {\n            Some(z) : overwrite(&mut shared, z),\n            "
    "None    :\n            {\n                send_plain_alert(&mut tcp, 47);\n                return Err(H"
    "andshakeFailed);\n            },\n        }\n    }\n    array<u8, 32> random = [0; 32];\n    os_random_by"
    "tes(&mut random);\n    Vec<u8> sh = server_hello_bytes(&random, &session, suite, group, &public_key, "
    "false);\n    transcript_add(&mut hs, &sh);\n    write_all(&mut tcp, &handshake_record(&sh, 0x0303))?;\n"
    "    array<u8, 6> ccs = [20, 0x03, 0x03, 0x00, 0x01, 0x01];\n    write_all(&mut tcp, &ccs)?;\n    // Th"
    "e key schedule (RFC 8446 §7.1).\n    Vec<u8> none = Vec::new();\n    Vec<u8> empty_hash = hash(kind, "
    "&none);\n    Vec<u8> zeros = Vec::filled(Vec::len(&empty_hash), 0: u8);\n    Vec<u8> early = hkdf_extr"
    "act_with(kind, &none, &zeros);\n    Vec<u8> derived = derive_secret(kind, &early, \"derived\", &empty_h"
    "ash);\n    Vec<u8> handshake_secret = hkdf_extract_with(kind, &derived, &shared);\n    Vec<u8> th = tr"
    "anscript_hash(&hs);\n    Vec<u8> c_hs = derive_secret(kind, &handshake_secret, \"c hs traffic\", &th);\n"
    "    Vec<u8> s_hs = derive_secret(kind, &handshake_secret, \"s hs traffic\", &th);\n    RecordKeys serve"
    "r_hs = keys_from(&s_hs, suite);\n    // EncryptedExtensions (none), Certificate, CertificateVerify, F"
    "inished.\n    array<u8, 6> ee = [8, 0, 0, 2, 0, 0];\n    send_handshake(&mut tcp, &mut server_hs, &mut"
    " hs, &ee)?;\n    Vec<u8> list = Vec::new();\n    foreach (c in chain)\n    {\n        push_u24(&mut list"
    ", Vec::len(&c.der));\n        Vec::extend_from(&mut list, &c.der);\n        Vec::push_be(&mut list, 0:"
    " u16);\n    }\n    Vec<u8> cert = Vec::new();\n    Vec::push(&mut cert, 11);\n    push_u24(&mut cert, 4 "
    "+ Vec::len(&list));\n    Vec::push(&mut cert, 0);\n    push_u24(&mut cert, Vec::len(&list));\n    Vec::"
    "extend_from(&mut cert, &list);\n    send_handshake(&mut tcp, &mut server_hs, &mut hs, &cert)?;\n    Ve"
    "c<u8> th_cert = transcript_hash(&hs);\n    Vec<u8> content = Vec::filled(64, 0x20: u8);\n    Vec::exte"
    "nd_from(&mut content, b\"TLS 1.3, server CertificateVerify\");\n    Vec::push(&mut content, 0);\n    Vec"
    "::extend_from(&mut content, &th_cert);\n    SignatureScheme scheme = scheme_of(scheme_code);\n    Vec<"
    "u8> signature = match (sign(key, &scheme, &content))\n    {\n        Some(s) : s,\n        None    : re"
    "turn Err(HandshakeFailed),\n    };\n    Vec<u8> cv = Vec::new();\n    Vec::push(&mut cv, 15);\n    push_"
    "u24(&mut cv, 4 + Vec::len(&signature));\n    Vec::push_be(&mut cv, scheme_code);\n    Vec::push_be(&mu"
    "t cv, narrow<u16>(Vec::len(&signature)));\n    Vec::extend_from(&mut cv, &signature);\n    send_handsh"
    "ake(&mut tcp, &mut server_hs, &mut hs, &cv)?;\n    Vec<u8> th_cv = transcript_hash(&hs);\n    Vec<u8> "
    "fin_data = finished_data(kind, &s_hs, &th_cv);\n    Vec<u8> fin = Vec::new();\n    Vec::push(&mut fin,"
    " 20);\n    push_u24(&mut fin, Vec::len(&fin_data));\n    Vec::extend_from(&mut fin, &fin_data);\n    se"
    "nd_handshake(&mut tcp, &mut server_hs, &mut hs, &fin)?;\n    Vec<u8> th_fin = transcript_hash(&hs);\n "
    "   Vec<u8> derived2 = derive_secret(kind, &handshake_secret, \"derived\", &empty_hash);\n    Vec<u8> ma"
    "ster = hkdf_extract_with(kind, &derived2, &zeros);\n    Vec<u8> c_ap = derive_secret(kind, &master, \""
    "c ap traffic\", &th_fin);\n    Vec<u8> s_ap = derive_secret(kind, &master, \"s ap traffic\", &th_fin);\n "
    "   // The client's Finished, under its handshake keys.\n    Option<RecordKeys> client_hs = Some(keys_"
    "from(&c_hs, suite));\n    Vec<u8> cfin = next_message(&mut hs, &mut tcp, &mut client_hs)?;\n    Vec<u8"
    "> want = finished_data(kind, &c_hs, &th_fin);\n    if (Vec::len(&cfin) != 4 + Vec::len(&want) || cfin"
    "[0] != 20 || !digest_eq(&cfin[4..$], &want))\n    {\n        return Err(HandshakeFailed);\n    }\n    if"
    " (Vec::len(&hs.buffer) != 0)\n    {\n        return Err(ProtocolError);\n    }\n    Ok(TlsStream {\n     "
    "   .tcp = tcp,\n        .send = keys_from(&s_ap, suite),\n        .recv = keys_from(&c_ap, suite),\n   "
    "     .pending = Vec::new(),\n        .pending_at = 0,\n        .closed = false,\n        .peer = None,\n"
    "    })\n}fn same_session(ref<Vec<u8>, shared> a, ref<Vec<u8>, shared> b) : bool\n{\n    Vec::len(a) == "
    "Vec::len(b) && digest_eq(a, b)\n}export fn HttpError::text(ref<HttpError, shared> e) : str\n{\n    matc"
    "h (e)\n    {\n        HttpNetFailure(n) : NetError::text(n),\n        HttpTlsFailure(t) : TlsError::tex"
    "t(t),\n        BadUrl            : \"the URL is malformed\",\n        UnsupportedScheme : \"the URL's sch"
    "eme is neither http nor https\",\n        NoRoots           : \"no trusted roots for https (TrustStore:"
    ":system failed)\",\n        BadMessage        : \"the HTTP message is malformed\",\n        TooLarge     "
    "     : \"the HTTP message is larger than the limit\",\n        TooManyRedirects  : \"too many redirects\""
    ",\n        ConnectionClosed  : \"the connection was closed\",\n    }\n}fn default_port(StringView scheme)"
    " : u16\n{\n    if (scheme == \"https\") { 443 } else { 80 }\n}export fn Url::parse(StringView text) : Res"
    "ult<Url, HttpError>\n{\n    usize sep = match (StringView::find(text, \"://\"))\n    {\n        Some(i) : "
    "i,\n        None    : return Err(BadUrl),\n    };\n    String scheme = StringView::to_ascii_lower(&Stri"
    "ng::copy(&text[0..sep]));\n    StringView rest = &text[sep + 3..$];\n    usize n = StringView::len(res"
    "t);\n    slice<u8, shared> b = StringView::as_bytes(rest);\n    usize auth_end = 0;\n    while (auth_en"
    "d < n && b[auth_end] != b'/' && b[auth_end] != b'?' && b[auth_end] != b'#')\n    {\n        auth_end +"
    "= 1;\n    }\n    StringView authority = &rest[0..auth_end];\n    if (auth_end == 0 || Option::is_some(&"
    "StringView::find(authority, \"@\")))\n    {\n        return Err(BadUrl);\n    }\n    slice<u8, shared> ab "
    "= StringView::as_bytes(authority);\n    usize host_end = auth_end;\n    if (ab[0] == b'[')\n    {\n     "
    "   host_end = match (StringView::find(authority, \"]\"))\n        {\n            Some(i) : i + 1,\n      "
    "      None    : return Err(BadUrl),\n        };\n    }\n    else\n    {\n        host_end = 0;\n        wh"
    "ile (host_end < auth_end && ab[host_end] != b':')\n        {\n            host_end += 1;\n        }\n   "
    " }\n    String host = StringView::to_ascii_lower(&String::copy(&authority[0..host_end]));\n    u16 por"
    "t = default_port(&scheme);\n    if (host_end < auth_end)\n    {\n        if (ab[host_end] != b':')\n    "
    "    {\n            return Err(BadUrl);\n        }\n        port = match (StringView::parse<u16>(&author"
    "ity[host_end + 1..auth_end]))\n        {\n            Ok(p)  : p,\n            Err(_) : return Err(BadU"
    "rl),\n        };\n    }\n    usize path_end = auth_end;\n    while (path_end < n && b[path_end] != b'?' "
    "&& b[path_end] != b'#')\n    {\n        path_end += 1;\n    }\n    String path = if (path_end == auth_en"
    "d) { \"/\" } else\n    {\n        String::copy(&rest[auth_end..path_end])\n    };\n    String query = Stri"
    "ng::new();\n    if (path_end < n && b[path_end] == b'?')\n    {\n        usize q_end = path_end + 1;\n  "
    "      while (q_end < n && b[q_end] != b'#')\n        {\n            q_end += 1;\n        }\n        Stri"
    "ng::append(&mut query, &rest[path_end + 1..q_end]);\n    }\n    Ok(Url { .scheme = scheme, .host = hos"
    "t, .port = port, .path = path, .query = query })\n}unittest \"Url::parse: defaults and normalisation\"\n"
    "{\n    Url u = Result::unwrap(Url::parse(\"HTTPS://Example.com/a/b?x=1#top\"));\n    assert(u.scheme == "
    "\"https\" && u.host == \"example.com\" && u.port == 443);\n    assert(u.path == \"/a/b\" && u.query == \"x=1"
    "\");\n    assert(Url::target(&u) == \"/a/b?x=1\");\n    Url v = Result::unwrap(Url::parse(\"http://[::1]:8"
    "080\"));\n    assert(v.host == \"[::1]\" && v.path == \"/\");\n    assert(Url::text(&v) == \"http://[::1]:80"
    "80/\");\n    assert(Result::is_err(&Url::parse(\"http://user@example.com/\")));\n}export fn Url::target(r"
    "ef<Url, shared> u) : String\n{\n    String t = String::clone(&u.path);\n    if (StringView::len(&u.quer"
    "y) > 0)\n    {\n        String::append(&mut t, \"?\");\n        String::append(&mut t, &u.query);\n    }\n "
    "   t\n}fn host_text(ref<Url, shared> u) : String\n{\n    String h = String::clone(&u.host);\n    if (u.p"
    "ort != default_port(&u.scheme))\n    {\n        String::append(&mut h, \":\");\n        String::append(&m"
    "ut h, u.port);\n    }\n    h\n}export fn Url::text(ref<Url, shared> u) : String\n{\n    String t = String"
    "::clone(&u.scheme);\n    String::append(&mut t, \"://\");\n    String::append(&mut t, &host_text(u));\n  "
    "  String::append(&mut t, &Url::target(u));\n    t\n}fn is_unreserved(u8 b) : bool\n{\n    ascii_is_alnum"
    "(b) || b == b'-' || b == b'.' || b == b'_' || b == b'~'\n}export fn percent_encode(slice<u8, shared> "
    "bytes) : String\n{\n    String out = String::new();\n    str digits = \"0123456789ABCDEF\";\n    foreach ("
    "c in bytes)\n    {\n        if (is_unreserved(*c))\n        {\n            String::push_ascii(&mut out, "
    "*c);\n        }\n        else\n        {\n            String::push_ascii(&mut out, b'%');\n            St"
    "ring::push_ascii(&mut out, str_byte(digits, widen<usize>(*c >> 4)));\n            String::push_ascii("
    "&mut out, str_byte(digits, widen<usize>(*c & 15)));\n        }\n    }\n    out\n}fn hex_digit(u8 c) : Op"
    "tion<u8>\n{\n    if (c >= b'0' && c <= b'9') { Some(c - b'0') }\n    else if (c >= b'a' && c <= b'f') {"
    " Some(c - b'a' + 10) }\n    else if (c >= b'A' && c <= b'F') { Some(c - b'A' + 10) }\n    else { None "
    "}\n}export fn percent_decode(StringView text) : Option<Vec<u8>>\n{\n    slice<u8, shared> b = StringVie"
    "w::as_bytes(text);\n    Vec<u8> out = Vec::new();\n    usize i = 0;\n    while (i < slice_len(b))\n    {"
    "\n        if (b[i] == b'%')\n        {\n            if (i + 3 > slice_len(b))\n            {\n           "
    "     return None;\n            }\n            u8 hi = hex_digit(b[i + 1])?;\n            u8 lo = hex_di"
    "git(b[i + 2])?;\n            Vec::push(&mut out, hi * 16 + lo);\n            i += 3;\n        }\n       "
    " else\n        {\n            Vec::push(&mut out, b[i]);\n            i += 1;\n        }\n    }\n    Some("
    "out)\n}unittest \"percent_decode: the reverse of percent_encode\"\n{\n    assert(percent_encode(StringVie"
    "w::as_bytes(\"a b/ü\")) == \"a%20b%2F%C3%BC\");\n    Vec<u8> back = Option::unwrap(percent_decode(\"a%20b"
    "%2f\"));\n    assert(Result::unwrap(String::from_utf8(back)) == \"a b/\");\n    assert(Option::is_none(&p"
    "ercent_decode(\"100%\")));\n}export fn Param::new(StringView name, StringView value) : Param\n{\n    Para"
    "m { .name = String::copy(name), .value = String::copy(value) }\n}export fn find_param(slice<Param, sh"
    "ared> params, StringView name) : Option<StringView> from params\n{\n    for (usize i = 0; i < slice_le"
    "n(params); i += 1)\n    {\n        if (params[i].name == name)\n        {\n            return Some(&para"
    "ms[i].value);\n        }\n    }\n    None\n}export fn form_decode(StringView text) : Vec<Param>\n{\n    Ve"
    "c<Param> out = Vec::new();\n    foreach (pair in StringView::split(text, \"&\"))\n    {\n        foreach "
    "(p in StringView::split(pair, \";\"))\n        {\n            if (StringView::len(p) == 0)\n            {"
    "\n                continue;\n            }\n            StringView name = p;\n            StringView val"
    "ue = \"\";\n            if (Some(eq) = StringView::find(p, \"=\"))\n            {\n                name = &"
    "p[0..eq];\n                value = &p[eq + 1..$];\n            }\n            Vec::push(&mut out, Param"
    " { .name = form_part(name), .value = form_part(value) });\n        }\n    }\n    out\n}unittest \"form_de"
    "code: pairs, bare names and bad escapes\"\n{\n    Vec<Param> ps = form_decode(\"q=red+fish&flag&&n=%41;x"
    "=%zz\");\n    assert(Vec::len(&ps) == 4);\n    assert(Option::unwrap(find_param(&ps, \"q\")) == \"red fish"
    "\");\n    assert(Option::unwrap(find_param(&ps, \"flag\")) == \"\");\n    assert(Option::unwrap(find_param("
    "&ps, \"n\")) == \"A\");\n    assert(Option::unwrap(find_param(&ps, \"x\")) == \"%zz\");\n    assert(Option::is"
    "_none(&find_param(&ps, \"Q\")));\n}fn form_part(StringView v) : String\n{\n    String plus = StringView::"
    "replace(v, \"+\", \" \");\n    match (percent_decode(&plus))\n    {\n        Some(b) : match (String::from_"
    "utf8(b))\n        {\n            Ok(s)  : s,\n            Err(_) : plus,\n        },\n        None : plus"
    ",\n    }\n}export fn form_encode(slice<Param, shared> params) : String\n{\n    String out = String::new("
    ");\n    for (usize i = 0; i < slice_len(params); i += 1)\n    {\n        if (i > 0)\n        {\n         "
    "   String::push_ascii(&mut out, b'&');\n        }\n        String::append(&mut out, &form_encode_part("
    "&params[i].name));\n        String::push_ascii(&mut out, b'=');\n        String::append(&mut out, &for"
    "m_encode_part(&params[i].value));\n    }\n    out\n}unittest \"form_encode: spaces and reserved bytes\"\n{"
    "\n    Vec<Param> ps = Vec::new();\n    Vec::push(&mut ps, Param::new(\"q\", \"a b&c\"));\n    Vec::push(&mu"
    "t ps, Param::new(\"lang\", \"en\"));\n    String body = form_encode(&ps);\n    assert(body == \"q=a+b%26c&l"
    "ang=en\");\n    Vec<Param> back = form_decode(&body);\n    assert(back[0].value == \"a b&c\");\n}fn form_e"
    "ncode_part(ref<String, shared> s) : String\n{\n    String enc = percent_encode(StringView::as_bytes(s)"
    ");\n    StringView::replace(&enc, \"%20\", \"+\")\n}export fn Url::query_pairs(ref<Url, shared> u) : Vec<P"
    "aram>\n{\n    form_decode(&u.query)\n}export fn Header::new(StringView name, StringView value) : Header"
    "\n{\n    Header { .name = String::copy(name), .value = String::copy(value) }\n}fn name_eq(StringView a,"
    " str b) : bool\n{\n    ascii_ieq_str(a.bytes, b)\n}fn names_eq(StringView a, StringView b) : bool\n{\n   "
    " ascii_ieq(a.bytes, b.bytes)\n}fn ascii_ieq(slice<u8, shared> a, slice<u8, shared> b) : bool\n{\n    if"
    " (slice_len(a) != slice_len(b))\n    {\n        return false;\n    }\n    for (usize i = 0; i < slice_le"
    "n(a); i += 1)\n    {\n        if (ascii_to_lower(a[i]) != ascii_to_lower(b[i]))\n        {\n            "
    "return false;\n        }\n    }\n    true\n}fn ascii_ieq_str(slice<u8, shared> a, str b) : bool\n{\n    if"
    " (slice_len(a) != str_len(b))\n    {\n        return false;\n    }\n    for (usize i = 0; i < slice_len("
    "a); i += 1)\n    {\n        if (ascii_to_lower(a[i]) != ascii_to_lower(str_byte(b, i)))\n        {\n    "
    "        return false;\n        }\n    }\n    true\n}fn has_header(slice<Header, shared> headers, StringV"
    "iew name) : bool\n{\n    for (usize i = 0; i < slice_len(headers); i += 1)\n    {\n        if (names_eq("
    "&headers[i].name, name))\n        {\n            return true;\n        }\n    }\n    false\n}export fn fin"
    "d_header(slice<Header, shared> headers, StringView name) : Option<StringView> from headers\n{\n    for"
    " (usize i = 0; i < slice_len(headers); i += 1)\n    {\n        if (names_eq(&headers[i].name, name))\n "
    "       {\n            return Some(&headers[i].value);\n        }\n    }\n    None\n}export fn Request::ne"
    "w(StringView method, StringView url) : Request\n{\n    Request { .method = String::copy(method), .url "
    "= String::copy(url), .headers = Vec::new(), .body = Vec::new() }\n}export fn Request::header(ref<Requ"
    "est, shared> r, StringView name) : Option<StringView> from r\n{\n    find_header(&r.headers, name)\n}un"
    "ittest \"Request::header: names ignore case\"\n{\n    Request r = Request::new(\"POST\", \"https://example."
    "com/upload\");\n    Vec::push(&mut r.headers, Header::new(\"Content-Type\", \"text/plain\"));\n    assert(O"
    "ption::unwrap(Request::header(&r, \"content-type\")) == \"text/plain\");\n    assert(Option::is_none(&Req"
    "uest::header(&r, \"accept\")));\n}export fn Response::header(ref<Response, shared> r, StringView name) "
    ": Option<StringView> from r\n{\n    find_header(&r.headers, name)\n}export fn Response::text(ref<Respon"
    "se, shared> r) : Result<String, Utf8Error>\n{\n    String::from_utf8(Vec::clone(&r.body))\n}export fn r"
    "eason_phrase(u16 status) : str\n{\n    match (status)\n    {\n        100 : \"Continue\",\n        101 : \"S"
    "witching Protocols\",\n        200 : \"OK\",\n        201 : \"Created\",\n        202 : \"Accepted\",\n        "
    "204 : \"No Content\",\n        206 : \"Partial Content\",\n        301 : \"Moved Permanently\",\n        302 "
    ": \"Found\",\n        303 : \"See Other\",\n        304 : \"Not Modified\",\n        307 : \"Temporary Redirec"
    "t\",\n        308 : \"Permanent Redirect\",\n        400 : \"Bad Request\",\n        401 : \"Unauthorized\",\n "
    "       403 : \"Forbidden\",\n        404 : \"Not Found\",\n        405 : \"Method Not Allowed\",\n        408"
    " : \"Request Timeout\",\n        409 : \"Conflict\",\n        411 : \"Length Required\",\n        413 : \"Cont"
    "ent Too Large\",\n        415 : \"Unsupported Media Type\",\n        429 : \"Too Many Requests\",\n        5"
    "00 : \"Internal Server Error\",\n        501 : \"Not Implemented\",\n        502 : \"Bad Gateway\",\n        "
    "503 : \"Service Unavailable\",\n        504 : \"Gateway Timeout\",\n        _   : \"\",\n    }\n}unittest \"rea"
    "son_phrase: unlisted codes\"\n{\n    assert(reason_phrase(404) == \"Not Found\");\n    assert(reason_phras"
    "e(299) == \"\");\n}fn conn_read(ref<Conn, exclusive> c, ref<Vec<u8>, exclusive> buf, usize max) : Resul"
    "t<usize, HttpError>\n{\n    match (c)\n    {\n        Plain(s) : match (TcpStream::read(s, buf, max))\n  "
    "      {\n            Ok(n)  : Ok(n),\n            Err(e) : Err(HttpNetFailure(e)),\n        },\n        "
    "Secure(s) : match (TlsStream::read(s, buf, max))\n        {\n            Ok(n)  : Ok(n),\n            E"
    "rr(e) : Err(HttpTlsFailure(e)),\n        },\n    }\n}fn conn_write(ref<Conn, exclusive> c, slice<u8, sh"
    "ared> data) : Result<void, HttpError>\n{\n    match (c)\n    {\n        Plain(s) : match (TcpStream::wri"
    "te(s, data))\n        {\n            Ok(_)  : Ok(()),\n            Err(e) : Err(HttpNetFailure(e)),\n   "
    "     },\n        Secure(s) : match (TlsStream::write(s, data))\n        {\n            Ok(_)  : Ok(()),"
    "\n            Err(e) : Err(HttpTlsFailure(e)),\n        },\n    }\n}fn conn_close(ref<Conn, exclusive> c"
    ")\n{\n    match (c)\n    {\n        Plain(s)  : { _ = TcpStream::shutdown_write(s); },\n        Secure(s)"
    " : { _ = TlsStream::close(s); },\n    }\n}fn fill_buffer(ref<Reader, exclusive> r) : Result<bool, Http"
    "Error>\n{\n    if (r.at > 0 && r.at == Vec::len(&r.buf))\n    {\n        Vec::clear(&mut r.buf);\n       "
    " r.at = 0;\n    }\n    usize n = conn_read(&mut r.conn, &mut r.buf, 16384)?;\n    Ok(n > 0)\n}fn availab"
    "le(ref<Reader, shared> r) : usize\n{\n    Vec::len(&r.buf) - r.at\n}fn http_newline_from(slice<u8, shar"
    "ed> b, usize at) : usize\n{\n    usize i = at;\n    while (i < slice_len(b) && b[i] != b'\\n')\n    {\n   "
    "     i += 1;\n    }\n    i\n}fn http_line(ref<Reader, exclusive> r, usize limit) : Result<Option<String"
    ">, HttpError>\n{\n    usize scanned = 0;\n    while (true)\n    {\n        usize i = http_newline_from(&r"
    ".buf, r.at + scanned);\n        if (i < Vec::len(&r.buf))\n        {\n            usize end = if (i > r"
    ".at && r.buf[i - 1] == b'\\r') { i - 1 } else { i };\n            Vec<u8> bytes = Vec::from_slice(&r.b"
    "uf[r.at..end]);\n            r.at = i + 1;\n            return match (String::from_utf8(bytes))\n      "
    "      {\n                Ok(s)  : Ok(Some(s)),\n                Err(_) : Err(BadMessage),\n            "
    "};\n        }\n        scanned = Vec::len(&r.buf) - r.at;\n        if (scanned > limit)\n        {\n     "
    "       return Err(TooLarge);\n        }\n        if (!fill_buffer(r)?)\n        {\n            return if"
    " (scanned == 0) { Ok(None) } else { Err(BadMessage) };\n        }\n    }\n}fn read_n(ref<Reader, exclus"
    "ive> r, ref<Vec<u8>, exclusive> out, usize n) : Result<void, HttpError>\n{\n    usize need = n;\n    wh"
    "ile (need > 0)\n    {\n        if (available(r) == 0)\n        {\n            if (!fill_buffer(r)?)\n    "
    "        {\n                return Err(ConnectionClosed);\n            }\n        }\n        usize take ="
    " min(need, available(r));\n        Vec::extend_from(out, &r.buf[r.at..r.at + take]);\n        r.at += "
    "take;\n        need -= take;\n    }\n    Ok(())\n}fn read_to_end(ref<Reader, exclusive> r, ref<Vec<u8>, "
    "exclusive> out, usize max) : Result<void, HttpError>\n{\n    while (true)\n    {\n        usize have = a"
    "vailable(r);\n        if (have > 0)\n        {\n            if (Vec::len(out) + have > max)\n           "
    " {\n                return Err(TooLarge);\n            }\n            Vec::extend_from(out, &r.buf[r.at"
    "..$]);\n            r.at = Vec::len(&r.buf);\n        }\n        if (!fill_buffer(r)?)\n        {\n      "
    "      return Ok(());\n        }\n    }\n}fn read_headers(ref<Reader, exclusive> r, usize used) : Result"
    "<Vec<Header>, HttpError>\n{\n    Vec<Header> headers = Vec::new();\n    usize total = used;\n    while ("
    "true)\n    {\n        String line = match (http_line(r, MAX_HEAD)?)\n        {\n            Some(l) : l,"
    "\n            None    : return Err(BadMessage),\n        };\n        total += StringView::len(&line) + "
    "2;\n        if (total > MAX_HEAD)\n        {\n            return Err(TooLarge);\n        }\n        if (S"
    "tringView::len(&line) == 0)\n        {\n            return Ok(headers);\n        }\n        StringView v"
    " = &line;\n        usize colon = match (StringView::find(v, \":\"))\n        {\n            Some(i) : i,\n"
    "            None    : return Err(BadMessage),\n        };\n        StringView name = &v[0..colon];\n   "
    "     if (colon == 0 || StringView::len(StringView::trim(name)) != colon)\n        {\n            retur"
    "n Err(BadMessage);\n        }\n        Vec::push(\n            &mut headers,\n            Header { .name"
    " = String::copy(name), .value = String::copy(StringView::trim(&v[colon + 1..$])) },\n        );\n    }"
    "\n}fn body_length(slice<Header, shared> headers, bool response) : Result<BodyLength, HttpError>\n{\n   "
    " Option<StringView> te = find_header(headers, \"transfer-encoding\");\n    Option<StringView> cl = find"
    "_header(headers, \"content-length\");\n    if (Some(t) = te)\n    {\n        if (Option::is_some(&cl) || "
    "!name_eq(StringView::trim(t), \"chunked\"))\n        {\n            return Err(BadMessage);\n        }\n  "
    "      return Ok(Chunked);\n    }\n    if (Some(c) = cl)\n    {\n        return match (StringView::parse<"
    "usize>(StringView::trim(c)))\n        {\n            Ok(n)  : Ok(Length(n)),\n            Err(_) : Err("
    "BadMessage),\n        };\n    }\n    Ok(if (response) { UntilClose } else { NoBody })\n}fn read_body(ref"
    "<Reader, exclusive> r, BodyLength how, usize max) : Result<Vec<u8>, HttpError>\n{\n    Vec<u8> body = "
    "Vec::new();\n    match (how)\n    {\n        NoBody     : {},\n        Length(n)  :\n        {\n          "
    "  if (n > max)\n            {\n                return Err(TooLarge);\n            }\n            read_n("
    "r, &mut body, n)?;\n        },\n        UntilClose : read_to_end(r, &mut body, max)?,\n        Chunked "
    "   :\n        {\n            while (true)\n            {\n                String line = match (http_line"
    "(r, MAX_HEAD)?)\n                {\n                    Some(l) : l,\n                    None    : ret"
    "urn Err(ConnectionClosed),\n                };\n                StringView size_text = &line;\n        "
    "        if (Some(semi) = StringView::find(size_text, \";\"))\n                {\n                    siz"
    "e_text = &size_text[0..semi];\n                }\n                usize size = 0;\n                slic"
    "e<u8, shared> sb = StringView::as_bytes(StringView::trim(size_text));\n                if (slice_len("
    "sb) == 0 || slice_len(sb) > 8)\n                {\n                    return Err(BadMessage);\n       "
    "         }\n                foreach (c in sb)\n                {\n                    size = size * 16 "
    "+ widen<usize>(Option::ok_or(hex_digit(*c), BadMessage)?);\n                }\n                if (siz"
    "e == 0)\n                {\n                    break;\n                }\n                if (Vec::len("
    "&body) + size > max)\n                {\n                    return Err(TooLarge);\n                }\n "
    "               read_n(r, &mut body, size)?;\n                match (http_line(r, 2)?)\n               "
    " {\n                    Some(end) : if (StringView::len(&end) != 0) { return Err(BadMessage); },\n    "
    "                None      : return Err(ConnectionClosed),\n                }\n            }\n          "
    "  // Trailers, up to the empty line.\n            while (true)\n            {\n                match (h"
    "ttp_line(r, MAX_HEAD)?)\n                {\n                    Some(t) : if (StringView::len(&t) == 0"
    ") { break; },\n                    None    : return Err(ConnectionClosed),\n                }\n        "
    "    }\n        },\n    }\n    Ok(body)\n}export fn HttpClient::new() : HttpClient\n{\n    Vec<Header> head"
    "ers = Vec::new();\n    Vec::push(&mut headers, Header::new(\"User-Agent\", \"CobaltC-std-http/1\"));\n    "
    "Vec::push(&mut headers, Header::new(\"Accept-Encoding\", \"gzip, deflate\"));\n    HttpClient { .roots = "
    "None, .timeout_ms = 30000, .max_redirects = 10, .max_body = 16777216, .headers = headers, .keep_aliv"
    "e = false, .idle = None }\n}unittest \"HttpClient::new: the defaults\"\n{\n    HttpClient c = HttpClient:"
    ":new();\n    assert(c.timeout_ms == 30000 && c.max_redirects == 10 && !c.keep_alive);\n    assert(Opti"
    "on::is_none(&c.roots));\n    assert(Option::is_some(&find_header(&c.headers, \"user-agent\")));\n    c.m"
    "ax_body = 1_048_576;\n}fn method_has_body(StringView m) : bool\n{\n    (m == \"POST\") || (m == \"PUT\") ||"
    " (m == \"PATCH\")\n}fn open_connection(ref<HttpClient, exclusive> c, ref<Url, shared> u) : Result<Conn,"
    " HttpError>\n{\n    bool secure = (u.scheme == \"https\");\n    if (!secure && u.scheme != \"http\")\n    {\n"
    "        return Err(UnsupportedScheme);\n    }\n    if (secure && Option::is_none(&c.roots))\n    {\n    "
    "    match (TrustStore::system())\n        {\n            Ok(t)  : overwrite(&mut c.roots, Some(t)),\n  "
    "          Err(_) : return Err(NoRoots),\n        }\n    }\n    // A bracketed IPv6 host loses its brack"
    "ets for resolution.\n    String host = String::clone(&u.host);\n    if (StringView::starts_with(&host,"
    " \"[\") && StringView::ends_with(&host, \"]\"))\n    {\n        overwrite(&mut host, String::copy(&u.host["
    "1..StringView::len(&u.host) - 1]));\n    }\n    Vec<SocketAddr> addrs = match (IpAddr::parse(&host))\n "
    "   {\n        Ok(ip) :\n        {\n            Vec<SocketAddr> one = Vec::new();\n            Vec::push("
    "&mut one, SocketAddr::new(ip, u.port));\n            one\n        },\n        Err(_) : match (resolve(&"
    "host, u.port))\n        {\n            Ok(a)  : a,\n            Err(e) : return Err(HttpNetFailure(e)),"
    "\n        },\n    };\n    if (Vec::len(&addrs) == 0)\n    {\n        return Err(HttpNetFailure(UnknownHos"
    "t));\n    }\n    NetError last = Failed;\n    for (usize i = 0; i < Vec::len(&addrs); i += 1)\n    {\n   "
    "     TcpStream tcp = match (TcpStream::connect_timeout(addrs[i], c.timeout_ms))\n        {\n          "
    "  Ok(t)  : t,\n            Err(e) :\n            {\n                last = e;\n                continue;"
    "\n            },\n        };\n        TcpStream::set_read_timeout_ms(&mut tcp, c.timeout_ms);\n        T"
    "cpStream::set_write_timeout_ms(&mut tcp, c.timeout_ms);\n        TcpStream::set_nodelay(&mut tcp, tru"
    "e);\n        if (!secure)\n        {\n            return Ok(Plain(tcp));\n        }\n        ref<TrustSto"
    "re, shared> roots = match (&c.roots)\n        {\n            Some(r) : r,\n            None    : return"
    " Err(NoRoots),\n        };\n        return match (TlsStream::client(tcp, &host, roots))\n        {\n    "
    "        Ok(s)  : Ok(Secure(s)),\n            Err(e) : Err(HttpTlsFailure(e)),\n        };\n    }\n    Er"
    "r(HttpNetFailure(last))\n}fn is_credential(StringView name) : bool\n{\n    name_eq(name, \"authorization"
    "\") || name_eq(name, \"proxy-authorization\") || name_eq(name, \"cookie\")\n}fn request_bytes(\n    ref<Htt"
    "pClient, shared> c,\n    ref<Request, shared> req,\n    ref<Url, shared> u,\n    StringView method,\n   "
    " slice<u8, shared> body,\n    bool with_content,\n    bool credentials,\n) : Vec<u8>\n{\n    String head "
    "= String::copy(method);\n    String::append(&mut head, \" \");\n    String::append(&mut head, &Url::targ"
    "et(u));\n    String::append(&mut head, \" HTTP/1.1\\r\\nHost: \");\n    String::append(&mut head, &host_te"
    "xt(u));\n    String::append(&mut head, \"\\r\\n\");\n    foreach (h in &c.headers)\n    {\n        StringVie"
    "w name = &h.name;\n        bool kept = credentials || !is_credential(name);\n        if (kept && !has_"
    "header(&req.headers, name))\n        {\n            String::append(&mut head, &h.name);\n            St"
    "ring::append(&mut head, \": \");\n            String::append(&mut head, &h.value);\n            String::"
    "append(&mut head, \"\\r\\n\");\n        }\n    }\n    foreach (h in &req.headers)\n    {\n        if (name_eq"
    "(\n            &h.name,\n            \"host\",\n        ) || name_eq(&h.name, \"content-length\") || name_e"
    "q(&h.name, \"connection\"))\n        {\n            continue;\n        }\n        // After a redirect to a"
    "nother origin, no credentials go there.\n        if (!credentials && is_credential(&h.name))\n        "
    "{\n            continue;\n        }\n        // After a redirect that dropped the body, its Content-Typ"
    "e goes too.\n        if (!with_content && name_eq(&h.name, \"content-type\"))\n        {\n            con"
    "tinue;\n        }\n        String::append(&mut head, &h.name);\n        String::append(&mut head, \": \")"
    ";\n        String::append(&mut head, &h.value);\n        String::append(&mut head, \"\\r\\n\");\n    }\n    "
    "if (slice_len(body) > 0 || method_has_body(method))\n    {\n        String::append(&mut head, \"Content"
    "-Length: \");\n        String::append(&mut head, slice_len(body));\n        String::append(&mut head, \""
    "\\r\\n\");\n    }\n    if (!c.keep_alive)\n    {\n        String::append(&mut head, \"Connection: close\\r\\n\""
    ");\n    }\n    String::append(&mut head, \"\\r\\n\");\n    Vec<u8> out = String::into_bytes(head);\n    Vec:"
    ":extend_from(&mut out, body);\n    out\n}fn not_content_encoding(ref<Header, shared> h) : bool\n{\n    !"
    "name_eq(&h.name, \"content-encoding\") && !name_eq(&h.name, \"content-length\")\n}fn parse_status_line(St"
    "ringView line) : Result<StatusLine, HttpError>\n{\n    if (!StringView::starts_with(line, \"HTTP/1.\") |"
    "| StringView::len(line) < 12)\n    {\n        return Err(BadMessage);\n    }\n    // The version, the sp"
    "ace, the three digits and the space are ASCII\n    // (RFC 9112 §4): a byte of 128 or more among the"
    "m is a malformed line,\n    // not a place to cut a character in two (found by the hostile-input\n    "
    "// round, D-0211).\n    for (usize i = 0; i < 13 && i < StringView::len(line); i += 1)\n    {\n        "
    "if (line.bytes[i] >= 128)\n        {\n            return Err(BadMessage);\n        }\n    }\n    u16 stat"
    "us = match (StringView::parse<u16>(&line[9..12]))\n    {\n        Ok(v)  : v,\n        Err(_) : return "
    "Err(BadMessage),\n    };\n    if (status < 100 || status > 599)\n    {\n        return Err(BadMessage);\n"
    "    }\n    String reason = if (StringView::len(line) > 13)\n    {\n        String::copy(&line[13..$])\n "
    "   }\n    else { String::new() };\n    Ok(StatusLine { .status = status, .reason = reason })\n}fn origi"
    "n_of(ref<Url, shared> u) : String\n{\n    String o = String::clone(&u.scheme);\n    String::append(&mut"
    " o, \"://\");\n    String::append(&mut o, &host_text(u));\n    o\n}fn idempotent(StringView method) : boo"
    "l\n{\n    method == \"GET\" || method == \"HEAD\" || method == \"PUT\" || method == \"DELETE\" || method == \"O"
    "PTIONS\" || method == \"TRACE\"\n}fn exchange(\n    ref<HttpClient, exclusive> c,\n    ref<Request, shared"
    "> req,\n    ref<Url, shared> u,\n    StringView method,\n    slice<u8, shared> body,\n    bool with_cont"
    "ent,\n    bool credentials,\n) : Result<Response, HttpError>\n{\n    String want = origin_of(u);\n    if "
    "(Some(ic) = replace(&mut c.idle, None))\n    {\n        IdleConn { origin, r } = ic;\n        if (origi"
    "n == want)\n        {\n            if (Some(resp) = exchange_on(c, r, true, req, u, method, body, with"
    "_content, credentials)?)\n            {\n                return Ok(resp);\n            }\n            //"
    " Closed with nothing answered: the server may still have\n            // acted on the request, so onl"
    "y an idempotent one is sent\n            // again (RFC 9110 §9.2.2) -- a POST twice could do twice w"
    "hat\n            // it asks.\n            if (!idempotent(method))\n            {\n                retur"
    "n Err(ConnectionClosed);\n            }\n        }\n        else\n        {\n            conn_close(&mut "
    "r.conn);\n        }\n    }\n    Reader fresh = Reader { .conn = open_connection(c, u)?, .buf = Vec::new"
    "(), .at = 0 };\n    match (exchange_on(c, fresh, false, req, u, method, body, with_content, credentia"
    "ls)?)\n    {\n        Some(resp) : Ok(resp),\n        None       : Err(ConnectionClosed),\n    }\n}fn exc"
    "hange_on(\n    ref<HttpClient, exclusive> c,\n    Reader r,\n    bool reused,\n    ref<Request, shared> "
    "req,\n    ref<Url, shared> u,\n    StringView method,\n    slice<u8, shared> body,\n    bool with_conten"
    "t,\n    bool credentials,\n) : Result<Option<Response>, HttpError>\n{\n    match (conn_write(&mut r.conn"
    ", &request_bytes(c, req, u, method, body, with_content, credentials)))\n    {\n        Ok(_)  : {},\n  "
    "      Err(e) :\n        {\n            if (reused)\n            {\n                return Ok(None);\n    "
    "        }\n            return Err(e);\n        },\n    }\n    bool first = true;\n    // Interim 1xx resp"
    "onses (a 100 Continue) are read past.\n    while (true)\n    {\n        String line = match (http_line("
    "&mut r, MAX_HEAD))\n        {\n            Ok(Some(l)) : l,\n            Ok(None)    :\n            {\n  "
    "              if (reused && first)\n                {\n                    return Ok(None);\n          "
    "      }\n                return Err(ConnectionClosed);\n            },\n            Err(e)      :\n     "
    "       {\n                if (reused && first && Vec::len(&r.buf) == 0)\n                {\n           "
    "         return Ok(None);\n                }\n                return Err(e);\n            },\n        };"
    "\n        first = false;\n        bool http11 = StringView::starts_with(&line, \"HTTP/1.1\");\n        St"
    "atusLine { status, reason } = parse_status_line(&line)?;\n        Vec<Header> headers = read_headers("
    "&mut r, StringView::len(&line) + 2)?;\n        if (status >= 100 && status < 200)\n        {\n         "
    "   continue;\n        }\n        bool no_body = (method == \"HEAD\") || status == 204 || status == 304;\n"
    "        BodyLength how = if (no_body) { NoBody } else { body_length(&headers, true)? };\n        bool"
    " until_close = match (how)\n        {\n            UntilClose : true,\n            _          : false,\n"
    "        };\n        Vec<u8> data = read_body(&mut r, how, c.max_body)?;\n        // Kept when asked fo"
    "r, allowed (HTTP/1.1, no `Connection: close`),\n        // the body's end known without the connectio"
    "n's, and nothing more\n        // read than the response.\n        bool keep = c.keep_alive && http11 "
    "&& !until_close && r.at == Vec::len(&r.buf);\n        if (Some(v) = find_header(&headers, \"connection"
    "\"))\n        {\n            if (name_eq(StringView::trim(v), \"close\"))\n            {\n                k"
    "eep = false;\n            }\n        }\n        if (keep)\n        {\n            c.idle = Some(IdleConn "
    "{ .origin = String::clone(&origin_of(u)), .r = r });\n        }\n        else\n        {\n            co"
    "nn_close(&mut r.conn);\n        }\n        // D-0183: a body sent compressed (`Content-Encoding: gzip`"
    " or\n        // `deflate`, which the client offers) arrives decoded, within\n        // `max_body`, an"
    "d the header is dropped so the response reads as\n        // a plain one.\n        bool strip = false;"
    "\n        if (!no_body)\n        {\n            if (Some(enc) = find_header(&headers, \"content-encoding"
    "\"))\n            {\n                StringView e = StringView::trim(enc);\n                Option<Resul"
    "t<Vec<u8>, CompressError>> decoded = if (name_eq(e, \"gzip\") || name_eq(e, \"x-gzip\"))\n               "
    " {\n                    Some(gunzip(&data, c.max_body))\n                }\n                else if (na"
    "me_eq(e, \"deflate\"))\n                {\n                    Some(match (zlib_inflate(&data, c.max_bod"
    "y))\n                    {\n                        Ok(v)  : Ok(v),\n                        Err(_) : i"
    "nflate(&data, c.max_body),\n                    })\n                }\n                else { None };\n "
    "               if (Some(d) = decoded)\n                {\n                    overwrite(&mut data, mat"
    "ch (d)\n                    {\n                        Ok(v)         : v,\n                        Err("
    "Oversize) : return Err(TooLarge),\n                        Err(_)        : return Err(BadMessage),\n  "
    "                  });\n                    strip = true;\n                }\n            }\n        }\n  "
    "      if (strip)\n        {\n            Vec::retain(&mut headers, not_content_encoding);\n        }\n  "
    "      return Ok(Some(Response { .status = status, .reason = reason, .headers = headers, .body = data"
    " }));\n    }\n}fn redirect_target(ref<Url, shared> base, StringView location) : Result<Url, HttpError>"
    "\n{\n    if (Option::is_some(&StringView::find(location, \"://\")))\n    {\n        return Url::parse(loca"
    "tion);\n    }\n    String text = String::clone(&base.scheme);\n    String::append(&mut text, \"://\");\n  "
    "  String::append(&mut text, &host_text(base));\n    if (StringView::starts_with(location, \"/\"))\n    {"
    "\n        String::append(&mut text, location);\n    }\n    else\n    {\n        StringView path = &base.p"
    "ath;\n        usize dir = 0;\n        slice<u8, shared> pb = StringView::as_bytes(path);\n        for ("
    "usize i = 0; i < slice_len(pb); i += 1)\n        {\n            if (pb[i] == b'/')\n            {\n     "
    "           dir = i + 1;\n            }\n        }\n        String::append(&mut text, &path[0..dir]);\n  "
    "      String::append(&mut text, location);\n    }\n    Url::parse(&text)\n}export fn HttpClient::send(r"
    "ef<HttpClient, exclusive> c, ref<Request, shared> req) : Result<Response, HttpError>\n{\n    Url u = U"
    "rl::parse(&req.url)?;\n    String method = String::clone(&req.method);\n    Vec<u8> body = Vec::clone("
    "&req.body);\n    usize hops = 0;\n    bool with_content = true;\n    String first_origin = origin_of(&u"
    ");\n    bool credentials = true;\n    while (true)\n    {\n        Response resp = exchange(c, req, &u, "
    "&method, &body, with_content, credentials)?;\n        bool redirect = resp.status == 301 || resp.stat"
    "us == 302 || resp.status == 303 || resp.status == 307 || resp.status == 308;\n        if (!redirect)\n"
    "        {\n            return Ok(resp);\n        }\n        StringView location = match (Response::head"
    "er(&resp, \"location\"))\n        {\n            Some(l) : l,\n            None    : return Ok(resp),\n   "
    "     };\n        if (hops == c.max_redirects)\n        {\n            return Err(TooManyRedirects);\n   "
    "     }\n        hops += 1;\n        Url next = redirect_target(&u, location)?;\n        overwrite(&mut "
    "u, next);\n        // Once a redirect leaves the first origin, credentials stay behind,\n        // ev"
    "en if a later one comes back.\n        if (origin_of(&u) != first_origin)\n        {\n            crede"
    "ntials = false;\n        }\n        if (resp.status != 307 && resp.status != 308 && method != \"HEAD\")\n"
    "        {\n            overwrite(&mut method, \"GET\");\n            Vec::clear(&mut body);\n            "
    "with_content = false;\n        }\n    }\n}export fn http_get(StringView url) : Result<Response, HttpErr"
    "or>\n{\n    HttpClient c = HttpClient::new();\n    Request req = Request::new(\"GET\", url);\n    HttpClie"
    "nt::send(&mut c, &req)\n}export fn http_post(StringView url, StringView content_type, slice<u8, share"
    "d> body) : Result<Response, HttpError>\n{\n    HttpClient c = HttpClient::new();\n    Request req = Req"
    "uest::new(\"POST\", url);\n    Vec::push(&mut req.headers, Header::new(\"Content-Type\", content_type));\n"
    "    Vec::extend_from(&mut req.body, body);\n    HttpClient::send(&mut c, &req)\n}export fn HttpServer:"
    ":bind(SocketAddr a) : Result<HttpServer, NetError>\n{\n    TcpListener l = TcpListener::bind(a)?;\n    "
    "Ok(HttpServer { .listener = l, .max_body = 16777216, .timeout_ms = 30000, .key = None, .chain = Vec:"
    ":new() })\n}export fn HttpServer::bind_tls(SocketAddr a, PrivateKey key, Vec<Certificate> chain) : Re"
    "sult<HttpServer, NetError>\n{\n    TcpListener l = TcpListener::bind(a)?;\n    Ok(HttpServer { .listene"
    "r = l, .max_body = 16777216, .timeout_ms = 30000, .key = Some(key), .chain = chain })\n}export fn Htt"
    "pServer::local_addr(ref<HttpServer, shared> s) : SocketAddr\n{\n    TcpListener::local_addr(&s.listene"
    "r)\n}export fn HttpServer::accept(ref<HttpServer, exclusive> s) : Result<HttpConnection, HttpError>\n{"
    "\n    TcpStream tcp = match (TcpListener::accept(&mut s.listener))\n    {\n        Ok(t)  : t,\n        "
    "Err(e) : return Err(HttpNetFailure(e)),\n    };\n    TcpStream::set_read_timeout_ms(&mut tcp, s.timeou"
    "t_ms);\n    TcpStream::set_write_timeout_ms(&mut tcp, s.timeout_ms);\n    TcpStream::set_nodelay(&mut "
    "tcp, true);\n    Conn conn = match (&s.key)\n    {\n        Some(k) : match (TlsStream::server(tcp, k, "
    "&s.chain))\n        {\n            Ok(t)  : Secure(t),\n            Err(e) : return Err(HttpTlsFailure("
    "e)),\n        },\n        None : Plain(tcp),\n    };\n    Ok(HttpConnection { .reader = Reader { .conn ="
    " conn, .buf = Vec::new(), .at = 0 }, .max_body = s.max_body, .keep_alive = true, .head_request = fal"
    "se, .closed = false })\n}export fn HttpConnection::peer_addr(ref<HttpConnection, shared> c) : SocketA"
    "ddr\n{\n    match (&c.reader.conn)\n    {\n        Plain(s)  : TcpStream::peer_addr(s),\n        Secure(s"
    ") : TlsStream::peer_addr(s),\n    }\n}export fn HttpConnection::request(ref<HttpConnection, exclusive>"
    " c) : Result<Option<Request>, HttpError>\n{\n    if (c.closed || !c.keep_alive)\n    {\n        return O"
    "k(None);\n    }\n    // After an Err the connection closes ([Http-Request]): a request line\n    // ove"
    "r the limit, or not UTF-8, included.\n    String line = match (http_line(&mut c.reader, MAX_HEAD))\n  "
    "  {\n        Ok(Some(l)) : l,\n        Ok(None)    : return Ok(None),\n        Err(e)      :\n        {\n"
    "            c.keep_alive = false;\n            return Err(e);\n        },\n    };\n    // A request line"
    ": METHOD SP target SP HTTP/1.x.\n    Vec<StringView> parts = StringView::split(&line, \" \");\n    if (V"
    "ec::len(&parts) != 3 || StringView::len(parts[0]) == 0 || StringView::len(parts[1]) == 0)\n    {\n    "
    "    c.keep_alive = false;\n        return Err(BadMessage);\n    }\n    bool v11 = (parts[2] == \"HTTP/1."
    "1\");\n    if (!v11 && parts[2] != \"HTTP/1.0\")\n    {\n        c.keep_alive = false;\n        return Err("
    "BadMessage);\n    }\n    Vec<Header> headers = match (read_headers(&mut c.reader, StringView::len(&lin"
    "e) + 2))\n    {\n        Ok(h)  : h,\n        Err(e) :\n        {\n            c.keep_alive = false;\n    "
    "        return Err(e);\n        },\n    };\n    if (v11 && Option::is_none(&find_header(&headers, \"host"
    "\")))\n    {\n        c.keep_alive = false;\n        return Err(BadMessage);\n    }\n    // Keep-alive: HT"
    "TP/1.1 unless `Connection: close`, HTTP/1.0 only with\n    // `Connection: keep-alive`.\n    c.keep_al"
    "ive = match (find_header(&headers, \"connection\"))\n    {\n        Some(v) : if (v11)\n        {\n       "
    "     !name_eq(\n                StringView::trim(v),\n                \"close\",\n            )\n        }"
    "\n        else { name_eq(StringView::trim(v), \"keep-alive\") },\n        None : v11,\n    };\n    c.head_"
    "request = (parts[0] == \"HEAD\");\n    BodyLength how = match (body_length(&headers, false))\n    {\n    "
    "    Ok(h)  : h,\n        Err(e) :\n        {\n            c.keep_alive = false;\n            return Err("
    "e);\n        },\n    };\n    if (Some(expect) = find_header(&headers, \"expect\"))\n    {\n        if (name"
    "_eq(StringView::trim(expect), \"100-continue\"))\n        {\n            if (Err(e) = conn_write(&mut c."
    "reader.conn, b\"HTTP/1.1 100 Continue\\r\\n\\r\\n\"))\n            {\n                c.keep_alive = false;\n"
    "                return Err(e);\n            }\n        }\n    }\n    Vec<u8> body = match (read_body(&mu"
    "t c.reader, how, c.max_body))\n    {\n        Ok(b)  : b,\n        Err(e) :\n        {\n            c.kee"
    "p_alive = false;\n            return Err(e);\n        },\n    };\n    Ok(Some(Request { .method = String"
    "::copy(parts[0]), .url = String::copy(parts[1]), .headers = headers, .body = body }))\n}export fn Htt"
    "pConnection::respond(\n    ref<HttpConnection, exclusive> c,\n    u16 status,\n    slice<Header, shared"
    "> headers,\n    slice<u8, shared> body,\n) : Result<void, HttpError>\n{\n    String head = \"HTTP/1.1 \";\n"
    "    String::append(&mut head, status);\n    String::append(&mut head, \" \");\n    String::append(&mut h"
    "ead, reason_phrase(status));\n    String::append(&mut head, \"\\r\\n\");\n    for (usize i = 0; i < slice_"
    "len(headers); i += 1)\n    {\n        if (name_eq(\n            &headers[i].name,\n            \"content-"
    "length\",\n        ) || name_eq(&headers[i].name, \"connection\"))\n        {\n            continue;\n     "
    "   }\n        String::append(&mut head, &headers[i].name);\n        String::append(&mut head, \": \");\n "
    "       String::append(&mut head, &headers[i].value);\n        String::append(&mut head, \"\\r\\n\");\n    "
    "}\n    bool no_body = status == 204 || status == 304 || (status >= 100 && status < 200);\n    if (!no_"
    "body)\n    {\n        String::append(&mut head, \"Content-Length: \");\n        String::append(&mut head,"
    " slice_len(body));\n        String::append(&mut head, \"\\r\\n\");\n    }\n    String::append(\n        &mut"
    " head,\n        if (c.keep_alive) { \"Connection: keep-alive\\r\\n\\r\\n\" } else { \"Connection: close\\r\\n\\"
    "r\\n\" },\n    );\n    Vec<u8> out = String::into_bytes(head);\n    if (!no_body && !c.head_request)\n    "
    "{\n        Vec::extend_from(&mut out, body);\n    }\n    conn_write(&mut c.reader.conn, &out)?;\n    if "
    "(!c.keep_alive)\n    {\n        conn_close(&mut c.reader.conn);\n        c.closed = true;\n    }\n    Ok("
    "())\n}export fn HttpConnection::close(ref<HttpConnection, exclusive> c)\n{\n    if (!c.closed)\n    {\n  "
    "      conn_close(&mut c.reader.conn);\n        c.closed = true;\n    }\n}export fn scram_salted_passwor"
    "d(StringView password, slice<u8, shared> salt, usize iterations) : Vec<u8>\n{\n    pbkdf2(Sha2_256, St"
    "ringView::as_bytes(password), salt, iterations, 32)\n}export fn Scram::start(StringView user, StringV"
    "iew client_nonce) : Scram\n{\n    String bare = \"n=\";\n    foreach (c in StringView::as_bytes(user))\n  "
    "  {\n        if (*c == b',')\n        {\n            String::append(&mut bare, \"=2C\");\n        }\n      "
    "  else if (*c == b'=')\n        {\n            String::append(&mut bare, \"=3D\");\n        }\n        els"
    "e\n        {\n            String::push_ascii(&mut bare, *c);\n        }\n    }\n    String::append(&mut b"
    "are, \",r=\");\n    String::append(&mut bare, client_nonce);\n    Scram { .client_nonce = String::copy(c"
    "lient_nonce), .client_first_bare = bare, .server_signature = Vec::new() }\n}export fn Scram::client_f"
    "irst(ref<Scram, shared> s) : String\n{\n    String m = \"n,,\";\n    String::append(&mut m, &s.client_fir"
    "st_bare);\n    m\n}fn attribute(slice<StringView, shared> parts, str name) : Option<StringView>\n{\n    "
    "foreach (p in parts)\n    {\n        if (StringView::starts_with(*p, StringView::of(name)))\n        {\n"
    "            return Some(&(*p)[2..$]);\n        }\n    }\n    None\n}export fn Scram::respond(\n    ref<Sc"
    "ram, exclusive> s,\n    StringView server_first,\n    StringView password,\n) : Result<String, PgError>"
    "\n{\n    Vec<StringView> parts = StringView::split(server_first, \",\");\n    if (Option::is_some(&attrib"
    "ute(&parts, \"m=\")))\n    {\n        return Err(ProtocolViolation);\n    }\n    StringView nonce = Option"
    "::ok_or(attribute(&parts, \"r=\"), ProtocolViolation)?;\n    StringView salt_text = Option::ok_or(attri"
    "bute(&parts, \"s=\"), ProtocolViolation)?;\n    StringView iter_text = Option::ok_or(attribute(&parts, "
    "\"i=\"), ProtocolViolation)?;\n    if (!StringView::starts_with(\n        nonce,\n        &s.client_nonce"
    ",\n    ) || StringView::len(nonce) <= StringView::len(&s.client_nonce))\n    {\n        return Err(Auth"
    "Failed);\n    }\n    Vec<u8> salt = match (base64_decode(salt_text))\n    {\n        Ok(v)  : v,\n       "
    " Err(_) : return Err(ProtocolViolation),\n    };\n    usize iterations = match (StringView::parse<usiz"
    "e>(iter_text))\n    {\n        Ok(n)  : n,\n        Err(_) : return Err(ProtocolViolation),\n    };\n    "
    "if (iterations == 0)\n    {\n        return Err(ProtocolViolation);\n    }\n    Vec<u8> salted = scram_s"
    "alted_password(password, &salt, iterations);\n    array<u8, 32> client_key = hmac_sha256(&salted, b\"C"
    "lient Key\");\n    array<u8, 32> stored_key = sha256(&client_key);\n    String without_proof = \"c=biws,"
    "r=\";\n    String::append(&mut without_proof, nonce);\n    String auth = String::clone(&s.client_first_"
    "bare);\n    String::append(&mut auth, \",\");\n    String::append(&mut auth, server_first);\n    String::"
    "append(&mut auth, \",\");\n    String::append(&mut auth, &without_proof);\n    array<u8, 32> client_sign"
    "ature = hmac_sha256(&stored_key, StringView::as_bytes(&auth));\n    Vec<u8> proof = Vec::new();\n    f"
    "or (usize i = 0; i < 32; i += 1)\n    {\n        Vec::push(&mut proof, client_key[i] ^ client_signatur"
    "e[i]);\n    }\n    array<u8, 32> server_key = hmac_sha256(&salted, b\"Server Key\");\n    array<u8, 32> s"
    "erver_signature = hmac_sha256(&server_key, StringView::as_bytes(&auth));\n    overwrite(&mut s.server"
    "_signature, Vec::from_slice(&server_signature));\n    String::append(&mut without_proof, \",p=\");\n    "
    "String::append(&mut without_proof, &base64_encode(&proof));\n    Ok(without_proof)\n}export fn Scram::"
    "verify(ref<Scram, shared> s, StringView server_final) : bool\n{\n    if (Vec::len(&s.server_signature)"
    " == 0 || !StringView::starts_with(server_final, \"v=\"))\n    {\n        return false;\n    }\n    match ("
    "base64_decode(&server_final[2..$]))\n    {\n        Ok(v)  : digest_eq(&v, &s.server_signature),\n     "
    "   Err(_) : false,\n    }\n}unittest \"Scram: a whole exchange\"\n{\n    Scram s = Scram::start(\"user\", \"r"
    "OprNGfwEbeRWgbNEkqO\");\n    assert(Scram::client_first(&s) == \"n,,n=user,r=rOprNGfwEbeRWgbNEkqO\");\n  "
    "  String first = \"r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,\";\n    String::append(&mut fi"
    "rst, \"s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4\");\n    String reply = Result::unwrap(Scram::respond(&mut s, &fi"
    "rst, \"pencil\"));\n    assert(StringView::ends_with(&reply, \",p=0ByS2g6XZEtov8MR140MFRsEfy8/X+bacfpPof"
    "VtKjE=\"));\n    assert(Scram::verify(&s, \"v=ITrN4zX09+hsD398Qk6ol73eg0shWPnOWwnwS83jitc=\"));\n    asse"
    "rt(!Scram::verify(&s, \"e=invalid-proof\"));\n}export fn PgError::text(ref<PgError, shared> e) : String"
    "\n{\n    match (e)\n    {\n        PgNetFailure(n)   : String::copy(NetError::text(n)),\n        PgTlsFai"
    "lure(t)   : String::copy(TlsError::text(t)),\n        TlsRefused        : \"the server does not accept"
    " TLS\",\n        NoTrustedRoots    : \"no trusted roots for TLS (TrustStore::system failed)\",\n        B"
    "adConnectionUrl  : \"the connection URL is malformed\",\n        UnsupportedAuth   : \"the server asks f"
    "or an authentication method that is not supported\",\n        AuthRefused       : \"the server asks for"
    " the password in clear over an unencrypted connection\",\n        AuthFailed        : \"authentication "
    "failed\",\n        Server(s)         :\n        {\n            String t = String::clone(&s.severity);\n  "
    "          String::append(&mut t, \": \");\n            String::append(&mut t, &s.message);\n            "
    "String::append(&mut t, \" (\");\n            String::append(&mut t, &s.code);\n            String::appen"
    "d(&mut t, \")\");\n            t\n        },\n        ProtocolViolation : \"the server's message is malfor"
    "med\",\n        ResultTooLarge    : \"the result is larger than the limit\",\n        Disconnected      :"
    " \"the connection is closed\",\n    }\n}fn decoded(StringView v) : Result<String, PgError>\n{\n    Vec<u8>"
    " bytes = match (percent_decode(v))\n    {\n        Some(b) : b,\n        None    : return Err(BadConnec"
    "tionUrl),\n    };\n    match (String::from_utf8(bytes))\n    {\n        Ok(s)  : Ok(s),\n        Err(_) :"
    " Err(BadConnectionUrl),\n    }\n}export fn PgUrl::parse(StringView text) : Result<PgUrl, PgError>\n{\n  "
    "  usize sep = match (StringView::find(text, \"://\"))\n    {\n        Some(i) : i,\n        None    : ret"
    "urn Err(BadConnectionUrl),\n    };\n    StringView scheme = &text[0..sep];\n    if (scheme != \"postgres"
    "\" && scheme != \"postgresql\")\n    {\n        return Err(BadConnectionUrl);\n    }\n    StringView rest ="
    " &text[sep + 3..$];\n    usize n = StringView::len(rest);\n    slice<u8, shared> b = StringView::as_by"
    "tes(rest);\n    usize auth_end = 0;\n    while (auth_end < n && b[auth_end] != b'/' && b[auth_end] != "
    "b'?')\n    {\n        auth_end += 1;\n    }\n    // The user information ends at the last '@' of the aut"
    "hority.\n    usize at_sign = auth_end;\n    for (usize i = 0; i < auth_end; i += 1)\n    {\n        if ("
    "b[i] == b'@')\n        {\n            at_sign = i;\n        }\n    }\n    if (at_sign == auth_end || at_s"
    "ign == 0)\n    {\n        return Err(BadConnectionUrl);\n    }\n    StringView userinfo = &rest[0..at_si"
    "gn];\n    String user = String::new();\n    Option<String> password = None;\n    match (StringView::fin"
    "d(userinfo, \":\"))\n    {\n        Some(colon) :\n        {\n            overwrite(&mut user, decoded(&us"
    "erinfo[0..colon])?);\n            overwrite(&mut password, Some(decoded(&userinfo[colon + 1..$])?));\n"
    "        },\n        None        : overwrite(&mut user, decoded(userinfo)?),\n    }\n    if (StringView:"
    ":len(&user) == 0)\n    {\n        return Err(BadConnectionUrl);\n    }\n    StringView hostport = &rest["
    "at_sign + 1..auth_end];\n    usize hp = StringView::len(hostport);\n    slice<u8, shared> hb = StringV"
    "iew::as_bytes(hostport);\n    if (hp == 0)\n    {\n        return Err(BadConnectionUrl);\n    }\n    Stri"
    "ng host = String::new();\n    usize host_end = 0;\n    if (hb[0] == b'[')\n    {\n        usize close = "
    "match (StringView::find(hostport, \"]\"))\n        {\n            Some(i) : i,\n            None    : ret"
    "urn Err(BadConnectionUrl),\n        };\n        String::append(&mut host, &hostport[1..close]);\n      "
    "  host_end = close + 1;\n    }\n    else\n    {\n        while (host_end < hp && hb[host_end] != b':')\n "
    "       {\n            host_end += 1;\n        }\n        String::append(&mut host, &hostport[0..host_en"
    "d]);\n    }\n    if (StringView::len(&host) == 0)\n    {\n        return Err(BadConnectionUrl);\n    }\n  "
    "  u16 port = 5432;\n    if (host_end < hp)\n    {\n        if (hb[host_end] != b':')\n        {\n        "
    "    return Err(BadConnectionUrl);\n        }\n        port = match (StringView::parse<u16>(&hostport[h"
    "ost_end + 1..hp]))\n        {\n            Ok(p)  : p,\n            Err(_) : return Err(BadConnectionUr"
    "l),\n        };\n    }\n    // The database: the path without its '/', the user when none.\n    usize pa"
    "th_end = auth_end;\n    while (path_end < n && b[path_end] != b'?')\n    {\n        path_end += 1;\n    "
    "}\n    String database = String::new();\n    if (path_end > auth_end + 1)\n    {\n        overwrite(&mut"
    " database, decoded(&rest[auth_end + 1..path_end])?);\n    }\n    if (StringView::len(&database) == 0)\n"
    "    {\n        overwrite(&mut database, String::clone(&user));\n    }\n    PgSslMode sslmode = VerifyFu"
    "ll;\n    if (path_end < n)\n    {\n        StringView query = &rest[path_end + 1..n];\n        if (Strin"
    "gView::len(query) > 0)\n        {\n            Vec<StringView> pairs = StringView::split(query, \"&\");\n"
    "            foreach (pair in &pairs)\n            {\n                if (StringView::starts_with(*pair"
    ", \"sslmode=\"))\n                {\n                    StringView mode = &(*pair)[8..$];\n             "
    "       if (mode == \"disable\")\n                    {\n                        sslmode = Disable;\n     "
    "               }\n                    else if (mode == \"verify-full\")\n                    {\n         "
    "               sslmode = VerifyFull;\n                    }\n                    else\n                "
    "    {\n                        return Err(BadConnectionUrl);\n                    }\n                }\n"
    "                else\n                {\n                    return Err(BadConnectionUrl);\n           "
    "     }\n            }\n        }\n    }\n    Ok(PgUrl { .user = user, .password = password, .host = host"
    ", .port = port, .database = database, .sslmode = sslmode })\n}unittest \"PgUrl::parse: decoding and de"
    "faults\"\n{\n    PgUrl u = Result::unwrap(PgUrl::parse(\"postgres://app:p%40ss@[::1]/?sslmode=disable\"))"
    ";\n    assert(u.host == \"::1\" && u.port == 5432);\n    assert(u.database == \"app\");\n    match (&u.pass"
    "word)\n    {\n        Some(p) : assert(*p == \"p@ss\"),\n        None    : assert(false),\n    }\n    Resul"
    "t<PgUrl, PgError> no_user = PgUrl::parse(\"postgres://db.example/shop\");\n    assert(Result::is_err(&n"
    "o_user));\n}fn float_text(f64 x) : String\n{\n    if (x != x)\n    {\n        return \"NaN\";\n    }\n    if "
    "(x > 1.7976931348623157e308)\n    {\n        return \"Infinity\";\n    }\n    if (x < -1.7976931348623157e"
    "308)\n    {\n        return \"-Infinity\";\n    }\n    String t = String::new();\n    String::append(&mut t"
    ", x);\n    t\n}export fn PgValue::text(ref<PgValue, shared> value) : Option<String>\n{\n    match (value"
    ")\n    {\n        Null     : None,\n        Text(s)  : Some(String::clone(s)),\n        Int(i)   :\n     "
    "   {\n            String t = String::new();\n            String::append(&mut t, *i);\n            Some("
    "t)\n        },\n        Float(f) : Some(float_text(*f)),\n        Bool(b)  : Some(if (*b) { \"t\" } else "
    "{ \"f\" }),\n        Bytes(v) :\n        {\n            String t = \"\\\\x\";\n            String::append(&mut"
    " t, &to_hex(v));\n            Some(t)\n        },\n    }\n}unittest \"PgValue::text: what is sent\"\n{\n    "
    "assert(Option::unwrap(PgValue::text(&Bool(true))) == \"t\");\n    assert(Option::unwrap(PgValue::text(&"
    "Bytes(Vec::filled(2, 0xAB: u8)))) == \"\\\\xabab\");\n    assert(Option::unwrap(PgValue::text(&Float(1.0 "
    "/ 0.0))) == \"Infinity\");\n    assert(Option::is_none(&PgValue::text(&Null)));\n}export fn PgRow::get(r"
    "ef<PgRow, shared> r, usize i) : Option<StringView>\n{\n    if (i >= Vec::len(&r.cells))\n    {\n        "
    "return None;\n    }\n    match (&r.cells[i])\n    {\n        Some(s) : Some(s),\n        None    : None,\n"
    "    }\n}export fn PgRow::get_i64(ref<PgRow, shared> r, usize i) : Option<i64>\n{\n    match (PgRow::get"
    "(r, i))\n    {\n        Some(t) : match (StringView::parse<i64>(t))\n        {\n            Ok(v)  : Som"
    "e(v),\n            Err(_) : None,\n        },\n        None : None,\n    }\n}export fn PgRow::get_f64(ref"
    "<PgRow, shared> r, usize i) : Option<f64>\n{\n    match (PgRow::get(r, i))\n    {\n        Some(t) :\n   "
    "     {\n            if (t == \"NaN\")\n            {\n                return Some(0.0 / 0.0);\n           "
    " }\n            if (t == \"Infinity\")\n            {\n                return Some(1.0 / 0.0);\n          "
    "  }\n            if (t == \"-Infinity\")\n            {\n                return Some(-1.0 / 0.0);\n       "
    "     }\n            match (StringView::parse<f64>(t))\n            {\n                Ok(v)  : Some(v),"
    "\n                Err(_) : None,\n            }\n        },\n        None    : None,\n    }\n}export fn Pg"
    "Row::get_bool(ref<PgRow, shared> r, usize i) : Option<bool>\n{\n    match (PgRow::get(r, i))\n    {\n   "
    "     Some(t) :\n        {\n            if (t == \"t\")\n            {\n                return Some(true);\n"
    "            }\n            if (t == \"f\")\n            {\n                return Some(false);\n          "
    "  }\n            None\n        },\n        None    : None,\n    }\n}export fn PgRow::get_bytes(ref<PgRow,"
    " shared> r, usize i) : Option<Vec<u8>>\n{\n    match (PgRow::get(r, i))\n    {\n        Some(t) : match "
    "(StringView::strip_prefix(t, \"\\\\x\"))\n        {\n            // `\\x` alone is the empty bytea, which f"
    "rom_hex refuses.\n            Some(hex) : if (StringView::len(hex) == 0)\n            {\n              "
    "  Some(Vec::new())\n            }\n            else\n            {\n                match (from_hex(hex)"
    ")\n                {\n                    Ok(v)  : Some(v),\n                    Err(_) : None,\n       "
    "         }\n            },\n            None : None,\n        },\n        None : None,\n    }\n}unittest \""
    "PgRow: typed reads of cells\"\n{\n    Vec<Option<String>> cells = Vec::new();\n    Vec::push(&mut cells,"
    " Some(\"42\"));\n    Vec::push(&mut cells, Some(\"t\"));\n    Vec::push(&mut cells, None);\n    PgRow row ="
    " PgRow { .cells = cells };\n    assert(Option::unwrap(PgRow::get_i64(&row, 0)) == 42);\n    assert(Opt"
    "ion::unwrap(PgRow::get_bool(&row, 1)));\n    assert(Option::is_none(&PgRow::get_bool(&row, 0)));\n    "
    "assert(Option::is_none(&PgRow::get(&row, 2)) && Option::is_none(&PgRow::get(&row, 9)));\n}export fn P"
    "gResult::column(ref<PgResult, shared> res, StringView name) : Option<usize>\n{\n    for (usize i = 0; "
    "i < Vec::len(&res.columns); i += 1)\n    {\n        if (res.columns[i].name == name)\n        {\n       "
    "     return Some(i);\n        }\n    }\n    None\n}fn tag_count(StringView tag) : u64\n{\n    Vec<StringVi"
    "ew> words = StringView::split(tag, \" \");\n    if (Vec::len(&words) < 2)\n    {\n        return 0;\n    }"
    "\n    match (StringView::parse<u64>(words[Vec::len(&words) - 1]))\n    {\n        Ok(n)  : n,\n        E"
    "rr(_) : 0,\n    }\n}fn pg_read(ref<PgConn, exclusive> c, ref<Vec<u8>, exclusive> buf, usize max) : Res"
    "ult<usize, PgError>\n{\n    match (c)\n    {\n        Plain(s) : match (TcpStream::read(s, buf, max))\n  "
    "      {\n            Ok(n)  : Ok(n),\n            Err(e) : Err(PgNetFailure(e)),\n        },\n        Se"
    "cure(s) : match (TlsStream::read(s, buf, max))\n        {\n            Ok(n)  : Ok(n),\n            Err"
    "(e) : Err(PgTlsFailure(e)),\n        },\n    }\n}fn pg_write(ref<PgConn, exclusive> c, slice<u8, shared"
    "> data) : Result<void, PgError>\n{\n    match (c)\n    {\n        Plain(s) : match (TcpStream::write(s, "
    "data))\n        {\n            Ok(_)  : Ok(()),\n            Err(e) : Err(PgNetFailure(e)),\n        },\n"
    "        Secure(s) : match (TlsStream::write(s, data))\n        {\n            Ok(_)  : Ok(()),\n       "
    "     Err(e) : Err(PgTlsFailure(e)),\n        },\n    }\n}fn pg_close(ref<PgConn, exclusive> c)\n{\n    ma"
    "tch (c)\n    {\n        Plain(s)  : { _ = TcpStream::shutdown_write(s); },\n        Secure(s) : { _ = T"
    "lsStream::close(s); },\n    }\n}fn pg_fill(ref<PgReader, exclusive> r) : Result<bool, PgError>\n{\n    i"
    "f (r.at > 0 && r.at == Vec::len(&r.buf))\n    {\n        Vec::clear(&mut r.buf);\n        r.at = 0;\n   "
    " }\n    usize n = pg_read(&mut r.conn, &mut r.buf, 16384)?;\n    Ok(n > 0)\n}fn pg_available(ref<PgRead"
    "er, shared> r) : usize\n{\n    Vec::len(&r.buf) - r.at\n}fn pg_read_n(ref<PgReader, exclusive> r, ref<V"
    "ec<u8>, exclusive> out, usize n) : Result<void, PgError>\n{\n    usize need = n;\n    while (need > 0)\n"
    "    {\n        if (pg_available(r) == 0)\n        {\n            if (!pg_fill(r)?)\n            {\n      "
    "          return Err(Disconnected);\n            }\n        }\n        usize take = min(need, pg_availa"
    "ble(r));\n        Vec::extend_from(out, &r.buf[r.at..r.at + take]);\n        r.at += take;\n        nee"
    "d -= take;\n    }\n    Ok(())\n}fn read_message(ref<PgReader, exclusive> r) : Result<Message, PgError>\n"
    "{\n    // Most messages are already whole in the buffer: taken from it at once.\n    usize avail = pg_"
    "available(r);\n    if (avail >= 5)\n    {\n        u8 kind = r.buf[r.at];\n        u32 len = read_be<u32"
    ">(&r.buf, r.at + 1);\n        if (len < 4 || widen<usize>(len) - 4 > MAX_MESSAGE)\n        {\n         "
    "   return Err(ProtocolViolation);\n        }\n        usize n = widen<usize>(len) - 4;\n        if (ava"
    "il - 5 >= n)\n        {\n            Vec<u8> body = Vec::from_slice(&r.buf[r.at + 5..r.at + 5 + n]);\n "
    "           r.at += 5 + n;\n            return Ok(Message { .kind = kind, .body = body });\n        }\n "
    "   }\n    Vec<u8> head = Vec::new();\n    pg_read_n(r, &mut head, 5)?;\n    u8 kind = head[0];\n    u32 "
    "len = read_be<u32>(&head, 1);\n    if (len < 4 || widen<usize>(len) - 4 > MAX_MESSAGE)\n    {\n        "
    "return Err(ProtocolViolation);\n    }\n    Vec<u8> body = Vec::new();\n    pg_read_n(r, &mut body, wide"
    "n<usize>(len) - 4)?;\n    Ok(Message { .kind = kind, .body = body })\n}fn frame(u8 kind, slice<u8, sha"
    "red> body) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n    Vec::push(&mut out, kind);\n    Vec::push_be"
    "(&mut out, narrow<u32>(slice_len(body) + 4));\n    Vec::extend_from(&mut out, body);\n    out\n}fn push"
    "_cstr(ref<Vec<u8>, exclusive> out, StringView s)\n{\n    Vec::extend_from(out, StringView::as_bytes(s)"
    ");\n    Vec::push(out, 0);\n}fn cstr_at(slice<u8, shared> b, ref<usize, exclusive> at) : Result<String"
    ", PgError>\n{\n    usize end = *at;\n    while (end < slice_len(b) && b[end] != 0)\n    {\n        end +="
    " 1;\n    }\n    if (end == slice_len(b))\n    {\n        return Err(ProtocolViolation);\n    }\n    Vec<u8"
    "> bytes = Vec::from_slice(&b[*at..end]);\n    *at = end + 1;\n    match (String::from_utf8(bytes))\n   "
    " {\n        Ok(s)  : Ok(s),\n        Err(_) : Err(ProtocolViolation),\n    }\n}fn decode_server_error(sl"
    "ice<u8, shared> b) : Result<PgServerError, PgError>\n{\n    PgServerError e = PgServerError { .severit"
    "y = String::new(), .code = String::new(), .message = String::new(), .detail = None, .hint = None, .p"
    "osition = None };\n    usize at = 0;\n    while (at < slice_len(b) && b[at] != 0)\n    {\n        u8 fie"
    "ld = b[at];\n        at += 1;\n        String t = cstr_at(b, &mut at)?;\n        if (field == b'S' || f"
    "ield == b'V')\n        {\n            overwrite(&mut e.severity, t);\n        }\n        else if (field "
    "== b'C')\n        {\n            overwrite(&mut e.code, t);\n        }\n        else if (field == b'M')\n"
    "        {\n            overwrite(&mut e.message, t);\n        }\n        else if (field == b'D')\n      "
    "  {\n            overwrite(&mut e.detail, Some(t));\n        }\n        else if (field == b'H')\n       "
    " {\n            overwrite(&mut e.hint, Some(t));\n        }\n        else if (field == b'P')\n        {\n"
    "            match (StringView::parse<u32>(&t))\n            {\n                Ok(p)  : overwrite(&mut"
    " e.position, Some(p)),\n                Err(_) : {},\n            }\n        }\n    }\n    Ok(e)\n}fn deco"
    "de_columns(slice<u8, shared> b) : Result<Vec<PgColumn>, PgError>\n{\n    if (slice_len(b) < 2)\n    {\n "
    "       return Err(ProtocolViolation);\n    }\n    usize n = widen<usize>(read_be<u16>(b, 0));\n    usiz"
    "e at = 2;\n    Vec<PgColumn> columns = Vec::new();\n    for (usize i = 0; i < n; i += 1)\n    {\n       "
    " String name = cstr_at(b, &mut at)?;\n        if (at + 18 > slice_len(b))\n        {\n            retur"
    "n Err(ProtocolViolation);\n        }\n        u32 type_oid = read_be<u32>(b, at + 6);\n        at += 18"
    ";\n        Vec::push(&mut columns, PgColumn { .name = name, .type_oid = type_oid });\n    }\n    Ok(col"
    "umns)\n}fn decode_row(slice<u8, shared> b) : Result<PgRow, PgError>\n{\n    if (slice_len(b) < 2)\n    {"
    "\n        return Err(ProtocolViolation);\n    }\n    usize n = widen<usize>(read_be<u16>(b, 0));\n    us"
    "ize at = 2;\n    Vec<Option<String>> cells = Vec::new();\n    for (usize i = 0; i < n; i += 1)\n    {\n "
    "       if (at + 4 > slice_len(b))\n        {\n            return Err(ProtocolViolation);\n        }\n   "
    "     i32 len = read_be<i32>(b, at);\n        at += 4;\n        if (len < 0)\n        {\n            Vec:"
    ":push(&mut cells, None);\n            continue;\n        }\n        usize size = narrow<usize>(len);\n  "
    "      if (at + size > slice_len(b))\n        {\n            return Err(ProtocolViolation);\n        }\n "
    "       Vec<u8> bytes = Vec::from_slice(&b[at..at + size]);\n        at += size;\n        match (String"
    "::from_utf8(bytes))\n        {\n            Ok(s)  : Vec::push(&mut cells, Some(s)),\n            Err(_"
    ") : return Err(ProtocolViolation),\n        }\n    }\n    Ok(PgRow { .cells = cells })\n}fn open_tcp(Str"
    "ingView host, u16 port, u64 timeout_ms) : Result<TcpStream, PgError>\n{\n    Vec<SocketAddr> addrs = m"
    "atch (IpAddr::parse(host))\n    {\n        Ok(ip) :\n        {\n            Vec<SocketAddr> one = Vec::n"
    "ew();\n            Vec::push(&mut one, SocketAddr::new(ip, port));\n            one\n        },\n       "
    " Err(_) : match (resolve(host, port))\n        {\n            Ok(a)  : a,\n            Err(e) : return "
    "Err(PgNetFailure(e)),\n        },\n    };\n    if (Vec::len(&addrs) == 0)\n    {\n        return Err(PgNe"
    "tFailure(UnknownHost));\n    }\n    NetError last = Failed;\n    for (usize i = 0; i < Vec::len(&addrs)"
    "; i += 1)\n    {\n        TcpStream tcp = match (TcpStream::connect_timeout(addrs[i], timeout_ms))\n   "
    "     {\n            Ok(t)  : t,\n            Err(e) :\n            {\n                last = e;\n        "
    "        continue;\n            },\n        };\n        TcpStream::set_read_timeout_ms(&mut tcp, timeout"
    "_ms);\n        TcpStream::set_write_timeout_ms(&mut tcp, timeout_ms);\n        TcpStream::set_nodelay("
    "&mut tcp, true);\n        return Ok(tcp);\n    }\n    Err(PgNetFailure(last))\n}export fn PgConnection::"
    "connect(StringView url) : Result<PgConnection, PgError>\n{\n    PgUrl u = PgUrl::parse(url)?;\n    Trus"
    "tStore roots = match (u.sslmode)\n    {\n        Disable : TrustStore::new(),\n        VerifyFull : mat"
    "ch (TrustStore::system())\n        {\n            Ok(t)  : t,\n            Err(_) : return Err(NoTruste"
    "dRoots),\n        },\n    };\n    connect_url(&u, &roots, 30000)\n}export fn PgConnection::connect_with("
    "\n    StringView url,\n    ref<TrustStore, shared> roots,\n    u64 timeout_ms,\n) : Result<PgConnection,"
    " PgError>\n{\n    PgUrl u = PgUrl::parse(url)?;\n    connect_url(&u, roots, timeout_ms)\n}fn connect_url"
    "(ref<PgUrl, shared> u, ref<TrustStore, shared> roots, u64 timeout_ms) : Result<PgConnection, PgError"
    ">\n{\n    TcpStream tcp = open_tcp(&u.host, u.port, timeout_ms)?;\n    bool secure = false;\n    PgConn "
    "conn = match (u.sslmode)\n    {\n        Disable    : Plain(tcp),\n        VerifyFull :\n        {\n     "
    "       // SSLRequest: the server answers S (go ahead) or N (no TLS).\n            Vec<u8> req = Vec::"
    "new();\n            Vec::push_be<u32>(&mut req, 8);\n            Vec::push_be<u32>(&mut req, 80877103)"
    ";\n            match (TcpStream::write(&mut tcp, &req))\n            {\n                Ok(_)  : {},\n  "
    "              Err(e) : return Err(PgNetFailure(e)),\n            }\n            Vec<u8> answer = Vec::"
    "new();\n            match (TcpStream::read_exact(&mut tcp, &mut answer, 1))\n            {\n           "
    "     Ok(_)  : {},\n                Err(e) : return Err(PgNetFailure(e)),\n            }\n            if"
    " (answer[0] == b'N')\n            {\n                return Err(TlsRefused);\n            }\n           "
    " if (answer[0] != b'S')\n            {\n                return Err(ProtocolViolation);\n            }\n "
    "           secure = true;\n            match (TlsStream::client(tcp, &u.host, roots))\n            {\n "
    "               Ok(s)  : Secure(s),\n                Err(e) : return Err(PgTlsFailure(e)),\n           "
    " }\n        },\n    };\n    PgConnection c = PgConnection { .reader = PgReader { .conn = conn, .buf = V"
    "ec::new(), .at = 0 }, .secure = secure, .closed = false, .parameters = Vec::new(), .backend_pid = 0,"
    " .backend_key = 0, .notices = Vec::new(), .max_result = 16777216 };\n    // StartupMessage: protocol "
    "3.0, the user, the database, UTF-8.\n    Vec<u8> body = Vec::new();\n    Vec::push_be<u32>(&mut body, "
    "196608);\n    push_cstr(&mut body, \"user\");\n    push_cstr(&mut body, &u.user);\n    push_cstr(&mut bod"
    "y, \"database\");\n    push_cstr(&mut body, &u.database);\n    push_cstr(&mut body, \"client_encoding\");\n"
    "    push_cstr(&mut body, \"UTF8\");\n    Vec::push(&mut body, 0);\n    Vec<u8> startup = Vec::new();\n   "
    " Vec::push_be(&mut startup, narrow<u32>(Vec::len(&body) + 4));\n    Vec::extend_from(&mut startup, &b"
    "ody);\n    match (pg_write(&mut c.reader.conn, &startup))\n    {\n        Ok(_)  : {},\n        Err(e) :"
    " return Err(e),\n    }\n    match (authenticate(&mut c, u))\n    {\n        Ok(_)  : Ok(c),\n        Err("
    "e) :\n        {\n            pg_close(&mut c.reader.conn);\n            Err(e)\n        },\n    }\n}fn aut"
    "henticate(ref<PgConnection, exclusive> c, ref<PgUrl, shared> u) : Result<void, PgError>\n{\n    Option"
    "<Scram> scram = None;\n    // Once SCRAM has begun, AuthenticationOk counts only after the\n    // ser"
    "ver's signature was verified ([Pg-Auth]): a server that skips\n    // its final message has not prove"
    "d it knows the password.\n    bool scram_begun = false;\n    bool scram_verified = false;\n    String p"
    "assword = match (&u.password)\n    {\n        Some(p) : String::clone(p),\n        None    : String::ne"
    "w(),\n    };\n    while (true)\n    {\n        Message m = read_message(&mut c.reader)?;\n        slice<u"
    "8, shared> b = &m.body;\n        if (m.kind == b'R')\n        {\n            if (slice_len(b) < 4)\n    "
    "        {\n                return Err(ProtocolViolation);\n            }\n            u32 code = read_b"
    "e<u32>(b, 0);\n            if (code == 0)\n            {\n                if (scram_begun && !scram_ver"
    "ified)\n                {\n                    return Err(AuthFailed);\n                }\n             "
    "   continue;\n            }\n            else if (code == 3)\n            {\n                if (!c.secu"
    "re)\n                {\n                    return Err(AuthRefused);\n                }\n               "
    " Vec<u8> pw = Vec::new();\n                push_cstr(&mut pw, &password);\n                pg_write(&m"
    "ut c.reader.conn, &frame(b'p', &pw))?;\n            }\n            else if (code == 10)\n            {\n"
    "                bool offered = false;\n                usize at = 4;\n                while (at < slic"
    "e_len(b) && b[at] != 0)\n                {\n                    String mech = cstr_at(b, &mut at)?;\n  "
    "                  if (mech == \"SCRAM-SHA-256\")\n                    {\n                        offered"
    " = true;\n                    }\n                }\n                if (!offered)\n                {\n   "
    "                 return Err(UnsupportedAuth);\n                }\n                array<u8, 18> raw = "
    "[0; 18];\n                os_random_bytes(&mut raw);\n                String nonce = base64_encode(&ra"
    "w);\n                Scram s = Scram::start(\"\", &nonce);\n                String first = Scram::client"
    "_first(&s);\n                Vec<u8> body = Vec::new();\n                push_cstr(&mut body, \"SCRAM-S"
    "HA-256\");\n                Vec::push_be(&mut body, narrow<u32>(StringView::len(&first)));\n           "
    "     Vec::extend_from(&mut body, StringView::as_bytes(&first));\n                pg_write(&mut c.read"
    "er.conn, &frame(b'p', &body))?;\n                overwrite(&mut scram, Some(s));\n                scra"
    "m_begun = true;\n            }\n            else if (code == 11)\n            {\n                String "
    "server_first = match (String::from_utf8(Vec::from_slice(&b[4..$])))\n                {\n              "
    "      Ok(s)  : s,\n                    Err(_) : return Err(ProtocolViolation),\n                };\n   "
    "             String client_final = match (&mut scram)\n                {\n                    Some(s) "
    ": Scram::respond(s, &server_first, &password)?,\n                    None    : return Err(ProtocolVio"
    "lation),\n                };\n                pg_write(&mut c.reader.conn, &frame(b'p', StringView::as"
    "_bytes(&client_final)))?;\n            }\n            else if (code == 12)\n            {\n             "
    "   String server_final = match (String::from_utf8(Vec::from_slice(&b[4..$])))\n                {\n    "
    "                Ok(s)  : s,\n                    Err(_) : return Err(ProtocolViolation),\n            "
    "    };\n                bool ok = match (&scram)\n                {\n                    Some(s) : Scra"
    "m::verify(s, &server_final),\n                    None    : false,\n                };\n               "
    " if (!ok)\n                {\n                    return Err(AuthFailed);\n                }\n          "
    "      scram_verified = true;\n            }\n            else\n            {\n                return Err"
    "(UnsupportedAuth);\n            }\n        }\n        else if (m.kind == b'S')\n        {\n            us"
    "ize at = 0;\n            String name = cstr_at(b, &mut at)?;\n            String value = cstr_at(b, &m"
    "ut at)?;\n            Vec::push(&mut c.parameters, PgParameter { .name = name, .value = value });\n   "
    "     }\n        else if (m.kind == b'K')\n        {\n            if (slice_len(b) < 8)\n            {\n  "
    "              return Err(ProtocolViolation);\n            }\n            c.backend_pid = read_be<u32>("
    "b, 0);\n            c.backend_key = read_be<u32>(b, 4);\n        }\n        else if (m.kind == b'Z')\n  "
    "      {\n            return Ok(());\n        }\n        else if (m.kind == b'E')\n        {\n            "
    "PgServerError e = decode_server_error(b)?;\n            return Err(if (StringView::starts_with(&e.cod"
    "e, \"28\")) { AuthFailed } else { Server(e) });\n        }\n        else if (m.kind == b'N')\n        {\n "
    "           Vec::push(&mut c.notices, decode_server_error(b)?);\n        }\n        else\n        {\n    "
    "        return Err(ProtocolViolation);\n        }\n    }\n}export fn PgConnection::parameter(ref<PgConn"
    "ection, shared> c, StringView name) : Option<StringView> from c\n{\n    foreach (p in &c.parameters)\n "
    "   {\n        if (p.name == name)\n        {\n            return Some(&p.value);\n        }\n    }\n    No"
    "ne\n}fn broken(ref<PgConnection, exclusive> c, PgError e) : PgError\n{\n    c.closed = true;\n    e\n}fn "
    "collect(ref<PgConnection, exclusive> c, bool keep) : Result<PgResult, PgError>\n{\n    PgResult res = "
    "PgResult { .columns = Vec::new(), .rows = Vec::new(), .affected = 0, .tag = String::new() };\n    Opt"
    "ion<PgServerError> failure = None;\n    bool too_large = false;\n    usize bytes = 0;\n    while (true)"
    "\n    {\n        Message m = match (read_message(&mut c.reader))\n        {\n            Ok(msg) : msg,\n"
    "            Err(e)  : return Err(broken(c, e)),\n        };\n        slice<u8, shared> b = &m.body;\n  "
    "      if (m.kind == b'T')\n        {\n            match (decode_columns(b))\n            {\n            "
    "    Ok(cols) : overwrite(&mut res.columns, cols),\n                Err(e)   : return Err(broken(c, e)"
    "),\n            }\n        }\n        else if (m.kind == b'D')\n        {\n            if (keep && !too_l"
    "arge)\n            {\n                bytes += slice_len(b);\n                if (bytes > c.max_result)"
    "\n                {\n                    too_large = true;\n                    Vec::clear(&mut res.row"
    "s);\n                }\n                else\n                {\n                    match (decode_row(b"
    "))\n                    {\n                        Ok(row) : Vec::push(&mut res.rows, row),\n          "
    "              Err(e)  : return Err(broken(c, e)),\n                    }\n                }\n          "
    "  }\n        }\n        else if (m.kind == b'C')\n        {\n            usize at = 0;\n            Strin"
    "g tag = match (cstr_at(b, &mut at))\n            {\n                Ok(t)  : t,\n                Err(e)"
    " : return Err(broken(c, e)),\n            };\n            res.affected = tag_count(&tag);\n            "
    "overwrite(&mut res.tag, tag);\n        }\n        else if (m.kind == b'E')\n        {\n            PgSer"
    "verError reported = match (decode_server_error(b))\n            {\n                Ok(se) : se,\n      "
    "          Err(e) : return Err(broken(c, e)),\n            };\n            if (Option::is_none(&failure"
    "))\n            {\n                overwrite(&mut failure, Some(reported));\n            }\n        }\n  "
    "      else if (m.kind == b'N')\n        {\n            match (decode_server_error(b))\n            {\n  "
    "              Ok(se) : Vec::push(&mut c.notices, se),\n                Err(e) : return Err(broken(c, "
    "e)),\n            }\n        }\n        else if (m.kind == b'Z')\n        {\n            break;\n        }"
    "\n        else if (m.kind == b'1' || m.kind == b'2' || m.kind == b'n' || m.kind == b'I' || m.kind == "
    "b's' || m.kind == b'A' || m.kind == b'S')\n        {\n            // ParseComplete, BindComplete, NoDa"
    "ta, EmptyQueryResponse,\n            // PortalSuspended, a notification, a parameter changed.\n       "
    "     continue;\n        }\n        else\n        {\n            return Err(broken(c, ProtocolViolation))"
    ";\n        }\n    }\n    if (Some(e) = failure)\n    {\n        return Err(Server(e));\n    }\n    if (too_"
    "large)\n    {\n        return Err(ResultTooLarge);\n    }\n    Ok(res)\n}export fn PgConnection::query(\n "
    "   ref<PgConnection, exclusive> c,\n    StringView sql,\n    slice<PgValue, shared> params,\n) : Result"
    "<PgResult, PgError>\n{\n    if (c.closed)\n    {\n        return Err(Disconnected);\n    }\n    if (slice_"
    "len(params) > 65535)\n    {\n        return Err(ResultTooLarge);\n    }\n    Vec<u8> out = Vec::new();\n "
    "   Vec<u8> parse = Vec::new();\n    push_cstr(&mut parse, \"\");\n    push_cstr(&mut parse, sql);\n    Ve"
    "c::push_be<u16>(&mut parse, 0);\n    Vec::extend_from(&mut out, &frame(b'P', &parse));\n    Vec<u8> bi"
    "nd = Vec::new();\n    push_cstr(&mut bind, \"\");\n    push_cstr(&mut bind, \"\");\n    Vec::push_be<u16>(&"
    "mut bind, 0);\n    Vec::push_be(&mut bind, narrow<u16>(slice_len(params)));\n    foreach (p in params)"
    "\n    {\n        match (PgValue::text(p))\n        {\n            Some(t) :\n            {\n              "
    "  Vec::push_be(&mut bind, narrow<u32>(StringView::len(&t)));\n                Vec::extend_from(&mut b"
    "ind, StringView::as_bytes(&t));\n            },\n            None    : Vec::push_be<i32>(&mut bind, -1"
    "),\n        }\n    }\n    Vec::push_be<u16>(&mut bind, 0);\n    Vec::extend_from(&mut out, &frame(b'B', "
    "&bind));\n    Vec<u8> describe = Vec::new();\n    Vec::push(&mut describe, b'P');\n    Vec::push(&mut d"
    "escribe, 0);\n    Vec::extend_from(&mut out, &frame(b'D', &describe));\n    Vec<u8> execute = Vec::new"
    "();\n    push_cstr(&mut execute, \"\");\n    Vec::push_be<u32>(&mut execute, 0);\n    Vec::extend_from(&m"
    "ut out, &frame(b'E', &execute));\n    Vec<u8> none = Vec::new();\n    Vec::extend_from(&mut out, &fram"
    "e(b'S', &none));\n    match (pg_write(&mut c.reader.conn, &out))\n    {\n        Ok(_)  : {},\n        E"
    "rr(e) : return Err(broken(c, e)),\n    }\n    collect(c, true)\n}export fn PgConnection::execute(\n    r"
    "ef<PgConnection, exclusive> c,\n    StringView sql,\n    slice<PgValue, shared> params,\n) : Result<u64"
    ", PgError>\n{\n    PgResult r = PgConnection::query(c, sql, params)?;\n    Ok(r.affected)\n}export fn Pg"
    "Connection::run_script(ref<PgConnection, exclusive> c, StringView sql) : Result<void, PgError>\n{\n   "
    " if (c.closed)\n    {\n        return Err(Disconnected);\n    }\n    Vec<u8> q = Vec::new();\n    push_cs"
    "tr(&mut q, sql);\n    match (pg_write(&mut c.reader.conn, &frame(b'Q', &q)))\n    {\n        Ok(_)  : {"
    "},\n        Err(e) : return Err(broken(c, e)),\n    }\n    _ = collect(c, false)?;\n    Ok(())\n}export f"
    "n PgConnection::close(ref<PgConnection, exclusive> c)\n{\n    if (!c.closed)\n    {\n        Vec<u8> non"
    "e = Vec::new();\n        _ = pg_write(&mut c.reader.conn, &frame(b'X', &none));\n        pg_close(&mut"
    " c.reader.conn);\n        c.closed = true;\n    }\n}fn JsonReader::peek(ref<JsonReader, shared> r) : u8"
    "\n{\n    if (r.at < StringView::len(r.text))\n    {\n        return r.text.bytes[r.at];\n    }\n    0\n}fn "
    "json_space_end(slice<u8, shared> b, usize at) : usize\n{\n    usize i = at;\n    while (i < slice_len(b"
    ") && (b[i] == b' ' || b[i] == b'\\t' || b[i] == b'\\n' || b[i] == b'\\r'))\n    {\n        i += 1;\n    }\n"
    "    i\n}fn json_digits_end(slice<u8, shared> b, usize at) : usize\n{\n    usize i = at;\n    while (i < "
    "slice_len(b) && ascii_is_digit(b[i]))\n    {\n        i += 1;\n    }\n    i\n}fn JsonReader::skip_space(r"
    "ef<JsonReader, exclusive> r)\n{\n    r.at = json_space_end(r.text.bytes, r.at);\n}fn JsonReader::word(r"
    "ef<JsonReader, exclusive> r, str word) : bool\n{\n    usize n = str_len(word);\n    if (r.at + n > Stri"
    "ngView::len(r.text))\n    {\n        return false;\n    }\n    for (usize i = 0; i < n; i += 1)\n    {\n  "
    "      if (r.text.bytes[r.at + i] != str_byte(word, i))\n        {\n            return false;\n        }"
    "\n    }\n    r.at += n;\n    true\n}fn JsonReader::digits(ref<JsonReader, exclusive> r) : usize\n{\n    us"
    "ize start = r.at;\n    r.at = json_digits_end(r.text.bytes, r.at);\n    r.at - start\n}fn JsonReader::n"
    "umber(ref<JsonReader, exclusive> r) : Result<Json, ParseError>\n{\n    usize start = r.at;\n    if (Jso"
    "nReader::peek(r) == b'-')\n    {\n        r.at += 1;\n    }\n    if (JsonReader::peek(r) == b'0')\n    {\n"
    "        r.at += 1;\n    }\n    else if (JsonReader::digits(r) == 0)\n    {\n        return Err(Invalid(r"
    ".at));\n    }\n    if (JsonReader::peek(r) == b'.')\n    {\n        r.at += 1;\n        if (JsonReader::d"
    "igits(r) == 0)\n        {\n            return Err(Invalid(r.at));\n        }\n    }\n    u8 e = JsonReade"
    "r::peek(r);\n    if (e == b'e' || e == b'E')\n    {\n        r.at += 1;\n        u8 sign = JsonReader::p"
    "eek(r);\n        if (sign == b'+' || sign == b'-')\n        {\n            r.at += 1;\n        }\n       "
    " if (JsonReader::digits(r) == 0)\n        {\n            return Err(Invalid(r.at));\n        }\n    }\n  "
    "  match (StringView::parse<f64>(&r.text[start..r.at]))\n    {\n        Ok(v)  : Ok(JsonNumber(v)),\n   "
    "     Err(_) : Err(OutOfRange),\n    }\n}fn JsonReader::text(ref<JsonReader, exclusive> r) : Result<Str"
    "ing, ParseError>\n{\n    JsonStr { bytes, pos, err } = json_string(r.text.bytes, r.at);\n    r.at = pos"
    ";\n    if (err > 0)\n    {\n        return Err(Invalid(err - 1));\n    }\n    // Runs of the (UTF-8) text"
    " and encoded code points: well-formed.\n    match (String::from_utf8(bytes))\n    {\n        Ok(s)  : O"
    "k(s),\n        Err(_) : Err(Invalid(pos)),\n    }\n}fn json_hex4(array<u8, 4> q, usize at) : i64\n{\n    "
    "i64 v = 0;\n    for (usize i = 0; i < 4; i += 1)\n    {\n        usize p = at + i;\n        u8 c = q[i];"
    "\n        i64 d = if (c >= b'0' && c <= b'9') { widen<i64>(c - b'0') }\n        else if (c >= b'a' && "
    "c <= b'f') { widen<i64>(c - b'a') + 10 }\n        else if (c >= b'A' && c <= b'F') { widen<i64>(c - b"
    "'A') + 10 }\n        else { return -1 - narrow<i64>(p); };\n        v = v * 16 + d;\n    }\n    v\n}fn js"
    "on_string(slice<u8, shared> b, usize start) : JsonStr\n{\n    Vec<u8> out = Vec::new();\n    usize n = "
    "slice_len(b);\n    usize at = start;\n    usize err = 0;\n    while (true)\n    {\n        if (at >= n)\n "
    "       {\n            err = n + 1;\n            break;\n        }\n        u8 c = b[at];\n        if (c ="
    "= b'\"')\n        {\n            at += 1;\n            break;\n        }\n        if (c < 0x20)\n        {\n"
    "            err = at + 1;\n            break;\n        }\n        if (c != b'\\\\')\n        {\n           "
    " Vec::push(&mut out, c);\n            at += 1;\n            continue;\n        }\n        at += 1;\n     "
    "   u8 e = if (at < n) { b[at] } else { 0 };\n        at += 1;\n        if (e == b'\"') { Vec::push(&mut"
    " out, b'\"'); }\n        else if (e == b'\\\\') { Vec::push(&mut out, b'\\\\'); }\n        else if (e == b'"
    "/') { Vec::push(&mut out, b'/'); }\n        else if (e == b'b') { Vec::push(&mut out, 8); }\n        e"
    "lse if (e == b'f') { Vec::push(&mut out, 12); }\n        else if (e == b'n') { Vec::push(&mut out, 10"
    "); }\n        else if (e == b'r') { Vec::push(&mut out, 13); }\n        else if (e == b't') { Vec::pus"
    "h(&mut out, 9); }\n        else if (e == b'u')\n        {\n            array<u8, 4> q = [0; 4];\n       "
    "     for (usize k = 0; k < 4 && at + k < n; k += 1)\n            {\n                q[k] = b[at + k];\n"
    "            }\n            i64 h = json_hex4(q, at);\n            if (h < 0)\n            {\n           "
    "     err = narrow<usize>(0 - h);\n                break;\n            }\n            at += 4;\n         "
    "   u32 cp = narrow<u32>(h);\n            if (cp >= 0xD800 && cp <= 0xDBFF)\n            {\n            "
    "    // A high surrogate: joined with a `\\uDC00`..`\\uDFFF` that\n                // follows; alone, U+"
    "FFFD.\n                usize save = at;\n                bool joined = false;\n                if (at <"
    " n && b[at] == b'\\\\')\n                {\n                    at += 1;\n                    if (at < n "
    "&& b[at] == b'u')\n                    {\n                        at += 1;\n                        arr"
    "ay<u8, 4> q2 = [0; 4];\n                        for (usize k = 0; k < 4 && at + k < n; k += 1)\n      "
    "                  {\n                            q2[k] = b[at + k];\n                        }\n       "
    "                 i64 lo = json_hex4(q2, at);\n                        if (lo < 0)\n                   "
    "     {\n                            err = narrow<usize>(0 - lo);\n                            break;\n "
    "                       }\n                        at += 4;\n                        u32 low = narrow<u"
    "32>(lo);\n                        if (low >= 0xDC00 && low <= 0xDFFF)\n                        {\n     "
    "                       cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00);\n                      "
    "      joined = true;\n                        }\n                    }\n                }\n             "
    "   if (!joined)\n                {\n                    at = save;\n                    cp = 0xFFFD;\n  "
    "              }\n            }\n            // As `String::push_code_point`: a surrogate is U+FFFD.\n  "
    "          u32 u = if (cp >= 0xD800 && cp <= 0xDFFF) { 0xFFFD } else { cp };\n            if (u < 0x80"
    ")\n            {\n                Vec::push(&mut out, narrow<u8>(u));\n            }\n            else i"
    "f (u < 0x800)\n            {\n                Vec::push(&mut out, 0xC0 | narrow<u8>(u >> 6));\n        "
    "        Vec::push(&mut out, 0x80 | narrow<u8>(u & 0x3F));\n            }\n            else if (u < 0x1"
    "0000)\n            {\n                Vec::push(&mut out, 0xE0 | narrow<u8>(u >> 12));\n               "
    " Vec::push(&mut out, 0x80 | narrow<u8>((u >> 6) & 0x3F));\n                Vec::push(&mut out, 0x80 |"
    " narrow<u8>(u & 0x3F));\n            }\n            else\n            {\n                Vec::push(&mut "
    "out, 0xF0 | narrow<u8>(u >> 18));\n                Vec::push(&mut out, 0x80 | narrow<u8>((u >> 12) & "
    "0x3F));\n                Vec::push(&mut out, 0x80 | narrow<u8>((u >> 6) & 0x3F));\n                Vec"
    "::push(&mut out, 0x80 | narrow<u8>(u & 0x3F));\n            }\n        }\n        else\n        {\n      "
    "      err = at;\n            break;\n        }\n    }\n    JsonStr { .bytes = out, .pos = at, .err = err"
    " }\n}fn JsonReader::value(ref<JsonReader, exclusive> r, usize depth) : Result<Json, ParseError>\n{\n   "
    " JsonReader::skip_space(r);\n    u8 b = JsonReader::peek(r);\n    if (b == b'{')\n    {\n        if (dep"
    "th >= MAX_DEPTH)\n        {\n            return Err(OutOfRange);\n        }\n        r.at += 1;\n        "
    "Vec<JsonMember> members = Vec::new();\n        JsonReader::skip_space(r);\n        if (JsonReader::pee"
    "k(r) == b'}')\n        {\n            r.at += 1;\n            return Ok(JsonObject(members));\n        }"
    "\n        while (true)\n        {\n            JsonReader::skip_space(r);\n            if (JsonReader::p"
    "eek(r) != b'\"')\n            {\n                return Err(Invalid(r.at));\n            }\n            r"
    ".at += 1;\n            String key = JsonReader::text(r)?;\n            JsonReader::skip_space(r);\n    "
    "        if (JsonReader::peek(r) != b':')\n            {\n                return Err(Invalid(r.at));\n  "
    "          }\n            r.at += 1;\n            Json v = JsonReader::value(r, depth + 1)?;\n          "
    "  Vec::push(&mut members, JsonMember { .key = key, .value = v });\n            JsonReader::skip_space"
    "(r);\n            u8 c = JsonReader::peek(r);\n            r.at += 1;\n            if (c == b'}')\n     "
    "       {\n                return Ok(JsonObject(members));\n            }\n            if (c != b',')\n  "
    "          {\n                return Err(Invalid(r.at - 1));\n            }\n        }\n    }\n    if (b ="
    "= b'[')\n    {\n        if (depth >= MAX_DEPTH)\n        {\n            return Err(OutOfRange);\n        "
    "}\n        r.at += 1;\n        Vec<Json> items = Vec::new();\n        JsonReader::skip_space(r);\n      "
    "  if (JsonReader::peek(r) == b']')\n        {\n            r.at += 1;\n            return Ok(JsonArray("
    "items));\n        }\n        while (true)\n        {\n            Json v = JsonReader::value(r, depth + "
    "1)?;\n            Vec::push(&mut items, v);\n            JsonReader::skip_space(r);\n            u8 c ="
    " JsonReader::peek(r);\n            r.at += 1;\n            if (c == b']')\n            {\n              "
    "  return Ok(JsonArray(items));\n            }\n            if (c != b',')\n            {\n              "
    "  return Err(Invalid(r.at - 1));\n            }\n        }\n    }\n    if (b == b'\"')\n    {\n        r.at"
    " += 1;\n        return Ok(JsonText(JsonReader::text(r)?));\n    }\n    if (b == b'-' || ascii_is_digit("
    "b))\n    {\n        return JsonReader::number(r);\n    }\n    if (JsonReader::word(r, \"true\"))\n    {\n   "
    "     return Ok(JsonBool(true));\n    }\n    if (JsonReader::word(r, \"false\"))\n    {\n        return Ok("
    "JsonBool(false));\n    }\n    if (JsonReader::word(r, \"null\"))\n    {\n        return Ok(JsonNull);\n    "
    "}\n    Err(Invalid(r.at))\n}export fn Json::parse(StringView text) : Result<Json, ParseError>\n{\n    Js"
    "onReader r = JsonReader { .text = text, .at = 0 };\n    JsonReader::skip_space(&mut r);\n    if (r.at "
    ">= StringView::len(text))\n    {\n        return Err(Empty);\n    }\n    Json v = JsonReader::value(&mut"
    " r, 0)?;\n    JsonReader::skip_space(&mut r);\n    if (r.at < StringView::len(text))\n    {\n        ret"
    "urn Err(Invalid(r.at));\n    }\n    Ok(v)\n}unittest \"Json::parse: where the error is\"\n{\n    match (Jso"
    "n::parse(\"[1, 2\"))\n    {\n        Err(Invalid(i)) : assert(i == 5),\n        _               : assert("
    "false),\n    }\n    match (Json::parse(\"[1] x\"))\n    {\n        Err(Invalid(i)) : assert(i == 4),\n     "
    "   _               : assert(false),\n    }\n}fn json_quote(ref<String, exclusive> out, StringView s)\n{"
    "\n    Vec<u8> o = replace(&mut out.bytes, Vec::new());\n    overwrite(&mut out.bytes, json_quote_bytes"
    "(o, s.bytes));\n}fn json_quote_bytes(Vec<u8> out, slice<u8, shared> s) : Vec<u8>\n{\n    str digits = \""
    "0123456789abcdef\";\n    Vec::push(&mut out, b'\"');\n    for (usize i = 0; i < slice_len(s); i += 1)\n  "
    "  {\n        u8 b = s[i];\n        if (b >= 0x20 && b != b'\"' && b != b'\\\\')\n        {\n            Vec"
    "::push(&mut out, b);\n            continue;\n        }\n        Vec::push(&mut out, b'\\\\');\n        if "
    "(b == b'\"') { Vec::push(&mut out, b'\"'); }\n        else if (b == b'\\\\') { Vec::push(&mut out, b'\\\\')"
    "; }\n        else if (b == 10) { Vec::push(&mut out, b'n'); }\n        else if (b == 13) { Vec::push(&"
    "mut out, b'r'); }\n        else if (b == 9) { Vec::push(&mut out, b't'); }\n        else if (b == 8) {"
    " Vec::push(&mut out, b'b'); }\n        else if (b == 12) { Vec::push(&mut out, b'f'); }\n        else\n"
    "        {\n            Vec::push(&mut out, b'u');\n            Vec::push(&mut out, b'0');\n            "
    "Vec::push(&mut out, b'0');\n            Vec::push(&mut out, str_byte(digits, widen<usize>(b >> 4)));\n"
    "            Vec::push(&mut out, str_byte(digits, widen<usize>(b & 15)));\n        }\n    }\n    Vec::pu"
    "sh(&mut out, b'\"');\n    out\n}fn json_number(ref<String, exclusive> out, f64 x)\n{\n    if (!is_finite("
    "x))\n    {\n        String::append(out, \"null\");\n        return;\n    }\n    if (x == trunc(x) && x < 90"
    "07199254740992.0 && x > -9007199254740992.0)\n    {\n        String::append(out, to_int<i64>(x));\n    "
    "    return;\n    }\n    String::append(out, x);\n}fn json_indent(ref<String, exclusive> out, usize dept"
    "h)\n{\n    String::push_ascii(out, 10);\n    for (usize i = 0; i < depth; i += 1)\n    {\n        String:"
    ":append(out, \"  \");\n    }\n}fn json_write(ref<String, exclusive> out, ref<Json, shared> j, bool inden"
    "t, usize depth)\n{\n    match (j)\n    {\n        JsonNull            : String::append(out, \"null\"),\n   "
    "     JsonBool(b)         : String::append(out, if (*b) { \"true\" } else { \"false\" }),\n        JsonNum"
    "ber(x)       : json_number(out, *x),\n        JsonText(s)         : json_quote(out, s),\n        JsonA"
    "rray(items)    :\n        {\n            String::push_ascii(out, b'[');\n            for (usize i = 0; "
    "i < Vec::len(items); i += 1)\n            {\n                if (i > 0)\n                {\n            "
    "        String::push_ascii(out, b',');\n                }\n                if (indent)\n               "
    " {\n                    json_indent(out, depth + 1);\n                }\n                json_write(out"
    ", &items[i], indent, depth + 1);\n            }\n            if (indent && Vec::len(items) > 0)\n      "
    "      {\n                json_indent(out, depth);\n            }\n            String::push_ascii(out, b"
    "']');\n        },\n        JsonObject(members) :\n        {\n            String::push_ascii(out, b'{');\n"
    "            for (usize i = 0; i < Vec::len(members); i += 1)\n            {\n                if (i > 0"
    ")\n                {\n                    String::push_ascii(out, b',');\n                }\n           "
    "     if (indent)\n                {\n                    json_indent(out, depth + 1);\n                "
    "}\n                json_quote(out, &members[i].key);\n                String::append(out, if (indent) "
    "{ \": \" } else { \":\" });\n                json_write(out, &members[i].value, indent, depth + 1);\n     "
    "       }\n            if (indent && Vec::len(members) > 0)\n            {\n                json_indent("
    "out, depth);\n            }\n            String::push_ascii(out, b'}');\n        },\n    }\n}export fn Js"
    "on::text(ref<Json, shared> j) : String\n{\n    String out = String::new();\n    json_write(&mut out, j,"
    " false, 0);\n    out\n}export fn Json::pretty(ref<Json, shared> j) : String\n{\n    String out = String:"
    ":new();\n    json_write(&mut out, j, true, 0);\n    out\n}unittest \"Json::pretty: the layout\"\n{\n    Jso"
    "n a = JsonArray(Vec::new());\n    Json::push(&mut a, JsonNull);\n    Json::push(&mut a, JsonText(\"x\"))"
    ";\n    String p = Json::pretty(&a);\n    assert(p == \"[\\n  null,\\n  \\\"x\\\"\\n]\");\n}export fn Json::get(r"
    "ef<Json, shared> j, StringView key) : Option<ref<Json, shared>> from j\n{\n    match (j)\n    {\n       "
    " JsonObject(members) :\n        {\n            for (usize i = 0; i < Vec::len(members); i += 1)\n      "
