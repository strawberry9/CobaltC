    "ng::copy(part), if (last) { K_HEADER } else { K_IMPLICIT }, TomlBool(false)),\n            );\n       "
    "     if (last)\n            {\n                return true;\n            }\n            Vec::len(&n.memb"
    "ers) - 1\n        },\n    };\n    u8 kind = n.members[k].kind;\n    if (kind == K_VALUE)\n    {\n        r"
    "eturn false;\n    }\n    if (last)\n    {\n        if (is_array)\n        {\n            if (kind != K_ARR"
    "AY)\n            {\n                return false;\n            }\n            Vec::push(&mut n.members[k"
    "].members, tnode_new(String::new(), K_HEADER, TomlBool(false)));\n            return true;\n        }\n"
    "        if (kind != K_IMPLICIT)\n        {\n            return false;\n        }\n        n.members[k].k"
    "ind = K_HEADER;\n        return true;\n    }\n    if (kind == K_ARRAY)\n    {\n        usize e = Vec::len"
    "(&n.members[k].members) - 1;\n        return tnode_define(&mut n.members[k].members[e], path, i + 1, "
    "is_array);\n    }\n    tnode_define(&mut n.members[k], path, i + 1, is_array)\n}fn tnode_insert(\n    re"
    "f<TNode, exclusive> n,\n    ref<Vec<String>, shared> ctx,\n    usize ci,\n    ref<Vec<String>, shared> "
