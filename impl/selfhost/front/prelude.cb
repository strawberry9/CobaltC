    "al(\n    slice<u8, shared> key,\n    slice<u8, shared> nonce,\n    slice<u8, shared> aad,\n    slice<u8,"
    " shared> plaintext,\n) : Vec<u8>\n{\n    array<u8, 16> j0 = gcm_j0(nonce);\n    AesKey k = aes_expand(ke"
    "y);\n    Vec<u8> out = gcm_ctr(&k, j0, plaintext);\n    array<u8, 16> tag = gcm_tag(&k, j0, aad, &out)"
