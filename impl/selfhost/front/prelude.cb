    "array<u32, 5> out = h;\n    out[0] = wrapping_add(h[0], a);\n    out[1] = wrapping_add(h[1], b);\n    o"
    "ut[2] = wrapping_add(h[2], c);\n    out[3] = wrapping_add(h[3], d);\n    out[4] = wrapping_add(h[4], e"
    ");\n    out\n}fn sha1_absorb(Sha1 s, slice<u8, shared> data) : Sha1\n{\n    usize n = slice_len(data);\n "
    "   usize i = 0;\n    while (i < n)\n    {\n        if (s.fill == 0 && n - i >= 64)\n        {\n          "
