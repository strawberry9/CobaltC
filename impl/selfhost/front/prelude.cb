    " {\n            event_op(2, ch.can_send, seen);\n        }\n    }\n}export fn Channel::recv<T>(ref<Chann"
    "el<T>, shared> ch) : Option<T>\n{\n    while (true)\n    {\n        usize seen = 0;\n        {\n          "
    "  auto g = lock(&ch.state);\n            if (g.count > 0)\n            {\n                Option<T> x ="
    " ChannelState::pop(&mut *g);\n                unsafe\n                {\n                    event_op(3"
    ", ch.can_send, 0);\n                }\n                return x;\n            }\n            if (g.close"
    "d)\n            {\n                return None;\n            }\n            seen = unsafe\n            {\n"
