    "    u64 t16 = t15 ^ t12;\n    u64 t17 = t4 ^ t14;\n    u64 t18 = t6 ^ t16;\n    u64 t19 = t9 ^ t14;\n   "
    " u64 t20 = t11 ^ t16;\n    u64 t21 = t17 ^ y20;\n    u64 t22 = t18 ^ y19;\n    u64 t23 = t19 ^ y21;\n   "
    " u64 t24 = t20 ^ y18;\n    u64 t25 = t21 ^ t22;\n    u64 t26 = t21 & t23;\n    u64 t27 = t24 ^ t26;\n   "
    " u64 t28 = t25 & t27;\n    u64 t29 = t28 ^ t22;\n    u64 t30 = t23 ^ t24;\n    u64 t31 = t22 ^ t26;\n   "
    " u64 t32 = t31 & t30;\n    u64 t33 = t32 ^ t24;\n    u64 t34 = t23 ^ t33;\n    u64 t35 = t27 ^ t33;\n   "
    " u64 t36 = t24 & t35;\n    u64 t37 = t36 ^ t34;\n    u64 t38 = t27 ^ t36;\n    u64 t39 = t29 & t38;\n   "
    " u64 t40 = t25 ^ t39;\n    u64 t41 = t40 ^ t37;\n    u64 t42 = t29 ^ t33;\n    u64 t43 = t29 ^ t40;\n   "
    " u64 t44 = t33 ^ t37;\n    u64 t45 = t42 ^ t41;\n    u64 z0 = t44 & y15;\n    u64 z1 = t37 & y6;\n    u6"
    "4 z2 = t33 & x7;\n    u64 z3 = t43 & y16;\n    u64 z4 = t40 & y1;\n    u64 z5 = t29 & y7;\n    u64 z6 = "
    "t42 & y11;\n    u64 z7 = t45 & y17;\n    u64 z8 = t41 & y10;\n    u64 z9 = t44 & y12;\n    u64 z10 = t37"
    " & y3;\n    u64 z11 = t33 & y4;\n    u64 z12 = t43 & y13;\n    u64 z13 = t40 & y5;\n    u64 z14 = t29 & "
    "y2;\n    u64 z15 = t42 & y9;\n    u64 z16 = t45 & y14;\n    u64 z17 = t41 & y8;\n    u64 t46 = z15 ^ z16"
    ";\n    u64 t47 = z10 ^ z11;\n    u64 t48 = z5 ^ z13;\n    u64 t49 = z9 ^ z10;\n    u64 t50 = z2 ^ z12;\n "
    "   u64 t51 = z2 ^ z5;\n    u64 t52 = z7 ^ z8;\n    u64 t53 = z0 ^ z3;\n    u64 t54 = z6 ^ z7;\n    u64 t"
    "55 = z16 ^ z17;\n    u64 t56 = z12 ^ t48;\n    u64 t57 = t50 ^ t53;\n    u64 t58 = z4 ^ t46;\n    u64 t5"
    "9 = z3 ^ t54;\n    u64 t60 = t46 ^ t57;\n    u64 t61 = z14 ^ t57;\n    u64 t62 = t52 ^ t58;\n    u64 t63"
    " = t49 ^ t58;\n    u64 t64 = z4 ^ t59;\n    u64 t65 = t61 ^ t62;\n    u64 t66 = z1 ^ t63;\n    u64 s0 = "
    "t59 ^ t63;\n    u64 s6 = t56 ^ ~t62;\n    u64 s7 = t48 ^ ~t60;\n    u64 t67 = t64 ^ t65;\n    u64 s3 = t"
    "53 ^ t66;\n    u64 s4 = t51 ^ t66;\n    u64 s5 = t47 ^ t65;\n    u64 s1 = t64 ^ ~s3;\n    u64 s2 = t55 ^"
    " ~t67;\n    [s7, s6, s5, s4, s3, s2, s1, s0]\n}fn aes_sbox_bytes(u64 x) : u64\n{\n    u64 t = aes_transp"
    "ose8(x);\n    array<u64, 8> q = [0; 8];\n    for (usize p = 0; p < 8; p += 1)\n    {\n        q[p] = (t "
    ">> narrow<u32>(8 * p)) & 0xff;\n    }\n    q = aes_sbox_ct(q);\n    u64 r = 0;\n    for (usize p = 0; p "
    "< 8; p += 1)\n    {\n        r = r | ((q[p] & 0xff) << narrow<u32>(8 * p));\n    }\n    aes_transpose8(r"
    ")\n}fn aes_shift_rows(array<u64, 8> q) : array<u64, 8>\n{\n    array<u64, 8> r = [0; 8];\n    for (usize"
    " b = 0; b < 8; b += 1)\n    {\n        u64 x = q[b];\n        r[b] = (x & AES_ROW0)\n            | ((x >"
