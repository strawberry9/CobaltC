    " i < 16; i += 1)\n    {\n        u8 v = if (at + i < slice_len(b)) { b[at + i] } else { 0 };\n        x"
    " = (x << 8) | widen<u128>(v);\n    }\n    x\n}fn ghash_bmul64(u64 x, u64 y) : u64\n{\n    u64 x0 = x & 0x"
    "1111111111111111;\n    u64 x1 = x & 0x2222222222222222;\n    u64 x2 = x & 0x4444444444444444;\n    u64 "
    "x3 = x & 0x8888888888888888;\n    u64 y0 = y & 0x1111111111111111;\n    u64 y1 = y & 0x222222222222222"
    "2;\n    u64 y2 = y & 0x4444444444444444;\n    u64 y3 = y & 0x8888888888888888;\n    u64 z0 = wrapping_m"
    "ul(x0, y0) ^ wrapping_mul(x1, y3) ^ wrapping_mul(x2, y2) ^ wrapping_mul(x3, y1);\n    u64 z1 = wrappi"
    "ng_mul(x0, y1) ^ wrapping_mul(x1, y0) ^ wrapping_mul(x2, y3) ^ wrapping_mul(x3, y2);\n    u64 z2 = wr"
    "apping_mul(x0, y2) ^ wrapping_mul(x1, y1) ^ wrapping_mul(x2, y0) ^ wrapping_mul(x3, y3);\n    u64 z3 "
    "= wrapping_mul(x0, y3) ^ wrapping_mul(x1, y2) ^ wrapping_mul(x2, y1) ^ wrapping_mul(x3, y0);\n    (z0"
    " & 0x1111111111111111) | (z1 & 0x2222222222222222) | (z2 & 0x4444444444444444) | (z3 & 0x88888888888"
    "88888)\n}fn ghash_rev64(u64 x) : u64\n{\n    u64 v = ((x & 0x5555555555555555) << 1) | ((x >> 1) & 0x55"
    "55555555555555);\n    v = ((v & 0x3333333333333333) << 2) | ((v >> 2) & 0x3333333333333333);\n    v = "
    "((v & 0x0f0f0f0f0f0f0f0f) << 4) | ((v >> 4) & 0x0f0f0f0f0f0f0f0f);\n    v = ((v & 0x00ff00ff00ff00ff)"
    " << 8) | ((v >> 8) & 0x00ff00ff00ff00ff);\n    v = ((v & 0x0000ffff0000ffff) << 16) | ((v >> 16) & 0x"
    "0000ffff0000ffff);\n    (v << 32) | (v >> 32)\n}fn ghash_mul(u128 x, u128 y) : u128\n{\n    u64 x1 = nar"
    "row_wrapping<u64>(x >> 64);\n    u64 x0 = narrow_wrapping<u64>(x);\n    u64 y1 = narrow_wrapping<u64>("
    "y >> 64);\n    u64 y0 = narrow_wrapping<u64>(y);\n    u64 x0r = ghash_rev64(x0);\n    u64 x1r = ghash_r"
    "ev64(x1);\n    u64 y0r = ghash_rev64(y0);\n    u64 y1r = ghash_rev64(y1);\n    u64 z0 = ghash_bmul64(x0"
    ", y0);\n    u64 z1 = ghash_bmul64(x1, y1);\n    u64 z2 = ghash_bmul64(x0 ^ x1, y0 ^ y1);\n    u64 z0h ="
    " ghash_bmul64(x0r, y0r);\n    u64 z1h = ghash_bmul64(x1r, y1r);\n    u64 z2h = ghash_bmul64(x0r ^ x1r,"
    " y0r ^ y1r);\n    z2 = z2 ^ z0 ^ z1;\n    z2h = z2h ^ z0h ^ z1h;\n    z0h = ghash_rev64(z0h) >> 1;\n    "
    "z1h = ghash_rev64(z1h) >> 1;\n    z2h = ghash_rev64(z2h) >> 1;\n    u64 v0 = z0;\n    u64 v1 = z0h ^ z2"
    ";\n    u64 v2 = z1 ^ z2h;\n    u64 v3 = z1h;\n    v3 = (v3 << 1) | (v2 >> 63);\n    v2 = (v2 << 1) | (v1"
    " >> 63);\n    v1 = (v1 << 1) | (v0 >> 63);\n    v0 = v0 << 1;\n    v2 = v2 ^ v0 ^ (v0 >> 1) ^ (v0 >> 2)"
    " ^ (v0 >> 7);\n    v1 = v1 ^ (v0 << 63) ^ (v0 << 62) ^ (v0 << 57);\n    v3 = v3 ^ v1 ^ (v1 >> 1) ^ (v1"
    " >> 2) ^ (v1 >> 7);\n    v2 = v2 ^ (v1 << 63) ^ (v1 << 62) ^ (v1 << 57);\n    (widen<u128>(v3) << 64) "
    "| widen<u128>(v2)\n}fn ghash_update(u128 y, u128 h, slice<u8, shared> data) : u128\n{\n    u128 acc = y"
    ";\n    for (usize at = 0; at < slice_len(data); at += 16)\n    {\n        acc = ghash_mul(acc ^ gcm_blo"
    "ck(data, at), h);\n    }\n    acc\n}fn gcm_bytes(u128 x) : array<u8, 16>\n{\n    array<u8, 16> b = [0; 16"
    "];\n    for (usize i = 0; i < 16; i += 1)\n    {\n        b[i] = narrow_wrapping<u8>(x >> narrow<u32>(8"
    " * (15 - i)));\n    }\n    b\n}fn gcm_ctr(ref<AesKey, shared> key, array<u8, 16> j0, slice<u8, shared> "
    "data) : Vec<u8>\n{\n    Vec<u8> out = Vec::from_slice(data);\n    array<u8, 64> cb = [0; 64];\n    for ("
    "usize k = 0; k < 4; k += 1)\n    {\n        for (usize i = 0; i < 12; i += 1)\n        {\n            cb"
    "[16 * k + i] = j0[i];\n        }\n    }\n    // The counter, kept apart from the blocks (whose last fou"
    "r bytes it is).\n    u32 c = (widen<u32>(j0[12]) << 24) | (widen<u32>(j0[13]) << 16) | (widen<u32>(j0"
    "[14]) << 8) | widen<u32>(j0[15]);\n    for (usize at = 0; at < slice_len(data); at += 64)\n    {\n     "
    "   for (usize k = 0; k < 4; k += 1)\n        {\n            c = wrapping_add(c, 1);\n            for (u"
    "size i = 0; i < 4; i += 1)\n            {\n                cb[16 * k + 12 + i] = narrow_wrapping<u8>(c"
    " >> narrow<u32>(24 - 8 * i));\n            }\n        }\n        array<u8, 64> ks = aes_unpack(aes_encr"
    "ypt4(key, aes_pack(cb)));\n        for (usize i = 0; i < 64 && at + i < slice_len(data); i += 1)\n    "
    "    {\n            out[at + i] = out[at + i] ^ ks[i];\n        }\n    }\n    out\n}fn gcm_tag(\n    ref<Ae"
    "sKey, shared> key,\n    array<u8, 16> j0,\n    slice<u8, shared> aad,\n    slice<u8, shared> ciphertext"
    ",\n) : array<u8, 16>\n{\n    u128 h = gcm_block(&aes_block(key, [0; 16])[0..$], 0);\n    u128 y = ghash_"
    "update(ghash_update(0, h, aad), h, ciphertext);\n    u128 lengths = (widen<u128>(slice_len(aad)) * 8)"
    " << 64 | widen<u128>(slice_len(ciphertext)) * 8;\n    y = ghash_mul(y ^ lengths, h);\n    gcm_bytes(y "
    "^ gcm_block(&aes_block(key, j0)[0..$], 0))\n}fn gcm_j0(slice<u8, shared> nonce) : array<u8, 16>\n{\n   "
    " if (slice_len(nonce) != 12)\n    {\n        fault(crypto_length);\n    }\n    array<u8, 16> j = [0; 16]"
    ";\n    for (usize i = 0; i < 12; i += 1)\n    {\n        j[i] = nonce[i];\n    }\n    j[15] = 1;\n    j\n}e"
    "xport fn aes_gcm_seal(\n    slice<u8, shared> key,\n    slice<u8, shared> nonce,\n    slice<u8, shared>"
    " aad,\n    slice<u8, shared> plaintext,\n) : Vec<u8>\n{\n    array<u8, 16> j0 = gcm_j0(nonce);\n    AesKe"
    "y k = aes_expand(key);\n    Vec<u8> out = gcm_ctr(&k, j0, plaintext);\n    array<u8, 16> tag = gcm_tag"
    "(&k, j0, aad, &out[0..$]);\n    Vec::extend_from(&mut out, &tag[0..$]);\n    out\n}export fn aes_gcm_op"
    "en(\n    slice<u8, shared> key,\n    slice<u8, shared> nonce,\n    slice<u8, shared> aad,\n    slice<u8,"
    " shared> sealed,\n) : Option<Vec<u8>>\n{\n    array<u8, 16> j0 = gcm_j0(nonce);\n    AesKey k = aes_expa"
    "nd(key);\n    usize n = slice_len(sealed);\n    if (n < 16)\n    {\n        return None;\n    }\n    array"
    "<u8, 16> want = gcm_tag(&k, j0, aad, &sealed[0..n - 16]);\n    if (!digest_eq(&want[0..$], &sealed[n "
    "- 16..n]))\n    {\n        return None;\n    }\n    Some(gcm_ctr(&k, j0, &sealed[0..n - 16]))\n}fn fe_car"
    "ry(array<u64, 5> f) : array<u64, 5>\n{\n    array<u64, 5> r = f;\n    for (usize i = 0; i < 4; i += 1)\n"
    "    {\n        r[i + 1] += r[i] >> 51;\n        r[i] = r[i] & FE_MASK;\n    }\n    u64 c = r[4] >> 51;\n "
    "   r[4] = r[4] & FE_MASK;\n    r[0] += c * 19;\n    r[1] += r[0] >> 51;\n    r[0] = r[0] & FE_MASK;\n   "
    " r\n}fn fe_add(array<u64, 5> a, array<u64, 5> b) : array<u64, 5>\n{\n    fe_carry([a[0] + b[0], a[1] + "
    "b[1], a[2] + b[2], a[3] + b[3], a[4] + b[4]])\n}fn fe_sub(array<u64, 5> a, array<u64, 5> b) : array<u"
    "64, 5>\n{\n    fe_carry([\n        a[0] + 0x1fffffffffffb4 - b[0],\n        a[1] + 0x1ffffffffffffc - b["
    "1],\n        a[2] + 0x1ffffffffffffc - b[2],\n        a[3] + 0x1ffffffffffffc - b[3],\n        a[4] + 0"
    "x1ffffffffffffc - b[4],\n    ])\n}fn fe_mul(array<u64, 5> a, array<u64, 5> b) : array<u64, 5>\n{\n    u1"
    "28 a0 = widen<u128>(a[0]);\n    u128 a1 = widen<u128>(a[1]);\n    u128 a2 = widen<u128>(a[2]);\n    u12"
    "8 a3 = widen<u128>(a[3]);\n    u128 a4 = widen<u128>(a[4]);\n    u128 b0 = widen<u128>(b[0]);\n    u128"
    " b1 = widen<u128>(b[1]);\n    u128 b2 = widen<u128>(b[2]);\n    u128 b3 = widen<u128>(b[3]);\n    u128 "
    "b4 = widen<u128>(b[4]);\n    u128 b1_19 = b1 * 19;\n    u128 b2_19 = b2 * 19;\n    u128 b3_19 = b3 * 19"
    ";\n    u128 b4_19 = b4 * 19;\n    u128 t0 = a0 * b0 + a1 * b4_19 + a2 * b3_19 + a3 * b2_19 + a4 * b1_1"
    "9;\n    u128 t1 = a0 * b1 + a1 * b0 + a2 * b4_19 + a3 * b3_19 + a4 * b2_19;\n    u128 t2 = a0 * b2 + a"
    "1 * b1 + a2 * b0 + a3 * b4_19 + a4 * b3_19;\n    u128 t3 = a0 * b3 + a1 * b2 + a2 * b1 + a3 * b0 + a4"
    " * b4_19;\n    u128 t4 = a0 * b4 + a1 * b3 + a2 * b2 + a3 * b1 + a4 * b0;\n    u128 m = 0x7fffffffffff"
    "f;\n    t1 += t0 >> 51;\n    t2 += t1 >> 51;\n    t3 += t2 >> 51;\n    t4 += t3 >> 51;\n    u128 r0 = (t0"
    " & m) + (t4 >> 51) * 19;\n    u128 r1 = (t1 & m) + (r0 >> 51);\n    array<u64, 5> r = [\n        narrow"
    "<u64>(r0 & m),\n        narrow<u64>(r1),\n        narrow<u64>(t2 & m),\n        narrow<u64>(t3 & m),\n  "
    "      narrow<u64>(t4 & m),\n    ];\n    fe_carry(r)\n}fn fe_cswap(ref<array<u64, 5>, exclusive> a, ref<"
    "array<u64, 5>, exclusive> b, u64 swap)\n{\n    u64 mask = wrapping_sub(0, swap);\n    for (usize i = 0;"
    " i < 5; i += 1)\n    {\n        u64 x = mask & (a[i] ^ b[i]);\n        a[i] = a[i] ^ x;\n        b[i] = "
    "b[i] ^ x;\n    }\n}fn fe_invert(array<u64, 5> z) : array<u64, 5>\n{\n    array<u64, 5> r = [1, 0, 0, 0, "
    "0];\n    for (usize k = 0; k < 255; k += 1)\n    {\n        usize i = 254 - k;\n        r = fe_mul(r, r)"
    ";\n        if (i >= 5 || i == 3 || i == 1 || i == 0)\n        {\n            r = fe_mul(r, z);\n        "
    "}\n    }\n    r\n}fn fe_from_bytes(slice<u8, shared> s) : array<u64, 5>\n{\n    [\n        read_le<u64>(s,"
    " 0) & FE_MASK,\n        (read_le<u64>(s, 6) >> 3) & FE_MASK,\n        (read_le<u64>(s, 12) >> 6) & FE_"
    "MASK,\n        (read_le<u64>(s, 19) >> 1) & FE_MASK,\n        (read_le<u64>(s, 24) >> 12) & FE_MASK,\n "
    "   ]\n}fn fe_to_bytes(array<u64, 5> f) : array<u8, 32>\n{\n    array<u64, 5> h = fe_carry(fe_carry(f));"
    "\n    // q is 1 exactly when h ≥ p: h + 19 then reaches 2^255.\n    u64 q = (h[0] + 19) >> 51;\n    q"
    " = (h[1] + q) >> 51;\n    q = (h[2] + q) >> 51;\n    q = (h[3] + q) >> 51;\n    q = (h[4] + q) >> 51;\n "
    "   h[0] += 19 * q;\n    for (usize i = 0; i < 4; i += 1)\n    {\n        h[i + 1] += h[i] >> 51;\n      "
    "  h[i] = h[i] & FE_MASK;\n    }\n    h[4] = h[4] & FE_MASK;\n    array<u64, 4> w = [\n        h[0] | (h["
    "1] << 51),\n        (h[1] >> 13) | (h[2] << 38),\n        (h[2] >> 26) | (h[3] << 25),\n        (h[3] >"
    "> 39) | (h[4] << 12),\n    ];\n    array<u8, 32> out = [0; 32];\n    for (usize i = 0; i < 4; i += 1)\n "
    "   {\n        for (usize j = 0; j < 8; j += 1)\n        {\n            out[8 * i + j] = narrow_wrapping"
    "<u8>(w[i] >> narrow<u32>(8 * j));\n        }\n    }\n    out\n}fn x25519_ladder(slice<u8, shared> scalar"
    ", slice<u8, shared> u) : array<u8, 32>\n{\n    array<u8, 32> k = [0; 32];\n    for (usize i = 0; i < 32"
    "; i += 1)\n    {\n        k[i] = scalar[i];\n    }\n    k[0] = k[0] & 248;\n    k[31] = (k[31] & 127) | 6"
    "4;\n    array<u64, 5> x1 = fe_from_bytes(u);\n    array<u64, 5> x2 = [1, 0, 0, 0, 0];\n    array<u64, 5"
    "> z2 = [0, 0, 0, 0, 0];\n    array<u64, 5> x3 = x1;\n    array<u64, 5> z3 = [1, 0, 0, 0, 0];\n    array"
    "<u64, 5> a24 = [121665, 0, 0, 0, 0];\n    u64 swap = 0;\n    for (usize step = 0; step < 255; step += "
    "1)\n    {\n        usize t = 254 - step;\n        u64 bit = widen<u64>((k[t >> 3] >> narrow<u32>(t & 7)"
    ") & 1);\n        swap = swap ^ bit;\n        fe_cswap(&mut x2, &mut x3, swap);\n        fe_cswap(&mut z"
    "2, &mut z3, swap);\n        swap = bit;\n        array<u64, 5> a = fe_add(x2, z2);\n        array<u64, "
    "5> aa = fe_mul(a, a);\n        array<u64, 5> b = fe_sub(x2, z2);\n        array<u64, 5> bb = fe_mul(b,"
    " b);\n        array<u64, 5> e = fe_sub(aa, bb);\n        array<u64, 5> c = fe_add(x3, z3);\n        arr"
    "ay<u64, 5> d = fe_sub(x3, z3);\n        array<u64, 5> da = fe_mul(d, a);\n        array<u64, 5> cb = f"
    "e_mul(c, b);\n        array<u64, 5> sum = fe_add(da, cb);\n        x3 = fe_mul(sum, sum);\n        arra"
    "y<u64, 5> diff = fe_sub(da, cb);\n        z3 = fe_mul(x1, fe_mul(diff, diff));\n        x2 = fe_mul(aa"
    ", bb);\n        z2 = fe_mul(e, fe_add(aa, fe_mul(a24, e)));\n    }\n    fe_cswap(&mut x2, &mut x3, swap"
    ");\n    fe_cswap(&mut z2, &mut z3, swap);\n    fe_to_bytes(fe_mul(x2, fe_invert(z2)))\n}export fn x2551"
    "9(slice<u8, shared> private_key, slice<u8, shared> public_key) : Option<array<u8, 32>>\n{\n    if (sli"
    "ce_len(private_key) != 32 || slice_len(public_key) != 32)\n    {\n        fault(crypto_length);\n    }\n"
    "    array<u8, 32> shared = x25519_ladder(private_key, public_key);\n    u8 acc = 0;\n    for (usize i "
    "= 0; i < 32; i += 1)\n    {\n        acc = acc | shared[i];\n    }\n    if (acc == 0)\n    {\n        retu"
    "rn None;\n    }\n    Some(shared)\n}export fn x25519_public_key(slice<u8, shared> private_key) : array<"
    "u8, 32>\n{\n    if (slice_len(private_key) != 32)\n    {\n        fault(crypto_length);\n    }\n    array<"
    "u8, 32> base = [0; 32];\n    base[0] = 9;\n    x25519_ladder(private_key, &base[0..$])\n}export fn x255"
    "19_private_key() : array<u8, 32>\n{\n    array<u8, 32> k = [0; 32];\n    os_random_bytes(&mut k[0..$]);"
    "\n    k\n}fn rsa_open(ref<RsaPublicKey, shared> key, slice<u8, shared> signature, usize k) : Option<Ve"
    "c<u8>>\n{\n    BigUint s = BigUint::from_bytes_be(signature);\n    if (!BigUint::less(&s, &key.n))\n    "
    "{\n        return None;\n    }\n    BigUint m = BigUint::mod_pow(&s, &key.e, &key.n);\n    if (BigUint::"
    "bit_len(&m) > 8 * k)\n    {\n        return None;\n    }\n    Some(BigUint::to_bytes_be_padded(&m, k))\n}"
    "fn digest_info_prefix(HashKind kind) : Vec<u8>\n{\n    Result::unwrap_or(from_hex(match (kind)\n    {\n "
    "       Sha1     : \"3021300906052b0e03021a05000414\",\n        Sha2_256 : \"3031300d06096086480165030402"
    "0105000420\",\n        Sha2_384 : \"3041300d060960864801650304020205000430\",\n        Sha2_512 : \"305130"
    "0d060960864801650304020305000440\",\n    }), Vec::new())\n}export fn rsa_verify_pkcs1v15(\n    ref<RsaPu"
    "blicKey, shared> key,\n    HashKind kind,\n    slice<u8, shared> digest,\n    slice<u8, shared> signatu"
    "re,\n) : bool\n{\n    usize k = (BigUint::bit_len(&key.n) + 7) / 8;\n    if (slice_len(signature) != k |"
    "| slice_len(digest) != hash_len(kind))\n    {\n        return false;\n    }\n    Vec<u8> prefix = digest"
    "_info_prefix(kind);\n    usize t_len = Vec::len(&prefix) + slice_len(digest);\n    if (k < t_len + 11)"
    "\n    {\n        return false;\n    }\n    Vec<u8> want = Vec::new();\n    Vec::push(&mut want, 0);\n    V"
    "ec::push(&mut want, 1);\n    for (usize i = 0; i < k - t_len - 3; i += 1)\n    {\n        Vec::push(&mu"
    "t want, 0xff);\n    }\n    Vec::push(&mut want, 0);\n    Vec::extend_from(&mut want, &prefix[0..$]);\n  "
    "  Vec::extend_from(&mut want, digest);\n    match (rsa_open(key, signature, k))\n    {\n        Some(em"
    ") : digest_eq(&em[0..$], &want[0..$]),\n        None     : false,\n    }\n}fn mgf1(HashKind kind, slice"
    "<u8, shared> seed, usize len) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n    u32 counter = 0;\n    whi"
    "le (Vec::len(&out) < len)\n    {\n        Vec<u8> input = Vec::from_slice(seed);\n        Vec::push_be("
    "&mut input, counter);\n        Vec<u8> h = hash(kind, &input[0..$]);\n        for (usize i = 0; i < Ve"
    "c::len(&h) && Vec::len(&out) < len; i += 1)\n        {\n            Vec::push(&mut out, h[i]);\n       "
    " }\n        counter += 1;\n    }\n    out\n}export fn rsa_verify_pss(\n    ref<RsaPublicKey, shared> key,"
    "\n    HashKind kind,\n    slice<u8, shared> digest,\n    slice<u8, shared> signature,\n) : bool\n{\n    us"
    "ize mod_bits = BigUint::bit_len(&key.n);\n    usize k = (mod_bits + 7) / 8;\n    usize h_len = hash_le"
    "n(kind);\n    usize s_len = h_len;\n    if (slice_len(signature) != k || slice_len(digest) != h_len ||"
    " mod_bits < 2)\n    {\n        return false;\n    }\n    usize em_bits = mod_bits - 1;\n    usize em_len "
    "= (em_bits + 7) / 8;\n    if (em_len < h_len + s_len + 2)\n    {\n        return false;\n    }\n    Vec<u"
    "8> em = match (rsa_open(key, signature, em_len))\n    {\n        Some(e) : e,\n        None    : return"
    " false,\n    };\n    if (em[em_len - 1] != 0xbc)\n    {\n        return false;\n    }\n    usize db_len = "
    "em_len - h_len - 1;\n    u32 unused = narrow<u32>(8 * em_len - em_bits);\n    u8 top_mask = narrow_wra"
    "pping<u8>((0xff: u32) >> unused);\n    if ((em[0] & ~top_mask) != 0)\n    {\n        return false;\n    "
    "}\n    Vec<u8> db_mask = mgf1(kind, &em[db_len..db_len + h_len], db_len);\n    Vec<u8> db = Vec::new()"
    ";\n    for (usize i = 0; i < db_len; i += 1)\n    {\n        Vec::push(&mut db, em[i] ^ db_mask[i]);\n  "
    "  }\n    db[0] = db[0] & top_mask;\n    usize ps_len = em_len - h_len - s_len - 2;\n    for (usize i = "
    "0; i < ps_len; i += 1)\n    {\n        if (db[i] != 0)\n        {\n            return false;\n        }\n "
    "   }\n    if (db[ps_len] != 1)\n    {\n        return false;\n    }\n    Vec<u8> m2 = Vec::filled(8, 0: u"
    "8);\n    Vec::extend_from(&mut m2, digest);\n    Vec::extend_from(&mut m2, &db[db_len - s_len..$]);\n  "
    "  Vec<u8> h2 = hash(kind, &m2[0..$]);\n    digest_eq(&h2[0..$], &em[db_len..db_len + h_len])\n}fn fiel"
    "d_of(EcCurve c, bool order) : Field\n{\n    match (c)\n    {\n        P256 : if (order)\n        {\n      "
    "      Field { .m = [\n                0xf3b9cac2fc632551,\n                0xbce6faada7179e84,\n       "
    "         0xffffffffffffffff,\n                0xffffffff00000000,\n                0x0000000000000000,"
    "\n                0x0000000000000000,\n            ], .n = 4, .minv = 0xccd1c8aaee00bc4f, .r2 = [\n    "
    "            0x83244c95be79eea2,\n                0x4699799c49bd6fa6,\n                0x2845b2392b6bec"
    "59,\n                0x66e12d94f3d95620,\n                0x0000000000000000,\n                0x000000"
    "0000000000,\n            ] }\n        }\n        else\n        {\n            Field { .m = [\n            "
    "    0xffffffffffffffff,\n                0x00000000ffffffff,\n                0x0000000000000000,\n    "
    "            0xffffffff00000001,\n                0x0000000000000000,\n                0x00000000000000"
    "00,\n            ], .n = 4, .minv = 0x0000000000000001, .r2 = [\n                0x0000000000000003,\n "
    "               0xfffffffbffffffff,\n                0xfffffffffffffffe,\n                0x00000004fff"
    "ffffd,\n                0x0000000000000000,\n                0x0000000000000000,\n            ] }\n     "
    "   },\n        P384 : if (order)\n        {\n            Field { .m = [\n                0xecec196accc52"
    "973,\n                0x581a0db248b0a77a,\n                0xc7634d81f4372ddf,\n                0xfffff"
    "fffffffffff,\n                0xffffffffffffffff,\n                0xffffffffffffffff,\n            ], "
    ".n = 6, .minv = 0x6ed46089e88fdc45, .r2 = [\n                0x2d319b2419b409a9,\n                0xff"
    "3d81e5df1aa419,\n                0xbc3e483afcb82947,\n                0xd40d49174aab1cc5,\n            "
    "    0x3fb05b7a28266895,\n                0x0c84ee012b39bf21,\n            ] }\n        }\n        else\n "
    "       {\n            Field { .m = [\n                0x00000000ffffffff,\n                0xffffffff00"
    "000000,\n                0xfffffffffffffffe,\n                0xffffffffffffffff,\n                0xff"
    "ffffffffffffff,\n                0xffffffffffffffff,\n            ], .n = 6, .minv = 0x000000010000000"
    "1, .r2 = [\n                0xfffffffe00000001,\n                0x0000000200000000,\n                0"
    "xfffffffe00000000,\n                0x0000000200000000,\n                0x0000000000000001,\n         "
    "       0x0000000000000000,\n            ] }\n        },\n    }\n}fn mont_mul(ref<Field, shared> f, array"
    "<u64, 6> a, array<u64, 6> b) : array<u64, 6>\n{\n    usize n = f.n;\n    array<u64, 8> t = [0; 8];\n    "
    "for (usize i = 0; i < n; i += 1)\n    {\n        u128 c = 0;\n        for (usize j = 0; j < n; j += 1)\n"
    "        {\n            u128 x = widen<u128>(t[j]) + widen<u128>(a[j]) * widen<u128>(b[i]) + c;\n      "
    "      t[j] = narrow_wrapping<u64>(x);\n            c = x >> 64;\n        }\n        u128 y = widen<u128"
    ">(t[n]) + c;\n        t[n] = narrow_wrapping<u64>(y);\n        t[n + 1] = narrow_wrapping<u64>(y >> 64"
    ");\n        u64 k = wrapping_mul(t[0], f.minv);\n        u128 z = widen<u128>(t[0]) + widen<u128>(k) *"
    " widen<u128>(f.m[0]);\n        c = z >> 64;\n        for (usize j = 1; j < n; j += 1)\n        {\n      "
    "      u128 x = widen<u128>(t[j]) + widen<u128>(k) * widen<u128>(f.m[j]) + c;\n            t[j - 1] = "
    "narrow_wrapping<u64>(x);\n            c = x >> 64;\n        }\n        u128 w = widen<u128>(t[n]) + c;\n"
    "        t[n - 1] = narrow_wrapping<u64>(w);\n        t[n] = t[n + 1] + narrow_wrapping<u64>(w >> 64);"
    "\n    }\n    array<u64, 6> r = [0; 6];\n    for (usize j = 0; j < n; j += 1)\n    {\n        r[j] = t[j];"
    "\n    }\n    // r - m unless r (with its carry t[n]) is below m: chosen by a mask.\n    Borrowed d = f_"
    "sub_borrow(f, r, f.m);\n    f_select(wrapping_sub(0, (1 - t[n]) & d.borrow), r, d.v)\n}fn f_less(ref<F"
    "ield, shared> f, array<u64, 6> a, array<u64, 6> b) : bool\n{\n    usize i = f.n;\n    while (i > 0)\n   "
    " {\n        i -= 1;\n        if (a[i] != b[i])\n        {\n            return a[i] < b[i];\n        }\n   "
    " }\n    false\n}fn f_sub_borrow(ref<Field, shared> f, array<u64, 6> a, array<u64, 6> b) : Borrowed\n{\n "
    "   array<u64, 6> r = [0; 6];\n    u64 borrow = 0;\n    for (usize i = 0; i < f.n; i += 1)\n    {\n      "
    "  u128 x = wrapping_sub(wrapping_sub(widen<u128>(a[i]), widen<u128>(b[i])), widen<u128>(borrow));\n  "
    "      r[i] = narrow_wrapping<u64>(x);\n        borrow = narrow_wrapping<u64>(x >> 127);\n    }\n    Bor"
    "rowed { .v = r, .borrow = borrow }\n}fn f_sub_raw(ref<Field, shared> f, array<u64, 6> a, array<u64, 6"
    "> b) : array<u64, 6>\n{\n    f_sub_borrow(f, a, b).v\n}fn f_select(u64 mask, array<u64, 6> a, array<u64"
    ", 6> b) : array<u64, 6>\n{\n    array<u64, 6> r = [0; 6];\n    for (usize i = 0; i < 6; i += 1)\n    {\n "
    "       r[i] = (a[i] & mask) | (b[i] & ~mask);\n    }\n    r\n}fn f_add(ref<Field, shared> f, array<u64,"
    " 6> a, array<u64, 6> b) : array<u64, 6>\n{\n    array<u64, 6> r = [0; 6];\n    u64 carry = 0;\n    for ("
    "usize i = 0; i < f.n; i += 1)\n    {\n        u128 s = widen<u128>(a[i]) + widen<u128>(b[i]) + widen<u"
    "128>(carry);\n        r[i] = narrow_wrapping<u64>(s);\n        carry = narrow_wrapping<u64>(s >> 64);\n"
    "    }\n    Borrowed d = f_sub_borrow(f, r, f.m);\n    f_select(wrapping_sub(0, (1 - carry) & d.borrow)"
    ", r, d.v)\n}fn f_sub(ref<Field, shared> f, array<u64, 6> a, array<u64, 6> b) : array<u64, 6>\n{\n    Bo"
    "rrowed d = f_sub_borrow(f, a, b);\n    array<u64, 6> m = f_select(wrapping_sub(0, d.borrow), f.m, [0;"
    " 6]);\n    f_add_raw(f, d.v, m)\n}fn f_add_raw(ref<Field, shared> f, array<u64, 6> a, array<u64, 6> b)"
    " : array<u64, 6>\n{\n    array<u64, 6> r = [0; 6];\n    u64 carry = 0;\n    for (usize i = 0; i < f.n; i"
    " += 1)\n    {\n        u128 s = widen<u128>(a[i]) + widen<u128>(b[i]) + widen<u128>(carry);\n        r["
    "i] = narrow_wrapping<u64>(s);\n        carry = narrow_wrapping<u64>(s >> 64);\n    }\n    r\n}fn f_is_ze"
    "ro(ref<Field, shared> f, array<u64, 6> a) : bool\n{\n    u64 acc = 0;\n    for (usize i = 0; i < f.n; i"
    " += 1)\n    {\n        acc = acc | a[i];\n    }\n    acc == 0\n}fn f_to_mont(ref<Field, shared> f, array<"
    "u64, 6> a) : array<u64, 6>\n{\n    mont_mul(f, a, f.r2)\n}fn f_from_mont(ref<Field, shared> f, array<u6"
    "4, 6> a) : array<u64, 6>\n{\n    mont_mul(f, a, [1, 0, 0, 0, 0, 0])\n}fn f_invert(ref<Field, shared> f,"
    " array<u64, 6> a) : array<u64, 6>\n{\n    array<u64, 6> e = f_sub_raw(f, f.m, [2, 0, 0, 0, 0, 0]);\n   "
    " array<u64, 6> r = f_to_mont(f, [1, 0, 0, 0, 0, 0]);\n    usize bits = 64 * f.n;\n    usize i = bits;\n"
    "    while (i > 0)\n    {\n        i -= 1;\n        r = mont_mul(f, r, r);\n        if (((e[i / 64] >> na"
    "rrow<u32>(i % 64)) & 1) == 1)\n        {\n            r = mont_mul(f, r, a);\n        }\n    }\n    r\n}fn"
    " f_from_be(ref<Field, shared> f, slice<u8, shared> b) : Option<array<u64, 6>>\n{\n    usize len = slic"
    "e_len(b);\n    if (len > 8 * f.n)\n    {\n        return None;\n    }\n    array<u64, 6> r = [0; 6];\n    "
    "for (usize k = 0; k < len; k += 1)\n    {\n        usize pos = len - 1 - k;\n        r[k / 8] = r[k / 8"
    "] | (widen<u64>(b[pos]) << narrow<u32>(8 * (k % 8)));\n    }\n    if (!f_less(f, r, f.m))\n    {\n      "
    "  return None;\n    }\n    Some(r)\n}fn f_bit(array<u64, 6> a, usize i) : bool\n{\n    ((a[i / 64] >> nar"
    "row<u32>(i % 64)) & 1) == 1\n}fn f_small(ref<Field, shared> f, u64 k, array<u64, 6> a) : array<u64, 6"
    ">\n{\n    array<u64, 6> r = a;\n    u32 top = 63 - leading_zeros(k);\n    u32 i = top;\n    while (i > 0)"
    "\n    {\n        i -= 1;\n        r = f_add(f, r, r);\n        if (((k >> i) & 1) == 1)\n        {\n      "
    "      r = f_add(f, r, a);\n        }\n    }\n    r\n}fn jac_double(ref<Field, shared> f, Jacobian q) : J"
    "acobian\n{\n    if (f_is_zero(f, q.z) || f_is_zero(f, q.y))\n    {\n        return Jacobian { .x = q.x, "
    ".y = q.y, .z = [0; 6] };\n    }\n    array<u64, 6> delta = mont_mul(f, q.z, q.z);\n    array<u64, 6> ga"
    "mma = mont_mul(f, q.y, q.y);\n    array<u64, 6> beta = mont_mul(f, q.x, gamma);\n    array<u64, 6> alp"
    "ha = f_small(f, 3, mont_mul(f, f_sub(f, q.x, delta), f_add(f, q.x, delta)));\n    array<u64, 6> x3 = "
    "f_sub(f, mont_mul(f, alpha, alpha), f_small(f, 8, beta));\n    array<u64, 6> yz = f_add(f, q.y, q.z);"
    "\n    array<u64, 6> z3 = f_sub(f, f_sub(f, mont_mul(f, yz, yz), gamma), delta);\n    array<u64, 6> y3 "
    "= f_sub(\n        f,\n        mont_mul(f, alpha, f_sub(f, f_small(f, 4, beta), x3)),\n        f_small(f"
    ", 8, mont_mul(f, gamma, gamma)),\n    );\n    Jacobian { .x = x3, .y = y3, .z = z3 }\n}fn jac_add(ref<F"
    "ield, shared> f, Jacobian a, Jacobian b) : Jacobian\n{\n    if (f_is_zero(f, a.z))\n    {\n        retur"
    "n b;\n    }\n    if (f_is_zero(f, b.z))\n    {\n        return a;\n    }\n    array<u64, 6> z1z1 = mont_mu"
    "l(f, a.z, a.z);\n    array<u64, 6> z2z2 = mont_mul(f, b.z, b.z);\n    array<u64, 6> u1 = mont_mul(f, a"
    ".x, z2z2);\n    array<u64, 6> u2 = mont_mul(f, b.x, z1z1);\n    array<u64, 6> s1 = mont_mul(f, mont_mu"
    "l(f, a.y, b.z), z2z2);\n    array<u64, 6> s2 = mont_mul(f, mont_mul(f, b.y, a.z), z1z1);\n    array<u6"
    "4, 6> h = f_sub(f, u2, u1);\n    array<u64, 6> r = f_small(f, 2, f_sub(f, s2, s1));\n    if (f_is_zero"
    "(f, h))\n    {\n        if (f_is_zero(f, r))\n        {\n            return jac_double(f, a);\n        }\n"
    "        return Jacobian { .x = a.x, .y = a.y, .z = [0; 6] };\n    }\n    array<u64, 6> h2 = f_small(f,"
    " 2, h);\n    array<u64, 6> i = mont_mul(f, h2, h2);\n    array<u64, 6> j = mont_mul(f, h, i);\n    arra"
    "y<u64, 6> v = mont_mul(f, u1, i);\n    array<u64, 6> x3 = f_sub(f, f_sub(f, mont_mul(f, r, r), j), f_"
    "small(f, 2, v));\n    array<u64, 6> y3 = f_sub(f, mont_mul(f, r, f_sub(f, v, x3)), f_small(f, 2, mont"
    "_mul(f, s1, j)));\n    array<u64, 6> zs = f_add(f, a.z, b.z);\n    array<u64, 6> z3 = mont_mul(f, f_su"
    "b(f, f_sub(f, mont_mul(f, zs, zs), z1z1), z2z2), h);\n    Jacobian { .x = x3, .y = y3, .z = z3 }\n}fn "
    "jac_table(ref<Field, shared> f, Jacobian p) : Vec<Jacobian>\n{\n    Vec<Jacobian> t = Vec::new();\n    "
    "Vec::push(&mut t, Jacobian { .x = p.x, .y = p.y, .z = [0; 6] });\n    Vec::push(&mut t, p);\n    for ("
    "usize i = 2; i < 16; i += 1)\n    {\n        Jacobian next = if (i % 2 == 0) { jac_double(f, t[i / 2])"
    " } else { jac_add(f, t[i - 1], p) };\n        Vec::push(&mut t, next);\n    }\n    t\n}fn f_nibble(array"
    "<u64, 6> a, usize w) : usize\n{\n    narrow<usize>((a[w / 16] >> narrow<u32>(4 * (w % 16))) & 15)\n}fn "
    "jac_twin(ref<Field, shared> f, array<u64, 6> u1, Jacobian g, array<u64, 6> u2, Jacobian q, usize bit"
    "s) : Jacobian\n{\n    Vec<Jacobian> tg = jac_table(f, g);\n    Vec<Jacobian> tq = jac_table(f, q);\n    "
    "Jacobian acc = tg[0];\n    usize w = bits / 4;\n    while (w > 0)\n    {\n        w -= 1;\n        for (u"
    "size k = 0; k < 4; k += 1)\n        {\n            acc = jac_double(f, acc);\n        }\n        usize d"
    "1 = f_nibble(u1, w);\n        usize d2 = f_nibble(u2, w);\n        if (d1 != 0)\n        {\n            "
    "acc = jac_add(f, acc, tg[d1]);\n        }\n        if (d2 != 0)\n        {\n            acc = jac_add(f,"
    " acc, tq[d2]);\n        }\n    }\n    acc\n}fn jac_twin_bits(\n    ref<Field, shared> f,\n    array<u64, 6"
    "> u1,\n    Jacobian g,\n    array<u64, 6> u2,\n    Jacobian q,\n    usize bits,\n) : Jacobian\n{\n    Jacob"
    "ian gq = jac_add(f, g, q);\n    Jacobian acc = Jacobian { .x = g.x, .y = g.y, .z = [0; 6] };\n    usiz"
    "e i = bits;\n    while (i > 0)\n    {\n        i -= 1;\n        acc = jac_double(f, acc);\n        bool b"
    "1 = f_bit(u1, i);\n        bool b2 = f_bit(u2, i);\n        if (b1 && b2)\n        {\n            acc = "
    "jac_add(f, acc, gq);\n        }\n        else if (b1)\n        {\n            acc = jac_add(f, acc, g);\n"
    "        }\n        else if (b2)\n        {\n            acc = jac_add(f, acc, q);\n        }\n    }\n    a"
    "cc\n}fn curve_hex(ref<Field, shared> f, str hex) : array<u64, 6>\n{\n    Vec<u8> b = Result::unwrap_or("
    "from_hex(StringView::of(hex)), Vec::new());\n    Option::unwrap(f_from_be(f, &b[0..$]))\n}fn der_posit"
    "ive_int(slice<u8, shared> d, usize at) : Option<DerSpan>\n{\n    if (at + 2 > slice_len(d) || d[at] !="
    " 0x02)\n    {\n        return None;\n    }\n    usize len = widen<usize>(d[at + 1]);\n    usize start = a"
    "t + 2;\n    if (len == 0 || len > 0x7f || start + len > slice_len(d))\n    {\n        return None;\n    "
    "}\n    if ((d[start] & 0x80) != 0)\n    {\n        return None;\n    }\n    if (len > 1 && d[start] == 0 "
    "&& (d[start + 1] & 0x80) == 0)\n    {\n        return None;\n    }\n    // A leading zero byte only mark"
    "s the number positive.\n    usize from = if (d[start] == 0 && len > 1) { start + 1 } else { start };\n"
    "    Some(DerSpan { .start = from, .end = start + len })\n}export fn ecdsa_verify(\n    EcCurve curve,\n"
    "    slice<u8, shared> public_key,\n    slice<u8, shared> digest,\n    slice<u8, shared> signature,\n) :"
    " bool\n{\n    Field fp = field_of(curve, false);\n    Field fn_ = field_of(curve, true);\n    usize size"
    " = 8 * fp.n;\n    if (slice_len(public_key) != 1 + 2 * size || public_key[0] != 0x04)\n    {\n        r"
    "eturn false;\n    }\n    array<u64, 6> qx = match (f_from_be(&fp, &public_key[1..1 + size]))\n    {\n   "
    "     Some(v) : f_to_mont(&fp, v),\n        None    : return false,\n    };\n    array<u64, 6> qy = matc"
    "h (f_from_be(&fp, &public_key[1 + size..$]))\n    {\n        Some(v) : f_to_mont(&fp, v),\n        None"
    "    : return false,\n    };\n    str b_hex = match (curve)\n    {\n        P256 : \"5ac635d8aa3a93e7b3ebb"
    "d55769886bc651d06b0cc53b0f63bce3c3e27d2604b\",\n        P384 : \"b3312fa7e23ee7e4988e056be3f82d19181d9c"
    "6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef\",\n    };\n    array<u64, 6> b = f_to_mont("
    "&fp, curve_hex(&fp, b_hex));\n    // y² = x³ - 3x + b\n    array<u64, 6> lhs = mont_mul(&fp, qy, qy)"
    ";\n    array<u64, 6> rhs = f_add(&fp, f_sub(&fp, mont_mul(&fp, mont_mul(&fp, qx, qx), qx), f_small(&f"
    "p, 3, qx)), b);\n    if (!f_is_zero(&fp, f_sub(&fp, lhs, rhs)))\n    {\n        return false;\n    }\n   "
    " usize sl = slice_len(signature);\n    if (sl < 8 || signature[0] != 0x30 || signature[1] > 0x7f || w"
    "iden<usize>(signature[1]) != sl - 2)\n    {\n        return false;\n    }\n    DerSpan rs = match (der_p"
    "ositive_int(signature, 2))\n    {\n        Some(v) : v,\n        None    : return false,\n    };\n    Der"
    "Span ss = match (der_positive_int(signature, rs.end))\n    {\n        Some(v) : v,\n        None    : r"
    "eturn false,\n    };\n    if (ss.end != sl)\n    {\n        return false;\n    }\n    array<u64, 6> r = ma"
    "tch (f_from_be(&fn_, &signature[rs.start..rs.end]))\n    {\n        Some(v) : v,\n        None    : ret"
    "urn false,\n    };\n    array<u64, 6> s = match (f_from_be(&fn_, &signature[ss.start..ss.end]))\n    {\n"
    "        Some(v) : v,\n        None    : return false,\n    };\n    if (f_is_zero(&fn_, r) || f_is_zero("
    "&fn_, s))\n    {\n        return false;\n    }\n    // e: the digest's leftmost 8·size bits (the order'"
    "s bit length is the\n    // prime's for both curves), reduced once below n.\n    usize take = min(slic"
    "e_len(digest), size);\n    array<u64, 6> e = [0; 6];\n    for (usize k = 0; k < take; k += 1)\n    {\n  "
    "      usize pos = take - 1 - k;\n        e[k / 8] = e[k / 8] | (widen<u64>(digest[pos]) << narrow<u32"
    ">(8 * (k % 8)));\n    }\n    if (!f_less(&fn_, e, fn_.m))\n    {\n        e = f_sub_raw(&fn_, e, fn_.m);"
    "\n    }\n    array<u64, 6> w = f_invert(&fn_, f_to_mont(&fn_, s));\n    array<u64, 6> u1 = f_from_mont("
    "&fn_, mont_mul(&fn_, f_to_mont(&fn_, e), w));\n    array<u64, 6> u2 = f_from_mont(&fn_, mont_mul(&fn_"
    ", f_to_mont(&fn_, r), w));\n    str gx = match (curve)\n    {\n        P256 : \"6b17d1f2e12c4247f8bce6e5"
    "63a440f277037d812deb33a0f4a13945d898c296\",\n        P384 : \"aa87ca22be8b05378eb1c71ef320ad746e1d3b628"
    "ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7\",\n    };\n    str gy = match (curve)\n    {\n  "
    "      P256 : \"4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5\",\n        P384 : \"361"
    "7de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f\",\n    "
    "};\n    array<u64, 6> one = f_to_mont(&fp, [1, 0, 0, 0, 0, 0]);\n    Jacobian g = Jacobian { .x = f_to"
    "_mont(\n        &fp,\n        curve_hex(&fp, gx),\n    ), .y = f_to_mont(&fp, curve_hex(&fp, gy)), .z ="
    " one };\n    Jacobian q = Jacobian { .x = qx, .y = qy, .z = one };\n    Jacobian p = jac_twin(&fp, u1,"
    " g, u2, q, size * 8);\n    if (f_is_zero(&fp, p.z))\n    {\n        return false;\n    }\n    // x mod n "
    "= r, without inverting Z: x = X/Z², and x mod n is r exactly\n    // when x is r or (as x < p < 2n f"
    "or both curves) r + n, the latter only\n    // possible when r + n < p. So compare X with r·Z² and "
    "(r + n)·Z².\n    array<u64, 6> z2 = mont_mul(&fp, p.z, p.z);\n    if (f_is_zero(&fp, f_sub(&fp, p.x,"
    " mont_mul(&fp, f_to_mont(&fp, r), z2))))\n    {\n        return true;\n    }\n    array<u64, 6> rn = f_a"
    "dd_raw(&fp, r, fn_.m);\n    if (f_less(&fn_, rn, fp.m) && f_less(&fn_, r, rn))\n    {\n        return f"
    "_is_zero(&fp, f_sub(&fp, p.x, mont_mul(&fp, f_to_mont(&fp, rn), z2)));\n    }\n    false\n}fn curve_b_h"
    "ex(EcCurve c) : str\n{\n    match (c)\n    {\n        P256 : \"5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc"
    "53b0f63bce3c3e27d2604b\",\n        P384 : \"b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f501"
    "3875ac656398d8a2ed19d2a85c8edd3ec2aef\",\n    }\n}fn curve_base(ref<Field, shared> fp, EcCurve c) : Jac"
    "obian\n{\n    str gx = match (c)\n    {\n        P256 : \"6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a"
    "0f4a13945d898c296\",\n        P384 : \"aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a38"
    "5502f25dbf55296c3a545e3872760ab7\",\n    };\n    str gy = match (c)\n    {\n        P256 : \"4fe342e2fe1a7"
    "f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5\",\n        P384 : \"3617de4a96262c6f5d9e98bf9292dc"
    "29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f\",\n    };\n    Jacobian { .x = f_to"
    "_mont(\n        fp,\n        curve_hex(fp, gx),\n    ), .y = f_to_mont(fp, curve_hex(fp, gy)), .z = f_t"
    "o_mont(fp, [1, 0, 0, 0, 0, 0]) }\n}fn curve_point(ref<Field, shared> fp, EcCurve c, slice<u8, shared>"
    " public_key) : Option<Jacobian>\n{\n    usize size = 8 * fp.n;\n    if (slice_len(public_key) != 1 + 2 "
    "* size || public_key[0] != 0x04)\n    {\n        return None;\n    }\n    array<u64, 6> qx = f_to_mont(f"
    "p, f_from_be(fp, &public_key[1..1 + size])?);\n    array<u64, 6> qy = f_to_mont(fp, f_from_be(fp, &pu"
    "blic_key[1 + size..$])?);\n    array<u64, 6> b = f_to_mont(fp, curve_hex(fp, curve_b_hex(c)));\n    ar"
    "ray<u64, 6> lhs = mont_mul(fp, qy, qy);\n    array<u64, 6> rhs = f_add(fp, f_sub(fp, mont_mul(fp, mon"
    "t_mul(fp, qx, qx), qx), f_small(fp, 3, qx)), b);\n    if (!f_is_zero(fp, f_sub(fp, lhs, rhs)))\n    {\n"
    "        return None;\n    }\n    Some(Jacobian { .x = qx, .y = qy, .z = f_to_mont(fp, [1, 0, 0, 0, 0, "
    "0]) })\n}fn jac_select(u64 mask, Jacobian a, Jacobian b) : Jacobian\n{\n    Jacobian { .x = f_select(ma"
    "sk, a.x, b.x), .y = f_select(mask, a.y, b.y), .z = f_select(mask, a.z, b.z) }\n}fn limbs7_add(array<u"
    "64, 7> a, array<u64, 7> b) : array<u64, 7>\n{\n    array<u64, 7> r = [0; 7];\n    u64 carry = 0;\n    fo"
    "r (usize i = 0; i < 7; i += 1)\n    {\n        u128 s = widen<u128>(a[i]) + widen<u128>(b[i]) + widen<"
    "u128>(carry);\n        r[i] = narrow_wrapping<u64>(s);\n        carry = narrow_wrapping<u64>(s >> 64);"
    "\n    }\n    r\n}fn ec_mul(ref<Field, shared> fp, ref<Field, shared> fn_, array<u64, 6> k, Jacobian p) "
    ": Jacobian\n{\n    usize bits = 64 * fp.n;\n    array<u64, 7> n7 = [fn_.m[0], fn_.m[1], fn_.m[2], fn_.m"
    "[3], fn_.m[4], fn_.m[5], 0];\n    array<u64, 7> k1 = limbs7_add([k[0], k[1], k[2], k[3], k[4], k[5], "
    "0], n7);\n    array<u64, 7> k2 = limbs7_add(k1, n7);\n    // k + n when that reaches 2^bits, k + 2n ot"
    "herwise: bit `bits` is set\n    // and nothing above it.\n    u64 mask = wrapping_sub(0, k1[bits / 64]"
    " & 1);\n    array<u64, 7> kh = [0; 7];\n    for (usize i = 0; i < 7; i += 1)\n    {\n        kh[i] = (k1"
    "[i] & mask) | (k2[i] & ~mask);\n    }\n    Jacobian acc = p;\n    usize i = bits;\n    while (i > 0)\n   "
    " {\n        i -= 1;\n        acc = jac_double(fp, acc);\n        Jacobian sum = jac_add(fp, acc, p);\n  "
    "      u64 bit = (kh[i / 64] >> narrow<u32>(i % 64)) & 1;\n        acc = jac_select(wrapping_sub(0, bi"
    "t), sum, acc);\n    }\n    acc\n}fn limbs_be(array<u64, 6> a, usize len) : Vec<u8>\n{\n    Vec<u8> b = Ve"
    "c::filled(len, 0: u8);\n    for (usize i = 0; i < len; i += 1)\n    {\n        b[len - 1 - i] = narrow_"
    "wrapping<u8>(a[i / 8] >> narrow<u32>(8 * (i % 8)));\n    }\n    b\n}fn ec_scalar(ref<Field, shared> fn_"
    ", slice<u8, shared> private_key) : Option<array<u64, 6>>\n{\n    if (slice_len(private_key) != 8 * fn_"
    ".n)\n    {\n        fault(crypto_length);\n    }\n    match (f_from_be(fn_, private_key))\n    {\n        "
    "Some(k) : if (f_is_zero(fn_, k)) { None } else { Some(k) },\n        None    : None,\n    }\n}fn ec_aff"
    "ine(ref<Field, shared> fp, Jacobian q) : array<array<u64, 6>, 2>\n{\n    array<u64, 6> zinv = f_invert"
    "(fp, q.z);\n    array<u64, 6> zinv2 = mont_mul(fp, zinv, zinv);\n    array<u64, 6> x = f_from_mont(fp,"
    " mont_mul(fp, q.x, zinv2));\n    array<u64, 6> y = f_from_mont(fp, mont_mul(fp, q.y, mont_mul(fp, zin"
    "v2, zinv)));\n    [x, y]\n}export fn ec_private_key(EcCurve curve) : Vec<u8>\n{\n    Field fn_ = field_o"
    "f(curve, true);\n    Vec<u8> k = Vec::filled(8 * fn_.n, 0: u8);\n    while (true)\n    {\n        os_ran"
    "dom_bytes(&mut k[0..$]);\n        if (Option::is_some(&ec_scalar(&fn_, &k[0..$])))\n        {\n        "
    "    return k;\n        }\n    }\n}export fn ec_public_key(EcCurve curve, slice<u8, shared> private_key)"
    " : Option<Vec<u8>>\n{\n    Field fp = field_of(curve, false);\n    Field fn_ = field_of(curve, true);\n "
    "   array<u64, 6> k = ec_scalar(&fn_, private_key)?;\n    usize size = 8 * fp.n;\n    array<array<u64, "
    "6>, 2> xy = ec_affine(&fp, ec_mul(&fp, &fn_, k, curve_base(&fp, curve)));\n    Vec<u8> out = Vec::new"
    "();\n    Vec::push(&mut out, 0x04);\n    Vec::extend_from(&mut out, &limbs_be(xy[0], size)[0..$]);\n   "
    " Vec::extend_from(&mut out, &limbs_be(xy[1], size)[0..$]);\n    Some(out)\n}export fn ecdh(EcCurve cur"
    "ve, slice<u8, shared> private_key, slice<u8, shared> public_key) : Option<Vec<u8>>\n{\n    Field fp = "
    "field_of(curve, false);\n    Field fn_ = field_of(curve, true);\n    array<u64, 6> k = ec_scalar(&fn_,"
    " private_key)?;\n    Jacobian q = curve_point(&fp, curve, public_key)?;\n    Jacobian r = ec_mul(&fp, "
    "&fn_, k, q);\n    if (f_is_zero(&fp, r.z))\n    {\n        return None;\n    }\n    Some(limbs_be(ec_affi"
    "ne(&fp, r)[0], 8 * fp.n))\n}export fn p256_private_key() : array<u8, 32>\n{\n    Vec<u8> k = ec_private"
    "_key(P256);\n    array<u8, 32> out = [0; 32];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        out"
    "[i] = k[i];\n    }\n    out\n}export fn p256_public_key(slice<u8, shared> private_key) : Option<array<u"
    "8, 65>>\n{\n    Vec<u8> q = ec_public_key(P256, private_key)?;\n    array<u8, 65> out = [0; 65];\n    fo"
    "r (usize i = 0; i < 65; i += 1)\n    {\n        out[i] = q[i];\n    }\n    Some(out)\n}export fn p256_ecd"
    "h(slice<u8, shared> private_key, slice<u8, shared> public_key) : Option<array<u8, 32>>\n{\n    Vec<u8>"
    " z = ecdh(P256, private_key, public_key)?;\n    array<u8, 32> out = [0; 32];\n    for (usize i = 0; i "
    "< 32; i += 1)\n    {\n        out[i] = z[i];\n    }\n    Some(out)\n}fn digest_scalar(ref<Field, shared> "
    "fn_, slice<u8, shared> digest, usize size) : array<u64, 6>\n{\n    usize take = min(slice_len(digest),"
    " size);\n    array<u64, 6> e = [0; 6];\n    for (usize k = 0; k < take; k += 1)\n    {\n        usize po"
    "s = take - 1 - k;\n        e[k / 8] = e[k / 8] | (widen<u64>(digest[pos]) << narrow<u32>(8 * (k % 8))"
    ");\n    }\n    if (!f_less(fn_, e, fn_.m))\n    {\n        e = f_sub_raw(fn_, e, fn_.m);\n    }\n    e\n}fn"
    " der_push_uint(ref<Vec<u8>, exclusive> out, slice<u8, shared> v)\n{\n    usize from = 0;\n    while (fr"
    "om + 1 < slice_len(v) && v[from] == 0)\n    {\n        from += 1;\n    }\n    bool pad = (v[from] & 0x80"
    ") != 0;\n    Vec::push(out, 0x02);\n    Vec::push(out, narrow<u8>(slice_len(v) - from + (if (pad) { 1 "
    "} else { 0 })));\n    if (pad)\n    {\n        Vec::push(out, 0);\n    }\n    Vec::extend_from(out, &v[fr"
    "om..$]);\n}export fn ecdsa_sign(EcCurve curve, slice<u8, shared> private_key, slice<u8, shared> diges"
    "t) : Option<Vec<u8>>\n{\n    Field fp = field_of(curve, false);\n    Field fn_ = field_of(curve, true);"
    "\n    usize size = 8 * fp.n;\n    array<u64, 6> x = ec_scalar(&fn_, private_key)?;\n    HashKind kind ="
    " match (curve)\n    {\n        P256 : Sha2_256,\n        P384 : Sha2_384,\n    };\n    array<u64, 6> e = "
    "digest_scalar(&fn_, digest, size);\n    Vec<u8> x_bytes = limbs_be(x, size);\n    Vec<u8> e_bytes = li"
    "mbs_be(e, size);\n    Jacobian g = curve_base(&fp, curve);\n    array<u64, 6> xm = f_to_mont(&fn_, x);"
    "\n    array<u64, 6> em = f_to_mont(&fn_, e);\n    // RFC 6979 §3.2 steps b to h.\n    usize hlen = has"
    "h_len(kind);\n    Vec<u8> v = Vec::filled(hlen, 1: u8);\n    Vec<u8> key = Vec::filled(hlen, 0: u8);\n "
    "   for (u8 round = 0; round < 2; round += 1)\n    {\n        Hmac m = Hmac::new(kind, &key[0..$]);\n   "
    "     Hmac::update(&mut m, &v[0..$]);\n        array<u8, 1> sep = [round];\n        Hmac::update(&mut m"
    ", &sep[0..$]);\n        Hmac::update(&mut m, &x_bytes[0..$]);\n        Hmac::update(&mut m, &e_bytes[0"
    "..$]);\n        overwrite(&mut key, Hmac::finish(m));\n        overwrite(&mut v, hmac(kind, &key[0..$]"
    ", &v[0..$]));\n    }\n    while (true)\n    {\n        overwrite(&mut v, hmac(kind, &key[0..$], &v[0..$]"
    "));\n        // T is V itself: the hash is as long as the order for both curves.\n        Option<array"
    "<u64, 6>> candidate = f_from_be(&fn_, &v[0..size]);\n        if (Some(k) = candidate)\n        {\n     "
    "       if (!f_is_zero(&fn_, k))\n            {\n                array<u64, 6> r = ec_affine(&fp, ec_mu"
    "l(&fp, &fn_, k, g))[0];\n                if (!f_less(&fn_, r, fn_.m))\n                {\n             "
    "       r = f_sub_raw(&fn_, r, fn_.m);\n                }\n                if (!f_is_zero(&fn_, r))\n   "
    "             {\n                    array<u64, 6> kinv = f_invert(&fn_, f_to_mont(&fn_, k));\n        "
    "            array<u64, 6> rx = mont_mul(&fn_, f_to_mont(&fn_, r), xm);\n                    array<u64"
    ", 6> s = f_from_mont(&fn_, mont_mul(&fn_, kinv, f_add(&fn_, em, rx)));\n                    if (!f_is"
    "_zero(&fn_, s))\n                    {\n                        Vec<u8> body = Vec::new();\n           "
    "             der_push_uint(&mut body, &limbs_be(r, size)[0..$]);\n                        der_push_ui"
    "nt(&mut body, &limbs_be(s, size)[0..$]);\n                        Vec<u8> out = Vec::new();\n         "
    "               Vec::push(&mut out, 0x30);\n                        Vec::push(&mut out, narrow<u8>(Vec"
    "::len(&body)));\n                        Vec::extend_from(&mut out, &body[0..$]);\n                   "
    "     return Some(out);\n                    }\n                }\n            }\n        }\n        Hmac "
    "m = Hmac::new(kind, &key[0..$]);\n        Hmac::update(&mut m, &v[0..$]);\n        array<u8, 1> zero ="
    " [0];\n        Hmac::update(&mut m, &zero[0..$]);\n        overwrite(&mut key, Hmac::finish(m));\n     "
    "   overwrite(&mut v, hmac(kind, &key[0..$], &v[0..$]));\n    }\n}fn fe_neg(array<u64, 5> a) : array<u6"
    "4, 5>\n{\n    fe_sub([0, 0, 0, 0, 0], a)\n}fn fe_is_zero(array<u64, 5> a) : bool\n{\n    array<u8, 32> b "
    "= fe_to_bytes(a);\n    u8 acc = 0;\n    for (usize i = 0; i < 32; i += 1)\n    {\n        acc = acc | b["
    "i];\n    }\n    acc == 0\n}fn fe_eq(array<u64, 5> a, array<u64, 5> b) : bool\n{\n    fe_is_zero(fe_sub(a,"
    " b))\n}fn fe_select(u64 mask, array<u64, 5> a, array<u64, 5> b) : array<u64, 5>\n{\n    array<u64, 5> r"
    " = [0; 5];\n    for (usize i = 0; i < 5; i += 1)\n    {\n        r[i] = (a[i] & mask) | (b[i] & ~mask);"
    "\n    }\n    r\n}fn fe_pow_p58(array<u64, 5> z) : array<u64, 5>\n{\n    array<u64, 5> r = [1, 0, 0, 0, 0]"
    ";\n    for (usize k = 0; k < 252; k += 1)\n    {\n        usize i = 251 - k;\n        r = fe_mul(r, r);\n"
    "        if (i != 1)\n        {\n            r = fe_mul(r, z);\n        }\n    }\n    r\n}fn ed_identity() "
    ": Ed\n{\n    Ed { .x = [0, 0, 0, 0, 0], .y = [1, 0, 0, 0, 0], .z = [1, 0, 0, 0, 0], .t = [0, 0, 0, 0, "
    "0] }\n}fn ed_base() : Ed\n{\n    Ed { .x = ED_BX, .y = ED_BY, .z = [1, 0, 0, 0, 0], .t = fe_mul(ED_BX, "
    "ED_BY) }\n}fn ed_add(Ed p, Ed q) : Ed\n{\n    array<u64, 5> a = fe_mul(fe_sub(p.y, p.x), fe_sub(q.y, q."
    "x));\n    array<u64, 5> b = fe_mul(fe_add(p.y, p.x), fe_add(q.y, q.x));\n    array<u64, 5> c = fe_mul("
    "fe_mul(p.t, ED_2D), q.t);\n    array<u64, 5> d = fe_mul(fe_add(p.z, p.z), q.z);\n    array<u64, 5> e ="
    " fe_sub(b, a);\n    array<u64, 5> f = fe_sub(d, c);\n    array<u64, 5> g = fe_add(d, c);\n    array<u64"
    ", 5> h = fe_add(b, a);\n    Ed { .x = fe_mul(e, f), .y = fe_mul(g, h), .z = fe_mul(f, g), .t = fe_mul"
    "(e, h) }\n}fn ed_double(Ed p) : Ed\n{\n    array<u64, 5> a = fe_mul(p.x, p.x);\n    array<u64, 5> b = fe"
    "_mul(p.y, p.y);\n    array<u64, 5> zz = fe_mul(p.z, p.z);\n    array<u64, 5> c = fe_add(zz, zz);\n    a"
    "rray<u64, 5> h = fe_add(a, b);\n    array<u64, 5> xy = fe_add(p.x, p.y);\n    array<u64, 5> e = fe_sub"
    "(h, fe_mul(xy, xy));\n    array<u64, 5> g = fe_sub(a, b);\n    array<u64, 5> f = fe_add(c, g);\n    Ed "
    "{ .x = fe_mul(e, f), .y = fe_mul(g, h), .z = fe_mul(f, g), .t = fe_mul(e, h) }\n}fn ed_select(u64 mas"
    "k, Ed a, Ed b) : Ed\n{\n    Ed { .x = fe_select(\n        mask,\n        a.x,\n        b.x,\n    ), .y = f"
    "e_select(mask, a.y, b.y), .z = fe_select(mask, a.z, b.z), .t = fe_select(mask, a.t, b.t) }\n}fn ed_mu"
    "l(slice<u8, shared> scalar, Ed p) : Ed\n{\n    Ed acc = ed_identity();\n    usize i = 256;\n    while (i"
    " > 0)\n    {\n        i -= 1;\n        acc = ed_double(acc);\n        Ed sum = ed_add(acc, p);\n        u"
    "64 bit = widen<u64>((scalar[i / 8] >> narrow<u32>(i % 8)) & 1);\n        acc = ed_select(wrapping_sub"
    "(0, bit), sum, acc);\n    }\n    acc\n}fn ed_encode(Ed p) : array<u8, 32>\n{\n    array<u64, 5> zinv = fe"
    "_invert(p.z);\n    array<u8, 32> out = fe_to_bytes(fe_mul(p.y, zinv));\n    array<u8, 32> xb = fe_to_b"
    "ytes(fe_mul(p.x, zinv));\n    out[31] = out[31] | ((xb[0] & 1) << 7);\n    out\n}fn ed_decode(slice<u8,"
    " shared> b) : Option<Ed>\n{\n    array<u64, 5> y = fe_from_bytes(b);\n    array<u8, 32> canon = fe_to_b"
    "ytes(y);\n    u8 diff = 0;\n    for (usize i = 0; i < 31; i += 1)\n    {\n        diff = diff | (canon[i"
    "] ^ b[i]);\n    }\n    diff = diff | (canon[31] ^ (b[31] & 0x7f));\n    if (diff != 0)\n    {\n        re"
    "turn None;\n    }\n    u8 sign = b[31] >> 7;\n    array<u64, 5> y2 = fe_mul(y, y);\n    array<u64, 5> u "
    "= fe_sub(y2, [1, 0, 0, 0, 0]);\n    array<u64, 5> v = fe_add(fe_mul(ED_D, y2), [1, 0, 0, 0, 0]);\n    "
    "array<u64, 5> v3 = fe_mul(fe_mul(v, v), v);\n    array<u64, 5> v7 = fe_mul(fe_mul(v3, v3), v);\n    ar"
    "ray<u64, 5> x = fe_mul(fe_mul(u, v3), fe_pow_p58(fe_mul(u, v7)));\n    array<u64, 5> vx2 = fe_mul(v, "
    "fe_mul(x, x));\n    if (!fe_eq(vx2, u))\n    {\n        if (!fe_eq(vx2, fe_neg(u)))\n        {\n         "
    "   return None;\n        }\n        x = fe_mul(x, ED_SQRT_M1);\n    }\n    array<u8, 32> xb = fe_to_byte"
    "s(x);\n    if ((xb[0] & 1) == 0 && sign == 1 && fe_is_zero(x))\n    {\n        return None;\n    }\n    i"
    "f ((xb[0] & 1) != sign)\n    {\n        x = fe_neg(x);\n    }\n    Some(Ed { .x = x, .y = y, .z = [1, 0,"
    " 0, 0, 0], .t = fe_mul(x, y) })\n}fn ed_order() : Field\n{\n    Field { .m = [\n        0x5812631a5cf5d3"
    "ed,\n        0x14def9dea2f79cd6,\n        0x0000000000000000,\n        0x1000000000000000,\n        0x00"
    "00000000000000,\n        0x0000000000000000,\n    ], .n = 4, .minv = 0xd2b51da312547e1b, .r2 = [\n     "
    "   0xa40611e3449c0f01,\n        0xd00e1ba768859347,\n        0xceec73d217f5be65,\n        0x0399411b7c3"
    "09a3d,\n        0x0000000000000000,\n        0x0000000000000000,\n    ] }\n}fn le_limbs(slice<u8, shared"
    "> b) : array<u64, 6>\n{\n    array<u64, 6> r = [0; 6];\n    for (usize i = 0; i < 32; i += 1)\n    {\n   "
    "     r[i / 8] = r[i / 8] | (widen<u64>(b[i]) << narrow<u32>(8 * (i % 8)));\n    }\n    r\n}fn sc_mont(r"
    "ef<Field, shared> fl, array<u64, 6> a) : array<u64, 6>\n{\n    mont_mul(fl, a, fl.r2)\n}fn sc_from_hash"
    "(ref<Field, shared> fl, slice<u8, shared> h) : array<u64, 6>\n{\n    array<u64, 6> lo = sc_mont(fl, le"
    "_limbs(&h[0..32]));\n    array<u64, 6> hi = sc_mont(fl, sc_mont(fl, le_limbs(&h[32..64])));\n    f_add"
    "(fl, lo, hi)\n}fn sc_bytes(ref<Field, shared> fl, array<u64, 6> m) : array<u8, 32>\n{\n    array<u64, 6"
    "> a = f_from_mont(fl, m);\n    array<u8, 32> out = [0; 32];\n    for (usize i = 0; i < 32; i += 1)\n   "
    " {\n        out[i] = narrow_wrapping<u8>(a[i / 8] >> narrow<u32>(8 * (i % 8)));\n    }\n    out\n}fn ed_"
    "expand(slice<u8, shared> private_key) : EdExpanded\n{\n    if (slice_len(private_key) != 32)\n    {\n   "
    "     fault(crypto_length);\n    }\n    array<u8, 64> h = sha512(private_key);\n    array<u8, 32> s = [0"
    "; 32];\n    array<u8, 32> prefix = [0; 32];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        s[i] "
    "= h[i];\n        prefix[i] = h[32 + i];\n    }\n    s[0] = s[0] & 248;\n    s[31] = (s[31] & 127) | 64;\n"
    "    EdExpanded { .scalar = s, .prefix = prefix }\n}export fn ed25519_private_key() : array<u8, 32>\n{\n"
    "    array<u8, 32> k = [0; 32];\n    os_random_bytes(&mut k[0..$]);\n    k\n}export fn ed25519_public_ke"
    "y(slice<u8, shared> private_key) : array<u8, 32>\n{\n    EdExpanded e = ed_expand(private_key);\n    ed"
    "_encode(ed_mul(&e.scalar[0..$], ed_base()))\n}export fn ed25519_sign(slice<u8, shared> private_key, s"
    "lice<u8, shared> message) : array<u8, 64>\n{\n    EdExpanded e = ed_expand(private_key);\n    Field fl "
    "= ed_order();\n    array<u8, 32> a = ed_encode(ed_mul(&e.scalar[0..$], ed_base()));\n    Sha512 hr = S"
    "ha512::new();\n    Sha512::update(&mut hr, &e.prefix[0..$]);\n    Sha512::update(&mut hr, message);\n  "
    "  array<u64, 6> r = sc_from_hash(&fl, &Sha512::finish(hr)[0..$]);\n    array<u8, 32> r_bytes = sc_byt"
    "es(&fl, r);\n    array<u8, 32> big_r = ed_encode(ed_mul(&r_bytes[0..$], ed_base()));\n    Sha512 hk = "
    "Sha512::new();\n    Sha512::update(&mut hk, &big_r[0..$]);\n    Sha512::update(&mut hk, &a[0..$]);\n   "
    " Sha512::update(&mut hk, message);\n    array<u64, 6> k = sc_from_hash(&fl, &Sha512::finish(hk)[0..$]"
    ");\n    array<u64, 6> s = f_add(&fl, r, mont_mul(&fl, k, sc_mont(&fl, le_limbs(&e.scalar[0..$]))));\n "
    "   array<u8, 32> s_bytes = sc_bytes(&fl, s);\n    array<u8, 64> out = [0; 64];\n    for (usize i = 0; "
    "i < 32; i += 1)\n    {\n        out[i] = big_r[i];\n        out[32 + i] = s_bytes[i];\n    }\n    out\n}ex"
    "port fn ed25519_verify(slice<u8, shared> public_key, slice<u8, shared> message, slice<u8, shared> si"
    "gnature) : bool\n{\n    if (slice_len(public_key) != 32 || slice_len(signature) != 64)\n    {\n        r"
    "eturn false;\n    }\n    Ed a = match (ed_decode(public_key))\n    {\n        Some(p) : p,\n        None "
    "   : return false,\n    };\n    Ed big_r = match (ed_decode(&signature[0..32]))\n    {\n        Some(p) "
    ": p,\n        None    : return false,\n    };\n    Field fl = ed_order();\n    array<u64, 6> s = le_limb"
    "s(&signature[32..64]);\n    if (!f_less(&fl, s, fl.m))\n    {\n        return false;\n    }\n    Sha512 h"
    "k = Sha512::new();\n    Sha512::update(&mut hk, &signature[0..32]);\n    Sha512::update(&mut hk, publi"
    "c_key);\n    Sha512::update(&mut hk, message);\n    array<u8, 32> k = sc_bytes(&fl, sc_from_hash(&fl, "
    "&Sha512::finish(hk)[0..$]));\n    array<u8, 32> lhs = ed_encode(ed_mul(&signature[32..64], ed_base())"
    ");\n    array<u8, 32> rhs = ed_encode(ed_add(big_r, ed_mul(&k[0..$], a)));\n    digest_eq(&lhs[0..$], "
    "&rhs[0..$])\n}fn limbs_of(ref<BigUint, shared> a, usize n) : Vec<u64>\n{\n    Vec<u8> be = BigUint::to_"
    "bytes_be_padded(a, 8 * n);\n    Vec<u64> out = Vec::filled(n, 0: u64);\n    for (usize i = 0; i < 8 * "
    "n; i += 1)\n    {\n        out[i / 8] = out[i / 8] | (widen<u64>(be[8 * n - 1 - i]) << narrow<u32>(8 *"
    " (i % 8)));\n    }\n    out\n}fn biguint_of(ref<Vec<u64>, shared> limbs) : BigUint\n{\n    usize n = Vec:"
    ":len(limbs);\n    Vec<u8> be = Vec::filled(8 * n, 0: u8);\n    for (usize i = 0; i < 8 * n; i += 1)\n  "
    "  {\n        be[8 * n - 1 - i] = narrow_wrapping<u8>(limbs[i / 8] >> narrow<u32>(8 * (i % 8)));\n    }"
    "\n    BigUint::from_bytes_be(&be[0..$])\n}fn mont_new(ref<BigUint, shared> modulus) : Mont\n{\n    usize"
    " n = (BigUint::bit_len(modulus) + 63) / 64;\n    Vec<u64> m = limbs_of(modulus, n);\n    // m⁻¹ mod"
    " 2^64 by Newton's iteration from the odd m's own low limb.\n    u64 inv = 1;\n    for (usize i = 0; i "
    "< 7; i += 1)\n    {\n        inv = wrapping_mul(inv, wrapping_sub(2, wrapping_mul(m[0], inv)));\n    }\n"
    "    BigUint one = BigUint::from_u64(1);\n    BigUint r2 = BigUint::rem(&BigUint::shift_left(&one, 128"
    " * n), modulus);\n    Mont { .m = m, .n = n, .minv = wrapping_sub(0, inv), .r2 = limbs_of(&r2, n) }\n}"
    "fn mont_mul_v(ref<Mont, shared> f, ref<Vec<u64>, shared> a, ref<Vec<u64>, shared> b) : Vec<u64>\n{\n  "
    "  usize n = f.n;\n    Vec<u64> t = Vec::filled(n + 2, 0: u64);\n    for (usize i = 0; i < n; i += 1)\n "
    "   {\n        u128 c = 0;\n        u128 bi = widen<u128>(b[i]);\n        for (usize j = 0; j < n; j += "
    "1)\n        {\n            u128 x = widen<u128>(t[j]) + widen<u128>(a[j]) * bi + c;\n            t[j] ="
    " narrow_wrapping<u64>(x);\n            c = x >> 64;\n        }\n        u128 y = widen<u128>(t[n]) + c;"
    "\n        t[n] = narrow_wrapping<u64>(y);\n        t[n + 1] = narrow_wrapping<u64>(y >> 64);\n        u"
    "64 k = wrapping_mul(t[0], f.minv);\n        u128 kk = widen<u128>(k);\n        u128 z = widen<u128>(t["
    "0]) + kk * widen<u128>(f.m[0]);\n        c = z >> 64;\n        for (usize j = 1; j < n; j += 1)\n      "
    "  {\n            u128 x = widen<u128>(t[j]) + kk * widen<u128>(f.m[j]) + c;\n            t[j - 1] = na"
    "rrow_wrapping<u64>(x);\n            c = x >> 64;\n        }\n        u128 w = widen<u128>(t[n]) + c;\n  "
    "      t[n - 1] = narrow_wrapping<u64>(w);\n        t[n] = t[n + 1] + narrow_wrapping<u64>(w >> 64);\n "
    "   }\n    // t - m unless t (with its carry) is below m: chosen by a mask.\n    Vec<u64> r = Vec::fill"
    "ed(n, 0: u64);\n    u64 borrow = 0;\n    for (usize j = 0; j < n; j += 1)\n    {\n        u128 x = wrapp"
    "ing_sub(wrapping_sub(widen<u128>(t[j]), widen<u128>(f.m[j])), widen<u128>(borrow));\n        r[j] = n"
    "arrow_wrapping<u64>(x);\n        borrow = narrow_wrapping<u64>(x >> 127);\n    }\n    u64 keep = wrappi"
    "ng_sub(0, (1 - t[n]) & borrow);\n    for (usize j = 0; j < n; j += 1)\n    {\n        r[j] = (t[j] & ke"
    "ep) | (r[j] & ~keep);\n    }\n    r\n}fn mont_pow(ref<Mont, shared> f, ref<BigUint, shared> base, ref<B"
    "igUint, shared> exp) : BigUint\n{\n    biguint_of(&mont_pow_limbs(f, &limbs_of(base, f.n), exp))\n}fn m"
    "ont_pow_limbs(ref<Mont, shared> f, ref<Vec<u64>, shared> base, ref<BigUint, shared> exp) : Vec<u64>\n"
    "{\n    usize n = f.n;\n    Vec<u64> one = Vec::filled(n, 0: u64);\n    one[0] = 1;\n    Vec<u64> one_m ="
    " mont_mul_v(f, &one, &f.r2);\n    Vec<u64> base_m = mont_mul_v(f, base, &f.r2);\n    Vec<Vec<u64>> tab"
    "le = Vec::new();\n    Vec::push(&mut table, Vec::clone(&one_m));\n    for (usize i = 1; i < 16; i += 1"
    ")\n    {\n        Vec<u64> next = mont_mul_v(f, &table[i - 1], &base_m);\n        Vec::push(&mut table,"
    " next);\n    }\n    Vec<u64> e = limbs_of(exp, n);\n    Vec<u64> acc = Vec::clone(&one_m);\n    usize wi"
    "ndows = 16 * n;\n    usize w = windows;\n    while (w > 0)\n    {\n        w -= 1;\n        for (usize s "
    "= 0; s < 4; s += 1)\n        {\n            overwrite(&mut acc, mont_mul_v(f, &acc, &acc));\n        }\n"
    "        u64 bits = (e[w / 16] >> narrow<u32>(4 * (w % 16))) & 15;\n        Vec<u64> entry = Vec::fill"
    "ed(n, 0: u64);\n        for (u64 i = 0; i < 16; i += 1)\n        {\n            u64 x = i ^ bits;\n     "
    "       u64 mask = wrapping_sub(((x | wrapping_sub(0, x)) >> 63), 1);\n            for (usize j = 0; j"
    " < n; j += 1)\n            {\n                entry[j] = entry[j] | (table[narrow<usize>(i)][j] & mask"
    ");\n            }\n        }\n        overwrite(&mut acc, mont_mul_v(f, &acc, &entry));\n    }\n    mont_"
    "mul_v(f, &acc, &one)\n}export fn RsaPrivateKey::new(BigUint n, BigUint e, BigUint d, BigUint p, BigUi"
    "nt q) : Option<RsaPrivateKey>\n{\n    BigUint one = BigUint::from_u64(1);\n    BigUint two = BigUint::f"
    "rom_u64(2);\n    if (!BigUint::less(&two, &p) || !BigUint::less(&two, &q) || !BigUint::bit(&p, 0) || "
    "!BigUint::bit(&q, 0))\n    {\n        return None;\n    }\n    if (!BigUint::eq(&BigUint::mul(&p, &q), &"
    "n))\n    {\n        return None;\n    }\n    BigUint p1 = BigUint::sub(&p, &one);\n    BigUint q1 = BigUi"
    "nt::sub(&q, &one);\n    BigUint ed = BigUint::mul(&e, &d);\n    if (!BigUint::eq(&BigUint::rem(&ed, &p"
    "1), &one) || !BigUint::eq(&BigUint::rem(&ed, &q1), &one))\n    {\n        return None;\n    }\n    BigUi"
    "nt dp = BigUint::rem(&d, &p1);\n    BigUint dq = BigUint::rem(&d, &q1);\n    BigUint qinv = BigUint::m"
    "od_inverse(&q, &p)?;\n    Some(RsaPrivateKey { .n = n, .e = e, .d = d, .p = p, .q = q, .dp = dp, .dq "
    "= dq, .qinv = qinv })\n}export fn RsaPrivateKey::public_key(ref<RsaPrivateKey, shared> key) : RsaPubl"
    "icKey\n{\n    RsaPublicKey { .n = BigUint::clone(&key.n), .e = BigUint::clone(&key.e) }\n}fn limbs_sub_"
    "mod(ref<Mont, shared> f, ref<Vec<u64>, shared> a, ref<Vec<u64>, shared> b) : Vec<u64>\n{\n    usize n "
    "= f.n;\n    Vec<u64> r = Vec::filled(n, 0: u64);\n    u64 borrow = 0;\n    for (usize j = 0; j < n; j +"
    "= 1)\n    {\n        u128 x = wrapping_sub(wrapping_sub(widen<u128>(a[j]), widen<u128>(b[j])), widen<u"
    "128>(borrow));\n        r[j] = narrow_wrapping<u64>(x);\n        borrow = narrow_wrapping<u64>(x >> 12"
    "7);\n    }\n    // Add m back where it borrowed.\n    u64 mask = wrapping_sub(0, borrow);\n    u64 carry"
    " = 0;\n    for (usize j = 0; j < n; j += 1)\n    {\n        u128 x = widen<u128>(r[j]) + widen<u128>(f."
    "m[j] & mask) + widen<u128>(carry);\n        r[j] = narrow_wrapping<u64>(x);\n        carry = narrow_wr"
    "apping<u64>(x >> 64);\n    }\n    r\n}fn rsa_private_op(ref<RsaPrivateKey, shared> key, ref<BigUint, sh"
    "ared> m) : BigUint\n{\n    Mont mp = mont_new(&key.p);\n    Mont mq = mont_new(&key.q);\n    usize np = "
    "mp.n;\n    usize nq = mq.n;\n    // m1 = m^dp mod p, m2 = m^dq mod q (m reduced: public values).\n    V"
    "ec<u64> m1 = mont_pow_limbs(&mp, &limbs_of(&BigUint::rem(m, &key.p), np), &key.dp);\n    Vec<u64> m2 "
    "= mont_pow_limbs(&mq, &limbs_of(&BigUint::rem(m, &key.q), nq), &key.dq);\n    // h = qinv·(m1 - m2 m"
    "od p) mod p, on p's arithmetic.\n    Vec<u64> m2_mod_p = limbs_of(&BigUint::rem(&biguint_of(&m2), &ke"
    "y.p), np);\n    Vec<u64> diff = limbs_sub_mod(&mp, &m1, &m2_mod_p);\n    Vec<u64> qinv_m = mont_mul_v("
    "&mp, &limbs_of(&key.qinv, np), &mp.r2);\n    Vec<u64> h = mont_mul_v(&mp, &diff, &qinv_m);\n    // s ="
    " m2 + h·q: a plain product over limbs, then the sum.\n    Vec<u64> q_limbs = limbs_of(&key.q, nq);\n "
    "   Vec<u64> s = Vec::filled(np + nq + 1, 0: u64);\n    for (usize i = 0; i < np; i += 1)\n    {\n      "
    "  u128 carry = 0;\n        u128 hi = widen<u128>(h[i]);\n        for (usize j = 0; j < nq; j += 1)\n   "
    "     {\n            u128 x = widen<u128>(s[i + j]) + hi * widen<u128>(q_limbs[j]) + carry;\n          "
    "  s[i + j] = narrow_wrapping<u64>(x);\n            carry = x >> 64;\n        }\n        s[i + nq] = nar"
    "row_wrapping<u64>(carry);\n    }\n    u128 c = 0;\n    for (usize j = 0; j < np + nq + 1; j += 1)\n    {"
    "\n        u128 x = widen<u128>(s[j]) + (if (j < nq) { widen<u128>(m2[j]) } else { 0 }) + c;\n        s"
    "[j] = narrow_wrapping<u64>(x);\n        c = x >> 64;\n    }\n    BigUint result = biguint_of(&s);\n    /"
    "/ Checked against the public key: a wrong result would leak the\n    // primes, so a key that fails i"
    "s used without the CRT instead.\n    if (BigUint::eq(&BigUint::mod_pow(&result, &key.e, &key.n), m))\n"
    "    {\n        return result;\n    }\n    Mont mn = mont_new(&key.n);\n    mont_pow(&mn, m, &key.d)\n}fn "
    "pkcs1v15_encode(HashKind kind, slice<u8, shared> digest, usize k) : Vec<u8>\n{\n    Vec<u8> prefix = d"
    "igest_info_prefix(kind);\n    usize t_len = Vec::len(&prefix) + slice_len(digest);\n    if (slice_len("
    "digest) != hash_len(kind) || k < t_len + 11)\n    {\n        fault(crypto_length);\n    }\n    Vec<u8> e"
    "m = Vec::new();\n    Vec::push(&mut em, 0);\n    Vec::push(&mut em, 1);\n    for (usize i = 0; i < k - "
    "t_len - 3; i += 1)\n    {\n        Vec::push(&mut em, 0xff);\n    }\n    Vec::push(&mut em, 0);\n    Vec:"
    ":extend_from(&mut em, &prefix[0..$]);\n    Vec::extend_from(&mut em, digest);\n    em\n}export fn rsa_s"
    "ign_pkcs1v15(ref<RsaPrivateKey, shared> key, HashKind kind, slice<u8, shared> digest) : Vec<u8>\n{\n  "
    "  usize k = (BigUint::bit_len(&key.n) + 7) / 8;\n    Vec<u8> em = pkcs1v15_encode(kind, digest, k);\n "
    "   BigUint s = rsa_private_op(key, &BigUint::from_bytes_be(&em[0..$]));\n    BigUint::to_bytes_be_pad"
    "ded(&s, k)\n}export fn rsa_sign_pss(ref<RsaPrivateKey, shared> key, HashKind kind, slice<u8, shared> "
    "digest) : Vec<u8>\n{\n    usize mod_bits = BigUint::bit_len(&key.n);\n    usize k = (mod_bits + 7) / 8;"
    "\n    usize h_len = hash_len(kind);\n    usize em_bits = mod_bits - 1;\n    usize em_len = (em_bits + 7"
    ") / 8;\n    if (slice_len(digest) != h_len || em_len < 2 * h_len + 2)\n    {\n        fault(crypto_leng"
    "th);\n    }\n    Vec<u8> salt = Vec::filled(h_len, 0: u8);\n    os_random_bytes(&mut salt[0..$]);\n    V"
    "ec<u8> m2 = Vec::filled(8, 0: u8);\n    Vec::extend_from(&mut m2, digest);\n    Vec::extend_from(&mut "
    "m2, &salt[0..$]);\n    Vec<u8> h = hash(kind, &m2[0..$]);\n    usize db_len = em_len - h_len - 1;\n    "
    "Vec<u8> db = Vec::filled(db_len - h_len - 1, 0: u8);\n    Vec::push(&mut db, 1);\n    Vec::extend_from"
    "(&mut db, &salt[0..$]);\n    Vec<u8> mask = mgf1(kind, &h[0..$], db_len);\n    Vec<u8> em = Vec::new()"
    ";\n    for (usize i = 0; i < db_len; i += 1)\n    {\n        Vec::push(&mut em, db[i] ^ mask[i]);\n    }"
    "\n    u32 unused = narrow<u32>(8 * em_len - em_bits);\n    em[0] = em[0] & narrow_wrapping<u8>((0xff: "
    "u32) >> unused);\n    Vec::extend_from(&mut em, &h[0..$]);\n    Vec::push(&mut em, 0xbc);\n    BigUint "
    "s = rsa_private_op(key, &BigUint::from_bytes_be(&em[0..$]));\n    BigUint::to_bytes_be_padded(&s, k)\n"
    "}fn small_primes() : Vec<u32>\n{\n    Vec<u32> out = Vec::new();\n    for (u32 c = 3; c < 1000; c += 2)"
    "\n    {\n        bool prime = true;\n        for (usize i = 0; i < Vec::len(&out) && out[i] * out[i] <="
    " c; i += 1)\n        {\n            if (c % out[i] == 0)\n            {\n                prime = false;\n"
    "                break;\n            }\n        }\n        if (prime)\n        {\n            Vec::push(&m"
    "ut out, c);\n        }\n    }\n    out\n}fn probably_prime(ref<BigUint, shared> c, ref<Vec<u32>, shared>"
    " primes, usize rounds) : bool\n{\n    for (usize i = 0; i < Vec::len(primes); i += 1)\n    {\n        Bi"
    "gUint p = BigUint::from_u64(widen<u64>(primes[i]));\n        if (BigUint::is_zero(&BigUint::rem(c, &p"
    ")))\n        {\n            return BigUint::eq(c, &p);\n        }\n    }\n    BigUint one = BigUint::from"
    "_u64(1);\n    BigUint c1 = BigUint::sub(c, &one);\n    usize a = 0;\n    while (!BigUint::bit(&c1, a))\n"
    "    {\n        a += 1;\n    }\n    BigUint m = BigUint::shift_right(&c1, a);\n    Mont f = mont_new(c);\n"
    "    usize k = (BigUint::bit_len(c) + 7) / 8;\n    Vec<u8> rb = Vec::filled(k, 0: u8);\n    BigUint two"
    " = BigUint::from_u64(2);\n    for (usize round = 0; round < rounds; round += 1)\n    {\n        os_rand"
    "om_bytes(&mut rb[0..$]);\n        BigUint b = BigUint::add(\n            &BigUint::rem(&BigUint::from_"
    "bytes_be(&rb[0..$]), &BigUint::sub(c, &BigUint::from_u64(3))),\n            &two,\n        );\n        "
    "BigUint z = mont_pow(&f, &b, &m);\n        if (BigUint::eq(&z, &one) || BigUint::eq(&z, &c1))\n       "
    " {\n            continue;\n        }\n        bool witness = true;\n        for (usize j = 1; j < a; j +"
    "= 1)\n        {\n            overwrite(&mut z, BigUint::rem(&BigUint::mul(&z, &z), c));\n            if"
    " (BigUint::eq(&z, &c1))\n            {\n                witness = false;\n                break;\n      "
    "      }\n            if (BigUint::eq(&z, &one))\n            {\n                return false;\n         "
    "   }\n        }\n        if (witness)\n        {\n            return false;\n        }\n    }\n    true\n}fn"
    " random_prime(usize bits, ref<BigUint, shared> e, ref<Vec<u32>, shared> primes) : BigUint\n{\n    usiz"
    "e k = (bits + 7) / 8;\n    Vec<u8> rb = Vec::filled(k, 0: u8);\n    BigUint one = BigUint::from_u64(1)"
    ";\n    while (true)\n    {\n        os_random_bytes(&mut rb[0..$]);\n        BigUint c = BigUint::from_b"
    "ytes_be(&rb[0..$]);\n        // Exactly `bits` bits with the top two set, and odd.\n        BigUint to"
    "p = BigUint::shift_left(&one, bits - 1);\n        BigUint second = BigUint::shift_left(&one, bits - 2"
    ");\n        BigUint mask = BigUint::sub(&BigUint::shift_left(&one, bits), &one);\n        BigUint c2 ="
    " BigUint::rem(&c, &BigUint::add(&mask, &one));\n        BigUint c3 = BigUint::add(&BigUint::rem(&c2, "
    "&second), &BigUint::add(&top, &second));\n        if (!BigUint::bit(&c3, 0))\n        {\n            ov"
    "erwrite(&mut c3, BigUint::add(&c3, &one));\n        }\n        BigUint c4 = BigUint::sub(&c3, &one);\n "
    "       if (BigUint::is_zero(&BigUint::rem(&c4, e)))\n        {\n            continue;\n        }\n      "
    "  if (probably_prime(&c3, primes, 5))\n        {\n            return c3;\n        }\n    }\n}export fn rs"
    "a_generate_key(usize bits) : RsaPrivateKey\n{\n    if (bits < 1024 || bits > 8192 || bits % 64 != 0)\n "
    "   {\n        fault(crypto_length);\n    }\n    Vec<u32> primes = small_primes();\n    BigUint e = BigUi"
    "nt::from_u64(65537);\n    BigUint one = BigUint::from_u64(1);\n    while (true)\n    {\n        BigUint "
    "p = random_prime(bits / 2, &e, &primes);\n        BigUint q = random_prime(bits / 2, &e, &primes);\n  "
    "      if (BigUint::eq(&p, &q))\n        {\n            continue;\n        }\n        BigUint n = BigUint"
    "::mul(&p, &q);\n        BigUint p1 = BigUint::sub(&p, &one);\n        BigUint q1 = BigUint::sub(&q, &o"
    "ne);\n        BigUint phi = BigUint::mul(&p1, &q1);\n        BigUint d = match (BigUint::mod_inverse(&"
    "e, &phi))\n        {\n            Some(v) : v,\n            None    : continue,\n        };\n        if ("
    "Some(key) = RsaPrivateKey::new(n, BigUint::clone(&e), d, p, q))\n        {\n            return key;\n  "
    "      }\n    }\n}export fn CertError::text(ref<CertError, shared> e) : str\n{\n    match (e)\n    {\n     "
    "   BadEncoding          : \"malformed certificate\",\n        Expired              : \"certificate expir"
    "ed\",\n        NotYetValid          : \"certificate not yet valid\",\n        UnknownAuthority     : \"cer"
    "tificate signed by an unknown authority\",\n        HostMismatch         : \"certificate is not for thi"
    "s host\",\n        BadSignature         : \"certificate signature does not verify\",\n        NotAuthorit"
    "y         : \"issuer is not a certificate authority\",\n        UnsupportedAlgorithm : \"unsupported key"
    " or signature algorithm\",\n        UnhandledCritical    : \"unhandled critical extension\",\n        Wro"
    "ngUsage           : \"certificate not usable for a TLS server\",\n        ChainTooLong         : \"certi"
    "ficate chain too long\",\n    }\n}export fn der_read(slice<u8, shared> buf, usize at) : Option<Der>\n{\n "
    "   usize n = slice_len(buf);\n    if (at + 2 > n)\n    {\n        return None;\n    }\n    u8 tag = buf[a"
    "t];\n    if ((tag & 0x1f) == 0x1f)\n    {\n        return None;\n    }\n    u8 first = buf[at + 1];\n    u"
    "size len = 0;\n    usize start = at + 2;\n    if (first < 0x80)\n    {\n        len = widen<usize>(first"
    ");\n    }\n    else\n    {\n        usize count = widen<usize>(first & 0x7f);\n        if (count == 0 || "
    "count > 4 || start + count > n || buf[start] == 0)\n        {\n            return None;\n        }\n    "
    "    for (usize i = 0; i < count; i += 1)\n        {\n            len = (len << 8) | widen<usize>(buf[s"
    "tart + i]);\n        }\n        if (len < 0x80)\n        {\n            return None;\n        }\n        s"
    "tart += count;\n    }\n    if (len > n - start)\n    {\n        return None;\n    }\n    Some(Der { .tag ="
    " tag, .start = start, .end = start + len, .next = start + len })\n}fn der_expect(slice<u8, shared> bu"
    "f, usize at, u8 tag) : Result<Der, CertError>\n{\n    match (der_read(buf, at))\n    {\n        Some(d) "
    ": if (d.tag == tag) { Ok(d) } else { Err(BadEncoding) },\n        None    : Err(BadEncoding),\n    }\n}"
    "fn der_bytes(slice<u8, shared> buf, Der d) : Vec<u8>\n{\n    Vec::from_slice(&buf[d.start..d.end])\n}fn"
    " der_eq_hex(slice<u8, shared> buf, Der d, str hex) : bool\n{\n    Vec<u8> want = Result::unwrap_or(fro"
    "m_hex(StringView::of(hex)), Vec::new());\n    d.end - d.start == Vec::len(&want) && digest_eq(&buf[d."
    "start..d.end], &want[0..$])\n}fn hash_oid(slice<u8, shared> buf, Der d) : Option<HashKind>\n{\n    if ("
    "der_eq_hex(buf, d, \"608648016503040201\"))\n    {\n        return Some(Sha2_256);\n    }\n    if (der_eq_"
    "hex(buf, d, \"608648016503040202\"))\n    {\n        return Some(Sha2_384);\n    }\n    if (der_eq_hex(buf"
    ", d, \"608648016503040203\"))\n    {\n        return Some(Sha2_512);\n    }\n    None\n}fn signature_algori"
    "thm(slice<u8, shared> buf, Der alg) : Result<SignatureScheme, CertError>\n{\n    Der oid = der_expect("
    "buf, alg.start, 0x06)?;\n    if (der_eq_hex(buf, oid, \"2a864886f70d01010b\"))\n    {\n        return Ok("
    "RsaPkcs1(Sha2_256));\n    }\n    if (der_eq_hex(buf, oid, \"2a864886f70d01010c\"))\n    {\n        return "
    "Ok(RsaPkcs1(Sha2_384));\n    }\n    if (der_eq_hex(buf, oid, \"2a864886f70d01010d\"))\n    {\n        retu"
    "rn Ok(RsaPkcs1(Sha2_512));\n    }\n    if (der_eq_hex(buf, oid, \"2a8648ce3d040302\"))\n    {\n        ret"
    "urn Ok(Ecdsa(Sha2_256));\n    }\n    if (der_eq_hex(buf, oid, \"2a8648ce3d040303\"))\n    {\n        retur"
    "n Ok(Ecdsa(Sha2_384));\n    }\n    if (der_eq_hex(buf, oid, \"2a8648ce3d040304\"))\n    {\n        return "
    "Ok(Ecdsa(Sha2_512));\n    }\n    if (der_eq_hex(buf, oid, \"2b6570\"))\n    {\n        return Ok(Ed25519);"
    "\n    }\n    if (der_eq_hex(buf, oid, \"2a864886f70d01010a\"))\n    {\n        // RSASSA-PSS-params: [0] h"
    "ashAlgorithm, [1] maskGenAlgorithm,\n        // [2] saltLength; the hash must be SHA-2 and MGF1 over "
    "it, and the\n        // salt as long as the digest.\n        Der params = der_expect(buf, oid.next, 0x"
    "30)?;\n        Der h0 = der_expect(buf, params.start, 0xa0)?;\n        Der h_alg = der_expect(buf, h0."
    "start, 0x30)?;\n        Der h_oid = der_expect(buf, h_alg.start, 0x06)?;\n        HashKind kind = matc"
    "h (hash_oid(buf, h_oid))\n        {\n            Some(k) : k,\n            None    : return Ok(Unsuppor"
    "tedSignature),\n        };\n        return Ok(RsaPss(kind));\n    }\n    Ok(UnsupportedSignature)\n}fn de"
    "r_text(slice<u8, shared> buf, Der d) : Option<String>\n{\n    if (d.tag != 0x0c && d.tag != 0x13 && d."
    "tag != 0x16 && d.tag != 0x14)\n    {\n        return None;\n    }\n    match (String::from_utf8(der_byte"
    "s(buf, d)))\n    {\n        Ok(s)  : Some(s),\n        Err(_) : None,\n    }\n}fn common_name_of(slice<u8"
    ", shared> buf, Der name) : String\n{\n    String cn = String::new();\n    usize at = name.start;\n    wh"
    "ile (at < name.end)\n    {\n        Der set = match (der_read(buf, at))\n        {\n            Some(d) "
    ": d,\n            None    : return cn,\n        };\n        usize inner = set.start;\n        while (inn"
    "er < set.end)\n        {\n            Der atv = match (der_read(buf, inner))\n            {\n           "
    "     Some(d) : d,\n                None    : return cn,\n            };\n            if (Some(oid) = de"
    "r_read(buf, atv.start))\n            {\n                if (oid.tag == 0x06 && der_eq_hex(buf, oid, \"5"
    "50403\"))\n                {\n                    if (Some(v) = der_read(buf, oid.next))\n              "
    "      {\n                        if (Some(t) = der_text(buf, v))\n                        {\n          "
    "                  overwrite(&mut cn, t);\n                        }\n                    }\n           "
    "     }\n            }\n            inner = atv.next;\n        }\n        at = set.next;\n    }\n    cn\n}fn"
    " digits(slice<u8, shared> b, usize at, usize n) : Option<i64>\n{\n    i64 x = 0;\n    for (usize i = at"
    "; i < at + n; i += 1)\n    {\n        if (i >= slice_len(b) || !ascii_is_digit(b[i]))\n        {\n      "
    "      return None;\n        }\n        x = x * 10 + widen<i64>(b[i] - b'0');\n    }\n    Some(x)\n}fn der"
    "_time(slice<u8, shared> buf, Der d) : Result<DateTime, CertError>\n{\n    slice<u8, shared> t = &buf[d"
    ".start..d.end];\n    usize n = slice_len(t);\n    i64 year = 0;\n    usize at = 0;\n    if (d.tag == 0x1"
    "7 && n == 13)\n    {\n        i64 yy = match (digits(t, 0, 2))\n        {\n            Some(y) : y,\n    "
    "        None    : return Err(BadEncoding),\n        };\n        year = if (yy < 50) { 2000 + yy } else"
    " { 1900 + yy };\n        at = 2;\n    }\n    else if (d.tag == 0x18 && n == 15)\n    {\n        year = ma"
    "tch (digits(t, 0, 4))\n        {\n            Some(y) : y,\n            None    : return Err(BadEncodin"
    "g),\n        };\n        at = 4;\n    }\n    else\n    {\n        return Err(BadEncoding);\n    }\n    if (t"
    "[n - 1] != b'Z')\n    {\n        return Err(BadEncoding);\n    }\n    Option<i64> mo = digits(t, at, 2);"
    "\n    Option<i64> dd = digits(t, at + 2, 2);\n    Option<i64> hh = digits(t, at + 4, 2);\n    Option<i6"
    "4> mi = digits(t, at + 6, 2);\n    Option<i64> ss = digits(t, at + 8, 2);\n    if (Some(m) = mo)\n    {"
    "\n        if (Some(day) = dd)\n        {\n            if (Some(h) = hh)\n            {\n                i"
    "f (Some(min) = mi)\n                {\n                    if (Some(sec) = ss)\n                    {\n "
    "                       if (m <= 12 && day <= 31 && h <= 23 && min <= 59 && sec <= 59)\n              "
    "          {\n                            if (Some(dt) = DateTime::new(\n                              "
    "  year,\n                                narrow<u8>(m),\n                                narrow<u8>(da"
    "y),\n                                narrow<u8>(h),\n                                narrow<u8>(min),\n"
    "                                narrow<u8>(sec),\n                            ))\n                    "
    "        {\n                                return Ok(dt);\n                            }\n             "
    "           }\n                    }\n                }\n            }\n        }\n    }\n    Err(BadEncodi"
    "ng)\n}fn public_key_of(slice<u8, shared> buf, Der spki) : Result<CertKey, CertError>\n{\n    Der alg = "
    "der_expect(buf, spki.start, 0x30)?;\n    Der bits = der_expect(buf, alg.next, 0x03)?;\n    if (bits.en"
    "d == bits.start || buf[bits.start] != 0)\n    {\n        return Err(BadEncoding);\n    }\n    usize key_"
    "start = bits.start + 1;\n    Der oid = der_expect(buf, alg.start, 0x06)?;\n    if (der_eq_hex(buf, oid"
    ", \"2a864886f70d010101\"))\n    {\n        Der seq = der_expect(buf, key_start, 0x30)?;\n        Der n = "
    "der_expect(buf, seq.start, 0x02)?;\n        Der e = der_expect(buf, n.next, 0x02)?;\n        return Ok"
    "(RsaKey(RsaPublicKey { .n = BigUint::from_bytes_be(&buf[n.start..n.end]), .e = BigUint::from_bytes_b"
    "e(&buf[e.start..e.end]) }));\n    }\n    if (der_eq_hex(buf, oid, \"2a8648ce3d0201\"))\n    {\n        Der"
    " curve = der_expect(buf, oid.next, 0x06)?;\n        Vec<u8> point = Vec::from_slice(&buf[key_start..b"
    "its.end]);\n        if (der_eq_hex(buf, curve, \"2a8648ce3d030107\"))\n        {\n            return Ok(E"
    "cKey(EcPublicKey { .curve = P256, .point = point }));\n        }\n        if (der_eq_hex(buf, curve, \""
    "2b81040022\"))\n        {\n            return Ok(EcKey(EcPublicKey { .curve = P384, .point = point }));"
    "\n        }\n    }\n    if (der_eq_hex(buf, oid, \"2b6570\"))\n    {\n        if (bits.end - key_start != 3"
    "2)\n        {\n            return Err(BadEncoding);\n        }\n        array<u8, 32> k = [0; 32];\n     "
    "   for (usize i = 0; i < 32; i += 1)\n        {\n            k[i] = buf[key_start + i];\n        }\n    "
    "    return Ok(Ed25519Key(k));\n    }\n    Ok(UnsupportedKey)\n}export fn Certificate::parse(slice<u8, s"
    "hared> der) : Result<Certificate, CertError>\n{\n    Der cert = der_expect(der, 0, 0x30)?;\n    if (cer"
    "t.next != slice_len(der))\n    {\n        return Err(BadEncoding);\n    }\n    Der tbs = der_expect(der,"
    " cert.start, 0x30)?;\n    Der outer_alg = der_expect(der, tbs.next, 0x30)?;\n    Der sig_bits = der_ex"
    "pect(der, outer_alg.next, 0x03)?;\n    if (sig_bits.next != cert.end || sig_bits.end == sig_bits.star"
    "t || der[sig_bits.start] != 0)\n    {\n        return Err(BadEncoding);\n    }\n    SignatureScheme sche"
    "me = signature_algorithm(der, outer_alg)?;\n    usize at = tbs.start;\n    Der first = match (der_read"
    "(der, at))\n    {\n        Some(d) : d,\n        None    : return Err(BadEncoding),\n    };\n    if (firs"
    "t.tag == 0xa0)\n    {\n        at = first.next;\n    }\n    Der serial = der_expect(der, at, 0x02)?;\n   "
    " Der inner_alg = der_expect(der, serial.next, 0x30)?;\n    // The signature algorithm inside the sign"
    "ed part must be the outer one.\n    if (inner_alg.end - inner_alg.start != outer_alg.end - outer_alg."
    "start || !digest_eq(\n        &der[inner_alg.start..inner_alg.end],\n        &der[outer_alg.start..out"
    "er_alg.end],\n    ))\n    {\n        return Err(BadEncoding);\n    }\n    Der issuer = der_expect(der, in"
    "ner_alg.next, 0x30)?;\n    Der validity = der_expect(der, issuer.next, 0x30)?;\n    Der nb = match (de"
    "r_read(der, validity.start))\n    {\n        Some(d) : d,\n        None    : return Err(BadEncoding),\n "
    "   };\n    Der na = match (der_read(der, nb.next))\n    {\n        Some(d) : d,\n        None    : retur"
    "n Err(BadEncoding),\n    };\n    DateTime not_before = der_time(der, nb)?;\n    DateTime not_after = de"
    "r_time(der, na)?;\n    Der subject = der_expect(der, validity.next, 0x30)?;\n    Der spki = der_expect"
    "(der, subject.next, 0x30)?;\n    CertKey key = public_key_of(der, spki)?;\n    Certificate c = Certifi"
    "cate { .der = Vec::from_slice(der), .tbs = Vec::from_slice(&der[cert.start..tbs.next]), .issuer = Ve"
    "c::from_slice(&der[inner_alg.next..issuer.next]), .subject = Vec::from_slice(&der[validity.next..sub"
    "ject.next]), .common_name = common_name_of(\n        der,\n        subject,\n    ), .not_before = not_b"
    "efore, .not_after = not_after, .dns_names = Vec::new(), .ip_addresses = Vec::new(), .is_ca = false, "
    ".max_path_len = -1, .can_sign_certificates = true, .server_auth = true, .unhandled_critical = false,"
    " .key = key, .scheme = scheme, .signature = Vec::from_slice(&der[sig_bits.start + 1..sig_bits.end]) "
    "};\n    at = spki.next;\n    while (at < tbs.end)\n    {\n        Der field = match (der_read(der, at))\n"
    "        {\n            Some(d) : d,\n            None    : return Err(BadEncoding),\n        };\n       "
    " if (field.tag == 0xa3)\n        {\n            Der exts = der_expect(der, field.start, 0x30)?;\n      "
    "      usize e_at = exts.start;\n            while (e_at < exts.end)\n            {\n                Der"
    " ext = der_expect(der, e_at, 0x30)?;\n                Der oid = der_expect(der, ext.start, 0x06)?;\n  "
    "              usize v_at = oid.next;\n                bool critical = false;\n                Der mayb"
    "e = match (der_read(der, v_at))\n                {\n                    Some(d) : d,\n                 "
    "   None    : return Err(BadEncoding),\n                };\n                if (maybe.tag == 0x01)\n    "
    "            {\n                    critical = maybe.end > maybe.start && der[maybe.start] != 0;\n     "
    "               v_at = maybe.next;\n                }\n                Der value = der_expect(der, v_at"
    ", 0x04)?;\n                if (der_eq_hex(der, oid, \"551d11\"))\n                {\n                    "
    "Der names = der_expect(der, value.start, 0x30)?;\n                    usize n_at = names.start;\n     "
    "               while (n_at < names.end)\n                    {\n                        Der g = match "
    "(der_read(der, n_at))\n                        {\n                            Some(d) : d,\n           "
    "                 None    : return Err(BadEncoding),\n                        };\n                     "
    "   if (g.tag == 0x82)\n                        {\n                            if (Ok(s) = String::from"
    "_utf8(der_bytes(der, g)))\n                            {\n                                Vec::push(&m"
    "ut c.dns_names, s);\n                            }\n                        }\n                        "
    "else if (g.tag == 0x87)\n                        {\n                            usize len = g.end - g."
    "start;\n                            if (len == 4)\n                            {\n                     "
    "           Vec::push(\n                                    &mut c.ip_addresses,\n                     "
    "               V4([der[g.start], der[g.start + 1], der[g.start + 2], der[g.start + 3]]),\n           "
    "                     );\n                            }\n                            else if (len == 16"
    ")\n                            {\n                                array<u8, 16> a = [0; 16];\n         "
    "                       for (usize i = 0; i < 16; i += 1)\n                                {\n         "
    "                           a[i] = der[g.start + i];\n                                }\n              "
    "                  Vec::push(&mut c.ip_addresses, V6(a));\n                            }\n             "
    "           }\n                        n_at = g.next;\n                    }\n                }\n        "
    "        else if (der_eq_hex(der, oid, \"551d13\"))\n                {\n                    Der bc = der_"
    "expect(der, value.start, 0x30)?;\n                    usize b_at = bc.start;\n                    if ("
    "b_at < bc.end)\n                    {\n                        Der x = match (der_read(der, b_at))\n   "
    "                     {\n                            Some(d) : d,\n                            None    "
    ": return Err(BadEncoding),\n                        };\n                        if (x.tag == 0x01)\n   "
    "                     {\n                            c.is_ca = x.end > x.start && der[x.start] != 0;\n "
    "                           b_at = x.next;\n                        }\n                    }\n          "
    "          if (b_at < bc.end)\n                    {\n                        Der pl = der_expect(der, "
    "b_at, 0x02)?;\n                        i64 v = 0;\n                        for (usize i = pl.start; i "
    "< pl.end && i < pl.start + 4; i += 1)\n                        {\n                            v = (v <"
    "< 8) | widen<i64>(der[i]);\n                        }\n                        c.max_path_len = v;\n   "
    "                 }\n                }\n                else if (der_eq_hex(der, oid, \"551d0f\"))\n      "
    "          {\n                    Der ku = der_expect(der, value.start, 0x03)?;\n                    //"
    " Bit 5, keyCertSign, of the first byte after the\n                    // unused-bits count.\n         "
    "           c.can_sign_certificates = ku.end - ku.start >= 2 && (der[ku.start + 1] & 0x04) != 0;\n    "
    "            }\n                else if (der_eq_hex(der, oid, \"551d25\"))\n                {\n           "
    "         Der eku = der_expect(der, value.start, 0x30)?;\n                    bool server = false;\n   "
    "                 usize k_at = eku.start;\n                    while (k_at < eku.end)\n                "
    "    {\n                        Der p = der_expect(der, k_at, 0x06)?;\n                        if (der_"
    "eq_hex(der, p, \"2b06010505070301\") || der_eq_hex(der, p, \"551d2500\"))\n                        {\n    "
    "                        server = true;\n                        }\n                        k_at = p.ne"
    "xt;\n                    }\n                    c.server_auth = server;\n                }\n            "
    "    else if (critical && !der_eq_hex(der, oid, \"551d20\") && !der_eq_hex(der, oid, \"551d1e\"))\n       "
    "         {\n                    // An unknown critical extension; certificate policies\n              "
    "      // and name constraints are tolerated unread (D-0160).\n                    c.unhandled_critica"
    "l = true;\n                }\n                e_at = ext.next;\n            }\n        }\n        at = fi"
    "eld.next;\n    }\n    Ok(c)\n}export fn certificates_from_pem(StringView text) : Vec<Certificate>\n{\n   "
    " Vec<Certificate> out = Vec::new();\n    StringView begin = \"-----BEGIN CERTIFICATE-----\";\n    String"
    "View end = \"-----END CERTIFICATE-----\";\n    usize at = 0;\n    usize n = StringView::len(text);\n    w"
    "hile (at < n)\n    {\n        StringView rest = StringView::sub(text, at, n);\n        usize b = match "
    "(StringView::find(rest, begin))\n        {\n            Some(i) : i,\n            None    : break,\n    "
    "    };\n        StringView body = StringView::sub(rest, b + StringView::len(begin), StringView::len(r"
    "est));\n        usize e = match (StringView::find(body, end))\n        {\n            Some(i) : i,\n    "
    "        None    : break,\n        };\n        String b64 = String::new();\n        StringView block = S"
    "tringView::sub(body, 0, e);\n        // A byte that is not ASCII (so not base64 either) makes the blo"
    "ck\n        // malformed: skipped, like one whose base64 does not decode.\n        bool clean = true;\n"
    "        for (usize i = 0; i < StringView::len(block); i += 1)\n        {\n            u8 c = block.byt"
    "es[i];\n            if (c >= 128)\n            {\n                clean = false;\n                break;"
    "\n            }\n            if (!ascii_is_space(c))\n            {\n                String::push_ascii("
    "&mut b64, c);\n            }\n        }\n        if (clean)\n        {\n            if (Ok(der) = base64_"
    "decode(String::as_view(&b64)))\n            {\n                if (Ok(cert) = Certificate::parse(&der["
    "0..$]))\n                {\n                    Vec::push(&mut out, cert);\n                }\n         "
    "   }\n        }\n        at = at + b + StringView::len(begin) + e + StringView::len(end);\n    }\n    ou"
    "t\n}export fn TrustStore::new() : TrustStore\n{\n    TrustStore { .roots = Vec::new() }\n}export fn Trus"
    "tStore::add(ref<TrustStore, exclusive> t, Certificate root)\n{\n    Vec::push(&mut t.roots, root);\n}ex"
    "port fn TrustStore::from_pem_file(StringView path) : Result<TrustStore, FileError>\n{\n    String text"
    " = read_file(path)?;\n    Ok(TrustStore { .roots = certificates_from_pem(String::as_view(&text)) })\n}"
    "export fn TrustStore::system() : Result<TrustStore, FileError>\n{\n    array<str, 5> paths = [\n       "
    " \"/etc/ssl/certs/ca-certificates.crt\",\n        \"/etc/pki/tls/certs/ca-bundle.crt\",\n        \"/etc/ssl"
    "/ca-bundle.pem\",\n        \"/etc/ssl/cert.pem\",\n        \"/usr/local/etc/openssl/cert.pem\",\n    ];\n    "
    "foreach (p in &paths)\n    {\n        if (Ok(t) = TrustStore::from_pem_file(StringView::of(*p)))\n     "
    "   {\n            if (Vec::len(&t.roots) > 0)\n            {\n                return Ok(t);\n           "
    " }\n        }\n    }\n    Err(NotFound)\n}export fn verify_signature(\n    ref<CertKey, shared> key,\n    "
    "ref<SignatureScheme, shared> scheme,\n    slice<u8, shared> message,\n    slice<u8, shared> signature,"
    "\n) : bool\n{\n    match (scheme)\n    {\n        RsaPkcs1(h) : match (key)\n        {\n            RsaKey("
    "k) : rsa_verify_pkcs1v15(k, *h, &hash(*h, message)[0..$], signature),\n            _         : false,"
    "\n        },\n        RsaPss(h) : match (key)\n        {\n            RsaKey(k) : rsa_verify_pss(k, *h, "
    "&hash(*h, message)[0..$], signature),\n            _         : false,\n        },\n        Ecdsa(h) : m"
    "atch (key)\n        {\n            EcKey(k) : ecdsa_verify(k.curve, &k.point[0..$], &hash(*h, message)"
    "[0..$], signature),\n            _        : false,\n        },\n        Ed25519 : match (key)\n        {"
    "\n            Ed25519Key(k) : ed25519_verify(&k[0..$], message, signature),\n            _            "
    " : false,\n        },\n        UnsupportedSignature : false,\n    }\n}fn ascii_lower_eq(StringView a, St"
    "ringView b) : bool\n{\n    if (StringView::len(a) != StringView::len(b))\n    {\n        return false;\n "
    "   }\n    for (usize i = 0; i < StringView::len(a); i += 1)\n    {\n        u8 x = a.bytes[i];\n        "
    "u8 y = b.bytes[i];\n        if (ascii_is_upper(x))\n        {\n            x += 32;\n        }\n        i"
    "f (ascii_is_upper(y))\n        {\n            y += 32;\n        }\n        if (x != y)\n        {\n       "
    "     return false;\n        }\n    }\n    true\n}fn name_matches(StringView pattern, StringView host) : "
    "bool\n{\n    if (StringView::starts_with(pattern, \"*.\"))\n    {\n        StringView suffix = StringView:"
    ":sub(pattern, 1, StringView::len(pattern));\n        match (StringView::find(host, \".\"))\n        {\n  "
    "          Some(dot) : dot > 0 && ascii_lower_eq(\n                suffix,\n                StringView:"
    ":sub(host, dot, StringView::len(host)),\n            ) && Option::is_some(&StringView::find(StringVie"
    "w::sub(suffix, 1, StringView::len(suffix)), \".\")),\n            None : false,\n        }\n    }\n    els"
    "e\n    {\n        ascii_lower_eq(pattern, host)\n    }\n}export fn Certificate::matches_host(ref<Certifi"
    "cate, shared> c, StringView host) : bool\n{\n    if (Ok(ip) = IpAddr::parse(host))\n    {\n        forea"
    "ch (a in &c.ip_addresses)\n        {\n            if (IpAddr::text(a) == IpAddr::text(&ip))\n          "
    "  {\n                return true;\n            }\n        }\n        return false;\n    }\n    StringView "
    "h = if (StringView::ends_with(\n        host,\n        \".\",\n    )) { StringView::sub(host, 0, StringVi"
    "ew::len(host) - 1) } else { host };\n    foreach (n in &c.dns_names)\n    {\n        if (name_matches(S"
    "tring::as_view(n), h))\n        {\n            return true;\n        }\n    }\n    false\n}fn check_time(r"
    "ef<Certificate, shared> c, ref<DateTime, shared> now) : Result<void, CertError>\n{\n    if (DateTime::"
    "less(now, &c.not_before))\n    {\n        return Err(NotYetValid);\n    }\n    if (DateTime::less(&c.not"
    "_after, now))\n    {\n        return Err(Expired);\n    }\n    if (c.unhandled_critical)\n    {\n        r"
    "eturn Err(UnhandledCritical);\n    }\n    Ok(())\n}fn same_bytes(ref<Vec<u8>, shared> a, ref<Vec<u8>, s"
    "hared> b) : bool\n{\n    Vec::len(a) == Vec::len(b) && digest_eq(&a[0..$], &b[0..$])\n}export fn verify"
    "_chain(\n    ref<Certificate, shared> leaf,\n    slice<Certificate, shared> intermediates,\n    ref<Tru"
    "stStore, shared> roots,\n    StringView host,\n    ref<DateTime, shared> now,\n) : Result<void, CertErr"
    "or>\n{\n    if (!Certificate::matches_host(leaf, host))\n    {\n        return Err(HostMismatch);\n    }\n"
    "    if (!leaf.server_auth)\n    {\n        return Err(WrongUsage);\n    }\n    check_time(leaf, now)?;\n "
    "   Certificate current = Certificate::clone(leaf);\n    usize below = 0;\n    CertError last = Unknown"
    "Authority;\n    for (usize depth = 0; depth < 10; depth += 1)\n    {\n        foreach (r in &roots.root"
    "s)\n        {\n            if (same_bytes(\n                &r.subject,\n                &current.issuer"
    ",\n            ) && verify_signature(&r.key, &current.scheme, &current.tbs[0..$], &current.signature["
    "0..$]))\n            {\n                if (!r.is_ca || !r.can_sign_certificates)\n                {\n  "
    "                  last = NotAuthority;\n                    continue;\n                }\n             "
    "   if (Err(e) = check_time(r, now))\n                {\n                    last = e;\n                "
    "    continue;\n                }\n                return Ok(());\n            }\n        }\n        Optio"
    "n<Certificate> next = None;\n        for (usize i = 0; i < slice_len(intermediates); i += 1)\n        "
    "{\n            ref<Certificate, shared> m = &intermediates[i];\n            if (same_bytes(&m.subject,"
    " &current.issuer) && !same_bytes(&m.der, &current.der))\n            {\n                if (!verify_si"
    "gnature(&m.key, &current.scheme, &current.tbs[0..$], &current.signature[0..$]))\n                {\n  "
    "                  last = BadSignature;\n                    continue;\n                }\n             "
    "   if (!m.is_ca || !m.can_sign_certificates)\n                {\n                    return Err(NotAut"
    "hority);\n                }\n                if (m.max_path_len >= 0 && narrow<i64>(below) > m.max_pat"
    "h_len)\n                {\n                    return Err(NotAuthority);\n                }\n           "
    "     check_time(m, now)?;\n                overwrite(&mut next, Some(Certificate::clone(m)));\n       "
    "         break;\n            }\n        }\n        match (next)\n        {\n            Some(n) :\n       "
    "     {\n                overwrite(&mut current, n);\n                below += 1;\n            },\n      "
    "      None    : return Err(last),\n        }\n    }\n    Err(ChainTooLong)\n}fn der_push_len(ref<Vec<u8>"
    ", exclusive> out, usize len)\n{\n    if (len < 0x80)\n    {\n        Vec::push(out, narrow<u8>(len));\n  "
    "      return;\n    }\n    usize count = 1;\n    while ((len >> narrow<u32>(8 * count)) != 0)\n    {\n    "
    "    count += 1;\n    }\n    Vec::push(out, 0x80 | narrow<u8>(count));\n    for (usize i = 0; i < count;"
    " i += 1)\n    {\n        Vec::push(out, narrow_wrapping<u8>(len >> narrow<u32>(8 * (count - 1 - i))));"
    "\n    }\n}fn der_wrap(u8 tag, slice<u8, shared> content) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n   "
    " Vec::push(&mut out, tag);\n    der_push_len(&mut out, slice_len(content));\n    Vec::extend_from(&mut"
    " out, content);\n    out\n}fn der_uint(slice<u8, shared> v) : Vec<u8>\n{\n    usize from = 0;\n    while "
    "(from + 1 < slice_len(v) && v[from] == 0)\n    {\n        from += 1;\n    }\n    Vec<u8> content = Vec::"
    "new();\n    if (slice_len(v) == 0 || (v[from] & 0x80) != 0)\n    {\n        Vec::push(&mut content, 0);"
    "\n    }\n    Vec::extend_from(&mut content, &v[from..$]);\n    der_wrap(0x02, &content[0..$])\n}fn der_b"
    "ig(ref<BigUint, shared> a) : Vec<u8>\n{\n    der_uint(&BigUint::to_bytes_be(a)[0..$])\n}fn der_oid_hex("
    "str hex) : Vec<u8>\n{\n    Vec<u8> b = Result::unwrap_or(from_hex(StringView::of(hex)), Vec::new());\n "
    "   der_wrap(0x06, &b[0..$])\n}fn der_bit_string(slice<u8, shared> bytes) : Vec<u8>\n{\n    Vec<u8> cont"
    "ent = Vec::new();\n    Vec::push(&mut content, 0);\n    Vec::extend_from(&mut content, bytes);\n    der"
    "_wrap(0x03, &content[0..$])\n}fn curve_oid_hex(EcCurve c) : str\n{\n    match (c)\n    {\n        P256 : "
    "\"2a8648ce3d030107\",\n        P384 : \"2b81040022\",\n    }\n}fn key_algorithm(ref<CertKey, shared> key) :"
    " Vec<u8>\n{\n    Vec<u8> content = match (key)\n    {\n        RsaKey(_)      :\n        {\n            Ve"
    "c<u8> c = der_oid_hex(\"2a864886f70d010101\");\n            Vec::push(&mut c, 0x05);\n            Vec::p"
    "ush(&mut c, 0x00);\n            c\n        },\n        EcKey(k)       :\n        {\n            Vec<u8> c"
    " = der_oid_hex(\"2a8648ce3d0201\");\n            Vec::extend_from(&mut c, &der_oid_hex(curve_oid_hex(k."
    "curve))[0..$]);\n            c\n        },\n        Ed25519Key(_)  : der_oid_hex(\"2b6570\"),\n        Uns"
    "upportedKey : Vec::new(),\n    };\n    der_wrap(0x30, &content[0..$])\n}export fn CertKey::to_der(ref<C"
    "ertKey, shared> key) : Option<Vec<u8>>\n{\n    Vec<u8> bits = match (key)\n    {\n        RsaKey(k)     "
    " :\n        {\n            Vec<u8> seq = der_big(&k.n);\n            Vec::extend_from(&mut seq, &der_bi"
    "g(&k.e)[0..$]);\n            der_wrap(0x30, &seq[0..$])\n        },\n        EcKey(k)       : Vec::clon"
    "e(&k.point),\n        Ed25519Key(k)  : Vec::from_slice(&k[0..$]),\n        UnsupportedKey : return Non"
    "e,\n    };\n    Vec<u8> content = key_algorithm(key);\n    Vec::extend_from(&mut content, &der_bit_stri"
    "ng(&bits[0..$])[0..$]);\n    Some(der_wrap(0x30, &content[0..$]))\n}export fn CertKey::from_der(slice<"
    "u8, shared> der) : Result<CertKey, CertError>\n{\n    Der spki = der_expect(der, 0, 0x30)?;\n    if (sp"
    "ki.next != slice_len(der))\n    {\n        return Err(BadEncoding);\n    }\n    match (public_key_of(der"
    ", spki)?)\n    {\n        UnsupportedKey : Err(UnsupportedAlgorithm),\n        k              : Ok(k),\n"
    "    }\n}fn pem_block(StringView text, slice<str, shared> labels) : Result<Vec<u8>, CertError>\n{\n    /"
    "/ The earliest BEGIN line of any of the labels.\n    Option<usize> first = None;\n    usize at = 0;\n  "
    "  for (usize i = 0; i < slice_len(labels); i += 1)\n    {\n        String begin = String::from_str(\"--"
    "---BEGIN \");\n        String::append(&mut begin, labels[i]);\n        String::append(&mut begin, \"----"
    "-\");\n        if (Some(v) = StringView::find(text, String::as_view(&begin)))\n        {\n            if"
    " (Option::is_none(&first) || v < at)\n            {\n                first = Some(i);\n                "
    "at = v;\n            }\n        }\n    }\n    usize i = match (first)\n    {\n        Some(i) : i,\n       "
    " None    :\n        {\n            if (Option::is_some(&StringView::find(text, \"-----BEGIN ENCRYPTED P"
    "RIVATE KEY-----\")))\n            {\n                return Err(UnsupportedAlgorithm);\n            }\n  "
    "          return Err(BadEncoding);\n        },\n    };\n    String begin = String::from_str(\"-----BEGIN"
    " \");\n    String::append(&mut begin, labels[i]);\n    String::append(&mut begin, \"-----\");\n    String "
    "end = String::from_str(\"-----END \");\n    String::append(&mut end, labels[i]);\n    String::append(&mu"
    "t end, \"-----\");\n    StringView body = StringView::sub(text, at + String::len(&begin), StringView::l"
    "en(text));\n    usize e = match (StringView::find(body, String::as_view(&end)))\n    {\n        Some(v)"
    " : v,\n        None    : return Err(BadEncoding),\n    };\n    String b64 = String::new();\n    StringVi"
    "ew block = StringView::sub(body, 0, e);\n    for (usize k = 0; k < StringView::len(block); k += 1)\n  "
    "  {\n        u8 c = block.bytes[k];\n        if (c >= 128)\n        {\n            return Err(BadEncodin"
    "g);\n        }\n        if (!ascii_is_space(c))\n        {\n            String::push_ascii(&mut b64, c);"
    "\n        }\n    }\n    match (base64_decode(String::as_view(&b64)))\n    {\n        Ok(der) : Ok(der),\n "
    "       Err(_)  : Err(BadEncoding),\n    }\n}fn pem_of(str label, slice<u8, shared> der) : String\n{\n   "
    " String out = String::from_str(\"-----BEGIN \");\n    String::append(&mut out, label);\n    String::appe"
    "nd(&mut out, \"-----\\n\");\n    String b64 = base64_encode(der);\n    usize n = String::len(&b64);\n    f"
    "or (usize at = 0; at < n; at += 64)\n    {\n        String::append(&mut out, StringView::sub(String::a"
    "s_view(&b64), at, min(at + 64, n)));\n        String::append(&mut out, \"\\n\");\n    }\n    String::appen"
    "d(&mut out, \"-----END \");\n    String::append(&mut out, label);\n    String::append(&mut out, \"-----\\n"
    "\");\n    out\n}export fn CertKey::from_pem(StringView text) : Result<CertKey, CertError>\n{\n    array<s"
    "tr, 1> labels = [\"PUBLIC KEY\"];\n    Vec<u8> der = pem_block(text, &labels[0..$])?;\n    CertKey::from"
    "_der(&der[0..$])\n}export fn CertKey::to_pem(ref<CertKey, shared> key) : Option<String>\n{\n    Some(pe"
    "m_of(\"PUBLIC KEY\", &CertKey::to_der(key)?[0..$]))\n}export fn PrivateKey::public_key(ref<PrivateKey, "
    "shared> key) : CertKey\n{\n    match (key)\n    {\n        RsaPrivate(k)     : RsaKey(RsaPrivateKey::pub"
    "lic_key(k)),\n        EcPrivate(k) : EcKey(EcPublicKey { .curve = k.curve, .point = Option::unwrap_or"
    "(\n            ec_public_key(k.curve, &k.scalar[0..$]),\n            Vec::new(),\n        ) }),\n       "
    " Ed25519Private(k) : Ed25519Key(ed25519_public_key(&k[0..$])),\n    }\n}fn rsa_private_of(slice<u8, sh"
    "ared> buf, usize at) : Result<PrivateKey, CertError>\n{\n    Der seq = der_expect(buf, at, 0x30)?;\n   "
    " Der version = der_expect(buf, seq.start, 0x02)?;\n    Der n = der_expect(buf, version.next, 0x02)?;\n"
    "    Der e = der_expect(buf, n.next, 0x02)?;\n    Der d = der_expect(buf, e.next, 0x02)?;\n    Der p = "
    "der_expect(buf, d.next, 0x02)?;\n    Der q = der_expect(buf, p.next, 0x02)?;\n    match (RsaPrivateKey"
    "::new(\n        BigUint::from_bytes_be(&buf[n.start..n.end]),\n        BigUint::from_bytes_be(&buf[e.s"
    "tart..e.end]),\n        BigUint::from_bytes_be(&buf[d.start..d.end]),\n        BigUint::from_bytes_be("
    "&buf[p.start..p.end]),\n        BigUint::from_bytes_be(&buf[q.start..q.end]),\n    ))\n    {\n        So"
    "me(k) : Ok(RsaPrivate(k)),\n        None    : Err(BadEncoding),\n    }\n}fn ec_private_of(slice<u8, sha"
    "red> buf, usize at, Option<EcCurve> curve) : Result<PrivateKey, CertError>\n{\n    Der seq = der_expec"
    "t(buf, at, 0x30)?;\n    Der version = der_expect(buf, seq.start, 0x02)?;\n    Der scalar = der_expect("
    "buf, version.next, 0x04)?;\n    Option<EcCurve> found = curve;\n    usize p_at = scalar.next;\n    whil"
    "e (p_at < seq.end)\n    {\n        Der field = match (der_read(buf, p_at))\n        {\n            Some("
    "v) : v,\n            None    : return Err(BadEncoding),\n        };\n        if (field.tag == 0xa0)\n   "
    "     {\n            Der oid = der_expect(buf, field.start, 0x06)?;\n            if (der_eq_hex(buf, oi"
    "d, \"2a8648ce3d030107\"))\n            {\n                found = Some(P256);\n            }\n            "
    "else if (der_eq_hex(buf, oid, \"2b81040022\"))\n            {\n                found = Some(P384);\n     "
    "       }\n            else\n            {\n                return Err(UnsupportedAlgorithm);\n          "
    "  }\n        }\n        p_at = field.next;\n    }\n    EcCurve c = match (found)\n    {\n        Some(v) :"
    " v,\n        None    : return Err(UnsupportedAlgorithm),\n    };\n    Vec<u8> k = Vec::from_slice(&buf["
    "scalar.start..scalar.end]);\n    usize want = if (c == P256) { 32 } else { 48 };\n    if (Vec::len(&k)"
    " != want || Option::is_none(&ec_public_key(c, &k[0..$])))\n    {\n        return Err(BadEncoding);\n   "
    " }\n    Ok(EcPrivate(EcPrivateKey { .curve = c, .scalar = k }))\n}export fn PrivateKey::from_der(slice"
    "<u8, shared> der) : Result<PrivateKey, CertError>\n{\n    Der seq = der_expect(der, 0, 0x30)?;\n    if "
    "(seq.next != slice_len(der))\n    {\n        return Err(BadEncoding);\n    }\n    Der version = der_expe"
    "ct(der, seq.start, 0x02)?;\n    Der second = match (der_read(der, version.next))\n    {\n        Some(v"
    ") : v,\n        None    : return Err(BadEncoding),\n    };\n    if (second.tag == 0x02)\n    {\n        r"
    "eturn rsa_private_of(der, 0);\n    }\n    if (second.tag == 0x04)\n    {\n        return ec_private_of(d"
    "er, 0, None);\n    }\n    if (second.tag != 0x30)\n    {\n        return Err(BadEncoding);\n    }\n    Der"
    " oid = der_expect(der, second.start, 0x06)?;\n    Der key = der_expect(der, second.next, 0x04)?;\n    "
    "if (der_eq_hex(der, oid, \"2a864886f70d010101\"))\n    {\n        return rsa_private_of(der, key.start);"
    "\n    }\n    if (der_eq_hex(der, oid, \"2a8648ce3d0201\"))\n    {\n        Der curve = der_expect(der, oid"
    ".next, 0x06)?;\n        if (der_eq_hex(der, curve, \"2a8648ce3d030107\"))\n        {\n            return "
    "ec_private_of(der, key.start, Some(P256));\n        }\n        if (der_eq_hex(der, curve, \"2b81040022\""
    "))\n        {\n            return ec_private_of(der, key.start, Some(P384));\n        }\n        return "
    "Err(UnsupportedAlgorithm);\n    }\n    if (der_eq_hex(der, oid, \"2b6570\"))\n    {\n        Der inner = d"
    "er_expect(der, key.start, 0x04)?;\n        if (inner.end - inner.start != 32 || inner.next != key.end"
    ")\n        {\n            return Err(BadEncoding);\n        }\n        array<u8, 32> seed = [0; 32];\n   "
    "     for (usize i = 0; i < 32; i += 1)\n        {\n            seed[i] = der[inner.start + i];\n       "
    " }\n        return Ok(Ed25519Private(seed));\n    }\n    Err(UnsupportedAlgorithm)\n}export fn PrivateKe"
    "y::to_der(ref<PrivateKey, shared> key) : Vec<u8>\n{\n    CertKey public = PrivateKey::public_key(key);"
    "\n    Vec<u8> inner = match (key)\n    {\n        RsaPrivate(k)     :\n        {\n            BigUint one"
    " = BigUint::from_u64(1);\n            BigUint p1 = BigUint::sub(&k.p, &one);\n            BigUint q1 ="
    " BigUint::sub(&k.q, &one);\n            Vec<u8> seq = der_uint(&[0: u8][0..$]);\n            Vec::exte"
    "nd_from(&mut seq, &der_big(&k.n)[0..$]);\n            Vec::extend_from(&mut seq, &der_big(&k.e)[0..$]"
    ");\n            Vec::extend_from(&mut seq, &der_big(&k.d)[0..$]);\n            Vec::extend_from(&mut s"
    "eq, &der_big(&k.p)[0..$]);\n            Vec::extend_from(&mut seq, &der_big(&k.q)[0..$]);\n           "
    " Vec::extend_from(&mut seq, &der_big(&BigUint::rem(&k.d, &p1))[0..$]);\n            Vec::extend_from("
    "&mut seq, &der_big(&BigUint::rem(&k.d, &q1))[0..$]);\n            Vec::extend_from(\n                &"
    "mut seq,\n                &der_big(&Option::unwrap_or(BigUint::mod_inverse(&k.q, &k.p), BigUint::zero"
    "()))[0..$],\n            );\n            der_wrap(0x30, &seq[0..$])\n        },\n        EcPrivate(k)   "
    "   :\n        {\n            Vec<u8> seq = der_uint(&[1: u8][0..$]);\n            Vec::extend_from(&mut"
    " seq, &der_wrap(0x04, &k.scalar[0..$])[0..$]);\n            Vec<u8> point = match (&public)\n         "
    "   {\n                EcKey(pk) : Vec::clone(&pk.point),\n                _         : Vec::new(),\n    "
    "        };\n            Vec::extend_from(&mut seq, &der_wrap(0xa1, &der_bit_string(&point[0..$])[0..$"
    "])[0..$]);\n            der_wrap(0x30, &seq[0..$])\n        },\n        Ed25519Private(k) : der_wrap(0x"
    "04, &k[0..$]),\n    };\n    Vec<u8> content = der_uint(&[0: u8][0..$]);\n    Vec::extend_from(&mut cont"
    "ent, &key_algorithm(&public)[0..$]);\n    Vec::extend_from(&mut content, &der_wrap(0x04, &inner[0..$]"
    ")[0..$]);\n    der_wrap(0x30, &content[0..$])\n}export fn PrivateKey::from_pem(StringView text) : Resu"
    "lt<PrivateKey, CertError>\n{\n    array<str, 3> labels = [\"PRIVATE KEY\", \"RSA PRIVATE KEY\", \"EC PRIVAT"
    "E KEY\"];\n    Vec<u8> der = pem_block(text, &labels[0..$])?;\n    PrivateKey::from_der(&der[0..$])\n}ex"
    "port fn PrivateKey::to_pem(ref<PrivateKey, shared> key) : String\n{\n    pem_of(\"PRIVATE KEY\", &Privat"
    "eKey::to_der(key)[0..$])\n}export fn sign(\n    ref<PrivateKey, shared> key,\n    ref<SignatureScheme, "
    "shared> scheme,\n    slice<u8, shared> message,\n) : Option<Vec<u8>>\n{\n    match (scheme)\n    {\n      "
    "  RsaPkcs1(h) : match (key)\n        {\n            RsaPrivate(k) : Some(rsa_sign_pkcs1v15(k, *h, &has"
    "h(*h, message)[0..$])),\n            _             : None,\n        },\n        RsaPss(h) : match (key)"
    "\n        {\n            RsaPrivate(k) : Some(rsa_sign_pss(k, *h, &hash(*h, message)[0..$])),\n        "
    "    _             : None,\n        },\n        Ecdsa(h) : match (key)\n        {\n            EcPrivate("
    "k) : ecdsa_sign(k.curve, &k.scalar[0..$], &hash(*h, message)[0..$]),\n            _            : None"
    ",\n        },\n        Ed25519 : match (key)\n        {\n            Ed25519Private(k) : Some(Vec::from_"
    "slice(&ed25519_sign(&k[0..$], message)[0..$])),\n            _                 : None,\n        },\n   "
    "     UnsupportedSignature : None,\n    }\n}export fn TlsError::text(ref<TlsError, shared> e) : str\n{\n "
    "   match (e)\n    {\n        TlsNetFailure(n) : NetError::text(n),\n        CertRejected(c)  : CertErro"
    "r::text(c),\n        HandshakeFailed  : \"TLS handshake failed\",\n        ProtocolError    : \"TLS proto"
    "col violation\",\n        PeerAlert(code) : match (*code)\n        {\n            40  : \"the peer refuse"
    "d the handshake (alert 40): it supports none of the suites (ChaCha20-Poly1305, AES-128-GCM, AES-256-"
    "GCM) or key exchanges (X25519, P-256, P-384) offered\",\n            42  : \"the peer refused a certifi"
    "cate (alert 42)\",\n            70  : \"the peer does not speak TLS 1.3 (alert 70)\",\n            80  : "
    "\"the peer failed internally (alert 80)\",\n            109 : \"the peer requires an extension that was "
    "not sent (alert 109)\",\n            112 : \"the peer does not know the name asked for (alert 112)\",\n  "
    "          _   : \"the peer sent a TLS alert\",\n        },\n        RecordRejected   : \"a TLS record did"
    " not authenticate\",\n    }\n}fn suite_hash(u16 suite) : HashKind\n{\n    if (suite == 0x1302) { Sha2_384"
    " } else { Sha2_256 }\n}fn suite_key_len(u16 suite) : usize\n{\n    if (suite == 0x1301) { 16 } else { 3"
    "2 }\n}fn keys_from(slice<u8, shared> secret, u16 suite) : RecordKeys\n{\n    Vec<u8> none = Vec::new();"
    "\n    HashKind kind = suite_hash(suite);\n    RecordKeys {\n        .key = hkdf_expand_label_with(kind,"
    " secret, \"key\", &none[0..$], suite_key_len(suite)),\n        .iv = hkdf_expand_label_with(kind, secre"
    "t, \"iv\", &none[0..$], 12),\n        .seq = 0,\n        .secret = Vec::from_slice(secret),\n        .sui"
    "te = suite,\n    }\n}fn record_nonce(ref<RecordKeys, shared> k) : Vec<u8>\n{\n    Vec<u8> n = Vec::clone"
    "(&k.iv);\n    for (usize i = 0; i < 8; i += 1)\n    {\n        n[4 + i] = n[4 + i] ^ narrow_wrapping<u8"
    ">(k.seq >> narrow<u32>(56 - 8 * i));\n    }\n    n\n}export fn TlsStream::peer_certificate(ref<TlsStrea"
    "m, shared> s) : Option<ref<Certificate, shared>>\n{\n    match (&s.peer)\n    {\n        Some(c) : Some("
    "c),\n        None    : None,\n    }\n}export fn TlsStream::peer_addr(ref<TlsStream, shared> s) : Socket"
    "Addr\n{\n    TcpStream::peer_addr(&s.tcp)\n}export fn TlsStream::local_addr(ref<TlsStream, shared> s) :"
    " SocketAddr\n{\n    TcpStream::local_addr(&s.tcp)\n}fn read_record(ref<TcpStream, exclusive> tcp) : Res"
    "ult<Record, TlsError>\n{\n    Vec<u8> header = Vec::new();\n    match (TcpStream::read_exact(tcp, &mut "
    "header, 5))\n    {\n        Ok(_)  : {},\n        Err(e) : return Err(TlsNetFailure(e)),\n    }\n    usiz"
    "e len = widen<usize>(read_be<u16>(&header[0..$], 3));\n    if (len > 16384 + 256)\n    {\n        retur"
    "n Err(ProtocolError);\n    }\n    Vec<u8> body = Vec::new();\n    match (TcpStream::read_exact(tcp, &mu"
    "t body, len))\n    {\n        Ok(_)  : {},\n        Err(e) : return Err(TlsNetFailure(e)),\n    }\n    Ok"
    "(Record { .kind = header[0], .header = header, .body = body })\n}fn write_all(ref<TcpStream, exclusiv"
    "e> tcp, slice<u8, shared> data) : Result<void, TlsError>\n{\n    match (TcpStream::write(tcp, data))\n "
    "   {\n        Ok(_)  : Ok(()),\n        Err(e) : Err(TlsNetFailure(e)),\n    }\n}fn seal_record(ref<Reco"
    "rdKeys, exclusive> k, u8 kind, slice<u8, shared> content) : Vec<u8>\n{\n    Vec<u8> inner = Vec::from_"
    "slice(content);\n    Vec::push(&mut inner, kind);\n    Vec<u8> header = Vec::new();\n    Vec::push(&mut"
    " header, 23);\n    Vec::push_be(&mut header, 0x0303: u16);\n    Vec::push_be(&mut header, narrow<u16>("
    "Vec::len(&inner) + 16));\n    Vec<u8> nonce = record_nonce(k);\n    Vec<u8> sealed = if (k.suite != 0x"
    "1303)\n    {\n        aes_gcm_seal(&k.key[0..$], &nonce[0..$], &header[0..$], &inner[0..$])\n    }\n    "
    "else\n    {\n        chacha20_poly1305_seal(&k.key[0..$], &nonce[0..$], &header[0..$], &inner[0..$])\n "
    "   };\n    k.seq += 1;\n    Vec::extend_from(&mut header, &sealed[0..$]);\n    header\n}fn open_record(r"
    "ef<RecordKeys, exclusive> k, ref<Record, shared> r) : Result<Inner, TlsError>\n{\n    if (r.kind != 23"
    ")\n    {\n        return Err(ProtocolError);\n    }\n    Vec<u8> nonce = record_nonce(k);\n    Option<Vec"
    "<u8>> opened = if (k.suite != 0x1303)\n    {\n        aes_gcm_open(&k.key[0..$], &nonce[0..$], &r.head"
    "er[0..$], &r.body[0..$])\n    }\n    else\n    {\n        chacha20_poly1305_open(&k.key[0..$], &nonce[0."
    ".$], &r.header[0..$], &r.body[0..$])\n    };\n    Vec<u8> plain = match (opened)\n    {\n        Some(p)"
    " : p,\n        None    : return Err(RecordRejected),\n    };\n    k.seq += 1;\n    usize n = Vec::len(&p"
    "lain);\n    while (n > 0 && plain[n - 1] == 0)\n    {\n        n -= 1;\n    }\n    if (n == 0 || n - 1 > "
    "16384)\n    {\n        return Err(ProtocolError);\n    }\n    u8 kind = plain[n - 1];\n    Vec::truncate("
    "&mut plain, n - 1);\n    Ok(Inner { .kind = kind, .content = plain })\n}fn transcript_add(ref<Handshak"
    "e, exclusive> hs, slice<u8, shared> msg)\n{\n    Hasher::update(&mut hs.t256, msg);\n    Hasher::update"
    "(&mut hs.t384, msg);\n}fn next_message(\n    ref<Handshake, exclusive> hs,\n    ref<TcpStream, exclusiv"
    "e> tcp,\n    ref<Option<RecordKeys>, exclusive> keys,\n) : Result<Vec<u8>, TlsError>\n{\n    while (Vec:"
    ":len(&hs.buffer) < 4 || Vec::len(&hs.buffer) < 4 + (widen<usize>(hs.buffer[1]) << 16 | widen<usize>("
    "hs.buffer[2]) << 8 | widen<usize>(hs.buffer[3])))\n    {\n        Record r = read_record(tcp)?;\n      "
    "  if (r.kind == 20)\n        {\n            // A compatibility ChangeCipherSpec (RFC 8446 §D.4): igno"
    "red.\n            continue;\n        }\n        if (r.kind == 21)\n        {\n            if (Vec::len(&r"
    ".body) == 2)\n            {\n                return Err(PeerAlert(r.body[1]));\n            }\n         "
    "   return Err(ProtocolError);\n        }\n        match (keys)\n        {\n            Some(k) :\n       "
    "     {\n                Inner i = open_record(k, &r)?;\n                if (i.kind == 21)\n            "
    "    {\n                    return Err(PeerAlert(if (Vec::len(&i.content) == 2) { i.content[1] } else "
    "{ 0 }));\n                }\n                if (i.kind != 22)\n                {\n                    r"
    "eturn Err(ProtocolError);\n                }\n                Vec::extend_from(&mut hs.buffer, &i.cont"
    "ent[0..$]);\n            },\n            None    :\n            {\n                if (r.kind != 22)\n   "
    "             {\n                    return Err(ProtocolError);\n                }\n                Vec:"
    ":extend_from(&mut hs.buffer, &r.body[0..$]);\n            },\n        }\n    }\n    usize len = 4 + (wid"
    "en<usize>(hs.buffer[1]) << 16 | widen<usize>(hs.buffer[2]) << 8 | widen<usize>(hs.buffer[3]));\n    V"
    "ec<u8> msg = Vec::from_slice(&hs.buffer[0..len]);\n    Vec<u8> rest = Vec::from_slice(&hs.buffer[len."
    ".$]);\n    overwrite(&mut hs.buffer, rest);\n    transcript_add(hs, &msg[0..$]);\n    Ok(msg)\n}fn push_"
    "u24(ref<Vec<u8>, exclusive> v, usize n)\n{\n    Vec::push(v, narrow<u8>(n >> 16));\n    Vec::push(v, na"
    "rrow_wrapping<u8>(n >> 8));\n    Vec::push(v, narrow_wrapping<u8>(n));\n}fn push_extension(ref<Vec<u8>"
    ", exclusive> out, u16 kind, slice<u8, shared> data)\n{\n    Vec::push_be(out, kind);\n    Vec::push_be("
    "out, narrow<u16>(slice_len(data)));\n    Vec::extend_from(out, data);\n}fn client_hello(\n    StringVie"
    "w server_name,\n    slice<u8, shared> random,\n    slice<u8, shared> session,\n    u16 group,\n    slice"
    "<u8, shared> public_key,\n    slice<u8, shared> cookie,\n) : Vec<u8>\n{\n    Vec<u8> ext = Vec::new();\n "
    "   if (Result::is_err(&IpAddr::parse(server_name)))\n    {\n        Vec<u8> sni = Vec::new();\n        "
    "Vec::push_be(&mut sni, narrow<u16>(StringView::len(server_name) + 3));\n        Vec::push(&mut sni, 0"
    ");\n        Vec::push_be(&mut sni, narrow<u16>(StringView::len(server_name)));\n        Vec::extend_fr"
    "om(&mut sni, server_name.bytes);\n        push_extension(&mut ext, 0x0000, &sni[0..$]);\n    }\n    arr"
    "ay<u8, 8> groups = [0x00, 0x06, 0x00, 0x1d, 0x00, 0x17, 0x00, 0x18];\n    push_extension(&mut ext, 0x"
    "000a, &groups[0..$]);\n    array<u8, 20> algs = [\n        0x00,\n        0x12,\n        0x04,\n        0"
    "x03,\n        0x05,\n        0x03,\n        0x08,\n        0x04,\n        0x08,\n        0x05,\n        0x0"
    "8,\n        0x06,\n        0x08,\n        0x07,\n        0x04,\n        0x01,\n        0x05,\n        0x01,"
    "\n        0x06,\n        0x01,\n    ];\n    push_extension(&mut ext, 0x000d, &algs[0..$]);\n    array<u8,"
    " 3> versions = [0x02, 0x03, 0x04];\n    push_extension(&mut ext, 0x002b, &versions[0..$]);\n    Vec<u8"
    "> share = Vec::new();\n    Vec::push_be(&mut share, narrow<u16>(4 + slice_len(public_key)));\n    Vec:"
    ":push_be(&mut share, group);\n    Vec::push_be(&mut share, narrow<u16>(slice_len(public_key)));\n    V"
    "ec::extend_from(&mut share, public_key);\n    push_extension(&mut ext, 0x0033, &share[0..$]);\n    if "
    "(slice_len(cookie) > 0)\n    {\n        push_extension(&mut ext, 0x002c, cookie);\n    }\n    Vec<u8> bo"
    "dy = Vec::new();\n    Vec::push_be(&mut body, 0x0303: u16);\n    Vec::extend_from(&mut body, random);\n"
    "    Vec::push(&mut body, 32);\n    Vec::extend_from(&mut body, session);\n    array<u8, 8> suites = [0"
    "x00, 0x06, 0x13, 0x03, 0x13, 0x01, 0x13, 0x02];\n    Vec::extend_from(&mut body, &suites[0..$]);\n    "
    "Vec::push(&mut body, 1);\n    Vec::push(&mut body, 0);\n    Vec::push_be(&mut body, narrow<u16>(Vec::l"
    "en(&ext)));\n    Vec::extend_from(&mut body, &ext[0..$]);\n    Vec<u8> msg = Vec::new();\n    Vec::push"
    "(&mut msg, 1);\n    push_u24(&mut msg, Vec::len(&body));\n    Vec::extend_from(&mut msg, &body[0..$]);"
    "\n    msg\n}fn server_hello(slice<u8, shared> sh, slice<u8, shared> session) : Result<ServerHello, Tls"
    "Error>\n{\n    usize n = slice_len(sh);\n    if (n < 4 + 2 + 32 + 1 || sh[0] != 2)\n    {\n        return"
    " Err(ProtocolError);\n    }\n    // HelloRetryRequest's fixed random.\n    Vec<u8> hrr = Result::unwrap"
    "_or(\n        from_hex(\"cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c\"),\n        V"
    "ec::new(),\n    );\n    bool retry = digest_eq(&sh[6..38], &hrr[0..$]);\n    usize at = 38;\n    usize s"
    "id_len = widen<usize>(sh[at]);\n    if (sid_len != slice_len(session) || at + 1 + sid_len + 3 + 2 > n"
    " || !digest_eq(\n        &sh[at + 1..at + 1 + sid_len],\n        session,\n    ))\n    {\n        return "
    "Err(ProtocolError);\n    }\n    at = at + 1 + sid_len;\n    u16 suite = read_be<u16>(sh, at);\n    if (("
    "suite != 0x1303 && suite != 0x1301 && suite != 0x1302) || sh[at + 2] != 0)\n    {\n        return Err("
    "HandshakeFailed);\n    }\n    at += 3;\n    usize ext_end = at + 2 + widen<usize>(read_be<u16>(sh, at))"
    ";\n    if (ext_end != n)\n    {\n        return Err(ProtocolError);\n    }\n    at += 2;\n    bool tls13 ="
    " false;\n    Option<u16> group = None;\n    Vec<u8> share = Vec::new();\n    Vec<u8> cookie = Vec::new("
    ");\n    while (at + 4 <= ext_end)\n    {\n        u16 kind = read_be<u16>(sh, at);\n        usize len = "
    "widen<usize>(read_be<u16>(sh, at + 2));\n        usize start = at + 4;\n        if (start + len > ext_"
    "end)\n        {\n            return Err(ProtocolError);\n        }\n        if (kind == 0x002b)\n        "
    "{\n            tls13 = len == 2 && sh[start] == 0x03 && sh[start + 1] == 0x04;\n        }\n        else"
    " if (kind == 0x0033)\n        {\n            if (len < 2)\n            {\n                return Err(Pro"
    "tocolError);\n            }\n            u16 g = read_be<u16>(sh, start);\n            if (g != 0x001d "
    "&& g != 0x0017 && g != 0x0018)\n            {\n                return Err(HandshakeFailed);\n          "
    "  }\n            group = Some(g);\n            if (!retry)\n            {\n                usize want = "
    "if (g == 0x001d) { 32 } else if (g == 0x0017) { 65 } else { 97 };\n                if (len != 4 + wan"
    "t || widen<usize>(read_be<u16>(sh, start + 2)) != want)\n                {\n                    return"
    " Err(HandshakeFailed);\n                }\n                overwrite(&mut share, Vec::from_slice(&sh[s"
    "tart + 4..start + len]));\n            }\n            else if (len != 2)\n            {\n               "
    " return Err(ProtocolError);\n            }\n        }\n        else if (kind == 0x002c && retry)\n      "
    "  {\n            overwrite(&mut cookie, Vec::from_slice(&sh[start..start + len]));\n        }\n        "
    "at = start + len;\n    }\n    if (!tls13)\n    {\n        return Err(HandshakeFailed);\n    }\n    match ("
    "group)\n    {\n        Some(g) : Ok(ServerHello { .retry = retry, .suite = suite, .group = g, .share ="
    " share, .cookie = cookie }),\n        None    : Err(HandshakeFailed),\n    }\n}fn handshake_record(slic"
    "e<u8, shared> msg, u16 version) : Vec<u8>\n{\n    Vec<u8> rec = Vec::new();\n    Vec::push(&mut rec, 22"
    ");\n    Vec::push_be(&mut rec, version);\n    Vec::push_be(&mut rec, narrow<u16>(slice_len(msg)));\n   "
    " Vec::extend_from(&mut rec, msg);\n    rec\n}fn transcript_hash(ref<Handshake, shared> hs) : Vec<u8>\n{"
    "\n    match (hs.kind)\n    {\n        Sha2_384 : Hasher::finish(hs.t384),\n        _        : Hasher::fi"
    "nish(hs.t256),\n    }\n}fn derive_secret(HashKind kind, slice<u8, shared> secret, StringView label, sl"
    "ice<u8, shared> transcript) : Vec<u8>\n{\n    hkdf_expand_label_with(kind, secret, label, transcript, "
    "slice_len(secret))\n}fn certificate_list(slice<u8, shared> m) : Result<Vec<Certificate>, TlsError>\n{\n"
    "    usize n = slice_len(m);\n    if (n < 8 || m[0] != 11 || m[4] != 0)\n    {\n        return Err(Proto"
    "colError);\n    }\n    usize at = 5;\n    usize list_end = at + 3 + (widen<usize>(m[at]) << 16 | widen<"
    "usize>(m[at + 1]) << 8 | widen<usize>(m[at + 2]));\n    if (list_end != n)\n    {\n        return Err(P"
    "rotocolError);\n    }\n    at += 3;\n    Vec<Certificate> out = Vec::new();\n    while (at < list_end)\n "
    "   {\n        if (at + 3 > list_end)\n        {\n            return Err(ProtocolError);\n        }\n     "
    "   usize len = widen<usize>(m[at]) << 16 | widen<usize>(m[at + 1]) << 8 | widen<usize>(m[at + 2]);\n "
    "       usize start = at + 3;\n        if (start + len + 2 > list_end)\n        {\n            return Er"
    "r(ProtocolError);\n        }\n        match (Certificate::parse(&m[start..start + len]))\n        {\n   "
    "         Ok(c)  : Vec::push(&mut out, c),\n            Err(e) : return Err(CertRejected(e)),\n        "
    "}\n        usize ext_len = widen<usize>(read_be<u16>(m, start + len));\n        at = start + len + 2 +"
    " ext_len;\n    }\n    if (Vec::len(&out) == 0)\n    {\n        return Err(HandshakeFailed);\n    }\n    Ok"
    "(out)\n}fn certificate_verify_ok(slice<u8, shared> m, ref<Certificate, shared> leaf, slice<u8, shared"
    "> transcript) : bool\n{\n    if (slice_len(m) < 8 || m[0] != 15)\n    {\n        return false;\n    }\n   "
    " u16 code = read_be<u16>(m, 4);\n    usize len = widen<usize>(read_be<u16>(m, 6));\n    if (8 + len !="
    " slice_len(m))\n    {\n        return false;\n    }\n    SignatureScheme scheme = UnsupportedSignature;\n"
    "    bool curve_ok = true;\n    if (code == 0x0403 || code == 0x0503)\n    {\n        EcCurve want = if "
    "(code == 0x0403) { P256 } else { P384 };\n        curve_ok = match (&leaf.key)\n        {\n            "
    "EcKey(k) : k.curve == want,\n            _        : false,\n        };\n        scheme = Ecdsa(if (code"
    " == 0x0403) { Sha2_256 } else { Sha2_384 });\n    }\n    else if (code == 0x0804)\n    {\n        scheme"
    " = RsaPss(Sha2_256);\n    }\n    else if (code == 0x0805)\n    {\n        scheme = RsaPss(Sha2_384);\n   "
    " }\n    else if (code == 0x0806)\n    {\n        scheme = RsaPss(Sha2_512);\n    }\n    else if (code == "
    "0x0807)\n    {\n        scheme = Ed25519;\n    }\n    if (!curve_ok)\n    {\n        return false;\n    }\n "
    "   Vec<u8> content = Vec::filled(64, 0x20: u8);\n    Vec::extend_from(&mut content, &b\"TLS 1.3, serve"
    "r CertificateVerify\"[0..$]);\n    Vec::push(&mut content, 0);\n    Vec::extend_from(&mut content, tran"
    "script);\n    verify_signature(&leaf.key, &scheme, &content[0..$], &m[8..$])\n}fn finished_data(HashKi"
    "nd kind, slice<u8, shared> secret, slice<u8, shared> transcript) : Vec<u8>\n{\n    Vec<u8> none = Vec:"
    ":new();\n    Vec<u8> key = hkdf_expand_label_with(kind, secret, \"finished\", &none[0..$], slice_len(se"
    "cret));\n    hmac(kind, &key[0..$], transcript)\n}export fn TlsStream::client(\n    TcpStream tcp,\n    "
    "StringView server_name,\n    ref<TrustStore, shared> roots,\n) : Result<TlsStream, TlsError>\n{\n    arr"
    "ay<u8, 32> private_key = x25519_private_key();\n    array<u8, 32> public_key = x25519_public_key(&pri"
    "vate_key[0..$]);\n    array<u8, 32> random = [0; 32];\n    os_random_bytes(&mut random[0..$]);\n    arr"
    "ay<u8, 32> session = [0; 32];\n    os_random_bytes(&mut session[0..$]);\n    Handshake hs = Handshake "
    "{ .buffer = Vec::new(), .t256 = Hasher::new(Sha2_256), .t384 = Hasher::new(Sha2_384), .kind = Sha2_2"
    "56 };\n    Vec<u8> none = Vec::new();\n    Vec<u8> ch = client_hello(server_name, &random[0..$], &sess"
    "ion[0..$], 0x001d, &public_key[0..$], &none[0..$]);\n    transcript_add(&mut hs, &ch[0..$]);\n    writ"
    "e_all(&mut tcp, &handshake_record(&ch[0..$], 0x0301)[0..$])?;\n    Option<RecordKeys> plain = None;\n "
    "   Vec<u8> sh = next_message(&mut hs, &mut tcp, &mut plain)?;\n    ServerHello hello = server_hello(&"
    "sh[0..$], &session[0..$])?;\n    hs.kind = suite_hash(hello.suite);\n    HashKind kind = hs.kind;\n    "
    "Vec<u8> ec_key = Vec::new();\n    if (hello.retry)\n    {\n        // A HelloRetryRequest (RFC 8446 §4"
    ".1.4): it may only ask for a\n        // group this client offered without a share, P-256 or P-384. T"
    "he\n        // transcript restarts from message_hash(ClientHello1) ‖\n        // HelloRetryRequest, "
    "under the suite's hash.\n        if ((hello.group != 0x0017 && hello.group != 0x0018) || Vec::len(&hs"
    ".buffer) != 0)\n        {\n            return Err(HandshakeFailed);\n        }\n        EcCurve curve = "
    "if (hello.group == 0x0017) { P256 } else { P384 };\n        Vec<u8> ch_hash = hash(kind, &ch[0..$]);\n"
    "        array<u8, 4> head = [254, 0, 0, narrow<u8>(Vec::len(&ch_hash))];\n        Handshake restarted"
    " = Handshake { .buffer = Vec::new(), .t256 = Hasher::new(Sha2_256), .t384 = Hasher::new(Sha2_384), ."
    "kind = kind };\n        transcript_add(&mut restarted, &head[0..$]);\n        transcript_add(&mut rest"
    "arted, &ch_hash[0..$]);\n        transcript_add(&mut restarted, &sh[0..$]);\n        overwrite(&mut ec"
    "_key, ec_private_key(curve));\n        Vec<u8> ec_public = Option::unwrap(ec_public_key(curve, &ec_ke"
    "y[0..$]));\n        Vec<u8> ch2 = client_hello(\n            server_name,\n            &random[0..$],\n "
    "           &session[0..$],\n            hello.group,\n            &ec_public[0..$],\n            &hello"
    ".cookie[0..$],\n        );\n        transcript_add(&mut restarted, &ch2[0..$]);\n        overwrite(&mut"
    " hs, restarted);\n        write_all(&mut tcp, &handshake_record(&ch2[0..$], 0x0303)[0..$])?;\n        "
    "Vec<u8> sh2 = next_message(&mut hs, &mut tcp, &mut plain)?;\n        ServerHello second = server_hell"
    "o(&sh2[0..$], &session[0..$])?;\n        if (second.retry || second.group != hello.group || second.su"
    "ite != hello.suite)\n        {\n            return Err(HandshakeFailed);\n        }\n        overwrite(&"
    "mut hello, second);\n    }\n    else if (hello.group != 0x001d)\n    {\n        return Err(HandshakeFail"
    "ed);\n    }\n    u16 suite = hello.suite;\n    Vec<u8> shared = Vec::new();\n    if (hello.group == 0x00"
    "1d)\n    {\n        match (x25519(&private_key[0..$], &hello.share[0..$]))\n        {\n            Some("
    "z) : Vec::extend_from(&mut shared, &z[0..$]),\n            None    : return Err(HandshakeFailed),\n   "
    "     }\n    }\n    else\n    {\n        EcCurve curve = if (hello.group == 0x0017) { P256 } else { P384 "
    "};\n        match (ecdh(curve, &ec_key[0..$], &hello.share[0..$]))\n        {\n            Some(z) : ov"
    "erwrite(&mut shared, z),\n            None    : return Err(HandshakeFailed),\n        }\n    }\n    // T"
    "he key schedule (RFC 8446 §7.1), under the suite's hash.\n    Vec<u8> empty_hash = hash(kind, &none["
    "0..$]);\n    Vec<u8> zeros = Vec::filled(Vec::len(&empty_hash), 0: u8);\n    Vec<u8> early = hkdf_extr"
    "act_with(kind, &none[0..$], &zeros[0..$]);\n    Vec<u8> derived = derive_secret(kind, &early[0..$], \""
    "derived\", &empty_hash[0..$]);\n    Vec<u8> handshake_secret = hkdf_extract_with(kind, &derived[0..$],"
    " &shared[0..$]);\n    Vec<u8> th = transcript_hash(&hs);\n    Vec<u8> c_hs = derive_secret(kind, &hand"
    "shake_secret[0..$], \"c hs traffic\", &th[0..$]);\n    Vec<u8> s_hs = derive_secret(kind, &handshake_se"
    "cret[0..$], \"s hs traffic\", &th[0..$]);\n    Option<RecordKeys> server_keys = Some(keys_from(&s_hs[0."
    ".$], suite));\n    Vec<u8> ee = next_message(&mut hs, &mut tcp, &mut server_keys)?;\n    if (Vec::len("
    "&ee) < 6 || ee[0] != 8)\n    {\n        return Err(ProtocolError);\n    }\n    Vec<u8> cm = next_message"
    "(&mut hs, &mut tcp, &mut server_keys)?;\n    Vec<Certificate> chain = certificate_list(&cm[0..$])?;\n "
    "   Certificate leaf = Vec::remove(&mut chain, 0);\n    DateTime now = DateTime::now();\n    match (ver"
    "ify_chain(&leaf, &chain[0..$], roots, server_name, &now))\n    {\n        Ok(_)  : {},\n        Err(e) "
    ": return Err(CertRejected(e)),\n    }\n    Vec<u8> th_cert = transcript_hash(&hs);\n    Vec<u8> cv = ne"
    "xt_message(&mut hs, &mut tcp, &mut server_keys)?;\n    if (!certificate_verify_ok(&cv[0..$], &leaf, &"
    "th_cert[0..$]))\n    {\n        return Err(HandshakeFailed);\n    }\n    Vec<u8> th_cv = transcript_hash"
    "(&hs);\n    Vec<u8> fin = next_message(&mut hs, &mut tcp, &mut server_keys)?;\n    Vec<u8> want = fini"
    "shed_data(kind, &s_hs[0..$], &th_cv[0..$]);\n    if (Vec::len(&fin) != 4 + Vec::len(&want) || fin[0] "
    "!= 20 || !digest_eq(&fin[4..$], &want[0..$]))\n    {\n        return Err(HandshakeFailed);\n    }\n    i"
    "f (Vec::len(&hs.buffer) != 0)\n    {\n        return Err(ProtocolError);\n    }\n    Vec<u8> th_fin = tr"
    "anscript_hash(&hs);\n    Vec<u8> derived2 = derive_secret(kind, &handshake_secret[0..$], \"derived\", &"
    "empty_hash[0..$]);\n    Vec<u8> master = hkdf_extract_with(kind, &derived2[0..$], &zeros[0..$]);\n    "
    "Vec<u8> c_ap = derive_secret(kind, &master[0..$], \"c ap traffic\", &th_fin[0..$]);\n    Vec<u8> s_ap ="
    " derive_secret(kind, &master[0..$], \"s ap traffic\", &th_fin[0..$]);\n    // The client's flight: a co"
    "mpatibility ChangeCipherSpec, then Finished\n    // under the client handshake keys.\n    array<u8, 6>"
    " ccs = [20, 0x03, 0x03, 0x00, 0x01, 0x01];\n    write_all(&mut tcp, &ccs[0..$])?;\n    Vec<u8> mine = "
    "finished_data(kind, &c_hs[0..$], &th_fin[0..$]);\n    Vec<u8> cfin = Vec::new();\n    Vec::push(&mut c"
    "fin, 20);\n    push_u24(&mut cfin, Vec::len(&mine));\n    Vec::extend_from(&mut cfin, &mine[0..$]);\n  "
    "  RecordKeys client_hs = keys_from(&c_hs[0..$], suite);\n    Vec<u8> out = seal_record(&mut client_hs"
    ", 22, &cfin[0..$]);\n    write_all(&mut tcp, &out[0..$])?;\n    Ok(TlsStream {\n        .tcp = tcp,\n   "
    "     .send = keys_from(&c_ap[0..$], suite),\n        .recv = keys_from(&s_ap[0..$], suite),\n        ."
    "pending = Vec::new(),\n        .pending_at = 0,\n        .closed = false,\n        .peer = Some(leaf),\n"
    "    })\n}export fn TlsStream::connect(\n    SocketAddr addr,\n    StringView server_name,\n    ref<Trust"
    "Store, shared> roots,\n) : Result<TlsStream, TlsError>\n{\n    match (TcpStream::connect(addr))\n    {\n "
    "       Ok(tcp) : TlsStream::client(tcp, server_name, roots),\n        Err(e)  : Err(TlsNetFailure(e))"
    ",\n    }\n}export fn TlsStream::write(ref<TlsStream, exclusive> s, slice<u8, shared> data) : Result<vo"
    "id, TlsError>\n{\n    usize at = 0;\n    usize n = slice_len(data);\n    while (at < n)\n    {\n        us"
    "ize take = min(n - at, 16384);\n        Vec<u8> rec = seal_record(&mut s.send, 23, &data[at..at + tak"
    "e]);\n        write_all(&mut s.tcp, &rec[0..$])?;\n        at += take;\n    }\n    Ok(())\n}export fn Tls"
    "Stream::write_text(ref<TlsStream, exclusive> s, StringView text) : Result<void, TlsError>\n{\n    TlsS"
    "tream::write(s, text.bytes)\n}fn TlsStream::fill(ref<TlsStream, exclusive> s) : Result<void, TlsError"
    ">\n{\n    while (s.pending_at >= Vec::len(&s.pending) && !s.closed)\n    {\n        Record r = read_reco"
    "rd(&mut s.tcp)?;\n        if (r.kind == 20)\n        {\n            continue;\n        }\n        Inner {"
    " kind, content } = open_record(&mut s.recv, &r)?;\n        if (kind == 23)\n        {\n            over"
    "write(&mut s.pending, content);\n            s.pending_at = 0;\n        }\n        else if (kind == 21)"
    "\n        {\n            if (Vec::len(&content) == 2 && content[1] == 0)\n            {\n               "
    " s.closed = true;\n            }\n            else\n            {\n                return Err(PeerAlert("
    "if (Vec::len(&content) == 2) { content[1] } else { 0 }));\n            }\n        }\n        else if (k"
    "ind == 22)\n        {\n            usize at = 0;\n            while (at + 4 <= Vec::len(&content))\n    "
    "        {\n                u8 t = content[at];\n                usize len = widen<usize>(content[at + "
    "1]) << 16 | widen<usize>(content[at + 2]) << 8 | widen<usize>(content[at + 3]);\n                if ("
    "at + 4 + len > Vec::len(&content))\n                {\n                    return Err(ProtocolError);\n"
    "                }\n                if (t == 24)\n                {\n                    if (len != 1)\n "
    "                   {\n                        return Err(ProtocolError);\n                    }\n      "
    "              Vec<u8> none = Vec::new();\n                    HashKind kind = suite_hash(s.recv.suite"
    ");\n                    Vec<u8> next = hkdf_expand_label_with(\n                        kind,\n        "
    "                &s.recv.secret[0..$],\n                        \"traffic upd\",\n                       "
    " &none[0..$],\n                        Vec::len(&s.recv.secret),\n                    );\n             "
    "       overwrite(&mut s.recv, keys_from(&next[0..$], s.recv.suite));\n                    if (content"
    "[at + 4] == 1)\n                    {\n                        array<u8, 5> reply = [24, 0, 0, 1, 0];\n"
    "                        Vec<u8> rec = seal_record(&mut s.send, 22, &reply[0..$]);\n                  "
    "      write_all(&mut s.tcp, &rec[0..$])?;\n                        Vec<u8> mine = hkdf_expand_label_w"
    "ith(\n                            kind,\n                            &s.send.secret[0..$],\n           "
    "                 \"traffic upd\",\n                            &none[0..$],\n                           "
    " Vec::len(&s.send.secret),\n                        );\n                        overwrite(&mut s.send,"
    " keys_from(&mine[0..$], s.send.suite));\n                    }\n                }\n                else"
    " if (t != 4)\n                {\n                    return Err(ProtocolError);\n                }\n    "
    "            at = at + 4 + len;\n            }\n        }\n        else\n        {\n            return Err"
    "(ProtocolError);\n        }\n    }\n    Ok(())\n}export fn TlsStream::read(ref<TlsStream, exclusive> s, "
    "ref<Vec<u8>, exclusive> buf, usize max) : Result<usize, TlsError>\n{\n    if (max == 0)\n    {\n        "
    "return Ok(0);\n    }\n    TlsStream::fill(s)?;\n    usize have = Vec::len(&s.pending) - s.pending_at;\n "
    "   usize take = min(have, max);\n    Vec::extend_from(buf, &s.pending[s.pending_at..s.pending_at + ta"
    "ke]);\n    s.pending_at += take;\n    Ok(take)\n}export fn TlsStream::read_exact(\n    ref<TlsStream, ex"
    "clusive> s,\n    ref<Vec<u8>, exclusive> buf,\n    usize n,\n) : Result<void, TlsError>\n{\n    usize got"
    " = 0;\n    while (got < n)\n    {\n        usize k = TlsStream::read(s, buf, n - got)?;\n        if (k ="
    "= 0)\n        {\n            return Err(TlsNetFailure(Closed));\n        }\n        got += k;\n    }\n    "
    "Ok(())\n}export fn TlsStream::read_line(ref<TlsStream, exclusive> s) : Result<Option<String>, TlsErro"
    "r>\n{\n    Vec<u8> line = Vec::new();\n    while (true)\n    {\n        TlsStream::fill(s)?;\n        usiz"
    "e n = Vec::len(&s.pending);\n        if (s.pending_at >= n)\n        {\n            if (Vec::len(&line)"
    " == 0)\n            {\n                return Ok(None);\n            }\n            break;\n        }\n   "
    "     usize i = s.pending_at;\n        while (i < n && s.pending[i] != 10)\n        {\n            i += "
    "1;\n        }\n        if (i < n)\n        {\n            Vec::extend_from(&mut line, &s.pending[s.pendi"
    "ng_at..i]);\n            s.pending_at = i + 1;\n            break;\n        }\n        Vec::extend_from("
    "&mut line, &s.pending[s.pending_at..n]);\n        s.pending_at = n;\n    }\n    usize k = Vec::len(&lin"
    "e);\n    if (k > 0 && line[k - 1] == 13)\n    {\n        Vec::pop(&mut line);\n    }\n    match (String::"
    "from_utf8(line))\n    {\n        Ok(t)  : Ok(Some(t)),\n        Err(e) : Err(TlsNetFailure(NotUtf8(e)))"
    ",\n    }\n}export fn TlsStream::close(ref<TlsStream, exclusive> s) : Result<void, TlsError>\n{\n    arra"
    "y<u8, 2> alert = [1, 0];\n    Vec<u8> rec = seal_record(&mut s.send, 21, &alert[0..$]);\n    write_all"
    "(&mut s.tcp, &rec[0..$])\n}fn u16_list(slice<u8, shared> b, usize start, usize end, ref<Vec<u16>, exc"
    "lusive> out) : bool\n{\n    if ((end - start) % 2 != 0)\n    {\n        return false;\n    }\n    usize at"
    " = start;\n    while (at < end)\n    {\n        Vec::push(out, read_be<u16>(b, at));\n        at += 2;\n "
    "   }\n    true\n}fn client_hello_parse(slice<u8, shared> m) : Result<ClientHello, TlsError>\n{\n    usiz"
    "e n = slice_len(m);\n    if (n < 4 + 2 + 32 + 1 || m[0] != 1)\n    {\n        return Err(ProtocolError)"
    ";\n    }\n    usize at = 38;\n    usize sid_len = widen<usize>(m[at]);\n    if (sid_len > 32 || at + 1 +"
    " sid_len + 2 > n)\n    {\n        return Err(ProtocolError);\n    }\n    Vec<u8> session = Vec::from_sli"
    "ce(&m[at + 1..at + 1 + sid_len]);\n    at = at + 1 + sid_len;\n    usize suites_len = widen<usize>(rea"
    "d_be<u16>(m, at));\n    at += 2;\n    if (at + suites_len + 1 > n)\n    {\n        return Err(ProtocolEr"
    "ror);\n    }\n    Vec<u16> suites = Vec::new();\n    if (!u16_list(m, at, at + suites_len, &mut suites)"
    ")\n    {\n        return Err(ProtocolError);\n    }\n    at += suites_len;\n    usize comp_len = widen<us"
    "ize>(m[at]);\n    at += 1 + comp_len;\n    ClientHello ch = ClientHello {\n        .session = session,\n"
    "        .suites = suites,\n        .groups = Vec::new(),\n        .schemes = Vec::new(),\n        .shar"
    "e_groups = Vec::new(),\n        .shares = Vec::new(),\n        .tls13 = false,\n        .has_cookie = f"
    "alse,\n    };\n    if (at == n)\n    {\n        return Ok(ch);\n    }\n    if (at + 2 > n)\n    {\n        r"
    "eturn Err(ProtocolError);\n    }\n    usize ext_end = at + 2 + widen<usize>(read_be<u16>(m, at));\n    "
    "if (ext_end != n)\n    {\n        return Err(ProtocolError);\n    }\n    at += 2;\n    while (at + 4 <= e"
    "xt_end)\n    {\n        u16 kind = read_be<u16>(m, at);\n        usize len = widen<usize>(read_be<u16>("
    "m, at + 2));\n        usize start = at + 4;\n        if (start + len > ext_end)\n        {\n            "
    "return Err(ProtocolError);\n        }\n        if (kind == 0x002b)\n        {\n            // supported_"
    "versions: a 1-byte length and the versions.\n            if (len < 1 || widen<usize>(m[start]) + 1 !="
    " len)\n            {\n                return Err(ProtocolError);\n            }\n            Vec<u16> ve"
    "rsions = Vec::new();\n            if (!u16_list(m, start + 1, start + len, &mut versions))\n          "
    "  {\n                return Err(ProtocolError);\n            }\n            foreach (v in &versions)\n  "
    "          {\n                if (*v == 0x0304)\n                {\n                    ch.tls13 = true;"
    "\n                }\n            }\n        }\n        else if (kind == 0x000a || kind == 0x000d)\n      "
    "  {\n            if (len < 2 || widen<usize>(read_be<u16>(m, start)) + 2 != len)\n            {\n      "
    "          return Err(ProtocolError);\n            }\n            Vec<u16> list = Vec::new();\n         "
    "   if (!u16_list(m, start + 2, start + len, &mut list))\n            {\n                return Err(Pro"
    "tocolError);\n            }\n            if (kind == 0x000a)\n            {\n                overwrite(&"
    "mut ch.groups, list);\n            }\n            else\n            {\n                overwrite(&mut ch"
    ".schemes, list);\n            }\n        }\n        else if (kind == 0x0033)\n        {\n            if ("
    "len < 2 || widen<usize>(read_be<u16>(m, start)) + 2 != len)\n            {\n                return Err"
    "(ProtocolError);\n            }\n            usize p = start + 2;\n            while (p + 4 <= start + "
    "len)\n            {\n                u16 g = read_be<u16>(m, p);\n                usize klen = widen<us"
    "ize>(read_be<u16>(m, p + 2));\n                if (p + 4 + klen > start + len)\n                {\n    "
    "                return Err(ProtocolError);\n                }\n                Vec::push(&mut ch.share"
    "_groups, g);\n                Vec::push(&mut ch.shares, Vec::from_slice(&m[p + 4..p + 4 + klen]));\n  "
    "              p += 4 + klen;\n            }\n            if (p != start + len)\n            {\n         "
    "       return Err(ProtocolError);\n            }\n        }\n        else if (kind == 0x002c)\n        {"
    "\n            ch.has_cookie = true;\n        }\n        at = start + len;\n    }\n    if (at != ext_end)\n"
    "    {\n        return Err(ProtocolError);\n    }\n    Ok(ch)\n}fn send_plain_alert(ref<TcpStream, exclus"
    "ive> tcp, u8 code)\n{\n    array<u8, 7> rec = [21, 0x03, 0x03, 0, 2, 2, code];\n    _ = TcpStream::writ"
    "e(tcp, &rec[0..$]);\n}fn server_hello_bytes(\n    slice<u8, shared> random,\n    slice<u8, shared> sess"
    "ion,\n    u16 suite,\n    u16 group,\n    slice<u8, shared> share,\n    bool retry,\n) : Vec<u8>\n{\n    Ve"
    "c<u8> ext = Vec::new();\n    array<u8, 2> v13 = [0x03, 0x04];\n    push_extension(&mut ext, 0x002b, &v"
    "13[0..$]);\n    Vec<u8> ks = Vec::new();\n    Vec::push_be(&mut ks, group);\n    if (!retry)\n    {\n    "
    "    Vec::push_be(&mut ks, narrow<u16>(slice_len(share)));\n        Vec::extend_from(&mut ks, share);\n"
    "    }\n    push_extension(&mut ext, 0x0033, &ks[0..$]);\n    Vec<u8> body = Vec::new();\n    Vec::push_"
    "be(&mut body, 0x0303: u16);\n    Vec::extend_from(&mut body, random);\n    Vec::push(&mut body, narrow"
    "<u8>(slice_len(session)));\n    Vec::extend_from(&mut body, session);\n    Vec::push_be(&mut body, sui"
    "te);\n    Vec::push(&mut body, 0);\n    Vec::push_be(&mut body, narrow<u16>(Vec::len(&ext)));\n    Vec:"
    ":extend_from(&mut body, &ext[0..$]);\n    Vec<u8> msg = Vec::new();\n    Vec::push(&mut msg, 2);\n    p"
    "ush_u24(&mut msg, Vec::len(&body));\n    Vec::extend_from(&mut msg, &body[0..$]);\n    msg\n}fn send_ha"
    "ndshake(\n    ref<TcpStream, exclusive> tcp,\n    ref<RecordKeys, exclusive> keys,\n    ref<Handshake, "
    "exclusive> hs,\n    slice<u8, shared> msg,\n) : Result<void, TlsError>\n{\n    transcript_add(hs, msg);\n"
    "    usize at = 0;\n    while (at < slice_len(msg))\n    {\n        usize take = min(slice_len(msg) - at"
    ", 16384);\n        Vec<u8> rec = seal_record(keys, 22, &msg[at..at + take]);\n        write_all(tcp, &"
    "rec[0..$])?;\n        at += take;\n    }\n    Ok(())\n}fn server_scheme(ref<PrivateKey, shared> key, ref"
    "<Vec<u16>, shared> offered) : Option<u16>\n{\n    u16 want = match (key)\n    {\n        RsaPrivate(_)  "
    "   : 0x0804,\n        EcPrivate(k)      : if (k.curve == P256) { 0x0403 } else { 0x0503 },\n        Ed"
    "25519Private(_) : 0x0807,\n    };\n    foreach (s in offered)\n    {\n        if (*s == want)\n        {\n"
    "            return Some(want);\n        }\n    }\n    None\n}fn scheme_of(u16 code) : SignatureScheme\n{\n"
    "    if (code == 0x0403) { Ecdsa(Sha2_256) }\n    else if (code == 0x0503) { Ecdsa(Sha2_384) }\n    els"
    "e if (code == 0x0807) { Ed25519 }\n    else { RsaPss(Sha2_256) }\n}export fn TlsStream::server(\n    Tc"
    "pStream tcp,\n    ref<PrivateKey, shared> key,\n    slice<Certificate, shared> chain,\n) : Result<TlsSt"
    "ream, TlsError>\n{\n    if (slice_len(chain) == 0)\n    {\n        return Err(HandshakeFailed);\n    }\n  "
    "  Handshake hs = Handshake { .buffer = Vec::new(), .t256 = Hasher::new(Sha2_256), .t384 = Hasher::ne"
    "w(Sha2_384), .kind = Sha2_256 };\n    Option<RecordKeys> plain = None;\n    Vec<u8> chm = next_message"
    "(&mut hs, &mut tcp, &mut plain)?;\n    ClientHello ch = client_hello_parse(&chm[0..$])?;\n    if (!ch."
    "tls13)\n    {\n        send_plain_alert(&mut tcp, 70);\n        return Err(HandshakeFailed);\n    }\n    "
    "// The suite: the client's first that this server has.\n    u16 suite = 0;\n    foreach (s in &ch.suit"
    "es)\n    {\n        if (suite == 0 && (*s == 0x1303 || *s == 0x1301 || *s == 0x1302))\n        {\n      "
    "      suite = *s;\n        }\n    }\n    u16 scheme_code = match (server_scheme(key, &ch.schemes))\n    "
    "{\n        Some(c) : c,\n        None    : 0,\n    };\n    if (suite == 0 || scheme_code == 0)\n    {\n   "
    "     send_plain_alert(&mut tcp, 40);\n        return Err(HandshakeFailed);\n    }\n    hs.kind = suite_"
    "hash(suite);\n    HashKind kind = hs.kind;\n    // The group: the client's first key share for a group"
    " this server\n    // has; else a HelloRetryRequest for the first group it supports.\n    u16 group = 0"
    ";\n    Vec<u8> client_share = Vec::new();\n    for (usize i = 0; i < Vec::len(&ch.share_groups) && gro"
    "up == 0; i += 1)\n    {\n        u16 g = ch.share_groups[i];\n        if (g == 0x001d || g == 0x0017 ||"
    " g == 0x0018)\n        {\n            group = g;\n            overwrite(&mut client_share, Vec::clone(&"
    "ch.shares[i]));\n        }\n    }\n    Vec<u8> session = Vec::clone(&ch.session);\n    if (group == 0)\n "
    "   {\n        u16 ask = 0;\n        foreach (g in &ch.groups)\n        {\n            if (ask == 0 && (*"
    "g == 0x001d || *g == 0x0017 || *g == 0x0018))\n            {\n                ask = *g;\n            }\n"
    "        }\n        if (ask == 0 || ch.has_cookie)\n        {\n            send_plain_alert(&mut tcp, 40"
    ");\n            return Err(HandshakeFailed);\n        }\n        // RFC 8446 §4.1.4: the transcript re"
    "starts from\n        // message_hash(ClientHello1) ‖ HelloRetryRequest.\n        Vec<u8> ch_hash = h"
    "ash(kind, &chm[0..$]);\n        array<u8, 4> head = [254, 0, 0, narrow<u8>(Vec::len(&ch_hash))];\n    "
    "    Handshake restarted = Handshake { .buffer = Vec::new(), .t256 = Hasher::new(Sha2_256), .t384 = H"
    "asher::new(Sha2_384), .kind = kind };\n        transcript_add(&mut restarted, &head[0..$]);\n        t"
    "ranscript_add(&mut restarted, &ch_hash[0..$]);\n        Vec<u8> hrr_random = Result::unwrap_or(\n     "
    "       from_hex(\"cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c\"),\n            Vec"
    "::new(),\n        );\n        Vec<u8> none = Vec::new();\n        Vec<u8> hrr = server_hello_bytes(&hrr"
    "_random[0..$], &session[0..$], suite, ask, &none[0..$], true);\n        transcript_add(&mut restarted"
    ", &hrr[0..$]);\n        overwrite(&mut hs, restarted);\n        write_all(&mut tcp, &handshake_record("
    "&hrr[0..$], 0x0303)[0..$])?;\n        Vec<u8> chm2 = next_message(&mut hs, &mut tcp, &mut plain)?;\n  "
    "      ClientHello ch2 = client_hello_parse(&chm2[0..$])?;\n        bool suite_ok = false;\n        for"
    "each (s in &ch2.suites)\n        {\n            if (*s == suite)\n            {\n                suite_o"
    "k = true;\n            }\n        }\n        for (usize i = 0; i < Vec::len(&ch2.share_groups) && group"
    " == 0; i += 1)\n        {\n            if (ch2.share_groups[i] == ask)\n            {\n                g"
    "roup = ask;\n                overwrite(&mut client_share, Vec::clone(&ch2.shares[i]));\n            }\n"
    "        }\n        if (group == 0 || !suite_ok || !ch2.tls13 || !same_session(&ch2.session, &session)"
    ")\n        {\n            send_plain_alert(&mut tcp, 47);\n            return Err(HandshakeFailed);\n   "
    "     }\n    }\n    // This server's share and the shared secret.\n    Vec<u8> public_key = Vec::new();\n"
    "    Vec<u8> shared = Vec::new();\n    if (group == 0x001d)\n    {\n        array<u8, 32> private_key = "
    "x25519_private_key();\n        Vec::extend_from(&mut public_key, &x25519_public_key(&private_key[0..$"
    "])[0..$]);\n        match (x25519(&private_key[0..$], &client_share[0..$]))\n        {\n            Som"
    "e(z) : Vec::extend_from(&mut shared, &z[0..$]),\n            None    :\n            {\n                "
    "send_plain_alert(&mut tcp, 47);\n                return Err(HandshakeFailed);\n            },\n        "
    "}\n    }\n    else\n    {\n        EcCurve curve = if (group == 0x0017) { P256 } else { P384 };\n        "
    "Vec<u8> ec_key = ec_private_key(curve);\n        overwrite(&mut public_key, Option::unwrap(ec_public_"
    "key(curve, &ec_key[0..$])));\n        match (ecdh(curve, &ec_key[0..$], &client_share[0..$]))\n       "
    " {\n            Some(z) : overwrite(&mut shared, z),\n            None    :\n            {\n            "
    "    send_plain_alert(&mut tcp, 47);\n                return Err(HandshakeFailed);\n            },\n    "
    "    }\n    }\n    array<u8, 32> random = [0; 32];\n    os_random_bytes(&mut random[0..$]);\n    Vec<u8> "
    "sh = server_hello_bytes(&random[0..$], &session[0..$], suite, group, &public_key[0..$], false);\n    "
    "transcript_add(&mut hs, &sh[0..$]);\n    write_all(&mut tcp, &handshake_record(&sh[0..$], 0x0303)[0.."
    "$])?;\n    array<u8, 6> ccs = [20, 0x03, 0x03, 0x00, 0x01, 0x01];\n    write_all(&mut tcp, &ccs[0..$])"
    "?;\n    // The key schedule (RFC 8446 §7.1).\n    Vec<u8> none = Vec::new();\n    Vec<u8> empty_hash ="
    " hash(kind, &none[0..$]);\n    Vec<u8> zeros = Vec::filled(Vec::len(&empty_hash), 0: u8);\n    Vec<u8>"
    " early = hkdf_extract_with(kind, &none[0..$], &zeros[0..$]);\n    Vec<u8> derived = derive_secret(kin"
    "d, &early[0..$], \"derived\", &empty_hash[0..$]);\n    Vec<u8> handshake_secret = hkdf_extract_with(kin"
    "d, &derived[0..$], &shared[0..$]);\n    Vec<u8> th = transcript_hash(&hs);\n    Vec<u8> c_hs = derive_"
    "secret(kind, &handshake_secret[0..$], \"c hs traffic\", &th[0..$]);\n    Vec<u8> s_hs = derive_secret(k"
    "ind, &handshake_secret[0..$], \"s hs traffic\", &th[0..$]);\n    RecordKeys server_hs = keys_from(&s_hs"
    "[0..$], suite);\n    // EncryptedExtensions (none), Certificate, CertificateVerify, Finished.\n    arr"
    "ay<u8, 6> ee = [8, 0, 0, 2, 0, 0];\n    send_handshake(&mut tcp, &mut server_hs, &mut hs, &ee[0..$])?"
    ";\n    Vec<u8> list = Vec::new();\n    foreach (c in chain)\n    {\n        push_u24(&mut list, Vec::len"
    "(&c.der));\n        Vec::extend_from(&mut list, &c.der[0..$]);\n        Vec::push_be(&mut list, 0: u16"
    ");\n    }\n    Vec<u8> cert = Vec::new();\n    Vec::push(&mut cert, 11);\n    push_u24(&mut cert, 4 + Ve"
    "c::len(&list));\n    Vec::push(&mut cert, 0);\n    push_u24(&mut cert, Vec::len(&list));\n    Vec::exte"
    "nd_from(&mut cert, &list[0..$]);\n    send_handshake(&mut tcp, &mut server_hs, &mut hs, &cert[0..$])?"
    ";\n    Vec<u8> th_cert = transcript_hash(&hs);\n    Vec<u8> content = Vec::filled(64, 0x20: u8);\n    V"
    "ec::extend_from(&mut content, &b\"TLS 1.3, server CertificateVerify\"[0..$]);\n    Vec::push(&mut conte"
    "nt, 0);\n    Vec::extend_from(&mut content, &th_cert[0..$]);\n    SignatureScheme scheme = scheme_of(s"
    "cheme_code);\n    Vec<u8> signature = match (sign(key, &scheme, &content[0..$]))\n    {\n        Some(s"
    ") : s,\n        None    : return Err(HandshakeFailed),\n    };\n    Vec<u8> cv = Vec::new();\n    Vec::p"
    "ush(&mut cv, 15);\n    push_u24(&mut cv, 4 + Vec::len(&signature));\n    Vec::push_be(&mut cv, scheme_"
    "code);\n    Vec::push_be(&mut cv, narrow<u16>(Vec::len(&signature)));\n    Vec::extend_from(&mut cv, &"
    "signature[0..$]);\n    send_handshake(&mut tcp, &mut server_hs, &mut hs, &cv[0..$])?;\n    Vec<u8> th_"
    "cv = transcript_hash(&hs);\n    Vec<u8> fin_data = finished_data(kind, &s_hs[0..$], &th_cv[0..$]);\n  "
    "  Vec<u8> fin = Vec::new();\n    Vec::push(&mut fin, 20);\n    push_u24(&mut fin, Vec::len(&fin_data))"
    ";\n    Vec::extend_from(&mut fin, &fin_data[0..$]);\n    send_handshake(&mut tcp, &mut server_hs, &mut"
    " hs, &fin[0..$])?;\n    Vec<u8> th_fin = transcript_hash(&hs);\n    Vec<u8> derived2 = derive_secret(k"
    "ind, &handshake_secret[0..$], \"derived\", &empty_hash[0..$]);\n    Vec<u8> master = hkdf_extract_with("
    "kind, &derived2[0..$], &zeros[0..$]);\n    Vec<u8> c_ap = derive_secret(kind, &master[0..$], \"c ap tr"
    "affic\", &th_fin[0..$]);\n    Vec<u8> s_ap = derive_secret(kind, &master[0..$], \"s ap traffic\", &th_fi"
    "n[0..$]);\n    // The client's Finished, under its handshake keys.\n    Option<RecordKeys> client_hs ="
    " Some(keys_from(&c_hs[0..$], suite));\n    Vec<u8> cfin = next_message(&mut hs, &mut tcp, &mut client"
    "_hs)?;\n    Vec<u8> want = finished_data(kind, &c_hs[0..$], &th_fin[0..$]);\n    if (Vec::len(&cfin) !"
    "= 4 + Vec::len(&want) || cfin[0] != 20 || !digest_eq(&cfin[4..$], &want[0..$]))\n    {\n        return"
    " Err(HandshakeFailed);\n    }\n    if (Vec::len(&hs.buffer) != 0)\n    {\n        return Err(ProtocolErr"
    "or);\n    }\n    Ok(TlsStream {\n        .tcp = tcp,\n        .send = keys_from(&s_ap[0..$], suite),\n   "
    "     .recv = keys_from(&c_ap[0..$], suite),\n        .pending = Vec::new(),\n        .pending_at = 0,\n"
    "        .closed = false,\n        .peer = None,\n    })\n}fn same_session(ref<Vec<u8>, shared> a, ref<V"
    "ec<u8>, shared> b) : bool\n{\n    Vec::len(a) == Vec::len(b) && digest_eq(&(*a)[0..$], &(*b)[0..$])\n}e"
    "xport fn HttpError::text(ref<HttpError, shared> e) : str\n{\n    match (e)\n    {\n        HttpNetFailur"
    "e(n) : NetError::text(n),\n        HttpTlsFailure(t) : TlsError::text(t),\n        BadUrl            :"
    " \"the URL is malformed\",\n        UnsupportedScheme : \"the URL's scheme is neither http nor https\",\n "
    "       NoRoots           : \"no trusted roots for https (TrustStore::system failed)\",\n        BadMess"
    "age        : \"the HTTP message is malformed\",\n        TooLarge          : \"the HTTP message is large"
    "r than the limit\",\n        TooManyRedirects  : \"too many redirects\",\n        ConnectionClosed  : \"th"
    "e connection was closed\",\n    }\n}fn default_port(StringView scheme) : u16\n{\n    if (StringView::eq(s"
    "cheme, \"https\")) { 443 } else { 80 }\n}export fn Url::parse(StringView text) : Result<Url, HttpError>"
    "\n{\n    usize sep = match (StringView::find(text, \"://\"))\n    {\n        Some(i) : i,\n        None    "
    ": return Err(BadUrl),\n    };\n    String scheme = String::to_ascii_lower(&String::from_view(StringVie"
    "w::sub(text, 0, sep)));\n    StringView rest = StringView::sub(text, sep + 3, StringView::len(text));"
    "\n    usize n = StringView::len(rest);\n    slice<u8, shared> b = StringView::as_bytes(rest);\n    usiz"
    "e auth_end = 0;\n    while (auth_end < n && b[auth_end] != b'/' && b[auth_end] != b'?' && b[auth_end]"
    " != b'#')\n    {\n        auth_end += 1;\n    }\n    StringView authority = StringView::sub(rest, 0, aut"
    "h_end);\n    if (auth_end == 0 || Option::is_some(&StringView::find(authority, \"@\")))\n    {\n        r"
    "eturn Err(BadUrl);\n    }\n    slice<u8, shared> ab = StringView::as_bytes(authority);\n    usize host_"
    "end = auth_end;\n    if (ab[0] == b'[')\n    {\n        host_end = match (StringView::find(authority, \""
    "]\"))\n        {\n            Some(i) : i + 1,\n            None    : return Err(BadUrl),\n        };\n   "
    " }\n    else\n    {\n        host_end = 0;\n        while (host_end < auth_end && ab[host_end] != b':')\n"
    "        {\n            host_end += 1;\n        }\n    }\n    String host = String::to_ascii_lower(&Strin"
    "g::from_view(StringView::sub(authority, 0, host_end)));\n    u16 port = default_port(String::as_view("
    "&scheme));\n    if (host_end < auth_end)\n    {\n        if (ab[host_end] != b':')\n        {\n          "
    "  return Err(BadUrl);\n        }\n        port = match (StringView::parse<u16>(StringView::sub(authori"
    "ty, host_end + 1, auth_end)))\n        {\n            Ok(p)  : p,\n            Err(_) : return Err(BadU"
    "rl),\n        };\n    }\n    usize path_end = auth_end;\n    while (path_end < n && b[path_end] != b'?' "
    "&& b[path_end] != b'#')\n    {\n        path_end += 1;\n    }\n    String path = if (path_end == auth_en"
    "d) { String::from_str(\"/\") } else\n    {\n        String::from_view(StringView::sub(\n            rest,"
    "\n            auth_end,\n            path_end,\n        ))\n    };\n    String query = String::new();\n   "
    " if (path_end < n && b[path_end] == b'?')\n    {\n        usize q_end = path_end + 1;\n        while (q"
    "_end < n && b[q_end] != b'#')\n        {\n            q_end += 1;\n        }\n        String::append(&mu"
    "t query, StringView::sub(rest, path_end + 1, q_end));\n    }\n    Ok(Url { .scheme = scheme, .host = h"
    "ost, .port = port, .path = path, .query = query })\n}export fn Url::target(ref<Url, shared> u) : Stri"
    "ng\n{\n    String t = String::clone(&u.path);\n    if (String::len(&u.query) > 0)\n    {\n        String:"
    ":append(&mut t, \"?\");\n        String::append(&mut t, String::as_view(&u.query));\n    }\n    t\n}fn hos"
    "t_text(ref<Url, shared> u) : String\n{\n    String h = String::clone(&u.host);\n    if (u.port != defau"
    "lt_port(String::as_view(&u.scheme)))\n    {\n        String::append(&mut h, \":\");\n        String::appe"
    "nd(&mut h, u.port);\n    }\n    h\n}export fn Url::text(ref<Url, shared> u) : String\n{\n    String t = S"
    "tring::clone(&u.scheme);\n    String::append(&mut t, \"://\");\n    String::append(&mut t, String::as_vi"
    "ew(&host_text(u)));\n    String::append(&mut t, String::as_view(&Url::target(u)));\n    t\n}fn is_unres"
    "erved(u8 b) : bool\n{\n    ascii_is_alnum(b) || b == b'-' || b == b'.' || b == b'_' || b == b'~'\n}expo"
    "rt fn percent_encode(slice<u8, shared> bytes) : String\n{\n    String out = String::new();\n    str dig"
    "its = \"0123456789ABCDEF\";\n    foreach (c in bytes)\n    {\n        if (is_unreserved(*c))\n        {\n  "
    "          String::push_ascii(&mut out, *c);\n        }\n        else\n        {\n            String::pus"
    "h_ascii(&mut out, b'%');\n            String::push_ascii(&mut out, str_byte(digits, widen<usize>(*c >"
    "> 4)));\n            String::push_ascii(&mut out, str_byte(digits, widen<usize>(*c & 15)));\n        }"
    "\n    }\n    out\n}fn hex_digit(u8 c) : Option<u8>\n{\n    if (c >= b'0' && c <= b'9') { Some(c - b'0') }"
    "\n    else if (c >= b'a' && c <= b'f') { Some(c - b'a' + 10) }\n    else if (c >= b'A' && c <= b'F') {"
    " Some(c - b'A' + 10) }\n    else { None }\n}export fn percent_decode(StringView text) : Option<Vec<u8>"
    ">\n{\n    slice<u8, shared> b = StringView::as_bytes(text);\n    Vec<u8> out = Vec::new();\n    usize i "
    "= 0;\n    while (i < slice_len(b))\n    {\n        if (b[i] == b'%')\n        {\n            if (i + 3 > "
    "slice_len(b))\n            {\n                return None;\n            }\n            u8 hi = hex_digit"
    "(b[i + 1])?;\n            u8 lo = hex_digit(b[i + 2])?;\n            Vec::push(&mut out, hi * 16 + lo)"
    ";\n            i += 3;\n        }\n        else\n        {\n            Vec::push(&mut out, b[i]);\n      "
    "      i += 1;\n        }\n    }\n    Some(out)\n}export fn Param::new(StringView name, StringView value)"
    " : Param\n{\n    Param { .name = String::from_view(name), .value = String::from_view(value) }\n}export "
    "fn find_param(slice<Param, shared> params, str name) : Option<StringView>\n{\n    for (usize i = 0; i "
    "< slice_len(params); i += 1)\n    {\n        if (String::eq_str(&params[i].name, name))\n        {\n    "
    "        return Some(String::as_view(&params[i].value));\n        }\n    }\n    None\n}export fn form_dec"
    "ode(StringView text) : Vec<Param>\n{\n    Vec<Param> out = Vec::new();\n    foreach (pair in StringView"
    "::split(text, \"&\"))\n    {\n        foreach (p in StringView::split(pair, \";\"))\n        {\n            "
    "if (StringView::len(p) == 0)\n            {\n                continue;\n            }\n            Strin"
    "gView name = p;\n            StringView value = StringView::of(\"\");\n            if (Some(eq) = String"
    "View::find(p, \"=\"))\n            {\n                name = StringView::sub(p, 0, eq);\n                "
    "value = StringView::sub(p, eq + 1, StringView::len(p));\n            }\n            Vec::push(&mut out"
    ", Param { .name = form_part(name), .value = form_part(value) });\n        }\n    }\n    out\n}fn form_pa"
    "rt(StringView v) : String\n{\n    String plus = StringView::replace(v, \"+\", \" \");\n    match (percent_d"
    "ecode(String::as_view(&plus)))\n    {\n        Some(b) : match (String::from_utf8(b))\n        {\n      "
    "      Ok(s)  : s,\n            Err(_) : plus,\n        },\n        None : plus,\n    }\n}export fn form_e"
    "ncode(slice<Param, shared> params) : String\n{\n    String out = String::new();\n    for (usize i = 0; "
    "i < slice_len(params); i += 1)\n    {\n        if (i > 0)\n        {\n            String::push_ascii(&mu"
    "t out, b'&');\n        }\n        String::append(&mut out, String::as_view(&form_encode_part(&params[i"
    "].name)));\n        String::push_ascii(&mut out, b'=');\n        String::append(&mut out, String::as_v"
    "iew(&form_encode_part(&params[i].value)));\n    }\n    out\n}fn form_encode_part(ref<String, shared> s)"
    " : String\n{\n    String enc = percent_encode(StringView::as_bytes(String::as_view(s)));\n    String::r"
    "eplace(&enc, \"%20\", \"+\")\n}export fn Url::query_pairs(ref<Url, shared> u) : Vec<Param>\n{\n    form_dec"
    "ode(String::as_view(&u.query))\n}export fn Header::new(StringView name, StringView value) : Header\n{\n"
    "    Header { .name = String::from_view(name), .value = String::from_view(value) }\n}fn name_eq(String"
    "View a, str b) : bool\n{\n    ascii_ieq_str(a.bytes, b)\n}fn names_eq(StringView a, StringView b) : boo"
    "l\n{\n    ascii_ieq(a.bytes, b.bytes)\n}fn ascii_ieq(slice<u8, shared> a, slice<u8, shared> b) : bool\n{"
    "\n    if (slice_len(a) != slice_len(b))\n    {\n        return false;\n    }\n    for (usize i = 0; i < s"
    "lice_len(a); i += 1)\n    {\n        if (ascii_to_lower(a[i]) != ascii_to_lower(b[i]))\n        {\n     "
    "       return false;\n        }\n    }\n    true\n}fn ascii_ieq_str(slice<u8, shared> a, str b) : bool\n{"
    "\n    if (slice_len(a) != str_len(b))\n    {\n        return false;\n    }\n    for (usize i = 0; i < sli"
    "ce_len(a); i += 1)\n    {\n        if (ascii_to_lower(a[i]) != ascii_to_lower(str_byte(b, i)))\n       "
    " {\n            return false;\n        }\n    }\n    true\n}fn has_header(slice<Header, shared> headers, "
    "StringView name) : bool\n{\n    for (usize i = 0; i < slice_len(headers); i += 1)\n    {\n        if (na"
    "mes_eq(String::as_view(&headers[i].name), name))\n        {\n            return true;\n        }\n    }\n"
    "    false\n}export fn find_header(slice<Header, shared> headers, str name) : Option<StringView>\n{\n   "
    " for (usize i = 0; i < slice_len(headers); i += 1)\n    {\n        if (name_eq(String::as_view(&header"
    "s[i].name), name))\n        {\n            return Some(String::as_view(&headers[i].value));\n        }\n"
    "    }\n    None\n}export fn Request::new(StringView method, StringView url) : Request\n{\n    Request { "
    ".method = String::from_view(method), .url = String::from_view(url), .headers = Vec::new(), .body = V"
    "ec::new() }\n}export fn Request::header(ref<Request, shared> r, str name) : Option<StringView>\n{\n    "
    "find_header(&r.headers[0..$], name)\n}export fn Response::header(ref<Response, shared> r, str name) :"
    " Option<StringView>\n{\n    find_header(&r.headers[0..$], name)\n}export fn Response::text(ref<Response"
    ", shared> r) : Result<String, Utf8Error>\n{\n    String::from_utf8(Vec::clone(&r.body))\n}export fn rea"
    "son_phrase(u16 status) : str\n{\n    match (status)\n    {\n        100 : \"Continue\",\n        101 : \"Swi"
    "tching Protocols\",\n        200 : \"OK\",\n        201 : \"Created\",\n        202 : \"Accepted\",\n        20"
    "4 : \"No Content\",\n        206 : \"Partial Content\",\n        301 : \"Moved Permanently\",\n        302 : "
    "\"Found\",\n        303 : \"See Other\",\n        304 : \"Not Modified\",\n        307 : \"Temporary Redirect\""
    ",\n        308 : \"Permanent Redirect\",\n        400 : \"Bad Request\",\n        401 : \"Unauthorized\",\n   "
    "     403 : \"Forbidden\",\n        404 : \"Not Found\",\n        405 : \"Method Not Allowed\",\n        408 :"
    " \"Request Timeout\",\n        409 : \"Conflict\",\n        411 : \"Length Required\",\n        413 : \"Conten"
    "t Too Large\",\n        415 : \"Unsupported Media Type\",\n        429 : \"Too Many Requests\",\n        500"
    " : \"Internal Server Error\",\n        501 : \"Not Implemented\",\n        502 : \"Bad Gateway\",\n        50"
    "3 : \"Service Unavailable\",\n        504 : \"Gateway Timeout\",\n        _   : \"\",\n    }\n}fn conn_read(re"
    "f<Conn, exclusive> c, ref<Vec<u8>, exclusive> buf, usize max) : Result<usize, HttpError>\n{\n    match"
    " (c)\n    {\n        Plain(s) : match (TcpStream::read(s, buf, max))\n        {\n            Ok(n)  : Ok"
    "(n),\n            Err(e) : Err(HttpNetFailure(e)),\n        },\n        Secure(s) : match (TlsStream::r"
    "ead(s, buf, max))\n        {\n            Ok(n)  : Ok(n),\n            Err(e) : Err(HttpTlsFailure(e)),"
    "\n        },\n    }\n}fn conn_write(ref<Conn, exclusive> c, slice<u8, shared> data) : Result<void, Http"
    "Error>\n{\n    match (c)\n    {\n        Plain(s) : match (TcpStream::write(s, data))\n        {\n        "
    "    Ok(_)  : Ok(()),\n            Err(e) : Err(HttpNetFailure(e)),\n        },\n        Secure(s) : mat"
    "ch (TlsStream::write(s, data))\n        {\n            Ok(_)  : Ok(()),\n            Err(e) : Err(HttpT"
    "lsFailure(e)),\n        },\n    }\n}fn conn_close(ref<Conn, exclusive> c)\n{\n    match (c)\n    {\n       "
    " Plain(s)  : { _ = TcpStream::shutdown_write(s); },\n        Secure(s) : { _ = TlsStream::close(s); }"
    ",\n    }\n}fn fill_buffer(ref<Reader, exclusive> r) : Result<bool, HttpError>\n{\n    if (r.at > 0 && r."
    "at == Vec::len(&r.buf))\n    {\n        Vec::clear(&mut r.buf);\n        r.at = 0;\n    }\n    usize n = "
    "conn_read(&mut r.conn, &mut r.buf, 16384)?;\n    Ok(n > 0)\n}fn available(ref<Reader, shared> r) : usi"
    "ze\n{\n    Vec::len(&r.buf) - r.at\n}fn http_newline_from(slice<u8, shared> b, usize at) : usize\n{\n    "
    "usize i = at;\n    while (i < slice_len(b) && b[i] != b'\\n')\n    {\n        i += 1;\n    }\n    i\n}fn ht"
    "tp_line(ref<Reader, exclusive> r, usize limit) : Result<Option<String>, HttpError>\n{\n    usize scann"
    "ed = 0;\n    while (true)\n    {\n        usize i = http_newline_from(&r.buf[0..$], r.at + scanned);\n  "
    "      if (i < Vec::len(&r.buf))\n        {\n            usize end = if (i > r.at && r.buf[i - 1] == b'"
    "\\r') { i - 1 } else { i };\n            Vec<u8> bytes = Vec::from_slice(&r.buf[r.at..end]);\n         "
    "   r.at = i + 1;\n            return match (String::from_utf8(bytes))\n            {\n                O"
    "k(s)  : Ok(Some(s)),\n                Err(_) : Err(BadMessage),\n            };\n        }\n        scan"
    "ned = Vec::len(&r.buf) - r.at;\n        if (scanned > limit)\n        {\n            return Err(TooLarg"
    "e);\n        }\n        if (!fill_buffer(r)?)\n        {\n            return if (scanned == 0) { Ok(None"
    ") } else { Err(BadMessage) };\n        }\n    }\n}fn read_n(ref<Reader, exclusive> r, ref<Vec<u8>, excl"
    "usive> out, usize n) : Result<void, HttpError>\n{\n    usize need = n;\n    while (need > 0)\n    {\n    "
    "    if (available(r) == 0)\n        {\n            if (!fill_buffer(r)?)\n            {\n               "
    " return Err(ConnectionClosed);\n            }\n        }\n        usize take = min(need, available(r));"
    "\n        Vec::extend_from(out, &r.buf[r.at..r.at + take]);\n        r.at += take;\n        need -= tak"
    "e;\n    }\n    Ok(())\n}fn read_to_end(ref<Reader, exclusive> r, ref<Vec<u8>, exclusive> out, usize max"
    ") : Result<void, HttpError>\n{\n    while (true)\n    {\n        usize have = available(r);\n        if ("
    "have > 0)\n        {\n            if (Vec::len(out) + have > max)\n            {\n                return"
    " Err(TooLarge);\n            }\n            Vec::extend_from(out, &r.buf[r.at..$]);\n            r.at ="
    " Vec::len(&r.buf);\n        }\n        if (!fill_buffer(r)?)\n        {\n            return Ok(());\n    "
    "    }\n    }\n}fn read_headers(ref<Reader, exclusive> r, usize used) : Result<Vec<Header>, HttpError>\n"
    "{\n    Vec<Header> headers = Vec::new();\n    usize total = used;\n    while (true)\n    {\n        Strin"
    "g line = match (http_line(r, MAX_HEAD)?)\n        {\n            Some(l) : l,\n            None    : re"
    "turn Err(BadMessage),\n        };\n        total += String::len(&line) + 2;\n        if (total > MAX_HE"
    "AD)\n        {\n            return Err(TooLarge);\n        }\n        if (String::len(&line) == 0)\n     "
    "   {\n            return Ok(headers);\n        }\n        StringView v = String::as_view(&line);\n      "
    "  usize colon = match (StringView::find(v, \":\"))\n        {\n            Some(i) : i,\n            None"
    "    : return Err(BadMessage),\n        };\n        StringView name = StringView::sub(v, 0, colon);\n   "
    "     if (colon == 0 || StringView::len(StringView::trim(name)) != colon)\n        {\n            retur"
    "n Err(BadMessage);\n        }\n        Vec::push(\n            &mut headers,\n            Header { .name"
    " = String::from_view(name), .value = String::from_view(StringView::trim(StringView::sub(\n           "
    "     v,\n                colon + 1,\n                StringView::len(v),\n            ))) },\n        );"
    "\n    }\n}fn body_length(slice<Header, shared> headers, bool response) : Result<BodyLength, HttpError>"
    "\n{\n    Option<StringView> te = find_header(headers, \"transfer-encoding\");\n    Option<StringView> cl "
    "= find_header(headers, \"content-length\");\n    if (Some(t) = te)\n    {\n        if (Option::is_some(&c"
    "l) || !name_eq(StringView::trim(t), \"chunked\"))\n        {\n            return Err(BadMessage);\n      "
    "  }\n        return Ok(Chunked);\n    }\n    if (Some(c) = cl)\n    {\n        return match (StringView::"
    "parse<usize>(StringView::trim(c)))\n        {\n            Ok(n)  : Ok(Length(n)),\n            Err(_) "
    ": Err(BadMessage),\n        };\n    }\n    Ok(if (response) { UntilClose } else { NoBody })\n}fn read_bo"
    "dy(ref<Reader, exclusive> r, BodyLength how, usize max) : Result<Vec<u8>, HttpError>\n{\n    Vec<u8> b"
    "ody = Vec::new();\n    match (how)\n    {\n        NoBody     : {},\n        Length(n)  :\n        {\n    "
    "        if (n > max)\n            {\n                return Err(TooLarge);\n            }\n            r"
    "ead_n(r, &mut body, n)?;\n        },\n        UntilClose : read_to_end(r, &mut body, max)?,\n        Ch"
    "unked    :\n        {\n            while (true)\n            {\n                String line = match (htt"
    "p_line(r, MAX_HEAD)?)\n                {\n                    Some(l) : l,\n                    None   "
    " : return Err(ConnectionClosed),\n                };\n                StringView size_text = String::a"
    "s_view(&line);\n                if (Some(semi) = StringView::find(size_text, \";\"))\n                {\n"
    "                    size_text = StringView::sub(size_text, 0, semi);\n                }\n             "
    "   usize size = 0;\n                slice<u8, shared> sb = StringView::as_bytes(StringView::trim(size"
    "_text));\n                if (slice_len(sb) == 0 || slice_len(sb) > 8)\n                {\n            "
    "        return Err(BadMessage);\n                }\n                foreach (c in sb)\n                "
    "{\n                    size = size * 16 + widen<usize>(Option::ok_or(hex_digit(*c), BadMessage)?);\n  "
    "              }\n                if (size == 0)\n                {\n                    break;\n        "
    "        }\n                if (Vec::len(&body) + size > max)\n                {\n                    re"
    "turn Err(TooLarge);\n                }\n                read_n(r, &mut body, size)?;\n                m"
    "atch (http_line(r, 2)?)\n                {\n                    Some(end) : if (String::len(&end) != 0"
    ") { return Err(BadMessage); },\n                    None      : return Err(ConnectionClosed),\n       "
    "         }\n            }\n            // Trailers, up to the empty line.\n            while (true)\n   "
    "         {\n                match (http_line(r, MAX_HEAD)?)\n                {\n                    Som"
    "e(t) : if (String::len(&t) == 0) { break; },\n                    None    : return Err(ConnectionClos"
    "ed),\n                }\n            }\n        },\n    }\n    Ok(body)\n}export fn HttpClient::new() : Ht"
    "tpClient\n{\n    Vec<Header> headers = Vec::new();\n    Vec::push(&mut headers, Header::new(\"User-Agent"
    "\", \"CobaltC-std-http/1\"));\n    Vec::push(&mut headers, Header::new(\"Accept-Encoding\", \"gzip, deflate"
    "\"));\n    HttpClient { .roots = None, .timeout_ms = 30000, .max_redirects = 10, .max_body = 16777216,"
    " .headers = headers, .keep_alive = false, .idle = None }\n}fn method_has_body(StringView m) : bool\n{\n"
    "    StringView::eq(m, \"POST\") || StringView::eq(m, \"PUT\") || StringView::eq(m, \"PATCH\")\n}fn open_con"
    "nection(ref<HttpClient, exclusive> c, ref<Url, shared> u) : Result<Conn, HttpError>\n{\n    bool secur"
    "e = StringView::eq(String::as_view(&u.scheme), \"https\");\n    if (!secure && !StringView::eq(String::"
    "as_view(&u.scheme), \"http\"))\n    {\n        return Err(UnsupportedScheme);\n    }\n    if (secure && Op"
    "tion::is_none(&c.roots))\n    {\n        match (TrustStore::system())\n        {\n            Ok(t)  : o"
    "verwrite(&mut c.roots, Some(t)),\n            Err(_) : return Err(NoRoots),\n        }\n    }\n    // A "
    "bracketed IPv6 host loses its brackets for resolution.\n    String host = String::clone(&u.host);\n   "
    " if (String::starts_with(&host, \"[\") && String::ends_with(&host, \"]\"))\n    {\n        overwrite(&mut "
    "host, String::from_view(StringView::sub(String::as_view(&u.host), 1, String::len(&u.host) - 1)));\n  "
    "  }\n    Vec<SocketAddr> addrs = match (IpAddr::parse(String::as_view(&host)))\n    {\n        Ok(ip) :"
    "\n        {\n            Vec<SocketAddr> one = Vec::new();\n            Vec::push(&mut one, SocketAddr:"
    ":new(ip, u.port));\n            one\n        },\n        Err(_) : match (resolve(String::as_view(&host)"
    ", u.port))\n        {\n            Ok(a)  : a,\n            Err(e) : return Err(HttpNetFailure(e)),\n   "
    "     },\n    };\n    if (Vec::len(&addrs) == 0)\n    {\n        return Err(HttpNetFailure(UnknownHost));"
    "\n    }\n    NetError last = Failed;\n    for (usize i = 0; i < Vec::len(&addrs); i += 1)\n    {\n       "
    " TcpStream tcp = match (TcpStream::connect_timeout(addrs[i], c.timeout_ms))\n        {\n            Ok"
    "(t)  : t,\n            Err(e) :\n            {\n                last = e;\n                continue;\n   "
    "         },\n        };\n        TcpStream::set_read_timeout_ms(&mut tcp, c.timeout_ms);\n        TcpSt"
    "ream::set_write_timeout_ms(&mut tcp, c.timeout_ms);\n        TcpStream::set_nodelay(&mut tcp, true);\n"
    "        if (!secure)\n        {\n            return Ok(Plain(tcp));\n        }\n        ref<TrustStore, "
    "shared> roots = match (&c.roots)\n        {\n            Some(r) : r,\n            None    : return Err"
    "(NoRoots),\n        };\n        return match (TlsStream::client(tcp, String::as_view(&host), roots))\n "
    "       {\n            Ok(s)  : Ok(Secure(s)),\n            Err(e) : Err(HttpTlsFailure(e)),\n        };"
    "\n    }\n    Err(HttpNetFailure(last))\n}fn is_credential(StringView name) : bool\n{\n    name_eq(name, \""
    "authorization\") || name_eq(name, \"proxy-authorization\") || name_eq(name, \"cookie\")\n}fn request_bytes"
    "(\n    ref<HttpClient, shared> c,\n    ref<Request, shared> req,\n    ref<Url, shared> u,\n    StringVie"
    "w method,\n    slice<u8, shared> body,\n    bool with_content,\n    bool credentials,\n) : Vec<u8>\n{\n   "
    " String head = String::from_view(method);\n    String::append(&mut head, \" \");\n    String::append(&mu"
    "t head, String::as_view(&Url::target(u)));\n    String::append(&mut head, \" HTTP/1.1\\r\\nHost: \");\n   "
    " String::append(&mut head, String::as_view(&host_text(u)));\n    String::append(&mut head, \"\\r\\n\");\n "
    "   foreach (h in &c.headers)\n    {\n        StringView name = String::as_view(&h.name);\n        bool "
    "kept = credentials || !is_credential(name);\n        if (kept && !has_header(&req.headers[0..$], name"
    "))\n        {\n            String::append(&mut head, String::as_view(&h.name));\n            String::ap"
    "pend(&mut head, \": \");\n            String::append(&mut head, String::as_view(&h.value));\n           "
    " String::append(&mut head, \"\\r\\n\");\n        }\n    }\n    foreach (h in &req.headers)\n    {\n        if"
    " (name_eq(\n            String::as_view(&h.name),\n            \"host\",\n        ) || name_eq(String::as"
    "_view(&h.name), \"content-length\") || name_eq(String::as_view(&h.name), \"connection\"))\n        {\n    "
    "        continue;\n        }\n        // After a redirect to another origin, no credentials go there.\n"
    "        if (!credentials && is_credential(String::as_view(&h.name)))\n        {\n            continue;"
    "\n        }\n        // After a redirect that dropped the body, its Content-Type goes too.\n        if "
    "(!with_content && name_eq(String::as_view(&h.name), \"content-type\"))\n        {\n            continue;"
    "\n        }\n        String::append(&mut head, String::as_view(&h.name));\n        String::append(&mut "
    "head, \": \");\n        String::append(&mut head, String::as_view(&h.value));\n        String::append(&m"
    "ut head, \"\\r\\n\");\n    }\n    if (slice_len(body) > 0 || method_has_body(method))\n    {\n        String"
    "::append(&mut head, \"Content-Length: \");\n        String::append(&mut head, slice_len(body));\n       "
    " String::append(&mut head, \"\\r\\n\");\n    }\n    if (!c.keep_alive)\n    {\n        String::append(&mut h"
    "ead, \"Connection: close\\r\\n\");\n    }\n    String::append(&mut head, \"\\r\\n\");\n    Vec<u8> out = String"
    "::into_bytes(head);\n    Vec::extend_from(&mut out, body);\n    out\n}fn not_content_encoding(ref<Heade"
    "r, shared> h) : bool\n{\n    !name_eq(String::as_view(&h.name), \"content-encoding\") && !name_eq(String"
    "::as_view(&h.name), \"content-length\")\n}fn parse_status_line(StringView line) : Result<StatusLine, Ht"
    "tpError>\n{\n    if (!StringView::starts_with(line, \"HTTP/1.\") || StringView::len(line) < 12)\n    {\n  "
    "      return Err(BadMessage);\n    }\n    // The version, the space, the three digits and the space ar"
    "e ASCII\n    // (RFC 9112 §4): a byte of 128 or more among them is a malformed line,\n    // not a pl"
    "ace to cut a character in two (found by the hostile-input\n    // round, D-0211).\n    for (usize i = "
    "0; i < 13 && i < StringView::len(line); i += 1)\n    {\n        if (line.bytes[i] >= 128)\n        {\n  "
    "          return Err(BadMessage);\n        }\n    }\n    u16 status = match (StringView::parse<u16>(Str"
    "ingView::sub(line, 9, 12)))\n    {\n        Ok(v)  : v,\n        Err(_) : return Err(BadMessage),\n    }"
    ";\n    if (status < 100 || status > 599)\n    {\n        return Err(BadMessage);\n    }\n    String reaso"
    "n = if (StringView::len(line) > 13)\n    {\n        String::from_view(StringView::sub(\n            lin"
    "e,\n            13,\n            StringView::len(line),\n        ))\n    }\n    else { String::new() };\n "
    "   Ok(StatusLine { .status = status, .reason = reason })\n}fn origin_of(ref<Url, shared> u) : String\n"
    "{\n    String o = String::clone(&u.scheme);\n    String::append(&mut o, \"://\");\n    String::append(&mu"
    "t o, String::as_view(&host_text(u)));\n    o\n}fn idempotent(StringView method) : bool\n{\n    method =="
    " \"GET\" || method == \"HEAD\" || method == \"PUT\" || method == \"DELETE\" || method == \"OPTIONS\" || method"
    " == \"TRACE\"\n}fn exchange(\n    ref<HttpClient, exclusive> c,\n    ref<Request, shared> req,\n    ref<Ur"
    "l, shared> u,\n    StringView method,\n    slice<u8, shared> body,\n    bool with_content,\n    bool cre"
    "dentials,\n) : Result<Response, HttpError>\n{\n    String want = origin_of(u);\n    if (Some(ic) = repla"
    "ce(&mut c.idle, None))\n    {\n        IdleConn { origin, r } = ic;\n        if (origin == want)\n      "
    "  {\n            if (Some(resp) = exchange_on(c, r, true, req, u, method, body, with_content, credent"
    "ials)?)\n            {\n                return Ok(resp);\n            }\n            // Closed with noth"
    "ing answered: the server may still have\n            // acted on the request, so only an idempotent o"
    "ne is sent\n            // again (RFC 9110 §9.2.2) -- a POST twice could do twice what\n            /"
    "/ it asks.\n            if (!idempotent(method))\n            {\n                return Err(ConnectionC"
    "losed);\n            }\n        }\n        else\n        {\n            conn_close(&mut r.conn);\n        "
    "}\n    }\n    Reader fresh = Reader { .conn = open_connection(c, u)?, .buf = Vec::new(), .at = 0 };\n  "
    "  match (exchange_on(c, fresh, false, req, u, method, body, with_content, credentials)?)\n    {\n     "
    "   Some(resp) : Ok(resp),\n        None       : Err(ConnectionClosed),\n    }\n}fn exchange_on(\n    ref"
    "<HttpClient, exclusive> c,\n    Reader r,\n    bool reused,\n    ref<Request, shared> req,\n    ref<Url,"
    " shared> u,\n    StringView method,\n    slice<u8, shared> body,\n    bool with_content,\n    bool crede"
    "ntials,\n) : Result<Option<Response>, HttpError>\n{\n    match (conn_write(&mut r.conn, &request_bytes("
    "c, req, u, method, body, with_content, credentials)[0..$]))\n    {\n        Ok(_)  : {},\n        Err(e"
    ") :\n        {\n            if (reused)\n            {\n                return Ok(None);\n            }\n "
    "           return Err(e);\n        },\n    }\n    bool first = true;\n    // Interim 1xx responses (a 10"
    "0 Continue) are read past.\n    while (true)\n    {\n        String line = match (http_line(&mut r, MAX"
    "_HEAD))\n        {\n            Ok(Some(l)) : l,\n            Ok(None)    :\n            {\n             "
    "   if (reused && first)\n                {\n                    return Ok(None);\n                }\n   "
    "             return Err(ConnectionClosed);\n            },\n            Err(e)      :\n            {\n  "
    "              if (reused && first && Vec::len(&r.buf) == 0)\n                {\n                    re"
    "turn Ok(None);\n                }\n                return Err(e);\n            },\n        };\n        fi"
    "rst = false;\n        bool http11 = StringView::starts_with(String::as_view(&line), \"HTTP/1.1\");\n    "
    "    StatusLine { status, reason } = parse_status_line(String::as_view(&line))?;\n        Vec<Header> "
    "headers = read_headers(&mut r, String::len(&line) + 2)?;\n        if (status >= 100 && status < 200)\n"
    "        {\n            continue;\n        }\n        bool no_body = StringView::eq(method, \"HEAD\") || s"
    "tatus == 204 || status == 304;\n        BodyLength how = if (no_body) { NoBody } else { body_length(&"
    "headers[0..$], true)? };\n        bool until_close = match (how)\n        {\n            UntilClose : t"
    "rue,\n            _          : false,\n        };\n        Vec<u8> data = read_body(&mut r, how, c.max_"
    "body)?;\n        // Kept when asked for, allowed (HTTP/1.1, no `Connection: close`),\n        // the b"
    "ody's end known without the connection's, and nothing more\n        // read than the response.\n      "
    "  bool keep = c.keep_alive && http11 && !until_close && r.at == Vec::len(&r.buf);\n        if (Some(v"
    ") = find_header(&headers[0..$], \"connection\"))\n        {\n            if (name_eq(StringView::trim(v)"
    ", \"close\"))\n            {\n                keep = false;\n            }\n        }\n        if (keep)\n  "
    "      {\n            c.idle = Some(IdleConn { .origin = String::clone(&origin_of(u)), .r = r });\n    "
    "    }\n        else\n        {\n            conn_close(&mut r.conn);\n        }\n        // D-0183: a bod"
    "y sent compressed (`Content-Encoding: gzip` or\n        // `deflate`, which the client offers) arrive"
    "s decoded, within\n        // `max_body`, and the header is dropped so the response reads as\n        "
    "// a plain one.\n        bool strip = false;\n        if (!no_body)\n        {\n            if (Some(enc"
    ") = find_header(&headers[0..$], \"content-encoding\"))\n            {\n                StringView e = St"
    "ringView::trim(enc);\n                Option<Result<Vec<u8>, CompressError>> decoded = if (name_eq(e,"
    " \"gzip\") || name_eq(e, \"x-gzip\"))\n                {\n                    Some(gunzip(&data[0..$], c.m"
    "ax_body))\n                }\n                else if (name_eq(e, \"deflate\"))\n                {\n      "
    "              Some(match (zlib_inflate(&data[0..$], c.max_body))\n                    {\n             "
    "           Ok(v)  : Ok(v),\n                        Err(_) : inflate(&data[0..$], c.max_body),\n      "
    "              })\n                }\n                else { None };\n                if (Some(d) = deco"
    "ded)\n                {\n                    overwrite(&mut data, match (d)\n                    {\n    "
    "                    Ok(v)         : v,\n                        Err(Oversize) : return Err(TooLarge),"
    "\n                        Err(_)        : return Err(BadMessage),\n                    });\n           "
    "         strip = true;\n                }\n            }\n        }\n        if (strip)\n        {\n      "
    "      Vec::retain(&mut headers, not_content_encoding);\n        }\n        return Ok(Some(Response { ."
    "status = status, .reason = reason, .headers = headers, .body = data }));\n    }\n}fn redirect_target(r"
    "ef<Url, shared> base, StringView location) : Result<Url, HttpError>\n{\n    if (Option::is_some(&Strin"
    "gView::find(location, \"://\")))\n    {\n        return Url::parse(location);\n    }\n    String text = St"
    "ring::clone(&base.scheme);\n    String::append(&mut text, \"://\");\n    String::append(&mut text, Strin"
    "g::as_view(&host_text(base)));\n    if (StringView::starts_with(location, \"/\"))\n    {\n        String:"
    ":append(&mut text, location);\n    }\n    else\n    {\n        StringView path = String::as_view(&base.p"
    "ath);\n        usize dir = 0;\n        slice<u8, shared> pb = StringView::as_bytes(path);\n        for "
    "(usize i = 0; i < slice_len(pb); i += 1)\n        {\n            if (pb[i] == b'/')\n            {\n    "
    "            dir = i + 1;\n            }\n        }\n        String::append(&mut text, StringView::sub(p"
    "ath, 0, dir));\n        String::append(&mut text, location);\n    }\n    Url::parse(String::as_view(&te"
    "xt))\n}export fn HttpClient::send(ref<HttpClient, exclusive> c, ref<Request, shared> req) : Result<Re"
    "sponse, HttpError>\n{\n    Url u = Url::parse(String::as_view(&req.url))?;\n    String method = String:"
    ":clone(&req.method);\n    Vec<u8> body = Vec::clone(&req.body);\n    usize hops = 0;\n    bool with_con"
    "tent = true;\n    String first_origin = origin_of(&u);\n    bool credentials = true;\n    while (true)\n"
    "    {\n        Response resp = exchange(c, req, &u, String::as_view(&method), &body[0..$], with_conte"
    "nt, credentials)?;\n        bool redirect = resp.status == 301 || resp.status == 302 || resp.status ="
    "= 303 || resp.status == 307 || resp.status == 308;\n        if (!redirect)\n        {\n            retu"
    "rn Ok(resp);\n        }\n        StringView location = match (Response::header(&resp, \"location\"))\n   "
    "     {\n            Some(l) : l,\n            None    : return Ok(resp),\n        };\n        if (hops ="
    "= c.max_redirects)\n        {\n            return Err(TooManyRedirects);\n        }\n        hops += 1;\n"
    "        Url next = redirect_target(&u, location)?;\n        overwrite(&mut u, next);\n        // Once "
    "a redirect leaves the first origin, credentials stay behind,\n        // even if a later one comes ba"
    "ck.\n        if (origin_of(&u) != first_origin)\n        {\n            credentials = false;\n        }\n"
    "        if (resp.status != 307 && resp.status != 308 && !StringView::eq(String::as_view(&method), \"H"
    "EAD\"))\n        {\n            overwrite(&mut method, String::from_str(\"GET\"));\n            Vec::clear"
    "(&mut body);\n            with_content = false;\n        }\n    }\n}export fn http_get(StringView url) :"
    " Result<Response, HttpError>\n{\n    HttpClient c = HttpClient::new();\n    Request req = Request::new("
    "\"GET\", url);\n    HttpClient::send(&mut c, &req)\n}export fn http_post(StringView url, StringView cont"
    "ent_type, slice<u8, shared> body) : Result<Response, HttpError>\n{\n    HttpClient c = HttpClient::new"
    "();\n    Request req = Request::new(\"POST\", url);\n    Vec::push(&mut req.headers, Header::new(\"Conten"
    "t-Type\", content_type));\n    Vec::extend_from(&mut req.body, body);\n    HttpClient::send(&mut c, &re"
    "q)\n}export fn HttpServer::bind(SocketAddr a) : Result<HttpServer, NetError>\n{\n    TcpListener l = Tc"
    "pListener::bind(a)?;\n    Ok(HttpServer { .listener = l, .max_body = 16777216, .timeout_ms = 30000, ."
    "key = None, .chain = Vec::new() })\n}export fn HttpServer::bind_tls(SocketAddr a, PrivateKey key, Vec"
    "<Certificate> chain) : Result<HttpServer, NetError>\n{\n    TcpListener l = TcpListener::bind(a)?;\n   "
    " Ok(HttpServer { .listener = l, .max_body = 16777216, .timeout_ms = 30000, .key = Some(key), .chain "
    "= chain })\n}export fn HttpServer::local_addr(ref<HttpServer, shared> s) : SocketAddr\n{\n    TcpListen"
    "er::local_addr(&s.listener)\n}export fn HttpServer::accept(ref<HttpServer, exclusive> s) : Result<Htt"
    "pConnection, HttpError>\n{\n    TcpStream tcp = match (TcpListener::accept(&mut s.listener))\n    {\n   "
    "     Ok(t)  : t,\n        Err(e) : return Err(HttpNetFailure(e)),\n    };\n    TcpStream::set_read_time"
    "out_ms(&mut tcp, s.timeout_ms);\n    TcpStream::set_write_timeout_ms(&mut tcp, s.timeout_ms);\n    Tcp"
    "Stream::set_nodelay(&mut tcp, true);\n    Conn conn = match (&s.key)\n    {\n        Some(k) : match (T"
    "lsStream::server(tcp, k, &s.chain[0..$]))\n        {\n            Ok(t)  : Secure(t),\n            Err("
    "e) : return Err(HttpTlsFailure(e)),\n        },\n        None : Plain(tcp),\n    };\n    Ok(HttpConnecti"
    "on { .reader = Reader { .conn = conn, .buf = Vec::new(), .at = 0 }, .max_body = s.max_body, .keep_al"
    "ive = true, .head_request = false, .closed = false })\n}export fn HttpConnection::peer_addr(ref<HttpC"
    "onnection, shared> c) : SocketAddr\n{\n    match (&c.reader.conn)\n    {\n        Plain(s)  : TcpStream:"
    ":peer_addr(s),\n        Secure(s) : TlsStream::peer_addr(s),\n    }\n}export fn HttpConnection::request"
    "(ref<HttpConnection, exclusive> c) : Result<Option<Request>, HttpError>\n{\n    if (c.closed || !c.kee"
    "p_alive)\n    {\n        return Ok(None);\n    }\n    // After an Err the connection closes ([Http-Reque"
    "st]): a request line\n    // over the limit, or not UTF-8, included.\n    String line = match (http_li"
    "ne(&mut c.reader, MAX_HEAD))\n    {\n        Ok(Some(l)) : l,\n        Ok(None)    : return Ok(None),\n "
    "       Err(e)      :\n        {\n            c.keep_alive = false;\n            return Err(e);\n        "
    "},\n    };\n    // A request line: METHOD SP target SP HTTP/1.x.\n    Vec<StringView> parts = StringVie"
    "w::split(String::as_view(&line), \" \");\n    if (Vec::len(&parts) != 3 || StringView::len(parts[0]) =="
    " 0 || StringView::len(parts[1]) == 0)\n    {\n        c.keep_alive = false;\n        return Err(BadMess"
    "age);\n    }\n    bool v11 = StringView::eq(parts[2], \"HTTP/1.1\");\n    if (!v11 && !StringView::eq(par"
    "ts[2], \"HTTP/1.0\"))\n    {\n        c.keep_alive = false;\n        return Err(BadMessage);\n    }\n    Ve"
    "c<Header> headers = match (read_headers(&mut c.reader, String::len(&line) + 2))\n    {\n        Ok(h) "
    " : h,\n        Err(e) :\n        {\n            c.keep_alive = false;\n            return Err(e);\n      "
    "  },\n    };\n    if (v11 && Option::is_none(&find_header(&headers[0..$], \"host\")))\n    {\n        c.ke"
    "ep_alive = false;\n        return Err(BadMessage);\n    }\n    // Keep-alive: HTTP/1.1 unless `Connecti"
    "on: close`, HTTP/1.0 only with\n    // `Connection: keep-alive`.\n    c.keep_alive = match (find_heade"
    "r(&headers[0..$], \"connection\"))\n    {\n        Some(v) : if (v11)\n        {\n            !name_eq(\n  "
    "              StringView::trim(v),\n                \"close\",\n            )\n        }\n        else { n"
    "ame_eq(StringView::trim(v), \"keep-alive\") },\n        None : v11,\n    };\n    c.head_request = StringV"
    "iew::eq(parts[0], \"HEAD\");\n    BodyLength how = match (body_length(&headers[0..$], false))\n    {\n   "
    "     Ok(h)  : h,\n        Err(e) :\n        {\n            c.keep_alive = false;\n            return Err"
    "(e);\n        },\n    };\n    if (Some(expect) = find_header(&headers[0..$], \"expect\"))\n    {\n        i"
    "f (name_eq(StringView::trim(expect), \"100-continue\"))\n        {\n            if (Err(e) = conn_write("
    "&mut c.reader.conn, &b\"HTTP/1.1 100 Continue\\r\\n\\r\\n\"[0..$]))\n            {\n                c.keep_a"
    "live = false;\n                return Err(e);\n            }\n        }\n    }\n    Vec<u8> body = match "
    "(read_body(&mut c.reader, how, c.max_body))\n    {\n        Ok(b)  : b,\n        Err(e) :\n        {\n   "
    "         c.keep_alive = false;\n            return Err(e);\n        },\n    };\n    Ok(Some(Request { .m"
    "ethod = String::from_view(parts[0]), .url = String::from_view(parts[1]), .headers = headers, .body ="
    " body }))\n}export fn HttpConnection::respond(\n    ref<HttpConnection, exclusive> c,\n    u16 status,\n"
    "    slice<Header, shared> headers,\n    slice<u8, shared> body,\n) : Result<void, HttpError>\n{\n    Str"
    "ing head = String::from_str(\"HTTP/1.1 \");\n    String::append(&mut head, status);\n    String::append("
    "&mut head, \" \");\n    String::append(&mut head, reason_phrase(status));\n    String::append(&mut head,"
    " \"\\r\\n\");\n    for (usize i = 0; i < slice_len(headers); i += 1)\n    {\n        if (name_eq(\n         "
    "   String::as_view(&headers[i].name),\n            \"content-length\",\n        ) || name_eq(String::as_"
    "view(&headers[i].name), \"connection\"))\n        {\n            continue;\n        }\n        String::app"
    "end(&mut head, String::as_view(&headers[i].name));\n        String::append(&mut head, \": \");\n        "
    "String::append(&mut head, String::as_view(&headers[i].value));\n        String::append(&mut head, \"\\r"
    "\\n\");\n    }\n    bool no_body = status == 204 || status == 304 || (status >= 100 && status < 200);\n  "
    "  if (!no_body)\n    {\n        String::append(&mut head, \"Content-Length: \");\n        String::append("
    "&mut head, slice_len(body));\n        String::append(&mut head, \"\\r\\n\");\n    }\n    String::append(\n  "
    "      &mut head,\n        if (c.keep_alive) { \"Connection: keep-alive\\r\\n\\r\\n\" } else { \"Connection: "
    "close\\r\\n\\r\\n\" },\n    );\n    Vec<u8> out = String::into_bytes(head);\n    if (!no_body && !c.head_req"
    "uest)\n    {\n        Vec::extend_from(&mut out, body);\n    }\n    conn_write(&mut c.reader.conn, &out["
    "0..$])?;\n    if (!c.keep_alive)\n    {\n        conn_close(&mut c.reader.conn);\n        c.closed = tru"
    "e;\n    }\n    Ok(())\n}export fn HttpConnection::close(ref<HttpConnection, exclusive> c)\n{\n    if (!c."
    "closed)\n    {\n        conn_close(&mut c.reader.conn);\n        c.closed = true;\n    }\n}export fn scra"
    "m_salted_password(StringView password, slice<u8, shared> salt, usize iterations) : Vec<u8>\n{\n    pbk"
    "df2(Sha2_256, StringView::as_bytes(password), salt, iterations, 32)\n}export fn Scram::start(StringVi"
    "ew user, StringView client_nonce) : Scram\n{\n    String bare = String::from_str(\"n=\");\n    foreach (c"
    " in StringView::as_bytes(user))\n    {\n        if (*c == b',')\n        {\n            String::append(&"
    "mut bare, \"=2C\");\n        }\n        else if (*c == b'=')\n        {\n            String::append(&mut b"
    "are, \"=3D\");\n        }\n        else\n        {\n            String::push_ascii(&mut bare, *c);\n       "
    " }\n    }\n    String::append(&mut bare, \",r=\");\n    String::append(&mut bare, client_nonce);\n    Scra"
    "m { .client_nonce = String::from_view(client_nonce), .client_first_bare = bare, .server_signature = "
    "Vec::new() }\n}export fn Scram::client_first(ref<Scram, shared> s) : String\n{\n    String m = String::"
    "from_str(\"n,,\");\n    String::append(&mut m, String::as_view(&s.client_first_bare));\n    m\n}fn attrib"
    "ute(slice<StringView, shared> parts, str name) : Option<StringView>\n{\n    foreach (p in parts)\n    {"
    "\n        if (StringView::starts_with(*p, StringView::of(name)))\n        {\n            return Some(St"
    "ringView::sub(*p, 2, StringView::len(*p)));\n        }\n    }\n    None\n}export fn Scram::respond(\n    "
    "ref<Scram, exclusive> s,\n    StringView server_first,\n    StringView password,\n) : Result<String, Pg"
    "Error>\n{\n    Vec<StringView> parts = StringView::split(server_first, \",\");\n    if (Option::is_some(&"
    "attribute(&parts[0..$], \"m=\")))\n    {\n        return Err(ProtocolViolation);\n    }\n    StringView no"
    "nce = Option::ok_or(attribute(&parts[0..$], \"r=\"), ProtocolViolation)?;\n    StringView salt_text = O"
    "ption::ok_or(attribute(&parts[0..$], \"s=\"), ProtocolViolation)?;\n    StringView iter_text = Option::"
    "ok_or(attribute(&parts[0..$], \"i=\"), ProtocolViolation)?;\n    if (!StringView::starts_with(\n        "
    "nonce,\n        String::as_view(&s.client_nonce),\n    ) || StringView::len(nonce) <= String::len(&s.c"
    "lient_nonce))\n    {\n        return Err(AuthFailed);\n    }\n    Vec<u8> salt = match (base64_decode(sa"
    "lt_text))\n    {\n        Ok(v)  : v,\n        Err(_) : return Err(ProtocolViolation),\n    };\n    usize"
    " iterations = match (StringView::parse<usize>(iter_text))\n    {\n        Ok(n)  : n,\n        Err(_) :"
    " return Err(ProtocolViolation),\n    };\n    if (iterations == 0)\n    {\n        return Err(ProtocolVio"
    "lation);\n    }\n    Vec<u8> salted = scram_salted_password(password, &salt[0..$], iterations);\n    ar"
    "ray<u8, 32> client_key = hmac_sha256(&salted[0..$], &b\"Client Key\"[0..$]);\n    array<u8, 32> stored_"
    "key = sha256(&client_key[0..$]);\n    String without_proof = String::from_str(\"c=biws,r=\");\n    Strin"
    "g::append(&mut without_proof, nonce);\n    String auth = String::clone(&s.client_first_bare);\n    Str"
    "ing::append(&mut auth, \",\");\n    String::append(&mut auth, server_first);\n    String::append(&mut au"
    "th, \",\");\n    String::append(&mut auth, String::as_view(&without_proof));\n    array<u8, 32> client_s"
    "ignature = hmac_sha256(&stored_key[0..$], StringView::as_bytes(String::as_view(&auth)));\n    Vec<u8>"
    " proof = Vec::new();\n    for (usize i = 0; i < 32; i += 1)\n    {\n        Vec::push(&mut proof, clien"
    "t_key[i] ^ client_signature[i]);\n    }\n    array<u8, 32> server_key = hmac_sha256(&salted[0..$], &b\""
    "Server Key\"[0..$]);\n    array<u8, 32> server_signature = hmac_sha256(&server_key[0..$], StringView::"
    "as_bytes(String::as_view(&auth)));\n    overwrite(&mut s.server_signature, Vec::from_slice(&server_si"
    "gnature[0..$]));\n    String::append(&mut without_proof, \",p=\");\n    String::append(&mut without_proo"
    "f, String::as_view(&base64_encode(&proof[0..$])));\n    Ok(without_proof)\n}export fn Scram::verify(re"
    "f<Scram, shared> s, StringView server_final) : bool\n{\n    if (Vec::len(&s.server_signature) == 0 || "
    "!StringView::starts_with(server_final, \"v=\"))\n    {\n        return false;\n    }\n    match (base64_de"
    "code(StringView::sub(server_final, 2, StringView::len(server_final))))\n    {\n        Ok(v)  : digest"
    "_eq(&v[0..$], &s.server_signature[0..$]),\n        Err(_) : false,\n    }\n}export fn PgError::text(ref"
    "<PgError, shared> e) : String\n{\n    match (e)\n    {\n        PgNetFailure(n)   : String::from_str(Net"
    "Error::text(n)),\n        PgTlsFailure(t)   : String::from_str(TlsError::text(t)),\n        TlsRefused"
    "        : String::from_str(\"the server does not accept TLS\"),\n        NoTrustedRoots    : String::fr"
    "om_str(\"no trusted roots for TLS (TrustStore::system failed)\"),\n        BadConnectionUrl  : String::"
    "from_str(\"the connection URL is malformed\"),\n        UnsupportedAuth   : String::from_str(\"the serve"
    "r asks for an authentication method that is not supported\"),\n        AuthRefused       : String::fro"
    "m_str(\"the server asks for the password in clear over an unencrypted connection\"),\n        AuthFaile"
    "d        : String::from_str(\"authentication failed\"),\n        Server(s)         :\n        {\n        "
    "    String t = String::clone(&s.severity);\n            String::append(&mut t, \": \");\n            Str"
    "ing::append(&mut t, String::as_view(&s.message));\n            String::append(&mut t, \" (\");\n        "
    "    String::append(&mut t, String::as_view(&s.code));\n            String::append(&mut t, \")\");\n     "
    "       t\n        },\n        ProtocolViolation : String::from_str(\"the server's message is malformed\""
    "),\n        ResultTooLarge    : String::from_str(\"the result is larger than the limit\"),\n        Disc"
    "onnected      : String::from_str(\"the connection is closed\"),\n    }\n}fn decoded(StringView v) : Resu"
    "lt<String, PgError>\n{\n    Vec<u8> bytes = match (percent_decode(v))\n    {\n        Some(b) : b,\n     "
    "   None    : return Err(BadConnectionUrl),\n    };\n    match (String::from_utf8(bytes))\n    {\n       "
    " Ok(s)  : Ok(s),\n        Err(_) : Err(BadConnectionUrl),\n    }\n}export fn PgUrl::parse(StringView te"
    "xt) : Result<PgUrl, PgError>\n{\n    usize sep = match (StringView::find(text, \"://\"))\n    {\n        S"
    "ome(i) : i,\n        None    : return Err(BadConnectionUrl),\n    };\n    StringView scheme = StringVie"
    "w::sub(text, 0, sep);\n    if (!StringView::eq(scheme, \"postgres\") && !StringView::eq(scheme, \"postgr"
    "esql\"))\n    {\n        return Err(BadConnectionUrl);\n    }\n    StringView rest = StringView::sub(text"
    ", sep + 3, StringView::len(text));\n    usize n = StringView::len(rest);\n    slice<u8, shared> b = St"
    "ringView::as_bytes(rest);\n    usize auth_end = 0;\n    while (auth_end < n && b[auth_end] != b'/' && "
    "b[auth_end] != b'?')\n    {\n        auth_end += 1;\n    }\n    // The user information ends at the last"
    " '@' of the authority.\n    usize at_sign = auth_end;\n    for (usize i = 0; i < auth_end; i += 1)\n   "
    " {\n        if (b[i] == b'@')\n        {\n            at_sign = i;\n        }\n    }\n    if (at_sign == a"
    "uth_end || at_sign == 0)\n    {\n        return Err(BadConnectionUrl);\n    }\n    StringView userinfo ="
    " StringView::sub(rest, 0, at_sign);\n    String user = String::new();\n    Option<String> password = N"
    "one;\n    match (StringView::find(userinfo, \":\"))\n    {\n        Some(colon) :\n        {\n            o"
    "verwrite(&mut user, decoded(StringView::sub(userinfo, 0, colon))?);\n            overwrite(&mut passw"
    "ord, Some(decoded(StringView::sub(userinfo, colon + 1, StringView::len(userinfo)))?));\n        },\n  "
    "      None        : overwrite(&mut user, decoded(userinfo)?),\n    }\n    if (String::len(&user) == 0)"
    "\n    {\n        return Err(BadConnectionUrl);\n    }\n    StringView hostport = StringView::sub(rest, a"
    "t_sign + 1, auth_end);\n    usize hp = StringView::len(hostport);\n    slice<u8, shared> hb = StringVi"
    "ew::as_bytes(hostport);\n    if (hp == 0)\n    {\n        return Err(BadConnectionUrl);\n    }\n    Strin"
    "g host = String::new();\n    usize host_end = 0;\n    if (hb[0] == b'[')\n    {\n        usize close = m"
    "atch (StringView::find(hostport, \"]\"))\n        {\n            Some(i) : i,\n            None    : retu"
    "rn Err(BadConnectionUrl),\n        };\n        String::append(&mut host, StringView::sub(hostport, 1, "
    "close));\n        host_end = close + 1;\n    }\n    else\n    {\n        while (host_end < hp && hb[host_"
    "end] != b':')\n        {\n            host_end += 1;\n        }\n        String::append(&mut host, Strin"
    "gView::sub(hostport, 0, host_end));\n    }\n    if (String::len(&host) == 0)\n    {\n        return Err("
    "BadConnectionUrl);\n    }\n    u16 port = 5432;\n    if (host_end < hp)\n    {\n        if (hb[host_end] "
    "!= b':')\n        {\n            return Err(BadConnectionUrl);\n        }\n        port = match (StringV"
    "iew::parse<u16>(StringView::sub(hostport, host_end + 1, hp)))\n        {\n            Ok(p)  : p,\n    "
    "        Err(_) : return Err(BadConnectionUrl),\n        };\n    }\n    // The database: the path withou"
    "t its '/', the user when none.\n    usize path_end = auth_end;\n    while (path_end < n && b[path_end]"
    " != b'?')\n    {\n        path_end += 1;\n    }\n    String database = String::new();\n    if (path_end >"
    " auth_end + 1)\n    {\n        overwrite(&mut database, decoded(StringView::sub(rest, auth_end + 1, pa"
    "th_end))?);\n    }\n    if (String::len(&database) == 0)\n    {\n        overwrite(&mut database, String"
    "::clone(&user));\n    }\n    PgSslMode sslmode = VerifyFull;\n    if (path_end < n)\n    {\n        Strin"
    "gView query = StringView::sub(rest, path_end + 1, n);\n        if (StringView::len(query) > 0)\n      "
    "  {\n            Vec<StringView> pairs = StringView::split(query, \"&\");\n            foreach (pair in "
    "&pairs)\n            {\n                if (StringView::starts_with(*pair, \"sslmode=\"))\n              "
    "  {\n                    StringView mode = StringView::sub(*pair, 8, StringView::len(*pair));\n       "
    "             if (StringView::eq(mode, \"disable\"))\n                    {\n                        sslm"
    "ode = Disable;\n                    }\n                    else if (StringView::eq(mode, \"verify-full\""
    "))\n                    {\n                        sslmode = VerifyFull;\n                    }\n       "
    "             else\n                    {\n                        return Err(BadConnectionUrl);\n      "
    "              }\n                }\n                else\n                {\n                    return "
    "Err(BadConnectionUrl);\n                }\n            }\n        }\n    }\n    Ok(PgUrl { .user = user, "
    ".password = password, .host = host, .port = port, .database = database, .sslmode = sslmode })\n}fn fl"
    "oat_text(f64 x) : String\n{\n    if (x != x)\n    {\n        return String::from_str(\"NaN\");\n    }\n    i"
    "f (x > 1.7976931348623157e308)\n    {\n        return String::from_str(\"Infinity\");\n    }\n    if (x < "
    "-1.7976931348623157e308)\n    {\n        return String::from_str(\"-Infinity\");\n    }\n    String t = St"
    "ring::new();\n    String::append(&mut t, x);\n    t\n}export fn PgValue::text(ref<PgValue, shared> valu"
    "e) : Option<String>\n{\n    match (value)\n    {\n        Null     : None,\n        Text(s)  : Some(Strin"
    "g::clone(s)),\n        Int(i)   :\n        {\n            String t = String::new();\n            String:"
    ":append(&mut t, *i);\n            Some(t)\n        },\n        Float(f) : Some(float_text(*f)),\n       "
    " Bool(b)  : Some(String::from_str(if (*b) { \"t\" } else { \"f\" })),\n        Bytes(v) :\n        {\n     "
    "       String t = String::from_str(\"\\\\x\");\n            String::append(&mut t, String::as_view(&to_he"
    "x(&v[0..$])));\n            Some(t)\n        },\n    }\n}export fn PgRow::get(ref<PgRow, shared> r, usiz"
    "e i) : Option<StringView>\n{\n    if (i >= Vec::len(&r.cells))\n    {\n        return None;\n    }\n    ma"
    "tch (&r.cells[i])\n    {\n        Some(s) : Some(String::as_view(s)),\n        None    : None,\n    }\n}e"
    "xport fn PgRow::get_i64(ref<PgRow, shared> r, usize i) : Option<i64>\n{\n    match (PgRow::get(r, i))\n"
    "    {\n        Some(t) : match (StringView::parse<i64>(t))\n        {\n            Ok(v)  : Some(v),\n  "
    "          Err(_) : None,\n        },\n        None : None,\n    }\n}export fn PgRow::get_f64(ref<PgRow, "
    "shared> r, usize i) : Option<f64>\n{\n    match (PgRow::get(r, i))\n    {\n        Some(t) :\n        {\n "
    "           if (StringView::eq(t, \"NaN\"))\n            {\n                return Some(0.0 / 0.0);\n     "
    "       }\n            if (StringView::eq(t, \"Infinity\"))\n            {\n                return Some(1."
    "0 / 0.0);\n            }\n            if (StringView::eq(t, \"-Infinity\"))\n            {\n              "
    "  return Some(-1.0 / 0.0);\n            }\n            match (StringView::parse<f64>(t))\n            {"
    "\n                Ok(v)  : Some(v),\n                Err(_) : None,\n            }\n        },\n        N"
    "one    : None,\n    }\n}export fn PgRow::get_bool(ref<PgRow, shared> r, usize i) : Option<bool>\n{\n    "
    "match (PgRow::get(r, i))\n    {\n        Some(t) :\n        {\n            if (StringView::eq(t, \"t\"))\n "
    "           {\n                return Some(true);\n            }\n            if (StringView::eq(t, \"f\")"
    ")\n            {\n                return Some(false);\n            }\n            None\n        },\n      "
    "  None    : None,\n    }\n}export fn PgRow::get_bytes(ref<PgRow, shared> r, usize i) : Option<Vec<u8>>"
    "\n{\n    match (PgRow::get(r, i))\n    {\n        Some(t) : match (StringView::strip_prefix(t, \"\\\\x\"))\n "
    "       {\n            // `\\x` alone is the empty bytea, which from_hex refuses.\n            Some(hex)"
    " : if (StringView::len(hex) == 0)\n            {\n                Some(Vec::new())\n            }\n     "
    "       else\n            {\n                match (from_hex(hex))\n                {\n                  "
    "  Ok(v)  : Some(v),\n                    Err(_) : None,\n                }\n            },\n            "
    "None : None,\n        },\n        None : None,\n    }\n}export fn PgResult::column(ref<PgResult, shared>"
    " res, StringView name) : Option<usize>\n{\n    for (usize i = 0; i < Vec::len(&res.columns); i += 1)\n "
    "   {\n        if (String::eq_view(&res.columns[i].name, name))\n        {\n            return Some(i);\n"
    "        }\n    }\n    None\n}fn tag_count(StringView tag) : u64\n{\n    Vec<StringView> words = StringVie"
    "w::split(tag, \" \");\n    if (Vec::len(&words) < 2)\n    {\n        return 0;\n    }\n    match (StringVie"
    "w::parse<u64>(words[Vec::len(&words) - 1]))\n    {\n        Ok(n)  : n,\n        Err(_) : 0,\n    }\n}fn "
    "pg_read(ref<PgConn, exclusive> c, ref<Vec<u8>, exclusive> buf, usize max) : Result<usize, PgError>\n{"
    "\n    match (c)\n    {\n        Plain(s) : match (TcpStream::read(s, buf, max))\n        {\n            O"
    "k(n)  : Ok(n),\n            Err(e) : Err(PgNetFailure(e)),\n        },\n        Secure(s) : match (TlsS"
    "tream::read(s, buf, max))\n        {\n            Ok(n)  : Ok(n),\n            Err(e) : Err(PgTlsFailur"
    "e(e)),\n        },\n    }\n}fn pg_write(ref<PgConn, exclusive> c, slice<u8, shared> data) : Result<void"
    ", PgError>\n{\n    match (c)\n    {\n        Plain(s) : match (TcpStream::write(s, data))\n        {\n    "
    "        Ok(_)  : Ok(()),\n            Err(e) : Err(PgNetFailure(e)),\n        },\n        Secure(s) : m"
    "atch (TlsStream::write(s, data))\n        {\n            Ok(_)  : Ok(()),\n            Err(e) : Err(PgT"
    "lsFailure(e)),\n        },\n    }\n}fn pg_close(ref<PgConn, exclusive> c)\n{\n    match (c)\n    {\n       "
    " Plain(s)  : { _ = TcpStream::shutdown_write(s); },\n        Secure(s) : { _ = TlsStream::close(s); }"
    ",\n    }\n}fn pg_fill(ref<PgReader, exclusive> r) : Result<bool, PgError>\n{\n    if (r.at > 0 && r.at ="
    "= Vec::len(&r.buf))\n    {\n        Vec::clear(&mut r.buf);\n        r.at = 0;\n    }\n    usize n = pg_r"
    "ead(&mut r.conn, &mut r.buf, 16384)?;\n    Ok(n > 0)\n}fn pg_available(ref<PgReader, shared> r) : usiz"
    "e\n{\n    Vec::len(&r.buf) - r.at\n}fn pg_read_n(ref<PgReader, exclusive> r, ref<Vec<u8>, exclusive> ou"
    "t, usize n) : Result<void, PgError>\n{\n    usize need = n;\n    while (need > 0)\n    {\n        if (pg_"
    "available(r) == 0)\n        {\n            if (!pg_fill(r)?)\n            {\n                return Err("
    "Disconnected);\n            }\n        }\n        usize take = min(need, pg_available(r));\n        Vec:"
    ":extend_from(out, &r.buf[r.at..r.at + take]);\n        r.at += take;\n        need -= take;\n    }\n    "
    "Ok(())\n}fn read_message(ref<PgReader, exclusive> r) : Result<Message, PgError>\n{\n    // Most message"
    "s are already whole in the buffer: taken from it at once.\n    usize avail = pg_available(r);\n    if "
    "(avail >= 5)\n    {\n        u8 kind = r.buf[r.at];\n        u32 len = read_be<u32>(&r.buf[0..$], r.at "
    "+ 1);\n        if (len < 4 || widen<usize>(len) - 4 > MAX_MESSAGE)\n        {\n            return Err(P"
    "rotocolViolation);\n        }\n        usize n = widen<usize>(len) - 4;\n        if (avail - 5 >= n)\n  "
    "      {\n            Vec<u8> body = Vec::from_slice(&r.buf[r.at + 5..r.at + 5 + n]);\n            r.at"
    " += 5 + n;\n            return Ok(Message { .kind = kind, .body = body });\n        }\n    }\n    Vec<u8"
    "> head = Vec::new();\n    pg_read_n(r, &mut head, 5)?;\n    u8 kind = head[0];\n    u32 len = read_be<u"
    "32>(&head[0..$], 1);\n    if (len < 4 || widen<usize>(len) - 4 > MAX_MESSAGE)\n    {\n        return Er"
    "r(ProtocolViolation);\n    }\n    Vec<u8> body = Vec::new();\n    pg_read_n(r, &mut body, widen<usize>("
    "len) - 4)?;\n    Ok(Message { .kind = kind, .body = body })\n}fn frame(u8 kind, slice<u8, shared> body"
    ") : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n    Vec::push(&mut out, kind);\n    Vec::push_be(&mut out"
    ", narrow<u32>(slice_len(body) + 4));\n    Vec::extend_from(&mut out, body);\n    out\n}fn push_cstr(ref"
    "<Vec<u8>, exclusive> out, StringView s)\n{\n    Vec::extend_from(out, StringView::as_bytes(s));\n    Ve"
    "c::push(out, 0);\n}fn cstr_at(slice<u8, shared> b, ref<usize, exclusive> at) : Result<String, PgError"
    ">\n{\n    usize end = *at;\n    while (end < slice_len(b) && b[end] != 0)\n    {\n        end += 1;\n    }"
    "\n    if (end == slice_len(b))\n    {\n        return Err(ProtocolViolation);\n    }\n    Vec<u8> bytes ="
    " Vec::from_slice(&b[*at..end]);\n    *at = end + 1;\n    match (String::from_utf8(bytes))\n    {\n      "
    "  Ok(s)  : Ok(s),\n        Err(_) : Err(ProtocolViolation),\n    }\n}fn decode_server_error(slice<u8, s"
    "hared> b) : Result<PgServerError, PgError>\n{\n    PgServerError e = PgServerError { .severity = Strin"
    "g::new(), .code = String::new(), .message = String::new(), .detail = None, .hint = None, .position ="
    " None };\n    usize at = 0;\n    while (at < slice_len(b) && b[at] != 0)\n    {\n        u8 field = b[at"
    "];\n        at += 1;\n        String t = cstr_at(b, &mut at)?;\n        if (field == b'S' || field == b"
    "'V')\n        {\n            overwrite(&mut e.severity, t);\n        }\n        else if (field == b'C')\n"
    "        {\n            overwrite(&mut e.code, t);\n        }\n        else if (field == b'M')\n        {"
    "\n            overwrite(&mut e.message, t);\n        }\n        else if (field == b'D')\n        {\n     "
    "       overwrite(&mut e.detail, Some(t));\n        }\n        else if (field == b'H')\n        {\n      "
    "      overwrite(&mut e.hint, Some(t));\n        }\n        else if (field == b'P')\n        {\n         "
    "   match (String::parse<u32>(&t))\n            {\n                Ok(p)  : overwrite(&mut e.position, "
    "Some(p)),\n                Err(_) : {},\n            }\n        }\n    }\n    Ok(e)\n}fn decode_columns(sl"
    "ice<u8, shared> b) : Result<Vec<PgColumn>, PgError>\n{\n    if (slice_len(b) < 2)\n    {\n        return"
    " Err(ProtocolViolation);\n    }\n    usize n = widen<usize>(read_be<u16>(b, 0));\n    usize at = 2;\n   "
    " Vec<PgColumn> columns = Vec::new();\n    for (usize i = 0; i < n; i += 1)\n    {\n        String name "
    "= cstr_at(b, &mut at)?;\n        if (at + 18 > slice_len(b))\n        {\n            return Err(Protoco"
    "lViolation);\n        }\n        u32 type_oid = read_be<u32>(b, at + 6);\n        at += 18;\n        Vec"
    "::push(&mut columns, PgColumn { .name = name, .type_oid = type_oid });\n    }\n    Ok(columns)\n}fn dec"
    "ode_row(slice<u8, shared> b) : Result<PgRow, PgError>\n{\n    if (slice_len(b) < 2)\n    {\n        retu"
    "rn Err(ProtocolViolation);\n    }\n    usize n = widen<usize>(read_be<u16>(b, 0));\n    usize at = 2;\n "
    "   Vec<Option<String>> cells = Vec::new();\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (at"
    " + 4 > slice_len(b))\n        {\n            return Err(ProtocolViolation);\n        }\n        i32 len "
    "= read_be<i32>(b, at);\n        at += 4;\n        if (len < 0)\n        {\n            Vec::push(&mut ce"
    "lls, None);\n            continue;\n        }\n        usize size = narrow<usize>(len);\n        if (at "
    "+ size > slice_len(b))\n        {\n            return Err(ProtocolViolation);\n        }\n        Vec<u8"
    "> bytes = Vec::from_slice(&b[at..at + size]);\n        at += size;\n        match (String::from_utf8(b"
    "ytes))\n        {\n            Ok(s)  : Vec::push(&mut cells, Some(s)),\n            Err(_) : return Er"
    "r(ProtocolViolation),\n        }\n    }\n    Ok(PgRow { .cells = cells })\n}fn open_tcp(StringView host,"
    " u16 port, u64 timeout_ms) : Result<TcpStream, PgError>\n{\n    Vec<SocketAddr> addrs = match (IpAddr:"
    ":parse(host))\n    {\n        Ok(ip) :\n        {\n            Vec<SocketAddr> one = Vec::new();\n       "
    "     Vec::push(&mut one, SocketAddr::new(ip, port));\n            one\n        },\n        Err(_) : mat"
    "ch (resolve(host, port))\n        {\n            Ok(a)  : a,\n            Err(e) : return Err(PgNetFail"
    "ure(e)),\n        },\n    };\n    if (Vec::len(&addrs) == 0)\n    {\n        return Err(PgNetFailure(Unkn"
    "ownHost));\n    }\n    NetError last = Failed;\n    for (usize i = 0; i < Vec::len(&addrs); i += 1)\n   "
    " {\n        TcpStream tcp = match (TcpStream::connect_timeout(addrs[i], timeout_ms))\n        {\n      "
    "      Ok(t)  : t,\n            Err(e) :\n            {\n                last = e;\n                conti"
    "nue;\n            },\n        };\n        TcpStream::set_read_timeout_ms(&mut tcp, timeout_ms);\n       "
    " TcpStream::set_write_timeout_ms(&mut tcp, timeout_ms);\n        TcpStream::set_nodelay(&mut tcp, tru"
    "e);\n        return Ok(tcp);\n    }\n    Err(PgNetFailure(last))\n}export fn PgConnection::connect(Strin"
    "gView url) : Result<PgConnection, PgError>\n{\n    PgUrl u = PgUrl::parse(url)?;\n    TrustStore roots "
    "= match (u.sslmode)\n    {\n        Disable : TrustStore::new(),\n        VerifyFull : match (TrustStor"
    "e::system())\n        {\n            Ok(t)  : t,\n            Err(_) : return Err(NoTrustedRoots),\n    "
    "    },\n    };\n    connect_url(&u, &roots, 30000)\n}export fn PgConnection::connect_with(\n    StringVi"
    "ew url,\n    ref<TrustStore, shared> roots,\n    u64 timeout_ms,\n) : Result<PgConnection, PgError>\n{\n "
    "   PgUrl u = PgUrl::parse(url)?;\n    connect_url(&u, roots, timeout_ms)\n}fn connect_url(ref<PgUrl, s"
    "hared> u, ref<TrustStore, shared> roots, u64 timeout_ms) : Result<PgConnection, PgError>\n{\n    TcpSt"
    "ream tcp = open_tcp(String::as_view(&u.host), u.port, timeout_ms)?;\n    bool secure = false;\n    PgC"
    "onn conn = match (u.sslmode)\n    {\n        Disable    : Plain(tcp),\n        VerifyFull :\n        {\n "
    "           // SSLRequest: the server answers S (go ahead) or N (no TLS).\n            Vec<u8> req = V"
    "ec::new();\n            Vec::push_be<u32>(&mut req, 8);\n            Vec::push_be<u32>(&mut req, 80877"
    "103);\n            match (TcpStream::write(&mut tcp, &req[0..$]))\n            {\n                Ok(_)"
    "  : {},\n                Err(e) : return Err(PgNetFailure(e)),\n            }\n            Vec<u8> answ"
    "er = Vec::new();\n            match (TcpStream::read_exact(&mut tcp, &mut answer, 1))\n            {\n "
    "               Ok(_)  : {},\n                Err(e) : return Err(PgNetFailure(e)),\n            }\n    "
    "        if (answer[0] == b'N')\n            {\n                return Err(TlsRefused);\n            }\n "
    "           if (answer[0] != b'S')\n            {\n                return Err(ProtocolViolation);\n     "
    "       }\n            secure = true;\n            match (TlsStream::client(tcp, String::as_view(&u.hos"
    "t), roots))\n            {\n                Ok(s)  : Secure(s),\n                Err(e) : return Err(Pg"
    "TlsFailure(e)),\n            }\n        },\n    };\n    PgConnection c = PgConnection { .reader = PgRead"
    "er { .conn = conn, .buf = Vec::new(), .at = 0 }, .secure = secure, .closed = false, .parameters = Ve"
    "c::new(), .backend_pid = 0, .backend_key = 0, .notices = Vec::new(), .max_result = 16777216 };\n    /"
    "/ StartupMessage: protocol 3.0, the user, the database, UTF-8.\n    Vec<u8> body = Vec::new();\n    Ve"
    "c::push_be<u32>(&mut body, 196608);\n    push_cstr(&mut body, \"user\");\n    push_cstr(&mut body, Strin"
    "g::as_view(&u.user));\n    push_cstr(&mut body, \"database\");\n    push_cstr(&mut body, String::as_view"
    "(&u.database));\n    push_cstr(&mut body, \"client_encoding\");\n    push_cstr(&mut body, \"UTF8\");\n    V"
    "ec::push(&mut body, 0);\n    Vec<u8> startup = Vec::new();\n    Vec::push_be(&mut startup, narrow<u32>"
    "(Vec::len(&body) + 4));\n    Vec::extend_from(&mut startup, &body[0..$]);\n    match (pg_write(&mut c."
    "reader.conn, &startup[0..$]))\n    {\n        Ok(_)  : {},\n        Err(e) : return Err(e),\n    }\n    m"
    "atch (authenticate(&mut c, u))\n    {\n        Ok(_)  : Ok(c),\n        Err(e) :\n        {\n            "
    "pg_close(&mut c.reader.conn);\n            Err(e)\n        },\n    }\n}fn authenticate(ref<PgConnection,"
    " exclusive> c, ref<PgUrl, shared> u) : Result<void, PgError>\n{\n    Option<Scram> scram = None;\n    /"
    "/ Once SCRAM has begun, AuthenticationOk counts only after the\n    // server's signature was verifie"
    "d ([Pg-Auth]): a server that skips\n    // its final message has not proved it knows the password.\n  "
    "  bool scram_begun = false;\n    bool scram_verified = false;\n    String password = match (&u.passwor"
    "d)\n    {\n        Some(p) : String::clone(p),\n        None    : String::new(),\n    };\n    while (true"
    ")\n    {\n        Message m = read_message(&mut c.reader)?;\n        slice<u8, shared> b = &m.body[0..$"
    "];\n        if (m.kind == b'R')\n        {\n            if (slice_len(b) < 4)\n            {\n           "
    "     return Err(ProtocolViolation);\n            }\n            u32 code = read_be<u32>(b, 0);\n       "
    "     if (code == 0)\n            {\n                if (scram_begun && !scram_verified)\n              "
    "  {\n                    return Err(AuthFailed);\n                }\n                continue;\n        "
    "    }\n            else if (code == 3)\n            {\n                if (!c.secure)\n                {"
    "\n                    return Err(AuthRefused);\n                }\n                Vec<u8> pw = Vec::ne"
    "w();\n                push_cstr(&mut pw, String::as_view(&password));\n                pg_write(&mut c"
    ".reader.conn, &frame(b'p', &pw[0..$])[0..$])?;\n            }\n            else if (code == 10)\n      "
    "      {\n                bool offered = false;\n                usize at = 4;\n                while (a"
    "t < slice_len(b) && b[at] != 0)\n                {\n                    String mech = cstr_at(b, &mut "
    "at)?;\n                    if (String::eq_str(&mech, \"SCRAM-SHA-256\"))\n                    {\n        "
    "                offered = true;\n                    }\n                }\n                if (!offered"
    ")\n                {\n                    return Err(UnsupportedAuth);\n                }\n             "
    "   array<u8, 18> raw = [0; 18];\n                os_random_bytes(&mut raw[0..$]);\n                Str"
    "ing nonce = base64_encode(&raw[0..$]);\n                Scram s = Scram::start(\"\", String::as_view(&n"
    "once));\n                String first = Scram::client_first(&s);\n                Vec<u8> body = Vec::"
    "new();\n                push_cstr(&mut body, \"SCRAM-SHA-256\");\n                Vec::push_be(&mut body"
    ", narrow<u32>(String::len(&first)));\n                Vec::extend_from(&mut body, StringView::as_byte"
    "s(String::as_view(&first)));\n                pg_write(&mut c.reader.conn, &frame(b'p', &body[0..$])["
    "0..$])?;\n                overwrite(&mut scram, Some(s));\n                scram_begun = true;\n       "
    "     }\n            else if (code == 11)\n            {\n                String server_first = match (S"
    "tring::from_utf8(Vec::from_slice(&b[4..$])))\n                {\n                    Ok(s)  : s,\n     "
    "               Err(_) : return Err(ProtocolViolation),\n                };\n                String cli"
    "ent_final = match (&mut scram)\n                {\n                    Some(s) : Scram::respond(s, Str"
    "ing::as_view(&server_first), String::as_view(&password))?,\n                    None    : return Err("
    "ProtocolViolation),\n                };\n                pg_write(&mut c.reader.conn, &frame(b'p', Str"
    "ingView::as_bytes(String::as_view(&client_final)))[0..$])?;\n            }\n            else if (code "
    "== 12)\n            {\n                String server_final = match (String::from_utf8(Vec::from_slice("
    "&b[4..$])))\n                {\n                    Ok(s)  : s,\n                    Err(_) : return Er"
    "r(ProtocolViolation),\n                };\n                bool ok = match (&scram)\n                {\n"
    "                    Some(s) : Scram::verify(s, String::as_view(&server_final)),\n                    "
    "None    : false,\n                };\n                if (!ok)\n                {\n                    r"
    "eturn Err(AuthFailed);\n                }\n                scram_verified = true;\n            }\n      "
    "      else\n            {\n                return Err(UnsupportedAuth);\n            }\n        }\n      "
    "  else if (m.kind == b'S')\n        {\n            usize at = 0;\n            String name = cstr_at(b, "
    "&mut at)?;\n            String value = cstr_at(b, &mut at)?;\n            Vec::push(&mut c.parameters,"
    " PgParameter { .name = name, .value = value });\n        }\n        else if (m.kind == b'K')\n        {"
    "\n            if (slice_len(b) < 8)\n            {\n                return Err(ProtocolViolation);\n    "
    "        }\n            c.backend_pid = read_be<u32>(b, 0);\n            c.backend_key = read_be<u32>(b"
    ", 4);\n        }\n        else if (m.kind == b'Z')\n        {\n            return Ok(());\n        }\n    "
    "    else if (m.kind == b'E')\n        {\n            PgServerError e = decode_server_error(b)?;\n      "
    "      return Err(if (String::starts_with(&e.code, \"28\")) { AuthFailed } else { Server(e) });\n       "
    " }\n        else if (m.kind == b'N')\n        {\n            Vec::push(&mut c.notices, decode_server_er"
    "ror(b)?);\n        }\n        else\n        {\n            return Err(ProtocolViolation);\n        }\n    "
    "}\n}export fn PgConnection::parameter(ref<PgConnection, shared> c, str name) : Option<StringView>\n{\n "
    "   foreach (p in &c.parameters)\n    {\n        if (String::eq_str(&p.name, name))\n        {\n         "
    "   return Some(String::as_view(&p.value));\n        }\n    }\n    None\n}fn broken(ref<PgConnection, exc"
    "lusive> c, PgError e) : PgError\n{\n    c.closed = true;\n    e\n}fn collect(ref<PgConnection, exclusive"
    "> c, bool keep) : Result<PgResult, PgError>\n{\n    PgResult res = PgResult { .columns = Vec::new(), ."
    "rows = Vec::new(), .affected = 0, .tag = String::new() };\n    Option<PgServerError> failure = None;\n"
    "    bool too_large = false;\n    usize bytes = 0;\n    while (true)\n    {\n        Message m = match (r"
    "ead_message(&mut c.reader))\n        {\n            Ok(msg) : msg,\n            Err(e)  : return Err(br"
    "oken(c, e)),\n        };\n        slice<u8, shared> b = &m.body[0..$];\n        if (m.kind == b'T')\n   "
    "     {\n            match (decode_columns(b))\n            {\n                Ok(cols) : overwrite(&mut"
    " res.columns, cols),\n                Err(e)   : return Err(broken(c, e)),\n            }\n        }\n  "
    "      else if (m.kind == b'D')\n        {\n            if (keep && !too_large)\n            {\n         "
    "       bytes += slice_len(b);\n                if (bytes > c.max_result)\n                {\n          "
    "          too_large = true;\n                    Vec::clear(&mut res.rows);\n                }\n       "
    "         else\n                {\n                    match (decode_row(b))\n                    {\n    "
    "                    Ok(row) : Vec::push(&mut res.rows, row),\n                        Err(e)  : retur"
    "n Err(broken(c, e)),\n                    }\n                }\n            }\n        }\n        else if"
    " (m.kind == b'C')\n        {\n            usize at = 0;\n            String tag = match (cstr_at(b, &mu"
    "t at))\n            {\n                Ok(t)  : t,\n                Err(e) : return Err(broken(c, e)),\n"
    "            };\n            res.affected = tag_count(String::as_view(&tag));\n            overwrite(&m"
    "ut res.tag, tag);\n        }\n        else if (m.kind == b'E')\n        {\n            PgServerError rep"
    "orted = match (decode_server_error(b))\n            {\n                Ok(se) : se,\n                Er"
    "r(e) : return Err(broken(c, e)),\n            };\n            if (Option::is_none(&failure))\n         "
    "   {\n                overwrite(&mut failure, Some(reported));\n            }\n        }\n        else i"
    "f (m.kind == b'N')\n        {\n            match (decode_server_error(b))\n            {\n              "
    "  Ok(se) : Vec::push(&mut c.notices, se),\n                Err(e) : return Err(broken(c, e)),\n       "
    "     }\n        }\n        else if (m.kind == b'Z')\n        {\n            break;\n        }\n        els"
    "e if (m.kind == b'1' || m.kind == b'2' || m.kind == b'n' || m.kind == b'I' || m.kind == b's' || m.ki"
    "nd == b'A' || m.kind == b'S')\n        {\n            // ParseComplete, BindComplete, NoData, EmptyQue"
    "ryResponse,\n            // PortalSuspended, a notification, a parameter changed.\n            continu"
    "e;\n        }\n        else\n        {\n            return Err(broken(c, ProtocolViolation));\n        }\n"
    "    }\n    if (Some(e) = failure)\n    {\n        return Err(Server(e));\n    }\n    if (too_large)\n    {"
    "\n        return Err(ResultTooLarge);\n    }\n    Ok(res)\n}export fn PgConnection::query(\n    ref<PgCon"
    "nection, exclusive> c,\n    StringView sql,\n    slice<PgValue, shared> params,\n) : Result<PgResult, P"
    "gError>\n{\n    if (c.closed)\n    {\n        return Err(Disconnected);\n    }\n    if (slice_len(params) "
    "> 65535)\n    {\n        return Err(ResultTooLarge);\n    }\n    Vec<u8> out = Vec::new();\n    Vec<u8> p"
    "arse = Vec::new();\n    push_cstr(&mut parse, \"\");\n    push_cstr(&mut parse, sql);\n    Vec::push_be<u"
    "16>(&mut parse, 0);\n    Vec::extend_from(&mut out, &frame(b'P', &parse[0..$])[0..$]);\n    Vec<u8> bi"
    "nd = Vec::new();\n    push_cstr(&mut bind, \"\");\n    push_cstr(&mut bind, \"\");\n    Vec::push_be<u16>(&"
    "mut bind, 0);\n    Vec::push_be(&mut bind, narrow<u16>(slice_len(params)));\n    foreach (p in params)"
    "\n    {\n        match (PgValue::text(p))\n        {\n            Some(t) :\n            {\n              "
    "  Vec::push_be(&mut bind, narrow<u32>(String::len(&t)));\n                Vec::extend_from(&mut bind,"
    " StringView::as_bytes(String::as_view(&t)));\n            },\n            None    : Vec::push_be<i32>("
    "&mut bind, -1),\n        }\n    }\n    Vec::push_be<u16>(&mut bind, 0);\n    Vec::extend_from(&mut out, "
    "&frame(b'B', &bind[0..$])[0..$]);\n    Vec<u8> describe = Vec::new();\n    Vec::push(&mut describe, b'"
    "P');\n    Vec::push(&mut describe, 0);\n    Vec::extend_from(&mut out, &frame(b'D', &describe[0..$])[0"
    "..$]);\n    Vec<u8> execute = Vec::new();\n    push_cstr(&mut execute, \"\");\n    Vec::push_be<u32>(&mut"
    " execute, 0);\n    Vec::extend_from(&mut out, &frame(b'E', &execute[0..$])[0..$]);\n    Vec<u8> none ="
    " Vec::new();\n    Vec::extend_from(&mut out, &frame(b'S', &none[0..$])[0..$]);\n    match (pg_write(&m"
    "ut c.reader.conn, &out[0..$]))\n    {\n        Ok(_)  : {},\n        Err(e) : return Err(broken(c, e)),"
    "\n    }\n    collect(c, true)\n}export fn PgConnection::execute(\n    ref<PgConnection, exclusive> c,\n  "
    "  StringView sql,\n    slice<PgValue, shared> params,\n) : Result<u64, PgError>\n{\n    PgResult r = PgC"
    "onnection::query(c, sql, params)?;\n    Ok(r.affected)\n}export fn PgConnection::run_script(ref<PgConn"
    "ection, exclusive> c, StringView sql) : Result<void, PgError>\n{\n    if (c.closed)\n    {\n        retu"
    "rn Err(Disconnected);\n    }\n    Vec<u8> q = Vec::new();\n    push_cstr(&mut q, sql);\n    match (pg_wr"
    "ite(&mut c.reader.conn, &frame(b'Q', &q[0..$])[0..$]))\n    {\n        Ok(_)  : {},\n        Err(e) : r"
    "eturn Err(broken(c, e)),\n    }\n    _ = collect(c, false)?;\n    Ok(())\n}export fn PgConnection::close"
    "(ref<PgConnection, exclusive> c)\n{\n    if (!c.closed)\n    {\n        Vec<u8> none = Vec::new();\n     "
    "   _ = pg_write(&mut c.reader.conn, &frame(b'X', &none[0..$])[0..$]);\n        pg_close(&mut c.reader"
    ".conn);\n        c.closed = true;\n    }\n}fn JsonReader::peek(ref<JsonReader, shared> r) : u8\n{\n    if"
    " (r.at < StringView::len(r.text))\n    {\n        return r.text.bytes[r.at];\n    }\n    0\n}fn json_spac"
    "e_end(slice<u8, shared> b, usize at) : usize\n{\n    usize i = at;\n    while (i < slice_len(b) && (b[i"
    "] == b' ' || b[i] == b'\\t' || b[i] == b'\\n' || b[i] == b'\\r'))\n    {\n        i += 1;\n    }\n    i\n}fn"
    " json_digits_end(slice<u8, shared> b, usize at) : usize\n{\n    usize i = at;\n    while (i < slice_len"
    "(b) && ascii_is_digit(b[i]))\n    {\n        i += 1;\n    }\n    i\n}fn JsonReader::skip_space(ref<JsonRe"
    "ader, exclusive> r)\n{\n    r.at = json_space_end(r.text.bytes, r.at);\n}fn JsonReader::word(ref<JsonRe"
    "ader, exclusive> r, str word) : bool\n{\n    usize n = str_len(word);\n    if (r.at + n > StringView::l"
    "en(r.text))\n    {\n        return false;\n    }\n    for (usize i = 0; i < n; i += 1)\n    {\n        if "
    "(r.text.bytes[r.at + i] != str_byte(word, i))\n        {\n            return false;\n        }\n    }\n  "
    "  r.at += n;\n    true\n}fn JsonReader::digits(ref<JsonReader, exclusive> r) : usize\n{\n    usize start"
    " = r.at;\n    r.at = json_digits_end(r.text.bytes, r.at);\n    r.at - start\n}fn JsonReader::number(ref"
    "<JsonReader, exclusive> r) : Result<Json, ParseError>\n{\n    usize start = r.at;\n    if (JsonReader::"
    "peek(r) == b'-')\n    {\n        r.at += 1;\n    }\n    if (JsonReader::peek(r) == b'0')\n    {\n        r"
    ".at += 1;\n    }\n    else if (JsonReader::digits(r) == 0)\n    {\n        return Err(Invalid(r.at));\n  "
    "  }\n    if (JsonReader::peek(r) == b'.')\n    {\n        r.at += 1;\n        if (JsonReader::digits(r) "
    "== 0)\n        {\n            return Err(Invalid(r.at));\n        }\n    }\n    u8 e = JsonReader::peek(r"
    ");\n    if (e == b'e' || e == b'E')\n    {\n        r.at += 1;\n        u8 sign = JsonReader::peek(r);\n "
    "       if (sign == b'+' || sign == b'-')\n        {\n            r.at += 1;\n        }\n        if (Json"
    "Reader::digits(r) == 0)\n        {\n            return Err(Invalid(r.at));\n        }\n    }\n    match ("
    "StringView::parse<f64>(StringView::sub(r.text, start, r.at)))\n    {\n        Ok(v)  : Ok(JsonNumber(v"
    ")),\n        Err(_) : Err(OutOfRange),\n    }\n}fn JsonReader::text(ref<JsonReader, exclusive> r) : Res"
    "ult<String, ParseError>\n{\n    JsonStr { bytes, pos, err } = json_string(r.text.bytes, r.at);\n    r.a"
    "t = pos;\n    if (err > 0)\n    {\n        return Err(Invalid(err - 1));\n    }\n    // Runs of the (UTF-"
    "8) text and encoded code points: well-formed.\n    match (String::from_utf8(bytes))\n    {\n        Ok("
    "s)  : Ok(s),\n        Err(_) : Err(Invalid(pos)),\n    }\n}fn json_hex4(array<u8, 4> q, usize at) : i64"
    "\n{\n    i64 v = 0;\n    for (usize i = 0; i < 4; i += 1)\n    {\n        usize p = at + i;\n        u8 c "
    "= q[i];\n        i64 d = if (c >= b'0' && c <= b'9') { widen<i64>(c - b'0') }\n        else if (c >= b"
    "'a' && c <= b'f') { widen<i64>(c - b'a') + 10 }\n        else if (c >= b'A' && c <= b'F') { widen<i64"
    ">(c - b'A') + 10 }\n        else { return -1 - narrow<i64>(p); };\n        v = v * 16 + d;\n    }\n    v"
    "\n}fn json_string(slice<u8, shared> b, usize start) : JsonStr\n{\n    Vec<u8> out = Vec::new();\n    usi"
    "ze n = slice_len(b);\n    usize at = start;\n    usize err = 0;\n    while (true)\n    {\n        if (at "
    ">= n)\n        {\n            err = n + 1;\n            break;\n        }\n        u8 c = b[at];\n        "
    "if (c == b'\"')\n        {\n            at += 1;\n            break;\n        }\n        if (c < 0x20)\n   "
    "     {\n            err = at + 1;\n            break;\n        }\n        if (c != b'\\\\')\n        {\n    "
    "        Vec::push(&mut out, c);\n            at += 1;\n            continue;\n        }\n        at += 1"
    ";\n        u8 e = if (at < n) { b[at] } else { 0 };\n        at += 1;\n        if (e == b'\"') { Vec::pu"
    "sh(&mut out, b'\"'); }\n        else if (e == b'\\\\') { Vec::push(&mut out, b'\\\\'); }\n        else if ("
    "e == b'/') { Vec::push(&mut out, b'/'); }\n        else if (e == b'b') { Vec::push(&mut out, 8); }\n  "
    "      else if (e == b'f') { Vec::push(&mut out, 12); }\n        else if (e == b'n') { Vec::push(&mut "
