    " Err(Invalid(i)) : assert(i == 1),\n        _               : assert(false),\n    }\n}fn base64_decode_"
    "bytes(slice<u8, shared> b) : Result<Vec<u8>, ParseError>\n{\n    usize n = slice_len(b);\n    Vec<u8> o"
    "ut = Vec::new();\n    if (n == 0)\n    {\n        return Ok(Vec::new());\n    }\n    if (n % 4 != 0)\n    "
    "{\n        return Err(Invalid(n));\n    }\n    usize pad = 0;\n    if (b[n - 1] == b'=')\n    {\n        p"
    "ad = 1;\n        if (b[n - 2] == b'=')\n        {\n            pad = 2;\n        }\n    }\n    Vec::reserv"
    "e(&mut out, n / 4 * 3);\n    for (usize i = 0; i < n; i += 4)\n    {\n        u32 v = 0;\n        for (u"
    "size j = 0; j < 4; j += 1)\n        {\n            u8 c = b[i + j];\n            if (c == b'=' && i + j"
    " >= n - pad)\n            {\n                v = v << 6;\n            }\n            else\n            {\n"
