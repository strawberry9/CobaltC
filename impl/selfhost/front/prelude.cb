    "(slice_len(signature) != k || slice_len(digest) != hash_len(kind))\n    {\n        return false;\n    }"
    "\n    Vec<u8> prefix = digest_info_prefix(kind);\n    usize t_len = Vec::len(&prefix) + slice_len(dige"
    "st);\n    if (k < t_len + 11)\n    {\n        return false;\n    }\n    Vec<u8> want = Vec::new();\n    Ve"
    "c::push(&mut want, 0);\n    Vec::push(&mut want, 1);\n    for (usize i = 0; i < k - t_len - 3; i += 1)"
