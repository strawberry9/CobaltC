    "{\n        usize e = Vec::len(&n.members[k].members) - 1;\n        return tnode_define(&mut n.members["
    "k].members[e], path, i + 1, is_array);\n    }\n    tnode_define(&mut n.members[k], path, i + 1, is_arr"
    "ay)\n}fn tnode_insert(\n    ref<TNode, exclusive> n,\n    ref<Vec<String>, shared> ctx,\n    usize ci,\n "
    "   ref<Vec<String>, shared> keys,\n    usize ki,\n    Toml v,\n) : bool\n{\n    if (ci < Vec::len(ctx))\n "
    "   {\n        // Down the current table's path, made by its header.\n        usize k = match (tnode_fi"
    "nd(&n.members, String::as_view(&ctx[ci])))\n        {\n            Some(k) : k,\n            None    : "
    "return false,\n        };\n        if (n.members[k].kind == K_ARRAY)\n        {\n            usize e = V"
    "ec::len(&n.members[k].members) - 1;\n            return tnode_insert(&mut n.members[k].members[e], ct"
    "x, ci + 1, keys, ki, v);\n        }\n        return tnode_insert(&mut n.members[k], ctx, ci + 1, keys,"
    " ki, v);\n    }\n    StringView part = String::as_view(&keys[ki]);\n    bool last = ki + 1 == Vec::len("
    "keys);\n    match (tnode_find(&n.members, part))\n    {\n        Some(k) :\n        {\n            if (la"
    "st)\n            {\n                return false;\n            }\n            u8 kind = n.members[k].kin"
    "d;\n            if (kind != K_DOTTED && kind != K_IMPLICIT)\n            {\n                return fals"
    "e;\n            }\n            n.members[k].kind = K_DOTTED;\n            tnode_insert(&mut n.members[k"
    "], ctx, ci, keys, ki + 1, v)\n        },\n        None    :\n        {\n            if (last)\n          "
    "  {\n                Vec::push(&mut n.members, tnode_new(String::from_view(part), K_VALUE, v));\n     "
    "           return true;\n            }\n            Vec::push(&mut n.members, tnode_new(String::from_v"
    "iew(part), K_DOTTED, TomlBool(false)));\n            usize k = Vec::len(&n.members) - 1;\n            "
    "tnode_insert(&mut n.members[k], ctx, ci, keys, ki + 1, v)\n        },\n    }\n}fn tnode_to_toml(TNode n"
    ") : Toml\n{\n    TNode { key, kind, leaf, members } = n;\n    drop(key);\n    if (kind == K_VALUE)\n    {"
    "\n        drop(members);\n        return leaf;\n    }\n    drop(leaf);\n    if (kind == K_ARRAY)\n    {\n  "
    "      Vec<Toml> items = Vec::new();\n        while (Some(m) = Vec::pop(&mut members))\n        {\n     "
    "       Vec::push(&mut items, tnode_to_toml(m));\n        }\n        Vec::reverse(&mut items);\n        "
    "return TomlArray(items);\n    }\n    Vec<TomlMember> out = Vec::new();\n    while (Some(m) = Vec::pop(&"
    "mut members))\n    {\n        String key = clone(&m.key);\n        Vec::push(&mut out, TomlMember { .ke"
    "y = key, .value = tnode_to_toml(m) });\n    }\n    Vec::reverse(&mut out);\n    TomlTable(out)\n}fn Toml"
    "Reader::peek(ref<TomlReader, shared> r) : u8\n{\n    if (r.at < StringView::len(r.text))\n    {\n       "
    " return r.text.bytes[r.at];\n    }\n    0\n}fn TomlReader::peek_at(ref<TomlReader, shared> r, usize ahe"
    "ad) : u8\n{\n    if (r.at + ahead < StringView::len(r.text))\n    {\n        return r.text.bytes[r.at + "
    "ahead];\n    }\n    0\n}fn TomlReader::at_end(ref<TomlReader, shared> r) : bool\n{\n    r.at >= StringVie"
    "w::len(r.text)\n}fn TomlReader::skip_ws(ref<TomlReader, exclusive> r)\n{\n    while (true)\n    {\n      "
    "  u8 c = TomlReader::peek(r);\n        if (c != b' ' && c != b'\\t')\n        {\n            return;\n   "
    "     }\n        r.at += 1;\n    }\n}fn TomlReader::newline(ref<TomlReader, exclusive> r) : bool\n{\n    u"
    "8 c = TomlReader::peek(r);\n    if (c == b'\\n')\n    {\n        r.at += 1;\n        return true;\n    }\n "
    "   if (c == b'\\r' && TomlReader::peek_at(r, 1) == b'\\n')\n    {\n        r.at += 2;\n        return tru"
    "e;\n    }\n    false\n}fn TomlReader::comment(ref<TomlReader, exclusive> r) : Result<void, ParseError>\n"
    "{\n    r.at += 1;\n    while (!TomlReader::at_end(r))\n    {\n        u8 c = TomlReader::peek(r);\n      "
    "  if (c == b'\\n' || (c == b'\\r' && TomlReader::peek_at(r, 1) == b'\\n'))\n        {\n            return"
    " Ok(());\n        }\n        if ((c < 0x20 && c != b'\\t') || c == 0x7F)\n        {\n            return E"
    "rr(Invalid(r.at));\n        }\n        r.at += 1;\n    }\n    Ok(())\n}fn TomlReader::line_end(ref<TomlRe"
    "ader, exclusive> r) : Result<void, ParseError>\n{\n    TomlReader::skip_ws(r);\n    if (TomlReader::pee"
    "k(r) == b'#')\n    {\n        TomlReader::comment(r)?;\n    }\n    if (TomlReader::at_end(r) || TomlRead"
    "er::newline(r))\n    {\n        return Ok(());\n    }\n    Err(Invalid(r.at))\n}fn TomlReader::skip_space"
    "_lines(ref<TomlReader, exclusive> r) : Result<void, ParseError>\n{\n    while (true)\n    {\n        Tom"
    "lReader::skip_ws(r);\n        u8 c = TomlReader::peek(r);\n        if (c == b'#')\n        {\n          "
    "  TomlReader::comment(r)?;\n            continue;\n        }\n        if (!TomlReader::newline(r))\n    "
    "    {\n            return Ok(());\n        }\n    }\n}fn toml_is_bare(u8 c) : bool\n{\n    ascii_is_alnum("
    "c) || c == b'_' || c == b'-'\n}fn toml_hex_digit(u8 c) : i64\n{\n    if (c >= b'0' && c <= b'9') { wide"
    "n<i64>(c - b'0') }\n    else if (c >= b'a' && c <= b'f') { widen<i64>(c - b'a') + 10 }\n    else if (c"
    " >= b'A' && c <= b'F') { widen<i64>(c - b'A') + 10 }\n    else { -1 }\n}fn TomlReader::unicode_escape("
    "\n    ref<TomlReader, exclusive> r,\n    usize n,\n    ref<String, exclusive> out,\n) : Result<void, Par"
    "seError>\n{\n    i64 v = 0;\n    for (usize i = 0; i < n; i += 1)\n    {\n        i64 d = toml_hex_digit("
    "TomlReader::peek(r));\n        if (d < 0)\n        {\n            return Err(Invalid(r.at));\n        }\n"
    "        v = v * 16 + d;\n        r.at += 1;\n    }\n    if ((v >= 0xD800 && v <= 0xDFFF) || v > 0x10FFF"
    "F)\n    {\n        return Err(Invalid(r.at - n));\n    }\n    String::push_code_point(out, narrow<u32>(v"
    "));\n    Ok(())\n}fn TomlReader::basic(ref<TomlReader, exclusive> r, bool multi) : Result<String, Pars"
    "eError>\n{\n    String out = String::new();\n    if (multi)\n    {\n        // A newline right after the "
    "opening delimiter is not part of the text.\n        TomlReader::newline(r);\n    }\n    while (true)\n  "
    "  {\n        if (TomlReader::at_end(r))\n        {\n            return Err(Invalid(r.at));\n        }\n  "
    "      u8 c = TomlReader::peek(r);\n        if (c == b'\"')\n        {\n            if (!multi)\n         "
    "   {\n                r.at += 1;\n                return Ok(out);\n            }\n            // The clo"
    "sing `\"\"\"`, with up to two more quotes before it as text.\n            usize run = 0;\n            whi"
    "le (TomlReader::peek_at(r, run) == b'\"')\n            {\n                run += 1;\n            }\n     "
    "       if (run < 3)\n            {\n                for (usize i = 0; i < run; i += 1)\n               "
    " {\n                    String::push_ascii(&mut out, b'\"');\n                }\n                r.at +="
    " run;\n                continue;\n            }\n            if (run > 5)\n            {\n               "
    " return Err(Invalid(r.at + 5));\n            }\n            for (usize i = 3; i < run; i += 1)\n       "
    "     {\n                String::push_ascii(&mut out, b'\"');\n            }\n            r.at += run;\n  "
    "          return Ok(out);\n        }\n        if (c == b'\\\\')\n        {\n            r.at += 1;\n       "
    "     u8 e = TomlReader::peek(r);\n            if (e == b'\"') { String::push_ascii(&mut out, b'\"'); }\n"
    "            else if (e == b'\\\\') { String::push_ascii(&mut out, b'\\\\'); }\n            else if (e == "
    "b'b') { String::push_ascii(&mut out, 8); }\n            else if (e == b't') { String::push_ascii(&mut"
    " out, 9); }\n            else if (e == b'n') { String::push_ascii(&mut out, 10); }\n            else i"
    "f (e == b'f') { String::push_ascii(&mut out, 12); }\n            else if (e == b'r') { String::push_a"
    "scii(&mut out, 13); }\n            else if (e == b'u' || e == b'U')\n            {\n                r.a"
    "t += 1;\n                TomlReader::unicode_escape(r, if (e == b'u') { 4 } else { 8 }, &mut out)?;\n "
    "               continue;\n            }\n            else if (multi && (e == b' ' || e == b'\\t' || e ="
    "= b'\\n' || e == b'\\r'))\n            {\n                // A line-ending backslash: the whitespace and"
    " newlines up to\n                // the next text are dropped; a newline must be among them.\n        "
    "        usize save = r.at;\n                TomlReader::skip_ws(r);\n                if (!TomlReader::"
    "newline(r))\n                {\n                    return Err(Invalid(save));\n                }\n     "
    "           while (true)\n                {\n                    TomlReader::skip_ws(r);\n              "
    "      if (!TomlReader::newline(r))\n                    {\n                        break;\n            "
    "        }\n                }\n                continue;\n            }\n            else\n            {\n "
    "               return Err(Invalid(r.at));\n            }\n            r.at += 1;\n            continue;"
    "\n        }\n        if (c == b'\\n' || c == b'\\r')\n        {\n            if (!multi)\n            {\n   "
    "             return Err(Invalid(r.at));\n            }\n            if (c == b'\\r')\n            {\n    "
    "            if (TomlReader::peek_at(r, 1) != b'\\n')\n                {\n                    return Err"
    "(Invalid(r.at));\n                }\n                String::push_ascii(&mut out, b'\\r');\n            "
    "    r.at += 1;\n            }\n            String::push_ascii(&mut out, b'\\n');\n            r.at += 1;"
    "\n            continue;\n        }\n        if ((c < 0x20 && c != b'\\t') || c == 0x7F)\n        {\n      "
    "      return Err(Invalid(r.at));\n        }\n        // Any other byte, of a multi-byte character too:"
    " the text is UTF-8\n        // and every byte the format treats apart is ASCII, so a character's\n    "
    "    // bytes are copied whole.\n        Vec::push(&mut out.bytes, c);\n        r.at += 1;\n    }\n}fn To"
    "mlReader::literal(ref<TomlReader, exclusive> r, bool multi) : Result<String, ParseError>\n{\n    Strin"
    "g out = String::new();\n    if (multi)\n    {\n        TomlReader::newline(r);\n    }\n    while (true)\n "
    "   {\n        if (TomlReader::at_end(r))\n        {\n            return Err(Invalid(r.at));\n        }\n "
    "       u8 c = TomlReader::peek(r);\n        if (c == b'\\'')\n        {\n            if (!multi)\n       "
    "     {\n                r.at += 1;\n                return Ok(out);\n            }\n            usize ru"
    "n = 0;\n            while (TomlReader::peek_at(r, run) == b'\\'')\n            {\n                run +="
    " 1;\n            }\n            if (run < 3)\n            {\n                for (usize i = 0; i < run; "
    "i += 1)\n                {\n                    String::push_ascii(&mut out, b'\\'');\n                }"
    "\n                r.at += run;\n                continue;\n            }\n            if (run > 5)\n     "
    "       {\n                return Err(Invalid(r.at + 5));\n            }\n            for (usize i = 3; "
    "i < run; i += 1)\n            {\n                String::push_ascii(&mut out, b'\\'');\n            }\n  "
    "          r.at += run;\n            return Ok(out);\n        }\n        if (c == b'\\n' || c == b'\\r')\n "
    "       {\n            if (!multi)\n            {\n                return Err(Invalid(r.at));\n          "
    "  }\n            if (c == b'\\r')\n            {\n                if (TomlReader::peek_at(r, 1) != b'\\n'"
    ")\n                {\n                    return Err(Invalid(r.at));\n                }\n               "
    " String::push_ascii(&mut out, b'\\r');\n                r.at += 1;\n            }\n            String::p"
    "ush_ascii(&mut out, b'\\n');\n            r.at += 1;\n            continue;\n        }\n        if ((c < "
    "0x20 && c != b'\\t') || c == 0x7F)\n        {\n            return Err(Invalid(r.at));\n        }\n       "
    " // Any other byte, of a multi-byte character too: the text is UTF-8\n        // and every byte the f"
    "ormat treats apart is ASCII, so a character's\n        // bytes are copied whole.\n        Vec::push(&"
    "mut out.bytes, c);\n        r.at += 1;\n    }\n}fn TomlReader::key_part(ref<TomlReader, exclusive> r) :"
    " Result<String, ParseError>\n{\n    u8 c = TomlReader::peek(r);\n    if (c == b'\"')\n    {\n        r.at "
    "+= 1;\n        if (TomlReader::peek(r) == b'\"' && TomlReader::peek_at(r, 1) == b'\"')\n        {\n      "
    "      return Err(Invalid(r.at));\n        }\n        return TomlReader::basic(r, false);\n    }\n    if "
    "(c == b'\\'')\n    {\n        r.at += 1;\n        if (TomlReader::peek(r) == b'\\'' && TomlReader::peek_a"
    "t(r, 1) == b'\\'')\n        {\n            return Err(Invalid(r.at));\n        }\n        return TomlRead"
    "er::literal(r, false);\n    }\n    usize start = r.at;\n    while (toml_is_bare(TomlReader::peek(r)))\n "
    "   {\n        r.at += 1;\n    }\n    if (r.at == start)\n    {\n        return Err(Invalid(r.at));\n    }\n"
    "    Ok(String::from_view(StringView::sub(r.text, start, r.at)))\n}fn TomlReader::key(ref<TomlReader, "
    "exclusive> r) : Result<Vec<String>, ParseError>\n{\n    Vec<String> parts = Vec::new();\n    while (tru"
    "e)\n    {\n        Vec::push(&mut parts, TomlReader::key_part(r)?);\n        TomlReader::skip_ws(r);\n  "
    "      if (TomlReader::peek(r) != b'.')\n        {\n            return Ok(parts);\n        }\n        r.a"
    "t += 1;\n        TomlReader::skip_ws(r);\n    }\n}fn TomlReader::digits(ref<TomlReader, exclusive> r, r"
    "ef<String, exclusive> out) : Result<usize, ParseError>\n{\n    usize count = 0;\n    while (true)\n    {"
    "\n        u8 c = TomlReader::peek(r);\n        if (ascii_is_digit(c))\n        {\n            String::pu"
    "sh_ascii(out, c);\n            count += 1;\n            r.at += 1;\n            continue;\n        }\n   "
    "     if (c == b'_' && count > 0 && ascii_is_digit(TomlReader::peek_at(r, 1)))\n        {\n            "
    "r.at += 1;\n            continue;\n        }\n        if (c == b'_')\n        {\n            return Err(I"
    "nvalid(r.at));\n        }\n        return Ok(count);\n    }\n}fn TomlReader::prefixed(ref<TomlReader, ex"
    "clusive> r, i64 base) : Result<Toml, ParseError>\n{\n    i64 v = 0;\n    usize count = 0;\n    while (tr"
    "ue)\n    {\n        u8 c = TomlReader::peek(r);\n        i64 d = toml_hex_digit(c);\n        if (d >= 0 "
    "&& d < base)\n        {\n            match (checked_mul(v, base))\n            {\n                Some(m"
    ") : match (checked_add(m, d))\n                {\n                    Some(s) : v = s,\n               "
    "     None    : return Err(OutOfRange),\n                },\n                None : return Err(OutOfRan"
    "ge),\n            }\n            count += 1;\n            r.at += 1;\n            continue;\n        }\n  "
    "      if (c == b'_' && count > 0)\n        {\n            i64 next = toml_hex_digit(TomlReader::peek_a"
    "t(r, 1));\n            if (next >= 0 && next < base)\n            {\n                r.at += 1;\n       "
    "         continue;\n            }\n        }\n        if (count == 0 || c == b'_')\n        {\n          "
    "  return Err(Invalid(r.at));\n        }\n        return Ok(TomlInteger(v));\n    }\n}fn TomlReader::numb"
    "er(ref<TomlReader, exclusive> r) : Result<Toml, ParseError>\n{\n    String text = String::new();\n    u"
    "8 c = TomlReader::peek(r);\n    bool negative = false;\n    bool signed = false;\n    if (c == b'+' || "
    "c == b'-')\n    {\n        negative = c == b'-';\n        signed = true;\n        if (negative)\n        "
    "{\n            String::push_ascii(&mut text, b'-');\n        }\n        r.at += 1;\n        c = TomlRead"
    "er::peek(r);\n    }\n    if (c == b'i' || c == b'n')\n    {\n        bool inf = TomlReader::word(r, \"inf"
    "\");\n        if (!inf && !TomlReader::word(r, \"nan\"))\n        {\n            return Err(Invalid(r.at))"
    ";\n        }\n        f64 x = if (inf) { 1.0 / 0.0 } else { 0.0 / 0.0 };\n        return Ok(TomlFloat(i"
    "f (negative) { 0.0 - x } else { x }));\n    }\n    if (c == b'0' && !signed)\n    {\n        u8 p = Toml"
    "Reader::peek_at(r, 1);\n        if (p == b'x' || p == b'o' || p == b'b')\n        {\n            r.at +"
    "= 2;\n            return TomlReader::prefixed(r, if (p == b'x') { 16 } else if (p == b'o') { 8 } else"
    " { 2 });\n        }\n    }\n    usize start = r.at;\n    usize n = TomlReader::digits(r, &mut text)?;\n  "
    "  if (n == 0)\n    {\n        return Err(Invalid(r.at));\n    }\n    if (n > 1 && r.text.bytes[start] =="
    " b'0')\n    {\n        return Err(Invalid(start + 1));\n    }\n    bool float = false;\n    if (TomlReade"
    "r::peek(r) == b'.')\n    {\n        float = true;\n        String::push_ascii(&mut text, b'.');\n       "
    " r.at += 1;\n        if (!ascii_is_digit(TomlReader::peek(r)))\n        {\n            return Err(Inval"
    "id(r.at));\n        }\n        TomlReader::digits(r, &mut text)?;\n    }\n    c = TomlReader::peek(r);\n "
    "   if (c == b'e' || c == b'E')\n    {\n        float = true;\n        String::push_ascii(&mut text, b'e"
    "');\n        r.at += 1;\n        c = TomlReader::peek(r);\n        if (c == b'+' || c == b'-')\n        "
    "{\n            String::push_ascii(&mut text, c);\n            r.at += 1;\n        }\n        if (!ascii_"
    "is_digit(TomlReader::peek(r)))\n        {\n            return Err(Invalid(r.at));\n        }\n        To"
    "mlReader::digits(r, &mut text)?;\n    }\n    if (float)\n    {\n        return match (StringView::parse<"
    "f64>(String::as_view(&text)))\n        {\n            Ok(x)  : Ok(TomlFloat(x)),\n            Err(_) : "
    "Err(OutOfRange),\n        };\n    }\n    match (StringView::parse<i64>(String::as_view(&text)))\n    {\n "
    "       Ok(i)  : Ok(TomlInteger(i)),\n        Err(_) : Err(OutOfRange),\n    }\n}fn TomlReader::fixed(re"
    "f<TomlReader, exclusive> r, usize n) : i64\n{\n    i64 v = 0;\n    for (usize i = 0; i < n; i += 1)\n   "
    " {\n        u8 c = TomlReader::peek_at(r, i);\n        if (!ascii_is_digit(c))\n        {\n            r"
    "eturn -1;\n        }\n        v = v * 10 + widen<i64>(c - b'0');\n    }\n    r.at += n;\n    v\n}fn toml_d"
    "ays_in_month(i64 year, i64 month) : i64\n{\n    if (month == 2)\n    {\n        bool leap = (year % 4 =="
    " 0 && year % 100 != 0) || year % 400 == 0;\n        return if (leap) { 29 } else { 28 };\n    }\n    if"
    " (month == 4 || month == 6 || month == 9 || month == 11) { 30 } else { 31 }\n}fn TomlReader::time_par"
    "t(ref<TomlReader, exclusive> r, ref<TomlDateTime, exclusive> d) : Result<void, ParseError>\n{\n    usi"
    "ze at = r.at;\n    i64 hour = TomlReader::fixed(r, 2);\n    if (hour < 0 || TomlReader::peek(r) != b':"
    "')\n    {\n        return Err(Invalid(r.at));\n    }\n    r.at += 1;\n    i64 minute = TomlReader::fixed("
    "r, 2);\n    if (minute < 0 || TomlReader::peek(r) != b':')\n    {\n        return Err(Invalid(r.at));\n "
    "   }\n    r.at += 1;\n    i64 second = TomlReader::fixed(r, 2);\n    if (second < 0)\n    {\n        retu"
    "rn Err(Invalid(r.at));\n    }\n    if (hour > 23 || minute > 59 || second > 60)\n    {\n        return E"
    "rr(Invalid(at));\n    }\n    d.hour = narrow<u8>(hour);\n    d.minute = narrow<u8>(minute);\n    d.secon"
    "d = narrow<u8>(second);\n    if (TomlReader::peek(r) == b'.')\n    {\n        r.at += 1;\n        if (!a"
    "scii_is_digit(TomlReader::peek(r)))\n        {\n            return Err(Invalid(r.at));\n        }\n     "
    "   u32 nanos = 0;\n        usize digits = 0;\n        while (ascii_is_digit(TomlReader::peek(r)))\n    "
    "    {\n            if (digits < 9)\n            {\n                nanos = nanos * 10 + widen<u32>(Toml"
    "Reader::peek(r) - b'0');\n            }\n            digits += 1;\n            r.at += 1;\n        }\n   "
    "     while (digits < 9)\n        {\n            nanos = nanos * 10;\n            digits += 1;\n        }"
    "\n        d.nanoseconds = nanos;\n    }\n    Ok(())\n}fn TomlReader::datetime(ref<TomlReader, exclusive>"
    " r, bool has_date) : Result<Toml, ParseError>\n{\n    TomlDateTime d = TomlDateTime {\n        .kind = "
    "TomlLocalTime,\n        .year = 0,\n        .month = 0,\n        .day = 0,\n        .hour = 0,\n        ."
    "minute = 0,\n        .second = 0,\n        .nanoseconds = 0,\n        .offset_minutes = 0,\n    };\n    i"
    "f (!has_date)\n    {\n        TomlReader::time_part(r, &mut d)?;\n        return Ok(TomlDateTime(d));\n "
    "   }\n    usize start = r.at;\n    i64 year = TomlReader::fixed(r, 4);\n    if (year < 0 || TomlReader:"
    ":peek(r) != b'-')\n    {\n        return Err(Invalid(r.at));\n    }\n    r.at += 1;\n    i64 month = Toml"
    "Reader::fixed(r, 2);\n    if (month < 0 || TomlReader::peek(r) != b'-')\n    {\n        return Err(Inva"
    "lid(r.at));\n    }\n    r.at += 1;\n    i64 day = TomlReader::fixed(r, 2);\n    if (day < 0)\n    {\n     "
    "   return Err(Invalid(r.at));\n    }\n    if (month < 1 || month > 12 || day < 1 || day > toml_days_in"
    "_month(year, month))\n    {\n        return Err(Invalid(start));\n    }\n    d.year = year;\n    d.month "
    "= narrow<u8>(month);\n    d.day = narrow<u8>(day);\n    d.kind = TomlLocalDate;\n    u8 c = TomlReader:"
    ":peek(r);\n    if (c == b'T' || c == b't' || (c == b' ' && ascii_is_digit(TomlReader::peek_at(r, 1)))"
    ")\n    {\n        r.at += 1;\n        TomlReader::time_part(r, &mut d)?;\n        d.kind = TomlLocalDate"
    "Time;\n        c = TomlReader::peek(r);\n        if (c == b'Z' || c == b'z')\n        {\n            r.a"
    "t += 1;\n            d.kind = TomlOffsetDateTime;\n        }\n        else if (c == b'+' || c == b'-')\n"
    "        {\n            usize at = r.at;\n            r.at += 1;\n            i64 oh = TomlReader::fixed"
    "(r, 2);\n            if (oh < 0 || TomlReader::peek(r) != b':')\n            {\n                return "
    "Err(Invalid(r.at));\n            }\n            r.at += 1;\n            i64 om = TomlReader::fixed(r, 2"
    ");\n            if (om < 0)\n            {\n                return Err(Invalid(r.at));\n            }\n  "
    "          if (oh > 23 || om > 59)\n            {\n                return Err(Invalid(at));\n           "
    " }\n            i64 minutes = oh * 60 + om;\n            d.offset_minutes = narrow<i32>(if (c == b'-')"
    " { 0 - minutes } else { minutes });\n            d.kind = TomlOffsetDateTime;\n        }\n    }\n    Ok("
    "TomlDateTime(d))\n}fn TomlReader::date_ahead(ref<TomlReader, shared> r) : bool\n{\n    for (usize i = 0"
    "; i < 4; i += 1)\n    {\n        if (!ascii_is_digit(TomlReader::peek_at(r, i)))\n        {\n           "
    " return false;\n        }\n    }\n    TomlReader::peek_at(r, 4) == b'-'\n}fn TomlReader::time_ahead(ref<"
    "TomlReader, shared> r) : bool\n{\n    ascii_is_digit(TomlReader::peek(r)) && ascii_is_digit(TomlReader"
    "::peek_at(\n        r,\n        1,\n    )) && TomlReader::peek_at(r, 2) == b':'\n}fn TomlReader::word(re"
    "f<TomlReader, exclusive> r, str word) : bool\n{\n    usize n = str_len(word);\n    for (usize i = 0; i "
    "< n; i += 1)\n    {\n        if (TomlReader::peek_at(r, i) != str_byte(word, i))\n        {\n           "
    " return false;\n        }\n    }\n    r.at += n;\n    true\n}fn TomlReader::inline_table(ref<TomlReader, "
    "exclusive> r, usize depth) : Result<Toml, ParseError>\n{\n    TNode table = tnode_new(String::new(), K"
    "_HEADER, TomlBool(false));\n    Vec<String> ctx = Vec::new();\n    TomlReader::skip_ws(r);\n    if (Tom"
    "lReader::peek(r) == b'}')\n    {\n        r.at += 1;\n        return Ok(tnode_to_toml(table));\n    }\n  "
    "  while (true)\n    {\n        TomlReader::skip_ws(r);\n        usize key_at = r.at;\n        Vec<String"
    "> keys = TomlReader::key(r)?;\n        if (TomlReader::peek(r) != b'=')\n        {\n            return "
    "Err(Invalid(r.at));\n        }\n        r.at += 1;\n        TomlReader::skip_ws(r);\n        Toml v = To"
    "mlReader::value(r, depth + 1)?;\n        if (!tnode_insert(&mut table, &ctx, 0, &keys, 0, v))\n       "
    " {\n            return Err(Invalid(key_at));\n        }\n        TomlReader::skip_ws(r);\n        u8 c ="
    " TomlReader::peek(r);\n        r.at += 1;\n        if (c == b'}')\n        {\n            return Ok(tnod"
    "e_to_toml(table));\n        }\n        if (c != b',')\n        {\n            return Err(Invalid(r.at - "
    "1));\n        }\n    }\n}fn TomlReader::array_value(ref<TomlReader, exclusive> r, usize depth) : Result"
    "<Toml, ParseError>\n{\n    Vec<Toml> items = Vec::new();\n    while (true)\n    {\n        TomlReader::sk"
    "ip_space_lines(r)?;\n        if (TomlReader::peek(r) == b']')\n        {\n            r.at += 1;\n      "
    "      return Ok(TomlArray(items));\n        }\n        Toml v = TomlReader::value(r, depth + 1)?;\n    "
    "    Vec::push(&mut items, v);\n        TomlReader::skip_space_lines(r)?;\n        u8 c = TomlReader::p"
    "eek(r);\n        if (c == b']')\n        {\n            r.at += 1;\n            return Ok(TomlArray(item"
    "s));\n        }\n        if (c != b',')\n        {\n            return Err(Invalid(r.at));\n        }\n   "
    "     r.at += 1;\n    }\n}fn TomlReader::value(ref<TomlReader, exclusive> r, usize depth) : Result<Toml"
    ", ParseError>\n{\n    u8 c = TomlReader::peek(r);\n    if (c == b'\"')\n    {\n        r.at += 1;\n        "
    "if (TomlReader::peek(r) == b'\"' && TomlReader::peek_at(r, 1) == b'\"')\n        {\n            r.at += "
    "2;\n            return Ok(TomlString(TomlReader::basic(r, true)?));\n        }\n        return Ok(TomlS"
    "tring(TomlReader::basic(r, false)?));\n    }\n    if (c == b'\\'')\n    {\n        r.at += 1;\n        if "
    "(TomlReader::peek(r) == b'\\'' && TomlReader::peek_at(r, 1) == b'\\'')\n        {\n            r.at += 2"
    ";\n            return Ok(TomlString(TomlReader::literal(r, true)?));\n        }\n        return Ok(Toml"
    "String(TomlReader::literal(r, false)?));\n    }\n    if (c == b'[' || c == b'{')\n    {\n        if (dep"
    "th >= TOML_MAX_DEPTH)\n        {\n            return Err(OutOfRange);\n        }\n        r.at += 1;\n   "
    "     return if (c == b'[') { TomlReader::array_value(r, depth) } else { TomlReader::inline_table(r, "
    "depth) };\n    }\n    if (TomlReader::word(r, \"true\"))\n    {\n        return Ok(TomlBool(true));\n    }\n"
    "    if (TomlReader::word(r, \"false\"))\n    {\n        return Ok(TomlBool(false));\n    }\n    if (TomlRe"
    "ader::date_ahead(r))\n    {\n        return TomlReader::datetime(r, true);\n    }\n    if (TomlReader::t"
    "ime_ahead(r))\n    {\n        return TomlReader::datetime(r, false);\n    }\n    if (c == b'+' || c == b"
    "'-' || c == b'i' || c == b'n' || ascii_is_digit(c))\n    {\n        return TomlReader::number(r);\n    "
    "}\n    Err(Invalid(r.at))\n}export fn Toml::parse(StringView text) : Result<Toml, ParseError>\n{\n    To"
    "mlReader r = TomlReader { .text = text, .at = 0 };\n    TNode root = tnode_new(String::new(), K_HEADE"
    "R, TomlBool(false));\n    Vec<String> ctx = Vec::new();\n    while (true)\n    {\n        TomlReader::sk"
    "ip_ws(&mut r);\n        if (TomlReader::at_end(&r))\n        {\n            break;\n        }\n        u8"
    " c = TomlReader::peek(&r);\n        if (c == b'#')\n        {\n            TomlReader::comment(&mut r)?"
    ";\n            continue;\n        }\n        if (TomlReader::newline(&mut r))\n        {\n            con"
    "tinue;\n        }\n        if (c == b'[')\n        {\n            r.at += 1;\n            bool is_array ="
    " TomlReader::peek(&r) == b'[';\n            if (is_array)\n            {\n                r.at += 1;\n  "
    "          }\n            TomlReader::skip_ws(&mut r);\n            usize key_at = r.at;\n            Ve"
    "c<String> parts = TomlReader::key(&mut r)?;\n            if (TomlReader::peek(&r) != b']' || (is_arra"
    "y && TomlReader::peek_at(&r, 1) != b']'))\n            {\n                return Err(Invalid(r.at));\n "
    "           }\n            r.at += if (is_array) { 2 } else { 1 };\n            if (!tnode_define(&mut "
    "root, &parts, 0, is_array))\n            {\n                return Err(Invalid(key_at));\n            }"
    "\n            overwrite(&mut ctx, parts);\n            TomlReader::line_end(&mut r)?;\n            cont"
    "inue;\n        }\n        usize key_at = r.at;\n        Vec<String> keys = TomlReader::key(&mut r)?;\n  "
    "      if (TomlReader::peek(&r) != b'=')\n        {\n            return Err(Invalid(r.at));\n        }\n "
    "       r.at += 1;\n        TomlReader::skip_ws(&mut r);\n        Toml v = TomlReader::value(&mut r, 0)"
    "?;\n        if (!tnode_insert(&mut root, &ctx, 0, &keys, 0, v))\n        {\n            return Err(Inva"
    "lid(key_at));\n        }\n        TomlReader::line_end(&mut r)?;\n    }\n    Ok(tnode_to_toml(root))\n}fn"
    " toml_quote(ref<String, exclusive> out, StringView s)\n{\n    str digits = \"0123456789ABCDEF\";\n    Str"
    "ing::push_ascii(out, b'\"');\n    for (usize i = 0; i < StringView::len(s); i += 1)\n    {\n        u8 b"
    " = s.bytes[i];\n        if (b >= 0x20 && b != b'\"' && b != b'\\\\' && b != 0x7F)\n        {\n            "
    "Vec::push(&mut out.bytes, b);          // a multi-byte character's bytes, whole\n            continue"
    ";\n        }\n        String::push_ascii(out, b'\\\\');\n        if (b == b'\"') { String::push_ascii(out,"
    " b'\"'); }\n        else if (b == b'\\\\') { String::push_ascii(out, b'\\\\'); }\n        else if (b == 10)"
    " { String::push_ascii(out, b'n'); }\n        else if (b == 13) { String::push_ascii(out, b'r'); }\n   "
    "     else if (b == 9) { String::push_ascii(out, b't'); }\n        else if (b == 8) { String::push_asc"
    "ii(out, b'b'); }\n        else if (b == 12) { String::push_ascii(out, b'f'); }\n        else\n        {"
    "\n            String::append(out, \"u00\");\n            String::push_ascii(out, str_byte(digits, widen<"
    "usize>(b >> 4)));\n            String::push_ascii(out, str_byte(digits, widen<usize>(b & 15)));\n     "
    "   }\n    }\n    String::push_ascii(out, b'\"');\n}fn toml_key(ref<String, exclusive> out, StringView ke"
    "y)\n{\n    bool bare = StringView::len(key) > 0;\n    for (usize i = 0; i < StringView::len(key); i += "
    "1)\n    {\n        if (!toml_is_bare(key.bytes[i]))\n        {\n            bare = false;\n        }\n    "
    "}\n    if (bare)\n    {\n        String::append(out, key);\n    }\n    else\n    {\n        toml_quote(out,"
    " key);\n    }\n}fn toml_float(ref<String, exclusive> out, f64 x)\n{\n    if (x != x)\n    {\n        Strin"
    "g::append(out, \"nan\");\n    }\n    else if (!is_finite(x))\n    {\n        String::append(out, if (x > 0"
    ".0) { \"inf\" } else { \"-inf\" });\n    }\n    else\n    {\n        String::append(out, x);\n    }\n}fn toml_"
    "two_digits(ref<String, exclusive> out, u8 v)\n{\n    String::push_ascii(out, b'0' + v / 10);\n    Strin"
    "g::push_ascii(out, b'0' + v % 10);\n}export fn TomlDateTime::text(ref<TomlDateTime, shared> d) : Stri"
    "ng\n{\n    String out = String::new();\n    bool date = match (d.kind)\n    {\n        TomlLocalTime : fa"
    "lse,\n        _             : true,\n    };\n    bool time = match (d.kind)\n    {\n        TomlLocalDate"
    " : false,\n        _             : true,\n    };\n    if (date)\n    {\n        i64 y = d.year;\n        i"
    "f (y < 0)\n        {\n            String::push_ascii(&mut out, b'-');\n            y = 0 - y;\n        }"
    "\n        if (y < 1000) { String::push_ascii(&mut out, b'0'); }\n        if (y < 100) { String::push_a"
    "scii(&mut out, b'0'); }\n        if (y < 10) { String::push_ascii(&mut out, b'0'); }\n        String::"
    "append(&mut out, y);\n        String::push_ascii(&mut out, b'-');\n        toml_two_digits(&mut out, d"
    ".month);\n        String::push_ascii(&mut out, b'-');\n        toml_two_digits(&mut out, d.day);\n    }"
    "\n    if (date && time)\n    {\n        String::push_ascii(&mut out, b'T');\n    }\n    if (time)\n    {\n "
    "       toml_two_digits(&mut out, d.hour);\n        String::push_ascii(&mut out, b':');\n        toml_t"
    "wo_digits(&mut out, d.minute);\n        String::push_ascii(&mut out, b':');\n        toml_two_digits(&"
    "mut out, d.second);\n        if (d.nanoseconds > 0)\n        {\n            String::push_ascii(&mut out"
    ", b'.');\n            u32 n = d.nanoseconds;\n            u32 scale = 100000000;\n            while (n "
    "> 0)\n            {\n                String::push_ascii(&mut out, b'0' + narrow<u8>(n / scale));\n     "
    "           n = n % scale;\n                scale = scale / 10;\n            }\n        }\n    }\n    matc"
    "h (d.kind)\n    {\n        TomlOffsetDateTime :\n        {\n            if (d.offset_minutes == 0)\n     "
    "       {\n                String::push_ascii(&mut out, b'Z');\n            }\n            else\n        "
    "    {\n                i32 m = d.offset_minutes;\n                String::push_ascii(&mut out, if (m <"
    " 0) { b'-' } else { b'+' });\n                if (m < 0)\n                {\n                    m = 0 "
    "- m;\n                }\n                toml_two_digits(&mut out, narrow<u8>(m / 60));\n              "
    "  String::push_ascii(&mut out, b':');\n                toml_two_digits(&mut out, narrow<u8>(m % 60));"
    "\n            }\n        },\n        _                  : {},\n    }\n    out\n}fn toml_is_table(ref<Toml,"
    " shared> v) : bool\n{\n    match (v)\n    {\n        TomlTable(_) : true,\n        _            : false,\n"
    "    }\n}fn toml_is_table_array(ref<Toml, shared> v) : bool\n{\n    match (v)\n    {\n        TomlArray(it"
    "ems) :\n        {\n            if (Vec::len(items) == 0)\n            {\n                return false;\n "
    "           }\n            for (usize i = 0; i < Vec::len(items); i += 1)\n            {\n              "
    "  if (!toml_is_table(&items[i]))\n                {\n                    return false;\n               "
    " }\n            }\n            true\n        },\n        _                : false,\n    }\n}fn toml_inline"
    "(ref<String, exclusive> out, ref<Toml, shared> v)\n{\n    match (v)\n    {\n        TomlString(s)      :"
    " toml_quote(out, String::as_view(s)),\n        TomlInteger(i)     : String::append(out, *i),\n        "
    "TomlFloat(x)       : toml_float(out, *x),\n        TomlBool(b)        : String::append(out, if (*b) {"
    " \"true\" } else { \"false\" }),\n        TomlDateTime(d)    : String::append(out, &TomlDateTime::text(d)"
    "),\n        TomlArray(items)   :\n        {\n            String::push_ascii(out, b'[');\n            for"
    " (usize i = 0; i < Vec::len(items); i += 1)\n            {\n                if (i > 0)\n               "
    " {\n                    String::append(out, \", \");\n                }\n                toml_inline(out,"
    " &items[i]);\n            }\n            String::push_ascii(out, b']');\n        },\n        TomlTable(m"
    "embers) :\n        {\n            String::push_ascii(out, b'{');\n            for (usize i = 0; i < Vec"
    "::len(members); i += 1)\n            {\n                String::append(out, if (i > 0) { \", \" } else {"
    " \" \" });\n                toml_key(out, String::as_view(&members[i].key));\n                String::ap"
    "pend(out, \" = \");\n                toml_inline(out, &members[i].value);\n            }\n            Str"
    "ing::append(out, if (Vec::len(members) > 0) { \" }\" } else { \"}\" });\n        },\n    }\n}fn toml_write_"
    "table(ref<String, exclusive> out, ref<Vec<TomlMember>, shared> members, ref<String, shared> path)\n{\n"
    "    for (usize i = 0; i < Vec::len(members); i += 1)\n    {\n        ref<Toml, shared> v = &members[i]"
    ".value;\n        if (toml_is_table(v) || toml_is_table_array(v))\n        {\n            continue;\n    "
    "    }\n        toml_key(out, String::as_view(&members[i].key));\n        String::append(out, \" = \");\n "
    "       toml_inline(out, v);\n        String::push_ascii(out, b'\\n');\n    }\n    for (usize i = 0; i < "
    "Vec::len(members); i += 1)\n    {\n        ref<Toml, shared> v = &members[i].value;\n        bool table"
    " = toml_is_table(v);\n        if (!table && !toml_is_table_array(v))\n        {\n            continue;\n"
    "        }\n        String sub = clone(path);\n        if (String::len(&sub) > 0)\n        {\n           "
    " String::push_ascii(&mut sub, b'.');\n        }\n        toml_key(&mut sub, String::as_view(&members[i"
    "].key));\n        match (v)\n        {\n            TomlTable(inner) :\n            {\n                if"
    " (String::len(out) > 0)\n                {\n                    String::push_ascii(out, b'\\n');\n      "
    "          }\n                String::push_ascii(out, b'[');\n                String::append(out, &sub)"
    ";\n                String::append(out, \"]\\n\");\n                toml_write_table(out, inner, &sub);\n  "
    "          },\n            TomlArray(items) :\n            {\n                for (usize k = 0; k < Vec:"
    ":len(items); k += 1)\n                {\n                    if (String::len(out) > 0)\n               "
    "     {\n                        String::push_ascii(out, b'\\n');\n                    }\n               "
    "     String::append(out, \"[[\");\n                    String::append(out, &sub);\n                    S"
    "tring::append(out, \"]]\\n\");\n                    match (&items[k])\n                    {\n            "
    "            TomlTable(inner) : toml_write_table(out, inner, &sub),\n                        _        "
    "        : {},\n                    }\n                }\n            },\n            _                : "
    "{},\n        }\n    }\n}export fn Toml::text(ref<Toml, shared> t) : String\n{\n    String out = String::n"
    "ew();\n    match (t)\n    {\n        TomlTable(members) :\n        {\n            String path = String::n"
    "ew();\n            toml_write_table(&mut out, members, &path);\n        },\n        _                  "
    ": toml_inline(&mut out, t),\n    }\n    out\n}export fn Toml::get(ref<Toml, shared> t, StringView key) "
    ": Option<ref<Toml, shared>>\n{\n    match (t)\n    {\n        TomlTable(members) :\n        {\n           "
    " for (usize i = 0; i < Vec::len(members); i += 1)\n            {\n                if (members[i].key ="
    "= key)\n                {\n                    return Some(&members[i].value);\n                }\n     "
    "       }\n            None\n        },\n        _                  : None,\n    }\n}export fn Toml::at(re"
    "f<Toml, shared> t, usize i) : Option<ref<Toml, shared>>\n{\n    match (t)\n    {\n        TomlArray(item"
    "s) : if (i < Vec::len(items)) { Some(&items[i]) } else { None },\n        _                : None,\n  "
    "  }\n}export fn Toml::lookup(ref<Toml, shared> t, StringView path) : Option<ref<Toml, shared>>\n{\n    "
    "Vec<StringView> parts = StringView::split(path, \".\");\n    ref<Toml, shared> cur = t;\n    for (usize "
    "i = 0; i < Vec::len(&parts); i += 1)\n    {\n        cur = match (cur)\n        {\n            TomlArray"
    "(_) : match (StringView::parse<usize>(parts[i]))\n            {\n                Ok(k)  : Toml::at(cur"
    ", k)?,\n                Err(_) : return None,\n            },\n            _ : Toml::get(cur, parts[i])"
    "?,\n        };\n    }\n    Some(cur)\n}export fn Toml::as_text(ref<Toml, shared> t) : Option<StringView>"
    "\n{\n    match (t)\n    {\n        TomlString(s) : Some(String::as_view(s)),\n        _             : Non"
    "e,\n    }\n}export fn Toml::as_i64(ref<Toml, shared> t) : Option<i64>\n{\n    match (t)\n    {\n        To"
    "mlInteger(i) : Some(*i),\n        _              : None,\n    }\n}export fn Toml::as_f64(ref<Toml, shar"
    "ed> t) : Option<f64>\n{\n    match (t)\n    {\n        TomlFloat(x) : Some(*x),\n        _            : N"
    "one,\n    }\n}export fn Toml::as_bool(ref<Toml, shared> t) : Option<bool>\n{\n    match (t)\n    {\n      "
    "  TomlBool(b) : Some(*b),\n        _           : None,\n    }\n}export fn Toml::as_datetime(ref<Toml, s"
    "hared> t) : Option<TomlDateTime>\n{\n    match (t)\n    {\n        TomlDateTime(d) : Some(*d),\n        _"
    "               : None,\n    }\n}export fn Toml::as_array(ref<Toml, shared> t) : Option<ref<Vec<Toml>, "
    "shared>>\n{\n    match (t)\n    {\n        TomlArray(items) : Some(items),\n        _                : No"
    "ne,\n    }\n}export fn Toml::as_table(ref<Toml, shared> t) : Option<ref<Vec<TomlMember>, shared>>\n{\n  "
    "  match (t)\n    {\n        TomlTable(members) : Some(members),\n        _                  : None,\n   "
    " }\n}export fn Toml::set(ref<Toml, exclusive> t, StringView key, Toml v)\n{\n    match (t)\n    {\n      "
    "  TomlTable(members) :\n        {\n            for (usize i = 0; i < Vec::len(members); i += 1)\n      "
    "      {\n                if (members[i].key == key)\n                {\n                    overwrite(&"
    "mut members[i].value, v);\n                    return;\n                }\n            }\n            Ve"
    "c::push(members, TomlMember { .key = String::from_view(key), .value = v });\n        },\n        _    "
    "              : assert(false, \"Toml::set on a value that is not a table\"),\n    }\n}export fn Toml::pu"
    "sh(ref<Toml, exclusive> t, Toml v)\n{\n    match (t)\n    {\n        TomlArray(items) : Vec::push(items,"
    " v),\n        _                : assert(false, \"Toml::push on a value that is not an array\"),\n    }\n}"
    "export fn CompressError::text(ref<CompressError, shared> e) : str\n{\n    match (e)\n    {\n        Corr"
    "upt(_) : \"corrupt compressed data\",\n        Truncated  : \"compressed data ends early\",\n        Overs"
    "ize   : \"decompressed data too large\",\n    }\n}fn BitReader::take(ref<BitReader, exclusive> r, u32 n)"
    " : Result<u32, CompressError>\n{\n    while (r.count < n)\n    {\n        if (r.at >= slice_len(r.data))"
    "\n        {\n            return Err(Truncated);\n        }\n        r.bits = r.bits | (widen<u32>(r.data"
    "[r.at]) << r.count);\n        r.at += 1;\n        r.count += 8;\n    }\n    u32 v = r.bits & ((1: u32 <<"
    " n) - 1);\n    r.bits = r.bits >> n;\n    r.count -= n;\n    Ok(v)\n}fn BitReader::align(ref<BitReader, "
    "exclusive> r)\n{\n    r.bits = 0;\n    r.count = 0;\n}fn Huffman::build(slice<u8, shared> lengths) : Opt"
    "ion<Huffman>\n{\n    array<u16, 16> counts = [0; 16];\n    for (usize i = 0; i < slice_len(lengths); i "
    "+= 1)\n    {\n        counts[widen<usize>(lengths[i])] += 1;\n    }\n    counts[0] = 0;\n    i32 left = 1"
    ";\n    for (usize len = 1; len < 16; len += 1)\n    {\n        left = left * 2 - widen<i32>(counts[len]"
    ");\n        if (left < 0)\n        {\n            return None;\n        }\n    }\n    array<u16, 16> offs "
    "= [0; 16];\n    for (usize len = 1; len < 15; len += 1)\n    {\n        offs[len + 1] = offs[len] + cou"
    "nts[len];\n    }\n    array<u16, 320> symbols = [0; 320];\n    for (usize i = 0; i < slice_len(lengths)"
    "; i += 1)\n    {\n        if (lengths[i] != 0)\n        {\n            symbols[widen<usize>(offs[widen<u"
    "size>(lengths[i])])] = narrow<u16>(i);\n            offs[widen<usize>(lengths[i])] += 1;\n        }\n  "
    "  }\n    Some(Huffman { .counts = counts, .symbols = symbols })\n}fn Huffman::decode(ref<Huffman, shar"
    "ed> h, ref<BitReader, exclusive> r) : Result<u16, CompressError>\n{\n    HuffStep s = huff_step(r.data"
    ", h, r.at, r.bits, r.count);\n    r.at = s.at;\n    r.bits = s.bits;\n    r.count = s.count;\n    if (s."
    "sym == -1)\n    {\n        return Err(Truncated);\n    }\n    if (s.sym < 0)\n    {\n        return Err(Co"
    "rrupt(r.at));\n    }\n    Ok(narrow<u16>(s.sym))\n}fn huff_step(slice<u8, shared> data, ref<Huffman, sh"
    "ared> h, usize at, u32 bits, u32 count) : HuffStep\n{\n    usize n = slice_len(data);\n    usize p = at"
    ";\n    u32 bb = bits;\n    u32 bc = count;\n    i32 code = 0;\n    i32 first = 0;\n    i32 index = 0;\n   "
    " for (usize len = 1; len < 16; len += 1)\n    {\n        if (bc == 0)\n        {\n            if (p >= n"
    ")\n            {\n                return HuffStep { .sym = -1, .at = p, .bits = bb, .count = bc };\n   "
    "         }\n            bb = widen<u32>(data[p]);\n            p += 1;\n            bc = 8;\n        }\n "
    "       code = code | narrow<i32>(bb & 1);\n        bb = bb >> 1;\n        bc -= 1;\n        i32 c = wid"
    "en<i32>(h.counts[len]);\n        if (code - c < first)\n        {\n            return HuffStep { .sym ="
    " widen<i32>(h.symbols[narrow<usize>(index + (code - first))]), .at = p, .bits = bb, .count = bc };\n "
    "       }\n        index += c;\n        first += c;\n        first = first << 1;\n        code = code << "
    "1;\n    }\n    HuffStep { .sym = -2, .at = p, .bits = bb, .count = bc }\n}fn bits_step(slice<u8, shared"
    "> data, usize at, u32 bits, u32 count, u32 need) : BitsStep\n{\n    usize p = at;\n    u32 bb = bits;\n "
    "   u32 bc = count;\n    while (bc < need)\n    {\n        if (p >= slice_len(data))\n        {\n         "
    "   return BitsStep { .ok = false, .v = 0, .at = p, .bits = bb, .count = bc };\n        }\n        bb ="
    " bb | (widen<u32>(data[p]) << bc);\n        p += 1;\n        bc += 8;\n    }\n    u32 v = bb & ((1: u32 "
    "<< need) - 1);\n    BitsStep { .ok = true, .v = v, .at = p, .bits = bb >> need, .count = bc - need }\n"
    "}fn fixed_codes() : Huffman\n{\n    Vec<u8> lit = Vec::filled(288, 8: u8);\n    for (usize i = 144; i <"
    " 256; i += 1)\n    {\n        lit[i] = 9;\n    }\n    for (usize i = 256; i < 280; i += 1)\n    {\n       "
    " lit[i] = 7;\n    }\n    Option::unwrap(Huffman::build(&lit[0..$]))\n}fn fixed_distances() : Huffman\n{\n"
    "    Vec<u8> d = Vec::filled(30, 5: u8);\n    Option::unwrap(Huffman::build(&d[0..$]))\n}fn inflate_cod"
    "es(\n    ref<BitReader, exclusive> r,\n    ref<Vec<u8>, exclusive> out,\n    ref<Huffman, shared> lit,\n"
    "    ref<Huffman, shared> dist,\n    usize max,\n) : Result<void, CompressError>\n{\n    Vec<u8> o = repl"
    "ace(out, Vec::new());\n    InflateRun { bytes, pos, bitbuf, nbits, status } = inflate_run(r.data, lit"
    ", dist, o, r.at, r.bits, r.count, max);\n    r.at = pos;\n    r.bits = bitbuf;\n    r.count = nbits;\n  "
    "  overwrite(out, bytes);\n    if (status == 1)\n    {\n        return Err(Truncated);\n    }\n    if (sta"
    "tus == 2)\n    {\n        return Err(Corrupt(r.at));\n    }\n    if (status == 3)\n    {\n        return E"
    "rr(Oversize);\n    }\n    Ok(())\n}fn inflate_run(\n    slice<u8, shared> data,\n    ref<Huffman, shared>"
    " lit,\n    ref<Huffman, shared> dist,\n    Vec<u8> out,\n    usize at0,\n    u32 bits0,\n    u32 count0,\n"
    "    usize max,\n) : InflateRun\n{\n    usize at = at0;\n    u32 bits = bits0;\n    u32 count = count0;\n  "
    "  u32 status = 0;\n    while (true)\n    {\n        HuffStep s = huff_step(data, lit, at, bits, count);"
    "\n        at = s.at;\n        bits = s.bits;\n        count = s.count;\n        if (s.sym < 0)\n        {"
    "\n            status = if (s.sym == -1) { 1 } else { 2 };\n            break;\n        }\n        if (s."
    "sym < 256)\n        {\n            if (Vec::len(&out) >= max)\n            {\n                status = 3"
    ";\n                break;\n            }\n            Vec::push(&mut out, narrow<u8>(s.sym));\n         "
    "   continue;\n        }\n        if (s.sym == 256)\n        {\n            break;\n        }\n        usiz"
    "e li = narrow<usize>(s.sym) - 257;\n        if (li >= 29)\n        {\n            status = 2;\n         "
    "   break;\n        }\n        BitsStep e = bits_step(data, at, bits, count, widen<u32>(LENGTH_EXTRA[li"
    "]));\n        at = e.at;\n        bits = e.bits;\n        count = e.count;\n        if (!e.ok)\n        {"
    "\n            status = 1;\n            break;\n        }\n        usize len = widen<usize>(LENGTH_BASE[l"
    "i]) + narrow<usize>(e.v);\n        HuffStep d = huff_step(data, dist, at, bits, count);\n        at = "
    "d.at;\n        bits = d.bits;\n        count = d.count;\n        if (d.sym < 0)\n        {\n            s"
    "tatus = if (d.sym == -1) { 1 } else { 2 };\n            break;\n        }\n        usize di = narrow<us"
    "ize>(d.sym);\n        if (di >= 30)\n        {\n            status = 2;\n            break;\n        }\n  "
    "      BitsStep f = bits_step(data, at, bits, count, widen<u32>(DIST_EXTRA[di]));\n        at = f.at;\n"
    "        bits = f.bits;\n        count = f.count;\n        if (!f.ok)\n        {\n            status = 1;"
    "\n            break;\n        }\n        usize distance = widen<usize>(DIST_BASE[di]) + narrow<usize>(f"
    ".v);\n        if (distance > Vec::len(&out))\n        {\n            status = 2;\n            break;\n   "
    "     }\n        if (Vec::len(&out) + len > max)\n        {\n            status = 3;\n            break;\n"
    "        }\n        usize from = Vec::len(&out) - distance;\n        for (usize k = 0; k < len; k += 1)"
    "\n        {\n            u8 b = out[from + k];\n            Vec::push(&mut out, b);\n        }\n    }\n   "
    " InflateRun { .bytes = out, .pos = at, .bitbuf = bits, .nbits = count, .status = status }\n}fn read_d"
    "ynamic(\n    ref<BitReader, exclusive> r,\n    ref<Option<Huffman>, exclusive> lit,\n    ref<Option<Huf"
    "fman>, exclusive> dist,\n) : Result<void, CompressError>\n{\n    usize nlen = narrow<usize>(BitReader::"
    "take(r, 5)?) + 257;\n    usize ndist = narrow<usize>(BitReader::take(r, 5)?) + 1;\n    usize ncode = n"
    "arrow<usize>(BitReader::take(r, 4)?) + 4;\n    if (nlen > 286 || ndist > 30)\n    {\n        return Err"
    "(Corrupt(r.at));\n    }\n    Vec<u8> clens = Vec::filled(19, 0: u8);\n    for (usize i = 0; i < ncode; "
    "i += 1)\n    {\n        clens[widen<usize>(CLEN_ORDER[i])] = narrow<u8>(BitReader::take(r, 3)?);\n    }"
    "\n    Huffman ccode = match (Huffman::build(&clens[0..$]))\n    {\n        Some(h) : h,\n        None   "
    " : return Err(Corrupt(r.at)),\n    };\n    Vec<u8> lengths = Vec::new();\n    while (Vec::len(&lengths)"
    " < nlen + ndist)\n    {\n        u16 sym = Huffman::decode(&ccode, r)?;\n        if (sym < 16)\n        "
    "{\n            Vec::push(&mut lengths, narrow<u8>(sym));\n            continue;\n        }\n        u8 v"
    "alue = 0;\n        usize repeat = 0;\n        if (sym == 16)\n        {\n            if (Vec::len(&lengt"
    "hs) == 0)\n            {\n                return Err(Corrupt(r.at));\n            }\n            value ="
    " lengths[Vec::len(&lengths) - 1];\n            repeat = 3 + narrow<usize>(BitReader::take(r, 2)?);\n  "
    "      }\n        else if (sym == 17)\n        {\n            repeat = 3 + narrow<usize>(BitReader::take"
    "(r, 3)?);\n        }\n        else\n        {\n            repeat = 11 + narrow<usize>(BitReader::take(r"
    ", 7)?);\n        }\n        if (Vec::len(&lengths) + repeat > nlen + ndist)\n        {\n            retu"
    "rn Err(Corrupt(r.at));\n        }\n        for (usize k = 0; k < repeat; k += 1)\n        {\n           "
    " Vec::push(&mut lengths, value);\n        }\n    }\n    if (lengths[256] == 0)\n    {\n        return Err"
    "(Corrupt(r.at));\n    }\n    match (Huffman::build(&lengths[0..nlen]))\n    {\n        Some(h) : overwri"
    "te(lit, Some(h)),\n        None    : return Err(Corrupt(r.at)),\n    }\n    match (Huffman::build(&leng"
    "ths[nlen..nlen + ndist]))\n    {\n        Some(h) : overwrite(dist, Some(h)),\n        None    : return"
    " Err(Corrupt(r.at)),\n    }\n    Ok(())\n}fn inflate_from(\n    slice<u8, shared> data,\n    usize start,"
    "\n    ref<Vec<u8>, exclusive> out,\n    usize max,\n) : Result<usize, CompressError>\n{\n    BitReader r "
    "= BitReader { .data = data, .at = start, .bits = 0, .count = 0 };\n    Huffman fixed_lit = fixed_code"
    "s();\n    Huffman fixed_dist = fixed_distances();\n    while (true)\n    {\n        u32 last = BitReader"
    "::take(&mut r, 1)?;\n        u32 kind = BitReader::take(&mut r, 2)?;\n        if (kind == 0)\n        {"
    "\n            BitReader::align(&mut r);\n            if (r.at + 4 > slice_len(data))\n            {\n   "
    "             return Err(Truncated);\n            }\n            usize len = widen<usize>(read_le<u16>("
    "data, r.at));\n            usize nlen = widen<usize>(read_le<u16>(data, r.at + 2));\n            if (l"
    "en != (nlen ^ 0xFFFF))\n            {\n                return Err(Corrupt(r.at));\n            }\n      "
    "      r.at += 4;\n            if (r.at + len > slice_len(data))\n            {\n                return "
    "Err(Truncated);\n            }\n            if (Vec::len(out) + len > max)\n            {\n             "
    "   return Err(Oversize);\n            }\n            Vec::extend_from(out, &data[r.at..r.at + len]);\n "
    "           r.at += len;\n        }\n        else if (kind == 1)\n        {\n            inflate_codes(&m"
    "ut r, out, &fixed_lit, &fixed_dist, max)?;\n        }\n        else if (kind == 2)\n        {\n         "
    "   Option<Huffman> lit = None;\n            Option<Huffman> dist = None;\n            read_dynamic(&mu"
    "t r, &mut lit, &mut dist)?;\n            inflate_codes(&mut r, out, &Option::unwrap(lit), &Option::un"
    "wrap(dist), max)?;\n        }\n        else\n        {\n            return Err(Corrupt(r.at));\n        }"
    "\n        if (last == 1)\n        {\n            // The bits left in the reader's buffer belong to no b"
    "lock; the\n            // position after the block is the next whole byte.\n            return Ok(r.at"
    ");\n        }\n    }\n}export fn inflate(slice<u8, shared> data, usize max) : Result<Vec<u8>, CompressE"
    "rror>\n{\n    Vec<u8> out = Vec::new();\n    inflate_from(data, 0, &mut out, max)?;\n    Ok(out)\n}fn Bit"
    "Writer::put(ref<BitWriter, exclusive> w, u32 value, u32 n)\n{\n    w.bits = w.bits | (widen<u64>(value"
    ") << w.count);\n    w.count += n;\n    while (w.count >= 8)\n    {\n        Vec::push(&mut w.out, narrow"
    "_wrapping<u8>(w.bits));\n        w.bits = w.bits >> 8;\n        w.count -= 8;\n    }\n}fn BitWriter::put"
    "_code(ref<BitWriter, exclusive> w, u32 code, u32 len)\n{\n    u32 rev = 0;\n    for (u32 i = 0; i < len"
    "; i += 1)\n    {\n        rev = (rev << 1) | ((code >> i) & 1);\n    }\n    BitWriter::put(w, rev, len);"
    "\n}fn BitWriter::flush(ref<BitWriter, exclusive> w)\n{\n    if (w.count > 0)\n    {\n        Vec::push(&m"
    "ut w.out, narrow_wrapping<u8>(w.bits));\n        w.bits = 0;\n        w.count = 0;\n    }\n}fn code_leng"
    "ths(slice<u32, shared> freq, usize limit) : Vec<u8>\n{\n    usize n = slice_len(freq);\n    Vec<u8> len"
    "gths = Vec::filled(n, 0: u8);\n    Vec<u32> f = Vec::from_slice(freq);\n    usize used = 0;\n    for (u"
    "size i = 0; i < n; i += 1)\n    {\n        if (f[i] > 0)\n        {\n            used += 1;\n        }\n  "
    "  }\n    if (used == 0)\n    {\n        return lengths;\n    }\n    if (used == 1)\n    {\n        for (usi"
    "ze i = 0; i < n; i += 1)\n        {\n            if (f[i] > 0)\n            {\n                lengths[i"
    "] = 1;\n            }\n        }\n        return lengths;\n    }\n    while (true)\n    {\n        // Nodes"
    " 0..n are the symbols, n.. the merges; each node's weight,\n        // parent and depth.\n        Vec<"
    "u64> weight = Vec::new();\n        Vec<usize> parent = Vec::new();\n        Vec<bool> alive = Vec::new"
    "();\n        for (usize i = 0; i < n; i += 1)\n        {\n            Vec::push(&mut weight, widen<u64>"
    "(f[i]));\n            Vec::push(&mut parent, 0);\n            Vec::push(&mut alive, f[i] > 0);\n       "
    " }\n        usize live = used;\n        while (live > 1)\n        {\n            usize a = n * 2;\n      "
    "      usize b = n * 2;\n            for (usize i = 0; i < Vec::len(&weight); i += 1)\n            {\n  "
    "              if (!alive[i])\n                {\n                    continue;\n                }\n     "
    "           if (a == n * 2 || weight[i] < weight[a])\n                {\n                    b = a;\n   "
    "                 a = i;\n                }\n                else if (b == n * 2 || weight[i] < weight["
    "b])\n                {\n                    b = i;\n                }\n            }\n            usize m"
    " = Vec::len(&weight);\n            Vec::push(&mut weight, weight[a] + weight[b]);\n            Vec::pu"
    "sh(&mut parent, 0);\n            Vec::push(&mut alive, true);\n            alive[a] = false;\n         "
    "   alive[b] = false;\n            parent[a] = m;\n            parent[b] = m;\n            live -= 1;\n  "
    "      }\n        usize root = Vec::len(&weight) - 1;\n        usize deepest = 0;\n        for (usize i "
    "= 0; i < n; i += 1)\n        {\n            if (f[i] == 0)\n            {\n                continue;\n   "
    "         }\n            usize d = 0;\n            usize at = i;\n            while (at != root)\n       "
    "     {\n                at = parent[at];\n                d += 1;\n            }\n            lengths[i]"
    " = narrow<u8>(d);\n            if (d > deepest)\n            {\n                deepest = d;\n          "
    "  }\n        }\n        if (deepest <= limit)\n        {\n            return lengths;\n        }\n        "
    "for (usize i = 0; i < n; i += 1)\n        {\n            if (f[i] > 0)\n            {\n                f"
    "[i] = (f[i] >> 1) | 1;\n            }\n        }\n    }\n}fn canonical_codes(slice<u8, shared> lengths) "
    ": Vec<u32>\n{\n    array<u32, 16> count = [0; 16];\n    for (usize i = 0; i < slice_len(lengths); i += "
    "1)\n    {\n        count[widen<usize>(lengths[i])] += 1;\n    }\n    count[0] = 0;\n    array<u32, 16> ne"
    "xt = [0; 16];\n    u32 code = 0;\n    for (usize len = 1; len < 16; len += 1)\n    {\n        code = (co"
    "de + count[len - 1]) << 1;\n        next[len] = code;\n    }\n    Vec<u32> codes = Vec::filled(slice_le"
    "n(lengths), 0: u32);\n    for (usize i = 0; i < slice_len(lengths); i += 1)\n    {\n        usize l = w"
    "iden<usize>(lengths[i]);\n        if (l != 0)\n        {\n            codes[i] = next[l];\n            n"
    "ext[l] += 1;\n        }\n    }\n    codes\n}fn length_code(usize len) : usize\n{\n    usize c = 28;\n    fo"
    "r (usize i = 0; i < 28; i += 1)\n    {\n        if (len < widen<usize>(LENGTH_BASE[i + 1]))\n        {\n"
    "            c = i;\n            break;\n        }\n    }\n    c\n}fn distance_code(usize d) : usize\n{\n   "
    " usize c = 29;\n    for (usize i = 0; i < 29; i += 1)\n    {\n        if (d < widen<usize>(DIST_BASE[i "
    "+ 1]))\n        {\n            c = i;\n            break;\n        }\n    }\n    c\n}fn hash3(slice<u8, sha"
    "red> d, usize i) : usize\n{\n    ((widen<usize>(d[i]) << 10) ^ (widen<usize>(d[i + 1]) << 5) ^ widen<u"
    "size>(d[i + 2])) & (HASH_SIZE - 1)\n}fn token_counts(slice<Token, shared> tokens) : TokenCounts\n{\n   "
    " array<u32, 286> lit = [0; 286];\n    array<u32, 30> dist = [0; 30];\n    u64 extra = 0;\n    for (usiz"
    "e k = 0; k < slice_len(tokens); k += 1)\n    {\n        u16 l = tokens[k].lit;\n        lit[widen<usize"
    ">(l)] += 1;\n        if (l >= 256)\n        {\n            dist[widen<usize>(tokens[k].dist_code)] += 1"
    ";\n            extra += widen<u64>(tokens[k].len_extra_bits) + widen<u64>(tokens[k].dist_extra_bits);"
    "\n        }\n    }\n    TokenCounts { .lit = lit, .dist = dist, .extra = extra }\n}fn write_block(ref<Bi"
    "tWriter, exclusive> w, slice<Token, shared> tokens, slice<u8, shared> raw, bool last)\n{\n    // Frequ"
    "encies, with the end-of-block symbol.\n    TokenCounts counts = token_counts(tokens);\n    Vec<u32> lf"
    " = Vec::from_slice(&counts.lit[0..$]);\n    Vec<u32> df = Vec::from_slice(&counts.dist[0..$]);\n    lf"
    "[256] += 1;\n    Vec<u8> ll = code_lengths(&lf[0..$], 15);\n    Vec<u8> dl = code_lengths(&df[0..$], 1"
    "5);\n    // The fixed code's lengths, for its cost.\n    Vec<u8> fl = Vec::filled(288, 8: u8);\n    for"
    " (usize i = 144; i < 256; i += 1)\n    {\n        fl[i] = 9;\n    }\n    for (usize i = 256; i < 280; i "
    "+= 1)\n    {\n        fl[i] = 7;\n    }\n    u64 extra = counts.extra;\n    u64 cost_fixed = extra;\n    u"
    "64 cost_dyn = extra;\n    for (usize i = 0; i < 286; i += 1)\n    {\n        cost_fixed += widen<u64>(l"
    "f[i]) * widen<u64>(fl[i]);\n        cost_dyn += widen<u64>(lf[i]) * widen<u64>(ll[i]);\n    }\n    for "
    "(usize i = 0; i < 30; i += 1)\n    {\n        cost_fixed += widen<u64>(df[i]) * 5;\n        cost_dyn +="
    " widen<u64>(df[i]) * widen<u64>(dl[i]);\n    }\n    // The dynamic header: the code lengths run-length"
    " coded.\n    usize nlen = 286;\n    while (nlen > 257 && ll[nlen - 1] == 0)\n    {\n        nlen -= 1;\n "
    "   }\n    usize ndist = 30;\n    while (ndist > 1 && dl[ndist - 1] == 0)\n    {\n        ndist -= 1;\n   "
    " }\n    Vec<u8> all = Vec::new();\n    Vec::extend_from(&mut all, &ll[0..nlen]);\n    Vec::extend_from("
    "&mut all, &dl[0..ndist]);\n    // Run-length symbols: (symbol, extra value, extra bits).\n    Vec<u8> "
    "rl_sym = Vec::new();\n    Vec<u8> rl_val = Vec::new();\n    Vec<u8> rl_bits = Vec::new();\n    usize i "
    "= 0;\n    while (i < Vec::len(&all))\n    {\n        u8 v = all[i];\n        usize run = 1;\n        whil"
    "e (i + run < Vec::len(&all) && all[i + run] == v)\n        {\n            run += 1;\n        }\n        "
    "if (v == 0 && run >= 3)\n        {\n            usize r = if (run > 138) { 138 } else { run };\n       "
    "     if (r <= 10)\n            {\n                Vec::push(&mut rl_sym, 17);\n                Vec::pus"
    "h(&mut rl_val, narrow<u8>(r - 3));\n                Vec::push(&mut rl_bits, 3);\n            }\n       "
    "     else\n            {\n                Vec::push(&mut rl_sym, 18);\n                Vec::push(&mut r"
    "l_val, narrow<u8>(r - 11));\n                Vec::push(&mut rl_bits, 7);\n            }\n            i "
    "+= r;\n        }\n        else if (v != 0 && run >= 4)\n        {\n            Vec::push(&mut rl_sym, v)"
    ";\n            Vec::push(&mut rl_val, 0);\n            Vec::push(&mut rl_bits, 0);\n            usize r"
    " = if (run - 1 > 6) { 6 } else { run - 1 };\n            Vec::push(&mut rl_sym, 16);\n            Vec:"
    ":push(&mut rl_val, narrow<u8>(r - 3));\n            Vec::push(&mut rl_bits, 2);\n            i += 1 + "
    "r;\n        }\n        else\n        {\n            Vec::push(&mut rl_sym, v);\n            Vec::push(&mu"
    "t rl_val, 0);\n            Vec::push(&mut rl_bits, 0);\n            i += 1;\n        }\n    }\n    Vec<u3"
    "2> cf = Vec::filled(19, 0: u32);\n    foreach (s in &rl_sym)\n    {\n        cf[widen<usize>(*s)] += 1;"
    "\n    }\n    Vec<u8> cl = code_lengths(&cf[0..$], 7);\n    usize ncode = 19;\n    while (ncode > 4 && cl"
    "[widen<usize>(CLEN_ORDER[ncode - 1])] == 0)\n    {\n        ncode -= 1;\n    }\n    cost_dyn += 14 + wid"
    "en<u64>(ncode) * 3;\n    for (usize k = 0; k < Vec::len(&rl_sym); k += 1)\n    {\n        cost_dyn += w"
    "iden<u64>(cl[widen<usize>(rl_sym[k])]) + widen<u64>(rl_bits[k]);\n    }\n    u64 cost_stored = widen<u"
    "64>(slice_len(raw)) * 8 + 40 * (widen<u64>(slice_len(raw)) / 65535 + 1);\n    if (cost_stored <= cost"
    "_fixed && cost_stored <= cost_dyn)\n    {\n        // Stored blocks of at most 65535 bytes, the last m"
    "arked.\n        usize at = 0;\n        while (true)\n        {\n            usize take = if (slice_len(r"
    "aw) - at > 65535) { 65535 } else { slice_len(raw) - at };\n            bool final = last && at + take"
    " == slice_len(raw);\n            BitWriter::put(w, if (final) { 1 } else { 0 }, 1);\n            BitWr"
    "iter::put(w, 0, 2);\n            BitWriter::flush(w);\n            Vec::push_le(&mut w.out, narrow<u16"
    ">(take));\n            Vec::push_le(&mut w.out, narrow<u16>(take ^ 0xFFFF));\n            Vec::extend_"
    "from(&mut w.out, &raw[at..at + take]);\n            at += take;\n            if (at >= slice_len(raw))"
    "\n            {\n                return;\n            }\n        }\n    }\n    BitWriter::put(w, if (last)"
    " { 1 } else { 0 }, 1);\n    Vec<u32> lcodes = Vec::new();\n    Vec<u8> llens = Vec::new();\n    Vec<u32"
    "> dcodes = Vec::new();\n    Vec<u8> dlens = Vec::new();\n    if (cost_fixed <= cost_dyn)\n    {\n       "
    " BitWriter::put(w, 1, 2);\n        overwrite(&mut lcodes, canonical_codes(&fl[0..$]));\n        overwr"
    "ite(&mut llens, fl);\n        Vec<u8> fd = Vec::filled(30, 5: u8);\n        overwrite(&mut dcodes, can"
    "onical_codes(&fd[0..$]));\n        overwrite(&mut dlens, fd);\n    }\n    else\n    {\n        BitWriter:"
    ":put(w, 2, 2);\n        BitWriter::put(w, narrow<u32>(nlen - 257), 5);\n        BitWriter::put(w, narr"
    "ow<u32>(ndist - 1), 5);\n        BitWriter::put(w, narrow<u32>(ncode - 4), 4);\n        for (usize k ="
    " 0; k < ncode; k += 1)\n        {\n            BitWriter::put(w, widen<u32>(cl[widen<usize>(CLEN_ORDER"
    "[k])]), 3);\n        }\n        Vec<u32> ccodes = canonical_codes(&cl[0..$]);\n        for (usize k = 0"
    "; k < Vec::len(&rl_sym); k += 1)\n        {\n            usize s = widen<usize>(rl_sym[k]);\n          "
    "  BitWriter::put_code(w, ccodes[s], widen<u32>(cl[s]));\n            if (rl_bits[k] > 0)\n            "
    "{\n                BitWriter::put(w, widen<u32>(rl_val[k]), widen<u32>(rl_bits[k]));\n            }\n  "
    "      }\n        overwrite(&mut lcodes, canonical_codes(&ll[0..$]));\n        overwrite(&mut llens, ll"
    ");\n        overwrite(&mut dcodes, canonical_codes(&dl[0..$]));\n        overwrite(&mut dlens, dl);\n  "
    "  }\n    Vec<u8> o = replace(&mut w.out, Vec::new());\n    BitOut { buf, acc, nacc } = put_tokens(\n   "
    "     o,\n        w.bits,\n        w.count,\n        tokens,\n        &lcodes[0..$],\n        &llens[0..$]"
    ",\n        &dcodes[0..$],\n        &dlens[0..$],\n    );\n    overwrite(&mut w.out, buf);\n    w.bits = a"
    "cc;\n    w.count = nacc;\n}fn put_tokens(\n    Vec<u8> out,\n    u64 bits0,\n    u32 count0,\n    slice<To"
    "ken, shared> tokens,\n    slice<u32, shared> lcodes,\n    slice<u8, shared> llens,\n    slice<u32, shar"
    "ed> dcodes,\n    slice<u8, shared> dlens,\n) : BitOut\n{\n    u64 bits = bits0;\n    u32 count = count0;\n"
    "    usize nt = slice_len(tokens);\n    for (usize k = 0; k <= nt; k += 1)\n    {\n        // Up to four"
    " fields per token: its code (or, after the last, the\n        // end code), then for a match the leng"
    "th's extra bits, the\n        // distance's code and its extra bits. A code goes most\n        // sign"
    "ificant bit first: reversed.\n        usize s = if (k < nt) { widen<usize>(tokens[k].lit) } else { 25"
    "6 };\n        for (usize f = 0; f < 4; f += 1)\n        {\n            u32 v = 0;\n            u32 n = 0"
    ";\n            if (f == 0)\n            {\n                u32 code = lcodes[s];\n                n = wi"
    "den<u32>(llens[s]);\n                for (u32 i = 0; i < n; i += 1)\n                {\n               "
    "     v = (v << 1) | ((code >> i) & 1);\n                }\n            }\n            else if (s >= 257"
    ")\n            {\n                if (f == 1)\n                {\n                    v = widen<u32>(tok"
    "ens[k].len_extra);\n                    n = widen<u32>(tokens[k].len_extra_bits);\n                }\n "
    "               else if (f == 2)\n                {\n                    usize d = widen<usize>(tokens["
    "k].dist_code);\n                    u32 code = dcodes[d];\n                    n = widen<u32>(dlens[d]"
    ");\n                    for (u32 i = 0; i < n; i += 1)\n                    {\n                        "
    "v = (v << 1) | ((code >> i) & 1);\n                    }\n                }\n                else\n     "
    "           {\n                    v = widen<u32>(tokens[k].dist_extra);\n                    n = widen"
    "<u32>(tokens[k].dist_extra_bits);\n                }\n            }\n            if (n == 0)\n          "
    "  {\n                continue;\n            }\n            bits = bits | (widen<u64>(v) << count);\n    "
    "        count += n;\n            while (count >= 8)\n            {\n                Vec::push(&mut out,"
    " narrow_wrapping<u8>(bits));\n                bits = bits >> 8;\n                count -= 8;\n         "
    "   }\n        }\n    }\n    BitOut { .buf = out, .acc = bits, .nacc = count }\n}fn deflate_scan(slice<u8"
    ", shared> data, Vec<usize> head, Vec<usize> prev, Vec<Token> tokens, usize start) : DeflateScan\n{\n  "
    "  usize n = slice_len(data);\n    usize i = start;\n    while (i < n && Vec::len(&tokens) < MAX_TOKENS"
    ")\n    {\n        usize best_len = 0;\n        usize best_dist = 0;\n        if (i + 3 <= n)\n        {\n "
    "           usize h = ((widen<usize>(data[i]) << 10) ^ (widen<usize>(data[i + 1]) << 5) ^ widen<usize"
    ">(data[i + 2])) & (HASH_SIZE - 1);\n            usize cand = head[h];\n            usize chain = 0;\n  "
    "          usize limit = if (n - i > 258) { 258 } else { n - i };\n            while (cand != max_valu"
    "e<usize>() && i - cand <= WINDOW && chain < CHAIN_LIMIT)\n            {\n                if (data[cand"
    " + best_len] == data[i + best_len])\n                {\n                    usize l = 0;\n             "
    "       while (l < limit && data[cand + l] == data[i + l])\n                    {\n                    "
    "    l += 1;\n                    }\n                    if (l > best_len)\n                    {\n      "
    "                  best_len = l;\n                        best_dist = i - cand;\n                      "
    "  if (l == limit)\n                        {\n                            break;\n                     "
    "   }\n                    }\n                }\n                usize next = prev[cand & (WINDOW - 1)];"
    "\n                if (next == max_value<usize>() || next >= cand)\n                {\n                 "
    "   break;\n                }\n                cand = next;\n                chain += 1;\n            }\n "
    "           prev[i & (WINDOW - 1)] = head[h];\n            head[h] = i;\n        }\n        if (best_len"
    " >= 3)\n        {\n            usize lc = length_code(best_len);\n            usize dc = distance_code("
    "best_dist);\n            Vec::push(&mut tokens, Token {\n                .lit = narrow<u16>(257 + lc),"
    "\n                .len_extra = narrow<u16>(best_len - widen<usize>(LENGTH_BASE[lc])),\n               "
    " .len_extra_bits = LENGTH_EXTRA[lc],\n                .dist_code = narrow<u8>(dc),\n                .d"
    "ist_extra = narrow<u16>(best_dist - widen<usize>(DIST_BASE[dc])),\n                .dist_extra_bits ="
    " DIST_EXTRA[dc],\n            });\n            // The bytes inside the match enter the hash chains too"
    ".\n            for (usize k = 1; k < best_len; k += 1)\n            {\n                if (i + k + 3 <="
    " n)\n                {\n                    usize h = ((widen<usize>(data[i + k]) << 10) ^ (widen<usiz"
    "e>(data[i + k + 1]) << 5) ^ widen<usize>(data[i + k + 2])) & (HASH_SIZE - 1);\n                    pr"
    "ev[(i + k) & (WINDOW - 1)] = head[h];\n                    head[h] = i + k;\n                }\n       "
    "     }\n            i += best_len;\n        }\n        else\n        {\n            Vec::push(\n          "
    "      &mut tokens,\n                Token { .lit = widen<u16>(data[i]), .len_extra = 0, .len_extra_bi"
    "ts = 0, .dist_code = 0, .dist_extra = 0, .dist_extra_bits = 0 },\n            );\n            i += 1;\n"
    "        }\n    }\n    DeflateScan { .head = head, .prev = prev, .tokens = tokens, .end = i }\n}export f"
    "n deflate(slice<u8, shared> data) : Vec<u8>\n{\n    BitWriter w = BitWriter { .out = Vec::new(), .bits"
    " = 0, .count = 0 };\n    usize n = slice_len(data);\n    if (n == 0)\n    {\n        // One empty fixed "
    "block.\n        BitWriter::put(&mut w, 1, 1);\n        BitWriter::put(&mut w, 1, 2);\n        BitWriter"
    "::put(&mut w, 0, 7);\n        BitWriter::flush(&mut w);\n        BitWriter { out, bits, count } = w;\n "
    "       return out;\n    }\n    Vec<usize> heads = Vec::filled(HASH_SIZE, max_value<usize>());\n    Vec<"
    "usize> chains = Vec::filled(WINDOW, max_value<usize>());\n    DeflateScan s = DeflateScan { .head = h"
    "eads, .prev = chains, .tokens = Vec::new(), .end = 0 };\n    while (s.end < n)\n    {\n        usize bl"
    "ock_start = s.end;\n        DeflateScan { head, prev, tokens, end } = s;\n        s = deflate_scan(dat"
    "a, head, prev, tokens, end);\n        write_block(&mut w, &s.tokens[0..$], &data[block_start..s.end],"
    " s.end >= n);\n        Vec::clear(&mut s.tokens);\n    }\n    BitWriter::flush(&mut w);\n    BitWriter {"
    " out, bits, count } = w;\n    out\n}export fn adler32(slice<u8, shared> data) : u32\n{\n    u32 a = 1;\n "
    "   u32 b = 0;\n    usize i = 0;\n    usize n = slice_len(data);\n    while (i < n)\n    {\n        // 555"
    "2 bytes at a time fit the sums in a `u32` before reducing.\n        usize end = if (n - i > 5552) { i"
    " + 5552 } else { n };\n        while (i < end)\n        {\n            a += widen<u32>(data[i]);\n      "
    "      b += a;\n            i += 1;\n        }\n        a = a % 65521;\n        b = b % 65521;\n    }\n    "
    "(b << 16) | a\n}export fn zlib_deflate(slice<u8, shared> data) : Vec<u8>\n{\n    Vec<u8> out = Vec::new"
    "();\n    Vec::push(&mut out, 0x78);\n    Vec::push(&mut out, 0x9C);\n    Vec::append(&mut out, deflate("
    "data));\n    Vec::push_be(&mut out, adler32(data));\n    out\n}export fn zlib_inflate(slice<u8, shared>"
    " data, usize max) : Result<Vec<u8>, CompressError>\n{\n    if (slice_len(data) < 6)\n    {\n        retu"
    "rn Err(Truncated);\n    }\n    u8 cmf = data[0];\n    u8 flg = data[1];\n    if ((cmf & 0x0F) != 8 || (w"
    "iden<u32>(cmf) * 256 + widen<u32>(flg)) % 31 != 0 || (flg & 0x20) != 0)\n    {\n        return Err(Cor"
    "rupt(0));\n    }\n    Vec<u8> out = Vec::new();\n    usize end = inflate_from(data, 2, &mut out, max)?;"
    "\n    if (end + 4 > slice_len(data))\n    {\n        return Err(Truncated);\n    }\n    if (read_be<u32>("
    "data, end) != adler32(&out[0..$]))\n    {\n        return Err(Corrupt(end));\n    }\n    Ok(out)\n}export"
    " fn gzip(slice<u8, shared> data) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n    array<u8, 10> header "
    "= [0x1F, 0x8B, 8, 0, 0, 0, 0, 0, 0, 255];\n    Vec::extend_from(&mut out, &header[0..$]);\n    Vec::ap"
    "pend(&mut out, deflate(data));\n    Vec::push_le(&mut out, crc32(data));\n    Vec::push_le(&mut out, n"
    "arrow_wrapping<u32>(slice_len(data)));\n    out\n}export fn gunzip(slice<u8, shared> data, usize max) "
    ": Result<Vec<u8>, CompressError>\n{\n    Vec<u8> out = Vec::new();\n    usize at = 0;\n    usize n = sli"
    "ce_len(data);\n    while (true)\n    {\n        if (at + 10 > n)\n        {\n            return Err(Trunc"
    "ated);\n        }\n        if (data[at] != 0x1F || data[at + 1] != 0x8B || data[at + 2] != 8)\n        "
    "{\n            return Err(Corrupt(at));\n        }\n        u8 flags = data[at + 3];\n        usize p = "
    "at + 10;\n        if ((flags & 4) != 0)\n        {\n            if (p + 2 > n)\n            {\n          "
    "      return Err(Truncated);\n            }\n            p += 2 + widen<usize>(read_le<u16>(data, p));"
    "\n        }\n        if ((flags & 8) != 0)\n        {\n            while (p < n && data[p] != 0)\n       "
    "     {\n                p += 1;\n            }\n            p += 1;\n        }\n        if ((flags & 16) "
    "!= 0)\n        {\n            while (p < n && data[p] != 0)\n            {\n                p += 1;\n    "
    "        }\n            p += 1;\n        }\n        if ((flags & 2) != 0)\n        {\n            p += 2;\n"
    "        }\n        if (p > n)\n        {\n            return Err(Truncated);\n        }\n        usize be"
    "fore = Vec::len(&out);\n        usize end = inflate_from(data, p, &mut out, max)?;\n        if (end + "
    "8 > n)\n        {\n            return Err(Truncated);\n        }\n        if (read_le<u32>(\n            "
    "data,\n            end,\n        ) != crc32(&out[before..$]) || read_le<u32>(data, end + 4) != narrow_"
    "wrapping<u32>(Vec::len(&out) - before))\n        {\n            return Err(Corrupt(end));\n        }\n  "
    "      at = end + 8;\n        if (at >= n)\n        {\n            return Ok(out);\n        }\n    }\n}expo"
    "rt fn NulError::text(ref<NulError, shared> e) : str\n{\n    \"holds a NUL byte\"\n}export fn CString::fro"
    "m_bytes(slice<u8, shared> b) : Result<CString, NulError>\n{\n    usize n = slice_len(b);\n    Vec<u8> b"
    "ytes = Vec::new();\n    Vec::reserve(&mut bytes, n + 1);\n    for (usize i = 0; i < n; i += 1)\n    {\n "
    "       if (b[i] == 0)\n        {\n            return Err(NulError { .offset = i });\n        }\n        "
    "Vec::push(&mut bytes, b[i]);\n    }\n    Vec::push(&mut bytes, 0);\n    Ok(CString { .bytes = bytes })\n"
    "}export fn CString::new(StringView s) : Result<CString, NulError>\n{\n    CString::from_bytes(StringVi"
    "ew::as_bytes(s))\n}export fn CString::ptr(ref<CString, shared> c) : rawptr<u8>\n{\n    rawptr_of(&c.byt"
    "es[0])\n}export fn CString::len(ref<CString, shared> c) : usize\n{\n    Vec::len(&c.bytes) - 1\n}export "
    "fn CString::as_bytes(ref<CString, shared> c) : slice<u8, shared>\n{\n    &c.bytes[0 .. Vec::len(&c.byt"
    "es) - 1]\n}export fn copy_to_raw<T: plain>(slice<T, shared> s, rawptr<T> p)\n{\n    usize n = slice_len"
    "(s);\n    if (n == 0)\n    {\n        return;\n    }\n    if (p == null_rawptr<T>())\n    {\n        fault("
    "null_pointer);\n    }\n    // trusted: [Copy-Raw] of the slice's n * sizeof<T>() bytes (readable: the "
    "slice's own path covers them) to `p`, the caller's assertion in its `unsafe` that `p` has room for t"
    "hem and that no live object's cells lie there (a [Trusted-Call], spec/20 §1); T is `plain`, so the "
    "bytes are the elements.\n    unsafe\n    {\n        copy_raw(reinterpret_ptr<u8>(p), reinterpret_ptr<u8"
    ">(rawptr_of(&s[0])), n * sizeof<T>());\n    }\n}export fn is_null<T>(rawptr<T> p) : bool\n{\n    p == nu"
    "ll_rawptr<T>()\n}";
