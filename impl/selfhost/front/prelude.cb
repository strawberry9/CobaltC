    " {\n            Ok(Ed25519Key(k)) : assert(k[0] == 0x42 && k[31] == 0x42),\n            _             "
    "    : assert(false),\n        }\n\u{1f}\u{1e}std::x509\u{1f}EcPrivateKey\u{1f}struct\u{1f}export struct EcPrivateKey\u{1f}An ellipti"
