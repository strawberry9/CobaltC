    " not a place to cut a character in two (found by the hostile-input\n    // round, D-0211).\n    for (u"
    "size i = 0; i < 13 && i < StringView::len(line); i += 1)\n    {\n        if (line.bytes[i] >= 128)\n   "
    "     {\n            return Err(BadMessage);\n        }\n    }\n    u16 status = match (StringView::parse"
    "<u16>(&line[9..12]))\n    {\n        Ok(v)  : v,\n        Err(_) : return Err(BadMessage),\n    };\n    i"
    "f (status < 100 || status > 599)\n    {\n        return Err(BadMessage);\n    }\n    String reason = if "
    "(StringView::len(line) > 13)\n    {\n        String::from_view(&line[13..$])\n    }\n    else { String::"
    "new() };\n    Ok(StatusLine { .status = status, .reason = reason })\n}fn origin_of(ref<Url, shared> u)"
    " : String\n{\n    String o = String::clone(&u.scheme);\n    String::append(&mut o, \"://\");\n    String::"
    "append(&mut o, &host_text(u));\n    o\n}fn idempotent(StringView method) : bool\n{\n    method == \"GET\" "
    "|| method == \"HEAD\" || method == \"PUT\" || method == \"DELETE\" || method == \"OPTIONS\" || method == \"TR"
    "ACE\"\n}fn exchange(\n    ref<HttpClient, exclusive> c,\n    ref<Request, shared> req,\n    ref<Url, shar"
    "ed> u,\n    StringView method,\n    slice<u8, shared> body,\n    bool with_content,\n    bool credential"
    "s,\n) : Result<Response, HttpError>\n{\n    String want = origin_of(u);\n    if (Some(ic) = replace(&mut"
    " c.idle, None))\n    {\n        IdleConn { origin, r } = ic;\n        if (origin == want)\n        {\n   "
    "         if (Some(resp) = exchange_on(c, r, true, req, u, method, body, with_content, credentials)?)"
    "\n            {\n                return Ok(resp);\n            }\n            // Closed with nothing ans"
    "wered: the server may still have\n            // acted on the request, so only an idempotent one is s"
    "ent\n            // again (RFC 9110 §9.2.2) -- a POST twice could do twice what\n            // it as"
    "ks.\n            if (!idempotent(method))\n            {\n                return Err(ConnectionClosed);"
    "\n            }\n        }\n        else\n        {\n            conn_close(&mut r.conn);\n        }\n    }"
    "\n    Reader fresh = Reader { .conn = open_connection(c, u)?, .buf = Vec::new(), .at = 0 };\n    match"
    " (exchange_on(c, fresh, false, req, u, method, body, with_content, credentials)?)\n    {\n        Some"
    "(resp) : Ok(resp),\n        None       : Err(ConnectionClosed),\n    }\n}fn exchange_on(\n    ref<HttpCl"
    "ient, exclusive> c,\n    Reader r,\n    bool reused,\n    ref<Request, shared> req,\n    ref<Url, shared"
    "> u,\n    StringView method,\n    slice<u8, shared> body,\n    bool with_content,\n    bool credentials,"
    "\n) : Result<Option<Response>, HttpError>\n{\n    match (conn_write(&mut r.conn, &request_bytes(c, req,"
    " u, method, body, with_content, credentials)[0..$]))\n    {\n        Ok(_)  : {},\n        Err(e) :\n   "
    "     {\n            if (reused)\n            {\n                return Ok(None);\n            }\n        "
    "    return Err(e);\n        },\n    }\n    bool first = true;\n    // Interim 1xx responses (a 100 Conti"
    "nue) are read past.\n    while (true)\n    {\n        String line = match (http_line(&mut r, MAX_HEAD))"
    "\n        {\n            Ok(Some(l)) : l,\n            Ok(None)    :\n            {\n                if ("
    "reused && first)\n                {\n                    return Ok(None);\n                }\n          "
    "      return Err(ConnectionClosed);\n            },\n            Err(e)      :\n            {\n         "
    "       if (reused && first && Vec::len(&r.buf) == 0)\n                {\n                    return Ok"
    "(None);\n                }\n                return Err(e);\n            },\n        };\n        first = f"
    "alse;\n        bool http11 = StringView::starts_with(&line, \"HTTP/1.1\");\n        StatusLine { status,"
    " reason } = parse_status_line(&line)?;\n        Vec<Header> headers = read_headers(&mut r, StringView"
    "::len(&line) + 2)?;\n        if (status >= 100 && status < 200)\n        {\n            continue;\n     "
    "   }\n        bool no_body = StringView::eq(method, \"HEAD\") || status == 204 || status == 304;\n      "
    "  BodyLength how = if (no_body) { NoBody } else { body_length(&headers[0..$], true)? };\n        bool"
    " until_close = match (how)\n        {\n            UntilClose : true,\n            _          : false,\n"
    "        };\n        Vec<u8> data = read_body(&mut r, how, c.max_body)?;\n        // Kept when asked fo"
    "r, allowed (HTTP/1.1, no `Connection: close`),\n        // the body's end known without the connectio"
    "n's, and nothing more\n        // read than the response.\n        bool keep = c.keep_alive && http11 "
    "&& !until_close && r.at == Vec::len(&r.buf);\n        if (Some(v) = find_header(&headers[0..$], \"conn"
    "ection\"))\n        {\n            if (name_eq(StringView::trim(v), \"close\"))\n            {\n           "
    "     keep = false;\n            }\n        }\n        if (keep)\n        {\n            c.idle = Some(Idl"
    "eConn { .origin = String::clone(&origin_of(u)), .r = r });\n        }\n        else\n        {\n        "
    "    conn_close(&mut r.conn);\n        }\n        // D-0183: a body sent compressed (`Content-Encoding:"
    " gzip` or\n        // `deflate`, which the client offers) arrives decoded, within\n        // `max_bod"
    "y`, and the header is dropped so the response reads as\n        // a plain one.\n        bool strip = "
    "false;\n        if (!no_body)\n        {\n            if (Some(enc) = find_header(&headers[0..$], \"cont"
    "ent-encoding\"))\n            {\n                StringView e = StringView::trim(enc);\n                "
    "Option<Result<Vec<u8>, CompressError>> decoded = if (name_eq(e, \"gzip\") || name_eq(e, \"x-gzip\"))\n   "
    "             {\n                    Some(gunzip(&data[0..$], c.max_body))\n                }\n         "
    "       else if (name_eq(e, \"deflate\"))\n                {\n                    Some(match (zlib_inflat"
    "e(&data[0..$], c.max_body))\n                    {\n                        Ok(v)  : Ok(v),\n          "
    "              Err(_) : inflate(&data[0..$], c.max_body),\n                    })\n                }\n  "
    "              else { None };\n                if (Some(d) = decoded)\n                {\n              "
    "      overwrite(&mut data, match (d)\n                    {\n                        Ok(v)         : v"
    ",\n                        Err(Oversize) : return Err(TooLarge),\n                        Err(_)      "
    "  : return Err(BadMessage),\n                    });\n                    strip = true;\n              "
    "  }\n            }\n        }\n        if (strip)\n        {\n            Vec::retain(&mut headers, not_c"
    "ontent_encoding);\n        }\n        return Ok(Some(Response { .status = status, .reason = reason, .h"
    "eaders = headers, .body = data }));\n    }\n}fn redirect_target(ref<Url, shared> base, StringView loca"
    "tion) : Result<Url, HttpError>\n{\n    if (Option::is_some(&StringView::find(location, \"://\")))\n    {\n"
    "        return Url::parse(location);\n    }\n    String text = String::clone(&base.scheme);\n    String"
    "::append(&mut text, \"://\");\n    String::append(&mut text, &host_text(base));\n    if (StringView::sta"
    "rts_with(location, \"/\"))\n    {\n        String::append(&mut text, location);\n    }\n    else\n    {\n   "
    "     StringView path = &base.path;\n        usize dir = 0;\n        slice<u8, shared> pb = StringView:"
    ":as_bytes(path);\n        for (usize i = 0; i < slice_len(pb); i += 1)\n        {\n            if (pb[i"
    "] == b'/')\n            {\n                dir = i + 1;\n            }\n        }\n        String::append"
    "(&mut text, &path[0..dir]);\n        String::append(&mut text, location);\n    }\n    Url::parse(&text)"
    "\n}export fn HttpClient::send(ref<HttpClient, exclusive> c, ref<Request, shared> req) : Result<Respon"
    "se, HttpError>\n{\n    Url u = Url::parse(&req.url)?;\n    String method = String::clone(&req.method);\n"
    "    Vec<u8> body = Vec::clone(&req.body);\n    usize hops = 0;\n    bool with_content = true;\n    Stri"
    "ng first_origin = origin_of(&u);\n    bool credentials = true;\n    while (true)\n    {\n        Respons"
    "e resp = exchange(c, req, &u, &method, &body[0..$], with_content, credentials)?;\n        bool redire"
    "ct = resp.status == 301 || resp.status == 302 || resp.status == 303 || resp.status == 307 || resp.st"
    "atus == 308;\n        if (!redirect)\n        {\n            return Ok(resp);\n        }\n        StringV"
    "iew location = match (Response::header(&resp, \"location\"))\n        {\n            Some(l) : l,\n      "
    "      None    : return Ok(resp),\n        };\n        if (hops == c.max_redirects)\n        {\n         "
    "   return Err(TooManyRedirects);\n        }\n        hops += 1;\n        Url next = redirect_target(&u,"
    " location)?;\n        overwrite(&mut u, next);\n        // Once a redirect leaves the first origin, cr"
    "edentials stay behind,\n        // even if a later one comes back.\n        if (origin_of(&u) != first"
    "_origin)\n        {\n            credentials = false;\n        }\n        if (resp.status != 307 && resp"
    ".status != 308 && !StringView::eq(&method, \"HEAD\"))\n        {\n            overwrite(&mut method, \"GE"
    "T\");\n            Vec::clear(&mut body);\n            with_content = false;\n        }\n    }\n}export fn"
    " http_get(StringView url) : Result<Response, HttpError>\n{\n    HttpClient c = HttpClient::new();\n    "
    "Request req = Request::new(\"GET\", url);\n    HttpClient::send(&mut c, &req)\n}export fn http_post(Stri"
    "ngView url, StringView content_type, slice<u8, shared> body) : Result<Response, HttpError>\n{\n    Htt"
    "pClient c = HttpClient::new();\n    Request req = Request::new(\"POST\", url);\n    Vec::push(&mut req.h"
    "eaders, Header::new(\"Content-Type\", content_type));\n    Vec::extend_from(&mut req.body, body);\n    H"
    "ttpClient::send(&mut c, &req)\n}export fn HttpServer::bind(SocketAddr a) : Result<HttpServer, NetErro"
    "r>\n{\n    TcpListener l = TcpListener::bind(a)?;\n    Ok(HttpServer { .listener = l, .max_body = 16777"
    "216, .timeout_ms = 30000, .key = None, .chain = Vec::new() })\n}export fn HttpServer::bind_tls(Socket"
    "Addr a, PrivateKey key, Vec<Certificate> chain) : Result<HttpServer, NetError>\n{\n    TcpListener l ="
    " TcpListener::bind(a)?;\n    Ok(HttpServer { .listener = l, .max_body = 16777216, .timeout_ms = 30000"
    ", .key = Some(key), .chain = chain })\n}export fn HttpServer::local_addr(ref<HttpServer, shared> s) :"
    " SocketAddr\n{\n    TcpListener::local_addr(&s.listener)\n}export fn HttpServer::accept(ref<HttpServer,"
    " exclusive> s) : Result<HttpConnection, HttpError>\n{\n    TcpStream tcp = match (TcpListener::accept("
    "&mut s.listener))\n    {\n        Ok(t)  : t,\n        Err(e) : return Err(HttpNetFailure(e)),\n    };\n "
    "   TcpStream::set_read_timeout_ms(&mut tcp, s.timeout_ms);\n    TcpStream::set_write_timeout_ms(&mut "
    "tcp, s.timeout_ms);\n    TcpStream::set_nodelay(&mut tcp, true);\n    Conn conn = match (&s.key)\n    {"
    "\n        Some(k) : match (TlsStream::server(tcp, k, &s.chain[0..$]))\n        {\n            Ok(t)  : "
    "Secure(t),\n            Err(e) : return Err(HttpTlsFailure(e)),\n        },\n        None : Plain(tcp),"
    "\n    };\n    Ok(HttpConnection { .reader = Reader { .conn = conn, .buf = Vec::new(), .at = 0 }, .max_"
    "body = s.max_body, .keep_alive = true, .head_request = false, .closed = false })\n}export fn HttpConn"
    "ection::peer_addr(ref<HttpConnection, shared> c) : SocketAddr\n{\n    match (&c.reader.conn)\n    {\n   "
    "     Plain(s)  : TcpStream::peer_addr(s),\n        Secure(s) : TlsStream::peer_addr(s),\n    }\n}export"
    " fn HttpConnection::request(ref<HttpConnection, exclusive> c) : Result<Option<Request>, HttpError>\n{"
    "\n    if (c.closed || !c.keep_alive)\n    {\n        return Ok(None);\n    }\n    // After an Err the con"
    "nection closes ([Http-Request]): a request line\n    // over the limit, or not UTF-8, included.\n    S"
    "tring line = match (http_line(&mut c.reader, MAX_HEAD))\n    {\n        Ok(Some(l)) : l,\n        Ok(No"
    "ne)    : return Ok(None),\n        Err(e)      :\n        {\n            c.keep_alive = false;\n        "
    "    return Err(e);\n        },\n    };\n    // A request line: METHOD SP target SP HTTP/1.x.\n    Vec<St"
    "ringView> parts = StringView::split(&line, \" \");\n    if (Vec::len(&parts) != 3 || StringView::len(pa"
    "rts[0]) == 0 || StringView::len(parts[1]) == 0)\n    {\n        c.keep_alive = false;\n        return E"
    "rr(BadMessage);\n    }\n    bool v11 = StringView::eq(parts[2], \"HTTP/1.1\");\n    if (!v11 && !StringVi"
    "ew::eq(parts[2], \"HTTP/1.0\"))\n    {\n        c.keep_alive = false;\n        return Err(BadMessage);\n  "
    "  }\n    Vec<Header> headers = match (read_headers(&mut c.reader, StringView::len(&line) + 2))\n    {\n"
    "        Ok(h)  : h,\n        Err(e) :\n        {\n            c.keep_alive = false;\n            return "
    "Err(e);\n        },\n    };\n    if (v11 && Option::is_none(&find_header(&headers[0..$], \"host\")))\n    "
    "{\n        c.keep_alive = false;\n        return Err(BadMessage);\n    }\n    // Keep-alive: HTTP/1.1 un"
    "less `Connection: close`, HTTP/1.0 only with\n    // `Connection: keep-alive`.\n    c.keep_alive = mat"
    "ch (find_header(&headers[0..$], \"connection\"))\n    {\n        Some(v) : if (v11)\n        {\n          "
    "  !name_eq(\n                StringView::trim(v),\n                \"close\",\n            )\n        }\n  "
    "      else { name_eq(StringView::trim(v), \"keep-alive\") },\n        None : v11,\n    };\n    c.head_req"
    "uest = StringView::eq(parts[0], \"HEAD\");\n    BodyLength how = match (body_length(&headers[0..$], fal"
    "se))\n    {\n        Ok(h)  : h,\n        Err(e) :\n        {\n            c.keep_alive = false;\n        "
    "    return Err(e);\n        },\n    };\n    if (Some(expect) = find_header(&headers[0..$], \"expect\"))\n "
    "   {\n        if (name_eq(StringView::trim(expect), \"100-continue\"))\n        {\n            if (Err(e)"
    " = conn_write(&mut c.reader.conn, &b\"HTTP/1.1 100 Continue\\r\\n\\r\\n\"[0..$]))\n            {\n          "
    "      c.keep_alive = false;\n                return Err(e);\n            }\n        }\n    }\n    Vec<u8>"
    " body = match (read_body(&mut c.reader, how, c.max_body))\n    {\n        Ok(b)  : b,\n        Err(e) :"
    "\n        {\n            c.keep_alive = false;\n            return Err(e);\n        },\n    };\n    Ok(Som"
    "e(Request { .method = String::from_view(parts[0]), .url = String::from_view(parts[1]), .headers = he"
    "aders, .body = body }))\n}export fn HttpConnection::respond(\n    ref<HttpConnection, exclusive> c,\n  "
    "  u16 status,\n    slice<Header, shared> headers,\n    slice<u8, shared> body,\n) : Result<void, HttpEr"
    "ror>\n{\n    String head = \"HTTP/1.1 \";\n    String::append(&mut head, status);\n    String::append(&mut"
    " head, \" \");\n    String::append(&mut head, reason_phrase(status));\n    String::append(&mut head, \"\\r"
    "\\n\");\n    for (usize i = 0; i < slice_len(headers); i += 1)\n    {\n        if (name_eq(\n            &"
    "headers[i].name,\n            \"content-length\",\n        ) || name_eq(&headers[i].name, \"connection\"))"
    "\n        {\n            continue;\n        }\n        String::append(&mut head, &headers[i].name);\n    "
    "    String::append(&mut head, \": \");\n        String::append(&mut head, &headers[i].value);\n        S"
    "tring::append(&mut head, \"\\r\\n\");\n    }\n    bool no_body = status == 204 || status == 304 || (status"
    " >= 100 && status < 200);\n    if (!no_body)\n    {\n        String::append(&mut head, \"Content-Length:"
    " \");\n        String::append(&mut head, slice_len(body));\n        String::append(&mut head, \"\\r\\n\");\n"
    "    }\n    String::append(\n        &mut head,\n        if (c.keep_alive) { \"Connection: keep-alive\\r\\n"
    "\\r\\n\" } else { \"Connection: close\\r\\n\\r\\n\" },\n    );\n    Vec<u8> out = String::into_bytes(head);\n   "
    " if (!no_body && !c.head_request)\n    {\n        Vec::extend_from(&mut out, body);\n    }\n    conn_wri"
    "te(&mut c.reader.conn, &out[0..$])?;\n    if (!c.keep_alive)\n    {\n        conn_close(&mut c.reader.c"
    "onn);\n        c.closed = true;\n    }\n    Ok(())\n}export fn HttpConnection::close(ref<HttpConnection,"
    " exclusive> c)\n{\n    if (!c.closed)\n    {\n        conn_close(&mut c.reader.conn);\n        c.closed ="
    " true;\n    }\n}export fn scram_salted_password(StringView password, slice<u8, shared> salt, usize ite"
    "rations) : Vec<u8>\n{\n    pbkdf2(Sha2_256, StringView::as_bytes(password), salt, iterations, 32)\n}exp"
    "ort fn Scram::start(StringView user, StringView client_nonce) : Scram\n{\n    String bare = \"n=\";\n    "
    "foreach (c in StringView::as_bytes(user))\n    {\n        if (*c == b',')\n        {\n            String"
    "::append(&mut bare, \"=2C\");\n        }\n        else if (*c == b'=')\n        {\n            String::app"
    "end(&mut bare, \"=3D\");\n        }\n        else\n        {\n            String::push_ascii(&mut bare, *c"
    ");\n        }\n    }\n    String::append(&mut bare, \",r=\");\n    String::append(&mut bare, client_nonce)"
    ";\n    Scram { .client_nonce = String::from_view(client_nonce), .client_first_bare = bare, .server_si"
    "gnature = Vec::new() }\n}export fn Scram::client_first(ref<Scram, shared> s) : String\n{\n    String m "
    "= \"n,,\";\n    String::append(&mut m, &s.client_first_bare);\n    m\n}fn attribute(slice<StringView, sha"
    "red> parts, str name) : Option<StringView>\n{\n    foreach (p in parts)\n    {\n        if (StringView::"
    "starts_with(*p, StringView::of(name)))\n        {\n            return Some(&(*p)[2..$]);\n        }\n   "
    " }\n    None\n}export fn Scram::respond(\n    ref<Scram, exclusive> s,\n    StringView server_first,\n   "
    " StringView password,\n) : Result<String, PgError>\n{\n    Vec<StringView> parts = StringView::split(se"
    "rver_first, \",\");\n    if (Option::is_some(&attribute(&parts[0..$], \"m=\")))\n    {\n        return Err("
    "ProtocolViolation);\n    }\n    StringView nonce = Option::ok_or(attribute(&parts[0..$], \"r=\"), Protoc"
    "olViolation)?;\n    StringView salt_text = Option::ok_or(attribute(&parts[0..$], \"s=\"), ProtocolViola"
    "tion)?;\n    StringView iter_text = Option::ok_or(attribute(&parts[0..$], \"i=\"), ProtocolViolation)?;"
    "\n    if (!StringView::starts_with(\n        nonce,\n        &s.client_nonce,\n    ) || StringView::len("
    "nonce) <= StringView::len(&s.client_nonce))\n    {\n        return Err(AuthFailed);\n    }\n    Vec<u8> "
    "salt = match (base64_decode(salt_text))\n    {\n        Ok(v)  : v,\n        Err(_) : return Err(Protoc"
    "olViolation),\n    };\n    usize iterations = match (StringView::parse<usize>(iter_text))\n    {\n      "
    "  Ok(n)  : n,\n        Err(_) : return Err(ProtocolViolation),\n    };\n    if (iterations == 0)\n    {\n"
    "        return Err(ProtocolViolation);\n    }\n    Vec<u8> salted = scram_salted_password(password, &s"
    "alt[0..$], iterations);\n    array<u8, 32> client_key = hmac_sha256(&salted[0..$], &b\"Client Key\"[0.."
    "$]);\n    array<u8, 32> stored_key = sha256(&client_key[0..$]);\n    String without_proof = \"c=biws,r="
    "\";\n    String::append(&mut without_proof, nonce);\n    String auth = String::clone(&s.client_first_ba"
    "re);\n    String::append(&mut auth, \",\");\n    String::append(&mut auth, server_first);\n    String::ap"
    "pend(&mut auth, \",\");\n    String::append(&mut auth, &without_proof);\n    array<u8, 32> client_signat"
    "ure = hmac_sha256(&stored_key[0..$], StringView::as_bytes(&auth));\n    Vec<u8> proof = Vec::new();\n "
    "   for (usize i = 0; i < 32; i += 1)\n    {\n        Vec::push(&mut proof, client_key[i] ^ client_sign"
    "ature[i]);\n    }\n    array<u8, 32> server_key = hmac_sha256(&salted[0..$], &b\"Server Key\"[0..$]);\n  "
    "  array<u8, 32> server_signature = hmac_sha256(&server_key[0..$], StringView::as_bytes(&auth));\n    "
    "overwrite(&mut s.server_signature, Vec::from_slice(&server_signature[0..$]));\n    String::append(&mu"
    "t without_proof, \",p=\");\n    String::append(&mut without_proof, &base64_encode(&proof[0..$]));\n    O"
    "k(without_proof)\n}export fn Scram::verify(ref<Scram, shared> s, StringView server_final) : bool\n{\n  "
    "  if (Vec::len(&s.server_signature) == 0 || !StringView::starts_with(server_final, \"v=\"))\n    {\n    "
    "    return false;\n    }\n    match (base64_decode(&server_final[2..$]))\n    {\n        Ok(v)  : digest"
    "_eq(&v[0..$], &s.server_signature[0..$]),\n        Err(_) : false,\n    }\n}unittest \"Scram: a whole ex"
    "change\"\n{\n    Scram s = Scram::start(\"user\", \"rOprNGfwEbeRWgbNEkqO\");\n    assert(Scram::client_first"
    "(&s) == \"n,,n=user,r=rOprNGfwEbeRWgbNEkqO\");\n    String first = \"r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaT"
    "CAfuxFIlj)hNlF$k0,\";\n    String::append(&mut first, \"s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4\");\n    String re"
    "ply = Result::unwrap(Scram::respond(&mut s, &first, \"pencil\"));\n    assert(StringView::ends_with(&re"
    "ply, \",p=0ByS2g6XZEtov8MR140MFRsEfy8/X+bacfpPofVtKjE=\"));\n    assert(Scram::verify(&s, \"v=ITrN4zX09+"
    "hsD398Qk6ol73eg0shWPnOWwnwS83jitc=\"));\n    assert(!Scram::verify(&s, \"e=invalid-proof\"));\n}export fn"
    " PgError::text(ref<PgError, shared> e) : String\n{\n    match (e)\n    {\n        PgNetFailure(n)   : St"
    "ring::from_view(NetError::text(n)),\n        PgTlsFailure(t)   : String::from_view(TlsError::text(t))"
    ",\n        TlsRefused        : \"the server does not accept TLS\",\n        NoTrustedRoots    : \"no trus"
    "ted roots for TLS (TrustStore::system failed)\",\n        BadConnectionUrl  : \"the connection URL is m"
    "alformed\",\n        UnsupportedAuth   : \"the server asks for an authentication method that is not sup"
    "ported\",\n        AuthRefused       : \"the server asks for the password in clear over an unencrypted "
    "connection\",\n        AuthFailed        : \"authentication failed\",\n        Server(s)         :\n      "
    "  {\n            String t = String::clone(&s.severity);\n            String::append(&mut t, \": \");\n   "
    "         String::append(&mut t, &s.message);\n            String::append(&mut t, \" (\");\n            S"
    "tring::append(&mut t, &s.code);\n            String::append(&mut t, \")\");\n            t\n        },\n  "
    "      ProtocolViolation : \"the server's message is malformed\",\n        ResultTooLarge    : \"the resu"
    "lt is larger than the limit\",\n        Disconnected      : \"the connection is closed\",\n    }\n}fn deco"
    "ded(StringView v) : Result<String, PgError>\n{\n    Vec<u8> bytes = match (percent_decode(v))\n    {\n  "
    "      Some(b) : b,\n        None    : return Err(BadConnectionUrl),\n    };\n    match (String::from_ut"
    "f8(bytes))\n    {\n        Ok(s)  : Ok(s),\n        Err(_) : Err(BadConnectionUrl),\n    }\n}export fn Pg"
    "Url::parse(StringView text) : Result<PgUrl, PgError>\n{\n    usize sep = match (StringView::find(text,"
    " \"://\"))\n    {\n        Some(i) : i,\n        None    : return Err(BadConnectionUrl),\n    };\n    Strin"
    "gView scheme = &text[0..sep];\n    if (!StringView::eq(scheme, \"postgres\") && !StringView::eq(scheme,"
    " \"postgresql\"))\n    {\n        return Err(BadConnectionUrl);\n    }\n    StringView rest = &text[sep + "
    "3..$];\n    usize n = StringView::len(rest);\n    slice<u8, shared> b = StringView::as_bytes(rest);\n  "
    "  usize auth_end = 0;\n    while (auth_end < n && b[auth_end] != b'/' && b[auth_end] != b'?')\n    {\n "
    "       auth_end += 1;\n    }\n    // The user information ends at the last '@' of the authority.\n    u"
    "size at_sign = auth_end;\n    for (usize i = 0; i < auth_end; i += 1)\n    {\n        if (b[i] == b'@')"
    "\n        {\n            at_sign = i;\n        }\n    }\n    if (at_sign == auth_end || at_sign == 0)\n   "
    " {\n        return Err(BadConnectionUrl);\n    }\n    StringView userinfo = &rest[0..at_sign];\n    Stri"
    "ng user = String::new();\n    Option<String> password = None;\n    match (StringView::find(userinfo, \""
    ":\"))\n    {\n        Some(colon) :\n        {\n            overwrite(&mut user, decoded(&userinfo[0..col"
    "on])?);\n            overwrite(&mut password, Some(decoded(&userinfo[colon + 1..$])?));\n        },\n  "
    "      None        : overwrite(&mut user, decoded(userinfo)?),\n    }\n    if (StringView::len(&user) ="
    "= 0)\n    {\n        return Err(BadConnectionUrl);\n    }\n    StringView hostport = &rest[at_sign + 1.."
    "auth_end];\n    usize hp = StringView::len(hostport);\n    slice<u8, shared> hb = StringView::as_bytes"
    "(hostport);\n    if (hp == 0)\n    {\n        return Err(BadConnectionUrl);\n    }\n    String host = Str"
    "ing::new();\n    usize host_end = 0;\n    if (hb[0] == b'[')\n    {\n        usize close = match (String"
    "View::find(hostport, \"]\"))\n        {\n            Some(i) : i,\n            None    : return Err(BadCo"
    "nnectionUrl),\n        };\n        String::append(&mut host, &hostport[1..close]);\n        host_end = "
    "close + 1;\n    }\n    else\n    {\n        while (host_end < hp && hb[host_end] != b':')\n        {\n    "
    "        host_end += 1;\n        }\n        String::append(&mut host, &hostport[0..host_end]);\n    }\n  "
    "  if (StringView::len(&host) == 0)\n    {\n        return Err(BadConnectionUrl);\n    }\n    u16 port = "
    "5432;\n    if (host_end < hp)\n    {\n        if (hb[host_end] != b':')\n        {\n            return Er"
    "r(BadConnectionUrl);\n        }\n        port = match (StringView::parse<u16>(&hostport[host_end + 1.."
    "hp]))\n        {\n            Ok(p)  : p,\n            Err(_) : return Err(BadConnectionUrl),\n        }"
    ";\n    }\n    // The database: the path without its '/', the user when none.\n    usize path_end = auth"
    "_end;\n    while (path_end < n && b[path_end] != b'?')\n    {\n        path_end += 1;\n    }\n    String "
    "database = String::new();\n    if (path_end > auth_end + 1)\n    {\n        overwrite(&mut database, de"
    "coded(&rest[auth_end + 1..path_end])?);\n    }\n    if (StringView::len(&database) == 0)\n    {\n       "
    " overwrite(&mut database, String::clone(&user));\n    }\n    PgSslMode sslmode = VerifyFull;\n    if (p"
    "ath_end < n)\n    {\n        StringView query = &rest[path_end + 1..n];\n        if (StringView::len(qu"
    "ery) > 0)\n        {\n            Vec<StringView> pairs = StringView::split(query, \"&\");\n            f"
    "oreach (pair in &pairs)\n            {\n                if (StringView::starts_with(*pair, \"sslmode=\")"
    ")\n                {\n                    StringView mode = &(*pair)[8..$];\n                    if (St"
    "ringView::eq(mode, \"disable\"))\n                    {\n                        sslmode = Disable;\n    "
    "                }\n                    else if (StringView::eq(mode, \"verify-full\"))\n                "
    "    {\n                        sslmode = VerifyFull;\n                    }\n                    else\n "
    "                   {\n                        return Err(BadConnectionUrl);\n                    }\n   "
    "             }\n                else\n                {\n                    return Err(BadConnectionUr"
    "l);\n                }\n            }\n        }\n    }\n    Ok(PgUrl { .user = user, .password = passwor"
    "d, .host = host, .port = port, .database = database, .sslmode = sslmode })\n}unittest \"PgUrl::parse: "
    "decoding and defaults\"\n{\n    PgUrl u = Result::unwrap(PgUrl::parse(\"postgres://app:p%40ss@[::1]/?ssl"
    "mode=disable\"));\n    assert(u.host == \"::1\" && u.port == 5432);\n    assert(u.database == \"app\");\n   "
    " match (&u.password)\n    {\n        Some(p) : assert(*p == \"p@ss\"),\n        None    : assert(false),\n"
    "    }\n    Result<PgUrl, PgError> no_user = PgUrl::parse(\"postgres://db.example/shop\");\n    assert(Re"
    "sult::is_err(&no_user));\n}fn float_text(f64 x) : String\n{\n    if (x != x)\n    {\n        return \"NaN\""
    ";\n    }\n    if (x > 1.7976931348623157e308)\n    {\n        return \"Infinity\";\n    }\n    if (x < -1.79"
    "76931348623157e308)\n    {\n        return \"-Infinity\";\n    }\n    String t = String::new();\n    String"
    "::append(&mut t, x);\n    t\n}export fn PgValue::text(ref<PgValue, shared> value) : Option<String>\n{\n "
    "   match (value)\n    {\n        Null     : None,\n        Text(s)  : Some(String::clone(s)),\n        I"
    "nt(i)   :\n        {\n            String t = String::new();\n            String::append(&mut t, *i);\n  "
    "          Some(t)\n        },\n        Float(f) : Some(float_text(*f)),\n        Bool(b)  : Some(if (*b"
    ") { \"t\" } else { \"f\" }),\n        Bytes(v) :\n        {\n            String t = \"\\\\x\";\n            Stri"
    "ng::append(&mut t, &to_hex(&v[0..$]));\n            Some(t)\n        },\n    }\n}unittest \"PgValue::text"
    ": what is sent\"\n{\n    assert(Option::unwrap(PgValue::text(&Bool(true))) == \"t\");\n    assert(Option::"
    "unwrap(PgValue::text(&Bytes(Vec::filled(2, 0xAB: u8)))) == \"\\\\xabab\");\n    assert(Option::unwrap(PgV"
    "alue::text(&Float(1.0 / 0.0))) == \"Infinity\");\n    assert(Option::is_none(&PgValue::text(&Null)));\n}"
    "export fn PgRow::get(ref<PgRow, shared> r, usize i) : Option<StringView>\n{\n    if (i >= Vec::len(&r."
    "cells))\n    {\n        return None;\n    }\n    match (&r.cells[i])\n    {\n        Some(s) : Some(s),\n  "
    "      None    : None,\n    }\n}export fn PgRow::get_i64(ref<PgRow, shared> r, usize i) : Option<i64>\n{"
    "\n    match (PgRow::get(r, i))\n    {\n        Some(t) : match (StringView::parse<i64>(t))\n        {\n  "
    "          Ok(v)  : Some(v),\n            Err(_) : None,\n        },\n        None : None,\n    }\n}export"
    " fn PgRow::get_f64(ref<PgRow, shared> r, usize i) : Option<f64>\n{\n    match (PgRow::get(r, i))\n    {"
    "\n        Some(t) :\n        {\n            if (StringView::eq(t, \"NaN\"))\n            {\n               "
    " return Some(0.0 / 0.0);\n            }\n            if (StringView::eq(t, \"Infinity\"))\n            {\n"
    "                return Some(1.0 / 0.0);\n            }\n            if (StringView::eq(t, \"-Infinity\")"
    ")\n            {\n                return Some(-1.0 / 0.0);\n            }\n            match (StringView"
    "::parse<f64>(t))\n            {\n                Ok(v)  : Some(v),\n                Err(_) : None,\n    "
    "        }\n        },\n        None    : None,\n    }\n}export fn PgRow::get_bool(ref<PgRow, shared> r, "
    "usize i) : Option<bool>\n{\n    match (PgRow::get(r, i))\n    {\n        Some(t) :\n        {\n           "
    " if (StringView::eq(t, \"t\"))\n            {\n                return Some(true);\n            }\n        "
    "    if (StringView::eq(t, \"f\"))\n            {\n                return Some(false);\n            }\n    "
    "        None\n        },\n        None    : None,\n    }\n}export fn PgRow::get_bytes(ref<PgRow, shared>"
    " r, usize i) : Option<Vec<u8>>\n{\n    match (PgRow::get(r, i))\n    {\n        Some(t) : match (StringV"
    "iew::strip_prefix(t, \"\\\\x\"))\n        {\n            // `\\x` alone is the empty bytea, which from_hex "
    "refuses.\n            Some(hex) : if (StringView::len(hex) == 0)\n            {\n                Some(V"
    "ec::new())\n            }\n            else\n            {\n                match (from_hex(hex))\n      "
    "          {\n                    Ok(v)  : Some(v),\n                    Err(_) : None,\n               "
    " }\n            },\n            None : None,\n        },\n        None : None,\n    }\n}unittest \"PgRow: t"
    "yped reads of cells\"\n{\n    Vec<Option<String>> cells = Vec::new();\n    Vec::push(&mut cells, Some(\"4"
    "2\"));\n    Vec::push(&mut cells, Some(\"t\"));\n    Vec::push(&mut cells, None);\n    PgRow row = PgRow {"
    " .cells = cells };\n    assert(Option::unwrap(PgRow::get_i64(&row, 0)) == 42);\n    assert(Option::unw"
    "rap(PgRow::get_bool(&row, 1)));\n    assert(Option::is_none(&PgRow::get_bool(&row, 0)));\n    assert(O"
    "ption::is_none(&PgRow::get(&row, 2)) && Option::is_none(&PgRow::get(&row, 9)));\n}export fn PgResult:"
    ":column(ref<PgResult, shared> res, StringView name) : Option<usize>\n{\n    for (usize i = 0; i < Vec:"
    ":len(&res.columns); i += 1)\n    {\n        if (res.columns[i].name == name)\n        {\n            ret"
    "urn Some(i);\n        }\n    }\n    None\n}fn tag_count(StringView tag) : u64\n{\n    Vec<StringView> word"
    "s = StringView::split(tag, \" \");\n    if (Vec::len(&words) < 2)\n    {\n        return 0;\n    }\n    mat"
    "ch (StringView::parse<u64>(words[Vec::len(&words) - 1]))\n    {\n        Ok(n)  : n,\n        Err(_) : "
    "0,\n    }\n}fn pg_read(ref<PgConn, exclusive> c, ref<Vec<u8>, exclusive> buf, usize max) : Result<usiz"
    "e, PgError>\n{\n    match (c)\n    {\n        Plain(s) : match (TcpStream::read(s, buf, max))\n        {\n"
    "            Ok(n)  : Ok(n),\n            Err(e) : Err(PgNetFailure(e)),\n        },\n        Secure(s) "
    ": match (TlsStream::read(s, buf, max))\n        {\n            Ok(n)  : Ok(n),\n            Err(e) : Er"
    "r(PgTlsFailure(e)),\n        },\n    }\n}fn pg_write(ref<PgConn, exclusive> c, slice<u8, shared> data) "
    ": Result<void, PgError>\n{\n    match (c)\n    {\n        Plain(s) : match (TcpStream::write(s, data))\n "
    "       {\n            Ok(_)  : Ok(()),\n            Err(e) : Err(PgNetFailure(e)),\n        },\n        "
    "Secure(s) : match (TlsStream::write(s, data))\n        {\n            Ok(_)  : Ok(()),\n            Err"
    "(e) : Err(PgTlsFailure(e)),\n        },\n    }\n}fn pg_close(ref<PgConn, exclusive> c)\n{\n    match (c)\n"
    "    {\n        Plain(s)  : { _ = TcpStream::shutdown_write(s); },\n        Secure(s) : { _ = TlsStream"
    "::close(s); },\n    }\n}fn pg_fill(ref<PgReader, exclusive> r) : Result<bool, PgError>\n{\n    if (r.at "
    "> 0 && r.at == Vec::len(&r.buf))\n    {\n        Vec::clear(&mut r.buf);\n        r.at = 0;\n    }\n    u"
    "size n = pg_read(&mut r.conn, &mut r.buf, 16384)?;\n    Ok(n > 0)\n}fn pg_available(ref<PgReader, shar"
    "ed> r) : usize\n{\n    Vec::len(&r.buf) - r.at\n}fn pg_read_n(ref<PgReader, exclusive> r, ref<Vec<u8>, "
    "exclusive> out, usize n) : Result<void, PgError>\n{\n    usize need = n;\n    while (need > 0)\n    {\n  "
    "      if (pg_available(r) == 0)\n        {\n            if (!pg_fill(r)?)\n            {\n              "
    "  return Err(Disconnected);\n            }\n        }\n        usize take = min(need, pg_available(r));"
    "\n        Vec::extend_from(out, &r.buf[r.at..r.at + take]);\n        r.at += take;\n        need -= tak"
    "e;\n    }\n    Ok(())\n}fn read_message(ref<PgReader, exclusive> r) : Result<Message, PgError>\n{\n    //"
    " Most messages are already whole in the buffer: taken from it at once.\n    usize avail = pg_availabl"
    "e(r);\n    if (avail >= 5)\n    {\n        u8 kind = r.buf[r.at];\n        u32 len = read_be<u32>(&r.buf"
    "[0..$], r.at + 1);\n        if (len < 4 || widen<usize>(len) - 4 > MAX_MESSAGE)\n        {\n           "
    " return Err(ProtocolViolation);\n        }\n        usize n = widen<usize>(len) - 4;\n        if (avail"
    " - 5 >= n)\n        {\n            Vec<u8> body = Vec::from_slice(&r.buf[r.at + 5..r.at + 5 + n]);\n   "
    "         r.at += 5 + n;\n            return Ok(Message { .kind = kind, .body = body });\n        }\n   "
    " }\n    Vec<u8> head = Vec::new();\n    pg_read_n(r, &mut head, 5)?;\n    u8 kind = head[0];\n    u32 le"
    "n = read_be<u32>(&head[0..$], 1);\n    if (len < 4 || widen<usize>(len) - 4 > MAX_MESSAGE)\n    {\n    "
    "    return Err(ProtocolViolation);\n    }\n    Vec<u8> body = Vec::new();\n    pg_read_n(r, &mut body, "
    "widen<usize>(len) - 4)?;\n    Ok(Message { .kind = kind, .body = body })\n}fn frame(u8 kind, slice<u8,"
    " shared> body) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n    Vec::push(&mut out, kind);\n    Vec::pus"
    "h_be(&mut out, narrow<u32>(slice_len(body) + 4));\n    Vec::extend_from(&mut out, body);\n    out\n}fn "
    "push_cstr(ref<Vec<u8>, exclusive> out, StringView s)\n{\n    Vec::extend_from(out, StringView::as_byte"
    "s(s));\n    Vec::push(out, 0);\n}fn cstr_at(slice<u8, shared> b, ref<usize, exclusive> at) : Result<St"
    "ring, PgError>\n{\n    usize end = *at;\n    while (end < slice_len(b) && b[end] != 0)\n    {\n        en"
    "d += 1;\n    }\n    if (end == slice_len(b))\n    {\n        return Err(ProtocolViolation);\n    }\n    Ve"
    "c<u8> bytes = Vec::from_slice(&b[*at..end]);\n    *at = end + 1;\n    match (String::from_utf8(bytes))"
    "\n    {\n        Ok(s)  : Ok(s),\n        Err(_) : Err(ProtocolViolation),\n    }\n}fn decode_server_erro"
    "r(slice<u8, shared> b) : Result<PgServerError, PgError>\n{\n    PgServerError e = PgServerError { .sev"
    "erity = String::new(), .code = String::new(), .message = String::new(), .detail = None, .hint = None"
    ", .position = None };\n    usize at = 0;\n    while (at < slice_len(b) && b[at] != 0)\n    {\n        u8"
    " field = b[at];\n        at += 1;\n        String t = cstr_at(b, &mut at)?;\n        if (field == b'S' "
    "|| field == b'V')\n        {\n            overwrite(&mut e.severity, t);\n        }\n        else if (fi"
    "eld == b'C')\n        {\n            overwrite(&mut e.code, t);\n        }\n        else if (field == b'"
    "M')\n        {\n            overwrite(&mut e.message, t);\n        }\n        else if (field == b'D')\n  "
    "      {\n            overwrite(&mut e.detail, Some(t));\n        }\n        else if (field == b'H')\n   "
    "     {\n            overwrite(&mut e.hint, Some(t));\n        }\n        else if (field == b'P')\n      "
    "  {\n            match (StringView::parse<u32>(&t))\n            {\n                Ok(p)  : overwrite("
    "&mut e.position, Some(p)),\n                Err(_) : {},\n            }\n        }\n    }\n    Ok(e)\n}fn "
    "decode_columns(slice<u8, shared> b) : Result<Vec<PgColumn>, PgError>\n{\n    if (slice_len(b) < 2)\n   "
    " {\n        return Err(ProtocolViolation);\n    }\n    usize n = widen<usize>(read_be<u16>(b, 0));\n    "
    "usize at = 2;\n    Vec<PgColumn> columns = Vec::new();\n    for (usize i = 0; i < n; i += 1)\n    {\n   "
    "     String name = cstr_at(b, &mut at)?;\n        if (at + 18 > slice_len(b))\n        {\n            r"
    "eturn Err(ProtocolViolation);\n        }\n        u32 type_oid = read_be<u32>(b, at + 6);\n        at +"
    "= 18;\n        Vec::push(&mut columns, PgColumn { .name = name, .type_oid = type_oid });\n    }\n    Ok"
    "(columns)\n}fn decode_row(slice<u8, shared> b) : Result<PgRow, PgError>\n{\n    if (slice_len(b) < 2)\n "
    "   {\n        return Err(ProtocolViolation);\n    }\n    usize n = widen<usize>(read_be<u16>(b, 0));\n  "
    "  usize at = 2;\n    Vec<Option<String>> cells = Vec::new();\n    for (usize i = 0; i < n; i += 1)\n   "
    " {\n        if (at + 4 > slice_len(b))\n        {\n            return Err(ProtocolViolation);\n        }"
    "\n        i32 len = read_be<i32>(b, at);\n        at += 4;\n        if (len < 0)\n        {\n            "
    "Vec::push(&mut cells, None);\n            continue;\n        }\n        usize size = narrow<usize>(len)"
    ";\n        if (at + size > slice_len(b))\n        {\n            return Err(ProtocolViolation);\n       "
    " }\n        Vec<u8> bytes = Vec::from_slice(&b[at..at + size]);\n        at += size;\n        match (St"
    "ring::from_utf8(bytes))\n        {\n            Ok(s)  : Vec::push(&mut cells, Some(s)),\n            E"
    "rr(_) : return Err(ProtocolViolation),\n        }\n    }\n    Ok(PgRow { .cells = cells })\n}fn open_tcp"
    "(StringView host, u16 port, u64 timeout_ms) : Result<TcpStream, PgError>\n{\n    Vec<SocketAddr> addrs"
    " = match (IpAddr::parse(host))\n    {\n        Ok(ip) :\n        {\n            Vec<SocketAddr> one = Ve"
    "c::new();\n            Vec::push(&mut one, SocketAddr::new(ip, port));\n            one\n        },\n   "
    "     Err(_) : match (resolve(host, port))\n        {\n            Ok(a)  : a,\n            Err(e) : ret"
    "urn Err(PgNetFailure(e)),\n        },\n    };\n    if (Vec::len(&addrs) == 0)\n    {\n        return Err("
    "PgNetFailure(UnknownHost));\n    }\n    NetError last = Failed;\n    for (usize i = 0; i < Vec::len(&ad"
    "drs); i += 1)\n    {\n        TcpStream tcp = match (TcpStream::connect_timeout(addrs[i], timeout_ms))"
    "\n        {\n            Ok(t)  : t,\n            Err(e) :\n            {\n                last = e;\n    "
    "            continue;\n            },\n        };\n        TcpStream::set_read_timeout_ms(&mut tcp, tim"
    "eout_ms);\n        TcpStream::set_write_timeout_ms(&mut tcp, timeout_ms);\n        TcpStream::set_node"
    "lay(&mut tcp, true);\n        return Ok(tcp);\n    }\n    Err(PgNetFailure(last))\n}export fn PgConnecti"
    "on::connect(StringView url) : Result<PgConnection, PgError>\n{\n    PgUrl u = PgUrl::parse(url)?;\n    "
    "TrustStore roots = match (u.sslmode)\n    {\n        Disable : TrustStore::new(),\n        VerifyFull :"
    " match (TrustStore::system())\n        {\n            Ok(t)  : t,\n            Err(_) : return Err(NoTr"
    "ustedRoots),\n        },\n    };\n    connect_url(&u, &roots, 30000)\n}export fn PgConnection::connect_w"
    "ith(\n    StringView url,\n    ref<TrustStore, shared> roots,\n    u64 timeout_ms,\n) : Result<PgConnect"
    "ion, PgError>\n{\n    PgUrl u = PgUrl::parse(url)?;\n    connect_url(&u, roots, timeout_ms)\n}fn connect"
    "_url(ref<PgUrl, shared> u, ref<TrustStore, shared> roots, u64 timeout_ms) : Result<PgConnection, PgE"
    "rror>\n{\n    TcpStream tcp = open_tcp(&u.host, u.port, timeout_ms)?;\n    bool secure = false;\n    PgC"
    "onn conn = match (u.sslmode)\n    {\n        Disable    : Plain(tcp),\n        VerifyFull :\n        {\n "
    "           // SSLRequest: the server answers S (go ahead) or N (no TLS).\n            Vec<u8> req = V"
    "ec::new();\n            Vec::push_be<u32>(&mut req, 8);\n            Vec::push_be<u32>(&mut req, 80877"
    "103);\n            match (TcpStream::write(&mut tcp, &req[0..$]))\n            {\n                Ok(_)"
    "  : {},\n                Err(e) : return Err(PgNetFailure(e)),\n            }\n            Vec<u8> answ"
    "er = Vec::new();\n            match (TcpStream::read_exact(&mut tcp, &mut answer, 1))\n            {\n "
    "               Ok(_)  : {},\n                Err(e) : return Err(PgNetFailure(e)),\n            }\n    "
    "        if (answer[0] == b'N')\n            {\n                return Err(TlsRefused);\n            }\n "
    "           if (answer[0] != b'S')\n            {\n                return Err(ProtocolViolation);\n     "
    "       }\n            secure = true;\n            match (TlsStream::client(tcp, &u.host, roots))\n     "
    "       {\n                Ok(s)  : Secure(s),\n                Err(e) : return Err(PgTlsFailure(e)),\n "
    "           }\n        },\n    };\n    PgConnection c = PgConnection { .reader = PgReader { .conn = conn"
    ", .buf = Vec::new(), .at = 0 }, .secure = secure, .closed = false, .parameters = Vec::new(), .backen"
    "d_pid = 0, .backend_key = 0, .notices = Vec::new(), .max_result = 16777216 };\n    // StartupMessage:"
    " protocol 3.0, the user, the database, UTF-8.\n    Vec<u8> body = Vec::new();\n    Vec::push_be<u32>(&"
    "mut body, 196608);\n    push_cstr(&mut body, \"user\");\n    push_cstr(&mut body, &u.user);\n    push_cst"
    "r(&mut body, \"database\");\n    push_cstr(&mut body, &u.database);\n    push_cstr(&mut body, \"client_en"
    "coding\");\n    push_cstr(&mut body, \"UTF8\");\n    Vec::push(&mut body, 0);\n    Vec<u8> startup = Vec::"
    "new();\n    Vec::push_be(&mut startup, narrow<u32>(Vec::len(&body) + 4));\n    Vec::extend_from(&mut s"
    "tartup, &body[0..$]);\n    match (pg_write(&mut c.reader.conn, &startup[0..$]))\n    {\n        Ok(_)  "
    ": {},\n        Err(e) : return Err(e),\n    }\n    match (authenticate(&mut c, u))\n    {\n        Ok(_) "
    " : Ok(c),\n        Err(e) :\n        {\n            pg_close(&mut c.reader.conn);\n            Err(e)\n  "
    "      },\n    }\n}fn authenticate(ref<PgConnection, exclusive> c, ref<PgUrl, shared> u) : Result<void,"
    " PgError>\n{\n    Option<Scram> scram = None;\n    // Once SCRAM has begun, AuthenticationOk counts onl"
    "y after the\n    // server's signature was verified ([Pg-Auth]): a server that skips\n    // its final"
    " message has not proved it knows the password.\n    bool scram_begun = false;\n    bool scram_verified"
    " = false;\n    String password = match (&u.password)\n    {\n        Some(p) : String::clone(p),\n      "
    "  None    : String::new(),\n    };\n    while (true)\n    {\n        Message m = read_message(&mut c.rea"
    "der)?;\n        slice<u8, shared> b = &m.body[0..$];\n        if (m.kind == b'R')\n        {\n          "
    "  if (slice_len(b) < 4)\n            {\n                return Err(ProtocolViolation);\n            }\n "
    "           u32 code = read_be<u32>(b, 0);\n            if (code == 0)\n            {\n                i"
    "f (scram_begun && !scram_verified)\n                {\n                    return Err(AuthFailed);\n   "
    "             }\n                continue;\n            }\n            else if (code == 3)\n            {"
    "\n                if (!c.secure)\n                {\n                    return Err(AuthRefused);\n     "
    "           }\n                Vec<u8> pw = Vec::new();\n                push_cstr(&mut pw, &password);"
    "\n                pg_write(&mut c.reader.conn, &frame(b'p', &pw[0..$])[0..$])?;\n            }\n       "
    "     else if (code == 10)\n            {\n                bool offered = false;\n                usize "
    "at = 4;\n                while (at < slice_len(b) && b[at] != 0)\n                {\n                  "
    "  String mech = cstr_at(b, &mut at)?;\n                    if (mech == \"SCRAM-SHA-256\")\n             "
    "       {\n                        offered = true;\n                    }\n                }\n           "
    "     if (!offered)\n                {\n                    return Err(UnsupportedAuth);\n              "
    "  }\n                array<u8, 18> raw = [0; 18];\n                os_random_bytes(&mut raw[0..$]);\n  "
    "              String nonce = base64_encode(&raw[0..$]);\n                Scram s = Scram::start(\"\", &"
    "nonce);\n                String first = Scram::client_first(&s);\n                Vec<u8> body = Vec::"
    "new();\n                push_cstr(&mut body, \"SCRAM-SHA-256\");\n                Vec::push_be(&mut body"
    ", narrow<u32>(StringView::len(&first)));\n                Vec::extend_from(&mut body, StringView::as_"
    "bytes(&first));\n                pg_write(&mut c.reader.conn, &frame(b'p', &body[0..$])[0..$])?;\n    "
    "            overwrite(&mut scram, Some(s));\n                scram_begun = true;\n            }\n      "
    "      else if (code == 11)\n            {\n                String server_first = match (String::from_u"
    "tf8(Vec::from_slice(&b[4..$])))\n                {\n                    Ok(s)  : s,\n                  "
    "  Err(_) : return Err(ProtocolViolation),\n                };\n                String client_final = m"
    "atch (&mut scram)\n                {\n                    Some(s) : Scram::respond(s, &server_first, &"
    "password)?,\n                    None    : return Err(ProtocolViolation),\n                };\n        "
    "        pg_write(&mut c.reader.conn, &frame(b'p', StringView::as_bytes(&client_final))[0..$])?;\n    "
    "        }\n            else if (code == 12)\n            {\n                String server_final = match"
    " (String::from_utf8(Vec::from_slice(&b[4..$])))\n                {\n                    Ok(s)  : s,\n  "
    "                  Err(_) : return Err(ProtocolViolation),\n                };\n                bool ok"
    " = match (&scram)\n                {\n                    Some(s) : Scram::verify(s, &server_final),\n "
    "                   None    : false,\n                };\n                if (!ok)\n                {\n  "
    "                  return Err(AuthFailed);\n                }\n                scram_verified = true;\n "
    "           }\n            else\n            {\n                return Err(UnsupportedAuth);\n           "
    " }\n        }\n        else if (m.kind == b'S')\n        {\n            usize at = 0;\n            String"
    " name = cstr_at(b, &mut at)?;\n            String value = cstr_at(b, &mut at)?;\n            Vec::push"
    "(&mut c.parameters, PgParameter { .name = name, .value = value });\n        }\n        else if (m.kind"
    " == b'K')\n        {\n            if (slice_len(b) < 8)\n            {\n                return Err(Proto"
    "colViolation);\n            }\n            c.backend_pid = read_be<u32>(b, 0);\n            c.backend_k"
    "ey = read_be<u32>(b, 4);\n        }\n        else if (m.kind == b'Z')\n        {\n            return Ok("
    "());\n        }\n        else if (m.kind == b'E')\n        {\n            PgServerError e = decode_serve"
    "r_error(b)?;\n            return Err(if (StringView::starts_with(&e.code, \"28\")) { AuthFailed } else "
    "{ Server(e) });\n        }\n        else if (m.kind == b'N')\n        {\n            Vec::push(&mut c.no"
    "tices, decode_server_error(b)?);\n        }\n        else\n        {\n            return Err(ProtocolVio"
    "lation);\n        }\n    }\n}export fn PgConnection::parameter(ref<PgConnection, shared> c, str name) :"
    " Option<StringView>\n{\n    foreach (p in &c.parameters)\n    {\n        if (p.name == name)\n        {\n "
    "           return Some(&p.value);\n        }\n    }\n    None\n}fn broken(ref<PgConnection, exclusive> c"
    ", PgError e) : PgError\n{\n    c.closed = true;\n    e\n}fn collect(ref<PgConnection, exclusive> c, bool"
    " keep) : Result<PgResult, PgError>\n{\n    PgResult res = PgResult { .columns = Vec::new(), .rows = Ve"
    "c::new(), .affected = 0, .tag = String::new() };\n    Option<PgServerError> failure = None;\n    bool "
    "too_large = false;\n    usize bytes = 0;\n    while (true)\n    {\n        Message m = match (read_messa"
    "ge(&mut c.reader))\n        {\n            Ok(msg) : msg,\n            Err(e)  : return Err(broken(c, e"
    ")),\n        };\n        slice<u8, shared> b = &m.body[0..$];\n        if (m.kind == b'T')\n        {\n  "
    "          match (decode_columns(b))\n            {\n                Ok(cols) : overwrite(&mut res.colu"
    "mns, cols),\n                Err(e)   : return Err(broken(c, e)),\n            }\n        }\n        els"
    "e if (m.kind == b'D')\n        {\n            if (keep && !too_large)\n            {\n                by"
    "tes += slice_len(b);\n                if (bytes > c.max_result)\n                {\n                   "
    " too_large = true;\n                    Vec::clear(&mut res.rows);\n                }\n                "
    "else\n                {\n                    match (decode_row(b))\n                    {\n             "
    "           Ok(row) : Vec::push(&mut res.rows, row),\n                        Err(e)  : return Err(bro"
    "ken(c, e)),\n                    }\n                }\n            }\n        }\n        else if (m.kind "
    "== b'C')\n        {\n            usize at = 0;\n            String tag = match (cstr_at(b, &mut at))\n  "
    "          {\n                Ok(t)  : t,\n                Err(e) : return Err(broken(c, e)),\n         "
    "   };\n            res.affected = tag_count(&tag);\n            overwrite(&mut res.tag, tag);\n        "
    "}\n        else if (m.kind == b'E')\n        {\n            PgServerError reported = match (decode_serv"
    "er_error(b))\n            {\n                Ok(se) : se,\n                Err(e) : return Err(broken(c"
    ", e)),\n            };\n            if (Option::is_none(&failure))\n            {\n                overw"
    "rite(&mut failure, Some(reported));\n            }\n        }\n        else if (m.kind == b'N')\n       "
    " {\n            match (decode_server_error(b))\n            {\n                Ok(se) : Vec::push(&mut "
    "c.notices, se),\n                Err(e) : return Err(broken(c, e)),\n            }\n        }\n        e"
    "lse if (m.kind == b'Z')\n        {\n            break;\n        }\n        else if (m.kind == b'1' || m."
    "kind == b'2' || m.kind == b'n' || m.kind == b'I' || m.kind == b's' || m.kind == b'A' || m.kind == b'"
    "S')\n        {\n            // ParseComplete, BindComplete, NoData, EmptyQueryResponse,\n            //"
    " PortalSuspended, a notification, a parameter changed.\n            continue;\n        }\n        else\n"
    "        {\n            return Err(broken(c, ProtocolViolation));\n        }\n    }\n    if (Some(e) = fa"
    "ilure)\n    {\n        return Err(Server(e));\n    }\n    if (too_large)\n    {\n        return Err(Result"
    "TooLarge);\n    }\n    Ok(res)\n}export fn PgConnection::query(\n    ref<PgConnection, exclusive> c,\n   "
    " StringView sql,\n    slice<PgValue, shared> params,\n) : Result<PgResult, PgError>\n{\n    if (c.closed"
    ")\n    {\n        return Err(Disconnected);\n    }\n    if (slice_len(params) > 65535)\n    {\n        ret"
    "urn Err(ResultTooLarge);\n    }\n    Vec<u8> out = Vec::new();\n    Vec<u8> parse = Vec::new();\n    pus"
    "h_cstr(&mut parse, \"\");\n    push_cstr(&mut parse, sql);\n    Vec::push_be<u16>(&mut parse, 0);\n    Ve"
    "c::extend_from(&mut out, &frame(b'P', &parse[0..$])[0..$]);\n    Vec<u8> bind = Vec::new();\n    push_"
    "cstr(&mut bind, \"\");\n    push_cstr(&mut bind, \"\");\n    Vec::push_be<u16>(&mut bind, 0);\n    Vec::pus"
    "h_be(&mut bind, narrow<u16>(slice_len(params)));\n    foreach (p in params)\n    {\n        match (PgVa"
    "lue::text(p))\n        {\n            Some(t) :\n            {\n                Vec::push_be(&mut bind, "
    "narrow<u32>(StringView::len(&t)));\n                Vec::extend_from(&mut bind, StringView::as_bytes("
    "&t));\n            },\n            None    : Vec::push_be<i32>(&mut bind, -1),\n        }\n    }\n    Vec"
    "::push_be<u16>(&mut bind, 0);\n    Vec::extend_from(&mut out, &frame(b'B', &bind[0..$])[0..$]);\n    V"
    "ec<u8> describe = Vec::new();\n    Vec::push(&mut describe, b'P');\n    Vec::push(&mut describe, 0);\n "
    "   Vec::extend_from(&mut out, &frame(b'D', &describe[0..$])[0..$]);\n    Vec<u8> execute = Vec::new()"
    ";\n    push_cstr(&mut execute, \"\");\n    Vec::push_be<u32>(&mut execute, 0);\n    Vec::extend_from(&mut"
    " out, &frame(b'E', &execute[0..$])[0..$]);\n    Vec<u8> none = Vec::new();\n    Vec::extend_from(&mut "
    "out, &frame(b'S', &none[0..$])[0..$]);\n    match (pg_write(&mut c.reader.conn, &out[0..$]))\n    {\n  "
    "      Ok(_)  : {},\n        Err(e) : return Err(broken(c, e)),\n    }\n    collect(c, true)\n}export fn "
    "PgConnection::execute(\n    ref<PgConnection, exclusive> c,\n    StringView sql,\n    slice<PgValue, sh"
    "ared> params,\n) : Result<u64, PgError>\n{\n    PgResult r = PgConnection::query(c, sql, params)?;\n    "
    "Ok(r.affected)\n}export fn PgConnection::run_script(ref<PgConnection, exclusive> c, StringView sql) :"
    " Result<void, PgError>\n{\n    if (c.closed)\n    {\n        return Err(Disconnected);\n    }\n    Vec<u8>"
    " q = Vec::new();\n    push_cstr(&mut q, sql);\n    match (pg_write(&mut c.reader.conn, &frame(b'Q', &q"
    "[0..$])[0..$]))\n    {\n        Ok(_)  : {},\n        Err(e) : return Err(broken(c, e)),\n    }\n    _ = "
    "collect(c, false)?;\n    Ok(())\n}export fn PgConnection::close(ref<PgConnection, exclusive> c)\n{\n    "
    "if (!c.closed)\n    {\n        Vec<u8> none = Vec::new();\n        _ = pg_write(&mut c.reader.conn, &fr"
    "ame(b'X', &none[0..$])[0..$]);\n        pg_close(&mut c.reader.conn);\n        c.closed = true;\n    }\n"
    "}fn JsonReader::peek(ref<JsonReader, shared> r) : u8\n{\n    if (r.at < StringView::len(r.text))\n    {"
    "\n        return r.text.bytes[r.at];\n    }\n    0\n}fn json_space_end(slice<u8, shared> b, usize at) : "
    "usize\n{\n    usize i = at;\n    while (i < slice_len(b) && (b[i] == b' ' || b[i] == b'\\t' || b[i] == b"
    "'\\n' || b[i] == b'\\r'))\n    {\n        i += 1;\n    }\n    i\n}fn json_digits_end(slice<u8, shared> b, u"
    "size at) : usize\n{\n    usize i = at;\n    while (i < slice_len(b) && ascii_is_digit(b[i]))\n    {\n    "
    "    i += 1;\n    }\n    i\n}fn JsonReader::skip_space(ref<JsonReader, exclusive> r)\n{\n    r.at = json_s"
    "pace_end(r.text.bytes, r.at);\n}fn JsonReader::word(ref<JsonReader, exclusive> r, str word) : bool\n{\n"
    "    usize n = str_len(word);\n    if (r.at + n > StringView::len(r.text))\n    {\n        return false;"
    "\n    }\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (r.text.bytes[r.at + i] != str_byte(wor"
    "d, i))\n        {\n            return false;\n        }\n    }\n    r.at += n;\n    true\n}fn JsonReader::d"
    "igits(ref<JsonReader, exclusive> r) : usize\n{\n    usize start = r.at;\n    r.at = json_digits_end(r.t"
    "ext.bytes, r.at);\n    r.at - start\n}fn JsonReader::number(ref<JsonReader, exclusive> r) : Result<Jso"
    "n, ParseError>\n{\n    usize start = r.at;\n    if (JsonReader::peek(r) == b'-')\n    {\n        r.at += "
    "1;\n    }\n    if (JsonReader::peek(r) == b'0')\n    {\n        r.at += 1;\n    }\n    else if (JsonReader"
    "::digits(r) == 0)\n    {\n        return Err(Invalid(r.at));\n    }\n    if (JsonReader::peek(r) == b'.'"
    ")\n    {\n        r.at += 1;\n        if (JsonReader::digits(r) == 0)\n        {\n            return Err("
    "Invalid(r.at));\n        }\n    }\n    u8 e = JsonReader::peek(r);\n    if (e == b'e' || e == b'E')\n    "
    "{\n        r.at += 1;\n        u8 sign = JsonReader::peek(r);\n        if (sign == b'+' || sign == b'-'"
    ")\n        {\n            r.at += 1;\n        }\n        if (JsonReader::digits(r) == 0)\n        {\n     "
    "       return Err(Invalid(r.at));\n        }\n    }\n    match (StringView::parse<f64>(&r.text[start..r"
    ".at]))\n    {\n        Ok(v)  : Ok(JsonNumber(v)),\n        Err(_) : Err(OutOfRange),\n    }\n}fn JsonRea"
    "der::text(ref<JsonReader, exclusive> r) : Result<String, ParseError>\n{\n    JsonStr { bytes, pos, err"
    " } = json_string(r.text.bytes, r.at);\n    r.at = pos;\n    if (err > 0)\n    {\n        return Err(Inva"
    "lid(err - 1));\n    }\n    // Runs of the (UTF-8) text and encoded code points: well-formed.\n    match"
    " (String::from_utf8(bytes))\n    {\n        Ok(s)  : Ok(s),\n        Err(_) : Err(Invalid(pos)),\n    }\n"
    "}fn json_hex4(array<u8, 4> q, usize at) : i64\n{\n    i64 v = 0;\n    for (usize i = 0; i < 4; i += 1)\n"
    "    {\n        usize p = at + i;\n        u8 c = q[i];\n        i64 d = if (c >= b'0' && c <= b'9') { w"
    "iden<i64>(c - b'0') }\n        else if (c >= b'a' && c <= b'f') { widen<i64>(c - b'a') + 10 }\n       "
    " else if (c >= b'A' && c <= b'F') { widen<i64>(c - b'A') + 10 }\n        else { return -1 - narrow<i6"
    "4>(p); };\n        v = v * 16 + d;\n    }\n    v\n}fn json_string(slice<u8, shared> b, usize start) : Js"
    "onStr\n{\n    Vec<u8> out = Vec::new();\n    usize n = slice_len(b);\n    usize at = start;\n    usize er"
    "r = 0;\n    while (true)\n    {\n        if (at >= n)\n        {\n            err = n + 1;\n            br"
    "eak;\n        }\n        u8 c = b[at];\n        if (c == b'\"')\n        {\n            at += 1;\n         "
    "   break;\n        }\n        if (c < 0x20)\n        {\n            err = at + 1;\n            break;\n   "
    "     }\n        if (c != b'\\\\')\n        {\n            Vec::push(&mut out, c);\n            at += 1;\n  "
    "          continue;\n        }\n        at += 1;\n        u8 e = if (at < n) { b[at] } else { 0 };\n    "
    "    at += 1;\n        if (e == b'\"') { Vec::push(&mut out, b'\"'); }\n        else if (e == b'\\\\') { Ve"
    "c::push(&mut out, b'\\\\'); }\n        else if (e == b'/') { Vec::push(&mut out, b'/'); }\n        else "
    "if (e == b'b') { Vec::push(&mut out, 8); }\n        else if (e == b'f') { Vec::push(&mut out, 12); }\n"
    "        else if (e == b'n') { Vec::push(&mut out, 10); }\n        else if (e == b'r') { Vec::push(&mu"
    "t out, 13); }\n        else if (e == b't') { Vec::push(&mut out, 9); }\n        else if (e == b'u')\n  "
    "      {\n            array<u8, 4> q = [0; 4];\n            for (usize k = 0; k < 4 && at + k < n; k +="
    " 1)\n            {\n                q[k] = b[at + k];\n            }\n            i64 h = json_hex4(q, a"
    "t);\n            if (h < 0)\n            {\n                err = narrow<usize>(0 - h);\n               "
    " break;\n            }\n            at += 4;\n            u32 cp = narrow<u32>(h);\n            if (cp >"
    "= 0xD800 && cp <= 0xDBFF)\n            {\n                // A high surrogate: joined with a `\\uDC00`."
    ".`\\uDFFF` that\n                // follows; alone, U+FFFD.\n                usize save = at;\n         "
    "       bool joined = false;\n                if (at < n && b[at] == b'\\\\')\n                {\n        "
    "            at += 1;\n                    if (at < n && b[at] == b'u')\n                    {\n        "
    "                at += 1;\n                        array<u8, 4> q2 = [0; 4];\n                        f"
    "or (usize k = 0; k < 4 && at + k < n; k += 1)\n                        {\n                            "
    "q2[k] = b[at + k];\n                        }\n                        i64 lo = json_hex4(q2, at);\n   "
    "                     if (lo < 0)\n                        {\n                            err = narrow<"
    "usize>(0 - lo);\n                            break;\n                        }\n                       "
    " at += 4;\n                        u32 low = narrow<u32>(lo);\n                        if (low >= 0xDC"
    "00 && low <= 0xDFFF)\n                        {\n                            cp = 0x10000 + ((cp - 0xD"
    "800) << 10) + (low - 0xDC00);\n                            joined = true;\n                        }\n "
    "                   }\n                }\n                if (!joined)\n                {\n              "
    "      at = save;\n                    cp = 0xFFFD;\n                }\n            }\n            // As "
    "`String::push_code_point`: a surrogate is U+FFFD.\n            u32 u = if (cp >= 0xD800 && cp <= 0xDF"
    "FF) { 0xFFFD } else { cp };\n            if (u < 0x80)\n            {\n                Vec::push(&mut o"
    "ut, narrow<u8>(u));\n            }\n            else if (u < 0x800)\n            {\n                Vec:"
    ":push(&mut out, 0xC0 | narrow<u8>(u >> 6));\n                Vec::push(&mut out, 0x80 | narrow<u8>(u "
    "& 0x3F));\n            }\n            else if (u < 0x10000)\n            {\n                Vec::push(&m"
    "ut out, 0xE0 | narrow<u8>(u >> 12));\n                Vec::push(&mut out, 0x80 | narrow<u8>((u >> 6) "
    "& 0x3F));\n                Vec::push(&mut out, 0x80 | narrow<u8>(u & 0x3F));\n            }\n          "
    "  else\n            {\n                Vec::push(&mut out, 0xF0 | narrow<u8>(u >> 18));\n              "
    "  Vec::push(&mut out, 0x80 | narrow<u8>((u >> 12) & 0x3F));\n                Vec::push(&mut out, 0x80"
    " | narrow<u8>((u >> 6) & 0x3F));\n                Vec::push(&mut out, 0x80 | narrow<u8>(u & 0x3F));\n "
    "           }\n        }\n        else\n        {\n            err = at;\n            break;\n        }\n   "
    " }\n    JsonStr { .bytes = out, .pos = at, .err = err }\n}fn JsonReader::value(ref<JsonReader, exclusi"
    "ve> r, usize depth) : Result<Json, ParseError>\n{\n    JsonReader::skip_space(r);\n    u8 b = JsonReade"
    "r::peek(r);\n    if (b == b'{')\n    {\n        if (depth >= MAX_DEPTH)\n        {\n            return Er"
    "r(OutOfRange);\n        }\n        r.at += 1;\n        Vec<JsonMember> members = Vec::new();\n        Js"
    "onReader::skip_space(r);\n        if (JsonReader::peek(r) == b'}')\n        {\n            r.at += 1;\n "
    "           return Ok(JsonObject(members));\n        }\n        while (true)\n        {\n            Json"
    "Reader::skip_space(r);\n            if (JsonReader::peek(r) != b'\"')\n            {\n                re"
    "turn Err(Invalid(r.at));\n            }\n            r.at += 1;\n            String key = JsonReader::t"
    "ext(r)?;\n            JsonReader::skip_space(r);\n            if (JsonReader::peek(r) != b':')\n       "
    "     {\n                return Err(Invalid(r.at));\n            }\n            r.at += 1;\n            J"
    "son v = JsonReader::value(r, depth + 1)?;\n            Vec::push(&mut members, JsonMember { .key = ke"
    "y, .value = v });\n            JsonReader::skip_space(r);\n            u8 c = JsonReader::peek(r);\n   "
    "         r.at += 1;\n            if (c == b'}')\n            {\n                return Ok(JsonObject(me"
    "mbers));\n            }\n            if (c != b',')\n            {\n                return Err(Invalid(r"
    ".at - 1));\n            }\n        }\n    }\n    if (b == b'[')\n    {\n        if (depth >= MAX_DEPTH)\n  "
    "      {\n            return Err(OutOfRange);\n        }\n        r.at += 1;\n        Vec<Json> items = V"
    "ec::new();\n        JsonReader::skip_space(r);\n        if (JsonReader::peek(r) == b']')\n        {\n   "
    "         r.at += 1;\n            return Ok(JsonArray(items));\n        }\n        while (true)\n        "
    "{\n            Json v = JsonReader::value(r, depth + 1)?;\n            Vec::push(&mut items, v);\n     "
    "       JsonReader::skip_space(r);\n            u8 c = JsonReader::peek(r);\n            r.at += 1;\n   "
    "         if (c == b']')\n            {\n                return Ok(JsonArray(items));\n            }\n   "
    "         if (c != b',')\n            {\n                return Err(Invalid(r.at - 1));\n            }\n "
    "       }\n    }\n    if (b == b'\"')\n    {\n        r.at += 1;\n        return Ok(JsonText(JsonReader::te"
    "xt(r)?));\n    }\n    if (b == b'-' || ascii_is_digit(b))\n    {\n        return JsonReader::number(r);\n"
    "    }\n    if (JsonReader::word(r, \"true\"))\n    {\n        return Ok(JsonBool(true));\n    }\n    if (Js"
    "onReader::word(r, \"false\"))\n    {\n        return Ok(JsonBool(false));\n    }\n    if (JsonReader::word"
    "(r, \"null\"))\n    {\n        return Ok(JsonNull);\n    }\n    Err(Invalid(r.at))\n}export fn Json::parse("
    "StringView text) : Result<Json, ParseError>\n{\n    JsonReader r = JsonReader { .text = text, .at = 0 "
    "};\n    JsonReader::skip_space(&mut r);\n    if (r.at >= StringView::len(text))\n    {\n        return E"
    "rr(Empty);\n    }\n    Json v = JsonReader::value(&mut r, 0)?;\n    JsonReader::skip_space(&mut r);\n   "
    " if (r.at < StringView::len(text))\n    {\n        return Err(Invalid(r.at));\n    }\n    Ok(v)\n}unittes"
    "t \"Json::parse: where the error is\"\n{\n    match (Json::parse(\"[1, 2\"))\n    {\n        Err(Invalid(i))"
    " : assert(i == 5),\n        _               : assert(false),\n    }\n    match (Json::parse(\"[1] x\"))\n "
    "   {\n        Err(Invalid(i)) : assert(i == 4),\n        _               : assert(false),\n    }\n}fn js"
    "on_quote(ref<String, exclusive> out, StringView s)\n{\n    Vec<u8> o = replace(&mut out.bytes, Vec::ne"
    "w());\n    overwrite(&mut out.bytes, json_quote_bytes(o, s.bytes));\n}fn json_quote_bytes(Vec<u8> out,"
    " slice<u8, shared> s) : Vec<u8>\n{\n    str digits = \"0123456789abcdef\";\n    Vec::push(&mut out, b'\"')"
    ";\n    for (usize i = 0; i < slice_len(s); i += 1)\n    {\n        u8 b = s[i];\n        if (b >= 0x20 &"
    "& b != b'\"' && b != b'\\\\')\n        {\n            Vec::push(&mut out, b);\n            continue;\n     "
    "   }\n        Vec::push(&mut out, b'\\\\');\n        if (b == b'\"') { Vec::push(&mut out, b'\"'); }\n     "
    "   else if (b == b'\\\\') { Vec::push(&mut out, b'\\\\'); }\n        else if (b == 10) { Vec::push(&mut o"
    "ut, b'n'); }\n        else if (b == 13) { Vec::push(&mut out, b'r'); }\n        else if (b == 9) { Vec"
    "::push(&mut out, b't'); }\n        else if (b == 8) { Vec::push(&mut out, b'b'); }\n        else if (b"
    " == 12) { Vec::push(&mut out, b'f'); }\n        else\n        {\n            Vec::push(&mut out, b'u');"
    "\n            Vec::push(&mut out, b'0');\n            Vec::push(&mut out, b'0');\n            Vec::push"
    "(&mut out, str_byte(digits, widen<usize>(b >> 4)));\n            Vec::push(&mut out, str_byte(digits,"
    " widen<usize>(b & 15)));\n        }\n    }\n    Vec::push(&mut out, b'\"');\n    out\n}fn json_number(ref<"
    "String, exclusive> out, f64 x)\n{\n    if (!is_finite(x))\n    {\n        String::append(out, \"null\");\n "
    "       return;\n    }\n    if (x == trunc(x) && x < 9007199254740992.0 && x > -9007199254740992.0)\n   "
    " {\n        String::append(out, to_int<i64>(x));\n        return;\n    }\n    String::append(out, x);\n}f"
    "n json_indent(ref<String, exclusive> out, usize depth)\n{\n    String::push_ascii(out, 10);\n    for (u"
    "size i = 0; i < depth; i += 1)\n    {\n        String::append(out, \"  \");\n    }\n}fn json_write(ref<Str"
    "ing, exclusive> out, ref<Json, shared> j, bool indent, usize depth)\n{\n    match (j)\n    {\n        Js"
    "onNull            : String::append(out, \"null\"),\n        JsonBool(b)         : String::append(out, i"
    "f (*b) { \"true\" } else { \"false\" }),\n        JsonNumber(x)       : json_number(out, *x),\n        Jso"
    "nText(s)         : json_quote(out, s),\n        JsonArray(items)    :\n        {\n            String::p"
    "ush_ascii(out, b'[');\n            for (usize i = 0; i < Vec::len(items); i += 1)\n            {\n     "
    "           if (i > 0)\n                {\n                    String::push_ascii(out, b',');\n         "
    "       }\n                if (indent)\n                {\n                    json_indent(out, depth + "
    "1);\n                }\n                json_write(out, &items[i], indent, depth + 1);\n            }\n "
    "           if (indent && Vec::len(items) > 0)\n            {\n                json_indent(out, depth);"
    "\n            }\n            String::push_ascii(out, b']');\n        },\n        JsonObject(members) :\n "
    "       {\n            String::push_ascii(out, b'{');\n            for (usize i = 0; i < Vec::len(membe"
    "rs); i += 1)\n            {\n                if (i > 0)\n                {\n                    String::"
    "push_ascii(out, b',');\n                }\n                if (indent)\n                {\n             "
    "       json_indent(out, depth + 1);\n                }\n                json_quote(out, &members[i].ke"
    "y);\n                String::append(out, if (indent) { \": \" } else { \":\" });\n                json_wri"
    "te(out, &members[i].value, indent, depth + 1);\n            }\n            if (indent && Vec::len(memb"
    "ers) > 0)\n            {\n                json_indent(out, depth);\n            }\n            String::p"
    "ush_ascii(out, b'}');\n        },\n    }\n}export fn Json::text(ref<Json, shared> j) : String\n{\n    Str"
    "ing out = String::new();\n    json_write(&mut out, j, false, 0);\n    out\n}export fn Json::pretty(ref<"
    "Json, shared> j) : String\n{\n    String out = String::new();\n    json_write(&mut out, j, true, 0);\n  "
    "  out\n}unittest \"Json::pretty: the layout\"\n{\n    Json a = JsonArray(Vec::new());\n    Json::push(&mut"
    " a, JsonNull);\n    Json::push(&mut a, JsonText(\"x\"));\n    String p = Json::pretty(&a);\n    assert(p "
    "== \"[\\n  null,\\n  \\\"x\\\"\\n]\");\n}export fn Json::get(ref<Json, shared> j, StringView key) : Option<ref"
    "<Json, shared>>\n{\n    match (j)\n    {\n        JsonObject(members) :\n        {\n            for (usize"
    " i = 0; i < Vec::len(members); i += 1)\n            {\n                if (members[i].key == key)\n    "
    "            {\n                    return Some(&members[i].value);\n                }\n            }\n  "
    "          None\n        },\n        _                   : None,\n    }\n}unittest \"Json::get: reading a "
    "document\"\n{\n    Json doc = Result::unwrap(Json::parse(\"{\\\"name\\\": \\\"ok\\\", \\\"n\\\": [1, 2.5]}\"));\n    a"
    "ssert(Option::unwrap(Json::as_text(Option::unwrap(Json::get(&doc, \"name\")))) == \"ok\");\n    auto n = "
    "Option::unwrap(Json::get(&doc, \"n\"));\n    assert(Json::as_i64(Option::unwrap(Json::at(n, 0))) == Som"
    "e(1: i64));\n    assert(Json::as_i64(Option::unwrap(Json::at(n, 1))) == None);\n    assert(Option::is_"
    "none(&Json::get(&doc, \"missing\")));\n}export fn Json::at(ref<Json, shared> j, usize i) : Option<ref<J"
    "son, shared>>\n{\n    match (j)\n    {\n        JsonArray(items) : if (i < Vec::len(items)) { Some(&item"
    "s[i]) } else { None },\n        _                : None,\n    }\n}export fn Json::lookup(ref<Json, shar"
    "ed> j, StringView path) : Option<ref<Json, shared>>\n{\n    Vec<StringView> parts = StringView::split("
    "path, \".\");\n    ref<Json, shared> cur = j;\n    for (usize i = 0; i < Vec::len(&parts); i += 1)\n    {"
    "\n        cur = match (cur)\n        {\n            JsonArray(_) : match (StringView::parse<usize>(part"
    "s[i]))\n            {\n                Ok(k)  : Json::at(cur, k)?,\n                Err(_) : return Non"
    "e,\n            },\n            _ : Json::get(cur, parts[i])?,\n        };\n    }\n    Some(cur)\n}unittes"
    "t \"Json::lookup: a dotted path\"\n{\n    Json doc = Result::unwrap(Json::parse(\"{\\\"servers\\\": [{\\\"host\\"
    "\": \\\"a\\\"}, {\\\"host\\\": \\\"b\\\"}], \\\"n\\\": 1}\"));\n    assert(Option::unwrap(Json::as_text(Option::unwrap("
    "Json::lookup(&doc, \"servers.1.host\")))) == \"b\");\n    assert(Json::as_i64(Option::unwrap(Json::lookup"
    "(&doc, \"n\"))) == Some(1: i64));\n    assert(Option::is_none(&Json::lookup(&doc, \"servers.2.host\")));\n"
    "    assert(Option::is_none(&Json::lookup(&doc, \"servers.x\")));\n}export fn Json::is_null(ref<Json, sh"
    "ared> j) : bool\n{\n    match (j)\n    {\n        JsonNull : true,\n        _        : false,\n    }\n}expo"
    "rt fn Json::as_bool(ref<Json, shared> j) : Option<bool>\n{\n    match (j)\n    {\n        JsonBool(b) : "
    "Some(*b),\n        _           : None,\n    }\n}export fn Json::as_f64(ref<Json, shared> j) : Option<f6"
    "4>\n{\n    match (j)\n    {\n        JsonNumber(x) : Some(*x),\n        _             : None,\n    }\n}expo"
    "rt fn Json::as_i64(ref<Json, shared> j) : Option<i64>\n{\n    match (j)\n    {\n        JsonNumber(x) : "
    "if (*x == trunc(*x) && *x >= -9223372036854775808.0 && *x < 9223372036854775808.0) { Some(to_int<i64"
    ">(*x)) } else { None },\n        _             : None,\n    }\n}export fn Json::as_text(ref<Json, share"
    "d> j) : Option<StringView>\n{\n    match (j)\n    {\n        JsonText(s) : Some(s),\n        _           "
    ": None,\n    }\n}export fn Json::as_array(ref<Json, shared> j) : Option<ref<Vec<Json>, shared>>\n{\n    "
    "match (j)\n    {\n        JsonArray(items) : Some(items),\n        _                : None,\n    }\n}expo"
    "rt fn Json::as_object(ref<Json, shared> j) : Option<ref<Vec<JsonMember>, shared>>\n{\n    match (j)\n  "
    "  {\n        JsonObject(members) : Some(members),\n        _                   : None,\n    }\n}export f"
    "n Json::set(ref<Json, exclusive> j, StringView key, Json v)\n{\n    match (j)\n    {\n        JsonObject"
    "(members) :\n        {\n            for (usize i = 0; i < Vec::len(members); i += 1)\n            {\n   "
    "             if (members[i].key == key)\n                {\n                    overwrite(&mut members"
    "[i].value, v);\n                    return;\n                }\n            }\n            Vec::push(mem"
    "bers, JsonMember { .key = String::from_view(key), .value = v });\n        },\n        _               "
    "    : assert(false, \"Json::set on a value that is not an object\"),\n    }\n}unittest \"Json::set: a key"
    " set twice\"\n{\n    Json doc = JsonObject(Vec::new());\n    Json::set(&mut doc, \"a\", JsonNumber(1.0));\n"
    "    Json::set(&mut doc, \"b\", JsonArray(Vec::new()));\n    Json::set(&mut doc, \"a\", JsonBool(true));\n "
    "   String t = Json::text(&doc);\n    assert(t == \"{\\\"a\\\":true,\\\"b\\\":[]}\");\n}export fn Json::push(ref<"
    "Json, exclusive> j, Json v)\n{\n    match (j)\n    {\n        JsonArray(items) : Vec::push(items, v),\n  "
    "      _                : assert(false, \"Json::push on a value that is not an array\"),\n    }\n}export "
    "fn to_hex(slice<u8, shared> bytes) : String\n{\n    str digits = \"0123456789abcdef\";\n    Vec<u8> out ="
    " Vec::new();\n    Vec::reserve(&mut out, slice_len(bytes) * 2);\n    for (usize i = 0; i < slice_len(b"
    "ytes); i += 1)\n    {\n        Vec::push(&mut out, str_byte(digits, widen<usize>(bytes[i] >> 4)));\n   "
    "     Vec::push(&mut out, str_byte(digits, widen<usize>(bytes[i] & 15)));\n    }\n    String { .bytes ="
    " out }\n}fn hex_value(u8 b) : u8\n{\n    if (b >= b'0' && b <= b'9')\n    {\n        return b - b'0';\n   "
    " }\n    if (b >= b'a' && b <= b'f')\n    {\n        return b - b'a' + 10;\n    }\n    if (b >= b'A' && b "
    "<= b'F')\n    {\n        return b - b'A' + 10;\n    }\n    255\n}export fn from_hex(StringView text) : Re"
    "sult<Vec<u8>, ParseError>\n{\n    hex_decode(text.bytes)\n}unittest \"from_hex: either case in, lowercas"
    "e out\"\n{\n    Vec<u8> b = Result::unwrap(from_hex(\"00FFa0\"));\n    assert(Vec::len(&b) == 3);\n    asse"
    "rt(b[1] == 255);\n    String h = to_hex(&b[0..$]);\n    assert(h == \"00ffa0\");\n    match (from_hex(\"ab"
    "c\"))\n    {\n        Err(Invalid(i)) : assert(i == 3),\n        _               : assert(false),\n    }\n"
    "}fn hex_decode(slice<u8, shared> b) : Result<Vec<u8>, ParseError>\n{\n    usize n = slice_len(b);\n    "
    "if (n == 0)\n    {\n        return Err(Empty);\n    }\n    Vec<u8> out = Vec::new();\n    Vec::reserve(&m"
    "ut out, n / 2);\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (hex_value(b[i]) == 255)\n     "
    "   {\n            return Err(Invalid(i));\n        }\n    }\n    if (n % 2 != 0)\n    {\n        return Er"
    "r(Invalid(n));\n    }\n    for (usize i = 0; i < n; i += 2)\n    {\n        Vec::push(&mut out, (hex_val"
    "ue(b[i]) << 4) | hex_value(b[i + 1]));\n    }\n    Ok(out)\n}export fn base64_encode(slice<u8, shared> "
    "bytes) : String\n{\n    str alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    "+/\";\n    Vec<u8> out = Vec::new();\n    usize n = slice_len(bytes);\n    Vec::reserve(&mut out, (n + 2"
    ") / 3 * 4);\n    usize i = 0;\n    while (i + 3 <= n)\n    {\n        u32 v = (widen<u32>(bytes[i]) << 1"
    "6) | (widen<u32>(bytes[i + 1]) << 8) | widen<u32>(bytes[i + 2]);\n        Vec::push(&mut out, str_byt"
    "e(alphabet, narrow<usize>((v >> 18) & 63)));\n        Vec::push(&mut out, str_byte(alphabet, narrow<u"
    "size>((v >> 12) & 63)));\n        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 6) & 63)"
    "));\n        Vec::push(&mut out, str_byte(alphabet, narrow<usize>(v & 63)));\n        i += 3;\n    }\n  "
    "  if (n - i == 1)\n    {\n        u32 v = widen<u32>(bytes[i]) << 16;\n        Vec::push(&mut out, str_"
    "byte(alphabet, narrow<usize>((v >> 18) & 63)));\n        Vec::push(&mut out, str_byte(alphabet, narro"
    "w<usize>((v >> 12) & 63)));\n        Vec::push(&mut out, b'=');\n        Vec::push(&mut out, b'=');\n  "
    "  }\n    else if (n - i == 2)\n    {\n        u32 v = (widen<u32>(bytes[i]) << 16) | (widen<u32>(bytes["
    "i + 1]) << 8);\n        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 18) & 63)));\n     "
    "   Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 12) & 63)));\n        Vec::push(&mut ou"
    "t, str_byte(alphabet, narrow<usize>((v >> 6) & 63)));\n        Vec::push(&mut out, b'=');\n    }\n    S"
    "tring { .bytes = out }\n}fn base64_value(u8 b) : u8\n{\n    if (b >= b'A' && b <= b'Z')\n    {\n        r"
    "eturn b - b'A';\n    }\n    if (b >= b'a' && b <= b'z')\n    {\n        return b - b'a' + 26;\n    }\n    "
    "if (b >= b'0' && b <= b'9')\n    {\n        return b - b'0' + 52;\n    }\n    if (b == b'+')\n    {\n     "
    "   return 62;\n    }\n    if (b == b'/')\n    {\n        return 63;\n    }\n    255\n}export fn base64_deco"
    "de(StringView text) : Result<Vec<u8>, ParseError>\n{\n    base64_decode_bytes(text.bytes)\n}unittest \"b"
    "ase64_decode: padding\"\n{\n    StringView text = \"hi!?\";\n    String e = base64_encode(StringView::as_b"
    "ytes(text));\n    assert(e == \"aGkhPw==\");\n    Vec<u8> d = Result::unwrap(base64_decode(&e));\n    ass"
    "ert(Vec::len(&d) == 4);\n    match (base64_decode(\"aG=hPw==\"))\n    {\n        Err(Invalid(i)) : assert"
    "(i == 2),\n        _               : assert(false),\n    }\n    match (base64_decode(\"QR==\"))\n    {\n   "
    "     Err(Invalid(i)) : assert(i == 1),\n        _               : assert(false),\n    }\n}fn base64_dec"
    "ode_bytes(slice<u8, shared> b) : Result<Vec<u8>, ParseError>\n{\n    usize n = slice_len(b);\n    Vec<u"
    "8> out = Vec::new();\n    if (n == 0)\n    {\n        return Ok(Vec::new());\n    }\n    if (n % 4 != 0)\n"
    "    {\n        return Err(Invalid(n));\n    }\n    usize pad = 0;\n    if (b[n - 1] == b'=')\n    {\n     "
    "   pad = 1;\n        if (b[n - 2] == b'=')\n        {\n            pad = 2;\n        }\n    }\n    Vec::re"
    "serve(&mut out, n / 4 * 3);\n    for (usize i = 0; i < n; i += 4)\n    {\n        u32 v = 0;\n        fo"
    "r (usize j = 0; j < 4; j += 1)\n        {\n            u8 c = b[i + j];\n            if (c == b'=' && i"
    " + j >= n - pad)\n            {\n                v = v << 6;\n            }\n            else\n          "
    "  {\n                u8 d = base64_value(c);\n                if (d == 255)\n                {\n        "
    "            return Err(Invalid(i + j));\n                }\n                v = (v << 6) | widen<u32>("
    "d);\n            }\n        }\n        // D-0232: the bits padding leaves over are zero, as `base64_enc"
    "ode`\n        // writes them (RFC 4648 §3.5): one text for each byte string.\n        if (i + 4 == n "
    "&& ((pad == 1 && (v & 0xff) != 0) || (pad == 2 && (v & 0xffff) != 0)))\n        {\n            return "
    "Err(Invalid(n - 1 - pad));\n        }\n        Vec::push(&mut out, narrow_wrapping<u8>(v >> 16));\n    "
    "    if (i + 4 < n || pad < 2)\n        {\n            Vec::push(&mut out, narrow_wrapping<u8>(v >> 8))"
    ";\n        }\n        if (i + 4 < n || pad < 1)\n        {\n            Vec::push(&mut out, narrow_wrapp"
    "ing<u8>(v));\n        }\n    }\n    Ok(out)\n}fn tnode_new(String key, u8 kind, Toml leaf) : TNode\n{\n   "
    " TNode { .key = key, .kind = kind, .leaf = leaf, .members = Vec::new() }\n}fn tnode_find(ref<Vec<TNod"
    "e>, shared> members, StringView key) : Option<usize>\n{\n    for (usize i = 0; i < Vec::len(members); "
    "i += 1)\n    {\n        if (members[i].key == key)\n        {\n            return Some(i);\n        }\n   "
    " }\n    None\n}fn tnode_define(ref<TNode, exclusive> n, ref<Vec<String>, shared> path, usize i, bool i"
    "s_array) : bool\n{\n    StringView part = &path[i];\n    bool last = i + 1 == Vec::len(path);\n    usize"
    " k = match (tnode_find(&n.members, part))\n    {\n        Some(k) : k,\n        None    :\n        {\n   "
    "         if (last && is_array)\n            {\n                TNode arr = tnode_new(String::from_view"
    "(part), K_ARRAY, TomlBool(false));\n                Vec::push(&mut arr.members, tnode_new(String::new"
    "(), K_HEADER, TomlBool(false)));\n                Vec::push(&mut n.members, arr);\n                ret"
    "urn true;\n            }\n            Vec::push(\n                &mut n.members,\n                tnode"
    "_new(String::from_view(part), if (last) { K_HEADER } else { K_IMPLICIT }, TomlBool(false)),\n        "
    "    );\n            if (last)\n            {\n                return true;\n            }\n            Ve"
    "c::len(&n.members) - 1\n        },\n    };\n    u8 kind = n.members[k].kind;\n    if (kind == K_VALUE)\n "
    "   {\n        return false;\n    }\n    if (last)\n    {\n        if (is_array)\n        {\n            if "
    "(kind != K_ARRAY)\n            {\n                return false;\n            }\n            Vec::push(&m"
    "ut n.members[k].members, tnode_new(String::new(), K_HEADER, TomlBool(false)));\n            return tr"
    "ue;\n        }\n        if (kind != K_IMPLICIT)\n        {\n            return false;\n        }\n        "
    "n.members[k].kind = K_HEADER;\n        return true;\n    }\n    if (kind == K_ARRAY)\n    {\n        usiz"
    "e e = Vec::len(&n.members[k].members) - 1;\n        return tnode_define(&mut n.members[k].members[e],"
    " path, i + 1, is_array);\n    }\n    tnode_define(&mut n.members[k], path, i + 1, is_array)\n}fn tnode_"
    "insert(\n    ref<TNode, exclusive> n,\n    ref<Vec<String>, shared> ctx,\n    usize ci,\n    ref<Vec<Str"
    "ing>, shared> keys,\n    usize ki,\n    Toml v,\n) : bool\n{\n    if (ci < Vec::len(ctx))\n    {\n        /"
    "/ Down the current table's path, made by its header.\n        usize k = match (tnode_find(&n.members,"
    " &ctx[ci]))\n        {\n            Some(k) : k,\n            None    : return false,\n        };\n      "
    "  if (n.members[k].kind == K_ARRAY)\n        {\n            usize e = Vec::len(&n.members[k].members) "
    "- 1;\n            return tnode_insert(&mut n.members[k].members[e], ctx, ci + 1, keys, ki, v);\n      "
    "  }\n        return tnode_insert(&mut n.members[k], ctx, ci + 1, keys, ki, v);\n    }\n    StringView p"
    "art = &keys[ki];\n    bool last = ki + 1 == Vec::len(keys);\n    match (tnode_find(&n.members, part))\n"
    "    {\n        Some(k) :\n        {\n            if (last)\n            {\n                return false;\n"
    "            }\n            u8 kind = n.members[k].kind;\n            if (kind != K_DOTTED && kind != K"
    "_IMPLICIT)\n            {\n                return false;\n            }\n            n.members[k].kind ="
    " K_DOTTED;\n            tnode_insert(&mut n.members[k], ctx, ci, keys, ki + 1, v)\n        },\n        "
    "None    :\n        {\n            if (last)\n            {\n                Vec::push(&mut n.members, tn"
    "ode_new(String::from_view(part), K_VALUE, v));\n                return true;\n            }\n          "
    "  Vec::push(&mut n.members, tnode_new(String::from_view(part), K_DOTTED, TomlBool(false)));\n        "
    "    usize k = Vec::len(&n.members) - 1;\n            tnode_insert(&mut n.members[k], ctx, ci, keys, k"
    "i + 1, v)\n        },\n    }\n}fn tnode_to_toml(TNode n) : Toml\n{\n    TNode { key, kind, leaf, members "
    "} = n;\n    drop(key);\n    if (kind == K_VALUE)\n    {\n        drop(members);\n        return leaf;\n   "
    " }\n    drop(leaf);\n    if (kind == K_ARRAY)\n    {\n        Vec<Toml> items = Vec::new();\n        whil"
    "e (Some(m) = Vec::pop(&mut members))\n        {\n            Vec::push(&mut items, tnode_to_toml(m));\n"
    "        }\n        Vec::reverse(&mut items);\n        return TomlArray(items);\n    }\n    Vec<TomlMembe"
    "r> out = Vec::new();\n    while (Some(m) = Vec::pop(&mut members))\n    {\n        String key = clone(&"
    "m.key);\n        Vec::push(&mut out, TomlMember { .key = key, .value = tnode_to_toml(m) });\n    }\n   "
    " Vec::reverse(&mut out);\n    TomlTable(out)\n}fn TomlReader::peek(ref<TomlReader, shared> r) : u8\n{\n "
    "   if (r.at < StringView::len(r.text))\n    {\n        return r.text.bytes[r.at];\n    }\n    0\n}fn Toml"
    "Reader::peek_at(ref<TomlReader, shared> r, usize ahead) : u8\n{\n    if (r.at + ahead < StringView::le"
    "n(r.text))\n    {\n        return r.text.bytes[r.at + ahead];\n    }\n    0\n}fn TomlReader::at_end(ref<T"
    "omlReader, shared> r) : bool\n{\n    r.at >= StringView::len(r.text)\n}fn TomlReader::skip_ws(ref<TomlR"
    "eader, exclusive> r)\n{\n    while (true)\n    {\n        u8 c = TomlReader::peek(r);\n        if (c != b"
    "' ' && c != b'\\t')\n        {\n            return;\n        }\n        r.at += 1;\n    }\n}fn TomlReader::"
    "newline(ref<TomlReader, exclusive> r) : bool\n{\n    u8 c = TomlReader::peek(r);\n    if (c == b'\\n')\n "
    "   {\n        r.at += 1;\n        return true;\n    }\n    if (c == b'\\r' && TomlReader::peek_at(r, 1) ="
    "= b'\\n')\n    {\n        r.at += 2;\n        return true;\n    }\n    false\n}fn TomlReader::comment(ref<T"
    "omlReader, exclusive> r) : Result<void, ParseError>\n{\n    r.at += 1;\n    while (!TomlReader::at_end("
    "r))\n    {\n        u8 c = TomlReader::peek(r);\n        if (c == b'\\n' || (c == b'\\r' && TomlReader::p"
    "eek_at(r, 1) == b'\\n'))\n        {\n            return Ok(());\n        }\n        if ((c < 0x20 && c !="
    " b'\\t') || c == 0x7F)\n        {\n            return Err(Invalid(r.at));\n        }\n        r.at += 1;\n"
    "    }\n    Ok(())\n}fn TomlReader::line_end(ref<TomlReader, exclusive> r) : Result<void, ParseError>\n{"
    "\n    TomlReader::skip_ws(r);\n    if (TomlReader::peek(r) == b'#')\n    {\n        TomlReader::comment("
    "r)?;\n    }\n    if (TomlReader::at_end(r) || TomlReader::newline(r))\n    {\n        return Ok(());\n   "
    " }\n    Err(Invalid(r.at))\n}fn TomlReader::skip_space_lines(ref<TomlReader, exclusive> r) : Result<vo"
    "id, ParseError>\n{\n    while (true)\n    {\n        TomlReader::skip_ws(r);\n        u8 c = TomlReader::"
    "peek(r);\n        if (c == b'#')\n        {\n            TomlReader::comment(r)?;\n            continue;"
    "\n        }\n        if (!TomlReader::newline(r))\n        {\n            return Ok(());\n        }\n    }"
    "\n}fn toml_is_bare(u8 c) : bool\n{\n    ascii_is_alnum(c) || c == b'_' || c == b'-'\n}fn toml_hex_digit("
    "u8 c) : i64\n{\n    if (c >= b'0' && c <= b'9') { widen<i64>(c - b'0') }\n    else if (c >= b'a' && c <"
    "= b'f') { widen<i64>(c - b'a') + 10 }\n    else if (c >= b'A' && c <= b'F') { widen<i64>(c - b'A') + "
    "10 }\n    else { -1 }\n}fn TomlReader::unicode_escape(\n    ref<TomlReader, exclusive> r,\n    usize n,\n"
    "    ref<String, exclusive> out,\n) : Result<void, ParseError>\n{\n    i64 v = 0;\n    for (usize i = 0; "
    "i < n; i += 1)\n    {\n        i64 d = toml_hex_digit(TomlReader::peek(r));\n        if (d < 0)\n       "
    " {\n            return Err(Invalid(r.at));\n        }\n        v = v * 16 + d;\n        r.at += 1;\n    }"
    "\n    if ((v >= 0xD800 && v <= 0xDFFF) || v > 0x10FFFF)\n    {\n        return Err(Invalid(r.at - n));\n"
    "    }\n    String::push_code_point(out, narrow<u32>(v));\n    Ok(())\n}fn TomlReader::basic(ref<TomlRea"
    "der, exclusive> r, bool multi) : Result<String, ParseError>\n{\n    String out = String::new();\n    if"
    " (multi)\n    {\n        // A newline right after the opening delimiter is not part of the text.\n     "
    "   TomlReader::newline(r);\n    }\n    while (true)\n    {\n        if (TomlReader::at_end(r))\n        {"
    "\n            return Err(Invalid(r.at));\n        }\n        u8 c = TomlReader::peek(r);\n        if (c "
    "== b'\"')\n        {\n            if (!multi)\n            {\n                r.at += 1;\n                "
    "return Ok(out);\n            }\n            // The closing `\"\"\"`, with up to two more quotes before it"
    " as text.\n            usize run = 0;\n            while (TomlReader::peek_at(r, run) == b'\"')\n       "
    "     {\n                run += 1;\n            }\n            if (run < 3)\n            {\n              "
    "  for (usize i = 0; i < run; i += 1)\n                {\n                    String::push_ascii(&mut o"
    "ut, b'\"');\n                }\n                r.at += run;\n                continue;\n            }\n  "
    "          if (run > 5)\n            {\n                return Err(Invalid(r.at + 5));\n            }\n  "
    "          for (usize i = 3; i < run; i += 1)\n            {\n                String::push_ascii(&mut o"
    "ut, b'\"');\n            }\n            r.at += run;\n            return Ok(out);\n        }\n        if ("
    "c == b'\\\\')\n        {\n            r.at += 1;\n            u8 e = TomlReader::peek(r);\n            if "
    "(e == b'\"') { String::push_ascii(&mut out, b'\"'); }\n            else if (e == b'\\\\') { String::push_"
    "ascii(&mut out, b'\\\\'); }\n            else if (e == b'b') { String::push_ascii(&mut out, 8); }\n     "
    "       else if (e == b't') { String::push_ascii(&mut out, 9); }\n            else if (e == b'n') { St"
    "ring::push_ascii(&mut out, 10); }\n            else if (e == b'f') { String::push_ascii(&mut out, 12)"
    "; }\n            else if (e == b'r') { String::push_ascii(&mut out, 13); }\n            else if (e == "
    "b'u' || e == b'U')\n            {\n                r.at += 1;\n                TomlReader::unicode_esca"
    "pe(r, if (e == b'u') { 4 } else { 8 }, &mut out)?;\n                continue;\n            }\n         "
    "   else if (multi && (e == b' ' || e == b'\\t' || e == b'\\n' || e == b'\\r'))\n            {\n          "
    "      // A line-ending backslash: the whitespace and newlines up to\n                // the next text"
    " are dropped; a newline must be among them.\n                usize save = r.at;\n                TomlR"
    "eader::skip_ws(r);\n                if (!TomlReader::newline(r))\n                {\n                  "
    "  return Err(Invalid(save));\n                }\n                while (true)\n                {\n      "
    "              TomlReader::skip_ws(r);\n                    if (!TomlReader::newline(r))\n             "
    "       {\n                        break;\n                    }\n                }\n                cont"
    "inue;\n            }\n            else\n            {\n                return Err(Invalid(r.at));\n      "
    "      }\n            r.at += 1;\n            continue;\n        }\n        if (c == b'\\n' || c == b'\\r')"
    "\n        {\n            if (!multi)\n            {\n                return Err(Invalid(r.at));\n        "
    "    }\n            if (c == b'\\r')\n            {\n                if (TomlReader::peek_at(r, 1) != b'\\"
    "n')\n                {\n                    return Err(Invalid(r.at));\n                }\n             "
    "   String::push_ascii(&mut out, b'\\r');\n                r.at += 1;\n            }\n            String:"
    ":push_ascii(&mut out, b'\\n');\n            r.at += 1;\n            continue;\n        }\n        if ((c "
    "< 0x20 && c != b'\\t') || c == 0x7F)\n        {\n            return Err(Invalid(r.at));\n        }\n     "
    "   // Any other byte, of a multi-byte character too: the text is UTF-8\n        // and every byte the"
    " format treats apart is ASCII, so a character's\n        // bytes are copied whole.\n        Vec::push"
    "(&mut out.bytes, c);\n        r.at += 1;\n    }\n}fn TomlReader::literal(ref<TomlReader, exclusive> r, "
    "bool multi) : Result<String, ParseError>\n{\n    String out = String::new();\n    if (multi)\n    {\n    "
    "    TomlReader::newline(r);\n    }\n    while (true)\n    {\n        if (TomlReader::at_end(r))\n        "
    "{\n            return Err(Invalid(r.at));\n        }\n        u8 c = TomlReader::peek(r);\n        if (c"
    " == b'\\'')\n        {\n            if (!multi)\n            {\n                r.at += 1;\n              "
    "  return Ok(out);\n            }\n            usize run = 0;\n            while (TomlReader::peek_at(r,"
    " run) == b'\\'')\n            {\n                run += 1;\n            }\n            if (run < 3)\n     "
    "       {\n                for (usize i = 0; i < run; i += 1)\n                {\n                    St"
    "ring::push_ascii(&mut out, b'\\'');\n                }\n                r.at += run;\n                co"
    "ntinue;\n            }\n            if (run > 5)\n            {\n                return Err(Invalid(r.at"
    " + 5));\n            }\n            for (usize i = 3; i < run; i += 1)\n            {\n                S"
    "tring::push_ascii(&mut out, b'\\'');\n            }\n            r.at += run;\n            return Ok(out"
    ");\n        }\n        if (c == b'\\n' || c == b'\\r')\n        {\n            if (!multi)\n            {\n "
    "               return Err(Invalid(r.at));\n            }\n            if (c == b'\\r')\n            {\n  "
    "              if (TomlReader::peek_at(r, 1) != b'\\n')\n                {\n                    return E"
    "rr(Invalid(r.at));\n                }\n                String::push_ascii(&mut out, b'\\r');\n          "
    "      r.at += 1;\n            }\n            String::push_ascii(&mut out, b'\\n');\n            r.at += "
    "1;\n            continue;\n        }\n        if ((c < 0x20 && c != b'\\t') || c == 0x7F)\n        {\n    "
    "        return Err(Invalid(r.at));\n        }\n        // Any other byte, of a multi-byte character to"
    "o: the text is UTF-8\n        // and every byte the format treats apart is ASCII, so a character's\n  "
    "      // bytes are copied whole.\n        Vec::push(&mut out.bytes, c);\n        r.at += 1;\n    }\n}fn "
    "TomlReader::key_part(ref<TomlReader, exclusive> r) : Result<String, ParseError>\n{\n    u8 c = TomlRea"
    "der::peek(r);\n    if (c == b'\"')\n    {\n        r.at += 1;\n        if (TomlReader::peek(r) == b'\"' &&"
    " TomlReader::peek_at(r, 1) == b'\"')\n        {\n            return Err(Invalid(r.at));\n        }\n     "
    "   return TomlReader::basic(r, false);\n    }\n    if (c == b'\\'')\n    {\n        r.at += 1;\n        if"
    " (TomlReader::peek(r) == b'\\'' && TomlReader::peek_at(r, 1) == b'\\'')\n        {\n            return E"
    "rr(Invalid(r.at));\n        }\n        return TomlReader::literal(r, false);\n    }\n    usize start = r"
    ".at;\n    while (toml_is_bare(TomlReader::peek(r)))\n    {\n        r.at += 1;\n    }\n    if (r.at == st"
    "art)\n    {\n        return Err(Invalid(r.at));\n    }\n    Ok(String::from_view(&r.text[start..r.at]))\n"
    "}fn TomlReader::key(ref<TomlReader, exclusive> r) : Result<Vec<String>, ParseError>\n{\n    Vec<String"
    "> parts = Vec::new();\n    while (true)\n    {\n        Vec::push(&mut parts, TomlReader::key_part(r)?)"
    ";\n        TomlReader::skip_ws(r);\n        if (TomlReader::peek(r) != b'.')\n        {\n            ret"
    "urn Ok(parts);\n        }\n        r.at += 1;\n        TomlReader::skip_ws(r);\n    }\n}fn TomlReader::di"
    "gits(ref<TomlReader, exclusive> r, ref<String, exclusive> out) : Result<usize, ParseError>\n{\n    usi"
    "ze count = 0;\n    while (true)\n    {\n        u8 c = TomlReader::peek(r);\n        if (ascii_is_digit("
    "c))\n        {\n            String::push_ascii(out, c);\n            count += 1;\n            r.at += 1;"
    "\n            continue;\n        }\n        if (c == b'_' && count > 0 && ascii_is_digit(TomlReader::pe"
    "ek_at(r, 1)))\n        {\n            r.at += 1;\n            continue;\n        }\n        if (c == b'_'"
    ")\n        {\n            return Err(Invalid(r.at));\n        }\n        return Ok(count);\n    }\n}fn Tom"
    "lReader::prefixed(ref<TomlReader, exclusive> r, i64 base) : Result<Toml, ParseError>\n{\n    i64 v = 0"
    ";\n    usize count = 0;\n    while (true)\n    {\n        u8 c = TomlReader::peek(r);\n        i64 d = to"
    "ml_hex_digit(c);\n        if (d >= 0 && d < base)\n        {\n            match (checked_mul(v, base))\n"
    "            {\n                Some(m) : match (checked_add(m, d))\n                {\n                "
    "    Some(s) : v = s,\n                    None    : return Err(OutOfRange),\n                },\n      "
    "          None : return Err(OutOfRange),\n            }\n            count += 1;\n            r.at += 1"
    ";\n            continue;\n        }\n        if (c == b'_' && count > 0)\n        {\n            i64 next"
    " = toml_hex_digit(TomlReader::peek_at(r, 1));\n            if (next >= 0 && next < base)\n            "
    "{\n                r.at += 1;\n                continue;\n            }\n        }\n        if (count == "
    "0 || c == b'_')\n        {\n            return Err(Invalid(r.at));\n        }\n        return Ok(TomlInt"
    "eger(v));\n    }\n}fn TomlReader::number(ref<TomlReader, exclusive> r) : Result<Toml, ParseError>\n{\n  "
    "  String text = String::new();\n    u8 c = TomlReader::peek(r);\n    bool negative = false;\n    bool s"
    "igned = false;\n    if (c == b'+' || c == b'-')\n    {\n        negative = c == b'-';\n        signed = "
    "true;\n        if (negative)\n        {\n            String::push_ascii(&mut text, b'-');\n        }\n   "
    "     r.at += 1;\n        c = TomlReader::peek(r);\n    }\n    if (c == b'i' || c == b'n')\n    {\n       "
    " bool inf = TomlReader::word(r, \"inf\");\n        if (!inf && !TomlReader::word(r, \"nan\"))\n        {\n "
    "           return Err(Invalid(r.at));\n        }\n        f64 x = if (inf) { 1.0 / 0.0 } else { 0.0 / "
    "0.0 };\n        return Ok(TomlFloat(if (negative) { 0.0 - x } else { x }));\n    }\n    if (c == b'0' &"
    "& !signed)\n    {\n        u8 p = TomlReader::peek_at(r, 1);\n        if (p == b'x' || p == b'o' || p ="
    "= b'b')\n        {\n            r.at += 2;\n            return TomlReader::prefixed(r, if (p == b'x') {"
    " 16 } else if (p == b'o') { 8 } else { 2 });\n        }\n    }\n    usize start = r.at;\n    usize n = T"
    "omlReader::digits(r, &mut text)?;\n    if (n == 0)\n    {\n        return Err(Invalid(r.at));\n    }\n   "
    " if (n > 1 && r.text.bytes[start] == b'0')\n    {\n        return Err(Invalid(start + 1));\n    }\n    b"
    "ool float = false;\n    if (TomlReader::peek(r) == b'.')\n    {\n        float = true;\n        String::"
    "push_ascii(&mut text, b'.');\n        r.at += 1;\n        if (!ascii_is_digit(TomlReader::peek(r)))\n  "
    "      {\n            return Err(Invalid(r.at));\n        }\n        TomlReader::digits(r, &mut text)?;\n"
    "    }\n    c = TomlReader::peek(r);\n    if (c == b'e' || c == b'E')\n    {\n        float = true;\n     "
    "   String::push_ascii(&mut text, b'e');\n        r.at += 1;\n        c = TomlReader::peek(r);\n        "
    "if (c == b'+' || c == b'-')\n        {\n            String::push_ascii(&mut text, c);\n            r.at"
    " += 1;\n        }\n        if (!ascii_is_digit(TomlReader::peek(r)))\n        {\n            return Err("
    "Invalid(r.at));\n        }\n        TomlReader::digits(r, &mut text)?;\n    }\n    if (float)\n    {\n    "
    "    return match (StringView::parse<f64>(&text))\n        {\n            Ok(x)  : Ok(TomlFloat(x)),\n  "
    "          Err(_) : Err(OutOfRange),\n        };\n    }\n    match (StringView::parse<i64>(&text))\n    {"
    "\n        Ok(i)  : Ok(TomlInteger(i)),\n        Err(_) : Err(OutOfRange),\n    }\n}fn TomlReader::fixed("
    "ref<TomlReader, exclusive> r, usize n) : i64\n{\n    i64 v = 0;\n    for (usize i = 0; i < n; i += 1)\n "
    "   {\n        u8 c = TomlReader::peek_at(r, i);\n        if (!ascii_is_digit(c))\n        {\n           "
    " return -1;\n        }\n        v = v * 10 + widen<i64>(c - b'0');\n    }\n    r.at += n;\n    v\n}fn toml"
    "_days_in_month(i64 year, i64 month) : i64\n{\n    if (month == 2)\n    {\n        bool leap = (year % 4 "
    "== 0 && year % 100 != 0) || year % 400 == 0;\n        return if (leap) { 29 } else { 28 };\n    }\n    "
    "if (month == 4 || month == 6 || month == 9 || month == 11) { 30 } else { 31 }\n}fn TomlReader::time_p"
    "art(ref<TomlReader, exclusive> r, ref<TomlDateTime, exclusive> d) : Result<void, ParseError>\n{\n    u"
    "size at = r.at;\n    i64 hour = TomlReader::fixed(r, 2);\n    if (hour < 0 || TomlReader::peek(r) != b"
    "':')\n    {\n        return Err(Invalid(r.at));\n    }\n    r.at += 1;\n    i64 minute = TomlReader::fixe"
    "d(r, 2);\n    if (minute < 0 || TomlReader::peek(r) != b':')\n    {\n        return Err(Invalid(r.at));"
    "\n    }\n    r.at += 1;\n    i64 second = TomlReader::fixed(r, 2);\n    if (second < 0)\n    {\n        re"
    "turn Err(Invalid(r.at));\n    }\n    if (hour > 23 || minute > 59 || second > 60)\n    {\n        return"
    " Err(Invalid(at));\n    }\n    d.hour = narrow<u8>(hour);\n    d.minute = narrow<u8>(minute);\n    d.sec"
    "ond = narrow<u8>(second);\n    if (TomlReader::peek(r) == b'.')\n    {\n        r.at += 1;\n        if ("
    "!ascii_is_digit(TomlReader::peek(r)))\n        {\n            return Err(Invalid(r.at));\n        }\n   "
    "     u32 nanos = 0;\n        usize digits = 0;\n        while (ascii_is_digit(TomlReader::peek(r)))\n  "
    "      {\n            if (digits < 9)\n            {\n                nanos = nanos * 10 + widen<u32>(To"
    "mlReader::peek(r) - b'0');\n            }\n            digits += 1;\n            r.at += 1;\n        }\n "
    "       while (digits < 9)\n        {\n            nanos = nanos * 10;\n            digits += 1;\n       "
    " }\n        d.nanoseconds = nanos;\n    }\n    Ok(())\n}fn TomlReader::datetime(ref<TomlReader, exclusiv"
    "e> r, bool has_date) : Result<Toml, ParseError>\n{\n    TomlDateTime d = TomlDateTime {\n        .kind "
    "= TomlLocalTime,\n        .year = 0,\n        .month = 0,\n        .day = 0,\n        .hour = 0,\n       "
    " .minute = 0,\n        .second = 0,\n        .nanoseconds = 0,\n        .offset_minutes = 0,\n    };\n   "
    " if (!has_date)\n    {\n        TomlReader::time_part(r, &mut d)?;\n        return Ok(TomlDateTime(d));"
    "\n    }\n    usize start = r.at;\n    i64 year = TomlReader::fixed(r, 4);\n    if (year < 0 || TomlReade"
    "r::peek(r) != b'-')\n    {\n        return Err(Invalid(r.at));\n    }\n    r.at += 1;\n    i64 month = To"
    "mlReader::fixed(r, 2);\n    if (month < 0 || TomlReader::peek(r) != b'-')\n    {\n        return Err(In"
    "valid(r.at));\n    }\n    r.at += 1;\n    i64 day = TomlReader::fixed(r, 2);\n    if (day < 0)\n    {\n   "
    "     return Err(Invalid(r.at));\n    }\n    if (month < 1 || month > 12 || day < 1 || day > toml_days_"
    "in_month(year, month))\n    {\n        return Err(Invalid(start));\n    }\n    d.year = year;\n    d.mont"
    "h = narrow<u8>(month);\n    d.day = narrow<u8>(day);\n    d.kind = TomlLocalDate;\n    u8 c = TomlReade"
    "r::peek(r);\n    if (c == b'T' || c == b't' || (c == b' ' && ascii_is_digit(TomlReader::peek_at(r, 1)"
    ")))\n    {\n        r.at += 1;\n        TomlReader::time_part(r, &mut d)?;\n        d.kind = TomlLocalDa"
    "teTime;\n        c = TomlReader::peek(r);\n        if (c == b'Z' || c == b'z')\n        {\n            r"
    ".at += 1;\n            d.kind = TomlOffsetDateTime;\n        }\n        else if (c == b'+' || c == b'-'"
    ")\n        {\n            usize at = r.at;\n            r.at += 1;\n            i64 oh = TomlReader::fix"
    "ed(r, 2);\n            if (oh < 0 || TomlReader::peek(r) != b':')\n            {\n                retur"
    "n Err(Invalid(r.at));\n            }\n            r.at += 1;\n            i64 om = TomlReader::fixed(r,"
    " 2);\n            if (om < 0)\n            {\n                return Err(Invalid(r.at));\n            }\n"
    "            if (oh > 23 || om > 59)\n            {\n                return Err(Invalid(at));\n         "
    "   }\n            i64 minutes = oh * 60 + om;\n            d.offset_minutes = narrow<i32>(if (c == b'-"
    "') { 0 - minutes } else { minutes });\n            d.kind = TomlOffsetDateTime;\n        }\n    }\n    O"
    "k(TomlDateTime(d))\n}fn TomlReader::date_ahead(ref<TomlReader, shared> r) : bool\n{\n    for (usize i ="
    " 0; i < 4; i += 1)\n    {\n        if (!ascii_is_digit(TomlReader::peek_at(r, i)))\n        {\n         "
    "   return false;\n        }\n    }\n    TomlReader::peek_at(r, 4) == b'-'\n}fn TomlReader::time_ahead(re"
    "f<TomlReader, shared> r) : bool\n{\n    ascii_is_digit(TomlReader::peek(r)) && ascii_is_digit(TomlRead"
    "er::peek_at(\n        r,\n        1,\n    )) && TomlReader::peek_at(r, 2) == b':'\n}fn TomlReader::word("
    "ref<TomlReader, exclusive> r, str word) : bool\n{\n    usize n = str_len(word);\n    for (usize i = 0; "
    "i < n; i += 1)\n    {\n        if (TomlReader::peek_at(r, i) != str_byte(word, i))\n        {\n         "
    "   return false;\n        }\n    }\n    r.at += n;\n    true\n}fn TomlReader::inline_table(ref<TomlReader"
    ", exclusive> r, usize depth) : Result<Toml, ParseError>\n{\n    TNode table = tnode_new(String::new(),"
    " K_HEADER, TomlBool(false));\n    Vec<String> ctx = Vec::new();\n    TomlReader::skip_ws(r);\n    if (T"
    "omlReader::peek(r) == b'}')\n    {\n        r.at += 1;\n        return Ok(tnode_to_toml(table));\n    }\n"
    "    while (true)\n    {\n        TomlReader::skip_ws(r);\n        usize key_at = r.at;\n        Vec<Stri"
    "ng> keys = TomlReader::key(r)?;\n        if (TomlReader::peek(r) != b'=')\n        {\n            retur"
    "n Err(Invalid(r.at));\n        }\n        r.at += 1;\n        TomlReader::skip_ws(r);\n        Toml v = "
    "TomlReader::value(r, depth + 1)?;\n        if (!tnode_insert(&mut table, &ctx, 0, &keys, 0, v))\n     "
    "   {\n            return Err(Invalid(key_at));\n        }\n        TomlReader::skip_ws(r);\n        u8 c"
    " = TomlReader::peek(r);\n        r.at += 1;\n        if (c == b'}')\n        {\n            return Ok(tn"
    "ode_to_toml(table));\n        }\n        if (c != b',')\n        {\n            return Err(Invalid(r.at "
    "- 1));\n        }\n    }\n}fn TomlReader::array_value(ref<TomlReader, exclusive> r, usize depth) : Resu"
    "lt<Toml, ParseError>\n{\n    Vec<Toml> items = Vec::new();\n    while (true)\n    {\n        TomlReader::"
    "skip_space_lines(r)?;\n        if (TomlReader::peek(r) == b']')\n        {\n            r.at += 1;\n    "
    "        return Ok(TomlArray(items));\n        }\n        Toml v = TomlReader::value(r, depth + 1)?;\n  "
    "      Vec::push(&mut items, v);\n        TomlReader::skip_space_lines(r)?;\n        u8 c = TomlReader:"
    ":peek(r);\n        if (c == b']')\n        {\n            r.at += 1;\n            return Ok(TomlArray(it"
    "ems));\n        }\n        if (c != b',')\n        {\n            return Err(Invalid(r.at));\n        }\n "
    "       r.at += 1;\n    }\n}fn TomlReader::value(ref<TomlReader, exclusive> r, usize depth) : Result<To"
    "ml, ParseError>\n{\n    u8 c = TomlReader::peek(r);\n    if (c == b'\"')\n    {\n        r.at += 1;\n      "
    "  if (TomlReader::peek(r) == b'\"' && TomlReader::peek_at(r, 1) == b'\"')\n        {\n            r.at +"
    "= 2;\n            return Ok(TomlString(TomlReader::basic(r, true)?));\n        }\n        return Ok(Tom"
    "lString(TomlReader::basic(r, false)?));\n    }\n    if (c == b'\\'')\n    {\n        r.at += 1;\n        i"
    "f (TomlReader::peek(r) == b'\\'' && TomlReader::peek_at(r, 1) == b'\\'')\n        {\n            r.at +="
    " 2;\n            return Ok(TomlString(TomlReader::literal(r, true)?));\n        }\n        return Ok(To"
    "mlString(TomlReader::literal(r, false)?));\n    }\n    if (c == b'[' || c == b'{')\n    {\n        if (d"
    "epth >= TOML_MAX_DEPTH)\n        {\n            return Err(OutOfRange);\n        }\n        r.at += 1;\n "
    "       return if (c == b'[') { TomlReader::array_value(r, depth) } else { TomlReader::inline_table(r"
    ", depth) };\n    }\n    if (TomlReader::word(r, \"true\"))\n    {\n        return Ok(TomlBool(true));\n    "
    "}\n    if (TomlReader::word(r, \"false\"))\n    {\n        return Ok(TomlBool(false));\n    }\n    if (Toml"
    "Reader::date_ahead(r))\n    {\n        return TomlReader::datetime(r, true);\n    }\n    if (TomlReader:"
    ":time_ahead(r))\n    {\n        return TomlReader::datetime(r, false);\n    }\n    if (c == b'+' || c =="
    " b'-' || c == b'i' || c == b'n' || ascii_is_digit(c))\n    {\n        return TomlReader::number(r);\n  "
    "  }\n    Err(Invalid(r.at))\n}export fn Toml::parse(StringView text) : Result<Toml, ParseError>\n{\n    "
    "TomlReader r = TomlReader { .text = text, .at = 0 };\n    TNode root = tnode_new(String::new(), K_HEA"
    "DER, TomlBool(false));\n    Vec<String> ctx = Vec::new();\n    while (true)\n    {\n        TomlReader::"
    "skip_ws(&mut r);\n        if (TomlReader::at_end(&r))\n        {\n            break;\n        }\n        "
    "u8 c = TomlReader::peek(&r);\n        if (c == b'#')\n        {\n            TomlReader::comment(&mut r"
    ")?;\n            continue;\n        }\n        if (TomlReader::newline(&mut r))\n        {\n            c"
    "ontinue;\n        }\n        if (c == b'[')\n        {\n            r.at += 1;\n            bool is_array"
    " = TomlReader::peek(&r) == b'[';\n            if (is_array)\n            {\n                r.at += 1;\n"
    "            }\n            TomlReader::skip_ws(&mut r);\n            usize key_at = r.at;\n            "
    "Vec<String> parts = TomlReader::key(&mut r)?;\n            if (TomlReader::peek(&r) != b']' || (is_ar"
    "ray && TomlReader::peek_at(&r, 1) != b']'))\n            {\n                return Err(Invalid(r.at));"
    "\n            }\n            r.at += if (is_array) { 2 } else { 1 };\n            if (!tnode_define(&mu"
    "t root, &parts, 0, is_array))\n            {\n                return Err(Invalid(key_at));\n           "
    " }\n            overwrite(&mut ctx, parts);\n            TomlReader::line_end(&mut r)?;\n            co"
    "ntinue;\n        }\n        usize key_at = r.at;\n        Vec<String> keys = TomlReader::key(&mut r)?;\n"
    "        if (TomlReader::peek(&r) != b'=')\n        {\n            return Err(Invalid(r.at));\n        }"
    "\n        r.at += 1;\n        TomlReader::skip_ws(&mut r);\n        Toml v = TomlReader::value(&mut r, "
    "0)?;\n        if (!tnode_insert(&mut root, &ctx, 0, &keys, 0, v))\n        {\n            return Err(In"
    "valid(key_at));\n        }\n        TomlReader::line_end(&mut r)?;\n    }\n    Ok(tnode_to_toml(root))\n}"
    "unittest \"Toml::parse: a configuration file\"\n{\n    Toml doc = Result::unwrap(Toml::parse(\"title = \\\""
    "Example\\\"\\n[owner]\\nname = \\\"Tom\\\"\\ndob = 1979-05-27T07:32:00-08:00\\n[database]\\nports = [ 8001, 800"
    "1, 8002 ]\\nenabled = true\\ntemp_targets = { cpu = 79.5, case = 72.0 }\\n[[servers]]\\nip = \\\"10.0.0.1\\"
    "\"\\n[[servers]]\\nip = \\\"10.0.0.2\\\"\\n\"));\n    assert(Option::unwrap(Toml::as_text(Option::unwrap(Toml:"
    ":lookup(&doc, \"owner.name\")))) == \"Tom\");\n    assert(Toml::as_i64(Option::unwrap(Toml::lookup(&doc, "
    "\"database.ports.2\"))) == Some(8002: i64));\n    assert(Toml::as_f64(Option::unwrap(Toml::lookup(&doc,"
    " \"database.temp_targets.cpu\"))) == Some(79.5));\n    assert(Option::unwrap(Toml::as_text(Option::unwr"
    "ap(Toml::lookup(&doc, \"servers.1.ip\")))) == \"10.0.0.2\");\n    TomlDateTime dob = Option::unwrap(Toml:"
    ":as_datetime(Option::unwrap(Toml::lookup(&doc, \"owner.dob\"))));\n    assert(dob.year == 1979 && dob.h"
    "our == 7 && dob.offset_minutes == -480);\n}unittest \"Toml::parse: where the error is\"\n{\n    match (To"
    "ml::parse(\"a = 1\\nb = \\n\"))\n    {\n        Err(Invalid(i)) : assert(i == 10),\n        _              "
    " : assert(false),\n    }\n    match (Toml::parse(\"a = 1\\na = 2\\n\"))\n    {\n        Err(Invalid(i)) : as"
    "sert(i == 6),\n        _               : assert(false),\n    }\n    match (Toml::parse(\"n = 92233720368"
    "54775808\"))\n    {\n        Err(OutOfRange) : {},\n        _               : assert(false),\n    }\n}fn t"
    "oml_quote(ref<String, exclusive> out, StringView s)\n{\n    str digits = \"0123456789ABCDEF\";\n    Strin"
    "g::push_ascii(out, b'\"');\n    for (usize i = 0; i < StringView::len(s); i += 1)\n    {\n        u8 b ="
    " s.bytes[i];\n        if (b >= 0x20 && b != b'\"' && b != b'\\\\' && b != 0x7F)\n        {\n            Ve"
    "c::push(&mut out.bytes, b);          // a multi-byte character's bytes, whole\n            continue;\n"
    "        }\n        String::push_ascii(out, b'\\\\');\n        if (b == b'\"') { String::push_ascii(out, b"
    "'\"'); }\n        else if (b == b'\\\\') { String::push_ascii(out, b'\\\\'); }\n        else if (b == 10) {"
    " String::push_ascii(out, b'n'); }\n        else if (b == 13) { String::push_ascii(out, b'r'); }\n     "
    "   else if (b == 9) { String::push_ascii(out, b't'); }\n        else if (b == 8) { String::push_ascii"
    "(out, b'b'); }\n        else if (b == 12) { String::push_ascii(out, b'f'); }\n        else\n        {\n "
    "           String::append(out, \"u00\");\n            String::push_ascii(out, str_byte(digits, widen<us"
    "ize>(b >> 4)));\n            String::push_ascii(out, str_byte(digits, widen<usize>(b & 15)));\n       "
    " }\n    }\n    String::push_ascii(out, b'\"');\n}fn toml_key(ref<String, exclusive> out, StringView key)"
    "\n{\n    bool bare = StringView::len(key) > 0;\n    for (usize i = 0; i < StringView::len(key); i += 1)"
    "\n    {\n        if (!toml_is_bare(key.bytes[i]))\n        {\n            bare = false;\n        }\n    }\n"
    "    if (bare)\n    {\n        String::append(out, key);\n    }\n    else\n    {\n        toml_quote(out, k"
    "ey);\n    }\n}fn toml_float(ref<String, exclusive> out, f64 x)\n{\n    if (x != x)\n    {\n        String:"
    ":append(out, \"nan\");\n    }\n    else if (!is_finite(x))\n    {\n        String::append(out, if (x > 0.0"
    ") { \"inf\" } else { \"-inf\" });\n    }\n    else\n    {\n        String::append(out, x);\n    }\n}fn toml_tw"
    "o_digits(ref<String, exclusive> out, u8 v)\n{\n    String::push_ascii(out, b'0' + v / 10);\n    String:"
    ":push_ascii(out, b'0' + v % 10);\n}export fn TomlDateTime::text(ref<TomlDateTime, shared> d) : String"
    "\n{\n    String out = String::new();\n    bool date = match (d.kind)\n    {\n        TomlLocalTime : fals"
    "e,\n        _             : true,\n    };\n    bool time = match (d.kind)\n    {\n        TomlLocalDate :"
    " false,\n        _             : true,\n    };\n    if (date)\n    {\n        i64 y = d.year;\n        if "
    "(y < 0)\n        {\n            String::push_ascii(&mut out, b'-');\n            y = 0 - y;\n        }\n "
    "       if (y < 1000) { String::push_ascii(&mut out, b'0'); }\n        if (y < 100) { String::push_asc"
    "ii(&mut out, b'0'); }\n        if (y < 10) { String::push_ascii(&mut out, b'0'); }\n        String::ap"
    "pend(&mut out, y);\n        String::push_ascii(&mut out, b'-');\n        toml_two_digits(&mut out, d.m"
    "onth);\n        String::push_ascii(&mut out, b'-');\n        toml_two_digits(&mut out, d.day);\n    }\n "
    "   if (date && time)\n    {\n        String::push_ascii(&mut out, b'T');\n    }\n    if (time)\n    {\n   "
    "     toml_two_digits(&mut out, d.hour);\n        String::push_ascii(&mut out, b':');\n        toml_two"
    "_digits(&mut out, d.minute);\n        String::push_ascii(&mut out, b':');\n        toml_two_digits(&mu"
    "t out, d.second);\n        if (d.nanoseconds > 0)\n        {\n            String::push_ascii(&mut out, "
    "b'.');\n            u32 n = d.nanoseconds;\n            u32 scale = 100000000;\n            while (n > "
    "0)\n            {\n                String::push_ascii(&mut out, b'0' + narrow<u8>(n / scale));\n       "
    "         n = n % scale;\n                scale = scale / 10;\n            }\n        }\n    }\n    match "
    "(d.kind)\n    {\n        TomlOffsetDateTime :\n        {\n            if (d.offset_minutes == 0)\n       "
    "     {\n                String::push_ascii(&mut out, b'Z');\n            }\n            else\n          "
    "  {\n                i32 m = d.offset_minutes;\n                String::push_ascii(&mut out, if (m < 0"
    ") { b'-' } else { b'+' });\n                if (m < 0)\n                {\n                    m = 0 - "
    "m;\n                }\n                toml_two_digits(&mut out, narrow<u8>(m / 60));\n                "
    "String::push_ascii(&mut out, b':');\n                toml_two_digits(&mut out, narrow<u8>(m % 60));\n "
    "           }\n        },\n        _                  : {},\n    }\n    out\n}unittest \"TomlDateTime::text"
    ": the four forms\"\n{\n    String text = \"a = 1979-05-27T07:32:00.999999Z\\nb = 1979-05-27T00:32:00.5-07"
    ":00\\nc = 1979-05-27T07:32:00\\nd = 1979-05-27\\ne = 07:32:00\\n\";\n    Toml doc = Result::unwrap(Toml::p"
    "arse(&text));\n    assert(Toml::text(&doc) == text);\n    TomlDateTime b = Option::unwrap(Toml::as_dat"
    "etime(Option::unwrap(Toml::get(&doc, \"b\"))));\n    assert(b.nanoseconds == 500000000 && b.offset_minu"
    "tes == -420 && TomlDateTime::text(&b) == \"1979-05-27T00:32:00.5-07:00\");\n}fn toml_is_table(ref<Toml,"
    " shared> v) : bool\n{\n    match (v)\n    {\n        TomlTable(_) : true,\n        _            : false,\n"
    "    }\n}fn toml_is_table_array(ref<Toml, shared> v) : bool\n{\n    match (v)\n    {\n        TomlArray(it"
    "ems) :\n        {\n            if (Vec::len(items) == 0)\n            {\n                return false;\n "
    "           }\n            for (usize i = 0; i < Vec::len(items); i += 1)\n            {\n              "
    "  if (!toml_is_table(&items[i]))\n                {\n                    return false;\n               "
    " }\n            }\n            true\n        },\n        _                : false,\n    }\n}fn toml_inline"
    "(ref<String, exclusive> out, ref<Toml, shared> v)\n{\n    match (v)\n    {\n        TomlString(s)      :"
    " toml_quote(out, s),\n        TomlInteger(i)     : String::append(out, *i),\n        TomlFloat(x)     "
    "  : toml_float(out, *x),\n        TomlBool(b)        : String::append(out, if (*b) { \"true\" } else { "
    "\"false\" }),\n        TomlDateTime(d)    : String::append(out, &TomlDateTime::text(d)),\n        TomlAr"
    "ray(items)   :\n        {\n            String::push_ascii(out, b'[');\n            for (usize i = 0; i "
    "< Vec::len(items); i += 1)\n            {\n                if (i > 0)\n                {\n              "
    "      String::append(out, \", \");\n                }\n                toml_inline(out, &items[i]);\n    "
    "        }\n            String::push_ascii(out, b']');\n        },\n        TomlTable(members) :\n       "
    " {\n            String::push_ascii(out, b'{');\n            for (usize i = 0; i < Vec::len(members); i"
    " += 1)\n            {\n                String::append(out, if (i > 0) { \", \" } else { \" \" });\n        "
    "        toml_key(out, &members[i].key);\n                String::append(out, \" = \");\n                "
    "toml_inline(out, &members[i].value);\n            }\n            String::append(out, if (Vec::len(memb"
    "ers) > 0) { \" }\" } else { \"}\" });\n        },\n    }\n}fn toml_write_table(ref<String, exclusive> out, "
    "ref<Vec<TomlMember>, shared> members, ref<String, shared> path)\n{\n    for (usize i = 0; i < Vec::len"
    "(members); i += 1)\n    {\n        ref<Toml, shared> v = &members[i].value;\n        if (toml_is_table("
    "v) || toml_is_table_array(v))\n        {\n            continue;\n        }\n        toml_key(out, &membe"
    "rs[i].key);\n        String::append(out, \" = \");\n        toml_inline(out, v);\n        String::push_as"
    "cii(out, b'\\n');\n    }\n    for (usize i = 0; i < Vec::len(members); i += 1)\n    {\n        ref<Toml, "
    "shared> v = &members[i].value;\n        bool table = toml_is_table(v);\n        if (!table && !toml_is"
    "_table_array(v))\n        {\n            continue;\n        }\n        String sub = clone(path);\n       "
    " if (StringView::len(&sub) > 0)\n        {\n            String::push_ascii(&mut sub, b'.');\n        }\n"
    "        toml_key(&mut sub, &members[i].key);\n        match (v)\n        {\n            TomlTable(inner"
    ") :\n            {\n                if (StringView::len(&(*out)[0..$]) > 0)\n                {\n        "
    "            String::push_ascii(out, b'\\n');\n                }\n                String::push_ascii(out"
    ", b'[');\n                String::append(out, &sub);\n                String::append(out, \"]\\n\");\n    "
    "            toml_write_table(out, inner, &sub);\n            },\n            TomlArray(items) :\n      "
    "      {\n                for (usize k = 0; k < Vec::len(items); k += 1)\n                {\n           "
    "         if (StringView::len(&(*out)[0..$]) > 0)\n                    {\n                        Strin"
    "g::push_ascii(out, b'\\n');\n                    }\n                    String::append(out, \"[[\");\n    "
    "                String::append(out, &sub);\n                    String::append(out, \"]]\\n\");\n        "
    "            match (&items[k])\n                    {\n                        TomlTable(inner) : toml_"
    "write_table(out, inner, &sub),\n                        _                : {},\n                    }\n"
    "                }\n            },\n            _                : {},\n        }\n    }\n}export fn Toml:"
    ":text(ref<Toml, shared> t) : String\n{\n    String out = String::new();\n    match (t)\n    {\n        To"
    "mlTable(members) :\n        {\n            String path = String::new();\n            toml_write_table(&"
    "mut out, members, &path);\n        },\n        _                  : toml_inline(&mut out, t),\n    }\n  "
    "  out\n}unittest \"Toml::text: the layout\"\n{\n    Toml doc = Result::unwrap(Toml::parse(\"[server]\\nhost"
    " = \\\"example.org\\\"\\nports = [80, 443]\\n[server.tls]\\ncert = 'a b'\\n[[users]]\\nname = \\\"ann\\\"\\n[[user"
    "s]]\\nname = \\\"bob\\\"\\n\"));\n    String t = Toml::text(&doc);\n    assert(t == \"[server]\\nhost = \\\"examp"
    "le.org\\\"\\nports = [80, 443]\\n\\n[server.tls]\\ncert = \\\"a b\\\"\\n\\n[[users]]\\nname = \\\"ann\\\"\\n\\n[[users]"
    "]\\nname = \\\"bob\\\"\\n\");\n    assert(Toml::text(&Result::unwrap(Toml::parse(&t))) == t);\n}export fn Tom"
    "l::get(ref<Toml, shared> t, StringView key) : Option<ref<Toml, shared>>\n{\n    match (t)\n    {\n      "
    "  TomlTable(members) :\n        {\n            for (usize i = 0; i < Vec::len(members); i += 1)\n      "
    "      {\n                if (members[i].key == key)\n                {\n                    return Some"
    "(&members[i].value);\n                }\n            }\n            None\n        },\n        _          "
    "        : None,\n    }\n}export fn Toml::at(ref<Toml, shared> t, usize i) : Option<ref<Toml, shared>>\n"
    "{\n    match (t)\n    {\n        TomlArray(items) : if (i < Vec::len(items)) { Some(&items[i]) } else {"
    " None },\n        _                : None,\n    }\n}export fn Toml::lookup(ref<Toml, shared> t, StringV"
    "iew path) : Option<ref<Toml, shared>>\n{\n    Vec<StringView> parts = StringView::split(path, \".\");\n  "
    "  ref<Toml, shared> cur = t;\n    for (usize i = 0; i < Vec::len(&parts); i += 1)\n    {\n        cur ="
    " match (cur)\n        {\n            TomlArray(_) : match (StringView::parse<usize>(parts[i]))\n       "
    "     {\n                Ok(k)  : Toml::at(cur, k)?,\n                Err(_) : return None,\n           "
    " },\n            _ : Toml::get(cur, parts[i])?,\n        };\n    }\n    Some(cur)\n}export fn Toml::as_te"
    "xt(ref<Toml, shared> t) : Option<StringView>\n{\n    match (t)\n    {\n        TomlString(s) : Some(s),\n"
    "        _             : None,\n    }\n}export fn Toml::as_i64(ref<Toml, shared> t) : Option<i64>\n{\n   "
    " match (t)\n    {\n        TomlInteger(i) : Some(*i),\n        _              : None,\n    }\n}export fn "
    "Toml::as_f64(ref<Toml, shared> t) : Option<f64>\n{\n    match (t)\n    {\n        TomlFloat(x) : Some(*x"
    "),\n        _            : None,\n    }\n}export fn Toml::as_bool(ref<Toml, shared> t) : Option<bool>\n{"
    "\n    match (t)\n    {\n        TomlBool(b) : Some(*b),\n        _           : None,\n    }\n}export fn To"
    "ml::as_datetime(ref<Toml, shared> t) : Option<TomlDateTime>\n{\n    match (t)\n    {\n        TomlDateTi"
    "me(d) : Some(*d),\n        _               : None,\n    }\n}export fn Toml::as_array(ref<Toml, shared> "
    "t) : Option<ref<Vec<Toml>, shared>>\n{\n    match (t)\n    {\n        TomlArray(items) : Some(items),\n  "
    "      _                : None,\n    }\n}export fn Toml::as_table(ref<Toml, shared> t) : Option<ref<Vec"
    "<TomlMember>, shared>>\n{\n    match (t)\n    {\n        TomlTable(members) : Some(members),\n        _  "
    "                : None,\n    }\n}export fn Toml::set(ref<Toml, exclusive> t, StringView key, Toml v)\n{"
    "\n    match (t)\n    {\n        TomlTable(members) :\n        {\n            for (usize i = 0; i < Vec::l"
    "en(members); i += 1)\n            {\n                if (members[i].key == key)\n                {\n    "
    "                overwrite(&mut members[i].value, v);\n                    return;\n                }\n "
    "           }\n            Vec::push(members, TomlMember { .key = String::from_view(key), .value = v }"
    ");\n        },\n        _                  : assert(false, \"Toml::set on a value that is not a table\")"
    ",\n    }\n}export fn Toml::push(ref<Toml, exclusive> t, Toml v)\n{\n    match (t)\n    {\n        TomlArra"
    "y(items) : Vec::push(items, v),\n        _                : assert(false, \"Toml::push on a value that"
    " is not an array\"),\n    }\n}unittest \"Toml::set: building a document\"\n{\n    Toml doc = TomlTable(Vec:"
    ":new());\n    Toml::set(&mut doc, \"name\", TomlString(\"demo\"));\n    Toml ports = TomlArray(Vec::new())"
    ";\n    Toml::push(&mut ports, TomlInteger(8080));\n    Toml::push(&mut ports, TomlInteger(8081));\n    "
    "Toml server = TomlTable(Vec::new());\n    Toml::set(&mut server, \"ports\", ports);\n    Toml::set(&mut "
    "server, \"debug\", TomlBool(false));\n    Toml::set(&mut doc, \"server\", server);\n    Toml::set(&mut doc"
    ", \"name\", TomlString(\"demo 2\"));\n    assert(Toml::text(&doc) == \"name = \\\"demo 2\\\"\\n\\n[server]\\nport"
    "s = [8080, 8081]\\ndebug = false\\n\");\n}export fn CompressError::text(ref<CompressError, shared> e) : "
    "str\n{\n    match (e)\n    {\n        Corrupt(_) : \"corrupt compressed data\",\n        Truncated  : \"comp"
    "ressed data ends early\",\n        Oversize   : \"decompressed data too large\",\n    }\n}fn BitReader::ta"
    "ke(ref<BitReader, exclusive> r, u32 n) : Result<u32, CompressError>\n{\n    while (r.count < n)\n    {\n"
    "        if (r.at >= slice_len(r.data))\n        {\n            return Err(Truncated);\n        }\n      "
    "  r.bits = r.bits | (widen<u32>(r.data[r.at]) << r.count);\n        r.at += 1;\n        r.count += 8;\n"
    "    }\n    u32 v = r.bits & ((1: u32 << n) - 1);\n    r.bits = r.bits >> n;\n    r.count -= n;\n    Ok(v"
    ")\n}fn BitReader::align(ref<BitReader, exclusive> r)\n{\n    r.bits = 0;\n    r.count = 0;\n}fn Huffman::"
    "build(slice<u8, shared> lengths) : Option<Huffman>\n{\n    array<u16, 16> counts = [0; 16];\n    for (u"
    "size i = 0; i < slice_len(lengths); i += 1)\n    {\n        counts[widen<usize>(lengths[i])] += 1;\n   "
    " }\n    counts[0] = 0;\n    i32 left = 1;\n    for (usize len = 1; len < 16; len += 1)\n    {\n        le"
    "ft = left * 2 - widen<i32>(counts[len]);\n        if (left < 0)\n        {\n            return None;\n  "
    "      }\n    }\n    array<u16, 16> offs = [0; 16];\n    for (usize len = 1; len < 15; len += 1)\n    {\n "
    "       offs[len + 1] = offs[len] + counts[len];\n    }\n    array<u16, 320> symbols = [0; 320];\n    fo"
    "r (usize i = 0; i < slice_len(lengths); i += 1)\n    {\n        if (lengths[i] != 0)\n        {\n       "
    "     symbols[widen<usize>(offs[widen<usize>(lengths[i])])] = narrow<u16>(i);\n            offs[widen<"
    "usize>(lengths[i])] += 1;\n        }\n    }\n    Some(Huffman { .counts = counts, .symbols = symbols })"
    "\n}fn Huffman::decode(ref<Huffman, shared> h, ref<BitReader, exclusive> r) : Result<u16, CompressErro"
    "r>\n{\n    HuffStep s = huff_step(r.data, h, r.at, r.bits, r.count);\n    r.at = s.at;\n    r.bits = s.b"
    "its;\n    r.count = s.count;\n    if (s.sym == -1)\n    {\n        return Err(Truncated);\n    }\n    if ("
    "s.sym < 0)\n    {\n        return Err(Corrupt(r.at));\n    }\n    Ok(narrow<u16>(s.sym))\n}fn huff_step(s"
    "lice<u8, shared> data, ref<Huffman, shared> h, usize at, u32 bits, u32 count) : HuffStep\n{\n    usize"
    " n = slice_len(data);\n    usize p = at;\n    u32 bb = bits;\n    u32 bc = count;\n    i32 code = 0;\n   "
    " i32 first = 0;\n    i32 index = 0;\n    for (usize len = 1; len < 16; len += 1)\n    {\n        if (bc "
    "== 0)\n        {\n            if (p >= n)\n            {\n                return HuffStep { .sym = -1, ."
    "at = p, .bits = bb, .count = bc };\n            }\n            bb = widen<u32>(data[p]);\n            p"
    " += 1;\n            bc = 8;\n        }\n        code = code | narrow<i32>(bb & 1);\n        bb = bb >> 1"
    ";\n        bc -= 1;\n        i32 c = widen<i32>(h.counts[len]);\n        if (code - c < first)\n        "
    "{\n            return HuffStep { .sym = widen<i32>(h.symbols[narrow<usize>(index + (code - first))]),"
    " .at = p, .bits = bb, .count = bc };\n        }\n        index += c;\n        first += c;\n        first"
    " = first << 1;\n        code = code << 1;\n    }\n    HuffStep { .sym = -2, .at = p, .bits = bb, .count"
    " = bc }\n}fn bits_step(slice<u8, shared> data, usize at, u32 bits, u32 count, u32 need) : BitsStep\n{\n"
    "    usize p = at;\n    u32 bb = bits;\n    u32 bc = count;\n    while (bc < need)\n    {\n        if (p >"
    "= slice_len(data))\n        {\n            return BitsStep { .ok = false, .v = 0, .at = p, .bits = bb,"
    " .count = bc };\n        }\n        bb = bb | (widen<u32>(data[p]) << bc);\n        p += 1;\n        bc "
    "+= 8;\n    }\n    u32 v = bb & ((1: u32 << need) - 1);\n    BitsStep { .ok = true, .v = v, .at = p, .bi"
    "ts = bb >> need, .count = bc - need }\n}fn fixed_codes() : Huffman\n{\n    Vec<u8> lit = Vec::filled(28"
    "8, 8: u8);\n    for (usize i = 144; i < 256; i += 1)\n    {\n        lit[i] = 9;\n    }\n    for (usize i"
    " = 256; i < 280; i += 1)\n    {\n        lit[i] = 7;\n    }\n    Option::unwrap(Huffman::build(&lit[0..$"
    "]))\n}fn fixed_distances() : Huffman\n{\n    Vec<u8> d = Vec::filled(30, 5: u8);\n    Option::unwrap(Huf"
    "fman::build(&d[0..$]))\n}fn inflate_codes(\n    ref<BitReader, exclusive> r,\n    ref<Vec<u8>, exclusiv"
    "e> out,\n    ref<Huffman, shared> lit,\n    ref<Huffman, shared> dist,\n    usize max,\n) : Result<void,"
    " CompressError>\n{\n    Vec<u8> o = replace(out, Vec::new());\n    InflateRun { bytes, pos, bitbuf, nbi"
    "ts, status } = inflate_run(r.data, lit, dist, o, r.at, r.bits, r.count, max);\n    r.at = pos;\n    r."
    "bits = bitbuf;\n    r.count = nbits;\n    overwrite(out, bytes);\n    if (status == 1)\n    {\n        re"
    "turn Err(Truncated);\n    }\n    if (status == 2)\n    {\n        return Err(Corrupt(r.at));\n    }\n    i"
    "f (status == 3)\n    {\n        return Err(Oversize);\n    }\n    Ok(())\n}fn inflate_run(\n    slice<u8, "
    "shared> data,\n    ref<Huffman, shared> lit,\n    ref<Huffman, shared> dist,\n    Vec<u8> out,\n    usiz"
    "e at0,\n    u32 bits0,\n    u32 count0,\n    usize max,\n) : InflateRun\n{\n    usize at = at0;\n    u32 bi"
    "ts = bits0;\n    u32 count = count0;\n    u32 status = 0;\n    while (true)\n    {\n        HuffStep s = "
    "huff_step(data, lit, at, bits, count);\n        at = s.at;\n        bits = s.bits;\n        count = s.c"
    "ount;\n        if (s.sym < 0)\n        {\n            status = if (s.sym == -1) { 1 } else { 2 };\n     "
    "       break;\n        }\n        if (s.sym < 256)\n        {\n            if (Vec::len(&out) >= max)\n  "
    "          {\n                status = 3;\n                break;\n            }\n            Vec::push(&"
    "mut out, narrow<u8>(s.sym));\n            continue;\n        }\n        if (s.sym == 256)\n        {\n   "
    "         break;\n        }\n        usize li = narrow<usize>(s.sym) - 257;\n        if (li >= 29)\n     "
    "   {\n            status = 2;\n            break;\n        }\n        BitsStep e = bits_step(data, at, b"
    "its, count, widen<u32>(LENGTH_EXTRA[li]));\n        at = e.at;\n        bits = e.bits;\n        count ="
    " e.count;\n        if (!e.ok)\n        {\n            status = 1;\n            break;\n        }\n        "
    "usize len = widen<usize>(LENGTH_BASE[li]) + narrow<usize>(e.v);\n        HuffStep d = huff_step(data,"
    " dist, at, bits, count);\n        at = d.at;\n        bits = d.bits;\n        count = d.count;\n        "
    "if (d.sym < 0)\n        {\n            status = if (d.sym == -1) { 1 } else { 2 };\n            break;\n"
    "        }\n        usize di = narrow<usize>(d.sym);\n        if (di >= 30)\n        {\n            statu"
    "s = 2;\n            break;\n        }\n        BitsStep f = bits_step(data, at, bits, count, widen<u32>"
    "(DIST_EXTRA[di]));\n        at = f.at;\n        bits = f.bits;\n        count = f.count;\n        if (!f"
    ".ok)\n        {\n            status = 1;\n            break;\n        }\n        usize distance = widen<u"
    "size>(DIST_BASE[di]) + narrow<usize>(f.v);\n        if (distance > Vec::len(&out))\n        {\n        "
    "    status = 2;\n            break;\n        }\n        if (Vec::len(&out) + len > max)\n        {\n     "
    "       status = 3;\n            break;\n        }\n        usize from = Vec::len(&out) - distance;\n    "
    "    for (usize k = 0; k < len; k += 1)\n        {\n            u8 b = out[from + k];\n            Vec::"
    "push(&mut out, b);\n        }\n    }\n    InflateRun { .bytes = out, .pos = at, .bitbuf = bits, .nbits "
    "= count, .status = status }\n}fn read_dynamic(\n    ref<BitReader, exclusive> r,\n    ref<Option<Huffma"
    "n>, exclusive> lit,\n    ref<Option<Huffman>, exclusive> dist,\n) : Result<void, CompressError>\n{\n    "
    "usize nlen = narrow<usize>(BitReader::take(r, 5)?) + 257;\n    usize ndist = narrow<usize>(BitReader:"
    ":take(r, 5)?) + 1;\n    usize ncode = narrow<usize>(BitReader::take(r, 4)?) + 4;\n    if (nlen > 286 |"
    "| ndist > 30)\n    {\n        return Err(Corrupt(r.at));\n    }\n    Vec<u8> clens = Vec::filled(19, 0: "
    "u8);\n    for (usize i = 0; i < ncode; i += 1)\n    {\n        clens[widen<usize>(CLEN_ORDER[i])] = nar"
    "row<u8>(BitReader::take(r, 3)?);\n    }\n    Huffman ccode = match (Huffman::build(&clens[0..$]))\n    "
    "{\n        Some(h) : h,\n        None    : return Err(Corrupt(r.at)),\n    };\n    Vec<u8> lengths = Vec"
    "::new();\n    while (Vec::len(&lengths) < nlen + ndist)\n    {\n        u16 sym = Huffman::decode(&ccod"
    "e, r)?;\n        if (sym < 16)\n        {\n            Vec::push(&mut lengths, narrow<u8>(sym));\n      "
    "      continue;\n        }\n        u8 value = 0;\n        usize repeat = 0;\n        if (sym == 16)\n   "
    "     {\n            if (Vec::len(&lengths) == 0)\n            {\n                return Err(Corrupt(r.a"
    "t));\n            }\n            value = lengths[Vec::len(&lengths) - 1];\n            repeat = 3 + nar"
    "row<usize>(BitReader::take(r, 2)?);\n        }\n        else if (sym == 17)\n        {\n            repe"
    "at = 3 + narrow<usize>(BitReader::take(r, 3)?);\n        }\n        else\n        {\n            repeat "
    "= 11 + narrow<usize>(BitReader::take(r, 7)?);\n        }\n        if (Vec::len(&lengths) + repeat > nl"
    "en + ndist)\n        {\n            return Err(Corrupt(r.at));\n        }\n        for (usize k = 0; k <"
    " repeat; k += 1)\n        {\n            Vec::push(&mut lengths, value);\n        }\n    }\n    if (lengt"
    "hs[256] == 0)\n    {\n        return Err(Corrupt(r.at));\n    }\n    match (Huffman::build(&lengths[0..n"
    "len]))\n    {\n        Some(h) : overwrite(lit, Some(h)),\n        None    : return Err(Corrupt(r.at)),"
    "\n    }\n    match (Huffman::build(&lengths[nlen..nlen + ndist]))\n    {\n        Some(h) : overwrite(di"
    "st, Some(h)),\n        None    : return Err(Corrupt(r.at)),\n    }\n    Ok(())\n}fn inflate_from(\n    sl"
    "ice<u8, shared> data,\n    usize start,\n    ref<Vec<u8>, exclusive> out,\n    usize max,\n) : Result<us"
    "ize, CompressError>\n{\n    BitReader r = BitReader { .data = data, .at = start, .bits = 0, .count = 0"
    " };\n    Huffman fixed_lit = fixed_codes();\n    Huffman fixed_dist = fixed_distances();\n    while (tr"
    "ue)\n    {\n        u32 last = BitReader::take(&mut r, 1)?;\n        u32 kind = BitReader::take(&mut r,"
    " 2)?;\n        if (kind == 0)\n        {\n            BitReader::align(&mut r);\n            if (r.at + "
    "4 > slice_len(data))\n            {\n                return Err(Truncated);\n            }\n            "
    "usize len = widen<usize>(read_le<u16>(data, r.at));\n            usize nlen = widen<usize>(read_le<u1"
    "6>(data, r.at + 2));\n            if (len != (nlen ^ 0xFFFF))\n            {\n                return Er"
    "r(Corrupt(r.at));\n            }\n            r.at += 4;\n            if (r.at + len > slice_len(data))"
    "\n            {\n                return Err(Truncated);\n            }\n            if (Vec::len(out) + "
    "len > max)\n            {\n                return Err(Oversize);\n            }\n            Vec::extend"
    "_from(out, &data[r.at..r.at + len]);\n            r.at += len;\n        }\n        else if (kind == 1)\n"
    "        {\n            inflate_codes(&mut r, out, &fixed_lit, &fixed_dist, max)?;\n        }\n        e"
    "lse if (kind == 2)\n        {\n            Option<Huffman> lit = None;\n            Option<Huffman> dis"
    "t = None;\n            read_dynamic(&mut r, &mut lit, &mut dist)?;\n            inflate_codes(&mut r, "
    "out, &Option::unwrap(lit), &Option::unwrap(dist), max)?;\n        }\n        else\n        {\n          "
    "  return Err(Corrupt(r.at));\n        }\n        if (last == 1)\n        {\n            // The bits left"
    " in the reader's buffer belong to no block; the\n            // position after the block is the next "
    "whole byte.\n            return Ok(r.at);\n        }\n    }\n}export fn inflate(slice<u8, shared> data, "
    "usize max) : Result<Vec<u8>, CompressError>\n{\n    Vec<u8> out = Vec::new();\n    inflate_from(data, 0"
    ", &mut out, max)?;\n    Ok(out)\n}fn BitWriter::put(ref<BitWriter, exclusive> w, u32 value, u32 n)\n{\n "
    "   w.bits = w.bits | (widen<u64>(value) << w.count);\n    w.count += n;\n    while (w.count >= 8)\n    "
    "{\n        Vec::push(&mut w.out, narrow_wrapping<u8>(w.bits));\n        w.bits = w.bits >> 8;\n        "
    "w.count -= 8;\n    }\n}fn BitWriter::put_code(ref<BitWriter, exclusive> w, u32 code, u32 len)\n{\n    u3"
    "2 rev = 0;\n    for (u32 i = 0; i < len; i += 1)\n    {\n        rev = (rev << 1) | ((code >> i) & 1);\n"
    "    }\n    BitWriter::put(w, rev, len);\n}fn BitWriter::flush(ref<BitWriter, exclusive> w)\n{\n    if (w"
    ".count > 0)\n    {\n        Vec::push(&mut w.out, narrow_wrapping<u8>(w.bits));\n        w.bits = 0;\n  "
    "      w.count = 0;\n    }\n}fn code_lengths(slice<u32, shared> freq, usize limit) : Vec<u8>\n{\n    usiz"
    "e n = slice_len(freq);\n    Vec<u8> lengths = Vec::filled(n, 0: u8);\n    Vec<u32> f = Vec::from_slice"
    "(freq);\n    usize used = 0;\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (f[i] > 0)\n       "
    " {\n            used += 1;\n        }\n    }\n    if (used == 0)\n    {\n        return lengths;\n    }\n   "
    " if (used == 1)\n    {\n        for (usize i = 0; i < n; i += 1)\n        {\n            if (f[i] > 0)\n "
    "           {\n                lengths[i] = 1;\n            }\n        }\n        return lengths;\n    }\n "
    "   while (true)\n    {\n        // Nodes 0..n are the symbols, n.. the merges; each node's weight,\n   "
    "     // parent and depth.\n        Vec<u64> weight = Vec::new();\n        Vec<usize> parent = Vec::new"
    "();\n        Vec<bool> alive = Vec::new();\n        for (usize i = 0; i < n; i += 1)\n        {\n       "
    "     Vec::push(&mut weight, widen<u64>(f[i]));\n            Vec::push(&mut parent, 0);\n            Ve"
    "c::push(&mut alive, f[i] > 0);\n        }\n        usize live = used;\n        while (live > 1)\n       "
    " {\n            usize a = n * 2;\n            usize b = n * 2;\n            for (usize i = 0; i < Vec::"
    "len(&weight); i += 1)\n            {\n                if (!alive[i])\n                {\n               "
    "     continue;\n                }\n                if (a == n * 2 || weight[i] < weight[a])\n          "
    "      {\n                    b = a;\n                    a = i;\n                }\n                else"
    " if (b == n * 2 || weight[i] < weight[b])\n                {\n                    b = i;\n             "
    "   }\n            }\n            usize m = Vec::len(&weight);\n            Vec::push(&mut weight, weigh"
    "t[a] + weight[b]);\n            Vec::push(&mut parent, 0);\n            Vec::push(&mut alive, true);\n "
    "           alive[a] = false;\n            alive[b] = false;\n            parent[a] = m;\n            pa"
    "rent[b] = m;\n            live -= 1;\n        }\n        usize root = Vec::len(&weight) - 1;\n        us"
    "ize deepest = 0;\n        for (usize i = 0; i < n; i += 1)\n        {\n            if (f[i] == 0)\n     "
    "       {\n                continue;\n            }\n            usize d = 0;\n            usize at = i;\n"
    "            while (at != root)\n            {\n                at = parent[at];\n                d += 1"
    ";\n            }\n            lengths[i] = narrow<u8>(d);\n            if (d > deepest)\n            {\n "
    "               deepest = d;\n            }\n        }\n        if (deepest <= limit)\n        {\n        "
    "    return lengths;\n        }\n        for (usize i = 0; i < n; i += 1)\n        {\n            if (f[i"
    "] > 0)\n            {\n                f[i] = (f[i] >> 1) | 1;\n            }\n        }\n    }\n}fn canon"
    "ical_codes(slice<u8, shared> lengths) : Vec<u32>\n{\n    array<u32, 16> count = [0; 16];\n    for (usiz"
    "e i = 0; i < slice_len(lengths); i += 1)\n    {\n        count[widen<usize>(lengths[i])] += 1;\n    }\n "
    "   count[0] = 0;\n    array<u32, 16> next = [0; 16];\n    u32 code = 0;\n    for (usize len = 1; len < "
    "16; len += 1)\n    {\n        code = (code + count[len - 1]) << 1;\n        next[len] = code;\n    }\n   "
    " Vec<u32> codes = Vec::filled(slice_len(lengths), 0: u32);\n    for (usize i = 0; i < slice_len(lengt"
    "hs); i += 1)\n    {\n        usize l = widen<usize>(lengths[i]);\n        if (l != 0)\n        {\n       "
    "     codes[i] = next[l];\n            next[l] += 1;\n        }\n    }\n    codes\n}fn length_code(usize l"
    "en) : usize\n{\n    usize c = 28;\n    for (usize i = 0; i < 28; i += 1)\n    {\n        if (len < widen<"
    "usize>(LENGTH_BASE[i + 1]))\n        {\n            c = i;\n            break;\n        }\n    }\n    c\n}f"
    "n distance_code(usize d) : usize\n{\n    usize c = 29;\n    for (usize i = 0; i < 29; i += 1)\n    {\n   "
    "     if (d < widen<usize>(DIST_BASE[i + 1]))\n        {\n            c = i;\n            break;\n       "
    " }\n    }\n    c\n}fn hash3(slice<u8, shared> d, usize i) : usize\n{\n    ((widen<usize>(d[i]) << 10) ^ ("
    "widen<usize>(d[i + 1]) << 5) ^ widen<usize>(d[i + 2])) & (HASH_SIZE - 1)\n}fn token_counts(slice<Toke"
    "n, shared> tokens) : TokenCounts\n{\n    array<u32, 286> lit = [0; 286];\n    array<u32, 30> dist = [0;"
    " 30];\n    u64 extra = 0;\n    for (usize k = 0; k < slice_len(tokens); k += 1)\n    {\n        u16 l = "
    "tokens[k].lit;\n        lit[widen<usize>(l)] += 1;\n        if (l >= 256)\n        {\n            dist[w"
    "iden<usize>(tokens[k].dist_code)] += 1;\n            extra += widen<u64>(tokens[k].len_extra_bits) + "
    "widen<u64>(tokens[k].dist_extra_bits);\n        }\n    }\n    TokenCounts { .lit = lit, .dist = dist, ."
    "extra = extra }\n}fn write_block(ref<BitWriter, exclusive> w, slice<Token, shared> tokens, slice<u8, "
    "shared> raw, bool last)\n{\n    // Frequencies, with the end-of-block symbol.\n    TokenCounts counts ="
    " token_counts(tokens);\n    Vec<u32> lf = Vec::from_slice(&counts.lit[0..$]);\n    Vec<u32> df = Vec::"
    "from_slice(&counts.dist[0..$]);\n    lf[256] += 1;\n    Vec<u8> ll = code_lengths(&lf[0..$], 15);\n    "
    "Vec<u8> dl = code_lengths(&df[0..$], 15);\n    // The fixed code's lengths, for its cost.\n    Vec<u8>"
    " fl = Vec::filled(288, 8: u8);\n    for (usize i = 144; i < 256; i += 1)\n    {\n        fl[i] = 9;\n   "
    " }\n    for (usize i = 256; i < 280; i += 1)\n    {\n        fl[i] = 7;\n    }\n    u64 extra = counts.ex"
    "tra;\n    u64 cost_fixed = extra;\n    u64 cost_dyn = extra;\n    for (usize i = 0; i < 286; i += 1)\n  "
    "  {\n        cost_fixed += widen<u64>(lf[i]) * widen<u64>(fl[i]);\n        cost_dyn += widen<u64>(lf[i"
    "]) * widen<u64>(ll[i]);\n    }\n    for (usize i = 0; i < 30; i += 1)\n    {\n        cost_fixed += wide"
    "n<u64>(df[i]) * 5;\n        cost_dyn += widen<u64>(df[i]) * widen<u64>(dl[i]);\n    }\n    // The dynam"
    "ic header: the code lengths run-length coded.\n    usize nlen = 286;\n    while (nlen > 257 && ll[nlen"
    " - 1] == 0)\n    {\n        nlen -= 1;\n    }\n    usize ndist = 30;\n    while (ndist > 1 && dl[ndist - "
    "1] == 0)\n    {\n        ndist -= 1;\n    }\n    Vec<u8> all = Vec::new();\n    Vec::extend_from(&mut all"
    ", &ll[0..nlen]);\n    Vec::extend_from(&mut all, &dl[0..ndist]);\n    // Run-length symbols: (symbol, "
    "extra value, extra bits).\n    Vec<u8> rl_sym = Vec::new();\n    Vec<u8> rl_val = Vec::new();\n    Vec<"
    "u8> rl_bits = Vec::new();\n    usize i = 0;\n    while (i < Vec::len(&all))\n    {\n        u8 v = all[i"
    "];\n        usize run = 1;\n        while (i + run < Vec::len(&all) && all[i + run] == v)\n        {\n  "
    "          run += 1;\n        }\n        if (v == 0 && run >= 3)\n        {\n            usize r = if (ru"
    "n > 138) { 138 } else { run };\n            if (r <= 10)\n            {\n                Vec::push(&mut"
    " rl_sym, 17);\n                Vec::push(&mut rl_val, narrow<u8>(r - 3));\n                Vec::push(&"
    "mut rl_bits, 3);\n            }\n            else\n            {\n                Vec::push(&mut rl_sym,"
    " 18);\n                Vec::push(&mut rl_val, narrow<u8>(r - 11));\n                Vec::push(&mut rl_"
    "bits, 7);\n            }\n            i += r;\n        }\n        else if (v != 0 && run >= 4)\n        {"
    "\n            Vec::push(&mut rl_sym, v);\n            Vec::push(&mut rl_val, 0);\n            Vec::push"
    "(&mut rl_bits, 0);\n            usize r = if (run - 1 > 6) { 6 } else { run - 1 };\n            Vec::p"
    "ush(&mut rl_sym, 16);\n            Vec::push(&mut rl_val, narrow<u8>(r - 3));\n            Vec::push(&"
    "mut rl_bits, 2);\n            i += 1 + r;\n        }\n        else\n        {\n            Vec::push(&mut"
    " rl_sym, v);\n            Vec::push(&mut rl_val, 0);\n            Vec::push(&mut rl_bits, 0);\n        "
    "    i += 1;\n        }\n    }\n    Vec<u32> cf = Vec::filled(19, 0: u32);\n    foreach (s in &rl_sym)\n  "
    "  {\n        cf[widen<usize>(*s)] += 1;\n    }\n    Vec<u8> cl = code_lengths(&cf[0..$], 7);\n    usize "
    "ncode = 19;\n    while (ncode > 4 && cl[widen<usize>(CLEN_ORDER[ncode - 1])] == 0)\n    {\n        ncod"
    "e -= 1;\n    }\n    cost_dyn += 14 + widen<u64>(ncode) * 3;\n    for (usize k = 0; k < Vec::len(&rl_sym"
    "); k += 1)\n    {\n        cost_dyn += widen<u64>(cl[widen<usize>(rl_sym[k])]) + widen<u64>(rl_bits[k]"
    ");\n    }\n    u64 cost_stored = widen<u64>(slice_len(raw)) * 8 + 40 * (widen<u64>(slice_len(raw)) / 6"
    "5535 + 1);\n    if (cost_stored <= cost_fixed && cost_stored <= cost_dyn)\n    {\n        // Stored blo"
    "cks of at most 65535 bytes, the last marked.\n        usize at = 0;\n        while (true)\n        {\n  "
    "          usize take = if (slice_len(raw) - at > 65535) { 65535 } else { slice_len(raw) - at };\n    "
    "        bool final = last && at + take == slice_len(raw);\n            BitWriter::put(w, if (final) {"
    " 1 } else { 0 }, 1);\n            BitWriter::put(w, 0, 2);\n            BitWriter::flush(w);\n         "
    "   Vec::push_le(&mut w.out, narrow<u16>(take));\n            Vec::push_le(&mut w.out, narrow<u16>(tak"
    "e ^ 0xFFFF));\n            Vec::extend_from(&mut w.out, &raw[at..at + take]);\n            at += take;"
    "\n            if (at >= slice_len(raw))\n            {\n                return;\n            }\n        }"
    "\n    }\n    BitWriter::put(w, if (last) { 1 } else { 0 }, 1);\n    Vec<u32> lcodes = Vec::new();\n    V"
    "ec<u8> llens = Vec::new();\n    Vec<u32> dcodes = Vec::new();\n    Vec<u8> dlens = Vec::new();\n    if "
    "(cost_fixed <= cost_dyn)\n    {\n        BitWriter::put(w, 1, 2);\n        overwrite(&mut lcodes, canon"
    "ical_codes(&fl[0..$]));\n        overwrite(&mut llens, fl);\n        Vec<u8> fd = Vec::filled(30, 5: u"
    "8);\n        overwrite(&mut dcodes, canonical_codes(&fd[0..$]));\n        overwrite(&mut dlens, fd);\n "
    "   }\n    else\n    {\n        BitWriter::put(w, 2, 2);\n        BitWriter::put(w, narrow<u32>(nlen - 25"
    "7), 5);\n        BitWriter::put(w, narrow<u32>(ndist - 1), 5);\n        BitWriter::put(w, narrow<u32>("
    "ncode - 4), 4);\n        for (usize k = 0; k < ncode; k += 1)\n        {\n            BitWriter::put(w,"
    " widen<u32>(cl[widen<usize>(CLEN_ORDER[k])]), 3);\n        }\n        Vec<u32> ccodes = canonical_code"
    "s(&cl[0..$]);\n        for (usize k = 0; k < Vec::len(&rl_sym); k += 1)\n        {\n            usize s"
    " = widen<usize>(rl_sym[k]);\n            BitWriter::put_code(w, ccodes[s], widen<u32>(cl[s]));\n      "
    "      if (rl_bits[k] > 0)\n            {\n                BitWriter::put(w, widen<u32>(rl_val[k]), wid"
    "en<u32>(rl_bits[k]));\n            }\n        }\n        overwrite(&mut lcodes, canonical_codes(&ll[0.."
    "$]));\n        overwrite(&mut llens, ll);\n        overwrite(&mut dcodes, canonical_codes(&dl[0..$]));"
    "\n        overwrite(&mut dlens, dl);\n    }\n    Vec<u8> o = replace(&mut w.out, Vec::new());\n    BitOu"
    "t { buf, acc, nacc } = put_tokens(\n        o,\n        w.bits,\n        w.count,\n        tokens,\n     "
    "   &lcodes[0..$],\n        &llens[0..$],\n        &dcodes[0..$],\n        &dlens[0..$],\n    );\n    over"
    "write(&mut w.out, buf);\n    w.bits = acc;\n    w.count = nacc;\n}fn put_tokens(\n    Vec<u8> out,\n    u"
    "64 bits0,\n    u32 count0,\n    slice<Token, shared> tokens,\n    slice<u32, shared> lcodes,\n    slice<"
    "u8, shared> llens,\n    slice<u32, shared> dcodes,\n    slice<u8, shared> dlens,\n) : BitOut\n{\n    u64 "
    "bits = bits0;\n    u32 count = count0;\n    usize nt = slice_len(tokens);\n    for (usize k = 0; k <= n"
    "t; k += 1)\n    {\n        // Up to four fields per token: its code (or, after the last, the\n        /"
    "/ end code), then for a match the length's extra bits, the\n        // distance's code and its extra "
    "bits. A code goes most\n        // significant bit first: reversed.\n        usize s = if (k < nt) { w"
    "iden<usize>(tokens[k].lit) } else { 256 };\n        for (usize f = 0; f < 4; f += 1)\n        {\n      "
    "      u32 v = 0;\n            u32 n = 0;\n            if (f == 0)\n            {\n                u32 co"
    "de = lcodes[s];\n                n = widen<u32>(llens[s]);\n                for (u32 i = 0; i < n; i +"
    "= 1)\n                {\n                    v = (v << 1) | ((code >> i) & 1);\n                }\n     "
    "       }\n            else if (s >= 257)\n            {\n                if (f == 1)\n                {\n"
    "                    v = widen<u32>(tokens[k].len_extra);\n                    n = widen<u32>(tokens[k"
    "].len_extra_bits);\n                }\n                else if (f == 2)\n                {\n            "
    "        usize d = widen<usize>(tokens[k].dist_code);\n                    u32 code = dcodes[d];\n     "
    "               n = widen<u32>(dlens[d]);\n                    for (u32 i = 0; i < n; i += 1)\n        "
    "            {\n                        v = (v << 1) | ((code >> i) & 1);\n                    }\n      "
    "          }\n                else\n                {\n                    v = widen<u32>(tokens[k].dist"
    "_extra);\n                    n = widen<u32>(tokens[k].dist_extra_bits);\n                }\n          "
    "  }\n            if (n == 0)\n            {\n                continue;\n            }\n            bits ="
    " bits | (widen<u64>(v) << count);\n            count += n;\n            while (count >= 8)\n           "
    " {\n                Vec::push(&mut out, narrow_wrapping<u8>(bits));\n                bits = bits >> 8;"
    "\n                count -= 8;\n            }\n        }\n    }\n    BitOut { .buf = out, .acc = bits, .na"
    "cc = count }\n}fn deflate_scan(slice<u8, shared> data, Vec<usize> head, Vec<usize> prev, Vec<Token> t"
    "okens, usize start) : DeflateScan\n{\n    usize n = slice_len(data);\n    usize i = start;\n    while (i"
    " < n && Vec::len(&tokens) < MAX_TOKENS)\n    {\n        usize best_len = 0;\n        usize best_dist = "
    "0;\n        if (i + 3 <= n)\n        {\n            usize h = ((widen<usize>(data[i]) << 10) ^ (widen<u"
    "size>(data[i + 1]) << 5) ^ widen<usize>(data[i + 2])) & (HASH_SIZE - 1);\n            usize cand = he"
    "ad[h];\n            usize chain = 0;\n            usize limit = if (n - i > 258) { 258 } else { n - i "
    "};\n            while (cand != max_value<usize>() && i - cand <= WINDOW && chain < CHAIN_LIMIT)\n     "
    "       {\n                if (data[cand + best_len] == data[i + best_len])\n                {\n        "
    "            usize l = 0;\n                    while (l < limit && data[cand + l] == data[i + l])\n    "
    "                {\n                        l += 1;\n                    }\n                    if (l > "
    "best_len)\n                    {\n                        best_len = l;\n                        best_d"
    "ist = i - cand;\n                        if (l == limit)\n                        {\n                  "
    "          break;\n                        }\n                    }\n                }\n                u"
    "size next = prev[cand & (WINDOW - 1)];\n                if (next == max_value<usize>() || next >= can"
    "d)\n                {\n                    break;\n                }\n                cand = next;\n     "
    "           chain += 1;\n            }\n            prev[i & (WINDOW - 1)] = head[h];\n            head["
    "h] = i;\n        }\n        if (best_len >= 3)\n        {\n            usize lc = length_code(best_len);"
    "\n            usize dc = distance_code(best_dist);\n            Vec::push(&mut tokens, Token {\n       "
    "         .lit = narrow<u16>(257 + lc),\n                .len_extra = narrow<u16>(best_len - widen<usi"
    "ze>(LENGTH_BASE[lc])),\n                .len_extra_bits = LENGTH_EXTRA[lc],\n                .dist_cod"
    "e = narrow<u8>(dc),\n                .dist_extra = narrow<u16>(best_dist - widen<usize>(DIST_BASE[dc]"
    ")),\n                .dist_extra_bits = DIST_EXTRA[dc],\n            });\n            // The bytes insi"
    "de the match enter the hash chains too.\n            for (usize k = 1; k < best_len; k += 1)\n        "
    "    {\n                if (i + k + 3 <= n)\n                {\n                    usize h = ((widen<us"
    "ize>(data[i + k]) << 10) ^ (widen<usize>(data[i + k + 1]) << 5) ^ widen<usize>(data[i + k + 2])) & ("
    "HASH_SIZE - 1);\n                    prev[(i + k) & (WINDOW - 1)] = head[h];\n                    head"
    "[h] = i + k;\n                }\n            }\n            i += best_len;\n        }\n        else\n     "
    "   {\n            Vec::push(\n                &mut tokens,\n                Token { .lit = widen<u16>(d"
    "ata[i]), .len_extra = 0, .len_extra_bits = 0, .dist_code = 0, .dist_extra = 0, .dist_extra_bits = 0 "
    "},\n            );\n            i += 1;\n        }\n    }\n    DeflateScan { .head = head, .prev = prev, "
    ".tokens = tokens, .end = i }\n}export fn deflate(slice<u8, shared> data) : Vec<u8>\n{\n    BitWriter w "
    "= BitWriter { .out = Vec::new(), .bits = 0, .count = 0 };\n    usize n = slice_len(data);\n    if (n ="
    "= 0)\n    {\n        // One empty fixed block.\n        BitWriter::put(&mut w, 1, 1);\n        BitWriter"
    "::put(&mut w, 1, 2);\n        BitWriter::put(&mut w, 0, 7);\n        BitWriter::flush(&mut w);\n       "
    " BitWriter { out, bits, count } = w;\n        return out;\n    }\n    Vec<usize> heads = Vec::filled(HA"
    "SH_SIZE, max_value<usize>());\n    Vec<usize> chains = Vec::filled(WINDOW, max_value<usize>());\n    D"
    "eflateScan s = DeflateScan { .head = heads, .prev = chains, .tokens = Vec::new(), .end = 0 };\n    wh"
    "ile (s.end < n)\n    {\n        usize block_start = s.end;\n        DeflateScan { head, prev, tokens, e"
    "nd } = s;\n        s = deflate_scan(data, head, prev, tokens, end);\n        write_block(&mut w, &s.to"
    "kens[0..$], &data[block_start..s.end], s.end >= n);\n        Vec::clear(&mut s.tokens);\n    }\n    Bit"
    "Writer::flush(&mut w);\n    BitWriter { out, bits, count } = w;\n    out\n}unittest \"deflate: empty dat"
    "a, and adler32\"\n{\n    Vec<u8> nothing = Vec::new();\n    Vec<u8> empty = deflate(&nothing[0..$]);\n   "
    " assert(Vec::len(&empty) == 2 && empty[0] == 0x03 && empty[1] == 0x00);\n    assert(Vec::len(&Result:"
    ":unwrap(inflate(&empty[0..$], 0))) == 0);\n    assert(adler32(&b\"Wikipedia\"[0..$]) == 300286872);\n   "
    " assert(adler32(&nothing[0..$]) == 1);\n}export fn adler32(slice<u8, shared> data) : u32\n{\n    u32 a "
    "= 1;\n    u32 b = 0;\n    usize i = 0;\n    usize n = slice_len(data);\n    while (i < n)\n    {\n        "
    "// 5552 bytes at a time fit the sums in a `u32` before reducing.\n        usize end = if (n - i > 555"
    "2) { i + 5552 } else { n };\n        while (i < end)\n        {\n            a += widen<u32>(data[i]);\n"
    "            b += a;\n            i += 1;\n        }\n        a = a % 65521;\n        b = b % 65521;\n    "
    "}\n    (b << 16) | a\n}export fn zlib_deflate(slice<u8, shared> data) : Vec<u8>\n{\n    Vec<u8> out = Ve"
    "c::new();\n    Vec::push(&mut out, 0x78);\n    Vec::push(&mut out, 0x9C);\n    Vec::append(&mut out, de"
    "flate(data));\n    Vec::push_be(&mut out, adler32(data));\n    out\n}export fn zlib_inflate(slice<u8, s"
    "hared> data, usize max) : Result<Vec<u8>, CompressError>\n{\n    if (slice_len(data) < 6)\n    {\n      "
    "  return Err(Truncated);\n    }\n    u8 cmf = data[0];\n    u8 flg = data[1];\n    if ((cmf & 0x0F) != 8"
    " || (widen<u32>(cmf) * 256 + widen<u32>(flg)) % 31 != 0 || (flg & 0x20) != 0)\n    {\n        return E"
    "rr(Corrupt(0));\n    }\n    Vec<u8> out = Vec::new();\n    usize end = inflate_from(data, 2, &mut out, "
    "max)?;\n    if (end + 4 > slice_len(data))\n    {\n        return Err(Truncated);\n    }\n    if (read_be"
    "<u32>(data, end) != adler32(&out[0..$]))\n    {\n        return Err(Corrupt(end));\n    }\n    Ok(out)\n}"
    "unittest \"zlib_inflate: a wrong checksum\"\n{\n    Vec<u8> z = zlib_deflate(&b\"hello hello hello\"[0..$]"
    ");\n    usize last = Vec::len(&z) - 1;\n    z[last] = z[last] ^ 1;\n    match (zlib_inflate(&z[0..$], 1"
    "00))\n    {\n        Err(Corrupt(at)) : assert(at == last - 3),\n        _                : assert(fals"
    "e),\n    }\n}export fn gzip(slice<u8, shared> data) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n    arra"
    "y<u8, 10> header = [0x1F, 0x8B, 8, 0, 0, 0, 0, 0, 0, 255];\n    Vec::extend_from(&mut out, &header[0."
    ".$]);\n    Vec::append(&mut out, deflate(data));\n    Vec::push_le(&mut out, crc32(data));\n    Vec::pu"
    "sh_le(&mut out, narrow_wrapping<u32>(slice_len(data)));\n    out\n}export fn gunzip(slice<u8, shared> "
    "data, usize max) : Result<Vec<u8>, CompressError>\n{\n    Vec<u8> out = Vec::new();\n    usize at = 0;\n"
    "    usize n = slice_len(data);\n    while (true)\n    {\n        if (at + 10 > n)\n        {\n           "
    " return Err(Truncated);\n        }\n        if (data[at] != 0x1F || data[at + 1] != 0x8B || data[at + "
    "2] != 8)\n        {\n            return Err(Corrupt(at));\n        }\n        u8 flags = data[at + 3];\n "
    "       usize p = at + 10;\n        if ((flags & 4) != 0)\n        {\n            if (p + 2 > n)\n       "
    "     {\n                return Err(Truncated);\n            }\n            p += 2 + widen<usize>(read_l"
    "e<u16>(data, p));\n        }\n        if ((flags & 8) != 0)\n        {\n            while (p < n && data"
    "[p] != 0)\n            {\n                p += 1;\n            }\n            p += 1;\n        }\n        "
    "if ((flags & 16) != 0)\n        {\n            while (p < n && data[p] != 0)\n            {\n           "
    "     p += 1;\n            }\n            p += 1;\n        }\n        if ((flags & 2) != 0)\n        {\n   "
    "         p += 2;\n        }\n        if (p > n)\n        {\n            return Err(Truncated);\n        }"
    "\n        usize before = Vec::len(&out);\n        usize end = inflate_from(data, p, &mut out, max)?;\n "
    "       if (end + 8 > n)\n        {\n            return Err(Truncated);\n        }\n        if (read_le<u"
    "32>(\n            data,\n            end,\n        ) != crc32(&out[before..$]) || read_le<u32>(data, en"
    "d + 4) != narrow_wrapping<u32>(Vec::len(&out) - before))\n        {\n            return Err(Corrupt(en"
    "d));\n        }\n        at = end + 8;\n        if (at >= n)\n        {\n            return Ok(out);\n    "
    "    }\n    }\n}unittest \"gunzip: round trip and the size limit\"\n{\n    Vec<u8> data = Vec::filled(1000,"
    " b'a');\n    Vec<u8> packed = gzip(&data[0..$]);\n    assert(Vec::len(&packed) < 100);\n    Vec<u8> bac"
    "k = Result::unwrap(gunzip(&packed[0..$], 1000));\n    assert(Vec::len(&back) == 1000 && back[999] == "
    "b'a');\n    match (gunzip(&packed[0..$], 999))\n    {\n        Err(Oversize) : {},\n        _           "
    "  : assert(false),\n    }\n}export fn NulError::text(ref<NulError, shared> e) : str\n{\n    \"holds a NUL"
    " byte\"\n}export fn CString::from_bytes(slice<u8, shared> b) : Result<CString, NulError>\n{\n    usize n"
    " = slice_len(b);\n    Vec<u8> bytes = Vec::new();\n    Vec::reserve(&mut bytes, n + 1);\n    for (usize"
    " i = 0; i < n; i += 1)\n    {\n        if (b[i] == 0)\n        {\n            return Err(NulError { .off"
    "set = i });\n        }\n        Vec::push(&mut bytes, b[i]);\n    }\n    Vec::push(&mut bytes, 0);\n    O"
    "k(CString { .bytes = bytes })\n}export fn CString::new(StringView s) : Result<CString, NulError>\n{\n  "
    "  CString::from_bytes(StringView::as_bytes(s))\n}export fn CString::ptr(ref<CString, shared> c) : raw"
    "ptr<u8>\n{\n    rawptr_of(&c.bytes[0])\n}export fn CString::len(ref<CString, shared> c) : usize\n{\n    V"
    "ec::len(&c.bytes) - 1\n}export fn CString::as_bytes(ref<CString, shared> c) : slice<u8, shared>\n{\n   "
    " &c.bytes[0 .. Vec::len(&c.bytes) - 1]\n}export fn copy_to_raw<T: plain>(slice<T, shared> s, rawptr<T"
    "> p)\n{\n    usize n = slice_len(s);\n    if (n == 0)\n    {\n        return;\n    }\n    if (p == null_raw"
    "ptr<T>())\n    {\n        fault(null_pointer);\n    }\n    // trusted: [Copy-Raw] of the slice's n * siz"
    "eof<T>() bytes (readable: the slice's own path covers them) to `p`, the caller's assertion in its `u"
    "nsafe` that `p` has room for them and that no live object's cells lie there (a [Trusted-Call], spec/"
    "20 §1); T is `plain`, so the bytes are the elements.\n    unsafe\n    {\n        copy_raw(reinterpret_"
    "ptr<u8>(p), reinterpret_ptr<u8>(rawptr_of(&s[0])), n * sizeof<T>());\n    }\n}export fn is_null<T>(raw"
    "ptr<T> p) : bool\n{\n    p == null_rawptr<T>()\n}";

