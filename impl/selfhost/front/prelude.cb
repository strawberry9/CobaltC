    "t_str<V>(ref<HashMap<String, V>, exclusive> m, str k) : Option<ref<V, exclusive>>\n{\n    usize e = *V"
    "ec::index_shared(&m.slots, HashMap::find_str(&*m, k));\n    if (e == max_value<usize>())\n    {\n      "
    "  return None;\n    }\n    Some(Vec::index_exclusive(&mut m.values, e))\n}export fn HashMap::contains_s"
    "tr<V>(ref<HashMap<String, V>, shared> m, str k) : bool\n{\n    *Vec::index_shared(&m.slots, HashMap::f"
    "ind_str(m, k)) != max_value<usize>()\n}export fn HashMap::remove_str<V>(ref<HashMap<String, V>, exclu"
    "sive> m, str k) : Option<V>\n{\n    usize s = HashMap::find_str(&*m, k);\n    HashMap::remove_slot(m, s"
