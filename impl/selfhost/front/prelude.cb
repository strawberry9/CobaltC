    "\n    ];\n    array<u8, 32> out = [0; 32];\n    for (usize i = 0; i < 4; i += 1)\n    {\n        for (usi"
    "ze j = 0; j < 8; j += 1)\n        {\n            out[8 * i + j] = narrow_wrapping<u8>(w[i] >> narrow<u"
    "32>(8 * j));\n        }\n    }\n    out\n}fn x25519_ladder(slice<u8, shared> scalar, slice<u8, shared> u"
    ") : array<u8, 32>\n{\n    array<u8, 32> k = [0; 32];\n    for (usize i = 0; i < 32; i += 1)\n    {\n     "
    "   k[i] = scalar[i];\n    }\n    k[0] = k[0] & 248;\n    k[31] = (k[31] & 127) | 64;\n    array<u64, 5> "
    "x1 = fe_from_bytes(u);\n    array<u64, 5> x2 = [1, 0, 0, 0, 0];\n    array<u64, 5> z2 = [0, 0, 0, 0, 0"
