    "5, 0, 0, 0, 0];\n    u64 swap = 0;\n    for (usize step = 0; step < 255; step += 1)\n    {\n        usiz"
    "e t = 254 - step;\n        u64 bit = widen<u64>((k[t >> 3] >> narrow<u32>(t & 7)) & 1);\n        swap "
