// The intrinsics' unqualified names (`modres::is_intrinsic_name`), each
// between spaces, and the floating-point functions of `std::math`.
export const str PRELUDE_INTRINSICS =
    " drop clone sizeof alignof dangling null_rawptr checked_narrow count_ones leading_zeros trailing_zer"
    "os rotate_left rotate_right read_volatile write_volatile rawptr_of rawptr_from_address rawptr_addres"
    "s reclaim release copy_raw allocate deallocate lock spawn join join_status cancel reinterpret_ptr wi"
    "den narrow narrow_wrapping reinterpret to_float to_int wrapping_add wrapping_sub wrapping_mul satura"
    "ting_add saturating_sub saturating_mul checked_add checked_sub checked_mul checked_div checked_rem c"
    "hecked_neg fault stdout_write str_len str_byte str_ptr str_slice str_string slice_len min_value max_"
    "value append_native text_write parse_check parse_value key_hash key_eq key_less key_less_at swap_pla"
    "ces lend_places atomic_op atomic_wait_op cpu_op simd_load simd_store simd_eq simd_ne simd_lt simd_le"
    " simd_gt simd_ge simd_select simd_any simd_all simd_min simd_max simd_sum simd_reduce_min simd_reduc"
    "e_max static_assert ";
