    "((x << 4) & AES_ROW3_HI);\n    }\n    r\n}fn aes_rot1(u64 x) : u64\n{\n    ((x >> 1) & 0x7777777777777777"
    ") | ((x << 3) & 0x8888888888888888)\n}fn aes_rot2(u64 x) : u64\n{\n    ((x >> 2) & 0x3333333333333333) "
    "| ((x << 2) & 0xcccccccccccccccc)\n}fn aes_rot3(u64 x) : u64\n{\n    ((x >> 3) & 0x1111111111111111) | "
    "((x << 1) & 0xeeeeeeeeeeeeeeee)\n}fn aes_mix_columns(array<u64, 8> q) : array<u64, 8>\n{\n    array<u64"
    ", 8> d = [0; 8];\n    array<u64, 8> s = [0; 8];\n    for (usize b = 0; b < 8; b += 1)\n    {\n        u6"
    "4 r1 = aes_rot1(q[b]);\n        d[b] = q[b] ^ r1;\n        s[b] = r1 ^ aes_rot2(q[b]) ^ aes_rot3(q[b])"
    ";\n    }\n    [\n        s[0] ^ d[7],\n        s[1] ^ d[0] ^ d[7],\n        s[2] ^ d[1],\n        s[3] ^ d"
    "[2] ^ d[7],\n        s[4] ^ d[3] ^ d[7],\n        s[5] ^ d[4],\n        s[6] ^ d[5],\n        s[7] ^ d[6"
    "],\n    ]\n}fn aes_xtime(u8 a) : u8\n{\n    (a << 1) ^ (0x1b & wrapping_sub(0: u8, a >> 7))\n}fn aes_expa"
    "nd(slice<u8, shared> key) : AesKey\n{\n    usize nk = slice_len(key) / 4;\n    if (slice_len(key) != 16"
    " && slice_len(key) != 24 && slice_len(key) != 32)\n    {\n        fault(crypto_length);\n    }\n    usiz"
    "e rounds = nk + 6;\n    array<u32, 60> w = [0; 60];\n    for (usize i = 0; i < nk; i += 1)\n    {\n     "
    "   w[i] = widen<u32>(key[4 * i]) | (widen<u32>(key[4 * i + 1]) << 8) | (widen<u32>(key[4 * i + 2]) <"
    "< 16) | (widen<u32>(key[4 * i + 3]) << 24);\n    }\n    u8 rcon = 1;\n    for (usize word = nk; word < "
    "4 * (rounds + 1); word += 1)\n    {\n        u32 t = w[word - 1];\n        if (word % nk == 0)\n        "
    "{\n            t = narrow_wrapping<u32>(aes_sbox_bytes(widen<u64>((t >> 8) | (t << 24)))) ^ widen<u32"
    ">(rcon);\n            rcon = aes_xtime(rcon);\n        }\n        else if (nk > 6 && word % nk == 4)\n  "
    "      {\n            t = narrow_wrapping<u32>(aes_sbox_bytes(widen<u64>(t)));\n        }\n        w[wor"
    "d] = w[word - nk] ^ t;\n    }\n    array<u64, 120> sk = [0; 120];\n    for (usize r = 0; r <= rounds; r"
    " += 1)\n    {\n        array<u8, 64> b = [0; 64];\n        for (usize j = 0; j < 16; j += 1)\n        {\n"
    "            u8 v = narrow_wrapping<u8>(w[4 * r + j / 4] >> narrow<u32>(8 * (j % 4)));\n            fo"
    "r (usize k = 0; k < 4; k += 1)\n            {\n                b[16 * k + j] = v;\n            }\n      "
    "  }\n        array<u64, 8> q = aes_pack(b);\n        for (usize p = 0; p < 8; p += 1)\n        {\n      "
    "      sk[8 * r + p] = q[p];\n        }\n    }\n    AesKey { .sk = sk, .rounds = rounds }\n}fn aes_encryp"
    "t4(ref<AesKey, shared> key, array<u64, 8> input) : array<u64, 8>\n{\n    array<u64, 8> q = input;\n    "
    "for (usize p = 0; p < 8; p += 1)\n    {\n        q[p] = q[p] ^ key.sk[p];\n    }\n    for (usize round ="
    " 1; round <= key.rounds; round += 1)\n    {\n        q = aes_shift_rows(aes_sbox_ct(q));\n        if (r"
    "ound < key.rounds)\n        {\n            q = aes_mix_columns(q);\n        }\n        for (usize p = 0;"
    " p < 8; p += 1)\n        {\n            q[p] = q[p] ^ key.sk[8 * round + p];\n        }\n    }\n    q\n}fn"
    " aes_block(ref<AesKey, shared> key, array<u8, 16> input) : array<u8, 16>\n{\n    array<u8, 64> b = [0;"
    " 64];\n    for (usize i = 0; i < 16; i += 1)\n    {\n        b[i] = input[i];\n    }\n    array<u8, 64> e"
    " = aes_unpack(aes_encrypt4(key, aes_pack(b)));\n    array<u8, 16> out = [0; 16];\n    for (usize i = 0"
    "; i < 16; i += 1)\n    {\n        out[i] = e[i];\n    }\n    out\n}export fn aes_encrypt_block(slice<u8, "
    "shared> key, array<u8, 16> block) : array<u8, 16>\n{\n    AesKey k = aes_expand(key);\n    aes_block(&k"
