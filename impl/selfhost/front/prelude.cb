    "uid_v4: the shape of the text\"\n{\n    String id = uuid_v4();\n    assert(String::len(&id) == 36);\n    "
    "assert(StringView::eq_str(String::view(&id, 8, 9), \"-\"));\n    assert(StringView::eq_str(String::view"
    "(&id, 14, 15), \"4\"));\n}export fn min<T: ordered>(T a, T b) : T\n{\n    if (b < a) { b } else { a }\n}ex"
    "port fn max<T: ordered>(T a, T b) : T\n{\n    if (b > a) { b } else { a }\n}export fn abs<T: number>(T "
    "x) : T\n{\n    if (x < 0 || x == 0) { 0 - x } else { x }\n}export fn pow<T: number>(T base, u32 exp) : "
    "T\n{\n    T r = 1;\n    T b = base;\n    u32 e = exp;\n    while (e > 0)\n    {\n        if ((e & 1) == 1) "
