    ", shared> b) : Box<T>\n{\n    Box::new(clone(Box::get(b)))\n}export fn Box::into_inner<T>(Box<T> b) : T"
    "\n{\n    b.full = false;\n    unsafe\n    {\n        auto v = *b.ptr;\n        release(reinterpret_ptr<u8>"
    "(b.ptr), sizeof<T>());\n        v\n    }\n}export fn Box::drop<T>(ref<Box<T>, exclusive> self)\n{\n    un"
    "safe\n    {\n        if (self.full)\n        {\n            drop(reclaim<T>(self.ptr));\n        }\n      "
    "  deallocate(reinterpret_ptr<u8>(self.ptr), Box::cells<T>(), alignof<T>());\n    }\n}fn ChannelState::"
    "pop<T>(ref<ChannelState<T>, exclusive> st) : Option<T>\n{\n    usize at = st.head;\n    Option<T> none "
    "= None;\n    Option<T> x = replace(&mut st.slots[at], none);\n    st.head = (at + 1) % Vec::len(&st.sl"
    "ots);\n    st.count = st.count - 1;\n    x\n}export fn Channel::new<T>(usize cap) : Channel<T>\n{\n    if"
    " (cap == 0)\n    {\n        fault(channel_zero_capacity);\n    }\n    Vec<Option<T>> slots = Vec::new();"
    "\n    usize i = 0;\n    while (i < cap)\n    {\n        Option<T> none = None;\n        Vec::push(&mut sl"
    "ots, none);\n        i = i + 1;\n    }\n    usize can_send = unsafe\n    {\n        event_op(0, 0, 0)\n   "
    " };\n    usize can_recv = unsafe\n    {\n        event_op(0, 0, 0)\n    };\n    ChannelState<T> st = Chan"
    "nelState { .slots = slots, .head = 0, .count = 0, .closed = false };\n    Channel { .state = Mutex::n"
    "ew(st), .cap = cap, .can_send = can_send, .can_recv = can_recv }\n}export fn Channel::send<T>(ref<Cha"
    "nnel<T>, shared> ch, T v) : Result<void, T>\n{\n    // D-0213 `[Thread-Lend]`: the exclusive reference"
    "s `v` holds are lent\n    // to the thread that receives it; the sender's own copies then clash\n    /"
    "/ with them while they live.\n    lend_places(&mut v);\n    while (true)\n    {\n        usize seen = 0;"
    "\n        {\n            auto g = lock(&ch.state);\n            if (g.closed)\n            {\n           "
    "     return Err(v);\n            }\n            if (g.count < ch.cap)\n            {\n                us"
    "ize at = (g.head + g.count) % ch.cap;\n                g.slots[at] = Some(v);\n                g.count"
    " = g.count + 1;\n                unsafe\n                {\n                    event_op(3, ch.can_recv"
