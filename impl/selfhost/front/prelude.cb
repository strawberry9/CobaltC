    "s_rot1(u64 x) : u64\n{\n    ((x >> 1) & 0x7777777777777777) | ((x << 3) & 0x8888888888888888)\n}fn aes_"
    "rot2(u64 x) : u64\n{\n    ((x >> 2) & 0x3333333333333333) | ((x << 2) & 0xcccccccccccccccc)\n}fn aes_ro"
    "t3(u64 x) : u64\n{\n    ((x >> 3) & 0x1111111111111111) | ((x << 1) & 0xeeeeeeeeeeeeeeee)\n}fn aes_mix_"
    "columns(array<u64, 8> q) : array<u64, 8>\n{\n    array<u64, 8> d = [0; 8];\n    array<u64, 8> s = [0; 8"
    "];\n    for (usize b = 0; b < 8; b += 1)\n    {\n        u64 r1 = aes_rot1(q[b]);\n        d[b] = q[b] ^"
    " r1;\n        s[b] = r1 ^ aes_rot2(q[b]) ^ aes_rot3(q[b]);\n    }\n    [\n        s[0] ^ d[7],\n        s"
    "[1] ^ d[0] ^ d[7],\n        s[2] ^ d[1],\n        s[3] ^ d[2] ^ d[7],\n        s[4] ^ d[3] ^ d[7],\n    "
    "    s[5] ^ d[4],\n        s[6] ^ d[5],\n        s[7] ^ d[6],\n    ]\n}fn aes_xtime(u8 a) : u8\n{\n    (a <"
