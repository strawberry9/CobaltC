    "       blk[k] = data[i + k];\n            }\n            s.h = sha1_block(s.h, blk);\n            i += "
    "64;\n        }\n        else\n        {\n            s.block[s.fill] = data[i];\n            s.fill += 1;"
    "\n            i += 1;\n            if (s.fill == 64)\n            {\n                s.h = sha1_block(s."
