    "xport fn HashSet::difference<K: clone>(ref<HashSet<K>, shared> a, ref<HashSet<K>, shared> b) : HashS"
    "et<K>\n{\n    HashSet<K> out = HashSet::new();\n    foreach (i in 0..HashSet::len(a))\n    {\n        ref"
