    "elf)\n{\n    Queue::clear(self);\n}export fn PriorityQueue::new<T>() : PriorityQueue<T>\n{\n    PriorityQ"
    "ueue { .items = Vec::new(), .seqs = Vec::new(), .keyed = true, .less = key_before<T>, .next = 0 }\n}e"
    "xport fn PriorityQueue::new_by<T>(fn(ref<T, shared>, ref<T, shared>) : bool less) : PriorityQueue<T>"
