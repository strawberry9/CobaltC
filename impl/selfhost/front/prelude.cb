    "        u64 x = 0;\n        for (usize p = 0; p < 8; p += 1)\n        {\n            x = x | (((q[p] >>"
    " narrow<u32>(8 * k)) & 0xff) << narrow<u32>(8 * p));\n        }\n        x = aes_transpose8(x);\n      "
    "  for (usize i = 0; i < 8; i += 1)\n        {\n            b[8 * k + i] = narrow_wrapping<u8>(x >> nar"
    "row<u32>(8 * i));\n        }\n    }\n    b\n}fn aes_sbox_ct(array<u64, 8> q) : array<u64, 8>\n{\n    u64 x"
