    "ake_g);\n    u64 m32 = 0xffffffff;\n    u64 w0 = (h0 | (h1 << 26)) & m32;\n    u64 w1 = ((h1 >> 6) | (h"
    "2 << 20)) & m32;\n    u64 w2 = ((h2 >> 12) | (h3 << 14)) & m32;\n    u64 w3 = ((h3 >> 18) | (h4 << 8))"
