    ", slice<u8, shared> data)\n{\n    usize n = slice_len(data);\n    usize at = n - n % 16;\n    if (at > 0"
    ")\n    {\n        Poly1305::block(p, &data[0..at], 1 << 24);\n    }\n    if (at < n)\n    {\n        array"
