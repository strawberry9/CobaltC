    "sive> s, K k) : bool\n{\n    match (HashMap::insert(&mut s.map, k, true))\n    {\n        Some(_) : fals"
    "e,\n        None    : true,\n    }\n}unittest \"HashSet::insert: duplicate\"\n{\n    HashSet<i32> s = HashS"
    "et::new();\n    assert(HashSet::insert(&mut s, 4));\n    assert(!HashSet::insert(&mut s, 4));\n    asse"
    "rt(HashSet::len(&s) == 1);\n}export fn HashSet::clone<K: clone>(ref<HashSet<K>, shared> s) : HashSet<"
    "K>\n{\n    HashSet { .map = HashMap::clone(&s.map) }\n}export fn HashSet::union<K: clone>(ref<HashSet<K"
    ">, shared> a, ref<HashSet<K>, shared> b) : HashSet<K>\n{\n    HashSet<K> out = HashSet::clone(a);\n    "
