    "  }\n    for (usize i = 0; i < 8; i += 1)\n    {\n        last[56 + i] = narrow_wrapping<u8>(bits >> na"
    "rrow<u32>(56 - 8 * i));\n    }\n    h = sha1_block(h, last);\n    array<u8, 20> out = [0; 20];\n    for "
