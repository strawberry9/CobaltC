    "d> key,\n    array<u8, 16> j0,\n    slice<u8, shared> aad,\n    slice<u8, shared> ciphertext,\n) : array"
    "<u8, 16>\n{\n    u128 h = gcm_block(&aes_block(key, [0; 16])[0..$], 0);\n    u128 y = ghash_update(ghas"
    "h_update(0, h, aad), h, ciphertext);\n    u128 lengths = (widen<u128>(slice_len(aad)) * 8) << 64 | wi"
    "den<u128>(slice_len(ciphertext)) * 8;\n    y = ghash_mul(y ^ lengths, h);\n    gcm_bytes(y ^ gcm_block"
    "(&aes_block(key, j0)[0..$], 0))\n}fn gcm_j0(slice<u8, shared> nonce) : array<u8, 16>\n{\n    if (slice_"
    "len(nonce) != 12)\n    {\n        fault(crypto_length);\n    }\n    array<u8, 16> j = [0; 16];\n    for ("
    "usize i = 0; i < 12; i += 1)\n    {\n        j[i] = nonce[i];\n    }\n    j[15] = 1;\n    j\n}export fn ae"
    "s_gcm_seal(\n    slice<u8, shared> key,\n    slice<u8, shared> nonce,\n    slice<u8, shared> aad,\n    s"
    "lice<u8, shared> plaintext,\n) : Vec<u8>\n{\n    array<u8, 16> j0 = gcm_j0(nonce);\n    AesKey k = aes_e"
    "xpand(key);\n    Vec<u8> out = gcm_ctr(&k, j0, plaintext);\n    array<u8, 16> tag = gcm_tag(&k, j0, aa"
    "d, &out[0..$]);\n    Vec::extend_from(&mut out, &tag[0..$]);\n    out\n}unittest \"aes_gcm_seal: a publi"
    "shed vector and its opening\"\n{\n    array<u8, 16> key = [0; 16];\n    array<u8, 12> nonce = [0; 12];\n "
    "   array<u8, 16> plain = [0; 16];\n    Vec<u8> none = Vec::new();\n    Vec<u8> sealed = aes_gcm_seal(&"
    "key[0..$], &nonce[0..$], &none[0..$], &plain[0..$]);\n    String want = \"0388dace60b6a392f328c2b971b2"
    "fe78\";\n    String::append(&mut want, \"ab6e47d42cec13bdf53a67b21257bddf\");\n    assert(String::eq(&to_"
    "hex(&sealed[0..$]), &want));\n    Vec<u8> opened = Option::unwrap(aes_gcm_open(&key[0..$], &nonce[0.."
    "$], &none[0..$], &sealed[0..$]));\n    assert(slice_eq(&opened[0..$], &plain[0..$]));\n    assert(Opti"
    "on::is_none(&aes_gcm_open(&key[0..$], &nonce[0..$], &b\"aad\"[0..$], &sealed[0..$])));\n}export fn aes_"
    "gcm_open(\n    slice<u8, shared> key,\n    slice<u8, shared> nonce,\n    slice<u8, shared> aad,\n    sli"
    "ce<u8, shared> sealed,\n) : Option<Vec<u8>>\n{\n    array<u8, 16> j0 = gcm_j0(nonce);\n    AesKey k = ae"
    "s_expand(key);\n    usize n = slice_len(sealed);\n    if (n < 16)\n    {\n        return None;\n    }\n   "
    " array<u8, 16> want = gcm_tag(&k, j0, aad, &sealed[0..n - 16]);\n    if (!digest_eq(&want[0..$], &sea"
    "led[n - 16..n]))\n    {\n        return None;\n    }\n    Some(gcm_ctr(&k, j0, &sealed[0..n - 16]))\n}fn "
    "fe_carry(array<u64, 5> f) : array<u64, 5>\n{\n    array<u64, 5> r = f;\n    for (usize i = 0; i < 4; i "
    "+= 1)\n    {\n        r[i + 1] += r[i] >> 51;\n        r[i] = r[i] & FE_MASK;\n    }\n    u64 c = r[4] >>"
    " 51;\n    r[4] = r[4] & FE_MASK;\n    r[0] += c * 19;\n    r[1] += r[0] >> 51;\n    r[0] = r[0] & FE_MAS"
    "K;\n    r\n}fn fe_add(array<u64, 5> a, array<u64, 5> b) : array<u64, 5>\n{\n    fe_carry([a[0] + b[0], a"
    "[1] + b[1], a[2] + b[2], a[3] + b[3], a[4] + b[4]])\n}fn fe_sub(array<u64, 5> a, array<u64, 5> b) : a"
    "rray<u64, 5>\n{\n    fe_carry([\n        a[0] + 0x1fffffffffffb4 - b[0],\n        a[1] + 0x1ffffffffffff"
    "c - b[1],\n        a[2] + 0x1ffffffffffffc - b[2],\n        a[3] + 0x1ffffffffffffc - b[3],\n        a["
    "4] + 0x1ffffffffffffc - b[4],\n    ])\n}fn fe_mul(array<u64, 5> a, array<u64, 5> b) : array<u64, 5>\n{\n"
    "    u128 a0 = widen<u128>(a[0]);\n    u128 a1 = widen<u128>(a[1]);\n    u128 a2 = widen<u128>(a[2]);\n "
    "   u128 a3 = widen<u128>(a[3]);\n    u128 a4 = widen<u128>(a[4]);\n    u128 b0 = widen<u128>(b[0]);\n  "
    "  u128 b1 = widen<u128>(b[1]);\n    u128 b2 = widen<u128>(b[2]);\n    u128 b3 = widen<u128>(b[3]);\n   "
    " u128 b4 = widen<u128>(b[4]);\n    u128 b1_19 = b1 * 19;\n    u128 b2_19 = b2 * 19;\n    u128 b3_19 = b"
    "3 * 19;\n    u128 b4_19 = b4 * 19;\n    u128 t0 = a0 * b0 + a1 * b4_19 + a2 * b3_19 + a3 * b2_19 + a4 "
    "* b1_19;\n    u128 t1 = a0 * b1 + a1 * b0 + a2 * b4_19 + a3 * b3_19 + a4 * b2_19;\n    u128 t2 = a0 * "
    "b2 + a1 * b1 + a2 * b0 + a3 * b4_19 + a4 * b3_19;\n    u128 t3 = a0 * b3 + a1 * b2 + a2 * b1 + a3 * b"
    "0 + a4 * b4_19;\n    u128 t4 = a0 * b4 + a1 * b3 + a2 * b2 + a3 * b1 + a4 * b0;\n    u128 m = 0x7fffff"
    "fffffff;\n    t1 += t0 >> 51;\n    t2 += t1 >> 51;\n    t3 += t2 >> 51;\n    t4 += t3 >> 51;\n    u128 r0"
    " = (t0 & m) + (t4 >> 51) * 19;\n    u128 r1 = (t1 & m) + (r0 >> 51);\n    array<u64, 5> r = [\n        "
    "narrow<u64>(r0 & m),\n        narrow<u64>(r1),\n        narrow<u64>(t2 & m),\n        narrow<u64>(t3 & "
    "m),\n        narrow<u64>(t4 & m),\n    ];\n    fe_carry(r)\n}fn fe_cswap(ref<array<u64, 5>, exclusive> a"
    ", ref<array<u64, 5>, exclusive> b, u64 swap)\n{\n    u64 mask = wrapping_sub(0, swap);\n    for (usize "
    "i = 0; i < 5; i += 1)\n    {\n        u64 x = mask & (a[i] ^ b[i]);\n        a[i] = a[i] ^ x;\n        b"
    "[i] = b[i] ^ x;\n    }\n}fn fe_invert(array<u64, 5> z) : array<u64, 5>\n{\n    array<u64, 5> r = [1, 0, "
    "0, 0, 0];\n    for (usize k = 0; k < 255; k += 1)\n    {\n        usize i = 254 - k;\n        r = fe_mul"
    "(r, r);\n        if (i >= 5 || i == 3 || i == 1 || i == 0)\n        {\n            r = fe_mul(r, z);\n  "
    "      }\n    }\n    r\n}fn fe_from_bytes(slice<u8, shared> s) : array<u64, 5>\n{\n    [\n        read_le<u"
    "64>(s, 0) & FE_MASK,\n        (read_le<u64>(s, 6) >> 3) & FE_MASK,\n        (read_le<u64>(s, 12) >> 6)"
    " & FE_MASK,\n        (read_le<u64>(s, 19) >> 1) & FE_MASK,\n        (read_le<u64>(s, 24) >> 12) & FE_M"
    "ASK,\n    ]\n}fn fe_to_bytes(array<u64, 5> f) : array<u8, 32>\n{\n    array<u64, 5> h = fe_carry(fe_carr"
    "y(f));\n    // q is 1 exactly when h ≥ p: h + 19 then reaches 2^255.\n    u64 q = (h[0] + 19) >> 51;"
    "\n    q = (h[1] + q) >> 51;\n    q = (h[2] + q) >> 51;\n    q = (h[3] + q) >> 51;\n    q = (h[4] + q) >>"
    " 51;\n    h[0] += 19 * q;\n    for (usize i = 0; i < 4; i += 1)\n    {\n        h[i + 1] += h[i] >> 51;\n"
    "        h[i] = h[i] & FE_MASK;\n    }\n    h[4] = h[4] & FE_MASK;\n    array<u64, 4> w = [\n        h[0]"
    " | (h[1] << 51),\n        (h[1] >> 13) | (h[2] << 38),\n        (h[2] >> 26) | (h[3] << 25),\n        ("
    "h[3] >> 39) | (h[4] << 12),\n    ];\n    array<u8, 32> out = [0; 32];\n    for (usize i = 0; i < 4; i +"
    "= 1)\n    {\n        for (usize j = 0; j < 8; j += 1)\n        {\n            out[8 * i + j] = narrow_wr"
    "apping<u8>(w[i] >> narrow<u32>(8 * j));\n        }\n    }\n    out\n}fn x25519_ladder(slice<u8, shared> "
    "scalar, slice<u8, shared> u) : array<u8, 32>\n{\n    array<u8, 32> k = [0; 32];\n    for (usize i = 0; "
    "i < 32; i += 1)\n    {\n        k[i] = scalar[i];\n    }\n    k[0] = k[0] & 248;\n    k[31] = (k[31] & 12"
    "7) | 64;\n    array<u64, 5> x1 = fe_from_bytes(u);\n    array<u64, 5> x2 = [1, 0, 0, 0, 0];\n    array<"
    "u64, 5> z2 = [0, 0, 0, 0, 0];\n    array<u64, 5> x3 = x1;\n    array<u64, 5> z3 = [1, 0, 0, 0, 0];\n   "
    " array<u64, 5> a24 = [121665, 0, 0, 0, 0];\n    u64 swap = 0;\n    for (usize step = 0; step < 255; st"
    "ep += 1)\n    {\n        usize t = 254 - step;\n        u64 bit = widen<u64>((k[t >> 3] >> narrow<u32>("
    "t & 7)) & 1);\n        swap = swap ^ bit;\n        fe_cswap(&mut x2, &mut x3, swap);\n        fe_cswap("
    "&mut z2, &mut z3, swap);\n        swap = bit;\n        array<u64, 5> a = fe_add(x2, z2);\n        array"
    "<u64, 5> aa = fe_mul(a, a);\n        array<u64, 5> b = fe_sub(x2, z2);\n        array<u64, 5> bb = fe_"
    "mul(b, b);\n        array<u64, 5> e = fe_sub(aa, bb);\n        array<u64, 5> c = fe_add(x3, z3);\n     "
    "   array<u64, 5> d = fe_sub(x3, z3);\n        array<u64, 5> da = fe_mul(d, a);\n        array<u64, 5> "
    "cb = fe_mul(c, b);\n        array<u64, 5> sum = fe_add(da, cb);\n        x3 = fe_mul(sum, sum);\n      "
    "  array<u64, 5> diff = fe_sub(da, cb);\n        z3 = fe_mul(x1, fe_mul(diff, diff));\n        x2 = fe_"
    "mul(aa, bb);\n        z2 = fe_mul(e, fe_add(aa, fe_mul(a24, e)));\n    }\n    fe_cswap(&mut x2, &mut x3"
    ", swap);\n    fe_cswap(&mut z2, &mut z3, swap);\n    fe_to_bytes(fe_mul(x2, fe_invert(z2)))\n}export fn"
    " x25519(slice<u8, shared> private_key, slice<u8, shared> public_key) : Option<array<u8, 32>>\n{\n    i"
    "f (slice_len(private_key) != 32 || slice_len(public_key) != 32)\n    {\n        fault(crypto_length);\n"
    "    }\n    array<u8, 32> shared = x25519_ladder(private_key, public_key);\n    u8 acc = 0;\n    for (us"
    "ize i = 0; i < 32; i += 1)\n    {\n        acc = acc | shared[i];\n    }\n    if (acc == 0)\n    {\n      "
    "  return None;\n    }\n    Some(shared)\n}export fn x25519_public_key(slice<u8, shared> private_key) : "
    "array<u8, 32>\n{\n    if (slice_len(private_key) != 32)\n    {\n        fault(crypto_length);\n    }\n    "
    "array<u8, 32> base = [0; 32];\n    base[0] = 9;\n    x25519_ladder(private_key, &base[0..$])\n}export f"
    "n x25519_private_key() : array<u8, 32>\n{\n    array<u8, 32> k = [0; 32];\n    os_random_bytes(&mut k[0"
    "..$]);\n    k\n}fn rsa_open(ref<RsaPublicKey, shared> key, slice<u8, shared> signature, usize k) : Opt"
    "ion<Vec<u8>>\n{\n    BigUint s = BigUint::from_bytes_be(signature);\n    if (!BigUint::less(&s, &key.n)"
    ")\n    {\n        return None;\n    }\n    BigUint m = BigUint::mod_pow(&s, &key.e, &key.n);\n    if (Big"
    "Uint::bit_len(&m) > 8 * k)\n    {\n        return None;\n    }\n    Some(BigUint::to_bytes_be_padded(&m,"
    " k))\n}fn digest_info_prefix(HashKind kind) : Vec<u8>\n{\n    Result::unwrap_or(from_hex(match (kind)\n "
    "   {\n        Sha1     : \"3021300906052b0e03021a05000414\",\n        Sha2_256 : \"3031300d06096086480165"
    "0304020105000420\",\n        Sha2_384 : \"3041300d060960864801650304020205000430\",\n        Sha2_512 : \""
    "3051300d060960864801650304020305000440\",\n    }), Vec::new())\n}export fn rsa_verify_pkcs1v15(\n    ref"
    "<RsaPublicKey, shared> key,\n    HashKind kind,\n    slice<u8, shared> digest,\n    slice<u8, shared> s"
    "ignature,\n) : bool\n{\n    usize k = (BigUint::bit_len(&key.n) + 7) / 8;\n    if (slice_len(signature) "
    "!= k || slice_len(digest) != hash_len(kind))\n    {\n        return false;\n    }\n    Vec<u8> prefix = "
    "digest_info_prefix(kind);\n    usize t_len = Vec::len(&prefix) + slice_len(digest);\n    if (k < t_len"
    " + 11)\n    {\n        return false;\n    }\n    Vec<u8> want = Vec::new();\n    Vec::push(&mut want, 0);"
    "\n    Vec::push(&mut want, 1);\n    for (usize i = 0; i < k - t_len - 3; i += 1)\n    {\n        Vec::pu"
    "sh(&mut want, 0xff);\n    }\n    Vec::push(&mut want, 0);\n    Vec::extend_from(&mut want, &prefix[0..$"
    "]);\n    Vec::extend_from(&mut want, digest);\n    match (rsa_open(key, signature, k))\n    {\n        S"
    "ome(em) : digest_eq(&em[0..$], &want[0..$]),\n        None     : false,\n    }\n}fn mgf1(HashKind kind,"
    " slice<u8, shared> seed, usize len) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n    u32 counter = 0;\n "
    "   while (Vec::len(&out) < len)\n    {\n        Vec<u8> input = Vec::from_slice(seed);\n        Vec::pu"
    "sh_be(&mut input, counter);\n        Vec<u8> h = hash(kind, &input[0..$]);\n        for (usize i = 0; "
    "i < Vec::len(&h) && Vec::len(&out) < len; i += 1)\n        {\n            Vec::push(&mut out, h[i]);\n "
    "       }\n        counter += 1;\n    }\n    out\n}export fn rsa_verify_pss(\n    ref<RsaPublicKey, shared"
    "> key,\n    HashKind kind,\n    slice<u8, shared> digest,\n    slice<u8, shared> signature,\n) : bool\n{\n"
    "    usize mod_bits = BigUint::bit_len(&key.n);\n    usize k = (mod_bits + 7) / 8;\n    usize h_len = h"
    "ash_len(kind);\n    usize s_len = h_len;\n    if (slice_len(signature) != k || slice_len(digest) != h_"
    "len || mod_bits < 2)\n    {\n        return false;\n    }\n    usize em_bits = mod_bits - 1;\n    usize e"
    "m_len = (em_bits + 7) / 8;\n    if (em_len < h_len + s_len + 2)\n    {\n        return false;\n    }\n   "
    " Vec<u8> em = match (rsa_open(key, signature, em_len))\n    {\n        Some(e) : e,\n        None    : "
    "return false,\n    };\n    if (em[em_len - 1] != 0xbc)\n    {\n        return false;\n    }\n    usize db_"
    "len = em_len - h_len - 1;\n    u32 unused = narrow<u32>(8 * em_len - em_bits);\n    u8 top_mask = narr"
    "ow_wrapping<u8>((0xff: u32) >> unused);\n    if ((em[0] & ~top_mask) != 0)\n    {\n        return false"
    ";\n    }\n    Vec<u8> db_mask = mgf1(kind, &em[db_len..db_len + h_len], db_len);\n    Vec<u8> db = Vec:"
    ":new();\n    for (usize i = 0; i < db_len; i += 1)\n    {\n        Vec::push(&mut db, em[i] ^ db_mask[i"
    "]);\n    }\n    db[0] = db[0] & top_mask;\n    usize ps_len = em_len - h_len - s_len - 2;\n    for (usiz"
    "e i = 0; i < ps_len; i += 1)\n    {\n        if (db[i] != 0)\n        {\n            return false;\n     "
    "   }\n    }\n    if (db[ps_len] != 1)\n    {\n        return false;\n    }\n    Vec<u8> m2 = Vec::filled(8"
    ", 0: u8);\n    Vec::extend_from(&mut m2, digest);\n    Vec::extend_from(&mut m2, &db[db_len - s_len..$"
    "]);\n    Vec<u8> h2 = hash(kind, &m2[0..$]);\n    digest_eq(&h2[0..$], &em[db_len..db_len + h_len])\n}f"
    "n field_of(EcCurve c, bool order) : Field\n{\n    match (c)\n    {\n        P256 : if (order)\n        {\n"
    "            Field { .m = [\n                0xf3b9cac2fc632551,\n                0xbce6faada7179e84,\n "
    "               0xffffffffffffffff,\n                0xffffffff00000000,\n                0x00000000000"
    "00000,\n                0x0000000000000000,\n            ], .n = 4, .minv = 0xccd1c8aaee00bc4f, .r2 = "
    "[\n                0x83244c95be79eea2,\n                0x4699799c49bd6fa6,\n                0x2845b239"
    "2b6bec59,\n                0x66e12d94f3d95620,\n                0x0000000000000000,\n                0x"
    "0000000000000000,\n            ] }\n        }\n        else\n        {\n            Field { .m = [\n      "
    "          0xffffffffffffffff,\n                0x00000000ffffffff,\n                0x0000000000000000"
    ",\n                0xffffffff00000001,\n                0x0000000000000000,\n                0x00000000"
    "00000000,\n            ], .n = 4, .minv = 0x0000000000000001, .r2 = [\n                0x0000000000000"
    "003,\n                0xfffffffbffffffff,\n                0xfffffffffffffffe,\n                0x00000"
    "004fffffffd,\n                0x0000000000000000,\n                0x0000000000000000,\n            ] }"
    "\n        },\n        P384 : if (order)\n        {\n            Field { .m = [\n                0xecec196"
    "accc52973,\n                0x581a0db248b0a77a,\n                0xc7634d81f4372ddf,\n                0"
    "xffffffffffffffff,\n                0xffffffffffffffff,\n                0xffffffffffffffff,\n         "
    "   ], .n = 6, .minv = 0x6ed46089e88fdc45, .r2 = [\n                0x2d319b2419b409a9,\n              "
    "  0xff3d81e5df1aa419,\n                0xbc3e483afcb82947,\n                0xd40d49174aab1cc5,\n      "
    "          0x3fb05b7a28266895,\n                0x0c84ee012b39bf21,\n            ] }\n        }\n        "
    "else\n        {\n            Field { .m = [\n                0x00000000ffffffff,\n                0xffff"
    "ffff00000000,\n                0xfffffffffffffffe,\n                0xffffffffffffffff,\n              "
    "  0xffffffffffffffff,\n                0xffffffffffffffff,\n            ], .n = 6, .minv = 0x000000010"
    "0000001, .r2 = [\n                0xfffffffe00000001,\n                0x0000000200000000,\n           "
    "     0xfffffffe00000000,\n                0x0000000200000000,\n                0x0000000000000001,\n   "
    "             0x0000000000000000,\n            ] }\n        },\n    }\n}fn mont_mul(ref<Field, shared> f,"
    " array<u64, 6> a, array<u64, 6> b) : array<u64, 6>\n{\n    usize n = f.n;\n    array<u64, 8> t = [0; 8]"
    ";\n    for (usize i = 0; i < n; i += 1)\n    {\n        u128 c = 0;\n        for (usize j = 0; j < n; j "
    "+= 1)\n        {\n            u128 x = widen<u128>(t[j]) + widen<u128>(a[j]) * widen<u128>(b[i]) + c;\n"
    "            t[j] = narrow_wrapping<u64>(x);\n            c = x >> 64;\n        }\n        u128 y = wide"
    "n<u128>(t[n]) + c;\n        t[n] = narrow_wrapping<u64>(y);\n        t[n + 1] = narrow_wrapping<u64>(y"
    " >> 64);\n        u64 k = wrapping_mul(t[0], f.minv);\n        u128 z = widen<u128>(t[0]) + widen<u128"
    ">(k) * widen<u128>(f.m[0]);\n        c = z >> 64;\n        for (usize j = 1; j < n; j += 1)\n        {\n"
    "            u128 x = widen<u128>(t[j]) + widen<u128>(k) * widen<u128>(f.m[j]) + c;\n            t[j -"
    " 1] = narrow_wrapping<u64>(x);\n            c = x >> 64;\n        }\n        u128 w = widen<u128>(t[n])"
    " + c;\n        t[n - 1] = narrow_wrapping<u64>(w);\n        t[n] = t[n + 1] + narrow_wrapping<u64>(w >"
    "> 64);\n    }\n    array<u64, 6> r = [0; 6];\n    for (usize j = 0; j < n; j += 1)\n    {\n        r[j] ="
    " t[j];\n    }\n    // r - m unless r (with its carry t[n]) is below m: chosen by a mask.\n    Borrowed "
    "d = f_sub_borrow(f, r, f.m);\n    f_select(wrapping_sub(0, (1 - t[n]) & d.borrow), r, d.v)\n}fn f_less"
    "(ref<Field, shared> f, array<u64, 6> a, array<u64, 6> b) : bool\n{\n    usize i = f.n;\n    while (i > "
    "0)\n    {\n        i -= 1;\n        if (a[i] != b[i])\n        {\n            return a[i] < b[i];\n       "
    " }\n    }\n    false\n}fn f_sub_borrow(ref<Field, shared> f, array<u64, 6> a, array<u64, 6> b) : Borrow"
    "ed\n{\n    array<u64, 6> r = [0; 6];\n    u64 borrow = 0;\n    for (usize i = 0; i < f.n; i += 1)\n    {\n"
    "        u128 x = wrapping_sub(wrapping_sub(widen<u128>(a[i]), widen<u128>(b[i])), widen<u128>(borrow"
    "));\n        r[i] = narrow_wrapping<u64>(x);\n        borrow = narrow_wrapping<u64>(x >> 127);\n    }\n "
    "   Borrowed { .v = r, .borrow = borrow }\n}fn f_sub_raw(ref<Field, shared> f, array<u64, 6> a, array<"
    "u64, 6> b) : array<u64, 6>\n{\n    f_sub_borrow(f, a, b).v\n}fn f_select(u64 mask, array<u64, 6> a, arr"
    "ay<u64, 6> b) : array<u64, 6>\n{\n    array<u64, 6> r = [0; 6];\n    for (usize i = 0; i < 6; i += 1)\n "
    "   {\n        r[i] = (a[i] & mask) | (b[i] & ~mask);\n    }\n    r\n}fn f_add(ref<Field, shared> f, arra"
    "y<u64, 6> a, array<u64, 6> b) : array<u64, 6>\n{\n    array<u64, 6> r = [0; 6];\n    u64 carry = 0;\n   "
    " for (usize i = 0; i < f.n; i += 1)\n    {\n        u128 s = widen<u128>(a[i]) + widen<u128>(b[i]) + w"
    "iden<u128>(carry);\n        r[i] = narrow_wrapping<u64>(s);\n        carry = narrow_wrapping<u64>(s >>"
    " 64);\n    }\n    Borrowed d = f_sub_borrow(f, r, f.m);\n    f_select(wrapping_sub(0, (1 - carry) & d.b"
    "orrow), r, d.v)\n}fn f_sub(ref<Field, shared> f, array<u64, 6> a, array<u64, 6> b) : array<u64, 6>\n{\n"
    "    Borrowed d = f_sub_borrow(f, a, b);\n    array<u64, 6> m = f_select(wrapping_sub(0, d.borrow), f."
    "m, [0; 6]);\n    f_add_raw(f, d.v, m)\n}fn f_add_raw(ref<Field, shared> f, array<u64, 6> a, array<u64,"
    " 6> b) : array<u64, 6>\n{\n    array<u64, 6> r = [0; 6];\n    u64 carry = 0;\n    for (usize i = 0; i < "
    "f.n; i += 1)\n    {\n        u128 s = widen<u128>(a[i]) + widen<u128>(b[i]) + widen<u128>(carry);\n    "
    "    r[i] = narrow_wrapping<u64>(s);\n        carry = narrow_wrapping<u64>(s >> 64);\n    }\n    r\n}fn f"
    "_is_zero(ref<Field, shared> f, array<u64, 6> a) : bool\n{\n    u64 acc = 0;\n    for (usize i = 0; i < "
    "f.n; i += 1)\n    {\n        acc = acc | a[i];\n    }\n    acc == 0\n}fn f_to_mont(ref<Field, shared> f, "
    "array<u64, 6> a) : array<u64, 6>\n{\n    mont_mul(f, a, f.r2)\n}fn f_from_mont(ref<Field, shared> f, ar"
    "ray<u64, 6> a) : array<u64, 6>\n{\n    mont_mul(f, a, [1, 0, 0, 0, 0, 0])\n}fn f_invert(ref<Field, shar"
    "ed> f, array<u64, 6> a) : array<u64, 6>\n{\n    array<u64, 6> e = f_sub_raw(f, f.m, [2, 0, 0, 0, 0, 0]"
    ");\n    array<u64, 6> r = f_to_mont(f, [1, 0, 0, 0, 0, 0]);\n    usize bits = 64 * f.n;\n    usize i = "
    "bits;\n    while (i > 0)\n    {\n        i -= 1;\n        r = mont_mul(f, r, r);\n        if (((e[i / 64]"
    " >> narrow<u32>(i % 64)) & 1) == 1)\n        {\n            r = mont_mul(f, r, a);\n        }\n    }\n   "
    " r\n}fn f_from_be(ref<Field, shared> f, slice<u8, shared> b) : Option<array<u64, 6>>\n{\n    usize len "
    "= slice_len(b);\n    if (len > 8 * f.n)\n    {\n        return None;\n    }\n    array<u64, 6> r = [0; 6]"
    ";\n    for (usize k = 0; k < len; k += 1)\n    {\n        usize pos = len - 1 - k;\n        r[k / 8] = r"
    "[k / 8] | (widen<u64>(b[pos]) << narrow<u32>(8 * (k % 8)));\n    }\n    if (!f_less(f, r, f.m))\n    {\n"
    "        return None;\n    }\n    Some(r)\n}fn f_bit(array<u64, 6> a, usize i) : bool\n{\n    ((a[i / 64] "
    ">> narrow<u32>(i % 64)) & 1) == 1\n}fn f_small(ref<Field, shared> f, u64 k, array<u64, 6> a) : array<"
    "u64, 6>\n{\n    array<u64, 6> r = a;\n    u32 top = 63 - leading_zeros(k);\n    u32 i = top;\n    while ("
    "i > 0)\n    {\n        i -= 1;\n        r = f_add(f, r, r);\n        if (((k >> i) & 1) == 1)\n        {\n"
    "            r = f_add(f, r, a);\n        }\n    }\n    r\n}fn jac_double(ref<Field, shared> f, Jacobian "
    "q) : Jacobian\n{\n    if (f_is_zero(f, q.z) || f_is_zero(f, q.y))\n    {\n        return Jacobian { .x ="
    " q.x, .y = q.y, .z = [0; 6] };\n    }\n    array<u64, 6> delta = mont_mul(f, q.z, q.z);\n    array<u64,"
    " 6> gamma = mont_mul(f, q.y, q.y);\n    array<u64, 6> beta = mont_mul(f, q.x, gamma);\n    array<u64, "
    "6> alpha = f_small(f, 3, mont_mul(f, f_sub(f, q.x, delta), f_add(f, q.x, delta)));\n    array<u64, 6>"
    " x3 = f_sub(f, mont_mul(f, alpha, alpha), f_small(f, 8, beta));\n    array<u64, 6> yz = f_add(f, q.y,"
    " q.z);\n    array<u64, 6> z3 = f_sub(f, f_sub(f, mont_mul(f, yz, yz), gamma), delta);\n    array<u64, "
    "6> y3 = f_sub(\n        f,\n        mont_mul(f, alpha, f_sub(f, f_small(f, 4, beta), x3)),\n        f_s"
    "mall(f, 8, mont_mul(f, gamma, gamma)),\n    );\n    Jacobian { .x = x3, .y = y3, .z = z3 }\n}fn jac_add"
    "(ref<Field, shared> f, Jacobian a, Jacobian b) : Jacobian\n{\n    if (f_is_zero(f, a.z))\n    {\n       "
    " return b;\n    }\n    if (f_is_zero(f, b.z))\n    {\n        return a;\n    }\n    array<u64, 6> z1z1 = m"
    "ont_mul(f, a.z, a.z);\n    array<u64, 6> z2z2 = mont_mul(f, b.z, b.z);\n    array<u64, 6> u1 = mont_mu"
    "l(f, a.x, z2z2);\n    array<u64, 6> u2 = mont_mul(f, b.x, z1z1);\n    array<u64, 6> s1 = mont_mul(f, m"
    "ont_mul(f, a.y, b.z), z2z2);\n    array<u64, 6> s2 = mont_mul(f, mont_mul(f, b.y, a.z), z1z1);\n    ar"
    "ray<u64, 6> h = f_sub(f, u2, u1);\n    array<u64, 6> r = f_small(f, 2, f_sub(f, s2, s1));\n    if (f_i"
    "s_zero(f, h))\n    {\n        if (f_is_zero(f, r))\n        {\n            return jac_double(f, a);\n    "
    "    }\n        return Jacobian { .x = a.x, .y = a.y, .z = [0; 6] };\n    }\n    array<u64, 6> h2 = f_sm"
    "all(f, 2, h);\n    array<u64, 6> i = mont_mul(f, h2, h2);\n    array<u64, 6> j = mont_mul(f, h, i);\n  "
    "  array<u64, 6> v = mont_mul(f, u1, i);\n    array<u64, 6> x3 = f_sub(f, f_sub(f, mont_mul(f, r, r), "
    "j), f_small(f, 2, v));\n    array<u64, 6> y3 = f_sub(f, mont_mul(f, r, f_sub(f, v, x3)), f_small(f, 2"
    ", mont_mul(f, s1, j)));\n    array<u64, 6> zs = f_add(f, a.z, b.z);\n    array<u64, 6> z3 = mont_mul(f"
    ", f_sub(f, f_sub(f, mont_mul(f, zs, zs), z1z1), z2z2), h);\n    Jacobian { .x = x3, .y = y3, .z = z3 "
    "}\n}fn jac_table(ref<Field, shared> f, Jacobian p) : Vec<Jacobian>\n{\n    Vec<Jacobian> t = Vec::new()"
    ";\n    Vec::push(&mut t, Jacobian { .x = p.x, .y = p.y, .z = [0; 6] });\n    Vec::push(&mut t, p);\n   "
    " for (usize i = 2; i < 16; i += 1)\n    {\n        Jacobian next = if (i % 2 == 0) { jac_double(f, t[i"
    " / 2]) } else { jac_add(f, t[i - 1], p) };\n        Vec::push(&mut t, next);\n    }\n    t\n}fn f_nibble"
    "(array<u64, 6> a, usize w) : usize\n{\n    narrow<usize>((a[w / 16] >> narrow<u32>(4 * (w % 16))) & 15"
    ")\n}fn jac_twin(ref<Field, shared> f, array<u64, 6> u1, Jacobian g, array<u64, 6> u2, Jacobian q, usi"
    "ze bits) : Jacobian\n{\n    Vec<Jacobian> tg = jac_table(f, g);\n    Vec<Jacobian> tq = jac_table(f, q)"
    ";\n    Jacobian acc = tg[0];\n    usize w = bits / 4;\n    while (w > 0)\n    {\n        w -= 1;\n        "
    "for (usize k = 0; k < 4; k += 1)\n        {\n            acc = jac_double(f, acc);\n        }\n        u"
    "size d1 = f_nibble(u1, w);\n        usize d2 = f_nibble(u2, w);\n        if (d1 != 0)\n        {\n      "
    "      acc = jac_add(f, acc, tg[d1]);\n        }\n        if (d2 != 0)\n        {\n            acc = jac_"
    "add(f, acc, tq[d2]);\n        }\n    }\n    acc\n}fn jac_twin_bits(\n    ref<Field, shared> f,\n    array<"
    "u64, 6> u1,\n    Jacobian g,\n    array<u64, 6> u2,\n    Jacobian q,\n    usize bits,\n) : Jacobian\n{\n   "
    " Jacobian gq = jac_add(f, g, q);\n    Jacobian acc = Jacobian { .x = g.x, .y = g.y, .z = [0; 6] };\n  "
    "  usize i = bits;\n    while (i > 0)\n    {\n        i -= 1;\n        acc = jac_double(f, acc);\n        "
    "bool b1 = f_bit(u1, i);\n        bool b2 = f_bit(u2, i);\n        if (b1 && b2)\n        {\n            "
    "acc = jac_add(f, acc, gq);\n        }\n        else if (b1)\n        {\n            acc = jac_add(f, acc"
    ", g);\n        }\n        else if (b2)\n        {\n            acc = jac_add(f, acc, q);\n        }\n    }"
    "\n    acc\n}fn curve_hex(ref<Field, shared> f, str hex) : array<u64, 6>\n{\n    Vec<u8> b = Result::unwr"
    "ap_or(from_hex(StringView::of(hex)), Vec::new());\n    Option::unwrap(f_from_be(f, &b[0..$]))\n}fn der"
    "_positive_int(slice<u8, shared> d, usize at) : Option<DerSpan>\n{\n    if (at + 2 > slice_len(d) || d["
    "at] != 0x02)\n    {\n        return None;\n    }\n    usize len = widen<usize>(d[at + 1]);\n    usize sta"
    "rt = at + 2;\n    if (len == 0 || len > 0x7f || start + len > slice_len(d))\n    {\n        return None"
    ";\n    }\n    if ((d[start] & 0x80) != 0)\n    {\n        return None;\n    }\n    if (len > 1 && d[start]"
    " == 0 && (d[start + 1] & 0x80) == 0)\n    {\n        return None;\n    }\n    // A leading zero byte onl"
    "y marks the number positive.\n    usize from = if (d[start] == 0 && len > 1) { start + 1 } else { sta"
    "rt };\n    Some(DerSpan { .start = from, .end = start + len })\n}export fn ecdsa_verify(\n    EcCurve c"
    "urve,\n    slice<u8, shared> public_key,\n    slice<u8, shared> digest,\n    slice<u8, shared> signatur"
    "e,\n) : bool\n{\n    Field fp = field_of(curve, false);\n    Field fn_ = field_of(curve, true);\n    usiz"
    "e size = 8 * fp.n;\n    if (slice_len(public_key) != 1 + 2 * size || public_key[0] != 0x04)\n    {\n   "
    "     return false;\n    }\n    array<u64, 6> qx = match (f_from_be(&fp, &public_key[1..1 + size]))\n   "
    " {\n        Some(v) : f_to_mont(&fp, v),\n        None    : return false,\n    };\n    array<u64, 6> qy "
    "= match (f_from_be(&fp, &public_key[1 + size..$]))\n    {\n        Some(v) : f_to_mont(&fp, v),\n      "
    "  None    : return false,\n    };\n    str b_hex = match (curve)\n    {\n        P256 : \"5ac635d8aa3a93e"
    "7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b\",\n        P384 : \"b3312fa7e23ee7e4988e056be3f82d19"
    "181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef\",\n    };\n    array<u64, 6> b = f_to"
    "_mont(&fp, curve_hex(&fp, b_hex));\n    // y² = x³ - 3x + b\n    array<u64, 6> lhs = mont_mul(&fp, q"
    "y, qy);\n    array<u64, 6> rhs = f_add(&fp, f_sub(&fp, mont_mul(&fp, mont_mul(&fp, qx, qx), qx), f_sm"
    "all(&fp, 3, qx)), b);\n    if (!f_is_zero(&fp, f_sub(&fp, lhs, rhs)))\n    {\n        return false;\n   "
    " }\n    usize sl = slice_len(signature);\n    if (sl < 8 || signature[0] != 0x30 || signature[1] > 0x7"
    "f || widen<usize>(signature[1]) != sl - 2)\n    {\n        return false;\n    }\n    DerSpan rs = match "
    "(der_positive_int(signature, 2))\n    {\n        Some(v) : v,\n        None    : return false,\n    };\n "
    "   DerSpan ss = match (der_positive_int(signature, rs.end))\n    {\n        Some(v) : v,\n        None "
    "   : return false,\n    };\n    if (ss.end != sl)\n    {\n        return false;\n    }\n    array<u64, 6> "
    "r = match (f_from_be(&fn_, &signature[rs.start..rs.end]))\n    {\n        Some(v) : v,\n        None   "
    " : return false,\n    };\n    array<u64, 6> s = match (f_from_be(&fn_, &signature[ss.start..ss.end]))\n"
    "    {\n        Some(v) : v,\n        None    : return false,\n    };\n    if (f_is_zero(&fn_, r) || f_is"
    "_zero(&fn_, s))\n    {\n        return false;\n    }\n    // e: the digest's leftmost 8·size bits (the "
    "order's bit length is the\n    // prime's for both curves), reduced once below n.\n    usize take = mi"
    "n(slice_len(digest), size);\n    array<u64, 6> e = [0; 6];\n    for (usize k = 0; k < take; k += 1)\n  "
    "  {\n        usize pos = take - 1 - k;\n        e[k / 8] = e[k / 8] | (widen<u64>(digest[pos]) << narr"
    "ow<u32>(8 * (k % 8)));\n    }\n    if (!f_less(&fn_, e, fn_.m))\n    {\n        e = f_sub_raw(&fn_, e, f"
    "n_.m);\n    }\n    array<u64, 6> w = f_invert(&fn_, f_to_mont(&fn_, s));\n    array<u64, 6> u1 = f_from"
    "_mont(&fn_, mont_mul(&fn_, f_to_mont(&fn_, e), w));\n    array<u64, 6> u2 = f_from_mont(&fn_, mont_mu"
    "l(&fn_, f_to_mont(&fn_, r), w));\n    str gx = match (curve)\n    {\n        P256 : \"6b17d1f2e12c4247f8"
    "bce6e563a440f277037d812deb33a0f4a13945d898c296\",\n        P384 : \"aa87ca22be8b05378eb1c71ef320ad746e1"
    "d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7\",\n    };\n    str gy = match (curve)\n  "
    "  {\n        P256 : \"4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5\",\n        P384 "
    ": \"3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f\""
    ",\n    };\n    array<u64, 6> one = f_to_mont(&fp, [1, 0, 0, 0, 0, 0]);\n    Jacobian g = Jacobian { .x "
    "= f_to_mont(\n        &fp,\n        curve_hex(&fp, gx),\n    ), .y = f_to_mont(&fp, curve_hex(&fp, gy))"
    ", .z = one };\n    Jacobian q = Jacobian { .x = qx, .y = qy, .z = one };\n    Jacobian p = jac_twin(&f"
    "p, u1, g, u2, q, size * 8);\n    if (f_is_zero(&fp, p.z))\n    {\n        return false;\n    }\n    // x "
    "mod n = r, without inverting Z: x = X/Z², and x mod n is r exactly\n    // when x is r or (as x < p "
    "< 2n for both curves) r + n, the latter only\n    // possible when r + n < p. So compare X with r·Z²"
    " and (r + n)·Z².\n    array<u64, 6> z2 = mont_mul(&fp, p.z, p.z);\n    if (f_is_zero(&fp, f_sub(&fp,"
    " p.x, mont_mul(&fp, f_to_mont(&fp, r), z2))))\n    {\n        return true;\n    }\n    array<u64, 6> rn "
    "= f_add_raw(&fp, r, fn_.m);\n    if (f_less(&fn_, rn, fp.m) && f_less(&fn_, r, rn))\n    {\n        ret"
    "urn f_is_zero(&fp, f_sub(&fp, p.x, mont_mul(&fp, f_to_mont(&fp, rn), z2)));\n    }\n    false\n}fn curv"
    "e_b_hex(EcCurve c) : str\n{\n    match (c)\n    {\n        P256 : \"5ac635d8aa3a93e7b3ebbd55769886bc651d0"
    "6b0cc53b0f63bce3c3e27d2604b\",\n        P384 : \"b3312fa7e23ee7e4988e056be3f82d19181d9c6efe814112031408"
    "8f5013875ac656398d8a2ed19d2a85c8edd3ec2aef\",\n    }\n}fn curve_base(ref<Field, shared> fp, EcCurve c) "
    ": Jacobian\n{\n    str gx = match (c)\n    {\n        P256 : \"6b17d1f2e12c4247f8bce6e563a440f277037d812d"
    "eb33a0f4a13945d898c296\",\n        P384 : \"aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e0825"
    "42a385502f25dbf55296c3a545e3872760ab7\",\n    };\n    str gy = match (c)\n    {\n        P256 : \"4fe342e2"
    "fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5\",\n        P384 : \"3617de4a96262c6f5d9e98bf9"
    "292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f\",\n    };\n    Jacobian { .x ="
    " f_to_mont(\n        fp,\n        curve_hex(fp, gx),\n    ), .y = f_to_mont(fp, curve_hex(fp, gy)), .z "
    "= f_to_mont(fp, [1, 0, 0, 0, 0, 0]) }\n}fn curve_point(ref<Field, shared> fp, EcCurve c, slice<u8, sh"
    "ared> public_key) : Option<Jacobian>\n{\n    usize size = 8 * fp.n;\n    if (slice_len(public_key) != 1"
    " + 2 * size || public_key[0] != 0x04)\n    {\n        return None;\n    }\n    array<u64, 6> qx = f_to_m"
    "ont(fp, f_from_be(fp, &public_key[1..1 + size])?);\n    array<u64, 6> qy = f_to_mont(fp, f_from_be(fp"
    ", &public_key[1 + size..$])?);\n    array<u64, 6> b = f_to_mont(fp, curve_hex(fp, curve_b_hex(c)));\n "
    "   array<u64, 6> lhs = mont_mul(fp, qy, qy);\n    array<u64, 6> rhs = f_add(fp, f_sub(fp, mont_mul(fp"
    ", mont_mul(fp, qx, qx), qx), f_small(fp, 3, qx)), b);\n    if (!f_is_zero(fp, f_sub(fp, lhs, rhs)))\n "
    "   {\n        return None;\n    }\n    Some(Jacobian { .x = qx, .y = qy, .z = f_to_mont(fp, [1, 0, 0, 0"
    ", 0, 0]) })\n}fn jac_select(u64 mask, Jacobian a, Jacobian b) : Jacobian\n{\n    Jacobian { .x = f_sele"
    "ct(mask, a.x, b.x), .y = f_select(mask, a.y, b.y), .z = f_select(mask, a.z, b.z) }\n}fn limbs7_add(ar"
    "ray<u64, 7> a, array<u64, 7> b) : array<u64, 7>\n{\n    array<u64, 7> r = [0; 7];\n    u64 carry = 0;\n "
    "   for (usize i = 0; i < 7; i += 1)\n    {\n        u128 s = widen<u128>(a[i]) + widen<u128>(b[i]) + w"
    "iden<u128>(carry);\n        r[i] = narrow_wrapping<u64>(s);\n        carry = narrow_wrapping<u64>(s >>"
    " 64);\n    }\n    r\n}fn ec_mul(ref<Field, shared> fp, ref<Field, shared> fn_, array<u64, 6> k, Jacobia"
    "n p) : Jacobian\n{\n    usize bits = 64 * fp.n;\n    array<u64, 7> n7 = [fn_.m[0], fn_.m[1], fn_.m[2], "
    "fn_.m[3], fn_.m[4], fn_.m[5], 0];\n    array<u64, 7> k1 = limbs7_add([k[0], k[1], k[2], k[3], k[4], k"
    "[5], 0], n7);\n    array<u64, 7> k2 = limbs7_add(k1, n7);\n    // k + n when that reaches 2^bits, k + "
    "2n otherwise: bit `bits` is set\n    // and nothing above it.\n    u64 mask = wrapping_sub(0, k1[bits "
    "/ 64] & 1);\n    array<u64, 7> kh = [0; 7];\n    for (usize i = 0; i < 7; i += 1)\n    {\n        kh[i] "
    "= (k1[i] & mask) | (k2[i] & ~mask);\n    }\n    Jacobian acc = p;\n    usize i = bits;\n    while (i > 0"
    ")\n    {\n        i -= 1;\n        acc = jac_double(fp, acc);\n        Jacobian sum = jac_add(fp, acc, p"
    ");\n        u64 bit = (kh[i / 64] >> narrow<u32>(i % 64)) & 1;\n        acc = jac_select(wrapping_sub("
    "0, bit), sum, acc);\n    }\n    acc\n}fn limbs_be(array<u64, 6> a, usize len) : Vec<u8>\n{\n    Vec<u8> b"
    " = Vec::filled(len, 0: u8);\n    for (usize i = 0; i < len; i += 1)\n    {\n        b[len - 1 - i] = na"
    "rrow_wrapping<u8>(a[i / 8] >> narrow<u32>(8 * (i % 8)));\n    }\n    b\n}fn ec_scalar(ref<Field, shared"
    "> fn_, slice<u8, shared> private_key) : Option<array<u64, 6>>\n{\n    if (slice_len(private_key) != 8 "
    "* fn_.n)\n    {\n        fault(crypto_length);\n    }\n    match (f_from_be(fn_, private_key))\n    {\n   "
    "     Some(k) : if (f_is_zero(fn_, k)) { None } else { Some(k) },\n        None    : None,\n    }\n}fn e"
    "c_affine(ref<Field, shared> fp, Jacobian q) : array<array<u64, 6>, 2>\n{\n    array<u64, 6> zinv = f_i"
    "nvert(fp, q.z);\n    array<u64, 6> zinv2 = mont_mul(fp, zinv, zinv);\n    array<u64, 6> x = f_from_mon"
    "t(fp, mont_mul(fp, q.x, zinv2));\n    array<u64, 6> y = f_from_mont(fp, mont_mul(fp, q.y, mont_mul(fp"
    ", zinv2, zinv)));\n    [x, y]\n}export fn ec_private_key(EcCurve curve) : Vec<u8>\n{\n    Field fn_ = fi"
    "eld_of(curve, true);\n    Vec<u8> k = Vec::filled(8 * fn_.n, 0: u8);\n    while (true)\n    {\n        o"
    "s_random_bytes(&mut k[0..$]);\n        if (Option::is_some(&ec_scalar(&fn_, &k[0..$])))\n        {\n   "
    "         return k;\n        }\n    }\n}export fn ec_public_key(EcCurve curve, slice<u8, shared> private"
    "_key) : Option<Vec<u8>>\n{\n    Field fp = field_of(curve, false);\n    Field fn_ = field_of(curve, tru"
    "e);\n    array<u64, 6> k = ec_scalar(&fn_, private_key)?;\n    usize size = 8 * fp.n;\n    array<array<"
    "u64, 6>, 2> xy = ec_affine(&fp, ec_mul(&fp, &fn_, k, curve_base(&fp, curve)));\n    Vec<u8> out = Vec"
    "::new();\n    Vec::push(&mut out, 0x04);\n    Vec::extend_from(&mut out, &limbs_be(xy[0], size)[0..$])"
    ";\n    Vec::extend_from(&mut out, &limbs_be(xy[1], size)[0..$]);\n    Some(out)\n}unittest \"ec_public_k"
    "ey: a scalar outside [1, n-1] has none\"\n{\n    array<u8, 32> zero = [0; 32];\n    assert(Option::is_no"
    "ne(&ec_public_key(P256, &zero[0..$])));\n    array<u8, 32> above = [0xff; 32];\n    assert(Option::is_"
    "none(&ec_public_key(P256, &above[0..$])));\n}export fn ecdh(EcCurve curve, slice<u8, shared> private_"
    "key, slice<u8, shared> public_key) : Option<Vec<u8>>\n{\n    Field fp = field_of(curve, false);\n    Fi"
    "eld fn_ = field_of(curve, true);\n    array<u64, 6> k = ec_scalar(&fn_, private_key)?;\n    Jacobian q"
    " = curve_point(&fp, curve, public_key)?;\n    Jacobian r = ec_mul(&fp, &fn_, k, q);\n    if (f_is_zero"
    "(&fp, r.z))\n    {\n        return None;\n    }\n    Some(limbs_be(ec_affine(&fp, r)[0], 8 * fp.n))\n}exp"
    "ort fn p256_private_key() : array<u8, 32>\n{\n    Vec<u8> k = ec_private_key(P256);\n    array<u8, 32> "
    "out = [0; 32];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        out[i] = k[i];\n    }\n    out\n}exp"
    "ort fn p256_public_key(slice<u8, shared> private_key) : Option<array<u8, 65>>\n{\n    Vec<u8> q = ec_p"
    "ublic_key(P256, private_key)?;\n    array<u8, 65> out = [0; 65];\n    for (usize i = 0; i < 65; i += 1"
    ")\n    {\n        out[i] = q[i];\n    }\n    Some(out)\n}export fn p256_ecdh(slice<u8, shared> private_ke"
    "y, slice<u8, shared> public_key) : Option<array<u8, 32>>\n{\n    Vec<u8> z = ecdh(P256, private_key, p"
    "ublic_key)?;\n    array<u8, 32> out = [0; 32];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        ou"
    "t[i] = z[i];\n    }\n    Some(out)\n}fn digest_scalar(ref<Field, shared> fn_, slice<u8, shared> digest,"
    " usize size) : array<u64, 6>\n{\n    usize take = min(slice_len(digest), size);\n    array<u64, 6> e = "
    "[0; 6];\n    for (usize k = 0; k < take; k += 1)\n    {\n        usize pos = take - 1 - k;\n        e[k "
    "/ 8] = e[k / 8] | (widen<u64>(digest[pos]) << narrow<u32>(8 * (k % 8)));\n    }\n    if (!f_less(fn_, "
    "e, fn_.m))\n    {\n        e = f_sub_raw(fn_, e, fn_.m);\n    }\n    e\n}fn der_push_uint(ref<Vec<u8>, ex"
    "clusive> out, slice<u8, shared> v)\n{\n    usize from = 0;\n    while (from + 1 < slice_len(v) && v[fro"
    "m] == 0)\n    {\n        from += 1;\n    }\n    bool pad = (v[from] & 0x80) != 0;\n    Vec::push(out, 0x0"
    "2);\n    Vec::push(out, narrow<u8>(slice_len(v) - from + (if (pad) { 1 } else { 0 })));\n    if (pad)\n"
    "    {\n        Vec::push(out, 0);\n    }\n    Vec::extend_from(out, &v[from..$]);\n}export fn ecdsa_sign"
    "(EcCurve curve, slice<u8, shared> private_key, slice<u8, shared> digest) : Option<Vec<u8>>\n{\n    Fie"
    "ld fp = field_of(curve, false);\n    Field fn_ = field_of(curve, true);\n    usize size = 8 * fp.n;\n  "
    "  array<u64, 6> x = ec_scalar(&fn_, private_key)?;\n    HashKind kind = match (curve)\n    {\n        P"
    "256 : Sha2_256,\n        P384 : Sha2_384,\n    };\n    array<u64, 6> e = digest_scalar(&fn_, digest, si"
    "ze);\n    Vec<u8> x_bytes = limbs_be(x, size);\n    Vec<u8> e_bytes = limbs_be(e, size);\n    Jacobian "
    "g = curve_base(&fp, curve);\n    array<u64, 6> xm = f_to_mont(&fn_, x);\n    array<u64, 6> em = f_to_m"
    "ont(&fn_, e);\n    // RFC 6979 §3.2 steps b to h.\n    usize hlen = hash_len(kind);\n    Vec<u8> v = V"
    "ec::filled(hlen, 1: u8);\n    Vec<u8> key = Vec::filled(hlen, 0: u8);\n    for (u8 round = 0; round < "
    "2; round += 1)\n    {\n        Hmac m = Hmac::new(kind, &key[0..$]);\n        Hmac::update(&mut m, &v[0"
    "..$]);\n        array<u8, 1> sep = [round];\n        Hmac::update(&mut m, &sep[0..$]);\n        Hmac::u"
    "pdate(&mut m, &x_bytes[0..$]);\n        Hmac::update(&mut m, &e_bytes[0..$]);\n        overwrite(&mut "
    "key, Hmac::finish(m));\n        overwrite(&mut v, hmac(kind, &key[0..$], &v[0..$]));\n    }\n    while "
    "(true)\n    {\n        overwrite(&mut v, hmac(kind, &key[0..$], &v[0..$]));\n        // T is V itself: "
    "the hash is as long as the order for both curves.\n        Option<array<u64, 6>> candidate = f_from_b"
    "e(&fn_, &v[0..size]);\n        if (Some(k) = candidate)\n        {\n            if (!f_is_zero(&fn_, k)"
    ")\n            {\n                array<u64, 6> r = ec_affine(&fp, ec_mul(&fp, &fn_, k, g))[0];\n      "
    "          if (!f_less(&fn_, r, fn_.m))\n                {\n                    r = f_sub_raw(&fn_, r, "
    "fn_.m);\n                }\n                if (!f_is_zero(&fn_, r))\n                {\n               "
    "     array<u64, 6> kinv = f_invert(&fn_, f_to_mont(&fn_, k));\n                    array<u64, 6> rx ="
    " mont_mul(&fn_, f_to_mont(&fn_, r), xm);\n                    array<u64, 6> s = f_from_mont(&fn_, mon"
    "t_mul(&fn_, kinv, f_add(&fn_, em, rx)));\n                    if (!f_is_zero(&fn_, s))\n              "
    "      {\n                        Vec<u8> body = Vec::new();\n                        der_push_uint(&mu"
    "t body, &limbs_be(r, size)[0..$]);\n                        der_push_uint(&mut body, &limbs_be(s, siz"
    "e)[0..$]);\n                        Vec<u8> out = Vec::new();\n                        Vec::push(&mut "
    "out, 0x30);\n                        Vec::push(&mut out, narrow<u8>(Vec::len(&body)));\n              "
    "          Vec::extend_from(&mut out, &body[0..$]);\n                        return Some(out);\n       "
    "             }\n                }\n            }\n        }\n        Hmac m = Hmac::new(kind, &key[0..$]"
    ");\n        Hmac::update(&mut m, &v[0..$]);\n        array<u8, 1> zero = [0];\n        Hmac::update(&mu"
    "t m, &zero[0..$]);\n        overwrite(&mut key, Hmac::finish(m));\n        overwrite(&mut v, hmac(kind"
    ", &key[0..$], &v[0..$]));\n    }\n}fn fe_neg(array<u64, 5> a) : array<u64, 5>\n{\n    fe_sub([0, 0, 0, 0"
    ", 0], a)\n}fn fe_is_zero(array<u64, 5> a) : bool\n{\n    array<u8, 32> b = fe_to_bytes(a);\n    u8 acc ="
    " 0;\n    for (usize i = 0; i < 32; i += 1)\n    {\n        acc = acc | b[i];\n    }\n    acc == 0\n}fn fe_"
    "eq(array<u64, 5> a, array<u64, 5> b) : bool\n{\n    fe_is_zero(fe_sub(a, b))\n}fn fe_select(u64 mask, a"
    "rray<u64, 5> a, array<u64, 5> b) : array<u64, 5>\n{\n    array<u64, 5> r = [0; 5];\n    for (usize i = "
    "0; i < 5; i += 1)\n    {\n        r[i] = (a[i] & mask) | (b[i] & ~mask);\n    }\n    r\n}fn fe_pow_p58(ar"
    "ray<u64, 5> z) : array<u64, 5>\n{\n    array<u64, 5> r = [1, 0, 0, 0, 0];\n    for (usize k = 0; k < 25"
    "2; k += 1)\n    {\n        usize i = 251 - k;\n        r = fe_mul(r, r);\n        if (i != 1)\n        {\n"
    "            r = fe_mul(r, z);\n        }\n    }\n    r\n}fn ed_identity() : Ed\n{\n    Ed { .x = [0, 0, 0,"
    " 0, 0], .y = [1, 0, 0, 0, 0], .z = [1, 0, 0, 0, 0], .t = [0, 0, 0, 0, 0] }\n}fn ed_base() : Ed\n{\n    "
    "Ed { .x = ED_BX, .y = ED_BY, .z = [1, 0, 0, 0, 0], .t = fe_mul(ED_BX, ED_BY) }\n}fn ed_add(Ed p, Ed q"
    ") : Ed\n{\n    array<u64, 5> a = fe_mul(fe_sub(p.y, p.x), fe_sub(q.y, q.x));\n    array<u64, 5> b = fe_"
    "mul(fe_add(p.y, p.x), fe_add(q.y, q.x));\n    array<u64, 5> c = fe_mul(fe_mul(p.t, ED_2D), q.t);\n    "
    "array<u64, 5> d = fe_mul(fe_add(p.z, p.z), q.z);\n    array<u64, 5> e = fe_sub(b, a);\n    array<u64, "
    "5> f = fe_sub(d, c);\n    array<u64, 5> g = fe_add(d, c);\n    array<u64, 5> h = fe_add(b, a);\n    Ed "
    "{ .x = fe_mul(e, f), .y = fe_mul(g, h), .z = fe_mul(f, g), .t = fe_mul(e, h) }\n}fn ed_double(Ed p) :"
    " Ed\n{\n    array<u64, 5> a = fe_mul(p.x, p.x);\n    array<u64, 5> b = fe_mul(p.y, p.y);\n    array<u64,"
    " 5> zz = fe_mul(p.z, p.z);\n    array<u64, 5> c = fe_add(zz, zz);\n    array<u64, 5> h = fe_add(a, b);"
    "\n    array<u64, 5> xy = fe_add(p.x, p.y);\n    array<u64, 5> e = fe_sub(h, fe_mul(xy, xy));\n    array"
    "<u64, 5> g = fe_sub(a, b);\n    array<u64, 5> f = fe_add(c, g);\n    Ed { .x = fe_mul(e, f), .y = fe_m"
    "ul(g, h), .z = fe_mul(f, g), .t = fe_mul(e, h) }\n}fn ed_select(u64 mask, Ed a, Ed b) : Ed\n{\n    Ed {"
    " .x = fe_select(\n        mask,\n        a.x,\n        b.x,\n    ), .y = fe_select(mask, a.y, b.y), .z ="
    " fe_select(mask, a.z, b.z), .t = fe_select(mask, a.t, b.t) }\n}fn ed_mul(slice<u8, shared> scalar, Ed"
    " p) : Ed\n{\n    Ed acc = ed_identity();\n    usize i = 256;\n    while (i > 0)\n    {\n        i -= 1;\n  "
    "      acc = ed_double(acc);\n        Ed sum = ed_add(acc, p);\n        u64 bit = widen<u64>((scalar[i "
    "/ 8] >> narrow<u32>(i % 8)) & 1);\n        acc = ed_select(wrapping_sub(0, bit), sum, acc);\n    }\n   "
    " acc\n}fn ed_encode(Ed p) : array<u8, 32>\n{\n    array<u64, 5> zinv = fe_invert(p.z);\n    array<u8, 32"
    "> out = fe_to_bytes(fe_mul(p.y, zinv));\n    array<u8, 32> xb = fe_to_bytes(fe_mul(p.x, zinv));\n    o"
    "ut[31] = out[31] | ((xb[0] & 1) << 7);\n    out\n}fn ed_decode(slice<u8, shared> b) : Option<Ed>\n{\n   "
    " array<u64, 5> y = fe_from_bytes(b);\n    array<u8, 32> canon = fe_to_bytes(y);\n    u8 diff = 0;\n    "
    "for (usize i = 0; i < 31; i += 1)\n    {\n        diff = diff | (canon[i] ^ b[i]);\n    }\n    diff = di"
    "ff | (canon[31] ^ (b[31] & 0x7f));\n    if (diff != 0)\n    {\n        return None;\n    }\n    u8 sign ="
    " b[31] >> 7;\n    array<u64, 5> y2 = fe_mul(y, y);\n    array<u64, 5> u = fe_sub(y2, [1, 0, 0, 0, 0]);"
    "\n    array<u64, 5> v = fe_add(fe_mul(ED_D, y2), [1, 0, 0, 0, 0]);\n    array<u64, 5> v3 = fe_mul(fe_m"
    "ul(v, v), v);\n    array<u64, 5> v7 = fe_mul(fe_mul(v3, v3), v);\n    array<u64, 5> x = fe_mul(fe_mul("
    "u, v3), fe_pow_p58(fe_mul(u, v7)));\n    array<u64, 5> vx2 = fe_mul(v, fe_mul(x, x));\n    if (!fe_eq("
    "vx2, u))\n    {\n        if (!fe_eq(vx2, fe_neg(u)))\n        {\n            return None;\n        }\n    "
    "    x = fe_mul(x, ED_SQRT_M1);\n    }\n    array<u8, 32> xb = fe_to_bytes(x);\n    if ((xb[0] & 1) == 0"
    " && sign == 1 && fe_is_zero(x))\n    {\n        return None;\n    }\n    if ((xb[0] & 1) != sign)\n    {\n"
    "        x = fe_neg(x);\n    }\n    Some(Ed { .x = x, .y = y, .z = [1, 0, 0, 0, 0], .t = fe_mul(x, y) }"
    ")\n}fn ed_order() : Field\n{\n    Field { .m = [\n        0x5812631a5cf5d3ed,\n        0x14def9dea2f79cd6"
    ",\n        0x0000000000000000,\n        0x1000000000000000,\n        0x0000000000000000,\n        0x0000"
    "000000000000,\n    ], .n = 4, .minv = 0xd2b51da312547e1b, .r2 = [\n        0xa40611e3449c0f01,\n       "
    " 0xd00e1ba768859347,\n        0xceec73d217f5be65,\n        0x0399411b7c309a3d,\n        0x0000000000000"
    "000,\n        0x0000000000000000,\n    ] }\n}fn le_limbs(slice<u8, shared> b) : array<u64, 6>\n{\n    arr"
    "ay<u64, 6> r = [0; 6];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        r[i / 8] = r[i / 8] | (wi"
    "den<u64>(b[i]) << narrow<u32>(8 * (i % 8)));\n    }\n    r\n}fn sc_mont(ref<Field, shared> fl, array<u6"
    "4, 6> a) : array<u64, 6>\n{\n    mont_mul(fl, a, fl.r2)\n}fn sc_from_hash(ref<Field, shared> fl, slice<"
    "u8, shared> h) : array<u64, 6>\n{\n    array<u64, 6> lo = sc_mont(fl, le_limbs(&h[0..32]));\n    array<"
    "u64, 6> hi = sc_mont(fl, sc_mont(fl, le_limbs(&h[32..64])));\n    f_add(fl, lo, hi)\n}fn sc_bytes(ref<"
    "Field, shared> fl, array<u64, 6> m) : array<u8, 32>\n{\n    array<u64, 6> a = f_from_mont(fl, m);\n    "
    "array<u8, 32> out = [0; 32];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        out[i] = narrow_wra"
    "pping<u8>(a[i / 8] >> narrow<u32>(8 * (i % 8)));\n    }\n    out\n}fn ed_expand(slice<u8, shared> priva"
    "te_key) : EdExpanded\n{\n    if (slice_len(private_key) != 32)\n    {\n        fault(crypto_length);\n   "
    " }\n    array<u8, 64> h = sha512(private_key);\n    array<u8, 32> s = [0; 32];\n    array<u8, 32> prefi"
    "x = [0; 32];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        s[i] = h[i];\n        prefix[i] = h["
    "32 + i];\n    }\n    s[0] = s[0] & 248;\n    s[31] = (s[31] & 127) | 64;\n    EdExpanded { .scalar = s, "
    ".prefix = prefix }\n}export fn ed25519_private_key() : array<u8, 32>\n{\n    array<u8, 32> k = [0; 32];"
    "\n    os_random_bytes(&mut k[0..$]);\n    k\n}export fn ed25519_public_key(slice<u8, shared> private_ke"
    "y) : array<u8, 32>\n{\n    EdExpanded e = ed_expand(private_key);\n    ed_encode(ed_mul(&e.scalar[0..$]"
    ", ed_base()))\n}export fn ed25519_sign(slice<u8, shared> private_key, slice<u8, shared> message) : ar"
    "ray<u8, 64>\n{\n    EdExpanded e = ed_expand(private_key);\n    Field fl = ed_order();\n    array<u8, 32"
    "> a = ed_encode(ed_mul(&e.scalar[0..$], ed_base()));\n    Sha512 hr = Sha512::new();\n    Sha512::upda"
    "te(&mut hr, &e.prefix[0..$]);\n    Sha512::update(&mut hr, message);\n    array<u64, 6> r = sc_from_ha"
    "sh(&fl, &Sha512::finish(hr)[0..$]);\n    array<u8, 32> r_bytes = sc_bytes(&fl, r);\n    array<u8, 32> "
    "big_r = ed_encode(ed_mul(&r_bytes[0..$], ed_base()));\n    Sha512 hk = Sha512::new();\n    Sha512::upd"
    "ate(&mut hk, &big_r[0..$]);\n    Sha512::update(&mut hk, &a[0..$]);\n    Sha512::update(&mut hk, messa"
    "ge);\n    array<u64, 6> k = sc_from_hash(&fl, &Sha512::finish(hk)[0..$]);\n    array<u64, 6> s = f_add"
    "(&fl, r, mont_mul(&fl, k, sc_mont(&fl, le_limbs(&e.scalar[0..$]))));\n    array<u8, 32> s_bytes = sc_"
    "bytes(&fl, s);\n    array<u8, 64> out = [0; 64];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        "
    "out[i] = big_r[i];\n        out[32 + i] = s_bytes[i];\n    }\n    out\n}export fn ed25519_verify(slice<u"
    "8, shared> public_key, slice<u8, shared> message, slice<u8, shared> signature) : bool\n{\n    if (slic"
    "e_len(public_key) != 32 || slice_len(signature) != 64)\n    {\n        return false;\n    }\n    Ed a = "
    "match (ed_decode(public_key))\n    {\n        Some(p) : p,\n        None    : return false,\n    };\n    "
    "Ed big_r = match (ed_decode(&signature[0..32]))\n    {\n        Some(p) : p,\n        None    : return "
    "false,\n    };\n    Field fl = ed_order();\n    array<u64, 6> s = le_limbs(&signature[32..64]);\n    if "
    "(!f_less(&fl, s, fl.m))\n    {\n        return false;\n    }\n    Sha512 hk = Sha512::new();\n    Sha512:"
    ":update(&mut hk, &signature[0..32]);\n    Sha512::update(&mut hk, public_key);\n    Sha512::update(&mu"
    "t hk, message);\n    array<u8, 32> k = sc_bytes(&fl, sc_from_hash(&fl, &Sha512::finish(hk)[0..$]));\n "
    "   array<u8, 32> lhs = ed_encode(ed_mul(&signature[32..64], ed_base()));\n    array<u8, 32> rhs = ed_"
    "encode(ed_add(big_r, ed_mul(&k[0..$], a)));\n    digest_eq(&lhs[0..$], &rhs[0..$])\n}fn limbs_of(ref<B"
    "igUint, shared> a, usize n) : Vec<u64>\n{\n    Vec<u8> be = BigUint::to_bytes_be_padded(a, 8 * n);\n   "
    " Vec<u64> out = Vec::filled(n, 0: u64);\n    for (usize i = 0; i < 8 * n; i += 1)\n    {\n        out[i"
    " / 8] = out[i / 8] | (widen<u64>(be[8 * n - 1 - i]) << narrow<u32>(8 * (i % 8)));\n    }\n    out\n}fn "
    "biguint_of(ref<Vec<u64>, shared> limbs) : BigUint\n{\n    usize n = Vec::len(limbs);\n    Vec<u8> be = "
    "Vec::filled(8 * n, 0: u8);\n    for (usize i = 0; i < 8 * n; i += 1)\n    {\n        be[8 * n - 1 - i] "
    "= narrow_wrapping<u8>(limbs[i / 8] >> narrow<u32>(8 * (i % 8)));\n    }\n    BigUint::from_bytes_be(&b"
    "e[0..$])\n}fn mont_new(ref<BigUint, shared> modulus) : Mont\n{\n    usize n = (BigUint::bit_len(modulus"
    ") + 63) / 64;\n    Vec<u64> m = limbs_of(modulus, n);\n    // m⁻¹ mod 2^64 by Newton's iteration fr"
    "om the odd m's own low limb.\n    u64 inv = 1;\n    for (usize i = 0; i < 7; i += 1)\n    {\n        inv"
    " = wrapping_mul(inv, wrapping_sub(2, wrapping_mul(m[0], inv)));\n    }\n    BigUint one = BigUint::fro"
    "m_u64(1);\n    BigUint r2 = BigUint::rem(&BigUint::shift_left(&one, 128 * n), modulus);\n    Mont { .m"
    " = m, .n = n, .minv = wrapping_sub(0, inv), .r2 = limbs_of(&r2, n) }\n}fn mont_mul_v(ref<Mont, shared"
    "> f, ref<Vec<u64>, shared> a, ref<Vec<u64>, shared> b) : Vec<u64>\n{\n    usize n = f.n;\n    Vec<u64> "
    "t = Vec::filled(n + 2, 0: u64);\n    for (usize i = 0; i < n; i += 1)\n    {\n        u128 c = 0;\n     "
    "   u128 bi = widen<u128>(b[i]);\n        for (usize j = 0; j < n; j += 1)\n        {\n            u128 "
    "x = widen<u128>(t[j]) + widen<u128>(a[j]) * bi + c;\n            t[j] = narrow_wrapping<u64>(x);\n    "
    "        c = x >> 64;\n        }\n        u128 y = widen<u128>(t[n]) + c;\n        t[n] = narrow_wrappin"
    "g<u64>(y);\n        t[n + 1] = narrow_wrapping<u64>(y >> 64);\n        u64 k = wrapping_mul(t[0], f.mi"
    "nv);\n        u128 kk = widen<u128>(k);\n        u128 z = widen<u128>(t[0]) + kk * widen<u128>(f.m[0])"
    ";\n        c = z >> 64;\n        for (usize j = 1; j < n; j += 1)\n        {\n            u128 x = widen"
    "<u128>(t[j]) + kk * widen<u128>(f.m[j]) + c;\n            t[j - 1] = narrow_wrapping<u64>(x);\n       "
    "     c = x >> 64;\n        }\n        u128 w = widen<u128>(t[n]) + c;\n        t[n - 1] = narrow_wrappi"
    "ng<u64>(w);\n        t[n] = t[n + 1] + narrow_wrapping<u64>(w >> 64);\n    }\n    // t - m unless t (wi"
    "th its carry) is below m: chosen by a mask.\n    Vec<u64> r = Vec::filled(n, 0: u64);\n    u64 borrow "
    "= 0;\n    for (usize j = 0; j < n; j += 1)\n    {\n        u128 x = wrapping_sub(wrapping_sub(widen<u12"
    "8>(t[j]), widen<u128>(f.m[j])), widen<u128>(borrow));\n        r[j] = narrow_wrapping<u64>(x);\n      "
    "  borrow = narrow_wrapping<u64>(x >> 127);\n    }\n    u64 keep = wrapping_sub(0, (1 - t[n]) & borrow)"
    ";\n    for (usize j = 0; j < n; j += 1)\n    {\n        r[j] = (t[j] & keep) | (r[j] & ~keep);\n    }\n  "
    "  r\n}fn mont_pow(ref<Mont, shared> f, ref<BigUint, shared> base, ref<BigUint, shared> exp) : BigUint"
    "\n{\n    biguint_of(&mont_pow_limbs(f, &limbs_of(base, f.n), exp))\n}fn mont_pow_limbs(ref<Mont, shared"
    "> f, ref<Vec<u64>, shared> base, ref<BigUint, shared> exp) : Vec<u64>\n{\n    usize n = f.n;\n    Vec<u"
    "64> one = Vec::filled(n, 0: u64);\n    one[0] = 1;\n    Vec<u64> one_m = mont_mul_v(f, &one, &f.r2);\n "
    "   Vec<u64> base_m = mont_mul_v(f, base, &f.r2);\n    Vec<Vec<u64>> table = Vec::new();\n    Vec::push"
    "(&mut table, Vec::clone(&one_m));\n    for (usize i = 1; i < 16; i += 1)\n    {\n        Vec<u64> next "
    "= mont_mul_v(f, &table[i - 1], &base_m);\n        Vec::push(&mut table, next);\n    }\n    Vec<u64> e ="
    " limbs_of(exp, n);\n    Vec<u64> acc = Vec::clone(&one_m);\n    usize windows = 16 * n;\n    usize w = "
    "windows;\n    while (w > 0)\n    {\n        w -= 1;\n        for (usize s = 0; s < 4; s += 1)\n        {\n"
    "            overwrite(&mut acc, mont_mul_v(f, &acc, &acc));\n        }\n        u64 bits = (e[w / 16] "
    ">> narrow<u32>(4 * (w % 16))) & 15;\n        Vec<u64> entry = Vec::filled(n, 0: u64);\n        for (u6"
    "4 i = 0; i < 16; i += 1)\n        {\n            u64 x = i ^ bits;\n            u64 mask = wrapping_sub"
    "(((x | wrapping_sub(0, x)) >> 63), 1);\n            for (usize j = 0; j < n; j += 1)\n            {\n  "
    "              entry[j] = entry[j] | (table[narrow<usize>(i)][j] & mask);\n            }\n        }\n   "
    "     overwrite(&mut acc, mont_mul_v(f, &acc, &entry));\n    }\n    mont_mul_v(f, &acc, &one)\n}export f"
    "n RsaPrivateKey::new(BigUint n, BigUint e, BigUint d, BigUint p, BigUint q) : Option<RsaPrivateKey>\n"
    "{\n    BigUint one = BigUint::from_u64(1);\n    BigUint two = BigUint::from_u64(2);\n    if (!BigUint::"
    "less(&two, &p) || !BigUint::less(&two, &q) || !BigUint::bit(&p, 0) || !BigUint::bit(&q, 0))\n    {\n  "
    "      return None;\n    }\n    if (!BigUint::eq(&BigUint::mul(&p, &q), &n))\n    {\n        return None;"
    "\n    }\n    BigUint p1 = BigUint::sub(&p, &one);\n    BigUint q1 = BigUint::sub(&q, &one);\n    BigUint"
    " ed = BigUint::mul(&e, &d);\n    if (!BigUint::eq(&BigUint::rem(&ed, &p1), &one) || !BigUint::eq(&Big"
    "Uint::rem(&ed, &q1), &one))\n    {\n        return None;\n    }\n    BigUint dp = BigUint::rem(&d, &p1);"
    "\n    BigUint dq = BigUint::rem(&d, &q1);\n    BigUint qinv = BigUint::mod_inverse(&q, &p)?;\n    Some("
    "RsaPrivateKey { .n = n, .e = e, .d = d, .p = p, .q = q, .dp = dp, .dq = dq, .qinv = qinv })\n}unittes"
    "t \"RsaPrivateKey::new: parts that do not fit are refused\"\n{\n    BigUint n = BigUint::from_u64(3233);"
    "\n    BigUint e = BigUint::from_u64(17);\n    BigUint p = BigUint::from_u64(61);\n    BigUint q = BigUi"
    "nt::from_u64(53);\n    Option<RsaPrivateKey> good = RsaPrivateKey::new(n, e, BigUint::from_u64(2753),"
    " p, q);\n    assert(Option::is_some(&good));\n    Option<RsaPrivateKey> bad = RsaPrivateKey::new(\n    "
    "    BigUint::from_u64(3233),\n        BigUint::from_u64(17),\n        BigUint::from_u64(2754),\n       "
    " BigUint::from_u64(61),\n        BigUint::from_u64(53),\n    );\n    assert(Option::is_none(&bad));\n}ex"
    "port fn RsaPrivateKey::public_key(ref<RsaPrivateKey, shared> key) : RsaPublicKey\n{\n    RsaPublicKey "
    "{ .n = BigUint::clone(&key.n), .e = BigUint::clone(&key.e) }\n}fn limbs_sub_mod(ref<Mont, shared> f, "
    "ref<Vec<u64>, shared> a, ref<Vec<u64>, shared> b) : Vec<u64>\n{\n    usize n = f.n;\n    Vec<u64> r = V"
    "ec::filled(n, 0: u64);\n    u64 borrow = 0;\n    for (usize j = 0; j < n; j += 1)\n    {\n        u128 x"
    " = wrapping_sub(wrapping_sub(widen<u128>(a[j]), widen<u128>(b[j])), widen<u128>(borrow));\n        r["
    "j] = narrow_wrapping<u64>(x);\n        borrow = narrow_wrapping<u64>(x >> 127);\n    }\n    // Add m ba"
    "ck where it borrowed.\n    u64 mask = wrapping_sub(0, borrow);\n    u64 carry = 0;\n    for (usize j = "
    "0; j < n; j += 1)\n    {\n        u128 x = widen<u128>(r[j]) + widen<u128>(f.m[j] & mask) + widen<u128"
    ">(carry);\n        r[j] = narrow_wrapping<u64>(x);\n        carry = narrow_wrapping<u64>(x >> 64);\n   "
    " }\n    r\n}fn rsa_private_op(ref<RsaPrivateKey, shared> key, ref<BigUint, shared> m) : BigUint\n{\n    "
    "Mont mp = mont_new(&key.p);\n    Mont mq = mont_new(&key.q);\n    usize np = mp.n;\n    usize nq = mq.n"
    ";\n    // m1 = m^dp mod p, m2 = m^dq mod q (m reduced: public values).\n    Vec<u64> m1 = mont_pow_lim"
    "bs(&mp, &limbs_of(&BigUint::rem(m, &key.p), np), &key.dp);\n    Vec<u64> m2 = mont_pow_limbs(&mq, &li"
    "mbs_of(&BigUint::rem(m, &key.q), nq), &key.dq);\n    // h = qinv·(m1 - m2 mod p) mod p, on p's arith"
    "metic.\n    Vec<u64> m2_mod_p = limbs_of(&BigUint::rem(&biguint_of(&m2), &key.p), np);\n    Vec<u64> d"
    "iff = limbs_sub_mod(&mp, &m1, &m2_mod_p);\n    Vec<u64> qinv_m = mont_mul_v(&mp, &limbs_of(&key.qinv,"
    " np), &mp.r2);\n    Vec<u64> h = mont_mul_v(&mp, &diff, &qinv_m);\n    // s = m2 + h·q: a plain produ"
    "ct over limbs, then the sum.\n    Vec<u64> q_limbs = limbs_of(&key.q, nq);\n    Vec<u64> s = Vec::fill"
    "ed(np + nq + 1, 0: u64);\n    for (usize i = 0; i < np; i += 1)\n    {\n        u128 carry = 0;\n       "
    " u128 hi = widen<u128>(h[i]);\n        for (usize j = 0; j < nq; j += 1)\n        {\n            u128 x"
    " = widen<u128>(s[i + j]) + hi * widen<u128>(q_limbs[j]) + carry;\n            s[i + j] = narrow_wrapp"
    "ing<u64>(x);\n            carry = x >> 64;\n        }\n        s[i + nq] = narrow_wrapping<u64>(carry);"
    "\n    }\n    u128 c = 0;\n    for (usize j = 0; j < np + nq + 1; j += 1)\n    {\n        u128 x = widen<u"
    "128>(s[j]) + (if (j < nq) { widen<u128>(m2[j]) } else { 0 }) + c;\n        s[j] = narrow_wrapping<u64"
    ">(x);\n        c = x >> 64;\n    }\n    BigUint result = biguint_of(&s);\n    // Checked against the pub"
    "lic key: a wrong result would leak the\n    // primes, so a key that fails is used without the CRT in"
    "stead.\n    if (BigUint::eq(&BigUint::mod_pow(&result, &key.e, &key.n), m))\n    {\n        return resu"
    "lt;\n    }\n    Mont mn = mont_new(&key.n);\n    mont_pow(&mn, m, &key.d)\n}fn pkcs1v15_encode(HashKind "
    "kind, slice<u8, shared> digest, usize k) : Vec<u8>\n{\n    Vec<u8> prefix = digest_info_prefix(kind);\n"
    "    usize t_len = Vec::len(&prefix) + slice_len(digest);\n    if (slice_len(digest) != hash_len(kind)"
    " || k < t_len + 11)\n    {\n        fault(crypto_length);\n    }\n    Vec<u8> em = Vec::new();\n    Vec::"
    "push(&mut em, 0);\n    Vec::push(&mut em, 1);\n    for (usize i = 0; i < k - t_len - 3; i += 1)\n    {\n"
    "        Vec::push(&mut em, 0xff);\n    }\n    Vec::push(&mut em, 0);\n    Vec::extend_from(&mut em, &pr"
    "efix[0..$]);\n    Vec::extend_from(&mut em, digest);\n    em\n}export fn rsa_sign_pkcs1v15(ref<RsaPriva"
    "teKey, shared> key, HashKind kind, slice<u8, shared> digest) : Vec<u8>\n{\n    usize k = (BigUint::bit"
    "_len(&key.n) + 7) / 8;\n    Vec<u8> em = pkcs1v15_encode(kind, digest, k);\n    BigUint s = rsa_privat"
    "e_op(key, &BigUint::from_bytes_be(&em[0..$]));\n    BigUint::to_bytes_be_padded(&s, k)\n}export fn rsa"
    "_sign_pss(ref<RsaPrivateKey, shared> key, HashKind kind, slice<u8, shared> digest) : Vec<u8>\n{\n    u"
    "size mod_bits = BigUint::bit_len(&key.n);\n    usize k = (mod_bits + 7) / 8;\n    usize h_len = hash_l"
    "en(kind);\n    usize em_bits = mod_bits - 1;\n    usize em_len = (em_bits + 7) / 8;\n    if (slice_len("
    "digest) != h_len || em_len < 2 * h_len + 2)\n    {\n        fault(crypto_length);\n    }\n    Vec<u8> sa"
    "lt = Vec::filled(h_len, 0: u8);\n    os_random_bytes(&mut salt[0..$]);\n    Vec<u8> m2 = Vec::filled(8"
    ", 0: u8);\n    Vec::extend_from(&mut m2, digest);\n    Vec::extend_from(&mut m2, &salt[0..$]);\n    Vec"
    "<u8> h = hash(kind, &m2[0..$]);\n    usize db_len = em_len - h_len - 1;\n    Vec<u8> db = Vec::filled("
    "db_len - h_len - 1, 0: u8);\n    Vec::push(&mut db, 1);\n    Vec::extend_from(&mut db, &salt[0..$]);\n "
    "   Vec<u8> mask = mgf1(kind, &h[0..$], db_len);\n    Vec<u8> em = Vec::new();\n    for (usize i = 0; i"
    " < db_len; i += 1)\n    {\n        Vec::push(&mut em, db[i] ^ mask[i]);\n    }\n    u32 unused = narrow<"
    "u32>(8 * em_len - em_bits);\n    em[0] = em[0] & narrow_wrapping<u8>((0xff: u32) >> unused);\n    Vec:"
    ":extend_from(&mut em, &h[0..$]);\n    Vec::push(&mut em, 0xbc);\n    BigUint s = rsa_private_op(key, &"
    "BigUint::from_bytes_be(&em[0..$]));\n    BigUint::to_bytes_be_padded(&s, k)\n}fn small_primes() : Vec<"
    "u32>\n{\n    Vec<u32> out = Vec::new();\n    for (u32 c = 3; c < 1000; c += 2)\n    {\n        bool prime"
    " = true;\n        for (usize i = 0; i < Vec::len(&out) && out[i] * out[i] <= c; i += 1)\n        {\n   "
    "         if (c % out[i] == 0)\n            {\n                prime = false;\n                break;\n  "
    "          }\n        }\n        if (prime)\n        {\n            Vec::push(&mut out, c);\n        }\n   "
    " }\n    out\n}fn probably_prime(ref<BigUint, shared> c, ref<Vec<u32>, shared> primes, usize rounds) : "
    "bool\n{\n    for (usize i = 0; i < Vec::len(primes); i += 1)\n    {\n        BigUint p = BigUint::from_u"
    "64(widen<u64>(primes[i]));\n        if (BigUint::is_zero(&BigUint::rem(c, &p)))\n        {\n           "
    " return BigUint::eq(c, &p);\n        }\n    }\n    BigUint one = BigUint::from_u64(1);\n    BigUint c1 ="
    " BigUint::sub(c, &one);\n    usize a = 0;\n    while (!BigUint::bit(&c1, a))\n    {\n        a += 1;\n   "
    " }\n    BigUint m = BigUint::shift_right(&c1, a);\n    Mont f = mont_new(c);\n    usize k = (BigUint::b"
    "it_len(c) + 7) / 8;\n    Vec<u8> rb = Vec::filled(k, 0: u8);\n    BigUint two = BigUint::from_u64(2);\n"
    "    for (usize round = 0; round < rounds; round += 1)\n    {\n        os_random_bytes(&mut rb[0..$]);\n"
    "        BigUint b = BigUint::add(\n            &BigUint::rem(&BigUint::from_bytes_be(&rb[0..$]), &Big"
    "Uint::sub(c, &BigUint::from_u64(3))),\n            &two,\n        );\n        BigUint z = mont_pow(&f, "
    "&b, &m);\n        if (BigUint::eq(&z, &one) || BigUint::eq(&z, &c1))\n        {\n            continue;\n"
    "        }\n        bool witness = true;\n        for (usize j = 1; j < a; j += 1)\n        {\n          "
    "  overwrite(&mut z, BigUint::rem(&BigUint::mul(&z, &z), c));\n            if (BigUint::eq(&z, &c1))\n "
    "           {\n                witness = false;\n                break;\n            }\n            if (B"
    "igUint::eq(&z, &one))\n            {\n                return false;\n            }\n        }\n        if"
    " (witness)\n        {\n            return false;\n        }\n    }\n    true\n}fn random_prime(usize bits,"
    " ref<BigUint, shared> e, ref<Vec<u32>, shared> primes) : BigUint\n{\n    usize k = (bits + 7) / 8;\n   "
    " Vec<u8> rb = Vec::filled(k, 0: u8);\n    BigUint one = BigUint::from_u64(1);\n    while (true)\n    {\n"
    "        os_random_bytes(&mut rb[0..$]);\n        BigUint c = BigUint::from_bytes_be(&rb[0..$]);\n     "
    "   // Exactly `bits` bits with the top two set, and odd.\n        BigUint top = BigUint::shift_left(&"
    "one, bits - 1);\n        BigUint second = BigUint::shift_left(&one, bits - 2);\n        BigUint mask ="
    " BigUint::sub(&BigUint::shift_left(&one, bits), &one);\n        BigUint c2 = BigUint::rem(&c, &BigUin"
    "t::add(&mask, &one));\n        BigUint c3 = BigUint::add(&BigUint::rem(&c2, &second), &BigUint::add(&"
    "top, &second));\n        if (!BigUint::bit(&c3, 0))\n        {\n            overwrite(&mut c3, BigUint:"
    ":add(&c3, &one));\n        }\n        BigUint c4 = BigUint::sub(&c3, &one);\n        if (BigUint::is_ze"
    "ro(&BigUint::rem(&c4, e)))\n        {\n            continue;\n        }\n        if (probably_prime(&c3,"
    " primes, 5))\n        {\n            return c3;\n        }\n    }\n}export fn rsa_generate_key(usize bits"
    ") : RsaPrivateKey\n{\n    if (bits < 1024 || bits > 8192 || bits % 64 != 0)\n    {\n        fault(crypto"
    "_length);\n    }\n    Vec<u32> primes = small_primes();\n    BigUint e = BigUint::from_u64(65537);\n    "
    "BigUint one = BigUint::from_u64(1);\n    while (true)\n    {\n        BigUint p = random_prime(bits / 2"
    ", &e, &primes);\n        BigUint q = random_prime(bits / 2, &e, &primes);\n        if (BigUint::eq(&p,"
    " &q))\n        {\n            continue;\n        }\n        BigUint n = BigUint::mul(&p, &q);\n        Bi"
    "gUint p1 = BigUint::sub(&p, &one);\n        BigUint q1 = BigUint::sub(&q, &one);\n        BigUint phi "
    "= BigUint::mul(&p1, &q1);\n        BigUint d = match (BigUint::mod_inverse(&e, &phi))\n        {\n     "
    "       Some(v) : v,\n            None    : continue,\n        };\n        if (Some(key) = RsaPrivateKey"
    "::new(n, BigUint::clone(&e), d, p, q))\n        {\n            return key;\n        }\n    }\n}export fn "
    "CertError::text(ref<CertError, shared> e) : str\n{\n    match (e)\n    {\n        BadEncoding          :"
    " \"malformed certificate\",\n        Expired              : \"certificate expired\",\n        NotYetValid "
    "         : \"certificate not yet valid\",\n        UnknownAuthority     : \"certificate signed by an unk"
    "nown authority\",\n        HostMismatch         : \"certificate is not for this host\",\n        BadSigna"
    "ture         : \"certificate signature does not verify\",\n        NotAuthority         : \"issuer is no"
    "t a certificate authority\",\n        UnsupportedAlgorithm : \"unsupported key or signature algorithm\","
    "\n        UnhandledCritical    : \"unhandled critical extension\",\n        WrongUsage           : \"cert"
    "ificate not usable for a TLS server\",\n        ChainTooLong         : \"certificate chain too long\",\n "
    "   }\n}export fn der_read(slice<u8, shared> buf, usize at) : Option<Der>\n{\n    usize n = slice_len(bu"
    "f);\n    if (at + 2 > n)\n    {\n        return None;\n    }\n    u8 tag = buf[at];\n    if ((tag & 0x1f) "
    "== 0x1f)\n    {\n        return None;\n    }\n    u8 first = buf[at + 1];\n    usize len = 0;\n    usize s"
    "tart = at + 2;\n    if (first < 0x80)\n    {\n        len = widen<usize>(first);\n    }\n    else\n    {\n "
    "       usize count = widen<usize>(first & 0x7f);\n        if (count == 0 || count > 4 || start + coun"
    "t > n || buf[start] == 0)\n        {\n            return None;\n        }\n        for (usize i = 0; i <"
    " count; i += 1)\n        {\n            len = (len << 8) | widen<usize>(buf[start + i]);\n        }\n   "
    "     if (len < 0x80)\n        {\n            return None;\n        }\n        start += count;\n    }\n    "
    "if (len > n - start)\n    {\n        return None;\n    }\n    Some(Der { .tag = tag, .start = start, .en"
    "d = start + len, .next = start + len })\n}unittest \"der_read: an element, its child, and a long form "
    "refused\"\n{\n    array<u8, 5> der = [0x30, 0x03, 0x02, 0x01, 0x05];\n    Der seq = Option::unwrap(der_r"
    "ead(&der[0..$], 0));\n    assert(seq.tag == 0x30 && seq.start == 2 && seq.end == 5 && seq.next == 5);"
    "\n    Der int = Option::unwrap(der_read(&der[0..$], seq.start));\n    assert(int.tag == 0x02 && der[in"
    "t.start] == 5);\n    array<u8, 4> long_form = [0x04, 0x81, 0x01, 0x00];\n    assert(Option::is_none(&d"
    "er_read(&long_form[0..$], 0)));\n}fn der_expect(slice<u8, shared> buf, usize at, u8 tag) : Result<Der"
    ", CertError>\n{\n    match (der_read(buf, at))\n    {\n        Some(d) : if (d.tag == tag) { Ok(d) } els"
    "e { Err(BadEncoding) },\n        None    : Err(BadEncoding),\n    }\n}fn der_bytes(slice<u8, shared> bu"
    "f, Der d) : Vec<u8>\n{\n    Vec::from_slice(&buf[d.start..d.end])\n}fn der_eq_hex(slice<u8, shared> buf"
    ", Der d, str hex) : bool\n{\n    Vec<u8> want = Result::unwrap_or(from_hex(StringView::of(hex)), Vec::"
    "new());\n    d.end - d.start == Vec::len(&want) && digest_eq(&buf[d.start..d.end], &want[0..$])\n}fn h"
    "ash_oid(slice<u8, shared> buf, Der d) : Option<HashKind>\n{\n    if (der_eq_hex(buf, d, \"6086480165030"
    "40201\"))\n    {\n        return Some(Sha2_256);\n    }\n    if (der_eq_hex(buf, d, \"608648016503040202\")"
    ")\n    {\n        return Some(Sha2_384);\n    }\n    if (der_eq_hex(buf, d, \"608648016503040203\"))\n    {"
    "\n        return Some(Sha2_512);\n    }\n    None\n}fn signature_algorithm(slice<u8, shared> buf, Der al"
    "g) : Result<SignatureScheme, CertError>\n{\n    Der oid = der_expect(buf, alg.start, 0x06)?;\n    if (d"
    "er_eq_hex(buf, oid, \"2a864886f70d01010b\"))\n    {\n        return Ok(RsaPkcs1(Sha2_256));\n    }\n    if"
    " (der_eq_hex(buf, oid, \"2a864886f70d01010c\"))\n    {\n        return Ok(RsaPkcs1(Sha2_384));\n    }\n   "
    " if (der_eq_hex(buf, oid, \"2a864886f70d01010d\"))\n    {\n        return Ok(RsaPkcs1(Sha2_512));\n    }\n"
    "    if (der_eq_hex(buf, oid, \"2a8648ce3d040302\"))\n    {\n        return Ok(Ecdsa(Sha2_256));\n    }\n  "
    "  if (der_eq_hex(buf, oid, \"2a8648ce3d040303\"))\n    {\n        return Ok(Ecdsa(Sha2_384));\n    }\n    "
    "if (der_eq_hex(buf, oid, \"2a8648ce3d040304\"))\n    {\n        return Ok(Ecdsa(Sha2_512));\n    }\n    if"
    " (der_eq_hex(buf, oid, \"2b6570\"))\n    {\n        return Ok(Ed25519);\n    }\n    if (der_eq_hex(buf, oi"
    "d, \"2a864886f70d01010a\"))\n    {\n        // RSASSA-PSS-params: [0] hashAlgorithm, [1] maskGenAlgorith"
    "m,\n        // [2] saltLength; the hash must be SHA-2 and MGF1 over it, and the\n        // salt as lo"
    "ng as the digest.\n        Der params = der_expect(buf, oid.next, 0x30)?;\n        Der h0 = der_expect"
    "(buf, params.start, 0xa0)?;\n        Der h_alg = der_expect(buf, h0.start, 0x30)?;\n        Der h_oid "
    "= der_expect(buf, h_alg.start, 0x06)?;\n        HashKind kind = match (hash_oid(buf, h_oid))\n        "
    "{\n            Some(k) : k,\n            None    : return Ok(UnsupportedSignature),\n        };\n       "
    " return Ok(RsaPss(kind));\n    }\n    Ok(UnsupportedSignature)\n}fn der_text(slice<u8, shared> buf, Der"
    " d) : Option<String>\n{\n    if (d.tag != 0x0c && d.tag != 0x13 && d.tag != 0x16 && d.tag != 0x14)\n   "
    " {\n        return None;\n    }\n    match (String::from_utf8(der_bytes(buf, d)))\n    {\n        Ok(s)  "
    ": Some(s),\n        Err(_) : None,\n    }\n}fn common_name_of(slice<u8, shared> buf, Der name) : String"
    "\n{\n    String cn = String::new();\n    usize at = name.start;\n    while (at < name.end)\n    {\n       "
    " Der set = match (der_read(buf, at))\n        {\n            Some(d) : d,\n            None    : return"
    " cn,\n        };\n        usize inner = set.start;\n        while (inner < set.end)\n        {\n         "
    "   Der atv = match (der_read(buf, inner))\n            {\n                Some(d) : d,\n               "
    " None    : return cn,\n            };\n            if (Some(oid) = der_read(buf, atv.start))\n         "
    "   {\n                if (oid.tag == 0x06 && der_eq_hex(buf, oid, \"550403\"))\n                {\n      "
    "              if (Some(v) = der_read(buf, oid.next))\n                    {\n                        i"
    "f (Some(t) = der_text(buf, v))\n                        {\n                            overwrite(&mut "
    "cn, t);\n                        }\n                    }\n                }\n            }\n            "
    "inner = atv.next;\n        }\n        at = set.next;\n    }\n    cn\n}fn digits(slice<u8, shared> b, usiz"
    "e at, usize n) : Option<i64>\n{\n    i64 x = 0;\n    for (usize i = at; i < at + n; i += 1)\n    {\n     "
    "   if (i >= slice_len(b) || !ascii_is_digit(b[i]))\n        {\n            return None;\n        }\n    "
    "    x = x * 10 + widen<i64>(b[i] - b'0');\n    }\n    Some(x)\n}fn der_time(slice<u8, shared> buf, Der "
    "d) : Result<DateTime, CertError>\n{\n    slice<u8, shared> t = &buf[d.start..d.end];\n    usize n = sli"
    "ce_len(t);\n    i64 year = 0;\n    usize at = 0;\n    if (d.tag == 0x17 && n == 13)\n    {\n        i64 y"
    "y = match (digits(t, 0, 2))\n        {\n            Some(y) : y,\n            None    : return Err(BadE"
    "ncoding),\n        };\n        year = if (yy < 50) { 2000 + yy } else { 1900 + yy };\n        at = 2;\n "
    "   }\n    else if (d.tag == 0x18 && n == 15)\n    {\n        year = match (digits(t, 0, 4))\n        {\n "
    "           Some(y) : y,\n            None    : return Err(BadEncoding),\n        };\n        at = 4;\n  "
    "  }\n    else\n    {\n        return Err(BadEncoding);\n    }\n    if (t[n - 1] != b'Z')\n    {\n        re"
    "turn Err(BadEncoding);\n    }\n    Option<i64> mo = digits(t, at, 2);\n    Option<i64> dd = digits(t, a"
    "t + 2, 2);\n    Option<i64> hh = digits(t, at + 4, 2);\n    Option<i64> mi = digits(t, at + 6, 2);\n   "
    " Option<i64> ss = digits(t, at + 8, 2);\n    if (Some(m) = mo)\n    {\n        if (Some(day) = dd)\n    "
    "    {\n            if (Some(h) = hh)\n            {\n                if (Some(min) = mi)\n              "
    "  {\n                    if (Some(sec) = ss)\n                    {\n                        if (m <= 1"
    "2 && day <= 31 && h <= 23 && min <= 59 && sec <= 59)\n                        {\n                     "
    "       if (Some(dt) = DateTime::new(\n                                year,\n                         "
    "       narrow<u8>(m),\n                                narrow<u8>(day),\n                             "
    "   narrow<u8>(h),\n                                narrow<u8>(min),\n                                n"
    "arrow<u8>(sec),\n                            ))\n                            {\n                       "
    "         return Ok(dt);\n                            }\n                        }\n                    "
    "}\n                }\n            }\n        }\n    }\n    Err(BadEncoding)\n}fn public_key_of(slice<u8, s"
    "hared> buf, Der spki) : Result<CertKey, CertError>\n{\n    Der alg = der_expect(buf, spki.start, 0x30)"
    "?;\n    Der bits = der_expect(buf, alg.next, 0x03)?;\n    if (bits.end == bits.start || buf[bits.start"
    "] != 0)\n    {\n        return Err(BadEncoding);\n    }\n    usize key_start = bits.start + 1;\n    Der o"
    "id = der_expect(buf, alg.start, 0x06)?;\n    if (der_eq_hex(buf, oid, \"2a864886f70d010101\"))\n    {\n  "
    "      Der seq = der_expect(buf, key_start, 0x30)?;\n        Der n = der_expect(buf, seq.start, 0x02)?"
    ";\n        Der e = der_expect(buf, n.next, 0x02)?;\n        return Ok(RsaKey(RsaPublicKey { .n = BigUi"
    "nt::from_bytes_be(&buf[n.start..n.end]), .e = BigUint::from_bytes_be(&buf[e.start..e.end]) }));\n    "
    "}\n    if (der_eq_hex(buf, oid, \"2a8648ce3d0201\"))\n    {\n        Der curve = der_expect(buf, oid.next"
    ", 0x06)?;\n        Vec<u8> point = Vec::from_slice(&buf[key_start..bits.end]);\n        if (der_eq_hex"
    "(buf, curve, \"2a8648ce3d030107\"))\n        {\n            return Ok(EcKey(EcPublicKey { .curve = P256,"
    " .point = point }));\n        }\n        if (der_eq_hex(buf, curve, \"2b81040022\"))\n        {\n         "
    "   return Ok(EcKey(EcPublicKey { .curve = P384, .point = point }));\n        }\n    }\n    if (der_eq_h"
    "ex(buf, oid, \"2b6570\"))\n    {\n        if (bits.end - key_start != 32)\n        {\n            return E"
    "rr(BadEncoding);\n        }\n        array<u8, 32> k = [0; 32];\n        for (usize i = 0; i < 32; i +="
    " 1)\n        {\n            k[i] = buf[key_start + i];\n        }\n        return Ok(Ed25519Key(k));\n   "
    " }\n    Ok(UnsupportedKey)\n}export fn Certificate::parse(slice<u8, shared> der) : Result<Certificate,"
    " CertError>\n{\n    Der cert = der_expect(der, 0, 0x30)?;\n    if (cert.next != slice_len(der))\n    {\n "
    "       return Err(BadEncoding);\n    }\n    Der tbs = der_expect(der, cert.start, 0x30)?;\n    Der oute"
    "r_alg = der_expect(der, tbs.next, 0x30)?;\n    Der sig_bits = der_expect(der, outer_alg.next, 0x03)?;"
    "\n    if (sig_bits.next != cert.end || sig_bits.end == sig_bits.start || der[sig_bits.start] != 0)\n  "
    "  {\n        return Err(BadEncoding);\n    }\n    SignatureScheme scheme = signature_algorithm(der, out"
    "er_alg)?;\n    usize at = tbs.start;\n    Der first = match (der_read(der, at))\n    {\n        Some(d) "
    ": d,\n        None    : return Err(BadEncoding),\n    };\n    if (first.tag == 0xa0)\n    {\n        at ="
    " first.next;\n    }\n    Der serial = der_expect(der, at, 0x02)?;\n    Der inner_alg = der_expect(der, "
    "serial.next, 0x30)?;\n    // The signature algorithm inside the signed part must be the outer one.\n  "
    "  if (inner_alg.end - inner_alg.start != outer_alg.end - outer_alg.start || !digest_eq(\n        &der"
    "[inner_alg.start..inner_alg.end],\n        &der[outer_alg.start..outer_alg.end],\n    ))\n    {\n       "
    " return Err(BadEncoding);\n    }\n    Der issuer = der_expect(der, inner_alg.next, 0x30)?;\n    Der val"
    "idity = der_expect(der, issuer.next, 0x30)?;\n    Der nb = match (der_read(der, validity.start))\n    "
    "{\n        Some(d) : d,\n        None    : return Err(BadEncoding),\n    };\n    Der na = match (der_rea"
    "d(der, nb.next))\n    {\n        Some(d) : d,\n        None    : return Err(BadEncoding),\n    };\n    Da"
    "teTime not_before = der_time(der, nb)?;\n    DateTime not_after = der_time(der, na)?;\n    Der subject"
    " = der_expect(der, validity.next, 0x30)?;\n    Der spki = der_expect(der, subject.next, 0x30)?;\n    C"
    "ertKey key = public_key_of(der, spki)?;\n    Certificate c = Certificate { .der = Vec::from_slice(der"
    "), .tbs = Vec::from_slice(&der[cert.start..tbs.next]), .issuer = Vec::from_slice(&der[inner_alg.next"
    "..issuer.next]), .subject = Vec::from_slice(&der[validity.next..subject.next]), .common_name = commo"
    "n_name_of(\n        der,\n        subject,\n    ), .not_before = not_before, .not_after = not_after, .d"
    "ns_names = Vec::new(), .ip_addresses = Vec::new(), .is_ca = false, .max_path_len = -1, .can_sign_cer"
    "tificates = true, .server_auth = true, .unhandled_critical = false, .key = key, .scheme = scheme, .s"
    "ignature = Vec::from_slice(&der[sig_bits.start + 1..sig_bits.end]) };\n    at = spki.next;\n    while "
    "(at < tbs.end)\n    {\n        Der field = match (der_read(der, at))\n        {\n            Some(d) : d"
    ",\n            None    : return Err(BadEncoding),\n        };\n        if (field.tag == 0xa3)\n        {"
    "\n            Der exts = der_expect(der, field.start, 0x30)?;\n            usize e_at = exts.start;\n  "
    "          while (e_at < exts.end)\n            {\n                Der ext = der_expect(der, e_at, 0x30"
    ")?;\n                Der oid = der_expect(der, ext.start, 0x06)?;\n                usize v_at = oid.ne"
    "xt;\n                bool critical = false;\n                Der maybe = match (der_read(der, v_at))\n "
    "               {\n                    Some(d) : d,\n                    None    : return Err(BadEncodi"
    "ng),\n                };\n                if (maybe.tag == 0x01)\n                {\n                   "
    " critical = maybe.end > maybe.start && der[maybe.start] != 0;\n                    v_at = maybe.next;"
    "\n                }\n                Der value = der_expect(der, v_at, 0x04)?;\n                if (der"
    "_eq_hex(der, oid, \"551d11\"))\n                {\n                    Der names = der_expect(der, value"
    ".start, 0x30)?;\n                    usize n_at = names.start;\n                    while (n_at < name"
    "s.end)\n                    {\n                        Der g = match (der_read(der, n_at))\n           "
    "             {\n                            Some(d) : d,\n                            None    : return"
    " Err(BadEncoding),\n                        };\n                        if (g.tag == 0x82)\n           "
    "             {\n                            if (Ok(s) = String::from_utf8(der_bytes(der, g)))\n       "
    "                     {\n                                Vec::push(&mut c.dns_names, s);\n             "
    "               }\n                        }\n                        else if (g.tag == 0x87)\n         "
    "               {\n                            usize len = g.end - g.start;\n                          "
    "  if (len == 4)\n                            {\n                                Vec::push(\n           "
    "                         &mut c.ip_addresses,\n                                    V4([der[g.start], "
    "der[g.start + 1], der[g.start + 2], der[g.start + 3]]),\n                                );\n         "
    "                   }\n                            else if (len == 16)\n                            {\n "
    "                               array<u8, 16> a = [0; 16];\n                                for (usize"
    " i = 0; i < 16; i += 1)\n                                {\n                                    a[i] ="
    " der[g.start + i];\n                                }\n                                Vec::push(&mut "
    "c.ip_addresses, V6(a));\n                            }\n                        }\n                    "
    "    n_at = g.next;\n                    }\n                }\n                else if (der_eq_hex(der, "
    "oid, \"551d13\"))\n                {\n                    Der bc = der_expect(der, value.start, 0x30)?;\n"
    "                    usize b_at = bc.start;\n                    if (b_at < bc.end)\n                  "
    "  {\n                        Der x = match (der_read(der, b_at))\n                        {\n          "
    "                  Some(d) : d,\n                            None    : return Err(BadEncoding),\n      "
    "                  };\n                        if (x.tag == 0x01)\n                        {\n          "
    "                  c.is_ca = x.end > x.start && der[x.start] != 0;\n                            b_at ="
    " x.next;\n                        }\n                    }\n                    if (b_at < bc.end)\n    "
    "                {\n                        Der pl = der_expect(der, b_at, 0x02)?;\n                   "
    "     i64 v = 0;\n                        for (usize i = pl.start; i < pl.end && i < pl.start + 4; i +"
    "= 1)\n                        {\n                            v = (v << 8) | widen<i64>(der[i]);\n      "
    "                  }\n                        c.max_path_len = v;\n                    }\n              "
    "  }\n                else if (der_eq_hex(der, oid, \"551d0f\"))\n                {\n                    D"
    "er ku = der_expect(der, value.start, 0x03)?;\n                    // Bit 5, keyCertSign, of the first"
    " byte after the\n                    // unused-bits count.\n                    c.can_sign_certificate"
    "s = ku.end - ku.start >= 2 && (der[ku.start + 1] & 0x04) != 0;\n                }\n                els"
    "e if (der_eq_hex(der, oid, \"551d25\"))\n                {\n                    Der eku = der_expect(der"
    ", value.start, 0x30)?;\n                    bool server = false;\n                    usize k_at = eku"
    ".start;\n                    while (k_at < eku.end)\n                    {\n                        Der"
    " p = der_expect(der, k_at, 0x06)?;\n                        if (der_eq_hex(der, p, \"2b06010505070301\""
    ") || der_eq_hex(der, p, \"551d2500\"))\n                        {\n                            server = "
    "true;\n                        }\n                        k_at = p.next;\n                    }\n       "
    "             c.server_auth = server;\n                }\n                else if (critical && !der_eq_"
    "hex(der, oid, \"551d20\") && !der_eq_hex(der, oid, \"551d1e\"))\n                {\n                    //"
    " An unknown critical extension; certificate policies\n                    // and name constraints are"
    " tolerated unread (D-0160).\n                    c.unhandled_critical = true;\n                }\n     "
    "           e_at = ext.next;\n            }\n        }\n        at = field.next;\n    }\n    Ok(c)\n}export"
    " fn certificates_from_pem(StringView text) : Vec<Certificate>\n{\n    Vec<Certificate> out = Vec::new("
    ");\n    StringView begin = \"-----BEGIN CERTIFICATE-----\";\n    StringView end = \"-----END CERTIFICATE-"
    "----\";\n    usize at = 0;\n    usize n = StringView::len(text);\n    while (at < n)\n    {\n        Strin"
    "gView rest = &text[at..n];\n        usize b = match (StringView::find(rest, begin))\n        {\n       "
    "     Some(i) : i,\n            None    : break,\n        };\n        StringView body = &rest[b + String"
    "View::len(begin)..$];\n        usize e = match (StringView::find(body, end))\n        {\n            So"
    "me(i) : i,\n            None    : break,\n        };\n        String b64 = String::new();\n        Strin"
    "gView block = &body[0..e];\n        // A byte that is not ASCII (so not base64 either) makes the bloc"
    "k\n        // malformed: skipped, like one whose base64 does not decode.\n        bool clean = true;\n "
    "       for (usize i = 0; i < StringView::len(block); i += 1)\n        {\n            u8 c = block.byte"
    "s[i];\n            if (c >= 128)\n            {\n                clean = false;\n                break;\n"
    "            }\n            if (!ascii_is_space(c))\n            {\n                String::push_ascii(&"
    "mut b64, c);\n            }\n        }\n        if (clean)\n        {\n            if (Ok(der) = base64_d"
    "ecode(&b64))\n            {\n                if (Ok(cert) = Certificate::parse(&der[0..$]))\n          "
    "      {\n                    Vec::push(&mut out, cert);\n                }\n            }\n        }\n   "
    "     at = at + b + StringView::len(begin) + e + StringView::len(end);\n    }\n    out\n}unittest \"certi"
    "ficates_from_pem: a malformed block is skipped\"\n{\n    StringView text = \"junk\\n-----BEGIN CERTIFICAT"
    "E-----\\nnot base64!\\n-----END CERTIFICATE-----\\n\";\n    Vec<Certificate> certs = certificates_from_pe"
    "m(text);\n    assert(Vec::len(&certs) == 0);\n}export fn TrustStore::new() : TrustStore\n{\n    TrustSto"
    "re { .roots = Vec::new() }\n}export fn TrustStore::add(ref<TrustStore, exclusive> t, Certificate root"
    ")\n{\n    Vec::push(&mut t.roots, root);\n}export fn TrustStore::from_pem_file(StringView path) : Resul"
    "t<TrustStore, FileError>\n{\n    String text = read_file(path)?;\n    Ok(TrustStore { .roots = certific"
    "ates_from_pem(&text) })\n}export fn TrustStore::system() : Result<TrustStore, FileError>\n{\n    array<"
    "str, 5> paths = [\n        \"/etc/ssl/certs/ca-certificates.crt\",\n        \"/etc/pki/tls/certs/ca-bundl"
    "e.crt\",\n        \"/etc/ssl/ca-bundle.pem\",\n        \"/etc/ssl/cert.pem\",\n        \"/usr/local/etc/opens"
    "sl/cert.pem\",\n    ];\n    foreach (p in &paths)\n    {\n        if (Ok(t) = TrustStore::from_pem_file(S"
    "tringView::of(*p)))\n        {\n            if (Vec::len(&t.roots) > 0)\n            {\n                "
    "return Ok(t);\n            }\n        }\n    }\n    Err(NotFound)\n}export fn verify_signature(\n    ref<C"
    "ertKey, shared> key,\n    ref<SignatureScheme, shared> scheme,\n    slice<u8, shared> message,\n    sli"
    "ce<u8, shared> signature,\n) : bool\n{\n    match (scheme)\n    {\n        RsaPkcs1(h) : match (key)\n    "
    "    {\n            RsaKey(k) : rsa_verify_pkcs1v15(k, *h, &hash(*h, message)[0..$], signature),\n     "
    "       _         : false,\n        },\n        RsaPss(h) : match (key)\n        {\n            RsaKey(k)"
    " : rsa_verify_pss(k, *h, &hash(*h, message)[0..$], signature),\n            _         : false,\n      "
    "  },\n        Ecdsa(h) : match (key)\n        {\n            EcKey(k) : ecdsa_verify(k.curve, &k.point["
    "0..$], &hash(*h, message)[0..$], signature),\n            _        : false,\n        },\n        Ed2551"
    "9 : match (key)\n        {\n            Ed25519Key(k) : ed25519_verify(&k[0..$], message, signature),\n"
    "            _             : false,\n        },\n        UnsupportedSignature : false,\n    }\n}fn ascii_"
    "lower_eq(StringView a, StringView b) : bool\n{\n    if (StringView::len(a) != StringView::len(b))\n    "
    "{\n        return false;\n    }\n    for (usize i = 0; i < StringView::len(a); i += 1)\n    {\n        u8"
    " x = a.bytes[i];\n        u8 y = b.bytes[i];\n        if (ascii_is_upper(x))\n        {\n            x +"
    "= 32;\n        }\n        if (ascii_is_upper(y))\n        {\n            y += 32;\n        }\n        if ("
    "x != y)\n        {\n            return false;\n        }\n    }\n    true\n}fn name_matches(StringView pat"
    "tern, StringView host) : bool\n{\n    if (StringView::starts_with(pattern, \"*.\"))\n    {\n        String"
    "View suffix = &pattern[1..$];\n        match (StringView::find(host, \".\"))\n        {\n            Some"
    "(dot) : dot > 0 && ascii_lower_eq(\n                suffix,\n                &host[dot..$],\n          "
    "  ) && Option::is_some(&StringView::find(&suffix[1..$], \".\")),\n            None : false,\n        }\n "
    "   }\n    else\n    {\n        ascii_lower_eq(pattern, host)\n    }\n}export fn Certificate::matches_host"
    "(ref<Certificate, shared> c, StringView host) : bool\n{\n    if (Ok(ip) = IpAddr::parse(host))\n    {\n "
    "       foreach (a in &c.ip_addresses)\n        {\n            if (IpAddr::text(a) == IpAddr::text(&ip)"
    ")\n            {\n                return true;\n            }\n        }\n        return false;\n    }\n   "
    " StringView h = if (StringView::ends_with(\n        host,\n        \".\",\n    )) { &host[0..StringView::"
    "len(host) - 1] } else { host };\n    foreach (n in &c.dns_names)\n    {\n        if (name_matches(n, h)"
    ")\n        {\n            return true;\n        }\n    }\n    false\n}fn check_time(ref<Certificate, share"
    "d> c, ref<DateTime, shared> now) : Result<void, CertError>\n{\n    if (DateTime::less(now, &c.not_befo"
    "re))\n    {\n        return Err(NotYetValid);\n    }\n    if (DateTime::less(&c.not_after, now))\n    {\n "
    "       return Err(Expired);\n    }\n    if (c.unhandled_critical)\n    {\n        return Err(UnhandledCr"
    "itical);\n    }\n    Ok(())\n}fn same_bytes(ref<Vec<u8>, shared> a, ref<Vec<u8>, shared> b) : bool\n{\n  "
    "  Vec::len(a) == Vec::len(b) && digest_eq(&a[0..$], &b[0..$])\n}export fn verify_chain(\n    ref<Certi"
    "ficate, shared> leaf,\n    slice<Certificate, shared> intermediates,\n    ref<TrustStore, shared> root"
    "s,\n    StringView host,\n    ref<DateTime, shared> now,\n) : Result<void, CertError>\n{\n    if (!Certif"
    "icate::matches_host(leaf, host))\n    {\n        return Err(HostMismatch);\n    }\n    if (!leaf.server_"
    "auth)\n    {\n        return Err(WrongUsage);\n    }\n    check_time(leaf, now)?;\n    Certificate curren"
    "t = Certificate::clone(leaf);\n    usize below = 0;\n    CertError last = UnknownAuthority;\n    for (u"
    "size depth = 0; depth < 10; depth += 1)\n    {\n        foreach (r in &roots.roots)\n        {\n        "
    "    if (same_bytes(\n                &r.subject,\n                &current.issuer,\n            ) && ve"
    "rify_signature(&r.key, &current.scheme, &current.tbs[0..$], &current.signature[0..$]))\n            {"
    "\n                if (!r.is_ca || !r.can_sign_certificates)\n                {\n                    las"
    "t = NotAuthority;\n                    continue;\n                }\n                if (Err(e) = check"
    "_time(r, now))\n                {\n                    last = e;\n                    continue;\n       "
    "         }\n                return Ok(());\n            }\n        }\n        Option<Certificate> next ="
    " None;\n        for (usize i = 0; i < slice_len(intermediates); i += 1)\n        {\n            ref<Cer"
    "tificate, shared> m = &intermediates[i];\n            if (same_bytes(&m.subject, &current.issuer) && "
    "!same_bytes(&m.der, &current.der))\n            {\n                if (!verify_signature(&m.key, &curr"
    "ent.scheme, &current.tbs[0..$], &current.signature[0..$]))\n                {\n                    las"
    "t = BadSignature;\n                    continue;\n                }\n                if (!m.is_ca || !m"
    ".can_sign_certificates)\n                {\n                    return Err(NotAuthority);\n            "
    "    }\n                if (m.max_path_len >= 0 && narrow<i64>(below) > m.max_path_len)\n              "
    "  {\n                    return Err(NotAuthority);\n                }\n                check_time(m, no"
    "w)?;\n                overwrite(&mut next, Some(Certificate::clone(m)));\n                break;\n     "
    "       }\n        }\n        match (next)\n        {\n            Some(n) :\n            {\n              "
    "  overwrite(&mut current, n);\n                below += 1;\n            },\n            None    : retur"
    "n Err(last),\n        }\n    }\n    Err(ChainTooLong)\n}fn der_push_len(ref<Vec<u8>, exclusive> out, usi"
    "ze len)\n{\n    if (len < 0x80)\n    {\n        Vec::push(out, narrow<u8>(len));\n        return;\n    }\n "
    "   usize count = 1;\n    while ((len >> narrow<u32>(8 * count)) != 0)\n    {\n        count += 1;\n    }"
    "\n    Vec::push(out, 0x80 | narrow<u8>(count));\n    for (usize i = 0; i < count; i += 1)\n    {\n      "
    "  Vec::push(out, narrow_wrapping<u8>(len >> narrow<u32>(8 * (count - 1 - i))));\n    }\n}fn der_wrap(u"
    "8 tag, slice<u8, shared> content) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n    Vec::push(&mut out, "
    "tag);\n    der_push_len(&mut out, slice_len(content));\n    Vec::extend_from(&mut out, content);\n    o"
    "ut\n}fn der_uint(slice<u8, shared> v) : Vec<u8>\n{\n    usize from = 0;\n    while (from + 1 < slice_len"
    "(v) && v[from] == 0)\n    {\n        from += 1;\n    }\n    Vec<u8> content = Vec::new();\n    if (slice_"
    "len(v) == 0 || (v[from] & 0x80) != 0)\n    {\n        Vec::push(&mut content, 0);\n    }\n    Vec::exten"
    "d_from(&mut content, &v[from..$]);\n    der_wrap(0x02, &content[0..$])\n}fn der_big(ref<BigUint, share"
    "d> a) : Vec<u8>\n{\n    der_uint(&BigUint::to_bytes_be(a)[0..$])\n}fn der_oid_hex(str hex) : Vec<u8>\n{\n"
    "    Vec<u8> b = Result::unwrap_or(from_hex(StringView::of(hex)), Vec::new());\n    der_wrap(0x06, &b["
    "0..$])\n}fn der_bit_string(slice<u8, shared> bytes) : Vec<u8>\n{\n    Vec<u8> content = Vec::new();\n   "
    " Vec::push(&mut content, 0);\n    Vec::extend_from(&mut content, bytes);\n    der_wrap(0x03, &content["
    "0..$])\n}fn curve_oid_hex(EcCurve c) : str\n{\n    match (c)\n    {\n        P256 : \"2a8648ce3d030107\",\n "
    "       P384 : \"2b81040022\",\n    }\n}fn key_algorithm(ref<CertKey, shared> key) : Vec<u8>\n{\n    Vec<u8"
    "> content = match (key)\n    {\n        RsaKey(_)      :\n        {\n            Vec<u8> c = der_oid_hex"
    "(\"2a864886f70d010101\");\n            Vec::push(&mut c, 0x05);\n            Vec::push(&mut c, 0x00);\n  "
    "          c\n        },\n        EcKey(k)       :\n        {\n            Vec<u8> c = der_oid_hex(\"2a864"
    "8ce3d0201\");\n            Vec::extend_from(&mut c, &der_oid_hex(curve_oid_hex(k.curve))[0..$]);\n     "
    "       c\n        },\n        Ed25519Key(_)  : der_oid_hex(\"2b6570\"),\n        UnsupportedKey : Vec::ne"
    "w(),\n    };\n    der_wrap(0x30, &content[0..$])\n}export fn CertKey::to_der(ref<CertKey, shared> key) "
    ": Option<Vec<u8>>\n{\n    Vec<u8> bits = match (key)\n    {\n        RsaKey(k)      :\n        {\n        "
    "    Vec<u8> seq = der_big(&k.n);\n            Vec::extend_from(&mut seq, &der_big(&k.e)[0..$]);\n     "
    "       der_wrap(0x30, &seq[0..$])\n        },\n        EcKey(k)       : Vec::clone(&k.point),\n        "
    "Ed25519Key(k)  : Vec::from_slice(&k[0..$]),\n        UnsupportedKey : return None,\n    };\n    Vec<u8>"
    " content = key_algorithm(key);\n    Vec::extend_from(&mut content, &der_bit_string(&bits[0..$])[0..$]"
    ");\n    Some(der_wrap(0x30, &content[0..$]))\n}export fn CertKey::from_der(slice<u8, shared> der) : Re"
    "sult<CertKey, CertError>\n{\n    Der spki = der_expect(der, 0, 0x30)?;\n    if (spki.next != slice_len("
    "der))\n    {\n        return Err(BadEncoding);\n    }\n    match (public_key_of(der, spki)?)\n    {\n     "
    "   UnsupportedKey : Err(UnsupportedAlgorithm),\n        k              : Ok(k),\n    }\n}fn pem_block(S"
    "tringView text, slice<str, shared> labels) : Result<Vec<u8>, CertError>\n{\n    // The earliest BEGIN "
    "line of any of the labels.\n    Option<usize> first = None;\n    usize at = 0;\n    for (usize i = 0; i"
    " < slice_len(labels); i += 1)\n    {\n        String begin = \"-----BEGIN \";\n        String::append(&mu"
    "t begin, labels[i]);\n        String::append(&mut begin, \"-----\");\n        if (Some(v) = StringView::"
    "find(text, &begin))\n        {\n            if (Option::is_none(&first) || v < at)\n            {\n     "
    "           first = Some(i);\n                at = v;\n            }\n        }\n    }\n    usize i = matc"
    "h (first)\n    {\n        Some(i) : i,\n        None    :\n        {\n            if (Option::is_some(&St"
    "ringView::find(text, \"-----BEGIN ENCRYPTED PRIVATE KEY-----\")))\n            {\n                return"
    " Err(UnsupportedAlgorithm);\n            }\n            return Err(BadEncoding);\n        },\n    };\n   "
    " String begin = \"-----BEGIN \";\n    String::append(&mut begin, labels[i]);\n    String::append(&mut be"
    "gin, \"-----\");\n    String end = \"-----END \";\n    String::append(&mut end, labels[i]);\n    String::ap"
    "pend(&mut end, \"-----\");\n    StringView body = &text[at + StringView::len(&begin)..$];\n    usize e ="
    " match (StringView::find(body, &end))\n    {\n        Some(v) : v,\n        None    : return Err(BadEnc"
    "oding),\n    };\n    String b64 = String::new();\n    StringView block = &body[0..e];\n    for (usize k "
    "= 0; k < StringView::len(block); k += 1)\n    {\n        u8 c = block.bytes[k];\n        if (c >= 128)\n"
    "        {\n            return Err(BadEncoding);\n        }\n        if (!ascii_is_space(c))\n        {\n "
    "           String::push_ascii(&mut b64, c);\n        }\n    }\n    match (base64_decode(&b64))\n    {\n  "
    "      Ok(der) : Ok(der),\n        Err(_)  : Err(BadEncoding),\n    }\n}fn pem_of(str label, slice<u8, s"
    "hared> der) : String\n{\n    String out = \"-----BEGIN \";\n    String::append(&mut out, label);\n    Stri"
    "ng::append(&mut out, \"-----\\n\");\n    String b64 = base64_encode(der);\n    usize n = StringView::len("
    "&b64);\n    for (usize at = 0; at < n; at += 64)\n    {\n        String::append(&mut out, &b64[at..min("
    "at + 64, n)]);\n        String::append(&mut out, \"\\n\");\n    }\n    String::append(&mut out, \"-----END "
    "\");\n    String::append(&mut out, label);\n    String::append(&mut out, \"-----\\n\");\n    out\n}export fn"
    " CertKey::from_pem(StringView text) : Result<CertKey, CertError>\n{\n    array<str, 1> labels = [\"PUBL"
    "IC KEY\"];\n    Vec<u8> der = pem_block(text, &labels[0..$])?;\n    CertKey::from_der(&der[0..$])\n}expo"
    "rt fn CertKey::to_pem(ref<CertKey, shared> key) : Option<String>\n{\n    Some(pem_of(\"PUBLIC KEY\", &Ce"
    "rtKey::to_der(key)?[0..$]))\n}unittest \"CertKey::to_pem: read back by from_pem\"\n{\n    CertKey key = E"
    "d25519Key([0x42; 32]);\n    String pem = Option::unwrap(CertKey::to_pem(&key));\n    assert(StringView"
    "::starts_with(&pem, \"-----BEGIN PUBLIC KEY-----\\n\"));\n    match (CertKey::from_pem(&pem))\n    {\n    "
    "    Ok(Ed25519Key(k)) : assert(k[0] == 0x42 && k[31] == 0x42),\n        _                 : assert(fa"
    "lse),\n    }\n}export fn PrivateKey::public_key(ref<PrivateKey, shared> key) : CertKey\n{\n    match (ke"
    "y)\n    {\n        RsaPrivate(k)     : RsaKey(RsaPrivateKey::public_key(k)),\n        EcPrivate(k) : Ec"
    "Key(EcPublicKey { .curve = k.curve, .point = Option::unwrap_or(\n            ec_public_key(k.curve, &"
    "k.scalar[0..$]),\n            Vec::new(),\n        ) }),\n        Ed25519Private(k) : Ed25519Key(ed2551"
    "9_public_key(&k[0..$])),\n    }\n}fn rsa_private_of(slice<u8, shared> buf, usize at) : Result<PrivateK"
    "ey, CertError>\n{\n    Der seq = der_expect(buf, at, 0x30)?;\n    Der version = der_expect(buf, seq.sta"
    "rt, 0x02)?;\n    Der n = der_expect(buf, version.next, 0x02)?;\n    Der e = der_expect(buf, n.next, 0x"
    "02)?;\n    Der d = der_expect(buf, e.next, 0x02)?;\n    Der p = der_expect(buf, d.next, 0x02)?;\n    De"
    "r q = der_expect(buf, p.next, 0x02)?;\n    match (RsaPrivateKey::new(\n        BigUint::from_bytes_be("
    "&buf[n.start..n.end]),\n        BigUint::from_bytes_be(&buf[e.start..e.end]),\n        BigUint::from_b"
    "ytes_be(&buf[d.start..d.end]),\n        BigUint::from_bytes_be(&buf[p.start..p.end]),\n        BigUint"
    "::from_bytes_be(&buf[q.start..q.end]),\n    ))\n    {\n        Some(k) : Ok(RsaPrivate(k)),\n        Non"
    "e    : Err(BadEncoding),\n    }\n}fn ec_private_of(slice<u8, shared> buf, usize at, Option<EcCurve> cu"
    "rve) : Result<PrivateKey, CertError>\n{\n    Der seq = der_expect(buf, at, 0x30)?;\n    Der version = d"
    "er_expect(buf, seq.start, 0x02)?;\n    Der scalar = der_expect(buf, version.next, 0x04)?;\n    Option<"
    "EcCurve> found = curve;\n    usize p_at = scalar.next;\n    while (p_at < seq.end)\n    {\n        Der f"
    "ield = match (der_read(buf, p_at))\n        {\n            Some(v) : v,\n            None    : return E"
    "rr(BadEncoding),\n        };\n        if (field.tag == 0xa0)\n        {\n            Der oid = der_expec"
    "t(buf, field.start, 0x06)?;\n            if (der_eq_hex(buf, oid, \"2a8648ce3d030107\"))\n            {\n"
    "                found = Some(P256);\n            }\n            else if (der_eq_hex(buf, oid, \"2b81040"
    "022\"))\n            {\n                found = Some(P384);\n            }\n            else\n            "
    "{\n                return Err(UnsupportedAlgorithm);\n            }\n        }\n        p_at = field.nex"
    "t;\n    }\n    EcCurve c = match (found)\n    {\n        Some(v) : v,\n        None    : return Err(Unsup"
    "portedAlgorithm),\n    };\n    Vec<u8> k = Vec::from_slice(&buf[scalar.start..scalar.end]);\n    usize "
    "want = if (c == P256) { 32 } else { 48 };\n    if (Vec::len(&k) != want || Option::is_none(&ec_public"
    "_key(c, &k[0..$])))\n    {\n        return Err(BadEncoding);\n    }\n    Ok(EcPrivate(EcPrivateKey { .cu"
    "rve = c, .scalar = k }))\n}export fn PrivateKey::from_der(slice<u8, shared> der) : Result<PrivateKey,"
    " CertError>\n{\n    Der seq = der_expect(der, 0, 0x30)?;\n    if (seq.next != slice_len(der))\n    {\n   "
    "     return Err(BadEncoding);\n    }\n    Der version = der_expect(der, seq.start, 0x02)?;\n    Der sec"
    "ond = match (der_read(der, version.next))\n    {\n        Some(v) : v,\n        None    : return Err(Ba"
    "dEncoding),\n    };\n    if (second.tag == 0x02)\n    {\n        return rsa_private_of(der, 0);\n    }\n  "
    "  if (second.tag == 0x04)\n    {\n        return ec_private_of(der, 0, None);\n    }\n    if (second.tag"
    " != 0x30)\n    {\n        return Err(BadEncoding);\n    }\n    Der oid = der_expect(der, second.start, 0"
    "x06)?;\n    Der key = der_expect(der, second.next, 0x04)?;\n    if (der_eq_hex(der, oid, \"2a864886f70d"
    "010101\"))\n    {\n        return rsa_private_of(der, key.start);\n    }\n    if (der_eq_hex(der, oid, \"2"
    "a8648ce3d0201\"))\n    {\n        Der curve = der_expect(der, oid.next, 0x06)?;\n        if (der_eq_hex("
    "der, curve, \"2a8648ce3d030107\"))\n        {\n            return ec_private_of(der, key.start, Some(P25"
    "6));\n        }\n        if (der_eq_hex(der, curve, \"2b81040022\"))\n        {\n            return ec_pri"
    "vate_of(der, key.start, Some(P384));\n        }\n        return Err(UnsupportedAlgorithm);\n    }\n    i"
    "f (der_eq_hex(der, oid, \"2b6570\"))\n    {\n        Der inner = der_expect(der, key.start, 0x04)?;\n    "
    "    if (inner.end - inner.start != 32 || inner.next != key.end)\n        {\n            return Err(Bad"
    "Encoding);\n        }\n        array<u8, 32> seed = [0; 32];\n        for (usize i = 0; i < 32; i += 1)"
    "\n        {\n            seed[i] = der[inner.start + i];\n        }\n        return Ok(Ed25519Private(se"
    "ed));\n    }\n    Err(UnsupportedAlgorithm)\n}export fn PrivateKey::to_der(ref<PrivateKey, shared> key)"
    " : Vec<u8>\n{\n    CertKey public = PrivateKey::public_key(key);\n    Vec<u8> inner = match (key)\n    {"
    "\n        RsaPrivate(k)     :\n        {\n            BigUint one = BigUint::from_u64(1);\n            B"
    "igUint p1 = BigUint::sub(&k.p, &one);\n            BigUint q1 = BigUint::sub(&k.q, &one);\n           "
    " Vec<u8> seq = der_uint(&[0: u8][0..$]);\n            Vec::extend_from(&mut seq, &der_big(&k.n)[0..$]"
    ");\n            Vec::extend_from(&mut seq, &der_big(&k.e)[0..$]);\n            Vec::extend_from(&mut s"
    "eq, &der_big(&k.d)[0..$]);\n            Vec::extend_from(&mut seq, &der_big(&k.p)[0..$]);\n           "
    " Vec::extend_from(&mut seq, &der_big(&k.q)[0..$]);\n            Vec::extend_from(&mut seq, &der_big(&"
    "BigUint::rem(&k.d, &p1))[0..$]);\n            Vec::extend_from(&mut seq, &der_big(&BigUint::rem(&k.d,"
    " &q1))[0..$]);\n            Vec::extend_from(\n                &mut seq,\n                &der_big(&Opt"
    "ion::unwrap_or(BigUint::mod_inverse(&k.q, &k.p), BigUint::zero()))[0..$],\n            );\n           "
    " der_wrap(0x30, &seq[0..$])\n        },\n        EcPrivate(k)      :\n        {\n            Vec<u8> seq"
    " = der_uint(&[1: u8][0..$]);\n            Vec::extend_from(&mut seq, &der_wrap(0x04, &k.scalar[0..$])"
    "[0..$]);\n            Vec<u8> point = match (&public)\n            {\n                EcKey(pk) : Vec::"
    "clone(&pk.point),\n                _         : Vec::new(),\n            };\n            Vec::extend_fro"
    "m(&mut seq, &der_wrap(0xa1, &der_bit_string(&point[0..$])[0..$])[0..$]);\n            der_wrap(0x30, "
    "&seq[0..$])\n        },\n        Ed25519Private(k) : der_wrap(0x04, &k[0..$]),\n    };\n    Vec<u8> cont"
    "ent = der_uint(&[0: u8][0..$]);\n    Vec::extend_from(&mut content, &key_algorithm(&public)[0..$]);\n "
    "   Vec::extend_from(&mut content, &der_wrap(0x04, &inner[0..$])[0..$]);\n    der_wrap(0x30, &content["
    "0..$])\n}export fn PrivateKey::from_pem(StringView text) : Result<PrivateKey, CertError>\n{\n    array<"
    "str, 3> labels = [\"PRIVATE KEY\", \"RSA PRIVATE KEY\", \"EC PRIVATE KEY\"];\n    Vec<u8> der = pem_block(t"
    "ext, &labels[0..$])?;\n    PrivateKey::from_der(&der[0..$])\n}unittest \"PrivateKey::from_pem: an encry"
    "pted key is not read\"\n{\n    StringView text = \"-----BEGIN ENCRYPTED PRIVATE KEY-----\\nAAAA\\n-----END"
    " ENCRYPTED PRIVATE KEY-----\\n\";\n    match (PrivateKey::from_pem(text))\n    {\n        Err(Unsupported"
    "Algorithm) : assert(true),\n        _                         : assert(false),\n    }\n}export fn Priva"
    "teKey::to_pem(ref<PrivateKey, shared> key) : String\n{\n    pem_of(\"PRIVATE KEY\", &PrivateKey::to_der("
    "key)[0..$])\n}export fn sign(\n    ref<PrivateKey, shared> key,\n    ref<SignatureScheme, shared> schem"
    "e,\n    slice<u8, shared> message,\n) : Option<Vec<u8>>\n{\n    match (scheme)\n    {\n        RsaPkcs1(h)"
    " : match (key)\n        {\n            RsaPrivate(k) : Some(rsa_sign_pkcs1v15(k, *h, &hash(*h, message"
    ")[0..$])),\n            _             : None,\n        },\n        RsaPss(h) : match (key)\n        {\n  "
    "          RsaPrivate(k) : Some(rsa_sign_pss(k, *h, &hash(*h, message)[0..$])),\n            _        "
    "     : None,\n        },\n        Ecdsa(h) : match (key)\n        {\n            EcPrivate(k) : ecdsa_si"
    "gn(k.curve, &k.scalar[0..$], &hash(*h, message)[0..$]),\n            _            : None,\n        },\n"
    "        Ed25519 : match (key)\n        {\n            Ed25519Private(k) : Some(Vec::from_slice(&ed2551"
    "9_sign(&k[0..$], message)[0..$])),\n            _                 : None,\n        },\n        Unsuppor"
    "tedSignature : None,\n    }\n}unittest \"sign: a key of another kind gives None\"\n{\n    PrivateKey key ="
    " Ed25519Private([1; 32]);\n    SignatureScheme scheme = RsaPss(Sha2_256);\n    assert(Option::is_none("
    "&sign(&key, &scheme, &b\"message\"[0..$])));\n}export fn TlsError::text(ref<TlsError, shared> e) : str\n"
    "{\n    match (e)\n    {\n        TlsNetFailure(n) : NetError::text(n),\n        CertRejected(c)  : CertE"
    "rror::text(c),\n        HandshakeFailed  : \"TLS handshake failed\",\n        ProtocolError    : \"TLS pr"
    "otocol violation\",\n        PeerAlert(code) : match (*code)\n        {\n            40  : \"the peer ref"
    "used the handshake (alert 40): it supports none of the suites (ChaCha20-Poly1305, AES-128-GCM, AES-2"
    "56-GCM) or key exchanges (X25519, P-256, P-384) offered\",\n            42  : \"the peer refused a cert"
    "ificate (alert 42)\",\n            70  : \"the peer does not speak TLS 1.3 (alert 70)\",\n            80 "
    " : \"the peer failed internally (alert 80)\",\n            109 : \"the peer requires an extension that w"
    "as not sent (alert 109)\",\n            112 : \"the peer does not know the name asked for (alert 112)\","
    "\n            _   : \"the peer sent a TLS alert\",\n        },\n        RecordRejected   : \"a TLS record "
    "did not authenticate\",\n    }\n}unittest \"TlsError::text: alerts and network failures\"\n{\n    TlsError "
    "e = PeerAlert(70);\n    assert(TlsError::text(&e) == \"the peer does not speak TLS 1.3 (alert 70)\");\n "
    "   TlsError n = TlsNetFailure(Refused);\n    assert(TlsError::text(&n) == \"connection refused\");\n}fn "
    "suite_hash(u16 suite) : HashKind\n{\n    if (suite == 0x1302) { Sha2_384 } else { Sha2_256 }\n}fn suite"
    "_key_len(u16 suite) : usize\n{\n    if (suite == 0x1301) { 16 } else { 32 }\n}fn keys_from(slice<u8, sh"
    "ared> secret, u16 suite) : RecordKeys\n{\n    Vec<u8> none = Vec::new();\n    HashKind kind = suite_has"
    "h(suite);\n    RecordKeys {\n        .key = hkdf_expand_label_with(kind, secret, \"key\", &none[0..$], s"
    "uite_key_len(suite)),\n        .iv = hkdf_expand_label_with(kind, secret, \"iv\", &none[0..$], 12),\n   "
    "     .seq = 0,\n        .secret = Vec::from_slice(secret),\n        .suite = suite,\n    }\n}fn record_n"
    "once(ref<RecordKeys, shared> k) : Vec<u8>\n{\n    Vec<u8> n = Vec::clone(&k.iv);\n    for (usize i = 0;"
    " i < 8; i += 1)\n    {\n        n[4 + i] = n[4 + i] ^ narrow_wrapping<u8>(k.seq >> narrow<u32>(56 - 8 "
    "* i));\n    }\n    n\n}export fn TlsStream::peer_certificate(ref<TlsStream, shared> s) : Option<ref<Cer"
    "tificate, shared>>\n{\n    match (&s.peer)\n    {\n        Some(c) : Some(c),\n        None    : None,\n  "
    "  }\n}export fn TlsStream::peer_addr(ref<TlsStream, shared> s) : SocketAddr\n{\n    TcpStream::peer_add"
    "r(&s.tcp)\n}export fn TlsStream::local_addr(ref<TlsStream, shared> s) : SocketAddr\n{\n    TcpStream::l"
    "ocal_addr(&s.tcp)\n}fn read_record(ref<TcpStream, exclusive> tcp) : Result<Record, TlsError>\n{\n    Ve"
    "c<u8> header = Vec::new();\n    match (TcpStream::read_exact(tcp, &mut header, 5))\n    {\n        Ok(_"
    ")  : {},\n        Err(e) : return Err(TlsNetFailure(e)),\n    }\n    usize len = widen<usize>(read_be<u"
    "16>(&header[0..$], 3));\n    if (len > 16384 + 256)\n    {\n        return Err(ProtocolError);\n    }\n  "
    "  Vec<u8> body = Vec::new();\n    match (TcpStream::read_exact(tcp, &mut body, len))\n    {\n        Ok"
    "(_)  : {},\n        Err(e) : return Err(TlsNetFailure(e)),\n    }\n    Ok(Record { .kind = header[0], ."
    "header = header, .body = body })\n}fn write_all(ref<TcpStream, exclusive> tcp, slice<u8, shared> data"
    ") : Result<void, TlsError>\n{\n    match (TcpStream::write(tcp, data))\n    {\n        Ok(_)  : Ok(()),\n"
    "        Err(e) : Err(TlsNetFailure(e)),\n    }\n}fn seal_record(ref<RecordKeys, exclusive> k, u8 kind,"
    " slice<u8, shared> content) : Vec<u8>\n{\n    Vec<u8> inner = Vec::from_slice(content);\n    Vec::push("
    "&mut inner, kind);\n    Vec<u8> header = Vec::new();\n    Vec::push(&mut header, 23);\n    Vec::push_be"
    "(&mut header, 0x0303: u16);\n    Vec::push_be(&mut header, narrow<u16>(Vec::len(&inner) + 16));\n    V"
    "ec<u8> nonce = record_nonce(k);\n    Vec<u8> sealed = if (k.suite != 0x1303)\n    {\n        aes_gcm_se"
    "al(&k.key[0..$], &nonce[0..$], &header[0..$], &inner[0..$])\n    }\n    else\n    {\n        chacha20_po"
    "ly1305_seal(&k.key[0..$], &nonce[0..$], &header[0..$], &inner[0..$])\n    };\n    k.seq += 1;\n    Vec:"
    ":extend_from(&mut header, &sealed[0..$]);\n    header\n}fn open_record(ref<RecordKeys, exclusive> k, r"
    "ef<Record, shared> r) : Result<Inner, TlsError>\n{\n    if (r.kind != 23)\n    {\n        return Err(Pro"
    "tocolError);\n    }\n    Vec<u8> nonce = record_nonce(k);\n    Option<Vec<u8>> opened = if (k.suite != "
    "0x1303)\n    {\n        aes_gcm_open(&k.key[0..$], &nonce[0..$], &r.header[0..$], &r.body[0..$])\n    }"
    "\n    else\n    {\n        chacha20_poly1305_open(&k.key[0..$], &nonce[0..$], &r.header[0..$], &r.body["
    "0..$])\n    };\n    Vec<u8> plain = match (opened)\n    {\n        Some(p) : p,\n        None    : return"
    " Err(RecordRejected),\n    };\n    k.seq += 1;\n    usize n = Vec::len(&plain);\n    while (n > 0 && pla"
    "in[n - 1] == 0)\n    {\n        n -= 1;\n    }\n    if (n == 0 || n - 1 > 16384)\n    {\n        return Er"
    "r(ProtocolError);\n    }\n    u8 kind = plain[n - 1];\n    Vec::truncate(&mut plain, n - 1);\n    Ok(Inn"
    "er { .kind = kind, .content = plain })\n}fn transcript_add(ref<Handshake, exclusive> hs, slice<u8, sh"
    "ared> msg)\n{\n    Hasher::update(&mut hs.t256, msg);\n    Hasher::update(&mut hs.t384, msg);\n}fn next_"
    "message(\n    ref<Handshake, exclusive> hs,\n    ref<TcpStream, exclusive> tcp,\n    ref<Option<RecordK"
    "eys>, exclusive> keys,\n) : Result<Vec<u8>, TlsError>\n{\n    while (Vec::len(&hs.buffer) < 4 || Vec::l"
    "en(&hs.buffer) < 4 + (widen<usize>(hs.buffer[1]) << 16 | widen<usize>(hs.buffer[2]) << 8 | widen<usi"
    "ze>(hs.buffer[3])))\n    {\n        Record r = read_record(tcp)?;\n        if (r.kind == 20)\n        {\n"
    "            // A compatibility ChangeCipherSpec (RFC 8446 §D.4): ignored.\n            continue;\n   "
    "     }\n        if (r.kind == 21)\n        {\n            if (Vec::len(&r.body) == 2)\n            {\n   "
    "             return Err(PeerAlert(r.body[1]));\n            }\n            return Err(ProtocolError);\n"
    "        }\n        match (keys)\n        {\n            Some(k) :\n            {\n                Inner i"
    " = open_record(k, &r)?;\n                if (i.kind == 21)\n                {\n                    retu"
    "rn Err(PeerAlert(if (Vec::len(&i.content) == 2) { i.content[1] } else { 0 }));\n                }\n   "
    "             if (i.kind != 22)\n                {\n                    return Err(ProtocolError);\n    "
    "            }\n                Vec::extend_from(&mut hs.buffer, &i.content[0..$]);\n            },\n   "
    "         None    :\n            {\n                if (r.kind != 22)\n                {\n               "
    "     return Err(ProtocolError);\n                }\n                Vec::extend_from(&mut hs.buffer, &"
    "r.body[0..$]);\n            },\n        }\n    }\n    usize len = 4 + (widen<usize>(hs.buffer[1]) << 16 "
    "| widen<usize>(hs.buffer[2]) << 8 | widen<usize>(hs.buffer[3]));\n    Vec<u8> msg = Vec::from_slice(&"
    "hs.buffer[0..len]);\n    Vec<u8> rest = Vec::from_slice(&hs.buffer[len..$]);\n    overwrite(&mut hs.bu"
    "ffer, rest);\n    transcript_add(hs, &msg[0..$]);\n    Ok(msg)\n}fn push_u24(ref<Vec<u8>, exclusive> v,"
    " usize n)\n{\n    Vec::push(v, narrow<u8>(n >> 16));\n    Vec::push(v, narrow_wrapping<u8>(n >> 8));\n  "
    "  Vec::push(v, narrow_wrapping<u8>(n));\n}fn push_extension(ref<Vec<u8>, exclusive> out, u16 kind, sl"
    "ice<u8, shared> data)\n{\n    Vec::push_be(out, kind);\n    Vec::push_be(out, narrow<u16>(slice_len(dat"
    "a)));\n    Vec::extend_from(out, data);\n}fn client_hello(\n    StringView server_name,\n    slice<u8, s"
    "hared> random,\n    slice<u8, shared> session,\n    u16 group,\n    slice<u8, shared> public_key,\n    s"
    "lice<u8, shared> cookie,\n) : Vec<u8>\n{\n    Vec<u8> ext = Vec::new();\n    if (Result::is_err(&IpAddr:"
    ":parse(server_name)))\n    {\n        Vec<u8> sni = Vec::new();\n        Vec::push_be(&mut sni, narrow<"
    "u16>(StringView::len(server_name) + 3));\n        Vec::push(&mut sni, 0);\n        Vec::push_be(&mut s"
    "ni, narrow<u16>(StringView::len(server_name)));\n        Vec::extend_from(&mut sni, server_name.bytes"
    ");\n        push_extension(&mut ext, 0x0000, &sni[0..$]);\n    }\n    array<u8, 8> groups = [0x00, 0x06"
    ", 0x00, 0x1d, 0x00, 0x17, 0x00, 0x18];\n    push_extension(&mut ext, 0x000a, &groups[0..$]);\n    arra"
    "y<u8, 20> algs = [\n        0x00,\n        0x12,\n        0x04,\n        0x03,\n        0x05,\n        0x0"
    "3,\n        0x08,\n        0x04,\n        0x08,\n        0x05,\n        0x08,\n        0x06,\n        0x08,"
    "\n        0x07,\n        0x04,\n        0x01,\n        0x05,\n        0x01,\n        0x06,\n        0x01,\n "
    "   ];\n    push_extension(&mut ext, 0x000d, &algs[0..$]);\n    array<u8, 3> versions = [0x02, 0x03, 0x"
    "04];\n    push_extension(&mut ext, 0x002b, &versions[0..$]);\n    Vec<u8> share = Vec::new();\n    Vec:"
    ":push_be(&mut share, narrow<u16>(4 + slice_len(public_key)));\n    Vec::push_be(&mut share, group);\n "
    "   Vec::push_be(&mut share, narrow<u16>(slice_len(public_key)));\n    Vec::extend_from(&mut share, pu"
    "blic_key);\n    push_extension(&mut ext, 0x0033, &share[0..$]);\n    if (slice_len(cookie) > 0)\n    {\n"
    "        push_extension(&mut ext, 0x002c, cookie);\n    }\n    Vec<u8> body = Vec::new();\n    Vec::push"
    "_be(&mut body, 0x0303: u16);\n    Vec::extend_from(&mut body, random);\n    Vec::push(&mut body, 32);\n"
    "    Vec::extend_from(&mut body, session);\n    array<u8, 8> suites = [0x00, 0x06, 0x13, 0x03, 0x13, 0"
    "x01, 0x13, 0x02];\n    Vec::extend_from(&mut body, &suites[0..$]);\n    Vec::push(&mut body, 1);\n    V"
    "ec::push(&mut body, 0);\n    Vec::push_be(&mut body, narrow<u16>(Vec::len(&ext)));\n    Vec::extend_fr"
    "om(&mut body, &ext[0..$]);\n    Vec<u8> msg = Vec::new();\n    Vec::push(&mut msg, 1);\n    push_u24(&m"
    "ut msg, Vec::len(&body));\n    Vec::extend_from(&mut msg, &body[0..$]);\n    msg\n}fn server_hello(slic"
    "e<u8, shared> sh, slice<u8, shared> session) : Result<ServerHello, TlsError>\n{\n    usize n = slice_l"
    "en(sh);\n    if (n < 4 + 2 + 32 + 1 || sh[0] != 2)\n    {\n        return Err(ProtocolError);\n    }\n   "
    " // HelloRetryRequest's fixed random.\n    Vec<u8> hrr = Result::unwrap_or(\n        from_hex(\"cf21ad7"
    "4e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c\"),\n        Vec::new(),\n    );\n    bool ret"
    "ry = digest_eq(&sh[6..38], &hrr[0..$]);\n    usize at = 38;\n    usize sid_len = widen<usize>(sh[at]);"
    "\n    if (sid_len != slice_len(session) || at + 1 + sid_len + 3 + 2 > n || !digest_eq(\n        &sh[at"
    " + 1..at + 1 + sid_len],\n        session,\n    ))\n    {\n        return Err(ProtocolError);\n    }\n    "
    "at = at + 1 + sid_len;\n    u16 suite = read_be<u16>(sh, at);\n    if ((suite != 0x1303 && suite != 0x"
    "1301 && suite != 0x1302) || sh[at + 2] != 0)\n    {\n        return Err(HandshakeFailed);\n    }\n    at"
    " += 3;\n    usize ext_end = at + 2 + widen<usize>(read_be<u16>(sh, at));\n    if (ext_end != n)\n    {\n"
    "        return Err(ProtocolError);\n    }\n    at += 2;\n    bool tls13 = false;\n    Option<u16> group "
    "= None;\n    Vec<u8> share = Vec::new();\n    Vec<u8> cookie = Vec::new();\n    while (at + 4 <= ext_en"
    "d)\n    {\n        u16 kind = read_be<u16>(sh, at);\n        usize len = widen<usize>(read_be<u16>(sh, "
    "at + 2));\n        usize start = at + 4;\n        if (start + len > ext_end)\n        {\n            ret"
    "urn Err(ProtocolError);\n        }\n        if (kind == 0x002b)\n        {\n            tls13 = len == 2"
    " && sh[start] == 0x03 && sh[start + 1] == 0x04;\n        }\n        else if (kind == 0x0033)\n        {"
    "\n            if (len < 2)\n            {\n                return Err(ProtocolError);\n            }\n   "
    "         u16 g = read_be<u16>(sh, start);\n            if (g != 0x001d && g != 0x0017 && g != 0x0018)"
    "\n            {\n                return Err(HandshakeFailed);\n            }\n            group = Some(g"
    ");\n            if (!retry)\n            {\n                usize want = if (g == 0x001d) { 32 } else i"
    "f (g == 0x0017) { 65 } else { 97 };\n                if (len != 4 + want || widen<usize>(read_be<u16>"
    "(sh, start + 2)) != want)\n                {\n                    return Err(HandshakeFailed);\n       "
    "         }\n                overwrite(&mut share, Vec::from_slice(&sh[start + 4..start + len]));\n    "
    "        }\n            else if (len != 2)\n            {\n                return Err(ProtocolError);\n  "
    "          }\n        }\n        else if (kind == 0x002c && retry)\n        {\n            overwrite(&mut"
    " cookie, Vec::from_slice(&sh[start..start + len]));\n        }\n        at = start + len;\n    }\n    if"
    " (!tls13)\n    {\n        return Err(HandshakeFailed);\n    }\n    match (group)\n    {\n        Some(g) :"
    " Ok(ServerHello { .retry = retry, .suite = suite, .group = g, .share = share, .cookie = cookie }),\n "
    "       None    : Err(HandshakeFailed),\n    }\n}fn handshake_record(slice<u8, shared> msg, u16 version"
    ") : Vec<u8>\n{\n    Vec<u8> rec = Vec::new();\n    Vec::push(&mut rec, 22);\n    Vec::push_be(&mut rec, "
    "version);\n    Vec::push_be(&mut rec, narrow<u16>(slice_len(msg)));\n    Vec::extend_from(&mut rec, ms"
    "g);\n    rec\n}fn transcript_hash(ref<Handshake, shared> hs) : Vec<u8>\n{\n    match (hs.kind)\n    {\n   "
    "     Sha2_384 : Hasher::finish(hs.t384),\n        _        : Hasher::finish(hs.t256),\n    }\n}fn deriv"
    "e_secret(HashKind kind, slice<u8, shared> secret, StringView label, slice<u8, shared> transcript) : "
    "Vec<u8>\n{\n    hkdf_expand_label_with(kind, secret, label, transcript, slice_len(secret))\n}fn certifi"
    "cate_list(slice<u8, shared> m) : Result<Vec<Certificate>, TlsError>\n{\n    usize n = slice_len(m);\n  "
    "  if (n < 8 || m[0] != 11 || m[4] != 0)\n    {\n        return Err(ProtocolError);\n    }\n    usize at "
    "= 5;\n    usize list_end = at + 3 + (widen<usize>(m[at]) << 16 | widen<usize>(m[at + 1]) << 8 | widen"
    "<usize>(m[at + 2]));\n    if (list_end != n)\n    {\n        return Err(ProtocolError);\n    }\n    at +="
    " 3;\n    Vec<Certificate> out = Vec::new();\n    while (at < list_end)\n    {\n        if (at + 3 > list"
    "_end)\n        {\n            return Err(ProtocolError);\n        }\n        usize len = widen<usize>(m["
    "at]) << 16 | widen<usize>(m[at + 1]) << 8 | widen<usize>(m[at + 2]);\n        usize start = at + 3;\n "
    "       if (start + len + 2 > list_end)\n        {\n            return Err(ProtocolError);\n        }\n  "
    "      match (Certificate::parse(&m[start..start + len]))\n        {\n            Ok(c)  : Vec::push(&m"
    "ut out, c),\n            Err(e) : return Err(CertRejected(e)),\n        }\n        usize ext_len = wide"
    "n<usize>(read_be<u16>(m, start + len));\n        at = start + len + 2 + ext_len;\n    }\n    if (Vec::l"
    "en(&out) == 0)\n    {\n        return Err(HandshakeFailed);\n    }\n    Ok(out)\n}fn certificate_verify_o"
    "k(slice<u8, shared> m, ref<Certificate, shared> leaf, slice<u8, shared> transcript) : bool\n{\n    if "
    "(slice_len(m) < 8 || m[0] != 15)\n    {\n        return false;\n    }\n    u16 code = read_be<u16>(m, 4)"
    ";\n    usize len = widen<usize>(read_be<u16>(m, 6));\n    if (8 + len != slice_len(m))\n    {\n        r"
    "eturn false;\n    }\n    SignatureScheme scheme = UnsupportedSignature;\n    bool curve_ok = true;\n    "
    "if (code == 0x0403 || code == 0x0503)\n    {\n        EcCurve want = if (code == 0x0403) { P256 } else"
    " { P384 };\n        curve_ok = match (&leaf.key)\n        {\n            EcKey(k) : k.curve == want,\n  "
    "          _        : false,\n        };\n        scheme = Ecdsa(if (code == 0x0403) { Sha2_256 } else "
    "{ Sha2_384 });\n    }\n    else if (code == 0x0804)\n    {\n        scheme = RsaPss(Sha2_256);\n    }\n   "
    " else if (code == 0x0805)\n    {\n        scheme = RsaPss(Sha2_384);\n    }\n    else if (code == 0x0806"
    ")\n    {\n        scheme = RsaPss(Sha2_512);\n    }\n    else if (code == 0x0807)\n    {\n        scheme ="
    " Ed25519;\n    }\n    if (!curve_ok)\n    {\n        return false;\n    }\n    Vec<u8> content = Vec::fill"
    "ed(64, 0x20: u8);\n    Vec::extend_from(&mut content, &b\"TLS 1.3, server CertificateVerify\"[0..$]);\n "
    "   Vec::push(&mut content, 0);\n    Vec::extend_from(&mut content, transcript);\n    verify_signature("
    "&leaf.key, &scheme, &content[0..$], &m[8..$])\n}fn finished_data(HashKind kind, slice<u8, shared> sec"
    "ret, slice<u8, shared> transcript) : Vec<u8>\n{\n    Vec<u8> none = Vec::new();\n    Vec<u8> key = hkdf"
    "_expand_label_with(kind, secret, \"finished\", &none[0..$], slice_len(secret));\n    hmac(kind, &key[0."
    ".$], transcript)\n}export fn TlsStream::client(\n    TcpStream tcp,\n    StringView server_name,\n    re"
    "f<TrustStore, shared> roots,\n) : Result<TlsStream, TlsError>\n{\n    array<u8, 32> private_key = x2551"
    "9_private_key();\n    array<u8, 32> public_key = x25519_public_key(&private_key[0..$]);\n    array<u8,"
    " 32> random = [0; 32];\n    os_random_bytes(&mut random[0..$]);\n    array<u8, 32> session = [0; 32];\n"
    "    os_random_bytes(&mut session[0..$]);\n    Handshake hs = Handshake { .buffer = Vec::new(), .t256 "
    "= Hasher::new(Sha2_256), .t384 = Hasher::new(Sha2_384), .kind = Sha2_256 };\n    Vec<u8> none = Vec::"
    "new();\n    Vec<u8> ch = client_hello(server_name, &random[0..$], &session[0..$], 0x001d, &public_key"
    "[0..$], &none[0..$]);\n    transcript_add(&mut hs, &ch[0..$]);\n    write_all(&mut tcp, &handshake_rec"
    "ord(&ch[0..$], 0x0301)[0..$])?;\n    Option<RecordKeys> plain = None;\n    Vec<u8> sh = next_message(&"
    "mut hs, &mut tcp, &mut plain)?;\n    ServerHello hello = server_hello(&sh[0..$], &session[0..$])?;\n  "
    "  hs.kind = suite_hash(hello.suite);\n    HashKind kind = hs.kind;\n    Vec<u8> ec_key = Vec::new();\n "
    "   if (hello.retry)\n    {\n        // A HelloRetryRequest (RFC 8446 §4.1.4): it may only ask for a\n "
    "       // group this client offered without a share, P-256 or P-384. The\n        // transcript resta"
    "rts from message_hash(ClientHello1) ‖\n        // HelloRetryRequest, under the suite's hash.\n      "
    "  if ((hello.group != 0x0017 && hello.group != 0x0018) || Vec::len(&hs.buffer) != 0)\n        {\n     "
    "       return Err(HandshakeFailed);\n        }\n        EcCurve curve = if (hello.group == 0x0017) { P"
    "256 } else { P384 };\n        Vec<u8> ch_hash = hash(kind, &ch[0..$]);\n        array<u8, 4> head = [2"
    "54, 0, 0, narrow<u8>(Vec::len(&ch_hash))];\n        Handshake restarted = Handshake { .buffer = Vec::"
    "new(), .t256 = Hasher::new(Sha2_256), .t384 = Hasher::new(Sha2_384), .kind = kind };\n        transcr"
    "ipt_add(&mut restarted, &head[0..$]);\n        transcript_add(&mut restarted, &ch_hash[0..$]);\n      "
    "  transcript_add(&mut restarted, &sh[0..$]);\n        overwrite(&mut ec_key, ec_private_key(curve));\n"
    "        Vec<u8> ec_public = Option::unwrap(ec_public_key(curve, &ec_key[0..$]));\n        Vec<u8> ch2"
    " = client_hello(\n            server_name,\n            &random[0..$],\n            &session[0..$],\n   "
    "         hello.group,\n            &ec_public[0..$],\n            &hello.cookie[0..$],\n        );\n    "
    "    transcript_add(&mut restarted, &ch2[0..$]);\n        overwrite(&mut hs, restarted);\n        write"
    "_all(&mut tcp, &handshake_record(&ch2[0..$], 0x0303)[0..$])?;\n        Vec<u8> sh2 = next_message(&mu"
    "t hs, &mut tcp, &mut plain)?;\n        ServerHello second = server_hello(&sh2[0..$], &session[0..$])?"
    ";\n        if (second.retry || second.group != hello.group || second.suite != hello.suite)\n        {\n"
    "            return Err(HandshakeFailed);\n        }\n        overwrite(&mut hello, second);\n    }\n    "
    "else if (hello.group != 0x001d)\n    {\n        return Err(HandshakeFailed);\n    }\n    u16 suite = hel"
    "lo.suite;\n    Vec<u8> shared = Vec::new();\n    if (hello.group == 0x001d)\n    {\n        match (x2551"
    "9(&private_key[0..$], &hello.share[0..$]))\n        {\n            Some(z) : Vec::extend_from(&mut sha"
    "red, &z[0..$]),\n            None    : return Err(HandshakeFailed),\n        }\n    }\n    else\n    {\n  "
    "      EcCurve curve = if (hello.group == 0x0017) { P256 } else { P384 };\n        match (ecdh(curve, "
    "&ec_key[0..$], &hello.share[0..$]))\n        {\n            Some(z) : overwrite(&mut shared, z),\n     "
    "       None    : return Err(HandshakeFailed),\n        }\n    }\n    // The key schedule (RFC 8446 §7."
    "1), under the suite's hash.\n    Vec<u8> empty_hash = hash(kind, &none[0..$]);\n    Vec<u8> zeros = Ve"
    "c::filled(Vec::len(&empty_hash), 0: u8);\n    Vec<u8> early = hkdf_extract_with(kind, &none[0..$], &z"
    "eros[0..$]);\n    Vec<u8> derived = derive_secret(kind, &early[0..$], \"derived\", &empty_hash[0..$]);\n"
    "    Vec<u8> handshake_secret = hkdf_extract_with(kind, &derived[0..$], &shared[0..$]);\n    Vec<u8> t"
    "h = transcript_hash(&hs);\n    Vec<u8> c_hs = derive_secret(kind, &handshake_secret[0..$], \"c hs traf"
    "fic\", &th[0..$]);\n    Vec<u8> s_hs = derive_secret(kind, &handshake_secret[0..$], \"s hs traffic\", &t"
    "h[0..$]);\n    Option<RecordKeys> server_keys = Some(keys_from(&s_hs[0..$], suite));\n    Vec<u8> ee ="
    " next_message(&mut hs, &mut tcp, &mut server_keys)?;\n    if (Vec::len(&ee) < 6 || ee[0] != 8)\n    {\n"
    "        return Err(ProtocolError);\n    }\n    Vec<u8> cm = next_message(&mut hs, &mut tcp, &mut serve"
    "r_keys)?;\n    Vec<Certificate> chain = certificate_list(&cm[0..$])?;\n    Certificate leaf = Vec::rem"
    "ove(&mut chain, 0);\n    DateTime now = DateTime::now();\n    match (verify_chain(&leaf, &chain[0..$],"
    " roots, server_name, &now))\n    {\n        Ok(_)  : {},\n        Err(e) : return Err(CertRejected(e)),"
    "\n    }\n    Vec<u8> th_cert = transcript_hash(&hs);\n    Vec<u8> cv = next_message(&mut hs, &mut tcp, "
    "&mut server_keys)?;\n    if (!certificate_verify_ok(&cv[0..$], &leaf, &th_cert[0..$]))\n    {\n        "
    "return Err(HandshakeFailed);\n    }\n    Vec<u8> th_cv = transcript_hash(&hs);\n    Vec<u8> fin = next_"
    "message(&mut hs, &mut tcp, &mut server_keys)?;\n    Vec<u8> want = finished_data(kind, &s_hs[0..$], &"
    "th_cv[0..$]);\n    if (Vec::len(&fin) != 4 + Vec::len(&want) || fin[0] != 20 || !digest_eq(&fin[4..$]"
    ", &want[0..$]))\n    {\n        return Err(HandshakeFailed);\n    }\n    if (Vec::len(&hs.buffer) != 0)\n"
    "    {\n        return Err(ProtocolError);\n    }\n    Vec<u8> th_fin = transcript_hash(&hs);\n    Vec<u8"
    "> derived2 = derive_secret(kind, &handshake_secret[0..$], \"derived\", &empty_hash[0..$]);\n    Vec<u8>"
    " master = hkdf_extract_with(kind, &derived2[0..$], &zeros[0..$]);\n    Vec<u8> c_ap = derive_secret(k"
    "ind, &master[0..$], \"c ap traffic\", &th_fin[0..$]);\n    Vec<u8> s_ap = derive_secret(kind, &master[0"
    "..$], \"s ap traffic\", &th_fin[0..$]);\n    // The client's flight: a compatibility ChangeCipherSpec, "
    "then Finished\n    // under the client handshake keys.\n    array<u8, 6> ccs = [20, 0x03, 0x03, 0x00, "
    "0x01, 0x01];\n    write_all(&mut tcp, &ccs[0..$])?;\n    Vec<u8> mine = finished_data(kind, &c_hs[0..$"
    "], &th_fin[0..$]);\n    Vec<u8> cfin = Vec::new();\n    Vec::push(&mut cfin, 20);\n    push_u24(&mut cf"
    "in, Vec::len(&mine));\n    Vec::extend_from(&mut cfin, &mine[0..$]);\n    RecordKeys client_hs = keys_"
    "from(&c_hs[0..$], suite);\n    Vec<u8> out = seal_record(&mut client_hs, 22, &cfin[0..$]);\n    write_"
    "all(&mut tcp, &out[0..$])?;\n    Ok(TlsStream {\n        .tcp = tcp,\n        .send = keys_from(&c_ap[0"
    "..$], suite),\n        .recv = keys_from(&s_ap[0..$], suite),\n        .pending = Vec::new(),\n        "
    ".pending_at = 0,\n        .closed = false,\n        .peer = Some(leaf),\n    })\n}export fn TlsStream::c"
    "onnect(\n    SocketAddr addr,\n    StringView server_name,\n    ref<TrustStore, shared> roots,\n) : Resu"
    "lt<TlsStream, TlsError>\n{\n    match (TcpStream::connect(addr))\n    {\n        Ok(tcp) : TlsStream::cl"
    "ient(tcp, server_name, roots),\n        Err(e)  : Err(TlsNetFailure(e)),\n    }\n}export fn TlsStream::"
    "write(ref<TlsStream, exclusive> s, slice<u8, shared> data) : Result<void, TlsError>\n{\n    usize at ="
    " 0;\n    usize n = slice_len(data);\n    while (at < n)\n    {\n        usize take = min(n - at, 16384);"
    "\n        Vec<u8> rec = seal_record(&mut s.send, 23, &data[at..at + take]);\n        write_all(&mut s."
    "tcp, &rec[0..$])?;\n        at += take;\n    }\n    Ok(())\n}export fn TlsStream::write_text(ref<TlsStre"
    "am, exclusive> s, StringView text) : Result<void, TlsError>\n{\n    TlsStream::write(s, text.bytes)\n}f"
    "n TlsStream::fill(ref<TlsStream, exclusive> s) : Result<void, TlsError>\n{\n    while (s.pending_at >="
    " Vec::len(&s.pending) && !s.closed)\n    {\n        Record r = read_record(&mut s.tcp)?;\n        if (r"
    ".kind == 20)\n        {\n            continue;\n        }\n        Inner { kind, content } = open_record"
    "(&mut s.recv, &r)?;\n        if (kind == 23)\n        {\n            overwrite(&mut s.pending, content)"
    ";\n            s.pending_at = 0;\n        }\n        else if (kind == 21)\n        {\n            if (Vec"
    "::len(&content) == 2 && content[1] == 0)\n            {\n                s.closed = true;\n            "
    "}\n            else\n            {\n                return Err(PeerAlert(if (Vec::len(&content) == 2) {"
    " content[1] } else { 0 }));\n            }\n        }\n        else if (kind == 22)\n        {\n         "
    "   usize at = 0;\n            while (at + 4 <= Vec::len(&content))\n            {\n                u8 t"
    " = content[at];\n                usize len = widen<usize>(content[at + 1]) << 16 | widen<usize>(conte"
    "nt[at + 2]) << 8 | widen<usize>(content[at + 3]);\n                if (at + 4 + len > Vec::len(&conte"
    "nt))\n                {\n                    return Err(ProtocolError);\n                }\n            "
    "    if (t == 24)\n                {\n                    if (len != 1)\n                    {\n         "
    "               return Err(ProtocolError);\n                    }\n                    Vec<u8> none = V"
    "ec::new();\n                    HashKind kind = suite_hash(s.recv.suite);\n                    Vec<u8>"
    " next = hkdf_expand_label_with(\n                        kind,\n                        &s.recv.secret"
    "[0..$],\n                        \"traffic upd\",\n                        &none[0..$],\n                "
    "        Vec::len(&s.recv.secret),\n                    );\n                    overwrite(&mut s.recv, "
    "keys_from(&next[0..$], s.recv.suite));\n                    if (content[at + 4] == 1)\n               "
    "     {\n                        array<u8, 5> reply = [24, 0, 0, 1, 0];\n                        Vec<u8"
    "> rec = seal_record(&mut s.send, 22, &reply[0..$]);\n                        write_all(&mut s.tcp, &r"
    "ec[0..$])?;\n                        Vec<u8> mine = hkdf_expand_label_with(\n                         "
    "   kind,\n                            &s.send.secret[0..$],\n                            \"traffic upd\""
    ",\n                            &none[0..$],\n                            Vec::len(&s.send.secret),\n   "
    "                     );\n                        overwrite(&mut s.send, keys_from(&mine[0..$], s.send"
    ".suite));\n                    }\n                }\n                else if (t != 4)\n                {"
    "\n                    return Err(ProtocolError);\n                }\n                at = at + 4 + len;"
    "\n            }\n        }\n        else\n        {\n            return Err(ProtocolError);\n        }\n   "
    " }\n    Ok(())\n}export fn TlsStream::read(ref<TlsStream, exclusive> s, ref<Vec<u8>, exclusive> buf, u"
    "size max) : Result<usize, TlsError>\n{\n    if (max == 0)\n    {\n        return Ok(0);\n    }\n    TlsStr"
    "eam::fill(s)?;\n    usize have = Vec::len(&s.pending) - s.pending_at;\n    usize take = min(have, max)"
    ";\n    Vec::extend_from(buf, &s.pending[s.pending_at..s.pending_at + take]);\n    s.pending_at += take"
    ";\n    Ok(take)\n}export fn TlsStream::read_exact(\n    ref<TlsStream, exclusive> s,\n    ref<Vec<u8>, e"
    "xclusive> buf,\n    usize n,\n) : Result<void, TlsError>\n{\n    usize got = 0;\n    while (got < n)\n    "
    "{\n        usize k = TlsStream::read(s, buf, n - got)?;\n        if (k == 0)\n        {\n            ret"
    "urn Err(TlsNetFailure(Closed));\n        }\n        got += k;\n    }\n    Ok(())\n}export fn TlsStream::r"
    "ead_line(ref<TlsStream, exclusive> s) : Result<Option<String>, TlsError>\n{\n    Vec<u8> line = Vec::n"
    "ew();\n    while (true)\n    {\n        TlsStream::fill(s)?;\n        usize n = Vec::len(&s.pending);\n  "
    "      if (s.pending_at >= n)\n        {\n            if (Vec::len(&line) == 0)\n            {\n         "
    "       return Ok(None);\n            }\n            break;\n        }\n        usize i = s.pending_at;\n "
    "       while (i < n && s.pending[i] != 10)\n        {\n            i += 1;\n        }\n        if (i < n"
    ")\n        {\n            Vec::extend_from(&mut line, &s.pending[s.pending_at..i]);\n            s.pend"
    "ing_at = i + 1;\n            break;\n        }\n        Vec::extend_from(&mut line, &s.pending[s.pendin"
    "g_at..n]);\n        s.pending_at = n;\n    }\n    usize k = Vec::len(&line);\n    if (k > 0 && line[k - "
    "1] == 13)\n    {\n        Vec::pop(&mut line);\n    }\n    match (String::from_utf8(line))\n    {\n       "
    " Ok(t)  : Ok(Some(t)),\n        Err(e) : Err(TlsNetFailure(NotUtf8(e))),\n    }\n}export fn TlsStream::"
    "close(ref<TlsStream, exclusive> s) : Result<void, TlsError>\n{\n    array<u8, 2> alert = [1, 0];\n    V"
    "ec<u8> rec = seal_record(&mut s.send, 21, &alert[0..$]);\n    write_all(&mut s.tcp, &rec[0..$])\n}fn u"
    "16_list(slice<u8, shared> b, usize start, usize end, ref<Vec<u16>, exclusive> out) : bool\n{\n    if ("
    "(end - start) % 2 != 0)\n    {\n        return false;\n    }\n    usize at = start;\n    while (at < end)"
    "\n    {\n        Vec::push(out, read_be<u16>(b, at));\n        at += 2;\n    }\n    true\n}fn client_hello"
    "_parse(slice<u8, shared> m) : Result<ClientHello, TlsError>\n{\n    usize n = slice_len(m);\n    if (n "
    "< 4 + 2 + 32 + 1 || m[0] != 1)\n    {\n        return Err(ProtocolError);\n    }\n    usize at = 38;\n   "
    " usize sid_len = widen<usize>(m[at]);\n    if (sid_len > 32 || at + 1 + sid_len + 2 > n)\n    {\n      "
    "  return Err(ProtocolError);\n    }\n    Vec<u8> session = Vec::from_slice(&m[at + 1..at + 1 + sid_len"
    "]);\n    at = at + 1 + sid_len;\n    usize suites_len = widen<usize>(read_be<u16>(m, at));\n    at += 2"
    ";\n    if (at + suites_len + 1 > n)\n    {\n        return Err(ProtocolError);\n    }\n    Vec<u16> suite"
    "s = Vec::new();\n    if (!u16_list(m, at, at + suites_len, &mut suites))\n    {\n        return Err(Pro"
    "tocolError);\n    }\n    at += suites_len;\n    usize comp_len = widen<usize>(m[at]);\n    at += 1 + com"
    "p_len;\n    ClientHello ch = ClientHello {\n        .session = session,\n        .suites = suites,\n    "
    "    .groups = Vec::new(),\n        .schemes = Vec::new(),\n        .share_groups = Vec::new(),\n       "
    " .shares = Vec::new(),\n        .tls13 = false,\n        .has_cookie = false,\n    };\n    if (at == n)\n"
    "    {\n        return Ok(ch);\n    }\n    if (at + 2 > n)\n    {\n        return Err(ProtocolError);\n    "
    "}\n    usize ext_end = at + 2 + widen<usize>(read_be<u16>(m, at));\n    if (ext_end != n)\n    {\n      "
    "  return Err(ProtocolError);\n    }\n    at += 2;\n    while (at + 4 <= ext_end)\n    {\n        u16 kind"
    " = read_be<u16>(m, at);\n        usize len = widen<usize>(read_be<u16>(m, at + 2));\n        usize sta"
    "rt = at + 4;\n        if (start + len > ext_end)\n        {\n            return Err(ProtocolError);\n   "
    "     }\n        if (kind == 0x002b)\n        {\n            // supported_versions: a 1-byte length and "
    "the versions.\n            if (len < 1 || widen<usize>(m[start]) + 1 != len)\n            {\n          "
    "      return Err(ProtocolError);\n            }\n            Vec<u16> versions = Vec::new();\n         "
    "   if (!u16_list(m, start + 1, start + len, &mut versions))\n            {\n                return Err"
    "(ProtocolError);\n            }\n            foreach (v in &versions)\n            {\n                if"
    " (*v == 0x0304)\n                {\n                    ch.tls13 = true;\n                }\n           "
    " }\n        }\n        else if (kind == 0x000a || kind == 0x000d)\n        {\n            if (len < 2 ||"
    " widen<usize>(read_be<u16>(m, start)) + 2 != len)\n            {\n                return Err(ProtocolE"
    "rror);\n            }\n            Vec<u16> list = Vec::new();\n            if (!u16_list(m, start + 2,"
    " start + len, &mut list))\n            {\n                return Err(ProtocolError);\n            }\n   "
    "         if (kind == 0x000a)\n            {\n                overwrite(&mut ch.groups, list);\n        "
    "    }\n            else\n            {\n                overwrite(&mut ch.schemes, list);\n            }"
    "\n        }\n        else if (kind == 0x0033)\n        {\n            if (len < 2 || widen<usize>(read_b"
    "e<u16>(m, start)) + 2 != len)\n            {\n                return Err(ProtocolError);\n            }"
    "\n            usize p = start + 2;\n            while (p + 4 <= start + len)\n            {\n           "
    "     u16 g = read_be<u16>(m, p);\n                usize klen = widen<usize>(read_be<u16>(m, p + 2));\n"
    "                if (p + 4 + klen > start + len)\n                {\n                    return Err(Pro"
    "tocolError);\n                }\n                Vec::push(&mut ch.share_groups, g);\n                V"
    "ec::push(&mut ch.shares, Vec::from_slice(&m[p + 4..p + 4 + klen]));\n                p += 4 + klen;\n "
    "           }\n            if (p != start + len)\n            {\n                return Err(ProtocolErro"
    "r);\n            }\n        }\n        else if (kind == 0x002c)\n        {\n            ch.has_cookie = t"
    "rue;\n        }\n        at = start + len;\n    }\n    if (at != ext_end)\n    {\n        return Err(Proto"
    "colError);\n    }\n    Ok(ch)\n}fn send_plain_alert(ref<TcpStream, exclusive> tcp, u8 code)\n{\n    array"
    "<u8, 7> rec = [21, 0x03, 0x03, 0, 2, 2, code];\n    _ = TcpStream::write(tcp, &rec[0..$]);\n}fn server"
    "_hello_bytes(\n    slice<u8, shared> random,\n    slice<u8, shared> session,\n    u16 suite,\n    u16 gr"
    "oup,\n    slice<u8, shared> share,\n    bool retry,\n) : Vec<u8>\n{\n    Vec<u8> ext = Vec::new();\n    ar"
    "ray<u8, 2> v13 = [0x03, 0x04];\n    push_extension(&mut ext, 0x002b, &v13[0..$]);\n    Vec<u8> ks = Ve"
    "c::new();\n    Vec::push_be(&mut ks, group);\n    if (!retry)\n    {\n        Vec::push_be(&mut ks, narr"
    "ow<u16>(slice_len(share)));\n        Vec::extend_from(&mut ks, share);\n    }\n    push_extension(&mut "
    "ext, 0x0033, &ks[0..$]);\n    Vec<u8> body = Vec::new();\n    Vec::push_be(&mut body, 0x0303: u16);\n  "
    "  Vec::extend_from(&mut body, random);\n    Vec::push(&mut body, narrow<u8>(slice_len(session)));\n   "
    " Vec::extend_from(&mut body, session);\n    Vec::push_be(&mut body, suite);\n    Vec::push(&mut body, "
    "0);\n    Vec::push_be(&mut body, narrow<u16>(Vec::len(&ext)));\n    Vec::extend_from(&mut body, &ext[0"
    "..$]);\n    Vec<u8> msg = Vec::new();\n    Vec::push(&mut msg, 2);\n    push_u24(&mut msg, Vec::len(&bo"
    "dy));\n    Vec::extend_from(&mut msg, &body[0..$]);\n    msg\n}fn send_handshake(\n    ref<TcpStream, ex"
    "clusive> tcp,\n    ref<RecordKeys, exclusive> keys,\n    ref<Handshake, exclusive> hs,\n    slice<u8, s"
    "hared> msg,\n) : Result<void, TlsError>\n{\n    transcript_add(hs, msg);\n    usize at = 0;\n    while (a"
    "t < slice_len(msg))\n    {\n        usize take = min(slice_len(msg) - at, 16384);\n        Vec<u8> rec "
    "= seal_record(keys, 22, &msg[at..at + take]);\n        write_all(tcp, &rec[0..$])?;\n        at += tak"
    "e;\n    }\n    Ok(())\n}fn server_scheme(ref<PrivateKey, shared> key, ref<Vec<u16>, shared> offered) : "
    "Option<u16>\n{\n    u16 want = match (key)\n    {\n        RsaPrivate(_)     : 0x0804,\n        EcPrivate"
    "(k)      : if (k.curve == P256) { 0x0403 } else { 0x0503 },\n        Ed25519Private(_) : 0x0807,\n    "
    "};\n    foreach (s in offered)\n    {\n        if (*s == want)\n        {\n            return Some(want);"
    "\n        }\n    }\n    None\n}fn scheme_of(u16 code) : SignatureScheme\n{\n    if (code == 0x0403) { Ecds"
    "a(Sha2_256) }\n    else if (code == 0x0503) { Ecdsa(Sha2_384) }\n    else if (code == 0x0807) { Ed2551"
    "9 }\n    else { RsaPss(Sha2_256) }\n}export fn TlsStream::server(\n    TcpStream tcp,\n    ref<PrivateKe"
    "y, shared> key,\n    slice<Certificate, shared> chain,\n) : Result<TlsStream, TlsError>\n{\n    if (slic"
    "e_len(chain) == 0)\n    {\n        return Err(HandshakeFailed);\n    }\n    Handshake hs = Handshake { ."
    "buffer = Vec::new(), .t256 = Hasher::new(Sha2_256), .t384 = Hasher::new(Sha2_384), .kind = Sha2_256 "
    "};\n    Option<RecordKeys> plain = None;\n    Vec<u8> chm = next_message(&mut hs, &mut tcp, &mut plain"
    ")?;\n    ClientHello ch = client_hello_parse(&chm[0..$])?;\n    if (!ch.tls13)\n    {\n        send_plai"
    "n_alert(&mut tcp, 70);\n        return Err(HandshakeFailed);\n    }\n    // The suite: the client's fir"
    "st that this server has.\n    u16 suite = 0;\n    foreach (s in &ch.suites)\n    {\n        if (suite =="
    " 0 && (*s == 0x1303 || *s == 0x1301 || *s == 0x1302))\n        {\n            suite = *s;\n        }\n  "
    "  }\n    u16 scheme_code = match (server_scheme(key, &ch.schemes))\n    {\n        Some(c) : c,\n       "
    " None    : 0,\n    };\n    if (suite == 0 || scheme_code == 0)\n    {\n        send_plain_alert(&mut tcp"
    ", 40);\n        return Err(HandshakeFailed);\n    }\n    hs.kind = suite_hash(suite);\n    HashKind kind"
    " = hs.kind;\n    // The group: the client's first key share for a group this server\n    // has; else "
    "a HelloRetryRequest for the first group it supports.\n    u16 group = 0;\n    Vec<u8> client_share = V"
    "ec::new();\n    for (usize i = 0; i < Vec::len(&ch.share_groups) && group == 0; i += 1)\n    {\n       "
    " u16 g = ch.share_groups[i];\n        if (g == 0x001d || g == 0x0017 || g == 0x0018)\n        {\n      "
    "      group = g;\n            overwrite(&mut client_share, Vec::clone(&ch.shares[i]));\n        }\n    "
    "}\n    Vec<u8> session = Vec::clone(&ch.session);\n    if (group == 0)\n    {\n        u16 ask = 0;\n    "
    "    foreach (g in &ch.groups)\n        {\n            if (ask == 0 && (*g == 0x001d || *g == 0x0017 ||"
    " *g == 0x0018))\n            {\n                ask = *g;\n            }\n        }\n        if (ask == 0"
    " || ch.has_cookie)\n        {\n            send_plain_alert(&mut tcp, 40);\n            return Err(Hand"
    "shakeFailed);\n        }\n        // RFC 8446 §4.1.4: the transcript restarts from\n        // message"
    "_hash(ClientHello1) ‖ HelloRetryRequest.\n        Vec<u8> ch_hash = hash(kind, &chm[0..$]);\n       "
    " array<u8, 4> head = [254, 0, 0, narrow<u8>(Vec::len(&ch_hash))];\n        Handshake restarted = Hand"
    "shake { .buffer = Vec::new(), .t256 = Hasher::new(Sha2_256), .t384 = Hasher::new(Sha2_384), .kind = "
    "kind };\n        transcript_add(&mut restarted, &head[0..$]);\n        transcript_add(&mut restarted, "
    "&ch_hash[0..$]);\n        Vec<u8> hrr_random = Result::unwrap_or(\n            from_hex(\"cf21ad74e59a6"
    "111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c\"),\n            Vec::new(),\n        );\n        Ve"
    "c<u8> none = Vec::new();\n        Vec<u8> hrr = server_hello_bytes(&hrr_random[0..$], &session[0..$],"
    " suite, ask, &none[0..$], true);\n        transcript_add(&mut restarted, &hrr[0..$]);\n        overwri"
    "te(&mut hs, restarted);\n        write_all(&mut tcp, &handshake_record(&hrr[0..$], 0x0303)[0..$])?;\n "
    "       Vec<u8> chm2 = next_message(&mut hs, &mut tcp, &mut plain)?;\n        ClientHello ch2 = client"
    "_hello_parse(&chm2[0..$])?;\n        bool suite_ok = false;\n        foreach (s in &ch2.suites)\n      "
    "  {\n            if (*s == suite)\n            {\n                suite_ok = true;\n            }\n      "
    "  }\n        for (usize i = 0; i < Vec::len(&ch2.share_groups) && group == 0; i += 1)\n        {\n     "
    "       if (ch2.share_groups[i] == ask)\n            {\n                group = ask;\n                ov"
    "erwrite(&mut client_share, Vec::clone(&ch2.shares[i]));\n            }\n        }\n        if (group =="
    " 0 || !suite_ok || !ch2.tls13 || !same_session(&ch2.session, &session))\n        {\n            send_p"
    "lain_alert(&mut tcp, 47);\n            return Err(HandshakeFailed);\n        }\n    }\n    // This serve"
    "r's share and the shared secret.\n    Vec<u8> public_key = Vec::new();\n    Vec<u8> shared = Vec::new("
    ");\n    if (group == 0x001d)\n    {\n        array<u8, 32> private_key = x25519_private_key();\n        "
    "Vec::extend_from(&mut public_key, &x25519_public_key(&private_key[0..$])[0..$]);\n        match (x255"
    "19(&private_key[0..$], &client_share[0..$]))\n        {\n            Some(z) : Vec::extend_from(&mut s"
    "hared, &z[0..$]),\n            None    :\n            {\n                send_plain_alert(&mut tcp, 47)"
    ";\n                return Err(HandshakeFailed);\n            },\n        }\n    }\n    else\n    {\n       "
    " EcCurve curve = if (group == 0x0017) { P256 } else { P384 };\n        Vec<u8> ec_key = ec_private_ke"
    "y(curve);\n        overwrite(&mut public_key, Option::unwrap(ec_public_key(curve, &ec_key[0..$])));\n "
    "       match (ecdh(curve, &ec_key[0..$], &client_share[0..$]))\n        {\n            Some(z) : overw"
    "rite(&mut shared, z),\n            None    :\n            {\n                send_plain_alert(&mut tcp,"
    " 47);\n                return Err(HandshakeFailed);\n            },\n        }\n    }\n    array<u8, 32> "
    "random = [0; 32];\n    os_random_bytes(&mut random[0..$]);\n    Vec<u8> sh = server_hello_bytes(&rando"
    "m[0..$], &session[0..$], suite, group, &public_key[0..$], false);\n    transcript_add(&mut hs, &sh[0."
    ".$]);\n    write_all(&mut tcp, &handshake_record(&sh[0..$], 0x0303)[0..$])?;\n    array<u8, 6> ccs = ["
    "20, 0x03, 0x03, 0x00, 0x01, 0x01];\n    write_all(&mut tcp, &ccs[0..$])?;\n    // The key schedule (RF"
    "C 8446 §7.1).\n    Vec<u8> none = Vec::new();\n    Vec<u8> empty_hash = hash(kind, &none[0..$]);\n    "
    "Vec<u8> zeros = Vec::filled(Vec::len(&empty_hash), 0: u8);\n    Vec<u8> early = hkdf_extract_with(kin"
    "d, &none[0..$], &zeros[0..$]);\n    Vec<u8> derived = derive_secret(kind, &early[0..$], \"derived\", &e"
    "mpty_hash[0..$]);\n    Vec<u8> handshake_secret = hkdf_extract_with(kind, &derived[0..$], &shared[0.."
    "$]);\n    Vec<u8> th = transcript_hash(&hs);\n    Vec<u8> c_hs = derive_secret(kind, &handshake_secret"
    "[0..$], \"c hs traffic\", &th[0..$]);\n    Vec<u8> s_hs = derive_secret(kind, &handshake_secret[0..$], "
    "\"s hs traffic\", &th[0..$]);\n    RecordKeys server_hs = keys_from(&s_hs[0..$], suite);\n    // Encrypt"
    "edExtensions (none), Certificate, CertificateVerify, Finished.\n    array<u8, 6> ee = [8, 0, 0, 2, 0,"
    " 0];\n    send_handshake(&mut tcp, &mut server_hs, &mut hs, &ee[0..$])?;\n    Vec<u8> list = Vec::new("
    ");\n    foreach (c in chain)\n    {\n        push_u24(&mut list, Vec::len(&c.der));\n        Vec::extend"
    "_from(&mut list, &c.der[0..$]);\n        Vec::push_be(&mut list, 0: u16);\n    }\n    Vec<u8> cert = Ve"
    "c::new();\n    Vec::push(&mut cert, 11);\n    push_u24(&mut cert, 4 + Vec::len(&list));\n    Vec::push("
    "&mut cert, 0);\n    push_u24(&mut cert, Vec::len(&list));\n    Vec::extend_from(&mut cert, &list[0..$]"
    ");\n    send_handshake(&mut tcp, &mut server_hs, &mut hs, &cert[0..$])?;\n    Vec<u8> th_cert = transc"
    "ript_hash(&hs);\n    Vec<u8> content = Vec::filled(64, 0x20: u8);\n    Vec::extend_from(&mut content, "
    "&b\"TLS 1.3, server CertificateVerify\"[0..$]);\n    Vec::push(&mut content, 0);\n    Vec::extend_from(&"
    "mut content, &th_cert[0..$]);\n    SignatureScheme scheme = scheme_of(scheme_code);\n    Vec<u8> signa"
    "ture = match (sign(key, &scheme, &content[0..$]))\n    {\n        Some(s) : s,\n        None    : retur"
    "n Err(HandshakeFailed),\n    };\n    Vec<u8> cv = Vec::new();\n    Vec::push(&mut cv, 15);\n    push_u24"
    "(&mut cv, 4 + Vec::len(&signature));\n    Vec::push_be(&mut cv, scheme_code);\n    Vec::push_be(&mut c"
    "v, narrow<u16>(Vec::len(&signature)));\n    Vec::extend_from(&mut cv, &signature[0..$]);\n    send_han"
    "dshake(&mut tcp, &mut server_hs, &mut hs, &cv[0..$])?;\n    Vec<u8> th_cv = transcript_hash(&hs);\n   "
    " Vec<u8> fin_data = finished_data(kind, &s_hs[0..$], &th_cv[0..$]);\n    Vec<u8> fin = Vec::new();\n  "
    "  Vec::push(&mut fin, 20);\n    push_u24(&mut fin, Vec::len(&fin_data));\n    Vec::extend_from(&mut fi"
    "n, &fin_data[0..$]);\n    send_handshake(&mut tcp, &mut server_hs, &mut hs, &fin[0..$])?;\n    Vec<u8>"
    " th_fin = transcript_hash(&hs);\n    Vec<u8> derived2 = derive_secret(kind, &handshake_secret[0..$], "
    "\"derived\", &empty_hash[0..$]);\n    Vec<u8> master = hkdf_extract_with(kind, &derived2[0..$], &zeros["
    "0..$]);\n    Vec<u8> c_ap = derive_secret(kind, &master[0..$], \"c ap traffic\", &th_fin[0..$]);\n    Ve"
    "c<u8> s_ap = derive_secret(kind, &master[0..$], \"s ap traffic\", &th_fin[0..$]);\n    // The client's "
    "Finished, under its handshake keys.\n    Option<RecordKeys> client_hs = Some(keys_from(&c_hs[0..$], s"
    "uite));\n    Vec<u8> cfin = next_message(&mut hs, &mut tcp, &mut client_hs)?;\n    Vec<u8> want = fini"
    "shed_data(kind, &c_hs[0..$], &th_fin[0..$]);\n    if (Vec::len(&cfin) != 4 + Vec::len(&want) || cfin["
    "0] != 20 || !digest_eq(&cfin[4..$], &want[0..$]))\n    {\n        return Err(HandshakeFailed);\n    }\n "
    "   if (Vec::len(&hs.buffer) != 0)\n    {\n        return Err(ProtocolError);\n    }\n    Ok(TlsStream {\n"
    "        .tcp = tcp,\n        .send = keys_from(&s_ap[0..$], suite),\n        .recv = keys_from(&c_ap[0"
    "..$], suite),\n        .pending = Vec::new(),\n        .pending_at = 0,\n        .closed = false,\n     "
    "   .peer = None,\n    })\n}fn same_session(ref<Vec<u8>, shared> a, ref<Vec<u8>, shared> b) : bool\n{\n  "
    "  Vec::len(a) == Vec::len(b) && digest_eq(&(*a)[0..$], &(*b)[0..$])\n}export fn HttpError::text(ref<H"
    "ttpError, shared> e) : str\n{\n    match (e)\n    {\n        HttpNetFailure(n) : NetError::text(n),\n    "
    "    HttpTlsFailure(t) : TlsError::text(t),\n        BadUrl            : \"the URL is malformed\",\n     "
    "   UnsupportedScheme : \"the URL's scheme is neither http nor https\",\n        NoRoots           : \"no"
    " trusted roots for https (TrustStore::system failed)\",\n        BadMessage        : \"the HTTP message"
    " is malformed\",\n        TooLarge          : \"the HTTP message is larger than the limit\",\n        Too"
    "ManyRedirects  : \"too many redirects\",\n        ConnectionClosed  : \"the connection was closed\",\n    "
    "}\n}fn default_port(StringView scheme) : u16\n{\n    if (StringView::eq(scheme, \"https\")) { 443 } else "
    "{ 80 }\n}export fn Url::parse(StringView text) : Result<Url, HttpError>\n{\n    usize sep = match (Stri"
    "ngView::find(text, \"://\"))\n    {\n        Some(i) : i,\n        None    : return Err(BadUrl),\n    };\n "
    "   String scheme = String::to_ascii_lower(&String::from_view(&text[0..sep]));\n    StringView rest = "
    "&text[sep + 3..$];\n    usize n = StringView::len(rest);\n    slice<u8, shared> b = StringView::as_byt"
    "es(rest);\n    usize auth_end = 0;\n    while (auth_end < n && b[auth_end] != b'/' && b[auth_end] != b"
    "'?' && b[auth_end] != b'#')\n    {\n        auth_end += 1;\n    }\n    StringView authority = &rest[0..a"
    "uth_end];\n    if (auth_end == 0 || Option::is_some(&StringView::find(authority, \"@\")))\n    {\n       "
    " return Err(BadUrl);\n    }\n    slice<u8, shared> ab = StringView::as_bytes(authority);\n    usize hos"
    "t_end = auth_end;\n    if (ab[0] == b'[')\n    {\n        host_end = match (StringView::find(authority,"
    " \"]\"))\n        {\n            Some(i) : i + 1,\n            None    : return Err(BadUrl),\n        };\n "
    "   }\n    else\n    {\n        host_end = 0;\n        while (host_end < auth_end && ab[host_end] != b':'"
    ")\n        {\n            host_end += 1;\n        }\n    }\n    String host = String::to_ascii_lower(&Str"
    "ing::from_view(&authority[0..host_end]));\n    u16 port = default_port(&scheme);\n    if (host_end < a"
    "uth_end)\n    {\n        if (ab[host_end] != b':')\n        {\n            return Err(BadUrl);\n        }"
    "\n        port = match (StringView::parse<u16>(&authority[host_end + 1..auth_end]))\n        {\n       "
    "     Ok(p)  : p,\n            Err(_) : return Err(BadUrl),\n        };\n    }\n    usize path_end = auth"
    "_end;\n    while (path_end < n && b[path_end] != b'?' && b[path_end] != b'#')\n    {\n        path_end "
    "+= 1;\n    }\n    String path = if (path_end == auth_end) { \"/\" } else\n    {\n        String::from_view"
    "(&rest[auth_end..path_end])\n    };\n    String query = String::new();\n    if (path_end < n && b[path_"
    "end] == b'?')\n    {\n        usize q_end = path_end + 1;\n        while (q_end < n && b[q_end] != b'#'"
    ")\n        {\n            q_end += 1;\n        }\n        String::append(&mut query, &rest[path_end + 1."
    ".q_end]);\n    }\n    Ok(Url { .scheme = scheme, .host = host, .port = port, .path = path, .query = qu"
    "ery })\n}unittest \"Url::parse: defaults and normalisation\"\n{\n    Url u = Result::unwrap(Url::parse(\"H"
    "TTPS://Example.com/a/b?x=1#top\"));\n    assert(u.scheme == \"https\" && u.host == \"example.com\" && u.po"
    "rt == 443);\n    assert(u.path == \"/a/b\" && u.query == \"x=1\");\n    assert(Url::target(&u) == \"/a/b?x="
    "1\");\n    Url v = Result::unwrap(Url::parse(\"http://[::1]:8080\"));\n    assert(v.host == \"[::1]\" && v."
    "path == \"/\");\n    assert(Url::text(&v) == \"http://[::1]:8080/\");\n    assert(Result::is_err(&Url::par"
    "se(\"http://user@example.com/\")));\n}export fn Url::target(ref<Url, shared> u) : String\n{\n    String t"
    " = String::clone(&u.path);\n    if (StringView::len(&u.query) > 0)\n    {\n        String::append(&mut "
    "t, \"?\");\n        String::append(&mut t, &u.query);\n    }\n    t\n}fn host_text(ref<Url, shared> u) : S"
    "tring\n{\n    String h = String::clone(&u.host);\n    if (u.port != default_port(&u.scheme))\n    {\n    "
    "    String::append(&mut h, \":\");\n        String::append(&mut h, u.port);\n    }\n    h\n}export fn Url:"
    ":text(ref<Url, shared> u) : String\n{\n    String t = String::clone(&u.scheme);\n    String::append(&mu"
    "t t, \"://\");\n    String::append(&mut t, &host_text(u));\n    String::append(&mut t, &Url::target(u));"
    "\n    t\n}fn is_unreserved(u8 b) : bool\n{\n    ascii_is_alnum(b) || b == b'-' || b == b'.' || b == b'_'"
    " || b == b'~'\n}export fn percent_encode(slice<u8, shared> bytes) : String\n{\n    String out = String:"
    ":new();\n    str digits = \"0123456789ABCDEF\";\n    foreach (c in bytes)\n    {\n        if (is_unreserve"
    "d(*c))\n        {\n            String::push_ascii(&mut out, *c);\n        }\n        else\n        {\n    "
    "        String::push_ascii(&mut out, b'%');\n            String::push_ascii(&mut out, str_byte(digits"
    ", widen<usize>(*c >> 4)));\n            String::push_ascii(&mut out, str_byte(digits, widen<usize>(*c"
    " & 15)));\n        }\n    }\n    out\n}fn hex_digit(u8 c) : Option<u8>\n{\n    if (c >= b'0' && c <= b'9')"
    " { Some(c - b'0') }\n    else if (c >= b'a' && c <= b'f') { Some(c - b'a' + 10) }\n    else if (c >= b"
    "'A' && c <= b'F') { Some(c - b'A' + 10) }\n    else { None }\n}export fn percent_decode(StringView tex"
    "t) : Option<Vec<u8>>\n{\n    slice<u8, shared> b = StringView::as_bytes(text);\n    Vec<u8> out = Vec::"
    "new();\n    usize i = 0;\n    while (i < slice_len(b))\n    {\n        if (b[i] == b'%')\n        {\n     "
    "       if (i + 3 > slice_len(b))\n            {\n                return None;\n            }\n          "
    "  u8 hi = hex_digit(b[i + 1])?;\n            u8 lo = hex_digit(b[i + 2])?;\n            Vec::push(&mut"
    " out, hi * 16 + lo);\n            i += 3;\n        }\n        else\n        {\n            Vec::push(&mut"
    " out, b[i]);\n            i += 1;\n        }\n    }\n    Some(out)\n}unittest \"percent_decode: the revers"
    "e of percent_encode\"\n{\n    assert(percent_encode(StringView::as_bytes(\"a b/ü\")) == \"a%20b%2F%C3%BC\""
    ");\n    Vec<u8> back = Option::unwrap(percent_decode(\"a%20b%2f\"));\n    assert(Result::unwrap(String::"
    "from_utf8(back)) == \"a b/\");\n    assert(Option::is_none(&percent_decode(\"100%\")));\n}export fn Param:"
    ":new(StringView name, StringView value) : Param\n{\n    Param { .name = String::from_view(name), .valu"
    "e = String::from_view(value) }\n}export fn find_param(slice<Param, shared> params, str name) : Option"
    "<StringView>\n{\n    for (usize i = 0; i < slice_len(params); i += 1)\n    {\n        if (params[i].name"
    " == name)\n        {\n            return Some(&params[i].value);\n        }\n    }\n    None\n}export fn f"
    "orm_decode(StringView text) : Vec<Param>\n{\n    Vec<Param> out = Vec::new();\n    foreach (pair in Str"
    "ingView::split(text, \"&\"))\n    {\n        foreach (p in StringView::split(pair, \";\"))\n        {\n     "
    "       if (StringView::len(p) == 0)\n            {\n                continue;\n            }\n          "
    "  StringView name = p;\n            StringView value = \"\";\n            if (Some(eq) = StringView::fin"
    "d(p, \"=\"))\n            {\n                name = &p[0..eq];\n                value = &p[eq + 1..$];\n  "
    "          }\n            Vec::push(&mut out, Param { .name = form_part(name), .value = form_part(valu"
    "e) });\n        }\n    }\n    out\n}unittest \"form_decode: pairs, bare names and bad escapes\"\n{\n    Vec<"
    "Param> ps = form_decode(\"q=red+fish&flag&&n=%41;x=%zz\");\n    assert(Vec::len(&ps) == 4);\n    assert("
    "Option::unwrap(find_param(&ps[0..$], \"q\")) == \"red fish\");\n    assert(Option::unwrap(find_param(&ps["
    "0..$], \"flag\")) == \"\");\n    assert(Option::unwrap(find_param(&ps[0..$], \"n\")) == \"A\");\n    assert(Op"
    "tion::unwrap(find_param(&ps[0..$], \"x\")) == \"%zz\");\n    assert(Option::is_none(&find_param(&ps[0..$]"
    ", \"Q\")));\n}fn form_part(StringView v) : String\n{\n    String plus = StringView::replace(v, \"+\", \" \");"
    "\n    match (percent_decode(&plus))\n    {\n        Some(b) : match (String::from_utf8(b))\n        {\n  "
    "          Ok(s)  : s,\n            Err(_) : plus,\n        },\n        None : plus,\n    }\n}export fn fo"
    "rm_encode(slice<Param, shared> params) : String\n{\n    String out = String::new();\n    for (usize i ="
    " 0; i < slice_len(params); i += 1)\n    {\n        if (i > 0)\n        {\n            String::push_ascii"
    "(&mut out, b'&');\n        }\n        String::append(&mut out, &form_encode_part(&params[i].name));\n  "
    "      String::push_ascii(&mut out, b'=');\n        String::append(&mut out, &form_encode_part(&params"
    "[i].value));\n    }\n    out\n}unittest \"form_encode: spaces and reserved bytes\"\n{\n    Vec<Param> ps = "
    "Vec::new();\n    Vec::push(&mut ps, Param::new(\"q\", \"a b&c\"));\n    Vec::push(&mut ps, Param::new(\"lan"
    "g\", \"en\"));\n    String body = form_encode(&ps[0..$]);\n    assert(body == \"q=a+b%26c&lang=en\");\n    V"
    "ec<Param> back = form_decode(&body);\n    assert(back[0].value == \"a b&c\");\n}fn form_encode_part(ref<"
    "String, shared> s) : String\n{\n    String enc = percent_encode(StringView::as_bytes(s));\n    StringVi"
    "ew::replace(&enc, \"%20\", \"+\")\n}export fn Url::query_pairs(ref<Url, shared> u) : Vec<Param>\n{\n    for"
    "m_decode(&u.query)\n}export fn Header::new(StringView name, StringView value) : Header\n{\n    Header {"
    " .name = String::from_view(name), .value = String::from_view(value) }\n}fn name_eq(StringView a, str "
    "b) : bool\n{\n    ascii_ieq_str(a.bytes, b)\n}fn names_eq(StringView a, StringView b) : bool\n{\n    asci"
    "i_ieq(a.bytes, b.bytes)\n}fn ascii_ieq(slice<u8, shared> a, slice<u8, shared> b) : bool\n{\n    if (sli"
    "ce_len(a) != slice_len(b))\n    {\n        return false;\n    }\n    for (usize i = 0; i < slice_len(a);"
    " i += 1)\n    {\n        if (ascii_to_lower(a[i]) != ascii_to_lower(b[i]))\n        {\n            retur"
    "n false;\n        }\n    }\n    true\n}fn ascii_ieq_str(slice<u8, shared> a, str b) : bool\n{\n    if (sli"
    "ce_len(a) != str_len(b))\n    {\n        return false;\n    }\n    for (usize i = 0; i < slice_len(a); i"
    " += 1)\n    {\n        if (ascii_to_lower(a[i]) != ascii_to_lower(str_byte(b, i)))\n        {\n         "
    "   return false;\n        }\n    }\n    true\n}fn has_header(slice<Header, shared> headers, StringView n"
    "ame) : bool\n{\n    for (usize i = 0; i < slice_len(headers); i += 1)\n    {\n        if (names_eq(&head"
    "ers[i].name, name))\n        {\n            return true;\n        }\n    }\n    false\n}export fn find_hea"
    "der(slice<Header, shared> headers, str name) : Option<StringView>\n{\n    for (usize i = 0; i < slice_"
    "len(headers); i += 1)\n    {\n        if (name_eq(&headers[i].name, name))\n        {\n            retur"
    "n Some(&headers[i].value);\n        }\n    }\n    None\n}export fn Request::new(StringView method, Strin"
    "gView url) : Request\n{\n    Request { .method = String::from_view(method), .url = String::from_view(u"
    "rl), .headers = Vec::new(), .body = Vec::new() }\n}export fn Request::header(ref<Request, shared> r, "
    "str name) : Option<StringView>\n{\n    find_header(&r.headers[0..$], name)\n}unittest \"Request::header:"
    " names ignore case\"\n{\n    Request r = Request::new(\"POST\", \"https://example.com/upload\");\n    Vec::p"
    "ush(&mut r.headers, Header::new(\"Content-Type\", \"text/plain\"));\n    assert(Option::unwrap(Request::h"
    "eader(&r, \"content-type\")) == \"text/plain\");\n    assert(Option::is_none(&Request::header(&r, \"accept"
    "\")));\n}export fn Response::header(ref<Response, shared> r, str name) : Option<StringView>\n{\n    find"
    "_header(&r.headers[0..$], name)\n}export fn Response::text(ref<Response, shared> r) : Result<String, "
    "Utf8Error>\n{\n    String::from_utf8(Vec::clone(&r.body))\n}export fn reason_phrase(u16 status) : str\n{"
    "\n    match (status)\n    {\n        100 : \"Continue\",\n        101 : \"Switching Protocols\",\n        200"
    " : \"OK\",\n        201 : \"Created\",\n        202 : \"Accepted\",\n        204 : \"No Content\",\n        206 "
    ": \"Partial Content\",\n        301 : \"Moved Permanently\",\n        302 : \"Found\",\n        303 : \"See Ot"
    "her\",\n        304 : \"Not Modified\",\n        307 : \"Temporary Redirect\",\n        308 : \"Permanent Red"
    "irect\",\n        400 : \"Bad Request\",\n        401 : \"Unauthorized\",\n        403 : \"Forbidden\",\n      "
    "  404 : \"Not Found\",\n        405 : \"Method Not Allowed\",\n        408 : \"Request Timeout\",\n        40"
    "9 : \"Conflict\",\n        411 : \"Length Required\",\n        413 : \"Content Too Large\",\n        415 : \"U"
    "nsupported Media Type\",\n        429 : \"Too Many Requests\",\n        500 : \"Internal Server Error\",\n  "
    "      501 : \"Not Implemented\",\n        502 : \"Bad Gateway\",\n        503 : \"Service Unavailable\",\n   "
    "     504 : \"Gateway Timeout\",\n        _   : \"\",\n    }\n}unittest \"reason_phrase: unlisted codes\"\n{\n  "
    "  assert(reason_phrase(404) == \"Not Found\");\n    assert(reason_phrase(299) == \"\");\n}fn conn_read(ref"
    "<Conn, exclusive> c, ref<Vec<u8>, exclusive> buf, usize max) : Result<usize, HttpError>\n{\n    match "
    "(c)\n    {\n        Plain(s) : match (TcpStream::read(s, buf, max))\n        {\n            Ok(n)  : Ok("
    "n),\n            Err(e) : Err(HttpNetFailure(e)),\n        },\n        Secure(s) : match (TlsStream::re"
    "ad(s, buf, max))\n        {\n            Ok(n)  : Ok(n),\n            Err(e) : Err(HttpTlsFailure(e)),\n"
    "        },\n    }\n}fn conn_write(ref<Conn, exclusive> c, slice<u8, shared> data) : Result<void, HttpE"
    "rror>\n{\n    match (c)\n    {\n        Plain(s) : match (TcpStream::write(s, data))\n        {\n         "
    "   Ok(_)  : Ok(()),\n            Err(e) : Err(HttpNetFailure(e)),\n        },\n        Secure(s) : matc"
    "h (TlsStream::write(s, data))\n        {\n            Ok(_)  : Ok(()),\n            Err(e) : Err(HttpTl"
    "sFailure(e)),\n        },\n    }\n}fn conn_close(ref<Conn, exclusive> c)\n{\n    match (c)\n    {\n        "
    "Plain(s)  : { _ = TcpStream::shutdown_write(s); },\n        Secure(s) : { _ = TlsStream::close(s); },"
    "\n    }\n}fn fill_buffer(ref<Reader, exclusive> r) : Result<bool, HttpError>\n{\n    if (r.at > 0 && r.a"
    "t == Vec::len(&r.buf))\n    {\n        Vec::clear(&mut r.buf);\n        r.at = 0;\n    }\n    usize n = c"
    "onn_read(&mut r.conn, &mut r.buf, 16384)?;\n    Ok(n > 0)\n}fn available(ref<Reader, shared> r) : usiz"
    "e\n{\n    Vec::len(&r.buf) - r.at\n}fn http_newline_from(slice<u8, shared> b, usize at) : usize\n{\n    u"
    "size i = at;\n    while (i < slice_len(b) && b[i] != b'\\n')\n    {\n        i += 1;\n    }\n    i\n}fn htt"
    "p_line(ref<Reader, exclusive> r, usize limit) : Result<Option<String>, HttpError>\n{\n    usize scanne"
    "d = 0;\n    while (true)\n    {\n        usize i = http_newline_from(&r.buf[0..$], r.at + scanned);\n   "
    "     if (i < Vec::len(&r.buf))\n        {\n            usize end = if (i > r.at && r.buf[i - 1] == b'\\"
    "r') { i - 1 } else { i };\n            Vec<u8> bytes = Vec::from_slice(&r.buf[r.at..end]);\n          "
    "  r.at = i + 1;\n            return match (String::from_utf8(bytes))\n            {\n                Ok"
    "(s)  : Ok(Some(s)),\n                Err(_) : Err(BadMessage),\n            };\n        }\n        scann"
    "ed = Vec::len(&r.buf) - r.at;\n        if (scanned > limit)\n        {\n            return Err(TooLarge"
    ");\n        }\n        if (!fill_buffer(r)?)\n        {\n            return if (scanned == 0) { Ok(None)"
    " } else { Err(BadMessage) };\n        }\n    }\n}fn read_n(ref<Reader, exclusive> r, ref<Vec<u8>, exclu"
    "sive> out, usize n) : Result<void, HttpError>\n{\n    usize need = n;\n    while (need > 0)\n    {\n     "
    "   if (available(r) == 0)\n        {\n            if (!fill_buffer(r)?)\n            {\n                "
    "return Err(ConnectionClosed);\n            }\n        }\n        usize take = min(need, available(r));\n"
    "        Vec::extend_from(out, &r.buf[r.at..r.at + take]);\n        r.at += take;\n        need -= take"
    ";\n    }\n    Ok(())\n}fn read_to_end(ref<Reader, exclusive> r, ref<Vec<u8>, exclusive> out, usize max)"
    " : Result<void, HttpError>\n{\n    while (true)\n    {\n        usize have = available(r);\n        if (h"
    "ave > 0)\n        {\n            if (Vec::len(out) + have > max)\n            {\n                return "
    "Err(TooLarge);\n            }\n            Vec::extend_from(out, &r.buf[r.at..$]);\n            r.at = "
    "Vec::len(&r.buf);\n        }\n        if (!fill_buffer(r)?)\n        {\n            return Ok(());\n     "
    "   }\n    }\n}fn read_headers(ref<Reader, exclusive> r, usize used) : Result<Vec<Header>, HttpError>\n{"
    "\n    Vec<Header> headers = Vec::new();\n    usize total = used;\n    while (true)\n    {\n        String"
    " line = match (http_line(r, MAX_HEAD)?)\n        {\n            Some(l) : l,\n            None    : ret"
    "urn Err(BadMessage),\n        };\n        total += StringView::len(&line) + 2;\n        if (total > MAX"
    "_HEAD)\n        {\n            return Err(TooLarge);\n        }\n        if (StringView::len(&line) == 0"
    ")\n        {\n            return Ok(headers);\n        }\n        StringView v = &line;\n        usize co"
    "lon = match (StringView::find(v, \":\"))\n        {\n            Some(i) : i,\n            None    : retu"
    "rn Err(BadMessage),\n        };\n        StringView name = &v[0..colon];\n        if (colon == 0 || Str"
    "ingView::len(StringView::trim(name)) != colon)\n        {\n            return Err(BadMessage);\n       "
    " }\n        Vec::push(\n            &mut headers,\n            Header { .name = String::from_view(name)"
    ", .value = String::from_view(StringView::trim(&v[colon + 1..$])) },\n        );\n    }\n}fn body_length"
    "(slice<Header, shared> headers, bool response) : Result<BodyLength, HttpError>\n{\n    Option<StringVi"
    "ew> te = find_header(headers, \"transfer-encoding\");\n    Option<StringView> cl = find_header(headers,"
    " \"content-length\");\n    if (Some(t) = te)\n    {\n        if (Option::is_some(&cl) || !name_eq(StringV"
    "iew::trim(t), \"chunked\"))\n        {\n            return Err(BadMessage);\n        }\n        return Ok("
    "Chunked);\n    }\n    if (Some(c) = cl)\n    {\n        return match (StringView::parse<usize>(StringVie"
    "w::trim(c)))\n        {\n            Ok(n)  : Ok(Length(n)),\n            Err(_) : Err(BadMessage),\n   "
    "     };\n    }\n    Ok(if (response) { UntilClose } else { NoBody })\n}fn read_body(ref<Reader, exclusi"
    "ve> r, BodyLength how, usize max) : Result<Vec<u8>, HttpError>\n{\n    Vec<u8> body = Vec::new();\n    "
    "match (how)\n    {\n        NoBody     : {},\n        Length(n)  :\n        {\n            if (n > max)\n "
    "           {\n                return Err(TooLarge);\n            }\n            read_n(r, &mut body, n)"
    "?;\n        },\n        UntilClose : read_to_end(r, &mut body, max)?,\n        Chunked    :\n        {\n "
    "           while (true)\n            {\n                String line = match (http_line(r, MAX_HEAD)?)\n"
    "                {\n                    Some(l) : l,\n                    None    : return Err(Connecti"
    "onClosed),\n                };\n                StringView size_text = &line;\n                if (Some"
    "(semi) = StringView::find(size_text, \";\"))\n                {\n                    size_text = &size_t"
    "ext[0..semi];\n                }\n                usize size = 0;\n                slice<u8, shared> sb"
    " = StringView::as_bytes(StringView::trim(size_text));\n                if (slice_len(sb) == 0 || slic"
    "e_len(sb) > 8)\n                {\n                    return Err(BadMessage);\n                }\n     "
    "           foreach (c in sb)\n                {\n                    size = size * 16 + widen<usize>(O"
    "ption::ok_or(hex_digit(*c), BadMessage)?);\n                }\n                if (size == 0)\n        "
    "        {\n                    break;\n                }\n                if (Vec::len(&body) + size > "
    "max)\n                {\n                    return Err(TooLarge);\n                }\n                r"
    "ead_n(r, &mut body, size)?;\n                match (http_line(r, 2)?)\n                {\n             "
    "       Some(end) : if (StringView::len(&end) != 0) { return Err(BadMessage); },\n                    "
    "None      : return Err(ConnectionClosed),\n                }\n            }\n            // Trailers, u"
    "p to the empty line.\n            while (true)\n            {\n                match (http_line(r, MAX_"
    "HEAD)?)\n                {\n                    Some(t) : if (StringView::len(&t) == 0) { break; },\n  "
    "                  None    : return Err(ConnectionClosed),\n                }\n            }\n        },"
    "\n    }\n    Ok(body)\n}export fn HttpClient::new() : HttpClient\n{\n    Vec<Header> headers = Vec::new()"
    ";\n    Vec::push(&mut headers, Header::new(\"User-Agent\", \"CobaltC-std-http/1\"));\n    Vec::push(&mut h"
    "eaders, Header::new(\"Accept-Encoding\", \"gzip, deflate\"));\n    HttpClient { .roots = None, .timeout_m"
    "s = 30000, .max_redirects = 10, .max_body = 16777216, .headers = headers, .keep_alive = false, .idle"
    " = None }\n}unittest \"HttpClient::new: the defaults\"\n{\n    HttpClient c = HttpClient::new();\n    asse"
    "rt(c.timeout_ms == 30000 && c.max_redirects == 10 && !c.keep_alive);\n    assert(Option::is_none(&c.r"
    "oots));\n    assert(Option::is_some(&find_header(&c.headers[0..$], \"user-agent\")));\n    c.max_body = "
    "1_048_576;\n}fn method_has_body(StringView m) : bool\n{\n    StringView::eq(m, \"POST\") || StringView::e"
    "q(m, \"PUT\") || StringView::eq(m, \"PATCH\")\n}fn open_connection(ref<HttpClient, exclusive> c, ref<Url,"
    " shared> u) : Result<Conn, HttpError>\n{\n    bool secure = StringView::eq(&u.scheme, \"https\");\n    if"
    " (!secure && !StringView::eq(&u.scheme, \"http\"))\n    {\n        return Err(UnsupportedScheme);\n    }\n"
    "    if (secure && Option::is_none(&c.roots))\n    {\n        match (TrustStore::system())\n        {\n  "
    "          Ok(t)  : overwrite(&mut c.roots, Some(t)),\n            Err(_) : return Err(NoRoots),\n     "
    "   }\n    }\n    // A bracketed IPv6 host loses its brackets for resolution.\n    String host = String:"
    ":clone(&u.host);\n    if (StringView::starts_with(&host, \"[\") && StringView::ends_with(&host, \"]\"))\n "
    "   {\n        overwrite(&mut host, String::from_view(&u.host[1..StringView::len(&u.host) - 1]));\n    "
    "}\n    Vec<SocketAddr> addrs = match (IpAddr::parse(&host))\n    {\n        Ok(ip) :\n        {\n        "
    "    Vec<SocketAddr> one = Vec::new();\n            Vec::push(&mut one, SocketAddr::new(ip, u.port));\n"
    "            one\n        },\n        Err(_) : match (resolve(&host, u.port))\n        {\n            Ok("
    "a)  : a,\n            Err(e) : return Err(HttpNetFailure(e)),\n        },\n    };\n    if (Vec::len(&add"
    "rs) == 0)\n    {\n        return Err(HttpNetFailure(UnknownHost));\n    }\n    NetError last = Failed;\n "
    "   for (usize i = 0; i < Vec::len(&addrs); i += 1)\n    {\n        TcpStream tcp = match (TcpStream::c"
    "onnect_timeout(addrs[i], c.timeout_ms))\n        {\n            Ok(t)  : t,\n            Err(e) :\n     "
    "       {\n                last = e;\n                continue;\n            },\n        };\n        TcpSt"
    "ream::set_read_timeout_ms(&mut tcp, c.timeout_ms);\n        TcpStream::set_write_timeout_ms(&mut tcp,"
    " c.timeout_ms);\n        TcpStream::set_nodelay(&mut tcp, true);\n        if (!secure)\n        {\n     "
    "       return Ok(Plain(tcp));\n        }\n        ref<TrustStore, shared> roots = match (&c.roots)\n   "
    "     {\n            Some(r) : r,\n            None    : return Err(NoRoots),\n        };\n        return"
    " match (TlsStream::client(tcp, &host, roots))\n        {\n            Ok(s)  : Ok(Secure(s)),\n        "
    "    Err(e) : Err(HttpTlsFailure(e)),\n        };\n    }\n    Err(HttpNetFailure(last))\n}fn is_credentia"
    "l(StringView name) : bool\n{\n    name_eq(name, \"authorization\") || name_eq(name, \"proxy-authorization"
    "\") || name_eq(name, \"cookie\")\n}fn request_bytes(\n    ref<HttpClient, shared> c,\n    ref<Request, sha"
    "red> req,\n    ref<Url, shared> u,\n    StringView method,\n    slice<u8, shared> body,\n    bool with_c"
    "ontent,\n    bool credentials,\n) : Vec<u8>\n{\n    String head = String::from_view(method);\n    String:"
    ":append(&mut head, \" \");\n    String::append(&mut head, &Url::target(u));\n    String::append(&mut hea"
    "d, \" HTTP/1.1\\r\\nHost: \");\n    String::append(&mut head, &host_text(u));\n    String::append(&mut hea"
    "d, \"\\r\\n\");\n    foreach (h in &c.headers)\n    {\n        StringView name = &h.name;\n        bool kept"
    " = credentials || !is_credential(name);\n        if (kept && !has_header(&req.headers[0..$], name))\n "
    "       {\n            String::append(&mut head, &h.name);\n            String::append(&mut head, \": \")"
    ";\n            String::append(&mut head, &h.value);\n            String::append(&mut head, \"\\r\\n\");\n  "
    "      }\n    }\n    foreach (h in &req.headers)\n    {\n        if (name_eq(\n            &h.name,\n      "
    "      \"host\",\n        ) || name_eq(&h.name, \"content-length\") || name_eq(&h.name, \"connection\"))\n   "
    "     {\n            continue;\n        }\n        // After a redirect to another origin, no credentials"
    " go there.\n        if (!credentials && is_credential(&h.name))\n        {\n            continue;\n     "
    "   }\n        // After a redirect that dropped the body, its Content-Type goes too.\n        if (!with"
    "_content && name_eq(&h.name, \"content-type\"))\n        {\n            continue;\n        }\n        Stri"
    "ng::append(&mut head, &h.name);\n        String::append(&mut head, \": \");\n        String::append(&mut"
    " head, &h.value);\n        String::append(&mut head, \"\\r\\n\");\n    }\n    if (slice_len(body) > 0 || me"
    "thod_has_body(method))\n    {\n        String::append(&mut head, \"Content-Length: \");\n        String::"
    "append(&mut head, slice_len(body));\n        String::append(&mut head, \"\\r\\n\");\n    }\n    if (!c.keep"
    "_alive)\n    {\n        String::append(&mut head, \"Connection: close\\r\\n\");\n    }\n    String::append(&"
    "mut head, \"\\r\\n\");\n    Vec<u8> out = String::into_bytes(head);\n    Vec::extend_from(&mut out, body);"
    "\n    out\n}fn not_content_encoding(ref<Header, shared> h) : bool\n{\n    !name_eq(&h.name, \"content-enc"
    "oding\") && !name_eq(&h.name, \"content-length\")\n}fn parse_status_line(StringView line) : Result<Statu"
    "sLine, HttpError>\n{\n    if (!StringView::starts_with(line, \"HTTP/1.\") || StringView::len(line) < 12)"
    "\n    {\n        return Err(BadMessage);\n    }\n    // The version, the space, the three digits and the"
