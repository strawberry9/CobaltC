    "e, k))\n    {\n        Some(em) : digest_eq(&em[0..$], &want[0..$]),\n        None     : false,\n    }\n}"
    "fn mgf1(HashKind kind, slice<u8, shared> seed, usize len) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n"
