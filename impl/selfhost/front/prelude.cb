    "es_shift_rows(aes_sbox_ct(q));\n        if (round < key.rounds)\n        {\n            q = aes_mix_col"
    "umns(q);\n        }\n        for (usize p = 0; p < 8; p += 1)\n        {\n            q[p] = q[p] ^ key."
    "sk[8 * round + p];\n        }\n    }\n    q\n}fn aes_block(ref<AesKey, shared> key, array<u8, 16> input)"
    " : array<u8, 16>\n{\n    array<u8, 64> b = [0; 64];\n    for (usize i = 0; i < 16; i += 1)\n    {\n      "
    "  b[i] = input[i];\n    }\n    array<u8, 64> e = aes_unpack(aes_encrypt4(key, aes_pack(b)));\n    array"
    "<u8, 16> out = [0; 16];\n    for (usize i = 0; i < 16; i += 1)\n    {\n        out[i] = e[i];\n    }\n   "
    " out\n}export fn aes_encrypt_block(slice<u8, shared> key, array<u8, 16> block) : array<u8, 16>\n{\n    "
    "AesKey k = aes_expand(key);\n    aes_block(&k, block)\n}unittest \"aes_encrypt_block: the FIPS 197 AES-"
    "128 vector\"\n{\n    Vec<u8> key = Result::unwrap(from_hex(\"000102030405060708090a0b0c0d0e0f\"));\n    Ve"
    "c<u8> b = Result::unwrap(from_hex(\"00112233445566778899aabbccddeeff\"));\n    array<u8, 16> block = [0"
    "; 16];\n    for (usize i = 0; i < 16; i += 1)\n    {\n        block[i] = b[i];\n    }\n    array<u8, 16> "
    "out = aes_encrypt_block(&key, block);\n    assert(to_hex(&out) == \"69c4e0d86a7b0430d8cdb78070b4c55a\")"
    ";\n}fn gcm_block(slice<u8, shared> b, usize at) : u128\n{\n    u128 x = 0;\n    for (usize i = 0; i < 16"
    "; i += 1)\n    {\n        u8 v = if (at + i < slice_len(b)) { b[at + i] } else { 0 };\n        x = (x <"
    "< 8) | widen<u128>(v);\n    }\n    x\n}fn ghash_bmul64(u64 x, u64 y) : u64\n{\n    u64 x0 = x & 0x1111111"
