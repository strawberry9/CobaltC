    "\n    assert(String::len(Arc::get(&b)) == 6);\n    ArcWeak<String> w = Arc::downgrade(&a);\n    ArcWeak"
    "<String> w2 = clone(&w);\n    drop(a);\n    assert(Option::is_some(&ArcWeak::upgrade(&w)));\n    drop(b"
    ");\n    assert(Option::is_none(&ArcWeak::upgrade(&w)) && Option::is_none(&ArcWeak::upgrade(&w2)));\n}f"
    "n Box::cells<T>() : usize\n{\n    if (sizeof<T>() == 0)\n    {\n        1\n    }\n    else\n    {\n        s"
    "izeof<T>()\n    }\n}export fn Box::new<T>(T v) : Box<T>\n{\n    rawptr<u8> p = match (allocate(Box::cell"
    "s<T>(), alignof<T>()))\n    {\n        Ok(p)  : p,\n        Err(_) : fault(alloc_failure),\n    };\n    r"
    "awptr<T> bp = reinterpret_ptr<T>(p);\n    unsafe\n    {\n        *bp = v;\n    }\n    Box { .ptr = bp }\n}"
    "export fn Box::get<T>(ref<Box<T>, shared> b) : ref<T, shared>\n{\n    unsafe\n    {\n        &reclaim<T>"
    "(b.ptr)\n    }\n}export fn Box::get_mut<T>(ref<Box<T>, exclusive> b) : ref<T, exclusive>\n{\n    // D-02"
    "22: the box is accessed exclusively through `b`: a live shared path to it meets the access.\n    _ = "
    "&mut *b;\n    unsafe\n    {\n        &mut reclaim<T>(b.ptr)\n    }\n}export fn Box::clone<T: clone>(ref<B"
    "ox<T>, shared> b) : Box<T>\n{\n    Box::new(clone(Box::get(b)))\n}export fn Box::into_inner<T>(Box<T> b"
    ") : T\n{\n    unsafe\n    {\n        auto v = *b.ptr;\n        release(reinterpret_ptr<u8>(b.ptr), sizeof"
    "<T>());\n        deallocate(reinterpret_ptr<u8>(b.ptr), Box::cells<T>(), alignof<T>());\n        b.ptr"
    " = null_rawptr<T>();\n        v\n    }\n}unittest \"Box::into_inner: get_mut, clone and into_inner\"\n{\n  "
    "  Box<i32> b = Box::new(5);\n    *Box::get_mut(&mut b) = 6;\n    assert(*Box::get(&b) == 6);\n    Box<i"
    "32> c = clone(&b);\n    assert(Box::into_inner(c) == 6);\n}export fn Box::drop<T>(ref<Box<T>, exclusiv"
    "e> self)\n{\n    if (self.ptr == null_rawptr<T>())\n    {\n        return;\n    }\n    unsafe\n    {\n      "
    "  drop(reclaim<T>(self.ptr));\n        deallocate(reinterpret_ptr<u8>(self.ptr), Box::cells<T>(), ali"
    "gnof<T>());\n    }\n}fn ChannelState::pop<T>(ref<ChannelState<T>, exclusive> st) : Option<T>\n{\n    usi"
    "ze at = st.head;\n    Option<T> none = None;\n    Option<T> x = replace(&mut st.slots[at], none);\n    "
    "st.head = (at + 1) % Vec::len(&st.slots);\n    st.count = st.count - 1;\n    x\n}export fn Channel::new"
    "<T>(usize cap) : Channel<T>\n{\n    if (cap == 0)\n    {\n        fault(channel_zero_capacity);\n    }\n  "
    "  Vec<Option<T>> slots = Vec::new();\n    usize i = 0;\n    while (i < cap)\n    {\n        Option<T> no"
    "ne = None;\n        Vec::push(&mut slots, none);\n        i = i + 1;\n    }\n    usize can_send = unsafe"
    "\n    {\n        event_op(0, 0, 0)\n    };\n    usize can_recv = unsafe\n    {\n        event_op(0, 0, 0)\n"
    "    };\n    ChannelState<T> st = ChannelState { .slots = slots, .head = 0, .count = 0, .closed = fals"
    "e };\n    Channel { .state = Mutex::new(st), .cap = cap, .can_send = can_send, .can_recv = can_recv }"
    "\n}export fn Channel::send<T>(ref<Channel<T>, shared> ch, T v) : Result<void, T>\n{\n    // D-0213 `[Th"
    "read-Lend]`: the exclusive references `v` holds are lent\n    // to the thread that receives it; the "
    "sender's own copies then clash\n    // with them while they live.\n    lend_places(&mut v);\n    while "
    "(true)\n    {\n        usize seen = 0;\n        {\n            auto g = lock(&ch.state);\n            if "
    "(g.closed)\n            {\n                return Err(v);\n            }\n            if (g.count < ch.c"
    "ap)\n            {\n                usize at = (g.head + g.count) % ch.cap;\n                g.slots[at"
    "] = Some(v);\n                g.count = g.count + 1;\n                unsafe\n                {\n       "
    "             event_op(3, ch.can_recv, 0);\n                }\n                return Ok(());\n         "
    "   }\n            seen = unsafe\n            {\n                event_op(1, ch.can_send, 0)\n           "
    " };\n        }\n        unsafe\n        {\n            event_op(2, ch.can_send, seen);\n        }\n    }\n}"
    "export fn Channel::recv<T>(ref<Channel<T>, shared> ch) : Option<T>\n{\n    while (true)\n    {\n        "
    "usize seen = 0;\n        {\n            auto g = lock(&ch.state);\n            if (g.count > 0)\n       "
    "     {\n                Option<T> x = ChannelState::pop(&mut *g);\n                unsafe\n            "
    "    {\n                    event_op(3, ch.can_send, 0);\n                }\n                return x;\n "
    "           }\n            if (g.closed)\n            {\n                return None;\n            }\n    "
    "        seen = unsafe\n            {\n                event_op(1, ch.can_recv, 0)\n            };\n     "
    "   }\n        unsafe\n        {\n            event_op(2, ch.can_recv, seen);\n        }\n    }\n}export fn"
    " Channel::try_recv<T>(ref<Channel<T>, shared> ch) : Result<Option<T>, void>\n{\n    auto g = lock(&ch."
    "state);\n    if (g.count > 0)\n    {\n        Option<T> x = ChannelState::pop(&mut *g);\n        unsafe\n"
    "        {\n            event_op(3, ch.can_send, 0);\n        }\n        return Ok(x);\n    }\n    if (g.c"
    "losed)\n    {\n        return Err(());\n    }\n    Ok(None)\n}unittest \"Channel::try_recv: the three outc"
    "omes\"\n{\n    Channel<i32> ch = Channel::new(1);\n    assert(Option::is_none(&Result::unwrap(Channel::t"
    "ry_recv(&ch))));\n    _ = Channel::send(&ch, 5);\n    Channel::close(&ch);\n    assert(Option::unwrap(R"
    "esult::unwrap(Channel::try_recv(&ch))) == 5);\n    assert(Result::is_err(&Channel::try_recv(&ch)));\n}"
    "export fn Channel::recv_timeout_ms<T>(ref<Channel<T>, shared> ch, u64 ms) : Result<Option<T>, void>\n"
    "{\n    // D-0232: a wait too long for the clock's range waits as long as it can,\n    // rather than w"
    "rapping round to a deadline in the past.\n    u64 ns = saturating_mul(ms, 1_000_000: u64);\n    i64 sp"
    "an = if (ns > reinterpret<u64>(max_value<i64>()))\n    {\n        max_value<i64>()\n    }\n    else\n    "
    "{\n        reinterpret<i64>(ns)\n    };\n    i64 deadline = saturating_add(unsafe\n    {\n        clock_r"
    "ead(0)\n    }, span);\n    u64 round = 0;\n    while (true)\n    {\n        match (Channel::try_recv(ch))"
    "\n        {\n            Ok(Some(v)) : return Ok(Some(v)),\n            Ok(None)    : {},\n            E"
    "rr(_)      : return Err(()),\n        }\n        i64 now = unsafe\n        {\n            clock_read(0)\n"
    "        };\n        if (now >= deadline)\n        {\n            return Ok(None);\n        }\n        i64"
    " ignored = unsafe\n        {\n            sleep_ns(if (round < 20) { 1000000 } else { 5000000 })\n     "
    "   };\n        round += 1;\n    }\n}export fn cpu_count() : usize\n{\n    i64 n = byte_op(1, 19, 0, dangl"
    "ing<u8>(), 0, dangling<u8>(), 0, dangling<u8>(), 0);\n    if (n < 1)\n    {\n        return 1;\n    }\n  "
    "  reinterpret<usize>(n)\n}export fn Channel::close<T>(ref<Channel<T>, shared> ch)\n{\n    auto g = lock"
    "(&ch.state);\n    g.closed = true;\n    unsafe\n    {\n        event_op(3, ch.can_send, 0);\n        even"
    "t_op(3, ch.can_recv, 0);\n    }\n}unittest \"Channel::close: draining a closed channel\"\n{\n    Channel<i"
    "32> ch = Channel::new(2);\n    assert(Result::is_ok(&Channel::send(&ch, 1)));\n    assert(Result::is_o"
    "k(&Channel::send(&ch, 2)));\n    Channel::close(&ch);\n    assert(Result::is_err(&Channel::send(&ch, 3"
    ")));\n    assert(Option::unwrap(Channel::recv(&ch)) == 1);\n    assert(Option::unwrap(Channel::recv(&c"
    "h)) == 2);\n    assert(Option::is_none(&Channel::recv(&ch)));\n}export fn Channel::drop<T>(ref<Channel"
    "<T>, exclusive> self)\n{\n    {\n        auto g = lock(&self.state);\n        while (g.count > 0)\n      "
    "  {\n            Option<T> x = ChannelState::pop(&mut *g);\n            drop(x);\n        }\n    }\n    u"
    "nsafe\n    {\n        event_op(4, self.can_send, 0);\n        event_op(4, self.can_recv, 0);\n    }\n}exp"
    "ort fn try_join<R>(handle<R> h) : Result<R, ThreadFailure>\n{\n    u64 status = join_status(&h, 0);\n  "
    "  if (status == 1)\n    {\n        return Ok(join(h));\n    }\n    Err(ThreadFailure { .id = status - 2 "
    "})\n}unittest \"try_join: a contained fault\"\n{\n    Option<i32> none = None;\n    auto h = spawn(Option:"
    ":unwrap<i32>, none);\n    match (try_join(h))\n    {\n        Ok(_)  : assert(false),\n        Err(f) :\n"
    "        {\n            String d = ThreadFailure::diagnostic(&f);\n            assert(String::eq_str(&d"
    ", \"diag.unwrap-failed\"));\n            assert(!ThreadFailure::is_cancelled(&f));\n        },\n    }\n}ex"
    "port fn is_finished<R>(ref<handle<R>, shared> h) : bool\n{\n    join_status(h, 1) != 0\n}export fn Thre"
    "adFailure::text(ref<ThreadFailure, shared> f) : String\n{\n    failure_text(0, f.id)\n}export fn Thread"
    "Failure::diagnostic(ref<ThreadFailure, shared> f) : String\n{\n    failure_text(1, f.id)\n}export fn Th"
    "readFailure::is_cancelled(ref<ThreadFailure, shared> f) : bool\n{\n    String d = failure_text(1, f.id"
    ");\n    StringView::eq(String::as_view(&d), \"diag.thread-cancelled\")\n}fn failure_text(usize what, u64"
    " id) : String\n{\n    Vec<u8> out = Vec::new();\n    usize cap = 256;\n    while (true)\n    {\n        wh"
    "ile (out.cap < cap)\n        {\n            Vec::grow(&mut out);\n        }\n        isize n = unsafe\n  "
    "      {\n            task_op(what, narrow<usize>(id), reinterpret_ptr<u8>(out.ptr), cap)\n        };\n "
    "       usize len = reinterpret<usize>(n);\n        if (n >= 0 && len <= cap)\n        {\n            ou"
    "t.len = len;\n            return Result::unwrap(String::from_utf8(out));\n        }\n        cap = len;"
    "\n    }\n}export fn Atomic::new<T: integer>(T v) : Atomic<T>\n{\n    static_assert(sizeof<T>() <= 8, \"an"
    " Atomic holds an integer of at most 64 bits\");\n    Atomic { .atomic_value = v }\n}export fn Atomic::l"
    "oad<T: integer>(ref<Atomic<T>, shared> a) : T\n{\n    atomic_op(a, 0, 0, 0)\n}export fn Atomic::store<T"
    ": integer>(ref<Atomic<T>, shared> a, T v)\n{\n    _ = atomic_op(a, 1, v, 0);\n}export fn Atomic::swap<T"
    ": integer>(ref<Atomic<T>, shared> a, T v) : T\n{\n    atomic_op(a, 2, v, 0)\n}export fn Atomic::compare"
    "_exchange<T: integer>(ref<Atomic<T>, shared> a, T expected, T new) : Result<T, T>\n{\n    T found = at"
    "omic_op(a, 3, expected, new);\n    if (found == expected)\n    {\n        Ok(found)\n    }\n    else\n    "
    "{\n        Err(found)\n    }\n}export fn Atomic::fetch_add<T: integer>(ref<Atomic<T>, shared> a, T n) :"
    " T\n{\n    atomic_op(a, 4, n, 0)\n}export fn Atomic::fetch_sub<T: integer>(ref<Atomic<T>, shared> a, T "
