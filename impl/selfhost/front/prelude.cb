    " exclusive> k = &mut reclaim<RcBox<T>>(w.ptr).weak;\n        *k = *k + 1;\n    }\n    Weak { .ptr = w.p"
    "tr }\n}export fn Weak::drop<T>(ref<Weak<T>, exclusive> self)\n{\n    bool last = false;\n    unsafe\n    "
