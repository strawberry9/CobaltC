    "n == 0)\n        {\n            break;\n        }\n        any = true;\n        bytes.len = bytes.len + r"
    "einterpret<usize>(n);\n        if (bytes[bytes.len - 1] == 10)\n        {\n            Vec::pop(&mut by"
    "tes);\n            if (bytes.len > 0 && bytes[bytes.len - 1] == 13)\n            {\n                Vec"
    "::pop(&mut bytes);\n            }\n            break;\n        }\n    }\n    if (!any)\n    {\n        retu"
    "rn Ok(None);\n    }\n    match (String::from_utf8(bytes))\n    {\n        Ok(s)  : Ok(Some(s)),\n        "
    "Err(e) : Err(FileError::Utf8(e)),\n    }\n}export fn read_all_bytes() : Result<Vec<u8>, FileError>\n{\n "
    "   Vec<u8> out = Vec::new();\n    while (true)\n    {\n        while (out.cap - out.len < 65_536)\n     "
    "   {\n            Vec::grow(&mut out);\n        }\n        isize n = unsafe\n        {\n            stdin"
    "_read(reinterpret_ptr<u8>(out.ptr + reinterpret<isize>(out.len)), out.cap - out.len)\n        };\n    "
    "    if (n < 0)\n        {\n            return Err(FileError::Io);\n        }\n        if (n == 0)\n      "
    "  {\n            break;\n        }\n        out.len = out.len + reinterpret<usize>(n);\n    }\n    Ok(out"
    ")\n}export fn read_all() : Result<String, FileError>\n{\n    Vec<u8> b = read_all_bytes()?;\n    match ("
    "String::from_utf8(b))\n    {\n        Ok(s)  : Ok(s),\n        Err(e) : Err(FileError::Utf8(e)),\n    }\n"
    "}fn print_str(str s)\n{\n    unsafe\n    {\n        stdout_write(str_ptr(s), str_len(s));\n    }\n}fn prin"
    "t_string(ref<String, shared> s)\n{\n    unsafe\n    {\n        stdout_write(reinterpret_ptr<u8>(s.bytes."
    "ptr), s.bytes.len);\n    }\n}fn eprint_str(str s)\n{\n    unsafe\n    {\n        stderr_write(str_ptr(s), "
    "str_len(s));\n    }\n}export fn FileError::text(ref<FileError, shared> e) : str\n{\n    match (e)\n    {\n"
    "        NotFound : \"not found\",\n        Denied   : \"permission denied\",\n        Io       : \"input/ou"
    "tput error\",\n        Utf8(_)  : \"not UTF-8\",\n    }\n}export fn read_file(StringView path) : Result<St"
    "ring, FileError>\n{\n    rawptr<u8> p = StringView::ptr(path);\n    usize pn = StringView::len(path);\n "
    "   usize cap = 4096;\n    while (true)\n    {\n        rawptr<u8> buf = match (allocate(cap, 1))\n      "
    "  {\n            Ok(b)  : b,\n            Err(_) : fault(alloc_failure),\n        };\n        isize n = "
    "unsafe\n        {\n            file_read(p, pn, buf, cap)\n        };\n        if (n >= 0 && reinterpret"
    "<usize>(n) <= cap)\n        {\n            usize len = reinterpret<usize>(n);\n            Vec<u8> byte"
    "s = Vec::new();\n            usize i = 0;\n            while (i < len)\n            {\n                u"
    "8 b = unsafe\n                {\n                    *(buf + reinterpret<isize>(i))\n                };"
    "\n                Vec::push(&mut bytes, b);\n                i = i + 1;\n            }\n            unsa"
    "fe\n            {\n                deallocate(buf, cap, 1);\n            }\n            return match (St"
    "ring::from_utf8(bytes))\n            {\n                Ok(s)  : Ok(s),\n                Err(e) : Err(F"
    "ileError::Utf8(e)),\n            };\n        }\n        unsafe\n        {\n            deallocate(buf, ca"
    "p, 1);\n        }\n        if (n < 0)\n        {\n            return Err(file_error(n));\n        }\n     "
    "   // Longer than `cap`: again, with room for all of it.\n        cap = reinterpret<usize>(n);\n    }\n"
    "}export fn write_file(StringView path, StringView text) : Result<void, FileError>\n{\n    isize r = un"
    "safe\n    {\n        file_write(StringView::ptr(path), StringView::len(path), StringView::ptr(text), S"
    "tringView::len(text))\n    };\n    if (r < 0)\n    {\n        return Err(file_error(r));\n    }\n    Ok(()"
    ")\n}fn file_error_at(i64 code) : FileError\n{\n    if (code == -1)\n    {\n        return FileError::NotF"
    "ound;\n    }\n    if (code == -2)\n    {\n        return FileError::Denied;\n    }\n    FileError::Io\n}fn "
    "File::start(StringView path, usize mode) : Result<File, FileError>\n{\n    isize r = unsafe\n    {\n    "
    "    file_op(0, mode, StringView::ptr(path), StringView::len(path))\n    };\n    if (r < 0)\n    {\n     "
    "   return Err(file_error(r));\n    }\n    Ok(File { .id = reinterpret<usize>(r), .open = true })\n}expo"
    "rt fn File::open(StringView path) : Result<File, FileError>\n{\n    File::start(path, 0)\n}export fn Fi"
    "le::create(StringView path) : Result<File, FileError>\n{\n    File::start(path, 1)\n}export fn File::ap"
    "pend(StringView path) : Result<File, FileError>\n{\n    File::start(path, 2)\n}export fn File::open_rw("
    "StringView path) : Result<File, FileError>\n{\n    File::start(path, 3)\n}fn File::take(ref<File, exclu"
    "sive> f, ref<Vec<u8>, exclusive> buf, usize want) : Result<usize, FileError>\n{\n    while (buf.cap - "
    "buf.len < want)\n    {\n        Vec::grow(buf);\n    }\n    isize r = unsafe\n    {\n        file_op(3, f."
    "id, reinterpret_ptr<u8>(buf.ptr + reinterpret<isize>(buf.len)), want)\n    };\n    if (r < 0)\n    {\n  "
    "      return Err(file_error(r));\n    }\n    usize n = reinterpret<usize>(r);\n    buf.len = buf.len + "
    "n;\n    Ok(n)\n}export fn File::read(ref<File, exclusive> f, ref<Vec<u8>, exclusive> buf, usize max) :"
    " Result<usize, FileError>\n{\n    usize want = if (max > 1_048_576)\n    {\n        1_048_576\n    }\n    "
    "else\n    {\n        max\n    };\n    File::take(f, buf, want)\n}export fn File::read_to_end(ref<File, ex"
    "clusive> f, ref<Vec<u8>, exclusive> buf) : Result<usize, FileError>\n{\n    usize total = 0;\n    while"
    " (true)\n    {\n        usize n = match (File::read(f, buf, 65_536))\n        {\n            Ok(n)  : n,"
    "\n            Err(e) : return Err(e),\n        };\n        if (n == 0)\n        {\n            break;\n   "
    "     }\n        total = total + n;\n    }\n    Ok(total)\n}export fn File::read_line(ref<File, exclusive"
    "> f) : Result<Option<String>, FileError>\n{\n    isize r = unsafe\n    {\n        file_op(4, f.id, dangl"
    "ing<u8>(), 0)\n    };\n    if (r < 0)\n    {\n        return Err(file_error(r));\n    }\n    if (r == 0)\n "
    "   {\n        return Ok(None);\n    }\n    Vec<u8> bytes = Vec::new();\n    usize n = match (File::take("
    "f, &mut bytes, reinterpret<usize>(r)))\n    {\n        Ok(n)  : n,\n        Err(e) : return Err(e),\n   "
    " };\n    if (n > 0 && bytes[n - 1] == 10)\n    {\n        Vec::pop(&mut bytes);\n        if (n > 1 && by"
    "tes[n - 2] == 13)\n        {\n            Vec::pop(&mut bytes);\n        }\n    }\n    match (String::fro"
    "m_utf8(bytes))\n    {\n        Ok(s)  : Ok(Some(s)),\n        Err(e) : Err(FileError::Utf8(e)),\n    }\n}"
    "export fn File::write(ref<File, exclusive> f, slice<u8, shared> data) : Result<void, FileError>\n{\n  "
    "  usize n = slice_len(data);\n    if (n == 0)\n    {\n        return Ok(());\n    }\n    isize r = unsafe"
    "\n    {\n        file_op(5, f.id, rawptr_of(&data[0]), n)\n    };\n    if (r < 0)\n    {\n        return E"
    "rr(file_error(r));\n    }\n    Ok(())\n}export fn File::write_text(ref<File, exclusive> f, StringView t"
    "ext) : Result<void, FileError>\n{\n    File::write(f, text.bytes)\n}fn File::write_formatted(ref<File, "
    "exclusive> f, str text) : Result<void, FileError>\n{\n    usize n = str_len(text);\n    if (n == 0)\n   "
    " {\n        return Ok(());\n    }\n    isize r = unsafe\n    {\n        file_op(5, f.id, str_ptr(text), n"
    ")\n    };\n    if (r < 0)\n    {\n        return Err(file_error(r));\n    }\n    Ok(())\n}export fn File::s"
    "eek(ref<File, exclusive> f, u64 pos) : Result<void, FileError>\n{\n    i64 r = unsafe\n    {\n        fi"
    "le_at(6, f.id, pos)\n    };\n    if (r < 0)\n    {\n        return Err(file_error_at(r));\n    }\n    Ok(("
    "))\n}export fn File::len(ref<File, shared> f) : Result<u64, FileError>\n{\n    i64 r = unsafe\n    {\n   "
    "     file_at(7, f.id, 0)\n    };\n    if (r < 0)\n    {\n        return Err(file_error_at(r));\n    }\n   "
    " Ok(reinterpret<u64>(r))\n}export fn File::create_new(StringView path) : Result<Option<File>, FileErr"
    "or>\n{\n    isize r = unsafe\n    {\n        file_op(0, 4, StringView::ptr(path), StringView::len(path))"
    "\n    };\n    if (r == -4)\n    {\n        return Ok(None);\n    }\n    if (r < 0)\n    {\n        return Er"
    "r(file_error(r));\n    }\n    Ok(Some(File { .id = reinterpret<usize>(r), .open = true }))\n}export fn "
    "File::flush(ref<File, exclusive> f) : Result<void, FileError>\n{\n    isize r = unsafe\n    {\n        f"
    "ile_op(8, f.id, dangling<u8>(), 0)\n    };\n    if (r < 0)\n    {\n        return Err(file_error(r));\n  "
    "  }\n    Ok(())\n}export fn File::position(ref<File, shared> f) : Result<u64, FileError>\n{\n    i64 r ="
    " unsafe\n    {\n        file_at(9, f.id, 0)\n    };\n    if (r < 0)\n    {\n        return Err(file_error_"
    "at(r));\n    }\n    Ok(reinterpret<u64>(r))\n}export fn File::close(File f) : Result<void, FileError>\n{"
    "\n    f.open = false;\n    isize r = unsafe\n    {\n        file_op(1, f.id, dangling<u8>(), 0)\n    };\n "
    "   if (r < 0)\n    {\n        return Err(file_error(r));\n    }\n    Ok(())\n}export fn File::drop(ref<Fi"
    "le, exclusive> self)\n{\n    if (self.open)\n    {\n        isize r = unsafe\n        {\n            file_"
    "op(2, self.id, dangling<u8>(), 0)\n        };\n    }\n}export fn read_bytes(StringView path) : Result<V"
    "ec<u8>, FileError>\n{\n    File f = match (File::open(path))\n    {\n        Ok(f)  : f,\n        Err(e) "
    ": return Err(e),\n    };\n    Vec<u8> bytes = Vec::new();\n    match (File::read_to_end(&mut f, &mut by"
    "tes))\n    {\n        Ok(_)  : Ok(bytes),\n        Err(e) : Err(e),\n    }\n}export fn write_bytes(String"
    "View path, slice<u8, shared> data) : Result<void, FileError>\n{\n    File f = match (File::create(path"
    "))\n    {\n        Ok(f)  : f,\n        Err(e) : return Err(e),\n    };\n    File::write(&mut f, data)\n}f"
    "n fs_path_op(usize op, StringView a, StringView b) : isize\n{\n    unsafe\n    {\n        fs_op(op, Stri"
    "ngView::ptr(a), StringView::len(a), StringView::ptr(b), StringView::len(b))\n    }\n}export fn make_di"
    "r(StringView path) : Result<bool, FileError>\n{\n    isize r = fs_path_op(0, path, \"\");\n    if (r < 0)"
    "\n    {\n        return Err(file_error(r));\n    }\n    Ok(r == 1)\n}export fn remove_file(StringView pat"
    "h) : Result<void, FileError>\n{\n    isize r = fs_path_op(1, path, \"\");\n    if (r < 0)\n    {\n        r"
    "eturn Err(file_error(r));\n    }\n    Ok(())\n}export fn remove_dir(StringView path) : Result<void, Fil"
    "eError>\n{\n    isize r = fs_path_op(2, path, \"\");\n    if (r < 0)\n    {\n        return Err(file_error("
    "r));\n    }\n    Ok(())\n}export fn rename(StringView from, StringView to) : Result<void, FileError>\n{\n"
    "    isize r = fs_path_op(3, from, to);\n    if (r < 0)\n    {\n        return Err(file_error(r));\n    }"
    "\n    Ok(())\n}export fn list_dir(StringView path) : Result<Vec<String>, FileError>\n{\n    Vec<u8> all "
    "= match (fs_answer(0, StringView::ptr(path), StringView::len(path)))\n    {\n        Ok(b)  : b,\n     "
    "   Err(c) : return Err(file_error(c)),\n    };\n    Vec<String> names = Vec::new();\n    Vec<u8> name ="
    " Vec::new();\n    foreach (b in &all)\n    {\n        match (*b)\n        {\n            0 :\n            "
    "{\n                Vec<u8> done = replace(&mut name, Vec::new());\n                match (String::from"
    "_utf8(done))\n                {\n                    Ok(n)  : Vec::push(&mut names, n),\n              "
    "      Err(e) : return Err(FileError::Utf8(e)),\n                }\n            },\n            c : Vec:"
    ":push(&mut name, c),\n        }\n    }\n    Ok(names)\n}export fn path_kind(StringView path) : Result<Pa"
    "thKind, FileError>\n{\n    Vec<u8> b = match (fs_answer(1, StringView::ptr(path), StringView::len(path"
    ")))\n    {\n        Ok(b)  : b,\n        Err(c) : return Err(file_error(c)),\n    };\n    u64 len = 0;\n  "
    "  usize i = 8;\n    while (i > 0)\n    {\n        len = (len << 8) | widen<u64>(b[i]);\n        i -= 1;\n"
    "    }\n    match (b[0])\n    {\n        0 : Ok(File(len)),\n        1 : Ok(Dir),\n        _ : Ok(Other),\n"
    "    }\n}export fn path_join(StringView base, StringView tail) : String\n{\n    Option::unwrap_or(path_t"
    "ext(base, tail, 0), String::from_view(tail))\n}export fn path_parent(StringView p) : Option<String>\n{"
    "\n    path_text(p, \"\", 1)\n}export fn path_file_name(StringView p) : Option<String>\n{\n    path_text(p,"
    " \"\", 2)\n}export fn path_stem(StringView p) : Option<String>\n{\n    path_text(p, \"\", 3)\n}export fn pat"
    "h_extension(StringView p) : Option<String>\n{\n    path_text(p, \"\", 4)\n}export fn path_is_absolute(Str"
    "ingView p) : bool\n{\n    match (path_result(5, p, \"\"))\n    {\n        Ok(r)  : r == 1,\n        Err(_) "
    ": false,\n    }\n}export fn path_normalize(StringView p) : String\n{\n    Option::unwrap_or(path_text(p,"
    " \"\", 6), String::from_view(p))\n}export fn path_canonical(StringView p) : Result<String, FileError>\n{"
    "\n    Vec<u8> b = match (byte_answer(0, 7, 0, p.bytes, StringView::of(\"\").bytes))\n    {\n        Ok(b)"
    "  : b,\n        Err(c) : return Err(code_error(c)),\n    };\n    match (String::from_utf8(b))\n    {\n   "
    "     Ok(s)  : Ok(s),\n        Err(e) : Err(FileError::Utf8(e)),\n    }\n}export fn file_info(StringView"
    " path) : Result<FileInfo, FileError>\n{\n    Vec<u8> b = match (byte_answer(0, 8, 0, path.bytes, Strin"
    "gView::of(\"\").bytes))\n    {\n        Ok(b)  : b,\n        Err(c) : return Err(code_error(c)),\n    };\n "
    "   u64 len = read_le<u64>(&b[0..$], 1);\n    PathKind kind = match (b[0])\n    {\n        0 : File(len)"
    ",\n        1 : Dir,\n        _ : Other,\n    };\n    Ok(FileInfo { .kind = kind, .len = len, .modified_u"
    "nix = read_le<i64>(&b[0..$], 9), .readonly = b[17] != 0 })\n}export fn copy_file(StringView from, Str"
    "ingView to) : Result<u64, FileError>\n{\n    i64 n = path_result(9, from, to)?;\n    Ok(reinterpret<u64"
    ">(n))\n}export fn copy_permissions(StringView from, StringView to) : Result<void, FileError>\n{\n    pa"
    "th_result(17, from, to)?;\n    Ok(())\n}export fn make_dir_all(StringView path) : Result<void, FileErr"
    "or>\n{\n    path_result(10, path, \"\")?;\n    Ok(())\n}export fn remove_dir_all(StringView path) : Result"
    "<void, FileError>\n{\n    path_result(11, path, \"\")?;\n    Ok(())\n}export fn arg_count() : usize\n{\n    "
    "usize i = 0;\n    while (true)\n    {\n        isize n = unsafe\n        {\n            arg_bytes(i, dang"
    "ling<u8>(), 0)\n        };\n        if (n < 0)\n        {\n            break;\n        }\n        i = i + "
    "1;\n    }\n    i\n}export fn arg(usize i) : Result<String, Utf8Error>\n{\n    isize n = unsafe\n    {\n    "
    "    arg_bytes(i, dangling<u8>(), 0)\n    };\n    if (n < 0)\n    {\n        fault(index_out_of_bounds);\n"
    "    }\n    usize len = reinterpret<usize>(n);\n    rawptr<u8> p = match (allocate(len, 1))\n    {\n     "
    "   Ok(p)  : p,\n        Err(_) : fault(alloc_failure),\n    };\n    Vec<u8> bytes = Vec::new();\n    uns"
    "afe\n    {\n        arg_bytes(i, p, len);\n    }\n    usize j = 0;\n    while (j < len)\n    {\n        u8 "
    "b = unsafe\n        {\n            *(p + reinterpret<isize>(j))\n        };\n        Vec::push(&mut byte"
    "s, b);\n        j = j + 1;\n    }\n    if (len > 0)\n    {\n        unsafe\n        {\n            dealloca"
    "te(p, len, 1);\n        }\n    }\n    String::from_utf8(bytes)\n}export fn env_var(StringView name) : Re"
    "sult<Option<String>, Utf8Error>\n{\n    match (fs_answer(2, StringView::ptr(name), StringView::len(nam"
    "e)))\n    {\n        Ok(b) : match (String::from_utf8(b))\n        {\n            Ok(v)  : Ok(Some(v)),\n"
    "            Err(e) : Err(e),\n        },\n        Err(_) : Ok(None),\n    }\n}export fn current_dir() : "
    "Result<String, FileError>\n{\n    Vec<u8> b = match (fs_answer(3, dangling<u8>(), 0))\n    {\n        Ok"
    "(b)  : b,\n        Err(c) : return Err(file_error(c)),\n    };\n    match (String::from_utf8(b))\n    {\n"
    "        Ok(s)  : Ok(s),\n        Err(e) : Err(FileError::Utf8(e)),\n    }\n}export fn set_current_dir(S"
    "tringView path) : Result<void, FileError>\n{\n    path_result(12, path, \"\")?;\n    Ok(())\n}export fn te"
    "mp_dir() : String\n{\n    Option::unwrap_or(path_text(\"\", \"\", 13), String::new())\n}export fn home_dir("
    ") : Option<String>\n{\n    path_text(\"\", \"\", 14)\n}export fn current_exe() : Result<String, FileError>\n"
    "{\n    match (byte_answer(0, 15, 0, StringView::of(\"\").bytes, StringView::of(\"\").bytes))\n    {\n      "
    "  Ok(v) : match (String::from_utf8(v))\n        {\n            Ok(s)  : Ok(s),\n            Err(e) : Er"
    "r(FileError::Utf8(e)),\n        },\n        Err(c) : Err(code_error(c)),\n    }\n}export fn hostname() :"
    " Result<String, FileError>\n{\n    match (byte_answer(0, 16, 0, StringView::of(\"\").bytes, StringView::"
    "of(\"\").bytes))\n    {\n        Ok(v) : match (String::from_utf8(v))\n        {\n            Ok(s)  : Ok("
    "s),\n            Err(e) : Err(FileError::Utf8(e)),\n        },\n        Err(c) : Err(code_error(c)),\n  "
    "  }\n}export fn Args::new(StringView usage) : Result<Args, Utf8Error>\n{\n    Vec<String> items = Vec::"
    "new();\n    for (usize i = 0; i < arg_count(); i += 1)\n    {\n        Vec::push(&mut items, arg(i)?);\n"
    "    }\n    Ok(Args::from(items, usage))\n}export fn Args::from(Vec<String> items, StringView usage) : "
    "Args\n{\n    usize n = Vec::len(&items);\n    usize end = n;\n    for (usize i = 0; i < n; i += 1)\n    {"
    "\n        if (items[i] == \"--\")\n        {\n            end = i;\n            break;\n        }\n    }\n   "
    " Vec<bool> used = Vec::filled(n, false);\n    if (end < n)\n    {\n        used[end] = true;\n    }\n    "
    "Args { .usage = String::from_view(usage), .items = items, .used = used, .end_of_options = end, .spec"
    "s = Vec::new(), .helps = Vec::new() }\n}fn Args::is_option(ref<Args, shared> a, usize i, str name, st"
    "r short, bool with_value) : bool\n{\n    StringView item = String::as_view(&a.items[i]);\n    if (Some("
    "rest) = StringView::strip_prefix(item, \"--\"))\n    {\n        if (StringView::eq_str(rest, name))\n    "
    "    {\n            return true;\n        }\n        if (with_value)\n        {\n            if (Some(afte"
    "r) = StringView::strip_prefix(rest, StringView::of(name)))\n            {\n                return Stri"
    "ngView::starts_with(after, \"=\");\n            }\n        }\n        return false;\n    }\n    str_len(sho"
    "rt) > 0 && StringView::len(item) == 2 && item.bytes[0] == b'-' && item.bytes[1] == str_byte(short, 0"
    ")\n}fn Args::spec(ref<Args, exclusive> a, str name, str short, str value_name, str help)\n{\n    String"
    " spec = String::new();\n    if (str_len(short) > 0)\n    {\n        String::append(&mut spec, \"-\");\n   "
    "     String::append(&mut spec, short);\n        String::append(&mut spec, \", \");\n    }\n    else\n    {"
    "\n        String::append(&mut spec, \"    \");\n    }\n    String::append(&mut spec, \"--\");\n    String::a"
    "ppend(&mut spec, name);\n    if (str_len(value_name) > 0)\n    {\n        String::append(&mut spec, \" \""
    ");\n        String::append(&mut spec, value_name);\n    }\n    Vec::push(&mut a.specs, spec);\n    Vec::"
    "push(&mut a.helps, String::from_str(help));\n}export fn Args::flag(ref<Args, exclusive> a, str name, "
    "str short, str help) : bool\n{\n    Args::spec(a, name, short, \"\", help);\n    bool found = false;\n    "
    "for (usize i = 0; i < a.end_of_options; i += 1)\n    {\n        if (!a.used[i] && Args::is_option(a, i"
    ", name, short, false))\n        {\n            a.used[i] = true;\n            found = true;\n        }\n "
    "   }\n    found\n}export fn Args::options(ref<Args, exclusive> a, str name, str short, str value_name,"
    " str help) : Vec<String>\n{\n    Args::spec(a, name, short, value_name, help);\n    Vec<String> out = V"
    "ec::new();\n    for (usize i = 0; i < a.end_of_options; i += 1)\n    {\n        if (a.used[i] || !Args:"
    ":is_option(a, i, name, short, true))\n        {\n            continue;\n        }\n        StringView it"
    "em = String::as_view(&a.items[i]);\n        if (Some(eq) = StringView::find(item, \"=\"))\n        {\n   "
    "         if (StringView::starts_with(item, \"--\"))\n            {\n                a.used[i] = true;\n  "
    "              Vec::push(&mut out, String::from_view(StringView::sub(item, eq + 1, StringView::len(it"
    "em))));\n                continue;\n            }\n        }\n        // D-0232: an item another declara"
    "tion took is no value; the option\n        // is then left for `finish`, as one given without its val"
    "ue.\n        if (i + 1 < Vec::len(&a.items) && i + 1 != a.end_of_options && !a.used[i + 1])\n        {"
    "\n            a.used[i] = true;\n            a.used[i + 1] = true;\n            Vec::push(&mut out, Str"
    "ing::clone(&a.items[i + 1]));\n        }\n    }\n    out\n}export fn Args::option(ref<Args, exclusive> a"
    ", str name, str short, str value_name, str help) : Option<String>\n{\n    Vec<String> all = Args::opti"
    "ons(a, name, short, value_name, help);\n    Vec::pop(&mut all)\n}export fn Args::finish(ref<Args, excl"
    "usive> a) : Result<Vec<String>, String>\n{\n    Vec<String> out = Vec::new();\n    for (usize i = 0; i "
    "< Vec::len(&a.items); i += 1)\n    {\n        if (a.used[i])\n        {\n            continue;\n        }"
    "\n        StringView item = String::as_view(&a.items[i]);\n        if (i < a.end_of_options && StringV"
    "iew::len(item) > 1 && StringView::starts_with(item, \"-\"))\n        {\n            bool declared = fals"
    "e;\n            foreach (s in &a.specs)\n            {\n                // `-s, --name VALUE`: a declar"
    "ed option given without its\n                // value is one of its spec's words (`--ver` is not in\n "
    "               // `--verbose`'s).\n                foreach (w in StringView::split(String::as_view(s)"
    ", \" \"))\n                {\n                    StringView word = if (StringView::ends_with(w, \",\"))\n "
    "                   {\n                        &w[0 .. StringView::len(w) - 1]\n                    }\n "
    "                   else\n                    {\n                        w\n                    };\n     "
    "               if (word == item)\n                    {\n                        declared = true;\n    "
    "                }\n                }\n            }\n            String m = String::new();\n            "
    "String::append(&mut m, if (declared) { \"missing a value for \" } else { \"unknown option \" });\n       "
    "     String::append(&mut m, item);\n            return Err(m);\n        }\n        Vec::push(&mut out, "
    "String::clone(&a.items[i]));\n    }\n    Ok(out)\n}export fn Args::help(ref<Args, shared> a) : String\n{"
    "\n    String out = String::from_str(\"Usage: \");\n    String::append(&mut out, &a.usage);\n    String::a"
    "ppend(&mut out, \"\\n\");\n    if (Vec::len(&a.specs) == 0)\n    {\n        return out;\n    }\n    String::"
    "append(&mut out, \"\\nOptions:\\n\");\n    usize width = 0;\n    foreach (s in &a.specs)\n    {\n        wid"
    "th = max(width, String::len(s));\n    }\n    for (usize i = 0; i < Vec::len(&a.specs); i += 1)\n    {\n "
    "       String::append(&mut out, \"  \");\n        String::append(&mut out, &a.specs[i]);\n        for (u"
    "size k = String::len(&a.specs[i]); k < width + 2; k += 1)\n        {\n            String::append(&mut "
    "out, \" \");\n        }\n        String::append(&mut out, &a.helps[i]);\n        String::append(&mut out,"
    " \"\\n\");\n    }\n    out\n}export fn Rc::new<T>(T v) : Rc<T>\n{\n    rawptr<u8> p = match (allocate(sizeof"
    "<RcBox<T>>(), alignof<RcBox<T>>()))\n    {\n        Ok(p)  : p,\n        Err(_) : fault(alloc_failure),"
