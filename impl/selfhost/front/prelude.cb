    "ice<u8, shared> data)\n{\n    Sha512::update(&mut s.inner, data);\n}export fn Sha384::finish(Sha384 s) "
    ": array<u8, 48>\n{\n    Vec<u8> b = sha512_bytes(Sha512::final_words(s.inner), 6);\n    array<u8, 48> o"
    "ut = [0; 48];\n    for (usize i = 0; i < 48; i += 1)\n    {\n        out[i] = b[i];\n    }\n    out\n}expo"
