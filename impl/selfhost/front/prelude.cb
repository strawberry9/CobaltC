    " fe_add(x3, z3);\n        array<u64, 5> d = fe_sub(x3, z3);\n        array<u64, 5> da = fe_mul(d, a);\n"
    "        array<u64, 5> cb = fe_mul(c, b);\n        array<u64, 5> sum = fe_add(da, cb);\n        x3 = fe"
    "_mul(sum, sum);\n        array<u64, 5> diff = fe_sub(da, cb);\n        z3 = fe_mul(x1, fe_mul(diff, di"
    "ff));\n        x2 = fe_mul(aa, bb);\n        z2 = fe_mul(e, fe_add(aa, fe_mul(a24, e)));\n    }\n    fe_"
    "cswap(&mut x2, &mut x3, swap);\n    fe_cswap(&mut z2, &mut z3, swap);\n    fe_to_bytes(fe_mul(x2, fe_i"
    "nvert(z2)))\n}export fn x25519(slice<u8, shared> private_key, slice<u8, shared> public_key) : Option<"
    "array<u8, 32>>\n{\n    if (slice_len(private_key) != 32 || slice_len(public_key) != 32)\n    {\n        "
    "fault(crypto_length);\n    }\n    array<u8, 32> shared = x25519_ladder(private_key, public_key);\n    u"
    "8 acc = 0;\n    for (usize i = 0; i < 32; i += 1)\n    {\n        acc = acc | shared[i];\n    }\n    if ("
    "acc == 0)\n    {\n        return None;\n    }\n    Some(shared)\n}export fn x25519_public_key(slice<u8, s"
    "hared> private_key) : array<u8, 32>\n{\n    if (slice_len(private_key) != 32)\n    {\n        fault(cryp"
    "to_length);\n    }\n    array<u8, 32> base = [0; 32];\n    base[0] = 9;\n    x25519_ladder(private_key, "
    "&base[0..$])\n}export fn x25519_private_key() : array<u8, 32>\n{\n    array<u8, 32> k = [0; 32];\n    os"
    "_random_bytes(&mut k[0..$]);\n    k\n}fn rsa_open(ref<RsaPublicKey, shared> key, slice<u8, shared> sig"
    "nature, usize k) : Option<Vec<u8>>\n{\n    BigUint s = BigUint::from_bytes_be(signature);\n    if (!Big"
    "Uint::less(&s, &key.n))\n    {\n        return None;\n    }\n    BigUint m = BigUint::mod_pow(&s, &key.e"
    ", &key.n);\n    if (BigUint::bit_len(&m) > 8 * k)\n    {\n        return None;\n    }\n    Some(BigUint::"
    "to_bytes_be_padded(&m, k))\n}fn digest_info_prefix(HashKind kind) : Vec<u8>\n{\n    Result::unwrap_or(f"
    "rom_hex(match (kind)\n    {\n        Sha1     : \"3021300906052b0e03021a05000414\",\n        Sha2_256 : \""
    "3031300d060960864801650304020105000420\",\n        Sha2_384 : \"3041300d060960864801650304020205000430\""
    ",\n        Sha2_512 : \"3051300d060960864801650304020305000440\",\n    }), Vec::new())\n}export fn rsa_ve"
    "rify_pkcs1v15(\n    ref<RsaPublicKey, shared> key,\n    HashKind kind,\n    slice<u8, shared> digest,\n "
