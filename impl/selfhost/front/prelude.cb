    "; 128], .fill = 0, .length = 0 } }\n}export fn Sha384::update(ref<Sha384, exclusive> s, slice<u8, sha"
    "red> data)\n{\n    Sha512::update(&mut s.inner, data);\n}export fn Sha384::finish(Sha384 s) : array<u8,"
    " 48>\n{\n    Vec<u8> b = sha512_bytes(Sha512::final_words(s.inner), 6);\n    array<u8, 48> out = [0; 48"
    "];\n    for (usize i = 0; i < 48; i += 1)\n    {\n        out[i] = b[i];\n    }\n    out\n}export fn sha38"
    "4(slice<u8, shared> data) : array<u8, 48>\n{\n    Sha384 s = Sha384::new();\n    Sha384::update(&mut s,"
    " data);\n    Sha384::finish(s)\n}export fn Sha1::new() : Sha1\n{\n    Sha1 { .h = [0x67452301, 0xEFCDAB8"
