    "      }\n        if (i + 4 < n || pad < 1)\n        {\n            Vec::push(&mut out, narrow_wrapping<"
    "u8>(v));\n        }\n    }\n    Ok(out)\n}fn tnode_new(String key, u8 kind, Toml leaf) : TNode\n{\n    TNo"
    "de { .key = key, .kind = kind, .leaf = leaf, .members = Vec::new() }\n}fn tnode_find(ref<Vec<TNode>, "
    "shared> members, StringView key) : Option<usize>\n{\n    for (usize i = 0; i < Vec::len(members); i +="
    " 1)\n    {\n        if (members[i].key == key)\n        {\n            return Some(i);\n        }\n    }\n "
    "   None\n}fn tnode_define(ref<TNode, exclusive> n, ref<Vec<String>, shared> path, usize i, bool is_ar"
    "ray) : bool\n{\n    StringView part = &path[i];\n    bool last = i + 1 == Vec::len(path);\n    usize k ="
    " match (tnode_find(&n.members, part))\n    {\n        Some(k) : k,\n        None    :\n        {\n       "
    "     if (last && is_array)\n            {\n                TNode arr = tnode_new(String::copy(part), K"
    "_ARRAY, TomlBool(false));\n                Vec::push(&mut arr.members, tnode_new(String::new(), K_HEA"
    "DER, TomlBool(false)));\n                Vec::push(&mut n.members, arr);\n                return true;"
