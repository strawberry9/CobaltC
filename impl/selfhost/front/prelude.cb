    "26;\n        h2 += (t[2] >> 4) & m26;\n        h3 += (t[3] >> 6) & m26;\n        h4 += (t[4] >> 8) | hi"
    "bit;\n        u64 d0 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1;\n        u64 d1 = h0 * r1 + h1"
