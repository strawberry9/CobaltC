    "ch)\n        {\n            0 : path_op(op, h, a, an, b, bn, out, cap),\n            1 : proc_op(op, h,"
    " a, an, b, bn, out, cap),\n            _ : net_op(op, h, a, an, b, bn, out, cap),\n        }\n    }\n}fn"
    " byte_answer(usize which, usize op, usize h, slice<u8, shared> a, slice<u8, shared> b) : Result<Vec<"
    "u8>, i64>\n{\n    Vec<u8> out = Vec::new();\n    usize cap = 256;\n    while (true)\n    {\n        while "
    "(out.cap < cap)\n        {\n            Vec::grow(&mut out);\n        }\n        i64 n = byte_op(\n      "
    "      which,\n            op,\n            h,\n            bytes_ptr(a),\n            slice_len(a),\n    "
    "        bytes_ptr(b),\n            slice_len(b),\n            reinterpret_ptr<u8>(out.ptr),\n          "
    "  cap,\n        );\n        if (n < 0)\n        {\n            return Err(n);\n        }\n        usize le"
    "n = reinterpret<usize>(n);\n        if (len <= cap)\n        {\n            out.len = len;\n            "
    "return Ok(out);\n        }\n        cap = len;\n    }\n}fn bytes_ptr(slice<u8, shared> s) : rawptr<u8>\n{"
    "\n    if (slice_len(s) == 0)\n    {\n        return dangling<u8>();\n    }\n    rawptr_of(&s[0])\n}fn code"
    "_error(i64 code) : FileError\n{\n    if (code == -1)\n    {\n        return FileError::NotFound;\n    }\n "
    "   if (code == -2)\n    {\n        return FileError::Denied;\n    }\n    FileError::Io\n}fn file_error(is"
    "ize code) : FileError\n{\n    if (code == -1)\n    {\n        return FileError::NotFound;\n    }\n    if ("
    "code == -2)\n    {\n        return FileError::Denied;\n    }\n    FileError::Io\n}fn fs_answer(usize op, "
    "rawptr<u8> a, usize an) : Result<Vec<u8>, isize>\n{\n    Vec<u8> out = Vec::new();\n    usize cap = 256"
    ";\n    while (true)\n    {\n        while (out.cap < cap)\n        {\n            Vec::grow(&mut out);\n  "
    "      }\n        isize n = unsafe\n        {\n            fs_query(op, a, an, reinterpret_ptr<u8>(out.p"
    "tr), cap)\n        };\n        if (n < 0)\n        {\n            return Err(n);\n        }\n        usize"
    " len = reinterpret<usize>(n);\n        if (len <= cap)\n        {\n            out.len = len;\n         "
    "   return Ok(out);\n        }\n        cap = len;\n    }\n}fn path_text(StringView a, StringView b, usiz"
    "e op) : Option<String>\n{\n    match (byte_answer(0, op, 0, a.bytes, b.bytes))\n    {\n        Ok(v) : m"
    "atch (String::from_utf8(v))\n        {\n            Ok(s)  : Some(s),\n            Err(_) : None,\n     "
    "   },\n        Err(_) : None,\n    }\n}fn path_result(usize op, StringView a, StringView b) : Result<i6"
    "4, FileError>\n{\n    i64 r = byte_op(\n        0,\n        op,\n        0,\n        StringView::ptr(a),\n "
