    "= 0; k < 255; k += 1)\n    {\n        usize i = 254 - k;\n        r = fe_mul(r, r);\n        if (i >= 5 "
    "|| i == 3 || i == 1 || i == 0)\n        {\n            r = fe_mul(r, z);\n        }\n    }\n    r\n}fn fe_"
