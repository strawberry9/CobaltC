    "(v.len < 2)\n    {\n        return;\n    }\n    Vec<usize> order = Vec::sorted_order_keys(v);\n    Vec::a"
    "pply_order(v, &order);\n}export fn Vec::binary_search_by<T>(\n    ref<Vec<T>, shared> v,\n    ref<T, sh"
    "ared> key,\n    fn(ref<T, shared>, ref<T, shared>) : bool less,\n) : Result<usize, usize>\n{\n    usize "
    "lo = 0;\n    usize hi = v.len;\n    while (lo < hi)\n    {\n        usize mid = lo + (hi - lo) / 2;\n    "
    "    if (less(Vec::index_shared(v, mid), key))\n        {\n            lo = mid + 1;\n        }\n        "
    "else\n        {\n            hi = mid;\n        }\n    }\n    if (lo < v.len && !less(key, Vec::index_sha"
    "red(v, lo)))\n    {\n        return Ok(lo);\n    }\n    Err(lo)\n}export fn Vec::binary_search<T>(ref<Vec"
    "<T>, shared> v, ref<T, shared> key) : Result<usize, usize>\n{\n    Vec::binary_search_by(v, key, key_b"
    "efore<T>)\n}unittest \"Vec::binary_search: found and missing\"\n{\n    Vec<i32> v = Vec::new();\n    Vec::"
    "push(&mut v, 10);\n    Vec::push(&mut v, 20);\n    Vec::push(&mut v, 20);\n    Vec::push(&mut v, 30);\n "
    "   i32 present = 20;\n    i32 absent = 25;\n    assert(Result::unwrap_or(Vec::binary_search(&v, &prese"
    "nt), 99) == 1);\n    match (Vec::binary_search(&v, &absent))\n    {\n        Ok(_)  : assert(false),\n  "
    "      Err(i) : assert(i == 3),\n    }\n}fn Vec::replace<T>(ref<Vec<T>, exclusive> v, usize i, T x) : T"
    "\n{\n    if (i >= v.len)\n    {\n        fault(index_out_of_bounds);\n    }\n    unsafe\n    {\n        rawp"
    "tr<T> p = v.ptr + reinterpret<isize>(i);\n        auto old = *p;\n        release(reinterpret_ptr<u8>("
    "p), sizeof<T>());\n        *p = x;\n        old\n    }\n}fn Vec::remove_at<T>(ref<Vec<T>, exclusive> v, "
    "usize i) : T\n{\n    if (i >= v.len)\n    {\n        fault(index_out_of_bounds);\n    }\n    Vec<T> later "
    "= Vec::new();\n    while (v.len > i + 1)\n    {\n        match (Vec::pop(v))\n        {\n            Some"
    "(x) :\n            {\n                Vec::push(&mut later, x);\n            },\n            None    :\n "
    "           {\n            },\n        }\n    }\n    auto taken = match (Vec::pop(v))\n    {\n        Some("
    "x) : x,\n        None    : fault(index_out_of_bounds),\n    };\n    while (Vec::len(&later) > 0)\n    {\n"
    "        match (Vec::pop(&mut later))\n        {\n            Some(x) :\n            {\n                V"
    "ec::push(v, x);\n            },\n            None    :\n            {\n            },\n        }\n    }\n  "
    "  taken\n}fn Vec::take_raw<T>(ref<Vec<T>, exclusive> v, usize i) : T\n{\n    unsafe\n    {\n        rawpt"
    "r<T> p = v.ptr + reinterpret<isize>(i);\n        auto x = *p;\n        release(reinterpret_ptr<u8>(p),"
    " sizeof<T>());\n        x\n    }\n}export fn Vec::clear<T>(ref<Vec<T>, exclusive> v)\n{\n    usize i = 0;"
    "\n    while (i < v.len)\n    {\n        drop(Vec::take_raw(v, i));\n        i = i + 1;\n    }\n    v.len ="
    " 0;\n}fn Vec::drain<T>(Vec<T> v) : Drain<T>\n{\n    Drain { .v = v, .next = 0 }\n}fn Drain::total<T>(ref"
    "<Drain<T>, shared> d) : usize\n{\n    d.v.len\n}fn Drain::take<T>(ref<Drain<T>, exclusive> d) : T\n{\n   "
    " auto x = Vec::take_raw(&mut d.v, d.next);\n    d.next = d.next + 1;\n    x\n}fn Drain::drop<T>(ref<Dra"
    "in<T>, exclusive> self)\n{\n    while (self.next < self.v.len)\n    {\n        drop(Vec::take_raw(&mut s"
    "elf.v, self.next));\n        self.next = self.next + 1;\n    }\n    self.v.len = 0;                 // "
    "every element is gone: the Vec frees only its buffer\n}export fn Vec::insert<T>(ref<Vec<T>, exclusive"
    "> v, usize i, T x)\n{\n    if (i > v.len)\n    {\n        fault(index_out_of_bounds);\n    }\n    Vec::pus"
    "h(v, x);\n    usize k = v.len - 1;\n    while (k > i)\n    {\n        Vec::swap(v, k - 1, k);\n        k "
    "= k - 1;\n    }\n}unittest \"Vec::insert: middle and end\"\n{\n    Vec<i32> v = Vec::new();\n    Vec::push("
    "&mut v, 1);\n    Vec::push(&mut v, 3);\n    Vec::insert(&mut v, 1, 2);\n    Vec::insert(&mut v, 3, 4);\n"
    "    assert(Vec::len(&v) == 4);\n    assert(v[0] == 1 && v[1] == 2 && v[2] == 3 && v[3] == 4);\n}export"
    " fn Vec::remove<T>(ref<Vec<T>, exclusive> v, usize i) : T\n{\n    if (i >= v.len)\n    {\n        fault("
    "index_out_of_bounds);\n    }\n    usize k = i;\n    while (k + 1 < v.len)\n    {\n        Vec::swap(v, k,"
    " k + 1);\n        k = k + 1;\n    }\n    match (Vec::pop(v))\n    {\n        Some(x) : x,\n        None   "
    " : fault(index_out_of_bounds),\n    }\n}export fn Vec::swap_remove<T>(ref<Vec<T>, exclusive> v, usize "
    "i) : T\n{\n    if (i >= v.len)\n    {\n        fault(index_out_of_bounds);\n    }\n    usize last = v.len "
    "- 1;\n    Vec::swap(v, i, last);\n    match (Vec::pop(v))\n    {\n        Some(x) : x,\n        None    :"
    " fault(index_out_of_bounds),\n    }\n}unittest \"Vec::swap_remove: order not kept\"\n{\n    Vec<i32> a = V"
    "ec::new();\n    Vec::push(&mut a, 1);\n    Vec::push(&mut a, 2);\n    Vec::push(&mut a, 3);\n    Vec::pu"
    "sh(&mut a, 4);\n    Vec<i32> b = Vec::clone(&a);\n    assert(Vec::remove(&mut a, 0) == 1);\n    assert("
    "a[0] == 2 && a[1] == 3 && a[2] == 4);\n    assert(Vec::swap_remove(&mut b, 0) == 1);\n    assert(b[0] "
    "== 4 && b[1] == 2 && b[2] == 3);\n}export fn Vec::clone<T: clone>(ref<Vec<T>, shared> v) : Vec<T>\n{\n "
    "   Vec<T> out = Vec::new();\n    for (usize i = 0; i < v.len; i += 1)\n    {\n        Vec::push(&mut ou"
    "t, clone(Vec::index_shared(v, i)));\n    }\n    out\n}export fn Vec::from_slice<T: clone>(slice<T, shar"
    "ed> s) : Vec<T>\n{\n    Vec<T> out = Vec::new();\n    Vec::reserve(&mut out, slice_len(s));\n    for (us"
    "ize i = 0; i < slice_len(s); i += 1)\n    {\n        Vec::push(&mut out, clone(&s[i]));\n    }\n    out\n"
    "}export fn Vec::truncate<T>(ref<Vec<T>, exclusive> v, usize n)\n{\n    while (v.len > n)\n    {\n       "
    " drop(Vec::pop(v));\n    }\n}unittest \"Vec::truncate: beyond the end\"\n{\n    Vec<i32> v = Vec::filled(3"
    ", 7);\n    Vec::truncate(&mut v, 10);\n    assert(Vec::len(&v) == 3);\n    Vec::truncate(&mut v, 1);\n  "
    "  assert(Vec::len(&v) == 1);\n}export fn Vec::clone_by<T>(ref<Vec<T>, shared> v, fn(ref<T, shared>) :"
    " T copy) : Vec<T>\n{\n    Vec<T> out = Vec::new();\n    for (usize i = 0; i < v.len; i += 1)\n    {\n    "
    "    Vec::push(&mut out, copy(Vec::index_shared(v, i)));\n    }\n    out\n}export fn Vec::filled<T: clon"
    "e>(usize n, T x) : Vec<T>\n{\n    Vec<T> out = Vec::new();\n    for (usize i = 0; i < n; i += 1)\n    {\n"
    "        Vec::push(&mut out, clone(&x));\n    }\n    out\n}export fn Vec::from_raw<T: plain>(rawptr<T> p"
    ", usize n) : Vec<T>\n{\n    if (n > 0 && p == null_rawptr<T>())\n    {\n        fault(null_pointer);\n   "
    " }\n    Vec<T> out = Vec::new();\n    Vec::reserve(&mut out, n);\n    // trusted: [Copy-Raw] of n * siz"
    "eof<T>() bytes from `p`, the caller's assertion in its `unsafe` that the n elements at `p` are reada"
    "ble and stay put (a [Trusted-Call], spec/20 §1), into the range `Vec::reserve` just allocated, fres"
    "h and overlapping nothing live; T is `plain`, so the bytes are the elements.\n    unsafe\n    {\n      "
    "  copy_raw(reinterpret_ptr<u8>(out.ptr), reinterpret_ptr<u8>(p), n * sizeof<T>());\n    }\n    out.len"
    " = n;\n    out\n}export fn Vec::from_c_bytes(rawptr<u8> p) : Vec<u8>\n{\n    if (p == null_rawptr<u8>())"
    "\n    {\n        fault(null_pointer);\n    }\n    usize n = 0;\n    while (true)\n    {\n        u8 b = uns"
    "afe\n        {\n            *(p + reinterpret<isize>(n))\n        };\n        if (b == 0)\n        {\n    "
    "        break;\n        }\n        n += 1;\n    }\n    Vec<u8> out = Vec::new();\n    Vec::reserve(&mut o"
    "ut, n);\n    unsafe\n    {\n        copy_raw(reinterpret_ptr<u8>(out.ptr), p, n);\n    }\n    out.len = n"
    ";\n    out\n}export fn Vec::from_fn<T>(usize n, fn(usize) : T f) : Vec<T>\n{\n    Vec<T> out = Vec::new("
    ");\n    for (usize i = 0; i < n; i += 1)\n    {\n        Vec::push(&mut out, f(i));\n    }\n    out\n}unit"
    "test \"Vec::from_fn: with retain\"\n{\n    Vec<i32> v = Vec::from_fn(6, [](usize i) : i32 { narrow<i32>("
    "i) });\n    Vec::retain(&mut v, [](ref<i32, shared> x) : bool { *x % 2 == 0 });\n    assert(Vec::len(&"
    "v) == 3);\n    assert(v[0] == 0 && v[1] == 2 && v[2] == 4);\n}export fn Vec::append<T>(ref<Vec<T>, exc"
    "lusive> a, Vec<T> b)\n{\n    foreach (x in b)\n    {\n        Vec::push(a, x);\n    }\n}export fn Vec::ext"
    "end_from<T: clone>(ref<Vec<T>, exclusive> a, slice<T, shared> s)\n{\n    for (usize i = 0; i < slice_l"
    "en(s); i += 1)\n    {\n        Vec::push(a, clone(&s[i]));\n    }\n}export fn Vec::position<T>(ref<Vec<T"
    ">, shared> v, fn(ref<T, shared>) : bool p) : Option<usize>\n{\n    for (usize i = 0; i < v.len; i += 1"
    ")\n    {\n        if (p(Vec::index_shared(v, i)))\n        {\n            return Some(i);\n        }\n    "
    "}\n    None\n}unittest \"Vec::position: first match\"\n{\n    Vec<i32> v = Vec::new();\n    Vec::push(&mut "
    "v, 4);\n    Vec::push(&mut v, 9);\n    Vec::push(&mut v, 6);\n    assert(Option::unwrap(Vec::position(&"
    "v, [](ref<i32, shared> x) : bool { *x > 5 })) == 1);\n    i32 six = 6;\n    assert(Option::unwrap(Vec:"
    ":index_of(&v, &six)) == 2);\n    assert(Option::is_none(&Vec::position(&v, [](ref<i32, shared> x) : b"
    "ool { *x > 9 })));\n}export fn slice_eq<T: eq>(slice<T, shared> a, slice<T, shared> b) : bool\n{\n    i"
    "f (slice_len(a) != slice_len(b))\n    {\n        return false;\n    }\n    for (usize i = 0; i < slice_l"
    "en(a); i += 1)\n    {\n        if (!(a[i] == b[i]))\n        {\n            return false;\n        }\n    "
    "}\n    true\n}unittest \"slice_eq: Vec and array\"\n{\n    Vec<u8> v = Vec::new();\n    Vec::push(&mut v, 1"
    ");\n    Vec::push(&mut v, 2);\n    array<u8, 2> a = [1, 2];\n    assert(slice_eq(&v[0..$], &a[0..$]));\n"
    "    assert(!slice_eq(&v[0..1], &a[0..$]));\n}export fn Vec::index_of<T: eq>(ref<Vec<T>, shared> v, re"
    "f<T, shared> x) : Option<usize>\n{\n    for (usize i = 0; i < v.len; i += 1)\n    {\n        if (*Vec::i"
    "ndex_shared(v, i) == *x)\n        {\n            return Some(i);\n        }\n    }\n    None\n}export fn V"
    "ec::contains<T: eq>(ref<Vec<T>, shared> v, ref<T, shared> x) : bool\n{\n    match (Vec::index_of(v, x)"
    ")\n    {\n        Some(_) : true,\n        None    : false,\n    }\n}export fn Vec::reverse<T>(ref<Vec<T>"
    ", exclusive> v)\n{\n    usize n = v.len;\n    for (usize i = 0; i < n / 2; i += 1)\n    {\n        Vec::s"
    "wap(v, i, n - 1 - i);\n    }\n}export fn Vec::retain<T>(ref<Vec<T>, exclusive> v, fn(ref<T, shared>) :"
    " bool keep)\n{\n    usize w = 0;\n    for (usize i = 0; i < v.len; i += 1)\n    {\n        if (keep(Vec::"
    "index_shared(v, i)))\n        {\n            if (w != i)\n            {\n                Vec::swap(v, w,"
    " i);\n            }\n            w += 1;\n        }\n    }\n    Vec::truncate(v, w);\n}export fn Vec::dedu"
    "p<T: eq>(ref<Vec<T>, exclusive> v)\n{\n    if (v.len < 2)\n    {\n        return;\n    }\n    usize w = 1;"
    "\n    for (usize i = 1; i < v.len; i += 1)\n    {\n        if (!(*Vec::index_shared(v, i) == *Vec::inde"
    "x_shared(v, w - 1)))\n        {\n            if (w != i)\n            {\n                Vec::swap(v, w,"
    " i);\n            }\n            w += 1;\n        }\n    }\n    Vec::truncate(v, w);\n}unittest \"Vec::dedu"
    "p: adjacent only\"\n{\n    Vec<i32> v = Vec::new();\n    Vec::push(&mut v, 1);\n    Vec::push(&mut v, 1);"
    "\n    Vec::push(&mut v, 2);\n    Vec::push(&mut v, 1);\n    Vec::dedup(&mut v);\n    assert(Vec::len(&v)"
    " == 3);\n    assert(v[0] == 1 && v[1] == 2 && v[2] == 1);\n}export fn Vec::swap<T>(ref<Vec<T>, exclusi"
    "ve> v, usize i, usize j)\n{\n    if (i >= v.len || j >= v.len)\n    {\n        fault(index_out_of_bounds"
    ");\n    }\n    if (i != j)\n    {\n        swap_places(&mut (*v)[i], &mut (*v)[j]);\n    }\n}export fn Has"
    "hMap::new<K, V>() : HashMap<K, V>\n{\n    Vec<usize> slots = Vec::new();\n    usize i = 0;\n    while (i"
    " < 8)\n    {\n        Vec::push(&mut slots, max_value<usize>());\n        i = i + 1;\n    }\n    HashMap "
    "{ .keys = Vec::new(), .values = Vec::new(), .slots = slots }\n}export fn HashMap::clone<K: clone, V: "
    "clone>(ref<HashMap<K, V>, shared> m) : HashMap<K, V>\n{\n    HashMap<K, V> out = HashMap::new();\n    f"
    "or (usize i = 0; i < Vec::len(&m.keys); i += 1)\n    {\n        HashMap::insert(&mut out, clone(Vec::i"
    "ndex_shared(&m.keys, i)), clone(Vec::index_shared(&m.values, i)));\n    }\n    out\n}export fn HashMap:"
    ":clear<K, V>(ref<HashMap<K, V>, exclusive> m)\n{\n    Vec::clear(&mut m.values);\n    Vec::clear(&mut m"
    ".keys);\n    Vec::clear(&mut m.slots);\n    usize i = 0;\n    while (i < 8)\n    {\n        Vec::push(&mu"
    "t m.slots, max_value<usize>());\n        i = i + 1;\n    }\n}export fn HashMap::len<K, V>(ref<HashMap<K"
    ", V>, shared> m) : usize\n{\n    Vec::len(&m.keys)\n}export fn HashMap::key_at<K, V>(ref<HashMap<K, V>,"
    " shared> m, usize i) : ref<K, shared>\n{\n    Vec::index_shared(&m.keys, i)\n}export fn HashMap::value_"
    "at<K, V>(ref<HashMap<K, V>, shared> m, usize i) : ref<V, shared>\n{\n    Vec::index_shared(&m.values, "
    "i)\n}fn HashMap::find<K, V>(ref<HashMap<K, V>, shared> m, ref<K, shared> k) : usize\n{\n    usize mask "
    "= Vec::len(&m.slots) - 1;\n    usize i = narrow_wrapping<usize>(key_hash(k)) & mask;\n    bool searchi"
    "ng = true;\n    while (searching)\n    {\n        usize e = *Vec::index_shared(&m.slots, i);\n        if"
    " (e == max_value<usize>())\n        {\n            searching = false;\n        }\n        else if (key_e"
    "q(Vec::index_shared(&m.keys, e), k))\n        {\n            searching = false;\n        }\n        else"
    "\n        {\n            i = (i + 1) & mask;\n        }\n    }\n    i\n}fn HashMap::index_of<K, V>(ref<Has"
    "hMap<K, V>, shared> m, ref<K, shared> k) : usize\n{\n    *Vec::index_shared(&m.slots, HashMap::find(m,"
    " k))\n}fn HashMap::reslot<K, V>(ref<HashMap<K, V>, exclusive> m, usize n)\n{\n    usize old = Vec::len("
    "&m.slots);\n    usize i = 0;\n    while (i < n)\n    {\n        if (i < old)\n        {\n            *Vec:"
    ":index_exclusive(&mut m.slots, i) = max_value<usize>();\n        }\n        else\n        {\n           "
    " Vec::push(&mut m.slots, max_value<usize>());\n        }\n        i = i + 1;\n    }\n    usize e = 0;\n  "
    "  while (e < Vec::len(&m.keys))\n    {\n        usize s = HashMap::find(&*m, Vec::index_shared(&m.keys"
    ", e));\n        *Vec::index_exclusive(&mut m.slots, s) = e;\n        e = e + 1;\n    }\n}fn HashMap::res"
    "erve_one<K, V>(ref<HashMap<K, V>, exclusive> m)\n{\n    usize n = Vec::len(&m.slots);\n    if ((Vec::le"
    "n(&m.keys) + 1) * 4 > n * 3)\n    {\n        HashMap::reslot(m, n * 2);\n    }\n}export fn HashMap::inse"
    "rt<K, V>(ref<HashMap<K, V>, exclusive> m, K k, V v) : Option<V>\n{\n    HashMap::reserve_one(m);\n    u"
    "size s = HashMap::find(&*m, &k);\n    usize e = *Vec::index_shared(&m.slots, s);\n    if (e == max_val"
    "ue<usize>())\n    {\n        *Vec::index_exclusive(&mut m.slots, s) = Vec::len(&m.keys);\n        Vec::"
    "push(&mut m.keys, k);\n        Vec::push(&mut m.values, v);\n        return None;\n    }\n    Some(Vec::"
    "replace(&mut m.values, e, v))\n}unittest \"HashMap::insert: replacing a value\"\n{\n    HashMap<i32, i32>"
    " m = HashMap::new();\n    HashMap::insert(&mut m, 5, 50);\n    HashMap::insert(&mut m, 7, 70);\n    ass"
    "ert(Option::unwrap(HashMap::insert(&mut m, 5, 55)) == 50);\n    assert(HashMap::len(&m) == 2);\n    as"
    "sert(*HashMap::key_at(&m, 0) == 5 && *HashMap::value_at(&m, 0) == 55);\n}export fn HashMap::entry<K, "
    "V>(ref<HashMap<K, V>, exclusive> m, K k, V fresh) : ref<V, exclusive>\n{\n    HashMap::reserve_one(m);"
    "\n    usize s = HashMap::find(&*m, &k);\n    usize e = *Vec::index_shared(&m.slots, s);\n    if (e == m"
    "ax_value<usize>())\n    {\n        e = Vec::len(&m.keys);\n        *Vec::index_exclusive(&mut m.slots, "
    "s) = e;\n        Vec::push(&mut m.keys, k);\n        Vec::push(&mut m.values, fresh);\n    }\n    Vec::i"
    "ndex_exclusive(&mut m.values, e)\n}unittest \"HashMap::entry: counting\"\n{\n    HashMap<i32, i32> counts"
    " = HashMap::new();\n    Vec<i32> words = Vec::new();\n    Vec::push(&mut words, 3);\n    Vec::push(&mut"
    " words, 1);\n    Vec::push(&mut words, 3);\n    foreach (w in &words)\n    {\n        *HashMap::entry(&m"
    "ut counts, *w, 0) += 1;\n    }\n    i32 three = 3;\n    assert(*Option::unwrap(HashMap::get(&counts, &t"
    "hree)) == 2);\n}export fn HashMap::get<K, V>(ref<HashMap<K, V>, shared> m, ref<K, shared> k) : Option"
    "<ref<V, shared>>\n{\n    usize e = HashMap::index_of(m, k);\n    if (e == max_value<usize>())\n    {\n   "
    "     return None;\n    }\n    Some(Vec::index_shared(&m.values, e))\n}export fn HashMap::get_mut<K, V>("
    "ref<HashMap<K, V>, exclusive> m, ref<K, shared> k) : Option<ref<V, exclusive>>\n{\n    usize e = HashM"
    "ap::index_of(&*m, k);\n    if (e == max_value<usize>())\n    {\n        return None;\n    }\n    Some(Vec"
    "::index_exclusive(&mut m.values, e))\n}export fn HashMap::contains<K, V>(ref<HashMap<K, V>, shared> m"
    ", ref<K, shared> k) : bool\n{\n    HashMap::index_of(m, k) != max_value<usize>()\n}fn HashMap::unslot<K"
    ", V>(ref<HashMap<K, V>, exclusive> m, usize s)\n{\n    usize mask = Vec::len(&m.slots) - 1;\n    usize "
    "i = s;\n    usize j = s;\n    bool shifting = true;\n    while (shifting)\n    {\n        j = (j + 1) & m"
    "ask;\n        usize e = *Vec::index_shared(&m.slots, j);\n        if (e == max_value<usize>())\n       "
    " {\n            shifting = false;\n        }\n        else\n        {\n            usize home = narrow_wr"
    "apping<usize>(key_hash(Vec::index_shared(&m.keys, e))) & mask;\n            // The entry in j may mov"
    "e back to i unless its home lies in (i, j], cyclically.\n            bool stays = if (i <= j)\n       "
    "     {\n                home > i && home <= j\n            }\n            else\n            {\n          "
    "      home > i || home <= j\n            };\n            if (!stays)\n            {\n                *Ve"
    "c::index_exclusive(&mut m.slots, i) = e;\n                i = j;\n            }\n        }\n    }\n    *V"
    "ec::index_exclusive(&mut m.slots, i) = max_value<usize>();\n}export fn HashMap::swap_remove<K, V>(ref"
    "<HashMap<K, V>, exclusive> m, ref<K, shared> k) : Option<V>\n{\n    usize s = HashMap::find(&*m, k);\n "
    "   usize e = *Vec::index_shared(&m.slots, s);\n    if (e == max_value<usize>())\n    {\n        return "
    "None;\n    }\n    usize last = Vec::len(&m.keys) - 1;\n    if (e != last)\n    {\n        // The last ent"
    "ry's slot names e from now on.\n        usize t = HashMap::find(&*m, Vec::index_shared(&m.keys, last)"
    ");\n        *Vec::index_exclusive(&mut m.slots, t) = e;\n    }\n    auto k_last = Vec::remove_at(&mut m"
    ".keys, last);\n    auto v_last = Vec::remove_at(&mut m.values, last);\n    auto v = if (e != last)\n   "
    " {\n        drop(Vec::replace(&mut m.keys, e, k_last));\n        Vec::replace(&mut m.values, e, v_last"
    ")\n    }\n    else\n    {\n        drop(k_last);\n        v_last\n    };\n    HashMap::unslot(m, s);\n    So"
    "me(v)\n}export fn HashMap::remove<K, V>(ref<HashMap<K, V>, exclusive> m, ref<K, shared> k) : Option<V"
    ">\n{\n    usize s = HashMap::find(&*m, k);\n    HashMap::remove_slot(m, s)\n}unittest \"HashMap::remove: "
    "order kept\"\n{\n    HashMap<i32, bool> a = HashMap::new();\n    HashMap::insert(&mut a, 1, true);\n    H"
    "ashMap::insert(&mut a, 2, true);\n    HashMap::insert(&mut a, 3, true);\n    HashMap<i32, bool> b = Ha"
    "shMap::clone(&a);\n    i32 one = 1;\n    HashMap::remove(&mut a, &one);\n    assert(*HashMap::key_at(&a"
    ", 0) == 2 && *HashMap::key_at(&a, 1) == 3);\n    HashMap::swap_remove(&mut b, &one);\n    assert(*Hash"
    "Map::key_at(&b, 0) == 3 && *HashMap::key_at(&b, 1) == 2);\n}fn HashMap::remove_slot<K, V>(ref<HashMap"
    "<K, V>, exclusive> m, usize s) : Option<V>\n{\n    usize e = *Vec::index_shared(&m.slots, s);\n    if ("
    "e == max_value<usize>())\n    {\n        return None;\n    }\n    HashMap::unslot(m, s);\n    drop(Vec::r"
    "emove_at(&mut m.keys, e));\n    auto v = Vec::remove_at(&mut m.values, e);\n    // Entries after e mov"
    "ed down by one.\n    usize i = 0;\n    while (i < Vec::len(&m.slots))\n    {\n        usize x = *Vec::in"
    "dex_shared(&m.slots, i);\n        if (x != max_value<usize>() && x > e)\n        {\n            *Vec::i"
    "ndex_exclusive(&mut m.slots, i) = x - 1;\n        }\n        i = i + 1;\n    }\n    Some(v)\n}fn HashMap:"
    ":find_str<V>(ref<HashMap<String, V>, shared> m, str k) : usize\n{\n    usize mask = Vec::len(&m.slots)"
    " - 1;\n    usize i = narrow_wrapping<usize>(key_hash(&k)) & mask;\n    bool searching = true;\n    whil"
    "e (searching)\n    {\n        usize e = *Vec::index_shared(&m.slots, i);\n        if (e == max_value<us"
    "ize>())\n        {\n            searching = false;\n        }\n        else if (String::eq_str(Vec::inde"
    "x_shared(&m.keys, e), k))\n        {\n            searching = false;\n        }\n        else\n        {\n"
    "            i = (i + 1) & mask;\n        }\n    }\n    i\n}export fn HashMap::get_str<V>(ref<HashMap<Str"
    "ing, V>, shared> m, str k) : Option<ref<V, shared>>\n{\n    usize e = *Vec::index_shared(&m.slots, Has"
    "hMap::find_str(m, k));\n    if (e == max_value<usize>())\n    {\n        return None;\n    }\n    Some(Ve"
    "c::index_shared(&m.values, e))\n}unittest \"HashMap::get_str: literal key\"\n{\n    HashMap<String, i32> "
