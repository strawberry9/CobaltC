    "::from_c(rawptr<u8> p) : Result<String, Utf8Error>\n{\n    Vec<u8> b = unsafe\n    {\n        Vec::from_"
    "c_bytes(p)\n    };\n    String::from_utf8(b)\n}export fn String::len(ref<String, shared> s) : usize\n{\n "
