    "(&min) == 2 && min[0] == 1);\n        Vec<u8> wide = BigUint::to_bytes_be_padded(&x, 4);\n        asse"
    "rt(Vec::len(&wide) == 4 && wide[0] == 0 && wide[3] == 2);\n        assert(Vec::len(&BigUint::to_bytes"
