    "r<V>(ref<HashMap<String, V>, exclusive> m, str k) : Option<ref<V, exclusive>>\n{\n    usize e = *Vec::"
    "index_shared(&m.slots, HashMap::find_str(&*m, k));\n    if (e == max_value<usize>())\n    {\n        re"
    "turn None;\n    }\n    Some(Vec::index_exclusive(&mut m.values, e))\n}export fn HashMap::contains_str<V"
    ">(ref<HashMap<String, V>, shared> m, str k) : bool\n{\n    *Vec::index_shared(&m.slots, HashMap::find_"
    "str(m, k)) != max_value<usize>()\n}export fn HashMap::remove_str<V>(ref<HashMap<String, V>, exclusive"
    "> m, str k) : Option<V>\n{\n    usize s = HashMap::find_str(&*m, k);\n    HashMap::remove_slot(m, s)\n}f"
    "n HashMap::drain<K, V>(HashMap<K, V> m) : HashDrain<K, V>\n{\n    HashDrain { .m = m, .next = 0 }\n}fn "
    "HashDrain::total<K, V>(ref<HashDrain<K, V>, shared> d) : usize\n{\n    d.m.keys.len\n}fn HashDrain::tak"
    "e_key<K, V>(ref<HashDrain<K, V>, exclusive> d) : K\n{\n    Vec::take_raw(&mut d.m.keys, d.next)\n}fn Ha"
    "shDrain::take_value<K, V>(ref<HashDrain<K, V>, exclusive> d) : V\n{\n    auto v = Vec::take_raw(&mut d"
    ".m.values, d.next);\n    d.next = d.next + 1;\n    v\n}fn HashDrain::drop<K, V>(ref<HashDrain<K, V>, ex"
    "clusive> self)\n{\n    while (self.next < self.m.keys.len)\n    {\n        drop(Vec::take_raw(&mut self."
    "m.keys, self.next));\n        drop(Vec::take_raw(&mut self.m.values, self.next));\n        self.next ="
    " self.next + 1;\n    }\n    self.m.keys.len = 0;\n    self.m.values.len = 0;\n}export fn HashSet::new<K>"
    "() : HashSet<K>\n{\n    HashSet { .map = HashMap::new() }\n}export fn HashSet::len<K>(ref<HashSet<K>, s"
    "hared> s) : usize\n{\n    HashMap::len(&s.map)\n}export fn HashSet::insert<K>(ref<HashSet<K>, exclusive"
    "> s, K k) : bool\n{\n    match (HashMap::insert(&mut s.map, k, true))\n    {\n        Some(_) : false,\n "
