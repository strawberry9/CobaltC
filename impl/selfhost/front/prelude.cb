    " e = h[4];\n    for (usize i = 0; i < 80; i += 1)\n    {\n        u32 f = 0;\n        u32 k = 0;\n       "
    " if (i < 20)\n        {\n            f = (b & c) | (~b & d);\n            k = 0x5A827999;\n        }\n   "
    "     else if (i < 40)\n        {\n            f = b ^ c ^ d;\n            k = 0x6ED9EBA1;\n        }\n   "
