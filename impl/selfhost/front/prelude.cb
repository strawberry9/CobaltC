    "n::parse(\"{\\\"name\\\": \\\"ok\\\", \\\"n\\\": [1, 2.5]}\"));\n    assert(Option::unwrap(Json::as_text(Option::un"
    "wrap(Json::get(&doc, \"name\")))) == \"ok\");\n    auto n = Option::unwrap(Json::get(&doc, \"n\"));\n    ass"
    "ert(Json::as_i64(Option::unwrap(Json::at(n, 0))) == Some(1: i64));\n    assert(Json::as_i64(Option::u"
    "nwrap(Json::at(n, 1))) == None);\n    assert(Option::is_none(&Json::get(&doc, \"missing\")));\n}export f"
    "n Json::at(ref<Json, shared> j, usize i) : Option<ref<Json, shared>>\n{\n    match (j)\n    {\n        J"
    "sonArray(items) : if (i < Vec::len(items)) { Some(&items[i]) } else { None },\n        _             "
    "   : None,\n    }\n}export fn Json::lookup(ref<Json, shared> j, StringView path) : Option<ref<Json, sh"
    "ared>> from j\n{\n    // The parts are read where they are, by position: `path` is only\n    // searche"
    "d, so the result holds none of it (`from j`).\n    ref<Json, shared> cur = j;\n    usize n = StringVie"
    "w::len(path);\n    usize start = 0;\n    while (true)\n    {\n        usize end = match (StringView::fin"
    "d(&path[start..$], \".\"))\n        {\n            Some(k) : start + k,\n            None    : n,\n       "
    " };\n        cur = match (cur)\n        {\n            JsonArray(_) : match (StringView::parse<usize>(&"
    "path[start..end]))\n            {\n                Ok(k)  : Json::at(cur, k)?,\n                Err(_) "
    ": return None,\n            },\n            _ : Json::get(cur, &path[start..end])?,\n        };\n       "
    " if (end == n)\n        {\n            break;\n        }\n        start = end + 1;\n    }\n    Some(cur)\n}"
    "unittest \"Json::lookup: a dotted path\"\n{\n    Json doc = Result::unwrap(Json::parse(\"{\\\"servers\\\": [{"
    "\\\"host\\\": \\\"a\\\"}, {\\\"host\\\": \\\"b\\\"}], \\\"n\\\": 1}\"));\n    assert(Option::unwrap(Json::as_text(Option::"
    "unwrap(Json::lookup(&doc, \"servers.1.host\")))) == \"b\");\n    assert(Json::as_i64(Option::unwrap(Json:"
    ":lookup(&doc, \"n\"))) == Some(1: i64));\n    assert(Option::is_none(&Json::lookup(&doc, \"servers.2.hos"
    "t\")));\n    assert(Option::is_none(&Json::lookup(&doc, \"servers.x\")));\n}export fn Json::is_null(ref<J"
    "son, shared> j) : bool\n{\n    match (j)\n    {\n        JsonNull : true,\n        _        : false,\n    "
    "}\n}export fn Json::as_bool(ref<Json, shared> j) : Option<bool>\n{\n    match (j)\n    {\n        JsonBoo"
    "l(b) : Some(*b),\n        _           : None,\n    }\n}export fn Json::as_f64(ref<Json, shared> j) : Op"
    "tion<f64>\n{\n    match (j)\n    {\n        JsonNumber(x) : Some(*x),\n        _             : None,\n    "
    "}\n}export fn Json::as_i64(ref<Json, shared> j) : Option<i64>\n{\n    match (j)\n    {\n        JsonNumbe"
    "r(x) : if (*x == trunc(*x) && *x >= -9223372036854775808.0 && *x < 9223372036854775808.0) { Some(to_"
    "int<i64>(*x)) } else { None },\n        _             : None,\n    }\n}export fn Json::as_text(ref<Json"
    ", shared> j) : Option<StringView>\n{\n    match (j)\n    {\n        JsonText(s) : Some(s),\n        _    "
    "       : None,\n    }\n}export fn Json::as_array(ref<Json, shared> j) : Option<ref<Vec<Json>, shared>>"
    "\n{\n    match (j)\n    {\n        JsonArray(items) : Some(items),\n        _                : None,\n    "
