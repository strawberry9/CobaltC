    "ush(&mut v, i);\n    }\n    Rng::shuffle(&mut r, &mut v[0..$]);\n    assert(Vec::len(&v) == 5 && Vec::c"
    "ontains(&v, &3));\n}export fn uuid_v4() : String\n{\n    Vec<u8> b = os_random_vec(16);\n    b[6] = (b[6"
    "] & 0x0F) | 0x40;\n    b[8] = (b[8] & 0x3F) | 0x80;\n    String hex = to_hex(&b[0..$]);\n    String out"
    " = String::new();\n    String::reserve(&mut out, 36);\n    String::append(&mut out, String::view(&hex,"
    " 0, 8));\n    String::append(&mut out, \"-\");\n    String::append(&mut out, String::view(&hex, 8, 12));"
    "\n    String::append(&mut out, \"-\");\n    String::append(&mut out, String::view(&hex, 12, 16));\n    St"
    "ring::append(&mut out, \"-\");\n    String::append(&mut out, String::view(&hex, 16, 20));\n    String::a"
