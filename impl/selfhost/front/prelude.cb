    "ate(&mut s, data);\n    Sha384::finish(s)\n}export fn Sha1::new() : Sha1\n{\n    Sha1 { .h = [0x67452301"
    ", 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0], .block = [0; 64], .fill = 0, .length = 0 }\n}fn sh"
    "a1_block(array<u32, 5> h, array<u8, 64> blk) : array<u32, 5>\n{\n    array<u32, 80> w = [0; 80];\n    f"
    "or (usize i = 0; i < 16; i += 1)\n    {\n        w[i] = (widen<u32>(blk[4 * i]) << 24) | (widen<u32>(b"
    "lk[4 * i + 1]) << 16) | (widen<u32>(blk[4 * i + 2]) << 8) | widen<u32>(blk[4 * i + 3]);\n    }\n    fo"
    "r (usize i = 16; i < 80; i += 1)\n    {\n        w[i] = rotate_left(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ "
