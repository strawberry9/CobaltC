export const str PRELUDE_DOCS =
    "std::core\u{1f}Option\u{1f}enum\u{1f}export enum Option<T>\u{1f}A value that may be absent: `Some(T)` holds one, `None` "
    "holds nothing.\u{1f}\u{1f}export enum Option<T>\n    in `std::core`\n\n    A value that may be absent: `Some(T)` "
    "holds one, `None` holds nothing.\n\n    In `std` after `import std;`, unqualified, as are its variants"
    ".\n\u{1f}\u{1e}std::core\u{1f}Result\u{1f}enum\u{1f}export enum Result<T, E>\u{1f}The outcome of an operation that can fail: `Ok(T)"
    "` holds the value, `Err(E)` the error.\u{1f}\u{1f}export enum Result<T, E>\n    in `std::core`\n\n    The outcome"
    " of an operation that can fail: `Ok(T)` holds the value, `Err(E)` the error.\n\n    `?` on a `Result` "
    "returns an `Err` from the enclosing function. In `std` after `import std;`,\n    unqualified, as are "
    "its variants.\n\u{1f}\u{1e}std::core\u{1f}AllocError\u{1f}struct\u{1f}export struct AllocError\u{1f}The error `allocate` returns wh"
    "en memory cannot be had; it carries nothing.\u{1f}\u{1f}export struct AllocError\n    in `std::core`\n\n    The e"
    "rror `allocate` returns when memory cannot be had; it carries nothing.\n\u{1f}\u{1e}std::core\u{1f}Option::unwrap_or"
    "\u{1f}fn\u{1f}export fn Option::unwrap_or<T>(Option<T> o, T d) : T\u{1f}The value in `o`, or `d` when `o` is `None`"
    ".\u{1f}\u{1f}export fn Option::unwrap_or<T>(Option<T> o, T d) : T\n    in `std::core`\n\n    The value in `o`, or"
    " `d` when `o` is `None`.\n\n    An unused `d` is destroyed at the call's end.\n\u{1f}\u{1e}std::core\u{1f}Option::ok_o"
    "r\u{1f}fn\u{1f}export fn Option::ok_or<T, E>(Option<T> o, E e) : Result<T, E>\u{1f}`o` as a `Result`: `Ok` of its v"
    "alue, or `Err(e)` when `o` is `None`, so `?` applies.\u{1f}\u{1f}export fn Option::ok_or<T, E>(Option<T> o, E "
    "e) : Result<T, E>\n    in `std::core`\n\n    `o` as a `Result`: `Ok` of its value, or `Err(e)` when `o`"
    " is `None`, so `?` applies.\n\n    `e` is evaluated before the call; unused, it ends with the statemen"
    "t.\n\n    Example, \"Option::ok_or: None becomes the error\":\n        Option<i32> none = None;\n        R"
    "esult<i32, u8> r = Option::ok_or(none, 7);\n        match (r)\n        {\n            Ok(_)  : assert(f"
    "alse),\n            Err(e) : assert(e == 7),\n        }\n        assert(Result::is_ok(&Option::ok_or(So"
    "me(5), 7)));\n\u{1f}\u{1e}std::core\u{1f}Result::ok\u{1f}fn\u{1f}export fn Result::ok<T, E>(Result<T, E> r) : Option<T>\u{1f}The va"
    "lue in `r` as an `Option`: `Some` of it, or `None` when `r` is `Err`.\u{1f}\u{1f}export fn Result::ok<T, E>(Re"
    "sult<T, E> r) : Option<T>\n    in `std::core`\n\n    The value in `r` as an `Option`: `Some` of it, or "
