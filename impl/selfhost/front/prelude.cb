    "    bytes\n}export fn String::from_str(str s) : String\n{\n    Vec<u8> v = Vec::new();\n    usize n = st"
    "r_len(s);\n    Vec::reserve(&mut v, n);\n    usize i = 0;\n    while (i < n)\n    {\n        Vec::push(&m"
    "ut v, str_byte(s, i));\n        i = i + 1;\n    }\n    String { .bytes = v }\n}export fn String::new() :"
    " String\n{\n    String { .bytes = Vec::new() }\n}export fn String::as_bytes(ref<String, shared> s) : re"
