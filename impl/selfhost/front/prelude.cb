    "; 60];\n    for (usize i = 0; i < nk; i += 1)\n    {\n        w[i] = widen<u32>(key[4 * i]) | (widen<u3"
    "2>(key[4 * i + 1]) << 8) | (widen<u32>(key[4 * i + 2]) << 16) | (widen<u32>(key[4 * i + 3]) << 24);\n"
    "    }\n    u8 rcon = 1;\n    for (usize word = nk; word < 4 * (rounds + 1); word += 1)\n    {\n        u"
    "32 t = w[word - 1];\n        if (word % nk == 0)\n        {\n            t = narrow_wrapping<u32>(aes_s"
    "box_bytes(widen<u64>((t >> 8) | (t << 24)))) ^ widen<u32>(rcon);\n            rcon = aes_xtime(rcon);"
    "\n        }\n        else if (nk > 6 && word % nk == 4)\n        {\n            t = narrow_wrapping<u32>"
    "(aes_sbox_bytes(widen<u64>(t)));\n        }\n        w[word] = w[word - nk] ^ t;\n    }\n    array<u64, "
    "120> sk = [0; 120];\n    for (usize r = 0; r <= rounds; r += 1)\n    {\n        array<u8, 64> b = [0; 6"
    "4];\n        for (usize j = 0; j < 16; j += 1)\n        {\n            u8 v = narrow_wrapping<u8>(w[4 *"
    " r + j / 4] >> narrow<u32>(8 * (j % 4)));\n            for (usize k = 0; k < 4; k += 1)\n            {"
    "\n                b[16 * k + j] = v;\n            }\n        }\n        array<u64, 8> q = aes_pack(b);\n "
    "       for (usize p = 0; p < 8; p += 1)\n        {\n            sk[8 * r + p] = q[p];\n        }\n    }\n"
    "    AesKey { .sk = sk, .rounds = rounds }\n}fn aes_encrypt4(ref<AesKey, shared> key, array<u64, 8> in"
    "put) : array<u64, 8>\n{\n    array<u64, 8> q = input;\n    for (usize p = 0; p < 8; p += 1)\n    {\n     "
    "   q[p] = q[p] ^ key.sk[p];\n    }\n    for (usize round = 1; round <= key.rounds; round += 1)\n    {\n "
    "       q = aes_shift_rows(aes_sbox_ct(q));\n        if (round < key.rounds)\n        {\n            q ="
    " aes_mix_columns(q);\n        }\n        for (usize p = 0; p < 8; p += 1)\n        {\n            q[p] ="
    " q[p] ^ key.sk[8 * round + p];\n        }\n    }\n    q\n}fn aes_block(ref<AesKey, shared> key, array<u8"
    ", 16> input) : array<u8, 16>\n{\n    array<u8, 64> b = [0; 64];\n    for (usize i = 0; i < 16; i += 1)\n"
    "    {\n        b[i] = input[i];\n    }\n    array<u8, 64> e = aes_unpack(aes_encrypt4(key, aes_pack(b))"
    ");\n    array<u8, 16> out = [0; 16];\n    for (usize i = 0; i < 16; i += 1)\n    {\n        out[i] = e[i"
    "];\n    }\n    out\n}export fn aes_encrypt_block(slice<u8, shared> key, array<u8, 16> block) : array<u8"
    ", 16>\n{\n    AesKey k = aes_expand(key);\n    aes_block(&k, block)\n}unittest \"aes_encrypt_block: the F"
    "IPS 197 AES-128 vector\"\n{\n    Vec<u8> key = Result::unwrap(from_hex(StringView::of(\"0001020304050607"
    "08090a0b0c0d0e0f\")));\n    Vec<u8> b = Result::unwrap(from_hex(StringView::of(\"00112233445566778899aa"
    "bbccddeeff\")));\n    array<u8, 16> block = [0; 16];\n    for (usize i = 0; i < 16; i += 1)\n    {\n     "
    "   block[i] = b[i];\n    }\n    array<u8, 16> out = aes_encrypt_block(&key[0..$], block);\n    assert(S"
    "tring::eq_str(&to_hex(&out[0..$]), \"69c4e0d86a7b0430d8cdb78070b4c55a\"));\n}fn gcm_block(slice<u8, sha"
    "red> b, usize at) : u128\n{\n    u128 x = 0;\n    for (usize i = 0; i < 16; i += 1)\n    {\n        u8 v "
    "= if (at + i < slice_len(b)) { b[at + i] } else { 0 };\n        x = (x << 8) | widen<u128>(v);\n    }\n"
    "    x\n}fn ghash_bmul64(u64 x, u64 y) : u64\n{\n    u64 x0 = x & 0x1111111111111111;\n    u64 x1 = x & 0"
    "x2222222222222222;\n    u64 x2 = x & 0x4444444444444444;\n    u64 x3 = x & 0x8888888888888888;\n    u64"
    " y0 = y & 0x1111111111111111;\n    u64 y1 = y & 0x2222222222222222;\n    u64 y2 = y & 0x44444444444444"
    "44;\n    u64 y3 = y & 0x8888888888888888;\n    u64 z0 = wrapping_mul(x0, y0) ^ wrapping_mul(x1, y3) ^ "
    "wrapping_mul(x2, y2) ^ wrapping_mul(x3, y1);\n    u64 z1 = wrapping_mul(x0, y1) ^ wrapping_mul(x1, y0"
    ") ^ wrapping_mul(x2, y3) ^ wrapping_mul(x3, y2);\n    u64 z2 = wrapping_mul(x0, y2) ^ wrapping_mul(x1"
    ", y1) ^ wrapping_mul(x2, y0) ^ wrapping_mul(x3, y3);\n    u64 z3 = wrapping_mul(x0, y3) ^ wrapping_mu"
    "l(x1, y2) ^ wrapping_mul(x2, y1) ^ wrapping_mul(x3, y0);\n    (z0 & 0x1111111111111111) | (z1 & 0x222"
    "2222222222222) | (z2 & 0x4444444444444444) | (z3 & 0x8888888888888888)\n}fn ghash_rev64(u64 x) : u64\n"
    "{\n    u64 v = ((x & 0x5555555555555555) << 1) | ((x >> 1) & 0x5555555555555555);\n    v = ((v & 0x333"
    "3333333333333) << 2) | ((v >> 2) & 0x3333333333333333);\n    v = ((v & 0x0f0f0f0f0f0f0f0f) << 4) | (("
    "v >> 4) & 0x0f0f0f0f0f0f0f0f);\n    v = ((v & 0x00ff00ff00ff00ff) << 8) | ((v >> 8) & 0x00ff00ff00ff0"
    "0ff);\n    v = ((v & 0x0000ffff0000ffff) << 16) | ((v >> 16) & 0x0000ffff0000ffff);\n    (v << 32) | ("
    "v >> 32)\n}fn ghash_mul(u128 x, u128 y) : u128\n{\n    u64 x1 = narrow_wrapping<u64>(x >> 64);\n    u64 "
    "x0 = narrow_wrapping<u64>(x);\n    u64 y1 = narrow_wrapping<u64>(y >> 64);\n    u64 y0 = narrow_wrappi"
    "ng<u64>(y);\n    u64 x0r = ghash_rev64(x0);\n    u64 x1r = ghash_rev64(x1);\n    u64 y0r = ghash_rev64("
    "y0);\n    u64 y1r = ghash_rev64(y1);\n    u64 z0 = ghash_bmul64(x0, y0);\n    u64 z1 = ghash_bmul64(x1,"
    " y1);\n    u64 z2 = ghash_bmul64(x0 ^ x1, y0 ^ y1);\n    u64 z0h = ghash_bmul64(x0r, y0r);\n    u64 z1h"
    " = ghash_bmul64(x1r, y1r);\n    u64 z2h = ghash_bmul64(x0r ^ x1r, y0r ^ y1r);\n    z2 = z2 ^ z0 ^ z1;\n"
    "    z2h = z2h ^ z0h ^ z1h;\n    z0h = ghash_rev64(z0h) >> 1;\n    z1h = ghash_rev64(z1h) >> 1;\n    z2h"
    " = ghash_rev64(z2h) >> 1;\n    u64 v0 = z0;\n    u64 v1 = z0h ^ z2;\n    u64 v2 = z1 ^ z2h;\n    u64 v3 "
    "= z1h;\n    v3 = (v3 << 1) | (v2 >> 63);\n    v2 = (v2 << 1) | (v1 >> 63);\n    v1 = (v1 << 1) | (v0 >>"
    " 63);\n    v0 = v0 << 1;\n    v2 = v2 ^ v0 ^ (v0 >> 1) ^ (v0 >> 2) ^ (v0 >> 7);\n    v1 = v1 ^ (v0 << 6"
    "3) ^ (v0 << 62) ^ (v0 << 57);\n    v3 = v3 ^ v1 ^ (v1 >> 1) ^ (v1 >> 2) ^ (v1 >> 7);\n    v2 = v2 ^ (v"
    "1 << 63) ^ (v1 << 62) ^ (v1 << 57);\n    (widen<u128>(v3) << 64) | widen<u128>(v2)\n}fn ghash_update(u"
    "128 y, u128 h, slice<u8, shared> data) : u128\n{\n    u128 acc = y;\n    for (usize at = 0; at < slice_"
    "len(data); at += 16)\n    {\n        acc = ghash_mul(acc ^ gcm_block(data, at), h);\n    }\n    acc\n}fn "
    "gcm_bytes(u128 x) : array<u8, 16>\n{\n    array<u8, 16> b = [0; 16];\n    for (usize i = 0; i < 16; i +"
    "= 1)\n    {\n        b[i] = narrow_wrapping<u8>(x >> narrow<u32>(8 * (15 - i)));\n    }\n    b\n}fn gcm_c"
    "tr(ref<AesKey, shared> key, array<u8, 16> j0, slice<u8, shared> data) : Vec<u8>\n{\n    Vec<u8> out = "
    "Vec::from_slice(data);\n    array<u8, 64> cb = [0; 64];\n    for (usize k = 0; k < 4; k += 1)\n    {\n  "
    "      for (usize i = 0; i < 12; i += 1)\n        {\n            cb[16 * k + i] = j0[i];\n        }\n    "
    "}\n    // The counter, kept apart from the blocks (whose last four bytes it is).\n    u32 c = (widen<u"
    "32>(j0[12]) << 24) | (widen<u32>(j0[13]) << 16) | (widen<u32>(j0[14]) << 8) | widen<u32>(j0[15]);\n  "
    "  for (usize at = 0; at < slice_len(data); at += 64)\n    {\n        for (usize k = 0; k < 4; k += 1)\n"
    "        {\n            c = wrapping_add(c, 1);\n            for (usize i = 0; i < 4; i += 1)\n         "
    "   {\n                cb[16 * k + 12 + i] = narrow_wrapping<u8>(c >> narrow<u32>(24 - 8 * i));\n      "
    "      }\n        }\n        array<u8, 64> ks = aes_unpack(aes_encrypt4(key, aes_pack(cb)));\n        fo"
    "r (usize i = 0; i < 64 && at + i < slice_len(data); i += 1)\n        {\n            out[at + i] = out["
    "at + i] ^ ks[i];\n        }\n    }\n    out\n}fn gcm_tag(\n    ref<AesKey, shared> key,\n    array<u8, 16>"
    " j0,\n    slice<u8, shared> aad,\n    slice<u8, shared> ciphertext,\n) : array<u8, 16>\n{\n    u128 h = g"
    "cm_block(&aes_block(key, [0; 16])[0..$], 0);\n    u128 y = ghash_update(ghash_update(0, h, aad), h, c"
    "iphertext);\n    u128 lengths = (widen<u128>(slice_len(aad)) * 8) << 64 | widen<u128>(slice_len(ciphe"
    "rtext)) * 8;\n    y = ghash_mul(y ^ lengths, h);\n    gcm_bytes(y ^ gcm_block(&aes_block(key, j0)[0..$"
    "], 0))\n}fn gcm_j0(slice<u8, shared> nonce) : array<u8, 16>\n{\n    if (slice_len(nonce) != 12)\n    {\n "
    "       fault(crypto_length);\n    }\n    array<u8, 16> j = [0; 16];\n    for (usize i = 0; i < 12; i +="
    " 1)\n    {\n        j[i] = nonce[i];\n    }\n    j[15] = 1;\n    j\n}export fn aes_gcm_seal(\n    slice<u8,"
    " shared> key,\n    slice<u8, shared> nonce,\n    slice<u8, shared> aad,\n    slice<u8, shared> plaintex"
    "t,\n) : Vec<u8>\n{\n    array<u8, 16> j0 = gcm_j0(nonce);\n    AesKey k = aes_expand(key);\n    Vec<u8> o"
    "ut = gcm_ctr(&k, j0, plaintext);\n    array<u8, 16> tag = gcm_tag(&k, j0, aad, &out[0..$]);\n    Vec::"
    "extend_from(&mut out, &tag[0..$]);\n    out\n}unittest \"aes_gcm_seal: a published vector and its openi"
    "ng\"\n{\n    array<u8, 16> key = [0; 16];\n    array<u8, 12> nonce = [0; 12];\n    array<u8, 16> plain = "
    "[0; 16];\n    Vec<u8> none = Vec::new();\n    Vec<u8> sealed = aes_gcm_seal(&key[0..$], &nonce[0..$], "
    "&none[0..$], &plain[0..$]);\n    String want = String::from_str(\"0388dace60b6a392f328c2b971b2fe78\");\n"
    "    String::append(&mut want, \"ab6e47d42cec13bdf53a67b21257bddf\");\n    assert(String::eq(&to_hex(&se"
    "aled[0..$]), &want));\n    Vec<u8> opened = Option::unwrap(aes_gcm_open(&key[0..$], &nonce[0..$], &no"
    "ne[0..$], &sealed[0..$]));\n    assert(slice_eq(&opened[0..$], &plain[0..$]));\n    assert(Option::is_"
    "none(&aes_gcm_open(&key[0..$], &nonce[0..$], &b\"aad\"[0..$], &sealed[0..$])));\n}export fn aes_gcm_ope"
    "n(\n    slice<u8, shared> key,\n    slice<u8, shared> nonce,\n    slice<u8, shared> aad,\n    slice<u8, "
    "shared> sealed,\n) : Option<Vec<u8>>\n{\n    array<u8, 16> j0 = gcm_j0(nonce);\n    AesKey k = aes_expan"
    "d(key);\n    usize n = slice_len(sealed);\n    if (n < 16)\n    {\n        return None;\n    }\n    array<"
    "u8, 16> want = gcm_tag(&k, j0, aad, &sealed[0..n - 16]);\n    if (!digest_eq(&want[0..$], &sealed[n -"
    " 16..n]))\n    {\n        return None;\n    }\n    Some(gcm_ctr(&k, j0, &sealed[0..n - 16]))\n}fn fe_carr"
    "y(array<u64, 5> f) : array<u64, 5>\n{\n    array<u64, 5> r = f;\n    for (usize i = 0; i < 4; i += 1)\n "
    "   {\n        r[i + 1] += r[i] >> 51;\n        r[i] = r[i] & FE_MASK;\n    }\n    u64 c = r[4] >> 51;\n  "
    "  r[4] = r[4] & FE_MASK;\n    r[0] += c * 19;\n    r[1] += r[0] >> 51;\n    r[0] = r[0] & FE_MASK;\n    "
    "r\n}fn fe_add(array<u64, 5> a, array<u64, 5> b) : array<u64, 5>\n{\n    fe_carry([a[0] + b[0], a[1] + b"
    "[1], a[2] + b[2], a[3] + b[3], a[4] + b[4]])\n}fn fe_sub(array<u64, 5> a, array<u64, 5> b) : array<u6"
    "4, 5>\n{\n    fe_carry([\n        a[0] + 0x1fffffffffffb4 - b[0],\n        a[1] + 0x1ffffffffffffc - b[1"
    "],\n        a[2] + 0x1ffffffffffffc - b[2],\n        a[3] + 0x1ffffffffffffc - b[3],\n        a[4] + 0x"
    "1ffffffffffffc - b[4],\n    ])\n}fn fe_mul(array<u64, 5> a, array<u64, 5> b) : array<u64, 5>\n{\n    u12"
    "8 a0 = widen<u128>(a[0]);\n    u128 a1 = widen<u128>(a[1]);\n    u128 a2 = widen<u128>(a[2]);\n    u128"
    " a3 = widen<u128>(a[3]);\n    u128 a4 = widen<u128>(a[4]);\n    u128 b0 = widen<u128>(b[0]);\n    u128 "
    "b1 = widen<u128>(b[1]);\n    u128 b2 = widen<u128>(b[2]);\n    u128 b3 = widen<u128>(b[3]);\n    u128 b"
    "4 = widen<u128>(b[4]);\n    u128 b1_19 = b1 * 19;\n    u128 b2_19 = b2 * 19;\n    u128 b3_19 = b3 * 19;"
    "\n    u128 b4_19 = b4 * 19;\n    u128 t0 = a0 * b0 + a1 * b4_19 + a2 * b3_19 + a3 * b2_19 + a4 * b1_19"
    ";\n    u128 t1 = a0 * b1 + a1 * b0 + a2 * b4_19 + a3 * b3_19 + a4 * b2_19;\n    u128 t2 = a0 * b2 + a1"
    " * b1 + a2 * b0 + a3 * b4_19 + a4 * b3_19;\n    u128 t3 = a0 * b3 + a1 * b2 + a2 * b1 + a3 * b0 + a4 "
    "* b4_19;\n    u128 t4 = a0 * b4 + a1 * b3 + a2 * b2 + a3 * b1 + a4 * b0;\n    u128 m = 0x7ffffffffffff"
    ";\n    t1 += t0 >> 51;\n    t2 += t1 >> 51;\n    t3 += t2 >> 51;\n    t4 += t3 >> 51;\n    u128 r0 = (t0 "
    "& m) + (t4 >> 51) * 19;\n    u128 r1 = (t1 & m) + (r0 >> 51);\n    array<u64, 5> r = [\n        narrow<"
    "u64>(r0 & m),\n        narrow<u64>(r1),\n        narrow<u64>(t2 & m),\n        narrow<u64>(t3 & m),\n   "
    "     narrow<u64>(t4 & m),\n    ];\n    fe_carry(r)\n}fn fe_cswap(ref<array<u64, 5>, exclusive> a, ref<a"
    "rray<u64, 5>, exclusive> b, u64 swap)\n{\n    u64 mask = wrapping_sub(0, swap);\n    for (usize i = 0; "
    "i < 5; i += 1)\n    {\n        u64 x = mask & (a[i] ^ b[i]);\n        a[i] = a[i] ^ x;\n        b[i] = b"
    "[i] ^ x;\n    }\n}fn fe_invert(array<u64, 5> z) : array<u64, 5>\n{\n    array<u64, 5> r = [1, 0, 0, 0, 0"
    "];\n    for (usize k = 0; k < 255; k += 1)\n    {\n        usize i = 254 - k;\n        r = fe_mul(r, r);"
    "\n        if (i >= 5 || i == 3 || i == 1 || i == 0)\n        {\n            r = fe_mul(r, z);\n        }"
    "\n    }\n    r\n}fn fe_from_bytes(slice<u8, shared> s) : array<u64, 5>\n{\n    [\n        read_le<u64>(s, "
    "0) & FE_MASK,\n        (read_le<u64>(s, 6) >> 3) & FE_MASK,\n        (read_le<u64>(s, 12) >> 6) & FE_M"
    "ASK,\n        (read_le<u64>(s, 19) >> 1) & FE_MASK,\n        (read_le<u64>(s, 24) >> 12) & FE_MASK,\n  "
    "  ]\n}fn fe_to_bytes(array<u64, 5> f) : array<u8, 32>\n{\n    array<u64, 5> h = fe_carry(fe_carry(f));\n"
    "    // q is 1 exactly when h ≥ p: h + 19 then reaches 2^255.\n    u64 q = (h[0] + 19) >> 51;\n    q "
    "= (h[1] + q) >> 51;\n    q = (h[2] + q) >> 51;\n    q = (h[3] + q) >> 51;\n    q = (h[4] + q) >> 51;\n  "
    "  h[0] += 19 * q;\n    for (usize i = 0; i < 4; i += 1)\n    {\n        h[i + 1] += h[i] >> 51;\n       "
    " h[i] = h[i] & FE_MASK;\n    }\n    h[4] = h[4] & FE_MASK;\n    array<u64, 4> w = [\n        h[0] | (h[1"
    "] << 51),\n        (h[1] >> 13) | (h[2] << 38),\n        (h[2] >> 26) | (h[3] << 25),\n        (h[3] >>"
    " 39) | (h[4] << 12),\n    ];\n    array<u8, 32> out = [0; 32];\n    for (usize i = 0; i < 4; i += 1)\n  "
    "  {\n        for (usize j = 0; j < 8; j += 1)\n        {\n            out[8 * i + j] = narrow_wrapping<"
    "u8>(w[i] >> narrow<u32>(8 * j));\n        }\n    }\n    out\n}fn x25519_ladder(slice<u8, shared> scalar,"
    " slice<u8, shared> u) : array<u8, 32>\n{\n    array<u8, 32> k = [0; 32];\n    for (usize i = 0; i < 32;"
    " i += 1)\n    {\n        k[i] = scalar[i];\n    }\n    k[0] = k[0] & 248;\n    k[31] = (k[31] & 127) | 64"
    ";\n    array<u64, 5> x1 = fe_from_bytes(u);\n    array<u64, 5> x2 = [1, 0, 0, 0, 0];\n    array<u64, 5>"
    " z2 = [0, 0, 0, 0, 0];\n    array<u64, 5> x3 = x1;\n    array<u64, 5> z3 = [1, 0, 0, 0, 0];\n    array<"
    "u64, 5> a24 = [121665, 0, 0, 0, 0];\n    u64 swap = 0;\n    for (usize step = 0; step < 255; step += 1"
    ")\n    {\n        usize t = 254 - step;\n        u64 bit = widen<u64>((k[t >> 3] >> narrow<u32>(t & 7))"
    " & 1);\n        swap = swap ^ bit;\n        fe_cswap(&mut x2, &mut x3, swap);\n        fe_cswap(&mut z2"
    ", &mut z3, swap);\n        swap = bit;\n        array<u64, 5> a = fe_add(x2, z2);\n        array<u64, 5"
    "> aa = fe_mul(a, a);\n        array<u64, 5> b = fe_sub(x2, z2);\n        array<u64, 5> bb = fe_mul(b, "
    "b);\n        array<u64, 5> e = fe_sub(aa, bb);\n        array<u64, 5> c = fe_add(x3, z3);\n        arra"
    "y<u64, 5> d = fe_sub(x3, z3);\n        array<u64, 5> da = fe_mul(d, a);\n        array<u64, 5> cb = fe"
    "_mul(c, b);\n        array<u64, 5> sum = fe_add(da, cb);\n        x3 = fe_mul(sum, sum);\n        array"
    "<u64, 5> diff = fe_sub(da, cb);\n        z3 = fe_mul(x1, fe_mul(diff, diff));\n        x2 = fe_mul(aa,"
    " bb);\n        z2 = fe_mul(e, fe_add(aa, fe_mul(a24, e)));\n    }\n    fe_cswap(&mut x2, &mut x3, swap)"
    ";\n    fe_cswap(&mut z2, &mut z3, swap);\n    fe_to_bytes(fe_mul(x2, fe_invert(z2)))\n}export fn x25519"
    "(slice<u8, shared> private_key, slice<u8, shared> public_key) : Option<array<u8, 32>>\n{\n    if (slic"
    "e_len(private_key) != 32 || slice_len(public_key) != 32)\n    {\n        fault(crypto_length);\n    }\n "
    "   array<u8, 32> shared = x25519_ladder(private_key, public_key);\n    u8 acc = 0;\n    for (usize i ="
    " 0; i < 32; i += 1)\n    {\n        acc = acc | shared[i];\n    }\n    if (acc == 0)\n    {\n        retur"
    "n None;\n    }\n    Some(shared)\n}export fn x25519_public_key(slice<u8, shared> private_key) : array<u"
    "8, 32>\n{\n    if (slice_len(private_key) != 32)\n    {\n        fault(crypto_length);\n    }\n    array<u"
    "8, 32> base = [0; 32];\n    base[0] = 9;\n    x25519_ladder(private_key, &base[0..$])\n}export fn x2551"
    "9_private_key() : array<u8, 32>\n{\n    array<u8, 32> k = [0; 32];\n    os_random_bytes(&mut k[0..$]);\n"
    "    k\n}fn rsa_open(ref<RsaPublicKey, shared> key, slice<u8, shared> signature, usize k) : Option<Vec"
    "<u8>>\n{\n    BigUint s = BigUint::from_bytes_be(signature);\n    if (!BigUint::less(&s, &key.n))\n    {"
    "\n        return None;\n    }\n    BigUint m = BigUint::mod_pow(&s, &key.e, &key.n);\n    if (BigUint::b"
    "it_len(&m) > 8 * k)\n    {\n        return None;\n    }\n    Some(BigUint::to_bytes_be_padded(&m, k))\n}f"
    "n digest_info_prefix(HashKind kind) : Vec<u8>\n{\n    Result::unwrap_or(from_hex(match (kind)\n    {\n  "
    "      Sha1     : \"3021300906052b0e03021a05000414\",\n        Sha2_256 : \"3031300d060960864801650304020"
    "105000420\",\n        Sha2_384 : \"3041300d060960864801650304020205000430\",\n        Sha2_512 : \"3051300"
    "d060960864801650304020305000440\",\n    }), Vec::new())\n}export fn rsa_verify_pkcs1v15(\n    ref<RsaPub"
    "licKey, shared> key,\n    HashKind kind,\n    slice<u8, shared> digest,\n    slice<u8, shared> signatur"
    "e,\n) : bool\n{\n    usize k = (BigUint::bit_len(&key.n) + 7) / 8;\n    if (slice_len(signature) != k ||"
    " slice_len(digest) != hash_len(kind))\n    {\n        return false;\n    }\n    Vec<u8> prefix = digest_"
    "info_prefix(kind);\n    usize t_len = Vec::len(&prefix) + slice_len(digest);\n    if (k < t_len + 11)\n"
    "    {\n        return false;\n    }\n    Vec<u8> want = Vec::new();\n    Vec::push(&mut want, 0);\n    Ve"
    "c::push(&mut want, 1);\n    for (usize i = 0; i < k - t_len - 3; i += 1)\n    {\n        Vec::push(&mut"
    " want, 0xff);\n    }\n    Vec::push(&mut want, 0);\n    Vec::extend_from(&mut want, &prefix[0..$]);\n   "
    " Vec::extend_from(&mut want, digest);\n    match (rsa_open(key, signature, k))\n    {\n        Some(em)"
    " : digest_eq(&em[0..$], &want[0..$]),\n        None     : false,\n    }\n}fn mgf1(HashKind kind, slice<"
    "u8, shared> seed, usize len) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n    u32 counter = 0;\n    whil"
    "e (Vec::len(&out) < len)\n    {\n        Vec<u8> input = Vec::from_slice(seed);\n        Vec::push_be(&"
    "mut input, counter);\n        Vec<u8> h = hash(kind, &input[0..$]);\n        for (usize i = 0; i < Vec"
    "::len(&h) && Vec::len(&out) < len; i += 1)\n        {\n            Vec::push(&mut out, h[i]);\n        "
    "}\n        counter += 1;\n    }\n    out\n}export fn rsa_verify_pss(\n    ref<RsaPublicKey, shared> key,\n"
    "    HashKind kind,\n    slice<u8, shared> digest,\n    slice<u8, shared> signature,\n) : bool\n{\n    usi"
    "ze mod_bits = BigUint::bit_len(&key.n);\n    usize k = (mod_bits + 7) / 8;\n    usize h_len = hash_len"
    "(kind);\n    usize s_len = h_len;\n    if (slice_len(signature) != k || slice_len(digest) != h_len || "
    "mod_bits < 2)\n    {\n        return false;\n    }\n    usize em_bits = mod_bits - 1;\n    usize em_len ="
    " (em_bits + 7) / 8;\n    if (em_len < h_len + s_len + 2)\n    {\n        return false;\n    }\n    Vec<u8"
    "> em = match (rsa_open(key, signature, em_len))\n    {\n        Some(e) : e,\n        None    : return "
    "false,\n    };\n    if (em[em_len - 1] != 0xbc)\n    {\n        return false;\n    }\n    usize db_len = e"
    "m_len - h_len - 1;\n    u32 unused = narrow<u32>(8 * em_len - em_bits);\n    u8 top_mask = narrow_wrap"
    "ping<u8>((0xff: u32) >> unused);\n    if ((em[0] & ~top_mask) != 0)\n    {\n        return false;\n    }"
    "\n    Vec<u8> db_mask = mgf1(kind, &em[db_len..db_len + h_len], db_len);\n    Vec<u8> db = Vec::new();"
    "\n    for (usize i = 0; i < db_len; i += 1)\n    {\n        Vec::push(&mut db, em[i] ^ db_mask[i]);\n   "
    " }\n    db[0] = db[0] & top_mask;\n    usize ps_len = em_len - h_len - s_len - 2;\n    for (usize i = 0"
    "; i < ps_len; i += 1)\n    {\n        if (db[i] != 0)\n        {\n            return false;\n        }\n  "
    "  }\n    if (db[ps_len] != 1)\n    {\n        return false;\n    }\n    Vec<u8> m2 = Vec::filled(8, 0: u8"
    ");\n    Vec::extend_from(&mut m2, digest);\n    Vec::extend_from(&mut m2, &db[db_len - s_len..$]);\n   "
    " Vec<u8> h2 = hash(kind, &m2[0..$]);\n    digest_eq(&h2[0..$], &em[db_len..db_len + h_len])\n}fn field"
    "_of(EcCurve c, bool order) : Field\n{\n    match (c)\n    {\n        P256 : if (order)\n        {\n       "
    "     Field { .m = [\n                0xf3b9cac2fc632551,\n                0xbce6faada7179e84,\n        "
    "        0xffffffffffffffff,\n                0xffffffff00000000,\n                0x0000000000000000,\n"
    "                0x0000000000000000,\n            ], .n = 4, .minv = 0xccd1c8aaee00bc4f, .r2 = [\n     "
    "           0x83244c95be79eea2,\n                0x4699799c49bd6fa6,\n                0x2845b2392b6bec5"
    "9,\n                0x66e12d94f3d95620,\n                0x0000000000000000,\n                0x0000000"
    "000000000,\n            ] }\n        }\n        else\n        {\n            Field { .m = [\n             "
    "   0xffffffffffffffff,\n                0x00000000ffffffff,\n                0x0000000000000000,\n     "
    "           0xffffffff00000001,\n                0x0000000000000000,\n                0x000000000000000"
    "0,\n            ], .n = 4, .minv = 0x0000000000000001, .r2 = [\n                0x0000000000000003,\n  "
    "              0xfffffffbffffffff,\n                0xfffffffffffffffe,\n                0x00000004ffff"
    "fffd,\n                0x0000000000000000,\n                0x0000000000000000,\n            ] }\n      "
    "  },\n        P384 : if (order)\n        {\n            Field { .m = [\n                0xecec196accc529"
    "73,\n                0x581a0db248b0a77a,\n                0xc7634d81f4372ddf,\n                0xffffff"
    "ffffffffff,\n                0xffffffffffffffff,\n                0xffffffffffffffff,\n            ], ."
    "n = 6, .minv = 0x6ed46089e88fdc45, .r2 = [\n                0x2d319b2419b409a9,\n                0xff3"
    "d81e5df1aa419,\n                0xbc3e483afcb82947,\n                0xd40d49174aab1cc5,\n             "
    "   0x3fb05b7a28266895,\n                0x0c84ee012b39bf21,\n            ] }\n        }\n        else\n  "
    "      {\n            Field { .m = [\n                0x00000000ffffffff,\n                0xffffffff000"
    "00000,\n                0xfffffffffffffffe,\n                0xffffffffffffffff,\n                0xfff"
    "fffffffffffff,\n                0xffffffffffffffff,\n            ], .n = 6, .minv = 0x0000000100000001"
    ", .r2 = [\n                0xfffffffe00000001,\n                0x0000000200000000,\n                0x"
    "fffffffe00000000,\n                0x0000000200000000,\n                0x0000000000000001,\n          "
    "      0x0000000000000000,\n            ] }\n        },\n    }\n}fn mont_mul(ref<Field, shared> f, array<"
    "u64, 6> a, array<u64, 6> b) : array<u64, 6>\n{\n    usize n = f.n;\n    array<u64, 8> t = [0; 8];\n    f"
    "or (usize i = 0; i < n; i += 1)\n    {\n        u128 c = 0;\n        for (usize j = 0; j < n; j += 1)\n "
    "       {\n            u128 x = widen<u128>(t[j]) + widen<u128>(a[j]) * widen<u128>(b[i]) + c;\n       "
    "     t[j] = narrow_wrapping<u64>(x);\n            c = x >> 64;\n        }\n        u128 y = widen<u128>"
    "(t[n]) + c;\n        t[n] = narrow_wrapping<u64>(y);\n        t[n + 1] = narrow_wrapping<u64>(y >> 64)"
    ";\n        u64 k = wrapping_mul(t[0], f.minv);\n        u128 z = widen<u128>(t[0]) + widen<u128>(k) * "
    "widen<u128>(f.m[0]);\n        c = z >> 64;\n        for (usize j = 1; j < n; j += 1)\n        {\n       "
    "     u128 x = widen<u128>(t[j]) + widen<u128>(k) * widen<u128>(f.m[j]) + c;\n            t[j - 1] = n"
    "arrow_wrapping<u64>(x);\n            c = x >> 64;\n        }\n        u128 w = widen<u128>(t[n]) + c;\n "
    "       t[n - 1] = narrow_wrapping<u64>(w);\n        t[n] = t[n + 1] + narrow_wrapping<u64>(w >> 64);\n"
    "    }\n    array<u64, 6> r = [0; 6];\n    for (usize j = 0; j < n; j += 1)\n    {\n        r[j] = t[j];\n"
    "    }\n    // r - m unless r (with its carry t[n]) is below m: chosen by a mask.\n    Borrowed d = f_s"
    "ub_borrow(f, r, f.m);\n    f_select(wrapping_sub(0, (1 - t[n]) & d.borrow), r, d.v)\n}fn f_less(ref<Fi"
    "eld, shared> f, array<u64, 6> a, array<u64, 6> b) : bool\n{\n    usize i = f.n;\n    while (i > 0)\n    "
    "{\n        i -= 1;\n        if (a[i] != b[i])\n        {\n            return a[i] < b[i];\n        }\n    "
    "}\n    false\n}fn f_sub_borrow(ref<Field, shared> f, array<u64, 6> a, array<u64, 6> b) : Borrowed\n{\n  "
    "  array<u64, 6> r = [0; 6];\n    u64 borrow = 0;\n    for (usize i = 0; i < f.n; i += 1)\n    {\n       "
    " u128 x = wrapping_sub(wrapping_sub(widen<u128>(a[i]), widen<u128>(b[i])), widen<u128>(borrow));\n   "
    "     r[i] = narrow_wrapping<u64>(x);\n        borrow = narrow_wrapping<u64>(x >> 127);\n    }\n    Borr"
    "owed { .v = r, .borrow = borrow }\n}fn f_sub_raw(ref<Field, shared> f, array<u64, 6> a, array<u64, 6>"
    " b) : array<u64, 6>\n{\n    f_sub_borrow(f, a, b).v\n}fn f_select(u64 mask, array<u64, 6> a, array<u64,"
    " 6> b) : array<u64, 6>\n{\n    array<u64, 6> r = [0; 6];\n    for (usize i = 0; i < 6; i += 1)\n    {\n  "
    "      r[i] = (a[i] & mask) | (b[i] & ~mask);\n    }\n    r\n}fn f_add(ref<Field, shared> f, array<u64, "
    "6> a, array<u64, 6> b) : array<u64, 6>\n{\n    array<u64, 6> r = [0; 6];\n    u64 carry = 0;\n    for (u"
    "size i = 0; i < f.n; i += 1)\n    {\n        u128 s = widen<u128>(a[i]) + widen<u128>(b[i]) + widen<u1"
    "28>(carry);\n        r[i] = narrow_wrapping<u64>(s);\n        carry = narrow_wrapping<u64>(s >> 64);\n "
    "   }\n    Borrowed d = f_sub_borrow(f, r, f.m);\n    f_select(wrapping_sub(0, (1 - carry) & d.borrow),"
    " r, d.v)\n}fn f_sub(ref<Field, shared> f, array<u64, 6> a, array<u64, 6> b) : array<u64, 6>\n{\n    Bor"
    "rowed d = f_sub_borrow(f, a, b);\n    array<u64, 6> m = f_select(wrapping_sub(0, d.borrow), f.m, [0; "
    "6]);\n    f_add_raw(f, d.v, m)\n}fn f_add_raw(ref<Field, shared> f, array<u64, 6> a, array<u64, 6> b) "
    ": array<u64, 6>\n{\n    array<u64, 6> r = [0; 6];\n    u64 carry = 0;\n    for (usize i = 0; i < f.n; i "
    "+= 1)\n    {\n        u128 s = widen<u128>(a[i]) + widen<u128>(b[i]) + widen<u128>(carry);\n        r[i"
    "] = narrow_wrapping<u64>(s);\n        carry = narrow_wrapping<u64>(s >> 64);\n    }\n    r\n}fn f_is_zer"
    "o(ref<Field, shared> f, array<u64, 6> a) : bool\n{\n    u64 acc = 0;\n    for (usize i = 0; i < f.n; i "
    "+= 1)\n    {\n        acc = acc | a[i];\n    }\n    acc == 0\n}fn f_to_mont(ref<Field, shared> f, array<u"
    "64, 6> a) : array<u64, 6>\n{\n    mont_mul(f, a, f.r2)\n}fn f_from_mont(ref<Field, shared> f, array<u64"
    ", 6> a) : array<u64, 6>\n{\n    mont_mul(f, a, [1, 0, 0, 0, 0, 0])\n}fn f_invert(ref<Field, shared> f, "
    "array<u64, 6> a) : array<u64, 6>\n{\n    array<u64, 6> e = f_sub_raw(f, f.m, [2, 0, 0, 0, 0, 0]);\n    "
    "array<u64, 6> r = f_to_mont(f, [1, 0, 0, 0, 0, 0]);\n    usize bits = 64 * f.n;\n    usize i = bits;\n "
    "   while (i > 0)\n    {\n        i -= 1;\n        r = mont_mul(f, r, r);\n        if (((e[i / 64] >> nar"
    "row<u32>(i % 64)) & 1) == 1)\n        {\n            r = mont_mul(f, r, a);\n        }\n    }\n    r\n}fn "
    "f_from_be(ref<Field, shared> f, slice<u8, shared> b) : Option<array<u64, 6>>\n{\n    usize len = slice"
    "_len(b);\n    if (len > 8 * f.n)\n    {\n        return None;\n    }\n    array<u64, 6> r = [0; 6];\n    f"
    "or (usize k = 0; k < len; k += 1)\n    {\n        usize pos = len - 1 - k;\n        r[k / 8] = r[k / 8]"
    " | (widen<u64>(b[pos]) << narrow<u32>(8 * (k % 8)));\n    }\n    if (!f_less(f, r, f.m))\n    {\n       "
    " return None;\n    }\n    Some(r)\n}fn f_bit(array<u64, 6> a, usize i) : bool\n{\n    ((a[i / 64] >> narr"
    "ow<u32>(i % 64)) & 1) == 1\n}fn f_small(ref<Field, shared> f, u64 k, array<u64, 6> a) : array<u64, 6>"
    "\n{\n    array<u64, 6> r = a;\n    u32 top = 63 - leading_zeros(k);\n    u32 i = top;\n    while (i > 0)\n"
    "    {\n        i -= 1;\n        r = f_add(f, r, r);\n        if (((k >> i) & 1) == 1)\n        {\n       "
    "     r = f_add(f, r, a);\n        }\n    }\n    r\n}fn jac_double(ref<Field, shared> f, Jacobian q) : Ja"
    "cobian\n{\n    if (f_is_zero(f, q.z) || f_is_zero(f, q.y))\n    {\n        return Jacobian { .x = q.x, ."
    "y = q.y, .z = [0; 6] };\n    }\n    array<u64, 6> delta = mont_mul(f, q.z, q.z);\n    array<u64, 6> gam"
    "ma = mont_mul(f, q.y, q.y);\n    array<u64, 6> beta = mont_mul(f, q.x, gamma);\n    array<u64, 6> alph"
    "a = f_small(f, 3, mont_mul(f, f_sub(f, q.x, delta), f_add(f, q.x, delta)));\n    array<u64, 6> x3 = f"
    "_sub(f, mont_mul(f, alpha, alpha), f_small(f, 8, beta));\n    array<u64, 6> yz = f_add(f, q.y, q.z);\n"
    "    array<u64, 6> z3 = f_sub(f, f_sub(f, mont_mul(f, yz, yz), gamma), delta);\n    array<u64, 6> y3 ="
    " f_sub(\n        f,\n        mont_mul(f, alpha, f_sub(f, f_small(f, 4, beta), x3)),\n        f_small(f,"
    " 8, mont_mul(f, gamma, gamma)),\n    );\n    Jacobian { .x = x3, .y = y3, .z = z3 }\n}fn jac_add(ref<Fi"
    "eld, shared> f, Jacobian a, Jacobian b) : Jacobian\n{\n    if (f_is_zero(f, a.z))\n    {\n        return"
    " b;\n    }\n    if (f_is_zero(f, b.z))\n    {\n        return a;\n    }\n    array<u64, 6> z1z1 = mont_mul"
    "(f, a.z, a.z);\n    array<u64, 6> z2z2 = mont_mul(f, b.z, b.z);\n    array<u64, 6> u1 = mont_mul(f, a."
    "x, z2z2);\n    array<u64, 6> u2 = mont_mul(f, b.x, z1z1);\n    array<u64, 6> s1 = mont_mul(f, mont_mul"
    "(f, a.y, b.z), z2z2);\n    array<u64, 6> s2 = mont_mul(f, mont_mul(f, b.y, a.z), z1z1);\n    array<u64"
    ", 6> h = f_sub(f, u2, u1);\n    array<u64, 6> r = f_small(f, 2, f_sub(f, s2, s1));\n    if (f_is_zero("
    "f, h))\n    {\n        if (f_is_zero(f, r))\n        {\n            return jac_double(f, a);\n        }\n "
    "       return Jacobian { .x = a.x, .y = a.y, .z = [0; 6] };\n    }\n    array<u64, 6> h2 = f_small(f, "
    "2, h);\n    array<u64, 6> i = mont_mul(f, h2, h2);\n    array<u64, 6> j = mont_mul(f, h, i);\n    array"
    "<u64, 6> v = mont_mul(f, u1, i);\n    array<u64, 6> x3 = f_sub(f, f_sub(f, mont_mul(f, r, r), j), f_s"
    "mall(f, 2, v));\n    array<u64, 6> y3 = f_sub(f, mont_mul(f, r, f_sub(f, v, x3)), f_small(f, 2, mont_"
    "mul(f, s1, j)));\n    array<u64, 6> zs = f_add(f, a.z, b.z);\n    array<u64, 6> z3 = mont_mul(f, f_sub"
    "(f, f_sub(f, mont_mul(f, zs, zs), z1z1), z2z2), h);\n    Jacobian { .x = x3, .y = y3, .z = z3 }\n}fn j"
    "ac_table(ref<Field, shared> f, Jacobian p) : Vec<Jacobian>\n{\n    Vec<Jacobian> t = Vec::new();\n    V"
    "ec::push(&mut t, Jacobian { .x = p.x, .y = p.y, .z = [0; 6] });\n    Vec::push(&mut t, p);\n    for (u"
    "size i = 2; i < 16; i += 1)\n    {\n        Jacobian next = if (i % 2 == 0) { jac_double(f, t[i / 2]) "
    "} else { jac_add(f, t[i - 1], p) };\n        Vec::push(&mut t, next);\n    }\n    t\n}fn f_nibble(array<"
    "u64, 6> a, usize w) : usize\n{\n    narrow<usize>((a[w / 16] >> narrow<u32>(4 * (w % 16))) & 15)\n}fn j"
    "ac_twin(ref<Field, shared> f, array<u64, 6> u1, Jacobian g, array<u64, 6> u2, Jacobian q, usize bits"
    ") : Jacobian\n{\n    Vec<Jacobian> tg = jac_table(f, g);\n    Vec<Jacobian> tq = jac_table(f, q);\n    J"
    "acobian acc = tg[0];\n    usize w = bits / 4;\n    while (w > 0)\n    {\n        w -= 1;\n        for (us"
    "ize k = 0; k < 4; k += 1)\n        {\n            acc = jac_double(f, acc);\n        }\n        usize d1"
    " = f_nibble(u1, w);\n        usize d2 = f_nibble(u2, w);\n        if (d1 != 0)\n        {\n            a"
    "cc = jac_add(f, acc, tg[d1]);\n        }\n        if (d2 != 0)\n        {\n            acc = jac_add(f, "
    "acc, tq[d2]);\n        }\n    }\n    acc\n}fn jac_twin_bits(\n    ref<Field, shared> f,\n    array<u64, 6>"
    " u1,\n    Jacobian g,\n    array<u64, 6> u2,\n    Jacobian q,\n    usize bits,\n) : Jacobian\n{\n    Jacobi"
    "an gq = jac_add(f, g, q);\n    Jacobian acc = Jacobian { .x = g.x, .y = g.y, .z = [0; 6] };\n    usize"
    " i = bits;\n    while (i > 0)\n    {\n        i -= 1;\n        acc = jac_double(f, acc);\n        bool b1"
    " = f_bit(u1, i);\n        bool b2 = f_bit(u2, i);\n        if (b1 && b2)\n        {\n            acc = j"
    "ac_add(f, acc, gq);\n        }\n        else if (b1)\n        {\n            acc = jac_add(f, acc, g);\n "
    "       }\n        else if (b2)\n        {\n            acc = jac_add(f, acc, q);\n        }\n    }\n    ac"
    "c\n}fn curve_hex(ref<Field, shared> f, str hex) : array<u64, 6>\n{\n    Vec<u8> b = Result::unwrap_or(f"
    "rom_hex(StringView::of(hex)), Vec::new());\n    Option::unwrap(f_from_be(f, &b[0..$]))\n}fn der_positi"
    "ve_int(slice<u8, shared> d, usize at) : Option<DerSpan>\n{\n    if (at + 2 > slice_len(d) || d[at] != "
    "0x02)\n    {\n        return None;\n    }\n    usize len = widen<usize>(d[at + 1]);\n    usize start = at"
    " + 2;\n    if (len == 0 || len > 0x7f || start + len > slice_len(d))\n    {\n        return None;\n    }"
    "\n    if ((d[start] & 0x80) != 0)\n    {\n        return None;\n    }\n    if (len > 1 && d[start] == 0 &"
    "& (d[start + 1] & 0x80) == 0)\n    {\n        return None;\n    }\n    // A leading zero byte only marks"
    " the number positive.\n    usize from = if (d[start] == 0 && len > 1) { start + 1 } else { start };\n "
    "   Some(DerSpan { .start = from, .end = start + len })\n}export fn ecdsa_verify(\n    EcCurve curve,\n "
    "   slice<u8, shared> public_key,\n    slice<u8, shared> digest,\n    slice<u8, shared> signature,\n) : "
    "bool\n{\n    Field fp = field_of(curve, false);\n    Field fn_ = field_of(curve, true);\n    usize size "
    "= 8 * fp.n;\n    if (slice_len(public_key) != 1 + 2 * size || public_key[0] != 0x04)\n    {\n        re"
    "turn false;\n    }\n    array<u64, 6> qx = match (f_from_be(&fp, &public_key[1..1 + size]))\n    {\n    "
    "    Some(v) : f_to_mont(&fp, v),\n        None    : return false,\n    };\n    array<u64, 6> qy = match"
    " (f_from_be(&fp, &public_key[1 + size..$]))\n    {\n        Some(v) : f_to_mont(&fp, v),\n        None "
    "   : return false,\n    };\n    str b_hex = match (curve)\n    {\n        P256 : \"5ac635d8aa3a93e7b3ebbd"
    "55769886bc651d06b0cc53b0f63bce3c3e27d2604b\",\n        P384 : \"b3312fa7e23ee7e4988e056be3f82d19181d9c6"
    "efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef\",\n    };\n    array<u64, 6> b = f_to_mont(&"
    "fp, curve_hex(&fp, b_hex));\n    // y² = x³ - 3x + b\n    array<u64, 6> lhs = mont_mul(&fp, qy, qy);"
    "\n    array<u64, 6> rhs = f_add(&fp, f_sub(&fp, mont_mul(&fp, mont_mul(&fp, qx, qx), qx), f_small(&fp"
    ", 3, qx)), b);\n    if (!f_is_zero(&fp, f_sub(&fp, lhs, rhs)))\n    {\n        return false;\n    }\n    "
    "usize sl = slice_len(signature);\n    if (sl < 8 || signature[0] != 0x30 || signature[1] > 0x7f || wi"
    "den<usize>(signature[1]) != sl - 2)\n    {\n        return false;\n    }\n    DerSpan rs = match (der_po"
    "sitive_int(signature, 2))\n    {\n        Some(v) : v,\n        None    : return false,\n    };\n    DerS"
    "pan ss = match (der_positive_int(signature, rs.end))\n    {\n        Some(v) : v,\n        None    : re"
    "turn false,\n    };\n    if (ss.end != sl)\n    {\n        return false;\n    }\n    array<u64, 6> r = mat"
    "ch (f_from_be(&fn_, &signature[rs.start..rs.end]))\n    {\n        Some(v) : v,\n        None    : retu"
    "rn false,\n    };\n    array<u64, 6> s = match (f_from_be(&fn_, &signature[ss.start..ss.end]))\n    {\n "
    "       Some(v) : v,\n        None    : return false,\n    };\n    if (f_is_zero(&fn_, r) || f_is_zero(&"
    "fn_, s))\n    {\n        return false;\n    }\n    // e: the digest's leftmost 8·size bits (the order's"
    " bit length is the\n    // prime's for both curves), reduced once below n.\n    usize take = min(slice"
    "_len(digest), size);\n    array<u64, 6> e = [0; 6];\n    for (usize k = 0; k < take; k += 1)\n    {\n   "
    "     usize pos = take - 1 - k;\n        e[k / 8] = e[k / 8] | (widen<u64>(digest[pos]) << narrow<u32>"
    "(8 * (k % 8)));\n    }\n    if (!f_less(&fn_, e, fn_.m))\n    {\n        e = f_sub_raw(&fn_, e, fn_.m);\n"
    "    }\n    array<u64, 6> w = f_invert(&fn_, f_to_mont(&fn_, s));\n    array<u64, 6> u1 = f_from_mont(&"
    "fn_, mont_mul(&fn_, f_to_mont(&fn_, e), w));\n    array<u64, 6> u2 = f_from_mont(&fn_, mont_mul(&fn_,"
    " f_to_mont(&fn_, r), w));\n    str gx = match (curve)\n    {\n        P256 : \"6b17d1f2e12c4247f8bce6e56"
    "3a440f277037d812deb33a0f4a13945d898c296\",\n        P384 : \"aa87ca22be8b05378eb1c71ef320ad746e1d3b628b"
    "a79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7\",\n    };\n    str gy = match (curve)\n    {\n   "
    "     P256 : \"4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5\",\n        P384 : \"3617"
    "de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f\",\n    }"
    ";\n    array<u64, 6> one = f_to_mont(&fp, [1, 0, 0, 0, 0, 0]);\n    Jacobian g = Jacobian { .x = f_to_"
    "mont(\n        &fp,\n        curve_hex(&fp, gx),\n    ), .y = f_to_mont(&fp, curve_hex(&fp, gy)), .z = "
    "one };\n    Jacobian q = Jacobian { .x = qx, .y = qy, .z = one };\n    Jacobian p = jac_twin(&fp, u1, "
    "g, u2, q, size * 8);\n    if (f_is_zero(&fp, p.z))\n    {\n        return false;\n    }\n    // x mod n ="
    " r, without inverting Z: x = X/Z², and x mod n is r exactly\n    // when x is r or (as x < p < 2n fo"
    "r both curves) r + n, the latter only\n    // possible when r + n < p. So compare X with r·Z² and ("
    "r + n)·Z².\n    array<u64, 6> z2 = mont_mul(&fp, p.z, p.z);\n    if (f_is_zero(&fp, f_sub(&fp, p.x, "
    "mont_mul(&fp, f_to_mont(&fp, r), z2))))\n    {\n        return true;\n    }\n    array<u64, 6> rn = f_ad"
    "d_raw(&fp, r, fn_.m);\n    if (f_less(&fn_, rn, fp.m) && f_less(&fn_, r, rn))\n    {\n        return f_"
    "is_zero(&fp, f_sub(&fp, p.x, mont_mul(&fp, f_to_mont(&fp, rn), z2)));\n    }\n    false\n}fn curve_b_he"
    "x(EcCurve c) : str\n{\n    match (c)\n    {\n        P256 : \"5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc5"
    "3b0f63bce3c3e27d2604b\",\n        P384 : \"b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013"
    "875ac656398d8a2ed19d2a85c8edd3ec2aef\",\n    }\n}fn curve_base(ref<Field, shared> fp, EcCurve c) : Jaco"
    "bian\n{\n    str gx = match (c)\n    {\n        P256 : \"6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0"
    "f4a13945d898c296\",\n        P384 : \"aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385"
    "502f25dbf55296c3a545e3872760ab7\",\n    };\n    str gy = match (c)\n    {\n        P256 : \"4fe342e2fe1a7f"
    "9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5\",\n        P384 : \"3617de4a96262c6f5d9e98bf9292dc2"
    "9f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f\",\n    };\n    Jacobian { .x = f_to_"
    "mont(\n        fp,\n        curve_hex(fp, gx),\n    ), .y = f_to_mont(fp, curve_hex(fp, gy)), .z = f_to"
    "_mont(fp, [1, 0, 0, 0, 0, 0]) }\n}fn curve_point(ref<Field, shared> fp, EcCurve c, slice<u8, shared> "
    "public_key) : Option<Jacobian>\n{\n    usize size = 8 * fp.n;\n    if (slice_len(public_key) != 1 + 2 *"
    " size || public_key[0] != 0x04)\n    {\n        return None;\n    }\n    array<u64, 6> qx = f_to_mont(fp"
    ", f_from_be(fp, &public_key[1..1 + size])?);\n    array<u64, 6> qy = f_to_mont(fp, f_from_be(fp, &pub"
    "lic_key[1 + size..$])?);\n    array<u64, 6> b = f_to_mont(fp, curve_hex(fp, curve_b_hex(c)));\n    arr"
    "ay<u64, 6> lhs = mont_mul(fp, qy, qy);\n    array<u64, 6> rhs = f_add(fp, f_sub(fp, mont_mul(fp, mont"
    "_mul(fp, qx, qx), qx), f_small(fp, 3, qx)), b);\n    if (!f_is_zero(fp, f_sub(fp, lhs, rhs)))\n    {\n "
    "       return None;\n    }\n    Some(Jacobian { .x = qx, .y = qy, .z = f_to_mont(fp, [1, 0, 0, 0, 0, 0"
    "]) })\n}fn jac_select(u64 mask, Jacobian a, Jacobian b) : Jacobian\n{\n    Jacobian { .x = f_select(mas"
    "k, a.x, b.x), .y = f_select(mask, a.y, b.y), .z = f_select(mask, a.z, b.z) }\n}fn limbs7_add(array<u6"
    "4, 7> a, array<u64, 7> b) : array<u64, 7>\n{\n    array<u64, 7> r = [0; 7];\n    u64 carry = 0;\n    for"
    " (usize i = 0; i < 7; i += 1)\n    {\n        u128 s = widen<u128>(a[i]) + widen<u128>(b[i]) + widen<u"
    "128>(carry);\n        r[i] = narrow_wrapping<u64>(s);\n        carry = narrow_wrapping<u64>(s >> 64);\n"
    "    }\n    r\n}fn ec_mul(ref<Field, shared> fp, ref<Field, shared> fn_, array<u64, 6> k, Jacobian p) :"
    " Jacobian\n{\n    usize bits = 64 * fp.n;\n    array<u64, 7> n7 = [fn_.m[0], fn_.m[1], fn_.m[2], fn_.m["
    "3], fn_.m[4], fn_.m[5], 0];\n    array<u64, 7> k1 = limbs7_add([k[0], k[1], k[2], k[3], k[4], k[5], 0"
    "], n7);\n    array<u64, 7> k2 = limbs7_add(k1, n7);\n    // k + n when that reaches 2^bits, k + 2n oth"
    "erwise: bit `bits` is set\n    // and nothing above it.\n    u64 mask = wrapping_sub(0, k1[bits / 64] "
    "& 1);\n    array<u64, 7> kh = [0; 7];\n    for (usize i = 0; i < 7; i += 1)\n    {\n        kh[i] = (k1["
    "i] & mask) | (k2[i] & ~mask);\n    }\n    Jacobian acc = p;\n    usize i = bits;\n    while (i > 0)\n    "
    "{\n        i -= 1;\n        acc = jac_double(fp, acc);\n        Jacobian sum = jac_add(fp, acc, p);\n   "
    "     u64 bit = (kh[i / 64] >> narrow<u32>(i % 64)) & 1;\n        acc = jac_select(wrapping_sub(0, bit"
    "), sum, acc);\n    }\n    acc\n}fn limbs_be(array<u64, 6> a, usize len) : Vec<u8>\n{\n    Vec<u8> b = Vec"
    "::filled(len, 0: u8);\n    for (usize i = 0; i < len; i += 1)\n    {\n        b[len - 1 - i] = narrow_w"
    "rapping<u8>(a[i / 8] >> narrow<u32>(8 * (i % 8)));\n    }\n    b\n}fn ec_scalar(ref<Field, shared> fn_,"
    " slice<u8, shared> private_key) : Option<array<u64, 6>>\n{\n    if (slice_len(private_key) != 8 * fn_."
    "n)\n    {\n        fault(crypto_length);\n    }\n    match (f_from_be(fn_, private_key))\n    {\n        S"
    "ome(k) : if (f_is_zero(fn_, k)) { None } else { Some(k) },\n        None    : None,\n    }\n}fn ec_affi"
    "ne(ref<Field, shared> fp, Jacobian q) : array<array<u64, 6>, 2>\n{\n    array<u64, 6> zinv = f_invert("
    "fp, q.z);\n    array<u64, 6> zinv2 = mont_mul(fp, zinv, zinv);\n    array<u64, 6> x = f_from_mont(fp, "
    "mont_mul(fp, q.x, zinv2));\n    array<u64, 6> y = f_from_mont(fp, mont_mul(fp, q.y, mont_mul(fp, zinv"
    "2, zinv)));\n    [x, y]\n}export fn ec_private_key(EcCurve curve) : Vec<u8>\n{\n    Field fn_ = field_of"
    "(curve, true);\n    Vec<u8> k = Vec::filled(8 * fn_.n, 0: u8);\n    while (true)\n    {\n        os_rand"
    "om_bytes(&mut k[0..$]);\n        if (Option::is_some(&ec_scalar(&fn_, &k[0..$])))\n        {\n         "
    "   return k;\n        }\n    }\n}export fn ec_public_key(EcCurve curve, slice<u8, shared> private_key) "
    ": Option<Vec<u8>>\n{\n    Field fp = field_of(curve, false);\n    Field fn_ = field_of(curve, true);\n  "
    "  array<u64, 6> k = ec_scalar(&fn_, private_key)?;\n    usize size = 8 * fp.n;\n    array<array<u64, 6"
    ">, 2> xy = ec_affine(&fp, ec_mul(&fp, &fn_, k, curve_base(&fp, curve)));\n    Vec<u8> out = Vec::new("
    ");\n    Vec::push(&mut out, 0x04);\n    Vec::extend_from(&mut out, &limbs_be(xy[0], size)[0..$]);\n    "
    "Vec::extend_from(&mut out, &limbs_be(xy[1], size)[0..$]);\n    Some(out)\n}unittest \"ec_public_key: a "
    "scalar outside [1, n-1] has none\"\n{\n    array<u8, 32> zero = [0; 32];\n    assert(Option::is_none(&ec"
    "_public_key(P256, &zero[0..$])));\n    array<u8, 32> above = [0xff; 32];\n    assert(Option::is_none(&"
    "ec_public_key(P256, &above[0..$])));\n}export fn ecdh(EcCurve curve, slice<u8, shared> private_key, s"
    "lice<u8, shared> public_key) : Option<Vec<u8>>\n{\n    Field fp = field_of(curve, false);\n    Field fn"
    "_ = field_of(curve, true);\n    array<u64, 6> k = ec_scalar(&fn_, private_key)?;\n    Jacobian q = cur"
    "ve_point(&fp, curve, public_key)?;\n    Jacobian r = ec_mul(&fp, &fn_, k, q);\n    if (f_is_zero(&fp, "
    "r.z))\n    {\n        return None;\n    }\n    Some(limbs_be(ec_affine(&fp, r)[0], 8 * fp.n))\n}export fn"
    " p256_private_key() : array<u8, 32>\n{\n    Vec<u8> k = ec_private_key(P256);\n    array<u8, 32> out = "
    "[0; 32];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        out[i] = k[i];\n    }\n    out\n}export fn"
    " p256_public_key(slice<u8, shared> private_key) : Option<array<u8, 65>>\n{\n    Vec<u8> q = ec_public_"
    "key(P256, private_key)?;\n    array<u8, 65> out = [0; 65];\n    for (usize i = 0; i < 65; i += 1)\n    "
    "{\n        out[i] = q[i];\n    }\n    Some(out)\n}export fn p256_ecdh(slice<u8, shared> private_key, sli"
    "ce<u8, shared> public_key) : Option<array<u8, 32>>\n{\n    Vec<u8> z = ecdh(P256, private_key, public_"
    "key)?;\n    array<u8, 32> out = [0; 32];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        out[i] ="
    " z[i];\n    }\n    Some(out)\n}fn digest_scalar(ref<Field, shared> fn_, slice<u8, shared> digest, usize"
    " size) : array<u64, 6>\n{\n    usize take = min(slice_len(digest), size);\n    array<u64, 6> e = [0; 6]"
    ";\n    for (usize k = 0; k < take; k += 1)\n    {\n        usize pos = take - 1 - k;\n        e[k / 8] ="
    " e[k / 8] | (widen<u64>(digest[pos]) << narrow<u32>(8 * (k % 8)));\n    }\n    if (!f_less(fn_, e, fn_"
    ".m))\n    {\n        e = f_sub_raw(fn_, e, fn_.m);\n    }\n    e\n}fn der_push_uint(ref<Vec<u8>, exclusiv"
    "e> out, slice<u8, shared> v)\n{\n    usize from = 0;\n    while (from + 1 < slice_len(v) && v[from] == "
    "0)\n    {\n        from += 1;\n    }\n    bool pad = (v[from] & 0x80) != 0;\n    Vec::push(out, 0x02);\n  "
    "  Vec::push(out, narrow<u8>(slice_len(v) - from + (if (pad) { 1 } else { 0 })));\n    if (pad)\n    {\n"
    "        Vec::push(out, 0);\n    }\n    Vec::extend_from(out, &v[from..$]);\n}export fn ecdsa_sign(EcCur"
    "ve curve, slice<u8, shared> private_key, slice<u8, shared> digest) : Option<Vec<u8>>\n{\n    Field fp "
    "= field_of(curve, false);\n    Field fn_ = field_of(curve, true);\n    usize size = 8 * fp.n;\n    arra"
    "y<u64, 6> x = ec_scalar(&fn_, private_key)?;\n    HashKind kind = match (curve)\n    {\n        P256 : "
    "Sha2_256,\n        P384 : Sha2_384,\n    };\n    array<u64, 6> e = digest_scalar(&fn_, digest, size);\n "
    "   Vec<u8> x_bytes = limbs_be(x, size);\n    Vec<u8> e_bytes = limbs_be(e, size);\n    Jacobian g = cu"
    "rve_base(&fp, curve);\n    array<u64, 6> xm = f_to_mont(&fn_, x);\n    array<u64, 6> em = f_to_mont(&f"
    "n_, e);\n    // RFC 6979 §3.2 steps b to h.\n    usize hlen = hash_len(kind);\n    Vec<u8> v = Vec::fi"
    "lled(hlen, 1: u8);\n    Vec<u8> key = Vec::filled(hlen, 0: u8);\n    for (u8 round = 0; round < 2; rou"
    "nd += 1)\n    {\n        Hmac m = Hmac::new(kind, &key[0..$]);\n        Hmac::update(&mut m, &v[0..$]);"
    "\n        array<u8, 1> sep = [round];\n        Hmac::update(&mut m, &sep[0..$]);\n        Hmac::update("
    "&mut m, &x_bytes[0..$]);\n        Hmac::update(&mut m, &e_bytes[0..$]);\n        overwrite(&mut key, H"
    "mac::finish(m));\n        overwrite(&mut v, hmac(kind, &key[0..$], &v[0..$]));\n    }\n    while (true)"
    "\n    {\n        overwrite(&mut v, hmac(kind, &key[0..$], &v[0..$]));\n        // T is V itself: the ha"
    "sh is as long as the order for both curves.\n        Option<array<u64, 6>> candidate = f_from_be(&fn_"
    ", &v[0..size]);\n        if (Some(k) = candidate)\n        {\n            if (!f_is_zero(&fn_, k))\n    "
    "        {\n                array<u64, 6> r = ec_affine(&fp, ec_mul(&fp, &fn_, k, g))[0];\n            "
    "    if (!f_less(&fn_, r, fn_.m))\n                {\n                    r = f_sub_raw(&fn_, r, fn_.m)"
    ";\n                }\n                if (!f_is_zero(&fn_, r))\n                {\n                    a"
    "rray<u64, 6> kinv = f_invert(&fn_, f_to_mont(&fn_, k));\n                    array<u64, 6> rx = mont_"
    "mul(&fn_, f_to_mont(&fn_, r), xm);\n                    array<u64, 6> s = f_from_mont(&fn_, mont_mul("
    "&fn_, kinv, f_add(&fn_, em, rx)));\n                    if (!f_is_zero(&fn_, s))\n                    "
    "{\n                        Vec<u8> body = Vec::new();\n                        der_push_uint(&mut body"
    ", &limbs_be(r, size)[0..$]);\n                        der_push_uint(&mut body, &limbs_be(s, size)[0.."
    "$]);\n                        Vec<u8> out = Vec::new();\n                        Vec::push(&mut out, 0"
    "x30);\n                        Vec::push(&mut out, narrow<u8>(Vec::len(&body)));\n                    "
    "    Vec::extend_from(&mut out, &body[0..$]);\n                        return Some(out);\n             "
    "       }\n                }\n            }\n        }\n        Hmac m = Hmac::new(kind, &key[0..$]);\n   "
    "     Hmac::update(&mut m, &v[0..$]);\n        array<u8, 1> zero = [0];\n        Hmac::update(&mut m, &"
    "zero[0..$]);\n        overwrite(&mut key, Hmac::finish(m));\n        overwrite(&mut v, hmac(kind, &key"
    "[0..$], &v[0..$]));\n    }\n}fn fe_neg(array<u64, 5> a) : array<u64, 5>\n{\n    fe_sub([0, 0, 0, 0, 0], "
    "a)\n}fn fe_is_zero(array<u64, 5> a) : bool\n{\n    array<u8, 32> b = fe_to_bytes(a);\n    u8 acc = 0;\n  "
    "  for (usize i = 0; i < 32; i += 1)\n    {\n        acc = acc | b[i];\n    }\n    acc == 0\n}fn fe_eq(arr"
    "ay<u64, 5> a, array<u64, 5> b) : bool\n{\n    fe_is_zero(fe_sub(a, b))\n}fn fe_select(u64 mask, array<u"
    "64, 5> a, array<u64, 5> b) : array<u64, 5>\n{\n    array<u64, 5> r = [0; 5];\n    for (usize i = 0; i <"
    " 5; i += 1)\n    {\n        r[i] = (a[i] & mask) | (b[i] & ~mask);\n    }\n    r\n}fn fe_pow_p58(array<u6"
    "4, 5> z) : array<u64, 5>\n{\n    array<u64, 5> r = [1, 0, 0, 0, 0];\n    for (usize k = 0; k < 252; k +"
    "= 1)\n    {\n        usize i = 251 - k;\n        r = fe_mul(r, r);\n        if (i != 1)\n        {\n      "
    "      r = fe_mul(r, z);\n        }\n    }\n    r\n}fn ed_identity() : Ed\n{\n    Ed { .x = [0, 0, 0, 0, 0]"
    ", .y = [1, 0, 0, 0, 0], .z = [1, 0, 0, 0, 0], .t = [0, 0, 0, 0, 0] }\n}fn ed_base() : Ed\n{\n    Ed { ."
    "x = ED_BX, .y = ED_BY, .z = [1, 0, 0, 0, 0], .t = fe_mul(ED_BX, ED_BY) }\n}fn ed_add(Ed p, Ed q) : Ed"
    "\n{\n    array<u64, 5> a = fe_mul(fe_sub(p.y, p.x), fe_sub(q.y, q.x));\n    array<u64, 5> b = fe_mul(fe"
    "_add(p.y, p.x), fe_add(q.y, q.x));\n    array<u64, 5> c = fe_mul(fe_mul(p.t, ED_2D), q.t);\n    array<"
    "u64, 5> d = fe_mul(fe_add(p.z, p.z), q.z);\n    array<u64, 5> e = fe_sub(b, a);\n    array<u64, 5> f ="
    " fe_sub(d, c);\n    array<u64, 5> g = fe_add(d, c);\n    array<u64, 5> h = fe_add(b, a);\n    Ed { .x ="
    " fe_mul(e, f), .y = fe_mul(g, h), .z = fe_mul(f, g), .t = fe_mul(e, h) }\n}fn ed_double(Ed p) : Ed\n{\n"
    "    array<u64, 5> a = fe_mul(p.x, p.x);\n    array<u64, 5> b = fe_mul(p.y, p.y);\n    array<u64, 5> zz"
    " = fe_mul(p.z, p.z);\n    array<u64, 5> c = fe_add(zz, zz);\n    array<u64, 5> h = fe_add(a, b);\n    a"
    "rray<u64, 5> xy = fe_add(p.x, p.y);\n    array<u64, 5> e = fe_sub(h, fe_mul(xy, xy));\n    array<u64, "
    "5> g = fe_sub(a, b);\n    array<u64, 5> f = fe_add(c, g);\n    Ed { .x = fe_mul(e, f), .y = fe_mul(g, "
    "h), .z = fe_mul(f, g), .t = fe_mul(e, h) }\n}fn ed_select(u64 mask, Ed a, Ed b) : Ed\n{\n    Ed { .x = "
    "fe_select(\n        mask,\n        a.x,\n        b.x,\n    ), .y = fe_select(mask, a.y, b.y), .z = fe_se"
    "lect(mask, a.z, b.z), .t = fe_select(mask, a.t, b.t) }\n}fn ed_mul(slice<u8, shared> scalar, Ed p) : "
    "Ed\n{\n    Ed acc = ed_identity();\n    usize i = 256;\n    while (i > 0)\n    {\n        i -= 1;\n        "
    "acc = ed_double(acc);\n        Ed sum = ed_add(acc, p);\n        u64 bit = widen<u64>((scalar[i / 8] >"
    "> narrow<u32>(i % 8)) & 1);\n        acc = ed_select(wrapping_sub(0, bit), sum, acc);\n    }\n    acc\n}"
    "fn ed_encode(Ed p) : array<u8, 32>\n{\n    array<u64, 5> zinv = fe_invert(p.z);\n    array<u8, 32> out "
    "= fe_to_bytes(fe_mul(p.y, zinv));\n    array<u8, 32> xb = fe_to_bytes(fe_mul(p.x, zinv));\n    out[31]"
    " = out[31] | ((xb[0] & 1) << 7);\n    out\n}fn ed_decode(slice<u8, shared> b) : Option<Ed>\n{\n    array"
    "<u64, 5> y = fe_from_bytes(b);\n    array<u8, 32> canon = fe_to_bytes(y);\n    u8 diff = 0;\n    for (u"
    "size i = 0; i < 31; i += 1)\n    {\n        diff = diff | (canon[i] ^ b[i]);\n    }\n    diff = diff | ("
    "canon[31] ^ (b[31] & 0x7f));\n    if (diff != 0)\n    {\n        return None;\n    }\n    u8 sign = b[31]"
    " >> 7;\n    array<u64, 5> y2 = fe_mul(y, y);\n    array<u64, 5> u = fe_sub(y2, [1, 0, 0, 0, 0]);\n    a"
    "rray<u64, 5> v = fe_add(fe_mul(ED_D, y2), [1, 0, 0, 0, 0]);\n    array<u64, 5> v3 = fe_mul(fe_mul(v, "
    "v), v);\n    array<u64, 5> v7 = fe_mul(fe_mul(v3, v3), v);\n    array<u64, 5> x = fe_mul(fe_mul(u, v3)"
    ", fe_pow_p58(fe_mul(u, v7)));\n    array<u64, 5> vx2 = fe_mul(v, fe_mul(x, x));\n    if (!fe_eq(vx2, u"
    "))\n    {\n        if (!fe_eq(vx2, fe_neg(u)))\n        {\n            return None;\n        }\n        x "
    "= fe_mul(x, ED_SQRT_M1);\n    }\n    array<u8, 32> xb = fe_to_bytes(x);\n    if ((xb[0] & 1) == 0 && si"
    "gn == 1 && fe_is_zero(x))\n    {\n        return None;\n    }\n    if ((xb[0] & 1) != sign)\n    {\n      "
    "  x = fe_neg(x);\n    }\n    Some(Ed { .x = x, .y = y, .z = [1, 0, 0, 0, 0], .t = fe_mul(x, y) })\n}fn "
    "ed_order() : Field\n{\n    Field { .m = [\n        0x5812631a5cf5d3ed,\n        0x14def9dea2f79cd6,\n    "
    "    0x0000000000000000,\n        0x1000000000000000,\n        0x0000000000000000,\n        0x0000000000"
    "000000,\n    ], .n = 4, .minv = 0xd2b51da312547e1b, .r2 = [\n        0xa40611e3449c0f01,\n        0xd00"
    "e1ba768859347,\n        0xceec73d217f5be65,\n        0x0399411b7c309a3d,\n        0x0000000000000000,\n "
    "       0x0000000000000000,\n    ] }\n}fn le_limbs(slice<u8, shared> b) : array<u64, 6>\n{\n    array<u64"
    ", 6> r = [0; 6];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        r[i / 8] = r[i / 8] | (widen<u6"
    "4>(b[i]) << narrow<u32>(8 * (i % 8)));\n    }\n    r\n}fn sc_mont(ref<Field, shared> fl, array<u64, 6> "
    "a) : array<u64, 6>\n{\n    mont_mul(fl, a, fl.r2)\n}fn sc_from_hash(ref<Field, shared> fl, slice<u8, sh"
    "ared> h) : array<u64, 6>\n{\n    array<u64, 6> lo = sc_mont(fl, le_limbs(&h[0..32]));\n    array<u64, 6"
    "> hi = sc_mont(fl, sc_mont(fl, le_limbs(&h[32..64])));\n    f_add(fl, lo, hi)\n}fn sc_bytes(ref<Field,"
    " shared> fl, array<u64, 6> m) : array<u8, 32>\n{\n    array<u64, 6> a = f_from_mont(fl, m);\n    array<"
    "u8, 32> out = [0; 32];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        out[i] = narrow_wrapping<"
    "u8>(a[i / 8] >> narrow<u32>(8 * (i % 8)));\n    }\n    out\n}fn ed_expand(slice<u8, shared> private_key"
    ") : EdExpanded\n{\n    if (slice_len(private_key) != 32)\n    {\n        fault(crypto_length);\n    }\n   "
    " array<u8, 64> h = sha512(private_key);\n    array<u8, 32> s = [0; 32];\n    array<u8, 32> prefix = [0"
    "; 32];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        s[i] = h[i];\n        prefix[i] = h[32 + i"
    "];\n    }\n    s[0] = s[0] & 248;\n    s[31] = (s[31] & 127) | 64;\n    EdExpanded { .scalar = s, .prefi"
    "x = prefix }\n}export fn ed25519_private_key() : array<u8, 32>\n{\n    array<u8, 32> k = [0; 32];\n    o"
    "s_random_bytes(&mut k[0..$]);\n    k\n}export fn ed25519_public_key(slice<u8, shared> private_key) : a"
    "rray<u8, 32>\n{\n    EdExpanded e = ed_expand(private_key);\n    ed_encode(ed_mul(&e.scalar[0..$], ed_b"
    "ase()))\n}export fn ed25519_sign(slice<u8, shared> private_key, slice<u8, shared> message) : array<u8"
    ", 64>\n{\n    EdExpanded e = ed_expand(private_key);\n    Field fl = ed_order();\n    array<u8, 32> a = "
    "ed_encode(ed_mul(&e.scalar[0..$], ed_base()));\n    Sha512 hr = Sha512::new();\n    Sha512::update(&mu"
    "t hr, &e.prefix[0..$]);\n    Sha512::update(&mut hr, message);\n    array<u64, 6> r = sc_from_hash(&fl"
    ", &Sha512::finish(hr)[0..$]);\n    array<u8, 32> r_bytes = sc_bytes(&fl, r);\n    array<u8, 32> big_r "
    "= ed_encode(ed_mul(&r_bytes[0..$], ed_base()));\n    Sha512 hk = Sha512::new();\n    Sha512::update(&m"
    "ut hk, &big_r[0..$]);\n    Sha512::update(&mut hk, &a[0..$]);\n    Sha512::update(&mut hk, message);\n "
    "   array<u64, 6> k = sc_from_hash(&fl, &Sha512::finish(hk)[0..$]);\n    array<u64, 6> s = f_add(&fl, "
    "r, mont_mul(&fl, k, sc_mont(&fl, le_limbs(&e.scalar[0..$]))));\n    array<u8, 32> s_bytes = sc_bytes("
    "&fl, s);\n    array<u8, 64> out = [0; 64];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        out[i]"
    " = big_r[i];\n        out[32 + i] = s_bytes[i];\n    }\n    out\n}export fn ed25519_verify(slice<u8, sha"
    "red> public_key, slice<u8, shared> message, slice<u8, shared> signature) : bool\n{\n    if (slice_len("
    "public_key) != 32 || slice_len(signature) != 64)\n    {\n        return false;\n    }\n    Ed a = match "
    "(ed_decode(public_key))\n    {\n        Some(p) : p,\n        None    : return false,\n    };\n    Ed big"
    "_r = match (ed_decode(&signature[0..32]))\n    {\n        Some(p) : p,\n        None    : return false,"
    "\n    };\n    Field fl = ed_order();\n    array<u64, 6> s = le_limbs(&signature[32..64]);\n    if (!f_le"
    "ss(&fl, s, fl.m))\n    {\n        return false;\n    }\n    Sha512 hk = Sha512::new();\n    Sha512::updat"
    "e(&mut hk, &signature[0..32]);\n    Sha512::update(&mut hk, public_key);\n    Sha512::update(&mut hk, "
    "message);\n    array<u8, 32> k = sc_bytes(&fl, sc_from_hash(&fl, &Sha512::finish(hk)[0..$]));\n    arr"
    "ay<u8, 32> lhs = ed_encode(ed_mul(&signature[32..64], ed_base()));\n    array<u8, 32> rhs = ed_encode"
    "(ed_add(big_r, ed_mul(&k[0..$], a)));\n    digest_eq(&lhs[0..$], &rhs[0..$])\n}fn limbs_of(ref<BigUint"
    ", shared> a, usize n) : Vec<u64>\n{\n    Vec<u8> be = BigUint::to_bytes_be_padded(a, 8 * n);\n    Vec<u"
    "64> out = Vec::filled(n, 0: u64);\n    for (usize i = 0; i < 8 * n; i += 1)\n    {\n        out[i / 8] "
    "= out[i / 8] | (widen<u64>(be[8 * n - 1 - i]) << narrow<u32>(8 * (i % 8)));\n    }\n    out\n}fn biguin"
    "t_of(ref<Vec<u64>, shared> limbs) : BigUint\n{\n    usize n = Vec::len(limbs);\n    Vec<u8> be = Vec::f"
    "illed(8 * n, 0: u8);\n    for (usize i = 0; i < 8 * n; i += 1)\n    {\n        be[8 * n - 1 - i] = narr"
    "ow_wrapping<u8>(limbs[i / 8] >> narrow<u32>(8 * (i % 8)));\n    }\n    BigUint::from_bytes_be(&be[0..$"
    "])\n}fn mont_new(ref<BigUint, shared> modulus) : Mont\n{\n    usize n = (BigUint::bit_len(modulus) + 63"
    ") / 64;\n    Vec<u64> m = limbs_of(modulus, n);\n    // m⁻¹ mod 2^64 by Newton's iteration from the"
    " odd m's own low limb.\n    u64 inv = 1;\n    for (usize i = 0; i < 7; i += 1)\n    {\n        inv = wra"
    "pping_mul(inv, wrapping_sub(2, wrapping_mul(m[0], inv)));\n    }\n    BigUint one = BigUint::from_u64("
    "1);\n    BigUint r2 = BigUint::rem(&BigUint::shift_left(&one, 128 * n), modulus);\n    Mont { .m = m, "
    ".n = n, .minv = wrapping_sub(0, inv), .r2 = limbs_of(&r2, n) }\n}fn mont_mul_v(ref<Mont, shared> f, r"
    "ef<Vec<u64>, shared> a, ref<Vec<u64>, shared> b) : Vec<u64>\n{\n    usize n = f.n;\n    Vec<u64> t = Ve"
    "c::filled(n + 2, 0: u64);\n    for (usize i = 0; i < n; i += 1)\n    {\n        u128 c = 0;\n        u12"
    "8 bi = widen<u128>(b[i]);\n        for (usize j = 0; j < n; j += 1)\n        {\n            u128 x = wi"
    "den<u128>(t[j]) + widen<u128>(a[j]) * bi + c;\n            t[j] = narrow_wrapping<u64>(x);\n          "
    "  c = x >> 64;\n        }\n        u128 y = widen<u128>(t[n]) + c;\n        t[n] = narrow_wrapping<u64>"
    "(y);\n        t[n + 1] = narrow_wrapping<u64>(y >> 64);\n        u64 k = wrapping_mul(t[0], f.minv);\n "
    "       u128 kk = widen<u128>(k);\n        u128 z = widen<u128>(t[0]) + kk * widen<u128>(f.m[0]);\n    "
    "    c = z >> 64;\n        for (usize j = 1; j < n; j += 1)\n        {\n            u128 x = widen<u128>"
    "(t[j]) + kk * widen<u128>(f.m[j]) + c;\n            t[j - 1] = narrow_wrapping<u64>(x);\n            c"
    " = x >> 64;\n        }\n        u128 w = widen<u128>(t[n]) + c;\n        t[n - 1] = narrow_wrapping<u64"
    ">(w);\n        t[n] = t[n + 1] + narrow_wrapping<u64>(w >> 64);\n    }\n    // t - m unless t (with its"
    " carry) is below m: chosen by a mask.\n    Vec<u64> r = Vec::filled(n, 0: u64);\n    u64 borrow = 0;\n "
    "   for (usize j = 0; j < n; j += 1)\n    {\n        u128 x = wrapping_sub(wrapping_sub(widen<u128>(t[j"
    "]), widen<u128>(f.m[j])), widen<u128>(borrow));\n        r[j] = narrow_wrapping<u64>(x);\n        borr"
    "ow = narrow_wrapping<u64>(x >> 127);\n    }\n    u64 keep = wrapping_sub(0, (1 - t[n]) & borrow);\n    "
    "for (usize j = 0; j < n; j += 1)\n    {\n        r[j] = (t[j] & keep) | (r[j] & ~keep);\n    }\n    r\n}f"
    "n mont_pow(ref<Mont, shared> f, ref<BigUint, shared> base, ref<BigUint, shared> exp) : BigUint\n{\n   "
    " biguint_of(&mont_pow_limbs(f, &limbs_of(base, f.n), exp))\n}fn mont_pow_limbs(ref<Mont, shared> f, r"
    "ef<Vec<u64>, shared> base, ref<BigUint, shared> exp) : Vec<u64>\n{\n    usize n = f.n;\n    Vec<u64> on"
    "e = Vec::filled(n, 0: u64);\n    one[0] = 1;\n    Vec<u64> one_m = mont_mul_v(f, &one, &f.r2);\n    Vec"
    "<u64> base_m = mont_mul_v(f, base, &f.r2);\n    Vec<Vec<u64>> table = Vec::new();\n    Vec::push(&mut "
    "table, Vec::clone(&one_m));\n    for (usize i = 1; i < 16; i += 1)\n    {\n        Vec<u64> next = mont"
    "_mul_v(f, &table[i - 1], &base_m);\n        Vec::push(&mut table, next);\n    }\n    Vec<u64> e = limbs"
    "_of(exp, n);\n    Vec<u64> acc = Vec::clone(&one_m);\n    usize windows = 16 * n;\n    usize w = window"
    "s;\n    while (w > 0)\n    {\n        w -= 1;\n        for (usize s = 0; s < 4; s += 1)\n        {\n      "
    "      overwrite(&mut acc, mont_mul_v(f, &acc, &acc));\n        }\n        u64 bits = (e[w / 16] >> nar"
    "row<u32>(4 * (w % 16))) & 15;\n        Vec<u64> entry = Vec::filled(n, 0: u64);\n        for (u64 i = "
    "0; i < 16; i += 1)\n        {\n            u64 x = i ^ bits;\n            u64 mask = wrapping_sub(((x |"
    " wrapping_sub(0, x)) >> 63), 1);\n            for (usize j = 0; j < n; j += 1)\n            {\n        "
    "        entry[j] = entry[j] | (table[narrow<usize>(i)][j] & mask);\n            }\n        }\n        o"
    "verwrite(&mut acc, mont_mul_v(f, &acc, &entry));\n    }\n    mont_mul_v(f, &acc, &one)\n}export fn RsaP"
    "rivateKey::new(BigUint n, BigUint e, BigUint d, BigUint p, BigUint q) : Option<RsaPrivateKey>\n{\n    "
    "BigUint one = BigUint::from_u64(1);\n    BigUint two = BigUint::from_u64(2);\n    if (!BigUint::less(&"
    "two, &p) || !BigUint::less(&two, &q) || !BigUint::bit(&p, 0) || !BigUint::bit(&q, 0))\n    {\n        "
    "return None;\n    }\n    if (!BigUint::eq(&BigUint::mul(&p, &q), &n))\n    {\n        return None;\n    }"
    "\n    BigUint p1 = BigUint::sub(&p, &one);\n    BigUint q1 = BigUint::sub(&q, &one);\n    BigUint ed = "
    "BigUint::mul(&e, &d);\n    if (!BigUint::eq(&BigUint::rem(&ed, &p1), &one) || !BigUint::eq(&BigUint::"
    "rem(&ed, &q1), &one))\n    {\n        return None;\n    }\n    BigUint dp = BigUint::rem(&d, &p1);\n    B"
    "igUint dq = BigUint::rem(&d, &q1);\n    BigUint qinv = BigUint::mod_inverse(&q, &p)?;\n    Some(RsaPri"
    "vateKey { .n = n, .e = e, .d = d, .p = p, .q = q, .dp = dp, .dq = dq, .qinv = qinv })\n}unittest \"Rsa"
    "PrivateKey::new: parts that do not fit are refused\"\n{\n    BigUint n = BigUint::from_u64(3233);\n    B"
    "igUint e = BigUint::from_u64(17);\n    BigUint p = BigUint::from_u64(61);\n    BigUint q = BigUint::fr"
    "om_u64(53);\n    Option<RsaPrivateKey> good = RsaPrivateKey::new(n, e, BigUint::from_u64(2753), p, q)"
    ";\n    assert(Option::is_some(&good));\n    Option<RsaPrivateKey> bad = RsaPrivateKey::new(\n        Bi"
    "gUint::from_u64(3233),\n        BigUint::from_u64(17),\n        BigUint::from_u64(2754),\n        BigUi"
    "nt::from_u64(61),\n        BigUint::from_u64(53),\n    );\n    assert(Option::is_none(&bad));\n}export f"
    "n RsaPrivateKey::public_key(ref<RsaPrivateKey, shared> key) : RsaPublicKey\n{\n    RsaPublicKey { .n ="
    " BigUint::clone(&key.n), .e = BigUint::clone(&key.e) }\n}fn limbs_sub_mod(ref<Mont, shared> f, ref<Ve"
    "c<u64>, shared> a, ref<Vec<u64>, shared> b) : Vec<u64>\n{\n    usize n = f.n;\n    Vec<u64> r = Vec::fi"
    "lled(n, 0: u64);\n    u64 borrow = 0;\n    for (usize j = 0; j < n; j += 1)\n    {\n        u128 x = wra"
    "pping_sub(wrapping_sub(widen<u128>(a[j]), widen<u128>(b[j])), widen<u128>(borrow));\n        r[j] = n"
    "arrow_wrapping<u64>(x);\n        borrow = narrow_wrapping<u64>(x >> 127);\n    }\n    // Add m back whe"
    "re it borrowed.\n    u64 mask = wrapping_sub(0, borrow);\n    u64 carry = 0;\n    for (usize j = 0; j <"
    " n; j += 1)\n    {\n        u128 x = widen<u128>(r[j]) + widen<u128>(f.m[j] & mask) + widen<u128>(carr"
    "y);\n        r[j] = narrow_wrapping<u64>(x);\n        carry = narrow_wrapping<u64>(x >> 64);\n    }\n   "
    " r\n}fn rsa_private_op(ref<RsaPrivateKey, shared> key, ref<BigUint, shared> m) : BigUint\n{\n    Mont m"
    "p = mont_new(&key.p);\n    Mont mq = mont_new(&key.q);\n    usize np = mp.n;\n    usize nq = mq.n;\n    "
    "// m1 = m^dp mod p, m2 = m^dq mod q (m reduced: public values).\n    Vec<u64> m1 = mont_pow_limbs(&mp"
    ", &limbs_of(&BigUint::rem(m, &key.p), np), &key.dp);\n    Vec<u64> m2 = mont_pow_limbs(&mq, &limbs_of"
    "(&BigUint::rem(m, &key.q), nq), &key.dq);\n    // h = qinv·(m1 - m2 mod p) mod p, on p's arithmetic."
    "\n    Vec<u64> m2_mod_p = limbs_of(&BigUint::rem(&biguint_of(&m2), &key.p), np);\n    Vec<u64> diff = "
    "limbs_sub_mod(&mp, &m1, &m2_mod_p);\n    Vec<u64> qinv_m = mont_mul_v(&mp, &limbs_of(&key.qinv, np), "
    "&mp.r2);\n    Vec<u64> h = mont_mul_v(&mp, &diff, &qinv_m);\n    // s = m2 + h·q: a plain product ove"
    "r limbs, then the sum.\n    Vec<u64> q_limbs = limbs_of(&key.q, nq);\n    Vec<u64> s = Vec::filled(np "
    "+ nq + 1, 0: u64);\n    for (usize i = 0; i < np; i += 1)\n    {\n        u128 carry = 0;\n        u128 "
    "hi = widen<u128>(h[i]);\n        for (usize j = 0; j < nq; j += 1)\n        {\n            u128 x = wid"
    "en<u128>(s[i + j]) + hi * widen<u128>(q_limbs[j]) + carry;\n            s[i + j] = narrow_wrapping<u6"
    "4>(x);\n            carry = x >> 64;\n        }\n        s[i + nq] = narrow_wrapping<u64>(carry);\n    }"
    "\n    u128 c = 0;\n    for (usize j = 0; j < np + nq + 1; j += 1)\n    {\n        u128 x = widen<u128>(s"
    "[j]) + (if (j < nq) { widen<u128>(m2[j]) } else { 0 }) + c;\n        s[j] = narrow_wrapping<u64>(x);\n"
    "        c = x >> 64;\n    }\n    BigUint result = biguint_of(&s);\n    // Checked against the public ke"
    "y: a wrong result would leak the\n    // primes, so a key that fails is used without the CRT instead."
    "\n    if (BigUint::eq(&BigUint::mod_pow(&result, &key.e, &key.n), m))\n    {\n        return result;\n  "
    "  }\n    Mont mn = mont_new(&key.n);\n    mont_pow(&mn, m, &key.d)\n}fn pkcs1v15_encode(HashKind kind, "
    "slice<u8, shared> digest, usize k) : Vec<u8>\n{\n    Vec<u8> prefix = digest_info_prefix(kind);\n    us"
    "ize t_len = Vec::len(&prefix) + slice_len(digest);\n    if (slice_len(digest) != hash_len(kind) || k "
    "< t_len + 11)\n    {\n        fault(crypto_length);\n    }\n    Vec<u8> em = Vec::new();\n    Vec::push(&"
    "mut em, 0);\n    Vec::push(&mut em, 1);\n    for (usize i = 0; i < k - t_len - 3; i += 1)\n    {\n      "
    "  Vec::push(&mut em, 0xff);\n    }\n    Vec::push(&mut em, 0);\n    Vec::extend_from(&mut em, &prefix[0"
    "..$]);\n    Vec::extend_from(&mut em, digest);\n    em\n}export fn rsa_sign_pkcs1v15(ref<RsaPrivateKey,"
    " shared> key, HashKind kind, slice<u8, shared> digest) : Vec<u8>\n{\n    usize k = (BigUint::bit_len(&"
    "key.n) + 7) / 8;\n    Vec<u8> em = pkcs1v15_encode(kind, digest, k);\n    BigUint s = rsa_private_op(k"
    "ey, &BigUint::from_bytes_be(&em[0..$]));\n    BigUint::to_bytes_be_padded(&s, k)\n}export fn rsa_sign_"
    "pss(ref<RsaPrivateKey, shared> key, HashKind kind, slice<u8, shared> digest) : Vec<u8>\n{\n    usize m"
    "od_bits = BigUint::bit_len(&key.n);\n    usize k = (mod_bits + 7) / 8;\n    usize h_len = hash_len(kin"
    "d);\n    usize em_bits = mod_bits - 1;\n    usize em_len = (em_bits + 7) / 8;\n    if (slice_len(digest"
    ") != h_len || em_len < 2 * h_len + 2)\n    {\n        fault(crypto_length);\n    }\n    Vec<u8> salt = V"
    "ec::filled(h_len, 0: u8);\n    os_random_bytes(&mut salt[0..$]);\n    Vec<u8> m2 = Vec::filled(8, 0: u"
    "8);\n    Vec::extend_from(&mut m2, digest);\n    Vec::extend_from(&mut m2, &salt[0..$]);\n    Vec<u8> h"
    " = hash(kind, &m2[0..$]);\n    usize db_len = em_len - h_len - 1;\n    Vec<u8> db = Vec::filled(db_len"
    " - h_len - 1, 0: u8);\n    Vec::push(&mut db, 1);\n    Vec::extend_from(&mut db, &salt[0..$]);\n    Vec"
    "<u8> mask = mgf1(kind, &h[0..$], db_len);\n    Vec<u8> em = Vec::new();\n    for (usize i = 0; i < db_"
    "len; i += 1)\n    {\n        Vec::push(&mut em, db[i] ^ mask[i]);\n    }\n    u32 unused = narrow<u32>(8"
    " * em_len - em_bits);\n    em[0] = em[0] & narrow_wrapping<u8>((0xff: u32) >> unused);\n    Vec::exten"
    "d_from(&mut em, &h[0..$]);\n    Vec::push(&mut em, 0xbc);\n    BigUint s = rsa_private_op(key, &BigUin"
    "t::from_bytes_be(&em[0..$]));\n    BigUint::to_bytes_be_padded(&s, k)\n}fn small_primes() : Vec<u32>\n{"
    "\n    Vec<u32> out = Vec::new();\n    for (u32 c = 3; c < 1000; c += 2)\n    {\n        bool prime = tru"
    "e;\n        for (usize i = 0; i < Vec::len(&out) && out[i] * out[i] <= c; i += 1)\n        {\n         "
    "   if (c % out[i] == 0)\n            {\n                prime = false;\n                break;\n        "
    "    }\n        }\n        if (prime)\n        {\n            Vec::push(&mut out, c);\n        }\n    }\n   "
    " out\n}fn probably_prime(ref<BigUint, shared> c, ref<Vec<u32>, shared> primes, usize rounds) : bool\n{"
    "\n    for (usize i = 0; i < Vec::len(primes); i += 1)\n    {\n        BigUint p = BigUint::from_u64(wid"
    "en<u64>(primes[i]));\n        if (BigUint::is_zero(&BigUint::rem(c, &p)))\n        {\n            retur"
    "n BigUint::eq(c, &p);\n        }\n    }\n    BigUint one = BigUint::from_u64(1);\n    BigUint c1 = BigUi"
    "nt::sub(c, &one);\n    usize a = 0;\n    while (!BigUint::bit(&c1, a))\n    {\n        a += 1;\n    }\n   "
    " BigUint m = BigUint::shift_right(&c1, a);\n    Mont f = mont_new(c);\n    usize k = (BigUint::bit_len"
    "(c) + 7) / 8;\n    Vec<u8> rb = Vec::filled(k, 0: u8);\n    BigUint two = BigUint::from_u64(2);\n    fo"
    "r (usize round = 0; round < rounds; round += 1)\n    {\n        os_random_bytes(&mut rb[0..$]);\n      "
    "  BigUint b = BigUint::add(\n            &BigUint::rem(&BigUint::from_bytes_be(&rb[0..$]), &BigUint::"
    "sub(c, &BigUint::from_u64(3))),\n            &two,\n        );\n        BigUint z = mont_pow(&f, &b, &m"
    ");\n        if (BigUint::eq(&z, &one) || BigUint::eq(&z, &c1))\n        {\n            continue;\n      "
    "  }\n        bool witness = true;\n        for (usize j = 1; j < a; j += 1)\n        {\n            over"
    "write(&mut z, BigUint::rem(&BigUint::mul(&z, &z), c));\n            if (BigUint::eq(&z, &c1))\n       "
    "     {\n                witness = false;\n                break;\n            }\n            if (BigUint"
    "::eq(&z, &one))\n            {\n                return false;\n            }\n        }\n        if (witn"
    "ess)\n        {\n            return false;\n        }\n    }\n    true\n}fn random_prime(usize bits, ref<B"
    "igUint, shared> e, ref<Vec<u32>, shared> primes) : BigUint\n{\n    usize k = (bits + 7) / 8;\n    Vec<u"
    "8> rb = Vec::filled(k, 0: u8);\n    BigUint one = BigUint::from_u64(1);\n    while (true)\n    {\n      "
    "  os_random_bytes(&mut rb[0..$]);\n        BigUint c = BigUint::from_bytes_be(&rb[0..$]);\n        // "
    "Exactly `bits` bits with the top two set, and odd.\n        BigUint top = BigUint::shift_left(&one, b"
    "its - 1);\n        BigUint second = BigUint::shift_left(&one, bits - 2);\n        BigUint mask = BigUi"
    "nt::sub(&BigUint::shift_left(&one, bits), &one);\n        BigUint c2 = BigUint::rem(&c, &BigUint::add"
    "(&mask, &one));\n        BigUint c3 = BigUint::add(&BigUint::rem(&c2, &second), &BigUint::add(&top, &"
    "second));\n        if (!BigUint::bit(&c3, 0))\n        {\n            overwrite(&mut c3, BigUint::add(&"
    "c3, &one));\n        }\n        BigUint c4 = BigUint::sub(&c3, &one);\n        if (BigUint::is_zero(&Bi"
    "gUint::rem(&c4, e)))\n        {\n            continue;\n        }\n        if (probably_prime(&c3, prime"
    "s, 5))\n        {\n            return c3;\n        }\n    }\n}export fn rsa_generate_key(usize bits) : Rs"
    "aPrivateKey\n{\n    if (bits < 1024 || bits > 8192 || bits % 64 != 0)\n    {\n        fault(crypto_lengt"
    "h);\n    }\n    Vec<u32> primes = small_primes();\n    BigUint e = BigUint::from_u64(65537);\n    BigUin"
    "t one = BigUint::from_u64(1);\n    while (true)\n    {\n        BigUint p = random_prime(bits / 2, &e, "
    "&primes);\n        BigUint q = random_prime(bits / 2, &e, &primes);\n        if (BigUint::eq(&p, &q))\n"
    "        {\n            continue;\n        }\n        BigUint n = BigUint::mul(&p, &q);\n        BigUint "
    "p1 = BigUint::sub(&p, &one);\n        BigUint q1 = BigUint::sub(&q, &one);\n        BigUint phi = BigU"
    "int::mul(&p1, &q1);\n        BigUint d = match (BigUint::mod_inverse(&e, &phi))\n        {\n           "
    " Some(v) : v,\n            None    : continue,\n        };\n        if (Some(key) = RsaPrivateKey::new("
    "n, BigUint::clone(&e), d, p, q))\n        {\n            return key;\n        }\n    }\n}export fn CertEr"
    "ror::text(ref<CertError, shared> e) : str\n{\n    match (e)\n    {\n        BadEncoding          : \"malf"
    "ormed certificate\",\n        Expired              : \"certificate expired\",\n        NotYetValid       "
    "   : \"certificate not yet valid\",\n        UnknownAuthority     : \"certificate signed by an unknown a"
    "uthority\",\n        HostMismatch         : \"certificate is not for this host\",\n        BadSignature  "
    "       : \"certificate signature does not verify\",\n        NotAuthority         : \"issuer is not a ce"
    "rtificate authority\",\n        UnsupportedAlgorithm : \"unsupported key or signature algorithm\",\n     "
    "   UnhandledCritical    : \"unhandled critical extension\",\n        WrongUsage           : \"certificat"
    "e not usable for a TLS server\",\n        ChainTooLong         : \"certificate chain too long\",\n    }\n}"
    "export fn der_read(slice<u8, shared> buf, usize at) : Option<Der>\n{\n    usize n = slice_len(buf);\n  "
    "  if (at + 2 > n)\n    {\n        return None;\n    }\n    u8 tag = buf[at];\n    if ((tag & 0x1f) == 0x1"
    "f)\n    {\n        return None;\n    }\n    u8 first = buf[at + 1];\n    usize len = 0;\n    usize start ="
    " at + 2;\n    if (first < 0x80)\n    {\n        len = widen<usize>(first);\n    }\n    else\n    {\n       "
    " usize count = widen<usize>(first & 0x7f);\n        if (count == 0 || count > 4 || start + count > n "
    "|| buf[start] == 0)\n        {\n            return None;\n        }\n        for (usize i = 0; i < count"
    "; i += 1)\n        {\n            len = (len << 8) | widen<usize>(buf[start + i]);\n        }\n        i"
    "f (len < 0x80)\n        {\n            return None;\n        }\n        start += count;\n    }\n    if (le"
    "n > n - start)\n    {\n        return None;\n    }\n    Some(Der { .tag = tag, .start = start, .end = st"
    "art + len, .next = start + len })\n}unittest \"der_read: an element, its child, and a long form refuse"
    "d\"\n{\n    array<u8, 5> der = [0x30, 0x03, 0x02, 0x01, 0x05];\n    Der seq = Option::unwrap(der_read(&d"
    "er[0..$], 0));\n    assert(seq.tag == 0x30 && seq.start == 2 && seq.end == 5 && seq.next == 5);\n    D"
    "er int = Option::unwrap(der_read(&der[0..$], seq.start));\n    assert(int.tag == 0x02 && der[int.star"
    "t] == 5);\n    array<u8, 4> long_form = [0x04, 0x81, 0x01, 0x00];\n    assert(Option::is_none(&der_rea"
    "d(&long_form[0..$], 0)));\n}fn der_expect(slice<u8, shared> buf, usize at, u8 tag) : Result<Der, Cert"
    "Error>\n{\n    match (der_read(buf, at))\n    {\n        Some(d) : if (d.tag == tag) { Ok(d) } else { Er"
    "r(BadEncoding) },\n        None    : Err(BadEncoding),\n    }\n}fn der_bytes(slice<u8, shared> buf, Der"
    " d) : Vec<u8>\n{\n    Vec::from_slice(&buf[d.start..d.end])\n}fn der_eq_hex(slice<u8, shared> buf, Der "
    "d, str hex) : bool\n{\n    Vec<u8> want = Result::unwrap_or(from_hex(StringView::of(hex)), Vec::new())"
    ";\n    d.end - d.start == Vec::len(&want) && digest_eq(&buf[d.start..d.end], &want[0..$])\n}fn hash_oi"
    "d(slice<u8, shared> buf, Der d) : Option<HashKind>\n{\n    if (der_eq_hex(buf, d, \"608648016503040201\""
    "))\n    {\n        return Some(Sha2_256);\n    }\n    if (der_eq_hex(buf, d, \"608648016503040202\"))\n    "
    "{\n        return Some(Sha2_384);\n    }\n    if (der_eq_hex(buf, d, \"608648016503040203\"))\n    {\n     "
    "   return Some(Sha2_512);\n    }\n    None\n}fn signature_algorithm(slice<u8, shared> buf, Der alg) : R"
    "esult<SignatureScheme, CertError>\n{\n    Der oid = der_expect(buf, alg.start, 0x06)?;\n    if (der_eq_"
    "hex(buf, oid, \"2a864886f70d01010b\"))\n    {\n        return Ok(RsaPkcs1(Sha2_256));\n    }\n    if (der_"
    "eq_hex(buf, oid, \"2a864886f70d01010c\"))\n    {\n        return Ok(RsaPkcs1(Sha2_384));\n    }\n    if (d"
    "er_eq_hex(buf, oid, \"2a864886f70d01010d\"))\n    {\n        return Ok(RsaPkcs1(Sha2_512));\n    }\n    if"
    " (der_eq_hex(buf, oid, \"2a8648ce3d040302\"))\n    {\n        return Ok(Ecdsa(Sha2_256));\n    }\n    if ("
    "der_eq_hex(buf, oid, \"2a8648ce3d040303\"))\n    {\n        return Ok(Ecdsa(Sha2_384));\n    }\n    if (de"
    "r_eq_hex(buf, oid, \"2a8648ce3d040304\"))\n    {\n        return Ok(Ecdsa(Sha2_512));\n    }\n    if (der_"
    "eq_hex(buf, oid, \"2b6570\"))\n    {\n        return Ok(Ed25519);\n    }\n    if (der_eq_hex(buf, oid, \"2a"
    "864886f70d01010a\"))\n    {\n        // RSASSA-PSS-params: [0] hashAlgorithm, [1] maskGenAlgorithm,\n   "
    "     // [2] saltLength; the hash must be SHA-2 and MGF1 over it, and the\n        // salt as long as "
    "the digest.\n        Der params = der_expect(buf, oid.next, 0x30)?;\n        Der h0 = der_expect(buf, "
    "params.start, 0xa0)?;\n        Der h_alg = der_expect(buf, h0.start, 0x30)?;\n        Der h_oid = der_"
    "expect(buf, h_alg.start, 0x06)?;\n        HashKind kind = match (hash_oid(buf, h_oid))\n        {\n    "
    "        Some(k) : k,\n            None    : return Ok(UnsupportedSignature),\n        };\n        retur"
    "n Ok(RsaPss(kind));\n    }\n    Ok(UnsupportedSignature)\n}fn der_text(slice<u8, shared> buf, Der d) : "
    "Option<String>\n{\n    if (d.tag != 0x0c && d.tag != 0x13 && d.tag != 0x16 && d.tag != 0x14)\n    {\n   "
    "     return None;\n    }\n    match (String::from_utf8(der_bytes(buf, d)))\n    {\n        Ok(s)  : Some"
    "(s),\n        Err(_) : None,\n    }\n}fn common_name_of(slice<u8, shared> buf, Der name) : String\n{\n   "
    " String cn = String::new();\n    usize at = name.start;\n    while (at < name.end)\n    {\n        Der s"
    "et = match (der_read(buf, at))\n        {\n            Some(d) : d,\n            None    : return cn,\n "
    "       };\n        usize inner = set.start;\n        while (inner < set.end)\n        {\n            Der"
    " atv = match (der_read(buf, inner))\n            {\n                Some(d) : d,\n                None "
    "   : return cn,\n            };\n            if (Some(oid) = der_read(buf, atv.start))\n            {\n "
    "               if (oid.tag == 0x06 && der_eq_hex(buf, oid, \"550403\"))\n                {\n            "
    "        if (Some(v) = der_read(buf, oid.next))\n                    {\n                        if (Som"
    "e(t) = der_text(buf, v))\n                        {\n                            overwrite(&mut cn, t)"
    ";\n                        }\n                    }\n                }\n            }\n            inner "
    "= atv.next;\n        }\n        at = set.next;\n    }\n    cn\n}fn digits(slice<u8, shared> b, usize at, "
    "usize n) : Option<i64>\n{\n    i64 x = 0;\n    for (usize i = at; i < at + n; i += 1)\n    {\n        if "
    "(i >= slice_len(b) || !ascii_is_digit(b[i]))\n        {\n            return None;\n        }\n        x "
    "= x * 10 + widen<i64>(b[i] - b'0');\n    }\n    Some(x)\n}fn der_time(slice<u8, shared> buf, Der d) : R"
    "esult<DateTime, CertError>\n{\n    slice<u8, shared> t = &buf[d.start..d.end];\n    usize n = slice_len"
    "(t);\n    i64 year = 0;\n    usize at = 0;\n    if (d.tag == 0x17 && n == 13)\n    {\n        i64 yy = ma"
    "tch (digits(t, 0, 2))\n        {\n            Some(y) : y,\n            None    : return Err(BadEncodin"
    "g),\n        };\n        year = if (yy < 50) { 2000 + yy } else { 1900 + yy };\n        at = 2;\n    }\n "
    "   else if (d.tag == 0x18 && n == 15)\n    {\n        year = match (digits(t, 0, 4))\n        {\n       "
    "     Some(y) : y,\n            None    : return Err(BadEncoding),\n        };\n        at = 4;\n    }\n  "
    "  else\n    {\n        return Err(BadEncoding);\n    }\n    if (t[n - 1] != b'Z')\n    {\n        return E"
    "rr(BadEncoding);\n    }\n    Option<i64> mo = digits(t, at, 2);\n    Option<i64> dd = digits(t, at + 2,"
    " 2);\n    Option<i64> hh = digits(t, at + 4, 2);\n    Option<i64> mi = digits(t, at + 6, 2);\n    Optio"
    "n<i64> ss = digits(t, at + 8, 2);\n    if (Some(m) = mo)\n    {\n        if (Some(day) = dd)\n        {\n"
    "            if (Some(h) = hh)\n            {\n                if (Some(min) = mi)\n                {\n  "
    "                  if (Some(sec) = ss)\n                    {\n                        if (m <= 12 && d"
    "ay <= 31 && h <= 23 && min <= 59 && sec <= 59)\n                        {\n                           "
    " if (Some(dt) = DateTime::new(\n                                year,\n                               "
    " narrow<u8>(m),\n                                narrow<u8>(day),\n                                nar"
    "row<u8>(h),\n                                narrow<u8>(min),\n                                narrow<"
    "u8>(sec),\n                            ))\n                            {\n                             "
    "   return Ok(dt);\n                            }\n                        }\n                    }\n    "
    "            }\n            }\n        }\n    }\n    Err(BadEncoding)\n}fn public_key_of(slice<u8, shared>"
    " buf, Der spki) : Result<CertKey, CertError>\n{\n    Der alg = der_expect(buf, spki.start, 0x30)?;\n   "
    " Der bits = der_expect(buf, alg.next, 0x03)?;\n    if (bits.end == bits.start || buf[bits.start] != 0"
    ")\n    {\n        return Err(BadEncoding);\n    }\n    usize key_start = bits.start + 1;\n    Der oid = d"
    "er_expect(buf, alg.start, 0x06)?;\n    if (der_eq_hex(buf, oid, \"2a864886f70d010101\"))\n    {\n        "
    "Der seq = der_expect(buf, key_start, 0x30)?;\n        Der n = der_expect(buf, seq.start, 0x02)?;\n    "
    "    Der e = der_expect(buf, n.next, 0x02)?;\n        return Ok(RsaKey(RsaPublicKey { .n = BigUint::fr"
    "om_bytes_be(&buf[n.start..n.end]), .e = BigUint::from_bytes_be(&buf[e.start..e.end]) }));\n    }\n    "
    "if (der_eq_hex(buf, oid, \"2a8648ce3d0201\"))\n    {\n        Der curve = der_expect(buf, oid.next, 0x06"
    ")?;\n        Vec<u8> point = Vec::from_slice(&buf[key_start..bits.end]);\n        if (der_eq_hex(buf, "
    "curve, \"2a8648ce3d030107\"))\n        {\n            return Ok(EcKey(EcPublicKey { .curve = P256, .poin"
    "t = point }));\n        }\n        if (der_eq_hex(buf, curve, \"2b81040022\"))\n        {\n            ret"
    "urn Ok(EcKey(EcPublicKey { .curve = P384, .point = point }));\n        }\n    }\n    if (der_eq_hex(buf"
    ", oid, \"2b6570\"))\n    {\n        if (bits.end - key_start != 32)\n        {\n            return Err(Bad"
    "Encoding);\n        }\n        array<u8, 32> k = [0; 32];\n        for (usize i = 0; i < 32; i += 1)\n  "
    "      {\n            k[i] = buf[key_start + i];\n        }\n        return Ok(Ed25519Key(k));\n    }\n   "
    " Ok(UnsupportedKey)\n}export fn Certificate::parse(slice<u8, shared> der) : Result<Certificate, CertE"
    "rror>\n{\n    Der cert = der_expect(der, 0, 0x30)?;\n    if (cert.next != slice_len(der))\n    {\n       "
    " return Err(BadEncoding);\n    }\n    Der tbs = der_expect(der, cert.start, 0x30)?;\n    Der outer_alg "
    "= der_expect(der, tbs.next, 0x30)?;\n    Der sig_bits = der_expect(der, outer_alg.next, 0x03)?;\n    i"
    "f (sig_bits.next != cert.end || sig_bits.end == sig_bits.start || der[sig_bits.start] != 0)\n    {\n  "
    "      return Err(BadEncoding);\n    }\n    SignatureScheme scheme = signature_algorithm(der, outer_alg"
    ")?;\n    usize at = tbs.start;\n    Der first = match (der_read(der, at))\n    {\n        Some(d) : d,\n "
    "       None    : return Err(BadEncoding),\n    };\n    if (first.tag == 0xa0)\n    {\n        at = first"
    ".next;\n    }\n    Der serial = der_expect(der, at, 0x02)?;\n    Der inner_alg = der_expect(der, serial"
    ".next, 0x30)?;\n    // The signature algorithm inside the signed part must be the outer one.\n    if ("
    "inner_alg.end - inner_alg.start != outer_alg.end - outer_alg.start || !digest_eq(\n        &der[inner"
    "_alg.start..inner_alg.end],\n        &der[outer_alg.start..outer_alg.end],\n    ))\n    {\n        retur"
    "n Err(BadEncoding);\n    }\n    Der issuer = der_expect(der, inner_alg.next, 0x30)?;\n    Der validity "
    "= der_expect(der, issuer.next, 0x30)?;\n    Der nb = match (der_read(der, validity.start))\n    {\n    "
    "    Some(d) : d,\n        None    : return Err(BadEncoding),\n    };\n    Der na = match (der_read(der,"
    " nb.next))\n    {\n        Some(d) : d,\n        None    : return Err(BadEncoding),\n    };\n    DateTime"
    " not_before = der_time(der, nb)?;\n    DateTime not_after = der_time(der, na)?;\n    Der subject = der"
    "_expect(der, validity.next, 0x30)?;\n    Der spki = der_expect(der, subject.next, 0x30)?;\n    CertKey"
    " key = public_key_of(der, spki)?;\n    Certificate c = Certificate { .der = Vec::from_slice(der), .tb"
    "s = Vec::from_slice(&der[cert.start..tbs.next]), .issuer = Vec::from_slice(&der[inner_alg.next..issu"
    "er.next]), .subject = Vec::from_slice(&der[validity.next..subject.next]), .common_name = common_name"
    "_of(\n        der,\n        subject,\n    ), .not_before = not_before, .not_after = not_after, .dns_nam"
    "es = Vec::new(), .ip_addresses = Vec::new(), .is_ca = false, .max_path_len = -1, .can_sign_certifica"
    "tes = true, .server_auth = true, .unhandled_critical = false, .key = key, .scheme = scheme, .signatu"
    "re = Vec::from_slice(&der[sig_bits.start + 1..sig_bits.end]) };\n    at = spki.next;\n    while (at < "
    "tbs.end)\n    {\n        Der field = match (der_read(der, at))\n        {\n            Some(d) : d,\n    "
    "        None    : return Err(BadEncoding),\n        };\n        if (field.tag == 0xa3)\n        {\n     "
    "       Der exts = der_expect(der, field.start, 0x30)?;\n            usize e_at = exts.start;\n        "
    "    while (e_at < exts.end)\n            {\n                Der ext = der_expect(der, e_at, 0x30)?;\n  "
    "              Der oid = der_expect(der, ext.start, 0x06)?;\n                usize v_at = oid.next;\n  "
    "              bool critical = false;\n                Der maybe = match (der_read(der, v_at))\n       "
    "         {\n                    Some(d) : d,\n                    None    : return Err(BadEncoding),\n "
    "               };\n                if (maybe.tag == 0x01)\n                {\n                    criti"
    "cal = maybe.end > maybe.start && der[maybe.start] != 0;\n                    v_at = maybe.next;\n     "
    "           }\n                Der value = der_expect(der, v_at, 0x04)?;\n                if (der_eq_he"
    "x(der, oid, \"551d11\"))\n                {\n                    Der names = der_expect(der, value.start"
    ", 0x30)?;\n                    usize n_at = names.start;\n                    while (n_at < names.end)"
    "\n                    {\n                        Der g = match (der_read(der, n_at))\n                 "
    "       {\n                            Some(d) : d,\n                            None    : return Err(B"
    "adEncoding),\n                        };\n                        if (g.tag == 0x82)\n                 "
    "       {\n                            if (Ok(s) = String::from_utf8(der_bytes(der, g)))\n             "
    "               {\n                                Vec::push(&mut c.dns_names, s);\n                   "
    "         }\n                        }\n                        else if (g.tag == 0x87)\n               "
    "         {\n                            usize len = g.end - g.start;\n                            if ("
    "len == 4)\n                            {\n                                Vec::push(\n                 "
    "                   &mut c.ip_addresses,\n                                    V4([der[g.start], der[g."
    "start + 1], der[g.start + 2], der[g.start + 3]]),\n                                );\n               "
    "             }\n                            else if (len == 16)\n                            {\n       "
    "                         array<u8, 16> a = [0; 16];\n                                for (usize i = 0"
    "; i < 16; i += 1)\n                                {\n                                    a[i] = der[g"
    ".start + i];\n                                }\n                                Vec::push(&mut c.ip_a"
    "ddresses, V6(a));\n                            }\n                        }\n                        n_"
    "at = g.next;\n                    }\n                }\n                else if (der_eq_hex(der, oid, \""
    "551d13\"))\n                {\n                    Der bc = der_expect(der, value.start, 0x30)?;\n      "
    "              usize b_at = bc.start;\n                    if (b_at < bc.end)\n                    {\n  "
    "                      Der x = match (der_read(der, b_at))\n                        {\n                "
    "            Some(d) : d,\n                            None    : return Err(BadEncoding),\n            "
    "            };\n                        if (x.tag == 0x01)\n                        {\n                "
    "            c.is_ca = x.end > x.start && der[x.start] != 0;\n                            b_at = x.nex"
    "t;\n                        }\n                    }\n                    if (b_at < bc.end)\n          "
    "          {\n                        Der pl = der_expect(der, b_at, 0x02)?;\n                        i"
    "64 v = 0;\n                        for (usize i = pl.start; i < pl.end && i < pl.start + 4; i += 1)\n "
    "                       {\n                            v = (v << 8) | widen<i64>(der[i]);\n            "
    "            }\n                        c.max_path_len = v;\n                    }\n                }\n  "
    "              else if (der_eq_hex(der, oid, \"551d0f\"))\n                {\n                    Der ku "
    "= der_expect(der, value.start, 0x03)?;\n                    // Bit 5, keyCertSign, of the first byte "
    "after the\n                    // unused-bits count.\n                    c.can_sign_certificates = ku"
    ".end - ku.start >= 2 && (der[ku.start + 1] & 0x04) != 0;\n                }\n                else if ("
    "der_eq_hex(der, oid, \"551d25\"))\n                {\n                    Der eku = der_expect(der, valu"
    "e.start, 0x30)?;\n                    bool server = false;\n                    usize k_at = eku.start"
    ";\n                    while (k_at < eku.end)\n                    {\n                        Der p = d"
    "er_expect(der, k_at, 0x06)?;\n                        if (der_eq_hex(der, p, \"2b06010505070301\") || d"
    "er_eq_hex(der, p, \"551d2500\"))\n                        {\n                            server = true;\n"
    "                        }\n                        k_at = p.next;\n                    }\n             "
    "       c.server_auth = server;\n                }\n                else if (critical && !der_eq_hex(de"
    "r, oid, \"551d20\") && !der_eq_hex(der, oid, \"551d1e\"))\n                {\n                    // An un"
    "known critical extension; certificate policies\n                    // and name constraints are toler"
    "ated unread (D-0160).\n                    c.unhandled_critical = true;\n                }\n           "
    "     e_at = ext.next;\n            }\n        }\n        at = field.next;\n    }\n    Ok(c)\n}export fn ce"
    "rtificates_from_pem(StringView text) : Vec<Certificate>\n{\n    Vec<Certificate> out = Vec::new();\n   "
    " StringView begin = \"-----BEGIN CERTIFICATE-----\";\n    StringView end = \"-----END CERTIFICATE-----\";"
    "\n    usize at = 0;\n    usize n = StringView::len(text);\n    while (at < n)\n    {\n        StringView "
    "rest = StringView::sub(text, at, n);\n        usize b = match (StringView::find(rest, begin))\n       "
    " {\n            Some(i) : i,\n            None    : break,\n        };\n        StringView body = String"
    "View::sub(rest, b + StringView::len(begin), StringView::len(rest));\n        usize e = match (StringV"
    "iew::find(body, end))\n        {\n            Some(i) : i,\n            None    : break,\n        };\n   "
    "     String b64 = String::new();\n        StringView block = StringView::sub(body, 0, e);\n        // "
    "A byte that is not ASCII (so not base64 either) makes the block\n        // malformed: skipped, like "
    "one whose base64 does not decode.\n        bool clean = true;\n        for (usize i = 0; i < StringVie"
    "w::len(block); i += 1)\n        {\n            u8 c = block.bytes[i];\n            if (c >= 128)\n      "
    "      {\n                clean = false;\n                break;\n            }\n            if (!ascii_i"
    "s_space(c))\n            {\n                String::push_ascii(&mut b64, c);\n            }\n        }\n "
    "       if (clean)\n        {\n            if (Ok(der) = base64_decode(String::as_view(&b64)))\n        "
    "    {\n                if (Ok(cert) = Certificate::parse(&der[0..$]))\n                {\n             "
    "       Vec::push(&mut out, cert);\n                }\n            }\n        }\n        at = at + b + St"
    "ringView::len(begin) + e + StringView::len(end);\n    }\n    out\n}unittest \"certificates_from_pem: a m"
    "alformed block is skipped\"\n{\n    StringView text = \"junk\\n-----BEGIN CERTIFICATE-----\\nnot base64!\\n"
    "-----END CERTIFICATE-----\\n\";\n    Vec<Certificate> certs = certificates_from_pem(text);\n    assert(V"
    "ec::len(&certs) == 0);\n}export fn TrustStore::new() : TrustStore\n{\n    TrustStore { .roots = Vec::ne"
    "w() }\n}export fn TrustStore::add(ref<TrustStore, exclusive> t, Certificate root)\n{\n    Vec::push(&mu"
    "t t.roots, root);\n}export fn TrustStore::from_pem_file(StringView path) : Result<TrustStore, FileErr"
    "or>\n{\n    String text = read_file(path)?;\n    Ok(TrustStore { .roots = certificates_from_pem(String:"
    ":as_view(&text)) })\n}export fn TrustStore::system() : Result<TrustStore, FileError>\n{\n    array<str,"
    " 5> paths = [\n        \"/etc/ssl/certs/ca-certificates.crt\",\n        \"/etc/pki/tls/certs/ca-bundle.cr"
    "t\",\n        \"/etc/ssl/ca-bundle.pem\",\n        \"/etc/ssl/cert.pem\",\n        \"/usr/local/etc/openssl/c"
    "ert.pem\",\n    ];\n    foreach (p in &paths)\n    {\n        if (Ok(t) = TrustStore::from_pem_file(Strin"
    "gView::of(*p)))\n        {\n            if (Vec::len(&t.roots) > 0)\n            {\n                retu"
    "rn Ok(t);\n            }\n        }\n    }\n    Err(NotFound)\n}export fn verify_signature(\n    ref<CertK"
    "ey, shared> key,\n    ref<SignatureScheme, shared> scheme,\n    slice<u8, shared> message,\n    slice<u"
    "8, shared> signature,\n) : bool\n{\n    match (scheme)\n    {\n        RsaPkcs1(h) : match (key)\n        "
    "{\n            RsaKey(k) : rsa_verify_pkcs1v15(k, *h, &hash(*h, message)[0..$], signature),\n         "
    "   _         : false,\n        },\n        RsaPss(h) : match (key)\n        {\n            RsaKey(k) : r"
    "sa_verify_pss(k, *h, &hash(*h, message)[0..$], signature),\n            _         : false,\n        },"
    "\n        Ecdsa(h) : match (key)\n        {\n            EcKey(k) : ecdsa_verify(k.curve, &k.point[0..$"
    "], &hash(*h, message)[0..$], signature),\n            _        : false,\n        },\n        Ed25519 : "
    "match (key)\n        {\n            Ed25519Key(k) : ed25519_verify(&k[0..$], message, signature),\n    "
    "        _             : false,\n        },\n        UnsupportedSignature : false,\n    }\n}fn ascii_lowe"
    "r_eq(StringView a, StringView b) : bool\n{\n    if (StringView::len(a) != StringView::len(b))\n    {\n  "
    "      return false;\n    }\n    for (usize i = 0; i < StringView::len(a); i += 1)\n    {\n        u8 x ="
    " a.bytes[i];\n        u8 y = b.bytes[i];\n        if (ascii_is_upper(x))\n        {\n            x += 32"
    ";\n        }\n        if (ascii_is_upper(y))\n        {\n            y += 32;\n        }\n        if (x !="
    " y)\n        {\n            return false;\n        }\n    }\n    true\n}fn name_matches(StringView pattern"
    ", StringView host) : bool\n{\n    if (StringView::starts_with(pattern, \"*.\"))\n    {\n        StringView"
    " suffix = StringView::sub(pattern, 1, StringView::len(pattern));\n        match (StringView::find(hos"
    "t, \".\"))\n        {\n            Some(dot) : dot > 0 && ascii_lower_eq(\n                suffix,\n      "
    "          StringView::sub(host, dot, StringView::len(host)),\n            ) && Option::is_some(&Strin"
    "gView::find(StringView::sub(suffix, 1, StringView::len(suffix)), \".\")),\n            None : false,\n  "
    "      }\n    }\n    else\n    {\n        ascii_lower_eq(pattern, host)\n    }\n}export fn Certificate::mat"
    "ches_host(ref<Certificate, shared> c, StringView host) : bool\n{\n    if (Ok(ip) = IpAddr::parse(host)"
    ")\n    {\n        foreach (a in &c.ip_addresses)\n        {\n            if (IpAddr::text(a) == IpAddr::"
    "text(&ip))\n            {\n                return true;\n            }\n        }\n        return false;\n"
    "    }\n    StringView h = if (StringView::ends_with(\n        host,\n        \".\",\n    )) { StringView::"
    "sub(host, 0, StringView::len(host) - 1) } else { host };\n    foreach (n in &c.dns_names)\n    {\n     "
    "   if (name_matches(String::as_view(n), h))\n        {\n            return true;\n        }\n    }\n    f"
    "alse\n}fn check_time(ref<Certificate, shared> c, ref<DateTime, shared> now) : Result<void, CertError>"
    "\n{\n    if (DateTime::less(now, &c.not_before))\n    {\n        return Err(NotYetValid);\n    }\n    if ("
    "DateTime::less(&c.not_after, now))\n    {\n        return Err(Expired);\n    }\n    if (c.unhandled_crit"
    "ical)\n    {\n        return Err(UnhandledCritical);\n    }\n    Ok(())\n}fn same_bytes(ref<Vec<u8>, shar"
    "ed> a, ref<Vec<u8>, shared> b) : bool\n{\n    Vec::len(a) == Vec::len(b) && digest_eq(&a[0..$], &b[0.."
    "$])\n}export fn verify_chain(\n    ref<Certificate, shared> leaf,\n    slice<Certificate, shared> inter"
    "mediates,\n    ref<TrustStore, shared> roots,\n    StringView host,\n    ref<DateTime, shared> now,\n) :"
    " Result<void, CertError>\n{\n    if (!Certificate::matches_host(leaf, host))\n    {\n        return Err("
    "HostMismatch);\n    }\n    if (!leaf.server_auth)\n    {\n        return Err(WrongUsage);\n    }\n    chec"
    "k_time(leaf, now)?;\n    Certificate current = Certificate::clone(leaf);\n    usize below = 0;\n    Cer"
    "tError last = UnknownAuthority;\n    for (usize depth = 0; depth < 10; depth += 1)\n    {\n        fore"
    "ach (r in &roots.roots)\n        {\n            if (same_bytes(\n                &r.subject,\n          "
    "      &current.issuer,\n            ) && verify_signature(&r.key, &current.scheme, &current.tbs[0..$]"
    ", &current.signature[0..$]))\n            {\n                if (!r.is_ca || !r.can_sign_certificates)"
    "\n                {\n                    last = NotAuthority;\n                    continue;\n          "
    "      }\n                if (Err(e) = check_time(r, now))\n                {\n                    last "
    "= e;\n                    continue;\n                }\n                return Ok(());\n            }\n  "
    "      }\n        Option<Certificate> next = None;\n        for (usize i = 0; i < slice_len(intermediat"
    "es); i += 1)\n        {\n            ref<Certificate, shared> m = &intermediates[i];\n            if (s"
    "ame_bytes(&m.subject, &current.issuer) && !same_bytes(&m.der, &current.der))\n            {\n         "
    "       if (!verify_signature(&m.key, &current.scheme, &current.tbs[0..$], &current.signature[0..$]))"
    "\n                {\n                    last = BadSignature;\n                    continue;\n          "
    "      }\n                if (!m.is_ca || !m.can_sign_certificates)\n                {\n                "
    "    return Err(NotAuthority);\n                }\n                if (m.max_path_len >= 0 && narrow<i6"
    "4>(below) > m.max_path_len)\n                {\n                    return Err(NotAuthority);\n        "
    "        }\n                check_time(m, now)?;\n                overwrite(&mut next, Some(Certificate"
    "::clone(m)));\n                break;\n            }\n        }\n        match (next)\n        {\n        "
    "    Some(n) :\n            {\n                overwrite(&mut current, n);\n                below += 1;\n"
    "            },\n            None    : return Err(last),\n        }\n    }\n    Err(ChainTooLong)\n}fn der"
    "_push_len(ref<Vec<u8>, exclusive> out, usize len)\n{\n    if (len < 0x80)\n    {\n        Vec::push(out,"
    " narrow<u8>(len));\n        return;\n    }\n    usize count = 1;\n    while ((len >> narrow<u32>(8 * cou"
    "nt)) != 0)\n    {\n        count += 1;\n    }\n    Vec::push(out, 0x80 | narrow<u8>(count));\n    for (us"
    "ize i = 0; i < count; i += 1)\n    {\n        Vec::push(out, narrow_wrapping<u8>(len >> narrow<u32>(8 "
    "* (count - 1 - i))));\n    }\n}fn der_wrap(u8 tag, slice<u8, shared> content) : Vec<u8>\n{\n    Vec<u8> "
    "out = Vec::new();\n    Vec::push(&mut out, tag);\n    der_push_len(&mut out, slice_len(content));\n    "
    "Vec::extend_from(&mut out, content);\n    out\n}fn der_uint(slice<u8, shared> v) : Vec<u8>\n{\n    usize"
    " from = 0;\n    while (from + 1 < slice_len(v) && v[from] == 0)\n    {\n        from += 1;\n    }\n    Ve"
    "c<u8> content = Vec::new();\n    if (slice_len(v) == 0 || (v[from] & 0x80) != 0)\n    {\n        Vec::p"
    "ush(&mut content, 0);\n    }\n    Vec::extend_from(&mut content, &v[from..$]);\n    der_wrap(0x02, &con"
    "tent[0..$])\n}fn der_big(ref<BigUint, shared> a) : Vec<u8>\n{\n    der_uint(&BigUint::to_bytes_be(a)[0."
    ".$])\n}fn der_oid_hex(str hex) : Vec<u8>\n{\n    Vec<u8> b = Result::unwrap_or(from_hex(StringView::of("
    "hex)), Vec::new());\n    der_wrap(0x06, &b[0..$])\n}fn der_bit_string(slice<u8, shared> bytes) : Vec<u"
    "8>\n{\n    Vec<u8> content = Vec::new();\n    Vec::push(&mut content, 0);\n    Vec::extend_from(&mut con"
    "tent, bytes);\n    der_wrap(0x03, &content[0..$])\n}fn curve_oid_hex(EcCurve c) : str\n{\n    match (c)\n"
    "    {\n        P256 : \"2a8648ce3d030107\",\n        P384 : \"2b81040022\",\n    }\n}fn key_algorithm(ref<Ce"
    "rtKey, shared> key) : Vec<u8>\n{\n    Vec<u8> content = match (key)\n    {\n        RsaKey(_)      :\n   "
    "     {\n            Vec<u8> c = der_oid_hex(\"2a864886f70d010101\");\n            Vec::push(&mut c, 0x05"
    ");\n            Vec::push(&mut c, 0x00);\n            c\n        },\n        EcKey(k)       :\n        {\n"
    "            Vec<u8> c = der_oid_hex(\"2a8648ce3d0201\");\n            Vec::extend_from(&mut c, &der_oid"
    "_hex(curve_oid_hex(k.curve))[0..$]);\n            c\n        },\n        Ed25519Key(_)  : der_oid_hex(\""
    "2b6570\"),\n        UnsupportedKey : Vec::new(),\n    };\n    der_wrap(0x30, &content[0..$])\n}export fn "
    "CertKey::to_der(ref<CertKey, shared> key) : Option<Vec<u8>>\n{\n    Vec<u8> bits = match (key)\n    {\n "
    "       RsaKey(k)      :\n        {\n            Vec<u8> seq = der_big(&k.n);\n            Vec::extend_f"
    "rom(&mut seq, &der_big(&k.e)[0..$]);\n            der_wrap(0x30, &seq[0..$])\n        },\n        EcKey"
    "(k)       : Vec::clone(&k.point),\n        Ed25519Key(k)  : Vec::from_slice(&k[0..$]),\n        Unsupp"
    "ortedKey : return None,\n    };\n    Vec<u8> content = key_algorithm(key);\n    Vec::extend_from(&mut c"
    "ontent, &der_bit_string(&bits[0..$])[0..$]);\n    Some(der_wrap(0x30, &content[0..$]))\n}export fn Cer"
    "tKey::from_der(slice<u8, shared> der) : Result<CertKey, CertError>\n{\n    Der spki = der_expect(der, "
    "0, 0x30)?;\n    if (spki.next != slice_len(der))\n    {\n        return Err(BadEncoding);\n    }\n    mat"
    "ch (public_key_of(der, spki)?)\n    {\n        UnsupportedKey : Err(UnsupportedAlgorithm),\n        k  "
    "            : Ok(k),\n    }\n}fn pem_block(StringView text, slice<str, shared> labels) : Result<Vec<u8"
    ">, CertError>\n{\n    // The earliest BEGIN line of any of the labels.\n    Option<usize> first = None;"
    "\n    usize at = 0;\n    for (usize i = 0; i < slice_len(labels); i += 1)\n    {\n        String begin ="
    " String::from_str(\"-----BEGIN \");\n        String::append(&mut begin, labels[i]);\n        String::app"
    "end(&mut begin, \"-----\");\n        if (Some(v) = StringView::find(text, String::as_view(&begin)))\n   "
    "     {\n            if (Option::is_none(&first) || v < at)\n            {\n                first = Some"
    "(i);\n                at = v;\n            }\n        }\n    }\n    usize i = match (first)\n    {\n       "
    " Some(i) : i,\n        None    :\n        {\n            if (Option::is_some(&StringView::find(text, \"-"
    "----BEGIN ENCRYPTED PRIVATE KEY-----\")))\n            {\n                return Err(UnsupportedAlgorit"
    "hm);\n            }\n            return Err(BadEncoding);\n        },\n    };\n    String begin = String:"
    ":from_str(\"-----BEGIN \");\n    String::append(&mut begin, labels[i]);\n    String::append(&mut begin, "
    "\"-----\");\n    String end = String::from_str(\"-----END \");\n    String::append(&mut end, labels[i]);\n "
    "   String::append(&mut end, \"-----\");\n    StringView body = StringView::sub(text, at + String::len(&"
    "begin), StringView::len(text));\n    usize e = match (StringView::find(body, String::as_view(&end)))\n"
    "    {\n        Some(v) : v,\n        None    : return Err(BadEncoding),\n    };\n    String b64 = String"
    "::new();\n    StringView block = StringView::sub(body, 0, e);\n    for (usize k = 0; k < StringView::l"
    "en(block); k += 1)\n    {\n        u8 c = block.bytes[k];\n        if (c >= 128)\n        {\n            "
    "return Err(BadEncoding);\n        }\n        if (!ascii_is_space(c))\n        {\n            String::pus"
    "h_ascii(&mut b64, c);\n        }\n    }\n    match (base64_decode(String::as_view(&b64)))\n    {\n       "
    " Ok(der) : Ok(der),\n        Err(_)  : Err(BadEncoding),\n    }\n}fn pem_of(str label, slice<u8, shared"
    "> der) : String\n{\n    String out = String::from_str(\"-----BEGIN \");\n    String::append(&mut out, lab"
    "el);\n    String::append(&mut out, \"-----\\n\");\n    String b64 = base64_encode(der);\n    usize n = Str"
    "ing::len(&b64);\n    for (usize at = 0; at < n; at += 64)\n    {\n        String::append(&mut out, Stri"
    "ngView::sub(String::as_view(&b64), at, min(at + 64, n)));\n        String::append(&mut out, \"\\n\");\n  "
    "  }\n    String::append(&mut out, \"-----END \");\n    String::append(&mut out, label);\n    String::appe"
    "nd(&mut out, \"-----\\n\");\n    out\n}export fn CertKey::from_pem(StringView text) : Result<CertKey, Cer"
    "tError>\n{\n    array<str, 1> labels = [\"PUBLIC KEY\"];\n    Vec<u8> der = pem_block(text, &labels[0..$]"
    ")?;\n    CertKey::from_der(&der[0..$])\n}export fn CertKey::to_pem(ref<CertKey, shared> key) : Option<"
    "String>\n{\n    Some(pem_of(\"PUBLIC KEY\", &CertKey::to_der(key)?[0..$]))\n}unittest \"CertKey::to_pem: r"
    "ead back by from_pem\"\n{\n    CertKey key = Ed25519Key([0x42; 32]);\n    String pem = Option::unwrap(Ce"
    "rtKey::to_pem(&key));\n    assert(StringView::starts_with(String::as_view(&pem), \"-----BEGIN PUBLIC K"
    "EY-----\\n\"));\n    match (CertKey::from_pem(String::as_view(&pem)))\n    {\n        Ok(Ed25519Key(k)) :"
    " assert(k[0] == 0x42 && k[31] == 0x42),\n        _                 : assert(false),\n    }\n}export fn "
    "PrivateKey::public_key(ref<PrivateKey, shared> key) : CertKey\n{\n    match (key)\n    {\n        RsaPri"
    "vate(k)     : RsaKey(RsaPrivateKey::public_key(k)),\n        EcPrivate(k) : EcKey(EcPublicKey { .curv"
    "e = k.curve, .point = Option::unwrap_or(\n            ec_public_key(k.curve, &k.scalar[0..$]),\n      "
    "      Vec::new(),\n        ) }),\n        Ed25519Private(k) : Ed25519Key(ed25519_public_key(&k[0..$]))"
    ",\n    }\n}fn rsa_private_of(slice<u8, shared> buf, usize at) : Result<PrivateKey, CertError>\n{\n    De"
    "r seq = der_expect(buf, at, 0x30)?;\n    Der version = der_expect(buf, seq.start, 0x02)?;\n    Der n ="
    " der_expect(buf, version.next, 0x02)?;\n    Der e = der_expect(buf, n.next, 0x02)?;\n    Der d = der_e"
    "xpect(buf, e.next, 0x02)?;\n    Der p = der_expect(buf, d.next, 0x02)?;\n    Der q = der_expect(buf, p"
    ".next, 0x02)?;\n    match (RsaPrivateKey::new(\n        BigUint::from_bytes_be(&buf[n.start..n.end]),\n"
    "        BigUint::from_bytes_be(&buf[e.start..e.end]),\n        BigUint::from_bytes_be(&buf[d.start..d"
    ".end]),\n        BigUint::from_bytes_be(&buf[p.start..p.end]),\n        BigUint::from_bytes_be(&buf[q."
    "start..q.end]),\n    ))\n    {\n        Some(k) : Ok(RsaPrivate(k)),\n        None    : Err(BadEncoding)"
    ",\n    }\n}fn ec_private_of(slice<u8, shared> buf, usize at, Option<EcCurve> curve) : Result<PrivateKe"
    "y, CertError>\n{\n    Der seq = der_expect(buf, at, 0x30)?;\n    Der version = der_expect(buf, seq.star"
    "t, 0x02)?;\n    Der scalar = der_expect(buf, version.next, 0x04)?;\n    Option<EcCurve> found = curve;"
    "\n    usize p_at = scalar.next;\n    while (p_at < seq.end)\n    {\n        Der field = match (der_read("
    "buf, p_at))\n        {\n            Some(v) : v,\n            None    : return Err(BadEncoding),\n      "
    "  };\n        if (field.tag == 0xa0)\n        {\n            Der oid = der_expect(buf, field.start, 0x0"
    "6)?;\n            if (der_eq_hex(buf, oid, \"2a8648ce3d030107\"))\n            {\n                found ="
    " Some(P256);\n            }\n            else if (der_eq_hex(buf, oid, \"2b81040022\"))\n            {\n  "
    "              found = Some(P384);\n            }\n            else\n            {\n                retur"
    "n Err(UnsupportedAlgorithm);\n            }\n        }\n        p_at = field.next;\n    }\n    EcCurve c "
    "= match (found)\n    {\n        Some(v) : v,\n        None    : return Err(UnsupportedAlgorithm),\n    }"
    ";\n    Vec<u8> k = Vec::from_slice(&buf[scalar.start..scalar.end]);\n    usize want = if (c == P256) {"
    " 32 } else { 48 };\n    if (Vec::len(&k) != want || Option::is_none(&ec_public_key(c, &k[0..$])))\n   "
    " {\n        return Err(BadEncoding);\n    }\n    Ok(EcPrivate(EcPrivateKey { .curve = c, .scalar = k })"
    ")\n}export fn PrivateKey::from_der(slice<u8, shared> der) : Result<PrivateKey, CertError>\n{\n    Der s"
    "eq = der_expect(der, 0, 0x30)?;\n    if (seq.next != slice_len(der))\n    {\n        return Err(BadEnco"
    "ding);\n    }\n    Der version = der_expect(der, seq.start, 0x02)?;\n    Der second = match (der_read(d"
    "er, version.next))\n    {\n        Some(v) : v,\n        None    : return Err(BadEncoding),\n    };\n    "
    "if (second.tag == 0x02)\n    {\n        return rsa_private_of(der, 0);\n    }\n    if (second.tag == 0x0"
    "4)\n    {\n        return ec_private_of(der, 0, None);\n    }\n    if (second.tag != 0x30)\n    {\n       "
    " return Err(BadEncoding);\n    }\n    Der oid = der_expect(der, second.start, 0x06)?;\n    Der key = de"
    "r_expect(der, second.next, 0x04)?;\n    if (der_eq_hex(der, oid, \"2a864886f70d010101\"))\n    {\n       "
    " return rsa_private_of(der, key.start);\n    }\n    if (der_eq_hex(der, oid, \"2a8648ce3d0201\"))\n    {\n"
    "        Der curve = der_expect(der, oid.next, 0x06)?;\n        if (der_eq_hex(der, curve, \"2a8648ce3d"
    "030107\"))\n        {\n            return ec_private_of(der, key.start, Some(P256));\n        }\n        "
    "if (der_eq_hex(der, curve, \"2b81040022\"))\n        {\n            return ec_private_of(der, key.start,"
    " Some(P384));\n        }\n        return Err(UnsupportedAlgorithm);\n    }\n    if (der_eq_hex(der, oid,"
    " \"2b6570\"))\n    {\n        Der inner = der_expect(der, key.start, 0x04)?;\n        if (inner.end - inn"
    "er.start != 32 || inner.next != key.end)\n        {\n            return Err(BadEncoding);\n        }\n  "
    "      array<u8, 32> seed = [0; 32];\n        for (usize i = 0; i < 32; i += 1)\n        {\n            "
    "seed[i] = der[inner.start + i];\n        }\n        return Ok(Ed25519Private(seed));\n    }\n    Err(Uns"
    "upportedAlgorithm)\n}export fn PrivateKey::to_der(ref<PrivateKey, shared> key) : Vec<u8>\n{\n    CertKe"
    "y public = PrivateKey::public_key(key);\n    Vec<u8> inner = match (key)\n    {\n        RsaPrivate(k) "
    "    :\n        {\n            BigUint one = BigUint::from_u64(1);\n            BigUint p1 = BigUint::su"
    "b(&k.p, &one);\n            BigUint q1 = BigUint::sub(&k.q, &one);\n            Vec<u8> seq = der_uint"
    "(&[0: u8][0..$]);\n            Vec::extend_from(&mut seq, &der_big(&k.n)[0..$]);\n            Vec::ext"
    "end_from(&mut seq, &der_big(&k.e)[0..$]);\n            Vec::extend_from(&mut seq, &der_big(&k.d)[0..$"
    "]);\n            Vec::extend_from(&mut seq, &der_big(&k.p)[0..$]);\n            Vec::extend_from(&mut "
    "seq, &der_big(&k.q)[0..$]);\n            Vec::extend_from(&mut seq, &der_big(&BigUint::rem(&k.d, &p1)"
    ")[0..$]);\n            Vec::extend_from(&mut seq, &der_big(&BigUint::rem(&k.d, &q1))[0..$]);\n        "
    "    Vec::extend_from(\n                &mut seq,\n                &der_big(&Option::unwrap_or(BigUint:"
    ":mod_inverse(&k.q, &k.p), BigUint::zero()))[0..$],\n            );\n            der_wrap(0x30, &seq[0."
    ".$])\n        },\n        EcPrivate(k)      :\n        {\n            Vec<u8> seq = der_uint(&[1: u8][0."
    ".$]);\n            Vec::extend_from(&mut seq, &der_wrap(0x04, &k.scalar[0..$])[0..$]);\n            Ve"
    "c<u8> point = match (&public)\n            {\n                EcKey(pk) : Vec::clone(&pk.point),\n     "
    "           _         : Vec::new(),\n            };\n            Vec::extend_from(&mut seq, &der_wrap(0"
    "xa1, &der_bit_string(&point[0..$])[0..$])[0..$]);\n            der_wrap(0x30, &seq[0..$])\n        },\n"
    "        Ed25519Private(k) : der_wrap(0x04, &k[0..$]),\n    };\n    Vec<u8> content = der_uint(&[0: u8]"
    "[0..$]);\n    Vec::extend_from(&mut content, &key_algorithm(&public)[0..$]);\n    Vec::extend_from(&mu"
    "t content, &der_wrap(0x04, &inner[0..$])[0..$]);\n    der_wrap(0x30, &content[0..$])\n}export fn Priva"
    "teKey::from_pem(StringView text) : Result<PrivateKey, CertError>\n{\n    array<str, 3> labels = [\"PRIV"
    "ATE KEY\", \"RSA PRIVATE KEY\", \"EC PRIVATE KEY\"];\n    Vec<u8> der = pem_block(text, &labels[0..$])?;\n "
    "   PrivateKey::from_der(&der[0..$])\n}unittest \"PrivateKey::from_pem: an encrypted key is not read\"\n{"
    "\n    StringView text = \"-----BEGIN ENCRYPTED PRIVATE KEY-----\\nAAAA\\n-----END ENCRYPTED PRIVATE KEY-"
    "----\\n\";\n    match (PrivateKey::from_pem(text))\n    {\n        Err(UnsupportedAlgorithm) : assert(tru"
    "e),\n        _                         : assert(false),\n    }\n}export fn PrivateKey::to_pem(ref<Priva"
    "teKey, shared> key) : String\n{\n    pem_of(\"PRIVATE KEY\", &PrivateKey::to_der(key)[0..$])\n}export fn "
    "sign(\n    ref<PrivateKey, shared> key,\n    ref<SignatureScheme, shared> scheme,\n    slice<u8, shared"
    "> message,\n) : Option<Vec<u8>>\n{\n    match (scheme)\n    {\n        RsaPkcs1(h) : match (key)\n        "
    "{\n            RsaPrivate(k) : Some(rsa_sign_pkcs1v15(k, *h, &hash(*h, message)[0..$])),\n            "
    "_             : None,\n        },\n        RsaPss(h) : match (key)\n        {\n            RsaPrivate(k)"
    " : Some(rsa_sign_pss(k, *h, &hash(*h, message)[0..$])),\n            _             : None,\n        },"
    "\n        Ecdsa(h) : match (key)\n        {\n            EcPrivate(k) : ecdsa_sign(k.curve, &k.scalar[0"
    "..$], &hash(*h, message)[0..$]),\n            _            : None,\n        },\n        Ed25519 : match"
    " (key)\n        {\n            Ed25519Private(k) : Some(Vec::from_slice(&ed25519_sign(&k[0..$], messag"
    "e)[0..$])),\n            _                 : None,\n        },\n        UnsupportedSignature : None,\n  "
    "  }\n}unittest \"sign: a key of another kind gives None\"\n{\n    PrivateKey key = Ed25519Private([1; 32]"
    ");\n    SignatureScheme scheme = RsaPss(Sha2_256);\n    assert(Option::is_none(&sign(&key, &scheme, &b"
    "\"message\"[0..$])));\n}export fn TlsError::text(ref<TlsError, shared> e) : str\n{\n    match (e)\n    {\n "
    "       TlsNetFailure(n) : NetError::text(n),\n        CertRejected(c)  : CertError::text(c),\n        "
    "HandshakeFailed  : \"TLS handshake failed\",\n        ProtocolError    : \"TLS protocol violation\",\n    "
    "    PeerAlert(code) : match (*code)\n        {\n            40  : \"the peer refused the handshake (ale"
    "rt 40): it supports none of the suites (ChaCha20-Poly1305, AES-128-GCM, AES-256-GCM) or key exchange"
    "s (X25519, P-256, P-384) offered\",\n            42  : \"the peer refused a certificate (alert 42)\",\n  "
    "          70  : \"the peer does not speak TLS 1.3 (alert 70)\",\n            80  : \"the peer failed int"
    "ernally (alert 80)\",\n            109 : \"the peer requires an extension that was not sent (alert 109)"
    "\",\n            112 : \"the peer does not know the name asked for (alert 112)\",\n            _   : \"the"
    " peer sent a TLS alert\",\n        },\n        RecordRejected   : \"a TLS record did not authenticate\",\n"
    "    }\n}unittest \"TlsError::text: alerts and network failures\"\n{\n    TlsError e = PeerAlert(70);\n    "
    "assert(TlsError::text(&e) == \"the peer does not speak TLS 1.3 (alert 70)\");\n    TlsError n = TlsNetF"
    "ailure(Refused);\n    assert(TlsError::text(&n) == \"connection refused\");\n}fn suite_hash(u16 suite) :"
    " HashKind\n{\n    if (suite == 0x1302) { Sha2_384 } else { Sha2_256 }\n}fn suite_key_len(u16 suite) : u"
    "size\n{\n    if (suite == 0x1301) { 16 } else { 32 }\n}fn keys_from(slice<u8, shared> secret, u16 suite"
    ") : RecordKeys\n{\n    Vec<u8> none = Vec::new();\n    HashKind kind = suite_hash(suite);\n    RecordKey"
    "s {\n        .key = hkdf_expand_label_with(kind, secret, \"key\", &none[0..$], suite_key_len(suite)),\n "
    "       .iv = hkdf_expand_label_with(kind, secret, \"iv\", &none[0..$], 12),\n        .seq = 0,\n        "
    ".secret = Vec::from_slice(secret),\n        .suite = suite,\n    }\n}fn record_nonce(ref<RecordKeys, sh"
    "ared> k) : Vec<u8>\n{\n    Vec<u8> n = Vec::clone(&k.iv);\n    for (usize i = 0; i < 8; i += 1)\n    {\n "
    "       n[4 + i] = n[4 + i] ^ narrow_wrapping<u8>(k.seq >> narrow<u32>(56 - 8 * i));\n    }\n    n\n}exp"
    "ort fn TlsStream::peer_certificate(ref<TlsStream, shared> s) : Option<ref<Certificate, shared>>\n{\n  "
    "  match (&s.peer)\n    {\n        Some(c) : Some(c),\n        None    : None,\n    }\n}export fn TlsStrea"
    "m::peer_addr(ref<TlsStream, shared> s) : SocketAddr\n{\n    TcpStream::peer_addr(&s.tcp)\n}export fn Tl"
    "sStream::local_addr(ref<TlsStream, shared> s) : SocketAddr\n{\n    TcpStream::local_addr(&s.tcp)\n}fn r"
    "ead_record(ref<TcpStream, exclusive> tcp) : Result<Record, TlsError>\n{\n    Vec<u8> header = Vec::new"
    "();\n    match (TcpStream::read_exact(tcp, &mut header, 5))\n    {\n        Ok(_)  : {},\n        Err(e)"
    " : return Err(TlsNetFailure(e)),\n    }\n    usize len = widen<usize>(read_be<u16>(&header[0..$], 3));"
    "\n    if (len > 16384 + 256)\n    {\n        return Err(ProtocolError);\n    }\n    Vec<u8> body = Vec::n"
    "ew();\n    match (TcpStream::read_exact(tcp, &mut body, len))\n    {\n        Ok(_)  : {},\n        Err("
    "e) : return Err(TlsNetFailure(e)),\n    }\n    Ok(Record { .kind = header[0], .header = header, .body "
    "= body })\n}fn write_all(ref<TcpStream, exclusive> tcp, slice<u8, shared> data) : Result<void, TlsErr"
    "or>\n{\n    match (TcpStream::write(tcp, data))\n    {\n        Ok(_)  : Ok(()),\n        Err(e) : Err(Tl"
    "sNetFailure(e)),\n    }\n}fn seal_record(ref<RecordKeys, exclusive> k, u8 kind, slice<u8, shared> cont"
    "ent) : Vec<u8>\n{\n    Vec<u8> inner = Vec::from_slice(content);\n    Vec::push(&mut inner, kind);\n    "
    "Vec<u8> header = Vec::new();\n    Vec::push(&mut header, 23);\n    Vec::push_be(&mut header, 0x0303: u"
    "16);\n    Vec::push_be(&mut header, narrow<u16>(Vec::len(&inner) + 16));\n    Vec<u8> nonce = record_n"
    "once(k);\n    Vec<u8> sealed = if (k.suite != 0x1303)\n    {\n        aes_gcm_seal(&k.key[0..$], &nonce"
    "[0..$], &header[0..$], &inner[0..$])\n    }\n    else\n    {\n        chacha20_poly1305_seal(&k.key[0..$"
    "], &nonce[0..$], &header[0..$], &inner[0..$])\n    };\n    k.seq += 1;\n    Vec::extend_from(&mut heade"
    "r, &sealed[0..$]);\n    header\n}fn open_record(ref<RecordKeys, exclusive> k, ref<Record, shared> r) :"
    " Result<Inner, TlsError>\n{\n    if (r.kind != 23)\n    {\n        return Err(ProtocolError);\n    }\n    "
    "Vec<u8> nonce = record_nonce(k);\n    Option<Vec<u8>> opened = if (k.suite != 0x1303)\n    {\n        a"
    "es_gcm_open(&k.key[0..$], &nonce[0..$], &r.header[0..$], &r.body[0..$])\n    }\n    else\n    {\n       "
    " chacha20_poly1305_open(&k.key[0..$], &nonce[0..$], &r.header[0..$], &r.body[0..$])\n    };\n    Vec<u"
    "8> plain = match (opened)\n    {\n        Some(p) : p,\n        None    : return Err(RecordRejected),\n "
    "   };\n    k.seq += 1;\n    usize n = Vec::len(&plain);\n    while (n > 0 && plain[n - 1] == 0)\n    {\n "
    "       n -= 1;\n    }\n    if (n == 0 || n - 1 > 16384)\n    {\n        return Err(ProtocolError);\n    }"
    "\n    u8 kind = plain[n - 1];\n    Vec::truncate(&mut plain, n - 1);\n    Ok(Inner { .kind = kind, .con"
    "tent = plain })\n}fn transcript_add(ref<Handshake, exclusive> hs, slice<u8, shared> msg)\n{\n    Hasher"
    "::update(&mut hs.t256, msg);\n    Hasher::update(&mut hs.t384, msg);\n}fn next_message(\n    ref<Handsh"
    "ake, exclusive> hs,\n    ref<TcpStream, exclusive> tcp,\n    ref<Option<RecordKeys>, exclusive> keys,\n"
    ") : Result<Vec<u8>, TlsError>\n{\n    while (Vec::len(&hs.buffer) < 4 || Vec::len(&hs.buffer) < 4 + (w"
    "iden<usize>(hs.buffer[1]) << 16 | widen<usize>(hs.buffer[2]) << 8 | widen<usize>(hs.buffer[3])))\n   "
    " {\n        Record r = read_record(tcp)?;\n        if (r.kind == 20)\n        {\n            // A compat"
    "ibility ChangeCipherSpec (RFC 8446 §D.4): ignored.\n            continue;\n        }\n        if (r.ki"
    "nd == 21)\n        {\n            if (Vec::len(&r.body) == 2)\n            {\n                return Err"
    "(PeerAlert(r.body[1]));\n            }\n            return Err(ProtocolError);\n        }\n        match"
    " (keys)\n        {\n            Some(k) :\n            {\n                Inner i = open_record(k, &r)?;"
    "\n                if (i.kind == 21)\n                {\n                    return Err(PeerAlert(if (Ve"
    "c::len(&i.content) == 2) { i.content[1] } else { 0 }));\n                }\n                if (i.kind"
    " != 22)\n                {\n                    return Err(ProtocolError);\n                }\n         "
    "       Vec::extend_from(&mut hs.buffer, &i.content[0..$]);\n            },\n            None    :\n    "
    "        {\n                if (r.kind != 22)\n                {\n                    return Err(Protoco"
    "lError);\n                }\n                Vec::extend_from(&mut hs.buffer, &r.body[0..$]);\n        "
    "    },\n        }\n    }\n    usize len = 4 + (widen<usize>(hs.buffer[1]) << 16 | widen<usize>(hs.buffe"
    "r[2]) << 8 | widen<usize>(hs.buffer[3]));\n    Vec<u8> msg = Vec::from_slice(&hs.buffer[0..len]);\n   "
    " Vec<u8> rest = Vec::from_slice(&hs.buffer[len..$]);\n    overwrite(&mut hs.buffer, rest);\n    transc"
    "ript_add(hs, &msg[0..$]);\n    Ok(msg)\n}fn push_u24(ref<Vec<u8>, exclusive> v, usize n)\n{\n    Vec::pu"
    "sh(v, narrow<u8>(n >> 16));\n    Vec::push(v, narrow_wrapping<u8>(n >> 8));\n    Vec::push(v, narrow_w"
    "rapping<u8>(n));\n}fn push_extension(ref<Vec<u8>, exclusive> out, u16 kind, slice<u8, shared> data)\n{"
    "\n    Vec::push_be(out, kind);\n    Vec::push_be(out, narrow<u16>(slice_len(data)));\n    Vec::extend_f"
    "rom(out, data);\n}fn client_hello(\n    StringView server_name,\n    slice<u8, shared> random,\n    slic"
    "e<u8, shared> session,\n    u16 group,\n    slice<u8, shared> public_key,\n    slice<u8, shared> cookie"
    ",\n) : Vec<u8>\n{\n    Vec<u8> ext = Vec::new();\n    if (Result::is_err(&IpAddr::parse(server_name)))\n "
    "   {\n        Vec<u8> sni = Vec::new();\n        Vec::push_be(&mut sni, narrow<u16>(StringView::len(se"
    "rver_name) + 3));\n        Vec::push(&mut sni, 0);\n        Vec::push_be(&mut sni, narrow<u16>(StringV"
    "iew::len(server_name)));\n        Vec::extend_from(&mut sni, server_name.bytes);\n        push_extensi"
    "on(&mut ext, 0x0000, &sni[0..$]);\n    }\n    array<u8, 8> groups = [0x00, 0x06, 0x00, 0x1d, 0x00, 0x1"
    "7, 0x00, 0x18];\n    push_extension(&mut ext, 0x000a, &groups[0..$]);\n    array<u8, 20> algs = [\n    "
    "    0x00,\n        0x12,\n        0x04,\n        0x03,\n        0x05,\n        0x03,\n        0x08,\n      "
    "  0x04,\n        0x08,\n        0x05,\n        0x08,\n        0x06,\n        0x08,\n        0x07,\n        "
    "0x04,\n        0x01,\n        0x05,\n        0x01,\n        0x06,\n        0x01,\n    ];\n    push_extensio"
    "n(&mut ext, 0x000d, &algs[0..$]);\n    array<u8, 3> versions = [0x02, 0x03, 0x04];\n    push_extension"
    "(&mut ext, 0x002b, &versions[0..$]);\n    Vec<u8> share = Vec::new();\n    Vec::push_be(&mut share, na"
    "rrow<u16>(4 + slice_len(public_key)));\n    Vec::push_be(&mut share, group);\n    Vec::push_be(&mut sh"
    "are, narrow<u16>(slice_len(public_key)));\n    Vec::extend_from(&mut share, public_key);\n    push_ext"
    "ension(&mut ext, 0x0033, &share[0..$]);\n    if (slice_len(cookie) > 0)\n    {\n        push_extension("
    "&mut ext, 0x002c, cookie);\n    }\n    Vec<u8> body = Vec::new();\n    Vec::push_be(&mut body, 0x0303: "
    "u16);\n    Vec::extend_from(&mut body, random);\n    Vec::push(&mut body, 32);\n    Vec::extend_from(&m"
    "ut body, session);\n    array<u8, 8> suites = [0x00, 0x06, 0x13, 0x03, 0x13, 0x01, 0x13, 0x02];\n    V"
    "ec::extend_from(&mut body, &suites[0..$]);\n    Vec::push(&mut body, 1);\n    Vec::push(&mut body, 0);"
    "\n    Vec::push_be(&mut body, narrow<u16>(Vec::len(&ext)));\n    Vec::extend_from(&mut body, &ext[0..$"
    "]);\n    Vec<u8> msg = Vec::new();\n    Vec::push(&mut msg, 1);\n    push_u24(&mut msg, Vec::len(&body)"
    ");\n    Vec::extend_from(&mut msg, &body[0..$]);\n    msg\n}fn server_hello(slice<u8, shared> sh, slice"
    "<u8, shared> session) : Result<ServerHello, TlsError>\n{\n    usize n = slice_len(sh);\n    if (n < 4 +"
    " 2 + 32 + 1 || sh[0] != 2)\n    {\n        return Err(ProtocolError);\n    }\n    // HelloRetryRequest's"
    " fixed random.\n    Vec<u8> hrr = Result::unwrap_or(\n        from_hex(\"cf21ad74e59a6111be1d8c021e65b8"
    "91c2a211167abb8c5e079e09e2c8a8339c\"),\n        Vec::new(),\n    );\n    bool retry = digest_eq(&sh[6..3"
    "8], &hrr[0..$]);\n    usize at = 38;\n    usize sid_len = widen<usize>(sh[at]);\n    if (sid_len != sli"
    "ce_len(session) || at + 1 + sid_len + 3 + 2 > n || !digest_eq(\n        &sh[at + 1..at + 1 + sid_len]"
    ",\n        session,\n    ))\n    {\n        return Err(ProtocolError);\n    }\n    at = at + 1 + sid_len;\n"
    "    u16 suite = read_be<u16>(sh, at);\n    if ((suite != 0x1303 && suite != 0x1301 && suite != 0x1302"
    ") || sh[at + 2] != 0)\n    {\n        return Err(HandshakeFailed);\n    }\n    at += 3;\n    usize ext_en"
    "d = at + 2 + widen<usize>(read_be<u16>(sh, at));\n    if (ext_end != n)\n    {\n        return Err(Prot"
    "ocolError);\n    }\n    at += 2;\n    bool tls13 = false;\n    Option<u16> group = None;\n    Vec<u8> sha"
    "re = Vec::new();\n    Vec<u8> cookie = Vec::new();\n    while (at + 4 <= ext_end)\n    {\n        u16 ki"
    "nd = read_be<u16>(sh, at);\n        usize len = widen<usize>(read_be<u16>(sh, at + 2));\n        usize"
    " start = at + 4;\n        if (start + len > ext_end)\n        {\n            return Err(ProtocolError);"
    "\n        }\n        if (kind == 0x002b)\n        {\n            tls13 = len == 2 && sh[start] == 0x03 &"
    "& sh[start + 1] == 0x04;\n        }\n        else if (kind == 0x0033)\n        {\n            if (len < "
    "2)\n            {\n                return Err(ProtocolError);\n            }\n            u16 g = read_b"
    "e<u16>(sh, start);\n            if (g != 0x001d && g != 0x0017 && g != 0x0018)\n            {\n        "
    "        return Err(HandshakeFailed);\n            }\n            group = Some(g);\n            if (!ret"
    "ry)\n            {\n                usize want = if (g == 0x001d) { 32 } else if (g == 0x0017) { 65 } "
    "else { 97 };\n                if (len != 4 + want || widen<usize>(read_be<u16>(sh, start + 2)) != wan"
    "t)\n                {\n                    return Err(HandshakeFailed);\n                }\n            "
    "    overwrite(&mut share, Vec::from_slice(&sh[start + 4..start + len]));\n            }\n            e"
    "lse if (len != 2)\n            {\n                return Err(ProtocolError);\n            }\n        }\n "
    "       else if (kind == 0x002c && retry)\n        {\n            overwrite(&mut cookie, Vec::from_slic"
    "e(&sh[start..start + len]));\n        }\n        at = start + len;\n    }\n    if (!tls13)\n    {\n       "
    " return Err(HandshakeFailed);\n    }\n    match (group)\n    {\n        Some(g) : Ok(ServerHello { .retr"
    "y = retry, .suite = suite, .group = g, .share = share, .cookie = cookie }),\n        None    : Err(Ha"
    "ndshakeFailed),\n    }\n}fn handshake_record(slice<u8, shared> msg, u16 version) : Vec<u8>\n{\n    Vec<u"
    "8> rec = Vec::new();\n    Vec::push(&mut rec, 22);\n    Vec::push_be(&mut rec, version);\n    Vec::push"
    "_be(&mut rec, narrow<u16>(slice_len(msg)));\n    Vec::extend_from(&mut rec, msg);\n    rec\n}fn transcr"
    "ipt_hash(ref<Handshake, shared> hs) : Vec<u8>\n{\n    match (hs.kind)\n    {\n        Sha2_384 : Hasher:"
    ":finish(hs.t384),\n        _        : Hasher::finish(hs.t256),\n    }\n}fn derive_secret(HashKind kind,"
    " slice<u8, shared> secret, StringView label, slice<u8, shared> transcript) : Vec<u8>\n{\n    hkdf_expa"
    "nd_label_with(kind, secret, label, transcript, slice_len(secret))\n}fn certificate_list(slice<u8, sha"
    "red> m) : Result<Vec<Certificate>, TlsError>\n{\n    usize n = slice_len(m);\n    if (n < 8 || m[0] != "
    "11 || m[4] != 0)\n    {\n        return Err(ProtocolError);\n    }\n    usize at = 5;\n    usize list_end"
    " = at + 3 + (widen<usize>(m[at]) << 16 | widen<usize>(m[at + 1]) << 8 | widen<usize>(m[at + 2]));\n  "
    "  if (list_end != n)\n    {\n        return Err(ProtocolError);\n    }\n    at += 3;\n    Vec<Certificate"
    "> out = Vec::new();\n    while (at < list_end)\n    {\n        if (at + 3 > list_end)\n        {\n       "
    "     return Err(ProtocolError);\n        }\n        usize len = widen<usize>(m[at]) << 16 | widen<usiz"
    "e>(m[at + 1]) << 8 | widen<usize>(m[at + 2]);\n        usize start = at + 3;\n        if (start + len "
    "+ 2 > list_end)\n        {\n            return Err(ProtocolError);\n        }\n        match (Certificat"
    "e::parse(&m[start..start + len]))\n        {\n            Ok(c)  : Vec::push(&mut out, c),\n           "
    " Err(e) : return Err(CertRejected(e)),\n        }\n        usize ext_len = widen<usize>(read_be<u16>(m"
    ", start + len));\n        at = start + len + 2 + ext_len;\n    }\n    if (Vec::len(&out) == 0)\n    {\n  "
    "      return Err(HandshakeFailed);\n    }\n    Ok(out)\n}fn certificate_verify_ok(slice<u8, shared> m, "
    "ref<Certificate, shared> leaf, slice<u8, shared> transcript) : bool\n{\n    if (slice_len(m) < 8 || m["
    "0] != 15)\n    {\n        return false;\n    }\n    u16 code = read_be<u16>(m, 4);\n    usize len = widen"
    "<usize>(read_be<u16>(m, 6));\n    if (8 + len != slice_len(m))\n    {\n        return false;\n    }\n    "
    "SignatureScheme scheme = UnsupportedSignature;\n    bool curve_ok = true;\n    if (code == 0x0403 || c"
    "ode == 0x0503)\n    {\n        EcCurve want = if (code == 0x0403) { P256 } else { P384 };\n        curv"
    "e_ok = match (&leaf.key)\n        {\n            EcKey(k) : k.curve == want,\n            _        : fa"
    "lse,\n        };\n        scheme = Ecdsa(if (code == 0x0403) { Sha2_256 } else { Sha2_384 });\n    }\n  "
    "  else if (code == 0x0804)\n    {\n        scheme = RsaPss(Sha2_256);\n    }\n    else if (code == 0x080"
    "5)\n    {\n        scheme = RsaPss(Sha2_384);\n    }\n    else if (code == 0x0806)\n    {\n        scheme "
    "= RsaPss(Sha2_512);\n    }\n    else if (code == 0x0807)\n    {\n        scheme = Ed25519;\n    }\n    if "
    "(!curve_ok)\n    {\n        return false;\n    }\n    Vec<u8> content = Vec::filled(64, 0x20: u8);\n    V"
    "ec::extend_from(&mut content, &b\"TLS 1.3, server CertificateVerify\"[0..$]);\n    Vec::push(&mut conte"
    "nt, 0);\n    Vec::extend_from(&mut content, transcript);\n    verify_signature(&leaf.key, &scheme, &co"
    "ntent[0..$], &m[8..$])\n}fn finished_data(HashKind kind, slice<u8, shared> secret, slice<u8, shared> "
    "transcript) : Vec<u8>\n{\n    Vec<u8> none = Vec::new();\n    Vec<u8> key = hkdf_expand_label_with(kind"
    ", secret, \"finished\", &none[0..$], slice_len(secret));\n    hmac(kind, &key[0..$], transcript)\n}expor"
    "t fn TlsStream::client(\n    TcpStream tcp,\n    StringView server_name,\n    ref<TrustStore, shared> r"
    "oots,\n) : Result<TlsStream, TlsError>\n{\n    array<u8, 32> private_key = x25519_private_key();\n    ar"
    "ray<u8, 32> public_key = x25519_public_key(&private_key[0..$]);\n    array<u8, 32> random = [0; 32];\n"
    "    os_random_bytes(&mut random[0..$]);\n    array<u8, 32> session = [0; 32];\n    os_random_bytes(&mu"
    "t session[0..$]);\n    Handshake hs = Handshake { .buffer = Vec::new(), .t256 = Hasher::new(Sha2_256)"
    ", .t384 = Hasher::new(Sha2_384), .kind = Sha2_256 };\n    Vec<u8> none = Vec::new();\n    Vec<u8> ch ="
    " client_hello(server_name, &random[0..$], &session[0..$], 0x001d, &public_key[0..$], &none[0..$]);\n "
    "   transcript_add(&mut hs, &ch[0..$]);\n    write_all(&mut tcp, &handshake_record(&ch[0..$], 0x0301)["
    "0..$])?;\n    Option<RecordKeys> plain = None;\n    Vec<u8> sh = next_message(&mut hs, &mut tcp, &mut "
    "plain)?;\n    ServerHello hello = server_hello(&sh[0..$], &session[0..$])?;\n    hs.kind = suite_hash("
    "hello.suite);\n    HashKind kind = hs.kind;\n    Vec<u8> ec_key = Vec::new();\n    if (hello.retry)\n   "
    " {\n        // A HelloRetryRequest (RFC 8446 §4.1.4): it may only ask for a\n        // group this cl"
    "ient offered without a share, P-256 or P-384. The\n        // transcript restarts from message_hash(C"
    "lientHello1) ‖\n        // HelloRetryRequest, under the suite's hash.\n        if ((hello.group != 0"
    "x0017 && hello.group != 0x0018) || Vec::len(&hs.buffer) != 0)\n        {\n            return Err(Hands"
    "hakeFailed);\n        }\n        EcCurve curve = if (hello.group == 0x0017) { P256 } else { P384 };\n  "
    "      Vec<u8> ch_hash = hash(kind, &ch[0..$]);\n        array<u8, 4> head = [254, 0, 0, narrow<u8>(Ve"
    "c::len(&ch_hash))];\n        Handshake restarted = Handshake { .buffer = Vec::new(), .t256 = Hasher::"
    "new(Sha2_256), .t384 = Hasher::new(Sha2_384), .kind = kind };\n        transcript_add(&mut restarted,"
    " &head[0..$]);\n        transcript_add(&mut restarted, &ch_hash[0..$]);\n        transcript_add(&mut r"
    "estarted, &sh[0..$]);\n        overwrite(&mut ec_key, ec_private_key(curve));\n        Vec<u8> ec_publ"
    "ic = Option::unwrap(ec_public_key(curve, &ec_key[0..$]));\n        Vec<u8> ch2 = client_hello(\n      "
    "      server_name,\n            &random[0..$],\n            &session[0..$],\n            hello.group,\n "
    "           &ec_public[0..$],\n            &hello.cookie[0..$],\n        );\n        transcript_add(&mut"
    " restarted, &ch2[0..$]);\n        overwrite(&mut hs, restarted);\n        write_all(&mut tcp, &handsha"
    "ke_record(&ch2[0..$], 0x0303)[0..$])?;\n        Vec<u8> sh2 = next_message(&mut hs, &mut tcp, &mut pl"
    "ain)?;\n        ServerHello second = server_hello(&sh2[0..$], &session[0..$])?;\n        if (second.re"
    "try || second.group != hello.group || second.suite != hello.suite)\n        {\n            return Err("
    "HandshakeFailed);\n        }\n        overwrite(&mut hello, second);\n    }\n    else if (hello.group !="
    " 0x001d)\n    {\n        return Err(HandshakeFailed);\n    }\n    u16 suite = hello.suite;\n    Vec<u8> s"
    "hared = Vec::new();\n    if (hello.group == 0x001d)\n    {\n        match (x25519(&private_key[0..$], &"
    "hello.share[0..$]))\n        {\n            Some(z) : Vec::extend_from(&mut shared, &z[0..$]),\n       "
    "     None    : return Err(HandshakeFailed),\n        }\n    }\n    else\n    {\n        EcCurve curve = i"
    "f (hello.group == 0x0017) { P256 } else { P384 };\n        match (ecdh(curve, &ec_key[0..$], &hello.s"
    "hare[0..$]))\n        {\n            Some(z) : overwrite(&mut shared, z),\n            None    : return"
    " Err(HandshakeFailed),\n        }\n    }\n    // The key schedule (RFC 8446 §7.1), under the suite's h"
    "ash.\n    Vec<u8> empty_hash = hash(kind, &none[0..$]);\n    Vec<u8> zeros = Vec::filled(Vec::len(&emp"
    "ty_hash), 0: u8);\n    Vec<u8> early = hkdf_extract_with(kind, &none[0..$], &zeros[0..$]);\n    Vec<u8"
    "> derived = derive_secret(kind, &early[0..$], \"derived\", &empty_hash[0..$]);\n    Vec<u8> handshake_s"
    "ecret = hkdf_extract_with(kind, &derived[0..$], &shared[0..$]);\n    Vec<u8> th = transcript_hash(&hs"
    ");\n    Vec<u8> c_hs = derive_secret(kind, &handshake_secret[0..$], \"c hs traffic\", &th[0..$]);\n    V"
    "ec<u8> s_hs = derive_secret(kind, &handshake_secret[0..$], \"s hs traffic\", &th[0..$]);\n    Option<Re"
    "cordKeys> server_keys = Some(keys_from(&s_hs[0..$], suite));\n    Vec<u8> ee = next_message(&mut hs, "
    "&mut tcp, &mut server_keys)?;\n    if (Vec::len(&ee) < 6 || ee[0] != 8)\n    {\n        return Err(Prot"
    "ocolError);\n    }\n    Vec<u8> cm = next_message(&mut hs, &mut tcp, &mut server_keys)?;\n    Vec<Certi"
    "ficate> chain = certificate_list(&cm[0..$])?;\n    Certificate leaf = Vec::remove(&mut chain, 0);\n   "
    " DateTime now = DateTime::now();\n    match (verify_chain(&leaf, &chain[0..$], roots, server_name, &n"
    "ow))\n    {\n        Ok(_)  : {},\n        Err(e) : return Err(CertRejected(e)),\n    }\n    Vec<u8> th_c"
    "ert = transcript_hash(&hs);\n    Vec<u8> cv = next_message(&mut hs, &mut tcp, &mut server_keys)?;\n   "
    " if (!certificate_verify_ok(&cv[0..$], &leaf, &th_cert[0..$]))\n    {\n        return Err(HandshakeFai"
    "led);\n    }\n    Vec<u8> th_cv = transcript_hash(&hs);\n    Vec<u8> fin = next_message(&mut hs, &mut t"
    "cp, &mut server_keys)?;\n    Vec<u8> want = finished_data(kind, &s_hs[0..$], &th_cv[0..$]);\n    if (V"
    "ec::len(&fin) != 4 + Vec::len(&want) || fin[0] != 20 || !digest_eq(&fin[4..$], &want[0..$]))\n    {\n "
    "       return Err(HandshakeFailed);\n    }\n    if (Vec::len(&hs.buffer) != 0)\n    {\n        return Er"
    "r(ProtocolError);\n    }\n    Vec<u8> th_fin = transcript_hash(&hs);\n    Vec<u8> derived2 = derive_sec"
    "ret(kind, &handshake_secret[0..$], \"derived\", &empty_hash[0..$]);\n    Vec<u8> master = hkdf_extract_"
    "with(kind, &derived2[0..$], &zeros[0..$]);\n    Vec<u8> c_ap = derive_secret(kind, &master[0..$], \"c "
    "ap traffic\", &th_fin[0..$]);\n    Vec<u8> s_ap = derive_secret(kind, &master[0..$], \"s ap traffic\", &"
    "th_fin[0..$]);\n    // The client's flight: a compatibility ChangeCipherSpec, then Finished\n    // un"
    "der the client handshake keys.\n    array<u8, 6> ccs = [20, 0x03, 0x03, 0x00, 0x01, 0x01];\n    write_"
    "all(&mut tcp, &ccs[0..$])?;\n    Vec<u8> mine = finished_data(kind, &c_hs[0..$], &th_fin[0..$]);\n    "
    "Vec<u8> cfin = Vec::new();\n    Vec::push(&mut cfin, 20);\n    push_u24(&mut cfin, Vec::len(&mine));\n "
    "   Vec::extend_from(&mut cfin, &mine[0..$]);\n    RecordKeys client_hs = keys_from(&c_hs[0..$], suite"
    ");\n    Vec<u8> out = seal_record(&mut client_hs, 22, &cfin[0..$]);\n    write_all(&mut tcp, &out[0..$"
    "])?;\n    Ok(TlsStream {\n        .tcp = tcp,\n        .send = keys_from(&c_ap[0..$], suite),\n        ."
    "recv = keys_from(&s_ap[0..$], suite),\n        .pending = Vec::new(),\n        .pending_at = 0,\n      "
    "  .closed = false,\n        .peer = Some(leaf),\n    })\n}export fn TlsStream::connect(\n    SocketAddr "
    "addr,\n    StringView server_name,\n    ref<TrustStore, shared> roots,\n) : Result<TlsStream, TlsError>"
    "\n{\n    match (TcpStream::connect(addr))\n    {\n        Ok(tcp) : TlsStream::client(tcp, server_name, "
    "roots),\n        Err(e)  : Err(TlsNetFailure(e)),\n    }\n}export fn TlsStream::write(ref<TlsStream, ex"
    "clusive> s, slice<u8, shared> data) : Result<void, TlsError>\n{\n    usize at = 0;\n    usize n = slice"
    "_len(data);\n    while (at < n)\n    {\n        usize take = min(n - at, 16384);\n        Vec<u8> rec = "
    "seal_record(&mut s.send, 23, &data[at..at + take]);\n        write_all(&mut s.tcp, &rec[0..$])?;\n    "
    "    at += take;\n    }\n    Ok(())\n}export fn TlsStream::write_text(ref<TlsStream, exclusive> s, Strin"
    "gView text) : Result<void, TlsError>\n{\n    TlsStream::write(s, text.bytes)\n}fn TlsStream::fill(ref<T"
    "lsStream, exclusive> s) : Result<void, TlsError>\n{\n    while (s.pending_at >= Vec::len(&s.pending) &"
    "& !s.closed)\n    {\n        Record r = read_record(&mut s.tcp)?;\n        if (r.kind == 20)\n        {\n"
    "            continue;\n        }\n        Inner { kind, content } = open_record(&mut s.recv, &r)?;\n   "
    "     if (kind == 23)\n        {\n            overwrite(&mut s.pending, content);\n            s.pending"
    "_at = 0;\n        }\n        else if (kind == 21)\n        {\n            if (Vec::len(&content) == 2 &&"
    " content[1] == 0)\n            {\n                s.closed = true;\n            }\n            else\n    "
    "        {\n                return Err(PeerAlert(if (Vec::len(&content) == 2) { content[1] } else { 0 "
    "}));\n            }\n        }\n        else if (kind == 22)\n        {\n            usize at = 0;\n      "
    "      while (at + 4 <= Vec::len(&content))\n            {\n                u8 t = content[at];\n       "
    "         usize len = widen<usize>(content[at + 1]) << 16 | widen<usize>(content[at + 2]) << 8 | wide"
    "n<usize>(content[at + 3]);\n                if (at + 4 + len > Vec::len(&content))\n                {\n"
    "                    return Err(ProtocolError);\n                }\n                if (t == 24)\n      "
    "          {\n                    if (len != 1)\n                    {\n                        return E"
    "rr(ProtocolError);\n                    }\n                    Vec<u8> none = Vec::new();\n            "
    "        HashKind kind = suite_hash(s.recv.suite);\n                    Vec<u8> next = hkdf_expand_lab"
    "el_with(\n                        kind,\n                        &s.recv.secret[0..$],\n               "
    "         \"traffic upd\",\n                        &none[0..$],\n                        Vec::len(&s.rec"
    "v.secret),\n                    );\n                    overwrite(&mut s.recv, keys_from(&next[0..$], "
    "s.recv.suite));\n                    if (content[at + 4] == 1)\n                    {\n                "
    "        array<u8, 5> reply = [24, 0, 0, 1, 0];\n                        Vec<u8> rec = seal_record(&mu"
    "t s.send, 22, &reply[0..$]);\n                        write_all(&mut s.tcp, &rec[0..$])?;\n           "
    "             Vec<u8> mine = hkdf_expand_label_with(\n                            kind,\n              "
    "              &s.send.secret[0..$],\n                            \"traffic upd\",\n                     "
    "       &none[0..$],\n                            Vec::len(&s.send.secret),\n                        );"
    "\n                        overwrite(&mut s.send, keys_from(&mine[0..$], s.send.suite));\n             "
    "       }\n                }\n                else if (t != 4)\n                {\n                    re"
    "turn Err(ProtocolError);\n                }\n                at = at + 4 + len;\n            }\n        "
    "}\n        else\n        {\n            return Err(ProtocolError);\n        }\n    }\n    Ok(())\n}export f"
    "n TlsStream::read(ref<TlsStream, exclusive> s, ref<Vec<u8>, exclusive> buf, usize max) : Result<usiz"
    "e, TlsError>\n{\n    if (max == 0)\n    {\n        return Ok(0);\n    }\n    TlsStream::fill(s)?;\n    usiz"
    "e have = Vec::len(&s.pending) - s.pending_at;\n    usize take = min(have, max);\n    Vec::extend_from("
    "buf, &s.pending[s.pending_at..s.pending_at + take]);\n    s.pending_at += take;\n    Ok(take)\n}export "
    "fn TlsStream::read_exact(\n    ref<TlsStream, exclusive> s,\n    ref<Vec<u8>, exclusive> buf,\n    usiz"
    "e n,\n) : Result<void, TlsError>\n{\n    usize got = 0;\n    while (got < n)\n    {\n        usize k = Tls"
    "Stream::read(s, buf, n - got)?;\n        if (k == 0)\n        {\n            return Err(TlsNetFailure(C"
    "losed));\n        }\n        got += k;\n    }\n    Ok(())\n}export fn TlsStream::read_line(ref<TlsStream,"
    " exclusive> s) : Result<Option<String>, TlsError>\n{\n    Vec<u8> line = Vec::new();\n    while (true)\n"
    "    {\n        TlsStream::fill(s)?;\n        usize n = Vec::len(&s.pending);\n        if (s.pending_at "
    ">= n)\n        {\n            if (Vec::len(&line) == 0)\n            {\n                return Ok(None);"
    "\n            }\n            break;\n        }\n        usize i = s.pending_at;\n        while (i < n && "
    "s.pending[i] != 10)\n        {\n            i += 1;\n        }\n        if (i < n)\n        {\n           "
    " Vec::extend_from(&mut line, &s.pending[s.pending_at..i]);\n            s.pending_at = i + 1;\n       "
    "     break;\n        }\n        Vec::extend_from(&mut line, &s.pending[s.pending_at..n]);\n        s.pe"
    "nding_at = n;\n    }\n    usize k = Vec::len(&line);\n    if (k > 0 && line[k - 1] == 13)\n    {\n       "
    " Vec::pop(&mut line);\n    }\n    match (String::from_utf8(line))\n    {\n        Ok(t)  : Ok(Some(t)),\n"
    "        Err(e) : Err(TlsNetFailure(NotUtf8(e))),\n    }\n}export fn TlsStream::close(ref<TlsStream, ex"
    "clusive> s) : Result<void, TlsError>\n{\n    array<u8, 2> alert = [1, 0];\n    Vec<u8> rec = seal_recor"
    "d(&mut s.send, 21, &alert[0..$]);\n    write_all(&mut s.tcp, &rec[0..$])\n}fn u16_list(slice<u8, share"
    "d> b, usize start, usize end, ref<Vec<u16>, exclusive> out) : bool\n{\n    if ((end - start) % 2 != 0)"
    "\n    {\n        return false;\n    }\n    usize at = start;\n    while (at < end)\n    {\n        Vec::pus"
    "h(out, read_be<u16>(b, at));\n        at += 2;\n    }\n    true\n}fn client_hello_parse(slice<u8, shared"
    "> m) : Result<ClientHello, TlsError>\n{\n    usize n = slice_len(m);\n    if (n < 4 + 2 + 32 + 1 || m[0"
    "] != 1)\n    {\n        return Err(ProtocolError);\n    }\n    usize at = 38;\n    usize sid_len = widen<"
    "usize>(m[at]);\n    if (sid_len > 32 || at + 1 + sid_len + 2 > n)\n    {\n        return Err(ProtocolEr"
    "ror);\n    }\n    Vec<u8> session = Vec::from_slice(&m[at + 1..at + 1 + sid_len]);\n    at = at + 1 + s"
    "id_len;\n    usize suites_len = widen<usize>(read_be<u16>(m, at));\n    at += 2;\n    if (at + suites_l"
    "en + 1 > n)\n    {\n        return Err(ProtocolError);\n    }\n    Vec<u16> suites = Vec::new();\n    if "
    "(!u16_list(m, at, at + suites_len, &mut suites))\n    {\n        return Err(ProtocolError);\n    }\n    "
    "at += suites_len;\n    usize comp_len = widen<usize>(m[at]);\n    at += 1 + comp_len;\n    ClientHello "
    "ch = ClientHello {\n        .session = session,\n        .suites = suites,\n        .groups = Vec::new("
    "),\n        .schemes = Vec::new(),\n        .share_groups = Vec::new(),\n        .shares = Vec::new(),\n"
    "        .tls13 = false,\n        .has_cookie = false,\n    };\n    if (at == n)\n    {\n        return Ok"
    "(ch);\n    }\n    if (at + 2 > n)\n    {\n        return Err(ProtocolError);\n    }\n    usize ext_end = a"
    "t + 2 + widen<usize>(read_be<u16>(m, at));\n    if (ext_end != n)\n    {\n        return Err(ProtocolEr"
    "ror);\n    }\n    at += 2;\n    while (at + 4 <= ext_end)\n    {\n        u16 kind = read_be<u16>(m, at);"
    "\n        usize len = widen<usize>(read_be<u16>(m, at + 2));\n        usize start = at + 4;\n        if"
    " (start + len > ext_end)\n        {\n            return Err(ProtocolError);\n        }\n        if (kind"
    " == 0x002b)\n        {\n            // supported_versions: a 1-byte length and the versions.\n         "
    "   if (len < 1 || widen<usize>(m[start]) + 1 != len)\n            {\n                return Err(Protoc"
    "olError);\n            }\n            Vec<u16> versions = Vec::new();\n            if (!u16_list(m, sta"
    "rt + 1, start + len, &mut versions))\n            {\n                return Err(ProtocolError);\n      "
    "      }\n            foreach (v in &versions)\n            {\n                if (*v == 0x0304)\n       "
    "         {\n                    ch.tls13 = true;\n                }\n            }\n        }\n        el"
    "se if (kind == 0x000a || kind == 0x000d)\n        {\n            if (len < 2 || widen<usize>(read_be<u"
    "16>(m, start)) + 2 != len)\n            {\n                return Err(ProtocolError);\n            }\n  "
    "          Vec<u16> list = Vec::new();\n            if (!u16_list(m, start + 2, start + len, &mut list"
    "))\n            {\n                return Err(ProtocolError);\n            }\n            if (kind == 0x"
    "000a)\n            {\n                overwrite(&mut ch.groups, list);\n            }\n            else\n"
    "            {\n                overwrite(&mut ch.schemes, list);\n            }\n        }\n        else"
    " if (kind == 0x0033)\n        {\n            if (len < 2 || widen<usize>(read_be<u16>(m, start)) + 2 !"
    "= len)\n            {\n                return Err(ProtocolError);\n            }\n            usize p = "
    "start + 2;\n            while (p + 4 <= start + len)\n            {\n                u16 g = read_be<u1"
    "6>(m, p);\n                usize klen = widen<usize>(read_be<u16>(m, p + 2));\n                if (p +"
    " 4 + klen > start + len)\n                {\n                    return Err(ProtocolError);\n          "
    "      }\n                Vec::push(&mut ch.share_groups, g);\n                Vec::push(&mut ch.shares"
    ", Vec::from_slice(&m[p + 4..p + 4 + klen]));\n                p += 4 + klen;\n            }\n          "
    "  if (p != start + len)\n            {\n                return Err(ProtocolError);\n            }\n     "
    "   }\n        else if (kind == 0x002c)\n        {\n            ch.has_cookie = true;\n        }\n        "
    "at = start + len;\n    }\n    if (at != ext_end)\n    {\n        return Err(ProtocolError);\n    }\n    Ok"
    "(ch)\n}fn send_plain_alert(ref<TcpStream, exclusive> tcp, u8 code)\n{\n    array<u8, 7> rec = [21, 0x03"
    ", 0x03, 0, 2, 2, code];\n    _ = TcpStream::write(tcp, &rec[0..$]);\n}fn server_hello_bytes(\n    slice"
    "<u8, shared> random,\n    slice<u8, shared> session,\n    u16 suite,\n    u16 group,\n    slice<u8, shar"
    "ed> share,\n    bool retry,\n) : Vec<u8>\n{\n    Vec<u8> ext = Vec::new();\n    array<u8, 2> v13 = [0x03,"
    " 0x04];\n    push_extension(&mut ext, 0x002b, &v13[0..$]);\n    Vec<u8> ks = Vec::new();\n    Vec::push"
    "_be(&mut ks, group);\n    if (!retry)\n    {\n        Vec::push_be(&mut ks, narrow<u16>(slice_len(share"
    ")));\n        Vec::extend_from(&mut ks, share);\n    }\n    push_extension(&mut ext, 0x0033, &ks[0..$])"
    ";\n    Vec<u8> body = Vec::new();\n    Vec::push_be(&mut body, 0x0303: u16);\n    Vec::extend_from(&mut"
    " body, random);\n    Vec::push(&mut body, narrow<u8>(slice_len(session)));\n    Vec::extend_from(&mut "
    "body, session);\n    Vec::push_be(&mut body, suite);\n    Vec::push(&mut body, 0);\n    Vec::push_be(&m"
    "ut body, narrow<u16>(Vec::len(&ext)));\n    Vec::extend_from(&mut body, &ext[0..$]);\n    Vec<u8> msg "
    "= Vec::new();\n    Vec::push(&mut msg, 2);\n    push_u24(&mut msg, Vec::len(&body));\n    Vec::extend_f"
    "rom(&mut msg, &body[0..$]);\n    msg\n}fn send_handshake(\n    ref<TcpStream, exclusive> tcp,\n    ref<R"
    "ecordKeys, exclusive> keys,\n    ref<Handshake, exclusive> hs,\n    slice<u8, shared> msg,\n) : Result<"
    "void, TlsError>\n{\n    transcript_add(hs, msg);\n    usize at = 0;\n    while (at < slice_len(msg))\n   "
    " {\n        usize take = min(slice_len(msg) - at, 16384);\n        Vec<u8> rec = seal_record(keys, 22,"
    " &msg[at..at + take]);\n        write_all(tcp, &rec[0..$])?;\n        at += take;\n    }\n    Ok(())\n}fn"
    " server_scheme(ref<PrivateKey, shared> key, ref<Vec<u16>, shared> offered) : Option<u16>\n{\n    u16 w"
    "ant = match (key)\n    {\n        RsaPrivate(_)     : 0x0804,\n        EcPrivate(k)      : if (k.curve "
    "== P256) { 0x0403 } else { 0x0503 },\n        Ed25519Private(_) : 0x0807,\n    };\n    foreach (s in of"
    "fered)\n    {\n        if (*s == want)\n        {\n            return Some(want);\n        }\n    }\n    No"
    "ne\n}fn scheme_of(u16 code) : SignatureScheme\n{\n    if (code == 0x0403) { Ecdsa(Sha2_256) }\n    else "
    "if (code == 0x0503) { Ecdsa(Sha2_384) }\n    else if (code == 0x0807) { Ed25519 }\n    else { RsaPss(S"
    "ha2_256) }\n}export fn TlsStream::server(\n    TcpStream tcp,\n    ref<PrivateKey, shared> key,\n    sli"
    "ce<Certificate, shared> chain,\n) : Result<TlsStream, TlsError>\n{\n    if (slice_len(chain) == 0)\n    "
    "{\n        return Err(HandshakeFailed);\n    }\n    Handshake hs = Handshake { .buffer = Vec::new(), .t"
    "256 = Hasher::new(Sha2_256), .t384 = Hasher::new(Sha2_384), .kind = Sha2_256 };\n    Option<RecordKey"
    "s> plain = None;\n    Vec<u8> chm = next_message(&mut hs, &mut tcp, &mut plain)?;\n    ClientHello ch "
    "= client_hello_parse(&chm[0..$])?;\n    if (!ch.tls13)\n    {\n        send_plain_alert(&mut tcp, 70);\n"
    "        return Err(HandshakeFailed);\n    }\n    // The suite: the client's first that this server has"
    ".\n    u16 suite = 0;\n    foreach (s in &ch.suites)\n    {\n        if (suite == 0 && (*s == 0x1303 || "
    "*s == 0x1301 || *s == 0x1302))\n        {\n            suite = *s;\n        }\n    }\n    u16 scheme_code"
    " = match (server_scheme(key, &ch.schemes))\n    {\n        Some(c) : c,\n        None    : 0,\n    };\n  "
    "  if (suite == 0 || scheme_code == 0)\n    {\n        send_plain_alert(&mut tcp, 40);\n        return E"
    "rr(HandshakeFailed);\n    }\n    hs.kind = suite_hash(suite);\n    HashKind kind = hs.kind;\n    // The "
    "group: the client's first key share for a group this server\n    // has; else a HelloRetryRequest for"
    " the first group it supports.\n    u16 group = 0;\n    Vec<u8> client_share = Vec::new();\n    for (usi"
    "ze i = 0; i < Vec::len(&ch.share_groups) && group == 0; i += 1)\n    {\n        u16 g = ch.share_group"
    "s[i];\n        if (g == 0x001d || g == 0x0017 || g == 0x0018)\n        {\n            group = g;\n      "
    "      overwrite(&mut client_share, Vec::clone(&ch.shares[i]));\n        }\n    }\n    Vec<u8> session ="
    " Vec::clone(&ch.session);\n    if (group == 0)\n    {\n        u16 ask = 0;\n        foreach (g in &ch.g"
    "roups)\n        {\n            if (ask == 0 && (*g == 0x001d || *g == 0x0017 || *g == 0x0018))\n       "
    "     {\n                ask = *g;\n            }\n        }\n        if (ask == 0 || ch.has_cookie)\n    "
    "    {\n            send_plain_alert(&mut tcp, 40);\n            return Err(HandshakeFailed);\n        }"
    "\n        // RFC 8446 §4.1.4: the transcript restarts from\n        // message_hash(ClientHello1) ‖"
    " HelloRetryRequest.\n        Vec<u8> ch_hash = hash(kind, &chm[0..$]);\n        array<u8, 4> head = [2"
    "54, 0, 0, narrow<u8>(Vec::len(&ch_hash))];\n        Handshake restarted = Handshake { .buffer = Vec::"
    "new(), .t256 = Hasher::new(Sha2_256), .t384 = Hasher::new(Sha2_384), .kind = kind };\n        transcr"
    "ipt_add(&mut restarted, &head[0..$]);\n        transcript_add(&mut restarted, &ch_hash[0..$]);\n      "
    "  Vec<u8> hrr_random = Result::unwrap_or(\n            from_hex(\"cf21ad74e59a6111be1d8c021e65b891c2a2"
    "11167abb8c5e079e09e2c8a8339c\"),\n            Vec::new(),\n        );\n        Vec<u8> none = Vec::new()"
    ";\n        Vec<u8> hrr = server_hello_bytes(&hrr_random[0..$], &session[0..$], suite, ask, &none[0..$"
    "], true);\n        transcript_add(&mut restarted, &hrr[0..$]);\n        overwrite(&mut hs, restarted);"
    "\n        write_all(&mut tcp, &handshake_record(&hrr[0..$], 0x0303)[0..$])?;\n        Vec<u8> chm2 = n"
    "ext_message(&mut hs, &mut tcp, &mut plain)?;\n        ClientHello ch2 = client_hello_parse(&chm2[0..$"
    "])?;\n        bool suite_ok = false;\n        foreach (s in &ch2.suites)\n        {\n            if (*s "
    "== suite)\n            {\n                suite_ok = true;\n            }\n        }\n        for (usize "
    "i = 0; i < Vec::len(&ch2.share_groups) && group == 0; i += 1)\n        {\n            if (ch2.share_gr"
    "oups[i] == ask)\n            {\n                group = ask;\n                overwrite(&mut client_sha"
    "re, Vec::clone(&ch2.shares[i]));\n            }\n        }\n        if (group == 0 || !suite_ok || !ch2"
    ".tls13 || !same_session(&ch2.session, &session))\n        {\n            send_plain_alert(&mut tcp, 47"
    ");\n            return Err(HandshakeFailed);\n        }\n    }\n    // This server's share and the share"
    "d secret.\n    Vec<u8> public_key = Vec::new();\n    Vec<u8> shared = Vec::new();\n    if (group == 0x0"
    "01d)\n    {\n        array<u8, 32> private_key = x25519_private_key();\n        Vec::extend_from(&mut p"
    "ublic_key, &x25519_public_key(&private_key[0..$])[0..$]);\n        match (x25519(&private_key[0..$], "
    "&client_share[0..$]))\n        {\n            Some(z) : Vec::extend_from(&mut shared, &z[0..$]),\n     "
    "       None    :\n            {\n                send_plain_alert(&mut tcp, 47);\n                retur"
    "n Err(HandshakeFailed);\n            },\n        }\n    }\n    else\n    {\n        EcCurve curve = if (gr"
    "oup == 0x0017) { P256 } else { P384 };\n        Vec<u8> ec_key = ec_private_key(curve);\n        overw"
    "rite(&mut public_key, Option::unwrap(ec_public_key(curve, &ec_key[0..$])));\n        match (ecdh(curv"
    "e, &ec_key[0..$], &client_share[0..$]))\n        {\n            Some(z) : overwrite(&mut shared, z),\n "
    "           None    :\n            {\n                send_plain_alert(&mut tcp, 47);\n                r"
    "eturn Err(HandshakeFailed);\n            },\n        }\n    }\n    array<u8, 32> random = [0; 32];\n    o"
    "s_random_bytes(&mut random[0..$]);\n    Vec<u8> sh = server_hello_bytes(&random[0..$], &session[0..$]"
    ", suite, group, &public_key[0..$], false);\n    transcript_add(&mut hs, &sh[0..$]);\n    write_all(&mu"
    "t tcp, &handshake_record(&sh[0..$], 0x0303)[0..$])?;\n    array<u8, 6> ccs = [20, 0x03, 0x03, 0x00, 0"
    "x01, 0x01];\n    write_all(&mut tcp, &ccs[0..$])?;\n    // The key schedule (RFC 8446 §7.1).\n    Vec<"
    "u8> none = Vec::new();\n    Vec<u8> empty_hash = hash(kind, &none[0..$]);\n    Vec<u8> zeros = Vec::fi"
    "lled(Vec::len(&empty_hash), 0: u8);\n    Vec<u8> early = hkdf_extract_with(kind, &none[0..$], &zeros["
    "0..$]);\n    Vec<u8> derived = derive_secret(kind, &early[0..$], \"derived\", &empty_hash[0..$]);\n    V"
    "ec<u8> handshake_secret = hkdf_extract_with(kind, &derived[0..$], &shared[0..$]);\n    Vec<u8> th = t"
    "ranscript_hash(&hs);\n    Vec<u8> c_hs = derive_secret(kind, &handshake_secret[0..$], \"c hs traffic\","
    " &th[0..$]);\n    Vec<u8> s_hs = derive_secret(kind, &handshake_secret[0..$], \"s hs traffic\", &th[0.."
    "$]);\n    RecordKeys server_hs = keys_from(&s_hs[0..$], suite);\n    // EncryptedExtensions (none), Ce"
    "rtificate, CertificateVerify, Finished.\n    array<u8, 6> ee = [8, 0, 0, 2, 0, 0];\n    send_handshake"
    "(&mut tcp, &mut server_hs, &mut hs, &ee[0..$])?;\n    Vec<u8> list = Vec::new();\n    foreach (c in ch"
    "ain)\n    {\n        push_u24(&mut list, Vec::len(&c.der));\n        Vec::extend_from(&mut list, &c.der"
    "[0..$]);\n        Vec::push_be(&mut list, 0: u16);\n    }\n    Vec<u8> cert = Vec::new();\n    Vec::push"
    "(&mut cert, 11);\n    push_u24(&mut cert, 4 + Vec::len(&list));\n    Vec::push(&mut cert, 0);\n    push"
    "_u24(&mut cert, Vec::len(&list));\n    Vec::extend_from(&mut cert, &list[0..$]);\n    send_handshake(&"
    "mut tcp, &mut server_hs, &mut hs, &cert[0..$])?;\n    Vec<u8> th_cert = transcript_hash(&hs);\n    Vec"
    "<u8> content = Vec::filled(64, 0x20: u8);\n    Vec::extend_from(&mut content, &b\"TLS 1.3, server Cert"
    "ificateVerify\"[0..$]);\n    Vec::push(&mut content, 0);\n    Vec::extend_from(&mut content, &th_cert[0"
    "..$]);\n    SignatureScheme scheme = scheme_of(scheme_code);\n    Vec<u8> signature = match (sign(key,"
    " &scheme, &content[0..$]))\n    {\n        Some(s) : s,\n        None    : return Err(HandshakeFailed),"
    "\n    };\n    Vec<u8> cv = Vec::new();\n    Vec::push(&mut cv, 15);\n    push_u24(&mut cv, 4 + Vec::len("
    "&signature));\n    Vec::push_be(&mut cv, scheme_code);\n    Vec::push_be(&mut cv, narrow<u16>(Vec::len"
    "(&signature)));\n    Vec::extend_from(&mut cv, &signature[0..$]);\n    send_handshake(&mut tcp, &mut s"
    "erver_hs, &mut hs, &cv[0..$])?;\n    Vec<u8> th_cv = transcript_hash(&hs);\n    Vec<u8> fin_data = fin"
    "ished_data(kind, &s_hs[0..$], &th_cv[0..$]);\n    Vec<u8> fin = Vec::new();\n    Vec::push(&mut fin, 2"
    "0);\n    push_u24(&mut fin, Vec::len(&fin_data));\n    Vec::extend_from(&mut fin, &fin_data[0..$]);\n  "
    "  send_handshake(&mut tcp, &mut server_hs, &mut hs, &fin[0..$])?;\n    Vec<u8> th_fin = transcript_ha"
    "sh(&hs);\n    Vec<u8> derived2 = derive_secret(kind, &handshake_secret[0..$], \"derived\", &empty_hash["
    "0..$]);\n    Vec<u8> master = hkdf_extract_with(kind, &derived2[0..$], &zeros[0..$]);\n    Vec<u8> c_a"
    "p = derive_secret(kind, &master[0..$], \"c ap traffic\", &th_fin[0..$]);\n    Vec<u8> s_ap = derive_sec"
    "ret(kind, &master[0..$], \"s ap traffic\", &th_fin[0..$]);\n    // The client's Finished, under its han"
    "dshake keys.\n    Option<RecordKeys> client_hs = Some(keys_from(&c_hs[0..$], suite));\n    Vec<u8> cfi"
    "n = next_message(&mut hs, &mut tcp, &mut client_hs)?;\n    Vec<u8> want = finished_data(kind, &c_hs[0"
    "..$], &th_fin[0..$]);\n    if (Vec::len(&cfin) != 4 + Vec::len(&want) || cfin[0] != 20 || !digest_eq("
    "&cfin[4..$], &want[0..$]))\n    {\n        return Err(HandshakeFailed);\n    }\n    if (Vec::len(&hs.buf"
    "fer) != 0)\n    {\n        return Err(ProtocolError);\n    }\n    Ok(TlsStream {\n        .tcp = tcp,\n   "
    "     .send = keys_from(&s_ap[0..$], suite),\n        .recv = keys_from(&c_ap[0..$], suite),\n        ."
    "pending = Vec::new(),\n        .pending_at = 0,\n        .closed = false,\n        .peer = None,\n    })"
    "\n}fn same_session(ref<Vec<u8>, shared> a, ref<Vec<u8>, shared> b) : bool\n{\n    Vec::len(a) == Vec::l"
    "en(b) && digest_eq(&(*a)[0..$], &(*b)[0..$])\n}export fn HttpError::text(ref<HttpError, shared> e) : "
    "str\n{\n    match (e)\n    {\n        HttpNetFailure(n) : NetError::text(n),\n        HttpTlsFailure(t) :"
    " TlsError::text(t),\n        BadUrl            : \"the URL is malformed\",\n        UnsupportedScheme : "
    "\"the URL's scheme is neither http nor https\",\n        NoRoots           : \"no trusted roots for http"
    "s (TrustStore::system failed)\",\n        BadMessage        : \"the HTTP message is malformed\",\n       "
    " TooLarge          : \"the HTTP message is larger than the limit\",\n        TooManyRedirects  : \"too m"
    "any redirects\",\n        ConnectionClosed  : \"the connection was closed\",\n    }\n}fn default_port(Stri"
    "ngView scheme) : u16\n{\n    if (StringView::eq(scheme, \"https\")) { 443 } else { 80 }\n}export fn Url::"
    "parse(StringView text) : Result<Url, HttpError>\n{\n    usize sep = match (StringView::find(text, \"://"
    "\"))\n    {\n        Some(i) : i,\n        None    : return Err(BadUrl),\n    };\n    String scheme = Stri"
    "ng::to_ascii_lower(&String::from_view(StringView::sub(text, 0, sep)));\n    StringView rest = StringV"
    "iew::sub(text, sep + 3, StringView::len(text));\n    usize n = StringView::len(rest);\n    slice<u8, s"
    "hared> b = StringView::as_bytes(rest);\n    usize auth_end = 0;\n    while (auth_end < n && b[auth_end"
    "] != b'/' && b[auth_end] != b'?' && b[auth_end] != b'#')\n    {\n        auth_end += 1;\n    }\n    Stri"
    "ngView authority = StringView::sub(rest, 0, auth_end);\n    if (auth_end == 0 || Option::is_some(&Str"
    "ingView::find(authority, \"@\")))\n    {\n        return Err(BadUrl);\n    }\n    slice<u8, shared> ab = S"
    "tringView::as_bytes(authority);\n    usize host_end = auth_end;\n    if (ab[0] == b'[')\n    {\n        "
    "host_end = match (StringView::find(authority, \"]\"))\n        {\n            Some(i) : i + 1,\n         "
    "   None    : return Err(BadUrl),\n        };\n    }\n    else\n    {\n        host_end = 0;\n        while"
    " (host_end < auth_end && ab[host_end] != b':')\n        {\n            host_end += 1;\n        }\n    }\n"
    "    String host = String::to_ascii_lower(&String::from_view(StringView::sub(authority, 0, host_end))"
    ");\n    u16 port = default_port(String::as_view(&scheme));\n    if (host_end < auth_end)\n    {\n       "
    " if (ab[host_end] != b':')\n        {\n            return Err(BadUrl);\n        }\n        port = match "
    "(StringView::parse<u16>(StringView::sub(authority, host_end + 1, auth_end)))\n        {\n            O"
    "k(p)  : p,\n            Err(_) : return Err(BadUrl),\n        };\n    }\n    usize path_end = auth_end;\n"
    "    while (path_end < n && b[path_end] != b'?' && b[path_end] != b'#')\n    {\n        path_end += 1;\n"
    "    }\n    String path = if (path_end == auth_end) { String::from_str(\"/\") } else\n    {\n        Strin"
    "g::from_view(StringView::sub(\n            rest,\n            auth_end,\n            path_end,\n        "
    "))\n    };\n    String query = String::new();\n    if (path_end < n && b[path_end] == b'?')\n    {\n     "
    "   usize q_end = path_end + 1;\n        while (q_end < n && b[q_end] != b'#')\n        {\n            q"
    "_end += 1;\n        }\n        String::append(&mut query, StringView::sub(rest, path_end + 1, q_end));"
    "\n    }\n    Ok(Url { .scheme = scheme, .host = host, .port = port, .path = path, .query = query })\n}u"
    "nittest \"Url::parse: defaults and normalisation\"\n{\n    Url u = Result::unwrap(Url::parse(\"HTTPS://Ex"
    "ample.com/a/b?x=1#top\"));\n    assert(u.scheme == \"https\" && u.host == \"example.com\" && u.port == 443"
    ");\n    assert(u.path == \"/a/b\" && u.query == \"x=1\");\n    assert(Url::target(&u) == \"/a/b?x=1\");\n    "
    "Url v = Result::unwrap(Url::parse(\"http://[::1]:8080\"));\n    assert(v.host == \"[::1]\" && v.path == \""
    "/\");\n    assert(Url::text(&v) == \"http://[::1]:8080/\");\n    assert(Result::is_err(&Url::parse(\"http:"
    "//user@example.com/\")));\n}export fn Url::target(ref<Url, shared> u) : String\n{\n    String t = String"
    "::clone(&u.path);\n    if (String::len(&u.query) > 0)\n    {\n        String::append(&mut t, \"?\");\n    "
    "    String::append(&mut t, String::as_view(&u.query));\n    }\n    t\n}fn host_text(ref<Url, shared> u)"
    " : String\n{\n    String h = String::clone(&u.host);\n    if (u.port != default_port(String::as_view(&u"
    ".scheme)))\n    {\n        String::append(&mut h, \":\");\n        String::append(&mut h, u.port);\n    }\n"
    "    h\n}export fn Url::text(ref<Url, shared> u) : String\n{\n    String t = String::clone(&u.scheme);\n "
    "   String::append(&mut t, \"://\");\n    String::append(&mut t, String::as_view(&host_text(u)));\n    St"
    "ring::append(&mut t, String::as_view(&Url::target(u)));\n    t\n}fn is_unreserved(u8 b) : bool\n{\n    a"
    "scii_is_alnum(b) || b == b'-' || b == b'.' || b == b'_' || b == b'~'\n}export fn percent_encode(slice"
    "<u8, shared> bytes) : String\n{\n    String out = String::new();\n    str digits = \"0123456789ABCDEF\";\n"
    "    foreach (c in bytes)\n    {\n        if (is_unreserved(*c))\n        {\n            String::push_asc"
    "ii(&mut out, *c);\n        }\n        else\n        {\n            String::push_ascii(&mut out, b'%');\n "
    "           String::push_ascii(&mut out, str_byte(digits, widen<usize>(*c >> 4)));\n            String"
    "::push_ascii(&mut out, str_byte(digits, widen<usize>(*c & 15)));\n        }\n    }\n    out\n}fn hex_dig"
    "it(u8 c) : Option<u8>\n{\n    if (c >= b'0' && c <= b'9') { Some(c - b'0') }\n    else if (c >= b'a' &&"
    " c <= b'f') { Some(c - b'a' + 10) }\n    else if (c >= b'A' && c <= b'F') { Some(c - b'A' + 10) }\n   "
    " else { None }\n}export fn percent_decode(StringView text) : Option<Vec<u8>>\n{\n    slice<u8, shared> "
    "b = StringView::as_bytes(text);\n    Vec<u8> out = Vec::new();\n    usize i = 0;\n    while (i < slice_"
    "len(b))\n    {\n        if (b[i] == b'%')\n        {\n            if (i + 3 > slice_len(b))\n            "
    "{\n                return None;\n            }\n            u8 hi = hex_digit(b[i + 1])?;\n            u"
    "8 lo = hex_digit(b[i + 2])?;\n            Vec::push(&mut out, hi * 16 + lo);\n            i += 3;\n    "
    "    }\n        else\n        {\n            Vec::push(&mut out, b[i]);\n            i += 1;\n        }\n  "
    "  }\n    Some(out)\n}unittest \"percent_decode: the reverse of percent_encode\"\n{\n    assert(percent_enc"
    "ode(StringView::as_bytes(\"a b/ü\")) == \"a%20b%2F%C3%BC\");\n    Vec<u8> back = Option::unwrap(percent_"
    "decode(\"a%20b%2f\"));\n    assert(Result::unwrap(String::from_utf8(back)) == \"a b/\");\n    assert(Optio"
    "n::is_none(&percent_decode(\"100%\")));\n}export fn Param::new(StringView name, StringView value) : Par"
    "am\n{\n    Param { .name = String::from_view(name), .value = String::from_view(value) }\n}export fn fin"
    "d_param(slice<Param, shared> params, str name) : Option<StringView>\n{\n    for (usize i = 0; i < slic"
    "e_len(params); i += 1)\n    {\n        if (String::eq_str(&params[i].name, name))\n        {\n          "
    "  return Some(String::as_view(&params[i].value));\n        }\n    }\n    None\n}export fn form_decode(St"
    "ringView text) : Vec<Param>\n{\n    Vec<Param> out = Vec::new();\n    foreach (pair in StringView::spli"
    "t(text, \"&\"))\n    {\n        foreach (p in StringView::split(pair, \";\"))\n        {\n            if (St"
    "ringView::len(p) == 0)\n            {\n                continue;\n            }\n            StringView "
    "name = p;\n            StringView value = StringView::of(\"\");\n            if (Some(eq) = StringView::"
    "find(p, \"=\"))\n            {\n                name = StringView::sub(p, 0, eq);\n                value "
    "= StringView::sub(p, eq + 1, StringView::len(p));\n            }\n            Vec::push(&mut out, Para"
    "m { .name = form_part(name), .value = form_part(value) });\n        }\n    }\n    out\n}unittest \"form_d"
    "ecode: pairs, bare names and bad escapes\"\n{\n    Vec<Param> ps = form_decode(\"q=red+fish&flag&&n=%41;"
    "x=%zz\");\n    assert(Vec::len(&ps) == 4);\n    assert(Option::unwrap(find_param(&ps[0..$], \"q\")) == \"r"
    "ed fish\");\n    assert(Option::unwrap(find_param(&ps[0..$], \"flag\")) == \"\");\n    assert(Option::unwra"
    "p(find_param(&ps[0..$], \"n\")) == \"A\");\n    assert(Option::unwrap(find_param(&ps[0..$], \"x\")) == \"%zz"
    "\");\n    assert(Option::is_none(&find_param(&ps[0..$], \"Q\")));\n}fn form_part(StringView v) : String\n{"
    "\n    String plus = StringView::replace(v, \"+\", \" \");\n    match (percent_decode(String::as_view(&plus"
    ")))\n    {\n        Some(b) : match (String::from_utf8(b))\n        {\n            Ok(s)  : s,\n         "
    "   Err(_) : plus,\n        },\n        None : plus,\n    }\n}export fn form_encode(slice<Param, shared> "
    "params) : String\n{\n    String out = String::new();\n    for (usize i = 0; i < slice_len(params); i +="
    " 1)\n    {\n        if (i > 0)\n        {\n            String::push_ascii(&mut out, b'&');\n        }\n   "
    "     String::append(&mut out, String::as_view(&form_encode_part(&params[i].name)));\n        String::"
    "push_ascii(&mut out, b'=');\n        String::append(&mut out, String::as_view(&form_encode_part(&para"
    "ms[i].value)));\n    }\n    out\n}unittest \"form_encode: spaces and reserved bytes\"\n{\n    Vec<Param> ps"
    " = Vec::new();\n    Vec::push(&mut ps, Param::new(\"q\", \"a b&c\"));\n    Vec::push(&mut ps, Param::new(\""
    "lang\", \"en\"));\n    String body = form_encode(&ps[0..$]);\n    assert(body == \"q=a+b%26c&lang=en\");\n  "
    "  Vec<Param> back = form_decode(String::as_view(&body));\n    assert(back[0].value == \"a b&c\");\n}fn f"
    "orm_encode_part(ref<String, shared> s) : String\n{\n    String enc = percent_encode(StringView::as_byt"
    "es(String::as_view(s)));\n    String::replace(&enc, \"%20\", \"+\")\n}export fn Url::query_pairs(ref<Url, "
    "shared> u) : Vec<Param>\n{\n    form_decode(String::as_view(&u.query))\n}export fn Header::new(StringVi"
    "ew name, StringView value) : Header\n{\n    Header { .name = String::from_view(name), .value = String:"
    ":from_view(value) }\n}fn name_eq(StringView a, str b) : bool\n{\n    ascii_ieq_str(a.bytes, b)\n}fn name"
    "s_eq(StringView a, StringView b) : bool\n{\n    ascii_ieq(a.bytes, b.bytes)\n}fn ascii_ieq(slice<u8, sh"
    "ared> a, slice<u8, shared> b) : bool\n{\n    if (slice_len(a) != slice_len(b))\n    {\n        return fa"
    "lse;\n    }\n    for (usize i = 0; i < slice_len(a); i += 1)\n    {\n        if (ascii_to_lower(a[i]) !="
    " ascii_to_lower(b[i]))\n        {\n            return false;\n        }\n    }\n    true\n}fn ascii_ieq_st"
    "r(slice<u8, shared> a, str b) : bool\n{\n    if (slice_len(a) != str_len(b))\n    {\n        return fals"
    "e;\n    }\n    for (usize i = 0; i < slice_len(a); i += 1)\n    {\n        if (ascii_to_lower(a[i]) != a"
    "scii_to_lower(str_byte(b, i)))\n        {\n            return false;\n        }\n    }\n    true\n}fn has_"
    "header(slice<Header, shared> headers, StringView name) : bool\n{\n    for (usize i = 0; i < slice_len("
    "headers); i += 1)\n    {\n        if (names_eq(String::as_view(&headers[i].name), name))\n        {\n   "
    "         return true;\n        }\n    }\n    false\n}export fn find_header(slice<Header, shared> headers"
    ", str name) : Option<StringView>\n{\n    for (usize i = 0; i < slice_len(headers); i += 1)\n    {\n     "
    "   if (name_eq(String::as_view(&headers[i].name), name))\n        {\n            return Some(String::a"
    "s_view(&headers[i].value));\n        }\n    }\n    None\n}export fn Request::new(StringView method, Stri"
    "ngView url) : Request\n{\n    Request { .method = String::from_view(method), .url = String::from_view("
    "url), .headers = Vec::new(), .body = Vec::new() }\n}export fn Request::header(ref<Request, shared> r,"
    " str name) : Option<StringView>\n{\n    find_header(&r.headers[0..$], name)\n}unittest \"Request::header"
    ": names ignore case\"\n{\n    Request r = Request::new(\"POST\", \"https://example.com/upload\");\n    Vec::"
    "push(&mut r.headers, Header::new(\"Content-Type\", \"text/plain\"));\n    assert(Option::unwrap(Request::"
    "header(&r, \"content-type\")) == \"text/plain\");\n    assert(Option::is_none(&Request::header(&r, \"accep"
    "t\")));\n}export fn Response::header(ref<Response, shared> r, str name) : Option<StringView>\n{\n    fin"
    "d_header(&r.headers[0..$], name)\n}export fn Response::text(ref<Response, shared> r) : Result<String,"
    " Utf8Error>\n{\n    String::from_utf8(Vec::clone(&r.body))\n}export fn reason_phrase(u16 status) : str\n"
    "{\n    match (status)\n    {\n        100 : \"Continue\",\n        101 : \"Switching Protocols\",\n        20"
    "0 : \"OK\",\n        201 : \"Created\",\n        202 : \"Accepted\",\n        204 : \"No Content\",\n        206"
    " : \"Partial Content\",\n        301 : \"Moved Permanently\",\n        302 : \"Found\",\n        303 : \"See O"
    "ther\",\n        304 : \"Not Modified\",\n        307 : \"Temporary Redirect\",\n        308 : \"Permanent Re"
    "direct\",\n        400 : \"Bad Request\",\n        401 : \"Unauthorized\",\n        403 : \"Forbidden\",\n     "
    "   404 : \"Not Found\",\n        405 : \"Method Not Allowed\",\n        408 : \"Request Timeout\",\n        4"
    "09 : \"Conflict\",\n        411 : \"Length Required\",\n        413 : \"Content Too Large\",\n        415 : \""
    "Unsupported Media Type\",\n        429 : \"Too Many Requests\",\n        500 : \"Internal Server Error\",\n "
    "       501 : \"Not Implemented\",\n        502 : \"Bad Gateway\",\n        503 : \"Service Unavailable\",\n  "
    "      504 : \"Gateway Timeout\",\n        _   : \"\",\n    }\n}unittest \"reason_phrase: unlisted codes\"\n{\n "
    "   assert(reason_phrase(404) == \"Not Found\");\n    assert(reason_phrase(299) == \"\");\n}fn conn_read(re"
    "f<Conn, exclusive> c, ref<Vec<u8>, exclusive> buf, usize max) : Result<usize, HttpError>\n{\n    match"
    " (c)\n    {\n        Plain(s) : match (TcpStream::read(s, buf, max))\n        {\n            Ok(n)  : Ok"
    "(n),\n            Err(e) : Err(HttpNetFailure(e)),\n        },\n        Secure(s) : match (TlsStream::r"
    "ead(s, buf, max))\n        {\n            Ok(n)  : Ok(n),\n            Err(e) : Err(HttpTlsFailure(e)),"
    "\n        },\n    }\n}fn conn_write(ref<Conn, exclusive> c, slice<u8, shared> data) : Result<void, Http"
    "Error>\n{\n    match (c)\n    {\n        Plain(s) : match (TcpStream::write(s, data))\n        {\n        "
    "    Ok(_)  : Ok(()),\n            Err(e) : Err(HttpNetFailure(e)),\n        },\n        Secure(s) : mat"
    "ch (TlsStream::write(s, data))\n        {\n            Ok(_)  : Ok(()),\n            Err(e) : Err(HttpT"
    "lsFailure(e)),\n        },\n    }\n}fn conn_close(ref<Conn, exclusive> c)\n{\n    match (c)\n    {\n       "
    " Plain(s)  : { _ = TcpStream::shutdown_write(s); },\n        Secure(s) : { _ = TlsStream::close(s); }"
    ",\n    }\n}fn fill_buffer(ref<Reader, exclusive> r) : Result<bool, HttpError>\n{\n    if (r.at > 0 && r."
    "at == Vec::len(&r.buf))\n    {\n        Vec::clear(&mut r.buf);\n        r.at = 0;\n    }\n    usize n = "
    "conn_read(&mut r.conn, &mut r.buf, 16384)?;\n    Ok(n > 0)\n}fn available(ref<Reader, shared> r) : usi"
    "ze\n{\n    Vec::len(&r.buf) - r.at\n}fn http_newline_from(slice<u8, shared> b, usize at) : usize\n{\n    "
    "usize i = at;\n    while (i < slice_len(b) && b[i] != b'\\n')\n    {\n        i += 1;\n    }\n    i\n}fn ht"
    "tp_line(ref<Reader, exclusive> r, usize limit) : Result<Option<String>, HttpError>\n{\n    usize scann"
    "ed = 0;\n    while (true)\n    {\n        usize i = http_newline_from(&r.buf[0..$], r.at + scanned);\n  "
    "      if (i < Vec::len(&r.buf))\n        {\n            usize end = if (i > r.at && r.buf[i - 1] == b'"
    "\\r') { i - 1 } else { i };\n            Vec<u8> bytes = Vec::from_slice(&r.buf[r.at..end]);\n         "
    "   r.at = i + 1;\n            return match (String::from_utf8(bytes))\n            {\n                O"
    "k(s)  : Ok(Some(s)),\n                Err(_) : Err(BadMessage),\n            };\n        }\n        scan"
    "ned = Vec::len(&r.buf) - r.at;\n        if (scanned > limit)\n        {\n            return Err(TooLarg"
    "e);\n        }\n        if (!fill_buffer(r)?)\n        {\n            return if (scanned == 0) { Ok(None"
    ") } else { Err(BadMessage) };\n        }\n    }\n}fn read_n(ref<Reader, exclusive> r, ref<Vec<u8>, excl"
    "usive> out, usize n) : Result<void, HttpError>\n{\n    usize need = n;\n    while (need > 0)\n    {\n    "
    "    if (available(r) == 0)\n        {\n            if (!fill_buffer(r)?)\n            {\n               "
    " return Err(ConnectionClosed);\n            }\n        }\n        usize take = min(need, available(r));"
    "\n        Vec::extend_from(out, &r.buf[r.at..r.at + take]);\n        r.at += take;\n        need -= tak"
    "e;\n    }\n    Ok(())\n}fn read_to_end(ref<Reader, exclusive> r, ref<Vec<u8>, exclusive> out, usize max"
    ") : Result<void, HttpError>\n{\n    while (true)\n    {\n        usize have = available(r);\n        if ("
    "have > 0)\n        {\n            if (Vec::len(out) + have > max)\n            {\n                return"
    " Err(TooLarge);\n            }\n            Vec::extend_from(out, &r.buf[r.at..$]);\n            r.at ="
    " Vec::len(&r.buf);\n        }\n        if (!fill_buffer(r)?)\n        {\n            return Ok(());\n    "
    "    }\n    }\n}fn read_headers(ref<Reader, exclusive> r, usize used) : Result<Vec<Header>, HttpError>\n"
    "{\n    Vec<Header> headers = Vec::new();\n    usize total = used;\n    while (true)\n    {\n        Strin"
    "g line = match (http_line(r, MAX_HEAD)?)\n        {\n            Some(l) : l,\n            None    : re"
    "turn Err(BadMessage),\n        };\n        total += String::len(&line) + 2;\n        if (total > MAX_HE"
    "AD)\n        {\n            return Err(TooLarge);\n        }\n        if (String::len(&line) == 0)\n     "
    "   {\n            return Ok(headers);\n        }\n        StringView v = String::as_view(&line);\n      "
    "  usize colon = match (StringView::find(v, \":\"))\n        {\n            Some(i) : i,\n            None"
    "    : return Err(BadMessage),\n        };\n        StringView name = StringView::sub(v, 0, colon);\n   "
    "     if (colon == 0 || StringView::len(StringView::trim(name)) != colon)\n        {\n            retur"
    "n Err(BadMessage);\n        }\n        Vec::push(\n            &mut headers,\n            Header { .name"
    " = String::from_view(name), .value = String::from_view(StringView::trim(StringView::sub(\n           "
    "     v,\n                colon + 1,\n                StringView::len(v),\n            ))) },\n        );"
    "\n    }\n}fn body_length(slice<Header, shared> headers, bool response) : Result<BodyLength, HttpError>"
    "\n{\n    Option<StringView> te = find_header(headers, \"transfer-encoding\");\n    Option<StringView> cl "
    "= find_header(headers, \"content-length\");\n    if (Some(t) = te)\n    {\n        if (Option::is_some(&c"
    "l) || !name_eq(StringView::trim(t), \"chunked\"))\n        {\n            return Err(BadMessage);\n      "
    "  }\n        return Ok(Chunked);\n    }\n    if (Some(c) = cl)\n    {\n        return match (StringView::"
    "parse<usize>(StringView::trim(c)))\n        {\n            Ok(n)  : Ok(Length(n)),\n            Err(_) "
    ": Err(BadMessage),\n        };\n    }\n    Ok(if (response) { UntilClose } else { NoBody })\n}fn read_bo"
    "dy(ref<Reader, exclusive> r, BodyLength how, usize max) : Result<Vec<u8>, HttpError>\n{\n    Vec<u8> b"
    "ody = Vec::new();\n    match (how)\n    {\n        NoBody     : {},\n        Length(n)  :\n        {\n    "
    "        if (n > max)\n            {\n                return Err(TooLarge);\n            }\n            r"
    "ead_n(r, &mut body, n)?;\n        },\n        UntilClose : read_to_end(r, &mut body, max)?,\n        Ch"
    "unked    :\n        {\n            while (true)\n            {\n                String line = match (htt"
    "p_line(r, MAX_HEAD)?)\n                {\n                    Some(l) : l,\n                    None   "
    " : return Err(ConnectionClosed),\n                };\n                StringView size_text = String::a"
    "s_view(&line);\n                if (Some(semi) = StringView::find(size_text, \";\"))\n                {\n"
    "                    size_text = StringView::sub(size_text, 0, semi);\n                }\n             "
    "   usize size = 0;\n                slice<u8, shared> sb = StringView::as_bytes(StringView::trim(size"
    "_text));\n                if (slice_len(sb) == 0 || slice_len(sb) > 8)\n                {\n            "
    "        return Err(BadMessage);\n                }\n                foreach (c in sb)\n                "
    "{\n                    size = size * 16 + widen<usize>(Option::ok_or(hex_digit(*c), BadMessage)?);\n  "
    "              }\n                if (size == 0)\n                {\n                    break;\n        "
    "        }\n                if (Vec::len(&body) + size > max)\n                {\n                    re"
    "turn Err(TooLarge);\n                }\n                read_n(r, &mut body, size)?;\n                m"
    "atch (http_line(r, 2)?)\n                {\n                    Some(end) : if (String::len(&end) != 0"
    ") { return Err(BadMessage); },\n                    None      : return Err(ConnectionClosed),\n       "
    "         }\n            }\n            // Trailers, up to the empty line.\n            while (true)\n   "
    "         {\n                match (http_line(r, MAX_HEAD)?)\n                {\n                    Som"
    "e(t) : if (String::len(&t) == 0) { break; },\n                    None    : return Err(ConnectionClos"
    "ed),\n                }\n            }\n        },\n    }\n    Ok(body)\n}export fn HttpClient::new() : Ht"
    "tpClient\n{\n    Vec<Header> headers = Vec::new();\n    Vec::push(&mut headers, Header::new(\"User-Agent"
    "\", \"CobaltC-std-http/1\"));\n    Vec::push(&mut headers, Header::new(\"Accept-Encoding\", \"gzip, deflate"
    "\"));\n    HttpClient { .roots = None, .timeout_ms = 30000, .max_redirects = 10, .max_body = 16777216,"
    " .headers = headers, .keep_alive = false, .idle = None }\n}unittest \"HttpClient::new: the defaults\"\n{"
    "\n    HttpClient c = HttpClient::new();\n    assert(c.timeout_ms == 30000 && c.max_redirects == 10 && "
    "!c.keep_alive);\n    assert(Option::is_none(&c.roots));\n    assert(Option::is_some(&find_header(&c.he"
    "aders[0..$], \"user-agent\")));\n    c.max_body = 1_048_576;\n}fn method_has_body(StringView m) : bool\n{"
    "\n    StringView::eq(m, \"POST\") || StringView::eq(m, \"PUT\") || StringView::eq(m, \"PATCH\")\n}fn open_co"
    "nnection(ref<HttpClient, exclusive> c, ref<Url, shared> u) : Result<Conn, HttpError>\n{\n    bool secu"
    "re = StringView::eq(String::as_view(&u.scheme), \"https\");\n    if (!secure && !StringView::eq(String:"
    ":as_view(&u.scheme), \"http\"))\n    {\n        return Err(UnsupportedScheme);\n    }\n    if (secure && O"
    "ption::is_none(&c.roots))\n    {\n        match (TrustStore::system())\n        {\n            Ok(t)  : "
    "overwrite(&mut c.roots, Some(t)),\n            Err(_) : return Err(NoRoots),\n        }\n    }\n    // A"
    " bracketed IPv6 host loses its brackets for resolution.\n    String host = String::clone(&u.host);\n  "
    "  if (String::starts_with(&host, \"[\") && String::ends_with(&host, \"]\"))\n    {\n        overwrite(&mut"
    " host, String::from_view(StringView::sub(String::as_view(&u.host), 1, String::len(&u.host) - 1)));\n "
    "   }\n    Vec<SocketAddr> addrs = match (IpAddr::parse(String::as_view(&host)))\n    {\n        Ok(ip) "
    ":\n        {\n            Vec<SocketAddr> one = Vec::new();\n            Vec::push(&mut one, SocketAddr"
    "::new(ip, u.port));\n            one\n        },\n        Err(_) : match (resolve(String::as_view(&host"
    "), u.port))\n        {\n            Ok(a)  : a,\n            Err(e) : return Err(HttpNetFailure(e)),\n  "
    "      },\n    };\n    if (Vec::len(&addrs) == 0)\n    {\n        return Err(HttpNetFailure(UnknownHost))"
    ";\n    }\n    NetError last = Failed;\n    for (usize i = 0; i < Vec::len(&addrs); i += 1)\n    {\n      "
    "  TcpStream tcp = match (TcpStream::connect_timeout(addrs[i], c.timeout_ms))\n        {\n            O"
    "k(t)  : t,\n            Err(e) :\n            {\n                last = e;\n                continue;\n  "
    "          },\n        };\n        TcpStream::set_read_timeout_ms(&mut tcp, c.timeout_ms);\n        TcpS"
    "tream::set_write_timeout_ms(&mut tcp, c.timeout_ms);\n        TcpStream::set_nodelay(&mut tcp, true);"
    "\n        if (!secure)\n        {\n            return Ok(Plain(tcp));\n        }\n        ref<TrustStore,"
    " shared> roots = match (&c.roots)\n        {\n            Some(r) : r,\n            None    : return Er"
    "r(NoRoots),\n        };\n        return match (TlsStream::client(tcp, String::as_view(&host), roots))\n"
    "        {\n            Ok(s)  : Ok(Secure(s)),\n            Err(e) : Err(HttpTlsFailure(e)),\n        }"
    ";\n    }\n    Err(HttpNetFailure(last))\n}fn is_credential(StringView name) : bool\n{\n    name_eq(name, "
    "\"authorization\") || name_eq(name, \"proxy-authorization\") || name_eq(name, \"cookie\")\n}fn request_byte"
    "s(\n    ref<HttpClient, shared> c,\n    ref<Request, shared> req,\n    ref<Url, shared> u,\n    StringVi"
    "ew method,\n    slice<u8, shared> body,\n    bool with_content,\n    bool credentials,\n) : Vec<u8>\n{\n  "
    "  String head = String::from_view(method);\n    String::append(&mut head, \" \");\n    String::append(&m"
    "ut head, String::as_view(&Url::target(u)));\n    String::append(&mut head, \" HTTP/1.1\\r\\nHost: \");\n  "
    "  String::append(&mut head, String::as_view(&host_text(u)));\n    String::append(&mut head, \"\\r\\n\");\n"
    "    foreach (h in &c.headers)\n    {\n        StringView name = String::as_view(&h.name);\n        bool"
    " kept = credentials || !is_credential(name);\n        if (kept && !has_header(&req.headers[0..$], nam"
    "e))\n        {\n            String::append(&mut head, String::as_view(&h.name));\n            String::a"
    "ppend(&mut head, \": \");\n            String::append(&mut head, String::as_view(&h.value));\n          "
    "  String::append(&mut head, \"\\r\\n\");\n        }\n    }\n    foreach (h in &req.headers)\n    {\n        i"
    "f (name_eq(\n            String::as_view(&h.name),\n            \"host\",\n        ) || name_eq(String::a"
    "s_view(&h.name), \"content-length\") || name_eq(String::as_view(&h.name), \"connection\"))\n        {\n   "
    "         continue;\n        }\n        // After a redirect to another origin, no credentials go there."
    "\n        if (!credentials && is_credential(String::as_view(&h.name)))\n        {\n            continue"
    ";\n        }\n        // After a redirect that dropped the body, its Content-Type goes too.\n        if"
    " (!with_content && name_eq(String::as_view(&h.name), \"content-type\"))\n        {\n            continue"
    ";\n        }\n        String::append(&mut head, String::as_view(&h.name));\n        String::append(&mut"
    " head, \": \");\n        String::append(&mut head, String::as_view(&h.value));\n        String::append(&"
    "mut head, \"\\r\\n\");\n    }\n    if (slice_len(body) > 0 || method_has_body(method))\n    {\n        Strin"
    "g::append(&mut head, \"Content-Length: \");\n        String::append(&mut head, slice_len(body));\n      "
    "  String::append(&mut head, \"\\r\\n\");\n    }\n    if (!c.keep_alive)\n    {\n        String::append(&mut "
    "head, \"Connection: close\\r\\n\");\n    }\n    String::append(&mut head, \"\\r\\n\");\n    Vec<u8> out = Strin"
    "g::into_bytes(head);\n    Vec::extend_from(&mut out, body);\n    out\n}fn not_content_encoding(ref<Head"
    "er, shared> h) : bool\n{\n    !name_eq(String::as_view(&h.name), \"content-encoding\") && !name_eq(Strin"
    "g::as_view(&h.name), \"content-length\")\n}fn parse_status_line(StringView line) : Result<StatusLine, H"
    "ttpError>\n{\n    if (!StringView::starts_with(line, \"HTTP/1.\") || StringView::len(line) < 12)\n    {\n "
    "       return Err(BadMessage);\n    }\n    // The version, the space, the three digits and the space a"
    "re ASCII\n    // (RFC 9112 §4): a byte of 128 or more among them is a malformed line,\n    // not a p"
    "lace to cut a character in two (found by the hostile-input\n    // round, D-0211).\n    for (usize i ="
    " 0; i < 13 && i < StringView::len(line); i += 1)\n    {\n        if (line.bytes[i] >= 128)\n        {\n "
    "           return Err(BadMessage);\n        }\n    }\n    u16 status = match (StringView::parse<u16>(St"
    "ringView::sub(line, 9, 12)))\n    {\n        Ok(v)  : v,\n        Err(_) : return Err(BadMessage),\n    "
    "};\n    if (status < 100 || status > 599)\n    {\n        return Err(BadMessage);\n    }\n    String reas"
    "on = if (StringView::len(line) > 13)\n    {\n        String::from_view(StringView::sub(\n            li"
    "ne,\n            13,\n            StringView::len(line),\n        ))\n    }\n    else { String::new() };\n"
    "    Ok(StatusLine { .status = status, .reason = reason })\n}fn origin_of(ref<Url, shared> u) : String"
    "\n{\n    String o = String::clone(&u.scheme);\n    String::append(&mut o, \"://\");\n    String::append(&m"
    "ut o, String::as_view(&host_text(u)));\n    o\n}fn idempotent(StringView method) : bool\n{\n    method ="
    "= \"GET\" || method == \"HEAD\" || method == \"PUT\" || method == \"DELETE\" || method == \"OPTIONS\" || metho"
    "d == \"TRACE\"\n}fn exchange(\n    ref<HttpClient, exclusive> c,\n    ref<Request, shared> req,\n    ref<U"
    "rl, shared> u,\n    StringView method,\n    slice<u8, shared> body,\n    bool with_content,\n    bool cr"
    "edentials,\n) : Result<Response, HttpError>\n{\n    String want = origin_of(u);\n    if (Some(ic) = repl"
    "ace(&mut c.idle, None))\n    {\n        IdleConn { origin, r } = ic;\n        if (origin == want)\n     "
    "   {\n            if (Some(resp) = exchange_on(c, r, true, req, u, method, body, with_content, creden"
    "tials)?)\n            {\n                return Ok(resp);\n            }\n            // Closed with not"
    "hing answered: the server may still have\n            // acted on the request, so only an idempotent "
    "one is sent\n            // again (RFC 9110 §9.2.2) -- a POST twice could do twice what\n            "
    "// it asks.\n            if (!idempotent(method))\n            {\n                return Err(Connection"
    "Closed);\n            }\n        }\n        else\n        {\n            conn_close(&mut r.conn);\n       "
    " }\n    }\n    Reader fresh = Reader { .conn = open_connection(c, u)?, .buf = Vec::new(), .at = 0 };\n "
    "   match (exchange_on(c, fresh, false, req, u, method, body, with_content, credentials)?)\n    {\n    "
    "    Some(resp) : Ok(resp),\n        None       : Err(ConnectionClosed),\n    }\n}fn exchange_on(\n    re"
    "f<HttpClient, exclusive> c,\n    Reader r,\n    bool reused,\n    ref<Request, shared> req,\n    ref<Url"
    ", shared> u,\n    StringView method,\n    slice<u8, shared> body,\n    bool with_content,\n    bool cred"
    "entials,\n) : Result<Option<Response>, HttpError>\n{\n    match (conn_write(&mut r.conn, &request_bytes"
    "(c, req, u, method, body, with_content, credentials)[0..$]))\n    {\n        Ok(_)  : {},\n        Err("
    "e) :\n        {\n            if (reused)\n            {\n                return Ok(None);\n            }\n"
    "            return Err(e);\n        },\n    }\n    bool first = true;\n    // Interim 1xx responses (a 1"
    "00 Continue) are read past.\n    while (true)\n    {\n        String line = match (http_line(&mut r, MA"
    "X_HEAD))\n        {\n            Ok(Some(l)) : l,\n            Ok(None)    :\n            {\n            "
    "    if (reused && first)\n                {\n                    return Ok(None);\n                }\n  "
    "              return Err(ConnectionClosed);\n            },\n            Err(e)      :\n            {\n "
    "               if (reused && first && Vec::len(&r.buf) == 0)\n                {\n                    r"
    "eturn Ok(None);\n                }\n                return Err(e);\n            },\n        };\n        f"
    "irst = false;\n        bool http11 = StringView::starts_with(String::as_view(&line), \"HTTP/1.1\");\n   "
    "     StatusLine { status, reason } = parse_status_line(String::as_view(&line))?;\n        Vec<Header>"
    " headers = read_headers(&mut r, String::len(&line) + 2)?;\n        if (status >= 100 && status < 200)"
    "\n        {\n            continue;\n        }\n        bool no_body = StringView::eq(method, \"HEAD\") || "
    "status == 204 || status == 304;\n        BodyLength how = if (no_body) { NoBody } else { body_length("
    "&headers[0..$], true)? };\n        bool until_close = match (how)\n        {\n            UntilClose : "
    "true,\n            _          : false,\n        };\n        Vec<u8> data = read_body(&mut r, how, c.max"
    "_body)?;\n        // Kept when asked for, allowed (HTTP/1.1, no `Connection: close`),\n        // the "
    "body's end known without the connection's, and nothing more\n        // read than the response.\n     "
    "   bool keep = c.keep_alive && http11 && !until_close && r.at == Vec::len(&r.buf);\n        if (Some("
    "v) = find_header(&headers[0..$], \"connection\"))\n        {\n            if (name_eq(StringView::trim(v"
    "), \"close\"))\n            {\n                keep = false;\n            }\n        }\n        if (keep)\n "
    "       {\n            c.idle = Some(IdleConn { .origin = String::clone(&origin_of(u)), .r = r });\n   "
    "     }\n        else\n        {\n            conn_close(&mut r.conn);\n        }\n        // D-0183: a bo"
    "dy sent compressed (`Content-Encoding: gzip` or\n        // `deflate`, which the client offers) arriv"
    "es decoded, within\n        // `max_body`, and the header is dropped so the response reads as\n       "
    " // a plain one.\n        bool strip = false;\n        if (!no_body)\n        {\n            if (Some(en"
    "c) = find_header(&headers[0..$], \"content-encoding\"))\n            {\n                StringView e = S"
    "tringView::trim(enc);\n                Option<Result<Vec<u8>, CompressError>> decoded = if (name_eq(e"
    ", \"gzip\") || name_eq(e, \"x-gzip\"))\n                {\n                    Some(gunzip(&data[0..$], c."
    "max_body))\n                }\n                else if (name_eq(e, \"deflate\"))\n                {\n     "
    "               Some(match (zlib_inflate(&data[0..$], c.max_body))\n                    {\n            "
    "            Ok(v)  : Ok(v),\n                        Err(_) : inflate(&data[0..$], c.max_body),\n     "
    "               })\n                }\n                else { None };\n                if (Some(d) = dec"
    "oded)\n                {\n                    overwrite(&mut data, match (d)\n                    {\n   "
    "                     Ok(v)         : v,\n                        Err(Oversize) : return Err(TooLarge)"
    ",\n                        Err(_)        : return Err(BadMessage),\n                    });\n          "
    "          strip = true;\n                }\n            }\n        }\n        if (strip)\n        {\n     "
    "       Vec::retain(&mut headers, not_content_encoding);\n        }\n        return Ok(Some(Response { "
    ".status = status, .reason = reason, .headers = headers, .body = data }));\n    }\n}fn redirect_target("
    "ref<Url, shared> base, StringView location) : Result<Url, HttpError>\n{\n    if (Option::is_some(&Stri"
    "ngView::find(location, \"://\")))\n    {\n        return Url::parse(location);\n    }\n    String text = S"
    "tring::clone(&base.scheme);\n    String::append(&mut text, \"://\");\n    String::append(&mut text, Stri"
    "ng::as_view(&host_text(base)));\n    if (StringView::starts_with(location, \"/\"))\n    {\n        String"
    "::append(&mut text, location);\n    }\n    else\n    {\n        StringView path = String::as_view(&base."
    "path);\n        usize dir = 0;\n        slice<u8, shared> pb = StringView::as_bytes(path);\n        for"
    " (usize i = 0; i < slice_len(pb); i += 1)\n        {\n            if (pb[i] == b'/')\n            {\n   "
    "             dir = i + 1;\n            }\n        }\n        String::append(&mut text, StringView::sub("
    "path, 0, dir));\n        String::append(&mut text, location);\n    }\n    Url::parse(String::as_view(&t"
    "ext))\n}export fn HttpClient::send(ref<HttpClient, exclusive> c, ref<Request, shared> req) : Result<R"
    "esponse, HttpError>\n{\n    Url u = Url::parse(String::as_view(&req.url))?;\n    String method = String"
    "::clone(&req.method);\n    Vec<u8> body = Vec::clone(&req.body);\n    usize hops = 0;\n    bool with_co"
    "ntent = true;\n    String first_origin = origin_of(&u);\n    bool credentials = true;\n    while (true)"
    "\n    {\n        Response resp = exchange(c, req, &u, String::as_view(&method), &body[0..$], with_cont"
    "ent, credentials)?;\n        bool redirect = resp.status == 301 || resp.status == 302 || resp.status "
    "== 303 || resp.status == 307 || resp.status == 308;\n        if (!redirect)\n        {\n            ret"
    "urn Ok(resp);\n        }\n        StringView location = match (Response::header(&resp, \"location\"))\n  "
    "      {\n            Some(l) : l,\n            None    : return Ok(resp),\n        };\n        if (hops "
    "== c.max_redirects)\n        {\n            return Err(TooManyRedirects);\n        }\n        hops += 1;"
    "\n        Url next = redirect_target(&u, location)?;\n        overwrite(&mut u, next);\n        // Once"
    " a redirect leaves the first origin, credentials stay behind,\n        // even if a later one comes b"
    "ack.\n        if (origin_of(&u) != first_origin)\n        {\n            credentials = false;\n        }"
    "\n        if (resp.status != 307 && resp.status != 308 && !StringView::eq(String::as_view(&method), \""
    "HEAD\"))\n        {\n            overwrite(&mut method, String::from_str(\"GET\"));\n            Vec::clea"
    "r(&mut body);\n            with_content = false;\n        }\n    }\n}export fn http_get(StringView url) "
    ": Result<Response, HttpError>\n{\n    HttpClient c = HttpClient::new();\n    Request req = Request::new"
    "(\"GET\", url);\n    HttpClient::send(&mut c, &req)\n}export fn http_post(StringView url, StringView con"
    "tent_type, slice<u8, shared> body) : Result<Response, HttpError>\n{\n    HttpClient c = HttpClient::ne"
    "w();\n    Request req = Request::new(\"POST\", url);\n    Vec::push(&mut req.headers, Header::new(\"Conte"
    "nt-Type\", content_type));\n    Vec::extend_from(&mut req.body, body);\n    HttpClient::send(&mut c, &r"
    "eq)\n}export fn HttpServer::bind(SocketAddr a) : Result<HttpServer, NetError>\n{\n    TcpListener l = T"
    "cpListener::bind(a)?;\n    Ok(HttpServer { .listener = l, .max_body = 16777216, .timeout_ms = 30000, "
    ".key = None, .chain = Vec::new() })\n}export fn HttpServer::bind_tls(SocketAddr a, PrivateKey key, Ve"
    "c<Certificate> chain) : Result<HttpServer, NetError>\n{\n    TcpListener l = TcpListener::bind(a)?;\n  "
    "  Ok(HttpServer { .listener = l, .max_body = 16777216, .timeout_ms = 30000, .key = Some(key), .chain"
    " = chain })\n}export fn HttpServer::local_addr(ref<HttpServer, shared> s) : SocketAddr\n{\n    TcpListe"
    "ner::local_addr(&s.listener)\n}export fn HttpServer::accept(ref<HttpServer, exclusive> s) : Result<Ht"
    "tpConnection, HttpError>\n{\n    TcpStream tcp = match (TcpListener::accept(&mut s.listener))\n    {\n  "
    "      Ok(t)  : t,\n        Err(e) : return Err(HttpNetFailure(e)),\n    };\n    TcpStream::set_read_tim"
    "eout_ms(&mut tcp, s.timeout_ms);\n    TcpStream::set_write_timeout_ms(&mut tcp, s.timeout_ms);\n    Tc"
    "pStream::set_nodelay(&mut tcp, true);\n    Conn conn = match (&s.key)\n    {\n        Some(k) : match ("
    "TlsStream::server(tcp, k, &s.chain[0..$]))\n        {\n            Ok(t)  : Secure(t),\n            Err"
    "(e) : return Err(HttpTlsFailure(e)),\n        },\n        None : Plain(tcp),\n    };\n    Ok(HttpConnect"
    "ion { .reader = Reader { .conn = conn, .buf = Vec::new(), .at = 0 }, .max_body = s.max_body, .keep_a"
    "live = true, .head_request = false, .closed = false })\n}export fn HttpConnection::peer_addr(ref<Http"
    "Connection, shared> c) : SocketAddr\n{\n    match (&c.reader.conn)\n    {\n        Plain(s)  : TcpStream"
    "::peer_addr(s),\n        Secure(s) : TlsStream::peer_addr(s),\n    }\n}export fn HttpConnection::reques"
    "t(ref<HttpConnection, exclusive> c) : Result<Option<Request>, HttpError>\n{\n    if (c.closed || !c.ke"
    "ep_alive)\n    {\n        return Ok(None);\n    }\n    // After an Err the connection closes ([Http-Requ"
    "est]): a request line\n    // over the limit, or not UTF-8, included.\n    String line = match (http_l"
    "ine(&mut c.reader, MAX_HEAD))\n    {\n        Ok(Some(l)) : l,\n        Ok(None)    : return Ok(None),\n"
    "        Err(e)      :\n        {\n            c.keep_alive = false;\n            return Err(e);\n       "
    " },\n    };\n    // A request line: METHOD SP target SP HTTP/1.x.\n    Vec<StringView> parts = StringVi"
    "ew::split(String::as_view(&line), \" \");\n    if (Vec::len(&parts) != 3 || StringView::len(parts[0]) ="
    "= 0 || StringView::len(parts[1]) == 0)\n    {\n        c.keep_alive = false;\n        return Err(BadMes"
    "sage);\n    }\n    bool v11 = StringView::eq(parts[2], \"HTTP/1.1\");\n    if (!v11 && !StringView::eq(pa"
    "rts[2], \"HTTP/1.0\"))\n    {\n        c.keep_alive = false;\n        return Err(BadMessage);\n    }\n    V"
    "ec<Header> headers = match (read_headers(&mut c.reader, String::len(&line) + 2))\n    {\n        Ok(h)"
    "  : h,\n        Err(e) :\n        {\n            c.keep_alive = false;\n            return Err(e);\n     "
    "   },\n    };\n    if (v11 && Option::is_none(&find_header(&headers[0..$], \"host\")))\n    {\n        c.k"
    "eep_alive = false;\n        return Err(BadMessage);\n    }\n    // Keep-alive: HTTP/1.1 unless `Connect"
    "ion: close`, HTTP/1.0 only with\n    // `Connection: keep-alive`.\n    c.keep_alive = match (find_head"
    "er(&headers[0..$], \"connection\"))\n    {\n        Some(v) : if (v11)\n        {\n            !name_eq(\n "
    "               StringView::trim(v),\n                \"close\",\n            )\n        }\n        else { "
    "name_eq(StringView::trim(v), \"keep-alive\") },\n        None : v11,\n    };\n    c.head_request = String"
    "View::eq(parts[0], \"HEAD\");\n    BodyLength how = match (body_length(&headers[0..$], false))\n    {\n  "
    "      Ok(h)  : h,\n        Err(e) :\n        {\n            c.keep_alive = false;\n            return Er"
    "r(e);\n        },\n    };\n    if (Some(expect) = find_header(&headers[0..$], \"expect\"))\n    {\n        "
    "if (name_eq(StringView::trim(expect), \"100-continue\"))\n        {\n            if (Err(e) = conn_write"
    "(&mut c.reader.conn, &b\"HTTP/1.1 100 Continue\\r\\n\\r\\n\"[0..$]))\n            {\n                c.keep_"
    "alive = false;\n                return Err(e);\n            }\n        }\n    }\n    Vec<u8> body = match"
    " (read_body(&mut c.reader, how, c.max_body))\n    {\n        Ok(b)  : b,\n        Err(e) :\n        {\n  "
    "          c.keep_alive = false;\n            return Err(e);\n        },\n    };\n    Ok(Some(Request { ."
    "method = String::from_view(parts[0]), .url = String::from_view(parts[1]), .headers = headers, .body "
    "= body }))\n}export fn HttpConnection::respond(\n    ref<HttpConnection, exclusive> c,\n    u16 status,"
    "\n    slice<Header, shared> headers,\n    slice<u8, shared> body,\n) : Result<void, HttpError>\n{\n    St"
    "ring head = String::from_str(\"HTTP/1.1 \");\n    String::append(&mut head, status);\n    String::append"
    "(&mut head, \" \");\n    String::append(&mut head, reason_phrase(status));\n    String::append(&mut head"
    ", \"\\r\\n\");\n    for (usize i = 0; i < slice_len(headers); i += 1)\n    {\n        if (name_eq(\n        "
    "    String::as_view(&headers[i].name),\n            \"content-length\",\n        ) || name_eq(String::as"
    "_view(&headers[i].name), \"connection\"))\n        {\n            continue;\n        }\n        String::ap"
    "pend(&mut head, String::as_view(&headers[i].name));\n        String::append(&mut head, \": \");\n       "
    " String::append(&mut head, String::as_view(&headers[i].value));\n        String::append(&mut head, \"\\"
    "r\\n\");\n    }\n    bool no_body = status == 204 || status == 304 || (status >= 100 && status < 200);\n "
    "   if (!no_body)\n    {\n        String::append(&mut head, \"Content-Length: \");\n        String::append"
    "(&mut head, slice_len(body));\n        String::append(&mut head, \"\\r\\n\");\n    }\n    String::append(\n "
    "       &mut head,\n        if (c.keep_alive) { \"Connection: keep-alive\\r\\n\\r\\n\" } else { \"Connection:"
    " close\\r\\n\\r\\n\" },\n    );\n    Vec<u8> out = String::into_bytes(head);\n    if (!no_body && !c.head_re"
    "quest)\n    {\n        Vec::extend_from(&mut out, body);\n    }\n    conn_write(&mut c.reader.conn, &out"
    "[0..$])?;\n    if (!c.keep_alive)\n    {\n        conn_close(&mut c.reader.conn);\n        c.closed = tr"
    "ue;\n    }\n    Ok(())\n}export fn HttpConnection::close(ref<HttpConnection, exclusive> c)\n{\n    if (!c"
    ".closed)\n    {\n        conn_close(&mut c.reader.conn);\n        c.closed = true;\n    }\n}export fn scr"
    "am_salted_password(StringView password, slice<u8, shared> salt, usize iterations) : Vec<u8>\n{\n    pb"
    "kdf2(Sha2_256, StringView::as_bytes(password), salt, iterations, 32)\n}export fn Scram::start(StringV"
    "iew user, StringView client_nonce) : Scram\n{\n    String bare = String::from_str(\"n=\");\n    foreach ("
    "c in StringView::as_bytes(user))\n    {\n        if (*c == b',')\n        {\n            String::append("
    "&mut bare, \"=2C\");\n        }\n        else if (*c == b'=')\n        {\n            String::append(&mut "
    "bare, \"=3D\");\n        }\n        else\n        {\n            String::push_ascii(&mut bare, *c);\n      "
    "  }\n    }\n    String::append(&mut bare, \",r=\");\n    String::append(&mut bare, client_nonce);\n    Scr"
    "am { .client_nonce = String::from_view(client_nonce), .client_first_bare = bare, .server_signature ="
    " Vec::new() }\n}export fn Scram::client_first(ref<Scram, shared> s) : String\n{\n    String m = String:"
    ":from_str(\"n,,\");\n    String::append(&mut m, String::as_view(&s.client_first_bare));\n    m\n}fn attri"
    "bute(slice<StringView, shared> parts, str name) : Option<StringView>\n{\n    foreach (p in parts)\n    "
    "{\n        if (StringView::starts_with(*p, StringView::of(name)))\n        {\n            return Some(S"
    "tringView::sub(*p, 2, StringView::len(*p)));\n        }\n    }\n    None\n}export fn Scram::respond(\n   "
    " ref<Scram, exclusive> s,\n    StringView server_first,\n    StringView password,\n) : Result<String, P"
    "gError>\n{\n    Vec<StringView> parts = StringView::split(server_first, \",\");\n    if (Option::is_some("
    "&attribute(&parts[0..$], \"m=\")))\n    {\n        return Err(ProtocolViolation);\n    }\n    StringView n"
    "once = Option::ok_or(attribute(&parts[0..$], \"r=\"), ProtocolViolation)?;\n    StringView salt_text = "
    "Option::ok_or(attribute(&parts[0..$], \"s=\"), ProtocolViolation)?;\n    StringView iter_text = Option:"
    ":ok_or(attribute(&parts[0..$], \"i=\"), ProtocolViolation)?;\n    if (!StringView::starts_with(\n       "
    " nonce,\n        String::as_view(&s.client_nonce),\n    ) || StringView::len(nonce) <= String::len(&s."
    "client_nonce))\n    {\n        return Err(AuthFailed);\n    }\n    Vec<u8> salt = match (base64_decode(s"
    "alt_text))\n    {\n        Ok(v)  : v,\n        Err(_) : return Err(ProtocolViolation),\n    };\n    usiz"
    "e iterations = match (StringView::parse<usize>(iter_text))\n    {\n        Ok(n)  : n,\n        Err(_) "
    ": return Err(ProtocolViolation),\n    };\n    if (iterations == 0)\n    {\n        return Err(ProtocolVi"
    "olation);\n    }\n    Vec<u8> salted = scram_salted_password(password, &salt[0..$], iterations);\n    a"
    "rray<u8, 32> client_key = hmac_sha256(&salted[0..$], &b\"Client Key\"[0..$]);\n    array<u8, 32> stored"
    "_key = sha256(&client_key[0..$]);\n    String without_proof = String::from_str(\"c=biws,r=\");\n    Stri"
    "ng::append(&mut without_proof, nonce);\n    String auth = String::clone(&s.client_first_bare);\n    St"
    "ring::append(&mut auth, \",\");\n    String::append(&mut auth, server_first);\n    String::append(&mut a"
    "uth, \",\");\n    String::append(&mut auth, String::as_view(&without_proof));\n    array<u8, 32> client_"
    "signature = hmac_sha256(&stored_key[0..$], StringView::as_bytes(String::as_view(&auth)));\n    Vec<u8"
    "> proof = Vec::new();\n    for (usize i = 0; i < 32; i += 1)\n    {\n        Vec::push(&mut proof, clie"
    "nt_key[i] ^ client_signature[i]);\n    }\n    array<u8, 32> server_key = hmac_sha256(&salted[0..$], &b"
    "\"Server Key\"[0..$]);\n    array<u8, 32> server_signature = hmac_sha256(&server_key[0..$], StringView:"
    ":as_bytes(String::as_view(&auth)));\n    overwrite(&mut s.server_signature, Vec::from_slice(&server_s"
    "ignature[0..$]));\n    String::append(&mut without_proof, \",p=\");\n    String::append(&mut without_pro"
    "of, String::as_view(&base64_encode(&proof[0..$])));\n    Ok(without_proof)\n}export fn Scram::verify(r"
    "ef<Scram, shared> s, StringView server_final) : bool\n{\n    if (Vec::len(&s.server_signature) == 0 ||"
    " !StringView::starts_with(server_final, \"v=\"))\n    {\n        return false;\n    }\n    match (base64_d"
    "ecode(StringView::sub(server_final, 2, StringView::len(server_final))))\n    {\n        Ok(v)  : diges"
    "t_eq(&v[0..$], &s.server_signature[0..$]),\n        Err(_) : false,\n    }\n}unittest \"Scram: a whole e"
    "xchange\"\n{\n    Scram s = Scram::start(\"user\", \"rOprNGfwEbeRWgbNEkqO\");\n    assert(String::eq_str(&Sc"
    "ram::client_first(&s), \"n,,n=user,r=rOprNGfwEbeRWgbNEkqO\"));\n    String first = String::from_str(\"r="
    "rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,\");\n    String::append(&mut first, \"s=W22ZaJ0SNY7"
    "soEsUEjb6gQ==,i=4\");\n    String reply = Result::unwrap(Scram::respond(&mut s, String::as_view(&first"
    "), \"pencil\"));\n    assert(StringView::ends_with(String::as_view(&reply), \",p=0ByS2g6XZEtov8MR140MFRs"
    "Efy8/X+bacfpPofVtKjE=\"));\n    assert(Scram::verify(&s, \"v=ITrN4zX09+hsD398Qk6ol73eg0shWPnOWwnwS83jit"
    "c=\"));\n    assert(!Scram::verify(&s, \"e=invalid-proof\"));\n}export fn PgError::text(ref<PgError, shar"
    "ed> e) : String\n{\n    match (e)\n    {\n        PgNetFailure(n)   : String::from_str(NetError::text(n)"
    "),\n        PgTlsFailure(t)   : String::from_str(TlsError::text(t)),\n        TlsRefused        : Stri"
    "ng::from_str(\"the server does not accept TLS\"),\n        NoTrustedRoots    : String::from_str(\"no tru"
    "sted roots for TLS (TrustStore::system failed)\"),\n        BadConnectionUrl  : String::from_str(\"the "
    "connection URL is malformed\"),\n        UnsupportedAuth   : String::from_str(\"the server asks for an "
    "authentication method that is not supported\"),\n        AuthRefused       : String::from_str(\"the ser"
    "ver asks for the password in clear over an unencrypted connection\"),\n        AuthFailed        : Str"
    "ing::from_str(\"authentication failed\"),\n        Server(s)         :\n        {\n            String t ="
    " String::clone(&s.severity);\n            String::append(&mut t, \": \");\n            String::append(&m"
    "ut t, String::as_view(&s.message));\n            String::append(&mut t, \" (\");\n            String::ap"
    "pend(&mut t, String::as_view(&s.code));\n            String::append(&mut t, \")\");\n            t\n     "
    "   },\n        ProtocolViolation : String::from_str(\"the server's message is malformed\"),\n        Res"
    "ultTooLarge    : String::from_str(\"the result is larger than the limit\"),\n        Disconnected      "
    ": String::from_str(\"the connection is closed\"),\n    }\n}fn decoded(StringView v) : Result<String, PgE"
    "rror>\n{\n    Vec<u8> bytes = match (percent_decode(v))\n    {\n        Some(b) : b,\n        None    : r"
    "eturn Err(BadConnectionUrl),\n    };\n    match (String::from_utf8(bytes))\n    {\n        Ok(s)  : Ok(s"
    "),\n        Err(_) : Err(BadConnectionUrl),\n    }\n}export fn PgUrl::parse(StringView text) : Result<P"
    "gUrl, PgError>\n{\n    usize sep = match (StringView::find(text, \"://\"))\n    {\n        Some(i) : i,\n  "
    "      None    : return Err(BadConnectionUrl),\n    };\n    StringView scheme = StringView::sub(text, 0"
    ", sep);\n    if (!StringView::eq(scheme, \"postgres\") && !StringView::eq(scheme, \"postgresql\"))\n    {\n"
    "        return Err(BadConnectionUrl);\n    }\n    StringView rest = StringView::sub(text, sep + 3, Str"
    "ingView::len(text));\n    usize n = StringView::len(rest);\n    slice<u8, shared> b = StringView::as_b"
    "ytes(rest);\n    usize auth_end = 0;\n    while (auth_end < n && b[auth_end] != b'/' && b[auth_end] !="
    " b'?')\n    {\n        auth_end += 1;\n    }\n    // The user information ends at the last '@' of the au"
    "thority.\n    usize at_sign = auth_end;\n    for (usize i = 0; i < auth_end; i += 1)\n    {\n        if "
    "(b[i] == b'@')\n        {\n            at_sign = i;\n        }\n    }\n    if (at_sign == auth_end || at_"
    "sign == 0)\n    {\n        return Err(BadConnectionUrl);\n    }\n    StringView userinfo = StringView::s"
    "ub(rest, 0, at_sign);\n    String user = String::new();\n    Option<String> password = None;\n    match"
    " (StringView::find(userinfo, \":\"))\n    {\n        Some(colon) :\n        {\n            overwrite(&mut "
    "user, decoded(StringView::sub(userinfo, 0, colon))?);\n            overwrite(&mut password, Some(deco"
    "ded(StringView::sub(userinfo, colon + 1, StringView::len(userinfo)))?));\n        },\n        None    "
    "    : overwrite(&mut user, decoded(userinfo)?),\n    }\n    if (String::len(&user) == 0)\n    {\n       "
    " return Err(BadConnectionUrl);\n    }\n    StringView hostport = StringView::sub(rest, at_sign + 1, au"
    "th_end);\n    usize hp = StringView::len(hostport);\n    slice<u8, shared> hb = StringView::as_bytes(h"
    "ostport);\n    if (hp == 0)\n    {\n        return Err(BadConnectionUrl);\n    }\n    String host = Strin"
    "g::new();\n    usize host_end = 0;\n    if (hb[0] == b'[')\n    {\n        usize close = match (StringVi"
    "ew::find(hostport, \"]\"))\n        {\n            Some(i) : i,\n            None    : return Err(BadConn"
    "ectionUrl),\n        };\n        String::append(&mut host, StringView::sub(hostport, 1, close));\n     "
    "   host_end = close + 1;\n    }\n    else\n    {\n        while (host_end < hp && hb[host_end] != b':')\n"
    "        {\n            host_end += 1;\n        }\n        String::append(&mut host, StringView::sub(hos"
    "tport, 0, host_end));\n    }\n    if (String::len(&host) == 0)\n    {\n        return Err(BadConnectionU"
    "rl);\n    }\n    u16 port = 5432;\n    if (host_end < hp)\n    {\n        if (hb[host_end] != b':')\n     "
    "   {\n            return Err(BadConnectionUrl);\n        }\n        port = match (StringView::parse<u16"
    ">(StringView::sub(hostport, host_end + 1, hp)))\n        {\n            Ok(p)  : p,\n            Err(_)"
    " : return Err(BadConnectionUrl),\n        };\n    }\n    // The database: the path without its '/', the"
    " user when none.\n    usize path_end = auth_end;\n    while (path_end < n && b[path_end] != b'?')\n    "
    "{\n        path_end += 1;\n    }\n    String database = String::new();\n    if (path_end > auth_end + 1)"
    "\n    {\n        overwrite(&mut database, decoded(StringView::sub(rest, auth_end + 1, path_end))?);\n  "
    "  }\n    if (String::len(&database) == 0)\n    {\n        overwrite(&mut database, String::clone(&user)"
    ");\n    }\n    PgSslMode sslmode = VerifyFull;\n    if (path_end < n)\n    {\n        StringView query = "
    "StringView::sub(rest, path_end + 1, n);\n        if (StringView::len(query) > 0)\n        {\n          "
    "  Vec<StringView> pairs = StringView::split(query, \"&\");\n            foreach (pair in &pairs)\n      "
    "      {\n                if (StringView::starts_with(*pair, \"sslmode=\"))\n                {\n          "
    "          StringView mode = StringView::sub(*pair, 8, StringView::len(*pair));\n                    i"
    "f (StringView::eq(mode, \"disable\"))\n                    {\n                        sslmode = Disable;"
    "\n                    }\n                    else if (StringView::eq(mode, \"verify-full\"))\n           "
    "         {\n                        sslmode = VerifyFull;\n                    }\n                    e"
    "lse\n                    {\n                        return Err(BadConnectionUrl);\n                    "
    "}\n                }\n                else\n                {\n                    return Err(BadConnect"
    "ionUrl);\n                }\n            }\n        }\n    }\n    Ok(PgUrl { .user = user, .password = pa"
    "ssword, .host = host, .port = port, .database = database, .sslmode = sslmode })\n}unittest \"PgUrl::pa"
    "rse: decoding and defaults\"\n{\n    PgUrl u = Result::unwrap(PgUrl::parse(\"postgres://app:p%40ss@[::1]"
    "/?sslmode=disable\"));\n    assert(String::eq_str(&u.host, \"::1\") && u.port == 5432);\n    assert(Strin"
    "g::eq_str(&u.database, \"app\"));\n    match (&u.password)\n    {\n        Some(p) : assert(String::eq_st"
    "r(p, \"p@ss\")),\n        None    : assert(false),\n    }\n    Result<PgUrl, PgError> no_user = PgUrl::pa"
    "rse(\"postgres://db.example/shop\");\n    assert(Result::is_err(&no_user));\n}fn float_text(f64 x) : Str"
    "ing\n{\n    if (x != x)\n    {\n        return String::from_str(\"NaN\");\n    }\n    if (x > 1.797693134862"
    "3157e308)\n    {\n        return String::from_str(\"Infinity\");\n    }\n    if (x < -1.7976931348623157e3"
    "08)\n    {\n        return String::from_str(\"-Infinity\");\n    }\n    String t = String::new();\n    Stri"
    "ng::append(&mut t, x);\n    t\n}export fn PgValue::text(ref<PgValue, shared> value) : Option<String>\n{"
    "\n    match (value)\n    {\n        Null     : None,\n        Text(s)  : Some(String::clone(s)),\n       "
    " Int(i)   :\n        {\n            String t = String::new();\n            String::append(&mut t, *i);\n"
    "            Some(t)\n        },\n        Float(f) : Some(float_text(*f)),\n        Bool(b)  : Some(Stri"
    "ng::from_str(if (*b) { \"t\" } else { \"f\" })),\n        Bytes(v) :\n        {\n            String t = Str"
    "ing::from_str(\"\\\\x\");\n            String::append(&mut t, String::as_view(&to_hex(&v[0..$])));\n      "
    "      Some(t)\n        },\n    }\n}unittest \"PgValue::text: what is sent\"\n{\n    assert(String::eq_str(&"
    "Option::unwrap(PgValue::text(&Bool(true))), \"t\"));\n    assert(String::eq_str(&Option::unwrap(PgValue"
    "::text(&Bytes(Vec::filled(2, 0xAB: u8)))), \"\\\\xabab\"));\n    assert(String::eq_str(&Option::unwrap(Pg"
    "Value::text(&Float(1.0 / 0.0))), \"Infinity\"));\n    assert(Option::is_none(&PgValue::text(&Null)));\n}"
    "export fn PgRow::get(ref<PgRow, shared> r, usize i) : Option<StringView>\n{\n    if (i >= Vec::len(&r."
    "cells))\n    {\n        return None;\n    }\n    match (&r.cells[i])\n    {\n        Some(s) : Some(String"
    "::as_view(s)),\n        None    : None,\n    }\n}export fn PgRow::get_i64(ref<PgRow, shared> r, usize i"
    ") : Option<i64>\n{\n    match (PgRow::get(r, i))\n    {\n        Some(t) : match (StringView::parse<i64>"
    "(t))\n        {\n            Ok(v)  : Some(v),\n            Err(_) : None,\n        },\n        None : No"
    "ne,\n    }\n}export fn PgRow::get_f64(ref<PgRow, shared> r, usize i) : Option<f64>\n{\n    match (PgRow:"
    ":get(r, i))\n    {\n        Some(t) :\n        {\n            if (StringView::eq(t, \"NaN\"))\n            "
    "{\n                return Some(0.0 / 0.0);\n            }\n            if (StringView::eq(t, \"Infinity\""
    "))\n            {\n                return Some(1.0 / 0.0);\n            }\n            if (StringView::e"
    "q(t, \"-Infinity\"))\n            {\n                return Some(-1.0 / 0.0);\n            }\n            "
    "match (StringView::parse<f64>(t))\n            {\n                Ok(v)  : Some(v),\n                Er"
    "r(_) : None,\n            }\n        },\n        None    : None,\n    }\n}export fn PgRow::get_bool(ref<P"
    "gRow, shared> r, usize i) : Option<bool>\n{\n    match (PgRow::get(r, i))\n    {\n        Some(t) :\n    "
    "    {\n            if (StringView::eq(t, \"t\"))\n            {\n                return Some(true);\n     "
    "       }\n            if (StringView::eq(t, \"f\"))\n            {\n                return Some(false);\n "
    "           }\n            None\n        },\n        None    : None,\n    }\n}export fn PgRow::get_bytes(r"
    "ef<PgRow, shared> r, usize i) : Option<Vec<u8>>\n{\n    match (PgRow::get(r, i))\n    {\n        Some(t)"
    " : match (StringView::strip_prefix(t, \"\\\\x\"))\n        {\n            // `\\x` alone is the empty bytea"
    ", which from_hex refuses.\n            Some(hex) : if (StringView::len(hex) == 0)\n            {\n     "
    "           Some(Vec::new())\n            }\n            else\n            {\n                match (from"
    "_hex(hex))\n                {\n                    Ok(v)  : Some(v),\n                    Err(_) : None"
    ",\n                }\n            },\n            None : None,\n        },\n        None : None,\n    }\n}u"
    "nittest \"PgRow: typed reads of cells\"\n{\n    Vec<Option<String>> cells = Vec::new();\n    Vec::push(&m"
    "ut cells, Some(String::from_str(\"42\")));\n    Vec::push(&mut cells, Some(String::from_str(\"t\")));\n   "
    " Vec::push(&mut cells, None);\n    PgRow row = PgRow { .cells = cells };\n    assert(Option::unwrap(Pg"
    "Row::get_i64(&row, 0)) == 42);\n    assert(Option::unwrap(PgRow::get_bool(&row, 1)));\n    assert(Opti"
    "on::is_none(&PgRow::get_bool(&row, 0)));\n    assert(Option::is_none(&PgRow::get(&row, 2)) && Option:"
    ":is_none(&PgRow::get(&row, 9)));\n}export fn PgResult::column(ref<PgResult, shared> res, StringView n"
    "ame) : Option<usize>\n{\n    for (usize i = 0; i < Vec::len(&res.columns); i += 1)\n    {\n        if (S"
    "tring::eq_view(&res.columns[i].name, name))\n        {\n            return Some(i);\n        }\n    }\n  "
    "  None\n}fn tag_count(StringView tag) : u64\n{\n    Vec<StringView> words = StringView::split(tag, \" \")"
    ";\n    if (Vec::len(&words) < 2)\n    {\n        return 0;\n    }\n    match (StringView::parse<u64>(word"
    "s[Vec::len(&words) - 1]))\n    {\n        Ok(n)  : n,\n        Err(_) : 0,\n    }\n}fn pg_read(ref<PgConn"
    ", exclusive> c, ref<Vec<u8>, exclusive> buf, usize max) : Result<usize, PgError>\n{\n    match (c)\n   "
    " {\n        Plain(s) : match (TcpStream::read(s, buf, max))\n        {\n            Ok(n)  : Ok(n),\n   "
    "         Err(e) : Err(PgNetFailure(e)),\n        },\n        Secure(s) : match (TlsStream::read(s, buf"
    ", max))\n        {\n            Ok(n)  : Ok(n),\n            Err(e) : Err(PgTlsFailure(e)),\n        },\n"
    "    }\n}fn pg_write(ref<PgConn, exclusive> c, slice<u8, shared> data) : Result<void, PgError>\n{\n    m"
    "atch (c)\n    {\n        Plain(s) : match (TcpStream::write(s, data))\n        {\n            Ok(_)  : O"
    "k(()),\n            Err(e) : Err(PgNetFailure(e)),\n        },\n        Secure(s) : match (TlsStream::w"
    "rite(s, data))\n        {\n            Ok(_)  : Ok(()),\n            Err(e) : Err(PgTlsFailure(e)),\n   "
    "     },\n    }\n}fn pg_close(ref<PgConn, exclusive> c)\n{\n    match (c)\n    {\n        Plain(s)  : { _ ="
    " TcpStream::shutdown_write(s); },\n        Secure(s) : { _ = TlsStream::close(s); },\n    }\n}fn pg_fil"
    "l(ref<PgReader, exclusive> r) : Result<bool, PgError>\n{\n    if (r.at > 0 && r.at == Vec::len(&r.buf)"
    ")\n    {\n        Vec::clear(&mut r.buf);\n        r.at = 0;\n    }\n    usize n = pg_read(&mut r.conn, &"
    "mut r.buf, 16384)?;\n    Ok(n > 0)\n}fn pg_available(ref<PgReader, shared> r) : usize\n{\n    Vec::len(&"
    "r.buf) - r.at\n}fn pg_read_n(ref<PgReader, exclusive> r, ref<Vec<u8>, exclusive> out, usize n) : Resu"
    "lt<void, PgError>\n{\n    usize need = n;\n    while (need > 0)\n    {\n        if (pg_available(r) == 0)"
    "\n        {\n            if (!pg_fill(r)?)\n            {\n                return Err(Disconnected);\n   "
    "         }\n        }\n        usize take = min(need, pg_available(r));\n        Vec::extend_from(out, "
    "&r.buf[r.at..r.at + take]);\n        r.at += take;\n        need -= take;\n    }\n    Ok(())\n}fn read_me"
    "ssage(ref<PgReader, exclusive> r) : Result<Message, PgError>\n{\n    // Most messages are already whol"
    "e in the buffer: taken from it at once.\n    usize avail = pg_available(r);\n    if (avail >= 5)\n    {"
    "\n        u8 kind = r.buf[r.at];\n        u32 len = read_be<u32>(&r.buf[0..$], r.at + 1);\n        if ("
    "len < 4 || widen<usize>(len) - 4 > MAX_MESSAGE)\n        {\n            return Err(ProtocolViolation);"
    "\n        }\n        usize n = widen<usize>(len) - 4;\n        if (avail - 5 >= n)\n        {\n          "
    "  Vec<u8> body = Vec::from_slice(&r.buf[r.at + 5..r.at + 5 + n]);\n            r.at += 5 + n;\n       "
    "     return Ok(Message { .kind = kind, .body = body });\n        }\n    }\n    Vec<u8> head = Vec::new("
    ");\n    pg_read_n(r, &mut head, 5)?;\n    u8 kind = head[0];\n    u32 len = read_be<u32>(&head[0..$], 1"
    ");\n    if (len < 4 || widen<usize>(len) - 4 > MAX_MESSAGE)\n    {\n        return Err(ProtocolViolatio"
    "n);\n    }\n    Vec<u8> body = Vec::new();\n    pg_read_n(r, &mut body, widen<usize>(len) - 4)?;\n    Ok"
    "(Message { .kind = kind, .body = body })\n}fn frame(u8 kind, slice<u8, shared> body) : Vec<u8>\n{\n    "
    "Vec<u8> out = Vec::new();\n    Vec::push(&mut out, kind);\n    Vec::push_be(&mut out, narrow<u32>(slic"
    "e_len(body) + 4));\n    Vec::extend_from(&mut out, body);\n    out\n}fn push_cstr(ref<Vec<u8>, exclusiv"
    "e> out, StringView s)\n{\n    Vec::extend_from(out, StringView::as_bytes(s));\n    Vec::push(out, 0);\n}"
    "fn cstr_at(slice<u8, shared> b, ref<usize, exclusive> at) : Result<String, PgError>\n{\n    usize end "
    "= *at;\n    while (end < slice_len(b) && b[end] != 0)\n    {\n        end += 1;\n    }\n    if (end == sl"
    "ice_len(b))\n    {\n        return Err(ProtocolViolation);\n    }\n    Vec<u8> bytes = Vec::from_slice(&"
    "b[*at..end]);\n    *at = end + 1;\n    match (String::from_utf8(bytes))\n    {\n        Ok(s)  : Ok(s),\n"
    "        Err(_) : Err(ProtocolViolation),\n    }\n}fn decode_server_error(slice<u8, shared> b) : Result"
    "<PgServerError, PgError>\n{\n    PgServerError e = PgServerError { .severity = String::new(), .code = "
    "String::new(), .message = String::new(), .detail = None, .hint = None, .position = None };\n    usize"
    " at = 0;\n    while (at < slice_len(b) && b[at] != 0)\n    {\n        u8 field = b[at];\n        at += 1"
    ";\n        String t = cstr_at(b, &mut at)?;\n        if (field == b'S' || field == b'V')\n        {\n   "
    "         overwrite(&mut e.severity, t);\n        }\n        else if (field == b'C')\n        {\n        "
    "    overwrite(&mut e.code, t);\n        }\n        else if (field == b'M')\n        {\n            overw"
    "rite(&mut e.message, t);\n        }\n        else if (field == b'D')\n        {\n            overwrite(&"
    "mut e.detail, Some(t));\n        }\n        else if (field == b'H')\n        {\n            overwrite(&m"
    "ut e.hint, Some(t));\n        }\n        else if (field == b'P')\n        {\n            match (String::"
    "parse<u32>(&t))\n            {\n                Ok(p)  : overwrite(&mut e.position, Some(p)),\n        "
    "        Err(_) : {},\n            }\n        }\n    }\n    Ok(e)\n}fn decode_columns(slice<u8, shared> b)"
    " : Result<Vec<PgColumn>, PgError>\n{\n    if (slice_len(b) < 2)\n    {\n        return Err(ProtocolViola"
    "tion);\n    }\n    usize n = widen<usize>(read_be<u16>(b, 0));\n    usize at = 2;\n    Vec<PgColumn> col"
    "umns = Vec::new();\n    for (usize i = 0; i < n; i += 1)\n    {\n        String name = cstr_at(b, &mut "
    "at)?;\n        if (at + 18 > slice_len(b))\n        {\n            return Err(ProtocolViolation);\n     "
    "   }\n        u32 type_oid = read_be<u32>(b, at + 6);\n        at += 18;\n        Vec::push(&mut column"
    "s, PgColumn { .name = name, .type_oid = type_oid });\n    }\n    Ok(columns)\n}fn decode_row(slice<u8, "
    "shared> b) : Result<PgRow, PgError>\n{\n    if (slice_len(b) < 2)\n    {\n        return Err(ProtocolVio"
    "lation);\n    }\n    usize n = widen<usize>(read_be<u16>(b, 0));\n    usize at = 2;\n    Vec<Option<Stri"
    "ng>> cells = Vec::new();\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (at + 4 > slice_len(b"
    "))\n        {\n            return Err(ProtocolViolation);\n        }\n        i32 len = read_be<i32>(b, "
    "at);\n        at += 4;\n        if (len < 0)\n        {\n            Vec::push(&mut cells, None);\n      "
    "      continue;\n        }\n        usize size = narrow<usize>(len);\n        if (at + size > slice_len"
    "(b))\n        {\n            return Err(ProtocolViolation);\n        }\n        Vec<u8> bytes = Vec::fro"
    "m_slice(&b[at..at + size]);\n        at += size;\n        match (String::from_utf8(bytes))\n        {\n "
    "           Ok(s)  : Vec::push(&mut cells, Some(s)),\n            Err(_) : return Err(ProtocolViolatio"
    "n),\n        }\n    }\n    Ok(PgRow { .cells = cells })\n}fn open_tcp(StringView host, u16 port, u64 tim"
    "eout_ms) : Result<TcpStream, PgError>\n{\n    Vec<SocketAddr> addrs = match (IpAddr::parse(host))\n    "
    "{\n        Ok(ip) :\n        {\n            Vec<SocketAddr> one = Vec::new();\n            Vec::push(&mu"
    "t one, SocketAddr::new(ip, port));\n            one\n        },\n        Err(_) : match (resolve(host, "
    "port))\n        {\n            Ok(a)  : a,\n            Err(e) : return Err(PgNetFailure(e)),\n        }"
    ",\n    };\n    if (Vec::len(&addrs) == 0)\n    {\n        return Err(PgNetFailure(UnknownHost));\n    }\n "
    "   NetError last = Failed;\n    for (usize i = 0; i < Vec::len(&addrs); i += 1)\n    {\n        TcpStre"
    "am tcp = match (TcpStream::connect_timeout(addrs[i], timeout_ms))\n        {\n            Ok(t)  : t,\n"
    "            Err(e) :\n            {\n                last = e;\n                continue;\n            }"
    ",\n        };\n        TcpStream::set_read_timeout_ms(&mut tcp, timeout_ms);\n        TcpStream::set_wr"
    "ite_timeout_ms(&mut tcp, timeout_ms);\n        TcpStream::set_nodelay(&mut tcp, true);\n        return"
    " Ok(tcp);\n    }\n    Err(PgNetFailure(last))\n}export fn PgConnection::connect(StringView url) : Resul"
    "t<PgConnection, PgError>\n{\n    PgUrl u = PgUrl::parse(url)?;\n    TrustStore roots = match (u.sslmode"
    ")\n    {\n        Disable : TrustStore::new(),\n        VerifyFull : match (TrustStore::system())\n     "
    "   {\n            Ok(t)  : t,\n            Err(_) : return Err(NoTrustedRoots),\n        },\n    };\n    "
    "connect_url(&u, &roots, 30000)\n}export fn PgConnection::connect_with(\n    StringView url,\n    ref<Tr"
    "ustStore, shared> roots,\n    u64 timeout_ms,\n) : Result<PgConnection, PgError>\n{\n    PgUrl u = PgUrl"
    "::parse(url)?;\n    connect_url(&u, roots, timeout_ms)\n}fn connect_url(ref<PgUrl, shared> u, ref<Trus"
    "tStore, shared> roots, u64 timeout_ms) : Result<PgConnection, PgError>\n{\n    TcpStream tcp = open_tc"
    "p(String::as_view(&u.host), u.port, timeout_ms)?;\n    bool secure = false;\n    PgConn conn = match ("
    "u.sslmode)\n    {\n        Disable    : Plain(tcp),\n        VerifyFull :\n        {\n            // SSLR"
    "equest: the server answers S (go ahead) or N (no TLS).\n            Vec<u8> req = Vec::new();\n       "
    "     Vec::push_be<u32>(&mut req, 8);\n            Vec::push_be<u32>(&mut req, 80877103);\n            "
    "match (TcpStream::write(&mut tcp, &req[0..$]))\n            {\n                Ok(_)  : {},\n          "
    "      Err(e) : return Err(PgNetFailure(e)),\n            }\n            Vec<u8> answer = Vec::new();\n "
    "           match (TcpStream::read_exact(&mut tcp, &mut answer, 1))\n            {\n                Ok("
    "_)  : {},\n                Err(e) : return Err(PgNetFailure(e)),\n            }\n            if (answer"
    "[0] == b'N')\n            {\n                return Err(TlsRefused);\n            }\n            if (ans"
    "wer[0] != b'S')\n            {\n                return Err(ProtocolViolation);\n            }\n         "
    "   secure = true;\n            match (TlsStream::client(tcp, String::as_view(&u.host), roots))\n      "
    "      {\n                Ok(s)  : Secure(s),\n                Err(e) : return Err(PgTlsFailure(e)),\n  "
    "          }\n        },\n    };\n    PgConnection c = PgConnection { .reader = PgReader { .conn = conn,"
    " .buf = Vec::new(), .at = 0 }, .secure = secure, .closed = false, .parameters = Vec::new(), .backend"
    "_pid = 0, .backend_key = 0, .notices = Vec::new(), .max_result = 16777216 };\n    // StartupMessage: "
    "protocol 3.0, the user, the database, UTF-8.\n    Vec<u8> body = Vec::new();\n    Vec::push_be<u32>(&m"
    "ut body, 196608);\n    push_cstr(&mut body, \"user\");\n    push_cstr(&mut body, String::as_view(&u.user"
    "));\n    push_cstr(&mut body, \"database\");\n    push_cstr(&mut body, String::as_view(&u.database));\n  "
    "  push_cstr(&mut body, \"client_encoding\");\n    push_cstr(&mut body, \"UTF8\");\n    Vec::push(&mut body"
    ", 0);\n    Vec<u8> startup = Vec::new();\n    Vec::push_be(&mut startup, narrow<u32>(Vec::len(&body) +"
    " 4));\n    Vec::extend_from(&mut startup, &body[0..$]);\n    match (pg_write(&mut c.reader.conn, &star"
    "tup[0..$]))\n    {\n        Ok(_)  : {},\n        Err(e) : return Err(e),\n    }\n    match (authenticate"
    "(&mut c, u))\n    {\n        Ok(_)  : Ok(c),\n        Err(e) :\n        {\n            pg_close(&mut c.re"
    "ader.conn);\n            Err(e)\n        },\n    }\n}fn authenticate(ref<PgConnection, exclusive> c, ref"
    "<PgUrl, shared> u) : Result<void, PgError>\n{\n    Option<Scram> scram = None;\n    // Once SCRAM has b"
    "egun, AuthenticationOk counts only after the\n    // server's signature was verified ([Pg-Auth]): a s"
    "erver that skips\n    // its final message has not proved it knows the password.\n    bool scram_begun"
    " = false;\n    bool scram_verified = false;\n    String password = match (&u.password)\n    {\n        S"
    "ome(p) : String::clone(p),\n        None    : String::new(),\n    };\n    while (true)\n    {\n        Me"
    "ssage m = read_message(&mut c.reader)?;\n        slice<u8, shared> b = &m.body[0..$];\n        if (m.k"
    "ind == b'R')\n        {\n            if (slice_len(b) < 4)\n            {\n                return Err(Pr"
    "otocolViolation);\n            }\n            u32 code = read_be<u32>(b, 0);\n            if (code == 0"
    ")\n            {\n                if (scram_begun && !scram_verified)\n                {\n              "
    "      return Err(AuthFailed);\n                }\n                continue;\n            }\n            "
    "else if (code == 3)\n            {\n                if (!c.secure)\n                {\n                 "
    "   return Err(AuthRefused);\n                }\n                Vec<u8> pw = Vec::new();\n             "
    "   push_cstr(&mut pw, String::as_view(&password));\n                pg_write(&mut c.reader.conn, &fra"
    "me(b'p', &pw[0..$])[0..$])?;\n            }\n            else if (code == 10)\n            {\n          "
    "      bool offered = false;\n                usize at = 4;\n                while (at < slice_len(b) &"
    "& b[at] != 0)\n                {\n                    String mech = cstr_at(b, &mut at)?;\n            "
    "        if (String::eq_str(&mech, \"SCRAM-SHA-256\"))\n                    {\n                        of"
    "fered = true;\n                    }\n                }\n                if (!offered)\n                "
    "{\n                    return Err(UnsupportedAuth);\n                }\n                array<u8, 18> r"
    "aw = [0; 18];\n                os_random_bytes(&mut raw[0..$]);\n                String nonce = base64"
    "_encode(&raw[0..$]);\n                Scram s = Scram::start(\"\", String::as_view(&nonce));\n          "
    "      String first = Scram::client_first(&s);\n                Vec<u8> body = Vec::new();\n           "
    "     push_cstr(&mut body, \"SCRAM-SHA-256\");\n                Vec::push_be(&mut body, narrow<u32>(Stri"
    "ng::len(&first)));\n                Vec::extend_from(&mut body, StringView::as_bytes(String::as_view("
    "&first)));\n                pg_write(&mut c.reader.conn, &frame(b'p', &body[0..$])[0..$])?;\n         "
    "       overwrite(&mut scram, Some(s));\n                scram_begun = true;\n            }\n           "
    " else if (code == 11)\n            {\n                String server_first = match (String::from_utf8(V"
    "ec::from_slice(&b[4..$])))\n                {\n                    Ok(s)  : s,\n                    Err"
    "(_) : return Err(ProtocolViolation),\n                };\n                String client_final = match "
    "(&mut scram)\n                {\n                    Some(s) : Scram::respond(s, String::as_view(&serv"
    "er_first), String::as_view(&password))?,\n                    None    : return Err(ProtocolViolation)"
    ",\n                };\n                pg_write(&mut c.reader.conn, &frame(b'p', StringView::as_bytes("
    "String::as_view(&client_final)))[0..$])?;\n            }\n            else if (code == 12)\n           "
    " {\n                String server_final = match (String::from_utf8(Vec::from_slice(&b[4..$])))\n      "
    "          {\n                    Ok(s)  : s,\n                    Err(_) : return Err(ProtocolViolatio"
    "n),\n                };\n                bool ok = match (&scram)\n                {\n                  "
    "  Some(s) : Scram::verify(s, String::as_view(&server_final)),\n                    None    : false,\n "
    "               };\n                if (!ok)\n                {\n                    return Err(AuthFail"
    "ed);\n                }\n                scram_verified = true;\n            }\n            else\n       "
    "     {\n                return Err(UnsupportedAuth);\n            }\n        }\n        else if (m.kind "
    "== b'S')\n        {\n            usize at = 0;\n            String name = cstr_at(b, &mut at)?;\n       "
    "     String value = cstr_at(b, &mut at)?;\n            Vec::push(&mut c.parameters, PgParameter { .na"
    "me = name, .value = value });\n        }\n        else if (m.kind == b'K')\n        {\n            if (s"
    "lice_len(b) < 8)\n            {\n                return Err(ProtocolViolation);\n            }\n        "
    "    c.backend_pid = read_be<u32>(b, 0);\n            c.backend_key = read_be<u32>(b, 4);\n        }\n  "
    "      else if (m.kind == b'Z')\n        {\n            return Ok(());\n        }\n        else if (m.kin"
    "d == b'E')\n        {\n            PgServerError e = decode_server_error(b)?;\n            return Err(i"
    "f (String::starts_with(&e.code, \"28\")) { AuthFailed } else { Server(e) });\n        }\n        else if"
    " (m.kind == b'N')\n        {\n            Vec::push(&mut c.notices, decode_server_error(b)?);\n        "
    "}\n        else\n        {\n            return Err(ProtocolViolation);\n        }\n    }\n}export fn PgCon"
    "nection::parameter(ref<PgConnection, shared> c, str name) : Option<StringView>\n{\n    foreach (p in &"
    "c.parameters)\n    {\n        if (String::eq_str(&p.name, name))\n        {\n            return Some(Str"
    "ing::as_view(&p.value));\n        }\n    }\n    None\n}fn broken(ref<PgConnection, exclusive> c, PgError"
    " e) : PgError\n{\n    c.closed = true;\n    e\n}fn collect(ref<PgConnection, exclusive> c, bool keep) : "
    "Result<PgResult, PgError>\n{\n    PgResult res = PgResult { .columns = Vec::new(), .rows = Vec::new(),"
    " .affected = 0, .tag = String::new() };\n    Option<PgServerError> failure = None;\n    bool too_large"
    " = false;\n    usize bytes = 0;\n    while (true)\n    {\n        Message m = match (read_message(&mut c"
    ".reader))\n        {\n            Ok(msg) : msg,\n            Err(e)  : return Err(broken(c, e)),\n     "
    "   };\n        slice<u8, shared> b = &m.body[0..$];\n        if (m.kind == b'T')\n        {\n           "
    " match (decode_columns(b))\n            {\n                Ok(cols) : overwrite(&mut res.columns, cols"
    "),\n                Err(e)   : return Err(broken(c, e)),\n            }\n        }\n        else if (m.k"
    "ind == b'D')\n        {\n            if (keep && !too_large)\n            {\n                bytes += sl"
    "ice_len(b);\n                if (bytes > c.max_result)\n                {\n                    too_larg"
    "e = true;\n                    Vec::clear(&mut res.rows);\n                }\n                else\n    "
    "            {\n                    match (decode_row(b))\n                    {\n                      "
    "  Ok(row) : Vec::push(&mut res.rows, row),\n                        Err(e)  : return Err(broken(c, e)"
    "),\n                    }\n                }\n            }\n        }\n        else if (m.kind == b'C')\n"
    "        {\n            usize at = 0;\n            String tag = match (cstr_at(b, &mut at))\n           "
    " {\n                Ok(t)  : t,\n                Err(e) : return Err(broken(c, e)),\n            };\n   "
    "         res.affected = tag_count(String::as_view(&tag));\n            overwrite(&mut res.tag, tag);\n"
    "        }\n        else if (m.kind == b'E')\n        {\n            PgServerError reported = match (dec"
    "ode_server_error(b))\n            {\n                Ok(se) : se,\n                Err(e) : return Err("
    "broken(c, e)),\n            };\n            if (Option::is_none(&failure))\n            {\n             "
    "   overwrite(&mut failure, Some(reported));\n            }\n        }\n        else if (m.kind == b'N')"
    "\n        {\n            match (decode_server_error(b))\n            {\n                Ok(se) : Vec::pu"
    "sh(&mut c.notices, se),\n                Err(e) : return Err(broken(c, e)),\n            }\n        }\n "
    "       else if (m.kind == b'Z')\n        {\n            break;\n        }\n        else if (m.kind == b'"
    "1' || m.kind == b'2' || m.kind == b'n' || m.kind == b'I' || m.kind == b's' || m.kind == b'A' || m.ki"
    "nd == b'S')\n        {\n            // ParseComplete, BindComplete, NoData, EmptyQueryResponse,\n      "
    "      // PortalSuspended, a notification, a parameter changed.\n            continue;\n        }\n     "
    "   else\n        {\n            return Err(broken(c, ProtocolViolation));\n        }\n    }\n    if (Some"
    "(e) = failure)\n    {\n        return Err(Server(e));\n    }\n    if (too_large)\n    {\n        return Er"
    "r(ResultTooLarge);\n    }\n    Ok(res)\n}export fn PgConnection::query(\n    ref<PgConnection, exclusive"
    "> c,\n    StringView sql,\n    slice<PgValue, shared> params,\n) : Result<PgResult, PgError>\n{\n    if ("
    "c.closed)\n    {\n        return Err(Disconnected);\n    }\n    if (slice_len(params) > 65535)\n    {\n   "
    "     return Err(ResultTooLarge);\n    }\n    Vec<u8> out = Vec::new();\n    Vec<u8> parse = Vec::new();"
    "\n    push_cstr(&mut parse, \"\");\n    push_cstr(&mut parse, sql);\n    Vec::push_be<u16>(&mut parse, 0)"
    ";\n    Vec::extend_from(&mut out, &frame(b'P', &parse[0..$])[0..$]);\n    Vec<u8> bind = Vec::new();\n "
    "   push_cstr(&mut bind, \"\");\n    push_cstr(&mut bind, \"\");\n    Vec::push_be<u16>(&mut bind, 0);\n    "
    "Vec::push_be(&mut bind, narrow<u16>(slice_len(params)));\n    foreach (p in params)\n    {\n        mat"
    "ch (PgValue::text(p))\n        {\n            Some(t) :\n            {\n                Vec::push_be(&mu"
    "t bind, narrow<u32>(String::len(&t)));\n                Vec::extend_from(&mut bind, StringView::as_by"
    "tes(String::as_view(&t)));\n            },\n            None    : Vec::push_be<i32>(&mut bind, -1),\n  "
    "      }\n    }\n    Vec::push_be<u16>(&mut bind, 0);\n    Vec::extend_from(&mut out, &frame(b'B', &bind"
    "[0..$])[0..$]);\n    Vec<u8> describe = Vec::new();\n    Vec::push(&mut describe, b'P');\n    Vec::push"
    "(&mut describe, 0);\n    Vec::extend_from(&mut out, &frame(b'D', &describe[0..$])[0..$]);\n    Vec<u8>"
    " execute = Vec::new();\n    push_cstr(&mut execute, \"\");\n    Vec::push_be<u32>(&mut execute, 0);\n    "
    "Vec::extend_from(&mut out, &frame(b'E', &execute[0..$])[0..$]);\n    Vec<u8> none = Vec::new();\n    V"
    "ec::extend_from(&mut out, &frame(b'S', &none[0..$])[0..$]);\n    match (pg_write(&mut c.reader.conn, "
    "&out[0..$]))\n    {\n        Ok(_)  : {},\n        Err(e) : return Err(broken(c, e)),\n    }\n    collect"
    "(c, true)\n}export fn PgConnection::execute(\n    ref<PgConnection, exclusive> c,\n    StringView sql,\n"
    "    slice<PgValue, shared> params,\n) : Result<u64, PgError>\n{\n    PgResult r = PgConnection::query(c"
    ", sql, params)?;\n    Ok(r.affected)\n}export fn PgConnection::run_script(ref<PgConnection, exclusive>"
    " c, StringView sql) : Result<void, PgError>\n{\n    if (c.closed)\n    {\n        return Err(Disconnecte"
    "d);\n    }\n    Vec<u8> q = Vec::new();\n    push_cstr(&mut q, sql);\n    match (pg_write(&mut c.reader."
    "conn, &frame(b'Q', &q[0..$])[0..$]))\n    {\n        Ok(_)  : {},\n        Err(e) : return Err(broken(c"
    ", e)),\n    }\n    _ = collect(c, false)?;\n    Ok(())\n}export fn PgConnection::close(ref<PgConnection,"
    " exclusive> c)\n{\n    if (!c.closed)\n    {\n        Vec<u8> none = Vec::new();\n        _ = pg_write(&m"
    "ut c.reader.conn, &frame(b'X', &none[0..$])[0..$]);\n        pg_close(&mut c.reader.conn);\n        c."
    "closed = true;\n    }\n}fn JsonReader::peek(ref<JsonReader, shared> r) : u8\n{\n    if (r.at < StringVie"
    "w::len(r.text))\n    {\n        return r.text.bytes[r.at];\n    }\n    0\n}fn json_space_end(slice<u8, sh"
    "ared> b, usize at) : usize\n{\n    usize i = at;\n    while (i < slice_len(b) && (b[i] == b' ' || b[i] "
    "== b'\\t' || b[i] == b'\\n' || b[i] == b'\\r'))\n    {\n        i += 1;\n    }\n    i\n}fn json_digits_end(s"
    "lice<u8, shared> b, usize at) : usize\n{\n    usize i = at;\n    while (i < slice_len(b) && ascii_is_di"
    "git(b[i]))\n    {\n        i += 1;\n    }\n    i\n}fn JsonReader::skip_space(ref<JsonReader, exclusive> r"
    ")\n{\n    r.at = json_space_end(r.text.bytes, r.at);\n}fn JsonReader::word(ref<JsonReader, exclusive> r"
    ", str word) : bool\n{\n    usize n = str_len(word);\n    if (r.at + n > StringView::len(r.text))\n    {\n"
    "        return false;\n    }\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (r.text.bytes[r.at"
    " + i] != str_byte(word, i))\n        {\n            return false;\n        }\n    }\n    r.at += n;\n    t"
    "rue\n}fn JsonReader::digits(ref<JsonReader, exclusive> r) : usize\n{\n    usize start = r.at;\n    r.at "
    "= json_digits_end(r.text.bytes, r.at);\n    r.at - start\n}fn JsonReader::number(ref<JsonReader, exclu"
    "sive> r) : Result<Json, ParseError>\n{\n    usize start = r.at;\n    if (JsonReader::peek(r) == b'-')\n "
    "   {\n        r.at += 1;\n    }\n    if (JsonReader::peek(r) == b'0')\n    {\n        r.at += 1;\n    }\n  "
    "  else if (JsonReader::digits(r) == 0)\n    {\n        return Err(Invalid(r.at));\n    }\n    if (JsonRe"
    "ader::peek(r) == b'.')\n    {\n        r.at += 1;\n        if (JsonReader::digits(r) == 0)\n        {\n  "
    "          return Err(Invalid(r.at));\n        }\n    }\n    u8 e = JsonReader::peek(r);\n    if (e == b'"
    "e' || e == b'E')\n    {\n        r.at += 1;\n        u8 sign = JsonReader::peek(r);\n        if (sign =="
    " b'+' || sign == b'-')\n        {\n            r.at += 1;\n        }\n        if (JsonReader::digits(r) "
    "== 0)\n        {\n            return Err(Invalid(r.at));\n        }\n    }\n    match (StringView::parse<"
    "f64>(StringView::sub(r.text, start, r.at)))\n    {\n        Ok(v)  : Ok(JsonNumber(v)),\n        Err(_)"
    " : Err(OutOfRange),\n    }\n}fn JsonReader::text(ref<JsonReader, exclusive> r) : Result<String, ParseE"
    "rror>\n{\n    JsonStr { bytes, pos, err } = json_string(r.text.bytes, r.at);\n    r.at = pos;\n    if (e"
    "rr > 0)\n    {\n        return Err(Invalid(err - 1));\n    }\n    // Runs of the (UTF-8) text and encode"
    "d code points: well-formed.\n    match (String::from_utf8(bytes))\n    {\n        Ok(s)  : Ok(s),\n     "
    "   Err(_) : Err(Invalid(pos)),\n    }\n}fn json_hex4(array<u8, 4> q, usize at) : i64\n{\n    i64 v = 0;\n"
    "    for (usize i = 0; i < 4; i += 1)\n    {\n        usize p = at + i;\n        u8 c = q[i];\n        i6"
    "4 d = if (c >= b'0' && c <= b'9') { widen<i64>(c - b'0') }\n        else if (c >= b'a' && c <= b'f') "
    "{ widen<i64>(c - b'a') + 10 }\n        else if (c >= b'A' && c <= b'F') { widen<i64>(c - b'A') + 10 }"
    "\n        else { return -1 - narrow<i64>(p); };\n        v = v * 16 + d;\n    }\n    v\n}fn json_string(s"
    "lice<u8, shared> b, usize start) : JsonStr\n{\n    Vec<u8> out = Vec::new();\n    usize n = slice_len(b"
    ");\n    usize at = start;\n    usize err = 0;\n    while (true)\n    {\n        if (at >= n)\n        {\n  "
    "          err = n + 1;\n            break;\n        }\n        u8 c = b[at];\n        if (c == b'\"')\n   "
    "     {\n            at += 1;\n            break;\n        }\n        if (c < 0x20)\n        {\n           "
    " err = at + 1;\n            break;\n        }\n        if (c != b'\\\\')\n        {\n            Vec::push("
    "&mut out, c);\n            at += 1;\n            continue;\n        }\n        at += 1;\n        u8 e = i"
    "f (at < n) { b[at] } else { 0 };\n        at += 1;\n        if (e == b'\"') { Vec::push(&mut out, b'\"')"
    "; }\n        else if (e == b'\\\\') { Vec::push(&mut out, b'\\\\'); }\n        else if (e == b'/') { Vec::"
    "push(&mut out, b'/'); }\n        else if (e == b'b') { Vec::push(&mut out, 8); }\n        else if (e ="
    "= b'f') { Vec::push(&mut out, 12); }\n        else if (e == b'n') { Vec::push(&mut out, 10); }\n      "
    "  else if (e == b'r') { Vec::push(&mut out, 13); }\n        else if (e == b't') { Vec::push(&mut out,"
    " 9); }\n        else if (e == b'u')\n        {\n            array<u8, 4> q = [0; 4];\n            for (u"
    "size k = 0; k < 4 && at + k < n; k += 1)\n            {\n                q[k] = b[at + k];\n           "
    " }\n            i64 h = json_hex4(q, at);\n            if (h < 0)\n            {\n                err = "
    "narrow<usize>(0 - h);\n                break;\n            }\n            at += 4;\n            u32 cp ="
    " narrow<u32>(h);\n            if (cp >= 0xD800 && cp <= 0xDBFF)\n            {\n                // A hi"
    "gh surrogate: joined with a `\\uDC00`..`\\uDFFF` that\n                // follows; alone, U+FFFD.\n     "
    "           usize save = at;\n                bool joined = false;\n                if (at < n && b[at]"
    " == b'\\\\')\n                {\n                    at += 1;\n                    if (at < n && b[at] =="
    " b'u')\n                    {\n                        at += 1;\n                        array<u8, 4> q"
    "2 = [0; 4];\n                        for (usize k = 0; k < 4 && at + k < n; k += 1)\n                 "
    "       {\n                            q2[k] = b[at + k];\n                        }\n                  "
    "      i64 lo = json_hex4(q2, at);\n                        if (lo < 0)\n                        {\n    "
    "                        err = narrow<usize>(0 - lo);\n                            break;\n            "
    "            }\n                        at += 4;\n                        u32 low = narrow<u32>(lo);\n  "
    "                      if (low >= 0xDC00 && low <= 0xDFFF)\n                        {\n                "
    "            cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00);\n                            joine"
    "d = true;\n                        }\n                    }\n                }\n                if (!joi"
    "ned)\n                {\n                    at = save;\n                    cp = 0xFFFD;\n             "
    "   }\n            }\n            // As `String::push_code_point`: a surrogate is U+FFFD.\n            u"
    "32 u = if (cp >= 0xD800 && cp <= 0xDFFF) { 0xFFFD } else { cp };\n            if (u < 0x80)\n         "
    "   {\n                Vec::push(&mut out, narrow<u8>(u));\n            }\n            else if (u < 0x80"
    "0)\n            {\n                Vec::push(&mut out, 0xC0 | narrow<u8>(u >> 6));\n                Vec"
    "::push(&mut out, 0x80 | narrow<u8>(u & 0x3F));\n            }\n            else if (u < 0x10000)\n     "
    "       {\n                Vec::push(&mut out, 0xE0 | narrow<u8>(u >> 12));\n                Vec::push("
    "&mut out, 0x80 | narrow<u8>((u >> 6) & 0x3F));\n                Vec::push(&mut out, 0x80 | narrow<u8>"
    "(u & 0x3F));\n            }\n            else\n            {\n                Vec::push(&mut out, 0xF0 |"
    " narrow<u8>(u >> 18));\n                Vec::push(&mut out, 0x80 | narrow<u8>((u >> 12) & 0x3F));\n   "
    "             Vec::push(&mut out, 0x80 | narrow<u8>((u >> 6) & 0x3F));\n                Vec::push(&mut"
    " out, 0x80 | narrow<u8>(u & 0x3F));\n            }\n        }\n        else\n        {\n            err ="
    " at;\n            break;\n        }\n    }\n    JsonStr { .bytes = out, .pos = at, .err = err }\n}fn Json"
    "Reader::value(ref<JsonReader, exclusive> r, usize depth) : Result<Json, ParseError>\n{\n    JsonReader"
    "::skip_space(r);\n    u8 b = JsonReader::peek(r);\n    if (b == b'{')\n    {\n        if (depth >= MAX_D"
    "EPTH)\n        {\n            return Err(OutOfRange);\n        }\n        r.at += 1;\n        Vec<JsonMem"
    "ber> members = Vec::new();\n        JsonReader::skip_space(r);\n        if (JsonReader::peek(r) == b'}"
    "')\n        {\n            r.at += 1;\n            return Ok(JsonObject(members));\n        }\n        wh"
    "ile (true)\n        {\n            JsonReader::skip_space(r);\n            if (JsonReader::peek(r) != b"
    "'\"')\n            {\n                return Err(Invalid(r.at));\n            }\n            r.at += 1;\n "
    "           String key = JsonReader::text(r)?;\n            JsonReader::skip_space(r);\n            if "
    "(JsonReader::peek(r) != b':')\n            {\n                return Err(Invalid(r.at));\n            }"
    "\n            r.at += 1;\n            Json v = JsonReader::value(r, depth + 1)?;\n            Vec::push"
    "(&mut members, JsonMember { .key = key, .value = v });\n            JsonReader::skip_space(r);\n      "
    "      u8 c = JsonReader::peek(r);\n            r.at += 1;\n            if (c == b'}')\n            {\n  "
    "              return Ok(JsonObject(members));\n            }\n            if (c != b',')\n            {"
    "\n                return Err(Invalid(r.at - 1));\n            }\n        }\n    }\n    if (b == b'[')\n   "
    " {\n        if (depth >= MAX_DEPTH)\n        {\n            return Err(OutOfRange);\n        }\n        r"
    ".at += 1;\n        Vec<Json> items = Vec::new();\n        JsonReader::skip_space(r);\n        if (JsonR"
    "eader::peek(r) == b']')\n        {\n            r.at += 1;\n            return Ok(JsonArray(items));\n  "
    "      }\n        while (true)\n        {\n            Json v = JsonReader::value(r, depth + 1)?;\n      "
    "      Vec::push(&mut items, v);\n            JsonReader::skip_space(r);\n            u8 c = JsonReader"
    "::peek(r);\n            r.at += 1;\n            if (c == b']')\n            {\n                return Ok"
    "(JsonArray(items));\n            }\n            if (c != b',')\n            {\n                return Er"
    "r(Invalid(r.at - 1));\n            }\n        }\n    }\n    if (b == b'\"')\n    {\n        r.at += 1;\n    "
    "    return Ok(JsonText(JsonReader::text(r)?));\n    }\n    if (b == b'-' || ascii_is_digit(b))\n    {\n "
    "       return JsonReader::number(r);\n    }\n    if (JsonReader::word(r, \"true\"))\n    {\n        return"
    " Ok(JsonBool(true));\n    }\n    if (JsonReader::word(r, \"false\"))\n    {\n        return Ok(JsonBool(fa"
    "lse));\n    }\n    if (JsonReader::word(r, \"null\"))\n    {\n        return Ok(JsonNull);\n    }\n    Err(I"
    "nvalid(r.at))\n}export fn Json::parse(StringView text) : Result<Json, ParseError>\n{\n    JsonReader r "
    "= JsonReader { .text = text, .at = 0 };\n    JsonReader::skip_space(&mut r);\n    if (r.at >= StringVi"
    "ew::len(text))\n    {\n        return Err(Empty);\n    }\n    Json v = JsonReader::value(&mut r, 0)?;\n  "
    "  JsonReader::skip_space(&mut r);\n    if (r.at < StringView::len(text))\n    {\n        return Err(Inv"
    "alid(r.at));\n    }\n    Ok(v)\n}unittest \"Json::parse: where the error is\"\n{\n    match (Json::parse(\"["
    "1, 2\"))\n    {\n        Err(Invalid(i)) : assert(i == 5),\n        _               : assert(false),\n   "
    " }\n    match (Json::parse(\"[1] x\"))\n    {\n        Err(Invalid(i)) : assert(i == 4),\n        _       "
    "        : assert(false),\n    }\n}fn json_quote(ref<String, exclusive> out, StringView s)\n{\n    Vec<u8"
    "> o = replace(&mut out.bytes, Vec::new());\n    overwrite(&mut out.bytes, json_quote_bytes(o, s.bytes"
    "));\n}fn json_quote_bytes(Vec<u8> out, slice<u8, shared> s) : Vec<u8>\n{\n    str digits = \"0123456789a"
    "bcdef\";\n    Vec::push(&mut out, b'\"');\n    for (usize i = 0; i < slice_len(s); i += 1)\n    {\n       "
    " u8 b = s[i];\n        if (b >= 0x20 && b != b'\"' && b != b'\\\\')\n        {\n            Vec::push(&mut"
    " out, b);\n            continue;\n        }\n        Vec::push(&mut out, b'\\\\');\n        if (b == b'\"')"
    " { Vec::push(&mut out, b'\"'); }\n        else if (b == b'\\\\') { Vec::push(&mut out, b'\\\\'); }\n       "
    " else if (b == 10) { Vec::push(&mut out, b'n'); }\n        else if (b == 13) { Vec::push(&mut out, b'"
    "r'); }\n        else if (b == 9) { Vec::push(&mut out, b't'); }\n        else if (b == 8) { Vec::push("
    "&mut out, b'b'); }\n        else if (b == 12) { Vec::push(&mut out, b'f'); }\n        else\n        {\n "
    "           Vec::push(&mut out, b'u');\n            Vec::push(&mut out, b'0');\n            Vec::push(&"
    "mut out, b'0');\n            Vec::push(&mut out, str_byte(digits, widen<usize>(b >> 4)));\n           "
    " Vec::push(&mut out, str_byte(digits, widen<usize>(b & 15)));\n        }\n    }\n    Vec::push(&mut out"
    ", b'\"');\n    out\n}fn json_number(ref<String, exclusive> out, f64 x)\n{\n    if (!is_finite(x))\n    {\n "
    "       String::append(out, \"null\");\n        return;\n    }\n    if (x == trunc(x) && x < 9007199254740"
    "992.0 && x > -9007199254740992.0)\n    {\n        String::append(out, to_int<i64>(x));\n        return;"
    "\n    }\n    String::append(out, x);\n}fn json_indent(ref<String, exclusive> out, usize depth)\n{\n    St"
    "ring::push_ascii(out, 10);\n    for (usize i = 0; i < depth; i += 1)\n    {\n        String::append(out"
    ", \"  \");\n    }\n}fn json_write(ref<String, exclusive> out, ref<Json, shared> j, bool indent, usize de"
    "pth)\n{\n    match (j)\n    {\n        JsonNull            : String::append(out, \"null\"),\n        JsonBo"
    "ol(b)         : String::append(out, if (*b) { \"true\" } else { \"false\" }),\n        JsonNumber(x)     "
    "  : json_number(out, *x),\n        JsonText(s)         : json_quote(out, String::as_view(s)),\n       "
    " JsonArray(items)    :\n        {\n            String::push_ascii(out, b'[');\n            for (usize i"
    " = 0; i < Vec::len(items); i += 1)\n            {\n                if (i > 0)\n                {\n      "
    "              String::push_ascii(out, b',');\n                }\n                if (indent)\n         "
    "       {\n                    json_indent(out, depth + 1);\n                }\n                json_wri"
    "te(out, &items[i], indent, depth + 1);\n            }\n            if (indent && Vec::len(items) > 0)\n"
    "            {\n                json_indent(out, depth);\n            }\n            String::push_ascii("
    "out, b']');\n        },\n        JsonObject(members) :\n        {\n            String::push_ascii(out, b"
    "'{');\n            for (usize i = 0; i < Vec::len(members); i += 1)\n            {\n                if "
    "(i > 0)\n                {\n                    String::push_ascii(out, b',');\n                }\n     "
    "           if (indent)\n                {\n                    json_indent(out, depth + 1);\n          "
    "      }\n                json_quote(out, String::as_view(&members[i].key));\n                String::a"
    "ppend(out, if (indent) { \": \" } else { \":\" });\n                json_write(out, &members[i].value, in"
    "dent, depth + 1);\n            }\n            if (indent && Vec::len(members) > 0)\n            {\n     "
    "           json_indent(out, depth);\n            }\n            String::push_ascii(out, b'}');\n       "
    " },\n    }\n}export fn Json::text(ref<Json, shared> j) : String\n{\n    String out = String::new();\n    "
    "json_write(&mut out, j, false, 0);\n    out\n}export fn Json::pretty(ref<Json, shared> j) : String\n{\n "
    "   String out = String::new();\n    json_write(&mut out, j, true, 0);\n    out\n}unittest \"Json::pretty"
    ": the layout\"\n{\n    Json a = JsonArray(Vec::new());\n    Json::push(&mut a, JsonNull);\n    Json::push"
    "(&mut a, JsonText(String::from_str(\"x\")));\n    String p = Json::pretty(&a);\n    assert(p == \"[\\n  nu"
    "ll,\\n  \\\"x\\\"\\n]\");\n}export fn Json::get(ref<Json, shared> j, StringView key) : Option<ref<Json, shar"
    "ed>>\n{\n    match (j)\n    {\n        JsonObject(members) :\n        {\n            for (usize i = 0; i <"
    " Vec::len(members); i += 1)\n            {\n                if (members[i].key == key)\n               "
    " {\n                    return Some(&members[i].value);\n                }\n            }\n            N"
    "one\n        },\n        _                   : None,\n    }\n}unittest \"Json::get: reading a document\"\n{"
    "\n    Json doc = Result::unwrap(Json::parse(\"{\\\"name\\\": \\\"ok\\\", \\\"n\\\": [1, 2.5]}\"));\n    assert(Optio"
    "n::unwrap(Json::as_text(Option::unwrap(Json::get(&doc, \"name\")))) == \"ok\");\n    auto n = Option::unw"
    "rap(Json::get(&doc, \"n\"));\n    assert(Json::as_i64(Option::unwrap(Json::at(n, 0))) == Some(1: i64));"
    "\n    assert(Json::as_i64(Option::unwrap(Json::at(n, 1))) == None);\n    assert(Option::is_none(&Json:"
    ":get(&doc, \"missing\")));\n}export fn Json::at(ref<Json, shared> j, usize i) : Option<ref<Json, shared"
    ">>\n{\n    match (j)\n    {\n        JsonArray(items) : if (i < Vec::len(items)) { Some(&items[i]) } els"
    "e { None },\n        _                : None,\n    }\n}export fn Json::lookup(ref<Json, shared> j, Stri"
    "ngView path) : Option<ref<Json, shared>>\n{\n    Vec<StringView> parts = StringView::split(path, \".\");"
    "\n    ref<Json, shared> cur = j;\n    for (usize i = 0; i < Vec::len(&parts); i += 1)\n    {\n        cu"
    "r = match (cur)\n        {\n            JsonArray(_) : match (StringView::parse<usize>(parts[i]))\n    "
    "        {\n                Ok(k)  : Json::at(cur, k)?,\n                Err(_) : return None,\n        "
    "    },\n            _ : Json::get(cur, parts[i])?,\n        };\n    }\n    Some(cur)\n}unittest \"Json::lo"
    "okup: a dotted path\"\n{\n    Json doc = Result::unwrap(Json::parse(\"{\\\"servers\\\": [{\\\"host\\\": \\\"a\\\"}, "
    "{\\\"host\\\": \\\"b\\\"}], \\\"n\\\": 1}\"));\n    assert(Option::unwrap(Json::as_text(Option::unwrap(Json::looku"
    "p(&doc, \"servers.1.host\")))) == \"b\");\n    assert(Json::as_i64(Option::unwrap(Json::lookup(&doc, \"n\")"
    ")) == Some(1: i64));\n    assert(Option::is_none(&Json::lookup(&doc, \"servers.2.host\")));\n    assert("
    "Option::is_none(&Json::lookup(&doc, \"servers.x\")));\n}export fn Json::is_null(ref<Json, shared> j) : "
    "bool\n{\n    match (j)\n    {\n        JsonNull : true,\n        _        : false,\n    }\n}export fn Json:"
    ":as_bool(ref<Json, shared> j) : Option<bool>\n{\n    match (j)\n    {\n        JsonBool(b) : Some(*b),\n "
    "       _           : None,\n    }\n}export fn Json::as_f64(ref<Json, shared> j) : Option<f64>\n{\n    ma"
    "tch (j)\n    {\n        JsonNumber(x) : Some(*x),\n        _             : None,\n    }\n}export fn Json:"
    ":as_i64(ref<Json, shared> j) : Option<i64>\n{\n    match (j)\n    {\n        JsonNumber(x) : if (*x == t"
    "runc(*x) && *x >= -9223372036854775808.0 && *x < 9223372036854775808.0) { Some(to_int<i64>(*x)) } el"
    "se { None },\n        _             : None,\n    }\n}export fn Json::as_text(ref<Json, shared> j) : Opt"
    "ion<StringView>\n{\n    match (j)\n    {\n        JsonText(s) : Some(String::as_view(s)),\n        _     "
    "      : None,\n    }\n}export fn Json::as_array(ref<Json, shared> j) : Option<ref<Vec<Json>, shared>>\n"
    "{\n    match (j)\n    {\n        JsonArray(items) : Some(items),\n        _                : None,\n    }"
    "\n}export fn Json::as_object(ref<Json, shared> j) : Option<ref<Vec<JsonMember>, shared>>\n{\n    match "
    "(j)\n    {\n        JsonObject(members) : Some(members),\n        _                   : None,\n    }\n}ex"
    "port fn Json::set(ref<Json, exclusive> j, StringView key, Json v)\n{\n    match (j)\n    {\n        Json"
    "Object(members) :\n        {\n            for (usize i = 0; i < Vec::len(members); i += 1)\n           "
    " {\n                if (members[i].key == key)\n                {\n                    overwrite(&mut m"
    "embers[i].value, v);\n                    return;\n                }\n            }\n            Vec::pu"
    "sh(members, JsonMember { .key = String::from_view(key), .value = v });\n        },\n        _         "
    "          : assert(false, \"Json::set on a value that is not an object\"),\n    }\n}unittest \"Json::set:"
    " a key set twice\"\n{\n    Json doc = JsonObject(Vec::new());\n    Json::set(&mut doc, \"a\", JsonNumber(1"
    ".0));\n    Json::set(&mut doc, \"b\", JsonArray(Vec::new()));\n    Json::set(&mut doc, \"a\", JsonBool(tru"
    "e));\n    String t = Json::text(&doc);\n    assert(t == \"{\\\"a\\\":true,\\\"b\\\":[]}\");\n}export fn Json::pus"
    "h(ref<Json, exclusive> j, Json v)\n{\n    match (j)\n    {\n        JsonArray(items) : Vec::push(items, "
    "v),\n        _                : assert(false, \"Json::push on a value that is not an array\"),\n    }\n}e"
    "xport fn to_hex(slice<u8, shared> bytes) : String\n{\n    str digits = \"0123456789abcdef\";\n    Vec<u8>"
    " out = Vec::new();\n    Vec::reserve(&mut out, slice_len(bytes) * 2);\n    for (usize i = 0; i < slice"
    "_len(bytes); i += 1)\n    {\n        Vec::push(&mut out, str_byte(digits, widen<usize>(bytes[i] >> 4))"
    ");\n        Vec::push(&mut out, str_byte(digits, widen<usize>(bytes[i] & 15)));\n    }\n    String { .b"
    "ytes = out }\n}fn hex_value(u8 b) : u8\n{\n    if (b >= b'0' && b <= b'9')\n    {\n        return b - b'0"
    "';\n    }\n    if (b >= b'a' && b <= b'f')\n    {\n        return b - b'a' + 10;\n    }\n    if (b >= b'A'"
    " && b <= b'F')\n    {\n        return b - b'A' + 10;\n    }\n    255\n}export fn from_hex(StringView text"
    ") : Result<Vec<u8>, ParseError>\n{\n    hex_decode(text.bytes)\n}unittest \"from_hex: either case in, lo"
    "wercase out\"\n{\n    Vec<u8> b = Result::unwrap(from_hex(\"00FFa0\"));\n    assert(Vec::len(&b) == 3);\n  "
    "  assert(b[1] == 255);\n    String h = to_hex(&b[0..$]);\n    assert(h == \"00ffa0\");\n    match (from_h"
    "ex(\"abc\"))\n    {\n        Err(Invalid(i)) : assert(i == 3),\n        _               : assert(false),\n"
    "    }\n}fn hex_decode(slice<u8, shared> b) : Result<Vec<u8>, ParseError>\n{\n    usize n = slice_len(b)"
    ";\n    if (n == 0)\n    {\n        return Err(Empty);\n    }\n    Vec<u8> out = Vec::new();\n    Vec::rese"
    "rve(&mut out, n / 2);\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (hex_value(b[i]) == 255)"
    "\n        {\n            return Err(Invalid(i));\n        }\n    }\n    if (n % 2 != 0)\n    {\n        ret"
    "urn Err(Invalid(n));\n    }\n    for (usize i = 0; i < n; i += 2)\n    {\n        Vec::push(&mut out, (h"
    "ex_value(b[i]) << 4) | hex_value(b[i + 1]));\n    }\n    Ok(out)\n}export fn base64_encode(slice<u8, sh"
    "ared> bytes) : String\n{\n    str alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123"
    "456789+/\";\n    Vec<u8> out = Vec::new();\n    usize n = slice_len(bytes);\n    Vec::reserve(&mut out, "
    "(n + 2) / 3 * 4);\n    usize i = 0;\n    while (i + 3 <= n)\n    {\n        u32 v = (widen<u32>(bytes[i]"
    ") << 16) | (widen<u32>(bytes[i + 1]) << 8) | widen<u32>(bytes[i + 2]);\n        Vec::push(&mut out, s"
    "tr_byte(alphabet, narrow<usize>((v >> 18) & 63)));\n        Vec::push(&mut out, str_byte(alphabet, na"
    "rrow<usize>((v >> 12) & 63)));\n        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 6)"
    " & 63)));\n        Vec::push(&mut out, str_byte(alphabet, narrow<usize>(v & 63)));\n        i += 3;\n  "
    "  }\n    if (n - i == 1)\n    {\n        u32 v = widen<u32>(bytes[i]) << 16;\n        Vec::push(&mut out"
    ", str_byte(alphabet, narrow<usize>((v >> 18) & 63)));\n        Vec::push(&mut out, str_byte(alphabet,"
    " narrow<usize>((v >> 12) & 63)));\n        Vec::push(&mut out, b'=');\n        Vec::push(&mut out, b'="
    "');\n    }\n    else if (n - i == 2)\n    {\n        u32 v = (widen<u32>(bytes[i]) << 16) | (widen<u32>("
    "bytes[i + 1]) << 8);\n        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 18) & 63)));"
    "\n        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 12) & 63)));\n        Vec::push(&"
    "mut out, str_byte(alphabet, narrow<usize>((v >> 6) & 63)));\n        Vec::push(&mut out, b'=');\n    }"
    "\n    String { .bytes = out }\n}fn base64_value(u8 b) : u8\n{\n    if (b >= b'A' && b <= b'Z')\n    {\n   "
    "     return b - b'A';\n    }\n    if (b >= b'a' && b <= b'z')\n    {\n        return b - b'a' + 26;\n    "
    "}\n    if (b >= b'0' && b <= b'9')\n    {\n        return b - b'0' + 52;\n    }\n    if (b == b'+')\n    {"
    "\n        return 62;\n    }\n    if (b == b'/')\n    {\n        return 63;\n    }\n    255\n}export fn base6"
    "4_decode(StringView text) : Result<Vec<u8>, ParseError>\n{\n    base64_decode_bytes(text.bytes)\n}unitt"
    "est \"base64_decode: padding\"\n{\n    StringView text = \"hi!?\";\n    String e = base64_encode(StringView"
    "::as_bytes(text));\n    assert(e == \"aGkhPw==\");\n    Vec<u8> d = Result::unwrap(base64_decode(String:"
    ":as_view(&e)));\n    assert(Vec::len(&d) == 4);\n    match (base64_decode(\"aG=hPw==\"))\n    {\n        E"
    "rr(Invalid(i)) : assert(i == 2),\n        _               : assert(false),\n    }\n    match (base64_de"
    "code(\"QR==\"))\n    {\n        Err(Invalid(i)) : assert(i == 1),\n        _               : assert(false"
    "),\n    }\n}fn base64_decode_bytes(slice<u8, shared> b) : Result<Vec<u8>, ParseError>\n{\n    usize n = "
    "slice_len(b);\n    Vec<u8> out = Vec::new();\n    if (n == 0)\n    {\n        return Ok(Vec::new());\n   "
    " }\n    if (n % 4 != 0)\n    {\n        return Err(Invalid(n));\n    }\n    usize pad = 0;\n    if (b[n - "
    "1] == b'=')\n    {\n        pad = 1;\n        if (b[n - 2] == b'=')\n        {\n            pad = 2;\n    "
    "    }\n    }\n    Vec::reserve(&mut out, n / 4 * 3);\n    for (usize i = 0; i < n; i += 4)\n    {\n      "
    "  u32 v = 0;\n        for (usize j = 0; j < 4; j += 1)\n        {\n            u8 c = b[i + j];\n       "
    "     if (c == b'=' && i + j >= n - pad)\n            {\n                v = v << 6;\n            }\n    "
    "        else\n            {\n                u8 d = base64_value(c);\n                if (d == 255)\n   "
    "             {\n                    return Err(Invalid(i + j));\n                }\n                v ="
    " (v << 6) | widen<u32>(d);\n            }\n        }\n        // D-0232: the bits padding leaves over a"
    "re zero, as `base64_encode`\n        // writes them (RFC 4648 §3.5): one text for each byte string.\n"
    "        if (i + 4 == n && ((pad == 1 && (v & 0xff) != 0) || (pad == 2 && (v & 0xffff) != 0)))\n      "
    "  {\n            return Err(Invalid(n - 1 - pad));\n        }\n        Vec::push(&mut out, narrow_wrapp"
    "ing<u8>(v >> 16));\n        if (i + 4 < n || pad < 2)\n        {\n            Vec::push(&mut out, narro"
    "w_wrapping<u8>(v >> 8));\n        }\n        if (i + 4 < n || pad < 1)\n        {\n            Vec::push"
    "(&mut out, narrow_wrapping<u8>(v));\n        }\n    }\n    Ok(out)\n}fn tnode_new(String key, u8 kind, T"
    "oml leaf) : TNode\n{\n    TNode { .key = key, .kind = kind, .leaf = leaf, .members = Vec::new() }\n}fn "
    "tnode_find(ref<Vec<TNode>, shared> members, StringView key) : Option<usize>\n{\n    for (usize i = 0; "
    "i < Vec::len(members); i += 1)\n    {\n        if (members[i].key == key)\n        {\n            return"
    " Some(i);\n        }\n    }\n    None\n}fn tnode_define(ref<TNode, exclusive> n, ref<Vec<String>, shared"
    "> path, usize i, bool is_array) : bool\n{\n    StringView part = String::as_view(&path[i]);\n    bool l"
    "ast = i + 1 == Vec::len(path);\n    usize k = match (tnode_find(&n.members, part))\n    {\n        Some"
    "(k) : k,\n        None    :\n        {\n            if (last && is_array)\n            {\n               "
    " TNode arr = tnode_new(String::from_view(part), K_ARRAY, TomlBool(false));\n                Vec::push"
    "(&mut arr.members, tnode_new(String::new(), K_HEADER, TomlBool(false)));\n                Vec::push(&"
    "mut n.members, arr);\n                return true;\n            }\n            Vec::push(\n             "
    "   &mut n.members,\n                tnode_new(String::from_view(part), if (last) { K_HEADER } else { "
    "K_IMPLICIT }, TomlBool(false)),\n            );\n            if (last)\n            {\n                r"
    "eturn true;\n            }\n            Vec::len(&n.members) - 1\n        },\n    };\n    u8 kind = n.mem"
    "bers[k].kind;\n    if (kind == K_VALUE)\n    {\n        return false;\n    }\n    if (last)\n    {\n       "
    " if (is_array)\n        {\n            if (kind != K_ARRAY)\n            {\n                return false"
    ";\n            }\n            Vec::push(&mut n.members[k].members, tnode_new(String::new(), K_HEADER, "
    "TomlBool(false)));\n            return true;\n        }\n        if (kind != K_IMPLICIT)\n        {\n    "
    "        return false;\n        }\n        n.members[k].kind = K_HEADER;\n        return true;\n    }\n   "
    " if (kind == K_ARRAY)\n    {\n        usize e = Vec::len(&n.members[k].members) - 1;\n        return tn"
    "ode_define(&mut n.members[k].members[e], path, i + 1, is_array);\n    }\n    tnode_define(&mut n.membe"
    "rs[k], path, i + 1, is_array)\n}fn tnode_insert(\n    ref<TNode, exclusive> n,\n    ref<Vec<String>, sh"
    "ared> ctx,\n    usize ci,\n    ref<Vec<String>, shared> keys,\n    usize ki,\n    Toml v,\n) : bool\n{\n   "
    " if (ci < Vec::len(ctx))\n    {\n        // Down the current table's path, made by its header.\n       "
    " usize k = match (tnode_find(&n.members, String::as_view(&ctx[ci])))\n        {\n            Some(k) :"
    " k,\n            None    : return false,\n        };\n        if (n.members[k].kind == K_ARRAY)\n       "
    " {\n            usize e = Vec::len(&n.members[k].members) - 1;\n            return tnode_insert(&mut n"
    ".members[k].members[e], ctx, ci + 1, keys, ki, v);\n        }\n        return tnode_insert(&mut n.memb"
    "ers[k], ctx, ci + 1, keys, ki, v);\n    }\n    StringView part = String::as_view(&keys[ki]);\n    bool "
    "last = ki + 1 == Vec::len(keys);\n    match (tnode_find(&n.members, part))\n    {\n        Some(k) :\n  "
    "      {\n            if (last)\n            {\n                return false;\n            }\n            "
    "u8 kind = n.members[k].kind;\n            if (kind != K_DOTTED && kind != K_IMPLICIT)\n            {\n "
    "               return false;\n            }\n            n.members[k].kind = K_DOTTED;\n            tno"
    "de_insert(&mut n.members[k], ctx, ci, keys, ki + 1, v)\n        },\n        None    :\n        {\n      "
    "      if (last)\n            {\n                Vec::push(&mut n.members, tnode_new(String::from_view("
    "part), K_VALUE, v));\n                return true;\n            }\n            Vec::push(&mut n.members"
    ", tnode_new(String::from_view(part), K_DOTTED, TomlBool(false)));\n            usize k = Vec::len(&n."
    "members) - 1;\n            tnode_insert(&mut n.members[k], ctx, ci, keys, ki + 1, v)\n        },\n    }"
    "\n}fn tnode_to_toml(TNode n) : Toml\n{\n    TNode { key, kind, leaf, members } = n;\n    drop(key);\n    "
    "if (kind == K_VALUE)\n    {\n        drop(members);\n        return leaf;\n    }\n    drop(leaf);\n    if "
    "(kind == K_ARRAY)\n    {\n        Vec<Toml> items = Vec::new();\n        while (Some(m) = Vec::pop(&mut"
    " members))\n        {\n            Vec::push(&mut items, tnode_to_toml(m));\n        }\n        Vec::rev"
    "erse(&mut items);\n        return TomlArray(items);\n    }\n    Vec<TomlMember> out = Vec::new();\n    w"
    "hile (Some(m) = Vec::pop(&mut members))\n    {\n        String key = clone(&m.key);\n        Vec::push("
    "&mut out, TomlMember { .key = key, .value = tnode_to_toml(m) });\n    }\n    Vec::reverse(&mut out);\n "
    "   TomlTable(out)\n}fn TomlReader::peek(ref<TomlReader, shared> r) : u8\n{\n    if (r.at < StringView::"
    "len(r.text))\n    {\n        return r.text.bytes[r.at];\n    }\n    0\n}fn TomlReader::peek_at(ref<TomlRe"
    "ader, shared> r, usize ahead) : u8\n{\n    if (r.at + ahead < StringView::len(r.text))\n    {\n        r"
    "eturn r.text.bytes[r.at + ahead];\n    }\n    0\n}fn TomlReader::at_end(ref<TomlReader, shared> r) : bo"
    "ol\n{\n    r.at >= StringView::len(r.text)\n}fn TomlReader::skip_ws(ref<TomlReader, exclusive> r)\n{\n   "
    " while (true)\n    {\n        u8 c = TomlReader::peek(r);\n        if (c != b' ' && c != b'\\t')\n       "
    " {\n            return;\n        }\n        r.at += 1;\n    }\n}fn TomlReader::newline(ref<TomlReader, ex"
    "clusive> r) : bool\n{\n    u8 c = TomlReader::peek(r);\n    if (c == b'\\n')\n    {\n        r.at += 1;\n  "
    "      return true;\n    }\n    if (c == b'\\r' && TomlReader::peek_at(r, 1) == b'\\n')\n    {\n        r.a"
    "t += 2;\n        return true;\n    }\n    false\n}fn TomlReader::comment(ref<TomlReader, exclusive> r) :"
    " Result<void, ParseError>\n{\n    r.at += 1;\n    while (!TomlReader::at_end(r))\n    {\n        u8 c = T"
    "omlReader::peek(r);\n        if (c == b'\\n' || (c == b'\\r' && TomlReader::peek_at(r, 1) == b'\\n'))\n  "
    "      {\n            return Ok(());\n        }\n        if ((c < 0x20 && c != b'\\t') || c == 0x7F)\n    "
    "    {\n            return Err(Invalid(r.at));\n        }\n        r.at += 1;\n    }\n    Ok(())\n}fn TomlR"
    "eader::line_end(ref<TomlReader, exclusive> r) : Result<void, ParseError>\n{\n    TomlReader::skip_ws(r"
    ");\n    if (TomlReader::peek(r) == b'#')\n    {\n        TomlReader::comment(r)?;\n    }\n    if (TomlRea"
    "der::at_end(r) || TomlReader::newline(r))\n    {\n        return Ok(());\n    }\n    Err(Invalid(r.at))\n"
    "}fn TomlReader::skip_space_lines(ref<TomlReader, exclusive> r) : Result<void, ParseError>\n{\n    whil"
    "e (true)\n    {\n        TomlReader::skip_ws(r);\n        u8 c = TomlReader::peek(r);\n        if (c == "
    "b'#')\n        {\n            TomlReader::comment(r)?;\n            continue;\n        }\n        if (!To"
    "mlReader::newline(r))\n        {\n            return Ok(());\n        }\n    }\n}fn toml_is_bare(u8 c) : "
    "bool\n{\n    ascii_is_alnum(c) || c == b'_' || c == b'-'\n}fn toml_hex_digit(u8 c) : i64\n{\n    if (c >="
    " b'0' && c <= b'9') { widen<i64>(c - b'0') }\n    else if (c >= b'a' && c <= b'f') { widen<i64>(c - b"
    "'a') + 10 }\n    else if (c >= b'A' && c <= b'F') { widen<i64>(c - b'A') + 10 }\n    else { -1 }\n}fn T"
    "omlReader::unicode_escape(\n    ref<TomlReader, exclusive> r,\n    usize n,\n    ref<String, exclusive>"
    " out,\n) : Result<void, ParseError>\n{\n    i64 v = 0;\n    for (usize i = 0; i < n; i += 1)\n    {\n     "
    "   i64 d = toml_hex_digit(TomlReader::peek(r));\n        if (d < 0)\n        {\n            return Err("
    "Invalid(r.at));\n        }\n        v = v * 16 + d;\n        r.at += 1;\n    }\n    if ((v >= 0xD800 && v"
    " <= 0xDFFF) || v > 0x10FFFF)\n    {\n        return Err(Invalid(r.at - n));\n    }\n    String::push_cod"
    "e_point(out, narrow<u32>(v));\n    Ok(())\n}fn TomlReader::basic(ref<TomlReader, exclusive> r, bool mu"
    "lti) : Result<String, ParseError>\n{\n    String out = String::new();\n    if (multi)\n    {\n        // "
    "A newline right after the opening delimiter is not part of the text.\n        TomlReader::newline(r);"
    "\n    }\n    while (true)\n    {\n        if (TomlReader::at_end(r))\n        {\n            return Err(In"
    "valid(r.at));\n        }\n        u8 c = TomlReader::peek(r);\n        if (c == b'\"')\n        {\n       "
    "     if (!multi)\n            {\n                r.at += 1;\n                return Ok(out);\n          "
    "  }\n            // The closing `\"\"\"`, with up to two more quotes before it as text.\n            usiz"
    "e run = 0;\n            while (TomlReader::peek_at(r, run) == b'\"')\n            {\n                run"
    " += 1;\n            }\n            if (run < 3)\n            {\n                for (usize i = 0; i < ru"
    "n; i += 1)\n                {\n                    String::push_ascii(&mut out, b'\"');\n               "
    " }\n                r.at += run;\n                continue;\n            }\n            if (run > 5)\n   "
    "         {\n                return Err(Invalid(r.at + 5));\n            }\n            for (usize i = 3"
    "; i < run; i += 1)\n            {\n                String::push_ascii(&mut out, b'\"');\n            }\n "
    "           r.at += run;\n            return Ok(out);\n        }\n        if (c == b'\\\\')\n        {\n    "
    "        r.at += 1;\n            u8 e = TomlReader::peek(r);\n            if (e == b'\"') { String::push"
    "_ascii(&mut out, b'\"'); }\n            else if (e == b'\\\\') { String::push_ascii(&mut out, b'\\\\'); }\n"
    "            else if (e == b'b') { String::push_ascii(&mut out, 8); }\n            else if (e == b't')"
    " { String::push_ascii(&mut out, 9); }\n            else if (e == b'n') { String::push_ascii(&mut out,"
    " 10); }\n            else if (e == b'f') { String::push_ascii(&mut out, 12); }\n            else if (e"
    " == b'r') { String::push_ascii(&mut out, 13); }\n            else if (e == b'u' || e == b'U')\n       "
    "     {\n                r.at += 1;\n                TomlReader::unicode_escape(r, if (e == b'u') { 4 }"
    " else { 8 }, &mut out)?;\n                continue;\n            }\n            else if (multi && (e =="
    " b' ' || e == b'\\t' || e == b'\\n' || e == b'\\r'))\n            {\n                // A line-ending bac"
    "kslash: the whitespace and newlines up to\n                // the next text are dropped; a newline mu"
    "st be among them.\n                usize save = r.at;\n                TomlReader::skip_ws(r);\n       "
    "         if (!TomlReader::newline(r))\n                {\n                    return Err(Invalid(save)"
    ");\n                }\n                while (true)\n                {\n                    TomlReader::"
    "skip_ws(r);\n                    if (!TomlReader::newline(r))\n                    {\n                 "
    "       break;\n                    }\n                }\n                continue;\n            }\n      "
    "      else\n            {\n                return Err(Invalid(r.at));\n            }\n            r.at +"
    "= 1;\n            continue;\n        }\n        if (c == b'\\n' || c == b'\\r')\n        {\n            if "
    "(!multi)\n            {\n                return Err(Invalid(r.at));\n            }\n            if (c =="
    " b'\\r')\n            {\n                if (TomlReader::peek_at(r, 1) != b'\\n')\n                {\n    "
    "                return Err(Invalid(r.at));\n                }\n                String::push_ascii(&mut"
    " out, b'\\r');\n                r.at += 1;\n            }\n            String::push_ascii(&mut out, b'\\n"
    "');\n            r.at += 1;\n            continue;\n        }\n        if ((c < 0x20 && c != b'\\t') || c"
    " == 0x7F)\n        {\n            return Err(Invalid(r.at));\n        }\n        // Any other byte, of a"
    " multi-byte character too: the text is UTF-8\n        // and every byte the format treats apart is AS"
    "CII, so a character's\n        // bytes are copied whole.\n        Vec::push(&mut out.bytes, c);\n     "
    "   r.at += 1;\n    }\n}fn TomlReader::literal(ref<TomlReader, exclusive> r, bool multi) : Result<Strin"
    "g, ParseError>\n{\n    String out = String::new();\n    if (multi)\n    {\n        TomlReader::newline(r)"
    ";\n    }\n    while (true)\n    {\n        if (TomlReader::at_end(r))\n        {\n            return Err(I"
    "nvalid(r.at));\n        }\n        u8 c = TomlReader::peek(r);\n        if (c == b'\\'')\n        {\n     "
    "       if (!multi)\n            {\n                r.at += 1;\n                return Ok(out);\n        "
    "    }\n            usize run = 0;\n            while (TomlReader::peek_at(r, run) == b'\\'')\n          "
    "  {\n                run += 1;\n            }\n            if (run < 3)\n            {\n                f"
    "or (usize i = 0; i < run; i += 1)\n                {\n                    String::push_ascii(&mut out,"
    " b'\\'');\n                }\n                r.at += run;\n                continue;\n            }\n    "
    "        if (run > 5)\n            {\n                return Err(Invalid(r.at + 5));\n            }\n    "
    "        for (usize i = 3; i < run; i += 1)\n            {\n                String::push_ascii(&mut out"
    ", b'\\'');\n            }\n            r.at += run;\n            return Ok(out);\n        }\n        if (c"
    " == b'\\n' || c == b'\\r')\n        {\n            if (!multi)\n            {\n                return Err("
    "Invalid(r.at));\n            }\n            if (c == b'\\r')\n            {\n                if (TomlRead"
    "er::peek_at(r, 1) != b'\\n')\n                {\n                    return Err(Invalid(r.at));\n       "
    "         }\n                String::push_ascii(&mut out, b'\\r');\n                r.at += 1;\n         "
    "   }\n            String::push_ascii(&mut out, b'\\n');\n            r.at += 1;\n            continue;\n "
    "       }\n        if ((c < 0x20 && c != b'\\t') || c == 0x7F)\n        {\n            return Err(Invalid"
    "(r.at));\n        }\n        // Any other byte, of a multi-byte character too: the text is UTF-8\n     "
    "   // and every byte the format treats apart is ASCII, so a character's\n        // bytes are copied "
    "whole.\n        Vec::push(&mut out.bytes, c);\n        r.at += 1;\n    }\n}fn TomlReader::key_part(ref<T"
    "omlReader, exclusive> r) : Result<String, ParseError>\n{\n    u8 c = TomlReader::peek(r);\n    if (c =="
    " b'\"')\n    {\n        r.at += 1;\n        if (TomlReader::peek(r) == b'\"' && TomlReader::peek_at(r, 1)"
    " == b'\"')\n        {\n            return Err(Invalid(r.at));\n        }\n        return TomlReader::basi"
    "c(r, false);\n    }\n    if (c == b'\\'')\n    {\n        r.at += 1;\n        if (TomlReader::peek(r) == b"
    "'\\'' && TomlReader::peek_at(r, 1) == b'\\'')\n        {\n            return Err(Invalid(r.at));\n       "
    " }\n        return TomlReader::literal(r, false);\n    }\n    usize start = r.at;\n    while (toml_is_ba"
    "re(TomlReader::peek(r)))\n    {\n        r.at += 1;\n    }\n    if (r.at == start)\n    {\n        return "
    "Err(Invalid(r.at));\n    }\n    Ok(String::from_view(StringView::sub(r.text, start, r.at)))\n}fn TomlRe"
    "ader::key(ref<TomlReader, exclusive> r) : Result<Vec<String>, ParseError>\n{\n    Vec<String> parts = "
    "Vec::new();\n    while (true)\n    {\n        Vec::push(&mut parts, TomlReader::key_part(r)?);\n        "
    "TomlReader::skip_ws(r);\n        if (TomlReader::peek(r) != b'.')\n        {\n            return Ok(par"
    "ts);\n        }\n        r.at += 1;\n        TomlReader::skip_ws(r);\n    }\n}fn TomlReader::digits(ref<T"
    "omlReader, exclusive> r, ref<String, exclusive> out) : Result<usize, ParseError>\n{\n    usize count ="
    " 0;\n    while (true)\n    {\n        u8 c = TomlReader::peek(r);\n        if (ascii_is_digit(c))\n      "
    "  {\n            String::push_ascii(out, c);\n            count += 1;\n            r.at += 1;\n         "
    "   continue;\n        }\n        if (c == b'_' && count > 0 && ascii_is_digit(TomlReader::peek_at(r, 1"
    ")))\n        {\n            r.at += 1;\n            continue;\n        }\n        if (c == b'_')\n        "
    "{\n            return Err(Invalid(r.at));\n        }\n        return Ok(count);\n    }\n}fn TomlReader::p"
    "refixed(ref<TomlReader, exclusive> r, i64 base) : Result<Toml, ParseError>\n{\n    i64 v = 0;\n    usiz"
    "e count = 0;\n    while (true)\n    {\n        u8 c = TomlReader::peek(r);\n        i64 d = toml_hex_dig"
    "it(c);\n        if (d >= 0 && d < base)\n        {\n            match (checked_mul(v, base))\n          "
    "  {\n                Some(m) : match (checked_add(m, d))\n                {\n                    Some(s"
    ") : v = s,\n                    None    : return Err(OutOfRange),\n                },\n                "
    "None : return Err(OutOfRange),\n            }\n            count += 1;\n            r.at += 1;\n        "
    "    continue;\n        }\n        if (c == b'_' && count > 0)\n        {\n            i64 next = toml_he"
    "x_digit(TomlReader::peek_at(r, 1));\n            if (next >= 0 && next < base)\n            {\n        "
    "        r.at += 1;\n                continue;\n            }\n        }\n        if (count == 0 || c == "
    "b'_')\n        {\n            return Err(Invalid(r.at));\n        }\n        return Ok(TomlInteger(v));\n"
    "    }\n}fn TomlReader::number(ref<TomlReader, exclusive> r) : Result<Toml, ParseError>\n{\n    String t"
    "ext = String::new();\n    u8 c = TomlReader::peek(r);\n    bool negative = false;\n    bool signed = fa"
    "lse;\n    if (c == b'+' || c == b'-')\n    {\n        negative = c == b'-';\n        signed = true;\n    "
    "    if (negative)\n        {\n            String::push_ascii(&mut text, b'-');\n        }\n        r.at "
    "+= 1;\n        c = TomlReader::peek(r);\n    }\n    if (c == b'i' || c == b'n')\n    {\n        bool inf "
    "= TomlReader::word(r, \"inf\");\n        if (!inf && !TomlReader::word(r, \"nan\"))\n        {\n           "
    " return Err(Invalid(r.at));\n        }\n        f64 x = if (inf) { 1.0 / 0.0 } else { 0.0 / 0.0 };\n   "
    "     return Ok(TomlFloat(if (negative) { 0.0 - x } else { x }));\n    }\n    if (c == b'0' && !signed)"
    "\n    {\n        u8 p = TomlReader::peek_at(r, 1);\n        if (p == b'x' || p == b'o' || p == b'b')\n  "
    "      {\n            r.at += 2;\n            return TomlReader::prefixed(r, if (p == b'x') { 16 } else"
    " if (p == b'o') { 8 } else { 2 });\n        }\n    }\n    usize start = r.at;\n    usize n = TomlReader:"
    ":digits(r, &mut text)?;\n    if (n == 0)\n    {\n        return Err(Invalid(r.at));\n    }\n    if (n > 1"
    " && r.text.bytes[start] == b'0')\n    {\n        return Err(Invalid(start + 1));\n    }\n    bool float "
    "= false;\n    if (TomlReader::peek(r) == b'.')\n    {\n        float = true;\n        String::push_ascii"
    "(&mut text, b'.');\n        r.at += 1;\n        if (!ascii_is_digit(TomlReader::peek(r)))\n        {\n  "
    "          return Err(Invalid(r.at));\n        }\n        TomlReader::digits(r, &mut text)?;\n    }\n    "
    "c = TomlReader::peek(r);\n    if (c == b'e' || c == b'E')\n    {\n        float = true;\n        String:"
    ":push_ascii(&mut text, b'e');\n        r.at += 1;\n        c = TomlReader::peek(r);\n        if (c == b"
    "'+' || c == b'-')\n        {\n            String::push_ascii(&mut text, c);\n            r.at += 1;\n   "
    "     }\n        if (!ascii_is_digit(TomlReader::peek(r)))\n        {\n            return Err(Invalid(r."
    "at));\n        }\n        TomlReader::digits(r, &mut text)?;\n    }\n    if (float)\n    {\n        return"
    " match (StringView::parse<f64>(String::as_view(&text)))\n        {\n            Ok(x)  : Ok(TomlFloat("
    "x)),\n            Err(_) : Err(OutOfRange),\n        };\n    }\n    match (StringView::parse<i64>(String"
    "::as_view(&text)))\n    {\n        Ok(i)  : Ok(TomlInteger(i)),\n        Err(_) : Err(OutOfRange),\n    "
    "}\n}fn TomlReader::fixed(ref<TomlReader, exclusive> r, usize n) : i64\n{\n    i64 v = 0;\n    for (usize"
    " i = 0; i < n; i += 1)\n    {\n        u8 c = TomlReader::peek_at(r, i);\n        if (!ascii_is_digit(c"
    "))\n        {\n            return -1;\n        }\n        v = v * 10 + widen<i64>(c - b'0');\n    }\n    r"
    ".at += n;\n    v\n}fn toml_days_in_month(i64 year, i64 month) : i64\n{\n    if (month == 2)\n    {\n      "
    "  bool leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;\n        return if (leap) { 29 }"
    " else { 28 };\n    }\n    if (month == 4 || month == 6 || month == 9 || month == 11) { 30 } else { 31 "
    "}\n}fn TomlReader::time_part(ref<TomlReader, exclusive> r, ref<TomlDateTime, exclusive> d) : Result<v"
    "oid, ParseError>\n{\n    usize at = r.at;\n    i64 hour = TomlReader::fixed(r, 2);\n    if (hour < 0 || "
    "TomlReader::peek(r) != b':')\n    {\n        return Err(Invalid(r.at));\n    }\n    r.at += 1;\n    i64 m"
    "inute = TomlReader::fixed(r, 2);\n    if (minute < 0 || TomlReader::peek(r) != b':')\n    {\n        re"
    "turn Err(Invalid(r.at));\n    }\n    r.at += 1;\n    i64 second = TomlReader::fixed(r, 2);\n    if (seco"
    "nd < 0)\n    {\n        return Err(Invalid(r.at));\n    }\n    if (hour > 23 || minute > 59 || second > "
    "60)\n    {\n        return Err(Invalid(at));\n    }\n    d.hour = narrow<u8>(hour);\n    d.minute = narro"
    "w<u8>(minute);\n    d.second = narrow<u8>(second);\n    if (TomlReader::peek(r) == b'.')\n    {\n       "
    " r.at += 1;\n        if (!ascii_is_digit(TomlReader::peek(r)))\n        {\n            return Err(Inval"
    "id(r.at));\n        }\n        u32 nanos = 0;\n        usize digits = 0;\n        while (ascii_is_digit("
    "TomlReader::peek(r)))\n        {\n            if (digits < 9)\n            {\n                nanos = na"
    "nos * 10 + widen<u32>(TomlReader::peek(r) - b'0');\n            }\n            digits += 1;\n          "
    "  r.at += 1;\n        }\n        while (digits < 9)\n        {\n            nanos = nanos * 10;\n        "
    "    digits += 1;\n        }\n        d.nanoseconds = nanos;\n    }\n    Ok(())\n}fn TomlReader::datetime("
    "ref<TomlReader, exclusive> r, bool has_date) : Result<Toml, ParseError>\n{\n    TomlDateTime d = TomlD"
    "ateTime {\n        .kind = TomlLocalTime,\n        .year = 0,\n        .month = 0,\n        .day = 0,\n  "
    "      .hour = 0,\n        .minute = 0,\n        .second = 0,\n        .nanoseconds = 0,\n        .offset"
    "_minutes = 0,\n    };\n    if (!has_date)\n    {\n        TomlReader::time_part(r, &mut d)?;\n        ret"
    "urn Ok(TomlDateTime(d));\n    }\n    usize start = r.at;\n    i64 year = TomlReader::fixed(r, 4);\n    i"
    "f (year < 0 || TomlReader::peek(r) != b'-')\n    {\n        return Err(Invalid(r.at));\n    }\n    r.at "
    "+= 1;\n    i64 month = TomlReader::fixed(r, 2);\n    if (month < 0 || TomlReader::peek(r) != b'-')\n   "
    " {\n        return Err(Invalid(r.at));\n    }\n    r.at += 1;\n    i64 day = TomlReader::fixed(r, 2);\n  "
    "  if (day < 0)\n    {\n        return Err(Invalid(r.at));\n    }\n    if (month < 1 || month > 12 || day"
    " < 1 || day > toml_days_in_month(year, month))\n    {\n        return Err(Invalid(start));\n    }\n    d"
    ".year = year;\n    d.month = narrow<u8>(month);\n    d.day = narrow<u8>(day);\n    d.kind = TomlLocalDa"
    "te;\n    u8 c = TomlReader::peek(r);\n    if (c == b'T' || c == b't' || (c == b' ' && ascii_is_digit(T"
    "omlReader::peek_at(r, 1))))\n    {\n        r.at += 1;\n        TomlReader::time_part(r, &mut d)?;\n    "
    "    d.kind = TomlLocalDateTime;\n        c = TomlReader::peek(r);\n        if (c == b'Z' || c == b'z')"
    "\n        {\n            r.at += 1;\n            d.kind = TomlOffsetDateTime;\n        }\n        else if"
    " (c == b'+' || c == b'-')\n        {\n            usize at = r.at;\n            r.at += 1;\n            "
    "i64 oh = TomlReader::fixed(r, 2);\n            if (oh < 0 || TomlReader::peek(r) != b':')\n           "
    " {\n                return Err(Invalid(r.at));\n            }\n            r.at += 1;\n            i64 o"
    "m = TomlReader::fixed(r, 2);\n            if (om < 0)\n            {\n                return Err(Invali"
    "d(r.at));\n            }\n            if (oh > 23 || om > 59)\n            {\n                return Err"
    "(Invalid(at));\n            }\n            i64 minutes = oh * 60 + om;\n            d.offset_minutes = "
    "narrow<i32>(if (c == b'-') { 0 - minutes } else { minutes });\n            d.kind = TomlOffsetDateTim"
    "e;\n        }\n    }\n    Ok(TomlDateTime(d))\n}fn TomlReader::date_ahead(ref<TomlReader, shared> r) : b"
    "ool\n{\n    for (usize i = 0; i < 4; i += 1)\n    {\n        if (!ascii_is_digit(TomlReader::peek_at(r, "
    "i)))\n        {\n            return false;\n        }\n    }\n    TomlReader::peek_at(r, 4) == b'-'\n}fn T"
    "omlReader::time_ahead(ref<TomlReader, shared> r) : bool\n{\n    ascii_is_digit(TomlReader::peek(r)) &&"
    " ascii_is_digit(TomlReader::peek_at(\n        r,\n        1,\n    )) && TomlReader::peek_at(r, 2) == b'"
    ":'\n}fn TomlReader::word(ref<TomlReader, exclusive> r, str word) : bool\n{\n    usize n = str_len(word)"
    ";\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (TomlReader::peek_at(r, i) != str_byte(word,"
    " i))\n        {\n            return false;\n        }\n    }\n    r.at += n;\n    true\n}fn TomlReader::inl"
    "ine_table(ref<TomlReader, exclusive> r, usize depth) : Result<Toml, ParseError>\n{\n    TNode table = "
    "tnode_new(String::new(), K_HEADER, TomlBool(false));\n    Vec<String> ctx = Vec::new();\n    TomlReade"
    "r::skip_ws(r);\n    if (TomlReader::peek(r) == b'}')\n    {\n        r.at += 1;\n        return Ok(tnode"
    "_to_toml(table));\n    }\n    while (true)\n    {\n        TomlReader::skip_ws(r);\n        usize key_at "
    "= r.at;\n        Vec<String> keys = TomlReader::key(r)?;\n        if (TomlReader::peek(r) != b'=')\n   "
    "     {\n            return Err(Invalid(r.at));\n        }\n        r.at += 1;\n        TomlReader::skip_"
    "ws(r);\n        Toml v = TomlReader::value(r, depth + 1)?;\n        if (!tnode_insert(&mut table, &ctx"
    ", 0, &keys, 0, v))\n        {\n            return Err(Invalid(key_at));\n        }\n        TomlReader::"
    "skip_ws(r);\n        u8 c = TomlReader::peek(r);\n        r.at += 1;\n        if (c == b'}')\n        {\n"
    "            return Ok(tnode_to_toml(table));\n        }\n        if (c != b',')\n        {\n            "
    "return Err(Invalid(r.at - 1));\n        }\n    }\n}fn TomlReader::array_value(ref<TomlReader, exclusive"
    "> r, usize depth) : Result<Toml, ParseError>\n{\n    Vec<Toml> items = Vec::new();\n    while (true)\n  "
    "  {\n        TomlReader::skip_space_lines(r)?;\n        if (TomlReader::peek(r) == b']')\n        {\n   "
    "         r.at += 1;\n            return Ok(TomlArray(items));\n        }\n        Toml v = TomlReader::"
    "value(r, depth + 1)?;\n        Vec::push(&mut items, v);\n        TomlReader::skip_space_lines(r)?;\n  "
    "      u8 c = TomlReader::peek(r);\n        if (c == b']')\n        {\n            r.at += 1;\n          "
    "  return Ok(TomlArray(items));\n        }\n        if (c != b',')\n        {\n            return Err(Inv"
    "alid(r.at));\n        }\n        r.at += 1;\n    }\n}fn TomlReader::value(ref<TomlReader, exclusive> r, "
    "usize depth) : Result<Toml, ParseError>\n{\n    u8 c = TomlReader::peek(r);\n    if (c == b'\"')\n    {\n "
    "       r.at += 1;\n        if (TomlReader::peek(r) == b'\"' && TomlReader::peek_at(r, 1) == b'\"')\n    "
    "    {\n            r.at += 2;\n            return Ok(TomlString(TomlReader::basic(r, true)?));\n       "
    " }\n        return Ok(TomlString(TomlReader::basic(r, false)?));\n    }\n    if (c == b'\\'')\n    {\n    "
    "    r.at += 1;\n        if (TomlReader::peek(r) == b'\\'' && TomlReader::peek_at(r, 1) == b'\\'')\n     "
    "   {\n            r.at += 2;\n            return Ok(TomlString(TomlReader::literal(r, true)?));\n      "
    "  }\n        return Ok(TomlString(TomlReader::literal(r, false)?));\n    }\n    if (c == b'[' || c == b"
    "'{')\n    {\n        if (depth >= TOML_MAX_DEPTH)\n        {\n            return Err(OutOfRange);\n      "
    "  }\n        r.at += 1;\n        return if (c == b'[') { TomlReader::array_value(r, depth) } else { To"
    "mlReader::inline_table(r, depth) };\n    }\n    if (TomlReader::word(r, \"true\"))\n    {\n        return "
    "Ok(TomlBool(true));\n    }\n    if (TomlReader::word(r, \"false\"))\n    {\n        return Ok(TomlBool(fal"
    "se));\n    }\n    if (TomlReader::date_ahead(r))\n    {\n        return TomlReader::datetime(r, true);\n "
    "   }\n    if (TomlReader::time_ahead(r))\n    {\n        return TomlReader::datetime(r, false);\n    }\n "
    "   if (c == b'+' || c == b'-' || c == b'i' || c == b'n' || ascii_is_digit(c))\n    {\n        return T"
    "omlReader::number(r);\n    }\n    Err(Invalid(r.at))\n}export fn Toml::parse(StringView text) : Result<"
    "Toml, ParseError>\n{\n    TomlReader r = TomlReader { .text = text, .at = 0 };\n    TNode root = tnode_"
    "new(String::new(), K_HEADER, TomlBool(false));\n    Vec<String> ctx = Vec::new();\n    while (true)\n  "
    "  {\n        TomlReader::skip_ws(&mut r);\n        if (TomlReader::at_end(&r))\n        {\n            b"
    "reak;\n        }\n        u8 c = TomlReader::peek(&r);\n        if (c == b'#')\n        {\n            To"
    "mlReader::comment(&mut r)?;\n            continue;\n        }\n        if (TomlReader::newline(&mut r))"
    "\n        {\n            continue;\n        }\n        if (c == b'[')\n        {\n            r.at += 1;\n "
    "           bool is_array = TomlReader::peek(&r) == b'[';\n            if (is_array)\n            {\n   "
    "             r.at += 1;\n            }\n            TomlReader::skip_ws(&mut r);\n            usize key"
    "_at = r.at;\n            Vec<String> parts = TomlReader::key(&mut r)?;\n            if (TomlReader::pe"
    "ek(&r) != b']' || (is_array && TomlReader::peek_at(&r, 1) != b']'))\n            {\n                re"
    "turn Err(Invalid(r.at));\n            }\n            r.at += if (is_array) { 2 } else { 1 };\n         "
    "   if (!tnode_define(&mut root, &parts, 0, is_array))\n            {\n                return Err(Inval"
    "id(key_at));\n            }\n            overwrite(&mut ctx, parts);\n            TomlReader::line_end("
    "&mut r)?;\n            continue;\n        }\n        usize key_at = r.at;\n        Vec<String> keys = To"
    "mlReader::key(&mut r)?;\n        if (TomlReader::peek(&r) != b'=')\n        {\n            return Err(I"
    "nvalid(r.at));\n        }\n        r.at += 1;\n        TomlReader::skip_ws(&mut r);\n        Toml v = To"
    "mlReader::value(&mut r, 0)?;\n        if (!tnode_insert(&mut root, &ctx, 0, &keys, 0, v))\n        {\n "
    "           return Err(Invalid(key_at));\n        }\n        TomlReader::line_end(&mut r)?;\n    }\n    O"
    "k(tnode_to_toml(root))\n}unittest \"Toml::parse: a configuration file\"\n{\n    Toml doc = Result::unwrap"
    "(Toml::parse(\"title = \\\"Example\\\"\\n[owner]\\nname = \\\"Tom\\\"\\ndob = 1979-05-27T07:32:00-08:00\\n[databa"
    "se]\\nports = [ 8001, 8001, 8002 ]\\nenabled = true\\ntemp_targets = { cpu = 79.5, case = 72.0 }\\n[[ser"
    "vers]]\\nip = \\\"10.0.0.1\\\"\\n[[servers]]\\nip = \\\"10.0.0.2\\\"\\n\"));\n    assert(Option::unwrap(Toml::as_t"
    "ext(Option::unwrap(Toml::lookup(&doc, \"owner.name\")))) == \"Tom\");\n    assert(Toml::as_i64(Option::un"
    "wrap(Toml::lookup(&doc, \"database.ports.2\"))) == Some(8002: i64));\n    assert(Toml::as_f64(Option::u"
    "nwrap(Toml::lookup(&doc, \"database.temp_targets.cpu\"))) == Some(79.5));\n    assert(Option::unwrap(To"
    "ml::as_text(Option::unwrap(Toml::lookup(&doc, \"servers.1.ip\")))) == \"10.0.0.2\");\n    TomlDateTime do"
    "b = Option::unwrap(Toml::as_datetime(Option::unwrap(Toml::lookup(&doc, \"owner.dob\"))));\n    assert(d"
    "ob.year == 1979 && dob.hour == 7 && dob.offset_minutes == -480);\n}unittest \"Toml::parse: where the e"
    "rror is\"\n{\n    match (Toml::parse(\"a = 1\\nb = \\n\"))\n    {\n        Err(Invalid(i)) : assert(i == 10),"
    "\n        _               : assert(false),\n    }\n    match (Toml::parse(\"a = 1\\na = 2\\n\"))\n    {\n    "
    "    Err(Invalid(i)) : assert(i == 6),\n        _               : assert(false),\n    }\n    match (Toml"
    "::parse(\"n = 9223372036854775808\"))\n    {\n        Err(OutOfRange) : {},\n        _               : as"
    "sert(false),\n    }\n}fn toml_quote(ref<String, exclusive> out, StringView s)\n{\n    str digits = \"0123"
    "456789ABCDEF\";\n    String::push_ascii(out, b'\"');\n    for (usize i = 0; i < StringView::len(s); i +="
    " 1)\n    {\n        u8 b = s.bytes[i];\n        if (b >= 0x20 && b != b'\"' && b != b'\\\\' && b != 0x7F)\n"
    "        {\n            Vec::push(&mut out.bytes, b);          // a multi-byte character's bytes, whol"
    "e\n            continue;\n        }\n        String::push_ascii(out, b'\\\\');\n        if (b == b'\"') { S"
    "tring::push_ascii(out, b'\"'); }\n        else if (b == b'\\\\') { String::push_ascii(out, b'\\\\'); }\n   "
    "     else if (b == 10) { String::push_ascii(out, b'n'); }\n        else if (b == 13) { String::push_a"
    "scii(out, b'r'); }\n        else if (b == 9) { String::push_ascii(out, b't'); }\n        else if (b =="
    " 8) { String::push_ascii(out, b'b'); }\n        else if (b == 12) { String::push_ascii(out, b'f'); }\n"
    "        else\n        {\n            String::append(out, \"u00\");\n            String::push_ascii(out, s"
    "tr_byte(digits, widen<usize>(b >> 4)));\n            String::push_ascii(out, str_byte(digits, widen<u"
    "size>(b & 15)));\n        }\n    }\n    String::push_ascii(out, b'\"');\n}fn toml_key(ref<String, exclusi"
    "ve> out, StringView key)\n{\n    bool bare = StringView::len(key) > 0;\n    for (usize i = 0; i < Strin"
    "gView::len(key); i += 1)\n    {\n        if (!toml_is_bare(key.bytes[i]))\n        {\n            bare ="
    " false;\n        }\n    }\n    if (bare)\n    {\n        String::append(out, key);\n    }\n    else\n    {\n "
    "       toml_quote(out, key);\n    }\n}fn toml_float(ref<String, exclusive> out, f64 x)\n{\n    if (x != "
    "x)\n    {\n        String::append(out, \"nan\");\n    }\n    else if (!is_finite(x))\n    {\n        String:"
    ":append(out, if (x > 0.0) { \"inf\" } else { \"-inf\" });\n    }\n    else\n    {\n        String::append(ou"
    "t, x);\n    }\n}fn toml_two_digits(ref<String, exclusive> out, u8 v)\n{\n    String::push_ascii(out, b'0"
    "' + v / 10);\n    String::push_ascii(out, b'0' + v % 10);\n}export fn TomlDateTime::text(ref<TomlDateT"
    "ime, shared> d) : String\n{\n    String out = String::new();\n    bool date = match (d.kind)\n    {\n    "
    "    TomlLocalTime : false,\n        _             : true,\n    };\n    bool time = match (d.kind)\n    {"
    "\n        TomlLocalDate : false,\n        _             : true,\n    };\n    if (date)\n    {\n        i64"
    " y = d.year;\n        if (y < 0)\n        {\n            String::push_ascii(&mut out, b'-');\n          "
    "  y = 0 - y;\n        }\n        if (y < 1000) { String::push_ascii(&mut out, b'0'); }\n        if (y <"
    " 100) { String::push_ascii(&mut out, b'0'); }\n        if (y < 10) { String::push_ascii(&mut out, b'0"
    "'); }\n        String::append(&mut out, y);\n        String::push_ascii(&mut out, b'-');\n        toml_"
    "two_digits(&mut out, d.month);\n        String::push_ascii(&mut out, b'-');\n        toml_two_digits(&"
    "mut out, d.day);\n    }\n    if (date && time)\n    {\n        String::push_ascii(&mut out, b'T');\n    }"
    "\n    if (time)\n    {\n        toml_two_digits(&mut out, d.hour);\n        String::push_ascii(&mut out,"
    " b':');\n        toml_two_digits(&mut out, d.minute);\n        String::push_ascii(&mut out, b':');\n   "
    "     toml_two_digits(&mut out, d.second);\n        if (d.nanoseconds > 0)\n        {\n            Strin"
    "g::push_ascii(&mut out, b'.');\n            u32 n = d.nanoseconds;\n            u32 scale = 100000000;"
    "\n            while (n > 0)\n            {\n                String::push_ascii(&mut out, b'0' + narrow<"
    "u8>(n / scale));\n                n = n % scale;\n                scale = scale / 10;\n            }\n  "
    "      }\n    }\n    match (d.kind)\n    {\n        TomlOffsetDateTime :\n        {\n            if (d.offs"
    "et_minutes == 0)\n            {\n                String::push_ascii(&mut out, b'Z');\n            }\n   "
    "         else\n            {\n                i32 m = d.offset_minutes;\n                String::push_a"
    "scii(&mut out, if (m < 0) { b'-' } else { b'+' });\n                if (m < 0)\n                {\n    "
    "                m = 0 - m;\n                }\n                toml_two_digits(&mut out, narrow<u8>(m "
    "/ 60));\n                String::push_ascii(&mut out, b':');\n                toml_two_digits(&mut out"
    ", narrow<u8>(m % 60));\n            }\n        },\n        _                  : {},\n    }\n    out\n}unit"
    "test \"TomlDateTime::text: the four forms\"\n{\n    String text = \"a = 1979-05-27T07:32:00.999999Z\\nb = "
    "1979-05-27T00:32:00.5-07:00\\nc = 1979-05-27T07:32:00\\nd = 1979-05-27\\ne = 07:32:00\\n\";\n    Toml doc "
    "= Result::unwrap(Toml::parse(String::as_view(&text)));\n    assert(Toml::text(&doc) == text);\n    Tom"
    "lDateTime b = Option::unwrap(Toml::as_datetime(Option::unwrap(Toml::get(&doc, \"b\"))));\n    assert(b."
    "nanoseconds == 500000000 && b.offset_minutes == -420 && TomlDateTime::text(&b) == \"1979-05-27T00:32:"
    "00.5-07:00\");\n}fn toml_is_table(ref<Toml, shared> v) : bool\n{\n    match (v)\n    {\n        TomlTable("
    "_) : true,\n        _            : false,\n    }\n}fn toml_is_table_array(ref<Toml, shared> v) : bool\n{"
    "\n    match (v)\n    {\n        TomlArray(items) :\n        {\n            if (Vec::len(items) == 0)\n    "
    "        {\n                return false;\n            }\n            for (usize i = 0; i < Vec::len(ite"
    "ms); i += 1)\n            {\n                if (!toml_is_table(&items[i]))\n                {\n        "
    "            return false;\n                }\n            }\n            true\n        },\n        _     "
    "           : false,\n    }\n}fn toml_inline(ref<String, exclusive> out, ref<Toml, shared> v)\n{\n    mat"
    "ch (v)\n    {\n        TomlString(s)      : toml_quote(out, String::as_view(s)),\n        TomlInteger(i"
    ")     : String::append(out, *i),\n        TomlFloat(x)       : toml_float(out, *x),\n        TomlBool("
    "b)        : String::append(out, if (*b) { \"true\" } else { \"false\" }),\n        TomlDateTime(d)    : S"
    "tring::append(out, &TomlDateTime::text(d)),\n        TomlArray(items)   :\n        {\n            Strin"
    "g::push_ascii(out, b'[');\n            for (usize i = 0; i < Vec::len(items); i += 1)\n            {\n "
    "               if (i > 0)\n                {\n                    String::append(out, \", \");\n         "
    "       }\n                toml_inline(out, &items[i]);\n            }\n            String::push_ascii(o"
    "ut, b']');\n        },\n        TomlTable(members) :\n        {\n            String::push_ascii(out, b'{"
    "');\n            for (usize i = 0; i < Vec::len(members); i += 1)\n            {\n                Strin"
    "g::append(out, if (i > 0) { \", \" } else { \" \" });\n                toml_key(out, String::as_view(&mem"
    "bers[i].key));\n                String::append(out, \" = \");\n                toml_inline(out, &members"
    "[i].value);\n            }\n            String::append(out, if (Vec::len(members) > 0) { \" }\" } else {"
    " \"}\" });\n        },\n    }\n}fn toml_write_table(ref<String, exclusive> out, ref<Vec<TomlMember>, shar"
    "ed> members, ref<String, shared> path)\n{\n    for (usize i = 0; i < Vec::len(members); i += 1)\n    {\n"
    "        ref<Toml, shared> v = &members[i].value;\n        if (toml_is_table(v) || toml_is_table_array"
    "(v))\n        {\n            continue;\n        }\n        toml_key(out, String::as_view(&members[i].key"
    "));\n        String::append(out, \" = \");\n        toml_inline(out, v);\n        String::push_ascii(out,"
    " b'\\n');\n    }\n    for (usize i = 0; i < Vec::len(members); i += 1)\n    {\n        ref<Toml, shared> "
    "v = &members[i].value;\n        bool table = toml_is_table(v);\n        if (!table && !toml_is_table_a"
    "rray(v))\n        {\n            continue;\n        }\n        String sub = clone(path);\n        if (Str"
    "ing::len(&sub) > 0)\n        {\n            String::push_ascii(&mut sub, b'.');\n        }\n        toml"
    "_key(&mut sub, String::as_view(&members[i].key));\n        match (v)\n        {\n            TomlTable("
    "inner) :\n            {\n                if (String::len(out) > 0)\n                {\n                 "
    "   String::push_ascii(out, b'\\n');\n                }\n                String::push_ascii(out, b'[');\n"
    "                String::append(out, &sub);\n                String::append(out, \"]\\n\");\n             "
    "   toml_write_table(out, inner, &sub);\n            },\n            TomlArray(items) :\n            {\n "
    "               for (usize k = 0; k < Vec::len(items); k += 1)\n                {\n                    "
    "if (String::len(out) > 0)\n                    {\n                        String::push_ascii(out, b'\\n"
    "');\n                    }\n                    String::append(out, \"[[\");\n                    String:"
    ":append(out, &sub);\n                    String::append(out, \"]]\\n\");\n                    match (&ite"
    "ms[k])\n                    {\n                        TomlTable(inner) : toml_write_table(out, inner,"
    " &sub),\n                        _                : {},\n                    }\n                }\n     "
    "       },\n            _                : {},\n        }\n    }\n}export fn Toml::text(ref<Toml, shared>"
    " t) : String\n{\n    String out = String::new();\n    match (t)\n    {\n        TomlTable(members) :\n    "
    "    {\n            String path = String::new();\n            toml_write_table(&mut out, members, &path"
    ");\n        },\n        _                  : toml_inline(&mut out, t),\n    }\n    out\n}unittest \"Toml::"
    "text: the layout\"\n{\n    Toml doc = Result::unwrap(Toml::parse(\"[server]\\nhost = \\\"example.org\\\"\\npor"
    "ts = [80, 443]\\n[server.tls]\\ncert = 'a b'\\n[[users]]\\nname = \\\"ann\\\"\\n[[users]]\\nname = \\\"bob\\\"\\n\")"
    ");\n    String t = Toml::text(&doc);\n    assert(t == \"[server]\\nhost = \\\"example.org\\\"\\nports = [80, "
    "443]\\n\\n[server.tls]\\ncert = \\\"a b\\\"\\n\\n[[users]]\\nname = \\\"ann\\\"\\n\\n[[users]]\\nname = \\\"bob\\\"\\n\");\n"
    "    assert(Toml::text(&Result::unwrap(Toml::parse(String::as_view(&t)))) == t);\n}export fn Toml::get"
    "(ref<Toml, shared> t, StringView key) : Option<ref<Toml, shared>>\n{\n    match (t)\n    {\n        Toml"
    "Table(members) :\n        {\n            for (usize i = 0; i < Vec::len(members); i += 1)\n            "
    "{\n                if (members[i].key == key)\n                {\n                    return Some(&memb"
    "ers[i].value);\n                }\n            }\n            None\n        },\n        _                "
    "  : None,\n    }\n}export fn Toml::at(ref<Toml, shared> t, usize i) : Option<ref<Toml, shared>>\n{\n    "
    "match (t)\n    {\n        TomlArray(items) : if (i < Vec::len(items)) { Some(&items[i]) } else { None "
    "},\n        _                : None,\n    }\n}export fn Toml::lookup(ref<Toml, shared> t, StringView pa"
    "th) : Option<ref<Toml, shared>>\n{\n    Vec<StringView> parts = StringView::split(path, \".\");\n    ref<"
    "Toml, shared> cur = t;\n    for (usize i = 0; i < Vec::len(&parts); i += 1)\n    {\n        cur = match"
    " (cur)\n        {\n            TomlArray(_) : match (StringView::parse<usize>(parts[i]))\n            {"
    "\n                Ok(k)  : Toml::at(cur, k)?,\n                Err(_) : return None,\n            },\n  "
    "          _ : Toml::get(cur, parts[i])?,\n        };\n    }\n    Some(cur)\n}export fn Toml::as_text(ref"
    "<Toml, shared> t) : Option<StringView>\n{\n    match (t)\n    {\n        TomlString(s) : Some(String::as"
    "_view(s)),\n        _             : None,\n    }\n}export fn Toml::as_i64(ref<Toml, shared> t) : Option"
    "<i64>\n{\n    match (t)\n    {\n        TomlInteger(i) : Some(*i),\n        _              : None,\n    }\n"
    "}export fn Toml::as_f64(ref<Toml, shared> t) : Option<f64>\n{\n    match (t)\n    {\n        TomlFloat(x"
    ") : Some(*x),\n        _            : None,\n    }\n}export fn Toml::as_bool(ref<Toml, shared> t) : Opt"
    "ion<bool>\n{\n    match (t)\n    {\n        TomlBool(b) : Some(*b),\n        _           : None,\n    }\n}e"
    "xport fn Toml::as_datetime(ref<Toml, shared> t) : Option<TomlDateTime>\n{\n    match (t)\n    {\n       "
    " TomlDateTime(d) : Some(*d),\n        _               : None,\n    }\n}export fn Toml::as_array(ref<Tom"
    "l, shared> t) : Option<ref<Vec<Toml>, shared>>\n{\n    match (t)\n    {\n        TomlArray(items) : Some"
    "(items),\n        _                : None,\n    }\n}export fn Toml::as_table(ref<Toml, shared> t) : Opt"
    "ion<ref<Vec<TomlMember>, shared>>\n{\n    match (t)\n    {\n        TomlTable(members) : Some(members),\n"
    "        _                  : None,\n    }\n}export fn Toml::set(ref<Toml, exclusive> t, StringView key"
    ", Toml v)\n{\n    match (t)\n    {\n        TomlTable(members) :\n        {\n            for (usize i = 0;"
    " i < Vec::len(members); i += 1)\n            {\n                if (members[i].key == key)\n           "
    "     {\n                    overwrite(&mut members[i].value, v);\n                    return;\n        "
    "        }\n            }\n            Vec::push(members, TomlMember { .key = String::from_view(key), ."
    "value = v });\n        },\n        _                  : assert(false, \"Toml::set on a value that is no"
    "t a table\"),\n    }\n}export fn Toml::push(ref<Toml, exclusive> t, Toml v)\n{\n    match (t)\n    {\n     "
    "   TomlArray(items) : Vec::push(items, v),\n        _                : assert(false, \"Toml::push on a"
    " value that is not an array\"),\n    }\n}unittest \"Toml::set: building a document\"\n{\n    Toml doc = Tom"
    "lTable(Vec::new());\n    Toml::set(&mut doc, \"name\", TomlString(String::from_str(\"demo\")));\n    Toml "
    "ports = TomlArray(Vec::new());\n    Toml::push(&mut ports, TomlInteger(8080));\n    Toml::push(&mut po"
    "rts, TomlInteger(8081));\n    Toml server = TomlTable(Vec::new());\n    Toml::set(&mut server, \"ports\""
    ", ports);\n    Toml::set(&mut server, \"debug\", TomlBool(false));\n    Toml::set(&mut doc, \"server\", se"
    "rver);\n    Toml::set(&mut doc, \"name\", TomlString(String::from_str(\"demo 2\")));\n    assert(Toml::tex"
    "t(&doc) == \"name = \\\"demo 2\\\"\\n\\n[server]\\nports = [8080, 8081]\\ndebug = false\\n\");\n}export fn Compr"
    "essError::text(ref<CompressError, shared> e) : str\n{\n    match (e)\n    {\n        Corrupt(_) : \"corru"
    "pt compressed data\",\n        Truncated  : \"compressed data ends early\",\n        Oversize   : \"decomp"
    "ressed data too large\",\n    }\n}fn BitReader::take(ref<BitReader, exclusive> r, u32 n) : Result<u32, "
    "CompressError>\n{\n    while (r.count < n)\n    {\n        if (r.at >= slice_len(r.data))\n        {\n    "
    "        return Err(Truncated);\n        }\n        r.bits = r.bits | (widen<u32>(r.data[r.at]) << r.co"
    "unt);\n        r.at += 1;\n        r.count += 8;\n    }\n    u32 v = r.bits & ((1: u32 << n) - 1);\n    r"
    ".bits = r.bits >> n;\n    r.count -= n;\n    Ok(v)\n}fn BitReader::align(ref<BitReader, exclusive> r)\n{"
    "\n    r.bits = 0;\n    r.count = 0;\n}fn Huffman::build(slice<u8, shared> lengths) : Option<Huffman>\n{\n"
    "    array<u16, 16> counts = [0; 16];\n    for (usize i = 0; i < slice_len(lengths); i += 1)\n    {\n   "
    "     counts[widen<usize>(lengths[i])] += 1;\n    }\n    counts[0] = 0;\n    i32 left = 1;\n    for (usiz"
    "e len = 1; len < 16; len += 1)\n    {\n        left = left * 2 - widen<i32>(counts[len]);\n        if ("
    "left < 0)\n        {\n            return None;\n        }\n    }\n    array<u16, 16> offs = [0; 16];\n    "
    "for (usize len = 1; len < 15; len += 1)\n    {\n        offs[len + 1] = offs[len] + counts[len];\n    }"
    "\n    array<u16, 320> symbols = [0; 320];\n    for (usize i = 0; i < slice_len(lengths); i += 1)\n    {"
    "\n        if (lengths[i] != 0)\n        {\n            symbols[widen<usize>(offs[widen<usize>(lengths[i"
    "])])] = narrow<u16>(i);\n            offs[widen<usize>(lengths[i])] += 1;\n        }\n    }\n    Some(Hu"
    "ffman { .counts = counts, .symbols = symbols })\n}fn Huffman::decode(ref<Huffman, shared> h, ref<BitR"
    "eader, exclusive> r) : Result<u16, CompressError>\n{\n    HuffStep s = huff_step(r.data, h, r.at, r.bi"
    "ts, r.count);\n    r.at = s.at;\n    r.bits = s.bits;\n    r.count = s.count;\n    if (s.sym == -1)\n    "
    "{\n        return Err(Truncated);\n    }\n    if (s.sym < 0)\n    {\n        return Err(Corrupt(r.at));\n "
    "   }\n    Ok(narrow<u16>(s.sym))\n}fn huff_step(slice<u8, shared> data, ref<Huffman, shared> h, usize "
    "at, u32 bits, u32 count) : HuffStep\n{\n    usize n = slice_len(data);\n    usize p = at;\n    u32 bb = "
    "bits;\n    u32 bc = count;\n    i32 code = 0;\n    i32 first = 0;\n    i32 index = 0;\n    for (usize len"
    " = 1; len < 16; len += 1)\n    {\n        if (bc == 0)\n        {\n            if (p >= n)\n            {"
    "\n                return HuffStep { .sym = -1, .at = p, .bits = bb, .count = bc };\n            }\n    "
    "        bb = widen<u32>(data[p]);\n            p += 1;\n            bc = 8;\n        }\n        code = c"
    "ode | narrow<i32>(bb & 1);\n        bb = bb >> 1;\n        bc -= 1;\n        i32 c = widen<i32>(h.count"
    "s[len]);\n        if (code - c < first)\n        {\n            return HuffStep { .sym = widen<i32>(h.s"
    "ymbols[narrow<usize>(index + (code - first))]), .at = p, .bits = bb, .count = bc };\n        }\n      "
    "  index += c;\n        first += c;\n        first = first << 1;\n        code = code << 1;\n    }\n    Hu"
    "ffStep { .sym = -2, .at = p, .bits = bb, .count = bc }\n}fn bits_step(slice<u8, shared> data, usize a"
    "t, u32 bits, u32 count, u32 need) : BitsStep\n{\n    usize p = at;\n    u32 bb = bits;\n    u32 bc = cou"
    "nt;\n    while (bc < need)\n    {\n        if (p >= slice_len(data))\n        {\n            return BitsS"
    "tep { .ok = false, .v = 0, .at = p, .bits = bb, .count = bc };\n        }\n        bb = bb | (widen<u3"
    "2>(data[p]) << bc);\n        p += 1;\n        bc += 8;\n    }\n    u32 v = bb & ((1: u32 << need) - 1);\n"
    "    BitsStep { .ok = true, .v = v, .at = p, .bits = bb >> need, .count = bc - need }\n}fn fixed_codes"
    "() : Huffman\n{\n    Vec<u8> lit = Vec::filled(288, 8: u8);\n    for (usize i = 144; i < 256; i += 1)\n "
    "   {\n        lit[i] = 9;\n    }\n    for (usize i = 256; i < 280; i += 1)\n    {\n        lit[i] = 7;\n  "
    "  }\n    Option::unwrap(Huffman::build(&lit[0..$]))\n}fn fixed_distances() : Huffman\n{\n    Vec<u8> d ="
    " Vec::filled(30, 5: u8);\n    Option::unwrap(Huffman::build(&d[0..$]))\n}fn inflate_codes(\n    ref<Bit"
    "Reader, exclusive> r,\n    ref<Vec<u8>, exclusive> out,\n    ref<Huffman, shared> lit,\n    ref<Huffman"
    ", shared> dist,\n    usize max,\n) : Result<void, CompressError>\n{\n    Vec<u8> o = replace(out, Vec::n"
    "ew());\n    InflateRun { bytes, pos, bitbuf, nbits, status } = inflate_run(r.data, lit, dist, o, r.at"
    ", r.bits, r.count, max);\n    r.at = pos;\n    r.bits = bitbuf;\n    r.count = nbits;\n    overwrite(out"
    ", bytes);\n    if (status == 1)\n    {\n        return Err(Truncated);\n    }\n    if (status == 2)\n    {"
    "\n        return Err(Corrupt(r.at));\n    }\n    if (status == 3)\n    {\n        return Err(Oversize);\n "
    "   }\n    Ok(())\n}fn inflate_run(\n    slice<u8, shared> data,\n    ref<Huffman, shared> lit,\n    ref<H"
    "uffman, shared> dist,\n    Vec<u8> out,\n    usize at0,\n    u32 bits0,\n    u32 count0,\n    usize max,\n"
    ") : InflateRun\n{\n    usize at = at0;\n    u32 bits = bits0;\n    u32 count = count0;\n    u32 status = "
    "0;\n    while (true)\n    {\n        HuffStep s = huff_step(data, lit, at, bits, count);\n        at = s"
    ".at;\n        bits = s.bits;\n        count = s.count;\n        if (s.sym < 0)\n        {\n            st"
    "atus = if (s.sym == -1) { 1 } else { 2 };\n            break;\n        }\n        if (s.sym < 256)\n    "
    "    {\n            if (Vec::len(&out) >= max)\n            {\n                status = 3;\n             "
    "   break;\n            }\n            Vec::push(&mut out, narrow<u8>(s.sym));\n            continue;\n  "
    "      }\n        if (s.sym == 256)\n        {\n            break;\n        }\n        usize li = narrow<u"
    "size>(s.sym) - 257;\n        if (li >= 29)\n        {\n            status = 2;\n            break;\n     "
    "   }\n        BitsStep e = bits_step(data, at, bits, count, widen<u32>(LENGTH_EXTRA[li]));\n        at"
    " = e.at;\n        bits = e.bits;\n        count = e.count;\n        if (!e.ok)\n        {\n            st"
    "atus = 1;\n            break;\n        }\n        usize len = widen<usize>(LENGTH_BASE[li]) + narrow<us"
    "ize>(e.v);\n        HuffStep d = huff_step(data, dist, at, bits, count);\n        at = d.at;\n        b"
    "its = d.bits;\n        count = d.count;\n        if (d.sym < 0)\n        {\n            status = if (d.s"
    "ym == -1) { 1 } else { 2 };\n            break;\n        }\n        usize di = narrow<usize>(d.sym);\n  "
    "      if (di >= 30)\n        {\n            status = 2;\n            break;\n        }\n        BitsStep "
    "f = bits_step(data, at, bits, count, widen<u32>(DIST_EXTRA[di]));\n        at = f.at;\n        bits = "
    "f.bits;\n        count = f.count;\n        if (!f.ok)\n        {\n            status = 1;\n            br"
    "eak;\n        }\n        usize distance = widen<usize>(DIST_BASE[di]) + narrow<usize>(f.v);\n        if"
    " (distance > Vec::len(&out))\n        {\n            status = 2;\n            break;\n        }\n        "
    "if (Vec::len(&out) + len > max)\n        {\n            status = 3;\n            break;\n        }\n     "
    "   usize from = Vec::len(&out) - distance;\n        for (usize k = 0; k < len; k += 1)\n        {\n    "
    "        u8 b = out[from + k];\n            Vec::push(&mut out, b);\n        }\n    }\n    InflateRun { ."
    "bytes = out, .pos = at, .bitbuf = bits, .nbits = count, .status = status }\n}fn read_dynamic(\n    ref"
    "<BitReader, exclusive> r,\n    ref<Option<Huffman>, exclusive> lit,\n    ref<Option<Huffman>, exclusiv"
    "e> dist,\n) : Result<void, CompressError>\n{\n    usize nlen = narrow<usize>(BitReader::take(r, 5)?) + "
    "257;\n    usize ndist = narrow<usize>(BitReader::take(r, 5)?) + 1;\n    usize ncode = narrow<usize>(Bi"
    "tReader::take(r, 4)?) + 4;\n    if (nlen > 286 || ndist > 30)\n    {\n        return Err(Corrupt(r.at))"
    ";\n    }\n    Vec<u8> clens = Vec::filled(19, 0: u8);\n    for (usize i = 0; i < ncode; i += 1)\n    {\n "
    "       clens[widen<usize>(CLEN_ORDER[i])] = narrow<u8>(BitReader::take(r, 3)?);\n    }\n    Huffman cc"
    "ode = match (Huffman::build(&clens[0..$]))\n    {\n        Some(h) : h,\n        None    : return Err(C"
    "orrupt(r.at)),\n    };\n    Vec<u8> lengths = Vec::new();\n    while (Vec::len(&lengths) < nlen + ndist"
    ")\n    {\n        u16 sym = Huffman::decode(&ccode, r)?;\n        if (sym < 16)\n        {\n            V"
    "ec::push(&mut lengths, narrow<u8>(sym));\n            continue;\n        }\n        u8 value = 0;\n     "
    "   usize repeat = 0;\n        if (sym == 16)\n        {\n            if (Vec::len(&lengths) == 0)\n     "
    "       {\n                return Err(Corrupt(r.at));\n            }\n            value = lengths[Vec::l"
    "en(&lengths) - 1];\n            repeat = 3 + narrow<usize>(BitReader::take(r, 2)?);\n        }\n       "
    " else if (sym == 17)\n        {\n            repeat = 3 + narrow<usize>(BitReader::take(r, 3)?);\n     "
    "   }\n        else\n        {\n            repeat = 11 + narrow<usize>(BitReader::take(r, 7)?);\n       "
    " }\n        if (Vec::len(&lengths) + repeat > nlen + ndist)\n        {\n            return Err(Corrupt("
    "r.at));\n        }\n        for (usize k = 0; k < repeat; k += 1)\n        {\n            Vec::push(&mut"
    " lengths, value);\n        }\n    }\n    if (lengths[256] == 0)\n    {\n        return Err(Corrupt(r.at))"
    ";\n    }\n    match (Huffman::build(&lengths[0..nlen]))\n    {\n        Some(h) : overwrite(lit, Some(h)"
    "),\n        None    : return Err(Corrupt(r.at)),\n    }\n    match (Huffman::build(&lengths[nlen..nlen "
    "+ ndist]))\n    {\n        Some(h) : overwrite(dist, Some(h)),\n        None    : return Err(Corrupt(r."
    "at)),\n    }\n    Ok(())\n}fn inflate_from(\n    slice<u8, shared> data,\n    usize start,\n    ref<Vec<u8"
    ">, exclusive> out,\n    usize max,\n) : Result<usize, CompressError>\n{\n    BitReader r = BitReader { ."
    "data = data, .at = start, .bits = 0, .count = 0 };\n    Huffman fixed_lit = fixed_codes();\n    Huffma"
    "n fixed_dist = fixed_distances();\n    while (true)\n    {\n        u32 last = BitReader::take(&mut r, "
    "1)?;\n        u32 kind = BitReader::take(&mut r, 2)?;\n        if (kind == 0)\n        {\n            Bi"
    "tReader::align(&mut r);\n            if (r.at + 4 > slice_len(data))\n            {\n                re"
    "turn Err(Truncated);\n            }\n            usize len = widen<usize>(read_le<u16>(data, r.at));\n "
    "           usize nlen = widen<usize>(read_le<u16>(data, r.at + 2));\n            if (len != (nlen ^ 0"
    "xFFFF))\n            {\n                return Err(Corrupt(r.at));\n            }\n            r.at += 4"
    ";\n            if (r.at + len > slice_len(data))\n            {\n                return Err(Truncated);"
    "\n            }\n            if (Vec::len(out) + len > max)\n            {\n                return Err(O"
    "versize);\n            }\n            Vec::extend_from(out, &data[r.at..r.at + len]);\n            r.at"
    " += len;\n        }\n        else if (kind == 1)\n        {\n            inflate_codes(&mut r, out, &fix"
    "ed_lit, &fixed_dist, max)?;\n        }\n        else if (kind == 2)\n        {\n            Option<Huffm"
    "an> lit = None;\n            Option<Huffman> dist = None;\n            read_dynamic(&mut r, &mut lit, "
    "&mut dist)?;\n            inflate_codes(&mut r, out, &Option::unwrap(lit), &Option::unwrap(dist), max"
    ")?;\n        }\n        else\n        {\n            return Err(Corrupt(r.at));\n        }\n        if (la"
    "st == 1)\n        {\n            // The bits left in the reader's buffer belong to no block; the\n     "
    "       // position after the block is the next whole byte.\n            return Ok(r.at);\n        }\n  "
    "  }\n}export fn inflate(slice<u8, shared> data, usize max) : Result<Vec<u8>, CompressError>\n{\n    Vec"
    "<u8> out = Vec::new();\n    inflate_from(data, 0, &mut out, max)?;\n    Ok(out)\n}fn BitWriter::put(ref"
    "<BitWriter, exclusive> w, u32 value, u32 n)\n{\n    w.bits = w.bits | (widen<u64>(value) << w.count);\n"
    "    w.count += n;\n    while (w.count >= 8)\n    {\n        Vec::push(&mut w.out, narrow_wrapping<u8>(w"
    ".bits));\n        w.bits = w.bits >> 8;\n        w.count -= 8;\n    }\n}fn BitWriter::put_code(ref<BitWr"
    "iter, exclusive> w, u32 code, u32 len)\n{\n    u32 rev = 0;\n    for (u32 i = 0; i < len; i += 1)\n    {"
    "\n        rev = (rev << 1) | ((code >> i) & 1);\n    }\n    BitWriter::put(w, rev, len);\n}fn BitWriter:"
    ":flush(ref<BitWriter, exclusive> w)\n{\n    if (w.count > 0)\n    {\n        Vec::push(&mut w.out, narro"
    "w_wrapping<u8>(w.bits));\n        w.bits = 0;\n        w.count = 0;\n    }\n}fn code_lengths(slice<u32, "
    "shared> freq, usize limit) : Vec<u8>\n{\n    usize n = slice_len(freq);\n    Vec<u8> lengths = Vec::fil"
    "led(n, 0: u8);\n    Vec<u32> f = Vec::from_slice(freq);\n    usize used = 0;\n    for (usize i = 0; i <"
    " n; i += 1)\n    {\n        if (f[i] > 0)\n        {\n            used += 1;\n        }\n    }\n    if (use"
    "d == 0)\n    {\n        return lengths;\n    }\n    if (used == 1)\n    {\n        for (usize i = 0; i < n"
    "; i += 1)\n        {\n            if (f[i] > 0)\n            {\n                lengths[i] = 1;\n        "
    "    }\n        }\n        return lengths;\n    }\n    while (true)\n    {\n        // Nodes 0..n are the s"
    "ymbols, n.. the merges; each node's weight,\n        // parent and depth.\n        Vec<u64> weight = V"
    "ec::new();\n        Vec<usize> parent = Vec::new();\n        Vec<bool> alive = Vec::new();\n        for"
    " (usize i = 0; i < n; i += 1)\n        {\n            Vec::push(&mut weight, widen<u64>(f[i]));\n      "
    "      Vec::push(&mut parent, 0);\n            Vec::push(&mut alive, f[i] > 0);\n        }\n        usiz"
    "e live = used;\n        while (live > 1)\n        {\n            usize a = n * 2;\n            usize b ="
    " n * 2;\n            for (usize i = 0; i < Vec::len(&weight); i += 1)\n            {\n                i"
    "f (!alive[i])\n                {\n                    continue;\n                }\n                if ("
    "a == n * 2 || weight[i] < weight[a])\n                {\n                    b = a;\n                  "
    "  a = i;\n                }\n                else if (b == n * 2 || weight[i] < weight[b])\n           "
    "     {\n                    b = i;\n                }\n            }\n            usize m = Vec::len(&we"
    "ight);\n            Vec::push(&mut weight, weight[a] + weight[b]);\n            Vec::push(&mut parent,"
    " 0);\n            Vec::push(&mut alive, true);\n            alive[a] = false;\n            alive[b] = f"
    "alse;\n            parent[a] = m;\n            parent[b] = m;\n            live -= 1;\n        }\n       "
    " usize root = Vec::len(&weight) - 1;\n        usize deepest = 0;\n        for (usize i = 0; i < n; i +"
    "= 1)\n        {\n            if (f[i] == 0)\n            {\n                continue;\n            }\n    "
    "        usize d = 0;\n            usize at = i;\n            while (at != root)\n            {\n        "
    "        at = parent[at];\n                d += 1;\n            }\n            lengths[i] = narrow<u8>(d"
    ");\n            if (d > deepest)\n            {\n                deepest = d;\n            }\n        }\n "
    "       if (deepest <= limit)\n        {\n            return lengths;\n        }\n        for (usize i = "
    "0; i < n; i += 1)\n        {\n            if (f[i] > 0)\n            {\n                f[i] = (f[i] >> "
    "1) | 1;\n            }\n        }\n    }\n}fn canonical_codes(slice<u8, shared> lengths) : Vec<u32>\n{\n  "
    "  array<u32, 16> count = [0; 16];\n    for (usize i = 0; i < slice_len(lengths); i += 1)\n    {\n      "
    "  count[widen<usize>(lengths[i])] += 1;\n    }\n    count[0] = 0;\n    array<u32, 16> next = [0; 16];\n "
    "   u32 code = 0;\n    for (usize len = 1; len < 16; len += 1)\n    {\n        code = (code + count[len "
    "- 1]) << 1;\n        next[len] = code;\n    }\n    Vec<u32> codes = Vec::filled(slice_len(lengths), 0: "
    "u32);\n    for (usize i = 0; i < slice_len(lengths); i += 1)\n    {\n        usize l = widen<usize>(len"
    "gths[i]);\n        if (l != 0)\n        {\n            codes[i] = next[l];\n            next[l] += 1;\n  "
    "      }\n    }\n    codes\n}fn length_code(usize len) : usize\n{\n    usize c = 28;\n    for (usize i = 0;"
    " i < 28; i += 1)\n    {\n        if (len < widen<usize>(LENGTH_BASE[i + 1]))\n        {\n            c ="
    " i;\n            break;\n        }\n    }\n    c\n}fn distance_code(usize d) : usize\n{\n    usize c = 29;\n"
    "    for (usize i = 0; i < 29; i += 1)\n    {\n        if (d < widen<usize>(DIST_BASE[i + 1]))\n        "
    "{\n            c = i;\n            break;\n        }\n    }\n    c\n}fn hash3(slice<u8, shared> d, usize i"
    ") : usize\n{\n    ((widen<usize>(d[i]) << 10) ^ (widen<usize>(d[i + 1]) << 5) ^ widen<usize>(d[i + 2])"
    ") & (HASH_SIZE - 1)\n}fn token_counts(slice<Token, shared> tokens) : TokenCounts\n{\n    array<u32, 286"
    "> lit = [0; 286];\n    array<u32, 30> dist = [0; 30];\n    u64 extra = 0;\n    for (usize k = 0; k < sl"
    "ice_len(tokens); k += 1)\n    {\n        u16 l = tokens[k].lit;\n        lit[widen<usize>(l)] += 1;\n   "
    "     if (l >= 256)\n        {\n            dist[widen<usize>(tokens[k].dist_code)] += 1;\n            e"
    "xtra += widen<u64>(tokens[k].len_extra_bits) + widen<u64>(tokens[k].dist_extra_bits);\n        }\n    "
    "}\n    TokenCounts { .lit = lit, .dist = dist, .extra = extra }\n}fn write_block(ref<BitWriter, exclus"
    "ive> w, slice<Token, shared> tokens, slice<u8, shared> raw, bool last)\n{\n    // Frequencies, with th"
    "e end-of-block symbol.\n    TokenCounts counts = token_counts(tokens);\n    Vec<u32> lf = Vec::from_sl"
    "ice(&counts.lit[0..$]);\n    Vec<u32> df = Vec::from_slice(&counts.dist[0..$]);\n    lf[256] += 1;\n   "
    " Vec<u8> ll = code_lengths(&lf[0..$], 15);\n    Vec<u8> dl = code_lengths(&df[0..$], 15);\n    // The "
    "fixed code's lengths, for its cost.\n    Vec<u8> fl = Vec::filled(288, 8: u8);\n    for (usize i = 144"
    "; i < 256; i += 1)\n    {\n        fl[i] = 9;\n    }\n    for (usize i = 256; i < 280; i += 1)\n    {\n   "
    "     fl[i] = 7;\n    }\n    u64 extra = counts.extra;\n    u64 cost_fixed = extra;\n    u64 cost_dyn = e"
    "xtra;\n    for (usize i = 0; i < 286; i += 1)\n    {\n        cost_fixed += widen<u64>(lf[i]) * widen<u"
    "64>(fl[i]);\n        cost_dyn += widen<u64>(lf[i]) * widen<u64>(ll[i]);\n    }\n    for (usize i = 0; i"
    " < 30; i += 1)\n    {\n        cost_fixed += widen<u64>(df[i]) * 5;\n        cost_dyn += widen<u64>(df["
    "i]) * widen<u64>(dl[i]);\n    }\n    // The dynamic header: the code lengths run-length coded.\n    usi"
    "ze nlen = 286;\n    while (nlen > 257 && ll[nlen - 1] == 0)\n    {\n        nlen -= 1;\n    }\n    usize "
    "ndist = 30;\n    while (ndist > 1 && dl[ndist - 1] == 0)\n    {\n        ndist -= 1;\n    }\n    Vec<u8> "
    "all = Vec::new();\n    Vec::extend_from(&mut all, &ll[0..nlen]);\n    Vec::extend_from(&mut all, &dl[0"
    "..ndist]);\n    // Run-length symbols: (symbol, extra value, extra bits).\n    Vec<u8> rl_sym = Vec::n"
    "ew();\n    Vec<u8> rl_val = Vec::new();\n    Vec<u8> rl_bits = Vec::new();\n    usize i = 0;\n    while "
    "(i < Vec::len(&all))\n    {\n        u8 v = all[i];\n        usize run = 1;\n        while (i + run < Ve"
    "c::len(&all) && all[i + run] == v)\n        {\n            run += 1;\n        }\n        if (v == 0 && r"
    "un >= 3)\n        {\n            usize r = if (run > 138) { 138 } else { run };\n            if (r <= 1"
    "0)\n            {\n                Vec::push(&mut rl_sym, 17);\n                Vec::push(&mut rl_val, "
    "narrow<u8>(r - 3));\n                Vec::push(&mut rl_bits, 3);\n            }\n            else\n     "
    "       {\n                Vec::push(&mut rl_sym, 18);\n                Vec::push(&mut rl_val, narrow<u"
    "8>(r - 11));\n                Vec::push(&mut rl_bits, 7);\n            }\n            i += r;\n        }"
    "\n        else if (v != 0 && run >= 4)\n        {\n            Vec::push(&mut rl_sym, v);\n            V"
    "ec::push(&mut rl_val, 0);\n            Vec::push(&mut rl_bits, 0);\n            usize r = if (run - 1 "
    "> 6) { 6 } else { run - 1 };\n            Vec::push(&mut rl_sym, 16);\n            Vec::push(&mut rl_v"
    "al, narrow<u8>(r - 3));\n            Vec::push(&mut rl_bits, 2);\n            i += 1 + r;\n        }\n  "
    "      else\n        {\n            Vec::push(&mut rl_sym, v);\n            Vec::push(&mut rl_val, 0);\n "
    "           Vec::push(&mut rl_bits, 0);\n            i += 1;\n        }\n    }\n    Vec<u32> cf = Vec::fi"
    "lled(19, 0: u32);\n    foreach (s in &rl_sym)\n    {\n        cf[widen<usize>(*s)] += 1;\n    }\n    Vec<"
    "u8> cl = code_lengths(&cf[0..$], 7);\n    usize ncode = 19;\n    while (ncode > 4 && cl[widen<usize>(C"
    "LEN_ORDER[ncode - 1])] == 0)\n    {\n        ncode -= 1;\n    }\n    cost_dyn += 14 + widen<u64>(ncode) "
    "* 3;\n    for (usize k = 0; k < Vec::len(&rl_sym); k += 1)\n    {\n        cost_dyn += widen<u64>(cl[wi"
    "den<usize>(rl_sym[k])]) + widen<u64>(rl_bits[k]);\n    }\n    u64 cost_stored = widen<u64>(slice_len(r"
    "aw)) * 8 + 40 * (widen<u64>(slice_len(raw)) / 65535 + 1);\n    if (cost_stored <= cost_fixed && cost_"
    "stored <= cost_dyn)\n    {\n        // Stored blocks of at most 65535 bytes, the last marked.\n        "
    "usize at = 0;\n        while (true)\n        {\n            usize take = if (slice_len(raw) - at > 6553"
    "5) { 65535 } else { slice_len(raw) - at };\n            bool final = last && at + take == slice_len(r"
    "aw);\n            BitWriter::put(w, if (final) { 1 } else { 0 }, 1);\n            BitWriter::put(w, 0,"
    " 2);\n            BitWriter::flush(w);\n            Vec::push_le(&mut w.out, narrow<u16>(take));\n     "
    "       Vec::push_le(&mut w.out, narrow<u16>(take ^ 0xFFFF));\n            Vec::extend_from(&mut w.out"
    ", &raw[at..at + take]);\n            at += take;\n            if (at >= slice_len(raw))\n            {\n"
    "                return;\n            }\n        }\n    }\n    BitWriter::put(w, if (last) { 1 } else { 0"
    " }, 1);\n    Vec<u32> lcodes = Vec::new();\n    Vec<u8> llens = Vec::new();\n    Vec<u32> dcodes = Vec:"
    ":new();\n    Vec<u8> dlens = Vec::new();\n    if (cost_fixed <= cost_dyn)\n    {\n        BitWriter::put"
    "(w, 1, 2);\n        overwrite(&mut lcodes, canonical_codes(&fl[0..$]));\n        overwrite(&mut llens,"
    " fl);\n        Vec<u8> fd = Vec::filled(30, 5: u8);\n        overwrite(&mut dcodes, canonical_codes(&f"
    "d[0..$]));\n        overwrite(&mut dlens, fd);\n    }\n    else\n    {\n        BitWriter::put(w, 2, 2);\n"
    "        BitWriter::put(w, narrow<u32>(nlen - 257), 5);\n        BitWriter::put(w, narrow<u32>(ndist -"
    " 1), 5);\n        BitWriter::put(w, narrow<u32>(ncode - 4), 4);\n        for (usize k = 0; k < ncode; "
    "k += 1)\n        {\n            BitWriter::put(w, widen<u32>(cl[widen<usize>(CLEN_ORDER[k])]), 3);\n   "
    "     }\n        Vec<u32> ccodes = canonical_codes(&cl[0..$]);\n        for (usize k = 0; k < Vec::len("
    "&rl_sym); k += 1)\n        {\n            usize s = widen<usize>(rl_sym[k]);\n            BitWriter::pu"
    "t_code(w, ccodes[s], widen<u32>(cl[s]));\n            if (rl_bits[k] > 0)\n            {\n             "
    "   BitWriter::put(w, widen<u32>(rl_val[k]), widen<u32>(rl_bits[k]));\n            }\n        }\n       "
    " overwrite(&mut lcodes, canonical_codes(&ll[0..$]));\n        overwrite(&mut llens, ll);\n        over"
    "write(&mut dcodes, canonical_codes(&dl[0..$]));\n        overwrite(&mut dlens, dl);\n    }\n    Vec<u8>"
    " o = replace(&mut w.out, Vec::new());\n    BitOut { buf, acc, nacc } = put_tokens(\n        o,\n       "
    " w.bits,\n        w.count,\n        tokens,\n        &lcodes[0..$],\n        &llens[0..$],\n        &dcod"
    "es[0..$],\n        &dlens[0..$],\n    );\n    overwrite(&mut w.out, buf);\n    w.bits = acc;\n    w.count"
    " = nacc;\n}fn put_tokens(\n    Vec<u8> out,\n    u64 bits0,\n    u32 count0,\n    slice<Token, shared> to"
    "kens,\n    slice<u32, shared> lcodes,\n    slice<u8, shared> llens,\n    slice<u32, shared> dcodes,\n   "
    " slice<u8, shared> dlens,\n) : BitOut\n{\n    u64 bits = bits0;\n    u32 count = count0;\n    usize nt = "
    "slice_len(tokens);\n    for (usize k = 0; k <= nt; k += 1)\n    {\n        // Up to four fields per tok"
    "en: its code (or, after the last, the\n        // end code), then for a match the length's extra bits"
    ", the\n        // distance's code and its extra bits. A code goes most\n        // significant bit fir"
    "st: reversed.\n        usize s = if (k < nt) { widen<usize>(tokens[k].lit) } else { 256 };\n        fo"
    "r (usize f = 0; f < 4; f += 1)\n        {\n            u32 v = 0;\n            u32 n = 0;\n            i"
    "f (f == 0)\n            {\n                u32 code = lcodes[s];\n                n = widen<u32>(llens["
    "s]);\n                for (u32 i = 0; i < n; i += 1)\n                {\n                    v = (v << "
    "1) | ((code >> i) & 1);\n                }\n            }\n            else if (s >= 257)\n            {"
    "\n                if (f == 1)\n                {\n                    v = widen<u32>(tokens[k].len_extr"
    "a);\n                    n = widen<u32>(tokens[k].len_extra_bits);\n                }\n                "
    "else if (f == 2)\n                {\n                    usize d = widen<usize>(tokens[k].dist_code);\n"
    "                    u32 code = dcodes[d];\n                    n = widen<u32>(dlens[d]);\n            "
    "        for (u32 i = 0; i < n; i += 1)\n                    {\n                        v = (v << 1) | "
    "((code >> i) & 1);\n                    }\n                }\n                else\n                {\n  "
    "                  v = widen<u32>(tokens[k].dist_extra);\n                    n = widen<u32>(tokens[k]"
    ".dist_extra_bits);\n                }\n            }\n            if (n == 0)\n            {\n           "
    "     continue;\n            }\n            bits = bits | (widen<u64>(v) << count);\n            count +"
    "= n;\n            while (count >= 8)\n            {\n                Vec::push(&mut out, narrow_wrappin"
    "g<u8>(bits));\n                bits = bits >> 8;\n                count -= 8;\n            }\n        }\n"
    "    }\n    BitOut { .buf = out, .acc = bits, .nacc = count }\n}fn deflate_scan(slice<u8, shared> data,"
    " Vec<usize> head, Vec<usize> prev, Vec<Token> tokens, usize start) : DeflateScan\n{\n    usize n = sli"
    "ce_len(data);\n    usize i = start;\n    while (i < n && Vec::len(&tokens) < MAX_TOKENS)\n    {\n       "
    " usize best_len = 0;\n        usize best_dist = 0;\n        if (i + 3 <= n)\n        {\n            usiz"
    "e h = ((widen<usize>(data[i]) << 10) ^ (widen<usize>(data[i + 1]) << 5) ^ widen<usize>(data[i + 2]))"
    " & (HASH_SIZE - 1);\n            usize cand = head[h];\n            usize chain = 0;\n            usize"
    " limit = if (n - i > 258) { 258 } else { n - i };\n            while (cand != max_value<usize>() && i"
    " - cand <= WINDOW && chain < CHAIN_LIMIT)\n            {\n                if (data[cand + best_len] =="
    " data[i + best_len])\n                {\n                    usize l = 0;\n                    while (l"
    " < limit && data[cand + l] == data[i + l])\n                    {\n                        l += 1;\n   "
    "                 }\n                    if (l > best_len)\n                    {\n                     "
    "   best_len = l;\n                        best_dist = i - cand;\n                        if (l == limi"
    "t)\n                        {\n                            break;\n                        }\n          "
    "          }\n                }\n                usize next = prev[cand & (WINDOW - 1)];\n              "
    "  if (next == max_value<usize>() || next >= cand)\n                {\n                    break;\n     "
    "           }\n                cand = next;\n                chain += 1;\n            }\n            prev"
    "[i & (WINDOW - 1)] = head[h];\n            head[h] = i;\n        }\n        if (best_len >= 3)\n        "
    "{\n            usize lc = length_code(best_len);\n            usize dc = distance_code(best_dist);\n   "
    "         Vec::push(&mut tokens, Token {\n                .lit = narrow<u16>(257 + lc),\n              "
    "  .len_extra = narrow<u16>(best_len - widen<usize>(LENGTH_BASE[lc])),\n                .len_extra_bit"
    "s = LENGTH_EXTRA[lc],\n                .dist_code = narrow<u8>(dc),\n                .dist_extra = nar"
    "row<u16>(best_dist - widen<usize>(DIST_BASE[dc])),\n                .dist_extra_bits = DIST_EXTRA[dc]"
    ",\n            });\n            // The bytes inside the match enter the hash chains too.\n            f"
    "or (usize k = 1; k < best_len; k += 1)\n            {\n                if (i + k + 3 <= n)\n           "
    "     {\n                    usize h = ((widen<usize>(data[i + k]) << 10) ^ (widen<usize>(data[i + k +"
    " 1]) << 5) ^ widen<usize>(data[i + k + 2])) & (HASH_SIZE - 1);\n                    prev[(i + k) & (W"
    "INDOW - 1)] = head[h];\n                    head[h] = i + k;\n                }\n            }\n        "
    "    i += best_len;\n        }\n        else\n        {\n            Vec::push(\n                &mut toke"
    "ns,\n                Token { .lit = widen<u16>(data[i]), .len_extra = 0, .len_extra_bits = 0, .dist_c"
    "ode = 0, .dist_extra = 0, .dist_extra_bits = 0 },\n            );\n            i += 1;\n        }\n    }"
    "\n    DeflateScan { .head = head, .prev = prev, .tokens = tokens, .end = i }\n}export fn deflate(slice"
    "<u8, shared> data) : Vec<u8>\n{\n    BitWriter w = BitWriter { .out = Vec::new(), .bits = 0, .count = "
    "0 };\n    usize n = slice_len(data);\n    if (n == 0)\n    {\n        // One empty fixed block.\n        "
    "BitWriter::put(&mut w, 1, 1);\n        BitWriter::put(&mut w, 1, 2);\n        BitWriter::put(&mut w, 0"
    ", 7);\n        BitWriter::flush(&mut w);\n        BitWriter { out, bits, count } = w;\n        return o"
    "ut;\n    }\n    Vec<usize> heads = Vec::filled(HASH_SIZE, max_value<usize>());\n    Vec<usize> chains ="
    " Vec::filled(WINDOW, max_value<usize>());\n    DeflateScan s = DeflateScan { .head = heads, .prev = c"
    "hains, .tokens = Vec::new(), .end = 0 };\n    while (s.end < n)\n    {\n        usize block_start = s.e"
    "nd;\n        DeflateScan { head, prev, tokens, end } = s;\n        s = deflate_scan(data, head, prev, "
    "tokens, end);\n        write_block(&mut w, &s.tokens[0..$], &data[block_start..s.end], s.end >= n);\n "
    "       Vec::clear(&mut s.tokens);\n    }\n    BitWriter::flush(&mut w);\n    BitWriter { out, bits, cou"
    "nt } = w;\n    out\n}unittest \"deflate: empty data, and adler32\"\n{\n    Vec<u8> nothing = Vec::new();\n "
    "   Vec<u8> empty = deflate(&nothing[0..$]);\n    assert(Vec::len(&empty) == 2 && empty[0] == 0x03 && "
    "empty[1] == 0x00);\n    assert(Vec::len(&Result::unwrap(inflate(&empty[0..$], 0))) == 0);\n    assert("
    "adler32(&b\"Wikipedia\"[0..$]) == 300286872);\n    assert(adler32(&nothing[0..$]) == 1);\n}export fn adl"
    "er32(slice<u8, shared> data) : u32\n{\n    u32 a = 1;\n    u32 b = 0;\n    usize i = 0;\n    usize n = sl"
    "ice_len(data);\n    while (i < n)\n    {\n        // 5552 bytes at a time fit the sums in a `u32` befor"
    "e reducing.\n        usize end = if (n - i > 5552) { i + 5552 } else { n };\n        while (i < end)\n "
    "       {\n            a += widen<u32>(data[i]);\n            b += a;\n            i += 1;\n        }\n   "
    "     a = a % 65521;\n        b = b % 65521;\n    }\n    (b << 16) | a\n}export fn zlib_deflate(slice<u8,"
    " shared> data) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n    Vec::push(&mut out, 0x78);\n    Vec::pus"
    "h(&mut out, 0x9C);\n    Vec::append(&mut out, deflate(data));\n    Vec::push_be(&mut out, adler32(data"
    "));\n    out\n}export fn zlib_inflate(slice<u8, shared> data, usize max) : Result<Vec<u8>, CompressErr"
    "or>\n{\n    if (slice_len(data) < 6)\n    {\n        return Err(Truncated);\n    }\n    u8 cmf = data[0];\n"
    "    u8 flg = data[1];\n    if ((cmf & 0x0F) != 8 || (widen<u32>(cmf) * 256 + widen<u32>(flg)) % 31 !="
    " 0 || (flg & 0x20) != 0)\n    {\n        return Err(Corrupt(0));\n    }\n    Vec<u8> out = Vec::new();\n "
    "   usize end = inflate_from(data, 2, &mut out, max)?;\n    if (end + 4 > slice_len(data))\n    {\n     "
    "   return Err(Truncated);\n    }\n    if (read_be<u32>(data, end) != adler32(&out[0..$]))\n    {\n      "
    "  return Err(Corrupt(end));\n    }\n    Ok(out)\n}unittest \"zlib_inflate: a wrong checksum\"\n{\n    Vec<u"
    "8> z = zlib_deflate(&b\"hello hello hello\"[0..$]);\n    usize last = Vec::len(&z) - 1;\n    z[last] = z"
    "[last] ^ 1;\n    match (zlib_inflate(&z[0..$], 100))\n    {\n        Err(Corrupt(at)) : assert(at == la"
    "st - 3),\n        _                : assert(false),\n    }\n}export fn gzip(slice<u8, shared> data) : V"
    "ec<u8>\n{\n    Vec<u8> out = Vec::new();\n    array<u8, 10> header = [0x1F, 0x8B, 8, 0, 0, 0, 0, 0, 0, "
    "255];\n    Vec::extend_from(&mut out, &header[0..$]);\n    Vec::append(&mut out, deflate(data));\n    V"
    "ec::push_le(&mut out, crc32(data));\n    Vec::push_le(&mut out, narrow_wrapping<u32>(slice_len(data))"
    ");\n    out\n}export fn gunzip(slice<u8, shared> data, usize max) : Result<Vec<u8>, CompressError>\n{\n "
    "   Vec<u8> out = Vec::new();\n    usize at = 0;\n    usize n = slice_len(data);\n    while (true)\n    {"
    "\n        if (at + 10 > n)\n        {\n            return Err(Truncated);\n        }\n        if (data[at"
    "] != 0x1F || data[at + 1] != 0x8B || data[at + 2] != 8)\n        {\n            return Err(Corrupt(at)"
    ");\n        }\n        u8 flags = data[at + 3];\n        usize p = at + 10;\n        if ((flags & 4) != "
    "0)\n        {\n            if (p + 2 > n)\n            {\n                return Err(Truncated);\n       "
    "     }\n            p += 2 + widen<usize>(read_le<u16>(data, p));\n        }\n        if ((flags & 8) !"
    "= 0)\n        {\n            while (p < n && data[p] != 0)\n            {\n                p += 1;\n     "
    "       }\n            p += 1;\n        }\n        if ((flags & 16) != 0)\n        {\n            while (p"
    " < n && data[p] != 0)\n            {\n                p += 1;\n            }\n            p += 1;\n      "
    "  }\n        if ((flags & 2) != 0)\n        {\n            p += 2;\n        }\n        if (p > n)\n       "
    " {\n            return Err(Truncated);\n        }\n        usize before = Vec::len(&out);\n        usize"
    " end = inflate_from(data, p, &mut out, max)?;\n        if (end + 8 > n)\n        {\n            return "
    "Err(Truncated);\n        }\n        if (read_le<u32>(\n            data,\n            end,\n        ) != "
    "crc32(&out[before..$]) || read_le<u32>(data, end + 4) != narrow_wrapping<u32>(Vec::len(&out) - befor"
    "e))\n        {\n            return Err(Corrupt(end));\n        }\n        at = end + 8;\n        if (at >"
    "= n)\n        {\n            return Ok(out);\n        }\n    }\n}unittest \"gunzip: round trip and the siz"
    "e limit\"\n{\n    Vec<u8> data = Vec::filled(1000, b'a');\n    Vec<u8> packed = gzip(&data[0..$]);\n    a"
    "ssert(Vec::len(&packed) < 100);\n    Vec<u8> back = Result::unwrap(gunzip(&packed[0..$], 1000));\n    "
    "assert(Vec::len(&back) == 1000 && back[999] == b'a');\n    match (gunzip(&packed[0..$], 999))\n    {\n "
    "       Err(Oversize) : {},\n        _             : assert(false),\n    }\n}export fn NulError::text(re"
    "f<NulError, shared> e) : str\n{\n    \"holds a NUL byte\"\n}export fn CString::from_bytes(slice<u8, share"
    "d> b) : Result<CString, NulError>\n{\n    usize n = slice_len(b);\n    Vec<u8> bytes = Vec::new();\n    "
    "Vec::reserve(&mut bytes, n + 1);\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (b[i] == 0)\n "
    "       {\n            return Err(NulError { .offset = i });\n        }\n        Vec::push(&mut bytes, b"
    "[i]);\n    }\n    Vec::push(&mut bytes, 0);\n    Ok(CString { .bytes = bytes })\n}export fn CString::new"
    "(StringView s) : Result<CString, NulError>\n{\n    CString::from_bytes(StringView::as_bytes(s))\n}expor"
    "t fn CString::ptr(ref<CString, shared> c) : rawptr<u8>\n{\n    rawptr_of(&c.bytes[0])\n}export fn CStri"
    "ng::len(ref<CString, shared> c) : usize\n{\n    Vec::len(&c.bytes) - 1\n}export fn CString::as_bytes(re"
    "f<CString, shared> c) : slice<u8, shared>\n{\n    &c.bytes[0 .. Vec::len(&c.bytes) - 1]\n}export fn cop"
    "y_to_raw<T: plain>(slice<T, shared> s, rawptr<T> p)\n{\n    usize n = slice_len(s);\n    if (n == 0)\n  "
    "  {\n        return;\n    }\n    if (p == null_rawptr<T>())\n    {\n        fault(null_pointer);\n    }\n  "
    "  // trusted: [Copy-Raw] of the slice's n * sizeof<T>() bytes (readable: the slice's own path covers"
    " them) to `p`, the caller's assertion in its `unsafe` that `p` has room for them and that no live ob"
    "ject's cells lie there (a [Trusted-Call], spec/20 §1); T is `plain`, so the bytes are the elements."
    "\n    unsafe\n    {\n        copy_raw(reinterpret_ptr<u8>(p), reinterpret_ptr<u8>(rawptr_of(&s[0])), n "
    "* sizeof<T>());\n    }\n}export fn is_null<T>(rawptr<T> p) : bool\n{\n    p == null_rawptr<T>()\n}";

// Where the prelude's lines came from in `std`'s files
// (`prelude::std_location`): one record a line, `first_line file
// file_line count`.
