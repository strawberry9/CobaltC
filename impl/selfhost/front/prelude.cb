    " &db[db_len - s_len..$]);\n    Vec<u8> h2 = hash(kind, &m2[0..$]);\n    digest_eq(&h2[0..$], &em[db_le"
    "n..db_len + h_len])\n}fn field_of(EcCurve c, bool order) : Field\n{\n    match (c)\n    {\n        P256 :"
