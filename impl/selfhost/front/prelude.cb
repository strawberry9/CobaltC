    "f.cap > 0)\n    {\n        unsafe\n        {\n            deallocate(reinterpret_ptr<u8>(self.ptr), self"
    ".cap * sizeof<T>(), alignof<T>());\n        }\n    }\n}fn key_before<T>(ref<T, shared> a, ref<T, shared"
    "> b) : bool\n{\n    key_less(a, b)\n}fn Vec::sorted_order<T>(ref<Vec<T>, shared> v, fn(ref<T, shared>, "
    "ref<T, shared>) : bool less) : Vec<usize>\n{\n    usize n = v.len;\n    Vec<usize> a = Vec::new();\n    "
    "Vec<usize> b = Vec::new();\n    usize i = 0;\n    while (i < n)\n    {\n        Vec::push(&mut a, i);\n  "
    "      Vec::push(&mut b, 0);\n        i += 1;\n    }\n    usize width = 1;\n    while (width < n)\n    {\n "
    "       usize lo = 0;\n        while (lo < n)\n        {\n            usize mid = if (n - lo > width)\n  "
    "          {\n                lo + width\n            }\n            else\n            {\n                "
    "n\n            };\n            usize hi = if (n - mid > width)\n            {\n                mid + wid"
    "th\n            }\n            else\n            {\n                n\n            };\n            usize l"
    " = lo;\n            usize r = mid;\n            usize k = lo;\n            while (k < hi)\n            {"
    "\n                // From the left run unless the right one's element is\n                // strictly "
    "less: equal elements keep their order.\n                bool take_left = l < mid && (r >= hi || !less"
    "(Vec::index_shared(v, a[r]), Vec::index_shared(v, a[l])));\n                if (take_left)\n          "
    "      {\n                    b[k] = a[l];\n                    l += 1;\n                }\n             "
    "   else\n                {\n                    b[k] = a[r];\n                    r += 1;\n             "
