    "y.rounds; round += 1)\n    {\n        q = aes_shift_rows(aes_sbox_ct(q));\n        if (round < key.roun"
    "ds)\n        {\n            q = aes_mix_columns(q);\n        }\n        for (usize p = 0; p < 8; p += 1)"
    "\n        {\n            q[p] = q[p] ^ key.sk[8 * round + p];\n        }\n    }\n    q\n}fn aes_block(ref<"
    "AesKey, shared> key, array<u8, 16> input) : array<u8, 16>\n{\n    array<u8, 64> b = [0; 64];\n    for ("
    "usize i = 0; i < 16; i += 1)\n    {\n        b[i] = input[i];\n    }\n    array<u8, 64> e = aes_unpack(a"
    "es_encrypt4(key, aes_pack(b)));\n    array<u8, 16> out = [0; 16];\n    for (usize i = 0; i < 16; i += "
