    "    Empty      : \"empty\",\n        Invalid(_) : \"not a number\",\n        OutOfRange : \"out of range\",\n"
    "    }\n}export fn Utf8Error::text(ref<Utf8Error, shared> e) : str\n{\n    \"not UTF-8\"\n}fn utf8_error_at"
    "(slice<u8, shared> b) : usize\n{\n    usize n = slice_len(b);\n    usize i = 0;\n    while (i < n)\n    {"
    "\n        u8 c0 = b[i];\n        usize width =\n            if (c0 < 128)\n            {\n               "
    " 1\n            }\n            else if ((c0 & 224) == 192 && c0 >= 194)\n            {\n                "
    "2\n            }\n            else if ((c0 & 240) == 224)\n            {\n                3\n            "
    "}\n            else if ((c0 & 248) == 240 && c0 <= 244)\n            {\n                4\n            }"
    "\n            else\n            {\n                return i;\n            };\n        if (i + width > n)\n"
    "        {\n            return i;\n        }\n        usize k = 1;\n        while (k < width)\n        {\n "
    "           u8 c = b[i + k];\n            if ((c & 192) != 128)\n            {\n                return i"
    " + k;\n            }\n            k = k + 1;\n        }\n        if (width == 3)\n        {\n            u"
    "8 c1 = b[i + 1];\n            if ((c0 == 224 && c1 < 160) || (c0 == 237 && c1 >= 160))\n            {\n"
    "                return i;\n            }\n        }\n        if (width == 4)\n        {\n            u8 c"
    "1 = b[i + 1];\n            if ((c0 == 240 && c1 < 144) || (c0 == 244 && c1 >= 144))\n            {\n   "
    "             return i;\n            }\n        }\n        i = i + width;\n    }\n    n\n}export fn String:"
    ":from_utf8(Vec<u8> bytes) : Result<String, Utf8Error>\n{\n    usize at = utf8_error_at(&bytes[0..$]);\n"
