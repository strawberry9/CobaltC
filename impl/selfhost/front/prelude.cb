    "ut members))\n        {\n            Vec::push(&mut items, tnode_to_toml(m));\n        }\n        Vec::r"
    "everse(&mut items);\n        return TomlArray(items);\n    }\n    Vec<TomlMember> out = Vec::new();\n   "
