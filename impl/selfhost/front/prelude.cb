    ".fill += 1;\n            i += 1;\n            if (s.fill == 64)\n            {\n                s.h = sh"
    "a1_block(s.h, s.block);\n                s.fill = 0;\n            }\n        }\n    }\n    s.length = wra"
    "pping_add(s.length, widen<u64>(n));\n    s\n}export fn Sha1::update(ref<Sha1, exclusive> s, slice<u8, "
