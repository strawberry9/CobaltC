export const str PRELUDE_BODIES =
    "fn byte_op(\n    usize which,\n    usize op,\n    usize h,\n    rawptr<u8> a,\n    usize an,\n    rawptr<u"
    "8> b,\n    usize bn,\n    rawptr<u8> out,\n    usize cap,\n) : i64\n{\n    unsafe\n    {\n        match (whi"
    "ch)\n        {\n            0 : path_op(op, h, a, an, b, bn, out, cap),\n            1 : proc_op(op, h,"
    " a, an, b, bn, out, cap),\n            _ : net_op(op, h, a, an, b, bn, out, cap),\n        }\n    }\n}fn"
    " byte_answer(usize which, usize op, usize h, slice<u8, shared> a, slice<u8, shared> b) : Result<Vec<"
    "u8>, i64>\n{\n    Vec<u8> out = Vec::new();\n    usize cap = 256;\n    while (true)\n    {\n        while "
    "(out.cap < cap)\n        {\n            Vec::grow(&mut out);\n        }\n        i64 n = byte_op(\n      "
    "      which,\n            op,\n            h,\n            bytes_ptr(a),\n            slice_len(a),\n    "
    "        bytes_ptr(b),\n            slice_len(b),\n            reinterpret_ptr<u8>(out.ptr),\n          "
    "  cap,\n        );\n        if (n < 0)\n        {\n            return Err(n);\n        }\n        usize le"
    "n = reinterpret<usize>(n);\n        if (len <= cap)\n        {\n            out.len = len;\n            "
    "return Ok(out);\n        }\n        cap = len;\n    }\n}fn bytes_ptr(slice<u8, shared> s) : rawptr<u8>\n{"
    "\n    if (slice_len(s) == 0)\n    {\n        return dangling<u8>();\n    }\n    rawptr_of(&s[0])\n}fn code"
    "_error(i64 code) : FileError\n{\n    if (code == -1)\n    {\n        return FileError::NotFound;\n    }\n "
    "   if (code == -2)\n    {\n        return FileError::Denied;\n    }\n    FileError::Io\n}fn file_error(is"
    "ize code) : FileError\n{\n    if (code == -1)\n    {\n        return FileError::NotFound;\n    }\n    if ("
    "code == -2)\n    {\n        return FileError::Denied;\n    }\n    FileError::Io\n}fn fs_answer(usize op, "
    "rawptr<u8> a, usize an) : Result<Vec<u8>, isize>\n{\n    Vec<u8> out = Vec::new();\n    usize cap = 256"
    ";\n    while (true)\n    {\n        while (out.cap < cap)\n        {\n            Vec::grow(&mut out);\n  "
    "      }\n        isize n = unsafe\n        {\n            fs_query(op, a, an, reinterpret_ptr<u8>(out.p"
    "tr), cap)\n        };\n        if (n < 0)\n        {\n            return Err(n);\n        }\n        usize"
    " len = reinterpret<usize>(n);\n        if (len <= cap)\n        {\n            out.len = len;\n         "
    "   return Ok(out);\n        }\n        cap = len;\n    }\n}fn path_text(StringView a, StringView b, usiz"
    "e op) : Option<String>\n{\n    match (byte_answer(0, op, 0, a.bytes, b.bytes))\n    {\n        Ok(v) : m"
    "atch (String::from_utf8(v))\n        {\n            Ok(s)  : Some(s),\n            Err(_) : None,\n     "
    "   },\n        Err(_) : None,\n    }\n}fn path_result(usize op, StringView a, StringView b) : Result<i6"
    "4, FileError>\n{\n    i64 r = byte_op(\n        0,\n        op,\n        0,\n        StringView::ptr(a),\n "
    "       StringView::len(a),\n        StringView::ptr(b),\n        StringView::len(b),\n        dangling<"
    "u8>(),\n        0,\n    );\n    if (r < 0)\n    {\n        return Err(code_error(r));\n    }\n    Ok(r)\n}ex"
    "port fn Option::unwrap_or<T>(Option<T> o, T d) : T\n{\n    match (o)\n    {\n        Some(v) : v,\n      "
    "  None    : d,\n    }\n}export fn Option::ok_or<T, E>(Option<T> o, E e) : Result<T, E>\n{\n    match (o)"
    "\n    {\n        Some(v) : Ok(v),\n        None    : Err(e),\n    }\n}export fn Result::ok<T, E>(Result<T"
    ", E> r) : Option<T>\n{\n    match (r)\n    {\n        Ok(v)  : Some(v),\n        Err(_) : None,\n    }\n}ex"
    "port fn Result::unwrap_or<T, E>(Result<T, E> r, T d) : T\n{\n    match (r)\n    {\n        Ok(v)  : v,\n "
    "       Err(_) : d,\n    }\n}export fn Option::unwrap<T>(Option<T> o) : T\n{\n    match (o)\n    {\n       "
    " Some(v) : v,\n        None    : fault(unwrap_failed, \"`Option::unwrap` found `None`\"),\n    }\n}export"
    " fn Option::expect<T>(Option<T> o, str message) : T\n{\n    match (o)\n    {\n        Some(v) : v,\n     "
    "   None    : fault(unwrap_failed, message),\n    }\n}export fn Result::unwrap<T, E>(Result<T, E> r) : "
    "T\n{\n    match (r)\n    {\n        Ok(v)  : v,\n        Err(_) : fault(unwrap_failed, \"`Result::unwrap` "
    "found `Err`\"),\n    }\n}export fn Result::expect<T, E>(Result<T, E> r, str message) : T\n{\n    match (r"
    ")\n    {\n        Ok(v)  : v,\n        Err(_) : fault(unwrap_failed, message),\n    }\n}export fn Option:"
    ":is_some<T>(ref<Option<T>, shared> o) : bool\n{\n    match (o)\n    {\n        Some(_) : true,\n        N"
    "one    : false,\n    }\n}export fn Option::is_none<T>(ref<Option<T>, shared> o) : bool\n{\n    !Option::"
    "is_some(o)\n}export fn Result::is_ok<T, E>(ref<Result<T, E>, shared> r) : bool\n{\n    match (r)\n    {\n"
    "        Ok(_)  : true,\n        Err(_) : false,\n    }\n}export fn Result::is_err<T, E>(ref<Result<T, E"
    ">, shared> r) : bool\n{\n    !Result::is_ok(r)\n}export fn swap<T>(ref<T, exclusive> a, ref<T, exclusiv"
    "e> b)\n{\n    swap_places(a, b);\n}export fn replace<T>(ref<T, exclusive> r, T v) : T\n{\n    auto old = "
    "v;\n    swap_places(r, &mut old);\n    old\n}export fn overwrite<T>(ref<T, exclusive> r, T v)\n{\n    dro"
    "p(replace(r, v));\n}export fn Vec::new<T>() : Vec<T>\n{\n    Vec { .ptr = dangling<T>(), .len = 0, .cap"
    " = 0 }\n}export fn Vec::len<T>(ref<Vec<T>, shared> v) : usize\n{\n    v.len\n}export fn Vec::push<T>(ref"
    "<Vec<T>, exclusive> v, T x)\n{\n    if (v.len == v.cap)\n    {\n        Vec::grow(v);\n    }\n    unsafe\n "
    "   {\n        *(v.ptr + reinterpret<isize>(v.len)) = x;\n    }\n    v.len = v.len + 1;\n}export fn Vec::"
    "pop<T>(ref<Vec<T>, exclusive> v) : Option<T>\n{\n    if (v.len == 0)\n    {\n        return None;\n    }\n"
    "    v.len = v.len - 1;\n    unsafe\n    {\n        rawptr<T> p = v.ptr + reinterpret<isize>(v.len);\n   "
    "     auto x = *p;\n        release(reinterpret_ptr<u8>(p), sizeof<T>());\n        Some(x)\n    }\n}expor"
    "t fn Vec::index_shared<T>(ref<Vec<T>, shared> v, usize i) : ref<T, shared>\n{\n    if (i >= v.len)\n   "
    " {\n        fault(index_out_of_bounds);\n    }\n    unsafe\n    {\n        &reclaim<T>(v.ptr + reinterpre"
    "t<isize>(i))\n    }\n}export fn Vec::index_exclusive<T>(ref<Vec<T>, exclusive> v, usize i) : ref<T, ex"
    "clusive>\n{\n    if (i >= v.len)\n    {\n        fault(index_out_of_bounds);\n    }\n    // D-0222: elemen"
    "t i of `*v` is accessed exclusively through `v`, as `[Index-Vec]` checks `(*v)[i]`\n    // written: a"
    " live shared path to the vector, or a slice holding i, meets it.\n    _ = &mut (*v)[i .. i + 1];\n    "
    "unsafe\n    {\n        &mut reclaim<T>(v.ptr + reinterpret<isize>(i))\n    }\n}fn Vec::grow<T>(ref<Vec<T"
    ">, exclusive> v)\n{\n    usize new_cap = if (v.cap == 0)\n    {\n        4\n    }\n    else\n    {\n        "
    "v.cap * 2\n    };\n    usize bytes = new_cap * sizeof<T>();\n    rawptr<u8> p = match (allocate(bytes, "
    "alignof<T>()))\n    {\n        Ok(p)  : p,\n        Err(_) : fault(alloc_failure),\n    };\n    rawptr<u8"
    "> old = reinterpret_ptr<u8>(v.ptr);\n    usize old_cap = v.cap;\n    unsafe\n    {\n        copy_raw(p, "
    "old, v.len * sizeof<T>());\n    }\n    // The two checked writes before the old cells go (CHG-0332): a"
    " write\n    // that faults (this exclusive path's first write meeting a shared path\n    // of the sam"
    "e `Vec`, D-0022) leaves `v` as it was, so the unwind's\n    // `Vec::drop` frees the old cells once; "
    "the new block is then lost\n    // with the thread.\n    v.ptr = reinterpret_ptr<T>(p);\n    v.cap = ne"
    "w_cap;\n    unsafe\n    {\n        if (old_cap > 0)\n        {\n            deallocate(old, old_cap * siz"
    "eof<T>(), alignof<T>());\n        }\n    }\n}export fn Vec::reserve<T>(ref<Vec<T>, exclusive> v, usize "
    "n)\n{\n    usize need = v.len + n;\n    if (need <= v.cap)\n    {\n        return;\n    }\n    usize new_ca"
    "p = if (v.cap > need - v.cap)\n    {\n        v.cap * 2\n    }\n    else\n    {\n        need\n    };\n    u"
    "size bytes = new_cap * sizeof<T>();\n    rawptr<u8> p = match (allocate(bytes, alignof<T>()))\n    {\n "
    "       Ok(p)  : p,\n        Err(_) : fault(alloc_failure),\n    };\n    rawptr<u8> old = reinterpret_pt"
    "r<u8>(v.ptr);\n    usize old_cap = v.cap;\n    unsafe\n    {\n        copy_raw(p, old, v.len * sizeof<T>"
    "());\n    }\n    // The two checked writes before the old cells go (CHG-0332): a write\n    // that fau"
    "lts (this exclusive path's first write meeting a shared path\n    // of the same `Vec`, D-0022) leave"
