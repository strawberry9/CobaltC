    "m, u64 hibit)\n{\n    p.h = poly1305_blocks(p.h, p.r, m, hibit);\n}fn poly1305_blocks(array<u64, 5> h, "
    "array<u64, 5> r, slice<u8, shared> m, u64 hibit) : array<u64, 5>\n{\n    u64 m26 = 0x3ffffff;\n    u64 "
    "r0 = r[0];\n    u64 r1 = r[1];\n    u64 r2 = r[2];\n    u64 r3 = r[3];\n    u64 r4 = r[4];\n    u64 s1 = "
