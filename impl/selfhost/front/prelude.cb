    "    {\n            if (last)\n            {\n                Vec::push(&mut n.members, tnode_new(String"
    "::copy(part), K_VALUE, v));\n                return true;\n            }\n            Vec::push(&mut n."
    "members, tnode_new(String::copy(part), K_DOTTED, TomlBool(false)));\n            usize k = Vec::len(&"
    "n.members) - 1;\n            tnode_insert(&mut n.members[k], ctx, ci, keys, ki + 1, v)\n        },\n   "
    " }\n}fn tnode_to_toml(TNode n) : Toml\n{\n    TNode { key, kind, leaf, members } = n;\n    drop(key);\n  "
    "  if (kind == K_VALUE)\n    {\n        drop(members);\n        return leaf;\n    }\n    drop(leaf);\n    i"
