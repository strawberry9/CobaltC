    " = narrow_wrapping<u8>(h[i] >> 16);\n        out[4 * i + 2] = narrow_wrapping<u8>(h[i] >> 8);\n       "
    " out[4 * i + 3] = narrow_wrapping<u8>(h[i]);\n    }\n    out\n}export fn sha1(slice<u8, shared> data) :"
