    ", b);\n    out[2] = wrapping_add(h[2], c);\n    out[3] = wrapping_add(h[3], d);\n    out[4] = wrapping_"
    "add(h[4], e);\n    out\n}fn sha1_absorb(Sha1 s, slice<u8, shared> data) : Sha1\n{\n    usize n = slice_l"
