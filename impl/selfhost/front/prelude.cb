    "a1::new(), .s256 = Sha256::new(), .s512 = match (kind)\n    {\n        Sha2_384 : Sha384::new().inner,"
    "\n        _        : Sha512::new(),\n    } }\n}export fn Hasher::update(ref<Hasher, exclusive> h, slice"
    "<u8, shared> data)\n{\n    match (h.kind)\n    {\n        Sha1     : Sha1::update(&mut h.s1, data),\n    "
    "    Sha2_256 : Sha256::update(&mut h.s256, data),\n        _        : Sha512::update(&mut h.s512, dat"
    "a),\n    }\n}export fn Hasher::finish(Hasher h) : Vec<u8>\n{\n    match (h.kind)\n    {\n        Sha1     "
    ": Vec::from_slice(&Sha1::finish(h.s1)[0..$]),\n        Sha2_256 : Vec::from_slice(&Sha256::finish(h.s"
    "256)[0..$]),\n        Sha2_384 : Vec::from_slice(&Sha384::finish(Sha384 { .inner = h.s512 })[0..$]),\n"
    "        Sha2_512 : Vec::from_slice(&Sha512::finish(h.s512)[0..$]),\n    }\n}fn blake2b_block(array<u64"
    ", 8> h, array<u8, 128> blk, u64 length, bool last) : array<u64, 8>\n{\n    array<u64, 16> m = [0; 16];"
    "\n    for (usize i = 0; i < 16; i += 1)\n    {\n        u64 x = 0;\n        for (usize j = 0; j < 8; j +"
    "= 1)\n        {\n            x = x | (widen<u64>(blk[8 * i + j]) << narrow<u32>(8 * j));\n        }\n   "
    "     m[i] = x;\n    }\n    array<u64, 16> v = [0; 16];\n    for (usize i = 0; i < 8; i += 1)\n    {\n    "
    "    v[i] = h[i];\n        v[8 + i] = BLAKE2B_IV[i];\n    }\n    v[12] = v[12] ^ length;\n    if (last)\n "
    "   {\n        v[14] = ~v[14];\n    }\n    for (usize r = 0; r < 12; r += 1)\n    {\n        usize o = 16 "
    "* (r % 10);\n        for (usize g = 0; g < 8; g += 1)\n        {\n            usize a = widen<usize>(BL"
    "AKE2B_G[4 * g]);\n            usize b = widen<usize>(BLAKE2B_G[4 * g + 1]);\n            usize c = wid"
    "en<usize>(BLAKE2B_G[4 * g + 2]);\n            usize d = widen<usize>(BLAKE2B_G[4 * g + 3]);\n         "
    "   u64 x = m[widen<usize>(BLAKE2B_SIGMA[o + 2 * g])];\n            u64 y = m[widen<usize>(BLAKE2B_SIG"
    "MA[o + 2 * g + 1])];\n            v[a] = wrapping_add(wrapping_add(v[a], v[b]), x);\n            v[d] "
    "= rotate_right(v[d] ^ v[a], 32);\n            v[c] = wrapping_add(v[c], v[d]);\n            v[b] = rot"
    "ate_right(v[b] ^ v[c], 24);\n            v[a] = wrapping_add(wrapping_add(v[a], v[b]), y);\n          "
    "  v[d] = rotate_right(v[d] ^ v[a], 16);\n            v[c] = wrapping_add(v[c], v[d]);\n            v[b"
    "] = rotate_right(v[b] ^ v[c], 63);\n        }\n    }\n    array<u64, 8> out = h;\n    for (usize i = 0; "
    "i < 8; i += 1)\n    {\n        out[i] = h[i] ^ v[i] ^ v[8 + i];\n    }\n    out\n}fn blake2b_absorb(Blake"
    "2b s, slice<u8, shared> data) : Blake2b\n{\n    usize at = 0;\n    usize n = slice_len(data);\n    while"
    " (at < n)\n    {\n        if (s.fill == 128)\n        {\n            s.length += 128;\n            s.h = "
    "blake2b_block(s.h, s.block, s.length, false);\n            s.fill = 0;\n        }\n        usize take ="
    " min(128 - s.fill, n - at);\n        for (usize i = 0; i < take; i += 1)\n        {\n            s.bloc"
    "k[s.fill + i] = data[at + i];\n        }\n        s.fill += take;\n        at += take;\n    }\n    s\n}exp"
    "ort fn Blake2b::new_keyed(slice<u8, shared> key, usize out_len) : Blake2b\n{\n    usize klen = slice_l"
    "en(key);\n    if (out_len == 0 || out_len > 64 || klen > 64)\n    {\n        fault(crypto_length);\n    "
    "}\n    array<u64, 8> h = BLAKE2B_IV;\n    h[0] = h[0] ^ 0x01010000 ^ (widen<u64>(klen) << 8) ^ widen<u"
    "64>(out_len);\n    Blake2b s = Blake2b { .h = h, .block = [0; 128], .fill = 0, .length = 0, .out_len "
    "= out_len };\n    if (klen > 0)\n    {\n        for (usize i = 0; i < klen; i += 1)\n        {\n         "
    "   s.block[i] = key[i];\n        }\n        s.fill = 128;\n    }\n    s\n}export fn Blake2b::new(usize ou"
    "t_len) : Blake2b\n{\n    Vec<u8> none = Vec::new();\n    Blake2b::new_keyed(&none[0..$], out_len)\n}expo"
    "rt fn Blake2b::update(ref<Blake2b, exclusive> s, slice<u8, shared> data)\n{\n    *s = blake2b_absorb(*"
    "s, data);\n}export fn Blake2b::finish(Blake2b s) : Vec<u8>\n{\n    s.length += widen<u64>(s.fill);\n    "
    "for (usize i = s.fill; i < 128; i += 1)\n    {\n        s.block[i] = 0;\n    }\n    s.h = blake2b_block("
    "s.h, s.block, s.length, true);\n    Vec<u8> out = Vec::new();\n    for (usize i = 0; i < s.out_len; i "
    "+= 1)\n    {\n        Vec::push(&mut out, narrow_wrapping<u8>(s.h[i / 8] >> narrow<u32>(8 * (i % 8))))"
    ";\n    }\n    out\n}export fn blake2b(slice<u8, shared> data, usize out_len) : Vec<u8>\n{\n    Blake2b s "
    "= Blake2b::new(out_len);\n    Blake2b::update(&mut s, data);\n    Blake2b::finish(s)\n}unittest \"blake2"
    "b: the published vector for abc\"\n{\n    Vec<u8> d = blake2b(&b\"abc\"[0..$], 64);\n    String want = Str"
    "ing::from_str(\"ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d1\");\n    String::appen"
    "d(&mut want, \"7d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923\");\n    assert(String:"
    ":eq(&to_hex(&d[0..$]), &want));\n}export fn crc32(slice<u8, shared> data) : u32\n{\n    u32 crc = 0xFFF"
    "FFFFF;\n    for (usize i = 0; i < slice_len(data); i += 1)\n    {\n        crc = crc ^ widen<u32>(data["
    "i]);\n        for (u32 k = 0; k < 8; k += 1)\n        {\n            if ((crc & 1) == 1)\n            {\n"
    "                crc = (crc >> 1) ^ 0xEDB88320;\n            }\n            else\n            {\n        "
    "        crc = crc >> 1;\n            }\n        }\n    }\n    crc ^ 0xFFFFFFFF\n}unittest \"crc32: the che"
    "ck value\"\n{\n    assert(crc32(&b\"123456789\"[0..$]) == 0xCBF43926);\n}export fn digest_eq(slice<u8, sha"
    "red> a, slice<u8, shared> b) : bool\n{\n    if (slice_len(a) != slice_len(b))\n    {\n        return fal"
    "se;\n    }\n    u8 acc = 0;\n    for (usize i = 0; i < slice_len(a); i += 1)\n    {\n        acc = acc | "
    "(a[i] ^ b[i]);\n    }\n    acc == 0\n}unittest \"digest_eq: the lengths must match too\"\n{\n    array<u8, "
    "3> a = [1, 2, 3];\n    array<u8, 4> b = [1, 2, 3, 0];\n    assert(digest_eq(&a[0..$], &b[0..3]));\n    "
    "assert(!digest_eq(&a[0..$], &b[0..$]));\n}export fn HmacSha256::new(slice<u8, shared> key) : HmacSha2"
    "56\n{\n    array<u8, 64> k = [0; 64];\n    if (slice_len(key) > 64)\n    {\n        array<u8, 32> d = sha"
    "256(key);\n        for (usize i = 0; i < 32; i += 1)\n        {\n            k[i] = d[i];\n        }\n   "
    " }\n    else\n    {\n        for (usize i = 0; i < slice_len(key); i += 1)\n        {\n            k[i] ="
    " key[i];\n        }\n    }\n    array<u8, 64> ipad = [0; 64];\n    array<u8, 64> opad = [0; 64];\n    for"
    " (usize i = 0; i < 64; i += 1)\n    {\n        ipad[i] = k[i] ^ 0x36;\n        opad[i] = k[i] ^ 0x5c;\n "
    "   }\n    Sha256 inner = Sha256::new();\n    Sha256::update(&mut inner, &ipad[0..$]);\n    Sha256 outer"
    " = Sha256::new();\n    Sha256::update(&mut outer, &opad[0..$]);\n    HmacSha256 { .inner = inner, .out"
    "er = outer }\n}export fn HmacSha256::update(ref<HmacSha256, exclusive> m, slice<u8, shared> data)\n{\n "
    "   Sha256::update(&mut m.inner, data);\n}export fn HmacSha256::finish(HmacSha256 m) : array<u8, 32>\n{"
    "\n    array<u8, 32> inner_digest = Sha256::finish(m.inner);\n    Sha256 outer = m.outer;\n    Sha256::u"
    "pdate(&mut outer, &inner_digest[0..$]);\n    Sha256::finish(outer)\n}export fn hmac_sha256(slice<u8, s"
    "hared> key, slice<u8, shared> data) : array<u8, 32>\n{\n    HmacSha256 m = HmacSha256::new(key);\n    H"
    "macSha256::update(&mut m, data);\n    HmacSha256::finish(m)\n}unittest \"hmac_sha256: an RFC 4231 vecto"
    "r\"\n{\n    array<u8, 32> mac = hmac_sha256(&b\"Jefe\"[0..$], &b\"what do ya want for nothing?\"[0..$]);\n  "
    "  String hex = to_hex(&mac[0..$]);\n    assert(String::eq_str(&hex, \"5bdcc146bf60754e6a042426089575c7"
    "5a003f089d2739839dec58b964ec3843\"));\n}export fn hkdf_extract(slice<u8, shared> salt, slice<u8, share"
    "d> ikm) : array<u8, 32>\n{\n    if (slice_len(salt) == 0)\n    {\n        array<u8, 32> zero = [0; 32];\n"
    "        return hmac_sha256(&zero[0..$], ikm);\n    }\n    hmac_sha256(salt, ikm)\n}export fn hkdf_expan"
    "d(slice<u8, shared> prk, slice<u8, shared> info, usize len) : Vec<u8>\n{\n    if (len > 8160)\n    {\n  "
    "      fault(hkdf_length);\n    }\n    Vec<u8> out = Vec::new();\n    Vec::reserve(&mut out, len);\n    a"
    "rray<u8, 32> t = [0; 32];\n    usize have = 0;\n    u8 counter = 1;\n    while (Vec::len(&out) < len)\n "
    "   {\n        HmacSha256 m = HmacSha256::new(prk);\n        HmacSha256::update(&mut m, &t[0..have]);\n "
    "       HmacSha256::update(&mut m, info);\n        array<u8, 1> c = [counter];\n        HmacSha256::upd"
    "ate(&mut m, &c[0..$]);\n        t = HmacSha256::finish(m);\n        have = 32;\n        for (usize i = "
    "0; i < 32 && Vec::len(&out) < len; i += 1)\n        {\n            Vec::push(&mut out, t[i]);\n        "
    "}\n        if (Vec::len(&out) < len)\n        {\n            counter += 1;\n        }\n    }\n    out\n}exp"
    "ort fn hkdf_sha256(slice<u8, shared> salt, slice<u8, shared> ikm, slice<u8, shared> info, usize len)"
    " : Vec<u8>\n{\n    array<u8, 32> prk = hkdf_extract(salt, ikm);\n    hkdf_expand(&prk[0..$], info, len)"
    "\n}unittest \"hkdf_sha256: RFC 5869 test case A.3\"\n{\n    Vec<u8> ikm = Vec::filled(22, 0x0b: u8);\n    "
    "Vec<u8> none = Vec::new();\n    Vec<u8> okm = hkdf_sha256(&none[0..$], &ikm[0..$], &none[0..$], 42);\n"
    "    String want = String::from_str(\"8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec345\");\n    Stri"
    "ng::append(&mut want, \"4e5f3c738d2d9d201395faa4b61a96c8\");\n    assert(String::eq(&to_hex(&okm[0..$])"
    ", &want));\n}export fn hkdf_expand_label(slice<u8, shared> secret, StringView label, slice<u8, shared"
    "> context, usize len) : Vec<u8>\n{\n    // Over 65535 is over 255 blocks of every hash: `hkdf_length`,"
    " as\n    // `hkdf_expand` would say, not the narrowing below.\n    if (len > 65_535)\n    {\n        fau"
    "lt(hkdf_length);\n    }\n    Vec<u8> info = Vec::new();\n    Vec::push_be(&mut info, narrow<u16>(len));"
    "\n    Vec::push(&mut info, narrow<u8>(6 + StringView::len(label)));\n    Vec::extend_from(&mut info, &"
    "b\"tls13 \"[0..$]);\n    Vec::extend_from(&mut info, label.bytes);\n    Vec::push(&mut info, narrow<u8>("
    "slice_len(context)));\n    Vec::extend_from(&mut info, context);\n    hkdf_expand(secret, &info[0..$],"
    " len)\n}export fn Hmac::new(HashKind kind, slice<u8, shared> key) : Hmac\n{\n    usize b = block_len(ki"
    "nd);\n    Vec<u8> k = Vec::filled(b, 0: u8);\n    if (slice_len(key) > b)\n    {\n        Vec<u8> d = ha"
    "sh(kind, key);\n        for (usize i = 0; i < Vec::len(&d); i += 1)\n        {\n            k[i] = d[i]"
    ";\n        }\n    }\n    else\n    {\n        for (usize i = 0; i < slice_len(key); i += 1)\n        {\n   "
    "         k[i] = key[i];\n        }\n    }\n    Vec<u8> ipad = Vec::filled(b, 0: u8);\n    array<u8, 128>"
    " opad = [0; 128];\n    for (usize i = 0; i < b; i += 1)\n    {\n        ipad[i] = k[i] ^ 0x36;\n        "
    "opad[i] = k[i] ^ 0x5c;\n    }\n    Hasher inner = Hasher::new(kind);\n    Hasher::update(&mut inner, &i"
    "pad[0..$]);\n    Hmac { .inner = inner, .outer_key = opad }\n}export fn Hmac::update(ref<Hmac, exclusi"
    "ve> m, slice<u8, shared> data)\n{\n    Hasher::update(&mut m.inner, data);\n}export fn Hmac::finish(Hma"
    "c m) : Vec<u8>\n{\n    HashKind kind = m.inner.kind;\n    Vec<u8> inner_digest = Hasher::finish(m.inner"
    ");\n    Hasher outer = Hasher::new(kind);\n    Hasher::update(&mut outer, &m.outer_key[0..block_len(ki"
    "nd)]);\n    Hasher::update(&mut outer, &inner_digest[0..$]);\n    Hasher::finish(outer)\n}export fn hma"
    "c(HashKind kind, slice<u8, shared> key, slice<u8, shared> data) : Vec<u8>\n{\n    Hmac m = Hmac::new(k"
    "ind, key);\n    Hmac::update(&mut m, data);\n    Hmac::finish(m)\n}unittest \"hmac: an RFC 4231 vector o"
    "ver SHA-512\"\n{\n    Vec<u8> mac = hmac(Sha2_512, &b\"Jefe\"[0..$], &b\"what do ya want for nothing?\"[0.."
    "$]);\n    String want = String::from_str(\"164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2"
    "50554\");\n    String::append(&mut want, \"9758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bc"
    "e737\");\n    assert(String::eq(&to_hex(&mac[0..$]), &want));\n}export fn hkdf_extract_with(HashKind ki"
    "nd, slice<u8, shared> salt, slice<u8, shared> ikm) : Vec<u8>\n{\n    if (slice_len(salt) == 0)\n    {\n "
    "       Vec<u8> zero = Vec::filled(hash_len(kind), 0: u8);\n        return hmac(kind, &zero[0..$], ikm"
    ");\n    }\n    hmac(kind, salt, ikm)\n}export fn hkdf_expand_with(HashKind kind, slice<u8, shared> prk,"
    " slice<u8, shared> info, usize len) : Vec<u8>\n{\n    usize h = hash_len(kind);\n    if (len > 255 * h)"
    "\n    {\n        fault(hkdf_length);\n    }\n    Vec<u8> out = Vec::new();\n    Vec::reserve(&mut out, le"
    "n);\n    Vec<u8> t = Vec::new();\n    u8 counter = 1;\n    while (Vec::len(&out) < len)\n    {\n        H"
    "mac m = Hmac::new(kind, prk);\n        Hmac::update(&mut m, &t[0..$]);\n        Hmac::update(&mut m, i"
    "nfo);\n        array<u8, 1> c = [counter];\n        Hmac::update(&mut m, &c[0..$]);\n        overwrite("
    "&mut t, Hmac::finish(m));\n        for (usize i = 0; i < h && Vec::len(&out) < len; i += 1)\n        {"
    "\n            Vec::push(&mut out, t[i]);\n        }\n        if (Vec::len(&out) < len)\n        {\n      "
    "      counter += 1;\n        }\n    }\n    out\n}export fn hkdf_with(\n    HashKind kind,\n    slice<u8, s"
    "hared> salt,\n    slice<u8, shared> ikm,\n    slice<u8, shared> info,\n    usize len,\n) : Vec<u8>\n{\n   "
    " Vec<u8> prk = hkdf_extract_with(kind, salt, ikm);\n    hkdf_expand_with(kind, &prk[0..$], info, len)"
    "\n}export fn hkdf_expand_label_with(\n    HashKind kind,\n    slice<u8, shared> secret,\n    StringView "
    "label,\n    slice<u8, shared> context,\n    usize len,\n) : Vec<u8>\n{\n    // Over 65535 is over 255 blo"
    "cks of every hash: `hkdf_length`, as\n    // `hkdf_expand` would say, not the narrowing below.\n    if"
    " (len > 65_535)\n    {\n        fault(hkdf_length);\n    }\n    Vec<u8> info = Vec::new();\n    Vec::push"
    "_be(&mut info, narrow<u16>(len));\n    Vec::push(&mut info, narrow<u8>(6 + StringView::len(label)));\n"
    "    Vec::extend_from(&mut info, &b\"tls13 \"[0..$]);\n    Vec::extend_from(&mut info, label.bytes);\n   "
    " Vec::push(&mut info, narrow<u8>(slice_len(context)));\n    Vec::extend_from(&mut info, context);\n   "
    " hkdf_expand_with(kind, secret, &info[0..$], len)\n}export fn pbkdf2(\n    HashKind kind,\n    slice<u8"
    ", shared> password,\n    slice<u8, shared> salt,\n    usize iterations,\n    usize len,\n) : Vec<u8>\n{\n "
    "   if (iterations == 0)\n    {\n        fault(kdf_parameters);\n    }\n    if (match (kind) { Sha2_256 :"
    " true, _ : false })\n    {\n        return pbkdf2_sha256(password, salt, iterations, len);\n    }\n    H"
    "mac base = Hmac::new(kind, password);\n    Vec<u8> out = Vec::new();\n    u32 block = 1;\n    while (Ve"
    "c::len(&out) < len)\n    {\n        Hmac first = base;\n        Hmac::update(&mut first, salt);\n       "
    " Vec<u8> counter = Vec::new();\n        Vec::push_be(&mut counter, block);\n        Hmac::update(&mut "
    "first, &counter[0..$]);\n        Vec<u8> u = Hmac::finish(first);\n        Vec<u8> t = Vec::clone(&u);"
    "\n        for (usize j = 1; j < iterations; j += 1)\n        {\n            Hmac m = base;\n            "
    "Hmac::update(&mut m, &u[0..$]);\n            overwrite(&mut u, Hmac::finish(m));\n            for (usi"
    "ze i = 0; i < Vec::len(&t); i += 1)\n            {\n                t[i] = t[i] ^ u[i];\n            }\n"
    "        }\n        for (usize i = 0; i < Vec::len(&t) && Vec::len(&out) < len; i += 1)\n        {\n    "
    "        Vec::push(&mut out, t[i]);\n        }\n        block += 1;\n    }\n    out\n}unittest \"pbkdf2: an"
    " RFC 6070 vector\"\n{\n    Vec<u8> dk = pbkdf2(Sha1, &b\"password\"[0..$], &b\"salt\"[0..$], 2, 20);\n    as"
    "sert(String::eq_str(&to_hex(&dk[0..$]), \"ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957\"));\n}fn pbkdf2_sha"
    "256(slice<u8, shared> password, slice<u8, shared> salt, usize iterations, usize len) : Vec<u8>\n{\n   "
    " HmacSha256 base = HmacSha256::new(password);\n    Vec<u8> out = Vec::new();\n    u32 block = 1;\n    w"
    "hile (Vec::len(&out) < len)\n    {\n        HmacSha256 first = base;\n        HmacSha256::update(&mut f"
    "irst, salt);\n        array<u8, 4> counter = [\n            narrow_wrapping<u8>(block >> 24),\n        "
    "    narrow_wrapping<u8>(block >> 16),\n            narrow_wrapping<u8>(block >> 8),\n            narro"
    "w_wrapping<u8>(block),\n        ];\n        HmacSha256::update(&mut first, &counter[0..$]);\n        ar"
    "ray<u8, 32> u = HmacSha256::finish(first);\n        array<u8, 32> t = u;\n        for (usize j = 1; j "
    "< iterations; j += 1)\n        {\n            HmacSha256 m = base;\n            HmacSha256::update(&mut"
    " m, &u[0..$]);\n            u = HmacSha256::finish(m);\n            for (usize i = 0; i < 32; i += 1)\n"
    "            {\n                t[i] = t[i] ^ u[i];\n            }\n        }\n        for (usize i = 0; "
    "i < 32 && Vec::len(&out) < len; i += 1)\n        {\n            Vec::push(&mut out, t[i]);\n        }\n "
    "       block += 1;\n    }\n    out\n}fn argon2_h_prime(usize out_len, slice<u8, shared> x) : Vec<u8>\n{\n"
    "    Vec<u8> prefix = Vec::new();\n    Vec::push_le(&mut prefix, narrow<u32>(out_len));\n    if (out_le"
    "n <= 64)\n    {\n        Blake2b b = Blake2b::new(out_len);\n        Blake2b::update(&mut b, &prefix[0."
    ".$]);\n        Blake2b::update(&mut b, x);\n        return Blake2b::finish(b);\n    }\n    usize r = (ou"
    "t_len + 31) / 32 - 2;\n    Blake2b b = Blake2b::new(64);\n    Blake2b::update(&mut b, &prefix[0..$]);\n"
    "    Blake2b::update(&mut b, x);\n    Vec<u8> v = Blake2b::finish(b);\n    Vec<u8> out = Vec::from_slic"
    "e(&v[0..32]);\n    for (usize i = 1; i < r; i += 1)\n    {\n        overwrite(&mut v, blake2b(&v[0..$],"
    " 64));\n        Vec::extend_from(&mut out, &v[0..32]);\n    }\n    Vec<u8> last = blake2b(&v[0..$], out"
    "_len - 32 * r);\n    Vec::extend_from(&mut out, &last[0..$]);\n    out\n}fn argon2_p(array<u64, 16> v) "
    ": array<u64, 16>\n{\n    u64 lo = 0xffffffff;\n    for (usize g = 0; g < 8; g += 1)\n    {\n        usize"
    " a = widen<usize>(BLAKE2B_G[4 * g]);\n        usize b = widen<usize>(BLAKE2B_G[4 * g + 1]);\n        u"
    "size c = widen<usize>(BLAKE2B_G[4 * g + 2]);\n        usize d = widen<usize>(BLAKE2B_G[4 * g + 3]);\n "
    "       v[a] = wrapping_add(wrapping_add(v[a], v[b]), wrapping_mul(2, (v[a] & lo) * (v[b] & lo)));\n  "
    "      v[d] = rotate_right(v[d] ^ v[a], 32);\n        v[c] = wrapping_add(wrapping_add(v[c], v[d]), wr"
    "apping_mul(2, (v[c] & lo) * (v[d] & lo)));\n        v[b] = rotate_right(v[b] ^ v[c], 24);\n        v[a"
    "] = wrapping_add(wrapping_add(v[a], v[b]), wrapping_mul(2, (v[a] & lo) * (v[b] & lo)));\n        v[d]"
    " = rotate_right(v[d] ^ v[a], 16);\n        v[c] = wrapping_add(wrapping_add(v[c], v[d]), wrapping_mul"
    "(2, (v[c] & lo) * (v[d] & lo)));\n        v[b] = rotate_right(v[b] ^ v[c], 63);\n    }\n    v\n}fn argon"
    "2_g(array<u64, 128> x, array<u64, 128> y) : array<u64, 128>\n{\n    array<u64, 128> r = [0; 128];\n    "
    "for (usize i = 0; i < 128; i += 1)\n    {\n        r[i] = x[i] ^ y[i];\n    }\n    array<u64, 128> q = r"
    ";\n    for (usize row = 0; row < 8; row += 1)\n    {\n        array<u64, 16> v = [0; 16];\n        for ("
    "usize i = 0; i < 16; i += 1)\n        {\n            v[i] = q[16 * row + i];\n        }\n        v = arg"
    "on2_p(v);\n        for (usize i = 0; i < 16; i += 1)\n        {\n            q[16 * row + i] = v[i];\n  "
    "      }\n    }\n    for (usize col = 0; col < 8; col += 1)\n    {\n        array<u64, 16> v = [0; 16];\n "
    "       for (usize j = 0; j < 8; j += 1)\n        {\n            v[2 * j] = q[16 * j + 2 * col];\n      "
    "      v[2 * j + 1] = q[16 * j + 2 * col + 1];\n        }\n        v = argon2_p(v);\n        for (usize "
    "j = 0; j < 8; j += 1)\n        {\n            q[16 * j + 2 * col] = v[2 * j];\n            q[16 * j + 2"
    " * col + 1] = v[2 * j + 1];\n        }\n    }\n    for (usize i = 0; i < 128; i += 1)\n    {\n        q[i"
    "] = q[i] ^ r[i];\n    }\n    q\n}fn argon2_get(slice<u64, shared> b) : array<u64, 128>\n{\n    array<u64,"
    " 128> out = [0; 128];\n    for (usize i = 0; i < 128; i += 1)\n    {\n        out[i] = b[i];\n    }\n    "
    "out\n}fn argon2_put(slice<u64, exclusive> b, array<u64, 128> v, bool xor)\n{\n    for (usize i = 0; i <"
    " 128; i += 1)\n    {\n        b[i] = if (xor) { b[i] ^ v[i] } else { v[i] };\n    }\n}fn argon2_load(ref"
    "<Vec<u64>, shared> mem, usize block) : array<u64, 128>\n{\n    argon2_get(&mem[128 * block..128 * bloc"
    "k + 128])\n}export fn argon2id(\n    slice<u8, shared> password,\n    slice<u8, shared> salt,\n    usize"
    " iterations,\n    usize memory_kib,\n    usize parallelism,\n    usize len,\n) : Vec<u8>\n{\n    if (itera"
    "tions == 0 || parallelism == 0 || parallelism > 255 || memory_kib < 8 * parallelism || len < 4 || sl"
    "ice_len(salt) < 8)\n    {\n        fault(kdf_parameters);\n    }\n    usize lanes = parallelism;\n    usi"
    "ze q = (memory_kib / (4 * lanes)) * 4;\n    usize m_prime = q * lanes;\n    usize seg = q / 4;\n    // "
    "H0 (§3.2).\n    Blake2b h = Blake2b::new(64);\n    Vec<u8> head = Vec::new();\n    Vec::push_le(&mut h"
    "ead, narrow<u32>(lanes));\n    Vec::push_le(&mut head, narrow<u32>(len));\n    Vec::push_le(&mut head,"
    " narrow<u32>(memory_kib));\n    Vec::push_le(&mut head, narrow<u32>(iterations));\n    Vec::push_le(&m"
    "ut head, 0x13: u32);\n    Vec::push_le(&mut head, 2: u32);\n    Vec::push_le(&mut head, narrow<u32>(sl"
    "ice_len(password)));\n    Blake2b::update(&mut h, &head[0..$]);\n    Blake2b::update(&mut h, password)"
    ";\n    Vec<u8> mid = Vec::new();\n    Vec::push_le(&mut mid, narrow<u32>(slice_len(salt)));\n    Blake2"
    "b::update(&mut h, &mid[0..$]);\n    Blake2b::update(&mut h, salt);\n    array<u8, 8> none = [0; 8];\n  "
    "  Blake2b::update(&mut h, &none[0..$]);\n    Vec<u8> h0 = Blake2b::finish(h);\n    Vec<u64> mem = Vec:"
    ":filled(128 * m_prime, 0: u64);\n    for (usize l = 0; l < lanes; l += 1)\n    {\n        for (usize co"
    "l = 0; col < 2; col += 1)\n        {\n            Vec<u8> input = Vec::clone(&h0);\n            Vec::pu"
    "sh_le(&mut input, narrow<u32>(col));\n            Vec::push_le(&mut input, narrow<u32>(l));\n         "
    "   Vec<u8> block = argon2_h_prime(1024, &input[0..$]);\n            for (usize i = 0; i < 128; i += 1"
    ")\n            {\n                mem[128 * (l * q + col) + i] = read_le<u64>(&block[0..$], 8 * i);\n  "
    "          }\n        }\n    }\n    array<u64, 128> zero = [0; 128];\n    for (usize r = 0; r < iteration"
    "s; r += 1)\n    {\n        for (usize s = 0; s < 4; s += 1)\n        {\n            for (usize l = 0; l "
    "< lanes; l += 1)\n            {\n                bool independent = r == 0 && s < 2;\n                a"
    "rray<u64, 128> addresses = [0; 128];\n                array<u64, 128> input = [0; 128];\n             "
    "   input[0] = widen<u64>(r);\n                input[1] = widen<u64>(l);\n                input[2] = wi"
    "den<u64>(s);\n                input[3] = widen<u64>(m_prime);\n                input[4] = widen<u64>(i"
    "terations);\n                input[5] = 2;\n                usize start_i = if (r == 0 && s == 0) { 2 "
    "} else { 0 };\n                for (usize i = start_i; i < seg; i += 1)\n                {\n           "
    "         usize j = s * seg + i;\n                    usize prev = if (j == 0) { q - 1 } else { j - 1 "
    "};\n                    u64 pseudo = 0;\n                    if (independent)\n                    {\n  "
    "                      if (i % 128 == 0 || i == start_i)\n                        {\n                  "
    "          input[6] = widen<u64>(i / 128 + 1);\n                            addresses = argon2_g(zero,"
    " argon2_g(zero, input));\n                        }\n                        pseudo = addresses[i % 12"
    "8];\n                    }\n                    else\n                    {\n                        pse"
    "udo = mem[128 * (l * q + prev)];\n                    }\n                    u64 j1 = pseudo & 0xfffff"
    "fff;\n                    u64 j2 = pseudo >> 32;\n                    usize ref_lane = if (r == 0 && s"
    " == 0) { l } else { narrow<usize>(j2 % widen<u64>(lanes)) };\n                    usize w = 0;\n      "
    "              if (r == 0)\n                    {\n                        w = if (ref_lane == l) { s *"
    " seg + i - 1 } else { s * seg - (if (i == 0) { 1 } else { 0 }) };\n                    }\n            "
    "        else\n                    {\n                        w = if (ref_lane == l) { q - seg + i - 1 "
    "} else { q - seg - (if (i == 0) { 1 } else { 0 }) };\n                    }\n                    u64 x"
    " = (j1 * j1) >> 32;\n                    u64 y = narrow<u64>((widen<u128>(w) * widen<u128>(x)) >> 32)"
    ";\n                    usize z = w - 1 - narrow<usize>(y);\n                    usize start = if (r =="
    " 0) { 0 } else { ((s + 1) % 4) * seg };\n                    usize ref_col = (start + z) % q;\n       "
    "             array<u64, 128> fresh = argon2_g(\n                        argon2_load(&mem, l * q + pre"
    "v),\n                        argon2_load(&mem, ref_lane * q + ref_col),\n                    );\n      "
    "              usize at = 128 * (l * q + j);\n                    argon2_put(&mut mem[at..at + 128], f"
    "resh, r > 0);\n                }\n            }\n        }\n    }\n    array<u64, 128> c = [0; 128];\n    "
    "for (usize l = 0; l < lanes; l += 1)\n    {\n        for (usize k = 0; k < 128; k += 1)\n        {\n    "
    "        c[k] = c[k] ^ mem[128 * (l * q + q - 1) + k];\n        }\n    }\n    Vec<u8> c_bytes = Vec::new"
    "();\n    for (usize k = 0; k < 128; k += 1)\n    {\n        Vec::push_le(&mut c_bytes, c[k]);\n    }\n   "
    " argon2_h_prime(len, &c_bytes[0..$])\n}fn b64_unpadded(slice<u8, shared> bytes) : String\n{\n    String"
    " s = base64_encode(bytes);\n    usize n = String::len(&s);\n    while (n > 0 && String::as_bytes(&s)[n"
    " - 1] == 0x3d)\n    {\n        n -= 1;\n    }\n    String::truncate(&mut s, n);\n    s\n}fn b64_decode_unp"
    "added(StringView text) : Option<Vec<u8>>\n{\n    String padded = String::from_view(text);\n    while (S"
    "tring::len(&padded) % 4 != 0)\n    {\n        String::push_ascii(&mut padded, 0x3d);\n    }\n    match ("
    "base64_decode(String::as_view(&padded)))\n    {\n        Ok(v)  : Some(v),\n        Err(_) : None,\n    "
    "}\n}export fn hash_password(slice<u8, shared> password) : String\n{\n    array<u8, 16> salt = [0; 16];\n"
    "    os_random_bytes(&mut salt[0..$]);\n    Vec<u8> digest = argon2id(password, &salt[0..$], 2, 19456,"
    " 1, 32);\n    String out = String::from_str(\"$argon2id$v=19$m=19456,t=2,p=1$\");\n    String::append(&m"
    "ut out, String::as_view(&b64_unpadded(&salt[0..$])));\n    String::append(&mut out, \"$\");\n    String:"
    ":append(&mut out, String::as_view(&b64_unpadded(&digest[0..$])));\n    out\n}export fn verify_password"
    "(StringView stored, slice<u8, shared> password) : bool\n{\n    Vec<StringView> parts = StringView::spl"
    "it(stored, \"$\");\n    if (Vec::len(&parts) != 6 || StringView::len(parts[0]) != 0 || !StringView::eq("
    "\n        parts[1],\n        \"argon2id\",\n    ) || !StringView::eq(parts[2], \"v=19\"))\n    {\n        ret"
    "urn false;\n    }\n    Vec<StringView> params = StringView::split(parts[3], \",\");\n    if (Vec::len(&pa"
    "rams) != 3 || !StringView::starts_with(\n        params[0],\n        \"m=\",\n    ) || !StringView::start"
    "s_with(params[1], \"t=\") || !StringView::starts_with(params[2], \"p=\"))\n    {\n        return false;\n  "
    "  }\n    usize m = match (StringView::parse<usize>(StringView::sub(params[0], 2, StringView::len(para"
    "ms[0]))))\n    {\n        Ok(v)  : v,\n        Err(_) : return false,\n    };\n    usize t = match (Strin"
    "gView::parse<usize>(StringView::sub(params[1], 2, StringView::len(params[1]))))\n    {\n        Ok(v) "
    " : v,\n        Err(_) : return false,\n    };\n    usize p = match (StringView::parse<usize>(StringView"
    "::sub(params[2], 2, StringView::len(params[2]))))\n    {\n        Ok(v)  : v,\n        Err(_) : return "
    "false,\n    };\n    Vec<u8> salt = match (b64_decode_unpadded(parts[4]))\n    {\n        Some(v) : v,\n  "
    "      None    : return false,\n    };\n    Vec<u8> want = match (b64_decode_unpadded(parts[5]))\n    {\n"
    "        Some(v) : v,\n        None    : return false,\n    };\n    if (t == 0 || p == 0 || p > 255 || m"
    " < 8 * p || Vec::len(&want) < 4 || Vec::len(&salt) < 8)\n    {\n        return false;\n    }\n    Vec<u8"
    "> got = argon2id(password, &salt[0..$], t, m, p, Vec::len(&want));\n    digest_eq(&got[0..$], &want[0"
    "..$])\n}unittest \"verify_password: what is not a hash is false\"\n{\n    assert(!verify_password(StringV"
    "iew::of(\"not a password hash\"), &b\"secret\"[0..$]));\n    StringView no_memory = StringView::of(\"$argo"
    "n2id$v=19$m=0,t=1,p=1$c2FsdHNhbHQ$AAAAAA\");\n    assert(!verify_password(no_memory, &b\"secret\"[0..$])"
    ");\n}fn crypto_check_lengths(slice<u8, shared> key, slice<u8, shared> nonce)\n{\n    if (slice_len(key)"
    " != 32 || slice_len(nonce) != 12)\n    {\n        fault(crypto_length);\n    }\n}fn chacha_quarter(ref<a"
    "rray<u32, 16>, exclusive> x, usize a, usize b, usize c, usize d)\n{\n    x[a] = wrapping_add(x[a], x[b"
    "]);\n    x[d] = rotate_left(x[d] ^ x[a], 16);\n    x[c] = wrapping_add(x[c], x[d]);\n    x[b] = rotate_"
    "left(x[b] ^ x[c], 12);\n    x[a] = wrapping_add(x[a], x[b]);\n    x[d] = rotate_left(x[d] ^ x[a], 8);\n"
    "    x[c] = wrapping_add(x[c], x[d]);\n    x[b] = rotate_left(x[b] ^ x[c], 7);\n}fn chacha_block(slice<"
    "u8, shared> key, slice<u8, shared> nonce, u32 counter) : array<u8, 64>\n{\n    array<u32, 16> s = [0; "
    "16];\n    s[0] = 0x61707865;\n    s[1] = 0x3320646e;\n    s[2] = 0x79622d32;\n    s[3] = 0x6b206574;\n   "
    " for (usize i = 0; i < 8; i += 1)\n    {\n        s[4 + i] = read_le<u32>(key, 4 * i);\n    }\n    s[12]"
    " = counter;\n    for (usize i = 0; i < 3; i += 1)\n    {\n        s[13 + i] = read_le<u32>(nonce, 4 * i"
    ");\n    }\n    array<u32, 16> x = s;\n    for (usize round = 0; round < 10; round += 1)\n    {\n        c"
    "hacha_quarter(&mut x, 0, 4, 8, 12);\n        chacha_quarter(&mut x, 1, 5, 9, 13);\n        chacha_quar"
    "ter(&mut x, 2, 6, 10, 14);\n        chacha_quarter(&mut x, 3, 7, 11, 15);\n        chacha_quarter(&mut"
    " x, 0, 5, 10, 15);\n        chacha_quarter(&mut x, 1, 6, 11, 12);\n        chacha_quarter(&mut x, 2, 7"
    ", 8, 13);\n        chacha_quarter(&mut x, 3, 4, 9, 14);\n    }\n    array<u8, 64> out = [0; 64];\n    fo"
    "r (usize i = 0; i < 16; i += 1)\n    {\n        u32 w = wrapping_add(x[i], s[i]);\n        out[4 * i] ="
    " narrow_wrapping<u8>(w);\n        out[4 * i + 1] = narrow_wrapping<u8>(w >> 8);\n        out[4 * i + 2"
    "] = narrow_wrapping<u8>(w >> 16);\n        out[4 * i + 3] = narrow_wrapping<u8>(w >> 24);\n    }\n    o"
    "ut\n}export fn chacha20(slice<u8, shared> key, slice<u8, shared> nonce, u32 counter, slice<u8, shared"
    "> data) : Vec<u8>\n{\n    crypto_check_lengths(key, nonce);\n    usize n = slice_len(data);\n    if (wid"
    "en<u64>(n) > (widen<u64>(max_value<u32>()) - widen<u64>(counter) + 1) * 64)\n    {\n        fault(cryp"
    "to_length);\n    }\n    Vec<u8> out = Vec::new();\n    Vec::reserve(&mut out, n);\n    u32 block = count"
    "er;\n    usize at = 0;\n    while (at < n)\n    {\n        array<u8, 64> ks = chacha_block(key, nonce, b"
    "lock);\n        usize take = min(64, n - at);\n        for (usize i = 0; i < take; i += 1)\n        {\n "
    "           Vec::push(&mut out, data[at + i] ^ ks[i]);\n        }\n        at += take;\n        if (at <"
    " n)\n        {\n            block += 1;\n        }\n    }\n    out\n}unittest \"chacha20: the same operatio"
    "n decrypts\"\n{\n    array<u8, 32> key = [9; 32];\n    array<u8, 12> nonce = [0; 12];\n    Vec<u8> hidden"
    " = chacha20(&key[0..$], &nonce[0..$], 1, &b\"attack at dawn\"[0..$]);\n    Vec<u8> back = chacha20(&key"
    "[0..$], &nonce[0..$], 1, &hidden[0..$]);\n    assert(slice_eq(&back[0..$], &b\"attack at dawn\"[0..$]))"
    ";\n}fn Poly1305::new(slice<u8, shared> key) : Poly1305\n{\n    u64 m26 = 0x3ffffff;\n    array<u64, 5> r"
    " = [0; 5];\n    r[0] = widen<u64>(read_le<u32>(key, 0)) & m26;\n    r[1] = (widen<u64>(read_le<u32>(ke"
    "y, 3)) >> 2) & 0x3ffff03;\n    r[2] = (widen<u64>(read_le<u32>(key, 6)) >> 4) & 0x3ffc0ff;\n    r[3] ="
    " (widen<u64>(read_le<u32>(key, 9)) >> 6) & 0x3f03fff;\n    r[4] = (widen<u64>(read_le<u32>(key, 12)) "
    ">> 8) & 0x00fffff;\n    array<u64, 4> pad = [0; 4];\n    for (usize i = 0; i < 4; i += 1)\n    {\n      "
    "  pad[i] = widen<u64>(read_le<u32>(key, 16 + 4 * i));\n    }\n    Poly1305 { .h = [0; 5], .r = r, .pad"
    " = pad }\n}fn Poly1305::block(ref<Poly1305, exclusive> p, slice<u8, shared> m, u64 hibit)\n{\n    p.h ="
    " poly1305_blocks(p.h, p.r, m, hibit);\n}fn poly1305_blocks(array<u64, 5> h, array<u64, 5> r, slice<u8"
    ", shared> m, u64 hibit) : array<u64, 5>\n{\n    u64 m26 = 0x3ffffff;\n    u64 r0 = r[0];\n    u64 r1 = r"
    "[1];\n    u64 r2 = r[2];\n    u64 r3 = r[3];\n    u64 r4 = r[4];\n    u64 s1 = r1 * 5;\n    u64 s2 = r2 *"
    " 5;\n    u64 s3 = r3 * 5;\n    u64 s4 = r4 * 5;\n    u64 h0 = h[0];\n    u64 h1 = h[1];\n    u64 h2 = h[2"
    "];\n    u64 h3 = h[3];\n    u64 h4 = h[4];\n    for (usize at = 0; at + 16 <= slice_len(m); at += 16)\n "
    "   {\n        // The little-endian words at 0, 3, 6, 9 and 12.\n        array<u64, 5> t = [0; 5];\n    "
    "    for (usize k = 0; k < 5; k += 1)\n        {\n            usize o = at + 3 * k;\n            t[k] = "
    "widen<u64>(m[o]) | (widen<u64>(m[o + 1]) << 8) | (widen<u64>(m[o + 2]) << 16) | (widen<u64>(m[o + 3]"
    ") << 24);\n        }\n        h0 += t[0] & m26;\n        h1 += (t[1] >> 2) & m26;\n        h2 += (t[2] >"
    "> 4) & m26;\n        h3 += (t[3] >> 6) & m26;\n        h4 += (t[4] >> 8) | hibit;\n        u64 d0 = h0 "
    "* r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1;\n        u64 d1 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3"
    " + h4 * s2;\n        u64 d2 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3;\n        u64 d3 = h0 * "
    "r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4;\n        u64 d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 +"
    " h4 * r0;\n        u64 c = d0 >> 26;\n        h0 = d0 & m26;\n        d1 += c;\n        c = d1 >> 26;\n  "
    "      h1 = d1 & m26;\n        d2 += c;\n        c = d2 >> 26;\n        h2 = d2 & m26;\n        d3 += c;\n"
    "        c = d3 >> 26;\n        h3 = d3 & m26;\n        d4 += c;\n        c = d4 >> 26;\n        h4 = d4 "
    "& m26;\n        h0 += c * 5;\n        c = h0 >> 26;\n        h0 = h0 & m26;\n        h1 += c;\n    }\n    "
    "[h0, h1, h2, h3, h4]\n}fn Poly1305::update_padded(ref<Poly1305, exclusive> p, slice<u8, shared> data)"
    "\n{\n    usize n = slice_len(data);\n    usize at = n - n % 16;\n    if (at > 0)\n    {\n        Poly1305:"
    ":block(p, &data[0..at], 1 << 24);\n    }\n    if (at < n)\n    {\n        array<u8, 16> last = [0; 16];\n"
    "        for (usize i = 0; at + i < n; i += 1)\n        {\n            last[i] = data[at + i];\n        "
    "}\n        Poly1305::block(p, &last[0..$], 1 << 24);\n    }\n}fn Poly1305::update_last(ref<Poly1305, ex"
    "clusive> p, slice<u8, shared> data)\n{\n    usize n = slice_len(data);\n    usize at = 0;\n    while (at"
    " + 16 <= n)\n    {\n        Poly1305::block(p, &data[at..at + 16], 1 << 24);\n        at += 16;\n    }\n "
    "   if (at < n)\n    {\n        array<u8, 16> last = [0; 16];\n        for (usize i = 0; at + i < n; i +"
    "= 1)\n        {\n            last[i] = data[at + i];\n        }\n        last[n - at] = 1;\n        Poly1"
    "305::block(p, &last[0..$], 0);\n    }\n}fn Poly1305::finish(Poly1305 p) : array<u8, 16>\n{\n    u64 m26 "
    "= 0x3ffffff;\n    u64 h0 = p.h[0];\n    u64 h1 = p.h[1];\n    u64 h2 = p.h[2];\n    u64 h3 = p.h[3];\n   "
    " u64 h4 = p.h[4];\n    u64 c = h1 >> 26;\n    h1 = h1 & m26;\n    h2 += c;\n    c = h2 >> 26;\n    h2 = h"
    "2 & m26;\n    h3 += c;\n    c = h3 >> 26;\n    h3 = h3 & m26;\n    h4 += c;\n    c = h4 >> 26;\n    h4 = h"
    "4 & m26;\n    h0 += c * 5;\n    c = h0 >> 26;\n    h0 = h0 & m26;\n    h1 += c;\n    // g = h + 5 - 2^130"
    "; it is chosen when it does not go below zero.\n    u64 g0 = h0 + 5;\n    c = g0 >> 26;\n    g0 = g0 & "
    "m26;\n    u64 g1 = h1 + c;\n    c = g1 >> 26;\n    g1 = g1 & m26;\n    u64 g2 = h2 + c;\n    c = g2 >> 26"
    ";\n    g2 = g2 & m26;\n    u64 g3 = h3 + c;\n    c = g3 >> 26;\n    g3 = g3 & m26;\n    u64 g4 = wrapping"
    "_sub(h4 + c, 0x4000000);\n    u64 take_g = wrapping_sub(g4 >> 63, 1);\n    u64 take_h = ~take_g;\n    h"
    "0 = (h0 & take_h) | (g0 & take_g);\n    h1 = (h1 & take_h) | (g1 & take_g);\n    h2 = (h2 & take_h) | "
    "(g2 & take_g);\n    h3 = (h3 & take_h) | (g3 & take_g);\n    h4 = (h4 & take_h) | (g4 & take_g);\n    u"
    "64 m32 = 0xffffffff;\n    u64 w0 = (h0 | (h1 << 26)) & m32;\n    u64 w1 = ((h1 >> 6) | (h2 << 20)) & m"
    "32;\n    u64 w2 = ((h2 >> 12) | (h3 << 14)) & m32;\n    u64 w3 = ((h3 >> 18) | (h4 << 8)) & m32;\n    u"
    "64 f = w0 + p.pad[0];\n    w0 = f & m32;\n    f = w1 + p.pad[1] + (f >> 32);\n    w1 = f & m32;\n    f ="
    " w2 + p.pad[2] + (f >> 32);\n    w2 = f & m32;\n    f = w3 + p.pad[3] + (f >> 32);\n    w3 = f & m32;\n "
    "   array<u64, 4> w = [w0, w1, w2, w3];\n    array<u8, 16> tag = [0; 16];\n    for (usize i = 0; i < 4;"
    " i += 1)\n    {\n        tag[4 * i] = narrow_wrapping<u8>(w[i]);\n        tag[4 * i + 1] = narrow_wrapp"
    "ing<u8>(w[i] >> 8);\n        tag[4 * i + 2] = narrow_wrapping<u8>(w[i] >> 16);\n        tag[4 * i + 3]"
    " = narrow_wrapping<u8>(w[i] >> 24);\n    }\n    tag\n}export fn poly1305(slice<u8, shared> key, slice<u"
    "8, shared> message) : array<u8, 16>\n{\n    if (slice_len(key) != 32)\n    {\n        fault(crypto_lengt"
    "h);\n    }\n    Poly1305 p = Poly1305::new(key);\n    Poly1305::update_last(&mut p, message);\n    Poly1"
    "305::finish(p)\n}unittest \"poly1305: the RFC 8439 vector\"\n{\n    StringView k = StringView::of(\"85d6be"
    "7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b\");\n    Vec<u8> key = Result::unwrap(from_"
    "hex(k));\n    array<u8, 16> tag = poly1305(&key[0..$], &b\"Cryptographic Forum Research Group\"[0..$]);"
    "\n    assert(String::eq_str(&to_hex(&tag[0..$]), \"a8061dc1305136c6c22b8baf0c0127a9\"));\n}fn aead_tag(\n"
    "    slice<u8, shared> key,\n    slice<u8, shared> nonce,\n    slice<u8, shared> aad,\n    slice<u8, sha"
    "red> ciphertext,\n) : array<u8, 16>\n{\n    array<u8, 64> block0 = chacha_block(key, nonce, 0);\n    Pol"
    "y1305 p = Poly1305::new(&block0[0..32]);\n    Poly1305::update_padded(&mut p, aad);\n    Poly1305::upd"
    "ate_padded(&mut p, ciphertext);\n    Vec<u8> lengths = Vec::new();\n    Vec::push_le(&mut lengths, wid"
    "en<u64>(slice_len(aad)));\n    Vec::push_le(&mut lengths, widen<u64>(slice_len(ciphertext)));\n    Pol"
    "y1305::block(&mut p, &lengths[0..$], 1 << 24);\n    Poly1305::finish(p)\n}export fn chacha20_poly1305_"
    "seal(\n    slice<u8, shared> key,\n    slice<u8, shared> nonce,\n    slice<u8, shared> aad,\n    slice<u"
    "8, shared> plaintext,\n) : Vec<u8>\n{\n    Vec<u8> out = chacha20(key, nonce, 1, plaintext);\n    array<"
    "u8, 16> tag = aead_tag(key, nonce, aad, &out[0..$]);\n    for (usize i = 0; i < 16; i += 1)\n    {\n   "
    "     Vec::push(&mut out, tag[i]);\n    }\n    out\n}unittest \"chacha20_poly1305_seal: a round trip, and"
    " a change refused\"\n{\n    array<u8, 32> key = [7; 32];\n    array<u8, 12> nonce = [1; 12];\n    array<u"
    "8, 2> ad = [0xa1, 0xa2];\n    Vec<u8> sealed = chacha20_poly1305_seal(&key[0..$], &nonce[0..$], &ad[0"
    "..$], &b\"hello\"[0..$]);\n    assert(Vec::len(&sealed) == 5 + 16);\n    Option<Vec<u8>> opened = chacha"
    "20_poly1305_open(&key[0..$], &nonce[0..$], &ad[0..$], &sealed[0..$]);\n    assert(slice_eq(&Option::u"
    "nwrap(opened)[0..$], &b\"hello\"[0..$]));\n    sealed[0] = sealed[0] ^ 1;\n    assert(Option::is_none(&c"
    "hacha20_poly1305_open(&key[0..$], &nonce[0..$], &ad[0..$], &sealed[0..$])));\n}export fn chacha20_pol"
    "y1305_open(\n    slice<u8, shared> key,\n    slice<u8, shared> nonce,\n    slice<u8, shared> aad,\n    s"
    "lice<u8, shared> sealed,\n) : Option<Vec<u8>>\n{\n    crypto_check_lengths(key, nonce);\n    usize n = s"
    "lice_len(sealed);\n    if (n < 16)\n    {\n        return None;\n    }\n    array<u8, 16> want = aead_tag"
    "(key, nonce, aad, &sealed[0..n - 16]);\n    if (!digest_eq(&want[0..$], &sealed[n - 16..n]))\n    {\n  "
    "      return None;\n    }\n    Some(chacha20(key, nonce, 1, &sealed[0..n - 16]))\n}fn aes_transpose8(u6"
    "4 x) : u64\n{\n    u64 v = x;\n    u64 t = (v ^ (v >> 7)) & 0x00aa00aa00aa00aa;\n    v = v ^ t ^ (t << 7"
    ");\n    t = (v ^ (v >> 14)) & 0x0000cccc0000cccc;\n    v = v ^ t ^ (t << 14);\n    t = (v ^ (v >> 28)) "
    "& 0x00000000f0f0f0f0;\n    v ^ t ^ (t << 28)\n}fn aes_pack(array<u8, 64> b) : array<u64, 8>\n{\n    arra"
    "y<u64, 8> q = [0; 8];\n    for (usize k = 0; k < 8; k += 1)\n    {\n        u64 x = 0;\n        for (usi"
    "ze i = 0; i < 8; i += 1)\n        {\n            x = x | (widen<u64>(b[8 * k + i]) << narrow<u32>(8 * "
    "i));\n        }\n        x = aes_transpose8(x);\n        for (usize p = 0; p < 8; p += 1)\n        {\n   "
    "         q[p] = q[p] | (((x >> narrow<u32>(8 * p)) & 0xff) << narrow<u32>(8 * k));\n        }\n    }\n "
    "   q\n}fn aes_unpack(array<u64, 8> q) : array<u8, 64>\n{\n    array<u8, 64> b = [0; 64];\n    for (usize"
    " k = 0; k < 8; k += 1)\n    {\n        u64 x = 0;\n        for (usize p = 0; p < 8; p += 1)\n        {\n "
    "           x = x | (((q[p] >> narrow<u32>(8 * k)) & 0xff) << narrow<u32>(8 * p));\n        }\n        "
    "x = aes_transpose8(x);\n        for (usize i = 0; i < 8; i += 1)\n        {\n            b[8 * k + i] ="
