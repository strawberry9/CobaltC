    ":finish(Sha512 s) : array<u8, 64>\n{\n    Vec<u8> b = sha512_bytes(Sha512::final_words(s), 8);\n    arr"
    "ay<u8, 64> out = [0; 64];\n    for (usize i = 0; i < 64; i += 1)\n    {\n        out[i] = b[i];\n    }\n "
    "   out\n}export fn sha512(slice<u8, shared> data) : array<u8, 64>\n{\n    Sha512 s = Sha512::new();\n   "
    " Sha512::update(&mut s, data);\n    Sha512::finish(s)\n}unittest \"sha512: the published vector for abc"
    "\"\n{\n    array<u8, 64> d = sha512(&b\"abc\"[0..$]);\n    String want = \"ddaf35a193617abacc417349ae204131"
