    " ordered>(T x, T lo, T hi) : T\n{\n    assert(!(hi < lo), \"clamp: `lo` is above `hi`\");\n    if (x < lo"
    ") { lo } else if (hi < x) { hi } else { x }\n}export fn is_nan<T: number>(T x) : bool\n{\n    x != x\n}e"
    "xport fn is_finite<T: number>(T x) : bool\n{\n    (x - x) == (x - x)\n}export fn gcd<T: integer>(T a, T"
    " b) : T\n{\n    T x = abs(a);\n    T y = abs(b);\n    while (y != 0)\n    {\n        T r = x % y;\n        "
    "x = y;\n        y = r;\n    }\n    x\n}unittest \"gcd: with clamp, pow, abs and the float tests\"\n{\n    as"
    "sert(gcd(-12, 18) == 6);\n    assert(gcd(0, 0) == 0);\n    assert(clamp(15, 0, 10) == 10 && clamp(-3, "
    "0, 10) == 0);\n    assert(pow(3, 4) == 81 && pow(7, 0) == 1);\n    assert(abs(-0.0) == 0.0 && is_nan(0"
    ".0 / 0.0) && !is_finite(1.0 / 0.0));\n}fn BigUint::trim(ref<BigUint, exclusive> a)\n{\n    while (Vec::"
    "len(&a.limbs) > 0 && a.limbs[Vec::len(&a.limbs) - 1] == 0)\n    {\n        Vec::pop(&mut a.limbs);\n   "
    " }\n}export fn BigUint::zero() : BigUint\n{\n    BigUint { .limbs = Vec::new() }\n}export fn BigUint::fr"
    "om_u64(u64 x) : BigUint\n{\n    BigUint r = BigUint { .limbs = Vec::new() };\n    Vec::push(&mut r.limb"
    "s, narrow_wrapping<u32>(x));\n    Vec::push(&mut r.limbs, narrow_wrapping<u32>(x >> 32));\n    BigUint"
