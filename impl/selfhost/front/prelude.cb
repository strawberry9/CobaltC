    "ve> s)\n{\n    HashMap::clear(&mut s.map);\n}export fn Queue::new<T>() : Queue<T>\n{\n    Queue { .head ="
    " Vec::new(), .tail = Vec::new(), .took_front = false, .took_back = false }\n}export fn Queue::len<T>("
    "ref<Queue<T>, shared> q) : usize\n{\n    q.head.len + q.tail.len\n}fn Queue::shift<T>(ref<Vec<T>, exclu"
    "sive> from, ref<Vec<T>, exclusive> to, bool half)\n{\n    usize n = from.len;\n    usize stay = if (hal"
    "f)\n    {\n        n / 2\n    }\n    else\n    {\n        0\n    };\n    usize m = n - stay;\n    usize size "
    "= sizeof<T>();\n    Vec::reserve(to, m);\n    rawptr<T> src = from.ptr;\n    rawptr<T> dst = to.ptr;\n  "
    "  unsafe\n    {\n        for (usize k = 0; k < m; k += 1)\n        {\n            copy_raw(\n            "
    "    reinterpret_ptr<u8>(dst + reinterpret<isize>(m - 1 - k)),\n                reinterpret_ptr<u8>(sr"
    "c + reinterpret<isize>(k)),\n                size,\n            );\n        }\n        release(reinterpr"
    "et_ptr<u8>(src), m * size);\n        if (stay > 0)\n        {\n            // `m >= stay`: the ranges d"
    "o not overlap.\n            copy_raw(reinterpret_ptr<u8>(src), reinterpret_ptr<u8>(src + reinterpret<"
    "isize>(m)), stay * size);\n            release(reinterpret_ptr<u8>(src + reinterpret<isize>(stay)), m"
    " * size);\n        }\n    }\n    to.len = m;\n    from.len = stay;\n}export fn Queue::push_back<T>(ref<Qu"
    "eue<T>, exclusive> q, T x)\n{\n    Vec::push(&mut q.tail, x);\n}export fn Queue::push_front<T>(ref<Queu"
    "e<T>, exclusive> q, T x)\n{\n    Vec::push(&mut q.head, x);\n}export fn Queue::pop_front<T>(ref<Queue<T"
    ">, exclusive> q) : Option<T>\n{\n    if (q.head.len == 0)\n    {\n        if (q.tail.len == 0)\n        {"
    "\n            return None;\n        }\n        q.took_front = true;\n        Queue::shift(&mut q.tail, &"
    "mut q.head, q.took_back);\n    }\n    Vec::pop(&mut q.head)\n}export fn Queue::pop_back<T>(ref<Queue<T>"
    ", exclusive> q) : Option<T>\n{\n    if (q.tail.len == 0)\n    {\n        if (q.head.len == 0)\n        {\n"
    "            return None;\n        }\n        q.took_back = true;\n        Queue::shift(&mut q.head, &mu"
    "t q.tail, q.took_front);\n    }\n    Vec::pop(&mut q.tail)\n}export fn Queue::front<T>(ref<Queue<T>, sh"
    "ared> q) : Option<ref<T, shared>>\n{\n    if (q.head.len > 0)\n    {\n        return Some(Vec::index_sha"
