    "3;\n        u64 d3 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4;\n        u64 d4 = h0 * r4 + h1 *"
    " r3 + h2 * r2 + h3 * r1 + h4 * r0;\n        u64 c = d0 >> 26;\n        h0 = d0 & m26;\n        d1 += c;"
    "\n        c = d1 >> 26;\n        h1 = d1 & m26;\n        d2 += c;\n        c = d2 >> 26;\n        h2 = d2"
    " & m26;\n        d3 += c;\n        c = d3 >> 26;\n        h3 = d3 & m26;\n        d4 += c;\n        c = d"
    "4 >> 26;\n        h4 = d4 & m26;\n        h0 += c * 5;\n        c = h0 >> 26;\n        h0 = h0 & m26;\n  "
