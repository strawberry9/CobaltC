    ":unwrap(opened), b\"hello\"));\n    sealed[0] = sealed[0] ^ 1;\n    assert(Option::is_none(&chacha20_pol"
    "y1305_open(&key, &nonce, &ad, &sealed)));\n}export fn chacha20_poly1305_open(\n    slice<u8, shared> k"
