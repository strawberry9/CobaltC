    "    {\n            x = x | (widen<u64>(b[8 * k + i]) << narrow<u32>(8 * i));\n        }\n        x = ae"
    "s_transpose8(x);\n        for (usize p = 0; p < 8; p += 1)\n        {\n            q[p] = q[p] | (((x >"
    "> narrow<u32>(8 * p)) & 0xff) << narrow<u32>(8 * k));\n        }\n    }\n    q\n}fn aes_unpack(array<u64"
