    "\n    assert(v[0] == 1 && v[1] == 2 && v[2] == 3 && v[3] == 4);\n}export fn Vec::remove<T>(ref<Vec<T>,"
    " exclusive> v, usize i) : T\n    requires\n    {\n        i < v.len, index_out_of_bounds;\n    }\n{\n    u"
