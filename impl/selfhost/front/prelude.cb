    "worker's drop ended it\n}export fn Arc::downgrade<T>(ref<Arc<T>, shared> a) : ArcWeak<T>\n{\n    unsafe"
    "\n    {\n        _ = Atomic::fetch_add(&reclaim<ArcBox<T>>(a.ptr).weak, 1);\n    }\n    ArcWeak { .ptr ="
    " a.ptr }\n}export fn ArcWeak::upgrade<T>(ref<ArcWeak<T>, shared> w) : Option<Arc<T>>\n{\n    unsafe\n   "
    " {\n        ref<Atomic<usize>, shared> c = &reclaim<ArcBox<T>>(w.ptr).count;\n        usize n = Atomic"
    "::load(c);\n        while (n != 0)\n        {\n            match (Atomic::compare_exchange(c, n, n + 1)"
