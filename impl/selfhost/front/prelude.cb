    "4d4423643ce80e2a9ac94fa54ca49f\");\n    assert(String::eq(&to_hex(&d[0..$]), &want));\n}export fn Sha38"
    "4::new() : Sha384\n{\n    Sha384 { .inner = Sha512 { .h = [\n        0xcbbb9d5dc1059ed8,\n        0x629a"
