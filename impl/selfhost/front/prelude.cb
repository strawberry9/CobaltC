    "reinterpret<isize>(c)), size);\n                *(sb + reinterpret<isize>(hole)) = *(sb + reinterpret"
    "<isize>(c));\n            }\n            hole = c;\n        }\n    }\n    if (hole != last)\n    {\n       "
    " unsafe\n        {\n            copy_raw(\n                reinterpret_ptr<u8>(ib + reinterpret<isize>("
    "hole)),\n                reinterpret_ptr<u8>(ib + reinterpret<isize>(last)),\n                size,\n  "
    "          );\n            release(reinterpret_ptr<u8>(ib + reinterpret<isize>(last)), size);\n        "
    "    *(sb + reinterpret<isize>(hole)) = *(sb + reinterpret<isize>(last));\n        }\n    }\n    q.items"
    ".len = last;\n    q.seqs.len = last;\n    if (hole != last)\n    {\n        PriorityQueue::sift_up(q, ho"
    "le);\n    }\n    Some(top)\n}export fn PriorityQueue::peek<T>(ref<PriorityQueue<T>, shared> q) : Option"
    "<ref<T, shared>>\n{\n    if (q.items.len == 0)\n    {\n        return None;\n    }\n    Some(Vec::index_sh"
    "ared(&q.items, 0))\n}export fn PriorityQueue::clear<T>(ref<PriorityQueue<T>, exclusive> q)\n{\n    Vec:"
    ":clear(&mut q.items);\n    Vec::clear(&mut q.seqs);\n    q.next = 0;\n}export fn Vec::push_le<T: intege"
    "r>(ref<Vec<u8>, exclusive> out, T x)\n{\n    usize n = sizeof<T>();\n    for (usize k = 0; k < n; k += "
    "1)\n    {\n        Vec::push(out, narrow_wrapping<u8>(x >> narrow<u32>(8 * k)));\n    }\n}export fn Vec:"
    ":push_be<T: integer>(ref<Vec<u8>, exclusive> out, T x)\n{\n    usize n = sizeof<T>();\n    for (usize k"
    " = 0; k < n; k += 1)\n    {\n        Vec::push(out, narrow_wrapping<u8>(x >> narrow<u32>(8 * (n - 1 - "
    "k))));\n    }\n}export fn read_le<T: integer>(slice<u8, shared> s, usize at) : T\n{\n    usize n = sizeo"
    "f<T>();\n    if (at > slice_len(s) || slice_len(s) - at < n)\n    {\n        fault(index_out_of_bounds)"
    ";\n    }\n    T acc = 0;\n    for (usize k = 0; k < n; k += 1)\n    {\n        acc = acc | (narrow_wrappi"
    "ng<T>(s[at + k]) << narrow<u32>(8 * k));\n    }\n    acc\n}export fn read_be<T: integer>(slice<u8, shar"
    "ed> s, usize at) : T\n{\n    usize n = sizeof<T>();\n    if (at > slice_len(s) || slice_len(s) - at < n"
    ")\n    {\n        fault(index_out_of_bounds);\n    }\n    T acc = 0;\n    for (usize k = 0; k < n; k += 1"
    ")\n    {\n        acc = acc | (narrow_wrapping<T>(s[at + k]) << narrow<u32>(8 * (n - 1 - k)));\n    }\n "
    "   acc\n}export fn slice_parts<T>(slice<T, exclusive> s, usize parts) : Vec<slice<T, exclusive>>\n{\n  "
    "  Vec<slice<T, exclusive>> out = Vec::new();\n    if (parts == 0)\n    {\n        return out;\n    }\n   "
    " usize n = slice_len(s);\n    usize at = 0;\n    for (usize k = 0; k < parts; k += 1)\n    {\n        us"
    "ize size = n / parts;\n        if (k < n % parts)\n        {\n            size += 1;\n        }\n        "
    "Vec::push(&mut out, &mut s[at..at + size]);\n        at += size;\n    }\n    out\n}export fn slice_swap<"
    "T>(slice<T, exclusive> s, usize i, usize j)\n{\n    if (i >= slice_len(s) || j >= slice_len(s))\n    {\n"
