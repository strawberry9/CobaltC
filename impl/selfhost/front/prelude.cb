    "[4 * i + 1] = narrow_wrapping<u8>(h[i] >> 16);\n        out[4 * i + 2] = narrow_wrapping<u8>(h[i] >> "
    "8);\n        out[4 * i + 3] = narrow_wrapping<u8>(h[i]);\n    }\n    out\n}export fn sha1(slice<u8, shar"
    "ed> data) : array<u8, 20>\n{\n    Sha1 s = Sha1::new();\n    Sha1::update(&mut s, data);\n    Sha1::fini"
    "sh(s)\n}unittest \"sha1: the published vector for abc\"\n{\n    array<u8, 20> d = sha1(&b\"abc\"[0..$]);\n  "
