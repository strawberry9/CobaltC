    "{\n        if (old_cap > 0)\n        {\n            deallocate(old, old_cap * sizeof<T>(), alignof<T>()"
    ");\n        }\n    }\n}export fn Vec::drop<T>(ref<Vec<T>, exclusive> self)\n{\n    usize mut_i = 0;\n    w"
    "hile (mut_i < self.len)\n    {\n        unsafe\n        {\n            drop(reclaim<T>(self.ptr + reinte"
    "rpret<isize>(mut_i)));\n        }\n        mut_i = mut_i + 1;\n    }\n    if (self.cap > 0)\n    {\n      "
