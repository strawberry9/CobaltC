    "ared(&q.tail, 0));\n    }\n    None\n}export fn Queue::back<T>(ref<Queue<T>, shared> q) : Option<ref<T,"
    " shared>>\n{\n    if (q.tail.len > 0)\n    {\n        return Some(Vec::index_shared(&q.tail, q.tail.len "
    "- 1));\n    }\n    if (q.head.len > 0)\n    {\n        return Some(Vec::index_shared(&q.head, 0));\n    }"
    "\n    None\n}unittest \"Queue: both ends\"\n{\n    Queue<i32> q = Queue::new();\n    Queue::push_back(&mut "
    "q, 2);\n    Queue::push_back(&mut q, 3);\n    Queue::push_front(&mut q, 1);\n    assert(*Option::unwrap"
    "(Queue::front(&q)) == 1);\n    assert(*Option::unwrap(Queue::back(&q)) == 3);\n    assert(Option::unwr"
    "ap(Queue::pop_back(&mut q)) == 3);\n    assert(Option::unwrap(Queue::pop_front(&mut q)) == 1);\n    as"
