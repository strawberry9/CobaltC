// The static pass, as impl/src/typecheck.rs does it, function for
// function and in its order: spec/12's typing rules, spec/06's literal
// typing and range checks, and `rule.control.flow-analysis` (spec/14 §6),
// the forward dataflow over each body with `valid(x)`, `init(x)` and
// `deriv(r, x.π, m)` in {T, F, ?}, joined at merges and iterated to a
// fixed point around `while`. Generics are checked per concrete
// instantiation, from a worklist that starts at `main`. What coby keys by
// an expression's address is keyed here by its id (`items::number`).

import std;
import ast;
import items;
import prelude;
import each;
import fmtcheck;
import views;

// D-0282: the access summaries (impl/src/tier.rs), a module of their own.
module tier "tier.cb";

import tier;

// ---- part 1: typecheck.rs lines 1-1400 ----

// [Extern-Non-Ffi-Type] (spec/20 rule.trust.extern-call): `FfiType ::=
// integer types | f32 | f64 | bool | void | rawptr<tau>`.
fn is_ffi_type(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TInt(_)    : true,
        Type::TF32       : true,
        Type::TF64       : true,
        Type::TBool      : true,
        Type::TVoid      : true,
        Type::TRawptr(_) : true,
        _                : false,
    }
}

// D-0254: the intrinsics whose two operands are one `simd` type.
fn is_simd_pair_intrinsic(StringView name) : bool
{
    foreach (n in ["simd_eq", "simd_ne", "simd_lt", "simd_le", "simd_gt", "simd_ge", "simd_min", "simd_max"])
    {
        if (StringView::eq_str(name, n))
        {
            return true;
        }
    }
    false
}

fn simd_of(Type lane, u128 n) : Type
{
    Type::TSimd(Box::new(SizedTy { .inner = lane, .n = n }))
}

// D-0254: a `simd`'s mask type: signed integer lanes of the lanes' width.
fn simd_mask_of(ref<Type, shared> t) : Option<Type>
{
    match (t)
    {
        Type::TSimd(b) :
        {
            ref<SizedTy, shared> s = Box::get(b);
            IntTy m = match (&s.inner)
            {
                Type::TInt(i) :
                {
                    if (*i == IntTy::I8 || *i == IntTy::U8)
                    {
                        IntTy::I8
                    }
                    else if (*i == IntTy::I16 || *i == IntTy::U16)
                    {
                        IntTy::I16
                    }
                    else if (*i == IntTy::I32 || *i == IntTy::U32)
                    {
                        IntTy::I32
                    }
                    else
                    {
                        IntTy::I64
                    }
                },
                Type::TF32    : IntTy::I32,
                _             : IntTy::I64,
            };
            Some(simd_of(Type::TInt(m), s.n))
        },
        _              : None,
    }
}

fn is_simd(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TSimd(_) : true,
        _              : false,
    }
}

fn is_never(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNever : true,
        _            : false,
    }
}

fn lane_of(ref<Type, shared> t) : Type
{
    match (t)
    {
        Type::TSimd(b) : clone(&Box::get(b).inner),
        _              : Type::TVoid,
    }
}

// The known, resolved type of argument `k`.
fn simd_arg(ref<Vec<Option<Type>>, shared> arg_tys, usize k) : Option<Type>
{
    if (k >= Vec::len(arg_tys))
    {
        return None;
    }
    match (&arg_tys[k])
    {
        Some(t) :
        {
            if (has_unresolved_marker(t) || is_never(t))
            {
                return None;
            }
            Some(clone(t))
        },
        None    : None,
    }
}

fn need_simd(StringView name, ref<Vec<Option<Type>>, shared> arg_tys, usize k) : Result<Option<Type>, String>
{
    match (simd_arg(arg_tys, k))
    {
        None    : Ok(None),
        Some(t) :
        {
            if (is_simd(&t))
            {
                return Ok(Some(t));
            }
            Err(mismatch(sprintf("`%s` takes a `simd`, and this is `%s`", name, &type_display(&t))))
        },
    }
}

fn simd_same(StringView name, ref<Option<Type>, shared> a, ref<Option<Type>, shared> b) : Result<void, String>
{
    match (a)
    {
        Some(x) : match (b)
        {
            Some(y) :
            {
                if (!type_eq(x, y))
                {
                    return Err(mismatch(sprintf(
                        "`%s` takes two of one `simd` type, and these are `%s` and `%s`",
                        name,
                        &type_display(x),
                        &type_display(y),
                    )));
                }
            },
            None    : {},
        },
        None : {},
    }
    Ok(())
}

fn or_type(Option<Type> a, Option<Type> b) : Option<Type>
{
    match (a)
    {
        Some(t) : Some(t),
        None    : b,
    }
}

// D-0254 `rule.stdlib.simd` (spec/21 §0): the type of a lane-wise
// intrinsic, or `None` for an intrinsic that is not one.
fn simd_intrinsic_type(
    StringView name,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Option<Type>>, shared> arg_tys,
) : Result<Option<Type>, String>
{
    bool wrap_sat = StringView::eq_str(
        name,
        "wrapping_add",
    ) || StringView::eq_str(
        name,
        "wrapping_sub",
    ) || StringView::eq_str(
        name,
        "wrapping_mul",
    ) || StringView::eq_str(name, "saturating_add") || StringView::eq_str(name, "saturating_sub");
    bool any_simd = match (simd_arg(arg_tys, 0))
    {
        Some(t) : is_simd(&t),
        None    : false,
    } || match (simd_arg(arg_tys, 1))
    {
        Some(t) : is_simd(&t),
        None    : false,
    };
    if (wrap_sat && any_simd)
    {
        Option<Type> a = need_simd(name, arg_tys, 0)?;
        Option<Type> b = need_simd(name, arg_tys, 1)?;
        simd_same(name, &a, &b)?;
        Type t = Option::expect(or_type(a, b), "a simd operand");
        match (lane_of(&t))
        {
            Type::TInt(_) : {},
            _             : return Err(mismatch(sprintf("`%s` on a `simd` takes integer lanes", name))),
        }
        return Ok(Some(t));
    }
    if (is_simd_pair_intrinsic(name))
    {
        Option<Type> a = need_simd(name, arg_tys, 0)?;
        Option<Type> b = need_simd(name, arg_tys, 1)?;
        simd_same(name, &a, &b)?;
        return match (or_type(a, b))
        {
            Some(t) :
            {
                if (StringView::eq_str(name, "simd_min") || StringView::eq_str(name, "simd_max"))
                {
                    return Ok(Some(t));
                }
                Ok(simd_mask_of(&t))
            },
            None    : Ok(None),
        };
    }
    if (StringView::eq_str(name, "simd_select"))
    {
        Option<Type> m = need_simd(name, arg_tys, 0)?;
        Option<Type> a = need_simd(name, arg_tys, 1)?;
        Option<Type> b = need_simd(name, arg_tys, 2)?;
        simd_same(name, &a, &b)?;
        Option<Type> t = match (&a)
        {
            Some(x) : Some(clone(x)),
            None    : clone(&b),
        };
        match (&m)
        {
            Some(mm) : match (&t)
            {
                Some(tt) :
                {
                    Option<Type> want = simd_mask_of(tt);
                    bool same = match (&want)
                    {
                        Some(w) : type_eq(w, mm),
                        None    : false,
                    };
                    if (!same)
                    {
                        return Err(mismatch(sprintf(
                            "`simd_select` takes a mask of `%s`'s shape, `%s`, and this is `%s`",
                            &type_display(tt),
                            &type_display(&Option::expect(want, "a mask")),
                            &type_display(mm),
                        )));
                    }
                },
                None     : {},
            },
            None : {},
        }
        return Ok(or_type(a, b));
    }
    if (StringView::eq_str(name, "simd_any") || StringView::eq_str(name, "simd_all"))
    {
        match (need_simd(name, arg_tys, 0)?)
        {
            Some(m) :
            {
                bool signed_lanes = match (lane_of(&m))
                {
                    Type::TInt(i) : int_ty_signed(i),
                    _             : false,
                };
                if (!signed_lanes)
                {
                    return Err(mismatch(sprintf(
                        "`%s` tests a mask (signed integer lanes, -1 or 0), and this is `%s`",
                        name,
                        &type_display(&m),
                    )));
                }
            },
            None    : {},
        }
        return Ok(Some(Type::TBool));
    }
    if (StringView::eq_str(
        name,
        "simd_sum",
    ) || StringView::eq_str(name, "simd_reduce_min") || StringView::eq_str(name, "simd_reduce_max"))
    {
        return match (need_simd(name, arg_tys, 0)?)
        {
            Some(t) : Ok(Some(lane_of(&t))),
            None    : Ok(None),
        };
    }
    if (StringView::eq_str(name, "simd_load"))
    {
        bool is_vec = Vec::len(targs) > 0 && is_simd(&targs[0]);
        if (!is_vec)
        {
            return Err(mismatch(String::from_str("`simd_load` names the vector type it makes: `simd_load<simd<f32, 4>>(s, i)`")));
        }
        ref<Type, shared> v = &targs[0];
        Type lane = lane_of(v);
        match (simd_arg(arg_tys, 0))
        {
            Some(Type::TSlice(sb)) :
            {
                if (!type_eq(&Box::get(&sb).inner, &lane))
                {
                    return Err(mismatch(sprintf(
                        "`simd_load<%s>` reads a `slice<%s, _>`, and this is `%s`",
                        &type_display(v),
                        &type_display(&lane),
                        &type_display(&Type::TSlice(sb)),
                    )));
                }
            },
            Some(t) : return Err(mismatch(sprintf(
                "`simd_load<%s>` reads a `slice<%s, _>`, and this is `%s`",
                &type_display(v),
                &type_display(&lane),
                &type_display(&t),
            ))),
            None                   : {},
        }
        return Ok(Some(clone(v)));
    }
    if (StringView::eq_str(name, "simd_store"))
    {
        Option<Type> a0 = simd_arg(arg_tys, 0);
        bool slice0 = match (&a0)
        {
            Some(Type::TSlice(_)) : true,
            _                     : false,
        };
        if (slice0)
        {
            match (need_simd(name, arg_tys, 2)?)
            {
                Some(v) :
                {
                    match (&a0)
                    {
                        Some(Type::TSlice(sb)) :
                        {
                            ref<ModedTy, shared> s = Box::get(sb);
                            if (s.mode != Mode::Exclusive || !type_eq(&s.inner, &lane_of(&v)))
                            {
                                return Err(mismatch(sprintf(
                                    "`simd_store` writes a `%s` into a `slice<%s, exclusive>`, and this is `slice<%s, %s>`",
                                    &type_display(&v),
                                    &type_display(&lane_of(&v)),
                                    &type_display(&s.inner),
                                    if (s.mode == Mode::Exclusive) { "exclusive" } else { "shared" },
                                )));
                            }
                        },
                        _                      : {},
                    }
                },
                None    : {},
            }
        }
        else
        {
            match (a0)
            {
                Some(t) : return Err(mismatch(sprintf(
                    "`simd_store` writes into a `slice<τ, exclusive>`, and this is `%s`",
                    &type_display(&t),
                ))),
                None : {},
            }
        }
        return Ok(Some(Type::TVoid));
    }
    Ok(None)
}

fn op_symbol(BinOp op) : str
{
    match (op)
    {
        BinOp::Add    : "+",
        BinOp::Sub    : "-",
        BinOp::Mul    : "*",
        BinOp::Div    : "/",
        BinOp::Rem    : "%",
        BinOp::Shl    : "<<",
        BinOp::Shr    : ">>",
        BinOp::BitAnd : "&",
        BinOp::BitOr  : "|",
        BinOp::BitXor : "^",
        BinOp::Eq     : "==",
        BinOp::Ne     : "!=",
        BinOp::Lt     : "<",
        BinOp::Le     : "<=",
        BinOp::Gt     : ">",
        BinOp::Ge     : ">=",
        BinOp::And    : "&&",
        BinOp::Or     : "||",
    }
}

// D-0254 `[T-Simd-Op]`: an operator with a `simd` operand.
fn simd_binary_type(BinOp op, ref<Option<Type>, shared> at, ref<Option<Type>, shared> bt) : Result<Option<Type>, String>
{
    ref<Type, shared> ta = match (at)
    {
        Some(t) : t,
        None    : return Ok(clone(bt)),
    };
    ref<Type, shared> tb = match (bt)
    {
        Some(t) : t,
        None    : return Ok(clone(at)),
    };
    if (has_unresolved_marker(ta) || has_unresolved_marker(tb) || is_never(ta) || is_never(tb))
    {
        return Ok(Some(if (is_simd(ta)) { clone(ta) } else { clone(tb) }));
    }
    str sym = op_symbol(op);
    if (!type_eq(ta, tb))
    {
        return Err(mismatch(sprintf(
            "`%s` on a `simd` takes two of one type, lane by lane, and these are `%s` and `%s`; a scalar is made a vector with `[x; N]`",
            sym,
            &type_display(ta),
            &type_display(tb),
        )));
    }
    bool int = match (lane_of(ta))
    {
        Type::TInt(_) : true,
        _             : false,
    };
    if (op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul)
    {
        return Ok(Some(clone(ta)));
    }
    if (op == BinOp::Div && !int)
    {
        return Ok(Some(clone(ta)));
    }
    if (op == BinOp::Div || op == BinOp::Rem)
    {
        return Err(mismatch(sprintf(
            "`%s` on a `simd` is defined for float lanes only: no processor divides integer lanes at once; divide lane by lane",
            sym,
        )));
    }
    if (op == BinOp::BitAnd || op == BinOp::BitOr || op == BinOp::BitXor || op == BinOp::Shl || op == BinOp::Shr)
    {
        if (int)
        {
            return Ok(Some(clone(ta)));
        }
        return Err(mismatch(sprintf("`%s` on a `simd` is defined for integer lanes only", sym)));
    }
    if (op == BinOp::Eq || op == BinOp::Ne)
    {
        return Ok(Some(Type::TBool));
    }
    if (op == BinOp::Lt || op == BinOp::Le || op == BinOp::Gt || op == BinOp::Ge)
    {
        return Err(mismatch(sprintf(
            "`%s` does not order two vectors; compare them lane by lane with `simd_lt`, `simd_le`, `simd_gt` or `simd_ge`, which give a mask",
            sym,
        )));
    }
    Err(mismatch(sprintf("`%s` takes `bool`s; masks combine with `&` and `|`", sym)))
}

fn named_is(ref<Type, shared> t, StringView name) : bool
{
    match (t)
    {
        Type::TNamed(b) : String::eq_view(&Box::get(b).name, name),
        _               : false,
    }
}

fn named_args(ref<Type, shared> t) : Vec<Type>
{
    match (t)
    {
        Type::TNamed(b) : clone(&Box::get(b).args),
        _               : Vec::new(),
    }
}

fn rawptr_of(Type t) : Type
{
    Type::TRawptr(Box::new(t))
}

fn ref_of(Type t, Mode m) : Type
{
    Type::TRef(Box::new(ModedTy { .inner = t, .mode = m }))
}

fn slice_of(Type t, Mode m) : Type
{
    Type::TSlice(Box::new(ModedTy { .inner = t, .mode = m }))
}

fn array_of(Type t, u128 n) : Type
{
    Type::TArray(Box::new(SizedTy { .inner = t, .n = n }))
}

fn fn_of(Vec<Type> params, Type ret) : Type
{
    Type::TFn(Box::new(FnTy { .params = params, .ret = ret }))
}

// D-0249, D-0253: the type of an atomic's one cell, from the type of a
// reference to it: `T` for `Atomic<T>`, `rawptr<T>` for `AtomicPtr<T>`.
fn atomic_cell_ty(ref<Type, shared> t) : Option<Type>
{
    match (t)
    {
        Type::TRef(b) :
        {
            ref<Type, shared> a = &Box::get(b).inner;
            Vec<Type> args = named_args(a);
            if (named_is(a, "std::Atomic"))
            {
                return if (Vec::len(&args) > 0) { Some(clone(&args[0])) } else { None };
            }
            if (named_is(a, "std::AtomicPtr"))
            {
                return if (Vec::len(&args) > 0) { Some(rawptr_of(clone(&args[0]))) } else { None };
            }
            None
        },
        _             : None,
    }
}

export struct FfiProblem
{
    export Vec<String> path;
    export String what;
}

fn ffi_here(String what) : Option<FfiProblem>
{
    Some(FfiProblem { .path = Vec::new(), .what = what })
}

// D-0252: `FfiType` also has every `ffi-struct`. `None` when `t` crosses;
// otherwise the field path to the part C could not receive and what that
// part is, for the message.
fn ffi_type_problem(ref<Items, shared> it, ref<Type, shared> t, bool top) : Option<FfiProblem>
{
    match (t)
    {
        Type::TVoid : if (top) { return None; },
        _           : {},
    }
    bool void_t = match (t)
    {
        Type::TVoid : true,
        _           : false,
    };
    if (is_ffi_type(t) && !void_t)
    {
        return None;
    }
    match (t)
    {
        Type::TArray(b) :
        {
            if (!top && Box::get(b).n > 0)
            {
                return ffi_type_problem(it, &Box::get(b).inner, false);
            }
            if (top)
            {
                return ffi_here(sprintf(
                    "`%s`, an array, which C passes only as a pointer (`rawptr`)",
                    &type_display(t),
                ));
            }
        },
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (HashMap::contains(&it.enums, &n.name))
            {
                return ffi_here(sprintf("`%s`, an enum (a C enum is an integer type here)", &type_display(t)));
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    if (s.resource_ || (String::starts_with(&n.name, "std::") && is_resource_ty(it, t)))
                    {
                        return ffi_here(sprintf("`%s`, a resource", &type_display(t)));
                    }
                    if (Option::is_some(&s.bits))
                    {
                        return ffi_here(sprintf(
                            "`%s`, a bitstruct (it crosses as its backing integer)",
                            &type_display(t),
                        ));
                    }
                    if (Vec::len(&s.fields) == 0)
                    {
                        return ffi_here(sprintf("`%s`, a struct with no fields", &type_display(t)));
                    }
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        match (ffi_type_problem(it, &apply_subst(&s.fields[i].ty, &subst), false))
                        {
                            Some(p) :
                            {
                                FfiProblem { path, what } = p;
                                Vec::insert(&mut path, 0, String::clone(&s.fields[i].name));
                                return Some(FfiProblem { .path = path, .what = what });
                            },
                            None    : {},
                        }
                    }
                    return None;
                },
                None    : {},
            }
        },
        _               : {},
    }
    ffi_here(sprintf("`%s`", &type_display(t)))
}

// `params` zipped with `args` (the shorter's length) as a substitution.
export fn zip_subst(ref<Vec<String>, shared> params, ref<Vec<Type>, shared> args) : HashMap<String, Type>
{
    HashMap<String, Type> m = HashMap::new();
    for (usize i = 0; i < Vec::len(params) && i < Vec::len(args); i += 1)
    {
        HashMap::insert(&mut m, String::clone(&params[i]), clone(&args[i]));
    }
    m
}

// The module part of an item's qualified key: one trailing segment for
// `m::f`, two for an associated `m::T::name`.
fn declaring_module(StringView key, bool assoc) : String
{
    Vec<StringView> segs = StringView::split(key, "::");
    Vec::pop(&mut segs);
    if (assoc)
    {
        Vec::pop(&mut segs);
    }
    StringView::join(&segs[0..$], "::")
}

// `rule.module.visibility` `[Field-Not-Visible]`: a field is visible where
// its struct's module is, or anywhere if `export`.
fn field_visible(StringView struct_key, bool export_, StringView from_module) : bool
{
    if (export_)
    {
        return true;
    }
    StringView decl_module = match (rfind_sep(struct_key))
    {
        Some(k) : StringView::sub(struct_key, 0, k),
        None    : "",
    };
    if (StringView::len(decl_module) == 0 || StringView::eq(from_module, decl_module))
    {
        return true;
    }
    String prefix = sprintf("%s::", decl_module);
    StringView::starts_with(from_module, String::as_view(&prefix))
}

// The position of the last `::` in `s`.
fn rfind_sep(StringView s) : Option<usize>
{
    slice<u8, shared> b = StringView::as_bytes(s);
    usize n = StringView::len(s);
    usize k = n;
    while (k >= 2)
    {
        k -= 1;
        if (b[k] == b':' && b[k - 1] == b':')
        {
            return Some(k - 1);
        }
    }
    None
}

fn types_contain(ref<Vec<Type>, shared> v, ref<Type, shared> t) : bool
{
    for (usize i = 0; i < Vec::len(v); i += 1)
    {
        if (type_eq(&v[i], t))
        {
            return true;
        }
    }
    false
}

// `[Type-Recursive]` (D-0045): a struct or enum that contains itself by
// value has no finite size; 64 levels deep counts as recursive.
fn contains_by_value(ref<Items, shared> it, ref<Type, shared> t, ref<Vec<Type>, exclusive> stack) : bool
{
    match (t)
    {
        Type::TArray(b) : contains_by_value(it, &Box::get(b).inner, stack),
        Type::TMutex(b) : contains_by_value(it, Box::get(b), stack),
        Type::TNamed(b) :
        {
            if (types_contain(stack, t) || Vec::len(stack) > 64)
            {
                return true;
            }
            ref<NamedTy, shared> n = Box::get(b);
            Vec<String> params = Vec::new();
            Vec<Type> parts = Vec::new();
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    params = Vec::clone(&s.type_params);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        Vec::push(&mut parts, clone(&s.fields[i].ty));
                    }
                },
                None : match (HashMap::get(&it.enums, &n.name))
                {
                    Some(e) :
                    {
                        params = Vec::clone(&e.type_params);
                        for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                        {
                            match (&e.variants[i].payload)
                            {
                                Some(p) : Vec::push(&mut parts, clone(p)),
                                None    : {},
                            }
                        }
                    },
                    None    : return false,
                },
            }
            HashMap<String, Type> sub = zip_subst(&params, &n.args);
            Vec::push(stack, clone(t));
            bool found = false;
            for (usize i = 0; i < Vec::len(&parts) && !found; i += 1)
            {
                found = contains_by_value(it, &apply_subst(&parts[i], &sub), stack);
            }
            Vec::pop(stack);
            found
        },
        _               : false,
    }
}

struct DeclRef
{
    String key;
    Vec<String> params;
    usize line;
}

struct KeyLine
{
    String key;
    usize line;
}

// The first (by name) struct or enum that contains itself by value.
fn recursive_type(ref<Items, shared> it) : Option<KeyLine>
{
    Vec<String> keys = Vec::new();
    for (usize i = 0; i < HashMap::len(&it.structs); i += 1)
    {
        Vec::push(&mut keys, String::clone(HashMap::key_at(&it.structs, i)));
    }
    for (usize i = 0; i < HashMap::len(&it.enums); i += 1)
    {
        Vec::push(&mut keys, String::clone(HashMap::key_at(&it.enums, i)));
    }
    Vec::sort(&mut keys);
    for (usize i = 0; i < Vec::len(&keys); i += 1)
    {
        ref<String, shared> k = &keys[i];
        Vec<String> params = Vec::new();
        usize line = 0;
        match (HashMap::get(&it.structs, k))
        {
            Some(s) :
            {
                params = Vec::clone(&s.type_params);
                line = s.line;
            },
            None    :
            {
                ref<EnumDecl, shared> e = Option::expect(HashMap::get(&it.enums, k), "an enum");
                params = Vec::clone(&e.type_params);
                line = e.line;
            },
        }
        Vec<Type> args = Vec::new();
        for (usize p = 0; p < Vec::len(&params); p += 1)
        {
            Vec::push(&mut args, named(String::as_view(&params[p]), Vec::new()));
        }
        Type t = named(String::as_view(k), args);
        Vec<Type> stack = Vec::new();
        if (contains_by_value(it, &t, &mut stack))
        {
            return Some(KeyLine { .key = String::clone(k), .line = line });
        }
    }
    None
}

fn tagged_at(String d, usize line) : String
{
    sprintf("%s@%v", &d, line)
}

fn named_diag(str id, ref<String, shared> msg) : String
{
    sprintf("%s\u{1}%s", id, msg)
}

fn sorted_keys_of_fns(ref<HashMap<String, FnDecl>, shared> m) : Vec<String>
{
    Vec<String> keys = Vec::new();
    for (usize i = 0; i < HashMap::len(m); i += 1)
    {
        Vec::push(&mut keys, String::clone(HashMap::key_at(m, i)));
    }
    Vec::sort(&mut keys);
    keys
}

// Whether `v` (a literal's value) fits integer type `t` (`value::in_range`).
fn in_range(IntTy t, i128 v) : bool
{
    if (t == IntTy::U128)
    {
        return true;
    }
    IntRange r = int_range(t);
    v >= r.min && v <= r.max
}

// The checker's facts for the tools that run or lower the program: what
// coby's `interp::Items` holds behind its locks, each keyed by an
// expression's id, and the D-0162 records.
export struct Facts
{
    export HashMap<String, bool> checked_fns;
    export HashMap<usize, Type> match_hints;
    export HashSet<usize> temp_borrows;
    export HashSet<usize> shared_fn_reads;
    export HashMap<usize, Vec<String>> early_ends;
    export HashMap<usize, Type> closure_types;
    export HashSet<usize> number_literals;
    export HashSet<String> const_addrs;
    // D-0103: `f().x` moving a field out of a temporary, and the block
    // both evaluators run instead.
    export HashMap<usize, Expr> temp_moves;
    // D-0053: the expressions that are `StringView` operations.
    export HashMap<usize, ViewOp> view_ops;
    // An `if`'s type when its expected type is fixed only by one branch
    // (coby keys it by the then-block), by the `if`'s id.
    export HashMap<usize, Type> if_hints;
    // D-0162: text literals typed as `String` through a generic
    // parameter (`literal_yes`) and otherwise (`literal_no`), and the
    // rewrites the checker asks for (D-0164, D-0218, D-0225).
    export HashSet<usize> literal_yes;
    export HashSet<usize> literal_no;
    export HashMap<usize, Rewrite> rewrites;
    // While `check_more` runs: its literal records and rewrites are not kept.
    export bool silent;
    // Each block's `early_end_plan`, by `block_key`: it depends on the
    // block's text alone, and a block is checked again and again.
    HashMap<usize, EarlyPlan> plans;
    // D-0290: `holder_type`, `data_type` and `stores_refs` of each type
    // asked about, and `may_hold_excl_ref`, by `type_code`: they depend on
    // the type alone (coby keeps the first per body, `type_memo`).
    HashMap<String, TypeKinds> type_memo;
    HashMap<String, bool> excl_memo;
}

export fn new_facts() : Facts
{
    Facts {
        .checked_fns = HashMap::new(),
        .match_hints = HashMap::new(),
        .temp_borrows = HashSet::new(),
        .shared_fn_reads = HashSet::new(),
        .early_ends = HashMap::new(),
        .closure_types = HashMap::new(),
        .number_literals = HashSet::new(),
        .const_addrs = HashSet::new(),
        .temp_moves = HashMap::new(),
        .view_ops = HashMap::new(),
        .if_hints = HashMap::new(),
        .literal_yes = HashSet::new(),
        .literal_no = HashSet::new(),
        .rewrites = HashMap::new(),
        .silent = false,
        .plans = HashMap::new(),
        .type_memo = HashMap::new(),
        .excl_memo = HashMap::new(),
    }
}

// Whether every item is checked, `std`'s included (`COBALTC_CHECK_ALL=1`),
// or only the program's own items and the `std` items they reach.
fn check_all() : bool
{
    match (env_var("COBALTC_CHECK_ALL"))
    {
        Ok(Some(v)) : String::len(&v) > 0 && !String::eq_str(&v, "0"),
        _           : false,
    }
}

// An item of `std` (coby asks whether its line is in the prelude).
fn is_std_key(ref<String, shared> key) : bool
{
    String::starts_with(key, "std::")
}

/// A `static_assert` (D-0052) to compute once the static pass accepts the
/// program.
// Where a diagnostic's line inside `std` begins: `STD_LINE + N` is line N of
// the prelude (`PRELUDE_STD_ORIGINS` places it in `std`'s files).
export const usize STD_LINE = 1099511627776;

export struct StaticAssert
{
    String key_code;
    export Expr cond;
    export HashMap<String, Type> subst;
    export usize line;
    export Option<String> message;
    export Option<Expr> message_fmt;
}

struct WorkItem
{
    String name;
    Vec<Type> targs;
}

fn work(ref<String, shared> name, Vec<Type> targs) : WorkItem
{
    WorkItem { .name = String::clone(name), .targs = targs }
}

export fn work_code(ref<String, shared> name, ref<Vec<Type>, shared> targs) : String
{
    sprintf("%s|%s", name, &types_code(targs))
}

struct Ck
{
    HashSet<String> checked;
    Vec<WorkItem> worklist;
    // `[Generic-Instantiation-Unbounded]` (CHG-0357): concrete
    // instantiations checked so far.
    u32 instances;
    Vec<StaticAssert> static_asserts;
    HashSet<String> static_assert_keys;
}

// A function the lowering asks for that the static pass has not checked
// (`printf`'s helpers, `Vec`'s growth, a destructor): checked now, its body
// loaded first, nothing it records about literals kept (`check_more`).
export fn check_more(
    ref<Items, exclusive> it,
    ref<Front, shared> front,
    ref<Facts, exclusive> facts,
    ref<String, shared> name,
    ref<Vec<Type>, shared> targs,
) : Result<void, String>
{
    Vec<WorkItem> wl = Vec::new();
    Vec::push(&mut wl, work(name, clone(targs)));
    Ck ck = new_ck(wl);
    for (usize k = 0; k < HashMap::len(&facts.checked_fns); k += 1)
    {
        HashSet::insert(&mut ck.checked, String::clone(HashMap::key_at(&facts.checked_fns, k)));
    }
    bool was = facts.silent;
    facts.silent = true;
    Result<void, String> r = ck_run(&mut ck, it, front, facts);
    facts.silent = was;
    r
}

fn new_ck(Vec<WorkItem> worklist) : Ck
{
    Ck {
        .checked = HashSet::new(),
        .worklist = worklist,
        .instances = 0,
        .static_asserts = Vec::new(),
        .static_assert_keys = HashSet::new(),
    }
}

export fn check_program(
    ref<Items, exclusive> it,
    ref<Front, shared> front,
    ref<Facts, exclusive> facts,
) : Result<Vec<StaticAssert>, String>
{
    match (recursive_type(it))
    {
        Some(kl) :
        {
            StringView shown = last_segment(String::as_view(&kl.key));
            String msg = sprintf(
                "`%s` contains a `%s` by value (directly or through its fields), so it would have no finite size; hold the inner one through `Box<%s>` (`Option<Box<%s>>` for \"none\"), `Rc<%s>`, or an index into a `Vec`",
                shown,
                shown,
                shown,
                shown,
                shown,
            );
            return Err(tagged_at(named_diag("diag.recursive-type", &msg), kl.line));
        },
        None     : {},
    }
    Vec<String> keys = sorted_keys_of_fns(&it.fns);
    // `[Const-Not-Constant]` (D-0036).
    for (usize i = 0; i < Vec::len(&keys); i += 1)
    {
        ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &keys[i]), "a function");
        if (f.is_const)
        {
            bool init_ok = match (&f.body.tail)
            {
                Some(e) : const_expr(it, Box::get(e)),
                None    : false,
            };
            if (is_resource_ty(it, &f.ret) || !init_ok)
            {
                return Err(sprintf("diag.const-not-constant@%v", f.line));
            }
        }
    }
    // D-0258 `[Static-Well-Formed]`, each reported where it is declared.
    Vec<KeyLine> statics = Vec::new();
    for (usize i = 0; i < HashMap::len(&it.statics); i += 1)
    {
        Vec::push(
            &mut statics,
            KeyLine { .key = String::clone(HashMap::key_at(
                &it.statics,
                i,
            )), .line = HashMap::value_at(&it.statics, i).line },
        );
    }
    sort_by_line(&mut statics);
    for (usize i = 0; i < Vec::len(&statics); i += 1)
    {
        ref<StaticDecl, shared> s = Option::expect(HashMap::get(&it.statics, &statics[i].key), "a static");
        Option<Type> lane = static_lane(&s.ty);
        bool ok_init = match (&lane)
        {
            Some(Type::TInt(_)) : match (&s.init.kind)
            {
                ExprKind::EInt(_) : true,
                ExprKind::EUnary(u) : Box::get(u).op == UnOp::Neg && match (&Box::get(u).e.kind)
                {
                    ExprKind::EInt(_) : true,
                    _                 : false,
                },
                _                 : false,
            },
            Some(Type::TBool) : match (&s.init.kind)
            {
                ExprKind::EBool(_) : true,
                _                  : false,
            },
            _ : false,
        };
        match (&lane)
        {
            None     :
            {
                String msg = sprintf(
                    "a `static` holds an atomic, `Atomic<T>` (`T` an integer type) or `AtomicBool`, which every thread may change; `%s` is not one (a constant is `const`, and any other value lives in `main` and is passed on)",
                    &type_display(&s.ty),
                );
                return Err(tagged_at(named_diag("diag.type-mismatch", &msg), s.line));
            },
            Some(lt) :
            {
                if (!ok_init)
                {
                    String msg = sprintf(
                        "a `static`'s first value is a literal of `%s`: `static %s %s = 0;`",
                        &type_display(lt),
                        &type_display(&s.ty),
                        &s.name,
                    );
                    return Err(tagged_at(named_diag("diag.type-mismatch", &msg), s.line));
                }
                match (lt)
                {
                    Type::TInt(itx) :
                    {
                        match (&s.init.kind)
                        {
                            ExprKind::EInt(lb) :
                            {
                                u128 v = Box::get(lb).v;
                                if (!in_range(*itx, reinterpret<i128>(v)))
                                {
                                    String msg = sprintf(
                                        "`%v` does not fit `%s`, the static's lane type",
                                        v,
                                        &type_display(lt),
                                    );
                                    return Err(tagged_at(named_diag("diag.literal-out-of-range", &msg), s.line));
                                }
                            },
                            _                  : {},
                        }
                    },
                    _               : {},
                }
            },
        }
    }
    // `[Extern-Non-Ffi-Type]` on every declared extern fn.
    Vec<KeyLine> exts = Vec::new();
    for (usize i = 0; i < HashMap::len(&it.externs); i += 1)
    {
        Vec::push(
            &mut exts,
            KeyLine { .key = String::clone(HashMap::key_at(
                &it.externs,
                i,
            )), .line = HashMap::value_at(&it.externs, i).line },
        );
    }
    sort_by_line(&mut exts);
    for (usize i = 0; i < Vec::len(&exts); i += 1)
    {
        ref<ExternDecl, shared> ext = Option::expect(HashMap::get(&it.externs, &exts[i].key), "an extern");
        Vec<Type> tys = Vec::new();
        for (usize p = 0; p < Vec::len(&ext.params); p += 1)
        {
            Vec::push(&mut tys, clone(&ext.params[p].ty));
        }
        Vec::push(&mut tys, clone(&ext.ret));
        for (usize k = 0; k < Vec::len(&tys); k += 1)
        {
            match (ffi_type_problem(it, &tys[k], true))
            {
                Some(p) :
                {
                    String part = ffi_part(&tys[k], p);
                    String msg = sprintf(
                        "`%s` cannot cross to C: its signature has %s; an extern's types are integers, `f32`, `f64`, `bool`, `rawptr<T>` and plain structs of those (D-0252)",
                        &ext.name,
                        &part,
                    );
                    return Err(tagged_at(named_diag("diag.extern-non-ffi-type", &msg), ext.line));
                },
                None    : {},
            }
        }
    }
    // D-0257 `[Extern-Entry]`.
    Vec<KeyLine> entries = Vec::new();
    for (usize i = 0; i < Vec::len(&keys); i += 1)
    {
        ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &keys[i]), "a function");
        if (f.c_entry)
        {
            Vec::push(&mut entries, KeyLine { .key = String::clone(&keys[i]), .line = f.line });
        }
    }
    sort_by_line(&mut entries);
    HashMap<String, String> entry_names = HashMap::new();
    for (usize i = 0; i < Vec::len(&entries); i += 1)
    {
        ref<String, shared> key = &entries[i].key;
        ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, key), "a function");
        Vec<Type> tys = Vec::new();
        for (usize p = 0; p < Vec::len(&f.params); p += 1)
        {
            Vec::push(&mut tys, clone(&f.params[p].ty));
        }
        Vec::push(&mut tys, clone(&f.ret));
        for (usize k = 0; k < Vec::len(&tys); k += 1)
        {
            match (ffi_type_problem(it, &tys[k], true))
            {
                Some(p) :
                {
                    String part = ffi_part(&tys[k], p);
                    String msg = sprintf(
                        "`%s` cannot be called from C: its signature has %s; a function C calls takes and gives integers, `f32`, `f64`, `bool`, `rawptr<T>` and plain structs of those (D-0257)",
                        &f.name,
                        &part,
                    );
                    return Err(tagged_at(named_diag("diag.extern-non-ffi-type", &msg), f.line));
                },
                None    : {},
            }
        }
        if (String::starts_with(&f.name, "cb_") || String::starts_with(&f.name, "cobalt_"))
        {
            String msg = sprintf(
                "`%s` is a C name the runtime reserves (`cb_…` and `cobalt_…`); choose another for a function C calls",
                &f.name,
            );
            return Err(tagged_at(named_diag("diag.duplicate-item", &msg), f.line));
        }
        match (HashMap::insert(&mut entry_names, String::clone(&f.name), String::clone(key)))
        {
            Some(other) :
            {
                String msg = sprintf(
                    "`%s` and `%s` would both be C's `%s`: two functions C calls cannot share a name",
                    &other,
                    key,
                    &f.name,
                );
                return Err(tagged_at(named_diag("diag.duplicate-item", &msg), f.line));
            },
            None        : {},
        }
    }
    bool is_library = Vec::len(&entries) > 0 && !HashMap::contains(&it.fns, &String::from_str("main"));
    // `rule.fn.program` `[Program-No-Main]`.
    bool has_main = false;
    match (HashMap::get(&it.fns, &String::from_str("main")))
    {
        Some(m) :
        {
            bool ret_ok = match (&m.ret)
            {
                Type::TVoid   : true,
                Type::TInt(i) : *i == IntTy::U8,
                _             : false,
            };
            if (Vec::len(&m.type_params) == 0 && Vec::len(&m.params) == 0 && ret_ok)
            {
                has_main = true;
            }
            else
            {
                return Err(sprintf("diag.no-main@%v", m.line));
            }
        },
        None    :
        {
            if (!is_library)
            {
                return Err(String::from_str("diag.no-main"));
            }
        },
    }
    // `diag.bad-destructor-signature` (spec/07 §1), in the table's order.
    for (usize i = 0; i < HashMap::len(&it.fns); i += 1)
    {
        ref<String, shared> key = HashMap::key_at(&it.fns, i);
        ref<FnDecl, shared> f = HashMap::value_at(&it.fns, i);
        if (String::eq_str(&f.name, "drop") && Option::is_some(&f.assoc_type))
        {
            StringView t = Option::unwrap_or(String::strip_suffix(key, "::drop"), String::as_view(key));
            bool ok = Vec::len(&f.params) == 1 && match (&f.params[0].ty)
            {
                Type::TRef(rb) : Box::get(rb).mode == Mode::Exclusive && match (&Box::get(rb).inner)
                {
                    Type::TNamed(nb) : String::eq_view(&Box::get(nb).name, t),
                    _                : false,
                },
                _ : false,
            } && match (&f.ret)
            {
                Type::TVoid : true,
                _           : false,
            };
            if (!ok)
            {
                return Err(String::from_str("diag.bad-destructor-signature"));
            }
            // D-0075: a destructor's type must be a resource in every
            // instantiation.
            String tk = String::from_view(t);
            Vec<String> params = match (HashMap::get(&it.structs, &tk))
            {
                Some(s) : Vec::clone(&s.type_params),
                None : match (HashMap::get(&it.enums, &tk))
                {
                    Some(e) : Vec::clone(&e.type_params),
                    None    : Vec::new(),
                },
            };
            Vec<Type> plain_args = Vec::new();
            for (usize p = 0; p < Vec::len(&params); p += 1)
            {
                Vec::push(&mut plain_args, Type::TInt(IntTy::I32));
            }
            if (!is_resource_ty(it, &named(t, plain_args)))
            {
                StringView shown = Option::unwrap_or(StringView::strip_prefix(t, "std::"), t);
                String msg = sprintf(
                    "`%s` has a destructor but is not a resource, so it would never run; declare `resource struct %s` (or `resource enum`)",
                    shown,
                    shown,
                );
                return Err(tagged_at(named_diag("diag.destructor-on-plain-type", &msg), f.line));
            }
        }
    }
    Vec<WorkItem> start = Vec::new();
    if (has_main)
    {
        Vec::push(&mut start, work(&String::from_str("main"), Vec::new()));
    }
    else
    {
        for (usize i = 0; i < Vec::len(&entries); i += 1)
        {
            Vec::push(&mut start, work(&entries[i].key, Vec::new()));
        }
    }
    Ck ck = new_ck(start);
    // Every item of the program is checked, called or not; `std`'s as the
    // worklist reaches them (unless `check_all`). The generic bodies,
    // with their type parameters opaque, are pushed last, so checked first.
    bool all = check_all();
    Vec<WorkItem> generic = Vec::new();
    for (usize i = 0; i < Vec::len(&keys); i += 1)
    {
        ref<String, shared> key = &keys[i];
        ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, key), "a function");
        if (!all && is_std_key(key))
        {
            continue;
        }
        if (Vec::len(&f.type_params) == 0)
        {
            Vec::push(&mut ck.worklist, work(key, Vec::new()));
        }
        else
        {
            Vec::push(&mut generic, work(key, opaque_args(f)));
        }
    }
    Vec::reverse(&mut generic);
    Vec::append(&mut ck.worklist, generic);
    ck_run(&mut ck, it, front, facts)?;
    // [Call-Multi-Ref-Return-Rejected] (spec/10 rule.temporal.elision): a
    // function returning a reference has exactly one reference parameter;
    // the first by line (then key) is reported.
    Option<KeyLine> bad = None;
    for (usize i = 0; i < Vec::len(&keys); i += 1)
    {
        ref<String, shared> key = &keys[i];
        ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, key), "a function");
        if (String::eq_str(key, "std::StringView::of") || !is_borrow_ty(&f.ret) || borrow_params(f) == 1)
        {
            continue;
        }
        bool better = match (&bad)
        {
            Some(b) : f.line < b.line,
            None    : true,
        };
        if (better)
        {
            bad = Some(KeyLine { .key = String::clone(key), .line = f.line });
        }
    }
    match (bad)
    {
        Some(kl) :
        {
            ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &kl.key), "a function");
            Vec<String> refs = Vec::new();
            for (usize p = 0; p < Vec::len(&f.params); p += 1)
            {
                if (is_borrow_ty(&f.params[p].ty))
                {
                    Vec::push(&mut refs, sprintf("`%s`", &f.params[p].name));
                }
            }
            StringView shown = Option::unwrap_or(String::strip_prefix(&kl.key, "std::"), String::as_view(&kl.key));
            String msg = if (Vec::len(&refs) == 0)
            {
                sprintf(
                    "`%s` returns a reference but takes none, so there is nothing it could refer to; return an owned value",
                    shown,
                )
            }
            else
            {
                sprintf(
                    "`%s` returns a reference but takes %v reference parameters (%s), so which one it borrows from is not known; take the others by value, split the function, or return an owned value",
                    shown,
                    Vec::len(&refs),
                    &String::join(&refs[0..$], ", "),
                )
            };
            return Err(tagged_at(named_diag("diag.lifetime-elision-ambiguous", &msg), f.line));
        },
        None     : {},
    }
    Ck { static_asserts, .. } = ck;
    Ok(static_asserts)
}

fn borrow_params(ref<FnDecl, shared> f) : usize
{
    usize n = 0;
    for (usize p = 0; p < Vec::len(&f.params); p += 1)
    {
        if (is_borrow_ty(&f.params[p].ty))
        {
            n += 1;
        }
    }
    n
}

fn ffi_part(ref<Type, shared> t, FfiProblem p) : String
{
    FfiProblem { path, what } = p;
    if (Vec::len(&path) == 0)
    {
        return what;
    }
    sprintf("`%s`, whose field `%s` is %s", &type_display(t), &String::join(&path[0..$], "."), &what)
}

fn sort_by_line(ref<Vec<KeyLine>, exclusive> v)
{
    // Insertion sort, stable: the lines first, the table's order between
    // equal lines (coby sorts by line alone, stably, from the table).
    for (usize i = 1; i < Vec::len(v); i += 1)
    {
        usize j = i;
        while (j > 0 && v[j - 1].line > v[j].line)
        {
            Vec::swap(v, j - 1, j);
            j -= 1;
        }
    }
}

fn last_segment(StringView key) : StringView
{
    match (rfind_sep(key))
    {
        Some(k) : StringView::sub(key, k + 2, StringView::len(key)),
        None    : key,
    }
}

/// A generic function's type parameters as the opaque markers its body is
/// checked with (`rule.type.kind`).
export fn opaque_args(ref<FnDecl, shared> f) : Vec<Type>
{
    Vec<Type> out = Vec::new();
    for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
    {
        Vec::push(&mut out, named(String::as_view(&marker_name(String::as_view(&f.type_params[i]))), Vec::new()));
    }
    out
}

// ---- the end of typecheck.rs, needed here ----

fn marker_name(StringView n) : String
{
    sprintf("$%s", n)
}

fn is_marker(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(b) : Vec::len(&Box::get(b).args) == 0 && String::starts_with(&Box::get(b).name, "$"),
        _               : false,
    }
}

fn has_unresolved_marker(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(b)  :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (Vec::len(&n.args) == 0 && String::starts_with(&n.name, "$"))
            {
                return true;
            }
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (has_unresolved_marker(&n.args[i]))
                {
                    return true;
                }
            }
            false
        },
        Type::TRef(b)    : has_unresolved_marker(&Box::get(b).inner),
        Type::TSlice(b)  : has_unresolved_marker(&Box::get(b).inner),
        Type::TRawptr(b) : has_unresolved_marker(Box::get(b)),
        Type::TArray(b)  : has_unresolved_marker(&Box::get(b).inner),
        Type::THandle(b) : has_unresolved_marker(Box::get(b)),
        Type::TMutex(b)  : has_unresolved_marker(Box::get(b)),
        Type::TGuard(b)  : has_unresolved_marker(Box::get(b)),
        Type::TFn(b)     :
        {
            ref<FnTy, shared> f = Box::get(b);
            for (usize i = 0; i < Vec::len(&f.params); i += 1)
            {
                if (has_unresolved_marker(&f.params[i]))
                {
                    return true;
                }
            }
            has_unresolved_marker(&f.ret)
        },
        _                : false,
    }
}

fn is_borrow_ty(ref<Type, shared> t) : bool
{
    // D-0053: a `StringView` is a borrow as a slice is (it holds one).
    match (t)
    {
        Type::TRef(_)   : true,
        Type::TSlice(_) : true,
        _               : named_is(t, "std::StringView"),
    }
}

fn static_lane(ref<Type, shared> t) : Option<Type>
{
    match (t)
    {
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (String::eq_str(&n.name, "std::Atomic") && Vec::len(&n.args) == 1)
            {
                return match (&n.args[0])
                {
                    Type::TInt(i) : if (*i != IntTy::I128 && *i != IntTy::U128) { Some(clone(&n.args[0])) } else { None },
                    _             : None,
                };
            }
            if (String::eq_str(&n.name, "std::AtomicBool") && Vec::len(&n.args) == 0)
            {
                return Some(Type::TBool);
            }
            None
        },
        _               : None,
    }
}

fn literal_value_go(ref<Expr, shared> e, bool neg) : Option<i128>
{
    match (&e.kind)
    {
        ExprKind::EInt(b)   :
        {
            u128 v = Box::get(b).v;
            u128 top = 1;
            top = top << 127;
            if (neg)
            {
                return if (v <= top) { Some(wrapping_sub(0, reinterpret<i128>(v))) } else { None };
            }
            if (v < top) { Some(reinterpret<i128>(v)) } else { None }
        },
        ExprKind::EParen(x) : literal_value_go(Box::get(x), neg),
        ExprKind::EUnary(b) :
        {
            if (Box::get(b).op == UnOp::Neg)
            {
                return literal_value_go(&Box::get(b).e, !neg);
            }
            None
        },
        _                   : None,
    }
}

fn literal_value(ref<Expr, shared> e) : Option<i128>
{
    literal_value_go(e, false)
}

export struct IntRange
{
    export i128 min;
    export i128 max;
}

// `value::int_min_max` (a `u128`'s maximum is `i128`'s, as coby keeps it).
export fn int_range(IntTy t) : IntRange
{
    u32 bw = int_ty_bits(t, 64);
    i128 one = 1;
    if (int_ty_signed(t))
    {
        if (bw >= 128)
        {
            return IntRange { .min = min_value<i128>(), .max = max_value<i128>() };
        }
        return IntRange { .min = 0 - (one << (bw - 1)), .max = (one << (bw - 1)) - 1 };
    }
    if (bw >= 127)
    {
        return IntRange { .min = 0, .max = max_value<i128>() };
    }
    IntRange { .min = 0, .max = (one << bw) - 1 }
}

// ---- part 2: typecheck.rs lines 1400-1622 ----

export fn apply_subst(ref<Type, shared> ty, ref<HashMap<String, Type>, shared> subst) : Type
{
    match (ty)
    {
        Type::TNamed(b)  :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (Vec::len(&n.args) == 0)
            {
                match (HashMap::get(subst, &n.name))
                {
                    Some(t) : return clone(t),
                    None    : {},
                }
            }
            Vec<Type> args = Vec::new();
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                Vec::push(&mut args, apply_subst(&n.args[i], subst));
            }
            named(String::as_view(&n.name), args)
        },
        Type::TRef(b)    : ref_of(apply_subst(&Box::get(b).inner, subst), Box::get(b).mode),
        Type::TSlice(b)  : slice_of(apply_subst(&Box::get(b).inner, subst), Box::get(b).mode),
        Type::TRawptr(b) : rawptr_of(apply_subst(Box::get(b), subst)),
        Type::TArray(b)  : array_of(apply_subst(&Box::get(b).inner, subst), Box::get(b).n),
        Type::TFn(b)     :
        {
            ref<FnTy, shared> f = Box::get(b);
            Vec<Type> ps = Vec::new();
            for (usize i = 0; i < Vec::len(&f.params); i += 1)
            {
                Vec::push(&mut ps, apply_subst(&f.params[i], subst));
            }
            fn_of(ps, apply_subst(&f.ret, subst))
        },
        Type::THandle(b) : Type::THandle(Box::new(apply_subst(Box::get(b), subst))),
        Type::TMutex(b)  : Type::TMutex(Box::new(apply_subst(Box::get(b), subst))),
        Type::TGuard(b)  : Type::TGuard(Box::new(apply_subst(Box::get(b), subst))),
        _                : clone(ty),
    }
}

fn is_std_string(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(b) : String::eq_str(&Box::get(b).name, "std::String") && Vec::len(&Box::get(b).args) == 0,
        _               : false,
    }
}

fn is_resource_ty(ref<Items, shared> it, ref<Type, shared> ty) : bool
{
    match (ty)
    {
        Type::THandle(_) : true,
        Type::TMutex(_)  : true,
        Type::TGuard(_)  : true,
        Type::TArray(b)  : is_resource_ty(it, &Box::get(b).inner),
        Type::TNamed(b)  :
        {
            ref<NamedTy, shared> n = Box::get(b);
            // The table (`items::ref_infos`), where it is exact.
            match (HashMap::get(&it.res_info, &n.name))
            {
                Some(r) :
                {
                    if (r.exact && Vec::len(&n.args) == r.arity)
                    {
                        if (r.own)
                        {
                            return true;
                        }
                        for (usize k = 0; k < Vec::len(&r.params); k += 1)
                        {
                            if (is_resource_ty(it, &n.args[r.params[k]]))
                            {
                                return true;
                            }
                        }
                        return false;
                    }
                },
                None    : return false,
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    if (s.resource_)
                    {
                        return true;
                    }
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        if (is_resource_ty(it, &apply_subst(&s.fields[i].ty, &subst)))
                        {
                            return true;
                        }
                    }
                    return false;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    if (e.resource_)
                    {
                        return true;
                    }
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) :
                            {
                                if (is_resource_ty(it, &apply_subst(p, &subst)))
                                {
                                    return true;
                                }
                            },
                            None    : {},
                        }
                    }
                    false
                },
                None    : false,
            }
        },
        _                : false,
    }
}

fn is_memory_type(ref<String, shared> name) : bool
{
    foreach (m in [
        "std::String",
        "std::Vec",
        "std::HashMap",
        "std::HashSet",
        "std::Queue",
        "std::Box",
        "std::Json",
        "std::JsonMember",
        "std::Option",
        "std::Result",
    ])
    {
        if (String::eq_str(name, m))
        {
            return true;
        }
    }
    false
}

fn quiet_go(ref<Items, shared> it, ref<Type, shared> ty, ref<Vec<String>, exclusive> seen) : bool
{
    match (ty)
    {
        Type::TInt(_)    : true,
        Type::TF32       : true,
        Type::TF64       : true,
        Type::TBool      : true,
        Type::TStr       : true,
        Type::TVoid      : true,
        Type::TRawptr(_) : true,
        Type::TArray(b)  : quiet_go(it, &Box::get(b).inner, seen),
        Type::TNamed(b)  :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (is_memory_type(&n.name))
            {
                for (usize i = 0; i < Vec::len(&n.args); i += 1)
                {
                    if (!quiet_go(it, &n.args[i], seen))
                    {
                        return false;
                    }
                }
                if (!(String::eq_str(
                    &n.name,
                    "std::Option",
                ) || String::eq_str(
                    &n.name,
                    "std::Result",
                ) || String::eq_str(&n.name, "std::Json") || String::eq_str(&n.name, "std::JsonMember")))
                {
                    return true;
                }
            }
            else if (type_is_owner(it, &n.name))
            {
                return false;
            }
            // A recursive type (`Json`) is quiet if the rest is.
            String key = type_display(ty);
            if (Vec::contains(seen, &key))
            {
                return true;
            }
            Vec::push(seen, key);
            bool ok = match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    bool all = true;
                    for (usize i = 0; i < Vec::len(&s.fields) && all; i += 1)
                    {
                        all = quiet_go(it, &apply_subst(&s.fields[i].ty, &subst), seen);
                    }
                    all
                },
                None : match (HashMap::get(&it.enums, &n.name))
                {
                    Some(e) :
                    {
                        HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                        bool all = true;
                        for (usize i = 0; i < Vec::len(&e.variants) && all; i += 1)
                        {
                            match (&e.variants[i].payload)
                            {
                                Some(p) : all = quiet_go(it, &apply_subst(p, &subst), seen),
                                None    : {},
                            }
                        }
                        all
                    },
                    None    : false,
                },
            };
            Vec::pop(seen);
            ok
        },
        _                : false,
    }
}

// D-0194: whether destroying any value of `ty` only frees memory.
export fn quiet_ty(ref<Items, shared> it, ref<Type, shared> ty) : bool
{
    Vec<String> seen = Vec::new();
    quiet_go(it, ty, &mut seen)
}

// D-0049: a struct or enum that owns something by itself, whatever its
// fields hold: declared `resource`, or with a destructor.
export fn type_is_owner(ref<Items, shared> it, ref<String, shared> name) : bool
{
    match (HashMap::get(&it.structs, name))
    {
        Some(s) :
        {
            if (s.resource_)
            {
                return true;
            }
        },
        None    : {},
    }
    match (HashMap::get(&it.enums, name))
    {
        Some(e) :
        {
            if (e.resource_)
            {
                return true;
            }
        },
        None    : {},
    }
    HashMap::contains(&it.fns, &sprintf("%s::drop", name))
}

// D-0049: whether every value of `ty` owns a resource.
export fn always_owns(ref<Items, shared> it, ref<Type, shared> ty) : bool
{
    match (ty)
    {
        Type::THandle(_) : true,
        Type::TGuard(_)  : true,
        Type::TMutex(_)  : true,
        Type::TArray(b)  : Box::get(b).n > 0 && always_owns(it, &Box::get(b).inner),
        Type::TNamed(b)  :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (!is_resource_ty(it, ty))
            {
                return false;
            }
            if (type_is_owner(it, &n.name))
            {
                return true;
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        if (always_owns(it, &apply_subst(&s.fields[i].ty, &subst)))
                        {
                            return true;
                        }
                    }
                    return false;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    if (Vec::len(&e.variants) == 0)
                    {
                        return false;
                    }
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        bool owns = match (&e.variants[i].payload)
                        {
                            Some(p) : always_owns(it, &apply_subst(p, &subst)),
                            None    : false,
                        };
                        if (!owns)
                        {
                            return false;
                        }
                    }
                    true
                },
                None    : false,
            }
        },
        _                : false,
    }
}

enum OperandKind
{
    Place,
    Temporary,
    NonPlace,
}

fn is_reclaim_call(ref<Expr, shared> callee) : bool
{
    match (&callee.kind)
    {
        ExprKind::EPath(p) : Vec::len(&Box::get(p).segs) == 1 && String::eq_str(&Box::get(p).segs[0], "reclaim"),
        _                  : false,
    }
}

const str TEXT_ORDER_HELP = "`<`, `<=`, `>`, `>=` order two `StringView`s (or two `str`s, two `String`s), not a view and a `str`; make both views";

const str MOVE_OUT_HELP = "a resource cannot be moved out of part of a struct: move the whole struct, take it apart (`Name { f1, f2 } = x;`), or exchange the part with `replace(&mut x.f, v)`";

// A binding's name as the program wrote it (a local constant's or a
// shadowing binding's hidden name ends in `$…`).
fn shown_name(StringView x) : StringView
{
    match (StringView::find(x, "$"))
    {
        Some(k) : if (k > 0) { StringView::sub(x, 0, k) } else { x },
        None    : x,
    }
}

// The holder of a borrow, as a message names it: `foreach`'s hidden
// bindings are the loop.
fn is_loop_holder(StringView h) : bool
{
    StringView::starts_with(h, "$c") || StringView::starts_with(h, "$d") || StringView::starts_with(h, "$e")
}

fn holder_text(StringView h) : String
{
    if (is_loop_holder(h))
    {
        return String::from_str("the `foreach` loop");
    }
    sprintf("`%s`", shown_name(h))
}

// A value that is a fresh temporary: a call's result or an aggregate
// literal (D-0073), an operator's result or a literal (D-0084), `f()?`.
export fn is_temp_value(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EParen(x)       : is_temp_value(Box::get(x)),
        ExprKind::ECall(c)        : !is_reclaim_call(&Box::get(c).callee),
        ExprKind::EStructLit(_)   : true,
        ExprKind::EArrayLit(_)    : true,
        ExprKind::EArrayRepeat(_) : true,
        ExprKind::EBinary(_)      : true,
        ExprKind::EUnary(_)       : true,
        ExprKind::EInt(_)         : true,
        ExprKind::EFloat(_)       : true,
        ExprKind::EBool(_)        : true,
        ExprKind::EPropagate(_)   : true,
        _                         : false,
    }
}

fn root_local_name(ref<Expr, shared> e) : Option<String>
{
    match (&e.kind)
    {
        ExprKind::EPath(p)  :
        {
            ref<PathExpr, shared> x = Box::get(p);
            if (Vec::len(&x.segs) == 1)
            {
                return Some(String::clone(&x.segs[0]));
            }
            None
        },
        ExprKind::EParen(x) : root_local_name(Box::get(x)),
        _                   : None,
    }
}

// ---- part 1b: typecheck.rs lines 725-1400 ----

// The checker's state for one function body (`typecheck.rs`'s `Body`).
// What coby keys by an expression's address is keyed by its id.
struct Body
{
    // D-0073: an argument of a call whose result is not a reference, so
    // `&` of a temporary may be taken there.
    bool arg_temp_ok;
    bool cur_temp_ok;
    // D-0291: the argument being checked goes to a reference or slice
    // parameter, whose reach the call-site rule follows (`arg_ref_param`;
    // `cur_arg_ref_param` for that one expression, as `cur_temp_ok`).
    bool arg_ref_param;
    bool cur_arg_ref_param;
    // The module lexically containing the function being checked.
    String module_;
    HashMap<String, Type> gamma;
    // What each write to `gamma` replaced, in order, so a block's bindings
    // are undone when it ends (`gamma_undo`) instead of `gamma` being
    // copied before it.
    Vec<GammaUndo> gamma_log;
    Flow flow;
    // One entry per open block: the names it declared, each with the facts
    // of the same-named binding it shadowed.
    Vec<Vec<ScopeEntry>> scopes;
    usize next_block;
    Vec<usize> block_stack;
    HashMap<usize, usize> block_parent;
    HashMap<String, usize> decl_block;
    HashMap<String, Option<Referent>> ref_origin;
    HashSet<String> params;
    HashMap<usize, Option<Referent>> borrow_referents;
    bool infer_poisoned;
    bool privileged;
    HashMap<String, bool> closure_moves;
    // D-0289: the `spawn` calls (their callee's site, `site_key`) whose
    // handle a binding of the frame takes; whether a `join`/`drop` call is
    // checked.
    HashSet<String> bound_spawns;
    // D-0291: spawns a `let`'s value is or wraps (`Some(spawn(…))`, a
    // `match`'s arms): the facts each was lent, found where the spawn is
    // checked; `None` when one names a binding of a scope the `let` does
    // not see. `spawn_let_depth`: the scope depth at each open `let`.
    HashMap<String, Option<Vec<DerivFact>>> tail_spawns;
    Vec<usize> spawn_let_depth;
    bool joining;
    // D-0289: a handle moved where its facts follow it (a `let` of a
    // handle taken out of a `Vec` of them, a `foreach`'s drain), and the
    // calls whose handle result is so bound (`Vec::pop(&mut hs)`).
    bool handing;
    HashSet<String> taken_handles;
    bool handle_borrow_ok;
    // `r = pass(r)`: what `r` held before this assignment cleared it.
    Option<PrevFacts> prev_facts;
    // D-0290: the locals of this frame that hold references in data (a
    // struct with a reference field, a `Vec<StringView>`): each holds the
    // union of what was stored into it, and what is read out of it holds
    // that. `holding`: a holder moved where its facts follow it.
    HashSet<String> holders;
    bool holding;
    // `holder_type` and `data_type` of each type asked about, by
    // `type_code`.
    // D-0282: the per-body state of the frame-reference rules and their
    // report (coby's `tier_report::CUR`).
    Rep rep;
    // The point checks this body records and whether it has one, moved
    // into `Items` when the body is done (`tier_flush`).
    Vec<PointAt> point_checks_made;
    bool point_check_fn;
    HashSet<String> closure_self_writes;
    HashSet<String> closure_copied;
    // D-0282: reference bindings that are copies of another (`auto r2 =
    // r1;`): a copy of a reference carries the same path, so the two never
    // conflict with each other.
    HashMap<String, String> ref_copies;
    // D-0281 step 4c: the hidden reference of `[Compound-Assign]` (`{ auto
    // t = &mut p; *t = *t op e; }`) while `e` is checked: it is live
    // through `e`, though its uses have the position of `p`.
    Vec<String> compound_held;
    HashSet<String> closure_owning;
    HashMap<String, usize> closure_arity;
    HashMap<String, Option<Type>> move_captures;
    HashSet<String> capture_names;
    Vec<LoopCtx> loops;
    bool report;
    bool place_pos;
    bool read_exempt;
    Option<String> reinit_target;
    Type ret;
    Option<Option<Type>> closure_ret;
    HashMap<String, Bound> marker_bounds;
    HashMap<String, Type> subst;
    Vec<WorkItem> new_instantiations;
    Vec<StaticAssert> static_asserts;
    u32 unsafe_depth;
    u32 while_depth;
    usize current_line;
    usize current_col;
    // The facts, lent to the body while it is checked (`Ck::run`).
    Facts facts;
    // The ids given to expressions the checker builds itself (a
    // `foreach` expansion, a `$fmt` call), apart from the program's.
    usize fresh_id;
}

// What `r` held before an assignment cleared it (`Body.prev_facts`).
struct PrevFacts
{
    String name;
    HashMap<String, DerivFact> facts;
}

fn number_fresh(ref<Body, exclusive> b, ref<Expr, exclusive> e)
{
    number_expr(e, &mut b.fresh_id);
}

// A referent: the block it lives in and its root binding.
struct Referent
{
    usize block;
    String root;
}

fn ck_run(
    ref<Ck, exclusive> ck,
    ref<Items, exclusive> it,
    ref<Front, shared> front,
    ref<Facts, exclusive> facts,
) : Result<void, String>
{
    // D-0282: the access summaries, once per program (coby's `OnceLock`,
    // filled at the first call rule; every function is declared by now).
    if (Option::is_none(&it.tier_summaries))
    {
        Summaries sums = tier::compute(&*it);
        it.tier_summaries = Some(sums);
    }
    // Every function is checked, and of the errors found the one earliest
    // in the source is reported (one without a location, last).
    Vec<String> errors = Vec::new();
    while (true)
    {
        WorkItem w = match (Vec::pop(&mut ck.worklist))
        {
            Some(w) : w,
            None    : break,
        };
        String key = work_code(&w.name, &w.targs);
        if (HashSet::contains(&ck.checked, &key))
        {
            continue;
        }
        if (is_pending(it, &w.name))
        {
            load_body(it, front, &w.name)?;
        }
        ref<Items, shared> its = &*it;
        ref<FnDecl, shared> f = match (HashMap::get(&its.fns, &w.name))
        {
            Some(f) : f,
            None    : continue,
        };
        if (Vec::len(&f.type_params) != Vec::len(&w.targs))
        {
            continue;
        }
        // A generic's body is checked with its type parameters opaque
        // before any instantiation of it.
        if (Vec::len(&w.targs) > 0)
        {
            Vec<Type> opaque = opaque_args(f);
            if (!types_eq_list(&opaque, &w.targs) && !HashSet::contains(&ck.checked, &work_code(&w.name, &opaque)))
            {
                Vec::push(&mut ck.worklist, work(&w.name, clone(&w.targs)));
                Vec::push(&mut ck.worklist, work(&w.name, opaque));
                continue;
            }
        }
        // `[Generic-Instantiation-Unbounded]` (spec/15 §5): a type argument
        // nested too deep, or too many instantiations, is a family that does
        // not end; it is rejected, never left partly unchecked.
        bool concrete = Vec::len(&w.targs) > 0;
        for (usize i = 0; i < Vec::len(&w.targs); i += 1)
        {
            if (has_unresolved_marker(&w.targs[i]))
            {
                concrete = false;
            }
        }
        if (concrete)
        {
            ck.instances += 1;
            Option<usize> deep = None;
            for (usize i = 0; i < Vec::len(&w.targs) && Option::is_none(&deep); i += 1)
            {
                if (type_depth(&w.targs[i]) > INSTANCE_DEPTH)
                {
                    deep = Some(i);
                }
            }
            if (Option::is_some(&deep) || ck.instances > MAX_INSTANCES)
            {
                StringView shown = Option::unwrap_or(String::strip_prefix(&w.name, "std::"), String::as_view(&w.name));
                String why = match (deep)
                {
                    Some(i) :
                    {
                        String t = type_display(&w.targs[i]);
                        Vec<StringView> cs = String::chars(&t);
                        String cut = String::new();
                        for (usize k = 0; k < Vec::len(&cs) && k < 60; k += 1)
                        {
                            String::append(&mut cut, cs[k]);
                        }
                        sprintf(
                            "`%s` is instantiated at a type argument nested more than %v deep (`%s…`): it calls itself, or a function that calls it, at a larger type each time, so its instantiations never end; pass the larger value as a type the function already has (a `Vec`, a `Box` of one fixed type) or split the function",
                            shown,
                            INSTANCE_DEPTH,
                            &cut,
                        )
                    },
                    None : sprintf(
                        "the program needs more than %v instantiations of its generic functions (`%s` among them), so they do not end",
                        MAX_INSTANCES,
                        shown,
                    ),
                };
                return Err(tagged_at(named_diag("diag.instantiation-unbounded", &why), f.line));
            }
        }
        HashSet::insert(&mut ck.checked, String::clone(&key));
        HashMap::insert(&mut facts.checked_fns, key, true);
        HashMap<String, Type> subst = zip_subst(&f.type_params, &w.targs);
        HashMap<String, Type> gamma = HashMap::new();
        for (usize i = 0; i < Vec::len(&f.params); i += 1)
        {
            HashMap::insert(&mut gamma, String::clone(&f.params[i].name), apply_subst(&f.params[i].ty, &subst));
        }
        Type ret = apply_subst(&f.ret, &subst);
        HashSet<String> params = HashSet::new();
        for (usize i = 0; i < Vec::len(&f.params); i += 1)
        {
            HashSet::insert(&mut params, String::clone(&f.params[i].name));
        }
        HashMap<String, Bound> marker_bounds = HashMap::new();
        for (usize i = 0; i < Vec::len(&f.type_params) && i < Vec::len(&f.type_bounds) && i < Vec::len(&w.targs); i += 1)
        {
            match (f.type_bounds[i])
            {
                Some(bd) : match (&w.targs[i])
                {
                    Type::TNamed(nb) :
                    {
                        ref<NamedTy, shared> n = Box::get(nb);
                        if (Vec::len(&n.args) == 0 && String::eq(
                            &n.name,
                            &marker_name(String::as_view(&f.type_params[i])),
                        ))
                        {
                            HashMap::insert(&mut marker_bounds, String::clone(&n.name), bd);
                        }
                    },
                    _                : {},
                },
                None : {},
            }
        }
        Vec<usize> block_stack = Vec::new();
        Vec::push(&mut block_stack, 0);
        Vec<Vec<ScopeEntry>> scopes = Vec::new();
        Vec::push(&mut scopes, Vec::new());
        Body body = Body {
            .arg_temp_ok = false,
            .cur_temp_ok = false,
            .arg_ref_param = false,
            .cur_arg_ref_param = false,
            .module_ = declaring_module(String::as_view(&w.name), Option::is_some(&f.assoc_type)),
            .gamma = gamma,
            .gamma_log = Vec::new(),
            .flow = new_flow(),
            .scopes = scopes,
            .next_block = 1,
            .block_stack = block_stack,
            .block_parent = HashMap::new(),
            .decl_block = HashMap::new(),
            .ref_origin = HashMap::new(),
            .params = params,
            .borrow_referents = HashMap::new(),
            .infer_poisoned = false,
            .privileged = false,
            .closure_moves = HashMap::new(),
            .bound_spawns = HashSet::new(),
            .tail_spawns = HashMap::new(),
            .spawn_let_depth = Vec::new(),
            .joining = false,
            .handing = false,
            .taken_handles = HashSet::new(),
            .handle_borrow_ok = false,
            .prev_facts = None,
            .holders = HashSet::new(),
            .holding = false,
            .rep = rep_new(String::new()),
            .point_checks_made = Vec::new(),
            .point_check_fn = false,
            .closure_self_writes = HashSet::new(),
            .closure_copied = HashSet::new(),
            .ref_copies = HashMap::new(),
            .compound_held = Vec::new(),
            .closure_owning = HashSet::new(),
            .closure_arity = HashMap::new(),
            .move_captures = HashMap::new(),
            .capture_names = HashSet::new(),
            .loops = Vec::new(),
            .report = true,
            .place_pos = false,
            .read_exempt = false,
            .reinit_target = None,
            .ret = clone(&ret),
            .closure_ret = None,
            .marker_bounds = marker_bounds,
            .subst = subst,
            .new_instantiations = Vec::new(),
            .static_asserts = Vec::new(),
            .unsafe_depth = 0,
            .while_depth = 0,
            .current_line = 0,
            .current_col = 0,
            .facts = replace(facts, new_facts()),
            .fresh_id = fresh_base(),
        };
        // D-0116: a derived `T::clone` whose `T` is not `clone` is never
        // reached, so its body is not checked.
        if (f.derived && Option::is_some(&clone_problem(&mut body, its, &ret)))
        {
            *facts = replace(&mut body.facts, new_facts());
            continue;
        }
        // Entry state (spec/14 §6): parameters `valid = T`, `init = T`.
        for (usize i = 0; i < Vec::len(&f.params); i += 1)
        {
            declare(&mut body, &f.params[i].name, true);
        }
        String body_key_ = body_key(String::as_view(&w.name), &w.targs);
        body.rep = rep_begin(String::clone(&body_key_), &f.body);
        Result<Option<Type>, String> res = check_fn_body(&mut body, its, &f.body, &ret);
        match (&res)
        {
            Err(d) : body.rep.error = Some(String::clone(d)),
            Ok(_)  : {},
        }
        tier_flush(&mut body, it, &body_key_);
        *facts = replace(&mut body.facts, new_facts());
        Option<Type> bt = match (res)
        {
            Ok(t)  : t,
            Err(d) :
            {
                Vec::push(&mut errors, d);
                continue;
            },
        };
        match (&bt)
        {
            Some(t) :
            {
                if (!ty_compat(t, &ret))
                {
                    ShownPair sp = shown_apart(&ret, t);
                    String msg = sprintf("`%s` returns `%s`, but its body gives `%s`", &w.name, &sp.a, &sp.b);
                    Vec::push(
                        &mut errors,
                        sprintf("%s%s", &mismatch(msg), &diag_at(body.current_line, body.current_col)),
                    );
                    continue;
                }
            },
            None    : {},
        }
        Body { new_instantiations, static_asserts, .. } = body;
        Vec::append(&mut ck.worklist, new_instantiations);
        Vec::reverse(&mut static_asserts);
        while (true)
        {
            StaticAssert a = match (Vec::pop(&mut static_asserts))
            {
                Some(a) : a,
                None    : break,
            };
            if (HashSet::insert(&mut ck.static_assert_keys, String::clone(&a.key_code)))
            {
                Vec::push(&mut ck.static_asserts, a);
            }
        }
    }
    // The error earliest in the source: least (line, column, index).
    Option<usize> best = None;
    usize best_line = 0;
    usize best_col = 0;
    for (usize i = 0; i < Vec::len(&errors); i += 1)
    {
        DiagAt at = split_location_col(&errors[i]);
        usize l = Option::unwrap_or(at.line, max_value<usize>());
        bool better = match (best)
        {
            Some(_) : l < best_line || (l == best_line && at.col < best_col),
            None    : true,
        };
        if (better)
        {
            best = Some(i);
            best_line = l;
            best_col = at.col;
        }
    }
    match (best)
    {
        Some(i) : Err(String::clone(&errors[i])),
        None    : Ok(()),
    }
}

// The first id of the expressions the checker builds: far above any the
// program's numbering gives.
fn fresh_base() : usize
{
    usize one = 1;
    one << 48
}

fn types_eq_list(ref<Vec<Type>, shared> a, ref<Vec<Type>, shared> b) : bool
{
    if (Vec::len(a) != Vec::len(b))
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(a); i += 1)
    {
        if (!type_eq(&a[i], &b[i]))
        {
            return false;
        }
    }
    true
}

// `diagnostics::at`: `@42`, or `@42:7` when the column is known.
fn diag_at(usize line, usize col) : String
{
    if (col == 0)
    {
        return sprintf("@%v", line);
    }
    sprintf("@%v:%v", line, col)
}

struct DiagAt
{
    Option<usize> line;
    usize col;
}

// `diagnostics::split_location_col`: the line and column after the last
// `@` (`@42` or `@42:7`), when they are numbers.
fn split_location_col(ref<String, shared> raw) : DiagAt
{
    StringView s = String::as_view(raw);
    slice<u8, shared> bytes = StringView::as_bytes(s);
    usize k = StringView::len(s);
    while (k > 0)
    {
        k -= 1;
        if (bytes[k] == b'@')
        {
            StringView n = StringView::sub(s, k + 1, StringView::len(s));
            match (StringView::find(n, ":"))
            {
                Some(m) :
                {
                    match (StringView::parse<usize>(StringView::sub(n, 0, m)))
                    {
                        Ok(l) : match (StringView::parse<usize>(StringView::sub(n, m + 1, StringView::len(n))))
                        {
                            Ok(c)  : return DiagAt { .line = Some(l), .col = c },
                            Err(_) : return DiagAt { .line = None, .col = 0 },
                        },
                        Err(_) : return DiagAt { .line = None, .col = 0 },
                    }
                },
                None : match (StringView::parse<usize>(n))
                {
                    Ok(l)  : return DiagAt { .line = Some(l), .col = 0 },
                    Err(_) : return DiagAt { .line = None, .col = 0 },
                },
            }
        }
    }
    DiagAt { .line = None, .col = 0 }
}

fn is_numeric_ty(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TInt(_) : true,
        Type::TF32    : true,
        Type::TF64    : true,
        _             : false,
    }
}

// The variant of a type, as `std::mem::discriminant` compares them.
fn type_tag(ref<Type, shared> t) : u8
{
    match (t)
    {
        Type::TInt(_)     : 0,
        Type::TF32        : 1,
        Type::TF64        : 2,
        Type::TBool       : 3,
        Type::TStr        : 4,
        Type::TVoid       : 5,
        Type::TNever      : 6,
        Type::TRef(_)     : 7,
        Type::TSlice(_)   : 8,
        Type::TRawptr(_)  : 9,
        Type::TArray(_)   : 10,
        Type::TSimd(_)    : 11,
        Type::TFn(_)      : 12,
        Type::THandle(_)  : 13,
        Type::TMutex(_)   : 14,
        Type::TGuard(_)   : 15,
        Type::TNamed(_)   : 16,
        Type::TClosure(_) : 17,
    }
}

// The one type inside a wrapper type (`ref`, `slice`, `array`, `rawptr`,
// `handle`, `mutex`, `guard`).
fn inner_of(ref<Type, shared> t) : Option<Type>
{
    match (t)
    {
        Type::TRef(b)    : Some(clone(&Box::get(b).inner)),
        Type::TSlice(b)  : Some(clone(&Box::get(b).inner)),
        Type::TArray(b)  : Some(clone(&Box::get(b).inner)),
        Type::TRawptr(b) : Some(clone(Box::get(b))),
        Type::THandle(b) : Some(clone(Box::get(b))),
        Type::TMutex(b)  : Some(clone(Box::get(b))),
        Type::TGuard(b)  : Some(clone(Box::get(b))),
        _                : None,
    }
}

// Whether `actual` cannot be `decl` whatever the type parameters in
// `params` become: different constructors, or different named types.
fn shape_conflict(ref<Type, shared> decl, ref<Type, shared> actual, ref<HashSet<String>, shared> params) : bool
{
    match (decl)
    {
        Type::TNamed(b) :
        {
            if (Vec::len(&Box::get(b).args) == 0 && HashSet::contains(params, &Box::get(b).name))
            {
                return false;
            }
        },
        _               : {},
    }
    if (has_unresolved_marker(actual))
    {
        return false;
    }
    if (is_numeric_ty(decl) && is_numeric_ty(actual))
    {
        return false;
    }
    match (decl)
    {
        Type::TNamed(b1) : match (actual)
        {
            Type::TNamed(b2) :
            {
                ref<NamedTy, shared> n1 = Box::get(b1);
                ref<NamedTy, shared> n2 = Box::get(b2);
                if (!String::eq(&n1.name, &n2.name) || Vec::len(&n1.args) != Vec::len(&n2.args))
                {
                    return true;
                }
                for (usize i = 0; i < Vec::len(&n1.args); i += 1)
                {
                    if (shape_conflict(&n1.args[i], &n2.args[i], params))
                    {
                        return true;
                    }
                }
                return false;
            },
            _                : {},
        },
        Type::TFn(f1) : match (actual)
        {
            Type::TFn(f2) :
            {
                ref<FnTy, shared> a = Box::get(f1);
                ref<FnTy, shared> c = Box::get(f2);
                if (Vec::len(&a.params) != Vec::len(&c.params))
                {
                    return true;
                }
                for (usize i = 0; i < Vec::len(&a.params); i += 1)
                {
                    if (shape_conflict(&a.params[i], &c.params[i], params))
                    {
                        return true;
                    }
                }
                return shape_conflict(&a.ret, &c.ret, params);
            },
            _             : {},
        },
        _ : {},
    }
    // Two of one wrapper: their insides.
    u8 td = type_tag(decl);
    u8 ta = type_tag(actual);
    if (td == ta && td != 11)
    {
        match (inner_of(decl))
        {
            Some(di) : return shape_conflict(&di, &Option::expect(inner_of(actual), "the same wrapper"), params),
            None     : {},
        }
    }
    td != ta
}

// Binds the type parameters named in `params` that `decl_ty` mentions to
// what `actual` has in their places.
fn unify_type_shape(
    ref<Type, shared> decl_ty,
    ref<Type, shared> actual,
    ref<HashMap<String, Type>, exclusive> m,
    ref<Vec<String>, shared> params,
)
{
    match (decl_ty)
    {
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (Vec::len(&n.args) == 0 && Vec::contains(params, &n.name))
            {
                if (!HashMap::contains(m, &n.name))
                {
                    HashMap::insert(m, String::clone(&n.name), clone(actual));
                }
                return;
            }
        },
        _               : {},
    }
    match (decl_ty)
    {
        Type::TRef(d) : match (actual)
        {
            Type::TRef(a) : unify_type_shape(&Box::get(d).inner, &Box::get(a).inner, m, params),
            _             : {},
        },
        Type::TSlice(d) : match (actual)
        {
            Type::TSlice(a) : unify_type_shape(&Box::get(d).inner, &Box::get(a).inner, m, params),
            _               : {},
        },
        Type::TRawptr(d) : match (actual)
        {
            Type::TRawptr(a) : unify_type_shape(Box::get(d), Box::get(a), m, params),
            _                : {},
        },
        Type::TArray(d) : match (actual)
        {
            Type::TArray(a) : unify_type_shape(&Box::get(d).inner, &Box::get(a).inner, m, params),
            _               : {},
        },
        Type::THandle(d) : match (actual)
        {
            Type::THandle(a) : unify_type_shape(Box::get(d), Box::get(a), m, params),
            _                : {},
        },
        Type::TMutex(d) : match (actual)
        {
            Type::TMutex(a) : unify_type_shape(Box::get(d), Box::get(a), m, params),
            _               : {},
        },
        Type::TGuard(d) : match (actual)
        {
            Type::TGuard(a) : unify_type_shape(Box::get(d), Box::get(a), m, params),
            _               : {},
        },
        Type::TFn(d) : match (actual)
        {
            Type::TFn(a) :
            {
                ref<FnTy, shared> df = Box::get(d);
                ref<FnTy, shared> af = Box::get(a);
                if (Vec::len(&df.params) == Vec::len(&af.params))
                {
                    for (usize i = 0; i < Vec::len(&df.params); i += 1)
                    {
                        unify_type_shape(&df.params[i], &af.params[i], m, params);
                    }
                    unify_type_shape(&df.ret, &af.ret, m, params);
                }
            },
            _            : {},
        },
        Type::TNamed(d) : match (actual)
        {
            Type::TNamed(a) :
            {
                ref<NamedTy, shared> dn = Box::get(d);
                ref<NamedTy, shared> an = Box::get(a);
                for (usize i = 0; i < Vec::len(&dn.args) && i < Vec::len(&an.args); i += 1)
                {
                    unify_type_shape(&dn.args[i], &an.args[i], m, params);
                }
            },
            _               : {},
        },
        _ : {},
    }
}

// Structural type equality for a mismatch diagnostic, `never` accepted at
// any expected type (`[T-Never]`).
fn ty_compat(ref<Type, shared> a, ref<Type, shared> b) : bool
{
    type_eq(a, b) || is_never(a) || is_never(b)
}

// ---- rule.control.flow-analysis (spec/14 §6) ----

enum Tri
{
    T,
    F,
    U,
}

fn tri_join(Tri a, Tri b) : Tri
{
    if (a == b) { a } else { Tri::U }
}

// D-0282 (`rule.control.frame-references`): the state the rules for
// frame-held references keep per function body (its uses, for liveness by
// last use), and the report D-0281's measurements read (typecheck.rs `mod
// tier_report`): with COBALTC_TIER_REPORT=FILE the static pass appends to
// FILE, for each body, the conflict checks it made, those it could decide
// neither way, the point checks left to the run, and the reference
// bindings it gave no origin. The report changes nothing. coby keeps it in
// a thread-local (`CUR`); here the body being checked owns it (`Body.rep`).

// A position in the source, as `(line, col)` orders.
struct Pos
{
    usize line;
    usize col;
}

fn pos_le(ref<Pos, shared> a, ref<Pos, shared> b) : bool
{
    a.line < b.line || (a.line == b.line && a.col <= b.col)
}

fn pos_max(ref<Pos, shared> a, ref<Pos, shared> b) : Pos
{
    if (pos_le(a, b)) { clone(b) } else { clone(a) }
}

// A binding as liveness sees it: its name, where it is declared and where
// its scope ends (D-0111's last use, by lexical scope).
struct Decl
{
    String name;
    Pos pos;
    Pos end;
}

// A use of a name, by position, and the declaration it resolves to
// (`REP_PARAM` for a parameter or anything declared outside the body).
struct Use
{
    String name;
    usize line;
    usize col;
    usize decl;
}

// The extent of a loop: its first and last line.
struct LoopExtent
{
    usize a;
    usize b;
}

const usize REP_PARAM = 18446744073709551615;

struct Rep
{
    Vec<Use> uses;
    Vec<Decl> decls;
    Vec<LoopExtent> loops;
    String func;
    usize checks;
    usize undecided;
    usize unknown_origin;
    usize inherited;
    usize tier_d;
    usize point_checks;
    // D-0281 step 4c: the first conflict left to the run's tracking.
    Option<String> left;
    Option<String> error;
    Vec<String> events;
    // `uses` and `decls` by name (indices, in order): what `live_after`
    // looks through.
    HashMap<String, Vec<usize>> uses_by;
    HashMap<String, Vec<usize>> decls_by;
}

fn rep_new(String func) : Rep
{
    Rep {
        .uses = Vec::new(),
        .decls = Vec::new(),
        .loops = Vec::new(),
        .func = func,
        .checks = 0,
        .undecided = 0,
        .unknown_origin = 0,
        .inherited = 0,
        .tier_d = 0,
        .point_checks = 0,
        .left = None,
        .error = None,
        .events = Vec::new(),
        .uses_by = HashMap::new(),
        .decls_by = HashMap::new(),
    }
}

fn rep_kind_of(ref<Expr, shared> e) : String
{
    match (&e.kind)
    {
        ExprKind::EParen(i)   : rep_kind_of(Box::get(i)),
        ExprKind::ECall(cb) : match (&Box::get(cb).callee.kind)
        {
            ExprKind::EPath(p) : sprintf("call %s", &String::join(&Box::get(p).segs[0..$], "::")),
            _                  : String::from_str("call (value)"),
        },
        ExprKind::EPath(p)    : sprintf("name %s", &String::join(&Box::get(p).segs[0..$], "::")),
        ExprKind::EField(f)   : sprintf("field .%s", &Box::get(f).name),
        ExprKind::EIndex(_)   : String::from_str("index"),
        ExprKind::EDeref(_)   : String::from_str("deref"),
        ExprKind::EBorrow(_)  : String::from_str("borrow"),
        ExprKind::ESliceOf(_) : String::from_str("slice-of"),
        ExprKind::EIf(_)      : String::from_str("if"),
        ExprKind::EMatch(_)   : String::from_str("match"),
        ExprKind::EBlock(_)   : String::from_str("block"),
        ExprKind::EStr(_)     : String::from_str("literal"),
        _                     : String::from_str("other"),
    }
}

// `tier_report::begin`: the body's uses, declarations and loops.
fn rep_begin(String func, ref<Block, shared> body) : Rep
{
    Walker w = Walker { .rep = rep_new(func), .visible = HashMap::new() };
    wk_block(&mut w, body);
    Walker { rep, .. } = w;
    rep
}

// Whether the binding `name` visible at (line, col) is used after that
// point, or anywhere in a loop that contains the point and that its
// declaration precedes (a binding declared in a loop's body is a new
// binding each time round).
fn rep_live_after(ref<Rep, shared> r, StringView name, usize line, usize col) : bool
{
    Pos at = Pos { .line = line, .col = col };
    String key = String::from_view(name);
    Vec<usize> none = Vec::new();
    ref<Vec<usize>, shared> dix = match (HashMap::get(&r.decls_by, &key))
    {
        Some(v) : v,
        None    : &none,
    };
    ref<Vec<usize>, shared> uix = match (HashMap::get(&r.uses_by, &key))
    {
        Some(v) : v,
        None    : return false,
    };
    usize decl = REP_PARAM;
    for (usize di = 0; di < Vec::len(dix); di += 1)
    {
        usize i = dix[di];
        ref<Decl, shared> d = &r.decls[i];
        if (pos_le(&d.pos, &at) && pos_le(&at, &d.end))
        {
            // `max_by_key`: the last of the greatest.
            if (decl == REP_PARAM || pos_le(&r.decls[decl].pos, &d.pos))
            {
                decl = i;
            }
        }
    }
    usize decl_line = if (decl == REP_PARAM) { 0 } else { r.decls[decl].pos.line };
    Vec<LoopExtent> in_loops = Vec::new();
    for (usize i = 0; i < Vec::len(&r.loops); i += 1)
    {
        ref<LoopExtent, shared> l = &r.loops[i];
        if (l.a <= line && line <= l.b && decl_line < l.a)
        {
            Vec::push(&mut in_loops, clone(l));
        }
    }
    for (usize ui = 0; ui < Vec::len(uix); ui += 1)
    {
        ref<Use, shared> u = &r.uses[uix[ui]];
        if (u.decl != decl)
        {
            continue;
        }
        if (u.line > line || (u.line == line && u.col > col))
        {
            return true;
        }
        for (usize k = 0; k < Vec::len(&in_loops); k += 1)
        {
            if (in_loops[k].a <= u.line && u.line <= in_loops[k].b)
            {
                return true;
            }
        }
    }
    false
}

// The last position inside an expression or a block: a scope's end.
// (coby walks `e` with a `Walker` and takes the greatest of its uses,
// declarations and loop ends; `rep_pos_in` finds the same without
// recording them.)
fn rep_end_e(ref<Expr, shared> e, ref<Pos, exclusive> m)
{
    pos_up(m, e.line, e.col);
    rep_pos_in(e, m);
}

fn pos_up(ref<Pos, exclusive> m, usize line, usize col)
{
    if (line > m.line || (line == m.line && col > m.col))
    {
        m.line = line;
        m.col = col;
    }
}

// The greatest position the `Walker` would record inside `e`: a use, a
// declaration, a loop's end (its last line, any column).
fn rep_pos_in(ref<Expr, shared> e, ref<Pos, exclusive> m)
{
    match (&e.kind)
    {
        ExprKind::EPath(p)        :
        {
            if (Vec::len(&Box::get(p).segs) == 1)
            {
                pos_up(m, e.line, e.col);
            }
        },
        ExprKind::EParen(x)       : rep_pos_in(Box::get(x), m),
        ExprKind::EUnary(u)       : rep_pos_in(&Box::get(u).e, m),
        ExprKind::EPropagate(x)   : rep_pos_in(Box::get(x), m),
        ExprKind::EDeref(x)       : rep_pos_in(Box::get(x), m),
        ExprKind::EBorrow(bb)     : rep_pos_in(&Box::get(bb).e, m),
        ExprKind::EField(f)       : rep_pos_in(&Box::get(f).e, m),
        ExprKind::EArrayRepeat(r) : rep_pos_in(&Box::get(r).value, m),
        ExprKind::EBinary(bb)     :
        {
            rep_pos_in(&Box::get(bb).a, m);
            rep_pos_in(&Box::get(bb).b, m);
        },
        ExprKind::EIndex(pb)      :
        {
            rep_pos_in(&Box::get(pb).a, m);
            rep_pos_in(&Box::get(pb).b, m);
        },
        ExprKind::EAssign(pb)     :
        {
            rep_pos_in(&Box::get(pb).a, m);
            rep_pos_in(&Box::get(pb).b, m);
        },
        ExprKind::ESliceOf(sb)    :
        {
            rep_pos_in(&Box::get(sb).base, m);
            rep_pos_in(&Box::get(sb).lo, m);
            rep_pos_in(&Box::get(sb).hi, m);
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            rep_pos_in(&c.callee, m);
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                rep_pos_in(&c.args[i], m);
            }
        },
        ExprKind::EStructLit(sl)  :
        {
            ref<Vec<FieldInit>, shared> fs = &Box::get(sl).fields;
            for (usize i = 0; i < Vec::len(fs); i += 1)
            {
                rep_pos_in(&fs[i].value, m);
            }
        },
        ExprKind::EArrayLit(xs)   :
        {
            for (usize i = 0; i < Vec::len(xs); i += 1)
            {
                rep_pos_in(&xs[i], m);
            }
        },
        ExprKind::EBlock(blk)     : rep_pos_block(blk, m),
        ExprKind::EUnsafe(blk)    : rep_pos_block(blk, m),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            rep_pos_in(&x.cond, m);
            rep_pos_block(&x.then_, m);
            match (&x.else_)
            {
                Some(e2) : rep_pos_in(e2, m),
                None     : {},
            }
        },
        // Everything inside a loop is before its end.
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            Pos end = Pos { .line = e.line, .col = e.col };
            rep_end_e(&x.cond, &mut end);
            end = pos_max(&end, &rep_end_b(&x.body));
            match (&x.step)
            {
                Some(st) : rep_end_e(st, &mut end),
                None     : {},
            }
            pos_up(m, end.line, REP_PARAM);
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> mt = Box::get(mb);
            rep_pos_in(&mt.scrut, m);
            for (usize i = 0; i < Vec::len(&mt.arms); i += 1)
            {
                ref<Expr, shared> body = Box::get(&mt.arms[i].body);
                if (Option::is_some(&mt.arms[i].binder))
                {
                    pos_up(m, body.line, 0);
                }
                rep_pos_in(body, m);
            }
        },
        ExprKind::EReturn(v) : match (v)
        {
            Some(x) : rep_pos_in(Box::get(x), m),
            None    : {},
        },
        ExprKind::EClosure(cb)    :
        {
            ref<ClosureExpr, shared> c = Box::get(cb);
            if (Vec::len(&c.captures) > 0)
            {
                pos_up(m, e.line, e.col);
            }
            rep_pos_block(&c.body, m);
        },
        _                         : {},
    }
}

fn rep_pos_block(ref<Block, shared> b, ref<Pos, exclusive> m)
{
    for (usize i = 0; i < Vec::len(&b.stmts); i += 1)
    {
        match (&b.stmts[i])
        {
            Stmt::SLet(lb)         :
            {
                ref<LetStmt, shared> l = Box::get(lb);
                match (&l.init)
                {
                    Some(e) : rep_pos_in(e, m),
                    None    : {},
                }
                pos_up(m, l.line, l.col);
            },
            Stmt::SDestructure(db) :
            {
                ref<DestructureStmt, shared> d = Box::get(db);
                rep_pos_in(&d.init, m);
                if (Vec::len(&d.names) > 0)
                {
                    pos_up(m, d.init.line, d.init.col);
                }
            },
            Stmt::SExpr(e)         : rep_pos_in(Box::get(e), m),
            Stmt::SBlockLike(e)    : rep_pos_in(Box::get(e), m),
        }
    }
    match (&b.tail)
    {
        Some(t) : rep_pos_in(Box::get(t), m),
        None    : {},
    }
}

fn rep_end_b(ref<Block, shared> b) : Pos
{
    Pos m = Pos { .line = 0, .col = 0 };
    for (usize i = 0; i < Vec::len(&b.stmts); i += 1)
    {
        match (&b.stmts[i])
        {
            Stmt::SLet(lb)        :
            {
                ref<LetStmt, shared> l = Box::get(lb);
                m = pos_max(&m, &Pos { .line = l.line, .col = l.col });
                match (&l.init)
                {
                    Some(e) : rep_end_e(e, &mut m),
                    None    : {},
                }
            },
            Stmt::SDestructure(d) : rep_end_e(&Box::get(d).init, &mut m),
            Stmt::SExpr(e)        : rep_end_e(Box::get(e), &mut m),
            Stmt::SBlockLike(e)   : rep_end_e(Box::get(e), &mut m),
        }
    }
    match (&b.tail)
    {
        Some(t) : rep_end_e(Box::get(t), &mut m),
        None    : {},
    }
    m
}

struct Walker
{
    Rep rep;
    // The declarations in scope, innermost last, by name.
    HashMap<String, Vec<usize>> visible;
}

fn wk_declare(ref<Walker, exclusive> w, ref<String, shared> name, Pos pos, Pos end, ref<Vec<String>, exclusive> scope)
{
    Vec::push(&mut w.rep.decls, Decl { .name = String::clone(name), .pos = pos, .end = end });
    usize ix = Vec::len(&w.rep.decls) - 1;
    Vec::push(HashMap::entry(&mut w.rep.decls_by, String::clone(name), Vec::new()), ix);
    ref<Vec<usize>, exclusive> v = HashMap::entry(&mut w.visible, String::clone(name), Vec::new());
    Vec::push(v, ix);
    Vec::push(scope, String::clone(name));
}

fn wk_close(ref<Walker, exclusive> w, Vec<String> scope)
{
    for (usize i = 0; i < Vec::len(&scope); i += 1)
    {
        match (HashMap::get_mut(&mut w.visible, &scope[i]))
        {
            Some(v) :
            {
                Vec::pop(v);
            },
            None    : {},
        }
    }
}

fn wk_use_name(ref<Walker, exclusive> w, ref<String, shared> name, usize line, usize col)
{
    usize d = match (HashMap::get(&w.visible, name))
    {
        Some(v) : if (Vec::len(v) > 0) { v[Vec::len(v) - 1] } else { REP_PARAM },
        None    : REP_PARAM,
    };
    Vec::push(&mut w.rep.uses, Use { .name = String::clone(name), .line = line, .col = col, .decl = d });
    usize ix = Vec::len(&w.rep.uses) - 1;
    Vec::push(HashMap::entry(&mut w.rep.uses_by, String::clone(name), Vec::new()), ix);
}

fn wk_block(ref<Walker, exclusive> w, ref<Block, shared> b)
{
    Pos end = rep_end_b(b);
    Vec<String> scope = Vec::new();
    for (usize i = 0; i < Vec::len(&b.stmts); i += 1)
    {
        match (&b.stmts[i])
        {
            Stmt::SLet(lb)         :
            {
                ref<LetStmt, shared> l = Box::get(lb);
                match (&l.init)
                {
                    Some(e) : wk_expr(w, e),
                    None    : {},
                }
                wk_declare(w, &l.name, Pos { .line = l.line, .col = l.col }, clone(&end), &mut scope);
            },
            Stmt::SDestructure(db) :
            {
                ref<DestructureStmt, shared> d = Box::get(db);
                wk_expr(w, &d.init);
                for (usize k = 0; k < Vec::len(&d.names); k += 1)
                {
                    wk_declare(w, &d.names[k], Pos { .line = d.init.line, .col = d.init.col }, clone(&end), &mut scope);
                }
            },
            Stmt::SExpr(e)         : wk_expr(w, Box::get(e)),
            Stmt::SBlockLike(e)    : wk_expr(w, Box::get(e)),
        }
    }
    match (&b.tail)
    {
        Some(t) : wk_expr(w, Box::get(t)),
        None    : {},
    }
    wk_close(w, scope);
}

fn wk_expr(ref<Walker, exclusive> w, ref<Expr, shared> e)
{
    match (&e.kind)
    {
        ExprKind::EPath(p)        :
        {
            ref<Vec<String>, shared> segs = &Box::get(p).segs;
            if (Vec::len(segs) == 1)
            {
                wk_use_name(w, &segs[0], e.line, e.col);
            }
        },
        ExprKind::EParen(x)       : wk_expr(w, Box::get(x)),
        ExprKind::EUnary(u)       : wk_expr(w, &Box::get(u).e),
        ExprKind::EPropagate(x)   : wk_expr(w, Box::get(x)),
        ExprKind::EDeref(x)       : wk_expr(w, Box::get(x)),
        ExprKind::EBorrow(bb)     : wk_expr(w, &Box::get(bb).e),
        ExprKind::EField(f)       : wk_expr(w, &Box::get(f).e),
        ExprKind::EArrayRepeat(r) : wk_expr(w, &Box::get(r).value),
        ExprKind::EBinary(bb)     :
        {
            wk_expr(w, &Box::get(bb).a);
            wk_expr(w, &Box::get(bb).b);
        },
        ExprKind::EIndex(pb)      :
        {
            wk_expr(w, &Box::get(pb).a);
            wk_expr(w, &Box::get(pb).b);
        },
        ExprKind::EAssign(pb)     :
        {
            wk_expr(w, &Box::get(pb).a);
            wk_expr(w, &Box::get(pb).b);
        },
        ExprKind::ESliceOf(sb)    :
        {
            ref<SliceExpr, shared> s = Box::get(sb);
            wk_expr(w, &s.base);
            wk_expr(w, &s.lo);
            wk_expr(w, &s.hi);
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            wk_expr(w, &c.callee);
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                wk_expr(w, &c.args[i]);
            }
        },
        ExprKind::EStructLit(sl)  :
        {
            ref<Vec<FieldInit>, shared> fs = &Box::get(sl).fields;
            for (usize i = 0; i < Vec::len(fs); i += 1)
            {
                wk_expr(w, &fs[i].value);
            }
        },
        ExprKind::EArrayLit(xs)   :
        {
            for (usize i = 0; i < Vec::len(xs); i += 1)
            {
                wk_expr(w, &xs[i]);
            }
        },
        ExprKind::EBlock(blk)     : wk_block(w, blk),
        ExprKind::EUnsafe(blk)    : wk_block(w, blk),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            wk_expr(w, &x.cond);
            wk_block(w, &x.then_);
            match (&x.else_)
            {
                Some(e2) : wk_expr(w, e2),
                None     : {},
            }
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            Pos end = Pos { .line = e.line, .col = e.col };
            rep_end_e(&x.cond, &mut end);
            end = pos_max(&end, &rep_end_b(&x.body));
            match (&x.step)
            {
                Some(st) : rep_end_e(st, &mut end),
                None     : {},
            }
            Vec::push(&mut w.rep.loops, LoopExtent { .a = e.line, .b = end.line });
            wk_expr(w, &x.cond);
            wk_block(w, &x.body);
            match (&x.step)
            {
                Some(st) : wk_expr(w, st),
                None     : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> m = Box::get(mb);
            wk_expr(w, &m.scrut);
            for (usize i = 0; i < Vec::len(&m.arms); i += 1)
            {
                ref<Arm, shared> a = &m.arms[i];
                ref<Expr, shared> body = Box::get(&a.body);
                // A binder is declared for its arm's body.
                Vec<String> scope = Vec::new();
                match (&a.binder)
                {
                    Some(bn) :
                    {
                        Pos end = Pos { .line = body.line, .col = body.col };
                        rep_end_e(body, &mut end);
                        wk_declare(w, bn, Pos { .line = body.line, .col = 0 }, end, &mut scope);
                    },
                    None     : {},
                }
                wk_expr(w, body);
                wk_close(w, scope);
            }
        },
        ExprKind::EReturn(v) : match (v)
        {
            Some(x) : wk_expr(w, Box::get(x)),
            None    : {},
        },
        ExprKind::EClosure(cb)    :
        {
            ref<ClosureExpr, shared> c = Box::get(cb);
            for (usize i = 0; i < Vec::len(&c.captures); i += 1)
            {
                wk_use_name(w, &c.captures[i], e.line, e.col);
            }
            wk_block(w, &c.body);
        },
        _                         : {},
    }
}

// D-0291: a `std` body whose rule decides it. `std::slice_parts` pushes
// reborrows of its slice into its result, each checked against those
// already there; `[Slice-Parts]` makes them disjoint, so no check of the
// body can fault, and its result reaches what its slice does.
fn rep_trusted(ref<String, shared> func) : bool
{
    String::eq_str(func, "std::slice_parts") || String::starts_with(func, "std::slice_parts<")
}

// Whether the body being checked is one its rule decides: its point
// checks are not made, as none can fault.
fn rep_in_trusted(ref<Body, shared> b) : bool
{
    rep_trusted(&b.rep.func)
}

// A conflict this body leaves to the run's tracking, `why` (the first is
// kept).
fn rep_left(ref<Body, exclusive> b, String why)
{
    if (Option::is_none(&b.rep.left) && !rep_trusted(&b.rep.func))
    {
        b.rep.left = Some(why);
    }
}

// The body's end (`tier_report::end`): the report written, and what it
// left to the run, into `Items` (coby's `tracking_needed`,
// `point_check_fns`, `point_checks`, written as the body is checked; here
// staged in the body and moved over once it is done).
fn tier_flush(ref<Body, exclusive> b, ref<Items, exclusive> it, ref<String, shared> key)
{
    Rep r = replace(&mut b.rep, rep_new(String::new()));
    match (&r.left)
    {
        Some(why) :
        {
            if (!HashMap::contains(&it.tracking_needed, key))
            {
                HashMap::insert(&mut it.tracking_needed, String::clone(key), String::clone(why));
            }
        },
        None      : {},
    }
    if (b.point_check_fn)
    {
        HashSet::insert(&mut it.point_check_fns, String::clone(key));
        b.point_check_fn = false;
    }
    Vec<PointAt> made = replace(&mut b.point_checks_made, Vec::new());
    for (usize i = 0; i < Vec::len(&made); i += 1)
    {
        ref<Vec<PointCheck>, exclusive> v = HashMap::entry(
            &mut it.point_checks,
            String::clone(&made[i].site),
            Vec::new(),
        );
        bool present = false;
        for (usize k = 0; k < Vec::len(v) && !present; k += 1)
        {
            present = point_check_eq(&v[k], &made[i].pc);
        }
        if (!present)
        {
            Vec::push(v, clone(&made[i].pc));
        }
        it.any_point_checks = true;
    }
    Option<String> path_opt = match (env_var("COBALTC_TIER_REPORT"))
    {
        Ok(Some(p)) : if (String::len(&p) > 0) { Some(p) } else { None },
        _           : None,
    };
    String path = match (path_opt)
    {
        Some(p) : p,
        None    : return,
    };
    String out = sprintf(
        "F\t%s\t%v\t%v\t%v\t%v\t%v\t%v\n",
        &r.func,
        r.checks,
        r.undecided,
        r.unknown_origin,
        r.inherited,
        r.tier_d,
        r.point_checks,
    );
    match (&r.error)
    {
        Some(e) : String::appendf(&mut out, "E\t%s\n", &String::replace(e, "\n", " ")),
        None    : {},
    }
    for (usize i = 0; i < Vec::len(&r.events); i += 1)
    {
        String::append(&mut out, &r.events[i]);
        String::append(&mut out, "\n");
    }
    match (File::append(String::as_view(&path)))
    {
        Ok(f)  :
        {
            _ = File::write_text(&mut f, String::as_view(&out));
            _ = File::close(f);
        },
        Err(_) : {},
    }
}

fn point_other_eq(ref<PointOther, shared> a, ref<PointOther, shared> b) : bool
{
    match (a)
    {
        PointOther::Arg(i) : match (b)
        {
            PointOther::Arg(j) : *i == *j,
            _                  : false,
        },
        PointOther::Holder(h) : match (b)
        {
            PointOther::Holder(g) : String::eq(h, g),
            _                     : false,
        },
    }
}

fn point_check_eq(ref<PointCheck, shared> a, ref<PointCheck, shared> b) : bool
{
    if (a.arg != b.arg || a.mode != b.mode || a.other_mode != b.other_mode || !String::eq(&a.callee, &b.callee))
    {
        return false;
    }
    if (!point_other_eq(&a.other, &b.other) || Vec::len(&a.fields) != Vec::len(&b.fields))
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(&a.fields); i += 1)
    {
        if (!String::eq(&a.fields[i], &b.fields[i]))
        {
            return false;
        }
    }
    true
}

// `tier::record_point_check`, staged until the body is done.
fn record_point_check(ref<Body, exclusive> b, String site, PointCheck pc)
{
    Vec::push(&mut b.point_checks_made, PointAt { .site = site, .pc = pc });
}

// A point check at a call's site, staged (`record_point_check`).
struct PointAt
{
    String site;
    PointCheck pc;
}

// An empty set of names, of a type the static pass knows (a `seen` set
// given beside a reference: `HashSet::new()`'s `K` is not known there, so
// the reference might be stored in it, D-0290).
fn new_name_set() : HashSet<String>
{
    HashSet::new()
}

// Rust's `trim_start_matches('*')`: a root without its leading stars.
fn strip_stars(StringView s) : StringView
{
    StringView r = s;
    while (true)
    {
        match (StringView::strip_prefix(r, "*"))
        {
            Some(t) : r = t,
            None    : break,
        }
    }
    r
}

fn mode_debug(Mode m) : str
{
    if (m == Mode::Exclusive) { "Exclusive" } else { "Shared" }
}

struct RangeLit
{
    u128 lo;
    u128 hi;
}

// One element of a syntactic projection path: a field name, an index (its
// literal value, or none), or (D-0070) a slice's range.
enum PElem
{
    PField(String),
    PIndex(Option<u128>),
    PRange(Option<RangeLit>),
}

// A slice's range as a path step: its bounds when both are literals.
fn range_elem(ref<Expr, shared> lo, ref<Expr, shared> hi) : PElem
{
    match (literal_value(lo))
    {
        Some(a) : match (literal_value(hi))
        {
            Some(b) :
            {
                if (a >= 0 && b >= a)
                {
                    return PElem::PRange(Some(RangeLit { .lo = reinterpret<u128>(a), .hi = reinterpret<u128>(b) }));
                }
            },
            None    : {},
        },
        None : {},
    }
    PElem::PRange(None)
}

// D-0282: overlap for the rules of frame-held references. `Yes` when the
// two paths certainly meet (equal fields and literal indices, one a prefix
// of the other, every element in the longer one's remainder present);
// `Maybe` when they meet only for some values (an index or a range bound
// that is not a literal, a range in the remainder that may be empty): a
// point check at run time; `No` when they cannot meet.
enum Ov
{
    OvNo,
    OvMaybe,
    OvYes,
}

fn one_seg(ref<Expr, shared> e) : Option<ref<String, shared>>
{
    match (&e.kind)
    {
        ExprKind::EPath(p) :
        {
            ref<Vec<String>, shared> segs = &Box::get(p).segs;
            if (Vec::len(segs) == 1) { Some(&segs[0]) } else { None }
        },
        _                  : None,
    }
}

fn segs_eq(ref<Vec<String>, shared> a, ref<Vec<String>, shared> b) : bool
{
    if (Vec::len(a) != Vec::len(b))
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(a); i += 1)
    {
        if (!String::eq(&a[i], &b[i]))
        {
            return false;
        }
    }
    true
}

// Two place (or borrow) expressions that name the same place, written the
// same way: a name, fields, literal or same-name indices, dereferences.
fn same_place(ref<Expr, shared> a0, ref<Expr, shared> b0) : bool
{
    ref<Expr, shared> a = strip_parens_tc(a0);
    ref<Expr, shared> b = strip_parens_tc(b0);
    match (&a.kind)
    {
        ExprKind::EPath(x) : match (&b.kind)
        {
            ExprKind::EPath(y) : segs_eq(&Box::get(x).segs, &Box::get(y).segs),
            _                  : false,
        },
        ExprKind::EBorrow(x) : match (&b.kind)
        {
            ExprKind::EBorrow(y) : Box::get(x).mode == Box::get(y).mode && same_place(&Box::get(x).e, &Box::get(y).e),
            _                    : false,
        },
        ExprKind::EField(x) : match (&b.kind)
        {
            ExprKind::EField(y) : String::eq(
                &Box::get(x).name,
                &Box::get(y).name,
            ) && same_place(&Box::get(x).e, &Box::get(y).e),
            _ : false,
        },
        ExprKind::EDeref(x) : match (&b.kind)
        {
            ExprKind::EDeref(y) : same_place(Box::get(x), Box::get(y)),
            _                   : false,
        },
        ExprKind::EIndex(x) : match (&b.kind)
        {
            ExprKind::EIndex(y) :
            {
                if (!same_place(&Box::get(x).a, &Box::get(y).a))
                {
                    return false;
                }
                ref<Expr, shared> i = strip_parens_tc(&Box::get(x).b);
                ref<Expr, shared> j = strip_parens_tc(&Box::get(y).b);
                match (&i.kind)
                {
                    ExprKind::EInt(u) : match (&j.kind)
                    {
                        ExprKind::EInt(v) : Box::get(u).v == Box::get(v).v && option_string_eq(
                            &Box::get(u).sfx,
                            &Box::get(v).sfx,
                        ),
                        _ : false,
                    },
                    ExprKind::EPath(p) : match (&j.kind)
                    {
                        ExprKind::EPath(q) : segs_eq(&Box::get(p).segs, &Box::get(q).segs),
                        _                  : false,
                    },
                    _ : false,
                }
            },
            _                   : false,
        },
        _ : false,
    }
}

fn option_string_eq(ref<Option<String>, shared> a, ref<Option<String>, shared> b) : bool
{
    match (a)
    {
        Some(x) : match (b)
        {
            Some(y) : String::eq(x, y),
            None    : false,
        },
        None : Option::is_none(b),
    }
}

fn overlap3(ref<Vec<PElem>, shared> a, ref<Vec<PElem>, shared> b) : Ov
{
    Ov ov = Ov::OvYes;
    for (usize i = 0; i < Vec::len(a) && i < Vec::len(b); i += 1)
    {
        match (&a[i])
        {
            PElem::PField(f) : match (&b[i])
            {
                PElem::PField(g) :
                {
                    if (!String::eq(f, g))
                    {
                        return Ov::OvNo;
                    }
                },
                PElem::PRange(_) : ov = Ov::OvMaybe,
                PElem::PIndex(_) : ov = Ov::OvMaybe,
            },
            PElem::PIndex(x) : match (&b[i])
            {
                PElem::PIndex(y) : match (x)
                {
                    Some(p) : match (y)
                    {
                        Some(q) :
                        {
                            if (*p != *q)
                            {
                                return Ov::OvNo;
                            }
                        },
                        None    : ov = Ov::OvMaybe,
                    },
                    None : ov = Ov::OvMaybe,
                },
                PElem::PRange(r) : match (r)
                {
                    Some(rl) : match (x)
                    {
                        Some(p) :
                        {
                            if (!(rl.lo <= *p && *p < rl.hi))
                            {
                                return Ov::OvNo;
                            }
                        },
                        None    : ov = Ov::OvMaybe,
                    },
                    None : ov = Ov::OvMaybe,
                },
                PElem::PField(_) : ov = Ov::OvMaybe,
            },
            PElem::PRange(r) : match (&b[i])
            {
                PElem::PIndex(y) : match (r)
                {
                    Some(rl) : match (y)
                    {
                        Some(q) :
                        {
                            if (!(rl.lo <= *q && *q < rl.hi))
                            {
                                return Ov::OvNo;
                            }
                        },
                        None    : ov = Ov::OvMaybe,
                    },
                    None : ov = Ov::OvMaybe,
                },
                PElem::PRange(s) : match (r)
                {
                    Some(r1) : match (s)
                    {
                        Some(r2) :
                        {
                            u128 lo = if (r1.lo > r2.lo) { r1.lo } else { r2.lo };
                            u128 hi = if (r1.hi < r2.hi) { r1.hi } else { r2.hi };
                            if (lo >= hi)
                            {
                                return Ov::OvNo;
                            }
                        },
                        None     : ov = Ov::OvMaybe,
                    },
                    None : ov = Ov::OvMaybe,
                },
                PElem::PField(_) : ov = Ov::OvMaybe,
            },
        }
    }
    // The longer path's remainder: a literal empty range touches nothing;
    // any other range may be empty.
    ref<Vec<PElem>, shared> longer = if (Vec::len(a) > Vec::len(b)) { a } else { b };
    usize from = if (Vec::len(a) > Vec::len(b)) { Vec::len(b) } else { Vec::len(a) };
    for (usize i = from; i < Vec::len(longer); i += 1)
    {
        match (&longer[i])
        {
            // An empty range still meets its container's fields
            // (`conf.empty-slice-meets-vec-fields`) but not always its
            // elements: the run decides.
            PElem::PRange(r) : match (r)
            {
                Some(rl) :
                {
                    if (rl.lo >= rl.hi)
                    {
                        ov = Ov::OvMaybe;
                    }
                },
                None     : ov = Ov::OvMaybe,
            },
            _ : {},
        }
    }
    ov
}

// A place as a message names it: its root and fields, an element as `[…]`.
fn shown_place(StringView root, ref<Vec<PElem>, shared> path) : String
{
    String out = String::from_view(shown_name(root));
    // `(*r)[0 .. 1]`, not `*r[0 .. 1]`.
    if (String::starts_with(&out, "*") && Vec::len(path) > 0)
    {
        bool elem = match (&path[0])
        {
            PElem::PField(_) : false,
            _                : true,
        };
        if (elem)
        {
            out = sprintf("(%s)", &out);
        }
    }
    for (usize i = 0; i < Vec::len(path); i += 1)
    {
        match (&path[i])
        {
            PElem::PField(f) :
            {
                String::append(&mut out, ".");
                String::append(&mut out, f);
            },
            PElem::PIndex(x) : match (x)
            {
                Some(v) : String::appendf(&mut out, "[%v]", *v),
                None    : String::append(&mut out, "[…]"),
            },
            PElem::PRange(r) : match (r)
            {
                Some(rl) : String::appendf(&mut out, "[%v .. %v]", rl.lo, rl.hi),
                None     : String::append(&mut out, "[… .. …]"),
            },
        }
    }
    out
}

// A callee as a message names it: without `std::`.
fn shown_callee(StringView key) : StringView
{
    Option::unwrap_or(StringView::strip_prefix(key, "std::"), key)
}

fn shown_access(Mode m) : str
{
    if (m == Mode::Exclusive) { "writes" } else { "reads" }
}

// ---- D-0290/D-0291 type facts the code generator asks for (typecheck.rs
// `keeps_refs_in_data`, `keeps_refs_in_data_by`, `frame_holdable`) ----

// A `fn` value's signature without modes, as `pathless_blocker` collects
// the closures' (`modeless`): what `keeps_refs_in_data_by` tests a
// `Type::Fn` against.
export struct FnSig
{
    export Vec<Type> params;
    export Type ret;
}

// How a `fn` or closure type counts for `keeps_refs_in_data_by`: a fixed
// answer (`keeps_refs_in_data`'s `fn_refs`), or by the signatures.
struct FnRefs
{
    bool by_sigs;
    bool value;
}

// cobc's `modeless`: `t` with every reference and slice made shared.
fn modeless(ref<Type, shared> t) : Type
{
    match (t)
    {
        Type::TRef(b)   : ref_of(modeless(&Box::get(b).inner), Mode::Shared),
        Type::TSlice(b) : slice_of(modeless(&Box::get(b).inner), Mode::Shared),
        Type::TArray(b) : array_of(modeless(&Box::get(b).inner), Box::get(b).n),
        Type::TNamed(b) :
        {
            Vec<Type> args = Vec::new();
            for (usize i = 0; i < Vec::len(&Box::get(b).args); i += 1)
            {
                Vec::push(&mut args, modeless(&Box::get(b).args[i]));
            }
            named(String::as_view(&Box::get(b).name), args)
        },
        Type::TFn(b)    :
        {
            Vec<Type> ps = Vec::new();
            for (usize i = 0; i < Vec::len(&Box::get(b).params); i += 1)
            {
                Vec::push(&mut ps, modeless(&Box::get(b).params[i]));
            }
            fn_of(ps, modeless(&Box::get(b).ret))
        },
        other           : clone(other),
    }
}

fn fn_refs_answer(ref<FnRefs, shared> fr, ref<Vec<FnSig>, shared> sigs, ref<Type, shared> t) : bool
{
    if (!fr.by_sigs)
    {
        return fr.value;
    }
    match (t)
    {
        Type::TFn(b) :
        {
            Vec<Type> ps = Vec::new();
            for (usize i = 0; i < Vec::len(&Box::get(b).params); i += 1)
            {
                Vec::push(&mut ps, modeless(&Box::get(b).params[i]));
            }
            Type r = modeless(&Box::get(b).ret);
            for (usize i = 0; i < Vec::len(sigs); i += 1)
            {
                if (types_eq_list(&sigs[i].params, &ps) && type_eq(&sigs[i].ret, &r))
                {
                    return true;
                }
            }
            false
        },
        _            : Vec::len(sigs) > 0,
    }
}

// D-0281 step 4c: whether a value of type `ty` keeps a reference in data
// -- a field, an element, a payload, a container's cells -- rather than
// being one itself as a frame holds it (a reference, a slice, a view, an
// `Option` or `Result` of one, a `fn` value): tier D, whose conflicts
// only the run's tracking finds. A `fn` value in data counts when
// `fn_refs`: some closure of the program keeps a reference in its
// environment.
export fn keeps_refs_in_data(ref<Items, shared> it, ref<Type, shared> ty, bool fn_refs) : bool
{
    keeps_refs_by(it, ty, &FnRefs { .by_sigs = false, .value = fn_refs }, &Vec::new())
}

// `keeps_refs_in_data`, with `sigs` deciding for each `fn` or closure
// type whether a value of it may keep references (D-0291: whether a
// closure of that signature does).
export fn keeps_refs_in_data_by(ref<Items, shared> it, ref<Type, shared> ty, ref<Vec<FnSig>, shared> sigs) : bool
{
    keeps_refs_by(it, ty, &FnRefs { .by_sigs = true, .value = false }, sigs)
}

fn keeps_refs_by(
    ref<Items, shared> it,
    ref<Type, shared> ty,
    ref<FnRefs, shared> fr,
    ref<Vec<FnSig>, shared> sigs,
) : bool
{
    bool frame_held = match (ty)
    {
        Type::TRef(_)     : true,
        Type::TSlice(_)   : true,
        Type::TClosure(_) : true,
        Type::TFn(_)      : true,
        // D-0289: a thread's handle or a lock's guard held by a frame is
        // the borrows it was formed with, ended by `join`, by `drop` or at
        // the frame's end (spec/19: no thread outlives its handle's frame).
        Type::THandle(b)  : !keeps_in(it, Box::get(b), fr, sigs, &mut new_name_set()),
        Type::TGuard(b)   : !keeps_in(it, Box::get(b), fr, sigs, &mut new_name_set()),
        Type::TNamed(b)   :
        {
            ref<NamedTy, shared> n = Box::get(b);
            // D-0287: `foreach`'s holder of a view's parts, as a view.
            if (String::eq_str(&n.name, "std::StringView") || String::eq_str(&n.name, "std::Parts"))
            {
                Vec::len(&n.args) == 0
            }
            else if (String::eq_str(&n.name, "std::Option") || String::eq_str(&n.name, "std::Result"))
            {
                bool first_ref = Vec::len(&n.args) > 0 && is_ref_or_view(&n.args[0]);
                bool rest_plain = true;
                for (usize i = 1; i < Vec::len(&n.args); i += 1)
                {
                    if (keeps_in(it, &n.args[i], fr, sigs, &mut new_name_set()))
                    {
                        rest_plain = false;
                    }
                }
                first_ref && rest_plain
            }
            else
            {
                false
            }
        },
        _                 : false,
    };
    if (frame_held)
    {
        return false;
    }
    keeps_in(it, ty, fr, sigs, &mut new_name_set())
}

// A reference, a slice, or a `StringView`.
fn is_ref_or_view(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(_)   : true,
        Type::TSlice(_) : true,
        _               : named_is(t, "std::StringView"),
    }
}

fn keeps_in(
    ref<Items, shared> it,
    ref<Type, shared> t,
    ref<FnRefs, shared> fr,
    ref<Vec<FnSig>, shared> sigs,
    ref<HashSet<String>, exclusive> seen,
) : bool
{
    match (t)
    {
        Type::TRef(_)     : true,
        Type::TSlice(_)   : true,
        Type::TGuard(_)   : true,
        // D-0289: a handle in data lends nothing (a spawn that lends has a
        // binding of the frame hold its handle, or is the run's), so it
        // keeps only what its result does.
        Type::THandle(b)  : keeps_in(it, Box::get(b), fr, sigs, seen),
        Type::TClosure(_) : fn_refs_answer(fr, sigs, t),
        Type::TFn(_)      : fn_refs_answer(fr, sigs, t),
        Type::TArray(b)   : keeps_in(it, &Box::get(b).inner, fr, sigs, seen),
        Type::TRawptr(b)  : keeps_in(it, Box::get(b), fr, sigs, seen),
        Type::TMutex(b)   : keeps_in(it, Box::get(b), fr, sigs, seen),
        Type::TNamed(b)   :
        {
            if (is_borrow_ty(t))
            {
                return true;
            }
            if (!HashSet::insert(seen, type_code(t)))
            {
                return false;
            }
            ref<NamedTy, shared> n = Box::get(b);
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (keeps_in(it, &n.args[i], fr, sigs, seen))
                {
                    return true;
                }
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        if (keeps_in(it, &apply_subst(&s.fields[i].ty, &subst), fr, sigs, seen))
                        {
                            return true;
                        }
                    }
                    return false;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) :
                            {
                                if (keeps_in(it, &apply_subst(p, &subst), fr, sigs, seen))
                                {
                                    return true;
                                }
                            },
                            None    : {},
                        }
                    }
                    false
                },
                None    : false,
            }
        },
        _                 : false,
    }
}

// D-0282: whether storage of type `ty` keeps references: in itself, or
// as a container's elements (`Vec<ref<T>>`, whose cells sit behind a raw
// pointer `holds_ref` does not follow).
fn stores_refs(ref<Items, shared> it, ref<Type, shared> ty) : bool
{
    match (ty)
    {
        Type::TNamed(b) :
        {
            if (holds_ref(it, ty))
            {
                return true;
            }
            ref<NamedTy, shared> n = Box::get(b);
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (stores_refs(it, &n.args[i]))
                {
                    return true;
                }
            }
            false
        },
        Type::TArray(b) : stores_refs(it, &Box::get(b).inner),
        _               : is_borrow_ty(ty) || holds_ref(it, ty),
    }
}

// D-0289: whether a value of type `t` holds a thread's handle.
fn holds_handle(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::THandle(_) : true,
        Type::TArray(b)  : holds_handle(&Box::get(b).inner),
        Type::TNamed(b)  :
        {
            ref<Vec<Type>, shared> args = &Box::get(b).args;
            for (usize i = 0; i < Vec::len(args); i += 1)
            {
                if (holds_handle(&args[i]))
                {
                    return true;
                }
            }
            false
        },
        _                : false,
    }
}

// D-0289: whether a value of type `t` holds a lock's guard.
fn holds_guard(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TGuard(_) : true,
        Type::TArray(b) : holds_guard(&Box::get(b).inner),
        Type::TNamed(b) :
        {
            ref<Vec<Type>, shared> args = &Box::get(b).args;
            for (usize i = 0; i < Vec::len(args); i += 1)
            {
                if (holds_guard(&args[i]))
                {
                    return true;
                }
            }
            false
        },
        _               : false,
    }
}

// D-0290: whether a value of type `t` holds no `fn` value, guard, lock or
// thread handle anywhere (a field, a payload, a type argument).
fn holder_free(ref<Items, shared> it, ref<Type, shared> t, ref<HashSet<String>, exclusive> seen) : bool
{
    match (t)
    {
        Type::TFn(_)      : false,
        Type::TClosure(_) : false,
        Type::TGuard(_)   : false,
        Type::TMutex(_)   : false,
        Type::THandle(_)  : false,
        Type::TArray(b)   : holder_free(it, &Box::get(b).inner, seen),
        Type::TRef(b)     : holder_free(it, &Box::get(b).inner, seen),
        Type::TSlice(b)   : holder_free(it, &Box::get(b).inner, seen),
        Type::TRawptr(b)  : holder_free(it, Box::get(b), seen),
        Type::TNamed(b)   :
        {
            if (!HashSet::insert(seen, type_code(t)))
            {
                return true;
            }
            ref<NamedTy, shared> n = Box::get(b);
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (!holder_free(it, &n.args[i], seen))
                {
                    return false;
                }
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        if (!holder_free(it, &apply_subst(&s.fields[i].ty, &subst), seen))
                        {
                            return false;
                        }
                    }
                    return true;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) :
                            {
                                if (!holder_free(it, &apply_subst(p, &subst), seen))
                                {
                                    return false;
                                }
                            },
                            None    : {},
                        }
                    }
                    true
                },
                None    : true,
            }
        },
        _                 : true,
    }
}

// D-0290: the kinds of reference a value of type `t` keeps, by what they
// refer to (`(false, T)` for `ref<T, _>`, `(true, T)` for `slice<T, _>`; a
// `StringView` keeps a `slice<u8>`): what a value given to a call can be
// stored as in data of another type. A leaf is coded `r:` or `s:` and the
// referent's `type_code`.
fn ref_leaf(bool as_slice, ref<Type, shared> t) : String
{
    sprintf("%s%s", if (as_slice) { "s:" } else { "r:" }, &type_code(t))
}

fn ref_leaves(
    ref<Items, shared> it,
    ref<Type, shared> t,
    ref<HashSet<String>, exclusive> out,
    ref<HashSet<String>, exclusive> seen,
)
{
    match (t)
    {
        // What is kept through a reference can be copied out of it too.
        Type::TRef(b)    :
        {
            HashSet::insert(out, ref_leaf(false, &Box::get(b).inner));
            ref_leaves(it, &Box::get(b).inner, out, seen);
        },
        Type::TSlice(b)  :
        {
            HashSet::insert(out, ref_leaf(true, &Box::get(b).inner));
            ref_leaves(it, &Box::get(b).inner, out, seen);
        },
        Type::TArray(b)  : ref_leaves(it, &Box::get(b).inner, out, seen),
        Type::TRawptr(b) : ref_leaves(it, Box::get(b), out, seen),
        Type::TNamed(b)  :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (String::eq_str(&n.name, "std::StringView") && Vec::len(&n.args) == 0)
            {
                HashSet::insert(out, ref_leaf(true, &Type::TInt(IntTy::U8)));
                return;
            }
            if (!HashSet::insert(seen, type_code(t)))
            {
                return;
            }
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                ref_leaves(it, &n.args[i], out, seen);
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        ref_leaves(it, &apply_subst(&s.fields[i].ty, &subst), out, seen);
                    }
                    return;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) : ref_leaves(it, &apply_subst(p, &subst), out, seen),
                            None    : {},
                        }
                    }
                },
                None    : {},
            }
        },
        _                : {},
    }
}

// D-0290: whether a value of type `t` reaches an exclusive reference
// through a shared one (`ref<ref<T, exclusive>, shared>`, a shared
// reference to a struct keeping one): a thread lent it reads through a
// path its lender's thread holds exclusively, which the run checks.
fn excl_under_shared(
    ref<Items, shared> it,
    ref<Type, shared> t,
    bool under,
    ref<HashSet<String>, exclusive> seen,
) : bool
{
    match (t)
    {
        Type::TRef(b)    :
        {
            if (under && Box::get(b).mode == Mode::Exclusive)
            {
                return true;
            }
            excl_under_shared(it, &Box::get(b).inner, under || Box::get(b).mode == Mode::Shared, seen)
        },
        Type::TSlice(b)  :
        {
            if (under && Box::get(b).mode == Mode::Exclusive)
            {
                return true;
            }
            excl_under_shared(it, &Box::get(b).inner, under || Box::get(b).mode == Mode::Shared, seen)
        },
        Type::TArray(b)  : excl_under_shared(it, &Box::get(b).inner, under, seen),
        Type::TRawptr(b) : excl_under_shared(it, Box::get(b), under, seen),
        Type::TNamed(b)  :
        {
            if (!HashSet::insert(seen, sprintf("%s%s", if (under) { "u" } else { "n" }, &type_code(t))))
            {
                return false;
            }
            ref<NamedTy, shared> n = Box::get(b);
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (excl_under_shared(it, &n.args[i], under, seen))
                {
                    return true;
                }
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        if (excl_under_shared(it, &apply_subst(&s.fields[i].ty, &subst), under, seen))
                        {
                            return true;
                        }
                    }
                    return false;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) :
                            {
                                if (excl_under_shared(it, &apply_subst(p, &subst), under, seen))
                                {
                                    return true;
                                }
                            },
                            None    : {},
                        }
                    }
                    false
                },
                None    : false,
            }
        },
        _                : false,
    }
}

// D-0290: whether a value of type `t` may be held by a frame as a holder
// of the references it keeps (no `fn` value, guard, lock or handle).
export fn frame_holdable(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    holder_free(it, t, &mut new_name_set())
}

// D-0291: the spawns whose handle `e`'s value is, or wraps in `Some`,
// through a `match`'s arms, an `if`'s branches and a block's tail; and
// whether every path that gives a value gives one of them (an arm that
// leaves by `return`, `break` or `continue` gives none).
struct TailSite
{
    String key;
    usize line;
}

fn tail_spawn_sites(ref<Expr, shared> e0, ref<Vec<TailSite>, exclusive> out) : bool
{
    ref<Expr, shared> e = strip_parens_tc(e0);
    match (&e.kind)
    {
        ExprKind::ECall(cb)   :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            if (is_spawn_call(e))
            {
                Vec::push(out, TailSite { .key = site_key(c.callee.line, c.callee.col), .line = c.callee.line });
                return true;
            }
            bool some = match (path_segs(&c.callee))
            {
                Some(segs) : Vec::len(segs) > 0 && String::eq_str(&segs[Vec::len(segs) - 1], "Some"),
                None       : false,
            };
            if (Vec::len(&c.args) == 1 && some)
            {
                return tail_spawn_sites(&c.args[0], out);
            }
            tss_leaves(e)
        },
        ExprKind::EMatch(mb)  :
        {
            bool all = true;
            ref<Vec<Arm>, shared> arms = &Box::get(mb).arms;
            for (usize i = 0; i < Vec::len(arms); i += 1)
            {
                bool one = tail_spawn_sites(Box::get(&arms[i].body), out);
                all = one && all;
            }
            all
        },
        ExprKind::EIf(ib)     :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            match (&x.else_)
            {
                Some(f) :
                {
                    bool t = tss_block(&x.then_, out);
                    bool fl = tail_spawn_sites(f, out);
                    t && fl
                },
                None    : tss_leaves(e),
            }
        },
        ExprKind::EBlock(blk) : tss_block(blk, out),
        _                     : tss_leaves(e),
    }
}

fn tss_block(ref<Block, shared> b, ref<Vec<TailSite>, exclusive> out) : bool
{
    match (&b.tail)
    {
        Some(t) : tail_spawn_sites(Box::get(t), out),
        None    :
        {
            usize n = Vec::len(&b.stmts);
            if (n == 0)
            {
                return false;
            }
            match (&b.stmts[n - 1])
            {
                Stmt::SExpr(e)      : tss_leaves(Box::get(e)),
                Stmt::SBlockLike(e) : tss_leaves(Box::get(e)),
                _                   : false,
            }
        },
    }
}

fn tss_leaves(ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EReturn(_) : true,
        ExprKind::EBreak     : true,
        ExprKind::EContinue  : true,
        _                    : false,
    }
}

// Whether `s` is `m = e;` with `e` not reading `m`: it ends what `m` held.
fn stmt_overwrites(ref<Stmt, shared> s, ref<String, shared> m) : bool
{
    ref<Expr, shared> e = match (s)
    {
        Stmt::SExpr(e) : Box::get(e),
        _              : return false,
    };
    ref<PairExpr, shared> p = match (&strip_parens_tc(e).kind)
    {
        ExprKind::EAssign(pb) : Box::get(pb),
        _                     : return false,
    };
    bool lhs_is_m = match (one_seg(strip_parens_tc(&p.a)))
    {
        Some(n) : String::eq(n, m),
        None    : false,
    };
    if (!lhs_is_m)
    {
        return false;
    }
    HashSet<String> free = HashSet::new();
    HashSet<String> bound = HashSet::new();
    collect_free_vars_expr(&p.b, &mut bound, &mut free);
    !HashSet::contains(&free, m)
}

// Whether `s` may leave its block other than by running to its end: a
// `break`, `continue`, `return` or `?` anywhere in it.
fn stmt_may_leave(ref<Stmt, shared> s) : bool
{
    match (s)
    {
        Stmt::SLet(l) : match (&Box::get(l).init)
        {
            Some(e) : has_leave(e),
            None    : false,
        },
        Stmt::SDestructure(d) : has_leave(&Box::get(d).init),
        Stmt::SExpr(e)        : has_leave(Box::get(e)),
        Stmt::SBlockLike(e)   : has_leave(Box::get(e)),
    }
}

fn has_leave_block(ref<Block, shared> b) : bool
{
    for (usize i = 0; i < Vec::len(&b.stmts); i += 1)
    {
        if (stmt_may_leave(&b.stmts[i]))
        {
            return true;
        }
    }
    match (&b.tail)
    {
        Some(t) : has_leave(Box::get(t)),
        None    : false,
    }
}

// `consts::visit` looking for a `break`, `continue`, `return` or `?`.
fn has_leave(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EBreak          : true,
        ExprKind::EContinue       : true,
        ExprKind::EReturn(_)      : true,
        ExprKind::EPropagate(_)   : true,
        ExprKind::EUnary(u)       : has_leave(&Box::get(u).e),
        ExprKind::EBorrow(b)      : has_leave(&Box::get(b).e),
        ExprKind::EDeref(a)       : has_leave(Box::get(a)),
        ExprKind::EField(f)       : has_leave(&Box::get(f).e),
        ExprKind::EParen(a)       : has_leave(Box::get(a)),
        ExprKind::EBinary(bb)     : has_leave(&Box::get(bb).a) || has_leave(&Box::get(bb).b),
        ExprKind::EIndex(p)       : has_leave(&Box::get(p).a) || has_leave(&Box::get(p).b),
        ExprKind::EAssign(p)      : has_leave(&Box::get(p).a) || has_leave(&Box::get(p).b),
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            if (has_leave(&c.callee))
            {
                return true;
            }
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                if (has_leave(&c.args[i]))
                {
                    return true;
                }
            }
            false
        },
        ExprKind::EStructLit(sl)  :
        {
            ref<Vec<FieldInit>, shared> fs = &Box::get(sl).fields;
            for (usize i = 0; i < Vec::len(fs); i += 1)
            {
                if (has_leave(&fs[i].value))
                {
                    return true;
                }
            }
            false
        },
        ExprKind::EArrayLit(xs)   :
        {
            for (usize i = 0; i < Vec::len(xs); i += 1)
            {
                if (has_leave(&xs[i]))
                {
                    return true;
                }
            }
            false
        },
        ExprKind::EArrayRepeat(r) : has_leave(&Box::get(r).value),
        ExprKind::ESliceOf(sb)    : has_leave(&Box::get(sb).base) || has_leave(&Box::get(sb).lo) || has_leave(&Box::get(sb).hi),
        ExprKind::EBlock(b)       : has_leave_block(b),
        ExprKind::EUnsafe(b)      : has_leave_block(b),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            has_leave(&x.cond) || has_leave_block(&x.then_) || match (&x.else_)
            {
                Some(e2) : has_leave(e2),
                None     : false,
            }
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            has_leave(&x.cond) || has_leave_block(&x.body) || match (&x.step)
            {
                Some(st) : has_leave(st),
                None     : false,
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> m = Box::get(mb);
            if (has_leave(&m.scrut))
            {
                return true;
            }
            for (usize i = 0; i < Vec::len(&m.arms); i += 1)
            {
                if (has_leave(Box::get(&m.arms[i].body)))
                {
                    return true;
                }
            }
            false
        },
        ExprKind::EClosure(cb)    : has_leave_block(&Box::get(cb).body),
        _                         : false,
    }
}

fn is_closure(ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EClosure(_) : true,
        _                     : false,
    }
}

// ---- walks over every expression of an expression (typecheck.rs
// `visit_exprs`, specialised to its three uses in `tier_call_rule`), and
// the exclusive borrows in one ----

// The single names assigned anywhere in `e` (`x = …`).
fn assigned_names(ref<Expr, shared> e, ref<Vec<String>, exclusive> out)
{
    match (&e.kind)
    {
        ExprKind::EAssign(pb) :
        {
            match (one_seg(strip_parens_tc(&Box::get(pb).a)))
            {
                Some(n) : Vec::push(out, String::clone(n)),
                None    : {},
            }
        },
        _                     : {},
    }
    Vec<String> none = Vec::new();
    bool dummy = false;
    ve_children(e, 0, out, &none, &mut dummy);
}

// Whether a single-name path in `e` names one of `names`.
fn mentions_one_of(ref<Expr, shared> e, ref<Vec<String>, shared> names) : bool
{
    bool found = false;
    Vec<String> sink = Vec::new();
    ve_visit(e, 1, &mut sink, names, &mut found);
    found
}

// `tier_call_rule`'s `acts`: an assignment whose root local is one of
// `roots`, or a call given one of them by name.
fn acts_on(ref<Expr, shared> e, ref<Vec<String>, shared> roots) : bool
{
    bool found = false;
    Vec<String> sink = Vec::new();
    ve_visit(e, 2, &mut sink, roots, &mut found);
    found
}

// One visit: `which` 0 collects assigned names into `out`, 1 tests the
// paths against `names`, 2 tests `acts_on`.
fn ve_visit(
    ref<Expr, shared> e,
    u8 which,
    ref<Vec<String>, exclusive> out,
    ref<Vec<String>, shared> names,
    ref<bool, exclusive> found,
)
{
    if (which == 0)
    {
        match (&e.kind)
        {
            ExprKind::EAssign(pb) :
            {
                match (one_seg(strip_parens_tc(&Box::get(pb).a)))
                {
                    Some(n) : Vec::push(out, String::clone(n)),
                    None    : {},
                }
            },
            _                     : {},
        }
    }
    else if (which == 1)
    {
        match (one_seg(e))
        {
            Some(n) :
            {
                if (Vec::contains(names, n))
                {
                    *found = true;
                }
            },
            None    : {},
        }
    }
    else
    {
        match (&e.kind)
        {
            ExprKind::EAssign(pb) : match (root_local_name(&Box::get(pb).a))
            {
                Some(r) :
                {
                    if (Vec::contains(names, &r))
                    {
                        *found = true;
                    }
                },
                None    : {},
            },
            ExprKind::ECall(cb) :
            {
                ref<Vec<Expr>, shared> xs = &Box::get(cb).args;
                for (usize i = 0; i < Vec::len(xs); i += 1)
                {
                    match (one_seg(strip_parens_tc(&xs[i])))
                    {
                        Some(n) :
                        {
                            if (Vec::contains(names, n))
                            {
                                *found = true;
                            }
                        },
                        None    : {},
                    }
                }
            },
            _                   : {},
        }
    }
    ve_children(e, which, out, names, found);
}

fn ve_block(
    ref<Block, shared> b,
    u8 which,
    ref<Vec<String>, exclusive> out,
    ref<Vec<String>, shared> names,
    ref<bool, exclusive> found,
)
{
    for (usize i = 0; i < Vec::len(&b.stmts); i += 1)
    {
        match (&b.stmts[i])
        {
            Stmt::SExpr(x)        : ve_visit(Box::get(x), which, out, names, found),
            Stmt::SBlockLike(x)   : ve_visit(Box::get(x), which, out, names, found),
            Stmt::SLet(l) : match (&Box::get(l).init)
            {
                Some(x) : ve_visit(x, which, out, names, found),
                None    : {},
            },
            Stmt::SDestructure(d) : ve_visit(&Box::get(d).init, which, out, names, found),
        }
    }
    match (&b.tail)
    {
        Some(t) : ve_visit(Box::get(t), which, out, names, found),
        None    : {},
    }
}

fn ve_children(
    ref<Expr, shared> e,
    u8 which,
    ref<Vec<String>, exclusive> out,
    ref<Vec<String>, shared> names,
    ref<bool, exclusive> found,
)
{
    match (&e.kind)
    {
        ExprKind::EParen(x)       : ve_visit(Box::get(x), which, out, names, found),
        ExprKind::EUnary(u)       : ve_visit(&Box::get(u).e, which, out, names, found),
        ExprKind::EDeref(x)       : ve_visit(Box::get(x), which, out, names, found),
        ExprKind::EField(f)       : ve_visit(&Box::get(f).e, which, out, names, found),
        ExprKind::EBorrow(bb)     : ve_visit(&Box::get(bb).e, which, out, names, found),
        ExprKind::EPropagate(x)   : ve_visit(Box::get(x), which, out, names, found),
        ExprKind::EArrayRepeat(r) : ve_visit(&Box::get(r).value, which, out, names, found),
        ExprKind::EReturn(v) : match (v)
        {
            Some(x) : ve_visit(Box::get(x), which, out, names, found),
            None    : {},
        },
        ExprKind::ESliceOf(sb)    :
        {
            ref<SliceExpr, shared> s = Box::get(sb);
            ve_visit(&s.base, which, out, names, found);
            ve_visit(&s.lo, which, out, names, found);
            ve_visit(&s.hi, which, out, names, found);
        },
        ExprKind::EBinary(bb)     :
        {
            ve_visit(&Box::get(bb).a, which, out, names, found);
            ve_visit(&Box::get(bb).b, which, out, names, found);
        },
        ExprKind::EIndex(pb)      :
        {
            ve_visit(&Box::get(pb).a, which, out, names, found);
            ve_visit(&Box::get(pb).b, which, out, names, found);
        },
        ExprKind::EAssign(pb)     :
        {
            ve_visit(&Box::get(pb).a, which, out, names, found);
            ve_visit(&Box::get(pb).b, which, out, names, found);
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            ve_visit(&c.callee, which, out, names, found);
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                ve_visit(&c.args[i], which, out, names, found);
            }
        },
        ExprKind::EArrayLit(xs)   :
        {
            for (usize i = 0; i < Vec::len(xs); i += 1)
            {
                ve_visit(&xs[i], which, out, names, found);
            }
        },
        ExprKind::EStructLit(sl)  :
        {
            ref<Vec<FieldInit>, shared> fs = &Box::get(sl).fields;
            for (usize i = 0; i < Vec::len(fs); i += 1)
            {
                ve_visit(&fs[i].value, which, out, names, found);
            }
        },
        ExprKind::EBlock(b)       : ve_block(b, which, out, names, found),
        ExprKind::EUnsafe(b)      : ve_block(b, which, out, names, found),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            ve_visit(&x.cond, which, out, names, found);
            ve_block(&x.then_, which, out, names, found);
            match (&x.else_)
            {
                Some(e2) : ve_visit(e2, which, out, names, found),
                None     : {},
            }
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            ve_visit(&x.cond, which, out, names, found);
            ve_block(&x.body, which, out, names, found);
            match (&x.step)
            {
                Some(st) : ve_visit(st, which, out, names, found),
                None     : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> m = Box::get(mb);
            ve_visit(&m.scrut, which, out, names, found);
            for (usize i = 0; i < Vec::len(&m.arms); i += 1)
            {
                ve_visit(Box::get(&m.arms[i].body), which, out, names, found);
            }
        },
        ExprKind::EClosure(cb)    : ve_block(&Box::get(cb).body, which, out, names, found),
        _                         : {},
    }
}

// The exclusive borrows written in `e` (`&mut x`, `&mut x[a..b]`), for the
// D-0282 order rules.
fn excl_borrows_in(ref<Expr, shared> e, ref<Vec<Expr>, exclusive> out)
{
    match (&e.kind)
    {
        ExprKind::EBorrow(bb)     :
        {
            // As the Rust: an exclusive borrow is taken whole, its operand
            // not looked into; a shared one is walked through.
            if (Box::get(bb).mode == Mode::Exclusive)
            {
                Vec::push(out, clone(e));
            }
            else
            {
                excl_borrows_in(&Box::get(bb).e, out);
            }
        },
        ExprKind::ESliceOf(sb)    :
        {
            ref<SliceExpr, shared> s = Box::get(sb);
            if (s.mode == Mode::Exclusive)
            {
                Vec::push(
                    out,
                    mk(
                        ExprKind::EBorrow(Box::new(BorrowExpr { .mode = Mode::Exclusive, .e = clone(&s.base) })),
                        e.line,
                        e.col,
                    ),
                );
            }
            excl_borrows_in(&s.base, out);
            excl_borrows_in(&s.lo, out);
            excl_borrows_in(&s.hi, out);
        },
        ExprKind::EParen(x)       : excl_borrows_in(Box::get(x), out),
        ExprKind::EUnary(u)       : excl_borrows_in(&Box::get(u).e, out),
        ExprKind::EDeref(x)       : excl_borrows_in(Box::get(x), out),
        ExprKind::EField(f)       : excl_borrows_in(&Box::get(f).e, out),
        ExprKind::EPropagate(x)   : excl_borrows_in(Box::get(x), out),
        ExprKind::EArrayRepeat(r) : excl_borrows_in(&Box::get(r).value, out),
        ExprKind::EReturn(v) : match (v)
        {
            Some(x) : excl_borrows_in(Box::get(x), out),
            None    : {},
        },
        ExprKind::EBinary(bb)     :
        {
            excl_borrows_in(&Box::get(bb).a, out);
            excl_borrows_in(&Box::get(bb).b, out);
        },
        ExprKind::EIndex(pb)      :
        {
            excl_borrows_in(&Box::get(pb).a, out);
            excl_borrows_in(&Box::get(pb).b, out);
        },
        ExprKind::EAssign(pb)     :
        {
            excl_borrows_in(&Box::get(pb).a, out);
            excl_borrows_in(&Box::get(pb).b, out);
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            excl_borrows_in(&c.callee, out);
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                excl_borrows_in(&c.args[i], out);
            }
        },
        ExprKind::EArrayLit(xs)   :
        {
            for (usize i = 0; i < Vec::len(xs); i += 1)
            {
                excl_borrows_in(&xs[i], out);
            }
        },
        ExprKind::EStructLit(sl)  :
        {
            ref<Vec<FieldInit>, shared> fs = &Box::get(sl).fields;
            for (usize i = 0; i < Vec::len(fs); i += 1)
            {
                excl_borrows_in(&fs[i].value, out);
            }
        },
        ExprKind::EBlock(b)       : excl_borrows_block(b, out),
        ExprKind::EUnsafe(b)      : excl_borrows_block(b, out),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            excl_borrows_in(&x.cond, out);
            excl_borrows_block(&x.then_, out);
            match (&x.else_)
            {
                Some(f) : excl_borrows_in(f, out),
                None    : {},
            }
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            excl_borrows_in(&x.cond, out);
            excl_borrows_block(&x.body, out);
            match (&x.step)
            {
                Some(st) : excl_borrows_in(st, out),
                None     : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> m = Box::get(mb);
            excl_borrows_in(&m.scrut, out);
            for (usize i = 0; i < Vec::len(&m.arms); i += 1)
            {
                excl_borrows_in(Box::get(&m.arms[i].body), out);
            }
        },
        _                         : {},
    }
}

fn excl_borrows_block(ref<Block, shared> b, ref<Vec<Expr>, exclusive> out)
{
    for (usize i = 0; i < Vec::len(&b.stmts); i += 1)
    {
        match (&b.stmts[i])
        {
            Stmt::SExpr(x)        : excl_borrows_in(Box::get(x), out),
            Stmt::SBlockLike(x)   : excl_borrows_in(Box::get(x), out),
            Stmt::SLet(l) : match (&Box::get(l).init)
            {
                Some(x) : excl_borrows_in(x, out),
                None    : {},
            },
            Stmt::SDestructure(d) : excl_borrows_in(&Box::get(d).init, out),
        }
    }
    match (&b.tail)
    {
        Some(t) : excl_borrows_in(Box::get(t), out),
        None    : {},
    }
}

// Two paths overlap iff one is a prefix of the other, literal indices
// compared by value, a non-literal index overlapping every index.
fn paths_overlap(ref<Vec<PElem>, shared> a, ref<Vec<PElem>, shared> b) : bool
{
    for (usize i = 0; i < Vec::len(a) && i < Vec::len(b); i += 1)
    {
        match (&a[i])
        {
            PElem::PField(f) : match (&b[i])
            {
                PElem::PField(g) :
                {
                    if (!String::eq(f, g))
                    {
                        return false;
                    }
                },
                _                : return false,
            },
            PElem::PIndex(x) : match (&b[i])
            {
                PElem::PIndex(y) :
                {
                    match (x)
                    {
                        Some(p) : match (y)
                        {
                            Some(q) :
                            {
                                if (*p != *q)
                                {
                                    return false;
                                }
                            },
                            None    : {},
                        },
                        None : {},
                    }
                },
                PElem::PRange(r) :
                {
                    match (x)
                    {
                        Some(p) : match (r)
                        {
                            Some(rl) :
                            {
                                if (!(rl.lo <= *p && *p < rl.hi))
                                {
                                    return false;
                                }
                            },
                            None     : return false,
                        },
                        None : return false,
                    }
                },
                _                : return false,
            },
            PElem::PRange(r) : match (&b[i])
            {
                PElem::PIndex(y) :
                {
                    match (r)
                    {
                        Some(rl) : match (y)
                        {
                            Some(q) :
                            {
                                if (!(rl.lo <= *q && *q < rl.hi))
                                {
                                    return false;
                                }
                            },
                            None    : return false,
                        },
                        None : return false,
                    }
                },
                PElem::PRange(s) :
                {
                    match (r)
                    {
                        Some(r1) : match (s)
                        {
                            Some(r2) :
                            {
                                u128 lo = if (r1.lo > r2.lo) { r1.lo } else { r2.lo };
                                u128 hi = if (r1.hi < r2.hi) { r1.hi } else { r2.hi };
                                if (lo >= hi)
                                {
                                    return false;
                                }
                            },
                            None     : return false,
                        },
                        None : return false,
                    }
                },
                _                : return false,
            },
        }
    }
    true
}

// D-0071: the referent of a reference or guard binding `r` is a root of
// its own, `*r`.
fn referent_root(StringView r) : String
{
    sprintf("*%s", r)
}

// The binding a root belongs to: `r` for `*r`.
fn root_binding(StringView root) : StringView
{
    Option::unwrap_or(StringView::strip_prefix(root, "*"), root)
}

// `deriv(r, x.π, m)`: `r` holds a reference derived from `x`'s object at
// path `π` with mode `m`.
struct DerivKey
{
    String root;
    Vec<PElem> path;
    Mode mode;
}

// A `DerivKey` as a map key: its parts, written out exactly.
fn deriv_code(ref<DerivKey, shared> k) : String
{
    String o = sprintf("%v:%s|", String::len(&k.root), &k.root);
    for (usize i = 0; i < Vec::len(&k.path); i += 1)
    {
        match (&k.path[i])
        {
            PElem::PField(f) : String::appendf(&mut o, "f%v:%s", String::len(f), f),
            PElem::PIndex(x) : match (x)
            {
                Some(v) : String::appendf(&mut o, "i%v;", *v),
                None    : String::append(&mut o, "i?;"),
            },
            PElem::PRange(r) : match (r)
            {
                Some(rl) : String::appendf(&mut o, "r%v,%v;", rl.lo, rl.hi),
                None     : String::append(&mut o, "r?;"),
            },
        }
    }
    String::append(&mut o, if (k.mode == Mode::Shared) { "|s" } else { "|x" });
    o
}

// One `deriv` fact: its key and its value.
struct DerivFact
{
    DerivKey key;
    Tri v;
}

// The flow facts at a program point.
struct Flow
{
    // The point is not reachable: no fact is asserted.
    bool unreachable;
    HashMap<String, Tri> valid;
    HashMap<String, Tri> init;
    // For each reference binding, its facts by `deriv_code`.
    HashMap<String, HashMap<String, DerivFact>> deriv;
    // spec/14's value-range row: a binding bound to a literal with no
    // intervening write.
    HashMap<String, i128> lits;
}

fn new_flow() : Flow
{
    Flow { .unreachable = false, .valid = HashMap::new(), .init = HashMap::new(), .deriv = HashMap::new(), .lits = HashMap::new() }
}

// A shadowed binding's facts, kept aside while the shadowing block is
// open.
struct RootedFact
{
    String holder;
    DerivKey key;
    Tri v;
}

struct SavedFacts
{
    Tri valid;
    Tri init;
    Option<HashMap<String, DerivFact>> own_deriv;
    Vec<RootedFact> rooted;
    Option<i128> lit;
}

struct LoopCtx
{
    Vec<Flow> breaks;
    Vec<Flow> continues;
}

struct ScopeEntry
{
    String name;
    Option<SavedFacts> flow;
    Option<usize> decl_block;
    Option<Option<Referent>> ref_origin;
}

fn flow_is_tracked(ref<Flow, shared> f, ref<String, shared> name) : bool
{
    HashMap::contains(&f.valid, name)
}

// A declaration: `valid(x) := T`, `init(x) := T` or `F`; facts about a
// previous binding of the name are dropped.
fn flow_declare(ref<Flow, exclusive> f, ref<String, shared> name, bool initialized)
{
    HashMap::remove(&mut f.lits, name);
    HashMap::insert(&mut f.valid, String::clone(name), Tri::T);
    HashMap::insert(&mut f.init, String::clone(name), if (initialized) { Tri::T } else { Tri::F });
    HashMap::remove(&mut f.deriv, name);
    flow_clear_rooted(f, String::as_view(name));
    flow_clear_rooted(f, String::as_view(&referent_root(String::as_view(name))));
}

// Every `deriv(·, x.·, ·) := F`.
fn flow_clear_rooted(ref<Flow, exclusive> f, StringView x)
{
    Vec<String> empty = Vec::new();
    for (usize i = 0; i < HashMap::len(&f.deriv); i += 1)
    {
        String h = String::clone(HashMap::key_at(&f.deriv, i));
        ref<HashMap<String, DerivFact>, exclusive> facts = Option::expect(
            HashMap::get_mut(&mut f.deriv, &h),
            "a holder",
        );
        Vec<String> gone = Vec::new();
        for (usize k = 0; k < HashMap::len(facts); k += 1)
        {
            if (String::eq_view(&HashMap::value_at(facts, k).key.root, x))
            {
                Vec::push(&mut gone, String::clone(HashMap::key_at(facts, k)));
            }
        }
        for (usize k = 0; k < Vec::len(&gone); k += 1)
        {
            HashMap::remove(facts, &gone[k]);
        }
        if (HashMap::len(facts) == 0)
        {
            Vec::push(&mut empty, h);
        }
    }
    for (usize i = 0; i < Vec::len(&empty); i += 1)
    {
        HashMap::remove(&mut f.deriv, &empty[i]);
    }
}

// Block exit for a binding declared in the block: it is untracked.
fn flow_remove(ref<Flow, exclusive> f, ref<String, shared> name)
{
    HashMap::remove(&mut f.lits, name);
    HashMap::remove(&mut f.valid, name);
    HashMap::remove(&mut f.init, name);
    HashMap::remove(&mut f.deriv, name);
    flow_clear_rooted(f, String::as_view(name));
    flow_clear_rooted(f, String::as_view(&referent_root(String::as_view(name))));
}

fn tri_or_u(Option<ref<Tri, shared>> t) : Tri
{
    match (t)
    {
        Some(v) : *v,
        None    : Tri::U,
    }
}

fn flow_save(ref<Flow, shared> f, ref<String, shared> name) : SavedFacts
{
    Vec<RootedFact> rooted = Vec::new();
    for (usize i = 0; i < HashMap::len(&f.deriv); i += 1)
    {
        ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&f.deriv, i);
        for (usize k = 0; k < HashMap::len(facts); k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            if (String::eq(&d.key.root, name))
            {
                Vec::push(
                    &mut rooted,
                    RootedFact { .holder = String::clone(HashMap::key_at(
                        &f.deriv,
                        i,
                    )), .key = clone(&d.key), .v = d.v },
                );
            }
        }
    }
    SavedFacts {
        .valid = tri_or_u(HashMap::get(&f.valid, name)),
        .init = tri_or_u(HashMap::get(&f.init, name)),
        .own_deriv = match (HashMap::get(&f.deriv, name))
    {
        Some(d) : Some(clone(d)),
        None    : None,
    },
        .rooted = rooted,
        .lit = match (HashMap::get(&f.lits, name))
    {
        Some(v) : Some(*v),
        None    : None,
    },
    }
}

fn flow_restore(ref<Flow, exclusive> f, ref<String, shared> name, SavedFacts s)
{
    SavedFacts { valid, init, own_deriv, rooted, lit } = s;
    HashMap::insert(&mut f.valid, String::clone(name), valid);
    HashMap::insert(&mut f.init, String::clone(name), init);
    match (own_deriv)
    {
        Some(d) :
        {
            HashMap::insert(&mut f.deriv, String::clone(name), d);
        },
        None    : {},
    }
    for (usize i = 0; i < Vec::len(&rooted); i += 1)
    {
        ref<RootedFact, shared> r = &rooted[i];
        ref<HashMap<String, DerivFact>, exclusive> facts = HashMap::entry(
            &mut f.deriv,
            String::clone(&r.holder),
            HashMap::new(),
        );
        HashMap::insert(facts, deriv_code(&r.key), DerivFact { .key = clone(&r.key), .v = r.v });
    }
    match (lit)
    {
        Some(v) :
        {
            HashMap::insert(&mut f.lits, String::clone(name), v);
        },
        None    : {},
    }
}

fn deriv_v(ref<Flow, shared> f, ref<String, shared> holder, ref<String, shared> code) : Tri
{
    match (HashMap::get(&f.deriv, holder))
    {
        Some(facts) : match (HashMap::get(facts, code))
        {
            Some(d) : d.v,
            None    : Tri::F,
        },
        None : Tri::F,
    }
}

// The pointwise join at a merge point; an unreachable side is the
// identity. A name tracked on only one side is dropped.
fn flow_join(ref<Flow, shared> a, ref<Flow, shared> b) : Flow
{
    if (a.unreachable)
    {
        return clone(b);
    }
    if (b.unreachable)
    {
        return clone(a);
    }
    Flow out = new_flow();
    for (usize i = 0; i < HashMap::len(&a.lits); i += 1)
    {
        ref<String, shared> n = HashMap::key_at(&a.lits, i);
        i128 v = *HashMap::value_at(&a.lits, i);
        match (HashMap::get(&b.lits, n))
        {
            Some(w) :
            {
                if (*w == v)
                {
                    HashMap::insert(&mut out.lits, String::clone(n), v);
                }
            },
            None    : {},
        }
    }
    for (usize i = 0; i < HashMap::len(&a.valid); i += 1)
    {
        ref<String, shared> n = HashMap::key_at(&a.valid, i);
        Tri va = *HashMap::value_at(&a.valid, i);
        match (HashMap::get(&b.valid, n))
        {
            Some(vb) :
            {
                HashMap::insert(&mut out.valid, String::clone(n), tri_join(va, *vb));
                Tri ia = tri_or_u(HashMap::get(&a.init, n));
                Tri ib = tri_or_u(HashMap::get(&b.init, n));
                HashMap::insert(&mut out.init, String::clone(n), tri_join(ia, ib));
            },
            None     : {},
        }
    }
    HashSet<String> holders = HashSet::new();
    for (usize i = 0; i < HashMap::len(&a.deriv); i += 1)
    {
        HashSet::insert(&mut holders, String::clone(HashMap::key_at(&a.deriv, i)));
    }
    for (usize i = 0; i < HashMap::len(&b.deriv); i += 1)
    {
        HashSet::insert(&mut holders, String::clone(HashMap::key_at(&b.deriv, i)));
    }
    HashMap<String, DerivFact> empty = HashMap::new();
    for (usize i = 0; i < HashSet::len(&holders); i += 1)
    {
        ref<String, shared> r = HashSet::key_at(&holders, i);
        if (!HashMap::contains(&out.valid, r))
        {
            continue;
        }
        ref<HashMap<String, DerivFact>, shared> fa = Option::unwrap_or(HashMap::get(&a.deriv, r), &empty);
        ref<HashMap<String, DerivFact>, shared> fb = Option::unwrap_or(HashMap::get(&b.deriv, r), &empty);
        HashMap<String, DerivFact> merged = HashMap::new();
        for (usize side = 0; side < 2; side += 1)
        {
            ref<HashMap<String, DerivFact>, shared> src = if (side == 0) { fa } else { fb };
            for (usize k = 0; k < HashMap::len(src); k += 1)
            {
                ref<String, shared> code = HashMap::key_at(src, k);
                if (HashMap::contains(&merged, code))
                {
                    continue;
                }
                ref<DerivFact, shared> d = HashMap::value_at(src, k);
                if (!HashMap::contains(&out.valid, &String::from_view(root_binding(String::as_view(&d.key.root)))))
                {
                    continue;
                }
                Tri pa = match (HashMap::get(fa, code))
                {
                    Some(x) : x.v,
                    None    : Tri::F,
                };
                Tri pb = match (HashMap::get(fb, code))
                {
                    Some(x) : x.v,
                    None    : Tri::F,
                };
                Tri v = tri_join(pa, pb);
                if (v != Tri::F)
                {
                    HashMap::insert(&mut merged, String::clone(code), DerivFact { .key = clone(&d.key), .v = v });
                }
            }
        }
        if (HashMap::len(&merged) > 0)
        {
            HashMap::insert(&mut out.deriv, String::clone(r), merged);
        }
    }
    out
}

fn tri_maps_eq(ref<HashMap<String, Tri>, shared> a, ref<HashMap<String, Tri>, shared> b) : bool
{
    if (HashMap::len(a) != HashMap::len(b))
    {
        return false;
    }
    for (usize i = 0; i < HashMap::len(a); i += 1)
    {
        match (HashMap::get(b, HashMap::key_at(a, i)))
        {
            Some(v) :
            {
                if (*v != *HashMap::value_at(a, i))
                {
                    return false;
                }
            },
            None    : return false,
        }
    }
    true
}

// `Flow == Flow`, the maps compared as maps.
fn flow_eq(ref<Flow, shared> a, ref<Flow, shared> b) : bool
{
    if (a.unreachable != b.unreachable || !tri_maps_eq(&a.valid, &b.valid) || !tri_maps_eq(&a.init, &b.init))
    {
        return false;
    }
    if (HashMap::len(&a.lits) != HashMap::len(&b.lits) || HashMap::len(&a.deriv) != HashMap::len(&b.deriv))
    {
        return false;
    }
    for (usize i = 0; i < HashMap::len(&a.lits); i += 1)
    {
        match (HashMap::get(&b.lits, HashMap::key_at(&a.lits, i)))
        {
            Some(v) :
            {
                if (*v != *HashMap::value_at(&a.lits, i))
                {
                    return false;
                }
            },
            None    : return false,
        }
    }
    for (usize i = 0; i < HashMap::len(&a.deriv); i += 1)
    {
        ref<HashMap<String, DerivFact>, shared> fa = HashMap::value_at(&a.deriv, i);
        ref<HashMap<String, DerivFact>, shared> fb = match (HashMap::get(&b.deriv, HashMap::key_at(&a.deriv, i)))
        {
            Some(m) : m,
            None    : return false,
        };
        if (HashMap::len(fa) != HashMap::len(fb))
        {
            return false;
        }
        for (usize k = 0; k < HashMap::len(fa); k += 1)
        {
            match (HashMap::get(fb, HashMap::key_at(fa, k)))
            {
                Some(d) :
                {
                    if (d.v != HashMap::value_at(fa, k).v)
                    {
                        return false;
                    }
                },
                None    : return false,
            }
        }
    }
    true
}

// Whether a value of `ty` is or holds a function value (`[Eq-Fn]`).
fn contains_fn(ref<Items, shared> it, ref<Type, shared> ty) : bool
{
    match (ty)
    {
        Type::TFn(_)      : true,
        Type::TClosure(_) : true,
        Type::TArray(b)   : contains_fn(it, &Box::get(b).inner),
        Type::TNamed(_)   : any_part(it, ty, 0),
        _                 : false,
    }
}

// Whether a struct's fields or an enum's payloads (substituted) satisfy
// `which` (0 contains_fn, 1 contains_slice, 2 holds_ref).
fn any_part(ref<Items, shared> it, ref<Type, shared> ty, u8 which) : bool
{
    ref<NamedTy, shared> n = match (ty)
    {
        Type::TNamed(b) : Box::get(b),
        _               : return false,
    };
    Vec<Type> parts = Vec::new();
    HashMap<String, Type> subst = HashMap::new();
    match (HashMap::get(&it.structs, &n.name))
    {
        Some(s) :
        {
            subst = zip_subst(&s.type_params, &n.args);
            for (usize i = 0; i < Vec::len(&s.fields); i += 1)
            {
                Vec::push(&mut parts, clone(&s.fields[i].ty));
            }
        },
        None : match (HashMap::get(&it.enums, &n.name))
        {
            Some(e) :
            {
                subst = zip_subst(&e.type_params, &n.args);
                for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                {
                    match (&e.variants[i].payload)
                    {
                        Some(p) : Vec::push(&mut parts, clone(p)),
                        None    : {},
                    }
                }
            },
            None    : return false,
        },
    }
    for (usize i = 0; i < Vec::len(&parts); i += 1)
    {
        Type pt = apply_subst(&parts[i], &subst);
        bool hit = if (which == 0)
        {
            contains_fn(
                it,
                &pt,
            )
        }
        else if (which == 1) { contains_slice(it, &pt) } else { holds_ref(it, &pt) };
        if (hit)
        {
            return true;
        }
    }
    false
}

// Whether `[Eq-Struct]`'s field-by-field comparison would reach a slice.
fn contains_slice(ref<Items, shared> it, ref<Type, shared> ty) : bool
{
    match (ty)
    {
        Type::TSlice(_) : true,
        Type::TArray(b) : contains_slice(it, &Box::get(b).inner),
        Type::TNamed(_) : any_part(it, ty, 1),
        _               : false,
    }
}

fn fn_shown(ref<FnDecl, shared> f) : String
{
    String n = match (&f.assoc_type)
    {
        Some(a) : sprintf("%s::%s", a, &f.name),
        None    : String::clone(&f.name),
    };
    String::from_view(Option::unwrap_or(String::strip_prefix(&n, "std::"), String::as_view(&n)))
}

fn mismatch(String msg) : String
{
    sprintf("diag.type-mismatch\u{1}%s", &msg)
}

// Whether a value of `ty` holds a reference or slice.
fn holds_ref(ref<Items, shared> it, ref<Type, shared> ty) : bool
{
    match (ty)
    {
        Type::TRef(_)   : true,
        Type::TSlice(_) : true,
        Type::TArray(b) : holds_ref(it, &Box::get(b).inner),
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            match (HashMap::get(&it.ref_info, &n.name))
            {
                Some(r) :
                {
                    if (!r.exact || Vec::len(&n.args) != r.arity)
                    {
                        return any_part(it, ty, 2);
                    }
                    if (r.own)
                    {
                        return true;
                    }
                    for (usize k = 0; k < Vec::len(&r.params); k += 1)
                    {
                        if (holds_ref(it, &n.args[r.params[k]]))
                        {
                            return true;
                        }
                    }
                    false
                },
                None    : false,
            }
        },
        _               : false,
    }
}

// D-0218: whether a value of `ty` holds an exclusive reference or slice in
// itself.
fn holds_excl_ref(ref<Items, shared> it, ref<Type, shared> ty, u32 depth) : bool
{
    if (depth > 32)
    {
        return false;
    }
    match (ty)
    {
        Type::TRef(b)   : Box::get(b).mode == Mode::Exclusive,
        Type::TSlice(b) : Box::get(b).mode == Mode::Exclusive,
        Type::TArray(b) : holds_excl_ref(it, &Box::get(b).inner, depth + 1),
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        if (holds_excl_ref(it, &apply_subst(&s.fields[i].ty, &subst), depth + 1))
                        {
                            return true;
                        }
                    }
                    return false;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) :
                            {
                                if (holds_excl_ref(it, &apply_subst(p, &subst), depth + 1))
                                {
                                    return true;
                                }
                            },
                            None    : {},
                        }
                    }
                    false
                },
                None    : false,
            }
        },
        _               : false,
    }
}

// D-0111, D-0133 `[Ref-Binding-Last-Use]`: a local of this type may end
// after its last use.
export fn ends_at_last_use(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(_)     : return true,
        Type::TSlice(_)   : return true,
        Type::TRawptr(_)  : return false,
        Type::TFn(_)      : return false,
        Type::TClosure(_) : return false,
        _                 : {},
    }
    if (named_is(t, "std::StringView"))
    {
        return true;
    }
    may_hold_ref(it, t, 0) && !is_resource_ty(it, t) && !contains_fn(it, t)
}

// D-0204: whether a value of `t` may hold an exclusive reference through
// which its holder could change data that is not its own.
export fn may_hold_excl_ref(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    excl_ref_in(it, t, 0)
}

fn excl_ref_in(ref<Items, shared> it, ref<Type, shared> t, usize depth) : bool
{
    if (depth > 16)
    {
        return true;
    }
    match (t)
    {
        Type::TRef(b)     : Box::get(b).mode == Mode::Exclusive,
        Type::TSlice(b)   : Box::get(b).mode == Mode::Exclusive,
        Type::TClosure(_) : true,
        Type::TArray(b)   : excl_ref_in(it, &Box::get(b).inner, depth + 1),
        Type::TRawptr(b)  : excl_ref_in(it, Box::get(b), depth + 1),
        Type::THandle(b)  : excl_ref_in(it, Box::get(b), depth + 1),
        Type::TMutex(b)   : excl_ref_in(it, Box::get(b), depth + 1),
        Type::TGuard(b)   : excl_ref_in(it, Box::get(b), depth + 1),
        Type::TNamed(b)   :
        {
            ref<NamedTy, shared> n = Box::get(b);
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (excl_ref_in(it, &n.args[i], depth + 1))
                {
                    return true;
                }
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        if (excl_ref_in(it, &apply_subst(&s.fields[i].ty, &subst), depth + 1))
                        {
                            return true;
                        }
                    }
                    return false;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) :
                            {
                                if (excl_ref_in(it, &apply_subst(p, &subst), depth + 1))
                                {
                                    return true;
                                }
                            },
                            None    : {},
                        }
                    }
                    false
                },
                None    : false,
            }
        },
        _                 : false,
    }
}

fn may_hold_ref(ref<Items, shared> it, ref<Type, shared> t, usize depth) : bool
{
    if (depth > 16)
    {
        return true;
    }
    match (t)
    {
        Type::TRef(_)     : true,
        Type::TSlice(_)   : true,
        Type::TFn(_)      : true,
        Type::TClosure(_) : true,
        Type::TArray(b)   : may_hold_ref(it, &Box::get(b).inner, depth + 1),
        Type::TRawptr(b)  : may_hold_ref(it, Box::get(b), depth + 1),
        Type::THandle(b)  : may_hold_ref(it, Box::get(b), depth + 1),
        Type::TMutex(b)   : may_hold_ref(it, Box::get(b), depth + 1),
        Type::TGuard(b)   : may_hold_ref(it, Box::get(b), depth + 1),
        Type::TNamed(b)   :
        {
            if (holds_ref(it, t))
            {
                return true;
            }
            ref<NamedTy, shared> n = Box::get(b);
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (may_hold_ref(it, &n.args[i], depth + 1))
                {
                    return true;
                }
            }
            false
        },
        _                 : false,
    }
}

// D-0109: shared if either is.
fn weaker_mode(Option<Mode> a, Mode b) : Mode
{
    if (let_shared(a) || b == Mode::Shared) { Mode::Shared } else { Mode::Exclusive }
}

fn let_shared(Option<Mode> a) : bool
{
    match (a)
    {
        Some(m) : m == Mode::Shared,
        None    : false,
    }
}

// ---- part 3: typecheck.rs lines 1622-2400 ----

fn bound_rank(Bound b) : u8
{
    match (b)
    {
        Bound::BEq      : 0,
        Bound::BOrdered : 1,
        Bound::BNumber  : 2,
        Bound::BInteger : 3,
        Bound::BClone   : 0,
        Bound::BPlain   : 0,
    }
}

// `Bound::implies`: every type satisfying `a` satisfies `other`.
fn bound_implies(Bound a, Bound other) : bool
{
    if (other == Bound::BClone)
    {
        return true;
    }
    if (a == Bound::BPlain || other == Bound::BPlain)
    {
        return a == other;
    }
    if (a == Bound::BClone)
    {
        return false;
    }
    bound_rank(a) >= bound_rank(other)
}

// `Bound::holds_for`: whether a concrete type satisfies the bound, from
// the type alone.
fn bound_holds_for(Bound b, ref<Type, shared> t) : bool
{
    if (b == Bound::BClone)
    {
        return match (t)
        {
            Type::TInt(_)    : true,
            Type::TF32       : true,
            Type::TF64       : true,
            Type::TBool      : true,
            Type::TStr       : true,
            Type::TRef(_)    : true,
            Type::TRawptr(_) : true,
            Type::TSlice(_)  : true,
            _                : is_std_string(t),
        };
    }
    if (b == Bound::BPlain)
    {
        return match (t)
        {
            Type::TInt(_)    : true,
            Type::TF32       : true,
            Type::TF64       : true,
            Type::TBool      : true,
            Type::TRawptr(_) : true,
            Type::TSimd(_)   : true,
            _                : false,
        };
    }
    match (t)
    {
        Type::TInt(_) : true,
        Type::TF32    : b != Bound::BInteger,
        Type::TF64    : b != Bound::BInteger,
        Type::TBool   : b == Bound::BEq || b == Bound::BOrdered,
        Type::TStr    : b == Bound::BEq || b == Bound::BOrdered,
        _             : is_std_string(t) && (b == Bound::BEq || b == Bound::BOrdered),
    }
}

fn marker_of(ref<Type, shared> t) : Option<String>
{
    match (t)
    {
        Type::TNamed(b) : Some(String::clone(&Box::get(b).name)),
        _               : None,
    }
}

// D-0090: an operator on a type parameter's value (one operand a marker):
// allowed when its bound provides it.
fn check_bounded_binary(
    ref<Body, exclusive> b,
    BinOp op,
    ref<Option<Type>, shared> at,
    ref<Option<Type>, shared> bt,
) : Result<Option<Type>, String>
{
    Type m = match (at)
    {
        Some(a) :
        {
            if (is_marker(a))
            {
                clone(a)
            }
            else
            {
                match (bt)
                {
                    Some(x) : clone(x),
                    None    : return Err(unbounded_msg("an operator")),
                }
            }
        },
        None : match (bt)
        {
            Some(x) : clone(x),
            None    : return Err(unbounded_msg("an operator")),
        },
    };
    String mn = match (marker_of(&m))
    {
        Some(n) : n,
        None    : return Err(unbounded_msg("an operator")),
    };
    Bound need = Bound::BEq;
    if (op == BinOp::Eq || op == BinOp::Ne)
    {
        need = Bound::BEq;
    }
    else if (op == BinOp::Lt || op == BinOp::Le || op == BinOp::Gt || op == BinOp::Ge)
    {
        need = Bound::BOrdered;
    }
    else if (op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul || op == BinOp::Div || op == BinOp::Rem)
    {
        need = Bound::BNumber;
    }
    else if (op == BinOp::BitAnd || op == BinOp::BitOr || op == BinOp::BitXor || op == BinOp::Shl || op == BinOp::Shr)
    {
        need = Bound::BInteger;
    }
    else
    {
        return Err(unbounded_msg("a logical operator"));
    }
    str sym = op_symbol(op);
    bool has = match (HashMap::get(&b.marker_bounds, &mn))
    {
        Some(have) : bound_implies(*have, need),
        None       : false,
    };
    if (!has)
    {
        return Err(bound_msg(b, &mn, sym, need));
    }
    // Both operands of the parameter's type (a shift's amount a `u32`).
    bool same_a = match (at)
    {
        Some(t) : type_eq(t, &m),
        None    : true,
    };
    bool ok = if (op == BinOp::Shl || op == BinOp::Shr)
    {
        same_a && match (bt)
        {
            Some(t) : type_eq(t, &Type::TInt(IntTy::U32)),
            None    : true,
        }
    }
    else
    {
        same_a && match (bt)
        {
            Some(t) : type_eq(t, &m),
            None    : true,
        }
    };
    if (!ok)
    {
        String sa = match (at)
        {
            Some(t) : type_display(t),
            None    : String::from_str("?"),
        };
        String sb = match (bt)
        {
            Some(t) : type_display(t),
            None    : String::from_str("?"),
        };
        return Err(mismatch(sprintf(
            "the operands of `%s` are `%s` and `%s`; both must be the type parameter's type",
            sym,
            &sa,
            &sb,
        )));
    }
    if (op == BinOp::Eq || op == BinOp::Ne || op == BinOp::Lt || op == BinOp::Le || op == BinOp::Gt || op == BinOp::Ge)
    {
        return Ok(Some(Type::TBool));
    }
    Ok(Some(m))
}

// D-0271: whether the concrete type `t` satisfies `bd`.
fn bound_holds(ref<Body, shared> b, ref<Items, shared> it, Bound bd, ref<Type, shared> t) : bool
{
    bound_holds_for(bd, t) || ((bd == Bound::BEq || bd == Bound::BOrdered) && named_key_type(it, t))
}

// D-0271: a place of a struct or enum key type that holds a `String`.
fn is_resource_key_place(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    match (static_place_type(b, it, e))
    {
        Some(t) : named_key_type(it, &t) && is_resource_ty(it, &t),
        None    : false,
    }
}

// A struct or enum key type (not `String`).
fn named_key_type(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(_) : !is_std_string(t) && is_key_type(it, t),
        _               : false,
    }
}

fn bound_msg(ref<Body, shared> b, ref<String, shared> marker, str sym, Bound need) : String
{
    StringView n = StringView::sub(String::as_view(marker), 1, String::len(marker));
    match (HashMap::get(&b.marker_bounds, marker))
    {
        Some(have) :
        {
            String msg = sprintf(
                "`%s` on a `%s` needs `%s: %s`, but `%s` is declared `%s`",
                sym,
                n,
                n,
                bound_name(need),
                n,
                bound_name(*have),
            );
            named_diag("diag.unbounded-type-parameter", &msg)
        },
        None       :
        {
            String msg = sprintf(
                "`%s` on a `%s` needs a bound: declare `<%s: %s>` (D-0090), or pass the operation in as a `fn` parameter",
                sym,
                n,
                n,
                bound_name(need),
            );
            named_diag("diag.unbounded-type-parameter", &msg)
        },
    }
}

fn record_instantiation(ref<Body, exclusive> b, ref<String, shared> name, ref<Vec<Type>, shared> targs)
{
    for (usize i = 0; i < Vec::len(targs); i += 1)
    {
        if (has_unresolved_marker(&targs[i]))
        {
            return;
        }
    }
    Vec::push(&mut b.new_instantiations, work(name, clone(targs)));
}

// The key of the function a callee path names, when it names one.
fn resolve_fn_path(ref<Items, shared> it, ref<Expr, shared> callee) : Option<String>
{
    match (&callee.kind)
    {
        ExprKind::EPath(p) :
        {
            String name = String::join(&Box::get(p).segs[0..$], "::");
            if (HashMap::contains(&it.fns, &name))
            {
                return Some(name);
            }
            None
        },
        _                  : None,
    }
}

// ---- rule.control.flow-analysis: scopes, places, discharge ----

// A flow-analysis refutation, suppressed while a loop body is iterated to
// its fixed point and at an unreachable point.
fn refute(ref<Body, shared> b, ref<String, shared> diag) : Result<void, String>
{
    if (b.report && !b.flow.unreachable)
    {
        return Err(String::clone(diag));
    }
    Ok(())
}

fn declare(ref<Body, exclusive> b, ref<String, shared> name, bool initialized)
{
    ScopeEntry entry = ScopeEntry {
        .name = String::clone(name),
        .flow = if (flow_is_tracked(&b.flow, name)) { Some(flow_save(&b.flow, name)) } else { None },
        .decl_block = match (HashMap::get(&b.decl_block, name))
    {
        Some(x) : Some(*x),
        None    : None,
    },
        .ref_origin = match (HashMap::get(&b.ref_origin, name))
    {
        Some(o) : Some(clone(o)),
        None    : None,
    },
    };
    flow_declare(&mut b.flow, name, initialized);
    HashSet::remove(&mut b.holders, name);
    usize n = Vec::len(&b.block_stack);
    usize here = if (n > 0) { b.block_stack[n - 1] } else { 0 };
    HashMap::insert(&mut b.decl_block, String::clone(name), here);
    HashMap::remove(&mut b.ref_origin, name);
    usize ns = Vec::len(&b.scopes);
    if (ns > 0)
    {
        Vec::push(&mut b.scopes[ns - 1], entry);
    }
}

fn enter_scope(ref<Body, exclusive> b)
{
    usize id = b.next_block;
    b.next_block += 1;
    usize n = Vec::len(&b.block_stack);
    if (n > 0)
    {
        HashMap::insert(&mut b.block_parent, id, b.block_stack[n - 1]);
    }
    Vec::push(&mut b.block_stack, id);
    Vec::push(&mut b.scopes, Vec::new());
}

// `[Block-Exit]`'s transfer: every binding the block declared ends.
fn exit_scope(ref<Body, exclusive> b)
{
    Vec<ScopeEntry> sc = Option::unwrap_or(Vec::pop(&mut b.scopes), Vec::new());
    Vec::pop(&mut b.block_stack);
    while (true)
    {
        ScopeEntry e = match (Vec::pop(&mut sc))
        {
            Some(e) : e,
            None    : break,
        };
        ScopeEntry { name, flow, decl_block, ref_origin } = e;
        HashMap::remove(&mut b.closure_arity, &name);
        hand_over_referent(b, &name);
        flow_remove(&mut b.flow, &name);
        HashMap::remove(&mut b.decl_block, &name);
        HashMap::remove(&mut b.ref_origin, &name);
        match (flow)
        {
            Some(f) : flow_restore(&mut b.flow, &name, f),
            None    : {},
        }
        match (decl_block)
        {
            Some(d) :
            {
                HashMap::insert(&mut b.decl_block, String::clone(&name), d);
            },
            None    : {},
        }
        match (ref_origin)
        {
            Some(o) :
            {
                HashMap::insert(&mut b.ref_origin, String::clone(&name), o);
            },
            None    : {},
        }
    }
}

// The function body block: its trailing expression is the function's
// result, which escapes to the caller.
fn check_fn_body(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    ref<Type, shared> ret,
) : Result<Option<Type>, String>
{
    usize gamma_mark = Vec::len(&b.gamma_log);
    enter_scope(b);
    Option<Type> last_stmt_ty = None;
    Result<Option<Type>, String> r = Ok(None);
    match (check_block_stmts(b, it, blk))
    {
        Ok(t)  : last_stmt_ty = t,
        Err(e) : r = Err(e),
    }
    if (Result::is_ok(&r))
    {
        r = match (&blk.tail)
        {
            Some(eb) :
            {
                ref<Expr, shared> e = Box::get(eb);
                match (check_escape_to_caller(b, it, e))
                {
                    Err(d) : Err(sprintf("%s%s", &d, &diag_at(e.line, e.col))),
                    Ok(_)  :
                    {
                        Option<Type> rt = Some(clone(ret));
                        bool ok = result_reach_ok(b, it, e, &rt);
                        bool saved_holding = replace(&mut b.holding, ok);
                        Result<Option<Type>, String> t = check_store_operand(b, it, e, &rt);
                        b.holding = saved_holding;
                        t
                    },
                }
            },
            None     :
            {
                bool nev = match (&last_stmt_ty)
                {
                    Some(Type::TNever) : true,
                    _                  : false,
                };
                Ok(Some(if (nev) { Type::TNever } else { Type::TVoid }))
            },
        };
    }
    exit_scope(b);
    gamma_undo(b, gamma_mark);
    r
}

// ---- rule.temporal.ref-escape (spec/10 §2, §3) ----

// Does block `outer` strictly lexically enclose block `inner`?
fn strictly_encloses(ref<Body, shared> b, usize outer, usize inner) : bool
{
    usize cur = inner;
    while (true)
    {
        match (HashMap::get(&b.block_parent, &cur))
        {
            Some(p) :
            {
                if (*p == outer)
                {
                    return true;
                }
                cur = *p;
            },
            None    : return false,
        }
    }
    false
}

fn referent(usize block, ref<String, shared> root) : Option<Referent>
{
    Some(Referent { .block = block, .root = String::clone(root) })
}

// `referent-block(e)` for a borrow expression, with the referent's root
// binding; `None` = unknown.
fn referent_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Referent>
{
    match (HashMap::get(&b.borrow_referents, &e.id))
    {
        Some(r) : return clone(r),
        None    : {},
    }
    match (&e.kind)
    {
        ExprKind::EParen(x)   : referent_of(b, it, Box::get(x)),
        ExprKind::EBorrow(x)  : referent_of_place(b, it, &Box::get(x).e),
        ExprKind::ESliceOf(x) : referent_of_place(b, it, &Box::get(x).base),
        ExprKind::ECall(cb)   :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            String key = match (resolve_fn_path(it, &c.callee))
            {
                Some(k) : k,
                None    : return None,
            };
            ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &key), "a function");
            Vec<usize> ref_positions = Vec::new();
            for (usize i = 0; i < Vec::len(&f.params); i += 1)
            {
                if (is_borrow_ty(&f.params[i].ty))
                {
                    Vec::push(&mut ref_positions, i);
                }
            }
            if (Vec::len(&ref_positions) != 1 || !is_borrow_ty(&f.ret))
            {
                return None;
            }
            if (ref_positions[0] >= Vec::len(&c.args))
            {
                return None;
            }
            ref<Expr, shared> arg = &c.args[ref_positions[0]];
            match (&arg.kind)
            {
                ExprKind::EBorrow(_)  : referent_of(b, it, arg),
                ExprKind::ESliceOf(_) : referent_of(b, it, arg),
                ExprKind::EPath(p)    :
                {
                    ref<PathExpr, shared> px = Box::get(p);
                    if (Vec::len(&px.segs) != 1)
                    {
                        return None;
                    }
                    ref<String, shared> x = &px.segs[0];
                    bool borrow_local = match (HashMap::get(&b.gamma, x))
                    {
                        Some(t) : is_borrow_ty(t),
                        None    : false,
                    };
                    bool visible = match (HashMap::get(&b.ref_origin, x))
                    {
                        Some(o) : Option::is_some(o),
                        None    : false,
                    };
                    if (borrow_local && visible)
                    {
                        return match (HashMap::get(&b.decl_block, x))
                        {
                            Some(db) : referent(*db, x),
                            None     : None,
                        };
                    }
                    None
                },
                _                     : None,
            }
        },
        _                     : None,
    }
}

fn origin_of(ref<Body, shared> b, ref<String, shared> x) : Option<Referent>
{
    match (HashMap::get(&b.ref_origin, x))
    {
        Some(o) : clone(o),
        None    : None,
    }
}

fn referent_of_place(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Referent>
{
    match (&e.kind)
    {
        ExprKind::EParen(x)  : referent_of_place(b, it, Box::get(x)),
        ExprKind::EField(x)  : referent_of_place(b, it, &Box::get(x).e),
        ExprKind::EIndex(x)  : referent_of_place(b, it, &Box::get(x).a),
        ExprKind::EDeref(xb) :
        {
            ref<Expr, shared> inner = Box::get(xb);
            match (&inner.kind)
            {
                ExprKind::EPath(p)  :
                {
                    if (Vec::len(&Box::get(p).segs) == 1)
                    {
                        return origin_of(b, &Box::get(p).segs[0]);
                    }
                    None
                },
                ExprKind::EParen(p) :
                {
                    Expr d = mk(ExprKind::EDeref(Box::new(clone(Box::get(p)))), e.line, e.col);
                    referent_of_place(b, it, &d)
                },
                _                   : None,
            }
        },
        ExprKind::EPath(p)   :
        {
            ref<PathExpr, shared> px = Box::get(p);
            if (Vec::len(&px.segs) != 1)
            {
                return None;
            }
            ref<String, shared> x = &px.segs[0];
            match (HashMap::get(&b.gamma, x))
            {
                Some(t) :
                {
                    if (is_borrow_ty(t))
                    {
                        return origin_of(b, x);
                    }
                    match (HashMap::get(&b.decl_block, x))
                    {
                        Some(db) : referent(*db, x),
                        None     : None,
                    }
                },
                None    : None,
            }
        },
        _                    : None,
    }
}

// A stored borrow: its referent block and root, and whether a closure
// holds it.
struct StoredBorrow
{
    usize block;
    String root;
    bool closure;
}

// The referents of the references `e` stores.
fn collect_stored_borrows(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Vec<StoredBorrow>, exclusive> out,
)
{
    match (&e.kind)
    {
        ExprKind::EBorrow(_)      : push_referent(b, it, e, out),
        ExprKind::ESliceOf(_)     : push_referent(b, it, e, out),
        ExprKind::EClosure(cb)    :
        {
            ref<ClosureExpr, shared> c = Box::get(cb);
            if (!c.is_move)
            {
                for (usize i = 0; i < Vec::len(&c.captures); i += 1)
                {
                    ref<String, shared> name = &c.captures[i];
                    bool owned = match (HashMap::get(&b.gamma, name))
                    {
                        Some(t) : !is_borrow_ty(t),
                        None    : false,
                    };
                    if (owned)
                    {
                        match (HashMap::get(&b.decl_block, name))
                        {
                            Some(db) : Vec::push(
                                out,
                                StoredBorrow { .block = *db, .root = String::clone(name), .closure = true },
                            ),
                            None : {},
                        }
                    }
                }
            }
        },
        ExprKind::EParen(x)       : collect_stored_borrows(b, it, Box::get(x), out),
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            match (&c.callee.kind)
            {
                ExprKind::EPath(p) :
                {
                    ref<Vec<String>, shared> segs = &Box::get(p).segs;
                    usize n = Vec::len(segs);
                    if (Vec::len(&c.args) == 1 && n > 0 && HashMap::contains(
                        &it.enum_of_variant,
                        &segs[n - 1],
                    ) && !HashMap::contains(&it.fns, &String::join(&segs[0..$], "::")))
                    {
                        collect_stored_borrows(b, it, &c.args[0], out);
                        return;
                    }
                },
                _                  : {},
            }
            push_referent(b, it, e, out);
        },
        ExprKind::EStructLit(sb)  :
        {
            ref<StructLitExpr, shared> s = Box::get(sb);
            for (usize i = 0; i < Vec::len(&s.fields); i += 1)
            {
                collect_stored_borrows(b, it, &s.fields[i].value, out);
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            for (usize i = 0; i < Vec::len(es); i += 1)
            {
                collect_stored_borrows(b, it, &es[i], out);
            }
        },
        ExprKind::EArrayRepeat(r) : collect_stored_borrows(b, it, &Box::get(r).value, out),
        ExprKind::EBlock(blk)     : tail_stored_borrows(b, it, blk, out),
        ExprKind::EUnsafe(blk)    : tail_stored_borrows(b, it, blk, out),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            tail_stored_borrows(b, it, &x.then_, out);
            match (&x.else_)
            {
                Some(el) : collect_stored_borrows(b, it, el, out),
                None     : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> x = Box::get(mb);
            for (usize i = 0; i < Vec::len(&x.arms); i += 1)
            {
                collect_stored_borrows(b, it, Box::get(&x.arms[i].body), out);
            }
        },
        _                         : {},
    }
}

fn push_referent(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e, ref<Vec<StoredBorrow>, exclusive> out)
{
    match (referent_of(b, it, e))
    {
        Some(r) :
        {
            Referent { block, root, .. } = r;
            Vec::push(out, StoredBorrow { .block = block, .root = root, .closure = false });
        },
        None    : {},
    }
}

fn tail_stored_borrows(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    ref<Vec<StoredBorrow>, exclusive> out,
)
{
    match (&blk.tail)
    {
        Some(t) : collect_stored_borrows(b, it, Box::get(t), out),
        None    : {},
    }
}

// `[Ref-Escape-Rejected]`, a store into a binding whose decl-block is
// `dest`.
fn check_escape_into(ref<Body, shared> b, ref<Items, shared> it, usize dest, ref<Expr, shared> e) : Result<void, String>
{
    Vec<StoredBorrow> bs = Vec::new();
    collect_stored_borrows(b, it, e, &mut bs);
    for (usize i = 0; i < Vec::len(&bs); i += 1)
    {
        if (strictly_encloses(b, dest, bs[i].block))
        {
            String msg = if (bs[i].closure)
            {
                sprintf(
                    "this stores a closure that borrows `%s` in a place that outlives it; capture by value with `move [...]`, or keep the closure inside that block",
                    shown_name(String::as_view(&bs[i].root)),
                )
            }
            else
            {
                String::from_str("this stores a reference in a place that outlives what it refers to, which ends with its own block; store an owned value instead, or keep the reference inside that block")
            };
            return Err(named_diag("diag.reference-escapes-scope", &msg));
        }
    }
    Ok(())
}

// `[Ref-Escape-Rejected]`, the function's result: rejected when the
// referent's root binding is not a reference-typed parameter.
fn check_escape_to_caller(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Result<void, String>
{
    Vec<StoredBorrow> bs = Vec::new();
    collect_stored_borrows(b, it, e, &mut bs);
    for (usize i = 0; i < Vec::len(&bs); i += 1)
    {
        ref<String, shared> root = &bs[i].root;
        bool ref_param = HashSet::contains(&b.params, root) && match (HashMap::get(&b.gamma, root))
        {
            Some(t) : is_borrow_ty(t),
            None    : false,
        };
        if (!ref_param)
        {
            String msg = if (bs[i].closure)
            {
                sprintf(
                    "the returned closure borrows `%s`, which ends when this function returns; capture it by value with `move [...]`",
                    shown_name(String::as_view(root)),
                )
            }
            else
            {
                sprintf(
                    "the result refers to `%s`, which ends when this function returns; a returned reference must come from a reference parameter -- return an owned value instead",
                    shown_name(String::as_view(root)),
                )
            };
            return Err(named_diag("diag.reference-escapes-scope", &msg));
        }
    }
    Ok(())
}

// A place: its root binding and its path.
struct Place
{
    String root;
    Vec<PElem> path;
}

fn is_named_ty(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(_) : true,
        _               : false,
    }
}

fn is_array_or_simd(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TArray(_) : true,
        Type::TSimd(_)  : true,
        _               : false,
    }
}

fn literal_index(ref<Expr, shared> idx) : Option<u128>
{
    match (literal_value(idx))
    {
        Some(v) : if (v >= 0) { Some(reinterpret<u128>(v)) } else { None },
        None    : None,
    }
}

fn single_tracked(ref<Body, shared> b, ref<Expr, shared> e) : Option<String>
{
    match (&e.kind)
    {
        ExprKind::EPath(p) :
        {
            ref<PathExpr, shared> x = Box::get(p);
            if (Vec::len(&x.segs) == 1 && flow_is_tracked(&b.flow, &x.segs[0]))
            {
                return Some(String::clone(&x.segs[0]));
            }
            None
        },
        _                  : None,
    }
}

// The syntactic place `x.π` an expression denotes, when its root is a
// tracked binding reached without crossing a reference.
fn place_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Place>
{
    match (&e.kind)
    {
        ExprKind::EParen(x)  : place_of(b, it, Box::get(x)),
        ExprKind::EPath(_) : match (single_tracked(b, e))
        {
            Some(x) : Some(Place { .root = x, .path = Vec::new() }),
            None    : None,
        },
        ExprKind::EField(fb) :
        {
            ref<FieldExpr, shared> f = Box::get(fb);
            Place p = place_of(b, it, &f.e)?;
            Type t = place_type(b, it, &p.root, &p.path)?;
            if (!is_named_ty(&t))
            {
                return None;
            }
            Vec::push(&mut p.path, PElem::PField(String::clone(&f.name)));
            Some(p)
        },
        ExprKind::EIndex(ib) :
        {
            ref<PairExpr, shared> x = Box::get(ib);
            Place p = place_of(b, it, &x.a)?;
            Type t = place_type(b, it, &p.root, &p.path)?;
            if (!is_array_or_simd(&t))
            {
                return None;
            }
            Vec::push(&mut p.path, PElem::PIndex(literal_index(&x.b)));
            Some(p)
        },
        _                    : None,
    }
}

fn is_ref_or_guard(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(_)   : true,
        Type::TGuard(_) : true,
        _               : false,
    }
}

// The root `*r` for a tracked reference or guard binding `r`.
fn deref_root(ref<Body, shared> b, ref<Expr, shared> base) : Option<Place>
{
    String x = single_tracked(b, strip_parens_tc(base))?;
    Type t = lookup_local(b, &x)?;
    if (is_ref_or_guard(&t))
    {
        return Some(Place { .root = referent_root(String::as_view(&x)), .path = Vec::new() });
    }
    None
}

fn deref_through(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> base) : Option<Place>
{
    match (deref_place_of(b, it, base))
    {
        Some(p) : return Some(p),
        None    : {},
    }
    deref_root(b, base)
}

// D-0071: a place reached through a tracked reference or guard binding
// `r`, as a path from the root `*r`.
fn deref_place_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Place>
{
    match (&e.kind)
    {
        ExprKind::EParen(x)  : deref_place_of(b, it, Box::get(x)),
        ExprKind::EDeref(x)  : deref_root(b, Box::get(x)),
        ExprKind::EField(fb) :
        {
            ref<FieldExpr, shared> f = Box::get(fb);
            Place p = deref_through(b, it, &f.e)?;
            Type t = place_type(b, it, &p.root, &p.path)?;
            if (!is_named_ty(&t))
            {
                return None;
            }
            Vec::push(&mut p.path, PElem::PField(String::clone(&f.name)));
            Some(p)
        },
        ExprKind::EIndex(ib) :
        {
            ref<PairExpr, shared> x = Box::get(ib);
            Place p = deref_through(b, it, &x.a)?;
            Type t = place_type(b, it, &p.root, &p.path)?;
            if (!is_array_or_simd(&t))
            {
                return None;
            }
            Vec::push(&mut p.path, PElem::PIndex(literal_index(&x.b)));
            Some(p)
        },
        _                    : None,
    }
}

// A struct's field type, substituted.
fn field_type(
    ref<Items, shared> it,
    ref<String, shared> sname,
    ref<Vec<Type>, shared> args,
    ref<String, shared> fname,
) : Option<Type>
{
    ref<StructDecl, shared> sd = HashMap::get(&it.structs, sname)?;
    HashMap<String, Type> subst = zip_subst(&sd.type_params, args);
    for (usize i = 0; i < Vec::len(&sd.fields); i += 1)
    {
        if (String::eq(&sd.fields[i].name, fname))
        {
            return Some(apply_subst(&sd.fields[i].ty, &subst));
        }
    }
    None
}

// The static type at `x.π`, from `gamma` and the declarations.
fn place_type(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<String, shared> x,
    ref<Vec<PElem>, shared> path,
) : Option<Type>
{
    // The root's type is read in place; only what the path reaches is a copy.
    String deref_name = String::new();
    bool deref = match (String::strip_prefix(x, "*"))
    {
        Some(r) :
        {
            deref_name = String::from_view(r);
            true
        },
        None    : false,
    };
    ref<Type, shared> root = if (deref)
    {
        match (HashMap::get(&b.gamma, &deref_name)?)
        {
            Type::TRef(rb)   : &Box::get(rb).inner,
            Type::TGuard(gb) : Box::get(gb),
            _                : return None,
        }
    }
    else { HashMap::get(&b.gamma, x)? };
    if (Vec::len(path) == 0)
    {
        return Some(clone(root));
    }
    Type t = place_step(it, root, &path[0])?;
    for (usize i = 1; i < Vec::len(path); i += 1)
    {
        t = place_step(it, &t, &path[i])?;
    }
    Some(t)
}

// The type one step of a place's path reaches from `t`.
fn place_step(ref<Items, shared> it, ref<Type, shared> t, ref<PElem, shared> step) : Option<Type>
{
    match (step)
    {
        PElem::PField(f) : match (t)
        {
            Type::TNamed(nb) : field_type(it, &Box::get(nb).name, &Box::get(nb).args, f),
            _                : None,
        },
        PElem::PIndex(_) : match (t)
        {
            Type::TArray(ab) : Some(clone(&Box::get(ab).inner)),
            Type::TSimd(ab)  : Some(clone(&Box::get(ab).inner)),
            _                : None,
        },
        _ : None,
    }
}

fn through_ref_or_guard(Type t) : Type
{
    match (t)
    {
        Type::TRef(b)   : Box::into_inner(b).inner,
        Type::TGuard(b) : Box::into_inner(b),
        other           : other,
    }
}

// The static type of a place-shaped expression, computed without walking
// it.
fn static_place_type(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Type>
{
    match (&e.kind)
    {
        ExprKind::EParen(x)  : static_place_type(b, it, Box::get(x)),
        ExprKind::EPath(p)   :
        {
            if (Vec::len(&Box::get(p).segs) == 1)
            {
                return lookup_local(b, &Box::get(p).segs[0]);
            }
            None
        },
        ExprKind::EDeref(x)  :
        {
            match (static_place_type(b, it, Box::get(x))?)
            {
                Type::TRef(rb)    : Some(Box::into_inner(rb).inner),
                Type::TGuard(gb)  : Some(Box::into_inner(gb)),
                Type::TRawptr(pb) : Some(Box::into_inner(pb)),
                _                 : None,
            }
        },
        ExprKind::EField(fb) :
        {
            ref<FieldExpr, shared> f = Box::get(fb);
            Type bt = through_ref_or_guard(static_place_type(b, it, &f.e)?);
            match (&bt)
            {
                Type::TNamed(nb) : field_type(it, &Box::get(nb).name, &Box::get(nb).args, &f.name),
                _                : None,
            }
        },
        ExprKind::EIndex(ib) :
        {
            Type bt = through_ref_or_guard(static_place_type(b, it, &Box::get(ib).a)?);
            bool is_array = match (&bt)
            {
                Type::TArray(_) : true,
                _               : false,
            };
            if (!is_array)
            {
                match (indexed_elem(&bt))
                {
                    Some(t) : return Some(t),
                    None    : {},
                }
            }
            match (bt)
            {
                Type::TArray(ab) : Some(Box::into_inner(ab).inner),
                Type::TSimd(ab)  : Some(Box::into_inner(ab).inner),
                _                : None,
            }
        },
        ExprKind::ECall(cb)  :
        {
            String key = resolve_fn_path(it, &Box::get(cb).callee)?;
            ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &key), "a function");
            if (Vec::len(&f.type_params) == 0)
            {
                return Some(clone(&f.ret));
            }
            match (&f.ret)
            {
                // A generic call's reference result, its type arguments read
                // off its arguments' shapes, so a field or element through it
                // is a place (`Box::get(p).segs[0]`); where they stay unknown
                // only its mode is ever consulted.
                Type::TRef(_) :
                {
                    HashMap<String, Type> m = HashMap::new();
                    ref<Vec<Expr>, shared> args = &Box::get(cb).args;
                    for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(args); i += 1)
                    {
                        Option<Type> shape = match (&strip_parens_tc(&args[i]).kind)
                        {
                            ExprKind::EBorrow(bb) : match (static_place_type(b, it, &Box::get(bb).e))
                            {
                                Some(t) : Some(Type::TRef(Box::new(ModedTy { .inner = t, .mode = Box::get(bb).mode }))),
                                None    : None,
                            },
                            _ : static_place_type(b, it, &args[i]),
                        };
                        match (&shape)
                        {
                            Some(t) : unify_type_shape(&f.params[i].ty, t, &mut m, &f.type_params),
                            None    : {},
                        }
                    }
                    Some(apply_subst(&f.ret, &m))
                },
                _             : None,
            }
        },
        _                    : None,
    }
}

// D-0053: whether `&base[..]` makes a `StringView`: `Some(true)` for a
// `String`, `Some(false)` for a `StringView`.
fn view_base(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> base) : Option<bool>
{
    Type t = static_place_type(b, it, base)?;
    Type u = match (t)
    {
        Type::TRef(rb) : Box::into_inner(rb).inner,
        other          : other,
    };
    if (named_is(&u, "std::String"))
    {
        return Some(true);
    }
    if (named_is(&u, "std::StringView"))
    {
        return Some(false);
    }
    None
}

fn ref_mode_of(ref<Option<Type>, shared> t) : Option<Mode>
{
    match (t)
    {
        Some(Type::TRef(rb)) : Some(Box::get(rb).mode),
        _                    : None,
    }
}

// Does evaluating `e` as a place cross a `ref<_, shared>`?
fn crosses_shared(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EParen(x)  : crosses_shared(b, it, Box::get(x)),
        ExprKind::EDeref(x)  :
        {
            Option<Type> t = static_place_type(b, it, Box::get(x));
            match (ref_mode_of(&t))
            {
                Some(Mode::Shared)    : true,
                Some(Mode::Exclusive) : crosses_shared(b, it, Box::get(x)),
                None                  : false,
            }
        },
        ExprKind::EField(fb) : base_crosses(b, it, &Box::get(fb).e),
        ExprKind::EIndex(ib) : base_crosses(b, it, &Box::get(ib).a),
        _                    : false,
    }
}

fn base_crosses(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> base) : bool
{
    bool shared_ref = match (static_place_type(b, it, base))
    {
        Some(Type::TRef(rb))   : Box::get(&rb).mode == Mode::Shared,
        Some(Type::TSlice(sb)) : Box::get(&sb).mode == Mode::Shared,
        _                      : false,
    };
    shared_ref || crosses_shared(b, it, base)
}

fn place_is_resource(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<String, shared> x,
    ref<Vec<PElem>, shared> path,
) : bool
{
    match (place_type(b, it, x, path))
    {
        Some(t) : is_resource_ty(it, &t),
        None    : false,
    }
}

// `¬clash(a, m)` for an access at place `x.π`.
fn flow_clash(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> x,
    ref<Vec<PElem>, shared> path,
    Mode mode,
    str diag,
) : Result<void, String>
{
    flow_clash_saying(b, it, x, path, mode, diag, None)
}

fn permitted(Mode m1, Mode m2) : bool
{
    m1 == Mode::Shared && m2 == Mode::Shared
}

// `flow_clash`, the message naming the access (`need`) when it is not a
// plain read, write or borrow.
fn flow_clash_saying(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> x,
    ref<Vec<PElem>, shared> path,
    Mode mode,
    str diag,
    Option<str> need,
) : Result<void, String>
{
    flow_clash_report(b, it, x, path, mode);
    Option<String> best = None;
    Mode best_mode = Mode::Shared;
    for (usize i = 0; i < HashMap::len(&b.flow.deriv); i += 1)
    {
        ref<String, shared> h = HashMap::key_at(&b.flow.deriv, i);
        ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&b.flow.deriv, i);
        for (usize k = 0; k < HashMap::len(facts); k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            if (d.v == Tri::T && String::eq(
                &d.key.root,
                x,
            ) && paths_overlap(&d.key.path, path) && !permitted(mode, d.key.mode))
            {
                bool better = match (&best)
                {
                    Some(bh) : String::less(h, bh),
                    None     : true,
                };
                if (better)
                {
                    best = Some(String::clone(h));
                    best_mode = d.key.mode;
                }
            }
        }
    }
    // The first holder by name, so the message is the same every run.
    match (best)
    {
        Some(h) :
        {
            String need_text = match (need)
            {
                Some(n) : String::from_str(n),
                None    :
                {
                    if (StringView::eq_str(StringView::of(diag), "diag.aliasing-conflict") && mode == Mode::Exclusive)
                    {
                        String::from_str("so it cannot be written or borrowed `mut` here")
                    }
                    else if (StringView::eq_str(StringView::of(diag), "diag.aliasing-conflict"))
                    {
                        String::from_str("so it cannot be read here")
                    }
                    else
                    {
                        String::from_str("so it cannot be moved or destroyed here")
                    }
                },
            };
            bool excl = best_mode == Mode::Exclusive;
            StringView xs = shown_name(String::as_view(x));
            String who = if (is_loop_holder(String::as_view(&h)))
            {
                if (excl)
                {
                    sprintf(
                        "the `foreach` loop over `%s` borrows it exclusively",
                        xs,
                    )
                }
                else { sprintf("the `foreach` loop over `%s` still borrows it", xs) }
            }
            else
            {
                if (excl)
                {
                    sprintf(
                        "%s borrows `%s` exclusively",
                        &holder_text(String::as_view(&h)),
                        xs,
                    )
                }
                else { sprintf("%s still borrows `%s`", &holder_text(String::as_view(&h)), xs) }
            };
            String msg = sprintf("%s, %s; end that borrow first", &who, &need_text);
            refute(b, &named_diag(diag, &msg))?;
        },
        None    : {},
    }
    Ok(())
}

// `solitary(a_x)`: refuted when some `deriv(·, x.·, ·) = T`.
fn flow_solitary(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> x, str diag) : Result<void, String>
{
    Option<String> best = None;
    for (usize i = 0; i < HashMap::len(&b.flow.deriv); i += 1)
    {
        ref<String, shared> h = HashMap::key_at(&b.flow.deriv, i);
        ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&b.flow.deriv, i);
        for (usize k = 0; k < HashMap::len(facts); k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            if (d.v == Tri::T && String::eq(&d.key.root, x))
            {
                bool better = match (&best)
                {
                    Some(bh) : String::less(h, bh),
                    None     : true,
                };
                if (better)
                {
                    best = Some(String::clone(h));
                }
            }
        }
    }
    // A reference that may reach it, on some paths: the run's.
    if (Option::is_none(&best) && b.report && !b.flow.unreachable)
    {
        Option<String> maybe = None;
        for (usize i = 0; i < HashMap::len(&b.flow.deriv) && Option::is_none(&maybe); i += 1)
        {
            ref<String, shared> h = HashMap::key_at(&b.flow.deriv, i);
            ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&b.flow.deriv, i);
            bool any = false;
            for (usize k = 0; k < HashMap::len(facts) && !any; k += 1)
            {
                ref<DerivFact, shared> d = HashMap::value_at(facts, k);
                any = d.v == Tri::U && String::eq(&d.key.root, x);
            }
            if (any && holder_live_after(b, it, h))
            {
                maybe = Some(String::clone(h));
            }
        }
        match (maybe)
        {
            Some(h) :
            {
                usize line = b.current_line;
                b.rep.checks += 1;
                b.rep.undecided += 1;
                Vec::push(&mut b.rep.events, sprintf("U\t%v\t%s\tmove\t%s\t%v", line, x, &h, line));
                rep_left(
                    b,
                    sprintf(
                        "line %v: a move of `%s` that a reference may reach on some paths",
                        line,
                        shown_name(String::as_view(x)),
                    ),
                );
            },
            None    : {},
        }
    }
    match (best)
    {
        Some(h) :
        {
            StringView xs = shown_name(String::as_view(x));
            String who = if (is_loop_holder(String::as_view(&h)))
            {
                sprintf(
                    "the `foreach` loop over `%s` still borrows it",
                    xs,
                )
            }
            else { sprintf("%s still borrows `%s`", &holder_text(String::as_view(&h)), xs) };
            String msg = sprintf("%s, so it cannot be moved or destroyed here; end that borrow first", &who);
            refute(b, &named_diag(diag, &msg))?;
        },
        None    : {},
    }
    Ok(())
}

// D-0282: `flow_clash`'s report: the check made, those a fact of `?`
// leaves undecided, and the places only values decide (a point check).
fn flow_clash_report(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> x,
    ref<Vec<PElem>, shared> path,
    Mode mode,
)
{
    if (!b.report || b.flow.unreachable)
    {
        return;
    }
    Vec<String> undecided = Vec::new();
    bool maybe = false;
    for (usize i = 0; i < HashMap::len(&b.flow.deriv); i += 1)
    {
        ref<String, shared> h = HashMap::key_at(&b.flow.deriv, i);
        ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&b.flow.deriv, i);
        Option<bool> live = None;
        for (usize k = 0; k < HashMap::len(facts); k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            if (d.v == Tri::F || !String::eq(&d.key.root, x) || permitted(mode, d.key.mode))
            {
                continue;
            }
            bool undec = d.v == Tri::U && paths_overlap(&d.key.path, path);
            bool mb = overlap3(&d.key.path, path) == Ov::OvMaybe;
            if (!undec && !mb)
            {
                continue;
            }
            bool is_live = match (live)
            {
                Some(l) : l,
                None    :
                {
                    bool l = holder_live_after(b, it, h);
                    live = Some(l);
                    l
                },
            };
            if (!is_live)
            {
                continue;
            }
            if (undec)
            {
                Vec::push(&mut undecided, sprintf("U\t%v\t%s\t%s\t%s", b.current_line, x, mode_debug(d.key.mode), h));
            }
            if (mb)
            {
                maybe = true;
            }
        }
    }
    Vec::sort(&mut undecided);
    usize line = b.current_line;
    if (maybe)
    {
        b.rep.point_checks += 1;
        Vec::push(&mut b.rep.events, sprintf("P\t%v\t%s\taccess", line, x));
        rep_left(
            b,
            sprintf("line %v: an access to `%s` that only values decide", line, shown_name(String::as_view(x))),
        );
    }
    b.rep.checks += 1;
    if (Vec::len(&undecided) > 0)
    {
        b.rep.undecided += 1;
        Vec::push(&mut b.rep.events, sprintf("%s\t%v", &undecided[0], line));
        rep_left(
            b,
            sprintf(
                "line %v: an access to `%s` that a reference may reach on some paths",
                line,
                shown_name(String::as_view(x)),
            ),
        );
    }
}

fn tri_is(ref<HashMap<String, Tri>, shared> m, ref<String, shared> x, Tri want) : bool
{
    match (HashMap::get(m, x))
    {
        Some(t) : *t == want,
        None    : false,
    }
}

// `[Read]` of a place in value position: definite assignment,
// `[Read-Resource-Rejected]`, and `¬clash(a, shared)`.
fn flow_read(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e) : Result<void, String>
{
    Place p = match (place_of(b, it, e))
    {
        Some(p) : p,
        None : match (deref_place_of(b, it, e))
        {
            Some(dp) : return flow_clash(b, it, &dp.root, &dp.path, Mode::Shared, "diag.aliasing-conflict"),
            None     :
            {
                holder_deref_access(b, it, e, Mode::Shared);
                return Ok(());
            },
        },
    };
    if (!tri_is(&b.flow.init, &p.root, Tri::T))
    {
        refute(b, &uninit_msg(String::as_view(&p.root)))?;
    }
    if (place_is_resource(b, it, &p.root, &p.path))
    {
        // A name the desugaring made is not the program's to see.
        String shown = if (String::starts_with(&p.root, "$"))
        {
            String::from_str("this value")
        }
        else if (Vec::len(&p.path) == 0)
        {
            sprintf("`%s`", &p.root)
        }
        else
        {
            sprintf("this part of `%s`", &p.root)
        };
        String msg = sprintf(
            "diag.read-of-resource\u{1}%s holds a resource, which is never copied: move it, lend it (`&`), or make a copy with its type's `clone`",
            &shown,
        );
        refute(b, &msg)?;
    }
    flow_clash(b, it, &p.root, &p.path, Mode::Shared, "diag.aliasing-conflict")
}

// `[Write]` to a place.
fn flow_write(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> lhs) : Result<void, String>
{
    match (place_of(b, it, lhs))
    {
        Some(p) :
        {
            HashMap::remove(&mut b.flow.lits, &p.root);
        },
        None    : {},
    }
    Place p = match (place_of(b, it, lhs))
    {
        Some(p) : p,
        None : match (deref_place_of(b, it, lhs))
        {
            Some(dp) :
            {
                // D-0095: a write through a valid exclusive reference
                // reaches a live object.
                if (deref_ref_valid(b, it, lhs))
                {
                    refute_live_part_overwrite(b, it, &dp.root, &dp.path, lhs)?;
                }
                return flow_clash(b, it, &dp.root, &dp.path, Mode::Exclusive, "diag.aliasing-conflict");
            },
            None     :
            {
                holder_deref_access(b, it, lhs, Mode::Exclusive);
                return Ok(());
            },
        },
    };
    Vec<PElem> none = Vec::new();
    if (Vec::len(&p.path) == 0)
    {
        // D-0049: statically only where every value of the type owns
        // something.
        bool owns = match (place_type(b, it, &p.root, &none))
        {
            Some(t) : always_owns(it, &t) && !quiet_ty(it, &t),
            None    : false,
        };
        if (place_is_resource(
            b,
            it,
            &p.root,
            &none,
        ) && owns && tri_is(&b.flow.valid, &p.root, Tri::T) && tri_is(&b.flow.init, &p.root, Tri::T))
        {
            String ty = match (place_type(b, it, &p.root, &none))
            {
                Some(t) : type_display(&t),
                None    : String::new(),
            };
            StringView shown = last_segment(String::as_view(&p.root));
            refute(
                b,
                &sprintf(
                    "diag.overwrite-of-live-resource\u{1}`%s` still holds a `%s`, which this assignment would lose",
                    shown,
                    &ty,
                ),
            )?;
        }
    }
    else if (!tri_is(&b.flow.init, &p.root, Tri::T))
    {
        refute(b, &uninit_msg(String::as_view(&p.root)))?;
    }
    else if (tri_is(&b.flow.valid, &p.root, Tri::T))
    {
        refute_live_part_overwrite(b, it, &p.root, &p.path, lhs)?;
    }
    flow_clash(b, it, &p.root, &p.path, Mode::Exclusive, "diag.aliasing-conflict")?;
    if (Vec::len(&p.path) == 0 && !b.flow.unreachable)
    {
        HashMap::insert(&mut b.flow.init, String::clone(&p.root), Tri::T);
    }
    Ok(())
}

// D-0095: `[Write-Resource-Overwrite-Rejected]` refuted statically for a
// part of a live object.
fn refute_live_part_overwrite(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> x,
    ref<Vec<PElem>, shared> path,
    ref<Expr, shared> lhs,
) : Result<void, String>
{
    for (usize i = 0; i < Vec::len(path); i += 1)
    {
        match (&path[i])
        {
            PElem::PField(_) : {},
            PElem::PIndex(ix) : match (ix)
            {
                Some(k) :
                {
                    Vec<PElem> prefix = Vec::new();
                    for (usize j = 0; j < i; j += 1)
                    {
                        Vec::push(&mut prefix, clone(&path[j]));
                    }
                    bool inside = match (place_type(b, it, x, &prefix))
                    {
                        Some(Type::TArray(ab)) : narrow_wrapping<u64>(*k) < narrow_wrapping<u64>(Box::get(&ab).n),
                        Some(Type::TSimd(ab))  : narrow_wrapping<u64>(*k) < narrow_wrapping<u64>(Box::get(&ab).n),
                        _                      : false,
                    };
                    if (!inside)
                    {
                        return Ok(());
                    }
                },
                None    : return Ok(()),
            },
            PElem::PRange(_) : return Ok(()),
        }
    }
    Type ty = match (place_type(b, it, x, path))
    {
        Some(t) : t,
        None    : return Ok(()),
    };
    if (!always_owns(it, &ty) || quiet_ty(it, &ty))
    {
        return Ok(());
    }
    str place = match (&strip_parens_tc(lhs).kind)
    {
        ExprKind::EDeref(_) : "the place this reference reaches",
        _                   : "this field or element",
    };
    refute(b, &sprintf(
        "diag.overwrite-of-live-resource\u{1}%s still holds a `%s`, which this assignment would lose; write `overwrite(&mut place, v)` to destroy the old value, or `replace(&mut place, v)` to keep it",
        place,
        &type_display(&ty),
    ))
}

// ---- helpers from later in typecheck.rs ----

fn strip_parens_tc(ref<Expr, shared> e) : ref<Expr, shared>
{
    match (&e.kind)
    {
        ExprKind::EParen(x) : strip_parens_tc(Box::get(x)),
        _                   : e,
    }
}

fn uninit_msg(StringView x) : String
{
    StringView n = shown_name(x);
    String msg = sprintf(
        "`%s` is read here, but on some path to here it was never given a value; give it one where it is declared (`… %s = …;`) or on every path before this",
        n,
        n,
    );
    named_diag("diag.use-of-uninitialized", &msg)
}

// `rule.stdlib.hashmap`'s key types (spec/21 §1a, D-0041).
export fn is_key_type(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    Option::is_none(&key_type_problem(it, t, 0))
}

// D-0181: what `Vec::sort` and `PriorityQueue::new` order.
fn is_sort_type(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TF32 : true,
        Type::TF64 : true,
        _          : is_key_type(it, t),
    }
}

// Why `t` is not a key type (None when it is).
fn key_type_problem(ref<Items, shared> it, ref<Type, shared> t, usize depth) : Option<String>
{
    match (t)
    {
        Type::TInt(_) : return None,
        Type::TBool   : return None,
        Type::TStr    : return None,
        Type::TNever  : return None,
        _             : {},
    }
    if (named_is(t, "std::String"))
    {
        return None;
    }
    if (depth > 16)
    {
        return Some(sprintf("`%s` nests too deeply", &type_display(t)));
    }
    match (t)
    {
        Type::TNamed(nb) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            bool resource_ = match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) : s.resource_,
                None    : false,
            } || match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) : e.resource_,
                None    : false,
            };
            if (resource_)
            {
                return Some(String::from_str("it is declared `resource`"));
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> sub = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        Type ft = apply_subst(&s.fields[i].ty, &sub);
                        if (Option::is_some(&key_type_problem(it, &ft, depth + 1)))
                        {
                            return Some(sprintf("its field `%s` is `%s`", &s.fields[i].name, &type_display(&ft)));
                        }
                    }
                    return None;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> sub = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) :
                            {
                                Type pt = apply_subst(p, &sub);
                                if (Option::is_some(&key_type_problem(it, &pt, depth + 1)))
                                {
                                    return Some(sprintf(
                                        "its variant `%s` holds `%s`",
                                        &e.variants[i].name,
                                        &type_display(&pt),
                                    ));
                                }
                            },
                            None    : {},
                        }
                    }
                    return None;
                },
                None    : {},
            }
        },
        _                : {},
    }
    Some(String::new())
}

// The message's tail naming why `t` is not a key type.
fn key_problem_text(ref<Items, shared> it, ref<Type, shared> t) : String
{
    match (key_type_problem(it, t, 0))
    {
        Some(r) : if (String::len(&r) > 0) { sprintf(": %s", &r) } else { String::new() },
        None    : String::new(),
    }
}

fn variant_has_payload(ref<EnumDecl, shared> e, ref<String, shared> name) : Option<bool>
{
    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
    {
        if (String::eq(&e.variants[i].name, name))
        {
            return Some(Option::is_some(&e.variants[i].payload));
        }
    }
    None
}

// Whether the variant `segs` names has a payload: `Some(b)` when that is
// certain, `None` when enums disagree.
fn variant_arity(ref<Items, shared> it, ref<String, shared> enum_name, ref<Vec<String>, shared> segs) : Option<bool>
{
    usize n = Vec::len(segs);
    if (n == 0)
    {
        return None;
    }
    ref<String, shared> last = &segs[n - 1];
    if (n >= 2)
    {
        return match (HashMap::get(&it.enums, enum_name))
        {
            Some(e) : variant_has_payload(e, last),
            None    : None,
        };
    }
    match (HashMap::get(&it.variant_payload, last))
    {
        Some(p) : *p,
        None    : None,
    }
}

fn is_variant_path(ref<Body, shared> b, ref<Items, shared> it, ref<Vec<String>, shared> segs) : bool
{
    Option::is_some(&variant_enum(it, segs)) && !(Vec::len(segs) == 1 && HashMap::contains(&b.gamma, &segs[0]))
}

// Whether an expression is, by its form alone, a value and not a
// reference.
fn plainly_a_value(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EInt(_)         : true,
        ExprKind::EFloat(_)       : true,
        ExprKind::EBool(_)        : true,
        ExprKind::EStructLit(_)   : true,
        ExprKind::EArrayLit(_)    : true,
        ExprKind::EArrayRepeat(_) : true,
        ExprKind::EParen(x)       : plainly_a_value(b, it, Box::get(x)),
        ExprKind::EPath(p)        : is_variant_path(b, it, &Box::get(p).segs),
        ExprKind::ECall(cb) : match (&Box::get(cb).callee.kind)
        {
            ExprKind::EPath(p) : is_variant_path(b, it, &Box::get(p).segs),
            _                  : false,
        },
        _                         : false,
    }
}

// `Items::module_variant_enum`: the enum of module `prefix` with a
// variant `vname`, when exactly one.
fn module_variant_enum(ref<Items, shared> it, StringView prefix, ref<String, shared> vname) : Option<String>
{
    String mk = String::from_view(prefix);
    String::append(&mut mk, "\u{1}");
    String::append(&mut mk, String::as_view(vname));
    match (HashMap::get(&it.module_variant, &mk))
    {
        Some(e) : clone(e),
        None    : None,
    }
}

fn variant_enum(ref<Items, shared> it, ref<Vec<String>, shared> segs) : Option<String>
{
    usize n = Vec::len(segs);
    if (n == 0)
    {
        return None;
    }
    ref<String, shared> last = &segs[n - 1];
    if (n >= 2)
    {
        String key = String::clone(&segs[0]);
        for (usize i = 1; i + 1 < n; i += 1)
        {
            String::append(&mut key, "::");
            String::append(&mut key, String::as_view(&segs[i]));
        }
        match (HashMap::get(&it.enums, &key))
        {
            Some(e) : return if (Option::is_some(&variant_has_payload(e, last))) { Some(key) } else { None },
            None    : {},
        }
        // `m::V`: the enum of module `m` with that variant.
        match (module_variant_enum(it, String::as_view(&key), last))
        {
            Some(e) : return Some(e),
            None    : {},
        }
    }
    match (HashMap::get(&it.enum_of_variant, last))
    {
        Some(e) : Some(String::clone(e)),
        None    : None,
    }
}

fn is_intrinsic_any(ref<String, shared> n) : bool
{
    String spaced = sprintf(" %s ", n);
    StringView::contains(PRELUDE_ALL_INTRINSICS, String::as_view(&spaced))
}

fn is_item_name(ref<Items, shared> it, ref<String, shared> n) : bool
{
    HashMap::contains(
        &it.fns,
        n,
    ) || HashMap::contains(
        &it.externs,
        n,
    ) || HashMap::contains(
        &it.statics,
        n,
    ) || HashMap::contains(
        &it.enum_of_variant,
        n,
    ) || HashMap::contains(&it.structs, n) || HashMap::contains(&it.enums, n) || is_intrinsic_any(n)
}

fn f_key(ref<FnDecl, shared> f) : String
{
    match (&f.assoc_type)
    {
        Some(t) : sprintf("%s::%s", t, &f.name),
        None    : String::clone(&f.name),
    }
}

// ---- part 4: typecheck.rs lines 2400-2800 ----

fn valid_ref_path(ref<Body, shared> b, ref<Vec<String>, shared> segs) : bool
{
    Vec::len(segs) == 1 && tri_is(&b.flow.valid, &segs[0], Tri::T)
}

// D-0095: whether `lhs` writes through a reference binding the flow
// analysis knows is valid here.
fn deref_ref_valid(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> lhs) : bool
{
    ref<Expr, shared> e = strip_parens_tc(lhs);
    while (true)
    {
        match (&e.kind)
        {
            ExprKind::EField(fb) : e = strip_parens_tc(&Box::get(fb).e),
            ExprKind::EIndex(ib) : e = strip_parens_tc(&Box::get(ib).a),
            ExprKind::EDeref(x)  :
            {
                return match (&strip_parens_tc(Box::get(x)).kind)
                {
                    ExprKind::EPath(p) : valid_ref_path(b, &Box::get(p).segs),
                    _                  : false,
                };
            },
            ExprKind::EPath(p)   :
            {
                ref<Vec<String>, shared> segs = &Box::get(p).segs;
                if (Vec::len(segs) != 1)
                {
                    return false;
                }
                bool is_ref = match (HashMap::get(&b.gamma, &segs[0]))
                {
                    Some(Type::TRef(_)) : true,
                    _                   : false,
                };
                return is_ref && valid_ref_path(b, segs);
            },
            _                    : return false,
        }
    }
    false
}

// `[Borrow]` of a place: `¬clash(a0, m)`.
fn flow_borrow(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> inner, Mode mode) : Result<void, String>
{
    match (place_of(b, it, inner))
    {
        Some(p) :
        {
            HashMap::remove(&mut b.flow.lits, &p.root);
        },
        None    : {},
    }
    Option<Place> p = match (place_of(b, it, inner))
    {
        Some(p) : Some(p),
        None    : deref_place_of(b, it, inner),
    };
    match (p)
    {
        Some(p) : flow_clash(b, it, &p.root, &p.path, mode, "diag.aliasing-conflict")?,
        None    : {},
    }
    Ok(())
}

// A consuming use of a whole resource binding: `solitary(a_x)`, then
// `valid(x) := F` and every `deriv(·, x, ·) := F`.
fn flow_consume(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> x, str diag) : Result<void, String>
{
    flow_solitary(b, it, x, diag)?;
    if (!b.flow.unreachable)
    {
        HashMap::insert(&mut b.flow.valid, String::clone(x), Tri::F);
        flow_clear_rooted(&mut b.flow, String::as_view(x));
        // D-0071: what a moved guard or handle held goes with it, out of
        // this analysis' sight: the run's to check (D-0289), unless `join`,
        // `try_join` or `drop` ends it here.
        bool lends = match (HashMap::get(&b.gamma, x))
        {
            Some(t) : holds_handle(t) || holds_guard(t),
            None    : false,
        };
        if (!b.joining && !b.handing && has_live_fact(b, x) && lends)
        {
            rep_left(b, sprintf("line %v: `%s` leaves this frame holding what it was lent", b.current_line, x));
        }
        holder_leaves(b, it, x);
        flow_clear_rooted(&mut b.flow, String::as_view(&referent_root(String::as_view(x))));
        HashMap::remove(&mut b.flow.deriv, x);
    }
    Ok(())
}

// An expression in a store position: a resource-typed whole binding is
// moved rather than read; a resource-typed field of a live object may not
// be moved out.
fn check_store_operand(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // D-0282: a value moved out through a reference (`drop(*r)`,
    // `Atomic<u64> c = *r`): the reference still holds the place, so the
    // move conflicts with it, always.
    if (b.report && !b.flow.unreachable)
    {
        match (&strip_parens_tc(e).kind)
        {
            ExprKind::EDeref(inner) : match (one_seg(strip_parens_tc(Box::get(inner))))
            {
                Some(n) :
                {
                    bool moves = match (static_place_type(b, it, e))
                    {
                        Some(t) : is_resource_ty(
                            it,
                            &t,
                        ) || named_is(&t, "std::Atomic") || named_is(&t, "std::Vec") || named_is(&t, "std::String"),
                        None : false,
                    };
                    bool is_ref = match (HashMap::get(&b.gamma, n))
                    {
                        Some(Type::TRef(_)) : true,
                        _                   : false,
                    };
                    if (moves && is_ref)
                    {
                        String msg = sprintf("`*%s` cannot be moved out: `%s` still refers to it", n, n);
                        String diag = sprintf(
                            "%s%s",
                            &named_diag("diag.move-while-aliased", &msg),
                            &diag_at(e.line, e.col),
                        );
                        refute(b, &diag)?;
                    }
                },
                None    : {},
            },
            _ : {},
        }
    }
    // Tagged with the operand's line, as `check_expr` tags its own.
    Option<Type> t = match (check_store_operand_inner(b, it, e, expected))
    {
        Ok(t)  : t,
        Err(d) :
        {
            if (!String::contains(&d, "@"))
            {
                return Err(sprintf("%s%s", &d, &diag_at(e.line, e.col)));
            }
            return Err(d);
        },
    };
    // D-0071: a binding that holds borrows without being a reference,
    // stored elsewhere, takes them out of sight. A closure that owns no
    // resource is copied, not moved, and keeps them (CHG-0299).
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EPath(p) :
        {
            ref<Vec<String>, shared> segs = &Box::get(p).segs;
            // D-0282: a view (or an `Option`/`Result` of a reference) is
            // copied, not moved, and keeps its borrow.
            bool copied_view = match (HashMap::get(&b.gamma, &segs[0]))
            {
                Some(t) : copied_view_type(t),
                None    : false,
            };
            // D-0290: a holder that owns no resource is copied, and keeps
            // what it holds; a copy given away is the run's.
            bool copied_holder = Vec::len(segs) == 1 && is_holder(
                b,
                it,
                &segs[0],
            ) && match (HashMap::get(&b.gamma, &segs[0]))
            {
                Some(t) : !is_resource_ty(it, t),
                None    : false,
            };
            if (copied_holder)
            {
                holder_leaves(b, it, &segs[0]);
            }
            else if (Vec::len(segs) == 1 && !copied_view && !b.flow.unreachable && HashMap::contains(
                &b.flow.deriv,
                &segs[0],
            ))
            {
                bool refish = match (HashMap::get(&b.gamma, &segs[0]))
                {
                    Some(Type::TRef(_))   : true,
                    Some(Type::TSlice(_)) : true,
                    _                     : false,
                };
                if (!refish && !HashSet::contains(&b.closure_copied, &segs[0]))
                {
                    holder_leaves(b, it, &segs[0]);
                    HashMap::remove(&mut b.flow.deriv, &segs[0]);
                }
            }
        },
        _                  : {},
    }
    Ok(t)
}

// A view, or an `Option`/`Result` of a reference: copied, not moved.
fn copied_view_type(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(nb) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (String::eq_str(&n.name, "std::StringView"))
            {
                return Vec::len(&n.args) == 0;
            }
            if (String::eq_str(&n.name, "std::Option") || String::eq_str(&n.name, "std::Result"))
            {
                return Vec::len(&n.args) > 0 && is_ref_or_view(&n.args[0]);
            }
            false
        },
        _                : false,
    }
}

fn check_store_operand_inner(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    match (root_local_name(e))
    {
        Some(name) : match (HashMap::get(&b.move_captures, &name))
        {
            Some(Some(t)) :
            {
                if (is_resource_ty(it, t))
                {
                    return Err(String::from_str("diag.move-out-of-field"));
                }
            },
            _             : {},
        },
        None : {},
    }
    match (place_of(b, it, e))
    {
        Some(p) :
        {
            if (place_is_resource(
                b,
                it,
                &p.root,
                &p.path,
            ) || (Vec::len(&p.path) == 0 && HashSet::contains(&b.closure_owning, &p.root)))
            {
                b.place_pos = true;
                Option<Type> t = check_expr(b, it, e, expected)?;
                if (Vec::len(&p.path) == 0)
                {
                    flow_consume(b, it, &p.root, "diag.move-while-aliased")?;
                }
                else
                {
                    refute(b, &named_diag("diag.move-out-of-field", &String::from_str(MOVE_OUT_HELP)))?;
                }
                return Ok(t);
            }
        },
        None    : {},
    }
    // `[Store-Binding-Place-Transfer-Sub]` on a temporary's field.
    bool projection = match (&strip_parens_tc(e).kind)
    {
        ExprKind::EField(_) : true,
        ExprKind::EIndex(_) : true,
        _                   : false,
    };
    if (projection && borrow_operand_kind(b, it, e) == OperandKind::Temporary)
    {
        // D-0103: a resource field of a temporary struct (without a
        // destructor) is moved out, the temporary's other fields ended at
        // once: `f().x` is `{ S { x, y, … } = f(); x }`.
        match (&strip_parens_tc(e).kind)
        {
            ExprKind::EField(fb) :
            {
                ref<FieldExpr, shared> fe = Box::get(fb);
                Flow saved = clone(&b.flow);
                Result<Option<Type>, String> bt = check_expr(b, it, &fe.e, &None);
                b.flow = saved;
                match (bt)
                {
                    Ok(Some(Type::TNamed(nb))) :
                    {
                        String sname = String::clone(&Box::get(&nb).name);
                        bool has_drop = HashMap::contains(&it.fns, &sprintf("%s::drop", &sname));
                        match (HashMap::get(&it.structs, &sname))
                        {
                            Some(sd) :
                            {
                                bool resource_field = false;
                                for (usize i = 0; i < Vec::len(&sd.fields); i += 1)
                                {
                                    if (String::eq(&sd.fields[i].name, &fe.name))
                                    {
                                        resource_field = is_resource_ty(it, &sd.fields[i].ty);
                                        break;
                                    }
                                }
                                if (!has_drop && resource_field)
                                {
                                    usize line = e.line;
                                    usize col = e.col;
                                    Vec<String> fields = Vec::new();
                                    for (usize i = 0; i < Vec::len(&sd.fields); i += 1)
                                    {
                                        Vec::push(&mut fields, String::clone(&sd.fields[i].name));
                                    }
                                    Vec<Stmt> stmts = Vec::new();
                                    Vec::push(&mut stmts, Stmt::SDestructure(Box::new(DestructureStmt {
                                        .struct_name = String::clone(&sname),
                                        .names = Vec::clone(&fields),
                                        .fields = fields,
                                        .rest = false,
                                        .init = clone(&fe.e),
                                    })));
                                    Vec<String> tail_segs = Vec::new();
                                    Vec::push(&mut tail_segs, String::clone(&fe.name));
                                    Expr tail = mk(
                                        ExprKind::EPath(Box::new(PathExpr { .segs = tail_segs, .targs = Vec::new() })),
                                        line,
                                        col,
                                    );
                                    Expr rep = mk(
                                        ExprKind::EBlock(Block { .stmts = stmts, .tail = Some(Box::new(tail)) }),
                                        line,
                                        col,
                                    );
                                    number_fresh(b, &mut rep);
                                    Option<Type> t = check_expr(b, it, &rep, expected)?;
                                    HashMap::insert(&mut b.facts.temp_moves, e.id, rep);
                                    return Ok(t);
                                }
                            },
                            None     : {},
                        }
                    },
                    _                          : {},
                }
            },
            _                    : {},
        }
        Option<Type> t = check_expr(b, it, e, expected)?;
        bool res = match (&t)
        {
            Some(x) : is_resource_ty(it, x),
            None    : false,
        };
        if (res)
        {
            return Err(sprintf(
                "%s%s",
                &named_diag("diag.move-out-of-field", &String::from_str(MOVE_OUT_HELP)),
                &diag_at(e.line, e.col),
            ));
        }
        return Ok(t);
    }
    check_expr(b, it, e, expected)
}

// spec/13 §1's place kinds, the projections' bases taken through a
// reference when `static_place_type` or `returns_ref` says it is one.
fn borrow_operand_kind(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : OperandKind
{
    operand_root(b, it, e, false)
}

fn operand_is_ref(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> x) : bool
{
    match (static_place_type(b, it, x))
    {
        Some(Type::TRef(_)) : true,
        _                   : returns_ref(b, it, x),
    }
}

fn operand_root(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e, bool projected) : OperandKind
{
    match (&e.kind)
    {
        ExprKind::EParen(x)       : operand_root(b, it, Box::get(x), projected),
        ExprKind::EPath(_)        : OperandKind::Place,
        ExprKind::EDeref(_)       : OperandKind::Place,
        ExprKind::EField(fb)      :
        {
            ref<Expr, shared> base = &Box::get(fb).e;
            if (operand_is_ref(b, it, base)) { OperandKind::Place } else { operand_root(b, it, base, true) }
        },
        ExprKind::EIndex(ib)      :
        {
            ref<Expr, shared> base = &Box::get(ib).a;
            if (operand_is_ref(b, it, base)) { OperandKind::Place } else { operand_root(b, it, base, true) }
        },
        ExprKind::ECall(cb)       :
        {
            if (is_reclaim_call(&Box::get(cb).callee))
            {
                return OperandKind::Place;
            }
            if (projected) { OperandKind::Temporary } else { OperandKind::NonPlace }
        },
        ExprKind::EStructLit(_)   : if (projected) { OperandKind::Temporary } else { OperandKind::NonPlace },
        ExprKind::EArrayLit(_)    : if (projected) { OperandKind::Temporary } else { OperandKind::NonPlace },
        ExprKind::EArrayRepeat(_) : if (projected) { OperandKind::Temporary } else { OperandKind::NonPlace },
        _                         : OperandKind::NonPlace,
    }
}

fn deriv_key(Place p, Mode m) : DerivKey
{
    Place { root, path } = p;
    DerivKey { .root = root, .path = path, .mode = m }
}

fn place_or_deref(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> inner) : Option<Place>
{
    match (place_of(b, it, inner))
    {
        Some(p) : Some(p),
        None    : deref_place_of(b, it, inner),
    }
}

// The single reference parameter's position of a call whose result is a
// reference (D-0011's elided call), or none.
fn elided_ref_arg(ref<Items, shared> it, ref<CallExpr, shared> c) : Option<usize>
{
    String key = resolve_fn_path(it, &c.callee)?;
    ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &key), "a function");
    Vec<usize> ref_positions = Vec::new();
    for (usize i = 0; i < Vec::len(&f.params); i += 1)
    {
        if (is_borrow_ty(&f.params[i].ty))
        {
            Vec::push(&mut ref_positions, i);
        }
    }
    if (Vec::len(&ref_positions) != 1 || !is_borrow_ty(&f.ret) || ref_positions[0] >= Vec::len(&c.args))
    {
        return None;
    }
    Some(ref_positions[0])
}

// The `deriv`-forming initializers of a reference-typed binding.
fn deriv_facts_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<DerivKey>
{
    match (&e.kind)
    {
        ExprKind::EParen(x)   : deriv_facts_of(b, it, Box::get(x)),
        ExprKind::EBorrow(x)  :
        {
            Place p = borrowed_place(b, it, &Box::get(x).e)?;
            Some(deriv_key(p, Box::get(x).mode))
        },
        // D-0070: a slice derives from its range of the source.
        ExprKind::ESliceOf(x) :
        {
            ref<SliceExpr, shared> s = Box::get(x);
            Place p = slice_source(b, it, &s.base)?;
            Vec::push(&mut p.path, range_elem(&s.lo, &s.hi));
            Some(deriv_key(p, s.mode))
        },
        ExprKind::ECall(cb)   :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            usize k = elided_ref_arg(it, c)?;
            ref<Expr, shared> arg = &c.args[k];
            match (&arg.kind)
            {
                ExprKind::EBorrow(x)  :
                {
                    Place p = place_or_deref(b, it, &Box::get(x).e)?;
                    Some(deriv_key(p, Box::get(x).mode))
                },
                ExprKind::ESliceOf(x) :
                {
                    ref<SliceExpr, shared> s = Box::get(x);
                    Place p = place_or_deref(b, it, &s.base)?;
                    Vec::push(&mut p.path, range_elem(&s.lo, &s.hi));
                    Some(deriv_key(p, s.mode))
                },
                _                     : None,
            }
        },
        _                     : None,
    }
}

// A call whose result is a reference (`String::as_bytes(&s)`).
fn returns_ref(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    match (value_shape(b, it, e))
    {
        Some(Type::TRef(_)) : true,
        _                   : false,
    }
}

fn is_unwrapping(ref<String, shared> key) : bool
{
    String::eq_str(
        key,
        "std::Option::unwrap",
    ) || String::eq_str(
        key,
        "std::Option::expect",
    ) || String::eq_str(key, "std::Result::unwrap") || String::eq_str(key, "std::Result::expect")
}

// The type an expression's value has, as far as its declaration shows it:
// a local's type, a call's declared result, and through `unwrap`/`expect`
// the payload of their argument's shape.
fn value_shape(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Type>
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EPath(p)  :
        {
            if (Vec::len(&Box::get(p).segs) == 1)
            {
                return lookup_local(b, &Box::get(p).segs[0]);
            }
            None
        },
        ExprKind::ECall(cb) :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            String key = resolve_fn_path(it, &c.callee)?;
            if (is_unwrapping(&key) && Vec::len(&c.args) > 0)
            {
                Type t = value_shape(b, it, &c.args[0])?;
                if (named_is(&t, "std::Option") || named_is(&t, "std::Result"))
                {
                    Vec<Type> args = named_args(&t);
                    return if (Vec::len(&args) > 0) { Some(clone(&args[0])) } else { None };
                }
                return None;
            }
            ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &key), "a function");
            // A generic's result with its type parameters bound from the
            // arguments (`Vec::index_exclusive(&mut v, 0)` of a `Vec<i32>`
            // is a `ref<i32, exclusive>`, not a `ref<T, …>`); one not bound
            // is not known.
            if (Vec::len(&f.type_params) == 0)
            {
                return Some(clone(&f.ret));
            }
            HashSet<String> tps = HashSet::new();
            for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
            {
                HashSet::insert(&mut tps, String::clone(&f.type_params[i]));
            }
            if (!mentions_any(&f.ret, &tps))
            {
                return Some(clone(&f.ret));
            }
            HashMap<String, Type> m = match (&c.callee.kind)
            {
                ExprKind::EPath(pb) : if (Vec::len(&Box::get(pb).targs) > 0)
                {
                    explicit_subst(
                        f,
                        &Box::get(pb).targs,
                    )
                }
                else { HashMap::new() },
                _ : HashMap::new(),
            };
            for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(&c.args); i += 1)
            {
                Option<Type> at = match (&strip_parens_tc(&c.args[i]).kind)
                {
                    ExprKind::EBorrow(bb) : match (shape_or_place(b, it, &Box::get(bb).e))
                    {
                        Some(t) : Some(ref_of(t, Box::get(bb).mode)),
                        None    : None,
                    },
                    _ : shape_or_place(b, it, &c.args[i]),
                };
                match (&at)
                {
                    Some(t) : unify_type_shape(&f.params[i].ty, t, &mut m, &f.type_params),
                    None    : {},
                }
            }
            Type ret = apply_subst(&f.ret, &m);
            if (mentions_any(&ret, &tps)) { None } else { Some(ret) }
        },
        _                   : None,
    }
}

// The source a slice `&m base[lo .. hi]` takes its range of: `base`'s
// place, or for a reference binding `r` its referent `*r`.
fn slice_source(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> base) : Option<Place>
{
    match (single_tracked(b, strip_parens_tc(base)))
    {
        Some(x) :
        {
            bool is_ref = match (HashMap::get(&b.gamma, &x))
            {
                Some(Type::TRef(_)) : true,
                _                   : false,
            };
            if (is_ref)
            {
                return Some(Place { .root = referent_root(String::as_view(&x)), .path = Vec::new() });
            }
        },
        None    : {},
    }
    borrowed_place(b, it, base)
}

fn borrowed_place(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> inner) : Option<Place>
{
    match (place_of(b, it, inner))
    {
        Some(p) : return Some(p),
        None    : {},
    }
    match (vec_element_root(b, it, inner))
    {
        Some(p) : return Some(p),
        None    : {},
    }
    deref_place_of(b, it, inner)
}

fn call_args(ref<Expr, shared> e) : Option<ref<Vec<Expr>, shared>>
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::ECall(cb) : Some(&Box::get(cb).args),
        _                   : None,
    }
}

// D-0071: `spawn(f, a1, …)`: a handle bound to it carries the arguments'
// visible borrows.
fn spawn_facts_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Vec<DerivKey>
{
    Vec<DerivKey> v = Vec::new();
    ref<Vec<Expr>, shared> args = match (call_args(e))
    {
        Some(a) : a,
        None    : return v,
    };
    for (usize i = 1; i < Vec::len(args); i += 1)
    {
        match (deriv_facts_of(b, it, &args[i]))
        {
            Some(k) : Vec::push(&mut v, k),
            None    : {},
        }
    }
    Vec::append(&mut v, spawn_lent_refs(b, it, args));
    v
}

// D-0213 `[Thread-Lend]`: a reference binding passed to `spawn` whole is
// lent to the thread.
fn spawn_lent_refs(ref<Body, shared> b, ref<Items, shared> it, ref<Vec<Expr>, shared> args) : Vec<DerivKey>
{
    Vec<DerivKey> out = Vec::new();
    for (usize i = 1; i < Vec::len(args); i += 1)
    {
        match (single_tracked(b, strip_parens_tc(&args[i])))
        {
            // D-0291: a slice binding lent whole, as a reference; an
            // exclusive one is lent exclusively whatever the parameter takes
            // (`[Thread-Lend]` lends before binding).
            Some(x) : match (local_ref_mode(b, &x))
            {
                Some(mode) : Vec::push(
                    &mut out,
                    DerivKey { .root = referent_root(String::as_view(&x)), .path = Vec::new(), .mode = mode },
                ),
                None : {},
            },
            None : {},
        }
    }
    out
}

// D-0088: a call whose result holds a reference without being one is
// taken to borrow from the call's first reference argument.
fn contained_ref_facts(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Vec<DerivKey>
{
    Vec<DerivKey> out = Vec::new();
    ref<CallExpr, shared> c = match (&strip_parens_tc(e).kind)
    {
        ExprKind::ECall(cb)     : Box::get(cb),
        ExprKind::EPropagate(x) : return contained_ref_facts(b, it, Box::get(x)),
        _                       : return out,
    };
    String key = match (resolve_fn_path(it, &c.callee))
    {
        Some(k) : k,
        None    : return out,
    };
    if (is_unwrapping(&key) && Vec::len(&c.args) > 0)
    {
        return contained_ref_facts(b, it, &c.args[0]);
    }
    ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &key), "a function");
    if (is_borrow_ty(&f.ret) || !holds_ref(it, &f.ret))
    {
        return out;
    }
    for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(&c.args); i += 1)
    {
        if (!is_borrow_ty(&f.params[i].ty))
        {
            continue;
        }
        match (&strip_parens_tc(&c.args[i]).kind)
        {
            ExprKind::EBorrow(x)  :
            {
                match (borrowed_place(b, it, &Box::get(x).e))
                {
                    Some(p) : Vec::push(&mut out, deriv_key(p, Box::get(x).mode)),
                    None    : {},
                }
            },
            ExprKind::ESliceOf(x) :
            {
                ref<SliceExpr, shared> s = Box::get(x);
                match (borrowed_place(b, it, &s.base))
                {
                    Some(p) :
                    {
                        Vec::push(&mut p.path, range_elem(&s.lo, &s.hi));
                        Vec::push(&mut out, deriv_key(p, s.mode));
                    },
                    None    : {},
                }
            },
            _                     : {},
        }
        break;
    }
    out
}

// `auto r = e;` / `r = e;` for a reference-typed `r`: the `deriv` facts.
fn set_deriv(ref<Body, exclusive> b, ref<String, shared> r, Vec<DerivKey> facts)
{
    if (b.flow.unreachable)
    {
        return;
    }
    HashMap::remove(&mut b.ref_copies, r);
    handle_lend_through(b, r);
    HashMap::remove(&mut b.flow.deriv, r);
    // What was borrowed through `r`'s old referent is not borrowed through
    // its new one (D-0071).
    flow_clear_rooted(&mut b.flow, String::as_view(&referent_root(String::as_view(r))));
    if (Vec::len(&facts) > 0)
    {
        HashMap<String, DerivFact> m = HashMap::new();
        for (usize i = 0; i < Vec::len(&facts); i += 1)
        {
            HashMap::insert(&mut m, deriv_code(&facts[i]), DerivFact { .key = clone(&facts[i]), .v = Tri::T });
        }
        HashMap::insert(&mut b.flow.deriv, String::clone(r), m);
    }
}

// ---- D-0282..D-0291: helpers over the facts ----

fn local_is_ref(ref<Body, shared> b, ref<String, shared> name) : bool
{
    match (HashMap::get(&b.gamma, name))
    {
        Some(Type::TRef(_))   : true,
        Some(Type::TSlice(_)) : true,
        _                     : false,
    }
}

fn local_ref_mode(ref<Body, shared> b, ref<String, shared> name) : Option<Mode>
{
    match (HashMap::get(&b.gamma, name))
    {
        Some(Type::TRef(x))   : Some(Box::get(x).mode),
        Some(Type::TSlice(x)) : Some(Box::get(x).mode),
        _                     : None,
    }
}

fn fact(String root, Vec<PElem> path, Mode mode, Tri v) : DerivFact
{
    DerivFact { .key = DerivKey { .root = root, .path = path, .mode = mode }, .v = v }
}

// The facts of holder `n`, those that may hold (`v != F`) when `live`.
fn facts_of(ref<Body, shared> b, ref<String, shared> n, bool live) : Vec<DerivFact>
{
    Vec<DerivFact> out = Vec::new();
    match (HashMap::get(&b.flow.deriv, n))
    {
        Some(m) :
        {
            for (usize k = 0; k < HashMap::len(m); k += 1)
            {
                ref<DerivFact, shared> d = HashMap::value_at(m, k);
                if (!live || d.v != Tri::F)
                {
                    Vec::push(&mut out, clone(d));
                }
            }
        },
        None    : {},
    }
    out
}

// D-0290: a holder's facts that may hold.
fn holder_facts(ref<Body, shared> b, ref<String, shared> n) : Vec<DerivFact>
{
    facts_of(b, n, true)
}

// Whether holder `n` has a fact that may hold.
fn has_live_fact(ref<Body, shared> b, ref<String, shared> n) : bool
{
    match (HashMap::get(&b.flow.deriv, n))
    {
        Some(m) :
        {
            for (usize k = 0; k < HashMap::len(m); k += 1)
            {
                if (HashMap::value_at(m, k).v != Tri::F)
                {
                    return true;
                }
            }
            false
        },
        None    : false,
    }
}

// The holders' names, in the facts' order.
fn holder_names(ref<Body, shared> b) : Vec<String>
{
    Vec<String> out = Vec::new();
    for (usize i = 0; i < HashMap::len(&b.flow.deriv); i += 1)
    {
        Vec::push(&mut out, String::clone(HashMap::key_at(&b.flow.deriv, i)));
    }
    out
}

fn is_tier_d_root(ref<String, shared> root) : bool
{
    String::eq_str(root, "<tier D>") || String::eq_str(root, "<temporary>")
}

// Whether every fact has a root of this frame (not `<tier D>`, not
// `<temporary>`), and there is one.
fn facts_known(ref<Vec<DerivFact>, shared> v) : bool
{
    if (Vec::len(v) == 0)
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(v); i += 1)
    {
        if (is_tier_d_root(&v[i].key.root))
        {
            return false;
        }
    }
    true
}

fn any_root(ref<Vec<DerivFact>, shared> v, str root) : bool
{
    for (usize i = 0; i < Vec::len(v); i += 1)
    {
        if (String::eq_str(&v[i].key.root, root))
        {
            return true;
        }
    }
    false
}

// Every fact with `v = U`.
fn all_unsure(Vec<DerivFact> v) : Vec<DerivFact>
{
    for (usize i = 0; i < Vec::len(&v); i += 1)
    {
        v[i].v = Tri::U;
    }
    v
}

// D-0291: a reference or slice binding leaving its scope while something
// else holds a fact through its referent `*r` (a thread's handle, a
// closure, a copy): that fact now holds what `r` reached.
fn hand_over_referent(ref<Body, exclusive> b, ref<String, shared> r)
{
    if (!local_is_ref(b, r))
    {
        return;
    }
    String rr = referent_root(String::as_view(r));
    Vec<DerivFact> own = holder_facts(b, r);
    if (Vec::len(&own) == 0)
    {
        return;
    }
    Vec<String> hs = holder_names(b);
    for (usize i = 0; i < Vec::len(&hs); i += 1)
    {
        if (String::eq(&hs[i], r))
        {
            continue;
        }
        ref<HashMap<String, DerivFact>, exclusive> facts = match (HashMap::get_mut(&mut b.flow.deriv, &hs[i]))
        {
            Some(m) : m,
            None    : continue,
        };
        Vec<DerivFact> through = Vec::new();
        for (usize k = 0; k < HashMap::len(facts); k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            if (String::eq(&d.key.root, &rr) && d.v != Tri::F)
            {
                Vec::push(&mut through, clone(d));
            }
        }
        for (usize k = 0; k < Vec::len(&through); k += 1)
        {
            HashMap::remove(facts, &deriv_code(&through[k].key));
            for (usize o = 0; o < Vec::len(&own); o += 1)
            {
                DerivKey nk = clone(&own[o].key);
                Vec::append(&mut nk.path, clone(&through[k].key.path));
                if (through[k].key.mode == Mode::Shared)
                {
                    nk.mode = Mode::Shared;
                }
                Tri nt = if (through[k].v == Tri::T && own[o].v == Tri::T) { Tri::T } else { Tri::U };
                String code = deriv_code(&nk);
                ref<DerivFact, exclusive> e = HashMap::entry(
                    facts,
                    String::clone(&code),
                    DerivFact { .key = nk, .v = nt },
                );
                if (e.v != nt)
                {
                    e.v = if (e.v == Tri::T || nt == Tri::T) { Tri::T } else { Tri::U };
                }
            }
        }
    }
}

// Whether holder `h` still holds its facts after this point: past its
// last mention for a binding that ends there (D-0111), and to the end of
// its scope for one that does not -- a thread's handle, a guard, a `Vec`
// of handles, whose end waits or releases (D-0289).
fn holder_live_after(ref<Body, shared> b, ref<Items, shared> it, ref<String, shared> h) : bool
{
    holder_live_from(b, it, h, 0)
}

// ... or while a live holder reaches it (`auto hr = &h`: what `h` holds
// lives as long as `hr` does).
fn holder_live_from(ref<Body, shared> b, ref<Items, shared> it, ref<String, shared> h, usize depth) : bool
{
    if (rep_live_after(&b.rep, String::as_view(h), b.current_line, b.current_col))
    {
        return true;
    }
    match (HashMap::get(&b.gamma, h))
    {
        Some(t) :
        {
            if (!ends_at_last_use(it, t))
            {
                return true;
            }
        },
        None    : {},
    }
    if (depth > 4)
    {
        return false;
    }
    String rh = referent_root(String::as_view(h));
    for (usize i = 0; i < HashMap::len(&b.flow.deriv); i += 1)
    {
        ref<String, shared> g = HashMap::key_at(&b.flow.deriv, i);
        if (String::eq(g, h))
        {
            continue;
        }
        ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&b.flow.deriv, i);
        bool reaches = false;
        for (usize k = 0; k < HashMap::len(facts) && !reaches; k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            reaches = d.v != Tri::F && (String::eq(&d.key.root, h) || String::eq(&d.key.root, &rh));
        }
        if (reaches && holder_live_from(b, it, g, depth + 1))
        {
            return true;
        }
    }
    false
}

// The root binding of a field/index chain (`s` in `s[i].f`), unwrapped of
// parentheses.
fn chain_root(ref<Expr, shared> e) : ref<Expr, shared>
{
    ref<Expr, shared> x = strip_parens_tc(e);
    while (true)
    {
        match (&x.kind)
        {
            ExprKind::EField(f) : x = strip_parens_tc(&Box::get(f).e),
            ExprKind::EIndex(p) : x = strip_parens_tc(&Box::get(p).a),
            _                   : break,
        }
    }
    x
}

// D-0291: a reborrow of a slice binding's elements (`&mut s[a .. b]`,
// `&s[i]`) reaches `*s` as a copy does (`tier_referent_reach`), in the
// borrow's mode.
fn tier_slice_reborrow(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> base, Mode mode)
{
    match (one_seg(chain_root(base)))
    {
        Some(n) :
        {
            bool is_slice = match (HashMap::get(&b.gamma, n))
            {
                Some(Type::TSlice(_)) : true,
                _                     : false,
            };
            if (is_slice)
            {
                String name = String::clone(n);
                tier_referent_reach(b, it, &name, Some(mode));
            }
        },
        None    : {},
    }
}

// D-0291: a reference or slice binding `r` read whole (copied, stored)
// while another live holder holds what it refers to (`*r`, a thread lent
// it, a closure captured it): the copy reaches `*r` under no fact, so what
// it does there is the run's. A copy goes in `r`'s mode; one passed to a
// reference or slice parameter is the call-site rule's. A hidden binding
// (`$c`, a `foreach`'s) is read by the desugaring, not copied: what is
// borrowed from it is checked where it is borrowed.
fn tier_referent_reach(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> r, Option<Mode> mode)
{
    if (!b.report || b.flow.unreachable || !flow_is_tracked(&b.flow, r) || String::starts_with(r, "$"))
    {
        return;
    }
    Mode m = match (local_ref_mode(b, r))
    {
        Some(rm) : Option::unwrap_or(mode, rm),
        None     : return,
    };
    String root = referent_root(String::as_view(r));
    bool held = false;
    for (usize i = 0; i < HashMap::len(&b.flow.deriv) && !held; i += 1)
    {
        ref<String, shared> h = HashMap::key_at(&b.flow.deriv, i);
        if (String::eq(h, r))
        {
            continue;
        }
        ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&b.flow.deriv, i);
        bool any = false;
        for (usize k = 0; k < HashMap::len(facts) && !any; k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            any = d.v != Tri::F && String::eq(&d.key.root, &root) && !permitted(m, d.key.mode);
        }
        if (any && holder_live_after(b, it, h))
        {
            held = true;
        }
    }
    if (held)
    {
        rep_left(
            b,
            sprintf("line %v: `%s` is read while a thread or a closure holds what it refers to", b.current_line, r),
        );
    }
}

// D-0290: an access through a reference read out of a holder or out of a
// reference's referent (`*s.inner`, `*v[i]`): the reference may be any of
// those stored there, so a live holder of another binding whose fact meets
// one of them in a clashing mode is a conflict on some paths, the run's.
fn holder_deref_access(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e, Mode mode)
{
    if (!b.report || b.flow.unreachable)
    {
        return;
    }
    ref<Expr, shared> base = chain_root(e);
    // D-0291: an element of a slice binding `s` that a thread or a closure
    // holds (`*s`, lent or captured), or a reborrow of it (`&mut s[a ..
    // b]`, rooted at `s`): no place names it, the run's.
    match (one_seg(base))
    {
        Some(sn) :
        {
            bool slice_binding = flow_is_tracked(&b.flow, sn) && match (HashMap::get(&b.gamma, sn))
            {
                Some(Type::TSlice(_)) : true,
                _                     : false,
            };
            if (!slice_binding)
            {
                return;
            }
            String s = String::clone(sn);
            String root = referent_root(String::as_view(&s));
            // The element `s[i]` against a reborrow's range of `s`.
            Vec<PElem> elem = Vec::new();
            Vec::push(&mut elem, PElem::PIndex(None));
            ref<Expr, shared> x = strip_parens_tc(e);
            while (true)
            {
                match (&x.kind)
                {
                    ExprKind::EIndex(p) :
                    {
                        ref<Expr, shared> y = strip_parens_tc(&Box::get(p).a);
                        if (y.id == base.id && y.line == base.line && y.col == base.col)
                        {
                            elem[0] = PElem::PIndex(literal_index(&Box::get(p).b));
                            break;
                        }
                        x = y;
                    },
                    ExprKind::EField(f) : x = strip_parens_tc(&Box::get(f).e),
                    _                   : break,
                }
            }
            bool held = false;
            for (usize i = 0; i < HashMap::len(&b.flow.deriv) && !held; i += 1)
            {
                ref<String, shared> h = HashMap::key_at(&b.flow.deriv, i);
                if (String::eq(h, &s) || !holder_live_after(b, it, h))
                {
                    continue;
                }
                ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&b.flow.deriv, i);
                for (usize k = 0; k < HashMap::len(facts) && !held; k += 1)
                {
                    ref<DerivFact, shared> d = HashMap::value_at(facts, k);
                    bool meets = String::eq(
                        &d.key.root,
                        &root,
                    ) || (String::eq(&d.key.root, &s) && overlap3(&d.key.path, &elem) != Ov::OvNo);
                    held = d.v != Tri::F && meets && !permitted(mode, d.key.mode);
                }
            }
            if (held)
            {
                usize line = b.current_line;
                b.rep.checks += 1;
                b.rep.undecided += 1;
                Vec::push(&mut b.rep.events, sprintf("U\t%v\t%s\t%s\t%s\t%v", line, &root, mode_debug(mode), &s, line));
                rep_left(b, sprintf("line %v: an element of `%s`, which a thread or a closure holds", line, &s));
            }
            return;
        },
        None     : {},
    }
    ref<Expr, shared> inner = match (&base.kind)
    {
        ExprKind::EDeref(x) : Box::get(x),
        _                   : return,
    };
    match (&strip_parens_tc(inner).kind)
    {
        ExprKind::EPath(_) : return,
        _                  : {},
    }
    Vec<DerivFact> stored = match (stored_facts(b, it, inner, 0))
    {
        Some(v) : v,
        None    : return,
    };
    Option<String> through = None;
    ref<Expr, shared> x = strip_parens_tc(inner);
    while (true)
    {
        match (&x.kind)
        {
            ExprKind::EField(f) : x = strip_parens_tc(&Box::get(f).e),
            ExprKind::EDeref(y) : x = strip_parens_tc(Box::get(y)),
            ExprKind::EIndex(p) : x = strip_parens_tc(&Box::get(p).a),
            ExprKind::EPath(_)  :
            {
                match (one_seg(x))
                {
                    Some(n) : through = Some(String::clone(n)),
                    None    : {},
                }
                break;
            },
            _                   : break,
        }
    }
    for (usize si = 0; si < Vec::len(&stored); si += 1)
    {
        if (stored[si].v == Tri::F)
        {
            continue;
        }
        ref<DerivKey, shared> sk = &stored[si].key;
        for (usize i = 0; i < HashMap::len(&b.flow.deriv); i += 1)
        {
            ref<String, shared> h = HashMap::key_at(&b.flow.deriv, i);
            bool is_through = match (&through)
            {
                Some(t) : String::eq(t, h),
                None    : false,
            };
            if (is_through || !holder_live_after(b, it, h))
            {
                continue;
            }
            // A reference to the holder itself may reach what it keeps.
            ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&b.flow.deriv, i);
            bool clash = false;
            for (usize k = 0; k < HashMap::len(facts) && !clash; k += 1)
            {
                ref<DerivFact, shared> d = HashMap::value_at(facts, k);
                bool through_root = match (&through)
                {
                    Some(t) : String::eq(t, &d.key.root),
                    None    : false,
                };
                bool meets = through_root || (String::eq(
                    &d.key.root,
                    &sk.root,
                ) && overlap3(&d.key.path, &sk.path) != Ov::OvNo);
                clash = d.v != Tri::F && meets && !permitted(mode, d.key.mode);
            }
            if (clash)
            {
                usize line = b.current_line;
                String root = String::clone(&sk.root);
                String hn = String::clone(h);
                String tn = match (&through)
                {
                    Some(t) : String::clone(t),
                    None    : String::new(),
                };
                b.rep.checks += 1;
                b.rep.undecided += 1;
                Vec::push(
                    &mut b.rep.events,
                    sprintf("U\t%v\t%s\t%s\t%s\t%v", line, &root, mode_debug(mode), &hn, line),
                );
                rep_left(
                    b,
                    sprintf(
                        "line %v: an access through a reference that `%s` keeps, which a reference may reach",
                        line,
                        shown_name(String::as_view(&tn)),
                    ),
                );
                return;
            }
        }
    }
}

// D-0290: whether a result that holds references in data reaches only
// what the parameters do (`*p`), which is what a caller takes it to hold;
// one holding this frame's places, or what is unknown, is not. A result
// holding no references needs no test. Reported to the run when it does
// not; `true` when a holder it moves out has its facts followed so.
fn result_reach_ok(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Option<Type>, shared> rt,
) : bool
{
    bool data = match (rt)
    {
        Some(t) : data_type(b, it, t),
        None    : false,
    };
    if (!data || !b.report || b.flow.unreachable)
    {
        return false;
    }
    bool ok = Option::is_none(&b.closure_ret);
    if (ok)
    {
        match (inherited_facts(b, it, e, 0))
        {
            None    : {},
            Some(v) :
            {
                ok = Vec::len(&v) > 0;
                for (usize i = 0; i < Vec::len(&v) && ok; i += 1)
                {
                    ok = match (String::strip_prefix(&v[i].key.root, "*"))
                    {
                        Some(p) : !StringView::starts_with(
                            p,
                            "*",
                        ) && HashSet::contains(&b.params, &String::from_view(p)),
                        None : false,
                    };
                }
            },
        }
    }
    if (!ok)
    {
        rep_left(
            b,
            sprintf("line %v: the result holds references to what is not a parameter's (D-0290)", b.current_line),
        );
    }
    ok
}

// D-0290: the binding a place written belongs to, and whether the place is
// reached through a reference (`*r`, `r.f`, `p[i]` of a reference `p`, a
// raw pointer), not a place of the binding itself. A whole reference
// binding assigned (`r = &x`) is rebound, not written through.
struct StoreTarget
{
    String name;
    bool through;
}

fn store_target(ref<Body, shared> b, ref<Expr, shared> lhs) : Option<StoreTarget>
{
    ref<Expr, shared> e = strip_parens_tc(lhs);
    bool through = false;
    bool projected = false;
    while (true)
    {
        match (&e.kind)
        {
            ExprKind::EField(f)  :
            {
                projected = true;
                e = strip_parens_tc(&Box::get(f).e);
            },
            ExprKind::EIndex(p)  :
            {
                projected = true;
                e = strip_parens_tc(&Box::get(p).a);
            },
            ExprKind::EDeref(x)  :
            {
                through = true;
                e = strip_parens_tc(Box::get(x));
            },
            // A raw pointer moved along (`*(v.ptr + i)`): its base.
            ExprKind::EBinary(x) :
            {
                if (!through)
                {
                    return Some(StoreTarget { .name = String::new(), .through = true });
                }
                e = strip_parens_tc(&Box::get(x).a);
            },
            ExprKind::EPath(_) : match (one_seg(e))
            {
                Some(n) :
                {
                    bool via_ref = match (HashMap::get(&b.gamma, n))
                    {
                        Some(Type::TRef(_))    : true,
                        Some(Type::TSlice(_))  : true,
                        Some(Type::TRawptr(_)) : true,
                        Some(Type::TGuard(_))  : true,
                        _                      : false,
                    };
                    return Some(StoreTarget { .name = String::clone(n), .through = through || (projected && via_ref) || !is_local(
                        b,
                        n,
                    ) });
                },
                None    : return Some(StoreTarget { .name = String::new(), .through = true }),
            },
            _                    : return Some(StoreTarget { .name = String::new(), .through = true }),
        }
    }
    None
}

// D-0290: a value holding references (`facts`, what it holds) stored into
// a holder `n` (whole when `whole`) or through a reference. Into a holder
// its facts are added -- an element or field replaced may have held any
// of the old ones, which then hold on some paths only; a whole assignment
// replaces them. Through a reference it is an escape, the run's, unless
// what it holds was read out of that same data (`**q`).
fn holder_store(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> n,
    bool through,
    bool whole,
    ref<Expr, shared> rhs,
    Option<Vec<DerivFact>> facts,
) : Result<void, String>
{
    if (b.flow.unreachable)
    {
        return Ok(());
    }
    bool report = b.report;
    if (!through && is_holder(b, it, n))
    {
        if (whole)
        {
            Option<HashMap<String, DerivFact>> prev = match (HashMap::get(&b.flow.deriv, n))
            {
                Some(m) : if (HashMap::len(m) > 0) { Some(HashMap::clone(m)) } else { None },
                None    : None,
            };
            set_deriv(b, n, Vec::new());
            b.prev_facts = match (prev)
            {
                Some(m) : Some(PrevFacts { .name = String::clone(n), .facts = m }),
                None    : None,
            };
            Result<void, String> r = match (facts)
            {
                Some(v) :
                {
                    if (facts_known(&v))
                    {
                        b.prev_facts = None;
                        Vec<DerivFact> w = through_refs(b, v);
                        set_deriv_tri(b, n, w);
                        Ok(())
                    }
                    else
                    {
                        tier_inherit(b, it, n, Some(rhs))
                    }
                },
                None    : tier_inherit(b, it, n, Some(rhs)),
            };
            b.prev_facts = None;
            return r;
        }
        match (HashMap::get_mut(&mut b.flow.deriv, n))
        {
            Some(m) :
            {
                for (usize k = 0; k < HashMap::len(m); k += 1)
                {
                    ref<String, shared> code = HashMap::key_at(m, k);
                    String c = String::clone(code);
                    ref<DerivFact, exclusive> d = Option::expect(HashMap::get_mut(m, &c), "a fact");
                    if (d.v == Tri::T)
                    {
                        d.v = Tri::U;
                    }
                }
            },
            None    : {},
        }
        match (facts)
        {
            None    : {},
            Some(v) :
            {
                if (facts_known(&v))
                {
                    Vec<DerivFact> w = through_refs(b, v);
                    add_deriv_tri(b, n, w);
                }
                else if (report)
                {
                    rep_left(
                        b,
                        sprintf(
                            "line %v: what is stored into `%s` holds references not known before the run",
                            b.current_line,
                            n,
                        ),
                    );
                }
            },
        }
        return Ok(());
    }
    String own = sprintf("**%s", n);
    bool inside = match (&facts)
    {
        None    : true,
        Some(v) :
        {
            bool all = Vec::len(v) > 0;
            for (usize i = 0; i < Vec::len(v) && all; i += 1)
            {
                all = String::eq(&v[i].key.root, &own);
            }
            all
        },
    };
    if (!inside && through && HashSet::contains(&b.params, n) && caller_sees(b, &facts))
    {
        inside = true;
    }
    bool data = match (HashMap::get(&b.gamma, n))
    {
        Some(t) :
        {
            Type tt = clone(t);
            data_type(b, it, &tt)
        },
        None    : true,
    };
    if (!inside && report && (through || data))
    {
        rep_left(
            b,
            sprintf("line %v: a reference is stored where this frame does not hold it (D-0290)", b.current_line),
        );
    }
    Ok(())
}

// D-0290: facts a holder takes, with each rooted at `*q` for a reference
// binding `q` of this frame that holds facts replaced by those: the
// holder keeps what `q` reaches after `q` ends.
fn through_refs(ref<Body, shared> b, Vec<DerivFact> v) : Vec<DerivFact>
{
    Vec<DerivFact> out = Vec::new();
    for (usize i = 0; i < Vec::len(&v); i += 1)
    {
        ref<DerivFact, shared> f = &v[i];
        Option<String> q = match (String::strip_prefix(&f.key.root, "*"))
        {
            Some(qv) :
            {
                String qs = String::from_view(qv);
                if (!StringView::starts_with(qv, "*") && !HashSet::contains(&b.params, &qs) && local_is_ref(b, &qs))
                {
                    Some(qs)
                }
                else
                {
                    None
                }
            },
            None     : None,
        };
        Vec<DerivFact> held = match (&q)
        {
            Some(qs) : facts_of(b, qs, false),
            None     : Vec::new(),
        };
        if (Vec::len(&held) == 0)
        {
            Vec::push(&mut out, clone(f));
            continue;
        }
        for (usize k = 0; k < Vec::len(&held); k += 1)
        {
            if (held[k].v == Tri::F)
            {
                continue;
            }
            Vec<PElem> p = clone(&held[k].key.path);
            Vec::append(&mut p, clone(&f.key.path));
            Mode m = if (f.key.mode == Mode::Shared) { Mode::Shared } else { held[k].key.mode };
            Tri t = if (f.v == Tri::T) { held[k].v } else { Tri::U };
            Vec::push(&mut out, fact(String::clone(&held[k].key.root), p, m, t));
        }
    }
    out
}

// D-0290: whether a value stored through a reference holds only what the
// caller sees given (a parameter's referent `*q`, what one keeps `**q`)
// or static data: every call adds what its other arguments reach to a
// holder it gives exclusively, and leaves to the run one it gives that is
// no holder of its own.
fn caller_sees(ref<Body, shared> b, ref<Option<Vec<DerivFact>>, shared> facts) : bool
{
    match (facts)
    {
        None    : true,
        Some(v) :
        {
            if (Vec::len(v) == 0)
            {
                return false;
            }
            for (usize i = 0; i < Vec::len(v); i += 1)
            {
                ref<String, shared> root = &v[i].key.root;
                StringView p = strip_stars(String::as_view(root));
                usize stars = String::len(root) - StringView::len(p);
                if (!(String::starts_with(
                    root,
                    "*",
                ) && stars <= 2 && HashSet::contains(&b.params, &String::from_view(p))))
                {
                    return false;
                }
            }
            true
        },
    }
}

// D-0290: a holder moved anywhere its facts do not follow (an argument, a
// field, a `return`) takes what it holds out of this analysis' sight: the
// run's, unless `drop` ends it here.
fn holder_leaves(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> x)
{
    if (!b.holding && !b.joining && b.report && is_holder(b, it, x) && has_live_fact(b, x))
    {
        rep_left(b, sprintf("line %v: `%s` leaves this frame holding references (D-0290)", b.current_line, x));
    }
}

// D-0289: whether `callee` is the `std` function `key`.
fn is_std_fn(ref<Items, shared> it, ref<Expr, shared> callee, str key) : bool
{
    match (resolve_fn_path(it, callee))
    {
        Some(k) : String::eq_str(&k, key),
        None    : false,
    }
}

fn is_std_fn_in(ref<Items, shared> it, ref<Expr, shared> callee, slice<str, shared> keys) : bool
{
    String found = match (resolve_fn_path(it, callee))
    {
        Some(k) : k,
        None    : return false,
    };
    foreach (k in keys)
    {
        if (String::eq_str(&found, *k))
        {
            return true;
        }
    }
    false
}

// Whether a resolved callee is one of `keys`.
fn key_in(ref<Option<String>, shared> k, slice<str, shared> keys) : bool
{
    match (k)
    {
        Some(found) :
        {
            foreach (x in keys)
            {
                if (String::eq_str(found, *x))
                {
                    return true;
                }
            }
            false
        },
        None        : false,
    }
}

// `may_hold_excl_ref`, worked out once per type.
fn excl_cached(ref<Body, exclusive> b, ref<Items, shared> it, ref<Type, shared> t) : bool
{
    String code = type_code(t);
    match (HashMap::get(&b.facts.excl_memo, &code))
    {
        Some(v) : return *v,
        None    : {},
    }
    bool v = may_hold_excl_ref(it, t);
    HashMap::insert(&mut b.facts.excl_memo, code, v);
    v
}

// D-0289: the local holding thread handles that `e` names or takes handles
// out of (`hs`, `&mut hs`, `Vec::pop(&mut hs)`, a `foreach`'s drain and
// take of it), and the facts it holds: a handle taken out of it holds what
// its thread was lent.
struct HandleHolder
{
    String name;
    Vec<DerivFact> facts;
}

fn handle_holder_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e0) : Option<HandleHolder>
{
    ref<Expr, shared> e = strip_parens_tc(e0);
    String name = match (&e.kind)
    {
        ExprKind::EPath(_) : match (one_seg(e))
        {
            Some(n) : if (is_local(b, n)) { String::clone(n) } else { return None },
            None    : return None,
        },
        ExprKind::EBorrow(x) : return handle_holder_of(b, it, &Box::get(x).e),
        ExprKind::EIndex(p)  : return handle_holder_of(b, it, &Box::get(p).a),
        ExprKind::ECall(cb)  :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            if (Vec::len(&c.args) == 0)
            {
                return None;
            }
            bool internal = match (one_seg(&c.callee))
            {
                Some(n) : String::eq_str(n, "$each_drain") || String::eq_str(n, "$each_take"),
                None    : false,
            };
            bool takes = is_std_fn_in(
                it,
                &c.callee,
                &[
                    "std::Vec::pop",
                    "std::Vec::remove",
                    "std::Vec::swap_remove",
                    "std::Vec::drain",
                    "std::Drain::take",
                    "std::Option::unwrap",
                    "std::Option::expect",
                ][0..$],
            );
            if (!(internal || takes))
            {
                return None;
            }
            return handle_holder_of(b, it, &c.args[0]);
        },
        _                    : return None,
    };
    Type t = lookup_local(b, &name)?;
    if (!holds_handle(&t))
    {
        return None;
    }
    if (!HashMap::contains(&b.flow.deriv, &name))
    {
        return None;
    }
    Vec<DerivFact> facts = holder_facts(b, &name);
    if (Vec::len(&facts) == 0)
    {
        return None;
    }
    Some(HandleHolder { .name = name, .facts = facts })
}

// D-0289: `r` holds `facts` besides what it held (a handle pushed onto a
// `Vec` of handles).
fn add_deriv_tri(ref<Body, exclusive> b, ref<String, shared> r, Vec<DerivFact> facts)
{
    if (b.flow.unreachable || Vec::len(&facts) == 0)
    {
        return;
    }
    ref<HashMap<String, DerivFact>, exclusive> m = HashMap::entry(&mut b.flow.deriv, String::clone(r), HashMap::new());
    for (usize i = 0; i < Vec::len(&facts); i += 1)
    {
        Tri v = facts[i].v;
        ref<DerivFact, exclusive> e = HashMap::entry(m, deriv_code(&facts[i].key), clone(&facts[i]));
        if (e.v != v)
        {
            e.v = if (e.v == Tri::T || v == Tri::T) { Tri::T } else { Tri::U };
        }
    }
}

// D-0289: what a thread's handle holds: what `spawn_facts_of` gives, and
// what the closure it runs captured (D-0288), with their truth.
fn spawn_facts_tri_of(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e) : Vec<DerivFact>
{
    Vec<DerivFact> v = Vec::new();
    Vec<DerivKey> keys = spawn_facts_of(b, it, e);
    for (usize i = 0; i < Vec::len(&keys); i += 1)
    {
        Vec::push(&mut v, DerivFact { .key = clone(&keys[i]), .v = Tri::T });
    }
    match (call_args(e))
    {
        Some(args) :
        {
            if (Vec::len(args) > 0)
            {
                ref<Expr, shared> f = &args[0];
                if (is_closure(f))
                {
                    Vec::append(&mut v, closure_facts_of(b, it, f));
                }
                else
                {
                    bool local_fn = match (one_seg(strip_parens_tc(f)))
                    {
                        Some(n) : is_local(b, n),
                        None    : false,
                    };
                    if (local_fn)
                    {
                        Vec::append(&mut v, fn_value_facts(b, it, f));
                    }
                }
            }
        },
        None       : {},
    }
    v
}

// D-0289: `r` takes a new value while a thread's handle holds a lend
// through it (`spawn(f, r)`, a closure capturing `r`): the fact names
// `*r`, which now means something else, and the thread still holds the
// old referent. The run checks it.
fn handle_lend_through(ref<Body, exclusive> b, ref<String, shared> r)
{
    if (!b.report || b.flow.unreachable)
    {
        return;
    }
    String rr = referent_root(String::as_view(r));
    bool held = false;
    for (usize i = 0; i < HashMap::len(&b.flow.deriv) && !held; i += 1)
    {
        ref<String, shared> h = HashMap::key_at(&b.flow.deriv, i);
        if (String::eq(h, r))
        {
            continue;
        }
        bool is_handle = match (HashMap::get(&b.gamma, h))
        {
            Some(Type::THandle(_)) : true,
            _                      : false,
        };
        if (!is_handle)
        {
            continue;
        }
        ref<HashMap<String, DerivFact>, shared> f = HashMap::value_at(&b.flow.deriv, i);
        for (usize k = 0; k < HashMap::len(f) && !held; k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(f, k);
            held = String::eq(&d.key.root, &rr) && d.v != Tri::F;
        }
    }
    if (held)
    {
        rep_left(
            b,
            sprintf(
                "line %v: `%s` is given a new referent while a thread holds what it was lent through it",
                b.current_line,
                r,
            ),
        );
    }
}

// The declared parameter types of the function `e` names, if any.
fn fn_param_types(ref<Items, shared> it, ref<Expr, shared> e) : Option<Vec<Type>>
{
    String k = resolve_fn_path(it, e)?;
    ref<FnDecl, shared> fd = Option::expect(HashMap::get(&it.fns, &k), "a function");
    Vec<Type> ps = Vec::new();
    for (usize i = 0; i < Vec::len(&fd.params); i += 1)
    {
        Vec::push(&mut ps, clone(&fd.params[i].ty));
    }
    Some(ps)
}

fn local_type_holds_guard(ref<Body, shared> b, ref<String, shared> n) : bool
{
    match (HashMap::get(&b.gamma, n))
    {
        Some(t) : holds_guard(t),
        None    : false,
    }
}

// D-0289 scoped lending: a thread is lent what it reaches statically only
// while a binding of this frame holds its handle (no thread outlives its
// handle's frame, spec/19). A spawn whose handle goes anywhere else while
// it lends, or whose closure takes a guard to another thread (D-0240: a
// lock path stays its locking thread's), is the run's to check.
fn tier_spawn_rule(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> callee, ref<Vec<Expr>, shared> args)
{
    if (!b.report || b.flow.unreachable || Vec::len(args) == 0)
    {
        return;
    }
    Expr whole = mk(
        ExprKind::ECall(Box::new(CallExpr { .callee = clone(callee), .args = clone(args) })),
        callee.line,
        callee.col,
    );
    bool lends = Vec::len(&spawn_facts_tri_of(b, it, &whole)) > 0;
    for (usize i = 1; i < Vec::len(args) && !lends; i += 1)
    {
        lends = arg_may_be_reference(b, it, &args[i]);
    }
    // A lent argument that forms no fact (a slice or a view binding passed
    // whole, D-0247; a value holding references) is not seen.
    for (usize i = 1; i < Vec::len(args); i += 1)
    {
        ref<Expr, shared> a = &args[i];
        bool visible = Option::is_some(&deriv_facts_of(b, it, a));
        bool lent_ref = match (one_seg(strip_parens_tc(a)))
        {
            Some(n) : flow_is_tracked(&b.flow, n) && local_is_ref(b, n),
            None    : false,
        };
        if (arg_may_be_reference(b, it, a) && !visible && !lent_ref)
        {
            rep_left(b, sprintf("line %v: a thread is lent a reference no fact describes", callee.line));
            break;
        }
    }
    // A thread reading, through a shared reference it is lent, an exclusive
    // one this thread holds: the run's.
    Option<Vec<Type>> params = fn_param_types(it, &args[0]);
    for (usize i = 1; i < Vec::len(args); i += 1)
    {
        Option<Type> t = match (&params)
        {
            Some(ps) : if (i - 1 < Vec::len(ps)) { Some(clone(&ps[i - 1])) } else { value_shape(b, it, &args[i]) },
            None     : value_shape(b, it, &args[i]),
        };
        bool bad = match (&t)
        {
            Some(tt) : excl_under_shared(it, tt, false, &mut new_name_set()),
            None     : false,
        };
        if (bad)
        {
            rep_left(b, sprintf("line %v: a thread is lent an exclusive reference through a shared one", callee.line));
            break;
        }
    }
    match (&strip_parens_tc(&args[0]).kind)
    {
        ExprKind::EClosure(cb) :
        {
            ref<Vec<String>, shared> caps = &Box::get(cb).captures;
            bool bad = false;
            for (usize i = 0; i < Vec::len(caps) && !bad; i += 1)
            {
                bad = match (HashMap::get(&b.gamma, &caps[i]))
                {
                    Some(t) : excl_under_shared(it, t, false, &mut new_name_set()),
                    None    : false,
                };
            }
            if (bad)
            {
                rep_left(
                    b,
                    sprintf("line %v: a thread is lent an exclusive reference through a shared one", callee.line),
                );
            }
        },
        _                      : {},
    }
    if (lends && !HashSet::contains(&b.bound_spawns, &site_key(callee.line, callee.col)))
    {
        rep_left(
            b,
            sprintf("line %v: a thread is lent references and its handle is not held by this frame", callee.line),
        );
    }
    // A guard given to the thread as an argument goes there as one captured
    // does.
    bool guard_param = match (&strip_parens_tc(&args[0]).kind)
    {
        ExprKind::EClosure(cb) :
        {
            ref<Vec<ParamDecl>, shared> ps = &Box::get(cb).params;
            bool any = false;
            for (usize i = 0; i < Vec::len(ps) && !any; i += 1)
            {
                any = holds_guard(&ps[i].ty);
            }
            any
        },
        _ : match (&params)
        {
            Some(ps) :
            {
                bool any = false;
                for (usize i = 0; i < Vec::len(ps) && !any; i += 1)
                {
                    any = holds_guard(&ps[i]);
                }
                any
            },
            None     : false,
        },
    };
    bool guard_arg = false;
    for (usize i = 1; i < Vec::len(args) && !guard_arg; i += 1)
    {
        guard_arg = match (one_seg(strip_parens_tc(&args[i])))
        {
            Some(n) : local_type_holds_guard(b, n),
            None    : false,
        };
    }
    if (guard_param || guard_arg)
    {
        rep_left(b, sprintf("line %v: a guard is taken to another thread", callee.line));
    }
    match (&strip_parens_tc(&args[0]).kind)
    {
        ExprKind::EClosure(cb) :
        {
            ref<Vec<String>, shared> caps = &Box::get(cb).captures;
            bool any = false;
            for (usize i = 0; i < Vec::len(caps) && !any; i += 1)
            {
                any = local_type_holds_guard(b, &caps[i]);
            }
            if (any)
            {
                rep_left(b, sprintf("line %v: a guard is taken to another thread", callee.line));
            }
        },
        _                      :
        {
            bool named_fn = match (path_segs(strip_parens_tc(&args[0])))
            {
                Some(segs) : Option::is_some(&resolve_fn_path(
                    it,
                    strip_parens_tc(&args[0]),
                )) && !(Vec::len(segs) == 1 && is_local(b, &segs[0])),
                None : false,
            };
            if (!named_fn)
            {
                rep_left(
                    b,
                    sprintf("line %v: a thread runs a `fn` value, whose captures only the run knows", callee.line),
                );
            }
        },
    }
}

// A closure holds what a captured reference, view or closure reaches: a
// reference its referent `*r`, as a copy of it does (D-0071), anything
// else the capture's own facts (D-0288). A captured reference is borrowed
// itself (spec/15 §6): the binding may not be assigned while the closure
// lives.
fn closure_facts_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Vec<DerivFact>
{
    Vec<DerivFact> facts = Vec::new();
    ref<ClosureExpr, shared> c = match (&strip_parens_tc(e).kind)
    {
        ExprKind::EClosure(cb) : Box::get(cb),
        _                      : return facts,
    };
    for (usize i = 0; i < Vec::len(&c.captures); i += 1)
    {
        ref<String, shared> name = &c.captures[i];
        Option<Type> t = lookup_local(b, name);
        match (&t)
        {
            Some(Type::TRef(x)) : Vec::push(
                &mut facts,
                fact(referent_root(String::as_view(name)), Vec::new(), Box::get(x).mode, Tri::T),
            ),
            Some(Type::TSlice(x)) : Vec::push(
                &mut facts,
                fact(referent_root(String::as_view(name)), Vec::new(), Box::get(x).mode, Tri::T),
            ),
            Some(tt) :
            {
                if (may_hold_ref(it, tt, 0) && HashMap::contains(&b.flow.deriv, name))
                {
                    Vec<DerivFact> held = facts_of(b, name, false);
                    for (usize k = 0; k < Vec::len(&held); k += 1)
                    {
                        if (!is_tier_d_root(&held[k].key.root))
                        {
                            Vec::push(&mut facts, clone(&held[k]));
                        }
                    }
                }
            },
            None     : {},
        }
        if (!c.is_move && flow_is_tracked(&b.flow, name) && Option::is_some(&t))
        {
            Mode m = if (closure_body_writes(&c.body, String::as_view(name))) { Mode::Exclusive } else { Mode::Shared };
            Vec::push(&mut facts, fact(String::clone(name), Vec::new(), m, Tri::T));
        }
    }
    facts
}

// What a value copied out of a binding (not a reference) holds: the
// binding's facts, and nothing of the binding itself; anything else what it
// inherits (`fn_value_facts`'s `held`).
fn held_facts(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> a) : Vec<DerivFact>
{
    match (one_seg(strip_parens_tc(a)))
    {
        Some(n) :
        {
            if (!local_is_ref(b, n))
            {
                return facts_of(b, n, false);
            }
        },
        None    : {},
    }
    Option::unwrap_or(inherited_facts(b, it, a, 0), Vec::new())
}

// What a `fn` value that is no closure literal holds: a copy of one what
// it holds; a call's result, a closure that may have kept any argument
// that can hold a reference, what those reach, not known before the run
// (`Tri::U`: the run decides, D-0288).
fn fn_value_facts(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e) : Vec<DerivFact>
{
    ref<CallExpr, shared> c = match (&strip_parens_tc(e).kind)
    {
        ExprKind::ECall(cb) : Box::get(cb),
        _                   :
        {
            Vec<DerivFact> held = held_facts(b, it, e);
            Vec<DerivFact> out = Vec::new();
            for (usize i = 0; i < Vec::len(&held); i += 1)
            {
                if (!is_tier_d_root(&held[i].key.root))
                {
                    Vec::push(&mut out, clone(&held[i]));
                }
            }
            return out;
        },
    };
    Option<Vec<Type>> params = fn_param_types(it, &c.callee);
    Vec<DerivFact> facts = Vec::new();
    for (usize j = 0; j < Vec::len(&c.args); j += 1)
    {
        bool plain = match (&params)
        {
            Some(ps) : j < Vec::len(ps) && !may_hold_ref(it, &ps[j], 0),
            None     : false,
        };
        if (plain)
        {
            continue;
        }
        Vec<DerivFact> held = held_facts(b, it, &c.args[j]);
        for (usize i = 0; i < Vec::len(&held); i += 1)
        {
            if (!is_tier_d_root(&held[i].key.root))
            {
                Vec::push(&mut facts, DerivFact { .key = clone(&held[i].key), .v = Tri::U });
            }
        }
    }
    facts
}

// `&v[i]` on a `Vec` is `Vec::index_shared(&v, i)` (`[Index-Vec]`), an
// elided call on a borrow of `v`: derived from `v` as that call is.
fn vec_element_root(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Place>
{
    ref<PairExpr, shared> ix = match (&strip_parens_tc(e).kind)
    {
        ExprKind::EIndex(ib) : Box::get(ib),
        _                    : return None,
    };
    ref<Expr, shared> base = &ix.a;
    // A `Vec` reached through a reference (`v[i]` with `v` one, auto-
    // dereferenced, or `(*v)[i]`, `r.f[i]`): the element of its referent.
    Type bt = static_place_type(b, it, base)?;
    Type vt = clone(&bt);
    Option<Place> root = None;
    bool through = match (&bt)
    {
        Type::TRef(rb)   :
        {
            vt = clone(&Box::get(rb).inner);
            true
        },
        Type::TGuard(gb) :
        {
            vt = clone(Box::get(gb));
            true
        },
        _                : false,
    };
    if (through)
    {
        root = match (one_seg(strip_parens_tc(base)))
        {
            Some(n) : if (flow_is_tracked(
                &b.flow,
                n,
            )) { Some(Place { .root = referent_root(String::as_view(n)), .path = Vec::new() }) } else { None },
            None : None,
        };
    }
    else
    {
        root = match (place_of(b, it, base))
        {
            Some(p) : Some(p),
            None    : deref_place_of(b, it, base),
        };
    }
    if (!named_is(&vt, "std::Vec"))
    {
        return None;
    }
    Place p = root?;
    // D-0282: the element, so two of them are told apart. D-0217: every
    // element of a `Vec` of a zero-sized type is the one object anchored at
    // its buffer, one place; an element type not known here may be one.
    Vec<Type> targs = named_args(&vt);
    Option<u128> lit = if (Vec::len(&targs) > 0)
    {
        match (zero_sized(it, &targs[0], 0))
        {
            Some(false) : literal_index(&ix.b),
            Some(true)  : Some(0),
            None        : None,
        }
    }
    else { None };
    Vec::push(&mut p.path, PElem::PIndex(lit));
    Some(p)
}

// Whether `root.path` is an element of a `Vec` of a zero-sized type.
fn zero_sized_vec_element(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<String, shared> root,
    ref<Vec<PElem>, shared> path,
) : bool
{
    usize n = Vec::len(path);
    if (n == 0)
    {
        return false;
    }
    match (&path[n - 1])
    {
        PElem::PIndex(_) : {},
        _                : return false,
    }
    Vec<PElem> pre = Vec::new();
    for (usize i = 0; i + 1 < n; i += 1)
    {
        Vec::push(&mut pre, clone(&path[i]));
    }
    match (place_type(b, it, root, &pre))
    {
        Some(t) :
        {
            if (!named_is(&t, "std::Vec"))
            {
                return false;
            }
            Vec<Type> a = named_args(&t);
            Vec::len(&a) > 0 && match (zero_sized(it, &a[0], 0))
            {
                Some(z) : z,
                None    : false,
            }
        },
        None    : false,
    }
}

// Whether `t` is zero-sized (`spec/05`, D-0217): a struct whose fields
// all are, or an array of none or of a zero-sized element. `None` when it
// is not known here: a type parameter.
fn zero_sized(ref<Items, shared> it, ref<Type, shared> t, usize depth) : Option<bool>
{
    if (depth > 16)
    {
        return None;
    }
    match (t)
    {
        Type::TVoid     : Some(true),
        Type::TArray(b) :
        {
            if (Box::get(b).n == 0) { Some(true) } else { zero_sized(it, &Box::get(b).inner, depth + 1) }
        },
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(sd) :
                {
                    if (Option::is_some(&sd.bits))
                    {
                        return Some(false);
                    }
                    HashMap<String, Type> subst = zip_subst(&sd.type_params, &n.args);
                    Option<bool> all = Some(true);
                    for (usize i = 0; i < Vec::len(&sd.fields); i += 1)
                    {
                        match (zero_sized(it, &apply_subst(&sd.fields[i].ty, &subst), depth + 1))
                        {
                            Some(true)  : {},
                            Some(false) : return Some(false),
                            None        : all = None,
                        }
                    }
                    all
                },
                None     :
                {
                    if (HashMap::contains(
                        &it.enums,
                        &n.name,
                    ) || String::starts_with(&n.name, "std::")) { Some(false) } else { None }
                },
            }
        },
        _               : Some(false),
    }
}

fn tier_d_fact() : DerivFact
{
    fact(String::from_str("<tier D>"), Vec::new(), Mode::Shared, Tri::T)
}

fn tier_d_facts() : Option<Vec<DerivFact>>
{
    Vec<DerivFact> v = Vec::new();
    Vec::push(&mut v, tier_d_fact());
    Some(v)
}

fn one_fact(DerivFact f) : Option<Vec<DerivFact>>
{
    Vec<DerivFact> v = Vec::new();
    Vec::push(&mut v, f);
    Some(v)
}

// `value_shape`, or the static place type.
fn shape_or_place(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Type>
{
    match (value_shape(b, it, e))
    {
        Some(t) : Some(t),
        None    : static_place_type(b, it, e),
    }
}

fn is_view_type(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(nb) : String::eq_str(&Box::get(nb).name, "std::StringView") && Vec::len(&Box::get(nb).args) == 0,
        _                : false,
    }
}

// Every fact's path extended by `r`, its mode set when `mode` says so.
fn facts_extended(Vec<DerivFact> v, ref<PElem, shared> r, Option<Mode> mode) : Vec<DerivFact>
{
    for (usize i = 0; i < Vec::len(&v); i += 1)
    {
        match (mode)
        {
            Some(m) : v[i].key.mode = m,
            None    : {},
        }
        Vec::push(&mut v[i].key.path, clone(r));
    }
    v
}

// D-0282: the facts a reference value inherits from where it came from
// when it is not a visible borrow -- another reference binding (its facts,
// or its referent `*r` when it has none), a field or a dereference of one,
// a single-reference call on one (D-0011), `foreach`'s hidden helpers, a
// `match`/`if`/block's results. `None` when the value comes from nothing
// that can hold a reference of this frame (a call with no reference
// argument: static data), `Some(empty)` when its source is unknown (tier
// D: a reference read out of a container or a struct).
fn inherited_facts(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    usize depth,
) : Option<Vec<DerivFact>>
{
    inherited_facts_in(b, it, e, depth, None, None)
}

// `inherited_facts` inside a `match` arm: `bname` stands for what the
// scrutinee `bscrut` holds.
fn inherited_facts_in(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e0,
    usize depth,
    Option<ref<String, shared>> bname,
    Option<ref<Expr, shared>> bscrut,
) : Option<Vec<DerivFact>>
{
    if (depth > 12)
    {
        return Some(Vec::new());
    }
    ref<Expr, shared> e = strip_parens_tc(e0);
    // A sub-view (`String::view(&s, lo, hi)`, `StringView::sub`): the range
    // of its source it covers.
    match (&e.kind)
    {
        ExprKind::ECall(cb)    :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            match (path_segs(&c.callee))
            {
                Some(segs) :
                {
                    String k = String::join(&segs[0..$], "::");
                    if ((String::eq_str(
                        &k,
                        "std::String::view",
                    ) || String::eq_str(&k, "std::StringView::sub")) && Vec::len(&c.args) == 3)
                    {
                        PElem r = range_elem(&c.args[1], &c.args[2]);
                        Vec<DerivFact> v = inherited_facts_in(b, it, &c.args[0], depth + 1, bname, bscrut)?;
                        return Some(facts_extended(v, &r, None));
                    }
                },
                None       : {},
            }
        },
        // D-0290: a range of a view's bytes (`&v.bytes[i..j]`) reaches what
        // the view does, not the binding holding it.
        ExprKind::ESliceOf(sb) :
        {
            ref<SliceExpr, shared> s = Box::get(sb);
            match (&strip_parens_tc(&s.base).kind)
            {
                ExprKind::EField(fb) :
                {
                    ref<FieldExpr, shared> f = Box::get(fb);
                    bool view = match (shape_or_place(b, it, &f.e))
                    {
                        Some(t) : is_view_type(&t),
                        None    : false,
                    };
                    if (String::eq_str(&f.name, "bytes") && view)
                    {
                        PElem r = range_elem(&s.lo, &s.hi);
                        Vec<DerivFact> w = inherited_facts_in(b, it, &f.e, depth + 1, bname, bscrut)?;
                        return Some(facts_extended(w, &r, Some(s.mode)));
                    }
                },
                _                    : {},
            }
        },
        _                      : {},
    }
    match (deriv_facts_of(b, it, e))
    {
        Some(k) : return one_fact(DerivFact { .key = k, .v = Tri::T }),
        None    : {},
    }
    match (&e.kind)
    {
        ExprKind::EPath(pb)      :
        {
            ref<Vec<String>, shared> segs = &Box::get(pb).segs;
            if (Vec::len(segs) == 1)
            {
                bool is_binder = match (bname)
                {
                    Some(bn) : String::eq(bn, &segs[0]),
                    None     : false,
                };
                if (is_binder)
                {
                    return match (bscrut)
                    {
                        Some(sc) : inherited_facts_in(b, it, sc, depth + 1, None, None),
                        None     : None,
                    };
                }
            }
            // A name that is no local of this frame (`None`, a constant):
            // static data.
            if (Vec::len(segs) != 1 || !HashMap::contains(&b.gamma, &segs[0]))
            {
                return None;
            }
            ref<String, shared> r = &segs[0];
            // Through a reference binding: a reborrow of its referent `*r`
            // (D-0071), which keeps `r` itself alive; a copied view or
            // `Option` of a reference holds what it holds.
            if (!local_is_ref(b, r))
            {
                if (HashMap::contains(&b.flow.deriv, r))
                {
                    return Some(facts_of(b, r, false));
                }
                // A holder holding nothing (D-0290).
                if (is_holder(b, it, r))
                {
                    return None;
                }
            }
            Type t = Option::expect(lookup_local(b, r), "a local");
            match (&t)
            {
                Type::TRef(x) : return one_fact(fact(
                    referent_root(String::as_view(r)),
                    Vec::new(),
                    Box::get(x).mode,
                    Tri::T,
                )),
                Type::TSlice(x) : return one_fact(fact(
                    referent_root(String::as_view(r)),
                    Vec::new(),
                    Box::get(x).mode,
                    Tri::T,
                )),
                _ : {},
            }
            if (holds_ref(it, &t))
            {
                return one_fact(fact(referent_root(String::as_view(r)), Vec::new(), Mode::Shared, Tri::T));
            }
            // D-0291: a parameter given by value that keeps references in
            // data holds what its caller put there.
            if (HashSet::contains(&b.params, r) && data_type(b, it, &t))
            {
                return one_fact(fact(referent_root(String::as_view(r)), Vec::new(), Mode::Shared, Tri::T));
            }
            // An owner of this frame (`&v[0].f` reaches `v`).
            if (flow_is_tracked(&b.flow, r))
            {
                return one_fact(fact(String::clone(r), Vec::new(), Mode::Shared, Tri::T));
            }
            Some(Vec::new())
        },
        ExprKind::EField(fb)     :
        {
            ref<Expr, shared> base = &Box::get(fb).e;
            // A reference read out of a field of an aggregate that holds
            // references (`h.r` of a `struct Hold`): a stored reference,
            // which reaches what its holder holds (D-0290), else tier D.
            bool data = match (shape_or_place(b, it, base))
            {
                Some(t) : data_type(b, it, &t),
                None    : false,
            };
            if (data)
            {
                return match (stored_facts(b, it, base, 0))
                {
                    Some(v) : if (Vec::len(&v) == 0) { None } else { Some(v) },
                    None    : tier_d_facts(),
                };
            }
            inherited_facts_in(b, it, base, depth + 1, bname, bscrut)
        },
        ExprKind::EDeref(x)      : inherited_facts_in(b, it, Box::get(x), depth + 1, bname, bscrut),
        // D-0291: `e?` gives `e`'s payload, which holds what `e` holds.
        ExprKind::EPropagate(x)  : inherited_facts_in(b, it, Box::get(x), depth + 1, bname, bscrut),
        ExprKind::EBorrow(bb)    : inherited_borrow(b, it, &Box::get(bb).e, Box::get(bb).mode, depth, bname, bscrut),
        ExprKind::ESliceOf(sb)   : inherited_borrow(b, it, &Box::get(sb).base, Box::get(sb).mode, depth, bname, bscrut),
        ExprKind::ECall(cb)      : inherited_call(b, it, Box::get(cb), depth, bname, bscrut),
        ExprKind::EIf(ib)        :
        {
            // A branch that does not complete (or holds nothing of this
            // frame) adds nothing; the facts are certain when one branch
            // gives them all, unknown when branches differ.
            ref<IfExpr, shared> x = Box::get(ib);
            Vec<Vec<DerivFact>> parts = Vec::new();
            match (&x.then_.tail)
            {
                Some(t) : match (inherited_facts_in(b, it, Box::get(t), depth + 1, bname, bscrut))
                {
                    Some(v) :
                    {
                        if (Vec::len(&v) == 0)
                        {
                            return Some(Vec::new());
                        }
                        Vec::push(&mut parts, v);
                    },
                    None    : {},
                },
                None : {},
            }
            match (&x.else_)
            {
                Some(e2) : match (inherited_facts_in(b, it, e2, depth + 1, bname, bscrut))
                {
                    Some(v) :
                    {
                        if (Vec::len(&v) == 0)
                        {
                            return Some(Vec::new());
                        }
                        Vec::push(&mut parts, v);
                    },
                    None    : {},
                },
                None : {},
            }
            // Every branch static data (`if (b) { "x" } else { "y" }`): so
            // is the result, not an unknown source.
            if (Vec::len(&parts) == 0)
            {
                return None;
            }
            Some(flatten_parts(parts))
        },
        ExprKind::EBlock(blk) : match (&blk.tail)
        {
            Some(t) : inherited_facts_in(b, it, Box::get(t), depth + 1, bname, bscrut),
            None    : None,
        },
        ExprKind::EMatch(mb)     :
        {
            ref<MatchExpr, shared> m = Box::get(mb);
            Vec<Vec<DerivFact>> out = Vec::new();
            for (usize i = 0; i < Vec::len(&m.arms); i += 1)
            {
                ref<Arm, shared> a = &m.arms[i];
                ref<Expr, shared> body = strip_parens_tc(Box::get(&a.body));
                // An arm whose result is its binder gives what the
                // scrutinee holds.
                bool binder_result = match (&a.binder)
                {
                    Some(bn) : match (&body.kind)
                    {
                        ExprKind::EPath(_) : match (one_seg(body))
                        {
                            Some(n) : String::eq(n, bn),
                            None    : false,
                        },
                        ExprKind::EBlock(blk) : Vec::len(&blk.stmts) == 0 && match (&blk.tail)
                        {
                            Some(t) : match (one_seg(strip_parens_tc(Box::get(t))))
                            {
                                Some(n) : String::eq(n, bn),
                                None    : false,
                            },
                            None : false,
                        },
                        _ : false,
                    },
                    None : false,
                };
                Option<Vec<DerivFact>> got = if (binder_result)
                {
                    inherited_facts_in(b, it, &m.scrut, depth + 1, bname, bscrut)
                }
                else
                {
                    match (&a.binder)
                    {
                        Some(bn) : inherited_facts_in(b, it, Box::get(&a.body), depth + 1, Some(bn), Some(&m.scrut)),
                        None     : inherited_facts_in(b, it, Box::get(&a.body), depth + 1, bname, bscrut),
                    }
                };
                match (got)
                {
                    Some(v) :
                    {
                        if (Vec::len(&v) == 0)
                        {
                            return Some(Vec::new());
                        }
                        Vec::push(&mut out, v);
                    },
                    None    : {},
                }
            }
            if (Vec::len(&out) == 0)
            {
                return None;
            }
            Some(flatten_parts(out))
        },
        // A branch that does not complete gives nothing.
        ExprKind::EReturn(_)     : None,
        ExprKind::EBreak         : None,
        ExprKind::EContinue      : None,
        ExprKind::EStr(_)        : None,
        // An element read out of a container of references, or a reference
        // out of a struct's field (a value, not a binding of this frame): a
        // stored reference, which reaches what its holder holds (D-0290),
        // else tier D.
        ExprKind::EIndex(pb) : match (stored_facts(b, it, &Box::get(pb).a, 0))
        {
            Some(v) : if (Vec::len(&v) == 0) { None } else { Some(v) },
            None    : tier_d_facts(),
        },
        // A literal holds what its parts hold (D-0290).
        ExprKind::EStructLit(sl) :
        {
            Vec<ref<Expr, shared>> parts = Vec::new();
            ref<Vec<FieldInit>, shared> fs = &Box::get(sl).fields;
            for (usize i = 0; i < Vec::len(fs); i += 1)
            {
                Vec::push(&mut parts, &fs[i].value);
            }
            union_facts(b, it, &parts, depth, bname, bscrut)
        },
        ExprKind::EArrayLit(xs)  :
        {
            Vec<ref<Expr, shared>> parts = Vec::new();
            for (usize i = 0; i < Vec::len(xs); i += 1)
            {
                Vec::push(&mut parts, &xs[i]);
            }
            union_facts(b, it, &parts, depth, bname, bscrut)
        },
        _                        : Some(Vec::new()),
    }
}

// Several branches' facts as one: certain when one branch gives them all,
// unknown when branches differ.
fn flatten_parts(Vec<Vec<DerivFact>> parts) : Vec<DerivFact>
{
    bool single = Vec::len(&parts) == 1;
    Vec<DerivFact> out = Vec::new();
    for (usize i = 0; i < Vec::len(&parts); i += 1)
    {
        for (usize k = 0; k < Vec::len(&parts[i]); k += 1)
        {
            DerivFact f = clone(&parts[i][k]);
            if (!single)
            {
                f.v = Tri::U;
            }
            Vec::push(&mut out, f);
        }
    }
    out
}

// `inherited_facts_in` of a borrow or slice: the projection down to the
// reference it goes through: its fields, cut at the first index (an
// element is inside the container the path names so far).
fn inherited_borrow(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> inner,
    Mode m,
    usize depth,
    Option<ref<String, shared>> bname,
    Option<ref<Expr, shared>> bscrut,
) : Option<Vec<DerivFact>>
{
    ref<Expr, shared> base = strip_parens_tc(inner);
    Vec<String> fields = Vec::new();
    while (true)
    {
        match (&base.kind)
        {
            ExprKind::EField(fb) :
            {
                Vec::push(&mut fields, String::clone(&Box::get(fb).name));
                base = strip_parens_tc(&Box::get(fb).e);
            },
            ExprKind::EIndex(pb) :
            {
                Vec::clear(&mut fields);
                base = strip_parens_tc(&Box::get(pb).a);
            },
            ExprKind::EDeref(x)  : base = strip_parens_tc(Box::get(x)),
            _                    : break,
        }
    }
    Vec::reverse(&mut fields);
    // A borrow of a temporary (`&padded()[0 .. $]`): it ends with the
    // statement (D-0135).
    match (&base.kind)
    {
        ExprKind::ECall(cb) :
        {
            // A constant (`&HALF`) is static data, not a temporary.
            bool is_const = match (resolve_fn_path(it, &Box::get(cb).callee))
            {
                Some(k) : Option::expect(HashMap::get(&it.fns, &k), "a function").is_const,
                None    : false,
            };
            bool plain_value = match (value_shape(b, it, base))
            {
                Some(t) : !is_borrow_ty(&t) && !holds_ref(it, &t),
                None    : false,
            };
            if (!is_const && plain_value)
            {
                return one_fact(fact(String::from_str("<temporary>"), Vec::new(), m, Tri::T));
            }
        },
        _                   : {},
    }
    Vec<DerivFact> v = inherited_facts_in(b, it, base, depth + 1, bname, bscrut)?;
    for (usize i = 0; i < Vec::len(&v); i += 1)
    {
        v[i].key.mode = m;
        for (usize k = 0; k < Vec::len(&fields); k += 1)
        {
            Vec::push(&mut v[i].key.path, PElem::PField(String::clone(&fields[k])));
        }
    }
    Some(v)
}

fn is_hashmap_ref(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(Type::TRef(rb)) : named_is(&Box::get(rb).inner, "std::HashMap"),
        _                    : false,
    }
}

// What the references stored in the place the first reference argument
// reaches hold (D-0290): a holder's facts, `**q` through a parameter `q`;
// `None`, tier D.
fn stored_in(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> a) : Option<Vec<DerivFact>>
{
    match (&strip_parens_tc(a).kind)
    {
        ExprKind::EBorrow(x)  : stored_facts(b, it, &Box::get(x).e, 0),
        ExprKind::ESliceOf(x) : stored_facts(b, it, &Box::get(x).base, 0),
        _                     : stored_facts(b, it, a, 0),
    }
}

fn is_plain_literal(ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EInt(_)   : true,
        ExprKind::EFloat(_) : true,
        ExprKind::EBool(_)  : true,
        ExprKind::EStr(_)   : true,
        ExprKind::EUnit     : true,
        _                   : false,
    }
}

// `inherited_facts_in` of a call.
fn inherited_call(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<CallExpr, shared> c,
    usize depth,
    Option<ref<String, shared>> bname,
    Option<ref<Expr, shared>> bscrut,
) : Option<Vec<DerivFact>>
{
    ref<Vec<Expr>, shared> args = &c.args;
    match (one_seg(&c.callee))
    {
        Some(n) :
        {
            if (String::starts_with(n, "$each"))
            {
                // What the loop walks: its reference arguments (a hidden
                // index is a number, not a source). Over a `HashMap`, a key
                // binder reaches its `keys` and a value binder its `values`.
                Option<Type> a0 = if (Vec::len(args) > 0) { shape_or_place(b, it, &args[0]) } else { None };
                Option<str> map_field = None;
                if (is_hashmap_ref(&a0))
                {
                    if (String::eq_str(n, "$each_take_key") || String::eq_str(n, "$each_key"))
                    {
                        map_field = Some("keys");
                    }
                    else if (String::eq_str(
                        n,
                        "$each_take",
                    ) || String::eq_str(n, "$each_at") || String::eq_str(n, "$each_at_mut"))
                    {
                        map_field = Some("values");
                    }
                }
                Vec<DerivFact> out = Vec::new();
                for (usize i = 0; i < Vec::len(args); i += 1)
                {
                    ref<Expr, shared> a = strip_parens_tc(&args[i]);
                    bool is_value = match (&a.kind)
                    {
                        ExprKind::EPath(_) : match (one_seg(a))
                        {
                            Some(p) : match (HashMap::get(&b.gamma, p))
                            {
                                Some(t) : !is_borrow_ty(t) && !holds_ref(it, t) && !is_named_ty(t),
                                None    : false,
                            },
                            None : false,
                        },
                        ExprKind::EInt(_)    : true,
                        ExprKind::EBinary(_) : true,
                        _                    : false,
                    };
                    if (is_value)
                    {
                        continue;
                    }
                    Vec::append(
                        &mut out,
                        Option::unwrap_or(inherited_facts_in(b, it, a, depth + 1, bname, bscrut), Vec::new()),
                    );
                    // An element of a holder (D-0290): what it holds.
                    ref<Expr, shared> place = match (&a.kind)
                    {
                        ExprKind::EBorrow(x) : &Box::get(x).e,
                        _                    : a,
                    };
                    bool data = match (shape_or_place(b, it, place))
                    {
                        Some(t) : data_type(b, it, &t),
                        None    : false,
                    };
                    if (data)
                    {
                        match (stored_facts(b, it, place, 0))
                        {
                            Some(v) : Vec::append(&mut out, v),
                            None    : return tier_d_facts(),
                        }
                    }
                }
                match (map_field)
                {
                    Some(fl) :
                    {
                        for (usize i = 0; i < Vec::len(&out); i += 1)
                        {
                            Vec::push(&mut out[i].key.path, PElem::PField(String::from_str(fl)));
                        }
                    },
                    None     : {},
                }
                return Some(out);
            }
        },
        None    : {},
    }
    String key = match (resolve_fn_path(it, &c.callee))
    {
        Some(k) : k,
        None    :
        {
            // A variant made of its payload (`Some(v)`, `Ok(r)`) holds what
            // the payload holds; it was taken for static data, and
            // `Some(String::as_view(&s))` held nothing (D-0288).
            ref<Vec<String>, shared> segs = path_segs(&c.callee)?;
            if (Vec::len(segs) == 0)
            {
                return None;
            }
            ref<String, shared> last = &segs[Vec::len(segs) - 1];
            bool variant = HashMap::contains(&it.enum_of_variant, last);
            if (!variant && Vec::len(segs) > 1)
            {
                String en = String::join(&segs[0..Vec::len(segs) - 1], "::");
                match (HashMap::get(&it.enums, &en))
                {
                    Some(ed) :
                    {
                        for (usize i = 0; i < Vec::len(&ed.variants) && !variant; i += 1)
                        {
                            variant = String::eq(&ed.variants[i].name, last);
                        }
                    },
                    None     : {},
                }
            }
            if (!variant)
            {
                return None;
            }
            Option<Vec<DerivFact>> out = None;
            for (usize i = 0; i < Vec::len(args); i += 1)
            {
                bool plain = is_plain_literal(&args[i]) || match (value_shape(b, it, &args[i]))
                {
                    Some(t) : !may_hold_ref(it, &t, 0),
                    None    : false,
                };
                if (plain)
                {
                    continue;
                }
                match (inherited_facts_in(b, it, &args[i], depth + 1, bname, bscrut))
                {
                    Some(v) :
                    {
                        if (Vec::len(&v) == 0)
                        {
                            return Some(Vec::new());
                        }
                        match (&mut out)
                        {
                            Some(o) : Vec::append(o, v),
                            None    : out = Some(v),
                        }
                    },
                    None    : {},
                }
            }
            return out;
        },
    };
    ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &key), "a function");
    // `Option::unwrap(e)` and the like hold what `e` holds, as in
    // `contained_ref_facts`.
    if (is_unwrapping(&key) && Vec::len(args) > 0)
    {
        return inherited_facts_in(b, it, &args[0], depth + 1, bname, bscrut);
    }
    // `Option::unwrap_or(o, d)`: what `o` holds or what `d` does.
    if ((String::eq_str(
        &key,
        "std::Option::unwrap_or",
    ) || String::eq_str(&key, "std::Result::unwrap_or")) && Vec::len(args) == 2)
    {
        Option<Vec<DerivFact>> out = None;
        for (usize i = 0; i < Vec::len(args); i += 1)
        {
            match (inherited_facts_in(b, it, &args[i], depth + 1, bname, bscrut))
            {
                Some(v) :
                {
                    if (Vec::len(&v) == 0)
                    {
                        return Some(Vec::new());
                    }
                    match (&mut out)
                    {
                        Some(o) : Vec::append(o, v),
                        None    : out = Some(v),
                    }
                },
                None    : {},
            }
        }
        return out;
    }
    Option<usize> first_ref = None;
    for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(args) && Option::is_none(&first_ref); i += 1)
    {
        if (is_borrow_ty(&f.params[i].ty))
        {
            first_ref = Some(i);
        }
    }
    // A generic whose declared result holds a reference only through a
    // type argument (`Vec::pop` of a `Vec<ref<T>>`) gives back a reference
    // that was stored: what its holder holds, else tier D.
    if (!is_borrow_ty(&f.ret) && !holds_ref(it, &f.ret) && !data_type(b, it, &f.ret))
    {
        // Given no reference, it can give back only what its values hold
        // (`Vec::new()`: nothing; `Vec::filled(n, v)`: what `v` holds).
        match (first_ref)
        {
            None    :
            {
                Vec<ref<Expr, shared>> vals = Vec::new();
                for (usize i = 0; i < Vec::len(args); i += 1)
                {
                    if (arg_may_be_reference(b, it, &args[i]))
                    {
                        Vec::push(&mut vals, &args[i]);
                    }
                }
                bool single = Vec::len(&vals) == 1;
                return match (union_facts(b, it, &vals, depth, bname, bscrut))
                {
                    Some(v) : if (!single) { Some(all_unsure(v)) } else { Some(v) },
                    None    : None,
                };
            },
            Some(k) :
            {
                return match (stored_in(b, it, &args[k]))
                {
                    Some(v) : if (Vec::len(&v) == 0) { None } else { Some(v) },
                    None    : tier_d_facts(),
                };
            },
        }
    }
    Vec<usize> refs = Vec::new();
    for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(args); i += 1)
    {
        if (is_borrow_ty(&f.params[i].ty) || holds_ref(it, &f.params[i].ty))
        {
            Vec::push(&mut refs, i);
        }
    }
    if (Vec::len(&refs) == 0)
    {
        return None;
    }
    // D-0290: an aggregate holding references made from several reference
    // arguments (`Vec<StringView>` of two texts) may hold what any of them
    // reaches.
    if (Vec::len(&refs) > 1 && data_type(b, it, &f.ret))
    {
        Vec<DerivFact> out = Vec::new();
        bool any = false;
        for (usize i = 0; i < Vec::len(&refs); i += 1)
        {
            match (inherited_facts_in(b, it, &args[refs[i]], depth + 1, bname, bscrut))
            {
                Some(v) :
                {
                    if (Vec::len(&v) == 0)
                    {
                        return Some(Vec::new());
                    }
                    any = true;
                    Vec::append(&mut out, all_unsure(v));
                },
                None    : {},
            }
        }
        return if (any) { Some(out) } else { None };
    }
    // Through a reference to storage that itself holds references (a
    // `Vec<ref<T>>`, a struct with a reference field), the result may be
    // one of those stored references, which reaches what it reaches, not
    // that storage: tier D.
    ref<Expr, shared> r0 = &args[refs[0]];
    Option<Type> referent = match (&strip_parens_tc(r0).kind)
    {
        ExprKind::EBorrow(x)  : static_place_type(b, it, &Box::get(x).e),
        ExprKind::ESliceOf(x) : static_place_type(b, it, &Box::get(x).base),
        ExprKind::EPath(_) : match (one_seg(strip_parens_tc(r0)))
        {
            Some(n) : match (HashMap::get(&b.gamma, n))
            {
                Some(Type::TRef(x))   : Some(clone(&Box::get(x).inner)),
                Some(Type::TSlice(x)) : Some(clone(&Box::get(x).inner)),
                _                     : None,
            },
            None : None,
        },
        _ : match (value_shape(b, it, r0))
        {
            Some(Type::TRef(x))   : Some(Box::into_inner(x).inner),
            Some(Type::TSlice(x)) : Some(Box::into_inner(x).inner),
            _                     : None,
        },
    };
    bool reaches_stored = match (&referent)
    {
        Some(t) : stores_refs(it, t),
        None    : false,
    };
    if (reaches_stored)
    {
        // D-0290: what its holder holds; a reference into the storage
        // itself (`Vec::index_shared`) borrows it too.
        Vec<DerivFact> v = match (stored_in(b, it, r0))
        {
            Some(v) : v,
            None    : return tier_d_facts(),
        };
        if (is_borrow_ty(&f.ret))
        {
            match (inherited_facts_in(b, it, r0, depth + 1, bname, bscrut))
            {
                Some(w) :
                {
                    if (Vec::len(&w) == 0)
                    {
                        return Some(Vec::new());
                    }
                    Vec::append(&mut v, w);
                },
                None    : {},
            }
        }
        return if (Vec::len(&v) == 0) { None } else { Some(v) };
    }
    // The result borrows from the first reference argument (D-0011; D-0088
    // for a result that holds one), not from the others (a key, a needle):
    // through a shared parameter, shared. An aggregate made so
    // (`String::split`) may hold none of it (D-0290).
    bool shared_param = match (&f.params[refs[0]].ty)
    {
        Type::TRef(x)   : Box::get(x).mode == Mode::Shared,
        Type::TSlice(x) : Box::get(x).mode == Mode::Shared,
        _               : false,
    };
    bool made = data_type(b, it, &f.ret);
    Vec<DerivFact> out = Vec::new();
    match (inherited_facts_in(b, it, r0, depth + 1, bname, bscrut))
    {
        Some(v) :
        {
            if (Vec::len(&v) == 0)
            {
                return Some(Vec::new());
            }
            for (usize i = 0; i < Vec::len(&v); i += 1)
            {
                DerivFact d = clone(&v[i]);
                if (shared_param)
                {
                    d.key.mode = Mode::Shared;
                }
                if (made)
                {
                    d.v = Tri::U;
                }
                Vec::push(&mut out, d);
            }
        },
        // Static data (a literal where a view is expected): so is what the
        // result borrows.
        None    : return None,
    }
    Some(out)
}

// D-0281 §7: a type that holds a reference without being one (a view, an
// `Option`/`Result` of a reference, a closure): an aggregate kept in
// data, tier D, whose conflicts are checked when the program runs.
fn tier_d_type(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    !frame_ref_type(it, t) && holds_ref(it, t)
}

// D-0290: a type that keeps references in data, its elements' among them
// (`Vec<StringView>`), and is not held as a reference is.
fn data_type(ref<Body, exclusive> b, ref<Items, shared> it, ref<Type, shared> t) : bool
{
    type_kinds(b, it, t).data
}

// A type whose value a frame holds as a reference (D-0282, D-0287,
// D-0289): its facts are a reference binding's.
fn frame_ref_type(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(_)     : true,
        Type::TSlice(_)   : true,
        Type::TClosure(_) : true,
        Type::TFn(_)      : true,
        // D-0289: a handle or a guard held by the frame.
        Type::THandle(x)  : !holds_ref(it, Box::get(x)),
        Type::TGuard(x)   : !holds_ref(it, Box::get(x)),
        Type::TNamed(nb)  :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            // D-0287: `foreach`'s holder of a view's parts is a view of the
            // same text.
            if (String::eq_str(&n.name, "std::StringView") || String::eq_str(&n.name, "std::Parts"))
            {
                return Vec::len(&n.args) == 0;
            }
            if (String::eq_str(&n.name, "std::Option") || String::eq_str(&n.name, "std::Result"))
            {
                return Vec::len(&n.args) > 0 && is_ref_or_view(&n.args[0]);
            }
            false
        },
        _                 : false,
    }
}

// D-0290: what a literal's parts hold, together: `None` when every part
// is static data or a plain value, unknown when one is.
fn union_facts(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Vec<ref<Expr, shared>>, shared> parts,
    usize depth,
    Option<ref<String, shared>> bname,
    Option<ref<Expr, shared>> bscrut,
) : Option<Vec<DerivFact>>
{
    Option<Vec<DerivFact>> out = None;
    for (usize i = 0; i < Vec::len(parts); i += 1)
    {
        ref<Expr, shared> a = parts[i];
        bool plain = match (&strip_parens_tc(a).kind)
        {
            ExprKind::EInt(_)    : true,
            ExprKind::EFloat(_)  : true,
            ExprKind::EBool(_)   : true,
            ExprKind::EUnit      : true,
            ExprKind::EBinary(_) : true,
            ExprKind::EUnary(_)  : true,
            _                    : false,
        };
        if (!plain)
        {
            plain = match (shape_or_place(b, it, a))
            {
                Some(t) : !may_hold_ref(it, &t, 0),
                None    : false,
            };
        }
        if (plain)
        {
            continue;
        }
        match (inherited_facts_in(b, it, a, depth + 1, bname, bscrut))
        {
            Some(v) :
            {
                if (Vec::len(&v) == 0)
                {
                    return Some(Vec::new());
                }
                match (&mut out)
                {
                    Some(o) : Vec::append(o, v),
                    None    : out = Some(v),
                }
            },
            None    : {},
        }
    }
    out
}

// D-0290: whether a local of type `t` is a holder: it keeps references in
// data (tier D by its type) and holds no `fn` value, lock, guard or
// thread, whose reach the facts do not follow.
fn holder_type(ref<Body, exclusive> b, ref<Items, shared> it, ref<Type, shared> t) : bool
{
    type_kinds(b, it, t).holder
}

// (`holder_type`, `data_type`, `stores_refs`) of `t`, worked out once per
// type.
struct TypeKinds
{
    bool holder;
    bool data;
    bool stores;
}

fn type_kinds(ref<Body, exclusive> b, ref<Items, shared> it, ref<Type, shared> t) : TypeKinds
{
    String code = type_code(t);
    match (HashMap::get(&b.facts.type_memo, &code))
    {
        Some(k) : return clone(k),
        None    : {},
    }
    bool stores = stores_refs(it, t);
    bool data = stores && !frame_ref_type(it, t);
    TypeKinds k = TypeKinds { .holder = data && holder_free(
        it,
        t,
        &mut new_name_set(),
    ), .data = data, .stores = stores };
    HashMap::insert(&mut b.facts.type_memo, code, clone(&k));
    k
}

// D-0290: whether `n` is a holder of this frame: a local (not a parameter,
// not a capture) bound when its type made it one.
fn is_holder(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> n) : bool
{
    if (!HashSet::contains(&b.holders, n) || HashSet::contains(&b.capture_names, n))
    {
        return false;
    }
    match (lookup_local(b, n))
    {
        Some(t) : holder_type(b, it, &t),
        None    : false,
    }
}

// D-0290: what the references kept in `*q` reach, for a reference
// parameter `q` given no other referent: a root of its own, `**q`,
// disjoint from this frame's places and from what the other parameters
// reach, as `*q` is (the caller's call rule makes it so). Two of those
// references may be one: an exclusive one is unsure.
fn deep_root(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> q) : Option<DerivFact>
{
    if (!HashSet::contains(&b.params, q))
    {
        return None;
    }
    match (HashMap::get(&b.flow.deriv, q))
    {
        Some(f) :
        {
            if (HashMap::len(f) > 0)
            {
                return None;
            }
        },
        None    : {},
    }
    bool excl = match (HashMap::get(&b.gamma, q))
    {
        Some(Type::TRef(x))   :
        {
            Type inner = clone(&Box::get(x).inner);
            Box::get(x).mode == Mode::Exclusive && excl_cached(b, it, &inner)
        },
        Some(Type::TSlice(x)) :
        {
            Type inner = clone(&Box::get(x).inner);
            Box::get(x).mode == Mode::Exclusive && excl_cached(b, it, &inner)
        },
        _                     : return None,
    };
    Some(fact(
        sprintf("**%s", q),
        Vec::new(),
        if (excl) { Mode::Exclusive } else { Mode::Shared },
        if (excl) { Tri::U } else { Tri::T },
    ))
}

// D-0290: what the references stored at a root reach: a holder's facts, or
// `**q` for the referent `*q` of a reference parameter.
fn reach_of_root(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> root) : Option<Vec<DerivFact>>
{
    if (is_holder(b, it, root))
    {
        return Some(holder_facts(b, root));
    }
    String q = String::from_view(String::strip_prefix(root, "*")?);
    DerivFact f = deep_root(b, it, &q)?;
    one_fact(f)
}

// D-0290: what the references stored in the aggregate `base` (a holder,
// its field or element, or one reached through a reference) reach.
// `None`: not known before the run (tier D).
fn stored_facts(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> base,
    usize depth,
) : Option<Vec<DerivFact>>
{
    if (depth > 8)
    {
        return None;
    }
    ref<Expr, shared> e = strip_parens_tc(base);
    match (&e.kind)
    {
        ExprKind::EField(f) : stored_facts(b, it, &Box::get(f).e, depth + 1),
        ExprKind::EIndex(p) : stored_facts(b, it, &Box::get(p).a, depth + 1),
        ExprKind::EDeref(x) : match (one_seg(strip_parens_tc(Box::get(x))))
        {
            Some(n) :
            {
                String name = String::clone(n);
                stored_through_ref(b, it, &name)
            },
            None    : None,
        },
        ExprKind::EPath(_) : match (one_seg(e))
        {
            Some(n) :
            {
                String name = String::clone(n);
                // One element or field may reach any of what the holder
                // does, or nothing: on some paths only.
                if (is_holder(b, it, &name))
                {
                    return Some(all_unsure(holder_facts(b, &name)));
                }
                stored_through_ref(b, it, &name)
            },
            None    : None,
        },
        _                   : None,
    }
}

// `stored_facts` through the reference binding `r`: what the roots it
// reaches keep.
fn stored_through_ref(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> r) : Option<Vec<DerivFact>>
{
    if (!HashMap::contains(&b.gamma, r) || !local_is_ref(b, r))
    {
        return None;
    }
    match (deep_root(b, it, r))
    {
        Some(f) : return one_fact(f),
        None    : {},
    }
    if (!HashMap::contains(&b.flow.deriv, r))
    {
        return None;
    }
    Vec<DerivFact> facts = facts_of(b, r, false);
    if (Vec::len(&facts) == 0)
    {
        return None;
    }
    Vec<DerivFact> out = Vec::new();
    for (usize i = 0; i < Vec::len(&facts); i += 1)
    {
        if (facts[i].v == Tri::F)
        {
            continue;
        }
        Vec<DerivFact> held = reach_of_root(b, it, &facts[i].key.root)?;
        bool sure = facts[i].v == Tri::T && !is_holder(b, it, &facts[i].key.root);
        for (usize k = 0; k < Vec::len(&held); k += 1)
        {
            DerivFact h = clone(&held[k]);
            if (!sure)
            {
                h.v = Tri::U;
            }
            Vec::push(&mut out, h);
        }
    }
    Some(out)
}

// The binding whose path a reference binding carries: itself, or what it
// was copied from.
fn path_id(ref<Body, shared> b, ref<String, shared> r) : String
{
    String cur = String::clone(r);
    for (usize i = 0; i < 64; i += 1)
    {
        match (HashMap::get(&b.ref_copies, &cur))
        {
            Some(n) :
            {
                if (String::eq(n, &cur))
                {
                    break;
                }
                cur = String::clone(n);
            },
            None    : break,
        }
    }
    cur
}

// `set_deriv` with facts of any truth value (inherited facts).
fn set_deriv_tri(ref<Body, exclusive> b, ref<String, shared> r, Vec<DerivFact> facts)
{
    if (b.flow.unreachable)
    {
        return;
    }
    handle_lend_through(b, r);
    HashMap::remove(&mut b.flow.deriv, r);
    flow_clear_rooted(&mut b.flow, String::as_view(&referent_root(String::as_view(r))));
    if (Vec::len(&facts) > 0)
    {
        HashMap<String, DerivFact> m = HashMap::new();
        for (usize i = 0; i < Vec::len(&facts); i += 1)
        {
            Tri v = facts[i].v;
            ref<DerivFact, exclusive> e = HashMap::entry(&mut m, deriv_code(&facts[i].key), clone(&facts[i]));
            if (e.v != v)
            {
                e.v = Tri::U;
            }
        }
        HashMap::insert(&mut b.flow.deriv, String::clone(r), m);
    }
}

// D-0282: at a binding `set_deriv` gave no fact: inherit, or record the
// binding as of unknown (or static) origin.
fn tier_inherit(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> r,
    Option<ref<Expr, shared>> e,
) : Result<void, String>
{
    // D-0290: a local of this frame that holds references in data and no
    // `fn` value, lock or thread is a holder: it holds what it was made
    // from, as a reference binding does.
    Option<Type> rt = lookup_local(b, r);
    bool holder = match (&rt)
    {
        Some(t) : holder_type(b, it, t),
        None    : false,
    } && !HashSet::contains(&b.params, r) && !HashSet::contains(&b.capture_names, r);
    if (holder)
    {
        HashSet::insert(&mut b.holders, String::clone(r));
    }
    // The facts are made on every pass over a loop's body, the report only
    // on the last: a fact made in the body reaches the loop's head and exit
    // (`check_while`'s fixed point) only so.
    if (b.flow.unreachable || HashMap::contains(&b.flow.deriv, r))
    {
        return Ok(());
    }
    bool report = b.report;
    match (e)
    {
        Some(ex) : match (one_seg(strip_parens_tc(ex)))
        {
            Some(n) :
            {
                if (!String::eq(n, r) && local_is_ref(b, n) && local_is_ref(b, r))
                {
                    String id = path_id(b, n);
                    HashMap::insert(&mut b.ref_copies, String::clone(r), id);
                }
            },
            None    : {},
        },
        None : {},
    }
    usize line = b.current_line;
    String ty = match (&rt)
    {
        Some(t) : type_display(t),
        None    : String::new(),
    };
    String kind = match (e)
    {
        Some(ex) : rep_kind_of(ex),
        None     : String::from_str("binder"),
    };
    // A binding whose type is an aggregate holding a reference (a struct,
    // an array, an enum other than `Option`/`Result` of one) is tier D by
    // its type (D-0281 §7), whatever it was made from.
    match (&rt)
    {
        Some(t) :
        {
            if (!holder && tier_d_type(it, t))
            {
                if (report)
                {
                    b.rep.tier_d += 1;
                    Vec::push(&mut b.rep.events, sprintf("D\t%v\t%s\t%s\t%s", line, r, &ty, &kind));
                    rep_left(b, sprintf("line %v: `%s` keeps references in data (tier D)", line, r));
                }
                return Ok(());
            }
        },
        None    : {},
    }
    // `r = pass(r)`: what the old `r` reached is not a fact rooted at the
    // new `r`'s own referent (the old facts were cleared when `r` was
    // assigned, so `r` here is known only as `*r`).
    String own = referent_root(String::as_view(r));
    // A fact rooted at the old `r`'s referent (`r = StringView::sub(r, …)`)
    // is what the old `r` held: the new value lies within it.
    Option<HashMap<String, DerivFact>> prev = match (replace(&mut b.prev_facts, None))
    {
        Some(pf) :
        {
            PrevFacts { name, facts } = pf;
            if (String::eq(&name, r)) { Some(facts) } else { None }
        },
        None     : None,
    };
    // An old `r` that held nothing held static data (a parameter: what its
    // caller gave, `*r` still): so does the new value (D-0290).
    bool param = HashSet::contains(&b.params, r);
    // `inherited`: `None` for no initializer, `Some(None)` for static data,
    // `Some(Some(v))` otherwise.
    bool has_init = Option::is_some(&e);
    Option<Vec<DerivFact>> inherited = match (e)
    {
        Some(ex) : match (inherited_facts(b, it, ex, 0))
        {
            Some(v) :
            {
                Vec<DerivFact> out = Vec::new();
                bool dropped = false;
                for (usize i = 0; i < Vec::len(&v); i += 1)
                {
                    ref<DerivFact, shared> f = &v[i];
                    if (!String::eq(&f.key.root, &own))
                    {
                        Vec::push(&mut out, clone(f));
                    }
                    else
                    {
                        match (&prev)
                        {
                            Some(p) :
                            {
                                for (usize k = 0; k < HashMap::len(p); k += 1)
                                {
                                    ref<DerivFact, shared> pf = HashMap::value_at(p, k);
                                    if (pf.v == Tri::F)
                                    {
                                        continue;
                                    }
                                    Vec::push(
                                        &mut out,
                                        DerivFact { .key = clone(&pf.key), .v = if (f.v == Tri::T) { pf.v } else { Tri::U } },
                                    );
                                }
                            },
                            None    :
                            {
                                if (param)
                                {
                                    Vec::push(&mut out, clone(f));
                                }
                                else
                                {
                                    dropped = true;
                                }
                            },
                        }
                    }
                }
                if (dropped && Vec::len(&out) == 0) { None } else { Some(out) }
            },
            None    : None,
        },
        None : None,
    };
    match (inherited)
    {
        None    :
        {
            if (has_init)
            {
                // Static data.
                if (report)
                {
                    Vec::push(&mut b.rep.events, sprintf("S\t%v\t%s\t%s\t%s", line, r, &ty, &kind));
                }
                return Ok(());
            }
        },
        Some(v) :
        {
            if (any_root(&v, "<tier D>"))
            {
                if (!report)
                {
                    return Ok(());
                }
                b.rep.tier_d += 1;
                Vec::push(&mut b.rep.events, sprintf("D\t%v\t%s\t%s\t%s", line, r, &ty, &kind));
                rep_left(b, sprintf("line %v: `%s` was read out of data that keeps references (tier D)", line, r));
                return Ok(());
            }
            if (any_root(&v, "<temporary>") && holder)
            {
                // A holder may hold none of the temporary (D-0290).
                if (report)
                {
                    rep_left(
                        b,
                        sprintf("line %v: `%s` may hold a view of a temporary that ends with this statement", line, r),
                    );
                }
                return Ok(());
            }
            if (any_root(&v, "<temporary>"))
            {
                if (rep_live_after(&b.rep, String::as_view(r), b.current_line, b.current_col))
                {
                    String msg = sprintf(
                        "`%s` holds a view of a temporary that ends with this statement, and is used later (D-0135)",
                        r,
                    );
                    String diag = sprintf(
                        "%s%s",
                        &named_diag("diag.destroy-while-aliased", &msg),
                        &diag_at(b.current_line, b.current_col),
                    );
                    refute(b, &diag)?;
                }
                return Ok(());
            }
            if (Vec::len(&v) > 0)
            {
                if (report)
                {
                    b.rep.inherited += 1;
                }
                Vec<DerivFact> w = if (holder) { through_refs(b, v) } else { v };
                set_deriv_tri(b, r, w);
                return Ok(());
            }
        },
    }
    if (!report)
    {
        return Ok(());
    }
    b.rep.unknown_origin += 1;
    Vec::push(&mut b.rep.events, sprintf("O\t%v\t%s\t%s\t%s", line, r, &ty, &kind));
    rep_left(b, sprintf("line %v: what `%s` borrows is not known before the run", line, r));
    Ok(())
}

// `[Block-Exit]` destroys what the block declared. A binding declared
// outside it that holds a reference to one of those (a `deriv` fact rooted
// there) conflicts with that destroy: when it surely does and is used
// later, an error (D-0282); when it may, the run decides.
struct HeldAtExit
{
    String r;
    String x;
    Tri t;
}

fn check_block_exit(ref<Body, exclusive> b) : Result<void, String>
{
    if (!b.report || b.flow.unreachable)
    {
        return Ok(());
    }
    usize ns = Vec::len(&b.scopes);
    if (ns == 0)
    {
        return Ok(());
    }
    HashSet<String> dying = HashSet::new();
    for (usize i = 0; i < Vec::len(&b.scopes[ns - 1]); i += 1)
    {
        HashSet::insert(&mut dying, String::clone(&b.scopes[ns - 1][i].name));
    }
    Vec<HeldAtExit> held = Vec::new();
    for (usize i = 0; i < HashMap::len(&b.flow.deriv); i += 1)
    {
        ref<String, shared> r = HashMap::key_at(&b.flow.deriv, i);
        if (HashSet::contains(&dying, r))
        {
            continue;
        }
        ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&b.flow.deriv, i);
        for (usize k = 0; k < HashMap::len(facts); k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            if (HashSet::contains(&dying, &d.key.root) && d.v != Tri::F)
            {
                Vec::push(&mut held, HeldAtExit { .r = String::clone(r), .x = String::clone(&d.key.root), .t = d.v });
            }
        }
    }
    // Sorted by (r, x).
    for (usize i = 1; i < Vec::len(&held); i += 1)
    {
        usize j = i;
        while (j > 0 && (String::less(
            &held[j].r,
            &held[j - 1].r,
        ) || (String::eq(&held[j].r, &held[j - 1].r) && String::less(&held[j].x, &held[j - 1].x))))
        {
            Vec::swap(&mut held, j - 1, j);
            j -= 1;
        }
    }
    usize line = b.current_line;
    usize col = b.current_col;
    for (usize i = 0; i < Vec::len(&held); i += 1)
    {
        StringView r = shown_name(String::as_view(&held[i].r));
        StringView x = shown_name(String::as_view(&held[i].x));
        if (held[i].t == Tri::T && rep_live_after(&b.rep, String::as_view(&held[i].r), line, col))
        {
            String msg = sprintf(
                "`%s` is destroyed at the end of its block while `%s` still refers to it, and `%s` is used later",
                x,
                r,
                r,
            );
            String diag = sprintf("%s%s", &named_diag("diag.destroy-while-aliased", &msg), &diag_at(line, col));
            return refute(b, &diag);
        }
        rep_left(b, sprintf("line %v: `%s` may refer to `%s` when its block ends", line, r, x));
    }
    Ok(())
}

fn check_block(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    Option<Type> last_stmt_ty = check_block_stmts(b, it, blk)?;
    match (&blk.tail)
    {
        Some(e) : check_store_operand(b, it, Box::get(e), expected),
        // `[T-Block]` (spec/12 §5): no trailing expression is `unit`,
        // except after a last statement of type `never`.
        None    :
        {
            bool nev = match (&last_stmt_ty)
            {
                Some(Type::TNever) : true,
                _                  : false,
            };
            Ok(Some(if (nev) { Type::TNever } else { Type::TVoid }))
        },
    }
}

// An early end waiting: the binding and the statement that declared it.
struct Waiting
{
    String name;
    usize decl;
}

// A block's statements, each checked in turn; after each, the local
// reference bindings whose last use it was end (D-0111).
fn check_block_stmts(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
) : Result<Option<Type>, String>
{
    usize key = block_key(blk);
    EarlyPlan plan = match (if (key == 0) { None } else { HashMap::swap_remove(&mut b.facts.plans, &key) })
    {
        Some(p) : p,
        None    : early_end_plan(blk),
    };
    Result<Option<Type>, String> r = check_planned_stmts(b, it, blk, &plan);
    if (key != 0)
    {
        HashMap::insert(&mut b.facts.plans, key, plan);
    }
    r
}

// A block's key in `Facts.plans`: the id of the expression of its first
// statement that has one, or of its tail (0: none).
fn block_key(ref<Block, shared> blk) : usize
{
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        usize id = match (&blk.stmts[i])
        {
            Stmt::SLet(l) : match (&Box::get(l).init)
            {
                Some(e) : e.id,
                None    : 0,
            },
            Stmt::SDestructure(d) : Box::get(d).init.id,
            Stmt::SExpr(e)        : Box::get(e).id,
            Stmt::SBlockLike(e)   : Box::get(e).id,
        };
        if (id != 0)
        {
            return id;
        }
    }
    match (&blk.tail)
    {
        Some(e) : Box::get(e).id,
        None    : 0,
    }
}

fn check_planned_stmts(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    ref<EarlyPlan, shared> plan,
) : Result<Option<Type>, String>
{
    Option<Type> last_stmt_ty = None;
    Vec<Waiting> waiting = Vec::new();
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        last_stmt_ty = check_stmt(b, it, &blk.stmts[i])?;
        for (usize k = 0; k < Vec::len(&plan.ends[i]); k += 1)
        {
            Vec::push(&mut waiting, clone(&plan.ends[i][k]));
        }
        if (Vec::len(&waiting) > 0)
        {
            Vec<Waiting> later = Vec::new();
            Vec<Waiting> now_w = Vec::new();
            Vec<String> now = Vec::new();
            for (usize k = 0; k < Vec::len(&waiting); k += 1)
            {
                if (ref_end_blocked(b, it, blk, &waiting[k].name, waiting[k].decl, i, &plan.mentions, &plan.tail))
                {
                    Vec::push(&mut later, clone(&waiting[k]));
                }
                else
                {
                    Vec::push(&mut now, String::clone(&waiting[k].name));
                    Vec::push(&mut now_w, clone(&waiting[k]));
                }
            }
            waiting = later;
            // One another binding's facts are still rooted in waits for
            // those to end (`f = move [b]() …` drops what the old `f`
            // copied out of `r`).
            if (Vec::len(&now) > 0)
            {
                Vec<String> rooted = end_ref_bindings(b, it, &blk.stmts[i], &now);
                for (usize k = 0; k < Vec::len(&now_w); k += 1)
                {
                    if (Vec::contains(&rooted, &now_w[k].name))
                    {
                        Vec::push(&mut waiting, clone(&now_w[k]));
                    }
                }
            }
        }
    }
    Ok(last_stmt_ty)
}

fn mentioned_later(
    ref<Vec<HashSet<String>>, shared> mentions,
    ref<HashSet<String>, shared> tail,
    usize i,
    ref<String, shared> m,
) : bool
{
    if (HashSet::contains(tail, m))
    {
        return true;
    }
    for (usize j = i + 1; j < Vec::len(mentions); j += 1)
    {
        if (HashSet::contains(&mentions[j], m))
        {
            return true;
        }
    }
    false
}

// Whether `n` (declared by statement `d`) must outlive statement `i`
// although no later statement mentions it.
fn ref_end_blocked(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    ref<String, shared> n,
    usize d,
    usize i,
    ref<Vec<HashSet<String>>, shared> mentions,
    ref<HashSet<String>, shared> tail,
) : bool
{
    for (usize j = d; j <= i; j += 1)
    {
        if (!(j == d || HashSet::contains(&mentions[j], n)))
        {
            continue;
        }
        Vec<String> names = Vec::new();
        for (usize k = 0; k < HashSet::len(&mentions[j]); k += 1)
        {
            Vec::push(&mut names, String::clone(HashSet::key_at(&mentions[j], k)));
        }
        Option<String> declared = match (&blk.stmts[j])
        {
            Stmt::SLet(l) : Some(String::clone(&Box::get(l).name)),
            _             : None,
        };
        match (&declared)
        {
            Some(dn) : Vec::push(&mut names, String::clone(dn)),
            None     : {},
        }
        for (usize k = 0; k < Vec::len(&names); k += 1)
        {
            ref<String, shared> m = &names[k];
            if (String::eq(m, n))
            {
                continue;
            }
            bool is_decl = match (&declared)
            {
                Some(dn) : String::eq(dn, m),
                None     : false,
            };
            bool holds = match (HashMap::get(&b.gamma, m))
            {
                Some(t) : may_hold_ref(it, t, 0) && (is_decl || !inert_ref(it, t) || stmt_rebinds(&blk.stmts[j], m)),
                None    : false,
            };
            if (holds && mentioned_later_from(blk, mentions, tail, i, j, m))
            {
                return true;
            }
        }
    }
    false
}

// `mentioned_later`, only while what `m` got at statement `j` lasts: a
// later statement that assigns it whole from a value that does not read it
// ends that, when nothing leaves the block on the way (`f = move [vb]()
// …` after `f = move [va]() …`).
fn mentioned_later_from(
    ref<Block, shared> blk,
    ref<Vec<HashSet<String>>, shared> mentions,
    ref<HashSet<String>, shared> tail,
    usize i,
    usize j,
    ref<String, shared> m,
) : bool
{
    for (usize k = j + 1; k < Vec::len(&blk.stmts); k += 1)
    {
        if (stmt_may_leave(&blk.stmts[k - 1]))
        {
            break;
        }
        if (stmt_overwrites(&blk.stmts[k], m))
        {
            if (stmt_may_leave(&blk.stmts[k]))
            {
                break;
            }
            usize hi = if (k > i + 1) { k } else { i + 1 };
            for (usize q = i + 1; q < hi; q += 1)
            {
                if (HashSet::contains(&mentions[q], m))
                {
                    return true;
                }
            }
            return false;
        }
    }
    mentioned_later(mentions, tail, i, m)
}

// D-0275: a reference, slice or `StringView` whose referent holds no
// reference and no `fn` value: it can take another binding's path only by
// being rebound (`stmt_rebinds`), never through what it reaches.
fn inert_ref(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(m)   : !may_hold_ref(it, &Box::get(m).inner, 0),
        Type::TSlice(m) : !may_hold_ref(it, &Box::get(m).inner, 0),
        Type::TNamed(n) : String::eq_str(&Box::get(n).name, "std::StringView") && Vec::len(&Box::get(n).args) == 0,
        _               : false,
    }
}

// Whether statement `s` may rebind `m`: it assigns `m` whole, borrows it
// whole exclusively, or a closure in it captures it (D-0275).
fn stmt_rebinds(ref<Stmt, shared> s, ref<String, shared> m) : bool
{
    bool found = false;
    match (s)
    {
        Stmt::SLet(l)         :
        {
            match (&Box::get(l).init)
            {
                Some(e) : rb_expr(e, m, &mut found),
                None    : {},
            }
        },
        Stmt::SDestructure(d) : rb_expr(&Box::get(d).init, m, &mut found),
        Stmt::SExpr(e)        : rb_expr(Box::get(e), m, &mut found),
        Stmt::SBlockLike(e)   : rb_expr(Box::get(e), m, &mut found),
    }
    found
}

fn rb_is(ref<Expr, shared> e, ref<String, shared> m) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EPath(p) : Vec::len(&Box::get(p).segs) == 1 && String::eq(&Box::get(p).segs[0], m),
        _                  : false,
    }
}

fn rb_block(ref<Block, shared> blk, ref<String, shared> m, ref<bool, exclusive> found)
{
    foreach (st in &blk.stmts)
    {
        match (st)
        {
            Stmt::SLet(l)         :
            {
                match (&Box::get(l).init)
                {
                    Some(e) : rb_expr(e, m, found),
                    None    : {},
                }
            },
            Stmt::SDestructure(d) : rb_expr(&Box::get(d).init, m, found),
            Stmt::SExpr(e)        : rb_expr(Box::get(e), m, found),
            Stmt::SBlockLike(e)   : rb_expr(Box::get(e), m, found),
        }
    }
    match (&blk.tail)
    {
        Some(t) : rb_expr(Box::get(t), m, found),
        None    : {},
    }
}

// Every expression in `e`, closures' bodies included (coby's `consts::visit`).
fn rb_expr(ref<Expr, shared> e, ref<String, shared> m, ref<bool, exclusive> found)
{
    match (&e.kind)
    {
        ExprKind::EUnary(u)       : rb_expr(&Box::get(u).e, m, found),
        ExprKind::EBorrow(bb)     :
        {
            if (Box::get(bb).mode == Mode::Exclusive && rb_is(&Box::get(bb).e, m))
            {
                *found = true;
            }
            rb_expr(&Box::get(bb).e, m, found);
        },
        ExprKind::EDeref(x)       : rb_expr(Box::get(x), m, found),
        ExprKind::EField(fb)      : rb_expr(&Box::get(fb).e, m, found),
        ExprKind::EPropagate(x)   : rb_expr(Box::get(x), m, found),
        ExprKind::EParen(x)       : rb_expr(Box::get(x), m, found),
        ExprKind::EBinary(bb)     :
        {
            rb_expr(&Box::get(bb).a, m, found);
            rb_expr(&Box::get(bb).b, m, found);
        },
        ExprKind::EIndex(ib)      :
        {
            rb_expr(&Box::get(ib).a, m, found);
            rb_expr(&Box::get(ib).b, m, found);
        },
        ExprKind::EAssign(pb)     :
        {
            if (rb_is(&Box::get(pb).a, m))
            {
                *found = true;
            }
            rb_expr(&Box::get(pb).a, m, found);
            rb_expr(&Box::get(pb).b, m, found);
        },
        ExprKind::ECall(cb)       :
        {
            rb_expr(&Box::get(cb).callee, m, found);
            foreach (a in &Box::get(cb).args)
            {
                rb_expr(a, m, found);
            }
        },
        ExprKind::EStructLit(sb)  :
        {
            foreach (f in &Box::get(sb).fields)
            {
                rb_expr(&f.value, m, found);
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            foreach (x in es)
            {
                rb_expr(x, m, found);
            }
        },
        ExprKind::EArrayRepeat(r) : rb_expr(&Box::get(r).value, m, found),
        ExprKind::ESliceOf(sl)    :
        {
            rb_expr(&Box::get(sl).base, m, found);
            rb_expr(&Box::get(sl).lo, m, found);
            rb_expr(&Box::get(sl).hi, m, found);
        },
        ExprKind::EBlock(blk)     : rb_block(blk, m, found),
        ExprKind::EUnsafe(blk)    : rb_block(blk, m, found),
        ExprKind::EIf(ib)         :
        {
            rb_expr(&Box::get(ib).cond, m, found);
            rb_block(&Box::get(ib).then_, m, found);
            match (&Box::get(ib).else_)
            {
                Some(el) : rb_expr(el, m, found),
                None     : {},
            }
        },
        ExprKind::EWhile(wb)      :
        {
            rb_expr(&Box::get(wb).cond, m, found);
            rb_block(&Box::get(wb).body, m, found);
            match (&Box::get(wb).step)
            {
                Some(st) : rb_expr(st, m, found),
                None     : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            rb_expr(&Box::get(mb).scrut, m, found);
            foreach (a in &Box::get(mb).arms)
            {
                rb_expr(Box::get(&a.body), m, found);
            }
        },
        ExprKind::EReturn(opt)    :
        {
            match (opt)
            {
                Some(x) : rb_expr(Box::get(x), m, found),
                None    : {},
            }
        },
        ExprKind::EClosure(cb)    :
        {
            foreach (c in &Box::get(cb).captures)
            {
                if (*c == *m)
                {
                    *found = true;
                }
            }
            rb_block(&Box::get(cb).body, m, found);
        },
        _                         : {},
    }
}

// `interp::closure_body_writes`: a conservative syntactic scan; any
// assignment, exclusive borrow or `drop` whose place root is `name`.
fn closure_body_writes(ref<Block, shared> body, StringView name) : bool
{
    bool found = false;
    cbw_block(body, name, &mut found);
    found
}

fn cbw_root_is(ref<Expr, shared> e, StringView name) : bool
{
    match (&e.kind)
    {
        ExprKind::EPath(p)   : Vec::len(&Box::get(p).segs) == 1 && String::eq_view(&Box::get(p).segs[0], name),
        ExprKind::EField(fb) : cbw_root_is(&Box::get(fb).e, name),
        ExprKind::EIndex(ib) : cbw_root_is(&Box::get(ib).a, name),
        ExprKind::EDeref(x)  : cbw_root_is(Box::get(x), name),
        _                    : false,
    }
}

fn cbw_block(ref<Block, shared> blk, StringView name, ref<bool, exclusive> found)
{
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        match (&blk.stmts[i])
        {
            Stmt::SExpr(e)      : cbw_expr(Box::get(e), name, found),
            Stmt::SBlockLike(e) : cbw_expr(Box::get(e), name, found),
            Stmt::SLet(l)       :
            {
                match (&Box::get(l).init)
                {
                    Some(e) : cbw_expr(e, name, found),
                    None    : {},
                }
            },
            _                   : {},
        }
    }
    match (&blk.tail)
    {
        Some(t) : cbw_expr(Box::get(t), name, found),
        None    : {},
    }
}

fn cbw_expr(ref<Expr, shared> e, StringView name, ref<bool, exclusive> found)
{
    match (&e.kind)
    {
        ExprKind::EAssign(pb)     :
        {
            ref<PairExpr, shared> x = Box::get(pb);
            if (cbw_root_is(&x.a, name))
            {
                *found = true;
            }
            cbw_expr(&x.a, name, found);
            cbw_expr(&x.b, name, found);
        },
        ExprKind::EBorrow(bb)     :
        {
            ref<BorrowExpr, shared> x = Box::get(bb);
            if (x.mode == Mode::Exclusive)
            {
                if (cbw_root_is(&x.e, name))
                {
                    *found = true;
                }
                cbw_expr(&x.e, name, found);
            }
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            cbw_expr(&c.callee, name, found);
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                cbw_expr(&c.args[i], name, found);
            }
            match (&c.callee.kind)
            {
                ExprKind::EPath(p) :
                {
                    ref<Vec<String>, shared> segs = &Box::get(p).segs;
                    usize n = Vec::len(segs);
                    if (n > 0 && String::eq_str(
                        &segs[n - 1],
                        "drop",
                    ) && Vec::len(&c.args) > 0 && cbw_root_is(&c.args[0], name))
                    {
                        *found = true;
                    }
                },
                _                  : {},
            }
        },
        ExprKind::EBinary(bb)     :
        {
            cbw_expr(&Box::get(bb).a, name, found);
            cbw_expr(&Box::get(bb).b, name, found);
        },
        ExprKind::EUnary(u)       : cbw_expr(&Box::get(u).e, name, found),
        ExprKind::EDeref(x)       : cbw_expr(Box::get(x), name, found),
        ExprKind::EField(fb)      : cbw_expr(&Box::get(fb).e, name, found),
        ExprKind::EIndex(ib)      :
        {
            cbw_expr(&Box::get(ib).a, name, found);
            cbw_expr(&Box::get(ib).b, name, found);
        },
        ExprKind::EParen(x)       : cbw_expr(Box::get(x), name, found),
        ExprKind::EPropagate(x)   : cbw_expr(Box::get(x), name, found),
        ExprKind::EBlock(blk)     : cbw_block(blk, name, found),
        ExprKind::EUnsafe(blk)    : cbw_block(blk, name, found),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            cbw_expr(&x.cond, name, found);
            cbw_block(&x.then_, name, found);
            match (&x.else_)
            {
                Some(el) : cbw_expr(el, name, found),
                None     : {},
            }
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            cbw_expr(&x.cond, name, found);
            cbw_block(&x.body, name, found);
            match (&x.step)
            {
                Some(s) : cbw_expr(s, name, found),
                None    : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> x = Box::get(mb);
            cbw_expr(&x.scrut, name, found);
            for (usize i = 0; i < Vec::len(&x.arms); i += 1)
            {
                cbw_expr(Box::get(&x.arms[i].body), name, found);
            }
        },
        ExprKind::EReturn(opt)    :
        {
            match (opt)
            {
                Some(x) : cbw_expr(Box::get(x), name, found),
                None    : {},
            }
        },
        ExprKind::EStructLit(sb)  :
        {
            ref<StructLitExpr, shared> s = Box::get(sb);
            for (usize i = 0; i < Vec::len(&s.fields); i += 1)
            {
                cbw_expr(&s.fields[i].value, name, found);
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            for (usize i = 0; i < Vec::len(es); i += 1)
            {
                cbw_expr(&es[i], name, found);
            }
        },
        ExprKind::EArrayRepeat(r) : cbw_expr(&Box::get(r).value, name, found),
        // A nested closure literal is part of this body's text.
        ExprKind::EClosure(cb)    :
        {
            ref<ClosureExpr, shared> c = Box::get(cb);
            bool captured = false;
            for (usize i = 0; i < Vec::len(&c.captures); i += 1)
            {
                if (String::eq_view(&c.captures[i], name))
                {
                    captured = true;
                }
            }
            if (captured)
            {
                cbw_block(&c.body, name, found);
            }
        },
        _                         : {},
    }
}

// ---- part 5: typecheck.rs lines 2800-3200 ----

// A statement's key for the facts kept of it (coby keys them by its
// address): its expression's id, or for `τ x;` its position.
export fn stmt_key(ref<Stmt, shared> s) : usize
{
    match (s)
    {
        Stmt::SLet(l) : match (&Box::get(l).init)
        {
            Some(e) : e.id,
            None    : max_value<usize>() - ((Box::get(l).line << 20) | Box::get(l).col),
        },
        Stmt::SDestructure(d) : Box::get(d).init.id,
        Stmt::SExpr(e)        : Box::get(e).id,
        Stmt::SBlockLike(e)   : Box::get(e).id,
    }
}

// The names another binding's facts are still rooted in, which do not end
// yet.
fn end_ref_bindings(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Stmt, shared> s,
    ref<Vec<String>, shared> names,
) : Vec<String>
{
    Vec<String> rooted = Vec::new();
    if (b.flow.unreachable)
    {
        return rooted;
    }
    Vec<String> ended = Vec::new();
    for (usize i = 0; i < Vec::len(names); i += 1)
    {
        ref<String, shared> n = &names[i];
        bool is_ref = match (HashMap::get(&b.gamma, n))
        {
            Some(t) : ends_at_last_use(it, t),
            None    : false,
        };
        if (!is_ref)
        {
            continue;
        }
        String rr = referent_root(String::as_view(n));
        bool rooted_here = false;
        for (usize h = 0; h < HashMap::len(&b.flow.deriv) && !rooted_here; h += 1)
        {
            if (String::eq(HashMap::key_at(&b.flow.deriv, h), n))
            {
                continue;
            }
            ref<HashMap<String, DerivFact>, shared> fs = HashMap::value_at(&b.flow.deriv, h);
            for (usize k = 0; k < HashMap::len(fs); k += 1)
            {
                ref<String, shared> root = &HashMap::value_at(fs, k).key.root;
                if (String::eq(root, n) || String::eq(root, &rr))
                {
                    rooted_here = true;
                    break;
                }
            }
        }
        if (rooted_here)
        {
            Vec::push(&mut rooted, String::clone(n));
            continue;
        }
        HashMap::remove(&mut b.flow.deriv, n);
        Vec::push(&mut ended, String::clone(n));
    }
    if (Vec::len(&ended) > 0)
    {
        ref<Vec<String>, exclusive> e = HashMap::entry(&mut b.facts.early_ends, stmt_key(s), Vec::new());
        for (usize i = 0; i < Vec::len(&ended); i += 1)
        {
            if (!Vec::contains(e, &ended[i]))
            {
                Vec::push(e, String::clone(&ended[i]));
            }
        }
    }
    rooted
}

// A nested block opens a scope: the bindings it declares end at its exit.
fn check_nested_block(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    usize gamma_mark = Vec::len(&b.gamma_log);
    enter_scope(b);
    Result<Option<Type>, String> r = check_block(b, it, blk, expected);
    r = match (r)
    {
        Ok(t) : match (check_block_exit(b))
        {
            Ok(_)  : Ok(t),
            Err(e) : Err(e),
        },
        Err(e) : Err(e),
    };
    exit_scope(b);
    gamma_undo(b, gamma_mark);
    r
}

// A statement: its expression's type for an expression statement, `None`
// for a declaration; an untagged fault tagged with the last line looked at.
fn check_stmt(ref<Body, exclusive> b, ref<Items, shared> it, ref<Stmt, shared> s) : Result<Option<Type>, String>
{
    match (check_stmt_inner(b, it, s))
    {
        Err(d) :
        {
            if (!String::contains(&d, "@"))
            {
                return Err(sprintf("%s%s", &d, &diag_at(b.current_line, b.current_col)));
            }
            Err(d)
        },
        Ok(t)  : Ok(t),
    }
}

fn path_segs(ref<Expr, shared> e) : Option<ref<Vec<String>, shared>>
{
    match (&e.kind)
    {
        ExprKind::EPath(p) : Some(&Box::get(p).segs),
        _                  : None,
    }
}

fn check_let(ref<Body, exclusive> b, ref<Items, shared> it, ref<LetStmt, shared> l) : Result<Option<Type>, String>
{
    ref<String, shared> name = &l.name;
    match (&l.init)
    {
        Some(e) :
        {
            if (is_spawn_call(e))
            {
                match (&strip_parens_tc(e).kind)
                {
                    ExprKind::ECall(cb) :
                    {
                        HashSet::insert(
                            &mut b.bound_spawns,
                            site_key(Box::get(cb).callee.line, Box::get(cb).callee.col),
                        );
                    },
                    _                   : {},
                }
            }
        },
        None    : {},
    }
    // D-0291: a spawn whose handle the value wraps, on every path or some:
    // the binding holds it, as a handle binding does.
    Vec<TailSite> tails = Vec::new();
    bool tails_all = match (&l.init)
    {
        Some(e) : if (!is_spawn_call(e)) { tail_spawn_sites(e, &mut tails) } else { false },
        None    : false,
    };
    for (usize i = 0; i < Vec::len(&tails); i += 1)
    {
        HashSet::insert(&mut b.bound_spawns, String::clone(&tails[i].key));
        HashMap::insert(&mut b.tail_spawns, String::clone(&tails[i].key), None);
    }
    // `foreach (x in &f())` (D-0042): the hidden `$c` binding would borrow
    // a temporary.
    if (String::starts_with(name, "$c"))
    {
        match (&l.init)
        {
            Some(e) : match (&e.kind)
            {
                ExprKind::EBorrow(bb) :
                {
                    if (is_temp_value(&Box::get(bb).e))
                    {
                        return Err(named_diag(
                            "diag.borrow-of-non-place",
                            &String::from_str("`foreach (x in &e)` borrows only a place, and this is a value: a call's result, a literal, or a constant (which stands for its value); iterate it by value, `foreach (x in e)`, or bind it first"),
                        ));
                    }
                },
                _                     : {},
            },
            None : {},
        }
    }
    Option<Type> expected = match (&l.ty)
    {
        Some(t) : Some(apply_subst(t, &b.subst)),
        None    : None,
    };
    Option<HandleHolder> hand = match (&l.init)
    {
        Some(e) : handle_holder_of(b, it, e),
        None    : None,
    };
    if (Option::is_some(&hand))
    {
        match (&l.init)
        {
            Some(e) : mark_taken(b, it, e),
            None    : {},
        }
    }
    bool saved_handing = replace(&mut b.handing, Option::is_some(&hand));
    // D-0290: a holder moved into a new binding: its facts follow.
    Option<Vec<DerivFact>> held = match (&l.init)
    {
        Some(e) : match (&strip_parens_tc(e).kind)
        {
            ExprKind::EPath(_) : match (one_seg(strip_parens_tc(e)))
            {
                Some(n) : if (is_holder(b, it, n)) { Some(holder_facts(b, n)) } else { None },
                None    : None,
            },
            // D-0291: a consuming `foreach`'s drain of its hidden holder
            // (`auto $d = $each_drain($e, n)`) holds it.
            ExprKind::ECall(cb) :
            {
                ref<CallExpr, shared> c = Box::get(cb);
                bool drain = match (one_seg(&c.callee))
                {
                    Some(n) : String::eq_str(n, "$each_drain"),
                    None    : false,
                };
                if (drain && Vec::len(&c.args) > 0)
                {
                    match (one_seg(strip_parens_tc(&c.args[0])))
                    {
                        Some(n) : if (is_holder(b, it, n)) { Some(holder_facts(b, n)) } else { None },
                        None    : None,
                    }
                }
                else
                {
                    None
                }
            },
            _                   : None,
        },
        None : None,
    };
    bool saved_holding = replace(&mut b.holding, Option::is_some(&held));
    Vec::push(&mut b.spawn_let_depth, Vec::len(&b.scopes));
    Result<Option<Type>, String> ity0 = match (&l.init)
    {
        Some(e) : check_store_operand(b, it, e, &expected),
        None    : Ok(None),
    };
    Vec::pop(&mut b.spawn_let_depth);
    b.handing = saved_handing;
    b.holding = saved_holding;
    Option<Type> ity = ity0?;
    match (&expected)
    {
        Some(exp) : match (&ity)
        {
            Some(actual) :
            {
                if (!has_unresolved_marker(exp) && !has_unresolved_marker(actual) && !ty_compat(exp, actual))
                {
                    ShownPair sp = shown_apart(exp, actual);
                    Option<ref<Expr, shared>> init_ref = match (&l.init)
                    {
                        Some(e) : Some(e),
                        None    : None,
                    };
                    return Err(mismatch(sprintf(
                        "`%s` is declared `%s`, but its initializer is `%s`%s",
                        name,
                        &sp.a,
                        &sp.b,
                        &conversion_hint(exp, actual, init_ref),
                    )));
                }
            },
            None         : {},
        },
        None : {},
    }
    // `[T-Item-Value-Uninferable]` (D-0093).
    if (Option::is_none(&expected) && Option::is_none(&ity))
    {
        match (&l.init)
        {
            Some(e) :
            {
                match (&e.kind)
                {
                    ExprKind::EPath(pb) :
                    {
                        ref<PathExpr, shared> p = Box::get(pb);
                        if (Vec::len(&p.targs) == 0)
                        {
                            String n = String::join(&p.segs[0..$], "::");
                            bool generic = match (HashMap::get(&it.fns, &n))
                            {
                                Some(f) : Vec::len(&f.type_params) > 0,
                                None    : false,
                            };
                            if (generic)
                            {
                                String msg = sprintf(
                                    "nothing here fixes the type parameters of `%s` as a value: write `%s<…>`, or declare the binding's `fn(...)` type",
                                    &n,
                                    &n,
                                );
                                return Err(named_diag("diag.cannot-infer-type-parameter", &msg));
                            }
                        }
                    },
                    _                   : {},
                }
                // A variant of a generic enum whose type arguments nothing
                // fixes (`auto o = None;`).
                Option<Vec<String>> variant = match (&strip_parens_tc(e).kind)
                {
                    ExprKind::EPath(pb) : Some(clone(&Box::get(pb).segs)),
                    ExprKind::ECall(cb) : match (path_segs(&Box::get(cb).callee))
                    {
                        Some(segs) : Some(clone(segs)),
                        None       : None,
                    },
                    _                   : None,
                };
                match (variant)
                {
                    Some(segs) : match (variant_enum(it, &segs))
                    {
                        Some(en) :
                        {
                            bool generic = match (HashMap::get(&it.enums, &en))
                            {
                                Some(ed) : Vec::len(&ed.type_params) > 0,
                                None     : false,
                            };
                            if (generic)
                            {
                                String msg = sprintf(
                                    "nothing here fixes the type of `%s`: declare the binding's type (`Option<i32> x = None;`, `Result<i32, str> r = Ok(5);`)",
                                    &segs[Vec::len(&segs) - 1],
                                );
                                return Err(named_diag("diag.cannot-infer-type-parameter", &msg));
                            }
                        },
                        None     : {},
                    },
                    None : {},
                }
            },
            None    : {},
        }
    }
    Option<Type> final_ty = or_type(expected, ity);
    gamma_set(b, name, clone(&final_ty));
    declare(b, name, Option::is_some(&l.init));
    match (&l.init)
    {
        Some(e) : match (literal_value(e))
        {
            Some(v) :
            {
                if (!b.flow.unreachable)
                {
                    HashMap::insert(&mut b.flow.lits, String::clone(name), v);
                }
            },
            None    : {},
        },
        None : {},
    }
    HashMap::remove(&mut b.closure_moves, name);
    HashMap::remove(&mut b.closure_arity, name);
    HashSet::remove(&mut b.closure_self_writes, name);
    HashSet::remove(&mut b.closure_copied, name);
    HashSet::remove(&mut b.closure_owning, name);
    match (&l.init)
    {
        Some(e) :
        {
            usize n = Vec::len(&b.block_stack);
            usize here = if (n > 0) { b.block_stack[n - 1] } else { 0 };
            check_escape_into(b, it, here, e)?;
            match (&e.kind)
            {
                ExprKind::EClosure(cb) :
                {
                    ref<ClosureExpr, shared> c = Box::get(cb);
                    HashMap::insert(&mut b.closure_moves, String::clone(name), c.is_move);
                    HashMap::insert(&mut b.closure_arity, String::clone(name), Vec::len(&c.params));
                    bool writes = false;
                    bool owns = false;
                    for (usize k = 0; k < Vec::len(&c.captures); k += 1)
                    {
                        if (closure_body_writes(&c.body, String::as_view(&c.captures[k])))
                        {
                            writes = true;
                        }
                        if (place_is_resource(b, it, &c.captures[k], &Vec::new()))
                        {
                            owns = true;
                        }
                    }
                    if (c.is_move && writes)
                    {
                        HashSet::insert(&mut b.closure_self_writes, String::clone(name));
                    }
                    if (!c.is_move || !owns)
                    {
                        HashSet::insert(&mut b.closure_copied, String::clone(name));
                    }
                    else
                    {
                        HashSet::insert(&mut b.closure_owning, String::clone(name));
                    }
                },
                // `auto d = c;` moves the closure, and its arity with it.
                ExprKind::EPath(pb)    :
                {
                    ref<Vec<String>, shared> segs = &Box::get(pb).segs;
                    if (Vec::len(segs) == 1)
                    {
                        Option<usize> arity = match (HashMap::get(&b.closure_arity, &segs[0]))
                        {
                            Some(n) : Some(*n),
                            None    : None,
                        };
                        match (arity)
                        {
                            Some(k) :
                            {
                                HashMap::insert(&mut b.closure_arity, String::clone(name), k);
                            },
                            None    : {},
                        }
                    }
                },
                _                      : {},
            }
        },
        None    : {},
    }
    bool borrow_typed = match (&final_ty)
    {
        Some(t) : is_borrow_ty(t),
        None    : false,
    };
    bool holds = match (&final_ty)
    {
        Some(t) : holds_ref(it, t),
        None    : false,
    };
    bool holder_ty = match (&final_ty)
    {
        Some(t) : holder_type(b, it, t),
        None    : false,
    };
    if (borrow_typed)
    {
        Vec<DerivKey> facts = Vec::new();
        match (&l.init)
        {
            Some(e) : match (deriv_facts_of(b, it, e))
            {
                Some(f) : Vec::push(&mut facts, f),
                None    : facts = contained_ref_facts(b, it, e),
            },
            None : {},
        }
        set_deriv(b, name, facts);
        Option<ref<Expr, shared>> init_ref = match (&l.init)
        {
            Some(e) : Some(e),
            None    : None,
        };
        tier_inherit(b, it, name, init_ref)?;
        Option<Referent> origin = match (&l.init)
        {
            Some(e) : referent_of(b, it, e),
            None    : None,
        };
        HashMap::insert(&mut b.ref_origin, String::clone(name), origin);
    }
    else if (Option::is_some(&held) && holder_ty)
    {
        set_deriv_tri(b, name, Option::unwrap(held));
        HashSet::insert(&mut b.holders, String::clone(name));
    }
    else
    {
        match (&l.init)
        {
            Some(e) :
            {
                if (holds || holder_ty)
                {
                    // D-0088: a value holding a reference from a call
                    // borrows from its arguments; a holder holds what its
                    // initializer holds (D-0290).
                    Vec<DerivKey> facts = if (holder_ty) { Vec::new() } else { contained_ref_facts(b, it, e) };
                    set_deriv(b, name, facts);
                    tier_inherit(b, it, name, Some(e))?;
                }
                else if (Option::is_some(&hand))
                {
                    HandleHolder { facts, .. } = Option::unwrap(hand);
                    set_deriv_tri(b, name, facts);
                }
                else if (is_spawn_call(e))
                {
                    Vec<DerivFact> facts = spawn_facts_tri_of(b, it, e);
                    set_deriv_tri(b, name, facts);
                }
                else if (Vec::len(&tails) > 0)
                {
                    Vec<DerivFact> facts = Vec::new();
                    for (usize i = 0; i < Vec::len(&tails); i += 1)
                    {
                        match (HashMap::remove(&mut b.tail_spawns, &tails[i].key))
                        {
                            Some(Some(f)) : Vec::append(&mut facts, f),
                            _ : rep_left(
                                b,
                                sprintf(
                                    "line %v: a thread is lent references and its handle is not held by this frame",
                                    tails[i].line,
                                ),
                            ),
                        }
                    }
                    // A thread on some paths only: what it was lent is held
                    // on those paths.
                    if (!(tails_all && Vec::len(&tails) == 1))
                    {
                        facts = all_unsure(facts);
                    }
                    set_deriv_tri(b, name, facts);
                }
                else if (is_closure(e))
                {
                    Vec<DerivFact> facts = closure_facts_of(b, it, e);
                    set_deriv_tri(b, name, facts);
                }
                else
                {
                    bool fnish = match (&final_ty)
                    {
                        Some(Type::TFn(_))      : true,
                        Some(Type::TClosure(_)) : true,
                        _                       : false,
                    };
                    if (fnish)
                    {
                        Vec<DerivFact> facts = fn_value_facts(b, it, e);
                        set_deriv_tri(b, name, facts);
                    }
                }
            },
            None    : {},
        }
    }
    Ok(None)
}

fn sorted_unique_count(ref<Vec<String>, shared> v) : usize
{
    Vec<String> s = Vec::clone(v);
    Vec::sort(&mut s);
    Vec::dedup(&mut s);
    Vec::len(&s)
}

fn check_destructure(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<DestructureStmt, shared> d,
) : Result<Option<Type>, String>
{
    ref<String, shared> struct_name = &d.struct_name;
    StringView shown = Option::unwrap_or(String::strip_prefix(struct_name, "std::"), String::as_view(struct_name));
    // D-0118: a bitstruct is read field by field, not taken apart.
    bool bits = match (HashMap::get(&it.structs, struct_name))
    {
        Some(s) : Option::is_some(&s.bits),
        None    : false,
    };
    if (bits)
    {
        return Err(mismatch(sprintf(
            "`%s` is a `bitstruct`, which is not taken apart; read its fields (`x.f`) instead",
            shown,
        )));
    }
    Type sty = named(String::as_view(struct_name), Vec::new());
    Option<Type> st = Result::unwrap_or(check_store_operand(b, it, &d.init, &Some(sty)), None);
    // CHG-0347: a name that is no struct is reported here.
    if (!HashMap::contains(&it.structs, struct_name))
    {
        if (HashMap::contains(&it.enums, struct_name))
        {
            return Err(mismatch(sprintf(
                "`%s` is an enum; destructuring (`Name { f, … } = v;`) takes a struct apart, and an enum's value is taken apart by `match`",
                shown,
            )));
        }
        String msg = sprintf(
            "no struct named `%s` is declared here; destructuring (`Name { f, … } = v;`) names the struct it takes apart",
            shown,
        );
        return Err(named_diag("diag.unbound-name", &msg));
    }
    // `[T-Let-Destructure]`: the value is a `struct_name`.
    bool pattern = match (&d.init.kind)
    {
        ExprKind::EPath(pb) : Vec::len(&Box::get(pb).segs) == 1 && String::starts_with(
            &Box::get(pb).segs[0],
            "__pattern",
        ),
        _ : false,
    };
    match (&st)
    {
        Some(t) :
        {
            if (!has_unresolved_marker(t) && !named_is(t, String::as_view(struct_name)))
            {
                bool ref_to = match (t)
                {
                    Type::TRef(rb) : named_is(&Box::get(rb).inner, String::as_view(struct_name)),
                    _              : false,
                };
                if (ref_to)
                {
                    return Err(mismatch(if (pattern)
                    {
                        sprintf(
                            "a struct pattern takes its `%s` by value (D-0224), and here the value is reached through a reference; bind it whole (`Some(q)`) and read its fields through it (`q.f`), or match the value itself rather than a reference to it",
                            shown,
                        )
                    }
                    else
                    {
                        sprintf(
                            "destructuring takes a `%s` by value, and this is a reference to one; read its fields through it (`r.f`), or destructure the value itself",
                            shown,
                        )
                    }));
                }
                return Err(mismatch(sprintf(
                    "%s names `%s`, but the value is a `%s`",
                    if (pattern) { "the struct pattern" } else { "the destructuring" },
                    shown,
                    &type_display(t),
                )));
            }
        },
        None    : {},
    }
    ref<StructDecl, shared> sdecl = Option::expect(HashMap::get(&it.structs, struct_name), "a struct");
    for (usize i = 0; i < Vec::len(&d.names); i += 1)
    {
        bool known = false;
        for (usize k = 0; k < Vec::len(&sdecl.fields); k += 1)
        {
            if (String::eq(&sdecl.fields[k].name, &d.names[i]))
            {
                known = true;
            }
        }
        if (!known)
        {
            return Err(mismatch(sprintf("`%s` has no field `%s`", shown, &d.names[i])));
        }
    }
    // A struct with its own destructor keeps its fields.
    if (HashMap::contains(&it.fns, &sprintf("%s::drop", struct_name)))
    {
        String msg = sprintf(
            "`%s` has a destructor, which needs its fields, so it cannot be taken apart; move it whole, or `replace` a field",
            &type_display(&named(String::as_view(struct_name), Vec::new())),
        );
        return Err(named_diag("diag.move-out-of-field", &msg));
    }
    // `[Let-Destructure]` (D-0044): every field, each once, or some then
    // `..` (D-0104).
    if (sorted_unique_count(&d.names) != Vec::len(&d.names))
    {
        return Err(mismatch(sprintf("a field of `%s` is named twice", struct_name)));
    }
    if (!d.rest && Vec::len(&d.names) != Vec::len(&sdecl.fields))
    {
        Vec<String> missing = Vec::new();
        for (usize k = 0; k < Vec::len(&sdecl.fields); k += 1)
        {
            if (!Vec::contains(&d.names, &sdecl.fields[k].name))
            {
                Vec::push(&mut missing, String::clone(&sdecl.fields[k].name));
            }
        }
        bool one = Vec::len(&missing) == 1;
        return Err(mismatch(sprintf(
            "destructuring names every field of `%s`; `%s` %s missing — name %s or end with `..` for the rest (D-0104)",
            struct_name,
            &String::join(&missing[0..$], "`, `"),
            if (one) { "is" } else { "are" },
            if (one) { "it" } else { "them" },
        )));
    }
    if (sorted_unique_count(&d.fields) != Vec::len(&d.fields))
    {
        return Err(mismatch(String::from_str("two fields are bound to one name")));
    }
    // The struct's own type arguments, from the value.
    Vec<Type> targs = match (&st)
    {
        Some(t) : named_args(t),
        None    : Vec::new(),
    };
    HashMap<String, Type> tsub = zip_subst(&sdecl.type_params, &targs);
    Vec<String> decl_names = Vec::new();
    for (usize k = 0; k < Vec::len(&sdecl.fields); k += 1)
    {
        Vec::push(&mut decl_names, String::clone(&sdecl.fields[k].name));
    }
    Vec<NamePair> pairs = destructure_pairs(&d.names, &d.fields, d.rest, &decl_names);
    for (usize i = 0; i < Vec::len(&pairs); i += 1)
    {
        ref<String, shared> field = &pairs[i].field;
        ref<String, shared> binder = &pairs[i].binder;
        Option<usize> fi = None;
        for (usize k = 0; k < Vec::len(&sdecl.fields); k += 1)
        {
            if (String::eq(&sdecl.fields[k].name, field))
            {
                fi = Some(k);
            }
        }
        ref<FieldDecl, shared> fd = match (fi)
        {
            Some(k) : &sdecl.fields[k],
            None    : return Err(mismatch(sprintf("`%s` has no field `%s`", struct_name, field))),
        };
        // A private field is not visible, named or not.
        if (!b.privileged && !field_visible(String::as_view(struct_name), fd.export_, String::as_view(&b.module_)))
        {
            String msg = sprintf("field `%s` of `%s` is not exported", field, struct_name);
            return Err(named_diag("diag.name-not-visible", &msg));
        }
        Type ft = apply_subst(&apply_subst(&fd.ty, &tsub), &b.subst);
        gamma_set(b, binder, Some(ft));
        declare(b, binder, true);
    }
    Ok(None)
}

fn check_stmt_inner(ref<Body, exclusive> b, ref<Items, shared> it, ref<Stmt, shared> s) : Result<Option<Type>, String>
{
    match (s)
    {
        Stmt::SLet(l)         : check_let(b, it, Box::get(l)),
        Stmt::SDestructure(d) : check_destructure(b, it, Box::get(d)),
        Stmt::SExpr(e)        : check_expr_stmt(b, it, Box::get(e)),
        Stmt::SBlockLike(e)   : check_expr_stmt(b, it, Box::get(e)),
    }
}

fn check_expr_stmt(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e) : Result<Option<Type>, String>
{
    Option<Type> t = check_expr(b, it, e, &None)?;
    // `[Stmt-Result-Discarded]` (D-0099).
    bool result = match (&t)
    {
        Some(x) : named_is(x, "std::Result"),
        None    : false,
    };
    if (result)
    {
        return Err(named_diag(
            "diag.result-discarded",
            &String::from_str("this `Result` is discarded, so an error it carries would be lost: handle it (`?`, `match`), or discard it on purpose with `_ = …;`"),
        ));
    }
    Ok(t)
}

struct GammaUndo
{
    String name;
    Option<Type> prev;
}

// `name`'s type in `gamma` set (`None`: removed), the type it replaced logged.
fn gamma_set(ref<Body, exclusive> b, ref<String, shared> name, Option<Type> t)
{
    Option<Type> prev = match (t)
    {
        Some(t) : HashMap::insert(&mut b.gamma, String::clone(name), t),
        None    : HashMap::swap_remove(&mut b.gamma, name),
    };
    Vec::push(&mut b.gamma_log, GammaUndo { .name = String::clone(name), .prev = prev });
}

// `gamma` as it was when the log was `mark` long.
fn gamma_undo(ref<Body, exclusive> b, usize mark)
{
    while (Vec::len(&b.gamma_log) > mark)
    {
        GammaUndo u = Option::expect(Vec::pop(&mut b.gamma_log), "a logged write");
        GammaUndo { name, prev } = u;
        match (prev)
        {
            Some(t) :
            {
                HashMap::insert(&mut b.gamma, name, t);
            },
            None    :
            {
                HashMap::swap_remove(&mut b.gamma, &name);
            },
        }
    }
}

fn lookup_local(ref<Body, shared> b, ref<String, shared> name) : Option<Type>
{
    match (HashMap::get(&b.gamma, name))
    {
        Some(t) : Some(clone(t)),
        None    : None,
    }
}

// A binding in scope, whether or not this pass knows its type.
fn is_local(ref<Body, shared> b, ref<String, shared> name) : bool
{
    HashMap::contains(&b.gamma, name) || flow_is_tracked(&b.flow, name) || HashSet::contains(&b.capture_names, name)
}

fn is_value_read_shape(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EField(_) : true,
        ExprKind::EIndex(_) : true,
        ExprKind::EDeref(_) : true,
        _                   : false,
    }
}

// Tags the first untagged fault that passes through with this
// expression's own line.
fn check_expr(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    b.current_line = e.line;
    b.current_col = e.col;
    b.cur_temp_ok = replace(&mut b.arg_temp_ok, false);
    b.cur_arg_ref_param = replace(&mut b.arg_ref_param, false);
    // D-0218: a field, element or `*r` read as a value through a shared
    // reference.
    bool exempt = replace(&mut b.read_exempt, false) || b.place_pos;
    match (&e.kind)
    {
        ExprKind::EParen(_) : b.read_exempt = exempt,
        _                   : {},
    }
    bool value_read = !exempt && is_value_read_shape(e);
    Result<Option<Type>, String> r = check_expr_inner(b, it, e, expected);
    r = match (r)
    {
        Ok(Some(t)) : if (value_read) { read_through_shared(b, it, e, t, expected) } else { Ok(Some(t)) },
        other       : other,
    };
    match (r)
    {
        Err(d) :
        {
            if (!String::contains(&d, "@"))
            {
                return Err(sprintf("%s%s", &d, &diag_at(e.line, e.col)));
            }
            Err(d)
        },
        Ok(t)  : Ok(t),
    }
}

fn is_excl_ref_or_slice(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(Type::TRef(rb))   : Box::get(rb).mode == Mode::Exclusive,
        Some(Type::TSlice(sb)) : Box::get(sb).mode == Mode::Exclusive,
        _                      : false,
    }
}

fn copies_excl_msg(ref<Type, shared> t) : String
{
    String msg = sprintf(
        "this copies a `%s`, which holds an exclusive reference, out through a shared reference (D-0218): the copy could write what the shared reference reaches; borrow it instead (`&e`), or pass the owner by `ref<_, exclusive>`",
        &type_display(t),
    );
    named_diag("diag.borrow-exceeds-source", &msg)
}

// `[Read-Ref-Through-Shared]` and `[Read-Exclusive-Through-Shared]`
// (spec/08, D-0218).
fn read_through_shared(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    Type t,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    if (has_unresolved_marker(&t) || !crosses_shared(b, it, e))
    {
        return Ok(Some(t));
    }
    bool excl = match (&t)
    {
        Type::TRef(rb)   : Box::get(rb).mode == Mode::Exclusive,
        Type::TSlice(sb) : Box::get(sb).mode == Mode::Exclusive,
        _                : false,
    };
    if (excl)
    {
        bool slc = match (&t)
        {
            Type::TSlice(_) : true,
            _               : false,
        };
        if (is_excl_ref_or_slice(expected))
        {
            return Err(named_diag(
                "diag.borrow-exceeds-source",
                &String::from_str("this exclusive reference is read through a shared reference, so it is shared here (D-0218): what a shared reference reaches cannot be written, at any depth; pass the struct by `ref<_, exclusive>` to write through it"),
            ));
        }
        if (b.facts.silent)
        {
            return Err(named_diag(
                "diag.borrow-exceeds-source",
                &String::from_str("an exclusive reference read through a shared reference in a body checked after the program was built"),
            ));
        }
        note_rewrite(b, e, if (slc) { Rewrite::SharedSlice } else { Rewrite::SharedRef });
        Type inner = Option::expect(inner_of(&t), "a reference's referent");
        return Ok(Some(if (slc) { slice_of(inner, Mode::Shared) } else { ref_of(inner, Mode::Shared) }));
    }
    if (contains_fn(it, &t))
    {
        // A `fn` type does not show its closure's captures: each tool
        // checks where this is read or called (`[Read-Fn-Through-Shared]`).
        HashSet::insert(&mut b.facts.shared_fn_reads, e.id);
        if (holds_excl_ref(it, &t, 0))
        {
            return Err(copies_excl_msg(&t));
        }
        return Ok(Some(t));
    }
    if (holds_excl_ref(it, &t, 0))
    {
        return Err(copies_excl_msg(&t));
    }
    Ok(Some(t))
}

// An operand whose type the rule fixes: an `if`/`while` condition, an
// index or a slice bound.
fn check_expect(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Type, shared> want,
) : Result<void, String>
{
    Option<Type> t = check_expr(b, it, e, &Some(clone(want)))?;
    match (&t)
    {
        Some(x) :
        {
            if (!has_unresolved_marker(x) && !ty_compat(x, want))
            {
                bool assign = match (&strip_parens_tc(e).kind)
                {
                    ExprKind::EAssign(_) : true,
                    _                    : false,
                };
                str hint = if (type_eq(
                    want,
                    &Type::TBool,
                ) && assign) { "; `=` assigns (its value is `void`) -- compare with `==`" } else { "" };
                return Err(sprintf(
                    "%s%s",
                    &mismatch(sprintf("expected `%s`, found `%s`%s", &type_display(want), &type_display(x), hint)),
                    &diag_at(e.line, e.col),
                ));
            }
        },
        None    : {},
    }
    Ok(())
}

// ---- helpers from later in typecheck.rs ----

export struct NamePair
{
    export String field;
    export String binder;
}

// `ast::destructure_pairs`: each named field with its binder, and with
// `..` the others, bound to hidden names.
export fn destructure_pairs(
    ref<Vec<String>, shared> names,
    ref<Vec<String>, shared> binders,
    bool rest,
    ref<Vec<String>, shared> decl_fields,
) : Vec<NamePair>
{
    Vec<NamePair> out = Vec::new();
    for (usize i = 0; i < Vec::len(names) && i < Vec::len(binders); i += 1)
    {
        Vec::push(&mut out, NamePair { .field = String::clone(&names[i]), .binder = String::clone(&binders[i]) });
    }
    if (rest)
    {
        for (usize i = 0; i < Vec::len(decl_fields); i += 1)
        {
            if (!Vec::contains(names, &decl_fields[i]))
            {
                Vec::push(
                    &mut out,
                    NamePair { .field = String::clone(&decl_fields[i]), .binder = sprintf(
                        "$rest_%s",
                        &decl_fields[i],
                    ) },
                );
            }
        }
    }
    out
}

export struct TextEqRewrite
{
    export bool string_left;
    export bool other_is_str;
    export bool negate;
}

/// A front-end rewrite the checker asks for (D-0164), keyed by the node.
export enum Rewrite
{
    TextEq(TextEqRewrite),
    // D-0218: an exclusive reference read through a shared one: `&*e`.
    SharedRef,
    // D-0218: the same for a slice: `&e[0..$]`.
    SharedSlice,
    // D-0225: a text literal where a variant's payload is a `StringView`.
    LiteralView,
}

fn note_rewrite(ref<Body, exclusive> b, ref<Expr, shared> e, Rewrite r)
{
    if (b.facts.silent)
    {
        return;
    }
    HashMap::insert(&mut b.facts.rewrites, e.id, r);
}

fn note_literal_as_string(ref<Body, exclusive> b, ref<Expr, shared> e, bool as_string)
{
    if (b.facts.silent)
    {
        return;
    }
    ref<Expr, shared> x = strip_parens_tc(e);
    if (as_string)
    {
        HashSet::insert(&mut b.facts.literal_yes, x.id);
    }
    else
    {
        HashSet::insert(&mut b.facts.literal_no, x.id);
    }
}

fn is_float_type(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TF32 : true,
        Type::TF64 : true,
        _          : false,
    }
}

// What to write when a value of type `got` stands where `want` is
// required: the conversion, borrow or constructor that gives one.
fn conversion_hint(ref<Type, shared> want, ref<Type, shared> got, Option<ref<Expr, shared>> e) : String
{
    bool int_literal = match (e)
    {
        Some(x) : match (&strip_parens_tc(x).kind)
        {
            ExprKind::EInt(_) : true,
            _                 : false,
        },
        None : false,
    };
    String x = match (e)
    {
        Some(ex) : match (&strip_parens_tc(ex).kind)
        {
            ExprKind::EPath(pb) :
            {
                if (Vec::len(&Box::get(pb).segs) == 1) { String::from_view(shown_name(String::as_view(&Box::get(pb).segs[0]))) } else { String::from_str("x") }
            },
            ExprKind::EBorrow(bb) : match (&strip_parens_tc(&Box::get(bb).e).kind)
            {
                ExprKind::EPath(pb) :
                {
                    if (Vec::len(&Box::get(pb).segs) == 1) { String::from_view(shown_name(String::as_view(&Box::get(pb).segs[0]))) } else { String::from_str("x") }
                },
                _                   : String::from_str("x"),
            },
            _                   : String::from_str("x"),
        },
        None : String::from_str("x"),
    };
    match (want)
    {
        Type::TInt(w) : match (got)
        {
            Type::TInt(g) :
            {
                IntRange wr = int_range(*w);
                IntRange gr = int_range(*g);
                if (wr.min <= gr.min && gr.max <= wr.max)
                {
                    return sprintf("; convert it: `widen<%s>(…)`", int_ty_name(*w));
                }
                return sprintf(
                    "; convert it: `narrow<%s>(…)` (checked: faults when the value does not fit) or `narrow_wrapping<%s>(…)`",
                    int_ty_name(*w),
                    int_ty_name(*w),
                );
            },
            Type::TF32 : return sprintf(
                "; convert it with `to_int<%s>(…)` (toward zero, checked)",
                &type_display(want),
            ),
            Type::TF64 : return sprintf(
                "; convert it with `to_int<%s>(…)` (toward zero, checked)",
                &type_display(want),
            ),
            _             : {},
        },
        Type::TF32 : match (got)
        {
            Type::TInt(_) : return if (int_literal) { String::from_str("; an integer literal is not a float -- write it with a point (`3.0`)") } else
            {
                sprintf(
                    "; convert it with `to_float<%s>(…)`",
                    &type_display(want),
                )
            },
            Type::TF64 : return sprintf("; convert it with `to_float<%s>(…)`", &type_display(want)),
            _          : {},
        },
        Type::TF64 : match (got)
        {
            Type::TInt(_) : return if (int_literal) { String::from_str("; an integer literal is not a float -- write it with a point (`3.0`)") } else
            {
                sprintf(
                    "; convert it with `to_float<%s>(…)`",
                    &type_display(want),
                )
            },
            Type::TF32 : return sprintf("; convert it with `to_float<%s>(…)`", &type_display(want)),
            _          : {},
        },
        Type::TBool : match (got)
        {
            Type::TInt(_) : return String::from_str("; a number is not a `bool` -- compare it (`x != 0`)"),
            _             : {},
        },
        _ : {},
    }
    match (want)
    {
        Type::TNamed(nb) :
        {
            ref<String, shared> n = &Box::get(nb).name;
            match (got)
            {
                Type::TStr     :
                {
                    if (String::eq_str(n, "std::String"))
                    {
                        return String::from_str("; a `str` value becomes a `String` with `String::from_str(…)` (a literal is one already where a `String` is declared, D-0149)");
                    }
                    if (String::eq_str(n, "std::StringView"))
                    {
                        return sprintf("; view it with `StringView::of(%s)`", &x);
                    }
                },
                Type::TRef(rb) :
                {
                    if (String::eq_str(n, "std::StringView") && named_is(&Box::get(rb).inner, "std::String"))
                    {
                        return sprintf("; view the whole text: `&%s[0..$]`", &x);
                    }
                },
                _              : {},
            }
        },
        Type::TRef(rb)   :
        {
            ref<ModedTy, shared> r = Box::get(rb);
            if (type_eq(&r.inner, got))
            {
                return sprintf(
                    "; pass a reference: `%s%s`",
                    if (r.mode == Mode::Exclusive) { "&mut " } else { "&" },
                    &x,
                );
            }
            match (got)
            {
                Type::TRef(gb) :
                {
                    if (r.mode == Mode::Exclusive && Box::get(gb).mode == Mode::Shared && type_eq(
                        &r.inner,
                        &Box::get(gb).inner,
                    ))
                    {
                        return sprintf("; the parameter writes through it -- pass `&mut %s`", &x);
                    }
                },
                _              : {},
            }
        },
        _                : {},
    }
    String::new()
}

fn compare_hint(ref<Type, shared> a, ref<Type, shared> b) : String
{
    match (a)
    {
        Type::TInt(_) : match (b)
        {
            Type::TInt(_) : return String::from_str("; convert one side first (`widen<T>(…)` or `narrow<T>(…)`) so both have one type"),
            Type::TF32    : return String::from_str("; convert one side first (`to_float<T>(…)` or `to_int<T>(…)`)"),
            Type::TF64    : return String::from_str("; convert one side first (`to_float<T>(…)` or `to_int<T>(…)`)"),
            _             : {},
        },
        Type::TF32 : match (b)
        {
            Type::TInt(_) : return String::from_str("; convert one side first (`to_float<T>(…)` or `to_int<T>(…)`)"),
            _             : {},
        },
        Type::TF64 : match (b)
        {
            Type::TInt(_) : return String::from_str("; convert one side first (`to_float<T>(…)` or `to_int<T>(…)`)"),
            _             : {},
        },
        _ : {},
    }
    String::new()
}

fn slice_of_value_msg() : String
{
    named_diag(
        "diag.borrow-of-non-place",
        &String::from_str("`&e[lo .. hi]` slices a place (a binding, a field, an element, `*r`); `e` here is a value (a call's result or a literal), which can be sliced only as an argument of a call whose result is not a reference; elsewhere, bind it first, then slice the binding"),
    )
}

fn is_spawn_call(ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::ECall(cb) : match (path_segs(&Box::get(cb).callee))
        {
            Some(segs) : Vec::len(segs) == 1 && String::eq_str(&segs[0], "spawn"),
            None       : false,
        },
        _ : false,
    }
}

fn is_bare_num_literal(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EInt(lb) : match (&Box::get(lb).sfx)
        {
            Some(s) : String::eq_str(s, "byte"),
            None    : true,
        },
        ExprKind::EFloat(fb) : Option::is_none(&Box::get(fb).sfx),
        ExprKind::EUnary(u)  : Box::get(u).op == UnOp::Neg && is_bare_num_literal(&Box::get(u).e),
        ExprKind::EParen(x)  : is_bare_num_literal(Box::get(x)),
        _                    : false,
    }
}

fn mentions_any(ref<Type, shared> ty, ref<HashSet<String>, shared> names) : bool
{
    match (ty)
    {
        Type::TNamed(nb) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (Vec::len(&n.args) == 0 && HashSet::contains(names, &n.name))
            {
                return true;
            }
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (mentions_any(&n.args[i], names))
                {
                    return true;
                }
            }
            false
        },
        Type::TFn(fb)    :
        {
            ref<FnTy, shared> f = Box::get(fb);
            for (usize i = 0; i < Vec::len(&f.params); i += 1)
            {
                if (mentions_any(&f.params[i], names))
                {
                    return true;
                }
            }
            mentions_any(&f.ret, names)
        },
        _ : match (inner_of(ty))
        {
            Some(t) : mentions_any(&t, names),
            None    : false,
        },
    }
}

// ---- part 6: typecheck.rs lines 3172-3970 (check_expr_inner) ----

export struct ViewEq
{
    export bool view_left;
    export bool other_is_str;
    export bool negate;
}

export struct ViewLess
{
    export bool swap;
    export bool negate;
}

/// A `StringView` operation written with the language's own syntax
/// (`interp::ViewOp`, D-0053).
export enum ViewOp
{
    SliceString,
    SliceView,
    VEq(ViewEq),
    TextCmp,
    VLess(ViewLess),
    KeyCmp,
}

fn temp_msg() : String
{
    named_diag(
        "diag.borrow-of-temporary",
        &String::from_str("this is part of a temporary (a call's result or a literal), which ends with the statement; bind the value first, then borrow from the binding"),
    )
}

fn deref_to(Option<Type> t) : Option<Type>
{
    match (t)
    {
        Some(x) : Some(through_ref_or_guard(x)),
        None    : None,
    }
}

fn opt_is_ref(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(Type::TRef(_)) : true,
        _                   : false,
    }
}

fn check_expr_inner(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    bool in_place = replace(&mut b.place_pos, false);
    match (&e.kind)
    {
        ExprKind::EInt(lb)         :
        {
            ref<IntLit, shared> lit = Box::get(lb);
            // D-0090: a literal marked by the generic pass, at a
            // floating-point instantiation of its `number` parameter.
            if (Option::is_none(&lit.sfx) && is_float_opt(expected) && HashSet::contains(
                &b.facts.number_literals,
                &e.id,
            ))
            {
                return Ok(clone(expected));
            }
            Option<Type> t = check_int_lit(b, lit.v, &lit.sfx, expected)?;
            match (&t)
            {
                Some(m) :
                {
                    if (is_marker(m))
                    {
                        HashSet::insert(&mut b.facts.number_literals, e.id);
                    }
                },
                None    : {},
            }
            Ok(t)
        },
        ExprKind::EFloat(fb)       :
        {
            ref<FloatLit, shared> lit = Box::get(fb);
            Type t = match (&lit.sfx)
            {
                Some(s) : if (String::eq_str(
                    s,
                    "f32",
                )) { Type::TF32 } else if (String::eq_str(
                    s,
                    "f64",
                )) { Type::TF64 } else { float_from_expected(expected) },
                None : float_from_expected(expected),
            };
            // `[Literal-Out-Of-Range]`: a literal beyond the type's largest
            // finite magnitude.
            bool f32_ = match (&t)
            {
                Type::TF32 : true,
                _          : false,
            };
            f64 v = if (f32_) { widen<f64>(to_float<f32>(lit.v)) } else { lit.v };
            if (!is_finite(v) && !is_nan(v))
            {
                String msg = sprintf("this literal is beyond `%s`'s largest finite value", &type_display(&t));
                return Err(named_diag("diag.literal-out-of-range", &msg));
            }
            Ok(Some(t))
        },
        // `[T-Lit-Str]`: always `str`; takes no expected type.
        ExprKind::EStr(_)          : Ok(Some(Type::TStr)),
        ExprKind::EBool(_)         : Ok(Some(Type::TBool)),
        ExprKind::EUnit            : Ok(Some(Type::TVoid)),
        ExprKind::EParen(x)        :
        {
            // A parenthesized place is the same place.
            b.place_pos = in_place;
            check_expr(b, it, Box::get(x), expected)
        },
        ExprKind::EPath(pb)        :
        {
            ref<PathExpr, shared> p = Box::get(pb);
            String joined_name = String::join(&p.segs[0..$], "::");
            // D-0258: a static is never read or moved whole.
            if (!in_place && HashMap::contains(&it.statics, &joined_name))
            {
                String msg = sprintf(
                    "`%s` is a static: it is borrowed (`&%s`) and changed through its operations, never read or moved whole",
                    &joined_name,
                    &joined_name,
                );
                return Err(named_diag("diag.read-of-resource", &msg));
            }
            Option<Type> t = check_path(b, it, &p.segs)?;
            if (Option::is_none(&t))
            {
                // `[T-Item-Generic]` (D-0093): a generic item as a value.
                t = generic_item_value(b, it, &p.segs, &p.targs, expected)?;
            }
            if (!in_place)
            {
                if (Vec::len(&p.segs) == 1 && !replace(&mut b.cur_arg_ref_param, false))
                {
                    tier_referent_reach(b, it, &p.segs[0], None);
                }
                flow_read(b, it, e)?;
            }
            Ok(t)
        },
        ExprKind::EUnary(ub)       : check_unary(b, it, Box::get(ub).op, &Box::get(ub).e, expected),
        ExprKind::EBinary(bb) : check_binary(
            b,
            it,
            Box::get(bb).op,
            &Box::get(bb).a,
            &Box::get(bb).b,
            e,
            expected,
        ),
        ExprKind::EBorrow(bb)      : check_borrow(b, it, e, Box::get(bb).mode, &Box::get(bb).e, expected),
        ExprKind::ESliceOf(sb)     :
        {
            ref<SliceExpr, shared> s = Box::get(sb);
            if (Option::is_some(&view_base(b, it, &s.base)))
            {
                return check_view_slice(b, it, e, s);
            }
            check_slice(b, it, e, s)
        },
        ExprKind::EDollar          : Ok(Some(Type::TInt(IntTy::Usize))),
        ExprKind::EDeref(xb)       :
        {
            ref<Expr, shared> inner = Box::get(xb);
            // `*g` through a guard accesses the guarded value in place.
            bool through_guard = match (static_place_type(b, it, inner))
            {
                Some(Type::TGuard(_)) : true,
                _                     : false,
            };
            if (through_guard)
            {
                b.place_pos = true;
                match (place_of(b, it, inner))
                {
                    Some(p) :
                    {
                        if (!tri_is(&b.flow.init, &p.root, Tri::T))
                        {
                            refute(b, &uninit_msg(String::as_view(&p.root)))?;
                        }
                    },
                    None    : {},
                }
            }
            b.read_exempt = true;
            Option<Type> ti = check_expr(b, it, inner, &None)?;
            match (&ti)
            {
                Some(t) :
                {
                    if (is_marker(t))
                    {
                        return Err(unbounded_msg("`*` (dereference)"));
                    }
                },
                None    : {},
            }
            bool raw = match (&ti)
            {
                Some(Type::TRawptr(_)) : true,
                _                      : false,
            };
            if (raw && b.unsafe_depth == 0)
            {
                return Err(String::from_str("diag.trusted-outside-unsafe"));
            }
            Option<Type> ty = match (ti)
            {
                Some(Type::TRef(rb))    : Some(Box::into_inner(rb).inner),
                Some(Type::TGuard(gb))  : Some(Box::into_inner(gb)),
                Some(Type::TRawptr(pb)) : Some(Box::into_inner(pb)),
                // `*e` of a value that is no reference, guard or raw pointer.
                Some(t)                 :
                {
                    bool plain = match (&t)
                    {
                        Type::TInt(_)    : true,
                        Type::TF32       : true,
                        Type::TF64       : true,
                        Type::TBool      : true,
                        Type::TStr       : true,
                        Type::TArray(_)  : true,
                        Type::TSimd(_)   : true,
                        Type::THandle(_) : true,
                        Type::TMutex(_)  : true,
                        Type::TVoid      : true,
                        Type::TNamed(_)  : true,
                        _                : false,
                    };
                    if (!has_unresolved_marker(&t) && plain)
                    {
                        return Err(mismatch(sprintf(
                            "`*` needs a reference, a guard or a raw pointer, but this is `%s`",
                            &type_display(&t),
                        )));
                    }
                    None
                },
                None                    : None,
            };
            // `*r` read in value position is a `[Read]` of the place `*r`.
            if (!in_place)
            {
                flow_read(b, it, e)?;
            }
            Ok(ty)
        },
        ExprKind::EField(fb)       :
        {
            b.place_pos = true;
            Option<Type> t = check_field(b, it, &Box::get(fb).e, &Box::get(fb).name)?;
            if (!in_place)
            {
                flow_read(b, it, e)?;
            }
            Ok(t)
        },
        ExprKind::EIndex(ib)       : check_index(b, it, e, &Box::get(ib).a, &Box::get(ib).b, in_place),
        ExprKind::ECall(cb)        :
        {
            Option<Type> t = check_call(b, it, &Box::get(cb).callee, &Box::get(cb).args, expected)?;
            if (opt_is_ref(&t))
            {
                Option<Referent> r = referent_of(b, it, e);
                HashMap::insert(&mut b.borrow_referents, e.id, r);
            }
            Ok(t)
        },
        ExprKind::EStructLit(sb) : check_struct_lit(
            b,
            it,
            &Box::get(sb).segs,
            &Box::get(sb).targs,
            &Box::get(sb).fields,
            expected,
        ),
        ExprKind::EArrayLit(es)    : check_array_lit(b, it, es, expected),
        // `[v; N]` (D-0072): v is read once and copied into every element,
        // so its type is plain.
        ExprKind::EArrayRepeat(rb) : check_array_repeat(b, it, &Box::get(rb).value, Box::get(rb).n, expected),
        ExprKind::EAssign(pb)      : check_assign(b, it, &Box::get(pb).a, &Box::get(pb).b),
        ExprKind::EPropagate(x)    : check_propagate(b, it, Box::get(x)),
        ExprKind::EBlock(blk)      : check_nested_block(b, it, blk, expected),
        ExprKind::EUnsafe(blk)     :
        {
            b.unsafe_depth += 1;
            Result<Option<Type>, String> r = check_nested_block(b, it, blk, expected);
            b.unsafe_depth -= 1;
            r
        },
        ExprKind::EIf(ib)          : check_if(b, it, e, Box::get(ib), expected),
        ExprKind::EWhile(wb)       :
        {
            ref<WhileExpr, shared> w = Box::get(wb);
            Option<ref<Expr, shared>> step = match (&w.step)
            {
                Some(s) : Some(s),
                None    : None,
            };
            check_while(b, it, &w.cond, &w.body, step)
        },
        ExprKind::EMatch(mb)       : check_match(b, it, e, &Box::get(mb).scrut, &Box::get(mb).arms, expected),
        ExprKind::EReturn(opt)     : check_return(b, it, opt),
        ExprKind::EBreak           : check_break(b, true),
        ExprKind::EContinue        : check_break(b, false),
        ExprKind::EClosure(cb)     :
        {
            ref<ClosureExpr, shared> c = Box::get(cb);
            Option<Type> t = check_closure(b, it, c.is_move, &c.captures, &c.params, &c.ret, &c.body, expected)?;
            // D-0073: the evaluators give the body's value this result type.
            match (&t)
            {
                Some(ft) : match (ft)
                {
                    Type::TFn(_) :
                    {
                        if (!has_unresolved_marker(ft) && HashMap::len(&b.subst) == 0)
                        {
                            HashMap::insert(&mut b.facts.closure_types, e.id, clone(ft));
                        }
                    },
                    _            : {},
                },
                None : {},
            }
            Ok(t)
        },
    }
}

fn is_float_opt(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(Type::TF32) : true,
        Some(Type::TF64) : true,
        _                : false,
    }
}

fn float_from_expected(ref<Option<Type>, shared> expected) : Type
{
    match (expected)
    {
        Some(Type::TF32) : Type::TF32,
        _                : Type::TF64,
    }
}

fn check_borrow(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    Mode m,
    ref<Expr, shared> inner,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    tier_elem_access(b, it, inner, m)?;
    tier_slice_reborrow(b, it, inner, m);
    // D-0289: through an exclusive reference to what holds a lending
    // thread's handle the handle can be moved out of this analysis' sight
    // (swapped into longer-lived data): only the `Vec` operations that
    // keep it here may have one.
    if (m == Mode::Exclusive && !replace(&mut b.handle_borrow_ok, false) && b.report && !b.flow.unreachable)
    {
        Option<String> holder_name = match (&strip_parens_tc(inner).kind)
        {
            ExprKind::EPath(_) : match (handle_holder_of(b, it, inner))
            {
                Some(hh) :
                {
                    HandleHolder { name, .. } = hh;
                    Some(name)
                },
                None     : None,
            },
            _ : None,
        };
        match (holder_name)
        {
            Some(n) :
            {
                String why = sprintf(
                    "line %v: `%s` is borrowed exclusively while it holds what its threads were lent",
                    b.current_line,
                    shown_name(String::as_view(&n)),
                );
                rep_left(b, why);
            },
            None    : {},
        }
    }
    // D-0218: a closure called through a shared reference may not write
    // through what it captured; which closure a `fn` value is, the run
    // knows (D-0288).
    if (m == Mode::Shared && b.report && !b.flow.unreachable)
    {
        match (one_seg(strip_parens_tc(inner)))
        {
            Some(n) :
            {
                bool fnish = match (HashMap::get(&b.gamma, n))
                {
                    Some(Type::TFn(_))      : true,
                    Some(Type::TClosure(_)) : true,
                    _                       : false,
                };
                if (fnish)
                {
                    rep_left(
                        b,
                        sprintf(
                            "line %v: the `fn` value `%s` is reached through a shared reference, and only the run knows whether it writes what it captured (D-0218)",
                            b.current_line,
                            shown_name(String::as_view(n)),
                        ),
                    );
                }
            },
            None    : {},
        }
    }
    // D-0258 `[Ref-Form-Static]`: `&NAME` of a static.
    match (path_segs(strip_parens_tc(inner)))
    {
        Some(segs) :
        {
            match (HashMap::get(&it.statics, &String::join(&segs[0..$], "::")))
            {
                Some(s) :
                {
                    if (m == Mode::Exclusive)
                    {
                        String msg = sprintf(
                            "`%s` is a static, shared by every thread: borrow it `&%s` and change it through its operations",
                            &s.name,
                            &s.name,
                        );
                        return Err(named_diag("diag.write-through-shared", &msg));
                    }
                    return Ok(Some(ref_of(clone(&s.ty), Mode::Shared)));
                },
                None    : {},
            }
        },
        None       : {},
    }
    // D-0258 `[Ref-Form-Const]`: `&K` of a constant of plain data written
    // as a literal.
    match (&strip_parens_tc(inner).kind)
    {
        ExprKind::ECall(cb) :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            match (path_segs(&c.callee))
            {
                Some(segs) :
                {
                    if (Vec::len(&c.args) == 0)
                    {
                        String key = String::join(&segs[0..$], "::");
                        match (HashMap::get(&it.fns, &key))
                        {
                            Some(f) :
                            {
                                if (f.is_const)
                                {
                                    bool literal = match (&f.body.tail)
                                    {
                                        Some(t) : literal_tree(Box::get(t)),
                                        None    : false,
                                    };
                                    if (literal && Option::is_none(&plain_problem(b, it, &f.ret)))
                                    {
                                        if (m == Mode::Exclusive)
                                        {
                                            String msg = sprintf(
                                                "`%s` is a constant: borrow it `&%s`; it cannot be written",
                                                &f.name,
                                                &f.name,
                                            );
                                            return Err(named_diag("diag.borrow-of-non-place", &msg));
                                        }
                                        HashSet::insert(&mut b.facts.const_addrs, key);
                                        return Ok(Some(ref_of(clone(&f.ret), Mode::Shared)));
                                    }
                                }
                            },
                            None    : {},
                        }
                    }
                },
                None       : {},
            }
        },
        _                   : {},
    }
    // D-0254: nor has a lane of a `simd`.
    match (&strip_parens_tc(inner).kind)
    {
        ExprKind::EIndex(ib) :
        {
            Option<Type> bt = deref_to(static_place_type(b, it, &Box::get(ib).a));
            match (&bt)
            {
                Some(st) :
                {
                    if (is_simd(st))
                    {
                        String msg = sprintf(
                            "a lane of a `%s` is not a place of its own: read it (`v[i]`), assign it (`v[i] = x`), or borrow the whole vector",
                            &type_display(st),
                        );
                        return Err(named_diag("diag.borrow-of-non-place", &msg));
                    }
                },
                None     : {},
            }
        },
        _                    : {},
    }
    // D-0118: a bit field has no address of its own.
    match (bitfield_of(b, it, inner))
    {
        Some(bf) :
        {
            String fname = match (&strip_parens_tc(inner).kind)
            {
                ExprKind::EField(fb) : String::clone(&Box::get(fb).name),
                _                    : String::new(),
            };
            StringView sn = Option::unwrap_or(String::strip_prefix(&bf.sname, "std::"), String::as_view(&bf.sname));
            String msg = sprintf(
                "field `%s` of `bitstruct %s` is a run of bits, not a place: read it (`x.%s`), assign it (`x.%s = v`), or borrow the whole `%s`",
                &fname,
                sn,
                &fname,
                &fname,
                sn,
            );
            return Err(named_diag("diag.borrow-of-non-place", &msg));
        },
        None     : {},
    }
    // D-0073: as an argument of a call whose result is not a reference, a
    // temporary is borrowed until the statement ends.
    bool temp_ok = replace(&mut b.cur_temp_ok, false);
    // D-0103: a field or element of such a temporary, as an argument.
    if (temp_ok && !is_temp_value(inner) && borrow_operand_kind(b, it, inner) == OperandKind::Temporary)
    {
        b.place_pos = true;
        Option<Type> ti = check_expr(b, it, inner, &None)?;
        HashSet::insert(&mut b.facts.temp_borrows, e.id);
        return Ok(match (ti)
        {
            Some(t) : Some(ref_of(t, m)),
            None    : None,
        });
    }
    // A payload-less variant (`&None`) is a value, not a place.
    bool variant_value = match (path_segs(strip_parens_tc(inner)))
    {
        Some(segs) : !is_local(b, &segs[0]) && Option::is_some(&variant_enum(it, segs)),
        None       : false,
    };
    if (variant_value && !temp_ok)
    {
        return Err(named_diag(
            "diag.borrow-of-non-place",
            &String::from_str("a variant is a value, which can be borrowed only as an argument of a call whose result is not a reference; elsewhere, bind it first"),
        ));
    }
    if (temp_ok && (is_temp_value(inner) || variant_value))
    {
        // The referent type the argument's parameter expects (D-0084).
        Option<Type> pointee = match (expected)
        {
            Some(Type::TRef(rb)) : if (!has_unresolved_marker(&Box::get(rb).inner)) { Some(clone(&Box::get(rb).inner)) } else { None },
            _                    : None,
        };
        Option<Type> ti = check_expr(b, it, inner, &pointee)?;
        if (opt_is_ref(&ti))
        {
            return Err(String::from_str("diag.borrow-of-non-place"));
        }
        HashSet::insert(&mut b.facts.temp_borrows, e.id);
        return Ok(match (ti)
        {
            Some(t) : Some(ref_of(t, m)),
            None    : None,
        });
    }
    // `[Ref-Form-Not-Place]` / `[Ref-Form-Temporary]` (spec/09 §2).
    match (borrow_operand_kind(b, it, inner))
    {
        OperandKind::NonPlace  :
        {
            if (is_temp_value(inner))
            {
                return Err(named_diag(
                    "diag.borrow-of-non-place",
                    &String::from_str("a temporary can be borrowed only as an argument of a call whose result is not a reference; elsewhere, bind it first"),
                ));
            }
            return Err(named_diag(
                "diag.borrow-of-non-place",
                &String::from_str("`&` borrows a place (a binding, a field, an element, `*r`); this is a value, which can be borrowed only as an argument of a call whose result is not a reference; elsewhere, bind it first"),
            ));
        },
        OperandKind::Temporary : return Err(temp_msg()),
        OperandKind::Place     : {},
    }
    // `[Borrow-Exceeds-Source]` (spec/08).
    if (m == Mode::Exclusive && crosses_shared(b, it, inner))
    {
        return Err(String::from_str("diag.borrow-exceeds-source"));
    }
    b.place_pos = true;
    Option<Type> ti = check_expr(b, it, inner, &None)?;
    flow_borrow(b, it, inner, m)?;
    Option<Referent> r = referent_of(b, it, e);
    HashMap::insert(&mut b.borrow_referents, e.id, r);
    Ok(match (ti)
    {
        Some(t) : Some(ref_of(t, m)),
        None    : None,
    })
}

fn check_view_slice(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<SliceExpr, shared> s,
) : Result<Option<Type>, String>
{
    // D-0053: `&s[lo .. hi]` on a `String` or a `StringView` is a
    // `StringView`; shared only.
    bool on_string = match (view_base(b, it, &s.base))
    {
        Some(x) : x,
        None    : false,
    };
    // D-0135: as an argument, a temporary `String` may be viewed.
    bool temp_ok = replace(&mut b.cur_temp_ok, false);
    if (s.mode == Mode::Exclusive)
    {
        return Err(String::from_str("diag.type-mismatch"));
    }
    if (on_string)
    {
        bool through_ref = returns_ref(b, it, &s.base);
        OperandKind k = if (through_ref) { OperandKind::Place } else { borrow_operand_kind(b, it, &s.base) };
        if ((k == OperandKind::NonPlace || k == OperandKind::Temporary) && temp_ok)
        {
            HashSet::insert(&mut b.facts.temp_borrows, e.id);
            b.place_pos = k == OperandKind::Temporary;
            check_expr(b, it, &s.base, &None)?;
        }
        else if (k == OperandKind::NonPlace)
        {
            return Err(slice_of_value_msg());
        }
        else if (k == OperandKind::Temporary)
        {
            return Err(temp_msg());
        }
        else
        {
            b.place_pos = true;
            check_expr(b, it, &s.base, &None)?;
            flow_borrow(b, it, &s.base, s.mode)?;
        }
    }
    else
    {
        check_expr(b, it, &s.base, &None)?;
    }
    check_expect(b, it, &s.lo, &Type::TInt(IntTy::Usize))?;
    check_expect(b, it, &s.hi, &Type::TInt(IntTy::Usize))?;
    HashMap::insert(&mut b.facts.view_ops, e.id, if (on_string) { ViewOp::SliceString } else { ViewOp::SliceView });
    Ok(Some(named("std::StringView", Vec::new())))
}

fn check_slice(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<SliceExpr, shared> s,
) : Result<Option<Type>, String>
{
    // D-0254: a `simd` is a value, not a run of places.
    match (deref_to(static_place_type(b, it, &s.base)))
    {
        Some(st) :
        {
            if (is_simd(&st))
            {
                String msg = sprintf(
                    "a `%s` is not sliced: its lanes are not places of their own; read them with `v[i]`, or copy the vector into an array or a `Vec` with `simd_store`",
                    &type_display(&st),
                );
                return Err(named_diag("diag.borrow-of-non-place", &msg));
            }
        },
        None     : {},
    }
    // `[Slice-Form]` (D-0047); D-0103: as an argument, a temporary may be
    // sliced.
    bool temp_ok = replace(&mut b.cur_temp_ok, false);
    bool through_ref = returns_ref(b, it, &s.base);
    OperandKind k = if (through_ref) { OperandKind::Place } else { borrow_operand_kind(b, it, &s.base) };
    if ((k == OperandKind::NonPlace || k == OperandKind::Temporary) && temp_ok)
    {
        HashSet::insert(&mut b.facts.temp_borrows, e.id);
    }
    else if (k == OperandKind::NonPlace)
    {
        return Err(slice_of_value_msg());
    }
    else if (k == OperandKind::Temporary)
    {
        return Err(temp_msg());
    }
    b.place_pos = true;
    tier_slice_reborrow(b, it, &s.base, s.mode);
    Option<Type> bt = check_expr(b, it, &s.base, &None)?;
    bool shared_bt = match (&bt)
    {
        Some(Type::TRef(rb))   : Box::get(rb).mode == Mode::Shared,
        Some(Type::TSlice(sb)) : Box::get(sb).mode == Mode::Shared,
        _                      : false,
    };
    if (s.mode == Mode::Exclusive && (crosses_shared(b, it, &s.base) || shared_bt))
    {
        return Err(String::from_str("diag.borrow-exceeds-source"));
    }
    check_expect(b, it, &s.lo, &Type::TInt(IntTy::Usize))?;
    check_expect(b, it, &s.hi, &Type::TInt(IntTy::Usize))?;
    Type elem = match (&bt)
    {
        None    : return Ok(None),
        Some(t) :
        {
            if (has_unresolved_marker(t))
            {
                return Ok(None);
            }
            match (indexed_elem(t))
            {
                Some(el) : el,
                None     : return Err(String::from_str("diag.type-mismatch")),
            }
        },
    };
    // Literal bounds on an array are checked now.
    Option<u128> n = match (&bt)
    {
        Some(Type::TArray(ab)) : Some(Box::get(ab).n),
        Some(Type::TRef(rb)) : match (&Box::get(rb).inner)
        {
            Type::TArray(ab) : Some(Box::get(ab).n),
            _                : None,
        },
        _                      : None,
    };
    match (n)
    {
        Some(len) : match (literal_value(&s.lo))
        {
            Some(lo) : match (literal_value(&s.hi))
            {
                Some(hi) :
                {
                    if (lo < 0 || hi < lo || reinterpret<u128>(hi) > len)
                    {
                        return Err(String::from_str("diag.index-out-of-bounds"));
                    }
                },
                None     : {},
            },
            None : {},
        },
        None : {},
    }
    // D-0070: the slice borrows its range of `base`.
    Option<Place> src = match (slice_source(b, it, &s.base))
    {
        Some(p) :
        {
            if (String::starts_with(
                &p.root,
                "*",
            ) && Vec::len(&p.path) == 0) { Some(p) } else { place_of(b, it, &s.base) }
        },
        None    : place_of(b, it, &s.base),
    };
    match (src)
    {
        Some(p) :
        {
            Vec::push(&mut p.path, range_elem(&s.lo, &s.hi));
            flow_clash(b, it, &p.root, &p.path, s.mode, "diag.aliasing-conflict")?;
        },
        None    : {},
    }
    Ok(Some(slice_of(elem, s.mode)))
}

struct ArrLen
{
    Type elem;
    u128 n;
}

fn check_index(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Expr, shared> base,
    ref<Expr, shared> idx,
    bool in_place,
) : Result<Option<Type>, String>
{
    tier_elem_access(b, it, e, Mode::Shared)?;
    b.place_pos = true;
    Option<Type> bt0 = check_expr(b, it, base, &None)?;
    // D-0064: `g[i]` through a guard is `(*g)[i]`.
    Option<Type> bt = match (bt0)
    {
        Some(Type::TGuard(gb)) : Some(Box::into_inner(gb)),
        other                  : other,
    };
    match (&bt)
    {
        Some(t) :
        {
            if (is_marker(t))
            {
                return Err(unbounded_msg("indexing"));
            }
        },
        None    : {},
    }
    if (opt_is_ref(&bt))
    {
        // The reference itself is read.
        flow_read(b, it, base)?;
    }
    check_expect(b, it, idx, &Type::TInt(IntTy::Usize))?;
    Option<ArrLen> arr = match (&bt)
    {
        Some(Type::TArray(ab)) : Some(ArrLen { .elem = clone(&Box::get(ab).inner), .n = Box::get(ab).n }),
        Some(Type::TSimd(ab))  : Some(ArrLen { .elem = clone(&Box::get(ab).inner), .n = Box::get(ab).n }),
        Some(Type::TRef(rb)) : match (&Box::get(rb).inner)
        {
            Type::TArray(ab) : Some(ArrLen { .elem = clone(&Box::get(ab).inner), .n = Box::get(ab).n }),
            Type::TSimd(ab)  : Some(ArrLen { .elem = clone(&Box::get(ab).inner), .n = Box::get(ab).n }),
            _                : None,
        },
        _                      : None,
    };
    // D-0047: a `Vec` or a slice is indexed too.
    if (Option::is_none(&arr))
    {
        Option<Type> elem = match (&bt)
        {
            Some(t) : indexed_elem(t),
            None    : None,
        };
        match (elem)
        {
            Some(t) :
            {
                // A resource cannot be moved out of a `Vec` or a slice.
                if (!in_place && is_resource_ty(it, &t))
                {
                    String shown = match (&t)
                    {
                        Type::TNamed(nb) : String::from_view(Option::unwrap_or(
                            String::strip_prefix(&Box::get(nb).name, "std::"),
                            String::as_view(&Box::get(nb).name),
                        )),
                        _ : String::from_str("T"),
                    };
                    String msg = sprintf(
                        "this would move a `%s` out of an element, leaving a hole; take it out with `Vec::remove`/`Vec::pop`, exchange it with `replace(&mut v[i], x)`, copy it (`%s::clone(&v[i])`), or borrow it (`&v[i]`)",
                        &type_display(&t),
                        &shown,
                    );
                    return Err(named_diag("diag.move-out-of-field", &msg));
                }
                if (!in_place)
                {
                    flow_read(b, it, e)?;
                }
                return Ok(Some(t));
            },
            None    : {},
        }
    }
    // `[Index-Checked]`'s bound when the index is a literal.
    match (&arr)
    {
        Some(a) : match (known_value(b, idx))
        {
            Some(v) :
            {
                if (v < 0 || reinterpret<u128>(v) >= a.n)
                {
                    return Err(String::from_str("diag.index-out-of-bounds"));
                }
            },
            None    : {},
        },
        None : {},
    }
    // `[T-Index]`: anything else of a known type is not indexed.
    if (Option::is_none(&arr))
    {
        match (&bt)
        {
            Some(t) :
            {
                if (!has_unresolved_marker(t) && !is_never(t))
                {
                    if (named_is(t, "std::String"))
                    {
                        return Err(mismatch(String::from_str("a `String` is not indexed; its bytes are `String::as_bytes(&s)[i]`, and text is reached through `String::view`")));
                    }
                    bool ref_string = match (t)
                    {
                        Type::TRef(rb) : named_is(&Box::get(rb).inner, "std::String"),
                        _              : false,
                    };
                    if (ref_string)
                    {
                        return Err(mismatch(String::from_str("a `String` is not indexed; its bytes are `String::as_bytes(s)[i]`, and text is reached through `String::view`")));
                    }
                    return Err(mismatch(sprintf(
                        "a `%s` cannot be indexed; arrays, `Vec`s and slices can",
                        &type_display(t),
                    )));
                }
            },
            None    : {},
        }
    }
    if (!in_place)
    {
        flow_read(b, it, e)?;
    }
    Ok(match (arr)
    {
        Some(a) :
        {
            ArrLen { elem, .. } = a;
            Some(elem)
        },
        None    : None,
    })
}

fn check_array_lit(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Vec<Expr>, shared> es,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    Option<Type> ety = None;
    // D-0254: an array literal where a `simd` is expected is one.
    Option<ArrLen> lanes = match (expected)
    {
        Some(Type::TSimd(sb)) : Some(ArrLen { .elem = clone(&Box::get(sb).inner), .n = Box::get(sb).n }),
        _                     : None,
    };
    Option<Type> elem_expected = match (expected)
    {
        Some(Type::TArray(ab)) : Some(clone(&Box::get(ab).inner)),
        Some(Type::TSimd(ab))  : Some(clone(&Box::get(ab).inner)),
        _                      : None,
    };
    bool unknown = false;
    for (usize i = 0; i < Vec::len(es); i += 1)
    {
        Option<Type> want = match (&elem_expected)
        {
            Some(t) : Some(clone(t)),
            None    : clone(&ety),
        };
        Option<Type> t = check_store_operand(b, it, &es[i], &want)?;
        // `[T-Array]`: every element has one type.
        match (&t)
        {
            Some(tt) : match (&want)
            {
                Some(w) :
                {
                    if (!has_unresolved_marker(tt) && !has_unresolved_marker(w) && !is_never(tt) && !is_never(w) && !ty_compat(
                        tt,
                        w,
                    ))
                    {
                        return Err(mismatch(sprintf(
                            "an array's elements have one type: `%s`, and this one is `%s`",
                            &type_display(w),
                            &type_display(tt),
                        )));
                    }
                },
                None    : {},
            },
            None : {},
        }
        if (Option::is_none(&t))
        {
            unknown = true;
        }
        if (Option::is_none(&ety))
        {
            ety = t;
        }
    }
    u128 count = widen<u128>(Vec::len(es));
    match (lanes)
    {
        Some(sl) :
        {
            if (count != sl.n)
            {
                return Err(mismatch(sprintf(
                    "a `simd<%s, %v>` is written with %v lanes, and this literal has %v",
                    &type_display(&sl.elem),
                    sl.n,
                    sl.n,
                    Vec::len(es),
                )));
            }
            ArrLen { elem, n } = sl;
            return Ok(Some(simd_of(elem, n)));
        },
        None     : {},
    }
    // An element this pass cannot type takes the expected element type;
    // with none, the array's type is unknown too.
    match (ety)
    {
        Some(t) : Ok(Some(array_of(t, count))),
        None : match (elem_expected)
        {
            Some(t) : Ok(Some(array_of(t, count))),
            None    : if (unknown) { Ok(None) } else { Ok(Some(array_of(Type::TInt(IntTy::I32), count))) },
        },
    }
}

fn check_array_repeat(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> v,
    u128 n,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    Option<Type> elem_expected = match (expected)
    {
        Some(Type::TArray(ab)) : Some(clone(&Box::get(ab).inner)),
        Some(Type::TSimd(ab))  : Some(clone(&Box::get(ab).inner)),
        _                      : None,
    };
    // D-0254: `[x; N]` where a `simd<τ, N>` is expected: every lane `x`.
    match (expected)
    {
        Some(Type::TSimd(sb)) :
        {
            ref<SizedTy, shared> st = Box::get(sb);
            if (st.n != n)
            {
                return Err(mismatch(sprintf(
                    "a `simd<%s, %v>` has %v lanes, and this is `[v; %v]`",
                    &type_display(&st.inner),
                    st.n,
                    st.n,
                    n,
                )));
            }
            check_expect(b, it, v, &st.inner)?;
            return Ok(Some(simd_of(clone(&st.inner), st.n)));
        },
        _                     : {},
    }
    Option<Type> t = check_expr(b, it, v, &elem_expected)?;
    match (&t)
    {
        Some(tt) :
        {
            if (!has_unresolved_marker(tt))
            {
                Option<str> what = if (is_resource_ty(it, tt))
                {
                    Some("is a resource")
                }
                else if (holds_ref(it, tt))
                {
                    Some("is or holds a reference")
                }
                else if (contains_fn(it, tt))
                {
                    Some("is or holds a function value")
                }
                else
                {
                    None
                };
                match (what)
                {
                    Some(w) : return Err(mismatch(sprintf(
                        "`[v; %v]` copies `v` into every element, but `%s` %s",
                        n,
                        &type_display(tt),
                        w,
                    ))),
                    None : {},
                }
            }
        },
        None     : {},
    }
    match (or_type(t, elem_expected))
    {
        Some(x) : Ok(Some(array_of(x, n))),
        None    : Ok(None),
    }
}

// `spec/22`: the left side of `=` is a place.
fn is_place_expr(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EPath(_)  : true,
        ExprKind::EField(_) : true,
        ExprKind::EIndex(_) : true,
        ExprKind::EDeref(_) : true,
        ExprKind::EParen(x) : is_place_expr(Box::get(x)),
        _                   : false,
    }
}

fn check_assign(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> lhs,
    ref<Expr, shared> rhs,
) : Result<Option<Type>, String>
{
    match (one_seg(strip_parens_tc(lhs)))
    {
        Some(_) :
        {
            if (is_spawn_call(rhs))
            {
                match (&strip_parens_tc(rhs).kind)
                {
                    ExprKind::ECall(cb) :
                    {
                        HashSet::insert(
                            &mut b.bound_spawns,
                            site_key(Box::get(cb).callee.line, Box::get(cb).callee.col),
                        );
                    },
                    _                   : {},
                }
            }
        },
        None    : {},
    }
    tier_assign_rules(b, it, lhs, rhs)?;
    // `[Write-Not-Exclusive]` (spec/08).
    if (crosses_shared(b, it, lhs))
    {
        return Err(named_diag(
            "diag.write-through-shared",
            &String::from_str("this writes through a shared reference (`ref<T, shared>`, `&x`); writing needs an exclusive one (`ref<T, exclusive>`, `&mut x`)"),
        ));
    }
    if (!is_place_expr(lhs))
    {
        return Err(mismatch(String::from_str("the left side of `=` is a value -- a literal, a call's result, or a constant (which stands for its value) -- not a variable, a field, an element or `*r`, so it cannot be assigned")));
    }
    // A function (an item, not a binding) is a value too.
    match (path_segs(strip_parens_tc(lhs)))
    {
        Some(segs) :
        {
            String n = String::join(&segs[0..$], "::");
            if (!(Vec::len(segs) == 1 && is_local(
                b,
                &segs[0],
            )) && (HashMap::contains(&it.fns, &n) || HashMap::contains(&it.externs, &n)))
            {
                return Err(mismatch(sprintf(
                    "`%s` is a function, not a variable, so it cannot be assigned; a variable of type `fn(…)` can be",
                    &n,
                )));
            }
        },
        None       : {},
    }
    // D-0033 (1): `x = e` for a whole binding gives it a new value.
    Option<String> reinit = match (path_segs(lhs))
    {
        Some(segs) :
        {
            if (Vec::len(segs) == 1 && is_local(
                b,
                &segs[0],
            ) && (flow_is_tracked(&b.flow, &segs[0]) || !HashSet::contains(&b.capture_names, &segs[0])))
            {
                Some(String::clone(&segs[0]))
            }
            else
            {
                None
            }
        },
        None       : None,
    };
    b.place_pos = true;
    b.reinit_target = clone(&reinit);
    Result<Option<Type>, String> lt0 = check_expr(b, it, lhs, &None);
    // D-0118: a write into a bit field must fit its width.
    match (bitfield_of(b, it, lhs))
    {
        Some(bf) :
        {
            String fname = match (&strip_parens_tc(lhs).kind)
            {
                ExprKind::EField(fb) : String::clone(&Box::get(fb).name),
                _                    : String::new(),
            };
            StringView sn = Option::unwrap_or(String::strip_prefix(&bf.sname, "std::"), String::as_view(&bf.sname));
            check_bitfield_literal(b, rhs, bf.width, &sprintf("field `%s` of `%s`", &fname, sn))?;
        },
        None     : {},
    }
    b.reinit_target = None;
    Option<Type> lt = match (lt0)
    {
        Ok(t)  : t,
        Err(e) : return Err(e),
    };
    Option<String> held_c = match (&strip_parens_tc(lhs).kind)
    {
        ExprKind::EDeref(t) : match (one_seg(strip_parens_tc(Box::get(t))))
        {
            Some(n) : if (String::starts_with(n, "__compound")) { Some(String::clone(n)) } else { None },
            None    : None,
        },
        _ : None,
    };
    match (&held_c)
    {
        Some(t) : Vec::push(&mut b.compound_held, String::clone(t)),
        None    : {},
    }
    // D-0290: what a value holding references stored here holds, found
    // before it is moved; into a holder, its facts follow.
    Option<StoreTarget> into = store_target(b, lhs);
    bool lt_refish = match (&lt)
    {
        Some(t) : is_borrow_ty(t) || holds_ref(it, t),
        None    : false,
    };
    Option<Option<Vec<DerivFact>>> stored = if (lt_refish && Option::is_some(&into))
    {
        Some(inherited_facts(
            b,
            it,
            rhs,
            0,
        ))
    }
    else { None };
    bool follows = match (&into)
    {
        Some(st) : !st.through && is_holder(b, it, &st.name),
        None     : false,
    };
    bool saved_holding = replace(&mut b.holding, follows);
    Result<Option<Type>, String> rt0 = check_store_operand(b, it, rhs, &lt);
    b.holding = saved_holding;
    if (Option::is_some(&held_c))
    {
        Vec::pop(&mut b.compound_held);
    }
    Option<Type> rt = rt0?;
    // D-0281 step 4c: a write to an element of a `Vec` is an exclusive
    // access, against the live holders, as a borrow of it is (D-0282).
    tier_elem_access(b, it, lhs, Mode::Exclusive)?;
    match (&lt)
    {
        Some(l) : match (&rt)
        {
            Some(r) :
            {
                if (!has_unresolved_marker(l) && !has_unresolved_marker(r) && !ty_compat(l, r))
                {
                    // `a = b = 3`: C's chained assignment.
                    bool chained = match (&strip_parens_tc(rhs).kind)
                    {
                        ExprKind::EAssign(_) : true,
                        _                    : false,
                    };
                    if (chained)
                    {
                        return Err(mismatch(String::from_str("an assignment has no value, so `a = b = 3` does not assign `a`: write `b = 3; a = b;`")));
                    }
                    return Err(mismatch(sprintf(
                        "the place is `%s`, but the value assigned is `%s`",
                        &type_display(l),
                        &type_display(r),
                    )));
                }
            },
            None    : {},
        },
        None : {},
    }
    flow_write(b, it, lhs)?;
    match (&reinit)
    {
        Some(x) :
        {
            if (!b.flow.unreachable)
            {
                HashMap::insert(&mut b.flow.valid, String::clone(x), Tri::T);
            }
        },
        None    : {},
    }
    match (place_of(b, it, lhs))
    {
        Some(p) : match (HashMap::get(&b.decl_block, &p.root))
        {
            Some(dest) :
            {
                usize d = *dest;
                check_escape_into(b, it, d, rhs)?;
            },
            None       : {},
        },
        None : {},
    }
    bool lhs_path = match (&strip_parens_tc(lhs).kind)
    {
        ExprKind::EPath(_) : true,
        _                  : false,
    };
    match (into)
    {
        Some(st) : match (stored)
        {
            Some(facts) :
            {
                StoreTarget { name, through } = st;
                holder_store(b, it, &name, through, lhs_path, rhs, facts)?;
            },
            None        : {},
        },
        None : {},
    }
    match (root_local_name(lhs))
    {
        Some(name) :
        {
            if (is_holder(b, it, &name))
            {
                return Ok(Some(Type::TVoid));
            }
            bool tracked = flow_is_tracked(&b.flow, &name);
            bool borrow_lt = match (&lt)
            {
                Some(t) : is_borrow_ty(t),
                None    : false,
            };
            bool fn_lt = match (&lt)
            {
                Some(Type::TFn(_))      : true,
                Some(Type::TClosure(_)) : true,
                _                       : false,
            };
            if (tracked && borrow_lt)
            {
                Vec<DerivKey> facts = match (deriv_facts_of(b, it, rhs))
                {
                    Some(f) :
                    {
                        Vec<DerivKey> v = Vec::new();
                        Vec::push(&mut v, f);
                        v
                    },
                    None    : contained_ref_facts(b, it, rhs),
                };
                Option<HashMap<String, DerivFact>> prev = match (HashMap::get(&b.flow.deriv, &name))
                {
                    Some(m) : if (HashMap::len(m) > 0) { Some(HashMap::clone(m)) } else { None },
                    None    : None,
                };
                set_deriv(b, &name, facts);
                b.prev_facts = match (prev)
                {
                    Some(m) : Some(PrevFacts { .name = String::clone(&name), .facts = m }),
                    None    : None,
                };
                Result<void, String> r = tier_inherit(b, it, &name, Some(rhs));
                b.prev_facts = None;
                r?;
                Option<Referent> origin = referent_of(b, it, rhs);
                HashMap::insert(&mut b.ref_origin, name, origin);
            }
            else if (tracked && is_spawn_call(rhs) && lhs_path)
            {
                Vec<DerivFact> facts = spawn_facts_tri_of(b, it, rhs);
                set_deriv_tri(b, &name, facts);
            }
            else if (tracked && is_closure(rhs) && lhs_path)
            {
                Vec<DerivFact> facts = closure_facts_of(b, it, rhs);
                set_deriv_tri(b, &name, facts);
            }
            else if (tracked && fn_lt && lhs_path)
            {
                Vec<DerivFact> facts = fn_value_facts(b, it, rhs);
                set_deriv_tri(b, &name, facts);
            }
        },
        None       : {},
    }
    Ok(Some(Type::TVoid))
}

fn check_propagate(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> inner,
) : Result<Option<Type>, String>
{
    // D-0273: a whole binding that holds a resource is used by value, as an
    // argument is: `x?` moves it.
    bool whole_resource = match (place_of(b, it, inner))
    {
        Some(p) : Vec::len(&p.path) == 0 && place_is_resource(b, it, &p.root, &p.path),
        None    : false,
    };
    Option<Type> ti = if (whole_resource)
    {
        check_store_operand(
            b,
            it,
            inner,
            &None,
        )?
    }
    else { check_expr(b, it, inner, &None)? };
    match (&ti)
    {
        Some(t) :
        {
            Vec<Type> args = named_args(t);
            if (named_is(t, "std::Result"))
            {
                // [Propagate-Err-Mismatch] (spec/18): the function returns
                // Result<_, E'> with E' exactly this Result's E, once known.
                if (Vec::len(&args) > 1)
                {
                    Vec<Type> rargs = named_args(&b.ret);
                    bool matching = named_is(
                        &b.ret,
                        "std::Result",
                    ) && Vec::len(&rargs) > 1 && type_eq(&rargs[1], &args[1]);
                    if (!matching)
                    {
                        return Err(String::from_str("diag.propagate-outside-fallible-context"));
                    }
                }
                return Ok(if (Vec::len(&args) > 0) { Some(clone(&args[0])) } else { None });
            }
            // D-0130 `[Propagate-Option]` (spec/18).
            if (named_is(t, "std::Option"))
            {
                if (named_is(&b.ret, "std::Option"))
                {
                    return Ok(if (Vec::len(&args) > 0) { Some(clone(&args[0])) } else { None });
                }
                return Err(named_diag(
                    "diag.propagate-outside-fallible-context",
                    &String::from_str("`?` on an `Option` returns `None`, so the function must return an `Option`; to return an error instead, write `Option::ok_or(o, e)?`"),
                ));
            }
            match (t)
            {
                Type::TInt(_) : Err(String::from_str("diag.type-mismatch")),
                Type::TBool   : Err(String::from_str("diag.type-mismatch")),
                Type::TF32    : Err(String::from_str("diag.type-mismatch")),
                Type::TF64    : Err(String::from_str("diag.type-mismatch")),
                Type::TStr    : Err(String::from_str("diag.type-mismatch")),
                _             : Ok(None),
            }
        },
        None    : Ok(None),
    }
}

fn check_if(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<IfExpr, shared> x,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    check_expect(b, it, &x.cond, &Type::TBool)?;
    // Two successors; the branch states join afterwards. D-0049: with no
    // expected type, a branch that is only a literal takes the other
    // branch's type (checked first).
    Flow before = clone(&b.flow);
    bool else_first = Option::is_none(expected) && is_literal_block(&x.then_) && match (&x.else_)
    {
        Some(fe) : !is_literal_branch(fe),
        None     : false,
    };
    Option<Type> tt = None;
    Option<Type> ft = None;
    Flow after_t = new_flow();
    // A branch checked against the other's type (the hint) that comes out
    // untyped (a generic variant such as `None`) has that type.
    Option<Type> hinted = None;
    if (else_first)
    {
        ref<Expr, shared> fe = match (&x.else_)
        {
            Some(f) : f,
            None    : return Ok(None),
        };
        ft = check_expr(b, it, fe, &None)?;
        Flow after_f = replace(&mut b.flow, before);
        Option<Type> hint = match (&ft)
        {
            Some(h) : if (!is_never(h) && !has_unresolved_marker(h)) { Some(clone(h)) } else { None },
            None    : None,
        };
        match (&hint)
        {
            Some(h) :
            {
                HashMap::insert(&mut b.facts.if_hints, e.id, clone(h));
            },
            None    : {},
        }
        tt = check_nested_block(b, it, &x.then_, &hint)?;
        after_t = replace(&mut b.flow, after_f);
        if (Option::is_none(&tt))
        {
            hinted = hint;
        }
    }
    else
    {
        tt = check_nested_block(b, it, &x.then_, expected)?;
        after_t = replace(&mut b.flow, before);
        Option<Type> hint = if (Option::is_none(expected))
        {
            match (&tt)
            {
                Some(h) : if (!is_never(h) && !type_eq(
                    h,
                    &Type::TVoid,
                ) && !has_unresolved_marker(h)) { Some(clone(h)) } else { None },
                None : None,
            }
        }
        else
        {
            None
        };
        match (&hint)
        {
            Some(h) : match (&x.else_)
            {
                Some(fe) :
                {
                    if (is_literal_branch(fe))
                    {
                        HashMap::insert(&mut b.facts.if_hints, e.id, clone(h));
                    }
                },
                None     : {},
            },
            None : {},
        }
        ft = match (&x.else_)
        {
            Some(fe) :
            {
                Option<Type> want = match (expected)
                {
                    Some(t) : Some(clone(t)),
                    None    : clone(&hint),
                };
                check_expr(b, it, fe, &want)?
            },
            None     : Some(Type::TVoid),
        };
        if (Option::is_none(&ft) && Option::is_some(&x.else_))
        {
            hinted = hint;
        }
    }
    b.flow = flow_join(&after_t, &b.flow);
    match (hinted)
    {
        Some(h) :
        {
            if (else_first)
            {
                tt = Some(h);
            }
            else
            {
                ft = Some(h);
            }
        },
        None    : {},
    }
    match (tt)
    {
        Some(a) : match (ft)
        {
            Some(c) :
            {
                if (has_unresolved_marker(&a) || has_unresolved_marker(&c))
                {
                    return Ok(None);
                }
                if (Option::is_none(&x.else_))
                {
                    // `[T-If]`: no `else` makes the `if` `()`.
                    if (!type_eq(&a, &Type::TVoid) && !is_never(&a))
                    {
                        return Err(mismatch(sprintf(
                            "an `if` without `else` has no value, but this branch gives `%s`: add an `else`, or end the branch's last expression with `;`",
                            &type_display(&a),
                        )));
                    }
                    return Ok(Some(Type::TVoid));
                }
                if (ty_compat(&a, &c))
                {
                    return Ok(Some(a));
                }
                if (is_never(&a))
                {
                    return Ok(Some(c));
                }
                if (is_never(&c))
                {
                    return Ok(Some(a));
                }
                Err(String::from_str("diag.type-mismatch"))
            },
            None    : Ok(None),
        },
        None : Ok(None),
    }
}

fn check_return(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Option<Box<Expr>>, shared> v,
) : Result<Option<Type>, String>
{
    Option<Type> rt = match (&b.closure_ret)
    {
        Some(r) : clone(r),
        None    : Some(clone(&b.ret)),
    };
    // `[T-Return]`: the value's type is the enclosing function's (or
    // closure's) result type; a bare `return` gives `()`.
    str what = if (Option::is_some(&b.closure_ret)) { "closure" } else { "function" };
    match (v)
    {
        Some(eb) :
        {
            ref<Expr, shared> e = Box::get(eb);
            check_escape_to_caller(b, it, e)?;
            bool ok = result_reach_ok(b, it, e, &rt);
            bool saved_holding = replace(&mut b.holding, ok);
            Result<Option<Type>, String> t0 = check_store_operand(b, it, e, &rt);
            b.holding = saved_holding;
            Option<Type> t = t0?;
            match (&t)
            {
                Some(tt) : match (&rt)
                {
                    Some(want) :
                    {
                        if (!has_unresolved_marker(tt) && !has_unresolved_marker(want) && !is_never(tt) && !ty_compat(
                            tt,
                            want,
                        ))
                        {
                            if (type_eq(want, &Type::TVoid))
                            {
                                return Err(mismatch(sprintf(
                                    "this %s has no result, so `return` takes no value (this one gives `%s`)",
                                    what,
                                    &type_display(tt),
                                )));
                            }
                            return Err(mismatch(sprintf(
                                "this `return` gives `%s`, but the %s's result is `%s`",
                                &type_display(tt),
                                what,
                                &type_display(want),
                            )));
                        }
                    },
                    None       : {},
                },
                None : {},
            }
        },
        None     :
        {
            match (&rt)
            {
                Some(want) :
                {
                    if (!type_eq(want, &Type::TVoid) && !is_never(want) && !has_unresolved_marker(want))
                    {
                        return Err(mismatch(sprintf(
                            "a bare `return` gives no value, but the %s's result is `%s`: write `return value;`",
                            what,
                            &type_display(want),
                        )));
                    }
                },
                None       : {},
            }
        },
    }
    // An edge to the function exit: nothing follows here.
    b.flow.unreachable = true;
    Ok(Some(Type::TNever))
}

fn check_break(ref<Body, exclusive> b, bool is_break) : Result<Option<Type>, String>
{
    if (b.while_depth == 0)
    {
        return Err(String::from_str("diag.break-outside-loop"));
    }
    // An edge to the loop exit / the loop test.
    Flow st = clone(&b.flow);
    usize n = Vec::len(&b.loops);
    if (n > 0)
    {
        if (is_break)
        {
            Vec::push(&mut b.loops[n - 1].breaks, st);
        }
        else
        {
            Vec::push(&mut b.loops[n - 1].continues, st);
        }
    }
    b.flow.unreachable = true;
    Ok(Some(Type::TNever))
}

// ---- part 7: typecheck.rs lines 3970-4580 ----

fn step_stmt(ref<Expr, shared> s) : Stmt
{
    Stmt::SExpr(Box::new(clone(s)))
}

// `while (c) b`: a back edge from the end of the body (and every
// `continue`) to the test; the exit is the test's false edge joined with
// every `break`. The head state is iterated to its fixed point with
// refutations suppressed, then the body is walked once more. A `for`
// loop's `step` runs on the state after the body joined with every
// `continue`'s.
fn check_while(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> c,
    ref<Block, shared> body,
    Option<ref<Expr, shared>> step,
) : Result<Option<Type>, String>
{
    Flow entry = clone(&b.flow);
    Flow head = clone(&entry);
    // D-0175: `while (true)` leaves only by `break`.
    bool forever = match (&c.kind)
    {
        ExprKind::EBool(v) : *v,
        _                  : false,
    };
    bool outer_report = b.report;
    Flow exit = new_flow();
    usize iterations = 0;
    while (true)
    {
        b.report = false;
        b.flow = clone(&head);
        _ = check_expr(b, it, c, &Some(Type::TBool));
        Flow after_cond = clone(&b.flow);
        Vec::push(&mut b.loops, LoopCtx { .breaks = Vec::new(), .continues = Vec::new() });
        b.while_depth += 1;
        Result<Option<Type>, String> r = check_nested_block(b, it, body, &None);
        b.while_depth -= 1;
        LoopCtx ctx = Option::unwrap_or(
            Vec::pop(&mut b.loops),
            LoopCtx { .breaks = Vec::new(), .continues = Vec::new() },
        );
        r?;
        Flow end = clone(&b.flow);
        for (usize i = 0; i < Vec::len(&ctx.continues); i += 1)
        {
            end = flow_join(&end, &ctx.continues[i]);
        }
        match (step)
        {
            Some(s) :
            {
                b.flow = end;
                check_stmt(b, it, &step_stmt(s))?;
                end = clone(&b.flow);
            },
            None    : {},
        }
        b.report = outer_report;
        Flow new_head = flow_join(&entry, &end);
        exit = after_cond;
        if (forever)
        {
            exit.unreachable = true;
        }
        for (usize i = 0; i < Vec::len(&ctx.breaks); i += 1)
        {
            exit = flow_join(&exit, &ctx.breaks[i]);
        }
        iterations += 1;
        if (flow_eq(&new_head, &head) || iterations > 16)
        {
            break;
        }
        head = new_head;
    }
    if (outer_report)
    {
        b.flow = head;
        check_expect(b, it, c, &Type::TBool)?;
        Flow after_cond = clone(&b.flow);
        Vec::push(&mut b.loops, LoopCtx { .breaks = Vec::new(), .continues = Vec::new() });
        b.while_depth += 1;
        Result<Option<Type>, String> r = check_nested_block(b, it, body, &None);
        b.while_depth -= 1;
        LoopCtx ctx = Option::unwrap_or(
            Vec::pop(&mut b.loops),
            LoopCtx { .breaks = Vec::new(), .continues = Vec::new() },
        );
        r?;
        match (step)
        {
            Some(s) :
            {
                Flow end = clone(&b.flow);
                for (usize i = 0; i < Vec::len(&ctx.continues); i += 1)
                {
                    end = flow_join(&end, &ctx.continues[i]);
                }
                b.flow = end;
                check_stmt(b, it, &step_stmt(s))?;
            },
            None    : {},
        }
        exit = after_cond;
        if (forever)
        {
            exit.unreachable = true;
        }
        for (usize i = 0; i < Vec::len(&ctx.breaks); i += 1)
        {
            exit = flow_join(&exit, &ctx.breaks[i]);
        }
    }
    bool nev = forever && exit.unreachable;
    b.flow = exit;
    Ok(Some(if (nev) { Type::TNever } else { Type::TVoid }))
}

struct LitTy
{
    IntTy t;
    bool defaulted;
}

// `IntTy::of_literal`: a literal's integer type from its suffix and the
// type its context expects, and whether it was defaulted.
fn int_of_literal(ref<Option<String>, shared> suffix, ref<Option<Type>, shared> expected) : LitTy
{
    match (suffix)
    {
        Some(s) :
        {
            if (String::eq_str(s, "byte"))
            {
                return match (expected)
                {
                    Some(Type::TInt(t)) : if (!int_ty_signed(*t)) { LitTy { .t = *t, .defaulted = false } } else { LitTy { .t = IntTy::U8, .defaulted = false } },
                    _                   : LitTy { .t = IntTy::U8, .defaulted = false },
                };
            }
            match (int_ty_from(String::as_view(s)))
            {
                Some(t) : LitTy { .t = t, .defaulted = false },
                None    : LitTy { .t = IntTy::I32, .defaulted = true },
            }
        },
        None : match (expected)
        {
            Some(Type::TInt(t)) : LitTy { .t = *t, .defaulted = false },
            _                   : LitTy { .t = IntTy::I32, .defaulted = true },
        },
    }
}

fn int_lit_fits(IntTy t, u128 v) : bool
{
    if (t == IntTy::U128)
    {
        return true;
    }
    IntRange r = int_range(t);
    if (int_ty_signed(t))
    {
        return reinterpret<i128>(v) <= r.max && r.min < 0;
    }
    v <= reinterpret<u128>(r.max)
}

fn int_lit_range_msg(StringView text, IntTy t, bool defaulted) : String
{
    IntRange r = int_range(t);
    String why = if (defaulted)
    {
        sprintf(
            "; nothing here fixes its type, so it is `%s` -- write `%s: T` for the type you mean",
            int_ty_name(t),
            text,
        )
    }
    else
    {
        String::new()
    };
    String msg = sprintf("`%s` does not fit `%s` (%v to %v)%s", text, int_ty_name(t), r.min, r.max, &why);
    named_diag("diag.literal-out-of-range", &msg)
}

fn unbounded_msg(str what) : String
{
    String msg = sprintf(
        "%s on a value of a type parameter: a generic `T` has no operations of its own; give it a bound (`T: eq`, `ordered`, `number` or `integer`, D-0090), or pass the operation in as a `fn` parameter, as `Vec::sort_by` takes `less`",
        what,
    );
    named_diag("diag.unbounded-type-parameter", &msg)
}

// `ast::is_literal_branch` and `is_literal_block`.
fn is_literal_branch(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EBlock(blk) : is_literal_block(blk),
        ExprKind::EParen(x)   : is_literal_branch(Box::get(x)),
        _                     : is_literal_expr(e),
    }
}

fn is_literal_block(ref<Block, shared> blk) : bool
{
    Vec::len(&blk.stmts) == 0 && match (&blk.tail)
    {
        Some(t) : is_literal_branch(Box::get(t)),
        None    : false,
    }
}

// A marker type the expected type is, when its bound is `number` (D-0090).
fn number_marker(ref<Body, shared> b, ref<Option<Type>, shared> expected) : Option<Type>
{
    match (expected)
    {
        Some(m) :
        {
            if (!is_marker(m))
            {
                return None;
            }
            String mn = Option::expect(marker_of(m), "a marker");
            match (HashMap::get(&b.marker_bounds, &mn))
            {
                Some(have) : if (bound_implies(*have, Bound::BNumber)) { Some(clone(m)) } else { None },
                None       : None,
            }
        },
        None    : None,
    }
}

fn check_int_lit(
    ref<Body, shared> b,
    u128 v,
    ref<Option<String>, shared> suffix,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // D-0090: an unsuffixed literal where a `number` type parameter is
    // expected is of that type.
    if (Option::is_none(suffix))
    {
        match (number_marker(b, expected))
        {
            Some(m) : return Ok(Some(m)),
            None    : {},
        }
    }
    LitTy lt = int_of_literal(suffix, expected);
    if (!int_lit_fits(lt.t, v))
    {
        return Err(int_lit_range_msg(String::as_view(&sprintf("%v", v)), lt.t, lt.defaulted));
    }
    Ok(Some(Type::TInt(lt.t)))
}

fn check_unary(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    UnOp op,
    ref<Expr, shared> inner,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // The most negative literal (`-2147483648`): its negated value is
    // checked here, before the bare positive literal would be.
    if (op == UnOp::Neg)
    {
        match (&inner.kind)
        {
            ExprKind::EInt(lb) :
            {
                ref<IntLit, shared> lit = Box::get(lb);
                if (Option::is_none(&lit.sfx))
                {
                    // D-0090: `-1` where a `number` type parameter is expected.
                    match (number_marker(b, expected))
                    {
                        Some(m) :
                        {
                            HashSet::insert(&mut b.facts.number_literals, inner.id);
                            return Ok(Some(m));
                        },
                        None    : {},
                    }
                    if (is_float_opt(expected) && HashSet::contains(&b.facts.number_literals, &inner.id))
                    {
                        return Ok(clone(expected));
                    }
                }
                LitTy lt = int_of_literal(&lit.sfx, expected);
                // `[T-Neg]`: unary minus needs a signed or float operand.
                if (!int_ty_signed(lt.t))
                {
                    return Err(mismatch(sprintf(
                        "`-` needs a signed or floating-point operand, but this is `%s`",
                        int_ty_name(lt.t),
                    )));
                }
                u32 bw = int_ty_bits(lt.t, 64);
                u128 top = 1;
                top = top << 127;
                String text = sprintf("-%v", lit.v);
                i128 neg = 0;
                if (bw >= 128)
                {
                    if (lit.v == top)
                    {
                        neg = min_value<i128>();
                    }
                    else if (lit.v < top)
                    {
                        neg = 0 - reinterpret<i128>(lit.v);
                    }
                    else
                    {
                        return Err(int_lit_range_msg(String::as_view(&text), lt.t, lt.defaulted));
                    }
                }
                else
                {
                    neg = wrapping_sub(0, reinterpret<i128>(lit.v));
                }
                IntRange r = int_range(lt.t);
                if (neg < r.min || neg > r.max)
                {
                    return Err(int_lit_range_msg(String::as_view(&text), lt.t, lt.defaulted));
                }
                return Ok(Some(Type::TInt(lt.t)));
            },
            _                  : {},
        }
    }
    Option<Type> ti = check_expr(b, it, inner, expected)?;
    match (&ti)
    {
        Some(m) :
        {
            if (is_marker(m))
            {
                // D-0090: `-x` needs `number`, `~x` `integer`.
                String mn = Option::expect(marker_of(m), "a marker");
                if (op == UnOp::Not)
                {
                    return Err(unbounded_msg("a unary operator"));
                }
                Bound need = if (op == UnOp::Neg) { Bound::BNumber } else { Bound::BInteger };
                str sym = if (op == UnOp::Neg) { "-" } else { "~" };
                bool has = match (HashMap::get(&b.marker_bounds, &mn))
                {
                    Some(have) : bound_implies(*have, need),
                    None       : false,
                };
                if (has)
                {
                    return Ok(Some(clone(m)));
                }
                return Err(bound_msg(b, &mn, sym, need));
            }
        },
        None    : {},
    }
    // D-0254: `-` on a `simd` of a signed integer or a float, `~` on one of
    // an integer, lane by lane.
    match (&ti)
    {
        Some(Type::TSimd(sb)) :
        {
            ref<Type, shared> lt = &Box::get(sb).inner;
            bool ok = if (op == UnOp::Neg)
            {
                match (lt)
                {
                    Type::TF32    : true,
                    Type::TF64    : true,
                    Type::TInt(t) : int_ty_signed(*t),
                    _             : false,
                }
            }
            else if (op == UnOp::BitNot)
            {
                match (lt)
                {
                    Type::TInt(_) : true,
                    _             : false,
                }
            }
            else
            {
                false
            };
            if (!ok)
            {
                str sym = if (op == UnOp::Neg) { "-" } else if (op == UnOp::BitNot) { "~" } else { "!" };
                return Err(mismatch(sprintf(
                    "`%s` does not apply to a `%s`: `-` takes a simd of a signed integer or a float, `~` one of an integer; a mask is inverted with `~`",
                    sym,
                    &type_display(&Option::expect(clone(&ti), "a simd")),
                )));
            }
            return Ok(clone(&ti));
        },
        _                     : {},
    }
    match (&ti)
    {
        Some(t) :
        {
            if (op == UnOp::Neg)
            {
                match (t)
                {
                    Type::TInt(i) :
                    {
                        if (!int_ty_signed(*i))
                        {
                            return Err(mismatch(sprintf(
                                "`-` needs a signed or floating-point operand, but this is `%s`",
                                int_ty_name(*i),
                            )));
                        }
                    },
                    Type::TF32    : {},
                    Type::TF64    : {},
                    Type::TNever  : {},
                    _             :
                    {
                        if (!has_unresolved_marker(t))
                        {
                            return Err(mismatch(sprintf(
                                "`-` needs a signed or floating-point operand, but this is `%s`",
                                &type_display(t),
                            )));
                        }
                    },
                }
            }
            else if (op == UnOp::BitNot)
            {
                match (t)
                {
                    Type::TBool   : return Err(mismatch(String::from_str("`~` inverts an integer's bits; for a `bool` write `!`"))),
                    Type::TInt(_) : {},
                    Type::TNever  : {},
                    _             :
                    {
                        if (!has_unresolved_marker(t))
                        {
                            return Err(mismatch(sprintf("`~` needs an integer, but this is `%s`", &type_display(t))));
                        }
                    },
                }
            }
            else
            {
                match (t)
                {
                    Type::TBool : return Ok(Some(Type::TBool)),
                    _           :
                    {
                        if (!has_unresolved_marker(t))
                        {
                            return Err(mismatch(sprintf("`!` needs a `bool`, but this is `%s`", &type_display(t))));
                        }
                    },
                }
            }
        },
        None    : {},
    }
    Ok(ti)
}

// An operand whose type comes from the other operand: an unsuffixed
// literal, or an enum literal whose type arguments are left to context.
fn takes_expected(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::ECall(cb) :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            if (Vec::len(&c.args) == 1)
            {
                return match (&c.callee.kind)
                {
                    ExprKind::EPath(pb) : Vec::len(&Box::get(pb).targs) == 0 && Option::is_some(&variant_enum(
                        it,
                        &Box::get(pb).segs,
                    )),
                    _ : false,
                };
            }
            is_bare_num_literal(e)
        },
        ExprKind::EParen(x) : takes_expected(b, it, Box::get(x)),
        _                   : is_bare_num_literal(e),
    }
}

fn place_is_string(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    match (static_place_type(b, it, e))
    {
        Some(t) : named_is(&t, "std::String"),
        None    : false,
    }
}

// D-0108: a comparison's operand, a `String` place borrowed shared.
fn check_text_operand(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e) : Result<Option<Type>, String>
{
    bool place = (place_is_string(
        b,
        it,
        e,
    ) || is_resource_key_place(b, it, e)) && borrow_operand_kind(b, it, e) == OperandKind::Place;
    if (!place)
    {
        return check_expr(b, it, e, &None);
    }
    b.place_pos = true;
    Option<Type> t = check_expr(b, it, e, &None)?;
    flow_borrow(b, it, e, Mode::Shared)?;
    Ok(t)
}

fn is_text_operand(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    if (place_is_string(b, it, e))
    {
        return true;
    }
    match (value_shape(b, it, e))
    {
        Some(t) :
        {
            if (named_is(&t, "std::String"))
            {
                return true;
            }
        },
        None    : {},
    }
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EStr(_) : true,
        _                 : false,
    }
}

fn is_cmp_op(BinOp op) : bool
{
    op == BinOp::Eq || op == BinOp::Ne || op == BinOp::Lt || op == BinOp::Le || op == BinOp::Gt || op == BinOp::Ge
}

fn is_order_op(BinOp op) : bool
{
    op == BinOp::Lt || op == BinOp::Le || op == BinOp::Gt || op == BinOp::Ge
}

fn is_view_opt(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(x) : named_is(x, "std::StringView"),
        None    : false,
    }
}

fn is_string_opt(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(x) : is_std_string(x),
        None    : false,
    }
}

fn is_str_opt(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(Type::TStr) : true,
        _                : false,
    }
}

fn is_marker_opt(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(x) : is_marker(x),
        None    : false,
    }
}

fn is_simd_opt(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(x) : is_simd(x),
        None    : false,
    }
}

fn check_binary(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    BinOp op,
    ref<Expr, shared> a,
    ref<Expr, shared> c,
    ref<Expr, shared> whole,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // D-0037: an operator on literal expressions only takes the type its
    // context expects, when that is a number.
    Option<Type> numeric = match (expected)
    {
        Some(t) : if (is_numeric_ty(t)) { Some(clone(t)) } else { None },
        None    : None,
    };
    // D-0073: `+` does not join text.
    if (op == BinOp::Add && (is_text_operand(b, it, a) || is_text_operand(b, it, c)))
    {
        return Err(named_diag(
            "diag.read-of-resource",
            &String::from_str("`+` does not join text; append to a `String` with `String::append(&mut s, &t)` (or a `str`, a number), or build one with `sprintf(\"%s%s\", &s, &t)`"),
        ));
    }
    // `==` on a resource other than text: say what to compare.
    if (op == BinOp::Eq || op == BinOp::Ne)
    {
        for (usize side = 0; side < 2; side += 1)
        {
            ref<Expr, shared> x = if (side == 0) { a } else { c };
            match (static_place_type(b, it, x))
            {
                Some(t) :
                {
                    if (!named_is(&t, "std::String") && !named_key_type(it, &t) && is_resource_ty(it, &t))
                    {
                        String msg = sprintf(
                            "`%s` compares plain values, and a `%s` is a resource: compare what it holds -- its length and its elements, in a loop -- or a summary of it",
                            if (op == BinOp::Eq) { "==" } else { "!=" },
                            &type_display(&t),
                        );
                        return Err(named_diag("diag.read-of-resource", &msg));
                    }
                },
                None    : {},
            }
        }
    }
    bool arith_op = op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul || op == BinOp::Div || op == BinOp::Rem || op == BinOp::BitAnd || op == BinOp::BitOr || op == BinOp::BitXor || op == BinOp::Shl || op == BinOp::Shr;
    bool literal_op = arith_op && is_literal_expr(whole);
    // D-0254: where a `simd` is expected, an arithmetic operator's operands
    // are of that type.
    bool simd_op = op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul || op == BinOp::Div || op == BinOp::BitAnd || op == BinOp::BitOr || op == BinOp::BitXor || op == BinOp::Shl || op == BinOp::Shr;
    Option<Type> simd_expected = if (simd_op && is_simd_opt(expected)) { clone(expected) } else { None };
    bool shift = op == BinOp::Shl || op == BinOp::Shr;
    Option<Type> at = None;
    Option<Type> bt = None;
    if (Option::is_some(&simd_expected))
    {
        at = check_expr(b, it, a, &simd_expected)?;
        bt = check_expr(b, it, c, &simd_expected)?;
    }
    else if (Option::is_some(&numeric) && literal_op)
    {
        at = check_expr(b, it, a, &numeric)?;
        bt = if (shift) { check_expr(b, it, c, &clone(&at))? } else { check_expr(b, it, c, &numeric)? };
    }
    else if ((takes_expected(
        b,
        it,
        a,
    ) || (is_literal_expr(a) && !shift)) && !takes_expected(b, it, c) && !is_literal_expr(c))
    {
        // (D-0037: a literal expression on the left takes the right
        // operand's type as a bare literal does.)
        bt = check_expr(b, it, c, &None)?;
        at = check_expr(b, it, a, &clone(&bt))?;
    }
    else if (is_cmp_op(op) && (place_is_string(
        b,
        it,
        a,
    ) || place_is_string(b, it, c) || is_resource_key_place(b, it, a) || is_resource_key_place(b, it, c)))
    {
        // D-0108 `[Cmp-Text]`, D-0271 `[Cmp-Key]`: borrowed shared for the
        // comparison, not read whole.
        at = check_text_operand(b, it, a)?;
        bt = check_text_operand(b, it, c)?;
    }
    else
    {
        at = check_expr(b, it, a, &None)?;
        bt = check_expr(b, it, c, &clone(&at))?;
    }
    if (Option::is_none(&at))
    {
        at = reguess(b, it, a, &clone(&bt));
    }
    if (is_marker_opt(&at) || is_marker_opt(&bt))
    {
        // `rule.type.kind`: an operator on a type parameter's value is the
        // bound's (D-0090).
        return check_bounded_binary(b, op, &at, &bt);
    }
    // `[T-Rawptr-Offset]` (spec/12 §5): `rawptr<τ> + isize : rawptr<τ>`.
    if (op == BinOp::Add)
    {
        match (&at)
        {
            Some(Type::TRawptr(_)) :
            {
                if (b.unsafe_depth == 0)
                {
                    return Err(String::from_str("diag.trusted-outside-unsafe"));
                }
                return Ok(at);
            },
            _                      : {},
        }
    }
    // D-0254: an operator on a `simd` works lane by lane.
    if (is_simd_opt(&at) || is_simd_opt(&bt))
    {
        return simd_binary_type(op, &at, &bt);
    }
    // D-0164: `==`/`!=` between a `String` and a `str` or a `StringView`
    // compares their text, rewritten to `String::eq_str`/`eq_view`.
    if ((is_string_opt(&at) && (is_str_opt(&bt) || is_view_opt(&bt))) || (is_string_opt(&bt) && (is_str_opt(&at) || is_view_opt(&at))))
    {
        bool string_left = is_string_opt(&at);
        bool other_is_str = if (string_left) { is_str_opt(&bt) } else { is_str_opt(&at) };
        if (op == BinOp::Eq || op == BinOp::Ne)
        {
            note_rewrite(
                b,
                whole,
                Rewrite::TextEq(TextEqRewrite { .string_left = string_left, .other_is_str = other_is_str, .negate = op == BinOp::Ne }),
            );
            return Ok(Some(Type::TBool));
        }
        if (is_order_op(op))
        {
            return Err(mismatch(String::from_str("`<`, `<=`, `>`, `>=` order two texts of one type; a `String` and a `str` or a `StringView` compare with `==` and `!=` only (D-0164): order two `String`s, or `String::as_view(&s)` and a view")));
        }
        return Err(mismatch(sprintf(
            "the operands are `%s` and `%s`, which cannot be combined",
            &type_display(&Option::expect(clone(&at), "a type")),
            &type_display(&Option::expect(clone(&bt), "a type")),
        )));
    }
    // D-0053: `==`/`!=` with a `StringView` compares text; D-0108: two
    // views are ordered by their bytes.
    if (is_view_opt(&at) || is_view_opt(&bt))
    {
        bool view_left = is_view_opt(&at);
        bool other_is_str = if (view_left) { is_str_opt(&bt) } else { is_str_opt(&at) };
        bool other_view = if (view_left) { is_view_opt(&bt) } else { is_view_opt(&at) };
        if (!(other_is_str || other_view))
        {
            return Err(String::from_str("diag.type-mismatch"));
        }
        ViewOp vo = ViewOp::KeyCmp;
        if (op == BinOp::Eq || op == BinOp::Ne)
        {
            vo = ViewOp::VEq(ViewEq { .view_left = view_left, .other_is_str = other_is_str, .negate = op == BinOp::Ne });
        }
        else if (is_order_op(op) && !other_is_str)
        {
            vo = ViewOp::VLess(ViewLess { .swap = op == BinOp::Gt || op == BinOp::Le, .negate = op == BinOp::Le || op == BinOp::Ge });
        }
        else if (is_order_op(op))
        {
            return Err(mismatch(String::from_str(TEXT_ORDER_HELP)));
        }
        else
        {
            return Err(mismatch(String::from_str("a `StringView` has `==`, `!=`, `<`, `<=`, `>`, `>=` only")));
        }
        HashMap::insert(&mut b.facts.view_ops, whole.id, vo);
        return Ok(Some(Type::TBool));
    }
    // `[Eq-Str]` and `[Cmp-Text]` are the only operators on `str`.
    if ((is_str_opt(&at) || is_str_opt(&bt)) && !is_cmp_op(op))
    {
        return Err(mismatch(String::from_str("`str` has only the comparisons `==`, `!=`, `<`, `<=`, `>`, `>=`")));
    }
    if (op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul || op == BinOp::Div || op == BinOp::Rem || op == BinOp::BitAnd || op == BinOp::BitOr || op == BinOp::BitXor)
    {
        match (&at)
        {
            Some(ta) : match (&bt)
            {
                Some(tb) :
                {
                    if (!has_unresolved_marker(ta) && !has_unresolved_marker(tb))
                    {
                        if (!ty_compat(ta, tb))
                        {
                            return Err(mismatch(sprintf(
                                "the operands are `%s` and `%s`; convert one (`widen`, `narrow`, `to_float`)",
                                &type_display(ta),
                                &type_display(tb),
                            )));
                        }
                        // `[T-Arith]`: an integer type, or a float for
                        // `+ - * /` only.
                        str sym = op_symbol(op);
                        match (ta)
                        {
                            Type::TInt(i) : check_literal_fold_overflow(b, op, *i, a, c)?,
                            Type::TNever  : {},
                            Type::TF32    : check_float_arith(op, ta, sym)?,
                            Type::TF64    : check_float_arith(op, ta, sym)?,
                            Type::TBool   :
                            {
                                if (op == BinOp::BitAnd || op == BinOp::BitOr || op == BinOp::BitXor)
                                {
                                    return Err(mismatch(sprintf(
                                        "`%s` is defined for integers only; for `bool` write `&&`, `||` or `!=`",
                                        sym,
                                    )));
                                }
                                return Err(mismatch(sprintf(
                                    "`%s` is arithmetic, defined for numbers, not `%s`",
                                    sym,
                                    &type_display(ta),
                                )));
                            },
                            _ : return Err(mismatch(sprintf(
                                "`%s` is arithmetic, defined for numbers, not `%s`",
                                sym,
                                &type_display(ta),
                            ))),
                        }
                    }
                },
                None     : {},
            },
            None : {},
        }
        return Ok(or_type(at, bt));
    }
    if (shift)
    {
        // `[T-Shift]`: the shifted operand is an integer.
        match (&at)
        {
            Some(t) :
            {
                bool int_or_never = match (t)
                {
                    Type::TInt(_) : true,
                    Type::TNever  : true,
                    _             : false,
                };
                if (!int_or_never && !has_unresolved_marker(t))
                {
                    str tail = if (is_float_type(t)) { "; a float's bits are `reinterpret<u64>(x)` (or `u32` for `f32`)" } else { "" };
                    return Err(mismatch(sprintf(
                        "`%s` shifts an integer's bits, and this is `%s`%s",
                        if (op == BinOp::Shl) { "<<" } else { ">>" },
                        &type_display(t),
                        tail,
                    )));
                }
            },
            None    : {},
        }
        // `[T-Shift]`: the amount is a `u32` (a literal takes it).
        match (&bt)
        {
            Some(Type::TInt(k)) :
            {
                if (*k != IntTy::U32 && !is_literal_expr(c))
                {
                    return Err(mismatch(sprintf(
                        "a shift amount is a `u32`, and this is `%s`: convert it with `%s<u32>(n)`",
                        int_ty_name(*k),
                        if (int_ty_bits(*k, 64) < 32) { "widen" } else { "narrow" },
                    )));
                }
            },
            _                   : {},
        }
        // `[Shift-Amount-Invalid]`: a literal amount at or beyond the bit
        // width is rejected here.
        match (&at)
        {
            Some(Type::TInt(i)) : match (known_value(b, c))
            {
                Some(n) :
                {
                    if (n < 0 || n >= widen<i128>(int_ty_bits(*i, 64)))
                    {
                        return Err(String::from_str("diag.shift-amount-out-of-range"));
                    }
                },
                None    : {},
            },
            _ : {},
        }
        return Ok(at);
    }
    if (is_cmp_op(op))
    {
        return check_comparison(b, it, op, a, c, whole, &at, &bt);
    }
    // `[T-Logic]`: both operands `bool`.
    str sym = if (op == BinOp::And) { "&&" } else { "||" };
    for (usize side = 0; side < 2; side += 1)
    {
        ref<Option<Type>, shared> ot = if (side == 0) { &at } else { &bt };
        match (ot)
        {
            Some(t) :
            {
                bool ok = match (t)
                {
                    Type::TBool  : true,
                    Type::TNever : true,
                    _            : false,
                };
                if (!ok && !has_unresolved_marker(t))
                {
                    return Err(mismatch(match (t)
                    {
                        Type::TInt(_) : sprintf(
                            "`%s` joins `bool`s, and this is `%s`; for a number write `n != 0`",
                            sym,
                            &type_display(t),
                        ),
                        _ : sprintf("`%s` joins `bool`s, and this is `%s`", sym, &type_display(t)),
                    }));
                }
            },
            None    : {},
        }
    }
    Ok(Some(Type::TBool))
}

fn check_float_arith(BinOp op, ref<Type, shared> ta, str sym) : Result<void, String>
{
    if (op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul || op == BinOp::Div)
    {
        return Ok(());
    }
    if (op == BinOp::Rem)
    {
        return Err(mismatch(sprintf(
            "`%%` is defined for integers only; a `%s` has `+ - * /` (a float remainder is `a - b * trunc(a / b)`)",
            &type_display(ta),
        )));
    }
    Err(mismatch(sprintf(
        "`%s` is defined for integers only; a float's bits are `reinterpret<u64>(x)` (or `u32` for `f32`)",
        sym,
    )))
}

fn callable_operand(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e, ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(x) :
        {
            if (contains_fn(it, x))
            {
                return true;
            }
        },
        None    : {},
    }
    match (&e.kind)
    {
        ExprKind::EClosure(_) : true,
        ExprKind::EPath(pb) : Vec::len(&Box::get(pb).segs) == 1 && HashMap::contains(
            &b.closure_moves,
            &Box::get(pb).segs[0],
        ),
        _                     : false,
    }
}

fn is_slice_opt(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(Type::TSlice(_)) : true,
        _                     : false,
    }
}

fn check_comparison(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    BinOp op,
    ref<Expr, shared> a,
    ref<Expr, shared> c,
    ref<Expr, shared> whole,
    ref<Option<Type>, shared> at,
    ref<Option<Type>, shared> bt,
) : Result<Option<Type>, String>
{
    // `[Eq-Fn]` (spec/12 §4): no equality on function values.
    if (callable_operand(b, it, a, at) || callable_operand(b, it, c, bt))
    {
        return Err(String::from_str("diag.type-mismatch"));
    }
    // No comparison of slices (D-0047).
    if (is_slice_opt(at) || is_slice_opt(bt))
    {
        return Err(String::from_str("diag.type-mismatch"));
    }
    // Nor of an aggregate holding one, a `StringView` included.
    for (usize side = 0; side < 2; side += 1)
    {
        ref<Option<Type>, shared> ot = if (side == 0) { at } else { bt };
        match (ot)
        {
            Some(t) :
            {
                if (!has_unresolved_marker(t) && contains_slice(it, t))
                {
                    return Err(mismatch(sprintf(
                        "`==` and `!=` compare a `%s` field by field, and it holds a `StringView` or a slice, which compares only on its own: compare the parts (`Option::unwrap(a) == b`, or a `match`)",
                        &type_display(t),
                    )));
                }
            },
            None    : {},
        }
    }
    match (at)
    {
        Some(ta) : match (bt)
        {
            Some(tb) :
            {
                if (!has_unresolved_marker(ta) && !has_unresolved_marker(tb) && !ty_compat(ta, tb))
                {
                    return Err(mismatch(sprintf(
                        "the operands are `%s` and `%s`, which cannot be compared%s",
                        &type_display(ta),
                        &type_display(tb),
                        &compare_hint(ta, tb),
                    )));
                }
                // `[T-Cmp]`: `< <= > >=` need an ordered τ.
                if (is_order_op(op) && !has_unresolved_marker(ta) && !is_never(ta) && !bound_holds(
                    b,
                    it,
                    Bound::BOrdered,
                    ta,
                ))
                {
                    return Err(mismatch(sprintf(
                        "`<`, `<=`, `>`, `>=` order numbers, `bool`, `str`, `String`, and a struct or enum of those; a `%s` is compared with `==` and `!=` only%s",
                        &type_display(ta),
                        &key_problem_text(it, ta),
                    )));
                }
                // D-0108 `[Cmp-Text]`: two `String`s compare by their bytes.
                if (!has_unresolved_marker(ta) && is_std_string(ta))
                {
                    bool keycmp = match (HashMap::get(&b.facts.view_ops, &whole.id))
                    {
                        Some(ViewOp::KeyCmp) : true,
                        _                    : false,
                    };
                    if (!keycmp)
                    {
                        HashMap::insert(&mut b.facts.view_ops, whole.id, ViewOp::TextCmp);
                    }
                    return Ok(Some(Type::TBool));
                }
                // `[T-Cmp]`: "not resource".
                if (!has_unresolved_marker(ta) && !named_key_type(it, ta) && is_resource_ty(it, ta))
                {
                    String msg = sprintf(
                        "a comparison reads both operands whole, and `%s` is a resource; compare what it holds (an element at a time, `String::eq`, or through a view or slice)",
                        &type_display(ta),
                    );
                    return Err(named_diag("diag.read-of-resource", &msg));
                }
            },
            None     : {},
        },
        None : {},
    }
    // D-0271 `[Cmp-Key]`: from whichever operand's type is known.
    Option<Type> known = None;
    for (usize side = 0; side < 2 && Option::is_none(&known); side += 1)
    {
        ref<Option<Type>, shared> ot = if (side == 0) { at } else { bt };
        match (ot)
        {
            Some(t) :
            {
                if (!has_unresolved_marker(t) && is_named_ty(t) && !is_std_string(t))
                {
                    known = Some(clone(t));
                }
            },
            None    : {},
        }
    }
    match (&known)
    {
        Some(t) :
        {
            bool ordering = is_order_op(op);
            if (named_key_type(it, t))
            {
                if (ordering || is_resource_ty(it, t))
                {
                    HashMap::insert(&mut b.facts.view_ops, whole.id, ViewOp::KeyCmp);
                }
            }
            else if (ordering && !named_is(t, "std::StringView"))
            {
                return Err(mismatch(sprintf(
                    "`<`, `<=`, `>`, `>=` order numbers, `bool`, `str`, `String`, and a struct or enum of those; a `%s` is compared with `==` and `!=` only%s",
                    &type_display(t),
                    &key_problem_text(it, t),
                )));
            }
        },
        None    : {},
    }
    Ok(Some(Type::TBool))
}

// A best-effort retry from the other side.
fn reguess(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Option<Type>, shared> hint,
) : Option<Type>
{
    match (check_expr(b, it, e, hint))
    {
        Ok(t)  : t,
        Err(_) : None,
    }
}

// A literal, or a literal-bound local (spec/14, CHG-0092), consulted only
// when refutations are reported.
fn known_value(ref<Body, shared> b, ref<Expr, shared> e) : Option<i128>
{
    match (literal_value(e))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (path_segs(strip_parens_tc(e)))
    {
        Some(segs) :
        {
            if (Vec::len(segs) == 1 && b.report && !b.flow.unreachable)
            {
                return match (HashMap::get(&b.flow.lits, &segs[0]))
                {
                    Some(v) : Some(*v),
                    None    : None,
                };
            }
            None
        },
        None       : None,
    }
}

// An integer expression's value when it is made of known values, unary
// minus, `+ - * / %`, and `widen`/`narrow` of one.
fn fold_int(ref<Body, shared> b, ref<Expr, shared> e) : Option<i128>
{
    match (known_value(b, e))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EUnary(ub)  :
        {
            if (Box::get(ub).op != UnOp::Neg)
            {
                return None;
            }
            i128 x = fold_int(b, &Box::get(ub).e)?;
            checked_sub(0, x)
        },
        ExprKind::EBinary(bb) :
        {
            ref<BinaryExpr, shared> x = Box::get(bb);
            i128 p = fold_int(b, &x.a)?;
            i128 q = fold_int(b, &x.b)?;
            if (x.op == BinOp::Add)
            {
                return checked_add(p, q);
            }
            if (x.op == BinOp::Sub)
            {
                return checked_sub(p, q);
            }
            if (x.op == BinOp::Mul)
            {
                return checked_mul(p, q);
            }
            if (x.op == BinOp::Div && q != 0)
            {
                return checked_div(p, q);
            }
            if (x.op == BinOp::Rem && q != 0)
            {
                if (p == min_value<i128>() && q == -1)
                {
                    return None;
                }
                return checked_rem(p, q);
            }
            None
        },
        ExprKind::ECall(cb)   :
        {
            ref<CallExpr, shared> call = Box::get(cb);
            if (Vec::len(&call.args) != 1)
            {
                return None;
            }
            match (path_segs(&call.callee))
            {
                Some(segs) :
                {
                    if (Vec::len(segs) == 1 && (String::eq_str(
                        &segs[0],
                        "widen",
                    ) || String::eq_str(&segs[0], "narrow")))
                    {
                        return fold_int(b, &call.args[0]);
                    }
                    None
                },
                None       : None,
            }
        },
        _                     : None,
    }
}

enum ArithErr
{
    Overflow,
    DivByZero,
    DivOverflow,
}

// `value::checked_*`: `x op y` in integer type `t`, on coby's payloads
// (a `u128`'s bit pattern).
fn value_checked(BinOp op, IntTy t, i128 x, i128 y) : Result<i128, ArithErr>
{
    if (op == BinOp::Div || op == BinOp::Rem)
    {
        if (y == 0)
        {
            return Err(ArithErr::DivByZero);
        }
        if (t == IntTy::U128)
        {
            u128 p = reinterpret<u128>(x);
            u128 q = reinterpret<u128>(y);
            return Ok(reinterpret<i128>(if (op == BinOp::Div) { p / q } else { p % q }));
        }
        if (int_ty_signed(t) && x == int_range(t).min && y == -1)
        {
            return Err(ArithErr::DivOverflow);
        }
        return Ok(if (op == BinOp::Div) { x / y } else { x % y });
    }
    if (t == IntTy::U128)
    {
        u128 p = reinterpret<u128>(x);
        u128 q = reinterpret<u128>(y);
        Option<u128> r = if (op == BinOp::Add)
        {
            checked_add(
                p,
                q,
            )
        }
        else if (op == BinOp::Sub) { checked_sub(p, q) } else { checked_mul(p, q) };
        return match (r)
        {
            Some(v) : Ok(reinterpret<i128>(v)),
            None    : Err(ArithErr::Overflow),
        };
    }
    Option<i128> r = if (op == BinOp::Add)
    {
        checked_add(
            x,
            y,
        )
    }
    else if (op == BinOp::Sub) { checked_sub(x, y) } else { checked_mul(x, y) };
    match (r)
    {
        Some(v) : if (in_range(t, v)) { Ok(v) } else { Err(ArithErr::Overflow) },
        None    : Err(ArithErr::Overflow),
    }
}

fn operand_text(ref<Expr, shared> e, i128 v) : String
{
    match (path_segs(strip_parens_tc(e)))
    {
        Some(segs) :
        {
            if (Vec::len(segs) == 1)
            {
                return sprintf("%s (here %v)", shown_name(String::as_view(&segs[0])), v);
            }
            sprintf("%v", v)
        },
        None       : sprintf("%v", v),
    }
}

// `rule.control.flow-analysis` §6's literal-operand constant-fold
// refutation: both operands known, the result is checked now.
fn check_literal_fold_overflow(
    ref<Body, shared> b,
    BinOp op,
    IntTy t,
    ref<Expr, shared> a,
    ref<Expr, shared> c,
) : Result<void, String>
{
    i128 av = match (known_value(b, a))
    {
        Some(v) : v,
        None    : return Ok(()),
    };
    i128 bv = match (known_value(b, c))
    {
        Some(v) : v,
        None    : return Ok(()),
    };
    if (!(op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul || op == BinOp::Div || op == BinOp::Rem))
    {
        return Ok(());
    }
    if ((op == BinOp::Div || op == BinOp::Rem) && bv == 0)
    {
        return Err(String::from_str("diag.div-by-zero"));
    }
    match (value_checked(op, t, av, bv))
    {
        Ok(_)                      : Ok(()),
        Err(ArithErr::DivOverflow) : Err(String::from_str("diag.div-overflow")),
        Err(_)                     :
        {
            IntRange r = int_range(t);
            String msg = sprintf(
                "%s %s %s is outside `%s` (%v to %v); widen an operand first (`widen<T>(x)`) or use `wrapping_*`/`checked_*`",
                &operand_text(a, av),
                op_symbol(op),
                &operand_text(c, bv),
                int_ty_name(t),
                r.min,
                r.max,
            );
            Err(named_diag("diag.arith-overflow", &msg))
        },
    }
}

fn check_field(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> base,
    ref<String, shared> name,
) : Result<Option<Type>, String>
{
    Option<Type> bt0 = check_expr(b, it, base, &None)?;
    // `[Field-Access-Auto-Deref]`: through a reference, and (D-0064)
    // through a guard.
    Option<Type> bt = deref_to(bt0);
    if (is_marker_opt(&bt))
    {
        return Err(unbounded_msg("a field access"));
    }
    match (&bt)
    {
        Some(Type::TNamed(nb)) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(sdecl) :
                {
                    HashMap<String, Type> subst = zip_subst(&sdecl.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&sdecl.fields); i += 1)
                    {
                        ref<FieldDecl, shared> fd = &sdecl.fields[i];
                        if (String::eq(&fd.name, name))
                        {
                            if (!b.privileged && !field_visible(
                                String::as_view(&n.name),
                                fd.export_,
                                String::as_view(&b.module_),
                            ))
                            {
                                String msg = sprintf(
                                    "field `%s` of `%s` is not exported",
                                    name,
                                    &type_display(&named(String::as_view(&n.name), Vec::new())),
                                );
                                return Err(named_diag("diag.name-not-visible", &msg));
                            }
                            return Ok(Some(apply_subst(&fd.ty, &subst)));
                        }
                    }
                    Err(mismatch(sprintf("`%s` has no field `%s`%s", &type_display(Option::expect(match (&bt)
                    {
                        Some(t) : Some(t),
                        None    : None,
                    }, "a type")), name, &method_hint(it, &n.name, name))))
                },
                None        :
                {
                    if (HashMap::contains(&it.enums, &n.name))
                    {
                        // An enum value has no fields: its payload is
                        // reached by `match`.
                        return Err(mismatch(sprintf(
                            "`%s` is an enum and has no field `%s`%s",
                            &type_display(&named(String::as_view(&n.name), clone(&n.args))),
                            name,
                            &method_hint(it, &n.name, name),
                        )));
                    }
                    Ok(None)
                },
            }
        },
        Some(t)                :
        {
            bool plain = match (t)
            {
                Type::TInt(_)    : true,
                Type::TF32       : true,
                Type::TF64       : true,
                Type::TBool      : true,
                Type::TStr       : true,
                Type::TVoid      : true,
                Type::TArray(_)  : true,
                Type::TSlice(_)  : true,
                Type::TFn(_)     : true,
                Type::THandle(_) : true,
                Type::TMutex(_)  : true,
                Type::TRawptr(_) : true,
                _                : false,
            };
            if (plain)
            {
                return Err(mismatch(sprintf("a value of type `%s` has no field `%s`", &type_display(t), name)));
            }
            Ok(None)
        },
        None                   : Ok(None),
    }
}

// CobaltC has no method-call syntax: when `T::f` is a function, say how to
// call it.
fn method_hint(ref<Items, shared> it, ref<String, shared> tname, ref<String, shared> name) : String
{
    String f = sprintf("%s::%s", tname, name);
    if (HashMap::contains(&it.fns, &f))
    {
        return sprintf(
            "; there is no method-call syntax -- call the function as `%s(x, ...)`",
            Option::unwrap_or(String::strip_prefix(&f, "std::"), String::as_view(&f)),
        );
    }
    String::new()
}

// ---- part 8: typecheck.rs lines 4588-5903 ----

fn is_intrinsic_name_tc(ref<String, shared> n) : bool
{
    is_intrinsic_any(n)
}

fn is_float_fn(ref<String, shared> key) : bool
{
    match (String::strip_prefix(key, "std::"))
    {
        Some(rest) :
        {
            if (is_float2_fn(key))
            {
                return false;
            }
            Vec<StringView> fs = StringView::split_whitespace(PRELUDE_FLOAT_FNS);
            for (usize i = 0; i < Vec::len(&fs); i += 1)
            {
                if (StringView::eq(fs[i], rest))
                {
                    return true;
                }
            }
            false
        },
        None       : false,
    }
}

fn is_float2_fn(ref<String, shared> key) : bool
{
    String::eq_str(key, "std::atan2") || String::eq_str(key, "std::powf")
}

// D-0252: the functions of `std` called only inside `unsafe`.
fn is_trusted_std_call(ref<String, shared> name) : bool
{
    foreach (n in ["std::String::from_c", "std::Vec::from_c_bytes", "std::Vec::from_raw", "std::copy_to_raw"])
    {
        if (String::eq_str(name, n))
        {
            return true;
        }
    }
    false
}

fn check_path(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Vec<String>, shared> segs,
) : Result<Option<Type>, String>
{
    if (Vec::len(segs) == 1)
    {
        // `[Binding-Lookup]`'s `temporally-valid(a_x)`: refuted when
        // `valid(x)` is `F`, or (D-0089) `U`.
        Option<Tri> v = match (HashMap::get(&b.flow.valid, &segs[0]))
        {
            Some(t) : Some(*t),
            None    : None,
        };
        bool stale = match (v)
        {
            Some(Tri::F) : true,
            Some(Tri::U) : true,
            _            : false,
        };
        bool reinit = match (&b.reinit_target)
        {
            Some(r) : String::eq(r, &segs[0]),
            None    : false,
        };
        if (stale && !reinit)
        {
            StringView n = shown_name(String::as_view(&segs[0]));
            String msg = match (v)
            {
                Some(Tri::F) : sprintf(
                    "`%s` was moved or dropped before this use, and holds no value here; give it a new value first (`%s = …;`)",
                    n,
                    n,
                ),
                _ : sprintf(
                    "`%s` may have been moved or dropped before this use -- on some path to here, or in an earlier pass of the loop -- so it may hold no value; give it a new value on every path first (`%s = …;`), or move a copy",
                    n,
                    n,
                ),
            };
            refute(b, &named_diag("diag.stale-binding", &msg))?;
        }
        match (lookup_local(b, &segs[0]))
        {
            Some(t) : return Ok(Some(t)),
            None    : {},
        }
        // Bound, but of a type this pass could not determine.
        if (flow_is_tracked(&b.flow, &segs[0]) || HashSet::contains(&b.capture_names, &segs[0]))
        {
            return Ok(None);
        }
    }
    String name = String::join(&segs[0..$], "::");
    // D-0258: a static is a place of its type (`[Static-Use]`).
    match (HashMap::get(&it.statics, &name))
    {
        Some(s) : return Ok(Some(clone(&s.ty))),
        None    : {},
    }
    match (variant_enum(it, segs))
    {
        Some(enum_name) :
        {
            // `[T-Enum]`: a variant with a payload written without one.
            bool payload = match (variant_arity(it, &enum_name, segs))
            {
                Some(p) : p,
                None    : false,
            };
            if (payload && !HashMap::contains(&it.fns, &name))
            {
                ref<String, shared> v = &segs[Vec::len(segs) - 1];
                return Err(mismatch(sprintf(
                    "`%s` carries a value; write `%s(value)` (a variant without `(…)` is one that carries none)",
                    v,
                    v,
                )));
            }
            // A payload-less variant; its type parameters are left opaque.
            return Ok(None);
        },
        None            : {},
    }
    if (Vec::len(segs) == 1 && !HashSet::contains(
        &b.capture_names,
        &segs[0],
    ) && !HashMap::contains(
        &it.fns,
        &name,
    ) && !HashMap::contains(&it.externs, &name) && !is_intrinsic_name_tc(&segs[0]))
    {
        // `[Binding-Lookup-Unbound]` / `[Resolve-Unbound]`: a private
        // function of the same name in another module (not `std`'s) is
        // named.
        Option<String> hidden = None;
        for (usize i = 0; i < HashMap::len(&it.fns); i += 1)
        {
            ref<String, shared> k = HashMap::key_at(&it.fns, i);
            ref<FnDecl, shared> f = HashMap::value_at(&it.fns, i);
            if (!f.export_ && Option::is_none(&f.assoc_type) && !f.is_const && String::contains(
                k,
                "::",
            ) && !String::starts_with(
                k,
                "std::",
            ) && StringView::eq(last_segment(String::as_view(k)), String::as_view(&segs[0])))
            {
                bool better = match (&hidden)
                {
                    Some(h) : String::less(k, h),
                    None    : true,
                };
                if (better)
                {
                    hidden = Some(String::clone(k));
                }
            }
        }
        // A function of `std` the module did not import.
        String std_key = sprintf("std::%s", &segs[0]);
        bool in_std = match (HashMap::get(&it.fns, &std_key))
        {
            Some(f) : f.export_,
            None    : false,
        } || is_float_fn(&std_key) || is_float2_fn(&std_key) || String::eq_str(
            &std_key,
            "std::printf",
        ) || String::eq_str(
            &std_key,
            "std::sprintf",
        ) || String::eq_str(&std_key, "std::eprintf") || String::eq_str(&std_key, "std::assert");
        String msg = match (hidden)
        {
            Some(k) : sprintf("nothing named `%s` is visible here; `%s` is not exported from its module", &segs[0], &k),
            None    :
            {
                if (in_std)
                {
                    sprintf(
                        "nothing named `%s` is declared here; the standard library's `%s` is brought in by `import std;`",
                        &segs[0],
                        &segs[0],
                    )
                }
                else
                {
                    sprintf("nothing named `%s` is declared here", &segs[0])
                }
            },
        };
        return Err(named_diag("diag.unbound-name", &msg));
    }
    // A built-in operation named where a value is wanted.
    if (Vec::len(segs) == 1 && is_intrinsic_name_tc(&segs[0]) && !HashSet::contains(
        &b.capture_names,
        &segs[0],
    ) && !HashMap::contains(&it.fns, &name) && !HashMap::contains(&it.externs, &name))
    {
        String msg = sprintf(
            "`%s` is a built-in operation, only called (`%s(…)`); it is not a value",
            &segs[0],
            &segs[0],
        );
        return Err(named_diag("diag.unbound-name", &msg));
    }
    if (Vec::len(segs) > 1 && !HashMap::contains(
        &it.fns,
        &name,
    ) && !HashMap::contains(&it.externs, &name) && !is_intrinsic_name_tc(&name))
    {
        // A qualified path is an item, an `Enum::Variant`, or unbound.
        Vec<String> head = Vec::new();
        for (usize i = 0; i + 1 < Vec::len(segs); i += 1)
        {
            Vec::push(&mut head, String::clone(&segs[i]));
        }
        String prefix = String::join(&head[0..$], "::");
        bool is_variant = match (HashMap::get(&it.enums, &prefix))
        {
            Some(e) : Option::is_some(&variant_has_payload(e, &segs[Vec::len(segs) - 1])),
            None    : false,
        };
        if (!is_variant)
        {
            String msg = sprintf(
                "nothing named `%s`",
                Option::unwrap_or(String::strip_prefix(&name, "std::"), String::as_view(&name)),
            );
            return Err(named_diag("diag.unbound-name", &msg));
        }
    }
    if (is_trusted_std_call(&name))
    {
        String msg = sprintf(
            "`%s` is only called, inside `unsafe { }`, never used as a value",
            Option::unwrap_or(String::strip_prefix(&name, "std::"), String::as_view(&name)),
        );
        return Err(named_diag("diag.trusted-outside-unsafe", &msg));
    }
    match (HashMap::get(&it.fns, &name))
    {
        Some(f) :
        {
            // `[T-Item]`: a non-generic function item is a value of its
            // `fn(...) : τ` type, and its body is reached.
            if (Vec::len(&f.type_params) == 0)
            {
                record_instantiation(b, &name, &Vec::new());
                return Ok(Some(fn_type_of(f)));
            }
            return Ok(None);
        },
        None    : {},
    }
    if (HashMap::contains(&it.externs, &name))
    {
        // D-0252: an `extern fn` is only called, inside `unsafe`.
        String msg = sprintf(
            "`%s` is a C function: it is only called, inside `unsafe { }`, never used as a value",
            Option::unwrap_or(String::strip_prefix(&name, "std::"), String::as_view(&name)),
        );
        return Err(named_diag("diag.trusted-outside-unsafe", &msg));
    }
    Ok(None)
}

fn fn_type_of(ref<FnDecl, shared> f) : Type
{
    Vec<Type> ps = Vec::new();
    for (usize i = 0; i < Vec::len(&f.params); i += 1)
    {
        Vec::push(&mut ps, clone(&f.params[i].ty));
    }
    fn_of(ps, clone(&f.ret))
}

fn plural(usize n) : str
{
    if (n == 1) { "" } else { "s" }
}

fn is_are(usize n) : str
{
    if (n == 1) { "is" } else { "are" }
}

// `[T-Item-Generic]` (D-0093): the type of a generic function item used as
// a value, when this position instantiates it.
fn generic_item_value(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Vec<String>, shared> segs,
    ref<Vec<Type>, shared> targs,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    String name = String::join(&segs[0..$], "::");
    ref<FnDecl, shared> f = match (HashMap::get(&it.fns, &name))
    {
        Some(f) : f,
        None    : return Ok(None),
    };
    if (Vec::len(&f.type_params) == 0)
    {
        return Ok(None);
    }
    Type decl = fn_type_of(f);
    if (Vec::len(targs) > 0)
    {
        // `[Generic-Call-Arity]`'s analog.
        if (Vec::len(targs) != Vec::len(&f.type_params))
        {
            return Err(mismatch(sprintf(
                "`%s` takes %v type argument%s, and %v %s given",
                &name,
                Vec::len(&f.type_params),
                plural(Vec::len(&f.type_params)),
                Vec::len(targs),
                is_are(Vec::len(targs)),
            )));
        }
        HashMap<String, Type> m = HashMap::new();
        for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
        {
            HashMap::insert(&mut m, String::clone(&f.type_params[i]), apply_subst(&targs[i], &b.subst));
        }
        return Ok(Some(apply_subst(&decl, &m)));
    }
    match (expected)
    {
        Some(exp) : match (exp)
        {
            Type::TFn(eb) :
            {
                if (!has_unresolved_marker(exp))
                {
                    if (Vec::len(&Box::get(eb).params) != Vec::len(&f.params))
                    {
                        return Err(mismatch(sprintf(
                            "`%s` takes %v parameter%s, but `%s` is expected",
                            &name,
                            Vec::len(&f.params),
                            plural(Vec::len(&f.params)),
                            &type_display(exp),
                        )));
                    }
                    HashMap<String, Type> m = HashMap::new();
                    unify_type_shape(&decl, exp, &mut m, &f.type_params);
                    bool all = true;
                    for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
                    {
                        if (!HashMap::contains(&m, &f.type_params[i]))
                        {
                            all = false;
                        }
                    }
                    if (all)
                    {
                        Type inst = apply_subst(&decl, &m);
                        if (type_eq(&inst, exp))
                        {
                            return Ok(Some(inst));
                        }
                        return Err(mismatch(sprintf(
                            "`%s` cannot have the type `%s`: it would be `%s`",
                            &name,
                            &type_display(exp),
                            &type_display(&inst),
                        )));
                    }
                }
            },
            _             : {},
        },
        None : {},
    }
    Ok(None)
}

fn is_bare_str_literal(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EStr(_)   : true,
        ExprKind::EParen(x) : is_bare_str_literal(Box::get(x)),
        _                   : false,
    }
}

fn variant_index_of(ref<EnumDecl, shared> e, ref<String, shared> name) : Option<usize>
{
    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
    {
        if (String::eq(&e.variants[i].name, name))
        {
            return Some(i);
        }
    }
    None
}

// Enum variant construction, `Vi(e)`; `None` when the call is not one.
fn check_variant_call(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Vec<String>, shared> segs,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    ref<Option<Type>, shared> expected,
) : Option<Result<Option<Type>, String>>
{
    String enum_name = variant_enum(it, segs)?;
    ref<EnumDecl, shared> e = HashMap::get(&it.enums, &enum_name)?;
    usize vi = variant_index_of(e, &segs[Vec::len(segs) - 1])?;
    // `[T-Enum]`: a payload-less `Vi` is written bare.
    match (variant_arity(it, &enum_name, segs))
    {
        Some(false) : return Some(Err(String::from_str("diag.type-mismatch"))),
        _           : {},
    }
    ref<Type, shared> raw_payload = match (&e.variants[vi].payload)
    {
        Some(p) : p,
        None    : return None,
    };
    Some(check_variant_payload(b, it, &enum_name, e, raw_payload, segs, targs, args, expected))
}

fn check_variant_payload(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> enum_name,
    ref<EnumDecl, shared> e,
    ref<Type, shared> raw_payload,
    ref<Vec<String>, shared> segs,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    HashMap<String, Type> m = HashMap::new();
    for (usize i = 0; i < Vec::len(&e.type_params) && i < Vec::len(targs); i += 1)
    {
        HashMap::insert(&mut m, String::clone(&e.type_params[i]), apply_subst(&targs[i], &b.subst));
    }
    // `rule.type.expected`: an expected type of this enum supplies the
    // type arguments not written.
    match (expected)
    {
        Some(Type::TNamed(nb)) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (String::eq(&n.name, enum_name) && Vec::len(&n.args) == Vec::len(&e.type_params))
            {
                for (usize i = 0; i < Vec::len(&e.type_params); i += 1)
                {
                    if (!HashMap::contains(&m, &e.type_params[i]) && !has_unresolved_marker(&n.args[i]))
                    {
                        HashMap::insert(&mut m, String::clone(&e.type_params[i]), clone(&n.args[i]));
                    }
                }
            }
        },
        _                      : {},
    }
    HashSet<String> remaining = HashSet::new();
    for (usize i = 0; i < Vec::len(&e.type_params); i += 1)
    {
        if (!HashMap::contains(&m, &e.type_params[i]))
        {
            HashSet::insert(&mut remaining, String::clone(&e.type_params[i]));
        }
    }
    Type hint = apply_subst(raw_payload, &m);
    Option<Type> at = None;
    if (mentions_any(&hint, &remaining))
    {
        bool saved = b.infer_poisoned;
        b.infer_poisoned = true;
        Result<Option<Type>, String> r = check_store_operand(b, it, &args[0], &None);
        b.infer_poisoned = saved;
        at = r?;
    }
    else if (named_is(&hint, "std::StringView") && Vec::len(&named_args(&hint)) == 0 && is_bare_str_literal(&args[0]))
    {
        // D-0225: `[Str-Literal-View]` through the constructor.
        note_rewrite(b, strip_parens_tc(&args[0]), Rewrite::LiteralView);
        at = Some(clone(&hint));
    }
    else
    {
        Option<Type> t = check_store_operand(b, it, &args[0], &Some(clone(&hint)))?;
        // `[T-Enum]`: the payload has the variant's type.
        match (&t)
        {
            Some(tt) :
            {
                if (!has_unresolved_marker(tt) && !has_unresolved_marker(&hint) && !is_never(tt) && !ty_compat(
                    tt,
                    &hint,
                ))
                {
                    return Err(mismatch(sprintf(
                        "`%s` holds a `%s`, but this is `%s`",
                        &segs[Vec::len(segs) - 1],
                        &type_display(&hint),
                        &type_display(tt),
                    )));
                }
            },
            None     : {},
        }
        at = t;
    }
    match (&at)
    {
        Some(a) : unify_type_shape(raw_payload, a, &mut m, &e.type_params),
        None    : {},
    }
    Vec<Type> targs_c = Vec::new();
    for (usize i = 0; i < Vec::len(&e.type_params); i += 1)
    {
        match (HashMap::get(&m, &e.type_params[i]))
        {
            Some(t) : Vec::push(&mut targs_c, clone(t)),
            None    : return Ok(None),
        }
    }
    Ok(Some(named(String::as_view(enum_name), targs_c)))
}

struct Shape
{
    usize tmin;
    usize tmax;
    usize amin;
    usize amax;
    str form;
}

fn shape(usize tmin, usize tmax, usize amin, usize amax, str form) : Option<Shape>
{
    Some(Shape { .tmin = tmin, .tmax = tmax, .amin = amin, .amax = amax, .form = form })
}

// WI-15's `INTRINSIC_SHAPES`: an intrinsic's type and value arity, and how
// it is written.
fn intrinsic_shape(StringView n) : Option<Shape>
{
    foreach (x in ["sizeof", "alignof", "dangling", "null_rawptr"])
    {
        if (StringView::eq_str(n, x))
        {
            return shape(1, 1, 0, 0, "<T>()");
        }
    }
    if (StringView::eq_str(n, "min_value") || StringView::eq_str(n, "max_value"))
    {
        return shape(0, 1, 0, 0, "<T>()");
    }
    foreach (x in ["widen", "narrow", "narrow_wrapping", "reinterpret", "to_float", "to_int", "checked_narrow"])
    {
        if (StringView::eq_str(n, x))
        {
            return shape(1, 1, 1, 1, "<T>(x)");
        }
    }
    if (StringView::eq_str(n, "reinterpret_ptr") || StringView::eq_str(n, "reclaim"))
    {
        return shape(1, 1, 1, 1, "<T>(p)");
    }
    if (StringView::eq_str(n, "rawptr_of"))
    {
        return shape(0, 1, 1, 1, "(r)");
    }
    if (StringView::eq_str(n, "rawptr_from_address"))
    {
        return shape(1, 1, 1, 1, "<T>(a)");
    }
    if (StringView::eq_str(n, "rawptr_address"))
    {
        return shape(0, 1, 1, 1, "(p)");
    }
    foreach (x in ["count_ones", "leading_zeros", "trailing_zeros"])
    {
        if (StringView::eq_str(n, x))
        {
            return shape(0, 0, 1, 1, "(x)");
        }
    }
    if (StringView::eq_str(n, "checked_neg"))
    {
        return shape(0, 1, 1, 1, "(x)");
    }
    if (StringView::eq_str(n, "rotate_left") || StringView::eq_str(n, "rotate_right"))
    {
        return shape(0, 0, 2, 2, "(x, k)");
    }
    foreach (x in [
        "wrapping_add",
        "wrapping_sub",
        "wrapping_mul",
        "saturating_add",
        "saturating_sub",
        "saturating_mul",
        "checked_add",
        "checked_sub",
        "checked_mul",
        "checked_div",
        "checked_rem",
    ])
    {
        if (StringView::eq_str(n, x))
        {
            return shape(0, 1, 2, 2, "(a, b)");
        }
    }
    foreach (x in ["str_len", "str_ptr", "slice_len"])
    {
        if (StringView::eq_str(n, x))
        {
            return shape(0, 0, 1, 1, "(s)");
        }
    }
    if (StringView::eq_str(n, "str_byte"))
    {
        return shape(0, 0, 2, 2, "(s, i)");
    }
    if (StringView::eq_str(n, "drop"))
    {
        return shape(0, 1, 1, 1, "(x)");
    }
    foreach (x in ["join", "cancel", "lock"])
    {
        if (StringView::eq_str(n, x))
        {
            return shape(0, 1, 1, 1, "(h)");
        }
    }
    if (StringView::eq_str(n, "allocate"))
    {
        return shape(0, 0, 2, 2, "(bytes, align)");
    }
    if (StringView::eq_str(n, "deallocate"))
    {
        return shape(0, 0, 3, 3, "(p, bytes, align)");
    }
    if (StringView::eq_str(n, "release"))
    {
        return shape(0, 0, 2, 2, "(p, n)");
    }
    if (StringView::eq_str(n, "copy_raw"))
    {
        return shape(0, 0, 3, 3, "(dst, src, n)");
    }
    if (StringView::eq_str(n, "join_status"))
    {
        return shape(0, 1, 2, 2, "(&h, mode)");
    }
    if (StringView::eq_str(n, "Mutex::new"))
    {
        return shape(0, 1, 1, 1, "(x)");
    }
    if (StringView::eq_str(n, "std::Result::map_err"))
    {
        return shape(0, 2, 2, 2, "(r, f)");
    }
    if (StringView::eq_str(n, "spawn"))
    {
        return shape(0, 0, 1, max_value<usize>(), "(f, a…)");
    }
    if (StringView::eq_str(n, "atomic_op"))
    {
        return shape(0, 0, 4, 4, "(a, op, x, y)");
    }
    if (StringView::eq_str(n, "atomic_wait_op"))
    {
        return shape(0, 0, 3, 3, "(a, op, seen)");
    }
    if (StringView::eq_str(n, "cpu_op"))
    {
        return shape(0, 0, 1, 1, "(op)");
    }
    // D-0254
    if (StringView::eq_str(n, "simd_load"))
    {
        return shape(1, 1, 2, 2, "<V>(s, i)");
    }
    if (StringView::eq_str(n, "simd_store"))
    {
        return shape(0, 0, 3, 3, "(s, i, v)");
    }
    if (is_simd_pair_intrinsic(n))
    {
        return shape(0, 0, 2, 2, "(a, b)");
    }
    if (StringView::eq_str(n, "simd_select"))
    {
        return shape(0, 0, 3, 3, "(mask, a, b)");
    }
    foreach (x in ["simd_any", "simd_all", "simd_sum", "simd_reduce_min", "simd_reduce_max"])
    {
        if (StringView::eq_str(n, x))
        {
            return shape(0, 0, 1, 1, "(v)");
        }
    }
    None
}

fn is_std_only_intrinsic(StringView n) : bool
{
    foreach (x in [
        "str_slice",
        "append_native",
        "text_write",
        "parse_check",
        "parse_value",
        "key_hash",
        "key_eq",
        "key_less",
        "key_less_at",
        "swap_places",
        "lend_places",
        "atomic_op",
        "atomic_wait_op",
        "cpu_op",
    ])
    {
        if (StringView::eq_str(n, x))
        {
            return true;
        }
    }
    false
}

fn is_trusted_intrinsic(StringView n) : bool
{
    foreach (x in [
        "reclaim",
        "release",
        "copy_raw",
        "deallocate",
        "text_write",
        "parse_check",
        "parse_value",
        "read_volatile",
        "write_volatile",
        "rawptr_from_address",
        "rawptr_address",
    ])
    {
        if (StringView::eq_str(n, x))
        {
            return true;
        }
    }
    false
}

// `rule.arith.alt`'s operations, whose two operands share one type.
fn is_alt_intrinsic(StringView n) : bool
{
    foreach (x in [
        "wrapping_add",
        "wrapping_sub",
        "wrapping_mul",
        "saturating_add",
        "saturating_sub",
        "saturating_mul",
        "checked_add",
        "checked_sub",
        "checked_mul",
        "checked_div",
        "checked_rem",
    ])
    {
        if (StringView::eq_str(n, x))
        {
            return true;
        }
    }
    false
}

// The diagnostics that can happen at run time (phase `dynamic` or `both`
// in spec/registry/diagnostics.md), for `fault`.
fn is_dynamic_diag(ref<String, shared> id) : bool
{
    String spaced = sprintf(" %s ", id);
    StringView::contains(PRELUDE_DYNAMIC_DIAGS, String::as_view(&spaced))
}

fn pelem_eq(ref<PElem, shared> a, ref<PElem, shared> b) : bool
{
    match (a)
    {
        PElem::PField(f) : match (b)
        {
            PElem::PField(g) : String::eq(f, g),
            _                : false,
        },
        PElem::PIndex(x) : match (b)
        {
            PElem::PIndex(y) : match (x)
            {
                Some(p) : match (y)
                {
                    Some(q) : *p == *q,
                    None    : false,
                },
                None : Option::is_none(y),
            },
            _ : false,
        },
        PElem::PRange(r) : match (b)
        {
            PElem::PRange(s) : match (r)
            {
                Some(r1) : match (s)
                {
                    Some(r2) : r1.lo == r2.lo && r1.hi == r2.hi,
                    None     : false,
                },
                None : Option::is_none(s),
            },
            _ : false,
        },
    }
}

// Whether path `p` starts with path `q`.
fn path_starts_with(ref<Vec<PElem>, shared> p, ref<Vec<PElem>, shared> q) : bool
{
    if (Vec::len(q) > Vec::len(p))
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(q); i += 1)
    {
        if (!pelem_eq(&p[i], &q[i]))
        {
            return false;
        }
    }
    true
}

// Whether `k` lies within one of the unsure places.
fn unsure_covers(ref<Vec<Place>, shared> unsure, ref<DerivKey, shared> k) : bool
{
    for (usize i = 0; i < Vec::len(unsure); i += 1)
    {
        if (String::eq(&unsure[i].root, &k.root) && path_starts_with(&k.path, &unsure[i].path))
        {
            return true;
        }
    }
    false
}

// D-0282: an access to `root.path` in `mode` (a `Vec` element read or
// borrowed), against the live holders other than those the access goes
// through.
fn tier_access(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> root,
    ref<Vec<PElem>, shared> path,
    Mode mode,
    ref<HashSet<String>, shared> through,
) : Result<void, String>
{
    bool point = false;
    Vec<String> hs = holder_names(b);
    for (usize hi = 0; hi < Vec::len(&hs); hi += 1)
    {
        ref<String, shared> h = &hs[hi];
        if (HashSet::contains(through, h))
        {
            continue;
        }
        bool tier_d = match (HashMap::get(&b.gamma, h))
        {
            Some(t) : tier_d_type(it, t),
            None    : false,
        };
        if (tier_d && !is_holder(b, it, h))
        {
            continue;
        }
        // Liveness (`holder_live_after` follows who reaches `h`) is asked
        // only of a holder with a fact at this root.
        Option<bool> live = None;
        Vec<DerivFact> facts = facts_of(b, h, false);
        for (usize k = 0; k < Vec::len(&facts); k += 1)
        {
            ref<DerivFact, shared> d = &facts[k];
            if (d.v == Tri::F || !String::eq(&d.key.root, root) || permitted(mode, d.key.mode))
            {
                continue;
            }
            bool compound = Vec::contains(&b.compound_held, h);
            if (!compound)
            {
                bool is_live = match (live)
                {
                    Some(l) : l,
                    None    :
                    {
                        bool l = holder_live_after(b, it, h);
                        live = Some(l);
                        l
                    },
                };
                if (!is_live)
                {
                    break;
                }
            }
            match (overlap3(&d.key.path, path))
            {
                Ov::OvNo    : {},
                Ov::OvMaybe : point = true,
                Ov::OvYes   :
                {
                    // The hidden reference's fact may be its whole
                    // container (`&mut v[f(x)]`): which element is a value.
                    if (d.v != Tri::T || compound)
                    {
                        point = true;
                    }
                    else
                    {
                        String msg = sprintf(
                            "%s still borrows `%s`, so it cannot be %s here",
                            &holder_text(String::as_view(h)),
                            &shown_place(String::as_view(&d.key.root), &d.key.path),
                            if (mode == Mode::Exclusive) { "written or borrowed `mut`" } else { "read" },
                        );
                        if (zero_sized_vec_element(b, it, &d.key.root, &d.key.path))
                        {
                            String::append(&mut msg, " (every element of a `Vec` of a zero-sized type is one place)");
                        }
                        return refute(b, &named_diag("diag.aliasing-conflict", &msg));
                    }
                },
            }
        }
    }
    if (point)
    {
        usize line = b.current_line;
        b.rep.point_checks += 1;
        Vec::push(&mut b.rep.events, sprintf("P\t%v\t%s\telement", line, root));
        rep_left(
            b,
            sprintf("line %v: an element of `%s` that only values decide", line, shown_name(String::as_view(root))),
        );
    }
    Ok(())
}

// An element of a `Vec` read (`v[i]`, `v[i].f`) or borrowed: what it
// reaches, for `tier_access`.
fn tier_elem_access(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    Mode mode,
) : Result<void, String>
{
    if (!b.report || b.flow.unreachable)
    {
        return Ok(());
    }
    ref<Expr, shared> x = strip_parens_tc(e);
    while (true)
    {
        match (&x.kind)
        {
            ExprKind::EField(f) : x = strip_parens_tc(&Box::get(f).e),
            _                   : break,
        }
    }
    match (vec_element_root(b, it, x))
    {
        Some(p) :
        {
            HashSet<String> through = HashSet::new();
            match (&x.kind)
            {
                ExprKind::EIndex(ib) :
                {
                    ref<Expr, shared> y = strip_parens_tc(&Box::get(ib).a);
                    while (true)
                    {
                        match (&y.kind)
                        {
                            ExprKind::EField(f) : y = strip_parens_tc(&Box::get(f).e),
                            ExprKind::EDeref(d) : y = strip_parens_tc(Box::get(d)),
                            ExprKind::EIndex(p) : y = strip_parens_tc(&Box::get(p).a),
                            ExprKind::EPath(_)  :
                            {
                                match (one_seg(y))
                                {
                                    Some(n) :
                                    {
                                        HashSet::insert(&mut through, String::clone(n));
                                    },
                                    None    : {},
                                }
                                break;
                            },
                            _                   : break,
                        }
                    }
                },
                _                    : {},
            }
            return tier_access(b, it, &p.root, &p.path, mode, &through);
        },
        None    : {},
    }
    Ok(())
}

// D-0282: rules at an assignment. (1) Its place is found before its value
// is computed (D-0007): a value that takes the place's container
// exclusively (`v[0].x = grow(&mut v)`) may move the place, which is a
// conflict decided here. (2) A place that holds a resource is checked,
// when written, for the value it holds: a test of that value (a
// discriminant), with no tracking state: a point check.
fn tier_assign_rules(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> lhs,
    ref<Expr, shared> rhs,
) : Result<void, String>
{
    if (!b.report || b.flow.unreachable)
    {
        return Ok(());
    }
    usize line = b.current_line;
    // The container the place is found in: its root's keys, extended by the
    // fields from the root to the root-most index (`p.cpu.r` of
    // `p.cpu.r[0]`); only a value taking that or a place around it
    // exclusively may move the element. Through a dereference, the whole
    // referent.
    ref<Expr, shared> base = strip_parens_tc(lhs);
    bool elem = false;
    Vec<String> fields = Vec::new();
    while (true)
    {
        match (&base.kind)
        {
            ExprKind::EField(f)  :
            {
                Vec::push(&mut fields, String::clone(&Box::get(f).name));
                base = strip_parens_tc(&Box::get(f).e);
            },
            ExprKind::EDeref(x)  :
            {
                Vec::clear(&mut fields);
                base = strip_parens_tc(Box::get(x));
            },
            ExprKind::EIndex(p)  :
            {
                elem = true;
                Vec::clear(&mut fields);
                base = strip_parens_tc(&Box::get(p).a);
            },
            ExprKind::ECall(cb)  :
            {
                // `*Vec::index_exclusive(&mut v, i) = …`
                ref<CallExpr, shared> c = Box::get(cb);
                bool indexer = match (path_segs(&c.callee))
                {
                    Some(segs) : Vec::len(segs) > 0 && String::starts_with(&segs[Vec::len(segs) - 1], "index"),
                    None       : false,
                };
                if (indexer && Vec::len(&c.args) > 0)
                {
                    elem = true;
                    Vec::clear(&mut fields);
                    base = strip_parens_tc(&c.args[0]);
                }
                else
                {
                    break;
                }
            },
            ExprKind::EBorrow(x) : base = strip_parens_tc(&Box::get(x).e),
            _                    : break,
        }
    }
    Vec<DerivFact> through_elem = Vec::new();
    if (elem)
    {
        through_elem = Option::unwrap_or(inherited_facts(b, it, base, 0), Vec::new());
        for (usize i = 0; i < Vec::len(&through_elem); i += 1)
        {
            for (usize k = Vec::len(&fields); k > 0; k -= 1)
            {
                Vec::push(&mut through_elem[i].key.path, PElem::PField(String::clone(&fields[k - 1])));
            }
        }
    }
    if (Vec::len(&through_elem) > 0)
    {
        Vec<DerivKey> excl = Vec::new();
        Vec<Expr> bs = Vec::new();
        excl_borrows_in(rhs, &mut bs);
        for (usize i = 0; i < Vec::len(&bs); i += 1)
        {
            match (inherited_facts(b, it, &bs[i], 0))
            {
                Some(v) :
                {
                    for (usize k = 0; k < Vec::len(&v); k += 1)
                    {
                        Vec::push(&mut excl, clone(&v[k].key));
                    }
                },
                None    : {},
            }
        }
        for (usize i = 0; i < Vec::len(&through_elem); i += 1)
        {
            ref<DerivKey, shared> k = &through_elem[i].key;
            for (usize x = 0; x < Vec::len(&excl); x += 1)
            {
                if (String::eq(&excl[x].root, &k.root) && overlap3(&excl[x].path, &k.path) != Ov::OvNo)
                {
                    String msg = sprintf(
                        "the place is found before the value is computed, and the value takes `%s` exclusively, which may move the place (evaluation order, D-0007)",
                        shown_name(String::as_view(&k.root)),
                    );
                    return refute(b, &named_diag("diag.stale-binding", &msg));
                }
            }
        }
    }
    bool res_place = match (static_place_type(b, it, lhs))
    {
        Some(t) : is_resource_ty(it, &t),
        None    : false,
    };
    if (res_place)
    {
        b.rep.point_checks += 1;
        Vec::push(&mut b.rep.events, sprintf("P\t%v\tresource place written: its value is tested", line));
    }
    Ok(())
}

// Whether a call argument may be or hold a reference: a borrow, a slice,
// or a value whose type may hold one (unknown types may).
fn arg_may_be_reference(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> a) : bool
{
    match (&strip_parens_tc(a).kind)
    {
        ExprKind::EBorrow(_)  : true,
        ExprKind::ESliceOf(_) : true,
        ExprKind::EInt(_)     : false,
        ExprKind::EBool(_)    : false,
        _ : match (shape_or_place(b, it, a))
        {
            Some(t) : is_borrow_ty(&t) || may_hold_ref(it, &t, 0),
            None    : true,
        },
    }
}

// The bindings a reference argument is formed through (`r` in `&mut r.x`,
// `Vec::index_shared(&*r, 0)`, `r` itself): reaching through them is not
// a conflict with them. A binding named only in an index or a value
// argument is checked as any other holder.
fn roots_in(ref<Expr, shared> e, ref<HashSet<String>, exclusive> out)
{
    match (&e.kind)
    {
        ExprKind::EPath(_) : match (one_seg(e))
        {
            Some(n) :
            {
                HashSet::insert(out, String::clone(n));
            },
            None    : {},
        },
        ExprKind::EParen(x)   : roots_in(Box::get(x), out),
        ExprKind::EDeref(x)   : roots_in(Box::get(x), out),
        ExprKind::EField(f)   : roots_in(&Box::get(f).e, out),
        ExprKind::EBorrow(x)  : roots_in(&Box::get(x).e, out),
        ExprKind::EIndex(p)   : roots_in(&Box::get(p).a, out),
        ExprKind::ESliceOf(s) : roots_in(&Box::get(s).base, out),
        // A call on a reference (D-0011): its reference arguments, not its
        // values (`String::view(&s, h.lo, h.hi)` reaches through `s`, not
        // `h`).
        ExprKind::ECall(cb)   :
        {
            ref<Vec<Expr>, shared> xs = &Box::get(cb).args;
            for (usize i = 0; i < Vec::len(xs); i += 1)
            {
                bool follow = match (&strip_parens_tc(&xs[i]).kind)
                {
                    ExprKind::EBorrow(_)  : true,
                    ExprKind::ESliceOf(_) : true,
                    ExprKind::EPath(_)    : true,
                    ExprKind::ECall(_)    : true,
                    _                     : false,
                };
                if (follow)
                {
                    roots_in(&xs[i], out);
                }
            }
        },
        _                     : {},
    }
}

// What a call reaches through one argument (`tier_call_rule`).
struct Access
{
    usize idx;
    Option<String> holder;
    Vec<DerivKey> whole;
    Vec<DerivKey> proj;
    // The summary's field path of each `proj` key (D-0283's point check
    // extends the argument's place by it).
    Vec<Vec<String>> fields;
    // The whole keys whose facts hold on some paths only (`?`): a conflict
    // through them is the run's to decide.
    Vec<Place> unsure;
}

fn is_borrow_or_slice_expr(ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EBorrow(_)  : true,
        ExprKind::ESliceOf(_) : true,
        _                     : false,
    }
}

fn borrow_expr_mode(ref<Expr, shared> e) : Option<Mode>
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EBorrow(x)  : Some(Box::get(x).mode),
        ExprKind::ESliceOf(x) : Some(Box::get(x).mode),
        _                     : None,
    }
}

fn is_type_param(ref<Type, shared> t, ref<Vec<String>, shared> type_params) : bool
{
    match (t)
    {
        Type::TNamed(nb) : Vec::len(&Box::get(nb).args) == 0 && Vec::contains(type_params, &Box::get(nb).name),
        _                : false,
    }
}

fn shared_ref_param(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(x)   : Box::get(x).mode == Mode::Shared,
        Type::TSlice(x) : Box::get(x).mode == Mode::Shared,
        _               : false,
    }
}

// Whether some live holder other than `h` holds a fact rooted at `*h`.
fn kept_alive_through(ref<Body, shared> b, ref<String, shared> h) : bool
{
    String rh = referent_root(String::as_view(h));
    for (usize i = 0; i < HashMap::len(&b.flow.deriv); i += 1)
    {
        ref<String, shared> o = HashMap::key_at(&b.flow.deriv, i);
        if (String::eq(o, h) || !rep_live_after(&b.rep, String::as_view(o), b.current_line, b.current_col))
        {
            continue;
        }
        ref<HashMap<String, DerivFact>, shared> fs = HashMap::value_at(&b.flow.deriv, i);
        for (usize k = 0; k < HashMap::len(fs); k += 1)
        {
            if (String::eq(&HashMap::value_at(fs, k).key.root, &rh))
            {
                return true;
            }
        }
    }
    false
}

fn point_check(
    usize arg,
    ref<Vec<String>, shared> fields,
    Mode mode,
    PointOther other,
    Mode other_mode,
    StringView callee,
) : PointCheck
{
    PointCheck { .arg = arg, .fields = clone(fields), .mode = mode, .other = other, .other_mode = other_mode, .callee = String::from_view(callee) }
}

// D-0282: the call-site rule. Each argument that is or holds a reference
// reaches places of this frame (its *whole* keys, in its parameter's
// mode). The callee's access summary says what it does through that
// parameter (its *projected* keys). A live holder of the caller conflicts
// with what the callee does (use-time, D-0018); two arguments conflict
// when what is done through one meets the other's whole referent, which
// lives for the call. A certain conflict is reported as the static pass
// reports one; one that depends on values (an index, a range) is a point
// check.
fn tier_call_rule(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> callee,
    ref<Vec<Expr>, shared> args,
) : Result<void, String>
{
    if (!b.report || b.flow.unreachable)
    {
        return Ok(());
    }
    // An argument that reads a reference binding is a copy of it: a later
    // argument that assigns the binding leaves that copy with no name, so
    // what it reaches is the run's to check.
    for (usize i = 1; i < Vec::len(args); i += 1)
    {
        Vec<String> assigned = Vec::new();
        assigned_names(&args[i], &mut assigned);
        if (Vec::len(&assigned) == 0)
        {
            continue;
        }
        bool read = false;
        for (usize k = 0; k < i && !read; k += 1)
        {
            read = mentions_one_of(&args[k], &assigned);
        }
        if (!read)
        {
            continue;
        }
        for (usize k = 0; k < Vec::len(&assigned); k += 1)
        {
            bool holds = match (HashMap::get(&b.gamma, &assigned[k]))
            {
                Some(t) : holds_ref(it, t),
                None    : false,
            };
            if (holds)
            {
                rep_left(
                    b,
                    sprintf(
                        "line %v: an argument assigns `%s` after an earlier one read it",
                        b.current_line,
                        &assigned[k],
                    ),
                );
                break;
            }
        }
    }
    // A reference argument is formed before the later arguments are
    // computed (D-0007). One of them that takes its root exclusively,
    // assigns into it or moves it may move what it reaches (`set(&mut
    // v[0], grow(&mut v))`): the run's stale-binding check decides. Only an
    // argument that is or holds a reference is formed early: a value
    // (`f(x, g(x))`, `q.flag`) is copied and reaches nothing. A later
    // argument that is itself a borrow is formed in place, after which the
    // call is made: two borrows that meet are the call-site rule's below;
    // only what its operand runs first (an index, a call) can act, and
    // only on a place that overlaps what was reached.
    for (usize i = 0; i + 1 < Vec::len(args); i += 1)
    {
        if (!arg_may_be_reference(b, it, &args[i]))
        {
            continue;
        }
        Vec<DerivFact> facts = match (inherited_facts(b, it, &args[i], 0))
        {
            Some(v) : v,
            None    : continue,
        };
        Vec<String> roots = Vec::new();
        for (usize k = 0; k < Vec::len(&facts); k += 1)
        {
            Vec::push(&mut roots, String::clone(&facts[k].key.root));
        }
        if (Vec::len(&roots) == 0)
        {
            continue;
        }
        bool acts = false;
        for (usize j = i + 1; j < Vec::len(args); j += 1)
        {
            ref<Expr, shared> a = strip_parens_tc(&args[j]);
            Vec<Expr> bs = Vec::new();
            match (&a.kind)
            {
                ExprKind::EBorrow(x)  : excl_borrows_in(&Box::get(x).e, &mut bs),
                ExprKind::ESliceOf(s) :
                {
                    excl_borrows_in(&Box::get(s).base, &mut bs);
                    excl_borrows_in(&Box::get(s).lo, &mut bs);
                    excl_borrows_in(&Box::get(s).hi, &mut bs);
                },
                _                     : excl_borrows_in(a, &mut bs),
            }
            for (usize x = 0; x < Vec::len(&bs); x += 1)
            {
                match (inherited_facts(b, it, &bs[x], 0))
                {
                    Some(v) :
                    {
                        for (usize k = 0; k < Vec::len(&v) && !acts; k += 1)
                        {
                            for (usize f = 0; f < Vec::len(&facts) && !acts; f += 1)
                            {
                                acts = String::eq(
                                    &facts[f].key.root,
                                    &v[k].key.root,
                                ) && overlap3(&facts[f].key.path, &v[k].key.path) != Ov::OvNo;
                            }
                        }
                    },
                    None    : {},
                }
            }
            if (acts_on(a, &roots))
            {
                acts = true;
            }
        }
        if (acts)
        {
            rep_left(
                b,
                sprintf("line %v: a later argument acts on what an earlier reference argument reaches", b.current_line),
            );
            break;
        }
    }
    // A call through a local `fn` value: whether it was emptied (moved
    // from) is a test of the value itself, a point check.
    match (one_seg(callee))
    {
        Some(n) :
        {
            bool fn_local = match (HashMap::get(&b.gamma, n))
            {
                Some(Type::TFn(_))      : true,
                Some(Type::TClosure(_)) : true,
                _                       : false,
            };
            if (fn_local)
            {
                usize line = b.current_line;
                b.rep.point_checks += 1;
                Vec::push(&mut b.rep.events, sprintf("P\t%v\tfn value called: its state is tested", line));
            }
        },
        None    : {},
    }
    // `drop(*r)` and the like: moved out through a reference.
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        ref<Expr, shared> a = &args[i];
        match (&strip_parens_tc(a).kind)
        {
            ExprKind::EDeref(inner) : match (one_seg(strip_parens_tc(Box::get(inner))))
            {
                Some(n) :
                {
                    bool moves = match (static_place_type(b, it, a))
                    {
                        Some(t) : is_resource_ty(
                            it,
                            &t,
                        ) || named_is(&t, "std::Atomic") || named_is(&t, "std::Vec") || named_is(&t, "std::String"),
                        None : false,
                    };
                    bool is_ref = match (HashMap::get(&b.gamma, n))
                    {
                        Some(Type::TRef(_)) : true,
                        _                   : false,
                    };
                    if (moves && is_ref)
                    {
                        String msg = sprintf("`*%s` cannot be moved out: `%s` still refers to it", n, n);
                        return refute(
                            b,
                            &sprintf("%s%s", &named_diag("diag.move-while-aliased", &msg), &diag_at(a.line, a.col)),
                        );
                    }
                },
                None    : {},
            },
            _ : {},
        }
    }
    String key = match (resolve_fn_path(it, callee))
    {
        Some(k) : k,
        None    : return Ok(()),
    };
    ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &key), "a function");
    HashSet<String> through = HashSet::new();
    for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(args); i += 1)
    {
        ref<Type, shared> pt = &f.params[i].ty;
        // A type parameter's argument counts only when its value is or
        // holds a reference (`*r` given to `Vec::push` is a copy).
        bool generic_ref = is_type_param(
            pt,
            &f.type_params,
        ) && (is_borrow_or_slice_expr(&args[i]) || match (shape_or_place(b, it, &args[i]))
        {
            Some(t) : is_borrow_ty(&t) || holds_ref(it, &t),
            None    : false,
        });
        if (is_borrow_ty(pt) || holds_ref(it, pt) || generic_ref)
        {
            roots_in(&args[i], &mut through);
        }
    }
    ref<Summaries, shared> sums = Option::expect(match (&it.tier_summaries)
    {
        Some(s) : Some(s),
        None    : None,
    }, "the access summaries");
    Vec<Access> accesses = Vec::new();
    for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(args); i += 1)
    {
        ref<Type, shared> pt = &f.params[i].ty;
        ref<Expr, shared> a = strip_parens_tc(&args[i]);
        Mode mode = match (pt)
        {
            Type::TRef(x)   : Box::get(x).mode,
            Type::TSlice(x) : Box::get(x).mode,
            _               :
            {
                if (holds_ref(it, pt))
                {
                    Mode::Shared
                }
                else if (is_type_param(pt, &f.type_params))
                {
                    // A type parameter: the argument's own value, when it is
                    // or holds a reference (a number is copied).
                    match (borrow_expr_mode(a))
                    {
                        // `&x` given to `T b`: `T` is the borrow's type.
                        Some(m) : m,
                        None : match (shape_or_place(b, it, a))
                        {
                            Some(t) : if (is_borrow_ty(&t) || holds_ref(it, &t)) { Mode::Shared } else { continue },
                            None    : continue,
                        },
                    }
                }
                else
                {
                    continue
                }
            },
        };
        Option<String> holder = match (one_seg(a))
        {
            Some(n) : if (flow_is_tracked(&b.flow, n)) { Some(String::clone(n)) } else { None },
            None    : None,
        };
        Vec<DerivKey> whole = Vec::new();
        Vec<Place> unsure = Vec::new();
        match (&holder)
        {
            Some(h) :
            {
                bool refish = match (HashMap::get(&b.gamma, h))
                {
                    Some(Type::TRef(_))   : true,
                    Some(Type::TSlice(_)) : true,
                    Some(t)               : holds_ref(it, t),
                    None                  : false,
                };
                if (!refish)
                {
                    continue; // a value passed by copy or move
                }
                Vec::push(
                    &mut whole,
                    DerivKey { .root = referent_root(String::as_view(h)), .path = Vec::new(), .mode = mode },
                );
                Vec<DerivFact> fs = facts_of(b, h, false);
                for (usize k = 0; k < Vec::len(&fs); k += 1)
                {
                    Vec::push(
                        &mut whole,
                        DerivKey { .root = String::clone(&fs[k].key.root), .path = clone(&fs[k].key.path), .mode = mode },
                    );
                    if (fs[k].v == Tri::U)
                    {
                        Vec::push(
                            &mut unsure,
                            Place { .root = String::clone(&fs[k].key.root), .path = clone(&fs[k].key.path) },
                        );
                    }
                }
            },
            None : match (inherited_facts(b, it, a, 0))
            {
                Some(v) :
                {
                    for (usize k = 0; k < Vec::len(&v); k += 1)
                    {
                        if (String::eq_str(&v[k].key.root, "<tier D>"))
                        {
                            continue;
                        }
                        if (v[k].v == Tri::U)
                        {
                            Vec::push(
                                &mut unsure,
                                Place { .root = String::clone(&v[k].key.root), .path = clone(&v[k].key.path) },
                            );
                        }
                        Vec::push(
                            &mut whole,
                            DerivKey { .root = String::clone(&v[k].key.root), .path = clone(&v[k].key.path), .mode = mode },
                        );
                    }
                },
                None    : {},
            },
        }
        if (Vec::len(&whole) == 0)
        {
            continue;
        }
        // D-0290: what the references kept where an argument reaches reach
        // (a holder's facts, `**q` through a parameter `q`): the callee
        // reaches them through it, in no stronger mode. Only references the
        // parameter's referent type can hold are reached through it: none,
        // or shared ones only.
        HashSet<String> tparams = HashSet::new();
        for (usize k = 0; k < Vec::len(&f.type_params); k += 1)
        {
            HashSet::insert(&mut tparams, String::clone(&f.type_params[k]));
        }
        Option<ref<Type, shared>> reach_t = match (pt)
        {
            Type::TRef(x) : if (!mentions_any(
                &Box::get(x).inner,
                &tparams,
            )) { Some(&Box::get(x).inner) } else { None },
            Type::TSlice(x) : if (!mentions_any(
                &Box::get(x).inner,
                &tparams,
            )) { Some(&Box::get(x).inner) } else { None },
            _ : None,
        };
        bool reach_known = Option::is_some(&reach_t);
        bool reach_any = match (reach_t)
        {
            Some(t) : may_hold_ref(it, t, 0),
            None    : false,
        };
        bool reach_excl = match (reach_t)
        {
            Some(t) : excl_cached(b, it, t),
            None    : false,
        };
        Vec<DerivFact> deep = Vec::new();
        for (usize k = 0; k < Vec::len(&whole); k += 1)
        {
            if (is_holder(b, it, &whole[k].root))
            {
                HashSet::insert(&mut through, String::clone(&whole[k].root));
            }
            if (reach_known && !reach_any)
            {
                continue;
            }
            match (reach_of_root(b, it, &whole[k].root))
            {
                Some(v) :
                {
                    for (usize x = 0; x < Vec::len(&v); x += 1)
                    {
                        DerivFact d = clone(&v[x]);
                        if (mode == Mode::Shared || (reach_known && !reach_excl))
                        {
                            d.key.mode = Mode::Shared;
                        }
                        Vec::push(&mut deep, d);
                    }
                },
                None    : {},
            }
        }
        // What the callee does through this parameter.
        Vec<DerivKey> proj = Vec::new();
        Vec<Vec<String>> fields = Vec::new();
        bool by_summary = match (pt)
        {
            Type::TRef(_)   : true,
            Type::TSlice(_) : true,
            _               : false,
        };
        Option<ref<ParamAccess, shared>> acc = if (by_summary) { summary_param(sums, &key, i) } else { None };
        match (acc)
        {
            Some(ac) :
            {
                bool shared_param = shared_ref_param(pt);
                for (usize k = 0; k < Vec::len(&whole); k += 1)
                {
                    for (usize w = 0; w < Vec::len(&ac.writes); w += 1)
                    {
                        DerivKey q = clone(&whole[k]);
                        // Through a shared parameter a write is interior
                        // mutability (`Atomic`, a guard): still shared.
                        q.mode = if (shared_param) { Mode::Shared } else { Mode::Exclusive };
                        for (usize x = 0; x < Vec::len(&ac.writes[w]); x += 1)
                        {
                            Vec::push(&mut q.path, PElem::PField(String::clone(&ac.writes[w][x])));
                        }
                        Vec::push(&mut proj, q);
                        Vec::push(&mut fields, clone(&ac.writes[w]));
                    }
                    for (usize r = 0; r < Vec::len(&ac.reads); r += 1)
                    {
                        DerivKey q = clone(&whole[k]);
                        q.mode = Mode::Shared;
                        for (usize x = 0; x < Vec::len(&ac.reads[r]); x += 1)
                        {
                            Vec::push(&mut q.path, PElem::PField(String::clone(&ac.reads[r][x])));
                        }
                        Vec::push(&mut proj, q);
                        Vec::push(&mut fields, clone(&ac.reads[r]));
                    }
                }
            },
            None     :
            {
                proj = clone(&whole);
                for (usize k = 0; k < Vec::len(&whole); k += 1)
                {
                    Vec::push(&mut fields, Vec::new());
                }
            },
        }
        for (usize k = 0; k < Vec::len(&deep); k += 1)
        {
            if (deep[k].v != Tri::T)
            {
                Vec::push(
                    &mut unsure,
                    Place { .root = String::clone(&deep[k].key.root), .path = clone(&deep[k].key.path) },
                );
            }
            Vec::push(&mut whole, clone(&deep[k].key));
            Vec::push(&mut proj, clone(&deep[k].key));
            Vec::push(&mut fields, Vec::new());
        }
        Vec::push(
            &mut accesses,
            Access { .idx = i, .holder = holder, .whole = whole, .proj = proj, .fields = fields, .unsure = unsure },
        );
    }
    Vec<String> point_checks = Vec::new();
    String site = site_key(callee.line, callee.col);
    Vec<PointCheck> pcs = Vec::new();
    StringView shown_key = shown_callee(String::as_view(&key));
    // What the callee does, against the caller's live holders. An argument
    // that is a visible borrow is checked against them where it is formed
    // (`rule.control.flow-analysis`), which refutes every conflict this
    // would, and names the borrow.
    Vec<String> hs = holder_names(b);
    for (usize ai = 0; ai < Vec::len(&accesses); ai += 1)
    {
        ref<Access, shared> acc = &accesses[ai];
        if (is_borrow_or_slice_expr(&args[acc.idx]))
        {
            continue;
        }
        for (usize pi = 0; pi < Vec::len(&acc.proj); pi += 1)
        {
            ref<DerivKey, shared> k = &acc.proj[pi];
            ref<Vec<String>, shared> kf = &acc.fields[pi];
            for (usize hi = 0; hi < Vec::len(&hs); hi += 1)
            {
                ref<String, shared> h = &hs[hi];
                bool is_own = false;
                bool same_path = false;
                match (&acc.holder)
                {
                    Some(ah) :
                    {
                        is_own = String::eq(ah, h);
                        same_path = String::eq(&path_id(b, ah), &path_id(b, h));
                    },
                    None     : {},
                }
                bool another = false;
                for (usize x = 0; x < Vec::len(&accesses) && !another; x += 1)
                {
                    another = match (&accesses[x].holder)
                    {
                        Some(xh) : String::eq(xh, h),
                        None     : false,
                    };
                }
                if (is_own || same_path || HashSet::contains(&through, h) || another)
                {
                    continue;
                }
                // A tier-D holder's conflicts are the run's to check; a
                // holder of this frame's are not (D-0290).
                bool tier_d = match (HashMap::get(&b.gamma, h))
                {
                    Some(t) : tier_d_type(it, t),
                    None    : false,
                };
                if (tier_d && !is_holder(b, it, h))
                {
                    continue;
                }
                // A holder past its last use has ended (D-0111) -- as are
                // the holders only it keeps alive: one rooted at its
                // referent is checked through it.
                if (!rep_live_after(
                    &b.rep,
                    String::as_view(h),
                    b.current_line,
                    b.current_col,
                ) && !kept_alive_through(b, h))
                {
                    continue;
                }
                Vec<DerivFact> facts = facts_of(b, h, false);
                for (usize fi = 0; fi < Vec::len(&facts); fi += 1)
                {
                    ref<DerivFact, shared> d = &facts[fi];
                    if (d.v == Tri::F || !String::eq(&d.key.root, &k.root) || permitted(k.mode, d.key.mode))
                    {
                        continue;
                    }
                    bool sure = d.v == Tri::T && !unsure_covers(&acc.unsure, k);
                    match (overlap3(&d.key.path, &k.path))
                    {
                        Ov::OvNo    : {},
                        Ov::OvMaybe :
                        {
                            Vec::push(
                                &mut point_checks,
                                sprintf("P\t%v\t%s\t%s", b.current_line, shown_name(String::as_view(&k.root)), h),
                            );
                            Vec::push(
                                &mut pcs,
                                point_check(
                                    acc.idx,
                                    kf,
                                    k.mode,
                                    PointOther::Holder(String::clone(h)),
                                    d.key.mode,
                                    shown_key,
                                ),
                            );
                        },
                        Ov::OvYes   :
                        {
                            if (!sure)
                            {
                                Vec::push(
                                    &mut point_checks,
                                    sprintf(
                                        "P\t%v\t%s\t%s (on some paths)",
                                        b.current_line,
                                        shown_name(String::as_view(&k.root)),
                                        h,
                                    ),
                                );
                                Vec::push(
                                    &mut pcs,
                                    point_check(
                                        acc.idx,
                                        kf,
                                        k.mode,
                                        PointOther::Holder(String::clone(h)),
                                        d.key.mode,
                                        shown_key,
                                    ),
                                );
                            }
                            else
                            {
                                String msg = sprintf(
                                    "`%s` %s `%s` through argument %v while %s still borrows `%s`; end that borrow first",
                                    shown_key,
                                    shown_access(k.mode),
                                    &shown_place(String::as_view(&k.root), &k.path),
                                    acc.idx + 1,
                                    &holder_text(String::as_view(h)),
                                    &shown_place(String::as_view(&d.key.root), &d.key.path),
                                );
                                return refute(b, &named_diag("diag.aliasing-conflict", &msg));
                            }
                        },
                    }
                }
            }
        }
    }
    // Between the arguments.
    bool swap = String::eq_str(&key, "std::swap") || String::eq_str(&key, "std::swap_places");
    for (usize ai = 0; ai < Vec::len(&accesses); ai += 1)
    {
        for (usize bi = ai + 1; bi < Vec::len(&accesses); bi += 1)
        {
            ref<Access, shared> a = &accesses[ai];
            ref<Access, shared> c = &accesses[bi];
            // `[Swap-Places]`: a place swapped with itself is no conflict.
            if (swap && Vec::len(args) == 2 && same_place(&args[0], &args[1]))
            {
                continue;
            }
            // One reference passed twice, or a copy of it beside it: one
            // path, which does not conflict with itself.
            match (&a.holder)
            {
                Some(x) : match (&c.holder)
                {
                    Some(y) :
                    {
                        if (local_is_ref(b, x) && local_is_ref(b, y) && String::eq(&path_id(b, x), &path_id(b, y)))
                        {
                            continue;
                        }
                    },
                    None    : {},
                },
                None : {},
            }
            // Each pair: what the callee does through one argument (`x`,
            // with its summary fields), the other's whole referent (`y`).
            for (usize side = 0; side < 2; side += 1)
            {
                ref<Access, shared> p = if (side == 0) { a } else { c };
                ref<Access, shared> q = if (side == 0) { c } else { a };
                for (usize pi = 0; pi < Vec::len(&p.proj); pi += 1)
                {
                    ref<DerivKey, shared> x = &p.proj[pi];
                    ref<Vec<String>, shared> xf = &p.fields[pi];
                    for (usize qi = 0; qi < Vec::len(&q.whole); qi += 1)
                    {
                        ref<DerivKey, shared> y = &q.whole[qi];
                        if (!String::eq(&x.root, &y.root) || permitted(x.mode, y.mode))
                        {
                            continue;
                        }
                        bool unsure = unsure_covers(
                            &a.unsure,
                            x,
                        ) || unsure_covers(&c.unsure, x) || unsure_covers(&a.unsure, y) || unsure_covers(&c.unsure, y);
                        // `[Swap-Places]`: the two places of a `swap`, of
                        // one type, are one place (no conflict) or disjoint;
                        // the values deciding which needs no check.
                        match (overlap3(&x.path, &y.path))
                        {
                            Ov::OvNo    : {},
                            Ov::OvMaybe :
                            {
                                if (!swap)
                                {
                                    Vec::push(
                                        &mut point_checks,
                                        sprintf(
                                            "P\t%v\t%s\targuments %v and %v",
                                            b.current_line,
                                            shown_name(String::as_view(&x.root)),
                                            a.idx + 1,
                                            c.idx + 1,
                                        ),
                                    );
                                    Vec::push(
                                        &mut pcs,
                                        point_check(p.idx, xf, x.mode, PointOther::Arg(q.idx), y.mode, shown_key),
                                    );
                                }
                            },
                            Ov::OvYes   :
                            {
                                if (swap && unsure)
                                {
                                    continue;
                                }
                                if (unsure)
                                {
                                    Vec::push(
                                        &mut point_checks,
                                        sprintf(
                                            "P\t%v\t%s\targuments %v and %v (on some paths)",
                                            b.current_line,
                                            shown_name(String::as_view(&x.root)),
                                            a.idx + 1,
                                            c.idx + 1,
                                        ),
                                    );
                                    Vec::push(
                                        &mut pcs,
                                        point_check(p.idx, xf, x.mode, PointOther::Arg(q.idx), y.mode, shown_key),
                                    );
                                }
                                else
                                {
                                    String msg = if (x.mode == Mode::Exclusive)
                                    {
                                        sprintf(
                                            "`%s` writes `%s` through argument %v, which argument %v also reaches",
                                            shown_key,
                                            &shown_place(String::as_view(&x.root), &x.path),
                                            p.idx + 1,
                                            q.idx + 1,
                                        )
                                    }
                                    else
                                    {
                                        sprintf(
                                            "`%s` reads `%s` through argument %v, which argument %v reaches exclusively",
                                            shown_key,
                                            &shown_place(String::as_view(&x.root), &x.path),
                                            p.idx + 1,
                                            q.idx + 1,
                                        )
                                    };
                                    return refute(b, &named_diag("diag.aliasing-conflict", &msg));
                                }
                            },
                        }
                    }
                }
            }
        }
    }
    if (rep_in_trusted(b))
    {
        return Ok(());
    }
    if (Vec::len(&pcs) > 0)
    {
        b.point_check_fn = true;
    }
    // In the order they were found (Rust's `for pc in pcs`).
    Vec::reverse(&mut pcs);
    while (true)
    {
        match (Vec::pop(&mut pcs))
        {
            Some(pc) : record_point_check(b, String::clone(&site), pc),
            None     : break,
        }
    }
    if (Vec::len(&point_checks) > 0)
    {
        Vec::sort(&mut point_checks);
        Vec<String> deduped = Vec::new();
        for (usize i = 0; i < Vec::len(&point_checks); i += 1)
        {
            if (i == 0 || !String::eq(&point_checks[i], &point_checks[i - 1]))
            {
                Vec::push(&mut deduped, String::clone(&point_checks[i]));
            }
        }
        usize line = b.current_line;
        b.rep.point_checks += Vec::len(&deduped);
        Vec::append(&mut b.rep.events, deduped);
        rep_left(b, sprintf("line %v: a call checked when it is made (D-0283)", line));
    }
    Ok(())
}

// D-0289: the call that takes a handle out of a `Vec` of them in `e`
// (`Vec::pop(&mut hs)`, through `Option::unwrap`) has its result bound
// here, where the handle's facts follow it.
fn mark_taken(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e)
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::ECall(cb) :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            if (is_std_fn_in(it, &c.callee, &["std::Option::unwrap", "std::Option::expect"][0..$]))
            {
                if (Vec::len(&c.args) > 0)
                {
                    mark_taken(b, it, &c.args[0]);
                }
            }
            else
            {
                HashSet::insert(&mut b.taken_handles, site_key(c.callee.line, c.callee.col));
            }
        },
        _                   : {},
    }
}

// D-0290: for each argument `&mut a.π` of a call, `a` a holder, what the
// call does to `a`: whether it only adds (`Vec::push`, `insert`) or keeps
// (`len`, `sort`) what `a` holds, and what the other arguments that may
// hold references hold (`None` inside: not known).
struct HolderOp
{
    String n;
    bool adds;
    bool keeps;
    Vec<Option<Vec<DerivFact>>> kept;
}

fn arg_holds(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> a) : bool
{
    match (&strip_parens_tc(a).kind)
    {
        ExprKind::EBorrow(_)  : true,
        ExprKind::ESliceOf(_) : true,
        ExprKind::EInt(_)     : false,
        ExprKind::EBool(_)    : false,
        ExprKind::EFloat(_)   : false,
        ExprKind::EStr(_)     : false,
        ExprKind::EBinary(_)  : false,
        ExprKind::EUnary(_)   : false,
        _ : match (shape_or_place(b, it, a))
        {
            Some(t) : is_borrow_ty(&t) || may_hold_ref(it, &t, 0),
            None    : true,
        },
    }
}

// D-0290: `holder_call_facts`. An exclusive reference to data that keeps
// references and is not a holder of this frame, given beside such an
// argument, may come to keep it: an escape, the run's.
fn holder_call_facts(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> callee,
    ref<Vec<Expr>, shared> args,
) : Vec<HolderOp>
{
    Vec<HolderOp> out = Vec::new();
    if (b.flow.unreachable)
    {
        return out;
    }
    bool report = b.report;
    // Only a call given an exclusive reference can store into data.
    bool any = false;
    for (usize i = 0; i < Vec::len(args) && !any; i += 1)
    {
        any = match (&strip_parens_tc(&args[i]).kind)
        {
            ExprKind::EBorrow(x)  : Box::get(x).mode == Mode::Exclusive,
            ExprKind::ESliceOf(x) : Box::get(x).mode == Mode::Exclusive,
            ExprKind::EPath(_)    : true,
            ExprKind::EField(_)   : true,
            ExprKind::ECall(_)    : true,
            _                     : false,
        };
    }
    if (!any)
    {
        return out;
    }
    // Which `std` operation it is, found once and only for a holder.
    Option<bool> adds_memo = None;
    bool keeps_memo = false;
    for (usize j = 0; j < Vec::len(args); j += 1)
    {
        ref<Expr, shared> a = strip_parens_tc(&args[j]);
        Option<ref<Expr, shared>> inner = None;
        bool excl = match (&a.kind)
        {
            ExprKind::EBorrow(x)  :
            {
                inner = Some(&Box::get(x).e);
                Box::get(x).mode == Mode::Exclusive
            },
            ExprKind::ESliceOf(x) :
            {
                inner = Some(&Box::get(x).base);
                Box::get(x).mode == Mode::Exclusive
            },
            _ : match (shape_or_place(b, it, a))
            {
                Some(Type::TRef(x))    : Box::get(&x).mode == Mode::Exclusive,
                Some(Type::TSlice(x))  : Box::get(&x).mode == Mode::Exclusive,
                Some(Type::TRawptr(_)) : true,
                _                      : false,
            },
        };
        if (!excl)
        {
            continue;
        }
        // The data the reference reaches, and the arguments whose
        // references it can keep.
        Option<Type> referent = match (inner)
        {
            Some(x) : shape_or_place(b, it, x),
            None : match (shape_or_place(b, it, a))
            {
                Some(Type::TRef(x))    : Some(Box::into_inner(x).inner),
                Some(Type::TSlice(x))  : Some(Box::into_inner(x).inner),
                Some(Type::TRawptr(x)) : Some(Box::into_inner(x)),
                _                      : None,
            },
        };
        Option<String> target = match (inner)
        {
            Some(x) : match (store_target(b, x))
            {
                Some(st) :
                {
                    StoreTarget { name, through } = st;
                    if (!through && is_holder(b, it, &name)) { Some(name) } else { None }
                },
                None     : None,
            },
            None : None,
        };
        // Data that keeps no references can keep nothing given beside it.
        bool stores = match (&referent)
        {
            Some(t) : type_kinds(b, it, t).stores,
            None    : true,
        };
        if (Option::is_none(&target) && !stores)
        {
            continue;
        }
        // What each other argument gives that the data can keep.
        Vec<Option<Vec<DerivFact>>> kept = Vec::new();
        for (usize i = 0; i < Vec::len(args); i += 1)
        {
            if (i == j || !arg_holds(b, it, &args[i]))
            {
                continue;
            }
            Option<ref<Type, shared>> rt = match (&referent)
            {
                Some(t) : Some(t),
                None    : None,
            };
            match (kept_from(b, it, rt, &args[i]))
            {
                Some(k) : Vec::push(&mut kept, k),
                None    : {},
            }
        }
        match (target)
        {
            Some(n) :
            {
                bool adds = match (adds_memo)
                {
                    Some(v) : v,
                    None    :
                    {
                        bool v = is_std_fn(it, callee, "std::Vec::push") || is_std_fn(it, callee, "std::Vec::insert");
                        keeps_memo = is_std_fn_in(
                            it,
                            callee,
                            &[
                                "std::Vec::len",
                                "std::Vec::is_empty",
                                "std::Vec::reserve",
                                "std::Vec::capacity",
                                "std::Vec::sort",
                                "std::Vec::sort_by",
                                "std::Vec::reverse",
                                "std::Vec::swap",
                            ][0..$],
                        ) || match (one_seg(callee))
                        {
                            Some(cn) : String::eq_str(
                                cn,
                                "$each_len",
                            ) || String::eq_str(cn, "$each_at") || String::eq_str(cn, "$each_at_mut"),
                            None : false,
                        };
                        adds_memo = Some(v);
                        v
                    },
                };
                Vec::push(&mut out, HolderOp { .n = n, .adds = adds, .keeps = keeps_memo, .kept = kept });
            },
            None    :
            {
                if (Vec::len(&kept) == 0)
                {
                    continue;
                }
                Option<String> own = match (inner)
                {
                    Some(x) : match (store_target(b, x))
                    {
                        Some(st) : Some(sprintf("**%s", &st.name)),
                        None     : None,
                    },
                    None : match (one_seg(a))
                    {
                        Some(n) : Some(sprintf("**%s", n)),
                        None    : None,
                    },
                };
                // Through a parameter, the caller sees what is given.
                bool param = match (&own)
                {
                    Some(o) : HashSet::contains(&b.params, &String::from_view(strip_stars(String::as_view(o)))),
                    None    : false,
                };
                bool inside = true;
                for (usize k = 0; k < Vec::len(&kept) && inside; k += 1)
                {
                    bool ok = param && caller_sees(b, &kept[k]);
                    if (!ok)
                    {
                        ok = match (&kept[k])
                        {
                            None    : true,
                            Some(v) :
                            {
                                bool all = Vec::len(v) > 0;
                                for (usize x = 0; x < Vec::len(v) && all; x += 1)
                                {
                                    all = match (&own)
                                    {
                                        Some(o) : String::eq(&v[x].key.root, o),
                                        None    : false,
                                    };
                                }
                                all
                            },
                        };
                    }
                    inside = ok;
                }
                if (!inside && report)
                {
                    rep_left(
                        b,
                        sprintf(
                            "line %v: a reference may be stored where this frame does not hold it (D-0290)",
                            b.current_line,
                        ),
                    );
                }
            },
        }
    }
    out
}

// D-0290: what data of type `referent` can come to keep of an argument
// `b2` given beside it: the reference `b2` is, when the data keeps that
// kind; what the references kept where `b2` reaches reach, when it keeps
// those (`swap(v, &mut out)` moves `out`'s contents, not `&mut out`); a
// value's own facts. `None`: nothing; `Some(None)`: static data;
// `Some(Some(v))`, `v` empty when not known.
fn kept_from(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    Option<ref<Type, shared>> referent,
    ref<Expr, shared> b2,
) : Option<Option<Vec<DerivFact>>>
{
    Option<Type> given = match (&strip_parens_tc(b2).kind)
    {
        ExprKind::EBorrow(x) : match (shape_or_place(b, it, &Box::get(x).e))
        {
            Some(t) : Some(ref_of(t, Box::get(x).mode)),
            None    : None,
        },
        _ : shape_or_place(b, it, b2),
    };
    HashSet<String> tl = HashSet::new();
    match (referent)
    {
        Some(t) : ref_leaves(it, t, &mut tl, &mut new_name_set()),
        None    : {},
    }
    bool top = true;
    bool deep = true;
    if (Option::is_some(&referent))
    {
        match (&given)
        {
            Some(Type::TRef(x))   :
            {
                top = HashSet::contains(&tl, &ref_leaf(false, &Box::get(x).inner));
                deep = leaves_meet(it, &Box::get(x).inner, &tl);
            },
            Some(Type::TSlice(x)) :
            {
                top = HashSet::contains(&tl, &ref_leaf(true, &Box::get(x).inner));
                deep = leaves_meet(it, &Box::get(x).inner, &tl);
            },
            Some(t)               :
            {
                top = leaves_meet(it, t, &tl);
                deep = false;
            },
            None                  : {},
        }
    }
    if (!top && !deep)
    {
        return None;
    }
    Vec<DerivFact> v = match (inherited_facts(b, it, b2, 0))
    {
        Some(v) : v,
        None    : return Some(None),
    };
    Vec<DerivFact> out = if (top) { clone(&v) } else { Vec::new() };
    if (deep)
    {
        for (usize i = 0; i < Vec::len(&v); i += 1)
        {
            match (reach_of_root(b, it, &v[i].key.root))
            {
                Some(w) :
                {
                    for (usize k = 0; k < Vec::len(&w); k += 1)
                    {
                        DerivFact d = clone(&w[k]);
                        if (v[i].v != Tri::T)
                        {
                            d.v = Tri::U;
                        }
                        Vec::push(&mut out, d);
                    }
                },
                None    :
                {
                    if (!top && data_type_root(b, it, &v[i].key.root))
                    {
                        return Some(Some(Vec::new()));
                    }
                },
            }
        }
    }
    if (Vec::len(&out) == 0 && Vec::len(&v) > 0 && !top)
    {
        return None;
    }
    Some(Some(out))
}

// Whether a reference kept by a value of `t` is one of the leaves `tl`.
fn leaves_meet(ref<Items, shared> it, ref<Type, shared> t, ref<HashSet<String>, shared> tl) : bool
{
    HashSet<String> l = HashSet::new();
    ref_leaves(it, t, &mut l, &mut new_name_set());
    for (usize i = 0; i < HashSet::len(&l); i += 1)
    {
        if (HashSet::contains(tl, HashSet::key_at(&l, i)))
        {
            return true;
        }
    }
    false
}

// Whether the root `root` is a binding whose storage keeps references.
fn data_type_root(ref<Body, shared> b, ref<Items, shared> it, ref<String, shared> root) : bool
{
    String name = String::from_view(strip_stars(String::as_view(root)));
    match (HashMap::get(&b.gamma, &name))
    {
        Some(Type::TRef(x))   : stores_refs(it, &Box::get(x).inner),
        Some(Type::TSlice(x)) : stores_refs(it, &Box::get(x).inner),
        Some(t)               : stores_refs(it, t),
        None                  : true,
    }
}

// D-0290: `holder_call_facts` applied after the call.
fn holder_call(ref<Body, exclusive> b, Vec<HolderOp> ops)
{
    for (usize o = 0; o < Vec::len(&ops); o += 1)
    {
        HolderOp { n, adds, keeps, kept } = clone(&ops[o]);
        if (keeps)
        {
            continue;
        }
        if (!adds)
        {
            match (HashMap::get_mut(&mut b.flow.deriv, &n))
            {
                Some(m) :
                {
                    for (usize k = 0; k < HashMap::len(m); k += 1)
                    {
                        String code = String::clone(HashMap::key_at(m, k));
                        ref<DerivFact, exclusive> d = Option::expect(HashMap::get_mut(m, &code), "a fact");
                        if (d.v == Tri::T)
                        {
                            d.v = Tri::U;
                        }
                    }
                },
                None    : {},
            }
        }
        for (usize i = 0; i < Vec::len(&kept); i += 1)
        {
            match (&kept[i])
            {
                None    : {},
                Some(v) :
                {
                    if (facts_known(v))
                    {
                        Vec<DerivFact> w = through_refs(b, clone(v));
                        if (!adds)
                        {
                            w = all_unsure(w);
                        }
                        add_deriv_tri(b, &n, w);
                    }
                    else if (b.report)
                    {
                        rep_left(
                            b,
                            sprintf(
                                "line %v: what is stored into `%s` holds references not known before the run",
                                b.current_line,
                                &n,
                            ),
                        );
                    }
                },
            }
        }
    }
}

fn check_call(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> callee,
    ref<Vec<Expr>, shared> args,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    tier_call_rule(b, it, callee, args)?;
    Option<String> callee_key = resolve_fn_path(it, callee);
    bool joining = match (path_segs(callee))
    {
        Some(segs) :
        {
            StringView last = String::as_view(&segs[Vec::len(segs) - 1]);
            !(Vec::len(segs) == 1 && is_local(
                b,
                &segs[0],
            )) && (StringView::eq_str(
                last,
                "join",
            ) || StringView::eq_str(last, "drop") || StringView::eq_str(last, "try_join"))
        },
        None       : false,
    };
    if (joining && Vec::len(args) > 0)
    {
        mark_taken(b, it, &args[0]);
    }
    // D-0289: `Vec::push(&mut hs, spawn(…))` binds the spawn as a `let`
    // does: `hs`, a local of this frame, holds what the thread was lent,
    // and so does a handle pushed there.
    Option<HandleHolder> pushed = None;
    bool handing = false;
    if (Vec::len(args) == 2 && key_in(&callee_key, &["std::Vec::push"][0..$]))
    {
        match (&strip_parens_tc(&args[0]).kind)
        {
            ExprKind::EBorrow(bb) :
            {
                if (Box::get(bb).mode == Mode::Exclusive)
                {
                    match (one_seg(strip_parens_tc(&Box::get(bb).e)))
                    {
                        Some(n) :
                        {
                            bool handles = is_local(b, n) && match (HashMap::get(&b.gamma, n))
                            {
                                Some(t) : holds_handle(t),
                                None    : false,
                            };
                            if (handles)
                            {
                                if (is_spawn_call(&args[1]))
                                {
                                    match (&strip_parens_tc(&args[1]).kind)
                                    {
                                        ExprKind::ECall(cb) :
                                        {
                                            HashSet::insert(
                                                &mut b.bound_spawns,
                                                site_key(Box::get(cb).callee.line, Box::get(cb).callee.col),
                                            );
                                        },
                                        _                   : {},
                                    }
                                    String hn = String::clone(n);
                                    Vec<DerivFact> fs = spawn_facts_tri_of(b, it, &args[1]);
                                    pushed = Some(HandleHolder { .name = hn, .facts = fs });
                                }
                                else
                                {
                                    match (handle_holder_of(b, it, &args[1]))
                                    {
                                        Some(hh) :
                                        {
                                            HandleHolder { facts, .. } = hh;
                                            mark_taken(b, it, &args[1]);
                                            handing = true;
                                            pushed = Some(HandleHolder { .name = String::clone(n), .facts = facts });
                                        },
                                        None     : {},
                                    }
                                }
                            }
                        },
                        None    : {},
                    }
                }
            },
            _                     : {},
        }
    }
    // The `Vec` operations that keep a lending handle in this frame.
    String callee_site = site_key(callee.line, callee.col);
    bool keeps = key_in(&callee_key, &[
            "std::Vec::push",
            "std::Vec::len",
            "std::Vec::is_empty",
            "std::Vec::clear",
            "std::Vec::truncate",
            "std::Vec::reserve",
    ][0..$],
    )
        || (key_in(&callee_key, &[
            "std::Vec::pop",
            "std::Vec::remove",
            "std::Vec::swap_remove",
            "std::Drain::take",
        ][0..$],
        ) && HashSet::contains(&b.taken_handles, &callee_site))
        || match (one_seg(callee))
        {
            Some(n) : String::eq_str(
                n,
                "$each_take",
            ) || String::eq_str(n, "$each_take_key") || String::eq_str(n, "$each_len"),
            None : false,
        };
    if (keeps && Vec::len(args) > 0)
    {
        match (&strip_parens_tc(&args[0]).kind)
        {
            ExprKind::EBorrow(bb) :
            {
                if (Box::get(bb).mode == Mode::Exclusive)
                {
                    b.handle_borrow_ok = true;
                }
            },
            _                     : {},
        }
    }
    bool spawn_callee = match (one_seg(callee))
    {
        Some(n) : String::eq_str(n, "spawn") && !is_local(b, n),
        None    : false,
    };
    if (spawn_callee)
    {
        tier_spawn_rule(b, it, callee, args);
    }
    if (HashMap::contains(&b.tail_spawns, &callee_site))
    {
        Expr whole = mk(
            ExprKind::ECall(Box::new(CallExpr { .callee = clone(callee), .args = clone(args) })),
            callee.line,
            callee.col,
        );
        Vec<DerivFact> facts = spawn_facts_tri_of(b, it, &whole);
        usize depth = if (Vec::len(&b.spawn_let_depth) > 0) { b.spawn_let_depth[Vec::len(&b.spawn_let_depth) - 1] } else { 0 };
        HashSet<String> inner = HashSet::new();
        for (usize si = depth; si < Vec::len(&b.scopes); si += 1)
        {
            for (usize k = 0; k < Vec::len(&b.scopes[si]); k += 1)
            {
                HashSet::insert(&mut inner, String::clone(&b.scopes[si][k].name));
            }
        }
        bool seen = true;
        for (usize i = 0; i < Vec::len(&facts) && seen; i += 1)
        {
            ref<String, shared> root = &facts[i].key.root;
            seen = !String::starts_with(
                root,
                "<",
            ) && !HashSet::contains(&inner, &String::from_view(strip_stars(String::as_view(root))));
        }
        HashMap::insert(&mut b.tail_spawns, String::clone(&callee_site), if (seen) { Some(facts) } else { None });
    }
    bool saved_joining = replace(&mut b.joining, joining);
    bool handing2 = handing || b.handing;
    bool saved_handing = replace(&mut b.handing, handing2);
    // D-0290: what a call may store into a holder, found before the
    // arguments are moved.
    Vec<HolderOp> holder_ops = holder_call_facts(b, it, callee, args);
    Result<Option<Type>, String> r = check_call_in(b, it, callee, args, expected);
    b.joining = saved_joining;
    b.handing = saved_handing;
    b.handle_borrow_ok = false;
    if (Result::is_ok(&r))
    {
        holder_call(b, holder_ops);
        match (pushed)
        {
            Some(hh) :
            {
                HandleHolder { name, facts } = hh;
                add_deriv_tri(b, &name, facts);
            },
            None     : {},
        }
    }
    r
}

fn check_call_in(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> callee,
    ref<Vec<Expr>, shared> args,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // Enum variant construction, `Vi(e)`.
    match (&callee.kind)
    {
        ExprKind::EPath(pb) :
        {
            if (Vec::len(args) == 1)
            {
                match (check_variant_call(b, it, &Box::get(pb).segs, &Box::get(pb).targs, args, expected))
                {
                    Some(r) : return r,
                    None    : {},
                }
            }
        },
        _                   : {},
    }
    // `[Resolve-Unqualified]`: a local binding comes before an item, and an
    // item before an intrinsic of the same name.
    bool local_callee = match (path_segs(callee))
    {
        Some(segs) : Vec::len(segs) == 1 && is_local(b, &segs[0]),
        None       : false,
    };
    match (&callee.kind)
    {
        ExprKind::EPath(pb) :
        {
            if (!local_callee)
            {
                return check_named_call(b, it, callee, &Box::get(pb).segs, &Box::get(pb).targs, args, expected);
            }
        },
        _                   : {},
    }
    // The callee is itself an expression (a closure value, etc.).
    Option<usize> arity = match (&callee.kind)
    {
        ExprKind::EClosure(cb) : Some(Vec::len(&Box::get(cb).params)),
        ExprKind::EPath(pb)    :
        {
            if (Vec::len(&Box::get(pb).segs) == 1)
            {
                match (HashMap::get(&b.closure_arity, &Box::get(pb).segs[0]))
                {
                    Some(n) : Some(*n),
                    None    : None,
                }
            }
            else
            {
                None
            }
        },
        _                      : None,
    };
    match (arity)
    {
        Some(n) :
        {
            if (n != Vec::len(args))
            {
                return Err(String::from_str("diag.type-mismatch"));
            }
        },
        None    : {},
    }
    // `[Closure-Call]` of a binding holding a `move` closure that writes a
    // capture: `self` is an exclusive borrow of its place (D-0239, D-0245).
    match (path_segs(callee))
    {
        Some(segs) :
        {
            if (Vec::len(segs) == 1 && HashSet::contains(
                &b.closure_self_writes,
                &segs[0],
            ) && flow_is_tracked(&b.flow, &segs[0]))
            {
                flow_clash_saying(
                    b,
                    it,
                    &segs[0],
                    &Vec::new(),
                    Mode::Exclusive,
                    "diag.aliasing-conflict",
                    Some("so it cannot be called here: the call changes what it captured"),
                )?;
            }
        },
        None       : {},
    }
    Option<Type> ct = check_expr(b, it, callee, &None)?;
    if (is_marker_opt(&ct))
    {
        return Err(unbounded_msg("a call"));
    }
    // Each argument at its parameter's type, as for a named function.
    Vec<Option<Type>> ptys = Vec::new();
    bool fits = match (&ct)
    {
        Some(Type::TFn(fb)) : Vec::len(&Box::get(fb).params) == Vec::len(args),
        _                   : false,
    };
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        if (fits)
        {
            match (&ct)
            {
                Some(Type::TFn(fb)) :
                {
                    ref<Type, shared> p = &Box::get(fb).params[i];
                    Vec::push(&mut ptys, if (has_unresolved_marker(p)) { None } else { Some(clone(p)) });
                },
                _                   : Vec::push(&mut ptys, None),
            }
        }
        else
        {
            Vec::push(&mut ptys, None);
        }
    }
    // `[T-Call]`'s premise for a function value.
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        Option<Type> at = check_store_operand(b, it, &args[i], &ptys[i])?;
        match (&ptys[i])
        {
            Some(pt) : match (&at)
            {
                Some(a) :
                {
                    bool literal_fits = is_numeric_ty(pt);
                    if (!type_eq(
                        pt,
                        a,
                    ) && !weakens_to(
                        a,
                        pt,
                    ) && !is_never(a) && !has_unresolved_marker(a) && !(literal_fits && is_bare_int_literal(&args[i])))
                    {
                        return Err(mismatch(sprintf(
                            "argument %v is `%s`, but the function value's parameter is `%s`%s",
                            i + 1,
                            &type_display(a),
                            &type_display(pt),
                            &conversion_hint(pt, a, Some(&args[i])),
                        )));
                    }
                },
                None    : {},
            },
            None : {},
        }
    }
    // `[T-Call]`: the callee is callable, with one argument per parameter.
    match (ct)
    {
        Some(Type::TFn(fb)) :
        {
            FnTy { params, ret } = Box::into_inner(fb);
            if (Vec::len(&params) != Vec::len(args))
            {
                return Err(String::from_str("diag.type-mismatch"));
            }
            Ok(Some(ret))
        },
        Some(t)             :
        {
            bool not_callable = match (&t)
            {
                Type::TInt(_)    : true,
                Type::TF32       : true,
                Type::TF64       : true,
                Type::TBool      : true,
                Type::TStr       : true,
                Type::TVoid      : true,
                Type::TArray(_)  : true,
                Type::TRawptr(_) : true,
                Type::THandle(_) : true,
                Type::TMutex(_)  : true,
                Type::TGuard(_)  : true,
                Type::TNamed(nb) : !String::starts_with(&Box::get(nb).name, "$"),
                _                : false,
            };
            if (not_callable)
            {
                return Err(String::from_str("diag.type-mismatch"));
            }
            Ok(None)
        },
        None                : Ok(None),
    }
}

fn arg_ty(ref<Vec<Option<Type>>, shared> v, usize k) : Option<Type>
{
    if (k < Vec::len(v)) { clone(&v[k]) } else { None }
}

// A call through a path that is not a local: a function, an extern, or an
// intrinsic.
fn check_named_call(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> callee,
    ref<Vec<String>, shared> segs,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    String name = String::join(&segs[0..$], "::");
    StringView nv = String::as_view(&name);
    match (HashMap::get(&it.fns, &name))
    {
        Some(f) :
        {
            if (is_trusted_std_call(&name) && b.unsafe_depth == 0)
            {
                String msg = sprintf(
                    "`%s` reads through a raw pointer, so it is called inside `unsafe { }`",
                    Option::unwrap_or(String::strip_prefix(&name, "std::"), nv),
                );
                return Err(named_diag("diag.trusted-outside-unsafe", &msg));
            }
            if (String::eq_str(&f.name, "drop") && Option::is_some(&f.assoc_type))
            {
                // spec/07 §1: a destructor is only ever run by `[Destroy]`.
                return Err(String::from_str("diag.direct-destructor-call"));
            }
            return check_user_call(b, it, &name, targs, args, expected);
        },
        None    : {},
    }
    match (HashMap::get(&it.externs, &name))
    {
        Some(ext) :
        {
            if (b.unsafe_depth == 0)
            {
                return Err(String::from_str("diag.trusted-outside-unsafe"));
            }
            if (Vec::len(args) != Vec::len(&ext.params))
            {
                return Err(String::from_str("diag.type-mismatch"));
            }
            for (usize i = 0; i < Vec::len(args); i += 1)
            {
                check_expr(b, it, &args[i], &Some(clone(&ext.params[i].ty)))?;
            }
            return Ok(Some(clone(&ext.ret)));
        },
        None      : {},
    }
    // `std`'s own helpers: not names anywhere else.
    if (is_std_only_intrinsic(nv) && !String::eq_str(&b.module_, "std"))
    {
        return Err(String::from_str("diag.unbound-name"));
    }
    if (is_trusted_intrinsic(nv) && b.unsafe_depth == 0)
    {
        return Err(String::from_str("diag.trusted-outside-unsafe"));
    }
    // A reclaimed object's references are checked by the run against the
    // record of raw storage (`[Reclaim]`), which the static pass does not
    // follow: the program is not decided (D-0284). `std`'s own uses are its
    // containers' bookkeeping.
    if (StringView::eq_str(
        nv,
        "reclaim",
    ) && !String::eq_str(&b.module_, "std") && !String::starts_with(&b.module_, "std::"))
    {
        rep_left(b, sprintf("line %v: a reference to a reclaimed object is checked by the run", b.current_line));
    }
    // WI-15: an intrinsic of a fixed shape called in another.
    match (intrinsic_shape(nv))
    {
        Some(s) :
        {
            if (Vec::len(targs) < s.tmin || Vec::len(targs) > s.tmax || Vec::len(args) < s.amin || Vec::len(args) > s.amax)
            {
                String msg = sprintf("`%s` is written `%s%s`", &name, &name, s.form);
                return Err(named_diag("diag.type-mismatch", &msg));
            }
        },
        None    : {},
    }
    if (StringView::eq_str(nv, "drop") && Vec::len(args) == 1)
    {
        match (root_local_name(&args[0]))
        {
            Some(n) :
            {
                if (HashMap::contains(&b.move_captures, &n))
                {
                    // `drop(self.f_i)`: `[Destroy-Projection]`.
                    return Err(String::from_str("diag.move-out-of-field"));
                }
            },
            None    : {},
        }
        // `[Destroy]` on a place: then the binding is consumed.
        b.place_pos = true;
        check_expr(b, it, &args[0], &None)?;
        match (place_of(b, it, &args[0]))
        {
            Some(p) :
            {
                if (Vec::len(&p.path) == 0)
                {
                    flow_consume(b, it, &p.root, "diag.destroy-while-aliased")?;
                }
                else if (place_is_resource(b, it, &p.root, &p.path))
                {
                    refute(b, &String::from_str("diag.move-out-of-field"))?;
                }
            },
            None    : {},
        }
        return Ok(Some(Type::TVoid));
    }
    if (StringView::eq_str(nv, "fault"))
    {
        // `fault(d)` / `fault(d, message)` (spec/21 §0, D-0083).
        String d = match (if (Vec::len(args) > 0) { path_segs(&args[0]) } else { None })
        {
            Some(ds) :
            {
                if (Vec::len(ds) != 1)
                {
                    return Err(mismatch(String::from_str("`fault` takes a diagnostic's name, as in `fault(index_out_of_bounds)`, and optionally a `str` message")));
                }
                String::clone(&ds[0])
            },
            None     : return Err(mismatch(String::from_str("`fault` takes a diagnostic's name, as in `fault(index_out_of_bounds)`, and optionally a `str` message"))),
        };
        String id = sprintf("diag.%s", &String::replace(&d, "_", "-"));
        if (!is_dynamic_diag(&id))
        {
            String msg = sprintf(
                "`%s` names no run-time fault; `fault` takes a dynamic diagnostic of the registry with `_` for `-`, such as `assert_failed`, `index_out_of_bounds`, `unwrap_failed` or `alloc_failure`",
                &d,
            );
            return Err(named_diag("diag.unbound-name", &msg));
        }
        if (Vec::len(args) > 2)
        {
            return Err(mismatch(String::from_str("`fault` takes a diagnostic's name and at most one `str` message")));
        }
        if (Vec::len(args) > 1)
        {
            Option<Type> t = check_expr(b, it, &args[1], &Some(Type::TStr))?;
            match (&t)
            {
                Some(Type::TStr) : {},
                None             : {},
                _                : return Err(mismatch(String::from_str("`fault`'s message is a `str`"))),
            }
        }
        return Ok(Some(Type::TNever));
    }
    if (StringView::eq_str(nv, "spawn") && !b.flow.unreachable)
    {
        // D-0213: lending `r` to the thread borrows `*r`.
        Vec<DerivKey> lent = spawn_lent_refs(b, it, args);
        for (usize i = 0; i < Vec::len(&lent); i += 1)
        {
            flow_clash(b, it, &lent[i].root, &lent[i].path, lent[i].mode, "diag.aliasing-conflict")?;
        }
    }
    if (StringView::eq_str(nv, "spawn") && Vec::len(args) > 0)
    {
        // `rule.conc.spawn`: the callee is a fn value or a `move` closure.
        bool borrowing = match (&args[0].kind)
        {
            ExprKind::EClosure(cb) : !Box::get(cb).is_move,
            ExprKind::EPath(pb) : Vec::len(&Box::get(pb).segs) == 1 && match (HashMap::get(
                &b.closure_moves,
                &Box::get(pb).segs[0],
            ))
            {
                Some(mv) : !*mv,
                None     : false,
            },
            _                      : false,
        };
        if (borrowing)
        {
            return Err(String::from_str("diag.spawn-borrow-closure"));
        }
    }
    if (StringView::eq_str(nv, "join") && Vec::len(args) == 1)
    {
        // D-0071: the thread has finished; what it borrowed is free.
        match (path_segs(strip_parens_tc(&args[0])))
        {
            Some(hs) :
            {
                if (Vec::len(hs) == 1 && !b.flow.unreachable)
                {
                    HashMap::remove(&mut b.flow.deriv, &hs[0]);
                }
            },
            None     : {},
        }
    }
    if (StringView::eq_str(nv, "Mutex::new") && Vec::len(args) == 1)
    {
        // `Mutex::new<T>(T v) : mutex<T>`, typed as the generic call it is.
        Option<Type> hint = if (Vec::len(targs) > 0)
        {
            Some(apply_subst(&targs[0], &b.subst))
        }
        else
        {
            match (expected)
            {
                Some(Type::TMutex(mb)) : if (!has_unresolved_marker(Box::get(mb))) { Some(clone(Box::get(mb))) } else { None },
                _                      : None,
            }
        };
        Option<Type> t = check_store_operand(b, it, &args[0], &hint)?;
        return Ok(match (or_type(hint, t))
        {
            Some(x) : Some(Type::TMutex(Box::new(x))),
            None    : None,
        });
    }
    if (is_each_name(nv))
    {
        // `foreach` (D-0042): the expansion for the collection's type,
        // checked as the code it is.
        Option<Type> t0 = match (if (Vec::len(args) > 0) { path_segs(&args[0]) } else { None })
        {
            Some(s0) :
            {
                if (Vec::len(s0) == 1)
                {
                    match (HashMap::get(&b.gamma, &s0[0]))
                    {
                        Some(t) : Some(apply_subst(t, &b.subst)),
                        None    : None,
                    }
                }
                else
                {
                    None
                }
            },
            None     : None,
        };
        Type t0v = match (t0)
        {
            Some(t) : if (has_unresolved_marker(&t)) { return Ok(None); } else { t },
            None    : return Ok(None),
        };
        Expr x = each_expand(nv, &t0v, args, callee.line, callee.col)?;
        number_fresh(b, &mut x);
        bool saved = b.privileged;
        b.privileged = true;
        Result<Option<Type>, String> r = check_expr(b, it, &x, expected);
        b.privileged = saved;
        return r;
    }
    if (StringView::eq_str(nv, "std::exit"))
    {
        // `[Exit]` (D-0150): one `u8`; of type `never`.
        if (Vec::len(args) != 1)
        {
            return Err(mismatch(String::from_str("`exit` takes one argument, the program's exit status (a `u8`)")));
        }
        check_expect(b, it, &args[0], &Type::TInt(IntTy::U8))?;
        return Ok(Some(Type::TNever));
    }
    if (StringView::eq_str(nv, "std::print"))
    {
        // `rule.stdlib.print` (spec/21 §2a): one argument, printable.
        if (Vec::len(args) != 1)
        {
            return Err(String::from_str("diag.type-mismatch"));
        }
        Option<Type> t = check_store_operand(b, it, &args[0], &None)?;
        bool printable = match (&t)
        {
            None    : true,
            Some(x) : has_unresolved_marker(x) || is_printable(x),
        };
        return if (printable) { Ok(Some(Type::TVoid)) } else { Err(String::from_str("diag.type-mismatch")) };
    }
    if (StringView::eq_str(nv, "$assert_fail"))
    {
        // `assert` after `modres` (D-0065).
        if (Vec::len(args) > 1)
        {
            return Err(String::from_str("diag.type-mismatch"));
        }
        if (Vec::len(args) == 1)
        {
            check_expect(b, it, &args[0], &Type::TStr)?;
        }
        return Ok(Some(Type::TNever));
    }
    if (StringView::eq_str(nv, "std::assert"))
    {
        // An `assert` `modres` did not rewrite: without a condition.
        return Err(String::from_str("diag.type-mismatch"));
    }
    if (StringView::eq_str(nv, "$fmt"))
    {
        return check_fmt(b, it, args);
    }
    if (StringView::eq_str(nv, "min_value") || StringView::eq_str(nv, "max_value"))
    {
        // `rule.arith.limits` (spec/06 §5a).
        if (Vec::len(args) > 0)
        {
            return Err(String::from_str("diag.type-mismatch"));
        }
        if (Vec::len(targs) == 0)
        {
            return Err(String::from_str("diag.cannot-infer-type-parameter"));
        }
        Type t = apply_subst(&targs[0], &b.subst);
        if (is_numeric_ty(&t) || has_unresolved_marker(&t))
        {
            return Ok(Some(t));
        }
        return Err(String::from_str("diag.type-mismatch"));
    }
    if (StringView::eq_str(nv, "static_assert"))
    {
        return check_static_assert(b, it, args);
    }
    if (!is_intrinsic_name_tc(&name))
    {
        // Not an item, not an intrinsic: resolve it as a name first.
        check_path(b, it, segs)?;
    }
    bool saved = b.infer_poisoned;
    b.infer_poisoned = true;
    // `[T-Alt]`: a bare literal operand of an alternative operation takes
    // its type from the other operand, which is checked first.
    bool alt = is_alt_intrinsic(nv) && Vec::len(args) == 2;
    bool lit_first = alt && is_bare_num_literal(&args[0]) && !is_bare_num_literal(&args[1]);
    Vec<usize> order = Vec::new();
    if (lit_first)
    {
        Vec::push(&mut order, 1);
        Vec::push(&mut order, 0);
    }
    else
    {
        for (usize i = 0; i < Vec::len(args); i += 1)
        {
            Vec::push(&mut order, i);
        }
    }
    Vec<Option<Type>> by_index = Vec::new();
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        Vec::push(&mut by_index, None);
    }
    Result<void, String> r = Ok(());
    for (usize oi = 0; oi < Vec::len(&order); oi += 1)
    {
        usize i = order[oi];
        Option<Type> hint = intrinsic_arg_hint(nv, i, alt, args, &by_index, expected);
        match (check_store_operand(b, it, &args[i], &hint))
        {
            Ok(t)  : by_index[i] = t,
            Err(d) :
            {
                r = Err(d);
                break;
            },
        }
    }
    b.infer_poisoned = saved;
    r?;
    Vec<Option<Type>> arg_tys = by_index;
    // D-0254: the lane-wise intrinsics.
    match (simd_intrinsic_type(nv, targs, &arg_tys)?)
    {
        Some(t) : return Ok(Some(t)),
        None    : {},
    }
    check_integer_intrinsic_operands(b, nv, targs, args, &arg_tys)?;
    return check_intrinsic_result(b, it, nv, targs, args, &arg_tys, alt);
}

// The type an intrinsic's argument `i` is checked at, from the others.
fn intrinsic_arg_hint(
    StringView name,
    usize i,
    bool alt,
    ref<Vec<Expr>, shared> args,
    ref<Vec<Option<Type>>, shared> by_index,
    ref<Option<Type>, shared> expected,
) : Option<Type>
{
    bool simd_two = is_simd_pair_intrinsic(name) || alt;
    if (alt && is_bare_num_literal(&args[i]))
    {
        return match (&by_index[1 - i])
        {
            Some(Type::TInt(t)) : Some(Type::TInt(*t)),
            _                   : None,
        };
    }
    if (simd_two && i == 1 && is_simd_opt(&by_index[0]))
    {
        // D-0254: the second operand of a lane-wise operation is the
        // first one's type.
        return clone(&by_index[0]);
    }
    if ((i == 0 && (StringView::eq_str(
        name,
        "simd_min",
    ) || StringView::eq_str(name, "simd_max"))) || (i == 1 && StringView::eq_str(name, "simd_select")))
    {
        return if (is_simd_opt(expected)) { clone(expected) } else { None };
    }
    if (StringView::eq_str(name, "simd_select") && i == 2)
    {
        return if (is_simd_opt(&by_index[1])) { clone(&by_index[1]) } else { None };
    }
    if (StringView::eq_str(name, "simd_store") && i == 2)
    {
        // A literal vector stored into a slice of `τ` is a `simd<τ, N>`.
        Option<u128> n = match (&strip_parens_tc(&args[2]).kind)
        {
            ExprKind::EArrayLit(es)   : Some(widen<u128>(Vec::len(es))),
            ExprKind::EArrayRepeat(r) : Some(Box::get(r).n),
            _                         : None,
        };
        return match (&by_index[0])
        {
            Some(Type::TSlice(sb)) : match (n)
            {
                Some(k) : Some(simd_of(clone(&Box::get(sb).inner), k)),
                None    : None,
            },
            _ : None,
        };
    }
    if ((StringView::eq_str(name, "simd_load") && i == 1) || (StringView::eq_str(name, "simd_store") && i == 1))
    {
        return Some(Type::TInt(IntTy::Usize));
    }
    if ((StringView::eq_str(name, "atomic_op") || StringView::eq_str(name, "atomic_wait_op")) && i == 1)
    {
        return Some(Type::TInt(IntTy::U8));
    }
    if (StringView::eq_str(name, "atomic_wait_op") && i == 2)
    {
        return Some(Type::TInt(IntTy::U64));
    }
    if (StringView::eq_str(name, "cpu_op"))
    {
        return Some(Type::TInt(IntTy::U8));
    }
    if (StringView::eq_str(name, "atomic_op") && i >= 2)
    {
        // D-0249, D-0253: the operands are the atomic's cell type.
        return match (&by_index[0])
        {
            Some(t) : atomic_cell_ty(t),
            None    : None,
        };
    }
    None
}

fn is_ref_to_handle(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(Type::TRef(rb)) : match (&Box::get(rb).inner)
        {
            Type::THandle(_) : true,
            _                : false,
        },
        _ : false,
    }
}

// What an intrinsic gives, its operands checked (the rest of `check_call`'s
// intrinsic branch).
fn check_intrinsic_result(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    StringView name,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    ref<Vec<Option<Type>>, shared> arg_tys,
    bool alt,
) : Result<Option<Type>, String>
{
    String nm = String::from_view(name);
    // D-0091: `sqrt` and the others of an `f32` or `f64`, of that type.
    if (is_float_fn(&nm))
    {
        StringView short = Option::unwrap_or(StringView::strip_prefix(name, "std::"), name);
        if (Vec::len(args) != 1)
        {
            return Err(mismatch(sprintf("`%s` takes one argument", short)));
        }
        return match (arg_ty(arg_tys, 0))
        {
            Some(t) :
            {
                if (is_float_type(&t))
                {
                    return Ok(Some(t));
                }
                if (has_unresolved_marker(&t))
                {
                    return Err(mismatch(sprintf(
                        "`%s` takes an `f32` or `f64`; a type parameter's value is neither, whatever its bound",
                        short,
                    )));
                }
                Err(mismatch(sprintf(
                    "`%s` takes an `f32` or `f64`, and this is `%s`; convert an integer with `to_float<f64>(…)`",
                    short,
                    &type_display(&t),
                )))
            },
            None    : Ok(None),
        };
    }
    // D-0101: `atan2(y, x)`, `powf(x, y)`: two operands of one float type.
    if (is_float2_fn(&nm))
    {
        StringView short = Option::unwrap_or(StringView::strip_prefix(name, "std::"), name);
        if (Vec::len(args) != 2)
        {
            return Err(mismatch(sprintf("`%s` takes two arguments", short)));
        }
        Option<Type> a0 = arg_ty(arg_tys, 0);
        Option<Type> a1 = arg_ty(arg_tys, 1);
        match (&a0)
        {
            Some(a) : match (&a1)
            {
                Some(c) :
                {
                    if (is_float_type(a) && type_eq(a, c))
                    {
                        return Ok(Some(clone(a)));
                    }
                    if (is_float_type(a) && is_float_type(c))
                    {
                        return Err(mismatch(sprintf(
                            "`%s` takes two operands of one type, and these are `%s` and `%s`; a literal is `f64` unless suffixed (`1.0: f32`)",
                            short,
                            &type_display(a),
                            &type_display(c),
                        )));
                    }
                },
                None    : {},
            },
            None : {},
        }
        for (usize k = 0; k < 2; k += 1)
        {
            match (if (k == 0) { &a0 } else { &a1 })
            {
                Some(t) :
                {
                    if (!is_float_type(t) && !has_unresolved_marker(t))
                    {
                        return Err(mismatch(sprintf(
                            "`%s` takes `f32` or `f64` operands, and this is `%s`; convert an integer with `to_float<f64>(…)`",
                            short,
                            &type_display(t),
                        )));
                    }
                },
                None    : {},
            }
        }
        return Ok(None);
    }
    if (alt)
    {
        // `[T-Alt]`'s result: the operands' type τ, or `Option<τ>` for the
        // `checked_` family.
        Option<Type> t = None;
        for (usize k = 0; k < Vec::len(arg_tys) && Option::is_none(&t); k += 1)
        {
            match (&arg_tys[k])
            {
                Some(Type::TInt(i)) : t = Some(Type::TInt(*i)),
                _                   : {},
            }
        }
        return Ok(match (t)
        {
            Some(x) :
            {
                if (StringView::starts_with(name, "checked_"))
                {
                    Vec<Type> a = Vec::new();
                    Vec::push(&mut a, x);
                    Some(named("std::Option", a))
                }
                else
                {
                    Some(x)
                }
            },
            None    : None,
        });
    }
    // `[Spawn]`, `[Join]` (spec/19 §1).
    if (StringView::eq_str(name, "spawn") && Vec::len(args) > 0)
    {
        match (spawn_callee_params(b, it, args, arg_tys))
        {
            Some(sp) :
            {
                if (Vec::len(&sp.params) != Vec::len(args) - 1)
                {
                    return Err(mismatch(sprintf(
                        "`spawn(f, …)` passes its other arguments to `f`, which takes %v and is given %v",
                        Vec::len(&sp.params),
                        Vec::len(args) - 1,
                    )));
                }
                HashMap<String, Type> m = HashMap::new();
                for (usize i = 0; i < Vec::len(&sp.params); i += 1)
                {
                    match (&arg_tys[i + 1])
                    {
                        Some(a) : unify_type_shape(&sp.params[i].ty, a, &mut m, &sp.type_params),
                        None    : {},
                    }
                }
                HashSet<String> tset = HashSet::new();
                for (usize i = 0; i < Vec::len(&sp.type_params); i += 1)
                {
                    HashSet::insert(&mut tset, String::clone(&sp.type_params[i]));
                }
                Vec<Expr> rest_args = Vec::new();
                Vec<Option<Type>> rest_tys = Vec::new();
                for (usize i = 1; i < Vec::len(args); i += 1)
                {
                    Vec::push(&mut rest_args, clone(&args[i]));
                    Vec::push(&mut rest_tys, clone(&arg_tys[i]));
                }
                check_arg_exact_types(b, it, &sp.params, &rest_args, &rest_tys, &m, &tset)?;
            },
            None     : {},
        }
        match (&arg_tys[0])
        {
            Some(Type::TFn(fb)) :
            {
                if (!has_unresolved_marker(&Box::get(fb).ret))
                {
                    return Ok(Some(Type::THandle(Box::new(clone(&Box::get(fb).ret)))));
                }
            },
            _                   : {},
        }
        // WI-15: what the thread runs is a function.
        match (&arg_tys[0])
        {
            Some(t) :
            {
                bool runnable = match (t)
                {
                    Type::TFn(_)      : true,
                    Type::TClosure(_) : true,
                    Type::TNever      : true,
                    _                 : false,
                };
                if (!runnable && !has_unresolved_marker(t))
                {
                    String msg = sprintf(
                        "`spawn` runs a function: its first argument is a fn value or a `move` closure, not `%s`",
                        &type_display(t),
                    );
                    return Err(named_diag("diag.type-mismatch", &msg));
                }
            },
            None    : {},
        }
    }
    if (StringView::eq_str(name, "join"))
    {
        match (arg_ty(arg_tys, 0))
        {
            Some(Type::THandle(h)) : return Ok(Some(Box::into_inner(h))),
            _                      : {},
        }
    }
    // D-0204: `cancel` and `join_status`.
    if (StringView::eq_str(name, "join_status") && is_ref_to_handle(&arg_ty(arg_tys, 0)))
    {
        return Ok(Some(Type::TInt(IntTy::U64)));
    }
    if (StringView::eq_str(name, "cancel") && is_ref_to_handle(&arg_ty(arg_tys, 0)))
    {
        return Ok(Some(Type::TVoid));
    }
    // WI-15: the operand a thread or raw intrinsic takes, where known.
    match (arg_ty(arg_tys, 0))
    {
        Some(t) :
        {
            Option<bool> fits = None;
            if (StringView::eq_str(name, "lock"))
            {
                fits = Some(match (&t)
                {
                    Type::TRef(rb) : match (&Box::get(rb).inner)
                    {
                        Type::TMutex(_) : true,
                        _               : false,
                    },
                    _ : false,
                });
            }
            else if (StringView::eq_str(name, "join"))
            {
                fits = Some(match (&t)
                {
                    Type::THandle(_) : true,
                    _                : false,
                });
            }
            else if (StringView::eq_str(name, "cancel") || StringView::eq_str(name, "join_status"))
            {
                fits = Some(is_ref_to_handle(&Some(clone(&t))));
            }
            else if (StringView::eq_str(name, "rawptr_of"))
            {
                fits = Some(match (&t)
                {
                    Type::TRef(_) : true,
                    _             : false,
                });
            }
            match (fits)
            {
                Some(false) :
                {
                    if (!is_never(&t) && !has_unresolved_marker(&t))
                    {
                        str want = if (StringView::eq_str(
                            name,
                            "lock",
                        )) { "a reference to a mutex: `lock(&m)`" } else if (StringView::eq_str(
                            name,
                            "join",
                        )) { "the handle `spawn` gave" } else if (StringView::eq_str(
                            name,
                            "rawptr_of",
                        )) { "a reference: `rawptr_of(&x)`" } else { "a reference to the handle `spawn` gave" };
                        String msg = sprintf("`%s` takes %s, not `%s`", name, want, &type_display(&t));
                        return Err(named_diag("diag.type-mismatch", &msg));
                    }
                },
                _           : {},
            }
        },
        None    : {},
    }
    // D-0249 `rule.conc.atomic`, std-only.
    if (StringView::eq_str(name, "atomic_op"))
    {
        Option<Type> cell = match (arg_ty(arg_tys, 0))
        {
            Some(t) : atomic_cell_ty(&t),
            None    : None,
        };
        Type t = match (cell)
        {
            Some(t) : t,
            None    : return Err(mismatch(String::from_str("`atomic_op` takes a reference to an `Atomic` or an `AtomicPtr` first"))),
        };
        for (usize k = 2; k < 4; k += 1)
        {
            match (arg_ty(arg_tys, k))
            {
                Some(vt) :
                {
                    if (!has_unresolved_marker(&vt) && !has_unresolved_marker(&t) && !ty_compat(
                        &vt,
                        &t,
                    ) && !is_bare_num_literal(&args[k]))
                    {
                        return Err(mismatch(sprintf(
                            "`atomic_op` on an `Atomic<%s>` takes `%s` operands, not `%s`",
                            &type_display(&t),
                            &type_display(&t),
                            &type_display(&vt),
                        )));
                    }
                },
                None     : {},
            }
        }
        return Ok(Some(t));
    }
    if (StringView::eq_str(name, "atomic_wait_op"))
    {
        bool ok = match (arg_ty(arg_tys, 0))
        {
            Some(Type::TRef(rb)) : named_is(&Box::get(&rb).inner, "std::Atomic"),
            _                    : false,
        };
        if (!ok)
        {
            return Err(mismatch(String::from_str("`atomic_wait_op` takes a reference to an `Atomic` first")));
        }
        return Ok(Some(Type::TInt(IntTy::U64)));
    }
    if (StringView::eq_str(name, "cpu_op"))
    {
        return Ok(Some(Type::TVoid));
    }
    // `[Lock]` (spec/19 §2).
    if (StringView::eq_str(name, "lock"))
    {
        match (arg_ty(arg_tys, 0))
        {
            Some(Type::TRef(rb)) : match (&Box::get(&rb).inner)
            {
                Type::TMutex(mb) : return Ok(Some(Type::TGuard(Box::new(clone(Box::get(mb)))))),
                _                : {},
            },
            _ : {},
        }
    }
    // D-0123: a rotation keeps its operand's type.
    if (StringView::eq_str(name, "rotate_left") || StringView::eq_str(name, "rotate_right"))
    {
        match (arg_ty(arg_tys, 0))
        {
            Some(Type::TInt(i)) : return Ok(Some(Type::TInt(i))),
            _                   : {},
        }
    }
    // D-0121: `read_volatile(p) : τ` and `write_volatile(p, v)`.
    if (StringView::eq_str(name, "read_volatile") || StringView::eq_str(name, "write_volatile"))
    {
        bool read = StringView::eq_str(name, "read_volatile");
        usize want = if (read) { 1 } else { 2 };
        if (Vec::len(args) != want)
        {
            return Err(mismatch(sprintf(
                "`%s` takes %v argument%s",
                name,
                want,
                if (want == 1) { ": a raw pointer" } else { "s: a raw pointer and the value to write" },
            )));
        }
        Type t = match (arg_ty(arg_tys, 0))
        {
            Some(Type::TRawptr(pb)) : Box::into_inner(pb),
            _                       : return Err(mismatch(sprintf("`%s` takes a `rawptr<T>` first", name))),
        };
        if (!has_unresolved_marker(&t) && is_resource_ty(it, &t))
        {
            return Err(mismatch(sprintf(
                "`%s` moves nothing: `%s` is a resource, which crosses raw memory by `*p` (moved in or out)",
                name,
                &type_display(&t),
            )));
        }
        if (!read)
        {
            match (arg_ty(arg_tys, 1))
            {
                Some(vt) :
                {
                    if (!has_unresolved_marker(&vt) && !has_unresolved_marker(&t) && !ty_compat(
                        &vt,
                        &t,
                    ) && !is_bare_num_literal(&args[1]))
                    {
                        return Err(mismatch(sprintf(
                            "`write_volatile` through a `rawptr<%s>` writes a `%s`, but the value is `%s`",
                            &type_display(&t),
                            &type_display(&t),
                            &type_display(&vt),
                        )));
                    }
                },
                None     : {},
            }
            return Ok(Some(Type::TVoid));
        }
        return Ok(Some(t));
    }
    // D-0258: `rawptr_from_address<T>(a)` and `rawptr_address(p)`.
    if (StringView::eq_str(name, "rawptr_from_address"))
    {
        match (arg_ty(arg_tys, 0))
        {
            Some(t) :
            {
                if (!has_unresolved_marker(&t) && !type_eq(
                    &t,
                    &Type::TInt(IntTy::Usize),
                ) && !is_bare_num_literal(&args[0]))
                {
                    return Err(mismatch(sprintf(
                        "`rawptr_from_address` takes the address as a `usize`, not `%s`",
                        &type_display(&t),
                    )));
                }
            },
            None    : {},
        }
        return Ok(if (Vec::len(targs) > 0) { Some(rawptr_of(apply_subst(&targs[0], &b.subst))) } else { None });
    }
    if (StringView::eq_str(name, "rawptr_address"))
    {
        match (arg_ty(arg_tys, 0))
        {
            Some(t) :
            {
                bool ok = match (&t)
                {
                    Type::TRawptr(_) : true,
                    Type::TNever     : true,
                    _                : false,
                };
                if (!has_unresolved_marker(&t) && !ok)
                {
                    return Err(mismatch(sprintf("`rawptr_address` takes a raw pointer, not `%s`", &type_display(&t))));
                }
            },
            None    : {},
        }
        return Ok(Some(Type::TInt(IntTy::Usize)));
    }
    // D-0116: `clone(&x) : T` for `x : T` with `T` clone.
    if (StringView::eq_str(name, "clone"))
    {
        if (Vec::len(args) != 1)
        {
            return Err(mismatch(String::from_str("`clone` takes one argument, a reference: `clone(&x)`")));
        }
        Type t = match (arg_ty(arg_tys, 0))
        {
            Some(Type::TRef(rb)) : Box::into_inner(rb).inner,
            _                    : return Err(mismatch(String::from_str("`clone` takes a reference to the value to copy: `clone(&x)`"))),
        };
        if (!is_marker(&t) && has_unresolved_marker(&t))
        {
            return Ok(Some(t));
        }
        match (clone_problem(b, it, &t))
        {
            Some(problem) : return Err(mismatch(sprintf(
                "`clone` needs its `T` to be `clone` (%s), and `%s` is not: %s",
                bound_members(Bound::BClone),
                &type_display(&t),
                &problem,
            ))),
            None : {},
        }
        return Ok(Some(t));
    }
    Ok(check_known_intrinsic(b, name, targs))
}

struct SpawnCallee
{
    Vec<ParamDecl> params;
    Vec<String> type_params;
}

fn spawn_callee_params(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<Vec<Expr>, shared> args,
    ref<Vec<Option<Type>>, shared> arg_tys,
) : Option<SpawnCallee>
{
    match (resolve_fn_path(it, &args[0]))
    {
        Some(k) :
        {
            ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &k), "a function");
            return Some(SpawnCallee { .params = clone(&f.params), .type_params = Vec::clone(&f.type_params) });
        },
        None    : {},
    }
    match (&arg_tys[0])
    {
        Some(Type::TFn(fb)) :
        {
            Vec<ParamDecl> ps = Vec::new();
            for (usize i = 0; i < Vec::len(&Box::get(fb).params); i += 1)
            {
                Vec::push(&mut ps, ParamDecl { .ty = clone(&Box::get(fb).params[i]), .name = sprintf("#%v", i + 1) });
            }
            Some(SpawnCallee { .params = ps, .type_params = Vec::new() })
        },
        _                   : None,
    }
}

// `static_assert(c, …)` (D-0052, D-0067, D-0068).
fn check_static_assert(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Vec<Expr>, shared> args,
) : Result<Option<Type>, String>
{
    if (Vec::len(args) == 0)
    {
        return Err(String::from_str("diag.type-mismatch"));
    }
    // `[Static-Assert-Not-Constant]` (D-0067).
    Option<Type> ct = check_expr(b, it, &args[0], &Some(Type::TBool))?;
    match (&ct)
    {
        Some(t) :
        {
            bool ok = match (t)
            {
                Type::TBool  : true,
                Type::TNever : true,
                _            : false,
            };
            if (!ok)
            {
                return Err(String::from_str("diag.static-assert-not-constant"));
            }
        },
        None    : {},
    }
    if (!const_expr(it, &args[0]))
    {
        return Err(String::from_str("diag.static-assert-not-constant"));
    }
    // The message: a string literal, or (D-0068) a format and its
    // arguments, each a constant expression.
    Option<Expr> message_fmt = None;
    Option<String> msg = None;
    if (Vec::len(args) > 1)
    {
        match (&args[1].kind)
        {
            ExprKind::EStr(m) :
            {
                if (Vec::len(args) == 2)
                {
                    msg = Some(String::clone(m));
                }
                else
                {
                    for (usize i = 2; i < Vec::len(args); i += 1)
                    {
                        if (!const_expr(it, &args[i]))
                        {
                            return Err(String::from_str("diag.static-assert-not-constant"));
                        }
                    }
                    usize line = args[1].line;
                    usize col = args[1].col;
                    Vec<Expr> fargs = Vec::new();
                    for (usize i = 1; i < Vec::len(args); i += 1)
                    {
                        Vec::push(&mut fargs, clone(&args[i]));
                    }
                    Vec<String> fs = Vec::new();
                    Vec::push(&mut fs, String::from_str("$fmt"));
                    Expr fmt = mk(
                        ExprKind::ECall(Box::new(CallExpr { .callee = mk(
                            ExprKind::EPath(Box::new(PathExpr { .segs = fs, .targs = Vec::new() })),
                            line,
                            col,
                        ), .args = fargs })),
                        line,
                        col,
                    );
                    number_fresh(b, &mut fmt);
                    check_expr(b, it, &fmt, &None)?;
                    message_fmt = Some(fmt);
                }
            },
            _                 : return Err(String::from_str("diag.type-mismatch")),
        }
    }
    // A generic body checked with its type parameters opaque cannot compute
    // it; each concrete instantiation does.
    bool opaque = false;
    for (usize i = 0; i < HashMap::len(&b.subst); i += 1)
    {
        if (has_unresolved_marker(HashMap::value_at(&b.subst, i)))
        {
            opaque = true;
        }
    }
    if (!opaque && b.report)
    {
        Vec<String> names = Vec::new();
        for (usize i = 0; i < HashMap::len(&b.subst); i += 1)
        {
            Vec::push(&mut names, String::clone(HashMap::key_at(&b.subst, i)));
        }
        Vec::sort(&mut names);
        String key = sprintf("%v|", args[0].id);
        for (usize i = 0; i < Vec::len(&names); i += 1)
        {
            String::appendf(
                &mut key,
                "%s=%s;",
                &names[i],
                &type_code(Option::expect(HashMap::get(&b.subst, &names[i]), "a type")),
            );
        }
        Vec::push(&mut b.static_asserts, StaticAssert {
            .key_code = key,
            .cond = clone(&args[0]),
            .subst = clone(&b.subst),
            // An assertion of `std`'s is reported at its prelude line past
            // `STD_LINE`, apart from the program's lines (coby's `std` lines
            // precede the program's): `line 0` in a dump, `<std>/FILE:LINE`
            // in a report.
            .line = if (String::eq_str(
                &b.module_,
                "std",
            ) || String::starts_with(&b.module_, "std::")) { STD_LINE + args[0].line } else { args[0].line },
            .message = msg,
            .message_fmt = message_fmt,
        });
    }
    Ok(Some(Type::TVoid))
}

fn opaque_or_never(ref<Type, shared> t) : bool
{
    is_never(t) || has_unresolved_marker(t)
}

fn int_or_opaque(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TInt(_) : true,
        _             : opaque_or_never(t),
    }
}

fn float_or_opaque(ref<Type, shared> t) : bool
{
    is_float_type(t) || opaque_or_never(t)
}

fn num_or_opaque(ref<Type, shared> t) : bool
{
    int_or_opaque(t) || float_or_opaque(t)
}

fn bitwidth_of(ref<Type, shared> t) : Option<u32>
{
    match (t)
    {
        Type::TInt(i) : Some(int_ty_bits(*i, 64)),
        Type::TF32    : Some(32),
        Type::TF64    : Some(64),
        _             : None,
    }
}

fn hinted(String m) : Result<void, String>
{
    Err(sprintf("diag.type-mismatch\u{1}%s", &m))
}

// The operand and target types `rule.arith.alt` and `rule.arith.convert`
// name (spec/06 §4, §5), per instantiation.
fn check_integer_intrinsic_operands(
    ref<Body, shared> b,
    StringView name,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    ref<Vec<Option<Type>>, shared> arg_tys,
) : Result<void, String>
{
    if (is_alt_intrinsic(name))
    {
        for (usize i = 0; i < Vec::len(arg_tys); i += 1)
        {
            match (&arg_tys[i])
            {
                Some(t) :
                {
                    if (!int_or_opaque(t))
                    {
                        return Err(String::from_str("diag.type-mismatch"));
                    }
                },
                None    : {},
            }
        }
        // A bare literal takes its type from the other operand.
        match (arg_ty(arg_tys, 0))
        {
            Some(Type::TInt(a)) : match (arg_ty(arg_tys, 1))
            {
                Some(Type::TInt(c)) :
                {
                    if (a != c && !is_bare_num_literal(&args[0]) && !is_bare_num_literal(&args[1]))
                    {
                        return Err(String::from_str("diag.type-mismatch"));
                    }
                },
                _                   : {},
            },
            _ : {},
        }
        return Ok(());
    }
    // D-0123: an integer operand; a rotation's amount is a `u32`.
    if (StringView::eq_str(
        name,
        "count_ones",
    ) || StringView::eq_str(
        name,
        "leading_zeros",
    ) || StringView::eq_str(
        name,
        "trailing_zeros",
    ) || StringView::eq_str(name, "rotate_left") || StringView::eq_str(name, "rotate_right"))
    {
        match (arg_ty(arg_tys, 0))
        {
            Some(t) :
            {
                if (!int_or_opaque(&t))
                {
                    String msg = sprintf(
                        "`%s` counts or rotates the bits of an integer; `%s` is not one",
                        name,
                        &type_display(&t),
                    );
                    return Err(named_diag("diag.type-mismatch", &msg));
                }
            },
            None    : {},
        }
        if (StringView::starts_with(name, "rotate"))
        {
            match (arg_ty(arg_tys, 1))
            {
                Some(k) :
                {
                    if (!opaque_or_never(&k) && !type_eq(&k, &Type::TInt(IntTy::U32)) && !is_bare_num_literal(&args[1]))
                    {
                        String msg = sprintf("`%s`'s amount is a `u32`, not `%s`", name, &type_display(&k));
                        return Err(named_diag("diag.type-mismatch", &msg));
                    }
                },
                None    : {},
            }
        }
        return Ok(());
    }
    bool convert = StringView::eq_str(
        name,
        "widen",
    ) || StringView::eq_str(
        name,
        "narrow",
    ) || StringView::eq_str(
        name,
        "narrow_wrapping",
    ) || StringView::eq_str(
        name,
        "reinterpret",
    ) || StringView::eq_str(
        name,
        "to_float",
    ) || StringView::eq_str(name, "to_int") || StringView::eq_str(name, "checked_narrow");
    if (!convert)
    {
        return Ok(());
    }
    // `[T-Convert]`'s kind premises.
    bool is_narrow = StringView::eq_str(name, "narrow") || StringView::eq_str(name, "narrow_wrapping");
    match (arg_ty(arg_tys, 0))
    {
        Some(a) :
        {
            bool src_ok = if (StringView::eq_str(
                name,
                "widen",
            ) || StringView::eq_str(
                name,
                "reinterpret",
            ) || StringView::eq_str(
                name,
                "to_float",
            )) { num_or_opaque(&a) } else if (StringView::eq_str(
                name,
                "to_int",
            )) { float_or_opaque(&a) } else { int_or_opaque(&a) };
            if (!src_ok)
            {
                if (is_narrow && float_or_opaque(&a))
                {
                    return hinted(sprintf(
                        "`%s` converts between integer types, and this is `%s`: a float becomes an integer with `to_int<T>(x)`",
                        name,
                        &type_display(&a),
                    ));
                }
                if (StringView::eq_str(name, "to_int") && !float_or_opaque(&a) && int_or_opaque(&a))
                {
                    return hinted(sprintf(
                        "`to_int` converts a float, and this is `%s`: between integer types use `narrow<T>(x)` or `widen<T>(x)`",
                        &type_display(&a),
                    ));
                }
                return hinted(sprintf("`%s` converts a number, not `%s`", name, &type_display(&a)));
            }
        },
        None    : {},
    }
    if (Vec::len(targs) == 0)
    {
        return Ok(());
    }
    Type t = apply_subst(&targs[0], &b.subst);
    bool dst_ok = if (StringView::eq_str(
        name,
        "widen",
    ) || StringView::eq_str(
        name,
        "reinterpret",
    )) { num_or_opaque(&t) } else if (StringView::eq_str(
        name,
        "to_float",
    )) { float_or_opaque(&t) } else { int_or_opaque(&t) };
    if (!dst_ok)
    {
        String ts = type_display(&t);
        if (is_narrow && float_or_opaque(&t))
        {
            return hinted(sprintf(
                "`%s` gives an integer type, not `%s`: to get a float use `to_float<%s>(x)`",
                name,
                &ts,
                &ts,
            ));
        }
        if (StringView::eq_str(name, "to_float") && !float_or_opaque(&t) && int_or_opaque(&t))
        {
            return hinted(sprintf(
                "`to_float` gives `f32` or `f64`, not `%s`: to get an integer from a float use `to_int<%s>(x)`",
                &ts,
                &ts,
            ));
        }
        if (StringView::eq_str(name, "to_int") && float_or_opaque(&t))
        {
            return hinted(sprintf(
                "`to_int` gives an integer type, not `%s`: between floats use `widen<%s>(x)` or `to_float<%s>(x)`",
                &ts,
                &ts,
                &ts,
            ));
        }
        return hinted(sprintf("`%s<%s>`: `%s` is not a number type", name, &ts, &ts));
    }
    // The pair premises of `widen` and `reinterpret`.
    match (arg_ty(arg_tys, 0))
    {
        Some(src) :
        {
            bool bad = false;
            if (StringView::eq_str(name, "widen"))
            {
                match (&src)
                {
                    Type::TInt(si) : match (&t)
                    {
                        Type::TInt(di) :
                        {
                            u32 sw = int_ty_bits(*si, 64);
                            u32 dw = int_ty_bits(*di, 64);
                            bool ss = int_ty_signed(*si);
                            bool ds = int_ty_signed(*di);
                            bool fits = if (ss == ds) { sw <= dw } else if (!ss && ds) { sw < dw } else { false };
                            bad = !fits;
                        },
                        Type::TF32     : bad = true,
                        Type::TF64     : bad = true,
                        _              : {},
                    },
                    Type::TF64 : match (&t)
                    {
                        Type::TF32    : bad = true,
                        Type::TInt(_) : bad = true,
                        _             : {},
                    },
                    Type::TF32 : match (&t)
                    {
                        Type::TInt(_) : bad = true,
                        _             : {},
                    },
                    _ : {},
                }
            }
            else if (StringView::eq_str(name, "reinterpret"))
            {
                match (&src)
                {
                    Type::TInt(si) : match (&t)
                    {
                        Type::TInt(di) : bad = !option_u32_eq(
                            bitwidth_of(&src),
                            bitwidth_of(&t),
                        ) || int_ty_signed(*si) == int_ty_signed(*di),
                        Type::TF32 : bad = !option_u32_eq(bitwidth_of(&src), bitwidth_of(&t)),
                        Type::TF64 : bad = !option_u32_eq(bitwidth_of(&src), bitwidth_of(&t)),
                        _          : {},
                    },
                    Type::TF32 : match (&t)
                    {
                        Type::TF32    : bad = true,
                        Type::TF64    : bad = true,
                        Type::TInt(_) : bad = !option_u32_eq(bitwidth_of(&src), bitwidth_of(&t)),
                        _             : {},
                    },
                    Type::TF64 : match (&t)
                    {
                        Type::TF32    : bad = true,
                        Type::TF64    : bad = true,
                        Type::TInt(_) : bad = !option_u32_eq(bitwidth_of(&src), bitwidth_of(&t)),
                        _             : {},
                    },
                    _ : {},
                }
            }
            if (bad)
            {
                String ss = type_display(&src);
                String ts = type_display(&t);
                if (StringView::eq_str(name, "widen"))
                {
                    match (&src)
                    {
                        Type::TInt(_) : match (&t)
                        {
                            Type::TInt(_) : return hinted(sprintf(
                                "`widen` converts only where every value fits, and not every `%s` fits in `%s`: use `narrow<%s>(x)` (checked) or `narrow_wrapping<%s>(x)`",
                                &ss,
                                &ts,
                                &ts,
                                &ts,
                            )),
                            _ : return hinted(sprintf(
                                "`widen` does not turn an integer into a float: use `to_float<%s>(x)`",
                                &ts,
                            )),
                        },
                        Type::TF64 : match (&t)
                        {
                            Type::TF32 : return hinted(String::from_str("`widen` cannot shrink `f64` to `f32`: use `to_float<f32>(x)`")),
                            _          : {},
                        },
                        _ : {},
                    }
                    match (&t)
                    {
                        Type::TInt(_) : return hinted(sprintf(
                            "`widen` does not turn a float into an integer: use `to_int<%s>(x)` (checked)",
                            &ts,
                        )),
                        _ : {},
                    }
                }
                return hinted(sprintf(
                    "`reinterpret` keeps the bits, so `%s` and `%s` must have the same width and differ in signedness or in being a float",
                    &ss,
                    &ts,
                ));
            }
        },
        None      : {},
    }
    // `[Narrow-Overflow]`, `[Float-To-Int-Invalid]`: static where the
    // operand is constant.
    match (&t)
    {
        Type::TInt(di) :
        {
            if (Vec::len(args) > 0)
            {
                IntRange r = int_range(*di);
                String ts = type_display(&t);
                if (StringView::eq_str(name, "narrow"))
                {
                    match (fold_int(b, &args[0]))
                    {
                        Some(v) :
                        {
                            if (v < r.min || v > r.max)
                            {
                                String msg = sprintf(
                                    "`narrow<%s>` of %v does not fit (`%s` is %v to %v); `narrow_wrapping<%s>` keeps the low bits",
                                    &ts,
                                    v,
                                    &ts,
                                    r.min,
                                    r.max,
                                    &ts,
                                );
                                return Err(named_diag("diag.narrowing-overflow", &msg));
                            }
                        },
                        None    : {},
                    }
                }
                if (StringView::eq_str(name, "to_int"))
                {
                    Option<f64> lit = match (&strip_parens_tc(&args[0]).kind)
                    {
                        ExprKind::EFloat(fb) : Some(Box::get(fb).v),
                        ExprKind::EUnary(ub) : if (Box::get(ub).op == UnOp::Neg)
                        {
                            match (&strip_parens_tc(&Box::get(ub).e).kind)
                            {
                                ExprKind::EFloat(fb) : Some(-Box::get(fb).v),
                                _                    : None,
                            }
                        }
                        else { None },
                        _                    : None,
                    };
                    match (lit)
                    {
                        Some(x) :
                        {
                            f64 tr = trunc(x);
                            if (!is_finite(x) || tr < to_float<f64>(r.min) || tr > to_float<f64>(r.max))
                            {
                                // Rust's `{}` of an f64: no `.0` on a whole number.
                                String xs = rust_float_text(x);
                                String msg = sprintf(
                                    "`to_int<%s>` of %s does not fit (`%s` is %v to %v)",
                                    &ts,
                                    &xs,
                                    &ts,
                                    r.min,
                                    r.max,
                                );
                                return Err(named_diag("diag.narrowing-overflow", &msg));
                            }
                        },
                        None    : {},
                    }
                }
            }
        },
        _              : {},
    }
    Ok(())
}

fn option_u32_eq(Option<u32> a, Option<u32> c) : bool
{
    match (a)
    {
        Some(x) : match (c)
        {
            Some(y) : x == y,
            None    : false,
        },
        None : Option::is_none(&c),
    }
}

struct Bitfield
{
    u32 width;
    IntTy backing;
    String sname;
}

// D-0118: `e` is `base.f` with `base` a `bitstruct`: the field's width and
// the backing type.
fn bitfield_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Bitfield>
{
    ref<FieldExpr, shared> fe = match (&strip_parens_tc(e).kind)
    {
        ExprKind::EField(fb) : Box::get(fb),
        _                    : return None,
    };
    Type bt = through_ref_or_guard(static_place_type(b, it, &fe.e)?);
    String sname = match (&bt)
    {
        Type::TNamed(nb) : String::clone(&Box::get(nb).name),
        _                : return None,
    };
    ref<StructDecl, shared> sd = HashMap::get(&it.structs, &sname)?;
    IntTy backing = sd.bits?;
    for (usize i = 0; i < Vec::len(&sd.fields); i += 1)
    {
        if (String::eq(&sd.fields[i].name, &fe.name))
        {
            u32 w = sd.fields[i].width?;
            return Some(Bitfield { .width = w, .backing = backing, .sname = sname });
        }
    }
    None
}

// D-0118: a literal written into a bit field must fit its width.
fn check_bitfield_literal(
    ref<Body, shared> b,
    ref<Expr, shared> value,
    u32 width,
    ref<String, shared> what,
) : Result<void, String>
{
    Option<i128> v = match (literal_value(value))
    {
        Some(x) : Some(x),
        None    : fold_int(b, value),
    };
    match (v)
    {
        Some(x) :
        {
            i128 one = 1;
            i128 limit = if (width >= 127) { max_value<i128>() } else { (one << width) - 1 };
            if (x < 0 || x > limit)
            {
                String msg = sprintf("%s is %v bits wide, so it holds 0 to %v; %v does not fit", what, width, limit, x);
                return Err(named_diag("diag.narrowing-overflow", &msg));
            }
        },
        None    : {},
    }
    Ok(())
}

// D-0116: why `t` is not `clone`, or `None` when it is.
fn clone_problem(ref<Body, shared> b, ref<Items, shared> it, ref<Type, shared> t) : Option<String>
{
    HashSet<String> seen = HashSet::new();
    clone_problem_in(b, it, t, &mut seen)
}

// D-0257: why `t` is not `plain`, or `None` when it is.
fn plain_problem(ref<Body, shared> b, ref<Items, shared> it, ref<Type, shared> t) : Option<String>
{
    HashSet<String> seen = HashSet::new();
    plain_problem_in(b, it, t, &mut seen)
}

fn short_name(ref<String, shared> n) : StringView
{
    Option::unwrap_or(String::strip_prefix(n, "std::"), String::as_view(n))
}

fn plain_problem_in(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<Type, shared> t,
    ref<HashSet<String>, exclusive> seen,
) : Option<String>
{
    match (t)
    {
        Type::TNamed(nb)  :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (Vec::len(&n.args) == 0 && String::starts_with(&n.name, "$"))
            {
                bool plain = match (HashMap::get(&b.marker_bounds, &n.name))
                {
                    Some(bd) : *bd == Bound::BPlain,
                    None     : false,
                };
                if (plain)
                {
                    return None;
                }
                return Some(sprintf(
                    "type parameter `%s` is not declared `plain`",
                    StringView::sub(String::as_view(&n.name), 1, String::len(&n.name)),
                ));
            }
            if (is_resource_ty(it, t))
            {
                return Some(sprintf("`%s` is a resource", short_name(&n.name)));
            }
            if (!HashSet::insert(seen, type_code(t)))
            {
                return None;
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        Type ft = apply_subst(&s.fields[i].ty, &subst);
                        match (plain_problem_in(b, it, &ft, seen))
                        {
                            Some(p) : return Some(sprintf(
                                "field `%s` of `%s`: %s",
                                &s.fields[i].name,
                                short_name(&n.name),
                                &p,
                            )),
                            None : {},
                        }
                    }
                    return None;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(pt) :
                            {
                                Type ft = apply_subst(pt, &subst);
                                match (plain_problem_in(b, it, &ft, seen))
                                {
                                    Some(p) : return Some(sprintf(
                                        "variant `%s` of `%s`: %s",
                                        &e.variants[i].name,
                                        short_name(&n.name),
                                        &p,
                                    )),
                                    None : {},
                                }
                            },
                            None     : {},
                        }
                    }
                    return None;
                },
                None    : {},
            }
            None
        },
        Type::TInt(_)     : None,
        Type::TF32        : None,
        Type::TF64        : None,
        Type::TBool       : None,
        Type::TRawptr(_)  : None,
        Type::TSimd(_)    : None,
        Type::TNever      : None,
        Type::TVoid       : Some(String::from_str("`void` is no data")),
        Type::TStr        : Some(String::from_str("`str` names text the program holds, not bytes of its own")),
        Type::TRef(_)     : Some(String::from_str("a reference reaches storage that is not its own")),
        Type::TSlice(_)   : Some(String::from_str("a reference reaches storage that is not its own")),
        Type::TFn(_)      : Some(String::from_str("a function value is not data")),
        Type::TClosure(_) : Some(String::from_str("a function value is not data")),
        Type::THandle(_)  : Some(String::from_str("a thread handle is not data")),
        Type::TMutex(_)   : Some(String::from_str("a mutex is not plain data")),
        Type::TGuard(_)   : Some(String::from_str("a lock guard is not plain data")),
        Type::TArray(ab)  : plain_problem_in(b, it, &Box::get(ab).inner, seen),
    }
}

fn clone_problem_in(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<Type, shared> t,
    ref<HashSet<String>, exclusive> seen,
) : Option<String>
{
    match (t)
    {
        Type::TNamed(nb)  :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (Vec::len(&n.args) == 0 && String::starts_with(&n.name, "$"))
            {
                bool ok = match (HashMap::get(&b.marker_bounds, &n.name))
                {
                    Some(have) : bound_implies(*have, Bound::BClone),
                    None       : false,
                };
                if (ok)
                {
                    return None;
                }
                return Some(sprintf(
                    "type parameter `%s` is not declared `clone`",
                    StringView::sub(String::as_view(&n.name), 1, String::len(&n.name)),
                ));
            }
            if (!is_resource_ty(it, t))
            {
                if (holds_excl_ref(it, t, 0))
                {
                    return Some(sprintf("`%s` holds an exclusive reference, which has no clone", short_name(&n.name)));
                }
                return None;
            }
            if (!HashSet::insert(seen, type_code(t)))
            {
                return None;
            }
            String key = sprintf("%s::clone", &n.name);
            ref<FnDecl, shared> f = match (HashMap::get(&it.fns, &key))
            {
                Some(f) : f,
                None : return Some(sprintf(
                    "`%s` is a resource with no `%s::clone`",
                    short_name(&n.name),
                    short_name(&n.name),
                )),
            };
            if (f.derived)
            {
                Vec<String> params = match (HashMap::get(&it.structs, &n.name))
                {
                    Some(s) : Vec::clone(&s.type_params),
                    None : match (HashMap::get(&it.enums, &n.name))
                    {
                        Some(e) : Vec::clone(&e.type_params),
                        None    : Vec::new(),
                    },
                };
                HashMap<String, Type> m = zip_subst(&params, &n.args);
                match (HashMap::get(&it.structs, &n.name))
                {
                    Some(s) :
                    {
                        for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                        {
                            match (clone_problem_in(b, it, &apply_subst(&s.fields[i].ty, &m), seen))
                            {
                                Some(p) : return Some(sprintf("its field `%s` is not: %s", &s.fields[i].name, &p)),
                                None    : {},
                            }
                        }
                        return None;
                    },
                    None    : {},
                }
                match (HashMap::get(&it.enums, &n.name))
                {
                    Some(e) :
                    {
                        for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                        {
                            match (&e.variants[i].payload)
                            {
                                Some(pt) : match (clone_problem_in(b, it, &apply_subst(pt, &m), seen))
                                {
                                    Some(p) : return Some(sprintf(
                                        "its variant `%s` holds a value that is not: %s",
                                        &e.variants[i].name,
                                        &p,
                                    )),
                                    None : {},
                                },
                                None : {},
                            }
                        }
                    },
                    None    : {},
                }
                return None;
            }
            for (usize i = 0; i < Vec::len(&f.type_params) && i < Vec::len(&f.type_bounds) && i < Vec::len(&n.args); i += 1)
            {
                Bound bd = match (f.type_bounds[i])
                {
                    Some(x) : x,
                    None    : continue,
                };
                ref<Type, shared> a = &n.args[i];
                ref<String, shared> tp = &f.type_params[i];
                Option<String> bad = None;
                if (bd == Bound::BClone)
                {
                    bad = clone_problem_in(b, it, a, seen);
                }
                else
                {
                    bool bare_marker = match (a)
                    {
                        Type::TNamed(ab) : Vec::len(&Box::get(ab).args) == 0 && String::starts_with(
                            &Box::get(ab).name,
                            "$",
                        ),
                        _ : false,
                    };
                    if (bare_marker)
                    {
                        String an = Option::expect(marker_of(a), "a marker");
                        bool ok = match (HashMap::get(&b.marker_bounds, &an))
                        {
                            Some(have) : bound_implies(*have, bd),
                            None       : false,
                        };
                        if (!ok)
                        {
                            bad = Some(sprintf("type parameter `%s` is not declared `%s`", tp, bound_name(bd)));
                        }
                    }
                    else if (!bound_holds(b, it, bd, a))
                    {
                        bad = Some(sprintf("`%s` is not `%s`", &type_display(a), bound_name(bd)));
                    }
                }
                match (bad)
                {
                    Some(p) : return Some(sprintf(
                        "`%s::clone` needs its `%s` to be `%s`: %s",
                        short_name(&n.name),
                        tp,
                        bound_name(bd),
                        &p,
                    )),
                    None : {},
                }
            }
            None
        },
        // D-0218: an exclusive reference copied out of a shared one.
        Type::TRef(rb)    :
        {
            if (Box::get(rb).mode == Mode::Exclusive)
            {
                return Some(String::from_str("an exclusive reference has no clone: a copy made through a shared reference could write what it reaches"));
            }
            None
        },
        Type::TSlice(sb)  :
        {
            if (Box::get(sb).mode == Mode::Exclusive)
            {
                return Some(String::from_str("an exclusive reference has no clone: a copy made through a shared reference could write what it reaches"));
            }
            None
        },
        Type::TArray(ab)  :
        {
            ref<Type, shared> e = &Box::get(ab).inner;
            if (is_resource_ty(it, e))
            {
                return Some(sprintf(
                    "an array of `%s` (a resource) has no clone; a `Vec` of them does",
                    &type_display(e),
                ));
            }
            clone_problem_in(b, it, e, seen)
        },
        Type::TFn(_)      : Some(String::from_str("a function value has no clone")),
        Type::TClosure(_) : Some(String::from_str("a function value has no clone")),
        Type::THandle(_)  : Some(String::from_str("a thread handle has no clone")),
        Type::TMutex(_)   : Some(String::from_str("a mutex has no clone")),
        Type::TGuard(_)   : Some(String::from_str("a lock guard has no clone")),
        _                 : None,
    }
}

fn check_known_intrinsic(ref<Body, shared> b, StringView name, ref<Vec<Type>, shared> targs) : Option<Type>
{
    Option<Type> t0 = if (Vec::len(targs) > 0) { Some(apply_subst(&targs[0], &b.subst)) } else { None };
    if (StringView::eq_str(name, "sizeof") || StringView::eq_str(name, "alignof"))
    {
        return Some(Type::TInt(IntTy::Usize));
    }
    foreach (x in ["widen", "narrow", "narrow_wrapping", "reinterpret", "to_float", "to_int", "parse_value"])
    {
        if (StringView::eq_str(name, x))
        {
            return t0;
        }
    }
    // D-0122: the narrowed value, or `None`.
    if (StringView::eq_str(name, "checked_narrow"))
    {
        return match (t0)
        {
            Some(t) :
            {
                Vec<Type> a = Vec::new();
                Vec::push(&mut a, t);
                Some(named("std::Option", a))
            },
            None    : None,
        };
    }
    // D-0123: a count of bits.
    if (StringView::eq_str(
        name,
        "count_ones",
    ) || StringView::eq_str(name, "leading_zeros") || StringView::eq_str(name, "trailing_zeros"))
    {
        return Some(Type::TInt(IntTy::U32));
    }
    foreach (x in [
        "write_volatile",
        "drop",
        "release",
        "copy_raw",
        "deallocate",
        "append_native",
        "swap_places",
        "lend_places",
    ])
    {
        if (StringView::eq_str(name, x))
        {
            return Some(Type::TVoid);
        }
    }
    foreach (x in ["rawptr_of", "rawptr_from_address", "reinterpret_ptr", "dangling", "null_rawptr"])
    {
        if (StringView::eq_str(name, x))
        {
            return match (t0)
            {
                Some(t) : Some(rawptr_of(t)),
                None    : None,
            };
        }
    }
    if (StringView::eq_str(
        name,
        "rawptr_address",
    ) || StringView::eq_str(
        name,
        "str_len",
    ) || StringView::eq_str(name, "slice_len") || StringView::eq_str(name, "text_write"))
    {
        return Some(Type::TInt(IntTy::Usize));
    }
    // `[Allocate]` (spec/21 §3b): `Result<rawptr<u8>, AllocError>`.
    if (StringView::eq_str(name, "allocate"))
    {
        Vec<Type> a = Vec::new();
        Vec::push(&mut a, rawptr_of(Type::TInt(IntTy::U8)));
        Vec::push(&mut a, named("std::AllocError", Vec::new()));
        return Some(named("std::Result", a));
    }
    if (StringView::eq_str(name, "str_byte"))
    {
        return Some(Type::TInt(IntTy::U8));
    }
    if (StringView::eq_str(name, "parse_check"))
    {
        return Some(Type::TInt(IntTy::Isize));
    }
    if (StringView::eq_str(name, "key_hash"))
    {
        return Some(Type::TInt(IntTy::U64));
    }
    if (StringView::eq_str(
        name,
        "key_eq",
    ) || StringView::eq_str(name, "key_less") || StringView::eq_str(name, "key_less_at"))
    {
        return Some(Type::TBool);
    }
    if (StringView::eq_str(name, "str_ptr"))
    {
        return Some(rawptr_of(Type::TInt(IntTy::U8)));
    }
    // D-0134: a `str`'s bytes as a slice.
    if (StringView::eq_str(name, "str_slice"))
    {
        return Some(slice_of(Type::TInt(IntTy::U8), Mode::Shared));
    }
    None
}

// ---- part 9: typecheck.rs lines 5903-6322 ----

fn explicit_subst(ref<FnDecl, shared> f, ref<Vec<Type>, shared> explicit) : HashMap<String, Type>
{
    zip_subst(&f.type_params, explicit)
}

fn weakens_to(ref<Type, shared> arg, ref<Type, shared> param) : bool
{
    match (arg)
    {
        Type::TRef(a) : match (param)
        {
            Type::TRef(p) : Box::get(a).mode == Mode::Exclusive && Box::get(p).mode == Mode::Shared && type_eq(
                &Box::get(a).inner,
                &Box::get(p).inner,
            ),
            _ : false,
        },
        Type::TSlice(a) : match (param)
        {
            Type::TSlice(p) : Box::get(a).mode == Mode::Exclusive && Box::get(p).mode == Mode::Shared && type_eq(
                &Box::get(a).inner,
                &Box::get(p).inner,
            ),
            _ : false,
        },
        _ : false,
    }
}

fn is_bare_int_literal(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EInt(_) : true,
        ExprKind::EUnary(u) : Box::get(u).op == UnOp::Neg && match (&Box::get(u).e.kind)
        {
            ExprKind::EInt(_) : true,
            _                 : false,
        },
        _                 : false,
    }
}

fn all_fixed(ref<Vec<String>, shared> params, ref<HashMap<String, Type>, shared> m) : bool
{
    for (usize i = 0; i < Vec::len(params); i += 1)
    {
        if (!HashMap::contains(m, &params[i]))
        {
            return false;
        }
    }
    true
}

fn check_user_call(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> key,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, key), "a function");
    // `[T-Call]`: one argument per parameter.
    if (Vec::len(args) != Vec::len(&f.params))
    {
        return Err(mismatch(sprintf(
            "`%s` takes %v argument%s, but %v %s given",
            &fn_shown(f),
            Vec::len(&f.params),
            plural(Vec::len(&f.params)),
            Vec::len(args),
            is_are(Vec::len(args)),
        )));
    }
    Vec<Type> explicit = Vec::new();
    for (usize i = 0; i < Vec::len(targs); i += 1)
    {
        Vec::push(&mut explicit, apply_subst(&targs[i], &b.subst));
    }
    // Type arguments a function does not take.
    if (Vec::len(&explicit) > Vec::len(&f.type_params))
    {
        String std_key = sprintf("std::%s", &f_key(f));
        bool shadows = match (HashMap::get(&it.fns, &std_key))
        {
            Some(g) : !String::eq(&std_key, key) && Vec::len(&g.type_params) > 0,
            None    : false,
        };
        String msg = if (Vec::len(&f.type_params) == 0)
        {
            sprintf("`%s` takes no type arguments", &fn_shown(f))
        }
        else
        {
            sprintf(
                "`%s` takes %v type argument%s, but %v %s given",
                &fn_shown(f),
                Vec::len(&f.type_params),
                plural(Vec::len(&f.type_params)),
                Vec::len(&explicit),
                is_are(Vec::len(&explicit)),
            )
        };
        String hint = if (shadows)
        {
            sprintf(
                "; this is the program's own `%s`, which hides `%s` — write `%s<…>(…)` for the standard one",
                &fn_shown(f),
                &std_key,
                &std_key,
            )
        }
        else { String::new() };
        return Err(mismatch(sprintf("%s%s", &msg, &hint)));
    }
    HashSet<String> type_param_set = HashSet::new();
    for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
    {
        HashSet::insert(&mut type_param_set, String::clone(&f.type_params[i]));
    }
    // D-0079: an unsuffixed literal argument whose parameter is not yet
    // known is checked after the others.
    HashMap<String, Type> ex_subst = explicit_subst(f, &explicit);
    Vec<bool> deferred = Vec::new();
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        bool d = Vec::len(&f.type_params) > 0 && (is_bare_num_literal(&args[i]) || is_bare_str_literal(&args[i])) && i < Vec::len(&f.params) && mentions_any(
            &apply_subst(&f.params[i].ty, &ex_subst),
            &type_param_set,
        );
        Vec::push(&mut deferred, d);
    }
    Vec<usize> order = Vec::new();
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        if (!deferred[i])
        {
            Vec::push(&mut order, i);
        }
    }
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        if (deferred[i])
        {
            Vec::push(&mut order, i);
        }
    }
    Vec<Option<Type>> by_index = Vec::new();
    Vec<bool> checked = Vec::new();
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        Vec::push(&mut by_index, None);
        Vec::push(&mut checked, false);
    }
    bool ret_is_ref = match (&f.ret)
    {
        Type::TRef(_) : true,
        _             : false,
    };
    for (usize oi = 0; oi < Vec::len(&order); oi += 1)
    {
        usize i = order[oi];
        ref<Expr, shared> a = &args[i];
        // The type parameters the arguments already checked have fixed
        // count as known.
        HashMap<String, Type> known = explicit_subst(f, &explicit);
        for (usize j = 0; j < Vec::len(&by_index); j += 1)
        {
            if (checked[j] && j < Vec::len(&f.params))
            {
                match (&by_index[j])
                {
                    Some(t) :
                    {
                        if (!has_unresolved_marker(t))
                        {
                            unify_type_shape(&f.params[j].ty, t, &mut known, &f.type_params);
                        }
                    },
                    None    : {},
                }
            }
        }
        if (deferred[i])
        {
            match (expected)
            {
                Some(exp) :
                {
                    if (!has_unresolved_marker(exp))
                    {
                        unify_type_shape(&f.ret, exp, &mut known, &f.type_params);
                    }
                },
                None      : {},
            }
        }
        Option<Type> raw_hint = if (i < Vec::len(&f.params))
        {
            Some(apply_subst(
                &f.params[i].ty,
                &known,
            ))
        }
        else { None };
        bool poisoned = match (&raw_hint)
        {
            Some(t) : mentions_any(t, &type_param_set),
            None    : true,
        };
        Option<Type> hint = if (poisoned) { None } else { raw_hint };
        bool saved = b.infer_poisoned;
        if (poisoned)
        {
            b.infer_poisoned = true;
        }
        // D-0162: a text literal whose parameter is `String` once the
        // type parameters are fixed is that `String`.
        if (deferred[i] && is_bare_str_literal(a))
        {
            bool wants_string = match (&hint)
            {
                Some(t) : is_std_string(t),
                None    : false,
            };
            note_literal_as_string(b, a, wants_string);
            if (wants_string)
            {
                b.infer_poisoned = saved;
                by_index[i] = clone(&hint);
                checked[i] = true;
                continue;
            }
        }
        b.arg_temp_ok = !ret_is_ref;
        b.arg_ref_param = i < Vec::len(&f.params) && match (&f.params[i].ty)
        {
            Type::TRef(_)   : true,
            Type::TSlice(_) : true,
            _               : false,
        };
        Result<Option<Type>, String> r = check_store_operand(b, it, a, &hint);
        b.arg_temp_ok = false;
        b.arg_ref_param = false;
        b.infer_poisoned = saved;
        by_index[i] = r?;
        checked[i] = true;
    }
    Vec<Option<Type>> arg_types = by_index;
    if (Vec::len(&f.type_params) == 0)
    {
        // D-0006: every argument's type exactly matches its parameter.
        check_arg_exact_types(b, it, &f.params, args, &arg_types, &HashMap::new(), &type_param_set)?;
        record_instantiation(b, key, &Vec::new());
        return Ok(Some(clone(&f.ret)));
    }
    HashMap<String, Type> m = HashMap::new();
    for (usize i = 0; i < Vec::len(&f.type_params) && i < Vec::len(&explicit); i += 1)
    {
        HashMap::insert(&mut m, String::clone(&f.type_params[i]), clone(&explicit[i]));
    }
    if (!all_fixed(&f.type_params, &m))
    {
        for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(&arg_types); i += 1)
        {
            match (&arg_types[i])
            {
                Some(at) : unify_type_shape(&f.params[i].ty, at, &mut m, &f.type_params),
                None     : {},
            }
        }
    }
    if (!all_fixed(&f.type_params, &m))
    {
        match (expected)
        {
            Some(exp) : unify_type_shape(&f.ret, exp, &mut m, &f.type_params),
            None      : {},
        }
    }
    // D-0006: every concrete parameter, after what substitution is known.
    check_arg_exact_types(b, it, &f.params, args, &arg_types, &m, &type_param_set)?;
    if (all_fixed(&f.type_params, &m))
    {
        Vec<Type> targs_c = Vec::new();
        for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
        {
            Vec::push(&mut targs_c, clone(Option::expect(HashMap::get(&m, &f.type_params[i]), "a type argument")));
        }
        // `[Append-Not-Printable]`, `[Parse-Not-Numeric]` (spec/21 §2d):
        // `T` checked at the call.
        if (Vec::len(&targs_c) > 0 && !has_unresolved_marker(&targs_c[0]))
        {
            match (call_bound_problem(it, key, f, &targs_c))
            {
                Some(msg) : return Err(mismatch(msg)),
                None      : {},
            }
        }
        // D-0090: each bounded type parameter's type satisfies its bound.
        for (usize i = 0; i < Vec::len(&f.type_params) && i < Vec::len(&f.type_bounds) && i < Vec::len(&targs_c); i += 1)
        {
            Bound bd = match (f.type_bounds[i])
            {
                Some(x) : x,
                None    : continue,
            };
            ref<Type, shared> t = &targs_c[i];
            bool bare_marker = match (t)
            {
                Type::TNamed(nb) : Vec::len(&Box::get(nb).args) == 0 && String::starts_with(&Box::get(nb).name, "$"),
                _                : false,
            };
            bool ok = false;
            Option<String> why = None;
            if (bare_marker)
            {
                ok = match (HashMap::get(&b.marker_bounds, &Option::expect(marker_of(t), "a marker")))
                {
                    Some(have) : bound_implies(*have, bd),
                    None       : false,
                };
            }
            else if (bd == Bound::BClone)
            {
                why = clone_problem(b, it, t);
                ok = Option::is_none(&why);
            }
            else if (bd == Bound::BPlain)
            {
                why = plain_problem(b, it, t);
                ok = Option::is_none(&why);
            }
            else
            {
                ok = bound_holds(b, it, bd, t);
            }
            if (!ok)
            {
                String what = if (bare_marker)
                {
                    String mn = Option::expect(marker_of(t), "a marker");
                    String declared = match (HashMap::get(&b.marker_bounds, &mn))
                    {
                        Some(h) : sprintf(" (declared `%s`)", bound_name(*h)),
                        None    : String::from_str(" (declared without a bound)"),
                    };
                    sprintf(
                        "type parameter `%s`%s",
                        StringView::sub(String::as_view(&mn), 1, String::len(&mn)),
                        &declared,
                    )
                }
                else
                {
                    sprintf("`%s`", &type_display(t))
                };
                String tail = match (why)
                {
                    Some(w) : sprintf(": %s", &w),
                    None    : String::new(),
                };
                return Err(mismatch(sprintf(
                    "`%s` needs its `%s` to be `%s` (%s), and %s is not%s",
                    &f.name,
                    &f.type_params[i],
                    bound_name(bd),
                    bound_members(bd),
                    &what,
                    &tail,
                )));
            }
        }
        record_instantiation(b, key, &targs_c);
        return Ok(Some(apply_subst(&f.ret, &m)));
    }
    bool any_none = false;
    for (usize i = 0; i < Vec::len(&arg_types); i += 1)
    {
        if (Option::is_none(&arg_types[i]))
        {
            any_none = true;
        }
    }
    bool expected_open = match (expected)
    {
        Some(t) : has_unresolved_marker(t),
        None    : false,
    };
    if (b.infer_poisoned || expected_open || any_none)
    {
        // Not decidable by this pass.
        return Ok(None);
    }
    // `[Generic-Call-Uninferable]` (spec/15 §5).
    Vec<String> open = Vec::new();
    for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
    {
        if (!HashMap::contains(&m, &f.type_params[i]))
        {
            Vec::push(&mut open, sprintf("`%s`", &f.type_params[i]));
        }
    }
    String fname = f_key(f);
    Option<String> hint = None;
    // The usual cause: a value passed where the parameter is a reference.
    for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(&arg_types) && Option::is_none(&hint); i += 1)
    {
        match (&f.params[i].ty)
        {
            Type::TRef(pb) : match (&arg_types[i])
            {
                Some(t) :
                {
                    bool refish = match (t)
                    {
                        Type::TRef(_)   : true,
                        Type::TSlice(_) : true,
                        _               : false,
                    };
                    if (!refish)
                    {
                        bool excl = Box::get(pb).mode == Mode::Exclusive;
                        hint = Some(sprintf(
                            "argument %v is `%s`, not a reference, but `%s` takes %s: pass `%s…`",
                            i + 1,
                            &type_display(t),
                            &fname,
                            if (excl) { "an exclusive reference there" } else { "a reference there" },
                            if (excl) { "&mut " } else { "&" },
                        ));
                    }
                },
                None    : {},
            },
            _ : {},
        }
    }
    // Or an argument of another type altogether than its parameter.
    for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(&arg_types) && Option::is_none(&hint); i += 1)
    {
        match (&f.params[i].ty)
        {
            Type::TNamed(pnb) : match (&arg_types[i])
            {
                Some(t) :
                {
                    ref<String, shared> pn = &Box::get(pnb).name;
                    bool same_name = match (t)
                    {
                        Type::TNamed(anb) : String::eq(&Box::get(anb).name, pn),
                        _                 : false,
                    };
                    if (!HashSet::contains(&type_param_set, pn) && !has_unresolved_marker(t) && !same_name)
                    {
                        hint = Some(sprintf(
                            "argument %v is `%s`, but `%s` takes `%s` there",
                            i + 1,
                            &type_display(t),
                            &fname,
                            &type_display(&f.params[i].ty),
                        ));
                    }
                },
                None    : {},
            },
            _ : {},
        }
    }
    String advice = match (hint)
    {
        Some(h) : h,
        None : sprintf(
            "write `%s<%s>(…)`, or use the result where its type is declared",
            &fname,
            &String::join(&f.type_params[0..$], ", "),
        ),
    };
    Err(sprintf(
        "diag.cannot-infer-type-parameter\u{1}nothing here fixes %s of `%s`: %s",
        &String::join(&open[0..$], " and "),
        &fname,
        &advice,
    ))
}

// The checks `check_user_call` makes of a `std` function's `T` at the call
// (`[Append-Not-Printable]`, `[Parse-Not-Numeric]`, sorting, `[Key-Not-
// Hashable]`).
fn call_bound_problem(
    ref<Items, shared> it,
    ref<String, shared> key,
    ref<FnDecl, shared> f,
    ref<Vec<Type>, shared> targs_c,
) : Option<String>
{
    ref<Type, shared> t = &targs_c[0];
    if (String::eq_str(key, "std::String::append"))
    {
        if (is_printable(t))
        {
            return None;
        }
        if (named_is(t, "std::String"))
        {
            return Some(String::from_str("`String::append` takes a `String` by reference, not by value: `String::append(&mut out, &s)` (a call's result too: `&sprintf(...)`)"));
        }
        match (t)
        {
            Type::TRef(rb) :
            {
                if (is_printable(&Box::get(rb).inner))
                {
                    return Some(sprintf(
                        "`String::append` takes a `String` by reference, and anything else it writes by value: pass `*r` for this `%s`",
                        &type_display(t),
                    ));
                }
            },
            _              : {},
        }
        return Some(sprintf(
            "`String::append` writes a number, a `bool`, a `str` or a `StringView`, or a `String` by reference (`&s`); `%s` is none of these",
            &type_display(t),
        ));
    }
    if (String::eq_str(key, "std::String::parse"))
    {
        // D-0181: `bool` too.
        bool ok = match (t)
        {
            Type::TInt(_) : true,
            Type::TF32    : true,
            Type::TF64    : true,
            Type::TBool   : true,
            _             : false,
        };
        return if (ok) { None } else
        {
            Some(sprintf(
                "`String::parse` reads a number or a `bool`; `%s` is neither",
                &type_display(t),
            ))
        };
    }
    if (String::eq_str(key, "std::Vec::sort") || String::eq_str(key, "std::Vec::binary_search"))
    {
        if (is_sort_type(it, t))
        {
            return None;
        }
        return Some(sprintf(
            "`Vec::%s` orders by the key types' own order (integers, `bool`, `str`, `String`, and structs and enums of them) or a float's; `%s` is not one%s, so pass the order: `Vec::%s_by`",
            &f.name,
            &type_display(t),
            &key_problem_text(it, t),
            &f.name,
        ));
    }
    if (String::eq_str(key, "std::PriorityQueue::new"))
    {
        if (is_sort_type(it, t))
        {
            return None;
        }
        return Some(sprintf(
            "`PriorityQueue::new` orders by the key types' own order (integers, `bool`, `str`, `String`, and structs and enums of them) or a float's; `%s` is not one%s, so pass the order: `PriorityQueue::new_by`",
            &type_display(t),
            &key_problem_text(it, t),
        ));
    }
    match (&f.assoc_type)
    {
        Some(a) :
        {
            if ((String::eq_str(
                a,
                "HashMap",
            ) || String::eq_str(a, "HashSet")) && String::eq(key, &sprintf("std::%s::%s", a, &f.name)))
            {
                // `[Key-Not-Hashable]` (spec/21 §1a): `K` at every call.
                for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
                {
                    if (String::eq_str(&f.type_params[i], "K"))
                    {
                        ref<Type, shared> k = &targs_c[i];
                        if (!has_unresolved_marker(k) && !is_key_type(it, k))
                        {
                            return Some(sprintf(
                                "a `%s` key is an integer, `bool`, `str`, `String`, or a struct or enum of them; `%s` is not one%s",
                                a,
                                &type_display(k),
                                &key_problem_text(it, k),
                            ));
                        }
                        return None;
                    }
                }
            }
        },
        None    : {},
    }
    None
}

// D-0006: a concrete parameter type exactly matches its argument's type.
fn check_arg_exact_types(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<Vec<ParamDecl>, shared> params,
    ref<Vec<Expr>, shared> args,
    ref<Vec<Option<Type>>, shared> arg_types,
    ref<HashMap<String, Type>, shared> subst,
    ref<HashSet<String>, shared> type_param_set,
) : Result<void, String>
{
    for (usize i = 0; i < Vec::len(params); i += 1)
    {
        ref<ParamDecl, shared> p = &params[i];
        // A value where the parameter is a reference is wrong whatever the
        // type parameters are.
        match (&p.ty)
        {
            Type::TRef(rb) :
            {
                Option<String> shown = match (arg_ty(arg_types, i))
                {
                    Some(at) :
                    {
                        bool skip = match (&at)
                        {
                            Type::TRef(_) : true,
                            Type::TNever  : true,
                            _             : is_marker(&at),
                        };
                        if (skip) { None } else { Some(sprintf("`%s`", &type_display(&at))) }
                    },
                    None     :
                    {
                        if (i < Vec::len(arg_types) && i < Vec::len(args) && plainly_a_value(
                            b,
                            it,
                            &args[i],
                        )) { Some(String::from_str("a value")) } else { None }
                    },
                };
                match (shown)
                {
                    Some(sh) :
                    {
                        bool excl = Box::get(rb).mode == Mode::Exclusive;
                        return Err(mismatch(sprintf(
                            "argument %v (`%s`) is %s, not a reference, but the parameter is `%s`: pass `%s…`",
                            i + 1,
                            &p.name,
                            &sh,
                            &type_display(&apply_subst(&p.ty, subst)),
                            if (excl) { "&mut " } else { "&" },
                        )));
                    },
                    None     : {},
                }
            },
            _              : {},
        }
        Type pty = apply_subst(&p.ty, subst);
        if (mentions_any(&pty, type_param_set))
        {
            continue;
        }
        // A bare integer literal takes the parameter's type where it could.
        bool literal_fits = match (&pty)
        {
            Type::TInt(_)    : true,
            Type::TF32       : true,
            Type::TF64       : true,
            Type::TNamed(nb) : Vec::len(&Box::get(nb).args) == 0 && String::starts_with(&Box::get(nb).name, "$"),
            _                : false,
        };
        if (i < Vec::len(args) && is_bare_int_literal(&args[i]) && literal_fits)
        {
            continue;
        }
        match (arg_ty(arg_types, i))
        {
            Some(at) :
            {
                if (!type_eq(&pty, &at) && !weakens_to(&at, &pty))
                {
                    Option<ref<Expr, shared>> ae = if (i < Vec::len(args)) { Some(&args[i]) } else { None };
                    return Err(mismatch(sprintf(
                        "argument %v (`%s`) is `%s`, but the parameter is `%s`%s",
                        i + 1,
                        &p.name,
                        &type_display(&at),
                        &type_display(&pty),
                        &conversion_hint(&pty, &at, ae),
                    )));
                }
            },
            None     : {},
        }
    }
    Ok(())
}

fn check_struct_lit(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Vec<String>, shared> segs,
    ref<Vec<Type>, shared> targs,
    ref<Vec<FieldInit>, shared> fields,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    String name = String::join(&segs[0..$], "::");
    ref<StructDecl, shared> sdecl = match (HashMap::get(&it.structs, &name))
    {
        Some(s) : s,
        None    :
        {
            for (usize i = 0; i < Vec::len(fields); i += 1)
            {
                check_store_operand(b, it, &fields[i].value, &None)?;
            }
            return Ok(None);
        },
    };
    HashMap<String, Type> m = HashMap::new();
    for (usize i = 0; i < Vec::len(&sdecl.type_params) && i < Vec::len(targs); i += 1)
    {
        HashMap::insert(&mut m, String::clone(&sdecl.type_params[i]), apply_subst(&targs[i], &b.subst));
    }
    if (!all_fixed(&sdecl.type_params, &m))
    {
        match (expected)
        {
            Some(exp) :
            {
                Vec<Type> gargs = Vec::new();
                for (usize i = 0; i < Vec::len(&sdecl.type_params); i += 1)
                {
                    Vec::push(&mut gargs, named(String::as_view(&sdecl.type_params[i]), Vec::new()));
                }
                Type generic_self = named(String::as_view(&name), gargs);
                unify_type_shape(&generic_self, exp, &mut m, &sdecl.type_params);
            },
            None      : {},
        }
    }
    String shown_ty = type_display(&named(String::as_view(&name), Vec::new()));
    HashSet<String> seen = HashSet::new();
    for (usize fi = 0; fi < Vec::len(fields); fi += 1)
    {
        ref<String, shared> fname = &fields[fi].name;
        ref<Expr, shared> fexpr = &fields[fi].value;
        if (!HashSet::insert(&mut seen, String::clone(fname)))
        {
            return Err(mismatch(sprintf("field `%s` of `%s` is given twice", fname, &shown_ty)));
        }
        Option<usize> idx = None;
        for (usize k = 0; k < Vec::len(&sdecl.fields); k += 1)
        {
            if (String::eq(&sdecl.fields[k].name, fname))
            {
                idx = Some(k);
                break;
            }
        }
        usize ix = match (idx)
        {
            Some(k) : k,
            None    : return Err(mismatch(sprintf("`%s` has no field `%s`", &shown_ty, fname))),
        };
        if (!field_visible(String::as_view(&name), sdecl.fields[ix].export_, String::as_view(&b.module_)))
        {
            String msg = sprintf("field `%s` of `%s` is not exported", fname, &shown_ty);
            return Err(named_diag("diag.name-not-visible", &msg));
        }
        HashSet<String> remaining = HashSet::new();
        for (usize k = 0; k < Vec::len(&sdecl.type_params); k += 1)
        {
            if (!HashMap::contains(&m, &sdecl.type_params[k]))
            {
                HashSet::insert(&mut remaining, String::clone(&sdecl.type_params[k]));
            }
        }
        Type hint = apply_subst(&sdecl.fields[ix].ty, &m);
        Option<Type> at = None;
        if (mentions_any(&hint, &remaining))
        {
            bool saved = b.infer_poisoned;
            b.infer_poisoned = true;
            Result<Option<Type>, String> r0 = check_store_operand(b, it, fexpr, &None);
            b.infer_poisoned = saved;
            Option<Type> r = r0?;
            // `[T-Struct]` by shape.
            match (&r)
            {
                Some(t) :
                {
                    if (!is_never(t) && shape_conflict(&hint, t, &remaining))
                    {
                        return Err(mismatch(sprintf(
                            "field `%s` of `%s` is `%s`, but the value is `%s`",
                            fname,
                            &shown_ty,
                            &type_display(&hint),
                            &type_display(t),
                        )));
                    }
                },
                None    : {},
            }
            at = r;
        }
        else
        {
            Option<Type> t = check_store_operand(b, it, fexpr, &Some(clone(&hint)))?;
            // `[T-Struct]`: the value has the field's type.
            match (&t)
            {
                Some(tt) :
                {
                    if (!has_unresolved_marker(tt) && !has_unresolved_marker(&hint) && !is_never(tt) && !ty_compat(
                        tt,
                        &hint,
                    ))
                    {
                        return Err(mismatch(sprintf(
                            "field `%s` of `%s` is `%s`, but the value is `%s`",
                            fname,
                            &shown_ty,
                            &type_display(&hint),
                            &type_display(tt),
                        )));
                    }
                },
                None     : {},
            }
            at = t;
        }
        match (&at)
        {
            Some(a) :
            {
                if (!has_unresolved_marker(a))
                {
                    unify_type_shape(&sdecl.fields[ix].ty, a, &mut m, &sdecl.type_params);
                }
            },
            None    : {},
        }
        // D-0118: a bit field's initial value must fit its width.
        match (sdecl.fields[ix].width)
        {
            Some(w) : check_bitfield_literal(b, fexpr, w, &sprintf("field `%s` of `%s`", fname, short_name(&name)))?,
            None    : {},
        }
    }
    if (HashSet::len(&seen) != Vec::len(&sdecl.fields))
    {
        return Err(String::from_str("diag.type-mismatch"));
    }
    if (all_fixed(&sdecl.type_params, &m))
    {
        Vec<Type> targs_c = Vec::new();
        for (usize i = 0; i < Vec::len(&sdecl.type_params); i += 1)
        {
            Vec::push(&mut targs_c, clone(Option::expect(HashMap::get(&m, &sdecl.type_params[i]), "a type argument")));
        }
        return Ok(Some(named(String::as_view(&name), targs_c)));
    }
    Ok(None)
}

// ---- part 10: typecheck.rs lines 6322-6930 and the file's end ----

fn arm_chain(ref<Arm, shared> a) : Vec<String>
{
    Vec<String> c = Vec::new();
    match (&a.variant)
    {
        Some(v) : Vec::push(&mut c, String::clone(v)),
        None    : {},
    }
    for (usize i = 0; i < Vec::len(&a.nested); i += 1)
    {
        Vec::push(&mut c, String::clone(&a.nested[i]));
    }
    c
}

fn is_int_or_bool(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TInt(_) : true,
        Type::TBool   : true,
        _             : false,
    }
}

// `str`, `String` or `StringView`: a level a text literal is matched
// against (D-0127).
export fn is_text_ty(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TStr : true,
        Type::TNamed(nb) : String::eq_str(
            &Box::get(nb).name,
            "std::String",
        ) || String::eq_str(&Box::get(nb).name, "std::StringView"),
        _          : false,
    }
}

fn is_enum_ty(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(nb) : HashMap::contains(&it.enums, &Box::get(nb).name),
        _                : false,
    }
}

// The payload type of variant `vn` of the enum type `t` (`None` inside for
// a variant without one); `None` when `t` is not an enum with it.
fn variant_payload(ref<Items, shared> it, ref<Type, shared> t, ref<String, shared> vn) : Option<Option<Type>>
{
    ref<NamedTy, shared> n = match (t)
    {
        Type::TNamed(nb) : Box::get(nb),
        _                : return None,
    };
    ref<EnumDecl, shared> e = HashMap::get(&it.enums, &n.name)?;
    usize vi = variant_index_of(e, vn)?;
    HashMap<String, Type> sub = zip_subst(&e.type_params, &n.args);
    match (&e.variants[vi].payload)
    {
        Some(p) : Some(Some(apply_subst(p, &sub))),
        None    : Some(None),
    }
}

fn detail_err(String m) : Result<Option<Type>, String>
{
    Err(sprintf("diag.type-mismatch\u{1}%s", &m))
}

// Rust's `{:?}` of a string: quoted, with `\\`, `"` and the control
// characters escaped.
fn debug_str(ref<String, shared> t) : String
{
    String o = String::from_str("\"");
    Vec<StringView> cs = String::chars(t);
    for (usize i = 0; i < Vec::len(&cs); i += 1)
    {
        StringView c = cs[i];
        u32 cp = Option::unwrap_or(StringView::code_point(c), 0);
        if (StringView::eq_str(c, "\""))
        {
            String::append(&mut o, "\\\"");
        }
        else if (StringView::eq_str(c, "\\"))
        {
            String::append(&mut o, "\\\\");
        }
        else if (cp == 10)
        {
            String::append(&mut o, "\\n");
        }
        else if (cp == 13)
        {
            String::append(&mut o, "\\r");
        }
        else if (cp == 9)
        {
            String::append(&mut o, "\\t");
        }
        else if (cp == 0)
        {
            String::append(&mut o, "\\0");
        }
        else if (cp < 32 || cp == 127)
        {
            String::appendf(&mut o, "\\u{%x}", cp);
        }
        else
        {
            String::append(&mut o, c);
        }
    }
    String::append(&mut o, "\"");
    o
}

// A pattern literal's value as text: `-3`, `97` for `b'a'`, `true`.
export fn literal_key(ref<Expr, shared> l) : String
{
    match (&l.kind)
    {
        ExprKind::EInt(lb) : sprintf("%v", Box::get(lb).v),
        ExprKind::EUnary(ub) : match (&Box::get(ub).e.kind)
        {
            ExprKind::EInt(lb) : if (Box::get(ub).op == UnOp::Neg)
            {
                sprintf(
                    "-%v",
                    Box::get(lb).v,
                )
            }
            else { String::new() },
            _ : String::new(),
        },
        ExprKind::EBool(v) : String::from_str(if (*v) { "true" } else { "false" }),
        // D-0127: a text literal, quoted (distinct from every number).
        ExprKind::EStr(t)  : debug_str(t),
        _                  : String::new(),
    }
}

// An arm's pattern as elements: its variants, then its literal as `=`
// and the literal's value (D-0057).
fn pattern_elems(ref<Arm, shared> a) : Vec<String>
{
    Vec<String> e = arm_chain(a);
    match (&a.lit)
    {
        Some(l) : Vec::push(&mut e, sprintf("=%s", &literal_key(Box::get(l)))),
        None    : {},
    }
    e
}

// `Ok(Some(_))` for the elements `Ok`, `Some` whose last variant has a
// payload; a literal element is written as its value.
fn render_pattern(ref<Vec<String>, shared> chain, bool payload) : String
{
    if (Vec::len(chain) == 0)
    {
        return String::from_str("_");
    }
    Vec<StringView> shown = Vec::new();
    for (usize i = 0; i < Vec::len(chain); i += 1)
    {
        StringView e = String::as_view(&chain[i]);
        Vec::push(&mut shown, Option::unwrap_or(StringView::strip_prefix(e, "="), e));
    }
    String s = StringView::join(&shown[0..$], "(");
    if (payload)
    {
        String::append(&mut s, "(_)");
    }
    for (usize i = 1; i < Vec::len(chain); i += 1)
    {
        String::append(&mut s, ")");
    }
    s
}

fn starts_with_elems(ref<Vec<String>, shared> whole, ref<Vec<String>, shared> prefix) : bool
{
    if (Vec::len(prefix) > Vec::len(whole))
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(prefix); i += 1)
    {
        if (!String::eq(&whole[i], &prefix[i]))
        {
            return false;
        }
    }
    true
}

// The type of the level after the pattern elements `elems` in `t0`.
fn elems_type(ref<Items, shared> it, ref<Type, shared> t0, ref<Vec<String>, shared> elems) : Option<Type>
{
    Option<Type> t = Some(clone(t0));
    for (usize i = 0; i < Vec::len(elems); i += 1)
    {
        if (String::starts_with(&elems[i], "="))
        {
            return None;
        }
        // D-0109: a reference to an enum is matched through.
        Option<Type> level = match (t)
        {
            Some(Type::TRef(rb)) :
            {
                Type inner = Box::into_inner(rb).inner;
                if (is_enum_ty(it, &inner)) { Some(inner) } else { Some(ref_of(inner, Mode::Shared)) }
            },
            other                : other,
        };
        Type lv = level?;
        if (!is_enum_ty(it, &lv))
        {
            return None;
        }
        t = variant_payload(it, &lv, &elems[i])?;
    }
    t
}

// D-0056/D-0057: a value whose pattern elements begin with `prefix` that
// none of `arms` matches, written as a pattern; `None` when the arms
// match every such value.
fn pattern_missing(
    ref<Items, shared> it,
    ref<Vec<String>, shared> prefix,
    Option<Type> t,
    ref<Vec<Vec<String>>, shared> arms,
    bool payload,
) : Option<String>
{
    for (usize i = 0; i < Vec::len(arms); i += 1)
    {
        if (Vec::len(&arms[i]) <= Vec::len(prefix) && starts_with_elems(prefix, &arms[i]))
        {
            return None;
        }
    }
    bool extends = false;
    for (usize i = 0; i < Vec::len(arms); i += 1)
    {
        if (Vec::len(&arms[i]) > Vec::len(prefix) && starts_with_elems(&arms[i], prefix))
        {
            extends = true;
        }
    }
    if (!extends)
    {
        return Some(render_pattern(prefix, payload));
    }
    // D-0109: below the first level, a reference to an enum (or a `bool`)
    // is split as its referent is.
    Option<Type> tt = match (t)
    {
        Some(Type::TRef(rb)) :
        {
            Type inner = Box::into_inner(rb).inner;
            if (Vec::len(prefix) > 0 && (is_enum_ty(
                it,
                &inner,
            ) || type_eq(&inner, &Type::TBool))) { Some(inner) } else { Some(ref_of(inner, Mode::Shared)) }
        },
        other                : other,
    };
    match (&tt)
    {
        Some(Type::TNamed(nb)) :
        {
            if (HashMap::contains(&it.enums, &Box::get(nb).name))
            {
                ref<EnumDecl, shared> e = Option::expect(HashMap::get(&it.enums, &Box::get(nb).name), "an enum");
                ref<Type, shared> level = Option::expect(match (&tt)
                {
                    Some(x) : Some(x),
                    None    : None,
                }, "a level");
                for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                {
                    Vec<String> p = Vec::clone(prefix);
                    Vec::push(&mut p, String::clone(&e.variants[i].name));
                    Option<Type> pt = variant_payload(it, level, &e.variants[i].name)?;
                    bool has = Option::is_some(&pt);
                    match (pattern_missing(it, &p, pt, arms, has))
                    {
                        Some(m) : return Some(m),
                        None    : {},
                    }
                }
                return None;
            }
            Some(render_pattern(prefix, payload))
        },
        Some(Type::TBool)      :
        {
            foreach (bv in ["=true", "=false"])
            {
                Vec<String> p = Vec::clone(prefix);
                Vec::push(&mut p, String::from_str(bv));
                match (pattern_missing(it, &p, None, arms, false))
                {
                    Some(m) : return Some(m),
                    None    : {},
                }
            }
            None
        },
        _                      : Some(render_pattern(prefix, payload)),
    }
}

// The place a match by reference looks into.
fn match_referent(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> scrut) : Option<Place>
{
    match (&strip_parens_tc(scrut).kind)
    {
        ExprKind::EBorrow(bb) : borrowed_place(b, it, &Box::get(bb).e),
        ExprKind::EPath(_)    :
        {
            String x = single_tracked(b, strip_parens_tc(scrut))?;
            match (HashMap::get(&b.gamma, &x)?)
            {
                Type::TRef(_) : Some(Place { .root = referent_root(String::as_view(&x)), .path = Vec::new() }),
                _             : None,
            }
        },
        _                     : None,
    }
}

fn weaker_into(ref<Vec<Option<Mode>>, exclusive> crossed, Mode m)
{
    usize n = Vec::len(crossed);
    Mode w = weaker_mode(crossed[n - 1], m);
    crossed[n - 1] = Some(w);
}

// Exhaustiveness (`rule.agg.match`) checked statically when the
// scrutinee's enum is known.
fn check_match(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> whole,
    ref<Expr, shared> scrut,
    ref<Vec<Arm>, shared> arms,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // The scrutinee is a place position (spec/13 §1).
    b.place_pos = true;
    Option<HandleHolder> hand = handle_holder_of(b, it, scrut);
    if (Option::is_some(&hand))
    {
        mark_taken(b, it, scrut);
    }
    Option<Type> st0 = check_expr(b, it, scrut, &None)?;
    // D-0218: a scrutinee that is an exclusive reference read through a
    // shared one is a shared borrow.
    bool scrut_shared = crosses_shared(b, it, scrut);
    Option<Type> st = match (st0)
    {
        Some(Type::TRef(rb)) :
        {
            if (Box::get(&rb).mode == Mode::Exclusive && scrut_shared)
            {
                if (b.facts.silent)
                {
                    return Err(named_diag(
                        "diag.borrow-exceeds-source",
                        &String::from_str("an exclusive reference read through a shared reference in a body checked after the program was built"),
                    ));
                }
                note_rewrite(b, scrut, Rewrite::SharedRef);
                Some(ref_of(Box::into_inner(rb).inner, Mode::Shared))
            }
            else
            {
                Some(Type::TRef(rb))
            }
        },
        other                : other,
    };
    // D-0049: a resource binding matched by value is consumed only by an
    // arm that moves its payload out.
    Option<String> consume_x = None;
    if (Option::is_none(&place_of(b, it, scrut)))
    {
        match (deref_place_of(b, it, scrut))
        {
            Some(p) : flow_clash(b, it, &p.root, &p.path, Mode::Shared, "diag.aliasing-conflict")?,
            None    : {},
        }
    }
    match (place_of(b, it, scrut))
    {
        Some(p) :
        {
            if (!tri_is(&b.flow.init, &p.root, Tri::T))
            {
                refute(b, &uninit_msg(String::as_view(&p.root)))?;
            }
            flow_clash(b, it, &p.root, &p.path, Mode::Shared, "diag.aliasing-conflict")?;
            if (Vec::len(&p.path) == 0 && place_is_resource(b, it, &p.root, &Vec::new()))
            {
                consume_x = Some(String::clone(&p.root));
            }
        },
        None    : {},
    }
    Option<Type> enum_named = match (&st)
    {
        Some(t) :
        {
            if (is_enum_ty(it, t))
            {
                Some(clone(t))
            }
            else
            {
                match (t)
                {
                    Type::TRef(rb) : if (is_enum_ty(
                        it,
                        &Box::get(rb).inner,
                    )) { Some(clone(&Box::get(rb).inner)) } else { None },
                    _ : None,
                }
            }
        },
        None    : None,
    };
    // `[Match-By-Ref]` (D-0046).
    Option<Mode> by_ref = match (&st)
    {
        Some(Type::TRef(rb)) : Some(Box::get(rb).mode),
        _                    : None,
    };
    // D-0056/D-0057: each arm's pattern, typed level by level.
    Option<Type> level0 = match (&enum_named)
    {
        Some(t) : Some(clone(t)),
        None : match (&st)
        {
            Some(t) : if (is_int_or_bool(t) || is_text_ty(t)) { Some(clone(t)) } else { None },
            None    : None,
        },
    };
    // A reference to an integer, `bool` or text has no variants.
    bool any_pattern = false;
    for (usize i = 0; i < Vec::len(arms); i += 1)
    {
        if (Option::is_some(&arms[i].variant) || Option::is_some(&arms[i].lit))
        {
            any_pattern = true;
        }
    }
    if (Option::is_none(&level0) && any_pattern)
    {
        match (&st)
        {
            Some(Type::TRef(rb)) :
            {
                ref<Type, shared> inner = &Box::get(rb).inner;
                if (is_int_or_bool(inner) || is_text_ty(inner))
                {
                    return Err(sprintf("diag.type-mismatch\u{1}a literal is matched against a reference, `%s`: `match (*r)` reads the value", &type_display(Option::expect(match (&st)
                    {
                        Some(x) : Some(x),
                        None    : None,
                    }, "a type"))));
                }
            },
            _                    : {},
        }
    }
    Vec<Option<Type>> binder_ty = Vec::new();
    // D-0109: the mode of the references each arm's pattern looks through.
    Vec<Option<Mode>> crossed = Vec::new();
    for (usize ai = 0; ai < Vec::len(arms); ai += 1)
    {
        ref<Arm, shared> arm = &arms[ai];
        Vec::push(&mut crossed, None);
        // D-0058: a binder alone binds the whole scrutinee.
        if (Option::is_none(&arm.variant) && Option::is_none(&arm.lit) && Option::is_some(&arm.binder))
        {
            Option<Type> bt = match (&st)
            {
                Some(Type::TRef(rb)) : if (Option::is_some(&by_ref)) { Some(clone(&Box::get(rb).inner)) } else { clone(&st) },
                _                    : clone(&st),
            };
            Vec::push(&mut binder_ty, bt);
            continue;
        }
        Type t0 = match (&level0)
        {
            Some(t) : clone(t),
            None    :
            {
                // A scrutinee this pass knows that is not an enum, an
                // integer, `bool` or text has no value a pattern names.
                match (&st)
                {
                    Some(t) :
                    {
                        match (&arm.lit)
                        {
                            Some(l) : return detail_err(sprintf(
                                "the literal `%s` is matched against `%s`, which is not an integer, `bool` or text",
                                &literal_key(Box::get(l)),
                                &type_display(t),
                            )),
                            None : {},
                        }
                        match (&arm.variant)
                        {
                            Some(v) : return detail_err(sprintf(
                                "the pattern `%s` is matched against `%s`, which is not an enum",
                                v,
                                &type_display(t),
                            )),
                            None : {},
                        }
                    },
                    None    : {},
                }
                Vec::push(&mut binder_ty, None);
                continue;
            },
        };
        Option<Type> cur = Some(t0);
        Vec<String> chain = arm_chain(arm);
        for (usize k = 0; k < Vec::len(&chain); k += 1)
        {
            ref<String, shared> vn = &chain[k];
            // D-0109: a level below the first that is a reference to an
            // enum is matched through the reference.
            if (k > 0)
            {
                match (clone(&cur))
                {
                    Some(Type::TRef(rb)) :
                    {
                        ModedTy { inner, mode } = Box::into_inner(rb);
                        if (is_enum_ty(it, &inner))
                        {
                            weaker_into(&mut crossed, mode);
                            cur = Some(inner);
                        }
                        else
                        {
                            cur = Some(ref_of(inner, mode));
                        }
                    },
                    _                    : {},
                }
            }
            Type level = match (&cur)
            {
                Some(c) :
                {
                    if (is_enum_ty(it, c))
                    {
                        clone(c)
                    }
                    else
                    {
                        return detail_err(sprintf(
                            "the pattern `%s` is matched against `%s`, which is not an enum",
                            vn,
                            &type_display(c),
                        ));
                    }
                },
                None    : return Err(String::from_str("diag.type-mismatch")),
            };
            match (variant_payload(it, &level, vn))
            {
                Some(p) : cur = p,
                None    : return detail_err(sprintf("`%s` is not a variant of `%s`", vn, &type_display(&level))),
            }
        }
        // D-0109: a literal below a variant compares through a reference.
        if (Option::is_some(&arm.lit) && Vec::len(&chain) > 0)
        {
            match (clone(&cur))
            {
                Some(Type::TRef(rb)) :
                {
                    ModedTy { inner, mode } = Box::into_inner(rb);
                    if (is_int_or_bool(&inner) || is_text_ty(&inner))
                    {
                        weaker_into(&mut crossed, mode);
                        cur = Some(inner);
                    }
                    else
                    {
                        cur = Some(ref_of(inner, mode));
                    }
                },
                _                    : {},
            }
        }
        match (&arm.lit)
        {
            Some(lb) :
            {
                ref<Expr, shared> l = Box::get(lb);
                Type lt = match (&cur)
                {
                    Some(c) :
                    {
                        if (is_int_or_bool(c) || is_text_ty(c))
                        {
                            clone(c)
                        }
                        else
                        {
                            return detail_err(sprintf(
                                "the literal `%s` is matched against `%s`, which is not an integer, `bool` or text",
                                &literal_key(l),
                                &type_display(c),
                            ));
                        }
                    },
                    None    : return Err(String::from_str("diag.type-mismatch")),
                };
                // D-0127: a text level takes a text literal and nothing else.
                bool text_lit = match (&l.kind)
                {
                    ExprKind::EStr(_) : true,
                    _                 : false,
                };
                if (is_text_ty(&lt) != text_lit)
                {
                    return detail_err(sprintf(
                        "the literal `%s` is not of type `%s`",
                        &literal_key(l),
                        &type_display(&lt),
                    ));
                }
                if (is_text_ty(&lt))
                {
                    Vec::push(&mut binder_ty, None);
                    continue;
                }
                // A constant in a pattern must fold to a literal (D-0058).
                bool folded = match (&l.kind)
                {
                    ExprKind::EInt(_)  : true,
                    ExprKind::EBool(_) : true,
                    ExprKind::EUnary(ub) : Box::get(ub).op == UnOp::Neg && match (&Box::get(ub).e.kind)
                    {
                        ExprKind::EInt(_) : true,
                        _                 : false,
                    },
                    _                  : false,
                };
                if (!folded)
                {
                    return Err(String::from_str("diag.type-mismatch"));
                }
                match (check_expr(b, it, l, &Some(clone(&lt)))?)
                {
                    Some(t) :
                    {
                        if (!type_eq(&t, &lt))
                        {
                            return Err(String::from_str("diag.type-mismatch"));
                        }
                    },
                    None    : return Err(String::from_str("diag.type-mismatch")),
                }
            },
            None     : {},
        }
        Vec::push(&mut binder_ty, if (Option::is_some(&arm.binder)) { cur } else { None });
    }
    // `[Match-Move-Through-Ref]` (spec/16 §4).
    if (Option::is_none(&by_ref) && scrut_shared)
    {
        for (usize i = 0; i < Vec::len(&binder_ty); i += 1)
        {
            bool holds = match (&binder_ty[i])
            {
                Some(t) : match (crossed[i])
                {
                    None                  : holds_excl_ref(it, t, 0),
                    Some(Mode::Exclusive) : true,
                    _                     : false,
                },
                None : false,
            };
            if (holds)
            {
                return Err(named_diag(
                    "diag.borrow-exceeds-source",
                    &String::from_str("this binds a payload that holds an exclusive reference by value, out of a value reached through a shared reference (D-0218): the copy could write what the shared reference reaches; match on the reference (`match (r)` or `match (&e)`) to bind it shared"),
                ));
            }
        }
    }
    bool through_ref_or_projection = Option::is_none(&by_ref) && match (&scrut.kind)
    {
        ExprKind::EDeref(_) : true,
        ExprKind::EField(_) : true,
        ExprKind::EIndex(_) : true,
        _                   : false,
    };
    if (through_ref_or_projection)
    {
        for (usize i = 0; i < Vec::len(&binder_ty); i += 1)
        {
            if (Option::is_none(&crossed[i]))
            {
                match (&binder_ty[i])
                {
                    Some(bt) :
                    {
                        if (is_resource_ty(it, bt))
                        {
                            String msg = sprintf(
                                "a `%s` payload cannot be moved out through a reference or out of part of a value; match on `&e` to borrow it, or `replace` the whole value first",
                                &type_display(bt),
                            );
                            return Err(named_diag("diag.move-out-of-field", &msg));
                        }
                    },
                    None     : {},
                }
            }
        }
    }
    // `[Match-Non-Exhaustive]` and `[Match-Unreachable]` (D-0056).
    match (&level0)
    {
        Some(t0) :
        {
            Vec<Vec<String>> chains = Vec::new();
            for (usize i = 0; i < Vec::len(arms); i += 1)
            {
                Vec::push(&mut chains, pattern_elems(&arms[i]));
            }
            for (usize k = 1; k < Vec::len(&chains); k += 1)
            {
                Option<Type> tk = elems_type(it, t0, &chains[k]);
                Vec<Vec<String>> earlier = Vec::new();
                for (usize j = 0; j < k; j += 1)
                {
                    Vec::push(&mut earlier, Vec::clone(&chains[j]));
                }
                if (Option::is_none(&pattern_missing(it, &chains[k], tk, &earlier, false)))
                {
                    // An earlier arm whose binder is capitalised most likely
                    // meant a variant that does not exist.
                    Option<String> hint = None;
                    for (usize j = 0; j < k && Option::is_none(&hint); j += 1)
                    {
                        match (&arms[j].binder)
                        {
                            Some(bn) :
                            {
                                u8 first = if (String::len(bn) > 0) { String::as_bytes(bn)[0] } else { 0 };
                                if (first >= b'A' && first <= b'Z')
                                {
                                    Option<Type> inner = elems_type(it, t0, &chains[j]);
                                    Option<String> variants = match (&inner)
                                    {
                                        Some(Type::TNamed(nb)) : match (HashMap::get(&it.enums, &Box::get(nb).name))
                                        {
                                            Some(e) :
                                            {
                                                Vec<String> vs = Vec::new();
                                                for (usize v = 0; v < Vec::len(&e.variants); v += 1)
                                                {
                                                    Vec::push(&mut vs, sprintf("`%s`", &e.variants[v].name));
                                                }
                                                Some(String::join(&vs[0..$], ", "))
                                            },
                                            None    : None,
                                        },
                                        _ : None,
                                    };
                                    hint = Some(match (variants)
                                    {
                                        Some(vs) : sprintf("an earlier arm's `%s` is not a variant of `%s` but a name the pattern binds, so it matches every value; its variants are %s", bn, &type_display(Option::expect(match (&inner)
                                        {
                                            Some(x) : Some(x),
                                            None    : None,
                                        }, "a type")), &vs),
                                        None : sprintf(
                                            "an earlier arm's `%s` is a name the pattern binds, not a variant, so it matches every value",
                                            bn,
                                        ),
                                    });
                                }
                            },
                            None     : {},
                        }
                    }
                    ref<Expr, shared> body = Box::get(&arms[k].body);
                    // Located at the arm (its body's line).
                    return Err(match (hint)
                    {
                        Some(h) : sprintf("diag.unreachable-arm\u{1}%s%s", &h, &diag_at(body.line, body.col)),
                        None    : sprintf("diag.unreachable-arm%s", &diag_at(body.line, body.col)),
                    });
                }
            }
            match (pattern_missing(it, &Vec::new(), Some(clone(t0)), &chains, false))
            {
                Some(missing) : return Err(sprintf("diag.non-exhaustive-match\u{1}not covered: `%s`", &missing)),
                None          : {},
            }
        },
        None     : {},
    }
    Option<Type> result = None;
    bool any_unknown = false;
    // Each arm starts from the state after the scrutinee; the arm states
    // join afterwards.
    Flow base = clone(&b.flow);
    Option<Flow> joined = None;
    // `rule.type.expected`: the first arm's body type for later arms.
    Option<Type> arm_expected = clone(expected);
    // D-0049: an arm that is only a literal takes its type from the first
    // arm that is not, which is checked first.
    Vec<usize> order = Vec::new();
    for (usize i = 0; i < Vec::len(arms); i += 1)
    {
        Vec::push(&mut order, i);
    }
    if (Option::is_none(expected))
    {
        for (usize i = 0; i < Vec::len(arms); i += 1)
        {
            if (!is_literal_branch(Box::get(&arms[i].body)))
            {
                Vec::remove(&mut order, i);
                Vec::insert(&mut order, 0, i);
                break;
            }
        }
    }
    for (usize ai = 0; ai < Vec::len(&order); ai += 1)
    {
        usize ix = order[ai];
        ref<Arm, shared> arm = &arms[ix];
        usize gamma_mark = Vec::len(&b.gamma_log);
        b.flow = clone(&base);
        enter_scope(b);
        Option<Mode> cross = crossed[ix];
        match (&arm.binder)
        {
            Some(bn) : match (clone(&binder_ty[ix]))
            {
                Some(pt) :
                {
                    match (&consume_x)
                    {
                        Some(x) :
                        {
                            if (Option::is_none(&by_ref) && Option::is_none(&cross) && is_resource_ty(it, &pt))
                            {
                                // D-0291: a handle taken out into the binder,
                                // which holds what its thread was lent.
                                bool handing = b.handing || Option::is_some(&hand);
                                bool saved_handing = replace(&mut b.handing, handing);
                                Result<void, String> r = flow_consume(b, it, x, "diag.destroy-while-aliased");
                                b.handing = saved_handing;
                                r?;
                            }
                        },
                        None    : {},
                    }
                    Type bt = match (by_ref)
                    {
                        None : match (cross)
                        {
                            None    : pt,
                            Some(m) : ref_of(pt, m),
                        },
                        Some(a) : match (cross)
                        {
                            None    : ref_of(pt, a),
                            Some(c) : ref_of(pt, weaker_mode(Some(a), c)),
                        },
                    };
                    gamma_set(b, bn, Some(bt));
                },
                None     : {},
            },
            None : {},
        }
        match (&arm.binder)
        {
            Some(bn) :
            {
                declare(b, bn, true);
                if (Option::is_some(&cross))
                {
                    // D-0109: through a reference the pattern crossed, the
                    // binder borrows what that reference does.
                    Vec<DerivKey> facts = contained_ref_facts(b, it, scrut);
                    if (Vec::len(&facts) == 0)
                    {
                        match (path_segs(strip_parens_tc(scrut)))
                        {
                            Some(segs) :
                            {
                                if (Vec::len(segs) == 1)
                                {
                                    match (HashMap::get(&b.flow.deriv, &segs[0]))
                                    {
                                        Some(m) :
                                        {
                                            for (usize k = 0; k < HashMap::len(m); k += 1)
                                            {
                                                Vec::push(&mut facts, clone(&HashMap::value_at(m, k).key));
                                            }
                                        },
                                        None    : {},
                                    }
                                }
                            },
                            None       : {},
                        }
                    }
                    set_deriv(b, bn, facts);
                    tier_inherit(b, it, bn, Some(scrut))?;
                }
                else
                {
                    match (by_ref)
                    {
                        Some(m) :
                        {
                            // D-0071: a binder of a match by reference is a
                            // reference into the scrutinee's place.
                            Vec<DerivKey> facts = Vec::new();
                            match (match_referent(b, it, scrut))
                            {
                                Some(p) : Vec::push(&mut facts, deriv_key(p, m)),
                                None    : {},
                            }
                            set_deriv(b, bn, facts);
                            tier_inherit(b, it, bn, Some(scrut))?;
                        },
                        None    :
                        {
                            bool binder_handle = match (HashMap::get(&b.gamma, bn))
                            {
                                Some(t) : holds_handle(t),
                                None    : false,
                            };
                            bool holds = match (HashMap::get(&b.gamma, bn))
                            {
                                Some(t) : holds_ref(it, t),
                                None    : false,
                            };
                            bool holder_ty = match (lookup_local(b, bn))
                            {
                                Some(t) : holder_type(b, it, &t),
                                None    : false,
                            };
                            if (Option::is_some(&hand) && binder_handle)
                            {
                                // D-0289: a handle taken out of a `Vec` of
                                // them holds what its thread was lent.
                                Vec<DerivFact> facts = match (&hand)
                                {
                                    Some(hh) : clone(&hh.facts),
                                    None     : Vec::new(),
                                };
                                set_deriv_tri(b, bn, facts);
                            }
                            else if (holds || holder_ty)
                            {
                                // D-0088: a reference out of a call's
                                // `Option<ref<V>>` borrows from its
                                // arguments; a holder holds what the
                                // scrutinee does (D-0290).
                                Vec<DerivKey> facts = if (holder_ty) { Vec::new() } else
                                {
                                    contained_ref_facts(
                                        b,
                                        it,
                                        scrut,
                                    )
                                };
                                if (Vec::len(&facts) > 0)
                                {
                                    set_deriv(b, bn, facts);
                                }
                                tier_inherit(b, it, bn, Some(scrut))?;
                            }
                        },
                    }
                }
            },
            None     : {},
        }
        Result<Option<Type>, String> at0 = check_store_operand(b, it, Box::get(&arm.body), &arm_expected);
        at0 = match (at0)
        {
            Ok(t) : match (check_block_exit(b))
            {
                Ok(_)  : Ok(t),
                Err(e) : Err(e),
            },
            Err(e) : Err(e),
        };
        exit_scope(b);
        gamma_undo(b, gamma_mark);
        Option<Type> at = at0?;
        if (ai == 0 && Option::is_none(&arm_expected))
        {
            match (&at)
            {
                Some(t) :
                {
                    if (!is_never(t) && !has_unresolved_marker(t))
                    {
                        arm_expected = Some(clone(t));
                        HashMap::insert(&mut b.facts.match_hints, whole.id, clone(t));
                    }
                },
                None    : {},
            }
        }
        joined = match (joined)
        {
            None    : Some(clone(&b.flow)),
            Some(j) : Some(flow_join(&j, &b.flow)),
        };
        match (at)
        {
            Some(t) :
            {
                if (has_unresolved_marker(&t))
                {
                    any_unknown = true;
                }
                else
                {
                    bool take = match (&result)
                    {
                        None    : true,
                        Some(r) :
                        {
                            if (!is_never(r) && !is_never(&t) && !ty_compat(r, &t))
                            {
                                return Err(mismatch(sprintf(
                                    "one arm gives `%s` and another `%s`",
                                    &type_display(r),
                                    &type_display(&t),
                                )));
                            }
                            is_never(r)
                        },
                    };
                    if (take)
                    {
                        result = Some(t);
                    }
                }
            },
            None    : any_unknown = true,
        }
    }
    b.flow = Option::unwrap_or(joined, base);
    if (any_unknown)
    {
        return Ok(None);
    }
    Ok(result)
}

fn sets_eq(ref<HashSet<String>, shared> a, ref<HashSet<String>, shared> c) : bool
{
    if (HashSet::len(a) != HashSet::len(c))
    {
        return false;
    }
    for (usize i = 0; i < HashSet::len(a); i += 1)
    {
        if (!HashSet::contains(c, HashSet::key_at(a, i)))
        {
            return false;
        }
    }
    true
}

// `diag.capture-list-mismatch` (`rule.fn.closure`, spec/15 §6) and the
// closure's body, checked as a body of its own.
fn check_closure(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    bool is_move,
    ref<Vec<String>, shared> captures,
    ref<Vec<ParamDecl>, shared> params,
    ref<Option<Type>, shared> declared_ret0,
    ref<Block, shared> body,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // Free variables computed against only the parameters as bound.
    HashSet<String> bound = HashSet::new();
    for (usize i = 0; i < Vec::len(params); i += 1)
    {
        HashSet::insert(&mut bound, String::clone(&params[i].name));
    }
    HashSet<String> free0 = HashSet::new();
    collect_free_vars_block(body, &mut bound, &mut free0);
    // An item named by a bare identifier is not a free variable.
    HashSet<String> free = HashSet::new();
    for (usize i = 0; i < HashSet::len(&free0); i += 1)
    {
        ref<String, shared> n = HashSet::key_at(&free0, i);
        if (!is_item_name(it, n))
        {
            HashSet::insert(&mut free, String::clone(n));
        }
    }
    HashSet<String> declared = HashSet::new();
    for (usize i = 0; i < Vec::len(captures); i += 1)
    {
        HashSet::insert(&mut declared, String::clone(&captures[i]));
    }
    if (!sets_eq(&free, &declared))
    {
        return Err(String::from_str("diag.capture-list-mismatch"));
    }
    // Forming the closure, in the enclosing body's flow.
    for (usize i = 0; i < Vec::len(captures); i += 1)
    {
        ref<String, shared> c = &captures[i];
        HashMap::remove(&mut b.flow.lits, c);
        if (!flow_is_tracked(&b.flow, c))
        {
            continue;
        }
        match (HashMap::get(&b.flow.valid, c))
        {
            Some(Tri::F) :
            {
                String msg = sprintf(
                    "`%s` was moved or dropped before this closure captures it",
                    shown_name(String::as_view(c)),
                );
                refute(b, &named_diag("diag.stale-binding", &msg))?;
            },
            Some(Tri::U) :
            {
                String msg = sprintf(
                    "`%s` may have been moved or dropped (on some path to here) before this closure captures it",
                    shown_name(String::as_view(c)),
                );
                refute(b, &named_diag("diag.stale-binding", &msg))?;
            },
            _            : {},
        }
        if (is_move)
        {
            if (place_is_resource(b, it, c, &Vec::new()))
            {
                flow_consume(b, it, c, "diag.move-while-aliased")?;
            }
            else
            {
                if (!tri_is(&b.flow.init, c, Tri::T))
                {
                    refute(b, &uninit_msg(String::as_view(c)))?;
                }
                flow_clash(b, it, c, &Vec::new(), Mode::Shared, "diag.aliasing-conflict")?;
            }
        }
        else
        {
            Mode mode = if (closure_body_writes(body, String::as_view(c))) { Mode::Exclusive } else { Mode::Shared };
            flow_clash(b, it, c, &Vec::new(), mode, "diag.aliasing-conflict")?;
        }
    }
    // The body, checked as a body of its own; a captured name's type is the
    // outer binding's.
    HashMap<String, Option<Type>> outer_capture_types = HashMap::new();
    for (usize i = 0; i < Vec::len(captures); i += 1)
    {
        HashMap::insert(&mut outer_capture_types, String::clone(&captures[i]), lookup_local(b, &captures[i]));
    }
    HashMap<String, Type> saved_gamma = replace(&mut b.gamma, HashMap::new());
    usize gamma_mark = Vec::len(&b.gamma_log);
    for (usize i = 0; i < HashMap::len(&outer_capture_types); i += 1)
    {
        match (HashMap::value_at(&outer_capture_types, i))
        {
            Some(t) :
            {
                gamma_set(b, HashMap::key_at(&outer_capture_types, i), Some(clone(t)));
            },
            None    : {},
        }
    }
    Flow saved_flow = replace(&mut b.flow, new_flow());
    HashMap<String, Option<Type>> saved_move_captures = replace(
        &mut b.move_captures,
        if (is_move) { outer_capture_types } else { HashMap::new() },
    );
    HashSet<String> saved_capture_names = replace(&mut b.capture_names, clone(&declared));
    Vec<Vec<ScopeEntry>> fresh_scopes = Vec::new();
    Vec::push(&mut fresh_scopes, Vec::new());
    Vec<Vec<ScopeEntry>> saved_scopes = replace(&mut b.scopes, fresh_scopes);
    Vec<LoopCtx> saved_loops = replace(&mut b.loops, Vec::new());
    u32 saved_depth = b.while_depth;
    usize root = b.next_block;
    b.next_block += 1;
    Vec<usize> fresh_blocks = Vec::new();
    Vec::push(&mut fresh_blocks, root);
    Vec<usize> saved_blocks = replace(&mut b.block_stack, fresh_blocks);
    HashMap<String, usize> saved_decl = replace(&mut b.decl_block, HashMap::new());
    HashMap<String, Option<Referent>> saved_origin = replace(&mut b.ref_origin, HashMap::new());
    HashSet<String> param_names = HashSet::new();
    for (usize i = 0; i < Vec::len(params); i += 1)
    {
        HashSet::insert(&mut param_names, String::clone(&params[i].name));
    }
    HashSet<String> saved_params = replace(&mut b.params, param_names);
    b.while_depth = 0;
    for (usize i = 0; i < Vec::len(params); i += 1)
    {
        gamma_set(b, &params[i].name, Some(apply_subst(&params[i].ty, &b.subst)));
        declare(b, &params[i].name, true);
    }
    // The result the closure is expected to give.
    Option<Type> exp_ret = match (expected)
    {
        Some(Type::TFn(fb)) :
        {
            ref<FnTy, shared> f = Box::get(fb);
            if (Vec::len(&f.params) == Vec::len(params) && !has_unresolved_marker(&f.ret)) { Some(clone(&f.ret)) } else { None }
        },
        _                   : None,
    };
    Vec<Type> ptys = Vec::new();
    for (usize i = 0; i < Vec::len(params); i += 1)
    {
        Vec::push(&mut ptys, apply_subst(&params[i].ty, &b.subst));
    }
    // D-0081: a written result type is what the body is checked against.
    Option<Type> declared_ret = match (declared_ret0)
    {
        Some(t) : Some(apply_subst(t, &b.subst)),
        None    : None,
    };
    Result<Option<Type>, String> r = Ok(None);
    bool bad_decl = false;
    match (&declared_ret)
    {
        Some(d) : match (&exp_ret)
        {
            Some(want) :
            {
                if (!ty_compat(d, want))
                {
                    r = Err(mismatch(sprintf(
                        "the closure's result is declared `%s`, but `%s` is expected",
                        &type_display(d),
                        &type_display(&fn_of(clone(&ptys), clone(want))),
                    )));
                    bad_decl = true;
                }
            },
            None       : {},
        },
        None : {},
    }
    Option<Type> exp_final = or_type(declared_ret, exp_ret);
    if (!bad_decl)
    {
        Option<Option<Type>> saved_closure_ret = replace(&mut b.closure_ret, Some(clone(&exp_final)));
        r = check_nested_block(b, it, body, &exp_final);
        b.closure_ret = saved_closure_ret;
    }
    b.move_captures = saved_move_captures;
    b.capture_names = saved_capture_names;
    b.params = saved_params;
    b.ref_origin = saved_origin;
    b.decl_block = saved_decl;
    b.block_stack = saved_blocks;
    b.while_depth = saved_depth;
    b.loops = saved_loops;
    b.scopes = saved_scopes;
    b.flow = saved_flow;
    b.gamma = saved_gamma;
    // The closure's own writes were to its own `gamma`.
    Vec::truncate(&mut b.gamma_log, gamma_mark);
    Option<Type> bt = r?;
    // A closure is a value of type `fn(P…) : R`, R its body's type (D-0073).
    bool ptys_open = false;
    for (usize i = 0; i < Vec::len(&ptys); i += 1)
    {
        if (has_unresolved_marker(&ptys[i]))
        {
            ptys_open = true;
        }
    }
    match (bt)
    {
        Some(t) : match (exp_final)
        {
            Some(want) :
            {
                if (!has_unresolved_marker(&t) && !is_never(&t) && !ty_compat(&t, &want))
                {
                    return Err(mismatch(sprintf(
                        "the closure's body gives `%s`, but `%s` is expected",
                        &type_display(&t),
                        &type_display(&fn_of(ptys, want)),
                    )));
                }
                if (is_never(&t))
                {
                    return Ok(Some(fn_of(ptys, want)));
                }
                if (!has_unresolved_marker(&t) && !ptys_open)
                {
                    return Ok(Some(fn_of(ptys, t)));
                }
                Ok(None)
            },
            None       :
            {
                if (!has_unresolved_marker(&t) && !is_never(&t) && !ptys_open)
                {
                    return Ok(Some(fn_of(ptys, t)));
                }
                Ok(None)
            },
        },
        None : Ok(None),
    }
}

// The element type of what `x[i]` and `&x[lo .. hi]` index (D-0047).
fn indexed_elem(ref<Type, shared> t) : Option<Type>
{
    match (t)
    {
        Type::TArray(ab) : Some(clone(&Box::get(ab).inner)),
        Type::TSlice(sb) : Some(clone(&Box::get(sb).inner)),
        Type::TNamed(nb) :
        {
            if (String::eq_str(&Box::get(nb).name, "std::Vec") && Vec::len(&Box::get(nb).args) > 0)
            {
                return Some(clone(&Box::get(nb).args[0]));
            }
            None
        },
        Type::TRef(rb) : match (&Box::get(rb).inner)
        {
            Type::TRef(_) : None,
            other         : indexed_elem(other),
        },
        _                : None,
    }
}

// `rule.stdlib.print`'s printable types (`never` too).
fn is_printable(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TStr     : true,
        Type::TInt(_)  : true,
        Type::TF32     : true,
        Type::TF64     : true,
        Type::TBool    : true,
        Type::TNever   : true,
        Type::TRef(rb) : Box::get(rb).mode == Mode::Shared && named_is(&Box::get(rb).inner, "std::String"),
        _              : named_is(t, "std::StringView"),
    }
}

// D-0258: an initializer written out as literals.
export fn literal_tree(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EInt(_)         : true,
        ExprKind::EFloat(_)       : true,
        ExprKind::EBool(_)        : true,
        ExprKind::EUnary(ub) : Box::get(ub).op == UnOp::Neg && match (&Box::get(ub).e.kind)
        {
            ExprKind::EInt(_)   : true,
            ExprKind::EFloat(_) : true,
            _                   : false,
        },
        ExprKind::EParen(x)       : literal_tree(Box::get(x)),
        ExprKind::EArrayLit(es)   :
        {
            for (usize i = 0; i < Vec::len(es); i += 1)
            {
                if (!literal_tree(&es[i]))
                {
                    return false;
                }
            }
            true
        },
        ExprKind::EArrayRepeat(r) : literal_tree(&Box::get(r).value),
        ExprKind::EStructLit(sb)  :
        {
            ref<StructLitExpr, shared> s = Box::get(sb);
            for (usize i = 0; i < Vec::len(&s.fields); i += 1)
            {
                if (!literal_tree(&s.fields[i].value))
                {
                    return false;
                }
            }
            true
        },
        _                         : false,
    }
}

// D-0090: the types a bound admits, for messages.
fn bound_members(Bound bd) : str
{
    match (bd)
    {
        Bound::BEq      : "a number, `bool`, `str`, `String`, or a struct or enum of those",
        Bound::BOrdered : "a number, `bool`, `str`, `String`, or a struct or enum of those",
        Bound::BNumber  : "an integer or floating-point type",
        Bound::BInteger : "an integer type",
        Bound::BClone   : "a plain type, `String`, `Rc<T>`, `Box<T: clone>`, `Vec<T: clone>`, a hash table of them, a type with its own `T::clone`, or a struct or enum of `clone` types",
        Bound::BPlain   : "a number, `bool`, a raw pointer, a `simd`, or an array, struct or enum of those",
    }
}

// D-0111: for each statement, the bindings whose last mention it is.
struct EarlyPlan
{
    Vec<Vec<Waiting>> ends;
    Vec<HashSet<String>> mentions;
    HashSet<String> tail;
}

struct DeclCount
{
    usize first;
    usize count;
}

fn early_end_plan(ref<Block, shared> blk) : EarlyPlan
{
    usize n = Vec::len(&blk.stmts);
    Vec<Vec<Waiting>> plan = Vec::new();
    Vec<HashSet<String>> mentions = Vec::new();
    for (usize i = 0; i < n; i += 1)
    {
        Vec::push(&mut plan, Vec::new());
        Vec::push(&mut mentions, stmt_mentions(&blk.stmts[i]));
    }
    HashSet<String> tail = HashSet::new();
    match (&blk.tail)
    {
        Some(e) :
        {
            HashSet<String> bound = HashSet::new();
            collect_free_vars_expr(Box::get(e), &mut bound, &mut tail);
        },
        None    : {},
    }
    HashSet<String> captured = HashSet::new();
    for (usize i = 0; i < n; i += 1)
    {
        closure_captures_stmt(&blk.stmts[i], &mut captured);
    }
    match (&blk.tail)
    {
        Some(e) : closure_captures_expr(Box::get(e), &mut captured),
        None    : {},
    }
    HashMap<String, DeclCount> declared = HashMap::new();
    for (usize i = 0; i < n; i += 1)
    {
        match (&blk.stmts[i])
        {
            Stmt::SLet(l) :
            {
                ref<DeclCount, exclusive> dc = HashMap::entry(
                    &mut declared,
                    String::clone(&Box::get(l).name),
                    DeclCount { .first = i, .count = 0 },
                );
                dc.count += 1;
            },
            _             : {},
        }
    }
    for (usize k = 0; k < HashMap::len(&declared); k += 1)
    {
        ref<String, shared> name = HashMap::key_at(&declared, k);
        ref<DeclCount, shared> dc = HashMap::value_at(&declared, k);
        if (dc.count != 1 || String::starts_with(
            name,
            "$",
        ) || HashSet::contains(&tail, name) || HashSet::contains(&captured, name))
        {
            continue;
        }
        usize d = dc.first;
        usize last = d;
        for (usize j = d + 1; j < n; j += 1)
        {
            if (HashSet::contains(&mentions[j], name))
            {
                last = j;
            }
        }
        if (last + 1 < n || Option::is_some(&blk.tail))
        {
            Vec::push(&mut plan[last], Waiting { .name = String::clone(name), .decl = d });
        }
    }
    for (usize i = 0; i < n; i += 1)
    {
        sort_waiting(&mut plan[i]);
    }
    EarlyPlan { .ends = plan, .mentions = mentions, .tail = tail }
}

// The order of Rust's `(String, usize)` tuples.
fn sort_waiting(ref<Vec<Waiting>, exclusive> v)
{
    for (usize i = 1; i < Vec::len(v); i += 1)
    {
        usize j = i;
        while (j > 0 && (String::less(
            &v[j].name,
            &v[j - 1].name,
        ) || (String::eq(&v[j].name, &v[j - 1].name) && v[j].decl < v[j - 1].decl)))
        {
            Vec::swap(v, j - 1, j);
            j -= 1;
        }
    }
}

// The names statement `s` mentions.
fn stmt_mentions(ref<Stmt, shared> s) : HashSet<String>
{
    HashSet<String> free = HashSet::new();
    HashSet<String> bound = HashSet::new();
    match (s)
    {
        Stmt::SLet(l)         :
        {
            match (&Box::get(l).init)
            {
                Some(e) : collect_free_vars_expr(e, &mut bound, &mut free),
                None    : {},
            }
        },
        Stmt::SDestructure(d) : collect_free_vars_expr(&Box::get(d).init, &mut bound, &mut free),
        Stmt::SExpr(e)        : collect_free_vars_expr(Box::get(e), &mut bound, &mut free),
        Stmt::SBlockLike(e)   : collect_free_vars_expr(Box::get(e), &mut bound, &mut free),
    }
    free
}

fn closure_captures_stmt(ref<Stmt, shared> s, ref<HashSet<String>, exclusive> out)
{
    // A `move` closure bound whole (`auto f = move […]…`, `f = move […]…`)
    // holds a copy of each capture, and its binding the facts the capture
    // held (`closure_facts_of`): the capture may end before it. A closure
    // anywhere else (an argument, `spawn`'s, a callee) carries no facts,
    // so what it captures stays alive.
    Option<ref<Expr, shared>> bound = match (s)
    {
        Stmt::SLet(l) : match (&Box::get(l).init)
        {
            Some(e) : Some(e),
            None    : None,
        },
        Stmt::SExpr(e) : match (&strip_parens_tc(Box::get(e)).kind)
        {
            ExprKind::EAssign(pb) : match (one_seg(strip_parens_tc(&Box::get(pb).a)))
            {
                Some(_) : Some(&Box::get(pb).b),
                None    : None,
            },
            _ : None,
        },
        _ : None,
    };
    match (bound)
    {
        Some(e) : match (&strip_parens_tc(e).kind)
        {
            ExprKind::EClosure(cb) :
            {
                if (Box::get(cb).is_move)
                {
                    closure_captures_block(&Box::get(cb).body, out);
                    return;
                }
            },
            _                      : {},
        },
        None : {},
    }
    match (s)
    {
        Stmt::SLet(l)         :
        {
            match (&Box::get(l).init)
            {
                Some(e) : closure_captures_expr(e, out),
                None    : {},
            }
        },
        Stmt::SDestructure(d) : closure_captures_expr(&Box::get(d).init, out),
        Stmt::SExpr(e)        : closure_captures_expr(Box::get(e), out),
        Stmt::SBlockLike(e)   : closure_captures_expr(Box::get(e), out),
    }
}

fn closure_captures_block(ref<Block, shared> blk, ref<HashSet<String>, exclusive> out)
{
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        closure_captures_stmt(&blk.stmts[i], out);
    }
    match (&blk.tail)
    {
        Some(t) : closure_captures_expr(Box::get(t), out),
        None    : {},
    }
}

// Every name a closure anywhere in `e` captures.
fn closure_captures_expr(ref<Expr, shared> e, ref<HashSet<String>, exclusive> out)
{
    match (&e.kind)
    {
        ExprKind::EClosure(cb)    :
        {
            ref<ClosureExpr, shared> c = Box::get(cb);
            for (usize i = 0; i < Vec::len(&c.captures); i += 1)
            {
                HashSet::insert(out, String::clone(&c.captures[i]));
            }
            closure_captures_block(&c.body, out);
        },
        ExprKind::ESliceOf(sb)    :
        {
            ref<SliceExpr, shared> s = Box::get(sb);
            closure_captures_expr(&s.base, out);
            closure_captures_expr(&s.lo, out);
            closure_captures_expr(&s.hi, out);
        },
        ExprKind::EUnary(ub)      : closure_captures_expr(&Box::get(ub).e, out),
        ExprKind::EDeref(x)       : closure_captures_expr(Box::get(x), out),
        ExprKind::EField(fb)      : closure_captures_expr(&Box::get(fb).e, out),
        ExprKind::EParen(x)       : closure_captures_expr(Box::get(x), out),
        ExprKind::EPropagate(x)   : closure_captures_expr(Box::get(x), out),
        ExprKind::EBorrow(bb)     : closure_captures_expr(&Box::get(bb).e, out),
        ExprKind::EArrayRepeat(r) : closure_captures_expr(&Box::get(r).value, out),
        ExprKind::EBinary(bb)     :
        {
            closure_captures_expr(&Box::get(bb).a, out);
            closure_captures_expr(&Box::get(bb).b, out);
        },
        ExprKind::EIndex(pb)      :
        {
            closure_captures_expr(&Box::get(pb).a, out);
            closure_captures_expr(&Box::get(pb).b, out);
        },
        ExprKind::EAssign(pb)     :
        {
            closure_captures_expr(&Box::get(pb).a, out);
            closure_captures_expr(&Box::get(pb).b, out);
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            closure_captures_expr(&c.callee, out);
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                closure_captures_expr(&c.args[i], out);
            }
        },
        ExprKind::EStructLit(sb)  :
        {
            ref<StructLitExpr, shared> s = Box::get(sb);
            for (usize i = 0; i < Vec::len(&s.fields); i += 1)
            {
                closure_captures_expr(&s.fields[i].value, out);
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            for (usize i = 0; i < Vec::len(es); i += 1)
            {
                closure_captures_expr(&es[i], out);
            }
        },
        ExprKind::EBlock(blk)     : closure_captures_block(blk, out),
        ExprKind::EUnsafe(blk)    : closure_captures_block(blk, out),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            closure_captures_expr(&x.cond, out);
            closure_captures_block(&x.then_, out);
            match (&x.else_)
            {
                Some(el) : closure_captures_expr(el, out),
                None     : {},
            }
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            closure_captures_expr(&x.cond, out);
            closure_captures_block(&x.body, out);
            match (&x.step)
            {
                Some(s) : closure_captures_expr(s, out),
                None    : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> x = Box::get(mb);
            closure_captures_expr(&x.scrut, out);
            for (usize i = 0; i < Vec::len(&x.arms); i += 1)
            {
                closure_captures_expr(Box::get(&x.arms[i].body), out);
            }
        },
        ExprKind::EReturn(opt)    :
        {
            match (opt)
            {
                Some(v) : closure_captures_expr(Box::get(v), out),
                None    : {},
            }
        },
        _                         : {},
    }
}

fn collect_free_vars_block(
    ref<Block, shared> blk,
    ref<HashSet<String>, exclusive> bound,
    ref<HashSet<String>, exclusive> free,
)
{
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        match (&blk.stmts[i])
        {
            Stmt::SLet(lb)        :
            {
                ref<LetStmt, shared> l = Box::get(lb);
                match (&l.init)
                {
                    Some(e) : collect_free_vars_expr(e, bound, free),
                    None    : {},
                }
                HashSet::insert(bound, String::clone(&l.name));
            },
            Stmt::SDestructure(d) :
            {
                collect_free_vars_expr(&Box::get(d).init, bound, free);
                for (usize k = 0; k < Vec::len(&Box::get(d).fields); k += 1)
                {
                    HashSet::insert(bound, String::clone(&Box::get(d).fields[k]));
                }
            },
            Stmt::SExpr(e)        : collect_free_vars_expr(Box::get(e), bound, free),
            Stmt::SBlockLike(e)   : collect_free_vars_expr(Box::get(e), bound, free),
        }
    }
    match (&blk.tail)
    {
        Some(e) : collect_free_vars_expr(Box::get(e), bound, free),
        None    : {},
    }
}

fn collect_free_vars_expr(
    ref<Expr, shared> e,
    ref<HashSet<String>, exclusive> bound,
    ref<HashSet<String>, exclusive> free,
)
{
    match (&e.kind)
    {
        ExprKind::ESliceOf(sb)    :
        {
            ref<SliceExpr, shared> s = Box::get(sb);
            collect_free_vars_expr(&s.base, bound, free);
            collect_free_vars_expr(&s.lo, bound, free);
            collect_free_vars_expr(&s.hi, bound, free);
        },
        ExprKind::EPath(pb)       :
        {
            ref<Vec<String>, shared> segs = &Box::get(pb).segs;
            if (Vec::len(segs) == 1 && !HashSet::contains(bound, &segs[0]))
            {
                HashSet::insert(free, String::clone(&segs[0]));
            }
        },
        ExprKind::EUnary(ub)      : collect_free_vars_expr(&Box::get(ub).e, bound, free),
        ExprKind::EDeref(x)       : collect_free_vars_expr(Box::get(x), bound, free),
        ExprKind::EField(fb)      : collect_free_vars_expr(&Box::get(fb).e, bound, free),
        ExprKind::EParen(x)       : collect_free_vars_expr(Box::get(x), bound, free),
        ExprKind::EPropagate(x)   : collect_free_vars_expr(Box::get(x), bound, free),
        ExprKind::EBorrow(bb)     : collect_free_vars_expr(&Box::get(bb).e, bound, free),
        ExprKind::EBinary(bb)     :
        {
            collect_free_vars_expr(&Box::get(bb).a, bound, free);
            collect_free_vars_expr(&Box::get(bb).b, bound, free);
        },
        ExprKind::EIndex(pb)      :
        {
            collect_free_vars_expr(&Box::get(pb).a, bound, free);
            collect_free_vars_expr(&Box::get(pb).b, bound, free);
        },
        ExprKind::EAssign(pb)     :
        {
            collect_free_vars_expr(&Box::get(pb).a, bound, free);
            collect_free_vars_expr(&Box::get(pb).b, bound, free);
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            collect_free_vars_expr(&c.callee, bound, free);
            // `fault(name, …)`'s first argument is a diagnostic's name.
            bool names_a_diag = match (path_segs(&c.callee))
            {
                Some(segs) : Vec::len(segs) == 1 && String::eq_str(&segs[0], "fault"),
                None       : false,
            };
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                if (names_a_diag && i == 0)
                {
                    continue;
                }
                collect_free_vars_expr(&c.args[i], bound, free);
            }
        },
        ExprKind::EStructLit(sb)  :
        {
            ref<StructLitExpr, shared> s = Box::get(sb);
            for (usize i = 0; i < Vec::len(&s.fields); i += 1)
            {
                collect_free_vars_expr(&s.fields[i].value, bound, free);
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            for (usize i = 0; i < Vec::len(es); i += 1)
            {
                collect_free_vars_expr(&es[i], bound, free);
            }
        },
        ExprKind::EArrayRepeat(r) : collect_free_vars_expr(&Box::get(r).value, bound, free),
        ExprKind::EBlock(blk)     :
        {
            HashSet<String> inner = HashSet::clone(bound);
            collect_free_vars_block(blk, &mut inner, free);
        },
        ExprKind::EUnsafe(blk)    :
        {
            HashSet<String> inner = HashSet::clone(bound);
            collect_free_vars_block(blk, &mut inner, free);
        },
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            collect_free_vars_expr(&x.cond, bound, free);
            HashSet<String> inner = HashSet::clone(bound);
            collect_free_vars_block(&x.then_, &mut inner, free);
            match (&x.else_)
            {
                Some(el) : collect_free_vars_expr(el, bound, free),
                None     : {},
            }
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            collect_free_vars_expr(&x.cond, bound, free);
            HashSet<String> inner = HashSet::clone(bound);
            collect_free_vars_block(&x.body, &mut inner, free);
            match (&x.step)
            {
                Some(s) : collect_free_vars_expr(s, bound, free),
                None    : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> x = Box::get(mb);
            collect_free_vars_expr(&x.scrut, bound, free);
            for (usize i = 0; i < Vec::len(&x.arms); i += 1)
            {
                HashSet<String> inner = HashSet::clone(bound);
                match (&x.arms[i].binder)
                {
                    Some(bn) :
                    {
                        HashSet::insert(&mut inner, String::clone(bn));
                    },
                    None     : {},
                }
                collect_free_vars_expr(Box::get(&x.arms[i].body), &mut inner, free);
            }
        },
        ExprKind::EReturn(opt)    :
        {
            match (opt)
            {
                Some(v) : collect_free_vars_expr(Box::get(v), bound, free),
                None    : {},
            }
        },
        // A nested closure's own capture list is the set of outer names
        // it needs.
        ExprKind::EClosure(cb)    :
        {
            ref<ClosureExpr, shared> c = Box::get(cb);
            for (usize i = 0; i < Vec::len(&c.captures); i += 1)
            {
                if (!HashSet::contains(bound, &c.captures[i]))
                {
                    HashSet::insert(free, String::clone(&c.captures[i]));
                }
            }
        },
        _                         : {},
    }
}

fn is_pure_intrinsic(ref<String, shared> n) : bool
{
    foreach (x in [
        "min_value",
        "max_value",
        "sizeof",
        "alignof",
        "widen",
        "narrow",
        "narrow_wrapping",
        "reinterpret",
        "to_float",
        "to_int",
        "wrapping_add",
        "wrapping_sub",
        "wrapping_mul",
        "saturating_add",
        "saturating_sub",
        "saturating_mul",
    ])
    {
        if (String::eq_str(n, x))
        {
            return true;
        }
    }
    false
}

fn const_is_variant(ref<Items, shared> it, ref<Vec<String>, shared> segs) : bool
{
    usize n = Vec::len(segs);
    if (n == 0)
    {
        return HashMap::contains(&it.enum_of_variant, &String::new());
    }
    ref<String, shared> last = &segs[n - 1];
    if (n >= 2)
    {
        Vec<String> head = Vec::new();
        for (usize i = 0; i + 1 < n; i += 1)
        {
            Vec::push(&mut head, String::clone(&segs[i]));
        }
        match (HashMap::get(&it.enums, &String::join(&head[0..$], "::")))
        {
            Some(en) : return Option::is_some(&variant_index_of(en, last)),
            None     : {},
        }
    }
    HashMap::contains(&it.enum_of_variant, last)
}

// Whether `e` is a constant expression (D-0036, D-0066).
fn const_expr(ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EInt(_)         : true,
        ExprKind::EFloat(_)       : true,
        ExprKind::EBool(_)        : true,
        ExprKind::EStr(_)         : true,
        ExprKind::EUnit           : true,
        ExprKind::EParen(x)       : const_expr(it, Box::get(x)),
        ExprKind::EUnary(ub)      : const_expr(it, &Box::get(ub).e),
        ExprKind::EBinary(bb)     : const_expr(it, &Box::get(bb).a) && const_expr(it, &Box::get(bb).b),
        ExprKind::EArrayLit(es)   :
        {
            for (usize i = 0; i < Vec::len(es); i += 1)
            {
                if (!const_expr(it, &es[i]))
                {
                    return false;
                }
            }
            true
        },
        ExprKind::EArrayRepeat(r) : const_expr(it, &Box::get(r).value),
        ExprKind::EStructLit(sb)  :
        {
            ref<StructLitExpr, shared> s = Box::get(sb);
            for (usize i = 0; i < Vec::len(&s.fields); i += 1)
            {
                if (!const_expr(it, &s.fields[i].value))
                {
                    return false;
                }
            }
            true
        },
        // D-0066: a field of a constant struct, an element of a constant
        // array at a constant index.
        ExprKind::EField(fb)      : const_expr(it, &Box::get(fb).e),
        ExprKind::EIndex(pb)      : const_expr(it, &Box::get(pb).a) && const_expr(it, &Box::get(pb).b),
        ExprKind::EPath(pb)       :
        {
            ref<Vec<String>, shared> segs = &Box::get(pb).segs;
            if (const_is_variant(it, segs))
            {
                return true;
            }
            match (HashMap::get(&it.fns, &String::join(&segs[0..$], "::")))
            {
                Some(f) : !f.is_const,
                None    : false,
            }
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            ref<Vec<String>, shared> segs = match (path_segs(&c.callee))
            {
                Some(s) : s,
                None    : return false,
            };
            String name = String::join(&segs[0..$], "::");
            bool args_ok = true;
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                if (!const_expr(it, &c.args[i]))
                {
                    args_ok = false;
                }
            }
            match (HashMap::get(&it.fns, &name))
            {
                Some(f) : f.is_const && Vec::len(&c.args) == 0,
                None    : args_ok && (const_is_variant(it, segs) || is_pure_intrinsic(&name)),
            }
        },
        _                         : false,
    }
}

// ---- `check_call`'s `$fmt` (typecheck.rs, `rule.stdlib.format`) ----

fn is_enum_or_ref_enum(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(nb) : HashMap::contains(&it.enums, &Box::get(nb).name),
        Type::TRef(rb) : match (&Box::get(rb).inner)
        {
            Type::TNamed(nb) : HashMap::contains(&it.enums, &Box::get(nb).name),
            _                : false,
        },
        _                : false,
    }
}

// `printf` and `String::appendf` after `modres` (spec/21 §2f, D-0038): the
// format a string literal, one argument of its kind per specifier.
fn check_fmt(ref<Body, exclusive> b, ref<Items, shared> it, ref<Vec<Expr>, shared> args) : Result<Option<Type>, String>
{
    String f = match (if (Vec::len(args) > 0) { Some(&args[0].kind) } else { None })
    {
        Some(ExprKind::EStr(s)) : String::clone(s),
        _ : return Err(named_diag(
            "diag.format-invalid",
            &String::from_str("the format is a string literal, checked when the program is compiled"),
        )),
    };
    Vec<FmtKind> specs = match (fmt_arg_kinds(&String::as_bytes(&f)[0..$]))
    {
        Ok(k)  : k,
        Err(m) : return Err(named_diag("diag.format-invalid", &m)),
    };
    usize given = Vec::len(args) - 1;
    if (Vec::len(&specs) != given)
    {
        return Err(mismatch(sprintf(
            "the format takes %v argument%s, but %v follow%s",
            Vec::len(&specs),
            plural(Vec::len(&specs)),
            given,
            if (Vec::len(args) == 2) { "s" } else { "" },
        )));
    }
    for (usize i = 0; i < Vec::len(&specs); i += 1)
    {
        FmtKind k = specs[i];
        ref<Expr, shared> a = &args[i + 1];
        b.arg_temp_ok = true;
        Result<Option<Type>, String> t0 = check_store_operand(b, it, a, &None);
        b.arg_temp_ok = false;
        Option<Type> t1 = t0?;
        // A reference is formatted as the value it refers to (D-0042).
        Option<Type> t = match (t1)
        {
            Some(Type::TRef(rb)) :
            {
                ModedTy { inner, mode } = Box::into_inner(rb);
                if (named_is(&inner, "std::String"))
                {
                    Some(ref_of(inner, Mode::Shared))
                }
                else
                {
                    bool plain = match (&inner)
                    {
                        Type::TInt(_) : true,
                        Type::TF32    : true,
                        Type::TF64    : true,
                        Type::TBool   : true,
                        Type::TStr    : true,
                        _             : false,
                    };
                    if (plain) { Some(inner) } else { Some(ref_of(inner, mode)) }
                }
            },
            other                : other,
        };
        bool ok = match (&t)
        {
            None    : true,
            Some(x) :
            {
                if (has_unresolved_marker(x) || is_never(x))
                {
                    true
                }
                else if (k == FmtKind::FWidth)
                {
                    type_eq(x, &Type::TInt(IntTy::Usize))
                }
                else if (k == FmtKind::FValue)
                {
                    is_printable(x) || is_enum_or_ref_enum(it, x)
                }
                else
                {
                    match (x)
                    {
                        Type::TInt(_) : k == FmtKind::FInt,
                        Type::TF32    : k == FmtKind::FFloat,
                        Type::TF64    : k == FmtKind::FFloat,
                        Type::TStr    : k == FmtKind::FText,
                        Type::TBool   : k == FmtKind::FText,
                        Type::TRef(rb) : k == FmtKind::FText && Box::get(rb).mode == Mode::Shared && named_is(
                            &Box::get(rb).inner,
                            "std::String",
                        ),
                        _             : named_is(x, "std::StringView") && k == FmtKind::FText,
                    }
                }
            },
        };
        if (!ok)
        {
            Type tt = Option::expect(t, "a known type");
            String why = if (k == FmtKind::FWidth)
            {
                sprintf("a `*` width or precision takes a `usize`, and argument %v is `%s`", i + 1, &type_display(&tt))
            }
            else if (k == FmtKind::FValue)
            {
                sprintf(
                    "`%%v` prints numbers, `bool`, text, an enum's variant name, and references to them; argument %v is `%s`",
                    i + 1,
                    &type_display(&tt),
                )
            }
            else
            {
                str takes = if (k == FmtKind::FInt) { "an integer" } else if (k == FmtKind::FFloat) { "a floating-point number" } else { "text: a `str`, a `StringView`, a `bool` or a borrowed `String` (`&s`)" };
                str hint = if (named_is(
                    &tt,
                    "std::String",
                ) && k == FmtKind::FText) { "; a `String` is passed by reference -- `&s`, or bind a `String` result first and pass `&name`" } else if (named_is(
                    &tt,
                    "std::String",
                )) { "; print text with `%s`" } else { "" };
                sprintf("argument %v is `%s`, but its specifier takes %s%s", i + 1, &type_display(&tt), takes, hint)
            };
            return Err(mismatch(why));
        }
    }
    Ok(Some(Type::TStr))
}

// ---- D-0162: the checker's rewrites (views.rs `rewrite_literals_as_string`) ----

struct RewriteSets
{
    HashSet<usize> literals;
    HashMap<usize, Rewrite> rw;
}

fn rw_path(usize line, usize col, str a, str b2, str c) : Expr
{
    Vec<String> segs = Vec::new();
    Vec::push(&mut segs, String::from_str(a));
    Vec::push(&mut segs, String::from_str(b2));
    Vec::push(&mut segs, String::from_str(c));
    mk(ExprKind::EPath(Box::new(PathExpr { .segs = segs, .targs = Vec::new() })), line, col)
}

fn rw_block(ref<Block, exclusive> blk, ref<RewriteSets, shared> s)
{
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        match (&mut blk.stmts[i])
        {
            Stmt::SLet(l)         :
            {
                match (&mut Box::get_mut(l).init)
                {
                    Some(e) : rw_expr(e, s),
                    None    : {},
                }
            },
            Stmt::SDestructure(d) : rw_expr(&mut Box::get_mut(d).init, s),
            Stmt::SExpr(e)        : rw_expr(Box::get_mut(e), s),
            Stmt::SBlockLike(e)   : rw_expr(Box::get_mut(e), s),
        }
    }
    match (&mut blk.tail)
    {
        Some(t) : rw_expr(Box::get_mut(t), s),
        None    : {},
    }
}

fn rw_expr(ref<Expr, exclusive> e, ref<RewriteSets, shared> s)
{
    usize line = e.line;
    usize col = e.col;
    bool is_str = match (&e.kind)
    {
        ExprKind::EStr(_) : true,
        _                 : false,
    };
    if (is_str && HashSet::contains(&s.literals, &e.id))
    {
        wrap_owned(e);
        return;
    }
    Option<Rewrite> r = match (HashMap::get(&s.rw, &e.id))
    {
        Some(x) : Some(clone(x)),
        None    : None,
    };
    match (r)
    {
        // D-0164: `s == t` with a `String` and a `str` or `StringView`.
        Some(Rewrite::TextEq(te))  :
        {
            bool binary = match (&e.kind)
            {
                ExprKind::EBinary(_) : true,
                _                    : false,
            };
            if (binary)
            {
                ExprKind old = replace(&mut e.kind, ExprKind::EUnit);
                BinaryExpr bx = match (old)
                {
                    ExprKind::EBinary(bb) : Box::into_inner(bb),
                    _                     : return,
                };
                rw_expr(&mut bx.a, s);
                rw_expr(&mut bx.b, s);
                BinaryExpr { a, b, .. } = bx;
                Expr sx = mk(ExprKind::EUnit, line, col);
                Expr tx = mk(ExprKind::EUnit, line, col);
                if (te.string_left)
                {
                    sx = a;
                    tx = b;
                }
                else
                {
                    sx = b;
                    tx = a;
                }
                Vec<Expr> args = Vec::new();
                Vec::push(
                    &mut args,
                    mk(ExprKind::EBorrow(Box::new(BorrowExpr { .mode = Mode::Shared, .e = sx })), line, col),
                );
                Vec::push(&mut args, tx);
                Expr call = mk(
                    ExprKind::ECall(Box::new(CallExpr { .callee = rw_path(
                        line,
                        col,
                        "std",
                        "String",
                        if (te.other_is_str) { "eq_str" } else { "eq_view" },
                    ), .args = args })),
                    line,
                    col,
                );
                if (te.negate)
                {
                    e.kind = ExprKind::EUnary(Box::new(UnaryExpr { .op = UnOp::Not, .e = mk(
                        ExprKind::EParen(Box::new(call)),
                        line,
                        col,
                    ) }));
                }
                else
                {
                    Expr { kind, .. } = call;
                    e.kind = kind;
                }
                return;
            }
        },
        // D-0225: a text literal as a variant's `StringView` payload.
        Some(Rewrite::LiteralView) :
        {
            ExprKind lit = replace(&mut e.kind, ExprKind::EUnit);
            Vec<Expr> args = Vec::new();
            Vec::push(&mut args, mk(lit, line, col));
            e.kind = ExprKind::ECall(Box::new(CallExpr { .callee = rw_path(
                line,
                col,
                "std",
                "StringView",
                "of",
            ), .args = args }));
            return;
        },
        // D-0218: `&*e`, or `&e[0..$]` for a slice; `e`'s own parts are
        // rewritten first (the wrapped node keeps its number).
        Some(Rewrite::SharedRef)   :
        {
            rw_parts(e, s);
            Expr old = replace(e, mk(ExprKind::EUnit, line, col));
            e.kind = ExprKind::EBorrow(Box::new(BorrowExpr { .mode = Mode::Shared, .e = mk(
                ExprKind::EDeref(Box::new(old)),
                line,
                col,
            ) }));
            return;
        },
        Some(Rewrite::SharedSlice) :
        {
            rw_parts(e, s);
            Expr old = replace(e, mk(ExprKind::EUnit, line, col));
            e.kind = ExprKind::ESliceOf(Box::new(SliceExpr { .mode = Mode::Shared, .base = old, .lo = mk(
                ExprKind::EInt(Box::new(IntLit { .v = 0, .sfx = None })),
                line,
                col,
            ), .hi = mk(ExprKind::EDollar, line, col) }));
            return;
        },
        None                       : {},
    }
    rw_parts(e, s);
}

// The rewrites in `e`'s parts.
fn rw_parts(ref<Expr, exclusive> e, ref<RewriteSets, shared> s)
{
    match (&mut e.kind)
    {
        ExprKind::EStructLit(sb)  :
        {
            ref<StructLitExpr, exclusive> x = Box::get_mut(sb);
            for (usize i = 0; i < Vec::len(&x.fields); i += 1)
            {
                rw_expr(&mut x.fields[i].value, s);
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            for (usize i = 0; i < Vec::len(es); i += 1)
            {
                rw_expr(&mut es[i], s);
            }
        },
        ExprKind::EArrayRepeat(r) : rw_expr(&mut Box::get_mut(r).value, s),
        ExprKind::EUnary(ub)      : rw_expr(&mut Box::get_mut(ub).e, s),
        ExprKind::EBorrow(bb)     : rw_expr(&mut Box::get_mut(bb).e, s),
        ExprKind::EDeref(x)       : rw_expr(Box::get_mut(x), s),
        ExprKind::EField(fb)      : rw_expr(&mut Box::get_mut(fb).e, s),
        ExprKind::EPropagate(x)   : rw_expr(Box::get_mut(x), s),
        ExprKind::EParen(x)       : rw_expr(Box::get_mut(x), s),
        ExprKind::EBinary(bb)     :
        {
            rw_expr(&mut Box::get_mut(bb).a, s);
            rw_expr(&mut Box::get_mut(bb).b, s);
        },
        ExprKind::EIndex(pb)      :
        {
            rw_expr(&mut Box::get_mut(pb).a, s);
            rw_expr(&mut Box::get_mut(pb).b, s);
        },
        ExprKind::EAssign(pb)     :
        {
            rw_expr(&mut Box::get_mut(pb).a, s);
            rw_expr(&mut Box::get_mut(pb).b, s);
        },
        ExprKind::ESliceOf(sb)    :
        {
            ref<SliceExpr, exclusive> x = Box::get_mut(sb);
            rw_expr(&mut x.base, s);
            rw_expr(&mut x.lo, s);
            rw_expr(&mut x.hi, s);
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, exclusive> c = Box::get_mut(cb);
            rw_expr(&mut c.callee, s);
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                rw_expr(&mut c.args[i], s);
            }
        },
        ExprKind::EBlock(blk)     : rw_block(blk, s),
        ExprKind::EUnsafe(blk)    : rw_block(blk, s),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, exclusive> x = Box::get_mut(ib);
            rw_expr(&mut x.cond, s);
            rw_block(&mut x.then_, s);
            match (&mut x.else_)
            {
                Some(el) : rw_expr(el, s),
                None     : {},
            }
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, exclusive> x = Box::get_mut(wb);
            rw_expr(&mut x.cond, s);
            rw_block(&mut x.body, s);
            match (&mut x.step)
            {
                Some(st) : rw_expr(st, s),
                None     : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, exclusive> x = Box::get_mut(mb);
            rw_expr(&mut x.scrut, s);
            for (usize i = 0; i < Vec::len(&x.arms); i += 1)
            {
                ref<Arm, exclusive> arm = &mut x.arms[i];
                match (&mut arm.lit)
                {
                    Some(l) : rw_expr(Box::get_mut(l), s),
                    None    : {},
                }
                rw_expr(Box::get_mut(&mut arm.body), s);
            }
        },
        ExprKind::EReturn(opt)    :
        {
            match (opt)
            {
                Some(v) : rw_expr(Box::get_mut(v), s),
                None    : {},
            }
        },
        ExprKind::EClosure(cb)    : rw_block(&mut Box::get_mut(cb).body, s),
        _                         : {},
    }
}

// D-0162: the literals the check typed as `String` through a generic
// parameter (and never otherwise), and the other rewrites, applied to every
// function's body; whether there were any.
export fn apply_rewrites(ref<Items, exclusive> it, ref<Facts, exclusive> f) : bool
{
    HashSet<usize> lits = HashSet::new();
    for (usize i = 0; i < HashSet::len(&f.literal_yes); i += 1)
    {
        ref<usize, shared> id = HashSet::key_at(&f.literal_yes, i);
        if (!HashSet::contains(&f.literal_no, id))
        {
            HashSet::insert(&mut lits, *id);
        }
    }
    if (HashSet::len(&lits) == 0 && HashMap::len(&f.rewrites) == 0)
    {
        return false;
    }
    RewriteSets s = RewriteSets { .literals = lits, .rw = replace(&mut f.rewrites, HashMap::new()) };
    Vec<String> keys = Vec::new();
    for (usize i = 0; i < HashMap::len(&it.fns); i += 1)
    {
        Vec::push(&mut keys, String::clone(HashMap::key_at(&it.fns, i)));
    }
    for (usize i = 0; i < Vec::len(&keys); i += 1)
    {
        ref<FnDecl, exclusive> fd = Option::expect(HashMap::get_mut(&mut it.fns, &keys[i]), "a function");
        rw_block(&mut fd.body, &s);
    }
    true
}

// After the second check: a literal still typed as `String` is one a
// generic function's instantiations disagree about.
export fn literal_still_string(ref<Facts, shared> f) : bool
{
    for (usize i = 0; i < HashSet::len(&f.literal_yes); i += 1)
    {
        if (!HashSet::contains(&f.literal_no, HashSet::key_at(&f.literal_yes, i)))
        {
            return true;
        }
    }
    false
}

// `[Generic-Instantiation-Unbounded]` (CHG-0357): how deep a type argument
// may nest, and how many concrete instantiations a program may need.
const usize INSTANCE_DEPTH = 64;
const u32 MAX_INSTANCES = 100000;

// How many type constructors a type nests (`i32` 1, `Box<Vec<i32>>` 3).
fn type_depth(ref<Type, shared> t) : usize
{
    usize inner = match (t)
    {
        Type::TNamed(nb) :
        {
            usize m = 0;
            for (usize i = 0; i < Vec::len(&Box::get(nb).args); i += 1)
            {
                m = max(m, type_depth(&Box::get(nb).args[i]));
            }
            m
        },
        Type::TRef(rb)   : type_depth(&Box::get(rb).inner),
        Type::TSlice(sb) : type_depth(&Box::get(sb).inner),
        Type::TArray(ab) : type_depth(&Box::get(ab).inner),
        Type::TSimd(ab)  : type_depth(&Box::get(ab).inner),
        Type::TRawptr(x) : type_depth(Box::get(x)),
        Type::THandle(x) : type_depth(Box::get(x)),
        Type::TMutex(x)  : type_depth(Box::get(x)),
        Type::TGuard(x)  : type_depth(Box::get(x)),
        Type::TFn(fb)    :
        {
            usize m = type_depth(&Box::get(fb).ret);
            for (usize i = 0; i < Vec::len(&Box::get(fb).params); i += 1)
            {
                m = max(m, type_depth(&Box::get(fb).params[i]));
            }
            m
        },
        _                : 0,
    };
    1 + inner
}

// An f64 as Rust's `{}` writes it (coby's messages): the shortest digits
// that read back, never an exponent, no `.0` on a whole number.
fn rust_float_text(f64 x) : String
{
    String v = sprintf("%v", x);
    if (!is_finite(x))
    {
        return v;
    }
    StringView t = String::as_view(&v);
    String out = String::new();
    match (StringView::strip_prefix(t, "-"))
    {
        Some(r) :
        {
            String::push_ascii(&mut out, b'-');
            t = r;
        },
        None    : {},
    }
    // Mantissa digits and the position of the point in them.
    slice<u8, shared> b = StringView::as_bytes(t);
    String digits = String::new();
    i64 point = -1;
    i64 exp = 0;
    usize i = 0;
    while (i < slice_len(b))
    {
        u8 c = b[i];
        if (c == b'.')
        {
            point = narrow<i64>(String::len(&digits));
        }
        else if (c == b'e')
        {
            exp = Result::unwrap_or(StringView::parse<i64>(StringView::sub(t, i + 1, slice_len(b))), 0);
            break;
        }
        else
        {
            String::push_ascii(&mut digits, c);
        }
        i += 1;
    }
    if (point < 0)
    {
        point = narrow<i64>(String::len(&digits));
    }
    point += exp;
    ref<Vec<u8>, shared> d = String::as_bytes(&digits);
    i64 n = narrow<i64>(Vec::len(d));
    // Leading and trailing zeros of the digits do not count.
    i64 lo = 0;
    while (lo < n - 1 && d[narrow<usize>(lo)] == b'0' && lo < point - 1)
    {
        lo += 1;
    }
    i64 hi = n;
    while (hi > lo + 1 && d[narrow<usize>(hi - 1)] == b'0' && hi > point)
    {
        hi -= 1;
    }
    if (point <= 0)
    {
        String::push_ascii(&mut out, b'0');
        String::push_ascii(&mut out, b'.');
        for (i64 k = point; k < 0; k += 1)
        {
            String::push_ascii(&mut out, b'0');
        }
        for (i64 k = lo; k < hi; k += 1)
        {
            String::push_ascii(&mut out, d[narrow<usize>(k)]);
        }
        return out;
    }
    for (i64 k = lo; k < point; k += 1)
    {
        String::push_ascii(&mut out, if (k < hi) { d[narrow<usize>(k)] } else { b'0' });
    }
    if (hi > point)
    {
        String::push_ascii(&mut out, b'.');
        for (i64 k = point; k < hi; k += 1)
        {
            String::push_ascii(&mut out, d[narrow<usize>(k)]);
        }
    }
    out
}
