// The native `std` bodies (D-0274 stage 5; cobc's `lower_fn` native branch
// and the helpers the native_*.rs files share): `lower_native`, which
// writes a native body and its variants where one exists.

import std;
import ast;
import items;
import state;
import layout;
import typeops;
import cnames;
import direct;
import stage1a;
import bodies;
import native_vec;
import native_misc;
import native_text;

// D-0192: the `Vec` calls whose unchecked form a confined vector uses
// (`nc_variant`), and those `lower_vec_checked_once` serves (`once_variant`).
fn is_confining_call(StringView n) : bool
{
    n == "std::Vec::swap" || n == "std::Vec::reverse" || n == "std::Vec::insert" || n == "std::Vec::remove" || n == "std::Vec::truncate" || n == "std::Vec::clear" || n == "std::Vec::contains" || n == "std::Vec::index_of" || n == "std::Vec::binary_search" || n == "std::Vec::sort"
}

fn is_once_call(StringView n) : bool
{
    n == "std::Vec::swap" || n == "std::Vec::reverse" || n == "std::Vec::insert" || n == "std::Vec::remove" || n == "std::Vec::truncate" || n == "std::Vec::clear" || n == "std::Vec::pop" || n == "std::Vec::contains" || n == "std::Vec::index_of" || n == "std::Vec::binary_search"
}

// A line that checks through the vector's own path (`p_v`).
fn checks_p_v(StringView l) : bool
{
    StringView t = StringView::trim_start(l);
    StringView::contains(
        l,
        "p_v.tok",
    ) && (StringView::starts_with(t, "cb_read(") || StringView::starts_with(
        t,
        "cb_write(",
    ) || StringView::starts_with(t, "cb_borrow_check("))
}

// The body less its checks through `p_v` (cobc's `once_variant`).
export fn once_variant(ref<String, shared> body) : String
{
    String out = String::new();
    foreach (l in StringView::lines(body))
    {
        if (!checks_p_v(l))
        {
            String::appendf(&mut out, "%v\n", l);
        }
    }
    out
}

// The unchecked form for a confined vector: no check through `p_v`, no
// `cb_live_in` test (cobc's `nc_variant`).
export fn nc_variant(ref<String, shared> body) : String
{
    String out = String::new();
    foreach (l in StringView::lines(body))
    {
        if (!checks_p_v(l) && !StringView::contains(l, "cb_live_in"))
        {
            String::appendf(&mut out, "%v\n", l);
        }
    }
    out
}

// A plain element, or a resource holding no reference and no `fn` (cobc's
// `movable_elem`).
export fn movable_elem(ref<Gen, exclusive> g, ref<Type, shared> t) : bool
{
    plain_data(g, t) || (is_resource(g, t) && !has_refs(g, t) && !holds_fn(g, t) && !is_ref_ty(t))
}

fn is_ref_ty(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(_) : true,
        _             : false,
    }
}

// D-0200: a type an objectless local may hold (cobc's `objectless_type`).
export fn objectless_type(ref<Gen, exclusive> g, ref<Type, shared> t) : bool
{
    Vec<String> seen = Vec::new();
    objectless_type_in(g, t, &mut seen)
}

// D-0315 (step 4): a type a noted value may hold (cobc's `noted_type`).
export fn noted_type(ref<Gen, exclusive> g, ref<Type, shared> t) : bool
{
    g.noting = true;
    Vec<String> seen = Vec::new();
    bool r = objectless_type_in(g, t, &mut seen);
    g.noting = false;
    r
}

// D-0294: in a decided program no reference inside a value is tracked
// (`has_refs`), so a value with no resource and no `fn` in it is as plain
// data here.
fn ol_elem(ref<Gen, exclusive> g, ref<Type, shared> x, ref<Vec<String>, exclusive> seen) : bool
{
    // D-0315: a `void` part (`Result<void, String>`) holds nothing.
    if (is_void(x))
    {
        return true;
    }
    // D-0315 (step 4): a noted value may hold a `fn` value (its end is its
    // box's).
    bool fn_part = match (x)
    {
        Type::TFn(_) : true,
        _            : false,
    };
    if (g.noting && fn_part)
    {
        return true;
    }
    (plain_data(
        g,
        x,
    ) && !has_refs(g, x) && !holds_fn(g, x)) || (g.decided && decided_plain(g, x)) || objectless_type_in(
        g,
        x,
        seen,
    )
}

// `seen`: the struct and enum types being answered, by type code.
// D-0294: a type met again on the walk (`struct N { Vec<N> kids; }`, a
// syntax tree through `Box`) is answered yes there: the whole's answer is
// its other parts' (coinductively; before D-0294 it was no, and a recursive
// type never objectless).
// CHG-0429: an answer is kept (`ol_memo`) where it holds wherever it is asked:
// a no (made with every type still being answered taken as yes, it is no under
// fewer of them too), and a yes that leaned on no type being answered outside
// its own walk (`ol_low`). A type that names a closure is answered afresh each
// time: the closures' table grows as the lowering goes (cobc's
// `objectless_type_in`).
export fn objectless_type_in(ref<Gen, exclusive> g, ref<Type, shared> t, ref<Vec<String>, exclusive> seen) : bool
{
    String code = type_code(t);
    for (usize i = 0; i < Vec::len(seen); i += 1)
    {
        if (seen[i] == code)
        {
            if (i < g.ol_low)
            {
                g.ol_low = i;
            }
            return true;
        }
    }
    if (StringView::contains(&code, "closure"))
    {
        return objectless_type_walk(g, t, seen, &code);
    }
    String key = sprintf("%s#%v%v", &code, g.noting, g.decided);
    match (HashMap::get(&g.ol_memo, &key))
    {
        Some(r) : return *r,
        None    : {},
    }
    usize depth = Vec::len(seen);
    usize outer = g.ol_low;
    g.ol_low = max_value<usize>();
    bool r = objectless_type_walk(g, t, seen, &code);
    usize low = g.ol_low;
    if (!r || low >= depth)
    {
        HashMap::insert(&mut g.ol_memo, key, r);
    }
    g.ol_low = if (low < depth) { min(outer, low) } else { outer };
    r
}

fn objectless_type_walk(
    ref<Gen, exclusive> g,
    ref<Type, shared> t,
    ref<Vec<String>, exclusive> seen,
    ref<String, shared> code,
) : bool
{
    match (t)
    {
        // D-0315 (step 4): a thread's handle and a lock's guard, for a noted
        // value (their ends are `[Handle-Destructor]` and `[Guard-Drop]`); a
        // mutex by its interior; an array by its elements.
        Type::THandle(_)    : return g.decided && g.noting,
        Type::TGuard(_)     : return g.decided && g.noting,
        Type::TMutex(inner) : return g.decided && ol_elem(g, Box::get(inner), seen),
        Type::TArray(s)     : return g.decided && ol_elem(g, &Box::get(s).inner, seen),
        // D-0315 (step 4): in a decided program a closure, by its captures (a
        // reference is plain there).
        Type::TClosure(cid) :
        {
            if (!g.decided)
            {
                return false;
            }
            Vec<CapField> cfs = match (HashMap::get(&g.closures, *cid))
            {
                Some(info) : clone(&info.fields),
                None       : return false,
            };
            foreach (cf in &cfs)
            {
                if (!ol_elem(g, &cf.ty, seen))
                {
                    return false;
                }
            }
            return true;
        },
        Type::TNamed(n)     :
        {
            ref<NamedTy, shared> nt = Box::get(n);
            usize k = Vec::len(&nt.args);
            if (nt.name == "std::String" && k == 0)
            {
                return true;
            }
            // D-0294: in a decided program a `Box`, whose end the runtime
            // makes natively from the type descriptor (`box_of`), over such
            // a value (in a tracked one its contents' paths would need the
            // object `cb_raw_move_in` keeps).
            if (nt.name == "std::Box" && k == 1 && g.decided)
            {
                return ol_elem(g, &nt.args[0], seen);
            }
            if ((nt.name == "std::Vec" || nt.name == "std::Queue" || nt.name == "std::HashSet") && k == 1)
            {
                return ol_elem(g, &nt.args[0], seen);
            }
            if (nt.name == "std::HashMap" && k == 2)
            {
                return ol_elem(g, &nt.args[0], seen) && ol_elem(g, &nt.args[1], seen);
            }
            // (D-0294: a struct's; before, this arm took every name of the
            // program's, and an enum of the program's never reached the
            // next, D-0286's.)
            // D-0315: and in a decided program `std`'s.
            if (!StringView::starts_with(&nt.name, "std::") || g.decided)
            {
                match (struct_decl(g, &nt.name))
                {
                    Some(sd) :
                    {
                        // D-0315: in a decided program, also one declared `resource`
                        // with no destructor of its own: its end is its fields'.
                        // D-0315: `std`'s drains, whose destructors free memory
                        // alone (cobc's `MEMORY_ONLY_DROPS`).
                        // D-0315 (step 4): and the types with a destructor of
                        // their own (the program's and `std`'s), for a noted
                        // value (`noted_type`).
                        bool own_drop = HashMap::contains(&g.prog.table.fns, &sprintf("%s::drop", &nt.name)) && !(nt.name == "std::Drain" || nt.name == "std::HashDrain") && !g.noting;
                        if ((sd.resource_ && !(g.decided && !own_drop)) || Option::is_some(&sd.bits))
                        {
                            return false;
                        }
                        HashMap<String, Type> sub = subst_of(&sd.type_params, &nt.args);
                        Vec::push(seen, String::clone(code));
                        bool ok = true;
                        foreach (fd in &sd.fields)
                        {
                            if (ok)
                            {
                                Type ft = apply(&fd.ty, &sub);
                                ok = ol_elem(g, &ft, seen);
                            }
                        }
                        Vec::pop(seen);
                        return ok;
                    },
                    None     : {},
                }
            }
            // D-0286: in a decided program, an enum (`Option`, `Result`, the
            // program's own) not declared `resource`, with no destructor of
            // its own, whose payloads are such values or plain data.
            if (!g.decided)
            {
                return false;
            }
            match (enum_decl(g, &nt.name))
            {
                Some(ed) :
                {
                    // D-0315 (step 4): one with a destructor of its own (the
                    // program's or `std`'s), for a noted value (`noted_type`).
                    bool noted_ok = g.noting;
                    if (!noted_ok && (ed.resource_ || HashMap::contains(&g.prog.table.fns, &sprintf("%s::drop", &nt.name))))
                    {
                        return false;
                    }
                    HashMap<String, Type> sub = subst_of(&ed.type_params, &nt.args);
                    Vec::push(seen, String::clone(code));
                    bool ok = true;
                    foreach (v in &ed.variants)
                    {
                        match (&v.payload)
                        {
                            Some(p) :
                            {
                                if (ok)
                                {
                                    Type pt = apply(p, &sub);
                                    ok = ol_elem(g, &pt, seen);
                                }
                            },
                            None    : {},
                        }
                    }
                    Vec::pop(seen);
                    ok
                },
                None     : false,
            }
        },
        _                   : false,
    }
}

// D-0294: `plain_data` for a decided program (`Gen::decided`): a reference
// or slice, which no runtime state follows there, counts as plain, in a
// value as alone; a struct or enum the program declares (not a type
// parameter's bare name) over such values too.
// CHG-0429: its answers kept (`dp_memo`) for a named type that names no closure
// (cobc's `decided_plain`).
export fn decided_plain(ref<Gen, exclusive> g, ref<Type, shared> t) : bool
{
    bool named = match (t)
    {
        Type::TNamed(_) : true,
        Type::TArray(_) : true,
        Type::TSimd(_)  : true,
        _               : false,
    };
    if (!named)
    {
        return decided_plain_walk(g, t);
    }
    String code = type_code(t);
    if (StringView::contains(&code, "closure"))
    {
        return decided_plain_walk(g, t);
    }
    match (HashMap::get(&g.dp_memo, &code))
    {
        Some(r) : return *r,
        None    : {},
    }
    bool r = decided_plain_walk(g, t);
    HashMap::insert(&mut g.dp_memo, code, r);
    r
}

fn decided_plain_walk(ref<Gen, exclusive> g, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TInt(_)    : true,
        Type::TF32       : true,
        Type::TF64       : true,
        Type::TBool      : true,
        Type::TStr       : true,
        Type::TRawptr(_) : true,
        Type::TRef(_)    : true,
        Type::TSlice(_)  : true,
        Type::TArray(a)  : decided_plain(g, &Box::get(a).inner),
        Type::TSimd(a)   : decided_plain(g, &Box::get(a).inner),
        Type::TNamed(n)  :
        {
            ref<NamedTy, shared> nt = Box::get(n);
            match (struct_decl(g, &nt.name))
            {
                Some(sd) :
                {
                    if (sd.resource_)
                    {
                        return false;
                    }
                    HashMap<String, Type> sub = subst_of(&sd.type_params, &nt.args);
                    foreach (fd in &sd.fields)
                    {
                        if (!decided_plain(g, &apply(&fd.ty, &sub)))
                        {
                            return false;
                        }
                    }
                    return true;
                },
                None     : {},
            }
            match (enum_decl(g, &nt.name))
            {
                Some(ed) :
                {
                    if (ed.resource_)
                    {
                        return false;
                    }
                    HashMap<String, Type> sub = subst_of(&ed.type_params, &nt.args);
                    foreach (v in &ed.variants)
                    {
                        match (&v.payload)
                        {
                            Some(p) :
                            {
                                if (!decided_plain(g, &apply(p, &sub)))
                                {
                                    return false;
                                }
                            },
                            None    : {},
                        }
                    }
                    true
                },
                None     : false,
            }
        },
        _                : false,
    }
}

// D-0192: whether parameter `pos` of `key` is a pure direct reference (cobc's
// `pure_direct`): never under `--all-checks`, which the bootstrap form
// implies (stage 1).
export fn pure_direct(ref<Gen, exclusive> g, ref<String, shared> key, usize pos) : bool
{
    if (all_checks(g))
    {
        return false;
    }
    Vec<String> visiting = Vec::new();
    pure_direct_in(g, key, pos, &mut visiting)
}

// D-0196: whether `key` gets a `__raw` form (cobc's `raw_ret_ok`): a
// non-generic function returning a value an objectless local may hold, not a
// dual body; its `__raw` form ends its result's record where it returns, and
// the caller binds the value objectless.
export fn raw_ret_ok(ref<Gen, exclusive> g, ref<String, shared> key) : bool
{
    if (boot(g, 4))
    {
        return false;
    }
    // A pending `std` body is read as it stands (empty), not loaded; a
    // loaded one is lent (`get_fn`) and given back.
    if (is_pending(&g.prog.table, key))
    {
        FnDecl f = match (HashMap::get(&g.prog.table.fns, key))
        {
            Some(f) : clone(f),
            None    : return false,
        };
        return raw_ret_ok_decl(g, key, &f);
    }
    FnDecl f = match (get_fn(g, key))
    {
        Some(f) : f,
        None    : return false,
    };
    bool r = raw_ret_ok_decl(g, key, &f);
    give_fn(g, key, f);
    r
}

fn raw_ret_ok_decl(ref<Gen, exclusive> g, ref<String, shared> key, ref<FnDecl, shared> f) : bool
{
    if (Vec::len(&f.type_params) > 0)
    {
        return false;
    }
    if (*key == "main" || !objectless_type(g, &f.ret))
    {
        return false;
    }
    HashMap<String, Type> no_subst = HashMap::new();
    Option::is_none(&dual_eligible(g, f, &no_subst)) && Option::is_none(&field_dual_eligible(g, f, &no_subst))
}

// cobc's `lower_fn` native branch: when `name` has a native body, writes it
// (and its `__raw`, `_once` and `_nc` forms) after the prototype `sig`, and
// says so.
export fn lower_native(
    ref<Gen, exclusive> g,
    ref<String, shared> name,
    ref<FnDecl, shared> f,
    ref<Vec<Type>, shared> targs,
    ref<String, shared> cname,
    ref<String, shared> ret_c,
    ref<String, shared> sig,
) : bool
{
    // D-0274: no native body in the bootstrap form.
    if (boot(g, 5))
    {
        return false;
    }
    g.native_ctx = Some(NativeCtx { .name = String::clone(name), .targs = clone(targs), .ret_c = String::clone(ret_c), .sig = String::clone(sig) });
    Option<String> native = native_vec_index(g, name, f, targs, cname);
    g.native_ctx = None;
    String body = match (native)
    {
        Some(b) : b,
        None    : return false,
    };
    String::appendf(&mut g.fns, "%s\n{\n%s}\n\n", sig, &body);
    usize open = Option::expect(StringView::find(sig, "("), "a signature");
    StringView rest = &sig[open..$];
    // D-0200: the `__raw` form a caller binding the result objectless calls.
    if (Vec::len(targs) == 0 && *name != "main" && raw_ret_ok(g, name))
    {
        String raw_sig = sprintf("%s %s__raw%v", ret_c, cname, rest);
        String::appendf(&mut g.protos, "%s;\n", &raw_sig);
        String raw = match (native_raw_body(g, name, &body))
        {
            Some(b) : b,
            None    :
            {
                // The native called and its result's record ended at once.
                Vec<String> args = Vec::new();
                foreach (p in &f.params)
                {
                    Vec::push(&mut args, sprintf("p_%s", &san(&p.name)));
                }
                sprintf(
                    "    %s r = %s(%s);\n    cb_forget_obj(cb_recv(&r));\n    return r;\n",
                    ret_c,
                    cname,
                    &String::join(&args, ", "),
                )
            },
        };
        String::appendf(&mut g.fns, "%s\n{\n%s}\n\n", &raw_sig, &raw);
    }
    // `sort`'s unchecked form only for its integer and `bool` body.
    bool nc_shape = *name != "std::Vec::sort" || (Vec::len(targs) == 1 && match (&targs[0])
    {
        Type::TInt(_) : true,
        Type::TBool   : true,
        _             : false,
    });
    if (is_once_call(name))
    {
        String once_sig = sprintf("%s %s_once%v", ret_c, cname, rest);
        String::appendf(&mut g.protos, "%s;\n", &once_sig);
        String::appendf(&mut g.fns, "%s\n{\n%s}\n\n", &once_sig, &once_variant(&body));
    }
    if (is_confining_call(name) && nc_shape)
    {
        String nc_sig = sprintf("%s %s_nc%v", ret_c, cname, rest);
        String::appendf(&mut g.protos, "%s;\n", &nc_sig);
        String::appendf(&mut g.fns, "%s\n{\n%s}\n\n", &nc_sig, &nc_variant(&body));
    }
    true
}
