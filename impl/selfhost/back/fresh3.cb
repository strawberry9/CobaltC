// cobc's fresh.rs call shortcuts (`lower_map_fresh_key`, `lower_push_fresh`,
// `lower_set_insert_fresh`, `lower_channel_send_fresh`, `taken_objectless`)
// and closures.rs's `lower_box_new`, written in CobaltC (D-0274 stage 3): to
// be ported. Each returns `None` where the call is not its shape.

import std;
import ast;
import state;
import layout;
import typeops;
import cnames;
import direct;
import natives;
import gen;

export fn lower_map_fresh_key(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    StringView name,
    ref<FnDecl, shared> f,
    ref<Vec<Expr>, shared> args,
    usize line,
) : Option<V>
{
    None
}

