    "ded */\n"
    "void cb_frame_pop(void);   /* [Block-Exit]: ends the frame's owned objects last bound firs"
    "t, [Destroy] for a resource (its destructor, [Run-Destructor], [Destroy-Composite]), [Obje"
    "ct-End] for the rest; drops the frame's holds */\n"
    "void cb_frame_push_at(uint32_t file, uint32_t line);   /* [Block-Enter] with the block's l"
    "ocation, for a destruction fault */\n"
    "void cb_stmt_push(void);   /* [Stmt-Enter]: a statement scope for this statement's tempora"
    "ries and unheld paths */\n"
    "void cb_stmt_push_at(uint32_t file, uint32_t line);   /* [Stmt-Enter] with the statement's"
    " location */\n"
    "void cb_stmt_pop(void);   /* [Stmt-Exit]: ends the scope's temporaries ([Destroy]/[Object-"
    "End]) and its unheld paths; the result was re-stamped out by cb_result */\n"
    "\n"
    "/* objects (state.objects, state.holder, state.init, obligations) */\n"
    "uint64_t cb_new(void *addr, uint32_t ty, uint32_t file, uint32_t line);         /* a tempo"
    "rary of this statement — [Object-Establish-Plain]/[Object-Establish-Resource] over `addr` "
    "(storage the C provides, not the runtime's) with init valid, a temporary of the current st"
    "atement; assumes `addr` holds a value of `ty` */\n"
    "uint64_t cb_new_uninit(void *addr, uint32_t ty, uint32_t file, uint32_t line);  /* [Let-Un"
    "init] — [Let-Uninit]: [Object-Establish-*] with init uninitialized; assumes a whole-object"
    " [Write] before any read (definite assignment) */\n"
    "uint64_t cb_bind(uint64_t obj);                     /* adopt into the current frame; the r"
    "oot token — [Binding-Form] and [Store-Binding-Temp]: the current frame adopts the temporar"
    "y (state.holder); the root path's token is returned for the binding's accesses */\n"
    "void     cb_move_to(uint64_t obj, void *addr);      /* the same object, now at this addres"
    "s — internal: the same object, its cells now at `addr` (the C moved the bytes; the record "
    "follows). Assumes no path's target was derived from the old address */\n"
    "uint64_t cb_temp_path(uint64_t obj);                /* an owner-like path to a temporary ("
    "calling a closure temporary) — [Temp-Root]: an owner-like root path to a temporary (a clos"
    "ure temporary called) */\n"
    "uint64_t cb_take(uint64_t root, uint32_t file, uint32_t line);   /* [Authority-Transfer] o"
    "ut of a binding — [Store-Binding-Place-Transfer]/[Authority-Transfer] out of a binding: so"
    "litary and authority checked; the root path ends, the object is in flight */\n"
    "void     cb_absorb(uint64_t obj);                   /* [Relocate-In]: now part of a contai"
    "ner — [Relocate-In]: the temporary's contents are now a sub-resource of a container; its r"
    "ecord ends without destruction, its obligations move */\n"
    "void     cb_absorb_refs(uint64_t obj);              /* the same for plain data holding ref"
    "erences, moved in first: its slots stay — [Relocate-In] for plain data holding references,"
    " moved in first: its slots' holds stay */\n"
    "void     cb_result(uint64_t obj);                   /* a statement's result: re-stamped ou"
    "tward — [Stmt-Exit]'s re-stamp: the statement's result object belongs to the parent scope "
    "*/\n"
    "void     cb_destroy(uint64_t root, uint32_t file, uint32_t line);   /* drop(x) — [Destroy]"
    " through the binding's root path: temporally valid, solitary, authority held; [Run-Destruc"
    "tor], [Destroy-Composite], [Object-End] */\n"
    "void     cb_destroy_via(uint64_t tok, const void *addr, uint32_t ty, uint32_t file, uint32"
    "_t line); /* drop(*r): through a reference — [Destroy] through a reference (drop(*r)): the"
    " same premises on the referent */\n"
    "void     cb_consume(uint64_t obj, uint32_t file, uint32_t line);    /* destroy a temporary"
    " now — [Destroy] of a temporary now, as [Stmt-Exit] would at the statement's end */\n"
    "void     cb_end_moved_out(uint64_t obj);            /* end a temporary whose contents relo"
    "cated out — [Relocate-Out]'s source after a destructuring: the container ends ([Object-End"
    "]) without destroying the parts that moved */\n"
    "\n"
    "/* access paths (state.access-paths; spec/08, spec/10, spec/16) */\n"
    "uint64_t cb_borrow(uint64_t base, const cb_proj *p, size_t n, uint32_t mode, uint32_t file"
    ", uint32_t line);   /* [Borrow] from `base` through the projections `p` ([Field-Access], ["
    "Index-Checked] steps): temporally valid, mode no stronger than the source, ¬clash, [Thread"
    "-Affine]; mints the path, held by this statement until stored */\n"
    "uint64_t cb_borrow_range(uint64_t base, const void *cont, uint32_t cty, const cb_proj *p, "
    "size_t n, uint64_t lo, uint64_t hi, uint32_t mode, uint32_t file, uint32_t line);   /* a s"
    "lice's range (D-0070) — [Slice-Form]: [Borrow] whose last step is the range lo..hi (D-0070"
    ") */\n"
    "void     cb_read(uint64_t base, const cb_proj *p, size_t n, uint32_t file, uint32_t line);"
    "   /* [Read]'s premises on the place: temporally valid, ¬clash(shared), [Thread-Affine]; t"
    "he C reads the value itself */\n"
    "void     cb_write(uint64_t base, const cb_proj *p, size_t n, uint32_t target_resource, uin"
    "t32_t file, uint32_t line);   /* [Write]'s premises: temporally valid, mode exclusive, ¬cl"
    "ash(exclusive), ¬live-resource-at when `target_resource`; the C stores the value itself */"
    "\n"
    "void     cb_point_check(const uint64_t *args, size_t nargs, uint64_t base, const cb_proj *"
    "p, size_t n, uint32_t exclusive, const uint8_t *msg, uint64_t msg_len, uint32_t file, uint"
    "32_t line);   /* D-0283: a call's point check: the access the callee's summary declares th"
    "rough `base`, checked at the call — [Read]'s ¬clash(shared), or [Write]'s ¬clash(exclusive"
    ") when `exclusive` — the call's argument paths `args` counted as held */\n"
    "void     cb_write_quiet(uint64_t base, const cb_proj *p, size_t n, void *addr, uint32_t ty"
    ", uint32_t file, uint32_t line); /* D-0194: a quiet place's old value destroyed by the wri"
    "te — [Write-Quiet-Replace] (D-0194): the old quiet value at `addr` is destroyed ([Destroy]"
    ") and the place written */\n"
    "uint32_t cb_owns(const void *addr, uint32_t ty);   /* D-0049: the value there owns a resou"
    "rce now — `owns(τ, v)` of [Write]'s live-resource-at (D-0049): whether the value at `addr`"
    " owns a resource now */\n"
    "\n"
    "/* reference data (plan D5) */\n"
    "void     cb_store_ref(void *slot, uint64_t tok);   /* [Write] of a reference value: the sl"
    "ot's holder gains the path (held-by), keyed by the slot's address */\n"
    "void     cb_hold_ref(void *slot, uint64_t tok, const void *addr, uint32_t ty, uint32_t mod"
    "e, uint32_t file, uint32_t line);   /* D-0292: [Write] of a reference value with its place"
    ": a light reference becomes a holder (a path on its object, held by the slot) — [Write] of"
    " a reference value whose place cobc knows (D-0292): a light reference stored into data bec"
    "omes a holder, a recorded one is stored as cb_store_ref stores it */\n"
    "uint64_t cb_rec_ref(uint64_t tok, const void *addr, uint32_t ty, uint32_t mode, uint32_t k"
    "ind, uint32_t file, uint32_t line);   /* D-0292: a reference arriving in a recording frame"
    ", recorded (kind 1: held by the frame, a parameter; 0: stamped into the statement, a resul"
    "t) — [Borrow]'s record for a light reference arriving in a body whose references the run r"
    "ecords (D-0292): a path with the projection of its place; a recorded one is returned as it"
    " is */\n"
    "uint64_t cb_load_ref(const void *slot);   /* [Read] of a reference value: the token the sl"
    "ot holds */\n"
    "void     cb_valid(uint64_t tok, uint32_t file, uint32_t line);   /* [Swap-Places]: tempora"
    "lly valid, no conflict check */\n"
    "void     cb_copy_datum(void *dst, const void *src, uint32_t ty);   /* [Read] then [Write] "
    "of a value holding references: the bytes and each slot's hold are copied */\n"
    "void     cb_lend(void *addr, uint64_t size, uint32_t file, uint32_t line);   /* D-0213 — ["
    "Thread-Lend]: every exclusive path in the value at `addr` is lent (transit) to the thread "
    "that receives it */\n"
    "void     cb_lend_fn(void *h, uint32_t file, uint32_t line);                 /* D-0213 — [T"
    "hread-Lend] for a closure's captures */\n"
    "\n"
    "/* text and hashing helpers */\n"
    "/* The first position of the `nn` bytes at `n` in the `hn` bytes at `h`,\n"
    "   or UINT64_MAX (`StringView::find`'s answer natively; an empty needle\n"
    "   is found at 0). Pure. */\n"
    "static inline uint64_t cb_find_bytes(const uint8_t *h, uint64_t hn, const uint8_t *n, uint"
    "64_t nn)\n"
    "{\n"
    "    if (nn == 0) return 0;\n"
    "    if (nn > hn) return UINT64_MAX;\n"
    "    const uint8_t *p = h, *last = h + (hn - nn);\n"
    "    while (p <= last) {\n"
    "        p = (const uint8_t *)memchr(p, n[0], (size_t)(last - p) + 1);\n"
    "        if (!p) return UINT64_MAX;\n"
    "        if (memcmp(p, n, (size_t)nn) == 0) return (uint64_t)(p - h);\n"
    "        p++;\n"
    "    }\n"
    "    return UINT64_MAX;\n"
    "}\n"
    "/* `StringView::boundary`: `i` at either end, or on a byte that does not\n"
    "   continue a UTF-8 sequence. Pure. */\n"
    "static inline int cb_char_boundary(const uint8_t *d, uint64_t n, uint64_t i)\n"
    "{\n"
    "    return i == 0 || i == n || (d[i] & 0xC0u) != 0x80u;\n"
    "}\n"
    "\n"
    "/* raw storage (spec/20 §2, spec/21 §0): reclaimed objects live at raw\n"
    "   addresses, owned by no frame; `reclaim` attaches or re-attaches one */\n"
    "uint64_t cb_reclaim(void *addr, uint32_t ty);                    /* [Reclaim]: the object'"
    "s root token */\n"
    "uint64_t cb_elem_borrow(void *addr, uint32_t ty, uint32_t mode);   /* [Reclaim] of the ele"
    "ment's cells and [Borrow] of it (Vec::index_*): a path over raw storage */\n"
    "uint64_t cb_elem_borrow_here(void *addr, uint32_t ty, uint32_t mode);  /* the same, record"
    "ed in the current scope (a `…_pre` body) — [Reclaim] and [Borrow] of an element, the path "
    "recorded in the current scope (a `…_pre` body) */\n"
    "void cb_deallocate_plain(uint8_t *addr, uint64_t size);   /* cells that never held a refer"
    "ence — [Deallocate] of cells that never held a reference: no [Release] of reference holder"
    "s is needed */\n"
    "void cb_elem_access_slow(void *addr, uint32_t ty, uint32_t mode, uint32_t write, uint32_t "
    "file, uint32_t line);   /* [Read]/[Write] premises on an element over raw cells where an o"
    "bject lies (otherwise no object, no path, no check) */\n"
    "extern uintptr_t cb_reclaimed_entries;   /* entries over raw cells (an AtomicUsize); 0: no"
    " object over any element — internal: the count of reclaimed objects, the fast path's gate "
    "(0: no element has an object) */\n"
    "extern uint64_t  cb_live_threads;        /* threads running, the main one included (an Ato"
    "micU64); 1: this thread is alone (D-0209) — internal: the running threads, the gate of [Th"
    "read-Affine] checks (1: alone) */\n"
    "extern uint8_t   cb_threaded;            /* 1 once a thread has been spawned (an AtomicU8)"
    "; the generated C notes a frame's objectless locals only then (D-0269) — internal: the gat"
    "e of cb_notes_push */\n"
    "struct cb_note { void *p; const uint8_t *moved; uint32_t tid; uint8_t live; };   /* D-0269"
    ": an objectless local (D-0200) of a frame: its address, its moved flag (NULL for none), it"
    "s type, whether bound now — internal: an entry of the table cb_notes_push registers */\n"
    "void cb_notes_push(struct cb_note *t, uint32_t n);   /* D-0269: a function that binds obje"
    "ctless locals enters while threads run: its table, for [Fault-Contain]'s unwind to end its"
    " live entries ([Destroy]/[Object-End], as cb_drop_local) where the C statements that end t"
    "hem never run */\n"
    "void cb_notes_pop(void);   /* D-0269: that function returns: its table leaves — internal: "
    "the pair of cb_notes_push */\n"
    "extern uint8_t cb_sched_flag;            /* 1 under a schedule (`--explore`, `--schedule-s"
    "eed`); an AtomicU8 — internal: whether a schedule runs the threads ([Thread-Step] under --"
    "explore) */\n"
    "void cb_atomic_point(void);              /* D-0249: an atomic operation, a point where a s"
    "chedule may pass the turn — [Thread-Step] under a schedule: a point where the turn may pas"
    "s */\n"
    "uint64_t cb_atomic_wait(uint64_t op, const void *addr, uint64_t seen); /* D-0253: an atomi"
    "c's wake count: read, wait, notify — [Atomic-Wake-Read] (op 0), [Atomic-Wait] (1), [Atomic"
    "-Notify] (2, 3) on the atomic at `addr` */\n"
    "void cb_spin_hint(void);                 /* D-0253: the processor's pause — [Spin-Hint] */"
    "\n"
    "extern uint32_t cb_reclaimed_pages[4096];   /* the same by page, `(a >> 12) & 4095` (Atomi"
    "cU32s) — internal: cb_reclaimed_entries by page, the gate of cb_reclaimed_near */\n"
    "/* Whether an entry may lie over the `size` bytes at `addr`: an element of\n"
    "   at most a page lies on at most two, and a larger one is always asked. */\n"
    "static inline int cb_reclaimed_near(const void *addr, uint64_t size)   /* internal: whethe"
    "r a reclaimed object may lie over the cells */\n"
    "{\n"
    "    uintptr_t a = (uintptr_t)addr;\n"
    "    if (size > 4096u) return 1;\n"
    "    if (size == 0) size = 1;\n"
    "    return __atomic_load_n(&cb_reclaimed_pages[(a >> 12) & 4095u], __ATOMIC_RELAXED) != 0\n"
    "        || __atomic_load_n(&cb_reclaimed_pages[((a + size - 1) >> 12) & 4095u], __ATOMIC_R"
    "ELAXED) != 0;\n"
    "}\n"
    "/* *Vec::index_*(...) or a Box's contents read or written at once, `size`\n"
    "   the element's: checked only where an object lies over the element,\n"
    "   and none does while the runtime holds no entry on its pages. */\n"
    "static inline void cb_elem_access(void *addr, uint64_t size, uint32_t ty, uint32_t mode, u"
    "int32_t write, uint32_t file, uint32_t line)   /* [Read]/[Write] on an element: checked (c"
    "b_elem_access_slow) only where an object may lie over it; otherwise no object exists there"
    " and no rule applies */\n"
    "{\n"
    "    if (__builtin_expect(__atomic_load_n(&cb_reclaimed_entries, __ATOMIC_RELAXED) != 0, 0)"
    " && cb_reclaimed_near(addr, size)) cb_elem_access_slow(addr, ty, mode, write, file, line);"
    "\n"
    "}\n"
    "void cb_drop_local(void *addr, uint32_t ty);   /* [Destroy]/[Object-End] of an objectless "
    "local's value (D-0200): the value is destroyed as its binding's end would */\n"
    "/* D-0200: an objectless `String` or `Vec` of plain elements at `self` ends:\n"
    "   its buffer (`bytes` bytes at `buf`, never holding a reference, never\n"
    "   over-aligned) freed at once while the runtime holds no entry on its\n"
    "   pages; otherwise `cb_drop_local`'s general path. */\n"
    "static inline void cb_drop_plain_buf(void *self, uint32_t ty, void *buf, uint64_t bytes)  "
    " /* [Deallocate] of an objectless String's or Vec's buffer at once when no object lies ove"
    "r it, else cb_drop_local */\n"
    "{\n"
    "    if (bytes == 0) return;\n"
    "    if (__builtin_expect(__atomic_load_n(&cb_reclaimed_entries, __ATOMIC_RELAXED) != 0, 0)"
    " && cb_reclaimed_near(buf, bytes)) { cb_drop_local(self, ty); return; }\n"
    "    free(buf);\n"
    "}\n"
    "/* An element of a direct slice: checked only where the slice's entry\n"
    "   test (`cb_live_in`) found an object over one of its elements. */\n"
    "static inline void cb_elem_access_if(uint8_t live, void *addr, uint32_t ty, uint32_t mode,"
    " uint32_t write, uint32_t file, uint32_t line)   /* [Read]/[Write] on an element of a dire"
    "ct slice: checked where cb_live_in found an object */\n"
    "{\n"
    "    if (__builtin_expect(live != 0, 0)) cb_elem_access_slow(addr, ty, mode, write, file, l"
    "ine);\n"
    "}\n"
    "void     cb_borrow_range_unminted(uint64_t base, const void *cont, uint32_t cty, const cb_"
    "proj *p, size_t n, uint64_t lo, uint64_t hi, uint32_t mode, uint32_t file, uint32_t line);"
    " /* `&e[lo..hi]` for a pure direct slice: the checks alone — [Slice-Form]'s premises witho"
    "ut minting a path: a direct parameter's slice (D-0209) */\n"
    "void     cb_borrow_unminted(uint64_t base, const cb_proj *p, size_t n, uint32_t mode, uint"
    "32_t file, uint32_t line); /* `&p` to a pure direct parameter: the check alone — [Borrow]'"
    "s premises without minting: `&p` to a pure direct parameter (D-0191) */\n"
    "void     cb_borrow_check(uint64_t base, const cb_proj *p, size_t n, uint32_t mode, uint32_"
    "t file, uint32_t line); /* `&v` straight into Vec::index_*: checks only */  /* Vec::index_"
    "*: [Reclaim] + [Borrow] + send (spec/21 §0) — [Borrow]'s premises without minting: `&v` st"
    "raight into Vec::index_* */\n"
    "void     cb_vec_drop_plain(void *addr, uint64_t len, uint64_t size);   /* Vec::drop elemen"
    "t loop, plain T (spec/21 §0) — [Object-End] of every element object over the buffer, as Ve"
    "c::drop's loop does for plain elements; [Deallocate] follows */\n"
    "void     cb_raw_move_in(uint64_t obj, void *addr);               /* `*p = v`, v a resource"
    ": [Rawptr-Move-In] */\n"
    "uint8_t  cb_live_at(void *addr);   /* internal: whether a live object lies at `addr` (a na"
    "tive body's gate) */\n"
    "uint8_t  cb_live_in(void *addr, uint64_t n);                     /* a live object over any"
    " of n cells: a native body takes its general path — internal: whether a live object lies o"
    "ver any of the n cells */\n"
    "uint8_t  cb_frozen_ok(uint64_t tok, const void *lo, size_t n);   /* CHG-0237: a frozen par"
    "ameter's body may run — [Read]'s premises for a frozen parameter's whole body (D-0205, CHG"
    "-0237): valid, initialized, not lock-derived, no exclusive path over it */\n"
    "uint8_t  cb_live_in2(void *a, void *b, uint64_t n);             /* cb_live_in of two runs "
    "of n cells — internal: cb_live_in of two runs */\n"
    "uint64_t cb_elem_borrow_datum(void *addr, uint32_t ty, uint32_t mode); /* Some(&elem) retu"
    "rned as reference data — [Reclaim] and [Borrow] of an element returned as reference data ("
    "Some(&elem)) */\n"
    "uint64_t cb_peek_datum_tok(size_t k, size_t n);               /* dual-body dispatch: the k"
    "-th of n data's token, left in flight — internal: dual-body dispatch (D-0188): the k-th in"
    "-flight datum's token */\n"
    "uint8_t  cb_paths_disjoint(size_t n, const uint64_t *toks, const uint8_t *excl); /* dual-b"
    "ody dispatch: valid and pairwise disjoint — internal: dual-body dispatch: the arguments' p"
    "aths valid and pairwise disjoint, so the direct body may run */\n"
    "uint8_t  cb_paths_arrive(size_t n, const uint64_t *toks, const uint8_t *excl); /* D-0219: "
    "and each clash-free as it arrives — [Borrow]'s ¬clash for each argument as it arrives (D-0"
    "219), beside cb_paths_disjoint */\n"
    "uint8_t  cb_direct_ok(size_t n, const uint64_t *toks);        /* D-0209: direct parameters"
    "' paths valid, over fresh storage — [Read]/[Write] premises for direct parameters' paths ("
    "D-0209): valid, over fresh storage */\n"
    "void     cb_send_tok_datum(uint64_t tok);                       /* a path formed in a nati"
    "ve body, sent as one-reference data — internal: a path a native body formed, sent as one-r"
    "eference data */\n"
    "void     cb_send_datum_none(void);                               /* None returned as refer"
    "ence data — internal: None returned as reference data */\n"
    "void     cb_frame_hold(uint64_t tok);                            /* a reference local with"
    " no object: the frame holds its path — a reference local without an object: the frame hold"
    "s its path (an occurrence) until [Block-Exit] or [Ref-Binding-Last-Use] (D-0111) */\n"
    "void     cb_frame_unhold(uint64_t tok);                          /* … until it ends early "
    "(D-0111) */                                 /* a live object over these cells? (native dro"
    "ps) — [Ref-Binding-Last-Use] (D-0111): the frame's hold ends early */\n"
    "void     cb_raw_move_out(void *addr, void *dst, uint32_t ty);    /* `*p` read of a resourc"
    "e into dst: [Rawptr-Move-Out] */\n"
    "void     cb_release(void *addr, uint64_t n);                     /* [Release]: end reclaim"
    "ed objects starting in the range */\n"
    "void     cb_release_plain(uint8_t *addr, uint64_t n);             /* cb_release for cells "
    "that never hold a reference — [Release] for cells that never hold a reference */\n"
    "uint8_t *cb_reallocate_plain(uint8_t *addr, uint64_t old, uint64_t new_size, uint64_t alig"
    "n); /* Vec growth of plain elements — Vec::grow of plain elements: [Allocate], [Copy-Raw],"
    " [Deallocate] of the old cells */\n"
    "void    *cb_allocate(uint64_t size, uint64_t align);             /* 0 on failure — [Alloca"
    "te]: 0 on failure (Err) */\n"
    "void     cb_deallocate(void *addr, uint64_t size, uint64_t align);   /* [Deallocate]: [Rel"
    "ease] of the objects over the cells, then the cells leave storage */\n"
    "void     cb_copy_raw(void *dst, const void *src, uint64_t n);   /* [Copy-Raw] */\n"
    "\n"
    "/* values in flight across a call boundary, in argument order */\n"
    "void     cb_send(uint64_t obj);   /* [Call]'s argument passing: the object is in flight fr"
    "om the caller to the callee's [Store-Binding-Temp] */\n"
    "uint64_t cb_recv(void *addr);   /* [Store-Binding-Temp] side of a call: the in-flight obje"
    "ct, now at `addr`, bound by the callee */\n"
    "void     cb_send_ref(uint64_t tok);   void cb_recv_ref(void);   /* [Call]: a reference arg"
    "ument in flight, pending until [Store-Binding-Value] binds it (D-0107) */\n"
    "void     cb_result_ref(uint64_t tok);                     /* a statement's reference resul"
    "t: re-stamped outward — [Stmt-Exit]'s re-stamp for a reference result */\n"
    "void     cb_send_datum(const void *src, uint32_t ty);   /* [Call]: a value holding referen"
    "ces in flight; its slots' holds move with it */\n"
    "void     cb_recv_datum(void *dst, uint32_t ty);   /* [Store-Binding-Value] of in-flight re"
    "ference data into `dst` */\n"
    "uint64_t cb_recv_datum_tok(void);                         /* one reference's data, unheld:"
    " its token (0: none) — internal: one reference's in-flight data, unheld: its token */\n"
    "void     cb_forget_obj(uint64_t obj);                       /* an objectless local's recei"
    "ved object: its record ends, its value is kept — internal: an objectless local's received "
    "object (D-0200): its record ends, its value is kept by the C */\n"
    "void     cb_drop_local(void *addr, uint32_t ty);            /* that local ends: its value "
    "is destroyed — internal: declared again above, [Destroy]/[Object-End] of an objectless loc"
    "al (D-0200) */\n"
    "\n"
    "/* threads and mutexes (spec/19; impl/COBC-PLAN.md §9) */\n"
    "void    *cb_env_alloc(uint64_t size, uint64_t align);              /* a spawned thread's a"
    "rgument block, zeroed, aligned as its struct — [Spawn]: the argument block, storage outsid"
    "e every object */\n"
    "uint64_t cb_spawn(void (*body)(void *), void *env, uint64_t env_size, uint32_t res_ty);   "
    "/* [Spawn]: the thread id */\n"
    "void     cb_hold(uint64_t obj);                                    /* a resource argument "
    "waiting in a block — [Spawn]: a resource argument held in the block until the new thread's"
    " [Store-Binding-Temp] */\n"
    "void     cb_thread_done(uint64_t res_obj);                         /* [Thread-Body-Done]: "
    "the result is in the block */\n"
    "void     cb_env_forget(void *addr, uint64_t size);                 /* the block's referenc"
    "es stop being occurrences — [Spawn]: the block's reference cells stop counting as holders "
    "once the parameters are bound */\n"
    "void     cb_drop_fn(void *handle);                                 /* destroy a fn value ("
    "a closure box) — [Destroy] of a closure box: the closure object it owns ends (D-0089) */\n"
    "/* D-0204: supervised threads -- a contained fault's unwind ends at the\n"
    "   trampoline's setjmp; join_status (std::try_join), cancel, a failure's text */\n"
    "void     cb_thread_jmp(void *jb);   /* [Fault-Contain] (D-0204): the trampoline's jump buf"
    "fer, where a contained fault's unwind ends */\n"
    "void     cb_thread_start(void *env, uint64_t size, void *h);   /* [Spawn] in the new threa"
    "d: registers it and binds its parameters from the block */\n"
    "void     cb_thread_failed(void);   /* [Fault-Contain]: the thread's failure is recorded (t"
    "hreads(ℓ).value := failed) */\n"
    "void     cb_thread_lent(void);   /* [Thread-Lend]'s consequence for containment: a thread "
    "lent an exclusive reference is never contained */\n"
    "uint64_t cb_join_status(uint64_t tid, uint8_t mode);   /* [Try-Join] (mode 0, waits) and ["
    "Is-Finished] (mode 1) */\n"
    "void     cb_cancel(uint64_t tid);   /* [Cancel] (D-0204) */\n"
    "int64_t  cb_task_op(uint64_t op, uint64_t id, void *out, uint64_t cap);   /* [Failure-Text"
    "] and the supervision operations' queries */\n"
    "uint64_t cb_join(uint64_t tid, void *dst);                         /* [Join]: the result's"
    " object, or 0 */\n"
    "uint64_t cb_lock(uint64_t tok, void *m, uint32_t ty, uint32_t file, uint32_t line);   /* ["
    "Lock]: the lock path's token */\n"
    "uint64_t cb_lock_pathless(void *m, uint32_t file, uint32_t line);   /* D-0289: [Lock] with"
    " no lock path (CB_PATHLESS) */\n"
    "void     cb_lock_bare(void *m, uint32_t file, uint32_t line);   /* D-0200: lock without a "
    "guard — [Lock] without a guard object (D-0200, std's own bodies): sync(o) := locked-by; un"
    "locked by cb_unlock_bare */\n"
    "void     cb_unlock_bare(void *m);   /* [Guard-Drop] without a guard object */\n"
    "void     cb_unlock_signal(void *m, uint64_t id);   /* D-0200: event_op(3, id) then cb_unlo"
    "ck_bare(m) — [Atomic-Notify]-like event signal (event_op(3, id)) then [Guard-Drop] without"
    " a guard, as one step */\n"
    "\n"
    "/* text and hashing helpers */\n"
    "static inline uint8_t cb_str_eq(cb_str a, cb_str b)\n"
    "{\n"
    "    return a.n == b.n && (a.n == 0 || memcmp(a.p, b.p, a.n) == 0);\n"
    "}\n"
    "\n"
    "/* A hash-table key's hash and equality (spec/21 rule.stdlib.hashmap):\n"
    "   FNV-1a, 64-bit, over the key's bytes. */\n"
    "static inline uint64_t cb_hash_bytes(const void *p, uint64_t n)\n"
    "{\n"
    "    const uint8_t *b = (const uint8_t *)p;\n"
    "    uint64_t h = 14695981039346656037ull;\n"
    "    for (uint64_t i = 0; i < n; i++)\n"
    "    {\n"
    "        h = (h ^ b[i]) * 1099511628211ull;\n"
    "    }\n"
    "    return h;\n"
    "}\n"
    "\n"
    "/* D-0110: FNV-1a continued from h over n more bytes (a composite key) */\n"
    "static inline uint64_t cb_fnv_more(uint64_t h, const void *p, uint64_t n)\n"
    "{\n"
    "    const uint8_t *b = (const uint8_t *)p;\n"
    "    for (uint64_t i = 0; i < n; i++)\n"
    "    {\n"
    "        h = (h ^ b[i]) * 1099511628211ull;\n"
    "    }\n"
    "    return h;\n"
    "}\n"
    "\n"
    "/* D-0108: text in byte order; negative, zero or positive */\n"
    "static inline int cb_bytes_cmp(const void *a, uint64_t an, const void *b, uint64_t bn)\n"
    "{\n"
    "    uint64_t n = an < bn ? an : bn;\n"
    "    int c = n == 0 ? 0 : memcmp(a, b, n);\n"
    "    return c != 0 ? c : (an < bn ? -1 : an > bn ? 1 : 0);\n"
    "}\n"
    "\n"
    "static inline uint8_t cb_bytes_eq(const void *a, uint64_t an, const void *b, uint64_t bn)\n"
    "{\n"
    "    return an == bn && (an == 0 || memcmp(a, b, an) == 0);\n"
    "}\n"
    "\n"
    "/* D-0293 (D-0281 phase 3 step 4): the token-kind tests inline. A token is\n"
    "   `0` (no record), `CB_LIGHT | CB_ROOT | obj` (the owner's own binding),\n"
    "   `CB_LIGHT | obj` (a light reference) or a path id (D-0292). A light\n"
    "   reference needs no check an entry could make, and the owner's binding\n"
    "   none while its object has no path on it (`cb_marks`: per heap, one byte\n"
    "   per object, kept by the runtime), so the entries below test the token\n"
    "   first and call the runtime only for a path, a marked owner, or under an\n"
    "   oracle (`cb_inline_off`: COBALTC_RECORD=full|check). A decided body\n"
    "   (cobc: `enum { cb_lf = 1 };` at its start) may also form a light borrow\n"
    "   inline; a recording body, and the std natives that share any frame, keep\n"
    "   the runtime's borrow, which records in a recording frame. */\n"
    "#define CB_LIGHT (1ULL << 53)\n"
    "#define CB_ROOT  (1ULL << 54)\n"
    "extern uint8_t *cb_marks[256];   /* internal: per heap, one byte per object slot, nonzero "
    "while the object has paths on it (D-0293) */\n"
    "extern uint8_t cb_inline_off;    /* internal: 1 under COBALTC_RECORD=full|check: the inlin"
    "e tests make no decision (D-0293) */\n"
    "enum { cb_lf = 0 };   /* a decided body shadows it with 1: its borrows from vouched tokens"
    " are light (D-0293) */\n"
    "static inline uint8_t cb_vouched(uint64_t t)   /* internal: a token no check needs to see:"
    " a light reference, or an owner's binding whose object is unmarked (D-0293) */\n"
    "{\n"
    "    return !cb_inline_off && (t & CB_LIGHT) != 0 && ((t & CB_ROOT) == 0 || cb_marks[(t >> "
    "55) & 0xffu][(uint32_t)t - 1u] == 0);\n"
    "}\n"
    "#ifndef CB_PATHLESS\n"
    "static inline void cb_borrow_check_i(uint64_t b, const cb_proj *p, size_t n, uint32_t m, u"
    "int32_t f, uint32_t l)   /* internal: cb_borrow_check for a token that is not vouched (D-0"
    "293) */\n"
    "{\n"
    "    if (!cb_vouched(b)) cb_borrow_check(b, p, n, m, f, l);\n"
    "}\n"
    "static inline void cb_borrow_unminted_i(uint64_t b, const cb_proj *p, size_t n, uint32_t m"
    ", uint32_t f, uint32_t l)   /* internal: cb_borrow_unminted for a token that is not vouche"
    "d (D-0293) */\n"
    "{\n"
    "    if (!cb_vouched(b)) cb_borrow_unminted(b, p, n, m, f, l);\n"
    "}\n"
    "static inline void cb_borrow_range_unminted_i(uint64_t b, const void *c, uint32_t ct, cons"
    "t cb_proj *p, size_t n, uint64_t lo, uint64_t hi, uint32_t m, uint32_t f, uint32_t l)   /*"
    " internal: cb_borrow_range_unminted for a token that is not vouched (D-0293) */\n"
    "{\n"
    "    if (!cb_vouched(b)) cb_borrow_range_unminted(b, c, ct, p, n, lo, hi, m, f, l);\n"
    "}\n"
    "static inline void cb_read_i(uint64_t b, const cb_proj *p, size_t n, uint32_t f, uint32_t "
    "l)   /* internal: cb_read for a token that is not vouched (D-0293) */\n"
    "{\n"
    "    if (!cb_vouched(b)) cb_read(b, p, n, f, l);\n"
    "}\n"
    "static inline uint64_t cb_borrow_i(int lf, uint64_t b, const cb_proj *p, size_t n, uint32_"
    "t m, uint32_t f, uint32_t l)   /* internal: cb_borrow, light inline in a decided body from"
    " a vouched token (D-0293) */\n"
    "{\n"
    "    return lf && cb_vouched(b) ? (b & ~CB_ROOT) : cb_borrow(b, p, n, m, f, l);\n"
    "}\n"
    "static inline uint64_t cb_borrow_unstamped_i(int lf, uint64_t b, const cb_proj *p, size_t "
    "n, uint32_t m, uint32_t f, uint32_t l)   /* internal: cb_borrow_unstamped, light inline in"
    " a decided body from a vouched token (D-0293) */\n"
    "{\n"
    "    return lf && cb_vouched(b) ? (b & ~CB_ROOT) : cb_borrow_unstamped(b, p, n, m, f, l);\n"
    "}\n"
    "static inline void cb_write_i(int lf, uint64_t b, const cb_proj *p, size_t n, uint32_t tr,"
    " uint32_t f, uint32_t l)   /* internal: cb_write through a light reference in a decided bo"
    "dy: the place holds its value, a resource target is overwritten live (D-0293) */\n"
    "{\n"
    "    if (lf && !cb_inline_off && (b & (CB_LIGHT | CB_ROOT)) == CB_LIGHT)\n"
    "    {\n"
    "        if (tr) cb_fault(\"diag.overwrite-of-live-resource\", f, l);\n"
    "        return;\n"
    "    }\n"
    "    cb_write(b, p, n, tr, f, l);\n"
    "}\n"
    "#define cb_borrow_check(...)          cb_borrow_check_i(__VA_ARGS__)\n"
    "#define cb_borrow_unminted(...)       cb_borrow_unminted_i(__VA_ARGS__)\n"
    "#define cb_borrow_range_unminted(...) cb_borrow_range_unminted_i(__VA_ARGS__)\n"
    "#define cb_read(...)                  cb_read_i(__VA_ARGS__)\n"
    "#define cb_borrow(...)                cb_borrow_i(cb_lf, __VA_ARGS__)\n"
    "#define cb_borrow_unstamped(...)      cb_borrow_unstamped_i(cb_lf, __VA_ARGS__)\n"
    "#define cb_write(...)                 cb_write_i(cb_lf, __VA_ARGS__)\n"
    "#endif\n"
    "\n"
    "#ifdef CB_PATHLESS\n"
    "/* D-0281 step 4c: a whole tier-S program lowered with no paths (cobc defines\n"
    "   CB_PATHLESS when the program is eligible). Every reference carries token 0:\n"
    "   the path entries are constants or no-ops, so the C compiler deletes the calls\n"
    "   and what is computed only for them. Objects, frames, scopes and destruction\n"
    "   are unchanged, and so are bounds, overflow, positions and the value tests. A\n"
    "   reference in flight or an element's reference sent as data still takes its\n"
    "   place in the queue of what is in flight, as token 0. */\n"
    "static inline void cb_write_pathless(uint64_t base, const cb_proj *p, size_t n, uint32_t t"
    "arget_resource, uint32_t file, uint32_t line)\n"
    "{\n"
    "    /* A place reached through a reference holds its value: a resource\n"
    "       target that owns something now is overwritten live. */\n"
    "    if (base != 0)\n"
    "    {\n"
    "        cb_write(base, p, n, target_resource, file, line);\n"
    "    }\n"
    "    else if (target_resource)\n"
    "    {\n"
    "        cb_fault(\"diag.overwrite-of-live-resource\", file, line);\n"
    "    }\n"
    "}\n"
    "#define cb_write cb_write_pathless\n"
    "#define cb_borrow(b, ...)                ((void)(b), (uint64_t)0)\n"
    "#define cb_borrow_range(b, ...)          ((void)(b), (uint64_t)0)\n"
    "#define cb_borrow_unstamped(b, ...)      ((void)(b), (uint64_t)0)\n"
    "#define cb_borrow_check(b, ...)          ((void)(b))\n"
    "#define cb_borrow_unminted(b, ...)       ((void)(b))\n"
    "#define cb_borrow_range_unminted(b, ...) ((void)(b))\n"
    "#define cb_read(b, ...)                  ((void)(b))\n"
    "#define cb_valid(t, ...)                 ((void)(t))\n"
    "#define cb_store_ref(s, t)               ((void)(s), (void)(t))\n"
    "#define cb_hold_ref(s, ...)              ((void)(s))\n"
    "#define cb_rec_ref(t, ...)               ((void)(t), (uint64_t)0)\n"
    "#define cb_load_ref(s)                   ((void)(s), (uint64_t)0)\n"
    "#define cb_frame_hold(t)                 ((void)(t))\n"
    "#define cb_frame_unhold(t)               ((void)(t))\n"
    "#define cb_elem_borrow(a, t, m)          (cb_send_ref(0), (uint64_t)0)\n"
    "#define cb_elem_borrow_here(a, t, m)     ((void)(a), (uint64_t)0)\n"
    "#define cb_elem_borrow_datum(a, t, m)    (cb_send_tok_datum(0), (uint64_t)0)\n"
    "/* D-0285: no reference is ever stored with a path (`cb_store_ref` above), so\n"
    "   a copy of a value holding references has no hold to copy, and a call's\n"
    "   token, always 0, has nothing to end. */\n"
    "#define cb_copy_datum(d, s, t)           ((void)(d), (void)(s), (void)(t))\n"
    "#define cb_call_done(t)                  ((void)(t))\n"
    "/* A frozen parameter's token is 0: its body may run (`cb_frozen_ok`'s first\n"
    "   answer), so a dual body's checked twin is never chosen. */\n"
    "#define cb_frozen_ok(t, lo, n)           ((void)(t), (void)(lo), (void)(n), (uint8_t)1)\n"
    "/* A closure call borrows no path of its box: `cb_call_done` above ends\n"
    "   nothing, so one made here would never be retired (CHG-0383). */\n"
    "#define cb_call_self(r)                  ((void)(r), (uint64_t)0)\n"
    "/* D-0289: a lock makes no path; the guard holds the mutex's address. */\n"
    "#define cb_lock(t, m, ty, f, l)          ((void)(t), (void)(ty), cb_lock_pathless((m), (f)"
    ", (l)))\n"
    "#ifdef CB_DECIDED\n"
    "/* D-0285: lowered knowing the program is decided (cobc's second lowering):\n"
    "   a value holding references is plain data, sent and received as its bytes\n"
    "   alone, so every datum's flight is empty, on both sides. A reference\n"
    "   itself still takes its place in flight, as token 0. */\n"
    "#undef cb_elem_borrow_datum\n"
    "#define cb_elem_borrow_datum(a, t, m)    ((void)(a), (uint64_t)0)\n"
    "#define cb_send_datum(s, t)              ((void)(s), (void)(t))\n"
    "#define cb_send_tok_datum(t)             ((void)(t))\n"
    "#define cb_send_datum_none()             ((void)0)\n"
    "#define cb_recv_datum(d, t)              ((void)(d), (void)(t))\n"
    "#define cb_recv_datum_tok()              ((uint64_t)0)\n"
    "#define cb_peek_datum_tok(k, n)          ((void)(k), (void)(n), (uint64_t)0)\n"
    "#endif\n"
    "#endif\n"
    "\n"
    "#endif\n";
