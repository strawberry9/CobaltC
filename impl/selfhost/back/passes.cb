// The text passes over a function's lowered C that the bootstrap form keeps
// (impl/cobc/src/lower/passes.rs, impl/cobc/src/lower.rs): scope markers
// settled into pushes and pops, `#line` directives, and the resets that
// return to the C's own numbering.

import std;

// A statement's location whose `cb_at` was dropped (`drop_dead_locations`);
// the bootstrap form drops none, but `line_directives` reads the marker.
const str LINE_MARK = "/*@line ";
// D-0309: a loop `version_loops` copies (`/*@ver BOUND LEN…*/`, before its
// `for`), and a bounds check its copy leaves out (`/*@vck LEN*/ …`).
export const str VER_MARK = "/*@ver ";
export const str VER_TAG = "/*@vck ";
// `Vec::grow` runs once per doubling of a vector's capacity. Kept out of line
// and marked cold, a push's fast path stays small enough to be inlined where it
// is called (cobc's `COLD_PROTO`, `proto_attrs`).
export const str COLD_PROTO = "__attribute__((noinline, cold)) ";
// Where a function's code ends: the directive back to the C's own lines,
// settled by `settle_lines`.
export const str LINE_RESET = "#line CB_RESET";

// What a line of C does to the open scopes: something ended with the
// innermost statement scope, something bound in the innermost frame, or
// anything at all (a call).
enum Eff
{
    EScope,
    EFrame,
    EAll,
}

// The runtime's names that record nothing in a scope or a frame
// (`resolve_scopes`'s `FREE`).
const str FREE_NAMES =
    "cb_fault cb_fault_msg cb_index_check cb_str_eq cb_write_out cb_write_err cb_hash_bytes cb_bytes_eq cb_read_in "
    "cb_arg_bytes cb_set_args cb_text_int cb_text_f64 cb_text_f32 cb_text_bool cb_parse_int cb_parse_float "
    "cb_parse_bool cb_frame_here cb_file_read cb_file_write cb_file_op cb_file_at cb_fs_op cb_fs_query cb_clock_read "
    "cb_event_op cb_bytes_less cb_format cb_at cb_unit cb_str cb_i128 cb_u128 cb_ref cb_proj cb_fmt_arg cb_fnbox "
    "cb_bytes_lt cb_bytes_cmp cb_find_bytes cb_char_boundary cb_popcount64 cb_popcount128 cb_clz cb_clz128 cb_ctz "
    "cb_ctz128 cb_rotl cb_rotl128 cb_rotr cb_rotr128 cb_rotl8 cb_rotl16 cb_rotl32 cb_rotl64 cb_rotr8 cb_rotr16 "
    "cb_rotr32 cb_rotr64 cb_fnv_more cb_live_at cb_read cb_write cb_write_quiet cb_borrow_unminted "
    "cb_borrow_range_unminted cb_borrow_unstamped cb_call_done cb_load_ref cb_store_ref cb_hold_ref cb_copy_datum "
    "cb_move_to "
    "cb_send cb_send_ref cb_send_datum cb_borrow_check cb_elem_access cb_elem_access_if cb_live_in cb_owns cb_note "
    "cb_nt cb_nt_on cb_notes_push cb_notes_pop cb_threaded cb_allocate cb_drop_local cb_drop_plain_buf "
    "cb_stack_check cb_atomic_point cb_atomic_wait cb_spin_hint "
    "cb_fmt_space cb_fmt_u64 cb_fmt_i64 cb_fmt_hex cb_fmt_pad";

// The runtime's names that record in the innermost statement scope
// (`resolve_scopes`'s `SCOPE`).
const str SCOPE_NAMES =
    "cb_new cb_new_uninit cb_recv cb_recv_ref cb_rec_ref cb_recv_datum cb_recv_datum_tok cb_forget_obj cb_take "
    "cb_borrow cb_borrow_range cb_absorb cb_absorb_refs cb_elem_borrow cb_raw_move_in";

// `resolve_scopes_in`'s `DECIDED_FREE`: the entries `cbrt.h` makes constants
// in a decided program (`CB_PATHLESS`, `CB_DECIDED`), which record nothing
// in any scope there.
const str DECIDED_FREE_NAMES =
    "cb_borrow cb_borrow_range cb_elem_borrow cb_elem_borrow_here cb_elem_borrow_datum cb_valid cb_frame_hold "
    "cb_frame_unhold cb_send_tok_datum cb_send_datum_none cb_recv_datum cb_recv_datum_tok cb_peek_datum_tok "
    "cb_frozen_ok";

struct NameSets
{
    HashSet<String> free;
    HashSet<String> scope;
    HashSet<String> decided_free;
    bool decided;
}

export fn name_set(str names) : HashSet<String>
{
    HashSet<String> s = HashSet::new();
    foreach (n in StringView::split(names, " "))
    {
        HashSet::insert(&mut s, String::from_view(n));
    }
    s
}

fn is_id(u8 c) : bool
{
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9') || c == b'_'
}

fn is_hex(u8 c) : bool
{
    (c >= b'0' && c <= b'9') || (c >= b'a' && c <= b'f') || (c >= b'A' && c <= b'F')
}

// A string literal's array is data: `cb_s_` and its content hash, `x`s
// after it on a collision, or the older `cb_s0`, `cb_s1`, ….
fn literal_name(slice<u8, shared> id) : bool
{
    usize n = slice_len(id);
    if (n > 4 && id[0] == b'c' && id[1] == b'b' && id[2] == b'_' && id[3] == b's')
    {
        bool digits = true;
        for (usize k = 4; k < n; k += 1)
        {
            if (id[k] < b'0' || id[k] > b'9')
            {
                digits = false;
            }
        }
        if (digits)
        {
            return true;
        }
    }
    if (n >= 13 && id[0] == b'c' && id[1] == b'b' && id[2] == b'_' && id[3] == b's' && id[4] == b'_')
    {
        for (usize k = 5; k < 13; k += 1)
        {
            if (!is_hex(id[k]))
            {
                return false;
            }
        }
        for (usize k = 13; k < n; k += 1)
        {
            if (id[k] != b'x')
            {
                return false;
            }
        }
        return true;
    }
    false
}

fn effects(StringView line, ref<NameSets, shared> sets, ref<Vec<Eff>, exclusive> out)
{
    slice<u8, shared> b = StringView::as_bytes(line);
    usize n = slice_len(b);
    usize i = 0;
    while (i < n)
    {
        if (!is_id(b[i]) || (i > 0 && is_id(b[i - 1])))
        {
            i += 1;
            continue;
        }
        usize e = i;
        while (e < n && is_id(b[e]))
        {
            e += 1;
        }
        // By bytes: a view and a name are made only for a `cb_` name.
        usize len = e - i;
        bool cb = len >= 3 && b[i] == b'c' && b[i + 1] == b'b' && b[i + 2] == b'_';
        if (cb && !literal_name(&b[i .. e]))
        {
            StringView id = &line[i..e];
            // A fn value's call thunk (`Gen::thunk`) records nothing in
            // the caller's scopes (`cb_call_self`), as a direct call.
            String key = String::from_view(id);
            if (StringView::starts_with(id, "cb_call_") || (sets.decided && HashSet::contains(
                &sets.decided_free,
                &key,
            )))
            {
            }
            else if (HashSet::contains(&sets.scope, &key))
            {
                Vec::push(out, Eff::EScope);
            }
            else if (key == "cb_bind")
            {
                Vec::push(out, Eff::EFrame);
            }
            else if (!HashSet::contains(&sets.free, &key))
            {
                Vec::push(out, Eff::EAll);
            }
        }
        else if (!sets.decided && len >= 4 && b[e - 4] == b'_' && b[e - 3] == b'p' && b[e - 2] == b'r'
            && b[e - 1] == b'e' && e < n && b[e] == b'(')
        {
            // (D-0285: in a decided program an element's reference has no path.)
            Vec::push(out, Eff::EScope);
        }
        i = e;
    }
}

struct Marker
{
    u8 kind;
    u32 id;
}

// A scope marker's kind and id: `\u{1}` and a letter, the id, and the
// location after a `\u{2}` when it carries one.
fn marker(StringView line) : Option<Marker>
{
    // By byte positions, past the white space `trim_start` would drop: most
    // lines are not markers, and a view is a runtime object.
    slice<u8, shared> b = StringView::as_bytes(line);
    usize n = slice_len(b);
    usize s = 0;
    while (s < n && ascii_is_space(b[s]))
    {
        s += 1;
    }
    if (n - s < 2 || b[s] != 1)
    {
        return None;
    }
    u32 id = 0;
    usize k = s + 2;
    while (k < n && b[k] != 2)
    {
        id = id * 10 + widen<u32>(b[k] - b'0');
        k += 1;
    }
    Some(Marker { .kind = b[s + 1], .id = id })
}

// A frame marker's location, when it carries one.
fn marker_loc(StringView line) : Option<StringView>
{
    StringView t = StringView::trim_start(line);
    slice<u8, shared> b = StringView::as_bytes(t);
    for (usize k = 0; k < slice_len(b); k += 1)
    {
        if (b[k] == 2)
        {
            return Some(&t[k + 1..slice_len(b)]);
        }
    }
    None
}

fn indent_of(StringView line) : StringView
{
    usize n = StringView::len(line) - StringView::len(StringView::trim_start(line));
    &line[0..n]
}

struct Open
{
    bool frame;
    u32 id;
}

// Scope markers as pushes and pops, each only where its scope or frame
// holds something (a binding, a temporary, a path), else nothing.
export fn resolve_scopes(ref<String, shared> out) : String
{
    resolve_scopes_in(out, false)
}

// `resolve_scopes`, `decided` for a decided program's lowering (D-0285): the
// entries `cbrt.h` makes constants there (`CB_PATHLESS`, `CB_DECIDED`) record
// nothing in any scope, and an element's reference (`_pre`) has no path.
export fn resolve_scopes_in(ref<String, shared> out, bool decided) : String
{
    NameSets sets = NameSets {
        .free = name_set(FREE_NAMES),
        .scope = name_set(SCOPE_NAMES),
        .decided_free = name_set(DECIDED_FREE_NAMES),
        .decided = decided,
    };
    Vec<StringView> lines = StringView::lines(out);
    Vec<Open> open = Vec::new();
    HashSet<u32> used = HashSet::new();
    Vec<Eff> effs = Vec::new();
    foreach (line in &lines)
    {
        match (marker(*line))
        {
            Some(m) :
            {
                if (m.kind == b'F' || m.kind == b'G' || m.kind == b'S')
                {
                    Vec::push(&mut open, Open { .frame = m.kind != b'S', .id = m.id });
                }
                else if (m.kind == b'R')
                {
                    // D-0292: a recording body's frame is always emitted.
                    Vec::push(&mut open, Open { .frame = true, .id = m.id });
                    HashSet::insert(&mut used, m.id);
                }
                else if (m.kind == b'f' || m.kind == b's' || m.kind == b'e')
                {
                    match (Vec::pop(&mut open))
                    {
                        Some(top) : assert(top.id == m.id, "cobc: scope markers out of order"),
                        None      : assert(false, "cobc: scope markers out of order"),
                    }
                }
            },
            None    :
            {
                Vec::clear(&mut effs);
                effects(*line, &sets, &mut effs);
                foreach (e in &effs)
                {
                    match (*e)
                    {
                        Eff::EScope : mark_innermost(&open, false, &mut used),
                        Eff::EFrame : mark_innermost(&open, true, &mut used),
                        Eff::EAll   :
                        {
                            foreach (o in &open)
                            {
                                HashSet::insert(&mut used, o.id);
                            }
                        },
                    }
                }
            },
        }
    }
    assert(Vec::len(&open) == 0, "cobc: scope markers left open");
    String res = String::new();
    String::reserve(&mut res, StringView::len(out));
    foreach (line in &lines)
    {
        match (marker(*line))
        {
            Some(m) :
            {
                String call = String::new();
                match (marker_loc(*line))
                {
                    Some(l) :
                    {
                        if (m.kind == b'F')
                        {
                            call = sprintf("cb_frame_push_at(%v);", l);
                        }
                        else if (m.kind == b'S')
                        {
                            call = sprintf("cb_stmt_push_at(%v);", l);
                        }
                    },
                    None    : {},
                }
                if (StringView::len(&call) == 0)
                {
                    if (m.kind == b'F')
                    {
                        call = "cb_frame_push();";
                    }
                    else if (m.kind == b'G')
                    {
                        call = "cb_frame_push_fn();";
                    }
                    else if (m.kind == b'R')
                    {
                        call = "cb_frame_push_rec();";
                    }
                    else if (m.kind == b'S')
                    {
                        call = "cb_stmt_push();";
                    }
                    else if (m.kind == b'f' || m.kind == b'g')
                    {
                        call = "cb_frame_pop();";
                    }
                    else if (m.kind == b's' || m.kind == b't')
                    {
                        call = "cb_stmt_pop();";
                    }
                    else
                    {
                        continue;
                    }
                }
                if (HashSet::contains(&used, &m.id))
                {
                    String::append(&mut res, indent_of(*line));
                    String::append(&mut res, &call);
                    String::push_ascii(&mut res, b'\n');
                }
                // D-0293: a decided body's borrows from vouched tokens are
                // light inline (`cbrt.h`'s `cb_lf`), frame or no frame.
                if (m.kind == b'G')
                {
                    String::append(&mut res, indent_of(*line));
                    String::append(&mut res, "enum { cb_lf = 1 };\n");
                }
            },
            None    :
            {
                String::append(&mut res, *line);
                String::push_ascii(&mut res, b'\n');
            },
        }
    }
    res
}

// The innermost open scope (`frame` false) or frame (`frame` true) is used.
fn mark_innermost(ref<Vec<Open>, shared> open, bool frame, ref<HashSet<u32>, exclusive> used)
{
    usize k = Vec::len(open);
    while (k > 0)
    {
        k -= 1;
        if (open[k].frame == frame)
        {
            HashSet::insert(used, open[k].id);
            return;
        }
    }
}

// `cb_at(3u, 12u);`: file 3, line 12.
struct At
{
    usize file;
    usize line;
}

fn parse_u(StringView s) : Option<usize>
{
    slice<u8, shared> b = StringView::as_bytes(s);
    if (slice_len(b) == 0)
    {
        return None;
    }
    usize v = 0;
    foreach (c in b)
    {
        if (*c < b'0' || *c > b'9')
        {
            return None;
        }
        v = v * 10 + widen<usize>(*c - b'0');
    }
    Some(v)
}

// `3u` as 3.
fn parse_uu(StringView s) : Option<usize>
{
    match (StringView::strip_suffix(s, "u"))
    {
        Some(d) : parse_u(d),
        None    : None,
    }
}

export fn at_of(StringView t) : Option<At>
{
    // Most lines are not `cb_at(…);`: tested first by a call that makes no view.
    if (!StringView::starts_with(t, "cb_at("))
    {
        return None;
    }
    StringView rest = match (StringView::strip_prefix(t, "cb_at("))
    {
        Some(r) : r,
        None    : return None,
    };
    rest = match (StringView::strip_suffix(rest, ");"))
    {
        Some(r) : r,
        None    : return None,
    };
    usize comma = match (StringView::find(rest, ", "))
    {
        Some(k) : k,
        None    : return None,
    };
    usize f = match (parse_uu(&rest[0..comma]))
    {
        Some(v) : v,
        None    : return None,
    };
    usize l = match (parse_uu(&rest[comma + 2..$]))
    {
        Some(v) : v,
        None    : return None,
    };
    Some(At { .file = f, .line = l })
}

export fn c_escape(StringView s) : String
{
    String out = String::new();
    foreach (c in StringView::as_bytes(s))
    {
        if (*c == b'\\' || *c == b'"')
        {
            String::push_ascii(&mut out, b'\\');
        }
        String::push_ascii(&mut out, *c);
    }
    out
}

// The parts of `text` each ending at a `\n` (the last one perhaps not),
// as Rust's `split_inclusive('\n')`.
fn split_inclusive(StringView text) : Vec<StringView>
{
    Vec<StringView> parts = Vec::new();
    slice<u8, shared> b = StringView::as_bytes(text);
    usize start = 0;
    for (usize k = 0; k < slice_len(b); k += 1)
    {
        if (b[k] == b'\n')
        {
            Vec::push(&mut parts, &text[start..k + 1]);
            start = k + 1;
        }
    }
    if (start < slice_len(b))
    {
        Vec::push(&mut parts, &text[start..slice_len(b)]);
    }
    parts
}

// WI-11: a `#line` before each line of the C of the program's own
// statements, naming the `.cb` line its `cb_at` gives; `LINE_RESET` where
// a function's code ends.
export fn line_directives(ref<String, shared> text, ref<Vec<String>, shared> files) : String
{
    String out = String::new();
    bool has_cur = false;
    At cur = At { .file = 0, .line = 0 };
    bool dirty = false;
    foreach (l in split_inclusive(text))
    {
        StringView body = l;
        if (StringView::ends_with(body, "\n"))
        {
            body = &body[0..StringView::len(body) - 1];
        }
        StringView t = StringView::trim_start(body);
        bool starts_definition = StringView::len(body) > 0 && StringView::len(body) == StringView::len(t)
            && !starts_with_any(t, "{}#/");
        if (starts_definition)
        {
            if (dirty)
            {
                String::append(&mut out, LINE_RESET);
                String::push_ascii(&mut out, b'\n');
                dirty = false;
            }
            has_cur = false;
        }
        match (line_mark(t))
        {
            Some(at) :
            {
                has_cur = at.file < Vec::len(files);
                cur = at;
                continue;
            },
            None     : {},
        }
        match (at_of(t))
        {
            Some(at) :
            {
                if (at.file < Vec::len(files))
                {
                    has_cur = true;
                    cur = at;
                }
            },
            None     : {},
        }
        if (has_cur && StringView::len(t) > 0 && !StringView::starts_with(t, "#"))
        {
            String::append(
                &mut out,
                &sprintf("#line %v \"%s\"\n", cur.line, &c_escape(&files[cur.file])),
            );
            dirty = true;
        }
        String::append(&mut out, l);
    }
    if (dirty)
    {
        if (!StringView::ends_with(&out, "\n"))
        {
            String::push_ascii(&mut out, b'\n');
        }
        String::append(&mut out, LINE_RESET);
        String::push_ascii(&mut out, b'\n');
    }
    out
}

fn starts_with_any(StringView t, str cs) : bool
{
    if (StringView::len(t) == 0)
    {
        return false;
    }
    u8 c = StringView::as_bytes(t)[0];
    foreach (x in StringView::as_bytes(cs))
    {
        if (*x == c)
        {
            return true;
        }
    }
    false
}

// `/*@line F L*/`: a dropped location (`drop_dead_locations`).
fn line_mark(StringView t) : Option<At>
{
    // Tested first by a call that makes no view: most lines are not marks.
    if (!StringView::starts_with(t, LINE_MARK))
    {
        return None;
    }
    StringView m = match (StringView::strip_prefix(t, LINE_MARK))
    {
        Some(r) : r,
        None    : return None,
    };
    m = match (StringView::strip_suffix(m, "*/"))
    {
        Some(r) : r,
        None    : return None,
    };
    usize sp = match (StringView::find(m, " "))
    {
        Some(k) : k,
        None    : return None,
    };
    usize f = match (parse_u(&m[0..sp]))
    {
        Some(v) : v,
        None    : return None,
    };
    match (parse_u(&m[sp + 1..$]))
    {
        Some(n) : Some(At { .file = f, .line = n }),
        None    : None,
    }
}

// Each `LINE_RESET` as the directive that numbers the next line as what it
// is in the translation unit `c_name`.
export fn settle_lines(ref<String, shared> text, StringView c_name) : String
{
    if (!StringView::contains(text, LINE_RESET))
    {
        return String::clone(text);
    }
    String out = String::new();
    usize i = 0;
    String name = c_escape(c_name);
    foreach (l in split_inclusive(text))
    {
        StringView body = l;
        if (StringView::ends_with(body, "\n"))
        {
            body = &body[0..StringView::len(body) - 1];
        }
        if (body == LINE_RESET)
        {
            String::append(&mut out, &sprintf("#line %v \"%s\"\n", i + 2, &name));
        }
        else
        {
            String::append(&mut out, l);
        }
        i += 1;
    }
    out
}

// ---- the optimising text passes (D-0274 stage 1) ----

// Where a call names its callee's `__arrive` twin, if it has one
// (`resolve_arrive`; `gen.cb`'s `ARRIVE_MARK`).
const str ARRIVE_MARK = "__ARRIVE_MARK__";

// D-0200: the shared checks on a quiet local's root (`Gen::quiet_locals`):
// `cb_read(R, …)` and `cb_borrow_check(R, …, CB_SHARED, …)`, each a
// statement of its own, removed. No held exclusive path to the local
// exists in the function's own code, it is initialized where declared and
// never moved, so neither can fault.
export fn drop_quiet_checks(ref<String, shared> out, ref<HashSet<String>, shared> roots) : String
{
    if (HashSet::len(roots) == 0)
    {
        return String::clone(out);
    }
    String keep = String::new();
    String::reserve(&mut keep, StringView::len(out));
    Vec<StringView> lines = StringView::lines(out);
    foreach (l in &lines)
    {
        StringView t = StringView::trim(*l);
        bool drop = (StringView::starts_with(t, "cb_read(")
            || (StringView::starts_with(t, "cb_borrow_check(")
                && StringView::contains(t, ", CB_SHARED, ")))
            && StringView::ends_with(t, ");");
        if (drop)
        {
            usize open = match (StringView::find(t, "("))
            {
                Some(k) : k + 1,
                None    : 0,
            };
            StringView rest = &t[open..$];
            StringView first = match (StringView::find(rest, ","))
            {
                Some(k) : &rest[0..k],
                None    : rest,
            };
            drop = HashSet::contains(roots, &String::from_view(StringView::trim(first)));
        }
        if (!drop)
        {
            String::append(&mut keep, *l);
            String::push_ascii(&mut keep, b'\n');
        }
    }
    if (!StringView::ends_with(out, "\n") && StringView::len(&keep) > 0)
    {
        String::truncate(&mut keep, StringView::len(&keep) - 1);
    }
    keep
}

fn ident_char(u8 c) : bool
{
    is_id(c)
}

// What `scan` finds: each identifier assigned (`X = `, not `==`), and how
// often; each one whose address is taken.
struct Scan
{
    HashMap<String, usize> assigned;
    HashSet<String> addressed;
}

fn scan(ref<Vec<String>, shared> lines) : Scan
{
    HashMap<String, usize> assigned = HashMap::new();
    HashSet<String> addressed = HashSet::new();
    foreach (ls in lines)
    {
        StringView l = ls;
        slice<u8, shared> b = StringView::as_bytes(l);
        usize n = slice_len(b);
        usize i = 0;
        while (i < n)
        {
            if (ident_char(b[i]) && (i == 0 || !ident_char(b[i - 1])))
            {
                usize st = i;
                while (i < n && ident_char(b[i]))
                {
                    i += 1;
                }
                // By bytes: the name is made only for a name that counts.
                bool addr = st > 0 && b[st - 1] == b'&' && (st < 2 || b[st - 2] != b'&');
                bool assign = (i + 3 <= n && b[i] == b' ' && b[i + 1] == b'=' && b[i + 2] == b' ')
                    || (i < n && b[i] == b'=' && !(i + 1 < n && b[i + 1] == b'='));
                if (!addr && !assign)
                {
                    continue;
                }
                String id = String::from_view(&l[st..i]);
                if (addr)
                {
                    HashSet::insert(&mut addressed, String::clone(&id));
                }
                if (assign)
                {
                    usize count = match (HashMap::get(&assigned, &id))
                    {
                        Some(c) : *c,
                        None    : 0,
                    };
                    HashMap::insert(&mut assigned, id, count + 1);
                }
            }
            else
            {
                i += 1;
            }
        }
    }
    Scan { .assigned = assigned, .addressed = addressed }
}

// Whether the bracket depth of `inner` never goes below 0 and ends at 0.
fn balanced(StringView inner) : bool
{
    i32 depth = 0;
    foreach (c in StringView::as_bytes(inner))
    {
        if (*c == b'(' || *c == b'{' || *c == b'[')
        {
            depth += 1;
        }
        else if (*c == b')' || *c == b'}' || *c == b']')
        {
            depth -= 1;
            if (depth < 0)
            {
                return false;
            }
        }
    }
    depth == 0
}

// `name(args…)` exactly (with `;` after when `stmt`): the arguments.
// By byte positions: the one view made is the arguments', when they are
// there (most lines are not such a call, and a view is a runtime object).
fn call_args(StringView t0, StringView name, bool stmt) : Option<StringView>
{
    if (!StringView::starts_with(t0, name))
    {
        return None;
    }
    slice<u8, shared> b = StringView::as_bytes(t0);
    usize end = slice_len(b);
    if (stmt)
    {
        if (end == 0 || b[end - 1] != b';')
        {
            return None;
        }
        end -= 1;
    }
    usize open = StringView::len(name);
    if (end < open + 2 || b[open] != b'(' || b[end - 1] != b')')
    {
        return None;
    }
    StringView inner = &t0[open + 1..end - 1];
    if (balanced(inner)) { Some(inner) } else { None }
}

fn first_arg(StringView args) : StringView
{
    slice<u8, shared> b = StringView::as_bytes(args);
    i32 depth = 0;
    for (usize i = 0; i < slice_len(b); i += 1)
    {
        u8 c = b[i];
        if (c == b'(' || c == b'{' || c == b'[')
        {
            depth += 1;
        }
        else if (c == b')' || c == b'}' || c == b']')
        {
            depth -= 1;
        }
        else if (c == b',' && depth == 0)
        {
            return StringView::trim(&args[0..i]);
        }
    }
    StringView::trim(args)
}

fn last_arg(StringView args) : StringView
{
    slice<u8, shared> b = StringView::as_bytes(args);
    i32 depth = 0;
    usize at = 0;
    for (usize i = 0; i < slice_len(b); i += 1)
    {
        u8 c = b[i];
        if (c == b'(' || c == b'{' || c == b'[')
        {
            depth += 1;
        }
        else if (c == b')' || c == b'}' || c == b']')
        {
            depth -= 1;
        }
        else if (c == b',' && depth == 0)
        {
            at = i + 1;
        }
    }
    StringView::trim(&args[at..slice_len(b)])
}

// A constant, a projection literal, or reads of memory with no call and
// no assignment (`((*(T *)r.p)).bytes.len`): nothing evaluated has an
// effect.
fn inert(StringView a) : bool
{
    if (StringView::starts_with(a, "(cb_proj[])") || a == "NULL")
    {
        return true;
    }
    slice<u8, shared> b = StringView::as_bytes(a);
    for (usize i = 1; i < slice_len(b); i += 1)
    {
        if (b[i] == b'(' && ident_char(b[i - 1]))
        {
            return false;
        }
    }
    !StringView::contains(a, "=") && !StringView::contains(a, "++")
        && !StringView::contains(a, "--")
}

// The arguments split at each top-level comma, untrimmed; an empty text
// gives one empty part.
fn arg_parts(StringView args) : Vec<StringView>
{
    Vec<StringView> parts = Vec::new();
    slice<u8, shared> b = StringView::as_bytes(args);
    i32 depth = 0;
    usize start = 0;
    for (usize i = 0; i < slice_len(b); i += 1)
    {
        u8 c = b[i];
        if (c == b'(' || c == b'{' || c == b'[')
        {
            depth += 1;
        }
        else if (c == b')' || c == b'}' || c == b']')
        {
            depth -= 1;
        }
        else if (c == b',' && depth == 0)
        {
            Vec::push(&mut parts, &args[start..i]);
            start = i + 1;
        }
    }
    Vec::push(&mut parts, &args[start..slice_len(b)]);
    parts
}

// Every part after the first inert.
fn rest_inert(ref<Vec<StringView>, shared> parts) : bool
{
    for (usize k = 1; k < Vec::len(parts); k += 1)
    {
        if (!inert(StringView::trim(parts[k])))
        {
            return false;
        }
    }
    true
}

// The checks `fold_zero_tokens` drops through a token known 0.
const str ZERO_DROP =
    "cb_read cb_write cb_borrow_unminted cb_borrow_check cb_frame_hold cb_frame_unhold cb_borrow_range_unminted";

// Assigned once, its address never taken (`fold_zero_tokens`' `once`).
fn once(ref<Scan, shared> sc, ref<String, shared> x) : bool
{
    bool one = match (HashMap::get(&sc.assigned, x))
    {
        Some(c) : *c == 1,
        None    : false,
    };
    one && !HashSet::contains(&sc.addressed, x)
}

// `fold_zero_tokens`' `is_zero`: `0`, a token known 0, or the `.tok` of a
// reference built with one.
fn is_zero(StringView a0, ref<HashSet<String>, shared> zero, ref<HashSet<String>, shared> zref) : bool
{
    StringView a = StringView::trim(a0);
    if (a == "0" || HashSet::contains(zero, &String::from_view(a)))
    {
        return true;
    }
    match (StringView::strip_suffix(a, ".tok"))
    {
        Some(r) : HashSet::contains(zref, &String::from_view(trim_byte(trim_byte(r, b'(', true), b')', false))),
        None    : false,
    }
}

// Whether every byte of `x` is an identifier's.
fn all_ident(StringView x) : bool
{
    foreach (c in StringView::as_bytes(x))
    {
        if (!ident_char(*c))
        {
            return false;
        }
    }
    true
}

// `X = E` split at the first ` = `.
struct Decl
{
    StringView x;
    StringView e;
}

// `<prefix>X = E;`: the name and the initializer.
fn decl_of(StringView t, str prefix) : Option<Decl>
{
    // By byte positions: one view made, for a line that is such a declaration.
    StringView p = prefix;
    if (!StringView::starts_with(t, p))
    {
        return None;
    }
    slice<u8, shared> b = StringView::as_bytes(t);
    usize n = slice_len(b);
    usize pl = StringView::len(p);
    if (n < pl + 1 || b[n - 1] != b';')
    {
        return None;
    }
    StringView r = &t[pl..n - 1];
    match (StringView::find(r, " = "))
    {
        Some(k) : Some(Decl { .x = &r[0..k], .e = &r[k + 3..$] }),
        None    : None,
    }
}

// D-0200: the checks through a token known to be 0 (the no-path token,
// `spec/14` §6), removed. A token variable is known 0 when its one
// assignment, its declaration, is `0`, `cb_borrow` of a token known 0 (which
// returns 0), or the `.tok` of a reference built with one, and its address
// is never taken. Then `cb_read`, `cb_write`, `cb_borrow_unminted`,
// `cb_borrow_check`, `cb_frame_hold` and `cb_frame_unhold` through it, each
// a statement of its own whose other arguments are constants and
// projection literals, return at once (`cbrt`): the statements go; and
// `cb_borrow` of it is 0. Repeated until nothing changes, as one fold
// makes the next token known.
export fn fold_zero_tokens(ref<String, shared> out) : String
{
    Vec<StringView> drop_names = StringView::split(ZERO_DROP, " ");
    bool any = false;
    foreach (d in &drop_names)
    {
        if (StringView::contains(out, *d))
        {
            any = true;
        }
    }
    if (!any)
    {
        return String::clone(out);
    }
    Vec<String> lines = Vec::new();
    {
        Vec<StringView> src = StringView::lines(out);
        foreach (l in &src)
        {
            Vec::push(&mut lines, String::from_view(*l));
        }
    }
    HashSet<String> zero = HashSet::new();
    HashSet<String> zref = HashSet::new();
    while (true)
    {
        Scan sc = scan(&lines);
        bool changed = false;
        Vec<String> keep = Vec::new();
        Vec::reserve(&mut keep, Vec::len(&lines));
        for (usize li = 0; li < Vec::len(&lines); li += 1)
        {
            // Whether the line stays as it is: moved into `keep` once the
            // block, and every view of it, has ended (a clone of each line
            // each round cost as much as the round's own work).
            bool as_is = false;
            {
                ref<String, shared> ls = &lines[li];
                StringView l = ls;
                StringView t = StringView::trim(l);
                // A check through a token known 0: the statement goes.
                bool dropped = false;
                foreach (d in &drop_names)
                {
                    if (!dropped && StringView::starts_with(t, *d))
                    {
                        match (call_args(t, *d, true))
                        {
                            Some(args) :
                            {
                                Vec<StringView> parts = arg_parts(args);
                                dropped = is_zero(parts[0], &zero, &zref) && rest_inert(&parts);
                            },
                            None       : {},
                        }
                    }
                }
                if (dropped)
                {
                    // After anything but a statement's or block's end (a
                    // braceless `if`'s condition, a label) an empty statement
                    // stands in its place.
                    StringView prev = "{";
                    usize k = Vec::len(&keep);
                    while (k > 0)
                    {
                        k -= 1;
                        StringView kt = StringView::trim(&keep[k]);
                        if (StringView::len(kt) > 0)
                        {
                            prev = kt;
                            break;
                        }
                    }
                    if (!(StringView::ends_with(prev, ";") || StringView::ends_with(prev, "{")
                        || StringView::ends_with(prev, "}")))
                    {
                        Vec::push(&mut keep, sprintf("%v;", indent_of(l)));
                    }
                    changed = true;
                    continue;
                }
                match (if (StringView::starts_with(t, "uint64_t ")) { decl_of(t, "uint64_t ") } else { None })
                {
                    Some(dc) :
                    {
                        StringView xv = StringView::trim(dc.x);
                        String x = String::from_view(xv);
                        if (all_ident(xv) && once(&sc, &x))
                        {
                            StringView e = StringView::trim(dc.e);
                            // `cb_borrow(0, …)` and `cb_borrow_range(0, …)` are 0.
                            Option<StringView> got = call_args(e, "cb_borrow", false);
                            match (got)
                            {
                                Some(_) : {},
                                None    :
                                {
                                    match (call_args(e, "cb_borrow_range", false))
                                    {
                                        Some(a) :
                                        {
                                            Vec<StringView> parts = arg_parts(a);
                                            if (rest_inert(&parts))
                                            {
                                                got = Some(a);
                                            }
                                        },
                                        None    : {},
                                    }
                                },
                            }
                            match (got)
                            {
                                Some(args) :
                                {
                                    if (is_zero(first_arg(args), &zero, &zref))
                                    {
                                        Vec::push(&mut keep, sprintf("%vuint64_t %s = 0;", indent_of(l), &x));
                                        HashSet::insert(&mut zero, x);
                                        changed = true;
                                        continue;
                                    }
                                },
                                None       : {},
                            }
                            if (!HashSet::contains(&zero, &x) && is_zero(e, &zero, &zref))
                            {
                                HashSet::insert(&mut zero, x);
                                changed = true;
                            }
                        }
                    },
                    None     : {},
                }
                // `cb_ref R = ((cb_ref){ p, tok });` with the token known 0.
                match (if (StringView::starts_with(t, "cb_ref ")) { decl_of(t, "cb_ref ") } else { None })
                {
                    Some(dc) :
                    {
                        StringView xv = StringView::trim(dc.x);
                        String x = String::from_view(xv);
                        if (all_ident(xv) && once(&sc, &x) && !HashSet::contains(&zref, &x))
                        {
                            match (StringView::strip_prefix(StringView::trim(dc.e), "((cb_ref){"))
                            {
                                Some(r) :
                                {
                                    match (StringView::strip_suffix(r, "})"))
                                    {
                                        Some(inner) :
                                        {
                                            if (is_zero(last_arg(inner), &zero, &zref))
                                            {
                                                HashSet::insert(&mut zref, x);
                                                changed = true;
                                            }
                                        },
                                        None        : {},
                                    }
                                },
                                None    : {},
                            }
                        }
                    },
                    None     : {},
                }
                as_is = true;
            }
            if (as_is)
            {
                Vec::push(&mut keep, replace(&mut lines[li], String::new()));
            }
        }
        lines = keep;
        if (!changed)
        {
            break;
        }
    }
    String s = String::join(&lines[0..$], "\n");
    if (StringView::ends_with(out, "\n"))
    {
        String::push_ascii(&mut s, b'\n');
    }
    s
}

// A check `elide_implied_checks` has seen: its base, its projection's
// steps, and whether it was exclusive.
struct Seen
{
    String base;
    Vec<String> proj;
    bool excl;
}

// The arguments split at each top-level comma, each trimmed; a last one
// empty is left out.
fn split_args(StringView s) : Vec<String>
{
    Vec<String> out = Vec::new();
    slice<u8, shared> b = StringView::as_bytes(s);
    i32 depth = 0;
    usize start = 0;
    for (usize i = 0; i < slice_len(b); i += 1)
    {
        u8 c = b[i];
        if (c == b'(' || c == b'{' || c == b'[')
        {
            depth += 1;
        }
        else if (c == b')' || c == b'}' || c == b']')
        {
            depth -= 1;
        }
        else if (c == b',' && depth == 0)
        {
            Vec::push(&mut out, String::from_view(StringView::trim(&s[start..i])));
            start = i + 1;
        }
    }
    StringView cur = StringView::trim(&s[start..slice_len(b)]);
    if (StringView::len(cur) > 0)
    {
        Vec::push(&mut out, String::from_view(cur));
    }
    out
}

// `v` without the `c`s at its start (`start`) or its end (Rust's
// `trim_start_matches`/`trim_end_matches` of one character).
fn trim_byte(StringView v, u8 c, bool start) : StringView
{
    slice<u8, shared> b = StringView::as_bytes(v);
    usize lo = 0;
    usize hi = slice_len(b);
    if (start)
    {
        while (lo < hi && b[lo] == c)
        {
            lo += 1;
        }
    }
    else
    {
        while (hi > lo && b[hi - 1] == c)
        {
            hi -= 1;
        }
    }
    &v[lo..hi]
}

// The projection's steps, or None if it has a range.
fn projs(StringView a) : Option<Vec<String>>
{
    if (a == "NULL")
    {
        return Some(Vec::new());
    }
    StringView inner = match (StringView::strip_prefix(a, "(cb_proj[]){"))
    {
        Some(r) : r,
        None    : return None,
    };
    inner = match (StringView::strip_suffix(inner, "}"))
    {
        Some(r) : r,
        None    : return None,
    };
    Vec<String> v = Vec::new();
    Vec<StringView> steps = StringView::split(inner, "},");
    foreach (st0 in &steps)
    {
        StringView st = StringView::trim(trim_byte(trim_byte(StringView::trim(*st0), b'{', true), b'}', false));
        if (StringView::len(st) == 0)
        {
            continue;
        }
        if (!(StringView::starts_with(st, "CB_FIELD") || StringView::starts_with(st, "CB_PAYLOAD")))
        {
            return None;
        }
        String step = String::new();
        Vec<StringView> words = StringView::split_whitespace(st);
        foreach (w in &words)
        {
            String::append(&mut step, *w);
        }
        Vec::push(&mut v, step);
    }
    Some(v)
}

// The names called in `line`: each identifier (from a letter or `_`) right
// before a `(`, not inside a longer one.
fn calls(StringView line) : Vec<String>
{
    slice<u8, shared> b = StringView::as_bytes(line);
    usize n = slice_len(b);
    Vec<String> v = Vec::new();
    usize i = 0;
    while (i < n)
    {
        if ((b[i] >= b'a' && b[i] <= b'z') || (b[i] >= b'A' && b[i] <= b'Z') || b[i] == b'_')
        {
            usize st = i;
            while (i < n && is_id(b[i]))
            {
                i += 1;
            }
            if (i < n && b[i] == b'(' && (st == 0 || !is_id(b[st - 1])))
            {
                Vec::push(&mut v, String::from_view(&line[st..i]));
            }
        }
        else
        {
            i += 1;
        }
    }
    v
}

// Whether `q` is the first steps of `p`.
fn steps_start(ref<Vec<String>, shared> p, ref<Vec<String>, shared> q) : bool
{
    if (Vec::len(q) > Vec::len(p))
    {
        return false;
    }
    for (usize k = 0; k < Vec::len(q); k += 1)
    {
        if (!String::eq(&p[k], &q[k]))
        {
            return false;
        }
    }
    true
}

// `elide_implied_checks`' `simple`: a token's copy's value, a path of
// names, fields and parentheses.
fn simple_val(StringView v) : bool
{
    foreach (c in StringView::as_bytes(v))
    {
        if (!(is_id(*c) || *c == b'.' || *c == b'(' || *c == b')'))
        {
            return false;
        }
    }
    true
}

// The runtime's calls that change no path's state (`elide_implied_checks`'
// `PURE`): `cb_stmt_push`/`cb_stmt_push_at` open a scope.
const str IMPLIED_PURE =
    "cb_read cb_borrow_unminted cb_borrow_check cb_at cb_fault cb_index_check cb_hash_bytes cb_bytes_eq cb_bytes_lt "
    "cb_load_ref cb_stmt_push cb_stmt_push_at cb_fmt_space cb_fmt_u64 cb_fmt_i64 cb_fmt_hex cb_fmt_pad";

// Checks implied by an earlier one (a pass over a function's C). Within a
// run of lines with no other runtime call and no join (a label, a `}`,
// an `else`), the runtime's state cannot change, and a check is a pure
// function of it, so:
// - after an exclusive check through `base` with projection `P`
//   (`cb_borrow_unminted`/`cb_borrow_check` with `CB_EXCLUSIVE`), a read
//   or exclusive check through `base` under `P` cannot fail on a clash;
// - after a read or shared check under `P`, a read under `P` cannot;
// - after any check that tests initialization (`cb_read`,
//   `cb_borrow_check`) through `base`, none can fail on it (it is the
//   object's, and only a write changes it).
// Such a later `cb_read` / `cb_borrow_unminted` / `cb_borrow_check` is
// dropped. A projection with a range (a slice), and any base not written
// identically, are left alone.
export fn elide_implied_checks(ref<String, shared> out) : String
{
    // (base, projection, exclusive) checked, and bases whose object's
    // initialization was checked.
    Vec<Seen> seen = Vec::new();
    HashSet<String> inited = HashSet::new();
    HashSet<String> pure = name_set(IMPLIED_PURE);
    // `uint64_t tkN = <token>;` copies: a check through either names one path.
    HashMap<String, String> alias = HashMap::new();
    String res = String::new();
    String::reserve(&mut res, StringView::len(out));
    Vec<StringView> lines = StringView::lines(out);
    foreach (lp in &lines)
    {
        StringView line = *lp;
        StringView t = StringView::trim_start(line);
        // A join, or control arriving from elsewhere: forget everything.
        if (StringView::starts_with(t, "}") || StringView::starts_with(t, "else")
            || (StringView::ends_with(t, ":") && !StringView::contains(t, " "))
            || StringView::starts_with(t, "case ") || StringView::starts_with(t, "default"))
        {
            Vec::clear(&mut seen);
            HashSet::clear(&mut inited);
            String::append(&mut res, line);
            String::push_ascii(&mut res, b'\n');
            continue;
        }
        match (decl_of(t, "uint64_t "))
        {
            Some(dc) :
            {
                StringView val = dc.e;
                bool digit_first = StringView::len(val) == 0
                    || (StringView::as_bytes(val)[0] >= b'0' && StringView::as_bytes(val)[0] <= b'9');
                if (!StringView::contains(dc.x, " ") && simple_val(val)
                    && !StringView::contains(val, "()") && !digit_first)
                {
                    String key = String::from_view(val);
                    String canon = match (HashMap::get(&alias, &key))
                    {
                        Some(c) : String::clone(c),
                        None    : String::clone(&key),
                    };
                    HashMap::insert(&mut alias, String::from_view(dc.x), canon);
                }
            },
            None     : {},
        }
        Vec<String> cs = calls(t);
        str kind = "";
        if (StringView::starts_with(t, "cb_read("))
        {
            kind = "cb_read";
        }
        else if (StringView::starts_with(t, "cb_borrow_unminted("))
        {
            kind = "cb_borrow_unminted";
        }
        else if (StringView::starts_with(t, "cb_borrow_check("))
        {
            kind = "cb_borrow_check";
        }
        usize klen = StringView::len(kind);
        if (klen > 0 && StringView::ends_with(t, ");"))
        {
            Vec<String> args = split_args(&t[klen + 1..StringView::len(t) - 2]);
            String base0 = if (Vec::len(&args) > 0) { String::clone(&args[0]) } else { String::new() };
            String base = match (HashMap::get(&alias, &base0))
            {
                Some(c) : String::clone(c),
                None    : String::clone(&base0),
            };
            Option<Vec<String>> pr = if (Vec::len(&args) > 1) { projs(&args[1]) } else { None };
            bool excl = if (kind == "cb_read")
            {
                false
            }
            else
            {
                Vec::len(&args) > 3 && args[3] == "CB_EXCLUSIVE"
            };
            bool tests_init = kind != "cb_borrow_unminted";
            match (pr)
            {
                Some(p) :
                {
                    bool covered = false;
                    foreach (s in &seen)
                    {
                        if (String::eq(&s.base, &base) && steps_start(&p, &s.proj) && (s.excl || !excl))
                        {
                            covered = true;
                        }
                    }
                    bool init_ok = !tests_init || HashSet::contains(&inited, &base);
                    if (covered && init_ok)
                    {
                        continue;
                    }
                    Vec::push(&mut seen, Seen { .base = String::clone(&base), .proj = p, .excl = excl });
                    if (tests_init)
                    {
                        HashSet::insert(&mut inited, base);
                    }
                },
                None    : {},
            }
            String::append(&mut res, line);
            String::push_ascii(&mut res, b'\n');
            continue;
        }
        // Any other call may change the runtime's state.
        bool other = false;
        foreach (c in &cs)
        {
            if (!HashSet::contains(&pure, c) && !StringView::starts_with(c, "__builtin")
                && !(*c == "if" || *c == "while" || *c == "for"
                    || *c == "switch" || *c == "sizeof" || *c == "return"))
            {
                other = true;
            }
        }
        if (other)
        {
            Vec::clear(&mut seen);
            HashSet::clear(&mut inited);
        }
        String::append(&mut res, line);
        String::push_ascii(&mut res, b'\n');
    }
    res
}

// What `calls_nothing` lets a body call: C keywords, `cb_at` and `cb_fault`.
const str LEAF_NAMES = "cb_at cb_fault if while for switch sizeof offsetof return";

// Whether generated C calls nothing that could call back into the
// program: only C keywords, builtins, and the runtime's location
// bookkeeping (`cb_at`) and faults (`cb_fault`, which does not return).
// A destructor the runtime runs, a `fn` value or closure, and any other
// runtime call count as calls.
export fn calls_nothing(ref<String, shared> body) : bool
{
    HashSet<String> leaf = name_set(LEAF_NAMES);
    StringView text = body;
    slice<u8, shared> b = StringView::as_bytes(text);
    usize n = slice_len(b);
    usize i = 0;
    while (i < n)
    {
        if (!is_id(b[i]) || (i > 0 && is_id(b[i - 1])) || (b[i] >= b'0' && b[i] <= b'9'))
        {
            i += 1;
            continue;
        }
        usize e = i;
        while (e < n && is_id(b[e]))
        {
            e += 1;
        }
        StringView id = &text[i..e];
        usize k = e;
        while (k < n && b[k] == b' ')
        {
            k += 1;
        }
        if (k < n && b[k] == b'(' && !HashSet::contains(&leaf, &String::from_view(id))
            && !StringView::starts_with(id, "__builtin"))
        {
            return false;
        }
        i = e;
    }
    true
}

// The calls that read no location (`drop_dead_locations`' `PURE`).
export const str LOCATION_PURE =
    "cb_at cb_str_eq cb_live_in if while for sizeof offsetof __builtin_expect __builtin_add_overflow "
    "__builtin_sub_overflow __builtin_mul_overflow";

// Whether a line could read the executing statement's location: a call of
// anything but the pure helpers, or a fault or check whose own location is
// `CB_NOLOC`.
export fn reads_location(StringView line, ref<HashSet<String>, shared> pure) : bool
{
    slice<u8, shared> b = StringView::as_bytes(line);
    usize n = slice_len(b);
    usize i = 0;
    while (i < n)
    {
        if (!is_id(b[i]) || (i > 0 && is_id(b[i - 1])) || (b[i] >= b'0' && b[i] <= b'9'))
        {
            i += 1;
            continue;
        }
        usize e = i;
        while (e < n && is_id(b[e]))
        {
            e += 1;
        }
        StringView id = &line[i..e];
        usize k = e;
        while (k < n && b[k] == b' ')
        {
            k += 1;
        }
        if (k < n && b[k] == b'(' && !HashSet::contains(pure, &String::from_view(id)))
        {
            // A confined vector's push (`native_vec_push`'s `_nc` form)
            // sets its own location where it can fault.
            bool own = (StringView::starts_with(id, "f_std__Vec__push_") && StringView::ends_with(id, "_nc"))
                || id == "cb_fault" || id == "cb_index_check" || id == "cb_elem_access" || id == "cb_elem_access_if";
            if (!own)
            {
                return true;
            }
            // Its own location, unless that is `CB_NOLOC`: up to the
            // call's closing parenthesis.
            i32 depth = 0;
            usize j = k;
            while (j < n)
            {
                if (b[j] == b'(')
                {
                    depth += 1;
                }
                else if (b[j] == b')')
                {
                    depth -= 1;
                    if (depth == 0)
                    {
                        break;
                    }
                }
                j += 1;
            }
            if (StringView::contains(&line[k..j], "CB_NOLOC"))
            {
                return true;
            }
        }
        i = e;
    }
    false
}

// The `cb_at` lines `drop_dead_locations` drops, in straight-line code
// only: the next line to set the location comes before any line that
// could read it, and before any brace or jump.
fn boundary(StringView t) : bool
{
    StringView::ends_with(t, "{") || StringView::starts_with(t, "}")
        || StringView::starts_with(t, "break") || StringView::starts_with(t, "continue")
        || StringView::starts_with(t, "return")
        || StringView::starts_with(t, "__builtin_unreachable")
        || StringView::ends_with(t, ":")
}

fn dead_locations_straight(ref<Vec<StringView>, shared> lines, ref<HashSet<String>, shared> pure) : Vec<bool>
{
    Vec<bool> dead = Vec::filled(Vec::len(lines), false);
    for (usize i = 0; i < Vec::len(lines); i += 1)
    {
        if (StringView::starts_with(StringView::trim_start(lines[i]), "cb_at("))
        {
            for (usize k = i + 1; k < Vec::len(lines); k += 1)
            {
                StringView t = StringView::trim_start(lines[k]);
                if (StringView::starts_with(t, "cb_at("))
                {
                    dead[i] = true;
                    break;
                }
                if (boundary(t) || reads_location(t, pure))
                {
                    break;
                }
            }
        }
    }
    dead
}

// A body's statement as `dead_locations_flow` sees it: an opening line, a
// closing `}`, a jump (perhaps under an `if`), a label, or any other line.
const u8 FL_BLOCK = 0;
const u8 FL_IF = 1;
const u8 FL_ELSE_IF = 2;
const u8 FL_ELSE = 3;
const u8 FL_FOREVER = 4;
const u8 FL_LOOP = 5;
const u8 FL_CLOSE = 6;
const u8 FL_BREAK = 7;
const u8 FL_CONTINUE = 8;
const u8 FL_GOTO = 9;
const u8 FL_EXIT = 10;
const u8 FL_LABEL = 11;
const u8 FL_OTHER = 12;
const usize FL_NONE = 18446744073709551615;

struct FlowJump
{
    u8 kind;
    bool cond;
    StringView label;
}

fn is_label_name(StringView x) : bool
{
    slice<u8, shared> b = StringView::as_bytes(x);
    if (slice_len(b) == 0)
    {
        return false;
    }
    foreach (k in 0..slice_len(b))
    {
        if (!is_id(b[k]))
        {
            return false;
        }
    }
    true
}

// The jump a statement makes, under an `if (…)` or not.
fn flow_jump(StringView t) : Option<FlowJump>
{
    StringView tail = t;
    bool cond = false;
    if (Some(rest) = StringView::strip_prefix(t, "if ("))
    {
        slice<u8, shared> b = StringView::as_bytes(rest);
        i32 depth = 1;
        usize end = FL_NONE;
        foreach (k in 0..slice_len(b))
        {
            if (b[k] == b'(')
            {
                depth += 1;
            }
            else if (b[k] == b')')
            {
                depth -= 1;
                if (depth == 0)
                {
                    end = k;
                    break;
                }
            }
        }
        if (end == FL_NONE)
        {
            return None;
        }
        tail = match (StringView::strip_prefix(&rest[end + 1..$], " "))
        {
            Some(x) : x,
            None    : return None,
        };
        cond = true;
    }
    if (tail == "break;")
    {
        return Some(FlowJump { .kind = FL_BREAK, .cond = cond, .label = tail });
    }
    if (tail == "continue;")
    {
        return Some(FlowJump { .kind = FL_CONTINUE, .cond = cond, .label = tail });
    }
    if (Some(g) = StringView::strip_prefix(tail, "goto "))
    {
        if (Some(l) = StringView::strip_suffix(g, ";"))
        {
            if (is_label_name(l))
            {
                return Some(FlowJump { .kind = FL_GOTO, .cond = cond, .label = l });
            }
        }
    }
    if (((tail == "return;" || StringView::starts_with(tail, "return ")) && StringView::ends_with(tail, ";"))
        || tail == "__builtin_unreachable();")
    {
        return Some(FlowJump { .kind = FL_EXIT, .cond = cond, .label = tail });
    }
    None
}

// Whether a line names `w` as a whole word.
fn has_word(StringView t, StringView w) : bool
{
    slice<u8, shared> b = StringView::as_bytes(t);
    usize n = slice_len(b);
    usize wl = StringView::len(w);
    usize from = 0;
    while (true)
    {
        usize k = match (StringView::find(&t[from..$], w))
        {
            Some(x) : x,
            None    : return false,
        };
        usize s = from + k;
        usize e = s + wl;
        if ((s == 0 || !is_id(b[s - 1])) && (e == n || !is_id(b[e])))
        {
            return true;
        }
        from = e;
    }
    false
}

// Whether a line calls anything but the pure helpers.
fn calls_impure(StringView t, ref<HashSet<String>, shared> pure) : bool
{
    slice<u8, shared> b = StringView::as_bytes(t);
    usize n = slice_len(b);
    usize i = 0;
    while (i < n)
    {
        if (!is_id(b[i]) || (i > 0 && is_id(b[i - 1])) || (b[i] >= b'0' && b[i] <= b'9'))
        {
            i += 1;
            continue;
        }
        usize e = i;
        while (e < n && is_id(b[e]))
        {
            e += 1;
        }
        usize k = e;
        while (k < n && b[k] == b' ')
        {
            k += 1;
        }
        if (k < n && b[k] == b'(' && !HashSet::contains(pure, &String::from_view(&t[i..e])))
        {
            return true;
        }
        i = e;
    }
    false
}

// The `cb_at` lines `drop_dead_locations` drops, over the body's flow of
// control: a location is dead where no path from it reaches a line that
// could read it before a line that sets it again, and of those left, one
// is dropped where every path to it has set that location already (and
// called nothing since). A `return` reads none: a caller sets its own
// before reading it after a call. None when the body holds a line this
// does not follow (a `switch`, a `do`, a jump out of a statement
// expression).
fn dead_locations_flow(
    ref<Vec<StringView>, shared> lines,
    ref<HashSet<String>, shared> pure,
    Option<bool> tail_entry,
) : Option<Vec<bool>>
{
    // `} else {` and `} else if (…) {` as two lines: the branch's close,
    // then the next branch.
    Vec<usize> node_line = Vec::new();
    Vec<StringView> texts = Vec::new();
    for (usize i = 0; i < Vec::len(lines); i += 1)
    {
        StringView t = StringView::trim(lines[i]);
        if (Some(rest) = StringView::strip_prefix(t, "} else"))
        {
            if (!StringView::ends_with(rest, "{"))
            {
                return None;
            }
            Vec::push(&mut node_line, i);
            Vec::push(&mut texts, &t[0..1]);
            Vec::push(&mut node_line, i);
            Vec::push(&mut texts, &t[2..$]);
        }
        else
        {
            Vec::push(&mut node_line, i);
            Vec::push(&mut texts, t);
        }
    }
    usize n = Vec::len(&texts);
    Vec<u8> kind = Vec::new();
    Vec<bool> cond = Vec::new();
    Vec<StringView> label = Vec::new();
    for (usize i = 0; i < n; i += 1)
    {
        StringView t = texts[i];
        u8 k = FL_OTHER;
        bool c = false;
        StringView l = t;
        if (StringView::ends_with(t, "{"))
        {
            if (t == "{")
            {
                k = FL_BLOCK;
            }
            else if (t == "for (;;) {")
            {
                k = FL_FOREVER;
            }
            else if (StringView::starts_with(t, "for ("))
            {
                k = FL_LOOP;
            }
            else if (StringView::starts_with(t, "if ("))
            {
                k = FL_IF;
            }
            else if (StringView::starts_with(t, "else if ("))
            {
                k = FL_ELSE_IF;
            }
            else if (t == "else {")
            {
                k = FL_ELSE;
            }
            else
            {
                return None;
            }
        }
        else if (StringView::starts_with(t, "}"))
        {
            if (t != "}")
            {
                return None;
            }
            k = FL_CLOSE;
        }
        else
        {
            match (flow_jump(t))
            {
                Some(j) :
                {
                    k = j.kind;
                    c = j.cond;
                    l = j.label;
                },
                None    :
                {
                    StringView u = match (StringView::strip_suffix(t, ";"))
                    {
                        Some(x) : x,
                        None    : t,
                    };
                    Option<StringView> name = StringView::strip_suffix(StringView::trim_end(u), ":");
                    bool is_label = false;
                    if (Some(nm) = name)
                    {
                        if (is_label_name(nm))
                        {
                            is_label = true;
                            k = FL_LABEL;
                            l = nm;
                        }
                    }
                    if (!is_label)
                    {
                        // A jump inside a line leaves only that line's own
                        // statement. A statement under an `if`, `for` or
                        // `while` on the next line.
                        bool head = (StringView::starts_with(t, "if (") || StringView::starts_with(t, "for (")
                            || StringView::starts_with(t, "while ("))
                            && !StringView::ends_with(t, ";");
                        if (head || StringView::ends_with(t, "else") || has_word(t, "goto") || has_word(t, "return")
                            || StringView::starts_with(t, "else") || StringView::starts_with(t, "case ")
                            || StringView::starts_with(t, "default:"))
                        {
                            return None;
                        }
                        if ((StringView::contains(t, "break;") || StringView::contains(t, "continue;"))
                            && !(StringView::contains(t, "switch (") || StringView::contains(t, "for (")
                                || StringView::contains(t, "while (") || StringView::contains(t, "do {")))
                        {
                            return None;
                        }
                    }
                },
            }
        }
        Vec::push(&mut kind, k);
        Vec::push(&mut cond, c);
        Vec::push(&mut label, l);
    }
    // The braces matched, each line's innermost loop, and the labels.
    Vec<usize> close_of = Vec::filled(n, FL_NONE);
    Vec<usize> open_of = Vec::filled(n, FL_NONE);
    Vec<usize> loop_of = Vec::filled(n, FL_NONE);
    Vec<usize> stack = Vec::new();
    Vec<usize> loops = Vec::new();
    HashMap<String, usize> labels = HashMap::new();
    for (usize i = 0; i < n; i += 1)
    {
        usize nl = Vec::len(&loops);
        loop_of[i] = if (nl > 0) { loops[nl - 1] } else { FL_NONE };
        u8 k = kind[i];
        if (k <= FL_LOOP)
        {
            if ((k == FL_ELSE_IF || k == FL_ELSE)
                && (i == 0 || kind[i - 1] != FL_CLOSE || !(kind[open_of[i - 1]] == FL_IF || kind[open_of[i - 1]] == FL_ELSE_IF)))
            {
                return None;
            }
            Vec::push(&mut stack, i);
            if (k == FL_FOREVER || k == FL_LOOP)
            {
                Vec::push(&mut loops, i);
            }
        }
        else if (k == FL_CLOSE)
        {
            usize o = match (Vec::pop(&mut stack))
            {
                Some(x) : x,
                None    : return None,
            };
            close_of[o] = i;
            open_of[i] = o;
            if (kind[o] == FL_FOREVER || kind[o] == FL_LOOP)
            {
                Vec::pop(&mut loops);
            }
        }
        else if (k == FL_LABEL)
        {
            if (HashMap::contains(&labels, &String::from_view(label[i])))
            {
                return None;
            }
            HashMap::insert(&mut labels, String::from_view(label[i]), i);
        }
    }
    if (Vec::len(&stack) != 0)
    {
        return None;
    }
    Vec<bool> reads = Vec::filled(n, false);
    Vec<Vec<usize>> succ = Vec::new();
    for (usize i = 0; i < n; i += 1)
    {
        Vec<usize> ss = Vec::new();
        usize next = i + 1;
        StringView t = texts[i];
        u8 k = kind[i];
        if (k == FL_BLOCK || k == FL_ELSE || k == FL_FOREVER || k == FL_LABEL || k == FL_OTHER)
        {
            reads[i] = k != FL_LABEL && reads_location(t, pure);
            Vec::push(&mut ss, next);
        }
        else if (k == FL_IF || k == FL_ELSE_IF || k == FL_LOOP)
        {
            reads[i] = reads_location(t, pure);
            Vec::push(&mut ss, next);
            Vec::push(&mut ss, close_of[i] + 1);
        }
        else if (k == FL_CLOSE)
        {
            usize o = open_of[i];
            u8 ko = kind[o];
            if (ko == FL_FOREVER || ko == FL_LOOP)
            {
                Vec::push(&mut ss, o);
            }
            else if (ko == FL_IF || ko == FL_ELSE_IF || ko == FL_ELSE)
            {
                // The `if` chain's end: the line after its last branch.
                usize b = o;
                while (true)
                {
                    usize c = close_of[b];
                    if (c + 1 < n && (kind[c + 1] == FL_ELSE_IF || kind[c + 1] == FL_ELSE))
                    {
                        b = c + 1;
                    }
                    else
                    {
                        Vec::push(&mut ss, c + 1);
                        break;
                    }
                }
            }
            else
            {
                Vec::push(&mut ss, next);
            }
        }
        else if (k == FL_BREAK || k == FL_CONTINUE)
        {
            reads[i] = reads_location(t, pure);
            usize lp = loop_of[i];
            if (lp == FL_NONE)
            {
                return None;
            }
            Vec::push(&mut ss, if (k == FL_BREAK) { close_of[lp] + 1 } else { lp });
            if (cond[i])
            {
                Vec::push(&mut ss, next);
            }
        }
        else if (k == FL_GOTO)
        {
            reads[i] = reads_location(t, pure);
            match (HashMap::get(&labels, &String::from_view(label[i])))
            {
                Some(at) : Vec::push(&mut ss, *at),
                None     :
                {
                    // D-0309: a self tail call's jump, to the body's first line
                    // past a prologue that reads no location (`tail_entry`);
                    // else a label outside the body, or a prologue that may
                    // read the location.
                    bool past_quiet = match (tail_entry)
                    {
                        Some(r) : !r,
                        None    : false,
                    };
                    if (label[i] == "self_tail" && past_quiet)
                    {
                        Vec::push(&mut ss, 0);
                    }
                    else
                    {
                        reads[i] = true;
                    }
                },
            }
            if (cond[i])
            {
                Vec::push(&mut ss, next);
            }
        }
        else
        {
            reads[i] = reads_location(t, pure);
            if (cond[i])
            {
                Vec::push(&mut ss, next);
            }
        }
        Vec::push(&mut succ, ss);
    }
    Vec<bool> kills = Vec::new();
    for (usize i = 0; i < n; i += 1)
    {
        Vec::push(&mut kills, StringView::starts_with(texts[i], "cb_at("));
    }
    // Live: a path reaches a reader before a `cb_at`.
    Vec<Vec<usize>> preds = Vec::new();
    for (usize i = 0; i < n; i += 1)
    {
        Vec::push(&mut preds, Vec::new());
    }
    for (usize i = 0; i < n; i += 1)
    {
        foreach (s in &succ[i])
        {
            if (*s < n)
            {
                Vec::push(&mut preds[*s], i);
            }
        }
    }
    Vec<bool> live = Vec::clone(&reads);
    Vec<usize> work = Vec::new();
    for (usize i = 0; i < n; i += 1)
    {
        if (live[i])
        {
            Vec::push(&mut work, i);
        }
    }
    while (true)
    {
        usize s = match (Vec::pop(&mut work))
        {
            Some(x) : x,
            None    : break,
        };
        foreach (p in &preds[s])
        {
            if (!live[*p] && !kills[*p])
            {
                live[*p] = true;
                Vec::push(&mut work, *p);
            }
        }
    }
    Vec<bool> dead_node = Vec::filled(n, false);
    for (usize i = 0; i < n; i += 1)
    {
        bool any = false;
        foreach (s in &succ[i])
        {
            if (*s < n && live[*s])
            {
                any = true;
            }
        }
        dead_node[i] = kills[i] && !any;
    }
    // Then a `cb_at` kept whose location every path to it has already set:
    // the location known on entry to each line (0: not yet reached, 1:
    // unknown, 2: the location `known_at` names), a call making it
    // unknown.
    Vec<u8> known = Vec::filled(n, 0);
    Vec<usize> known_at = Vec::filled(n, FL_NONE);
    Vec<bool> queued = Vec::filled(n, false);
    Vec<usize> todo = Vec::new();
    if (n > 0)
    {
        known[0] = 1;
        queued[0] = true;
        Vec::push(&mut todo, 0);
    }
    while (true)
    {
        usize i = match (Vec::pop(&mut todo))
        {
            Some(x) : x,
            None    : break,
        };
        queued[i] = false;
        if (known[i] == 0)
        {
            continue;
        }
        u8 after = known[i];
        usize after_at = known_at[i];
        if (kills[i] && !dead_node[i])
        {
            after = 2;
            after_at = i;
        }
        else if (!kills[i] && calls_impure(texts[i], pure))
        {
            after = 1;
            after_at = FL_NONE;
        }
        foreach (s0 in &succ[i])
        {
            usize s = *s0;
            if (s >= n)
            {
                continue;
            }
            u8 jk = after;
            usize ja = after_at;
            if (known[s] != 0
                && !(known[s] == after && (after != 2 || texts[known_at[s]] == texts[after_at])))
            {
                jk = 1;
                ja = FL_NONE;
            }
            if (known[s] == 1 && jk == 1)
            {
                continue;
            }
            if (known[s] == 2 && jk == 2 && texts[known_at[s]] == texts[ja])
            {
                continue;
            }
            known[s] = jk;
            known_at[s] = ja;
            if (!queued[s])
            {
                queued[s] = true;
                Vec::push(&mut todo, s);
            }
        }
    }
    Vec<bool> dead = Vec::filled(Vec::len(lines), false);
    for (usize i = 0; i < n; i += 1)
    {
        if (dead_node[i] || (kills[i] && known[i] == 2 && texts[known_at[i]] == texts[i]))
        {
            dead[node_line[i]] = true;
        }
    }
    Some(dead)
}

// The executing statement's location (`cb_at`) is read only by a fault
// raised without a location of its own (`CB_NOLOC`), and inside the
// runtime (pops, destructors, the checks it faults from): any call of
// anything but the pure helpers. A `cb_at` no path from which reaches
// such a line before the next `cb_at` is dropped (`dead_locations_flow`,
// or in straight-line code only, `dead_locations_straight`, where the
// body's flow is not followed).
// `marks`: a location dropped is kept as a `LINE_MARK` comment for
// `line_directives`, which removes it; it reads as nothing to the one
// pass that runs between (`elide_implied_checks`: no call in it).
// `tail_entry`: for a body a self tail call jumps back into, whether the
// prologue between `self_tail` and the body may read the location.
export fn drop_dead_locations(ref<String, shared> out, bool marks, Option<bool> tail_entry) : String
{
    HashSet<String> pure = name_set(LOCATION_PURE);
    Vec<StringView> lines = StringView::lines(out);
    Vec<bool> dead = match (dead_locations_flow(&lines, &pure, tail_entry))
    {
        Some(d) : d,
        None    : dead_locations_straight(&lines, &pure),
    };
    String res = String::new();
    String::reserve(&mut res, StringView::len(out));
    for (usize i = 0; i < Vec::len(&lines); i += 1)
    {
        StringView line = lines[i];
        if (dead[i])
        {
            if (marks)
            {
                match (at_of(StringView::trim_start(line)))
                {
                    Some(at) :
                    {
                        String::append(
                            &mut res,
                            &sprintf("%v%v %v*/\n", LINE_MARK, at.file, at.line),
                        );
                    },
                    None     : {},
                }
            }
            continue;
        }
        String::append(&mut res, line);
        String::push_ascii(&mut res, b'\n');
    }
    res
}

// `t` with each whole-word occurrence of `w` replaced by `by`.
fn replace_word(StringView t, StringView w, StringView by) : String
{
    slice<u8, shared> b = StringView::as_bytes(t);
    usize n = slice_len(b);
    usize wl = StringView::len(w);
    String out = String::new();
    usize from = 0;
    while (true)
    {
        usize k = match (StringView::find(&t[from..$], w))
        {
            Some(x) : x,
            None    : break,
        };
        usize s = from + k;
        usize e = s + wl;
        String::append(&mut out, &t[from..s]);
        if ((s == 0 || !is_id(b[s - 1])) && (e == n || !is_id(b[e])))
        {
            String::append(&mut out, by);
        }
        else
        {
            String::append(&mut out, w);
        }
        from = e;
    }
    String::append(&mut out, &t[from..$]);
    out
}

// The label a line defines (`name: ;` or `name:;`), if it is one.
fn label_of(StringView l) : Option<StringView>
{
    StringView t = StringView::trim(l);
    StringView u = match (StringView::strip_suffix(t, ";"))
    {
        Some(x) : x,
        None    : t,
    };
    StringView nm = StringView::strip_suffix(StringView::trim_end(u), ":")?;
    if (is_label_name(nm)) { Some(nm) } else { None }
}

// A tagged line without its tag (`VER_TAG`), when the tag names one of
// `lens`.
fn ver_untagged(StringView l, ref<Vec<StringView>, shared> lens) : Option<String>
{
    StringView t = StringView::trim_start(l);
    StringView rest = StringView::strip_prefix(t, VER_TAG)?;
    usize close = StringView::find(rest, "*/ ")?;
    StringView len = &rest[0..close];
    foreach (x in lens)
    {
        if (*x == len)
        {
            String out = String::from_view(&l[0..StringView::len(l) - StringView::len(t)]);
            String::append(&mut out, &rest[close + 3..$]);
            return Some(out);
        }
    }
    None
}

// D-0309: each loop `lower_while` marked (`VER_MARK`: the bound of its
// variable, fixed for the loop, and the fixed vector lengths its tagged bounds
// checks compare that variable with) as two: where the bound is at most every
// length, a copy without the tagged checks (each would pass: the variable is
// below the bound wherever the body reads it), its labels renamed; otherwise
// the loop as it was. A nested loop, marked after the loop around it, is
// copied first, its checks no longer tagged when the outer one is (cobc's
// `version_loops`).
export fn version_loops(ref<String, shared> text) : String
{
    if (!StringView::contains(text, VER_MARK))
    {
        return String::clone(text);
    }
    Vec<String> lines = Vec::new();
    foreach (l in StringView::lines(text))
    {
        Vec::push(&mut lines, String::from_view(l));
    }
    usize copies = 0;
    while (true)
    {
        usize m = FL_NONE;
        usize q = Vec::len(&lines);
        while (q > 0)
        {
            q -= 1;
            if (StringView::starts_with(StringView::trim_start(&lines[q]), VER_MARK))
            {
                m = q;
                break;
            }
        }
        if (m == FL_NONE)
        {
            break;
        }
        String spec = String::new();
        match (StringView::strip_prefix(StringView::trim(&lines[m]), VER_MARK))
        {
            Some(r) :
            {
                match (StringView::strip_suffix(r, "*/"))
                {
                    Some(r2) : String::append(&mut spec, r2),
                    None     : {},
                }
            },
            None    : {},
        }
        Vec<StringView> parts = Vec::new();
        foreach (p in StringView::split(&spec, " "))
        {
            if (StringView::len(p) > 0)
            {
                Vec::push(&mut parts, p);
            }
        }
        usize start = m + 1;
        // The loop: its `for` to the matching `}`.
        usize end = FL_NONE;
        if (Vec::len(&parts) >= 2 && start < Vec::len(&lines) && StringView::trim(&lines[start]) == "for (;;) {")
        {
            i64 depth = 0;
            for (usize i = start; i < Vec::len(&lines); i += 1)
            {
                StringView t = StringView::trim(&lines[i]);
                if (StringView::starts_with(t, "}"))
                {
                    depth -= 1;
                }
                if (StringView::ends_with(t, "{"))
                {
                    depth += 1;
                }
                if (depth == 0)
                {
                    end = i;
                    break;
                }
            }
        }
        if (end == FL_NONE)
        {
            Vec::remove(&mut lines, m);
            continue;
        }
        StringView bound = parts[0];
        Vec<StringView> lens = Vec::new();
        for (usize i = 1; i < Vec::len(&parts); i += 1)
        {
            Vec::push(&mut lens, parts[i]);
        }
        Vec<String> fast = Vec::new();
        Vec<String> slow = Vec::new();
        for (usize i = start; i <= end; i += 1)
        {
            StringView l = &lines[i];
            match (ver_untagged(l, &lens))
            {
                Some(u) : Vec::push(&mut slow, u),
                None    :
                {
                    Vec::push(&mut fast, String::from_view(l));
                    Vec::push(&mut slow, String::from_view(l));
                },
            }
        }
        Vec<String> labels = Vec::new();
        foreach (l in &fast)
        {
            match (label_of(l))
            {
                Some(nm) : Vec::push(&mut labels, String::from_view(nm)),
                None     : {},
            }
        }
        for (usize i = 0; i < Vec::len(&fast); i += 1)
        {
            foreach (nm in &labels)
            {
                if (StringView::contains(&fast[i], nm))
                {
                    String renamed = replace_word(&fast[i], nm, &sprintf("%s_v%v", nm, copies));
                    fast[i] = renamed;
                }
            }
        }
        copies += 1;
        String ind = String::new();
        slice<u8, shared> mb = StringView::as_bytes(&lines[m]);
        for (usize i = 0; i < slice_len(mb) && mb[i] == b' '; i += 1)
        {
            String::push_ascii(&mut ind, b' ');
        }
        String test = String::new();
        for (usize i = 0; i < Vec::len(&lens); i += 1)
        {
            if (i > 0)
            {
                String::append(&mut test, " && ");
            }
            String::appendf(&mut test, "%s <= %s", bound, lens[i]);
        }
        Vec<String> new = Vec::new();
        Vec::push(&mut new, sprintf("%sif (%s) {", &ind, &test));
        foreach (l in &fast)
        {
            Vec::push(&mut new, String::clone(l));
        }
        Vec::push(&mut new, sprintf("%s} else {", &ind));
        foreach (l in &slow)
        {
            Vec::push(&mut new, String::clone(l));
        }
        Vec::push(&mut new, sprintf("%s}", &ind));
        Vec<String> after = Vec::new();
        for (usize i = end + 1; i < Vec::len(&lines); i += 1)
        {
            Vec::push(&mut after, String::clone(&lines[i]));
        }
        Vec::truncate(&mut lines, m);
        foreach (l in &new)
        {
            Vec::push(&mut lines, String::clone(l));
        }
        foreach (l in &after)
        {
            Vec::push(&mut lines, String::clone(l));
        }
    }
    String out = String::join(&lines[0..$], "\n");
    if (StringView::ends_with(text, "\n"))
    {
        String::push_ascii(&mut out, b'\n');
    }
    out
}

// The variables a C expression names (cobc's `expr_vars`): not after `.` or
// `->` (a field), not a type (`struct`, `s_…`, `cb_ref`, `void`).
fn expr_vars(StringView e) : Vec<String>
{
    slice<u8, shared> b = StringView::as_bytes(e);
    usize n = slice_len(b);
    Vec<String> out = Vec::new();
    usize i = 0;
    while (i < n)
    {
        if (!is_id(b[i]) || (b[i] >= b'0' && b[i] <= b'9'))
        {
            i += 1;
            continue;
        }
        usize j = i;
        while (j < n && is_id(b[j]))
        {
            j += 1;
        }
        StringView id = &e[i..j];
        bool field = (i >= 1 && b[i - 1] == b'.') || (i >= 2 && b[i - 2] == b'-' && b[i - 1] == b'>');
        if (!field && id != "struct" && id != "void" && id != "cb_ref" && !StringView::starts_with(id, "s_"))
        {
            bool seen = false;
            foreach (o in &out)
            {
                if (StringView::eq(o, id))
                {
                    seen = true;
                }
            }
            if (!seen)
            {
                Vec::push(&mut out, String::from_view(id));
            }
        }
        i = j;
    }
    out
}

// A call's arguments, split at the commas outside parentheses and braces,
// and the index of its `)` (cobc's `split_call`).
struct CallArgs
{
    Vec<String> args;
    usize close;
}

fn split_call(StringView t, usize open) : Option<CallArgs>
{
    slice<u8, shared> b = StringView::as_bytes(t);
    usize n = slice_len(b);
    i64 depth = 0;
    usize from = open + 1;
    Vec<String> args = Vec::new();
    for (usize j = open; j < n; j += 1)
    {
        u8 c = b[j];
        if (c == b'(' || c == b'{')
        {
            depth += 1;
        }
        else if (c == b')' || c == b'}')
        {
            depth -= 1;
            if (depth == 0)
            {
                Vec::push(&mut args, String::from_view(StringView::trim(&t[from..j])));
                return Some(CallArgs { .args = args, .close = j });
            }
        }
        else if (c == b',' && depth == 1)
        {
            Vec::push(&mut args, String::from_view(StringView::trim(&t[from..j])));
            from = j + 1;
        }
    }
    None
}

// D-0309: a loop whose one use of a vector is a confined push
// (`native_vec_push`'s `_nc` form, `f_std__Vec__push_T_nc(V, x, F, L)`), the
// same `V` each time, and which calls nothing else, can fault nowhere and
// leaves only through its end or a `break` (no `return`, no `goto` out, no
// label reached from outside), keeps the vector's header in locals: its
// pointer, length and capacity, the length stored back before `grow` and
// after the loop (cobc's `keep_push_headers`).
export fn keep_push_headers(ref<String, shared> text) : String
{
    if (!StringView::contains(text, "f_std__Vec__push_") || !StringView::contains(text, "_nc("))
    {
        return String::clone(text);
    }
    HashSet<String> pure = name_set(LOCATION_PURE);
    Vec<String> lines = Vec::new();
    foreach (l in StringView::lines(text))
    {
        Vec::push(&mut lines, String::from_view(l));
    }
    usize kept = 0;
    usize s = 0;
    while (s < Vec::len(&lines))
    {
        if (StringView::trim(&lines[s]) != "for (;;) {")
        {
            s += 1;
            continue;
        }
        // The loop: its `for` to the matching `}`.
        usize e = FL_NONE;
        i64 depth = 0;
        for (usize i = s; i < Vec::len(&lines); i += 1)
        {
            StringView t = StringView::trim(&lines[i]);
            if (StringView::starts_with(t, "}"))
            {
                depth -= 1;
            }
            if (StringView::ends_with(t, "{"))
            {
                depth += 1;
            }
            if (depth == 0)
            {
                e = i;
                break;
            }
        }
        if (e == FL_NONE)
        {
            break;
        }
        // The pushes: their lines and arguments (V, x, F, L).
        String name = String::new();
        String v = String::new();
        bool have = false;
        Vec<usize> push_at = Vec::new();
        Vec<Vec<String>> push_args = Vec::new();
        bool ok = true;
        for (usize i = s + 1; i < e; i += 1)
        {
            StringView t = StringView::trim(&lines[i]);
            if (StringView::starts_with(t, "f_std__Vec__push_"))
            {
                usize name_end = match (StringView::find(t, "("))
                {
                    Some(k) : k,
                    None    : 0,
                };
                StringView nm = &t[0..name_end];
                bool good = false;
                match (split_call(t, name_end))
                {
                    Some(ca) :
                    {
                        if (StringView::ends_with(nm, "_nc") && Vec::len(&ca.args) == 4 && &t[ca.close + 1..$] == ";")
                        {
                            bool same = !have || (StringView::eq(&name, nm) && StringView::eq(&v, &ca.args[0]));
                            bool clean = !calls_impure(&ca.args[1], &pure) && !calls_impure(&ca.args[2], &pure)
                                && !calls_impure(&ca.args[3], &pure);
                            if (same && clean)
                            {
                                if (!have)
                                {
                                    name = String::from_view(nm);
                                    v = String::clone(&ca.args[0]);
                                    have = true;
                                }
                                Vec<String> args = Vec::new();
                                foreach (a in &ca.args)
                                {
                                    Vec::push(&mut args, String::clone(a));
                                }
                                Vec::push(&mut push_at, i);
                                Vec::push(&mut push_args, args);
                                good = true;
                            }
                        }
                    },
                    None     : {},
                }
                if (!good)
                {
                    ok = false;
                    break;
                }
                continue;
            }
            if (calls_impure(t, &pure) || has_word(t, "return") || StringView::contains(t, VER_MARK)
                || StringView::contains(t, VER_TAG))
            {
                ok = false;
                break;
            }
        }
        if (!ok || !have)
        {
            s += 1;
            continue;
        }
        // `V`'s variables named nowhere else in the loop; every `goto` to a
        // label of the loop, and every label of the loop reached from it.
        Vec<String> vars = expr_vars(&v);
        Vec<String> labels = Vec::new();
        for (usize i = s; i <= e; i += 1)
        {
            match (label_of(&lines[i]))
            {
                Some(nm) : Vec::push(&mut labels, String::from_view(nm)),
                None     : {},
            }
        }
        for (usize i = 0; i < Vec::len(&lines); i += 1)
        {
            StringView t = StringView::trim(&lines[i]);
            bool inside = s < i && i < e;
            usize pk = FL_NONE;
            for (usize q = 0; q < Vec::len(&push_at); q += 1)
            {
                if (push_at[q] == i)
                {
                    pk = q;
                }
            }
            if (inside && pk == FL_NONE)
            {
                foreach (w in &vars)
                {
                    if (has_word(t, w))
                    {
                        ok = false;
                    }
                }
            }
            if (pk != FL_NONE)
            {
                for (usize a = 1; a < Vec::len(&push_args[pk]); a += 1)
                {
                    foreach (w in &vars)
                    {
                        if (has_word(&push_args[pk][a], w))
                        {
                            ok = false;
                        }
                    }
                }
            }
            match (StringView::find(t, "goto "))
            {
                Some(g) :
                {
                    StringView rest = &t[g + 5..$];
                    match (StringView::find(rest, "goto "))
                    {
                        Some(g2) : rest = &rest[0..g2],
                        None     : {},
                    }
                    while (StringView::ends_with(rest, ";"))
                    {
                        rest = &rest[0..StringView::len(rest) - 1];
                    }
                    StringView target = StringView::trim(rest);
                    bool known = false;
                    foreach (nm in &labels)
                    {
                        if (StringView::eq(nm, target))
                        {
                            known = true;
                        }
                    }
                    if (inside != known)
                    {
                        ok = false;
                    }
                },
                None    : {},
            }
        }
        if (!ok)
        {
            s += 1;
            continue;
        }
        String ty = String::from_view(&name[StringView::len("f_std__Vec__push_")..StringView::len(&name) - 3]);
        String ind = String::from_view(indent_of(&lines[s]));
        usize k = kept;
        kept += 1;
        for (usize q = 0; q < Vec::len(&push_at); q += 1)
        {
            usize i = push_at[q];
            String pi = String::from_view(indent_of(&lines[i]));
            String at = String::new();
            if (push_args[q][2] != "CB_NOLOC")
            {
                String::appendf(&mut at, "cb_at(%s, %s); ", &push_args[q][2], &push_args[q][3]);
            }
            String line = sprintf("%s{ if (__builtin_expect(kh%v_n == kh%v_c, 0)) { kh%v_v->len = kh%v_n; ", &pi, k, k, k, k);
            String::appendf(&mut line, "%sf_std__Vec__grow_%s(%s); kh%v_p = kh%v_v->ptr; kh%v_c = kh%v_v->cap; } ", &at, &ty, &v, k, k, k, k);
            String::appendf(&mut line, "kh%v_p[kh%v_n] = %s; kh%v_n += 1; }", k, k, &push_args[q][1], k);
            lines[i] = line;
        }
        Vec::insert(&mut lines, e + 1, sprintf("%skh%v_v->len = kh%v_n; }", &ind, k, k));
        String head = sprintf("%s{ struct s_std__Vec_%s *kh%v_v = (struct s_std__Vec_%s *)(%s).p; ", &ind, &ty, k, &ty, &v);
        String::appendf(&mut head, "__typeof__(kh%v_v->ptr) kh%v_p = kh%v_v->ptr; uint64_t kh%v_n = kh%v_v->len; ", k, k, k, k, k);
        String::appendf(&mut head, "uint64_t kh%v_c = kh%v_v->cap;", k, k);
        Vec::insert(&mut lines, s, head);
        s = e + 3;
    }
    String out = String::join(&lines[0..$], "\n");
    if (StringView::ends_with(text, "\n"))
    {
        String::push_ascii(&mut out, b'\n');
    }
    out
}

// A function's length in lines for the size limits, `LINE_MARK`s not
// counted: the directives change no decision.
export fn code_lines(ref<String, shared> text) : usize
{
    usize n = 0;
    Vec<StringView> lines = StringView::lines(text);
    foreach (l in &lines)
    {
        if (!StringView::starts_with(*l, LINE_MARK))
        {
            n += 1;
        }
    }
    n
}

// D-0219: each call's `ARRIVE_MARK` names the callee's `__arrive` twin
// where it has one, and the callee itself where it has none.
export fn resolve_arrive(ref<String, shared> text, ref<HashSet<String>, shared> twins) : String
{
    String out = String::new();
    String::reserve(&mut out, StringView::len(text));
    StringView rest = text;
    usize mark = StringView::len(ARRIVE_MARK);
    while (true)
    {
        usize i = match (StringView::find(rest, ARRIVE_MARK))
        {
            Some(k) : k,
            None    : break,
        };
        StringView head = &rest[0..i];
        slice<u8, shared> hb = StringView::as_bytes(head);
        usize start = i;
        while (start > 0 && is_id(hb[start - 1]))
        {
            start -= 1;
        }
        String::append(&mut out, head);
        if (HashSet::contains(twins, &String::from_view(&head[start..i])))
        {
            String::append(&mut out, "__arrive");
        }
        rest = &rest[i + mark..$];
    }
    String::append(&mut out, rest);
    out
}

// The identifiers in `text` (cobc's `cc::identifiers`): each run of letters,
// digits and `_` that starts with a letter or `_`.
fn identifiers(StringView text, ref<HashSet<String>, exclusive> out)
{
    slice<u8, shared> b = StringView::as_bytes(text);
    usize n = slice_len(b);
    usize i = 0;
    while (i < n)
    {
        u8 c = b[i];
        if (c == b'_' || (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z'))
        {
            usize start = i;
            while (i < n && is_id(b[i]))
            {
                i += 1;
            }
            HashSet::insert(out, String::from_view(&text[start..i]));
        }
        else
        {
            i += 1;
        }
    }
}

// A function definition's first line (cobc's `cc::is_definition`): at the
// start of a line, not a declaration, and followed by the line `{`.
fn is_definition(StringView line, Option<StringView> next) : bool
{
    bool brace = match (next)
    {
        Some(n) : n == "{",
        None    : false,
    };
    brace && StringView::len(line) > 0 && !starts_with_any(line, " {}#") && StringView::ends_with(line, ")")
        && !StringView::starts_with(line, "static ")
}

// The name before a line's first `(` (cobc's `cc::name_before_paren`).
fn name_before_paren(StringView line) : Option<StringView>
{
    usize open = match (StringView::find(line, "("))
    {
        Some(k) : k,
        None    : return None,
    };
    StringView head = &line[0..open];
    usize end = StringView::len(StringView::trim_end(head));
    slice<u8, shared> hb = StringView::as_bytes(head);
    usize start = end;
    while (start > 0 && is_id(hb[start - 1]))
    {
        start -= 1;
    }
    if (start == end) { None } else { Some(&head[start..end]) }
}

// Every function defined in a unit that is not pure `std`, and named by no
// pure-`std` unit (`pure_std`), gets `static`
// (`Gen::localize`), so the C compiler may inline it wherever it is called
// and drop it where it is not; not `main`'s C name (`main_c`). `texts` and
// `pure_std` are the units' texts and flags; a signature in `inline_sigs`
// (D-0209: a direct-parameter dispatcher) is made
// `static inline __attribute__((always_inline))`. The prototype of each
// function made `static` gets `static` too. (cobc also empties its
// `inline_sigs` here; nothing reads them after.)
export fn localize(
    ref<Vec<String>, exclusive> texts,
    ref<Vec<bool>, shared> pure_std,
    ref<String, exclusive> protos,
    ref<HashSet<String>, shared> inline_sigs,
    StringView main_c,
)
{
    HashSet<String> cached = HashSet::new();
    for (usize u = 0; u < Vec::len(texts); u += 1)
    {
        if (pure_std[u])
        {
            identifiers(&texts[u], &mut cached);
        }
    }
    HashSet<String> local = HashSet::new();
    for (usize u = 0; u < Vec::len(texts); u += 1)
    {
        if (pure_std[u])
        {
            continue;
        }
        String out = String::new();
        String::reserve(&mut out, StringView::len(&texts[u]) + 64);
        {
            Vec<StringView> lines = StringView::split(&texts[u], "\n");
            for (usize k = 0; k < Vec::len(&lines); k += 1)
            {
                StringView l = lines[k];
                Option<StringView> next = if (k + 1 < Vec::len(&lines)) { Some(lines[k + 1]) } else { None };
                if (is_definition(l, next))
                {
                    match (name_before_paren(l))
                    {
                        Some(n) :
                        {
                            if (!StringView::eq(n, main_c) && !HashSet::contains(&cached, &String::from_view(n)))
                            {
                                String sig = String::from_view(l);
                                // D-0209: a direct-parameter dispatcher is
                                // inlined at every call (`lower_fn_direct`).
                                if (HashSet::contains(inline_sigs, &sig))
                                {
                                    String::append(&mut out, "static inline __attribute__((always_inline)) ");
                                }
                                else
                                {
                                    String::append(&mut out, "static ");
                                }
                                HashSet::insert(&mut local, sig);
                            }
                        },
                        None    : {},
                    }
                }
                String::append(&mut out, l);
                if (k + 1 < Vec::len(&lines))
                {
                    String::push_ascii(&mut out, b'\n');
                }
            }
        }
        texts[u] = out;
    }
    String ps = String::new();
    String::reserve(&mut ps, StringView::len(&(*protos)[0..$]) + 7 * HashSet::len(&local));
    {
        Vec<StringView> plines = StringView::lines(&(*protos)[0..$]);
        foreach (l in &plines)
        {
            // A prototype's attributes (`proto_attrs`) come before `static`'s
            // place: `static __attribute__((…)) T f(…);`.
            StringView bare = match (StringView::strip_prefix(*l, COLD_PROTO))
            {
                Some(b) : b,
                None    : *l,
            };
            match (StringView::strip_suffix(bare, ";"))
            {
                Some(sig) :
                {
                    if (HashSet::contains(&local, &String::from_view(sig)))
                    {
                        String::append(&mut ps, "static ");
                    }
                },
                None      : {},
            }
            String::append(&mut ps, *l);
            String::push_ascii(&mut ps, b'\n');
        }
    }
    *protos = ps;
}

// ---- D-0294: the record chains nothing reads ----

// `uint64_t NAME = CALL(ARG…);`: NAME and the text after `CALL(`.
struct ChainDecl
{
    String name;
    String args;
}

fn record_decl(StringView t, str call) : Option<ChainDecl>
{
    StringView rest = match (StringView::strip_prefix(t, "uint64_t "))
    {
        Some(r) : r,
        None    : return None,
    };
    usize eq = match (StringView::find(rest, " = "))
    {
        Some(k) : k,
        None    : return None,
    };
    StringView name = &rest[0..eq];
    if (StringView::len(name) == 0)
    {
        return None;
    }
    foreach (c in StringView::as_bytes(name))
    {
        if (!ident_char(*c))
        {
            return None;
        }
    }
    StringView after = &rest[eq + 3..$];
    StringView a1 = match (StringView::strip_prefix(after, call))
    {
        Some(r) : r,
        None    : return None,
    };
    StringView a2 = match (StringView::strip_prefix(a1, "("))
    {
        Some(r) : r,
        None    : return None,
    };
    StringView args = match (StringView::strip_suffix(a2, ");"))
    {
        Some(r) : r,
        None    : return None,
    };
    Some(ChainDecl { .name = String::from_view(name), .args = String::from_view(args) })
}

fn first_arg_of(StringView args) : StringView
{
    Vec<StringView> parts = StringView::split(args, ",");
    if (Vec::len(&parts) == 0)
    {
        return StringView::of("");
    }
    StringView::trim(parts[0])
}

// How often `x` occurs in `text` as a whole identifier.
fn count_in(StringView text, ref<String, shared> x) : usize
{
    slice<u8, shared> b = StringView::as_bytes(text);
    usize n = slice_len(b);
    usize xn = StringView::len(x);
    usize count = 0;
    usize at = 0;
    while (at < n)
    {
        usize i = match (StringView::find(&text[at..n], x))
        {
            Some(k) : at + k,
            None    : break,
        };
        usize j = i + xn;
        if ((i == 0 || !ident_char(b[i - 1])) && (j >= n || !ident_char(b[j])))
        {
            count += 1;
        }
        at = j;
    }
    count
}

// `a` with the prefix `pre` and the suffix `);` taken off, if it has both.
fn stmt_args(StringView t, str pre) : Option<StringView>
{
    match (StringView::strip_prefix(t, pre))
    {
        Some(a) : StringView::strip_suffix(a, ");"),
        None    : None,
    }
}

// D-0294: in a decided program a record that nothing reads is not kept. An
// object made (`uint64_t o = cb_new(&v, …);`), perhaps bound and taken back
// (`cb_bind`, `cb_take`), moved (`cb_move_to`), promoted (`cb_result`) and
// ended (`cb_forget_obj`, `cb_absorb`, `cb_raw_move_in`) in one straight
// run of statements -- no branch, no call that could fault (a destructor
// run at the fault is observable) and no frame's end between, a scope's end
// only once the object was promoted past it or is bound -- with its ids
// named nowhere else, is a record no check reads (every path entry is a
// constant there) whose end comes before any scope's that could destroy
// the value: a struct or variant literal that leaves as a result or an
// argument, a `std` body's result bound and taken back. The statements go.
// Run before the scopes are resolved, so they open no scope for it.
export fn elide_record_chains(ref<String, shared> out) : String
{
    Vec<StringView> views = StringView::lines(out);
    Vec<String> lines = Vec::new();
    foreach (v in &views)
    {
        Vec::push(&mut lines, String::from_view(*v));
    }
    usize n = Vec::len(&lines);
    Vec<usize> drop = Vec::new();
    for (usize i = 0; i < n; i += 1)
    {
        ChainDecl d0 = match (record_decl(StringView::trim(&lines[i]), "cb_new"))
        {
            Some(d) : d,
            None    : continue,
        };
        ChainDecl { name, .. } = d0;
        String start = name;
        String live = String::clone(&start);
        Vec<String> ids = Vec::new();
        Vec::push(&mut ids, String::clone(&start));
        Vec<usize> chain = Vec::new();
        Vec::push(&mut chain, i);
        Option<String> root = None;
        bool promoted = false;
        bool ok = false;
        for (usize j = i + 1; j < n; j += 1)
        {
            StringView t = StringView::trim(&lines[j]);
            if (StringView::len(t) == 0 || StringView::starts_with(t, "#line"))
            {
                continue;
            }
            bool named = false;
            foreach (x in &ids)
            {
                if (count_in(t, x) > 0)
                {
                    named = true;
                }
            }
            if (!named)
            {
                if (t == "cb_stmt_pop();")
                {
                    if (Option::is_none(&root) && !promoted)
                    {
                        break;
                    }
                    promoted = false;
                    continue;
                }
                // A statement that could fault (any call: a destructor the
                // fault would run on the value is observable) ends the run;
                // a plain store or declaration, a position, a scope's start
                // cannot.
                bool plain = !StringView::contains(t, "(") || StringView::starts_with(t, "cb_at(")
                    || StringView::starts_with(t, "cb_stmt_push_at(");
                bool control = false;
                foreach (k in [
                    "if ", "if(", "while ", "while(", "for ", "for(", "switch", "case ", "default:", "do ", "do{",
                    "return", "goto ", "break;", "continue;", "else",
                ])
                {
                    control = control || StringView::starts_with(t, k);
                }
                if (!plain || StringView::contains(
                    t,
                    "{",
                ) || StringView::contains(t, "}") || !StringView::ends_with(t, ";")
                    || control)
                {
                    break;
                }
                continue;
            }
            match (record_decl(t, "cb_bind"))
            {
                Some(d) :
                {
                    if (Option::is_some(&root) || !String::eq(&d.args, &live))
                    {
                        break;
                    }
                    root = Some(String::clone(&d.name));
                    Vec::push(&mut ids, String::clone(&d.name));
                    Vec::push(&mut chain, j);
                    continue;
                },
                None    : {},
            }
            match (record_decl(t, "cb_take"))
            {
                Some(d) :
                {
                    bool from_root = match (&root)
                    {
                        Some(r) : StringView::eq(r, first_arg_of(&d.args)),
                        None    : false,
                    };
                    if (!from_root)
                    {
                        break;
                    }
                    root = None;
                    live = String::clone(&d.name);
                    Vec::push(&mut ids, String::clone(&d.name));
                    promoted = false;
                    Vec::push(&mut chain, j);
                    continue;
                },
                None    : {},
            }
            if (Option::is_some(&root))
            {
                break;
            }
            if (StringView::eq(t, &sprintf("cb_result(%s);", &live)))
            {
                promoted = true;
                Vec::push(&mut chain, j);
                continue;
            }
            bool moved = match (stmt_args(t, "cb_move_to("))
            {
                Some(a) : StringView::eq(first_arg_of(a), &live) && StringView::contains(a, ", &"),
                None    : false,
            };
            if (moved)
            {
                Vec::push(&mut chain, j);
                continue;
            }
            bool raw_in = match (stmt_args(t, "cb_raw_move_in("))
            {
                Some(a) : StringView::eq(first_arg_of(a), &live),
                None    : false,
            };
            if (StringView::eq(t, &sprintf("cb_forget_obj(%s);", &live)) || StringView::eq(
                t,
                &sprintf("cb_absorb(%s);", &live),
            ) || raw_in)
            {
                Vec::push(&mut chain, j);
                ok = true;
                break;
            }
            break;
        }
        if (!ok)
        {
            continue;
        }
        // Every id named only in the chain's own statements.
        bool elsewhere = false;
        foreach (x in &ids)
        {
            usize in_chain = 0;
            foreach (k in &chain)
            {
                in_chain += count_in(&lines[*k], x);
            }
            if (count_in(out, x) != in_chain)
            {
                elsewhere = true;
            }
        }
        if (elsewhere)
        {
            continue;
        }
        foreach (k in &chain)
        {
            Vec::push(&mut drop, *k);
        }
    }
    if (Vec::len(&drop) == 0)
    {
        return String::clone(out);
    }
    foreach (i in &drop)
    {
        lines[*i] = ";";
    }
    String s = String::join(&lines[0..$], "\n");
    if (StringView::ends_with(out, "\n"))
    {
        String::push_ascii(&mut s, b'\n');
    }
    s
}
