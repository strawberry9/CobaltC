// cobc's analysis_strings.rs (`objectless_strings`) and analysis_refs.rs's
// `fusion_plan`, written in CobaltC (D-0274 stage 4): to be ported.

import std;
import ast;
import state;

// `objectless_strings`' answer: the candidate bindings (a `let`'s
// initializer's id, an arm's `body.id | ARM_BIT`), and those of them moved
// away (cobc's `!id`), compared (`id | 1`) and indexed (`id | 2`).
export struct Objectless
{
    export HashSet<usize> ids;
    export HashSet<usize> moved;
    export HashSet<usize> compared;
    export HashSet<usize> indexed;
}

export fn objectless_strings(ref<Gen, exclusive> g, ref<Block, shared> body, ref<Vec<String>, shared> params) : Objectless
{
    Objectless { .ids = HashSet::new(), .moved = HashSet::new(), .compared = HashSet::new(), .indexed = HashSet::new() }
}
