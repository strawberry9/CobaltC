// The code generator written in CobaltC: the bootstrap form of
// impl/cobc/src/lower (D-0274), which it reproduces byte for byte. This
// part is the generator's state and its entry (lower.rs, lower/program.rs),
// one function's C (lower/functions.rs), and the function body's frames,
// temporaries and values (lower/frames.rs, lower/stmts.rs, lower/exprs.rs)
// as far as the programs ported so far reach.

import std;
import ast;
import loader;
import items;
import typecheck;
import check;
import header;
import passes;
import cnames;
import uses;
import direct;
import natives;
import fresh3;
import literals;
import vec3;
import bodies;
import stage1a;
import native_misc;
import native_text;
import analyses;
import strings4;
import vec_scan;
import refs4;
import stack_checks;
import each;
import state;
import typeops;
import layout;
import libheader;
import flights;
import native_map;
import program;
import points;

// ---- the program ----

// The program's C in parts (cobc's `Gen::generate`): the driver compiles
// pure-`std` units apart (`cache.cb`). D-0257: a library (`lib`) has no
// `main`; its entry points (`extern fn` with a body) are requested instead,
// each with a C-callable stub in the tail (`lib_tail`).
export fn generate_parts(ref<Gen, exclusive> g, bool lib) : Generated
{
    g.lib = lib;
    String main_c = if (lib) { String::new() } else { request_fn(g, "main", Vec::new()) };
    bool main_u8 = match (HashMap::get(&g.prog.table.fns, &String::copy("main")))
    {
        Some(m) : !is_void(&m.ret),
        None    : false,
    };
    Vec<Entry> entry_c = request_entries(g, lib);
    while (g.queue_head < Vec::len(&g.queue))
    {
        FnRequest r = clone(&g.queue[g.queue_head]);
        g.queue_head += 1;
        usize start = StringView::len(&g.fns);
        bool pure = StringView::starts_with(&r.name, "std::") && all_std_only(&r.targs);
        lower_fn(g, &r);
        if (Option::is_some(&g.unsupported))
        {
            return unsupported_parts(g);
        }
        String text = String::copy(&g.fns[start..$]);
        // D-0286: a decided program's natives and helpers, whose fixed text
        // puts values in flight, made to hand them over instead
        // (`ground_native`); text it does not know keeps the program on the
        // first lowering.
        if (g.decided && (StringView::contains(&text, "cb_send(") || StringView::contains(&text, "cb_recv(")))
        {
            FnDecl f = Option::expect(get_fn(g, &r.name), "a lowered function");
            HashMap<String, Type> subst = subst_of(&f.type_params, &r.targs);
            Vec<ParamTid> tids = Vec::new();
            foreach (p in &f.params)
            {
                Type pty = apply(&p.ty, &subst);
                if (is_resource(g, &pty))
                {
                    Vec::push(
                        &mut tids,
                        ParamTid { .name = sprintf("p_%s", &san(&p.name)), .tid = type_id(g, &pty) },
                    );
                }
            }
            text = match (ground_native(&text, &tids))
            {
                Ok(t)  : t,
                Err(e) :
                {
                    set_unsupported(g, sprintf("a value in flight in `%s`: %s", &r.name, &e));
                    return unsupported_parts(g);
                },
            };
            if (StringView::contains(&text, "cb_send(") || StringView::contains(&text, "cb_recv("))
            {
                set_unsupported(g, sprintf("a value in flight in `%s`", &r.name));
                return unsupported_parts(g);
            }
        }
        // D-0315: a frame nothing binds into is not pushed.
        if (g.decided)
        {
            text = elide_empty_frames(&text);
        }
        pure = pure && !StringView::contains(&text, "struct cb_env_");
        Vec::push(&mut g.units, Unit { .text = text, .pure_std = pure });
    }
    // D-0219: each call's `ARRIVE_MARK` names the callee's `__arrive` twin
    // where it has one, and the callee itself where it has none.
    for (usize k = 0; k < Vec::len(&g.units); k += 1)
    {
        if (StringView::contains(&g.units[k].text, ARRIVE_MARK))
        {
            g.units[k].text = resolve_arrive(&g.units[k].text, &g.arrive_twins);
        }
    }
    // CHG-0436: a thunk whose type only one code can reach calls it.
    if (!boot(g, 1) && !g.lib)
    {
        g.thunks_out = single_target_thunks(g, &g.thunks_out);
    }
    if (StringView::contains(&g.thunks_out, ARRIVE_MARK))
    {
        g.thunks_out = resolve_arrive(&g.thunks_out, &g.arrive_twins);
    }
    if (!boot(g, 1))
    {
        // A program function's dispatcher inlined at its calls (`localize`).
        Vec<String> texts = Vec::new();
        foreach (u in &g.units)
        {
            Vec::push(&mut texts, String::clone(&u.text));
        }
        HashSet<String> sigs = replace(&mut g.inline_sigs, HashSet::new());
        localize(&mut texts, &mut g.protos, &sigs, &main_c);
        for (usize k = 0; k < Vec::len(&g.units); k += 1)
        {
            g.units[k].text = String::clone(&texts[k]);
        }
    }
    // Last, when no pass reads the text line by line any more.
    if (g.line_directives)
    {
        for (usize k = 0; k < Vec::len(&g.units); k += 1)
        {
            if (!g.units[k].pure_std && (StringView::contains(
                &g.units[k].text,
                "cb_at(",
            ) || StringView::contains(&g.units[k].text, "/*@line ")))
            {
                g.units[k].text = line_directives(&g.units[k].text, &g.files);
            }
        }
    }
    String descs = String::clone(&g.desc_aux);
    String::append(&mut descs, "static const cb_type cb_types[] = {\n");
    foreach (d in &g.descs)
    {
        match (d)
        {
            Some(s) : String::append(&mut descs, &sprintf("    %s,\n", s)),
            None    : String::append(&mut descs, "    {0},\n"),
        }
    }
    String::append(&mut descs, "    {0}\n};\n");
    String::append(&mut descs, "static const uint32_t cb_type_ids[] = {");
    foreach (id in &g.desc_ids)
    {
        String::append(&mut descs, &sprintf("%vu, ", *id));
    }
    String::append(&mut descs, "0};\n");
    String tail = String::new();
    String::append(&mut tail, "\n__thread struct cb_pos cb_at_pos = { CB_NOLOC, 0 };\n");
    String::append(
        &mut tail,
        "void cb_where(uint32_t *file, uint32_t *line) { *file = cb_at_pos.file; *line = cb_at_pos.line; }\n",
    );
    String::append(
        &mut tail,
        "void cb_set_where(uint32_t file, uint32_t line) { cb_at_pos.file = file; cb_at_pos.line = line; }\n",
    );
    String::append(&mut tail, "__thread uintptr_t cb_stack_floor = 0;\n");
    String::append(&mut tail, "void cb_set_stack_floor(uintptr_t floor) { cb_stack_floor = floor; }\n");
    String::append(&mut tail, "\nstatic const char *const cb_files[] = {");
    foreach (f in &g.files)
    {
        String::append(&mut tail, &sprintf("\"%s\", ", &c_escape(f)));
    }
    String::append(&mut tail, "0};\n");
    if (lib)
    {
        String header_text = lib_tail(g, &mut tail, &entry_c);
        return parts(g, descs, tail, header_text, "");
    }
    // `main` is called through a volatile pointer: called only from here,
    // GCC would take it as run once and compile its loops, and whatever it
    // inlines into them, for size (a constant divisor as a `div`).
    String call = if (main_u8)
    {
        sprintf("uint8_t (*volatile cb_main_fn)(void) = %s;\n    uint8_t cb_status = cb_main_fn();", &main_c)
    }
    else { sprintf("void (*volatile cb_main_fn)(void) = %s;\n    cb_main_fn();", &main_c) };
    String::append(
        &mut tail,
        &sprintf(
            "static void cb_program(void)\n{\n    cb_init(cb_files, %v, cb_types, %v, cb_type_ids);\n    cb_frame_push();\n    %s\n    cb_frame_pop();\n    cb_terminate_ok(%s);\n}\nint main(int argc, char **argv)\n{\n    cb_set_args(argc, argv);\n    cb_run_main(cb_program);\n}\n",
            Vec::len(&g.files),
            Vec::len(&g.descs),
            &call,
            if (main_u8) { "cb_status" } else { "0" }
        )
    );
    parts(g, descs, tail, String::new(), &main_c)
}

// ---- one function ----

export fn lower_fn(ref<Gen, exclusive> g, ref<FnRequest, shared> r)
{
    // The static pass checks the program's items and the `std` items they
    // reach; a `std` function the lowering itself asks for is checked now,
    // before it is lowered.
    if (!HashMap::contains(&g.prog.facts.checked_fns, &work_code(&r.name, &r.targs)))
    {
        match (check_more(&mut g.prog.table, &g.prog.front, &mut g.prog.facts, &r.name, &r.targs))
        {
            Ok(_)  : {},
            Err(d) : assert(false, "cobc: a function is lowered but does not check"),
        }
    }
    FnDecl f = Option::expect(get_fn(g, &r.name), "a requested function");
    lower_fn_decl(g, r, &f);
    give_fn(g, &r.name, f);
}

// `lower_fn` once the declaration is in hand (lent by `get_fn`, given back
// after).
fn lower_fn_decl(ref<Gen, exclusive> g, ref<FnRequest, shared> r, ref<FnDecl, shared> f)
{
    // Temporaries are numbered per function.
    g.uid = 0;
    String rkey = request_key(&r.name, &r.targs);
    String cname = if (r.mask == 0)
    {
        String::clone(Option::expect(HashMap::get(&g.fn_names, &rkey), "its C name"))
    }
    else
    {
        String::clone(Option::expect(HashMap::get(&g.variants, &sprintf("%s#%v", &rkey, r.mask)), "its C name"))
    };
    HashMap<String, Type> subst = subst_of(&f.type_params, &r.targs);
    Type ret = apply(&f.ret, &subst);
    String ret_c = reg_ctype(g, &ret);
    Vec<String> params_c = Vec::new();
    foreach (p in &f.params)
    {
        Type pty = apply(&p.ty, &subst);
        String pc = param_ctype(g, &pty);
        Vec::push(&mut params_c, sprintf("%s p_%s", &pc, &san(&p.name)));
    }
    String plist = if (Vec::len(&params_c) == 0) { "void" } else
    {
        String::join(
            &params_c,
            ", ",
        )
    };
    String sig = sprintf("%s %s(%s)", &ret_c, &cname, &plist);
    String::append(&mut g.protos, &sprintf("%s%s;\n", proto_attrs(&r.name), &sig));
    // A native body (D-0274 stage 5), where one exists.
    if (r.mask == 0 && lower_native(g, &r.name, f, &r.targs, &cname, &ret_c, &sig))
    {
        return;
    }
    if (r.mask == 0 && r.name != "main")
    {
        if (lower_fn_bodies(g, &r.name, f, &r.targs, &subst, &ret, &cname, &sig, &ret_c))
        {
            return;
        }
    }
    emit_fn_body(g, &r.name, f, &subst, &ret, &sig, &cname, r.mask, None);
    // D-0196: the `__raw` form beside it, for callers that bind its result
    // objectless.
    if (r.mask == 0 && Vec::len(&r.targs) == 0 && r.name != "main" && raw_ret_ok(g, &r.name))
    {
        usize open = Option::expect(StringView::find(&sig, "("), "a signature");
        String raw_cname = sprintf("%s__raw", &cname);
        String raw_sig = sprintf(
            "%s %s%v",
            &ret_c,
            &raw_cname,
            &sig[open..$],
        );
        String::appendf(&mut g.protos, "%s;\n", &raw_sig);
        g.uid = 0;
        g.pending_raw_ret = true;
        emit_fn_body(g, &r.name, f, &subst, &ret, &raw_sig, &raw_cname, 0, None);
    }
}

// Whether `t` is `StringView`.
fn is_plain_view_type(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(n) : Box::get(n).name == "std::StringView" && Vec::len(&Box::get(n).args) == 0,
        _               : false,
    }
}

// The body of `name` under the signature `sig` (C name `cname`); `mask`: the
// parameters given confined vectors (a variant); `direct` overrides which
// reference parameters are direct (a dual body's fast half).
export fn emit_fn_body(
    ref<Gen, exclusive> g,
    StringView name,
    ref<FnDecl, shared> f,
    ref<HashMap<String, Type>, shared> subst,
    ref<Type, shared> ret,
    ref<String, shared> sig,
    ref<String, shared> cname,
    u64 mask,
    Option<ref<HashSet<String>, shared>> direct,
)
{
    u32 h = 2166136261;
    foreach (b in StringView::as_bytes(cname))
    {
        h = wrapping_mul(h ^ widen<u32>(*b), 16777619);
    }
    g.closure_base = widen<u64>(h) << 24;
    // CHG-0368: the stage-4 analyses' answers (`COBC_DUMP_ANALYSES`).
    dump_analyses(g, name, f, subst);
    // D-0274: the bootstrap form keeps every local's object and check, so
    // these analyses are not made (stage 4).
    Vec<String> pnames = Vec::new();
    Vec<String> owned_vecs = Vec::new();
    foreach (p in &f.params)
    {
        Vec::push(&mut pnames, String::clone(&p.name));
        match (&p.ty)
        {
            Type::TNamed(n) :
            {
                if (Box::get(n).name == "std::Vec" && Vec::len(&Box::get(n).args) == 1)
                {
                    Vec::push(&mut owned_vecs, String::clone(&p.name));
                }
            },
            _               : {},
        }
    }
    HashSet<String> fn_bound = bound_names(&f.body);
    // `StringView` parameters the body never binds again: a part of one pins
    // nothing (`resolve_pinned`).
    HashSet<String> views = HashSet::new();
    foreach (p in &f.params)
    {
        if (is_plain_view_type(&apply(&p.ty, subst)) && !HashSet::contains(&fn_bound, &p.name))
        {
            HashSet::insert(&mut views, String::clone(&p.name));
        }
    }
    foreach (n in &pnames)
    {
        HashSet::insert(&mut fn_bound, String::clone(n));
    }
    HashSet<String> confined_names = HashSet::new();
    Objectless objectless_names = empty_objectless();
    HashMap<usize, HashSet<String>> objectless_fields = HashMap::new();
    HashSet<usize> elem_ref_ids = HashSet::new();
    HashSet<usize> quiet_ids = HashSet::new();
    if (!boot(g, 4))
    {
        confined_names = confined_vecs(g, &f.body, &pnames, &owned_vecs);
        // D-0286: a decided program's by-value resource parameters are
        // candidates too, each by its declaration (cobc: its address; cbc:
        // its index with `PARAM_BIT`).
        Vec<Cand> cands = Vec::new();
        if (g.decided)
        {
            for (usize pi = 0; pi < Vec::len(&f.params); pi += 1)
            {
                if (is_resource(g, &apply(&f.params[pi].ty, subst)))
                {
                    Vec::push(&mut cands, Cand { .name = String::clone(&f.params[pi].name), .id = param_cand_id(pi) });
                }
            }
        }
        objectless_names = objectless_strings_with(g, &f.body, &pnames, &cands, &mut objectless_fields);
        elem_ref_ids = elem_ref_lets(g, &f.body, &pnames);
        quiet_ids = quiet_locals(g, &f.body, &pnames, &elem_ref_ids);
    }
    // D-0292: a body whose references the run records: a library's or an
    // `--all-checks` program's every body, one the static pass left a
    // conflict in (`Items::tracking_needed`), or one with a point check
    // (D-0283). Every other body forms light references.
    bool tracked = false;
    {
        Vec<Type> targs_now = Vec::new();
        foreach (tp in &f.type_params)
        {
            match (HashMap::get(subst, tp))
            {
                Some(t) : Vec::push(&mut targs_now, clone(t)),
                None    : {},
            }
        }
        String bkey = body_key(name, &targs_now);
        tracked = g.lib || all_checks(g) || HashMap::contains(
            &g.prog.table.tracking_needed,
            &bkey,
        ) || HashSet::contains(
            &g.prog.table.point_check_fns,
            &bkey,
        );
    }
    Fx x = Fx {
        // cobc's `loc` reports no location for a prelude line: every line of
        // a `std` function's body (`in_prelude` decides by its first
        // statement, which may be a destructuring `let`).
        .std_body = StringView::starts_with(name, "std::"),
        .pc_site = None,
        .tracked = tracked,
        .objectless_fields = HashMap::new(),
        .inert_result = None,
        .inert_now = None,
        .out = String::new(),
        .ind = 1,
        .cleanup = Vec::new(),
        .scopes = Vec::new(),
        .ret = clone(ret),
        .notes = 0,
        .stmt_ind = HashMap::new(),
        .tl = 0,
        .root_frame = 0,
        .pinned = resolve_pinned(g, pinned_names(&f.body), &fn_bound, &views, false),
        .pinned_ws = resolve_pinned(g, pinned_names(&f.body), &fn_bound, &views, g.decided && !boot(g, 4)),
        .assigned = assigned_names(&f.body),
        .self_ref = None,
        .probes = HashMap::new(),
        .probing = 0,
        .probe_failed = false,
        .frame_line = None,
        .loops = Vec::new(),
        .loop_broken = Vec::new(),
        .rebind_frames = HashMap::new(),
        .obj_temps = HashSet::new(),
        .unstored = HashMap::new(),
        .holder_roots = HashMap::new(),
        .subst = clone(subst),
        .dollar = Vec::new(),
        .vec_index_exprs = HashMap::new(),
        .index_sugar = HashSet::new(),
        .place_write = false,
        .temp_root = false,
        .propagate_scrutinee = false,
        .stmt_match = false,
        .branch_scope = false,
        .fn_name = String::copy(name),
        .direct_params = HashSet::new(),
        .direct_refs = HashSet::new(),
        .direct_live = HashMap::new(),
        .pred_body = false,
        .unstored_params = HashSet::new(),
        .confined_params = HashMap::new(),
        .confined = HashSet::new(),
        .hoisted = HashMap::new(),
        .versions = Vec::new(),
        .guard_depth = 0,
        .const_locals = HashMap::new(),
        .mask_params = HashSet::new(),
        .self_tail_now = false,
        .tail_targets = Vec::new(),
        .tail_used = false,
        .unminted_binders = HashMap::new(),
        .inert_c = HashSet::new(),
        .names_undo = Vec::new(),
        .name_marks = 0,
        .raw_substring = None,
        .raw_call = None,
        .drop_lines = Vec::new(),
        .confined_names = HashSet::new(),
        .objectless_names = empty_objectless(),
        .elem_ref_ids = HashSet::new(),
        .quiet_ids = HashSet::new(),
        .held_locals = HashSet::new(),
        .callee_only = HashSet::new(),
        .notes_always = false,
        .notes_bottom = false,
        .s1_let = None,
        .s1_now = false,
        .pending_sub = false,
        .sub_frames = HashSet::new(),
        .pure_views = HashSet::new(),
        .objectless_c = HashSet::new(),
        .moved_flag = HashMap::new(),
        .cur_let = None,
        .held_c = HashSet::new(),
        .quiet_roots = HashSet::new(),
        .raw_ret = false,
        .raw_sinks = HashSet::new(),
        .raw_tail = None,
        .raw_arm = None,
        .raw_arm_last = false,
        .raw_arm_noted = false,
        .noted_pending = HashMap::new(),
        .stack_box = false,
        .stack_box_at = None,
        .raw_return_path = false,
        .objectless = false,
        .lit_inert = false,
        .bare_trims = HashSet::new(),
        .map_acc = None,
        .map_acc_used = false,
        .compound_elem = false,
        .elem_alias = HashMap::new(),
        .map_get_acc = None,
        .map_get_acc_out = None,
        .datum_tok = None,
        .datum_tok_out = None,
        .elem_mode = None,
        .elem_reader = false,
        .no_overflow = HashSet::new(),
        .proven_next = false,
        .fast_half = false,
        .entry_tested = false,
        .frozen_on = false,
        .field_confined = HashMap::new(),
        .pure_slices = HashSet::new(),
        .confined_fields = HashSet::new(),
        .read_confined = HashSet::new(),
    };
    Vec::push(&mut x.scopes, HashMap::new());
    push_frame_fn(g, &mut x, tracked);
    x.root_frame = g.nscope;
    // D-0309: the C names a self tail call in this body may jump for.
    match (fn_name(sig))
    {
        Some(cur) :
        {
            Vec::push(&mut x.tail_targets, String::copy(cur));
            if (mask == 0)
            {
                Option<StringView> base = match (StringView::strip_suffix(cur, "__dir"))
                {
                    Some(b) : Some(b),
                    None    : StringView::strip_suffix(cur, "__chk"),
                };
                match (base)
                {
                    Some(b) :
                    {
                        Vec::push(&mut x.tail_targets, String::copy(b));
                        Vec::push(&mut x.tail_targets, sprintf("%s__arrive", b));
                    },
                    None    : {},
                }
            }
        },
        None      : {},
    }
    x.confined_names = confined_names;
    x.objectless_names = objectless_names;
    x.objectless_fields = objectless_fields;
    x.elem_ref_ids = elem_ref_ids;
    x.quiet_ids = quiet_ids;
    if (!all_checks(g))
    {
        x.confined_fields = confined_fields(&f.body, &pnames);
        x.read_confined = read_confined_vecs(&f.body, &pnames);
    }
    x.fast_half = Option::is_some(&direct);
    x.entry_tested = replace(&mut g.pending_tested, false);
    bool bare = replace(&mut g.pending_bare, false);
    x.raw_ret = replace(&mut g.pending_raw_ret, false);
    // D-0286: every resource result of a decided program leaves as a
    // `__raw` form's does.
    if (g.decided && name != "main" && is_resource(g, ret))
    {
        x.raw_ret = true;
    }
    if (bare)
    {
        // The bare form: no dispatcher has tested its slices.
        x.fast_half = false;
    }
    match (replace(&mut g.pending_field_confined, None))
    {
        Some(fc) : x.field_confined = fc,
        None     : {},
    }
    x.direct_params = match (direct)
    {
        Some(d) : HashSet::clone(d),
        None    : direct_ref_params(g, f, subst),
    };
    x.unstored_params = unstored_ref_params(g, f, subst, &x.direct_params);
    x.frozen_on = g.frozen_mode;
    x.held_locals = if (boot(g, 4)) { HashSet::new() } else { held_locals(&f.body) };
    // D-0315 (step 4): the `fn` parameters the body only calls.
    if (g.decided && !boot(g, 4) && !calls_last_named(&f.body, last_name(name)))
    {
        foreach (fp in &f.params)
        {
            Type fpt = apply(&fp.ty, subst);
            bool is_fn = match (&fpt)
            {
                Type::TFn(_) : true,
                _            : false,
            };
            if (is_fn && callee_only(&f.body, &fp.name))
            {
                HashSet::insert(&mut x.callee_only, String::clone(&fp.name));
            }
        }
    }
    String key = String::copy(name);
    for (usize pi = 0; pi < Vec::len(&f.params); pi += 1)
    {
        bool slice_p = match (&f.params[pi].ty)
        {
            Type::TSlice(_) : true,
            _               : false,
        };
        if (slice_p && pure_direct(g, &key, pi))
        {
            HashSet::insert(&mut x.pure_slices, String::clone(&f.params[pi].name));
        }
    }
    if (bare)
    {
        // ... and none of its slices is received: the caller holds each one's
        // path (`lower_dual_bare_call`).
        foreach (p in &f.params)
        {
            Type pt = apply(&p.ty, subst);
            bool sl = match (&pt)
            {
                Type::TSlice(_) : true,
                _               : false,
            };
            if (sl)
            {
                HashSet::insert(&mut x.pure_slices, String::clone(&p.name));
            }
        }
    }
    for (usize pi = 0; pi < Vec::len(&f.params); pi += 1)
    {
        // D-0312: a probe parameter only where it is a view (a `String`
        // key's).
        Type pty = apply(&f.params[pi].ty, &x.subst);
        if (pure_view(g, &key, pi) && is_named(&pty, "std::StringView"))
        {
            HashSet::insert(&mut x.pure_views, String::clone(&f.params[pi].name));
        }
    }
    for (usize pj = 0; pj < Vec::len(&f.params); pj += 1)
    {
        ref<ParamDecl, shared> p = &f.params[pj];
        if (pj < 64 && ((mask >> narrow<u32>(pj)) & 1) != 0)
        {
            // A confined argument: no binding object; its uses reach the
            // vector through `p.p`.
            Type pty = apply(&p.ty, subst);
            Type inner = match (&pty)
            {
                Type::TRef(m) : clone(&Box::get(m).inner),
                _             :
                {
                    assert(false, "cobc: confined parameter of a non-reference type");
                    Type::TVoid
                },
            };
            Type elem = match (&inner)
            {
                Type::TNamed(n) : clone(&Box::get(n).args[0]),
                _               :
                {
                    assert(false, "cobc: confined parameter of a non-Vec type");
                    Type::TVoid
                },
            };
            String vec_c = ctype(g, &inner);
            String pc = sprintf("p_%s", &san(&p.name));
            // D-0292: its uses go through the parameter's own token:
            // recorded on arrival in a recording frame.
            if (x.tracked)
            {
                u32 itid = type_id(g, &inner);
                bool excl = match (&pty)
                {
                    Type::TRef(m) : Box::get(m).mode == Mode::Exclusive,
                    _             : false,
                };
                emit(
                    &mut x,
                    &sprintf(
                        "%s.tok = cb_rec_ref(%s.tok, %s.p, %vu, %s, 1u, CB_NOLOC, 0);",
                        &pc,
                        &pc,
                        &pc,
                        itid,
                        if (excl) { "CB_EXCLUSIVE" } else { "CB_SHARED" },
                    ),
                );
            }
            HashMap::insert(
                &mut x.confined_params,
                String::clone(&p.name),
                ConfinedVec { .c = sprintf(
                    "(*(%s *)%s.p)",
                    &vec_c,
                    &pc,
                ), .path = sprintf("%s.tok", &pc), .elem = elem },
            );
            HashSet::insert(&mut x.mask_params, String::clone(&p.name));
        }
        else
        {
            bind_param(g, &mut x, p, subst, pj);
        }
    }
    // D-0315 (step 4): after noted parameters, a sub-frame for the body.
    if (replace(&mut x.pending_sub, false))
    {
        push_sub_frame(g, &mut x);
    }
    V v = lower_block_body(g, &mut x, &f.body, Some(ret), None);
    if (is_never(&v.ty))
    {
        emit(&mut x, "__builtin_unreachable();");
    }
    else
    {
        emit_return(g, &mut x, v);
    }
    while (Vec::len(&x.cleanup) > 0)
    {
        end_diverged(&mut x);
    }
    String prologue = notes_finish(&mut x);
    // D-0274: in the bootstrap form no text pass elides anything.
    String body = if (boot(g, 1))
    {
        resolve_scopes(&x.out)
    }
    else
    {
        // D-0309: whether a self tail call's jump, past the stack check
        // (which cannot fail there: the frame is the one the check passed at
        // entry), meets a prologue that may read the location.
        Option<bool> tail_entry = None;
        if (x.tail_used)
        {
            HashSet<String> pure = name_set(LOCATION_PURE);
            bool reads = false;
            foreach (l in StringView::lines(&prologue))
            {
                if (reads_location(StringView::trim(l), &pure))
                {
                    reads = true;
                }
            }
            tail_entry = Some(reads);
        }
        text_passes(g, &drop_quiet_checks(&x.out, &x.quiet_roots), tail_entry)
    };
    // D-0077: a call too deep for the stack faults here, at the call. A body
    // that calls nothing cannot go deeper: its caller's check covers it.
    str check = if (!boot(g, 1) && calls_nothing(&body)) { "" } else { "    cb_stack_check();\n" };
    // D-0255: a parameter aligned beyond 16 bytes is copied at entry into an
    // aligned local, which the body uses under the parameter's name.
    String entry = String::new();
    String exit = String::new();
    foreach (p in &f.params)
    {
        Type pty = apply(&p.ty, subst);
        if (size_align(g, &pty).align <= 16)
        {
            continue;
        }
        String pc = sprintf("p_%s", &san(&p.name));
        String ct = param_ctype(g, &pty);
        String::appendf(&mut entry, "    %s %s__al = %s;\n#define %s %s__al\n", &ct, &pc, &pc, &pc, &pc);
        String::appendf(&mut exit, "#undef %s\n", &pc);
    }
    // D-0317 (cobc's `emit_fn_body`): a body whose requirement can fail reads
    // the caller's position first, before anything of its own can move it.
    if (StringView::contains(&body, "cb_rq_f"))
    {
        String::append(&mut entry, "    uint32_t cb_rq_f, cb_rq_l;\n    cb_where(&cb_rq_f, &cb_rq_l);\n");
    }
    // D-0077: a call too deep for the stack faults here, at the call.
    // D-0309: a self tail call's jump target, after the copies of
    // over-aligned parameters (which the body's assignments reach through
    // their `#define`) and the stack check (the frame is the one it passed at
    // entry), before the rest of the prologue.
    str label = if (x.tail_used) { "self_tail: ;\n" } else { "" };
    String::append(
        &mut g.fns,
        &sprintf("%s\n{\n%s%s%s%s%s%s}\n\n", sig, &entry, check, label, &prologue, &body, &exit),
    );
}

// D-0286: a by-value parameter's candidate id (`objectless_strings_with`,
// cobc: the `Param`'s address): its index with `PARAM_BIT`, apart from every
// expression's id and every arm's (`ARM_BIT`).
export const usize PARAM_BIT = 1 << 60;

export fn param_cand_id(usize pi) : usize
{
    (pi + 1) | PARAM_BIT
}

// The text passes after `drop_quiet_checks` (cobc's `dumped_text_passes`):
// D-0294: a decided program's records that nothing reads go first, then
// the scopes resolve knowing the program is decided (D-0285).
// `tail_entry`: `drop_dead_locations`'.
export fn text_passes(ref<Gen, shared> g, ref<String, shared> text, Option<bool> tail_entry) : String
{
    String z = fold_zero_tokens(text);
    String z2 = if (g.decided) { elide_record_chains(&z) } else { z };
    keep_push_headers(
        &version_loops(
            &elide_implied_checks(&drop_dead_locations(&resolve_scopes_using(&z2, if (g.decided) { &g.scope_sets_decided } else { &g.scope_sets }), g.line_directives, tail_entry)),
        ),
    )
}

// D-0269: the body is lowered. Its objectless locals' table (`cb_nt`, one
// entry per `objectless_bound`), declared at the body's start and registered
// with the runtime while threads run, so that a contained fault's unwind
// destroys the locals the body's own statements would have. Every exit of
// the root frame pops it. Nothing where the body bound no objectless local.
export fn notes_finish(ref<Fx, exclusive> x) : String
{
    if (x.notes == 0)
    {
        return String::new();
    }
    String out = String::new();
    foreach (line in StringView::lines(&x.out))
    {
        StringView t = StringView::trim_start(line);
        slice<u8, shared> tb = StringView::as_bytes(t);
        if (slice_len(tb) > 1 && tb[0] == 1)
        {
            // A scope marker: its kind, then its id up to `\x02` or the end.
            u8 kind = tb[1];
            usize e = 2;
            while (e < slice_len(tb) && tb[e] != 2)
            {
                e += 1;
            }
            StringView idv = &t[2..e];
            bool root = match (StringView::parse<u32>(idv))
            {
                Ok(id) : id == x.root_frame,
                Err(_) : false,
            };
            // D-0315 (step 4): a table registered on every call is popped by its
            // own entry below the root frame (`push_drop_under_root`).
            if ((kind == b'f' || kind == b'g') && root && !x.notes_bottom)
            {
                String::append(
                    &mut out,
                    &String::copy(&line[0..StringView::len(line) - StringView::len(t)]),
                );
                String::append(&mut out, "if (cb_nt_on) cb_notes_pop();\n");
            }
        }
        String::appendf(&mut out, "%v\n", line);
    }
    x.out = out;
    // D-0315 (step 4): on every call where a noted value's end is one a fault
    // must run and could observe (`notes_always`).
    str on = if (x.notes_always) { "1" } else { "cb_threaded" };
    // CHG-0440: the table is cleared only when it is registered. An entry is
    // written before it is read (`cb_notes_push` of one entry follows its
    // write), and an unregistered table is read by no one, so a call in a
    // thread-free run zeroes nothing.
    String p = sprintf(
        "    struct cb_note cb_nt[%v];\n    uint8_t cb_nt_on = %s;\n    if (cb_nt_on) cb_notes_push(memset(cb_nt, 0, sizeof cb_nt), %vu);\n",
        x.notes,
        on,
        x.notes,
    );
    // D-0315: the statement temporaries' flags (`stmt_temp_drop`).
    if (x.tl > 0)
    {
        String::appendf(&mut p, "    uint8_t cb_tl[%v] = {0};\n", x.tl);
    }
    p
}

// D-0200: an objectless local: its entry in the body's table, live from here
// until its drop has run; a moved flag where it may be moved away (`!id` in
// cobc's set).
export fn objectless_bound(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> cname,
    u32 tid,
    ref<Type, shared> ty,
)
{
    names_add(x, NameSet::ObjectlessC, String::clone(cname));
    bool moved = match (x.cur_let)
    {
        Some(id) : HashSet::contains(&x.objectless_names.moved, id),
        None     : false,
    };
    String drop = objectless_drop(g, cname, tid, ty);
    u32 k = x.notes;
    x.notes += 1;
    // D-0315 (step 4): a noted value has its own registration, at the depth
    // where it is bound, popped by its drop; a sub-frame follows its statement.
    bool s1 = replace(&mut x.s1_now, false);
    // (A noted value's entry and registration end first: its destructor may
    // fault, and the unwind must not run it again.)
    if (moved)
    {
        String fl = fresh(g, "mv");
        emit(x, &sprintf("uint8_t %s = 0;", &fl));
        emit(
            x,
            &sprintf("cb_nt[%v] = (struct cb_note){ (void *)&%s, &%s, %vu, 1 };", k, cname, &fl, tid),
        );
        if (s1)
        {
            push_drop(x, sprintf("cb_nt[%v].live = 0; cb_notes_pop(); if (!%s) { %s }", k, &fl, &drop));
        }
        else
        {
            push_drop(x, sprintf("if (!%s) { %s } cb_nt[%v].live = 0;", &fl, &drop, k));
        }
        names_put(x, NameMap::MovedFlag, String::clone(cname), fl);
    }
    else
    {
        emit(x, &sprintf("cb_nt[%v] = (struct cb_note){ (void *)&%s, 0, %vu, 1 };", k, cname, tid));
        if (s1)
        {
            push_drop(x, sprintf("cb_nt[%v].live = 0; cb_notes_pop(); %s", k, &drop));
        }
        else
        {
            push_drop(x, sprintf("%s cb_nt[%v].live = 0;", &drop, k));
        }
    }
    if (s1)
    {
        x.notes_always = true;
        emit(x, &sprintf("cb_notes_push(&cb_nt[%v], 1u);", k));
        x.pending_sub = true;
    }
}

// D-0315: an entry of `objectless_fields` on a value of `ty` (`=f` a field
// written, `~p` a path compared, `p` a path read: `f`, `f.g`, `f[].g`): allowed
// when what it reaches is plain data (or plain in a decided program), a quiet
// type written, or a `String` compared (cobc's `field_entry_ok`).
export fn field_entry_ok(ref<Gen, exclusive> g, ref<Fx, shared> x, ref<Type, shared> ty, ref<String, shared> f) : bool
{
    // `*whole`: matched by an arm binding the whole value; an enum's.
    if (*f == "*whole")
    {
        return match (ty)
        {
            Type::TNamed(n) : HashMap::contains(&g.prog.table.enums, &Box::get(n).name),
            _               : false,
        };
    }
    bool written = StringView::starts_with(f, "=");
    bool compared = !written && StringView::starts_with(f, "~");
    StringView path = if (written || compared) { &(*f)[1..$] } else { f };
    Type t = clone(ty);
    foreach (seg in StringView::split(path, "."))
    {
        usize cut = match (StringView::find(seg, "["))
        {
            Some(i) : i,
            None    : StringView::len(seg),
        };
        StringView name = &seg[0..cut];
        StringView rest = &seg[cut..$];
        Type next = match (&t)
        {
            Type::TNamed(n) :
            {
                match (struct_decl(g, &Box::get(n).name))
                {
                    Some(sd) :
                    {
                        HashMap<String, Type> sub = subst_of(&sd.type_params, &Box::get(n).args);
                        Option<Type> found = None;
                        foreach (fd in &sd.fields)
                        {
                            if (fd.name == name)
                            {
                                found = Some(apply(&fd.ty, &sub));
                            }
                        }
                        match (found)
                        {
                            Some(ft) : ft,
                            None     : return false,
                        }
                    },
                    None     : return false,
                }
            },
            _               : return false,
        };
        t = next;
        usize k = 0;
        while (k + 2 <= StringView::len(rest))
        {
            Type elem = match (&t)
            {
                Type::TNamed(n) :
                {
                    if (Box::get(n).name == "std::Vec" && Vec::len(&Box::get(n).args) == 1)
                    {
                        clone(&Box::get(n).args[0])
                    }
                    else
                    {
                        return false;
                    }
                },
                _               : return false,
            };
            t = elem;
            k += 2;
        }
    }
    bool plain = (plain_data(g, &t) && !has_refs(g, &t) && !holds_fn(g, &t)) || (g.decided && decided_plain(g, &t));
    plain || (written && quiet_ty(&g.prog.table, &t)) || (compared && is_string_ty(&t))
}

// D-0315: a decided body's temporary `cname` of a type whose end frees memory
// alone, made by the innermost statement in that statement's own C block, ends
// with the statement: by a C drop where it ends or a jump leaves it, with no
// object, noted in the body's table (D-0269). False where the innermost scope
// is not such a statement (cobc's `stmt_temp_drop`).
// D-0315 (step 4): `noted`, a type with a destructor of its own: its entry is
// registered where it is made and removed (`cb_notes_drop`) where it ends,
// before its destructor runs.
export fn stmt_temp_drop(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> cname,
    u32 tid,
    ref<Type, shared> ty,
    bool noted,
) : bool
{
    // Under the statement's own temporaries' drops, made before this one.
    usize n = Vec::len(&x.cleanup);
    while (n > 0 && is_cdrop(&x.cleanup[n - 1]))
    {
        n -= 1;
    }
    if (n == 0)
    {
        return false;
    }
    u32 id = match (x.cleanup[n - 1])
    {
        Cleanup::CStmt(id) : id,
        _                  : return false,
    };
    bool here = match (HashMap::get(&x.stmt_ind, id))
    {
        Some(i) : *i == x.ind,
        None    : false,
    };
    if (!here)
    {
        return false;
    }
    String drop = objectless_drop(g, cname, tid, ty);
    u32 k = x.notes;
    x.notes += 1;
    // Its flag (`cb_tl`, zero at entry): only where it was made is it dropped,
    // since a short-circuit operand or a branch of the statement may have
    // passed it by.
    u32 j = x.tl;
    x.tl += 1;
    emit(x, &sprintf("cb_nt[%v] = (struct cb_note){ (void *)&%s, 0, %vu, 1 };", k, cname, tid));
    emit(x, &sprintf("cb_tl[%v] = 1;", j));
    u32 d = narrow<u32>(Vec::len(&x.drop_lines));
    if (noted)
    {
        x.notes_always = true;
        HashMap::insert(&mut x.noted_pending, String::clone(cname), NotedPend { .k = k, .j = j });
        emit(x, &sprintf("cb_notes_push(&cb_nt[%v], 1u);", k));
        Vec::push(
            &mut x.drop_lines,
            sprintf("if (cb_tl[%v]) { cb_nt[%v].live = 0; cb_notes_drop(&cb_nt[%v]); %s } cb_tl[%v] = 0;", j, k, k, &drop, j),
        );
    }
    else
    {
        Vec::push(
            &mut x.drop_lines,
            sprintf("if (cb_tl[%v]) { %s } cb_tl[%v] = 0; cb_nt[%v].live = 0;", j, &drop, j, k),
        );
    }
    Vec::push(&mut x.cleanup, Cleanup::CDrop(d));
    true
}

// D-0315 (step 4): whether the `fn` parameter `j` of `key` does not escape its
// body (cobc's `fn_param_noescape`; a cycle answers no).
export fn fn_param_noescape(ref<Gen, exclusive> g, ref<String, shared> key, usize j) : bool
{
    String k = sprintf("%s#%v", key, j);
    match (HashMap::get(&g.noescape, &k))
    {
        Some(r) : return *r,
        None    : {},
    }
    HashMap::insert(&mut g.noescape, String::clone(&k), false);
    bool r = fn_param_noescape_in(g, key, j);
    HashMap::insert(&mut g.noescape, k, r);
    r
}

fn fn_param_noescape_in(ref<Gen, exclusive> g, ref<String, shared> key, usize j) : bool
{
    FnDecl f = match (get_fn(g, key))
    {
        Some(f) : f,
        None    : return false,
    };
    if (j >= Vec::len(&f.params) || !is_fn_type(&f.params[j].ty))
    {
        return false;
    }
    XUses u = x_uses(&f.body, &f.params[j].name);
    bool passed_ok = true;
    foreach (at in &u.at)
    {
        usize sp = Option::expect(StringView::find(at, " "), "a pass");
        usize i = 0;
        foreach (ch in StringView::as_bytes(&at[0..sp]))
        {
            i = i * 10 + narrow<usize>(*ch - b'0');
        }
        String gname = String::copy(&at[sp + 1..$]);
        if (!HashMap::contains(&g.prog.table.fns, &gname))
        {
            gname = sprintf("std::%s", &gname);
        }
        if (passed_ok && !fn_param_noescape(g, &gname, i))
        {
            passed_ok = false;
        }
    }
    u.mentions > 0 && passed_ok && u.mentions == u.calls + u.passes
}

// D-0315 (step 4): a pending noted temporary taken by its consumer (cobc's
// `noted_take`).
export fn noted_take(ref<Fx, exclusive> x, ref<String, shared> c)
{
    match (HashMap::remove(&mut x.noted_pending, c))
    {
        Some(np) : emit(x, &sprintf("cb_nt[%v].live = 0; cb_notes_drop(&cb_nt[%v]); cb_tl[%v] = 0;", np.k, np.k, np.j)),
        None     : {},
    }
}

// D-0315 (step 4): an inert value with a destructor of its own that more of its
// statement runs after before its consumer takes it: a noted temporary until
// then, else an object (cobc's `noted_pend`).
export fn noted_pend(ref<Gen, exclusive> g, ref<Fx, exclusive> x, V t, usize line) : V
{
    u32 tid = type_id(g, &t.ty);
    names_add(x, NameSet::InertC, String::clone(&t.c));
    if (stmt_temp_drop(g, x, &t.c, tid, &t.ty, true))
    {
        return t;
    }
    Option<String> o = materialize(g, x, &t, line);
    names_drop(x, NameSet::InertC, &t.c);
    V { c, ty, obj } = t;
    drop(obj);
    V { .c = c, .ty = ty, .obj = o }
}

// D-0315 (step 4): `e` evaluates nothing that could fault or run a destructor
// (cobc's `harmless`).
export fn harmless(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e) : bool
{
    ref<Expr, shared> s = strip_parens(e);
    match (&s.kind)
    {
        ExprKind::EInt(_)       : true,
        ExprKind::EFloat(_)     : true,
        ExprKind::EStr(_)       : true,
        ExprKind::EBool(_)      : true,
        ExprKind::EPath(p)      :
        {
            if (Vec::len(&Box::get(p).segs) == 1)
            {
                match (lookup_ref(x, &Box::get(p).segs[0]))
                {
                    Some(b) : return !is_resource(g, &b.ty) && !has_refs(g, &b.ty) && !HashMap::contains(&x.moved_flag, &b.c),
                    None    : {},
                }
            }
            literal_expr(g, x, s)
        },
        ExprKind::ECall(c)      : Vec::len(&Box::get(c).args) == 0 && empty_ctor(g, x, &Box::get(c).callee),
        ExprKind::EStructLit(l) :
        {
            foreach (fi in &Box::get(l).fields)
            {
                if (!harmless(g, x, &fi.value))
                {
                    return false;
                }
            }
            true
        },
        _                       : false,
    }
}

// D-0200: an objectless local's drop: for a `String` or a `Vec` of plain
// elements, its buffer freed at once (`cb_drop_plain_buf`), else
// `cb_drop_local`'s general path. (cobc finds the type by its id; it is `ty`.)
export fn objectless_drop(ref<Gen, exclusive> g, ref<String, shared> cname, u32 tid, ref<Type, shared> ty) : String
{
    match (ty)
    {
        Type::TNamed(n) :
        {
            ref<NamedTy, shared> nt = Box::get(n);
            if (nt.name == "std::String" && Vec::len(&nt.args) == 0)
            {
                return sprintf(
                    "cb_drop_plain_buf(&%s, %vu, (void *)%s.bytes.ptr, %s.bytes.cap);",
                    cname,
                    tid,
                    cname,
                    cname,
                );
            }
            if (nt.name == "std::Vec" && Vec::len(&nt.args) == 1 && plain_data(g, &nt.args[0]))
            {
                SizeAlign sa = size_align(g, &nt.args[0]);
                if (sa.size > 0 && sa.align <= 16)
                {
                    return sprintf(
                        "cb_drop_plain_buf(&%s, %vu, (void *)%s.ptr, %s.cap * %vu);",
                        cname,
                        tid,
                        cname,
                        cname,
                        sa.size,
                    );
                }
                return sprintf("cb_drop_local(&%s, %vu);", cname, tid);
            }
        },
        _               : {},
    }
    // D-0315: its drop glue (`drop_glue`), which asks of each buffer whether
    // an object lies over it (CHG-0427).
    match (drop_glue(g, ty))
    {
        Some(gl) : return sprintf("%s(&%s, 0u);", &gl, cname),
        None     : {},
    }
    sprintf("cb_drop_local(&%s, %vu);", cname, tid)
}

// A use of the objectless local `cname`: stale once moved away.
export fn objectless_use(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<String, shared> cname, usize line)
{
    match (HashMap::get(&x.moved_flag, cname))
    {
        Some(f) :
        {
            String fl = String::clone(f);
            String lc = loc(g, x.std_body, line);
            emit(x, &sprintf("if (%s) cb_fault(\"diag.stale-binding\", %s);", &fl, &lc));
        },
        None    : {},
    }
}

// Whether the `let` whose initializer is `id` binds a `ty` objectless: a
// candidate, indexed only as a `Vec` of plain data, compared only as a
// `String` (cobc's `objectless_binding`).
export fn objectless_binding(ref<Gen, exclusive> g, ref<Fx, exclusive> x, usize id, ref<Type, shared> ty) : bool
{
    bool is_string = is_string_ty(ty);
    // D-0315: in a decided program, also one whose elements' end frees memory
    // alone (`x[i]` is `*Vec::index_*(&x, i)`, `&x` its address).
    bool plain_vec = match (ty)
    {
        Type::TNamed(n) :
        {
            Box::get(n).name == "std::Vec" && Vec::len(&Box::get(n).args) == 1 && ((plain_data(g, &Box::get(n).args[0]) && !has_refs(
                g,
                &Box::get(n).args[0],
            ) && !holds_fn(g, &Box::get(n).args[0])) || (g.decided && objectless_type(g, &Box::get(n).args[0])))
        },
        _               : false,
    };
    // D-0286: a field read by value is plain data (no field is moved out).
    // D-0294: a field written (`=f`) is plain data or of a quiet type, whose
    // old value the write destroys (`lower_assign`).
    // D-0315: by each entry's whole path (`field_entry_ok`).
    bool fields_plain = match (HashMap::get(&x.objectless_fields, id))
    {
        Some(fs) :
        {
            bool all = true;
            foreach (f in fs)
            {
                all = all && field_entry_ok(g, x, ty, f);
            }
            all
        },
        None     : true,
    };
    // D-0294: assigned whole (`id | 4`) only as a quiet type.
    bool assigned_ok = !HashSet::contains(&x.objectless_names.assigned, id) || quiet_ty(&g.prog.table, ty);
    HashSet::contains(
        &x.objectless_names.ids,
        id,
    ) && fields_plain && assigned_ok && (!HashSet::contains(
        &x.objectless_names.indexed,
        id,
    ) || plain_vec) && (is_string || ((objectless_type(g, ty) || (s1_let_is(x, id) && noted_type(g, ty))) && !HashSet::contains(
        &x.objectless_names.compared,
        id,
    )))
}

// D-0315 (step 4): whether `id` is the `let` whose binder may be a noted value
// (cobc's `s1_let == Some(id)`).
fn s1_let_is(ref<Fx, shared> x, usize id) : bool
{
    match (x.s1_let)
    {
        Some(l) : l == id,
        None    : false,
    }
}

// D-0315: a value of a decided program that is plain data there (no resource,
// no `fn` value, not a reference): a pinned local of it needs no object
// (cobc's `pinned_plain`).
// D-0315: a reference in a decided program: its token is 0 and no path is
// kept, so a binding of one needs no object (cobc's `decided_ref`).
export fn decided_ref(ref<Gen, exclusive> g, ref<Type, shared> ty) : bool
{
    g.decided && match (ty)
    {
        Type::TRef(_) : true,
        _             : false,
    }
}

export fn pinned_plain(ref<Gen, exclusive> g, ref<Type, shared> ty) : bool
{
    bool reference = match (ty)
    {
        Type::TRef(_) : true,
        _             : false,
    };
    g.decided && !is_resource(g, ty) && !holds_fn(g, ty) && !reference && !is_closure(ty) && (plain_data(g, ty) || decided_plain(g, ty))
}

// D-0315: a slice in a decided program: plain data there, so it never needs
// an object (cobc's `plain_slice`).
export fn plain_slice(ref<Gen, shared> g, ref<Type, shared> t) : bool
{
    g.decided && match (t)
    {
        Type::TSlice(_) : true,
        _               : false,
    }
}

// `into_temp`'s C name alone (the rest of the value only ends: taken apart,
// it needs no object, CHG-0440).
export fn into_temp_c(ref<Gen, exclusive> g, ref<Fx, exclusive> x, V v, usize line) : String
{
    V { c, ty, obj } = into_temp(g, x, v, line);
    c
}

// A value in a named C local; a reference as a `cb_ref`; a value that needs
// an object gets one (or keeps the one it has).
export fn into_temp(ref<Gen, exclusive> g, ref<Fx, exclusive> x, V v, usize line) : V
{
    if (is_never(&v.ty) || is_void(&v.ty))
    {
        return v;
    }
    match (&v.ty)
    {
        Type::TRef(_) :
        {
            String t = fresh(g, "r");
            emit(x, &sprintf("cb_ref %s = %s;", &t, &v.c));
            return V { .c = t, .ty = clone(&v.ty), .obj = None };
        },
        _             : {},
    }
    if (Option::is_some(&v.obj) && HashSet::contains(&x.obj_temps, &v.c))
    {
        return v;
    }
    String t = fresh(g, "t");
    String c = ctype(g, &v.ty);
    emit(x, &sprintf("%s %s = %s;", &c, &t, &v.c));
    if (Option::is_none(&v.obj) && HashSet::contains(&x.inert_c, &v.c))
    {
        names_add(x, NameSet::InertC, String::clone(&t));
        return V { .c = t, .ty = clone(&v.ty), .obj = None };
    }
    Option<String> obj = None;
    if (is_resource(g, &v.ty))
    {
        String o = Option::expect(clone(&v.obj), "a resource value without an object");
        emit(x, &sprintf("cb_move_to(%s, &%s);", &o, &t));
        obj = Some(o);
    }
    else if (has_refs(g, &v.ty))
    {
        u32 tid = type_id(g, &v.ty);
        match (&v.obj)
        {
            Some(o) :
            {
                emit(x, &sprintf("cb_move_to(%s, &%s);", o, &t));
                obj = Some(String::clone(o));
            },
            None    :
            {
                if (!plain_slice(g, &v.ty))
                {
                    String lc = loc(g, x.std_body, line);
                    emit(x, &sprintf("cb_copy_datum(&%s, &(%s), %vu);", &t, &v.c, tid));
                    String o = fresh(g, "o");
                    emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &t, tid, &lc));
                    obj = Some(o);
                }
            },
        }
    }
    if (Option::is_some(&obj))
    {
        names_add(x, NameSet::ObjTemps, String::clone(&t));
    }
    V { .c = t, .ty = clone(&v.ty), .obj = obj }
}

// A temporary that is a resource or holds references gets an object.
export fn register_temp(ref<Gen, exclusive> g, ref<Fx, exclusive> x, String t, Type ty, usize line) : V
{
    Option<String> obj = None;
    if (is_resource(g, &ty) || (has_refs(g, &ty) && !plain_slice(g, &ty)))
    {
        u32 tid = type_id(g, &ty);
        String lc = loc(g, x.std_body, line);
        String o = fresh(g, "o");
        emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &t, tid, &lc));
        names_add(x, NameSet::ObjTemps, String::clone(&t));
        obj = Some(o);
    }
    V { .c = t, .ty = ty, .obj = obj }
}

// The token a reference slot holds: loaded, or, for an unstored binding,
// the one it came with.
export fn slot_tok(ref<Fx, shared> x, ref<String, shared> slot) : String
{
    match (HashMap::get(&x.unstored, slot))
    {
        Some(t) : String::clone(t),
        None    : sprintf("cb_load_ref(&%s)", slot),
    }
}

export fn read_ref_slot(ref<Fx, shared> x, ref<String, shared> slot, ref<Type, shared> ty) : V
{
    V { .c = sprintf("((cb_ref){ %s, %s })", slot, &slot_tok(x, slot)), .ty = clone(ty), .obj = None }
}

export fn emit_return(ref<Gen, exclusive> g, ref<Fx, exclusive> x, V v)
{
    if (is_never(&v.ty))
    {
        return;
    }
    Option<String> hold = None;
    if (!is_void(&x.ret))
    {
        V t = into_temp(g, x, v, 0);
        // The resource or reference data goes in flight first.
        Type ret = clone(&x.ret);
        if (is_resource(g, &ret))
        {
            // D-0286: so does every result in a decided program.
            bool raw = x.raw_ret || g.decided;
            match (&t.obj)
            {
                // D-0200: a `__raw` form's result leaves with no object: the
                // caller binds it objectless.
                Some(o) :
                {
                    if (raw)
                    {
                        emit(x, &sprintf("cb_forget_obj(%s);", o));
                    }
                    else
                    {
                        emit(x, &sprintf("cb_send(%s);", o));
                    }
                },
                None    : assert(raw, "cobc: a resource result without an object"),
            }
        }
        else if (match (&ret)
        {
            Type::TRef(_) : true,
            _             : false,
        })
        {
            emit(x, &sprintf("cb_send_ref(%s.tok);", &t.c));
        }
        else if (has_refs(g, &ret))
        {
            u32 tid = type_id(g, &ret);
            emit(x, &sprintf("cb_send_datum(&%s, %vu);", &t.c, tid));
        }
        hold = Some(String::clone(&t.c));
    }
    emit_unwind_to(x, 0);
    match (hold)
    {
        Some(t) : emit(x, &sprintf("return %s;", &t)),
        None    : emit(x, "return;"),
    }
}

// D-0111 `[Ref-Binding-Last-Use]`: after `s`, each local reference, slice
// or `StringView` binding of this block the checker ended there ends as at
// the block's exit (its object, and the path it holds).
export fn end_ref_bindings(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Stmt, shared> s)
{
    Vec<String> names = match (HashMap::get(&g.prog.facts.early_ends, stmt_key(s)))
    {
        Some(v) : clone(v),
        None    : return,
    };
    foreach (n in &names)
    {
        usize top = Vec::len(&x.scopes) - 1;
        Binding b = match (HashMap::get(&x.scopes[top], n))
        {
            Some(bd) : clone(bd),
            None     : continue,
        };
        bool is_ref = ends_at_last_use(&g.prog.table, &b.ty);
        if (HashSet::contains(&x.held_c, &b.c))
        {
            // A held local (`cb_frame_hold`): its frame lets go now.
            match (HashMap::get(&x.unstored, &b.c))
            {
                Some(tk) :
                {
                    String t = String::clone(tk);
                    emit(x, &sprintf("cb_frame_unhold(%s);", &t));
                },
                None     : {},
            }
            continue;
        }
        String root = if (StringView::len(&b.root) == 0)
        {
            match (HashMap::get(&x.holder_roots, &b.c))
            {
                Some(r) : String::clone(r),
                None    : String::new(),
            }
        }
        else
        {
            String::clone(&b.root)
        };
        // D-0315 (step 4): a root of token 0 (a decided program's reference
        // binding) has nothing to end.
        if (!is_ref || StringView::len(&root) == 0 || root == "0")
        {
            continue;
        }
        emit(x, &sprintf("cb_end_binding(%s);", &root));
    }
}

// `S { a, b: c, .. } = e;`: each field becomes its own binding
// ([Relocate-Out]); the container ends without destroying what moved out.
export fn lower_destructure(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<DestructureStmt, shared> d) : bool
{
    // D-0315: a decided program's call result destructured is taken with no
    // object (`arm_inert`).
    arm_inert(g, x, &d.init, true);
    // And an objectless local destructured, with none.
    x.raw_return_path = g.decided && match (&strip_parens(&d.init).kind)
    {
        ExprKind::EPath(_) : true,
        _                  : false,
    };
    V v = lower_expr(g, x, &d.init, None);
    x.inert_result = None;
    x.raw_return_path = false;
    if (is_never(&v.ty))
    {
        return true;
    }
    NamedTy nt = match (&v.ty)
    {
        Type::TNamed(n) : clone(Box::get(n)),
        _               :
        {
            assert(false, "cobc: destructuring a non-struct");
            return false;
        },
    };
    StructDecl sd = Option::expect(struct_decl(g, &nt.name), "struct");
    HashMap<String, Type> sub = subst_of(&sd.type_params, &nt.args);
    // D-0315: a value with no object (an objectless binding moved, an inert
    // call result) stays so: every field moves out to a binder (a named one
    // or `$rest_f`).
    V whole = if (g.decided && Option::is_none(&v.obj) && is_resource(g, &v.ty) && objectless_type(g, &v.ty))
    {
        String t = fresh(g, "t");
        String wc = ctype(g, &v.ty);
        emit(x, &sprintf("%s %s = %s;", &wc, &t, &v.c));
        V { .c = t, .ty = clone(&v.ty), .obj = None }
    }
    else
    {
        into_temp(g, x, v, d.init.line)
    };
    Vec<String> decl_names = Vec::new();
    foreach (f in &sd.fields)
    {
        Vec::push(&mut decl_names, String::clone(&f.name));
    }
    Vec<NamePair> pairs = destructure_pairs(&d.names, &d.fields, d.rest, &decl_names);
    foreach (pr in &pairs)
    {
        usize k = 0;
        while (sd.fields[k].name != pr.field)
        {
            k += 1;
        }
        Type fty = apply(&sd.fields[k].ty, &sub);
        String cname = sprintf("l_%s_%s", &san(&pr.binder), &fresh(g, ""));
        String c = ctype(g, &fty);
        emit(x, &sprintf("%s %s;", &c, &cname));
        V fv0 = V { .c = sprintf("%s.%s", &whole.c, &san(&pr.field)), .ty = clone(&fty), .obj = None };
        V fv = match (&fty)
        {
            Type::TRef(_) : read_ref_slot(x, &fv0.c, &fty),
            _             : fv0,
        };
        // D-0315: a binder `objectless_strings` found a candidate, of a type
        // whose end frees memory alone: no object.
        Option<usize> key = None;
        for (usize j = 0; j < Vec::len(&d.fields) && Option::is_none(&key); j += 1)
        {
            if (d.fields[j] == pr.binder)
            {
                key = Some(destructure_key(d, j));
            }
        }
        // A field `..` passed over (`$rest_f`, which nothing names) likewise,
        // with no moved flag.
        bool hidden = StringView::starts_with(&pr.binder, "$rest_") && g.decided && x.probing == 0 && is_resource(g, &fty) && !has_refs(g, &fty) && objectless_type(g, &fty);
        bool bare = hidden || match (key)
        {
            Some(kk) : g.decided && x.probing == 0 && is_resource(g, &fty) && objectless_binding(g, x, kk, &fty),
            None     : false,
        };
        if (bare)
        {
            store(g, x, &cname, &fty, &fv);
            u32 btid = type_id(g, &fty);
            Option<usize> saved = replace(&mut x.cur_let, if (hidden) { None } else { key });
            objectless_bound(g, x, &cname, btid, &fty);
            x.cur_let = saved;
            bind_in_scope(x, &pr.binder, Binding { .c = cname, .ty = fty, .root = String::new(), .kind = BindKind::Local });
            continue;
        }
        if (is_resource(g, &fty))
        {
            store(g, x, &cname, &fty, &fv);
            u32 tid = type_id(g, &fty);
            String lc = loc(g, x.std_body, d.init.line);
            String o = fresh(g, "o");
            emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &cname, tid, &lc));
            String root = fresh(g, "root");
            emit(x, &sprintf("uint64_t %s = cb_bind(%s);", &root, &o));
            note_frame(g, x, &pr.binder, &root);
            bind_in_scope(
                x,
                &pr.binder,
                Binding { .c = cname, .ty = fty, .root = root, .kind = BindKind::Local },
            );
        }
        else
        {
            bind_value(g, x, &pr.binder, cname, &fty, &fv, d.init.line);
        }
    }
    match (&whole.obj)
    {
        Some(o) : emit(x, &sprintf("cb_end_moved_out(%s);", o)),
        None    : {},
    }
    false
}

export fn lower_block_body(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Block, shared> b,
    Option<ref<Type, shared>> expected,
    Option<ref<Sink, shared>> sink,
) : V
{
    Vec::push(&mut x.scopes, HashMap::new());
    V result = unit();
    Vec<String> aliases = Vec::new();
    Vec<String> bare_unlocks = Vec::new();
    bool skip_next = false;
    for (usize si = 0; si < Vec::len(&b.stmts); si += 1)
    {
        if (replace(&mut skip_next, false))
        {
            continue;
        }
        ref<Stmt, shared> st = &b.stmts[si];
        match (stmt_line(st))
        {
            Some(l) : at(g, x, l),
            None    : {},
        }
        // `p op= e` with a call in `p` (D-0035) is `{ auto t = &mut p; *t =
        // *t op e; }`. With `e` a literal or a local, the two statements are
        // lowered as one, `t`'s uses through the borrow's token.
        if (si + 1 < Vec::len(&b.stmts))
        {
            match (compound_pair(g, x, b, si))
            {
                Some(d) :
                {
                    if (d)
                    {
                        end_diverged(x);
                        result = never();
                        break;
                    }
                    skip_next = true;
                    continue;
                },
                None    : {},
            }
        }
        // D-0202 phase 4: `auto g = lock(m);` used only through `*g` / `g.f…`
        // (`bare_guard_let`): the mutex taken and given back by the book.
        match (bare_guard_let(st, b, si + 1))
        {
            Some(bg) :
            {
                if (lower_bare_guard(g, x, &bg.name, &bg.marg, bg.line, &mut bare_unlocks))
                {
                    continue;
                }
            },
            None     : {},
        }
        // A named reference to an element of a confined vector
        // (`elem_ref_let`): the element's address, unchecked.
        match (elem_ref_let(st, b, si + 1))
        {
            Some(er) :
            {
                match (bind_elem_ref(g, x, &er.name, &er.place, er.mode, stmt_line(st)))
                {
                    Some(true)  :
                    {
                        end_diverged(x);
                        result = never();
                        break;
                    },
                    Some(false) : continue,
                    None        : {},
                }
            },
            None     : {},
        }
        Option<ref<Stmt, shared>> next = if (si + 1 < Vec::len(&b.stmts)) { Some(&b.stmts[si + 1]) } else { None };
        match (foreach_alias(g, x, st, next))
        {
            Some(fa) :
            {
                ForeachAlias { name, alias } = fa;
                HashMap::insert(&mut x.elem_alias, String::clone(&name), alias);
                Vec::push(&mut aliases, name);
                continue;
            },
            None     : {},
        }
        push_stmt_at(g, x, stmt_line(st));
        // D-0315 (step 4): this `let`'s binder may be a noted value (the
        // enclosing statement's again after it).
        Option<usize> s1_outer = x.s1_let;
        x.s1_let = match (st)
        {
            Stmt::SLet(sl) :
            {
                match (&Box::get(sl).init)
                {
                    Some(se) : if (g.decided && !boot(g, 4)) { Some(se.id) } else { None },
                    None     : None,
                }
            },
            _              : None,
        };
        bool diverged = lower_stmt(g, x, st);
        x.s1_let = s1_outer;
        if (diverged)
        {
            x.pending_sub = false;
            end_diverged(x);
            result = never();
            break;
        }
        pop_stmt(x);
        if (replace(&mut x.pending_sub, false))
        {
            push_sub_frame(g, x);
        }
        end_ref_bindings(g, x, st);
        // A quiet local's root (`quiet_locals`), for `drop_quiet_checks`.
        match (st)
        {
            Stmt::SLet(ql) :
            {
                match (&Box::get(ql).init)
                {
                    Some(qi) :
                    {
                        if (HashSet::contains(&x.quiet_ids, qi.id))
                        {
                            match (lookup(x, &Box::get(ql).name))
                            {
                                Some(bd) :
                                {
                                    bool local = match (&bd.kind)
                                    {
                                        BindKind::Local : true,
                                        _               : false,
                                    };
                                    if (local && StringView::len(&bd.root) > 0)
                                    {
                                        HashSet::insert(&mut x.quiet_roots, String::clone(&bd.root));
                                    }
                                },
                                None     : {},
                            }
                        }
                    },
                    None     : {},
                }
            },
            _              : {},
        }
        // `$c = &v` or `&mut v` of a `foreach` whose body only reads or
        // writes its elements in place: `$c` holds `v` for the whole loop
        // (`confine_holder`); and a held shared reference to a `Vec` only
        // read through (`held_vec_reader`).
        match (st)
        {
            Stmt::SLet(l) :
            {
                match (&Box::get(l).init)
                {
                    Some(init) :
                    {
                        if (boot(g, 7))
                        {
                            // D-0274: no holder is confined in the bootstrap form.
                        }
                        else if (foreach_reads_only(&Box::get(l).name, init, b))
                        {
                            confine_holder(g, x, &Box::get(l).name);
                        }
                        else if (held_vec_reader(g, x, &Box::get(l).name, init, b, si))
                        {
                            confine_holder(g, x, &Box::get(l).name);
                        }
                    },
                    None       : {},
                }
            },
            _             : {},
        }
    }
    if (!is_never(&result.ty))
    {
        match (&b.tail)
        {
            Some(t) :
            {
                ref<Expr, shared> te = Box::get(t);
                at(g, x, te.line);
                push_stmt_at(g, x, Some(te.line));
                // A tail `match` is its statement's last evaluation, as a
                // statement `match` is.
                x.stmt_match = is_match(te);
                // D-0200: a `__raw` form's last `match` (`raw_tail`), or a
                // local named alone (`raw_return_path`).
                // D-0286: in a decided program, a raw sink's block (a `__raw`
                // form's last block, `unsafe { … }` say) ends the same way.
                bool raw_sink = g.decided && match (&sink)
                {
                    Some(sk) : match (&sk.ov)
                    {
                        Some(o) : HashSet::contains(&x.raw_sinks, o),
                        None    : false,
                    },
                    None : false,
                };
                if ((Option::is_none(&sink) && x.raw_ret) || raw_sink)
                {
                    match (&strip_parens(te).kind)
                    {
                        ExprKind::EMatch(m)   : x.raw_tail = arms_key(&Box::get(m).arms),
                        ExprKind::EBlock(ib)  :
                        {
                            if (g.decided)
                            {
                                x.raw_tail = Some(block_id(ib));
                            }
                        },
                        ExprKind::EUnsafe(ib) :
                        {
                            if (g.decided)
                            {
                                x.raw_tail = Some(block_id(ib));
                            }
                        },
                        // A decided program's last `if`, by its condition's
                        // id (`lower_if` probes its branches first).
                        ExprKind::EIf(ie)     :
                        {
                            if (g.decided)
                            {
                                x.raw_tail = Some(Box::get(ie).cond.id);
                            }
                        },
                        ExprKind::EPath(_)    : x.raw_return_path = true,
                        _                     : {},
                    }
                    // D-0286: a call's result returned with no object.
                    arm_inert(g, x, te, true);
                    // D-0294: in a decided program a literal, or a `Box` of a
                    // value, that is the result leaves with no object: the
                    // one made would be forgotten at once (`emit_return`).
                    if (raw_sink || g.decided)
                    {
                        x.objectless = literal_expr(g, x, te) || (g.decided && box_new_expr(g, x, te));
                    }
                }
                V v = lower_expr(g, x, te, expected);
                x.stmt_match = false;
                x.raw_return_path = false;
                x.inert_result = None;
                x.objectless = false;
                if (is_never(&v.ty))
                {
                    end_diverged(x);
                    result = never();
                }
                else if (is_void(&v.ty))
                {
                    emit(x, &sprintf("(void)(%s);", &v.c));
                    pop_stmt(x);
                    result = unit();
                }
                else if (Option::is_some(&sink))
                {
                    ref<Sink, shared> sk = Option::unwrap(sink);
                    Option<String> obj = assign_sink(g, x, &sk.dst, &sk.ty, v, te.line, &sk.ov);
                    match (&obj)
                    {
                        Some(o) : emit(x, &sprintf("cb_result(%s);", o)),
                        None    : {},
                    }
                    pop_stmt(x);
                    result = V { .c = String::clone(&sk.dst), .ty = clone(&sk.ty), .obj = obj };
                }
                else
                {
                    usize line = te.line;
                    V t2 = into_temp(g, x, v, line);
                    match (&t2.obj)
                    {
                        Some(o) : emit(x, &sprintf("cb_result(%s);", o)),
                        None    :
                        {
                            match (&t2.ty)
                            {
                                Type::TRef(_) : emit(x, &sprintf("cb_result_ref(%s.tok);", &t2.c)),
                                _             : {},
                            }
                        },
                    }
                    pop_stmt(x);
                    result = t2;
                }
            },
            None    : {},
        }
    }
    foreach (a in &aliases)
    {
        HashMap::remove(&mut x.elem_alias, a);
    }
    // Bare guards unlock as the block ends, after its value is taken, the
    // last made first.
    usize nu = Vec::len(&bare_unlocks);
    while (nu > 0)
    {
        nu -= 1;
        emit(x, &sprintf("cb_unlock_bare(%s);", &bare_unlocks[nu]));
    }
    Vec::pop(&mut x.scopes);
    result
}

struct BareGuard
{
    String name;
    Expr marg;
    usize line;
}

// `auto g = lock(m);` (statement `from - 1` of `b`) whose block uses `g` only
// as `*g` or `g.f…` (read or written), names nothing `m` names, has no
// `return`, `?` or jump out of a loop (cobc's `bare_guard_let`).
export fn bare_guard_let(ref<Stmt, shared> s, ref<Block, shared> b, usize from) : Option<BareGuard>
{
    ref<LetStmt, shared> l = match (s)
    {
        Stmt::SLet(lb) : Box::get(lb),
        _              : return None,
    };
    if (Option::is_some(&l.ty))
    {
        return None;
    }
    ref<Expr, shared> init = match (&l.init)
    {
        Some(i) : i,
        None    : return None,
    };
    ref<CallExpr, shared> call = match (&init.kind)
    {
        ExprKind::ECall(c) : Box::get(c),
        _                  : return None,
    };
    if (!callee_is_name(&call.callee, "lock") || Vec::len(&call.args) != 1)
    {
        return None;
    }
    if (!stmts_only_derefs_from(b, from, &l.name, true))
    {
        return None;
    }
    HashSet<String> names = HashSet::new();
    mentions_into(&call.args[0], &mut names);
    Block rest = rest_block(b, from - 1);
    if (rest_names_or_exits(&rest, &names) || leaves_loop(&rest))
    {
        return None;
    }
    Some(BareGuard { .name = String::clone(&l.name), .marg = clone(&call.args[0]), .line = l.line })
}

// A one-segment path among `names`, a `return` or a `?` anywhere in `b`.
fn rest_names_or_exits(ref<Block, shared> b, ref<HashSet<String>, shared> names) : bool
{
    foreach (st in &b.stmts)
    {
        bool hit = match (st)
        {
            Stmt::SLet(l)         :
            {
                match (&Box::get(l).init)
                {
                    Some(e) : expr_names_or_exits(e, names),
                    None    : false,
                }
            },
            Stmt::SDestructure(d) : expr_names_or_exits(&Box::get(d).init, names),
            Stmt::SExpr(e)        : expr_names_or_exits(Box::get(e), names),
            Stmt::SBlockLike(e)   : expr_names_or_exits(Box::get(e), names),
        };
        if (hit)
        {
            return true;
        }
    }
    match (&b.tail)
    {
        Some(t) : expr_names_or_exits(Box::get(t), names),
        None    : false,
    }
}

fn expr_names_or_exits(ref<Expr, shared> e, ref<HashSet<String>, shared> names) : bool
{
    match (&e.kind)
    {
        ExprKind::EPath(p)      :
        {
            if (Vec::len(&Box::get(p).segs) == 1 && HashSet::contains(names, &Box::get(p).segs[0]))
            {
                return true;
            }
        },
        ExprKind::EReturn(_)    : return true,
        ExprKind::EPropagate(_) : return true,
        _                       : {},
    }
    HashSet<String> sub = HashSet::new();
    bool found = false;
    match (&e.kind)
    {
        ExprKind::EStructLit(sl)  :
        {
            foreach (fi in &Box::get(sl).fields)
            {
                found = found || expr_names_or_exits(&fi.value, names);
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            foreach (a in es)
            {
                found = found || expr_names_or_exits(a, names);
            }
        },
        ExprKind::EArrayRepeat(a) : found = expr_names_or_exits(&Box::get(a).value, names),
        ExprKind::EUnary(u)       : found = expr_names_or_exits(&Box::get(u).e, names),
        ExprKind::EBinary(bx) : found = expr_names_or_exits(
            &Box::get(bx).a,
            names,
        ) || expr_names_or_exits(&Box::get(bx).b, names),
        ExprKind::EBorrow(bb)     : found = expr_names_or_exits(&Box::get(bb).e, names),
        ExprKind::ESliceOf(sl) : found = expr_names_or_exits(
            &Box::get(sl).base,
            names,
        ) || expr_names_or_exits(&Box::get(sl).lo, names) || expr_names_or_exits(&Box::get(sl).hi, names),
        ExprKind::EDeref(a)       : found = expr_names_or_exits(Box::get(a), names),
        ExprKind::EField(f)       : found = expr_names_or_exits(&Box::get(f).e, names),
        ExprKind::EIndex(p) : found = expr_names_or_exits(
            &Box::get(p).a,
            names,
        ) || expr_names_or_exits(&Box::get(p).b, names),
        ExprKind::ECall(c)        :
        {
            found = expr_names_or_exits(&Box::get(c).callee, names);
            foreach (a in &Box::get(c).args)
            {
                found = found || expr_names_or_exits(a, names);
            }
        },
        ExprKind::EAssign(p) : found = expr_names_or_exits(
            &Box::get(p).a,
            names,
        ) || expr_names_or_exits(&Box::get(p).b, names),
        ExprKind::EPropagate(a)   : found = expr_names_or_exits(Box::get(a), names),
        ExprKind::EBlock(bl)      : found = rest_names_or_exits(bl, names),
        ExprKind::EUnsafe(bl)     : found = rest_names_or_exits(bl, names),
        ExprKind::EIf(i)          :
        {
            found = expr_names_or_exits(
                &Box::get(i).cond,
                names,
            ) || rest_names_or_exits(&Box::get(i).then_, names) || match (&Box::get(i).else_)
            {
                Some(f) : expr_names_or_exits(f, names),
                None    : false,
            };
        },
        ExprKind::EWhile(w)       :
        {
            found = expr_names_or_exits(
                &Box::get(w).cond,
                names,
            ) || rest_names_or_exits(&Box::get(w).body, names) || match (&Box::get(w).step)
            {
                Some(st) : expr_names_or_exits(st, names),
                None     : false,
            };
        },
        ExprKind::EMatch(m)       :
        {
            found = expr_names_or_exits(&Box::get(m).scrut, names);
            foreach (a in &Box::get(m).arms)
            {
                found = found || expr_names_or_exits(Box::get(&a.body), names);
            }
        },
        ExprKind::EReturn(v)      :
        {
            match (v)
            {
                Some(r) : found = expr_names_or_exits(Box::get(r), names),
                None    : {},
            }
        },
        ExprKind::EClosure(c)     : found = rest_names_or_exits(&Box::get(c).body, names),
        ExprKind::EParen(a)       : found = expr_names_or_exits(Box::get(a), names),
        _                         : {},
    }
    found
}

// Whether `b` has a `break` or `continue` outside every loop within it
// (cobc's `leaves_loop`).
export fn leaves_loop(ref<Block, shared> b) : bool
{
    foreach (st in &b.stmts)
    {
        bool hit = match (st)
        {
            Stmt::SLet(l)         :
            {
                match (&Box::get(l).init)
                {
                    Some(e) : leaves_loop_e(e),
                    None    : false,
                }
            },
            Stmt::SDestructure(d) : leaves_loop_e(&Box::get(d).init),
            Stmt::SExpr(e)        : leaves_loop_e(Box::get(e)),
            Stmt::SBlockLike(e)   : leaves_loop_e(Box::get(e)),
        };
        if (hit)
        {
            return true;
        }
    }
    match (&b.tail)
    {
        Some(t) : leaves_loop_e(Box::get(t)),
        None    : false,
    }
}

fn leaves_loop_e(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EBreak          : true,
        ExprKind::EContinue       : true,
        ExprKind::EWhile(w)       : leaves_loop_e(&Box::get(w).cond),
        ExprKind::EClosure(_)     : false,
        ExprKind::EBlock(bl)      : leaves_loop(bl),
        ExprKind::EUnsafe(bl)     : leaves_loop(bl),
        ExprKind::EIf(i)          :
        {
            leaves_loop_e(&Box::get(i).cond) || leaves_loop(&Box::get(i).then_) || match (&Box::get(i).else_)
            {
                Some(f) : leaves_loop_e(f),
                None    : false,
            }
        },
        ExprKind::EMatch(m)       :
        {
            if (leaves_loop_e(&Box::get(m).scrut))
            {
                return true;
            }
            foreach (a in &Box::get(m).arms)
            {
                if (leaves_loop_e(Box::get(&a.body)))
                {
                    return true;
                }
            }
            false
        },
        // cobc's `visit_children` for the rest.
        ExprKind::EUnary(u)       : leaves_loop_e(&Box::get(u).e),
        ExprKind::EBorrow(bb)     : leaves_loop_e(&Box::get(bb).e),
        ExprKind::EDeref(a)       : leaves_loop_e(Box::get(a)),
        ExprKind::EField(f)       : leaves_loop_e(&Box::get(f).e),
        ExprKind::EPropagate(a)   : leaves_loop_e(Box::get(a)),
        ExprKind::EParen(a)       : leaves_loop_e(Box::get(a)),
        ExprKind::EArrayRepeat(a) : leaves_loop_e(&Box::get(a).value),
        ExprKind::EBinary(bx)     : leaves_loop_e(&Box::get(bx).a) || leaves_loop_e(&Box::get(bx).b),
        ExprKind::EIndex(p)       : leaves_loop_e(&Box::get(p).a) || leaves_loop_e(&Box::get(p).b),
        ExprKind::EAssign(p)      : leaves_loop_e(&Box::get(p).a) || leaves_loop_e(&Box::get(p).b),
        ExprKind::ESliceOf(sl)    : leaves_loop_e(&Box::get(sl).base) || leaves_loop_e(&Box::get(sl).lo) || leaves_loop_e(&Box::get(sl).hi),
        ExprKind::ECall(c)        :
        {
            if (leaves_loop_e(&Box::get(c).callee))
            {
                return true;
            }
            foreach (a in &Box::get(c).args)
            {
                if (leaves_loop_e(a))
                {
                    return true;
                }
            }
            false
        },
        ExprKind::EStructLit(sl)  :
        {
            foreach (fi in &Box::get(sl).fields)
            {
                if (leaves_loop_e(&fi.value))
                {
                    return true;
                }
            }
            false
        },
        ExprKind::EArrayLit(es)   :
        {
            foreach (a in es)
            {
                if (leaves_loop_e(a))
                {
                    return true;
                }
            }
            false
        },
        ExprKind::EReturn(v)      :
        {
            match (v)
            {
                Some(r) : leaves_loop_e(Box::get(r)),
                None    : false,
            }
        },
        _                         : false,
    }
}

// D-0202 phase 4: the mutex taken and given back by the book alone
// (`cb_lock_bare`, `cb_unlock_bare`), with no guard object and no lock path;
// the interior reached only through `g` while the block runs (cobc's
// `lower_bare_guard`). False, having emitted nothing, where the interior is
// not plain.
export fn lower_bare_guard(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> name,
    ref<Expr, shared> marg,
    usize line,
    ref<Vec<String>, exclusive> unlocks,
) : bool
{
    if (boot(g, 2))
    {
        return false;
    }
    Type mt0 = probe_type(g, x, marg, None);
    Type inner = match (&mt0)
    {
        Type::TRef(m) :
        {
            match (&Box::get(m).inner)
            {
                Type::TMutex(i) : clone(Box::get(i)),
                _               : return false,
            }
        },
        _             : return false,
    };
    if (is_resource(g, &inner) || has_refs(g, &inner))
    {
        return false;
    }
    push_stmt_at(g, x, Some(line));
    V mv = lower_expr(g, x, marg, None);
    assert(!is_never(&mv.ty), "cobc: a bare guard's mutex expression diverges");
    V mt = into_temp(g, x, mv, line);
    String lc = loc(g, x.std_body, line);
    emit(x, &sprintf("cb_read(%s.tok, NULL, 0, %s);", &mt.c, &lc));
    // D-0310: the mutex's type, for where its state cells are.
    u32 mtid = type_id(g, &Type::TMutex(Box::new(clone(&inner))));
    emit(x, &sprintf("cb_lock_bare(%s.p, %vu, %s);", &mt.c, mtid, &lc));
    String l = sprintf("l_%s_%s", &san(name), &fresh(g, ""));
    emit(x, &sprintf("void *%s = %s.p;", &l, &mt.c));
    pop_stmt(x);
    names_add(x, NameSet::DirectRefs, String::clone(&l));
    bind_in_scope(
        x,
        name,
        Binding { .c = String::clone(&l), .ty = ref_ty(
            inner,
            Mode::Exclusive,
        ), .root = String::new(), .kind = BindKind::Local },
    );
    Vec::push(unlocks, l);
    true
}

// The compound pair at statement `si` of `b` (cobc's in `lower_block_body`):
// `Some(diverged)` when the two statements were lowered as one.
export fn compound_pair(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Block, shared> b, usize si) : Option<bool>
{
    if (boot(g, 4))
    {
        return None;
    }
    ref<LetStmt, shared> l = match (&b.stmts[si])
    {
        Stmt::SLet(lb) : Box::get(lb),
        _              : return None,
    };
    if (Option::is_some(&l.ty))
    {
        return None;
    }
    ref<Expr, shared> e = match (&l.init)
    {
        Some(e) : e,
        None    : return None,
    };
    ref<BorrowExpr, shared> bw = match (&e.kind)
    {
        ExprKind::EBorrow(bb) : Box::get(bb),
        _                     : return None,
    };
    if (!StringView::starts_with(
        &l.name,
        "__compound",
    ) || bw.mode != Mode::Exclusive || !compound_write_inert(&b.stmts[si + 1], &l.name))
    {
        return None;
    }
    ref<Stmt, shared> next = &b.stmts[si + 1];
    push_stmt(g, x);
    // `*HashMap::entry(…) op= e`: the native `entry`'s `_acc` variant gives
    // the value's address, the element's access made.
    Option<Expr> acc_call = match (&strip_parens(&bw.e).kind)
    {
        ExprKind::EDeref(c) :
        {
            match (&strip_parens(Box::get(c)).kind)
            {
                ExprKind::ECall(cc) :
                {
                    bool entry = match (&Box::get(cc).callee.kind)
                    {
                        ExprKind::EPath(cp) : String::join(&Box::get(cp).segs, "::") == "std::HashMap::entry",
                        _                   : false,
                    };
                    if (entry) { Some(clone(Box::get(c))) } else { None }
                },
                _                   : None,
            }
        },
        _                   : None,
    };
    match (&acc_call)
    {
        Some(c) :
        {
            ref<Expr, shared> sc = strip_parens(c);
            x.map_acc = match (&sc.kind)
            {
                ExprKind::ECall(cc) : Some(args_key(&Box::get(cc).args)),
                _                   : None,
            };
            x.map_acc_used = false;
            V v = lower_expr(g, x, c, None);
            x.map_acc = None;
            if (is_never(&v.ty))
            {
                return Some(true);
            }
            if (replace(&mut x.map_acc_used, false))
            {
                String al = sprintf("l_%s_%s", &san(&l.name), &fresh(g, ""));
                emit(x, &sprintf("void *%s = (void *)%s;", &al, &v.c));
                names_add(x, NameSet::DirectRefs, String::clone(&al));
                bind_in_scope(
                    x,
                    &l.name,
                    Binding { .c = al, .ty = clone(&v.ty), .root = String::new(), .kind = BindKind::Local },
                );
            }
            else
            {
                // An ordinary call: its reference, as the borrow of `*call`.
                V r = into_temp(g, x, v, l.line);
                String al = sprintf("l_%s_%s", &san(&l.name), &fresh(g, ""));
                emit(x, &sprintf("void *%s = (%s).p;", &al, &r.c));
                names_put(x, NameMap::Unstored, String::clone(&al), sprintf("(%s).tok", &r.c));
                bind_in_scope(
                    x,
                    &l.name,
                    Binding { .c = al, .ty = clone(&r.ty), .root = String::new(), .kind = BindKind::Local },
                );
            }
            if (lower_stmt(g, x, next))
            {
                return Some(true);
            }
            pop_stmt(x);
            return Some(false);
        },
        None    : {},
    }
    x.compound_elem = true;
    V v = lower_expr(g, x, e, None);
    x.compound_elem = false;
    if (is_never(&v.ty))
    {
        return Some(true);
    }
    V r = into_temp(g, x, v, l.line);
    String al = sprintf("l_%s_%s", &san(&l.name), &fresh(g, ""));
    emit(x, &sprintf("void *%s = (%s).p;", &al, &r.c));
    names_put(x, NameMap::Unstored, String::clone(&al), sprintf("(%s).tok", &r.c));
    bind_in_scope(
        x,
        &l.name,
        Binding { .c = al, .ty = clone(&r.ty), .root = String::new(), .kind = BindKind::Local },
    );
    if (lower_stmt(g, x, next))
    {
        return Some(true);
    }
    pop_stmt(x);
    Some(false)
}

// D-0200: `*Option::unwrap(HashMap::get(&m, k))` for a native map of plain
// values: the lookup's `_acc` variant, `unwrap`'s fault for NULL, and the
// value read where it lies (cobc's `unwrapped_map_get`).
export fn unwrapped_map_get(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> inner,
    usize line,
) : Option<P>
{
    if (boot(g, 4))
    {
        return None;
    }
    ref<CallExpr, shared> uc = match (&strip_parens(inner).kind)
    {
        ExprKind::ECall(c) : Box::get(c),
        _                  : return None,
    };
    ref<PathExpr, shared> up = match (&uc.callee.kind)
    {
        ExprKind::EPath(p) : Box::get(p),
        _                  : return None,
    };
    if (Vec::len(&uc.args) != 1)
    {
        return None;
    }
    ref<Expr, shared> garg = &uc.args[0];
    ref<CallExpr, shared> gc = match (&strip_parens(garg).kind)
    {
        ExprKind::ECall(c) : Box::get(c),
        _                  : return None,
    };
    ref<PathExpr, shared> gp = match (&gc.callee.kind)
    {
        ExprKind::EPath(p) : Box::get(p),
        _                  : return None,
    };
    if (Vec::len(&up.targs) > 0 || Vec::len(&gp.targs) > 0 || (Vec::len(&up.segs) == 1 && is_bound(
        x,
        &up.segs[0],
    )) || (Vec::len(
        &gp.segs,
    ) == 1 && is_bound(x, &gp.segs[0])))
    {
        return None;
    }
    String uk0 = String::join(&up.segs, "::");
    String uk = if (HashMap::contains(&g.prog.table.fns, &uk0)) { uk0 } else { sprintf("std::%s", &uk0) };
    String gk0 = String::join(&gp.segs, "::");
    String gk = if (HashMap::contains(&g.prog.table.fns, &gk0)) { gk0 } else { sprintf("std::%s", &gk0) };
    if (uk != "std::Option::unwrap" || gk != "std::HashMap::get")
    {
        return None;
    }
    FnDecl uf = match (get_fn(g, &uk))
    {
        Some(f) : f,
        None    : return None,
    };
    FnDecl gf = match (get_fn(g, &gk))
    {
        Some(f) : f,
        None    : return None,
    };
    if (!in_prelude(&uk, &uf) || !native_map_passthrough(g, x, &gk, &gf, &gc.args, 0))
    {
        return None;
    }
    Type ot = probe_type(g, x, garg, None);
    Type vt = match (&ot)
    {
        Type::TNamed(n) :
        {
            if (Vec::len(&Box::get(n).args) != 1)
            {
                return None;
            }
            match (&Box::get(n).args[0])
            {
                Type::TRef(m) :
                {
                    if (Box::get(m).mode != Mode::Shared)
                    {
                        return None;
                    }
                    clone(&Box::get(m).inner)
                },
                _             : return None,
            }
        },
        _               : return None,
    };
    if (!plain_data(g, &vt))
    {
        return None;
    }
    x.map_get_acc = Some(args_key(&gc.args));
    x.map_get_acc_out = None;
    V v = lower_expr(g, x, garg, None);
    x.map_get_acc = None;
    if (is_never(&v.ty))
    {
        return Some(P { .c = String::clone(&v.c), .ty = Type::TNever, .base = None, .projs = Vec::new(), .is_binding = false, .raw = None });
    }
    String pv = match (replace(&mut x.map_get_acc_out, None))
    {
        Some(p) : p,
        None    :
        {
            assert(false, "cobc: a native map lookup that was not made");
            String::new()
        },
    };
    StringView m = "`Option::unwrap` found `None`";
    at(g, x, line);
    emit(
        x,
        &sprintf(
            "if (!%s) cb_fault_msg(\"diag.unwrap-failed\", (const uint8_t *)\"%v\", %vu, CB_NOLOC, 0);",
            &pv,
            m,
            StringView::len(m),
        ),
    );
    Some(P { .c = sprintf(
        "(*%s)",
        &pv,
    ), .ty = vt, .base = None, .projs = Vec::new(), .is_binding = false, .raw = None })
}

export fn opt_eq(ref<Option<usize>, shared> a, ref<Option<usize>, shared> b) : bool
{
    match (a)
    {
        Some(x) : match (b)
        {
            Some(y) : *x == *y,
            None    : false,
        },
        None : Option::is_none(b),
    }
}

// `Option<ref<T>>`: reference data whose one reference is the payload
// (cobc's `one_ref_option`).
export fn one_ref_option(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(n) :
        {
            Box::get(n).name == "std::Option" && Vec::len(&Box::get(n).args) == 1 && is_ref_type(&Box::get(n).args[0])
        },
        _               : false,
    }
}

// Whether argument `j` of a call to `name` goes to a native map body
// (`native_map_op`) that only checks through its path (cobc's
// `native_map_passthrough`).
export fn native_map_passthrough(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    StringView name,
    ref<FnDecl, shared> f,
    ref<Vec<Expr>, shared> args,
    usize j,
) : bool
{
    bool op = name == "std::HashMap::get" || name == "std::HashMap::get_mut" || name == "std::HashMap::contains" || name == "std::HashMap::entry" || name == "std::HashMap::insert";
    bool entry_or_insert = name == "std::HashMap::entry" || name == "std::HashMap::insert";
    if (!op || !in_prelude(name, f) || !(j == 0 || (j == 1 && !entry_or_insert)))
    {
        return false;
    }
    if (Vec::len(args) == 0)
    {
        return false;
    }
    Type t0 = probe_type(g, x, &args[0], None);
    Type mt = match (&t0)
    {
        Type::TRef(m) : clone(&Box::get(m).inner),
        _             : return false,
    };
    ref<NamedTy, shared> hn = match (&mt)
    {
        Type::TNamed(n) : Box::get(n),
        _               : return false,
    };
    if (Vec::len(&hn.args) != 2)
    {
        return false;
    }
    ref<Type, shared> k = &hn.args[0];
    ref<Type, shared> v = &hn.args[1];
    if (hn.name != "std::HashMap" || !native_map_key(name, k))
    {
        return false;
    }
    u64 vs = size_align(g, v).size;
    if (vs == 0 || has_refs(g, v) || holds_fn(g, v))
    {
        return false;
    }
    !entry_or_insert || plain_data(g, v)
}

enum DirectArg
{
    Arg(V),
    Diverged,
}

// An argument's direct paths: a borrow or view passed with no path minted,
// or with its checks only, where the parameter allows it (`pure_direct`,
// `pure_view`, `reader_param`, the native operations' passthroughs).
// `None`: the general path lowers it (cobc's `lower_user_arg_direct`).
export fn lower_user_arg_direct(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    StringView name,
    ref<FnDecl, shared> f,
    ref<Vec<Expr>, shared> args,
    usize j,
    ref<Expr, shared> a,
    ref<ParamDecl, shared> p,
    ref<Vec<V>, shared> argv,
    ref<HashMap<String, Type>, exclusive> m,
    ref<bool, exclusive> map_excl_checked,
) : Option<DirectArg>
{
    if (boot(g, 3))
    {
        return None;
    }
    String key = String::copy(name);
    // D-0312: a probe parameter is a pure view only where it is a view here
    // (a `String` key's); a reference or a value probe is passed as its type
    // is.
    Type here_ty = apply(&p.ty, m);
    bool pure_view_here = pure_view(g, &key, j) && (!is_probe(&p.ty) || is_named(&here_ty, "std::StringView"));
    ref<Expr, shared> sa = strip_parens(a);
    // D-0258: `&NAME` of a static, `&K` of an addressed constant: the
    // global's address with token 0.
    match (&sa.kind)
    {
        ExprKind::EBorrow(bb) :
        {
            match (global_borrow(g, x, &Box::get(bb).e))
            {
                Some(gv) :
                {
                    unify(&p.ty, &gv.ty, &f.type_params, m);
                    return Some(DirectArg::Arg(gv));
                },
                None     : {},
            }
        },
        _                     : {},
    }
    // `&e[lo .. hi]` formed for a pure direct slice parameter: the borrow's
    // checks only (pure direct parameters come with stage 1).
    match (&sa.kind)
    {
        ExprKind::ESliceOf(sl) :
        {
            bool mode_ok = match (&p.ty)
            {
                Type::TSlice(pm) : Box::get(pm).mode == Box::get(sl).mode,
                _                : false,
            };
            bool temp = HashSet::contains(&g.prog.facts.temp_borrows, sa.id);
            if (mode_ok && !HashMap::contains(&g.prog.facts.view_ops, sa.id) && !temp && pure_direct(g, &key, j))
            {
                V v = lower_slice_of_as(g, x, Box::get(sl), false, sa.line, false);
                return Some(DirectArg::Arg(v));
            }
        },
        _                      : {},
    }
    // A literal viewed (`StringView::of(L)`) for a pure view parameter: a
    // bare view of the literal's bytes.
    match (literal_view_arg(a))
    {
        Some(lit) :
        {
            if (pure_view_here)
            {
                Type strt = Type::TStr;
                V lv = lower_expr(g, x, lit, Some(&strt));
                Type vt = Type::TNamed(Box::new(NamedTy { .name = "std::StringView", .args = Vec::new() }));
                String svc = ctype(g, &vt);
                String t = fresh(g, "t");
                emit(x, &sprintf("%s %s;", &svc, &t));
                emit(x, &sprintf("%s.bytes.src = (void *)(%s).p;", &t, &lv.c));
                emit(x, &sprintf("%s.bytes.data = (uint8_t *)(%s).p;", &t, &lv.c));
                emit(x, &sprintf("%s.bytes.len = (%s).n;", &t, &lv.c));
                return Some(DirectArg::Arg(V { .c = t, .ty = vt, .obj = None }));
            }
        },
        None      : {},
    }
    // `String::as_view(x)` for a pure view parameter, the call's views and
    // references all shared (or exclusive to scalars only, evaluated before),
    // nothing else among the arguments evaluated: the view's borrows' checks
    // only, and a bare view. D-0302's whole-text view of a `String` place
    // (`whole_text_view_arg`) is the same argument.
    Option<Expr> whole_view = whole_text_view_arg(g, x, a);
    Option<ref<Expr, shared>> view_of = match (as_view_arg(a))
    {
        Some(v) : Some(v),
        None : match (&whole_view)
        {
            Some(w) : Some(w),
            None    : None,
        },
    };
    match (view_of)
    {
        Some(vx) :
        {
            // CHG-0237: the text of a frozen parameter's field (`&p.f…`): no
            // path can clash with it while the call runs.
            bool frozen = match (&strip_parens(vx).kind)
            {
                ExprKind::EBorrow(vb) : Box::get(vb).mode == Mode::Shared && frozen_root(g, x, &Box::get(vb).e),
                _                     : false,
            };
            if (frozen && pure_view_here)
            {
                V v = lower_as_view_unminted(g, x, vx, a.line);
                return Some(DirectArg::Arg(v));
            }
            if (pure_view_here && view_safe_params(g, &key, f) && view_args_inert(args, j))
            {
                V v = lower_as_view_unminted(g, x, vx, a.line);
                return Some(DirectArg::Arg(v));
            }
        },
        None     : {},
    }
    // A view place for a pure view parameter: its read's check, then its
    // bytes.
    if (is_place_expr(a) && root_bound(x, a) && pure_view_here)
    {
        P pl = lower_place(g, x, a);
        if (Option::is_none(&pl.raw))
        {
            match (&pl.base)
            {
                Some(base) :
                {
                    String lc = loc(g, x.std_body, a.line);
                    emit(x, &sprintf("cb_read(%s, %s, %s);", base, &projs_args(&pl.projs), &lc));
                },
                None       : {},
            }
            String t = fresh(g, "t");
            String c = ctype(g, &pl.ty);
            emit(x, &sprintf("%s %s = %s;", &c, &t, &pl.c));
            return Some(DirectArg::Arg(V { .c = t, .ty = clone(&pl.ty), .obj = None }));
        }
    }
    // A slice place for a pure direct slice parameter (stage 1).
    bool p_slice = match (&p.ty)
    {
        Type::TSlice(_) : true,
        _               : false,
    };
    if (p_slice && is_place_expr(a) && root_bound(x, a) && pure_direct(g, &key, j))
    {
        P pl = lower_place(g, x, a);
        bool pl_slice = match (&pl.ty)
        {
            Type::TSlice(_) : true,
            _               : false,
        };
        if (Option::is_none(&pl.raw) && pl_slice)
        {
            match (&pl.base)
            {
                Some(base) :
                {
                    String lc = loc(g, x.std_body, a.line);
                    emit(x, &sprintf("cb_read(%s, %s, %s);", base, &projs_args(&pl.projs), &lc));
                },
                None       : {},
            }
            String t = fresh(g, "t");
            String c = ctype(g, &pl.ty);
            emit(x, &sprintf("%s %s = %s;", &c, &t, &pl.c));
            return Some(DirectArg::Arg(V { .c = t, .ty = clone(&pl.ty), .obj = None }));
        }
    }
    // A native map operation's map (or key) reference, `append`'s text, or a
    // reader's referent: `&x` / `&mut x` of a local is checked as the borrow
    // would be (`cb_borrow_unminted`) and passed with `x`'s own root path.
    match (&a.kind)
    {
        ExprKind::EBorrow(bb) :
        {
            Mode bmode = Box::get(bb).mode;
            ref<Expr, shared> place = &Box::get(bb).e;
            if (native_map_passthrough(
                g,
                x,
                name,
                f,
                args,
                j,
            ) || append_passthrough(g, x, name, f, args, j) || reader_passthrough(g, name, f, args, j))
            {
                match (path_name_raw(place))
                {
                    Some(pn) :
                    {
                        match (lookup(x, &pn))
                        {
                            Some(bind) :
                            {
                                // An objectless `String` for a reader: its
                                // address, token 0.
                                if (bmode == Mode::Shared && HashSet::contains(
                                    &x.objectless_c,
                                    &bind.c,
                                ) && reader_passthrough(g, name, f, args, j))
                                {
                                    objectless_use(g, x, &bind.c, a.line);
                                    Type ty = ref_ty(clone(&bind.ty), Mode::Shared);
                                    unify(&p.ty, &ty, &f.type_params, m);
                                    return Some(DirectArg::Arg(V { .c = sprintf(
                                        "((cb_ref){ (void *)&(%s), 0 })",
                                        &bind.c,
                                    ), .ty = ty, .obj = None }));
                                }
                                bool local = match (&bind.kind)
                                {
                                    BindKind::Local : true,
                                    _               : false,
                                };
                                if (local && StringView::len(&bind.root) > 0 && !HashSet::contains(
                                    &x.direct_refs,
                                    &bind.c,
                                ) && !HashMap::contains(
                                    &x.unstored,
                                    &bind.c,
                                ) && !is_ref_type(&bind.ty))
                                {
                                    String lc = loc(g, x.std_body, a.line);
                                    str md = if (bmode == Mode::Exclusive) { "CB_EXCLUSIVE" } else { "CB_SHARED" };
                                    emit(
                                        x,
                                        &sprintf(
                                            "cb_borrow_unminted(%s, NULL, 0, %s, %s);",
                                            &bind.root,
                                            md,
                                            &lc,
                                        ),
                                    );
                                    if (j == 0 && bmode == Mode::Exclusive && name == "std::HashMap::get_mut" && Vec::len(args) > 1 && key_inert(&args[1]))
                                    {
                                        *map_excl_checked = true;
                                    }
                                    Type ty = ref_ty(clone(&bind.ty), bmode);
                                    unify(&p.ty, &ty, &f.type_params, m);
                                    return Some(DirectArg::Arg(V { .c = sprintf(
                                        "((cb_ref){ (void *)&(%s), %s })",
                                        &bind.c,
                                        &bind.root,
                                    ), .ty = ty, .obj = None }));
                                }
                            },
                            None       : {},
                        }
                    },
                    None     : {},
                }
            }
        },
        _                     : {},
    }
    // `Box::get[_mut](b)` of an unminted binder for a pure direct parameter
    // (stage 1).
    match (&sa.kind)
    {
        ExprKind::ECall(gc) :
        {
            String gname = match (&Box::get(gc).callee.kind)
            {
                ExprKind::EPath(gp) : String::join(&Box::get(gp).segs, "::"),
                _                   : String::new(),
            };
            if ((gname == "std::Box::get" || gname == "std::Box::get_mut") && Vec::len(&Box::get(gc).args) == 1 && is_ref_type(&p.ty) && pure_direct(
                g,
                &key,
                j,
            ) && !sibling_names_root(args, j, &Box::get(gc).args[0]))
            {
                match (lower_box_arg_unminted(g, x, &gname, &Box::get(gc).args[0], f, p, m, a.line))
                {
                    Some(v) : return Some(DirectArg::Arg(v)),
                    None    : {},
                }
            }
        },
        _                   : {},
    }
    // CHG-0237: `&x.f…` -- fields only, down to a shared reference parameter
    // that is never rebound (`frozen_root`) -- for a reader parameter: the
    // field's address, no path.
    match (&a.kind)
    {
        ExprKind::EBorrow(bb) :
        {
            ref<Expr, shared> place = &Box::get(bb).e;
            bool p_shared = match (&p.ty)
            {
                Type::TRef(pm) : Box::get(pm).mode == Mode::Shared,
                _              : false,
            };
            if (Box::get(bb).mode == Mode::Shared && p_shared && frozen_root(g, x, place) && reader_param(g, &key, j))
            {
                Type pt = probe_type(g, x, place, None);
                if (flat_value(g, &pt))
                {
                    P pl = lower_place(g, x, place);
                    String ad = fresh(g, "ad");
                    emit(x, &sprintf("void *%s = (void *)&(%s);", &ad, &pl.c));
                    Type ty = ref_ty(clone(&pl.ty), Mode::Shared);
                    unify(&p.ty, &ty, &f.type_params, m);
                    return Some(DirectArg::Arg(V { .c = sprintf("((cb_ref){ %s, 0 })", &ad), .ty = ty, .obj = None }));
                }
            }
        },
        _                     : {},
    }
    // `&v[i]`/`&mut v[i]`: a plain element for a pure direct parameter, or a
    // resource element holding no reference for a reader: the index call's
    // checks, the element checked in the borrow's mode, and its address.
    match (&a.kind)
    {
        ExprKind::EBorrow(bb) :
        {
            Mode bmode = Box::get(bb).mode;
            ref<Expr, shared> place = &Box::get(bb).e;
            bool p_ref = is_ref_type(&p.ty);
            bool p_shared_ref = match (&p.ty)
            {
                Type::TRef(pm) : Box::get(pm).mode == Mode::Shared,
                _              : false,
            };
            bool index_place = match (&strip_parens(place).kind)
            {
                ExprKind::EIndex(_) : true,
                _                   : false,
            };
            Option<Expr> rewritten = if (index_place && p_ref && (pure_direct(
                g,
                &key,
                j,
            ) || (bmode == Mode::Shared && reader_param(g, &key, j))))
            {
                vec_index_call(g, x, strip_parens(place), false)
            }
            else { None };
            Expr place_x = match (rewritten)
            {
                Some(rw) : rw,
                None     : clone(place),
            };
            match (&strip_parens(&place_x).kind)
            {
                ExprKind::EDeref(inner) :
                {
                    bool plain_elem = false;
                    if (p_ref && pure_direct(g, &key, j) && !sibling_names_root(args, j, place))
                    {
                        Type et = probe_type(g, x, &place_x, None);
                        plain_elem = !is_resource(g, &et) && !has_refs(g, &et) && !holds_fn(g, &et) && !is_closure(&et);
                    }
                    bool reader_elem = false;
                    if (!plain_elem && bmode == Mode::Shared && p_shared_ref && reader_param(g, &key, j))
                    {
                        Type et = probe_type(g, x, &place_x, None);
                        Option<String> rn = place_root_name(place);
                        bool others = match (&rn)
                        {
                            Some(r) : other_arg_names(args, j, r),
                            None    : true,
                        };
                        reader_elem = is_resource(
                            g,
                            &et,
                        ) && !has_refs(g, &et) && !holds_fn(g, &et) && !is_closure(&et) && !is_ref_type(&et) && !others;
                    }
                    if (plain_elem || reader_elem)
                    {
                        str em = if (bmode == Mode::Exclusive) { "CB_EXCLUSIVE" } else { "CB_SHARED" };
                        Option<String> saved = replace(&mut x.elem_mode, Some(String::copy(em)));
                        x.elem_reader = reader_elem;
                        Option<P> r = elem_access_place(g, x, Box::get(inner), bmode == Mode::Exclusive, a.line);
                        x.elem_reader = false;
                        x.elem_mode = saved;
                        match (r)
                        {
                            Some(pl) :
                            {
                                if (is_never(&pl.ty))
                                {
                                    return Some(DirectArg::Diverged);
                                }
                                if (Option::is_none(&pl.base) && Option::is_none(&pl.raw))
                                {
                                    String ad = fresh(g, "ad");
                                    emit(x, &sprintf("void *%s = (void *)&(%s);", &ad, &pl.c));
                                    Type ty = ref_ty(clone(&pl.ty), bmode);
                                    return Some(DirectArg::Arg(V { .c = sprintf(
                                        "((cb_ref){ %s, 0 })",
                                        &ad,
                                    ), .ty = ty, .obj = None }));
                                }
                                // The index call ran in full: its reference is
                                // the place's base.
                                match (&pl.base)
                                {
                                    Some(base) :
                                    {
                                        String lc = loc(g, x.std_body, a.line);
                                        emit(
                                            x,
                                            &sprintf(
                                                "cb_borrow_unminted(%s, %s, %s, %s);",
                                                base,
                                                &projs_args(&pl.projs),
                                                em,
                                                &lc,
                                            ),
                                        );
                                        String ad = fresh(g, "ad");
                                        emit(x, &sprintf("void *%s = (void *)&(%s);", &ad, &pl.c));
                                        Type ty = ref_ty(clone(&pl.ty), bmode);
                                        return Some(DirectArg::Arg(V { .c = sprintf(
                                            "((cb_ref){ %s, 0 })",
                                            &ad,
                                        ), .ty = ty, .obj = None }));
                                    },
                                    None : assert(
                                        false,
                                        "cobc: an element place with neither base nor plain access",
                                    ),
                                }
                            },
                            None     : {},
                        }
                    }
                },
                _                       : {},
            }
        },
        _                     : {},
    }
    // D-0189: the key of `Vec::contains`, `index_of` or `binary_search` for
    // an integer or `bool` element type, read once by the native body: a
    // temporary key is passed as the address of its value, no object made;
    // a place, as below, after its borrow's check.
    Option<Type> key_elem = None;
    if (Vec::len(argv) > 0)
    {
        match (&argv[0].ty)
        {
            Type::TRef(r0) :
            {
                match (&Box::get(r0).inner)
                {
                    Type::TNamed(vn) :
                    {
                        if (Box::get(vn).name == "std::Vec" && Vec::len(&Box::get(vn).args) == 1)
                        {
                            match (&Box::get(vn).args[0])
                            {
                                Type::TInt(_) : key_elem = Some(clone(&Box::get(vn).args[0])),
                                Type::TBool   : key_elem = Some(clone(&Box::get(vn).args[0])),
                                _             : {},
                            }
                        }
                    },
                    _                : {},
                }
            },
            _              : {},
        }
    }
    bool shared_borrow = match (&a.kind)
    {
        ExprKind::EBorrow(bb) : Box::get(bb).mode == Mode::Shared,
        _                     : false,
    };
    bool search = name == "std::Vec::contains" || name == "std::Vec::index_of" || name == "std::Vec::binary_search";
    bool native_key = j == 1 && in_prelude(name, f) && search && shared_borrow && Option::is_some(&key_elem);
    if (native_key)
    {
        ref<Expr, shared> inner = match (&a.kind)
        {
            ExprKind::EBorrow(bb) : &Box::get(bb).e,
            _                     : a,
        };
        if (!is_place_expr(inner))
        {
            Type ke = match (&key_elem)
            {
                Some(k) : clone(k),
                None    : Type::TVoid,
            };
            V v = lower_expr(g, x, inner, Some(&ke));
            assert(
                type_eq(&v.ty, &ke) || is_never(&v.ty),
                "cobc: a native search key of another type than the elements",
            );
            if (is_never(&v.ty))
            {
                return Some(DirectArg::Diverged);
            }
            String kc = ctype(g, &v.ty);
            String kv = fresh(g, "key");
            emit(x, &sprintf("%s %s = %s;", &kc, &kv, &v.c));
            Type ty = ref_ty(clone(&v.ty), Mode::Shared);
            return Some(DirectArg::Arg(V { .c = sprintf("((cb_ref){ (void *)&%s, 0 })", &kv), .ty = ty, .obj = None }));
        }
    }
    // `&p`/`&mut p` for a pure direct parameter (or a native search key): the
    // borrow's check, and its address with no path minted.
    match (&a.kind)
    {
        ExprKind::EBorrow(bb) :
        {
            Mode bmode = Box::get(bb).mode;
            ref<Expr, shared> place = &Box::get(bb).e;
            if (is_ref_type(&p.ty) && (native_key || pure_direct(
                g,
                &key,
                j,
            )) && is_place_expr(place) && root_bound(x, place) && !sibling_names_root(args, j, place))
            {
                P pl = lower_place(g, x, place);
                // A local left unpinned for this very borrow: its address.
                if (Option::is_none(&pl.base) && Option::is_none(&pl.raw) && pl.is_binding)
                {
                    String ad = fresh(g, "ad");
                    emit(x, &sprintf("void *%s = (void *)&(%s);", &ad, &pl.c));
                    Type ty = ref_ty(clone(&pl.ty), bmode);
                    return Some(DirectArg::Arg(V { .c = sprintf("((cb_ref){ %s, 0 })", &ad), .ty = ty, .obj = None }));
                }
                if (Option::is_some(&pl.base) && Option::is_none(&pl.raw))
                {
                    String base = Option::expect(clone(&pl.base), "a base");
                    String lc = loc(g, x.std_body, a.line);
                    str md = if (bmode == Mode::Exclusive) { "CB_EXCLUSIVE" } else { "CB_SHARED" };
                    emit(
                        x,
                        &sprintf(
                            "cb_borrow_unminted(%s, %s, %s, %s);",
                            &base,
                            &projs_args(&pl.projs),
                            md,
                            &lc,
                        ),
                    );
                    String ad = fresh(g, "ad");
                    emit(x, &sprintf("void *%s = (void *)&(%s);", &ad, &pl.c));
                    Type ty = ref_ty(clone(&pl.ty), bmode);
                    return Some(DirectArg::Arg(V { .c = sprintf("((cb_ref){ %s, 0 })", &ad), .ty = ty, .obj = None }));
                }
            }
        },
        _                     : {},
    }
    None
}

// A local's value or a borrow of one: its evaluation forms no path.
export fn key_inert(ref<Expr, shared> e) : bool
{
    match (&strip_parens(e).kind)
    {
        ExprKind::EPath(p)    : Vec::len(&Box::get(p).segs) == 1 && Vec::len(&Box::get(p).targs) == 0,
        ExprKind::EBorrow(bb) :
        {
            match (&strip_parens(&Box::get(bb).e).kind)
            {
                ExprKind::EPath(p) : Vec::len(&Box::get(p).segs) == 1 && Vec::len(&Box::get(p).targs) == 0,
                _                  : false,
            }
        },
        _                     : false,
    }
}

// Every argument but `j` inert for a view (`inert_view_arg`) or an exclusive
// borrow of a place evaluated before `j`.
export fn view_args_inert(ref<Vec<Expr>, shared> args, usize j) : bool
{
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        if (i == j || inert_view_arg(&args[i]))
        {
            continue;
        }
        bool excl_before = i < j && match (&strip_parens(&args[i]).kind)
        {
            ExprKind::EBorrow(bb) : Box::get(bb).mode == Mode::Exclusive && Option::is_some(&path_name_raw(&Box::get(bb).e)),
            _                     : false,
        };
        if (!excl_before)
        {
            return false;
        }
    }
    true
}

// The root name of a place through fields, elements and `*`.
export fn place_root_name(ref<Expr, shared> place) : Option<String>
{
    ref<Expr, shared> root = place;
    while (true)
    {
        match (&strip_parens(root).kind)
        {
            ExprKind::EField(fe) : root = &Box::get(fe).e,
            ExprKind::EIndex(ie) : root = &Box::get(ie).a,
            ExprKind::EDeref(de) : root = Box::get(de),
            _                    : break,
        }
    }
    path_name_raw(strip_parens(root))
}

// Another argument than `j` names `r` (cobc's `mentions`).
export fn other_arg_names(ref<Vec<Expr>, shared> args, usize j, ref<String, shared> r) : bool
{
    for (usize k = 0; k < Vec::len(args); k += 1)
    {
        if (k != j && names_in(&args[k], r))
        {
            return true;
        }
    }
    false
}

// CHG-0342: whether another argument names the binding at the root of
// `place` (cobc's `sibling_names_root`); a root that is not a one-segment
// name counts as named.
export fn sibling_names_root(ref<Vec<Expr>, shared> args, usize j, ref<Expr, shared> place) : bool
{
    ref<Expr, shared> xe = strip_parens(place);
    while (true)
    {
        match (&xe.kind)
        {
            ExprKind::EField(fe) : xe = strip_parens(&Box::get(fe).e),
            ExprKind::EIndex(ie) : xe = strip_parens(&Box::get(ie).a),
            ExprKind::EDeref(de) : xe = strip_parens(Box::get(de)),
            ExprKind::EPath(pe)  :
            {
                if (Vec::len(&Box::get(pe).segs) == 1)
                {
                    return other_arg_names(args, j, &Box::get(pe).segs[0]);
                }
                return true;
            },
            _                    : return true,
        }
    }
    true
}

// `StringView::of(L)` for a text literal `L`: the literal.
export fn literal_view_arg(ref<Expr, shared> e) : Option<ref<Expr, shared>>
{
    match (&strip_parens(e).kind)
    {
        ExprKind::ECall(c) :
        {
            if (Vec::len(&Box::get(c).args) != 1)
            {
                return None;
            }
            bool lit = match (&strip_parens(&Box::get(c).args[0]).kind)
            {
                ExprKind::EStr(_) : true,
                _                 : false,
            };
            bool callee = match (&Box::get(c).callee.kind)
            {
                ExprKind::EPath(p) : Vec::len(&Box::get(p).targs) == 0 && String::join(&Box::get(p).segs, "::") == "std::StringView::of",
                _                  : false,
            };
            if (lit && callee) { Some(&Box::get(c).args[0]) } else { None }
        },
        _                  : None,
    }
}

// cobc's `whole_text_view_arg`: `&s[0..$]` for a `String` place `s`, as `&s`,
// and `&(*r)[0..$]` for a place `r` of type `ref<String, shared>`, as `r`: the
// argument `String::as_view` was given for the same view (D-0302, D-0306).
export fn whole_text_view_arg(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> a) : Option<Expr>
{
    match (&strip_parens(a).kind)
    {
        ExprKind::ESliceOf(sl) :
        {
            ref<SliceExpr, shared> s = Box::get(sl);
            bool zero = match (&s.lo.kind)
            {
                ExprKind::EInt(il) : Box::get(il).v == 0,
                _                  : false,
            };
            bool dollar = match (&s.hi.kind)
            {
                ExprKind::EDollar : true,
                _                 : false,
            };
            if (s.mode != Mode::Shared || !zero || !dollar || !is_place_expr(&s.base))
            {
                return None;
            }
            match (&strip_parens(&s.base).kind)
            {
                ExprKind::EDeref(r) :
                {
                    if (!is_place_expr(Box::get(r)))
                    {
                        return None;
                    }
                    Type rt = probe_place_type(g, x, Box::get(r));
                    bool shared_string = match (&rt)
                    {
                        Type::TRef(m) : Box::get(m).mode == Mode::Shared && is_string_ty(&Box::get(m).inner),
                        _             : false,
                    };
                    if (shared_string) { Some(clone(Box::get(r))) } else { None }
                },
                _                   :
                {
                    Type bt = probe_place_type(g, x, &s.base);
                    if (!is_string_ty(&bt))
                    {
                        return None;
                    }
                    Some(mk(ExprKind::EBorrow(Box::new(BorrowExpr { .mode = Mode::Shared, .e = clone(&s.base) })), a.line, a.col))
                },
            }
        },
        _                      : None,
    }
}

export fn is_place_expr(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EPath(p)  : Vec::len(&Box::get(p).segs) == 1 && Vec::len(&Box::get(p).targs) == 0,
        ExprKind::EField(f) : is_place_expr(&Box::get(f).e),
        ExprKind::EParen(a) : is_place_expr(Box::get(a)),
        ExprKind::EIndex(i) : is_place_expr(&Box::get(i).a),
        ExprKind::EDeref(_) : true,
        _                   : false,
    }
}

// Whether the place's root name is a binding (cobc's `root_bound` with the
// scopes' test).
export fn root_bound(ref<Fx, exclusive> x, ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EPath(p) : Vec::len(&Box::get(p).segs) == 1 && is_bound(
            x,
            &Box::get(p).segs[0],
        ),
        ExprKind::EField(f) : root_bound(x, &Box::get(f).e),
        ExprKind::EParen(a) : root_bound(x, Box::get(a)),
        ExprKind::EIndex(i) : root_bound(x, &Box::get(i).a),
        ExprKind::EDeref(_) : true,
        _                   : false,
    }
}

// Every parameter of `f` that is or holds a reference is a shared one to
// plain data or a `StringView`, or an exclusive reference to scalars only
// (cobc's `view_safe_params`).
export fn view_safe_params(ref<Gen, exclusive> g, StringView key, ref<FnDecl, shared> f) : bool
{
    // D-0312: a `std` lookup writes nothing its probe views (the checker
    // refuses a probe borrowed from the map or vector it takes).
    if (in_prelude(key, f))
    {
        foreach (p in &f.params)
        {
            if (is_probe(&p.ty))
            {
                return true;
            }
        }
    }
    foreach (p in &f.params)
    {
        bool ok = match (&p.ty)
        {
            Type::TRef(pm) :
            {
                if (Box::get(pm).mode == Mode::Exclusive)
                {
                    scalars_only(
                        g,
                        &Box::get(pm).inner,
                    )
                }
                else { shared_refish(g, &p.ty) }
            },
            _              : shared_refish(g, &p.ty),
        };
        if (!ok)
        {
            return false;
        }
    }
    true
}

export fn shared_refish(ref<Gen, exclusive> g, ref<Type, shared> t) : bool
{
    if (!(has_refs(g, t) || holds_fn(g, t)))
    {
        return true;
    }
    match (t)
    {
        Type::TNamed(n) : Box::get(n).name == "std::StringView" && Vec::len(&Box::get(n).args) == 0,
        Type::TRef(m)   : Box::get(m).mode == Mode::Shared && plain_data(g, &Box::get(m).inner),
        Type::TSlice(m) : Box::get(m).mode == Mode::Shared && plain_data(g, &Box::get(m).inner),
        _               : false,
    }
}

// `String::as_view(r)` for a pure view parameter: the checks the whole-text
// view's borrows make, with none minted (cobc's `lower_as_view_unminted`; frozen
// parameters' fields come with stage 1).
export fn lower_as_view_unminted(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> vx, usize line) : V
{
    // CHG-0237: `&x.f…` of a frozen parameter (`frozen_root`): the view of
    // the field's text, no check.
    match (&strip_parens(vx).kind)
    {
        ExprKind::EBorrow(fb) :
        {
            if (Box::get(fb).mode == Mode::Shared && frozen_root(g, x, &Box::get(fb).e))
            {
                P pl = lower_place(g, x, &Box::get(fb).e);
                if (is_string_ty(&pl.ty))
                {
                    Type vty = Type::TNamed(Box::new(NamedTy { .name = "std::StringView", .args = Vec::new() }));
                    String vc = ctype(g, &vty);
                    String t = fresh(g, "t");
                    emit(x, &sprintf("%s %s;", &vc, &t));
                    emit(x, &sprintf("%s.bytes.src = (void *)&((%s).bytes);", &t, &pl.c));
                    emit(x, &sprintf("%s.bytes.data = (%s).bytes.ptr;", &t, &pl.c));
                    emit(x, &sprintf("%s.bytes.len = (%s).bytes.len;", &t, &pl.c));
                    return V { .c = t, .ty = vty, .obj = None };
                }
            }
        },
        _                     : {},
    }
    Type st = Type::TNamed(Box::new(NamedTy { .name = "std::String", .args = Vec::new() }));
    Type sref = ref_ty(clone(&st), Mode::Shared);
    // `&s` of a local: its root; the checks below are the borrow's.
    Option<Binding> local = match (&strip_parens(vx).kind)
    {
        ExprKind::EBorrow(bb) :
        {
            if (Box::get(bb).mode == Mode::Shared)
            {
                match (path_name_raw(&Box::get(bb).e))
                {
                    Some(n) :
                    {
                        match (lookup(x, &n))
                        {
                            Some(b) :
                            {
                                bool lk = match (&b.kind)
                                {
                                    BindKind::Local : true,
                                    _               : false,
                                };
                                if (lk && StringView::len(&b.root) > 0 && !HashSet::contains(
                                    &x.direct_refs,
                                    &b.c,
                                ) && !HashMap::contains(&x.unstored, &b.c) && !is_ref_type(
                                    &b.ty,
                                )) { Some(b) } else { None }
                            },
                            None    : None,
                        }
                    },
                    None    : None,
                }
            }
            else { None }
        },
        _                     : None,
    };
    V r0 = match (local)
    {
        Some(b) : V { .c = sprintf("((cb_ref){ (void *)&(%s), %s })", &b.c, &b.root), .ty = clone(&sref), .obj = None },
        None    : lower_expr(g, x, vx, Some(&sref)),
    };
    if (is_never(&r0.ty))
    {
        return never();
    }
    V r = into_temp(g, x, r0, line);
    String lc = loc(g, x.std_body, line);
    Type vty = Type::TNamed(Box::new(NamedTy { .name = "std::StringView", .args = Vec::new() }));
    String vc = ctype(g, &vty);
    String string_c = ctype(g, &st);
    String sc = sprintf("(*(%s *)%s.p)", &string_c, &r.c);
    String t = fresh(g, "t");
    emit(x, &sprintf("cb_borrow_unminted(%s.tok, NULL, 0, CB_SHARED, %s);", &r.c, &lc));
    u32 btid = bytes_tid(g);
    emit(
        x,
        &sprintf(
            "cb_borrow_range_unminted(%s.tok, (void *)&((%s).bytes), %vu, (cb_proj[]){ { CB_FIELD, 0u } }, 1, 0u, (%s).bytes.len, CB_SHARED, %s);",
            &r.c,
            &sc,
            btid,
            &sc,
            &lc,
        ),
    );
    emit(x, &sprintf("%s %s;", &vc, &t));
    emit(x, &sprintf("%s.bytes.src = (void *)&((%s).bytes);", &t, &sc));
    emit(x, &sprintf("%s.bytes.data = (%s).bytes.ptr;", &t, &sc));
    emit(x, &sprintf("%s.bytes.len = (%s).bytes.len;", &t, &sc));
    V { .c = t, .ty = vty, .obj = None }
}

// `&x` for a reader parameter, no other argument naming `x` (cobc's
// `reader_passthrough`).
export fn reader_passthrough(
    ref<Gen, exclusive> g,
    StringView name,
    ref<FnDecl, shared> f,
    ref<Vec<Expr>, shared> args,
    usize j,
) : bool
{
    if (j >= Vec::len(args))
    {
        return false;
    }
    ref<Expr, shared> place = match (&args[j].kind)
    {
        ExprKind::EBorrow(bb) :
        {
            if (Box::get(bb).mode != Mode::Shared)
            {
                return false;
            }
            &Box::get(bb).e
        },
        _                     : return false,
    };
    String xn = match (path_name_raw(place))
    {
        Some(n) : n,
        None    : return false,
    };
    bool shared_param = j < Vec::len(&f.params) && match (&f.params[j].ty)
    {
        Type::TRef(pm) : Box::get(pm).mode == Mode::Shared,
        _              : false,
    };
    if (!(appended_text(name, f, j) || (shared_param && reader_param(g, &String::copy(name), j))))
    {
        return false;
    }
    !other_arg_names(args, j, &xn)
}

// The text `String::append(s, &t)` appends: a reader (cobc's
// `appended_text`).
export fn appended_text(StringView name, ref<FnDecl, shared> f, usize j) : bool
{
    name == "std::String::append" && j == 1 && in_prelude(name, f)
}

// `String::append(&mut x, y)`, `y` inert and not naming `x` (cobc's
// `append_passthrough`).
export fn append_passthrough(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    StringView name,
    ref<FnDecl, shared> f,
    ref<Vec<Expr>, shared> args,
    usize j,
) : bool
{
    bool appends = name == "std::String::append" || name == "std::String::append_str";
    if (!appends || !in_prelude(name, f) || j != 0 || Vec::len(args) != 2 || !inert_view_arg(&args[1]))
    {
        return false;
    }
    ref<Expr, shared> place = match (&strip_parens(&args[0]).kind)
    {
        ExprKind::EBorrow(bb) : &Box::get(bb).e,
        _                     : return false,
    };
    String xn = match (path_name_raw(place))
    {
        Some(n) : n,
        None    : return false,
    };
    if (count_path_names(&args[1], &xn) > 0)
    {
        return false;
    }
    // `&t` of a `String` local: its type is the binding's.
    match (&strip_parens(&args[1]).kind)
    {
        ExprKind::EBorrow(bb) :
        {
            if (Box::get(bb).mode == Mode::Shared)
            {
                match (path_name_raw(&Box::get(bb).e))
                {
                    Some(tn) :
                    {
                        match (lookup_ref(x, &tn))
                        {
                            Some(b) :
                            {
                                if (is_string_ty(&b.ty))
                                {
                                    return true;
                                }
                            },
                            None    : {},
                        }
                    },
                    None     : {},
                }
            }
        },
        _                     : {},
    }
    Type t = probe_type(g, x, &args[1], None);
    if (x.probe_failed)
    {
        x.probe_failed = false;
        return false;
    }
    match (&t)
    {
        Type::TStr      : true,
        Type::TInt(_)   : true,
        Type::TF32      : true,
        Type::TF64      : true,
        Type::TBool     : true,
        Type::TNamed(n) : Box::get(n).name == "std::StringView" && Vec::len(&Box::get(n).args) == 0,
        Type::TRef(r)   : is_string_ty(&Box::get(r).inner),
        _               : false,
    }
}

// How many one-segment paths named `n` `e` holds (cobc's `visit_exprs` test).
export fn count_path_names(ref<Expr, shared> e, ref<String, shared> n) : usize
{
    Block b = Block { .stmts = Vec::new(), .tail = Some(Box::new(clone(e))) };
    if (lets_or_paths(&b, n)) { 1 } else { 0 }
}

export fn lets_or_paths(ref<Block, shared> b, ref<String, shared> n) : bool
{
    HashSet<String> found = HashSet::new();
    mentions_block(b, &mut found);
    HashSet::contains(&found, n)
}

// The element access's mode: a direct element argument's (`elem_mode`), else
// the call's own.
export fn elem_rm(ref<Fx, exclusive> x, str rm) : String
{
    match (&x.elem_mode)
    {
        Some(m) : String::clone(m),
        None    : String::copy(rm),
    }
}

// The call shortcuts (cobc's `lower_user_call` chain, D-0274 stage 3): the
// first that applies lowers the call.
export fn lower_call_shortcut(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    StringView name,
    ref<FnDecl, shared> f,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    Option<ref<Type, shared>> expected,
    usize line,
    Option<bool> access,
) : Option<V>
{
    // `String::append(s, x)` with a `str`: the prelude's body hands both on
    // to `append_str`; the call goes to that helper directly.
    if (name == "std::String::append" && in_prelude(name, f) && Vec::len(args) == 2)
    {
        Type t = if (Vec::len(targs) == 1) { apply(&targs[0], &x.subst) } else { probe_type(g, x, &args[1], None) };
        bool is_str = match (&t)
        {
            Type::TStr : true,
            _          : false,
        };
        if (is_str)
        {
            String h = "std::String::append_str";
            match (get_fn(g, &h))
            {
                Some(hf) :
                {
                    Vec<Type> none = Vec::new();
                    return Some(lower_user_call_access(
                        g,
                        x,
                        &h,
                        &hf,
                        &none,
                        args,
                        expected,
                        line,
                        access,
                    ));
                },
                None     : {},
            }
        }
    }
    match (lower_substring(g, x, name, f, args, line))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (lower_map_fresh_key(g, x, name, f, args, line))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (lower_push_fresh(g, x, name, f, args, line))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (lower_set_insert_fresh(g, x, name, f, args, line))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (lower_channel_send_fresh(g, x, name, f, args, line))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (lower_box_new(g, x, name, f, targs, args, expected, line))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (lower_box_get_unminted(g, x, name, f, args))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (lower_confined_call(g, x, name, f, args, line))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (lower_push_checked_once(g, x, name, f, args))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (lower_vec_checked_once(g, x, name, f, args, line))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (lower_dual_bare_call(g, x, name, f, args, line))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (lower_pred_literal(g, x, name, f, args, line))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (lower_from_fn_literal(g, x, name, f, args, line))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (lower_sort_by_literal(g, x, name, f, args))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (lower_vec_index_pre(g, x, name, f, args, line, access))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    lower_vec_len_pre(g, x, name, f, args)
}

// `String::copy(String::part(s, lo, hi))` (or `String::append(d,
// String::part(…))`), both the prelude's: the view call's arguments evaluated
// in order, then the substring helper in place of the two bodies (cobc's
// `lower_substring`).
export fn lower_substring(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    StringView name,
    ref<FnDecl, shared> f,
    ref<Vec<Expr>, shared> args,
    usize line,
) : Option<V>
{
    if (!in_prelude(name, f))
    {
        return None;
    }
    if (Vec::len(args) == 0)
    {
        return None;
    }
    Option<ref<Expr, shared>> dst = None;
    ref<Expr, shared> a0 = &args[0];
    if (name == "std::String::copy" && Vec::len(args) == 1)
    {
        a0 = &args[0];
    }
    else if (name == "std::String::append" && Vec::len(args) == 2)
    {
        dst = Some(&args[0]);
        a0 = &args[1];
    }
    else
    {
        return None;
    }
    ref<CallExpr, shared> vc = match (&strip_parens(a0).kind)
    {
        ExprKind::ECall(c) : Box::get(c),
        _                  : return None,
    };
    ref<PathExpr, shared> vp = match (&vc.callee.kind)
    {
        ExprKind::EPath(p) : Box::get(p),
        _                  : return None,
    };
    if (Vec::len(&vp.targs) > 0 || Vec::len(&vc.args) != 3)
    {
        return None;
    }
    // Resolved as `pure_view_in` resolves a callee.
    String k = String::join(&vp.segs, "::");
    String iname = if (HashMap::contains(&g.prog.table.fns, &k)) { k } else { sprintf("std::%s", &k) };
    if (iname != "std::String::part" || (Vec::len(&vp.segs) == 1 && is_bound(x, &vp.segs[0])))
    {
        return None;
    }
    FnDecl vf = match (get_fn(g, &iname))
    {
        Some(v) : v,
        None    : return None,
    };
    if (!in_prelude(&iname, &vf))
    {
        return None;
    }
    Type st = Type::TNamed(Box::new(NamedTy { .name = "std::String", .args = Vec::new() }));
    // `append`'s first argument, evaluated first, as the call would.
    Option<V> d = None;
    match (dst)
    {
        Some(de) :
        {
            Type dref = ref_ty(clone(&st), Mode::Exclusive);
            V dv = lower_expr(g, x, de, Some(&dref));
            if (is_never(&dv.ty))
            {
                return Some(dv);
            }
            bool excl = match (&dv.ty)
            {
                Type::TRef(m) : Box::get(m).mode == Mode::Exclusive,
                _             : false,
            };
            assert(excl, "cobc: `String::append`'s first argument is not an exclusive reference");
            d = Some(into_temp(g, x, dv, line));
        },
        None     : {},
    }
    Type sref = ref_ty(clone(&st), Mode::Shared);
    V s0 = lower_expr(g, x, &vc.args[0], Some(&sref));
    if (is_never(&s0.ty))
    {
        return Some(s0);
    }
    assert(is_ref_type(&s0.ty), "cobc: `String::part`'s first argument is not a reference");
    V sv = into_temp(g, x, s0, line);
    Type us = Type::TInt(IntTy::Usize);
    V lo0 = lower_expr(g, x, &vc.args[1], Some(&us));
    if (is_never(&lo0.ty))
    {
        return Some(lo0);
    }
    V lo = into_temp(g, x, lo0, line);
    V hi0 = lower_expr(g, x, &vc.args[2], Some(&us));
    if (is_never(&hi0.ty))
    {
        return Some(hi0);
    }
    V hi = into_temp(g, x, hi0, line);
    match (&d)
    {
        Some(dd) :
        {
            String helper = append_substring_helper(g);
            at(g, x, line);
            emit(x, &sprintf("%s(%s, %s, %s, %s);", &helper, &dd.c, &sv.c, &lo.c, &hi.c));
            return Some(unit());
        },
        None     : {},
    }
    String helper = substring_helper(g);
    String sc = ctype(g, &st);
    at(g, x, line);
    String t = fresh(g, "t");
    if (opt_eq(&x.raw_substring, &Some(args_key(args))))
    {
        x.raw_substring = None;
        emit(x, &sprintf("%s %s = %s_raw(%s, %s, %s);", &sc, &t, &helper, &sv.c, &lo.c, &hi.c));
        names_add(x, NameSet::InertC, String::clone(&t));
        return Some(V { .c = t, .ty = st, .obj = None });
    }
    emit(x, &sprintf("%s %s = %s(%s, %s, %s);", &sc, &t, &helper, &sv.c, &lo.c, &hi.c));
    String o = take_result(g, x, &t, &st, line);
    Some(V { .c = t, .ty = st, .obj = Some(o) })
}

// D-0292: the type id of a `String`'s bytes (`Vec<u8>`), the place a view's
// range borrow names.
export fn bytes_tid(ref<Gen, exclusive> g) : u32
{
    Vec<Type> a = Vec::new();
    Vec::push(&mut a, Type::TInt(IntTy::U8));
    type_id(g, &Type::TNamed(Box::new(NamedTy { .name = "std::Vec", .args = a })))
}

// `Box::get(b)` / `Box::get_mut(b)` on an unminted arm binder: the native
// body inline, its read of the box's pointer through the binder's base and
// projection (cobc's in `lower_user_call`).
export fn lower_box_get_unminted(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    StringView name,
    ref<FnDecl, shared> f,
    ref<Vec<Expr>, shared> args,
) : Option<V>
{
    if (!(name == "std::Box::get" || name == "std::Box::get_mut") || !in_prelude(name, f) || Vec::len(args) != 1)
    {
        return None;
    }
    String bn = match (path_name_raw(&args[0]))
    {
        Some(n) : n,
        None    : return None,
    };
    Binding bind = match (lookup(x, &bn))
    {
        Some(b) : b,
        None    : return None,
    };
    Unminted um = match (HashMap::get(&x.unminted_binders, &bind.c))
    {
        Some(u) : clone(u),
        None    : return None,
    };
    Type bt = match (&bind.ty)
    {
        Type::TRef(m) : clone(&Box::get(m).inner),
        _             :
        {
            assert(false, "cobc: a box binder");
            Type::TVoid
        },
    };
    Type elem = match (&bt)
    {
        Type::TNamed(n) :
        {
            assert(Vec::len(&Box::get(n).args) == 1, "cobc: a box's type");
            clone(&Box::get(n).args[0])
        },
        _               :
        {
            assert(false, "cobc: a box binder's type");
            Type::TVoid
        },
    };
    String bc = ctype(g, &bt);
    u32 tid = type_id(g, &elem);
    bool shared = name == "std::Box::get";
    Mode mode = if (shared) { Mode::Shared } else { Mode::Exclusive };
    str md = if (shared) { "CB_SHARED" } else { "CB_EXCLUSIVE" };
    Vec<String> all = clone(&um.projs);
    Vec::push(&mut all, "{ CB_FIELD, 0u }");
    String av = fresh(g, "a");
    String r = fresh(g, "r");
    if (StringView::len(&um.tok) > 0)
    {
        if (!shared)
        {
            // D-0222: `_ = &mut *b;`, the box exclusively.
            if (Vec::len(&um.projs) == 0)
            {
                emit(x, &sprintf("cb_borrow_check(%s, NULL, 0, CB_EXCLUSIVE, CB_NOLOC, 0);", &um.tok));
            }
            else
            {
                emit(
                    x,
                    &sprintf(
                        "cb_borrow_check(%s, (cb_proj[]){ %s }, %v, CB_EXCLUSIVE, CB_NOLOC, 0);",
                        &um.tok,
                        &String::join(&um.projs, ", "),
                        Vec::len(&um.projs),
                    ),
                );
            }
        }
        emit(
            x,
            &sprintf(
                "cb_read(%s, (cb_proj[]){ %s }, %v, CB_NOLOC, 0);",
                &um.tok,
                &String::join(&all, ", "),
                Vec::len(&all),
            ),
        );
    }
    emit(x, &sprintf("void *%s = (void *)((%s *)%s)->ptr;", &av, &bc, &bind.c));
    emit(
        x,
        &sprintf("cb_ref %s = (cb_ref){ %s, cb_elem_borrow(%s, %vu, %s) };", &r, &av, &av, tid, md),
    );
    emit(x, "cb_recv_ref();");
    if (x.tracked)
    {
        // D-0292: recorded on arrival in a recording frame.
        emit(
            x,
            &sprintf(
                "%s.tok = cb_rec_ref(%s.tok, %s.p, %vu, %s, 0u, CB_NOLOC, 0);",
                &r,
                &r,
                &r,
                tid,
                md,
            ),
        );
    }
    Some(V { .c = r, .ty = ref_ty(elem, mode), .obj = None })
}

// `i < n` a loop over a plain local `i` whose one write, outside any nested
// loop, is `i = i + 1` and that nothing declares again: that addition cannot
// overflow (cobc's `loop_increment`); its id.
export fn loop_increment(
    ref<Fx, exclusive> x,
    ref<Expr, shared> c,
    ref<Block, shared> body,
    ref<Option<Expr>, shared> step,
) : Option<usize>
{
    ref<BinaryExpr, shared> lt = match (&c.kind)
    {
        ExprKind::EBinary(bx) : Box::get(bx),
        _                     : return None,
    };
    if (lt.op != BinOp::Lt)
    {
        return None;
    }
    String xn = match (&lt.a.kind)
    {
        ExprKind::EPath(p) :
        {
            if (Vec::len(&Box::get(p).segs) != 1)
            {
                return None;
            }
            String::clone(&Box::get(p).segs[0])
        },
        _                  : return None,
    };
    let_plain(x, &xn)?;
    LoopScan sc = LoopScan { .x = xn, .writes = Vec::new(), .nested = Vec::new(), .declares = false };
    ls_block(&mut sc, body, false);
    match (step)
    {
        Some(st) : ls_expr(&mut sc, st, false),
        None     : {},
    }
    if (Vec::len(&sc.writes) != 1 || sc.nested[0] || sc.declares)
    {
        return None;
    }
    ref<Expr, shared> w = &sc.writes[0];
    ref<PairExpr, shared> asg = match (&w.kind)
    {
        ExprKind::EAssign(pa) : Box::get(pa),
        _                     : return None,
    };
    ref<BinaryExpr, shared> add = match (&asg.b.kind)
    {
        ExprKind::EBinary(bx) : Box::get(bx),
        _                     : return None,
    };
    if (add.op != BinOp::Add)
    {
        return None;
    }
    bool is_x = match (&add.a.kind)
    {
        ExprKind::EPath(p) : Vec::len(&Box::get(p).segs) == 1 && ((Box::get(p).segs[0]) == sc.x),
        _                  : false,
    };
    bool is_one = match (&add.b.kind)
    {
        ExprKind::EInt(il) : Box::get(il).v == 1,
        _                  : false,
    };
    if (is_x && is_one) { Some(asg.b.id) } else { None }
}

// The loop variable is a plain local integer with no object.
fn let_plain(ref<Fx, exclusive> x, ref<String, shared> n) : Option<bool>
{
    match (lookup_ref(x, n))
    {
        Some(b) :
        {
            bool local = match (&b.kind)
            {
                BindKind::Local : true,
                _               : false,
            };
            bool int = match (&b.ty)
            {
                Type::TInt(_) : true,
                _             : false,
            };
            if (StringView::len(&b.root) == 0 && local && int) { Some(true) } else { None }
        },
        None    : None,
    }
}

struct LoopScan
{
    String x;
    Vec<Expr> writes;
    Vec<bool> nested;
    bool declares;
}

fn ls_expr(ref<LoopScan, exclusive> sc, ref<Expr, shared> e, bool nested)
{
    match (&e.kind)
    {
        ExprKind::EAssign(p)      :
        {
            match (&Box::get(p).a.kind)
            {
                ExprKind::EPath(lp) :
                {
                    if (Vec::len(&Box::get(lp).segs) == 1 && ((Box::get(lp).segs[0]) == sc.x))
                    {
                        Vec::push(&mut sc.writes, clone(e));
                        Vec::push(&mut sc.nested, nested);
                    }
                },
                _                   : {},
            }
            ls_expr(sc, &Box::get(p).a, nested);
            ls_expr(sc, &Box::get(p).b, nested);
        },
        ExprKind::EUnary(u)       : ls_expr(sc, &Box::get(u).e, nested),
        ExprKind::EBorrow(bb)     : ls_expr(sc, &Box::get(bb).e, nested),
        ExprKind::EDeref(a)       : ls_expr(sc, Box::get(a), nested),
        ExprKind::EField(f)       : ls_expr(sc, &Box::get(f).e, nested),
        ExprKind::EPropagate(a)   : ls_expr(sc, Box::get(a), nested),
        ExprKind::EParen(a)       : ls_expr(sc, Box::get(a), nested),
        ExprKind::EBinary(bx)     :
        {
            ls_expr(sc, &Box::get(bx).a, nested);
            ls_expr(sc, &Box::get(bx).b, nested);
        },
        ExprKind::EIndex(p)       :
        {
            ls_expr(sc, &Box::get(p).a, nested);
            ls_expr(sc, &Box::get(p).b, nested);
        },
        ExprKind::ESliceOf(sl)    :
        {
            ls_expr(sc, &Box::get(sl).base, nested);
            ls_expr(sc, &Box::get(sl).lo, nested);
            ls_expr(sc, &Box::get(sl).hi, nested);
        },
        ExprKind::ECall(cl)       :
        {
            ls_expr(sc, &Box::get(cl).callee, nested);
            foreach (a in &Box::get(cl).args)
            {
                ls_expr(sc, a, nested);
            }
        },
        ExprKind::EStructLit(sl)  :
        {
            foreach (fi in &Box::get(sl).fields)
            {
                ls_expr(sc, &fi.value, nested);
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            foreach (a in es)
            {
                ls_expr(sc, a, nested);
            }
        },
        ExprKind::EArrayRepeat(a) : ls_expr(sc, &Box::get(a).value, nested),
        ExprKind::EBlock(bl)      : ls_block(sc, bl, nested),
        ExprKind::EUnsafe(bl)     : ls_block(sc, bl, nested),
        ExprKind::EIf(i)          :
        {
            ls_expr(sc, &Box::get(i).cond, nested);
            ls_block(sc, &Box::get(i).then_, nested);
            match (&Box::get(i).else_)
            {
                Some(f) : ls_expr(sc, f, nested),
                None    : {},
            }
        },
        ExprKind::EWhile(w)       :
        {
            ls_expr(sc, &Box::get(w).cond, true);
            ls_block(sc, &Box::get(w).body, true);
            match (&Box::get(w).step)
            {
                Some(st) : ls_expr(sc, st, true),
                None     : {},
            }
        },
        ExprKind::EMatch(m)       :
        {
            ls_expr(sc, &Box::get(m).scrut, nested);
            foreach (a in &Box::get(m).arms)
            {
                match (&a.binder)
                {
                    Some(bn) :
                    {
                        if (*bn == sc.x)
                        {
                            sc.declares = true;
                        }
                    },
                    None     : {},
                }
                ls_expr(sc, Box::get(&a.body), nested);
            }
        },
        ExprKind::EReturn(v)      :
        {
            match (v)
            {
                Some(r) : ls_expr(sc, Box::get(r), nested),
                None    : {},
            }
        },
        ExprKind::EClosure(cl)    :
        {
            foreach (pd in &Box::get(cl).params)
            {
                if (pd.name == sc.x)
                {
                    sc.declares = true;
                }
            }
            ls_block(sc, &Box::get(cl).body, true);
        },
        _                         : {},
    }
}

fn ls_block(ref<LoopScan, exclusive> sc, ref<Block, shared> b, bool nested)
{
    foreach (st in &b.stmts)
    {
        match (st)
        {
            Stmt::SLet(l)         :
            {
                if (((Box::get(l).name) == sc.x))
                {
                    sc.declares = true;
                }
                match (&Box::get(l).init)
                {
                    Some(e) : ls_expr(sc, e, nested),
                    None    : {},
                }
            },
            Stmt::SDestructure(d) :
            {
                foreach (fd in &Box::get(d).fields)
                {
                    if (*fd == sc.x)
                    {
                        sc.declares = true;
                    }
                }
                ls_expr(sc, &Box::get(d).init, nested);
            },
            Stmt::SExpr(e)        : ls_expr(sc, Box::get(e), nested),
            Stmt::SBlockLike(e)   : ls_expr(sc, Box::get(e), nested),
        }
    }
    match (&b.tail)
    {
        Some(t) : ls_expr(sc, Box::get(t), nested),
        None    : {},
    }
}

// What a body does to one name (`loop_bound`): its writes, its borrows,
// whether anything declares the name again, and whether it is named at all;
// a closure that names or declares it counts as a borrow (cobc's
// `NameScan`).
struct NameScan
{
    String x;
    usize writes;
    bool borrows;
    bool declares;
    bool named;
}

fn name_scan(ref<String, shared> x) : NameScan
{
    NameScan { .x = String::clone(x), .writes = 0, .borrows = false, .declares = false, .named = false }
}

fn ns_is_x(ref<NameScan, shared> sc, ref<Expr, shared> e) : bool
{
    match (&strip_parens(e).kind)
    {
        ExprKind::EPath(p) : Vec::len(&Box::get(p).segs) == 1 && ((Box::get(p).segs[0]) == sc.x),
        _                  : false,
    }
}

fn ns_expr(ref<NameScan, exclusive> sc, ref<Expr, shared> e)
{
    match (&e.kind)
    {
        ExprKind::EPath(p)        :
        {
            if (Vec::len(&Box::get(p).segs) == 1 && ((Box::get(p).segs[0]) == sc.x))
            {
                sc.named = true;
            }
        },
        ExprKind::EAssign(p)      :
        {
            if (ns_is_x(sc, &Box::get(p).a))
            {
                sc.writes += 1;
            }
            ns_expr(sc, &Box::get(p).a);
            ns_expr(sc, &Box::get(p).b);
        },
        ExprKind::EBorrow(bb)     :
        {
            if (ns_is_x(sc, &Box::get(bb).e))
            {
                sc.borrows = true;
            }
            ns_expr(sc, &Box::get(bb).e);
        },
        ExprKind::EUnary(u)       : ns_expr(sc, &Box::get(u).e),
        ExprKind::EDeref(a)       : ns_expr(sc, Box::get(a)),
        ExprKind::EField(f)       : ns_expr(sc, &Box::get(f).e),
        ExprKind::EPropagate(a)   : ns_expr(sc, Box::get(a)),
        ExprKind::EParen(a)       : ns_expr(sc, Box::get(a)),
        ExprKind::EBinary(bx)     :
        {
            ns_expr(sc, &Box::get(bx).a);
            ns_expr(sc, &Box::get(bx).b);
        },
        ExprKind::EIndex(p)       :
        {
            ns_expr(sc, &Box::get(p).a);
            ns_expr(sc, &Box::get(p).b);
        },
        ExprKind::ESliceOf(sl)    :
        {
            ns_expr(sc, &Box::get(sl).base);
            ns_expr(sc, &Box::get(sl).lo);
            ns_expr(sc, &Box::get(sl).hi);
        },
        ExprKind::ECall(cl)       :
        {
            ns_expr(sc, &Box::get(cl).callee);
            foreach (a in &Box::get(cl).args)
            {
                ns_expr(sc, a);
            }
        },
        ExprKind::EStructLit(sl)  :
        {
            foreach (fi in &Box::get(sl).fields)
            {
                ns_expr(sc, &fi.value);
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            foreach (a in es)
            {
                ns_expr(sc, a);
            }
        },
        ExprKind::EArrayRepeat(a) : ns_expr(sc, &Box::get(a).value),
        ExprKind::EBlock(bl)      : ns_block(sc, &bl.stmts, 0, &bl.tail),
        ExprKind::EUnsafe(bl)     : ns_block(sc, &bl.stmts, 0, &bl.tail),
        ExprKind::EIf(i)          :
        {
            ns_expr(sc, &Box::get(i).cond);
            ns_block(sc, &Box::get(i).then_.stmts, 0, &Box::get(i).then_.tail);
            match (&Box::get(i).else_)
            {
                Some(f) : ns_expr(sc, f),
                None    : {},
            }
        },
        ExprKind::EWhile(w)       :
        {
            ns_expr(sc, &Box::get(w).cond);
            ns_block(sc, &Box::get(w).body.stmts, 0, &Box::get(w).body.tail);
            match (&Box::get(w).step)
            {
                Some(st) : ns_expr(sc, st),
                None     : {},
            }
        },
        ExprKind::EMatch(m)       :
        {
            ns_expr(sc, &Box::get(m).scrut);
            foreach (a in &Box::get(m).arms)
            {
                match (&a.binder)
                {
                    Some(bn) :
                    {
                        if (*bn == sc.x)
                        {
                            sc.declares = true;
                        }
                    },
                    None     : {},
                }
                ns_expr(sc, Box::get(&a.body));
            }
        },
        ExprKind::EReturn(v)      :
        {
            match (v)
            {
                Some(r) : ns_expr(sc, Box::get(r)),
                None    : {},
            }
        },
        ExprKind::EClosure(cl)    :
        {
            foreach (pd in &Box::get(cl).params)
            {
                if (pd.name == sc.x)
                {
                    sc.declares = true;
                }
            }
            foreach (cp in &Box::get(cl).captures)
            {
                if (*cp == sc.x)
                {
                    sc.borrows = true;
                }
            }
            // A closure may capture the name: counted as a borrow.
            NameScan inner = name_scan(&sc.x);
            ns_block(&mut inner, &Box::get(cl).body.stmts, 0, &Box::get(cl).body.tail);
            if (inner.writes > 0 || inner.borrows || inner.declares || inner.named)
            {
                sc.borrows = true;
            }
        },
        _                         : {},
    }
}

// The statements from `from` on, then the tail.
fn ns_block(ref<NameScan, exclusive> sc, ref<Vec<Stmt>, shared> stmts, usize from, ref<Option<Box<Expr>>, shared> tail)
{
    for (usize i = from; i < Vec::len(stmts); i += 1)
    {
        match (&stmts[i])
        {
            Stmt::SLet(l)         :
            {
                if (((Box::get(l).name) == sc.x))
                {
                    sc.declares = true;
                }
                match (&Box::get(l).init)
                {
                    Some(e) : ns_expr(sc, e),
                    None    : {},
                }
            },
            Stmt::SDestructure(d) :
            {
                foreach (fd in &Box::get(d).fields)
                {
                    if (*fd == sc.x)
                    {
                        sc.declares = true;
                    }
                }
                ns_expr(sc, &Box::get(d).init);
            },
            Stmt::SExpr(e)        : ns_expr(sc, Box::get(e)),
            Stmt::SBlockLike(e)   : ns_expr(sc, Box::get(e)),
        }
    }
    match (tail)
    {
        Some(t) : ns_expr(sc, Box::get(t)),
        None    : {},
    }
}

// The name a path of one segment names, if the expression is one.
fn one_path(ref<Expr, shared> e) : Option<String>
{
    match (&e.kind)
    {
        ExprKind::EPath(p) :
        {
            if (Vec::len(&Box::get(p).segs) == 1) { Some(String::clone(&Box::get(p).segs[0])) } else { None }
        },
        _                  : None,
    }
}

// Whether `name` is neither written, borrowed nor declared again in the
// statements from `from` on (and the tail), and neither borrowed nor declared
// again in the step.
fn ns_clean(
    ref<String, shared> name,
    ref<Block, shared> body,
    usize from,
    ref<Option<Expr>, shared> step,
) : bool
{
    NameScan s = name_scan(name);
    ns_block(&mut s, &body.stmts, from, &body.tail);
    NameScan t = name_scan(name);
    match (step)
    {
        Some(st) : ns_expr(&mut t, st),
        None     : {},
    }
    s.writes == 0 && !s.borrows && !s.declares && !t.borrows && !t.declares
}

// A loop's variable, its bound, and the body's first statement's name for
// the variable (`loop_bound`).
struct LoopBound
{
    String x;
    String n;
    Option<String> alias;
}

// D-0309: a loop `while (x < n)` (or a `for` with that test and a `step`)
// over plain locals `x` and `n` whose body writes, borrows and declares again
// neither, and whose step writes no `n` and borrows neither: wherever the
// body reads `x`, `x < n` with `n` as it was before the loop
// (`version_loops`). The body's first statement's name when it is `T k = x;`
// and the rest writes, borrows and declares again no `k` (cobc's
// `loop_bound`).
fn loop_bound(
    ref<Fx, exclusive> x,
    ref<Expr, shared> c,
    ref<Block, shared> body,
    ref<Option<Expr>, shared> step,
) : Option<LoopBound>
{
    ref<BinaryExpr, shared> lt = match (&c.kind)
    {
        ExprKind::EBinary(bx) : Box::get(bx),
        _                     : return None,
    };
    if (lt.op != BinOp::Lt)
    {
        return None;
    }
    String xn = one_path(&lt.a)?;
    String nn = one_path(&lt.b)?;
    if (xn == nn)
    {
        return None;
    }
    let_plain(x, &xn)?;
    let_plain(x, &nn)?;
    NameScan n_step = name_scan(&nn);
    match (step)
    {
        Some(st) : ns_expr(&mut n_step, st),
        None     : {},
    }
    if (!ns_clean(&xn, body, 0, step) || !ns_clean(&nn, body, 0, step) || n_step.writes > 0)
    {
        return None;
    }
    Option<String> alias = None;
    if (Vec::len(&body.stmts) > 0)
    {
        match (&body.stmts[0])
        {
            Stmt::SLet(l) :
            {
                ref<LetStmt, shared> ls = Box::get(l);
                match (&ls.init)
                {
                    Some(e) :
                    {
                        match (one_path(e))
                        {
                            Some(p) :
                            {
                                if ((p == xn) && ls.name != xn && ls.name != nn
                                    && ns_clean(&ls.name, body, 1, step))
                                {
                                    alias = Some(String::clone(&ls.name));
                                }
                            },
                            None    : {},
                        }
                    },
                    None    : {},
                }
            },
            _             : {},
        }
    }
    Some(LoopBound { .x = xn, .n = nn, .alias = alias })
}

// The tag of a bounds check of index `i` against the fixed length `hl`
// (`hoist_vec_headers`) when `i` names the innermost loop's variable in its
// body (`VerLoop`), its length then recorded; otherwise none (cobc's
// `version_tag`).
export fn version_tag(ref<Fx, exclusive> x, ref<Expr, shared> i, ref<String, shared> hl) : String
{
    usize nv = Vec::len(&x.versions);
    if (nv == 0)
    {
        return String::new();
    }
    String name = match (one_path(strip_parens(i)))
    {
        Some(n) : n,
        None    : return String::new(),
    };
    match (&mut x.versions[nv - 1])
    {
        Some(v) :
        {
            bool mine = false;
            foreach (n in &v.names)
            {
                if (*n == name)
                {
                    mine = true;
                }
            }
            if (!v.in_body || !mine)
            {
                return String::new();
            }
            bool have = false;
            foreach (l in &v.lens)
            {
                if (*l == *hl)
                {
                    have = true;
                }
            }
            if (!have)
            {
                Vec::push(&mut v.lens, String::clone(hl));
            }
            sprintf("%s%s*/ ", VER_TAG, hl)
        },
        None    : String::new(),
    }
}

// D-0274 stage 2: an element of a `const fn` array of literals (integers,
// `bool`s, texts, floats, or arrays of them) read at a run-time index: from the
// same values laid out once as C static data, with the same bounds check;
// `K[i][j]` indexes the static data at each level (cobc's `const_array_read`).
export fn const_array_read(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e) : Option<V>
{
    if (boot(g, 2))
    {
        return None;
    }
    // The depth of indexing: `K[i][j]` is 2, its indices read by `nth_index`.
    usize depth = 0;
    ref<Expr, shared> cur = e;
    while (true)
    {
        match (&cur.kind)
        {
            ExprKind::EIndex(p) :
            {
                depth += 1;
                cur = strip_parens(&Box::get(p).a);
            },
            _                   : break,
        }
    }
    if (depth == 0)
    {
        return None;
    }
    ref<CallExpr, shared> call = match (&cur.kind)
    {
        ExprKind::ECall(c) : Box::get(c),
        _                  : return None,
    };
    ref<PathExpr, shared> path = match (&call.callee.kind)
    {
        ExprKind::EPath(p) : Box::get(p),
        _                  : return None,
    };
    if (Vec::len(&call.args) > 0 || Vec::len(&path.targs) > 0)
    {
        return None;
    }
    String name = String::join(&path.segs, "::");
    // D-0315: the head first (most calls are not of a constant).
    match (fn_head(g, &name))
    {
        Some(h) :
        {
            if (!h.is_const || h.nparams > 0 || h.ntype_params > 0)
            {
                return None;
            }
        },
        None    : return None,
    }
    FnDecl f = match (get_fn(g, &name))
    {
        Some(f) : f,
        None    : return None,
    };
    if (!f.is_const || Vec::len(&f.params) > 0 || Vec::len(&f.type_params) > 0)
    {
        return None;
    }
    ref<SizedTy, shared> arr = match (&f.ret)
    {
        Type::TArray(a) : Box::get(a),
        _               : return None,
    };
    u128 n = arr.n;
    ref<Vec<Expr>, shared> es = match (&f.body.tail)
    {
        Some(t) :
        {
            match (&Box::get(t).kind)
            {
                ExprKind::EArrayLit(es) : es,
                _                       : return None,
            }
        },
        None    : return None,
    };
    if (Vec::len(&f.body.stmts) > 0 || widen<u128>(Vec::len(es)) != n || n == 0)
    {
        return None;
    }
    // Each further index needs an array at its level.
    Vec<u128> bounds = Vec::new();
    Vec::push(&mut bounds, n);
    Type ty = clone(&arr.inner);
    for (usize k = 1; k < depth; k += 1)
    {
        Type next = match (&ty)
        {
            Type::TArray(a) :
            {
                Vec::push(&mut bounds, Box::get(a).n);
                clone(&Box::get(a).inner)
            },
            _               : return None,
        };
        ty = next;
    }
    Vec<String> vals = Vec::new();
    foreach (xe in es)
    {
        match (const_lit_init(g, &arr.inner, xe))
        {
            Some(v) : Vec::push(&mut vals, v),
            None    : return None,
        }
    }
    String ec = elem_c_type(g, &arr.inner);
    String access = String::new();
    for (usize k = 0; k < depth; k += 1)
    {
        u128 b = bounds[k];
        Vec::push(&mut x.dollar, sprintf("%vu", b));
        Type us = Type::TInt(IntTy::Usize);
        V i = lower_expr(g, x, nth_index(e, depth - 1 - k), Some(&us));
        Vec::pop(&mut x.dollar);
        V it = into_temp(g, x, i, e.line);
        String lc = loc(g, x.std_body, e.line);
        emit(x, &sprintf("cb_index_check((uint64_t)%s, %vu, %s);", &it.c, b, &lc));
        if (k == 0)
        {
            String::append(&mut access, &sprintf("k_[%s]", &it.c));
        }
        else
        {
            String::append(&mut access, &sprintf(".a[%s]", &it.c));
        }
    }
    String rc = elem_c_type(g, &ty);
    String t = fresh(g, "t");
    emit(
        x,
        &sprintf(
            "%s %s = ({ static const %s k_[%v] = { %s }; %s; });",
            &rc,
            &t,
            &ec,
            n,
            &String::join(&vals, ", "),
            &access,
        ),
    );
    Some(V { .c = t, .ty = ty, .obj = None })
}

// The index of the indexing `steps` levels in from `e` (`K[i][j]`: 0 is `j`).
fn nth_index(ref<Expr, shared> e, usize steps) : ref<Expr, shared>
{
    ref<Expr, shared> cur = e;
    usize k = 0;
    while (true)
    {
        match (&cur.kind)
        {
            ExprKind::EIndex(p) :
            {
                if (k == steps)
                {
                    return &Box::get(p).b;
                }
                k += 1;
                cur = strip_parens(&Box::get(p).a);
            },
            _                   : break,
        }
    }
    assert(false, "cobc: an index of a constant's read");
    e
}

// The C type a constant array's element is laid out as (cobc's match in
// `const_array_read`).
fn elem_c_type(ref<Gen, exclusive> g, ref<Type, shared> t) : String
{
    match (t)
    {
        Type::TInt(it) : String::copy(c_int_type(*it)),
        Type::TBool    : "uint8_t",
        _              : ctype(g, t),
    }
}

// The C initialiser of a constant array's element `xe` of type `ty`, when it is
// a literal (or an array of literals) C can lay out as static data; `None`
// otherwise. A text is its literal's bytes (`cb_s_…`) and length; an array is its
// `struct a_arr…`'s one member (cobc's `const_lit_init`).
fn const_lit_init(ref<Gen, exclusive> g, ref<Type, shared> ty, ref<Expr, shared> xe0) : Option<String>
{
    ref<Expr, shared> xe = strip_parens(xe0);
    match (ty)
    {
        Type::TInt(it)  :
        {
            if (*it == IntTy::I128 || *it == IntTy::U128)
            {
                return None;
            }
            u128 v = match (&xe.kind)
            {
                ExprKind::EInt(il) : Box::get(il).v,
                _                  : return None,
            };
            // A literal the checker accepted fits the type; its bits as the
            // unsigned type of that width, cast back.
            u32 bw = int_ty_bits(*it, 64);
            if (bw < 128 && (v >> bw) != 0)
            {
                return None;
            }
            Some(sprintf("(%s)%vULL", c_int_type(*it), narrow_wrapping<u64>(v)))
        },
        Type::TBool : match (&xe.kind)
        {
            ExprKind::EBool(b) : Some(String::copy(if (*b) { "1" } else { "0" })),
            _                  : None,
        },
        Type::TF32 : match (&xe.kind)
        {
            ExprKind::EFloat(fl) : Some(c_float(Box::get(fl).v, true)),
            _                    : None,
        },
        Type::TF64 : match (&xe.kind)
        {
            ExprKind::EFloat(fl) : Some(c_float(Box::get(fl).v, false)),
            _                    : None,
        },
        Type::TStr : match (&xe.kind)
        {
            ExprKind::EStr(s) : Some(sprintf("{ %s, %vu }", &str_lit_name(g, s), StringView::len(s))),
            _                 : None,
        },
        Type::TArray(a) :
        {
            ref<SizedTy, shared> inner = Box::get(a);
            ref<Vec<Expr>, shared> es = match (&xe.kind)
            {
                ExprKind::EArrayLit(es) : es,
                _                       : return None,
            };
            if (widen<u128>(Vec::len(es)) != inner.n || inner.n == 0)
            {
                return None;
            }
            Vec<String> vals = Vec::new();
            foreach (y in es)
            {
                match (const_lit_init(g, &inner.inner, y))
                {
                    Some(v) : Vec::push(&mut vals, v),
                    None    : return None,
                }
            }
            Some(sprintf("{ { %s } }", &String::join(&vals, ", ")))
        },
        _               : None,
    }
}

// A call's identity for the call state (`map_acc`, `map_get_acc`,
// `datum_tok`): cobc compares its arguments' address; here its first
// argument's id (every argument list cobc could tell apart by address has
// one), and one value for every empty list, as cobc's dangling pointer is.
export fn args_key(ref<Vec<Expr>, shared> args) : usize
{
    if (Vec::len(args) > 0) { args[0].id } else { 1 << 61 }
}

// A `match`'s identity for `raw_tail`: its first arm's body (cobc: the arms'
// address).
export fn arms_key(ref<Vec<Arm>, shared> arms) : Option<usize>
{
    if (Vec::len(arms) > 0) { Some(Box::get(&arms[0].body).id) } else { None }
}

// `match (HashMap::get_mut(…)) { Some(c) : *c op= x, None : … }`, `x` a
// literal or a local other than `c` (cobc's `get_mut_acc_arms`).
export fn get_mut_acc_arms(ref<Expr, shared> scrut, ref<Vec<Arm>, shared> arms) : bool
{
    match (&strip_parens(scrut).kind)
    {
        ExprKind::ECall(c) :
        {
            match (&Box::get(c).callee.kind)
            {
                ExprKind::EPath(p) :
                {
                    String k = String::join(&Box::get(p).segs, "::");
                    if ((k != "HashMap::get_mut" && k != "std::HashMap::get_mut") || Vec::len(arms) != 2)
                    {
                        return false;
                    }
                },
                _                  : return false,
            }
        },
        _                  : return false,
    }
    usize some = 0;
    bool other_ok = true;
    foreach (a in arms)
    {
        bool is_some = match (&a.variant)
        {
            Some(v) : *v == "Some",
            None    : false,
        };
        bool is_none = match (&a.variant)
        {
            Some(v) : *v == "None",
            None    : true,
        };
        if (is_some)
        {
            some += 1;
            other_ok = other_ok && match (&a.binder)
            {
                Some(cb) : acc_arm_body(Box::get(&a.body), cb),
                None     : false,
            };
        }
        else if (is_none)
        {
            other_ok = other_ok && Option::is_none(&a.binder) && Vec::len(&a.nested) == 0 && Option::is_none(&a.lit);
        }
        else
        {
            other_ok = false;
        }
    }
    some == 1 && other_ok
}

// The `Some` arm's body is `*c op= x` alone (a block of that statement or
// that tail, or the expression).
export fn acc_arm_body(ref<Expr, shared> body, ref<String, shared> c) : bool
{
    ref<Expr, shared> b = strip_parens(body);
    Expr e = match (&b.kind)
    {
        ExprKind::EBlock(bl) :
        {
            if (Vec::len(&bl.stmts) == 1 && Option::is_none(&bl.tail))
            {
                match (&bl.stmts[0])
                {
                    Stmt::SExpr(x) : clone(Box::get(x)),
                    _              : return false,
                }
            }
            else if (Vec::len(&bl.stmts) == 0)
            {
                match (&bl.tail)
                {
                    Some(t) : clone(Box::get(t)),
                    None    : return false,
                }
            }
            else
            {
                return false;
            }
        },
        _                    : clone(b),
    };
    compound_write_inert(&Stmt::SExpr(Box::new(e)), c)
}

// `*t = *t op e;` for the hidden `t`, with `e` a literal or a local (cobc's
// `compound_write_inert`).
export fn compound_write_inert(ref<Stmt, shared> s, ref<String, shared> t) : bool
{
    ref<Expr, shared> e = match (s)
    {
        Stmt::SExpr(e) : Box::get(e),
        _              : return false,
    };
    ref<PairExpr, shared> asg = match (&e.kind)
    {
        ExprKind::EAssign(p) : Box::get(p),
        _                    : return false,
    };
    ref<BinaryExpr, shared> bin = match (&strip_parens(&asg.b).kind)
    {
        ExprKind::EBinary(bx) : Box::get(bx),
        _                     : return false,
    };
    if (!deref_named(&asg.a, t) || !deref_named(&bin.a, t))
    {
        return false;
    }
    match (&strip_parens(&bin.b).kind)
    {
        ExprKind::EInt(_)   : return true,
        ExprKind::EFloat(_) : return true,
        ExprKind::EBool(_)  : return true,
        _                   : {},
    }
    match (path_name_raw(&bin.b))
    {
        Some(n) : n != *t && !StringView::starts_with(&n, "__"),
        None    : false,
    }
}

export fn deref_named(ref<Expr, shared> e, ref<String, shared> t) : bool
{
    match (&strip_parens(e).kind)
    {
        ExprKind::EDeref(d) :
        {
            match (path_name_raw(Box::get(d)))
            {
                Some(n) : (n == *t),
                None    : false,
            }
        },
        _                   : false,
    }
}

struct ElemRefLet
{
    String name;
    Expr place;
    Mode mode;
}

// `let r = &x[i];` (or `&(*x)[i]`) followed only by reads (and, `&mut`,
// writes) through `*r`, nothing after naming `x` (cobc's `elem_ref_let`).
export fn elem_ref_let(ref<Stmt, shared> s, ref<Block, shared> b, usize rest) : Option<ElemRefLet>
{
    ref<LetStmt, shared> l = match (s)
    {
        Stmt::SLet(lb) : Box::get(lb),
        _              : return None,
    };
    match (&l.ty)
    {
        Some(t) :
        {
            if (!is_ref_type(t))
            {
                return None;
            }
        },
        None    : {},
    }
    ref<Expr, shared> init = match (&l.init)
    {
        Some(i) : i,
        None    : return None,
    };
    ref<BorrowExpr, shared> bw = match (&init.kind)
    {
        ExprKind::EBorrow(bb) : Box::get(bb),
        _                     : return None,
    };
    ref<PairExpr, shared> ix = match (&strip_parens(&bw.e).kind)
    {
        ExprKind::EIndex(p) : Box::get(p),
        _                   : return None,
    };
    Option<String> xn = match (&strip_parens(&ix.a).kind)
    {
        ExprKind::EDeref(p) : plain_name(strip_parens(Box::get(p))),
        _                   : plain_name(strip_parens(&ix.a)),
    };
    String xs = match (xn)
    {
        Some(n) : n,
        None    : return None,
    };
    if ((xs == l.name) || StringView::starts_with(&xs, "$") || StringView::starts_with(&l.name, "$"))
    {
        return None;
    }
    bool w = bw.mode == Mode::Exclusive;
    for (usize i = rest; i < Vec::len(&b.stmts); i += 1)
    {
        bool names_x = match (&b.stmts[i])
        {
            Stmt::SLet(ol)        :
            {
                ((Box::get(ol).name) == xs) || match (&Box::get(ol).init)
                {
                    Some(oe) : names_in(oe, &xs),
                    None     : false,
                }
            },
            Stmt::SDestructure(d) : vec_has_name(&Box::get(d).fields, &xs) || names_in(&Box::get(d).init, &xs),
            Stmt::SExpr(oe)       : names_in(Box::get(oe), &xs),
            Stmt::SBlockLike(oe)  : names_in(Box::get(oe), &xs),
        };
        if (names_x)
        {
            return None;
        }
    }
    match (&b.tail)
    {
        Some(t) :
        {
            if (names_in(Box::get(t), &xs))
            {
                return None;
            }
        },
        None    : {},
    }
    if (!stmts_only_derefs_from(b, rest, &l.name, w))
    {
        return None;
    }
    Some(ElemRefLet { .name = String::clone(&l.name), .place = clone(&bw.e), .mode = bw.mode })
}

export fn vec_has_name(ref<Vec<String>, shared> v, ref<String, shared> s) : bool
{
    foreach (x in v)
    {
        if (*x == *s)
        {
            return true;
        }
    }
    false
}

// `let r = &m x[i];` on a confined vector `x`: after the bounds check, `r` is
// bound as a direct reference to the element (cobc's `bind_elem_ref`). `None`
// when `x` is not confined, else whether the index diverged.
export fn bind_elem_ref(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> name,
    ref<Expr, shared> place,
    Mode mode,
    Option<usize> line,
) : Option<bool>
{
    bool write = mode == Mode::Exclusive;
    Expr sy = match (vec_index_call(g, x, place, write))
    {
        Some(s) : s,
        None    : return None,
    };
    ref<Expr, shared> inner = match (&sy.kind)
    {
        ExprKind::EDeref(i) : Box::get(i),
        _                   : return None,
    };
    bool confined = match (&inner.kind)
    {
        ExprKind::ECall(c) : Vec::len(&Box::get(c).args) > 0 && Option::is_some(&confined_local(
            x,
            &Box::get(c).args[0],
        )),
        _ : false,
    };
    if (!confined)
    {
        return None;
    }
    push_stmt_at(g, x, line);
    usize ln = match (line)
    {
        Some(l) : l,
        None    : place.line,
    };
    P p = Option::expect(elem_access_place(g, x, inner, write, ln), "cobc: a confined element with no place");
    if (is_never(&p.ty))
    {
        return Some(true);
    }
    String el = sprintf("l_%s_%s", &san(name), &fresh(g, ""));
    emit(x, &sprintf("void *%s = (void *)&(%s);", &el, &p.c));
    names_add(x, NameSet::DirectRefs, String::clone(&el));
    bind_in_scope(
        x,
        name,
        Binding { .c = el, .ty = ref_ty(clone(&p.ty), mode), .root = String::new(), .kind = BindKind::Local },
    );
    pop_stmt(x);
    Some(false)
}

struct ForeachAlias
{
    String name;
    Expr alias;
}

// A `foreach` element `x` the body uses only as `*x` (or hands only to
// readers): `x` stands for `(*$c)[$i]` (cobc's `foreach_alias`), and the
// loop's holder `$c` is confined for the loop.
export fn foreach_alias(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Stmt, shared> s,
    Option<ref<Stmt, shared>> next,
) : Option<ForeachAlias>
{
    if (boot(g, 4))
    {
        return None;
    }
    ref<LetStmt, shared> l = match (s)
    {
        Stmt::SLet(lb) : Box::get(lb),
        _              : return None,
    };
    if (Option::is_some(&l.ty))
    {
        return None;
    }
    ref<Expr, shared> init = match (&l.init)
    {
        Some(i) : i,
        None    : return None,
    };
    ref<CallExpr, shared> call = match (&init.kind)
    {
        ExprKind::ECall(c) : Box::get(c),
        _                  : return None,
    };
    bool mutable0 = callee_is_name(&call.callee, "$each_at_mut");
    if (!(mutable0 || callee_is_name(
        &call.callee,
        "$each_at",
    ) || callee_is_name(&call.callee, "$each_take")) || Vec::len(&call.args) != 3)
    {
        return None;
    }
    String hname = match (&call.args[0].kind)
    {
        ExprKind::EPath(hp) :
        {
            if (Vec::len(&Box::get(hp).segs) != 1)
            {
                return None;
            }
            String::clone(&Box::get(hp).segs[0])
        },
        _                   : return None,
    };
    Option<Binding> hb = lookup(x, &hname);
    // `foreach (x in v)` over an exclusive reference written without `&`:
    // `$each_at_mut`'s loop.
    bool excl_holder = match (&hb)
    {
        Some(b) :
        {
            match (&b.ty)
            {
                Type::TRef(m) : Box::get(m).mode == Mode::Exclusive,
                _             : false,
            }
        },
        None    : false,
    };
    bool mutable = mutable0 || (callee_is_name(&call.callee, "$each_take") && excl_holder);
    ref<Block, shared> body = match (next)
    {
        Some(ns) :
        {
            match (ns)
            {
                Stmt::SBlockLike(bx) :
                {
                    match (&Box::get(bx).kind)
                    {
                        ExprKind::EBlock(bb) : bb,
                        _                    : return None,
                    }
                },
                _                    : return None,
            }
        },
        None     : return None,
    };
    // The element type, and whether the holder is a slice.
    Type hty = match (&hb)
    {
        Some(b) : clone(&b.ty),
        None    : return None,
    };
    Type elem = Type::TVoid;
    bool is_slice = false;
    match (&hty)
    {
        Type::TRef(m)   :
        {
            ref<ModedTy, shared> mt = Box::get(m);
            if (mt.mode == Mode::Exclusive && mutable)
            {
                elem = match (&mt.inner)
                {
                    Type::TNamed(n) : if (Box::get(n).name == "std::Vec" && Vec::len(&Box::get(n).args) == 1) { clone(&Box::get(n).args[0]) } else { return None },
                    _               : return None,
                };
            }
            else if (mt.mode == Mode::Shared && !mutable)
            {
                elem = match (&mt.inner)
                {
                    Type::TNamed(n) : if (Box::get(n).name == "std::Vec" && Vec::len(&Box::get(n).args) == 1) { clone(&Box::get(n).args[0]) } else { return None },
                    Type::TArray(a) : clone(&Box::get(a).inner),
                    _               : return None,
                };
            }
            else
            {
                return None;
            }
        },
        Type::TSlice(m) :
        {
            if (Box::get(m).mode != Mode::Shared)
            {
                return None;
            }
            elem = clone(&Box::get(m).inner);
            is_slice = true;
        },
        _               : return None,
    }
    u64 size = size_align(g, &elem).size;
    // A shared loop over elements that own something but hold no reference,
    // the body handing `x` only to readers or reading plain fields: `x` is
    // the element with token 0.
    bool reader = !is_slice && size > 0 && !plain_data(
        g,
        &elem,
    ) && !has_refs(g, &elem) && !holds_fn(g, &elem) && foreach_reader(g, body, &l.name);
    if (size == 0 || !(reader || (plain_data(g, &elem) && block_only_derefs(body, &l.name, mutable))))
    {
        return None;
    }
    usize line = init.line;
    // The loop's holder `$c` of a `Vec` read this way is confined for the
    // loop: each step's `(*$c)[$i]` and the condition's `$each_len($c)` need
    // only the bounds check.
    if (!is_slice)
    {
        match (&hb)
        {
            Some(b) :
            {
                match (&b.ty)
                {
                    Type::TRef(m) :
                    {
                        bool is_vec = match (&Box::get(m).inner)
                        {
                            Type::TNamed(n) : Box::get(n).name == "std::Vec",
                            _               : false,
                        };
                        if (is_vec)
                        {
                            String vec_c = ctype(g, &Box::get(m).inner);
                            HashMap::insert(
                                &mut x.confined_params,
                                String::clone(&hname),
                                ConfinedVec { .c = sprintf(
                                    "(*(%s *)%s)",
                                    &vec_c,
                                    &b.c,
                                ), .path = "0", .elem = clone(&elem) },
                            );
                        }
                    },
                    _             : {},
                }
            },
            None    : {},
        }
    }
    Expr a0 = renumbered(g, &call.args[0]);
    Expr base = if (is_slice) { a0 } else { synth(g, ExprKind::EDeref(Box::new(a0)), line, init.col) };
    Expr a1 = renumbered(g, &call.args[1]);
    Expr alias = synth(g, ExprKind::EIndex(Box::new(PairExpr { .a = base, .b = a1 })), line, init.col);
    Some(ForeachAlias { .name = String::clone(&l.name), .alias = alias })
}

export fn callee_is_name(ref<Expr, shared> c, str n) : bool
{
    match (&c.kind)
    {
        ExprKind::EPath(p) : Vec::len(&Box::get(p).segs) == 1 && Box::get(p).segs[0] == n,
        _                  : false,
    }
}

export fn foreach_reader(ref<Gen, exclusive> g, ref<Block, shared> body, ref<String, shared> name) : bool
{
    CalleeTest reads = CalleeTest::ClosureReads(bound_names(body));
    reader_uses(g, body, name, false, &reads)
}

// A value where a `fn` type is expected; a value read through a shared
// reference whose closures may hold exclusive captures is checked
// (D-0218 `[Read-Fn-Through-Shared]`).
export fn lower_expr(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> e,
    Option<ref<Type, shared>> expected,
) : V
{
    bool saved = replace(&mut x.place_write, false);
    V v = lower_expr_inner(g, x, e, expected);
    x.place_write = saved;
    bool boxed = match (&v.ty)
    {
        Type::TClosure(_) : match (expected)
        {
            Some(t) : match (t)
            {
                Type::TFn(_) : true,
                _            : false,
            },
            None : false,
        },
        _ : false,
    };
    if (boxed)
    {
        Type dst = clone(Option::unwrap(expected));
        // D-0315 (step 4): a stack box where its parameter does not escape
        // (`stack_box_at`).
        x.stack_box = match (x.stack_box_at)
        {
            Some(i) : i == e.id,
            None    : false,
        };
        V b = box_closure(g, x, v, dst, e.line);
        x.stack_box = false;
        return b;
    }
    if (HashSet::contains(&g.prog.facts.shared_fn_reads, e.id) && !is_never(&v.ty))
    {
        String lc = loc(g, x.std_body, e.line);
        V t = into_temp(g, x, v, e.line);
        match (&t.ty)
        {
            Type::TFn(_) : emit(x, &sprintf("cb_fn_shared(%s, %s);", &t.c, &lc)),
            _            :
            {
                u32 tid = type_id(g, &t.ty);
                emit(x, &sprintf("cb_fn_shared_value(&%s, %vu, %s);", &t.c, tid, &lc));
            },
        }
        return t;
    }
    v
}

export fn lower_expr_inner(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> e,
    Option<ref<Type, shared>> expected,
) : V
{
    match (&e.kind)
    {
        ExprKind::EFloat(fl)      :
        {
            bool single = match (&Box::get(fl).sfx)
            {
                Some(sx) : *sx == "f32",
                None : match (expected)
                {
                    Some(t) : match (t)
                    {
                        Type::TF32 : true,
                        _          : false,
                    },
                    None : false,
                },
            };
            V { .c = c_float(
                Box::get(fl).v,
                single,
            ), .ty = if (single) { Type::TF32 } else { Type::TF64 }, .obj = None }
        },
        ExprKind::EInt(l)         :
        {
            // D-0090: `T x = 0` with `T` a floating-point type.
            match (float_literal(g, e, &Box::get(l).sfx, expected))
            {
                Some(single) :
                {
                    return V { .c = c_float(
                        to_float<f64>(Box::get(l).v),
                        single,
                    ), .ty = if (single) { Type::TF32 } else { Type::TF64 }, .obj = None };
                },
                None         : {},
            }
            IntTy ty = int_lit_type(&Box::get(l).sfx, expected);
            V { .c = c_int(ty, Box::get(l).v), .ty = Type::TInt(ty), .obj = None }
        },
        ExprKind::EBool(b)        : V { .c = if (*b) { "1" } else { "0" }, .ty = Type::TBool, .obj = None },
        ExprKind::EUnit           : unit(),
        ExprKind::EMatch(mx)      : lower_match(g, x, &Box::get(mx).scrut, &Box::get(mx).arms, expected, e.line),
        ExprKind::EPropagate(i)   : lower_propagate(g, x, e, Box::get(i), expected),
        ExprKind::EStructLit(sl) : lower_struct_lit(
            g,
            x,
            &Box::get(sl).segs,
            &Box::get(sl).targs,
            &Box::get(sl).fields,
            expected,
            e.line,
        ),
        ExprKind::EField(_)       : lower_place_value(g, x, e, expected),
        ExprKind::EIndex(_)       : lower_place_value(g, x, e, expected),
        ExprKind::EDeref(_)       : lower_place_value(g, x, e, expected),
        ExprKind::EBorrow(b)      : lower_borrow(g, x, e, Box::get(b).mode, &Box::get(b).e, expected),
        ExprKind::EStr(t)         : lower_str_lit(g, x, t),
        ExprKind::EUnary(u)       : lower_unary(g, x, Box::get(u).op, &Box::get(u).e, expected, e.line),
        ExprKind::EReturn(r)      : lower_return(g, x, r),
        ExprKind::EBreak          : lower_jump(g, x, true),
        ExprKind::EContinue       : lower_jump(g, x, false),
        ExprKind::EDollar         : V { .c = String::clone(&x.dollar[Vec::len(&x.dollar) - 1]), .ty = Type::TInt(IntTy::Usize), .obj = None },
        ExprKind::EParen(i)       : lower_expr(g, x, Box::get(i), expected),
        ExprKind::EPath(p)        :
        {
            // A direct reference parameter handed on whole: the reference
            // the call was given, its path unchanged.
            if (Vec::len(&Box::get(p).segs) == 1)
            {
                match (lookup(x, &Box::get(p).segs[0]))
                {
                    Some(b) :
                    {
                        if (HashSet::contains(&x.direct_refs, &b.c) && is_ref_type(&b.ty))
                        {
                            String pc = if (StringView::starts_with(
                                &b.c,
                                "l_",
                            ))
                            {
                                String::copy(&b.c[2..$])
                            }
                            else { String::clone(&b.c) };
                            return V { .c = sprintf(
                                "((cb_ref){ %s, (%s).tok })",
                                &b.c,
                                &pc,
                            ), .ty = clone(&b.ty), .obj = None };
                        }
                    },
                    None    : {},
                }
            }
            if (Vec::len(&Box::get(p).segs) == 1 && is_bound(x, &Box::get(p).segs[0]))
            {
                P pl = lower_place(g, x, e);
                return read_place(g, x, pl, e.line);
            }
            // A `foreach` element aliased for a reader loop, used whole: the
            // element's address with token 0.
            if (Vec::len(&Box::get(p).segs) == 1)
            {
                match (HashMap::get(&x.elem_alias, &Box::get(p).segs[0]))
                {
                    Some(a0) :
                    {
                        Expr a = clone(a0);
                        P ap = lower_place(g, x, &a);
                        if (is_never(&ap.ty))
                        {
                            return never();
                        }
                        return V { .c = sprintf(
                            "((cb_ref){ (void *)&(%s), 0 })",
                            &ap.c,
                        ), .ty = ref_ty(clone(&ap.ty), Mode::Shared), .obj = None };
                    },
                    None     : {},
                }
            }
            match (variant_of(g, &Box::get(p).segs))
            {
                Some(vr) : return construct_variant(g, x, &vr.ename, vr.vi, &Box::get(p).targs, None, expected, e.line),
                None     : {},
            }
            match (get_fn(g, &String::join(&Box::get(p).segs, "::")))
            {
                Some(f) : return lower_fn_item(
                    g,
                    x,
                    &String::join(&Box::get(p).segs, "::"),
                    &f,
                    &Box::get(p).targs,
                    expected,
                ),
                None : {},
            }
            // In a probe, cobc's internal error: the probe fails.
            if (x.probing > 0)
            {
                x.probe_failed = true;
                return unit();
            }
            eprintf(
                "cbc: unresolved path `%s` (line %v)\n",
                &String::join(&Box::get(p).segs, "::"),
                e.line,
            );
            assert(false, "cbc: a path not ported yet");
            unit()
        },
        ExprKind::EBinary(b) : lower_binary_expr(
            g,
            x,
            e,
            Box::get(b).op,
            &Box::get(b).a,
            &Box::get(b).b,
            expected,
        ),
        ExprKind::ECall(c)        :
        {
            // D-0309: a self tail call is lowered as a jump (`lower_user_call`)
            // in a body that records nothing.
            bool tail = !x.tracked && Vec::len(&x.tail_targets) > 0 && HashSet::contains(&g.prog.facts.self_tails, e.id);
            bool was = replace(&mut x.self_tail_now, tail);
            V r = lower_call_expr(g, x, e, Box::get(c), expected);
            x.self_tail_now = was;
            r
        },
        ExprKind::EIf(i) : lower_if(
            g,
            x,
            &Box::get(i).cond,
            &Box::get(i).then_,
            &Box::get(i).else_,
            expected,
            e.line,
        ),
        ExprKind::EBlock(b)       : lower_block_expr(g, x, b, expected, e.line),
        ExprKind::EUnsafe(b)      : lower_block_expr(g, x, b, expected, e.line),
        ExprKind::EWhile(w)       : lower_while(g, x, &Box::get(w).cond, &Box::get(w).body, &Box::get(w).step),
        ExprKind::EAssign(p)      : lower_assign(g, x, e, &Box::get(p).a, &Box::get(p).b),
        ExprKind::EArrayLit(es)   :
        {
            match (simd_expected(expected))
            {
                Some(ty) : return lower_simd_lit(g, x, es, ty),
                None     : {},
            }
            lower_array_lit(g, x, es, expected, e.line)
        },
        ExprKind::ESliceOf(sl)    : lower_slice_expr(g, x, e, Box::get(sl)),
        ExprKind::EClosure(cl)    :
        {
            ref<ClosureExpr, shared> c = Box::get(cl);
            match (&c.ret)
            {
                Some(rt) : lower_closure(g, x, c.is_move, &c.captures, &c.params, Some(rt), &c.body, e.line),
                None     : lower_closure(g, x, c.is_move, &c.captures, &c.params, None, &c.body, e.line),
            }
        },
        ExprKind::EArrayRepeat(r) :
        {
            match (simd_expected(expected))
            {
                Some(ty) : return lower_simd_repeat(g, x, &Box::get(r).value, Box::get(r).n, ty),
                None     : {},
            }
            lower_array_repeat(g, x, &Box::get(r).value, Box::get(r).n, expected, e.line)
        },
    }
}

// ---- statements ----

// One statement; whether it diverged.
export fn lower_stmt(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Stmt, shared> st) : bool
{
    match (st)
    {
        Stmt::SLet(lb)        :
        {
            ref<LetStmt, shared> l = Box::get(lb);
            // `foreach (x in p)` over a confined parameter or holder `p`: its
            // hidden holders `$e = p` and `$d = $each_drain($e, n)` are `p`
            // under other names, bound as a direct reference is.
            if (Option::is_none(&l.ty) && StringView::starts_with(&l.name, "$"))
            {
                match (&l.init)
                {
                    Some(he) :
                    {
                        match (confined_holder(x, he))
                        {
                            Some(cv) :
                            {
                                Vec<Type> va = Vec::new();
                                Vec::push(&mut va, clone(&cv.elem));
                                Type vty = Type::TNamed(Box::new(NamedTy { .name = "std::Vec", .args = va }));
                                String vec_c = ctype(g, &vty);
                                String hl = sprintf("l_%s_%s", &san(&l.name), &fresh(g, ""));
                                emit(x, &sprintf("void *%s = (void *)&(%s);", &hl, &cv.c));
                                names_add(x, NameSet::DirectRefs, String::clone(&hl));
                                bind_in_scope(
                                    x,
                                    &l.name,
                                    Binding { .c = String::clone(&hl), .ty = ref_ty(
                                        vty,
                                        Mode::Shared,
                                    ), .root = String::new(), .kind = BindKind::Local },
                                );
                                HashMap::insert(
                                    &mut x.confined_params,
                                    String::clone(&l.name),
                                    ConfinedVec { .c = sprintf(
                                        "(*(%s *)%s)",
                                        &vec_c,
                                        &hl,
                                    ), .path = String::clone(&cv.path), .elem = clone(&cv.elem) },
                                );
                                return false;
                            },
                            None     : {},
                        }
                    },
                    None     : {},
                }
            }
            // D-0315: `_ = e;` (`{ auto $discard = e; }`, D-0099) in a decided
            // program: `e`'s value is ended where its statement ends, as a
            // discarded expression statement's is.
            if (g.decided && Option::is_none(&l.ty) && l.name == "$discard")
            {
                match (&l.init)
                {
                    Some(de) : return lower_expr_stmt(g, x, de),
                    None     : {},
                }
            }
            // D-0320: a value known before the run that nothing assigns (a
            // `foreach` range's end among them), for the length guard of a loop
            // that follows; a binding of the name that is not such a value hides
            // an earlier one.
            if (!boot(g, 2))
            {
                Option<u128> kv = None;
                if (!HashSet::contains(&x.assigned, &l.name))
                {
                    match (&l.init)
                    {
                        Some(ie) :
                        {
                            kv = known_value(g, &l.name, ie);
                        },
                        None     : {},
                    }
                }
                match (kv)
                {
                    Some(v) :
                    {
                        HashMap::insert(&mut x.const_locals, String::clone(&l.name), v);
                    },
                    None    :
                    {
                        HashMap::remove(&mut x.const_locals, &l.name);
                    },
                }
            }
            Option<Type> declared = match (&l.ty)
            {
                Some(t) : Some(apply(t, &x.subst)),
                None    : None,
            };
            String cname = sprintf("l_%s_%s", &san(&l.name), &fresh(g, ""));
            match (&l.init)
            {
                Some(ie) :
                {
                    if (HashSet::contains(&x.elem_ref_ids, ie.id) && x.probing == 0)
                    {
                        Option<bool> done = match (&declared)
                        {
                            Some(t) : lower_elem_ref_let(g, x, &l.name, &cname, Some(t), ie),
                            None    : lower_elem_ref_let(g, x, &l.name, &cname, None, ie),
                        };
                        match (done)
                        {
                            Some(d) : return d,
                            None    : {},
                        }
                    }
                },
                None     : {},
            }
            match (&l.init)
            {
                Some(e) :
                {
                    // D-0200: a fused text loop's bare piece trimmed into a
                    // local (`bare_trims`): a bare view of the trimmed range.
                    if (HashSet::contains(&x.bare_trims, &l.name))
                    {
                        match (lower_bare_trim(g, x, &l.name, &cname, &declared, e))
                        {
                            Some(d) : return d,
                            None    : {},
                        }
                    }
                    // An objectless `String` made by `String::copy_str` or
                    // `String::clone`: the copy's `_raw` variant.
                    Option<bool> fresh_done = match (&declared)
                    {
                        Some(t) : bind_fresh_objectless(g, x, &l.name, &cname, Some(t), e),
                        None    : bind_fresh_objectless(g, x, &l.name, &cname, None, e),
                    };
                    match (fresh_done)
                    {
                        Some(d) : return d,
                        None    : {},
                    }
                    // D-0196: `String s = f(…);` into an objectless `s`, `f` a
                    // function whose `__raw` form exists; only when the binding
                    // is objectless too (CHG-0345).
                    if (HashSet::contains(&x.objectless_names.ids, e.id))
                    {
                        set_raw_call(g, x, e, &declared);
                    }
                    V v0 = match (&declared)
                    {
                        Some(t) : lower_expr(g, x, e, Some(t)),
                        None    : lower_expr(g, x, e, None),
                    };
                    x.raw_call = None;
                    x.inert_result = None;
                    // A closure-typed binding the body borrows or captures
                    // (`pinned_names`) is kept as a callable box: a reference
                    // to it is then a reference to a `fn` value, as the
                    // callee reads it. Its value, copies and calls are the
                    // box's.
                    u64 pin_id = match (&v0.ty)
                    {
                        Type::TClosure(i) : *i,
                        _                 : 0,
                    };
                    // So is one the body assigns whole: the closure assigned
                    // is of another type (`f = move [b]() …` after `auto f =
                    // move [a]() …`), boxed as well.
                    bool pin_box = Option::is_none(&declared)
                        && is_closure(&v0.ty)
                        && (HashSet::contains(&x.pinned, &l.name) || HashSet::contains(&x.assigned, &l.name));
                    V v = if (pin_box)
                    {
                        ClosureInfo info = clone(Option::expect(
                            HashMap::get(&g.closures, pin_id),
                            "a lowered closure",
                        ));
                        Type dst = Type::TFn(Box::new(FnTy { .params = clone(&info.params), .ret = clone(&info.ret) }));
                        box_closure(g, x, v0, dst, e.line)
                    }
                    else
                    {
                        v0
                    };
                    Type ty = match (&declared)
                    {
                        Some(t) : clone(t),
                        None    : clone(&v.ty),
                    };
                    if (is_never(&v.ty))
                    {
                        return true;
                    }
                    V v2 = match (&ty)
                    {
                        Type::TRef(_) : into_temp(g, x, v, e.line),
                        _             : v,
                    };
                    String c = ctype(g, &ty);
                    emit(x, &sprintf("%s %s;", &c, &cname));
                    String bound_c = String::clone(&cname);
                    x.cur_let = Some(e.id);
                    bind_value_let(g, x, &l.name, cname, &ty, &v2, e.line, true);
                    x.cur_let = None;
                    bind_confined(g, x, &l.name, &bound_c, &ty);
                    bind_reader_slice(g, x, &l.name, &bound_c, &ty);
                },
                None    :
                {
                    Type ty = Option::expect(declared, "`auto x;` has no type");
                    String c = ctype(g, &ty);
                    emit(x, &sprintf("%s %s;", &c, &cname));
                    if (unchecked(g, x, &l.name, &ty))
                    {
                        // Definite assignment (`spec/11` §3) proves every read.
                        bind_in_scope(
                            x,
                            &l.name,
                            Binding { .c = cname, .ty = ty, .root = String::new(), .kind = BindKind::Local },
                        );
                        return false;
                    }
                    // D-0315: pinned plain data of a decided program: root token 0.
                    if (pinned_plain(g, &ty))
                    {
                        bind_in_scope(x, &l.name, Binding { .c = cname, .ty = ty, .root = "0", .kind = BindKind::Local });
                        return false;
                    }
                    // D-0315 (step 4): a decided program's candidate whose end frees
                    // memory alone: no object, its moved flag set until the first
                    // assignment.
                    usize key = uninit_key(l);
                    if (g.decided && x.probing == 0 && HashSet::contains(&x.objectless_names.ids, key) && is_resource(
                        g,
                        &ty,
                    ) && !has_refs(g, &ty) && objectless_type(g, &ty) && objectless_binding(g, x, key, &ty))
                    {
                        u32 tid0 = type_id(g, &ty);
                        Option<usize> saved = replace(&mut x.cur_let, Some(key));
                        objectless_bound(g, x, &cname, tid0, &ty);
                        x.cur_let = saved;
                        String fl = match (HashMap::get(&x.moved_flag, &cname))
                        {
                            Some(f) : String::clone(f),
                            None    :
                            {
                                assert(false, "cobc: an objectless local with no value and no moved flag");
                                String::new()
                            },
                        };
                        emit(x, &sprintf("%s = 1;", &fl));
                        bind_in_scope(x, &l.name, Binding { .c = cname, .ty = ty, .root = String::new(), .kind = BindKind::Local });
                        return false;
                    }
                    u32 tid = type_id(g, &ty);
                    String o = fresh(g, "o");
                    emit(
                        x,
                        &sprintf("uint64_t %s = cb_new_uninit(&%s, %vu, %s);", &o, &cname, tid, NOLOC),
                    );
                    String root = fresh(g, "root");
                    emit(x, &sprintf("uint64_t %s = cb_bind(%s);", &root, &o));
                    note_frame(g, x, &l.name, &root);
                    bind_in_scope(
                        x,
                        &l.name,
                        Binding { .c = cname, .ty = ty, .root = root, .kind = BindKind::Local },
                    );
                },
            }
            false
        },
        Stmt::SExpr(e)        : lower_expr_stmt(g, x, Box::get(e)),
        Stmt::SBlockLike(e)   : lower_expr_stmt(g, x, Box::get(e)),
        Stmt::SDestructure(d) : lower_destructure(g, x, Box::get(d)),
    }
}

export fn lower_expr_stmt(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e) : bool
{
    x.stmt_match = is_match(e);
    // D-0315: a decided program's discarded call result (or `?`'s value) is
    // taken with no object and dropped where the statement ends.
    bool call = match (&strip_parens(e).kind)
    {
        ExprKind::ECall(_)      : true,
        ExprKind::EPropagate(_) : true,
        _                       : false,
    };
    if (g.decided && call)
    {
        arm_inert(g, x, e, true);
    }
    V v = lower_expr(g, x, e, None);
    x.inert_result = None;
    x.stmt_match = false;
    if (is_never(&v.ty))
    {
        return true;
    }
    if (Option::is_none(&v.obj) && HashSet::contains(&x.inert_c, &v.c) && is_resource(g, &v.ty))
    {
        V t = into_temp(g, x, v, e.line);
        u32 tid = type_id(g, &t.ty);
        // A value with a destructor of its own is noted, as a statement
        // temporary is (D-0315 step 4).
        bool noted = g.decided && !objectless_type(g, &t.ty) && noted_type(g, &t.ty);
        bool dropped = !has_refs(g, &t.ty) && (objectless_type(g, &t.ty) || noted) && stmt_temp_drop(
            g,
            x,
            &t.c,
            tid,
            &t.ty,
            noted,
        );
        if (!dropped)
        {
            // Its end is the statement's, by its object.
            _ = materialize(g, x, &t, e.line);
        }
        emit(x, &sprintf("(void)(%s);", &t.c));
        return false;
    }
    if (!is_void(&v.ty))
    {
        if (Option::is_none(&v.obj) && holds_fn(g, &v.ty))
        {
            // D-0089: a discarded value's closures end with it.
            V t = into_temp(g, x, v, e.line);
            u32 tid = type_id(g, &t.ty);
            emit(x, &sprintf("cb_drop_value(&%s, %vu);", &t.c, tid));
        }
        else
        {
            emit(x, &sprintf("(void)(%s);", &v.c));
        }
    }
    false
}

// Whether every check on a local of this type is proven (`spec/14` §6): a
// plain type the body never borrows, captures or drops; such a local needs
// no runtime object.
export fn unchecked(ref<Gen, shared> g, ref<Fx, shared> x, StringView name, ref<Type, shared> ty) : bool
{
    // D-0315: a slice of a decided program is plain data (`plain_slice`).
    !is_resource(g, ty) && (!has_refs(g, ty) || plain_slice(g, ty)) && !holds_fn(g, ty) && !is_closure(ty) && !HashSet::contains(
        &x.pinned_ws,
        &String::copy(name),
    )
}

// A value becomes a binding's initial contents: the binding's object is the
// moved resource, or a fresh object at its address.
export fn bind_value(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    StringView name,
    String cname,
    ref<Type, shared> ty,
    ref<V, shared> v,
    usize line,
)
{
    bind_value_let(g, x, name, cname, ty, v, line, false);
}

// `is_let`: a `let`'s value (`cur_let`), which a plain value holding
// references with an object of its own gives to the binding (adopted).
export fn bind_value_let(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    StringView name,
    String cname,
    ref<Type, shared> ty,
    ref<V, shared> v,
    usize line,
    bool is_let,
)
{
    // A new binding of the name: whatever `confined_params` recorded for an
    // earlier one is not this one.
    HashMap::remove(&mut x.confined_params, &String::copy(name));
    bool is_ref = match (ty)
    {
        Type::TRef(_) : true,
        _             : false,
    };
    if (is_ref && HashSet::contains(&x.held_locals, &String::copy(name)) && !unchecked(g, x, name, ty))
    {
        // A reference local never assigned, borrowed or captured: the frame
        // holds its path (`cb_frame_hold`) as its binding object would, and
        // its uses go through that path's token.
        V r = into_temp(g, x, clone(v), line);
        String tk = fresh(g, "tk");
        emit(x, &sprintf("%s = (%s).p;", &cname, &r.c));
        emit(x, &sprintf("uint64_t %s = (%s).tok;", &tk, &r.c));
        emit(x, &sprintf("cb_frame_hold(%s);", &tk));
        names_put(x, NameMap::Unstored, String::clone(&cname), tk);
        names_add(x, NameSet::HeldC, String::clone(&cname));
        bind_in_scope(x, name, Binding { .c = cname, .ty = clone(ty), .root = String::new(), .kind = BindKind::Local });
        return;
    }
    bool adopt = is_let && !is_resource(
        g,
        ty,
    ) && has_refs(g, ty) && !is_ref && Option::is_some(&v.obj) && type_eq(&v.ty, ty) && !unchecked(g, x, name, ty);
    if (adopt)
    {
        emit(x, &sprintf("%s = %s;", &cname, &v.c));
    }
    else
    {
        store(g, x, &cname, ty, v);
    }
    if (unchecked(g, x, name, ty))
    {
        bind_in_scope(x, name, Binding { .c = cname, .ty = clone(ty), .root = String::new(), .kind = BindKind::Local });
        return;
    }
    // D-0315: pinned plain data of a decided program, or a reference there
    // (its token is 0 and no path is kept): root token 0.
    if (Option::is_none(&v.obj) && (pinned_plain(g, ty) || decided_ref(g, ty)))
    {
        bind_in_scope(x, name, Binding { .c = cname, .ty = clone(ty), .root = "0", .kind = BindKind::Local });
        return;
    }
    String lc = loc(g, x.std_body, line);
    u32 tid = type_id(g, ty);
    String o = fresh(g, "o");
    // An objectless value (`objectless_strings`): the received object's
    // record ends, the local owns the value, its drop is made where the
    // binding ends.
    bool objectless_ok = match (x.cur_let)
    {
        Some(id) : objectless_binding(g, x, id, ty),
        None     : false,
    };
    // D-0315 (step 4): a noted value (`noted_type`), not memory alone.
    x.s1_now = objectless_ok && is_resource(g, ty) && !objectless_type(g, ty) && !is_string_ty(ty);
    if (objectless_ok)
    {
        match (&v.obj)
        {
            Some(src) :
            {
                emit(x, &sprintf("cb_forget_obj(%s);", src));
                objectless_bound(g, x, &cname, tid, ty);
                bind_in_scope(
                    x,
                    name,
                    Binding { .c = cname, .ty = clone(ty), .root = String::new(), .kind = BindKind::Local },
                );
                return;
            },
            None      : {},
        }
        if (HashSet::contains(&x.inert_c, &v.c))
        {
            // A `__raw` call's result: nothing to forget.
            objectless_bound(g, x, &cname, tid, ty);
            bind_in_scope(
                x,
                name,
                Binding { .c = cname, .ty = clone(ty), .root = String::new(), .kind = BindKind::Local },
            );
            return;
        }
    }
    // D-0315: an inert value (`inert_c`) bound with an object is given it here.
    Option<String> given = materialize(g, x, v, line);
    if (is_resource(g, ty) || adopt)
    {
        String src = Option::expect(given, "a resource binding without an object");
        emit(x, &sprintf("cb_move_to(%s, &%s);", &src, &cname));
        emit(x, &sprintf("uint64_t %s = %s;", &o, &src));
    }
    else
    {
        emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &cname, tid, &lc));
    }
    String root = fresh(g, "root");
    emit(x, &sprintf("uint64_t %s = cb_bind(%s);", &root, &o));
    String r = if (unchecked_holder(g, x, name, ty))
    {
        HashMap::insert(&mut x.holder_roots, String::clone(&cname), root);
        String::new()
    }
    else
    {
        root
    };
    note_frame(g, x, name, &r);
    bind_in_scope(x, name, Binding { .c = cname, .ty = clone(ty), .root = r, .kind = BindKind::Local });
}

// Stores a materialized value into an lvalue of the same type: the C store
// plus the reference data. Object handling is the caller's.
// The element type an array literal's context fixes, if any.
export fn expected_elem(Option<ref<Type, shared>> expected) : Option<Type>
{
    match (expected)
    {
        Some(t) :
        {
            match (t)
            {
                Type::TArray(a) : Some(clone(&Box::get(a).inner)),
                Type::TSimd(_)  : None,
                _               : None,
            }
        },
        None    : None,
    }
}

export fn lower_array_lit(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Vec<Expr>, shared> es,
    Option<ref<Type, shared>> expected,
    usize line,
) : V
{
    // D-0315 (step 4): armed by its consumer (`arm_inert`).
    bool armed = g.decided && x.probing == 0 && Vec::len(es) > 0 && opt_eq(&x.raw_arm, &Some(array_key(es)));
    bool armed_last = x.raw_arm_last;
    if (armed)
    {
        x.raw_arm = None;
    }
    Option<Type> elem_ty = expected_elem(expected);
    Vec<V> vals = Vec::new();
    for (usize xi = 0; xi < Vec::len(es); xi += 1)
    {
        ref<Expr, shared> e = &es[xi];
        // D-0315 (step 4): an element with no object, as a struct literal's
        // field (`noted_pend` where a later one runs).
        bool bare = false;
        bool noted_el = false;
        match (&elem_ty)
        {
            Some(et) :
            {
                bare = g.decided && x.probing == 0 && is_resource(g, et) && !has_refs(g, et);
                noted_el = bare && !objectless_type(g, et) && noted_type(g, et);
                bare = bare && (noted_el || objectless_type(g, et));
            },
            None     : {},
        }
        Option<InertResult> outer_inert = replace(&mut x.inert_result, None);
        if (bare)
        {
            arm_inert(g, x, e, noted_el);
            x.raw_return_path = match (&strip_parens(e).kind)
            {
                ExprKind::EPath(_) : true,
                _                  : false,
            };
        }
        V v = match (&elem_ty)
        {
            Some(t) : lower_expr(g, x, e, Some(t)),
            None    : lower_expr(g, x, e, None),
        };
        x.raw_return_path = false;
        x.inert_result = outer_inert;
        if (is_never(&v.ty))
        {
            return never();
        }
        if (Option::is_none(&elem_ty))
        {
            elem_ty = Some(clone(&v.ty));
        }
        V t = into_temp(g, x, v, e.line);
        bool later_harmless = true;
        for (usize k = xi + 1; k < Vec::len(es); k += 1)
        {
            later_harmless = later_harmless && harmless(g, x, &es[k]);
        }
        if (noted_el && Option::is_none(&t.obj) && HashSet::contains(&x.inert_c, &t.c) && !later_harmless)
        {
            Vec::push(&mut vals, noted_pend(g, x, t, e.line));
        }
        else
        {
            Vec::push(&mut vals, t);
        }
    }
    Type elem = Option::expect(elem_ty, "cobc: empty array literal without an expected type");
    Type ty = Type::TArray(Box::new(SizedTy { .inner = clone(&elem), .n = widen<u128>(Vec::len(es)) }));
    String c = ctype(g, &ty);
    String t = fresh(g, "arr");
    emit(x, &sprintf("%s %s;", &c, &t));
    bool res = is_resource(g, &elem);
    bool all_bare = true;
    for (usize i = 0; i < Vec::len(&vals); i += 1)
    {
        noted_take(x, &vals[i].c);
        store(g, x, &sprintf("%s.a[%v]", &t, i), &elem, &vals[i]);
        bool vbare = Option::is_none(&vals[i].obj) && HashSet::contains(&x.inert_c, &vals[i].c);
        all_bare = all_bare && Option::is_none(&vals[i].obj);
        if (res && !vbare)
        {
            String o = Option::expect(clone(&vals[i].obj), "resource element has object");
            emit(x, &sprintf("cb_absorb(%s);", &o));
        }
    }
    // D-0315 (step 4): a whole its consumer takes with no object.
    if (armed && is_resource(g, &ty) && !has_refs(g, &ty) && (objectless_type(g, &ty) || (armed_last && noted_type(
        g,
        &ty,
    ))) && all_bare)
    {
        names_add(x, NameSet::InertC, String::clone(&t));
        return V { .c = t, .ty = ty, .obj = None };
    }
    register_temp(g, x, t, ty, line)
}

// `[v; N]` (D-0072): v once, copied into every element (its type is plain).
export fn lower_array_repeat(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> value,
    u128 n,
    Option<ref<Type, shared>> expected,
    usize line,
) : V
{
    Option<Type> elem_ty = expected_elem(expected);
    V v = match (&elem_ty)
    {
        Some(t) : lower_expr(g, x, value, Some(t)),
        None    : lower_expr(g, x, value, None),
    };
    if (is_never(&v.ty))
    {
        return never();
    }
    Type elem = match (elem_ty)
    {
        Some(t) : t,
        None    : clone(&v.ty),
    };
    String ec = ctype(g, &elem);
    String one = fresh(g, "rep");
    emit(x, &sprintf("%s %s = %s;", &ec, &one, &v.c));
    Type ty = Type::TArray(Box::new(SizedTy { .inner = elem, .n = n }));
    String c = ctype(g, &ty);
    String t = fresh(g, "arr");
    String k = fresh(g, "k");
    emit(x, &sprintf("%s %s;", &c, &t));
    emit(
        x,
        &sprintf(
            "for (uint64_t %s = 0; %s < %vULL; %s++) %s.a[%s] = %s;",
            &k,
            &k,
            n,
            &k,
            &t,
            &k,
            &one,
        ),
    );
    register_temp(g, x, t, ty, line)
}

// D-0292: a reference type's referent type id and mode, as `cb_hold_ref`
// and `cb_rec_ref` take them: `Tu, CB_SHARED`.
export fn ref_tid_mode(ref<Gen, exclusive> g, ref<Type, shared> ty) : String
{
    match (ty)
    {
        Type::TRef(m) :
        {
            u32 itid = type_id(g, &Box::get(m).inner);
            sprintf("%vu, %s", itid, mode_c(Box::get(m).mode))
        },
        _             :
        {
            assert(false, "cobc: a reference's place for a type that is no reference");
            String::new()
        },
    }
}

// D-0292: `R.tok = cb_rec_ref(R.tok, R.p, Tu, mode, K, loc);`: the reference
// `r` (a `cb_ref` lvalue) recorded on arrival in a recording frame, as a
// parameter's (`k` 1) or a call's result (`k` 0).
export fn emit_rec_ref(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> r,
    ref<Type, shared> ty,
    bool param,
    ref<String, shared> lc,
)
{
    emit(
        x,
        &sprintf(
            "%s.tok = cb_rec_ref(%s.tok, %s.p, %s, %su, %s);",
            r,
            r,
            r,
            &ref_tid_mode(g, ty),
            if (param) { "1" } else { "0" },
            lc,
        ),
    );
}

export fn store(ref<Gen, exclusive> g, ref<Fx, exclusive> x, StringView dst, ref<Type, shared> ty, ref<V, shared> v)
{
    if (is_void(ty) || is_never(ty))
    {
        return;
    }
    match (ty)
    {
        Type::TRef(_) :
        {
            // D-0292: the reference's place goes with it: a light one
            // becomes a holder here.
            emit(x, &sprintf("%s = (%s).p;", dst, &v.c));
            emit(
                x,
                &sprintf(
                    "cb_hold_ref(&%s, (%s).tok, (%s).p, %s, CB_NOLOC, 0);",
                    dst,
                    &v.c,
                    &v.c,
                    &ref_tid_mode(g, ty),
                ),
            );
            return;
        },
        _             : {},
    }
    emit(x, &sprintf("%s = %s;", dst, &v.c));
    if (has_refs(g, ty))
    {
        u32 tid = type_id(g, ty);
        emit(x, &sprintf("cb_copy_datum(&%s, &(%s), %vu);", dst, &v.c, tid));
    }
}

// After `cb_bind` of binding `name` with root `root`: when the body assigns
// to `name` as a whole, remember the frame it was bound in.
export fn note_frame(ref<Gen, exclusive> g, ref<Fx, exclusive> x, StringView name, ref<String, shared> root)
{
    if (StringView::len(root) > 0 && HashSet::contains(&x.assigned, &String::copy(name)))
    {
        String f = fresh(g, "frame");
        emit(x, &sprintf("uint64_t %s = cb_frame_here();", &f));
        HashMap::insert(&mut x.rebind_frames, String::clone(root), f);
    }
}

// The same proof for a local that holds references: its object stays (the
// slots it holds make its references held), but accesses to the variable
// itself are not checked.
export fn unchecked_holder(ref<Gen, shared> g, ref<Fx, shared> x, StringView name, ref<Type, shared> ty) : bool
{
    !is_resource(
        g,
        ty,
    ) && has_refs(
        g,
        ty,
    ) && !holds_fn(g, ty) && !is_closure(ty) && !HashSet::contains(&x.pinned, &String::copy(name))
}

export fn lower_place(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e) : P
{
    // `x.f…` over a `foreach` element alias, read in place (cobc's
    // `lower_place`: without it a borrowed operand `p.f` went through a
    // reference to the element, `conf`-untested, found by the perf guide's
    // `e12_elements`).
    match (alias_field_chain(g, x, e))
    {
        Some(r) : return lower_place(g, x, &r),
        None    : {},
    }
    // An element of a confined vector, as `lower_expr` reaches it
    // (`elem_access_place`'s confined case).
    match (&e.kind)
    {
        ExprKind::EDeref(inner) :
        {
            match (&Box::get(inner).kind)
            {
                ExprKind::ECall(c) :
                {
                    bool index = match (&Box::get(c).callee.kind)
                    {
                        ExprKind::EPath(cp) :
                        {
                            String k = String::join(&Box::get(cp).segs, "::");
                            k == "std::Vec::index_shared" || k == "std::Vec::index_exclusive"
                        },
                        _                   : false,
                    };
                    if (index && Vec::len(&Box::get(c).args) > 0 && Option::is_some(&confined_elem_vec(
                        g,
                        x,
                        &Box::get(c).args[0],
                    )))
                    {
                        bool w = x.place_write;
                        match (elem_access_place(g, x, Box::get(inner), w, e.line))
                        {
                            Some(ep) : return ep,
                            None     : {},
                        }
                    }
                },
                _                  : {},
            }
        },
        _                       : {},
    }
    match (&e.kind)
    {
        ExprKind::EPath(p)      :
        {
            if (Vec::len(&Box::get(p).segs) == 1)
            {
                match (lookup(x, &Box::get(p).segs[0]))
                {
                    Some(b) :
                    {
                        Binding { c, ty, root, kind } = b;
                        match (kind)
                        {
                            // `self.f_i`: a field of the closure through `self`.
                            BindKind::CaptureVal(i) :
                            {
                                SelfRef sr = Option::expect(clone(&x.self_ref), "cobc: capture outside a closure body");
                                String cty = ctype(g, &Type::TClosure(sr.id));
                                return P { .c = sprintf(
                                    "(*(%s *)%s.p).f%v",
                                    &cty,
                                    &sr.c,
                                    i,
                                ), .ty = ty, .base = Some(sprintf(
                                    "%s.tok",
                                    &sr.c,
                                )), .projs = vec_of(sprintf(
                                    "{ CB_FIELD, %vu }",
                                    i,
                                )), .is_binding = false, .raw = None };
                            },
                            // `*self.f_i`: through the captured reference.
                            BindKind::CaptureRef(i) :
                            {
                                SelfRef sr = Option::expect(clone(&x.self_ref), "cobc: capture outside a closure body");
                                String cty = ctype(g, &Type::TClosure(sr.id));
                                String slot = sprintf("(*(%s *)%s.p).f%v", &cty, &sr.c, i);
                                Type pointee = match (&ty)
                                {
                                    Type::TRef(m) : clone(&Box::get(m).inner),
                                    _             :
                                    {
                                        assert(false, "cobc: borrow capture is not a reference");
                                        Type::TVoid
                                    },
                                };
                                String tk = fresh(g, "tk");
                                emit(x, &sprintf("uint64_t %s = cb_load_ref(&%s);", &tk, &slot));
                                String pc = ctype(g, &pointee);
                                return P { .c = sprintf(
                                    "(*(%s *)%s)",
                                    &pc,
                                    &slot,
                                ), .ty = pointee, .base = Some(tk), .projs = Vec::new(), .is_binding = false, .raw = None };
                            },
                            BindKind::Local         : {},
                        }
                        Option<String> base = if (StringView::len(&root) == 0) { None } else { Some(root) };
                        return P { .c = c, .ty = ty, .base = base, .projs = Vec::new(), .is_binding = true, .raw = None };
                    },
                    None    : {},
                }
            }
        },
        ExprKind::EParen(inner) : return lower_place(g, x, Box::get(inner)),
        ExprKind::ECall(ce)     :
        {
            match (&Box::get(ce).callee.kind)
            {
                ExprKind::EPath(cp) :
                {
                    if (Vec::len(&Box::get(cp).segs) == 1 && Box::get(cp).segs[0] == "reclaim")
                    {
                        // `[Reclaim]`: the object at a raw address, as a
                        // place rooted in its own (reclaim) path.
                        Type ty = apply(&Box::get(cp).targs[0], &x.subst);
                        V pv = lower_expr(g, x, &Box::get(ce).args[0], None);
                        V pt = into_temp(g, x, pv, e.line);
                        u32 tid = type_id(g, &ty);
                        String c = ctype(g, &ty);
                        String root = fresh(g, "root");
                        emit(x, &sprintf("uint64_t %s = cb_reclaim(%s, %vu);", &root, &pt.c, tid));
                        return P { .c = sprintf(
                            "(*(%s *)%s)",
                            &c,
                            &pt.c,
                        ), .ty = ty, .base = Some(root), .projs = Vec::new(), .is_binding = true, .raw = None };
                    }
                },
                _                   : {},
            }
        },
        ExprKind::EField(fe)    :
        {
            P pb0 = lower_place(g, x, &Box::get(fe).e);
            P pb1 = auto_deref(g, x, pb0);
            P pb = if (is_guard(&pb1.ty)) { guard_through(g, x, pb1, e.line) } else { pb1 };
            ref<NamedTy, shared> nt = match (&pb.ty)
            {
                Type::TNamed(n) : Box::get(n),
                _               :
                {
                    assert(false, "cobc: field access on a non-struct");
                    return pb;
                },
            };
            FieldAt { idx, ty: fty } = Option::expect(struct_field(g, &nt.name, &nt.args, &Box::get(fe).name), "a struct's field");
            P { c, ty, base, projs, is_binding, raw } = pb;
            Vec::push(&mut projs, sprintf("{ CB_FIELD, %vu }", idx));
            return P { .c = sprintf(
                "%s.%s",
                &c,
                &san(&Box::get(fe).name),
            ), .ty = fty, .base = base, .projs = projs, .is_binding = false, .raw = None };
        },
        ExprKind::EIndex(ie)    :
        {
            bool tr = replace(&mut x.temp_root, false);
            bool pw = x.place_write;
            Option<Expr> vx = vec_index_call(g, x, e, pw);
            x.temp_root = tr;
            match (vx)
            {
                Some(rw) :
                {
                    // The `Vec`'s borrow in the rewritten call is part of the
                    // same temporary (D-0103).
                    if (tr)
                    {
                        ref<Expr, shared> call = match (&rw.kind)
                        {
                            ExprKind::EDeref(c) : Box::get(c),
                            _                   : &rw,
                        };
                        match (&call.kind)
                        {
                            ExprKind::ECall(ce) :
                            {
                                if (Vec::len(&Box::get(ce).args) > 0)
                                {
                                    match (&Box::get(ce).args[0].kind)
                                    {
                                        ExprKind::EBorrow(_) :
                                        {
                                            HashSet::insert(&mut g.prog.facts.temp_borrows, Box::get(ce).args[0].id);
                                        },
                                        _                    : {},
                                    }
                                }
                            },
                            _                   : {},
                        }
                        x.temp_root = false;
                    }
                    x.place_write = false;
                    return lower_place(g, x, &rw);
                },
                None     : {},
            }
            P pb0 = lower_place(g, x, &Box::get(ie).a);
            P pb1 = auto_deref(g, x, pb0);
            P pb = if (is_guard(&pb1.ty)) { guard_through(g, x, pb1, e.line) } else { pb1 };
            return index_place(g, x, e, pb, &Box::get(ie).b);
        },
        ExprKind::EDeref(inner) :
        {
            // `*r` for a direct reference: its referent, unchecked.
            match (&Box::get(inner).kind)
            {
                ExprKind::EPath(ip) :
                {
                    if (Vec::len(&Box::get(ip).segs) == 1 && Vec::len(&Box::get(ip).targs) == 0)
                    {
                        match (lookup(x, &Box::get(ip).segs[0]))
                        {
                            Some(b) :
                            {
                                if (HashSet::contains(&x.direct_refs, &b.c))
                                {
                                    P bp = P { .c = String::clone(&b.c), .ty = clone(&b.ty), .base = None, .projs = Vec::new(), .is_binding = true, .raw = None };
                                    return auto_deref(g, x, bp);
                                }
                            },
                            None    : {},
                        }
                    }
                },
                _                   : {},
            }
            match (unwrapped_map_get(g, x, Box::get(inner), e.line))
            {
                Some(up) : return up,
                None     : {},
            }
            Type it = probe_type(g, x, Box::get(inner), None);
            if (is_guard(&it))
            {
                return guard_place(g, x, Box::get(inner), e.line);
            }
            V v = lower_expr(g, x, Box::get(inner), None);
            match (&v.ty)
            {
                Type::TRef(m)    :
                {
                    Type pointee = clone(&Box::get(m).inner);
                    V r = into_temp(g, x, clone(&v), e.line);
                    String c = ctype(g, &pointee);
                    return P { .c = sprintf(
                        "(*(%s *)%s.p)",
                        &c,
                        &r.c,
                    ), .ty = pointee, .base = Some(sprintf(
                        "%s.tok",
                        &r.c,
                    )), .projs = Vec::new(), .is_binding = false, .raw = None };
                },
                Type::TRawptr(i) :
                {
                    Type pointee = clone(Box::get(i));
                    V t = into_temp(g, x, clone(&v), e.line);
                    // A `rawptr<S>` names `struct S` by its forward
                    // declaration alone; the raw place `*p` is an `S`, so
                    // `S` is defined.
                    ctype(g, &pointee);
                    return P { .c = sprintf(
                        "(*%s)",
                        &t.c,
                    ), .ty = pointee, .base = None, .projs = Vec::new(), .is_binding = false, .raw = Some(String::clone(&t.c)) };
                },
                _                :
                {
                    assert(false, "cobc: deref of a non-pointer");
                },
            }
        },
        _                       : {},
    }
    // A temporary used as a place (`make().f`): unchecked, unless a borrow
    // of part of it outlives the expression (D-0103): then it is an object
    // of this statement, and the place is checked from its root path.
    bool temp_root = replace(&mut x.temp_root, false);
    // D-0315 (step 4): a call read in part (`make().f`), of a type whose end
    // frees memory alone or one with a destructor of its own: taken with no
    // object, the statement's own.
    bool is_call = match (&strip_parens(e).kind)
    {
        ExprKind::ECall(_) : true,
        _                  : false,
    };
    bool pre_arm = false;
    if (!temp_root && g.decided && x.probing == 0 && is_call)
    {
        Type st = probe_type(g, x, e, None);
        pre_arm = is_resource(g, &st) && !has_refs(g, &st) && (objectless_type(g, &st) || noted_type(g, &st));
    }
    // D-0315: a call borrowed in part is taken with no object.
    Option<InertResult> outer_inert = replace(&mut x.inert_result, None);
    if (temp_root || pre_arm)
    {
        arm_inert(g, x, e, true);
    }
    V v = lower_expr(g, x, e, None);
    x.inert_result = outer_inert;
    V t = into_temp(g, x, v, e.line);
    // D-0315: in a decided body, one whose end frees memory alone is the
    // statement's own, dropped where it ends; no check reads a path to it.
    // D-0315 (step 4): or one whose type has a destructor of its own, noted.
    bool noted = (temp_root || pre_arm) && g.decided && !objectless_type(g, &t.ty) && noted_type(g, &t.ty);
    if ((temp_root || pre_arm) && g.decided && x.probing == 0 && is_resource(g, &t.ty) && !has_refs(g, &t.ty) && (objectless_type(g, &t.ty) || noted) && (Option::is_some(&t.obj) || HashSet::contains(&x.inert_c, &t.c)))
    {
        u32 tid = type_id(g, &t.ty);
        if (stmt_temp_drop(g, x, &t.c, tid, &t.ty, noted))
        {
            match (&t.obj)
            {
                Some(o) : emit(x, &sprintf("cb_forget_obj(%s);", o)),
                None    : {},
            }
            return P { .c = String::clone(&t.c), .ty = clone(&t.ty), .base = Some("0"), .projs = Vec::new(), .is_binding = false, .raw = None };
        }
    }
    // (Taken with none where no statement of its own ends it: an object, as
    // before.)
    if (pre_arm && Option::is_none(&t.obj))
    {
        t.obj = materialize(g, x, &t, e.line);
    }
    bool is_ref = match (&t.ty)
    {
        Type::TRef(_) : true,
        _             : false,
    };
    // D-0315: plain data with no object (`&[a, b]` of numbers): token 0; its end
    // destroys nothing.
    if (temp_root && g.decided && Option::is_none(&t.obj) && !is_resource(g, &t.ty) && !holds_fn(g, &t.ty) && !is_ref && (plain_data(g, &t.ty) || decided_plain(g, &t.ty)))
    {
        return P { .c = String::clone(&t.c), .ty = clone(&t.ty), .base = Some("0"), .projs = Vec::new(), .is_binding = false, .raw = None };
    }
    if (temp_root && !is_ref)
    {
        String lc = loc(g, x.std_body, e.line);
        String o = match (&t.obj)
        {
            Some(o) : String::clone(o),
            None    :
            {
                u32 tid = type_id(g, &t.ty);
                String o = fresh(g, "o");
                emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &t.c, tid, &lc));
                o
            },
        };
        String root = fresh(g, "root");
        emit(x, &sprintf("uint64_t %s = cb_temp_path(%s);", &root, &o));
        return P { .c = String::clone(&t.c), .ty = clone(&t.ty), .base = Some(root), .projs = Vec::new(), .is_binding = false, .raw = None };
    }
    // A reference temporary is held in register form (`cb_ref`): the place
    // it stands for is its referent, reached through that token.
    match (&t.ty)
    {
        Type::TRef(m) :
        {
            Type pointee = clone(&Box::get(m).inner);
            String c = ctype(g, &pointee);
            P inner = P { .c = sprintf(
                "(*(%s *)%s.p)",
                &c,
                &t.c,
            ), .ty = pointee, .base = Some(sprintf(
                "%s.tok",
                &t.c,
            )), .projs = Vec::new(), .is_binding = false, .raw = None };
            return auto_deref(g, x, inner);
        },
        _             : {},
    }
    V { c, ty, obj } = t;
    P { .c = c, .ty = ty, .base = None, .projs = Vec::new(), .is_binding = false, .raw = None }
}

// The element `idx` of the place `pb`: a `Vec`'s, a slice's or an array's.
export fn index_place(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e, P pb, ref<Expr, shared> idx) : P
{
    Type us = Type::TInt(IntTy::Usize);
    match (clone(&pb.ty))
    {
        Type::TNamed(n) :
        {
            if (Box::get(&n).name == "std::Vec")
            {
                Type elem = if (Vec::len(&Box::get(&n).args) > 0) { clone(&Box::get(&n).args[0]) } else { Type::TVoid };
                String lenv = fresh(g, "len");
                emit(x, &sprintf("uint64_t %s = (%s).len;", &lenv, &pb.c));
                Vec::push(&mut x.dollar, String::clone(&lenv));
                V i = lower_expr(g, x, idx, Some(&us));
                Vec::pop(&mut x.dollar);
                V it = into_temp(g, x, i, e.line);
                String lc = loc(g, x.std_body, e.line);
                emit(x, &sprintf("cb_index_check((uint64_t)%s, %s, %s);", &it.c, &lenv, &lc));
                P { c, ty, base, projs, is_binding, raw } = pb;
                Vec::push(&mut projs, sprintf("{ CB_INDEX, (uint64_t)%s }", &it.c));
                return P { .c = sprintf(
                    "(%s).ptr[%s]",
                    &c,
                    &it.c,
                ), .ty = elem, .base = base, .projs = projs, .is_binding = false, .raw = None };
            }
        },
        Type::TSlice(m) :
        {
            Type elem = clone(&Box::get(&m).inner);
            if (HashSet::contains(&x.direct_refs, &pb.c) && (pb.is_binding || Option::is_none(&pb.base)))
            {
                // A direct slice (`direct_refs_of`): bounds only.
                String dlen = fresh(g, "len");
                emit(x, &sprintf("uint64_t %s = (%s).len;", &dlen, &pb.c));
                Vec::push(&mut x.dollar, String::clone(&dlen));
                V di = lower_expr(g, x, idx, Some(&us));
                Vec::pop(&mut x.dollar);
                V dit = into_temp(g, x, di, e.line);
                String dlc = loc(g, x.std_body, e.line);
                emit(x, &sprintf("cb_index_check((uint64_t)%s, %s, %s);", &dit.c, &dlen, &dlc));
                slice_elem_access(g, x, &pb.c, &dit.c, &elem, &dlc);
                return P { .c = sprintf(
                    "(%s).data[%s]",
                    &pb.c,
                    &dit.c,
                ), .ty = elem, .base = None, .projs = Vec::new(), .is_binding = false, .raw = None };
            }
            String tok = fresh(g, "tok");
            emit(x, &sprintf("uint64_t %s = cb_load_ref(&(%s).src);", &tok, &pb.c));
            String lenv = fresh(g, "len");
            emit(x, &sprintf("uint64_t %s = (%s).len;", &lenv, &pb.c));
            Vec::push(&mut x.dollar, String::clone(&lenv));
            V i = lower_expr(g, x, idx, Some(&us));
            Vec::pop(&mut x.dollar);
            V it = into_temp(g, x, i, e.line);
            String lc = loc(g, x.std_body, e.line);
            emit(x, &sprintf("cb_index_check((uint64_t)%s, %s, %s);", &it.c, &lenv, &lc));
            slice_elem_access(g, x, &pb.c, &it.c, &elem, &lc);
            Vec<String> projs = Vec::new();
            Vec::push(&mut projs, sprintf("{ CB_INDEX, (uint64_t)%s }", &it.c));
            return P { .c = sprintf(
                "(%s).data[%s]",
                &pb.c,
                &it.c,
            ), .ty = elem, .base = Some(tok), .projs = projs, .is_binding = false, .raw = None };
        },
        _               : {},
    }
    bool lane = match (&pb.ty)
    {
        Type::TSimd(_) : true,
        _              : false,
    };
    ref<SizedTy, shared> at = match (&pb.ty)
    {
        Type::TArray(a) : Box::get(a),
        // D-0254: a lane, as C subscripts a vector.
        Type::TSimd(a)  : Box::get(a),
        _               :
        {
            assert(false, "cobc: index on a non-array");
            return pb;
        },
    };
    Type elem = clone(&at.inner);
    u128 n = at.n;
    Vec::push(&mut x.dollar, sprintf("%vu", n));
    V i = lower_expr(g, x, idx, Some(&us));
    Vec::pop(&mut x.dollar);
    V it = into_temp(g, x, i, e.line);
    String lc = loc(g, x.std_body, e.line);
    emit(x, &sprintf("cb_index_check((uint64_t)%s, %vu, %s);", &it.c, n, &lc));
    P { c, ty, base, projs, is_binding, raw } = pb;
    Vec::push(&mut projs, sprintf("{ CB_INDEX, (uint64_t)%s }", &it.c));
    String pc = if (lane) { sprintf("(%s)[%s]", &c, &it.c) } else { sprintf("%s.a[%s]", &c, &it.c) };
    P { .c = pc, .ty = elem, .base = base, .projs = projs, .is_binding = false, .raw = None }
}

// An element of a slice reached for reading or writing: the slice's own
// path is checked as before, and the element's object, if it has one, is
// met as `Vec` indexing meets it (`cb_elem_access`).
export fn slice_elem_access(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> sc,
    ref<String, shared> idx,
    ref<Type, shared> elem,
    ref<String, shared> lc,
)
{
    u32 tid = type_id(g, elem);
    str mode = if (x.place_write) { "CB_EXCLUSIVE" } else { "CB_SHARED" };
    u32 w = if (x.place_write) { 1 } else { 0 };
    // A direct slice meets element objects only where its entry test found
    // one (`bind_direct_live`).
    match (HashMap::get(&x.direct_live, sc))
    {
        Some(flag) :
        {
            String fl = String::clone(flag);
            emit(
                x,
                &sprintf(
                    "cb_elem_access_if(%s, (void *)&(%s).data[%s], %vu, %s, %vu, %s);",
                    &fl,
                    sc,
                    idx,
                    tid,
                    mode,
                    w,
                    lc,
                ),
            );
            return;
        },
        None       : {},
    }
    u64 size = size_align(g, elem).size;
    emit(
        x,
        &sprintf(
            "cb_elem_access((void *)&(%s).data[%s], %vu, %vu, %s, %vu, %s);",
            sc,
            idx,
            size,
            tid,
            mode,
            w,
            lc,
        ),
    );
}

// A reference place read through: its referent, through the token its slot
// holds.
export fn auto_deref(ref<Gen, exclusive> g, ref<Fx, exclusive> x, P p) : P
{
    match (&p.ty)
    {
        Type::TRef(m) :
        {
            Type pointee = clone(&Box::get(m).inner);
            // A direct reference (`direct_refs`): its referent, unchecked.
            if (p.is_binding && HashSet::contains(&x.direct_refs, &p.c))
            {
                String dc = ctype(g, &pointee);
                return P { .c = sprintf(
                    "(*(%s *)%s)",
                    &dc,
                    &p.c,
                ), .ty = pointee, .base = None, .projs = Vec::new(), .is_binding = false, .raw = None };
            }
            String tk = fresh(g, "tk");
            String load = slot_tok(x, &p.c);
            emit(x, &sprintf("uint64_t %s = %s;", &tk, &load));
            String c = ctype(g, &pointee);
            P inner = P { .c = sprintf(
                "(*(%s *)%s)",
                &c,
                &p.c,
            ), .ty = pointee, .base = Some(tk), .projs = Vec::new(), .is_binding = false, .raw = None };
            auto_deref(g, x, inner)
        },
        _             : p,
    }
}

// The type of the place `e`, found as `probe_type` finds a value's, and
// kept as a value's is.
export fn probe_place_type(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e) : Type
{
    String key = sprintf("%v place", e.id);
    match (HashMap::get(&x.probes, &key))
    {
        Some(t) : return clone(t),
        None    : {},
    }
    bool outer = replace(&mut x.probe_failed, false);
    Type ty = probe_place_once(g, x, e);
    if (x.probe_failed)
    {
        return ty;
    }
    x.probe_failed = outer;
    HashMap::insert(&mut x.probes, key, clone(&ty));
    ty
}

fn probe_place_once(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e) : Type
{
    String saved_out = replace(&mut x.out, probe_buf(g));
    u64 saved_uid = g.uid;
    StrMark saved_strs = str_mark(g);
    u64 saved_nstr = g.nstr;
    usize saved_cleanup = Vec::len(&x.cleanup);
    usize saved_scopes = Vec::len(&x.scopes);
    NameSnap saved_names = snapshot_names(x);
    Vec<Loop> saved_loops = clone(&x.loops);
    bool saved_write = replace(&mut x.place_write, false);
    x.probing += 1;
    P p = lower_place(g, x, e);
    x.probing -= 1;
    x.place_write = saved_write;
    probe_buf_done(g, replace(&mut x.out, saved_out));
    g.uid = saved_uid;
    str_restore(g, saved_strs);
    g.nstr = saved_nstr;
    Vec::truncate(&mut x.cleanup, saved_cleanup);
    Vec::truncate(&mut x.scopes, saved_scopes);
    restore_names(x, saved_names);
    x.loops = saved_loops;
    P { c, ty, base, projs, is_binding, raw } = p;
    ty
}

// `v[k].f…` read as a value, plain data at the end of a chain of struct
// fields: the element is reached as a reader's is (`elem_reader`, D-0192),
// the `…_pre` body inline and its checks by `cb_elem_access`, where the
// element type holds no reference and no function value, whatever resource it
// holds. The call the ordinary lowering makes borrows the whole element
// shared, which meets every exclusive path into it, and then reads the field
// through that one fresh, unheld path, which meets nothing more;
// `cb_elem_access` makes the borrow's check, and the path it no longer forms
// would have ended with the statement unobserved (D-0018).
fn elem_field_read(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e) : Option<V>
{
    Vec<String> fields = Vec::new();
    ref<Expr, shared> ix = e;
    while (true)
    {
        match (&ix.kind)
        {
            ExprKind::EField(fe) :
            {
                Vec::push(&mut fields, String::clone(&Box::get(fe).name));
                ix = &Box::get(fe).e;
            },
            ExprKind::EParen(b)  : ix = Box::get(b),
            _                    : break,
        }
    }
    bool indexed = match (&ix.kind)
    {
        ExprKind::EIndex(_) : true,
        _                   : false,
    };
    if (Vec::len(&fields) == 0 || !indexed || boot(g, 5))
    {
        return None;
    }
    Type elem = probe_place_type(g, x, ix);
    if (has_refs(g, &elem) || holds_fn(g, &elem) || is_closure(&elem) || is_ref_type(&elem))
    {
        return None;
    }
    // Struct fields all the way down (no reference, box or guard to see
    // through), plain data at the end.
    Type t = elem;
    for (usize k = Vec::len(&fields); k > 0; k -= 1)
    {
        ref<NamedTy, shared> nt = match (&t)
        {
            Type::TNamed(n) : Box::get(n),
            _               : return None,
        };
        StructDecl sd = match (struct_decl(g, &nt.name))
        {
            Some(s) : s,
            None    : return None,
        };
        // A bitstruct's fields are bits of its backing integer, read by
        // `lower_place_value`'s own case (D-0118).
        if (Option::is_some(&sd.bits))
        {
            return None;
        }
        usize idx = 0;
        while (idx < Vec::len(&sd.fields) && sd.fields[idx].name != fields[k - 1])
        {
            idx += 1;
        }
        if (idx == Vec::len(&sd.fields))
        {
            return None;
        }
        HashMap<String, Type> sub = subst_of(&sd.type_params, &nt.args);
        Type ft = apply(&sd.fields[idx].ty, &sub);
        t = ft;
    }
    if (!plain_data(g, &t))
    {
        return None;
    }
    Expr call = match (vec_index_call(g, x, ix, false))
    {
        Some(c) : c,
        None    : return None,
    };
    ref<Expr, shared> inner = match (&call.kind)
    {
        ExprKind::EDeref(d) : Box::get(d),
        _                   : return None,
    };
    bool shared_index = match (&inner.kind)
    {
        ExprKind::ECall(c) : match (&Box::get(c).callee.kind)
        {
            ExprKind::EPath(p) : String::join(&Box::get(p).segs, "::") == "std::Vec::index_shared",
            _                  : false,
        },
        _ : false,
    };
    if (!shared_index)
    {
        return None;
    }
    x.elem_reader = true;
    Option<P> po = elem_access_place(g, x, inner, false, e.line);
    x.elem_reader = false;
    P p = match (po)
    {
        Some(pp) : pp,
        None     : return None,
    };
    if (is_never(&p.ty))
    {
        return Some(never());
    }
    for (usize k = Vec::len(&fields); k > 0; k -= 1)
    {
        P { c, ty, base, projs, is_binding, raw } = p;
        ref<NamedTy, shared> nt = match (&ty)
        {
            Type::TNamed(n) : Box::get(n),
            _               :
            {
                assert(false, "cobc: a field of a non-struct element");
                return None;
            },
        };
        StructDecl sd = Option::expect(struct_decl(g, &nt.name), "a struct");
        usize idx = 0;
        while (sd.fields[idx].name != fields[k - 1])
        {
            idx += 1;
        }
        HashMap<String, Type> sub = subst_of(&sd.type_params, &nt.args);
        Type fty = apply(&sd.fields[idx].ty, &sub);
        Vec::push(&mut projs, sprintf("{ CB_FIELD, %vu }", idx));
        p = P { .c = sprintf(
            "%s.%s",
            &c,
            &san(&fields[k - 1]),
        ), .ty = fty, .base = base, .projs = projs, .is_binding = false, .raw = raw };
    }
    V v = read_place(g, x, p, e.line);
    Some(into_temp(g, x, v, e.line))
}

// A place read as a value: a field, an element or a dereference.
export fn lower_place_value(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> e,
    Option<ref<Type, shared>> expected,
) : V
{
    // CHG-0237: plain data in a field of a frozen parameter (`frozen_root`):
    // read with no check.
    bool field = match (&e.kind)
    {
        ExprKind::EField(_) : true,
        _                   : false,
    };
    if (field && frozen_root(g, x, e))
    {
        P p = lower_place(g, x, e);
        if (plain_data(g, &p.ty))
        {
            V v = V { .c = String::clone(&p.c), .ty = clone(&p.ty), .obj = None };
            return into_temp(g, x, v, e.line);
        }
    }
    match (&e.kind)
    {
        // D-0103: a field moved out of a temporary.
        ExprKind::EField(_) :
        {
            match (HashMap::get(&g.prog.facts.temp_moves, e.id))
            {
                Some(r0) :
                {
                    Expr r = clone(r0);
                    return lower_expr(g, x, &r, expected);
                },
                None     : {},
            }
        },
        _                   : {},
    }
    match (elem_field_read(g, x, e))
    {
        Some(v) : return v,
        None    : {},
    }
    // `*x` for a `foreach` element aliased to `(*$c)[$i]` (`foreach_alias`).
    match (alias_of_deref(x, e))
    {
        Some(a) : return lower_expr(g, x, &a, expected),
        None    : {},
    }
    match (alias_field_chain(g, x, e))
    {
        Some(r) : return lower_expr(g, x, &r, expected),
        None    : {},
    }
    match (const_array_read(g, x, e))
    {
        Some(v) : return v,
        None    : {},
    }
    match (vec_index_call(g, x, e, false))
    {
        Some(rw) : return lower_expr(g, x, &rw, expected),
        None     : {},
    }
    match (&e.kind)
    {
        ExprKind::EDeref(inner) :
        {
            match (elem_access_place(g, x, Box::get(inner), false, e.line))
            {
                Some(p) :
                {
                    if (is_never(&p.ty))
                    {
                        return never();
                    }
                    // Loaded now: the element's address need not outlive
                    // this expression.
                    V v = read_place(g, x, p, e.line);
                    return into_temp(g, x, v, e.line);
                },
                None    : {},
            }
        },
        ExprKind::EField(fe)    :
        {
            // D-0118: a bit field is read out of the whole backing integer.
            match (bitfield_of(g, x, &Box::get(fe).e, &Box::get(fe).name))
            {
                Some(bf) :
                {
                    P pb0 = lower_place(g, x, &Box::get(fe).e);
                    P pb1 = auto_deref(g, x, pb0);
                    P pb = if (is_guard(&pb1.ty)) { guard_through(g, x, pb1, e.line) } else { pb1 };
                    V v0 = read_place(g, x, pb, e.line);
                    V v = into_temp(g, x, v0, e.line);
                    String fc = ctype(g, &bf.ty);
                    String c = sprintf(
                        "((%s)(((%s).bits >> %vu) & %s))",
                        &fc,
                        &v.c,
                        bf.off,
                        &c_bits_mask(bf.backing, bf.w),
                    );
                    return V { .c = c, .ty = clone(&bf.ty), .obj = None };
                },
                None     : {},
            }
        },
        _                       : {},
    }
    P p = lower_place(g, x, e);
    read_place(g, x, p, e.line)
}

struct BitField
{
    u32 w;
    u32 off;
    IntTy backing;
    Type ty;
}

// A place through a guard: the guard's stored reference, read, its referent
// the place.
export fn guard_through(ref<Gen, exclusive> g, ref<Fx, exclusive> x, P p, usize line) : P
{
    match (&p.base)
    {
        Some(base) :
        {
            String lc = loc(g, x.std_body, line);
            emit(x, &sprintf("cb_read(%s, %s, %s);", base, &projs_args(&p.projs), &lc));
        },
        None       : {},
    }
    Type pointee = match (&p.ty)
    {
        Type::TGuard(i) : clone(Box::get(i)),
        _               :
        {
            assert(false, "cobc: guard deref of a non-guard");
            Type::TVoid
        },
    };
    String c = ctype(g, &pointee);
    String r = fresh(g, "r");
    emit(x, &sprintf("cb_ref %s = { %s, cb_load_ref(&%s) };", &r, &p.c, &p.c));
    P { .c = sprintf(
        "(*(%s *)%s.p)",
        &c,
        &r,
    ), .ty = pointee, .base = Some(sprintf("%s.tok", &r)), .projs = Vec::new(), .is_binding = false, .raw = None }
}

// `*g` of a guard: through its place, or through a temporary's slot.
export fn guard_place(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> inner, usize line) : P
{
    bool is_place = match (&inner.kind)
    {
        ExprKind::EPath(_)  : true,
        ExprKind::EField(_) : true,
        ExprKind::EIndex(_) : true,
        ExprKind::EDeref(_) : true,
        ExprKind::EParen(_) : true,
        _                   : false,
    };
    if (is_place)
    {
        P p = lower_place(g, x, inner);
        return guard_through(g, x, p, line);
    }
    // D-0315 (step 4): a guard its statement ends, noted.
    Option<InertResult> outer_inert = replace(&mut x.inert_result, None);
    bool bare = g.decided && x.probing == 0;
    if (bare)
    {
        arm_inert(g, x, inner, true);
    }
    V v = lower_expr(g, x, inner, None);
    x.inert_result = outer_inert;
    V t = into_temp(g, x, v, line);
    if (bare && Option::is_none(&t.obj) && HashSet::contains(&x.inert_c, &t.c))
    {
        u32 tid = type_id(g, &t.ty);
        if (!stmt_temp_drop(g, x, &t.c, tid, &t.ty, true))
        {
            Option<String> o = materialize(g, x, &t, line);
            drop(o);
        }
    }
    Type pointee = match (&t.ty)
    {
        Type::TGuard(i) : clone(Box::get(i)),
        _               :
        {
            assert(false, "cobc: guard deref of a non-guard");
            Type::TVoid
        },
    };
    String c = ctype(g, &pointee);
    String r = fresh(g, "r");
    emit(x, &sprintf("cb_ref %s = { %s, cb_load_ref(&%s) };", &r, &t.c, &t.c));
    P { .c = sprintf(
        "(*(%s *)%s.p)",
        &c,
        &r,
    ), .ty = pointee, .base = Some(sprintf("%s.tok", &r)), .projs = Vec::new(), .is_binding = false, .raw = None }
}

export fn is_guard(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TGuard(_) : true,
        _               : false,
    }
}

// The width, offset, backing type and type of field `f` when `base`'s
// struct is a bitstruct (cobc's `bitfield_of`, by the base's probed type).
export fn bitfield_of(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> base,
    ref<String, shared> f,
) : Option<BitField>
{
    Type bt0 = probe_type(g, x, base, None);
    Type bt = match (bt0)
    {
        Type::TRef(m)   : ModedTy::take_inner(m),
        Type::TGuard(i) : Box::into_inner(i),
        t               : t,
    };
    String name = match (&bt)
    {
        Type::TNamed(n) : String::clone(&Box::get(n).name),
        _               : return None,
    };
    StructDecl sd = struct_decl(g, &name)?;
    IntTy backing = sd.bits?;
    u32 off = 0;
    foreach (fd in &sd.fields)
    {
        u32 w = fd.width?;
        if (fd.name == *f)
        {
            return Some(BitField { .w = w, .off = off, .backing = backing, .ty = clone(&fd.ty) });
        }
        off += w;
    }
    None
}

// A copy of `e` whose every node has an id of its own (cobc clones a node
// to a new address, which no fact names).
export fn renumbered(ref<Gen, exclusive> g, ref<Expr, shared> e) : Expr
{
    Expr c = clone(e);
    number_expr(&mut c, &mut g.synth_id);
    c
}

// `renumbered`, the checker's per-node facts on `e`'s parts (a view
// argument's `SliceString`, a temporary's borrow) carried to the copy's.
export fn renumbered_with_facts(ref<Gen, exclusive> g, ref<Expr, shared> e) : Expr
{
    Expr c = renumbered(g, e);
    Vec<usize> a = Vec::new();
    Vec<usize> b = Vec::new();
    expr_ids(e, &mut a);
    expr_ids(&c, &mut b);
    if (Vec::len(&a) != Vec::len(&b))
    {
        return c;
    }
    ref<Facts, exclusive> f = &mut g.prog.facts;
    for (usize i = 0; i < Vec::len(&a); i += 1)
    {
        usize x = a[i];
        usize y = b[i];
        Option<ViewOp> view_ops_x = match (HashMap::get(&f.view_ops, x))
        {
            Some(v) : Some(clone(v)),
            None    : None,
        };
        match (view_ops_x)
        {
            Some(v) :
            {
                HashMap::insert(&mut f.view_ops, y, v);
            },
            None    : {},
        }
        if (HashSet::contains(&f.temp_borrows, x))
        {
            HashSet::insert(&mut f.temp_borrows, y);
        }
        Option<Type> match_hints_x = match (HashMap::get(&f.match_hints, x))
        {
            Some(t) : Some(clone(t)),
            None    : None,
        };
        match (match_hints_x)
        {
            Some(t) :
            {
                HashMap::insert(&mut f.match_hints, y, t);
            },
            None    : {},
        }
        if (HashSet::contains(&f.number_literals, x))
        {
            HashSet::insert(&mut f.number_literals, y);
        }
        Option<Type> closure_types_x = match (HashMap::get(&f.closure_types, x))
        {
            Some(t) : Some(clone(t)),
            None    : None,
        };
        match (closure_types_x)
        {
            Some(t) :
            {
                HashMap::insert(&mut f.closure_types, y, t);
            },
            None    : {},
        }
        if (HashSet::contains(&f.shared_fn_reads, x))
        {
            HashSet::insert(&mut f.shared_fn_reads, y);
        }
    }
    c
}

export fn synth(ref<Gen, exclusive> g, ExprKind kind, usize line, usize col) : Expr
{
    g.synth_id += 1;
    Expr { .kind = kind, .line = line, .col = col, .id = g.synth_id }
}

// `[Index-Vec]` (D-0047): `e[k]` on a `Vec` is `*Vec::index_shared(&e, k)`,
// or `*Vec::index_exclusive(&mut e, k)` where the place is written, with
// `$` the `Vec`'s length. `None` for anything else.
export fn vec_index_call(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e, bool write) : Option<Expr>
{
    ref<PairExpr, shared> ix = match (&e.kind)
    {
        ExprKind::EIndex(p) : Box::get(p),
        _                   : return None,
    };
    String key = sprintf("%v %v", e.id, write);
    match (HashMap::get(&x.vec_index_exprs, &key))
    {
        Some(r) : return Some(clone(r)),
        None    : {},
    }
    // The base's type without reading it: a place's as a place, anything
    // else (a call's result) as the value it is.
    ref<Expr, shared> sb = strip_parens(&ix.a);
    bool is_place = match (&sb.kind)
    {
        ExprKind::EPath(_)  : true,
        ExprKind::EField(_) : true,
        ExprKind::EIndex(_) : true,
        ExprKind::EDeref(_) : true,
        _                   : false,
    };
    // A confined parameter's `(*v)[k]` is lowered as its `v[k]`: the place
    // indexed is that dereference.
    Option<Expr> deref_place = None;
    Option<Type> local_ty = match (&sb.kind)
    {
        ExprKind::EPath(p)  :
        {
            if (Vec::len(&Box::get(p).segs) == 1)
            {
                match (lookup_ref(x, &Box::get(p).segs[0]))
                {
                    Some(b) : Some(binding_place_ty(b)),
                    // A confined parameter (a variant's mask) has no binding:
                    // it is a reference to a `Vec` of the element type.
                    None : match (HashMap::get(&x.confined_params, &Box::get(p).segs[0]))
                    {
                        Some(cv) : Some(ref_ty(
                            Type::TNamed(Box::new(NamedTy { .name = "std::Vec", .args = one_type(clone(&cv.elem)) })),
                            Mode::Shared,
                        )),
                        None : None,
                    },
                }
            }
            else
            {
                None
            }
        },
        ExprKind::EDeref(d) :
        {
            ref<Expr, shared> di = strip_parens(Box::get(d));
            match (&di.kind)
            {
                ExprKind::EPath(p) :
                {
                    if (Vec::len(&Box::get(p).segs) == 1 && !is_bound(
                        x,
                        &Box::get(p).segs[0],
                    ))
                    {
                        match (HashMap::get(&x.confined_params, &Box::get(p).segs[0]))
                        {
                            Some(cv) :
                            {
                                Type el = clone(&cv.elem);
                                Expr dc = renumbered(g, di);
                                deref_place = Some(synth(g, ExprKind::EDeref(Box::new(dc)), e.line, e.col));
                                Some(Type::TNamed(Box::new(NamedTy { .name = "std::Vec", .args = one_type(el) })))
                            },
                            None     : None,
                        }
                    }
                    else
                    {
                        None
                    }
                },
                _                  : None,
            }
        },
        _                   : None,
    };
    Type bt = match (local_ty)
    {
        Some(t) : t,
        None    : if (is_place) { probe_place_type(g, x, &ix.a) } else { probe_type(g, x, &ix.a, None) },
    };
    bool through_ref = false;
    Type inner = match (&bt)
    {
        Type::TRef(m) :
        {
            through_ref = true;
            clone(&Box::get(m).inner)
        },
        _             : clone(&bt),
    };
    bool is_vec = match (&inner)
    {
        Type::TNamed(n) : Box::get(n).name == "std::Vec",
        _               : false,
    };
    if (!is_vec)
    {
        return None;
    }
    usize line = e.line;
    usize col = e.col;
    Expr place = match (deref_place)
    {
        Some(dp) : dp,
        None     :
        {
            Expr base_c = renumbered_with_facts(g, &ix.a);
            if (through_ref) { synth(g, ExprKind::EDeref(Box::new(base_c)), line, col) } else { base_c }
        },
    };
    str fname = if (write) { "index_exclusive" } else { "index_shared" };
    Mode mode = if (write) { Mode::Exclusive } else { Mode::Shared };
    Vec<String> segs = Vec::new();
    Vec::push(&mut segs, "std");
    Vec::push(&mut segs, "Vec");
    Vec::push(&mut segs, String::copy(fname));
    Expr callee = synth(g, ExprKind::EPath(Box::new(PathExpr { .segs = segs, .targs = Vec::new() })), line, col);
    Expr arg0 = synth(g, ExprKind::EBorrow(Box::new(BorrowExpr { .mode = mode, .e = place })), line, col);
    usize arg0_id = arg0.id;
    Vec<Expr> args = Vec::new();
    Vec::push(&mut args, arg0);
    Vec::push(&mut args, renumbered_with_facts(g, &ix.b));
    Expr call = synth(g, ExprKind::ECall(Box::new(CallExpr { .callee = callee, .args = args })), line, col);
    Expr rw = synth(g, ExprKind::EDeref(Box::new(call)), line, col);
    HashSet::insert(&mut x.index_sugar, arg0_id);
    HashMap::insert(&mut x.vec_index_exprs, key, clone(&rw));
    Some(rw)
}

// `*Vec::index_*(&v, i)` read, or assigned (`write`), at once: the element
// as a place, its checks made by the call (`lower_user_call` with `access`).
export fn elem_access_place(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> inner,
    bool write,
    usize line,
) : Option<P>
{
    ref<CallExpr, shared> call = match (&inner.kind)
    {
        ExprKind::ECall(c) : Box::get(c),
        _                  : return None,
    };
    ref<PathExpr, shared> path = match (&call.callee.kind)
    {
        ExprKind::EPath(p) : Box::get(p),
        _                  : return None,
    };
    if (Vec::len(&path.segs) == 1 && is_bound(x, &path.segs[0]))
    {
        return None;
    }
    String name = String::join(&path.segs, "::");
    if (name != "std::Vec::index_shared" && name != "std::Vec::index_exclusive")
    {
        return None;
    }
    bool fprel = match (fn_in_prelude(g, &name))
    {
        Some(p) : p,
        None    : return None,
    };
    if (fprel && Vec::len(&call.args) == 2)
    {
        ref<Expr, shared> a0 = &call.args[0];
        ref<Expr, shared> a1 = &call.args[1];
        // Confined (`bind_confined`, `confined_field`, a read of a
        // `read_confined_vec`): the body's location and bounds fault, and the
        // element's address; nothing else.
        bool read_ok = !write && name == "std::Vec::index_shared";
        Option<ConfinedVec> cvo = match (confined_elem_vec(g, x, a0))
        {
            Some(cv) : Some(cv),
            None     : if (read_ok) { read_confined_vec(g, x, a0) } else { None },
        };
        match (cvo)
        {
            Some(cv) : return Some(confined_elem_place(g, x, &cv, a1, line)),
            None     : {},
        }
        // CHG-0237: an element of a vector reached through a shared reference
        // parameter (`frozen_vec`), read as plain data or handed to a reader
        // parameter: its bounds fault and its address, nothing else.
        if (read_ok)
        {
            match (frozen_vec(g, x, a0))
            {
                Some(cv) :
                {
                    if ((x.elem_reader && flat_value(g, &cv.elem)) || plain_data(g, &cv.elem))
                    {
                        return Some(confined_elem_place(g, x, &cv, a1, line));
                    }
                },
                None     : {},
            }
        }
    }
    FnDecl f = Option::expect(get_fn(g, &name), "an indexing function");
    V v = lower_user_call_access(g, x, &name, &f, &path.targs, &call.args, None, line, Some(write));
    match (&v.ty)
    {
        Type::TRef(m) :
        {
            String c = ctype(g, &Box::get(m).inner);
            Some(P { .c = sprintf(
                "(*(%s *)%s.p)",
                &c,
                &v.c,
            ), .ty = clone(&Box::get(m).inner), .base = Some(sprintf(
                "%s.tok",
                &v.c,
            )), .projs = Vec::new(), .is_binding = false, .raw = None })
        },
        Type::TNever  : Some(P { .c = String::new(), .ty = Type::TNever, .base = None, .projs = Vec::new(), .is_binding = false, .raw = None }),
        _ : Some(P { .c = sprintf(
            "(*%s)",
            &v.c,
        ), .ty = clone(&v.ty), .base = None, .projs = Vec::new(), .is_binding = false, .raw = None }),
    }
}

export fn read_place(ref<Gen, exclusive> g, ref<Fx, exclusive> x, P p, usize line) : V
{
    String lc = loc(g, x.std_body, line);
    // D-0196/D-0200: an objectless local moved away (`return s`, a call's
    // argument, a literal's part, `let y = x`): stale if it already was; then
    // its flag is set (or, for a `String`, the binding keeps an empty one),
    // and the value takes an object here.
    if (is_resource(
        g,
        &p.ty,
    ) && Option::is_none(&p.raw) && p.is_binding && Vec::len(&p.projs) == 0 && Option::is_none(&p.base) && HashSet::contains(
        &x.objectless_c,
        &p.c,
    ))
    {
        String t = fresh(g, "t");
        String c = ctype(g, &p.ty);
        u32 tid = type_id(g, &p.ty);
        objectless_use(g, x, &p.c, line);
        emit(x, &sprintf("%s %s = %s;", &c, &t, &p.c));
        match (HashMap::get(&x.moved_flag, &p.c))
        {
            Some(f) :
            {
                String fl = String::clone(f);
                emit(x, &sprintf("%s = 1;", &fl));
            },
            None    :
            {
                // A type probe lowers into a discarded buffer: nothing moves
                // there.
                if (x.probing == 0)
                {
                    assert(is_string_ty(&p.ty), "cobc: an objectless local moved away without a flag");
                    emit(
                        x,
                        &sprintf(
                            "%s.bytes.ptr = (uint8_t *)1; %s.bytes.len = 0; %s.bytes.cap = 0;",
                            &p.c,
                            &p.c,
                            &p.c,
                        ),
                    );
                }
            },
        }
        if ((x.raw_ret || g.decided) && replace(&mut x.raw_return_path, false))
        {
            // A `__raw` form returns it as it is: no object at all.
            names_add(x, NameSet::InertC, String::clone(&t));
            return V { .c = t, .ty = clone(&p.ty), .obj = None };
        }
        String o = fresh(g, "o");
        emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &t, tid, &lc));
        return V { .c = t, .ty = clone(&p.ty), .obj = Some(o) };
    }
    // A whole binding's move is `[Authority-Transfer]`, which `cb_take`
    // checks; it is not a `[Read]`.
    bool whole_move = is_resource(g, &p.ty) && Option::is_none(&p.raw) && p.is_binding && Vec::len(&p.projs) == 0;
    if (!whole_move)
    {
        match (&p.base)
        {
            Some(root) : emit(x, &sprintf("cb_read(%s, %s, %s);", root, &projs_args(&p.projs), &lc)),
            None       : {},
        }
    }
    if (is_resource(g, &p.ty))
    {
        match (&p.raw)
        {
            // `[Rawptr-Move-Out]`: the value leaves the raw cells; the
            // reclaimed identity there, if any, ends.
            Some(ptr) :
            {
                String t = fresh(g, "t");
                String c = ctype(g, &p.ty);
                emit(x, &sprintf("%s %s = %s;", &c, &t, &p.c));
                u32 tid = type_id(g, &p.ty);
                emit(x, &sprintf("cb_raw_move_out(%s, &%s, %vu);", ptr, &t, tid));
                String o = fresh(g, "o");
                emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &t, tid, &lc));
                return V { .c = t, .ty = clone(&p.ty), .obj = Some(o) };
            },
            None      : {},
        }
        if (!(p.is_binding && Vec::len(&p.projs) == 0))
        {
            // A resource moved out of a part of a live object: the checks
            // above found the place valid, and the move itself is the fault.
            str d = if (Vec::len(&p.projs) == 0) { "diag.move-while-aliased" } else { "diag.move-out-of-field" };
            emit(x, &sprintf("cb_fault(\"%s\", %s);", d, &lc));
            String o = fresh(g, "o");
            emit(x, &sprintf("uint64_t %s = 0;", &o));
            P { c, ty, base, projs, is_binding, raw } = p;
            return V { .c = c, .ty = ty, .obj = Some(o) };
        }
        String o = fresh(g, "o");
        emit(
            x,
            &sprintf(
                "uint64_t %s = cb_take(%s, %s);",
                &o,
                &Option::expect(clone(&p.base), "a whole binding's root"),
                &lc,
            ),
        );
        P { c, ty, base, projs, is_binding, raw } = p;
        return V { .c = c, .ty = ty, .obj = Some(o) };
    }
    match (&p.ty)
    {
        Type::TRef(_) : return read_ref_slot(x, &p.c, &p.ty),
        // `[Read]` of a fn value (D-0089): its closure is copied, or moves
        // out and empties the slot when it owns a resource.
        Type::TFn(_)  :
        {
            String t = fresh(g, "t");
            emit(x, &sprintf("void *%s = cb_fn_read((void **)&(%s), %s);", &t, &p.c, &lc));
            return V { .c = t, .ty = clone(&p.ty), .obj = None };
        },
        _             : {},
    }
    if (holds_fn(g, &p.ty))
    {
        // A value holding fn values, read by value: the same, slot by slot,
        // after the copy of its bytes.
        String t = fresh(g, "t");
        String c = ctype(g, &p.ty);
        u32 tid = type_id(g, &p.ty);
        emit(x, &sprintf("%s %s = %s;", &c, &t, &p.c));
        emit(x, &sprintf("cb_fn_split(&%s, &(%s), %vu, %s);", &t, &p.c, tid, &lc));
        return V { .c = t, .ty = clone(&p.ty), .obj = None };
    }
    P { c, ty, base, projs, is_binding, raw } = p;
    V { .c = c, .ty = ty, .obj = None }
}

// ---- probes ----

// The type `e` lowers to, found by lowering it into a discarded buffer; the
// names it used are given back, so the real pass reuses them. Cached by the
// expression and its expected type (`probe_with` is the uncached one).
export fn probe_type(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> e,
    Option<ref<Type, shared>> expected,
) : Type
{
    String key = match (expected)
    {
        Some(t) : sprintf("%v %s", e.id, &type_code(t)),
        None    : sprintf("%v -", e.id),
    };
    match (HashMap::get(&x.probes, &key))
    {
        Some(t) : return clone(t),
        None    : {},
    }
    // cobc's probe fails with its error, which is not kept: only a type
    // found is, and `probe_failed` says whether this probe failed.
    bool outer = replace(&mut x.probe_failed, false);
    Type ty = probe_raw(g, x, e, expected);
    if (x.probe_failed)
    {
        return ty;
    }
    x.probe_failed = outer;
    HashMap::insert(&mut x.probes, key, clone(&ty));
    ty
}

// `probe_raw` where cobc's `probe_with` may fail: `x.probe_failed` says so.
export fn probe_try(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> e,
    Option<ref<Type, shared>> expected,
) : Type
{
    x.probe_failed = false;
    probe_raw(g, x, e, expected)
}

export fn probe_raw(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> e,
    Option<ref<Type, shared>> expected,
) : Type
{
    String saved_out = replace(&mut x.out, probe_buf(g));
    u64 saved_uid = g.uid;
    StrMark saved_strs = str_mark(g);
    u64 saved_nstr = g.nstr;
    usize saved_cleanup = Vec::len(&x.cleanup);
    usize saved_scopes = Vec::len(&x.scopes);
    NameSnap saved_names = snapshot_names(x);
    Vec<Loop> saved_loops = clone(&x.loops);
    x.probing += 1;
    V v = lower_expr(g, x, e, expected);
    x.probing -= 1;
    probe_buf_done(g, replace(&mut x.out, saved_out));
    g.uid = saved_uid;
    str_restore(g, saved_strs);
    g.nstr = saved_nstr;
    Vec::truncate(&mut x.cleanup, saved_cleanup);
    Vec::truncate(&mut x.scopes, saved_scopes);
    restore_names(x, saved_names);
    x.loops = saved_loops;
    V { c, ty, obj } = v;
    ty
}

// ---- operators ----

export fn is_literal_or_operator(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EParen(i)  : is_literal_or_operator(Box::get(i)),
        ExprKind::EBinary(_) : true,
        ExprKind::EUnary(_)  : true,
        ExprKind::EInt(_)    : true,
        ExprKind::EFloat(_)  : true,
        ExprKind::EBool(_)   : true,
        _                    : false,
    }
}

export fn lower_binary(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    BinOp op,
    ref<Expr, shared> l,
    ref<Expr, shared> r,
    Option<ref<Type, shared>> expected,
    usize line,
) : V
{
    bool proven = replace(&mut x.proven_next, false);
    if (op == BinOp::And || op == BinOp::Or)
    {
        Type tb = Type::TBool;
        V lv = lower_expr(g, x, l, Some(&tb));
        if (is_never(&lv.ty))
        {
            return never();
        }
        // The right operand is skipped by `goto`, not wrapped in a C block: a
        // temporary it creates lives to the end of the whole statement.
        String res = fresh(g, "t");
        String skip = fresh(g, "sc");
        emit(x, &sprintf("uint8_t %s = %s;", &res, &lv.c));
        emit(
            x,
            &sprintf("if (%s%s) goto %s;", if (op == BinOp::And) { "!" } else { "" }, &res, &skip),
        );
        V rv = lower_expr(g, x, r, Some(&tb));
        if (!is_never(&rv.ty))
        {
            emit(x, &sprintf("%s = %s;", &res, &rv.c));
        }
        emit(x, &sprintf("%s:;", &skip));
        return V { .c = res, .ty = Type::TBool, .obj = None };
    }
    bool arith = op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul || op == BinOp::Div || op == BinOp::Rem || op == BinOp::Shl || op == BinOp::Shr || op == BinOp::BitAnd || op == BinOp::BitOr || op == BinOp::BitXor;
    Option<ref<Type, shared>> operand_expected = if (arith) { expected } else { None };
    // `[Read-Resource-Rejected]`: an operand is a value read; decided before
    // either operand runs. An operator's or a literal's result is never a
    // resource.
    // A variant nothing in it types (`None == o`) takes the other operand's
    // type: probed from that side (session finding 001-A3).
    bool bare_left = (op == BinOp::Eq || op == BinOp::Ne) && is_untyped_variant(g, x, l) && !is_untyped_variant(g, x, r);
    Type lt = if (is_literal_or_operator(l))
    {
        Type::TVoid
    }
    else if (bare_left)
    {
        probe_type(g, x, r, operand_expected)
    }
    else
    {
        probe_type(g, x, l, operand_expected)
    };
    if (is_resource(g, &lt))
    {
        String lc = loc(g, x.std_body, line);
        emit(x, &sprintf("cb_fault(\"diag.read-of-resource\", %s);", &lc));
        return never();
    }
    bool shift = op == BinOp::Shl || op == BinOp::Shr;
    bool eqne = op == BinOp::Eq || op == BinOp::Ne;
    bool left_takes = (is_literal_expr(l) && !(shift && Option::is_some(&operand_expected))) || (eqne && is_pure_variant_literal(
        g,
        x,
        l,
    )) || bare_left;
    V lv = unit();
    V rv = unit();
    if (left_takes && !is_literal_expr(r) && !is_pure_variant_literal(g, x, r))
    {
        V r0 = lower_expr(g, x, r, operand_expected);
        if (is_never(&r0.ty))
        {
            return never();
        }
        rv = into_temp(g, x, r0, r.line);
        Type rt = clone(&rv.ty);
        V l0 = lower_expr(g, x, l, Some(&rt));
        lv = into_temp(g, x, l0, l.line);
    }
    else
    {
        V l0 = lower_expr(g, x, l, operand_expected);
        if (is_never(&l0.ty))
        {
            return never();
        }
        lv = into_temp(g, x, l0, l.line);
        Type lt2 = clone(&lv.ty);
        V r0 = lower_expr(g, x, r, Some(&lt2));
        if (is_never(&r0.ty))
        {
            return never();
        }
        rv = into_temp(g, x, r0, r.line);
    }
    String a = String::clone(&lv.c);
    String b = String::clone(&rv.c);
    String lc = loc(g, x.std_body, line);
    match (&lv.ty)
    {
        Type::TSimd(sv) :
        {
            Type lty = clone(&Box::get(sv).inner);
            return simd_binop(g, op, &lv.ty, &lty, Box::get(sv).n, &a, &b, &lc);
        },
        _               : {},
    }
    match (&lv.ty)
    {
        Type::TInt(t)    :
        {
            str ct = c_int_type(*t);
            u32 bw = int_ty_bits(*t, 64);
            str ut = c_uint_type(*t);
            if (op == BinOp::Add && proven)
            {
                return same_v(&lv, sprintf("((%s)(%s + %s))", ct, &a, &b));
            }
            if (op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul)
            {
                str builtin = if (op == BinOp::Add) { "__builtin_add_overflow" } else if (op == BinOp::Sub) { "__builtin_sub_overflow" } else { "__builtin_mul_overflow" };
                return same_v(
                    &lv,
                    sprintf(
                        "({ %s _r; if (%s(%s, %s, &_r)) cb_fault(\"diag.arith-overflow\", %s); _r; })",
                        ct,
                        builtin,
                        &a,
                        &b,
                        &lc,
                    ),
                );
            }
            if (op == BinOp::Div || op == BinOp::Rem)
            {
                str sym = if (op == BinOp::Div) { "/" } else { "%" };
                String ovf = if (int_ty_signed(*t))
                {
                    sprintf(
                        "if (_a == %s && _b == (%s)-1) cb_fault(\"diag.div-overflow\", %s);",
                        &c_int(*t, int_min_bits(*t)),
                        ct,
                        &lc,
                    )
                }
                else { String::new() };
                return same_v(
                    &lv,
                    sprintf(
                        "({ %s _a = %s, _b = %s; if (_b == 0) cb_fault(\"diag.div-by-zero\", %s); %s (%s)(_a %s _b); })",
                        ct,
                        &a,
                        &b,
                        &lc,
                        &ovf,
                        ct,
                        sym,
                    ),
                );
            }
            if (op == BinOp::Shl)
            {
                return same_v(
                    &lv,
                    sprintf(
                        "({ %s _a = %s; uint64_t _n = (uint64_t)(%s); if (_n >= %vu) cb_fault(\"diag.shift-amount-out-of-range\", %s); (%s)(((%s)_a) << _n); })",
                        ct,
                        &a,
                        &b,
                        bw,
                        &lc,
                        ct,
                        ut,
                    ),
                );
            }
            if (op == BinOp::Shr)
            {
                return same_v(
                    &lv,
                    sprintf(
                        "({ %s _a = %s; uint64_t _n = (uint64_t)(%s); if (_n >= %vu) cb_fault(\"diag.shift-amount-out-of-range\", %s); (%s)(_a >> _n); })",
                        ct,
                        &a,
                        &b,
                        bw,
                        &lc,
                        ct,
                    ),
                );
            }
            if (op == BinOp::BitAnd || op == BinOp::BitOr || op == BinOp::BitXor)
            {
                str sym = if (op == BinOp::BitAnd) { "&" } else if (op == BinOp::BitOr) { "|" } else { "^" };
                return same_v(&lv, sprintf("((%s)(%s %s %s))", ct, &a, sym, &b));
            }
            bool_v(sprintf("%s %s %s", &a, cmp_symbol(op), &b))
        },
        Type::TF32       : float_op(&lv, op, &a, &b),
        Type::TF64       : float_op(&lv, op, &a, &b),
        // D-0108: `false < true`.
        Type::TBool      :
        {
            assert(!arith, "cobc: operator on bool");
            bool_v(sprintf("%s %s %s", &a, cmp_symbol(op), &b))
        },
        // D-0108: `str` in byte order.
        Type::TStr       :
        {
            if (op == BinOp::Eq)
            {
                return bool_v(sprintf("cb_str_eq(%s, %s)", &a, &b));
            }
            if (op == BinOp::Ne)
            {
                return bool_v(sprintf("!cb_str_eq(%s, %s)", &a, &b));
            }
            assert(!arith, "cobc: operator on str");
            bool_v(sprintf("cb_bytes_cmp((%s).p, (%s).n, (%s).p, (%s).n) %s 0", &a, &a, &b, &b, cmp_symbol(op)))
        },
        Type::TRawptr(_) :
        {
            if (op == BinOp::Add)
            {
                return V { .c = sprintf("(%s + %s)", &a, &b), .ty = clone(&lv.ty), .obj = None };
            }
            assert(eqne, "cobc: operator on rawptr");
            bool_v(sprintf("%s %s %s", &a, cmp_symbol(op), &b))
        },
        // `[Eq-Ref]`: reference identity is the address it targets.
        Type::TRef(_)    :
        {
            assert(eqne, "cobc: operator on a reference");
            bool_v(sprintf("%s.p %s %s.p", &a, cmp_symbol(op), &b))
        },
        // `[Eq-Fn]`: two fn values are equal iff they name one item.
        Type::TFn(_)     :
        {
            assert(eqne, "cobc: operator on a fn value");
            bool_v(sprintf("%s %s %s", &a, cmp_symbol(op), &b))
        },
        // `[Eq-Struct]`: structs, arrays and enums compare by value.
        Type::TNamed(_)  : aggregate_cmp(g, &lv.ty, op, &a, &b),
        Type::TArray(_)  : aggregate_cmp(g, &lv.ty, op, &a, &b),
        // `[Eq-Unit]`: `() == ()` is true; both operands still run.
        Type::TVoid      :
        {
            assert(eqne, "cobc: operator on unit");
            bool_v(sprintf("((void)(%s), (void)(%s), %s)", &a, &b, if (op == BinOp::Eq) { "1" } else { "0" }))
        },
        _                :
        {
            assert(false, "cbc: a binary operator on this type, not ported yet");
            unit()
        },
    }
}

export fn same_v(ref<V, shared> lv, String c) : V
{
    V { .c = c, .ty = clone(&lv.ty), .obj = None }
}

export fn bool_v(String c) : V
{
    V { .c = sprintf("((uint8_t)(%s))", &c), .ty = Type::TBool, .obj = None }
}

export fn float_op(ref<V, shared> lv, BinOp op, ref<String, shared> a, ref<String, shared> b) : V
{
    if (op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul || op == BinOp::Div)
    {
        str sym = if (op == BinOp::Add) { "+" } else if (op == BinOp::Sub) { "-" } else if (op == BinOp::Mul) { "*" } else { "/" };
        return same_v(lv, sprintf("(%s %s %s)", a, sym, b));
    }
    if (op == BinOp::Rem)
    {
        return same_v(lv, sprintf("fmod(%s, %s)", a, b));
    }
    assert(
        op == BinOp::Eq || op == BinOp::Ne || op == BinOp::Lt || op == BinOp::Le || op == BinOp::Gt || op == BinOp::Ge,
        "cobc: bit operator on a float",
    );
    bool_v(sprintf("%s %s %s", a, cmp_symbol(op), b))
}

export fn aggregate_cmp(
    ref<Gen, exclusive> g,
    ref<Type, shared> t,
    BinOp op,
    ref<String, shared> a,
    ref<String, shared> b,
) : V
{
    if (op == BinOp::Eq || op == BinOp::Ne)
    {
        String e = eq_expr(g, t, a, b);
        return bool_v(if (op == BinOp::Eq) { e } else { sprintf("!%s", &e) });
    }
    // D-0271 `[Cmp-Key]`: a struct or enum key type is ordered by its
    // generated `cb_kc_` function, as `Vec::sort` orders it.
    bool named = match (t)
    {
        Type::TNamed(_) : true,
        _               : false,
    };
    assert(named && is_key_type(&g.prog.table, t), "cobc: operator on an aggregate");
    String f = key_cmp_fn(g, t);
    bool_v(sprintf("%s(&(%s), &(%s)) %s 0", &f, a, b, cmp_sym(op)))
}

// `[Eq-Struct]`: equality of two values of type `t` held in memory at the C
// lvalues `a` and `b`, as a C expression.
export fn eq_expr(ref<Gen, exclusive> g, ref<Type, shared> t, StringView a, StringView b) : String
{
    match (t)
    {
        Type::TInt(_)    : sprintf("(%s == %s)", a, b),
        Type::TF32       : sprintf("(%s == %s)", a, b),
        Type::TF64       : sprintf("(%s == %s)", a, b),
        Type::TBool      : sprintf("(%s == %s)", a, b),
        Type::TRef(_)    : sprintf("(%s == %s)", a, b),
        Type::TRawptr(_) : sprintf("(%s == %s)", a, b),
        Type::TFn(_)     : sprintf("(%s == %s)", a, b),
        Type::TStr       : sprintf("cb_str_eq(%s, %s)", a, b),
        Type::TVoid      : "1",
        Type::TNamed(n)  :
        {
            // D-0271: a `String` inside a key type compares by its bytes.
            if (Box::get(n).name == "std::String")
            {
                return sprintf(
                    "(cb_bytes_cmp((%s).bytes.ptr, (%s).bytes.len, (%s).bytes.ptr, (%s).bytes.len) == 0)",
                    a,
                    a,
                    b,
                    b,
                );
            }
            String f = eq_fn(g, t);
            sprintf("%s(&(%s), &(%s))", &f, a, b)
        },
        Type::TArray(_)  :
        {
            String f = eq_fn(g, t);
            sprintf("%s(&(%s), &(%s))", &f, a, b)
        },
        _                :
        {
            assert(false, "cobc: `==` on a type with no equality");
            String::new()
        },
    }
}

// The `cb_eq_…` function for a struct, an array or an enum.
export fn eq_fn(ref<Gen, exclusive> g, ref<Type, shared> t) : String
{
    String key = type_code(t);
    match (HashMap::get(&g.eqs, &key))
    {
        Some(n) : return String::clone(n),
        None    : {},
    }
    String ct = ctype(g, t);
    String name = sprintf("cb_eq_%s", &mangle(t));
    String body = match (t)
    {
        Type::TArray(ar) :
        {
            String e = eq_expr(g, &Box::get(ar).inner, "a->a[i]", "b->a[i]");
            sprintf(
                "    for (size_t i = 0; i < %vu; i++)\n        if (!%s) return 0;\n    return 1;\n",
                Box::get(ar).n,
                &e,
            )
        },
        Type::TNamed(nt) :
        {
            match (struct_decl(g, &Box::get(nt).name))
            {
                Some(sd) :
                {
                    if (Option::is_some(&sd.bits))
                    {
                        // D-0118: equal bits.
                        "    return a->bits == b->bits;\n"
                    }
                    else
                    {
                        HashMap<String, Type> sub = subst_of(&sd.type_params, &Box::get(nt).args);
                        String body = String::new();
                        foreach (f in &sd.fields)
                        {
                            String fname = san(&f.name);
                            String e = eq_expr(
                                g,
                                &apply(&f.ty, &sub),
                                &sprintf("a->%s", &fname),
                                &sprintf("b->%s", &fname),
                            );
                            String::append(&mut body, &sprintf("    if (!%s) return 0;\n", &e));
                        }
                        String::append(&mut body, "    return 1;\n");
                        body
                    }
                },
                None     :
                {
                    EnumDecl ed = Option::expect(enum_decl(g, &Box::get(nt).name), "cobc: unknown type");
                    HashMap<String, Type> sub = subst_of(&ed.type_params, &Box::get(nt).args);
                    String body = "    if (a->tag != b->tag) return 0;\n    switch (a->tag) {\n";
                    for (usize i = 0; i < Vec::len(&ed.variants); i += 1)
                    {
                        match (&ed.variants[i].payload)
                        {
                            Some(p) :
                            {
                                String e = eq_expr(
                                    g,
                                    &apply(p, &sub),
                                    &sprintf("a->u.v%v", i),
                                    &sprintf("b->u.v%v", i),
                                );
                                String::append(&mut body, &sprintf("    case %vu: return %s;\n", i, &e));
                            },
                            None    : {},
                        }
                    }
                    String::append(&mut body, "    default: return 1;\n    }\n");
                    body
                },
            }
        },
        _                :
        {
            assert(false, "cobc: eq_fn for a non-aggregate");
            String::new()
        },
    };
    String::append(
        &mut g.thunks_out,
        &sprintf("uint8_t %s(const %s *a, const %s *b)\n{\n%s}\n", &name, &ct, &ct, &body),
    );
    HashMap::insert(&mut g.eqs, key, String::clone(&name));
    name
}

// D-0315 (step 5): the drop glue of `t` in a decided program: a C function
// `cb_dg_…(void *p, uint32_t d)` that ends a value of `t` as `cb_drop_local`
// would, for a value whose end frees memory alone of a type with no destructor
// of its own; none for any other type (cobc's `drop_glue`). CHG-0427: a buffer
// it owns with an object over its cells (`cb_cells_busy`) is ended by the
// runtime's path.
export fn drop_glue(ref<Gen, exclusive> g, ref<Type, shared> t) : Option<String>
{
    if (!g.decided || boot(g, 1))
    {
        return None;
    }
    String key = type_code(t);
    match (HashMap::get(&g.glues, &key))
    {
        Some(n) : return if (StringView::len(n) == 0) { None } else { Some(String::clone(n)) },
        None    : {},
    }
    bool kind_ok = match (t)
    {
        Type::TNamed(nt) :
        {
            ref<NamedTy, shared> n = Box::get(nt);
            if (n.name == "std::String" && Vec::len(&n.args) == 0)
            {
                true
            }
            else if ((n.name == "std::Vec" || n.name == "std::Box") && Vec::len(&n.args) == 1)
            {
                true
            }
            else if (n.name == "std::Queue")
            {
                false
            }
            else
            {
                bool decl = match (struct_decl(g, &n.name))
                {
                    Some(sd) : Option::is_none(&sd.bits),
                    None     : HashMap::contains(&g.prog.table.enums, &n.name),
                };
                decl && !HashMap::contains(&g.prog.table.fns, &sprintf("%s::drop", &n.name))
            }
        },
        _                : false,
    };
    if (!kind_ok || !is_resource(g, t) || !objectless_type(g, t))
    {
        HashMap::insert(&mut g.glues, key, String::new());
        return None;
    }
    String name = sprintf("cb_dg_%s", &mangle(t));
    HashMap::insert(&mut g.glues, key, String::clone(&name));
    String::appendf(&mut g.thunks_out, "static void %s(void *p, uint32_t d);\n", &name);
    String ct = ctype(g, t);
    u32 tid = type_id(g, t);
    String body = String::new();
    String::appendf(&mut body, "    if (d > 1000u) { cb_drop_local(p, %vu); return; }\n", tid);
    String::appendf(&mut body, "    %s *v = (%s *)p;\n", &ct, &ct);
    ref<NamedTy, shared> nt = match (t)
    {
        Type::TNamed(n) : Box::get(n),
        _               : return None,
    };
    if (nt.name == "std::String")
    {
        String::appendf(&mut body, "    cb_drop_plain_buf(p, %vu, (void *)v->bytes.ptr, v->bytes.cap);\n", tid);
    }
    else if (nt.name == "std::Vec")
    {
        Type e = clone(&nt.args[0]);
        SizeAlign sa = size_align(g, &e);
        if (sa.size > 0)
        {
            String::appendf(
                &mut body,
                "    if (v->cap && cb_cells_busy(v->ptr, v->cap * %vu)) { cb_drop_local(p, %vu); return; }\n",
                sa.size,
                tid,
            );
        }
        String part = glue_part(g, &e, "v->ptr[i]");
        if (StringView::len(&part) > 0)
        {
            String::appendf(&mut body, "    for (uint64_t i = 0; i < v->len; i++) %s\n", &part);
        }
        String::append(&mut body, &glue_free(g, &e, "v->ptr", "v->cap"));
    }
    else if (nt.name == "std::Box")
    {
        Type e = clone(&nt.args[0]);
        String part = glue_part(g, &e, "*v->ptr");
        String free = glue_free(g, &e, "v->ptr", "1u");
        SizeAlign sa = size_align(g, &e);
        u64 cells = if (sa.size == 0) { 1 } else { sa.size };
        String::appendf(
            &mut body,
            "    if (v->ptr && cb_cells_busy(v->ptr, %vu)) { cb_drop_local(p, %vu); return; }\n",
            cells,
            tid,
        );
        String::append(&mut body, "    if (v->ptr) {\n");
        if (StringView::len(&part) > 0)
        {
            String::appendf(&mut body, "    %s\n", &part);
        }
        String::append(&mut body, &free);
        String::append(&mut body, "    }\n");
    }
    else
    {
        match (struct_decl(g, &nt.name))
        {
            Some(sd) :
            {
                HashMap<String, Type> sub = subst_of(&sd.type_params, &nt.args);
                usize k = Vec::len(&sd.fields);
                while (k > 0)
                {
                    k -= 1;
                    String part = glue_part(g, &apply(&sd.fields[k].ty, &sub), &sprintf("v->%s", &san(&sd.fields[k].name)));
                    if (StringView::len(&part) > 0)
                    {
                        String::appendf(&mut body, "    %s\n", &part);
                    }
                }
            },
            None     :
            {
                match (enum_decl(g, &nt.name))
                {
                    Some(ed) :
                    {
                        HashMap<String, Type> sub = subst_of(&ed.type_params, &nt.args);
                        for (usize i = 0; i < Vec::len(&ed.variants); i += 1)
                        {
                            match (&ed.variants[i].payload)
                            {
                                Some(p) :
                                {
                                    String part = glue_part(g, &apply(p, &sub), &sprintf("v->u.v%v", i));
                                    if (StringView::len(&part) > 0)
                                    {
                                        String::appendf(&mut body, "    if (%s) %s\n", &tag_is(g, t, "(*v)", i), &part);
                                    }
                                },
                                None    : {},
                            }
                        }
                    },
                    None     : {},
                }
            },
        }
    }
    String::appendf(&mut g.thunks_out, "static void %s(void *p, uint32_t d)\n{\n%s}\n", &name, &body);
    Some(name)
}

// D-0315: the end of a part of type `t` at the C place `place`, for a drop
// glue: nothing for plain data; its own glue, or the runtime's path.
fn glue_part(ref<Gen, exclusive> g, ref<Type, shared> t, StringView place) : String
{
    if (!is_resource(g, t) && !holds_fn(g, t))
    {
        return String::new();
    }
    match (drop_glue(g, t))
    {
        Some(gl) : sprintf("%s((void *)&(%s), d + 1u);", &gl, place),
        None     :
        {
            u32 tid = type_id(g, t);
            sprintf("cb_drop_local((void *)&(%s), %vu);", place, tid)
        },
    }
}

// D-0315: the block of `n` elements of `e` at `ptr` freed, as `cb_deallocate`
// frees it (`malloc`'s own alignment: `free` at once).
fn glue_free(ref<Gen, exclusive> g, ref<Type, shared> e, str ptr, str n) : String
{
    SizeAlign sa = size_align(g, e);
    if (sa.size == 0)
    {
        return String::new();
    }
    if (sa.align <= 16)
    {
        sprintf("    if (%s) free(%s);\n", n, ptr)
    }
    else
    {
        sprintf("    if (%s) cb_deallocate(%s, %s * %vu, %vu);\n", n, ptr, n, sa.size, sa.align)
    }
}

// A variant whose payload is a bare literal (or such a variant), as a value
// (`is_pure_variant_literal`): a `==`'s other side gives it its type.
// A variant whose type arguments nothing in it fixes: a payloadless one
// (`None`, `Bad`), or one whose payload is a literal or such a variant
// (`Err(Bad)`, `Some(5)`), not shadowed by a local.
export fn is_untyped_variant(ref<Gen, shared> g, ref<Fx, shared> x, ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EPath(p)  :
        {
            ref<Vec<String>, shared> segs = &Box::get(p).segs;
            Vec::len(&Box::get(p).targs) == 0 && (Vec::len(segs) > 1 || !is_bound(x, &segs[0])) && Option::is_some(&variant_of(g, segs))
        },
        ExprKind::ECall(c)  :
        {
            if (Vec::len(&Box::get(c).args) != 1)
            {
                return false;
            }
            match (&Box::get(c).callee.kind)
            {
                ExprKind::EPath(p) :
                {
                    ref<Vec<String>, shared> segs = &Box::get(p).segs;
                    Vec::len(&Box::get(p).targs) == 0 && (Vec::len(segs) > 1 || !is_bound(
                        x,
                        &segs[0],
                    )) && !HashMap::contains(&g.prog.table.fns, &join_segs(segs)) && Option::is_some(&variant_of(
                        g,
                        segs,
                    )) && (is_bare_literal(&Box::get(c).args[0]) || is_untyped_variant(g, x, &Box::get(c).args[0]))
                },
                _                  : false,
            }
        },
        ExprKind::EParen(i) : is_untyped_variant(g, x, Box::get(i)),
        _                   : false,
    }
}

export fn is_pure_variant_literal(ref<Gen, shared> g, ref<Fx, shared> x, ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::ECall(c)  :
        {
            if (Vec::len(&Box::get(c).args) != 1)
            {
                return false;
            }
            match (&Box::get(c).callee.kind)
            {
                ExprKind::EPath(p) :
                {
                    ref<Vec<String>, shared> segs = &Box::get(p).segs;
                    (Vec::len(segs) > 1 || !is_bound(
                        x,
                        &segs[0],
                    )) && !HashMap::contains(
                        &g.prog.table.fns,
                        &join_segs(segs),
                    ) && Option::is_some(&variant_of(
                        g,
                        segs,
                    )) && (is_bare_literal(&Box::get(c).args[0]) || is_pure_variant_literal(g, x, &Box::get(c).args[0]))
                },
                _                  : false,
            }
        },
        ExprKind::EParen(i) : is_pure_variant_literal(g, x, Box::get(i)),
        _                   : false,
    }
}

export fn cmp_symbol(BinOp op) : str
{
    match (op)
    {
        BinOp::Eq : "==",
        BinOp::Ne : "!=",
        BinOp::Lt : "<",
        BinOp::Le : "<=",
        BinOp::Gt : ">",
        _         : ">=",
    }
}

export fn is_variant_path(ref<Expr, shared> e) : bool
{
    false
}

// ---- parameters ----

export fn bind_param(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<ParamDecl, shared> p,
    ref<HashMap<String, Type>, shared> subst,
    usize param_index,
)
{
    Type ty = apply(&p.ty, subst);
    String pc = sprintf("p_%s", &san(&p.name));
    StringView name = &p.name;
    if (HashSet::contains(&x.pure_views, &p.name))
    {
        // Not received: the caller's copy holds the view's path for the call
        // (`pure_view`); only its bytes and length are read.
        names_add(x, NameSet::DirectRefs, sprintf("%s.bytes", &pc));
        bind_in_scope(x, name, Binding { .c = pc, .ty = ty, .root = String::new(), .kind = BindKind::Local });
        return;
    }
    if (HashSet::contains(&x.pure_slices, &p.name))
    {
        // Not received: the caller holds the slice's path for the call
        // (`pure_direct`); only its elements and length are used.
        names_add(x, NameSet::DirectRefs, String::clone(&pc));
        bind_direct_live(g, x, &pc, &ty);
        bind_in_scope(x, name, Binding { .c = pc, .ty = ty, .root = String::new(), .kind = BindKind::Local });
        return;
    }
    bool direct = HashSet::contains(&x.direct_params, &p.name);
    bool is_slice = match (&ty)
    {
        Type::TSlice(_) : true,
        _               : false,
    };
    if (direct && is_slice)
    {
        // A direct slice is received and bound as any slice, its path held
        // for the call; only its element accesses go unchecked.
        names_add(x, NameSet::DirectRefs, String::clone(&pc));
        bind_direct_live(g, x, &pc, &ty);
    }
    else if (direct)
    {
        // A direct reference: the address alone; no object, no stored path.
        String dl = sprintf("l_%s", &pc);
        emit(x, &sprintf("void *%s = %s.p;", &dl, &pc));
        names_add(x, NameSet::DirectRefs, String::clone(&dl));
        bind_in_scope(x, name, Binding { .c = dl, .ty = ty, .root = String::new(), .kind = BindKind::Local });
        return;
    }
    if (HashSet::contains(&x.unstored_params, &p.name) && is_ref_type(&ty))
    {
        // Its accesses go through the token it came with; the binding itself
        // is never written, borrowed or captured.
        String ul = sprintf("l_%s", &pc);
        emit(x, &sprintf("void *%s = %s.p;", &ul, &pc));
        // D-0292: in a recording frame the parameter's reference is
        // recorded on arrival, held by the frame for the call.
        if (x.tracked)
        {
            emit_rec_ref(g, x, &pc, &ty, true, &String::copy(NOLOC));
        }
        names_put(x, NameMap::Unstored, String::clone(&ul), sprintf("%s.tok", &pc));
        bind_in_scope(x, name, Binding { .c = ul, .ty = ty, .root = String::new(), .kind = BindKind::Local });
        return;
    }
    if (unchecked(g, x, name, &ty))
    {
        bind_in_scope(x, name, Binding { .c = pc, .ty = ty, .root = String::new(), .kind = BindKind::Local });
        return;
    }
    // D-0315: pinned plain data of a decided program: root token 0.
    if (pinned_plain(g, &ty))
    {
        bind_in_scope(x, name, Binding { .c = pc, .ty = ty, .root = "0", .kind = BindKind::Local });
        return;
    }
    // D-0315 (step 4): a `fn` parameter the body only calls: no object; its
    // entry in the body's table, registered on every call, and its end at every
    // exit (a `fn` item owns nothing).
    if (g.decided && HashSet::contains(&x.callee_only, &p.name))
    {
        u32 ftid = type_id(g, &ty);
        u32 k = x.notes;
        x.notes += 1;
        if (!x.notes_bottom)
        {
            // The table's pop: the last thing every return does.
            x.notes_always = true;
            x.notes_bottom = true;
            push_drop_under_root(x, "if (cb_nt_on) cb_notes_pop();");
        }
        emit(x, &sprintf("cb_nt[%v] = (struct cb_note){ (void *)&%s, 0, %vu, 1 };", k, &pc, ftid));
        push_drop_under_root(
            x,
            sprintf(
                "if (%s && ((cb_fnbox *)%s)->closure) cb_drop_value(&%s, %vu); cb_nt[%v].live = 0;",
                &pc,
                &pc,
                &pc,
                ftid,
                k,
            ),
        );
        bind_in_scope(x, name, Binding { .c = pc, .ty = ty, .root = String::new(), .kind = BindKind::Local });
        return;
    }
    u32 tid = type_id(g, &ty);
    String o = fresh(g, "o");
    bool is_ref = match (&ty)
    {
        Type::TRef(_) : true,
        _             : false,
    };
    String cname = if (is_ref)
    {
        String l = sprintf("l_%s", &pc);
        // D-0292: in a recording frame the reference is recorded on
        // arrival, held by the frame: the binding's slot and every use of
        // the parameter's own token (a `move` closure's captures are read
        // through `self`'s) see the record.
        if (x.tracked)
        {
            emit_rec_ref(g, x, &pc, &ty, true, &String::copy(NOLOC));
        }
        emit(x, &sprintf("void *%s = %s.p;", &l, &pc));
        emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &l, tid, NOLOC));
        emit(
            x,
            &sprintf(
                "cb_hold_ref(&%s, %s.tok, %s.p, %s, CB_NOLOC, 0);",
                &l,
                &pc,
                &pc,
                &ref_tid_mode(g, &ty),
            ),
        );
        l
    }
    else if (is_resource(g, &ty) && g.decided)
    {
        // D-0286: it arrives with no object. Objectless where the analysis
        // allows (a candidate by its declaration); otherwise it takes one
        // here.
        usize id = param_cand_id(param_index);
        // D-0315 (step 4): a parameter may be a noted value as a `let`'s binder
        // is (its sub-frame opens after the parameters).
        Option<usize> s1_saved = replace(&mut x.s1_let, Some(id));
        bool ok = objectless_binding(g, x, id, &ty);
        x.s1_let = s1_saved;
        if (ok)
        {
            x.s1_now = !objectless_type(g, &ty);
            Option<usize> saved = replace(&mut x.cur_let, Some(id));
            objectless_bound(g, x, &pc, tid, &ty);
            x.cur_let = saved;
            bind_in_scope(x, name, Binding { .c = pc, .ty = ty, .root = String::new(), .kind = BindKind::Local });
            return;
        }
        emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &pc, tid, NOLOC));
        String::clone(&pc)
    }
    else if (is_resource(g, &ty))
    {
        emit(x, &sprintf("uint64_t %s = cb_recv(&%s);", &o, &pc));
        String::clone(&pc)
    }
    else
    {
        if (has_refs(g, &ty))
        {
            emit(x, &sprintf("cb_recv_datum(&%s, %vu);", &pc, tid));
        }
        emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &pc, tid, NOLOC));
        String::clone(&pc)
    };
    String root = fresh(g, "root");
    emit(x, &sprintf("uint64_t %s = cb_bind(%s);", &root, &o));
    String r = if (unchecked_holder(g, x, name, &ty)) { String::new() } else { root };
    note_frame(g, x, name, &r);
    String bc = String::clone(&cname);
    Type bt = clone(&ty);
    bind_in_scope(x, name, Binding { .c = cname, .ty = ty, .root = r, .kind = BindKind::Local });
    // A `Vec` taken by value: the caller moved it, so no path but this
    // binding's holds it, as for a local (`Gen::confined_vecs`).
    bind_confined(g, x, &String::copy(name), &bc, &bt);
}

// A value whose evaluation changes no runtime state (cobc's `stateless`):
// literals, paths, fields, operators, and the width conversions of an
// integer.
export fn stateless(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EInt(_)    : true,
        ExprKind::EFloat(_)  : true,
        ExprKind::EBool(_)   : true,
        ExprKind::EStr(_)    : true,
        ExprKind::EUnit      : true,
        ExprKind::EPath(_)   : true,
        ExprKind::EParen(a)  : stateless(g, x, Box::get(a)),
        ExprKind::EUnary(u)  : stateless(g, x, &Box::get(u).e),
        ExprKind::EField(f)  : stateless(g, x, &Box::get(f).e),
        ExprKind::EBinary(b) : stateless(g, x, &Box::get(b).a) && stateless(g, x, &Box::get(b).b),
        ExprKind::ECall(c)   :
        {
            ref<Vec<Expr>, shared> args = &Box::get(c).args;
            match (&Box::get(c).callee.kind)
            {
                ExprKind::EPath(p) :
                {
                    if (Vec::len(&Box::get(p).segs) == 1 && Vec::len(&Box::get(p).targs) == 1 && Vec::len(args) == 1)
                    {
                        stateless(
                            g,
                            x,
                            &args[0],
                        ) && stateless_conv(g, x, &Box::get(p).segs[0], &Box::get(p).targs[0], &args[0])
                    }
                    else { false }
                },
                _                  : false,
            }
        },
        _                    : false,
    }
}

export fn stateless_conv(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> name,
    ref<Type, shared> dst0,
    ref<Expr, shared> a,
) : bool
{
    bool intrinsic = !is_bound(
        x,
        name,
    ) && !HashMap::contains(&g.prog.table.fns, name) && !HashMap::contains(&g.prog.table.externs, name);
    if (!intrinsic)
    {
        return false;
    }
    Type dst = apply(dst0, &x.subst);
    IntTy d = match (&dst)
    {
        Type::TInt(t) : *t,
        _             : return false,
    };
    if (*name == "widen" || *name == "narrow_wrapping" || *name == "reinterpret")
    {
        return match (probe_type(g, x, a, None))
        {
            Type::TInt(_) : true,
            _             : false,
        };
    }
    if (*name == "narrow")
    {
        return match (probe_type(g, x, a, None))
        {
            Type::TInt(s) : int_range_within(s, d),
            _             : false,
        };
    }
    false
}

export fn int_signed(IntTy t) : bool
{
    match (t)
    {
        IntTy::I8    : true,
        IntTy::I16   : true,
        IntTy::I32   : true,
        IntTy::I64   : true,
        IntTy::I128  : true,
        IntTy::Isize : true,
        _            : false,
    }
}

export fn int_bitwidth(IntTy t) : u32
{
    match (t)
    {
        IntTy::I8   : 8,
        IntTy::U8   : 8,
        IntTy::I16  : 16,
        IntTy::U16  : 16,
        IntTy::I32  : 32,
        IntTy::U32  : 32,
        IntTy::I128 : 128,
        IntTy::U128 : 128,
        _           : 64,
    }
}

// Every value of `s` is one of `d` (cobc's `int_range_within`).
export fn int_range_within(IntTy s, IntTy d) : bool
{
    u32 sb = int_bitwidth(s);
    u32 db = int_bitwidth(d);
    if (int_signed(s) == int_signed(d))
    {
        return sb <= db;
    }
    !int_signed(s) && sb < db
}

// D-0200: `ref<T, m> r = &x[i]…;` for a `let` `elem_ref_lets` proved: the
// checks the index calls make in the borrow's mode -- `x`'s borrow, then at
// each level the index, the bounds fault, and the element's access -- and `r`
// bound to the element's address with token 0 (cobc's `lower_elem_ref_let`).
// `Some(diverged)` when done.
export fn lower_elem_ref_let(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> name,
    ref<String, shared> cname,
    Option<ref<Type, shared>> declared,
    ref<Expr, shared> e,
) : Option<bool>
{
    ref<BorrowExpr, shared> bw = match (&strip_parens(e).kind)
    {
        ExprKind::EBorrow(b) : Box::get(b),
        _                    : return None,
    };
    Mode mode = bw.mode;
    // The steps from the root, outermost last.
    Vec<Expr> steps = Vec::new();
    ref<Expr, shared> cur = &bw.e;
    while (true)
    {
        ref<Expr, shared> sc = strip_parens(cur);
        match (&sc.kind)
        {
            ExprKind::EIndex(p) :
            {
                Vec::push(&mut steps, clone(sc));
                cur = &Box::get(p).a;
            },
            ExprKind::EField(f) :
            {
                Vec::push(&mut steps, clone(sc));
                cur = &Box::get(f).e;
            },
            ExprKind::EPath(_)  : break,
            _                   : return None,
        }
    }
    Vec::reverse(&mut steps);
    ref<Expr, shared> root = strip_parens(cur);
    str m = if (mode == Mode::Exclusive) { "CB_EXCLUSIVE" } else { "CB_SHARED" };
    usize line = e.line;
    String lc = loc(g, x.std_body, line);
    // The types along the way, before anything is emitted.
    String rname = match (&root.kind)
    {
        ExprKind::EPath(p) : String::clone(&Box::get(p).segs[0]),
        _                  : return None,
    };
    Binding rb = match (lookup(x, &rname))
    {
        Some(b) : b,
        None    : return None,
    };
    match (&rb.kind)
    {
        BindKind::Local : {},
        _               : return None,
    }
    Type t = clone(&rb.ty);
    foreach (st in &steps)
    {
        t = match (&st.kind)
        {
            ExprKind::EIndex(_) :
            {
                match (&t)
                {
                    Type::TNamed(n) :
                    {
                        if (Box::get(n).name != "std::Vec" || Vec::len(&Box::get(n).args) != 1)
                        {
                            return None;
                        }
                        clone(&Box::get(n).args[0])
                    },
                    _               : return None,
                }
            },
            ExprKind::EField(f) :
            {
                match (&t)
                {
                    Type::TNamed(n) :
                    {
                        match (field_type(g, Box::get(n), &Box::get(f).name))
                        {
                            Some(ft) : ft,
                            None     : return None,
                        }
                    },
                    _               : return None,
                }
            },
            _                   : return None,
        };
    }
    match (declared)
    {
        Some(d) :
        {
            if (!type_eq(d, &ref_ty(clone(&t), mode)))
            {
                return None;
            }
        },
        None    : {},
    }
    P pr = lower_place(g, x, root);
    if (is_never(&pr.ty))
    {
        return Some(true);
    }
    assert(
        Option::is_none(&pr.raw) && Vec::len(&pr.projs) == 0,
        "cobc: an element reference's root that is not a whole local",
    );
    match (&pr.base)
    {
        Some(b) : emit(x, &sprintf("cb_borrow_check(%s, NULL, 0, %s, %s);", b, m, &lc)),
        None    :
        {
            if (HashSet::contains(&x.objectless_c, &pr.c))
            {
                objectless_use(g, x, &pr.c, line);
            }
        },
    }
    String cur_c = String::clone(&pr.c);
    Type cur_ty = clone(&pr.ty);
    foreach (st in &steps)
    {
        match (&st.kind)
        {
            ExprKind::EIndex(ip) :
            {
                Type elem = match (&cur_ty)
                {
                    Type::TNamed(n) : clone(&Box::get(n).args[0]),
                    _               :
                    {
                        assert(false, "cobc: an element reference into a non-vector");
                        Type::TVoid
                    },
                };
                String vec_c = ctype(g, &cur_ty);
                String elem_c = ctype(g, &elem);
                u32 tid = type_id(g, &elem);
                Type us = Type::TInt(IntTy::Usize);
                V iv0 = lower_expr(g, x, &Box::get(ip).b, Some(&us));
                if (is_never(&iv0.ty))
                {
                    return Some(true);
                }
                V iv = into_temp(g, x, iv0, line);
                String v = fresh(g, "v");
                String el = fresh(g, "e");
                at(g, x, line);
                emit(x, &sprintf("%s *%s = &(%s);", &vec_c, &v, &cur_c));
                emit(
                    x,
                    &sprintf(
                        "if (%s >= %s->len) cb_fault(\"diag.index-out-of-bounds\", %s);",
                        &iv.c,
                        &v,
                        &loc(g, x.std_body, line),
                    ),
                );
                emit(x, &sprintf("%s *%s = %s->ptr + (int64_t)%s;", &elem_c, &el, &v, &iv.c));
                u32 w = if (mode == Mode::Exclusive) { 1 } else { 0 };
                emit(
                    x,
                    &sprintf(
                        "cb_elem_access(%s, sizeof(*%s), %vu, %s, %v, %s);",
                        &el,
                        &el,
                        tid,
                        m,
                        w,
                        &lc,
                    ),
                );
                cur_c = sprintf("(*%s)", &el);
                cur_ty = elem;
            },
            ExprKind::EField(f)  :
            {
                Type ft = match (&cur_ty)
                {
                    Type::TNamed(n) : Option::expect(
                        field_type(g, Box::get(n), &Box::get(f).name),
                        "cobc: a field of a non-struct element",
                    ),
                    _ :
                    {
                        assert(false, "cobc: a field of a non-struct element");
                        Type::TVoid
                    },
                };
                cur_ty = ft;
                cur_c = sprintf("(%s).%s", &cur_c, &san(&Box::get(f).name));
            },
            _                    : {},
        }
    }
    Type rty = ref_ty(cur_ty, mode);
    match (declared)
    {
        Some(d) : assert(type_eq(d, &rty), "cobc: an element reference of another type"),
        None    : {},
    }
    emit(x, &sprintf("void *%s = (void *)&(%s);", cname, &cur_c));
    names_put(x, NameMap::Unstored, String::clone(cname), "0");
    bind_in_scope(
        x,
        name,
        Binding { .c = String::clone(cname), .ty = rty, .root = String::new(), .kind = BindKind::Local },
    );
    Some(false)
}

// D-0219: the mark a call's callee name carries where its `__arrive` twin is
// asked for (cobc's `ARRIVE_MARK`).
const str ARRIVE_MARK = "__ARRIVE_MARK__";

// `*x` (no parens inside) for an aliased `foreach` element `x`: its alias.
export fn alias_of_deref(ref<Fx, exclusive> x, ref<Expr, shared> e) : Option<Expr>
{
    match (&e.kind)
    {
        ExprKind::EDeref(inner) :
        {
            match (&Box::get(inner).kind)
            {
                ExprKind::EPath(p) :
                {
                    if (Vec::len(&Box::get(p).segs) == 1)
                    {
                        return match (HashMap::get(&x.elem_alias, &Box::get(p).segs[0]))
                        {
                            Some(a) : Some(clone(a)),
                            None    : None,
                        };
                    }
                    None
                },
                _                  : None,
            }
        },
        _                       : None,
    }
}

// `x.f…` read as a value, `x` an aliased `foreach` element: the same fields
// of that element (cobc's `alias_field_chain`), built anew each time.
export fn alias_field_chain(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e) : Option<Expr>
{
    if (HashMap::len(&x.elem_alias) == 0)
    {
        return None;
    }
    match (&e.kind)
    {
        ExprKind::EField(_) : rebuild_alias(g, x, e),
        _                   : None,
    }
}

export fn rebuild_alias(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e) : Option<Expr>
{
    match (&e.kind)
    {
        ExprKind::EField(f) :
        {
            Expr a = match (rebuild_alias(g, x, &Box::get(f).e))
            {
                Some(a) : a,
                None    : return None,
            };
            Some(synth(
                g,
                ExprKind::EField(Box::new(FieldExpr { .e = a, .name = String::clone(&Box::get(f).name) })),
                e.line,
                e.col,
            ))
        },
        ExprKind::EParen(a) : rebuild_alias(g, x, Box::get(a)),
        ExprKind::EPath(p)  :
        {
            if (Vec::len(&Box::get(p).segs) != 1)
            {
                return None;
            }
            alias_copy(g, x, &Box::get(p).segs[0])
        },
        // `(*x).f…`: `*x` is the element itself.
        ExprKind::EDeref(a) :
        {
            match (&strip_parens(Box::get(a)).kind)
            {
                ExprKind::EPath(p) :
                {
                    if (Vec::len(&Box::get(p).segs) != 1)
                    {
                        return None;
                    }
                    alias_copy(g, x, &Box::get(p).segs[0])
                },
                _                  : None,
            }
        },
        _                   : None,
    }
}

// A copy of `n`'s alias with ids of its own (cobc clones it: new addresses).
export fn alias_copy(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<String, shared> n) : Option<Expr>
{
    Expr a = match (HashMap::get(&x.elem_alias, n))
    {
        Some(a) : clone(a),
        None    : return None,
    };
    Some(renumbered(g, &a))
}

// A struct's field type, its type arguments applied (`None`: not a struct or
// no such field).
export fn field_type(ref<Gen, exclusive> g, ref<NamedTy, shared> n, ref<String, shared> f) : Option<Type>
{
    StructDecl sd = match (struct_decl(g, &n.name))
    {
        Some(sd) : sd,
        None     : return None,
    };
    HashMap<String, Type> sub = subst_of(&sd.type_params, &n.args);
    foreach (fd in &sd.fields)
    {
        if (fd.name == *f)
        {
            return Some(apply(&fd.ty, &sub));
        }
    }
    None
}

// A `foreach` holder standing for a confined parameter or holder: its
// `confined_params` entry (cobc's `confined_holder`).
export fn confined_holder(ref<Fx, exclusive> x, ref<Expr, shared> e) : Option<ConfinedVec>
{
    Option<String> n = match (&e.kind)
    {
        ExprKind::ECall(c) :
        {
            if (plain_name_is(&Box::get(c).callee, "$each_drain") && Vec::len(&Box::get(c).args) > 0)
            {
                plain_name(&Box::get(c).args[0])
            }
            else
            {
                None
            }
        },
        _                  : plain_name(e),
    };
    String name = match (n)
    {
        Some(s) : s,
        None    : return None,
    };
    ConfinedVec entry = match (confined_param(x, &name))
    {
        Some(c) : c,
        None    : return None,
    };
    // A confined parameter has no binding; a holder for one has the direct
    // binding `lower_stmt` gave it. Any other binding of the name is not one.
    match (lookup_ref(x, &name))
    {
        Some(b) :
        {
            if (!HashSet::contains(&x.direct_refs, &b.c))
            {
                return None;
            }
        },
        None    : {},
    }
    Some(entry)
}

export fn plain_name_is(ref<Expr, shared> e, str n) : bool
{
    match (plain_name(e))
    {
        Some(s) : s == n,
        None    : false,
    }
}

// `StringView::trim*(x)` (cobc's `trim_of`): the trim and `x`.
export fn trim_of(ref<Expr, shared> e) : Option<TrimOf>
{
    ref<CallExpr, shared> call = match (&strip_parens(e).kind)
    {
        ExprKind::ECall(c) : Box::get(c),
        _                  : return None,
    };
    ref<PathExpr, shared> path = match (&call.callee.kind)
    {
        ExprKind::EPath(p) : Box::get(p),
        _                  : return None,
    };
    if (Vec::len(&path.targs) > 0 || Vec::len(&call.args) != 1)
    {
        return None;
    }
    String k0 = String::join(&path.segs, "::");
    String k = if (StringView::starts_with(&k0, "std::")) { k0 } else { sprintf("std::%s", &k0) };
    if (k != "std::StringView::trim" && k != "std::StringView::trim_start" && k != "std::StringView::trim_end")
    {
        return None;
    }
    match (path_name_raw(&call.args[0]))
    {
        Some(xn) : Some(TrimOf { .k = k, .x = xn }),
        None     : None,
    }
}

struct TrimOf
{
    String k;
    String x;
}

// cobc's `uses::path_name`: a one-segment path through parens, type
// arguments or not.
export fn path_name_raw(ref<Expr, shared> e) : Option<String>
{
    match (&strip_parens(e).kind)
    {
        ExprKind::EPath(p) :
        {
            if (Vec::len(&Box::get(p).segs) == 1)
            {
                return Some(String::clone(&Box::get(p).segs[0]));
            }
            None
        },
        _                  : None,
    }
}

// The bare trimmed view (`bare_trims`): `Some(false)` when bound.
export fn lower_bare_trim(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> name,
    ref<String, shared> cname,
    ref<Option<Type>, shared> declared,
    ref<Expr, shared> e,
) : Option<bool>
{
    Type svt = Type::TNamed(Box::new(NamedTy { .name = "std::StringView", .args = Vec::new() }));
    match (declared)
    {
        Some(t) :
        {
            if (!type_eq(t, &svt))
            {
                return None;
            }
        },
        None    : {},
    }
    TrimOf tr = match (trim_of(e))
    {
        Some(t) : t,
        None    : return None,
    };
    Binding b = match (lookup(x, &tr.x))
    {
        Some(b) : b,
        None    : return None,
    };
    if (!HashSet::contains(&x.direct_refs, &sprintf("%s.bytes", &b.c)) || !type_eq(&b.ty, &svt))
    {
        return None;
    }
    String svc = ctype(g, &svt);
    String i = fresh(g, "ti");
    String n = fresh(g, "tn");
    emit(x, &sprintf("uint64_t %s = 0, %s = (%s).bytes.len;", &i, &n, &b.c));
    String d = sprintf("(%s).bytes.data", &b.c);
    if (tr.k != "std::StringView::trim_end")
    {
        emit(
            x,
            &sprintf(
                "while (%s < %s && (%s[%s] == ' ' || (%s[%s] >= 9 && %s[%s] <= 13))) %s++;",
                &i,
                &n,
                &d,
                &i,
                &d,
                &i,
                &d,
                &i,
                &i,
            ),
        );
    }
    if (tr.k != "std::StringView::trim_start")
    {
        emit(
            x,
            &sprintf(
                "while (%s > %s && (%s[%s - 1] == ' ' || (%s[%s - 1] >= 9 && %s[%s - 1] <= 13))) %s--;",
                &n,
                &i,
                &d,
                &n,
                &d,
                &n,
                &d,
                &n,
                &n,
            ),
        );
    }
    emit(x, &sprintf("%s %s;", &svc, cname));
    emit(x, &sprintf("%s.bytes.src = (%s).bytes.src;", cname, &b.c));
    emit(x, &sprintf("%s.bytes.data = %s + %s;", cname, &d, &i));
    emit(x, &sprintf("%s.bytes.len = %s - %s;", cname, &n, &i));
    names_add(x, NameSet::DirectRefs, sprintf("%s.bytes", cname));
    bind_in_scope(
        x,
        name,
        Binding { .c = String::clone(cname), .ty = svt, .root = String::new(), .kind = BindKind::Local },
    );
    Some(false)
}

// D-0196: the `__raw` form of the function `e` calls, for an objectless
// binding (`raw_ret_ok`, `objectless_binding`).
export fn set_raw_call(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> e,
    ref<Option<Type>, shared> declared,
)
{
    // D-0315: a `match`, `if`, block or `?` given into the objectless binding
    // with no object.
    bool valued = match (&strip_parens(e).kind)
    {
        ExprKind::EMatch(_)     : true,
        ExprKind::EIf(_)        : true,
        ExprKind::EBlock(_)     : true,
        ExprKind::EUnsafe(_)    : true,
        ExprKind::EPropagate(_) : true,
        ExprKind::EStructLit(_) : true,
        ExprKind::EArrayLit(_)  : true,
        _                       : false,
    };
    if (valued)
    {
        if (g.decided)
        {
            // (With no declared type, by the value's.)
            Option<Type> dt = match (declared)
            {
                Some(d) : Some(clone(d)),
                None    : if (x.probing == 0) { Some(probe_type(g, x, e, None)) } else { None },
            };
            match (&dt)
            {
                Some(d) :
                {
                    if (objectless_binding(g, x, e.id, d))
                    {
                        arm_inert(g, x, e, true);
                    }
                },
                None    : {},
            }
        }
        return;
    }
    ref<CallExpr, shared> call = match (&strip_parens(e).kind)
    {
        ExprKind::ECall(c) : Box::get(c),
        _                  : return,
    };
    ref<PathExpr, shared> path = match (&call.callee.kind)
    {
        ExprKind::EPath(p) : Box::get(p),
        _                  : return,
    };
    String k = String::join(&path.segs, "::");
    // D-0315: `std`'s functions by their full name too; a variant (no
    // function) by the declared type.
    Option<Type> ret = match (HashMap::get(&g.prog.table.fns, &k))
    {
        Some(f) : Some(clone(&f.ret)),
        None : match (HashMap::get(&g.prog.table.fns, &sprintf("std::%s", &k)))
        {
            Some(f) : Some(clone(&f.ret)),
            None    : None,
        },
    };
    // D-0315 (step 4): an intrinsic's, by the declared type or the call's
    // probed one.
    if (Option::is_none(&ret) && g.decided && x.probing == 0 && !is_bound(x, &k))
    {
        ret = match (declared)
        {
            Some(d) : Some(clone(d)),
            None    : Some(probe_type(g, x, e, None)),
        };
    }
    bool fits = match (&ret)
    {
        Some(t) :
        {
            match (declared)
            {
                Some(d) : objectless_binding(g, x, e.id, d),
                None    : objectless_binding(g, x, e.id, t),
            }
        },
        None    : false,
    };
    if (!fits && g.decided && literal_expr(g, x, e))
    {
        fits = match (declared)
        {
            Some(d) : objectless_binding(g, x, e.id, d),
            None    : false,
        };
    }
    if (Vec::len(&path.targs) == 0 && !is_bound(x, &k) && raw_ret_ok(g, &k) && fits)
    {
        x.raw_call = Some(request_fn(g, &k, Vec::new()));
    }
    else if (fits)
    {
        // D-0286: any call's, in a decided program.
        arm_inert(g, x, e, true);
    }
}

// `let s = String::new()` / `Vec::new()` into an objectless local (the empty
// value in place, no object), or `String::copy_str(x)` / `String::clone(r)`
// (the native copy's `_raw` form): `Some(diverged)` when done (cobc's
// `bind_fresh_objectless`).
export fn bind_fresh_objectless(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> name,
    ref<String, shared> cname,
    Option<ref<Type, shared>> declared,
    ref<Expr, shared> e,
) : Option<bool>
{
    // D-0274: no `_raw` variants in the bootstrap form (no native bodies).
    if (boot(g, 5))
    {
        return None;
    }
    Type string = Type::TNamed(Box::new(NamedTy { .name = "std::String", .args = Vec::new() }));
    if (HashSet::contains(&x.objectless_names.ids, e.id))
    {
        match (&strip_parens(e).kind)
        {
            ExprKind::ECall(c) :
            {
                match (&Box::get(c).callee.kind)
                {
                    ExprKind::EPath(p) :
                    {
                        String k0 = String::join(&Box::get(p).segs, "::");
                        String k = if (HashMap::contains(
                            &g.prog.table.fns,
                            &k0,
                        )) { k0 } else { sprintf("std::%s", &k0) };
                        bool is_new = k == "std::String::new" || k == "std::Vec::new";
                        bool prel = is_new && match (fn_in_prelude(g, &k))
                        {
                            Some(p) : p,
                            None    : false,
                        };
                        if (Vec::len(&Box::get(c).args) == 0 && Vec::len(&Box::get(p).targs) == 0 && prel)
                        {
                            Option<Type> ty = if (k == "std::String::new") { Some(clone(&string)) } else
                            {
                                match (declared)
                                {
                                    Some(d) :
                                    {
                                        match (d)
                                        {
                                            Type::TNamed(n) : if (Box::get(n).name == "std::Vec" && Vec::len(&Box::get(n).args) == 1) { Some(clone(d)) } else { None },
                                            _               : None,
                                        }
                                    },
                                    None    : None,
                                }
                            };
                            match (ty)
                            {
                                Some(t) :
                                {
                                    bool fits = match (declared)
                                    {
                                        Some(d) : type_eq(d, &t),
                                        None    : true,
                                    };
                                    if (fits && objectless_type(g, &t))
                                    {
                                        String c0 = ctype(g, &t);
                                        u32 tid = type_id(g, &t);
                                        String init = empty_value_init(g, &t);
                                        emit(x, &sprintf("%s %s;", &c0, cname));
                                        emit(
                                            x,
                                            &StringView::replace(
                                                &init,
                                                "@",
                                                cname,
                                            ),
                                        );
                                        Option<usize> saved = replace(&mut x.cur_let, Some(e.id));
                                        objectless_bound(g, x, cname, tid, &t);
                                        x.cur_let = saved;
                                        bind_in_scope(
                                            x,
                                            name,
                                            Binding { .c = String::clone(cname), .ty = clone(&t), .root = String::new(), .kind = BindKind::Local },
                                        );
                                        // A confined `Vec` stays so.
                                        bind_confined(g, x, name, cname, &t);
                                        return Some(false);
                                    }
                                },
                                None    : {},
                            }
                        }
                    },
                    _                  : {},
                }
            },
            _                  : {},
        }
    }
    bool decl_string = match (declared)
    {
        Some(d) : type_eq(d, &string),
        None    : true,
    };
    if (!HashSet::contains(&x.objectless_names.ids, e.id) || !decl_string)
    {
        return None;
    }
    ref<CallExpr, shared> call = match (&strip_parens(e).kind)
    {
        ExprKind::ECall(c) : Box::get(c),
        _                  : return None,
    };
    String prod = match (&call.callee.kind)
    {
        ExprKind::EPath(p) : String::join(&Box::get(p).segs, "::"),
        _                  : return None,
    };
    if ((prod != "std::String::copy_str" && prod != "std::String::clone") || Vec::len(&call.args) != 1)
    {
        return None;
    }
    bool prel = match (fn_in_prelude(g, &prod))
    {
        Some(p) : p,
        None    : false,
    };
    if (!prel)
    {
        return None;
    }
    Type st = Type::TStr;
    V a0 = if (prod == "std::String::copy_str") { lower_expr(g, x, &call.args[0], Some(&st)) } else { lower_expr(g, x, &call.args[0], None) };
    if (is_never(&a0.ty))
    {
        return Some(true);
    }
    V a = into_temp(g, x, a0, e.line);
    String pname = request_fn(g, &prod, Vec::new());
    String sc = ctype(g, &string);
    u32 tid = type_id(g, &string);
    emit(x, &sprintf("%s %s = %s_raw(%s);", &sc, cname, &pname, &a.c));
    Option<usize> saved = replace(&mut x.cur_let, Some(e.id));
    objectless_bound(g, x, cname, tid, &string);
    x.cur_let = saved;
    bind_in_scope(
        x,
        name,
        Binding { .c = String::clone(cname), .ty = string, .root = String::new(), .kind = BindKind::Local },
    );
    Some(false)
}

// A binding of a confined name (`confined_vecs`) whose type is `Vec<T>` for a
// plain, non-zero-sized `T` is confined: no path but its root ever holds it,
// so none of the checks in `push`, `len` and `index_*` is made
// (`confined_local`). An objectless one too.
export fn bind_confined(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> name,
    ref<String, shared> cname,
    ref<Type, shared> ty,
)
{
    if (!HashSet::contains(&x.confined_names, name))
    {
        return;
    }
    Type elem = match (ty)
    {
        Type::TNamed(n) :
        {
            if (Box::get(n).name != "std::Vec" || Vec::len(&Box::get(n).args) != 1)
            {
                return;
            }
            clone(&Box::get(n).args[0])
        },
        _               : return,
    };
    if (size_align(g, &elem).size == 0 || !plain_data(g, &elem))
    {
        return;
    }
    match (lookup(x, name))
    {
        Some(b) :
        {
            if (StringView::len(&b.root) > 0 || HashSet::contains(&x.objectless_c, &b.c))
            {
                names_add(x, NameSet::Confined, String::clone(cname));
            }
        },
        None    : {},
    }
}

// D-0193: a local shared slice the body never assigns, borrows, captures or
// drops: the path it holds stands until its scope ends, so its element reads
// go unchecked, meeting element objects only where its entry test found one.
export fn bind_reader_slice(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> name,
    ref<String, shared> c,
    ref<Type, shared> ty,
)
{
    // D-0274: not in the bootstrap form.
    if (boot(g, 7))
    {
        return;
    }
    bool shared_slice = match (ty)
    {
        Type::TSlice(m) : Box::get(m).mode == Mode::Shared,
        _               : false,
    };
    // Not a hidden binding (`$…`): its uses are expanded only as it is
    // lowered, so `pinned` never saw them.
    if (StringView::starts_with(
        name,
        "$",
    ) || !shared_slice || HashSet::contains(&x.pinned, name) || HashSet::contains(
        &x.assigned,
        name,
    ) || Option::is_some(&x.self_ref))
    {
        return;
    }
    match (lookup_ref(x, name))
    {
        Some(b) :
        {
            if (b.c != *c)
            {
                return;
            }
        },
        None    : return,
    }
    bool was = replace(&mut x.fast_half, false);
    bind_direct_live(g, x, c, ty);
    x.fast_half = was;
    names_add(x, NameSet::DirectRefs, String::clone(c));
}

// D-0200: `ref<Vec<T>, shared> b = …;` (`T` plain), statement `at` of `blk`:
// a held shared path to the `Vec` for `b`'s life, `b` only read and lent to
// readers in the rest of its block, never declared again, its initializer
// naming no guard: confined as a `foreach`'s holder is.
export fn held_vec_reader(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> name,
    ref<Expr, shared> init,
    ref<Block, shared> blk,
    usize at,
) : bool
{
    Binding b = match (lookup(x, name))
    {
        Some(bd) : bd,
        None     : return false,
    };
    bool local = match (&b.kind)
    {
        BindKind::Local : true,
        _               : false,
    };
    bool vec_ok = match (&b.ty)
    {
        Type::TRef(m) :
        {
            Box::get(m).mode == Mode::Shared && match (&Box::get(m).inner)
            {
                Type::TNamed(n) : Box::get(n).name == "std::Vec" && Vec::len(&Box::get(n).args) == 1 && plain_data(g, &Box::get(n).args[0]),
                _               : false,
            }
        },
        _             : false,
    };
    if (!local || !vec_ok || StringView::starts_with(name, "$"))
    {
        return false;
    }
    HashSet<String> names = HashSet::new();
    mentions_into(init, &mut names);
    foreach (n in &names)
    {
        match (lookup_ref(x, n))
        {
            Some(nb) :
            {
                bool guarded = is_guard(&nb.ty) || match (&nb.ty)
                {
                    Type::TRef(m) : is_guard(&Box::get(m).inner),
                    _             : false,
                };
                if (guarded)
                {
                    return false;
                }
            },
            None     : {},
        }
    }
    if (!held_names_ok(blk, at, name))
    {
        return false;
    }
    Block rest = rest_block(blk, at);
    CalleeTest reads = CalleeTest::ClosureReads(bound_names(&rest));
    reader_uses(g, &rest, name, false, &reads)
}

export fn confine_holder(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<String, shared> name)
{
    Binding b = match (lookup(x, name))
    {
        Some(bd) : bd,
        None     : return,
    };
    Type inner = match (&b.ty)
    {
        Type::TRef(m) : clone(&Box::get(m).inner),
        _             : return,
    };
    Type elem = match (&inner)
    {
        Type::TNamed(n) :
        {
            if (Box::get(n).name != "std::Vec" || Vec::len(&Box::get(n).args) != 1)
            {
                return;
            }
            clone(&Box::get(n).args[0])
        },
        _               : return,
    };
    if (!plain_data(g, &elem) || size_align(g, &elem).size == 0)
    {
        return;
    }
    String vec_c = ctype(g, &inner);
    HashMap::insert(
        &mut x.confined_params,
        String::clone(name),
        ConfinedVec { .c = sprintf("(*(%s *)%s)", &vec_c, &b.c), .path = "0", .elem = elem },
    );
}

// A confined vector passed as a `Vec` function's reference argument: `&x` /
// `&mut x` for a confined local `x`, or `p` / `&*p` / `&mut *p` for a
// confined parameter or holder `p` (cobc's `confined_local`).
export fn confined_local(ref<Fx, exclusive> x, ref<Expr, shared> e) : Option<ConfinedVec>
{
    match (&e.kind)
    {
        ExprKind::EBorrow(bb) :
        {
            ref<Expr, shared> inner = &Box::get(bb).e;
            // D-0189: `&b.f` / `&(*b).f` of a field a field dual body's fast
            // half confines.
            if (HashMap::len(&x.field_confined) > 0)
            {
                match (&strip_parens(inner).kind)
                {
                    ExprKind::EField(fe) :
                    {
                        ref<Expr, shared> base = strip_parens(&Box::get(fe).e);
                        Option<String> bn = match (&base.kind)
                        {
                            ExprKind::EDeref(d) : plain_name(strip_parens(Box::get(d))),
                            _                   : plain_name(base),
                        };
                        String b = match (bn)
                        {
                            Some(n) : n,
                            None    : return None,
                        };
                        return match (HashMap::get(&x.field_confined, &sprintf("%s.%s", &b, &Box::get(fe).name)))
                        {
                            Some(fc) : Some(ConfinedVec { .c = String::clone(&fc.c), .path = "0", .elem = clone(&fc.elem) }),
                            None     : None,
                        };
                    },
                    _                    : {},
                }
            }
            match (&inner.kind)
            {
                ExprKind::EDeref(p) :
                {
                    return match (plain_name(Box::get(p)))
                    {
                        Some(n) : confined_param(x, &n),
                        None    : None,
                    };
                },
                _                   : {},
            }
            String n = match (plain_name(inner))
            {
                Some(n) : n,
                None    : return None,
            };
            Binding b = match (lookup(x, &n))
            {
                Some(bd) : bd,
                None     : return None,
            };
            if (!HashSet::contains(&x.confined, &b.c))
            {
                return None;
            }
            Type elem = match (&b.ty)
            {
                Type::TNamed(nt) :
                {
                    if (Vec::len(&Box::get(nt).args) == 0)
                    {
                        return None;
                    }
                    clone(&Box::get(nt).args[0])
                },
                _                : return None,
            };
            // D-0200: an objectless confined `Vec` has no root: token 0.
            String root = if (StringView::len(&b.root) == 0) { "0" } else { String::clone(&b.root) };
            Some(ConfinedVec { .c = String::clone(&b.c), .path = root, .elem = elem })
        },
        ExprKind::EPath(_)    :
        {
            match (plain_name(e))
            {
                Some(n) : confined_param(x, &n),
                None    : None,
            }
        },
        _                     : None,
    }
}

export fn confined_param(ref<Fx, exclusive> x, ref<String, shared> n) : Option<ConfinedVec>
{
    match (HashMap::get(&x.confined_params, n))
    {
        Some(c) : Some(clone(c)),
        None    : None,
    }
}

// A one-segment path with no type arguments: its name (no parens).
export fn plain_name(ref<Expr, shared> e) : Option<String>
{
    match (&e.kind)
    {
        ExprKind::EPath(p) :
        {
            if (Vec::len(&Box::get(p).segs) == 1 && Vec::len(&Box::get(p).targs) == 0)
            {
                return Some(String::clone(&Box::get(p).segs[0]));
            }
            None
        },
        _                  : None,
    }
}

// An element access's vector: a confined local's or a confined field's
// (cobc's `confined_elem_vec`; confined fields come with stage 4).
export fn confined_elem_vec(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e) : Option<ConfinedVec>
{
    match (confined_local(x, e))
    {
        Some(c) : Some(c),
        None    : confined_field(g, x, e),
    }
}

// `&h.f` for a local struct `h` whose `Vec` field `f` of plain, non-zero-sized
// elements `confined_fields` found reached only as `h.f[i]` and
// `Vec::len(&h.f)` (cobc's `confined_field`).
export fn confined_field(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e) : Option<ConfinedVec>
{
    ref<Expr, shared> inner = match (&strip_parens(e).kind)
    {
        ExprKind::EBorrow(bb) : &Box::get(bb).e,
        _                     : return None,
    };
    ref<FieldExpr, shared> fe = match (&strip_parens(inner).kind)
    {
        ExprKind::EField(f) : Box::get(f),
        _                   : return None,
    };
    String h = match (path_name_raw(&fe.e))
    {
        Some(n) : n,
        None    : return None,
    };
    if (!HashSet::contains(&x.confined_fields, &sprintf("%s.%s", &h, &fe.name)))
    {
        return None;
    }
    Binding b = match (lookup(x, &h))
    {
        Some(bd) : bd,
        None     : return None,
    };
    bool local = match (&b.kind)
    {
        BindKind::Local : true,
        _               : false,
    };
    if (!local || StringView::len(&b.root) == 0)
    {
        return None;
    }
    ref<NamedTy, shared> st = match (&b.ty)
    {
        Type::TNamed(n) : Box::get(n),
        _               : return None,
    };
    StructDecl sd = match (struct_decl(g, &st.name))
    {
        Some(d) : d,
        None    : return None,
    };
    HashMap<String, Type> sub = subst_of(&sd.type_params, &st.args);
    Option<Type> fty = None;
    foreach (fd in &sd.fields)
    {
        if ((fd.name == fe.name) && Option::is_none(&fty))
        {
            fty = Some(apply(&fd.ty, &sub));
        }
    }
    Type vt = match (fty)
    {
        Some(t) : t,
        None    : return None,
    };
    Type elem = match (vec_plain_elem(g, &vt))
    {
        Some(el) : el,
        None     : return None,
    };
    Some(ConfinedVec { .c = sprintf(
        "%s.%s",
        &b.c,
        &san(&fe.name),
    ), .path = String::new(), .elem = elem })
}

// `Vec<T>`'s `T` where it is plain data and sized.
fn vec_plain_elem(ref<Gen, exclusive> g, ref<Type, shared> t) : Option<Type>
{
    match (t)
    {
        Type::TNamed(n) :
        {
            ref<NamedTy, shared> nt = Box::get(n);
            if (nt.name != "std::Vec" || Vec::len(&nt.args) != 1)
            {
                return None;
            }
            if (!plain_data(g, &nt.args[0]) || size_align(g, &nt.args[0]).size == 0)
            {
                return None;
            }
            Some(clone(&nt.args[0]))
        },
        _               : None,
    }
}

// `&x` / `&mut x` for a local `x` that `read_confined_vecs` found no exclusive
// path can ever be held to (a `Vec` of plain, non-zero-sized elements): a read
// of an element, or of the length, needs its bounds check alone (cobc's
// `read_confined_vec`). `.path` is empty.
export fn read_confined_vec(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e) : Option<ConfinedVec>
{
    ref<Expr, shared> inner = match (&strip_parens(e).kind)
    {
        ExprKind::EBorrow(bb) : &Box::get(bb).e,
        _                     : return None,
    };
    String n = match (path_name_raw(inner))
    {
        Some(s) : s,
        None    : return None,
    };
    if (!HashSet::contains(&x.read_confined, &n))
    {
        return None;
    }
    Binding b = match (lookup(x, &n))
    {
        Some(bd) : bd,
        None     : return None,
    };
    bool local = match (&b.kind)
    {
        BindKind::Local : true,
        _               : false,
    };
    if (!local || StringView::len(&b.root) == 0)
    {
        return None;
    }
    match (vec_plain_elem(g, &b.ty))
    {
        Some(el) : Some(ConfinedVec { .c = String::clone(&b.c), .path = String::new(), .elem = el }),
        None     : None,
    }
}

export fn is_string_ty(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(n) : Box::get(n).name == "std::String" && Vec::len(&Box::get(n).args) == 0,
        _               : false,
    }
}

// D-0200: a `String` made by `e` with no object, where `e`'s maker has a form
// that makes none: `String::clone`/`copy_str` (their `_raw` variants),
// `String::copy(String::part(…))` (the substring helper's), or a
// function with a `__raw` form (`raw_ret_ok`). Its value is inert
// (`inert_c`). `None`: `e` is none of these (cobc's `lower_raw_string`).
export fn lower_raw_string(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e) : Option<V>
{
    // D-0274: no `_raw` variants in the bootstrap form (no native bodies).
    if (boot(g, 5))
    {
        return None;
    }
    Type string = Type::TNamed(Box::new(NamedTy { .name = "std::String", .args = Vec::new() }));
    ref<Expr, shared> se = strip_parens(e);
    ref<CallExpr, shared> call = match (&se.kind)
    {
        ExprKind::ECall(c) : Box::get(c),
        _                  : return None,
    };
    ref<PathExpr, shared> path = match (&call.callee.kind)
    {
        ExprKind::EPath(p) : Box::get(p),
        _                  : return None,
    };
    if (Vec::len(&path.targs) > 0 || (Vec::len(&path.segs) == 1 && is_bound(
        x,
        &path.segs[0],
    )))
    {
        return None;
    }
    String k0 = String::join(&path.segs, "::");
    String k = if (HashMap::contains(&g.prog.table.fns, &k0)) { k0 } else { sprintf("std::%s", &k0) };
    FnHead f = match (fn_head(g, &k))
    {
        Some(fd) : fd,
        None     : return None,
    };
    bool prel = f.prelude;
    usize n = Vec::len(&call.args);
    if ((k == "std::String::clone" || k == "std::String::copy_str") && prel && n == 1)
    {
        Type st = Type::TStr;
        V a0 = if (k == "std::String::copy_str") { lower_expr(g, x, &call.args[0], Some(&st)) } else { lower_expr(g, x, &call.args[0], None) };
        if (is_never(&a0.ty))
        {
            return Some(a0);
        }
        V a = into_temp(g, x, a0, e.line);
        String pname = request_fn(g, &k, Vec::new());
        String sc = ctype(g, &string);
        String t = fresh(g, "t");
        at(g, x, e.line);
        emit(x, &sprintf("%s %s = %s_raw(%s);", &sc, &t, &pname, &a.c));
        names_add(x, NameSet::InertC, String::clone(&t));
        return Some(V { .c = t, .ty = string, .obj = None });
    }
    if (k == "std::String::copy" && prel && n == 1)
    {
        x.raw_substring = Some(args_key(&call.args));
        // D-0315: or the call's result with no object.
        arm_inert(g, x, e, false);
        V v = lower_expr(g, x, e, Some(&string));
        x.inert_result = None;
        x.raw_substring = None;
        return Some(v);
    }
    if (f.ntype_params == 0 && type_eq(&f.ret, &string) && raw_ret_ok(g, &k))
    {
        x.raw_call = Some(request_fn(g, &k, Vec::new()));
        V v = lower_expr(g, x, e, Some(&string));
        x.raw_call = None;
        return Some(v);
    }
    None
}

// `Box::get[_mut](b)` of an unminted arm binder `b` for a pure direct
// parameter: the read of the box's pointer through the binder's base, the
// contents' element access in the borrow's mode, then the address alone.
fn lower_box_arg_unminted(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> gname,
    ref<Expr, shared> ba,
    ref<FnDecl, shared> f,
    ref<ParamDecl, shared> p,
    ref<HashMap<String, Type>, exclusive> m,
    usize line,
) : Option<V>
{
    String bn = match (path_name_raw(ba))
    {
        Some(n) : n,
        None    : return None,
    };
    Binding bind = match (lookup(x, &bn))
    {
        Some(b) : b,
        None    : return None,
    };
    Unminted um = match (HashMap::get(&x.unminted_binders, &bind.c))
    {
        Some(u) : clone(u),
        None    : return None,
    };
    Type bt = match (&bind.ty)
    {
        Type::TRef(r) : clone(&Box::get(r).inner),
        _             : return None,
    };
    Type elem = match (&bt)
    {
        Type::TNamed(n) :
        {
            if (Vec::len(&Box::get(n).args) != 1)
            {
                return None;
            }
            clone(&Box::get(n).args[0])
        },
        _               : return None,
    };
    String bc = ctype(g, &bt);
    u32 tid = type_id(g, &elem);
    bool shared = *gname == "std::Box::get";
    str md = if (shared) { "CB_SHARED" } else { "CB_EXCLUSIVE" };
    if (StringView::len(&um.tok) > 0)
    {
        Vec<String> all = clone(&um.projs);
        Vec::push(&mut all, "{ CB_FIELD, 0u }");
        emit(
            x,
            &sprintf(
                "cb_read(%s, (cb_proj[]){ %s }, %v, CB_NOLOC, 0);",
                &um.tok,
                &String::join(&all, ", "),
                Vec::len(&all),
            ),
        );
    }
    String ad = fresh(g, "ad");
    String lc = loc(g, x.std_body, line);
    // The call's location, as a `std` call sets it: where its element borrow
    // would fault.
    at(g, x, line);
    emit(x, &sprintf("void *%s = (void *)((%s *)%s)->ptr;", &ad, &bc, &bind.c));
    u64 esz = size_align(g, &elem).size;
    emit(x, &sprintf("cb_elem_access(%s, %vu, %vu, %s, 0, %s);", &ad, esz, tid, md, &lc));
    Mode mode = if (shared) { Mode::Shared } else { Mode::Exclusive };
    Type ty = ref_ty(elem, mode);
    unify(&p.ty, &ty, &f.type_params, m);
    Some(V { .c = sprintf("((cb_ref){ %s, 0 })", &ad), .ty = ty, .obj = None })
}

// A value made only of plain data and `String`s, through structs and enums
// (cobc's `flat_value`).
export fn flat_value(ref<Gen, exclusive> g, ref<Type, shared> t) : bool
{
    flat_value_in(g, t, 0)
}

fn flat_value_in(ref<Gen, exclusive> g, ref<Type, shared> t, usize depth) : bool
{
    if (depth > 8)
    {
        return false;
    }
    if (plain_data(g, t))
    {
        return true;
    }
    match (t)
    {
        Type::TNamed(n) :
        {
            ref<NamedTy, shared> nt = Box::get(n);
            if (nt.name == "std::String" && Vec::len(&nt.args) == 0)
            {
                return true;
            }
            match (struct_decl(g, &nt.name))
            {
                Some(sd) :
                {
                    HashMap<String, Type> sub = subst_of(&sd.type_params, &nt.args);
                    foreach (fd in &sd.fields)
                    {
                        if (!flat_value_in(g, &apply(&fd.ty, &sub), depth + 1))
                        {
                            return false;
                        }
                    }
                    return true;
                },
                None     : {},
            }
            match (enum_decl(g, &nt.name))
            {
                Some(ed) :
                {
                    HashMap<String, Type> sub = subst_of(&ed.type_params, &nt.args);
                    foreach (v in &ed.variants)
                    {
                        match (&v.payload)
                        {
                            Some(pt) :
                            {
                                if (!flat_value_in(g, &apply(pt, &sub), depth + 1))
                                {
                                    return false;
                                }
                            },
                            None     : {},
                        }
                    }
                    true
                },
                None     : false,
            }
        },
        _               : false,
    }
}

// CHG-0237: `x.f…` (or `(*x).f…`), one field or more, for `x` a shared
// reference parameter that is never written, borrowed or captured
// (`unstored`), in a frozen body (cobc's `frozen_root`).
export fn frozen_root(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e) : bool
{
    if (!x.frozen_on)
    {
        return false;
    }
    ref<Expr, shared> at_e = strip_parens(e);
    usize fields = 0;
    while (true)
    {
        match (&at_e.kind)
        {
            ExprKind::EField(fe) :
            {
                fields += 1;
                at_e = strip_parens(&Box::get(fe).e);
            },
            ExprKind::EDeref(d)  :
            {
                // Only the parameter itself is dereferenced (`(*x).f`).
                bool path = match (&strip_parens(Box::get(d)).kind)
                {
                    ExprKind::EPath(_) : true,
                    _                  : false,
                };
                if (fields > 0 && path)
                {
                    at_e = strip_parens(Box::get(d));
                }
                else
                {
                    return false;
                }
            },
            ExprKind::EPath(pe)  :
            {
                if (Vec::len(&Box::get(pe).segs) != 1 || Vec::len(&Box::get(pe).targs) != 0 || fields == 0)
                {
                    return false;
                }
                return match (lookup_ref(x, &Box::get(pe).segs[0]))
                {
                    Some(b) : HashMap::contains(&x.unstored, &b.c) && match (&b.ty)
                    {
                        Type::TRef(r) : Box::get(r).mode == Mode::Shared,
                        _             : false,
                    },
                    None : false,
                };
            },
            _                    : return false,
        }
    }
    false
}

// CHG-0237: `x` (or `&*x`) for a parameter `x : ref<Vec<T>, shared>` that is
// never written, borrowed or captured (`unstored`), `T` sized: the vector (a C
// lvalue) and `T` (cobc's `frozen_vec`).
export fn frozen_vec(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e) : Option<ConfinedVec>
{
    if (!x.frozen_on)
    {
        return None;
    }
    ref<Expr, shared> se = strip_parens(e);
    String name = match (&se.kind)
    {
        ExprKind::EPath(_) : match (plain_name(se))
        {
            Some(n) : n,
            None    : return None,
        },
        ExprKind::EBorrow(bb) :
        {
            if (Box::get(bb).mode != Mode::Shared)
            {
                return None;
            }
            match (&strip_parens(&Box::get(bb).e).kind)
            {
                ExprKind::EDeref(d) : match (plain_name(strip_parens(Box::get(d))))
                {
                    Some(n) : n,
                    None    : return None,
                },
                _ : return None,
            }
        },
        _                     : return None,
    };
    Binding b = match (lookup(x, &name))
    {
        Some(bd) : bd,
        None     : return None,
    };
    if (!HashMap::contains(&x.unstored, &b.c))
    {
        return None;
    }
    Type inner = match (&b.ty)
    {
        Type::TRef(r) :
        {
            if (Box::get(r).mode != Mode::Shared)
            {
                return None;
            }
            clone(&Box::get(r).inner)
        },
        _             : return None,
    };
    Type elem = match (&inner)
    {
        Type::TNamed(n) :
        {
            if (Box::get(n).name != "std::Vec" || Vec::len(&Box::get(n).args) != 1)
            {
                return None;
            }
            clone(&Box::get(n).args[0])
        },
        _               : return None,
    };
    if (size_align(g, &elem).size == 0)
    {
        return None;
    }
    String vc = ctype(g, &inner);
    Some(ConfinedVec { .c = sprintf("(*(%s *)%s)", &vc, &b.c), .path = String::new(), .elem = elem })
}

// The element `a1` of the confined vector `cv`: the body's location and
// bounds fault, and the element's address.
fn confined_elem_place(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<ConfinedVec, shared> cv,
    ref<Expr, shared> a1,
    usize line,
) : P
{
    V i = lower_index_arg(g, x, sprintf("(%s).len", &cv.c), a1);
    if (is_never(&i.ty))
    {
        return P { .c = String::new(), .ty = Type::TNever, .base = None, .projs = Vec::new(), .is_binding = false, .raw = None };
    }
    V it = into_temp(g, x, i, a1.line);
    String vec_c = ctype(
        g,
        &Type::TNamed(Box::new(NamedTy { .name = "std::Vec", .args = one_type(clone(&cv.elem)) })),
    );
    String elem_c = ctype(g, &cv.elem);
    // A loop's fixed header (`hoist_vec_headers`): its copies.
    Option<Hoisted> ho = match (HashMap::get(&x.hoisted, &cv.c))
    {
        Some(h) : Some(Hoisted { .ptr = String::clone(&h.ptr), .len = String::clone(&h.len) }),
        None    : None,
    };
    match (ho)
    {
        Some(h) :
        {
            String he = fresh(g, "e");
            at(g, x, line);
            String bl = loc(g, x.std_body, line);
            String tag = version_tag(x, a1, &h.len);
            emit(x, &sprintf("%sif (%s >= %s) cb_fault(\"diag.index-out-of-bounds\", %s);", &tag, &it.c, &h.len, &bl));
            emit(x, &sprintf("%s *%s = %s + (int64_t)%s;", &elem_c, &he, &h.ptr, &it.c));
            return P { .c = sprintf("(*%s)", &he), .ty = clone(&cv.elem), .base = None, .projs = Vec::new(), .is_binding = false, .raw = None };
        },
        None    : {},
    }
    String v = fresh(g, "v");
    String ev = fresh(g, "e");
    at(g, x, line);
    emit(x, &sprintf("%s *%s = &(%s);", &vec_c, &v, &cv.c));
    emit(
        x,
        &sprintf("if (%s >= %s->len) cb_fault(\"diag.index-out-of-bounds\", %s);", &it.c, &v, &loc(g, x.std_body, line)),
    );
    emit(x, &sprintf("%s *%s = %s->ptr + (int64_t)%s;", &elem_c, &ev, &v, &it.c));
    P { .c = sprintf(
        "(*%s)",
        &ev,
    ), .ty = clone(&cv.elem), .base = None, .projs = Vec::new(), .is_binding = false, .raw = None }
}

// A place through fields of a direct reference (`box_rec_uses`).
export fn direct_place(ref<Fx, exclusive> x, ref<Expr, shared> e) : bool
{
    match (&strip_parens(e).kind)
    {
        ExprKind::EField(f) : direct_place(x, &Box::get(f).e),
        ExprKind::EPath(p)  :
        {
            if (Vec::len(&Box::get(p).segs) != 1)
            {
                return false;
            }
            match (lookup_ref(x, &Box::get(p).segs[0]))
            {
                Some(b) : HashSet::contains(&x.direct_refs, &b.c) && is_ref_type(&b.ty),
                None    : false,
            }
        },
        _                   : false,
    }
}

// A direct slice's entry test: whether any of its elements has an object.
export fn bind_direct_live(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<String, shared> pc, ref<Type, shared> ty)
{
    Type elem = match (ty)
    {
        Type::TSlice(m) : clone(&Box::get(m).inner),
        _               : return,
    };
    u64 size = size_align(g, &elem).size;
    String flag = sprintf("lv_%s", pc);
    if (x.fast_half)
    {
        // A dual body's fast half: its dispatcher's test found no element
        // object.
        emit(x, &sprintf("const uint8_t %s = 0;", &flag));
    }
    else
    {
        emit(
            x,
            &sprintf(
                "uint8_t %s = cb_live_in((void *)(%s).data, (%s).len * %vu);",
                &flag,
                pc,
                pc,
                size,
            ),
        );
    }
    HashMap::insert(&mut x.direct_live, String::clone(pc), flag);
}

// ---- calls ----

// A callee that is not a path: a place holding a `fn` value (`(t.run)()`,
// `(*f)(x)`, `(fs[i])(x)`) is called where it is; any other expression's
// `fn` value through its thunk.
// The type a binding's place has: a borrow capture's is the captured value.
export fn binding_place_ty(ref<Binding, shared> b) : Type
{
    match (&b.kind)
    {
        BindKind::CaptureRef(_) : match (&b.ty)
        {
            Type::TRef(m) : clone(&Box::get(m).inner),
            _             : clone(&b.ty),
        },
        _ : clone(&b.ty),
    }
}

export fn one_type(Type t) : Vec<Type>
{
    Vec<Type> v = Vec::new();
    Vec::push(&mut v, t);
    v
}

export fn is_shared_ref(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(m) : Box::get(m).mode == Mode::Shared,
        _             : false,
    }
}

export fn vec_of(String s) : Vec<String>
{
    Vec<String> v = Vec::new();
    Vec::push(&mut v, s);
    v
}

export fn lower_call_value(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> callee,
    ref<Vec<Expr>, shared> args,
    usize line,
) : V
{
    ref<Expr, shared> bare = strip_parens(callee);
    bool placeish = match (&bare.kind)
    {
        ExprKind::EField(_) : true,
        ExprKind::EIndex(_) : true,
        ExprKind::EDeref(_) : true,
        _                   : false,
    };
    if (placeish)
    {
        Type pt = probe_place_type(g, x, bare);
        match (&pt)
        {
            Type::TFn(_) :
            {
                P p = lower_place(g, x, bare);
                return call_fn_place(g, x, &p, args, line, true, bare);
            },
            _            : {},
        }
    }
    V v = lower_expr(g, x, callee, None);
    if (is_never(&v.ty))
    {
        return never();
    }
    V t = into_temp(g, x, v, line);
    match (&t.ty)
    {
        Type::TFn(_)       :
        {
            Type fty = clone(&t.ty);
            call_fn_value(g, x, String::clone(&t.c), &fty, args, line)
        },
        // A closure temporary gets a path of its own for `[Closure-Call]`'s
        // exclusive `self` borrow, and stays a temporary of this statement.
        Type::TClosure(id) :
        {
            u64 cid = *id;
            String lc = loc(g, x.std_body, line);
            String o = match (&t.obj)
            {
                Some(o) : String::clone(o),
                None    :
                {
                    u32 tid = type_id(g, &t.ty);
                    String o = fresh(g, "o");
                    emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &t.c, tid, &lc));
                    o
                },
            };
            String tok = fresh(g, "tok");
            emit(x, &sprintf("uint64_t %s = cb_temp_path(%s);", &tok, &o));
            P p = P { .c = String::clone(&t.c), .ty = clone(&t.ty), .base = Some(tok), .projs = Vec::new(), .is_binding = false, .raw = None };
            call_closure_place(g, x, cid, &p, args, line)
        },
        _                  :
        {
            assert(false, "cobc: call of a non-callable value");
            unit()
        },
    }
}

// A `fn` value called where it is: the place read, a closure that writes
// its own captures borrowed exclusively through it (D-0239), and through a
// shared reference checked (D-0218, `shared` for a place callee).
export fn call_fn_place(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<P, shared> p,
    ref<Vec<Expr>, shared> args,
    usize line,
    bool shared,
    ref<Expr, shared> place,
) : V
{
    String lc = loc(g, x.std_body, line);
    match (&p.base)
    {
        Some(base) : emit(x, &sprintf("cb_read(%s, %s, %s);", base, &projs_args(&p.projs), &lc)),
        None       : {},
    }
    String h = fresh(g, "h");
    emit(x, &sprintf("void *%s = %s;", &h, &p.c));
    match (&p.base)
    {
        Some(base) : emit(
            x,
            &sprintf(
                "if (%s && ((cb_fnbox *)%s)->closure == 3u) cb_write(%s, %s, 0u, %s);",
                &h,
                &h,
                base,
                &projs_args(&p.projs),
                &lc,
            ),
        ),
        None : {},
    }
    if (shared && HashSet::contains(&g.prog.facts.shared_fn_reads, place.id))
    {
        emit(x, &sprintf("cb_fn_shared(%s, %s);", &h, &lc));
    }
    Type fty = clone(&p.ty);
    call_fn_value(g, x, h, &fty, args, line)
}

// Already-typed arguments lowered, resources and reference data put in
// flight; `None` when an argument diverged.
export fn lower_args(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Vec<Type>, shared> ptypes,
    ref<Vec<Expr>, shared> args,
) : Option<Vec<String>>
{
    Vec<V> vals = Vec::new();
    for (usize i = 0; i < Vec::len(ptypes) && i < Vec::len(args); i += 1)
    {
        V v = lower_expr(g, x, &args[i], Some(&ptypes[i]));
        if (is_never(&v.ty))
        {
            return None;
        }
        Vec::push(&mut vals, into_temp(g, x, v, args[i].line));
    }
    Vec<String> names = Vec::new();
    for (usize i = 0; i < Vec::len(&vals); i += 1)
    {
        ref<Type, shared> pty = &ptypes[i];
        bool is_ref = match (pty)
        {
            Type::TRef(_) : true,
            _             : false,
        };
        if (is_resource(g, pty))
        {
            give_arg(g, x, &vals[i], "a closure's or `fn` value's argument");
        }
        else if (has_refs(g, pty) && !is_ref)
        {
            u32 tid = type_id(g, pty);
            emit(x, &sprintf("cb_send_datum(&%s, %vu);", &vals[i].c, tid));
        }
        Vec::push(&mut names, String::clone(&vals[i].c));
    }
    Some(names)
}

// `[Closure-Call]` on a closure place: an exclusive borrow of it is `self`.
export fn call_closure_place(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    u64 id,
    ref<P, shared> p,
    ref<Vec<Expr>, shared> args,
    usize line,
) : V
{
    ClosureInfo info = clone(Option::expect(HashMap::get(&g.closures, id), "a lowered closure"));
    // D-0315 (step 4): an objectless closure local: `self` at token 0.
    String tok = String::new();
    if (g.decided && Option::is_none(&p.base) && p.is_binding && Vec::len(&p.projs) == 0 && HashSet::contains(
        &x.objectless_c,
        &p.c,
    ))
    {
        objectless_use(g, x, &p.c, line);
        tok = "0";
    }
    else
    {
        String base = Option::expect(clone(&p.base), "cobc: closure call on a temporary");
        String lc = loc(g, x.std_body, line);
        tok = fresh(g, "tok");
        emit(
            x,
            &sprintf(
                "uint64_t %s = cb_borrow(%s, %s, CB_EXCLUSIVE, %s);",
                &tok,
                &base,
                &projs_args(&p.projs),
                &lc,
            ),
        );
    }
    String self_ref = sprintf("((cb_ref){ (void *)&(%s), %s })", &p.c, &tok);
    match (lower_args(g, x, &info.params, args))
    {
        Some(ns) :
        {
            String call = sprintf("%s(%s", &info.cname, &self_ref);
            foreach (n in &ns)
            {
                String::appendf(&mut call, ", %s", n);
            }
            String::append(&mut call, ")");
            finish_call(g, x, call, clone(&info.ret), line)
        },
        None     : never(),
    }
}

// `[Callable-Closure]`: a closure value moves into a callable box.
export fn box_closure(ref<Gen, exclusive> g, ref<Fx, exclusive> x, V v0, Type dst, usize line) : V
{
    u64 id = match (&v0.ty)
    {
        Type::TClosure(i) : *i,
        _                 :
        {
            assert(false, "cobc: boxing a non-closure");
            0
        },
    };
    ClosureInfo info = clone(Option::expect(HashMap::get(&g.closures, id), "a lowered closure"));
    // D-0315: in a decided program a closure that captures nothing is a static
    // box the runtime never registers (as a fn item's handle).
    if (g.decided && Vec::len(&info.fields) == 0)
    {
        match (&v0.obj)
        {
            Some(o) : emit(x, &sprintf("cb_forget_obj(%s);", o)),
            None    : {},
        }
        u32 tid0 = type_id(g, &v0.ty);
        String h0 = fresh(g, "h");
        note_fn_target(g, &apply(&dst, &x.subst), &info.cname, 2);
        emit(x, &sprintf("static cb_fnbox %s_b = { (void *)%s, 0, 0, %vu, 2u };", &h0, &info.cname, tid0));
        emit(x, &sprintf("void *%s = (void *)&%s_b;", &h0, &h0));
        if (HashSet::contains(&g.pure_closures, id) && plain_ret(g, &info.ret))
        {
            emit(x, &sprintf("cb_fn_mark_pure((void *)%s);", &info.cname));
        }
        return V { .c = h0, .ty = dst, .obj = None };
    }
    // D-0315 (step 4): one whose captures are references or plain data, given
    // to a parameter that does not escape: a stack box, never registered.
    bool plain_caps = true;
    foreach (cf in &info.fields)
    {
        bool is_ref = match (&cf.ty)
        {
            Type::TRef(_) : true,
            _             : false,
        };
        if (!is_ref && (is_resource(g, &cf.ty) || holds_fn(g, &cf.ty)))
        {
            plain_caps = false;
        }
    }
    if (g.decided && replace(&mut x.stack_box, false) && plain_caps)
    {
        match (&v0.obj)
        {
            Some(o) : emit(x, &sprintf("cb_forget_obj(%s);", o)),
            None    : {},
        }
        u32 tid1 = type_id(g, &v0.ty);
        String h1 = fresh(g, "h");
        u32 kind = if (info.writes_self) { 3 } else { 1 };
        note_fn_target(g, &apply(&dst, &x.subst), &info.cname, kind);
        emit(x, &sprintf("cb_fnbox %s_b = { (void *)%s, (void *)&%s, 0, %vu, %vu };", &h1, &info.cname, &v0.c, tid1, kind));
        emit(x, &sprintf("void *%s = (void *)&%s_b;", &h1, &h1));
        if (HashSet::contains(&g.pure_closures, id) && plain_ret(g, &info.ret))
        {
            emit(x, &sprintf("cb_fn_mark_pure((void *)%s);", &info.cname));
        }
        return V { .c = h1, .ty = dst, .obj = None };
    }
    // A closure read out of a binding is copied or moved, as any struct;
    // either way the box takes an object of its own.
    V v = if (Option::is_none(&v0.obj)) { into_temp(g, x, v0, line) } else { v0 };
    String o = match (&v.obj)
    {
        Some(o) : String::clone(o),
        None    :
        {
            u32 tid = type_id(g, &v.ty);
            String lc = loc(g, x.std_body, line);
            String o = fresh(g, "o");
            emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &v.c, tid, &lc));
            o
        },
    };
    u32 tid = type_id(g, &v.ty);
    String h = fresh(g, "h");
    u32 bkind = if (Vec::len(&info.fields) == 0) { 2 } else if (info.writes_self) { 3 } else { 1 };
    note_fn_target(g, &apply(&dst, &x.subst), &info.cname, bkind);
    emit(x, &sprintf("void *%s = cb_fn_box(%s, (void *)%s, %vu);", &h, &o, &info.cname, tid));
    if (Vec::len(&info.fields) == 0)
    {
        // Its code never reaches `self`: a call through the box forms no
        // borrow of the object.
        emit(x, &sprintf("((cb_fnbox *)%s)->closure = 2u;", &h));
    }
    else if (info.writes_self)
    {
        // D-0239: its calls write its own captures.
        emit(x, &sprintf("((cb_fnbox *)%s)->closure = 3u;", &h));
    }
    if (HashSet::contains(&g.pure_closures, id) && plain_ret(g, &info.ret))
    {
        emit(x, &sprintf("cb_fn_mark_pure((void *)%s);", &info.cname));
    }
    V { .c = h, .ty = dst, .obj = None }
}

// A result that holds nothing of the arguments (cobc's `plain_ret`).
export fn plain_ret(ref<Gen, shared> g, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TVoid : return true,
        _           : {},
    }
    plain_data(g, t) && !has_refs(g, t) && !holds_fn(g, t)
}

// A closure's id: unique in the program, the same in every pass.
export fn closure_id(ref<Gen, exclusive> g) : u64
{
    g.uid += 1;
    g.closure_base | g.uid
}

// `[Closure-Form-Borrow]`/`[Closure-Form-Move]`: the capture struct, then the
// body as a C function taking `self`.
export fn lower_closure(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    bool is_move,
    ref<Vec<String>, shared> captures,
    ref<Vec<ParamDecl>, shared> params,
    Option<ref<Type, shared>> declared,
    ref<Block, shared> body,
    usize line,
) : V
{
    u64 id = closure_id(g);
    Vec<CapField> fields = Vec::new();
    Vec<V> inits = Vec::new();
    foreach (c in captures)
    {
        Binding b = Option::expect(lookup(x, c), "cobc: unbound capture");
        Type vty = binding_place_ty(&b);
        Expr path = synth(
            g,
            ExprKind::EPath(Box::new(PathExpr { .segs = vec_of(String::clone(c)), .targs = Vec::new() })),
            line,
            0,
        );
        if (is_move)
        {
            // D-0315 (step 4): an objectless local moves in with none.
            x.raw_return_path = g.decided;
            V v0 = lower_expr(g, x, &path, None);
            x.raw_return_path = false;
            Vec::push(&mut inits, into_temp(g, x, v0, line));
            Vec::push(&mut fields, CapField { .name = String::clone(c), .ty = vty });
        }
        else
        {
            Mode mode = if (body_writes(body, c)) { Mode::Exclusive } else { Mode::Shared };
            Expr bexpr = synth(g, ExprKind::EBorrow(Box::new(BorrowExpr { .mode = mode, .e = path })), line, 0);
            V v0 = lower_expr(g, x, &bexpr, None);
            Vec::push(&mut inits, into_temp(g, x, v0, line));
            Vec::push(&mut fields, CapField { .name = String::clone(c), .ty = ref_ty(vty, mode) });
        }
    }
    Vec<Type> ptypes = Vec::new();
    foreach (pd in params)
    {
        Vec::push(&mut ptypes, apply(&pd.ty, &x.subst));
    }
    String cname = sprintf("cl_%v", id);
    bool writes_self = false;
    if (is_move)
    {
        foreach (c in captures)
        {
            writes_self = writes_self || body_writes(body, c);
        }
    }
    HashMap::insert(
        &mut g.closures,
        id,
        ClosureInfo { .fields = clone(&fields), .is_move = is_move, .params = ptypes, .ret = Type::TVoid, .cname = String::clone(&cname), .writes_self = writes_self },
    );
    Type ty = Type::TClosure(id);
    String c = ctype(g, &ty);
    String t = fresh(g, "cl");
    emit(x, &sprintf("%s %s;", &c, &t));
    for (usize i = 0; i < Vec::len(&inits); i += 1)
    {
        Type fty = clone(&fields[i].ty);
        store(g, x, &sprintf("%s.f%v", &t, i), &fty, &inits[i]);
        // (A value moved in with no object is the closure's own.)
        if (is_resource(g, &fty) && !(Option::is_none(&inits[i].obj) && HashSet::contains(&x.inert_c, &inits[i].c)))
        {
            String o = Option::expect(clone(&inits[i].obj), "resource capture has object");
            emit(x, &sprintf("cb_absorb(%s);", &o));
        }
    }
    // Always an object: a call borrows it exclusively.
    u32 tid = type_id(g, &ty);
    String lc = loc(g, x.std_body, line);
    String o = fresh(g, "o");
    emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &t, tid, &lc));
    // D-0200: a closure capturing nothing whose reference parameters are
    // all shared and only read through or lent to readers, the rest plain
    // data: lowered as a predicate (`pending_pred_closure`), its parameters
    // bare addresses. A closure capturing by reference only what it never
    // writes qualifies too.
    bool read_captures = Vec::len(captures) == 0;
    if (!read_captures && !is_move)
    {
        read_captures = true;
        foreach (c in captures)
        {
            read_captures = read_captures && !body_writes(body, c);
        }
    }
    if (read_captures && !g.pending_pred_closure && !boot(g, 10))
    {
        CalleeTest reads = CalleeTest::ClosureReads(bound_names(body));
        bool read_only = Vec::len(params) > 0;
        foreach (pd in params)
        {
            if (!read_only)
            {
                break;
            }
            Type pt = apply(&pd.ty, &x.subst);
            read_only = match (&pt)
            {
                Type::TRef(m) :
                {
                    if (Box::get(m).mode == Mode::Shared)
                    {
                        reader_uses(g, body, &pd.name, false, &reads)
                    }
                    else { plain_data(g, &pt) && !has_refs(g, &pt) && !holds_fn(g, &pt) }
                },
                _             : plain_data(g, &pt) && !has_refs(g, &pt) && !holds_fn(g, &pt),
            };
        }
        if (read_only)
        {
            g.pending_pred_closure = true;
            g.pending_reader_closure = true;
        }
    }
    Type ret = lower_closure_body(g, x, id, params, declared, body);
    match (HashMap::get_mut(&mut g.closures, id))
    {
        Some(ci) : ci.ret = ret,
        None     : {},
    }
    V { .c = t, .ty = ty, .obj = Some(o) }
}

// The body as `ret cl_N(cb_ref p_self, params...)`, with each captured name
// resolving to `*self.f_i` or `self.f_i` ([Closure-Call]). A first pass
// learns the result type unless one is written (D-0081).
export fn lower_closure_body(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> outer,
    u64 id,
    ref<Vec<ParamDecl>, shared> params,
    Option<ref<Type, shared>> declared,
    ref<Block, shared> body,
) : Type
{
    ClosureInfo info = clone(Option::expect(HashMap::get(&g.closures, id), "a lowered closure"));
    bool pred = replace(&mut g.pending_pred_closure, false);
    bool reader_closure = replace(&mut g.pending_reader_closure, false);
    Type self_ty = ref_ty(Type::TClosure(id), Mode::Exclusive);
    Type ret = match (declared)
    {
        Some(t) : apply(t, &outer.subst),
        None    : Type::TVoid,
    };
    usize first = if (Option::is_some(&declared)) { 1 } else { 0 };
    for (usize pass = first; pass < 2; pass += 1)
    {
        bool probing = pass == 0;
        // A closure's own parameters and its captures are its bindings.
        HashSet<String> cl_bound = bound_names(body);
        foreach (p in params)
        {
            HashSet::insert(&mut cl_bound, String::clone(&p.name));
        }
        foreach (c in &info.fields)
        {
            HashSet::insert(&mut cl_bound, String::clone(&c.name));
        }
        u64 saved_uid = g.uid;
        // Only a probing pass is undone.
        Option<NameSnap> saved_names = if (probing) { Some(snapshot_names(outer)) } else { None };
        u64 saved_nstr = g.nstr;
        StrMark saved_strs = str_mark(g);
        Fx fx = Fx {
            .std_body = outer.std_body,
            .pc_site = None,
            .tracked = outer.tracked,
            .objectless_fields = HashMap::new(),
            .inert_result = None,
            .inert_now = None,
            .out = String::new(),
            .ind = 1,
            .cleanup = Vec::new(),
            .scopes = Vec::new(),
            .ret = clone(&ret),
            .notes = 0,
            .stmt_ind = HashMap::new(),
            .tl = 0,
            .root_frame = 0,
            .pinned = resolve_pinned(g, pinned_names(body), &cl_bound, &HashSet::new(), false),
            .pinned_ws = resolve_pinned(g, pinned_names(body), &cl_bound, &HashSet::new(), false),
            .assigned = assigned_names(body),
            .self_ref = Some(SelfRef { .c = "p_self", .id = id }),
            .probes = HashMap::new(),
            .probing = outer.probing + if (probing) { 1 } else { 0 },
            .probe_failed = false,
            .frame_line = None,
            .loops = Vec::new(),
            .loop_broken = Vec::new(),
            .rebind_frames = HashMap::new(),
            .obj_temps = HashSet::new(),
            .unstored = HashMap::new(),
            .holder_roots = HashMap::new(),
            .subst = clone(&outer.subst),
            .dollar = Vec::new(),
            .vec_index_exprs = HashMap::new(),
            .index_sugar = HashSet::new(),
            .place_write = false,
            .temp_root = false,
            .propagate_scrutinee = false,
            .stmt_match = false,
            .branch_scope = false,
            .fn_name = String::clone(&outer.fn_name),
            .direct_params = HashSet::new(),
            .direct_refs = HashSet::new(),
            .direct_live = HashMap::new(),
            .pred_body = false,
            .unstored_params = HashSet::new(),
            .confined_params = HashMap::new(),
            .confined = HashSet::new(),
            .hoisted = HashMap::new(),
            .versions = Vec::new(),
            .guard_depth = 0,
            .const_locals = HashMap::new(),
            .mask_params = HashSet::new(),
            .self_tail_now = false,
            .tail_targets = Vec::new(),
            .tail_used = false,
            .unminted_binders = HashMap::new(),
            .inert_c = HashSet::new(),
            .names_undo = Vec::new(),
            .name_marks = 0,
            .raw_substring = None,
            .raw_call = None,
            .drop_lines = Vec::new(),
            .confined_names = HashSet::new(),
            .objectless_names = empty_objectless(),
            .elem_ref_ids = HashSet::new(),
            .quiet_ids = HashSet::new(),
            .held_locals = HashSet::new(),
            .callee_only = HashSet::new(),
            .notes_always = false,
            .notes_bottom = false,
            .s1_let = None,
            .s1_now = false,
            .pending_sub = false,
            .sub_frames = HashSet::new(),
            .pure_views = HashSet::new(),
            .objectless_c = HashSet::new(),
            .moved_flag = HashMap::new(),
            .cur_let = None,
            .held_c = HashSet::new(),
            .quiet_roots = HashSet::new(),
            .raw_ret = false,
            .raw_sinks = HashSet::new(),
            .raw_tail = None,
            .raw_arm = None,
            .raw_arm_last = false,
            .raw_arm_noted = false,
            .noted_pending = HashMap::new(),
            .stack_box = false,
            .stack_box_at = None,
            .raw_return_path = false,
            .objectless = false,
            .lit_inert = false,
            .bare_trims = HashSet::new(),
            .map_acc = None,
            .map_acc_used = false,
            .compound_elem = false,
            .elem_alias = HashMap::new(),
            .map_get_acc = None,
            .map_get_acc_out = None,
            .datum_tok = None,
            .datum_tok_out = None,
            .elem_mode = None,
            .elem_reader = false,
            .no_overflow = HashSet::new(),
            .proven_next = false,
            .fast_half = false,
            .entry_tested = false,
            .frozen_on = false,
            .field_confined = HashMap::new(),
            .pure_slices = HashSet::new(),
            .confined_fields = HashSet::new(),
            .read_confined = HashSet::new(),
        };
        Vec::push(&mut fx.scopes, HashMap::new());
        push_frame_fn(g, &mut fx, fx.tracked);
        fx.root_frame = g.nscope;
        // A closure that captures nothing never reaches `self`: it is bound
        // as a bare address, and its own parameters may be direct as a
        // function's are.
        CalleeTest never = CalleeTest::Never;
        if (boot(g, 10))
        {
            // D-0274: nothing direct in the bootstrap form.
        }
        else if (Vec::len(&info.fields) > 0 && !pred)
        {
            // D-0192: a capturing closure's parameter is direct only if never
            // handed on at all; `self` is bound as its address unless the
            // closure moves its captures in.
            HashSet<String> d = direct_refs_of(g, params, body, &outer.subst);
            foreach (n in &d)
            {
                if (direct_uses(g, body, n, &never))
                {
                    HashSet::insert(&mut fx.direct_params, String::clone(n));
                }
            }
            if (!info.is_move)
            {
                HashSet::insert(&mut fx.direct_params, "self");
            }
        }
        if (!boot(g, 10) && (Vec::len(&info.fields) == 0 || pred))
        {
            fx.direct_params = direct_refs_of(g, params, body, &outer.subst);
            fx.pred_body = pred;
            if (pred)
            {
                // A predicate: every reference parameter used only directly,
                // or only read.
                foreach (pd in params)
                {
                    if (is_ref_type(&apply(&pd.ty, &outer.subst)))
                    {
                        HashSet::insert(&mut fx.direct_params, String::clone(&pd.name));
                    }
                }
            }
            HashSet::insert(&mut fx.direct_params, "self");
        }
        if (!probing && !boot(g, 10))
        {
            // Pure: every reference parameter direct and never handed on,
            // none a slice (which travels in flight), the result plain.
            bool all_direct = true;
            foreach (pd in params)
            {
                Type pt = apply(&pd.ty, &outer.subst);
                bool ok = match (&pt)
                {
                    Type::TRef(_) : HashSet::contains(
                        &fx.direct_params,
                        &pd.name,
                    ) && (reader_closure || direct_uses(g, body, &pd.name, &never)),
                    Type::TSlice(_) : false,
                    _               : plain_data(g, &pt) && !has_refs(g, &pt) && !holds_fn(g, &pt),
                };
                if (!ok)
                {
                    all_direct = false;
                    break;
                }
            }
            if (all_direct)
            {
                HashSet::insert(&mut g.pure_closures, id);
            }
        }
        // D-0315 (step 4): `self` is never written, borrowed or captured by the
        // body: unstored (no object) in a decided program.
        if (g.decided)
        {
            HashSet::insert(&mut fx.unstored_params, "self");
        }
        bind_param(g, &mut fx, &ParamDecl { .ty = clone(&self_ty), .name = "self" }, &outer.subst, 0);
        for (usize pi = 0; pi < Vec::len(params); pi += 1)
        {
            bind_param(g, &mut fx, &params[pi], &outer.subst, pi + 1);
        }
        // D-0315 (step 4): a resource result leaves as a function's does.
        if (!probing && g.decided && is_resource(g, &ret))
        {
            fx.raw_ret = true;
        }
        for (usize i = 0; i < Vec::len(&info.fields); i += 1)
        {
            BindKind kind = if (info.is_move) { BindKind::CaptureVal(i) } else { BindKind::CaptureRef(i) };
            bind_in_scope(
                &mut fx,
                &info.fields[i].name,
                Binding { .c = String::new(), .ty = clone(&info.fields[i].ty), .root = String::new(), .kind = kind },
            );
        }
        V v = if (probing)
        {
            lower_block_body(
                g,
                &mut fx,
                body,
                None,
                None,
            )
        }
        else { lower_block_body(g, &mut fx, body, Some(&ret), None) };
        if (probing)
        {
            ret = if (is_never(&v.ty)) { Type::TVoid } else { clone(&v.ty) };
            g.uid = saved_uid;
            match (saved_names)
            {
                Some(n) : restore_names(outer, n),
                None    : {},
            }
            g.nstr = saved_nstr;
            str_restore(g, saved_strs);
            continue;
        }
        if (is_never(&v.ty))
        {
            emit(&mut fx, "__builtin_unreachable();");
        }
        else
        {
            emit_return(g, &mut fx, v);
        }
        while (Vec::len(&fx.cleanup) > 0)
        {
            end_diverged(&mut fx);
        }
        String prologue = notes_finish(&mut fx);
        // D-0274: in the bootstrap form no text pass elides anything.
        String out = if (boot(g, 1))
        {
            resolve_scopes(&fx.out)
        }
        else
        {
            text_passes(g, &fx.out, None)
        };
        if (outer.probing == 0)
        {
            String ret_c = reg_ctype(g, &ret);
            Vec<String> params_c = Vec::new();
            Vec::push(&mut params_c, "cb_ref p_self");
            String entry = String::new();
            String exit = String::new();
            foreach (pd in params)
            {
                Type pty = apply(&pd.ty, &outer.subst);
                String pc = param_ctype(g, &pty);
                String pn = sprintf("p_%s", &san(&pd.name));
                Vec::push(&mut params_c, sprintf("%s %s", &pc, &pn));
                // D-0255: over-aligned parameters copied at entry.
                if (size_align(g, &pty).align > 16)
                {
                    String ct = param_ctype(g, &pty);
                    String::appendf(&mut entry, "    %s %s__al = %s;\n#define %s %s__al\n", &ct, &pn, &pn, &pn, &pn);
                    String::appendf(&mut exit, "#undef %s\n", &pn);
                }
            }
            String sig = sprintf("%s %s(%s)", &ret_c, &info.cname, &String::join(&params_c, ", "));
            String::appendf(&mut g.protos, "%s;\n", &sig);
            // D-0077, as for a function: a body that calls nothing, its prologue
            // included, cannot go deeper; its caller's check covers its frame.
            str check = if (!boot(g, 1) && calls_nothing(&prologue) && calls_nothing(&out)) { "" } else { "    cb_stack_check();\n" };
            String::appendf(&mut g.fns, "%s\n{\n%s%s%s%s%s}\n\n", &sig, &entry, check, &prologue, &out, &exit);
        }
    }
    ret
}

// A call through a `fn` value's handle.
export fn call_fn_value(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    String hc,
    ref<Type, shared> fty,
    ref<Vec<Expr>, shared> args,
    usize line,
) : V
{
    ref<FnTy, shared> ft = match (fty)
    {
        Type::TFn(f) : Box::get(f),
        _            :
        {
            assert(false, "cobc: call through a non-fn value");
            return unit();
        },
    };
    String th = thunk(g, fty);
    Option<Vec<String>> names = lower_args(g, x, &ft.params, args);
    match (names)
    {
        Some(ns) :
        {
            String call = sprintf("%s(%s", &th, &hc);
            foreach (n in &ns)
            {
                String::appendf(&mut call, ", %s", n);
            }
            String::append(&mut call, ")");
            finish_call(g, x, call, clone(&ft.ret), line)
        },
        None     : never(),
    }
}

// The call thunk of a `fn` type: through the handle to the item, or to the
// closure with its `self`.
export fn thunk(ref<Gen, exclusive> g, ref<Type, shared> fty) : String
{
    String key = type_code(fty);
    match (HashMap::get(&g.thunks, &key))
    {
        Some(n) : return String::clone(n),
        None    : {},
    }
    ref<FnTy, shared> ft = match (fty)
    {
        Type::TFn(f) : Box::get(f),
        _            :
        {
            assert(false, "cobc: thunk for a non-fn type");
            return String::new();
        },
    };
    String name = sprintf("cb_call_%s", &mangle(fty));
    String rc = reg_ctype(g, &ft.ret);
    Vec<String> params = Vec::new();
    Vec::push(&mut params, "void *h");
    Vec<String> avs = Vec::new();
    Vec<String> ptypes = Vec::new();
    for (usize i = 0; i < Vec::len(&ft.params); i += 1)
    {
        String pc = reg_ctype(g, &ft.params[i]);
        Vec::push(&mut params, sprintf("%s a%v", &pc, i));
        Vec::push(&mut avs, sprintf("a%v", i));
        Vec::push(&mut ptypes, pc);
    }
    bool void_ret = rc == "void";
    str ret = if (void_ret) { "" } else { "return " };
    String item_sig = if (Vec::len(&ptypes) == 0) { "void" } else
    {
        String::join(
            &ptypes,
            ", ",
        )
    };
    Vec<String> csig = Vec::new();
    Vec::push(&mut csig, "cb_ref");
    Vec<String> cargs = Vec::new();
    Vec::push(&mut cargs, "self");
    Vec<String> inner = Vec::new();
    Vec::push(&mut inner, "h");
    for (usize i = 0; i < Vec::len(&ptypes); i += 1)
    {
        Vec::push(&mut csig, String::clone(&ptypes[i]));
        Vec::push(&mut cargs, String::clone(&avs[i]));
        Vec::push(&mut inner, String::clone(&avs[i]));
    }
    String closure_sig = String::join(&csig, ", ");
    String closure_args = String::join(&cargs, ", ");
    String keep = if (void_ret) { String::new() } else { sprintf("%s r = ", &rc) };
    str give = if (void_ret) { "return;" } else { "return r;" };
    str ret2 = if (void_ret) { "else " } else { "return " };
    String pl = String::join(&params, ", ");
    String generic = sprintf(
        "static %s %s__i(%s)\n{\n    if (!h) cb_fn_moved();\n    const cb_fnbox *b = (const cb_fnbox *)h;\n    if (b->closure == 2u) {\n        cb_ref self = { b->data, 0 };\n        %s((%s (*)(%s))b->code)(%s);\n    }\n    else if (b->closure) {\n        cb_ref self = { b->data, cb_call_self(b->root) };\n        %s((%s (*)(%s))b->code)(%s);\n        cb_call_done(self.tok);\n        %s\n    }\n    %s((%s (*)(%s))b->code)(%s);\n}",
        &rc,
        &name,
        &pl,
        ret,
        &rc,
        &closure_sig,
        &closure_args,
        &keep,
        &rc,
        &closure_sig,
        &closure_args,
        give,
        ret2,
        &rc,
        &item_sig,
        &String::join(&avs, ", "),
    );
    String::appendf(&mut g.thunks_out, "%s\n", &generic);
    String::appendf(
        &mut g.thunks_out,
        "%s %s(%s)\n{\n    uint32_t wf, wl;\n    cb_where(&wf, &wl);\n    %s%s__i(%s);\n    cb_set_where(wf, wl);\n    %s\n}\n",
        &rc,
        &name,
        &pl,
        &keep,
        &name,
        &String::join(&inner, ", "),
        give,
    );
    Vec::push(
        &mut g.thunk_specs,
        ThunkSpec {
            .name = String::clone(&name),
            .key = fn_target_key(fty),
            .rc = String::clone(&rc),
            .pl = pl,
            .closure_sig = closure_sig,
            .closure_args = closure_args,
            .item_sig = item_sig,
            .item_args = String::join(&avs, ", "),
            .keep = keep,
            .give = String::copy(give),
            .ret = String::copy(ret),
            .generic = generic,
        },
    );
    HashMap::insert(&mut g.thunks, key, String::clone(&name));
    name
}

// CHG-0436 (cobc's `fn_sig_key`): the key of a `fn` type's targets, its
// thunk's name. `fn` types are nominal, with no conversion between two of
// them (D-0006), so a box made for one type is only ever called through
// that type's thunk.
fn fn_target_key(ref<Type, shared> fty) : String
{
    sprintf("cb_call_%s", &mangle(fty))
}

// CHG-0436 (cobc's `note_fn_target`): a box of `fty` may hold `code`, of
// `kind`.
export fn note_fn_target(ref<Gen, exclusive> g, ref<Type, shared> fty, ref<String, shared> code, u32 kind)
{
    String k = fn_target_key(fty);
    if (!HashMap::contains(&g.fn_targets, &k))
    {
        HashMap::insert(&mut g.fn_targets, String::clone(&k), Vec::new());
    }
    ref<Vec<FnTarget>, exclusive> ts = Option::unwrap(HashMap::get_mut(&mut g.fn_targets, &k));
    foreach (t in &*ts)
    {
        if (t.code == *code && t.kind == kind)
        {
            return;
        }
    }
    Vec::push(ts, FnTarget { .code = String::clone(code), .kind = kind });
}

// CHG-0436 (cobc's `single_target_thunks`): each thunk whose `fn` type has
// exactly one target code (every box the program makes: `box_closure`'s three
// forms and a fn item's handle) calls that code, through the same cast, with
// the self argument its kind gives; the null test and the location kept
// around the call stay.
fn single_target_thunks(ref<Gen, shared> g, ref<String, shared> text) : String
{
    String out = String::clone(text);
    foreach (t in &g.thunk_specs)
    {
        Option<ref<Vec<FnTarget>, shared>> ts = HashMap::get(&g.fn_targets, &t.key);
        if (Option::is_none(&ts))
        {
            continue;
        }
        ref<Vec<FnTarget>, shared> one = Option::unwrap(ts);
        if (Vec::len(one) != 1)
        {
            continue;
        }
        ref<String, shared> code = &one[0].code;
        u32 kind = one[0].kind;
        String body = if (kind == 0)
        {
            sprintf(
                "static %s %s__i(%s)\n{\n    if (!h) cb_fn_moved();\n    %s((%s (*)(%s))%s)(%s);\n}",
                &t.rc,
                &t.name,
                &t.pl,
                &t.ret,
                &t.rc,
                &t.item_sig,
                code,
                &t.item_args,
            )
        }
        else if (kind == 2)
        {
            sprintf(
                "static %s %s__i(%s)\n{\n    if (!h) cb_fn_moved();\n    const cb_fnbox *b = (const cb_fnbox *)h;\n    cb_ref self = { b->data, 0 };\n    %s((%s (*)(%s))%s)(%s);\n}",
                &t.rc,
                &t.name,
                &t.pl,
                &t.ret,
                &t.rc,
                &t.closure_sig,
                code,
                &t.closure_args,
            )
        }
        else
        {
            sprintf(
                "static %s %s__i(%s)\n{\n    if (!h) cb_fn_moved();\n    const cb_fnbox *b = (const cb_fnbox *)h;\n    cb_ref self = { b->data, cb_call_self(b->root) };\n    %s((%s (*)(%s))%s)(%s);\n    cb_call_done(self.tok);\n    %s\n}",
                &t.rc,
                &t.name,
                &t.pl,
                &t.keep,
                &t.rc,
                &t.closure_sig,
                code,
                &t.closure_args,
                &t.give,
            )
        };
        out = StringView::replace(&out, &t.generic, &body);
    }
    out
}

// `[T-Item]`: a fn item as a value -- an interned callable box. A generic
// item is instantiated from its explicit type arguments, else from the
// expected `fn` type.
export fn lower_fn_item(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> name,
    ref<FnDecl, shared> f,
    ref<Vec<Type>, shared> targs,
    Option<ref<Type, shared>> expected,
) : V
{
    HashMap<String, Type> m = HashMap::new();
    for (usize i = 0; i < Vec::len(&f.type_params) && i < Vec::len(targs); i += 1)
    {
        HashMap::insert(&mut m, String::clone(&f.type_params[i]), apply(&targs[i], &x.subst));
    }
    match (expected)
    {
        Some(t) : match (t)
        {
            Type::TFn(ft) :
            {
                for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(&Box::get(ft).params); i += 1)
                {
                    unify(&f.params[i].ty, &Box::get(ft).params[i], &f.type_params, &mut m);
                }
                unify(&f.ret, &Box::get(ft).ret, &f.type_params, &mut m);
            },
            _             : {},
        },
        None : {},
    }
    Vec<Type> inst = Vec::new();
    foreach (tp in &f.type_params)
    {
        match (HashMap::get(&m, tp))
        {
            Some(t) : Vec::push(&mut inst, clone(t)),
            None    :
            {
                eprintf("cobc: cannot infer type arguments of `%s` as a value here\n", name);
                assert(false, "cobc: cannot infer type arguments");
            },
        }
    }
    String cname = request_fn(g, name, clone(&inst));
    HashMap<String, Type> fsub = subst_of(&f.type_params, &inst);
    Vec<Type> ps = Vec::new();
    bool pure = true;
    for (usize j = 0; j < Vec::len(&f.params); j += 1)
    {
        Type pt = apply(&apply(&f.params[j].ty, &fsub), &x.subst);
        // D-0191: a function whose reference parameters are all pure direct
        // (and with no slice, which travels in flight) keeps nothing of its
        // arguments: its handle says so (`cb_fn_pure`). D-0200: or a reader,
        // which a bare address serves as well.
        if (pure)
        {
            pure = match (&pt)
            {
                Type::TRef(m)   :
                {
                    if (Box::get(m).mode == Mode::Shared && reader_param(g, name, j))
                    {
                        true
                    }
                    else { pure_direct(g, name, j) }
                },
                Type::TSlice(_) : false,
                _               : plain_data(g, &pt) && !has_refs(g, &pt) && !holds_fn(g, &pt),
            };
        }
        Vec::push(&mut ps, pt);
    }
    Type fty = Type::TFn(Box::new(FnTy { .params = ps, .ret = apply(&apply(&f.ret, &fsub), &x.subst) }));
    str mk = if (pure) { "cb_fn_item_pure" } else { "cb_fn_item" };
    note_fn_target(g, &fty, &cname, 0);
    V { .c = sprintf("%s((void *)%s)", mk, &cname), .ty = fty, .obj = None }
}

export fn lower_call(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> callee,
    ref<Vec<Expr>, shared> args,
    Option<ref<Type, shared>> expected,
    usize line,
) : V
{
    ref<PathExpr, shared> path = match (&callee.kind)
    {
        ExprKind::EPath(p) : Box::get(p),
        _                  : return lower_call_value(g, x, callee, args, line),
    };
    if (Vec::len(&path.segs) == 1 && is_bound(x, &path.segs[0]))
    {
        // The place's type, not the binding's.
        P p = lower_place(g, x, callee);
        match (&p.ty)
        {
            Type::TFn(_)       : return call_fn_place(g, x, &p, args, line, false, callee),
            Type::TClosure(id) : return call_closure_place(g, x, *id, &p, args, line),
            _                  :
            {
                assert(false, "cobc: call of a non-callable binding");
                return unit();
            },
        }
    }
    String name = String::join(&path.segs, "::");
    match (variant_of(g, &path.segs))
    {
        Some(vr) :
        {
            if (!HashMap::contains(&g.prog.table.fns, &name) && Vec::len(args) == 1)
            {
                // D-0315: armed by its consumer (`arm_inert`).
                bool armed = g.decided && x.probing == 0 && match (&x.inert_result)
                {
                    Some(ir) : ir.key == args_key(args),
                    None     : false,
                };
                if (armed)
                {
                    x.inert_result = None;
                    x.lit_inert = true;
                }
                return construct_variant(g, x, &vr.ename, vr.vi, &path.targs, Some(&args[0]), expected, line);
            }
        },
        None     : {},
    }
    match (get_fn(g, &name))
    {
        Some(f) :
        {
            // D-0283: the call's site, for its point checks.
            x.pc_site = Some(site_key(callee.line, callee.col));
            V v = lower_user_call(g, x, &name, &f, &path.targs, args, expected, line);
            give_fn(g, &name, f);
            return v;
        },
        None    : {},
    }
    if (HashMap::contains(&g.prog.table.externs, &name))
    {
        return lower_std_extern(g, x, &name, args, line);
    }
    lower_intrinsic(g, x, &name, &path.targs, args, expected, line)
}

export fn is_bare_num_literal(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EInt(l)   :
        {
            match (&Box::get(l).sfx)
            {
                Some(s) : *s == "byte",
                None    : true,
            }
        },
        ExprKind::EFloat(f) : Option::is_none(&Box::get(f).sfx),
        ExprKind::EUnary(u) : Box::get(u).op == UnOp::Neg && is_bare_num_literal(&Box::get(u).e),
        ExprKind::EParen(i) : is_bare_num_literal(Box::get(i)),
        _                   : false,
    }
}

// An argument whose type can be read by probing it before its turn: a name,
// or a field, element or borrow of one.
export fn probe_safe(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EPath(_)   : true,
        ExprKind::EParen(i)  : probe_safe(Box::get(i)),
        ExprKind::EField(f)  : probe_safe(&Box::get(f).e),
        ExprKind::EBorrow(b) : probe_safe(&Box::get(b).e),
        ExprKind::EDeref(i)  : probe_safe(Box::get(i)),
        ExprKind::EIndex(p)  :
        {
            probe_safe(&Box::get(p).a) && match (&Box::get(p).b.kind)
            {
                ExprKind::EPath(_) : true,
                _                  : false,
            }
        },
        _                    : false,
    }
}

// The enum and variant index a path names, as `Fx::variant_of` finds them.
export struct VariantRef
{
    export String ename;
    export usize vi;
}

export fn variant_of(ref<Gen, shared> g, ref<Vec<String>, shared> segs) : Option<VariantRef>
{
    usize n = Vec::len(segs);
    ref<String, shared> vname = &segs[n - 1];
    Option<String> ename = None;
    if (n >= 2)
    {
        String prefix = String::join(&segs[0 .. n - 1], "::");
        if (HashMap::contains(&g.prog.table.enums, &prefix))
        {
            ename = Some(prefix);
        }
        else
        {
            String key = sprintf("%s\u{1}%s", &prefix, vname);
            match (HashMap::get(&g.prog.table.module_variant, &key))
            {
                Some(e) : ename = clone(e),
                None    : {},
            }
        }
    }
    String en = match (ename)
    {
        Some(e) : e,
        None    :
        {
            match (HashMap::get(&g.prog.table.enum_of_variant, vname))
            {
                Some(e) : String::clone(e),
                None    : return None,
            }
        },
    };
    ref<EnumDecl, shared> ed = match (HashMap::get(&g.prog.table.enums, &en))
    {
        Some(d) : d,
        None    : return None,
    };
    for (usize k = 0; k < Vec::len(&ed.variants); k += 1)
    {
        if (ed.variants[k].name == *vname)
        {
            return Some(VariantRef { .ename = en, .vi = k });
        }
    }
    None
}

export fn is_bare_variant(ref<Gen, shared> g, ref<Fx, shared> x, ref<Expr, shared> a) : bool
{
    match (&a.kind)
    {
        ExprKind::EPath(p) :
        {
            if (Vec::len(&Box::get(p).targs) > 0 || is_bound(x, &Box::get(p).segs[0]))
            {
                return false;
            }
            if (Option::is_some(&variant_of(g, &Box::get(p).segs)))
            {
                return true;
            }
            match (HashMap::get(&g.prog.table.fns, &String::join(&Box::get(p).segs, "::")))
            {
                Some(f) : Vec::len(&f.type_params) > 0,
                None    : false,
            }
        },
        _                  : false,
    }
}

export fn count_of(ref<Vec<usize>, shared> v, usize j) : usize
{
    usize n = 0;
    foreach (k in v)
    {
        if (*k == j)
        {
            n += 1;
        }
    }
    n
}

export fn put_arg(ref<Vec<V>, exclusive> argv, usize j, V v)
{
    if (j < Vec::len(argv))
    {
        argv[j] = v;
    }
    else
    {
        Vec::push(argv, v);
    }
}

export fn lower_user_call_access(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    StringView name,
    ref<FnDecl, shared> f,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    Option<ref<Type, shared>> expected,
    usize line,
    Option<bool> access
) : V
{
    // D-0283: the call's site, for its point checks (`emit_point_checks`).
    Option<String> site = replace(&mut x.pc_site, None);
    // D-0315: this call's arming (`arm_inert`), as its consumer left it.
    Option<bool> armed = match (&x.inert_result)
    {
        Some(ir) : if (ir.key == args_key(args)) { Some(ir.last) } else { None },
        None     : None,
    };
    bool prelude = in_prelude(name, f);
    // D-0317: a callee with a `requires` block reads the position too: its
    // requirement's fault is this call's.
    bool reads_at = prelude || Vec::len(&f.requires) > 0;
    if (reads_at)
    {
        at(g, x, line);
    }
    // D-0274: in the bootstrap form every call takes the general path, but
    // `e[k]`, whose check is element k's (`lower_vec_index_pre`).
    if (boot(g, 3))
    {
        match (lower_vec_index_pre(g, x, name, f, args, line, access))
        {
            Some(v) : return v,
            None    : {},
        }
    }
    else
    {
        match (lower_call_shortcut(g, x, name, f, targs, args, expected, line, access))
        {
            Some(v) : return v,
            None    : {},
        }
    }
    // Confined vectors passed to confining parameters (`confining_table`):
    // the call goes to the variant compiled for them, and each is passed as
    // its address and path, with no borrow formed.
    Vec<bool> conf = confining_row(g, name);
    u64 mask = 0;
    u64 fresh_m = 0;
    u64 one = 1;
    for (usize j = 0; j < Vec::len(args) && j < 64; j += 1)
    {
        bool cj = j < Vec::len(&conf) && conf[j];
        if (cj && Option::is_some(&confined_local(x, &args[j])))
        {
            mask = mask | (one << narrow<u32>(j));
        }
        else if (cj && is_shared_ref(&f.params[j].ty) && fresh_shared_vec_arg(g, x, &args[j], j, args))
        {
            mask = mask | (one << narrow<u32>(j));
            fresh_m = fresh_m | (one << narrow<u32>(j));
        }
    }
    HashMap<String, Type> m = HashMap::new();
    for (usize k = 0; k < Vec::len(&f.type_params) && k < Vec::len(targs); k += 1)
    {
        HashMap::insert(&mut m, String::clone(&f.type_params[k]), apply(&targs[k], &x.subst));
    }
    match (expected)
    {
        Some(exp) : unify(&f.ret, exp, &f.type_params, &mut m),
        None      : {},
    }
    Vec<V> argv = Vec::new();
    // D-0222: `HashMap::get_mut(&mut x, k)`, `x` a local checked exclusively
    // here: its body's own exclusive check repeats this one (the `_x`
    // variants).
    bool map_excl_checked = false;
    Vec<String> weakened = Vec::new();
    // D-0079: an unsuffixed literal whose parameter type is not yet known is
    // lowered after the other arguments, at the type they fixed.
    Vec<usize> deferred = Vec::new();
    Vec<usize> order = Vec::new();
    usize np = if (Vec::len(&f.params) < Vec::len(args)) { Vec::len(&f.params) } else { Vec::len(args) };
    for (usize k = 0; k < np; k += 1)
    {
        Vec::push(&mut order, k);
    }
    usize k = 0;
    while (k < Vec::len(&order))
    {
        usize j = order[k];
        k += 1;
        ref<ParamDecl, shared> p = &f.params[j];
        ref<Expr, shared> a = &args[j];
        bool in_mask = ((mask >> narrow<u32>(j)) & 1) != 0;
        if (!Vec::contains(
            &deferred,
            j,
        ) && is_bare_num_literal(a) && !resolved(&apply(&p.ty, &m), &f.type_params) && !in_mask)
        {
            Vec::push(&mut deferred, j);
            Vec::push(&mut order, j);
            Vec::push(&mut argv, V { .c = String::new(), .ty = Type::TVoid, .obj = None });
            continue;
        }
        // A payload-less variant (`None`) fixes no type parameter either:
        // it waits for the other arguments, deferred literals included.
        if (is_bare_variant(
            g,
            x,
            a,
        ) && !resolved(&apply(&p.ty, &m), &f.type_params) && !in_mask && count_of(&deferred, j) < 2)
        {
            bool first = !Vec::contains(&deferred, j);
            Vec::push(&mut deferred, j);
            Vec::push(&mut order, j);
            if (first)
            {
                Vec::push(&mut argv, V { .c = String::new(), .ty = Type::TVoid, .obj = None });
            }
            continue;
        }
        // A shared borrow formed here (`fresh_shared_vec_arg`): its path,
        // checked as it is formed, is the parameter's.
        if (((fresh_m >> narrow<u32>(j)) & 1) != 0)
        {
            V fv = lower_expr(g, x, a, None);
            if (is_never(&fv.ty))
            {
                return never();
            }
            unify(&p.ty, &fv.ty, &f.type_params, &mut m);
            put_arg(&mut argv, j, fv);
            continue;
        }
        if (in_mask)
        {
            ConfinedVec cv = Option::expect(confined_local(x, a), "confined argument");
            Mode cm = match (&p.ty)
            {
                Type::TRef(r) : Box::get(r).mode,
                _             :
                {
                    assert(false, "cobc: confining parameter of a non-reference type");
                    Mode::Shared
                },
            };
            Type vt = Type::TNamed(Box::new(NamedTy { .name = "std::Vec", .args = one_type(clone(&cv.elem)) }));
            Type cty = ref_ty(vt, cm);
            unify(&p.ty, &cty, &f.type_params, &mut m);
            put_arg(
                &mut argv,
                j,
                V { .c = sprintf("((cb_ref){ (void *)&(%s), %s })", &cv.c, &cv.path), .ty = cty, .obj = None },
            );
            continue;
        }
        Type hint = apply(&p.ty, &m);
        // A type parameter this argument cannot fix by itself: the later
        // arguments' types fix it first. They are probed, not lowered.
        if (!resolved(&hint, &f.type_params) && !is_bare_num_literal(a))
        {
            for (usize l = j + 1; l < np; l += 1)
            {
                if (!probe_safe(&args[l]) || ((mask >> narrow<u32>(l)) & 1) != 0)
                {
                    continue;
                }
                Type lh = apply(&f.params[l].ty, &m);
                Type lt = if (resolved(
                    &lh,
                    &f.type_params,
                )) { probe_try(g, x, &args[l], Some(&lh)) } else { probe_try(g, x, &args[l], None) };
                if (x.probe_failed)
                {
                    x.probe_failed = false;
                    continue;
                }
                Type lu = closure_as_fn(g, &f.params[l].ty, &lt);
                unify(&f.params[l].ty, &lu, &f.type_params, &mut m);
            }
            hint = apply(&p.ty, &m);
        }
        bool known = resolved(&hint, &f.type_params);
        match (lower_user_arg_direct(g, x, name, f, args, j, a, p, &argv, &mut m, &mut map_excl_checked))
        {
            Some(da) :
            {
                match (da)
                {
                    DirectArg::Arg(dv)  :
                    {
                        // CHG-0356: the argument's type fixes the callee's
                        // type parameters whichever direct path lowered it.
                        unify(&p.ty, &dv.ty, &f.type_params, &mut m);
                        put_arg(&mut argv, j, dv);
                        continue;
                    },
                    DirectArg::Diverged :
                    {
                        return never();
                    },
                }
            },
            None     : {},
        }
        bool is_index = j == 1 && (name == "std::Vec::index_shared" || name == "std::Vec::index_exclusive");
        V v = if (is_index && Vec::len(&argv) > 0)
        {
            Type vt = match (&argv[0].ty)
            {
                Type::TRef(r0) : clone(&Box::get(r0).inner),
                _              : clone(&argv[0].ty),
            };
            String vc = ctype(g, &vt);
            String len = sprintf("(((%s *)(%s).p))->len", &vc, &argv[0].c);
            lower_index_arg(g, x, len, a)
        }
        else
        {
            // D-0286: a by-value resource argument of a decided program goes
            // over with no object where it can: an inert literal built with
            // none, a call's result taken with none (`arm_inert`), an
            // objectless local moved with none (`read_place`).
            bool p_by_ref = match (&p.ty)
            {
                Type::TRef(_)   : true,
                Type::TSlice(_) : true,
                Type::TFn(_)    : true,
                _               : false,
            };
            bool by_value = g.decided && !p_by_ref && (!known || is_resource(g, &hint));
            // (An enclosing `let`'s raw call, `bind_value`'s, is this call's
            // own: kept for it.)
            Option<String> outer_raw = if (by_value) { replace(&mut x.raw_call, None) } else { None };
            // D-0315: and the consumer's arming of this call (`arm_inert`).
            Option<InertResult> outer_inert = if (by_value) { replace(&mut x.inert_result, None) } else { None };
            if (by_value)
            {
                x.objectless = inert_expr(g, x, a);
                // A call of a function with a `__raw` form (`raw_ret_ok`):
                // that form, whose result has no object to make and forget
                // (as a `let`'s); else the call's result taken with none.
                match (raw_arg_call(g, x, a))
                {
                    Some(k) : x.raw_call = Some(request_fn(g, &k, Vec::new())),
                    // D-0315 (step 4): a result with a destructor of its own
                    // taken as the last too, pending where a later argument
                    // runs.
                    None    :
                    {
                        bool noted_arg = known && is_resource(g, &hint) && !has_refs(g, &hint) && !objectless_type(g, &hint)
                            && noted_type(g, &hint);
                        arm_inert(g, x, a, noted_arg);
                    },
                }
                // D-0315 (step 4): a local whose end runs a destructor of its
                // own goes with no object too; pending (`noted_pend`) where a
                // later argument runs (`conf.fault-ends-pending-argument`).
                x.raw_return_path = match (&strip_parens(a).kind)
                {
                    ExprKind::EPath(_) : true,
                    _                  : false,
                };
            }
            // D-0315 (step 4): a closure literal for a `fn` parameter that does
            // not escape is boxed on the stack.
            Option<usize> sb_saved = replace(&mut x.stack_box_at, None);
            bool lit_closure = match (&strip_parens(a).kind)
            {
                ExprKind::EClosure(_) : true,
                ExprKind::EPath(_)    : true,
                _                     : false,
            };
            if (g.decided && x.probing == 0 && is_fn_type(&p.ty) && lit_closure && fn_param_noescape(g, &String::copy(name), j))
            {
                x.stack_box_at = Some(strip_parens(a).id);
            }
            V bv = if (known) { lower_expr(g, x, a, Some(&hint)) } else { lower_expr(g, x, a, None) };
            x.stack_box_at = sb_saved;
            if (by_value)
            {
                x.objectless = false;
                x.inert_result = outer_inert;
                x.raw_return_path = false;
                x.raw_call = outer_raw;
            }
            bv
        };
        if (is_never(&v.ty))
        {
            return never();
        }
        // A closure fixes a `fn(...) : R` parameter's type parameters by its
        // signature (D-0073), then moves into a callable box of that type.
        Type vu = closure_as_fn(g, &p.ty, &v.ty);
        unify(&p.ty, &vu, &f.type_params, &mut m);
        bool box_it = is_fn_type(&p.ty) && is_closure(&v.ty);
        // D-0315 (step 4): a stack box where the parameter does not escape.
        if (box_it)
        {
            x.stack_box = g.decided && x.probing == 0 && fn_param_noescape(g, &String::copy(name), j);
        }
        V vb = if (box_it) { box_closure(g, x, v, apply(&p.ty, &m), a.line) } else { v };
        x.stack_box = false;
        Type v_ty_before = clone(&vb.ty);
        V t0 = into_temp(g, x, vb, a.line);
        V t = weaken_arg(g, x, t0, &p.ty, a.line);
        // D-0315 (step 4): a value with a destructor of its own, with no
        // object, that a later argument runs after: pending until the call.
        if (g.decided && x.probing == 0 && Option::is_none(&t.obj) && HashSet::contains(&x.inert_c, &t.c) && is_resource(
            g,
            &t.ty,
        ) && !has_refs(g, &t.ty) && !objectless_type(g, &t.ty) && noted_type(g, &t.ty))
        {
            bool rest = true;
            for (usize q = j + 1; q < Vec::len(args); q += 1)
            {
                if (rest && !harmless(g, x, &args[q]))
                {
                    rest = false;
                }
            }
            if (!rest)
            {
                t = noted_pend(g, x, t, a.line);
            }
        }
        // CHG-0358: a reference binding passed whole to a function whose
        // result may hold a reference to its referent type: a path derived
        // for the call is the result's.
        Type ret_now = apply(&f.ret, &m);
        bool derive = false;
        match (&t.ty)
        {
            Type::TRef(r) :
            {
                match (&strip_parens(a).kind)
                {
                    ExprKind::EPath(pe) :
                    {
                        derive = Vec::len(&Box::get(pe).segs) == 1 && Vec::len(&Box::get(pe).targs) == 0 && type_eq(
                            &v_ty_before,
                            &t.ty,
                        ) && may_carry_ref_to(g, &ret_now, &Box::get(r).inner, &f.type_params);
                    },
                    _                   : {},
                }
            },
            _             : {},
        }
        V t2 = if (derive)
        {
            ref<ModedTy, shared> r = match (&t.ty)
            {
                Type::TRef(r) : Box::get(r),
                _             : return unit(),
            };
            String lc = loc(g, x.std_body, a.line);
            str mdc = if (r.mode == Mode::Exclusive) { "CB_EXCLUSIVE" } else { "CB_SHARED" };
            String tok = fresh(g, "tok");
            emit(
                x,
                &sprintf("uint64_t %s = cb_borrow((%s).tok, NULL, 0, %s, %s);", &tok, &t.c, mdc, &lc),
            );
            String rr = fresh(g, "r");
            emit(x, &sprintf("cb_ref %s = ((cb_ref){ (%s).p, %s });", &rr, &t.c, &tok));
            V { .c = rr, .ty = clone(&t.ty), .obj = None }
        }
        else
        {
            t
        };
        // A slice formed for the call, or reborrowed shared for it (D-0049),
        // is held only by the callee's parameter: it ends at the call's return.
        bool formed_here = match (&strip_parens(a).kind)
        {
            ExprKind::ESliceOf(_) : true,
            _                     : false,
        };
        bool reborrowed = match (&v_ty_before)
        {
            Type::TSlice(b) :
            {
                Box::get(b).mode == Mode::Exclusive && match (&t2.ty)
                {
                    Type::TSlice(c) : Box::get(c).mode == Mode::Shared,
                    _               : false,
                }
            },
            _               : false,
        };
        bool is_slice = match (&t2.ty)
        {
            Type::TSlice(_) : true,
            _               : false,
        };
        if (is_slice && (formed_here || reborrowed))
        {
            match (&t2.obj)
            {
                Some(o) : Vec::push(&mut weakened, String::clone(o)),
                None    : {},
            }
        }
        put_arg(&mut argv, j, t2);
    }
    Vec<Type> inst = Vec::new();
    foreach (tp in &f.type_params)
    {
        match (HashMap::get(&m, tp))
        {
            Some(t) : Vec::push(&mut inst, clone(t)),
            None    :
            {
                eprintf("cobc: cannot infer type arguments of `%v` (in `%s`)\n", name, &x.fn_name);
                assert(false, "cobc: cannot infer type arguments");
            },
        }
    }
    at_after_arg_calls(g, x, reads_at, args, line);
    match (&site)
    {
        Some(sk) :
        {
            if (g.prog.table.any_point_checks)
            {
                match (HashMap::get(&g.prog.table.point_checks, sk))
                {
                    Some(pcs) :
                    {
                        Vec<PointCheck> pcs2 = clone(pcs);
                        emit_point_checks(g, x, &pcs2, &argv, line);
                    },
                    None      : {},
                }
            }
        },
        None     : {},
    }
    match (access)
    {
        Some(write) :
        {
            match (native_elem_access(g, x, name, f, &inst, &argv, write, line))
            {
                Some(v) : return v,
                None    : {},
            }
        },
        None        : {},
    }
    String cname0 = request_variant(g, name, clone(&inst), mask);
    // D-0209: the direct twin itself where every direct argument is the
    // caller's own local (`direct_local_call`).
    String cname1 = if (direct_local_call(g, x, name, f, &inst, mask, args) || zero_token_call(
        g,
        x,
        name,
        f,
        &inst,
        mask,
        &argv,
    )) { sprintf("%s__dir", &cname0) } else { cname0 };
    // D-0219: a call whose reference arguments the dispatcher's cheap test
    // cannot vouch for asks its `__arrive` twin.
    String cname = if (!StringView::ends_with(
        &cname1,
        "__dir",
    ) && !vouched_args(g, x, f, &inst, args)) { sprintf("%s%s", &cname1, ARRIVE_MARK) } else { cname1 };
    HashMap<String, Type> fsub = subst_of(&f.type_params, &inst);
    // D-0309: a self tail call's reference arguments go in flight first, ahead
    // of the data the body receives at its start, and come back once this
    // frame has ended (below): one formed in this frame was the statement's,
    // and ended with it before the body ran again (CHG-0439).
    bool tail_target_here = false;
    foreach (tt in &x.tail_targets)
    {
        if (*tt == cname)
        {
            tail_target_here = true;
        }
    }
    bool tail_here = x.self_tail_now && fresh_m == 0 && !map_excl_checked && tail_target_here && Vec::len(&argv) == Vec::len(
        &f.params,
    );
    usize tail_refs = 0;
    if (tail_here)
    {
        for (usize j = 0; j < Vec::len(&f.params); j += 1)
        {
            Type tail_pty = apply(&f.params[j].ty, &fsub);
            bool is_ref = match (&tail_pty)
            {
                Type::TRef(_) : true,
                _             : false,
            };
            if (is_ref)
            {
                emit(x, &sprintf("cb_send_ref((%s).tok);", &argv[j].c));
                tail_refs += 1;
            }
        }
    }
    // Resources and reference data go in flight in argument order.
    String callee_key = String::copy(name);
    for (usize j = 0; j < Vec::len(&f.params) && j < Vec::len(&argv); j += 1)
    {
        Type pty = apply(&f.params[j].ty, &fsub);
        bool is_ref = match (&pty)
        {
            Type::TRef(_) : true,
            _             : false,
        };
        bool is_slice = match (&pty)
        {
            Type::TSlice(_) : true,
            _               : false,
        };
        if (is_resource(g, &pty))
        {
            give_arg(g, x, &argv[j], "a resource argument");
        }
        else if (is_slice && pure_direct(g, &callee_key, j))
        {
        }
        else if (pure_view(g, &callee_key, j) && (!is_probe(&f.params[j].ty) || is_named(&pty, "std::StringView")))
        {
            // Not sent (`pure_view`): a temporary view ends after the call,
            // where the callee would have ended it.
            match (&argv[j].obj)
            {
                Some(o) : Vec::push(&mut weakened, String::clone(o)),
                None    : {},
            }
        }
        else if (has_refs(g, &pty) && !is_ref)
        {
            u32 tid = type_id(g, &pty);
            emit(x, &sprintf("cb_send_datum(&%s, %vu);", &argv[j].c, tid));
        }
    }
    Type ret = apply(&f.ret, &fsub);
    Vec<String> cs = Vec::new();
    foreach (v in &argv)
    {
        Vec::push(&mut cs, String::clone(&v.c));
    }
    String argl = String::join(&cs, ", ");
    Option<usize> key = Some(args_key(args));
    if (opt_eq(
        &x.map_acc,
        &key,
    ) && name == "std::HashMap::entry" && native_map_passthrough(g, x, name, f, args, 0))
    {
        x.map_acc = None;
        // The `_acc` variant: the value's address, its element access made
        // (`lower_block_body`'s compound pair).
        Type vt = match (&ret)
        {
            Type::TRef(m) : clone(&Box::get(m).inner),
            _             :
            {
                assert(false, "cobc: entry's result");
                Type::TVoid
            },
        };
        String vc = ctype(g, &vt);
        String pv = fresh(g, "pv");
        emit(x, &sprintf("%s *%s = %s_acc(%s);", &vc, &pv, &cname, &argl));
        x.map_acc_used = true;
        return V { .c = pv, .ty = ret, .obj = None };
    }
    String call = sprintf("%s%s(%s)", &cname, if (map_excl_checked) { "_x" } else { "" }, &argl);
    // D-0309 (`[Call-Self-Tail]`): the arguments into temporaries, the frame
    // left as a `return` leaves it, the parameters given the temporaries, and a
    // jump to the body's start (`self_tail`): no C frame more.
    bool tail_now = replace(&mut x.self_tail_now, false);
    bool tail_target = false;
    foreach (t in &x.tail_targets)
    {
        if (*t == cname)
        {
            tail_target = true;
        }
    }
    if (tail_now && fresh_m == 0 && !map_excl_checked && tail_target && Vec::len(&argv) == Vec::len(&f.params))
    {
        Vec<String> tmps = Vec::new();
        for (usize j = 0; j < Vec::len(&f.params); j += 1)
        {
            String pc = param_ctype(g, &apply(&f.params[j].ty, &fsub));
            String t = fresh(g, "ta");
            emit(x, &sprintf("%s %s = %s;", &pc, &t, &argv[j].c));
            Vec::push(&mut tmps, t);
        }
        foreach (o in &weakened)
        {
            emit(x, &sprintf("cb_absorb(%s);", o));
        }
        emit_unwind_to(x, 0);
        // Each reference sent above, now the caller's statement's, as any
        // call's argument is.
        for (usize k = 0; k < tail_refs; k += 1)
        {
            emit(x, "cb_recv_ref();");
        }
        for (usize j = 0; j < Vec::len(&f.params); j += 1)
        {
            emit(x, &sprintf("p_%s = %s;", &san(&f.params[j].name), &tmps[j]));
        }
        // D-0317: the next iteration's requirements are this call's.
        String rq_loc = loc(g, x.std_body, line);
        if (Vec::len(&f.requires) > 0 && rq_loc != NOLOC)
        {
            match (StringView::find(&rq_loc, ", "))
            {
                Some(k) : emit(x, &sprintf("cb_rq_f = %s; cb_rq_l = %s;", &rq_loc[0..k], &rq_loc[k + 2..$])),
                None    : {},
            }
        }
        emit(x, "goto self_tail;");
        x.tail_used = true;
        return never();
    }
    // CHG-0237: a vector passed fresh (`fresh_shared_vec_arg`) is read
    // unchecked by the confined variant only where no object lies over its
    // elements; where one does, the ordinary variant runs and checks.
    if (fresh_m != 0)
    {
        String slow = request_variant(g, name, clone(&inst), mask & ~fresh_m);
        Vec<String> tests = Vec::new();
        for (usize j = 0; j < Vec::len(&f.params) && j < Vec::len(&argv); j += 1)
        {
            if (((fresh_m >> narrow<u32>(j)) & 1) == 0)
            {
                continue;
            }
            Type pty = apply(&f.params[j].ty, &fsub);
            Type inner = match (&pty)
            {
                Type::TRef(r) : clone(&Box::get(r).inner),
                _             : continue,
            };
            Type e0 = match (&inner)
            {
                Type::TNamed(n) : clone(&Box::get(n).args[0]),
                _               : continue,
            };
            u64 size = size_align(g, &e0).size;
            String vc = ctype(g, &inner);
            Vec::push(
                &mut tests,
                sprintf(
                    "cb_live_in((void *)((%s *)(%s).p)->ptr, ((%s *)(%s).p)->len * %vu)",
                    &vc,
                    &argv[j].c,
                    &vc,
                    &argv[j].c,
                    size,
                ),
            );
        }
        call = sprintf("((%s) ? %s(%s) : %s(%s))", &String::join(&tests, " || "), &slow, &argl, &cname, &argl);
    }
    // The `_acc` variant of `HashMap::get[_mut]` (`unwrapped_map_get`,
    // `get_mut_acc_arms`): the value's address, its element access made;
    // and the `Option<ref<T>>` whose token is received unheld (`datum_tok`).
    Option<Type> acc_vt = None;
    if (opt_eq(
        &x.map_get_acc,
        &key,
    ) && (name == "std::HashMap::get_mut" || name == "std::HashMap::get") && one_ref_option(&ret) && native_map_passthrough(
        g,
        x,
        name,
        f,
        args,
        0,
    ))
    {
        match (&ret)
        {
            Type::TNamed(n) :
            {
                match (&Box::get(n).args[0])
                {
                    Type::TRef(m) :
                    {
                        if (plain_data(g, &Box::get(m).inner))
                        {
                            acc_vt = Some(clone(&Box::get(m).inner));
                        }
                    },
                    _             : {},
                }
            },
            _               : {},
        }
    }
    V v = match (acc_vt)
    {
        Some(vt) :
        {
            x.map_get_acc = None;
            String vc = ctype(g, &vt);
            String pv = fresh(g, "pv");
            str xs = if (map_excl_checked) { "_x" } else { "" };
            emit(x, &sprintf("%s *%s = %s_acc%s(%s);", &vc, &pv, &cname, xs, &argl));
            String t = fresh(g, "t");
            String oc = ctype(g, &ret);
            emit(x, &sprintf("%s %s;", &oc, &t));
            emit(x, &sprintf("%s.tag = %s ? 0u : 1u;", &t, &pv));
            emit(x, &sprintf("%s.u.v0 = (void *)%s;", &t, &pv));
            x.map_get_acc_out = Some(pv);
            V { .c = t, .ty = ret, .obj = None }
        },
        None     :
        {
            if (opt_eq(&x.datum_tok, &key) && one_ref_option(&ret))
            {
                x.datum_tok = None;
                String t = fresh(g, "t");
                String c = ctype(g, &ret);
                emit(x, &sprintf("%s %s = %s;", &c, &t, &call));
                String tk = fresh(g, "tk");
                emit(x, &sprintf("uint64_t %s = cb_recv_datum_tok();", &tk));
                x.datum_tok_out = Some(tk);
                V { .c = t, .ty = ret, .obj = None }
            }
            else
            {
                // D-0286: the consumer took this call's result inert
                // (`arm_inert`).
                Option<bool> inert_last = match (&x.inert_result)
                {
                    Some(ir) : if (ir.key == args_key(args)) { Some(ir.last) } else { None },
                    None     : None,
                };
                if (Option::is_none(&inert_last))
                {
                    inert_last = armed;
                }
                if (Option::is_some(&inert_last))
                {
                    x.inert_now = inert_last;
                    x.inert_result = None;
                }
                V fv = finish_call(g, x, call, ret, line);
                x.inert_now = None;
                fv
            }
        },
    };
    foreach (o in &weakened)
    {
        emit(x, &sprintf("cb_absorb(%s);", o));
    }
    v
}

// A reference or slice argument reborrowed shared for a shared parameter.
export fn weaken_arg(ref<Gen, exclusive> g, ref<Fx, exclusive> x, V t, ref<Type, shared> pty, usize line) : V
{
    String lc = loc(g, x.std_body, line);
    match (&t.ty)
    {
        Type::TRef(a)   :
        {
            match (pty)
            {
                Type::TRef(b) :
                {
                    if (Box::get(a).mode == Mode::Exclusive && Box::get(b).mode == Mode::Shared)
                    {
                        String tok = fresh(g, "tok");
                        emit(
                            x,
                            &sprintf(
                                "uint64_t %s = cb_borrow((%s).tok, NULL, 0, CB_SHARED, %s);",
                                &tok,
                                &t.c,
                                &lc,
                            ),
                        );
                        String r = fresh(g, "r");
                        emit(x, &sprintf("cb_ref %s = ((cb_ref){ (%s).p, %s });", &r, &t.c, &tok));
                        return V { .c = r, .ty = Type::TRef(Box::new(ModedTy { .inner = clone(&Box::get(a).inner), .mode = Mode::Shared })), .obj = None };
                    }
                },
                _             : {},
            }
        },
        Type::TSlice(a) :
        {
            match (pty)
            {
                Type::TSlice(b) :
                {
                    if (Box::get(a).mode == Mode::Exclusive && Box::get(b).mode == Mode::Shared)
                    {
                        Type sty = Type::TSlice(Box::new(ModedTy { .inner = clone(&Box::get(a).inner), .mode = Mode::Shared }));
                        String c = ctype(g, &sty);
                        String tok = fresh(g, "tok");
                        emit(
                            x,
                            &sprintf(
                                "uint64_t %s = cb_borrow(cb_load_ref(&(%s).src), NULL, 0, CB_SHARED, %s);",
                                &tok,
                                &t.c,
                                &lc,
                            ),
                        );
                        String n = fresh(g, "sl");
                        emit(x, &sprintf("%s %s;", &c, &n));
                        emit(
                            x,
                            &sprintf(
                                "%s.src = (%s).src; cb_store_ref(&%s.src, %s);",
                                &n,
                                &t.c,
                                &n,
                                &tok,
                            ),
                        );
                        emit(
                            x,
                            &sprintf("%s.data = (%s).data; %s.len = (%s).len;", &n, &t.c, &n, &t.c),
                        );
                        return register_temp(g, x, n, sty, line);
                    }
                },
                _               : {},
            }
        },
        _               : {},
    }
    t
}

// `$` for the index argument of `Vec::index_*`.
export fn lower_index_arg(ref<Gen, exclusive> g, ref<Fx, exclusive> x, String len, ref<Expr, shared> a) : V
{
    Vec::push(&mut x.dollar, len);
    Type us = Type::TInt(IntTy::Usize);
    V r = lower_expr(g, x, a, Some(&us));
    Vec::pop(&mut x.dollar);
    r
}

export fn strip_parens(ref<Expr, shared> e) : ref<Expr, shared>
{
    match (&e.kind)
    {
        ExprKind::EParen(i) : strip_parens(Box::get(i)),
        _                   : e,
    }
}

// CHG-0362: after the arguments of a `std` call, one of which called a
// function: the call's line again, where a fault the `std` body raises is
// reported.
export fn at_after_arg_calls(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    bool prelude,
    ref<Vec<Expr>, shared> args,
    usize line,
)
{
    if (!prelude)
    {
        return;
    }
    foreach (a in args)
    {
        if (contains_call(a))
        {
            at(g, x, line);
            return;
        }
    }
}

export fn contains_call(ref<Expr, shared> e) : bool
{
    HashSet<String> found = HashSet::new();
    find_call(e, &mut found);
    HashSet::len(&found) > 0
}

export fn find_call(ref<Expr, shared> e, ref<HashSet<String>, exclusive> out)
{
    match (&e.kind)
    {
        ExprKind::ECall(_) :
        {
            HashSet::insert(out, "call");
        },
        _                  : {},
    }
    each_child(e, out, find_call, find_call_block);
}

export fn find_call_block(ref<Block, shared> b, ref<HashSet<String>, exclusive> out)
{
    foreach (s in &b.stmts)
    {
        match (s)
        {
            Stmt::SLet(l)         :
            {
                match (&Box::get(l).init)
                {
                    Some(e) : find_call(e, out),
                    None    : {},
                }
            },
            Stmt::SDestructure(d) : find_call(&Box::get(d).init, out),
            Stmt::SExpr(e)        : find_call(Box::get(e), out),
            Stmt::SBlockLike(e)   : find_call(Box::get(e), out),
        }
    }
    match (&b.tail)
    {
        Some(t) : find_call(Box::get(t), out),
        None    : {},
    }
}

// A call's result: where it lands (void, a reference, a resource, a plain
// value).
export fn finish_call(ref<Gen, exclusive> g, ref<Fx, exclusive> x, String call, Type ret, usize line) : V
{
    if (is_void(&ret) || is_never(&ret))
    {
        emit(x, &sprintf("%s;", &call));
        return if (is_never(&ret)) { never() } else { unit() };
    }
    match (&ret)
    {
        Type::TRef(_) :
        {
            String r = fresh(g, "r");
            emit(x, &sprintf("cb_ref %s = %s;", &r, &call));
            emit(x, "cb_recv_ref();");
            // D-0292: recorded on arrival in a recording frame.
            if (x.tracked)
            {
                String lc = loc(g, x.std_body, line);
                emit_rec_ref(g, x, &r, &ret, false, &lc);
            }
            return V { .c = r, .ty = ret, .obj = None };
        },
        _             : {},
    }
    String t = fresh(g, "t");
    String c = ctype(g, &ret);
    // D-0196: into an objectless binding: the `__raw` form, whose result has
    // no object to receive (its `__arrive` twin where the call asks for one,
    // D-0219).
    match (clone(&x.raw_call))
    {
        Some(n) :
        {
            String marked_p = sprintf("%s%s(", &n, ARRIVE_MARK);
            bool marked = StringView::starts_with(&call, &marked_p);
            if (marked || StringView::starts_with(&call, &sprintf("%s(", &n)))
            {
                x.raw_call = None;
                usize skip = StringView::len(&n) + if (marked) { StringView::len(ARRIVE_MARK) } else { 0 };
                StringView rest = &call[skip..$];
                str am = if (marked) { ARRIVE_MARK } else { "" };
                emit(x, &sprintf("%s %s = %s__raw%s%v;", &c, &t, &n, am, rest));
                names_add(x, NameSet::InertC, String::clone(&t));
                return V { .c = t, .ty = ret, .obj = None };
            }
        },
        None    : {},
    }
    emit(x, &sprintf("%s %s = %s;", &c, &t, &call));
    // D-0286: asked for inert (`arm_inert`): no object.
    bool inert = match (replace(&mut x.inert_now, None))
    {
        Some(last) : last || objectless_type(g, &ret),
        None       : false,
    };
    if (inert && is_resource(g, &ret) && !has_refs(g, &ret))
    {
        names_add(x, NameSet::InertC, String::clone(&t));
        return V { .c = t, .ty = ret, .obj = None };
    }
    Option<String> obj = None;
    if (is_resource(g, &ret))
    {
        obj = Some(take_result(g, x, &t, &ret, line));
    }
    else if (plain_slice(g, &ret))
    {
    }
    else if (has_refs(g, &ret))
    {
        u32 tid = type_id(g, &ret);
        emit(x, &sprintf("cb_recv_datum(&%s, %vu);", &t, tid));
        String lc = loc(g, x.std_body, line);
        String o = fresh(g, "o");
        emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &t, tid, &lc));
        obj = Some(o);
    }
    V { .c = t, .ty = ret, .obj = obj }
}

// ---- if, blocks, loops ----

// `{ V }` for a payloadless variant V of a generic enum (`{ None }`), not
// shadowed by a local: its type arguments come from its context alone.
export fn is_untyped_variant_block(ref<Gen, shared> g, ref<Fx, shared> x, ref<Block, shared> b) : bool
{
    if (Vec::len(&b.stmts) > 0)
    {
        return false;
    }
    ref<Expr, shared> t = match (&b.tail)
    {
        Some(t) : strip_parens(Box::get(t)),
        None    : return false,
    };
    ref<PathExpr, shared> p = match (&t.kind)
    {
        ExprKind::EPath(p) : Box::get(p),
        _                  : return false,
    };
    if (Vec::len(&p.targs) > 0 || (Vec::len(&p.segs) == 1 && is_bound(x, &p.segs[0])))
    {
        return false;
    }
    match (variant_of(g, &p.segs))
    {
        Some(vr) : match (enum_decl(g, &vr.ename))
        {
            Some(ed) : Vec::len(&ed.type_params) > 0 && Option::is_none(&ed.variants[vr.vi].payload),
            None     : false,
        },
        None : false,
    }
}

export fn is_literal_block(ref<Block, shared> b) : bool
{
    Vec::len(&b.stmts) == 0 && match (&b.tail)
    {
        Some(t) : is_literal_expr(Box::get(t)),
        None    : false,
    }
}

export fn lower_if(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> c,
    ref<Block, shared> then_b,
    ref<Option<Expr>, shared> else_e,
    Option<ref<Type, shared>> expected,
    usize line,
) : V
{
    Type tbool = Type::TBool;
    V cv = lower_expr(g, x, c, Some(&tbool));
    if (is_never(&cv.ty))
    {
        return never();
    }
    V ct = into_temp(g, x, cv, line);
    // D-0049: a literal then-branch takes the else branch's type.
    Option<Type> else_hint = None;
    match (else_e)
    {
        Some(e) :
        {
            if (Option::is_none(&expected) && (is_literal_block(then_b) || is_untyped_variant_block(
                g,
                x,
                then_b,
            )) && !is_literal_branch(e))
            {
                Type t = probe_type(g, x, e, None);
                if (!is_never(&t) && !is_void(&t))
                {
                    else_hint = Some(t);
                }
            }
        },
        None    : {},
    }
    Option<Type> exp_own = match (expected)
    {
        Some(t) : Some(clone(t)),
        None    : else_hint,
    };
    Type then_ty = match (&exp_own)
    {
        Some(t) : probe_block_type(g, x, then_b, Some(t)),
        None    : probe_block_type(g, x, then_b, None),
    };
    Type result_ty = match (else_e)
    {
        None    : Type::TVoid,
        Some(e) :
        {
            if (is_never(&then_ty))
            {
                match (&exp_own)
                {
                    Some(t) : probe_type(g, x, e, Some(t)),
                    None    : probe_type(g, x, e, None),
                }
            }
            else
            {
                clone(&then_ty)
            }
        },
    };
    Option<Sink> sink = None;
    if (!is_void(&result_ty) && !is_never(&result_ty))
    {
        String r = fresh(g, "r");
        String rc = reg_ctype(g, &result_ty);
        emit(x, &sprintf("%s %s;", &rc, &r));
        // Raw as a `match`'s is, when the `if` is a `__raw` form's (or a raw
        // sink's) last expression (`raw_tail`, decided).
        Option<String> ov = match_sink_obj_var(g, x, &result_ty, Some(c.id));
        sink = Some(Sink { .dst = r, .ty = clone(&result_ty), .ov = ov });
    }
    emit(x, &sprintf("if (%s) {", &ct.c));
    x.ind += 1;
    x.frame_line = Some(line);
    V tv = match (&exp_own)
    {
        Some(t) : lower_branch_block(g, x, then_b, Some(t), as_sink(&sink)),
        None    : lower_branch_block(g, x, then_b, None, as_sink(&sink)),
    };
    x.ind -= 1;
    Option<String> obj = clone(&tv.obj);
    match (else_e)
    {
        Some(e) :
        {
            emit(x, "} else {");
            x.ind += 1;
            Option<Type> exp2 = match (&exp_own)
            {
                Some(t) : Some(clone(t)),
                None    : if (is_never(&then_ty)) { None } else { Some(clone(&then_ty)) },
            };
            V ev = match (&exp2)
            {
                Some(t) : lower_branch(g, x, e, Some(t), as_sink(&sink)),
                None    : lower_branch(g, x, e, None, as_sink(&sink)),
            };
            x.ind -= 1;
            if (Option::is_none(&obj))
            {
                obj = clone(&ev.obj);
            }
        },
        None    : {},
    }
    emit(x, "}");
    // A raw sink's value has no object (`inert_c`), as a block's.
    match (&sink)
    {
        Some(sk) :
        {
            match (&sk.ov)
            {
                Some(o) :
                {
                    if (HashSet::contains(&x.raw_sinks, o))
                    {
                        names_add(x, NameSet::InertC, String::clone(&sk.dst));
                        obj = None;
                    }
                },
                None    : {},
            }
        },
        None     : {},
    }
    match (sink)
    {
        Some(sk) : V { .c = String::clone(&sk.dst), .ty = result_ty, .obj = obj },
        None     : if (is_never(&result_ty)) { never() } else { unit() },
    }
}

export fn as_sink(ref<Option<Sink>, shared> s) : Option<ref<Sink, shared>>
{
    match (s)
    {
        Some(k) : Some(k),
        None    : None,
    }
}

export fn is_literal_branch(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EBlock(b) : is_literal_block(b),
        _                   : is_literal_expr(e),
    }
}

// A `match`'s sink object holder, raw when the `match` (`id`, `arms_key`) is
// a `__raw` form's last expression (`raw_tail`) and its value a resource
// holding no reference (cobc's `match_sink_obj_var`).
export fn match_sink_obj_var(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Type, shared> ty,
    Option<usize> id,
) : Option<String>
{
    Option<String> ov = sink_obj_var(g, x, ty);
    match (&ov)
    {
        Some(o) :
        {
            bool tail = match (x.raw_tail)
            {
                Some(t) : match (id)
                {
                    Some(i) : t == i,
                    None    : false,
                },
                None : false,
            };
            bool armed = match (x.raw_arm)
            {
                Some(t) : match (id)
                {
                    Some(i) : t == i,
                    None    : false,
                },
                None : false,
            };
            if (tail && is_resource(g, ty) && !has_refs(g, ty))
            {
                x.raw_tail = None;
                names_add(x, NameSet::RawSinks, String::clone(o));
            }
            else if (armed && x.probing == 0 && is_resource(g, ty) && !has_refs(g, ty) && (objectless_type(g, ty) || replace(
                &mut x.raw_arm_noted,
                false,
            )))
            {
                // D-0315: its consumer takes it with no object (`arm_inert`).
                x.raw_arm = None;
                names_add(x, NameSet::RawSinks, String::clone(o));
            }
        },
        None    : {},
    }
    ov
}

export fn sink_obj_var(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Type, shared> ty) : Option<String>
{
    match (ty)
    {
        Type::TRef(_) : return None,
        _             : {},
    }
    if (plain_slice(g, ty) || !(is_resource(g, ty) || has_refs(g, ty)))
    {
        return None;
    }
    String ov = fresh(g, "ob");
    emit(x, &sprintf("uint64_t %s = 0;", &ov));
    Some(ov)
}

export fn assign_sink(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    StringView dst,
    ref<Type, shared> dty,
    V v,
    usize line,
    ref<Option<String>, shared> obj_var,
) : Option<String>
{
    if (is_never(&v.ty) || is_void(&v.ty))
    {
        return None;
    }
    match (dty)
    {
        Type::TRef(_) :
        {
            emit(x, &sprintf("%s = %s;", dst, &v.c));
            emit(x, &sprintf("cb_result_ref(%s.tok);", dst));
            return None;
        },
        _             : {},
    }
    store(g, x, dst, dty, &v);
    // A raw sink (`match_sink_obj_var`): the value's record ends here.
    bool raw = match (obj_var)
    {
        Some(ov) : HashSet::contains(&x.raw_sinks, ov),
        None     : false,
    };
    if (raw)
    {
        match (&v.obj)
        {
            Some(vo) : emit(x, &sprintf("cb_forget_obj(%s);", vo)),
            None     : {},
        }
        return None;
    }
    String o = String::new();
    if (is_resource(g, dty))
    {
        // D-0315: an inert value (`inert_c`) is given its object here.
        o = Option::expect(materialize(g, x, &v, line), "a resource result without an object");
        emit(x, &sprintf("cb_move_to(%s, &%s);", &o, dst));
    }
    else if (has_refs(g, dty))
    {
        match (&v.obj)
        {
            Some(vo) :
            {
                o = String::clone(vo);
                emit(x, &sprintf("cb_move_to(%s, &%s);", &o, dst));
            },
            None     :
            {
                if (plain_slice(g, dty))
                {
                    return None;
                }
                u32 tid = type_id(g, dty);
                String lc = loc(g, x.std_body, line);
                o = fresh(g, "o");
                emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, dst, tid, &lc));
            },
        }
    }
    else
    {
        return None;
    }
    match (obj_var)
    {
        Some(ov) :
        {
            emit(x, &sprintf("%s = %s;", ov, &o));
            Some(String::clone(ov))
        },
        None     : Some(o),
    }
}

export fn lower_branch_block(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Block, shared> b,
    Option<ref<Type, shared>> expected,
    Option<ref<Sink, shared>> sink,
) : V
{
    if (Option::is_none(&sink))
    {
        return lower_block(g, x, b, expected);
    }
    Option<usize> fl = replace(&mut x.frame_line, None);
    emit(x, "{");
    x.ind += 1;
    push_frame_at(g, x, fl);
    V v = lower_block_body(g, x, b, expected, sink);
    if (!is_never(&v.ty))
    {
        pop_frame(x);
    }
    else
    {
        end_diverged(x);
    }
    x.ind -= 1;
    emit(x, "}");
    v
}

export fn lower_branch(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> e,
    Option<ref<Type, shared>> expected,
    Option<ref<Sink, shared>> sink,
) : V
{
    bool own_scope = replace(&mut x.branch_scope, false);
    match (&e.kind)
    {
        ExprKind::EBlock(b)  :
        {
            if (Option::is_some(&sink))
            {
                x.frame_line = Some(e.line);
                return lower_branch_block(g, x, b, expected, sink);
            }
        },
        ExprKind::EUnsafe(b) :
        {
            if (Option::is_some(&sink))
            {
                x.frame_line = Some(e.line);
                return lower_branch_block(g, x, b, expected, sink);
            }
        },
        _                    : {},
    }
    match (sink)
    {
        Some(sk) :
        {
            // An expression body gets its own statement scope, as a block
            // tail does.
            push_stmt(g, x);
            // A raw sink's `String` made with no object where it can be.
            bool raw_sink = match (&sk.ov)
            {
                Some(o) : HashSet::contains(&x.raw_sinks, o),
                None    : false,
            };
            Option<V> raw = if (raw_sink && is_string_ty(&sk.ty)) { lower_raw_string(g, x, e) } else { None };
            V v = match (raw)
            {
                Some(rv) : rv,
                None     :
                {
                    if (g.decided && raw_sink)
                    {
                        // D-0286: in a decided program, the value of a raw sink
                        // (the function's result) is made with no object: a
                        // literal, a call's result, an objectless local moved.
                        x.objectless = literal_expr(g, x, e);
                        arm_inert(g, x, e, true);
                        x.raw_return_path = match (&strip_parens(e).kind)
                        {
                            ExprKind::EPath(_) : true,
                            _                  : false,
                        };
                        V dv = lower_expr(g, x, e, expected);
                        x.objectless = false;
                        x.inert_result = None;
                        x.raw_return_path = false;
                        dv
                    }
                    else
                    {
                        lower_expr(g, x, e, expected)
                    }
                },
            };
            if (is_never(&v.ty))
            {
                end_diverged(x);
                return v;
            }
            if (is_void(&v.ty))
            {
                emit(x, &sprintf("(void)(%s);", &v.c));
                pop_stmt(x);
                return unit();
            }
            Option<String> obj = assign_sink(g, x, &sk.dst, &sk.ty, v, e.line, &sk.ov);
            match (&obj)
            {
                Some(o) : emit(x, &sprintf("cb_result(%s);", o)),
                None    : {},
            }
            pop_stmt(x);
            V { .c = String::clone(&sk.dst), .ty = clone(&sk.ty), .obj = obj }
        },
        None     :
        {
            if (own_scope)
            {
                // An arm of a `match` that is a whole statement: its own
                // scope, which `resolve_scopes` drops if it is unused.
                // CHG-0391: a `match` that is the arm's whole value is the
                // arm's last evaluation, as a block's tail `match` is its
                // statement's: its own arms get their scopes, so their
                // temporaries end before the frame of their bindings does.
                push_stmt_at(g, x, Some(e.line));
                x.stmt_match = is_match(e);
                V v = lower_expr(g, x, e, expected);
                x.stmt_match = false;
                if (is_never(&v.ty))
                {
                    end_diverged(x);
                }
                else
                {
                    pop_stmt(x);
                }
                return v;
            }
            lower_expr(g, x, e, expected)
        },
    }
}

// The type a block lowers to, found as `probe_type` finds a value's (and
// cached apart, by the block's own key).
export fn probe_block_type(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Block, shared> b,
    Option<ref<Type, shared>> expected,
) : Type
{
    String key = block_key(b, expected);
    match (HashMap::get(&x.probes, &key))
    {
        Some(t) : return clone(t),
        None    : {},
    }
    String saved_out = replace(&mut x.out, probe_buf(g));
    u64 saved_uid = g.uid;
    StrMark saved_strs = str_mark(g);
    u64 saved_nstr = g.nstr;
    usize saved_cleanup = Vec::len(&x.cleanup);
    usize saved_scopes = Vec::len(&x.scopes);
    NameSnap saved_names = snapshot_names(x);
    x.probing += 1;
    V v = lower_block(g, x, b, expected);
    x.probing -= 1;
    probe_buf_done(g, replace(&mut x.out, saved_out));
    g.uid = saved_uid;
    str_restore(g, saved_strs);
    g.nstr = saved_nstr;
    Vec::truncate(&mut x.cleanup, saved_cleanup);
    Vec::truncate(&mut x.scopes, saved_scopes);
    restore_names(x, saved_names);
    V { c, ty, obj } = v;
    HashMap::insert(&mut x.probes, key, clone(&ty));
    ty
}

// A block's probe key: its first expression's id stands for the block
// (coby keys it by the block's address).
export fn block_key(ref<Block, shared> b, Option<ref<Type, shared>> expected) : String
{
    usize id = block_id(b);
    match (expected)
    {
        Some(t) : sprintf("block %v %s", id, &type_code(t)),
        None    : sprintf("block %v -", id),
    }
}

export fn block_id(ref<Block, shared> b) : usize
{
    foreach (s in &b.stmts)
    {
        match (s)
        {
            Stmt::SLet(l)         :
            {
                match (&Box::get(l).init)
                {
                    Some(e) : return e.id,
                    None    : {},
                }
            },
            Stmt::SDestructure(d) : return Box::get(d).init.id,
            Stmt::SExpr(e)        : return Box::get(e).id,
            Stmt::SBlockLike(e)   : return Box::get(e).id,
        }
    }
    match (&b.tail)
    {
        Some(t) : Box::get(t).id,
        None    : 0,
    }
}

// A block as a value: a first pass into a buffer learns the tail's type,
// then the body is lowered into its sink.
export fn lower_block(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Block, shared> b,
    Option<ref<Type, shared>> expected,
) : V
{
    Option<usize> fl = replace(&mut x.frame_line, None);
    String key = block_key(b, expected);
    Type value_ty = match (HashMap::get(&x.probes, &key))
    {
        Some(t) : clone(t),
        None    :
        {
            String saved_out = replace(&mut x.out, probe_buf(g));
            u64 saved_uid = g.uid;
            StrMark saved_strs = str_mark(g);
            u64 saved_nstr = g.nstr;
            usize saved_cleanup = Vec::len(&x.cleanup);
            usize saved_scopes = Vec::len(&x.scopes);
            NameSnap saved_names = snapshot_names(x);
            usize probe_ind = x.ind;
            x.ind += 1;
            push_frame_at(g, x, fl);
            x.probing += 1;
            V probe = lower_block_body(g, x, b, expected, None);
            x.probing -= 1;
            Vec::truncate(&mut x.cleanup, saved_cleanup);
            Vec::truncate(&mut x.scopes, saved_scopes);
            restore_names(x, saved_names);
            x.ind = probe_ind;
            probe_buf_done(g, replace(&mut x.out, saved_out));
            g.uid = saved_uid;
            str_restore(g, saved_strs);
            g.nstr = saved_nstr;
            V { c, ty, obj } = probe;
            HashMap::insert(&mut x.probes, String::clone(&key), clone(&ty));
            ty
        },
    };
    Option<Sink> sink = None;
    if (!is_never(&value_ty) && !is_void(&value_ty))
    {
        String r = fresh(g, "b");
        String c = reg_ctype(g, &value_ty);
        emit(x, &sprintf("%s %s;", &c, &r));
        // D-0286: raw as a `match`'s is, when the block is a `__raw` form's
        // last expression (`raw_tail`).
        Option<String> ov = match_sink_obj_var(g, x, &value_ty, Some(block_id(b)));
        sink = Some(Sink { .dst = r, .ty = clone(&value_ty), .ov = ov });
    }
    emit(x, "{");
    x.ind += 1;
    push_frame_at(g, x, fl);
    V v = lower_block_body(g, x, b, expected, as_sink(&sink));
    if (!is_never(&v.ty))
    {
        pop_frame(x);
    }
    else
    {
        end_diverged(x);
    }
    x.ind -= 1;
    emit(x, "}");
    match (sink)
    {
        Some(sk) :
        {
            // A raw sink's value has no object (`inert_c`).
            match (&sk.ov)
            {
                Some(o) :
                {
                    if (HashSet::contains(&x.raw_sinks, o))
                    {
                        names_add(x, NameSet::InertC, String::clone(&sk.dst));
                    }
                },
                None    : {},
            }
            V { .c = String::clone(&sk.dst), .ty = value_ty, .obj = clone(&v.obj) }
        },
        None     : v,
    }
}

// D-0320: the longest loop, in lines of C, emitted twice under a length
// guard: past it, once, as any loop.
const usize GUARD_LINES = 400;

export fn lower_while(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> c,
    ref<Block, shared> b,
    ref<Option<Expr>, shared> step,
) : V
{
    if (boot(g, 2))
    {
        // D-0274: no proof that the step cannot overflow.
    }
    else
    {
        match (loop_increment(x, c, b, step))
        {
            Some(inc) :
            {
                HashSet::insert(&mut x.no_overflow, inc);
            },
            None      : {},
        }
    }
    // A `foreach` over a vector whose holder the body confines
    // (`foreach_alias`): confined before the condition too.
    if (Vec::len(&b.stmts) > 0)
    {
        usize saved = StringView::len(&x.out);
        Option<ref<Stmt, shared>> next1 = if (Vec::len(&b.stmts) > 1) { Some(&b.stmts[1]) } else { None };
        foreach_alias(g, x, &b.stmts[0], next1);
        String::truncate(&mut x.out, saved);
    }
    Vec<HoistWas> hoists = hoist_vec_headers(g, x, c, b, step);
    // D-0309: a test that keeps the loop's variable below a bound fixed for
    // the loop (`loop_bound`): the body's bounds checks of that variable
    // against a fixed vector length are tagged, and the loop marked, for
    // `version_loops`.
    Option<VerLoop> ver = None;
    if (!boot(g, 2))
    {
        match (loop_bound(x, c, b, step))
        {
            Some(lb) :
            {
                match (lookup(x, &lb.n))
                {
                    Some(nb) :
                    {
                        Vec<String> names = Vec::new();
                        Vec::push(&mut names, String::clone(&lb.x));
                        match (&lb.alias)
                        {
                            Some(k) : Vec::push(&mut names, String::clone(k)),
                            None    : {},
                        }
                        ver = Some(VerLoop { .names = names, .bound = String::clone(&nb.c), .lens = Vec::new(), .in_body = false });
                    },
                    None     : {},
                }
            },
            None     : {},
        }
    }
    Vec::push(&mut x.versions, ver);
    // D-0320: the nest's length guard, found by the outermost loop that has
    // one (`loop_guard`); the loops inside it are copied with it.
    Option<String> grd = if (boot(g, 2) || x.guard_depth > 0) { None } else { loop_guard(g, x, c, b, step) };
    String note = Option::unwrap_or(replace(&mut g.pending_note, None), String::new());
    if (Option::is_some(&grd))
    {
        x.guard_depth += 1;
    }
    usize loop_start = StringView::len(&x.out);
    Option<String> cont = match (step)
    {
        Some(_) : Some(fresh(g, "cont")),
        None    : None,
    };
    Vec::push(&mut x.loops, Loop { .depth = Vec::len(&x.cleanup), .cont = clone(&cont) });
    Vec::push(&mut x.loop_broken, false);
    emit(x, "for (;;) {");
    x.ind += 1;
    // The condition is evaluated in a scope of its own each iteration.
    push_stmt(g, x);
    Type tbool = Type::TBool;
    V cv = lower_expr(g, x, c, Some(&tbool));
    String ct = fresh(g, "c");
    emit(x, &sprintf("uint8_t %s = %s;", &ct, &cv.c));
    pop_stmt(x);
    emit(x, &sprintf("if (!%s) break;", &ct));
    set_in_body(x, true);
    lower_block(g, x, b, None);
    set_in_body(x, false);
    match (step)
    {
        Some(st) :
        {
            emit(x, &sprintf("%s: ;", &Option::expect(clone(&cont), "a for loop's label")));
            at(g, x, st.line);
            push_stmt(g, x);
            lower_expr(g, x, st, None);
            pop_stmt(x);
        },
        None     : {},
    }
    x.ind -= 1;
    emit(x, "}");
    match (Vec::pop(&mut x.versions))
    {
        Some(Some(v)) :
        {
            if (Vec::len(&v.lens) > 0)
            {
                String mark = String::new();
                for (usize k = 0; k < x.ind; k += 1)
                {
                    String::append(&mut mark, "    ");
                }
                String::appendf(&mut mark, "%s%s %s*/\n", VER_MARK, &v.bound, &String::join(&v.lens, " "));
                String rest = String::new();
                String::append(&mut rest, &x.out[loop_start..$]);
                String::truncate(&mut x.out, loop_start);
                String::append(&mut x.out, &mark);
                String::append(&mut x.out, &rest);
            }
        },
        _             : {},
    }
    // A loop `version_loops` also copies for D-0309 keeps that copy alone; a
    // loop too long to copy is emitted once.
    match (&grd)
    {
        Some(test) :
        {
            x.guard_depth -= 1;
            String loop_text = String::new();
            String::append(&mut loop_text, &x.out[loop_start..$]);
            bool versioned = StringView::starts_with(StringView::trim_start(&loop_text), VER_MARK);
            bool long = code_lines(&loop_text) > GUARD_LINES;
            if (versioned)
            {
                String::append(&mut note, "  the guard is not used: D-0309 versions this loop against its bound instead\n");
            }
            else if (long)
            {
                String::appendf(&mut note, "  the guard is not used: the loop is over %v lines of C, so it is emitted once\n", GUARD_LINES);
            }
            if (!versioned && !long)
            {
                String mark = String::new();
                for (usize k = 0; k < x.ind; k += 1)
                {
                    String::append(&mut mark, "    ");
                }
                String::appendf(&mut mark, "%s%s*/\n", GRD_MARK, test);
                String rest = String::new();
                String::append(&mut rest, &x.out[loop_start..$]);
                String::truncate(&mut x.out, loop_start);
                String::append(&mut x.out, &mark);
                String::append(&mut x.out, &rest);
            }
        },
        None       : {},
    }
    if (StringView::len(&note) > 0)
    {
        guard_note(g, x.std_body, c.line, note);
    }
    // A copy the loop's own text never reads (its vector is indexed only in
    // nested loops, which copy again) is taken out: dead as it is, gcc's code
    // for the inner loop is worse with it there (`e12_elements`).
    usize body_at = if (Vec::len(&hoists) > 0) { hoists[Vec::len(&hoists) - 1].end } else { 0 };
    usize k = Vec::len(&hoists);
    while (k > 0)
    {
        k -= 1;
        bool read = names_ident(&x.out[body_at..$], &hoists[k].ptr) || names_ident(&x.out[body_at..$], &hoists[k].len);
        if (!read)
        {
            String rest = String::new();
            String::append(&mut rest, &x.out[hoists[k].end..$]);
            String::truncate(&mut x.out, hoists[k].start);
            String::append(&mut x.out, &rest);
        }
    }
    foreach (h in &hoists)
    {
        match (&h.was)
        {
            Some(w) :
            {
                HashMap::insert(&mut x.hoisted, String::clone(&h.c), Hoisted { .ptr = String::clone(&w.ptr), .len = String::clone(&w.len) });
            },
            None    :
            {
                HashMap::remove(&mut x.hoisted, &h.c);
            },
        }
    }
    Vec::pop(&mut x.loops);
    bool broken = match (Vec::pop(&mut x.loop_broken))
    {
        Some(k) : k,
        None    : true,
    };
    // D-0175: nothing follows a `while (true)` no `break` leaves.
    match (&c.kind)
    {
        ExprKind::EBool(t) :
        {
            if (*t && !broken)
            {
                return never();
            }
        },
        _                  : {},
    }
    unit()
}

// The innermost loop's `VerLoop`, if any, is lowering its body or not.
fn set_in_body(ref<Fx, exclusive> x, bool on)
{
    usize nv = Vec::len(&x.versions);
    if (nv > 0)
    {
        match (&mut x.versions[nv - 1])
        {
            Some(v) : v.in_body = on,
            None    : {},
        }
    }
}

// A vector whose header `hoist_vec_headers` copied, by C name; the copy it
// replaced in `hoisted`, to restore after the loop; the copy's locals; and the
// span of `out` that declares them.
struct HoistWas
{
    String c;
    Option<Hoisted> was;
    String ptr;
    String len;
    usize start;
    usize end;
}

// Whether `text` names `x` as a whole identifier (cobc's `names_ident`).
fn names_ident(StringView text, StringView x) : bool
{
    slice<u8, shared> b = StringView::as_bytes(text);
    usize n = slice_len(b);
    usize at = 0;
    while (true)
    {
        usize i = match (StringView::find(&text[at..$], x))
        {
            Some(k) : at + k,
            None    : break,
        };
        usize j = i + StringView::len(x);
        bool before = i == 0 || !(ascii_is_alnum(b[i - 1]) || b[i - 1] == b'_');
        bool after = j >= n || !(ascii_is_alnum(b[j]) || b[j] == b'_');
        if (before && after)
        {
            return true;
        }
        at = j;
    }
    false
}

// The vectors of a loop (`c`, `b`, `step`) whose header it cannot change
// (`loop_fixed_vecs`): each one's `ptr` and `len` copied into locals before
// the loop, which its element accesses read (`confined_elem_place`). Its
// address is in the frame's table (`cb_nt`), so the C compiler cannot tell
// that a store to an element leaves the header alone and would read it again
// after each. A nested loop copies again, just before it: the C compiler then
// sees the inner loop's bound and its copy together and can prove the bounds
// check away (cobc's `hoist_vec_headers`).
fn hoist_vec_headers(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> c,
    ref<Block, shared> b,
    ref<Option<Expr>, shared> step,
) : Vec<HoistWas>
{
    Vec<HoistWas> out = Vec::new();
    if (boot(g, 2))
    {
        return out;
    }
    Vec<String> names = loop_fixed_vecs(c, b, step);
    foreach (n in &names)
    {
        // A confined local, or a confined parameter (`lower_fn`'s mask: no
        // binding, the only path to its vector while the call runs); not a
        // holder (`confine_holder`, a loop's `$…`).
        String key = String::new();
        Type ty = Type::TBool;
        match (lookup(x, n))
        {
            Some(bd) :
            {
                bool local = match (&bd.kind)
                {
                    BindKind::Local : true,
                    _               : false,
                };
                if (!local)
                {
                    continue;
                }
                if (!HashSet::contains(&x.confined, &bd.c) && !(HashSet::contains(&x.read_confined, n) && StringView::len(&bd.root) > 0))
                {
                    continue;
                }
                key = String::clone(&bd.c);
                ty = clone(&bd.ty);
            },
            None     :
            {
                if (!HashSet::contains(&x.mask_params, n))
                {
                    continue;
                }
                match (HashMap::get(&x.confined_params, n))
                {
                    Some(cv) :
                    {
                        key = String::clone(&cv.c);
                        ty = Type::TNamed(Box::new(NamedTy { .name = "std::Vec", .args = one_type(clone(&cv.elem)) }));
                    },
                    None     : continue,
                }
            },
        }
        Type elem = match (vec_plain_elem(g, &ty))
        {
            Some(t) : t,
            None    : continue,
        };
        String elem_c = ctype(g, &elem);
        String hp = fresh(g, "hp");
        String hl = fresh(g, "hl");
        usize start = StringView::len(&x.out);
        emit(x, &sprintf("%s *%s = (%s).ptr;", &elem_c, &hp, &key));
        emit(x, &sprintf("uint64_t %s = (%s).len;", &hl, &key));
        usize end = StringView::len(&x.out);
        Option<Hoisted> was = match (HashMap::get(&x.hoisted, &key))
        {
            Some(w) : Some(Hoisted { .ptr = String::clone(&w.ptr), .len = String::clone(&w.len) }),
            None    : None,
        };
        HashMap::insert(&mut x.hoisted, String::clone(&key), Hoisted { .ptr = String::clone(&hp), .len = String::clone(&hl) });
        Vec::push(&mut out, HoistWas { .c = String::clone(&key), .was = was, .ptr = hp, .len = hl, .start = start, .end = end });
    }
    out
}

// `loop_fixed_vecs`' tallies: the names in order of first mention, every
// mention of each, its mentions as an indexed vector or one asked its length,
// the ones indexed, and those a closure captures.
struct FixedScan
{
    Vec<String> order;
    HashMap<String, usize> all;
    HashMap<String, usize> ok;
    HashSet<String> indexed;
    HashSet<String> bad;
}

fn fixed_bump(ref<HashMap<String, usize>, exclusive> m, ref<String, shared> n)
{
    usize k = match (HashMap::get(m, n))
    {
        Some(v) : *v,
        None    : 0,
    };
    HashMap::insert(m, String::clone(n), k + 1);
}

// The names a loop (`c`, `b`, `step`) names only as a vector it indexes
// (`x[i]`, `*Vec::index_*(&x, i)`) or asks the length of (`Vec::len(&x)`;
// `&*x` or `x` for a reference), indexing it at least once, and no closure captures: nothing in the loop can
// change such a vector's header but through another path to it, which the
// caller rules out. In order of first mention (cobc's `loop_fixed_vecs`).
fn loop_fixed_vecs(ref<Expr, shared> c, ref<Block, shared> b, ref<Option<Expr>, shared> step) : Vec<String>
{
    FixedScan s = FixedScan { .order = Vec::new(), .all = HashMap::new(), .ok = HashMap::new(), .indexed = HashSet::new(), .bad = HashSet::new() };
    fixed_expr(c, &mut s);
    fixed_block(b, &mut s);
    match (step)
    {
        Some(st) : fixed_expr(st, &mut s),
        None     : {},
    }
    Vec<String> out = Vec::new();
    foreach (n in &s.order)
    {
        if (!HashSet::contains(&s.indexed, n) || HashSet::contains(&s.bad, n))
        {
            continue;
        }
        usize all = match (HashMap::get(&s.all, n))
        {
            Some(v) : *v,
            None    : 0,
        };
        usize ok = match (HashMap::get(&s.ok, n))
        {
            Some(v) : *v,
            None    : 0,
        };
        if (all == ok)
        {
            Vec::push(&mut out, String::clone(n));
        }
    }
    out
}

fn fixed_call(ref<CallExpr, shared> c, ref<FixedScan, exclusive> s)
{
    ref<PathExpr, shared> path = match (&c.callee.kind)
    {
        ExprKind::EPath(p) : Box::get(p),
        _                  : return,
    };
    String n = String::join(&path.segs, "::");
    bool index = n == "std::Vec::index_shared" || n == "std::Vec::index_exclusive";
    if ((!index && n != "std::Vec::len") || Vec::len(&c.args) == 0)
    {
        return;
    }
    // `&x`, `&*x` or a reference `x` itself.
    ref<Expr, shared> a0 = &c.args[0];
    Option<String> xn = match (&strip_parens(a0).kind)
    {
        ExprKind::EBorrow(bb) :
        {
            ref<Expr, shared> inner = &Box::get(bb).e;
            match (&strip_parens(inner).kind)
            {
                ExprKind::EDeref(r) : path_name_raw(Box::get(r)),
                _                   : path_name_raw(inner),
            }
        },
        _                     : path_name_raw(a0),
    };
    match (xn)
    {
        Some(v) :
        {
            fixed_bump(&mut s.ok, &v);
            if (index)
            {
                HashSet::insert(&mut s.indexed, v);
            }
        },
        None    : {},
    }
}

// cobc's `visit_expr` over `e` with `loop_fixed_vecs`' action on each.
fn fixed_expr(ref<Expr, shared> e, ref<FixedScan, exclusive> s)
{
    match (&e.kind)
    {
        ExprKind::EPath(p)    :
        {
            if (Vec::len(&Box::get(p).segs) == 1)
            {
                ref<String, shared> n = &Box::get(p).segs[0];
                if (!HashMap::contains(&s.all, n))
                {
                    Vec::push(&mut s.order, String::clone(n));
                }
                fixed_bump(&mut s.all, n);
            }
        },
        ExprKind::EIndex(ix)  :
        {
            match (path_name_raw(&Box::get(ix).a))
            {
                Some(v) :
                {
                    fixed_bump(&mut s.ok, &v);
                    HashSet::insert(&mut s.indexed, v);
                },
                None    : {},
            }
        },
        ExprKind::ECall(cl)   : fixed_call(Box::get(cl), s),
        ExprKind::EClosure(k) :
        {
            foreach (n in &Box::get(k).captures)
            {
                HashSet::insert(&mut s.bad, String::clone(n));
            }
        },
        _                     : {},
    }
    // The children, as `visit_expr` walks them (no match literals).
    match (&e.kind)
    {
        ExprKind::EStructLit(sl)  :
        {
            foreach (f in &Box::get(sl).fields)
            {
                fixed_expr(&f.value, s);
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            foreach (a in es)
            {
                fixed_expr(a, s);
            }
        },
        ExprKind::EArrayRepeat(r) : fixed_expr(&Box::get(r).value, s),
        ExprKind::EUnary(u)       : fixed_expr(&Box::get(u).e, s),
        ExprKind::EBinary(bn)     :
        {
            fixed_expr(&Box::get(bn).a, s);
            fixed_expr(&Box::get(bn).b, s);
        },
        ExprKind::EBorrow(bb)     : fixed_expr(&Box::get(bb).e, s),
        ExprKind::ESliceOf(sl)    :
        {
            fixed_expr(&Box::get(sl).base, s);
            fixed_expr(&Box::get(sl).lo, s);
            fixed_expr(&Box::get(sl).hi, s);
        },
        ExprKind::EDeref(d)       : fixed_expr(Box::get(d), s),
        ExprKind::EField(f)       : fixed_expr(&Box::get(f).e, s),
        ExprKind::EIndex(ix)      :
        {
            fixed_expr(&Box::get(ix).a, s);
            fixed_expr(&Box::get(ix).b, s);
        },
        ExprKind::ECall(cl)       :
        {
            fixed_expr(&Box::get(cl).callee, s);
            foreach (a in &Box::get(cl).args)
            {
                fixed_expr(a, s);
            }
        },
        ExprKind::EAssign(p)      :
        {
            fixed_expr(&Box::get(p).a, s);
            fixed_expr(&Box::get(p).b, s);
        },
        ExprKind::EPropagate(p)   : fixed_expr(Box::get(p), s),
        ExprKind::EBlock(bl)      : fixed_block(bl, s),
        ExprKind::EUnsafe(bl)     : fixed_block(bl, s),
        ExprKind::EIf(i)          :
        {
            fixed_expr(&Box::get(i).cond, s);
            fixed_block(&Box::get(i).then_, s);
            match (&Box::get(i).else_)
            {
                Some(el) : fixed_expr(el, s),
                None     : {},
            }
        },
        ExprKind::EWhile(w)       :
        {
            fixed_expr(&Box::get(w).cond, s);
            fixed_block(&Box::get(w).body, s);
            match (&Box::get(w).step)
            {
                Some(st) : fixed_expr(st, s),
                None     : {},
            }
        },
        ExprKind::EMatch(m)       :
        {
            fixed_expr(&Box::get(m).scrut, s);
            foreach (a in &Box::get(m).arms)
            {
                fixed_expr(Box::get(&a.body), s);
            }
        },
        ExprKind::EReturn(r)      :
        {
            match (r)
            {
                Some(v) : fixed_expr(Box::get(v), s),
                None    : {},
            }
        },
        ExprKind::EClosure(k)     : fixed_block(&Box::get(k).body, s),
        ExprKind::EParen(p)       : fixed_expr(Box::get(p), s),
        _                         : {},
    }
}

fn fixed_block(ref<Block, shared> b, ref<FixedScan, exclusive> s)
{
    foreach (st in &b.stmts)
    {
        match (st)
        {
            Stmt::SLet(l)         :
            {
                match (&Box::get(l).init)
                {
                    Some(e) : fixed_expr(e, s),
                    None    : {},
                }
            },
            Stmt::SDestructure(d) : fixed_expr(&Box::get(d).init, s),
            Stmt::SExpr(e)        : fixed_expr(Box::get(e), s),
            Stmt::SBlockLike(e)   : fixed_expr(Box::get(e), s),
        }
    }
    match (&b.tail)
    {
        Some(t) : fixed_expr(Box::get(t), s),
        None    : {},
    }
}

// `place = val` for a local place (the general path).
export fn lower_assign(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> e,
    ref<Expr, shared> place,
    ref<Expr, shared> val,
) : V
{
    // `*x = e` for a `foreach (x in &mut v)` element aliased to `(*$c)[$i]`
    // (`foreach_alias`): the write is to that element (a new node each time,
    // as cobc builds one).
    match (alias_of_deref(x, strip_parens(place)))
    {
        Some(a) :
        {
            Expr v = renumbered(g, val);
            Expr w = synth(g, ExprKind::EAssign(Box::new(PairExpr { .a = a, .b = v })), e.line, e.col);
            return lower_expr(g, x, &w, None);
        },
        None    : {},
    }
    // D-0118: a write into a bit field: the whole backing integer is the
    // place written; the value must fit the width.
    match (&strip_parens(place).kind)
    {
        ExprKind::EField(fe) :
        {
            match (bitfield_of(g, x, &Box::get(fe).e, &Box::get(fe).name))
            {
                Some(bf) :
                {
                    x.place_write = true;
                    P pb0 = lower_place(g, x, &Box::get(fe).e);
                    x.place_write = false;
                    P pb1 = auto_deref(g, x, pb0);
                    P pb = if (is_guard(&pb1.ty)) { guard_through(g, x, pb1, e.line) } else { pb1 };
                    V v0 = lower_expr(g, x, val, Some(&bf.ty));
                    if (is_never(&v0.ty))
                    {
                        return never();
                    }
                    V v = into_temp(g, x, v0, val.line);
                    String lc = loc(g, x.std_body, e.line);
                    match (&pb.base)
                    {
                        Some(b) : emit(
                            x,
                            &sprintf("cb_write(%s, %s, 0u, %s);", b, &projs_args(&pb.projs), &lc),
                        ),
                        None : {},
                    }
                    str bc = c_int_type(bf.backing);
                    String mask = c_bits_mask(bf.backing, bf.w);
                    emit(
                        x,
                        &sprintf(
                            "if ((%s)(%s) > %s) cb_fault(\"diag.narrowing-overflow\", %s);",
                            bc,
                            &v.c,
                            &mask,
                            &lc,
                        ),
                    );
                    emit(
                        x,
                        &sprintf(
                            "(%s).bits = ((%s).bits & ~(%s << %vu)) | (((%s)(%s)) << %vu);",
                            &pb.c,
                            &pb.c,
                            &mask,
                            bf.off,
                            bc,
                            &v.c,
                            bf.off,
                        ),
                    );
                    return unit();
                },
                None     : {},
            }
        },
        _                    : {},
    }
    // `v[i] = x` on a `Vec` is `*Vec::index_exclusive(&mut v, i) = x`. A
    // stateless value leaves nothing between the element's borrow and the
    // write for `cb_elem_access` to skip: the element's place at once. A
    // confined vector's element (`bind_confined`) has nothing to check at
    // all; the analysis saw that `val` pushes nothing onto it.
    Expr tplace = match (vec_index_call(g, x, place, true))
    {
        Some(sy) : sy,
        None     : clone(place),
    };
    Option<P> fused = None;
    match (&tplace.kind)
    {
        ExprKind::EDeref(inner) :
        {
            bool confined = match (&Box::get(inner).kind)
            {
                ExprKind::ECall(c) : Vec::len(&Box::get(c).args) > 0 && Option::is_some(&confined_elem_vec(
                    g,
                    x,
                    &Box::get(c).args[0],
                )),
                _ : false,
            };
            if (confined || (!boot(g, 8) && stateless(g, x, val)))
            {
                fused = elem_access_place(g, x, Box::get(inner), true, e.line);
            }
        },
        _                       : {},
    }
    P p = match (fused)
    {
        Some(fp) :
        {
            if (is_never(&fp.ty))
            {
                return never();
            }
            fp
        },
        None     :
        {
            x.place_write = true;
            P lp = lower_place(g, x, &tplace);
            x.place_write = false;
            lp
        },
    };
    // A value built in place that owns nothing observable (`inert_value`):
    // it needs no object. Not into raw memory.
    x.objectless = Option::is_none(&p.raw) && is_resource(g, &p.ty) && inert_value(g, x, val);
    // D-0315: in a decided program, a value of a quiet type whose end frees
    // memory alone goes into the place with no object.
    Option<InertResult> outer_inert = replace(&mut x.inert_result, None);
    bool quiet_into = g.decided && Option::is_none(&p.raw) && is_resource(g, &p.ty) && quiet_ty(&g.prog.table, &p.ty) && objectless_type(g, &p.ty);
    if (quiet_into)
    {
        arm_inert(g, x, val, false);
    }
    // And an objectless local moved in, with none.
    x.raw_return_path = quiet_into && match (&strip_parens(val).kind)
    {
        ExprKind::EPath(_) : true,
        _                  : false,
    };
    V v0 = lower_expr(g, x, val, Some(&p.ty));
    x.raw_return_path = false;
    x.inert_result = outer_inert;
    x.objectless = false;
    if (is_never(&v0.ty))
    {
        return never();
    }
    V v = into_temp(g, x, v0, val.line);
    String lc = loc(g, x.std_body, e.line);
    bool res = is_resource(g, &p.ty);
    match (&p.base)
    {
        Some(base) :
        {
            // D-0033 (1): a whole binding whose value moved away or ended
            // (before or during `val`) gets a new object in its own frame, as
            // its first value did.
            if (p.is_binding && Vec::len(&p.projs) == 0)
            {
                match (HashMap::get(&x.rebind_frames, base))
                {
                    Some(frame) :
                    {
                        u32 tid = type_id(g, &p.ty);
                        emit(
                            x,
                            &sprintf(
                                "%s = cb_rebind(%s, &%s, %vu, %s, %s);",
                                base,
                                base,
                                &p.c,
                                tid,
                                frame,
                                &lc,
                            ),
                        );
                    },
                    None        : {},
                }
            }
            // D-0194: a quiet target's live value is destroyed by the write
            // (`cb_write_quiet`), before the store below.
            if (res && Option::is_none(&p.raw) && quiet_ty(&g.prog.table, &p.ty))
            {
                u32 tid = type_id(g, &p.ty);
                String call = sprintf(
                    "cb_write_quiet(%s, %s, (void *)&(%s), %vu, %s);",
                    base,
                    &projs_args(&p.projs),
                    &p.c,
                    tid,
                    &lc,
                );
                // D-0315: a decided program's token 0 (a place reached through
                // a reference): its drop glue (`drop_glue`).
                match (drop_glue(g, &p.ty))
                {
                    Some(gl) :
                    {
                        emit(
                            x,
                            &sprintf(
                                "if (__builtin_expect((%s) != 0, 0)) %s else %s((void *)&(%s), 0u);",
                                base,
                                &call,
                                &gl,
                                &p.c,
                            ),
                        );
                    },
                    None     : emit(x, &call),
                }
                store(g, x, &p.c, &p.ty, &v);
                if (!HashSet::contains(&x.inert_c, &v.c))
                {
                    String o = Option::expect(clone(&v.obj), "resource value has object");
                    emit(x, &sprintf("cb_absorb(%s);", &o));
                }
                return unit();
            }
            // D-0049: a resource target is live only if its value owns
            // something now, which the runtime decides unless every value of
            // the type does.
            String target = if (!res)
            {
                "0u"
            }
            else if (always_owns(&g.prog.table, &p.ty))
            {
                "1u"
            }
            else
            {
                u32 tid = type_id(g, &p.ty);
                sprintf("cb_owns(&(%s), %vu)", &p.c, tid)
            };
            emit(x, &sprintf("cb_write(%s, %s, %s, %s);", base, &projs_args(&p.projs), &target, &lc));
        },
        None       :
        {
            if (res && Option::is_none(&p.raw) && g.decided && objectless_root(x, place))
            {
                // D-0294: a write into an objectless local, whole or a field
                // (`objectless_strings`, decided): the old value, live unless
                // the whole binding was moved away (its flag), is destroyed by
                // the write, a quiet type's in place (`cb_write_quiet`), any
                // other's a fault as a direct parameter's below; the binding
                // holds the new value after.
                u32 tid = type_id(g, &p.ty);
                String root_c = String::new();
                {
                    ref<Expr, shared> re = strip_parens(place);
                    while (true)
                    {
                        match (&re.kind)
                        {
                            ExprKind::EField(fe) : re = strip_parens(&Box::get(fe).e),
                            _                    : break,
                        }
                    }
                    match (path_name(re))
                    {
                        Some(n) : match (lookup_ref(x, &n))
                        {
                            Some(b) : root_c = String::clone(&b.c),
                            None    : {},
                        },
                        None : {},
                    }
                }
                bool whole = Vec::len(&p.projs) == 0 && match (&strip_parens(place).kind)
                {
                    ExprKind::EPath(_) : true,
                    _                  : false,
                };
                Option<String> flag = match (HashMap::get(&x.moved_flag, &root_c))
                {
                    Some(f) : Some(String::clone(f)),
                    None    : None,
                };
                if (!whole)
                {
                    // A field of a moved-away binding is stale (`objectless_use`).
                    objectless_use(g, x, &root_c, e.line);
                }
                String destroy = if (quiet_ty(&g.prog.table, &p.ty))
                {
                    quiet_write_pathless(g, &p.c, &p.ty, tid, &lc)
                }
                else
                {
                    String target = if (always_owns(&g.prog.table, &p.ty)) { "1" } else
                    {
                        sprintf("cb_owns(&(%s), %vu)", &p.c, tid)
                    };
                    sprintf("if (%s) cb_fault(\"diag.overwrite-of-live-resource\", %s);", &target, &lc)
                };
                match (&flag)
                {
                    Some(fl) :
                    {
                        if (whole)
                        {
                            emit(x, &sprintf("if (!%s) { %s }", fl, &destroy));
                            emit(x, &sprintf("%s = 0;", fl));
                        }
                        else
                        {
                            emit(x, &destroy);
                        }
                    },
                    None     : emit(x, &destroy),
                }
            }
            else if (res && Option::is_none(&p.raw) && direct_place(x, &tplace))
            {
                if (quiet_ty(&g.prog.table, &p.ty))
                {
                    // D-0194: the same through a direct parameter: no path,
                    // and the place always holds its value.
                    u32 tid = type_id(g, &p.ty);
                    String w = quiet_write_pathless(g, &p.c, &p.ty, tid, &lc);
                    emit(x, &w);
                }
                else
                {
                    // A resource field through a direct parameter
                    // (`box_rec_uses`): no path to check, but the value's
                    // check stays -- overwriting a live resource faults
                    // (`[Write-Resource-Overwrite-Rejected]`), as `cb_write`
                    // would for the target's value.
                    String live = if (always_owns(&g.prog.table, &p.ty))
                    {
                        "1"
                    }
                    else
                    {
                        u32 tid = type_id(g, &p.ty);
                        sprintf("cb_owns(&(%s), %vu)", &p.c, tid)
                    };
                    emit(
                        x,
                        &sprintf(
                            "if (%s) cb_fault(\"diag.overwrite-of-live-resource\", %s);",
                            &live,
                            &lc,
                        ),
                    );
                }
            }
        },
    }
    // D-0089: a plain value holding `fn` values that is overwritten ends, as
    // a discarded one does: its closures end with it, and so do the
    // references they hold (`f = move [b]() …` after `f = move [a]() …` lets
    // `a` go). The slot owns its closures: a read copies them, or empties
    // the slot (`cb_fn_read`).
    Option<String> old_fns = None;
    if (!res && Option::is_none(&p.raw) && holds_fn(g, &p.ty))
    {
        String oc = ctype(g, &p.ty);
        String ot = fresh(g, "old");
        emit(x, &sprintf("%s %s = %s;", &oc, &ot, &p.c));
        old_fns = Some(ot);
    }
    store(g, x, &p.c, &p.ty, &v);
    match (&old_fns)
    {
        Some(ot) :
        {
            u32 tid = type_id(g, &p.ty);
            emit(x, &sprintf("cb_drop_value(&%s, %vu);", ot, tid));
        },
        None     : {},
    }
    if (res && !HashSet::contains(&x.inert_c, &v.c))
    {
        String o = Option::expect(clone(&v.obj), "resource value has object");
        match (&p.raw)
        {
            // `[Rawptr-Move-In]`: the object now lives at the raw address.
            Some(ptr) : emit(x, &sprintf("cb_raw_move_in(%s, %s);", &o, ptr)),
            None      : emit(x, &sprintf("cb_absorb(%s);", &o)),
        }
    }
    unit()
}

// A text literal: a static byte array named by its content, so the same
// literal has the same name in every program and is defined once.
export fn lower_str_lit(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<String, shared> text) : V
{
    String name = str_lit_name(g, text);
    g.nstr += 1;
    V { .c = sprintf("((cb_str){ %s, %vu })", &name, StringView::len(text)), .ty = Type::TStr, .obj = None }
}

// A text literal's bytes as a C array, named by content, so the same literal has
// the same name in every program and is defined once per program (cobc's
// `str_lit_name`).
export fn str_lit_name(ref<Gen, exclusive> g, ref<String, shared> text) : String
{
    slice<u8, shared> bytes = StringView::as_bytes(text);
    u32 n = narrow_wrapping<u32>(slice_len(bytes));
    String name = sprintf("cb_s_%s", &hex8(fnv1a32(text) ^ rotate_left(n, 16)));
    while (true)
    {
        match (HashMap::get(&g.str_names, &name))
        {
            Some(b) :
            {
                if (*b == *text)
                {
                    break;
                }
                String::push_ascii(&mut name, b'x');
            },
            None    : break,
        }
    }
    if (!HashMap::contains(&g.str_names, &name))
    {
        HashMap::insert(&mut g.str_names, String::clone(&name), String::clone(text));
        Vec::push(&mut g.str_log, String::clone(&name));
        String lit = String::new();
        foreach (b in bytes)
        {
            String::append(&mut lit, &sprintf("%v,", *b));
        }
        String::append(&mut g.strings, &sprintf("static const uint8_t %s[] = {%s0};\n", &name, &lit));
    }
    name
}

// D-0308: whether `e` is `*r` (or `r`) for a binding `r` of reference type.
fn pathless_ref_root(ref<Fx, exclusive> x, ref<Expr, shared> e) : bool
{
    ref<Expr, shared> y = match (&strip_parens(e).kind)
    {
        ExprKind::EDeref(d) : strip_parens(Box::get(d)),
        _                   : strip_parens(e),
    };
    match (&y.kind)
    {
        ExprKind::EPath(pb) :
        {
            ref<PathExpr, shared> p = Box::get(pb);
            if (Vec::len(&p.segs) != 1 || Vec::len(&p.targs) != 0)
            {
                return false;
            }
            match (lookup_ref(x, &p.segs[0]))
            {
                Some(bd) : match (&bd.ty)
                {
                    Type::TRef(_) : true,
                    _             : false,
                },
                None : false,
            }
        },
        _                   : false,
    }
}

// `{:08x}`.
export fn hex8(u32 v) : String
{
    str digits = "0123456789abcdef";
    String out = String::new();
    for (u32 k = 0; k < 8; k += 1)
    {
        u32 d = (v >> ((7 - k) * 4)) & 15;
        String::push_ascii(&mut out, str_byte(digits, widen<usize>(d)));
    }
    out
}

// D-0090: an unsuffixed integer literal the checker found taking a
// floating-point type parameter's type: `Some(single)` when one is expected.
export fn float_literal(
    ref<Gen, exclusive> g,
    ref<Expr, shared> e,
    ref<Option<String>, shared> sfx,
    Option<ref<Type, shared>> expected,
) : Option<bool>
{
    if (Option::is_some(sfx) || !HashSet::contains(&g.prog.facts.number_literals, e.id))
    {
        return None;
    }
    match (expected)
    {
        Some(t) : match (t)
        {
            Type::TF32 : Some(true),
            Type::TF64 : Some(false),
            _          : None,
        },
        None : None,
    }
}

export fn lower_unary(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    UnOp op,
    ref<Expr, shared> inner,
    Option<ref<Type, shared>> expected,
    usize line,
) : V
{
    if (op == UnOp::Neg)
    {
        match (&inner.kind)
        {
            ExprKind::EInt(l) :
            {
                match (float_literal(g, inner, &Box::get(l).sfx, expected))
                {
                    Some(single) :
                    {
                        return V { .c = c_float(
                            -to_float<f64>(Box::get(l).v),
                            single,
                        ), .ty = if (single) { Type::TF32 } else { Type::TF64 }, .obj = None };
                    },
                    None         : {},
                }
                IntTy ty = int_lit_type(&Box::get(l).sfx, expected);
                u128 zero = 0;
                u128 neg = wrapping_sub(zero, Box::get(l).v);
                return V { .c = c_int(ty, neg), .ty = Type::TInt(ty), .obj = None };
            },
            _                 : {},
        }
    }
    V v = lower_expr(g, x, inner, expected);
    if (is_never(&v.ty))
    {
        return never();
    }
    Type vty = clone(&v.ty);
    String t = into_temp_c(g, x, v, line);
    String lc = loc(g, x.std_body, line);
    match (&vty)
    {
        // D-0254: `-` and `~` lane by lane; a signed lane at its minimum
        // faults as the scalar `-` does.
        Type::TSimd(sv) :
        {
            String ct = ctype(g, &vty);
            u128 n = Box::get(sv).n;
            String c = match (&Box::get(sv).inner)
            {
                Type::TInt(it) :
                {
                    if (op == UnOp::Neg)
                    {
                        str uc = c_uint_type(*it);
                        String at_min = halve_reduce(
                            &sprintf("(_a == %s)", &c_int(*it, int_min_bits(*it))),
                            uc,
                            n,
                            widen<u128>(int_ty_bits(*it, 64) / 8),
                            0,
                            "_any",
                        );
                        sprintf(
                            "({ %s _a = %s; { %s _any; %s if (_any) cb_fault(\"diag.arith-overflow\", %s); } (%s)(-(cbvu_%s)_a); })",
                            &ct,
                            &t,
                            uc,
                            &at_min,
                            &lc,
                            &ct,
                            &mangle(&vty),
                        )
                    }
                    else
                    {
                        assert(op == UnOp::BitNot, "cobc: unary operator on an unexpected simd");
                        sprintf("(~%s)", &t)
                    }
                },
                _              :
                {
                    assert(op == UnOp::Neg, "cobc: unary operator on an unexpected simd");
                    sprintf("(-%s)", &t)
                },
            };
            return V { .c = c, .ty = clone(&vty), .obj = None };
        },
        _               : {},
    }
    match (&vty)
    {
        Type::TInt(i) :
        {
            if (op == UnOp::Neg)
            {
                str ct = c_int_type(*i);
                String c = sprintf(
                    "({ %s _a = %s; if (_a == %s) cb_fault(\"diag.arith-overflow\", %s); (%s)(-_a); })",
                    ct,
                    &t,
                    &c_int(*i, int_min_bits(*i)),
                    &lc,
                    ct,
                );
                return V { .c = c, .ty = clone(&vty), .obj = None };
            }
            assert(op == UnOp::BitNot, "cbc: a unary operator on an integer");
            V { .c = sprintf("((%s)(~%s))", c_int_type(*i), &t), .ty = clone(&vty), .obj = None }
        },
        Type::TF32    : V { .c = sprintf("(-%s)", &t), .ty = clone(&vty), .obj = None },
        Type::TF64    : V { .c = sprintf("(-%s)", &t), .ty = clone(&vty), .obj = None },
        Type::TBool   : V { .c = sprintf("((uint8_t)!%s)", &t), .ty = Type::TBool, .obj = None },
        _             :
        {
            assert(false, "cbc: a unary operator on this type, not ported yet");
            unit()
        },
    }
}

export fn lower_return(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Option<Box<Expr>>, shared> r) : V
{
    Type ret = clone(&x.ret);
    V v = match (r)
    {
        Some(e) :
        {
            // D-0200: a `__raw` form returning a local named alone
            // (`raw_return_path`).
            x.raw_return_path = (x.raw_ret || g.decided) && match (&strip_parens(Box::get(e)).kind)
            {
                ExprKind::EPath(_) : true,
                _                  : false,
            };
            // D-0286: a call's result returned with no object.
            arm_inert(g, x, Box::get(e), true);
            // D-0294: a literal returned in a decided program gets none
            // either (as a block's tail, `lower_block_body`).
            x.objectless = g.decided && (literal_expr(g, x, Box::get(e)) || box_new_expr(g, x, Box::get(e)));
            V rv = lower_expr(g, x, Box::get(e), Some(&ret));
            x.objectless = false;
            x.raw_return_path = false;
            x.inert_result = None;
            rv
        },
        None    : unit(),
    };
    if (is_never(&v.ty))
    {
        return never();
    }
    emit_return(g, x, v);
    never()
}

export fn lower_jump(ref<Gen, exclusive> g, ref<Fx, exclusive> x, bool brk) : V
{
    usize n = Vec::len(&x.loops);
    Loop l = clone(&x.loops[n - 1]);
    if (brk)
    {
        usize k = Vec::len(&x.loop_broken);
        if (k > 0)
        {
            x.loop_broken[k - 1] = true;
        }
    }
    emit_unwind_to(x, l.depth);
    if (brk)
    {
        emit(x, "break;");
    }
    else
    {
        match (&l.cont)
        {
            Some(label) : emit(x, &sprintf("goto %s;", label)),
            None        : emit(x, "continue;"),
        }
    }
    never()
}

export fn lower_user_call(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    StringView name,
    ref<FnDecl, shared> f,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    Option<ref<Type, shared>> expected,
    usize line
) : V
{
    lower_user_call_access(g, x, name, f, targs, args, expected, line, None)
}

export fn is_plain_elem(ref<Gen, shared> g, ref<Type, shared> t) : bool
{
    !is_resource(g, t) && !has_refs(g, t) && !holds_fn(g, t) && !is_closure(t)
}

// `e[k]` (`vec_index_call`): `[Index-Vec]` checks the borrow as an access to
// element `k` (D-0070), after `k` is evaluated, as `coby` does: a live slice
// of other elements is not in the way, the `Vec` borrowed whole is.
export fn lower_vec_index_pre(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    StringView name,
    ref<FnDecl, shared> f,
    ref<Vec<Expr>, shared> args,
    usize line,
    Option<bool> access,
) : Option<V>
{
    if (name != "std::Vec::index_shared" && name != "std::Vec::index_exclusive")
    {
        return None;
    }
    if (!in_prelude(name, f) || Vec::len(args) != 2)
    {
        return None;
    }
    ref<Expr, shared> a0 = &args[0];
    ref<Expr, shared> a1 = &args[1];
    ref<BorrowExpr, shared> bw = match (&a0.kind)
    {
        ExprKind::EBorrow(b) : Box::get(b),
        _                    : return None,
    };
    // `e[k]` (`vec_index_call`): `[Index-Vec]` checks the borrow as an
    // access to element `k`, after `k` is evaluated. Otherwise the index is
    // evaluated after the borrow's check here, where the ordinary call makes
    // the read check after it: only an index that cannot change the
    // runtime's state keeps the two in agreement (stage 3).
    bool sugar = HashSet::contains(&x.index_sugar, a0.id);
    bool stateless_i = !boot(g, 3) && stateless(g, x, a1);
    if (!stateless_i && !sugar)
    {
        return None;
    }
    // D-0103: a `Vec` that is part of a temporary argument.
    x.temp_root = HashSet::contains(&g.prog.facts.temp_borrows, a0.id);
    P p = lower_place(g, x, &bw.e);
    x.temp_root = false;
    String base = match (&p.base)
    {
        Some(b) : String::clone(b),
        None    : return None,
    };
    Type elem = match (&p.ty)
    {
        Type::TNamed(n) :
        {
            if (Box::get(n).name != "std::Vec" || Vec::len(&Box::get(n).args) != 1)
            {
                return None;
            }
            clone(&Box::get(n).args[0])
        },
        _               : return None,
    };
    String lc0 = loc(g, x.std_body, a0.line);
    str m = if (bw.mode == Mode::Exclusive) { "CB_EXCLUSIVE" } else { "CB_SHARED" };
    // CHG-0237: a shared borrow of a place in a frozen parameter: its
    // dispatcher found the path valid and no exclusive path overlapping it, and
    // nothing the call does can form one or end the path, so neither the
    // borrow's check nor the place's validity can fail.
    bool frozen = bw.mode == Mode::Shared && frozen_root(g, x, &bw.e);
    if (frozen)
    {
    }
    else if (!sugar)
    {
        emit(x, &sprintf("cb_borrow_check(%s, %s, %s, %s);", &base, &projs_args(&p.projs), m, &lc0));
    }
    else if (!stateless_i)
    {
        // The index may read `$` or run code: the place is valid first.
        emit(x, &sprintf("cb_valid(%s, %s);", &base, &lc0));
    }
    V i = lower_index_arg(g, x, sprintf("(%s).len", &p.c), a1);
    if (is_never(&i.ty))
    {
        return Some(never());
    }
    V it = into_temp(g, x, i, a1.line);
    if (sugar && !frozen)
    {
        Vec<String> projs = clone(&p.projs);
        Vec::push(&mut projs, sprintf("{ CB_INDEX, %s }", &it.c));
        emit(x, &sprintf("cb_borrow_check(%s, %s, %s, %s);", &base, &projs_args(&projs), m, &lc0));
    }
    Vec<Type> ta = Vec::new();
    Vec::push(&mut ta, clone(&elem));
    String pre_cname = request_fn(g, name, ta);
    bool exclusive = name == "std::Vec::index_exclusive";
    str rm = if (exclusive) { "CB_EXCLUSIVE" } else { "CB_SHARED" };
    match (access)
    {
        Some(write) :
        {
            // A reader's shared element read (`elem_reader`): the same.
            bool reader_read = x.elem_reader && !write && !exclusive && !has_refs(
                g,
                &elem,
            ) && !holds_fn(g, &elem) && !is_closure(&elem) && !is_ref_type(&elem);
            if (is_plain_elem(g, &elem) || reader_read)
            {
                // The `…_pre` body inline, then the access's checks in one call.
                String rms = elem_rm(x, rm);
                String vec_c = ctype(g, &p.ty);
                String elem_c = ctype(g, &elem);
                u32 tid = type_id(g, &elem);
                String v = fresh(g, "v");
                String e = fresh(g, "e");
                at(g, x, line);
                emit(x, &sprintf("%s *%s = (%s *)&(%s);", &vec_c, &v, &vec_c, &p.c));
                emit(
                    x,
                    &sprintf(
                        "if (%s >= %s->len) cb_fault(\"diag.index-out-of-bounds\", %s);",
                        &it.c,
                        &v,
                        &loc(g, x.std_body, line),
                    ),
                );
                emit(x, &sprintf("%s *%s = %s->ptr + (int64_t)%s;", &elem_c, &e, &v, &it.c));
                String lc = loc(g, x.std_body, line);
                emit(
                    x,
                    &sprintf(
                        "cb_elem_access(%s, sizeof(*%s), %vu, %s, %v, %s);",
                        &e,
                        &e,
                        tid,
                        &rms,
                        if (write) { 1 } else { 0 },
                        &lc,
                    ),
                );
                return Some(V { .c = e, .ty = elem, .obj = None });
            }
        },
        None        : {},
    }
    String r = fresh(g, "r");
    Mode rmode = if (exclusive) { Mode::Exclusive } else { Mode::Shared };
    if (!boot(g, 5))
    {
        emit(
            x,
            &sprintf(
                "cb_ref %s = %s_pre(((cb_ref){ (void *)&(%s), 0 }), %s);",
                &r,
                &pre_cname,
                &p.c,
                &it.c,
            ),
        );
        return Some(V { .c = r, .ty = Type::TRef(Box::new(ModedTy { .inner = elem, .mode = rmode })), .obj = None });
    }
    // D-0274: no native bodies, so no `…_pre` variant: its body inline.
    String vec_c = ctype(g, &p.ty);
    String elem_c = ctype(g, &elem);
    u32 tid = type_id(g, &elem);
    String v = fresh(g, "v");
    String e = fresh(g, "e");
    at(g, x, line);
    emit(x, &sprintf("%s *%s = (%s *)&(%s);", &vec_c, &v, &vec_c, &p.c));
    emit(
        x,
        &sprintf("if (%s >= %s->len) cb_fault(\"diag.index-out-of-bounds\", %s);", &it.c, &v, &loc(g, x.std_body, line)),
    );
    emit(x, &sprintf("%s *%s = %s->ptr + (int64_t)%s;", &elem_c, &e, &v, &it.c));
    emit(
        x,
        &sprintf(
            "cb_ref %s = (cb_ref){ (void *)%s, cb_elem_borrow_here(%s, %vu, %s) };",
            &r,
            &e,
            &e,
            tid,
            rm,
        ),
    );
    Some(V { .c = r, .ty = Type::TRef(Box::new(ModedTy { .inner = elem, .mode = rmode })), .obj = None })
}

// `*Vec::index_*(r, i)` read or written at once, for a plain element type
// (`native_elem_access`): the body's checks inline, the element's address,
// and the access's check.
export fn native_elem_access(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    StringView name,
    ref<FnDecl, shared> f,
    ref<Vec<Type>, shared> inst,
    ref<Vec<V>, shared> argv,
    bool write,
    usize line,
) : Option<V>
{
    bool exclusive = name == "std::Vec::index_exclusive";
    if (!exclusive && name != "std::Vec::index_shared")
    {
        return None;
    }
    str rm = if (exclusive) { "CB_EXCLUSIVE" } else { "CB_SHARED" };
    String rms = elem_rm(x, rm);
    if (Vec::len(inst) != 1 || Vec::len(argv) != 2 || !in_prelude(name, f))
    {
        return None;
    }
    ref<Type, shared> elem = &inst[0];
    if (!is_plain_elem(g, elem))
    {
        return None;
    }
    Vec<Type> va = Vec::new();
    Vec::push(&mut va, clone(elem));
    String vec_c = ctype(g, &Type::TNamed(Box::new(NamedTy { .name = "std::Vec", .args = va })));
    String elem_c = ctype(g, elem);
    u32 tid = type_id(g, elem);
    String v = fresh(g, "v");
    String e = fresh(g, "e");
    at(g, x, line);
    ref<V, shared> r = &argv[0];
    ref<V, shared> i = &argv[1];
    emit(x, &sprintf("cb_read(%s.tok, (cb_proj[]){ { CB_FIELD, 1u } }, 1, CB_NOLOC, 0);", &r.c));
    emit(x, &sprintf("%s *%s = (%s *)%s.p;", &vec_c, &v, &vec_c, &r.c));
    emit(
        x,
        &sprintf("if (%s >= %s->len) cb_fault(\"diag.index-out-of-bounds\", %s);", &i.c, &v, &loc(g, x.std_body, line)),
    );
    // D-0222: element i taken exclusively through `v`.
    if (exclusive)
    {
        Vec<Type> va2 = Vec::new();
        Vec::push(&mut va2, clone(elem));
        u32 vtid = type_id(g, &Type::TNamed(Box::new(NamedTy { .name = "std::Vec", .args = va2 })));
        emit(
            x,
            &sprintf(
                "cb_borrow_range_unminted(%s.tok, %s.p, %vu, NULL, 0, %s, %s + 1, CB_EXCLUSIVE, CB_NOLOC, 0);",
                &r.c,
                &r.c,
                vtid,
                &i.c,
                &i.c,
            ),
        );
    }
    emit(x, &sprintf("%s *%s = %s->ptr + (int64_t)%s;", &elem_c, &e, &v, &i.c));
    String lc = loc(g, x.std_body, line);
    emit(
        x,
        &sprintf(
            "cb_elem_access(%s, sizeof(*%s), %vu, %s, %v, %s);",
            &e,
            &e,
            tid,
            &rms,
            if (write) { 1 } else { 0 },
            &lc,
        ),
    );
    Some(V { .c = e, .ty = clone(elem), .obj = None })
}

export fn join_segs(ref<Vec<String>, shared> segs) : String
{
    String::join(segs, "::")
}

// A static, or an addressed constant called with no arguments (D-0258).
// D-0258: the operand of a borrow that names a static or an addressed
// constant: the global's address with token 0, a shared reference.
export fn global_borrow(ref<Gen, exclusive> g, ref<Fx, shared> x, ref<Expr, shared> inner) : Option<V>
{
    ref<Expr, shared> e = strip_parens(inner);
    match (&e.kind)
    {
        ExprKind::EPath(p) :
        {
            String key = join_segs(&Box::get(p).segs);
            if (HashMap::contains(&g.prog.table.statics, &key))
            {
                StaticDecl decl = clone(Option::unwrap(HashMap::get(&g.prog.table.statics, &key)));
                String cname = sprintf("g_%s", &san(&key));
                // Not while probing: the probe's buffers are discarded.
                if (x.probing == 0 && HashSet::insert(&mut g.globals, String::clone(&cname)))
                {
                    String ct = ctype(g, &decl.ty);
                    String init = static_init(&decl);
                    String::appendf(&mut g.strings, "static %s %s = %s;\n", &ct, &cname, &init);
                }
                return Some(V { .c = sprintf(
                    "((cb_ref){ (void *)&%s, 0 })",
                    &cname,
                ), .ty = ref_ty(clone(&decl.ty), Mode::Shared), .obj = None });
            }
        },
        ExprKind::ECall(c) :
        {
            match (&Box::get(c).callee.kind)
            {
                ExprKind::EPath(p) :
                {
                    String key = join_segs(&Box::get(p).segs);
                    if (Vec::len(&Box::get(c).args) == 0 && HashSet::contains(&g.prog.facts.const_addrs, &key))
                    {
                        FnDecl f = Option::expect(get_fn(g, &key), "cobc: a borrow of an unknown constant");
                        String cname = sprintf("k_%s", &san(&key));
                        if (x.probing == 0 && HashSet::insert(&mut g.globals, String::clone(&cname)))
                        {
                            String ct = ctype(g, &f.ret);
                            String lit = match (&f.body.tail)
                            {
                                Some(t) : c_literal(g, Box::get(t), &f.ret),
                                None    :
                                {
                                    assert(false, "cobc: a constant without a value");
                                    String::new()
                                },
                            };
                            String::appendf(&mut g.strings, "static const %s %s = %s;\n", &ct, &cname, &lit);
                        }
                        return Some(V { .c = sprintf(
                            "((cb_ref){ (void *)&%s, 0 })",
                            &cname,
                        ), .ty = ref_ty(clone(&f.ret), Mode::Shared), .obj = None });
                    }
                },
                _                  : {},
            }
        },
        _                  : {},
    }
    None
}

// An atomic's initializer: `Atomic<T> { .atomic_value = v }`, or
// `AtomicBool { .atomic_flag = Atomic<u8> { .atomic_value = 0 or 1 } }`.
export fn static_init(ref<StaticDecl, shared> decl) : String
{
    u128 zero = 0;
    u128 v = match (&decl.init.kind)
    {
        ExprKind::EInt(l)  : Box::get(l).v,
        ExprKind::EBool(b) : if (*b) { 1 } else { 0 },
        ExprKind::EUnary(u) : match (&Box::get(u).e.kind)
        {
            ExprKind::EInt(l) : wrapping_sub(zero, Box::get(l).v),
            _                 :
            {
                assert(false, "cobc: a static's initializer");
                0
            },
        },
        _                  :
        {
            assert(false, "cobc: a static's initializer");
            0
        },
    };
    match (&decl.ty)
    {
        Type::TNamed(n) :
        {
            if (Box::get(n).name == "std::Atomic")
            {
                match (&Box::get(n).args[0])
                {
                    Type::TInt(it) : return sprintf("{ %s }", &c_int(*it, v)),
                    _              : assert(false, "cobc: a static's lane type"),
                }
            }
            if (Box::get(n).name == "std::AtomicBool")
            {
                return sprintf("{ { %s } }", &c_int(IntTy::U8, v));
            }
        },
        _               : {},
    }
    assert(false, "cobc: a static's type");
    String::new()
}

// A literal tree as a C initializer of `ty`: numbers and `bool` as scalars
// of their C type, an array as its struct's `a` member, a struct by
// designated fields.
export fn c_literal(ref<Gen, exclusive> g, ref<Expr, shared> e, ref<Type, shared> ty) : String
{
    match (&e.kind)
    {
        ExprKind::EParen(i)       : return c_literal(g, Box::get(i), ty),
        ExprKind::EInt(l)         :
        {
            match (ty)
            {
                Type::TInt(it) : return c_int(*it, Box::get(l).v),
                Type::TF32     : return sprintf("%v.0f", Box::get(l).v),
                Type::TF64     : return sprintf("%v.0", Box::get(l).v),
                _              : {},
            }
        },
        ExprKind::EFloat(fl)      :
        {
            match (ty)
            {
                Type::TF32 : return sprintf("%sf", &c_float_exp(Box::get(fl).v)),
                Type::TF64 : return c_float_exp(Box::get(fl).v),
                _          : {},
            }
        },
        ExprKind::EBool(b)        :
        {
            match (ty)
            {
                Type::TBool : return if (*b) { "1" } else { "0" },
                _           : {},
            }
        },
        ExprKind::EUnary(u)       :
        {
            if (Box::get(u).op == UnOp::Neg)
            {
                return sprintf("(-%s)", &c_literal(g, &Box::get(u).e, ty));
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            match (ty)
            {
                Type::TArray(a) :
                {
                    Vec<String> parts = Vec::new();
                    foreach (x in es)
                    {
                        Vec::push(&mut parts, c_literal(g, x, &Box::get(a).inner));
                    }
                    return sprintf("{ { %s } }", &String::join(&parts, ", "));
                },
                _               : {},
            }
        },
        ExprKind::EArrayRepeat(r) :
        {
            match (ty)
            {
                Type::TArray(a) :
                {
                    String one = c_literal(g, &Box::get(r).value, &Box::get(a).inner);
                    Vec<String> parts = Vec::new();
                    u128 k = 0;
                    while (k < Box::get(r).n)
                    {
                        Vec::push(&mut parts, String::clone(&one));
                        k += 1;
                    }
                    return sprintf("{ { %s } }", &String::join(&parts, ", "));
                },
                _               : {},
            }
        },
        ExprKind::EStructLit(sl)  :
        {
            match (ty)
            {
                Type::TNamed(n) :
                {
                    StructDecl decl = Option::expect(
                        struct_decl(g, &Box::get(n).name),
                        "cobc: a constant's struct type",
                    );
                    HashMap<String, Type> sub = subst_of(&decl.type_params, &Box::get(n).args);
                    Vec<String> parts = Vec::new();
                    foreach (fd in &decl.fields)
                    {
                        usize k = 0;
                        while (k < Vec::len(&Box::get(sl).fields) && Box::get(sl).fields[k].name != fd.name)
                        {
                            k += 1;
                        }
                        assert(k < Vec::len(&Box::get(sl).fields), "cobc: a constant's struct literal misses a field");
                        Type ft = apply(&fd.ty, &sub);
                        Vec::push(
                            &mut parts,
                            sprintf(
                                ".%s = %s",
                                &san(&fd.name),
                                &c_literal(g, &Box::get(sl).fields[k].value, &ft),
                            ),
                        );
                    }
                    return sprintf("{ %s }", &String::join(&parts, ", "));
                },
                _               : {},
            }
        },
        _                         : {},
    }
    assert(false, "cobc: a constant's literal");
    String::new()
}

// D-0194's quiet write with no path (`cb_write_quiet(0, …)`), which
// destroys the old value only where it owns something. An enum's variants
// with no payload, or a plain one, own nothing (`owns` reads the tag), so
// for those the call is skipped inline: a node's `n.left = Some(…)` over a
// `None` makes no runtime call. An owner enum owns in every variant and is
// always asked.
fn quiet_write_pathless(
    ref<Gen, exclusive> g,
    ref<String, shared> c,
    ref<Type, shared> ty,
    u32 tid,
    ref<String, shared> lc,
) : String
{
    // D-0315: in a decided program, the old value ended by its drop glue
    // (`drop_glue`), which asks of each buffer whether an object lies over it
    // (CHG-0427).
    match (drop_glue(g, ty))
    {
        Some(gl) : return sprintf("%s((void *)&(%s), 0u);", &gl, c),
        None     : {},
    }
    String call = sprintf("cb_write_quiet(0, NULL, 0, (void *)&(%s), %vu, %s);", c, tid, lc);
    match (ty)
    {
        Type::TNamed(n) :
        {
            match (HashMap::get(&g.prog.table.enums, &Box::get(n).name))
            {
                Some(ed) :
                {
                    if (type_is_owner(&g.prog.table, &Box::get(n).name))
                    {
                        return call;
                    }
                    HashMap<String, Type> sub = subst_of(&ed.type_params, &Box::get(n).args);
                    Vec<String> tests = Vec::new();
                    for (usize i = 0; i < Vec::len(&ed.variants); i += 1)
                    {
                        bool idle = match (&ed.variants[i].payload)
                        {
                            Some(p) : !is_resource(g, &apply(p, &sub)),
                            None    : true,
                        };
                        if (idle)
                        {
                            Vec::push(&mut tests, sprintf("!(%s)", &tag_is(g, ty, c, i)));
                        }
                    }
                    if (Vec::len(&tests) == 0 || Vec::len(&tests) == Vec::len(&ed.variants))
                    {
                        return call;
                    }
                    sprintf("if (%s) %s", &String::join(&tests, " && "), &call)
                },
                None     : call,
            }
        },
        _               : call,
    }
}

export fn is_global(ref<Gen, shared> g, ref<Expr, shared> inner) : bool
{
    ref<Expr, shared> e = strip_parens(inner);
    match (&e.kind)
    {
        ExprKind::EPath(p) : HashMap::contains(&g.prog.table.statics, &join_segs(&Box::get(p).segs)),
        ExprKind::ECall(c) :
        {
            match (&Box::get(c).callee.kind)
            {
                ExprKind::EPath(p) : Vec::len(&Box::get(c).args) == 0 && HashSet::contains(
                    &g.prog.facts.const_addrs,
                    &join_segs(&Box::get(p).segs),
                ),
                _ : false,
            }
        },
        _                  : false,
    }
}

export fn is_place_syntax(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EPath(p)  : Vec::len(&Box::get(p).segs) == 1,
        ExprKind::EDeref(_) : true,
        ExprKind::EField(f) : is_place_syntax(&Box::get(f).e),
        ExprKind::EIndex(p) : is_place_syntax(&Box::get(p).a),
        ExprKind::EParen(i) : is_place_syntax(Box::get(i)),
        _                   : false,
    }
}

export fn mode_c(Mode m) : str
{
    if (m == Mode::Exclusive) { "CB_EXCLUSIVE" } else { "CB_SHARED" }
}

export fn ref_ty(Type inner, Mode m) : Type
{
    Type::TRef(Box::new(ModedTy { .inner = inner, .mode = m }))
}

// `&e` / `&mut e`.
export fn lower_borrow(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> e,
    Mode mode,
    ref<Expr, shared> inner,
    Option<ref<Type, shared>> expected,
) : V
{
    // D-0073: a temporary borrowed as a call's argument: the value is an
    // object of this statement, borrowed from its root path.
    bool path_or_paren = match (&inner.kind)
    {
        ExprKind::EPath(_)  : true,
        ExprKind::EParen(_) : true,
        _                   : false,
    };
    if ((is_temp_value(inner) || (path_or_paren && HashSet::contains(
        &g.prog.facts.temp_borrows,
        e.id,
    ))) && !is_global(g, inner))
    {
        // D-0084: a borrowed literal takes the referent type expected.
        Option<Type> pointee = match (expected)
        {
            Some(t) :
            {
                match (t)
                {
                    Type::TRef(m) : Some(clone(&Box::get(m).inner)),
                    _             : None,
                }
            },
            None    : None,
        };
        // D-0315: nothing is evaluated between a call borrowed here and its
        // borrow: its result is taken with no object.
        Option<InertResult> outer_inert = replace(&mut x.inert_result, None);
        arm_inert(g, x, inner, true);
        V v0 = match (&pointee)
        {
            Some(t) : lower_expr(g, x, inner, Some(t)),
            None    : lower_expr(g, x, inner, None),
        };
        x.inert_result = outer_inert;
        if (is_never(&v0.ty))
        {
            return never();
        }
        V v = into_temp(g, x, v0, e.line);
        // A decided program's temporary of plain data with no object (D-0285,
        // D-0294): no check reads a path to it and its end destroys nothing,
        // so the borrow is its address, token 0.
        if (g.decided && Option::is_none(&v.obj) && plain_data(g, &v.ty))
        {
            return V { .c = sprintf("((cb_ref){ (void *)&(%s), 0 })", &v.c), .ty = ref_ty(clone(&v.ty), mode), .obj = None };
        }
        // D-0315: one whose end frees memory alone, the statement's own: no
        // check reads a path to it, and the statement's end drops it in the C.
        if (g.decided && x.probing == 0 && is_resource(g, &v.ty) && !has_refs(g, &v.ty) && objectless_type(g, &v.ty) && (Option::is_some(&v.obj) || HashSet::contains(&x.inert_c, &v.c)))
        {
            u32 tid = type_id(g, &v.ty);
            if (stmt_temp_drop(g, x, &v.c, tid, &v.ty, false))
            {
                match (&v.obj)
                {
                    Some(o) : emit(x, &sprintf("cb_forget_obj(%s);", o)),
                    None    : {},
                }
                return V { .c = sprintf("((cb_ref){ (void *)&(%s), 0 })", &v.c), .ty = ref_ty(clone(&v.ty), mode), .obj = None };
            }
        }
        String lc = loc(g, x.std_body, e.line);
        String o = match (&v.obj)
        {
            Some(o) : String::clone(o),
            None    :
            {
                u32 tid = type_id(g, &v.ty);
                String o = fresh(g, "o");
                emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &v.c, tid, &lc));
                o
            },
        };
        String root = fresh(g, "root");
        emit(x, &sprintf("uint64_t %s = cb_temp_path(%s);", &root, &o));
        String tok = fresh(g, "tok");
        emit(
            x,
            &sprintf("uint64_t %s = cb_borrow(%s, NULL, 0, %s, %s);", &tok, &root, mode_c(mode), &lc),
        );
        return V { .c = sprintf(
            "((cb_ref){ (void *)&(%s), %s })",
            &v.c,
            &tok,
        ), .ty = ref_ty(clone(&v.ty), mode), .obj = None };
    }
    // `&s` / `&mut s` of an objectless local (`objectless_strings`): its
    // address with token 0 (every check proven).
    match (path_name_raw(inner))
    {
        Some(n) :
        {
            match (lookup(x, &n))
            {
                Some(b) :
                {
                    if (HashSet::contains(&x.objectless_c, &b.c))
                    {
                        objectless_use(g, x, &b.c, e.line);
                        return V { .c = sprintf(
                            "((cb_ref){ (void *)&(%s), 0 })",
                            &b.c,
                        ), .ty = ref_ty(clone(&b.ty), mode), .obj = None };
                    }
                },
                None    : {},
            }
        },
        None    : {},
    }
    // D-0258: `&NAME` of a static, `&K` of an addressed constant: a C
    // global's address with token 0.
    match (global_borrow(g, x, inner))
    {
        Some(gv) : return gv,
        None     : {},
    }
    x.place_write = mode == Mode::Exclusive;
    // D-0103: part of a temporary, as a call's argument: its root becomes an
    // object of this statement.
    x.temp_root = HashSet::contains(&g.prog.facts.temp_borrows, e.id);
    P p = lower_place(g, x, inner);
    x.temp_root = false;
    x.place_write = false;
    // The compound pair's `&mut v[i]` on a confined vector (`compound_elem`):
    // the element's address, its bounds checked.
    if (x.compound_elem && Option::is_none(&p.base) && Option::is_none(&p.raw) && !p.is_binding && !is_never(&p.ty))
    {
        String ad = fresh(g, "ad");
        emit(x, &sprintf("void *%s = (void *)&(%s);", &ad, &p.c));
        return V { .c = sprintf("((cb_ref){ %s, 0 })", &ad), .ty = ref_ty(clone(&p.ty), mode), .obj = None };
    }
    // D-0286: a field of an objectless local (a decided program's,
    // `objectless_strings_with`): its address, token 0.
    if (Option::is_none(&p.base) && Option::is_none(&p.raw) && !is_never(&p.ty) && (objectless_root(x, inner) || (g.decided && objectless_root_through(
        x,
        inner,
    ))))
    {
        return V { .c = sprintf(
            "((cb_ref){ (void *)&(%s), 0 })",
            &p.c,
        ), .ty = ref_ty(clone(&p.ty), mode), .obj = None };
    }
    // A decided program's `&x` of a whole plain local that shared borrows
    // alone pinned (`whole_plain_borrow`): its address.
    if (whole_plain_borrow(g, &mode, inner, &p))
    {
        return V { .c = sprintf(
            "((cb_ref){ (void *)&(%s), 0 })",
            &p.c,
        ), .ty = ref_ty(clone(&p.ty), mode), .obj = None };
    }
    // A shared borrow of a place the lowering reaches with no path, every
    // access to it proven: in a predicate body (D-0192), or a part of a
    // `foreach` read alias's element (`foreach_alias`). Its address, token 0
    // (cobc's; session findings 006-A3, 007-A2).
    bool shared_mode = match (&mode)
    {
        Mode::Shared    : true,
        Mode::Exclusive : false,
    };
    if (Option::is_none(&p.base) && Option::is_none(&p.raw) && shared_mode && !is_never(&p.ty) && (x.pred_body || alias_rooted(x, inner)))
    {
        return V { .c = sprintf(
            "((cb_ref){ (void *)&(%s), 0 })",
            &p.c,
        ), .ty = ref_ty(clone(&p.ty), mode), .obj = None };
    }
    String base = match (&p.base)
    {
        Some(b) : String::clone(b),
        None    :
        {
            // In a probe, cobc's internal error: the probe fails.
            if (x.probing > 0)
            {
                x.probe_failed = true;
                return unit();
            }
            eprintf("cbc: borrow of a temporary (line %v, `%s`)\n", e.line, &p.c);
            assert(false, "cobc: borrow of a temporary");
            return unit();
        },
    };
    // `&*f(…)` with `f` returning a reference of the borrow's mode, and
    // `&v[i]` on a `Vec`: the path just formed is the result.
    bool tok_base = Vec::len(&p.projs) == 0 && Option::is_none(&p.raw) && StringView::ends_with(
        &base,
        ".tok",
    ) && !p.is_binding;
    match (&strip_parens(inner).kind)
    {
        ExprKind::EDeref(dx) :
        {
            bool is_call = match (&strip_parens(Box::get(dx)).kind)
            {
                ExprKind::ECall(_) : true,
                _                  : false,
            };
            if (is_call && tok_base)
            {
                match (probe_type(g, x, Box::get(dx), None))
                {
                    Type::TRef(rm) :
                    {
                        if (Box::get(&rm).mode == mode)
                        {
                            return V { .c = sprintf(
                                "((cb_ref){ (void *)&(%s), %s })",
                                &p.c,
                                &base,
                            ), .ty = ref_ty(clone(&p.ty), mode), .obj = None };
                        }
                    },
                    _              : {},
                }
            }
        },
        ExprKind::EIndex(ix) :
        {
            if (tok_base)
            {
                Type bt = probe_place_type(g, x, &Box::get(ix).a);
                Type t = match (bt)
                {
                    Type::TRef(m) : clone(&Box::get(&m).inner),
                    other         : other,
                };
                match (&t)
                {
                    Type::TNamed(n) :
                    {
                        if (Box::get(n).name == "std::Vec")
                        {
                            return V { .c = sprintf(
                                "((cb_ref){ (void *)&(%s), %s })",
                                &p.c,
                                &base,
                            ), .ty = ref_ty(clone(&p.ty), mode), .obj = None };
                        }
                    },
                    _               : {},
                }
            }
        },
        _                    : {},
    }
    String lc = loc(g, x.std_body, e.line);
    String tok = fresh(g, "tok");
    emit(
        x,
        &sprintf(
            "uint64_t %s = cb_borrow(%s, %s, %s, %s);",
            &tok,
            &base,
            &projs_args(&p.projs),
            mode_c(mode),
            &lc,
        ),
    );
    V { .c = sprintf("((cb_ref){ (void *)&(%s), %s })", &p.c, &tok), .ty = ref_ty(clone(&p.ty), mode), .obj = None }
}

// A binary expression: a view or text operation the checker recorded
// (D-0053, D-0108), else the operator.
export fn lower_binary_expr(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> e,
    BinOp op,
    ref<Expr, shared> l,
    ref<Expr, shared> r,
    Option<ref<Type, shared>> expected,
) : V
{
    match (HashMap::get(&g.prog.facts.view_ops, e.id))
    {
        Some(vo) :
        {
            ViewOp v = clone(vo);
            return lower_view_cmp(g, x, e, v, op, l, r);
        },
        None     : {},
    }
    x.proven_next = HashSet::contains(&x.no_overflow, e.id);
    lower_binary(g, x, op, l, r, expected, e.line)
}

export fn cmp_sym(BinOp op) : str
{
    match (op)
    {
        BinOp::Eq : "==",
        BinOp::Ne : "!=",
        BinOp::Lt : "<",
        BinOp::Le : "<=",
        BinOp::Gt : ">",
        _         : ">=",
    }
}

export fn is_named(ref<Type, shared> t, str name) : bool
{
    match (t)
    {
        Type::TNamed(n) : Box::get(n).name == name,
        _               : false,
    }
}

export fn lower_view_cmp(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> e,
    ViewOp vo,
    BinOp op,
    ref<Expr, shared> a,
    ref<Expr, shared> b,
) : V
{
    usize line = e.line;
    match (vo)
    {
        ViewOp::VEq(q)   :
        {
            V va0 = lower_expr(g, x, a, None);
            V va = into_temp(g, x, va0, line);
            V vb0 = lower_expr(g, x, b, None);
            V vb = into_temp(g, x, vb0, line);
            Vec<V> vs = Vec::new();
            if (q.view_left)
            {
                Vec::push(&mut vs, va);
                Vec::push(&mut vs, vb);
            }
            else
            {
                Vec::push(&mut vs, vb);
                Vec::push(&mut vs, va);
            }
            str name = if (q.other_is_str) { "std::StringView::same_str" } else { "std::StringView::eq" };
            V res = call_std_values(g, x, name, &vs, line);
            if (q.negate)
            {
                return V { .c = sprintf("((uint8_t)!(%s))", &res.c), .ty = Type::TBool, .obj = None };
            }
            res
        },
        ViewOp::VLess(q) :
        {
            V va0 = lower_expr(g, x, a, None);
            V va = into_temp(g, x, va0, line);
            V vb0 = lower_expr(g, x, b, None);
            V vb = into_temp(g, x, vb0, line);
            Vec<V> vs = Vec::new();
            if (q.swap)
            {
                Vec::push(&mut vs, vb);
                Vec::push(&mut vs, va);
            }
            else
            {
                Vec::push(&mut vs, va);
                Vec::push(&mut vs, vb);
            }
            V res = call_std_values(g, x, "std::StringView::less", &vs, line);
            if (q.negate)
            {
                return V { .c = sprintf("((uint8_t)!(%s))", &res.c), .ty = Type::TBool, .obj = None };
            }
            res
        },
        ViewOp::TextCmp  :
        {
            // Another instantiation of a generic body: not text.
            Type lt = if (is_place_syntax(a)) { probe_place_type(g, x, a) } else { probe_type(g, x, a, None) };
            if (!is_named(&lt, "std::String"))
            {
                return lower_binary(g, x, op, a, b, None, line);
            }
            String xs = lower_text_operand(g, x, a, line);
            String ys = lower_text_operand(g, x, b, line);
            V { .c = sprintf(
                "((uint8_t)(cb_bytes_cmp(%s, %s) %s 0))",
                &xs,
                &ys,
                cmp_sym(op),
            ), .ty = Type::TBool, .obj = None }
        },
        ViewOp::KeyCmp   :
        {
            // The type is the operand's that is not a variant with nothing
            // to fix its type arguments (`f(0) == Err(Bad)`, `None == o`),
            // which then takes it (session finding 001-A3).
            ref<Expr, shared> typed = if (is_untyped_variant(g, x, a) && !is_untyped_variant(g, x, b)) { b } else { a };
            Type lt = if (is_place_syntax(typed)) { probe_place_type(g, x, typed) } else { probe_type(g, x, typed, None) };
            if (is_named(&lt, "std::String"))
            {
                String xs = lower_text_operand(g, x, a, line);
                String ys = lower_text_operand(g, x, b, line);
                return V { .c = sprintf(
                    "((uint8_t)(cb_bytes_cmp(%s, %s) %s 0))",
                    &xs,
                    &ys,
                    cmp_sym(op),
                ), .ty = Type::TBool, .obj = None };
            }
            bool named = match (&lt)
            {
                Type::TNamed(_) : true,
                _               : false,
            };
            if (!named || !is_key_type(&g.prog.table, &lt))
            {
                return lower_binary(g, x, op, a, b, None, line);
            }
            // A key type that is plain data has no object to borrow: it is
            // read as a value, as `[Eq-Struct]` reads it.
            bool res = is_resource(g, &lt);
            String xs = if (res)
            {
                lower_borrowed_operand_as(g, x, a, line, Some(&lt))
            }
            else
            {
                V v = lower_expr(g, x, a, Some(&lt));
                into_temp_c(g, x, v, line)
            };
            String ys = if (res)
            {
                lower_borrowed_operand_as(g, x, b, line, Some(&lt))
            }
            else
            {
                V v = lower_expr(g, x, b, Some(&lt));
                into_temp_c(g, x, v, line)
            };
            String c = if (op == BinOp::Eq || op == BinOp::Ne)
            {
                String e = eq_expr(g, &lt, &xs, &ys);
                if (op == BinOp::Eq) { e } else { sprintf("!%s", &e) }
            }
            else
            {
                String f = key_cmp_fn(g, &lt);
                sprintf("%s(&(%s), &(%s)) %s 0", &f, &xs, &ys, cmp_sym(op))
            };
            V { .c = sprintf("((uint8_t)(%s))", &c), .ty = Type::TBool, .obj = None }
        },
        _                :
        {
            assert(false, "cobc: a StringView operation of an unexpected shape");
            unit()
        },
    }
}

// D-0108 `[Cmp-Text]`: a `String` comparison operand as the C text `ptr,
// len` of its bytes.
export fn lower_text_operand(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e, usize line) : String
{
    String c = lower_borrowed_operand(g, x, e, line);
    sprintf("(const void *)(%s).bytes.ptr, (%s).bytes.len", &c, &c)
}

// A comparison operand read where it stands, as a C lvalue: a place is
// borrowed shared, as `&e` would be; a temporary lives to the statement's
// end. CHG-0363: a field of a call's reference result is a place through it
// (CHG-0367: an element too).
export fn lower_borrowed_operand(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> e, usize line) : String
{
    lower_borrowed_operand_as(g, x, e, line, None)
}

// As `lower_borrowed_operand`, a value lowered at `expected` (the other
// operand's type: a variant's type arguments, `Err(Bad)`'s `T`).
export fn lower_borrowed_operand_as(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> e,
    usize line,
    Option<ref<Type, shared>> expected,
) : String
{
    ref<Expr, shared> root = e;
    bool moved = false;
    while (true)
    {
        match (&root.kind)
        {
            ExprKind::EField(f)  :
            {
                root = &Box::get(f).e;
                moved = true;
            },
            // CHG-0367: an element through a call's reference result too.
            ExprKind::EIndex(ix) :
            {
                root = &Box::get(ix).a;
                moved = true;
            },
            ExprKind::EParen(i)  :
            {
                root = Box::get(i);
                moved = true;
            },
            _                    : break,
        }
    }
    bool through_ref = moved && !is_place_syntax(root) && match (probe_type(g, x, root, None))
    {
        Type::TRef(_) : true,
        _             : false,
    };
    // A payloadless variant (`None`) is a path, but a value, typed by
    // `expected`.
    if ((is_place_syntax(e) && !is_untyped_variant(g, x, e)) || through_ref)
    {
        String lc = loc(g, x.std_body, line);
        P p0 = lower_place(g, x, e);
        P p = auto_deref(g, x, p0);
        String tok = fresh(g, "tok");
        match (&p.base)
        {
            Some(b) : emit(
                x,
                &sprintf(
                    "uint64_t %s = cb_borrow(%s, %s, CB_SHARED, %s);",
                    &tok,
                    b,
                    &projs_args(&p.projs),
                    &lc,
                ),
            ),
            None :
            {
                // A place with no path (through a direct reference: D-0192's
                // predicate parameters) is read as it stands.
                if (Option::is_none(&p.raw) && x.pred_body)
                {
                    emit(x, &sprintf("uint64_t %s = 0;", &tok));
                }
                else if (Option::is_none(&p.raw) && p.is_binding && Vec::len(&p.projs) == 0 && HashSet::contains(
                    &x.objectless_c,
                    &p.c,
                ))
                {
                    // D-0200: an objectless local: its address, token 0.
                    objectless_use(g, x, &p.c, line);
                    emit(x, &sprintf("uint64_t %s = 0;", &tok));
                }
                else if (Option::is_none(&p.raw))
                {
                    // A place the lowering reaches with no path (an unchecked
                    // local, an element of a frozen or confined vector: every
                    // access to it proven), read as it stands, as `read_place`
                    // reads it: token 0.
                    emit(x, &sprintf("uint64_t %s = 0;", &tok));
                }
                else
                {
                    assert(false, "cobc: a compared String with no access path");
                }
            },
        }
        V r0 = V { .c = sprintf(
            "((cb_ref){ (void *)&(%s), %s })",
            &p.c,
            &tok,
        ), .ty = ref_ty(clone(&p.ty), Mode::Shared), .obj = None };
        V r = into_temp(g, x, r0, line);
        String c = ctype(g, &p.ty);
        return sprintf("(*((%s *)(%s).p))", &c, &r.c);
    }
    // CHG-0427: in a decided body, a call compared where it stands, of a type
    // whose end frees memory alone or one with a destructor of its own, is
    // taken with no object: the statement's own, dropped where it ends
    // (`stmt_temp_drop`). Where no statement of its own ends it, an object.
    bool is_call = match (&strip_parens(e).kind)
    {
        ExprKind::ECall(_) : true,
        _                  : false,
    };
    bool pre_arm = false;
    if (g.decided && x.probing == 0 && is_call)
    {
        Type st = probe_type(g, x, e, expected);
        pre_arm = is_resource(g, &st) && !has_refs(g, &st) && (objectless_type(g, &st) || noted_type(g, &st));
    }
    Option<InertResult> outer_inert = replace(&mut x.inert_result, None);
    if (pre_arm)
    {
        arm_inert(g, x, e, true);
    }
    V v0 = lower_expr(g, x, e, expected);
    x.inert_result = outer_inert;
    V v = into_temp(g, x, v0, line);
    if (pre_arm && is_resource(g, &v.ty) && !has_refs(g, &v.ty) && (Option::is_some(&v.obj) || HashSet::contains(&x.inert_c, &v.c)))
    {
        bool noted = !objectless_type(g, &v.ty) && noted_type(g, &v.ty);
        if (objectless_type(g, &v.ty) || noted)
        {
            u32 tid = type_id(g, &v.ty);
            if (stmt_temp_drop(g, x, &v.c, tid, &v.ty, noted))
            {
                match (&v.obj)
                {
                    Some(o) : emit(x, &sprintf("cb_forget_obj(%s);", o)),
                    None    : {},
                }
                return String::clone(&v.c);
            }
        }
    }
    if (pre_arm && Option::is_none(&v.obj))
    {
        v.obj = materialize(g, x, &v, line);
    }
    String::clone(&v.c)
}

export fn named_ty(str name) : Type
{
    Type::TNamed(Box::new(NamedTy { .name = String::copy(name), .args = Vec::new() }))
}

// `&m base[lo .. hi]`: a `String` or `StringView` view (D-0053), or a slice
// of an array, a `Vec` or a slice (D-0070).
export fn lower_slice_expr(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> e,
    ref<SliceExpr, shared> sl,
) : V
{
    usize line = e.line;
    bool temp = HashSet::contains(&g.prog.facts.temp_borrows, e.id);
    match (HashMap::get(&g.prog.facts.view_ops, e.id))
    {
        Some(vo) :
        {
            match (vo)
            {
                ViewOp::SliceString : return lower_slice_string(g, x, sl, temp, line),
                ViewOp::SliceView   :
                {
                    V v0 = lower_expr(g, x, &sl.base, None);
                    if (is_never(&v0.ty))
                    {
                        return never();
                    }
                    V v = into_temp(g, x, v0, line);
                    String len = sprintf("((%s).bytes.len)", &v.c);
                    Vec<V> vs = Vec::new();
                    Vec::push(&mut vs, v);
                    view_bounds(g, x, len, &sl.lo, &sl.hi, &mut vs);
                    return call_std_values(g, x, "std::StringView::part", &vs, line);
                },
                _                   : assert(false, "cobc: a slice with a comparison's view operation"),
            }
        },
        None     : {},
    }
    // D-0103: a temporary sliced as a call's argument.
    lower_slice_of_as(g, x, sl, temp, line, true)
}

// `&base[lo .. hi]` / `&mut base[lo .. hi]` (D-0047). `minted` false: for a
// pure direct slice parameter (`pure_direct`), the borrow's checks only, and a
// bare `{ data, len }`: no path, no tracked slot, no temporary object.
export fn lower_slice_of_as(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<SliceExpr, shared> sl,
    bool temp,
    usize line,
    bool minted,
) : V
{
    x.temp_root = temp;
    P pb0 = lower_place(g, x, &sl.base);
    x.temp_root = false;
    P pb = auto_deref(g, x, pb0);
    String lc = loc(g, x.std_body, line);
    str m = mode_c(sl.mode);
    Type elem = Type::TVoid;
    String len = String::new();
    String data = String::new();
    Option<String> parent = None;
    match (&pb.ty)
    {
        Type::TArray(a)  :
        {
            elem = clone(&Box::get(a).inner);
            len = sprintf("%vu", Box::get(a).n);
            data = sprintf("&(%s).a[0]", &pb.c);
        },
        Type::TNamed(n)  :
        {
            assert(
                Box::get(n).name == "std::Vec",
                "cobc: slice of something that is not an array, a Vec or a slice",
            );
            if (Vec::len(&Box::get(n).args) > 0)
            {
                elem = clone(&Box::get(n).args[0]);
            }
            len = sprintf("(%s).len", &pb.c);
            data = sprintf("(%s).ptr", &pb.c);
        },
        Type::TSlice(ms) :
        {
            elem = clone(&Box::get(ms).inner);
            String t0 = fresh(g, "tok");
            emit(x, &sprintf("uint64_t %s = cb_load_ref(&(%s).src);", &t0, &pb.c));
            len = sprintf("(%s).len", &pb.c);
            data = sprintf("(%s).data", &pb.c);
            parent = Some(t0);
        },
        _                : assert(false, "cobc: slice of something that is not an array, a Vec or a slice"),
    }
    String lenv = fresh(g, "len");
    emit(x, &sprintf("uint64_t %s = %s;", &lenv, &len));
    Vec::push(&mut x.dollar, String::clone(&lenv));
    Type ut = Type::TInt(IntTy::Usize);
    V a0 = lower_expr(g, x, &sl.lo, Some(&ut));
    V b0 = lower_expr(g, x, &sl.hi, Some(&ut));
    Vec::pop(&mut x.dollar);
    V at = into_temp(g, x, a0, line);
    V bt = into_temp(g, x, b0, line);
    emit(
        x,
        &sprintf(
            "if ((uint64_t)%s > (uint64_t)%s || (uint64_t)%s > %s) cb_fault(\"diag.index-out-of-bounds\", %s);",
            &at.c,
            &bt.c,
            &bt.c,
            &lenv,
            &lc,
        ),
    );
    // D-0292: the container's place and type, for a light base.
    u32 ptid = type_id(g, &pb.ty);
    // D-0294: a slice of an objectless local in a decided program: the bounds
    // above, and token 0 (no path exists to clash with).
    bool objectless_src = g.decided && Option::is_none(&pb.base) && Option::is_none(&parent) && Option::is_none(&pb.raw)
        && objectless_root(x, &sl.base);
    if (!minted)
    {
        match (&parent)
        {
            Some(t0) : emit(
                x,
                &sprintf(
                    "cb_borrow_range_unminted(%s, NULL, 0u, NULL, 0, (uint64_t)%s, (uint64_t)%s, %s, %s);",
                    t0,
                    &at.c,
                    &bt.c,
                    m,
                    &lc,
                ),
            ),
            None :
            {
                if (!objectless_src)
                {
                    String base = Option::expect(clone(&pb.base), "cobc: slice of an unchecked place");
                    emit(
                        x,
                        &sprintf(
                            "cb_borrow_range_unminted(%s, (void *)&(%s), %vu, %s, (uint64_t)%s, (uint64_t)%s, %s, %s);",
                            &base,
                            &pb.c,
                            ptid,
                            &projs_args(&pb.projs),
                            &at.c,
                            &bt.c,
                            m,
                            &lc,
                        ),
                    );
                }
            },
        }
        Type sty = Type::TSlice(Box::new(ModedTy { .inner = elem, .mode = sl.mode }));
        String c = ctype(g, &sty);
        String t = fresh(g, "sl");
        emit(x, &sprintf("%s %s;", &c, &t));
        emit(x, &sprintf("%s.src = (void *)&(%s);", &t, &pb.c));
        emit(x, &sprintf("%s.data = %s + %s;", &t, &data, &at.c));
        emit(x, &sprintf("%s.len = (uint64_t)%s - (uint64_t)%s;", &t, &bt.c, &at.c));
        return V { .c = t, .ty = sty, .obj = None };
    }
    // D-0070: the slice borrows its range (made absolute by the runtime when
    // the source is itself a slice), not the whole source.
    String tok = fresh(g, "tok");
    match (&parent)
    {
        Some(t0) : emit(
            x,
            &sprintf(
                "uint64_t %s = cb_borrow_range(%s, NULL, 0u, NULL, 0, (uint64_t)%s, (uint64_t)%s, %s, %s);",
                &tok,
                t0,
                &at.c,
                &bt.c,
                m,
                &lc,
            ),
        ),
        None :
        {
            if (objectless_src)
            {
                emit(x, &sprintf("uint64_t %s = 0;", &tok));
            }
            else
            {
                String base = Option::expect(clone(&pb.base), "cobc: slice of an unchecked place");
                emit(
                    x,
                    &sprintf(
                        "uint64_t %s = cb_borrow_range(%s, (void *)&(%s), %vu, %s, (uint64_t)%s, (uint64_t)%s, %s, %s);",
                        &tok,
                        &base,
                        &pb.c,
                        ptid,
                        &projs_args(&pb.projs),
                        &at.c,
                        &bt.c,
                        m,
                        &lc,
                    ),
                );
            }
        },
    }
    Type sty = Type::TSlice(Box::new(ModedTy { .inner = elem, .mode = sl.mode }));
    String c = ctype(g, &sty);
    String t = fresh(g, "sl");
    emit(x, &sprintf("%s %s;", &c, &t));
    V rv = V { .c = sprintf(
        "((cb_ref){ (void *)&(%s), %s })",
        &pb.c,
        &tok,
    ), .ty = ref_ty(clone(&pb.ty), sl.mode), .obj = None };
    Type rty = clone(&rv.ty);
    store(g, x, &sprintf("%s.src", &t), &rty, &rv);
    emit(x, &sprintf("%s.data = %s + %s;", &t, &data, &at.c));
    emit(x, &sprintf("%s.len = (uint64_t)%s - (uint64_t)%s;", &t, &bt.c, &at.c));
    register_temp(g, x, t, sty, line)
}

// A view's bounds, `$` the length `len`: each lowered and kept, pushed onto `vs`.
export fn view_bounds(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    String len,
    ref<Expr, shared> lo,
    ref<Expr, shared> hi,
    ref<Vec<V>, exclusive> vs,
)
{
    String lenv = fresh(g, "len");
    emit(x, &sprintf("uint64_t %s = %s;", &lenv, &len));
    Vec::push(&mut x.dollar, lenv);
    Type ut = Type::TInt(IntTy::Usize);
    V l0 = lower_expr(g, x, lo, Some(&ut));
    V l = into_temp(g, x, l0, lo.line);
    V h0 = lower_expr(g, x, hi, Some(&ut));
    V h = into_temp(g, x, h0, hi.line);
    Vec::pop(&mut x.dollar);
    Vec::push(vs, l);
    Vec::push(vs, h);
}

// `&s[lo .. hi]` of a `String`: `&s` as a borrow forms it (through a
// reference, its referent); the whole text, `&s[0..$]`, is made in place.
export fn lower_slice_string(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<SliceExpr, shared> sl,
    bool temp,
    usize line,
) : V
{
    String lc = loc(g, x.std_body, line);
    // D-0135: a temporary `String` (or part of one), as an argument, is an
    // object of this statement (D-0103's root).
    x.temp_root = temp;
    P p0 = lower_place(g, x, &sl.base);
    x.temp_root = false;
    P p = auto_deref(g, x, p0);
    String tok = fresh(g, "tok");
    match (&p.base)
    {
        Some(b) : emit(
            x,
            &sprintf(
                "uint64_t %s = cb_borrow(%s, %s, CB_SHARED, %s);",
                &tok,
                b,
                &projs_args(&p.projs),
                &lc,
            ),
        ),
        None :
        {
            // D-0294: an objectless local's text in a decided program: token 0.
            // D-0308: `&(*r)[lo..hi]` of a reference `r` lowered with no path:
            // its text is read only, and its owner's path is checked where `r`
            // was formed.
            assert(
                Option::is_none(&p.raw) && ((g.decided && objectless_root(x, &sl.base)) || pathless_ref_root(x, &sl.base)),
                "cobc: a view of a String with no access path",
            );
            emit(x, &sprintf("uint64_t %s = 0;", &tok));
        },
    }
    bool lo0 = match (&sl.lo.kind)
    {
        ExprKind::EInt(l) : Box::get(l).v == 0,
        _                 : false,
    };
    bool hi_dollar = match (&sl.hi.kind)
    {
        ExprKind::EDollar : true,
        _                 : false,
    };
    if (lo0 && hi_dollar)
    {
        Type vty = named_ty("std::StringView");
        String vc = ctype(g, &vty);
        u32 tid = type_id(g, &vty);
        String rt = fresh(g, "tok");
        String t = fresh(g, "t");
        String o = fresh(g, "o");
        u32 btid = bytes_tid(g);
        emit(
            x,
            &sprintf(
                "uint64_t %s = cb_borrow_range(%s, (void *)&((%s).bytes), %vu, (cb_proj[]){ { CB_FIELD, 0u } }, 1, 0u, (%s).bytes.len, CB_SHARED, %s);",
                &rt,
                &tok,
                &p.c,
                btid,
                &p.c,
                &lc,
            ),
        );
        emit(x, &sprintf("%s %s;", &vc, &t));
        emit(x, &sprintf("%s.bytes.src = (void *)&((%s).bytes);", &t, &p.c));
        emit(x, &sprintf("cb_store_ref(&%s.bytes.src, %s);", &t, &rt));
        emit(x, &sprintf("%s.bytes.data = (%s).bytes.ptr;", &t, &p.c));
        emit(x, &sprintf("%s.bytes.len = (%s).bytes.len;", &t, &p.c));
        // D-0294: in a decided program a view holds nothing the runtime
        // follows (`has_refs`): no object.
        if (g.decided)
        {
            return V { .c = t, .ty = vty, .obj = None };
        }
        emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &t, tid, &lc));
        return V { .c = t, .ty = vty, .obj = Some(o) };
    }
    V r0 = V { .c = sprintf(
        "((cb_ref){ (void *)&(%s), %s })",
        &p.c,
        &tok,
    ), .ty = ref_ty(clone(&p.ty), Mode::Shared), .obj = None };
    V r = into_temp(g, x, r0, line);
    Vec<V> vs = Vec::new();
    Vec::push(&mut vs, r);
    view_bounds(g, x, sprintf("((%s).bytes.len)", &p.c), &sl.lo, &sl.hi, &mut vs);
    call_std_values(g, x, "std::String::part", &vs, line)
}

// A `std` function called with values already lowered, as `coby` calls it
// for a view operation: arguments in flight, the call, its result.
export fn call_std_values(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    str name,
    ref<Vec<V>, shared> args,
    usize line,
) : V
{
    FnDecl f = Option::expect(get_fn(g, &String::copy(name)), "a std function");
    String cname = request_fn(g, name, Vec::new());
    Vec<String> ended = Vec::new();
    for (usize j = 0; j < Vec::len(&f.params) && j < Vec::len(args); j += 1)
    {
        ref<Type, shared> pt = &f.params[j].ty;
        bool is_ref = match (pt)
        {
            Type::TRef(_) : true,
            _             : false,
        };
        if (pure_view(g, &String::copy(name), j))
        {
            // Kept by the caller for the call (`pure_view`), and a temporary
            // one ended after it.
            match (&args[j].obj)
            {
                Some(o) : Vec::push(&mut ended, String::clone(o)),
                None    : {},
            }
        }
        else if (is_resource(g, pt))
        {
            give_arg(g, x, &args[j], "a std function's argument");
        }
        else if (has_refs(g, pt) && !is_ref)
        {
            u32 tid = type_id(g, pt);
            emit(x, &sprintf("cb_send_datum(&%s, %vu);", &args[j].c, tid));
        }
    }
    Vec<String> cs = Vec::new();
    foreach (v in args)
    {
        Vec::push(&mut cs, String::clone(&v.c));
    }
    String call = sprintf("%s(%s)", &cname, &String::join(&cs, ", "));
    V r = finish_call(g, x, call, clone(&f.ret), line);
    foreach (o in &ended)
    {
        emit(x, &sprintf("cb_absorb(%s);", o));
    }
    r
}

export fn usize_ty() : Type
{
    Type::TInt(IntTy::Usize)
}

// The C of each argument, each lowered with its hint (`None` for none).
export fn extern_args(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Vec<Expr>, shared> args,
    ref<Vec<Option<Type>>, shared> hints,
    usize line,
) : Vec<String>
{
    Vec<String> cs = Vec::new();
    for (usize k = 0; k < Vec::len(args); k += 1)
    {
        Option<Type> h = if (k < Vec::len(hints)) { clone(&hints[k]) } else { None };
        V v = match (&h)
        {
            Some(t) : lower_expr(g, x, &args[k], Some(t)),
            None    : lower_expr(g, x, &args[k], None),
        };
        Vec::push(&mut cs, into_temp_c(g, x, v, line));
    }
    cs
}

export fn hints(str pattern) : Vec<Option<Type>>
{
    // `u` a `usize`, `6` a `u64`, `i` an `i64`, `-` none.
    Vec<Option<Type>> out = Vec::new();
    foreach (c in StringView::as_bytes(pattern))
    {
        if (*c == b'u')
        {
            Vec::push(&mut out, Some(usize_ty()));
        }
        else if (*c == b'6')
        {
            Vec::push(&mut out, Some(Type::TInt(IntTy::U64)));
        }
        else if (*c == b'i')
        {
            Vec::push(&mut out, Some(Type::TInt(IntTy::I64)));
        }
        else
        {
            Vec::push(&mut out, None);
        }
    }
    out
}

export fn isize_v(String c) : V
{
    V { .c = c, .ty = Type::TInt(IntTy::Isize), .obj = None }
}

// A call of one of `std`'s externs: the runtime's primitives under `cb_`
// names (`lower_call`'s extern cases), else a declared C function.
export fn lower_std_extern(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> name,
    ref<Vec<Expr>, shared> args,
    usize line,
) : V
{
    if (*name == "std::stdout_write" || *name == "std::stderr_write")
    {
        V p = lower_expr(g, x, &args[0], None);
        V pt = into_temp(g, x, p, line);
        Type us = usize_ty();
        V n = lower_expr(g, x, &args[1], Some(&us));
        V nt = into_temp(g, x, n, line);
        str f = if (*name == "std::stdout_write") { "cb_write_out" } else { "cb_write_err" };
        return isize_v(sprintf("%s(%s, %s)", f, &pt.c, &nt.c));
    }
    if (*name == "std::file_read" || *name == "std::file_write")
    {
        Vec<String> cs = extern_args(g, x, args, &hints("-u-u"), line);
        str f = if (*name == "std::file_read") { "cb_file_read" } else { "cb_file_write" };
        return isize_v(sprintf("%s((void *)(%s), %s, (void *)(%s), %s)", f, &cs[0], &cs[1], &cs[2], &cs[3]));
    }
    if (*name == "std::file_op")
    {
        Vec<String> cs = extern_args(g, x, args, &hints("uu-u"), line);
        return isize_v(sprintf("cb_file_op(%s, %s, (void *)(%s), %s)", &cs[0], &cs[1], &cs[2], &cs[3]));
    }
    if (*name == "std::fs_op" || *name == "std::fs_query")
    {
        // D-0061: (op, a, an, b-or-buf, bn-or-cap).
        Vec<String> cs = extern_args(g, x, args, &hints("u-u-u"), line);
        str f = if (*name == "std::fs_op") { "cb_fs_op" } else { "cb_fs_query" };
        return isize_v(sprintf(
            "%s(%s, (void *)(%s), %s, (void *)(%s), %s)",
            f,
            &cs[0],
            &cs[1],
            &cs[2],
            &cs[3],
            &cs[4],
        ));
    }
    if (*name == "std::task_op")
    {
        // D-0204: (op, id, out, cap).
        Vec<String> cs = extern_args(g, x, args, &hints("uu-u"), line);
        return isize_v(sprintf("cb_task_op(%s, %s, (void *)(%s), %s)", &cs[0], &cs[1], &cs[2], &cs[3]));
    }
    if (*name == "std::event_op")
    {
        // D-0063: (op, id, seen).
        Vec<String> cs = extern_args(g, x, args, &hints("uuu"), line);
        return V { .c = sprintf("cb_event_op(%s, %s, %s)", &cs[0], &cs[1], &cs[2]), .ty = usize_ty(), .obj = None };
    }
    if (*name == "std::clock_read")
    {
        Vec<String> cs = extern_args(g, x, args, &hints("u"), line);
        return V { .c = sprintf("cb_clock_read(%s)", &cs[0]), .ty = Type::TInt(IntTy::I64), .obj = None };
    }
    if (*name == "std::tz_offset")
    {
        Vec<String> cs = extern_args(g, x, args, &hints("i"), line);
        return V { .c = sprintf("cb_tz_offset(%s)", &cs[0]), .ty = Type::TInt(IntTy::I64), .obj = None };
    }
    if (*name == "std::sleep_ns")
    {
        Vec<String> cs = extern_args(g, x, args, &hints("6"), line);
        return V { .c = sprintf("cb_sleep_ns(%s)", &cs[0]), .ty = Type::TInt(IntTy::I64), .obj = None };
    }
    if (*name == "std::file_at")
    {
        Vec<String> cs = extern_args(g, x, args, &hints("uu6"), line);
        return V { .c = sprintf(
            "cb_file_at(%s, %s, %s)",
            &cs[0],
            &cs[1],
            &cs[2],
        ), .ty = Type::TInt(IntTy::I64), .obj = None };
    }
    if (*name == "std::arg_bytes")
    {
        Vec<String> cs = extern_args(g, x, args, &hints("u-u"), line);
        return isize_v(sprintf("cb_arg_bytes(%s, %s, %s)", &cs[0], &cs[1], &cs[2]));
    }
    if (*name == "std::stdin_read")
    {
        Vec<String> cs = extern_args(g, x, args, &hints("-u"), line);
        return isize_v(sprintf("cb_read_in(%s, %s)", &cs[0], &cs[1]));
    }
    // D-0141..D-0144: primitives private to `std` realized by the runtime
    // under `cb_` names, the arguments as the declaration types them.
    Option<str> runtime = if (*name == "std::path_op") { Some("cb_path_op") } else if (*name == "std::proc_op") { Some("cb_proc_op") } else if (*name == "std::net_op") { Some("cb_net_op") } else if (*name == "std::os_random") { Some("cb_os_random") } else if (*name == "std::stdout_flush") { Some("cb_flush_out") } else if (*name == "std::stdin_read_line") { Some("cb_read_line_in") } else { None };
    ExternDecl ext = clone(Option::expect(HashMap::get(&g.prog.table.externs, name), "an extern"));
    match (runtime)
    {
        Some(cname) :
        {
            Vec<String> cs = Vec::new();
            for (usize k = 0; k < Vec::len(&ext.params) && k < Vec::len(args); k += 1)
            {
                bool raw = match (&ext.params[k].ty)
                {
                    Type::TRawptr(_) : true,
                    _                : false,
                };
                V v = if (raw)
                {
                    lower_expr(
                        g,
                        x,
                        &args[k],
                        None,
                    )
                }
                else { lower_expr(g, x, &args[k], Some(&ext.params[k].ty)) };
                String c = into_temp_c(g, x, v, line);
                Vec::push(&mut cs, if (raw) { sprintf("(void *)(%s)", &c) } else { c });
            }
            return V { .c = sprintf(
                "%s(%s)",
                cname,
                &String::join(&cs, ", "),
            ), .ty = clone(&ext.ret), .obj = None };
        },
        None        : {},
    }
    lower_extern_call(g, x, &ext, args, line)
}

// A declared C function (`unsafe extern fn`), declared once by its own name.
export fn lower_extern_call(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<ExternDecl, shared> ext,
    ref<Vec<Expr>, shared> args,
    usize line,
) : V
{
    String cname = match (HashMap::get(&g.externs_out, &ext.name))
    {
        Some(c) : String::clone(c),
        None    :
        {
            String cname = sprintf("cbx_%s", &san(&ext.name));
            String ret = if (is_void(&ext.ret)) { "void" } else { ctype(g, &ext.ret) };
            Vec<String> ps = Vec::new();
            foreach (p in &ext.params)
            {
                Vec::push(&mut ps, ctype(g, &p.ty));
            }
            String params = if (Vec::len(&ps) == 0) { "void" } else { String::join(&ps, ", ") };
            String::append(
                &mut g.protos,
                &sprintf("extern %s %s(%s) __asm__(\"%s\");\n", &ret, &cname, &params, &ext.name),
            );
            HashMap::insert(&mut g.externs_out, String::clone(&ext.name), String::clone(&cname));
            cname
        },
    };
    Vec<String> argv = Vec::new();
    for (usize k = 0; k < Vec::len(&ext.params) && k < Vec::len(args); k += 1)
    {
        V v = lower_expr(g, x, &args[k], Some(&ext.params[k].ty));
        if (is_never(&v.ty))
        {
            return never();
        }
        Vec::push(&mut argv, into_temp_c(g, x, v, line));
    }
    String call = sprintf("%s(%s)", &cname, &String::join(&argv, ", "));
    if (is_void(&ext.ret))
    {
        emit(x, &sprintf("%s;", &call));
        return unit();
    }
    String t = fresh(g, "t");
    String c = ctype(g, &ext.ret);
    emit(x, &sprintf("%s %s = %s;", &c, &t, &call));
    V { .c = t, .ty = clone(&ext.ret), .obj = None }
}

// ---- simd (D-0254) ----

export fn simd_expected(Option<ref<Type, shared>> expected) : Option<Type>
{
    match (expected)
    {
        Some(t) : match (t)
        {
            Type::TSimd(_) : Some(clone(t)),
            _              : None,
        },
        None : None,
    }
}

export fn simd_lane(ref<Type, shared> t) : Type
{
    match (t)
    {
        Type::TSimd(sv) : clone(&Box::get(sv).inner),
        _               : Type::TVoid,
    }
}

// A `simd` literal, a C compound literal of its vector type.
export fn lower_simd_lit(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Vec<Expr>, shared> es, Type ty) : V
{
    Type lane = simd_lane(&ty);
    Vec<String> vals = Vec::new();
    foreach (e in es)
    {
        V v = lower_expr(g, x, e, Some(&lane));
        if (is_never(&v.ty))
        {
            return never();
        }
        Vec::push(&mut vals, into_temp_c(g, x, v, e.line));
    }
    String c = ctype(g, &ty);
    V { .c = sprintf("((%s){ %s })", &c, &String::join(&vals, ", ")), .ty = ty, .obj = None }
}

export fn lower_simd_repeat(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> value, u128 n, Type ty) : V
{
    Type lane = simd_lane(&ty);
    V v = lower_expr(g, x, value, Some(&lane));
    if (is_never(&v.ty))
    {
        return never();
    }
    String one = into_temp_c(g, x, v, value.line);
    String c = ctype(g, &ty);
    Vec<String> lanes = Vec::new();
    u128 k = 0;
    while (k < n)
    {
        Vec::push(&mut lanes, String::clone(&one));
        k += 1;
    }
    V { .c = sprintf("((%s){ %s })", &c, &String::join(&lanes, ", ")), .ty = ty, .obj = None }
}

// The mask type of a `simd`: signed integer lanes of the lanes' width.
export fn simd_mask(ref<Type, shared> t) : Type
{
    ref<SizedTy, shared> sv = match (t)
    {
        Type::TSimd(sv) : Box::get(sv),
        _               : return Type::TVoid,
    };
    IntTy m = match (&sv.inner)
    {
        Type::TInt(i) : if (*i == IntTy::I8 || *i == IntTy::U8) { IntTy::I8 } else if (*i == IntTy::I16 || *i == IntTy::U16) { IntTy::I16 } else if (*i == IntTy::I32 || *i == IntTy::U32) { IntTy::I32 } else { IntTy::I64 },
        Type::TF32    : IntTy::I32,
        _             : IntTy::I64,
    };
    Type::TSimd(Box::new(SizedTy { .inner = Type::TInt(m), .n = sv.n }))
}

// `halve_reduce`'s folds: 0 or, 1 and, 2 add, 3 min, 4 max.
export fn fold_comb(u8 fold, ref<String, shared> a, ref<String, shared> b, ref<String, shared> t) : String
{
    if (fold == 0)
    {
        return sprintf("%s | %s", a, b);
    }
    if (fold == 1)
    {
        return sprintf("%s & %s", a, b);
    }
    if (fold == 2)
    {
        return sprintf("%s + %s", a, b);
    }
    str rel = if (fold == 3) { "<" } else { ">" };
    if (StringView::len(t) == 0)
    {
        return sprintf("(%s %s %s ? %s : %s)", a, rel, b, a, b);
    }
    sprintf("(((%s) & (%s)(%s %s %s)) | ((%s) & ~(%s)(%s %s %s)))", a, t, a, rel, b, b, t, a, rel, b)
}

// C statements that fold the integer vector expression `v` (`n` lanes of
// `size` bytes, read as the C lane type `lc`) into the scalar `out`, by
// halving (cobc's `halve_reduce`).
export fn halve_reduce(StringView v, StringView lc, u128 n, u128 size, u8 fold, str out) : String
{
    String s = sprintf(
        "{ __typeof__(%s) _x = %s; typedef %s _h0t __attribute__((vector_size(%v))); _h0t _h0; memcpy(&_h0, &_x, %v); ",
        v,
        v,
        lc,
        n * size,
        n * size,
    );
    String cur = "_h0";
    u128 lanes = n;
    u32 k = 0;
    while (lanes > 2)
    {
        u128 half = lanes / 2;
        u128 hb = half * size;
        k += 1;
        String t = sprintf("_h%vt", k);
        String c = fold_comb(fold, &sprintf("_h%va", k), &sprintf("_h%vb", k), &t);
        String::appendf(
            &mut s,
            "typedef %s %s __attribute__((vector_size(%v))); %s _h%va, _h%vb; memcpy(&_h%va, &%s, %v); memcpy(&_h%vb, (char *)&%s + %v, %v); %s _h%v = %s; ",
            lc,
            &t,
            hb,
            &t,
            k,
            k,
            k,
            &cur,
            hb,
            k,
            &cur,
            hb,
            hb,
            &t,
            k,
            &c,
        );
        cur = sprintf("_h%v", k);
        lanes = half;
    }
    String::appendf(
        &mut s,
        "%s = (%s)(%s); }",
        out,
        lc,
        &fold_comb(fold, &sprintf("%s[0]", &cur), &sprintf("%s[1]", &cur), &String::new()),
    );
    s
}

// `{ M _any; <fold of cond> }` over the lanes' unsigned type.
export fn simd_mask_or(ref<String, shared> cond, IntTy it, u128 n) : String
{
    str uc = c_uint_type(it);
    sprintf(
        "%s _any; %s",
        uc,
        &halve_reduce(cond, uc, n, widen<u128>(int_ty_bits(it, 64) / 8), 0, "_any"),
    )
}

export fn simd_any_fault(ref<String, shared> cond, IntTy it, u128 n, ref<String, shared> lc) : String
{
    sprintf("{ %s if (_any) cb_fault(\"diag.arith-overflow\", %s); }", &simd_mask_or(cond, it, n), lc)
}

export fn simd_eq(BinOp op, ref<String, shared> ct, u128 n, ref<String, shared> a, ref<String, shared> b) : V
{
    String e = sprintf(
        "({ %s _a = %s, _b = %s; int _e = 1; for (int _i = 0; _i < %v; _i++) _e &= _a[_i] == _b[_i]; _e; })",
        ct,
        a,
        b,
        n,
    );
    V { .c = sprintf(
        "((uint8_t)(%s%s))",
        if (op == BinOp::Ne) { "!" } else { "" },
        &e,
    ), .ty = Type::TBool, .obj = None }
}

// D-0254: an operator lane by lane; an integer lane's overflow faults as the
// scalar operator's does.
export fn simd_binop(
    ref<Gen, exclusive> g,
    BinOp op,
    ref<Type, shared> ty,
    ref<Type, shared> lane,
    u128 n,
    ref<String, shared> a,
    ref<String, shared> b,
    ref<String, shared> lc,
) : V
{
    String ct = ctype(g, ty);
    String m = mangle(ty);
    IntTy it = match (lane)
    {
        Type::TInt(i) : *i,
        _             :
        {
            if (op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul || op == BinOp::Div)
            {
                str sym = if (op == BinOp::Add) { "+" } else if (op == BinOp::Sub) { "-" } else if (op == BinOp::Mul) { "*" } else { "/" };
                return V { .c = sprintf("(%s %s %s)", a, sym, b), .ty = clone(ty), .obj = None };
            }
            assert(op == BinOp::Eq || op == BinOp::Ne, "cobc: operator on a float simd");
            return simd_eq(op, &ct, n, a, b);
        },
    };
    bool signed = int_ty_signed(it);
    if (op == BinOp::Add || op == BinOp::Sub)
    {
        str sym = if (op == BinOp::Add) { "+" } else { "-" };
        str ovf = if (op == BinOp::Add && signed)
        {
            "((_a ^ _r) & (_b ^ _r)) < 0"
        }
        else if (signed)
        {
            "((_a ^ _b) & (_a ^ _r)) < 0"
        }
        else if (op == BinOp::Add)
        {
            "_r < _a"
        }
        else
        {
            "_a < _b"
        };
        String chk = simd_any_fault(&String::copy(ovf), it, n, lc);
        return V { .c = sprintf(
            "({ %s _a = %s, _b = %s; %s _r = (%s)((cbvu_%s)_a %s (cbvu_%s)_b); %s _r; })",
            &ct,
            a,
            b,
            &ct,
            &ct,
            &m,
            sym,
            &m,
            &chk,
        ), .ty = clone(ty), .obj = None };
    }
    if (op == BinOp::Mul)
    {
        return V { .c = sprintf(
            "({ %s _a = %s, _b = %s, _r; for (int _i = 0; _i < %v; _i++) { %s _l; if (__builtin_mul_overflow(_a[_i], _b[_i], &_l)) cb_fault(\"diag.arith-overflow\", %s); _r[_i] = _l; } _r; })",
            &ct,
            a,
            b,
            n,
            c_int_type(it),
            lc,
        ), .ty = clone(ty), .obj = None };
    }
    if (op == BinOp::BitAnd || op == BinOp::BitOr || op == BinOp::BitXor)
    {
        str sym = if (op == BinOp::BitAnd) { "&" } else if (op == BinOp::BitOr) { "|" } else { "^" };
        return V { .c = sprintf("(%s %s %s)", a, sym, b), .ty = clone(ty), .obj = None };
    }
    if (op == BinOp::Shl || op == BinOp::Shr)
    {
        u32 bw = int_ty_bits(it, 64);
        String shifted = if (op == BinOp::Shl)
        {
            sprintf(
                "(%s)((cbvu_%s)_a << (cbvu_%s)_b)",
                &ct,
                &m,
                &m,
            )
        }
        else { "(_a >> _b)" };
        String test = simd_mask_or(&sprintf("((cbvu_%s)_b >= %v)", &m, bw), it, n);
        return V { .c = sprintf(
            "({ %s _a = %s, _b = %s; { %s if (_any) cb_fault(\"diag.shift-amount-out-of-range\", %s); } %s; })",
            &ct,
            a,
            b,
            &test,
            lc,
            &shifted,
        ), .ty = clone(ty), .obj = None };
    }
    assert(op == BinOp::Eq || op == BinOp::Ne, "cobc: operator on an integer simd");
    simd_eq(op, &ct, n, a, b)
}

// `wrapping_`/`saturating_` on a `simd`: wrapping in the unsigned twin type,
// saturating lane by lane as the scalar does.
export fn simd_wrap_sat(ref<Gen, exclusive> g, ref<String, shared> name, V av, V bv) : V
{
    Type ty = clone(&av.ty);
    u128 n = match (&ty)
    {
        Type::TSimd(sv) : Box::get(sv).n,
        _               : 0,
    };
    Type lane_t = simd_lane(&ty);
    IntTy t = match (&lane_t)
    {
        Type::TInt(i) : *i,
        _             :
        {
            assert(false, "cobc: a wrapping simd of floats");
            IntTy::I32
        },
    };
    String ct = ctype(g, &ty);
    String m = mangle(&ty);
    bool wrapping = StringView::starts_with(name, "wrapping_");
    bool add = StringView::ends_with(name, "_add");
    bool sub = StringView::ends_with(name, "_sub");
    str sym = if (add) { "+" } else if (sub) { "-" } else { "*" };
    if (wrapping)
    {
        return V { .c = sprintf(
            "((%s)((cbvu_%s)%s %s (cbvu_%s)%s))",
            &ct,
            &m,
            &av.c,
            sym,
            &m,
            &bv.c,
        ), .ty = ty, .obj = None };
    }
    if (add || sub)
    {
        String c = if (!int_ty_signed(t) && add)
        {
            sprintf("({ %s _a = %s, _b = %s; %s _r = _a + _b; _r | (%s)(_r < _a); })", &ct, &av.c, &bv.c, &ct, &ct)
        }
        else if (!int_ty_signed(t))
        {
            sprintf("({ %s _a = %s, _b = %s; %s _r = _a - _b; _r & ~(%s)(_a < _b); })", &ct, &av.c, &bv.c, &ct, &ct)
        }
        else
        {
            str ovf = if (add) { "((_a ^ _r) & (_b ^ _r)) < 0" } else { "((_a ^ _b) & (_a ^ _r)) < 0" };
            sprintf(
                "({ %s _a = %s, _b = %s; %s _r = (%s)((cbvu_%s)_a %s (cbvu_%s)_b); %s _o = (%s)(%s); %s _s = (_a >> %v) ^ %s; (_r & ~_o) | (_s & _o); })",
                &ct,
                &av.c,
                &bv.c,
                &ct,
                &ct,
                &m,
                sym,
                &m,
                &ct,
                &ct,
                ovf,
                &ct,
                int_ty_bits(t, 64) - 1,
                &c_int(t, int_max_bits(t)),
            )
        };
        return V { .c = c, .ty = ty, .obj = None };
    }
    str builtin = if (add) { "__builtin_add_overflow" } else { "__builtin_sub_overflow" };
    str tm = if (int_ty_signed(t) && add)
    {
        "_b[_i] > 0"
    }
    else if (int_ty_signed(t))
    {
        "_b[_i] < 0"
    }
    else if (add)
    {
        "1"
    }
    else
    {
        "0"
    };
    String c = sprintf(
        "({ %s _a = %s, _b = %s, _r; for (int _i = 0; _i < %v; _i++) { %s _l; if (%s(_a[_i], _b[_i], &_l)) _l = %s ? %s : %s; _r[_i] = _l; } _r; })",
        &ct,
        &av.c,
        &bv.c,
        n,
        c_int_type(t),
        builtin,
        tm,
        &c_int(t, int_max_bits(t)),
        &c_int(t, int_min_bits(t)),
    );
    V { .c = c, .ty = ty, .obj = None }
}

struct SimdPair
{
    String a;
    String b;
    Type ty;
}

// Two operands of one `simd` type: the first with `first` as its expected
// type, when given; the second with the first's.
export fn simd_pair(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> a,
    ref<Expr, shared> b,
    Option<Type> first,
) : Option<SimdPair>
{
    V av0 = match (&first)
    {
        Some(t) : lower_expr(g, x, a, Some(t)),
        None    : lower_expr(g, x, a, None),
    };
    if (is_never(&av0.ty))
    {
        return None;
    }
    V av = into_temp(g, x, av0, a.line);
    Type at = clone(&av.ty);
    V bv0 = lower_expr(g, x, b, Some(&at));
    if (is_never(&bv0.ty))
    {
        return None;
    }
    V bv = into_temp(g, x, bv0, b.line);
    Some(SimdPair { .a = String::clone(&av.c), .b = String::clone(&bv.c), .ty = at })
}

// The lane-wise intrinsics of `simd<T, N>` (D-0254, `spec/21` §0), on GCC/Clang
// vector types. A mask is the signed integer vector of the lanes' width, each
// lane -1 or 0; a vector comparison's result is cast to it, and a choice by
// mask is `(m & a) | (~m & b)` on the bits.
export fn lower_simd_intrinsic(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> name,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    Option<ref<Type, shared>> expected,
    usize line,
) : V
{
    String lc = loc(g, x.std_body, line);
    StringView nm = name;
    bool cmp = nm == "simd_eq" || nm == "simd_ne" || nm == "simd_lt" || nm == "simd_le" || nm == "simd_gt" || nm == "simd_ge";
    bool minmax = nm == "simd_min" || nm == "simd_max";
    if (cmp || minmax)
    {
        Option<Type> first = if (minmax) { simd_expected(expected) } else { None };
        SimdPair pr = match (simd_pair(g, x, &args[0], &args[1], first))
        {
            Some(p) : p,
            None    : return never(),
        };
        String ct = ctype(g, &pr.ty);
        Type mt = simd_mask(&pr.ty);
        String mc = ctype(g, &mt);
        str sym = if (nm == "simd_eq")
        {
            "=="
        }
        else if (nm == "simd_ne")
        {
            "!="
        }
        else if (nm == "simd_lt" || nm == "simd_min")
        {
            "<"
        }
        else if (nm == "simd_le")
        {
            "<="
        }
        else if (nm == "simd_gt" || nm == "simd_max")
        {
            ">"
        }
        else
        {
            ">="
        };
        if (minmax)
        {
            String c = sprintf(
                "({ %s _a = %s, _b = %s; %s _m = (%s)(_a %s _b); (%s)((_m & (%s)_a) | (~_m & (%s)_b)); })",
                &ct,
                &pr.a,
                &pr.b,
                &mc,
                &mc,
                sym,
                &ct,
                &mc,
                &mc,
            );
            return V { .c = c, .ty = clone(&pr.ty), .obj = None };
        }
        return V { .c = sprintf("((%s)(%s %s %s))", &mc, &pr.a, sym, &pr.b), .ty = mt, .obj = None };
    }
    if (nm == "simd_select")
    {
        V m0 = lower_expr(g, x, &args[0], None);
        if (is_never(&m0.ty))
        {
            return never();
        }
        V m = into_temp(g, x, m0, line);
        SimdPair pr = match (simd_pair(g, x, &args[1], &args[2], simd_expected(expected)))
        {
            Some(p) : p,
            None    : return never(),
        };
        String ct = ctype(g, &pr.ty);
        String mc = ctype(g, &simd_mask(&pr.ty));
        String c = sprintf(
            "({ %s _m = (%s)(%s != 0); (%s)((_m & (%s)%s) | (~_m & (%s)%s)); })",
            &mc,
            &mc,
            &m.c,
            &ct,
            &mc,
            &pr.a,
            &mc,
            &pr.b,
        );
        return V { .c = c, .ty = clone(&pr.ty), .obj = None };
    }
    if (nm == "simd_any" || nm == "simd_all")
    {
        V m0 = lower_expr(g, x, &args[0], None);
        if (is_never(&m0.ty))
        {
            return never();
        }
        u128 n = match (&m0.ty)
        {
            Type::TSimd(sv) : Box::get(sv).n,
            _               : 0,
        };
        Type lane_m = simd_lane(&m0.ty);
        IntTy it = match (&lane_m)
        {
            Type::TInt(i) : *i,
            _             :
            {
                assert(false, "cobc: simd_any of a float simd");
                IntTy::I32
            },
        };
        V m = into_temp(g, x, m0, line);
        // Any lane nonzero: their bits or-ed; every lane nonzero: each lane's
        // `!= 0` mask (all ones or none) and-ed.
        str uc = c_uint_type(it);
        u128 size = widen<u128>(int_ty_bits(it, 64) / 8);
        bool any = nm == "simd_any";
        String src = if (any) { String::clone(&m.c) } else { sprintf("(%s != 0)", &m.c) };
        String c = sprintf(
            "((uint8_t)({ %s _f; %s _f != 0; }))",
            uc,
            &halve_reduce(&src, uc, n, size, if (any) { 0 } else { 1 }, "_f"),
        );
        return V { .c = c, .ty = Type::TBool, .obj = None };
    }
    if (nm == "simd_sum" || nm == "simd_reduce_min" || nm == "simd_reduce_max")
    {
        V v0 = lower_expr(g, x, &args[0], None);
        if (is_never(&v0.ty))
        {
            return never();
        }
        Type lane = simd_lane(&v0.ty);
        u128 n = match (&v0.ty)
        {
            Type::TSimd(sv) : Box::get(sv).n,
            _               : 0,
        };
        V v = into_temp(g, x, v0, line);
        String lct = ctype(g, &lane);
        bool sum = nm == "simd_sum";
        match (&lane)
        {
            Type::TInt(it) :
            {
                u128 size = widen<u128>(int_ty_bits(*it, 64) / 8);
                if (sum)
                {
                    // Every lane in [MIN / N, MAX / N]: no prefix of at most N
                    // lanes leaves the type, so the checked sum equals the
                    // wrapped one, which the C compiler sums as a vector.
                    i128 ni = reinterpret<i128>(n);
                    String out = if (int_ty_signed(*it))
                    {
                        i128 lo = reinterpret<i128>(int_min_bits(*it)) / ni;
                        i128 hi = reinterpret<i128>(int_max_bits(*it)) / ni;
                        sprintf("(_v < (%s)%v) | (_v > (%s)%v)", &lct, lo, &lct, hi)
                    }
                    else
                    {
                        i128 hi = reinterpret<i128>(int_max_bits(*it)) / ni;
                        sprintf("(_v > (%s)%vu)", &lct, hi)
                    };
                    str uc = c_uint_type(*it);
                    String c = sprintf(
                        "({ __typeof__(%s) _v = %s; %s _far; %s %s _r; if (!_far) { %s _u; %s _r = (%s)_u; } else { _r = _v[0]; for (int _i = 1; _i < %v; _i++) { if (__builtin_add_overflow(_r, _v[_i], &_r)) cb_fault(\"diag.arith-overflow\", %s); } } _r; })",
                        &v.c,
                        &v.c,
                        uc,
                        &halve_reduce(&out, uc, n, size, 0, "_far"),
                        &lct,
                        uc,
                        &halve_reduce("_v", uc, n, size, 2, "_u"),
                        &lct,
                        n,
                        &lc,
                    );
                    return V { .c = c, .ty = clone(&lane), .obj = None };
                }
                // An integer minimum or maximum is the same in any order.
                u8 fold = if (nm == "simd_reduce_min") { 3 } else { 4 };
                String c = sprintf("({ %s _r; %s _r; })", &lct, &halve_reduce(&v.c, &lct, n, size, fold, "_r"));
                return V { .c = c, .ty = clone(&lane), .obj = None };
            },
            _              : {},
        }
        // Left to right, from lane 0: the order `spec/21` fixes.
        String step = if (sum)
        {
            "_r = _r + _v[_i];"
        }
        else if (nm == "simd_reduce_min")
        {
            "_r = _r < _v[_i] ? _r : _v[_i];"
        }
        else
        {
            "_r = _r > _v[_i] ? _r : _v[_i];"
        };
        String c = sprintf(
            "({ __typeof__(%s) _v = %s; %s _r = _v[0]; for (int _i = 1; _i < %v; _i++) { %s } _r; })",
            &v.c,
            &v.c,
            &lct,
            n,
            &step,
        );
        return V { .c = c, .ty = clone(&lane), .obj = None };
    }
    if (nm == "simd_load" || nm == "simd_store")
    {
        bool store = nm == "simd_store";
        // A slice named by a place is reached in place; any other is a
        // temporary.
        bool is_place = match (&strip_parens(&args[0]).kind)
        {
            ExprKind::EPath(_)  : true,
            ExprKind::EField(_) : true,
            ExprKind::EDeref(_) : true,
            _                   : false,
        };
        String sc = String::new();
        Type sty = Type::TVoid;
        if (is_place)
        {
            P p = lower_place(g, x, &args[0]);
            sc = String::clone(&p.c);
            sty = clone(&p.ty);
        }
        else
        {
            V v = lower_expr(g, x, &args[0], None);
            if (is_never(&v.ty))
            {
                return never();
            }
            sty = clone(&v.ty);
            sc = into_temp_c(g, x, v, line);
        }
        Type elem = match (&sty)
        {
            Type::TSlice(m) : clone(&Box::get(m).inner),
            _               :
            {
                assert(false, "cobc: a simd load from a non-slice");
                Type::TVoid
            },
        };
        Type us = usize_ty();
        V i0 = lower_expr(g, x, &args[1], Some(&us));
        if (is_never(&i0.ty))
        {
            return never();
        }
        String ic = into_temp_c(g, x, i0, line);
        Type vty = Type::TVoid;
        Option<String> val = None;
        if (store)
        {
            // A literal is a `simd<T, N>` of the slice's T and its length.
            Option<Type> lit = match (&strip_parens(&args[2]).kind)
            {
                ExprKind::EArrayLit(items) : Some(Type::TSimd(Box::new(SizedTy { .inner = clone(&elem), .n = widen<u128>(Vec::len(items)) }))),
                ExprKind::EArrayRepeat(r)  : Some(Type::TSimd(Box::new(SizedTy { .inner = clone(&elem), .n = Box::get(r).n }))),
                _                          : None,
            };
            V v = match (&lit)
            {
                Some(t) : lower_expr(g, x, &args[2], Some(t)),
                None    : lower_expr(g, x, &args[2], None),
            };
            if (is_never(&v.ty))
            {
                return never();
            }
            vty = clone(&v.ty);
            val = Some(into_temp_c(g, x, v, line));
        }
        else
        {
            vty = if (Vec::len(targs) > 0) { apply(&targs[0], &x.subst) } else { Type::TVoid };
        }
        u128 n = match (&vty)
        {
            Type::TSimd(sv) : Box::get(sv).n,
            _               :
            {
                assert(false, "cobc: a simd load of a non-simd");
                0
            },
        };
        String ct = ctype(g, &vty);
        // `[Index-Checked]` for every lane, then each lane's access is checked
        // as `s[i + k]`'s is. Written `len < n || i > len - n` (no wrap either
        // way): a C compiler that knows a lower bound of `len` (D-0320's guard)
        // proves it where it could not prove `len - i < n` (CHG-0443).
        emit(
            x,
            &sprintf(
                "if ((%s).len < %vu || (uint64_t)%s > (%s).len - %vu) cb_fault(\"diag.index-out-of-bounds\", %s);",
                &sc,
                n,
                &ic,
                &sc,
                n,
                &lc,
            ),
        );
        String k = fresh(g, "k");
        // A direct slice's checks are taken only while its flag says they are
        // needed: tested once for all the lanes (cbc wrote the loop bare, its
        // C not cobc's, CHG-0443).
        Option<String> flag = match (HashMap::get(&x.direct_live, &sc))
        {
            Some(f) : Some(String::clone(f)),
            None    : None,
        };
        match (&flag)
        {
            Some(f) : emit(x, &sprintf("if (%s) {", f)),
            None    : {},
        }
        emit(x, &sprintf("for (uint64_t %s = 0; %s < %vu; %s++) {", &k, &k, n, &k));
        bool saved = replace(&mut x.place_write, store);
        slice_elem_access(g, x, &sc, &sprintf("%s + %s", &ic, &k), &elem, &lc);
        x.place_write = saved;
        emit(x, "}");
        if (Option::is_some(&flag))
        {
            emit(x, "}");
        }
        match (&val)
        {
            Some(vc) :
            {
                emit(
                    x,
                    &sprintf(
                        "{ %s _v = %s; memcpy(&(%s).data[%s], &_v, sizeof _v); }",
                        &ct,
                        vc,
                        &sc,
                        &ic,
                    ),
                );
                return unit();
            },
            None     : {},
        }
        String r = fresh(g, "t");
        emit(x, &sprintf("%s %s; memcpy(&%s, &(%s).data[%s], sizeof %s);", &ct, &r, &r, &sc, &ic, &r));
        return V { .c = r, .ty = vty, .obj = None };
    }
    assert(false, "cobc: an unknown simd intrinsic");
    unit()
}

// D-0249/D-0253 `atomic_op(a, op, x, y)`: load, store, swap,
// compare-and-exchange, checked add/sub, and the fetch operations, all
// sequentially consistent, on an `Atomic<T>` (or an `AtomicPtr<T>`'s cell).
export fn lower_atomic_op(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Vec<Expr>, shared> args, usize line) : V
{
    String lc = loc(g, x.std_body, line);
    u128 op = match (&strip_parens(&args[1]).kind)
    {
        ExprKind::EInt(l) : Box::get(l).v,
        _                 :
        {
            assert(false, "cobc: an atomic operation that is not a literal");
            0
        },
    };
    V av = lower_expr(g, x, &args[0], None);
    if (is_never(&av.ty))
    {
        return never();
    }
    Type ty = Type::TVoid;
    match (&av.ty)
    {
        Type::TRef(m) : match (&Box::get(m).inner)
        {
            Type::TNamed(n) :
            {
                Type ta = apply(&Box::get(n).args[0], &x.subst);
                if (Box::get(n).name == "std::Atomic")
                {
                    match (&ta)
                    {
                        Type::TInt(_) : ty = clone(&ta),
                        _             : assert(false, "cobc: an atomic of a non-integer"),
                    }
                }
                else if (Box::get(n).name == "std::AtomicPtr" && op <= 3)
                {
                    ty = Type::TRawptr(Box::new(ta));
                }
                else
                {
                    assert(false, "cobc: an atomic operation on a non-atomic");
                }
            },
            _               : assert(false, "cobc: an atomic operation on a non-atomic"),
        },
        _ : assert(false, "cobc: an atomic operation through a non-reference"),
    }
    V at = into_temp(g, x, av, line);
    V xv0 = lower_expr(g, x, &args[2], Some(&ty));
    if (is_never(&xv0.ty))
    {
        return never();
    }
    String xc = into_temp_c(g, x, xv0, line);
    V yv0 = lower_expr(g, x, &args[3], Some(&ty));
    if (is_never(&yv0.ty))
    {
        return never();
    }
    String yc = into_temp_c(g, x, yv0, line);
    String ct = match (&ty)
    {
        Type::TInt(t) : String::copy(c_int_type(*t)),
        _             : ctype(g, &ty),
    };
    emit(x, &sprintf("cb_read((%s).tok, NULL, 0, %s);", &at.c, &lc));
    emit(x, "if (__builtin_expect(__atomic_load_n(&cb_sched_flag, __ATOMIC_RELAXED) != 0, 0)) cb_atomic_point();");
    String p = sprintf("((%s *)(%s).p)", &ct, &at.c);
    String r = fresh(g, "t");
    str sc = "__ATOMIC_SEQ_CST";
    if (op == 0)
    {
        emit(x, &sprintf("%s %s = __atomic_load_n(%s, %s);", &ct, &r, &p, sc));
    }
    else if (op == 1)
    {
        emit(x, &sprintf("__atomic_store_n(%s, (%s)%s, %s);", &p, &ct, &xc, sc));
        emit(x, &sprintf("%s %s = 0;", &ct, &r));
    }
    else if (op == 2)
    {
        emit(x, &sprintf("%s %s = __atomic_exchange_n(%s, (%s)%s, %s);", &ct, &r, &p, &ct, &xc, sc));
    }
    else if (op == 3)
    {
        // On failure the builtin writes the value it found into `r`.
        emit(x, &sprintf("%s %s = %s;", &ct, &r, &xc));
        emit(
            x,
            &sprintf(
                "(void)__atomic_compare_exchange_n(%s, &%s, (%s)%s, 0, %s, %s);",
                &p,
                &r,
                &ct,
                &yc,
                sc,
                sc,
            ),
        );
    }
    else if (op == 4 || op == 5)
    {
        str f = if (op == 4) { "__builtin_add_overflow" } else { "__builtin_sub_overflow" };
        String n = fresh(g, "t");
        emit(x, &sprintf("%s %s = __atomic_load_n(%s, %s);", &ct, &r, &p, sc));
        emit(x, &sprintf("%s %s;", &ct, &n));
        emit(
            x,
            &sprintf(
                "do { if (%s(%s, (%s)%s, &%s)) cb_fault(\"diag.arith-overflow\", %s); } while (!__atomic_compare_exchange_n(%s, &%s, %s, 1, %s, %s));",
                f,
                &r,
                &ct,
                &xc,
                &n,
                &lc,
                &p,
                &r,
                &n,
                sc,
                sc,
            ),
        );
    }
    else if (op >= 6 && op <= 10)
    {
        str f = if (op == 6)
        {
            "__atomic_fetch_add"
        }
        else if (op == 7)
        {
            "__atomic_fetch_sub"
        }
        else if (op == 8)
        {
            "__atomic_fetch_and"
        }
        else if (op == 9)
        {
            "__atomic_fetch_or"
        }
        else
        {
            "__atomic_fetch_xor"
        };
        emit(x, &sprintf("%s %s = %s(%s, (%s)%s, %s);", &ct, &r, f, &p, &ct, &xc, sc));
    }
    else
    {
        assert(false, "cobc: an unknown atomic operation");
    }
    V { .c = r, .ty = ty, .obj = None }
}

// D-0253, std-only: `atomic_wait_op(a, op, seen)`, the wake count of the
// atomic at `a`'s address, kept by the runtime (`cb_atomic_wait`).
export fn lower_atomic_wait_op(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Vec<Expr>, shared> args, usize line) : V
{
    String lc = loc(g, x.std_body, line);
    V av = lower_expr(g, x, &args[0], None);
    if (is_never(&av.ty))
    {
        return never();
    }
    V at = into_temp(g, x, av, line);
    Type u8t = Type::TInt(IntTy::U8);
    V op0 = lower_expr(g, x, &args[1], Some(&u8t));
    V op = into_temp(g, x, op0, line);
    Type u64t = Type::TInt(IntTy::U64);
    V seen0 = lower_expr(g, x, &args[2], Some(&u64t));
    if (is_never(&seen0.ty))
    {
        return never();
    }
    V seen = into_temp(g, x, seen0, line);
    emit(x, &sprintf("cb_read((%s).tok, NULL, 0, %s);", &at.c, &lc));
    String r = fresh(g, "t");
    emit(
        x,
        &sprintf(
            "uint64_t %s = cb_atomic_wait((uint64_t)%s, (const void *)(%s).p, %s);",
            &r,
            &op.c,
            &at.c,
            &seen.c,
        ),
    );
    V { .c = r, .ty = u64t, .obj = None }
}

// What `lower_spawn` may probe for an argument's type: what `probe_safe`
// allows, and literals and enum constructors of such.
export fn spawn_probe_safe(ref<Gen, exclusive> g, ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EInt(_)   : true,
        ExprKind::EFloat(_) : true,
        ExprKind::EBool(_)  : true,
        ExprKind::EStr(_)   : true,
        ExprKind::ECall(c) : match (&Box::get(c).callee.kind)
        {
            ExprKind::EPath(p) :
            {
                if (Option::is_none(&variant_of(g, &Box::get(p).segs)))
                {
                    return false;
                }
                foreach (a in &Box::get(c).args)
                {
                    if (!spawn_probe_safe(g, a))
                    {
                        return false;
                    }
                }
                true
            },
            _                  : false,
        },
        _                   : probe_safe(e),
    }
}

// `[Spawn]`: the callee as a `fn` value and the arguments go into a heap
// block that holds them (references as held slots, resources detached from
// this statement); the new thread runs a trampoline that makes an ordinary
// call from the block, through the callee's thunk, and leaves the result at
// the block's start.
// D-0289: an exclusive reference or slice type.
fn excl_ref_or_slice(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(m)   : Box::get(m).mode == Mode::Exclusive,
        Type::TSlice(m) : Box::get(m).mode == Mode::Exclusive,
        _               : false,
    }
}

export fn lower_spawn(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Vec<Expr>, shared> args, usize line) : V
{
    // D-0315 (step 4): its consumer's arming of the handle (`arm_inert`).
    bool armed = g.decided && x.probing == 0 && match (&x.inert_result)
    {
        Some(ir) : ir.key == args_key(args),
        None     : false,
    };
    bool armed_last = match (&x.inert_result)
    {
        Some(ir) : ir.last,
        None     : false,
    };
    if (armed)
    {
        x.inert_result = None;
    }
    // A generic function item spawned without type arguments is instantiated
    // from the arguments' types, probed without lowering them.
    Option<Type> callee_expected = None;
    match (&args[0].kind)
    {
        ExprKind::EPath(pp) :
        {
            ref<PathExpr, shared> path = Box::get(pp);
            bool local = Vec::len(&path.segs) == 1 && is_bound(x, &path.segs[0]);
            match (get_fn(g, &join_segs(&path.segs)))
            {
                Some(f) :
                {
                    if (!local && Vec::len(&path.targs) == 0 && Vec::len(&f.type_params) > 0)
                    {
                        HashMap<String, Type> m = HashMap::new();
                        for (usize i = 0; i < Vec::len(&f.params) && i + 1 < Vec::len(args); i += 1)
                        {
                            ref<Expr, shared> a = &args[i + 1];
                            if (!spawn_probe_safe(g, a))
                            {
                                continue;
                            }
                            Type hint = apply(&f.params[i].ty, &m);
                            Type t0 = if (resolved(
                                &hint,
                                &f.type_params,
                            )) { probe_try(g, x, a, Some(&hint)) } else { probe_try(g, x, a, None) };
                            if (x.probe_failed)
                            {
                                x.probe_failed = false;
                                continue;
                            }
                            Type t = match (&f.params[i].ty)
                            {
                                Type::TFn(_) : match (&t0)
                                {
                                    Type::TClosure(id) : match (HashMap::get(&g.closures, *id))
                                    {
                                        Some(info) : Type::TFn(Box::new(FnTy { .params = clone(&info.params), .ret = clone(&info.ret) })),
                                        None       : clone(&t0),
                                    },
                                    _ : clone(&t0),
                                },
                                _ : clone(&t0),
                            };
                            unify(&f.params[i].ty, &t, &f.type_params, &mut m);
                        }
                        bool all = true;
                        foreach (tp in &f.type_params)
                        {
                            all = all && HashMap::contains(&m, tp);
                        }
                        if (all)
                        {
                            Vec<Type> ps = Vec::new();
                            foreach (pd in &f.params)
                            {
                                Vec::push(&mut ps, apply(&pd.ty, &m));
                            }
                            callee_expected = Some(Type::TFn(Box::new(FnTy { .params = ps, .ret = apply(
                                &f.ret,
                                &m,
                            ) })));
                        }
                    }
                },
                None    : {},
            }
        },
        _                   : {},
    }
    V fv0 = match (&callee_expected)
    {
        Some(t) : lower_expr(g, x, &args[0], Some(t)),
        None    : lower_expr(g, x, &args[0], None),
    };
    if (is_never(&fv0.ty))
    {
        return never();
    }
    Type fty = match (&fv0.ty)
    {
        Type::TFn(_)       : clone(&fv0.ty),
        Type::TClosure(id) :
        {
            ClosureInfo info = clone(Option::expect(HashMap::get(&g.closures, *id), "a lowered closure"));
            Type::TFn(Box::new(FnTy { .params = clone(&info.params), .ret = clone(&info.ret) }))
        },
        _                  :
        {
            assert(false, "cobc: spawn of a non-callable");
            Type::TVoid
        },
    };
    // D-0289: whether the thread is lent an exclusive reference, as
    // `cb_thread_start` finds from the paths it holds; a pathless program has
    // none, so the trampoline says so itself (spec/18 `contained`). A thread
    // that runs a `fn` value is never pathless (the static pass leaves it to
    // the run).
    bool lent_excl = match (&fv0.ty)
    {
        Type::TClosure(id) :
        {
            bool any = false;
            Vec<Type> cfs = closure_fields(g, *id);
            foreach (ct in &cfs)
            {
                any = any || excl_ref_or_slice(ct);
            }
            any
        },
        _                  : false,
    };
    V fv = if (is_closure(&fv0.ty)) { box_closure(g, x, fv0, clone(&fty), line) } else { fv0 };
    FnTy ft = match (&fty)
    {
        Type::TFn(f) : clone(Box::get(f)),
        _            :
        {
            assert(false, "cobc: spawn of a non-callable");
            return unit();
        },
    };
    foreach (pt in &ft.params)
    {
        lent_excl = lent_excl || excl_ref_or_slice(pt);
    }
    Type ret = clone(&ft.ret);
    String h = fresh(g, "h");
    emit(x, &sprintf("void *%s = %s;", &h, &fv.c));
    Vec<V> argv = Vec::new();
    for (usize i = 0; i < Vec::len(&ft.params) && i + 1 < Vec::len(args); i += 1)
    {
        ref<Expr, shared> a = &args[i + 1];
        ref<Type, shared> pty0 = &ft.params[i];
        // D-0315 (step 4): a by-value resource argument with no object, as a
        // call's (`noted_pend` where a later argument runs).
        bool res_arg = g.decided && x.probing == 0 && is_resource(g, pty0) && !has_refs(g, pty0);
        bool noted_arg = res_arg && !objectless_type(g, pty0) && noted_type(g, pty0);
        Option<InertResult> outer_inert = replace(&mut x.inert_result, None);
        if (res_arg)
        {
            arm_inert(g, x, a, noted_arg);
            x.raw_return_path = match (&strip_parens(a).kind)
            {
                ExprKind::EPath(_) : true,
                _                  : false,
            };
        }
        V v = lower_expr(g, x, a, Some(pty0));
        x.raw_return_path = false;
        x.inert_result = outer_inert;
        if (is_never(&v.ty))
        {
            return never();
        }
        V t0 = into_temp(g, x, v, a.line);
        V t = weaken_arg(g, x, t0, pty0, a.line);
        bool later_harmless = true;
        for (usize k = i + 2; k < Vec::len(args); k += 1)
        {
            later_harmless = later_harmless && harmless(g, x, &args[k]);
        }
        if (noted_arg && Option::is_none(&t.obj) && HashSet::contains(&x.inert_c, &t.c) && !later_harmless)
        {
            Vec::push(&mut argv, noted_pend(g, x, t, a.line));
        }
        else
        {
            Vec::push(&mut argv, t);
        }
    }
    // The block's layout: the result first, then the callee, then each
    // argument in memory form (and a resource's object id).
    u64 n = closure_id(g);
    String env = sprintf("cb_env_%v", n);
    String rc = ctype(g, &ret);
    String fields = sprintf("%s res; void *h;", &rc);
    for (usize i = 0; i < Vec::len(&ft.params); i += 1)
    {
        ref<Type, shared> pty = &ft.params[i];
        if (is_ref_type(pty))
        {
            String::appendf(&mut fields, " void *a%v;", i);
        }
        else
        {
            String c = ctype(g, pty);
            String::appendf(&mut fields, " %s a%v;", &c, i);
            if (is_resource(g, pty))
            {
                String::appendf(&mut fields, " uint64_t o%v;", i);
            }
        }
    }
    String e = fresh(g, "env");
    emit(
        x,
        &sprintf(
            "struct %s *%s = cb_env_alloc(sizeof(struct %s), _Alignof(struct %s));",
            &env,
            &e,
            &env,
            &env,
        ),
    );
    emit(x, &sprintf("%s->h = %s;", &e, &h));
    String body = String::new();
    Vec<String> call_args = Vec::new();
    for (usize i = 0; i < Vec::len(&ft.params) && i < Vec::len(&argv); i += 1)
    {
        ref<Type, shared> pty = &ft.params[i];
        ref<V, shared> t = &argv[i];
        if (is_ref_type(pty))
        {
            emit(x, &sprintf("%s->a%v = %s.p;", &e, i, &t.c));
            emit(
                x,
                &sprintf(
                    "cb_hold_ref(&%s->a%v, %s.tok, %s.p, %s, CB_NOLOC, 0);",
                    &e,
                    i,
                    &t.c,
                    &t.c,
                    &ref_tid_mode(g, pty),
                ),
            );
            String::appendf(&mut body, "    cb_ref r%v = { e->a%v, cb_load_ref(&e->a%v) };\n", i, i, i);
            Vec::push(&mut call_args, sprintf("r%v", i));
            continue;
        }
        // D-0315 (step 4): one with no object goes as its bytes alone.
        if (is_resource(g, pty) && g.decided && Option::is_none(&t.obj) && HashSet::contains(&x.inert_c, &t.c))
        {
            noted_take(x, &t.c);
            emit(x, &sprintf("%s->a%v = %s;", &e, i, &t.c));
            emit(x, &sprintf("%s->o%v = 0;", &e, i));
            Vec::push(&mut call_args, sprintf("e->a%v", i));
            continue;
        }
        emit(x, &sprintf("%s->a%v = %s;", &e, i, &t.c));
        if (is_resource(g, pty))
        {
            String o = Option::expect(clone(&t.obj), "resource argument has object");
            emit(x, &sprintf("cb_move_to(%s, &%s->a%v);", &o, &e, i));
            emit(x, &sprintf("cb_hold(%s);", &o));
            emit(x, &sprintf("%s->o%v = %s;", &e, i, &o));
            // D-0286: in a decided program the thread takes the value alone,
            // as a callee does (`give_arg`).
            String::appendf(&mut body, "    %s(e->o%v);\n", if (g.decided) { "cb_forget_obj" } else { "cb_send" }, i);
        }
        else if (has_refs(g, pty))
        {
            u32 tid = type_id(g, pty);
            emit(x, &sprintf("cb_copy_datum(&%s->a%v, &(%s), %vu);", &e, i, &t.c, tid));
            String::appendf(&mut body, "    cb_send_datum(&e->a%v, %vu);\n", i, tid);
        }
        Vec::push(&mut call_args, sprintf("e->a%v", i));
    }
    String th = thunk(g, &fty);
    String call = sprintf("%s(e->h", &th);
    foreach (ca in &call_args)
    {
        String::appendf(&mut call, ", %s", ca);
    }
    String::append(&mut call, ")");
    u32 rtid = type_id(g, &ret);
    String done = "0";
    if (is_void(&ret) || is_never(&ret))
    {
        String::appendf(&mut body, "    %s;\n", &call);
        String::append(&mut body, "    cb_env_forget(e, sizeof(*e));\n");
    }
    else if (is_ref_type(&ret))
    {
        // D-0094: a bare reference result travels in its stored form.
        String::appendf(&mut body, "    cb_ref rr = %s;\n", &call);
        String::append(&mut body, "    cb_recv_ref();\n");
        String::append(&mut body, "    e->res = rr.p;\n");
        String::appendf(
            &mut body,
            "    cb_hold_ref(&e->res, rr.tok, rr.p, %s, CB_NOLOC, 0);\n",
            &ref_tid_mode(g, &ret),
        );
        String::append(&mut body, "    cb_env_forget((uint8_t *)e + sizeof(void *), sizeof(*e) - sizeof(void *));\n");
    }
    else
    {
        String::appendf(&mut body, "    e->res = %s;\n", &call);
        String::append(&mut body, "    cb_env_forget(e, sizeof(*e));\n");
        if (is_resource(g, &ret) && g.decided && objectless_type(g, &ret))
        {
            // D-0315 (step 4): one whose end frees memory alone returns as its
            // bytes, with no object (`join` takes it so).
            done = "0";
        }
        else if (is_resource(g, &ret) && g.decided)
        {
            // D-0286: the result returns as its bytes (`take_result`).
            String rlc = loc(g, x.std_body, line);
            String::appendf(&mut body, "    uint64_t o = cb_new(&e->res, %vu, %s);\n", rtid, &rlc);
            done = "o";
        }
        else if (is_resource(g, &ret))
        {
            String::append(&mut body, "    uint64_t o = cb_recv(&e->res);\n");
            done = "o";
        }
        else if (has_refs(g, &ret))
        {
            String::appendf(&mut body, "    cb_recv_datum(&e->res, %vu);\n", rtid);
        }
    }
    String::append(&mut body, "    cb_drop_fn(e->h);\n");
    String::appendf(&mut body, "    cb_thread_done(%s);\n", &done);
    String tramp = sprintf("cb_thr_%v", n);
    // A probe discards what it lowered; the block and trampoline are written
    // only by the real lowering.
    if (x.probing == 0)
    {
        String::appendf(&mut g.thunks_out, "struct %s { %s };\n", &env, &fields);
        String::appendf(
            &mut g.thunks_out,
            "static __attribute__((noinline)) void %s_run(struct %s *e)\n{\n%s}\nvoid %s(void *p)\n{\n    struct %s *e = p;\n    jmp_buf jb;\n    if (setjmp(jb) == 0)\n    {\n    cb_thread_jmp((void *)jb);\n    cb_thread_start((void *)e, sizeof(*e), (void *)e->h);\n%s    %s_run(e);\n    }\n    else\n    {\n    cb_env_forget(e, sizeof(*e));\n    cb_drop_fn(e->h);\n    cb_thread_failed();\n    }\n}\n",
            &tramp,
            &env,
            &body,
            &tramp,
            &env,
            if (lent_excl) { "#ifdef CB_PATHLESS\n    cb_thread_lent();\n#endif\n" } else { "" },
            &tramp,
        );
    }
    Type hty = Type::THandle(Box::new(ret));
    u32 htid = type_id(g, &hty);
    String lc = loc(g, x.std_body, line);
    // D-0213 `[Thread-Lend]`: the exclusive references the block and the
    // callee's captures carry are lent to the new thread, before it can run.
    bool any_refs = false;
    foreach (pt in &ft.params)
    {
        any_refs = any_refs || has_refs(g, pt);
    }
    if (any_refs)
    {
        emit(x, &sprintf("cb_lend((void *)%s, sizeof(struct %s), %s);", &e, &env, &lc));
    }
    emit(x, &sprintf("cb_lend_fn(%s, %s);", &h, &lc));
    String hv = fresh(g, "t");
    emit(
        x,
        &sprintf(
            "uint64_t %s = cb_spawn(%s, %s, sizeof(struct %s), %vu);",
            &hv,
            &tramp,
            &e,
            &env,
            rtid,
        ),
    );
    // D-0315 (step 4): a handle its consumer takes as the last, with no object.
    if (armed && armed_last)
    {
        names_add(x, NameSet::InertC, String::clone(&hv));
        return V { .c = hv, .ty = hty, .obj = None };
    }
    String o = fresh(g, "o");
    emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &hv, htid, &lc));
    V { .c = hv, .ty = hty, .obj = Some(o) }
}

// `[Join]`: the handle is consumed; the result, claimed from the thread's
// block, is this statement's temporary.
export fn lower_join(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Vec<Expr>, shared> args, usize line) : V
{
    String lc = loc(g, x.std_body, line);
    // D-0315 (step 4): an objectless handle read as it moves (its flag), a
    // spawn's handle taken with none.
    Option<InertResult> outer_inert = replace(&mut x.inert_result, None);
    if (g.decided && x.probing == 0)
    {
        arm_inert(g, x, &args[0], true);
        x.raw_return_path = match (&strip_parens(&args[0]).kind)
        {
            ExprKind::EPath(_) : true,
            _                  : false,
        };
    }
    V hv = lower_expr(g, x, &args[0], None);
    x.raw_return_path = false;
    x.inert_result = outer_inert;
    if (is_never(&hv.ty))
    {
        return never();
    }
    Type rty = match (&hv.ty)
    {
        Type::THandle(r) : clone(Box::get(r)),
        _                :
        {
            assert(false, "cobc: join of a non-handle");
            Type::TVoid
        },
    };
    V ht = into_temp(g, x, hv, line);
    Option<String> ho = if (g.decided && Option::is_none(&ht.obj) && HashSet::contains(&x.inert_c, &ht.c))
    {
        None
    }
    else
    {
        Some(Option::expect(clone(&ht.obj), "a handle has an object"))
    };
    String t = fresh(g, "t");
    String c = ctype(g, &rty);
    emit(x, &sprintf("%s %s;", &c, &t));
    // D-0315 (step 4): a result that came with no object (`lower_spawn`: one
    // whose end frees memory alone, or plain data).
    bool plain = g.decided && ((is_resource(g, &rty) && objectless_type(g, &rty)) || (!is_resource(g, &rty) && !has_refs(
        g,
        &rty,
    ) && !is_ref_type(&rty)));
    String ro = fresh(g, "o");
    if (plain)
    {
        emit(x, &sprintf("cb_join_plain(%s, &%s);", &ht.c, &t));
    }
    else
    {
        emit(x, &sprintf("uint64_t %s = cb_join(%s, &%s);", &ro, &ht.c, &t));
    }
    // `[Handle-Destructor]` finds the result taken: nothing to discard.
    match (&ho)
    {
        Some(h) : emit(x, &sprintf("cb_consume(%s, %s);", h, &lc)),
        None    : {},
    }
    if (plain && is_void(&rty))
    {
        return unit();
    }
    if (plain && is_resource(g, &rty))
    {
        names_add(x, NameSet::InertC, String::clone(&t));
        return V { .c = t, .ty = rty, .obj = None };
    }
    if (plain)
    {
        return V { .c = t, .ty = rty, .obj = None };
    }
    if (is_void(&rty))
    {
        return unit();
    }
    if (is_ref_type(&rty))
    {
        // D-0094: the stored form back to register form.
        String rr = fresh(g, "r");
        emit(x, &sprintf("cb_ref %s = { %s, cb_load_ref(&%s) };", &rr, &t, &t));
        emit(x, &sprintf("cb_send_ref(%s.tok);", &rr));
        emit(x, "cb_recv_ref();");
        if (x.tracked)
        {
            emit_rec_ref(g, x, &rr, &rty, false, &String::copy(NOLOC));
        }
        emit(x, &sprintf("cb_env_forget((uint8_t *)&%s, sizeof(%s));", &t, &t));
        return V { .c = rr, .ty = rty, .obj = None };
    }
    Option<String> obj = if (is_resource(g, &rty))
    {
        Some(ro)
    }
    else if (has_refs(g, &rty))
    {
        u32 tid = type_id(g, &rty);
        String o = fresh(g, "o");
        emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &t, tid, &lc));
        Some(o)
    }
    else
    {
        None
    };
    V { .c = t, .ty = rty, .obj = obj }
}

// `[Lock]`: a guard owning the lock path, held in its storage as a stored
// reference (`[Repr-Guard]`).
export fn lower_lock(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Vec<Expr>, shared> args, usize line) : V
{
    String lc = loc(g, x.std_body, line);
    // D-0315 (step 4): its consumer's arming of the guard.
    bool armed = g.decided && x.probing == 0 && match (&x.inert_result)
    {
        Some(ir) : ir.last && ir.key == args_key(args),
        None     : false,
    };
    if (armed)
    {
        x.inert_result = None;
    }
    V mv = lower_expr(g, x, &args[0], None);
    if (is_never(&mv.ty))
    {
        return never();
    }
    Type inner = match (&mv.ty)
    {
        Type::TRef(m) : match (&Box::get(m).inner)
        {
            Type::TMutex(i) : clone(Box::get(i)),
            _               :
            {
                assert(false, "cobc: lock of a non-mutex");
                Type::TVoid
            },
        },
        _ :
        {
            assert(false, "cobc: lock of a non-reference");
            Type::TVoid
        },
    };
    V mt = into_temp(g, x, mv, line);
    String gt = fresh(g, "tok");
    // D-0292: the mutex's type, for its place behind a light reference.
    u32 mtid = type_id(g, &Type::TMutex(Box::new(clone(&inner))));
    emit(x, &sprintf("uint64_t %s = cb_lock(%s.tok, %s.p, %vu, %s);", &gt, &mt.c, &mt.c, mtid, &lc));
    // D-0204: an interior that may hold an exclusive reference lends its
    // locker another's data.
    if (may_hold_excl_ref(&g.prog.table, &inner))
    {
        emit(x, "cb_thread_lent();");
    }
    Type gty = Type::TGuard(Box::new(inner));
    u32 tid = type_id(g, &gty);
    String gv = fresh(g, "g");
    emit(x, &sprintf("void *%s = %s.p;", &gv, &mt.c));
    // D-0315 (step 4): a guard its consumer takes as its last.
    if (armed)
    {
        emit(x, &sprintf("cb_store_ref(&%s, %s);", &gv, &gt));
        names_add(x, NameSet::InertC, String::clone(&gv));
        return V { .c = gv, .ty = gty, .obj = None };
    }
    String o = fresh(g, "o");
    emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &gv, tid, &lc));
    emit(x, &sprintf("cb_store_ref(&%s, %s);", &gv, &gt));
    V { .c = gv, .ty = gty, .obj = Some(o) }
}

// A closure's type as the `fn` type of its signature, where a `fn` type is
// the parameter's; any other type as it is.
export fn closure_as_fn(ref<Gen, shared> g, ref<Type, shared> pty, ref<Type, shared> t) : Type
{
    if (is_fn_type(pty))
    {
        match (t)
        {
            Type::TClosure(id) : match (HashMap::get(&g.closures, *id))
            {
                Some(info) : return Type::TFn(Box::new(FnTy { .params = clone(&info.params), .ret = clone(&info.ret) })),
                None       : {},
            },
            _ : {},
        }
    }
    clone(t)
}

export fn is_fn_type(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TFn(_) : true,
        _            : false,
    }
}

export fn is_ref_type(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(_) : true,
        _             : false,
    }
}

// `map_err(r, f)`: `Ok(v)` passes through, `Err(e)` becomes `Err(f(e))`; the
// source's contents relocate either way.
export fn lower_map_err(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Vec<Expr>, shared> args, usize line) : V
{
    String lc = loc(g, x.std_body, line);
    V rv = lower_expr(g, x, &args[0], None);
    if (is_never(&rv.ty))
    {
        return never();
    }
    V rt = into_temp(g, x, rv, line);
    Type t_ty = Type::TVoid;
    Type e_ty = Type::TVoid;
    match (&rt.ty)
    {
        Type::TNamed(n) :
        {
            assert(
                Box::get(n).name == "std::Result" && Vec::len(&Box::get(n).args) == 2,
                "cobc: map_err on a non-Result",
            );
            t_ty = clone(&Box::get(n).args[0]);
            e_ty = clone(&Box::get(n).args[1]);
        },
        _               : assert(false, "cobc: map_err on a non-Result"),
    }
    V fv = lower_expr(g, x, &args[1], None);
    Type e2 = match (&fv.ty)
    {
        Type::TFn(f)       : clone(&Box::get(f).ret),
        Type::TClosure(id) : clone(&Option::expect(HashMap::get(&g.closures, *id), "a lowered closure").ret),
        _                  :
        {
            assert(false, "cobc: map_err's function");
            Type::TVoid
        },
    };
    Vec<Type> oargs = Vec::new();
    Vec::push(&mut oargs, clone(&t_ty));
    Vec::push(&mut oargs, clone(&e2));
    Type out_ty = Type::TNamed(Box::new(NamedTy { .name = "std::Result", .args = oargs }));
    String oc = ctype(g, &out_ty);
    String o = fresh(g, "me");
    emit(x, &sprintf("%s %s;", &oc, &o));
    emit(x, &sprintf("if (%s.tag == 0u) {", &rt.c));
    x.ind += 1;
    emit(x, &sprintf("%s.tag = 0u;", &o));
    V pv0 = V { .c = sprintf("%s.u.v0", &rt.c), .ty = clone(&t_ty), .obj = None };
    V pv = match (&t_ty)
    {
        Type::TRef(_) : read_ref_slot(x, &pv0.c, &t_ty),
        _             : pv0,
    };
    store(g, x, &sprintf("%s.u.v0", &o), &t_ty, &pv);
    x.ind -= 1;
    emit(x, "} else {");
    x.ind += 1;
    // The Err payload becomes the call's argument.
    V ev0 = V { .c = sprintf("%s.u.v1", &rt.c), .ty = clone(&e_ty), .obj = None };
    V ev1 = match (&e_ty)
    {
        Type::TRef(_) : read_ref_slot(x, &ev0.c, &e_ty),
        _             : ev0,
    };
    bool e_res = is_resource(g, &e_ty);
    V ev = if (e_res)
    {
        String t = fresh(g, "t");
        String c = ctype(g, &e_ty);
        emit(x, &sprintf("%s %s = %s;", &c, &t, &ev1.c));
        if (g.decided)
        {
            // D-0286: handed over as it is, with no object.
            names_add(x, NameSet::InertC, String::clone(&t));
            V { .c = t, .ty = clone(&e_ty), .obj = None }
        }
        else
        {
            u32 tid = type_id(g, &e_ty);
            String oo = fresh(g, "o");
            emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &oo, &t, tid, &lc));
            V { .c = t, .ty = clone(&e_ty), .obj = Some(oo) }
        }
    }
    else
    {
        into_temp(g, x, ev1, line)
    };
    bool e_ref = match (&e_ty)
    {
        Type::TRef(_) : true,
        _             : false,
    };
    if (e_res)
    {
        give_arg(g, x, &ev, "map_err's error");
    }
    else if (has_refs(g, &e_ty) && !e_ref)
    {
        u32 tid = type_id(g, &e_ty);
        emit(x, &sprintf("cb_send_datum(&%s, %vu);", &ev.c, tid));
    }
    Type fty = clone(&fv.ty);
    V res0 = match (&fty)
    {
        Type::TFn(_)       :
        {
            V fh = into_temp(g, x, fv, line);
            String th = thunk(g, &fty);
            finish_call(g, x, sprintf("%s(%s, %s)", &th, &fh.c, &ev.c), clone(&e2), line)
        },
        Type::TClosure(id) :
        {
            ClosureInfo info = clone(Option::expect(HashMap::get(&g.closures, *id), "a lowered closure"));
            String co = Option::expect(clone(&fv.obj), "cobc: closure without an object");
            String root = fresh(g, "root");
            emit(x, &sprintf("uint64_t %s = cb_bind(%s);", &root, &co));
            String tok = fresh(g, "tok");
            emit(
                x,
                &sprintf("uint64_t %s = cb_borrow(%s, NULL, 0, CB_EXCLUSIVE, %s);", &tok, &root, &lc),
            );
            String self_ref = sprintf("((cb_ref){ (void *)&(%s), %s })", &fv.c, &tok);
            finish_call(g, x, sprintf("%s(%s, %s)", &info.cname, &self_ref, &ev.c), clone(&e2), line)
        },
        _                  : unit(),
    };
    V res = into_temp(g, x, res0, line);
    emit(x, &sprintf("%s.tag = 1u;", &o));
    store(g, x, &sprintf("%s.u.v1", &o), &e2, &res);
    if (is_resource(g, &e2))
    {
        String ro = Option::expect(clone(&res.obj), "resource result has object");
        emit(x, &sprintf("cb_absorb(%s);", &ro));
    }
    x.ind -= 1;
    emit(x, "}");
    match (&rt.obj)
    {
        Some(ro) : emit(x, &sprintf("cb_end_moved_out(%s);", ro)),
        None     : {},
    }
    register_temp(g, x, o, out_ty, line)
}

// `text_write(x, p)`: a number's or a `bool`'s text into the buffer at `p`.
export fn lower_text_write(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Vec<Expr>, shared> args, usize line) : V
{
    V v = lower_expr(g, x, &args[0], None);
    if (is_never(&v.ty))
    {
        return never();
    }
    Type vty = clone(&v.ty);
    String xc = into_temp_c(g, x, v, line);
    V p0 = lower_expr(g, x, &args[1], None);
    String pc = into_temp_c(g, x, p0, line);
    String c = match (&vty)
    {
        Type::TInt(t) :
        {
            String wide = if (int_ty_signed(*t))
            {
                sprintf(
                    "(cb_u128)(cb_i128)(%s)",
                    &xc,
                )
            }
            else { sprintf("(cb_u128)(%s)", &xc) };
            sprintf(
                "cb_text_int((uint64_t)(%s >> 64), (uint64_t)(%s), %vu, (void *)(%s))",
                &wide,
                &wide,
                if (int_ty_signed(*t)) { 1 } else { 0 },
                &pc,
            )
        },
        Type::TF64    : sprintf("cb_text_f64(%s, (void *)(%s))", &xc, &pc),
        Type::TF32    : sprintf("cb_text_f32(%s, (void *)(%s))", &xc, &pc),
        Type::TBool   : sprintf("cb_text_bool(%s, (void *)(%s))", &xc, &pc),
        _             :
        {
            assert(false, "cobc: text of an unprintable type");
            String::new()
        },
    };
    V { .c = c, .ty = usize_ty(), .obj = None }
}

// `parse_check<T>(p, n)` (the length of the text's number, or a negative
// error) and `parse_value<T>(p, n)` (the number itself), for an integer, a
// float or a `bool` (D-0181).
export fn lower_parse(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    bool check,
    Type t,
    ref<Vec<Expr>, shared> args,
    usize line,
) : V
{
    V p0 = lower_expr(g, x, &args[0], None);
    String p = into_temp_c(g, x, p0, line);
    Type us = usize_ty();
    V n0 = lower_expr(g, x, &args[1], Some(&us));
    String n = into_temp_c(g, x, n0, line);
    Type isz = Type::TInt(IntTy::Isize);
    match (&t)
    {
        Type::TInt(it) :
        {
            String head = sprintf(
                "cb_parse_int((const void *)(%s), %s, %vu, %vu",
                &p,
                &n,
                if (int_ty_signed(*it)) { 1 } else { 0 },
                int_ty_bits(*it, 64),
            );
            if (check)
            {
                return V { .c = sprintf("%s, 0)", &head), .ty = isz, .obj = None };
            }
            String o = fresh(g, "o");
            emit(x, &sprintf("uint64_t %s[2];", &o));
            emit(x, &sprintf("%s, %s);", &head, &o));
            String ct = ctype(g, &t);
            return V { .c = sprintf(
                "((%s)((((cb_u128)%s[0]) << 64) | %s[1]))",
                &ct,
                &o,
                &o,
            ), .ty = clone(&t), .obj = None };
        },
        Type::TF64     : {},
        Type::TF32     : {},
        Type::TBool    :
        {
            String head = sprintf("cb_parse_bool((const void *)(%s), %s", &p, &n);
            if (check)
            {
                return V { .c = sprintf("%s, 0)", &head), .ty = isz, .obj = None };
            }
            String o = fresh(g, "o");
            emit(x, &sprintf("uint8_t %s;", &o));
            emit(x, &sprintf("%s, &%s);", &head, &o));
            return V { .c = sprintf("((uint8_t)%s)", &o), .ty = Type::TBool, .obj = None };
        },
        _              :
        {
            assert(false, "cobc: parse of a non-numeric type");
            return unit();
        },
    }
    bool single = match (&t)
    {
        Type::TF32 : true,
        _          : false,
    };
    String head = sprintf("cb_parse_float((const void *)(%s), %s, %vu", &p, &n, if (single) { 1 } else { 0 });
    if (check)
    {
        return V { .c = sprintf("%s, 0)", &head), .ty = isz, .obj = None };
    }
    String o = fresh(g, "o");
    emit(x, &sprintf("double %s;", &o));
    emit(x, &sprintf("%s, &%s);", &head, &o));
    String ct = ctype(g, &t);
    V { .c = sprintf("((%s)%s)", &ct, &o), .ty = t, .obj = None }
}

export fn lower_intrinsic(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> name,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    Option<ref<Type, shared>> expected,
    usize line,
) : V
{
    String lc = loc(g, x.std_body, line);
    if (StringView::starts_with(name, "simd_"))
    {
        return lower_simd_intrinsic(g, x, name, targs, args, expected, line);
    }
    if (*name == "atomic_op")
    {
        return lower_atomic_op(g, x, args, line);
    }
    if (*name == "atomic_wait_op")
    {
        return lower_atomic_wait_op(g, x, args, line);
    }
    if (*name == "cpu_op")
    {
        // D-0253: 0 a sequentially consistent fence, 1 a spin hint.
        u128 op = match (&strip_parens(&args[0]).kind)
        {
            ExprKind::EInt(l) : Box::get(l).v,
            _                 :
            {
                assert(false, "cobc: a cpu operation that is not a literal");
                0
            },
        };
        if (op == 0)
        {
            emit(x, "__atomic_thread_fence(__ATOMIC_SEQ_CST);");
        }
        else
        {
            emit(x, "cb_spin_hint();");
            emit(
                x,
                "if (__builtin_expect(__atomic_load_n(&cb_sched_flag, __ATOMIC_RELAXED) != 0, 0)) cb_atomic_point();",
            );
        }
        return unit();
    }
    if (*name == "spawn")
    {
        return lower_spawn(g, x, args, line);
    }
    if (*name == "join_status" || *name == "cancel")
    {
        // D-0204: `std::try_join`'s primitive and `cancel(&h)`, through the
        // reference to the handle.
        V hv = lower_expr(g, x, &args[0], None);
        if (is_never(&hv.ty))
        {
            return never();
        }
        V ht = into_temp(g, x, hv, line);
        emit(x, &sprintf("cb_read(%s.tok, NULL, 0, %s);", &ht.c, &lc));
        String tid = sprintf("(*(uint64_t *)(%s.p))", &ht.c);
        if (*name == "cancel")
        {
            emit(x, &sprintf("cb_cancel(%s);", &tid));
            return unit();
        }
        Type u8t = Type::TInt(IntTy::U8);
        V mv = lower_expr(g, x, &args[1], Some(&u8t));
        V mt = into_temp(g, x, mv, line);
        String t = fresh(g, "t");
        emit(x, &sprintf("uint64_t %s = cb_join_status(%s, %s);", &t, &tid, &mt.c));
        return V { .c = t, .ty = Type::TInt(IntTy::U64), .obj = None };
    }
    if (*name == "join")
    {
        return lower_join(g, x, args, line);
    }
    if (*name == "lock")
    {
        return lower_lock(g, x, args, line);
    }
    if (*name == "Mutex::new")
    {
        // `[Mutex-New]`: `inner` holds the value; the state cells are zero.
        Option<Type> hint = if (Vec::len(targs) > 0)
        {
            Some(apply(&targs[0], &x.subst))
        }
        else
        {
            match (expected)
            {
                Some(t) : match (t)
                {
                    Type::TMutex(i) : Some(clone(Box::get(i))),
                    _               : None,
                },
                None : None,
            }
        };
        // D-0315 (step 4): the consumer's arming of the mutex, and its value
        // taken with no object (nothing runs after it).
        bool armed = g.decided && x.probing == 0 && match (&x.inert_result)
        {
            Some(ir) : ir.key == args_key(args),
            None     : false,
        };
        bool armed_last = match (&x.inert_result)
        {
            Some(ir) : ir.last,
            None     : false,
        };
        Option<InertResult> outer_inert = replace(&mut x.inert_result, None);
        if (g.decided && x.probing == 0)
        {
            arm_inert(g, x, &args[0], true);
            x.raw_return_path = match (&strip_parens(&args[0]).kind)
            {
                ExprKind::EPath(_) : true,
                _                  : false,
            };
        }
        V v0 = match (&hint)
        {
            Some(h) : lower_expr(g, x, &args[0], Some(h)),
            None    : lower_expr(g, x, &args[0], None),
        };
        x.raw_return_path = false;
        x.inert_result = outer_inert;
        if (is_never(&v0.ty))
        {
            return never();
        }
        V v = into_temp(g, x, v0, line);
        Type inner = clone(&v.ty);
        Type mty = Type::TMutex(Box::new(clone(&inner)));
        String c = ctype(g, &mty);
        String t = fresh(g, "t");
        emit(x, &sprintf("%s %s;", &c, &t));
        emit(x, &sprintf("%s.state = 0;", &t));
        store(g, x, &sprintf("%s.inner", &t), &inner, &v);
        bool inner_bare = Option::is_none(&v.obj) && HashSet::contains(&x.inert_c, &v.c);
        if (is_resource(g, &inner) && !inner_bare)
        {
            String o = Option::expect(clone(&v.obj), "resource has object");
            emit(x, &sprintf("cb_absorb(%s);", &o));
        }
        if (armed && (!is_resource(g, &inner) || inner_bare) && !has_refs(g, &mty) && (objectless_type(g, &mty) || (armed_last && noted_type(
            g,
            &mty,
        ))))
        {
            names_add(x, NameSet::InertC, String::clone(&t));
            return V { .c = t, .ty = mty, .obj = None };
        }
        if (inner_bare && is_resource(g, &inner))
        {
            names_add(x, NameSet::InertC, String::clone(&t));
            V tv = V { .c = String::clone(&t), .ty = clone(&mty), .obj = None };
            Option<String> o = materialize(g, x, &tv, line);
            names_drop(x, NameSet::InertC, &t);
            return V { .c = t, .ty = mty, .obj = o };
        }
        return register_temp(g, x, t, mty, line);
    }
    if (*name == "std::Result::map_err")
    {
        return lower_map_err(g, x, args, line);
    }
    if (*name == "text_write")
    {
        return lower_text_write(g, x, args, line);
    }
    if (*name == "parse_check" || *name == "parse_value")
    {
        return lower_parse(g, x, *name == "parse_check", apply(&targs[0], &x.subst), args, line);
    }
    if (*name == "slice_len")
    {
        P p0 = lower_place(g, x, &args[0]);
        P p = auto_deref(g, x, p0);
        return V { .c = sprintf("(%s).len", &p.c), .ty = usize_ty(), .obj = None };
    }
    if (*name == "str_len")
    {
        V s = lower_expr(g, x, &args[0], None);
        V st = into_temp(g, x, s, line);
        return V { .c = sprintf("(%s).n", &st.c), .ty = usize_ty(), .obj = None };
    }
    if (*name == "str_byte")
    {
        V s = lower_expr(g, x, &args[0], None);
        V st = into_temp(g, x, s, line);
        Type us = usize_ty();
        V i = lower_expr(g, x, &args[1], Some(&us));
        V it = into_temp(g, x, i, line);
        emit(x, &sprintf("cb_index_check((uint64_t)%s, %s.n, %s);", &it.c, &st.c, &lc));
        return V { .c = sprintf("%s.p[%s]", &st.c, &it.c), .ty = Type::TInt(IntTy::U8), .obj = None };
    }
    if (*name == "str_ptr")
    {
        V s = lower_expr(g, x, &args[0], None);
        V st = into_temp(g, x, s, line);
        return V { .c = sprintf(
            "((uint8_t *)(%s).p)",
            &st.c,
        ), .ty = Type::TRawptr(Box::new(Type::TInt(IntTy::U8))), .obj = None };
    }
    if (*name == "$fmt")
    {
        return lower_fmt(g, x, args, line);
    }
    if (*name == "$require_fail")
    {
        // D-0317 (cobc's `$require_fail`): the diagnostic the requirement
        // names, with its message, at the call that broke it: the caller's
        // position as the body found it on entry (`cb_rq_f`, `cb_rq_l`); in
        // `std`'s code, `CB_NOLOC`.
        String rseg = match (&args[0].kind)
        {
            ExprKind::EPath(p) : String::clone(&Box::get(p).segs[0]),
            _                  :
            {
                assert(false, "cobc: a requirement's diagnostic");
                String::new()
            },
        };
        String rid = sprintf("diag.%s", &StringView::replace(&rseg, "_", "-"));
        str rat = if (lc == NOLOC) { NOLOC } else { "cb_rq_f, cb_rq_l" };
        if (Vec::len(args) > 1)
        {
            Type rts = Type::TStr;
            V rv = lower_expr(g, x, &args[1], Some(&rts));
            V rt = into_temp(g, x, rv, line);
            emit(x, &sprintf("cb_fault_msg(\"%s\", %s.p, %s.n, %s);", &rid, &rt.c, &rt.c, rat));
            return never();
        }
        emit(x, &sprintf("cb_fault(\"%s\", %s);", &rid, rat));
        return never();
    }
    if (*name == "$assert_fail")
    {
        // D-0065: the fault, with `$fmt`'s text as its message.
        if (Vec::len(args) == 0)
        {
            emit(x, &sprintf("cb_fault(\"diag.assert-failed\", %s);", &lc));
            return never();
        }
        Type ts = Type::TStr;
        V v = lower_expr(g, x, &args[0], Some(&ts));
        V t = into_temp(g, x, v, line);
        emit(x, &sprintf("cb_fault_msg(\"diag.assert-failed\", %s.p, %s.n, %s);", &t.c, &t.c, &lc));
        return never();
    }
    if (*name == "std::print")
    {
        // `str` and `ref<String, shared>` go to `std`'s two helpers; numbers
        // and `bool` to the runtime.
        Type t = probe_type(g, x, &args[0], None);
        Option<str> helper = match (&t)
        {
            Type::TStr : Some("std::print_str"),
            Type::TRef(m) : if (is_named(
                &Box::get(m).inner,
                "std::String",
            )) { Some("std::print_string") } else { None },
            _          : None,
        };
        match (helper)
        {
            Some(h) :
            {
                FnDecl f = Option::expect(get_fn(g, &String::copy(h)), "std's print helper");
                return lower_user_call(g, x, h, &f, &Vec::new(), args, None, line);
            },
            None    : {},
        }
        V v = lower_expr(g, x, &args[0], None);
        if (is_never(&v.ty))
        {
            return never();
        }
        Type vty = clone(&v.ty);
        String xc = into_temp_c(g, x, v, line);
        String call = match (&vty)
        {
            Type::TInt(i) :
            {
                String wide = if (int_ty_signed(*i))
                {
                    sprintf(
                        "(cb_u128)(cb_i128)(%s)",
                        &xc,
                    )
                }
                else { sprintf("(cb_u128)(%s)", &xc) };
                sprintf(
                    "{ cb_u128 _p = %s; cb_print_int((uint64_t)(_p >> 64), (uint64_t)_p, %vu); }",
                    &wide,
                    if (int_ty_signed(*i)) { 1 } else { 0 },
                )
            },
            Type::TF64    : sprintf("cb_print_f64(%s);", &xc),
            Type::TF32    : sprintf("cb_print_f32(%s);", &xc),
            Type::TBool   : sprintf("cb_print_bool(%s);", &xc),
            _             :
            {
                assert(false, "cobc: print of an unprintable type");
                String::new()
            },
        };
        emit(x, &call);
        return unit();
    }
    if (*name == "append_native")
    {
        // `str` and `ref<String, shared>` go to `std`'s two helpers, numbers
        // and `bool` to `append_text`.
        Type t = probe_type(g, x, &args[1], None);
        Vec<Type> ta = Vec::new();
        str h = match (&t)
        {
            Type::TStr      : "std::String::append_str",
            Type::TRef(m) : if (is_named(
                &Box::get(m).inner,
                "std::String",
            )) { "std::String::append_string" } else { "std::String::append_text" },
            Type::TNamed(n) : if (Box::get(n).name == "std::StringView") { "std::String::append_view" } else { "std::String::append_text" },
            _               : "std::String::append_text",
        };
        if (h == "std::String::append_text")
        {
            Vec::push(&mut ta, clone(&t));
        }
        FnDecl f = Option::expect(get_fn(g, &String::copy(h)), "std's append helper");
        return lower_user_call(g, x, h, &f, &ta, args, None, line);
    }
    match (lower_intrinsic_numeric(g, x, name, targs, args, expected, line, &lc))
    {
        Some(v) : return v,
        None    : {},
    }
    match (lower_intrinsic_raw(g, x, name, targs, args, line, &lc))
    {
        Some(v) : return v,
        None    : {},
    }
    match (lower_intrinsic_more(g, x, name, targs, args, expected, line, &lc))
    {
        Some(v) : return v,
        None    : {},
    }
    eprintf("cbc: the intrinsic `%s` is not ported yet\n", name);
    assert(false, "cbc: an intrinsic not ported yet");
    unit()
}

// D-0100: a format argument holding the name of the variant `tag` selects.
export fn variant_name_text(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> tag,
    ref<Vec<String>, shared> names,
) : String
{
    String nm = fresh(g, "vn");
    String nl = fresh(g, "vl");
    String sw = sprintf("const char *%s = \"\"; uint64_t %s = 0; switch (%s) {", &nm, &nl, tag);
    for (usize i = 0; i < Vec::len(names); i += 1)
    {
        String::append(
            &mut sw,
            &sprintf(" case %vu: %s = \"%s\"; %s = %vu; break;", i, &nm, &names[i], &nl, StringView::len(&names[i])),
        );
    }
    String::append(&mut sw, " default: break; }");
    emit(x, &sw);
    sprintf("{ 3u, 0u, 0, 0, 0.0, (const uint8_t *)%s, %s }", &nm, &nl)
}

export fn variant_names(ref<Gen, shared> g, ref<String, shared> ename) : Vec<String>
{
    Vec<String> out = Vec::new();
    match (HashMap::get(&g.prog.table.enums, ename))
    {
        Some(ed) :
        {
            foreach (v in &ed.variants)
            {
                Vec::push(&mut out, String::clone(&v.name));
            }
        },
        None     : {},
    }
    out
}

// `rule.stdlib.format` (D-0038): the text of `printf` and `String::appendf`
// (`modres` made them `print`/`append` of `$fmt(…)`), in the runtime's
// buffer until that takes it.
export fn lower_fmt(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Vec<Expr>, shared> args, usize line) : V
{
    V fv0 = lower_expr(g, x, &args[0], None);
    V fv = into_temp(g, x, fv0, line);
    Vec<String> inits = Vec::new();
    // D-0297: each argument as a literal format written in place would take
    // it (`FaOther`: only `cb_format` takes it).
    Vec<FmtArg> pargs = Vec::new();
    for (usize k = 1; k < Vec::len(args); k += 1)
    {
        ref<Expr, shared> a0 = &args[k];
        // `&s` of a `String` local that no other argument names: read where
        // it is formatted, the read's check through `s`'s root standing for
        // the borrow's; no path is minted.
        match (fmt_direct_string(g, x, args, a0))
        {
            Some(b) :
            {
                if (!HashSet::contains(&x.objectless_c, &b.c))
                {
                    String lc = loc(g, x.std_body, a0.line);
                    emit(x, &sprintf("cb_read(%s, NULL, 0, %s);", &b.root, &lc));
                }
                else
                {
                    objectless_use(g, x, &b.c, a0.line);
                }
                Vec::push(&mut inits, sprintf("{ 3u, 0u, 0, 0, 0.0, (%s).bytes.ptr, (%s).bytes.len }", &b.c, &b.c));
                Vec::push(&mut pargs, fmt_text(sprintf("(%s).bytes.ptr", &b.c), sprintf("(%s).bytes.len", &b.c)));
                continue;
            },
            None    : {},
        }
        // A reference to a number, `bool` or `str` is formatted as the value
        // it refers to (D-0042).
        Type at = probe_type(g, x, a0, None);
        bool deref = match (&at)
        {
            Type::TRef(m) :
            {
                match (&Box::get(m).inner)
                {
                    Type::TInt(_) : true,
                    Type::TF32    : true,
                    Type::TF64    : true,
                    Type::TBool   : true,
                    Type::TStr    : true,
                    _             : false,
                }
            },
            _             : false,
        };
        Expr held = if (deref)
        {
            Expr c = renumbered(g, a0);
            synth(g, ExprKind::EDeref(Box::new(c)), a0.line, a0.col)
        }
        else
        {
            clone(a0)
        };
        ref<Expr, shared> a = if (deref) { &held } else { a0 };
        V v0 = lower_expr(g, x, a, None);
        if (is_never(&v0.ty))
        {
            return never();
        }
        V v = into_temp(g, x, v0, a.line);
        ref<String, shared> xc = &v.c;
        Vec::push(&mut pargs, fmt_arg_of(g, &v));
        String init = match (&v.ty)
        {
            Type::TInt(i)   :
            {
                String wide = if (int_ty_signed(*i))
                {
                    sprintf(
                        "(cb_u128)(cb_i128)(%s)",
                        xc,
                    )
                }
                else { sprintf("(cb_u128)(%s)", xc) };
                sprintf(
                    "{ %vu, %vu, (uint64_t)(%s >> 64), (uint64_t)(%s), 0.0, 0, 0 }",
                    if (int_ty_signed(*i)) { 1 } else { 0 },
                    int_ty_bits(*i, 64),
                    &wide,
                    &wide,
                )
            },
            Type::TF64      : sprintf("{ 2u, 64u, 0, 0, %s, 0, 0 }", xc),
            Type::TF32      : sprintf("{ 2u, 32u, 0, 0, (double)(%s), 0, 0 }", xc),
            Type::TStr      : sprintf("{ 3u, 0u, 0, 0, 0.0, (%s).p, (%s).n }", xc, xc),
            Type::TBool : sprintf(
                "{ 3u, 0u, 0, 0, 0.0, (const uint8_t *)((%s) ? \"true\" : \"false\"), (%s) ? 4u : 5u }",
                xc,
                xc,
            ),
            Type::TNamed(n) :
            {
                if (Box::get(n).name == "std::StringView")
                {
                    // D-0053: a view's bytes, read through its slice's reference.
                    String lc = loc(g, x.std_body, a.line);
                    emit(x, &sprintf("cb_read(cb_load_ref(&(%s).bytes.src), NULL, 0, %s);", xc, &lc));
                    sprintf("{ 3u, 0u, 0, 0, 0.0, (const uint8_t *)(%s).bytes.data, (%s).bytes.len }", xc, xc)
                }
                else
                {
                    // D-0100: an enum prints as its variant's name.
                    assert(
                        HashMap::contains(&g.prog.table.enums, &Box::get(n).name),
                        "cobc: a format argument of an unformattable type",
                    );
                    Vec<String> names = variant_names(g, &Box::get(n).name);
                    variant_name_text(g, x, &tag_of(g, &v.ty, xc), &names)
                }
            },
            Type::TRef(m)   :
            {
                ref<Type, shared> inner = &Box::get(m).inner;
                String lc = loc(g, x.std_body, a.line);
                match (inner)
                {
                    Type::TNamed(n) :
                    {
                        if (HashMap::contains(&g.prog.table.enums, &Box::get(n).name))
                        {
                            Vec<String> names = variant_names(g, &Box::get(n).name);
                            emit(x, &sprintf("cb_read((%s).tok, NULL, 0, %s);", xc, &lc));
                            String et = ctype(g, inner);
                            return_text(
                                g,
                                x,
                                &tag_of(g, inner, &sprintf("(*(%s *)(%s).p)", &et, xc)),
                                &names,
                            )
                        }
                        else
                        {
                            // A `&String`: its bytes, read through the reference.
                            emit(x, &sprintf("cb_read((%s).tok, NULL, 0, %s);", xc, &lc));
                            String sc = ctype(g, &named("std::String", Vec::new()));
                            sprintf(
                                "{ 3u, 0u, 0, 0, 0.0, ((%s *)(%s).p)->bytes.ptr, ((%s *)(%s).p)->bytes.len }",
                                &sc,
                                xc,
                                &sc,
                                xc,
                            )
                        }
                    },
                    _               :
                    {
                        emit(x, &sprintf("cb_read((%s).tok, NULL, 0, %s);", xc, &lc));
                        String sc = ctype(g, &named("std::String", Vec::new()));
                        sprintf(
                            "{ 3u, 0u, 0, 0, 0.0, ((%s *)(%s).p)->bytes.ptr, ((%s *)(%s).p)->bytes.len }",
                            &sc,
                            xc,
                            &sc,
                            xc,
                        )
                    },
                }
            },
            _               :
            {
                assert(false, "cobc: a format argument of an unformattable type");
                String::new()
            },
        };
        Vec::push(&mut inits, init);
    }
    match (&strip_parens(&args[0]).kind)
    {
        ExprKind::EStr(f) :
        {
            match (fmt_plan(StringView::as_bytes(f), &pargs))
            {
                Some(ops) : return fmt_in_place(g, x, &fv.c, &ops, &pargs),
                None      : {},
            }
        },
        _                 : {},
    }
    String arr = fresh(g, "fa");
    String out = fresh(g, "fs");
    if (Vec::len(&inits) == 0)
    {
        emit(
            x,
            &sprintf("cb_str %s; cb_format((%s).p, (%s).n, NULL, 0, &%s);", &out, &fv.c, &fv.c, &out),
        );
    }
    else
    {
        emit(x, &sprintf("cb_fmt_arg %s[] = { %s };", &arr, &String::join(&inits, ", ")));
        emit(
            x,
            &sprintf(
                "cb_str %s; cb_format((%s).p, (%s).n, %s, %v, &%s);",
                &out,
                &fv.c,
                &fv.c,
                &arr,
                Vec::len(&inits),
                &out,
            ),
        );
    }
    V { .c = out, .ty = Type::TStr, .obj = None }
}

// D-0297: a `$fmt` argument as a literal format written in place takes it:
// an integer of at most 64 bits (signed, its width, the C value), or text
// (its bytes' pointer and length).
struct FmtInt
{
    bool is_signed;
    u32 bits;
    String x;
}

struct FmtText
{
    String p;
    String n;
}

enum FmtArg
{
    FaInt(FmtInt),
    FaText(FmtText),
    FaOther,
}

// One piece of a literal format written in place: `kind` 0, bytes of the
// format itself (`a` the offset, `b` the length); 1 a decimal or 2 a
// hexadecimal integer (`a` the argument, `b` the width, `how` `cb_fmt_pad`'s,
// `upper`); 3 an argument's text as it is (`a`).
struct FmtOp
{
    u32 kind;
    usize a;
    usize b;
    u32 how;
    bool upper;
}

fn fmt_text(String p, String n) : FmtArg
{
    FmtArg::FaText(FmtText { .p = p, .n = n })
}

fn fmt_op(u32 kind, usize a, usize b, u32 how, bool upper) : FmtOp
{
    FmtOp { .kind = kind, .a = a, .b = b, .how = how, .upper = upper }
}

fn fmt_arg_of(ref<Gen, exclusive> g, ref<V, shared> v) : FmtArg
{
    ref<String, shared> xc = &v.c;
    match (&v.ty)
    {
        Type::TInt(i)   :
        {
            u32 bits = int_ty_bits(*i, 64);
            if (bits <= 64)
            {
                return FmtArg::FaInt(FmtInt { .is_signed = int_ty_signed(*i), .bits = bits, .x = String::clone(xc) });
            }
            FmtArg::FaOther
        },
        Type::TStr      : fmt_text(sprintf("(%s).p", xc), sprintf("(%s).n", xc)),
        Type::TBool : fmt_text(
            sprintf("(const uint8_t *)((%s) ? \"true\" : \"false\")", xc),
            sprintf("((%s) ? 4u : 5u)", xc),
        ),
        Type::TNamed(n) :
        {
            if (Box::get(n).name == "std::StringView")
            {
                return fmt_text(sprintf("(const uint8_t *)(%s).bytes.data", xc), sprintf("(%s).bytes.len", xc));
            }
            FmtArg::FaOther
        },
        Type::TRef(m)   :
        {
            match (&Box::get(m).inner)
            {
                Type::TNamed(n) :
                {
                    if (HashMap::contains(&g.prog.table.enums, &Box::get(n).name))
                    {
                        return FmtArg::FaOther;
                    }
                },
                _               : {},
            }
            String sc = ctype(g, &named("std::String", Vec::new()));
            fmt_text(sprintf("((%s *)(%s).p)->bytes.ptr", &sc, xc), sprintf("((%s *)(%s).p)->bytes.len", &sc, xc))
        },
        _               : FmtArg::FaOther,
    }
}

// The pieces of the literal format `f` when each of its specifiers is one
// written in place -- `%v`, `%d`, `%i` or `%u` of an integer and `%x` or
// `%X`, with a width and the `-` and `0` flags, and `%v` or `%s` of text with
// no width -- else `None` (`cb_format` renders it). The front end has
// checked `f` against its arguments.
fn fmt_plan(slice<u8, shared> f, ref<Vec<FmtArg>, shared> args) : Option<Vec<FmtOp>>
{
    usize n = slice_len(f);
    Vec<FmtOp> ops = Vec::new();
    usize k = 0;
    usize i = 0;
    usize start = 0;
    while (i < n)
    {
        if (f[i] != b'%')
        {
            i += 1;
            continue;
        }
        if (i > start)
        {
            Vec::push(&mut ops, fmt_op(0, start, i - start, 0, false));
        }
        i += 1;
        if (i < n && f[i] == b'%')
        {
            Vec::push(&mut ops, fmt_op(0, i, 1, 0, false));
            i += 1;
            start = i;
            continue;
        }
        bool left = false;
        bool zero = false;
        while (i < n)
        {
            u8 c = f[i];
            if (c == b'-')
            {
                left = true;
            }
            else if (c == b'0')
            {
                zero = true;
            }
            else if (c == b'+' || c == b' ' || c == b'#')
            {
                return None;
            }
            else
            {
                break;
            }
            i += 1;
        }
        usize w = 0;
        while (i < n && f[i] >= b'0' && f[i] <= b'9')
        {
            w = w * 10 + widen<usize>(f[i] - b'0');
            i += 1;
        }
        if (i >= n || k >= Vec::len(args))
        {
            return None;
        }
        u8 conv = f[i];
        i += 1;
        u32 how = if (left) { 1 } else if (zero) { 2 } else { 0 };
        bool int_arg = match (&args[k])
        {
            FmtArg::FaInt(_) : true,
            _                : false,
        };
        bool text_arg = match (&args[k])
        {
            FmtArg::FaText(_) : true,
            _                 : false,
        };
        if (int_arg && (conv == b'v' || conv == b'd' || conv == b'i' || conv == b'u'))
        {
            Vec::push(&mut ops, fmt_op(1, k, w, how, false));
        }
        else if (int_arg && (conv == b'x' || conv == b'X'))
        {
            Vec::push(&mut ops, fmt_op(2, k, w, how, conv == b'X'));
        }
        else if (text_arg && (conv == b'v' || conv == b's') && w == 0)
        {
            Vec::push(&mut ops, fmt_op(3, k, 0, 0, false));
        }
        else
        {
            return None;
        }
        k += 1;
        start = i;
    }
    if (i > start)
    {
        Vec::push(&mut ops, fmt_op(0, start, i - start, 0, false));
    }
    if (k != Vec::len(args))
    {
        return None;
    }
    Some(ops)
}

// D-0297: the text of a literal format, written in place (`fmt_plan`'s
// pieces): into the frame when its length has a small bound, else into the
// runtime's space for its length; the same bytes `cb_format` makes.
fn fmt_in_place(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> f,
    ref<Vec<FmtOp>, shared> ops,
    ref<Vec<FmtArg>, shared> args,
) : V
{
    if (Vec::len(ops) == 0)
    {
        String out = fresh(g, "fs");
        emit(x, &sprintf("cb_str %s = { (%s).p, 0 };", &out, f));
        return V { .c = out, .ty = Type::TStr, .obj = None };
    }
    if (Vec::len(ops) == 1 && ops[0].kind == 0 && ops[0].a == 0)
    {
        String out = fresh(g, "fs");
        emit(x, &sprintf("cb_str %s = %s;", &out, f));
        return V { .c = out, .ty = Type::TStr, .obj = None };
    }
    usize bound = 0;
    Vec<String> texts = Vec::new();
    foreach (op in ops)
    {
        if (op.kind == 0)
        {
            bound += op.b;
        }
        else if (op.kind == 1)
        {
            bound += if (op.b > 20) { op.b } else { 20 };
        }
        else if (op.kind == 2)
        {
            bound += if (op.b > 16) { op.b } else { 16 };
        }
        else
        {
            match (&args[op.a])
            {
                FmtArg::FaText(t) : Vec::push(&mut texts, String::clone(&t.n)),
                _                 : {},
            }
        }
    }
    String fp = fresh(g, "fp");
    String fk = fresh(g, "fk");
    String out = fresh(g, "fs");
    if (Vec::len(&texts) == 0 && bound <= 256)
    {
        emit(x, &sprintf("uint8_t %s[%v];", &fp, bound));
    }
    else
    {
        String total = sprintf("(uint64_t)%vu", bound);
        foreach (n in &texts)
        {
            String::appendf(&mut total, " + %s", n);
        }
        emit(x, &sprintf("uint8_t *%s = cb_fmt_space(%s);", &fp, &total));
    }
    emit(x, &sprintf("uint64_t %s = 0;", &fk));
    foreach (op in ops)
    {
        if (op.kind == 0)
        {
            emit(x, &sprintf("memcpy(%s + %s, (%s).p + %vu, %vu);", &fp, &fk, f, op.a, op.b));
            emit(x, &sprintf("%s += %vu;", &fk, op.b));
            continue;
        }
        if (op.kind == 3)
        {
            match (&args[op.a])
            {
                FmtArg::FaText(t) :
                {
                    emit(
                        x,
                        &sprintf("if (%s != 0) memcpy(%s + %s, %s, %s);", &t.n, &fp, &fk, &t.p, &t.n),
                    );
                    emit(x, &sprintf("%s += %s;", &fk, &t.n));
                },
                _                 : {},
            }
            continue;
        }
        match (&args[op.a])
        {
            FmtArg::FaInt(fi) :
            {
                String r = if (op.kind == 2)
                {
                    sprintf(
                        "cb_fmt_hex(%s + %s, (uint64_t)(uint%v_t)(%s), %vu)",
                        &fp,
                        &fk,
                        fi.bits,
                        &fi.x,
                        if (op.upper) { 1 } else { 0 },
                    )
                }
                else if (fi.is_signed)
                {
                    sprintf("cb_fmt_i64(%s + %s, (int64_t)(%s))", &fp, &fk, &fi.x)
                }
                else
                {
                    sprintf("cb_fmt_u64(%s + %s, (uint64_t)(%s))", &fp, &fk, &fi.x)
                };
                if (op.b > 0)
                {
                    emit(
                        x,
                        &sprintf(
                            "%s += cb_fmt_pad(%s + %s, %s, %vu, %vu);",
                            &fk,
                            &fp,
                            &fk,
                            &r,
                            op.b,
                            op.how,
                        ),
                    );
                }
                else
                {
                    emit(x, &sprintf("%s += %s;", &fk, &r));
                }
            },
            _                 : {},
        }
    }
    emit(x, &sprintf("cb_str %s = { %s, %s };", &out, &fp, &fk));
    V { .c = out, .ty = Type::TStr, .obj = None }
}

export fn return_text(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> tag,
    ref<Vec<String>, shared> names,
) : String
{
    variant_name_text(g, x, tag, names)
}

// The single name `e` is, when it is one.
export fn path_name(ref<Expr, shared> e) : Option<String>
{
    match (&e.kind)
    {
        ExprKind::EPath(p)  :
        {
            if (Vec::len(&Box::get(p).segs) == 1 && Vec::len(&Box::get(p).targs) == 0)
            {
                return Some(String::clone(&Box::get(p).segs[0]));
            }
            None
        },
        ExprKind::EParen(i) : path_name(Box::get(i)),
        _                   : None,
    }
}

// Whether `e` mentions the name `n` anywhere.
export fn mentions(ref<Expr, shared> e, ref<String, shared> n) : bool
{
    HashSet<String> found = HashSet::new();
    mentions_into(e, &mut found);
    HashSet::contains(&found, n)
}

export fn mentions_into(ref<Expr, shared> e, ref<HashSet<String>, exclusive> out)
{
    match (&e.kind)
    {
        ExprKind::EPath(p) :
        {
            if (Vec::len(&Box::get(p).segs) == 1)
            {
                HashSet::insert(out, String::clone(&Box::get(p).segs[0]));
            }
        },
        _                  : {},
    }
    each_child(e, out, mentions_into, mentions_block);
}

export fn mentions_block(ref<Block, shared> b, ref<HashSet<String>, exclusive> out)
{
    foreach (s in &b.stmts)
    {
        match (s)
        {
            Stmt::SLet(l)         :
            {
                match (&Box::get(l).init)
                {
                    Some(e) : mentions_into(e, out),
                    None    : {},
                }
            },
            Stmt::SDestructure(d) : mentions_into(&Box::get(d).init, out),
            Stmt::SExpr(e)        : mentions_into(Box::get(e), out),
            Stmt::SBlockLike(e)   : mentions_into(Box::get(e), out),
        }
    }
    match (&b.tail)
    {
        Some(t) : mentions_into(Box::get(t), out),
        None    : {},
    }
}

export fn fmt_direct_string(
    ref<Gen, shared> g,
    ref<Fx, shared> x,
    ref<Vec<Expr>, shared> args,
    ref<Expr, shared> a,
) : Option<Binding>
{
    ref<BorrowExpr, shared> bw = match (&strip_parens(a).kind)
    {
        ExprKind::EBorrow(b) : Box::get(b),
        _                    : return None,
    };
    if (bw.mode != Mode::Shared)
    {
        return None;
    }
    String n = match (path_name(&bw.e))
    {
        Some(n) : n,
        None    : return None,
    };
    usize count = 0;
    for (usize k = 1; k < Vec::len(args); k += 1)
    {
        if (mentions(&args[k], &n))
        {
            count += 1;
        }
    }
    if (count != 1)
    {
        return None;
    }
    match (lookup_ref(x, &n))
    {
        Some(b) :
        {
            bool string = match (&b.ty)
            {
                Type::TNamed(t) : Box::get(t).name == "std::String" && Vec::len(&Box::get(t).args) == 0,
                _               : false,
            };
            bool local = match (&b.kind)
            {
                BindKind::Local : true,
                _               : false,
            };
            if (local && string && !HashSet::contains(
                &x.direct_refs,
                &b.c,
            ) && !HashMap::contains(&x.unstored, &b.c) && (HashSet::contains(&x.objectless_c, &b.c) || StringView::len(
                &b.root) > 0))
            {
                return Some(clone(b));
            }
            None
        },
        None    : None,
    }
}

// The declaration of the function `name`, its `std` body loaded first when
// the front end left it for later (the lowering reaches `std` functions the
// static pass does not: `printf`'s helpers).
// D-0315: whether `name` names a function of `std`'s prelude (`in_prelude`),
// none for no function, without copying its declaration as `get_fn` does.
export fn fn_in_prelude(ref<Gen, exclusive> g, ref<String, shared> name) : Option<bool>
{
    if (is_pending(&g.prog.table, name))
    {
        match (load_body(&mut g.prog.table, &g.prog.front, name))
        {
            Ok(_)  : {},
            Err(_) : assert(false, "cobc: a std body that does not load"),
        }
    }
    match (HashMap::get(&g.prog.table.fns, name))
    {
        Some(f) : Some(in_prelude(name, f)),
        None    : None,
    }
}

// D-0315: a function's head: whether it is `std`'s, constant, generic, how
// many parameters it takes and its result type, without its body.
export struct FnHead
{
    export bool prelude;
    export bool is_const;
    export usize nparams;
    export usize ntype_params;
    export Type ret;
}

export fn fn_head(ref<Gen, exclusive> g, ref<String, shared> name) : Option<FnHead>
{
    match (fn_in_prelude(g, name))
    {
        Some(_) : {},
        None    : return None,
    }
    match (HashMap::get(&g.prog.table.fns, name))
    {
        Some(f) : Some(FnHead { .prelude = in_prelude(name, f), .is_const = f.is_const, .nparams = Vec::len(&f.params), .ntype_params = Vec::len(&f.type_params), .ret = clone(&f.ret) }),
        None    : None,
    }
}

// A block expression (or an `unsafe` one): its frame reports the block's
// line for a destruction fault.
export fn lower_block_expr(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Block, shared> b,
    Option<ref<Type, shared>> expected,
    usize line,
) : V
{
    match (lower_fused_text_loop(g, x, b, line))
    {
        Some(v) : return v,
        None    : {},
    }
    x.frame_line = Some(line);
    lower_block(g, x, b, expected)
}

// D-0200: `foreach (c in T::chars(x))` or `T::split_whitespace(x)` whose body
// uses `c` only as a pure view (`fusion_plan`): the pieces are found in
// place, one per turn, with no vector, and `c` is a bare view of each (cobc's
// `lower_fused_text_loop`).
export fn lower_fused_text_loop(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Block, shared> b,
    usize line,
) : Option<V>
{
    bool local = match (fusion_name(b))
    {
        Some(n) : is_bound(x, &n),
        None    : false,
    };
    FusionPlan plan = match (fusion_plan(g, b, local))
    {
        Some(p) : p,
        None    : return None,
    };
    FusionPlan { cname, chars, derived, source_id, be_id } = plan;
    ref<Expr, shared> source = fusion_source(b);
    ref<Expr, shared> be = fusion_be(b);
    match (&be.kind)
    {
        ExprKind::EBlock(_) : {},
        _                   : return None,
    }
    Type svt = Type::TNamed(Box::new(NamedTy { .name = "std::StringView", .args = Vec::new() }));
    String svc = ctype(g, &svt);
    at(g, x, line);
    // The text, evaluated as the call's argument, held for the loop.
    push_stmt(g, x);
    V a0 = lower_expr(g, x, source, Some(&svt));
    if (is_never(&a0.ty))
    {
        pop_stmt(x);
        return Some(a0);
    }
    V a = into_temp(g, x, a0, line);
    String data = sprintf("(%s).bytes.data", &a.c);
    String len = sprintf("(%s).bytes.len", &a.c);
    String src = sprintf("(%s).bytes.src", &a.c);
    String fd = fresh(g, "fd");
    String fl = fresh(g, "fl");
    String fp = fresh(g, "fp");
    String fs = fresh(g, "fs");
    emit(x, &sprintf("const uint8_t *%s = %s;", &fd, &data));
    emit(x, &sprintf("uint64_t %s = %s;", &fl, &len));
    emit(x, &sprintf("void *%s = %s;", &fs, &src));
    emit(x, &sprintf("uint64_t %s = 0;", &fp));
    Vec::push(&mut x.loops, Loop { .depth = Vec::len(&x.cleanup), .cont = None });
    Vec::push(&mut x.loop_broken, false);
    emit(x, "for (;;) {");
    x.ind += 1;
    String start = fresh(g, "fa");
    if (chars)
    {
        emit(x, &sprintf("if (%s >= %s) break;", &fp, &fl));
        emit(x, &sprintf("uint64_t %s = %s;", &start, &fp));
        emit(x, &sprintf("%s++;", &fp));
        emit(x, &sprintf("while (%s < %s && (%s[%s] & 0xc0) == 0x80) %s++;", &fp, &fl, &fd, &fp, &fp));
    }
    else
    {
        emit(
            x,
            &sprintf(
                "while (%s < %s && (%s[%s] == ' ' || (%s[%s] >= 9 && %s[%s] <= 13))) %s++;",
                &fp,
                &fl,
                &fd,
                &fp,
                &fd,
                &fp,
                &fd,
                &fp,
                &fp,
            ),
        );
        emit(x, &sprintf("if (%s >= %s) break;", &fp, &fl));
        emit(x, &sprintf("uint64_t %s = %s;", &start, &fp));
        emit(
            x,
            &sprintf(
                "while (%s < %s && !(%s[%s] == ' ' || (%s[%s] >= 9 && %s[%s] <= 13))) %s++;",
                &fp,
                &fl,
                &fd,
                &fp,
                &fd,
                &fp,
                &fd,
                &fp,
                &fp,
            ),
        );
    }
    // `c`: a bare view of the piece.
    String cc = sprintf("l_%s_%s", &san(&cname), &fresh(g, ""));
    emit(x, &sprintf("%s %s;", &svc, &cc));
    emit(x, &sprintf("%s.bytes.src = %s;", &cc, &fs));
    emit(x, &sprintf("%s.bytes.data = (uint8_t *)%s + %s;", &cc, &fd, &start));
    emit(x, &sprintf("%s.bytes.len = %s - %s;", &cc, &fp, &start));
    names_add(x, NameSet::DirectRefs, sprintf("%s.bytes", &cc));
    Vec::push(&mut x.scopes, HashMap::new());
    bind_in_scope(
        x,
        &cname,
        Binding { .c = cc, .ty = svt, .root = String::new(), .kind = BindKind::Local },
    );
    HashSet<String> dset = HashSet::new();
    foreach (d in &derived)
    {
        HashSet::insert(&mut dset, String::clone(d));
    }
    HashSet<String> saved_derived = replace(&mut x.bare_trims, dset);
    // The body as the loop's own block lowers it: a statement whose value, if
    // any, is discarded (the expression itself, not a copy).
    V v = lower_expr(g, x, be, None);
    x.bare_trims = saved_derived;
    if (!is_void(&v.ty) && !is_never(&v.ty))
    {
        if (Option::is_none(&v.obj) && holds_fn(g, &v.ty))
        {
            V t = into_temp(g, x, v, be.line);
            u32 tid = type_id(g, &t.ty);
            emit(x, &sprintf("cb_drop_value(&%s, %vu);", &t.c, tid));
        }
        else
        {
            emit(x, &sprintf("(void)(%s);", &v.c));
        }
    }
    Vec::pop(&mut x.scopes);
    x.ind -= 1;
    emit(x, "}");
    Vec::pop(&mut x.loops);
    Vec::pop(&mut x.loop_broken);
    pop_stmt(x);
    Some(unit())
}

// A part of an aggregate that holds references and arrives with an object
// of its own: the object's record ends with its references left in the
// aggregate (`cb_absorb_refs`). Anything else is stored as before.
export fn store_part(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    StringView dst,
    ref<Type, shared> ty,
    ref<V, shared> v,
)
{
    bool is_ref = match (ty)
    {
        Type::TRef(_) : true,
        _             : false,
    };
    if (!is_resource(g, ty) && has_refs(g, ty) && !is_ref)
    {
        match (&v.obj)
        {
            Some(o) :
            {
                emit(x, &sprintf("%s = %s;", dst, &v.c));
                emit(x, &sprintf("cb_move_to(%s, &%s);", o, dst));
                emit(x, &sprintf("cb_absorb_refs(%s);", o));
                return;
            },
            None    : {},
        }
    }
    store(g, x, dst, ty, v);
}

export fn construct_variant(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> ename,
    usize vi,
    ref<Vec<Type>, shared> targs,
    Option<ref<Expr, shared>> payload,
    Option<ref<Type, shared>> expected,
    usize line,
) : V
{
    bool objectless = replace(&mut x.objectless, false);
    bool lit_inert = replace(&mut x.lit_inert, false);
    EnumDecl ed = Option::expect(enum_decl(g, ename), "an enum");
    HashMap<String, Type> m = HashMap::new();
    for (usize k = 0; k < Vec::len(&ed.type_params) && k < Vec::len(targs); k += 1)
    {
        HashMap::insert(&mut m, String::clone(&ed.type_params[k]), apply(&targs[k], &x.subst));
    }
    match (expected)
    {
        Some(t) :
        {
            match (t)
            {
                Type::TNamed(n) :
                {
                    if (Box::get(n).name == *ename)
                    {
                        for (usize k = 0; k < Vec::len(&ed.type_params) && k < Vec::len(&Box::get(n).args); k += 1)
                        {
                            if (!HashMap::contains(&m, &ed.type_params[k]))
                            {
                                HashMap::insert(&mut m, String::clone(&ed.type_params[k]), clone(&Box::get(n).args[k]));
                            }
                        }
                    }
                },
                _               : {},
            }
        },
        None    : {},
    }
    Option<V> pv = None;
    match (&ed.variants[vi].payload)
    {
        Some(pty) :
        {
            ref<Expr, shared> pe = Option::expect(payload, "cobc: variant payload arity");
            Type hint = apply(pty, &m);
            bool known = resolved(&hint, &ed.type_params);
            // The payload is the last thing evaluated before the variant is:
            // an inert literal, or a `Box` of one, needs no object of its own.
            x.objectless = inert_expr(g, x, pe) || inert_box_new(g, x, pe) || (g.decided && literal_expr(g, x, pe));
            // D-0286: a call's result, a literal, or an objectless local
            // moved, goes in with no object (nothing is evaluated after it
            // before the variant absorbs it).
            arm_inert(g, x, pe, true);
            x.raw_return_path = g.decided && match (&strip_parens(pe).kind)
            {
                ExprKind::EPath(_) : true,
                _                  : false,
            };
            V v = if (known) { lower_expr(g, x, pe, Some(&hint)) } else { lower_expr(g, x, pe, None) };
            x.objectless = false;
            x.inert_result = None;
            x.raw_return_path = false;
            if (is_never(&v.ty))
            {
                return never();
            }
            unify(pty, &v.ty, &ed.type_params, &mut m);
            pv = Some(into_temp(g, x, v, pe.line));
        },
        None      : assert(Option::is_none(&payload), "cobc: variant payload arity"),
    }
    Vec<Type> args = Vec::new();
    foreach (tp in &ed.type_params)
    {
        match (HashMap::get(&m, tp))
        {
            Some(t) : Vec::push(&mut args, clone(t)),
            None    :
            {
                // In a probe, cobc's error: the probing argument loop skips it.
                if (x.probing > 0)
                {
                    x.probe_failed = true;
                    return unit();
                }
                eprintf("cobc: cannot infer type arguments of `%s` (in `%s`, line %v)\n", ename, &x.fn_name, line);
                assert(false, "cobc: cannot infer type arguments of an enum");
            },
        }
    }
    Type ty = Type::TNamed(Box::new(NamedTy { .name = String::clone(ename), .args = args }));
    String c = ctype(g, &ty);
    String t = fresh(g, "en");
    emit(x, &sprintf("%s %s;", &c, &t));
    String set = tag_set(g, &ty, &t, vi);
    if (StringView::len(&set) > 0)
    {
        emit(x, &set);
    }
    match (&pv)
    {
        Some(v) :
        {
            Type pty = clone(&v.ty);
            store_part(g, x, &sprintf("%s.u.v%v", &t, vi), &pty, v);
            if (is_resource(g, &pty) && !HashSet::contains(&x.inert_c, &v.c))
            {
                emit(
                    x,
                    &sprintf(
                        "cb_absorb(%s);",
                        &Option::expect(clone(&v.obj), "resource payload has object"),
                    ),
                );
            }
        },
        None    : {},
    }
    // D-0315: or one its consumer armed, whose end frees memory alone.
    if ((objectless || (lit_inert && objectless_type(g, &ty))) && is_resource(g, &ty) && !has_refs(g, &ty))
    {
        names_add(x, NameSet::InertC, String::clone(&t));
        return V { .c = t, .ty = ty, .obj = None };
    }
    register_temp(g, x, t, ty, line)
}

export fn lower_struct_lit(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Vec<String>, shared> segs,
    ref<Vec<Type>, shared> targs,
    ref<Vec<FieldInit>, shared> fields,
    Option<ref<Type, shared>> expected,
    usize line,
) : V
{
    bool objectless = replace(&mut x.objectless, false);
    // D-0315: armed by its consumer (`arm_inert`).
    bool armed = g.decided && x.probing == 0 && match (x.raw_arm)
    {
        Some(a) : match (struct_key(fields))
        {
            Some(k) : a == k,
            None    : false,
        },
        None : false,
    };
    bool armed_last = x.raw_arm_last;
    if (armed)
    {
        x.raw_arm = None;
    }
    String name = join_segs(segs);
    StructDecl sd = Option::expect(struct_decl(g, &name), "cobc: unknown struct");
    HashMap<String, Type> m = HashMap::new();
    for (usize k = 0; k < Vec::len(&sd.type_params) && k < Vec::len(targs); k += 1)
    {
        HashMap::insert(&mut m, String::clone(&sd.type_params[k]), apply(&targs[k], &x.subst));
    }
    match (expected)
    {
        Some(t) :
        {
            match (t)
            {
                Type::TNamed(n) :
                {
                    if (Box::get(n).name == name)
                    {
                        for (usize k = 0; k < Vec::len(&sd.type_params) && k < Vec::len(&Box::get(n).args); k += 1)
                        {
                            if (!HashMap::contains(&m, &sd.type_params[k]))
                            {
                                HashMap::insert(&mut m, String::clone(&sd.type_params[k]), clone(&Box::get(n).args[k]));
                            }
                        }
                    }
                },
                _               : {},
            }
        },
        None    : {},
    }
    Vec<String> names = Vec::new();
    Vec<V> vals = Vec::new();
    usize fpos = 0;
    foreach (fi in fields)
    {
        usize here = fpos;
        fpos += 1;
        usize k = 0;
        while (sd.fields[k].name != fi.name)
        {
            k += 1;
        }
        Type hint = apply(&sd.fields[k].ty, &m);
        bool known = resolved(&hint, &sd.type_params);
        // D-0200: a `String` field made with no object where its maker can
        // (`lower_raw_string`): the aggregate's object, made after, covers it.
        if (known && is_string_ty(&hint))
        {
            match (lower_raw_string(g, x, &fi.value))
            {
                Some(rv) :
                {
                    if (is_never(&rv.ty))
                    {
                        return never();
                    }
                    Vec::push(&mut names, String::clone(&fi.name));
                    Vec::push(&mut vals, into_temp(g, x, rv, fi.value.line));
                    continue;
                },
                None     : {},
            }
        }
        // An inert field owns nothing: a fault in a later field leaves
        // nothing of it to destroy (`inert_expr`).
        x.objectless = inert_expr(g, x, &fi.value);
        // D-0286: a call's result, or an objectless local moved, goes in
        // with no object.
        // D-0315 (step 4): one with a destructor of its own too, pending until
        // the literal is made where more of it runs after (`noted_pend`).
        bool noted_field = g.decided && x.probing == 0 && known && is_resource(g, &hint) && !has_refs(g, &hint)
            && !objectless_type(g, &hint) && noted_type(g, &hint);
        arm_inert(g, x, &fi.value, noted_field);
        x.raw_return_path = g.decided && (noted_field || (known && objectless_type(g, &hint))) && match (&strip_parens(
            &fi.value,
        ).kind)
        {
            ExprKind::EPath(_) : true,
            _                  : false,
        };
        V v = if (known) { lower_expr(g, x, &fi.value, Some(&hint)) } else { lower_expr(g, x, &fi.value, None) };
        x.objectless = false;
        x.inert_result = None;
        x.raw_return_path = false;
        if (is_never(&v.ty))
        {
            return never();
        }
        unify(&sd.fields[k].ty, &v.ty, &sd.type_params, &mut m);
        Vec::push(&mut names, String::clone(&fi.name));
        V tv = into_temp(g, x, v, fi.value.line);
        if (noted_field && Option::is_none(&tv.obj) && HashSet::contains(&x.inert_c, &tv.c))
        {
            bool rest = true;
            for (usize q = here + 1; q < Vec::len(fields); q += 1)
            {
                if (rest && !harmless(g, x, &fields[q].value))
                {
                    rest = false;
                }
            }
            if (!rest)
            {
                tv = noted_pend(g, x, tv, fi.value.line);
            }
        }
        Vec::push(&mut vals, tv);
    }
    Vec<Type> args = Vec::new();
    foreach (tp in &sd.type_params)
    {
        match (HashMap::get(&m, tp))
        {
            Some(t) : Vec::push(&mut args, clone(t)),
            None    : assert(false, "cobc: cannot infer type arguments of a struct"),
        }
    }
    Type ty = Type::TNamed(Box::new(NamedTy { .name = String::clone(&name), .args = args }));
    String c = ctype(g, &ty);
    String t = fresh(g, "st");
    emit(x, &sprintf("%s %s;", &c, &t));
    match (sd.bits)
    {
        Some(backing) :
        {
            // D-0118: the fields packed, each checked against its width.
            String lc = loc(g, x.std_body, line);
            str bc = c_int_type(backing);
            emit(x, &sprintf("%s.bits = 0;", &t));
            for (usize k = 0; k < Vec::len(&names); k += 1)
            {
                u32 off = 0;
                u32 w = 0;
                foreach (fd in &sd.fields)
                {
                    u32 fw = match (fd.width)
                    {
                        Some(z) : z,
                        None    : 0,
                    };
                    if (fd.name == names[k])
                    {
                        w = fw;
                        break;
                    }
                    off += fw;
                }
                String mask = c_bits_mask(backing, w);
                emit(
                    x,
                    &sprintf(
                        "if ((%s)(%s) > %s) cb_fault(\"diag.narrowing-overflow\", %s);",
                        bc,
                        &vals[k].c,
                        &mask,
                        &lc,
                    ),
                );
                emit(x, &sprintf("%s.bits |= ((%s)(%s)) << %vu;", &t, bc, &vals[k].c, off));
            }
            return register_temp(g, x, t, ty, line);
        },
        None          : {},
    }
    for (usize k = 0; k < Vec::len(&names); k += 1)
    {
        Type fty = clone(&vals[k].ty);
        // D-0315 (step 4): a pending noted field taken.
        noted_take(x, &vals[k].c);
        store_part(g, x, &sprintf("%s.%s", &t, &san(&names[k])), &fty, &vals[k]);
        if (is_resource(g, &fty) && !HashSet::contains(&x.inert_c, &vals[k].c))
        {
            emit(
                x,
                &sprintf(
                    "cb_absorb(%s);",
                    &Option::expect(clone(&vals[k].obj), "resource field has object"),
                ),
            );
        }
    }
    // D-0315: or one its consumer armed, whose end frees memory alone.
    // D-0315 (step 4): or one with a destructor of its own whose consumer
    // evaluates nothing after it.
    if ((objectless || (armed && (objectless_type(g, &ty) || (armed_last && noted_type(g, &ty))))) && is_resource(
        g,
        &ty,
    ) && !has_refs(g, &ty))
    {
        names_add(x, NameSet::InertC, String::clone(&t));
        return V { .c = t, .ty = ty, .obj = None };
    }
    register_temp(g, x, t, ty, line)
}

export fn is_match(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EMatch(_) : true,
        _                   : false,
    }
}

export fn is_text_ty(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TStr      : true,
        Type::TNamed(n) : Box::get(n).name == "std::String" || Box::get(n).name == "std::StringView",
        _               : false,
    }
}

struct TextParts
{
    String p;
    String n;
}

// The pointer and length of the text value `c` of text type `ty`.
export fn text_parts(ref<String, shared> c, ref<Type, shared> ty) : TextParts
{
    match (ty)
    {
        Type::TStr      : TextParts { .p = sprintf("(const void *)(%s).p", c), .n = sprintf("(%s).n", c) },
        Type::TNamed(n) :
        {
            if (Box::get(n).name == "std::StringView")
            {
                return TextParts { .p = sprintf(
                    "(const void *)(%s).bytes.data",
                    c,
                ), .n = sprintf("(%s).bytes.len", c) };
            }
            TextParts { .p = sprintf("(const void *)(%s).bytes.ptr", c), .n = sprintf("(%s).bytes.len", c) }
        },
        _ : TextParts { .p = sprintf(
            "(const void *)(%s).bytes.ptr",
            c,
        ), .n = sprintf("(%s).bytes.len", c) },
    }
}

export fn is_enum_ty(ref<Gen, shared> g, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(n) : HashMap::contains(&g.prog.table.enums, &Box::get(n).name),
        _               : false,
    }
}

export fn is_place_kind(ref<Expr, shared> e) : bool
{
    match (&strip_parens(e).kind)
    {
        ExprKind::EPath(_)  : true,
        ExprKind::EField(_) : true,
        ExprKind::EIndex(_) : true,
        ExprKind::EDeref(_) : true,
        _                   : false,
    }
}

export fn is_literal_arm(ref<Arm, shared> a) : bool
{
    is_literal_branch(Box::get(&a.body))
}

// The order the arms are probed in: an arm that is only a literal takes its
// type from the first arm that is not, so that one goes first (D-0049).
export fn probe_order(ref<Vec<Arm>, shared> arms, bool has_expected) : Vec<usize>
{
    Vec<usize> order = Vec::new();
    for (usize k = 0; k < Vec::len(arms); k += 1)
    {
        Vec::push(&mut order, k);
    }
    if (!has_expected)
    {
        for (usize k = 0; k < Vec::len(arms); k += 1)
        {
            if (!is_literal_arm(&arms[k]))
            {
                Vec::remove(&mut order, k);
                Vec::insert(&mut order, 0, k);
                break;
            }
        }
    }
    order
}

// A pattern's levels: the variant index at each, the innermost payload's
// type, and the references the pattern looked through (D-0109): their level,
// mode and referent.
struct Crossing
{
    usize level;
    Mode mode;
    Type pointee;
}

struct Levels
{
    Vec<usize> vis;
    Option<Type> payload;
    Vec<Crossing> crosses;
}

export fn arm_chain(ref<Arm, shared> a) : Vec<String>
{
    Vec<String> c = Vec::new();
    match (&a.variant)
    {
        Some(v) : Vec::push(&mut c, String::clone(v)),
        None    : {},
    }
    foreach (n in &a.nested)
    {
        Vec::push(&mut c, String::clone(n));
    }
    c
}

export fn arm_levels_crossing(
    ref<Gen, shared> g,
    ref<EnumDecl, shared> ed,
    ref<HashMap<String, Type>, shared> sub,
    ref<Arm, shared> arm,
) : Levels
{
    Vec<usize> vis = Vec::new();
    Vec<Crossing> crosses = Vec::new();
    EnumDecl decl = clone(ed);
    HashMap<String, Type> dsub = clone(sub);
    Option<Type> payload = None;
    Vec<String> chain = arm_chain(arm);
    for (usize k = 0; k < Vec::len(&chain); k += 1)
    {
        if (k > 0)
        {
            match (clone(&payload))
            {
                Some(Type::TRef(m)) :
                {
                    if (is_enum_ty(g, &Box::get(&m).inner))
                    {
                        Vec::push(
                            &mut crosses,
                            Crossing { .level = k, .mode = Box::get(&m).mode, .pointee = clone(&Box::get(&m).inner) },
                        );
                        payload = Some(clone(&Box::get(&m).inner));
                    }
                },
                _                   : {},
            }
            match (clone(&payload))
            {
                Some(Type::TNamed(n)) :
                {
                    EnumDecl d = Option::expect(
                        enum_decl(g, &Box::get(&n).name),
                        "cobc: nested pattern into a payload that is not an enum",
                    );
                    dsub = subst_of(&d.type_params, &Box::get(&n).args);
                    decl = d;
                },
                _                     : assert(false, "cobc: nested pattern into a payload that is not an enum"),
            }
        }
        usize vi = 0;
        while (vi < Vec::len(&decl.variants) && decl.variants[vi].name != chain[k])
        {
            vi += 1;
        }
        assert(vi < Vec::len(&decl.variants), "cobc: unknown variant");
        Vec::push(&mut vis, vi);
        payload = match (&decl.variants[vi].payload)
        {
            Some(p) : Some(apply(p, &dsub)),
            None    : None,
        };
    }
    if (Option::is_some(&arm.lit) && Vec::len(&vis) > 0)
    {
        match (clone(&payload))
        {
            Some(Type::TRef(m)) :
            {
                // D-0127: text through a reference too.
                ref<Type, shared> inner = &Box::get(&m).inner;
                bool scalar = match (inner)
                {
                    Type::TInt(_) : true,
                    Type::TBool   : true,
                    _             : false,
                };
                if (scalar || is_text_ty(inner))
                {
                    Vec::push(
                        &mut crosses,
                        Crossing { .level = Vec::len(&vis), .mode = Box::get(&m).mode, .pointee = clone(inner) },
                    );
                    payload = Some(clone(inner));
                }
            },
            _                   : {},
        }
    }
    Levels { .vis = vis, .payload = payload, .crosses = crosses }
}

export fn crossing_mode(ref<Vec<Crossing>, shared> crosses) : Option<Mode>
{
    if (Vec::len(crosses) == 0)
    {
        return None;
    }
    foreach (c in crosses)
    {
        if (c.mode == Mode::Shared)
        {
            return Some(Mode::Shared);
        }
    }
    Some(Mode::Exclusive)
}

export fn probe_binding(ref<Fx, exclusive> x, ref<String, shared> name, Type ty)
{
    bind_in_scope(
        x,
        name,
        Binding { .c = "probe", .ty = ty, .root = "0", .kind = BindKind::Local },
    );
}

export fn probe_type_arm(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Arm, shared> arm,
    ref<EnumDecl, shared> ed,
    ref<HashMap<String, Type>, shared> sub,
    ref<Type, shared> whole_ty,
    Option<ref<Type, shared>> expected,
    Option<Mode> by_ref,
) : Type
{
    Vec::push(&mut x.scopes, HashMap::new());
    match (&arm.binder)
    {
        Some(binder) :
        {
            if (Option::is_none(&arm.variant) && Option::is_none(&arm.lit))
            {
                Type pty = match (by_ref)
                {
                    Some(m) : ref_ty(clone(whole_ty), m),
                    None    : clone(whole_ty),
                };
                probe_binding(x, binder, pty);
            }
            else
            {
                Levels lv = arm_levels_crossing(g, ed, sub, arm);
                match (clone(&lv.payload))
                {
                    Some(p) :
                    {
                        Option<Mode> cm = crossing_mode(&lv.crosses);
                        Type pty = match (by_ref)
                        {
                            Some(a) :
                            {
                                match (cm)
                                {
                                    Some(b) : ref_ty(p, if (a == Mode::Shared) { Mode::Shared } else { b }),
                                    None    : ref_ty(p, a),
                                }
                            },
                            None    :
                            {
                                match (cm)
                                {
                                    Some(b) : ref_ty(p, b),
                                    None    : p,
                                }
                            },
                        };
                        probe_binding(x, binder, pty);
                    },
                    None    : {},
                }
            }
        },
        None         : {},
    }
    Type t = probe_type(g, x, Box::get(&arm.body), expected);
    Vec::pop(&mut x.scopes);
    t
}

// `?` (`rule.fail.propagate`): `match (e) { Ok(v) : v, Err(err) : return
// Err(err) }`, or on an `Option` `match (e) { Some(v) : v, None : return
// None }`, its nodes built anew each time (no fact names them).
export fn lower_propagate(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> e,
    ref<Expr, shared> inner,
    Option<ref<Type, shared>> expected,
) : V
{
    usize l = e.line;
    usize col = e.col;
    bool is_option = is_named(&probe_type(g, x, inner, None), "std::Option");
    Vec<Arm> arms = Vec::new();
    if (is_option)
    {
        Expr pv = synth_path(g, "__pv", l, col);
        Vec::push(
            &mut arms,
            Arm { .variant = Some("Some"), .nested = Vec::new(), .binder = Some("__pv"), .lit = None, .body = Box::new(pv), .quals = Vec::new() },
        );
        Expr none = synth_path(g, "None", l, col);
        Expr ret = synth(g, ExprKind::EReturn(Some(Box::new(none))), l, col);
        Vec::push(
            &mut arms,
            Arm { .variant = Some("None"), .nested = Vec::new(), .binder = None, .lit = None, .body = Box::new(ret), .quals = Vec::new() },
        );
    }
    else
    {
        Expr pv = synth_path(g, "__pv", l, col);
        Vec::push(
            &mut arms,
            Arm { .variant = Some("Ok"), .nested = Vec::new(), .binder = Some("__pv"), .lit = None, .body = Box::new(pv), .quals = Vec::new() },
        );
        Expr errp = synth_path(g, "Err", l, col);
        Vec<Expr> cargs = Vec::new();
        Vec::push(&mut cargs, synth_path(g, "__pe", l, col));
        Expr call = synth(g, ExprKind::ECall(Box::new(CallExpr { .callee = errp, .args = cargs })), l, col);
        Expr ret = synth(g, ExprKind::EReturn(Some(Box::new(call))), l, col);
        Vec::push(
            &mut arms,
            Arm { .variant = Some("Err"), .nested = Vec::new(), .binder = Some("__pe"), .lit = None, .body = Box::new(ret), .quals = Vec::new() },
        );
    }
    // D-0315: in a decided program the binders are objectless locals (each
    // moved out by its arm, so flagged), and a consumer that takes the `?`'s
    // value with no object takes the `match`'s so (`arm_inert`).
    if (g.decided)
    {
        foreach (a in &arms)
        {
            usize id = Box::get(&a.body).id | ARM_BIT;
            HashSet::insert(&mut x.objectless_names.ids, id);
            HashSet::insert(&mut x.objectless_names.moved, id);
        }
        bool armed = match (x.raw_arm)
        {
            Some(t) : t == e.id,
            None    : false,
        };
        if (armed)
        {
            x.raw_arm = arms_key(&arms);
        }
    }
    x.propagate_scrutinee = true;
    lower_match(g, x, inner, &arms, expected, l)
}

export fn synth_path(ref<Gen, exclusive> g, str name, usize line, usize col) : Expr
{
    Vec<String> segs = Vec::new();
    Vec::push(&mut segs, String::copy(name));
    synth(g, ExprKind::EPath(Box::new(PathExpr { .segs = segs, .targs = Vec::new() })), line, col)
}

// D-0315 (step 4): whether `arms` take every payload of the enum `ety` whose
// end runs a destructor of its own into a binder admitted as a noted value
// (cobc's `noted_payloads_taken`).
export fn noted_payloads_taken(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Type, shared> ety, ref<Vec<Arm>, shared> arms) : bool
{
    if (!g.decided || boot(g, 4) || x.probing > 0)
    {
        return false;
    }
    ref<NamedTy, shared> nt = match (ety)
    {
        Type::TNamed(n) : Box::get(n),
        _               : return false,
    };
    EnumDecl ed = match (enum_decl(g, &nt.name))
    {
        Some(d) : d,
        None    : return false,
    };
    if (objectless_type(g, ety) || !noted_type(g, ety))
    {
        return false;
    }
    HashMap<String, Type> sub = subst_of(&ed.type_params, &nt.args);
    foreach (v in &ed.variants)
    {
        match (&v.payload)
        {
            Some(p) :
            {
                Type pty = apply(p, &sub);
                if (is_resource(g, &pty) && !objectless_type(g, &pty))
                {
                    bool found = false;
                    foreach (arm in arms)
                    {
                        if (!found)
                        {
                            match (&arm.variant)
                            {
                                Some(vn) :
                                {
                                    if (*vn == v.name)
                                    {
                                        if (Option::is_none(&arm.binder) || Vec::len(&arm.nested) > 0 || Option::is_some(
                                            &arm.lit,
                                        ) || !noted_arm_binder(g, x, arm, &pty))
                                        {
                                            return false;
                                        }
                                        found = true;
                                    }
                                },
                                None     : return false,
                            }
                        }
                    }
                    if (!found)
                    {
                        return false;
                    }
                }
            },
            None    : {},
        }
    }
    true
}

// D-0315 (step 4): an arm's binder of `pty`, a type with a destructor of its
// own, admitted as a noted value (cobc's `noted_arm_binder`).
export fn noted_arm_binder(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Arm, shared> arm, ref<Type, shared> pty) : bool
{
    usize arm_id = Box::get(&arm.body).id | ARM_BIT;
    if (!g.decided || x.probing > 0 || !HashSet::contains(&x.objectless_names.ids, arm_id) || objectless_type(g, pty)
        || !noted_type(g, pty))
    {
        return false;
    }
    Option<usize> saved = replace(&mut x.s1_let, Some(arm_id));
    bool ok = objectless_binding(g, x, arm_id, pty);
    x.s1_let = saved;
    ok
}

// D-0315 (step 4): every arm's body is its binder alone (`x`, `{ x }`), a
// literal (`literal_expr`), or has no value (cobc's `arms_yield_binders`).
export fn arms_yield_binders(ref<Gen, shared> g, ref<Fx, shared> x, ref<Vec<Arm>, shared> arms) : bool
{
    foreach (a in arms)
    {
        ref<Expr, shared> b = strip_parens(Box::get(&a.body));
        match (&b.kind)
        {
            ExprKind::EBlock(bl) :
            {
                match (&bl.tail)
                {
                    None    : continue,
                    Some(t) :
                    {
                        if (Vec::len(&bl.stmts) > 0)
                        {
                            return false;
                        }
                        b = strip_parens(Box::get(t));
                    },
                }
            },
            _                    : {},
        }
        bool ok = match (&b.kind)
        {
            ExprKind::EPath(p) : match (&a.binder)
            {
                Some(bn) : Vec::len(&Box::get(p).segs) == 1 && Vec::len(&Box::get(p).targs) == 0 && Box::get(p).segs[0] == *bn,
                None     : false,
            },
            ExprKind::EReturn(_) : true,
            _                    : false,
        } || literal_expr(g, x, b);
        if (!ok)
        {
            return false;
        }
    }
    true
}

export fn lower_match(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> scrut,
    ref<Vec<Arm>, shared> arms,
    Option<ref<Type, shared>> expected,
    usize line,
) : V
{
    bool consume_temp = replace(&mut x.propagate_scrutinee, false);
    bool arm_scopes = replace(&mut x.stmt_match, false);
    // D-0315: its consumer's arming (`arm_inert`), taken now and given back
    // where the sink is made: the scrutinee's lowering arms its own producer.
    Option<usize> mkey = arms_key(arms);
    bool armed = g.decided && match (x.raw_arm)
    {
        Some(t) : match (mkey)
        {
            Some(i) : t == i,
            None    : false,
        },
        None : false,
    };
    // D-0315 (step 4): a value with a destructor of its own lands raw only
    // where nothing runs between the binder's move and a consumer that
    // evaluates nothing after it.
    bool armed_noted = armed && x.raw_arm_last && arms_yield_binders(g, x, arms);
    // D-0058: a first arm that matches everything, on a scrutinee that is
    // not an enum (nor an integer or `bool`): no discriminant.
    if (Vec::len(arms) > 0 && Option::is_none(&arms[0].variant) && Option::is_none(&arms[0].lit))
    {
        Type st = if (is_place_kind(scrut)) { probe_place_type(g, x, scrut) } else { probe_type(g, x, scrut, None) };
        bool flat = match (&st)
        {
            Type::TNamed(n) : !HashMap::contains(&g.prog.table.enums, &Box::get(n).name),
            Type::TRef(m)   : !is_enum_ty(g, &Box::get(m).inner),
            Type::TInt(_)   : false,
            Type::TBool     : false,
            _               : true,
        };
        if (flat)
        {
            Vec<Arm> first = Vec::new();
            Vec::push(&mut first, clone(&arms[0]));
            if (Option::is_none(&arms[0].binder) && is_place_kind(scrut))
            {
                return lower_match_scalar(g, x, unit(), &first, expected, line, None, arm_scopes);
            }
            V sv = lower_expr(g, x, scrut, None);
            if (is_never(&sv.ty))
            {
                return never();
            }
            if (armed)
            {
                x.raw_arm = mkey;
            }
            return lower_match_scalar(g, x, sv, &first, expected, line, None, arm_scopes);
        }
    }
    // D-0049: a place scrutinee of a resource enum (or text) type is matched
    // in place; an arm that moves its payload out of a whole binding takes it.
    Option<String> place_root = None;
    // D-0294: the moved flag of an objectless binding matched in place ("" when
    // it has none).
    Option<String> scrut_flag = None;
    bool res_place = match (&strip_parens(scrut).kind)
    {
        ExprKind::EPath(p)  :
        {
            if (Vec::len(&Box::get(p).segs) == 1)
            {
                match (lookup_ref(x, &Box::get(p).segs[0]))
                {
                    Some(b) :
                    {
                        Type t = binding_place_ty(b);
                        (is_enum_ty(g, &t) || is_text_ty(&t)) && is_resource(g, &t)
                    },
                    None    : false,
                }
            }
            else
            {
                false
            }
        },
        ExprKind::EField(_) : place_res_enum(g, x, scrut),
        ExprKind::EIndex(_) : place_res_enum(g, x, scrut),
        ExprKind::EDeref(_) : place_res_enum(g, x, scrut),
        _                   : false,
    };
    // `match (&mut p)` / `match (&p)` on an enum place with a checked base:
    // the borrow's check (`cb_borrow_unminted`) and the tag's read through
    // the base, with no path minted for the scrutinee; a binder's path is
    // borrowed from the base, through the place's projection and the
    // payload (D-0018: the scrutinee's own path would be unheld all its
    // life).
    Option<V> fused_scrut = None;
    Option<Mode> fused_mode = None;
    String fused_base = String::new();
    Vec<String> fused_projs = Vec::new();
    if (!boot(g, 9))
    {
        match (&strip_parens(scrut).kind)
        {
            ExprKind::EBorrow(bb) :
            {
                ref<Expr, shared> place = &Box::get(bb).e;
                Type pt = probe_place_type(g, x, place);
                if (is_enum_ty(g, &pt))
                {
                    P fp = lower_place(g, x, place);
                    if (is_never(&fp.ty))
                    {
                        return never();
                    }
                    bool has_base = Option::is_some(&fp.base) && Option::is_none(&fp.raw);
                    if (has_base)
                    {
                        String base = Option::expect(clone(&fp.base), "a base");
                        String flc = loc(g, x.std_body, line);
                        str fm = if (Box::get(bb).mode == Mode::Exclusive) { "CB_EXCLUSIVE" } else { "CB_SHARED" };
                        String pa = projs_args(&fp.projs);
                        emit(x, &sprintf("cb_borrow_unminted(%s, %s, %s, %s);", &base, &pa, fm, &flc));
                        emit(x, &sprintf("cb_read(%s, %s, %s);", &base, &pa, &flc));
                        fused_base = base;
                    }
                    else if (!(Option::is_none(&fp.raw) && (direct_place(x, place) || objectless_root(x, place) || whole_plain_borrow(
                        g,
                        &Box::get(bb).mode,
                        place,
                        &fp,
                    ))))
                    {
                        // D-0286: or an objectless local's (or a field of one),
                        // or a whole plain local's (`whole_plain_borrow`):
                        // nothing to check either.
                        assert(false, "cobc: a fused match scrutinee was lowered without a base");
                    }
                    // A field of a direct parameter (`box_rec_uses`): no check
                    // can fail, so none is made; the binder's base is "".
                    fused_mode = Some(Box::get(bb).mode);
                    fused_projs = clone(&fp.projs);
                    P { c, ty, base, projs, is_binding, raw } = fp;
                    fused_scrut = Some(V { .c = c, .ty = ty, .obj = None });
                }
            },
            _                     : {},
        }
    }
    bool fused = Option::is_some(&fused_scrut);
    Option<String> datum_tok = None;
    Option<String> acc_ptr = None;
    // A call returning `Option<ref<T>>`, matched with one-level patterns and
    // no arm binding the whole value: the reference's path is received unheld
    // into the statement's scope (`cb_recv_datum_tok`); `get_mut`'s `_acc`
    // variant where the arms are a compound write (`get_mut_acc_arms`).
    bool one_level = true;
    foreach (a in arms)
    {
        one_level = one_level && Vec::len(&a.nested) == 0 && Option::is_none(&a.lit) && !(Option::is_none(&a.variant) && Option::is_some(&a.binder));
    }
    Option<usize> call_key = if (!fused && !res_place && !boot(g, 4) && one_level)
    {
        match (&strip_parens(scrut).kind)
        {
            ExprKind::ECall(c) : Some(args_key(&Box::get(c).args)),
            _                  : None,
        }
    }
    else { None };
    V sv = if (fused)
    {
        Option::expect(fused_scrut, "a fused scrutinee")
    }
    else if (Option::is_some(&call_key))
    {
        // D-0315 (step 4): whatever its type, where the arms take every payload
        // with a destructor of its own (probed before the datum's flight is
        // armed).
        Type st0 = probe_type(g, x, scrut, None);
        bool taken = noted_payloads_taken(g, x, &st0, arms);
        x.datum_tok = call_key;
        x.datum_tok_out = None;
        if (get_mut_acc_arms(scrut, arms))
        {
            x.map_get_acc = call_key;
            x.map_get_acc_out = None;
        }
        // D-0286: a decided program's call result matched with no object.
        arm_inert(g, x, scrut, taken);
        V cv = lower_expr(g, x, scrut, None);
        x.inert_result = None;
        x.datum_tok = None;
        x.map_get_acc = None;
        datum_tok = replace(&mut x.datum_tok_out, None);
        acc_ptr = replace(&mut x.map_get_acc_out, None);
        cv
    }
    else if (res_place)
    {
        P p = lower_place(g, x, scrut);
        String lc = loc(g, x.std_body, line);
        match (&p.base)
        {
            Some(base) :
            {
                emit(x, &sprintf("cb_read(%s, %s, %s);", base, &projs_args(&p.projs), &lc));
                if (p.is_binding && Vec::len(&p.projs) == 0 && Option::is_none(&p.raw))
                {
                    place_root = Some(String::clone(base));
                }
            },
            None       :
            {
                if (p.is_binding && Vec::len(&p.projs) == 0 && Option::is_none(&p.raw) && HashSet::contains(
                    &x.objectless_c,
                    &p.c,
                ))
                {
                    // D-0294: an objectless binding matched in place (decided):
                    // stale if moved away; an arm that moves its payload out
                    // sets its flag (`bind_match_arm`), as `cb_take` would mark
                    // the binding's object.
                    objectless_use(g, x, &p.c, line);
                    scrut_flag = Some(match (HashMap::get(&x.moved_flag, &p.c))
                    {
                        Some(f) : String::clone(f),
                        None    : String::new(),
                    });
                }
            },
        }
        P { c, ty, base, projs, is_binding, raw } = p;
        V { .c = c, .ty = ty, .obj = None }
    }
    else
    {
        // D-0286: a decided program's call result matched with no object.
        // D-0315 (step 4): whatever its type, where the arms take every payload
        // with a destructor of its own.
        bool taken = match (&strip_parens(scrut).kind)
        {
            ExprKind::ECall(_) :
            {
                Type st0 = probe_type(g, x, scrut, None);
                noted_payloads_taken(g, x, &st0, arms)
            },
            _                  : false,
        };
        arm_inert(g, x, scrut, taken);
        V cv = lower_expr(g, x, scrut, None);
        x.inert_result = None;
        cv
    };
    if (is_never(&sv.ty))
    {
        return never();
    }
    // `[Match-By-Ref]` (D-0046): a reference scrutinee is matched on its
    // referent, and a binder borrows from the scrutinee's token.
    Option<Mode> by_ref_mode = fused_mode;
    String by_ref_tok = fused_base;
    Vec<String> by_ref_prefix = fused_projs;
    V sv2 = match (clone(&sv.ty))
    {
        Type::TRef(m) :
        {
            if (is_enum_ty(g, &Box::get(&m).inner))
            {
                V r = into_temp(g, x, sv, line);
                String lc = loc(g, x.std_body, line);
                emit(x, &sprintf("cb_read((%s).tok, NULL, 0, %s);", &r.c, &lc));
                String ec = ctype(g, &Box::get(&m).inner);
                by_ref_mode = Some(Box::get(&m).mode);
                by_ref_tok = sprintf("(%s).tok", &r.c);
                V { .c = sprintf("(*(%s *)(%s).p)", &ec, &r.c), .ty = clone(&Box::get(&m).inner), .obj = None }
            }
            else
            {
                sv
            }
        },
        _             : sv,
    };
    bool scalar = match (&sv2.ty)
    {
        Type::TInt(_) : true,
        Type::TBool   : true,
        _             : is_text_ty(&sv2.ty),
    };
    if (scalar)
    {
        if (armed)
        {
            x.raw_arm = mkey;
        }
        return lower_match_scalar(g, x, sv2, arms, expected, line, place_root, arm_scopes);
    }
    // A copy, not a reference: `sv2` is moved into a temporary below, and a
    // reference into its type's Box would still be live there (D-0221).
    NamedTy nt = match (&sv2.ty)
    {
        Type::TNamed(n) : clone(Box::get(n)),
        _               :
        {
            // `[Match]` on a non-enum: the evaluator's dynamic verdict.
            String lc = loc(g, x.std_body, line);
            emit(x, &sprintf("cb_fault(\"diag.type-mismatch\", %s);", &lc));
            return never();
        },
    };
    String ename = String::clone(&nt.name);
    Vec<Type> eargs = clone(&nt.args);
    EnumDecl ed = match (enum_decl(g, &ename))
    {
        Some(d) : d,
        None    :
        {
            String lc = loc(g, x.std_body, line);
            emit(x, &sprintf("cb_fault(\"diag.type-mismatch\", %s);", &lc));
            return never();
        },
    };
    HashMap<String, Type> sub = subst_of(&ed.type_params, &eargs);
    bool by_ref = Option::is_some(&by_ref_mode);
    V s = if (by_ref || res_place || Option::is_some(&datum_tok) || Option::is_some(&acc_ptr)) { sv2 } else
    {
        into_temp(
            g,
            x,
            sv2,
            line,
        )
    };
    match (&datum_tok)
    {
        Some(tk) :
        {
            // The payload slot's token is the received one (`slot_tok`).
            for (usize vi = 0; vi < Vec::len(&ed.variants); vi += 1)
            {
                if (Option::is_some(&ed.variants[vi].payload))
                {
                    names_put(x, NameMap::Unstored, sprintf("%s.u.v%v", &s.c, vi), String::clone(tk));
                }
            }
        },
        None     : {},
    }
    bool scrut_res = !by_ref && !res_place && is_resource(g, &s.ty);
    // The first arm's type fixes the rest.
    Option<Type> arm_expected = match (expected)
    {
        Some(t) : Some(clone(t)),
        None    : None,
    };
    Type result_ty = Type::TNever;
    Type whole_ty = Type::TNamed(Box::new(NamedTy { .name = String::clone(&ename), .args = clone(&eargs) }));
    foreach (k in probe_order(arms, Option::is_some(&expected)))
    {
        if (!is_never(&result_ty))
        {
            break;
        }
        Option<Type> pe = clone(&arm_expected);
        Type t = match (&pe)
        {
            Some(et) : probe_type_arm(g, x, &arms[k], &ed, &sub, &whole_ty, Some(et), by_ref_mode),
            None     : probe_type_arm(g, x, &arms[k], &ed, &sub, &whole_ty, None, by_ref_mode),
        };
        if (!is_never(&t) && !is_void(&t) && Option::is_none(&arm_expected))
        {
            arm_expected = Some(clone(&t));
        }
        if (is_never(&result_ty) && !is_never(&t))
        {
            result_ty = t;
        }
    }
    Option<Sink> sink = None;
    if (!is_void(&result_ty) && !is_never(&result_ty))
    {
        String r = fresh(g, "r");
        String rc = reg_ctype(g, &result_ty);
        emit(x, &sprintf("%s %s;", &rc, &r));
        if (armed)
        {
            x.raw_arm = mkey;
        }
        x.raw_arm_noted = armed_noted;
        Option<String> ov = match_sink_obj_var(g, x, &result_ty, arms_key(arms));
        x.raw_arm_noted = false;
        sink = Some(Sink { .dst = r, .ty = clone(&result_ty), .ov = ov });
    }
    for (usize i = 0; i < Vec::len(arms); i += 1)
    {
        ref<Arm, shared> arm = &arms[i];
        // D-0056: the variant index at each level of the arm's pattern.
        Levels lv = arm_levels_crossing(g, &ed, &sub, arm);
        // D-0058: a binder alone binds the whole scrutinee.
        Option<Type> inner_ty = if (Vec::len(&lv.vis) == 0 && Option::is_none(&arm.lit) && Option::is_some(&arm.binder)) { Some(clone(&s.ty)) } else { clone(&lv.payload) };
        String slot_path = String::clone(&s.c);
        Vec<String> tests = Vec::new();
        Option<String> cross_slot = None;
        usize below = Vec::len(&lv.vis);
        String lc = loc(g, x.std_body, line);
        // The enum at each level (the payload of the level above, through a
        // reference where the pattern crosses one): its discriminant is read
        // as its layout keeps it (`tag_is`, D-0298).
        Type level_ty = clone(&whole_ty);
        for (usize k = 0; k < Vec::len(&lv.vis); k += 1)
        {
            through_cross(g, &lv, k, &mut slot_path, &mut cross_slot, &mut below, &lc);
            foreach (c in &lv.crosses)
            {
                if (c.level == k)
                {
                    level_ty = clone(&c.pointee);
                    break;
                }
            }
            Vec::push(&mut tests, tag_is(g, &level_ty, &slot_path, lv.vis[k]));
            slot_path = sprintf("%s.u.v%v", &slot_path, lv.vis[k]);
            level_ty = variant_payload_ty(g, &level_ty, lv.vis[k]);
        }
        if (Option::is_some(&arm.lit))
        {
            through_cross(g, &lv, Vec::len(&lv.vis), &mut slot_path, &mut cross_slot, &mut below, &lc);
        }
        // D-0057: a literal the innermost payload must equal; D-0127: a text
        // literal, its bytes.
        match (&arm.lit)
        {
            Some(l) :
            {
                match (&inner_ty)
                {
                    Some(lt) :
                    {
                        if (is_text_ty(lt))
                        {
                            Type ts = Type::TStr;
                            V litv = lower_expr(g, x, Box::get(l), Some(&ts));
                            TextParts tp = text_parts(&slot_path, lt);
                            Vec::push(
                                &mut tests,
                                sprintf(
                                    "cb_bytes_eq(%s, %s, (const void *)(%s).p, (%s).n)",
                                    &tp.p,
                                    &tp.n,
                                    &litv.c,
                                    &litv.c,
                                ),
                            );
                        }
                        else
                        {
                            V litv = lower_expr(g, x, Box::get(l), Some(lt));
                            Vec::push(&mut tests, sprintf("%s == %s", &slot_path, &litv.c));
                        }
                    },
                    None     : {},
                }
            },
            None    : {},
        }
        String head = if (Vec::len(&tests) == 0) { "{" } else
        {
            sprintf(
                "if (%s) {",
                &String::join(&tests, " && "),
            )
        };
        emit(x, &sprintf("%s%s", if (i > 0) { "else " } else { "" }, &head));
        x.ind += 1;
        push_frame(g, x);
        Vec::push(&mut x.scopes, HashMap::new());
        bool moved_out = bind_match_arm(
            g,
            x,
            arm,
            &inner_ty,
            &slot_path,
            &cross_slot,
            below,
            Vec::len(&lv.vis),
            &lv.crosses,
            by_ref_mode,
            &by_ref_tok,
            &by_ref_prefix,
            &place_root,
            &scrut_flag,
            &acc_ptr,
            line,
        );
        if (scrut_res)
        {
            match (&s.obj)
            {
                // D-0049: consumed only by an arm that moved the payload out;
                // otherwise the temporary ends with its statement.
                Some(o) :
                {
                    if (moved_out)
                    {
                        emit(x, &sprintf("cb_end_moved_out(%s);", o));
                    }
                },
                // D-0286: an inert one (`arm_inert`), whose end frees memory
                // alone: an arm that moves nothing out drops it where the arm
                // ends.
                None    :
                {
                    assert(HashSet::contains(&x.inert_c, &s.c), "cobc: a resource scrutinee without an object");
                    if (!moved_out)
                    {
                        u32 stid = type_id(g, &s.ty);
                        String d = objectless_drop(g, &s.c, stid, &s.ty);
                        push_drop(x, d);
                    }
                },
            }
        }
        x.branch_scope = arm_scopes && Option::is_none(&sink);
        Option<Type> ae = clone(&arm_expected);
        V v = match (&ae)
        {
            Some(t) : lower_branch(g, x, Box::get(&arm.body), Some(t), as_sink(&sink)),
            None    : lower_branch(g, x, Box::get(&arm.body), None, as_sink(&sink)),
        };
        Vec::pop(&mut x.scopes);
        if (!is_never(&v.ty))
        {
            pop_frame(x);
        }
        else
        {
            end_diverged(x);
        }
        x.ind -= 1;
        emit(x, "}");
    }
    // D-0060: `?` consumes a temporary `Result`/`Option` that owns nothing.
    if (consume_temp && !by_ref && !res_place && !scrut_res)
    {
        match (&s.obj)
        {
            Some(o) : emit(x, &sprintf("cb_end_moved_out(%s);", o)),
            None    : {},
        }
    }
    match (sink)
    {
        Some(sk) :
        {
            // A raw sink's value has no object (`inert_c`).
            bool raw = match (&sk.ov)
            {
                Some(o) : HashSet::contains(&x.raw_sinks, o),
                None    : false,
            };
            if (raw)
            {
                names_add(x, NameSet::InertC, String::clone(&sk.dst));
            }
            V { .c = String::clone(&sk.dst), .ty = result_ty, .obj = if (raw) { None } else { clone(&sk.ov) } }
        },
        None     : if (is_never(&result_ty)) { never() } else { unit() },
    }
}

export fn place_res_enum(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> scrut) : bool
{
    Type t = probe_place_type(g, x, scrut);
    (is_enum_ty(g, &t) || is_text_ty(&t)) && is_resource(g, &t)
}

// Through a reference the pattern looked through at level `k` (D-0109): the
// slot read through it, and the levels below it.
export fn through_cross(
    ref<Gen, exclusive> g,
    ref<Levels, shared> lv,
    usize k,
    ref<String, exclusive> slot_path,
    ref<Option<String>, exclusive> cross_slot,
    ref<usize, exclusive> below,
    ref<String, shared> lc,
)
{
    foreach (c in &lv.crosses)
    {
        if (c.level == k)
        {
            String ec = ctype(g, &c.pointee);
            String raw = String::clone(slot_path);
            *slot_path = sprintf("(*(%s *)({ cb_read(cb_load_ref(&%s), NULL, 0, %s); %s; }))", &ec, &raw, lc, &raw);
            *cross_slot = Some(raw);
            *below = Vec::len(&lv.vis) - k;
            return;
        }
    }
}

// A `match` arm's binder: bound to the payload at `slot_path`, by reference
// through a crossed or matched reference (D-0046, D-0109), else by value,
// moving a resource payload out (D-0049; whether it did is the result).
export fn bind_match_arm(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Arm, shared> arm,
    ref<Option<Type>, shared> inner_ty,
    ref<String, shared> slot_path,
    ref<Option<String>, shared> cross_slot,
    usize below,
    usize vis_len,
    ref<Vec<Crossing>, shared> crosses,
    Option<Mode> by_ref_mode,
    ref<String, shared> by_ref_tok,
    ref<Vec<String>, shared> by_ref_prefix,
    ref<Option<String>, shared> place_root,
    ref<Option<String>, shared> scrut_flag,
    ref<Option<String>, shared> acc_ptr,
    usize line
) : bool
{
    bool moved_out = false;
    ref<String, shared> binder = match (&arm.binder)
    {
        Some(b) : b,
        None    : return false,
    };
    Type pty = match (inner_ty)
    {
        Some(t) : clone(t),
        None    : return false,
    };
    // D-0109: through a reference the pattern crossed, the binder borrows
    // from that reference (in the weaker mode).
    Option<Mode> ref_mode = None;
    String ref_tok = String::new();
    usize nproj = 0;
    match (cross_slot)
    {
        Some(cs) :
        {
            match (crossing_mode(crosses))
            {
                Some(cm) :
                {
                    bool shared = match (by_ref_mode)
                    {
                        Some(Mode::Shared) : true,
                        _                  : false,
                    };
                    ref_mode = Some(if (shared) { Mode::Shared } else { cm });
                    ref_tok = slot_tok(x, cs);
                    nproj = below;
                },
                None     : {},
            }
        },
        None     : {},
    }
    if (Option::is_none(&ref_mode))
    {
        match (by_ref_mode)
        {
            Some(m) :
            {
                ref_mode = Some(m);
                ref_tok = String::clone(by_ref_tok);
                nproj = vis_len;
            },
            None    : {},
        }
    }
    match (ref_mode)
    {
        Some(mode) :
        {
            Type rty = ref_ty(pty, mode);
            String rc = ctype(g, &rty);
            String cname = sprintf("l_%s_%s", &san(binder), &fresh(g, ""));
            emit(x, &sprintf("%s %s;", &rc, &cname));
            String lc = loc(g, x.std_body, line);
            String t = fresh(g, "tok");
            // Through a fused scrutinee, the place's projection first.
            Vec<String> all = if (Option::is_none(cross_slot)) { clone(by_ref_prefix) } else { Vec::new() };
            for (usize k = 0; k < nproj; k += 1)
            {
                Vec::push(&mut all, "{ CB_PAYLOAD, 0u }");
            }
            String projs = if (Vec::len(&all) == 0) { "NULL" } else
            {
                sprintf(
                    "(cb_proj[]){ %s }",
                    &String::join(&all, ", "),
                )
            };
            // `Some(b) : … Box::get_mut(b) …`, `b` used only there, first: the
            // borrow is checked (`cb_borrow_unminted`) and none minted; the
            // call is made inline through the base (`unminted_binders`).
            ref<Expr, shared> abody = Box::get(&arm.body);
            bool box_use = !boot(
                g,
                7,
            ) && binder_used_once_first(abody, binder) && match (binder_box_call(abody, binder))
            {
                Some(k) : k == "std::Box::get" || (k == "std::Box::get_mut" && mode == Mode::Exclusive),
                None    : false,
            };
            assert(
                box_use || StringView::len(&ref_tok) > 0 || g.decided,
                "cobc: a binder through a direct place used other than by `Box::get`",
            );
            // D-0286: in a decided program, through an objectless local:
            // token 0 (every borrow is decided).
            if (StringView::len(&ref_tok) == 0 && !box_use)
            {
                ref_tok = "0";
            }
            if (box_use)
            {
                if (StringView::len(&ref_tok) > 0)
                {
                    emit(
                        x,
                        &sprintf(
                            "cb_borrow_unminted(%s, %s, %v, %s, %s);",
                            &ref_tok,
                            &projs,
                            Vec::len(&all),
                            mode_c(mode),
                            &lc,
                        ),
                    );
                }
                emit(x, &sprintf("%s = (void *)&(%s);", &cname, slot_path));
                HashMap::insert(
                    &mut x.unminted_binders,
                    String::clone(&cname),
                    Unminted { .tok = String::clone(&ref_tok), .projs = clone(&all) },
                );
                bind_in_scope(
                    x,
                    binder,
                    Binding { .c = cname, .ty = rty, .root = String::new(), .kind = BindKind::Local },
                );
                return false;
            }
            emit(
                x,
                &sprintf(
                    "uint64_t %s = cb_borrow(%s, %s, %v, %s, %s);",
                    &t,
                    &ref_tok,
                    &projs,
                    Vec::len(&all),
                    mode_c(mode),
                    &lc,
                ),
            );
            if (!boot(g, 7) && binder_used_once_first(abody, binder))
            {
                // Used once, by the first thing the arm evaluates: its path
                // need not be held by a binding object (D-0018); the use goes
                // through the borrow's token (`unstored`).
                emit(x, &sprintf("%s = (void *)&(%s);", &cname, slot_path));
                names_put(x, NameMap::Unstored, String::clone(&cname), String::clone(&t));
                bind_in_scope(
                    x,
                    binder,
                    Binding { .c = cname, .ty = rty, .root = String::new(), .kind = BindKind::Local },
                );
                return false;
            }
            V fv = V { .c = sprintf("((cb_ref){ (void *)&(%s), %s })", slot_path, &t), .ty = clone(&rty), .obj = None };
            bind_value(g, x, binder, cname, &rty, &fv, line);
            return false;
        },
        None       : {},
    }
    String pc = ctype(g, &pty);
    String cname = sprintf("l_%s_%s", &san(binder), &fresh(g, ""));
    emit(x, &sprintf("%s %s;", &pc, &cname));
    String slot = String::clone(slot_path);
    bool is_ref = match (&pty)
    {
        Type::TRef(_) : true,
        _             : false,
    };
    V fv = if (is_ref) { read_ref_slot(x, &slot, &pty) } else { V { .c = slot, .ty = clone(&pty), .obj = None } };
    if (is_resource(g, &pty))
    {
        // [Relocate-Out] of the payload into the binder; a binding
        // scrutinee is moved from first (D-0049).
        Option<String> taken = match (place_root)
        {
            Some(root) :
            {
                String lc = loc(g, x.std_body, line);
                String o = fresh(g, "o");
                emit(x, &sprintf("uint64_t %s = cb_take(%s, %s);", &o, root, &lc));
                Some(o)
            },
            None       : None,
        };
        store(g, x, &cname, &pty, &fv);
        match (&taken)
        {
            Some(o) : emit(x, &sprintf("cb_end_moved_out(%s);", o)),
            None    : {},
        }
        // D-0294: the payload left an objectless binding: moved away (its
        // flag), so its drop runs nothing.
        if (Option::is_none(place_root))
        {
            match (scrut_flag)
            {
                Some(fl) :
                {
                    assert(
                        StringView::len(fl) > 0,
                        "cobc: a payload moved out of an objectless binding that has no moved flag",
                    );
                    emit(x, &sprintf("%s = 1;", fl));
                },
                None     : {},
            }
        }
        u32 tid = type_id(g, &pty);
        // D-0200: an objectless binder (`objectless_strings`): the payload's
        // bytes, no object.
        // D-0286: in a decided program, by `objectless_binding`'s whole test
        // (its fields read by value are plain data).
        usize arm_id = Box::get(&arm.body).id | ARM_BIT;
        // D-0315 (step 4): or a noted value (`noted_arm_binder`).
        bool noted = noted_arm_binder(g, x, arm, &pty);
        if (noted || (HashSet::contains(
            &x.objectless_names.ids,
            arm_id,
        ) && objectless_type(g, &pty) && x.probing == 0 && (!g.decided
            || objectless_binding(g, x, arm_id, &pty))))
        {
            Option<usize> saved = replace(&mut x.cur_let, Some(arm_id));
            x.s1_now = noted;
            objectless_bound(g, x, &cname, tid, &pty);
            x.cur_let = saved;
            if (replace(&mut x.pending_sub, false))
            {
                push_sub_frame(g, x);
            }
            bind_in_scope(
                x,
                binder,
                Binding { .c = cname, .ty = pty, .root = String::new(), .kind = BindKind::Local },
            );
            return true;
        }
        String lc = loc(g, x.std_body, line);
        String o = fresh(g, "o");
        emit(x, &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o, &cname, tid, &lc));
        String root = fresh(g, "root");
        emit(x, &sprintf("uint64_t %s = cb_bind(%s);", &root, &o));
        note_frame(g, x, binder, &root);
        bind_in_scope(
            x,
            binder,
            Binding { .c = cname, .ty = pty, .root = root, .kind = BindKind::Local },
        );
        moved_out = true;
    }
    else if (Option::is_some(acc_ptr) && is_ref)
    {
        // `get_mut`'s `_acc` variant: `*c op= x` alone, the element's access
        // made (`get_mut_acc_arms`).
        String pv = Option::expect(clone(acc_ptr), "a value pointer");
        emit(x, &sprintf("%s = (void *)%s;", &cname, &pv));
        names_add(x, NameSet::DirectRefs, String::clone(&cname));
        bind_in_scope(
            x,
            binder,
            Binding { .c = cname, .ty = pty, .root = String::new(), .kind = BindKind::Local },
        );
    }
    else if (!boot(g, 7) && is_ref && binder_used_once_first(Box::get(&arm.body), binder))
    {
        // The reference stays in the scrutinee's slot, held there until the
        // statement ends; a binder used once, by the first thing the arm
        // evaluates, needs no binding of its own (D-0018).
        String tk = fresh(g, "tk");
        String load = slot_tok(x, slot_path);
        emit(x, &sprintf("uint64_t %s = %s;", &tk, &load));
        emit(x, &sprintf("%s = %s;", &cname, slot_path));
        names_put(x, NameMap::Unstored, String::clone(&cname), tk);
        bind_in_scope(
            x,
            binder,
            Binding { .c = cname, .ty = pty, .root = String::new(), .kind = BindKind::Local },
        );
    }
    else
    {
        bind_value(g, x, binder, cname, &pty, &fv, line);
    }
    moved_out
}

export fn lower_match_scalar(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    V sv,
    ref<Vec<Arm>, shared> arms,
    Option<ref<Type, shared>> expected,
    usize line,
    Option<String> place_root,
    bool arm_scopes,
) : V
{
    // D-0127: a `String` place is compared where it is.
    bool in_place = is_text_ty(&sv.ty) && is_resource(g, &sv.ty) && Option::is_none(&sv.obj);
    V s = if (is_void(&sv.ty) || in_place) { sv } else { into_temp(g, x, sv, line) };
    Option<Type> arm_expected = match (expected)
    {
        Some(t) : Some(clone(t)),
        None    : None,
    };
    Type result_ty = Type::TNever;
    foreach (k in probe_order(arms, Option::is_some(&expected)))
    {
        if (!is_never(&result_ty))
        {
            break;
        }
        Option<Type> pe = clone(&arm_expected);
        Vec::push(&mut x.scopes, HashMap::new());
        match (&arms[k].binder)
        {
            Some(b) :
            {
                if (Option::is_none(&arms[k].lit))
                {
                    probe_binding(x, b, clone(&s.ty));
                }
            },
            None    : {},
        }
        Type t = match (&pe)
        {
            Some(et) : probe_type(g, x, Box::get(&arms[k].body), Some(et)),
            None     : probe_type(g, x, Box::get(&arms[k].body), None),
        };
        Vec::pop(&mut x.scopes);
        if (!is_never(&t) && !is_void(&t) && Option::is_none(&arm_expected))
        {
            arm_expected = Some(clone(&t));
        }
        if (is_never(&result_ty) && !is_never(&t))
        {
            result_ty = t;
        }
    }
    Option<Sink> sink = None;
    if (!is_void(&result_ty) && !is_never(&result_ty))
    {
        String r = fresh(g, "r");
        String rc = reg_ctype(g, &result_ty);
        emit(x, &sprintf("%s %s;", &rc, &r));
        Option<String> ov = match_sink_obj_var(g, x, &result_ty, arms_key(arms));
        sink = Some(Sink { .dst = r, .ty = clone(&result_ty), .ov = ov });
    }
    for (usize i = 0; i < Vec::len(arms); i += 1)
    {
        ref<Arm, shared> arm = &arms[i];
        String head = match (&arm.lit)
        {
            Some(l) :
            {
                if (is_text_ty(&s.ty))
                {
                    // D-0127: a text literal, equal bytes.
                    Type ts = Type::TStr;
                    V litv = lower_expr(g, x, Box::get(l), Some(&ts));
                    TextParts tp = text_parts(&s.c, &s.ty);
                    sprintf("if (cb_bytes_eq(%s, %s, (const void *)(%s).p, (%s).n)) {", &tp.p, &tp.n, &litv.c, &litv.c)
                }
                else
                {
                    V litv = lower_expr(g, x, Box::get(l), Some(&s.ty));
                    sprintf("if (%s == %s) {", &s.c, &litv.c)
                }
            },
            None    : "{",
        };
        emit(x, &sprintf("%s%s", if (i > 0) { "else " } else { "" }, &head));
        x.ind += 1;
        push_frame(g, x);
        Vec::push(&mut x.scopes, HashMap::new());
        match (&arm.binder)
        {
            Some(b) :
            {
                if (Option::is_none(&arm.lit))
                {
                    // D-0058: the whole value (moved, for a resource).
                    Type bty = clone(&s.ty);
                    String cname = sprintf("l_%s_%s", &san(b), &fresh(g, ""));
                    String c = ctype(g, &bty);
                    emit(x, &sprintf("%s %s;", &c, &cname));
                    if (in_place)
                    {
                        // D-0127: a `String` binding matched against text
                        // literals, moved out whole into the binder.
                        String root0 = match (clone(&place_root))
                        {
                            Some(r) : r,
                            None    :
                            {
                                // cobc's internal error: the lowering cannot
                                // go on (a decided lowering falls back).
                                set_unsupported(
                                    g,
                                    "internal error in cobc: a `String` scrutinee moved out of a place that is not a binding",
                                );
                                return never();
                            },
                        };
                        String lc = loc(g, x.std_body, line);
                        String o = fresh(g, "o");
                        emit(x, &sprintf("uint64_t %s = cb_take(%s, %s);", &o, &root0, &lc));
                        store(g, x, &cname, &bty, &s);
                        emit(x, &sprintf("cb_end_moved_out(%s);", &o));
                        u32 tid = type_id(g, &bty);
                        String o2 = fresh(g, "o");
                        emit(
                            x,
                            &sprintf("uint64_t %s = cb_new(&%s, %vu, %s);", &o2, &cname, tid, &lc),
                        );
                        String root = fresh(g, "root");
                        emit(x, &sprintf("uint64_t %s = cb_bind(%s);", &root, &o2));
                        note_frame(g, x, b, &root);
                        bind_in_scope(
                            x,
                            b,
                            Binding { .c = cname, .ty = bty, .root = root, .kind = BindKind::Local },
                        );
                    }
                    else
                    {
                        V sc = clone(&s);
                        bind_value(g, x, b, cname, &bty, &sc, line);
                    }
                }
            },
            None    : {},
        }
        x.branch_scope = arm_scopes && Option::is_none(&sink);
        Option<Type> ae = clone(&arm_expected);
        V v = match (&ae)
        {
            Some(t) : lower_branch(g, x, Box::get(&arm.body), Some(t), as_sink(&sink)),
            None    : lower_branch(g, x, Box::get(&arm.body), None, as_sink(&sink)),
        };
        Vec::pop(&mut x.scopes);
        if (!is_never(&v.ty))
        {
            pop_frame(x);
        }
        else
        {
            end_diverged(x);
        }
        x.ind -= 1;
        emit(x, "}");
    }
    match (sink)
    {
        Some(sk) :
        {
            // A raw sink's value has no object (`inert_c`).
            bool raw = match (&sk.ov)
            {
                Some(o) : HashSet::contains(&x.raw_sinks, o),
                None    : false,
            };
            if (raw)
            {
                names_add(x, NameSet::InertC, String::clone(&sk.dst));
            }
            V { .c = String::clone(&sk.dst), .ty = result_ty, .obj = if (raw) { None } else { clone(&sk.ov) } }
        },
        None     : if (is_never(&result_ty)) { never() } else { unit() },
    }
}

export fn targ0(ref<Fx, shared> x, ref<Vec<Type>, shared> targs) : Type
{
    apply(&targs[0], &x.subst)
}

export fn is_float(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TF32 : true,
        Type::TF64 : true,
        _          : false,
    }
}

// Both operands of a two-operand intrinsic: a bare literal takes the other's
// type, so the other goes first (`lower_operands`).
struct Operands
{
    Option<V> a;
    Option<V> b;
}

export fn lower_operands(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> l,
    ref<Expr, shared> r,
    Option<ref<Type, shared>> expected,
) : Operands
{
    Option<Type> exp = match (expected)
    {
        Some(t) :
        {
            match (t)
            {
                Type::TNamed(n) :
                {
                    if (Box::get(n).name == "std::Option" && Vec::len(&Box::get(n).args) == 1)
                    {
                        Some(clone(&Box::get(n).args[0]))
                    }
                    else
                    {
                        Some(clone(t))
                    }
                },
                _               : Some(clone(t)),
            }
        },
        None    : None,
    };
    if (is_bare_literal(l) && !is_bare_literal(r))
    {
        V rv0 = match (&exp)
        {
            Some(t) : lower_expr(g, x, r, Some(t)),
            None    : lower_expr(g, x, r, None),
        };
        if (is_never(&rv0.ty))
        {
            return Operands { .a = None, .b = None };
        }
        V rv = into_temp(g, x, rv0, r.line);
        Type rt = clone(&rv.ty);
        V lv0 = lower_expr(g, x, l, Some(&rt));
        V lv = into_temp(g, x, lv0, l.line);
        return Operands { .a = Some(lv), .b = Some(rv) };
    }
    V lv0 = match (&exp)
    {
        Some(t) : lower_expr(g, x, l, Some(t)),
        None    : lower_expr(g, x, l, None),
    };
    if (is_never(&lv0.ty))
    {
        return Operands { .a = None, .b = None };
    }
    V lv = into_temp(g, x, lv0, l.line);
    Type lt = clone(&lv.ty);
    V rv0 = lower_expr(g, x, r, Some(&lt));
    if (is_never(&rv0.ty))
    {
        return Operands { .a = None, .b = None };
    }
    V rv = into_temp(g, x, rv0, r.line);
    Operands { .a = Some(lv), .b = Some(rv) }
}

export fn lower_intrinsic_numeric(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> name,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    Option<ref<Type, shared>> expected,
    usize line,
    ref<String, shared> lc,
) : Option<V>
{
    if (*name == "sizeof" || *name == "alignof")
    {
        Type t = targ0(x, targs);
        SizeAlign sa = size_align(g, &t);
        return Some(V { .c = sprintf(
            "((uint64_t)%vu)",
            if (*name == "sizeof") { sa.size } else { sa.align },
        ), .ty = usize_ty(), .obj = None });
    }
    // D-0052: computed before the program was compiled.
    if (*name == "static_assert")
    {
        return Some(unit());
    }
    if (*name == "min_value" || *name == "max_value")
    {
        Type t = targ0(x, targs);
        bool max = *name == "max_value";
        match (&t)
        {
            // D-0051: a float's largest finite value, negated for `min_value`.
            Type::TF32 : return Some(V { .c = if (max) { "(0x1.fffffep+127f)" } else { "(-0x1.fffffep+127f)" }, .ty = Type::TF32, .obj = None }),
            Type::TF64 : return Some(V { .c = if (max) { "(0x1.fffffffffffffp+1023)" } else { "(-0x1.fffffffffffffp+1023)" }, .ty = Type::TF64, .obj = None }),
            Type::TInt(i) : return Some(V { .c = c_int(
                *i,
                if (max) { int_max_bits(*i) } else { int_min_bits(*i) },
            ), .ty = Type::TInt(*i), .obj = None }),
            _          : assert(false, "cobc: a limit of a non-integer type"),
        }
    }
    if (StringView::starts_with(name, "std::") && is_math1(name))
    {
        // D-0091: C's functions of the same names; D-0101: `ln` is C's `log`,
        // `round` the runtime's (`cb_round`).
        StringView base0 = Option::unwrap(StringView::strip_prefix(name, "std::"));
        str base = if (base0 == "ln") { "log" } else if (base0 == "round") { "cb_round" } else { "" };
        V v = lower_expr(g, x, &args[0], None);
        if (is_never(&v.ty))
        {
            return Some(never());
        }
        Type vty = clone(&v.ty);
        String xc = into_temp_c(g, x, v, line);
        String f = if (str_len(base) > 0) { String::copy(base) } else { String::copy(base0) };
        if (match (&vty) { Type::TF32 : true, _ : false })
        {
            String::push_ascii(&mut f, b'f');
        }
        return Some(V { .c = sprintf("%s(%s)", &f, &xc), .ty = vty, .obj = None });
    }
    if (*name == "std::atan2" || *name == "std::powf")
    {
        V a0 = lower_expr(g, x, &args[0], None);
        V a = into_temp(g, x, a0, line);
        V b0 = lower_expr(g, x, &args[1], None);
        if (is_never(&a.ty) || is_never(&b0.ty))
        {
            return Some(never());
        }
        V b = into_temp(g, x, b0, line);
        String f = if (*name == "std::atan2") { "atan2" } else { "pow" };
        if (match (&a.ty) { Type::TF32 : true, _ : false })
        {
            String::push_ascii(&mut f, b'f');
        }
        return Some(V { .c = sprintf("%s(%s, %s)", &f, &a.c, &b.c), .ty = clone(&a.ty), .obj = None });
    }
    if (*name == "widen" || *name == "narrow" || *name == "narrow_wrapping" || *name == "reinterpret" || *name == "to_float" || *name == "to_int")
    {
        Type dst = targ0(x, targs);
        V v = lower_expr(g, x, &args[0], None);
        if (is_never(&v.ty))
        {
            return Some(never());
        }
        Type vty = clone(&v.ty);
        String xc = into_temp_c(g, x, v, line);
        String c = conversion(name, &vty, &dst, &xc, lc);
        return Some(V { .c = c, .ty = dst, .obj = None });
    }
    // D-0122: `narrow` answering `None`.
    if (*name == "checked_narrow")
    {
        Type dst = targ0(x, targs);
        V v = lower_expr(g, x, &args[0], None);
        if (is_never(&v.ty))
        {
            return Some(never());
        }
        Type vty = clone(&v.ty);
        String xc = into_temp_c(g, x, v, line);
        IntTy s = match (&vty)
        {
            Type::TInt(i) : *i,
            _             : IntTy::I32,
        };
        IntTy d = match (&dst)
        {
            Type::TInt(i) : *i,
            _             : IntTy::I32,
        };
        String cond = narrow_cond(s, d, &xc);
        Vec<Type> oa = Vec::new();
        Vec::push(&mut oa, clone(&dst));
        Type opt = named("std::Option", oa);
        String oc = ctype(g, &opt);
        String t2 = fresh(g, "cn");
        emit(x, &sprintf("%s %s;", &oc, &t2));
        emit(
            x,
            &sprintf(
                "if (%s) { %s.tag = 0u; %s.u.v0 = (%s)%s; } else %s.tag = 1u;",
                &cond,
                &t2,
                &t2,
                c_int_type(d),
                &xc,
                &t2,
            ),
        );
        return Some(V { .c = t2, .ty = opt, .obj = None });
    }
    // D-0123: bit counts on the unsigned image; rotations by `k mod width`.
    if (*name == "count_ones" || *name == "leading_zeros" || *name == "trailing_zeros")
    {
        V v = lower_expr(g, x, &args[0], None);
        if (is_never(&v.ty))
        {
            return Some(never());
        }
        IntTy t = match (&v.ty)
        {
            Type::TInt(i) : *i,
            _             : IntTy::I32,
        };
        String xc = into_temp_c(g, x, v, line);
        u32 bw = int_ty_bits(t, 64);
        String c = if (bw == 128)
        {
            str f = if (*name == "count_ones") { "cb_popcount128" } else if (*name == "leading_zeros") { "cb_clz128" } else { "cb_ctz128" };
            sprintf("%s((cb_u128)%s)", f, &xc)
        }
        else
        {
            String ux = sprintf("(uint64_t)(%s)%s", c_uint_of_width(bw), &xc);
            if (*name == "count_ones")
            {
                sprintf(
                    "cb_popcount64(%s)",
                    &ux,
                )
            }
            else if (*name == "leading_zeros")
            {
                sprintf(
                    "cb_clz(%s, %vu)",
                    &ux,
                    bw,
                )
            }
            else { sprintf("cb_ctz(%s, %vu)", &ux, bw) }
        };
        return Some(V { .c = c, .ty = Type::TInt(IntTy::U32), .obj = None });
    }
    if (*name == "rotate_left" || *name == "rotate_right")
    {
        V v = lower_expr(g, x, &args[0], None);
        if (is_never(&v.ty))
        {
            return Some(never());
        }
        IntTy t = match (&v.ty)
        {
            Type::TInt(i) : *i,
            _             : IntTy::I32,
        };
        String xc = into_temp_c(g, x, v, line);
        Type u32t = Type::TInt(IntTy::U32);
        V k0 = lower_expr(g, x, &args[1], Some(&u32t));
        String k = into_temp_c(g, x, k0, line);
        u32 bw = int_ty_bits(t, 64);
        bool left = *name == "rotate_left";
        String c = if (bw == 128)
        {
            sprintf(
                "((%s)(%s((cb_u128)%s, %s)))",
                c_int_type(t),
                if (left) { "cb_rotl128" } else { "cb_rotr128" },
                &xc,
                &k,
            )
        }
        else
        {
            sprintf(
                "((%s)(%s%v((%s)%s, %s)))",
                c_int_type(t),
                if (left) { "cb_rotl" } else { "cb_rotr" },
                bw,
                c_uint_of_width(bw),
                &xc,
                &k,
            )
        };
        return Some(V { .c = c, .ty = Type::TInt(t), .obj = None });
    }
    // D-0121: through a `volatile` lvalue.
    if (*name == "read_volatile" || *name == "write_volatile")
    {
        V p = lower_expr(g, x, &args[0], None);
        if (is_never(&p.ty))
        {
            return Some(never());
        }
        Type pointee = match (&p.ty)
        {
            Type::TRawptr(i) : clone(Box::get(i)),
            _                :
            {
                assert(false, "cobc: volatile access through a non-pointer");
                Type::TVoid
            },
        };
        String pc = into_temp_c(g, x, p, line);
        String ct = ctype(g, &pointee);
        if (*name == "read_volatile")
        {
            return Some(V { .c = sprintf("(*(volatile %s *)(%s))", &ct, &pc), .ty = pointee, .obj = None });
        }
        V v = lower_expr(g, x, &args[1], Some(&pointee));
        if (is_never(&v.ty))
        {
            return Some(never());
        }
        String vc = into_temp_c(g, x, v, line);
        emit(x, &sprintf("*(volatile %s *)(%s) = %s;", &ct, &pc, &vc));
        return Some(unit());
    }
    if (is_int_op(name))
    {
        Operands ops = lower_operands(g, x, &args[0], &args[1], expected);
        Operands { a, b } = ops;
        V av = match (a)
        {
            Some(v) : v,
            None    : return Some(never()),
        };
        V bv = match (b)
        {
            Some(v) : v,
            None    : return Some(never()),
        };
        match (&av.ty)
        {
            Type::TSimd(_) : return Some(simd_wrap_sat(g, name, av, bv)),
            _              : {},
        }
        IntTy t = match (&av.ty)
        {
            Type::TInt(i) : *i,
            _             :
            {
                assert(false, "cobc: integer intrinsic on a non-integer");
                IntTy::I32
            },
        };
        ref<String, shared> ac = &av.c;
        ref<String, shared> bc = &bv.c;
        str ct = c_int_type(t);
        str ut = c_uint_type(t);
        usize us = Option::unwrap(StringView::find(name, "_"));
        String family = String::copy(&(*name)[0..us]);
        String opname = String::copy(&(*name)[us + 1..$]);
        str builtin = if (opname == "add") { "__builtin_add_overflow" } else if (opname == "sub") { "__builtin_sub_overflow" } else if (opname == "mul") { "__builtin_mul_overflow" } else { "" };
        if (family == "wrapping")
        {
            str sym = if (opname == "add") { "+" } else if (opname == "sub") { "-" } else { "*" };
            return Some(V { .c = sprintf(
                "((%s)(((%s)%s) %s ((%s)%s)))",
                ct,
                ut,
                ac,
                sym,
                ut,
                bc,
            ), .ty = Type::TInt(t), .obj = None });
        }
        if (family == "saturating")
        {
            String tm = if (!int_ty_signed(t))
            {
                if (opname == "sub") { "0" } else { "1" }
            }
            else if (opname == "add")
            {
                sprintf("(%s > 0)", bc)
            }
            else if (opname == "sub")
            {
                sprintf("(%s < 0)", bc)
            }
            else
            {
                sprintf("((%s < 0) == (%s < 0))", ac, bc)
            };
            String c = sprintf(
                "({ %s _r; if (%s(%s, %s, &_r)) _r = %s ? %s : %s; _r; })",
                ct,
                builtin,
                ac,
                bc,
                &tm,
                &c_int(t, int_max_bits(t)),
                &c_int(t, int_min_bits(t)),
            );
            return Some(V { .c = c, .ty = Type::TInt(t), .obj = None });
        }
        Vec<Type> oa = Vec::new();
        Vec::push(&mut oa, Type::TInt(t));
        Type opt = named("std::Option", oa);
        String oc = ctype(g, &opt);
        String fail = if (opname == "div" || opname == "rem")
        {
            str sym = if (opname == "div") { "/" } else { "%" };
            String ovf = if (int_ty_signed(t))
            {
                sprintf(
                    " || (%s == %s && %s == (%s)-1)",
                    ac,
                    &c_int(t, int_min_bits(t)),
                    bc,
                    ct,
                )
            }
            else { String::new() };
            sprintf("if (%s == 0%s) _f = 1; else _r = (%s)(%s %s %s);", bc, &ovf, ct, ac, sym, bc)
        }
        else
        {
            sprintf("_f = %s(%s, %s, &_r);", builtin, ac, bc)
        };
        String t2 = fresh(g, "ck");
        emit(x, &sprintf("%s %s;", &oc, &t2));
        emit(
            x,
            &sprintf(
                "{ %s _r = 0; int _f = 0; %s if (_f) %s.tag = 1u; else { %s.tag = 0u; %s.u.v0 = _r; } }",
                ct,
                &fail,
                &t2,
                &t2,
                &t2,
            ),
        );
        return Some(V { .c = t2, .ty = opt, .obj = None });
    }
    None
}

export fn is_math1(ref<String, shared> name) : bool
{
    foreach (n in StringView::split(
        "std::sqrt std::floor std::ceil std::round std::trunc std::ln std::exp std::log2 std::log10 std::sin std::cos std::tan std::asin std::acos std::atan",
        " ",
    ))
    {
        if (n == name)
        {
            return true;
        }
    }
    false
}

export fn is_int_op(ref<String, shared> name) : bool
{
    foreach (n in StringView::split(
        "wrapping_add wrapping_sub wrapping_mul saturating_add saturating_sub saturating_mul checked_add checked_sub checked_mul checked_div checked_rem",
        " ",
    ))
    {
        if (n == name)
        {
            return true;
        }
    }
    false
}

// `widen`, `narrow`, `narrow_wrapping`, `reinterpret`, `to_float`, `to_int`
// of `xc : s` into `d`.
export fn conversion(
    ref<String, shared> name,
    ref<Type, shared> s,
    ref<Type, shared> d,
    ref<String, shared> xc,
    ref<String, shared> lc,
) : String
{
    match (s)
    {
        Type::TInt(si) :
        {
            match (d)
            {
                Type::TInt(di) :
                {
                    if (*name == "widen" || *name == "narrow_wrapping")
                    {
                        return sprintf("((%s)%s)", c_int_type(*di), xc);
                    }
                    if (*name == "narrow")
                    {
                        return narrow_check(*si, *di, xc, lc);
                    }
                    if (*name == "reinterpret")
                    {
                        u32 sb = int_ty_bits(*si, 64);
                        u32 db = int_ty_bits(*di, 64);
                        if (db > sb)
                        {
                            str mid = if (int_ty_signed(*di)) { c_sint_of_width(sb) } else { c_uint_of_width(sb) };
                            return sprintf("((%s)(%s)(%s)%s)", c_int_type(*di), mid, c_uint_of_width(sb), xc);
                        }
                        return sprintf("((%s)%s)", c_int_type(*di), xc);
                    }
                },
                Type::TF32     :
                {
                    if (*name == "reinterpret")
                    {
                        return sprintf("(((union { uint32_t u; float f; }){ .u = (uint32_t)%s }).f)", xc);
                    }
                    if (*name == "to_float")
                    {
                        return sprintf("((float)%s)", xc);
                    }
                },
                Type::TF64     :
                {
                    if (*name == "reinterpret")
                    {
                        return sprintf("(((union { uint64_t u; double f; }){ .u = (uint64_t)%s }).f)", xc);
                    }
                    if (*name == "to_float")
                    {
                        return sprintf("((double)%s)", xc);
                    }
                },
                _              : {},
            }
        },
        Type::TF32     :
        {
            match (d)
            {
                Type::TF64     : if (*name == "widen" || *name == "to_float") { return sprintf("((double)%s)", xc); },
                Type::TF32     : if (*name == "widen" || *name == "to_float") { return sprintf("((float)%s)", xc); },
                Type::TInt(di) :
                {
                    if (*name == "reinterpret")
                    {
                        return sprintf("((%s)((union { float f; uint32_t u; }){ .f = %s }).u)", c_int_type(*di), xc);
                    }
                    if (*name == "to_int")
                    {
                        return to_int_check(*di, xc, lc);
                    }
                },
                _              : {},
            }
        },
        Type::TF64     :
        {
            match (d)
            {
                Type::TF64     : if (*name == "widen" || *name == "to_float") { return sprintf("((double)%s)", xc); },
                Type::TF32     : if (*name == "widen" || *name == "to_float") { return sprintf("((float)%s)", xc); },
                Type::TInt(di) :
                {
                    if (*name == "reinterpret")
                    {
                        return sprintf("((%s)((union { double f; uint64_t u; }){ .f = %s }).u)", c_int_type(*di), xc);
                    }
                    if (*name == "to_int")
                    {
                        return to_int_check(*di, xc, lc);
                    }
                },
                _              : {},
            }
        },
        _              : {},
    }
    assert(false, "cobc: conversion on an unexpected type");
    String::new()
}

export fn rawptr_ty(Type t) : Type
{
    Type::TRawptr(Box::new(t))
}

export fn lower_usize(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> a, usize line) : V
{
    Type us = usize_ty();
    V v = lower_expr(g, x, a, Some(&us));
    into_temp(g, x, v, line)
}

export fn lower_temp(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> a, usize line) : V
{
    V v = lower_expr(g, x, a, None);
    into_temp(g, x, v, line)
}

export fn lower_intrinsic_raw(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> name,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    usize line,
    ref<String, shared> lc,
) : Option<V>
{
    // D-0134 (`StringView::of`): the text's bytes as a shared slice; a
    // `str`'s bytes are static data no path reaches, so the slice has none.
    if (*name == "str_slice")
    {
        V st = lower_temp(g, x, &args[0], line);
        Type u8t = Type::TInt(IntTy::U8);
        type_id(g, &u8t);
        Type sty = Type::TSlice(Box::new(ModedTy { .inner = clone(&u8t), .mode = Mode::Shared }));
        String c = ctype(g, &sty);
        String t = fresh(g, "sl");
        emit(x, &sprintf("%s %s;", &c, &t));
        V rv = V { .c = sprintf(
            "((cb_ref){ (void *)(%s).p, 0 })",
            &st.c,
        ), .ty = ref_ty(u8t, Mode::Shared), .obj = None };
        Type rvt = clone(&rv.ty);
        store(g, x, &sprintf("%s.src", &t), &rvt, &rv);
        emit(x, &sprintf("%s.data = (uint8_t *)(%s).p;", &t, &st.c));
        emit(x, &sprintf("%s.len = (%s).n;", &t, &st.c));
        return Some(register_temp(g, x, t, sty, line));
    }
    if (*name == "rawptr_of")
    {
        // `[Rawptr-Of]`: the address of the place: a borrowed place directly,
        // or a reference value's target.
        match (&args[0].kind)
        {
            ExprKind::EBorrow(b) :
            {
                P p = lower_place(g, x, &Box::get(b).e);
                return Some(V { .c = sprintf("(&%s)", &p.c), .ty = rawptr_ty(clone(&p.ty)), .obj = None });
            },
            _                    : {},
        }
        V v = lower_expr(g, x, &args[0], None);
        Type pointee = match (&v.ty)
        {
            Type::TRef(m) : clone(&Box::get(m).inner),
            _             :
            {
                assert(false, "cobc: rawptr_of on a non-reference");
                Type::TVoid
            },
        };
        V r = into_temp(g, x, v, line);
        return Some(V { .c = sprintf("(%s.p)", &r.c), .ty = rawptr_ty(pointee), .obj = None });
    }
    if (*name == "allocate")
    {
        V st = lower_usize(g, x, &args[0], line);
        V at = lower_usize(g, x, &args[1], line);
        Vec<Type> ra = Vec::new();
        Vec::push(&mut ra, rawptr_ty(Type::TInt(IntTy::U8)));
        Vec::push(&mut ra, named("std::AllocError", Vec::new()));
        Type rty = named("std::Result", ra);
        String rc = ctype(g, &rty);
        String t = fresh(g, "al");
        emit(x, &sprintf("%s %s;", &rc, &t));
        emit(
            x,
            &sprintf(
                "{ uint8_t *_p = cb_allocate(%s, %s); if (_p) { %s.tag = 0u; %s.u.v0 = _p; } else %s.tag = 1u; }",
                &st.c,
                &at.c,
                &t,
                &t,
                &t,
            ),
        );
        return Some(V { .c = t, .ty = rty, .obj = None });
    }
    if (*name == "deallocate")
    {
        V pt = lower_temp(g, x, &args[0], line);
        V st = lower_usize(g, x, &args[1], line);
        V at = lower_usize(g, x, &args[2], line);
        emit(x, &sprintf("cb_deallocate(%s, %s, %s);", &pt.c, &st.c, &at.c));
        return Some(unit());
    }
    if (*name == "release")
    {
        V pt = lower_temp(g, x, &args[0], line);
        V nt = lower_usize(g, x, &args[1], line);
        emit(x, &sprintf("cb_release(%s, %s);", &pt.c, &nt.c));
        return Some(unit());
    }
    if (*name == "copy_raw")
    {
        V dt = lower_temp(g, x, &args[0], line);
        V st = lower_temp(g, x, &args[1], line);
        V nt = lower_usize(g, x, &args[2], line);
        emit(x, &sprintf("cb_copy_raw(%s, %s, %s);", &dt.c, &st.c, &nt.c));
        return Some(unit());
    }
    if (*name == "reinterpret_ptr")
    {
        Type dst = targ0(x, targs);
        V v = lower_expr(g, x, &args[0], None);
        Type ty = rawptr_ty(dst);
        String c = ctype(g, &ty);
        return Some(V { .c = sprintf("((%s)%s)", &c, &v.c), .ty = ty, .obj = None });
    }
    if (*name == "dangling")
    {
        // T-aligned and not null: `alignof<T>()` itself, as `coby`.
        Type dst = targ0(x, targs);
        u64 align = size_align(g, &dst).align;
        Type ty = rawptr_ty(dst);
        String c = ctype(g, &ty);
        return Some(V { .c = sprintf("((%s)%vu)", &c, align), .ty = ty, .obj = None });
    }
    // D-0258: an address as a pointer, and back, through `uintptr_t`.
    if (*name == "rawptr_from_address")
    {
        Type us = usize_ty();
        V a = lower_expr(g, x, &args[0], Some(&us));
        if (is_never(&a.ty))
        {
            return Some(never());
        }
        String ac = into_temp_c(g, x, a, line);
        Type ty = rawptr_ty(targ0(x, targs));
        String c = ctype(g, &ty);
        return Some(V { .c = sprintf("((%s)(uintptr_t)(%s))", &c, &ac), .ty = ty, .obj = None });
    }
    if (*name == "rawptr_address")
    {
        V p = lower_expr(g, x, &args[0], None);
        if (is_never(&p.ty))
        {
            return Some(never());
        }
        String pc = into_temp_c(g, x, p, line);
        return Some(V { .c = sprintf("((uint64_t)(uintptr_t)(%s))", &pc), .ty = usize_ty(), .obj = None });
    }
    if (*name == "null_rawptr")
    {
        // D-0252: C's `NULL`.
        Type ty = rawptr_ty(targ0(x, targs));
        String c = ctype(g, &ty);
        return Some(V { .c = sprintf("((%s)0)", &c), .ty = ty, .obj = None });
    }
    if (*name == "fault")
    {
        String seg = match (&args[0].kind)
        {
            ExprKind::EPath(p) : String::clone(&Box::get(p).segs[0]),
            _                  :
            {
                assert(false, "cobc: fault's argument");
                String::new()
            },
        };
        String id = sprintf("diag.%s", &StringView::replace(&seg, "_", "-"));
        // D-0083: an optional `str` message travels with the fault.
        if (Vec::len(args) > 1)
        {
            Type ts = Type::TStr;
            V v = lower_expr(g, x, &args[1], Some(&ts));
            V t = into_temp(g, x, v, line);
            emit(x, &sprintf("cb_fault_msg(\"%s\", %s.p, %s.n, %s);", &id, &t.c, &t.c, lc));
            return Some(never());
        }
        emit(x, &sprintf("cb_fault(\"%s\", %s);", &id, lc));
        return Some(never());
    }
    None
}

// `*a` of an argument, built anew (no fact names it).
export fn deref_of(ref<Gen, exclusive> g, ref<Expr, shared> a) : Expr
{
    Expr c = renumbered(g, a);
    synth(g, ExprKind::EDeref(Box::new(c)), a.line, a.col)
}

struct KeyBytes
{
    String p;
    String n;
}

// A hash-table key's bytes, as an address and a length: an integer's or
// `bool`'s own storage, a `str`'s or `String`'s UTF-8 bytes. `a` is a
// `ref<K, shared>`.
export fn lower_key_bytes(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<Expr, shared> a, usize line) : KeyBytes
{
    Type t = probe_type(g, x, a, None);
    // D-0312: a `String` key's probe, a view: its bytes.
    if (is_named(&t, "std::StringView"))
    {
        String v = lower_temp(g, x, a, line).c;
        return KeyBytes { .p = sprintf("(const void *)(%s).bytes.data", &v), .n = sprintf("(%s).bytes.len", &v) };
    }
    // A number, `bool` or `str` probe, by value.
    bool by_value = match (&t)
    {
        Type::TInt(_) : true,
        Type::TBool   : true,
        Type::TStr    : true,
        _             : false,
    };
    if (by_value)
    {
        V v = lower_expr(g, x, a, Some(&t));
        String ct = ctype(g, &t);
        String k = fresh(g, "k");
        emit(x, &sprintf("%s %s = %s;", &ct, &k, &v.c));
        bool is_str = match (&t)
        {
            Type::TStr : true,
            _          : false,
        };
        if (is_str)
        {
            return KeyBytes { .p = sprintf("(const void *)(%s).p", &k), .n = sprintf("(%s).n", &k) };
        }
        return KeyBytes { .p = sprintf("(const void *)&%s", &k), .n = sprintf("sizeof(%s)", &k) };
    }
    ref<Type, shared> inner = match (&t)
    {
        Type::TRef(m) : &Box::get(m).inner,
        _             :
        {
            assert(false, "cobc: a key that is not a reference");
            return KeyBytes { .p = String::new(), .n = String::new() };
        },
    };
    if (is_named(inner, "std::String"))
    {
        String r = lower_temp(g, x, a, line).c;
        String lc = loc(g, x.std_body, line);
        emit(x, &sprintf("cb_read((%s).tok, NULL, 0, %s);", &r, &lc));
        String sc = ctype(g, &named("std::String", Vec::new()));
        return KeyBytes { .p = sprintf(
            "(const void *)((%s *)(%s).p)->bytes.ptr",
            &sc,
            &r,
        ), .n = sprintf("((%s *)(%s).p)->bytes.len", &sc, &r) };
    }
    Expr d = deref_of(g, a);
    V v = lower_expr(g, x, &d, None);
    String ct = ctype(g, &v.ty);
    String k = fresh(g, "k");
    emit(x, &sprintf("%s %s = %s;", &ct, &k, &v.c));
    match (&v.ty)
    {
        Type::TStr    : KeyBytes { .p = sprintf("(const void *)(%s).p", &k), .n = sprintf("(%s).n", &k) },
        Type::TInt(_) : KeyBytes { .p = sprintf("(const void *)&%s", &k), .n = sprintf("sizeof(%s)", &k) },
        Type::TBool   : KeyBytes { .p = sprintf("(const void *)&%s", &k), .n = sprintf("sizeof(%s)", &k) },
        _             :
        {
            assert(false, "cobc: a key of a type that is not hashable");
            KeyBytes { .p = String::new(), .n = String::new() }
        },
    }
}

// D-0110: the referent of a key reference that is a struct or enum.
// D-0110: the referent of a key reference that is a struct or enum.
export fn key_referent(ref<Type, shared> t) : Type
{
    match (t)
    {
        Type::TRef(m) : clone(&Box::get(m).inner),
        _             : clone(t),
    }
}

// A key reference's referent as a pointer, read through the reference
// (checked once).
export fn lower_key_ptr(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> a,
    ref<Type, shared> kt,
    usize line,
) : String
{
    V r0 = lower_expr(g, x, a, None);
    String r = into_temp_c(g, x, r0, line);
    String lc = loc(g, x.std_body, line);
    emit(x, &sprintf("cb_read((%s).tok, NULL, 0, %s);", &r, &lc));
    String ct = ctype(g, kt);
    sprintf("((const %s *)(%s).p)", &ct, &r)
}

struct KeyPart
{
    Option<usize> variant;
    String acc;
    Type ty;
}

// D-0110: the fields (or an enum's tag and payloads) of a struct or enum key
// type, with their C access and type: `is_enum`, and the parts.
// None: not an aggregate (cobc's `internal` error, which a caller may
// swallow).
export fn key_parts(ref<Gen, exclusive> g, ref<Type, shared> t, ref<Vec<KeyPart>, exclusive> out) : Option<bool>
{
    NamedTy nt = match (t)
    {
        Type::TNamed(n) : clone(Box::get(n)),
        _               : return None,
    };
    match (struct_decl(g, &nt.name))
    {
        Some(sd) :
        {
            match (sd.bits)
            {
                // D-0118: `[Key-Bytes]` of a bitstruct is its backing integer's.
                Some(b) :
                {
                    Vec::push(out, KeyPart { .variant = None, .acc = "bits", .ty = Type::TInt(b) });
                    return Some(false);
                },
                None    : {},
            }
            HashMap<String, Type> sub = subst_of(&sd.type_params, &nt.args);
            foreach (f in &sd.fields)
            {
                Vec::push(
                    out,
                    KeyPart { .variant = None, .acc = san(&f.name), .ty = apply(&f.ty, &sub) },
                );
            }
            return Some(false);
        },
        None     : {},
    }
    EnumDecl ed = match (enum_decl(g, &nt.name))
    {
        Some(d) : d,
        None    : return None,
    };
    HashMap<String, Type> sub = subst_of(&ed.type_params, &nt.args);
    for (usize i = 0; i < Vec::len(&ed.variants); i += 1)
    {
        match (&ed.variants[i].payload)
        {
            Some(pt) : Vec::push(
                out,
                KeyPart { .variant = Some(i), .acc = sprintf("u.v%v", i), .ty = apply(pt, &sub) },
            ),
            None : {},
        }
    }
    Some(true)
}

// D-0110: `h` folded over one key part's bytes (`[Key-Bytes]`).
export fn key_hash_part(ref<Gen, exclusive> g, ref<Type, shared> t, ref<String, shared> e) : String
{
    match (t)
    {
        Type::TInt(_)   : return sprintf("h = cb_fnv_more(h, &(%s), sizeof(%s));", e, e),
        Type::TBool     : return sprintf("h = cb_fnv_more(h, &(%s), sizeof(%s));", e, e),
        Type::TStr : return sprintf(
            "{ uint64_t n = (%s).n; h = cb_fnv_more(h, &n, 8); h = cb_fnv_more(h, (%s).p, n); }",
            e,
            e,
        ),
        Type::TNamed(n) :
        {
            if (Box::get(n).name == "std::String")
            {
                return sprintf(
                    "{ uint64_t n = (%s).bytes.len; h = cb_fnv_more(h, &n, 8); h = cb_fnv_more(h, (%s).bytes.ptr, n); }",
                    e,
                    e,
                );
            }
        },
        _               : {},
    }
    String f = key_hash_fn(g, t);
    sprintf("h = %s(h, &(%s));", &f, e)
}

// D-0110: the key types' order on one part: negative, zero, positive.
export fn key_cmp_part(
    ref<Gen, exclusive> g,
    ref<Type, shared> t,
    ref<String, shared> a,
    ref<String, shared> b,
) : Option<String>
{
    match (t)
    {
        Type::TInt(_)   : return Some(sprintf("((%s) < (%s) ? -1 : (%s) > (%s) ? 1 : 0)", a, b, a, b)),
        Type::TBool     : return Some(sprintf("((%s) < (%s) ? -1 : (%s) > (%s) ? 1 : 0)", a, b, a, b)),
        Type::TStr      : return Some(sprintf("cb_bytes_cmp((%s).p, (%s).n, (%s).p, (%s).n)", a, a, b, b)),
        Type::TNamed(n) :
        {
            if (Box::get(n).name == "std::String")
            {
                return Some(sprintf(
                    "cb_bytes_cmp((%s).bytes.ptr, (%s).bytes.len, (%s).bytes.ptr, (%s).bytes.len)",
                    a,
                    a,
                    b,
                    b,
                ));
            }
        },
        _               : {},
    }
    String f = key_cmp_fn_opt(g, t)?;
    Some(sprintf("%s(&(%s), &(%s))", &f, a, b))
}

// D-0110: `cb_kh_...`, a struct or enum key's hash folded into `h` (FNV-1a
// over `[Key-Bytes]`). The functions for its parts come first.
export fn key_hash_fn(ref<Gen, exclusive> g, ref<Type, shared> t) : String
{
    String key = type_code(t);
    match (HashMap::get(&g.khs, &key))
    {
        Some(n) : return String::clone(n),
        None    : {},
    }
    String ct = ctype(g, t);
    String name = sprintf("cb_kh_%s", &mangle(t));
    Vec<KeyPart> parts = Vec::new();
    bool is_enum = Option::expect(key_parts(g, t, &mut parts), "cobc: key parts of a non-aggregate");
    String body = String::new();
    if (is_enum)
    {
        String::append(
            &mut body,
            "    uint32_t tag = (uint32_t)k->tag;\n    h = cb_fnv_more(h, &tag, 4);\n    switch (k->tag) {\n",
        );
        foreach (kp in &parts)
        {
            String st = key_hash_part(g, &kp.ty, &sprintf("k->%s", &kp.acc));
            String::appendf(&mut body, "    case %vu: %s break;\n", Option::unwrap(kp.variant), &st);
        }
        String::append(&mut body, "    default: break;\n    }\n");
    }
    else
    {
        foreach (kp in &parts)
        {
            String st = key_hash_part(g, &kp.ty, &sprintf("k->%s", &kp.acc));
            String::appendf(&mut body, "    %s\n", &st);
        }
    }
    String::append(&mut body, "    return h;\n");
    String::appendf(&mut g.thunks_out, "uint64_t %s(uint64_t h, const %s *k)\n{\n%s}\n", &name, &ct, &body);
    HashMap::insert(&mut g.khs, key, String::clone(&name));
    name
}

// D-0110: `cb_kc_...`, the key types' order on a struct or enum key: field by
// field in declaration order; an enum by variant, then payload.
export fn key_cmp_fn(ref<Gen, exclusive> g, ref<Type, shared> t) : String
{
    Option::expect(key_cmp_fn_opt(g, t), "cobc: key parts of a non-aggregate")
}

// `key_cmp_fn`, None where cobc's fails (a part that is no key type); what
// it registered on the way stays, as cobc's does.
export fn key_cmp_fn_opt(ref<Gen, exclusive> g, ref<Type, shared> t) : Option<String>
{
    String key = type_code(t);
    match (HashMap::get(&g.kcs, &key))
    {
        Some(n) : return Some(String::clone(n)),
        None    : {},
    }
    String ct = ctype(g, t);
    String name = sprintf("cb_kc_%s", &mangle(t));
    Vec<KeyPart> parts = Vec::new();
    bool is_enum = key_parts(g, t, &mut parts)?;
    String body = String::new();
    if (is_enum)
    {
        String::append(
            &mut body,
            "    if (a->tag != b->tag) return a->tag < b->tag ? -1 : 1;\n    switch (a->tag) {\n",
        );
        foreach (kp in &parts)
        {
            String e = key_cmp_part(g, &kp.ty, &sprintf("a->%s", &kp.acc), &sprintf("b->%s", &kp.acc))?;
            String::appendf(&mut body, "    case %vu: return %s;\n", Option::unwrap(kp.variant), &e);
        }
        String::append(&mut body, "    default: return 0;\n    }\n");
    }
    else
    {
        foreach (kp in &parts)
        {
            String e = key_cmp_part(g, &kp.ty, &sprintf("a->%s", &kp.acc), &sprintf("b->%s", &kp.acc))?;
            String::appendf(&mut body, "    { int c = %s; if (c) return c; }\n", &e);
        }
        String::append(&mut body, "    return 0;\n");
    }
    String::appendf(&mut g.thunks_out, "int %s(const %s *a, const %s *b)\n{\n%s}\n", &name, &ct, &ct, &body);
    HashMap::insert(&mut g.kcs, key, String::clone(&name));
    Some(name)
}

export fn is_composite_key(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(m) :
        {
            match (&Box::get(m).inner)
            {
                Type::TNamed(n) : Box::get(n).name != "std::String",
                _               : false,
            }
        },
        _             : false,
    }
}

export fn consume_or_drop(ref<Gen, exclusive> g, ref<Fx, exclusive> x, ref<V, shared> t, ref<String, shared> lc)
{
    match (&t.obj)
    {
        Some(o) : emit(x, &sprintf("cb_consume(%s, %s);", o, lc)),
        None    :
        {
            if (holds_fn(g, &t.ty))
            {
                u32 tid = type_id(g, &t.ty);
                emit(x, &sprintf("cb_drop_value(&%s, %vu);", &t.c, tid));
            }
        },
    }
}

export fn lower_intrinsic_more(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<String, shared> name,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    Option<ref<Type, shared>> expected,
    usize line,
    ref<String, shared> lc,
) : Option<V>
{
    // `foreach` (D-0042): the expansion for the type of the hidden binding
    // the call names first (front/each.cb), its nodes numbered anew.
    if (is_each_name(name))
    {
        Type t0 = probe_type(g, x, &args[0], None);
        usize col = if (Vec::len(args) > 0) { args[0].col } else { 0 };
        Expr ex = match (each_expand(name, &t0, args, line, col))
        {
            Ok(e)  : e,
            Err(_) :
            {
                assert(false, "cobc: foreach over an unexpected type");
                return Some(unit());
            },
        };
        number_expr(&mut ex, &mut g.synth_id);
        return Some(lower_expr(g, x, &ex, expected));
    }
    if (*name == "drop")
    {
        // `drop(reclaim<T>(p))` of a resource `T`: `[Destroy]` of the place
        // `[Reclaim]` makes, through its root (`spec/07` §3), as `coby` has it
        // -- not a move out of it into a temporary, which a live reference into
        // the object faulted as `diag.move-while-aliased` where
        // `[Destroy-Not-Solitary]`'s `diag.destroy-while-aliased` is the rule's.
        match (&args[0].kind)
        {
            ExprKind::ECall(ce) :
            {
                match (&Box::get(ce).callee.kind)
                {
                    ExprKind::EPath(cp) :
                    {
                        ref<PathExpr, shared> pe = Box::get(cp);
                        if (Vec::len(&pe.segs) == 1 && pe.segs[0] == "reclaim" && Option::is_none(
                            &lookup(x, "reclaim"),
                        ) && Vec::len(&pe.targs) == 1 && is_resource(g, &apply(&pe.targs[0], &x.subst)))
                        {
                            P rp = lower_place(g, x, &args[0]);
                            match (&rp.base)
                            {
                                Some(root) :
                                {
                                    emit(x, &sprintf("cb_destroy(%s, %s);", root, lc));
                                    return Some(unit());
                                },
                                None       : assert(false, "cobc: a reclaimed place with no root"),
                            }
                        }
                    },
                    _                   : {},
                }
            },
            _                   : {},
        }
        // `drop(e)` of a temporary: the value is destroyed at once.
        if (!is_place_kind(&args[0]) && !is_paren(&args[0]))
        {
            // CHG-0432: in a decided body, a call dropped at once whose type's
            // end frees memory alone, or has a destructor of its own, is taken
            // with no object and ended here (cobc's `drop`).
            bool is_call = match (&args[0].kind)
            {
                ExprKind::ECall(_) : true,
                _                  : false,
            };
            bool arm = false;
            if (g.decided && x.probing == 0 && is_call)
            {
                Type st = probe_type(g, x, &args[0], None);
                arm = is_resource(g, &st) && !has_refs(g, &st) && (objectless_type(g, &st) || noted_type(g, &st));
            }
            Option<InertResult> outer_inert = replace(&mut x.inert_result, None);
            if (arm)
            {
                arm_inert(g, x, &args[0], true);
            }
            V v = lower_expr(g, x, &args[0], None);
            x.inert_result = outer_inert;
            if (is_never(&v.ty))
            {
                return Some(never());
            }
            V t = into_temp(g, x, v, line);
            if (arm && Option::is_none(&t.obj) && HashSet::contains(&x.inert_c, &t.c))
            {
                u32 tid = type_id(g, &t.ty);
                String d = objectless_drop(g, &t.c, tid, &t.ty);
                emit(x, &d);
                return Some(unit());
            }
            consume_or_drop(g, x, &t, lc);
            return Some(unit());
        }
        P p = lower_place(g, x, &args[0]);
        // D-0315: an objectless local (decided): its drop where it is, then
        // its moved flag set (the walk took `drop(x)` as a move).
        if (g.decided && Option::is_none(&p.base) && p.is_binding && Vec::len(&p.projs) == 0 && HashSet::contains(&x.objectless_c, &p.c))
        {
            String fl = match (HashMap::get(&x.moved_flag, &p.c))
            {
                Some(f) : String::clone(f),
                None    :
                {
                    assert(false, "cobc: an objectless local dropped without a moved flag");
                    return None;
                },
            };
            objectless_use(g, x, &p.c, line);
            u32 dtid = type_id(g, &p.ty);
            String dd = objectless_drop(g, &p.c, dtid, &p.ty);
            emit(x, &sprintf("%s %s = 1;", &dd, &fl));
            return Some(unit());
        }
        if (Option::is_some(&p.raw))
        {
            // `drop(*p)` of raw storage: the value moves out and is destroyed.
            V v = read_place(g, x, p, line);
            V t = into_temp(g, x, v, line);
            consume_or_drop(g, x, &t, lc);
            return Some(unit());
        }
        match (&p.base)
        {
            Some(b) :
            {
                if (Vec::len(&p.projs) > 0)
                {
                    // `[Destroy-Projection]`: a field, element, or payload.
                    emit(x, &sprintf("cb_fault(\"diag.move-out-of-field\", %s);", lc));
                    return Some(never());
                }
                if (p.is_binding && *b == "0" && (pinned_plain(g, &p.ty) || decided_ref(g, &p.ty)))
                {
                    // D-0315: a pinned plain local (`pinned_plain`, root token 0,
                    // no object): a plain value's end does nothing.
                }
                else if (p.is_binding)
                {
                    emit(x, &sprintf("cb_destroy(%s, %s);", b, lc));
                }
                else
                {
                    // D-0292: the referent's place, for a light reference.
                    u32 dtid = type_id(g, &p.ty);
                    emit(
                        x,
                        &sprintf("cb_destroy_via(%s, (void *)&(%s), %vu, %s);", b, &p.c, dtid, lc),
                    );
                }
            },
            None    : assert(false, "cobc: drop of a place with no path"),
        }
        return Some(unit());
    }
    if (*name == "std::exit")
    {
        // `[Exit]` (D-0150): the runtime unwinds this thread and ends the
        // program with the status.
        Type u8t = Type::TInt(IntTy::U8);
        V v = lower_expr(g, x, &args[0], Some(&u8t));
        V t = into_temp(g, x, v, line);
        emit(x, &sprintf("cb_exit(%s);", &t.c));
        return Some(never());
    }
    // D-0116: `clone(&x)`: a plain `T` is `*r`; a resource `T` is a call of
    // its `T::clone`, declared or derived, at `T`'s arguments.
    if (*name == "clone")
    {
        Type ty = match (&args[0].kind)
        {
            ExprKind::EBorrow(b) :
            {
                if (Box::get(b).mode == Mode::Shared)
                {
                    probe_type(g, x, &Box::get(b).e, None)
                }
                else
                {
                    deref_ty(probe_type(g, x, &args[0], None))
                }
            },
            _                    : deref_ty(probe_type(g, x, &args[0], None)),
        };
        if (!is_resource(g, &ty))
        {
            match (&args[0].kind)
            {
                ExprKind::EBorrow(b) :
                {
                    if (Box::get(b).mode == Mode::Shared)
                    {
                        return Some(lower_expr(g, x, &Box::get(b).e, expected));
                    }
                },
                _                    : {},
            }
            Expr d = synth(g, ExprKind::EDeref(Box::new(renumbered(g, &args[0]))), line, args[0].col);
            return Some(lower_expr(g, x, &d, expected));
        }
        ref<NamedTy, shared> nt = match (&ty)
        {
            Type::TNamed(n) : Box::get(n),
            _               :
            {
                assert(false, "cobc: clone of a resource that is not a named type");
                return Some(unit());
            },
        };
        String key = sprintf("%s::clone", &nt.name);
        FnDecl f = Option::expect(get_fn(g, &key), "cobc: clone of a type with no clone");
        return Some(lower_user_call(g, x, &key, &f, &nt.args, args, expected, line));
    }
    // D-0213 `[Thread-Lend]` (std-only, `Channel::send`): the exclusive
    // references the place holds are lent.
    if (*name == "lend_places")
    {
        Type ty = deref_ty(probe_type(g, x, &args[0], None));
        V a = lower_temp(g, x, &args[0], line);
        if (has_refs(g, &ty))
        {
            String c = ctype(g, &ty);
            // D-0235: the place is written by `[Write]`.
            emit(x, &sprintf("cb_write((%s).tok, NULL, 0, 0u, %s);", &a.c, lc));
            emit(x, &sprintf("cb_lend((%s).p, sizeof(%s), %s);", &a.c, &c, lc));
        }
        return Some(unit());
    }
    if (*name == "swap_places")
    {
        Type ty = deref_ty(probe_type(g, x, &args[0], None));
        V a = lower_temp(g, x, &args[0], line);
        V b = lower_temp(g, x, &args[1], line);
        String c = ctype(g, &ty);
        // `[Swap-Places]` needs both places still there; the same place twice
        // is left alone, and otherwise each place is written by `[Write]`.
        emit(x, &sprintf("cb_valid((%s).tok, %s);", &a.c, lc));
        emit(x, &sprintf("cb_valid((%s).tok, %s);", &b.c, lc));
        String pa = sprintf("((%s *)(%s).p)", &c, &a.c);
        String pb = sprintf("((%s *)(%s).p)", &c, &b.c);
        String t = fresh(g, "sw");
        emit(x, &sprintf("if (%s != %s) {", &pa, &pb));
        emit(x, &sprintf("cb_write((%s).tok, NULL, 0, 0u, %s);", &a.c, lc));
        emit(x, &sprintf("cb_write((%s).tok, NULL, 0, 0u, %s);", &b.c, lc));
        emit(x, &sprintf("%s %s; memcpy(&%s, %s, sizeof(%s));", &c, &t, &t, &pa, &c));
        if (has_refs(g, &ty))
        {
            u32 tid = type_id(g, &ty);
            emit(x, &sprintf("cb_copy_datum(&%s, %s, %vu);", &t, &pa, tid));
            emit(x, &sprintf("cb_env_forget((uint8_t *)%s, sizeof(%s));", &pa, &c));
            emit(
                x,
                &sprintf(
                    "memcpy(%s, %s, sizeof(%s)); cb_copy_datum(%s, %s, %vu);",
                    &pa,
                    &pb,
                    &c,
                    &pa,
                    &pb,
                    tid,
                ),
            );
            emit(x, &sprintf("cb_env_forget((uint8_t *)%s, sizeof(%s));", &pb, &c));
            emit(
                x,
                &sprintf(
                    "memcpy(%s, &%s, sizeof(%s)); cb_copy_datum(%s, &%s, %vu);",
                    &pb,
                    &t,
                    &c,
                    &pb,
                    &t,
                    tid,
                ),
            );
            emit(x, &sprintf("cb_env_forget((uint8_t *)&%s, sizeof(%s));", &t, &c));
        }
        else
        {
            emit(x, &sprintf("memcpy(%s, %s, sizeof(%s));", &pa, &pb, &c));
            emit(x, &sprintf("memcpy(%s, &%s, sizeof(%s));", &pb, &t, &c));
        }
        emit(x, "}");
        return Some(unit());
    }
    if (*name == "key_less_at")
    {
        Type vt = probe_type(g, x, &args[0], None);
        Type inner = deref_ty(vt);
        Type elem = match (&inner)
        {
            Type::TNamed(n) : if (Vec::len(&Box::get(n).args) > 0) { clone(&Box::get(n).args[0]) } else { Type::TVoid },
            _               : Type::TVoid,
        };
        String vc = ctype(g, &inner);
        String r = lower_temp(g, x, &args[0], line).c;
        String i = lower_usize(g, x, &args[1], line).c;
        String j = lower_usize(g, x, &args[2], line).c;
        emit(x, &sprintf("cb_read((%s).tok, NULL, 0, %s);", &r, lc));
        String len = sprintf("((%s *)(%s).p)->len", &vc, &r);
        emit(
            x,
            &sprintf(
                "cb_index_check((uint64_t)%s, %s, %s); cb_index_check((uint64_t)%s, %s, %s);",
                &i,
                &len,
                lc,
                &j,
                &len,
                lc,
            ),
        );
        String ai = sprintf("((%s *)(%s).p)->ptr[%s]", &vc, &r, &i);
        String aj = sprintf("((%s *)(%s).p)->ptr[%s]", &vc, &r, &j);
        Option<String> key = match (&elem)
        {
            Type::TNamed(n) :
            {
                if (Box::get(n).name == "std::String")
                {
                    Some(sprintf(
                        "cb_bytes_less((const void *)%s.bytes.ptr, %s.bytes.len, (const void *)%s.bytes.ptr, %s.bytes.len)",
                        &ai,
                        &ai,
                        &aj,
                        &aj,
                    ))
                }
                else
                {
                    // D-0110: a struct or enum key; none where cobc's
                    // `key_cmp_fn` fails (`.ok()`), as for `Rc<String>`.
                    match (key_cmp_fn_opt(g, &elem))
                    {
                        Some(f) : Some(sprintf("((uint8_t)(%s(&%s, &%s) < 0))", &f, &ai, &aj)),
                        None    : None,
                    }
                }
            },
            Type::TStr : Some(sprintf(
                "cb_bytes_less((const void *)%s.p, %s.n, (const void *)%s.p, %s.n)",
                &ai,
                &ai,
                &aj,
                &aj,
            )),
            Type::TInt(_)   : Some(sprintf("((uint8_t)(%s < %s))", &ai, &aj)),
            Type::TBool     : Some(sprintf("((uint8_t)(%s < %s))", &ai, &aj)),
            // D-0181: a float's order, a NaN after every other value.
            Type::TF32 : Some(sprintf(
                "((uint8_t)(%s < %s || (%s != %s && %s == %s)))",
                &ai,
                &aj,
                &aj,
                &aj,
                &ai,
                &ai,
            )),
            Type::TF64 : Some(sprintf(
                "((uint8_t)(%s < %s || (%s != %s && %s == %s)))",
                &ai,
                &aj,
                &aj,
                &aj,
                &ai,
                &ai,
            )),
            _               : None,
        };
        String c = match (key)
        {
            Some(k) : k,
            None    :
            {
                emit(x, &sprintf("cb_fault(\"diag.type-mismatch\", %s);", lc));
                "((uint8_t)0)"
            },
        };
        return Some(V { .c = c, .ty = Type::TBool, .obj = None });
    }
    if (*name == "key_less")
    {
        // D-0312: a view probes a `String` key: the other operand's type
        // says how the two compare.
        Type t0 = probe_type(g, x, &args[0], None);
        Type t = if (is_named(&t0, "std::StringView")) { probe_type(g, x, &args[1], None) } else { t0 };
        if (is_composite_key(&t))
        {
            Type kt = key_referent(&t);
            String f = key_cmp_fn(g, &kt);
            String ka = lower_key_ptr(g, x, &args[0], &kt, line);
            String kb = lower_key_ptr(g, x, &args[1], &kt, line);
            return Some(V { .c = sprintf(
                "((uint8_t)(%s(%s, %s) < 0))",
                &f,
                &ka,
                &kb,
            ), .ty = Type::TBool, .obj = None });
        }
        bool text = match (&t)
        {
            Type::TRef(m) : is_text_ty(&Box::get(m).inner) && !is_named(&Box::get(m).inner, "std::StringView"),
            _             : false,
        };
        if (text)
        {
            KeyBytes a = lower_key_bytes(g, x, &args[0], line);
            KeyBytes b = lower_key_bytes(g, x, &args[1], line);
            return Some(V { .c = sprintf(
                "cb_bytes_less(%s, %s, %s, %s)",
                &a.p,
                &a.n,
                &b.p,
                &b.n,
            ), .ty = Type::TBool, .obj = None });
        }
        Vec<String> vs = Vec::new();
        bool float = false;
        foreach (a in args)
        {
            // D-0312: a probe by value is compared as it is.
            Type at = probe_type(g, x, a, None);
            bool by_ref = match (&at)
            {
                Type::TRef(_) : true,
                _             : false,
            };
            Expr d = if (by_ref) { deref_of(g, a) } else { renumbered(g, a) };
            V v = lower_expr(g, x, &d, None);
            float = is_float(&v.ty);
            Vec::push(&mut vs, into_temp_c(g, x, v, line));
        }
        if (float)
        {
            return Some(V { .c = sprintf(
                "((uint8_t)(%s < %s || (%s != %s && %s == %s)))",
                &vs[0],
                &vs[1],
                &vs[1],
                &vs[1],
                &vs[0],
                &vs[0],
            ), .ty = Type::TBool, .obj = None });
        }
        return Some(V { .c = sprintf("((uint8_t)(%s < %s))", &vs[0], &vs[1]), .ty = Type::TBool, .obj = None });
    }
    // D-0312: `probe_key(k)`, a copy of the key the probe `k` names:
    // `String::copy` of a view, `clone` of a reference, the value
    // itself.
    if (*name == "probe_key")
    {
        Type t = probe_type(g, x, &args[0], None);
        bool view = is_named(&t, "std::StringView");
        bool by_ref = match (&t)
        {
            Type::TRef(_) : true,
            _             : false,
        };
        if (!view && !by_ref)
        {
            return Some(lower_expr(g, x, &args[0], expected));
        }
        Vec<String> segs = Vec::new();
        if (view)
        {
            Vec::push(&mut segs, "std");
            Vec::push(&mut segs, "String");
            Vec::push(&mut segs, "copy");
        }
        else
        {
            Vec::push(&mut segs, "clone");
        }
        Expr callee = synth(g, ExprKind::EPath(Box::new(PathExpr { .segs = segs, .targs = Vec::new() })), args[0].line, args[0].col);
        Vec<Expr> cargs = Vec::new();
        Vec::push(&mut cargs, renumbered_with_facts(g, &args[0]));
        Expr call = synth(g, ExprKind::ECall(Box::new(CallExpr { .callee = callee, .args = cargs })), args[0].line, args[0].col);
        return Some(lower_expr(g, x, &call, expected));
    }
    // D-0312: `probe_eq(a, k)`, whether `*a` is what the probe `k` names:
    // `String::same_view(a, k)` for a view, `*a == *k`, `*a == k`.
    if (*name == "probe_eq")
    {
        Type t = probe_type(g, x, &args[1], None);
        // A struct or enum key by reference: compared in place, as `==`
        // compares it (`key_cmp_fn`).
        if (is_composite_key(&t))
        {
            Type kt = key_referent(&t);
            String ka = lower_key_ptr(g, x, &args[0], &kt, line);
            String kb = lower_key_ptr(g, x, &args[1], &kt, line);
            String f = key_cmp_fn(g, &kt);
            return Some(V { .c = sprintf("((uint8_t)(%s(%s, %s) == 0))", &f, &ka, &kb), .ty = Type::TBool, .obj = None });
        }
        usize l = args[0].line;
        usize c = args[0].col;
        Expr e = if (is_named(&t, "std::StringView"))
        {
            Vec<String> segs = Vec::new();
            Vec::push(&mut segs, "std");
            Vec::push(&mut segs, "String");
            Vec::push(&mut segs, "same_view");
            Expr callee = synth(g, ExprKind::EPath(Box::new(PathExpr { .segs = segs, .targs = Vec::new() })), l, c);
            Vec<Expr> cargs = Vec::new();
            Vec::push(&mut cargs, renumbered_with_facts(g, &args[0]));
            Vec::push(&mut cargs, renumbered_with_facts(g, &args[1]));
            synth(g, ExprKind::ECall(Box::new(CallExpr { .callee = callee, .args = cargs })), l, c)
        }
        else
        {
            bool by_ref = match (&t)
            {
                Type::TRef(_) : true,
                _             : false,
            };
            Expr da = deref_of(g, &args[0]);
            Expr k = if (by_ref) { deref_of(g, &args[1]) } else { renumbered(g, &args[1]) };
            synth(g, ExprKind::EBinary(Box::new(BinaryExpr { .op = BinOp::Eq, .a = da, .b = k })), l, c)
        };
        Type bt = Type::TBool;
        return Some(lower_expr(g, x, &e, Some(&bt)));
    }
    if (*name == "key_hash" || *name == "key_eq")
    {
        Type t = probe_type(g, x, &args[0], None);
        if (is_composite_key(&t))
        {
            Type kt = key_referent(&t);
            Vec<String> ps = Vec::new();
            foreach (a in args)
            {
                Vec::push(&mut ps, lower_key_ptr(g, x, a, &kt, line));
            }
            if (*name == "key_hash")
            {
                String f = key_hash_fn(g, &kt);
                return Some(V { .c = sprintf(
                    "%s(14695981039346656037ull, %s)",
                    &f,
                    &ps[0],
                ), .ty = Type::TInt(IntTy::U64), .obj = None });
            }
            String f = key_cmp_fn(g, &kt);
            return Some(V { .c = sprintf(
                "((uint8_t)(%s(%s, %s) == 0))",
                &f,
                &ps[0],
                &ps[1],
            ), .ty = Type::TBool, .obj = None });
        }
        Vec<KeyBytes> keys = Vec::new();
        foreach (a in args)
        {
            Vec::push(&mut keys, lower_key_bytes(g, x, a, line));
        }
        if (*name == "key_hash")
        {
            return Some(V { .c = sprintf(
                "cb_hash_bytes(%s, %s)",
                &keys[0].p,
                &keys[0].n,
            ), .ty = Type::TInt(IntTy::U64), .obj = None });
        }
        return Some(V { .c = sprintf(
            "cb_bytes_eq(%s, %s, %s, %s)",
            &keys[0].p,
            &keys[0].n,
            &keys[1].p,
            &keys[1].n,
        ), .ty = Type::TBool, .obj = None });
    }
    None
}

export fn is_paren(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EParen(_) : true,
        _                   : false,
    }
}

export fn deref_ty(Type t) : Type
{
    match (t)
    {
        Type::TRef(m) :
        {
            ModedTy { inner, mode } = Box::into_inner(m);
            inner
        },
        other         : other,
    }
}

// A call as a value; `reclaim<T>(p)` is read as the place it names.
export fn lower_call_expr(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    ref<Expr, shared> e,
    ref<CallExpr, shared> c,
    Option<ref<Type, shared>> expected,
) : V
{
    match (&c.callee.kind)
    {
        ExprKind::EPath(p) :
        {
            if (Vec::len(&Box::get(p).segs) == 1 && Box::get(p).segs[0] == "reclaim")
            {
                P pl = lower_place(g, x, e);
                return read_place(g, x, pl, e.line);
            }
        },
        _                  : {},
    }
    lower_call(g, x, &c.callee, &c.args, expected, e.line)
}

// ---- the program's C in parts (lower.rs's `Generated`) ----

// The generated C in parts (`generate_parts`); `combined` is the single
// file `--keep-c` writes and the no-cache path compiles.
export struct Generated
{
    // CHG-0449: `Gen::guard_notes`, sorted, each once.
    export Vec<GuardNote> guard_notes;
    export String fwd;
    export String types;
    export String strings;
    export String protos;
    export String thunks;
    export String descs;
    export Vec<Unit> units;
    export String tail;
    // D-0257: the C header of a library's entry points (`--lib`).
    export String header_text;
    // D-0281 step 4c: lowered pathless (`None`), or why not (`Some(why)`;
    // cobc's `Result<(), String>`).
    export Option<String> kept;
    // D-0285: lowered knowing the program is decided (`Gen::decided`).
    export bool decided;
    // cobc's `Unsupported`: what the lowering could not write; then the
    // other parts are empty.
    export Option<String> unsupported;
}

// The program's C, the C file's name `c_name` (for the `#line` that returns
// to the C's own lines).
export fn generate(ref<Gen, exclusive> g, StringView c_name) : String
{
    combined(&generate_parts(g, false), c_name)
}

// What the driver gets from `generate_program`: the parts, and the `-v`
// notes the two-pass lowering makes (each as `note` prints it, without the
// `cobc: ` prefix), or what the first lowering could not write
// (`unsupported`: cobc's status 3).
export struct Lowered
{
    export Generated gen;
    export Vec<String> notes;
    export Option<String> unsupported;
}

// cobc's `real_main` lowering (D-0284, D-0285): the program lowered once;
// found decided (`pathless` with no blocker) and COBALTC_DECIDED not "0",
// lowered again knowing it (`Gen::decided`); on `Unsupported` or kept paths
// the first lowering is used, with a note. COBALTC_PATHLESS=0 keeps the
// paths. `level` is `Gen::bootstrap`, `all_checks` whether the driver asked
// for every check.
export fn generate_program(Checked prog, bool lib, u8 level, bool all_checks, bool line_directives, bool report_guards) : Lowered
{
    bool pathless_env = env_not_zero("COBALTC_PATHLESS");
    Vec<String> notes = Vec::new();
    Gen first = new_gen(prog);
    first.bootstrap = level;
    first.all_checks = first.all_checks || all_checks || level > 0;
    first.line_directives = line_directives;
    first.report_guards = report_guards;
    first.pathless = pathless_env;
    first.decided = false;
    Generated gen = generate_parts(&mut first, lib);
    Option<String> first_unsupported = clone(&gen.unsupported);
    if (Option::is_some(&first_unsupported))
    {
        return Lowered { .gen = gen, .notes = notes, .unsupported = first_unsupported };
    }
    if (Option::is_none(&gen.kept) && env_not_zero("COBALTC_DECIDED"))
    {
        Gen { prog, .. } = first;
        Gen second = new_gen(prog);
        second.bootstrap = level;
        second.all_checks = second.all_checks || all_checks || level > 0;
        second.line_directives = line_directives;
        second.report_guards = report_guards;
        second.pathless = pathless_env;
        second.decided = true;
        Generated g2 = generate_parts(&mut second, lib);
        match (&g2.unsupported)
        {
            Some(what) : Vec::push(
                &mut notes,
                sprintf("decided lowering: unsupported: %s; the first lowering is used", what),
            ),
            None :
            {
                match (&g2.kept)
                {
                    None : gen = g2,
                    Some(why) : Vec::push(
                        &mut notes,
                        sprintf("decided lowering kept paths (%s); the first lowering is used", why),
                    ),
                }
            },
        }
    }
    match (&gen.kept)
    {
        None      :
        {
            if (gen.decided)
            {
                Vec::push(&mut notes, "lowered pathless and decided (D-0284, D-0285)");
            }
            else
            {
                Vec::push(&mut notes, "lowered pathless (D-0284)");
            }
        },
        Some(why) : Vec::push(&mut notes, sprintf("kept paths: %s; lowered with holders (D-0292)", why)),
    }
    Lowered { .gen = gen, .notes = notes, .unsupported = None }
}

// `Generated::header`: the runtime's C interface every C file begins with.
export fn generated_header() : str
{
    HEADER
}

// The single C file, `c_name` the name it is written under (for the `#line`
// that returns to the C's own lines, `settle_lines`).
export fn combined(ref<Generated, shared> gen, StringView c_name) : String
{
    settle_lines(&combined_text(gen), c_name)
}

fn combined_text(ref<Generated, shared> gen) : String
{
    String out = prefix(gen);
    String::append(&mut out, HEADER);
    String::append(&mut out, "\n/* ---- types ---- */\n");
    String::append(&mut out, &gen.fwd);
    String::append(&mut out, &gen.types);
    String::append(&mut out, "\n/* ---- string literals ---- */\n");
    String::append(&mut out, &gen.strings);
    String::append(&mut out, "\n/* ---- functions ---- */\n");
    String::append(&mut out, &gen.protos);
    String::append(&mut out, "\n/* ---- call thunks for fn values ---- */\n");
    String::append(&mut out, &gen.thunks);
    String::append(&mut out, "\n/* ---- type descriptors ---- */\n");
    String::append(&mut out, &gen.descs);
    foreach (u in &gen.units)
    {
        String::append(&mut out, &u.text);
    }
    String::append(&mut out, &gen.tail);
    out
}

// D-0277: the program's C as `k` translation units (cobc's
// `Generated::parts`), compiled at once, each written under its own name
// (`settle_lines`). Every part has the declarations. A function `localize`
// made `static` has external linkage instead, but for the `static inline`
// ones, which every part defines; a static or addressed constant (`g_…`,
// `k_…`) is defined in part 0 and declared in the rest; a thunk is each
// part's own `static` copy, as the descriptors are. The units' definitions
// are dealt out by size, each part keeping their order, and the program's
// tail is part 0's. With `k` 1, the combined text.
export fn split_parts(ref<Generated, shared> gen, usize k) : Vec<String>
{
    Vec<String> out = Vec::new();
    if (k <= 1)
    {
        Vec::push(&mut out, combined_text(gen));
        return out;
    }
    // The units' definitions (cobc's reading): a definition's first line,
    // the lines before it since the last one ended, and its body to the `}`
    // at the start of a line; lines after a unit's last definition go with it.
    Vec<String> defs = Vec::new();
    foreach (u in &gen.units)
    {
        Vec<StringView> lines = StringView::split(&u.text, "\n");
        String pending = String::new();
        bool any_pending = false;
        usize first = Vec::len(&defs);
        usize i = 0;
        while (i < Vec::len(&lines))
        {
            if (starts_definition(&lines, i))
            {
                String d = replace(&mut pending, String::new());
                bool started = any_pending;
                any_pending = false;
                usize j = i;
                while (j < Vec::len(&lines) && lines[j] != "}")
                {
                    if (started)
                    {
                        String::push_ascii(&mut d, b'\n');
                    }
                    String::append(&mut d, lines[j]);
                    started = true;
                    j += 1;
                }
                if (j < Vec::len(&lines))
                {
                    if (started)
                    {
                        String::push_ascii(&mut d, b'\n');
                    }
                    String::append(&mut d, lines[j]);
                }
                Vec::push(&mut defs, d);
                i = j + 1;
            }
            else
            {
                if (any_pending)
                {
                    String::push_ascii(&mut pending, b'\n');
                }
                String::append(&mut pending, lines[i]);
                any_pending = true;
                i += 1;
            }
        }
        if (any_pending)
        {
            if (Vec::len(&defs) > first)
            {
                usize last = Vec::len(&defs) - 1;
                String::push_ascii(&mut defs[last], b'\n');
                String::append(&mut defs[last], &pending);
            }
            else
            {
                Vec::push(&mut defs, pending);
            }
        }
    }
    HashSet<String> inline_names = HashSet::new();
    Vec<String> everywhere = Vec::new();
    Vec<String> spread = Vec::new();
    foreach (d in &defs)
    {
        String h = def_head(d);
        // CHG-0430: a `CB_SMALL` function is an inline one too: in every part.
        if (StringView::starts_with(&h, "static inline") || StringView::starts_with(&h, "CB_SMALL "))
        {
            match (fn_name(&h))
            {
                Some(n) :
                {
                    _ = HashSet::insert(&mut inline_names, String::copy(n));
                },
                None    : {},
            }
            Vec::push(&mut everywhere, sprintf("%s\n", d));
            continue;
        }
        if (StringView::starts_with(&h, "static "))
        {
            String t = String::new();
            Vec<StringView> dl = StringView::split(d, "\n");
            for (usize m = 0; m < Vec::len(&dl); m += 1)
            {
                if (m > 0)
                {
                    String::push_ascii(&mut t, b'\n');
                }
                if (dl[m] == h)
                {
                    String::append(&mut t, &dl[m][7..$]);
                }
                else
                {
                    String::append(&mut t, dl[m]);
                }
            }
            Vec::push(&mut spread, sprintf("%s\n", &t));
        }
        else
        {
            Vec::push(&mut spread, sprintf("%s\n", d));
        }
    }
    // Dealt out largest first to the smallest part (cobc's order: by size
    // down, then by position), then each part in the units' order.
    Vec<usize> order = Vec::new();
    for (usize i = 0; i < Vec::len(&spread); i += 1)
    {
        Vec::push(&mut order, i);
    }
    for (usize i = 1; i < Vec::len(&order); i += 1)
    {
        usize j = i;
        while (j > 0 && part_before(&spread, order[j], order[j - 1]))
        {
            Vec::swap(&mut order, j - 1, j);
            j -= 1;
        }
    }
    Vec<usize> owner = Vec::filled(Vec::len(&spread), 0);
    Vec<usize> sizes = Vec::filled(k, 0);
    foreach (i in &order)
    {
        usize p = 0;
        for (usize q = 1; q < k; q += 1)
        {
            if (sizes[q] < sizes[p])
            {
                p = q;
            }
        }
        owner[*i] = p;
        sizes[p] += StringView::len(&spread[*i]);
    }
    String protos = String::new();
    foreach (l in StringView::lines(&gen.protos))
    {
        bool make_extern = StringView::starts_with(l, "static ") && !StringView::starts_with(l, "static inline")
            && StringView::ends_with(l, ");") && match (fn_name(l))
            {
                Some(n) : !HashSet::contains(&inline_names, &String::copy(n)),
                None    : false,
            };
        if (make_extern)
        {
            String::append(&mut protos, &l[7..$]);
        }
        else
        {
            String::append(&mut protos, l);
        }
        String::push_ascii(&mut protos, b'\n');
    }
    String thunks = String::new();
    Vec<StringView> tl = StringView::split(&gen.thunks, "\n");
    for (usize i = 0; i < Vec::len(&tl); i += 1)
    {
        if (starts_definition(&tl, i) && !StringView::starts_with(tl[i], "static"))
        {
            String::append(&mut thunks, "static ");
        }
        String::append(&mut thunks, tl[i]);
        if (i + 1 < Vec::len(&tl))
        {
            String::push_ascii(&mut thunks, b'\n');
        }
    }
    for (usize p = 0; p < k; p += 1)
    {
        String t = prefix(gen);
        String::append(&mut t, HEADER);
        String::append(&mut t, "\n/* ---- types ---- */\n");
        String::append(&mut t, &gen.fwd);
        String::append(&mut t, &gen.types);
        String::append(&mut t, "\n/* ---- string literals ---- */\n");
        foreach (l in StringView::lines(&gen.strings))
        {
            match (global_decl(l))
            {
                Some(gd) :
                {
                    if (p > 0)
                    {
                        String::appendf(&mut t, "extern %v %v;", gd.ty, gd.name);
                    }
                    else
                    {
                        String::append(&mut t, &l[7..$]);
                    }
                },
                None     : String::append(&mut t, l),
            }
            String::push_ascii(&mut t, b'\n');
        }
        String::append(&mut t, "\n/* ---- functions ---- */\n");
        String::append(&mut t, &protos);
        String::append(&mut t, "\n/* ---- call thunks for fn values ---- */\n");
        String::append(&mut t, &thunks);
        String::append(&mut t, "\n/* ---- type descriptors ---- */\n");
        String::append(&mut t, &gen.descs);
        foreach (e in &everywhere)
        {
            String::append(&mut t, e);
        }
        for (usize i = 0; i < Vec::len(&spread); i += 1)
        {
            if (owner[i] == p)
            {
                String::append(&mut t, &spread[i]);
            }
        }
        if (p == 0)
        {
            String::append(&mut t, &gen.tail);
        }
        Vec::push(&mut out, t);
    }
    out
}

// `split_parts`' order: larger first, then the earlier.
fn part_before(ref<Vec<String>, shared> spread, usize a, usize b) : bool
{
    usize la = StringView::len(&spread[a]);
    usize lb = StringView::len(&spread[b]);
    la > lb || (la == lb && a < b)
}

// A function's signature line (cobc's `starts_signature`): at the start of a
// line, not a directive or a brace, ending in `)`.
fn starts_signature(StringView l) : bool
{
    if (StringView::len(l) == 0 || !StringView::ends_with(l, ")") || !StringView::contains(l, "("))
    {
        return false;
    }
    u8 c = StringView::as_bytes(l)[0];
    c != b' ' && c != b'{' && c != b'}' && c != b'#' && c != b'/'
}

// A definition starts at line `i`: a signature with `{` after it, but for
// `#line` directives.
fn starts_definition(ref<Vec<StringView>, shared> lines, usize i) : bool
{
    if (!starts_signature(lines[i]))
    {
        return false;
    }
    usize j = i + 1;
    while (j < Vec::len(lines) && StringView::starts_with(lines[j], "#line"))
    {
        j += 1;
    }
    j < Vec::len(lines) && lines[j] == "{"
}

// A definition's signature line.
fn def_head(ref<String, shared> d) : String
{
    foreach (l in StringView::lines(d))
    {
        if (starts_signature(l))
        {
            return String::copy(l);
        }
    }
    String::new()
}

// The attributes a function's prototype is written with: `Vec::grow`'s keep it
// out of line (`COLD_PROTO`).
fn proto_attrs(ref<String, shared> name) : str
{
    if (*name == "std::Vec::grow")
    {
        return COLD_PROTO;
    }
    ""
}

// The function a signature or prototype names: the word before its `(`, its
// attributes (`__attribute__((always_inline))`) left out.
fn fn_name(StringView l) : Option<StringView>
{
    StringView rest = l;
    while (true)
    {
        match (StringView::find(rest, "__attribute__(("))
        {
            Some(i) :
            {
                StringView after = &rest[i..$];
                usize end = match (StringView::find(after, "))"))
                {
                    Some(e) : e + 2,
                    None    : StringView::len(after),
                };
                rest = &rest[i + end..$];
            },
            None    : break,
        }
    }
    usize open = StringView::find(rest, "(")?;
    StringView head = StringView::trim_end(&rest[0..open]);
    slice<u8, shared> b = StringView::as_bytes(head);
    usize start = slice_len(b);
    while (start > 0 && (ascii_is_alnum(b[start - 1]) || b[start - 1] == b'_'))
    {
        start -= 1;
    }
    if (start == slice_len(b))
    {
        return None;
    }
    Some(&head[start..slice_len(b)])
}

// A static's or an addressed constant's definition: `static [const ]T
// g_…/k_… = INIT;`, its type and name (cobc's `global_decl`).
struct GlobalDecl
{
    StringView ty;
    StringView name;
}

fn global_decl(StringView l) : Option<GlobalDecl>
{
    StringView rest = StringView::strip_prefix(l, "static ")?;
    usize eq = StringView::find(rest, " = ")?;
    StringView lhs = &rest[0..eq];
    slice<u8, shared> b = StringView::as_bytes(lhs);
    usize sp = slice_len(b);
    while (sp > 0 && b[sp - 1] != b' ')
    {
        sp -= 1;
    }
    if (sp == 0)
    {
        return None;
    }
    StringView name = &lhs[sp..slice_len(b)];
    if (!(StringView::starts_with(name, "g_") || StringView::starts_with(name, "k_")) || !StringView::ends_with(l, ";"))
    {
        return None;
    }
    Some(GlobalDecl { .ty = &lhs[0..sp - 1], .name = name })
}

// The parts, taken out of `g` (cobc's `generate` consumes its `Gen`).
// D-0281 step 4c: whether the program is lowered pathless, or why not
// (`pathless_blocker`, when it was asked); D-0285: lowered decided.
fn parts(ref<Gen, exclusive> g, String descs, String tail, String header_text, StringView fresh) : Generated
{
    // D-0309 (1b): the stack check only where the depth can grow; a frame's
    // notes only where a thread can be spawned.
    if (!boot(g, 1))
    {
        Vec<String> texts = Vec::new();
        foreach (u in &g.units)
        {
            Vec::push(&mut texts, String::clone(&u.text));
        }
        Vec<String> others = Vec::new();
        Vec::push(&mut others, String::clone(&g.thunks_out));
        Vec::push(&mut others, String::clone(&descs));
        Vec::push(&mut others, String::clone(&tail));
        drop_unused_notes(&mut texts, &others);
        prune_stack_checks(&mut texts, &others, &g.types, fresh);
        // CHG-0430: a decided program's small functions inlined.
        if (g.decided)
        {
            Vec<bool> pure = Vec::new();
            foreach (u in &g.units)
            {
                Vec::push(&mut pure, u.pure_std);
            }
            inline_small(&mut texts, &pure, &mut g.protos);
        }
        for (usize k = 0; k < Vec::len(&g.units); k += 1)
        {
            g.units[k].text = String::clone(&texts[k]);
        }
    }
    Option<String> kept = if (g.pathless) { pathless_blocker(g) } else { Some("COBALTC_PATHLESS=0") };
    Vec<GuardNote> notes = replace(&mut g.guard_notes, Vec::new());
    Vec::sort_by(&mut notes, note_less);
    Vec<GuardNote> guard_notes = Vec::new();
    foreach (n in notes)
    {
        usize m = Vec::len(&guard_notes);
        if (m > 0 && guard_notes[m - 1].file == n.file && guard_notes[m - 1].line == n.line && guard_notes[m - 1].text == n.text)
        {
            continue;
        }
        Vec::push(&mut guard_notes, n);
    }
    Generated {
        .guard_notes = guard_notes,
        .fwd = replace(&mut g.fwd, String::new()),
        .types = replace(&mut g.types, String::new()),
        .strings = replace(&mut g.strings, String::new()),
        .protos = replace(&mut g.protos, String::new()),
        .thunks = replace(&mut g.thunks_out, String::new()),
        .descs = descs,
        .units = replace(&mut g.units, Vec::new()),
        .tail = tail,
        .header_text = header_text,
        .decided = g.decided && Option::is_none(&kept),
        .kept = kept,
        .unsupported = None,
    }
}

// cobc's `Err(Unsupported)` from `generate`: a `Generated` carrying only the
// reason (`Gen::unsupported`); its text is nothing.
fn unsupported_parts(ref<Gen, exclusive> g) : Generated
{
    Generated {
        .guard_notes = Vec::new(),
        .fwd = String::new(),
        .types = String::new(),
        .strings = String::new(),
        .protos = String::new(),
        .thunks = String::new(),
        .descs = String::new(),
        .units = Vec::new(),
        .tail = String::new(),
        .header_text = String::new(),
        .decided = false,
        .kept = None,
        .unsupported = clone(&g.unsupported),
    }
}

// What comes before `cbrt.h`: its `CB_PATHLESS` switch, and its
// `CB_QUIET_CELLS` (`quiet_cells`; cobc's `Generated::prefix`).
export fn prefix(ref<Generated, shared> gen) : String
{
    String p = match (&gen.kept)
    {
        None      :
        {
            if (gen.decided)
            {
                "#define CB_PATHLESS 1\n#define CB_DECIDED 1\n"
            }
            else
            {
                "#define CB_PATHLESS 1\n"
            }
        },
        Some(why) :
        {
            if (StringView::len(why) == 0)
            {
                String::new()
            }
            else
            {
                sprintf("/* cobc: kept paths: %s */\n", &StringView::replace(why, "*/", "* /"))
            }
        },
    };
    if (quiet_cells(gen))
    {
        String::append(&mut p, "#define CB_QUIET_CELLS 1\n");
    }
    p
}

// D-0309: whether the program's own C calls none of the runtime's entries
// that can put an object over raw cells (`[Reclaim]`, an element's borrow, a
// resource moved into a buffer) or start a second thread (a spawn, a
// library's entry): `cb_reclaimed_entries` then stays 0 for the whole run,
// and `cbrt.h` does not read it. Under `CB_PATHLESS` an element's borrow is a
// no-op (cobc's `Generated::quiet_cells`).
fn quiet_cells(ref<Generated, shared> gen) : bool
{
    Vec<String> makers = Vec::new();
    Vec::push(&mut makers, "cb_reclaim");
    Vec::push(&mut makers, "cb_raw_move_in");
    Vec::push(&mut makers, "cb_spawn");
    Vec::push(&mut makers, "cb_lib_enter");
    if (Option::is_some(&gen.kept))
    {
        Vec::push(&mut makers, "cb_elem_borrow");
        Vec::push(&mut makers, "cb_elem_borrow_here");
        Vec::push(&mut makers, "cb_elem_borrow_datum");
    }
    Vec<String> texts = Vec::new();
    foreach (u in &gen.units)
    {
        Vec::push(&mut texts, String::clone(&u.text));
    }
    Vec::push(&mut texts, String::clone(&gen.tail));
    Vec::push(&mut texts, String::clone(&gen.thunks));
    Vec<String> scanned = without_box_drops(&texts);
    foreach (s in &scanned)
    {
        String t = without_guarded_reclaims(s);
        foreach (m in &makers)
        {
            if (names_ident(&t, m))
            {
                return false;
            }
        }
    }
    true
}

// A text without the `cb_reclaim` a `Vec` drop's loop makes behind
// `cb_live_at(e)` (`quiet_cells`): it runs only where an entry lies over the
// element already, which some other maker put there, so it makes none of its
// own (cobc's `without_guarded_reclaims`).
fn without_guarded_reclaims(ref<String, shared> t) : String
{
    String out = String::new();
    bool guarded = false;
    foreach (l in StringView::split(t, "\n"))
    {
        StringView s = StringView::trim_start(l);
        if (!(guarded && StringView::starts_with(s, "uint64_t root = cb_reclaim(e, ")))
        {
            String::append(&mut out, l);
            String::push_ascii(&mut out, b'\n');
        }
        guarded = s == "if (cb_live_at(e)) {";
    }
    out
}

// The program's texts without the bodies of `std::Box::drop`'s instances
// (`quiet_cells`): one runs only through its Box's descriptor, which the
// runtime never calls (a Box is `box_drop`'s, `cbrt`), unless the program's
// own C names it -- then the texts as they are (cobc's `without_box_drops`).
fn without_box_drops(ref<Vec<String>, shared> texts) : Vec<String>
{
    Vec<String> names = Vec::new();
    Vec<String> out = Vec::new();
    foreach (t in texts)
    {
        Vec<StringView> lines = StringView::split(t, "\n");
        String kept = String::new();
        usize i = 0;
        while (i < Vec::len(&lines))
        {
            StringView l = lines[i];
            StringView head = match (StringView::strip_prefix(l, "static "))
            {
                Some(h) : h,
                None    : l,
            };
            bool skipped = false;
            if (i + 1 < Vec::len(&lines) && lines[i + 1] == "{" && StringView::ends_with(l, ")"))
            {
                match (StringView::strip_prefix(head, "void f_std__Box__drop_"))
                {
                    Some(rest) :
                    {
                        match (StringView::find(rest, "("))
                        {
                            Some(open) :
                            {
                                usize k = i;
                                while (k < Vec::len(&lines) && lines[k] != "}")
                                {
                                    k += 1;
                                }
                                if (k < Vec::len(&lines))
                                {
                                    Vec::push(&mut names, sprintf("f_std__Box__drop_%s", &rest[0..open]));
                                    i = k + 1;
                                    skipped = true;
                                }
                            },
                            None       : {},
                        }
                    },
                    None       : {},
                }
            }
            if (!skipped)
            {
                String::append(&mut kept, l);
                String::push_ascii(&mut kept, b'\n');
                i += 1;
            }
        }
        Vec::push(&mut out, kept);
    }
    foreach (n in &names)
    {
        foreach (t in &out)
        {
            if (names_ident(t, n))
            {
                return Vec::clone(texts);
            }
        }
    }
    out
}

// A library's entry point: its C name and its declaration.
export struct Entry
{
    export String c;
    export FnDecl f;
}

// D-0257: the entry points (`extern fn` with a body), in the order of the
// program's text, each requested when building a library.
fn request_entries(ref<Gen, exclusive> g, bool lib) : Vec<Entry>
{
    Vec<String> keys = Vec::new();
    Vec<usize> lines = Vec::new();
    for (usize i = 0; i < HashMap::len(&g.prog.table.fns); i += 1)
    {
        ref<FnDecl, shared> f = HashMap::value_at(&g.prog.table.fns, i);
        if (f.c_entry)
        {
            // Sorted by line (stable, as cobc's `sort_by_key`).
            usize at = Vec::len(&keys);
            while (at > 0 && lines[at - 1] > f.line)
            {
                at -= 1;
            }
            Vec::insert(&mut keys, at, String::clone(HashMap::key_at(&g.prog.table.fns, i)));
            Vec::insert(&mut lines, at, f.line);
        }
    }
    Vec<Entry> out = Vec::new();
    if (lib)
    {
        foreach (k in &keys)
        {
            String c = request_fn(g, k, Vec::new());
            FnDecl f = clone(Option::expect(HashMap::get(&g.prog.table.fns, k), "an entry point"));
            Vec::push(&mut out, Entry { .c = c, .f = f });
        }
    }
    out
}

// D-0257: a library's tail, no `main`. `cb_lib_init` is the runtime's start,
// run once by the first entry; each entry point is a stub that enters, calls
// the function, leaves; its `_try` twin contains a fault (`cb_lib_jmp`) and
// gives C a status and the result through a pointer. `cobalt_init`,
// `cobalt_shutdown` and `cobalt_last_fault` are the library's own API. The
// header's text (`header_text`).
fn lib_tail(ref<Gen, exclusive> g, ref<String, exclusive> out, ref<Vec<Entry>, shared> entry_c) : String
{
    String::appendf(
        out,
        "static void cb_lib_init(void)\n{\n    cb_init(cb_files, %v, cb_types, %v, cb_type_ids);\n}\n",
        Vec::len(&g.files),
        Vec::len(&g.descs),
    );
    String::append(out, "void cobalt_init(void)\n{\n    cb_lib_enter(cb_lib_init);\n    cb_lib_leave();\n}\n");
    String::append(out, "void cobalt_shutdown(void)\n{\n    cb_lib_shutdown();\n}\n");
    String::append(out, "int cobalt_last_fault(char *buf, size_t n)\n{\n    return cb_lib_last_fault(buf, n);\n}\n");
    foreach (e in entry_c)
    {
        Vec<String> params = Vec::new();
        Vec<String> args = Vec::new();
        for (usize i = 0; i < Vec::len(&e.f.params); i += 1)
        {
            String pc = ctype(g, &e.f.params[i].ty);
            Vec::push(&mut params, sprintf("%s a%v", &pc, i));
            Vec::push(&mut args, sprintf("a%v", i));
        }
        String plist = if (Vec::len(&params) == 0) { "void" } else
        {
            String::join(
                &params,
                ", ",
            )
        };
        String call = sprintf("%s(%s)", &e.c, &String::join(&args, ", "));
        if (is_void(&e.f.ret))
        {
            String::appendf(
                out,
                "void %s(%s)\n{\n    cb_lib_enter(cb_lib_init);\n    %s;\n    cb_lib_leave();\n}\n",
                &e.f.name,
                &plist,
                &call,
            );
            String::appendf(
                out,
                "int %s_try(%s)\n{\n    cb_lib_enter(cb_lib_init);\n    jmp_buf cb_jb;\n    if (setjmp(cb_jb) == 0) {\n        cb_lib_jmp((void *)cb_jb);\n        %s;\n        cb_lib_jmp(0);\n        cb_lib_leave();\n        return 0;\n    }\n    cb_lib_leave();\n    return cb_lib_fault_code();\n}\n",
                &e.f.name,
                &plist,
                &call,
            );
        }
        else
        {
            String rc = ctype(g, &e.f.ret);
            String::appendf(
                out,
                "%s %s(%s)\n{\n    cb_lib_enter(cb_lib_init);\n    %s cb_r = %s;\n    cb_lib_leave();\n    return cb_r;\n}\n",
                &rc,
                &e.f.name,
                &plist,
                &rc,
                &call,
            );
            Vec<String> tparams = Vec::clone(&params);
            Vec::push(&mut tparams, sprintf("%s *cb_out", &rc));
            String::appendf(
                out,
                "int %s_try(%s)\n{\n    cb_lib_enter(cb_lib_init);\n    jmp_buf cb_jb;\n    if (setjmp(cb_jb) == 0) {\n        cb_lib_jmp((void *)cb_jb);\n        %s cb_r = %s;\n        cb_lib_jmp(0);\n        cb_lib_leave();\n        *cb_out = cb_r;\n        return 0;\n    }\n    cb_lib_leave();\n    return cb_lib_fault_code();\n}\n",
                &e.f.name,
                &String::join(&tparams, ", "),
                &rc,
                &call,
            );
        }
    }
    header_text(g, entry_c)
}

// ---- D-0320: the length guard of a loop nest (cobc's `lower/guards.rs`)
//
// A loop whose variables are kept below bounds known before the program runs
// (a literal, a `const`, a local bound to one that nothing assigns, a
// `foreach` range's end, or an enclosing such variable), and whose body
// indexes slices that the loop never rebinds, is emitted twice: under
// `if (s.len >= N && …)`, N one past the largest index the body can form into
// `s`, and otherwise. Both copies keep every check (`version_loops` copies the
// text as it is, its labels renamed), so the guard cannot change what the
// program does, whatever it says: it only tells the C compiler the lengths.

// A name and the largest value it holds where the scan reads it.
struct GBound
{
    String name;
    u128 hi;
}

// Upper bounds of the integers in a loop nest, as the scan reaches them.
struct GScan
{
    // The innermost binding last.
    Vec<GBound> env;
    // The candidate slices and the count each needs: its largest index, plus one.
    Vec<GBound> need;
    Vec<String> slices;
    // The vectors bound in the nest with a written `simd<T, N>` type, and N.
    Vec<GBound> lanes;
    // CHG-0449: each candidate slice indexed where the index has no bound
    // known, first time only, with the first name in the index that has none
    // (empty when there is no such name).
    Vec<GLoose> loose;
}

struct GLoose
{
    String slice_name;
    String name;
}

fn gs_new(Vec<String> slices) : GScan
{
    GScan { .env = Vec::new(), .need = Vec::new(), .slices = slices, .lanes = Vec::new(), .loose = Vec::new() }
}

// CHG-0449: an index into the candidate slice `s` with no known bound.
fn gs_note_loose(ref<Gen, exclusive> g, ref<GScan, exclusive> sc, ref<HashMap<String, u128>, shared> ends, ref<String, shared> s, ref<Expr, shared> idx)
{
    foreach (l in &sc.loose)
    {
        if (l.slice_name == *s)
        {
            return;
        }
    }
    String name = Option::unwrap_or(gs_unbounded(g, &*sc, ends, idx), String::new());
    Vec::push(&mut sc.loose, GLoose { .slice_name = String::clone(s), .name = name });
}

// The first name in `e` (left to right) with no known bound: not a variable
// the scan bounds, nor a constant.
fn gs_unbounded(ref<Gen, exclusive> g, ref<GScan, shared> sc, ref<HashMap<String, u128>, shared> ends, ref<Expr, shared> e) : Option<String>
{
    match (&e.kind)
    {
        ExprKind::EPath(p)   :
        {
            ref<PathExpr, shared> pe = Box::get(p);
            if (Vec::len(&pe.segs) == 1)
            {
                if (Option::is_none(&gs_lookup(sc, ends, &pe.segs[0])) && Option::is_none(&gs_konst(g, &pe.segs[0], 0)))
                {
                    return Some(String::clone(&pe.segs[0]));
                }
            }
            None
        },
        ExprKind::EParen(x)  : gs_unbounded(g, sc, ends, Box::get(x)),
        ExprKind::EUnary(u)  : gs_unbounded(g, sc, ends, &Box::get(u).e),
        ExprKind::EBinary(b) :
        {
            match (gs_unbounded(g, sc, ends, &Box::get(b).a))
            {
                Some(n) : Some(n),
                None    : gs_unbounded(g, sc, ends, &Box::get(b).b),
            }
        },
        ExprKind::EIndex(ix) :
        {
            match (gs_unbounded(g, sc, ends, &Box::get(ix).a))
            {
                Some(n) : Some(n),
                None    : gs_unbounded(g, sc, ends, &Box::get(ix).b),
            }
        },
        ExprKind::ECall(cl)  :
        {
            foreach (a in &Box::get(cl).args)
            {
                match (gs_unbounded(g, sc, ends, a))
                {
                    Some(n) : return Some(n),
                    None    : {},
                }
            }
            None
        },
        _                    : None,
    }
}

fn gs_has_slice(ref<GScan, shared> sc, ref<String, shared> s) : bool
{
    foreach (n in &sc.slices)
    {
        if (*n == *s)
        {
            return true;
        }
    }
    false
}

fn gs_lookup(ref<GScan, shared> sc, ref<HashMap<String, u128>, shared> ends, ref<String, shared> n) : Option<u128>
{
    usize k = Vec::len(&sc.env);
    while (k > 0)
    {
        k -= 1;
        if (sc.env[k].name == *n)
        {
            return Some(sc.env[k].hi);
        }
    }
    match (HashMap::get(ends, n))
    {
        Some(v) : Some(*v),
        None    : None,
    }
}

// A `const` item's value: an integer of no parameters whose value is a
// constant expression.
fn gs_konst(ref<Gen, exclusive> g, ref<String, shared> name, usize depth) : Option<u128>
{
    if (depth > 8)
    {
        return None;
    }
    match (fn_in_prelude(g, name))
    {
        Some(_) : {},
        None    : return None,
    }
    Option<Expr> tail = match (HashMap::get(&g.prog.table.fns, name))
    {
        Some(f) :
        {
            if (!f.is_const || Vec::len(&f.params) > 0 || Vec::len(&f.type_params) > 0 || Vec::len(&f.body.stmts) > 0)
            {
                return None;
            }
            match (&f.ret)
            {
                Type::TInt(_) : {},
                _             : return None,
            }
            match (&f.body.tail)
            {
                Some(t) : Some(clone(Box::get(t))),
                None    : None,
            }
        },
        None    : None,
    };
    match (&tail)
    {
        Some(t) : gs_exact(g, t, depth + 1),
        None    : None,
    }
}

// The value of a constant expression, when it is one.
fn gs_exact(ref<Gen, exclusive> g, ref<Expr, shared> e, usize depth) : Option<u128>
{
    match (&e.kind)
    {
        ExprKind::EInt(il)    : Some(Box::get(il).v),
        ExprKind::EParen(a)   : gs_exact(g, Box::get(a), depth),
        ExprKind::ECall(cl)   :
        {
            if (Vec::len(&Box::get(cl).args) > 0)
            {
                return None;
            }
            match (&Box::get(cl).callee.kind)
            {
                ExprKind::EPath(p) :
                {
                    if (Vec::len(&Box::get(p).targs) > 0)
                    {
                        return None;
                    }
                    String name = String::join(&Box::get(p).segs, "::");
                    gs_konst(g, &name, depth)
                },
                _                  : None,
            }
        },
        ExprKind::EBinary(bx) :
        {
            u128 x = match (gs_exact(g, &Box::get(bx).a, depth))
            {
                Some(v) : v,
                None    : return None,
            };
            u128 y = match (gs_exact(g, &Box::get(bx).b, depth))
            {
                Some(v) : v,
                None    : return None,
            };
            match (Box::get(bx).op)
            {
                BinOp::Add : checked_add(x, y),
                BinOp::Sub : checked_sub(x, y),
                BinOp::Mul : checked_mul(x, y),
                BinOp::Div : if (y == 0) { None } else { Some(x / y) },
                BinOp::Rem : if (y == 0) { None } else { Some(x % y) },
                _          : None,
            }
        },
        _                     : None,
    }
}

// The largest value `e` can have where the scan reads it, an index's
// arithmetic being unsigned (every operand of an index is a `usize`).
fn gs_upper(ref<Gen, exclusive> g, ref<GScan, shared> sc, ref<HashMap<String, u128>, shared> ends, ref<Expr, shared> e, usize depth) : Option<u128>
{
    if (depth > 16)
    {
        return None;
    }
    match (gs_exact(g, e, depth))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (&e.kind)
    {
        ExprKind::EParen(a)   : gs_upper(g, sc, ends, Box::get(a), depth + 1),
        ExprKind::EPath(p)    :
        {
            if (Vec::len(&Box::get(p).segs) == 1)
            {
                gs_lookup(sc, ends, &Box::get(p).segs[0])
            }
            else
            {
                None
            }
        },
        ExprKind::ECall(cl)   :
        {
            if (Vec::len(&Box::get(cl).args) != 1)
            {
                return None;
            }
            match (&Box::get(cl).callee.kind)
            {
                ExprKind::EPath(p) :
                {
                    if (Vec::len(&Box::get(p).segs) == 1 && Box::get(p).segs[0] == "widen")
                    {
                        gs_upper(g, sc, ends, &Box::get(cl).args[0], depth + 1)
                    }
                    else
                    {
                        None
                    }
                },
                _                  : None,
            }
        },
        ExprKind::EBinary(bx) :
        {
            ref<BinaryExpr, shared> b = Box::get(bx);
            match (b.op)
            {
                BinOp::Add    :
                {
                    u128 x = match (gs_upper(g, sc, ends, &b.a, depth + 1)) { Some(v) : v, None : return None };
                    u128 y = match (gs_upper(g, sc, ends, &b.b, depth + 1)) { Some(v) : v, None : return None };
                    checked_add(x, y)
                },
                BinOp::Mul    :
                {
                    u128 x = match (gs_upper(g, sc, ends, &b.a, depth + 1)) { Some(v) : v, None : return None };
                    u128 y = match (gs_upper(g, sc, ends, &b.b, depth + 1)) { Some(v) : v, None : return None };
                    checked_mul(x, y)
                },
                // A subtraction that would go below zero faults instead.
                BinOp::Sub    :
                {
                    u128 x = match (gs_upper(g, sc, ends, &b.a, depth + 1)) { Some(v) : v, None : return None };
                    u128 k = match (gs_exact(g, &b.b, depth)) { Some(v) : v, None : 0 };
                    Some(if (x >= k) { x - k } else { 0 })
                },
                BinOp::Div    :
                {
                    u128 d = match (gs_exact(g, &b.b, depth)) { Some(v) : v, None : return None };
                    if (d == 0)
                    {
                        return None;
                    }
                    u128 x = match (gs_upper(g, sc, ends, &b.a, depth + 1)) { Some(v) : v, None : return None };
                    Some(x / d)
                },
                BinOp::Rem    :
                {
                    u128 d = match (gs_exact(g, &b.b, depth)) { Some(v) : v, None : return None };
                    if (d == 0)
                    {
                        return None;
                    }
                    match (gs_upper(g, sc, ends, &b.a, depth + 1))
                    {
                        Some(u) : Some(if (u < d - 1) { u } else { d - 1 }),
                        None    : Some(d - 1),
                    }
                },
                BinOp::BitAnd :
                {
                    Option<u128> x = gs_upper(g, sc, ends, &b.a, depth + 1);
                    Option<u128> y = gs_upper(g, sc, ends, &b.b, depth + 1);
                    match (x)
                    {
                        Some(xv) :
                        {
                            match (y)
                            {
                                Some(yv) : Some(if (xv < yv) { xv } else { yv }),
                                None     : Some(xv),
                            }
                        },
                        None     : y,
                    }
                },
                BinOp::Shr    :
                {
                    u128 x = match (gs_upper(g, sc, ends, &b.a, depth + 1)) { Some(v) : v, None : return None };
                    u128 s = match (gs_exact(g, &b.b, depth)) { Some(v) : v, None : return None };
                    if (s >= 128)
                    {
                        return None;
                    }
                    Some(x >> narrow<u32>(s))
                },
                _             : None,
            }
        },
        _                     : None,
    }
}

fn gs_record(ref<GScan, exclusive> sc, ref<String, shared> s, u128 n)
{
    foreach (r in &mut sc.need)
    {
        if (r.name == *s)
        {
            if (n > r.hi)
            {
                r.hi = n;
            }
            return;
        }
    }
    Vec::push(&mut sc.need, GBound { .name = String::clone(s), .hi = n });
}

// What a nest may bind with an upper bound: a name the rest of it never
// writes, borrows or declares a second time (`NameScan`).
fn gs_steady(ref<String, shared> name, ref<Vec<Stmt>, shared> stmts, usize from, ref<Option<Box<Expr>>, shared> tail) : bool
{
    NameScan s = name_scan(name);
    ns_block(&mut s, stmts, from, tail);
    s.writes == 0 && !s.borrows && !s.declares
}

// The bound a loop's test keeps its variable under, in its body.
fn gs_test_bound(ref<Gen, exclusive> g, ref<GScan, shared> sc, ref<HashMap<String, u128>, shared> ends, ref<Expr, shared> c) : Option<GBound>
{
    ref<Expr, shared> c2 = strip_parens(c);
    ref<BinaryExpr, shared> b = match (&c2.kind)
    {
        ExprKind::EBinary(bx) : Box::get(bx),
        _                     : return None,
    };
    bool incl = false;
    ref<Expr, shared> xe = &b.a;
    ref<Expr, shared> be = &b.b;
    match (b.op)
    {
        BinOp::And : return gs_test_bound(g, sc, ends, &b.a),
        BinOp::Lt  : {},
        BinOp::Le  :
        {
            incl = true;
        },
        BinOp::Gt  :
        {
            xe = &b.b;
            be = &b.a;
        },
        BinOp::Ge  :
        {
            xe = &b.b;
            be = &b.a;
            incl = true;
        },
        _          : return None,
    }
    // `x + k < b`: `x < b - k`.
    u128 k = 0;
    ref<Expr, shared> xs = strip_parens(xe);
    match (&xs.kind)
    {
        ExprKind::EBinary(ax) :
        {
            if (Box::get(ax).op == BinOp::Add)
            {
                match (gs_exact(g, &Box::get(ax).b, 0))
                {
                    Some(k2) :
                    {
                        k = k2;
                        xs = strip_parens(&Box::get(ax).a);
                    },
                    None     : {},
                }
            }
        },
        _                     : {},
    }
    String name = match (&xs.kind)
    {
        ExprKind::EPath(p) :
        {
            if (Vec::len(&Box::get(p).segs) != 1)
            {
                return None;
            }
            String::clone(&Box::get(p).segs[0])
        },
        _                  : return None,
    };
    u128 hi = match (gs_upper(g, sc, ends, be, 0))
    {
        Some(v) : v,
        None    : return None,
    };
    if (hi < k)
    {
        return None;
    }
    hi = hi - k;
    if (!incl)
    {
        if (hi == 0)
        {
            return None;
        }
        hi = hi - 1;
    }
    Some(GBound { .name = name, .hi = hi })
}

// A loop of the nest: its variable bounded in its body when its test keeps
// it there and nothing but the step writes it.
fn gs_while(ref<Gen, exclusive> g, ref<GScan, exclusive> sc, ref<HashMap<String, u128>, shared> ends, ref<Expr, shared> c, ref<Block, shared> b)
{
    usize at = Vec::len(&sc.env);
    match (gs_test_bound(g, sc, ends, c))
    {
        Some(xb) :
        {
            if (gs_steady(&xb.name, &b.stmts, 0, &b.tail))
            {
                Vec::push(&mut sc.env, xb);
            }
        },
        None     : {},
    }
    gs_block(g, sc, ends, &b.stmts, &b.tail);
    Vec::truncate(&mut sc.env, at);
}

fn gs_block(ref<Gen, exclusive> g, ref<GScan, exclusive> sc, ref<HashMap<String, u128>, shared> ends, ref<Vec<Stmt>, shared> stmts, ref<Option<Box<Expr>>, shared> tail)
{
    usize at = Vec::len(&sc.env);
    for (usize i = 0; i < Vec::len(stmts); i += 1)
    {
        match (&stmts[i])
        {
            Stmt::SLet(lb)         :
            {
                ref<LetStmt, shared> l = Box::get(lb);
                match (&l.init)
                {
                    Some(e) :
                    {
                        gs_expr(g, sc, ends, e);
                        match (&l.ty)
                        {
                            Some(t) :
                            {
                                match (t)
                                {
                                    Type::TSimd(sv) : Vec::push(&mut sc.lanes, GBound { .name = String::clone(&l.name), .hi = Box::get(sv).n }),
                                    _               : {},
                                }
                            },
                            None    : {},
                        }
                        // Bound for the rest of the block when the rest never
                        // writes, borrows or declares it again.
                        match (gs_upper(g, sc, ends, e, 0))
                        {
                            Some(u) :
                            {
                                if (gs_steady(&l.name, stmts, i + 1, tail))
                                {
                                    Vec::push(&mut sc.env, GBound { .name = String::clone(&l.name), .hi = u });
                                }
                            },
                            None    : {},
                        }
                    },
                    None    : {},
                }
            },
            Stmt::SDestructure(ds) : gs_expr(g, sc, ends, &Box::get(ds).init),
            Stmt::SExpr(e)         : gs_expr(g, sc, ends, Box::get(e)),
            Stmt::SBlockLike(e)    : gs_expr(g, sc, ends, Box::get(e)),
        }
    }
    match (tail)
    {
        Some(t) : gs_expr(g, sc, ends, Box::get(t)),
        None    : {},
    }
    Vec::truncate(&mut sc.env, at);
}

// The slice a `simd_` call's first argument names, when it is a candidate.
fn gs_slice_arg(ref<GScan, shared> sc, ref<Expr, shared> a) : Option<String>
{
    match (&strip_parens(a).kind)
    {
        ExprKind::EPath(p) :
        {
            if (Vec::len(&Box::get(p).segs) == 1 && gs_has_slice(sc, &Box::get(p).segs[0]))
            {
                Some(String::clone(&Box::get(p).segs[0]))
            }
            else
            {
                None
            }
        },
        _                  : None,
    }
}

// The lanes of a `simd_load<simd<T, N>>` callee's written type: N.
fn gs_load_lanes(ref<Expr, shared> callee) : Option<u128>
{
    match (&callee.kind)
    {
        ExprKind::EPath(p) :
        {
            if (Vec::len(&Box::get(p).segs) != 1 || Box::get(p).segs[0] != "simd_load" || Vec::len(&Box::get(p).targs) == 0)
            {
                return None;
            }
            match (&Box::get(p).targs[0])
            {
                Type::TSimd(sv) : Some(Box::get(sv).n),
                _               : None,
            }
        },
        _                  : None,
    }
}

fn gs_expr(ref<Gen, exclusive> g, ref<GScan, exclusive> sc, ref<HashMap<String, u128>, shared> ends, ref<Expr, shared> e)
{
    match (&e.kind)
    {
        ExprKind::EIndex(p)      :
        {
            match (&strip_parens(&Box::get(p).a).kind)
            {
                ExprKind::EPath(bp) :
                {
                    if (Vec::len(&Box::get(bp).segs) == 1 && gs_has_slice(sc, &Box::get(bp).segs[0]))
                    {
                        match (gs_upper(g, sc, ends, &Box::get(p).b, 0))
                        {
                            Some(u) :
                            {
                                match (checked_add(u, 1: u128))
                                {
                                    Some(n) : gs_record(sc, &Box::get(bp).segs[0], n),
                                    None    : gs_note_loose(g, sc, ends, &Box::get(bp).segs[0], &Box::get(p).b),
                                }
                            },
                            None    : gs_note_loose(g, sc, ends, &Box::get(bp).segs[0], &Box::get(p).b),
                        }
                    }
                },
                _                   : {},
            }
            gs_expr(g, sc, ends, &Box::get(p).a);
            gs_expr(g, sc, ends, &Box::get(p).b);
        },
        // `simd_load<simd<T, N>>(s, i)` reads `s[i .. i + N]`; `simd_store(s,
        // i, x)` writes them, N the lanes of `x` (a vector whose type the nest
        // writes, or a load).
        ExprKind::ECall(cl)      :
        {
            ref<CallExpr, shared> call = Box::get(cl);
            match (&call.callee.kind)
            {
                ExprKind::EPath(p) :
                {
                    if (Vec::len(&Box::get(p).segs) == 1 && Box::get(p).segs[0] == "simd_store" && Vec::len(&call.args) == 3)
                    {
                        Option<u128> n = match (&strip_parens(&call.args[2]).kind)
                        {
                            ExprKind::EPath(xp) :
                            {
                                Option<u128> found = None;
                                if (Vec::len(&Box::get(xp).segs) == 1)
                                {
                                    usize k = Vec::len(&sc.lanes);
                                    while (k > 0)
                                    {
                                        k -= 1;
                                        if (sc.lanes[k].name == Box::get(xp).segs[0])
                                        {
                                            found = Some(sc.lanes[k].hi);
                                            break;
                                        }
                                    }
                                }
                                found
                            },
                            ExprKind::ECall(lc) : gs_load_lanes(&Box::get(lc).callee),
                            _                   : None,
                        };
                        match (n)
                        {
                            Some(nv) :
                            {
                                match (gs_slice_arg(sc, &call.args[0]))
                                {
                                    Some(s) :
                                    {
                                        match (gs_upper(g, sc, ends, &call.args[1], 0))
                                        {
                                            Some(u) :
                                            {
                                                match (checked_add(u, nv))
                                                {
                                                    Some(t) : gs_record(sc, &s, t),
                                                    None    : gs_note_loose(g, sc, ends, &s, &call.args[1]),
                                                }
                                            },
                                            None    : gs_note_loose(g, sc, ends, &s, &call.args[1]),
                                        }
                                    },
                                    None    : {},
                                }
                            },
                            None     : {},
                        }
                    }
                    if (Vec::len(&Box::get(p).segs) == 1 && Box::get(p).segs[0] == "simd_load" && Vec::len(&call.args) == 2)
                    {
                        match (gs_load_lanes(&call.callee))
                        {
                            Some(nv) :
                            {
                                match (gs_slice_arg(sc, &call.args[0]))
                                {
                                    Some(s) :
                                    {
                                        match (gs_upper(g, sc, ends, &call.args[1], 0))
                                        {
                                            Some(u) :
                                            {
                                                match (checked_add(u, nv))
                                                {
                                                    Some(t) : gs_record(sc, &s, t),
                                                    None    : gs_note_loose(g, sc, ends, &s, &call.args[1]),
                                                }
                                            },
                                            None    : gs_note_loose(g, sc, ends, &s, &call.args[1]),
                                        }
                                    },
                                    None    : {},
                                }
                            },
                            None     : {},
                        }
                    }
                },
                _                  : {},
            }
            gs_expr(g, sc, ends, &call.callee);
            foreach (a in &call.args)
            {
                gs_expr(g, sc, ends, a);
            }
        },
        ExprKind::EWhile(w)      : gs_while(g, sc, ends, &Box::get(w).cond, &Box::get(w).body),
        ExprKind::EBlock(bl)     : gs_block(g, sc, ends, &bl.stmts, &bl.tail),
        ExprKind::EUnsafe(bl)    : gs_block(g, sc, ends, &bl.stmts, &bl.tail),
        ExprKind::EIf(i)         :
        {
            gs_expr(g, sc, ends, &Box::get(i).cond);
            gs_block(g, sc, ends, &Box::get(i).then_.stmts, &Box::get(i).then_.tail);
            match (&Box::get(i).else_)
            {
                Some(f) : gs_expr(g, sc, ends, f),
                None    : {},
            }
        },
        ExprKind::EMatch(m)      :
        {
            gs_expr(g, sc, ends, &Box::get(m).scrut);
            foreach (a in &Box::get(m).arms)
            {
                gs_expr(g, sc, ends, Box::get(&a.body));
            }
        },
        ExprKind::EUnary(u)      : gs_expr(g, sc, ends, &Box::get(u).e),
        ExprKind::EDeref(a)      : gs_expr(g, sc, ends, Box::get(a)),
        ExprKind::EField(f)      : gs_expr(g, sc, ends, &Box::get(f).e),
        ExprKind::EPropagate(a)  : gs_expr(g, sc, ends, Box::get(a)),
        ExprKind::EParen(a)      : gs_expr(g, sc, ends, Box::get(a)),
        ExprKind::EBorrow(bb)    : gs_expr(g, sc, ends, &Box::get(bb).e),
        ExprKind::EBinary(bx)    :
        {
            gs_expr(g, sc, ends, &Box::get(bx).a);
            gs_expr(g, sc, ends, &Box::get(bx).b);
        },
        ExprKind::EAssign(p)     :
        {
            gs_expr(g, sc, ends, &Box::get(p).a);
            gs_expr(g, sc, ends, &Box::get(p).b);
        },
        ExprKind::ESliceOf(sl)   :
        {
            gs_expr(g, sc, ends, &Box::get(sl).base);
            gs_expr(g, sc, ends, &Box::get(sl).lo);
            gs_expr(g, sc, ends, &Box::get(sl).hi);
        },
        ExprKind::EStructLit(sl) :
        {
            foreach (fi in &Box::get(sl).fields)
            {
                gs_expr(g, sc, ends, &fi.value);
            }
        },
        ExprKind::EArrayLit(es)  :
        {
            foreach (a in es)
            {
                gs_expr(g, sc, ends, a);
            }
        },
        ExprKind::EReturn(v)     :
        {
            match (v)
            {
                Some(r) : gs_expr(g, sc, ends, Box::get(r)),
                None    : {},
            }
        },
        // A closure's body runs when it is called: not scanned.
        _                        : {},
    }
}

// The value a local is bound to, when it is a constant expression: for a
// `foreach` range's hidden end (`$hN`, the parser's `foreach_range`), the `hi`
// of `$each_range($v, hi, n)`, which gives `hi`.
export fn known_value(ref<Gen, exclusive> g, ref<String, shared> name, ref<Expr, shared> e) : Option<u128>
{
    bool range_end = StringView::len(name) > 2 && StringView::starts_with(name, "$h");
    if (range_end)
    {
        slice<u8, shared> bs = StringView::as_bytes(name);
        for (usize i = 2; i < slice_len(bs); i += 1)
        {
            if (bs[i] < 48 || bs[i] > 57)
            {
                range_end = false;
            }
        }
    }
    if (range_end)
    {
        match (&e.kind)
        {
            ExprKind::ECall(cl) :
            {
                if (Vec::len(&Box::get(cl).args) == 3)
                {
                    match (&Box::get(cl).callee.kind)
                    {
                        ExprKind::EPath(p) :
                        {
                            if (Vec::len(&Box::get(p).segs) == 1 && Box::get(p).segs[0] == "$each_range")
                            {
                                return gs_exact(g, &Box::get(cl).args[1], 0);
                            }
                        },
                        _                  : {},
                    }
                }
            },
            _                   : {},
        }
    }
    gs_exact(g, e, 0)
}

// D-0320: the guard of the loop `while (c) b` (with its step): one test
// `(S).len >= N` for each slice in scope that the loop never writes, borrows
// or declares again and whose largest index in it is known (`GScan`), joined
// with `&&`; None when there is none.
export fn loop_guard(ref<Gen, exclusive> g, ref<Fx, shared> x, ref<Expr, shared> c, ref<Block, shared> b, ref<Option<Expr>, shared> step) : Option<String>
{
    HashSet<String> seen = HashSet::new();
    Vec<String> slices = Vec::new();
    usize k = Vec::len(&x.scopes);
    while (k > 0)
    {
        k -= 1;
        foreach (n, bnd in &x.scopes[k])
        {
            if (HashSet::insert(&mut seen, String::clone(n)))
            {
                match (&bnd.ty)
                {
                    Type::TSlice(_) :
                    {
                        NameScan s = name_scan(n);
                        ns_expr(&mut s, c);
                        ns_block(&mut s, &b.stmts, 0, &b.tail);
                        match (step)
                        {
                            Some(st) : ns_expr(&mut s, st),
                            None     : {},
                        }
                        if (s.writes == 0 && !s.borrows && !s.declares)
                        {
                            Vec::push(&mut slices, String::clone(n));
                        }
                    },
                    _               : {},
                }
            }
        }
    }
    if (Vec::len(&slices) == 0)
    {
        return None;
    }
    GScan sc = gs_new(slices);
    gs_while(g, &mut sc, &x.const_locals, c, b);
    Vec<String> tests = Vec::new();
    Vec<String> shown = Vec::new();
    foreach (r in &sc.need)
    {
        if (r.hi > widen<u128>(max_value<u64>()))
        {
            continue;
        }
        match (lookup(x, &r.name))
        {
            Some(bnd) :
            {
                Vec::push(&mut tests, sprintf("(%s).len >= %vu", &bnd.c, r.hi));
                Vec::push(&mut shown, sprintf("slice_len(%s) >= %v", &r.name, r.hi));
            },
            None      : {},
        }
    }
    // CHG-0449: what `--report-guards` says of the loop; the caller adds
    // whether the guard is used.
    if (g.report_guards)
    {
        String note = String::new();
        if (Vec::len(&shown) > 0)
        {
            String::appendf(&mut note, "  guard: %s\n", &String::join(&shown, " && "));
        }
        foreach (l in &sc.loose)
        {
            if (StringView::len(&l.name) == 0)
            {
                String::appendf(&mut note, "  no bound for an index of `%s`: its checks stay\n", &l.slice_name);
            }
            else
            {
                String::appendf(
                    &mut note,
                    "  no bound for an index of `%s`: `%s` is not kept below a value known before the run, so its checks stay\n",
                    &l.slice_name,
                    &l.name,
                );
            }
        }
        g.pending_note = Some(note);
    }
    if (Vec::len(&tests) == 0)
    {
        return None;
    }
    Some(String::join(&tests, " && "))
}
