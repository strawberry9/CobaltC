import cnames;
import direct;
import natives;
import gen;

export fn lower_confined_call(
    ref<Gen, exclusive> g,
    ref<Fx, exclusive> x,
    StringView name,
    ref<FnDecl, shared> f,
    ref<Vec<Expr>, shared> args,
    usize line,
) : Option<V>
{
    None
}

