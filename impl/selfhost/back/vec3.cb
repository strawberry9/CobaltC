// cobc's vec_calls.rs call shortcuts (`lower_confined_call`,
// `lower_confining_call`, `lower_push_checked_once`, `lower_push_place_once`,
// `lower_vec_checked_once`, `lower_dual_bare_call`, `lower_vec_len_pre`),
// written in CobaltC (D-0274 stage 3): to be ported. Each returns `None`
// where the call is not its shape.

import std;
import ast;
import state;
import layout;
