// `foreach` (D-0042, spec/14 `rule.control.foreach`), expanded: the parser
// writes a `foreach` as a counted loop over hidden bindings calling the
// `$each_*` intrinsics; once the type of the first argument is known, each
// call becomes ordinary code over `std`'s own functions and fields.

import std;
import ast;

export fn is_each_name(StringView n) : bool
{
    foreach (x in [
        "$each_drain",
        "$each_len",
        "$each_at",
        "$each_at_mut",
        "$each_key",
        "$each_take",
        "$each_take_key",
        "$each_range",
        "$each_slot",
        "$each_place",
    ])
    {
        if (n == x)
        {
            return true;
        }
    }
    false
}

enum Coll
{
    CVec,
    CArray,
    CSet,
    CMap,
    CDrain,
    CSetDrain,
    CMapDrain,
    CSlice,
    CParts,
}

struct CollOf
{
    Coll c;
    u128 n;
    Mode mode;
}

fn coll(ref<Type, shared> t) : Option<CollOf>
{
    match (t)
    {
        Type::TArray(ab) : Some(CollOf { .c = Coll::CArray, .n = Box::get(ab).n, .mode = Mode::Shared }),
        Type::TSlice(sb) : Some(CollOf { .c = Coll::CSlice, .n = 0, .mode = Box::get(sb).mode }),
        Type::TNamed(nb) :
        {
            StringView n = &Box::get(nb).name;
            Coll c = match (n)
            {
                "std::Vec"       : Coll::CVec,
                "std::HashSet"   : Coll::CSet,
                "std::HashMap"   : Coll::CMap,
                "std::Drain"     : Coll::CDrain,
                "std::SetDrain"  : Coll::CSetDrain,
                "std::HashDrain" : Coll::CMapDrain,
                "std::Parts"     : Coll::CParts,
                _                : return None,
            };
            Some(CollOf { .c = c, .n = 0, .mode = Mode::Shared })
        },
        _                : None,
    }
}

// Whether a literal expression has a floating-point literal in it.
export fn has_float(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EFloat(_)   : true,
        ExprKind::EParen(x)   : has_float(Box::get(x)),
        ExprKind::EUnary(u)   : has_float(&Box::get(u).e),
        ExprKind::EBinary(bb) : has_float(&Box::get(bb).a) || has_float(&Box::get(bb).b),
        _                     : false,
    }
}

// Whether a literal expression is a negation at its top.
fn negated(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EUnary(u) : Box::get(u).op == UnOp::Neg,
        ExprKind::EParen(x) : negated(Box::get(x)),
        _                   : false,
    }
}

fn int_arg(ref<Vec<Expr>, shared> args, usize k) : Option<u128>
{
    if (k >= Vec::len(args))
    {
        return None;
    }
    match (&args[k].kind)
    {
        ExprKind::EInt(lb) : Some(Box::get(lb).v),
        _                  : None,
    }
}

fn detail(String m) : Result<Expr, String>
{
    Err(sprintf("diag.type-mismatch\u{1}%s", &m))
}

fn bad() : Result<Expr, String>
{
    Err("diag.type-mismatch")
}

struct Mk
{
    usize line;
    usize col;
}

fn at(ref<Mk, shared> m, ExprKind k) : Expr
{
    mk(k, m.line, m.col)
}

fn path_of(ref<Mk, shared> m, str key) : Expr
{
    Vec<StringView> parts = StringView::split(key, "::");
    Vec<String> segs = Vec::new();
    for (usize i = 0; i < Vec::len(&parts); i += 1)
    {
        Vec::push(&mut segs, String::copy(parts[i]));
    }
    at(m, ExprKind::EPath(Box::new(PathExpr { .segs = segs, .targs = Vec::new() })))
}

fn call1(ref<Mk, shared> m, str key, Expr a) : Expr
{
    Vec<Expr> args = Vec::new();
    Vec::push(&mut args, a);
    at(m, ExprKind::ECall(Box::new(CallExpr { .callee = path_of(m, key), .args = args })))
}

fn call2(ref<Mk, shared> m, str key, Expr a, Expr c) : Expr
{
    Vec<Expr> args = Vec::new();
    Vec::push(&mut args, a);
    Vec::push(&mut args, c);
    at(m, ExprKind::ECall(Box::new(CallExpr { .callee = path_of(m, key), .args = args })))
}

fn shared(ref<Mk, shared> m, Expr e) : Expr
{
    at(m, ExprKind::EBorrow(Box::new(BorrowExpr { .mode = Mode::Shared, .e = e })))
}

fn excl(ref<Mk, shared> m, Expr e) : Expr
{
    at(m, ExprKind::EBorrow(Box::new(BorrowExpr { .mode = Mode::Exclusive, .e = e })))
}

fn deref(ref<Mk, shared> m, Expr e) : Expr
{
    at(m, ExprKind::EDeref(Box::new(e)))
}

fn field(ref<Mk, shared> m, Expr e, str f) : Expr
{
    at(m, ExprKind::EField(Box::new(FieldExpr { .e = e, .name = String::copy(f) })))
}

fn index(ref<Mk, shared> m, Expr a, Expr i) : Expr
{
    at(m, ExprKind::EIndex(Box::new(PairExpr { .a = a, .b = i })))
}

// A map's entry at the position `a1` (the hidden `$iN`), as a reference:
// the hidden `$pN` the loop borrowed it into (`$each_slot`) where it has
// one (`slot`: a loop over `&mut m`, or over an `m` written without `&`),
// else (a loop over `&m`, whose key and value are both shared) a shared
// borrow of it.
fn map_entry(ref<Mk, shared> m, bool slot, Expr a0, Expr a1) : Expr
{
    if (slot)
    {
        match (&a1.kind)
        {
            ExprKind::EPath(pb) :
            {
                ref<PathExpr, shared> pe = Box::get(pb);
                if (Vec::len(&pe.segs) == 1 && StringView::starts_with(&pe.segs[0], "$i"))
                {
                    Vec<String> segs = Vec::new();
                    Vec::push(&mut segs, sprintf("$p%v", &pe.segs[0][2..$]));
                    return at(m, ExprKind::EPath(Box::new(PathExpr { .segs = segs, .targs = Vec::new() })));
                }
            },
            _                   : {},
        }
    }
    call2(m, "std::Vec::index_shared", shared(m, field(m, deref(m, a0), "entries")), place_of(m, a1))
}

// The place in a map's `entries` of the entry at the position `a1` (the
// hidden `$iN`): the hidden `$qN` the loop set from it (`$each_place`,
// bug 045: `remove` leaves holes, which the position skips), a number,
// so the entry is indexed as by the position itself.
fn place_of(ref<Mk, shared> m, Expr a1) : Expr
{
    match (&a1.kind)
    {
        ExprKind::EPath(pb) :
        {
            ref<PathExpr, shared> pe = Box::get(pb);
            if (Vec::len(&pe.segs) == 1 && StringView::starts_with(&pe.segs[0], "$i"))
            {
                Vec<String> segs = Vec::new();
                Vec::push(&mut segs, sprintf("$q%v", &pe.segs[0][2..$]));
                return at(m, ExprKind::EPath(Box::new(PathExpr { .segs = segs, .targs = Vec::new() })));
            }
        },
        _                   : {},
    }
    a1
}

// `name`'s expansion, given the type of `args[0]`; an `Err` is the
// diagnostic.
export fn each_expand(
    StringView name0,
    ref<Type, shared> t0,
    ref<Vec<Expr>, shared> args,
    usize line,
    usize col,
) : Result<Expr, String>
{
    Mk m = Mk { .line = line, .col = col };
    if (Vec::len(args) == 0)
    {
        return bad();
    }
    Expr a0 = clone(&args[0]);
    // `foreach (x in lo .. hi)` (D-0097).
    if (name0 == "$each_range")
    {
        bool names_ok = match (int_arg(args, 2))
        {
            Some(v) : v == 1 || v == 2,
            None    : false,
        };
        if (!names_ok)
        {
            return detail("a range is looped over with one name, the value, or two: its position and the value");
        }
        bool unsigned_int = match (t0)
        {
            Type::TInt(k) : !int_ty_signed(*k),
            _ : return detail(sprintf(
                "a range's bounds are integers, but this one is `%s`",
                &type_display(t0),
            )),
        };
        if (Vec::len(args) < 2)
        {
            return bad();
        }
        ref<Expr, shared> e = &args[1];
        match (&e.kind)
        {
            ExprKind::EUnit : return Ok(at(&m, ExprKind::EUnit)),
            _               : {},
        }
        if (unsigned_int && negated(e))
        {
            // Two literal bounds are typed through a hidden `$z`.
            bool plain = match (&a0.kind)
            {
                ExprKind::EPath(pb) : Vec::len(&Box::get(pb).segs) == 1 && StringView::starts_with(
                    &Box::get(pb).segs[0],
                    "$z",
                ),
                _ : false,
            };
            if (plain)
            {
                return detail("a range of two plain-number bounds counts in `usize`, which cannot be negative; give one bound a signed type: `-3..0: i32`");
            }
            return detail(sprintf("a range of `%s` cannot have a negative bound", &type_display(t0)));
        }
        if (has_float(e))
        {
            return detail(sprintf(
                "a range's bounds are integers of one type: the other bound is `%s`, this one a floating-point literal",
                &type_display(t0),
            ));
        }
        Vec<Stmt> stmts = Vec::new();
        Vec::push(&mut stmts, let_stmt(Some(clone(t0)), "$r", Some(clone(e)), line, col));
        return Ok(at(&m, ExprKind::EBlock(Block { .stmts = stmts, .tail = Some(Box::new(path_of(&m, "$r"))) })));
    }
    Expr a1 = if (Vec::len(args) > 1) { clone(&args[1]) } else { at(&m, ExprKind::EUnit) };
    // The borrowed forms hold a reference; the consuming form a holder.
    Option<Mode> mode = None;
    ref<Type, shared> inner = t0;
    match (t0)
    {
        Type::TRef(rb) :
        {
            mode = Some(Box::get(rb).mode);
            inner = &Box::get(rb).inner;
        },
        _              : {},
    }
    CollOf co = match (coll(inner))
    {
        Some(c) : c,
        None    :
        {
            // Text is not walked as it is (its unit, a byte or a character, is
            // a choice): `foreach` takes the characters or the bytes asked for.
            Option<str> text = match (inner)
            {
                Type::TNamed(nb) : if (Vec::len(&Box::get(nb).args) == 0 && Box::get(nb).name == "std::String") { Some("s") } else if (Vec::len(&Box::get(nb).args) == 0 && Box::get(nb).name == "std::StringView") { Some("v") } else { None },
                Type::TStr       : Some("t"),
                _                : None,
            };
            match (text)
            {
                Some(x) :
                {
                    str amp = if (x == "s") { "&" } else { "" };
                    return detail(sprintf(
                        "`foreach` does not walk text by itself: its characters are `StringView::chars(%s%s)`, its bytes `StringView::as_bytes(%s%s)`",
                        amp,
                        x,
                        amp,
                        x,
                    ));
                },
                None    : {},
            }
            // Bug 089: a queue is taken from, not walked.
            match (inner)
            {
                Type::TNamed(nb) :
                {
                    ref<String, shared> qn = &Box::get(nb).name;
                    if (*qn == "std::Queue" || *qn == "std::PriorityQueue")
                    {
                        StringView shown = Option::unwrap_or(StringView::strip_prefix(qn, "std::"), qn);
                        StringView pop = if (*qn == "std::Queue") { "pop_front" } else { "pop" };
                        return detail(sprintf(
                            "`foreach` does not walk a `%v`: take its elements in a loop, `while (Some(x) = %v::%v(&mut q)) { … }`, or keep them in a `Vec`, which `foreach` walks",
                            shown,
                            shown,
                            pop,
                        ));
                    }
                },
                _                : {},
            }
            return bad();
        },
    };
    // A reference written without `&` is looped over as the borrow it is.
    StringView name = name0;
    match (mode)
    {
        Some(md) :
        {
            if (name0 == "$each_drain")
            {
                return Ok(a0);
            }
            if (name0 == "$each_take")
            {
                name = StringView::of(if (md == Mode::Shared) { "$each_at" } else { "$each_at_mut" });
            }
            else if (name0 == "$each_take_key")
            {
                name = "$each_key";
            }
        },
        None     : {},
    }
    // A HashMap has a key and a value; three names are for a map only.
    u128 names = Option::unwrap_or(int_arg(args, 2), 0);
    if (name == "$each_at" || name == "$each_at_mut")
    {
        bool map = co.c == Coll::CMap;
        if ((map && names == 1) || (!map && names == 3))
        {
            return bad();
        }
    }
    bool none_mode = Option::is_none(&mode);
    bool shared_mode = match (mode)
    {
        Some(md) : md == Mode::Shared,
        None     : false,
    };
    bool excl_mode = match (mode)
    {
        Some(md) : md == Mode::Exclusive,
        None     : false,
    };
    Coll c = co.c;
    // The parser gives the loop a hidden `$p` (`$each_slot`) unless it is
    // written over `&c`: over `&mut c` (exclusive), or over a `c` with no
    // borrow written (the `take` names).
    bool slot = excl_mode || name0 == "$each_take" || name0 == "$each_take_key";
    // D-0331: a map's entry, borrowed once for its key and its value (the
    // hidden `$p`); for any other collection the position, which nothing
    // reads.
    if (name == "$each_slot")
    {
        if (c == Coll::CMap && shared_mode)
        {
            return Ok(call2(
                &m,
                "std::Vec::index_shared",
                shared(&m, field(&m, deref(&m, a0), "entries")),
                place_of(&m, a1),
            ));
        }
        if (c == Coll::CMap && excl_mode)
        {
            return Ok(call2(
                &m,
                "std::Vec::index_exclusive",
                excl(&m, field(&m, deref(&m, a0), "entries")),
                place_of(&m, a1),
            ));
        }
        return Ok(a1);
    }
    // Bug 045: the place in a borrowed map's `entries` of the entry at the
    // position (`std::map_place`, past the holes `remove` leaves); for a
    // drained map (its holes closed) and any other collection the position
    // itself.
    if (name == "$each_place")
    {
        if (c == Coll::CMap && !none_mode)
        {
            // `if ((*c).holes.count == 0) { $i } else { std::map_place(&(*c).holes, $i) }`:
            // one compare a turn for a map with no hole.
            Expr count = field(&m, field(&m, deref(&m, clone(&a0)), "holes"), "count");
            Expr zero = at(&m, ExprKind::EInt(Box::new(IntLit { .v = 0, .sfx = None })));
            Expr none = at(&m, ExprKind::EBinary(Box::new(BinaryExpr { .op = BinOp::Eq, .a = count, .b = zero })));
            Expr slow = call2(&m, "std::map_place", shared(&m, field(&m, deref(&m, a0), "holes")), clone(&a1));
            Expr past = at(&m, ExprKind::EBlock(Block { .stmts = Vec::new(), .tail = Some(Box::new(slow)) }));
            return Ok(at(&m, ExprKind::EIf(Box::new(IfExpr {
                .cond = none,
                .then_ = Block { .stmts = Vec::new(), .tail = Some(Box::new(a1)) },
                .else_ = Some(past),
            }))));
        }
        return Ok(a1);
    }
    if (name == "$each_drain")
    {
        if (!none_mode)
        {
            return bad();
        }
        if ((c == Coll::CVec || c == Coll::CArray || c == Coll::CSet || c == Coll::CSlice || c == Coll::CParts) && Option::unwrap_or(
            int_arg(args, 1),
            0,
        ) == 3)
        {
            return bad();
        }
        // A slice (D-0047) is a borrow already.
        if (c == Coll::CSlice || c == Coll::CArray)
        {
            return Ok(a0);
        }
        // D-0287: a text splitter's parts, found as they are taken
        // (`std::Parts`, which `modres` made the loop hold): the holder is
        // the `Parts` itself, and the bound grows by one while a part is
        // left.
        if (c == Coll::CParts)
        {
            return Ok(a0);
        }
        if (c == Coll::CVec)
        {
            return Ok(call1(&m, "std::Vec::drain", a0));
        }
        if (c == Coll::CSet)
        {
            return Ok(call1(&m, "std::HashSet::drain", a0));
        }
        if (c == Coll::CMap)
        {
            u128 k = Option::unwrap_or(int_arg(args, 1), 0);
            if (k == 2 || k == 3)
            {
                return Ok(call1(&m, "std::HashMap::drain", a0));
            }
            return bad();
        }
        return bad();
    }
    if (name == "$each_len")
    {
        if (c == Coll::CSlice)
        {
            return Ok(call1(&m, "slice_len", a0));
        }
        if (c == Coll::CArray)
        {
            return Ok(at(&m, ExprKind::EInt(Box::new(IntLit { .v = co.n, .sfx = None }))));
        }
        if (c == Coll::CParts && none_mode)
        {
            return Ok(call1(&m, "std::Parts::bound", a0));
        }
        if (!none_mode)
        {
            if (c == Coll::CVec)
            {
                return Ok(call1(&m, "std::Vec::len", shared(&m, deref(&m, a0))));
            }
            if (c == Coll::CSet)
            {
                return Ok(call1(&m, "std::HashSet::len", shared(&m, deref(&m, a0))));
            }
            if (c == Coll::CMap)
            {
                return Ok(call1(&m, "std::HashMap::len", shared(&m, deref(&m, a0))));
            }
            return bad();
        }
        if (c == Coll::CDrain)
        {
            return Ok(call1(&m, "std::Drain::total", shared(&m, a0)));
        }
        if (c == Coll::CSetDrain)
        {
            return Ok(call1(&m, "std::SetDrain::total", shared(&m, a0)));
        }
        if (c == Coll::CMapDrain)
        {
            return Ok(call1(&m, "std::HashDrain::total", shared(&m, a0)));
        }
        return bad();
    }
    if (name == "$each_take")
    {
        if (!none_mode)
        {
            return bad();
        }
        if (c == Coll::CSlice)
        {
            Expr ix = index(&m, a0, a1);
            return Ok(if (co.mode == Mode::Shared) { shared(&m, ix) } else { excl(&m, ix) });
        }
        // `{ $d = std::Parts::next($d); std::StringView::part($d.v, $d.lo,
        // $d.hi) }`: the holder goes by value, never borrowed.
        if (c == Coll::CParts)
        {
            Expr step = at(
                &m,
                ExprKind::EAssign(Box::new(PairExpr { .a = clone(&a0), .b = call1(
                    &m,
                    "std::Parts::next",
                    clone(&a0),
                ) })),
            );
            Vec<Stmt> stmts = Vec::new();
            Vec::push(&mut stmts, Stmt::SExpr(Box::new(step)));
            Vec<Expr> sub_args = Vec::new();
            Vec::push(&mut sub_args, field(&m, clone(&a0), "v"));
            Vec::push(&mut sub_args, field(&m, clone(&a0), "lo"));
            Vec::push(&mut sub_args, field(&m, a0, "hi"));
            Expr sub = at(
                &m,
                ExprKind::ECall(Box::new(CallExpr { .callee = path_of(&m, "std::StringView::part"), .args = sub_args })),
            );
            return Ok(at(&m, ExprKind::EBlock(Block { .stmts = stmts, .tail = Some(Box::new(sub)) })));
        }
        if (c == Coll::CDrain)
        {
            return Ok(call1(&m, "std::Drain::take", excl(&m, a0)));
        }
        if (c == Coll::CArray)
        {
            return Ok(index(&m, a0, a1));
        }
        if (c == Coll::CSetDrain)
        {
            return Ok(call1(&m, "std::SetDrain::take", excl(&m, a0)));
        }
        if (c == Coll::CMapDrain)
        {
            return Ok(call1(&m, "std::HashDrain::take_value", excl(&m, a0)));
        }
        return bad();
    }
    if (name == "$each_take_key")
    {
        if (!none_mode)
        {
            return bad();
        }
        if (c == Coll::CSlice || c == Coll::CDrain || c == Coll::CArray || c == Coll::CSetDrain || c == Coll::CParts)
        {
            return Ok(a1);
        }
        if (c == Coll::CMapDrain)
        {
            return Ok(call1(&m, "std::HashDrain::take_key", excl(&m, a0)));
        }
        return bad();
    }
    if (name == "$each_at")
    {
        if (!shared_mode)
        {
            return bad();
        }
        if (c == Coll::CSlice || c == Coll::CArray)
        {
            return Ok(shared(&m, index(&m, deref(&m, a0), a1)));
        }
        if (c == Coll::CVec)
        {
            return Ok(call2(&m, "std::Vec::index_shared", a0, a1));
        }
        if (c == Coll::CSet)
        {
            return Ok(call2(&m, "std::HashSet::key_at", a0, a1));
        }
        if (c == Coll::CMap)
        {
            return Ok(shared(&m, field(&m, deref(&m, map_entry(&m, slot, a0, a1)), "value")));
        }
        return bad();
    }
    if (name == "$each_at_mut")
    {
        if (!excl_mode)
        {
            return bad();
        }
        if (c == Coll::CSlice || c == Coll::CArray)
        {
            return Ok(excl(&m, index(&m, deref(&m, a0), a1)));
        }
        if (c == Coll::CVec)
        {
            return Ok(call2(&m, "std::Vec::index_exclusive", excl(&m, deref(&m, a0)), a1));
        }
        if (c == Coll::CMap)
        {
            // The entry the key came from (`$each_slot`), borrowed exclusively.
            return Ok(excl(&m, field(&m, deref(&m, map_entry(&m, true, a0, a1)), "value")));
        }
        // A set's keys are not changed in place.
        return bad();
    }
    if (name == "$each_key")
    {
        if (none_mode)
        {
            return bad();
        }
        if (c == Coll::CMap)
        {
            return Ok(shared(&m, field(&m, deref(&m, map_entry(&m, slot, a0, a1)), "key")));
        }
        if (c == Coll::CSlice || c == Coll::CVec || c == Coll::CArray || c == Coll::CSet)
        {
            return Ok(a1);
        }
        return bad();
    }
    bad()
}
