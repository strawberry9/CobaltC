    " r = net_num(14, self.id, StringView::of(\"\").bytes, StringView::of(\"\").bytes, 0);\n}export fn UdpSock"
    "et::bind(SocketAddr a) : Result<UdpSocket, NetError>\n{\n    usize id = net_open(15, &a, 0)?;\n    Ok(U"
