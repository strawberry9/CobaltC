    "5> r = [1, 0, 0, 0, 0];\n    for (usize k = 0; k < 255; k += 1)\n    {\n        usize i = 254 - k;\n    "
    "    r = fe_mul(r, r);\n        if (i >= 5 || i == 3 || i == 1 || i == 0)\n        {\n            r = fe"
