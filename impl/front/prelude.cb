    "engths, h);\n    gcm_bytes(y ^ gcm_block(&aes_block(key, j0), 0))\n}fn gcm_j0(slice<u8, shared> nonce)"
    " : array<u8, 16>\n{\n    if (slice_len(nonce) != 12)\n    {\n        fault(crypto_length);\n    }\n    arr"
    "ay<u8, 16> j = [0; 16];\n    for (usize i = 0; i < 12; i += 1)\n    {\n        j[i] = nonce[i];\n    }\n "
    "   j[15] = 1;\n    j\n}export fn aes_gcm_seal(\n    slice<u8, shared> key,\n    slice<u8, shared> nonce,"
    "\n    slice<u8, shared> aad,\n    slice<u8, shared> plaintext,\n) : Vec<u8>\n{\n    array<u8, 16> j0 = gc"
