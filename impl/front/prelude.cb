    "], d);\n    out[4] = wrapping_add(h[4], e);\n    out[5] = wrapping_add(h[5], f);\n    out[6] = wrapping"
    "_add(h[6], g);\n    out[7] = wrapping_add(h[7], hh);\n    out\n}fn sha256_absorb(Sha256 s, slice<u8, sh"
    "ared> data) : Sha256\n{\n    usize n = slice_len(data);\n    usize i = 0;\n    while (i < n)\n    {\n     "
