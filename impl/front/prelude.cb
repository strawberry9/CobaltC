    "_ROW3_HI);\n    }\n    r\n}fn aes_rot1(u64 x) : u64\n{\n    ((x >> 1) & 0x7777777777777777) | ((x << 3) &"
    " 0x8888888888888888)\n}fn aes_rot2(u64 x) : u64\n{\n    ((x >> 2) & 0x3333333333333333) | ((x << 2) & 0"
    "xcccccccccccccccc)\n}fn aes_rot3(u64 x) : u64\n{\n    ((x >> 3) & 0x1111111111111111) | ((x << 1) & 0xe"
    "eeeeeeeeeeeeeee)\n}fn aes_mix_columns(array<u64, 8> q) : array<u64, 8>\n{\n    array<u64, 8> d = [0; 8]"
    ";\n    array<u64, 8> s = [0; 8];\n    for (usize b = 0; b < 8; b += 1)\n    {\n        u64 r1 = aes_rot1"
    "(q[b]);\n        d[b] = q[b] ^ r1;\n        s[b] = r1 ^ aes_rot2(q[b]) ^ aes_rot3(q[b]);\n    }\n    [\n "
    "       s[0] ^ d[7],\n        s[1] ^ d[0] ^ d[7],\n        s[2] ^ d[1],\n        s[3] ^ d[2] ^ d[7],\n   "
    "     s[4] ^ d[3] ^ d[7],\n        s[5] ^ d[4],\n        s[6] ^ d[5],\n        s[7] ^ d[6],\n    ]\n}fn ae"
    "s_xtime(u8 a) : u8\n{\n    (a << 1) ^ (0x1b & wrapping_sub(0: u8, a >> 7))\n}fn aes_expand(slice<u8, sh"
    "ared> key) : AesKey\n{\n    usize nk = slice_len(key) / 4;\n    if (slice_len(key) != 16 && slice_len(k"
    "ey) != 24 && slice_len(key) != 32)\n    {\n        fault(crypto_length);\n    }\n    usize rounds = nk +"
    " 6;\n    array<u32, 60> w = [0; 60];\n    for (usize i = 0; i < nk; i += 1)\n    {\n        w[i] = widen"
    "<u32>(key[4 * i]) | (widen<u32>(key[4 * i + 1]) << 8) | (widen<u32>(key[4 * i + 2]) << 16) | (widen<"
    "u32>(key[4 * i + 3]) << 24);\n    }\n    u8 rcon = 1;\n    for (usize word = nk; word < 4 * (rounds + 1"
    "); word += 1)\n    {\n        u32 t = w[word - 1];\n        if (word % nk == 0)\n        {\n            t"
    " = narrow_wrapping<u32>(aes_sbox_bytes(widen<u64>((t >> 8) | (t << 24)))) ^ widen<u32>(rcon);\n      "
    "      rcon = aes_xtime(rcon);\n        }\n        else if (nk > 6 && word % nk == 4)\n        {\n       "
    "     t = narrow_wrapping<u32>(aes_sbox_bytes(widen<u64>(t)));\n        }\n        w[word] = w[word - n"
    "k] ^ t;\n    }\n    array<u64, 120> sk = [0; 120];\n    for (usize r = 0; r <= rounds; r += 1)\n    {\n  "
    "      array<u8, 64> b = [0; 64];\n        for (usize j = 0; j < 16; j += 1)\n        {\n            u8 "
    "v = narrow_wrapping<u8>(w[4 * r + j / 4] >> narrow<u32>(8 * (j % 4)));\n            for (usize k = 0;"
    " k < 4; k += 1)\n            {\n                b[16 * k + j] = v;\n            }\n        }\n        arr"
    "ay<u64, 8> q = aes_pack(b);\n        for (usize p = 0; p < 8; p += 1)\n        {\n            sk[8 * r "
    "+ p] = q[p];\n        }\n    }\n    AesKey { .sk = sk, .rounds = rounds }\n}fn aes_encrypt4(ref<AesKey, "
    "shared> key, array<u64, 8> input) : array<u64, 8>\n{\n    array<u64, 8> q = input;\n    for (usize p = "
    "0; p < 8; p += 1)\n    {\n        q[p] = q[p] ^ key.sk[p];\n    }\n    for (usize round = 1; round <= ke"
    "y.rounds; round += 1)\n    {\n        q = aes_shift_rows(aes_sbox_ct(q));\n        if (round < key.roun"
    "ds)\n        {\n            q = aes_mix_columns(q);\n        }\n        for (usize p = 0; p < 8; p += 1)"
    "\n        {\n            q[p] = q[p] ^ key.sk[8 * round + p];\n        }\n    }\n    q\n}fn aes_block(ref<"
    "AesKey, shared> key, array<u8, 16> input) : array<u8, 16>\n{\n    array<u8, 64> b = [0; 64];\n    for ("
    "usize i = 0; i < 16; i += 1)\n    {\n        b[i] = input[i];\n    }\n    array<u8, 64> e = aes_unpack(a"
    "es_encrypt4(key, aes_pack(b)));\n    array<u8, 16> out = [0; 16];\n    for (usize i = 0; i < 16; i += "
    "1)\n    {\n        out[i] = e[i];\n    }\n    out\n}export fn aes_encrypt_block(slice<u8, shared> key, ar"
    "ray<u8, 16> block) : array<u8, 16>\n{\n    AesKey k = aes_expand(key);\n    aes_block(&k, block)\n}unitt"
    "est \"aes_encrypt_block: the FIPS 197 AES-128 vector\"\n{\n    Vec<u8> key = Result::unwrap(from_hex(\"00"
    "0102030405060708090a0b0c0d0e0f\"));\n    Vec<u8> b = Result::unwrap(from_hex(\"00112233445566778899aabb"
    "ccddeeff\"));\n    array<u8, 16> block = [0; 16];\n    for (usize i = 0; i < 16; i += 1)\n    {\n        "
    "block[i] = b[i];\n    }\n    array<u8, 16> out = aes_encrypt_block(&key, block);\n    assert(to_hex(&ou"
    "t) == \"69c4e0d86a7b0430d8cdb78070b4c55a\");\n}fn gcm_block(slice<u8, shared> b, usize at) : u128\n{\n   "
    " u128 x = 0;\n    for (usize i = 0; i < 16; i += 1)\n    {\n        u8 v = if (at + i < slice_len(b)) {"
    " b[at + i] } else { 0 };\n        x = (x << 8) | widen<u128>(v);\n    }\n    x\n}fn ghash_bmul64(u64 x, "
    "u64 y) : u64\n{\n    u64 x0 = x & 0x1111111111111111;\n    u64 x1 = x & 0x2222222222222222;\n    u64 x2 "
    "= x & 0x4444444444444444;\n    u64 x3 = x & 0x8888888888888888;\n    u64 y0 = y & 0x1111111111111111;\n"
    "    u64 y1 = y & 0x2222222222222222;\n    u64 y2 = y & 0x4444444444444444;\n    u64 y3 = y & 0x8888888"
    "888888888;\n    u64 z0 = wrapping_mul(x0, y0) ^ wrapping_mul(x1, y3) ^ wrapping_mul(x2, y2) ^ wrappin"
    "g_mul(x3, y1);\n    u64 z1 = wrapping_mul(x0, y1) ^ wrapping_mul(x1, y0) ^ wrapping_mul(x2, y3) ^ wra"
    "pping_mul(x3, y2);\n    u64 z2 = wrapping_mul(x0, y2) ^ wrapping_mul(x1, y1) ^ wrapping_mul(x2, y0) ^"
    " wrapping_mul(x3, y3);\n    u64 z3 = wrapping_mul(x0, y3) ^ wrapping_mul(x1, y2) ^ wrapping_mul(x2, y"
    "1) ^ wrapping_mul(x3, y0);\n    (z0 & 0x1111111111111111) | (z1 & 0x2222222222222222) | (z2 & 0x44444"
    "44444444444) | (z3 & 0x8888888888888888)\n}fn ghash_rev64(u64 x) : u64\n{\n    u64 v = ((x & 0x55555555"
    "55555555) << 1) | ((x >> 1) & 0x5555555555555555);\n    v = ((v & 0x3333333333333333) << 2) | ((v >> "
    "2) & 0x3333333333333333);\n    v = ((v & 0x0f0f0f0f0f0f0f0f) << 4) | ((v >> 4) & 0x0f0f0f0f0f0f0f0f);"
    "\n    v = ((v & 0x00ff00ff00ff00ff) << 8) | ((v >> 8) & 0x00ff00ff00ff00ff);\n    v = ((v & 0x0000ffff"
    "0000ffff) << 16) | ((v >> 16) & 0x0000ffff0000ffff);\n    (v << 32) | (v >> 32)\n}fn ghash_mul(u128 x,"
    " u128 y) : u128\n{\n    u64 x1 = narrow_wrapping<u64>(x >> 64);\n    u64 x0 = narrow_wrapping<u64>(x);\n"
    "    u64 y1 = narrow_wrapping<u64>(y >> 64);\n    u64 y0 = narrow_wrapping<u64>(y);\n    u64 x0r = ghas"
    "h_rev64(x0);\n    u64 x1r = ghash_rev64(x1);\n    u64 y0r = ghash_rev64(y0);\n    u64 y1r = ghash_rev64"
    "(y1);\n    u64 z0 = ghash_bmul64(x0, y0);\n    u64 z1 = ghash_bmul64(x1, y1);\n    u64 z2 = ghash_bmul6"
    "4(x0 ^ x1, y0 ^ y1);\n    u64 z0h = ghash_bmul64(x0r, y0r);\n    u64 z1h = ghash_bmul64(x1r, y1r);\n   "
    " u64 z2h = ghash_bmul64(x0r ^ x1r, y0r ^ y1r);\n    z2 = z2 ^ z0 ^ z1;\n    z2h = z2h ^ z0h ^ z1h;\n   "
    " z0h = ghash_rev64(z0h) >> 1;\n    z1h = ghash_rev64(z1h) >> 1;\n    z2h = ghash_rev64(z2h) >> 1;\n    "
    "u64 v0 = z0;\n    u64 v1 = z0h ^ z2;\n    u64 v2 = z1 ^ z2h;\n    u64 v3 = z1h;\n    v3 = (v3 << 1) | (v"
    "2 >> 63);\n    v2 = (v2 << 1) | (v1 >> 63);\n    v1 = (v1 << 1) | (v0 >> 63);\n    v0 = v0 << 1;\n    v2"
    " = v2 ^ v0 ^ (v0 >> 1) ^ (v0 >> 2) ^ (v0 >> 7);\n    v1 = v1 ^ (v0 << 63) ^ (v0 << 62) ^ (v0 << 57);\n"
    "    v3 = v3 ^ v1 ^ (v1 >> 1) ^ (v1 >> 2) ^ (v1 >> 7);\n    v2 = v2 ^ (v1 << 63) ^ (v1 << 62) ^ (v1 <<"
    " 57);\n    (widen<u128>(v3) << 64) | widen<u128>(v2)\n}fn ghash_update(u128 y, u128 h, slice<u8, share"
    "d> data) : u128\n{\n    u128 acc = y;\n    for (usize at = 0; at < slice_len(data); at += 16)\n    {\n   "
    "     acc = ghash_mul(acc ^ gcm_block(data, at), h);\n    }\n    acc\n}fn gcm_bytes(u128 x) : array<u8, "
    "16>\n{\n    array<u8, 16> b = [0; 16];\n    for (usize i = 0; i < 16; i += 1)\n    {\n        b[i] = narr"
    "ow_wrapping<u8>(x >> narrow<u32>(8 * (15 - i)));\n    }\n    b\n}fn gcm_ctr(ref<AesKey, shared> key, ar"
    "ray<u8, 16> j0, slice<u8, shared> data) : Vec<u8>\n{\n    Vec<u8> out = Vec::from_slice(data);\n    arr"
    "ay<u8, 64> cb = [0; 64];\n    for (usize k = 0; k < 4; k += 1)\n    {\n        for (usize i = 0; i < 12"
    "; i += 1)\n        {\n            cb[16 * k + i] = j0[i];\n        }\n    }\n    // The counter, kept apa"
    "rt from the blocks (whose last four bytes it is).\n    u32 c = (widen<u32>(j0[12]) << 24) | (widen<u3"
    "2>(j0[13]) << 16) | (widen<u32>(j0[14]) << 8) | widen<u32>(j0[15]);\n    for (usize at = 0; at < slic"
    "e_len(data); at += 64)\n    {\n        for (usize k = 0; k < 4; k += 1)\n        {\n            c = wrap"
    "ping_add(c, 1);\n            for (usize i = 0; i < 4; i += 1)\n            {\n                cb[16 * k"
    " + 12 + i] = narrow_wrapping<u8>(c >> narrow<u32>(24 - 8 * i));\n            }\n        }\n        arra"
    "y<u8, 64> ks = aes_unpack(aes_encrypt4(key, aes_pack(cb)));\n        for (usize i = 0; i < 64 && at +"
    " i < slice_len(data); i += 1)\n        {\n            out[at + i] = out[at + i] ^ ks[i];\n        }\n   "
    " }\n    out\n}fn gcm_tag(\n    ref<AesKey, shared> key,\n    array<u8, 16> j0,\n    slice<u8, shared> aad"
    ",\n    slice<u8, shared> ciphertext,\n) : array<u8, 16>\n{\n    u128 h = gcm_block(&aes_block(key, [0; 1"
