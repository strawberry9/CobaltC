    "exclusive> m, probe<K> k) : Option<V>\u{1f}Removes `k` and returns its value; `None` when `k` is absent.\u{1f}"
    "\u{1f}export fn HashMap::remove<K, V>(ref<HashMap<K, V>, exclusive> m, probe<K> k) : Option<V>\n    in `st"
    "d::collections`\n\n    Removes `k` and returns its value; `None` when `k` is absent.\n\n    The other en"
    "tries keep their order. The later entries are not moved at once: the emptied place is closed\n    up "
    "with others after many removals, so a removal takes amortised logarithmic time in the size of the ma"
    "p,\n    in any order. `HashMap::swap_remove` takes constant time but does not keep the order. The rem"
    "oved key is\n    destroyed.\n\n    Example, \"HashMap::remove: order kept\":\n        HashMap<i32, bool> a"
    " = HashMap::new();\n        HashMap::insert(&mut a, 1, true);\n        HashMap::insert(&mut a, 2, true"
    ");\n        HashMap::insert(&mut a, 3, true);\n        HashMap<i32, bool> b = HashMap::clone(&a);\n    "
    "    i32 one = 1;\n        HashMap::remove(&mut a, one);\n        assert(*HashMap::key_at(&a, 0) == 2 &"
    "& *HashMap::key_at(&a, 1) == 3);\n        HashMap::swap_remove(&mut b, one);\n        assert(*HashMap:"
    ":key_at(&b, 0) == 3 && *HashMap::key_at(&b, 1) == 2);\n\n    Example, \"HashMap::remove: emptied places"
    "\":\n        HashMap<i32, i32> m = HashMap::new();\n        i32 i = 0;\n        while (i < 10)\n        {"
    "\n            HashMap::insert(&mut m, i, i * 10);\n            i += 1;\n        }\n        i32 two = 2;\n"
    "        i32 zero = 0;\n        i32 five = 5;\n        i32 nine = 9;\n        assert(Option::unwrap(Hash"
    "Map::remove(&mut m, two)) == 20);\n        assert(Option::unwrap(HashMap::remove(&mut m, zero)) == 0)"
    ";\n        assert(Option::unwrap(HashMap::remove(&mut m, five)) == 50);\n        assert(HashMap::len(&"
    "m) == 7);\n        assert(*HashMap::key_at(&m, 0) == 1 && *HashMap::key_at(&m, 1) == 3 && *HashMap::v"
    "alue_at(&m, 3) == 60);\n        i32 sum = 0;\n        i32 pos = 0;\n        foreach (k, v in &m)\n      "
    "  {\n            assert(*k == *HashMap::key_at(&m, narrow<usize>(pos)) && *v == *k * 10);\n           "
    " sum += *k;\n            pos += 1;\n        }\n        assert(sum == 1 + 3 + 4 + 6 + 7 + 8 + 9);\n      "
    "  HashMap<i32, i32> c = HashMap::clone(&m);\n        assert(HashMap::len(&c) == 7 && *HashMap::key_at"
    "(&c, 2) == 4 && *Option::unwrap(HashMap::get(&c, nine)) == 90);\n        i32 one = 1;\n        HashMap"
    "::swap_remove(&mut m, one);\n        assert(*HashMap::key_at(&m, 0) == 9 && *HashMap::key_at(&m, 5) ="
    "= 8 && HashMap::len(&m) == 6);\n        HashMap::insert(&mut m, 2, 22);\n        assert(*HashMap::key_"
    "at(&m, 6) == 2 && *Option::unwrap(HashMap::get(&m, two)) == 22);\n        i = 0;\n        while (i < 1"
    "00)\n        {\n            HashMap::insert(&mut m, 100 + i, i);\n            i32 gone = 100 + i / 2;\n "
    "           HashMap::remove(&mut m, gone);\n            i += 1;\n        }\n        assert(HashMap::len("
    "&m) == 57 && *HashMap::key_at(&m, 7) == 150 && *HashMap::key_at(&m, 56) == 199);\n\n    Example, \"Hash"
    "Map::get: literal key\":\n        HashMap<String, i32> m = HashMap::new();\n        HashMap::insert(&mu"
    "t m, \"apple\", 3);\n        assert(*Option::unwrap(HashMap::get(&m, \"apple\")) == 3);\n        assert(!H"
    "ashMap::contains(&m, \"pear\"));\n\u{1f}\u{1e}std::collections\u{1f}HashSet\u{1f}struct\u{1f}export struct HashSet<K>\u{1f}A set of k"
    "eys of type `K`, kept in insertion order.\u{1f}\u{1f}export struct HashSet<K>\n    in `std::collections`\n\n    A"
    " set of keys of type `K`, kept in insertion order.\n\n    `K` is a key type, as for `HashMap`. Key `i`"
    " (`key_at`) is in insertion order, and `foreach (k in s)`\n    visits the keys in that order. The set"
    " owns its keys and destroys them with itself.\n\u{1f}\u{1e}std::collections\u{1f}HashSet::new\u{1f}fn\u{1f}export fn HashSet::"
