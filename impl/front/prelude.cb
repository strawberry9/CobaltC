    " == 64)\n            {\n                s.h = sha256_block(s.h, s.block);\n                s.fill = 0;\n"
    "            }\n        }\n    }\n    s.length = wrapping_add(s.length, widen<u64>(n));\n    s\n}export fn"
    " Sha256::update(ref<Sha256, exclusive> s, slice<u8, shared> data)\n{\n    *s = sha256_absorb(*s, data)"
