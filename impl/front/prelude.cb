    ", 5: u64));\n            }\n            while (Vec::len(&hs) > 0)\n            {\n                _ = jo"
    "in(Option::unwrap(Vec::pop(&mut hs)));\n            }\n        }\n        assert(Atomic::load(&hits) =="
    " 40);\n\n    Example, \"Atomic::compare_exchange: success and failure\":\n        Atomic<i32> a = Atomic:"
    ":new(5: i32);\n        assert(Result::unwrap(Atomic::compare_exchange(&a, 5, 9)) == 5);\n        match"
    " (Atomic::compare_exchange(&a, 5, 1))\n        {\n            Ok(_)    : assert(false),\n            Er"
    "r(now) : assert(now == 9),\n        }\n        assert(Atomic::swap(&a, 2) == 9);\n        Atomic::store"
    "(&a, 7);\n        assert(Atomic::load(&a) == 7);\n\n    Example, \"Atomic::fetch_or: flags and wrapping\""
    ":\n        Atomic<u8> f = Atomic::new(0: u8);\n        _ = Atomic::fetch_or(&f, 0x05);\n        _ = Ato"
    "mic::fetch_and(&f, 0x0c);\n        _ = Atomic::fetch_xor(&f, 0x0f);\n        assert(Atomic::load(&f) ="
    "= 0x0b);\n        assert(Atomic::fetch_add_wrapping(&f, 250) == 0x0b);\n        assert(Atomic::load(&f"
    ") == 5);\n        assert(Atomic::fetch_sub_wrapping(&f, 6) == 5);\n        assert(Atomic::load(&f) == "
    "255);\n\u{1f}\u{1e}std::sync\u{1f}Atomic::fetch_max\u{1f}fn\u{1f}export fn Atomic::fetch_max<T: integer>(ref<Atomic<T>, shared"
    "> a, T v) : T\u{1f}Replaces the value `a` holds with the larger of it and `v`, giving the value it held.\u{1f}"
    "\u{1f}export fn Atomic::fetch_max<T: integer>(ref<Atomic<T>, shared> a, T v) : T\n    in `std::sync`\n\n    "
    "Replaces the value `a` holds with the larger of it and `v`, giving the value it held.\n\n    A maximum"
    " kept by several threads: a high-water mark, the latest timestamp seen.\n\u{1f}\u{1e}std::sync\u{1f}Atomic::fetch_mi"
    "n\u{1f}fn\u{1f}export fn Atomic::fetch_min<T: integer>(ref<Atomic<T>, shared> a, T v) : T\u{1f}Replaces the value `"
    "a` holds with the smaller of it and `v`, giving the value it held.\u{1f}\u{1f}export fn Atomic::fetch_min<T: i"
    "nteger>(ref<Atomic<T>, shared> a, T v) : T\n    in `std::sync`\n\n    Replaces the value `a` holds with"
    " the smaller of it and `v`, giving the value it held.\n\u{1f}\u{1e}std::sync\u{1f}Atomic::fetch_update\u{1f}fn\u{1f}export fn "
    "Atomic::fetch_update<T: integer>(ref<Atomic<T>, shared> a, fn(T) : Option<T> f) : Result<T, T>\u{1f}Repla"
    "ces the value `a` holds with `f` of it, retrying when another thread changed it meanwhile.\u{1f}\u{1f}export f"
    "n Atomic::fetch_update<T: integer>(ref<Atomic<T>, shared> a, fn(T) : Option<T> f) : Result<T, T>\n   "
    " in `std::sync`\n\n    Replaces the value `a` holds with `f` of it, retrying when another thread chang"
    "ed it meanwhile.\n\n    `f` is called with the value found and gives `Some(new)` to store or `None` to"
