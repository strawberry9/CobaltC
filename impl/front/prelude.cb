// `std`'s documentation as `--doc` shows it (CHG-0446, `encode_record`): per
// exported item, its module, name, kind, signature, summary, standing
// and entry, each ended by U+001F, the item by U+001E.
export const str PRELUDE_DOCS =
    "std::core\u{1f}Option\u{1f}enum\u{1f}export enum Option<T>\u{1f}A value that may be absent: `Some(T)` holds one, `None` "
    "holds nothing.\u{1f}\u{1f}export enum Option<T>\n    in `std::core`\n\n    A value that may be absent: `Some(T)` "
    "holds one, `None` holds nothing.\n\n    In `std` after `import std;`, unqualified, as are its variants"
    ".\n\u{1f}\u{1e}std::core\u{1f}Result\u{1f}enum\u{1f}export enum Result<T, E>\u{1f}The outcome of an operation that can fail: `Ok(T)"
    "` holds the value, `Err(E)` the error.\u{1f}\u{1f}export enum Result<T, E>\n    in `std::core`\n\n    The outcome"
    " of an operation that can fail: `Ok(T)` holds the value, `Err(E)` the error.\n\n    `?` on a `Result` "
    "returns an `Err` from the enclosing function. In `std` after `import std;`,\n    unqualified, as are "
    "its variants.\n\u{1f}\u{1e}std::core\u{1f}AllocError\u{1f}struct\u{1f}export struct AllocError\u{1f}The error `allocate` returns wh"
    "en memory cannot be had; it carries nothing.\u{1f}\u{1f}export struct AllocError\n    in `std::core`\n\n    The e"
    "rror `allocate` returns when memory cannot be had; it carries nothing.\n\u{1f}\u{1e}std::core\u{1f}Option::unwrap_or"
    "\u{1f}fn\u{1f}export fn Option::unwrap_or<T>(Option<T> o, T d) : T\u{1f}The value in `o`, or `d` when `o` is `None`"
    ".\u{1f}\u{1f}export fn Option::unwrap_or<T>(Option<T> o, T d) : T\n    in `std::core`\n\n    The value in `o`, or"
    " `d` when `o` is `None`.\n\n    An unused `d` is destroyed at the call's end.\n\u{1f}\u{1e}std::core\u{1f}Option::ok_o"
    "r\u{1f}fn\u{1f}export fn Option::ok_or<T, E>(Option<T> o, E e) : Result<T, E>\u{1f}`o` as a `Result`: `Ok` of its v"
    "alue, or `Err(e)` when `o` is `None`, so `?` applies.\u{1f}\u{1f}export fn Option::ok_or<T, E>(Option<T> o, E "
    "e) : Result<T, E>\n    in `std::core`\n\n    `o` as a `Result`: `Ok` of its value, or `Err(e)` when `o`"
    " is `None`, so `?` applies.\n\n    `e` is evaluated before the call; unused, it ends with the statemen"
    "t.\n\n    Example, \"Option::ok_or: None becomes the error\":\n        Option<i32> none = None;\n        R"
    "esult<i32, u8> r = Option::ok_or(none, 7);\n        match (r)\n        {\n            Ok(_)  : assert(f"
    "alse),\n            Err(e) : assert(e == 7),\n        }\n        assert(Result::is_ok(&Option::ok_or(So"
    "me(5), 7)));\n\u{1f}\u{1e}std::core\u{1f}Result::ok\u{1f}fn\u{1f}export fn Result::ok<T, E>(Result<T, E> r) : Option<T>\u{1f}The va"
    "lue in `r` as an `Option`: `Some` of it, or `None` when `r` is `Err`.\u{1f}\u{1f}export fn Result::ok<T, E>(Re"
    "sult<T, E> r) : Option<T>\n    in `std::core`\n\n    The value in `r` as an `Option`: `Some` of it, or "
    "`None` when `r` is `Err`.\n\n    The error, if any, is destroyed at the call's end.\n\n    Example, \"Res"
    "ult::ok: dropping the error\":\n        Result<i32, u8> bad = Err(4);\n        assert(Result::unwrap_or"
    "(bad, 0) == 0);\n        Result<i32, u8> good = Ok(9);\n        Option<i32> o = Result::ok(good);\n    "
    "    assert(Option::is_some(&o) && Option::unwrap(o) == 9);\n\u{1f}\u{1e}std::core\u{1f}Result::unwrap_or\u{1f}fn\u{1f}export f"
    "n Result::unwrap_or<T, E>(Result<T, E> r, T d) : T\u{1f}The value in `r`, or `d` when `r` is `Err`.\u{1f}\u{1f}expo"
    "rt fn Result::unwrap_or<T, E>(Result<T, E> r, T d) : T\n    in `std::core`\n\n    The value in `r`, or "
    "`d` when `r` is `Err`.\n\n    An unused `d` or error is destroyed at the call's end.\n\u{1f}\u{1e}std::core\u{1f}Optio"
    "n::unwrap\u{1f}fn\u{1f}export fn Option::unwrap<T>(Option<T> o) : T\u{1f}The value in `o`.\u{1f}\u{1f}export fn Option::unwra"
    "p<T>(Option<T> o) : T\n    in `std::core`\n\n    The value in `o`.\n\n    Faults (`unwrap_failed`) when `"
    "o` is `None`. `Option::expect` gives the fault a message of your own;\n    `Option::unwrap_or` gives "
    "a default instead.\n\u{1f}\u{1e}std::core\u{1f}Option::expect\u{1f}fn\u{1f}export fn Option::expect<T>(Option<T> o, str messag"
    "e) : T\u{1f}The value in `o`, faulting with `message` when there is none.\u{1f}\u{1f}export fn Option::expect<T>(Op"
    "tion<T> o, str message) : T\n    in `std::core`\n\n    The value in `o`, faulting with `message` when t"
    "here is none.\n\n    Faults (`unwrap_failed`, showing `message`) when `o` is `None`.\n\u{1f}\u{1e}std::core\u{1f}Resul"
    "t::unwrap\u{1f}fn\u{1f}export fn Result::unwrap<T, E>(Result<T, E> r) : T\u{1f}The value in `r`.\u{1f}\u{1f}export fn Result:"
    ":unwrap<T, E>(Result<T, E> r) : T\n    in `std::core`\n\n    The value in `r`.\n\n    Faults (`unwrap_fai"
    "led`) when `r` is `Err`; the error's payload is destroyed. `Result::expect` gives the\n    fault a me"
    "ssage of your own.\n\u{1f}\u{1e}std::core\u{1f}Result::expect\u{1f}fn\u{1f}export fn Result::expect<T, E>(Result<T, E> r, str "
    "message) : T\u{1f}The value in `r`, faulting with `message` when `r` is an error.\u{1f}\u{1f}export fn Result::expe"
    "ct<T, E>(Result<T, E> r, str message) : T\n    in `std::core`\n\n    The value in `r`, faulting with `m"
    "essage` when `r` is an error.\n\n    Faults (`unwrap_failed`, showing `message`) when `r` is `Err`; th"
    "e error's payload is destroyed.\n\u{1f}\u{1e}std::core\u{1f}Option::is_some\u{1f}fn\u{1f}export fn Option::is_some<T>(ref<Opti"
    "on<T>, shared> o) : bool\u{1f}Whether `o` is `Some`, without consuming it.\u{1f}\u{1f}export fn Option::is_some<T>("
    "ref<Option<T>, shared> o) : bool\n    in `std::core`\n\n    Whether `o` is `Some`, without consuming it"
    ".\n\u{1f}\u{1e}std::core\u{1f}Option::is_none\u{1f}fn\u{1f}export fn Option::is_none<T>(ref<Option<T>, shared> o) : bool\u{1f}Wheth"
    "er `o` is `None`, without consuming it.\u{1f}\u{1f}export fn Option::is_none<T>(ref<Option<T>, shared> o) : bo"
    "ol\n    in `std::core`\n\n    Whether `o` is `None`, without consuming it.\n\u{1f}\u{1e}std::core\u{1f}Result::is_ok\u{1f}fn"
    "\u{1f}export fn Result::is_ok<T, E>(ref<Result<T, E>, shared> r) : bool\u{1f}Whether `r` is `Ok`, without cons"
    "uming it.\u{1f}\u{1f}export fn Result::is_ok<T, E>(ref<Result<T, E>, shared> r) : bool\n    in `std::core`\n\n   "
    " Whether `r` is `Ok`, without consuming it.\n\u{1f}\u{1e}std::core\u{1f}Result::is_err\u{1f}fn\u{1f}export fn Result::is_err<T"
    ", E>(ref<Result<T, E>, shared> r) : bool\u{1f}Whether `r` is `Err`, without consuming it.\u{1f}\u{1f}export fn Resu"
    "lt::is_err<T, E>(ref<Result<T, E>, shared> r) : bool\n    in `std::core`\n\n    Whether `r` is `Err`, w"
    "ithout consuming it.\n\u{1f}\u{1e}std::core\u{1f}swap\u{1f}fn\u{1f}export fn swap<T>(ref<T, exclusive> a, ref<T, exclusive> b)"
    "\u{1f}Exchanges the values behind `a` and `b`.\u{1f}\u{1f}export fn swap<T>(ref<T, exclusive> a, ref<T, exclusive> "
    "b)\n    in `std::core`\n\n    Exchanges the values behind `a` and `b`.\n\n    A program cannot move a val"
    "ue out of a place it reaches through a reference, so it cannot exchange two\n    fields of a borrowed"
    " struct itself; this does. Nothing is copied or destroyed: a resource is now owned by\n    the place "
    "it is in. Each place is written as `*a = v` would write it: a live reference that conflicts with\n   "
    " either one, such as a shared reborrow of `*a`, makes the exchange fault. For two elements of one `V"
    "ec` or\n    slice, use `Vec::swap` or `slice_swap`, which check the bounds and allow `i == j`.\n\u{1f}\u{1e}std:"
    ":core\u{1f}replace\u{1f}fn\u{1f}export fn replace<T>(ref<T, exclusive> r, T v) : T\u{1f}Puts `v` in `*r` and returns wha"
    "t was there.\u{1f}\u{1f}export fn replace<T>(ref<T, exclusive> r, T v) : T\n    in `std::core`\n\n    Puts `v` in"
    " `*r` and returns what was there.\n\n    `swap` with a fresh value. `overwrite` destroys the old value"
    " instead of returning it.\n\n    Example, \"replace: the old value comes back\":\n        i32 a = 1;\n    "
    "    i32 old = replace(&mut a, 2);\n        assert(old == 1 && a == 2);\n        i32 b = 3;\n        swa"
    "p(&mut a, &mut b);\n        assert(a == 3 && b == 2);\n\u{1f}\u{1e}std::core\u{1f}overwrite\u{1f}fn\u{1f}export fn overwrite<T>"
    "(ref<T, exclusive> r, T v)\u{1f}Puts `v` in `*r` and destroys what was there, at the call.\u{1f}\u{1f}export fn ove"
    "rwrite<T>(ref<T, exclusive> r, T v)\n    in `std::core`\n\n    Puts `v` in `*r` and destroys what was t"
    "here, at the call.\n\n    The way to assign over a place that holds a resource, which plain assignment"
    " refuses.\n\u{1f}\u{1e}std::collections\u{1f}Vec\u{1f}struct\u{1f}export resource struct Vec<T>\u{1f}A growable array of `T`, ownin"
    "g its elements.\u{1f}\u{1f}export resource struct Vec<T>\n    in `std::collections`\n\n    A growable array of `T"
    "`, owning its elements.\n\n    `v[i]` reads or writes element `i` (`index_out_of_bounds` past the end)"
    ", `&v[lo..hi]` is a slice of it,\n    and `foreach` visits it by value, `&v` or `&mut v`. A reference"
    " to an element is stale after a `push`\n    that reallocates. Dropping a `Vec` destroys its elements,"
    " first to last, then frees its buffer.\n\u{1f}\u{1e}std::collections\u{1f}Vec::new\u{1f}fn\u{1f}export fn Vec::new<T>() : Vec<"
    "T>\u{1f}A new, empty `Vec`; nothing is allocated until it first grows.\u{1f}\u{1f}export fn Vec::new<T>() : Vec<T>\n"
    "    in `std::collections`\n\n    A new, empty `Vec`; nothing is allocated until it first grows.\n\u{1f}\u{1e}std:"
    ":collections\u{1f}Vec::len\u{1f}fn\u{1f}export fn Vec::len<T>(ref<Vec<T>, shared> v) : usize\u{1f}The number of elements"
    " in `v`.\u{1f}\u{1f}export fn Vec::len<T>(ref<Vec<T>, shared> v) : usize\n    in `std::collections`\n\n    The nu"
    "mber of elements in `v`.\n\u{1f}\u{1e}std::collections\u{1f}Vec::push\u{1f}fn\u{1f}export fn Vec::push<T>(ref<Vec<T>, exclusiv"
    "e> v, T x)\u{1f}Appends `x` to the end of `v`.\u{1f}\u{1f}export fn Vec::push<T>(ref<Vec<T>, exclusive> v, T x)\n   "
    " in `std::collections`\n\n    Appends `x` to the end of `v`.\n\n    Amortised constant time: when the bu"
    "ffer is full it is reallocated at twice its capacity, and references\n    to elements held across tha"
    "t are stale at their next use. Faults (`alloc_failure`) when memory runs out.\n\u{1f}\u{1e}std::collections\u{1f}Vec"
    "::pop\u{1f}fn\u{1f}export fn Vec::pop<T>(ref<Vec<T>, exclusive> v) : Option<T>\u{1f}Removes the last element of `v`"
    " and returns it; `None` when `v` is empty.\u{1f}\u{1f}export fn Vec::pop<T>(ref<Vec<T>, exclusive> v) : Option"
    "<T>\n    in `std::collections`\n\n    Removes the last element of `v` and returns it; `None` when `v` i"
    "s empty.\n\u{1f}\u{1e}std::collections\u{1f}Vec::index_shared\u{1f}fn\u{1f}export fn Vec::index_shared<T>(ref<Vec<T>, shared> "
    "v, usize i) : ref<T, shared>\u{1f}The element at index `i` of `v`, as a shared reference; what `v[i]` rea"
    "ds, so programs write `v[i]`.\u{1f}\u{1f}export fn Vec::index_shared<T>(ref<Vec<T>, shared> v, usize i) : ref<"
    "T, shared>\n    in `std::collections`\n    requires\n        i < v.len, index_out_of_bounds\n\n    The el"
    "ement at index `i` of `v`, as a shared reference; what `v[i]` reads, so programs write `v[i]`.\n\n    "
    "Faults (`index_out_of_bounds`) when `i >= len`.\n\u{1f}\u{1e}std::collections\u{1f}Vec::index_exclusive\u{1f}fn\u{1f}export fn"
    " Vec::index_exclusive<T>(ref<Vec<T>, exclusive> v, usize i) : ref<T, exclusive>\u{1f}The element at index"
    " `i` of `v`, as an exclusive reference; what `v[i]` is when it is written, so programs write `v[i]`."
    "\u{1f}\u{1f}export fn Vec::index_exclusive<T>(ref<Vec<T>, exclusive> v, usize i) : ref<T, exclusive>\n    in `s"
    "td::collections`\n    requires\n        i < v.len, index_out_of_bounds\n\n    The element at index `i` o"
    "f `v`, as an exclusive reference; what `v[i]` is when it is written, so\n    programs write `v[i]`.\n\n"
    "    Faults (`index_out_of_bounds`) when `i >= len`. A live slice of `v` holding `i` conflicts with i"
    "t.\n\u{1f}\u{1e}std::collections\u{1f}Vec::reserve\u{1f}fn\u{1f}export fn Vec::reserve<T>(ref<Vec<T>, exclusive> v, usize n)\u{1f}M"
    "akes room for `n` more elements: afterwards the capacity is at least `len + n`.\u{1f}\u{1f}export fn Vec::rese"
    "rve<T>(ref<Vec<T>, exclusive> v, usize n)\n    in `std::collections`\n\n    Makes room for `n` more ele"
    "ments: afterwards the capacity is at least `len + n`.\n\n    Grows at most once, to the larger of `len"
    " + n` and twice the capacity, so small reserves in a loop stay\n    amortised; never shrinks and neve"
    "r changes the length or the elements. It changes only how fast a\n    program runs. `len + n` overflo"
    "wing is `diag.arith-overflow`, before anything is allocated.\n\u{1f}\u{1e}std::collections\u{1f}Vec::drop\u{1f}fn\u{1f}export "
    "fn Vec::drop<T>(ref<Vec<T>, exclusive> self)\u{1f}Destroys every element of `self`, first to last, then f"
    "rees the buffer; the destructor run when a `Vec` goes out of scope, not called by programs.\u{1f}\u{1f}export "
    "fn Vec::drop<T>(ref<Vec<T>, exclusive> self)\n    in `std::collections`\n\n    Destroys every element o"
    "f `self`, first to last, then frees the buffer; the destructor run when a `Vec`\n    goes out of scop"
    "e, not called by programs.\n\u{1f}\u{1e}std::collections\u{1f}Vec::sort_by\u{1f}fn\u{1f}export fn Vec::sort_by<T>(ref<Vec<T>, "
    "exclusive> v, fn(ref<T, shared>, ref<T, shared>) : bool less)\u{1f}Sorts `v` by `less`, which is true whe"
    "n its first argument goes before its second.\u{1f}\u{1f}export fn Vec::sort_by<T>(ref<Vec<T>, exclusive> v, fn"
    "(ref<T, shared>, ref<T, shared>) : bool less)\n    in `std::collections`\n\n    Sorts `v` by `less`, wh"
    "ich is true when its first argument goes before its second.\n\n    Stable: equal elements (neither bef"
    "ore the other) keep their order. Each element moves once.\n    `less` must be a strict weak order (ne"
    "ver `less(a, a)`, transitive); with one that is not, the elements\n    end as a permutation of what t"
    "hey were, in an unspecified order. For a key type `Vec::sort` needs no\n    `less`.\n\n    Example, \"Ve"
    "c::sort_by: stable\":\n        Vec<i32> v = Vec::new();\n        Vec::push(&mut v, 13);\n        Vec::pu"
    "sh(&mut v, 21);\n        Vec::push(&mut v, 12);\n        Vec::push(&mut v, 25);\n        Vec::sort_by(&"
    "mut v, [](ref<i32, shared> a, ref<i32, shared> b) : bool { *a / 10 < *b / 10 });\n        assert(v[0]"
    " == 13 && v[1] == 12 && v[2] == 21 && v[3] == 25);\n\u{1f}\u{1e}std::collections\u{1f}Vec::sort\u{1f}fn\u{1f}export fn Vec::so"
    "rt<T>(ref<Vec<T>, exclusive> v)\u{1f}Sorts `v` in its elements' own order, keeping equal elements in thei"
    "r order.\u{1f}\u{1f}export fn Vec::sort<T>(ref<Vec<T>, exclusive> v)\n    in `std::collections`\n\n    Sorts `v` "
    "in its elements' own order, keeping equal elements in their order.\n\n    `T` must be a key type: inte"
    "gers by value, `false` before `true`, `str` and `String` by their bytes (a\n    prefix first), a stru"
    "ct field by field, an enum by the order its variants are declared in, then by\n    payload. `f32` and"
    " `f64` sort too (`[Sort-Float]`): by value, `-0.0` and `0.0` as equal, every NaN\n    after every oth"
    "er value. Any other `T` is rejected at compile time; use `Vec::sort_by` for those.\n\u{1f}\u{1e}std::collection"
    "s\u{1f}Vec::binary_search_by\u{1f}fn\u{1f}export fn Vec::binary_search_by<T>(ref<Vec<T>, shared> v, ref<T, shared> "
    "key, fn(ref<T, shared>, ref<T, shared>) : bool less) : Result<usize, usize>\u{1f}Searches `v`, sorted by "
    "`less`, for `key`.\u{1f}\u{1f}export fn Vec::binary_search_by<T>(ref<Vec<T>, shared> v, ref<T, shared> key, fn"
    "(ref<T, shared>, ref<T, shared>) : bool less) : Result<usize, usize>\n    in `std::collections`\n\n    "
    "Searches `v`, sorted by `less`, for `key`.\n\n    Returns `Ok(i)` with `i` the first position whose el"
    "ement is equal to `key` (neither goes before the\n    other), or `Err(i)` with `i` the position where"
    " `key` would be inserted to keep `v` sorted. `v` must be\n    sorted by the same `less`, or the resul"
    "t is unspecified.\n\u{1f}\u{1e}std::collections\u{1f}Vec::binary_search\u{1f}fn\u{1f}export fn Vec::binary_search<T>(ref<Vec<T"
    ">, shared> v, probe<T> key) : Result<usize, usize>\u{1f}Searches `v`, sorted in its elements' own order, "
    "for `key`.\u{1f}\u{1f}export fn Vec::binary_search<T>(ref<Vec<T>, shared> v, probe<T> key) : Result<usize, usi"
    "ze>\n    in `std::collections`\n\n    Searches `v`, sorted in its elements' own order, for `key`.\n\n    "
    "`T` a key type or a float, as for `Vec::sort`. `Ok(i)` for the first position holding an element equ"
    "al to `key`,\n    otherwise `Err(i)`, the position where `key` would go.\n\n    Example, \"Vec::binary_s"
    "earch: found and missing\":\n        Vec<i32> v = Vec::new();\n        Vec::push(&mut v, 10);\n        V"
    "ec::push(&mut v, 20);\n        Vec::push(&mut v, 20);\n        Vec::push(&mut v, 30);\n        i32 pres"
    "ent = 20;\n        i32 absent = 25;\n        assert(Result::unwrap_or(Vec::binary_search(&v, present),"
    " 99) == 1);\n        match (Vec::binary_search(&v, absent))\n        {\n            Ok(_)  : assert(fal"
    "se),\n            Err(i) : assert(i == 3),\n        }\n\u{1f}\u{1e}std::collections\u{1f}Vec::clear\u{1f}fn\u{1f}export fn Vec::"
    "clear<T>(ref<Vec<T>, exclusive> v)\u{1f}Removes every element of `v`, destroying them first to last; the "
    "buffer is kept for reuse.\u{1f}\u{1f}export fn Vec::clear<T>(ref<Vec<T>, exclusive> v)\n    in `std::collection"
    "s`\n\n    Removes every element of `v`, destroying them first to last; the buffer is kept for reuse.\n\u{1f}"
    "\u{1e}std::collections\u{1f}Vec::insert\u{1f}fn\u{1f}export fn Vec::insert<T>(ref<Vec<T>, exclusive> v, usize i, T x)\u{1f}In"
    "serts `x` at index `i`, moving the elements from `i` on up by one.\u{1f}\u{1f}export fn Vec::insert<T>(ref<Vec"
    "<T>, exclusive> v, usize i, T x)\n    in `std::collections`\n    requires\n        i <= v.len, index_ou"
    "t_of_bounds\n\n    Inserts `x` at index `i`, moving the elements from `i` on up by one.\n\n    `i` may e"
    "qual `len`, which appends. Faults (`index_out_of_bounds`) when `i > len`. Linear in the number\n    o"
    "f elements after `i`; no element is copied.\n\n    Example, \"Vec::insert: middle and end\":\n        Vec"
    "<i32> v = Vec::new();\n        Vec::push(&mut v, 1);\n        Vec::push(&mut v, 3);\n        Vec::inser"
    "t(&mut v, 1, 2);\n        Vec::insert(&mut v, 3, 4);\n        assert(Vec::len(&v) == 4);\n        asser"
    "t(v[0] == 1 && v[1] == 2 && v[2] == 3 && v[3] == 4);\n\u{1f}\u{1e}std::collections\u{1f}Vec::remove\u{1f}fn\u{1f}export fn Vec"
    "::remove<T>(ref<Vec<T>, exclusive> v, usize i) : T\u{1f}Removes the element at index `i` and returns it, "
    "moving the elements after it down by one.\u{1f}\u{1f}export fn Vec::remove<T>(ref<Vec<T>, exclusive> v, usize "
    "i) : T\n    in `std::collections`\n    requires\n        i < v.len, index_out_of_bounds\n\n    Removes th"
    "e element at index `i` and returns it, moving the elements after it down by one.\n\n    Keeps the orde"
    "r and takes time linear in the elements after `i`; `Vec::swap_remove` takes constant time\n    but do"
    "es not keep the order. Faults (`index_out_of_bounds`) when `i >= len`.\n\u{1f}\u{1e}std::collections\u{1f}Vec::swap_"
    "remove\u{1f}fn\u{1f}export fn Vec::swap_remove<T>(ref<Vec<T>, exclusive> v, usize i) : T\u{1f}Removes the element a"
    "t index `i` and returns it, moving the last element into its place.\u{1f}\u{1f}export fn Vec::swap_remove<T>(r"
    "ef<Vec<T>, exclusive> v, usize i) : T\n    in `std::collections`\n    requires\n        i < v.len, inde"
    "x_out_of_bounds\n\n    Removes the element at index `i` and returns it, moving the last element into i"
    "ts place.\n\n    Constant time, but the order is not kept; `Vec::remove` keeps it. Faults (`index_out_"
    "of_bounds`) when\n    `i >= len`.\n\n    Example, \"Vec::swap_remove: order not kept\":\n        Vec<i32> "
    "a = Vec::new();\n        Vec::push(&mut a, 1);\n        Vec::push(&mut a, 2);\n        Vec::push(&mut a"
    ", 3);\n        Vec::push(&mut a, 4);\n        Vec<i32> b = Vec::clone(&a);\n        assert(Vec::remove("
    "&mut a, 0) == 1);\n        assert(a[0] == 2 && a[1] == 3 && a[2] == 4);\n        assert(Vec::swap_remo"
    "ve(&mut b, 0) == 1);\n        assert(b[0] == 4 && b[1] == 2 && b[2] == 3);\n\u{1f}\u{1e}std::collections\u{1f}Vec::cl"
    "one\u{1f}fn\u{1f}export fn Vec::clone<T: clone>(ref<Vec<T>, shared> v) : Vec<T>\u{1f}A new `Vec` holding a copy of "
    "each element of `v`, in order.\u{1f}\u{1f}export fn Vec::clone<T: clone>(ref<Vec<T>, shared> v) : Vec<T>\n    i"
    "n `std::collections`\n\n    A new `Vec` holding a copy of each element of `v`, in order.\n\n    `T` must"
    " be `clone` (owning nothing); for other element types use `Vec::clone_by`.\n\u{1f}\u{1e}std::collections\u{1f}Vec::f"
    "rom_slice\u{1f}fn\u{1f}export fn Vec::from_slice<T: clone>(slice<T, shared> s) : Vec<T>\u{1f}A new `Vec` holding a "
    "copy of each element of `s`, in order.\u{1f}\u{1f}export fn Vec::from_slice<T: clone>(slice<T, shared> s) : Ve"
    "c<T>\n    in `std::collections`\n\n    A new `Vec` holding a copy of each element of `s`, in order.\n\n  "
    "  `T` must be `clone`. The buffer is allocated once, at the slice's length.\n\u{1f}\u{1e}std::collections\u{1f}Vec::"
    "truncate\u{1f}fn\u{1f}export fn Vec::truncate<T>(ref<Vec<T>, exclusive> v, usize n)\u{1f}Keeps the first `n` elemen"
    "ts of `v` and destroys the rest, last first.\u{1f}\u{1f}export fn Vec::truncate<T>(ref<Vec<T>, exclusive> v, u"
    "size n)\n    in `std::collections`\n\n    Keeps the first `n` elements of `v` and destroys the rest, la"
    "st first.\n\n    `n` at or beyond the length leaves `v` unchanged.\n\n    Example, \"Vec::truncate: beyon"
    "d the end\":\n        Vec<i32> v = Vec::filled(3, 7);\n        Vec::truncate(&mut v, 10);\n        asser"
    "t(Vec::len(&v) == 3);\n        Vec::truncate(&mut v, 1);\n        assert(Vec::len(&v) == 1);\n\u{1f}\u{1e}std::co"
    "llections\u{1f}Vec::clone_by\u{1f}fn\u{1f}export fn Vec::clone_by<T>(ref<Vec<T>, shared> v, fn(ref<T, shared>) : T "
    "copy) : Vec<T>\u{1f}A new `Vec` holding `copy(&x)` for each element `x` of `v`, in order.\u{1f}\u{1f}export fn Vec:"
    ":clone_by<T>(ref<Vec<T>, shared> v, fn(ref<T, shared>) : T copy) : Vec<T>\n    in `std::collections`\n"
    "\n    A new `Vec` holding `copy(&x)` for each element `x` of `v`, in order.\n\n    For element types th"
    "at are not `clone`; `copy` makes each new element.\n\u{1f}\u{1e}std::collections\u{1f}Vec::filled\u{1f}fn\u{1f}export fn Vec::"
    "filled<T: clone>(usize n, T x) : Vec<T>\u{1f}A new `Vec` of `n` copies of `x`.\u{1f}\u{1f}export fn Vec::filled<T: "
    "clone>(usize n, T x) : Vec<T>\n    in `std::collections`\n\n    A new `Vec` of `n` copies of `x`.\n\n    "
    "`T` must be `clone`; `Vec::from_fn` builds elements that are not.\n\u{1f}\u{1e}std::collections\u{1f}Vec::from_raw\u{1f}f"
    "n\u{1f}export fn Vec::from_raw<T: plain>(rawptr<T> p, usize n) : Vec<T>\u{1f}`n` elements of plain data copied"
    " from C memory into a `Vec`: a buffer a C caller owns, taken as a value the checks then cover (D-025"
    "7).\u{1f}\u{1f}export fn Vec::from_raw<T: plain>(rawptr<T> p, usize n) : Vec<T>\n    in `std::collections`\n    "
    "requires\n        n == 0 || p != null_rawptr<T>(), null_pointer\n\n    `n` elements of plain data copie"
    "d from C memory into a `Vec`: a buffer a\n    C caller owns, taken as a value the checks then cover ("
    "D-0257). Called\n    inside `unsafe { }` (`[Trusted-Call]`): the caller vouches that the `n`\n    elem"
    "ents at `p` are readable and stay put for the call.\n\u{1f}\u{1e}std::collections\u{1f}Vec::from_c_bytes\u{1f}fn\u{1f}export f"
    "n Vec::from_c_bytes(rawptr<u8> p) : Vec<u8>\u{1f}A copy of the bytes C's text at `p` holds, up to and wit"
    "hout its NUL.\u{1f}\u{1f}export fn Vec::from_c_bytes(rawptr<u8> p) : Vec<u8>\n    in `std::collections`\n    req"
    "uires\n        p != null_rawptr<u8>(), null_pointer\n\n    A copy of the bytes C's text at `p` holds, u"
    "p to and without its NUL.\n\n    Called only inside `unsafe`: `p` must point at readable bytes ending "
    "in a NUL, as a C function's `char *`\n    result does. A null `p` faults (`null_pointer`); test with "
    "`is_null` first when C may return `NULL`.\n    `String::from_c` also checks that the bytes are UTF-8."
    "\n\u{1f}\u{1e}std::collections\u{1f}Vec::from_fn\u{1f}fn\u{1f}export fn Vec::from_fn<T>(usize n, fn(usize) : T f) : Vec<T>\u{1f}A n"
    "ew `Vec` of `f(0), f(1), …, f(n - 1)`, called in that order.\u{1f}\u{1f}export fn Vec::from_fn<T>(usize n, f"
    "n(usize) : T f) : Vec<T>\n    in `std::collections`\n\n    A new `Vec` of `f(0), f(1), …, f(n - 1)`, "
    "called in that order.\n\n    Works for any `T`, including resources.\n\n    Example, \"Vec::from_fn: with"
    " retain\":\n        Vec<i32> v = Vec::from_fn(6, [](usize i) : i32 { narrow<i32>(i) });\n        Vec::r"
    "etain(&mut v, [](ref<i32, shared> x) : bool { *x % 2 == 0 });\n        assert(Vec::len(&v) == 3);\n   "
    "     assert(v[0] == 0 && v[1] == 2 && v[2] == 4);\n\u{1f}\u{1e}std::collections\u{1f}Vec::append\u{1f}fn\u{1f}export fn Vec::a"
    "ppend<T>(ref<Vec<T>, exclusive> a, Vec<T> b)\u{1f}Moves every element of `b` onto the end of `a`, in orde"
    "r; `b` is consumed.\u{1f}\u{1f}export fn Vec::append<T>(ref<Vec<T>, exclusive> a, Vec<T> b)\n    in `std::colle"
    "ctions`\n\n    Moves every element of `b` onto the end of `a`, in order; `b` is consumed.\n\u{1f}\u{1e}std::colle"
    "ctions\u{1f}Vec::extend_from\u{1f}fn\u{1f}export fn Vec::extend_from<T: clone>(ref<Vec<T>, exclusive> a, slice<T, s"
    "hared> s)\u{1f}Appends a copy of each element of `s` to the end of `a`, in order.\u{1f}\u{1f}export fn Vec::extend_"
    "from<T: clone>(ref<Vec<T>, exclusive> a, slice<T, shared> s)\n    in `std::collections`\n\n    Appends "
    "a copy of each element of `s` to the end of `a`, in order.\n\n    `T` must be `clone`. A slice of `a` "
    "itself is rejected (`diag.aliasing-conflict`).\n\u{1f}\u{1e}std::collections\u{1f}Vec::position\u{1f}fn\u{1f}export fn Vec::po"
    "sition<T>(ref<Vec<T>, shared> v, fn(ref<T, shared>) : bool p) : Option<usize>\u{1f}The index of the first"
    " element for which `p` returns true; `None` when there is none.\u{1f}\u{1f}export fn Vec::position<T>(ref<Vec<"
    "T>, shared> v, fn(ref<T, shared>) : bool p) : Option<usize>\n    in `std::collections`\n\n    The index"
    " of the first element for which `p` returns true; `None` when there is none.\n\n    `p` is called in i"
    "ndex order and not past the first hit. `Vec::index_of` looks for an equal element.\n\n    Example, \"Ve"
    "c::position: first match\":\n        Vec<i32> v = Vec::new();\n        Vec::push(&mut v, 4);\n        Ve"
    "c::push(&mut v, 9);\n        Vec::push(&mut v, 6);\n        assert(Option::unwrap(Vec::position(&v, []"
    "(ref<i32, shared> x) : bool { *x > 5 })) == 1);\n        i32 six = 6;\n        assert(Option::unwrap(V"
    "ec::index_of(&v, six)) == 2);\n        assert(Option::is_none(&Vec::position(&v, [](ref<i32, shared> "
    "x) : bool { *x > 9 })));\n\u{1f}\u{1e}std::collections\u{1f}Vec::any\u{1f}fn\u{1f}export fn Vec::any<T>(ref<Vec<T>, shared> v,"
    " fn(ref<T, shared>) : bool p) : bool\u{1f}Whether `p` returns true for some element; `false` for an empty"
    " `Vec`.\u{1f}\u{1f}export fn Vec::any<T>(ref<Vec<T>, shared> v, fn(ref<T, shared>) : bool p) : bool\n    in `st"
    "d::collections`\n\n    Whether `p` returns true for some element; `false` for an empty `Vec`.\n\n    `p`"
    " is called in index order and not past the first element for which it returns true (D-0325).\n\u{1f}\u{1e}std::"
    "collections\u{1f}Vec::all\u{1f}fn\u{1f}export fn Vec::all<T>(ref<Vec<T>, shared> v, fn(ref<T, shared>) : bool p) : "
    "bool\u{1f}Whether `p` returns true for every element; `true` for an empty `Vec`.\u{1f}\u{1f}export fn Vec::all<T>(r"
    "ef<Vec<T>, shared> v, fn(ref<T, shared>) : bool p) : bool\n    in `std::collections`\n\n    Whether `p`"
    " returns true for every element; `true` for an empty `Vec`.\n\n    `p` is called in index order and no"
    "t past the first element for which it returns false (D-0325).\n\u{1f}\u{1e}std::collections\u{1f}Vec::count\u{1f}fn\u{1f}expor"
    "t fn Vec::count<T>(ref<Vec<T>, shared> v, fn(ref<T, shared>) : bool p) : usize\u{1f}The number of element"
    "s for which `p` returns true.\u{1f}\u{1f}export fn Vec::count<T>(ref<Vec<T>, shared> v, fn(ref<T, shared>) : b"
    "ool p) : usize\n    in `std::collections`\n\n    The number of elements for which `p` returns true.\n\n  "
    "  `p` is called once for each element, in index order (D-0325). `Vec::len` is the number of all of t"
    "hem.\n\n    Example, \"Vec::any, Vec::all, Vec::count\":\n        Vec<i32> v = Vec::new();\n        Vec::p"
    "ush(&mut v, 4);\n        Vec::push(&mut v, 9);\n        Vec::push(&mut v, 6);\n        assert(Vec::any("
    "&v, [](ref<i32, shared> x) : bool { *x > 5 }));\n        assert(!Vec::all(&v, [](ref<i32, shared> x) "
    ": bool { *x > 5 }));\n        assert(Vec::count(&v, [](ref<i32, shared> x) : bool { *x > 5 }) == 2);\n"
    "        Vec<i32> none = Vec::new();\n        assert(!Vec::any(&none, [](ref<i32, shared> x) : bool { "
