    "] + 19) >> 51;\n    q = (h[1] + q) >> 51;\n    q = (h[2] + q) >> 51;\n    q = (h[3] + q) >> 51;\n    q ="
    " (h[4] + q) >> 51;\n    h[0] += 19 * q;\n    for (usize i = 0; i < 4; i += 1)\n    {\n        h[i + 1] +"
    "= h[i] >> 51;\n        h[i] = h[i] & FE_MASK;\n    }\n    h[4] = h[4] & FE_MASK;\n    array<u64, 4> w = "
    "[\n        h[0] | (h[1] << 51),\n        (h[1] >> 13) | (h[2] << 38),\n        (h[2] >> 26) | (h[3] << "
    "25),\n        (h[3] >> 39) | (h[4] << 12),\n    ];\n    array<u8, 32> out = [0; 32];\n    for (usize i ="
    " 0; i < 4; i += 1)\n    {\n        for (usize j = 0; j < 8; j += 1)\n        {\n            out[8 * i + "
    "j] = narrow_wrapping<u8>(w[i] >> narrow<u32>(8 * j));\n        }\n    }\n    out\n}fn x25519_ladder(slic"
    "e<u8, shared> scalar, slice<u8, shared> u) : array<u8, 32>\n{\n    array<u8, 32> k = [0; 32];\n    for "
    "(usize i = 0; i < 32; i += 1)\n    {\n        k[i] = scalar[i];\n    }\n    k[0] = k[0] & 248;\n    k[31]"
    " = (k[31] & 127) | 64;\n    array<u64, 5> x1 = fe_from_bytes(u);\n    array<u64, 5> x2 = [1, 0, 0, 0, "
    "0];\n    array<u64, 5> z2 = [0, 0, 0, 0, 0];\n    array<u64, 5> x3 = x1;\n    array<u64, 5> z3 = [1, 0,"
    " 0, 0, 0];\n    array<u64, 5> a24 = [121665, 0, 0, 0, 0];\n    u64 swap = 0;\n    for (usize step = 0; "
    "step < 255; step += 1)\n    {\n        usize t = 254 - step;\n        u64 bit = widen<u64>((k[t >> 3] >"
    "> narrow<u32>(t & 7)) & 1);\n        swap = swap ^ bit;\n        fe_cswap(&mut x2, &mut x3, swap);\n   "
    "     fe_cswap(&mut z2, &mut z3, swap);\n        swap = bit;\n        array<u64, 5> a = fe_add(x2, z2);"
    "\n        array<u64, 5> aa = fe_mul(a, a);\n        array<u64, 5> b = fe_sub(x2, z2);\n        array<u6"
    "4, 5> bb = fe_mul(b, b);\n        array<u64, 5> e = fe_sub(aa, bb);\n        array<u64, 5> c = fe_add("
    "x3, z3);\n        array<u64, 5> d = fe_sub(x3, z3);\n        array<u64, 5> da = fe_mul(d, a);\n        "
    "array<u64, 5> cb = fe_mul(c, b);\n        array<u64, 5> sum = fe_add(da, cb);\n        x3 = fe_mul(sum"
    ", sum);\n        array<u64, 5> diff = fe_sub(da, cb);\n        z3 = fe_mul(x1, fe_mul(diff, diff));\n  "
    "      x2 = fe_mul(aa, bb);\n        z2 = fe_mul(e, fe_add(aa, fe_mul(a24, e)));\n    }\n    fe_cswap(&m"
    "ut x2, &mut x3, swap);\n    fe_cswap(&mut z2, &mut z3, swap);\n    fe_to_bytes(fe_mul(x2, fe_invert(z2"
    ")))\n}export fn x25519(slice<u8, shared> private_key, slice<u8, shared> public_key) : Option<array<u8"
    ", 32>>\n{\n    if (slice_len(private_key) != 32 || slice_len(public_key) != 32)\n    {\n        fault(cr"
    "ypto_length);\n    }\n    array<u8, 32> shared = x25519_ladder(private_key, public_key);\n    u8 acc = "
    "0;\n    for (usize i = 0; i < 32; i += 1)\n    {\n        acc = acc | shared[i];\n    }\n    if (acc == 0"
    ")\n    {\n        return None;\n    }\n    Some(shared)\n}export fn x25519_public_key(slice<u8, shared> p"
    "rivate_key) : array<u8, 32>\n{\n    if (slice_len(private_key) != 32)\n    {\n        fault(crypto_lengt"
    "h);\n    }\n    array<u8, 32> base = [0; 32];\n    base[0] = 9;\n    x25519_ladder(private_key, &base)\n}"
    "export fn x25519_private_key() : array<u8, 32>\n{\n    array<u8, 32> k = [0; 32];\n    os_random_bytes("
    "&mut k);\n    k\n}fn rsa_open(ref<RsaPublicKey, shared> key, slice<u8, shared> signature, usize k) : O"
    "ption<Vec<u8>>\n{\n    BigUint s = BigUint::from_bytes_be(signature);\n    if (!BigUint::less(&s, &key."
    "n))\n    {\n        return None;\n    }\n    BigUint m = BigUint::mod_pow(&s, &key.e, &key.n);\n    if (B"
    "igUint::bit_len(&m) > 8 * k)\n    {\n        return None;\n    }\n    Some(BigUint::to_bytes_be_padded(&"
    "m, k))\n}fn digest_info_prefix(HashKind kind) : Vec<u8>\n{\n    Result::unwrap_or(from_hex(match (kind)"
    "\n    {\n        Sha1     : \"3021300906052b0e03021a05000414\",\n        Sha2_256 : \"3031300d060960864801"
    "650304020105000420\",\n        Sha2_384 : \"3041300d060960864801650304020205000430\",\n        Sha2_512 :"
    " \"3051300d060960864801650304020305000440\",\n    }), Vec::new())\n}export fn rsa_verify_pkcs1v15(\n    r"
    "ef<RsaPublicKey, shared> key,\n    HashKind kind,\n    slice<u8, shared> digest,\n    slice<u8, shared>"
    " signature,\n) : bool\n{\n    usize k = (BigUint::bit_len(&key.n) + 7) / 8;\n    if (slice_len(signature"
    ") != k || slice_len(digest) != hash_len(kind))\n    {\n        return false;\n    }\n    Vec<u8> prefix "
    "= digest_info_prefix(kind);\n    usize t_len = Vec::len(&prefix) + slice_len(digest);\n    if (k < t_l"
    "en + 11)\n    {\n        return false;\n    }\n    Vec<u8> want = Vec::new();\n    Vec::push(&mut want, 0"
    ");\n    Vec::push(&mut want, 1);\n    for (usize i = 0; i < k - t_len - 3; i += 1)\n    {\n        Vec::"
    "push(&mut want, 0xff);\n    }\n    Vec::push(&mut want, 0);\n    Vec::extend_from(&mut want, &prefix);\n"
    "    Vec::extend_from(&mut want, digest);\n    match (rsa_open(key, signature, k))\n    {\n        Some("
    "em) : digest_eq(&em, &want),\n        None     : false,\n    }\n}fn mgf1(HashKind kind, slice<u8, share"
    "d> seed, usize len) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n    u32 counter = 0;\n    while (Vec::l"
    "en(&out) < len)\n    {\n        Vec<u8> input = Vec::from_slice(seed);\n        Vec::push_be(&mut input"
    ", counter);\n        Vec<u8> h = hash(kind, &input);\n        for (usize i = 0; i < Vec::len(&h) && Ve"
    "c::len(&out) < len; i += 1)\n        {\n            Vec::push(&mut out, h[i]);\n        }\n        count"
    "er += 1;\n    }\n    out\n}export fn rsa_verify_pss(\n    ref<RsaPublicKey, shared> key,\n    HashKind ki"
    "nd,\n    slice<u8, shared> digest,\n    slice<u8, shared> signature,\n) : bool\n{\n    usize mod_bits = B"
    "igUint::bit_len(&key.n);\n    usize k = (mod_bits + 7) / 8;\n    usize h_len = hash_len(kind);\n    usi"
    "ze s_len = h_len;\n    if (slice_len(signature) != k || slice_len(digest) != h_len || mod_bits < 2)\n "
    "   {\n        return false;\n    }\n    usize em_bits = mod_bits - 1;\n    usize em_len = (em_bits + 7) "
    "/ 8;\n    if (em_len < h_len + s_len + 2)\n    {\n        return false;\n    }\n    Vec<u8> em = match (r"
    "sa_open(key, signature, em_len))\n    {\n        Some(e) : e,\n        None    : return false,\n    };\n "
    "   if (em[em_len - 1] != 0xbc)\n    {\n        return false;\n    }\n    usize db_len = em_len - h_len -"
    " 1;\n    u32 unused = narrow<u32>(8 * em_len - em_bits);\n    u8 top_mask = narrow_wrapping<u8>((0xff:"
    " u32) >> unused);\n    if ((em[0] & ~top_mask) != 0)\n    {\n        return false;\n    }\n    Vec<u8> db"
    "_mask = mgf1(kind, &em[db_len..db_len + h_len], db_len);\n    Vec<u8> db = Vec::new();\n    for (usize"
    " i = 0; i < db_len; i += 1)\n    {\n        Vec::push(&mut db, em[i] ^ db_mask[i]);\n    }\n    db[0] = "
    "db[0] & top_mask;\n    usize ps_len = em_len - h_len - s_len - 2;\n    for (usize i = 0; i < ps_len; i"
    " += 1)\n    {\n        if (db[i] != 0)\n        {\n            return false;\n        }\n    }\n    if (db["
    "ps_len] != 1)\n    {\n        return false;\n    }\n    Vec<u8> m2 = Vec::filled(8, 0: u8);\n    Vec::ext"
    "end_from(&mut m2, digest);\n    Vec::extend_from(&mut m2, &db[db_len - s_len..$]);\n    Vec<u8> h2 = h"
    "ash(kind, &m2);\n    digest_eq(&h2, &em[db_len..db_len + h_len])\n}fn field_of(EcCurve c, bool order) "
    ": Field\n{\n    match (c)\n    {\n        P256 : if (order)\n        {\n            Field { .m = [\n       "
    "         0xf3b9cac2fc632551,\n                0xbce6faada7179e84,\n                0xffffffffffffffff,"
    "\n                0xffffffff00000000,\n                0x0000000000000000,\n                0x000000000"
    "0000000,\n            ], .n = 4, .minv = 0xccd1c8aaee00bc4f, .r2 = [\n                0x83244c95be79ee"
    "a2,\n                0x4699799c49bd6fa6,\n                0x2845b2392b6bec59,\n                0x66e12d"
    "94f3d95620,\n                0x0000000000000000,\n                0x0000000000000000,\n            ] }\n"
    "        }\n        else\n        {\n            Field { .m = [\n                0xffffffffffffffff,\n    "
    "            0x00000000ffffffff,\n                0x0000000000000000,\n                0xffffffff000000"
    "01,\n                0x0000000000000000,\n                0x0000000000000000,\n            ], .n = 4, ."
    "minv = 0x0000000000000001, .r2 = [\n                0x0000000000000003,\n                0xfffffffbfff"
    "fffff,\n                0xfffffffffffffffe,\n                0x00000004fffffffd,\n                0x000"
    "0000000000000,\n                0x0000000000000000,\n            ] }\n        },\n        P384 : if (ord"
    "er)\n        {\n            Field { .m = [\n                0xecec196accc52973,\n                0x581a0"
    "db248b0a77a,\n                0xc7634d81f4372ddf,\n                0xffffffffffffffff,\n               "
    " 0xffffffffffffffff,\n                0xffffffffffffffff,\n            ], .n = 6, .minv = 0x6ed46089e8"
    "8fdc45, .r2 = [\n                0x2d319b2419b409a9,\n                0xff3d81e5df1aa419,\n            "
    "    0xbc3e483afcb82947,\n                0xd40d49174aab1cc5,\n                0x3fb05b7a28266895,\n    "
    "            0x0c84ee012b39bf21,\n            ] }\n        }\n        else\n        {\n            Field {"
    " .m = [\n                0x00000000ffffffff,\n                0xffffffff00000000,\n                0xff"
    "fffffffffffffe,\n                0xffffffffffffffff,\n                0xffffffffffffffff,\n            "
    "    0xffffffffffffffff,\n            ], .n = 6, .minv = 0x0000000100000001, .r2 = [\n                0"
    "xfffffffe00000001,\n                0x0000000200000000,\n                0xfffffffe00000000,\n         "
    "       0x0000000200000000,\n                0x0000000000000001,\n                0x0000000000000000,\n "
    "           ] }\n        },\n    }\n}fn mont_mul(ref<Field, shared> f, array<u64, 6> a, array<u64, 6> b)"
    " : array<u64, 6>\n{\n    usize n = f.n;\n    array<u64, 8> t = [0; 8];\n    for (usize i = 0; i < n; i +"
    "= 1)\n    {\n        u128 c = 0;\n        for (usize j = 0; j < n; j += 1)\n        {\n            u128 x"
    " = widen<u128>(t[j]) + widen<u128>(a[j]) * widen<u128>(b[i]) + c;\n            t[j] = narrow_wrapping"
    "<u64>(x);\n            c = x >> 64;\n        }\n        u128 y = widen<u128>(t[n]) + c;\n        t[n] = "
    "narrow_wrapping<u64>(y);\n        t[n + 1] = narrow_wrapping<u64>(y >> 64);\n        u64 k = wrapping_"
    "mul(t[0], f.minv);\n        u128 z = widen<u128>(t[0]) + widen<u128>(k) * widen<u128>(f.m[0]);\n      "
    "  c = z >> 64;\n        for (usize j = 1; j < n; j += 1)\n        {\n            u128 x = widen<u128>(t"
    "[j]) + widen<u128>(k) * widen<u128>(f.m[j]) + c;\n            t[j - 1] = narrow_wrapping<u64>(x);\n   "
    "         c = x >> 64;\n        }\n        u128 w = widen<u128>(t[n]) + c;\n        t[n - 1] = narrow_wr"
    "apping<u64>(w);\n        t[n] = t[n + 1] + narrow_wrapping<u64>(w >> 64);\n    }\n    array<u64, 6> r ="
    " [0; 6];\n    for (usize j = 0; j < n; j += 1)\n    {\n        r[j] = t[j];\n    }\n    // r - m unless r"
    " (with its carry t[n]) is below m: chosen by a mask.\n    Borrowed d = f_sub_borrow(f, r, f.m);\n    f"
    "_select(wrapping_sub(0, (1 - t[n]) & d.borrow), r, d.v)\n}fn f_less(ref<Field, shared> f, array<u64, "
    "6> a, array<u64, 6> b) : bool\n{\n    usize i = f.n;\n    while (i > 0)\n    {\n        i -= 1;\n        i"
    "f (a[i] != b[i])\n        {\n            return a[i] < b[i];\n        }\n    }\n    false\n}fn f_sub_borro"
    "w(ref<Field, shared> f, array<u64, 6> a, array<u64, 6> b) : Borrowed\n{\n    array<u64, 6> r = [0; 6];"
    "\n    u64 borrow = 0;\n    for (usize i = 0; i < f.n; i += 1)\n    {\n        u128 x = wrapping_sub(wrap"
    "ping_sub(widen<u128>(a[i]), widen<u128>(b[i])), widen<u128>(borrow));\n        r[i] = narrow_wrapping"
    "<u64>(x);\n        borrow = narrow_wrapping<u64>(x >> 127);\n    }\n    Borrowed { .v = r, .borrow = bo"
    "rrow }\n}fn f_sub_raw(ref<Field, shared> f, array<u64, 6> a, array<u64, 6> b) : array<u64, 6>\n{\n    f"
    "_sub_borrow(f, a, b).v\n}fn f_select(u64 mask, array<u64, 6> a, array<u64, 6> b) : array<u64, 6>\n{\n  "
    "  array<u64, 6> r = [0; 6];\n    for (usize i = 0; i < 6; i += 1)\n    {\n        r[i] = (a[i] & mask) "
    "| (b[i] & ~mask);\n    }\n    r\n}fn f_add(ref<Field, shared> f, array<u64, 6> a, array<u64, 6> b) : ar"
    "ray<u64, 6>\n{\n    array<u64, 6> r = [0; 6];\n    u64 carry = 0;\n    for (usize i = 0; i < f.n; i += 1"
    ")\n    {\n        u128 s = widen<u128>(a[i]) + widen<u128>(b[i]) + widen<u128>(carry);\n        r[i] = "
    "narrow_wrapping<u64>(s);\n        carry = narrow_wrapping<u64>(s >> 64);\n    }\n    Borrowed d = f_sub"
    "_borrow(f, r, f.m);\n    f_select(wrapping_sub(0, (1 - carry) & d.borrow), r, d.v)\n}fn f_sub(ref<Fiel"
    "d, shared> f, array<u64, 6> a, array<u64, 6> b) : array<u64, 6>\n{\n    Borrowed d = f_sub_borrow(f, a"
    ", b);\n    array<u64, 6> m = f_select(wrapping_sub(0, d.borrow), f.m, [0; 6]);\n    f_add_raw(f, d.v, "
    "m)\n}fn f_add_raw(ref<Field, shared> f, array<u64, 6> a, array<u64, 6> b) : array<u64, 6>\n{\n    array"
    "<u64, 6> r = [0; 6];\n    u64 carry = 0;\n    for (usize i = 0; i < f.n; i += 1)\n    {\n        u128 s "
    "= widen<u128>(a[i]) + widen<u128>(b[i]) + widen<u128>(carry);\n        r[i] = narrow_wrapping<u64>(s)"
    ";\n        carry = narrow_wrapping<u64>(s >> 64);\n    }\n    r\n}fn f_is_zero(ref<Field, shared> f, arr"
    "ay<u64, 6> a) : bool\n{\n    u64 acc = 0;\n    for (usize i = 0; i < f.n; i += 1)\n    {\n        acc = a"
    "cc | a[i];\n    }\n    acc == 0\n}fn f_to_mont(ref<Field, shared> f, array<u64, 6> a) : array<u64, 6>\n{"
    "\n    mont_mul(f, a, f.r2)\n}fn f_from_mont(ref<Field, shared> f, array<u64, 6> a) : array<u64, 6>\n{\n "
    "   mont_mul(f, a, [1, 0, 0, 0, 0, 0])\n}fn f_invert(ref<Field, shared> f, array<u64, 6> a) : array<u6"
    "4, 6>\n{\n    array<u64, 6> e = f_sub_raw(f, f.m, [2, 0, 0, 0, 0, 0]);\n    array<u64, 6> r = f_to_mont"
    "(f, [1, 0, 0, 0, 0, 0]);\n    usize bits = 64 * f.n;\n    usize i = bits;\n    while (i > 0)\n    {\n    "
    "    i -= 1;\n        r = mont_mul(f, r, r);\n        if (((e[i / 64] >> narrow<u32>(i % 64)) & 1) == 1"
    ")\n        {\n            r = mont_mul(f, r, a);\n        }\n    }\n    r\n}fn f_from_be(ref<Field, shared"
    "> f, slice<u8, shared> b) : Option<array<u64, 6>>\n{\n    usize len = slice_len(b);\n    if (len > 8 * "
    "f.n)\n    {\n        return None;\n    }\n    array<u64, 6> r = [0; 6];\n    for (usize k = 0; k < len; k"
    " += 1)\n    {\n        usize pos = len - 1 - k;\n        r[k / 8] = r[k / 8] | (widen<u64>(b[pos]) << n"
    "arrow<u32>(8 * (k % 8)));\n    }\n    if (!f_less(f, r, f.m))\n    {\n        return None;\n    }\n    Som"
    "e(r)\n}fn f_bit(array<u64, 6> a, usize i) : bool\n{\n    ((a[i / 64] >> narrow<u32>(i % 64)) & 1) == 1\n"
    "}fn f_small(ref<Field, shared> f, u64 k, array<u64, 6> a) : array<u64, 6>\n{\n    array<u64, 6> r = a;"
    "\n    u32 top = 63 - leading_zeros(k);\n    u32 i = top;\n    while (i > 0)\n    {\n        i -= 1;\n     "
    "   r = f_add(f, r, r);\n        if (((k >> i) & 1) == 1)\n        {\n            r = f_add(f, r, a);\n  "
    "      }\n    }\n    r\n}fn jac_double(ref<Field, shared> f, Jacobian q) : Jacobian\n{\n    if (f_is_zero("
    "f, q.z) || f_is_zero(f, q.y))\n    {\n        return Jacobian { .x = q.x, .y = q.y, .z = [0; 6] };\n   "
    " }\n    array<u64, 6> delta = mont_mul(f, q.z, q.z);\n    array<u64, 6> gamma = mont_mul(f, q.y, q.y);"
    "\n    array<u64, 6> beta = mont_mul(f, q.x, gamma);\n    array<u64, 6> alpha = f_small(f, 3, mont_mul("
    "f, f_sub(f, q.x, delta), f_add(f, q.x, delta)));\n    array<u64, 6> x3 = f_sub(f, mont_mul(f, alpha, "
    "alpha), f_small(f, 8, beta));\n    array<u64, 6> yz = f_add(f, q.y, q.z);\n    array<u64, 6> z3 = f_su"
    "b(f, f_sub(f, mont_mul(f, yz, yz), gamma), delta);\n    array<u64, 6> y3 = f_sub(\n        f,\n        "
    "mont_mul(f, alpha, f_sub(f, f_small(f, 4, beta), x3)),\n        f_small(f, 8, mont_mul(f, gamma, gamm"
    "a)),\n    );\n    Jacobian { .x = x3, .y = y3, .z = z3 }\n}fn jac_add(ref<Field, shared> f, Jacobian a,"
    " Jacobian b) : Jacobian\n{\n    if (f_is_zero(f, a.z))\n    {\n        return b;\n    }\n    if (f_is_zero"
    "(f, b.z))\n    {\n        return a;\n    }\n    array<u64, 6> z1z1 = mont_mul(f, a.z, a.z);\n    array<u6"
    "4, 6> z2z2 = mont_mul(f, b.z, b.z);\n    array<u64, 6> u1 = mont_mul(f, a.x, z2z2);\n    array<u64, 6>"
    " u2 = mont_mul(f, b.x, z1z1);\n    array<u64, 6> s1 = mont_mul(f, mont_mul(f, a.y, b.z), z2z2);\n    a"
    "rray<u64, 6> s2 = mont_mul(f, mont_mul(f, b.y, a.z), z1z1);\n    array<u64, 6> h = f_sub(f, u2, u1);\n"
    "    array<u64, 6> r = f_small(f, 2, f_sub(f, s2, s1));\n    if (f_is_zero(f, h))\n    {\n        if (f_"
    "is_zero(f, r))\n        {\n            return jac_double(f, a);\n        }\n        return Jacobian { .x"
    " = a.x, .y = a.y, .z = [0; 6] };\n    }\n    array<u64, 6> h2 = f_small(f, 2, h);\n    array<u64, 6> i "
    "= mont_mul(f, h2, h2);\n    array<u64, 6> j = mont_mul(f, h, i);\n    array<u64, 6> v = mont_mul(f, u1"
    ", i);\n    array<u64, 6> x3 = f_sub(f, f_sub(f, mont_mul(f, r, r), j), f_small(f, 2, v));\n    array<u"
    "64, 6> y3 = f_sub(f, mont_mul(f, r, f_sub(f, v, x3)), f_small(f, 2, mont_mul(f, s1, j)));\n    array<"
    "u64, 6> zs = f_add(f, a.z, b.z);\n    array<u64, 6> z3 = mont_mul(f, f_sub(f, f_sub(f, mont_mul(f, zs"
    ", zs), z1z1), z2z2), h);\n    Jacobian { .x = x3, .y = y3, .z = z3 }\n}fn jac_table(ref<Field, shared>"
    " f, Jacobian p) : Vec<Jacobian>\n{\n    Vec<Jacobian> t = Vec::new();\n    Vec::push(&mut t, Jacobian {"
    " .x = p.x, .y = p.y, .z = [0; 6] });\n    Vec::push(&mut t, p);\n    for (usize i = 2; i < 16; i += 1)"
    "\n    {\n        Jacobian next = if (i % 2 == 0) { jac_double(f, t[i / 2]) } else { jac_add(f, t[i - 1"
    "], p) };\n        Vec::push(&mut t, next);\n    }\n    t\n}fn f_nibble(array<u64, 6> a, usize w) : usize"
    "\n{\n    narrow<usize>((a[w / 16] >> narrow<u32>(4 * (w % 16))) & 15)\n}fn jac_twin(ref<Field, shared> "
    "f, array<u64, 6> u1, Jacobian g, array<u64, 6> u2, Jacobian q, usize bits) : Jacobian\n{\n    Vec<Jaco"
    "bian> tg = jac_table(f, g);\n    Vec<Jacobian> tq = jac_table(f, q);\n    Jacobian acc = tg[0];\n    us"
    "ize w = bits / 4;\n    while (w > 0)\n    {\n        w -= 1;\n        for (usize k = 0; k < 4; k += 1)\n "
    "       {\n            acc = jac_double(f, acc);\n        }\n        usize d1 = f_nibble(u1, w);\n       "
    " usize d2 = f_nibble(u2, w);\n        if (d1 != 0)\n        {\n            acc = jac_add(f, acc, tg[d1]"
    ");\n        }\n        if (d2 != 0)\n        {\n            acc = jac_add(f, acc, tq[d2]);\n        }\n   "
    " }\n    acc\n}fn jac_twin_bits(\n    ref<Field, shared> f,\n    array<u64, 6> u1,\n    Jacobian g,\n    ar"
    "ray<u64, 6> u2,\n    Jacobian q,\n    usize bits,\n) : Jacobian\n{\n    Jacobian gq = jac_add(f, g, q);\n "
    "   Jacobian acc = Jacobian { .x = g.x, .y = g.y, .z = [0; 6] };\n    usize i = bits;\n    while (i > 0"
    ")\n    {\n        i -= 1;\n        acc = jac_double(f, acc);\n        bool b1 = f_bit(u1, i);\n        bo"
    "ol b2 = f_bit(u2, i);\n        if (b1 && b2)\n        {\n            acc = jac_add(f, acc, gq);\n       "
    " }\n        else if (b1)\n        {\n            acc = jac_add(f, acc, g);\n        }\n        else if (b"
    "2)\n        {\n            acc = jac_add(f, acc, q);\n        }\n    }\n    acc\n}fn curve_hex(ref<Field, "
    "shared> f, str hex) : array<u64, 6>\n{\n    Vec<u8> b = Result::unwrap_or(from_hex(StringView::of(hex)"
    "), Vec::new());\n    Option::unwrap(f_from_be(f, &b))\n}fn der_positive_int(slice<u8, shared> d, usize"
    " at) : Option<DerSpan>\n{\n    if (at + 2 > slice_len(d) || d[at] != 0x02)\n    {\n        return None;\n"
    "    }\n    usize len = widen<usize>(d[at + 1]);\n    usize start = at + 2;\n    if (len == 0 || len > 0"
    "x7f || start + len > slice_len(d))\n    {\n        return None;\n    }\n    if ((d[start] & 0x80) != 0)\n"
    "    {\n        return None;\n    }\n    if (len > 1 && d[start] == 0 && (d[start + 1] & 0x80) == 0)\n   "
    " {\n        return None;\n    }\n    // A leading zero byte only marks the number positive.\n    usize f"
    "rom = if (d[start] == 0 && len > 1) { start + 1 } else { start };\n    Some(DerSpan { .start = from, "
    ".end = start + len })\n}export fn ecdsa_verify(\n    EcCurve curve,\n    slice<u8, shared> public_key,\n"
    "    slice<u8, shared> digest,\n    slice<u8, shared> signature,\n) : bool\n{\n    Field fp = field_of(cu"
    "rve, false);\n    Field fn_ = field_of(curve, true);\n    usize size = 8 * fp.n;\n    if (slice_len(pub"
    "lic_key) != 1 + 2 * size || public_key[0] != 0x04)\n    {\n        return false;\n    }\n    array<u64, "
    "6> qx = match (f_from_be(&fp, &public_key[1..1 + size]))\n    {\n        Some(v) : f_to_mont(&fp, v),\n"
    "        None    : return false,\n    };\n    array<u64, 6> qy = match (f_from_be(&fp, &public_key[1 + "
    "size..$]))\n    {\n        Some(v) : f_to_mont(&fp, v),\n        None    : return false,\n    };\n    str"
    " b_hex = match (curve)\n    {\n        P256 : \"5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3"
    "e27d2604b\",\n        P384 : \"b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d"
    "8a2ed19d2a85c8edd3ec2aef\",\n    };\n    array<u64, 6> b = f_to_mont(&fp, curve_hex(&fp, b_hex));\n    /"
    "/ y² = x³ - 3x + b\n    array<u64, 6> lhs = mont_mul(&fp, qy, qy);\n    array<u64, 6> rhs = f_add(&f"
    "p, f_sub(&fp, mont_mul(&fp, mont_mul(&fp, qx, qx), qx), f_small(&fp, 3, qx)), b);\n    if (!f_is_zero"
    "(&fp, f_sub(&fp, lhs, rhs)))\n    {\n        return false;\n    }\n    usize sl = slice_len(signature);\n"
    "    if (sl < 8 || signature[0] != 0x30 || signature[1] > 0x7f || widen<usize>(signature[1]) != sl - "
    "2)\n    {\n        return false;\n    }\n    DerSpan rs = match (der_positive_int(signature, 2))\n    {\n "
    "       Some(v) : v,\n        None    : return false,\n    };\n    DerSpan ss = match (der_positive_int("
    "signature, rs.end))\n    {\n        Some(v) : v,\n        None    : return false,\n    };\n    if (ss.end"
    " != sl)\n    {\n        return false;\n    }\n    array<u64, 6> r = match (f_from_be(&fn_, &signature[rs"
    ".start..rs.end]))\n    {\n        Some(v) : v,\n        None    : return false,\n    };\n    array<u64, 6"
    "> s = match (f_from_be(&fn_, &signature[ss.start..ss.end]))\n    {\n        Some(v) : v,\n        None "
    "   : return false,\n    };\n    if (f_is_zero(&fn_, r) || f_is_zero(&fn_, s))\n    {\n        return fal"
    "se;\n    }\n    // e: the digest's leftmost 8·size bits (the order's bit length is the\n    // prime's"
    " for both curves), reduced once below n.\n    usize take = min(slice_len(digest), size);\n    array<u6"
    "4, 6> e = [0; 6];\n    for (usize k = 0; k < take; k += 1)\n    {\n        usize pos = take - 1 - k;\n  "
    "      e[k / 8] = e[k / 8] | (widen<u64>(digest[pos]) << narrow<u32>(8 * (k % 8)));\n    }\n    if (!f_"
    "less(&fn_, e, fn_.m))\n    {\n        e = f_sub_raw(&fn_, e, fn_.m);\n    }\n    array<u64, 6> w = f_inv"
    "ert(&fn_, f_to_mont(&fn_, s));\n    array<u64, 6> u1 = f_from_mont(&fn_, mont_mul(&fn_, f_to_mont(&fn"
    "_, e), w));\n    array<u64, 6> u2 = f_from_mont(&fn_, mont_mul(&fn_, f_to_mont(&fn_, r), w));\n    str"
    " gx = match (curve)\n    {\n        P256 : \"6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d8"
    "98c296\",\n        P384 : \"aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf5"
    "5296c3a545e3872760ab7\",\n    };\n    str gy = match (curve)\n    {\n        P256 : \"4fe342e2fe1a7f9b8ee7"
    "eb4a7c0f9e162bce33576b315ececbb6406837bf51f5\",\n        P384 : \"3617de4a96262c6f5d9e98bf9292dc29f8f41"
    "dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f\",\n    };\n    array<u64, 6> one = f_to_mo"
    "nt(&fp, [1, 0, 0, 0, 0, 0]);\n    Jacobian g = Jacobian { .x = f_to_mont(\n        &fp,\n        curve_"
    "hex(&fp, gx),\n    ), .y = f_to_mont(&fp, curve_hex(&fp, gy)), .z = one };\n    Jacobian q = Jacobian "
    "{ .x = qx, .y = qy, .z = one };\n    Jacobian p = jac_twin(&fp, u1, g, u2, q, size * 8);\n    if (f_is"
    "_zero(&fp, p.z))\n    {\n        return false;\n    }\n    // x mod n = r, without inverting Z: x = X/Z²"
    ", and x mod n is r exactly\n    // when x is r or (as x < p < 2n for both curves) r + n, the latter o"
    "nly\n    // possible when r + n < p. So compare X with r·Z² and (r + n)·Z².\n    array<u64, 6> z2 "
    "= mont_mul(&fp, p.z, p.z);\n    if (f_is_zero(&fp, f_sub(&fp, p.x, mont_mul(&fp, f_to_mont(&fp, r), z"
    "2))))\n    {\n        return true;\n    }\n    array<u64, 6> rn = f_add_raw(&fp, r, fn_.m);\n    if (f_le"
    "ss(&fn_, rn, fp.m) && f_less(&fn_, r, rn))\n    {\n        return f_is_zero(&fp, f_sub(&fp, p.x, mont_"
    "mul(&fp, f_to_mont(&fp, rn), z2)));\n    }\n    false\n}fn curve_b_hex(EcCurve c) : str\n{\n    match (c)"
    "\n    {\n        P256 : \"5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b\",\n        P3"
    "84 : \"b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2a"
    "ef\",\n    }\n}fn curve_base(ref<Field, shared> fp, EcCurve c) : Jacobian\n{\n    str gx = match (c)\n    "
    "{\n        P256 : \"6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296\",\n        P384 : "
    "\"aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7\",\n"
    "    };\n    str gy = match (c)\n    {\n        P256 : \"4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ece"
    "cbb6406837bf51f5\",\n        P384 : \"3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00"
    "a60b1ce1d7e819d7a431d7c90ea0e5f\",\n    };\n    Jacobian { .x = f_to_mont(\n        fp,\n        curve_he"
    "x(fp, gx),\n    ), .y = f_to_mont(fp, curve_hex(fp, gy)), .z = f_to_mont(fp, [1, 0, 0, 0, 0, 0]) }\n}f"
    "n curve_point(ref<Field, shared> fp, EcCurve c, slice<u8, shared> public_key) : Option<Jacobian>\n{\n "
    "   usize size = 8 * fp.n;\n    if (slice_len(public_key) != 1 + 2 * size || public_key[0] != 0x04)\n  "
    "  {\n        return None;\n    }\n    array<u64, 6> qx = f_to_mont(fp, f_from_be(fp, &public_key[1..1 +"
    " size])?);\n    array<u64, 6> qy = f_to_mont(fp, f_from_be(fp, &public_key[1 + size..$])?);\n    array"
    "<u64, 6> b = f_to_mont(fp, curve_hex(fp, curve_b_hex(c)));\n    array<u64, 6> lhs = mont_mul(fp, qy, "
    "qy);\n    array<u64, 6> rhs = f_add(fp, f_sub(fp, mont_mul(fp, mont_mul(fp, qx, qx), qx), f_small(fp,"
    " 3, qx)), b);\n    if (!f_is_zero(fp, f_sub(fp, lhs, rhs)))\n    {\n        return None;\n    }\n    Some"
    "(Jacobian { .x = qx, .y = qy, .z = f_to_mont(fp, [1, 0, 0, 0, 0, 0]) })\n}fn jac_select(u64 mask, Jac"
    "obian a, Jacobian b) : Jacobian\n{\n    Jacobian { .x = f_select(mask, a.x, b.x), .y = f_select(mask, "
    "a.y, b.y), .z = f_select(mask, a.z, b.z) }\n}fn limbs7_add(array<u64, 7> a, array<u64, 7> b) : array<"
    "u64, 7>\n{\n    array<u64, 7> r = [0; 7];\n    u64 carry = 0;\n    for (usize i = 0; i < 7; i += 1)\n    "
    "{\n        u128 s = widen<u128>(a[i]) + widen<u128>(b[i]) + widen<u128>(carry);\n        r[i] = narrow"
    "_wrapping<u64>(s);\n        carry = narrow_wrapping<u64>(s >> 64);\n    }\n    r\n}fn ec_mul(ref<Field, "
    "shared> fp, ref<Field, shared> fn_, array<u64, 6> k, Jacobian p) : Jacobian\n{\n    usize bits = 64 * "
    "fp.n;\n    array<u64, 7> n7 = [fn_.m[0], fn_.m[1], fn_.m[2], fn_.m[3], fn_.m[4], fn_.m[5], 0];\n    ar"
    "ray<u64, 7> k1 = limbs7_add([k[0], k[1], k[2], k[3], k[4], k[5], 0], n7);\n    array<u64, 7> k2 = lim"
    "bs7_add(k1, n7);\n    // k + n when that reaches 2^bits, k + 2n otherwise: bit `bits` is set\n    // a"
    "nd nothing above it.\n    u64 mask = wrapping_sub(0, k1[bits / 64] & 1);\n    array<u64, 7> kh = [0; 7"
    "];\n    for (usize i = 0; i < 7; i += 1)\n    {\n        kh[i] = (k1[i] & mask) | (k2[i] & ~mask);\n    "
    "}\n    Jacobian acc = p;\n    usize i = bits;\n    while (i > 0)\n    {\n        i -= 1;\n        acc = ja"
    "c_double(fp, acc);\n        Jacobian sum = jac_add(fp, acc, p);\n        u64 bit = (kh[i / 64] >> narr"
    "ow<u32>(i % 64)) & 1;\n        acc = jac_select(wrapping_sub(0, bit), sum, acc);\n    }\n    acc\n}fn li"
    "mbs_be(array<u64, 6> a, usize len) : Vec<u8>\n{\n    Vec<u8> b = Vec::filled(len, 0: u8);\n    for (usi"
    "ze i = 0; i < len; i += 1)\n    {\n        b[len - 1 - i] = narrow_wrapping<u8>(a[i / 8] >> narrow<u32"
    ">(8 * (i % 8)));\n    }\n    b\n}fn ec_scalar(ref<Field, shared> fn_, slice<u8, shared> private_key) : "
    "Option<array<u64, 6>>\n{\n    if (slice_len(private_key) != 8 * fn_.n)\n    {\n        fault(crypto_leng"
    "th);\n    }\n    match (f_from_be(fn_, private_key))\n    {\n        Some(k) : if (f_is_zero(fn_, k)) { "
    "None } else { Some(k) },\n        None    : None,\n    }\n}fn ec_affine(ref<Field, shared> fp, Jacobian"
    " q) : array<array<u64, 6>, 2>\n{\n    array<u64, 6> zinv = f_invert(fp, q.z);\n    array<u64, 6> zinv2 "
    "= mont_mul(fp, zinv, zinv);\n    array<u64, 6> x = f_from_mont(fp, mont_mul(fp, q.x, zinv2));\n    arr"
    "ay<u64, 6> y = f_from_mont(fp, mont_mul(fp, q.y, mont_mul(fp, zinv2, zinv)));\n    [x, y]\n}export fn "
    "ec_private_key(EcCurve curve) : Vec<u8>\n{\n    Field fn_ = field_of(curve, true);\n    Vec<u8> k = Vec"
    "::filled(8 * fn_.n, 0: u8);\n    while (true)\n    {\n        os_random_bytes(&mut k);\n        if (Opti"
    "on::is_some(&ec_scalar(&fn_, &k)))\n        {\n            return k;\n        }\n    }\n}export fn ec_pub"
    "lic_key(EcCurve curve, slice<u8, shared> private_key) : Option<Vec<u8>>\n{\n    Field fp = field_of(cu"
    "rve, false);\n    Field fn_ = field_of(curve, true);\n    array<u64, 6> k = ec_scalar(&fn_, private_ke"
    "y)?;\n    usize size = 8 * fp.n;\n    array<array<u64, 6>, 2> xy = ec_affine(&fp, ec_mul(&fp, &fn_, k,"
    " curve_base(&fp, curve)));\n    Vec<u8> out = Vec::new();\n    Vec::push(&mut out, 0x04);\n    Vec::ext"
    "end_from(&mut out, &limbs_be(xy[0], size));\n    Vec::extend_from(&mut out, &limbs_be(xy[1], size));\n"
    "    Some(out)\n}unittest \"ec_public_key: a scalar outside [1, n-1] has none\"\n{\n    array<u8, 32> zero"
    " = [0; 32];\n    assert(Option::is_none(&ec_public_key(P256, &zero)));\n    array<u8, 32> above = [0xf"
    "f; 32];\n    assert(Option::is_none(&ec_public_key(P256, &above)));\n}export fn ecdh(EcCurve curve, sl"
    "ice<u8, shared> private_key, slice<u8, shared> public_key) : Option<Vec<u8>>\n{\n    Field fp = field_"
    "of(curve, false);\n    Field fn_ = field_of(curve, true);\n    array<u64, 6> k = ec_scalar(&fn_, priva"
    "te_key)?;\n    Jacobian q = curve_point(&fp, curve, public_key)?;\n    Jacobian r = ec_mul(&fp, &fn_, "
    "k, q);\n    if (f_is_zero(&fp, r.z))\n    {\n        return None;\n    }\n    Some(limbs_be(ec_affine(&fp"
    ", r)[0], 8 * fp.n))\n}export fn p256_private_key() : array<u8, 32>\n{\n    Vec<u8> k = ec_private_key(P"
    "256);\n    array<u8, 32> out = [0; 32];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        out[i] = "
    "k[i];\n    }\n    out\n}export fn p256_public_key(slice<u8, shared> private_key) : Option<array<u8, 65>"
    ">\n{\n    Vec<u8> q = ec_public_key(P256, private_key)?;\n    array<u8, 65> out = [0; 65];\n    for (usi"
    "ze i = 0; i < 65; i += 1)\n    {\n        out[i] = q[i];\n    }\n    Some(out)\n}export fn p256_ecdh(slic"
    "e<u8, shared> private_key, slice<u8, shared> public_key) : Option<array<u8, 32>>\n{\n    Vec<u8> z = e"
    "cdh(P256, private_key, public_key)?;\n    array<u8, 32> out = [0; 32];\n    for (usize i = 0; i < 32; "
    "i += 1)\n    {\n        out[i] = z[i];\n    }\n    Some(out)\n}fn digest_scalar(ref<Field, shared> fn_, s"
    "lice<u8, shared> digest, usize size) : array<u64, 6>\n{\n    usize take = min(slice_len(digest), size)"
    ";\n    array<u64, 6> e = [0; 6];\n    for (usize k = 0; k < take; k += 1)\n    {\n        usize pos = ta"
    "ke - 1 - k;\n        e[k / 8] = e[k / 8] | (widen<u64>(digest[pos]) << narrow<u32>(8 * (k % 8)));\n   "
    " }\n    if (!f_less(fn_, e, fn_.m))\n    {\n        e = f_sub_raw(fn_, e, fn_.m);\n    }\n    e\n}fn der_p"
    "ush_uint(ref<Vec<u8>, exclusive> out, slice<u8, shared> v)\n{\n    usize from = 0;\n    while (from + 1"
    " < slice_len(v) && v[from] == 0)\n    {\n        from += 1;\n    }\n    bool pad = (v[from] & 0x80) != 0"
    ";\n    Vec::push(out, 0x02);\n    Vec::push(out, narrow<u8>(slice_len(v) - from + (if (pad) { 1 } else"
    " { 0 })));\n    if (pad)\n    {\n        Vec::push(out, 0);\n    }\n    Vec::extend_from(out, &v[from..$]"
    ");\n}export fn ecdsa_sign(EcCurve curve, slice<u8, shared> private_key, slice<u8, shared> digest) : O"
    "ption<Vec<u8>>\n{\n    Field fp = field_of(curve, false);\n    Field fn_ = field_of(curve, true);\n    u"
    "size size = 8 * fp.n;\n    array<u64, 6> x = ec_scalar(&fn_, private_key)?;\n    HashKind kind = match"
    " (curve)\n    {\n        P256 : Sha2_256,\n        P384 : Sha2_384,\n    };\n    array<u64, 6> e = digest"
    "_scalar(&fn_, digest, size);\n    Vec<u8> x_bytes = limbs_be(x, size);\n    Vec<u8> e_bytes = limbs_be"
    "(e, size);\n    Jacobian g = curve_base(&fp, curve);\n    array<u64, 6> xm = f_to_mont(&fn_, x);\n    a"
    "rray<u64, 6> em = f_to_mont(&fn_, e);\n    // RFC 6979 §3.2 steps b to h.\n    usize hlen = hash_len("
    "kind);\n    Vec<u8> v = Vec::filled(hlen, 1: u8);\n    Vec<u8> key = Vec::filled(hlen, 0: u8);\n    for"
    " (u8 round = 0; round < 2; round += 1)\n    {\n        Hmac m = Hmac::new(kind, &key);\n        Hmac::u"
    "pdate(&mut m, &v);\n        array<u8, 1> sep = [round];\n        Hmac::update(&mut m, &sep);\n        H"
    "mac::update(&mut m, &x_bytes);\n        Hmac::update(&mut m, &e_bytes);\n        overwrite(&mut key, H"
    "mac::finish(m));\n        overwrite(&mut v, hmac(kind, &key, &v));\n    }\n    while (true)\n    {\n     "
    "   overwrite(&mut v, hmac(kind, &key, &v));\n        // T is V itself: the hash is as long as the ord"
    "er for both curves.\n        Option<array<u64, 6>> candidate = f_from_be(&fn_, &v[0..size]);\n        "
    "if (Some(k) = candidate)\n        {\n            if (!f_is_zero(&fn_, k))\n            {\n              "
    "  array<u64, 6> r = ec_affine(&fp, ec_mul(&fp, &fn_, k, g))[0];\n                if (!f_less(&fn_, r,"
    " fn_.m))\n                {\n                    r = f_sub_raw(&fn_, r, fn_.m);\n                }\n    "
    "            if (!f_is_zero(&fn_, r))\n                {\n                    array<u64, 6> kinv = f_in"
    "vert(&fn_, f_to_mont(&fn_, k));\n                    array<u64, 6> rx = mont_mul(&fn_, f_to_mont(&fn_"
    ", r), xm);\n                    array<u64, 6> s = f_from_mont(&fn_, mont_mul(&fn_, kinv, f_add(&fn_, "
    "em, rx)));\n                    if (!f_is_zero(&fn_, s))\n                    {\n                      "
    "  Vec<u8> body = Vec::new();\n                        der_push_uint(&mut body, &limbs_be(r, size));\n "
    "                       der_push_uint(&mut body, &limbs_be(s, size));\n                        Vec<u8>"
    " out = Vec::new();\n                        Vec::push(&mut out, 0x30);\n                        Vec::p"
    "ush(&mut out, narrow<u8>(Vec::len(&body)));\n                        Vec::extend_from(&mut out, &body"
    ");\n                        return Some(out);\n                    }\n                }\n            }\n "
    "       }\n        Hmac m = Hmac::new(kind, &key);\n        Hmac::update(&mut m, &v);\n        array<u8,"
    " 1> zero = [0];\n        Hmac::update(&mut m, &zero);\n        overwrite(&mut key, Hmac::finish(m));\n "
    "       overwrite(&mut v, hmac(kind, &key, &v));\n    }\n}fn fe_neg(array<u64, 5> a) : array<u64, 5>\n{\n"
    "    fe_sub([0, 0, 0, 0, 0], a)\n}fn fe_is_zero(array<u64, 5> a) : bool\n{\n    array<u8, 32> b = fe_to_"
    "bytes(a);\n    u8 acc = 0;\n    for (usize i = 0; i < 32; i += 1)\n    {\n        acc = acc | b[i];\n    "
    "}\n    acc == 0\n}fn fe_eq(array<u64, 5> a, array<u64, 5> b) : bool\n{\n    fe_is_zero(fe_sub(a, b))\n}fn"
    " fe_select(u64 mask, array<u64, 5> a, array<u64, 5> b) : array<u64, 5>\n{\n    array<u64, 5> r = [0; 5"
    "];\n    for (usize i = 0; i < 5; i += 1)\n    {\n        r[i] = (a[i] & mask) | (b[i] & ~mask);\n    }\n "
    "   r\n}fn fe_pow_p58(array<u64, 5> z) : array<u64, 5>\n{\n    array<u64, 5> r = [1, 0, 0, 0, 0];\n    fo"
    "r (usize k = 0; k < 252; k += 1)\n    {\n        usize i = 251 - k;\n        r = fe_mul(r, r);\n        "
    "if (i != 1)\n        {\n            r = fe_mul(r, z);\n        }\n    }\n    r\n}fn ed_identity() : Ed\n{\n "
    "   Ed { .x = [0, 0, 0, 0, 0], .y = [1, 0, 0, 0, 0], .z = [1, 0, 0, 0, 0], .t = [0, 0, 0, 0, 0] }\n}fn"
    " ed_base() : Ed\n{\n    Ed { .x = ED_BX, .y = ED_BY, .z = [1, 0, 0, 0, 0], .t = fe_mul(ED_BX, ED_BY) }"
    "\n}fn ed_add(Ed p, Ed q) : Ed\n{\n    array<u64, 5> a = fe_mul(fe_sub(p.y, p.x), fe_sub(q.y, q.x));\n   "
    " array<u64, 5> b = fe_mul(fe_add(p.y, p.x), fe_add(q.y, q.x));\n    array<u64, 5> c = fe_mul(fe_mul(p"
    ".t, ED_2D), q.t);\n    array<u64, 5> d = fe_mul(fe_add(p.z, p.z), q.z);\n    array<u64, 5> e = fe_sub("
    "b, a);\n    array<u64, 5> f = fe_sub(d, c);\n    array<u64, 5> g = fe_add(d, c);\n    array<u64, 5> h ="
    " fe_add(b, a);\n    Ed { .x = fe_mul(e, f), .y = fe_mul(g, h), .z = fe_mul(f, g), .t = fe_mul(e, h) }"
    "\n}fn ed_double(Ed p) : Ed\n{\n    array<u64, 5> a = fe_mul(p.x, p.x);\n    array<u64, 5> b = fe_mul(p.y"
    ", p.y);\n    array<u64, 5> zz = fe_mul(p.z, p.z);\n    array<u64, 5> c = fe_add(zz, zz);\n    array<u64"
    ", 5> h = fe_add(a, b);\n    array<u64, 5> xy = fe_add(p.x, p.y);\n    array<u64, 5> e = fe_sub(h, fe_m"
    "ul(xy, xy));\n    array<u64, 5> g = fe_sub(a, b);\n    array<u64, 5> f = fe_add(c, g);\n    Ed { .x = f"
    "e_mul(e, f), .y = fe_mul(g, h), .z = fe_mul(f, g), .t = fe_mul(e, h) }\n}fn ed_select(u64 mask, Ed a,"
    " Ed b) : Ed\n{\n    Ed { .x = fe_select(\n        mask,\n        a.x,\n        b.x,\n    ), .y = fe_select"
    "(mask, a.y, b.y), .z = fe_select(mask, a.z, b.z), .t = fe_select(mask, a.t, b.t) }\n}fn ed_mul(slice<"
    "u8, shared> scalar, Ed p) : Ed\n{\n    Ed acc = ed_identity();\n    usize i = 256;\n    while (i > 0)\n  "
    "  {\n        i -= 1;\n        acc = ed_double(acc);\n        Ed sum = ed_add(acc, p);\n        u64 bit ="
    " widen<u64>((scalar[i / 8] >> narrow<u32>(i % 8)) & 1);\n        acc = ed_select(wrapping_sub(0, bit)"
    ", sum, acc);\n    }\n    acc\n}fn ed_encode(Ed p) : array<u8, 32>\n{\n    array<u64, 5> zinv = fe_invert("
    "p.z);\n    array<u8, 32> out = fe_to_bytes(fe_mul(p.y, zinv));\n    array<u8, 32> xb = fe_to_bytes(fe_"
    "mul(p.x, zinv));\n    out[31] = out[31] | ((xb[0] & 1) << 7);\n    out\n}fn ed_decode(slice<u8, shared>"
    " b) : Option<Ed>\n{\n    array<u64, 5> y = fe_from_bytes(b);\n    array<u8, 32> canon = fe_to_bytes(y);"
    "\n    u8 diff = 0;\n    for (usize i = 0; i < 31; i += 1)\n    {\n        diff = diff | (canon[i] ^ b[i]"
    ");\n    }\n    diff = diff | (canon[31] ^ (b[31] & 0x7f));\n    if (diff != 0)\n    {\n        return Non"
    "e;\n    }\n    u8 sign = b[31] >> 7;\n    array<u64, 5> y2 = fe_mul(y, y);\n    array<u64, 5> u = fe_sub"
    "(y2, [1, 0, 0, 0, 0]);\n    array<u64, 5> v = fe_add(fe_mul(ED_D, y2), [1, 0, 0, 0, 0]);\n    array<u6"
    "4, 5> v3 = fe_mul(fe_mul(v, v), v);\n    array<u64, 5> v7 = fe_mul(fe_mul(v3, v3), v);\n    array<u64,"
    " 5> x = fe_mul(fe_mul(u, v3), fe_pow_p58(fe_mul(u, v7)));\n    array<u64, 5> vx2 = fe_mul(v, fe_mul(x"
    ", x));\n    if (!fe_eq(vx2, u))\n    {\n        if (!fe_eq(vx2, fe_neg(u)))\n        {\n            retur"
    "n None;\n        }\n        x = fe_mul(x, ED_SQRT_M1);\n    }\n    array<u8, 32> xb = fe_to_bytes(x);\n  "
    "  if ((xb[0] & 1) == 0 && sign == 1 && fe_is_zero(x))\n    {\n        return None;\n    }\n    if ((xb[0"
    "] & 1) != sign)\n    {\n        x = fe_neg(x);\n    }\n    Some(Ed { .x = x, .y = y, .z = [1, 0, 0, 0, 0"
    "], .t = fe_mul(x, y) })\n}fn ed_order() : Field\n{\n    Field { .m = [\n        0x5812631a5cf5d3ed,\n    "
    "    0x14def9dea2f79cd6,\n        0x0000000000000000,\n        0x1000000000000000,\n        0x0000000000"
    "000000,\n        0x0000000000000000,\n    ], .n = 4, .minv = 0xd2b51da312547e1b, .r2 = [\n        0xa40"
    "611e3449c0f01,\n        0xd00e1ba768859347,\n        0xceec73d217f5be65,\n        0x0399411b7c309a3d,\n "
    "       0x0000000000000000,\n        0x0000000000000000,\n    ] }\n}fn le_limbs(slice<u8, shared> b) : a"
    "rray<u64, 6>\n{\n    array<u64, 6> r = [0; 6];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        r[i"
    " / 8] = r[i / 8] | (widen<u64>(b[i]) << narrow<u32>(8 * (i % 8)));\n    }\n    r\n}fn sc_mont(ref<Field"
    ", shared> fl, array<u64, 6> a) : array<u64, 6>\n{\n    mont_mul(fl, a, fl.r2)\n}fn sc_from_hash(ref<Fie"
    "ld, shared> fl, slice<u8, shared> h) : array<u64, 6>\n{\n    array<u64, 6> lo = sc_mont(fl, le_limbs(&"
    "h[0..32]));\n    array<u64, 6> hi = sc_mont(fl, sc_mont(fl, le_limbs(&h[32..64])));\n    f_add(fl, lo,"
    " hi)\n}fn sc_bytes(ref<Field, shared> fl, array<u64, 6> m) : array<u8, 32>\n{\n    array<u64, 6> a = f_"
    "from_mont(fl, m);\n    array<u8, 32> out = [0; 32];\n    for (usize i = 0; i < 32; i += 1)\n    {\n     "
    "   out[i] = narrow_wrapping<u8>(a[i / 8] >> narrow<u32>(8 * (i % 8)));\n    }\n    out\n}fn ed_expand(s"
    "lice<u8, shared> private_key) : EdExpanded\n{\n    if (slice_len(private_key) != 32)\n    {\n        fau"
    "lt(crypto_length);\n    }\n    array<u8, 64> h = sha512(private_key);\n    array<u8, 32> s = [0; 32];\n "
    "   array<u8, 32> prefix = [0; 32];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        s[i] = h[i];\n"
    "        prefix[i] = h[32 + i];\n    }\n    s[0] = s[0] & 248;\n    s[31] = (s[31] & 127) | 64;\n    EdEx"
    "panded { .scalar = s, .prefix = prefix }\n}export fn ed25519_private_key() : array<u8, 32>\n{\n    arra"
    "y<u8, 32> k = [0; 32];\n    os_random_bytes(&mut k);\n    k\n}export fn ed25519_public_key(slice<u8, sh"
    "ared> private_key) : array<u8, 32>\n{\n    EdExpanded e = ed_expand(private_key);\n    ed_encode(ed_mul"
    "(&e.scalar, ed_base()))\n}export fn ed25519_sign(slice<u8, shared> private_key, slice<u8, shared> mes"
    "sage) : array<u8, 64>\n{\n    EdExpanded e = ed_expand(private_key);\n    Field fl = ed_order();\n    ar"
    "ray<u8, 32> a = ed_encode(ed_mul(&e.scalar, ed_base()));\n    Sha512 hr = Sha512::new();\n    Sha512::"
    "update(&mut hr, &e.prefix);\n    Sha512::update(&mut hr, message);\n    array<u64, 6> r = sc_from_hash"
    "(&fl, &Sha512::finish(hr));\n    array<u8, 32> r_bytes = sc_bytes(&fl, r);\n    array<u8, 32> big_r = "
    "ed_encode(ed_mul(&r_bytes, ed_base()));\n    Sha512 hk = Sha512::new();\n    Sha512::update(&mut hk, &"
    "big_r);\n    Sha512::update(&mut hk, &a);\n    Sha512::update(&mut hk, message);\n    array<u64, 6> k ="
    " sc_from_hash(&fl, &Sha512::finish(hk));\n    array<u64, 6> s = f_add(&fl, r, mont_mul(&fl, k, sc_mon"
    "t(&fl, le_limbs(&e.scalar))));\n    array<u8, 32> s_bytes = sc_bytes(&fl, s);\n    array<u8, 64> out ="
    " [0; 64];\n    for (usize i = 0; i < 32; i += 1)\n    {\n        out[i] = big_r[i];\n        out[32 + i]"
    " = s_bytes[i];\n    }\n    out\n}export fn ed25519_verify(slice<u8, shared> public_key, slice<u8, share"
    "d> message, slice<u8, shared> signature) : bool\n{\n    if (slice_len(public_key) != 32 || slice_len(s"
    "ignature) != 64)\n    {\n        return false;\n    }\n    Ed a = match (ed_decode(public_key))\n    {\n  "
    "      Some(p) : p,\n        None    : return false,\n    };\n    Ed big_r = match (ed_decode(&signature"
    "[0..32]))\n    {\n        Some(p) : p,\n        None    : return false,\n    };\n    Field fl = ed_order("
    ");\n    array<u64, 6> s = le_limbs(&signature[32..64]);\n    if (!f_less(&fl, s, fl.m))\n    {\n        "
    "return false;\n    }\n    Sha512 hk = Sha512::new();\n    Sha512::update(&mut hk, &signature[0..32]);\n "
    "   Sha512::update(&mut hk, public_key);\n    Sha512::update(&mut hk, message);\n    array<u8, 32> k = "
    "sc_bytes(&fl, sc_from_hash(&fl, &Sha512::finish(hk)));\n    array<u8, 32> lhs = ed_encode(ed_mul(&sig"
    "nature[32..64], ed_base()));\n    array<u8, 32> rhs = ed_encode(ed_add(big_r, ed_mul(&k, a)));\n    di"
    "gest_eq(&lhs, &rhs)\n}fn limbs_of(ref<BigUint, shared> a, usize n) : Vec<u64>\n{\n    Vec<u8> be = BigU"
    "int::to_bytes_be_padded(a, 8 * n);\n    Vec<u64> out = Vec::filled(n, 0: u64);\n    for (usize i = 0; "
    "i < 8 * n; i += 1)\n    {\n        out[i / 8] = out[i / 8] | (widen<u64>(be[8 * n - 1 - i]) << narrow<"
    "u32>(8 * (i % 8)));\n    }\n    out\n}fn biguint_of(ref<Vec<u64>, shared> limbs) : BigUint\n{\n    usize "
    "n = Vec::len(limbs);\n    Vec<u8> be = Vec::filled(8 * n, 0: u8);\n    for (usize i = 0; i < 8 * n; i "
    "+= 1)\n    {\n        be[8 * n - 1 - i] = narrow_wrapping<u8>(limbs[i / 8] >> narrow<u32>(8 * (i % 8))"
    ");\n    }\n    BigUint::from_bytes_be(&be)\n}fn mont_new(ref<BigUint, shared> modulus) : Mont\n{\n    usi"
    "ze n = (BigUint::bit_len(modulus) + 63) / 64;\n    Vec<u64> m = limbs_of(modulus, n);\n    // m⁻¹ m"
    "od 2^64 by Newton's iteration from the odd m's own low limb.\n    u64 inv = 1;\n    for (usize i = 0; "
    "i < 7; i += 1)\n    {\n        inv = wrapping_mul(inv, wrapping_sub(2, wrapping_mul(m[0], inv)));\n    "
    "}\n    BigUint one = BigUint::from_u64(1);\n    BigUint r2 = BigUint::rem(&BigUint::shift_left(&one, 1"
    "28 * n), modulus);\n    Mont { .m = m, .n = n, .minv = wrapping_sub(0, inv), .r2 = limbs_of(&r2, n) }"
    "\n}fn mont_mul_v(ref<Mont, shared> f, ref<Vec<u64>, shared> a, ref<Vec<u64>, shared> b) : Vec<u64>\n{\n"
    "    usize n = f.n;\n    Vec<u64> t = Vec::filled(n + 2, 0: u64);\n    for (usize i = 0; i < n; i += 1)"
    "\n    {\n        u128 c = 0;\n        u128 bi = widen<u128>(b[i]);\n        for (usize j = 0; j < n; j +"
    "= 1)\n        {\n            u128 x = widen<u128>(t[j]) + widen<u128>(a[j]) * bi + c;\n            t[j]"
    " = narrow_wrapping<u64>(x);\n            c = x >> 64;\n        }\n        u128 y = widen<u128>(t[n]) + "
    "c;\n        t[n] = narrow_wrapping<u64>(y);\n        t[n + 1] = narrow_wrapping<u64>(y >> 64);\n       "
    " u64 k = wrapping_mul(t[0], f.minv);\n        u128 kk = widen<u128>(k);\n        u128 z = widen<u128>("
    "t[0]) + kk * widen<u128>(f.m[0]);\n        c = z >> 64;\n        for (usize j = 1; j < n; j += 1)\n    "
    "    {\n            u128 x = widen<u128>(t[j]) + kk * widen<u128>(f.m[j]) + c;\n            t[j - 1] = "
    "narrow_wrapping<u64>(x);\n            c = x >> 64;\n        }\n        u128 w = widen<u128>(t[n]) + c;\n"
    "        t[n - 1] = narrow_wrapping<u64>(w);\n        t[n] = t[n + 1] + narrow_wrapping<u64>(w >> 64);"
    "\n    }\n    // t - m unless t (with its carry) is below m: chosen by a mask.\n    Vec<u64> r = Vec::fi"
    "lled(n, 0: u64);\n    u64 borrow = 0;\n    for (usize j = 0; j < n; j += 1)\n    {\n        u128 x = wra"
    "pping_sub(wrapping_sub(widen<u128>(t[j]), widen<u128>(f.m[j])), widen<u128>(borrow));\n        r[j] ="
    " narrow_wrapping<u64>(x);\n        borrow = narrow_wrapping<u64>(x >> 127);\n    }\n    u64 keep = wrap"
    "ping_sub(0, (1 - t[n]) & borrow);\n    for (usize j = 0; j < n; j += 1)\n    {\n        r[j] = (t[j] & "
    "keep) | (r[j] & ~keep);\n    }\n    r\n}fn mont_pow(ref<Mont, shared> f, ref<BigUint, shared> base, ref"
    "<BigUint, shared> exp) : BigUint\n{\n    biguint_of(&mont_pow_limbs(f, &limbs_of(base, f.n), exp))\n}fn"
    " mont_pow_limbs(ref<Mont, shared> f, ref<Vec<u64>, shared> base, ref<BigUint, shared> exp) : Vec<u64"
    ">\n{\n    usize n = f.n;\n    Vec<u64> one = Vec::filled(n, 0: u64);\n    one[0] = 1;\n    Vec<u64> one_m"
    " = mont_mul_v(f, &one, &f.r2);\n    Vec<u64> base_m = mont_mul_v(f, base, &f.r2);\n    Vec<Vec<u64>> t"
    "able = Vec::new();\n    Vec::push(&mut table, Vec::clone(&one_m));\n    for (usize i = 1; i < 16; i +="
    " 1)\n    {\n        Vec<u64> next = mont_mul_v(f, &table[i - 1], &base_m);\n        Vec::push(&mut tabl"
    "e, next);\n    }\n    Vec<u64> e = limbs_of(exp, n);\n    Vec<u64> acc = Vec::clone(&one_m);\n    usize "
    "windows = 16 * n;\n    usize w = windows;\n    while (w > 0)\n    {\n        w -= 1;\n        for (usize "
    "s = 0; s < 4; s += 1)\n        {\n            overwrite(&mut acc, mont_mul_v(f, &acc, &acc));\n        "
    "}\n        u64 bits = (e[w / 16] >> narrow<u32>(4 * (w % 16))) & 15;\n        Vec<u64> entry = Vec::fi"
    "lled(n, 0: u64);\n        for (u64 i = 0; i < 16; i += 1)\n        {\n            u64 x = i ^ bits;\n   "
    "         u64 mask = wrapping_sub(((x | wrapping_sub(0, x)) >> 63), 1);\n            for (usize j = 0;"
    " j < n; j += 1)\n            {\n                entry[j] = entry[j] | (table[narrow<usize>(i)][j] & ma"
    "sk);\n            }\n        }\n        overwrite(&mut acc, mont_mul_v(f, &acc, &entry));\n    }\n    mon"
    "t_mul_v(f, &acc, &one)\n}export fn RsaPrivateKey::new(BigUint n, BigUint e, BigUint d, BigUint p, Big"
    "Uint q) : Option<RsaPrivateKey>\n{\n    BigUint one = BigUint::from_u64(1);\n    BigUint two = BigUint:"
    ":from_u64(2);\n    if (!BigUint::less(&two, &p) || !BigUint::less(&two, &q) || !BigUint::bit(&p, 0) |"
    "| !BigUint::bit(&q, 0))\n    {\n        return None;\n    }\n    if (!BigUint::eq(&BigUint::mul(&p, &q),"
    " &n))\n    {\n        return None;\n    }\n    BigUint p1 = BigUint::sub(&p, &one);\n    BigUint q1 = Big"
    "Uint::sub(&q, &one);\n    BigUint ed = BigUint::mul(&e, &d);\n    if (!BigUint::eq(&BigUint::rem(&ed, "
    "&p1), &one) || !BigUint::eq(&BigUint::rem(&ed, &q1), &one))\n    {\n        return None;\n    }\n    Big"
    "Uint dp = BigUint::rem(&d, &p1);\n    BigUint dq = BigUint::rem(&d, &q1);\n    BigUint qinv = BigUint:"
    ":mod_inverse(&q, &p)?;\n    Some(RsaPrivateKey { .n = n, .e = e, .d = d, .p = p, .q = q, .dp = dp, .d"
    "q = dq, .qinv = qinv })\n}unittest \"RsaPrivateKey::new: parts that do not fit are refused\"\n{\n    BigU"
    "int n = BigUint::from_u64(3233);\n    BigUint e = BigUint::from_u64(17);\n    BigUint p = BigUint::fro"
    "m_u64(61);\n    BigUint q = BigUint::from_u64(53);\n    Option<RsaPrivateKey> good = RsaPrivateKey::ne"
    "w(n, e, BigUint::from_u64(2753), p, q);\n    assert(Option::is_some(&good));\n    Option<RsaPrivateKey"
    "> bad = RsaPrivateKey::new(\n        BigUint::from_u64(3233),\n        BigUint::from_u64(17),\n        "
    "BigUint::from_u64(2754),\n        BigUint::from_u64(61),\n        BigUint::from_u64(53),\n    );\n    as"
    "sert(Option::is_none(&bad));\n}export fn RsaPrivateKey::public_key(ref<RsaPrivateKey, shared> key) : "
    "RsaPublicKey\n{\n    RsaPublicKey { .n = BigUint::clone(&key.n), .e = BigUint::clone(&key.e) }\n}fn lim"
    "bs_sub_mod(ref<Mont, shared> f, ref<Vec<u64>, shared> a, ref<Vec<u64>, shared> b) : Vec<u64>\n{\n    u"
    "size n = f.n;\n    Vec<u64> r = Vec::filled(n, 0: u64);\n    u64 borrow = 0;\n    for (usize j = 0; j <"
    " n; j += 1)\n    {\n        u128 x = wrapping_sub(wrapping_sub(widen<u128>(a[j]), widen<u128>(b[j])), "
    "widen<u128>(borrow));\n        r[j] = narrow_wrapping<u64>(x);\n        borrow = narrow_wrapping<u64>("
    "x >> 127);\n    }\n    // Add m back where it borrowed.\n    u64 mask = wrapping_sub(0, borrow);\n    u6"
    "4 carry = 0;\n    for (usize j = 0; j < n; j += 1)\n    {\n        u128 x = widen<u128>(r[j]) + widen<u"
    "128>(f.m[j] & mask) + widen<u128>(carry);\n        r[j] = narrow_wrapping<u64>(x);\n        carry = na"
    "rrow_wrapping<u64>(x >> 64);\n    }\n    r\n}fn rsa_private_op(ref<RsaPrivateKey, shared> key, ref<BigU"
    "int, shared> m) : BigUint\n{\n    Mont mp = mont_new(&key.p);\n    Mont mq = mont_new(&key.q);\n    usiz"
    "e np = mp.n;\n    usize nq = mq.n;\n    // m1 = m^dp mod p, m2 = m^dq mod q (m reduced: public values)"
    ".\n    Vec<u64> m1 = mont_pow_limbs(&mp, &limbs_of(&BigUint::rem(m, &key.p), np), &key.dp);\n    Vec<u"
    "64> m2 = mont_pow_limbs(&mq, &limbs_of(&BigUint::rem(m, &key.q), nq), &key.dq);\n    // h = qinv·(m1"
    " - m2 mod p) mod p, on p's arithmetic.\n    Vec<u64> m2_mod_p = limbs_of(&BigUint::rem(&biguint_of(&m"
    "2), &key.p), np);\n    Vec<u64> diff = limbs_sub_mod(&mp, &m1, &m2_mod_p);\n    Vec<u64> qinv_m = mont"
    "_mul_v(&mp, &limbs_of(&key.qinv, np), &mp.r2);\n    Vec<u64> h = mont_mul_v(&mp, &diff, &qinv_m);\n   "
    " // s = m2 + h·q: a plain product over limbs, then the sum.\n    Vec<u64> q_limbs = limbs_of(&key.q,"
    " nq);\n    Vec<u64> s = Vec::filled(np + nq + 1, 0: u64);\n    for (usize i = 0; i < np; i += 1)\n    {"
    "\n        u128 carry = 0;\n        u128 hi = widen<u128>(h[i]);\n        for (usize j = 0; j < nq; j +="
    " 1)\n        {\n            u128 x = widen<u128>(s[i + j]) + hi * widen<u128>(q_limbs[j]) + carry;\n   "
    "         s[i + j] = narrow_wrapping<u64>(x);\n            carry = x >> 64;\n        }\n        s[i + nq"
    "] = narrow_wrapping<u64>(carry);\n    }\n    u128 c = 0;\n    for (usize j = 0; j < np + nq + 1; j += 1"
    ")\n    {\n        u128 x = widen<u128>(s[j]) + (if (j < nq) { widen<u128>(m2[j]) } else { 0 }) + c;\n  "
    "      s[j] = narrow_wrapping<u64>(x);\n        c = x >> 64;\n    }\n    BigUint result = biguint_of(&s)"
    ";\n    // Checked against the public key: a wrong result would leak the\n    // primes, so a key that "
    "fails is used without the CRT instead.\n    if (BigUint::eq(&BigUint::mod_pow(&result, &key.e, &key.n"
    "), m))\n    {\n        return result;\n    }\n    Mont mn = mont_new(&key.n);\n    mont_pow(&mn, m, &key."
    "d)\n}fn pkcs1v15_encode(HashKind kind, slice<u8, shared> digest, usize k) : Vec<u8>\n{\n    Vec<u8> pre"
    "fix = digest_info_prefix(kind);\n    usize t_len = Vec::len(&prefix) + slice_len(digest);\n    if (sli"
    "ce_len(digest) != hash_len(kind) || k < t_len + 11)\n    {\n        fault(crypto_length);\n    }\n    Ve"
    "c<u8> em = Vec::new();\n    Vec::push(&mut em, 0);\n    Vec::push(&mut em, 1);\n    for (usize i = 0; i"
    " < k - t_len - 3; i += 1)\n    {\n        Vec::push(&mut em, 0xff);\n    }\n    Vec::push(&mut em, 0);\n "
    "   Vec::extend_from(&mut em, &prefix);\n    Vec::extend_from(&mut em, digest);\n    em\n}export fn rsa_"
    "sign_pkcs1v15(ref<RsaPrivateKey, shared> key, HashKind kind, slice<u8, shared> digest) : Vec<u8>\n{\n "
    "   usize k = (BigUint::bit_len(&key.n) + 7) / 8;\n    Vec<u8> em = pkcs1v15_encode(kind, digest, k);\n"
    "    BigUint s = rsa_private_op(key, &BigUint::from_bytes_be(&em));\n    BigUint::to_bytes_be_padded(&"
    "s, k)\n}export fn rsa_sign_pss(ref<RsaPrivateKey, shared> key, HashKind kind, slice<u8, shared> diges"
    "t) : Vec<u8>\n{\n    usize mod_bits = BigUint::bit_len(&key.n);\n    usize k = (mod_bits + 7) / 8;\n    "
    "usize h_len = hash_len(kind);\n    usize em_bits = mod_bits - 1;\n    usize em_len = (em_bits + 7) / 8"
    ";\n    if (slice_len(digest) != h_len || em_len < 2 * h_len + 2)\n    {\n        fault(crypto_length);\n"
    "    }\n    Vec<u8> salt = Vec::filled(h_len, 0: u8);\n    os_random_bytes(&mut salt);\n    Vec<u8> m2 ="
    " Vec::filled(8, 0: u8);\n    Vec::extend_from(&mut m2, digest);\n    Vec::extend_from(&mut m2, &salt);"
    "\n    Vec<u8> h = hash(kind, &m2);\n    usize db_len = em_len - h_len - 1;\n    Vec<u8> db = Vec::fille"
    "d(db_len - h_len - 1, 0: u8);\n    Vec::push(&mut db, 1);\n    Vec::extend_from(&mut db, &salt);\n    V"
    "ec<u8> mask = mgf1(kind, &h, db_len);\n    Vec<u8> em = Vec::new();\n    for (usize i = 0; i < db_len;"
    " i += 1)\n    {\n        Vec::push(&mut em, db[i] ^ mask[i]);\n    }\n    u32 unused = narrow<u32>(8 * e"
    "m_len - em_bits);\n    em[0] = em[0] & narrow_wrapping<u8>((0xff: u32) >> unused);\n    Vec::extend_fr"
    "om(&mut em, &h);\n    Vec::push(&mut em, 0xbc);\n    BigUint s = rsa_private_op(key, &BigUint::from_by"
    "tes_be(&em));\n    BigUint::to_bytes_be_padded(&s, k)\n}fn small_primes() : Vec<u32>\n{\n    Vec<u32> ou"
    "t = Vec::new();\n    for (u32 c = 3; c < 1000; c += 2)\n    {\n        bool prime = true;\n        for ("
    "usize i = 0; i < Vec::len(&out) && out[i] * out[i] <= c; i += 1)\n        {\n            if (c % out[i"
    "] == 0)\n            {\n                prime = false;\n                break;\n            }\n        }\n"
    "        if (prime)\n        {\n            Vec::push(&mut out, c);\n        }\n    }\n    out\n}fn probabl"
    "y_prime(ref<BigUint, shared> c, ref<Vec<u32>, shared> primes, usize rounds) : bool\n{\n    for (usize "
    "i = 0; i < Vec::len(primes); i += 1)\n    {\n        BigUint p = BigUint::from_u64(widen<u64>(primes[i"
    "]));\n        if (BigUint::is_zero(&BigUint::rem(c, &p)))\n        {\n            return BigUint::eq(c,"
    " &p);\n        }\n    }\n    BigUint one = BigUint::from_u64(1);\n    BigUint c1 = BigUint::sub(c, &one)"
    ";\n    usize a = 0;\n    while (!BigUint::bit(&c1, a))\n    {\n        a += 1;\n    }\n    BigUint m = Big"
    "Uint::shift_right(&c1, a);\n    Mont f = mont_new(c);\n    usize k = (BigUint::bit_len(c) + 7) / 8;\n  "
    "  Vec<u8> rb = Vec::filled(k, 0: u8);\n    BigUint two = BigUint::from_u64(2);\n    for (usize round ="
    " 0; round < rounds; round += 1)\n    {\n        os_random_bytes(&mut rb);\n        BigUint b = BigUint:"
    ":add(\n            &BigUint::rem(&BigUint::from_bytes_be(&rb), &BigUint::sub(c, &BigUint::from_u64(3)"
    ")),\n            &two,\n        );\n        BigUint z = mont_pow(&f, &b, &m);\n        if (BigUint::eq(&"
    "z, &one) || BigUint::eq(&z, &c1))\n        {\n            continue;\n        }\n        bool witness = t"
    "rue;\n        for (usize j = 1; j < a; j += 1)\n        {\n            overwrite(&mut z, BigUint::rem(&"
    "BigUint::mul(&z, &z), c));\n            if (BigUint::eq(&z, &c1))\n            {\n                witne"
    "ss = false;\n                break;\n            }\n            if (BigUint::eq(&z, &one))\n            "
    "{\n                return false;\n            }\n        }\n        if (witness)\n        {\n            r"
    "eturn false;\n        }\n    }\n    true\n}fn random_prime(usize bits, ref<BigUint, shared> e, ref<Vec<u"
    "32>, shared> primes) : BigUint\n{\n    usize k = (bits + 7) / 8;\n    Vec<u8> rb = Vec::filled(k, 0: u8"
    ");\n    BigUint one = BigUint::from_u64(1);\n    while (true)\n    {\n        os_random_bytes(&mut rb);\n"
    "        BigUint c = BigUint::from_bytes_be(&rb);\n        // Exactly `bits` bits with the top two set"
    ", and odd.\n        BigUint top = BigUint::shift_left(&one, bits - 1);\n        BigUint second = BigUi"
    "nt::shift_left(&one, bits - 2);\n        BigUint mask = BigUint::sub(&BigUint::shift_left(&one, bits)"
    ", &one);\n        BigUint c2 = BigUint::rem(&c, &BigUint::add(&mask, &one));\n        BigUint c3 = Big"
    "Uint::add(&BigUint::rem(&c2, &second), &BigUint::add(&top, &second));\n        if (!BigUint::bit(&c3,"
    " 0))\n        {\n            overwrite(&mut c3, BigUint::add(&c3, &one));\n        }\n        BigUint c4"
    " = BigUint::sub(&c3, &one);\n        if (BigUint::is_zero(&BigUint::rem(&c4, e)))\n        {\n         "
    "   continue;\n        }\n        if (probably_prime(&c3, primes, 5))\n        {\n            return c3;\n"
    "        }\n    }\n}export fn rsa_generate_key(usize bits) : RsaPrivateKey\n{\n    if (bits < 1024 || bit"
    "s > 8192 || bits % 64 != 0)\n    {\n        fault(crypto_length);\n    }\n    Vec<u32> primes = small_pr"
    "imes();\n    BigUint e = BigUint::from_u64(65537);\n    BigUint one = BigUint::from_u64(1);\n    while "
    "(true)\n    {\n        BigUint p = random_prime(bits / 2, &e, &primes);\n        BigUint q = random_pri"
    "me(bits / 2, &e, &primes);\n        if (BigUint::eq(&p, &q))\n        {\n            continue;\n        "
    "}\n        BigUint n = BigUint::mul(&p, &q);\n        BigUint p1 = BigUint::sub(&p, &one);\n        Big"
    "Uint q1 = BigUint::sub(&q, &one);\n        BigUint phi = BigUint::mul(&p1, &q1);\n        BigUint d = "
    "match (BigUint::mod_inverse(&e, &phi))\n        {\n            Some(v) : v,\n            None    : cont"
    "inue,\n        };\n        if (Some(key) = RsaPrivateKey::new(n, BigUint::clone(&e), d, p, q))\n       "
    " {\n            return key;\n        }\n    }\n}export fn CertError::text(ref<CertError, shared> e) : st"
    "r\n{\n    match (e)\n    {\n        BadEncoding          : \"malformed certificate\",\n        Expired     "
    "         : \"certificate expired\",\n        NotYetValid          : \"certificate not yet valid\",\n      "
    "  UnknownAuthority     : \"certificate signed by an unknown authority\",\n        HostMismatch         "
    ": \"certificate is not for this host\",\n        BadSignature         : \"certificate signature does not"
    " verify\",\n        NotAuthority         : \"an issuer may not issue the certificate: not a CA, or beyo"
    "nd its path length or name constraints\",\n        UnsupportedAlgorithm : \"unsupported key or signatur"
    "e algorithm\",\n        UnhandledCritical    : \"unhandled critical extension\",\n        WrongUsage     "
    "      : \"certificate not usable for a TLS server\",\n        ChainTooLong         : \"certificate chain"
    " too long\",\n    }\n}export fn der_read(slice<u8, shared> buf, usize at) : Option<Der>\n{\n    usize n ="
    " slice_len(buf);\n    if (at + 2 > n)\n    {\n        return None;\n    }\n    u8 tag = buf[at];\n    if ("
    "(tag & 0x1f) == 0x1f)\n    {\n        return None;\n    }\n    u8 first = buf[at + 1];\n    usize len = 0"
    ";\n    usize start = at + 2;\n    if (first < 0x80)\n    {\n        len = widen<usize>(first);\n    }\n   "
    " else\n    {\n        usize count = widen<usize>(first & 0x7f);\n        if (count == 0 || count > 4 ||"
    " start + count > n || buf[start] == 0)\n        {\n            return None;\n        }\n        for (usi"
    "ze i = 0; i < count; i += 1)\n        {\n            len = (len << 8) | widen<usize>(buf[start + i]);\n"
    "        }\n        if (len < 0x80)\n        {\n            return None;\n        }\n        start += coun"
    "t;\n    }\n    if (len > n - start)\n    {\n        return None;\n    }\n    Some(Der { .tag = tag, .start"
    " = start, .end = start + len, .next = start + len })\n}unittest \"der_read: an element, its child, and"
    " a long form refused\"\n{\n    array<u8, 5> der = [0x30, 0x03, 0x02, 0x01, 0x05];\n    Der seq = Option:"
    ":unwrap(der_read(&der, 0));\n    assert(seq.tag == 0x30 && seq.start == 2 && seq.end == 5 && seq.next"
    " == 5);\n    Der int = Option::unwrap(der_read(&der, seq.start));\n    assert(int.tag == 0x02 && der[i"
    "nt.start] == 5);\n    array<u8, 4> long_form = [0x04, 0x81, 0x01, 0x00];\n    assert(Option::is_none(&"
    "der_read(&long_form, 0)));\n}fn der_expect(slice<u8, shared> buf, usize at, u8 tag) : Result<Der, Cer"
    "tError>\n{\n    match (der_read(buf, at))\n    {\n        Some(d) : if (d.tag == tag) { Ok(d) } else { E"
    "rr(BadEncoding) },\n        None    : Err(BadEncoding),\n    }\n}fn der_bytes(slice<u8, shared> buf, De"
    "r d) : Vec<u8>\n{\n    Vec::from_slice(&buf[d.start..d.end])\n}fn der_eq_hex(slice<u8, shared> buf, Der"
    " d, str hex) : bool\n{\n    Vec<u8> want = Result::unwrap_or(from_hex(StringView::of(hex)), Vec::new()"
    ");\n    d.end - d.start == Vec::len(&want) && digest_eq(&buf[d.start..d.end], &want)\n}fn hash_oid(sli"
    "ce<u8, shared> buf, Der d) : Option<HashKind>\n{\n    if (der_eq_hex(buf, d, \"608648016503040201\"))\n  "
    "  {\n        return Some(Sha2_256);\n    }\n    if (der_eq_hex(buf, d, \"608648016503040202\"))\n    {\n   "
    "     return Some(Sha2_384);\n    }\n    if (der_eq_hex(buf, d, \"608648016503040203\"))\n    {\n        re"
    "turn Some(Sha2_512);\n    }\n    None\n}fn signature_algorithm(slice<u8, shared> buf, Der alg) : Result"
    "<SignatureScheme, CertError>\n{\n    Der oid = der_expect(buf, alg.start, 0x06)?;\n    if (der_eq_hex(b"
    "uf, oid, \"2a864886f70d01010b\"))\n    {\n        return Ok(RsaPkcs1(Sha2_256));\n    }\n    if (der_eq_he"
    "x(buf, oid, \"2a864886f70d01010c\"))\n    {\n        return Ok(RsaPkcs1(Sha2_384));\n    }\n    if (der_eq"
    "_hex(buf, oid, \"2a864886f70d01010d\"))\n    {\n        return Ok(RsaPkcs1(Sha2_512));\n    }\n    if (der"
    "_eq_hex(buf, oid, \"2a8648ce3d040302\"))\n    {\n        return Ok(Ecdsa(Sha2_256));\n    }\n    if (der_e"
    "q_hex(buf, oid, \"2a8648ce3d040303\"))\n    {\n        return Ok(Ecdsa(Sha2_384));\n    }\n    if (der_eq_"
    "hex(buf, oid, \"2a8648ce3d040304\"))\n    {\n        return Ok(Ecdsa(Sha2_512));\n    }\n    if (der_eq_he"
    "x(buf, oid, \"2b6570\"))\n    {\n        return Ok(Ed25519);\n    }\n    if (der_eq_hex(buf, oid, \"2a86488"
    "6f70d01010a\"))\n    {\n        // RSASSA-PSS-params: [0] hashAlgorithm, [1] maskGenAlgorithm,\n        "
    "// [2] saltLength; the hash must be SHA-2 and MGF1 over it, and the\n        // salt as long as the d"
    "igest.\n        Der params = der_expect(buf, oid.next, 0x30)?;\n        Der h0 = der_expect(buf, param"
    "s.start, 0xa0)?;\n        Der h_alg = der_expect(buf, h0.start, 0x30)?;\n        Der h_oid = der_expec"
    "t(buf, h_alg.start, 0x06)?;\n        HashKind kind = match (hash_oid(buf, h_oid))\n        {\n         "
    "   Some(k) : k,\n            None    : return Ok(UnsupportedSignature),\n        };\n        return Ok("
    "RsaPss(kind));\n    }\n    Ok(UnsupportedSignature)\n}fn der_text(slice<u8, shared> buf, Der d) : Optio"
    "n<String>\n{\n    if (d.tag != 0x0c && d.tag != 0x13 && d.tag != 0x16 && d.tag != 0x14)\n    {\n        "
    "return None;\n    }\n    match (String::from_utf8(der_bytes(buf, d)))\n    {\n        Ok(s)  : Some(s),\n"
    "        Err(_) : None,\n    }\n}fn common_name_of(slice<u8, shared> buf, Der name) : String\n{\n    Stri"
    "ng cn = String::new();\n    usize at = name.start;\n    while (at < name.end)\n    {\n        Der set = "
    "match (der_read(buf, at))\n        {\n            Some(d) : d,\n            None    : return cn,\n      "
    "  };\n        usize inner = set.start;\n        while (inner < set.end)\n        {\n            Der atv "
    "= match (der_read(buf, inner))\n            {\n                Some(d) : d,\n                None    : "
    "return cn,\n            };\n            if (Some(oid) = der_read(buf, atv.start))\n            {\n      "
    "          if (oid.tag == 0x06 && der_eq_hex(buf, oid, \"550403\"))\n                {\n                 "
    "   if (Some(v) = der_read(buf, oid.next))\n                    {\n                        if (Some(t) "
    "= der_text(buf, v))\n                        {\n                            overwrite(&mut cn, t);\n   "
    "                     }\n                    }\n                }\n            }\n            inner = atv"
    ".next;\n        }\n        at = set.next;\n    }\n    cn\n}fn digits(slice<u8, shared> b, usize at, usize"
    " n) : Option<i64>\n{\n    i64 x = 0;\n    for (usize i = at; i < at + n; i += 1)\n    {\n        if (i >="
    " slice_len(b) || !ascii_is_digit(b[i]))\n        {\n            return None;\n        }\n        x = x *"
    " 10 + widen<i64>(b[i] - b'0');\n    }\n    Some(x)\n}fn der_time(slice<u8, shared> buf, Der d) : Result"
    "<DateTime, CertError>\n{\n    slice<u8, shared> t = &buf[d.start..d.end];\n    usize n = slice_len(t);\n"
    "    i64 year = 0;\n    usize at = 0;\n    if (d.tag == 0x17 && n == 13)\n    {\n        i64 yy = match ("
    "digits(t, 0, 2))\n        {\n            Some(y) : y,\n            None    : return Err(BadEncoding),\n "
    "       };\n        year = if (yy < 50) { 2000 + yy } else { 1900 + yy };\n        at = 2;\n    }\n    el"
    "se if (d.tag == 0x18 && n == 15)\n    {\n        year = match (digits(t, 0, 4))\n        {\n            "
    "Some(y) : y,\n            None    : return Err(BadEncoding),\n        };\n        at = 4;\n    }\n    els"
    "e\n    {\n        return Err(BadEncoding);\n    }\n    if (t[n - 1] != b'Z')\n    {\n        return Err(Ba"
    "dEncoding);\n    }\n    Option<i64> mo = digits(t, at, 2);\n    Option<i64> dd = digits(t, at + 2, 2);\n"
    "    Option<i64> hh = digits(t, at + 4, 2);\n    Option<i64> mi = digits(t, at + 6, 2);\n    Option<i64"
    "> ss = digits(t, at + 8, 2);\n    if (Some(m) = mo)\n    {\n        if (Some(day) = dd)\n        {\n     "
    "       if (Some(h) = hh)\n            {\n                if (Some(min) = mi)\n                {\n       "
    "             if (Some(sec) = ss)\n                    {\n                        if (m <= 12 && day <="
    " 31 && h <= 23 && min <= 59 && sec <= 59)\n                        {\n                            if ("
    "Some(dt) = DateTime::new(\n                                year,\n                                narr"
    "ow<u8>(m),\n                                narrow<u8>(day),\n                                narrow<u"
    "8>(h),\n                                narrow<u8>(min),\n                                narrow<u8>(s"
    "ec),\n                            ))\n                            {\n                                re"
    "turn Ok(dt);\n                            }\n                        }\n                    }\n         "
    "       }\n            }\n        }\n    }\n    Err(BadEncoding)\n}fn public_key_of(slice<u8, shared> buf,"
    " Der spki) : Result<CertKey, CertError>\n{\n    Der alg = der_expect(buf, spki.start, 0x30)?;\n    Der "
    "bits = der_expect(buf, alg.next, 0x03)?;\n    if (bits.end == bits.start || buf[bits.start] != 0)\n   "
    " {\n        return Err(BadEncoding);\n    }\n    usize key_start = bits.start + 1;\n    Der oid = der_ex"
    "pect(buf, alg.start, 0x06)?;\n    if (der_eq_hex(buf, oid, \"2a864886f70d010101\"))\n    {\n        Der s"
    "eq = der_expect(buf, key_start, 0x30)?;\n        Der n = der_expect(buf, seq.start, 0x02)?;\n        D"
    "er e = der_expect(buf, n.next, 0x02)?;\n        return Ok(RsaKey(RsaPublicKey { .n = BigUint::from_by"
    "tes_be(&buf[n.start..n.end]), .e = BigUint::from_bytes_be(&buf[e.start..e.end]) }));\n    }\n    if (d"
    "er_eq_hex(buf, oid, \"2a8648ce3d0201\"))\n    {\n        Der curve = der_expect(buf, oid.next, 0x06)?;\n "
    "       Vec<u8> point = Vec::from_slice(&buf[key_start..bits.end]);\n        if (der_eq_hex(buf, curve"
    ", \"2a8648ce3d030107\"))\n        {\n            return Ok(EcKey(EcPublicKey { .curve = P256, .point = p"
    "oint }));\n        }\n        if (der_eq_hex(buf, curve, \"2b81040022\"))\n        {\n            return O"
    "k(EcKey(EcPublicKey { .curve = P384, .point = point }));\n        }\n    }\n    if (der_eq_hex(buf, oid"
    ", \"2b6570\"))\n    {\n        if (bits.end - key_start != 32)\n        {\n            return Err(BadEncod"
    "ing);\n        }\n        array<u8, 32> k = [0; 32];\n        for (usize i = 0; i < 32; i += 1)\n       "
    " {\n            k[i] = buf[key_start + i];\n        }\n        return Ok(Ed25519Key(k));\n    }\n    Ok(U"
    "nsupportedKey)\n}export fn Certificate::parse(slice<u8, shared> der) : Result<Certificate, CertError>"
    "\n{\n    Der cert = der_expect(der, 0, 0x30)?;\n    if (cert.next != slice_len(der))\n    {\n        retu"
    "rn Err(BadEncoding);\n    }\n    Der tbs = der_expect(der, cert.start, 0x30)?;\n    Der outer_alg = der"
    "_expect(der, tbs.next, 0x30)?;\n    Der sig_bits = der_expect(der, outer_alg.next, 0x03)?;\n    if (si"
    "g_bits.next != cert.end || sig_bits.end == sig_bits.start || der[sig_bits.start] != 0)\n    {\n       "
    " return Err(BadEncoding);\n    }\n    SignatureScheme scheme = signature_algorithm(der, outer_alg)?;\n "
    "   usize at = tbs.start;\n    Der first = match (der_read(der, at))\n    {\n        Some(d) : d,\n      "
    "  None    : return Err(BadEncoding),\n    };\n    if (first.tag == 0xa0)\n    {\n        at = first.next"
    ";\n    }\n    Der serial = der_expect(der, at, 0x02)?;\n    Der inner_alg = der_expect(der, serial.next"
    ", 0x30)?;\n    // The signature algorithm inside the signed part must be the outer one.\n    if (inner"
    "_alg.end - inner_alg.start != outer_alg.end - outer_alg.start || !digest_eq(\n        &der[inner_alg."
    "start..inner_alg.end],\n        &der[outer_alg.start..outer_alg.end],\n    ))\n    {\n        return Err"
    "(BadEncoding);\n    }\n    Der issuer = der_expect(der, inner_alg.next, 0x30)?;\n    Der validity = der"
    "_expect(der, issuer.next, 0x30)?;\n    Der nb = match (der_read(der, validity.start))\n    {\n        S"
    "ome(d) : d,\n        None    : return Err(BadEncoding),\n    };\n    Der na = match (der_read(der, nb.n"
    "ext))\n    {\n        Some(d) : d,\n        None    : return Err(BadEncoding),\n    };\n    DateTime not_"
    "before = der_time(der, nb)?;\n    DateTime not_after = der_time(der, na)?;\n    Der subject = der_expe"
    "ct(der, validity.next, 0x30)?;\n    Der spki = der_expect(der, subject.next, 0x30)?;\n    CertKey key "
    "= public_key_of(der, spki)?;\n    Certificate c = Certificate { .der = Vec::from_slice(der), .tbs = V"
    "ec::from_slice(&der[cert.start..tbs.next]), .issuer = Vec::from_slice(&der[inner_alg.next..issuer.ne"
    "xt]), .subject = Vec::from_slice(&der[validity.next..subject.next]), .common_name = common_name_of(\n"
    "        der,\n        subject,\n    ), .not_before = not_before, .not_after = not_after, .dns_names = "
    "Vec::new(), .ip_addresses = Vec::new(), .is_ca = false, .max_path_len = -1, .can_sign_certificates ="
    " true, .server_auth = true, .unhandled_critical = false, .key = key, .scheme = scheme, .signature = "
    "Vec::from_slice(&der[sig_bits.start + 1..sig_bits.end]), .permitted_dns = Vec::new(), .excluded_dns "
    "= Vec::new(), .permitted_ip = Vec::new(), .excluded_ip = Vec::new() };\n    at = spki.next;\n    while"
    " (at < tbs.end)\n    {\n        Der field = match (der_read(der, at))\n        {\n            Some(d) : "
    "d,\n            None    : return Err(BadEncoding),\n        };\n        if (field.tag == 0xa3)\n        "
    "{\n            Der exts = der_expect(der, field.start, 0x30)?;\n            usize e_at = exts.start;\n "
    "           while (e_at < exts.end)\n            {\n                Der ext = der_expect(der, e_at, 0x3"
    "0)?;\n                Der oid = der_expect(der, ext.start, 0x06)?;\n                usize v_at = oid.n"
    "ext;\n                bool critical = false;\n                Der maybe = match (der_read(der, v_at))\n"
    "                {\n                    Some(d) : d,\n                    None    : return Err(BadEncod"
    "ing),\n                };\n                if (maybe.tag == 0x01)\n                {\n                  "
    "  critical = maybe.end > maybe.start && der[maybe.start] != 0;\n                    v_at = maybe.next"
    ";\n                }\n                Der value = der_expect(der, v_at, 0x04)?;\n                if (de"
    "r_eq_hex(der, oid, \"551d11\"))\n                {\n                    Der names = der_expect(der, valu"
    "e.start, 0x30)?;\n                    usize n_at = names.start;\n                    while (n_at < nam"
    "es.end)\n                    {\n                        Der g = match (der_read(der, n_at))\n          "
    "              {\n                            Some(d) : d,\n                            None    : retur"
    "n Err(BadEncoding),\n                        };\n                        if (g.tag == 0x82)\n          "
    "              {\n                            if (Ok(s) = String::from_utf8(der_bytes(der, g)))\n      "
    "                      {\n                                Vec::push(&mut c.dns_names, s);\n            "
    "                }\n                        }\n                        else if (g.tag == 0x87)\n        "
    "                {\n                            usize len = g.end - g.start;\n                         "
    "   if (len == 4)\n                            {\n                                Vec::push(\n          "
    "                          &mut c.ip_addresses,\n                                    V4([der[g.start],"
    " der[g.start + 1], der[g.start + 2], der[g.start + 3]]),\n                                );\n        "
    "                    }\n                            else if (len == 16)\n                            {\n"
    "                                array<u8, 16> a = [0; 16];\n                                for (usiz"
    "e i = 0; i < 16; i += 1)\n                                {\n                                    a[i] "
    "= der[g.start + i];\n                                }\n                                Vec::push(&mut"
    " c.ip_addresses, V6(a));\n                            }\n                        }\n                   "
    "     n_at = g.next;\n                    }\n                }\n                else if (der_eq_hex(der,"
    " oid, \"551d13\"))\n                {\n                    Der bc = der_expect(der, value.start, 0x30)?;"
    "\n                    usize b_at = bc.start;\n                    if (b_at < bc.end)\n                 "
    "   {\n                        Der x = match (der_read(der, b_at))\n                        {\n         "
    "                   Some(d) : d,\n                            None    : return Err(BadEncoding),\n     "
    "                   };\n                        if (x.tag == 0x01)\n                        {\n         "
    "                   c.is_ca = x.end > x.start && der[x.start] != 0;\n                            b_at "
    "= x.next;\n                        }\n                    }\n                    if (b_at < bc.end)\n   "
    "                 {\n                        Der pl = der_expect(der, b_at, 0x02)?;\n                  "
    "      i64 v = 0;\n                        for (usize i = pl.start; i < pl.end && i < pl.start + 4; i "
    "+= 1)\n                        {\n                            v = (v << 8) | widen<i64>(der[i]);\n     "
    "                   }\n                        c.max_path_len = v;\n                    }\n             "
    "   }\n                else if (der_eq_hex(der, oid, \"551d0f\"))\n                {\n                    "
    "Der ku = der_expect(der, value.start, 0x03)?;\n                    // Bit 5, keyCertSign, of the firs"
    "t byte after the\n                    // unused-bits count.\n                    c.can_sign_certificat"
    "es = ku.end - ku.start >= 2 && (der[ku.start + 1] & 0x04) != 0;\n                }\n                el"
    "se if (der_eq_hex(der, oid, \"551d25\"))\n                {\n                    Der eku = der_expect(de"
    "r, value.start, 0x30)?;\n                    bool server = false;\n                    usize k_at = ek"
    "u.start;\n                    while (k_at < eku.end)\n                    {\n                        De"
    "r p = der_expect(der, k_at, 0x06)?;\n                        if (der_eq_hex(der, p, \"2b06010505070301"
    "\") || der_eq_hex(der, p, \"551d2500\"))\n                        {\n                            server ="
    " true;\n                        }\n                        k_at = p.next;\n                    }\n      "
    "              c.server_auth = server;\n                }\n                else if (der_eq_hex(der, oid"
    ", \"551d1e\"))\n                {\n                    // Name constraints: the dNSName and iPAddress su"
    "btrees\n                    // are kept for `verify_chain`; a subtree of another\n                    "
    "// form, or with a minimum or maximum, is one this side\n                    // cannot process, so a "
    "critical extension holding one\n                    // makes the certificate unusable (RFC 5280 §4.2"
    ").\n                    Der nc = der_expect(der, value.start, 0x30)?;\n                    usize s_at "
    "= nc.start;\n                    while (s_at < nc.end)\n                    {\n                        "
    "Der trees = match (der_read(der, s_at))\n                        {\n                            Some(d"
    ") : d,\n                            None    : return Err(BadEncoding),\n                        };\n   "
    "                     if (trees.tag != 0xa0 && trees.tag != 0xa1)\n                        {\n         "
    "                   return Err(BadEncoding);\n                        }\n                        bool p"
    "ermitted = trees.tag == 0xa0;\n                        usize t_at = trees.start;\n                    "
    "    while (t_at < trees.end)\n                        {\n                            Der sub = der_exp"
    "ect(der, t_at, 0x30)?;\n                            Der base = match (der_read(der, sub.start))\n     "
    "                       {\n                                Some(d) : d,\n                              "
    "  None    : return Err(BadEncoding),\n                            };\n                            bool"
    " understood = false;\n                            if (base.next == sub.end && base.tag == 0x82)\n     "
    "                       {\n                                if (Ok(name) = String::from_utf8(der_bytes("
    "der, base)))\n                                {\n                                    understood = true"
    ";\n                                    if (permitted)\n                                    {\n         "
    "                               Vec::push(&mut c.permitted_dns, name);\n                              "
    "      }\n                                    else\n                                    {\n             "
    "                           Vec::push(&mut c.excluded_dns, name);\n                                   "
    " }\n                                }\n                            }\n                            else "
    "if (base.next == sub.end && base.tag == 0x87 && (base.end - base.start == 8 || base.end - base.start"
    " == 32))\n                            {\n                                understood = true;\n          "
    "                      if (permitted)\n                                {\n                             "
    "       Vec::push(&mut c.permitted_ip, der_bytes(der, base));\n                                }\n     "
    "                           else\n                                {\n                                  "
    "  Vec::push(&mut c.excluded_ip, der_bytes(der, base));\n                                }\n           "
    "                 }\n                            if (!understood && critical)\n                        "
    "    {\n                                c.unhandled_critical = true;\n                            }\n   "
    "                         t_at = sub.next;\n                        }\n                        s_at = t"
    "rees.next;\n                    }\n                }\n                else if (critical && !der_eq_hex("
    "der, oid, \"551d20\"))\n                {\n                    // An unknown critical extension; certifi"
    "cate policies\n                    // are tolerated unread (D-0160).\n                    c.unhandled_"
    "critical = true;\n                }\n                e_at = ext.next;\n            }\n        }\n        "
    "at = field.next;\n    }\n    Ok(c)\n}export fn certificates_from_pem(StringView text) : Vec<Certificate"
    ">\n{\n    Vec<Certificate> out = Vec::new();\n    StringView begin = \"-----BEGIN CERTIFICATE-----\";\n   "
    " StringView end = \"-----END CERTIFICATE-----\";\n    usize at = 0;\n    usize n = StringView::len(text)"
    ";\n    while (at < n)\n    {\n        StringView rest = &text[at..n];\n        usize b = match (StringVi"
    "ew::find(rest, begin))\n        {\n            Some(i) : i,\n            None    : break,\n        };\n  "
    "      StringView body = &rest[b + StringView::len(begin)..$];\n        usize e = match (StringView::f"
    "ind(body, end))\n        {\n            Some(i) : i,\n            None    : break,\n        };\n        S"
    "tring b64 = String::new();\n        StringView block = &body[0..e];\n        // A byte that is not ASC"
    "II (so not base64 either) makes the block\n        // malformed: skipped, like one whose base64 does "
    "not decode.\n        bool clean = true;\n        for (usize i = 0; i < StringView::len(block); i += 1)"
    "\n        {\n            u8 c = block.bytes[i];\n            if (c >= 128)\n            {\n              "
    "  clean = false;\n                break;\n            }\n            if (!ascii_is_space(c))\n          "
    "  {\n                String::push_ascii(&mut b64, c);\n            }\n        }\n        if (clean)\n    "
    "    {\n            if (Ok(der) = base64_decode(&b64))\n            {\n                if (Ok(cert) = Ce"
    "rtificate::parse(&der))\n                {\n                    Vec::push(&mut out, cert);\n           "
    "     }\n            }\n        }\n        at = at + b + StringView::len(begin) + e + StringView::len(en"
    "d);\n    }\n    out\n}unittest \"certificates_from_pem: a malformed block is skipped\"\n{\n    StringView t"
    "ext = \"junk\\n-----BEGIN CERTIFICATE-----\\nnot base64!\\n-----END CERTIFICATE-----\\n\";\n    Vec<Certifi"
    "cate> certs = certificates_from_pem(text);\n    assert(Vec::len(&certs) == 0);\n}export fn TrustStore:"
    ":new() : TrustStore\n{\n    TrustStore { .roots = Vec::new() }\n}export fn TrustStore::add(ref<TrustSto"
    "re, exclusive> t, Certificate root)\n{\n    Vec::push(&mut t.roots, root);\n}export fn TrustStore::from"
    "_pem_file(StringView path) : Result<TrustStore, FileError>\n{\n    String text = read_file(path)?;\n   "
    " Ok(TrustStore { .roots = certificates_from_pem(&text) })\n}export fn TrustStore::system() : Result<T"
    "rustStore, FileError>\n{\n    array<str, 5> paths = [\n        \"/etc/ssl/certs/ca-certificates.crt\",\n  "
    "      \"/etc/pki/tls/certs/ca-bundle.crt\",\n        \"/etc/ssl/ca-bundle.pem\",\n        \"/etc/ssl/cert.p"
    "em\",\n        \"/usr/local/etc/openssl/cert.pem\",\n    ];\n    foreach (p in &paths)\n    {\n        if (O"
    "k(t) = TrustStore::from_pem_file(StringView::of(*p)))\n        {\n            if (Vec::len(&t.roots) >"
    " 0)\n            {\n                return Ok(t);\n            }\n        }\n    }\n    Err(NotFound)\n}exp"
    "ort fn verify_signature(\n    ref<CertKey, shared> key,\n    ref<SignatureScheme, shared> scheme,\n    "
    "slice<u8, shared> message,\n    slice<u8, shared> signature,\n) : bool\n{\n    match (scheme)\n    {\n    "
    "    RsaPkcs1(h) : match (key)\n        {\n            RsaKey(k) : rsa_verify_pkcs1v15(k, *h, &hash(*h,"
    " message), signature),\n            _         : false,\n        },\n        RsaPss(h) : match (key)\n   "
    "     {\n            RsaKey(k) : rsa_verify_pss(k, *h, &hash(*h, message), signature),\n            _  "
    "       : false,\n        },\n        Ecdsa(h) : match (key)\n        {\n            EcKey(k) : ecdsa_ver"
    "ify(k.curve, &k.point, &hash(*h, message), signature),\n            _        : false,\n        },\n    "
    "    Ed25519 : match (key)\n        {\n            Ed25519Key(k) : ed25519_verify(k, message, signature"
    "),\n            _             : false,\n        },\n        UnsupportedSignature : false,\n    }\n}fn asc"
    "ii_lower_eq(StringView a, StringView b) : bool\n{\n    if (StringView::len(a) != StringView::len(b))\n "
    "   {\n        return false;\n    }\n    for (usize i = 0; i < StringView::len(a); i += 1)\n    {\n       "
    " u8 x = a.bytes[i];\n        u8 y = b.bytes[i];\n        if (ascii_is_upper(x))\n        {\n            "
    "x += 32;\n        }\n        if (ascii_is_upper(y))\n        {\n            y += 32;\n        }\n        i"
    "f (x != y)\n        {\n            return false;\n        }\n    }\n    true\n}fn name_matches(StringView "
    "pattern, StringView host) : bool\n{\n    if (StringView::starts_with(pattern, \"*.\"))\n    {\n        Str"
    "ingView suffix = &pattern[1..$];\n        match (StringView::find(host, \".\"))\n        {\n            S"
    "ome(dot) : dot > 0 && ascii_lower_eq(\n                suffix,\n                &host[dot..$],\n       "
    "     ) && Option::is_some(&StringView::find(&suffix[1..$], \".\")),\n            None : false,\n        "
    "}\n    }\n    else\n    {\n        ascii_lower_eq(pattern, host)\n    }\n}export fn Certificate::matches_h"
    "ost(ref<Certificate, shared> c, StringView host) : bool\n{\n    if (Ok(ip) = IpAddr::parse(host))\n    "
    "{\n        foreach (a in &c.ip_addresses)\n        {\n            if (IpAddr::text(a) == IpAddr::text(&"
    "ip))\n            {\n                return true;\n            }\n        }\n        return false;\n    }\n"
    "    StringView h = if (StringView::ends_with(\n        host,\n        \".\",\n    )) { &host[0..StringVie"
    "w::len(host) - 1] } else { host };\n    foreach (n in &c.dns_names)\n    {\n        if (name_matches(n,"
    " h))\n        {\n            return true;\n        }\n    }\n    false\n}fn check_time(ref<Certificate, sh"
    "ared> c, ref<DateTime, shared> now) : Result<void, CertError>\n{\n    if (DateTime::less(now, &c.not_b"
    "efore))\n    {\n        return Err(NotYetValid);\n    }\n    if (DateTime::less(&c.not_after, now))\n    "
    "{\n        return Err(Expired);\n    }\n    if (c.unhandled_critical)\n    {\n        return Err(Unhandle"
    "dCritical);\n    }\n    Ok(())\n}fn same_bytes(ref<Vec<u8>, shared> a, ref<Vec<u8>, shared> b) : bool\n{"
    "\n    Vec::len(a) == Vec::len(b) && digest_eq(a, b)\n}fn dns_within(StringView name, StringView base) "
    ": bool\n{\n    StringView b = base;\n    bool below_only = StringView::starts_with(b, \".\");\n    if (bel"
    "ow_only)\n    {\n        b = &b[1..$];\n    }\n    usize bl = StringView::len(b);\n    if (bl == 0)\n    {"
    "\n        return true;\n    }\n    usize nl = StringView::len(name);\n    if (!below_only && ascii_lower"
    "_eq(name, b))\n    {\n        return true;\n    }\n    nl > bl && name.bytes[nl - bl - 1] == b'.' && asc"
    "ii_lower_eq(&name[nl - bl..$], b)\n}unittest \"dns_within: name-constraint subtrees\"\n{\n    assert(dns_"
    "within(\"good.test\", \"good.test\") && dns_within(\"a.Good.Test\", \"good.test\"));\n    assert(!dns_within("
    "\"evil.example\", \"good.test\") && !dns_within(\"notgood.test\", \"good.test\"));\n    assert(!dns_within(\"g"
    "ood.test\", \".good.test\") && dns_within(\"a.good.test\", \".good.test\"));\n    assert(dns_within(\"*.good."
    "test\", \"good.test\") && !dns_within(\"*.test\", \"good.test\"));\n}fn ip_bytes(ref<IpAddr, shared> a) : Ve"
    "c<u8>\n{\n    Vec<u8> v = Vec::new();\n    match (a)\n    {\n        V4(b) :\n        {\n            for (u"
    "size i = 0; i < 4; i += 1)\n            {\n                Vec::push(&mut v, b[i]);\n            }\n    "
    "    },\n        V6(b) :\n        {\n            for (usize i = 0; i < 16; i += 1)\n            {\n       "
    "         Vec::push(&mut v, b[i]);\n            }\n        },\n    }\n    v\n}fn ip_within(ref<Vec<u8>, sh"
    "ared> ip, ref<Vec<u8>, shared> tree) : bool\n{\n    usize n = Vec::len(ip);\n    if (Vec::len(tree) != "
    "2 * n)\n    {\n        return false;\n    }\n    for (usize i = 0; i < n; i += 1)\n    {\n        if ((ip["
    "i] & tree[n + i]) != (tree[i] & tree[n + i]))\n        {\n            return false;\n        }\n    }\n  "
    "  true\n}fn names_allowed(ref<Certificate, shared> ca, ref<Certificate, shared> c) : bool\n{\n    dns_n"
    "ames_allowed(ca, &c.dns_names) && ips_allowed(ca, &c.ip_addresses)\n}fn host_allowed(ref<Certificate,"
    " shared> ca, StringView host) : bool\n{\n    if (Ok(ip) = IpAddr::parse(host))\n    {\n        Vec<IpAdd"
    "r> one = Vec::new();\n        Vec::push(&mut one, ip);\n        return ips_allowed(ca, &one);\n    }\n  "
    "  StringView h = if (StringView::ends_with(host, \".\")) { &host[0..StringView::len(host) - 1] } else "
    "{ host };\n    Vec<String> one = Vec::new();\n    Vec::push(&mut one, String::copy(h));\n    dns_names_"
    "allowed(ca, &one)\n}fn dns_names_allowed(ref<Certificate, shared> ca, ref<Vec<String>, shared> names)"
    " : bool\n{\n    foreach (n in names)\n    {\n        if (Vec::len(&ca.permitted_dns) > 0)\n        {\n    "
    "        bool inside = false;\n            foreach (p in &ca.permitted_dns)\n            {\n            "
    "    if (dns_within(n, p))\n                {\n                    inside = true;\n                }\n   "
    "         }\n            if (!inside)\n            {\n                return false;\n            }\n      "
    "  }\n        foreach (e in &ca.excluded_dns)\n        {\n            if (dns_within(n, e))\n            "
    "{\n                return false;\n            }\n        }\n    }\n    true\n}fn ips_allowed(ref<Certifica"
    "te, shared> ca, ref<Vec<IpAddr>, shared> addrs) : bool\n{\n    foreach (a in addrs)\n    {\n        Vec<"
    "u8> ip = ip_bytes(a);\n        if (Vec::len(&ca.permitted_ip) > 0)\n        {\n            bool inside "
    "= false;\n            foreach (p in &ca.permitted_ip)\n            {\n                if (ip_within(&ip"
    ", p))\n                {\n                    inside = true;\n                }\n            }\n         "
    "   if (!inside)\n            {\n                return false;\n            }\n        }\n        foreach "
    "(e in &ca.excluded_ip)\n        {\n            if (ip_within(&ip, e))\n            {\n                re"
    "turn false;\n            }\n        }\n    }\n    true\n}fn issuer_ok(\n    ref<Certificate, shared> ca,\n "
    "   ref<Vec<Certificate>, shared> path,\n    ref<DateTime, shared> now,\n    StringView host,\n) : Resul"
    "t<void, CertError>\n{\n    if (!ca.is_ca || !ca.can_sign_certificates)\n    {\n        return Err(NotAut"
    "hority);\n    }\n    if (!ca.server_auth)\n    {\n        return Err(WrongUsage);\n    }\n    usize below "
    "= Vec::len(path) - 1;\n    if (ca.max_path_len >= 0 && narrow<i64>(below) > ca.max_path_len)\n    {\n  "
    "      return Err(NotAuthority);\n    }\n    check_time(ca, now)?;\n    if (!host_allowed(ca, host))\n   "
    " {\n        return Err(NotAuthority);\n    }\n    foreach (c in path)\n    {\n        if (!names_allowed("
    "ca, c))\n        {\n            return Err(NotAuthority);\n        }\n    }\n    Ok(())\n}fn chain_search("
    "\n    ref<Vec<Certificate>, exclusive> path,\n    slice<Certificate, shared> intermediates,\n    ref<Tr"
    "ustStore, shared> roots,\n    ref<DateTime, shared> now,\n    StringView host,\n    ref<ChainSearch, ex"
    "clusive> st,\n) : bool\n{\n    Certificate current = Certificate::clone(&path[Vec::len(path) - 1]);\n   "
    " foreach (r in &roots.roots)\n    {\n        if (same_bytes(&r.subject, &current.issuer))\n        {\n  "
    "          if (st.budget == 0)\n            {\n                return false;\n            }\n            "
    "st.budget -= 1;\n            if (verify_signature(&r.key, &current.scheme, &current.tbs, &current.sig"
    "nature))\n            {\n                match (issuer_ok(r, path, now, host))\n                {\n     "
    "               Ok(_)  : return true,\n                    Err(e) : st.last = e,\n                }\n   "
    "         }\n        }\n    }\n    for (usize i = 0; i < slice_len(intermediates); i += 1)\n    {\n       "
    " ref<Certificate, shared> m = &intermediates[i];\n        if (!same_bytes(&m.subject, &current.issuer"
    "))\n        {\n            continue;\n        }\n        bool seen = false;\n        foreach (p in path)\n"
    "        {\n            if (same_bytes(&p.der, &m.der))\n            {\n                seen = true;\n   "
    "         }\n        }\n        if (seen)\n        {\n            continue;\n        }\n        if (Vec::le"
    "n(path) >= 10)\n        {\n            st.last = ChainTooLong;\n            return false;\n        }\n   "
    "     if (st.budget == 0)\n        {\n            return false;\n        }\n        st.budget -= 1;\n     "
    "   if (!verify_signature(&m.key, &current.scheme, &current.tbs, &current.signature))\n        {\n     "
    "       st.last = BadSignature;\n            continue;\n        }\n        if (Err(e) = issuer_ok(m, pat"
    "h, now, host))\n        {\n            st.last = e;\n            continue;\n        }\n        Vec::push("
    "path, Certificate::clone(m));\n        if (chain_search(path, intermediates, roots, now, host, st))\n "
    "       {\n            return true;\n        }\n        _ = Vec::pop(path);\n    }\n    false\n}export fn v"
    "erify_chain(\n    ref<Certificate, shared> leaf,\n    slice<Certificate, shared> intermediates,\n    re"
    "f<TrustStore, shared> roots,\n    StringView host,\n    ref<DateTime, shared> now,\n) : Result<void, Ce"
    "rtError>\n{\n    if (!Certificate::matches_host(leaf, host))\n    {\n        return Err(HostMismatch);\n "
    "   }\n    if (!leaf.server_auth)\n    {\n        return Err(WrongUsage);\n    }\n    check_time(leaf, now"
    ")?;\n    Vec<Certificate> path = Vec::new();\n    Vec::push(&mut path, Certificate::clone(leaf));\n    "
    "ChainSearch st = ChainSearch { .last = UnknownAuthority, .budget = 100 };\n    if (chain_search(&mut "
    "path, intermediates, roots, now, host, &mut st))\n    {\n        return Ok(());\n    }\n    Err(st.last)"
    "\n}fn der_push_len(ref<Vec<u8>, exclusive> out, usize len)\n{\n    if (len < 0x80)\n    {\n        Vec::p"
    "ush(out, narrow<u8>(len));\n        return;\n    }\n    usize count = 1;\n    while ((len >> narrow<u32>"
    "(8 * count)) != 0)\n    {\n        count += 1;\n    }\n    Vec::push(out, 0x80 | narrow<u8>(count));\n   "
    " for (usize i = 0; i < count; i += 1)\n    {\n        Vec::push(out, narrow_wrapping<u8>(len >> narrow"
    "<u32>(8 * (count - 1 - i))));\n    }\n}fn der_wrap(u8 tag, slice<u8, shared> content) : Vec<u8>\n{\n    "
    "Vec<u8> out = Vec::new();\n    Vec::push(&mut out, tag);\n    der_push_len(&mut out, slice_len(content"
    "));\n    Vec::extend_from(&mut out, content);\n    out\n}fn der_uint(slice<u8, shared> v) : Vec<u8>\n{\n "
    "   usize from = 0;\n    while (from + 1 < slice_len(v) && v[from] == 0)\n    {\n        from += 1;\n    "
    "}\n    Vec<u8> content = Vec::new();\n    if (slice_len(v) == 0 || (v[from] & 0x80) != 0)\n    {\n      "
    "  Vec::push(&mut content, 0);\n    }\n    Vec::extend_from(&mut content, &v[from..$]);\n    der_wrap(0x"
    "02, &content)\n}fn der_big(ref<BigUint, shared> a) : Vec<u8>\n{\n    der_uint(&BigUint::to_bytes_be(a))"
    "\n}fn der_oid_hex(str hex) : Vec<u8>\n{\n    Vec<u8> b = Result::unwrap_or(from_hex(StringView::of(hex)"
    "), Vec::new());\n    der_wrap(0x06, &b)\n}fn der_bit_string(slice<u8, shared> bytes) : Vec<u8>\n{\n    V"
    "ec<u8> content = Vec::new();\n    Vec::push(&mut content, 0);\n    Vec::extend_from(&mut content, byte"
    "s);\n    der_wrap(0x03, &content)\n}fn curve_oid_hex(EcCurve c) : str\n{\n    match (c)\n    {\n        P2"
    "56 : \"2a8648ce3d030107\",\n        P384 : \"2b81040022\",\n    }\n}fn key_algorithm(ref<CertKey, shared> k"
    "ey) : Vec<u8>\n{\n    Vec<u8> content = match (key)\n    {\n        RsaKey(_)      :\n        {\n         "
    "   Vec<u8> c = der_oid_hex(\"2a864886f70d010101\");\n            Vec::push(&mut c, 0x05);\n            V"
    "ec::push(&mut c, 0x00);\n            c\n        },\n        EcKey(k)       :\n        {\n            Vec<"
    "u8> c = der_oid_hex(\"2a8648ce3d0201\");\n            Vec::extend_from(&mut c, &der_oid_hex(curve_oid_h"
    "ex(k.curve)));\n            c\n        },\n        Ed25519Key(_)  : der_oid_hex(\"2b6570\"),\n        Unsu"
    "pportedKey : Vec::new(),\n    };\n    der_wrap(0x30, &content)\n}export fn CertKey::to_der(ref<CertKey,"
    " shared> key) : Option<Vec<u8>>\n{\n    Vec<u8> bits = match (key)\n    {\n        RsaKey(k)      :\n    "
    "    {\n            Vec<u8> seq = der_big(&k.n);\n            Vec::extend_from(&mut seq, &der_big(&k.e)"
    ");\n            der_wrap(0x30, &seq)\n        },\n        EcKey(k)       : Vec::clone(&k.point),\n      "
    "  Ed25519Key(k)  : Vec::from_slice(k),\n        UnsupportedKey : return None,\n    };\n    Vec<u8> cont"
    "ent = key_algorithm(key);\n    Vec::extend_from(&mut content, &der_bit_string(&bits));\n    Some(der_w"
    "rap(0x30, &content))\n}export fn CertKey::from_der(slice<u8, shared> der) : Result<CertKey, CertError"
    ">\n{\n    Der spki = der_expect(der, 0, 0x30)?;\n    if (spki.next != slice_len(der))\n    {\n        ret"
    "urn Err(BadEncoding);\n    }\n    match (public_key_of(der, spki)?)\n    {\n        UnsupportedKey : Err"
    "(UnsupportedAlgorithm),\n        k              : Ok(k),\n    }\n}fn pem_block(StringView text, slice<s"
    "tr, shared> labels) : Result<Vec<u8>, CertError>\n{\n    // The earliest BEGIN line of any of the labe"
    "ls.\n    Option<usize> first = None;\n    usize at = 0;\n    for (usize i = 0; i < slice_len(labels); i"
    " += 1)\n    {\n        String begin = \"-----BEGIN \";\n        String::append(&mut begin, labels[i]);\n  "
    "      String::append(&mut begin, \"-----\");\n        if (Some(v) = StringView::find(text, &begin))\n   "
    "     {\n            if (Option::is_none(&first) || v < at)\n            {\n                first = Some"
    "(i);\n                at = v;\n            }\n        }\n    }\n    usize i = match (first)\n    {\n       "
    " Some(i) : i,\n        None    :\n        {\n            if (Option::is_some(&StringView::find(text, \"-"
    "----BEGIN ENCRYPTED PRIVATE KEY-----\")))\n            {\n                return Err(UnsupportedAlgorit"
    "hm);\n            }\n            return Err(BadEncoding);\n        },\n    };\n    String begin = \"-----B"
    "EGIN \";\n    String::append(&mut begin, labels[i]);\n    String::append(&mut begin, \"-----\");\n    Stri"
    "ng end = \"-----END \";\n    String::append(&mut end, labels[i]);\n    String::append(&mut end, \"-----\")"
    ";\n    StringView body = &text[at + StringView::len(&begin)..$];\n    usize e = match (StringView::fin"
    "d(body, &end))\n    {\n        Some(v) : v,\n        None    : return Err(BadEncoding),\n    };\n    Stri"
    "ng b64 = String::new();\n    StringView block = &body[0..e];\n    for (usize k = 0; k < StringView::le"
    "n(block); k += 1)\n    {\n        u8 c = block.bytes[k];\n        if (c >= 128)\n        {\n            r"
    "eturn Err(BadEncoding);\n        }\n        if (!ascii_is_space(c))\n        {\n            String::push"
    "_ascii(&mut b64, c);\n        }\n    }\n    match (base64_decode(&b64))\n    {\n        Ok(der) : Ok(der)"
    ",\n        Err(_)  : Err(BadEncoding),\n    }\n}fn pem_of(str label, slice<u8, shared> der) : String\n{\n"
    "    String out = \"-----BEGIN \";\n    String::append(&mut out, label);\n    String::append(&mut out, \"-"
    "----\\n\");\n    String b64 = base64_encode(der);\n    usize n = StringView::len(&b64);\n    for (usize a"
    "t = 0; at < n; at += 64)\n    {\n        String::append(&mut out, &b64[at..min(at + 64, n)]);\n        "
    "String::append(&mut out, \"\\n\");\n    }\n    String::append(&mut out, \"-----END \");\n    String::append("
    "&mut out, label);\n    String::append(&mut out, \"-----\\n\");\n    out\n}export fn CertKey::from_pem(Stri"
    "ngView text) : Result<CertKey, CertError>\n{\n    array<str, 1> labels = [\"PUBLIC KEY\"];\n    Vec<u8> d"
    "er = pem_block(text, &labels)?;\n    CertKey::from_der(&der)\n}export fn CertKey::to_pem(ref<CertKey, "
    "shared> key) : Option<String>\n{\n    Some(pem_of(\"PUBLIC KEY\", &CertKey::to_der(key)?))\n}unittest \"Ce"
    "rtKey::to_pem: read back by from_pem\"\n{\n    CertKey key = Ed25519Key([0x42; 32]);\n    String pem = O"
    "ption::unwrap(CertKey::to_pem(&key));\n    assert(StringView::starts_with(&pem, \"-----BEGIN PUBLIC KE"
    "Y-----\\n\"));\n    match (CertKey::from_pem(&pem))\n    {\n        Ok(Ed25519Key(k)) : assert(k[0] == 0x"
    "42 && k[31] == 0x42),\n        _                 : assert(false),\n    }\n}export fn PrivateKey::public"
    "_key(ref<PrivateKey, shared> key) : CertKey\n{\n    match (key)\n    {\n        RsaPrivate(k)     : RsaK"
    "ey(RsaPrivateKey::public_key(k)),\n        EcPrivate(k) : EcKey(EcPublicKey { .curve = k.curve, .poin"
    "t = Option::unwrap_or(\n            ec_public_key(k.curve, &k.scalar),\n            Vec::new(),\n      "
    "  ) }),\n        Ed25519Private(k) : Ed25519Key(ed25519_public_key(k)),\n    }\n}fn rsa_private_of(slic"
    "e<u8, shared> buf, usize at) : Result<PrivateKey, CertError>\n{\n    Der seq = der_expect(buf, at, 0x3"
    "0)?;\n    Der version = der_expect(buf, seq.start, 0x02)?;\n    Der n = der_expect(buf, version.next, "
    "0x02)?;\n    Der e = der_expect(buf, n.next, 0x02)?;\n    Der d = der_expect(buf, e.next, 0x02)?;\n    "
    "Der p = der_expect(buf, d.next, 0x02)?;\n    Der q = der_expect(buf, p.next, 0x02)?;\n    match (RsaPr"
    "ivateKey::new(\n        BigUint::from_bytes_be(&buf[n.start..n.end]),\n        BigUint::from_bytes_be("
    "&buf[e.start..e.end]),\n        BigUint::from_bytes_be(&buf[d.start..d.end]),\n        BigUint::from_b"
    "ytes_be(&buf[p.start..p.end]),\n        BigUint::from_bytes_be(&buf[q.start..q.end]),\n    ))\n    {\n  "
    "      Some(k) : Ok(RsaPrivate(k)),\n        None    : Err(BadEncoding),\n    }\n}fn ec_private_of(slice"
    "<u8, shared> buf, usize at, Option<EcCurve> curve) : Result<PrivateKey, CertError>\n{\n    Der seq = d"
    "er_expect(buf, at, 0x30)?;\n    Der version = der_expect(buf, seq.start, 0x02)?;\n    Der scalar = der"
    "_expect(buf, version.next, 0x04)?;\n    Option<EcCurve> found = curve;\n    usize p_at = scalar.next;\n"
    "    while (p_at < seq.end)\n    {\n        Der field = match (der_read(buf, p_at))\n        {\n         "
    "   Some(v) : v,\n            None    : return Err(BadEncoding),\n        };\n        if (field.tag == 0"
    "xa0)\n        {\n            Der oid = der_expect(buf, field.start, 0x06)?;\n            if (der_eq_hex"
    "(buf, oid, \"2a8648ce3d030107\"))\n            {\n                found = Some(P256);\n            }\n    "
    "        else if (der_eq_hex(buf, oid, \"2b81040022\"))\n            {\n                found = Some(P384"
    ");\n            }\n            else\n            {\n                return Err(UnsupportedAlgorithm);\n  "
    "          }\n        }\n        p_at = field.next;\n    }\n    EcCurve c = match (found)\n    {\n        S"
    "ome(v) : v,\n        None    : return Err(UnsupportedAlgorithm),\n    };\n    Vec<u8> k = Vec::from_sli"
    "ce(&buf[scalar.start..scalar.end]);\n    usize want = if (c == P256) { 32 } else { 48 };\n    if (Vec:"
    ":len(&k) != want || Option::is_none(&ec_public_key(c, &k)))\n    {\n        return Err(BadEncoding);\n "
    "   }\n    Ok(EcPrivate(EcPrivateKey { .curve = c, .scalar = k }))\n}export fn PrivateKey::from_der(sli"
    "ce<u8, shared> der) : Result<PrivateKey, CertError>\n{\n    Der seq = der_expect(der, 0, 0x30)?;\n    i"
    "f (seq.next != slice_len(der))\n    {\n        return Err(BadEncoding);\n    }\n    Der version = der_ex"
    "pect(der, seq.start, 0x02)?;\n    Der second = match (der_read(der, version.next))\n    {\n        Some"
    "(v) : v,\n        None    : return Err(BadEncoding),\n    };\n    if (second.tag == 0x02)\n    {\n       "
    " return rsa_private_of(der, 0);\n    }\n    if (second.tag == 0x04)\n    {\n        return ec_private_of"
    "(der, 0, None);\n    }\n    if (second.tag != 0x30)\n    {\n        return Err(BadEncoding);\n    }\n    D"
    "er oid = der_expect(der, second.start, 0x06)?;\n    Der key = der_expect(der, second.next, 0x04)?;\n  "
    "  if (der_eq_hex(der, oid, \"2a864886f70d010101\"))\n    {\n        return rsa_private_of(der, key.start"
    ");\n    }\n    if (der_eq_hex(der, oid, \"2a8648ce3d0201\"))\n    {\n        Der curve = der_expect(der, o"
    "id.next, 0x06)?;\n        if (der_eq_hex(der, curve, \"2a8648ce3d030107\"))\n        {\n            retur"
    "n ec_private_of(der, key.start, Some(P256));\n        }\n        if (der_eq_hex(der, curve, \"2b8104002"
    "2\"))\n        {\n            return ec_private_of(der, key.start, Some(P384));\n        }\n        retur"
    "n Err(UnsupportedAlgorithm);\n    }\n    if (der_eq_hex(der, oid, \"2b6570\"))\n    {\n        Der inner ="
    " der_expect(der, key.start, 0x04)?;\n        if (inner.end - inner.start != 32 || inner.next != key.e"
    "nd)\n        {\n            return Err(BadEncoding);\n        }\n        array<u8, 32> seed = [0; 32];\n "
    "       for (usize i = 0; i < 32; i += 1)\n        {\n            seed[i] = der[inner.start + i];\n     "
    "   }\n        return Ok(Ed25519Private(seed));\n    }\n    Err(UnsupportedAlgorithm)\n}export fn Private"
    "Key::to_der(ref<PrivateKey, shared> key) : Vec<u8>\n{\n    CertKey public = PrivateKey::public_key(key"
    ");\n    Vec<u8> inner = match (key)\n    {\n        RsaPrivate(k)     :\n        {\n            BigUint o"
    "ne = BigUint::from_u64(1);\n            BigUint p1 = BigUint::sub(&k.p, &one);\n            BigUint q1"
    " = BigUint::sub(&k.q, &one);\n            Vec<u8> seq = der_uint([0: u8]);\n            Vec::extend_fr"
    "om(&mut seq, &der_big(&k.n));\n            Vec::extend_from(&mut seq, &der_big(&k.e));\n            Ve"
    "c::extend_from(&mut seq, &der_big(&k.d));\n            Vec::extend_from(&mut seq, &der_big(&k.p));\n  "
    "          Vec::extend_from(&mut seq, &der_big(&k.q));\n            Vec::extend_from(&mut seq, &der_bi"
    "g(&BigUint::rem(&k.d, &p1)));\n            Vec::extend_from(&mut seq, &der_big(&BigUint::rem(&k.d, &q"
    "1)));\n            Vec::extend_from(\n                &mut seq,\n                &der_big(&Option::unwr"
    "ap_or(BigUint::mod_inverse(&k.q, &k.p), BigUint::zero())),\n            );\n            der_wrap(0x30,"
    " &seq)\n        },\n        EcPrivate(k)      :\n        {\n            Vec<u8> seq = der_uint([1: u8]);"
    "\n            Vec::extend_from(&mut seq, &der_wrap(0x04, &k.scalar));\n            Vec<u8> point = mat"
    "ch (&public)\n            {\n                EcKey(pk) : Vec::clone(&pk.point),\n                _     "
    "    : Vec::new(),\n            };\n            Vec::extend_from(&mut seq, &der_wrap(0xa1, &der_bit_str"
    "ing(&point)));\n            der_wrap(0x30, &seq)\n        },\n        Ed25519Private(k) : der_wrap(0x04"
    ", k),\n    };\n    Vec<u8> content = der_uint([0: u8]);\n    Vec::extend_from(&mut content, &key_algori"
    "thm(&public));\n    Vec::extend_from(&mut content, &der_wrap(0x04, &inner));\n    der_wrap(0x30, &cont"
    "ent)\n}export fn PrivateKey::from_pem(StringView text) : Result<PrivateKey, CertError>\n{\n    array<st"
    "r, 3> labels = [\"PRIVATE KEY\", \"RSA PRIVATE KEY\", \"EC PRIVATE KEY\"];\n    Vec<u8> der = pem_block(tex"
    "t, &labels)?;\n    PrivateKey::from_der(&der)\n}unittest \"PrivateKey::from_pem: an encrypted key is no"
    "t read\"\n{\n    StringView text = \"-----BEGIN ENCRYPTED PRIVATE KEY-----\\nAAAA\\n-----END ENCRYPTED PRI"
    "VATE KEY-----\\n\";\n    match (PrivateKey::from_pem(text))\n    {\n        Err(UnsupportedAlgorithm) : a"
    "ssert(true),\n        _                         : assert(false),\n    }\n}export fn PrivateKey::to_pem("
    "ref<PrivateKey, shared> key) : String\n{\n    pem_of(\"PRIVATE KEY\", &PrivateKey::to_der(key))\n}export "
    "fn sign(\n    ref<PrivateKey, shared> key,\n    ref<SignatureScheme, shared> scheme,\n    slice<u8, sha"
    "red> message,\n) : Option<Vec<u8>>\n{\n    match (scheme)\n    {\n        RsaPkcs1(h) : match (key)\n     "
    "   {\n            RsaPrivate(k) : Some(rsa_sign_pkcs1v15(k, *h, &hash(*h, message))),\n            _  "
    "           : None,\n        },\n        RsaPss(h) : match (key)\n        {\n            RsaPrivate(k) : "
    "Some(rsa_sign_pss(k, *h, &hash(*h, message))),\n            _             : None,\n        },\n        "
    "Ecdsa(h) : match (key)\n        {\n            EcPrivate(k) : ecdsa_sign(k.curve, &k.scalar, &hash(*h,"
    " message)),\n            _            : None,\n        },\n        Ed25519 : match (key)\n        {\n    "
    "        Ed25519Private(k) : Some(Vec::from_slice(&ed25519_sign(k, message))),\n            _         "
    "        : None,\n        },\n        UnsupportedSignature : None,\n    }\n}unittest \"sign: a key of anot"
    "her kind gives None\"\n{\n    PrivateKey key = Ed25519Private([1; 32]);\n    SignatureScheme scheme = Rs"
    "aPss(Sha2_256);\n    assert(Option::is_none(&sign(&key, &scheme, b\"message\")));\n}export fn TlsError::"
    "text(ref<TlsError, shared> e) : str\n{\n    match (e)\n    {\n        TlsNetFailure(n) : NetError::text("
    "n),\n        CertRejected(c)  : CertError::text(c),\n        HandshakeFailed  : \"TLS handshake failed\""
    ",\n        ProtocolError    : \"TLS protocol violation\",\n        PeerAlert(code) : match (*code)\n     "
    "   {\n            40  : \"the peer refused the handshake (alert 40): it supports none of the suites (C"
    "haCha20-Poly1305, AES-128-GCM, AES-256-GCM) or key exchanges (X25519, P-256, P-384) offered\",\n      "
    "      42  : \"the peer refused a certificate (alert 42)\",\n            70  : \"the peer does not speak "
    "TLS 1.3 (alert 70)\",\n            80  : \"the peer failed internally (alert 80)\",\n            109 : \"t"
    "he peer requires an extension that was not sent (alert 109)\",\n            112 : \"the peer does not k"
    "now the name asked for (alert 112)\",\n            116 : \"the peer requires a client certificate, whic"
    "h std::tls does not send (alert 116)\",\n            _   : \"the peer sent a TLS alert\",\n        },\n   "
    "     RecordRejected   : \"a TLS record did not authenticate\",\n    }\n}unittest \"TlsError::text: alerts"
    " and network failures\"\n{\n    TlsError e = PeerAlert(70);\n    assert(TlsError::text(&e) == \"the peer "
    "does not speak TLS 1.3 (alert 70)\");\n    TlsError n = TlsNetFailure(Refused);\n    assert(TlsError::t"
    "ext(&n) == \"connection refused\");\n}fn suite_hash(u16 suite) : HashKind\n{\n    if (suite == 0x1302) { "
    "Sha2_384 } else { Sha2_256 }\n}fn suite_key_len(u16 suite) : usize\n{\n    if (suite == 0x1301) { 16 } "
    "else { 32 }\n}fn keys_from(slice<u8, shared> secret, u16 suite) : RecordKeys\n{\n    Vec<u8> none = Vec"
    "::new();\n    HashKind kind = suite_hash(suite);\n    RecordKeys {\n        .key = hkdf_expand_label_wi"
    "th(kind, secret, \"key\", &none, suite_key_len(suite)),\n        .iv = hkdf_expand_label_with(kind, sec"
    "ret, \"iv\", &none, 12),\n        .seq = 0,\n        .secret = Vec::from_slice(secret),\n        .suite ="
    " suite,\n    }\n}fn record_nonce(ref<RecordKeys, shared> k) : Vec<u8>\n{\n    Vec<u8> n = Vec::clone(&k."
    "iv);\n    for (usize i = 0; i < 8; i += 1)\n    {\n        n[4 + i] = n[4 + i] ^ narrow_wrapping<u8>(k."
    "seq >> narrow<u32>(56 - 8 * i));\n    }\n    n\n}export fn TlsStream::peer_certificate(ref<TlsStream, s"
    "hared> s) : Option<ref<Certificate, shared>>\n{\n    match (&s.peer)\n    {\n        Some(c) : Some(c),\n"
    "        None    : None,\n    }\n}export fn TlsStream::peer_addr(ref<TlsStream, shared> s) : SocketAddr"
    "\n{\n    TcpStream::peer_addr(&s.tcp)\n}export fn TlsStream::local_addr(ref<TlsStream, shared> s) : Soc"
    "ketAddr\n{\n    TcpStream::local_addr(&s.tcp)\n}export fn TlsStream::set_read_timeout_ms(ref<TlsStream,"
    " exclusive> s, u64 ms)\n{\n    TcpStream::set_read_timeout_ms(&mut s.tcp, ms);\n}export fn TlsStream::s"
    "et_write_timeout_ms(ref<TlsStream, exclusive> s, u64 ms)\n{\n    TcpStream::set_write_timeout_ms(&mut "
    "s.tcp, ms);\n}fn read_record(ref<TcpStream, exclusive> tcp) : Result<Record, TlsError>\n{\n    Vec<u8> "
    "header = Vec::new();\n    match (TcpStream::read_exact(tcp, &mut header, 5))\n    {\n        Ok(_)  : {"
    "},\n        Err(e) : return Err(TlsNetFailure(e)),\n    }\n    usize len = widen<usize>(read_be<u16>(&h"
    "eader, 3));\n    if (len > 16384 + 256)\n    {\n        return Err(ProtocolError);\n    }\n    Vec<u8> bo"
    "dy = Vec::new();\n    match (TcpStream::read_exact(tcp, &mut body, len))\n    {\n        Ok(_)  : {},\n "
    "       Err(e) : return Err(TlsNetFailure(e)),\n    }\n    Ok(Record { .kind = header[0], .header = hea"
    "der, .body = body })\n}fn write_all(ref<TcpStream, exclusive> tcp, slice<u8, shared> data) : Result<v"
    "oid, TlsError>\n{\n    match (TcpStream::write(tcp, data))\n    {\n        Ok(_)  : Ok(()),\n        Err("
    "e) : Err(TlsNetFailure(e)),\n    }\n}fn seal_record(ref<RecordKeys, exclusive> k, u8 kind, slice<u8, s"
    "hared> content) : Vec<u8>\n{\n    Vec<u8> inner = Vec::from_slice(content);\n    Vec::push(&mut inner, "
    "kind);\n    Vec<u8> header = Vec::new();\n    Vec::push(&mut header, 23);\n    Vec::push_be(&mut header"
    ", 0x0303: u16);\n    Vec::push_be(&mut header, narrow<u16>(Vec::len(&inner) + 16));\n    Vec<u8> nonce"
    " = record_nonce(k);\n    Vec<u8> sealed = if (k.suite != 0x1303)\n    {\n        aes_gcm_seal(&k.key, &"
    "nonce, &header, &inner)\n    }\n    else\n    {\n        chacha20_poly1305_seal(&k.key, &nonce, &header,"
    " &inner)\n    };\n    k.seq += 1;\n    Vec::extend_from(&mut header, &sealed);\n    header\n}fn open_reco"
    "rd(ref<RecordKeys, exclusive> k, ref<Record, shared> r) : Result<Inner, TlsError>\n{\n    if (r.kind !"
    "= 23)\n    {\n        return Err(ProtocolError);\n    }\n    Vec<u8> nonce = record_nonce(k);\n    Option"
    "<Vec<u8>> opened = if (k.suite != 0x1303)\n    {\n        aes_gcm_open(&k.key, &nonce, &r.header, &r.b"
    "ody)\n    }\n    else\n    {\n        chacha20_poly1305_open(&k.key, &nonce, &r.header, &r.body)\n    };\n"
    "    Vec<u8> plain = match (opened)\n    {\n        Some(p) : p,\n        None    : return Err(RecordRej"
    "ected),\n    };\n    k.seq += 1;\n    usize n = Vec::len(&plain);\n    while (n > 0 && plain[n - 1] == 0"
    ")\n    {\n        n -= 1;\n    }\n    if (n == 0 || n - 1 > 16384)\n    {\n        return Err(ProtocolErro"
    "r);\n    }\n    u8 kind = plain[n - 1];\n    Vec::truncate(&mut plain, n - 1);\n    Ok(Inner { .kind = k"
    "ind, .content = plain })\n}fn transcript_add(ref<Handshake, exclusive> hs, slice<u8, shared> msg)\n{\n "
    "   Hasher::update(&mut hs.t256, msg);\n    Hasher::update(&mut hs.t384, msg);\n}fn next_message(\n    r"
    "ef<Handshake, exclusive> hs,\n    ref<TcpStream, exclusive> tcp,\n    ref<Option<RecordKeys>, exclusiv"
    "e> keys,\n) : Result<Vec<u8>, TlsError>\n{\n    while (Vec::len(&hs.buffer) < 4 || Vec::len(&hs.buffer)"
    " < 4 + (widen<usize>(hs.buffer[1]) << 16 | widen<usize>(hs.buffer[2]) << 8 | widen<usize>(hs.buffer["
    "3])))\n    {\n        Record r = read_record(tcp)?;\n        if (r.kind == 20)\n        {\n            //"
    " A compatibility ChangeCipherSpec (RFC 8446 §D.4): ignored.\n            continue;\n        }\n       "
    " if (r.kind == 21)\n        {\n            if (Vec::len(&r.body) == 2)\n            {\n                r"
    "eturn Err(PeerAlert(r.body[1]));\n            }\n            return Err(ProtocolError);\n        }\n    "
    "    match (keys)\n        {\n            Some(k) :\n            {\n                Inner i = open_record"
    "(k, &r)?;\n                if (i.kind == 21)\n                {\n                    return Err(PeerAle"
    "rt(if (Vec::len(&i.content) == 2) { i.content[1] } else { 0 }));\n                }\n                i"
    "f (i.kind != 22)\n                {\n                    return Err(ProtocolError);\n                }\n"
    "                Vec::extend_from(&mut hs.buffer, &i.content);\n            },\n            None    :\n "
    "           {\n                if (r.kind != 22)\n                {\n                    return Err(Prot"
    "ocolError);\n                }\n                Vec::extend_from(&mut hs.buffer, &r.body);\n           "
    " },\n        }\n    }\n    usize len = 4 + (widen<usize>(hs.buffer[1]) << 16 | widen<usize>(hs.buffer[2"
    "]) << 8 | widen<usize>(hs.buffer[3]));\n    Vec<u8> msg = Vec::from_slice(&hs.buffer[0..len]);\n    Ve"
    "c<u8> rest = Vec::from_slice(&hs.buffer[len..$]);\n    overwrite(&mut hs.buffer, rest);\n    transcrip"
    "t_add(hs, &msg);\n    Ok(msg)\n}fn push_u24(ref<Vec<u8>, exclusive> v, usize n)\n{\n    Vec::push(v, nar"
    "row<u8>(n >> 16));\n    Vec::push(v, narrow_wrapping<u8>(n >> 8));\n    Vec::push(v, narrow_wrapping<u"
    "8>(n));\n}fn push_extension(ref<Vec<u8>, exclusive> out, u16 kind, slice<u8, shared> data)\n{\n    Vec:"
    ":push_be(out, kind);\n    Vec::push_be(out, narrow<u16>(slice_len(data)));\n    Vec::extend_from(out, "
    "data);\n}fn client_hello(\n    StringView server_name,\n    slice<u8, shared> random,\n    slice<u8, sha"
    "red> session,\n    u16 group,\n    slice<u8, shared> public_key,\n    slice<u8, shared> cookie,\n) : Vec"
    "<u8>\n{\n    Vec<u8> ext = Vec::new();\n    if (Result::is_err(&IpAddr::parse(server_name)))\n    {\n    "
    "    Vec<u8> sni = Vec::new();\n        Vec::push_be(&mut sni, narrow<u16>(StringView::len(server_name"
    ") + 3));\n        Vec::push(&mut sni, 0);\n        Vec::push_be(&mut sni, narrow<u16>(StringView::len("
    "server_name)));\n        Vec::extend_from(&mut sni, server_name.bytes);\n        push_extension(&mut e"
    "xt, 0x0000, &sni);\n    }\n    array<u8, 8> groups = [0x00, 0x06, 0x00, 0x1d, 0x00, 0x17, 0x00, 0x18];"
    "\n    push_extension(&mut ext, 0x000a, &groups);\n    array<u8, 20> algs = [\n        0x00,\n        0x1"
    "2,\n        0x04,\n        0x03,\n        0x05,\n        0x03,\n        0x08,\n        0x04,\n        0x08,"
    "\n        0x05,\n        0x08,\n        0x06,\n        0x08,\n        0x07,\n        0x04,\n        0x01,\n "
    "       0x05,\n        0x01,\n        0x06,\n        0x01,\n    ];\n    push_extension(&mut ext, 0x000d, &"
    "algs);\n    array<u8, 3> versions = [0x02, 0x03, 0x04];\n    push_extension(&mut ext, 0x002b, &version"
    "s);\n    Vec<u8> share = Vec::new();\n    Vec::push_be(&mut share, narrow<u16>(4 + slice_len(public_ke"
    "y)));\n    Vec::push_be(&mut share, group);\n    Vec::push_be(&mut share, narrow<u16>(slice_len(public"
    "_key)));\n    Vec::extend_from(&mut share, public_key);\n    push_extension(&mut ext, 0x0033, &share);"
    "\n    if (slice_len(cookie) > 0)\n    {\n        push_extension(&mut ext, 0x002c, cookie);\n    }\n    Ve"
    "c<u8> body = Vec::new();\n    Vec::push_be(&mut body, 0x0303: u16);\n    Vec::extend_from(&mut body, r"
    "andom);\n    Vec::push(&mut body, 32);\n    Vec::extend_from(&mut body, session);\n    array<u8, 8> sui"
    "tes = [0x00, 0x06, 0x13, 0x03, 0x13, 0x01, 0x13, 0x02];\n    Vec::extend_from(&mut body, &suites);\n  "
    "  Vec::push(&mut body, 1);\n    Vec::push(&mut body, 0);\n    Vec::push_be(&mut body, narrow<u16>(Vec:"
    ":len(&ext)));\n    Vec::extend_from(&mut body, &ext);\n    Vec<u8> msg = Vec::new();\n    Vec::push(&mu"
    "t msg, 1);\n    push_u24(&mut msg, Vec::len(&body));\n    Vec::extend_from(&mut msg, &body);\n    msg\n}"
    "fn server_hello(slice<u8, shared> sh, slice<u8, shared> session) : Result<ServerHello, TlsError>\n{\n "
    "   usize n = slice_len(sh);\n    if (n < 4 + 2 + 32 + 1 || sh[0] != 2)\n    {\n        return Err(Proto"
    "colError);\n    }\n    // HelloRetryRequest's fixed random.\n    Vec<u8> hrr = Result::unwrap_or(\n     "
    "   from_hex(\"cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c\"),\n        Vec::new(),"
    "\n    );\n    bool retry = digest_eq(&sh[6..38], &hrr);\n    usize at = 38;\n    usize sid_len = widen<u"
    "size>(sh[at]);\n    if (sid_len != slice_len(session) || at + 1 + sid_len + 3 + 2 > n || !digest_eq(\n"
    "        &sh[at + 1..at + 1 + sid_len],\n        session,\n    ))\n    {\n        return Err(ProtocolErro"
    "r);\n    }\n    at = at + 1 + sid_len;\n    u16 suite = read_be<u16>(sh, at);\n    if ((suite != 0x1303 "
    "&& suite != 0x1301 && suite != 0x1302) || sh[at + 2] != 0)\n    {\n        return Err(HandshakeFailed)"
    ";\n    }\n    at += 3;\n    usize ext_end = at + 2 + widen<usize>(read_be<u16>(sh, at));\n    if (ext_en"
    "d != n)\n    {\n        return Err(ProtocolError);\n    }\n    at += 2;\n    bool tls13 = false;\n    Opti"
    "on<u16> group = None;\n    Vec<u8> share = Vec::new();\n    Vec<u8> cookie = Vec::new();\n    while (at"
    " + 4 <= ext_end)\n    {\n        u16 kind = read_be<u16>(sh, at);\n        usize len = widen<usize>(rea"
    "d_be<u16>(sh, at + 2));\n        usize start = at + 4;\n        if (start + len > ext_end)\n        {\n "
    "           return Err(ProtocolError);\n        }\n        if (kind == 0x002b)\n        {\n            tl"
    "s13 = len == 2 && sh[start] == 0x03 && sh[start + 1] == 0x04;\n        }\n        else if (kind == 0x0"
    "033)\n        {\n            if (len < 2)\n            {\n                return Err(ProtocolError);\n   "
    "         }\n            u16 g = read_be<u16>(sh, start);\n            if (g != 0x001d && g != 0x0017 &"
    "& g != 0x0018)\n            {\n                return Err(HandshakeFailed);\n            }\n            "
    "group = Some(g);\n            if (!retry)\n            {\n                usize want = if (g == 0x001d)"
    " { 32 } else if (g == 0x0017) { 65 } else { 97 };\n                if (len != 4 + want || widen<usize"
    ">(read_be<u16>(sh, start + 2)) != want)\n                {\n                    return Err(HandshakeFa"
    "iled);\n                }\n                overwrite(&mut share, Vec::from_slice(&sh[start + 4..start "
    "+ len]));\n            }\n            else if (len != 2)\n            {\n                return Err(Prot"
    "ocolError);\n            }\n        }\n        else if (kind == 0x002c && retry)\n        {\n            "
    "overwrite(&mut cookie, Vec::from_slice(&sh[start..start + len]));\n        }\n        at = start + len"
    ";\n    }\n    if (!tls13)\n    {\n        return Err(HandshakeFailed);\n    }\n    match (group)\n    {\n   "
    "     Some(g) : Ok(ServerHello { .retry = retry, .suite = suite, .group = g, .share = share, .cookie "
    "= cookie }),\n        None    : Err(HandshakeFailed),\n    }\n}fn handshake_record(slice<u8, shared> ms"
    "g, u16 version) : Vec<u8>\n{\n    Vec<u8> rec = Vec::new();\n    Vec::push(&mut rec, 22);\n    Vec::push"
    "_be(&mut rec, version);\n    Vec::push_be(&mut rec, narrow<u16>(slice_len(msg)));\n    Vec::extend_fro"
    "m(&mut rec, msg);\n    rec\n}fn transcript_hash(ref<Handshake, shared> hs) : Vec<u8>\n{\n    match (hs.k"
    "ind)\n    {\n        Sha2_384 : Hasher::finish(hs.t384),\n        _        : Hasher::finish(hs.t256),\n "
    "   }\n}fn derive_secret(HashKind kind, slice<u8, shared> secret, StringView label, slice<u8, shared> "
    "transcript) : Vec<u8>\n{\n    hkdf_expand_label_with(kind, secret, label, transcript, slice_len(secret"
    "))\n}fn certificate_list(slice<u8, shared> m) : Result<Vec<Certificate>, TlsError>\n{\n    usize n = sl"
    "ice_len(m);\n    if (n < 8 || m[0] != 11 || m[4] != 0)\n    {\n        return Err(ProtocolError);\n    }"
    "\n    usize at = 5;\n    usize list_end = at + 3 + (widen<usize>(m[at]) << 16 | widen<usize>(m[at + 1]"
    ") << 8 | widen<usize>(m[at + 2]));\n    if (list_end != n)\n    {\n        return Err(ProtocolError);\n "
    "   }\n    at += 3;\n    Vec<Certificate> out = Vec::new();\n    while (at < list_end)\n    {\n        if "
    "(at + 3 > list_end)\n        {\n            return Err(ProtocolError);\n        }\n        usize len = w"
    "iden<usize>(m[at]) << 16 | widen<usize>(m[at + 1]) << 8 | widen<usize>(m[at + 2]);\n        usize sta"
    "rt = at + 3;\n        if (start + len + 2 > list_end)\n        {\n            return Err(ProtocolError)"
    ";\n        }\n        match (Certificate::parse(&m[start..start + len]))\n        {\n            Ok(c)  "
    ": Vec::push(&mut out, c),\n            Err(e) : return Err(CertRejected(e)),\n        }\n        usize "
    "ext_len = widen<usize>(read_be<u16>(m, start + len));\n        at = start + len + 2 + ext_len;\n    }\n"
    "    if (Vec::len(&out) == 0)\n    {\n        return Err(HandshakeFailed);\n    }\n    Ok(out)\n}fn certif"
    "icate_verify_ok(slice<u8, shared> m, ref<Certificate, shared> leaf, slice<u8, shared> transcript) : "
    "bool\n{\n    if (slice_len(m) < 8 || m[0] != 15)\n    {\n        return false;\n    }\n    u16 code = read"
    "_be<u16>(m, 4);\n    usize len = widen<usize>(read_be<u16>(m, 6));\n    if (8 + len != slice_len(m))\n "
    "   {\n        return false;\n    }\n    SignatureScheme scheme = UnsupportedSignature;\n    bool curve_o"
    "k = true;\n    if (code == 0x0403 || code == 0x0503)\n    {\n        EcCurve want = if (code == 0x0403)"
    " { P256 } else { P384 };\n        curve_ok = match (&leaf.key)\n        {\n            EcKey(k) : k.cur"
    "ve == want,\n            _        : false,\n        };\n        scheme = Ecdsa(if (code == 0x0403) { Sh"
    "a2_256 } else { Sha2_384 });\n    }\n    else if (code == 0x0804)\n    {\n        scheme = RsaPss(Sha2_2"
    "56);\n    }\n    else if (code == 0x0805)\n    {\n        scheme = RsaPss(Sha2_384);\n    }\n    else if ("
    "code == 0x0806)\n    {\n        scheme = RsaPss(Sha2_512);\n    }\n    else if (code == 0x0807)\n    {\n  "
    "      scheme = Ed25519;\n    }\n    if (!curve_ok)\n    {\n        return false;\n    }\n    Vec<u8> conte"
    "nt = Vec::filled(64, 0x20: u8);\n    Vec::extend_from(&mut content, b\"TLS 1.3, server CertificateVeri"
    "fy\");\n    Vec::push(&mut content, 0);\n    Vec::extend_from(&mut content, transcript);\n    verify_sig"
    "nature(&leaf.key, &scheme, &content, &m[8..$])\n}fn finished_data(HashKind kind, slice<u8, shared> se"
    "cret, slice<u8, shared> transcript) : Vec<u8>\n{\n    Vec<u8> none = Vec::new();\n    Vec<u8> key = hkd"
    "f_expand_label_with(kind, secret, \"finished\", &none, slice_len(secret));\n    hmac(kind, &key, transc"
    "ript)\n}export fn TlsStream::client(\n    TcpStream tcp,\n    StringView server_name,\n    ref<TrustStor"
    "e, shared> roots,\n) : Result<TlsStream, TlsError>\n{\n    array<u8, 32> private_key = x25519_private_k"
    "ey();\n    array<u8, 32> public_key = x25519_public_key(&private_key);\n    array<u8, 32> random = [0;"
    " 32];\n    os_random_bytes(&mut random);\n    array<u8, 32> session = [0; 32];\n    os_random_bytes(&mu"
    "t session);\n    Handshake hs = Handshake { .buffer = Vec::new(), .t256 = Hasher::new(Sha2_256), .t38"
    "4 = Hasher::new(Sha2_384), .kind = Sha2_256 };\n    Vec<u8> none = Vec::new();\n    Vec<u8> ch = clien"
    "t_hello(server_name, &random, &session, 0x001d, &public_key, &none);\n    transcript_add(&mut hs, &ch"
    ");\n    write_all(&mut tcp, &handshake_record(&ch, 0x0301))?;\n    Option<RecordKeys> plain = None;\n  "
    "  Vec<u8> sh = next_message(&mut hs, &mut tcp, &mut plain)?;\n    ServerHello hello = server_hello(&s"
    "h, &session)?;\n    hs.kind = suite_hash(hello.suite);\n    HashKind kind = hs.kind;\n    Vec<u8> ec_ke"
    "y = Vec::new();\n    if (hello.retry)\n    {\n        // A HelloRetryRequest (RFC 8446 §4.1.4): it may"
    " only ask for a\n        // group this client offered without a share, P-256 or P-384. The\n        //"
    " transcript restarts from message_hash(ClientHello1) ‖\n        // HelloRetryRequest, under the sui"
    "te's hash.\n        if ((hello.group != 0x0017 && hello.group != 0x0018) || Vec::len(&hs.buffer) != 0"
    ")\n        {\n            return Err(HandshakeFailed);\n        }\n        EcCurve curve = if (hello.gro"
    "up == 0x0017) { P256 } else { P384 };\n        Vec<u8> ch_hash = hash(kind, &ch);\n        array<u8, 4"
    "> head = [254, 0, 0, narrow<u8>(Vec::len(&ch_hash))];\n        Handshake restarted = Handshake { .buf"
    "fer = Vec::new(), .t256 = Hasher::new(Sha2_256), .t384 = Hasher::new(Sha2_384), .kind = kind };\n    "
    "    transcript_add(&mut restarted, &head);\n        transcript_add(&mut restarted, &ch_hash);\n       "
    " transcript_add(&mut restarted, &sh);\n        overwrite(&mut ec_key, ec_private_key(curve));\n       "
    " Vec<u8> ec_public = Option::unwrap(ec_public_key(curve, &ec_key));\n        Vec<u8> ch2 = client_hel"
    "lo(\n            server_name,\n            &random,\n            &session,\n            hello.group,\n   "
    "         &ec_public,\n            &hello.cookie,\n        );\n        transcript_add(&mut restarted, &c"
    "h2);\n        overwrite(&mut hs, restarted);\n        write_all(&mut tcp, &handshake_record(&ch2, 0x03"
    "03))?;\n        Vec<u8> sh2 = next_message(&mut hs, &mut tcp, &mut plain)?;\n        ServerHello secon"
    "d = server_hello(&sh2, &session)?;\n        if (second.retry || second.group != hello.group || second"
    ".suite != hello.suite)\n        {\n            return Err(HandshakeFailed);\n        }\n        overwrit"
    "e(&mut hello, second);\n    }\n    else if (hello.group != 0x001d)\n    {\n        return Err(HandshakeF"
    "ailed);\n    }\n    u16 suite = hello.suite;\n    Vec<u8> shared = Vec::new();\n    if (hello.group == 0"
    "x001d)\n    {\n        match (x25519(&private_key, &hello.share))\n        {\n            Some(z) : Vec:"
    ":extend_from(&mut shared, &z),\n            None    : return Err(HandshakeFailed),\n        }\n    }\n  "
    "  else\n    {\n        EcCurve curve = if (hello.group == 0x0017) { P256 } else { P384 };\n        matc"
    "h (ecdh(curve, &ec_key, &hello.share))\n        {\n            Some(z) : overwrite(&mut shared, z),\n  "
    "          None    : return Err(HandshakeFailed),\n        }\n    }\n    // The key schedule (RFC 8446 §"
    "7.1), under the suite's hash.\n    Vec<u8> empty_hash = hash(kind, &none);\n    Vec<u8> zeros = Vec::f"
    "illed(Vec::len(&empty_hash), 0: u8);\n    Vec<u8> early = hkdf_extract_with(kind, &none, &zeros);\n   "
    " Vec<u8> derived = derive_secret(kind, &early, \"derived\", &empty_hash);\n    Vec<u8> handshake_secret"
    " = hkdf_extract_with(kind, &derived, &shared);\n    Vec<u8> th = transcript_hash(&hs);\n    Vec<u8> c_"
    "hs = derive_secret(kind, &handshake_secret, \"c hs traffic\", &th);\n    Vec<u8> s_hs = derive_secret(k"
    "ind, &handshake_secret, \"s hs traffic\", &th);\n    Option<RecordKeys> server_keys = Some(keys_from(&s"
    "_hs, suite));\n    Vec<u8> ee = next_message(&mut hs, &mut tcp, &mut server_keys)?;\n    if (Vec::len("
    "&ee) < 6 || ee[0] != 8)\n    {\n        return Err(ProtocolError);\n    }\n    Vec<u8> cm = next_message"
    "(&mut hs, &mut tcp, &mut server_keys)?;\n    // RFC 8446 §4.3.2: a server may ask for a client certi"
    "ficate. This\n    // client has none to send, so it answers with an empty Certificate\n    // (§4.4.2"
    ") carrying the request's context; a server that requires one\n    // then sends certificate_required "
    "(alert 116).\n    Option<Vec<u8>> cert_request = None;\n    if (Vec::len(&cm) >= 5 && cm[0] == 13)\n   "
    " {\n        usize ctx_len = widen<usize>(cm[4]);\n        if (5 + ctx_len + 2 > Vec::len(&cm))\n       "
    " {\n            return Err(ProtocolError);\n        }\n        cert_request = Some(Vec::from_slice(&cm["
    "5..5 + ctx_len]));\n        overwrite(&mut cm, next_message(&mut hs, &mut tcp, &mut server_keys)?);\n "
    "   }\n    Vec<Certificate> chain = certificate_list(&cm)?;\n    Certificate leaf = Vec::remove(&mut ch"
    "ain, 0);\n    DateTime now = DateTime::now();\n    match (verify_chain(&leaf, &chain, roots, server_na"
    "me, &now))\n    {\n        Ok(_)  : {},\n        Err(e) : return Err(CertRejected(e)),\n    }\n    Vec<u8"
    "> th_cert = transcript_hash(&hs);\n    Vec<u8> cv = next_message(&mut hs, &mut tcp, &mut server_keys)"
    "?;\n    if (!certificate_verify_ok(&cv, &leaf, &th_cert))\n    {\n        return Err(HandshakeFailed);\n"
    "    }\n    Vec<u8> th_cv = transcript_hash(&hs);\n    Vec<u8> fin = next_message(&mut hs, &mut tcp, &m"
    "ut server_keys)?;\n    Vec<u8> want = finished_data(kind, &s_hs, &th_cv);\n    if (Vec::len(&fin) != 4"
    " + Vec::len(&want) || fin[0] != 20 || !digest_eq(&fin[4..$], &want))\n    {\n        return Err(Handsh"
    "akeFailed);\n    }\n    if (Vec::len(&hs.buffer) != 0)\n    {\n        return Err(ProtocolError);\n    }\n"
    "    Vec<u8> th_fin = transcript_hash(&hs);\n    Vec<u8> derived2 = derive_secret(kind, &handshake_sec"
    "ret, \"derived\", &empty_hash);\n    Vec<u8> master = hkdf_extract_with(kind, &derived2, &zeros);\n    V"
    "ec<u8> c_ap = derive_secret(kind, &master, \"c ap traffic\", &th_fin);\n    Vec<u8> s_ap = derive_secre"
    "t(kind, &master, \"s ap traffic\", &th_fin);\n    // The client's flight: a compatibility ChangeCipherS"
    "pec, then Finished\n    // under the client handshake keys.\n    array<u8, 6> ccs = [20, 0x03, 0x03, 0"
    "x00, 0x01, 0x01];\n    write_all(&mut tcp, &ccs)?;\n    RecordKeys client_hs = keys_from(&c_hs, suite)"
    ";\n    Vec<u8> th_client = th_fin;\n    if (Some(ctx) = cert_request)\n    {\n        // An empty Certif"
    "icate: the context, and a certificate_list of\n        // length 0; no CertificateVerify follows it.\n"
    "        Vec<u8> cert = Vec::new();\n        Vec::push(&mut cert, 11);\n        push_u24(&mut cert, 1 +"
    " Vec::len(&ctx) + 3);\n        Vec::push(&mut cert, narrow<u8>(Vec::len(&ctx)));\n        Vec::extend_"
    "from(&mut cert, &ctx);\n        push_u24(&mut cert, 0);\n        transcript_add(&mut hs, &cert);\n     "
    "   overwrite(&mut th_client, transcript_hash(&hs));\n        write_all(&mut tcp, &seal_record(&mut cl"
    "ient_hs, 22, &cert))?;\n    }\n    Vec<u8> mine = finished_data(kind, &c_hs, &th_client);\n    Vec<u8> "
    "cfin = Vec::new();\n    Vec::push(&mut cfin, 20);\n    push_u24(&mut cfin, Vec::len(&mine));\n    Vec::"
    "extend_from(&mut cfin, &mine);\n    Vec<u8> out = seal_record(&mut client_hs, 22, &cfin);\n    write_a"
    "ll(&mut tcp, &out)?;\n    Ok(TlsStream {\n        .tcp = tcp,\n        .send = keys_from(&c_ap, suite),"
    "\n        .recv = keys_from(&s_ap, suite),\n        .pending = Vec::new(),\n        .pending_at = 0,\n  "
    "      .closed = false,\n        .peer = Some(leaf),\n    })\n}export fn TlsStream::connect(\n    SocketA"
    "ddr addr,\n    StringView server_name,\n    ref<TrustStore, shared> roots,\n) : Result<TlsStream, TlsEr"
    "ror>\n{\n    match (TcpStream::connect(addr))\n    {\n        Ok(tcp) : TlsStream::client(tcp, server_na"
    "me, roots),\n        Err(e)  : Err(TlsNetFailure(e)),\n    }\n}export fn TlsStream::write(ref<TlsStream"
    ", exclusive> s, slice<u8, shared> data) : Result<void, TlsError>\n{\n    usize at = 0;\n    usize n = s"
    "lice_len(data);\n    while (at < n)\n    {\n        usize take = min(n - at, 16384);\n        Vec<u8> re"
    "c = seal_record(&mut s.send, 23, &data[at..at + take]);\n        write_all(&mut s.tcp, &rec)?;\n      "
    "  at += take;\n    }\n    Ok(())\n}export fn TlsStream::write_text(ref<TlsStream, exclusive> s, StringV"
    "iew text) : Result<void, TlsError>\n{\n    TlsStream::write(s, text.bytes)\n}fn TlsStream::fill(ref<Tls"
    "Stream, exclusive> s) : Result<void, TlsError>\n{\n    while (s.pending_at >= Vec::len(&s.pending) && "
    "!s.closed)\n    {\n        Record r = read_record(&mut s.tcp)?;\n        if (r.kind == 20)\n        {\n  "
    "          continue;\n        }\n        Inner { kind, content } = open_record(&mut s.recv, &r)?;\n     "
    "   if (kind == 23)\n        {\n            overwrite(&mut s.pending, content);\n            s.pending_a"
    "t = 0;\n        }\n        else if (kind == 21)\n        {\n            if (Vec::len(&content) == 2 && c"
    "ontent[1] == 0)\n            {\n                s.closed = true;\n            }\n            else\n      "
    "      {\n                return Err(PeerAlert(if (Vec::len(&content) == 2) { content[1] } else { 0 })"
    ");\n            }\n        }\n        else if (kind == 22)\n        {\n            usize at = 0;\n        "
    "    while (at + 4 <= Vec::len(&content))\n            {\n                u8 t = content[at];\n         "
    "       usize len = widen<usize>(content[at + 1]) << 16 | widen<usize>(content[at + 2]) << 8 | widen<"
    "usize>(content[at + 3]);\n                if (at + 4 + len > Vec::len(&content))\n                {\n  "
    "                  return Err(ProtocolError);\n                }\n                if (t == 24)\n        "
    "        {\n                    if (len != 1)\n                    {\n                        return Err"
    "(ProtocolError);\n                    }\n                    Vec<u8> none = Vec::new();\n              "
    "      HashKind kind = suite_hash(s.recv.suite);\n                    Vec<u8> next = hkdf_expand_label"
    "_with(\n                        kind,\n                        &s.recv.secret,\n                       "
    " \"traffic upd\",\n                        &none,\n                        Vec::len(&s.recv.secret),\n   "
    "                 );\n                    overwrite(&mut s.recv, keys_from(&next, s.recv.suite));\n    "
    "                if (content[at + 4] == 1)\n                    {\n                        array<u8, 5>"
    " reply = [24, 0, 0, 1, 0];\n                        Vec<u8> rec = seal_record(&mut s.send, 22, &reply"
    ");\n                        write_all(&mut s.tcp, &rec)?;\n                        Vec<u8> mine = hkdf"
    "_expand_label_with(\n                            kind,\n                            &s.send.secret,\n  "
    "                          \"traffic upd\",\n                            &none,\n                        "
    "    Vec::len(&s.send.secret),\n                        );\n                        overwrite(&mut s.se"
    "nd, keys_from(&mine, s.send.suite));\n                    }\n                }\n                else if"
    " (t != 4)\n                {\n                    return Err(ProtocolError);\n                }\n       "
    "         at = at + 4 + len;\n            }\n        }\n        else\n        {\n            return Err(Pr"
    "otocolError);\n        }\n    }\n    Ok(())\n}export fn TlsStream::read(ref<TlsStream, exclusive> s, ref"
    "<Vec<u8>, exclusive> buf, usize max) : Result<usize, TlsError>\n{\n    if (max == 0)\n    {\n        ret"
    "urn Ok(0);\n    }\n    TlsStream::fill(s)?;\n    usize have = Vec::len(&s.pending) - s.pending_at;\n    "
    "usize take = min(have, max);\n    Vec::extend_from(buf, &s.pending[s.pending_at..s.pending_at + take]"
    ");\n    s.pending_at += take;\n    Ok(take)\n}export fn TlsStream::read_exact(\n    ref<TlsStream, exclu"
    "sive> s,\n    ref<Vec<u8>, exclusive> buf,\n    usize n,\n) : Result<void, TlsError>\n{\n    usize got = "
    "0;\n    while (got < n)\n    {\n        usize k = TlsStream::read(s, buf, n - got)?;\n        if (k == 0"
    ")\n        {\n            return Err(TlsNetFailure(Closed));\n        }\n        got += k;\n    }\n    Ok("
    "())\n}export fn TlsStream::read_line(ref<TlsStream, exclusive> s) : Result<Option<String>, TlsError>\n"
    "{\n    Vec<u8> line = Vec::new();\n    while (true)\n    {\n        TlsStream::fill(s)?;\n        usize n"
    " = Vec::len(&s.pending);\n        if (s.pending_at >= n)\n        {\n            if (Vec::len(&line) =="
    " 0)\n            {\n                return Ok(None);\n            }\n            break;\n        }\n      "
    "  usize i = s.pending_at;\n        while (i < n && s.pending[i] != 10)\n        {\n            i += 1;\n"
    "        }\n        if (i < n)\n        {\n            Vec::extend_from(&mut line, &s.pending[s.pending_"
    "at..i]);\n            s.pending_at = i + 1;\n            break;\n        }\n        Vec::extend_from(&mu"
    "t line, &s.pending[s.pending_at..n]);\n        s.pending_at = n;\n    }\n    usize k = Vec::len(&line);"
    "\n    if (k > 0 && line[k - 1] == 13)\n    {\n        Vec::pop(&mut line);\n    }\n    match (String::fro"
    "m_utf8(line))\n    {\n        Ok(t)  : Ok(Some(t)),\n        Err(e) : Err(TlsNetFailure(NotUtf8(e))),\n "
    "   }\n}export fn TlsStream::close(ref<TlsStream, exclusive> s) : Result<void, TlsError>\n{\n    array<u"
    "8, 2> alert = [1, 0];\n    Vec<u8> rec = seal_record(&mut s.send, 21, &alert);\n    write_all(&mut s.t"
    "cp, &rec)\n}fn u16_list(slice<u8, shared> b, usize start, usize end, ref<Vec<u16>, exclusive> out) : "
    "bool\n{\n    if ((end - start) % 2 != 0)\n    {\n        return false;\n    }\n    usize at = start;\n    w"
    "hile (at < end)\n    {\n        Vec::push(out, read_be<u16>(b, at));\n        at += 2;\n    }\n    true\n}"
    "fn client_hello_parse(slice<u8, shared> m) : Result<ClientHello, TlsError>\n{\n    usize n = slice_len"
    "(m);\n    if (n < 4 + 2 + 32 + 1 || m[0] != 1)\n    {\n        return Err(ProtocolError);\n    }\n    usi"
    "ze at = 38;\n    usize sid_len = widen<usize>(m[at]);\n    if (sid_len > 32 || at + 1 + sid_len + 2 > "
    "n)\n    {\n        return Err(ProtocolError);\n    }\n    Vec<u8> session = Vec::from_slice(&m[at + 1..a"
    "t + 1 + sid_len]);\n    at = at + 1 + sid_len;\n    usize suites_len = widen<usize>(read_be<u16>(m, at"
    "));\n    at += 2;\n    if (at + suites_len + 1 > n)\n    {\n        return Err(ProtocolError);\n    }\n   "
    " Vec<u16> suites = Vec::new();\n    if (!u16_list(m, at, at + suites_len, &mut suites))\n    {\n       "
    " return Err(ProtocolError);\n    }\n    at += suites_len;\n    usize comp_len = widen<usize>(m[at]);\n  "
    "  at += 1 + comp_len;\n    ClientHello ch = ClientHello {\n        .session = session,\n        .suites"
    " = suites,\n        .groups = Vec::new(),\n        .schemes = Vec::new(),\n        .share_groups = Vec:"
    ":new(),\n        .shares = Vec::new(),\n        .tls13 = false,\n        .has_cookie = false,\n    };\n  "
    "  if (at == n)\n    {\n        return Ok(ch);\n    }\n    if (at + 2 > n)\n    {\n        return Err(Proto"
    "colError);\n    }\n    usize ext_end = at + 2 + widen<usize>(read_be<u16>(m, at));\n    if (ext_end != "
    "n)\n    {\n        return Err(ProtocolError);\n    }\n    at += 2;\n    while (at + 4 <= ext_end)\n    {\n "
    "       u16 kind = read_be<u16>(m, at);\n        usize len = widen<usize>(read_be<u16>(m, at + 2));\n  "
    "      usize start = at + 4;\n        if (start + len > ext_end)\n        {\n            return Err(Prot"
    "ocolError);\n        }\n        if (kind == 0x002b)\n        {\n            // supported_versions: a 1-b"
    "yte length and the versions.\n            if (len < 1 || widen<usize>(m[start]) + 1 != len)\n         "
    "   {\n                return Err(ProtocolError);\n            }\n            Vec<u16> versions = Vec::n"
    "ew();\n            if (!u16_list(m, start + 1, start + len, &mut versions))\n            {\n           "
    "     return Err(ProtocolError);\n            }\n            foreach (v in &versions)\n            {\n   "
    "             if (*v == 0x0304)\n                {\n                    ch.tls13 = true;\n              "
    "  }\n            }\n        }\n        else if (kind == 0x000a || kind == 0x000d)\n        {\n           "
    " if (len < 2 || widen<usize>(read_be<u16>(m, start)) + 2 != len)\n            {\n                retur"
    "n Err(ProtocolError);\n            }\n            Vec<u16> list = Vec::new();\n            if (!u16_lis"
    "t(m, start + 2, start + len, &mut list))\n            {\n                return Err(ProtocolError);\n  "
    "          }\n            if (kind == 0x000a)\n            {\n                overwrite(&mut ch.groups, "
    "list);\n            }\n            else\n            {\n                overwrite(&mut ch.schemes, list)"
    ";\n            }\n        }\n        else if (kind == 0x0033)\n        {\n            if (len < 2 || wide"
    "n<usize>(read_be<u16>(m, start)) + 2 != len)\n            {\n                return Err(ProtocolError)"
    ";\n            }\n            usize p = start + 2;\n            while (p + 4 <= start + len)\n          "
    "  {\n                u16 g = read_be<u16>(m, p);\n                usize klen = widen<usize>(read_be<u1"
    "6>(m, p + 2));\n                if (p + 4 + klen > start + len)\n                {\n                   "
    " return Err(ProtocolError);\n                }\n                Vec::push(&mut ch.share_groups, g);\n  "
    "              Vec::push(&mut ch.shares, Vec::from_slice(&m[p + 4..p + 4 + klen]));\n                p"
    " += 4 + klen;\n            }\n            if (p != start + len)\n            {\n                return E"
    "rr(ProtocolError);\n            }\n        }\n        else if (kind == 0x002c)\n        {\n            ch"
    ".has_cookie = true;\n        }\n        at = start + len;\n    }\n    if (at != ext_end)\n    {\n        r"
    "eturn Err(ProtocolError);\n    }\n    Ok(ch)\n}fn send_plain_alert(ref<TcpStream, exclusive> tcp, u8 co"
    "de)\n{\n    array<u8, 7> rec = [21, 0x03, 0x03, 0, 2, 2, code];\n    _ = TcpStream::write(tcp, &rec);\n}"
    "fn server_hello_bytes(\n    slice<u8, shared> random,\n    slice<u8, shared> session,\n    u16 suite,\n "
    "   u16 group,\n    slice<u8, shared> share,\n    bool retry,\n) : Vec<u8>\n{\n    Vec<u8> ext = Vec::new("
    ");\n    array<u8, 2> v13 = [0x03, 0x04];\n    push_extension(&mut ext, 0x002b, &v13);\n    Vec<u8> ks ="
    " Vec::new();\n    Vec::push_be(&mut ks, group);\n    if (!retry)\n    {\n        Vec::push_be(&mut ks, n"
    "arrow<u16>(slice_len(share)));\n        Vec::extend_from(&mut ks, share);\n    }\n    push_extension(&m"
    "ut ext, 0x0033, &ks);\n    Vec<u8> body = Vec::new();\n    Vec::push_be(&mut body, 0x0303: u16);\n    V"
    "ec::extend_from(&mut body, random);\n    Vec::push(&mut body, narrow<u8>(slice_len(session)));\n    Ve"
    "c::extend_from(&mut body, session);\n    Vec::push_be(&mut body, suite);\n    Vec::push(&mut body, 0);"
    "\n    Vec::push_be(&mut body, narrow<u16>(Vec::len(&ext)));\n    Vec::extend_from(&mut body, &ext);\n  "
    "  Vec<u8> msg = Vec::new();\n    Vec::push(&mut msg, 2);\n    push_u24(&mut msg, Vec::len(&body));\n   "
    " Vec::extend_from(&mut msg, &body);\n    msg\n}fn send_handshake(\n    ref<TcpStream, exclusive> tcp,\n "
    "   ref<RecordKeys, exclusive> keys,\n    ref<Handshake, exclusive> hs,\n    slice<u8, shared> msg,\n) :"
    " Result<void, TlsError>\n{\n    transcript_add(hs, msg);\n    usize at = 0;\n    while (at < slice_len(m"
    "sg))\n    {\n        usize take = min(slice_len(msg) - at, 16384);\n        Vec<u8> rec = seal_record(k"
    "eys, 22, &msg[at..at + take]);\n        write_all(tcp, &rec)?;\n        at += take;\n    }\n    Ok(())\n}"
    "fn server_scheme(ref<PrivateKey, shared> key, ref<Vec<u16>, shared> offered) : Option<u16>\n{\n    u16"
    " want = match (key)\n    {\n        RsaPrivate(_)     : 0x0804,\n        EcPrivate(k)      : if (k.curv"
    "e == P256) { 0x0403 } else { 0x0503 },\n        Ed25519Private(_) : 0x0807,\n    };\n    foreach (s in "
    "offered)\n    {\n        if (*s == want)\n        {\n            return Some(want);\n        }\n    }\n    "
    "None\n}fn scheme_of(u16 code) : SignatureScheme\n{\n    if (code == 0x0403) { Ecdsa(Sha2_256) }\n    els"
    "e if (code == 0x0503) { Ecdsa(Sha2_384) }\n    else if (code == 0x0807) { Ed25519 }\n    else { RsaPss"
    "(Sha2_256) }\n}export fn TlsStream::server(\n    TcpStream tcp,\n    ref<PrivateKey, shared> key,\n    s"
    "lice<Certificate, shared> chain,\n) : Result<TlsStream, TlsError>\n{\n    if (slice_len(chain) == 0)\n  "
    "  {\n        return Err(HandshakeFailed);\n    }\n    Handshake hs = Handshake { .buffer = Vec::new(), "
    ".t256 = Hasher::new(Sha2_256), .t384 = Hasher::new(Sha2_384), .kind = Sha2_256 };\n    Option<RecordK"
    "eys> plain = None;\n    Vec<u8> chm = next_message(&mut hs, &mut tcp, &mut plain)?;\n    ClientHello c"
    "h = client_hello_parse(&chm)?;\n    if (!ch.tls13)\n    {\n        send_plain_alert(&mut tcp, 70);\n    "
    "    return Err(HandshakeFailed);\n    }\n    // The suite: the client's first that this server has.\n  "
    "  u16 suite = 0;\n    foreach (s in &ch.suites)\n    {\n        if (suite == 0 && (*s == 0x1303 || *s ="
    "= 0x1301 || *s == 0x1302))\n        {\n            suite = *s;\n        }\n    }\n    u16 scheme_code = m"
    "atch (server_scheme(key, &ch.schemes))\n    {\n        Some(c) : c,\n        None    : 0,\n    };\n    if"
    " (suite == 0 || scheme_code == 0)\n    {\n        send_plain_alert(&mut tcp, 40);\n        return Err(H"
    "andshakeFailed);\n    }\n    hs.kind = suite_hash(suite);\n    HashKind kind = hs.kind;\n    // The grou"
    "p: the client's first key share for a group this server\n    // has; else a HelloRetryRequest for the"
    " first group it supports.\n    u16 group = 0;\n    Vec<u8> client_share = Vec::new();\n    for (usize i"
    " = 0; i < Vec::len(&ch.share_groups) && group == 0; i += 1)\n    {\n        u16 g = ch.share_groups[i]"
    ";\n        if (g == 0x001d || g == 0x0017 || g == 0x0018)\n        {\n            group = g;\n          "
    "  overwrite(&mut client_share, Vec::clone(&ch.shares[i]));\n        }\n    }\n    Vec<u8> session = Vec"
    "::clone(&ch.session);\n    if (group == 0)\n    {\n        u16 ask = 0;\n        foreach (g in &ch.group"
    "s)\n        {\n            if (ask == 0 && (*g == 0x001d || *g == 0x0017 || *g == 0x0018))\n           "
    " {\n                ask = *g;\n            }\n        }\n        if (ask == 0 || ch.has_cookie)\n        "
    "{\n            send_plain_alert(&mut tcp, 40);\n            return Err(HandshakeFailed);\n        }\n   "
    "     // RFC 8446 §4.1.4: the transcript restarts from\n        // message_hash(ClientHello1) ‖ Hel"
    "loRetryRequest.\n        Vec<u8> ch_hash = hash(kind, &chm);\n        array<u8, 4> head = [254, 0, 0, "
    "narrow<u8>(Vec::len(&ch_hash))];\n        Handshake restarted = Handshake { .buffer = Vec::new(), .t2"
    "56 = Hasher::new(Sha2_256), .t384 = Hasher::new(Sha2_384), .kind = kind };\n        transcript_add(&m"
    "ut restarted, &head);\n        transcript_add(&mut restarted, &ch_hash);\n        Vec<u8> hrr_random ="
    " Result::unwrap_or(\n            from_hex(\"cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8"
    "a8339c\"),\n            Vec::new(),\n        );\n        Vec<u8> none = Vec::new();\n        Vec<u8> hrr "
    "= server_hello_bytes(&hrr_random, &session, suite, ask, &none, true);\n        transcript_add(&mut re"
    "started, &hrr);\n        overwrite(&mut hs, restarted);\n        write_all(&mut tcp, &handshake_record"
    "(&hrr, 0x0303))?;\n        Vec<u8> chm2 = next_message(&mut hs, &mut tcp, &mut plain)?;\n        Clien"
    "tHello ch2 = client_hello_parse(&chm2)?;\n        bool suite_ok = false;\n        foreach (s in &ch2.s"
    "uites)\n        {\n            if (*s == suite)\n            {\n                suite_ok = true;\n       "
    "     }\n        }\n        for (usize i = 0; i < Vec::len(&ch2.share_groups) && group == 0; i += 1)\n  "
    "      {\n            if (ch2.share_groups[i] == ask)\n            {\n                group = ask;\n     "
    "           overwrite(&mut client_share, Vec::clone(&ch2.shares[i]));\n            }\n        }\n       "
    " if (group == 0 || !suite_ok || !ch2.tls13 || !same_session(&ch2.session, &session))\n        {\n     "
    "       send_plain_alert(&mut tcp, 47);\n            return Err(HandshakeFailed);\n        }\n    }\n    "
    "// RFC 8446 §4.2.8.2: the client's share has its group's exact length\n    // (32 bytes for X25519, "
    "an uncompressed point of 65 or 97 for P-256 and\n    // P-384), in the first ClientHello and after a "
    "HelloRetryRequest; any\n    // other is illegal_parameter (a short X25519 share would reach\n    // `x"
    "25519`, which faults on it).\n    usize share_len = if (group == 0x001d) { 32 } else if (group == 0x0"
    "017) { 65 } else { 97 };\n    if (Vec::len(&client_share) != share_len)\n    {\n        send_plain_aler"
    "t(&mut tcp, 47);\n        return Err(HandshakeFailed);\n    }\n    // This server's share and the share"
    "d secret.\n    Vec<u8> public_key = Vec::new();\n    Vec<u8> shared = Vec::new();\n    if (group == 0x0"
    "01d)\n    {\n        array<u8, 32> private_key = x25519_private_key();\n        Vec::extend_from(&mut p"
    "ublic_key, &x25519_public_key(&private_key));\n        match (x25519(&private_key, &client_share))\n  "
    "      {\n            Some(z) : Vec::extend_from(&mut shared, &z),\n            None    :\n            {"
    "\n                send_plain_alert(&mut tcp, 47);\n                return Err(HandshakeFailed);\n      "
    "      },\n        }\n    }\n    else\n    {\n        EcCurve curve = if (group == 0x0017) { P256 } else {"
    " P384 };\n        Vec<u8> ec_key = ec_private_key(curve);\n        overwrite(&mut public_key, Option::"
    "unwrap(ec_public_key(curve, &ec_key)));\n        match (ecdh(curve, &ec_key, &client_share))\n        "
    "{\n            Some(z) : overwrite(&mut shared, z),\n            None    :\n            {\n             "
    "   send_plain_alert(&mut tcp, 47);\n                return Err(HandshakeFailed);\n            },\n     "
    "   }\n    }\n    array<u8, 32> random = [0; 32];\n    os_random_bytes(&mut random);\n    Vec<u8> sh = se"
    "rver_hello_bytes(&random, &session, suite, group, &public_key, false);\n    transcript_add(&mut hs, &"
    "sh);\n    write_all(&mut tcp, &handshake_record(&sh, 0x0303))?;\n    array<u8, 6> ccs = [20, 0x03, 0x0"
    "3, 0x00, 0x01, 0x01];\n    write_all(&mut tcp, &ccs)?;\n    // The key schedule (RFC 8446 §7.1).\n    "
    "Vec<u8> none = Vec::new();\n    Vec<u8> empty_hash = hash(kind, &none);\n    Vec<u8> zeros = Vec::fill"
    "ed(Vec::len(&empty_hash), 0: u8);\n    Vec<u8> early = hkdf_extract_with(kind, &none, &zeros);\n    Ve"
    "c<u8> derived = derive_secret(kind, &early, \"derived\", &empty_hash);\n    Vec<u8> handshake_secret = "
    "hkdf_extract_with(kind, &derived, &shared);\n    Vec<u8> th = transcript_hash(&hs);\n    Vec<u8> c_hs "
    "= derive_secret(kind, &handshake_secret, \"c hs traffic\", &th);\n    Vec<u8> s_hs = derive_secret(kind"
    ", &handshake_secret, \"s hs traffic\", &th);\n    RecordKeys server_hs = keys_from(&s_hs, suite);\n    /"
    "/ EncryptedExtensions (none), Certificate, CertificateVerify, Finished.\n    array<u8, 6> ee = [8, 0,"
    " 0, 2, 0, 0];\n    send_handshake(&mut tcp, &mut server_hs, &mut hs, &ee)?;\n    Vec<u8> list = Vec::n"
    "ew();\n    foreach (c in chain)\n    {\n        push_u24(&mut list, Vec::len(&c.der));\n        Vec::ext"
    "end_from(&mut list, &c.der);\n        Vec::push_be(&mut list, 0: u16);\n    }\n    Vec<u8> cert = Vec::"
    "new();\n    Vec::push(&mut cert, 11);\n    push_u24(&mut cert, 4 + Vec::len(&list));\n    Vec::push(&mu"
    "t cert, 0);\n    push_u24(&mut cert, Vec::len(&list));\n    Vec::extend_from(&mut cert, &list);\n    se"
    "nd_handshake(&mut tcp, &mut server_hs, &mut hs, &cert)?;\n    Vec<u8> th_cert = transcript_hash(&hs);"
    "\n    Vec<u8> content = Vec::filled(64, 0x20: u8);\n    Vec::extend_from(&mut content, b\"TLS 1.3, serv"
    "er CertificateVerify\");\n    Vec::push(&mut content, 0);\n    Vec::extend_from(&mut content, &th_cert)"
    ";\n    SignatureScheme scheme = scheme_of(scheme_code);\n    Vec<u8> signature = match (sign(key, &sch"
    "eme, &content))\n    {\n        Some(s) : s,\n        None    : return Err(HandshakeFailed),\n    };\n   "
    " Vec<u8> cv = Vec::new();\n    Vec::push(&mut cv, 15);\n    push_u24(&mut cv, 4 + Vec::len(&signature)"
    ");\n    Vec::push_be(&mut cv, scheme_code);\n    Vec::push_be(&mut cv, narrow<u16>(Vec::len(&signature"
    ")));\n    Vec::extend_from(&mut cv, &signature);\n    send_handshake(&mut tcp, &mut server_hs, &mut hs"
    ", &cv)?;\n    Vec<u8> th_cv = transcript_hash(&hs);\n    Vec<u8> fin_data = finished_data(kind, &s_hs,"
    " &th_cv);\n    Vec<u8> fin = Vec::new();\n    Vec::push(&mut fin, 20);\n    push_u24(&mut fin, Vec::len"
    "(&fin_data));\n    Vec::extend_from(&mut fin, &fin_data);\n    send_handshake(&mut tcp, &mut server_hs"
    ", &mut hs, &fin)?;\n    Vec<u8> th_fin = transcript_hash(&hs);\n    Vec<u8> derived2 = derive_secret(k"
    "ind, &handshake_secret, \"derived\", &empty_hash);\n    Vec<u8> master = hkdf_extract_with(kind, &deriv"
    "ed2, &zeros);\n    Vec<u8> c_ap = derive_secret(kind, &master, \"c ap traffic\", &th_fin);\n    Vec<u8> "
    "s_ap = derive_secret(kind, &master, \"s ap traffic\", &th_fin);\n    // The client's Finished, under it"
    "s handshake keys.\n    Option<RecordKeys> client_hs = Some(keys_from(&c_hs, suite));\n    Vec<u8> cfin"
    " = next_message(&mut hs, &mut tcp, &mut client_hs)?;\n    Vec<u8> want = finished_data(kind, &c_hs, &"
    "th_fin);\n    if (Vec::len(&cfin) != 4 + Vec::len(&want) || cfin[0] != 20 || !digest_eq(&cfin[4..$], "
    "&want))\n    {\n        return Err(HandshakeFailed);\n    }\n    if (Vec::len(&hs.buffer) != 0)\n    {\n  "
    "      return Err(ProtocolError);\n    }\n    Ok(TlsStream {\n        .tcp = tcp,\n        .send = keys_f"
    "rom(&s_ap, suite),\n        .recv = keys_from(&c_ap, suite),\n        .pending = Vec::new(),\n        ."
    "pending_at = 0,\n        .closed = false,\n        .peer = None,\n    })\n}fn same_session(ref<Vec<u8>, "
    "shared> a, ref<Vec<u8>, shared> b) : bool\n{\n    Vec::len(a) == Vec::len(b) && digest_eq(a, b)\n}expor"
    "t fn HttpError::text(ref<HttpError, shared> e) : str\n{\n    match (e)\n    {\n        HttpNetFailure(n)"
    " : NetError::text(n),\n        HttpTlsFailure(t) : TlsError::text(t),\n        BadUrl            : \"th"
    "e URL is malformed\",\n        UnsupportedScheme : \"the URL's scheme is neither http nor https\",\n     "
    "   NoRoots           : \"no trusted roots for https (TrustStore::system failed)\",\n        BadMessage "
    "       : \"the HTTP message is malformed\",\n        TooLarge          : \"the HTTP message is larger th"
    "an the limit\",\n        TooManyRedirects  : \"too many redirects\",\n        ConnectionClosed  : \"the co"
    "nnection was closed\",\n    }\n}fn default_port(StringView scheme) : u16\n{\n    if (scheme == \"https\") {"
    " 443 } else { 80 }\n}fn port_digits(StringView t) : Option<u16>\n{\n    slice<u8, shared> b = StringVie"
    "w::as_bytes(t);\n    if (slice_len(b) == 0 || slice_len(b) > 5)\n    {\n        return None;\n    }\n    "
    "u32 v = 0;\n    foreach (c in b)\n    {\n        if (*c < b'0' || *c > b'9')\n        {\n            retu"
    "rn None;\n        }\n        v = v * 10 + widen<u32>(*c - b'0');\n    }\n    if (v > 65535)\n    {\n      "
    "  return None;\n    }\n    Some(narrow<u16>(v))\n}fn host_ok(StringView h) : bool\n{\n    slice<u8, share"
    "d> b = StringView::as_bytes(h);\n    usize n = slice_len(b);\n    if (n == 0)\n    {\n        return fal"
    "se;\n    }\n    if (b[0] == b'[')\n    {\n        if (n < 3 || b[n - 1] != b']')\n        {\n            r"
    "eturn false;\n        }\n        for (usize i = 1; i + 1 < n; i += 1)\n        {\n            u8 c = b[i"
    "];\n            if (!(Option::is_some(&hex_digit(c)) || c == b':' || c == b'.'))\n            {\n      "
    "          return false;\n            }\n        }\n        return true;\n    }\n    foreach (p in b)\n    "
    "{\n        u8 c = *p;\n        bool sub_delim = false;\n        foreach (m in StringView::as_bytes(\"!$&"
    "'()*+,;=%\"))\n        {\n            if (*m == c)\n            {\n                sub_delim = true;\n    "
    "        }\n        }\n        if (!is_unreserved(c) && !sub_delim)\n        {\n            return false;"
    "\n        }\n    }\n    true\n}fn host_field_ok(StringView v) : bool\n{\n    StringView t = StringView::tr"
    "im(v);\n    slice<u8, shared> b = StringView::as_bytes(t);\n    usize n = slice_len(b);\n    if (n == 0"
    ")\n    {\n        return true;\n    }\n    usize host_end = n;\n    if (b[0] == b'[')\n    {\n        host_"
    "end = match (StringView::find(t, \"]\"))\n        {\n            Some(i) : i + 1,\n            None    : "
    "return false,\n        };\n    }\n    else\n    {\n        host_end = 0;\n        while (host_end < n && b"
    "[host_end] != b':')\n        {\n            host_end += 1;\n        }\n    }\n    if (!host_ok(&t[0..host"
    "_end]))\n    {\n        return false;\n    }\n    if (host_end == n)\n    {\n        return true;\n    }\n  "
    "  if (b[host_end] != b':' || n - host_end - 1 > 5)\n    {\n        return false;\n    }\n    for (usize "
    "i = host_end + 1; i < n; i += 1)\n    {\n        if (b[i] < b'0' || b[i] > b'9')\n        {\n           "
    " return false;\n        }\n    }\n    true\n}unittest \"host_field_ok: what a Host field may hold\"\n{\n    "
    "assert(host_field_ok(\"\") && host_field_ok(\"example.com\") && host_field_ok(\"h:8080\"));\n    assert(hos"
    "t_field_ok(\"[::1]:443\") && host_field_ok(\"127.0.0.1\"));\n    assert(!host_field_ok(\"evil.com/x?y@z w\""
    ") && !host_field_ok(\"a@b\") && !host_field_ok(\"h:80:80\"));\n    assert(!host_field_ok(\"[::1\") && !host"
    "_field_ok(\"h:8x\"));\n}export fn Url::parse(StringView text) : Result<Url, HttpError>\n{\n    foreach (c"
    " in StringView::as_bytes(text))\n    {\n        if (*c <= 32 || *c == 127)\n        {\n            retur"
    "n Err(BadUrl);\n        }\n    }\n    usize sep = match (StringView::find(text, \"://\"))\n    {\n        S"
    "ome(i) : i,\n        None    : return Err(BadUrl),\n    };\n    String scheme = StringView::to_ascii_lo"
    "wer(&String::copy(&text[0..sep]));\n    StringView rest = &text[sep + 3..$];\n    usize n = StringView"
    "::len(rest);\n    slice<u8, shared> b = StringView::as_bytes(rest);\n    usize auth_end = 0;\n    while"
    " (auth_end < n && b[auth_end] != b'/' && b[auth_end] != b'?' && b[auth_end] != b'#')\n    {\n        a"
    "uth_end += 1;\n    }\n    StringView authority = &rest[0..auth_end];\n    if (auth_end == 0 || Option::"
    "is_some(&StringView::find(authority, \"@\")))\n    {\n        return Err(BadUrl);\n    }\n    slice<u8, sh"
    "ared> ab = StringView::as_bytes(authority);\n    usize host_end = auth_end;\n    if (ab[0] == b'[')\n  "
    "  {\n        host_end = match (StringView::find(authority, \"]\"))\n        {\n            Some(i) : i + "
    "1,\n            None    : return Err(BadUrl),\n        };\n    }\n    else\n    {\n        host_end = 0;\n "
    "       while (host_end < auth_end && ab[host_end] != b':')\n        {\n            host_end += 1;\n    "
    "    }\n    }\n    if (!host_ok(&authority[0..host_end]))\n    {\n        return Err(BadUrl);\n    }\n    S"
    "tring host = StringView::to_ascii_lower(&String::copy(&authority[0..host_end]));\n    u16 port = defa"
    "ult_port(&scheme);\n    if (host_end < auth_end)\n    {\n        if (ab[host_end] != b':')\n        {\n  "
    "          return Err(BadUrl);\n        }\n        port = match (port_digits(&authority[host_end + 1..a"
    "uth_end]))\n        {\n            Some(p) : p,\n            None    : return Err(BadUrl),\n        };\n "
    "   }\n    usize path_end = auth_end;\n    while (path_end < n && b[path_end] != b'?' && b[path_end] !="
    " b'#')\n    {\n        path_end += 1;\n    }\n    String path = if (path_end == auth_end) { \"/\" } else\n "
    "   {\n        String::copy(&rest[auth_end..path_end])\n    };\n    String query = String::new();\n    if"
    " (path_end < n && b[path_end] == b'?')\n    {\n        usize q_end = path_end + 1;\n        while (q_en"
    "d < n && b[q_end] != b'#')\n        {\n            q_end += 1;\n        }\n        String::append(&mut q"
    "uery, &rest[path_end + 1..q_end]);\n    }\n    Ok(Url { .scheme = scheme, .host = host, .port = port, "
    ".path = path, .query = query })\n}unittest \"Url::parse: defaults and normalisation\"\n{\n    Url u = Res"
    "ult::unwrap(Url::parse(\"HTTPS://Example.com/a/b?x=1#top\"));\n    assert(u.scheme == \"https\" && u.host"
    " == \"example.com\" && u.port == 443);\n    assert(u.path == \"/a/b\" && u.query == \"x=1\");\n    assert(Ur"
    "l::target(&u) == \"/a/b?x=1\");\n    Url v = Result::unwrap(Url::parse(\"http://[::1]:8080\"));\n    asser"
    "t(v.host == \"[::1]\" && v.path == \"/\");\n    assert(Url::text(&v) == \"http://[::1]:8080/\");\n    assert"
    "(Result::is_err(&Url::parse(\"http://user@example.com/\")));\n}unittest \"Url::parse: what cannot be wri"
    "tten into a request\"\n{\n    assert(Result::is_err(&Url::parse(\"http://:8080/x\")));\n    assert(Result:"
    ":is_err(&Url::parse(\"http://host:+80/\")));\n    assert(Result::is_err(&Url::parse(\"http://example.com"
    "/a b\")));\n    assert(Result::is_err(&Url::parse(\"http://example.com/x\\r\\nX-Evil: 1\")));\n    assert(R"
    "esult::is_err(&Url::parse(\"http://exa mple.com/\")));\n    assert(Result::is_err(&Url::parse(\"http://e"
    "xa\\\"mple.com/\")));\n    assert(Result::is_err(&Url::parse(\"http://[::1/\")));\n    assert(Result::unwra"
    "p(Url::parse(\"http://127.0.0.1:65535/a%20b\")).port == 65535);\n}export fn Url::target(ref<Url, shared"
    "> u) : String\n{\n    String t = String::clone(&u.path);\n    if (StringView::len(&u.query) > 0)\n    {\n"
    "        String::append(&mut t, \"?\");\n        String::append(&mut t, &u.query);\n    }\n    t\n}fn host_"
    "text(ref<Url, shared> u) : String\n{\n    String h = String::clone(&u.host);\n    if (u.port != default"
    "_port(&u.scheme))\n    {\n        String::append(&mut h, \":\");\n        String::append(&mut h, u.port);"
    "\n    }\n    h\n}export fn Url::text(ref<Url, shared> u) : String\n{\n    String t = String::clone(&u.sch"
    "eme);\n    String::append(&mut t, \"://\");\n    String::append(&mut t, &host_text(u));\n    String::appe"
    "nd(&mut t, &Url::target(u));\n    t\n}fn is_unreserved(u8 b) : bool\n{\n    ascii_is_alnum(b) || b == b'"
    "-' || b == b'.' || b == b'_' || b == b'~'\n}export fn percent_encode(slice<u8, shared> bytes) : Strin"
    "g\n{\n    String out = String::new();\n    str digits = \"0123456789ABCDEF\";\n    foreach (c in bytes)\n  "
    "  {\n        if (is_unreserved(*c))\n        {\n            String::push_ascii(&mut out, *c);\n        }"
    "\n        else\n        {\n            String::push_ascii(&mut out, b'%');\n            String::push_asc"
    "ii(&mut out, str_byte(digits, widen<usize>(*c >> 4)));\n            String::push_ascii(&mut out, str_"
    "byte(digits, widen<usize>(*c & 15)));\n        }\n    }\n    out\n}fn hex_digit(u8 c) : Option<u8>\n{\n   "
    " if (c >= b'0' && c <= b'9') { Some(c - b'0') }\n    else if (c >= b'a' && c <= b'f') { Some(c - b'a'"
    " + 10) }\n    else if (c >= b'A' && c <= b'F') { Some(c - b'A' + 10) }\n    else { None }\n}export fn p"
    "ercent_decode(StringView text) : Option<Vec<u8>>\n{\n    slice<u8, shared> b = StringView::as_bytes(te"
    "xt);\n    Vec<u8> out = Vec::new();\n    usize i = 0;\n    while (i < slice_len(b))\n    {\n        if (b"
    "[i] == b'%')\n        {\n            if (i + 3 > slice_len(b))\n            {\n                return No"
    "ne;\n            }\n            u8 hi = hex_digit(b[i + 1])?;\n            u8 lo = hex_digit(b[i + 2])?"
    ";\n            Vec::push(&mut out, hi * 16 + lo);\n            i += 3;\n        }\n        else\n        "
    "{\n            Vec::push(&mut out, b[i]);\n            i += 1;\n        }\n    }\n    Some(out)\n}unittest"
    " \"percent_decode: the reverse of percent_encode\"\n{\n    assert(percent_encode(StringView::as_bytes(\"a"
    " b/ü\")) == \"a%20b%2F%C3%BC\");\n    Vec<u8> back = Option::unwrap(percent_decode(\"a%20b%2f\"));\n    as"
    "sert(Result::unwrap(String::from_utf8(back)) == \"a b/\");\n    assert(Option::is_none(&percent_decode("
    "\"100%\")));\n}export fn Param::new(StringView name, StringView value) : Param\n{\n    Param { .name = St"
    "ring::copy(name), .value = String::copy(value) }\n}export fn find_param(slice<Param, shared> params, "
    "StringView name) : Option<StringView> from params\n{\n    for (usize i = 0; i < slice_len(params); i +"
    "= 1)\n    {\n        if (params[i].name == name)\n        {\n            return Some(&params[i].value);\n"
    "        }\n    }\n    None\n}export fn form_decode(StringView text) : Vec<Param>\n{\n    Vec<Param> out ="
    " Vec::new();\n    foreach (p in StringView::split(text, \"&\"))\n    {\n        if (StringView::len(p) =="
    " 0)\n        {\n            continue;\n        }\n        StringView name = p;\n        StringView value "
    "= \"\";\n        if (Some(eq) = StringView::find(p, \"=\"))\n        {\n            name = &p[0..eq];\n     "
    "       value = &p[eq + 1..$];\n        }\n        Vec::push(&mut out, Param { .name = form_part(name),"
    " .value = form_part(value) });\n    }\n    out\n}unittest \"form_decode: pairs, bare names and bad escap"
    "es\"\n{\n    Vec<Param> ps = form_decode(\"q=red+fish&flag&&n=%41&x=%zz;role=admin\");\n    assert(Vec::le"
    "n(&ps) == 4);\n    assert(Option::unwrap(find_param(&ps, \"q\")) == \"red fish\");\n    assert(Option::unw"
    "rap(find_param(&ps, \"flag\")) == \"\");\n    assert(Option::unwrap(find_param(&ps, \"n\")) == \"A\");\n    as"
    "sert(Option::unwrap(find_param(&ps, \"x\")) == \"%zz;role=admin\");\n    assert(Option::is_none(&find_par"
    "am(&ps, \"role\")));\n    assert(Option::is_none(&find_param(&ps, \"Q\")));\n}fn form_part(StringView v) :"
    " String\n{\n    String plus = StringView::replace(v, \"+\", \" \");\n    match (percent_decode(&plus))\n    "
    "{\n        Some(b) : match (String::from_utf8(b))\n        {\n            Ok(s)  : s,\n            Err(_"
    ") : plus,\n        },\n        None : plus,\n    }\n}export fn form_encode(slice<Param, shared> params) "
    ": String\n{\n    String out = String::new();\n    for (usize i = 0; i < slice_len(params); i += 1)\n    "
    "{\n        if (i > 0)\n        {\n            String::push_ascii(&mut out, b'&');\n        }\n        Str"
    "ing::append(&mut out, &form_encode_part(&params[i].name));\n        String::push_ascii(&mut out, b'='"
    ");\n        String::append(&mut out, &form_encode_part(&params[i].value));\n    }\n    out\n}unittest \"f"
    "orm_encode: spaces and reserved bytes\"\n{\n    Vec<Param> ps = Vec::new();\n    Vec::push(&mut ps, Para"
    "m::new(\"q\", \"a b&c\"));\n    Vec::push(&mut ps, Param::new(\"lang\", \"en\"));\n    String body = form_enco"
    "de(&ps);\n    assert(body == \"q=a+b%26c&lang=en\");\n    Vec<Param> back = form_decode(&body);\n    asse"
    "rt(back[0].value == \"a b&c\");\n}fn form_encode_part(ref<String, shared> s) : String\n{\n    String enc "
    "= percent_encode(StringView::as_bytes(s));\n    StringView::replace(&enc, \"%20\", \"+\")\n}export fn Url:"
    ":query_pairs(ref<Url, shared> u) : Vec<Param>\n{\n    form_decode(&u.query)\n}export fn Header::new(Str"
    "ingView name, StringView value) : Header\n{\n    Header { .name = String::copy(name), .value = String:"
    ":copy(value) }\n}fn name_eq(StringView a, str b) : bool\n{\n    ascii_ieq_str(a.bytes, b)\n}fn names_eq("
    "StringView a, StringView b) : bool\n{\n    ascii_ieq(a.bytes, b.bytes)\n}fn ascii_ieq(slice<u8, shared>"
    " a, slice<u8, shared> b) : bool\n{\n    if (slice_len(a) != slice_len(b))\n    {\n        return false;\n"
    "    }\n    for (usize i = 0; i < slice_len(a); i += 1)\n    {\n        if (ascii_to_lower(a[i]) != asci"
    "i_to_lower(b[i]))\n        {\n            return false;\n        }\n    }\n    true\n}fn ascii_ieq_str(sli"
    "ce<u8, shared> a, str b) : bool\n{\n    if (slice_len(a) != str_len(b))\n    {\n        return false;\n  "
    "  }\n    for (usize i = 0; i < slice_len(a); i += 1)\n    {\n        if (ascii_to_lower(a[i]) != ascii_"
    "to_lower(str_byte(b, i)))\n        {\n            return false;\n        }\n    }\n    true\n}fn has_heade"
    "r(slice<Header, shared> headers, StringView name) : bool\n{\n    for (usize i = 0; i < slice_len(heade"
    "rs); i += 1)\n    {\n        if (names_eq(&headers[i].name, name))\n        {\n            return true;\n"
    "        }\n    }\n    false\n}export fn find_header(slice<Header, shared> headers, StringView name) : O"
    "ption<StringView> from headers\n{\n    for (usize i = 0; i < slice_len(headers); i += 1)\n    {\n       "
    " if (names_eq(&headers[i].name, name))\n        {\n            return Some(&headers[i].value);\n       "
    " }\n    }\n    None\n}export fn Request::new(StringView method, StringView url) : Request\n{\n    Request"
    " { .method = String::copy(method), .url = String::copy(url), .headers = Vec::new(), .body = Vec::new"
    "() }\n}export fn Request::header(ref<Request, shared> r, StringView name) : Option<StringView> from r"
    "\n{\n    find_header(&r.headers, name)\n}unittest \"Request::header: names ignore case\"\n{\n    Request r "
    "= Request::new(\"POST\", \"https://example.com/upload\");\n    Vec::push(&mut r.headers, Header::new(\"Con"
    "tent-Type\", \"text/plain\"));\n    assert(Option::unwrap(Request::header(&r, \"content-type\")) == \"text/"
    "plain\");\n    assert(Option::is_none(&Request::header(&r, \"accept\")));\n}export fn Response::header(re"
    "f<Response, shared> r, StringView name) : Option<StringView> from r\n{\n    find_header(&r.headers, na"
    "me)\n}export fn Response::text(ref<Response, shared> r) : Result<String, Utf8Error>\n{\n    String::fro"
    "m_utf8(Vec::clone(&r.body))\n}export fn reason_phrase(u16 status) : str\n{\n    match (status)\n    {\n  "
    "      100 : \"Continue\",\n        101 : \"Switching Protocols\",\n        200 : \"OK\",\n        201 : \"Crea"
    "ted\",\n        202 : \"Accepted\",\n        203 : \"Non-Authoritative Information\",\n        204 : \"No Con"
    "tent\",\n        205 : \"Reset Content\",\n        206 : \"Partial Content\",\n        300 : \"Multiple Choic"
    "es\",\n        301 : \"Moved Permanently\",\n        302 : \"Found\",\n        303 : \"See Other\",\n        30"
    "4 : \"Not Modified\",\n        305 : \"Use Proxy\",\n        307 : \"Temporary Redirect\",\n        308 : \"Pe"
    "rmanent Redirect\",\n        400 : \"Bad Request\",\n        401 : \"Unauthorized\",\n        402 : \"Payment"
    " Required\",\n        403 : \"Forbidden\",\n        404 : \"Not Found\",\n        405 : \"Method Not Allowed\""
    ",\n        406 : \"Not Acceptable\",\n        407 : \"Proxy Authentication Required\",\n        408 : \"Requ"
    "est Timeout\",\n        409 : \"Conflict\",\n        410 : \"Gone\",\n        411 : \"Length Required\",\n     "
    "   412 : \"Precondition Failed\",\n        413 : \"Content Too Large\",\n        414 : \"URI Too Long\",\n   "
    "     415 : \"Unsupported Media Type\",\n        416 : \"Range Not Satisfiable\",\n        417 : \"Expectati"
    "on Failed\",\n        421 : \"Misdirected Request\",\n        422 : \"Unprocessable Content\",\n        426 "
    ": \"Upgrade Required\",\n        429 : \"Too Many Requests\",\n        500 : \"Internal Server Error\",\n    "
    "    501 : \"Not Implemented\",\n        502 : \"Bad Gateway\",\n        503 : \"Service Unavailable\",\n     "
    "   504 : \"Gateway Timeout\",\n        505 : \"HTTP Version Not Supported\",\n        _   : \"\",\n    }\n}uni"
    "ttest \"reason_phrase: unlisted codes\"\n{\n    assert(reason_phrase(404) == \"Not Found\");\n    assert(re"
    "ason_phrase(422) == \"Unprocessable Content\");\n    assert(reason_phrase(410) == \"Gone\");\n    assert(r"
    "eason_phrase(299) == \"\");\n}fn conn_read(ref<Conn, exclusive> c, ref<Vec<u8>, exclusive> buf, usize m"
    "ax) : Result<usize, HttpError>\n{\n    match (c)\n    {\n        Plain(s) : match (TcpStream::read(s, bu"
    "f, max))\n        {\n            Ok(n)  : Ok(n),\n            Err(e) : Err(HttpNetFailure(e)),\n        "
    "},\n        Secure(s) : match (TlsStream::read(s, buf, max))\n        {\n            Ok(n)  : Ok(n),\n  "
    "          Err(e) : Err(HttpTlsFailure(e)),\n        },\n        Gone : Err(ConnectionClosed),\n    }\n}f"
    "n conn_write(ref<Conn, exclusive> c, slice<u8, shared> data) : Result<void, HttpError>\n{\n    match ("
    "c)\n    {\n        Plain(s) : match (TcpStream::write(s, data))\n        {\n            Ok(_)  : Ok(()),"
    "\n            Err(e) : Err(HttpNetFailure(e)),\n        },\n        Secure(s) : match (TlsStream::write"
    "(s, data))\n        {\n            Ok(_)  : Ok(()),\n            Err(e) : Err(HttpTlsFailure(e)),\n     "
    "   },\n        Gone : Err(ConnectionClosed),\n    }\n}fn conn_close(ref<Conn, exclusive> c)\n{\n    match"
    " (c)\n    {\n        Plain(s)  : { _ = TcpStream::shutdown_write(s); },\n        Secure(s) : { _ = TlsS"
    "tream::close(s); },\n        Gone      : {},\n    }\n}fn fill_buffer(ref<Reader, exclusive> r) : Result"
    "<bool, HttpError>\n{\n    if (r.at > 0)\n    {\n        if (r.at == Vec::len(&r.buf))\n        {\n        "
    "    Vec::clear(&mut r.buf);\n        }\n        else\n        {\n            Vec<u8> rest = Vec::from_sl"
    "ice(&r.buf[r.at..$]);\n            overwrite(&mut r.buf, rest);\n        }\n        r.at = 0;\n    }\n   "
    " if (r.deadline_ns != 0 && monotonic_ns() >= r.deadline_ns)\n    {\n        return Err(HttpNetFailure("
    "TimedOut));\n    }\n    usize n = conn_read(&mut r.conn, &mut r.buf, 16384)?;\n    if (r.deadline_ns !="
    " 0 && n > 0 && monotonic_ns() >= r.deadline_ns)\n    {\n        return Err(HttpNetFailure(TimedOut));\n"
    "    }\n    Ok(n > 0)\n}fn drain_input(ref<Reader, exclusive> r, usize max)\n{\n    r.deadline_ns = 0;\n  "
    "  usize seen = 0;\n    while (seen < max)\n    {\n        Vec::clear(&mut r.buf);\n        r.at = 0;\n   "
    "     match (conn_read(&mut r.conn, &mut r.buf, 65536))\n        {\n            Ok(n)  :\n            {\n"
    "                if (n == 0)\n                {\n                    break;\n                }\n         "
    "       seen += n;\n            },\n            Err(_) : break,\n        }\n    }\n    Vec::clear(&mut r.b"
    "uf);\n}fn available(ref<Reader, shared> r) : usize\n{\n    Vec::len(&r.buf) - r.at\n}fn http_newline_fro"
    "m(slice<u8, shared> b, usize at) : usize\n{\n    usize i = at;\n    while (i < slice_len(b) && b[i] != "
    "b'\\n')\n    {\n        i += 1;\n    }\n    i\n}fn http_line(ref<Reader, exclusive> r, usize limit) : Resu"
    "lt<Option<String>, HttpError>\n{\n    http_line_mode(r, limit, false)\n}fn http_line_crlf(ref<Reader, e"
    "xclusive> r, usize limit) : Result<Option<String>, HttpError>\n{\n    http_line_mode(r, limit, true)\n}"
    "fn has_cr(slice<u8, shared> b) : bool\n{\n    foreach (c in b)\n    {\n        if (*c == b'\\r')\n        "
    "{\n            return true;\n        }\n    }\n    false\n}fn utf8_valid(slice<u8, shared> b) : bool\n{\n  "
    "  Result::is_ok(&StringView::from_utf8(b))\n}fn latin1_to_utf8(slice<u8, shared> b) : Vec<u8>\n{\n    V"
    "ec<u8> out = Vec::new();\n    foreach (c in b)\n    {\n        u8 x = *c;\n        if (x < 128)\n        "
    "{\n            Vec::push(&mut out, x);\n        }\n        else\n        {\n            Vec::push(&mut ou"
    "t, 192 | (x >> 6));\n            Vec::push(&mut out, 128 | (x & 63));\n        }\n    }\n    out\n}fn htt"
    "p_line_mode(ref<Reader, exclusive> r, usize limit, bool strict) : Result<Option<String>, HttpError>\n"
    "{\n    usize scanned = 0;\n    while (true)\n    {\n        usize i = http_newline_from(&r.buf, r.at + s"
    "canned);\n        if (i < Vec::len(&r.buf))\n        {\n            usize end = if (i > r.at && r.buf[i"
    " - 1] == b'\\r') { i - 1 } else { i };\n            if (strict && (end == i || has_cr(&r.buf[r.at..end"
    "])))\n            {\n                return Err(BadMessage);\n            }\n            Vec<u8> bytes ="
    " Vec::from_slice(&r.buf[r.at..end]);\n            r.at = i + 1;\n            // Report 425: a line tha"
    "t is not UTF-8 is read as ISO-8859-1, each\n            // byte the character of its value (RFC 9110 "
    "§5.5's obs-text: a\n            // Latin-1 file name or cookie), as browsers and curl take it.\n     "
    "       Vec<u8> text = if (utf8_valid(&bytes[0..$])) { bytes } else { latin1_to_utf8(&bytes[0..$]) };"
    "\n            return match (String::from_utf8(text))\n            {\n                Ok(s)  : Ok(Some(s"
    ")),\n                Err(_) : Err(BadMessage),\n            };\n        }\n        scanned = Vec::len(&r"
    ".buf) - r.at;\n        if (scanned > limit)\n        {\n            return Err(TooLarge);\n        }\n   "
    "     if (!fill_buffer(r)?)\n        {\n            return if (scanned == 0) { Ok(None) } else { Err(Ba"
    "dMessage) };\n        }\n    }\n}fn read_n(ref<Reader, exclusive> r, ref<Vec<u8>, exclusive> out, usize"
    " n) : Result<void, HttpError>\n{\n    usize need = n;\n    while (need > 0)\n    {\n        if (available"
    "(r) == 0)\n        {\n            if (!fill_buffer(r)?)\n            {\n                return Err(Conne"
    "ctionClosed);\n            }\n        }\n        usize take = min(need, available(r));\n        Vec::ext"
    "end_from(out, &r.buf[r.at..r.at + take]);\n        r.at += take;\n        need -= take;\n    }\n    Ok(("
    "))\n}fn read_to_end(ref<Reader, exclusive> r, ref<Vec<u8>, exclusive> out, usize max) : Result<void, "
    "HttpError>\n{\n    while (true)\n    {\n        usize have = available(r);\n        if (have > 0)\n       "
    " {\n            if (Vec::len(out) + have > max)\n            {\n                return Err(TooLarge);\n "
    "           }\n            Vec::extend_from(out, &r.buf[r.at..$]);\n            r.at = Vec::len(&r.buf)"
    ";\n        }\n        if (!fill_buffer(r)?)\n        {\n            return Ok(());\n        }\n    }\n}fn r"
    "ead_headers(ref<Reader, exclusive> r, usize used) : Result<Vec<Header>, HttpError>\n{\n    Vec<Header>"
    " headers = Vec::new();\n    usize total = used;\n    while (true)\n    {\n        String line = match (h"
    "ttp_line(r, MAX_HEAD)?)\n        {\n            Some(l) : l,\n            None    : return Err(BadMessa"
    "ge),\n        };\n        total += StringView::len(&line) + 2;\n        if (total > MAX_HEAD)\n        {"
    "\n            return Err(TooLarge);\n        }\n        if (StringView::len(&line) == 0)\n        {\n    "
    "        return Ok(headers);\n        }\n        StringView v = &line;\n        usize colon = match (Str"
    "ingView::find(v, \":\"))\n        {\n            Some(i) : i,\n            None    : return Err(BadMessag"
    "e),\n        };\n        StringView name = &v[0..colon];\n        if (colon == 0 || !is_token(name))\n  "
    "      {\n            return Err(BadMessage);\n        }\n        // RFC 9110 §5.5: a field value holds"
    " no NUL, CR or LF (nor another\n        // control but the tab).\n        foreach (b in StringView::as"
    "_bytes(&v[colon + 1..$]))\n        {\n            if ((*b < 32 && *b != 9) || *b == 127)\n            {"
    "\n                return Err(BadMessage);\n            }\n        }\n        Vec::push(\n            &mut"
    " headers,\n            Header { .name = String::copy(name), .value = String::copy(StringView::trim(&v"
    "[colon + 1..$])) },\n        );\n    }\n}fn is_token(StringView s) : bool\n{\n    if (StringView::len(s) "
    "== 0)\n    {\n        return false;\n    }\n    foreach (b in StringView::as_bytes(s))\n    {\n        u8 "
    "c = *b;\n        bool alnum = (c >= b'0' && c <= b'9') || (c >= b'a' && c <= b'z') || (c >= b'A' && c"
    " <= b'Z');\n        bool mark = false;\n        foreach (m in StringView::as_bytes(\"!#$%&'*+-.^_`|~\"))"
    "\n        {\n            if (*m == c)\n            {\n                mark = true;\n            }\n       "
    " }\n        if (!alnum && !mark)\n        {\n            return false;\n        }\n    }\n    true\n}fn fie"
    "ld_ok(ref<Header, shared> h) : bool\n{\n    if (!is_token(&h.name))\n    {\n        return false;\n    }\n"
    "    foreach (b in StringView::as_bytes(&h.value))\n    {\n        if ((*b < 32 && *b != 9) || *b == 12"
    "7)\n        {\n            return false;\n        }\n    }\n    true\n}fn write_field(ref<String, exclusiv"
    "e> head, ref<Header, shared> h) : Result<void, HttpError>\n{\n    if (!field_ok(h))\n    {\n        retu"
    "rn Err(BadMessage);\n    }\n    String::append(head, &h.name);\n    String::append(head, \": \");\n    Str"
    "ing::append(head, &h.value);\n    String::append(head, \"\\r\\n\");\n    Ok(())\n}fn connection_has(slice<H"
    "eader, shared> headers, str option) : bool\n{\n    for (usize i = 0; i < slice_len(headers); i += 1)\n "
    "   {\n        if (names_eq(&headers[i].name, \"connection\"))\n        {\n            foreach (o in Strin"
    "gView::split(&headers[i].value, \",\"))\n            {\n                if (name_eq(StringView::trim(o),"
    " option))\n                {\n                    return true;\n                }\n            }\n       "
    " }\n    }\n    false\n}unittest \"connection_has: a list of options\"\n{\n    Vec<Header> hs = Vec::new();\n"
    "    Vec::push(&mut hs, Header::new(\"Connection\", \"keep-alive, Close\"));\n    assert(connection_has(&h"
    "s, \"close\") && connection_has(&hs, \"keep-alive\"));\n    assert(!connection_has(&hs, \"upgrade\"));\n    "
    "assert(!field_ok(&Header::new(\"X\", \"a\\r\\nSet-Cookie: x\")));\n    assert(!field_ok(&Header::new(\"X Y\","
    " \"a\")));\n    assert(field_ok(&Header::new(\"X\", \"a\\tb\")));\n}fn count_header(slice<Header, shared> hea"
    "ders, StringView name) : usize\n{\n    usize n = 0;\n    for (usize i = 0; i < slice_len(headers); i +="
    " 1)\n    {\n        if (names_eq(&headers[i].name, name))\n        {\n            n += 1;\n        }\n    "
    "}\n    n\n}fn body_length(slice<Header, shared> headers, bool response) : Result<BodyLength, HttpError"
    ">\n{\n    Option<StringView> te = find_header(headers, \"transfer-encoding\");\n    Option<StringView> cl"
    " = find_header(headers, \"content-length\");\n    if (Some(t) = te)\n    {\n        if (Option::is_some(&"
    "cl) || count_header(headers, \"transfer-encoding\") != 1 || !name_eq(StringView::trim(t), \"chunked\"))\n"
    "        {\n            return Err(BadMessage);\n        }\n        return Ok(Chunked);\n    }\n    if (So"
    "me(c) = cl)\n    {\n        StringView first = StringView::trim(c);\n        for (usize i = 0; i < slic"
    "e_len(headers); i += 1)\n        {\n            if (names_eq(&headers[i].name, \"content-length\") && St"
    "ringView::trim(&headers[i].value) != first)\n            {\n                return Err(BadMessage);\n  "
    "          }\n        }\n        foreach (b in StringView::as_bytes(first))\n        {\n            if (*"
    "b < b'0' || *b > b'9')\n            {\n                return Err(BadMessage);\n            }\n        }"
    "\n        return match (StringView::parse<usize>(first))\n        {\n            Ok(n)  : Ok(Length(n))"
    ",\n            Err(_) : Err(BadMessage),\n        };\n    }\n    Ok(if (response) { UntilClose } else { "
    "NoBody })\n}unittest \"body_length: Content-Length fields that disagree\"\n{\n    Vec<Header> same = Vec:"
    ":new();\n    Vec::push(&mut same, Header { .name = \"Content-Length\", .value = \"3\" });\n    Vec::push(&"
    "mut same, Header { .name = \"content-length\", .value = \"3\" });\n    assert(Result::is_ok(&body_length("
    "&same, false)));\n    Vec<Header> two = Vec::new();\n    Vec::push(&mut two, Header { .name = \"Content"
    "-Length\", .value = \"1\" });\n    Vec::push(&mut two, Header { .name = \"Content-Length\", .value = \"30\" "
    "});\n    assert(Result::is_err(&body_length(&two, false)));\n    Vec<Header> sign = Vec::new();\n    Ve"
    "c::push(&mut sign, Header { .name = \"Content-Length\", .value = \"+3\" });\n    assert(Result::is_err(&b"
    "ody_length(&sign, false)));\n    Vec<Header> te = Vec::new();\n    Vec::push(&mut te, Header { .name ="
    " \"Transfer-Encoding\", .value = \"chunked\" });\n    Vec::push(&mut te, Header { .name = \"Transfer-Encod"
    "ing\", .value = \"chunked\" });\n    assert(Result::is_err(&body_length(&te, false)));\n}fn chunk_size(St"
    "ringView line) : Option<usize>\n{\n    slice<u8, shared> b = StringView::as_bytes(line);\n    usize n ="
    " slice_len(b);\n    usize i = 0;\n    usize size = 0;\n    // Report 423: the digits past the eighth ar"
    "e counted, not added in\n    // (17 of them overflowed `usize` and faulted the server or client).\n   "
    " while (i < n && Option::is_some(&hex_digit(b[i])))\n    {\n        if (i < 8)\n        {\n            s"
    "ize = size * 16 + widen<usize>(hex_digit(b[i])?);\n        }\n        i += 1;\n    }\n    if (i == 0 || "
    "i > 8)\n    {\n        return None;\n    }\n    while (i < n && (b[i] == b' ' || b[i] == 9))\n    {\n     "
    "   i += 1;\n    }\n    if (i < n && b[i] != b';')\n    {\n        return None;\n    }\n    while (i < n)\n "
    "   {\n        if ((b[i] < 32 && b[i] != 9) || b[i] == 127)\n        {\n            return None;\n       "
    " }\n        i += 1;\n    }\n    Some(size)\n}unittest \"chunk_size: what a chunk-size line may hold\"\n{\n  "
    "  assert(Option::unwrap(chunk_size(\"1f\")) == 31);\n    assert(Option::unwrap(chunk_size(\"3 ;name=\\\"v\\"
    "\"\")) == 3);\n    assert(Option::is_none(&chunk_size(\" 3\")));\n    assert(Option::is_none(&chunk_size(\""
    "3 x\")));\n    assert(Option::is_none(&chunk_size(\"+3\")));\n    assert(Option::is_none(&chunk_size(\"2;a"
    "\\u{1}\")));\n    assert(Option::is_none(&chunk_size(\"\")));\n    assert(Option::is_none(&chunk_size(\"123"
    "456789\")));\n}fn read_body(ref<Reader, exclusive> r, BodyLength how, usize max) : Result<Vec<u8>, Htt"
    "pError>\n{\n    Vec<u8> body = Vec::new();\n    match (how)\n    {\n        NoBody     : {},\n        Leng"
    "th(n)  :\n        {\n            if (n > max)\n            {\n                return Err(TooLarge);\n    "
    "        }\n            read_n(r, &mut body, n)?;\n        },\n        UntilClose : read_to_end(r, &mut "
    "body, max)?,\n        Chunked    :\n        {\n            while (true)\n            {\n                S"
    "tring line = match (http_line_crlf(r, MAX_HEAD)?)\n                {\n                    Some(l) : l,"
    "\n                    None    : return Err(ConnectionClosed),\n                };\n                usiz"
    "e size = Option::ok_or(chunk_size(&line), BadMessage)?;\n                if (size == 0)\n             "
    "   {\n                    break;\n                }\n                if (Vec::len(&body) + size > max)\n"
    "                {\n                    return Err(TooLarge);\n                }\n                read_n"
    "(r, &mut body, size)?;\n                match (http_line_crlf(r, 2)?)\n                {\n             "
    "       Some(end) : if (StringView::len(&end) != 0) { return Err(BadMessage); },\n                    "
    "None      : return Err(ConnectionClosed),\n                }\n            }\n            // Trailers, u"
    "p to the empty line: fields, within the head's\n            // limit (a stream of trailer lines is no"
    "t read without end).\n            _ = read_headers(r, 0)?;\n        },\n    }\n    Ok(body)\n}export fn H"
    "ttpClient::new() : HttpClient\n{\n    Vec<Header> headers = Vec::new();\n    Vec::push(&mut headers, He"
    "ader::new(\"User-Agent\", \"CobaltC-std-http/1\"));\n    Vec::push(&mut headers, Header::new(\"Accept-Enco"
    "ding\", \"gzip, deflate\"));\n    HttpClient { .roots = None, .timeout_ms = 30000, .max_redirects = 10, "
    ".max_body = 16777216, .headers = headers, .keep_alive = false, .idle = None }\n}unittest \"HttpClient:"
    ":new: the defaults\"\n{\n    HttpClient c = HttpClient::new();\n    assert(c.timeout_ms == 30000 && c.ma"
    "x_redirects == 10 && !c.keep_alive);\n    assert(Option::is_none(&c.roots));\n    assert(Option::is_so"
    "me(&find_header(&c.headers, \"user-agent\")));\n    c.max_body = 1_048_576;\n}fn method_has_body(StringV"
    "iew m) : bool\n{\n    (m == \"POST\") || (m == \"PUT\") || (m == \"PATCH\")\n}fn open_connection(ref<HttpClie"
    "nt, exclusive> c, ref<Url, shared> u) : Result<Conn, HttpError>\n{\n    bool secure = (u.scheme == \"ht"
    "tps\");\n    if (!secure && u.scheme != \"http\")\n    {\n        return Err(UnsupportedScheme);\n    }\n   "
    " if (secure && Option::is_none(&c.roots))\n    {\n        match (TrustStore::system())\n        {\n     "
    "       Ok(t)  : overwrite(&mut c.roots, Some(t)),\n            Err(_) : return Err(NoRoots),\n        "
    "}\n    }\n    // A bracketed IPv6 host loses its brackets for resolution.\n    String host = String::cl"
    "one(&u.host);\n    if (StringView::starts_with(&host, \"[\") && StringView::ends_with(&host, \"]\"))\n    "
    "{\n        overwrite(&mut host, String::copy(&u.host[1..StringView::len(&u.host) - 1]));\n    }\n    Ve"
    "c<SocketAddr> addrs = match (IpAddr::parse(&host))\n    {\n        Ok(ip) :\n        {\n            Vec<"
    "SocketAddr> one = Vec::new();\n            Vec::push(&mut one, SocketAddr::new(ip, u.port));\n        "
    "    one\n        },\n        Err(_) : match (resolve(&host, u.port))\n        {\n            Ok(a)  : a,"
    "\n            Err(e) : return Err(HttpNetFailure(e)),\n        },\n    };\n    if (Vec::len(&addrs) == 0"
    ")\n    {\n        return Err(HttpNetFailure(UnknownHost));\n    }\n    NetError last = Failed;\n    for ("
    "usize i = 0; i < Vec::len(&addrs); i += 1)\n    {\n        TcpStream tcp = match (TcpStream::connect_t"
    "imeout(addrs[i], c.timeout_ms))\n        {\n            Ok(t)  : t,\n            Err(e) :\n            {"
    "\n                last = e;\n                continue;\n            },\n        };\n        TcpStream::se"
    "t_read_timeout_ms(&mut tcp, c.timeout_ms);\n        TcpStream::set_write_timeout_ms(&mut tcp, c.timeo"
    "ut_ms);\n        TcpStream::set_nodelay(&mut tcp, true);\n        if (!secure)\n        {\n            r"
    "eturn Ok(Plain(tcp));\n        }\n        ref<TrustStore, shared> roots = match (&c.roots)\n        {\n "
    "           Some(r) : r,\n            None    : return Err(NoRoots),\n        };\n        return match ("
    "TlsStream::client(tcp, &host, roots))\n        {\n            Ok(s)  : Ok(Secure(s)),\n            Err("
    "e) : Err(HttpTlsFailure(e)),\n        };\n    }\n    Err(HttpNetFailure(last))\n}fn is_framing(StringVie"
    "w name) : bool\n{\n    name_eq(name, \"host\") || name_eq(name, \"content-length\") || name_eq(name, \"conn"
    "ection\") || name_eq(name, \"transfer-encoding\")\n}fn is_credential(StringView name) : bool\n{\n    name_"
    "eq(name, \"authorization\") || name_eq(name, \"proxy-authorization\") || name_eq(name, \"cookie\")\n}fn req"
    "uest_bytes(\n    ref<HttpClient, shared> c,\n    ref<Request, shared> req,\n    ref<Url, shared> u,\n   "
    " StringView method,\n    slice<u8, shared> body,\n    bool with_content,\n    bool credentials,\n) : Res"
    "ult<Vec<u8>, HttpError>\n{\n    // The method is a token and every header a valid field, so nothing\n  "
    "  // taken from data can end a line of the request and start another\n    // (the URL's parts are che"
    "cked by `Url::parse`).\n    if (!is_token(method))\n    {\n        return Err(BadMessage);\n    }\n    St"
    "ring head = String::copy(method);\n    String::append(&mut head, \" \");\n    String::append(&mut head, "
    "&Url::target(u));\n    String::append(&mut head, \" HTTP/1.1\\r\\nHost: \");\n    String::append(&mut head"
    ", &host_text(u));\n    String::append(&mut head, \"\\r\\n\");\n    foreach (h in &c.headers)\n    {\n       "
    " StringView name = &h.name;\n        bool kept = (credentials || !is_credential(name)) && !is_framing"
    "(name);\n        if (kept && !has_header(&req.headers, name))\n        {\n            write_field(&mut "
    "head, h)?;\n        }\n    }\n    foreach (h in &req.headers)\n    {\n        if (is_framing(&h.name))\n  "
    "      {\n            continue;\n        }\n        // After a redirect to another origin, no credential"
    "s go there.\n        if (!credentials && is_credential(&h.name))\n        {\n            continue;\n    "
    "    }\n        // After a redirect that dropped the body, its Content-Type goes too.\n        if (!wit"
    "h_content && name_eq(&h.name, \"content-type\"))\n        {\n            continue;\n        }\n        wri"
    "te_field(&mut head, h)?;\n    }\n    if (slice_len(body) > 0 || method_has_body(method))\n    {\n       "
    " String::append(&mut head, \"Content-Length: \");\n        String::append(&mut head, slice_len(body));\n"
    "        String::append(&mut head, \"\\r\\n\");\n    }\n    if (!c.keep_alive)\n    {\n        String::append"
    "(&mut head, \"Connection: close\\r\\n\");\n    }\n    String::append(&mut head, \"\\r\\n\");\n    Vec<u8> out ="
    " String::into_bytes(head);\n    Vec::extend_from(&mut out, body);\n    Ok(out)\n}fn not_content_encodin"
    "g(ref<Header, shared> h) : bool\n{\n    !name_eq(&h.name, \"content-encoding\") && !name_eq(&h.name, \"co"
    "ntent-length\")\n}fn parse_status_line(StringView line) : Result<StatusLine, HttpError>\n{\n    if (!Str"
    "ingView::starts_with(line, \"HTTP/1.\") || StringView::len(line) < 12)\n    {\n        return Err(BadMes"
    "sage);\n    }\n    // The version, the space, the three digits and the space are ASCII\n    // (RFC 911"
    "2 §4): a byte of 128 or more among them is a malformed line,\n    // not a place to cut a character "
    "in two (found by the hostile-input\n    // round, D-0211).\n    for (usize i = 0; i < 13 && i < String"
    "View::len(line); i += 1)\n    {\n        if (line.bytes[i] >= 128)\n        {\n            return Err(Ba"
    "dMessage);\n        }\n    }\n    u16 status = match (StringView::parse<u16>(&line[9..12]))\n    {\n     "
    "   Ok(v)  : v,\n        Err(_) : return Err(BadMessage),\n    };\n    if (status < 100 || status > 599)"
    "\n    {\n        return Err(BadMessage);\n    }\n    String reason = if (StringView::len(line) > 13)\n   "
    " {\n        String::copy(&line[13..$])\n    }\n    else { String::new() };\n    Ok(StatusLine { .status "
    "= status, .reason = reason })\n}fn origin_of(ref<Url, shared> u) : String\n{\n    String o = String::cl"
    "one(&u.scheme);\n    String::append(&mut o, \"://\");\n    String::append(&mut o, &host_text(u));\n    o\n"
    "}fn idempotent(StringView method) : bool\n{\n    method == \"GET\" || method == \"HEAD\" || method == \"PUT"
    "\" || method == \"DELETE\" || method == \"OPTIONS\" || method == \"TRACE\"\n}fn exchange(\n    ref<HttpClient"
    ", exclusive> c,\n    ref<Request, shared> req,\n    ref<Url, shared> u,\n    StringView method,\n    sli"
    "ce<u8, shared> body,\n    bool with_content,\n    bool credentials,\n) : Result<Response, HttpError>\n{\n"
    "    Vec<u8> bytes = request_bytes(c, req, u, method, body, with_content, credentials)?;\n    String w"
    "ant = origin_of(u);\n    if (Some(ic) = replace(&mut c.idle, None))\n    {\n        IdleConn { origin, "
    "r } = ic;\n        if (origin == want)\n        {\n            if (Some(resp) = exchange_on(c, r, true,"
    " &bytes, u, method)?)\n            {\n                return Ok(resp);\n            }\n            // Cl"
    "osed with nothing answered: the server may still have\n            // acted on the request, so only a"
    "n idempotent one is sent\n            // again (RFC 9110 §9.2.2) -- a POST twice could do twice what"
    "\n            // it asks.\n            if (!idempotent(method))\n            {\n                return E"
    "rr(ConnectionClosed);\n            }\n        }\n        else\n        {\n            conn_close(&mut r.c"
    "onn);\n        }\n    }\n    Reader fresh = Reader { .conn = open_connection(c, u)?, .buf = Vec::new(),"
    " .at = 0, .deadline_ns = 0 };\n    match (exchange_on(c, fresh, false, &bytes, u, method)?)\n    {\n   "
    "     Some(resp) : Ok(resp),\n        None       : Err(ConnectionClosed),\n    }\n}fn exchange_on(\n    r"
    "ef<HttpClient, exclusive> c,\n    Reader r,\n    bool reused,\n    slice<u8, shared> bytes,\n    ref<Url"
    ", shared> u,\n    StringView method,\n) : Result<Option<Response>, HttpError>\n{\n    match (conn_write("
    "&mut r.conn, bytes))\n    {\n        Ok(_)  : {},\n        Err(e) :\n        {\n            if (reused)\n "
    "           {\n                return Ok(None);\n            }\n            return Err(e);\n        },\n  "
    "  }\n    bool first = true;\n    // Interim 1xx responses (a 100 Continue) are read past, up to\n    //"
    " MAX_INTERIM of them: a server sending them without end would hold\n    // the request for ever, each"
    " one arriving within the read timeout.\n    usize interim = 0;\n    while (true)\n    {\n        String "
    "line = match (http_line(&mut r, MAX_HEAD))\n        {\n            Ok(Some(l)) : l,\n            Ok(Non"
    "e)    :\n            {\n                if (reused && first)\n                {\n                    ret"
    "urn Ok(None);\n                }\n                return Err(ConnectionClosed);\n            },\n       "
    "     Err(e)      :\n            {\n                if (reused && first && Vec::len(&r.buf) == 0)\n     "
    "           {\n                    return Ok(None);\n                }\n                return Err(e);\n "
    "           },\n        };\n        first = false;\n        bool http11 = StringView::starts_with(&line,"
    " \"HTTP/1.1\");\n        StatusLine { status, reason } = parse_status_line(&line)?;\n        Vec<Header>"
    " headers = read_headers(&mut r, StringView::len(&line) + 2)?;\n        if (status >= 100 && status < "
    "200)\n        {\n            interim += 1;\n            if (interim > MAX_INTERIM)\n            {\n      "
    "          return Err(BadMessage);\n            }\n            continue;\n        }\n        // RFC 9112 "
    "§6.1: an HTTP/1.0 message with `Transfer-Encoding` has\n        // faulty framing.\n        if (!http"
    "11 && count_header(&headers, \"transfer-encoding\") > 0)\n        {\n            return Err(BadMessage);"
    "\n        }\n        bool no_body = (method == \"HEAD\") || status == 204 || status == 304;\n        Body"
    "Length how = if (no_body) { NoBody } else { body_length(&headers, true)? };\n        bool until_close"
    " = match (how)\n        {\n            UntilClose : true,\n            _          : false,\n        };\n "
    "       Vec<u8> data = read_body(&mut r, how, c.max_body)?;\n        // Kept when asked for, allowed ("
    "HTTP/1.1, no `Connection: close`),\n        // the body's end known without the connection's, and not"
    "hing more\n        // read than the response.\n        bool keep = c.keep_alive && http11 && !until_cl"
    "ose && r.at == Vec::len(&r.buf) && !connection_has(&headers, \"close\");\n        if (keep)\n        {\n "
    "           c.idle = Some(IdleConn { .origin = String::clone(&origin_of(u)), .r = r });\n        }\n   "
    "     else\n        {\n            conn_close(&mut r.conn);\n        }\n        // D-0183: a body sent co"
    "mpressed (`Content-Encoding: gzip` or\n        // `deflate`, which the client offers) arrives decoded"
    ", within\n        // `max_body`, and the header is dropped so the response reads as\n        // a plai"
    "n one.\n        bool strip = false;\n        if (!no_body)\n        {\n            if (Some(enc) = find_"
    "header(&headers, \"content-encoding\"))\n            {\n                StringView e = StringView::trim("
    "enc);\n                Option<Result<Vec<u8>, CompressError>> decoded = if (name_eq(e, \"gzip\") || nam"
    "e_eq(e, \"x-gzip\"))\n                {\n                    Some(gunzip(&data, c.max_body))\n           "
    "     }\n                else if (name_eq(e, \"deflate\"))\n                {\n                    Some(ma"
    "tch (zlib_inflate(&data, c.max_body))\n                    {\n                        Ok(v)  : Ok(v),\n"
    "                        Err(_) : inflate(&data, c.max_body),\n                    })\n                "
    "}\n                else { None };\n                if (Some(d) = decoded)\n                {\n          "
    "          overwrite(&mut data, match (d)\n                    {\n                        Ok(v)        "
    " : v,\n                        Err(Oversize) : return Err(TooLarge),\n                        Err(_)  "
    "      : return Err(BadMessage),\n                    });\n                    strip = true;\n          "
    "      }\n            }\n        }\n        if (strip)\n        {\n            Vec::retain(&mut headers, n"
    "ot_content_encoding);\n        }\n        return Ok(Some(Response { .status = status, .reason = reason"
    ", .headers = headers, .body = data }));\n    }\n}fn has_scheme(StringView t) : bool\n{\n    slice<u8, sh"
    "ared> b = StringView::as_bytes(t);\n    if (slice_len(b) == 0 || !ascii_is_alpha(b[0]))\n    {\n       "
    " return false;\n    }\n    for (usize i = 1; i < slice_len(b); i += 1)\n    {\n        u8 c = b[i];\n    "
    "    if (c == b':')\n        {\n            return true;\n        }\n        if (!ascii_is_alnum(c) && c "
    "!= b'+' && c != b'-' && c != b'.')\n        {\n            return false;\n        }\n    }\n    false\n}fn"
    " remove_dot_segments(StringView path) : String\n{\n    Vec<StringView> out = Vec::new();\n    Vec<Strin"
    "gView> segs = StringView::split(&path[1..$], \"/\");\n    usize n = Vec::len(&segs);\n    for (usize i ="
    " 0; i < n; i += 1)\n    {\n        StringView s = segs[i];\n        bool last = i + 1 == n;\n        if "
    "(s == \".\")\n        {\n            if (last)\n            {\n                Vec::push(&mut out, \"\");\n  "
    "          }\n        }\n        else if (s == \"..\")\n        {\n            _ = Vec::pop(&mut out);\n    "
    "        if (last)\n            {\n                Vec::push(&mut out, \"\");\n            }\n        }\n   "
    "     else\n        {\n            Vec::push(&mut out, s);\n        }\n    }\n    String r = String::new()"
    ";\n    foreach (s in &out)\n    {\n        String::push_ascii(&mut r, b'/');\n        String::append(&mu"
    "t r, *s);\n    }\n    if (StringView::len(&r) == 0)\n    {\n        String::push_ascii(&mut r, b'/');\n  "
    "  }\n    r\n}fn redirect_target(ref<Url, shared> base, StringView location) : Result<Url, HttpError>\n{"
    "\n    StringView loc = location;\n    if (Some(h) = StringView::find(loc, \"#\"))\n    {\n        loc = &l"
    "oc[0..h];\n    }\n    if (has_scheme(loc))\n    {\n        return Url::parse(loc);\n    }\n    String text"
    " = String::clone(&base.scheme);\n    String::append(&mut text, \":\");\n    if (StringView::starts_with("
    "loc, \"//\"))\n    {\n        String::append(&mut text, loc);\n        return Url::parse(&text);\n    }\n  "
    "  String::append(&mut text, \"//\");\n    String::append(&mut text, &host_text(base));\n    StringView r"
    "el_path = loc;\n    Option<StringView> rel_query = None;\n    if (Some(q) = StringView::find(loc, \"?\")"
    ")\n    {\n        rel_path = &loc[0..q];\n        rel_query = Some(&loc[q + 1..$]);\n    }\n    if (Strin"
    "gView::len(rel_path) == 0)\n    {\n        String::append(&mut text, &base.path);\n        match (rel_q"
    "uery)\n        {\n            Some(q) :\n            {\n                String::append(&mut text, \"?\");\n"
    "                String::append(&mut text, q);\n            },\n            None    :\n            {\n   "
    "             if (StringView::len(&base.query) > 0)\n                {\n                    String::app"
    "end(&mut text, \"?\");\n                    String::append(&mut text, &base.query);\n                }\n "
    "           },\n        }\n        return Url::parse(&text);\n    }\n    String merged = String::new();\n "
    "   if (StringView::starts_with(rel_path, \"/\"))\n    {\n        String::append(&mut merged, rel_path);\n"
    "    }\n    else\n    {\n        StringView path = &base.path;\n        usize dir = 0;\n        slice<u8, "
    "shared> pb = StringView::as_bytes(path);\n        for (usize i = 0; i < slice_len(pb); i += 1)\n      "
    "  {\n            if (pb[i] == b'/')\n            {\n                dir = i + 1;\n            }\n        "
    "}\n        String::append(&mut merged, &path[0..dir]);\n        String::append(&mut merged, rel_path);"
    "\n    }\n    String::append(&mut text, &remove_dot_segments(&merged));\n    if (Some(q) = rel_query)\n  "
    "  {\n        String::append(&mut text, \"?\");\n        String::append(&mut text, q);\n    }\n    Url::par"
    "se(&text)\n}unittest \"redirect_target: reference resolution\"\n{\n    Url base = Result::unwrap(Url::par"
    "se(\"http://a/b/c/d;p?q\"));\n    assert(Url::text(&Result::unwrap(redirect_target(&base, \"g\"))) == \"ht"
    "tp://a/b/c/g\");\n    assert(Url::text(&Result::unwrap(redirect_target(&base, \"./g/\"))) == \"http://a/b"
    "/c/g/\");\n    assert(Url::text(&Result::unwrap(redirect_target(&base, \"/g\"))) == \"http://a/g\");\n    a"
    "ssert(Url::text(&Result::unwrap(redirect_target(&base, \"//g\"))) == \"http://g/\");\n    assert(Url::tex"
    "t(&Result::unwrap(redirect_target(&base, \"?y\"))) == \"http://a/b/c/d;p?y\");\n    assert(Url::text(&Res"
    "ult::unwrap(redirect_target(&base, \"g?y\"))) == \"http://a/b/c/g?y\");\n    assert(Url::text(&Result::un"
    "wrap(redirect_target(&base, \"#s\"))) == \"http://a/b/c/d;p?q\");\n    assert(Url::text(&Result::unwrap(r"
    "edirect_target(&base, \"..\"))) == \"http://a/b/\");\n    assert(Url::text(&Result::unwrap(redirect_targe"
    "t(&base, \"../../../g\"))) == \"http://a/g\");\n    assert(Url::text(&Result::unwrap(redirect_target(&bas"
    "e, \"/./g/..\"))) == \"http://a/\");\n    assert(Url::text(&Result::unwrap(redirect_target(&base, \"/login"
    "?next=http://e.com/\"))) == \"http://a/login?next=http://e.com/\");\n    assert(Url::text(&Result::unwra"
    "p(redirect_target(&base, \"https://x:8443/y\"))) == \"https://x:8443/y\");\n}export fn HttpClient::send(r"
    "ef<HttpClient, exclusive> c, ref<Request, shared> req) : Result<Response, HttpError>\n{\n    Url u = U"
    "rl::parse(&req.url)?;\n    String method = String::clone(&req.method);\n    Vec<u8> body = Vec::clone("
    "&req.body);\n    usize hops = 0;\n    bool with_content = true;\n    String first_origin = origin_of(&u"
    ");\n    bool credentials = true;\n    while (true)\n    {\n        Response resp = exchange(c, req, &u, "
    "&method, &body, with_content, credentials)?;\n        bool redirect = resp.status == 301 || resp.stat"
    "us == 302 || resp.status == 303 || resp.status == 307 || resp.status == 308;\n        if (!redirect)\n"
    "        {\n            return Ok(resp);\n        }\n        // Report 310: a limit of 0 follows none, a"
    "nd the redirect is the\n        // answer (a login's 302 and its cookie, a link checker's Location).\n"
    "        if (c.max_redirects == 0)\n        {\n            return Ok(resp);\n        }\n        StringVie"
    "w location = match (Response::header(&resp, \"location\"))\n        {\n            Some(l) : l,\n        "
    "    None    : return Ok(resp),\n        };\n        if (hops == c.max_redirects)\n        {\n           "
    " return Err(TooManyRedirects);\n        }\n        hops += 1;\n        Url next = redirect_target(&u, l"
    "ocation)?;\n        overwrite(&mut u, next);\n        // Once a redirect leaves the first origin, cred"
    "entials stay behind,\n        // even if a later one comes back.\n        if (origin_of(&u) != first_o"
    "rigin)\n        {\n            credentials = false;\n        }\n        if (resp.status != 307 && resp.s"
    "tatus != 308 && method != \"HEAD\")\n        {\n            overwrite(&mut method, \"GET\");\n            V"
    "ec::clear(&mut body);\n            with_content = false;\n        }\n    }\n}export fn http_get(StringVi"
    "ew url) : Result<Response, HttpError>\n{\n    HttpClient c = HttpClient::new();\n    Request req = Requ"
    "est::new(\"GET\", url);\n    HttpClient::send(&mut c, &req)\n}export fn http_post(StringView url, String"
    "View content_type, slice<u8, shared> body) : Result<Response, HttpError>\n{\n    HttpClient c = HttpCl"
    "ient::new();\n    Request req = Request::new(\"POST\", url);\n    Vec::push(&mut req.headers, Header::ne"
    "w(\"Content-Type\", content_type));\n    Vec::extend_from(&mut req.body, body);\n    HttpClient::send(&m"
    "ut c, &req)\n}export fn HttpServer::bind(SocketAddr a) : Result<HttpServer, NetError>\n{\n    TcpListen"
    "er l = TcpListener::bind(a)?;\n    Ok(HttpServer { .listener = l, .max_body = 16777216, .timeout_ms ="
    " 30000, .key = None, .chain = Vec::new() })\n}export fn HttpServer::bind_tls(SocketAddr a, PrivateKey"
    " key, Vec<Certificate> chain) : Result<HttpServer, NetError>\n{\n    TcpListener l = TcpListener::bind"
    "(a)?;\n    Ok(HttpServer { .listener = l, .max_body = 16777216, .timeout_ms = 30000, .key = Some(key)"
    ", .chain = chain })\n}export fn HttpServer::local_addr(ref<HttpServer, shared> s) : SocketAddr\n{\n    "
    "TcpListener::local_addr(&s.listener)\n}export fn HttpServer::accept(ref<HttpServer, exclusive> s) : R"
    "esult<HttpConnection, HttpError>\n{\n    TcpStream tcp = match (TcpListener::accept(&mut s.listener))\n"
    "    {\n        Ok(t)  : t,\n        Err(e) : return Err(HttpNetFailure(e)),\n    };\n    TcpStream::set_"
    "read_timeout_ms(&mut tcp, s.timeout_ms);\n    TcpStream::set_write_timeout_ms(&mut tcp, s.timeout_ms)"
    ";\n    TcpStream::set_nodelay(&mut tcp, true);\n    SocketAddr peer = TcpStream::peer_addr(&tcp);\n    "
    "Option<PendingTls> tls = match (&s.key)\n    {\n        Some(k) : Some(PendingTls { .key = PrivateKey:"
    ":clone(k), .chain = Vec::clone(&s.chain) }),\n        None    : None,\n    };\n    Ok(HttpConnection { "
    ".reader = Reader { .conn = Plain(tcp), .buf = Vec::new(), .at = 0, .deadline_ns = 0 }, .max_body = s"
    ".max_body, .keep_alive = true, .head_request = false, .pending = false, .failed = false, .timeout_ms"
    " = s.timeout_ms, .closed = false, .tls = tls, .peer = peer })\n}export fn HttpConnection::peer_addr(r"
    "ef<HttpConnection, shared> c) : SocketAddr\n{\n    c.peer\n}fn HttpConnection::handshake(ref<HttpConnec"
    "tion, exclusive> c) : Result<void, HttpError>\n{\n    PendingTls p = match (replace(&mut c.tls, None))"
    "\n    {\n        Some(p) : p,\n        None    : return Ok(()),\n    };\n    match (replace(&mut c.reader"
    ".conn, Gone))\n    {\n        Plain(tcp) : match (TlsStream::server(tcp, &p.key, &p.chain))\n        {\n"
    "            Ok(t)  : overwrite(&mut c.reader.conn, Secure(t)),\n            Err(e) :\n            {\n  "
    "              c.keep_alive = false;\n                c.closed = true;\n                return Err(Http"
    "TlsFailure(e));\n            },\n        },\n        other : overwrite(&mut c.reader.conn, other),\n    "
    "}\n    Ok(())\n}fn HttpConnection::next_arrives(ref<HttpConnection, exclusive> c) : Result<bool, HttpE"
    "rror>\n{\n    if (available(&c.reader) > 0)\n    {\n        return Ok(true);\n    }\n    match (fill_buffe"
    "r(&mut c.reader))\n    {\n        Ok(more)                                     : Ok(more),\n        Err"
    "(HttpNetFailure(TimedOut))                : Ok(false),\n        Err(HttpTlsFailure(TlsNetFailure(Time"
    "dOut))) : Ok(false),\n        Err(e)                                       :\n        {\n            c."
    "keep_alive = false;\n            Err(e)\n        },\n    }\n}export fn HttpConnection::request(ref<HttpC"
    "onnection, exclusive> c) : Result<Option<Request>, HttpError>\n{\n    c.failed = false;\n    Result<Opt"
    "ion<Request>, HttpError> r = HttpConnection::read_request(c);\n    c.reader.deadline_ns = 0;\n    if ("
    "Result::is_err(&r))\n    {\n        c.failed = true;\n    }\n    r\n}fn request_line(ref<Reader, exclusiv"
    "e> r) : Result<Option<String>, HttpError>\n{\n    match (http_line(r, MAX_HEAD)?)\n    {\n        Some(l"
    ") :\n        {\n            if (StringView::len(&l) > 0)\n            {\n                return Ok(Some("
    "l));\n            }\n        },\n        None    : return Ok(None),\n    }\n    http_line(r, MAX_HEAD)\n}f"
    "n HttpConnection::read_request(ref<HttpConnection, exclusive> c) : Result<Option<Request>, HttpError"
    ">\n{\n    if (c.closed || !c.keep_alive)\n    {\n        return Ok(None);\n    }\n    // Report 424: a req"
    "uest read, or one that failed, waits for one\n    // response (a 400 for a malformed one).\n    c.pend"
    "ing = true;\n    HttpConnection::handshake(c)?;\n    // Report 298: the timeout passing before any byt"
    "e of a request has\n    // come is the end of an idle connection, not a bad request: `None`,\n    // a"
    "nd the connection closes (as the client closing it would).\n    if (!HttpConnection::next_arrives(c)?"
    ")\n    {\n        c.keep_alive = false;\n        return Ok(None);\n    }\n    // Report 432: the whole he"
    "ad, from its first byte, arrives within the\n    // server's timeout (a client sending a byte just in"
    "side each read's\n    // timeout held the connection for as long as it liked).\n    if (c.timeout_ms >"
    " 0 && c.timeout_ms < 1000000000000)\n    {\n        c.reader.deadline_ns = monotonic_ns() + c.timeout_"
    "ms * 1000000;\n    }\n    // After an Err the connection closes ([Http-Request]): a request line\n    /"
    "/ over the limit included. Report 430 (RFC 9112 §2.2): one empty line\n    // before the request lin"
    "e (a client's CRLF after a POST body) is\n    // ignored.\n    String line = match (request_line(&mut "
    "c.reader))\n    {\n        Ok(Some(l)) : l,\n        Ok(None)    : return Ok(None),\n        Err(e)     "
    " :\n        {\n            c.keep_alive = false;\n            return Err(e);\n        },\n    };\n    // A"
    " request line: METHOD SP target SP HTTP/1.x.\n    Vec<StringView> parts = StringView::split(&line, \" "
    "\");\n    if (Vec::len(&parts) != 3 || StringView::len(parts[0]) == 0 || StringView::len(parts[1]) == "
    "0)\n    {\n        c.keep_alive = false;\n        return Err(BadMessage);\n    }\n    bool v11 = (parts[2"
    "] == \"HTTP/1.1\");\n    // RFC 9112 §3.1: the method is a token (no control byte for a log or a\n    /"
    "/ proxy to read otherwise).\n    if ((!v11 && parts[2] != \"HTTP/1.0\") || !is_token(parts[0]))\n    {\n "
    "       c.keep_alive = false;\n        return Err(BadMessage);\n    }\n    // RFC 9112 §3.2: the target"
    " holds no space, control byte or DEL (a NUL\n    // in it was taken as part of the path).\n    foreach"
    " (b in StringView::as_bytes(parts[1]))\n    {\n        if (*b <= 32 || *b == 127)\n        {\n          "
    "  c.keep_alive = false;\n            return Err(BadMessage);\n        }\n    }\n    Vec<Header> headers "
    "= match (read_headers(&mut c.reader, StringView::len(&line) + 2))\n    {\n        Ok(h)  : h,\n        "
    "Err(e) :\n        {\n            c.keep_alive = false;\n            return Err(e);\n        },\n    };\n  "
    "  // The head is in: the body's reads have each the read timeout.\n    c.reader.deadline_ns = 0;\n    "
    "// RFC 9112 §3.2: an HTTP/1.1 request has exactly one `Host`, and no\n    // request has two.\n    us"
    "ize hosts = count_header(&headers, \"host\");\n    if ((v11 && hosts == 0) || hosts > 1)\n    {\n        "
    "c.keep_alive = false;\n        return Err(BadMessage);\n    }\n    // ... and a `Host` with an invalid "
    "value is refused too: it is\n    // `uri-host [\":\" port]`, or empty (RFC 9112 §3.2, RFC 3986 §3.2.2"
    ").\n    if (Some(h) = find_header(&headers, \"host\"))\n    {\n        if (!host_field_ok(h))\n        {\n "
    "           c.keep_alive = false;\n            return Err(BadMessage);\n        }\n    }\n    // RFC 9112"
    " §6.1: an HTTP/1.0 message with `Transfer-Encoding` has\n    // faulty framing (a front end may igno"
    "re the field and see another\n    // request in the body).\n    if (!v11 && count_header(&headers, \"tr"
    "ansfer-encoding\") > 0)\n    {\n        c.keep_alive = false;\n        return Err(BadMessage);\n    }\n   "
    " // Keep-alive: HTTP/1.1 unless `close` is among the `Connection`\n    // options, HTTP/1.0 only with"
    " `keep-alive` among them (and no `close`).\n    c.keep_alive = !connection_has(&headers, \"close\") && "
    "(v11 || connection_has(&headers, \"keep-alive\"));\n    c.head_request = (parts[0] == \"HEAD\");\n    Body"
    "Length how = match (body_length(&headers, false))\n    {\n        Ok(h)  : h,\n        Err(e) :\n       "
    " {\n            c.keep_alive = false;\n            return Err(e);\n        },\n    };\n    // RFC 9110 §"
    "10.1.1: `100 Continue` only to HTTP/1.1 (an HTTP/1.0\n    // client's expectation is ignored, §15.2)"
    ", and not when the declared\n    // length is already over the limit: the request is then TooLarge at"
    "\n    // once, before the client sends the body.\n    bool too_long = match (how)\n    {\n        Length"
    "(n) : n > c.max_body,\n        _         : false,\n    };\n    if (Some(expect) = find_header(&headers,"
    " \"expect\"))\n    {\n        if (v11 && !too_long && name_eq(StringView::trim(expect), \"100-continue\"))"
    "\n        {\n            if (Err(e) = conn_write(&mut c.reader.conn, b\"HTTP/1.1 100 Continue\\r\\n\\r\\n\")"
    ")\n            {\n                c.keep_alive = false;\n                return Err(e);\n            }\n "
    "       }\n    }\n    Vec<u8> body = match (read_body(&mut c.reader, how, c.max_body))\n    {\n        Ok"
    "(b)  : b,\n        Err(e) :\n        {\n            c.keep_alive = false;\n            return Err(e);\n  "
    "      },\n    };\n    Ok(Some(Request { .method = String::copy(parts[0]), .url = String::copy(parts[1]"
    "), .headers = headers, .body = body }))\n}export fn HttpConnection::respond(\n    ref<HttpConnection, "
    "exclusive> c,\n    u16 status,\n    slice<Header, shared> headers,\n    slice<u8, shared> body,\n) : Res"
    "ult<void, HttpError>\n{\n    // Report 424: one response per request; a second would be read as the\n  "
    "  // answer to the next request on a kept-alive connection.\n    if (status < 100 || status > 599 || "
    "!c.pending)\n    {\n        return Err(BadMessage);\n    }\n    HttpConnection::handshake(c)?;\n    Strin"
    "g head = \"HTTP/1.1 \";\n    String::append(&mut head, status);\n    String::append(&mut head, \" \");\n   "
    " String::append(&mut head, reason_phrase(status));\n    String::append(&mut head, \"\\r\\n\");\n    bool d"
    "ated = false;\n    for (usize i = 0; i < slice_len(headers); i += 1)\n    {\n        StringView name = "
    "&headers[i].name;\n        if (name_eq(name, \"content-length\") || name_eq(name, \"connection\") || name"
    "_eq(name, \"transfer-encoding\"))\n        {\n            continue;\n        }\n        if (name_eq(name, "
    "\"date\"))\n        {\n            dated = true;\n        }\n        write_field(&mut head, &headers[i])?;"
    "\n    }\n    // Report 436 (RFC 9110 §6.6.1): an origin server with a clock sends the\n    // `Date` i"
    "t generated the response at, unless the handler gave one.\n    if (!dated)\n    {\n        String::appe"
    "nd(&mut head, \"Date: \");\n        String::append(&mut head, &DateTime::to_http_date(&DateTime::now())"
    ");\n        String::append(&mut head, \"\\r\\n\");\n    }\n    bool no_body = status == 204 || status == 30"
    "4 || (status >= 100 && status < 200);\n    if (!no_body)\n    {\n        String::append(&mut head, \"Con"
    "tent-Length: \");\n        String::append(&mut head, slice_len(body));\n        String::append(&mut hea"
    "d, \"\\r\\n\");\n    }\n    String::append(\n        &mut head,\n        if (c.keep_alive) { \"Connection: ke"
    "ep-alive\\r\\n\\r\\n\" } else { \"Connection: close\\r\\n\\r\\n\" },\n    );\n    Vec<u8> out = String::into_byte"
    "s(head);\n    if (!no_body && !c.head_request)\n    {\n        Vec::extend_from(&mut out, body);\n    }\n"
    "    c.pending = false;\n    conn_write(&mut c.reader.conn, &out)?;\n    if (!c.keep_alive)\n    {\n     "
    "   conn_close(&mut c.reader.conn);\n        // Report 431 (RFC 9112 §9.6): after a failed request (a"
    " 413 before\n        // a large body) what the client still sends is read and dropped, up\n        // "
    "to `DRAIN_MAX` bytes, so that closing does not reset the\n        // connection and lose the response"
    " before the client reads it.\n        if (c.failed)\n        {\n            drain_input(&mut c.reader, "
    "DRAIN_MAX);\n        }\n        c.closed = true;\n    }\n    Ok(())\n}export fn HttpConnection::close(ref"
    "<HttpConnection, exclusive> c)\n{\n    if (!c.closed)\n    {\n        conn_close(&mut c.reader.conn);\n  "
    "      c.closed = true;\n    }\n}export fn scram_salted_password(StringView password, slice<u8, shared>"
    " salt, usize iterations) : Vec<u8>\n{\n    pbkdf2(Sha2_256, StringView::as_bytes(password), salt, iter"
    "ations, 32)\n}export fn Scram::start(StringView user, StringView client_nonce) : Scram\n{\n    String b"
    "are = \"n=\";\n    foreach (c in StringView::as_bytes(user))\n    {\n        if (*c == b',')\n        {\n  "
    "          String::append(&mut bare, \"=2C\");\n        }\n        else if (*c == b'=')\n        {\n       "
    "     String::append(&mut bare, \"=3D\");\n        }\n        else\n        {\n            String::push_asc"
    "ii(&mut bare, *c);\n        }\n    }\n    String::append(&mut bare, \",r=\");\n    String::append(&mut bar"
    "e, client_nonce);\n    Scram { .client_nonce = String::copy(client_nonce), .client_first_bare = bare,"
    " .server_signature = Vec::new() }\n}export fn Scram::client_first(ref<Scram, shared> s) : String\n{\n  "
    "  String m = \"n,,\";\n    String::append(&mut m, &s.client_first_bare);\n    m\n}fn attribute(slice<Stri"
    "ngView, shared> parts, str name) : Option<StringView>\n{\n    foreach (p in parts)\n    {\n        if (S"
    "tringView::starts_with(*p, StringView::of(name)))\n        {\n            return Some(&(*p)[2..$]);\n  "
    "      }\n    }\n    None\n}export fn Scram::respond(\n    ref<Scram, exclusive> s,\n    StringView server"
    "_first,\n    StringView password,\n) : Result<String, PgError>\n{\n    Vec<StringView> parts = StringVie"
    "w::split(server_first, \",\");\n    if (Option::is_some(&attribute(&parts, \"m=\")))\n    {\n        return"
    " Err(ProtocolViolation);\n    }\n    StringView nonce = Option::ok_or(attribute(&parts, \"r=\"), Protoco"
    "lViolation)?;\n    StringView salt_text = Option::ok_or(attribute(&parts, \"s=\"), ProtocolViolation)?;"
    "\n    StringView iter_text = Option::ok_or(attribute(&parts, \"i=\"), ProtocolViolation)?;\n    if (!Str"
    "ingView::starts_with(\n        nonce,\n        &s.client_nonce,\n    ) || StringView::len(nonce) <= Str"
    "ingView::len(&s.client_nonce))\n    {\n        return Err(AuthFailed);\n    }\n    Vec<u8> salt = match "
    "(base64_decode(salt_text))\n    {\n        Ok(v)  : v,\n        Err(_) : return Err(ProtocolViolation),"
    "\n    };\n    usize iterations = match (StringView::parse<usize>(iter_text))\n    {\n        Ok(n)  : n,"
    "\n        Err(_) : return Err(ProtocolViolation),\n    };\n    if (iterations == 0)\n    {\n        retur"
    "n Err(ProtocolViolation);\n    }\n    Vec<u8> salted = scram_salted_password(password, &salt, iteratio"
    "ns);\n    array<u8, 32> client_key = hmac_sha256(&salted, b\"Client Key\");\n    array<u8, 32> stored_ke"
    "y = sha256(&client_key);\n    String without_proof = \"c=biws,r=\";\n    String::append(&mut without_pro"
    "of, nonce);\n    String auth = String::clone(&s.client_first_bare);\n    String::append(&mut auth, \",\""
    ");\n    String::append(&mut auth, server_first);\n    String::append(&mut auth, \",\");\n    String::appe"
    "nd(&mut auth, &without_proof);\n    array<u8, 32> client_signature = hmac_sha256(&stored_key, StringV"
    "iew::as_bytes(&auth));\n    Vec<u8> proof = Vec::new();\n    for (usize i = 0; i < 32; i += 1)\n    {\n "
    "       Vec::push(&mut proof, client_key[i] ^ client_signature[i]);\n    }\n    array<u8, 32> server_ke"
    "y = hmac_sha256(&salted, b\"Server Key\");\n    array<u8, 32> server_signature = hmac_sha256(&server_ke"
    "y, StringView::as_bytes(&auth));\n    overwrite(&mut s.server_signature, Vec::from_slice(&server_sign"
    "ature));\n    String::append(&mut without_proof, \",p=\");\n    String::append(&mut without_proof, &base"
    "64_encode(&proof));\n    Ok(without_proof)\n}export fn Scram::verify(ref<Scram, shared> s, StringView "
    "server_final) : bool\n{\n    if (Vec::len(&s.server_signature) == 0 || !StringView::starts_with(server"
    "_final, \"v=\"))\n    {\n        return false;\n    }\n    match (base64_decode(&server_final[2..$]))\n    "
    "{\n        Ok(v)  : digest_eq(&v, &s.server_signature),\n        Err(_) : false,\n    }\n}unittest \"Scra"
    "m: a whole exchange\"\n{\n    Scram s = Scram::start(\"user\", \"rOprNGfwEbeRWgbNEkqO\");\n    assert(Scram:"
    ":client_first(&s) == \"n,,n=user,r=rOprNGfwEbeRWgbNEkqO\");\n    String first = \"r=rOprNGfwEbeRWgbNEkqO"
    "%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,\";\n    String::append(&mut first, \"s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4\");\n"
    "    String reply = Result::unwrap(Scram::respond(&mut s, &first, \"pencil\"));\n    assert(StringView::"
    "ends_with(&reply, \",p=0ByS2g6XZEtov8MR140MFRsEfy8/X+bacfpPofVtKjE=\"));\n    assert(Scram::verify(&s, "
    "\"v=ITrN4zX09+hsD398Qk6ol73eg0shWPnOWwnwS83jitc=\"));\n    assert(!Scram::verify(&s, \"e=invalid-proof\")"
    ");\n}fn sasl_hex(StringView t) : u32\n{\n    u32 v = 0;\n    foreach (c in StringView::as_bytes(t))\n    "
    "{\n        u32 d = if (*c >= b'a') { widen<u32>(*c - b'a') + 10 } else { widen<u32>(*c - b'0') };\n   "
    "     v = v * 16 + d;\n    }\n    v\n}fn sasl_in(str table, u32 cp) : bool\n{\n    foreach (e in StringVie"
    "w::split(StringView::of(table), \";\"))\n    {\n        if (StringView::len(e) == 0)\n        {\n         "
    "   continue;\n        }\n        match (StringView::find(e, \"-\"))\n        {\n            Some(d) :\n    "
    "        {\n                if (cp >= sasl_hex(&e[0..d]) && cp <= sasl_hex(&e[d + 1..$]))\n            "
    "    {\n                    return true;\n                }\n            },\n            None    : if (cp"
    " == sasl_hex(e)) { return true; },\n        }\n    }\n    false\n}fn sasl_map(str table) : HashMap<u64, "
    "Vec<u32>>\n{\n    HashMap<u64, Vec<u32>> m = HashMap::new();\n    foreach (e in StringView::split(Strin"
    "gView::of(table), \";\"))\n    {\n        usize eq = match (StringView::find(e, \"=\"))\n        {\n        "
    "    Some(i) : i,\n            None    : continue,\n        };\n        u64 key = 0;\n        foreach (k "
    "in StringView::split(&e[0..eq], \",\"))\n        {\n            key = (key << 21) | widen<u64>(sasl_hex("
    "k));\n        }\n        Vec<u32> v = Vec::new();\n        foreach (x in StringView::split(&e[eq + 1..$"
    "], \",\"))\n        {\n            Vec::push(&mut v, sasl_hex(x));\n        }\n        _ = HashMap::insert"
    "(&mut m, key, v);\n    }\n    m\n}fn sasl_nfkc(ref<Vec<u32>, shared> input) : Vec<u32>\n{\n    HashMap<u6"
    "4, Vec<u32>> nfkd = sasl_map(SASLPREP_NFKD);\n    HashMap<u64, Vec<u32>> ccc = sasl_map(SASLPREP_CCC)"
    ";\n    HashMap<u64, Vec<u32>> compose = sasl_map(SASLPREP_COMPOSE);\n    Vec<u32> d = Vec::new();\n    "
    "foreach (c in input)\n    {\n        u32 cp = *c;\n        if (cp >= HANGUL_S && cp < HANGUL_S + HANGUL"
    "_COUNT)\n        {\n            u32 s = cp - HANGUL_S;\n            Vec::push(&mut d, HANGUL_L + s / 58"
    "8);\n            Vec::push(&mut d, HANGUL_V + (s % 588) / 28);\n            if (s % 28 != 0)\n         "
    "   {\n                Vec::push(&mut d, HANGUL_T + s % 28);\n            }\n        }\n        else\n    "
    "    {\n            match (HashMap::get(&nfkd, widen<u64>(cp)))\n            {\n                Some(m) "
    ": Vec::extend_from(&mut d, m),\n                None    : Vec::push(&mut d, cp),\n            }\n      "
    "  }\n    }\n    // Each combining mark after the starter before it, by class (stable).\n    usize n = V"
    "ec::len(&d);\n    Vec<u32> class = Vec::new();\n    foreach (c in &d)\n    {\n        u32 k = match (Has"
    "hMap::get(&ccc, widen<u64>(*c)))\n        {\n            Some(v) : v[0],\n            None    : 0,\n    "
    "    };\n        Vec::push(&mut class, k);\n    }\n    for (usize i = 1; i < n; i += 1)\n    {\n        us"
    "ize j = i;\n        while (j > 0 && class[j] != 0 && class[j - 1] > class[j])\n        {\n            V"
    "ec::swap(&mut d, j - 1, j);\n            Vec::swap(&mut class, j - 1, j);\n            j -= 1;\n       "
    " }\n    }\n    if (n == 0)\n    {\n        return d;\n    }\n    Vec<u32> out = Vec::new();\n    Vec::push("
    "&mut out, d[0]);\n    usize starter = 0;\n    u32 last = if (class[0] == 0) { 0 } else { 256 };\n    fo"
    "r (usize i = 1; i < n; i += 1)\n    {\n        u32 c = d[i];\n        u32 cc = class[i];\n        u32 s "
    "= out[starter];\n        Option<u32> composite = None;\n        if (s >= HANGUL_L && s < HANGUL_L + 19"
    " && c >= HANGUL_V && c < HANGUL_V + 21)\n        {\n            composite = Some(HANGUL_S + ((s - HANG"
    "UL_L) * 21 + (c - HANGUL_V)) * 28);\n        }\n        else if (s >= HANGUL_S && s < HANGUL_S + HANGU"
    "L_COUNT && (s - HANGUL_S) % 28 == 0 && c > HANGUL_T && c < HANGUL_T + 28)\n        {\n            comp"
    "osite = Some(s + (c - HANGUL_T));\n        }\n        else if (Some(m) = HashMap::get(&compose, (widen"
    "<u64>(s) << 21) | widen<u64>(c)))\n        {\n            composite = Some(m[0]);\n        }\n        //"
    " Composed unless a mark of the same or a higher class, or a\n        // starter, stands between (bloc"
    "ked).\n        if (Some(k) = composite)\n        {\n            if (last < cc || last == 0)\n           "
    " {\n                out[starter] = k;\n                continue;\n            }\n        }\n        if (c"
    "c == 0)\n        {\n            starter = Vec::len(&out);\n        }\n        last = cc;\n        Vec::pu"
    "sh(&mut out, c);\n    }\n    out\n}export fn saslprep(StringView text) : Option<String>\n{\n    bool asci"
    "i = true;\n    foreach (b in StringView::as_bytes(text))\n    {\n        if (*b >= 0x80)\n        {\n    "
    "        ascii = false;\n        }\n    }\n    if (ascii)\n    {\n        return Some(String::copy(text));"
    "\n    }\n    // C.1.2 before B.1: U+200B is in both, and PostgreSQL makes it a space.\n    Vec<u32> map"
    "ped = Vec::new();\n    foreach (ch in StringView::chars(text))\n    {\n        u32 cp = Option::unwrap("
    "StringView::code_point(ch));\n        if (sasl_in(SASLPREP_C12, cp))\n        {\n            Vec::push("
    "&mut mapped, 0x20);\n        }\n        else if (!sasl_in(SASLPREP_B1, cp))\n        {\n            Vec:"
    ":push(&mut mapped, cp);\n        }\n    }\n    usize n = Vec::len(&mapped);\n    if (n == 0)\n    {\n     "
    "   return None;\n    }\n    bool randal = false;\n    bool l = false;\n    foreach (c in &mapped)\n    {\n"
    "        if (sasl_in(SASLPREP_PROHIBITED, *c) || sasl_in(SASLPREP_UNASSIGNED, *c))\n        {\n        "
    "    return None;\n        }\n        if (sasl_in(SASLPREP_RANDAL, *c))\n        {\n            randal = "
    "true;\n        }\n        if (sasl_in(SASLPREP_L, *c))\n        {\n            l = true;\n        }\n    }"
    "\n    if (randal && (l || !sasl_in(SASLPREP_RANDAL, mapped[0]) || !sasl_in(SASLPREP_RANDAL, mapped[n "
    "- 1])))\n    {\n        return None;\n    }\n    Vec<u32> norm = sasl_nfkc(&mapped);\n    String out = St"
    "ring::new();\n    foreach (c in &norm)\n    {\n        String::push_code_point(&mut out, *c);\n    }\n   "
    " Some(out)\n}unittest \"saslprep: the RFC's examples\"\n{\n    assert(Option::unwrap(saslprep(\"I\\u{AD}X\")"
    ") == \"IX\");\n    assert(Option::unwrap(saslprep(\"user\")) == \"user\");\n    assert(Option::unwrap(saslpr"
    "ep(\"USER\")) == \"USER\");\n    assert(Option::unwrap(saslprep(\"\\u{AA}\")) == \"a\");\n    assert(Option::un"
    "wrap(saslprep(\"\\u{2168}\")) == \"IX\");\n    assert(Option::unwrap(saslprep(\"\\u{7}\")) == \"\\u{7}\");\n    a"
    "ssert(Option::is_none(&saslprep(\"\\u{627}1\")));\n    assert(Option::unwrap(saslprep(\"a\\u{A0}b\")) == \"a"
    " b\");\n    assert(Option::unwrap(saslprep(\"\\u{D55C}\")) == \"\\u{D55C}\");\n    assert(Option::unwrap(sasl"
    "prep(\"e\\u{301}\")) == \"\\u{E9}\");\n    assert(Option::is_none(&saslprep(\"\\u{221}\\u{A0}x\")));\n}unittest "
    "\"saslprep: as PostgreSQL's\"\n{\n    assert(Option::unwrap(saslprep(\"x\\u{200B}z\")) == \"x z\");\n    asser"
    "t(Option::is_none(&saslprep(\"\\u{AD}\\u{200D}\")));\n    assert(Option::is_none(&saslprep(\"e\\u{340}\")));"
    "\n    assert(Option::unwrap(saslprep(\"\\u{5D0}\\u{2122}\\u{5D0}\")) == \"\\u{5D0}TM\\u{5D0}\");\n    assert(Op"
    "tion::unwrap(saslprep(\"\\u{2F868}\")) == \"\\u{36FC}\");\n}export fn PgError::text(ref<PgError, shared> e)"
    " : String\n{\n    match (e)\n    {\n        PgNetFailure(n)   : String::copy(NetError::text(n)),\n       "
    " PgTlsFailure(t)   : String::copy(TlsError::text(t)),\n        TlsRefused        : \"the server does n"
    "ot accept TLS\",\n        NoTrustedRoots    : \"no trusted roots for TLS (TrustStore::system failed)\",\n"
    "        BadConnectionUrl  : \"the connection URL is malformed\",\n        UnsupportedAuth   : \"the serv"
    "er asks for an authentication method that is not supported\",\n        AuthRefused       : \"the server"
    " asks for the password in clear over an unencrypted connection\",\n        AuthFailed        : \"authen"
    "tication failed\",\n        Server(s)         :\n        {\n            String t = String::clone(&s.seve"
    "rity);\n            String::append(&mut t, \": \");\n            String::append(&mut t, &s.message);\n   "
    "         String::append(&mut t, \" (\");\n            String::append(&mut t, &s.code);\n            Stri"
    "ng::append(&mut t, \")\");\n            t\n        },\n        ProtocolViolation : \"the server's message "
    "is malformed\",\n        ResultTooLarge    : \"the result is larger than the limit\",\n        Disconnect"
    "ed      : \"the connection is closed\",\n        Unsupported(what) : String::copy(*what),\n    }\n}fn dec"
    "oded(StringView v) : Result<String, PgError>\n{\n    Vec<u8> bytes = match (percent_decode(v))\n    {\n "
    "       Some(b) : b,\n        None    : return Err(BadConnectionUrl),\n    };\n    foreach (x in &bytes)"
    "\n    {\n        if (*x == 0)\n        {\n            return Err(BadConnectionUrl);\n        }\n    }\n    "
    "match (String::from_utf8(bytes))\n    {\n        Ok(s)  : Ok(s),\n        Err(_) : Err(BadConnectionUrl"
    "),\n    }\n}export fn PgUrl::parse(StringView text) : Result<PgUrl, PgError>\n{\n    usize sep = match ("
    "StringView::find(text, \"://\"))\n    {\n        Some(i) : i,\n        None    : return Err(BadConnection"
    "Url),\n    };\n    StringView scheme = &text[0..sep];\n    if (scheme != \"postgres\" && scheme != \"postg"
    "resql\")\n    {\n        return Err(BadConnectionUrl);\n    }\n    StringView rest = &text[sep + 3..$];\n "
    "   usize n = StringView::len(rest);\n    slice<u8, shared> b = StringView::as_bytes(rest);\n    usize "
    "auth_end = 0;\n    while (auth_end < n && b[auth_end] != b'/' && b[auth_end] != b'?')\n    {\n        a"
    "uth_end += 1;\n    }\n    // The user information ends at the last '@' of the authority.\n    usize at_"
    "sign = auth_end;\n    for (usize i = 0; i < auth_end; i += 1)\n    {\n        if (b[i] == b'@')\n       "
    " {\n            at_sign = i;\n        }\n    }\n    if (at_sign == auth_end || at_sign == 0)\n    {\n     "
    "   return Err(BadConnectionUrl);\n    }\n    StringView userinfo = &rest[0..at_sign];\n    String user "
    "= String::new();\n    Option<String> password = None;\n    match (StringView::find(userinfo, \":\"))\n   "
    " {\n        Some(colon) :\n        {\n            overwrite(&mut user, decoded(&userinfo[0..colon])?);\n"
    "            overwrite(&mut password, Some(decoded(&userinfo[colon + 1..$])?));\n        },\n        No"
    "ne        : overwrite(&mut user, decoded(userinfo)?),\n    }\n    if (StringView::len(&user) == 0)\n   "
    " {\n        return Err(BadConnectionUrl);\n    }\n    StringView hostport = &rest[at_sign + 1..auth_end"
    "];\n    usize hp = StringView::len(hostport);\n    slice<u8, shared> hb = StringView::as_bytes(hostpor"
    "t);\n    if (hp == 0)\n    {\n        return Err(BadConnectionUrl);\n    }\n    String host = String::new"
    "();\n    usize host_end = 0;\n    if (hb[0] == b'[')\n    {\n        usize close = match (StringView::fi"
    "nd(hostport, \"]\"))\n        {\n            Some(i) : i,\n            None    : return Err(BadConnection"
    "Url),\n        };\n        String::append(&mut host, &hostport[1..close]);\n        host_end = close + "
    "1;\n    }\n    else\n    {\n        while (host_end < hp && hb[host_end] != b':')\n        {\n            "
    "host_end += 1;\n        }\n        String::append(&mut host, &hostport[0..host_end]);\n    }\n    if (St"
    "ringView::len(&host) == 0)\n    {\n        return Err(BadConnectionUrl);\n    }\n    u16 port = 5432;\n  "
    "  if (host_end < hp)\n    {\n        if (hb[host_end] != b':')\n        {\n            return Err(BadCon"
    "nectionUrl);\n        }\n        port = match (StringView::parse<u16>(&hostport[host_end + 1..hp]))\n  "
    "      {\n            Ok(p)  : p,\n            Err(_) : return Err(BadConnectionUrl),\n        };\n    }\n"
    "    // The database: the path without its '/', the user when none.\n    usize path_end = auth_end;\n  "
    "  while (path_end < n && b[path_end] != b'?')\n    {\n        path_end += 1;\n    }\n    String database"
    " = String::new();\n    if (path_end > auth_end + 1)\n    {\n        overwrite(&mut database, decoded(&r"
    "est[auth_end + 1..path_end])?);\n    }\n    if (StringView::len(&database) == 0)\n    {\n        overwri"
    "te(&mut database, String::clone(&user));\n    }\n    PgSslMode sslmode = VerifyFull;\n    if (path_end "
    "< n)\n    {\n        StringView query = &rest[path_end + 1..n];\n        if (StringView::len(query) > 0"
    ")\n        {\n            Vec<StringView> pairs = StringView::split(query, \"&\");\n            foreach ("
    "pair in &pairs)\n            {\n                if (StringView::starts_with(*pair, \"sslmode=\"))\n      "
    "          {\n                    StringView mode = &(*pair)[8..$];\n                    if (mode == \"d"
    "isable\")\n                    {\n                        sslmode = Disable;\n                    }\n    "
    "                else if (mode == \"verify-full\")\n                    {\n                        sslmod"
    "e = VerifyFull;\n                    }\n                    else\n                    {\n               "
    "         return Err(BadConnectionUrl);\n                    }\n                }\n                else\n"
    "                {\n                    return Err(BadConnectionUrl);\n                }\n            }\n"
    "        }\n    }\n    Ok(PgUrl { .user = user, .password = password, .host = host, .port = port, .data"
    "base = database, .sslmode = sslmode })\n}unittest \"PgUrl::parse: decoding and defaults\"\n{\n    PgUrl u"
    " = Result::unwrap(PgUrl::parse(\"postgres://app:p%40ss@[::1]/?sslmode=disable\"));\n    assert(u.host ="
    "= \"::1\" && u.port == 5432);\n    assert(u.database == \"app\");\n    match (&u.password)\n    {\n        S"
    "ome(p) : assert(*p == \"p@ss\"),\n        None    : assert(false),\n    }\n    Result<PgUrl, PgError> no_"
    "user = PgUrl::parse(\"postgres://db.example/shop\");\n    assert(Result::is_err(&no_user));\n    assert("
    "Result::is_err(&PgUrl::parse(\"postgres://me@h/db%00options%00-c%20x=y\")));\n    assert(Result::is_err"
    "(&PgUrl::parse(\"postgres://me%00x@h/db\")));\n}fn float_text(f64 x) : String\n{\n    if (x != x)\n    {\n "
    "       return \"NaN\";\n    }\n    if (x > 1.7976931348623157e308)\n    {\n        return \"Infinity\";\n    "
    "}\n    if (x < -1.7976931348623157e308)\n    {\n        return \"-Infinity\";\n    }\n    // Report 303: a "
    "whole number within 2^53 is sent without a fraction,\n    // so a `Json` number (an `f64`) goes into "
    "an integer column as it\n    // goes into a float or numeric one; a column of `integer` refuses\n    /"
    "/ `2.0`, every numeric type reads `2`.\n    if (x == trunc(x) && x > -9007199254740992.0 && x < 90071"
    "99254740992.0)\n    {\n        if (x == 0.0 && 1.0 / x < 0.0)\n        {\n            return \"-0\";\n     "
    "   }\n        String w = String::new();\n        String::append(&mut w, to_int<i64>(x));\n        retur"
    "n w;\n    }\n    String t = String::new();\n    String::append(&mut t, x);\n    t\n}export fn PgValue::te"
    "xt(ref<PgValue, shared> value) : Option<String>\n{\n    match (value)\n    {\n        Null     : None,\n "
    "       Text(s)  : Some(String::clone(s)),\n        Int(i)   :\n        {\n            String t = String"
    "::new();\n            String::append(&mut t, *i);\n            Some(t)\n        },\n        Float(f) : S"
    "ome(float_text(*f)),\n        Bool(b)  : Some(if (*b) { \"t\" } else { \"f\" }),\n        Bytes(v) :\n     "
    "   {\n            String t = \"\\\\x\";\n            String::append(&mut t, &to_hex(v));\n            Some("
    "t)\n        },\n    }\n}unittest \"PgValue::text: what is sent\"\n{\n    assert(Option::unwrap(PgValue::tex"
    "t(&Bool(true))) == \"t\");\n    assert(Option::unwrap(PgValue::text(&Bytes(Vec::filled(2, 0xAB: u8)))) "
    "== \"\\\\xabab\");\n    assert(Option::unwrap(PgValue::text(&Float(1.0 / 0.0))) == \"Infinity\");\n    asser"
    "t(Option::unwrap(PgValue::text(&Float(2.0))) == \"2\");\n    assert(Option::unwrap(PgValue::text(&Float"
    "(-0.0))) == \"-0\");\n    assert(Option::unwrap(PgValue::text(&Float(2.5))) == \"2.5\");\n    assert(Optio"
    "n::is_none(&PgValue::text(&Null)));\n}export fn PgRow::get(ref<PgRow, shared> r, usize i) : Option<St"
    "ringView>\n{\n    if (i >= Vec::len(&r.cells))\n    {\n        return None;\n    }\n    match (&r.cells[i]"
    ")\n    {\n        Some(s) : Some(s),\n        None    : None,\n    }\n}export fn PgRow::get_i64(ref<PgRow"
    ", shared> r, usize i) : Option<i64>\n{\n    match (PgRow::get(r, i))\n    {\n        Some(t) : match (St"
    "ringView::parse<i64>(t))\n        {\n            Ok(v)  : Some(v),\n            Err(_) : None,\n        "
    "},\n        None : None,\n    }\n}export fn PgRow::get_f64(ref<PgRow, shared> r, usize i) : Option<f64>"
    "\n{\n    match (PgRow::get(r, i))\n    {\n        Some(t) :\n        {\n            if (t == \"NaN\")\n      "
    "      {\n                return Some(0.0 / 0.0);\n            }\n            if (t == \"Infinity\")\n     "
    "       {\n                return Some(1.0 / 0.0);\n            }\n            if (t == \"-Infinity\")\n   "
    "         {\n                return Some(-1.0 / 0.0);\n            }\n            match (StringView::par"
    "se<f64>(t))\n            {\n                Ok(v)  : Some(v),\n                Err(_) : None,\n         "
    "   }\n        },\n        None    : None,\n    }\n}export fn PgRow::get_bool(ref<PgRow, shared> r, usize"
    " i) : Option<bool>\n{\n    match (PgRow::get(r, i))\n    {\n        Some(t) :\n        {\n            if ("
    "t == \"t\")\n            {\n                return Some(true);\n            }\n            if (t == \"f\")\n "
    "           {\n                return Some(false);\n            }\n            None\n        },\n        N"
    "one    : None,\n    }\n}export fn PgRow::get_bytes(ref<PgRow, shared> r, usize i) : Option<Vec<u8>>\n{\n"
    "    match (PgRow::get(r, i))\n    {\n        Some(t) : match (StringView::strip_prefix(t, \"\\\\x\"))\n    "
    "    {\n            // `\\x` alone is the empty bytea, no bytes.\n            Some(hex) : match (from_he"
    "x(hex))\n            {\n                Ok(v)  : Some(v),\n                Err(_) : None,\n            }"
    ",\n            None : None,\n        },\n        None : None,\n    }\n}export fn PgRow::get_datetime(ref<"
    "PgRow, shared> r, usize i) : Option<DateTime>\n{\n    match (PgRow::get(r, i))\n    {\n        Some(t) :"
    " match (DateTime::from_iso(t))\n        {\n            Ok(d)  : Some(d),\n            Err(_) : None,\n  "
    "      },\n        None : None,\n    }\n}unittest \"PgRow: typed reads of cells\"\n{\n    Vec<Option<String>"
    "> cells = Vec::new();\n    Vec::push(&mut cells, Some(\"42\"));\n    Vec::push(&mut cells, Some(\"t\"));\n "
    "   Vec::push(&mut cells, None);\n    Vec::push(&mut cells, Some(\"2023-11-15 09:13:20.25+11\"));\n    Pg"
    "Row row = PgRow { .cells = cells };\n    assert(DateTime::to_iso(&Option::unwrap(PgRow::get_datetime("
    "&row, 3))) == \"2023-11-14T22:13:20Z\");\n    assert(Option::is_none(&PgRow::get_datetime(&row, 0)));\n "
    "   assert(Option::unwrap(PgRow::get_i64(&row, 0)) == 42);\n    assert(Option::unwrap(PgRow::get_bool("
    "&row, 1)));\n    assert(Option::is_none(&PgRow::get_bool(&row, 0)));\n    assert(Option::is_none(&PgRo"
    "w::get(&row, 2)) && Option::is_none(&PgRow::get(&row, 9)));\n}export fn PgResult::column(ref<PgResult"
    ", shared> res, StringView name) : Option<usize>\n{\n    for (usize i = 0; i < Vec::len(&res.columns); "
    "i += 1)\n    {\n        if (res.columns[i].name == name)\n        {\n            return Some(i);\n       "
    " }\n    }\n    None\n}fn tag_count(StringView tag) : u64\n{\n    Vec<StringView> words = StringView::spli"
    "t(tag, \" \");\n    if (Vec::len(&words) < 2)\n    {\n        return 0;\n    }\n    match (StringView::pars"
    "e<u64>(words[Vec::len(&words) - 1]))\n    {\n        Ok(n)  : n,\n        Err(_) : 0,\n    }\n}fn pg_read"
    "(ref<PgConn, exclusive> c, ref<Vec<u8>, exclusive> buf, usize max) : Result<usize, PgError>\n{\n    ma"
    "tch (c)\n    {\n        Plain(s) : match (TcpStream::read(s, buf, max))\n        {\n            Ok(n)  :"
    " Ok(n),\n            Err(e) : Err(PgNetFailure(e)),\n        },\n        Secure(s) : match (TlsStream::"
    "read(s, buf, max))\n        {\n            Ok(n)  : Ok(n),\n            Err(e) : Err(PgTlsFailure(e)),\n"
    "        },\n    }\n}fn pg_write(ref<PgConn, exclusive> c, slice<u8, shared> data) : Result<void, PgErr"
    "or>\n{\n    match (c)\n    {\n        Plain(s) : match (TcpStream::write(s, data))\n        {\n           "
    " Ok(_)  : Ok(()),\n            Err(e) : Err(PgNetFailure(e)),\n        },\n        Secure(s) : match (T"
    "lsStream::write(s, data))\n        {\n            Ok(_)  : Ok(()),\n            Err(e) : Err(PgTlsFailu"
    "re(e)),\n        },\n    }\n}fn pg_close(ref<PgConn, exclusive> c)\n{\n    match (c)\n    {\n        Plain("
    "s)  : { _ = TcpStream::shutdown_write(s); },\n        Secure(s) : { _ = TlsStream::close(s); },\n    }"
    "\n}fn pg_fill(ref<PgReader, exclusive> r) : Result<bool, PgError>\n{\n    if (r.at > 0)\n    {\n        i"
    "f (r.at == Vec::len(&r.buf))\n        {\n            Vec::clear(&mut r.buf);\n        }\n        else\n  "
    "      {\n            Vec<u8> rest = Vec::from_slice(&r.buf[r.at..$]);\n            overwrite(&mut r.bu"
    "f, rest);\n        }\n        r.at = 0;\n    }\n    usize n = pg_read(&mut r.conn, &mut r.buf, 16384)?;\n"
    "    Ok(n > 0)\n}fn pg_available(ref<PgReader, shared> r) : usize\n{\n    Vec::len(&r.buf) - r.at\n}fn pg"
    "_read_n(ref<PgReader, exclusive> r, ref<Vec<u8>, exclusive> out, usize n) : Result<void, PgError>\n{\n"
    "    usize need = n;\n    while (need > 0)\n    {\n        if (pg_available(r) == 0)\n        {\n         "
    "   if (!pg_fill(r)?)\n            {\n                return Err(Disconnected);\n            }\n        }"
    "\n        usize take = min(need, pg_available(r));\n        Vec::extend_from(out, &r.buf[r.at..r.at + "
    "take]);\n        r.at += take;\n        need -= take;\n    }\n    Ok(())\n}fn read_message(ref<PgReader, "
    "exclusive> r) : Result<Message, PgError>\n{\n    while (pg_available(r) < 5)\n    {\n        if (!pg_fil"
    "l(r)?)\n        {\n            return Err(Disconnected);\n        }\n    }\n    u8 kind = r.buf[r.at];\n  "
    "  u32 len = read_be<u32>(&r.buf, r.at + 1);\n    if (len < 4 || widen<usize>(len) - 4 > MAX_MESSAGE)\n"
    "    {\n        return Err(ProtocolViolation);\n    }\n    usize n = widen<usize>(len) - 4;\n    while (p"
    "g_available(r) < 5 + n)\n    {\n        if (!pg_fill(r)?)\n        {\n            return Err(Disconnecte"
    "d);\n        }\n    }\n    Vec<u8> body = Vec::from_slice(&r.buf[r.at + 5..r.at + 5 + n]);\n    r.at += "
    "5 + n;\n    Ok(Message { .kind = kind, .body = body })\n}fn frame(u8 kind, slice<u8, shared> body) : V"
    "ec<u8>\n{\n    Vec<u8> out = Vec::new();\n    Vec::push(&mut out, kind);\n    Vec::push_be(&mut out, nar"
    "row<u32>(slice_len(body) + 4));\n    Vec::extend_from(&mut out, body);\n    out\n}fn push_cstr(ref<Vec<"
    "u8>, exclusive> out, StringView s)\n{\n    Vec::extend_from(out, StringView::as_bytes(s));\n    Vec::pu"
    "sh(out, 0);\n}fn cstr_at(slice<u8, shared> b, ref<usize, exclusive> at) : Result<String, PgError>\n{\n "
    "   usize end = *at;\n    while (end < slice_len(b) && b[end] != 0)\n    {\n        end += 1;\n    }\n    "
    "if (end == slice_len(b))\n    {\n        return Err(ProtocolViolation);\n    }\n    Vec<u8> bytes = Vec:"
    ":from_slice(&b[*at..end]);\n    *at = end + 1;\n    match (String::from_utf8(bytes))\n    {\n        Ok("
    "s)  : Ok(s),\n        Err(_) : Err(ProtocolViolation),\n    }\n}fn decode_server_error(slice<u8, shared"
    "> b) : Result<PgServerError, PgError>\n{\n    PgServerError e = PgServerError { .severity = String::ne"
    "w(), .code = String::new(), .message = String::new(), .detail = None, .hint = None, .position = None"
    " };\n    usize at = 0;\n    while (at < slice_len(b) && b[at] != 0)\n    {\n        u8 field = b[at];\n  "
    "      at += 1;\n        String t = cstr_at(b, &mut at)?;\n        if (field == b'S' || field == b'V')\n"
    "        {\n            overwrite(&mut e.severity, t);\n        }\n        else if (field == b'C')\n     "
    "   {\n            overwrite(&mut e.code, t);\n        }\n        else if (field == b'M')\n        {\n    "
    "        overwrite(&mut e.message, t);\n        }\n        else if (field == b'D')\n        {\n          "
    "  overwrite(&mut e.detail, Some(t));\n        }\n        else if (field == b'H')\n        {\n           "
    " overwrite(&mut e.hint, Some(t));\n        }\n        else if (field == b'P')\n        {\n            ma"
    "tch (StringView::parse<u32>(&t))\n            {\n                Ok(p)  : overwrite(&mut e.position, S"
    "ome(p)),\n                Err(_) : {},\n            }\n        }\n    }\n    Ok(e)\n}fn decode_columns(sli"
    "ce<u8, shared> b) : Result<Vec<PgColumn>, PgError>\n{\n    if (slice_len(b) < 2)\n    {\n        return "
    "Err(ProtocolViolation);\n    }\n    usize n = widen<usize>(read_be<u16>(b, 0));\n    usize at = 2;\n    "
    "Vec<PgColumn> columns = Vec::new();\n    for (usize i = 0; i < n; i += 1)\n    {\n        String name ="
    " cstr_at(b, &mut at)?;\n        if (at + 18 > slice_len(b))\n        {\n            return Err(Protocol"
    "Violation);\n        }\n        u32 type_oid = read_be<u32>(b, at + 6);\n        at += 18;\n        Vec:"
    ":push(&mut columns, PgColumn { .name = name, .type_oid = type_oid });\n    }\n    Ok(columns)\n}fn deco"
    "de_row(slice<u8, shared> b) : Result<PgRow, PgError>\n{\n    if (slice_len(b) < 2)\n    {\n        retur"
    "n Err(ProtocolViolation);\n    }\n    usize n = widen<usize>(read_be<u16>(b, 0));\n    usize at = 2;\n  "
    "  Vec<Option<String>> cells = Vec::new();\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (at "
    "+ 4 > slice_len(b))\n        {\n            return Err(ProtocolViolation);\n        }\n        i32 len ="
    " read_be<i32>(b, at);\n        at += 4;\n        if (len < 0)\n        {\n            Vec::push(&mut cel"
    "ls, None);\n            continue;\n        }\n        usize size = narrow<usize>(len);\n        if (at +"
    " size > slice_len(b))\n        {\n            return Err(ProtocolViolation);\n        }\n        Vec<u8>"
    " bytes = Vec::from_slice(&b[at..at + size]);\n        at += size;\n        match (String::from_utf8(by"
    "tes))\n        {\n            Ok(s)  : Vec::push(&mut cells, Some(s)),\n            Err(_) : return Err"
    "(ProtocolViolation),\n        }\n    }\n    Ok(PgRow { .cells = cells })\n}fn open_tcp(StringView host, "
    "u16 port, u64 timeout_ms) : Result<TcpStream, PgError>\n{\n    Vec<SocketAddr> addrs = match (IpAddr::"
    "parse(host))\n    {\n        Ok(ip) :\n        {\n            Vec<SocketAddr> one = Vec::new();\n        "
    "    Vec::push(&mut one, SocketAddr::new(ip, port));\n            one\n        },\n        Err(_) : matc"
    "h (resolve(host, port))\n        {\n            Ok(a)  : a,\n            Err(e) : return Err(PgNetFailu"
    "re(e)),\n        },\n    };\n    if (Vec::len(&addrs) == 0)\n    {\n        return Err(PgNetFailure(Unkno"
    "wnHost));\n    }\n    NetError last = Failed;\n    for (usize i = 0; i < Vec::len(&addrs); i += 1)\n    "
    "{\n        TcpStream tcp = match (TcpStream::connect_timeout(addrs[i], timeout_ms))\n        {\n       "
    "     Ok(t)  : t,\n            Err(e) :\n            {\n                last = e;\n                contin"
    "ue;\n            },\n        };\n        TcpStream::set_read_timeout_ms(&mut tcp, timeout_ms);\n        "
    "TcpStream::set_write_timeout_ms(&mut tcp, timeout_ms);\n        TcpStream::set_nodelay(&mut tcp, true"
    ");\n        return Ok(tcp);\n    }\n    Err(PgNetFailure(last))\n}export fn PgConnection::connect(String"
    "View url) : Result<PgConnection, PgError>\n{\n    PgUrl u = PgUrl::parse(url)?;\n    TrustStore roots ="
    " match (u.sslmode)\n    {\n        Disable : TrustStore::new(),\n        VerifyFull : match (TrustStore"
    "::system())\n        {\n            Ok(t)  : t,\n            Err(_) : return Err(NoTrustedRoots),\n     "
    "   },\n    };\n    connect_url(&u, &roots, 30000)\n}export fn PgConnection::connect_with(\n    StringVie"
    "w url,\n    ref<TrustStore, shared> roots,\n    u64 timeout_ms,\n) : Result<PgConnection, PgError>\n{\n  "
    "  PgUrl u = PgUrl::parse(url)?;\n    connect_url(&u, roots, timeout_ms)\n}fn connect_url(ref<PgUrl, sh"
    "ared> u, ref<TrustStore, shared> roots, u64 timeout_ms) : Result<PgConnection, PgError>\n{\n    TcpStr"
    "eam tcp = open_tcp(&u.host, u.port, timeout_ms)?;\n    SocketAddr server = TcpStream::peer_addr(&tcp)"
    ";\n    bool secure = false;\n    PgConn conn = match (u.sslmode)\n    {\n        Disable    : Plain(tcp)"
    ",\n        VerifyFull :\n        {\n            // SSLRequest: the server answers S (go ahead) or N (no"
    " TLS).\n            Vec<u8> req = Vec::new();\n            Vec::push_be<u32>(&mut req, 8);\n           "
    " Vec::push_be<u32>(&mut req, 80877103);\n            match (TcpStream::write(&mut tcp, &req))\n       "
    "     {\n                Ok(_)  : {},\n                Err(e) : return Err(PgNetFailure(e)),\n          "
    "  }\n            Vec<u8> answer = Vec::new();\n            match (TcpStream::read_exact(&mut tcp, &mut"
    " answer, 1))\n            {\n                Ok(_)  : {},\n                Err(e) : return Err(PgNetFai"
    "lure(e)),\n            }\n            if (answer[0] == b'N')\n            {\n                return Err("
    "TlsRefused);\n            }\n            if (answer[0] != b'S')\n            {\n                return E"
    "rr(ProtocolViolation);\n            }\n            secure = true;\n            match (TlsStream::client"
    "(tcp, &u.host, roots))\n            {\n                Ok(s)  : Secure(s),\n                Err(e) : re"
    "turn Err(PgTlsFailure(e)),\n            }\n        },\n    };\n    PgConnection c = PgConnection { .read"
    "er = PgReader { .conn = conn, .buf = Vec::new(), .at = 0 }, .secure = secure, .closed = false, .para"
    "meters = Vec::new(), .backend_pid = 0, .backend_key = 0, .server = server, .timeout_ms = timeout_ms,"
    " .notices = Vec::new(), .max_result = 16777216 };\n    // StartupMessage: protocol 3.0, the user, the"
    " database, UTF-8.\n    Vec<u8> body = Vec::new();\n    Vec::push_be<u32>(&mut body, 196608);\n    push_"
    "cstr(&mut body, \"user\");\n    push_cstr(&mut body, &u.user);\n    push_cstr(&mut body, \"database\");\n  "
    "  push_cstr(&mut body, &u.database);\n    push_cstr(&mut body, \"client_encoding\");\n    push_cstr(&mut"
    " body, \"UTF8\");\n    Vec::push(&mut body, 0);\n    Vec<u8> startup = Vec::new();\n    Vec::push_be(&mut"
    " startup, narrow<u32>(Vec::len(&body) + 4));\n    Vec::extend_from(&mut startup, &body);\n    match (p"
    "g_write(&mut c.reader.conn, &startup))\n    {\n        Ok(_)  : {},\n        Err(e) : return Err(e),\n  "
    "  }\n    match (authenticate(&mut c, u))\n    {\n        Ok(_)  : Ok(c),\n        Err(e) :\n        {\n   "
    "         pg_close(&mut c.reader.conn);\n            Err(e)\n        },\n    }\n}fn authenticate(ref<PgCo"
    "nnection, exclusive> c, ref<PgUrl, shared> u) : Result<void, PgError>\n{\n    Option<Scram> scram = No"
    "ne;\n    // Once SCRAM has begun, AuthenticationOk counts only after the\n    // server's signature wa"
    "s verified ([Pg-Auth]): a server that skips\n    // its final message has not proved it knows the pas"
    "sword.\n    bool scram_begun = false;\n    bool scram_verified = false;\n    String password = match (&"
    "u.password)\n    {\n        Some(p) : String::clone(p),\n        None    : String::new(),\n    };\n    //"
    " SCRAM's password is SASLprep's form of it (RFC 5802 §2.2), as the\n    // server prepared it when t"
    "he password was set; the password as given\n    // when SASLprep refuses it, as the server and libpq "
    "do.\n    String prepared = match (saslprep(&password))\n    {\n        Some(p) : p,\n        None    : S"
    "tring::clone(&password),\n    };\n    while (true)\n    {\n        Message m = read_message(&mut c.reade"
    "r)?;\n        slice<u8, shared> b = &m.body;\n        if (m.kind == b'R')\n        {\n            if (sl"
    "ice_len(b) < 4)\n            {\n                return Err(ProtocolViolation);\n            }\n         "
    "   u32 code = read_be<u32>(b, 0);\n            if (code == 0)\n            {\n                if (scram"
    "_begun && !scram_verified)\n                {\n                    return Err(AuthFailed);\n           "
    "     }\n                continue;\n            }\n            else if (code == 3)\n            {\n       "
    "         if (!c.secure)\n                {\n                    return Err(AuthRefused);\n             "
    "   }\n                Vec<u8> pw = Vec::new();\n                push_cstr(&mut pw, &password);\n       "
    "         pg_write(&mut c.reader.conn, &frame(b'p', &pw))?;\n            }\n            else if (code ="
    "= 10)\n            {\n                bool offered = false;\n                usize at = 4;\n            "
    "    while (at < slice_len(b) && b[at] != 0)\n                {\n                    String mech = cstr"
    "_at(b, &mut at)?;\n                    if (mech == \"SCRAM-SHA-256\")\n                    {\n           "
    "             offered = true;\n                    }\n                }\n                if (!offered)\n "
    "               {\n                    return Err(UnsupportedAuth);\n                }\n                "
    "array<u8, 18> raw = [0; 18];\n                os_random_bytes(&mut raw);\n                String nonce"
    " = base64_encode(&raw);\n                Scram s = Scram::start(\"\", &nonce);\n                String f"
    "irst = Scram::client_first(&s);\n                Vec<u8> body = Vec::new();\n                push_cstr"
    "(&mut body, \"SCRAM-SHA-256\");\n                Vec::push_be(&mut body, narrow<u32>(StringView::len(&f"
    "irst)));\n                Vec::extend_from(&mut body, StringView::as_bytes(&first));\n                "
    "pg_write(&mut c.reader.conn, &frame(b'p', &body))?;\n                overwrite(&mut scram, Some(s));\n"
    "                scram_begun = true;\n            }\n            else if (code == 11)\n            {\n   "
    "             String server_first = match (String::from_utf8(Vec::from_slice(&b[4..$])))\n            "
    "    {\n                    Ok(s)  : s,\n                    Err(_) : return Err(ProtocolViolation),\n  "
    "              };\n                String client_final = match (&mut scram)\n                {\n        "
    "            Some(s) : Scram::respond(s, &server_first, &prepared)?,\n                    None    : re"
    "turn Err(ProtocolViolation),\n                };\n                pg_write(&mut c.reader.conn, &frame("
    "b'p', StringView::as_bytes(&client_final)))?;\n            }\n            else if (code == 12)\n       "
    "     {\n                String server_final = match (String::from_utf8(Vec::from_slice(&b[4..$])))\n  "
    "              {\n                    Ok(s)  : s,\n                    Err(_) : return Err(ProtocolViol"
    "ation),\n                };\n                bool ok = match (&scram)\n                {\n              "
    "      Some(s) : Scram::verify(s, &server_final),\n                    None    : false,\n              "
    "  };\n                if (!ok)\n                {\n                    return Err(AuthFailed);\n        "
    "        }\n                scram_verified = true;\n            }\n            else\n            {\n      "
    "          return Err(UnsupportedAuth);\n            }\n        }\n        else if (m.kind == b'S')\n    "
    "    {\n            usize at = 0;\n            String name = cstr_at(b, &mut at)?;\n            String v"
    "alue = cstr_at(b, &mut at)?;\n            if (name == \"client_encoding\" && value != \"UTF8\")\n         "
    "   {\n                return Err(Unsupported(ENCODING_CHANGED));\n            }\n            Vec::push("
    "&mut c.parameters, PgParameter { .name = name, .value = value });\n        }\n        else if (m.kind "
    "== b'K')\n        {\n            if (slice_len(b) < 8)\n            {\n                return Err(Protoc"
    "olViolation);\n            }\n            c.backend_pid = read_be<u32>(b, 0);\n            c.backend_ke"
    "y = read_be<u32>(b, 4);\n        }\n        else if (m.kind == b'Z')\n        {\n            return Ok(("
    "));\n        }\n        else if (m.kind == b'E')\n        {\n            PgServerError e = decode_server"
    "_error(b)?;\n            return Err(if (StringView::starts_with(&e.code, \"28\")) { AuthFailed } else {"
    " Server(e) });\n        }\n        else if (m.kind == b'N')\n        {\n            Vec::push(&mut c.not"
    "ices, decode_server_error(b)?);\n        }\n        else\n        {\n            return Err(ProtocolViol"
    "ation);\n        }\n    }\n}export fn PgConnection::parameter(ref<PgConnection, shared> c, StringView n"
    "ame) : Option<StringView> from c\n{\n    foreach (p in &c.parameters)\n    {\n        if (p.name == name"
    ")\n        {\n            return Some(&p.value);\n        }\n    }\n    None\n}fn broken(ref<PgConnection,"
    " exclusive> c, PgError e) : PgError\n{\n    c.closed = true;\n    e\n}fn send_cancel(ref<PgConnection, s"
    "hared> c)\n{\n    if (Ok(tcp) = TcpStream::connect_timeout(c.server, if (c.timeout_ms == 0) { 30000 } "
    "else { c.timeout_ms }))\n    {\n        Vec<u8> req = Vec::new();\n        Vec::push_be<u32>(&mut req, "
    "16);\n        Vec::push_be<u32>(&mut req, 80877102);\n        Vec::push_be(&mut req, c.backend_pid);\n "
    "       Vec::push_be(&mut req, c.backend_key);\n        _ = TcpStream::write(&mut tcp, &req);\n        "
    "_ = TcpStream::shutdown_write(&mut tcp);\n    }\n}fn collect(ref<PgConnection, exclusive> c, bool keep"
    ", bool extended) : Result<PgResult, PgError>\n{\n    PgResult res = PgResult { .columns = Vec::new(), "
    ".rows = Vec::new(), .affected = 0, .tag = String::new() };\n    Option<PgServerError> failure = None;"
    "\n    bool too_large = false;\n    usize bytes = 0;\n    bool cancelled = false;\n    Option<str> unsupp"
    "orted = None;\n    bool encoding_changed = false;\n    while (true)\n    {\n        Message m = match (r"
    "ead_message(&mut c.reader))\n        {\n            Ok(msg)                     : msg,\n            Err"
    "(PgNetFailure(TimedOut)) :\n            {\n                if (cancelled)\n                {\n          "
    "          return Err(broken(c, PgNetFailure(TimedOut)));\n                }\n                cancelled"
    " = true;\n                send_cancel(c);\n                continue;\n            },\n            Err(e)"
    "                      :\n            {\n                if (Some(se) = failure)\n                {\n    "
    "                return Err(broken(c, Server(se)));\n                }\n                return Err(brok"
    "en(c, e));\n            },\n        };\n        slice<u8, shared> b = &m.body;\n        if (m.kind == b'"
    "T')\n        {\n            match (decode_columns(b))\n            {\n                Ok(cols) : overwri"
    "te(&mut res.columns, cols),\n                Err(e)   : return Err(broken(c, e)),\n            }\n     "
    "   }\n        else if (m.kind == b'D')\n        {\n            if (keep && !too_large)\n            {\n  "
    "              bytes += slice_len(b);\n                if (bytes > c.max_result)\n                {\n   "
    "                 too_large = true;\n                    Vec::clear(&mut res.rows);\n                }\n"
    "                else\n                {\n                    match (decode_row(b))\n                   "
    " {\n                        Ok(row) : Vec::push(&mut res.rows, row),\n                        Err(e)  "
    ": return Err(broken(c, e)),\n                    }\n                }\n            }\n        }\n        "
    "else if (m.kind == b'C')\n        {\n            usize at = 0;\n            String tag = match (cstr_at"
    "(b, &mut at))\n            {\n                Ok(t)  : t,\n                Err(e) : return Err(broken(c"
    ", e)),\n            };\n            res.affected = tag_count(&tag);\n            overwrite(&mut res.tag"
    ", tag);\n        }\n        else if (m.kind == b'E')\n        {\n            PgServerError reported = ma"
    "tch (decode_server_error(b))\n            {\n                Ok(se) : se,\n                Err(e) : ret"
    "urn Err(broken(c, e)),\n            };\n            if (Option::is_none(&failure))\n            {\n     "
    "           overwrite(&mut failure, Some(reported));\n            }\n        }\n        else if (m.kind "
    "== b'N')\n        {\n            match (decode_server_error(b))\n            {\n                Ok(se) :"
    " Vec::push(&mut c.notices, se),\n                Err(e) : return Err(broken(c, e)),\n            }\n   "
    "     }\n        else if (m.kind == b'Z')\n        {\n            break;\n        }\n        else if (m.ki"
    "nd == b'G')\n        {\n            // CopyInResponse: refused with CopyFail (and, by the extended\n   "
    "         // protocol, a Sync, since the one sent is ignored in COPY).\n            unsupported = Some"
    "(COPY_IN);\n            Vec<u8> fail = Vec::new();\n            push_cstr(&mut fail, COPY_IN);\n       "
    "     Vec<u8> out = frame(b'f', &fail);\n            if (extended)\n            {\n                Vec<u"
    "8> none = Vec::new();\n                Vec::extend_from(&mut out, &frame(b'S', &none));\n            }"
    "\n            if (Err(e) = pg_write(&mut c.reader.conn, &out))\n            {\n                return E"
    "rr(broken(c, e));\n            }\n        }\n        else if (m.kind == b'H')\n        {\n            // "
    "CopyOutResponse: the data (CopyData, CopyDone) is read past.\n            unsupported = Some(COPY_OUT"
    ");\n        }\n        else if (m.kind == b'd' || m.kind == b'c')\n        {\n            if (Option::is"
    "_none(&unsupported))\n            {\n                return Err(broken(c, ProtocolViolation));\n       "
    "     }\n        }\n        else if (m.kind == b'S')\n        {\n            // ParameterStatus: text is "
    "UTF-8 here, so a client_encoding\n            // changed to another ends the connection once the serv"
    "er is\n            // ready (the rest of the reply read first).\n            usize at = 0;\n           "
    " String name = match (cstr_at(b, &mut at))\n            {\n                Ok(t)  : t,\n               "
    " Err(e) : return Err(broken(c, e)),\n            };\n            String value = match (cstr_at(b, &mut"
    " at))\n            {\n                Ok(t)  : t,\n                Err(e) : return Err(broken(c, e)),\n "
    "           };\n            if (name == \"client_encoding\" && value != \"UTF8\")\n            {\n          "
    "      encoding_changed = true;\n            }\n        }\n        else if (m.kind == b'1' || m.kind == "
    "b'2' || m.kind == b'n' || m.kind == b'I' || m.kind == b's' || m.kind == b'A')\n        {\n            "
    "// ParseComplete, BindComplete, NoData, EmptyQueryResponse,\n            // PortalSuspended, a notifi"
    "cation.\n            continue;\n        }\n        else\n        {\n            return Err(broken(c, Prot"
    "ocolViolation));\n        }\n    }\n    if (encoding_changed)\n    {\n        PgConnection::close(c);\n   "
    "     return Err(Unsupported(ENCODING_CHANGED));\n    }\n    if (Some(what) = unsupported)\n    {\n      "
    "  return Err(Unsupported(what));\n    }\n    if (Some(e) = failure)\n    {\n        return Err(Server(e)"
    ");\n    }\n    if (too_large)\n    {\n        return Err(ResultTooLarge);\n    }\n    Ok(res)\n}export fn P"
    "gConnection::set_timeout_ms(ref<PgConnection, exclusive> c, u64 ms)\n{\n    c.timeout_ms = ms;\n    mat"
    "ch (&mut c.reader.conn)\n    {\n        Plain(s)  :\n        {\n            TcpStream::set_read_timeout_"
    "ms(s, ms);\n            TcpStream::set_write_timeout_ms(s, ms);\n        },\n        Secure(s) :\n      "
    "  {\n            TlsStream::set_read_timeout_ms(s, ms);\n            TlsStream::set_write_timeout_ms(s"
    ", ms);\n        },\n    }\n}export fn PgConnection::query(\n    ref<PgConnection, exclusive> c,\n    Stri"
    "ngView sql,\n    slice<PgValue, shared> params,\n) : Result<PgResult, PgError>\n{\n    if (c.closed)\n   "
    " {\n        return Err(Disconnected);\n    }\n    if (slice_len(params) > 65535)\n    {\n        return E"
    "rr(ResultTooLarge);\n    }\n    Vec<u8> out = Vec::new();\n    Vec<u8> parse = Vec::new();\n    push_cst"
    "r(&mut parse, \"\");\n    push_cstr(&mut parse, sql);\n    Vec::push_be<u16>(&mut parse, 0);\n    Vec::ex"
    "tend_from(&mut out, &frame(b'P', &parse));\n    Vec<u8> bind = Vec::new();\n    push_cstr(&mut bind, \""
    "\");\n    push_cstr(&mut bind, \"\");\n    Vec::push_be<u16>(&mut bind, 0);\n    Vec::push_be(&mut bind, n"
    "arrow<u16>(slice_len(params)));\n    foreach (p in params)\n    {\n        match (PgValue::text(p))\n   "
    "     {\n            Some(t) :\n            {\n                Vec::push_be(&mut bind, narrow<u32>(Strin"
    "gView::len(&t)));\n                Vec::extend_from(&mut bind, StringView::as_bytes(&t));\n           "
    " },\n            None    : Vec::push_be<i32>(&mut bind, -1),\n        }\n    }\n    Vec::push_be<u16>(&m"
    "ut bind, 0);\n    Vec::extend_from(&mut out, &frame(b'B', &bind));\n    Vec<u8> describe = Vec::new();"
    "\n    Vec::push(&mut describe, b'P');\n    Vec::push(&mut describe, 0);\n    Vec::extend_from(&mut out,"
    " &frame(b'D', &describe));\n    Vec<u8> execute = Vec::new();\n    push_cstr(&mut execute, \"\");\n    Ve"
    "c::push_be<u32>(&mut execute, 0);\n    Vec::extend_from(&mut out, &frame(b'E', &execute));\n    Vec<u8"
    "> none = Vec::new();\n    Vec::extend_from(&mut out, &frame(b'S', &none));\n    match (pg_write(&mut c"
    ".reader.conn, &out))\n    {\n        Ok(_)  : {},\n        Err(e) : return Err(broken(c, e)),\n    }\n   "
    " collect(c, true, true)\n}export fn PgConnection::execute(\n    ref<PgConnection, exclusive> c,\n    St"
    "ringView sql,\n    slice<PgValue, shared> params,\n) : Result<u64, PgError>\n{\n    PgResult r = PgConne"
    "ction::query(c, sql, params)?;\n    Ok(r.affected)\n}export fn PgConnection::run_script(ref<PgConnecti"
    "on, exclusive> c, StringView sql) : Result<void, PgError>\n{\n    if (c.closed)\n    {\n        return E"
    "rr(Disconnected);\n    }\n    Vec<u8> q = Vec::new();\n    push_cstr(&mut q, sql);\n    match (pg_write("
    "&mut c.reader.conn, &frame(b'Q', &q)))\n    {\n        Ok(_)  : {},\n        Err(e) : return Err(broken"
    "(c, e)),\n    }\n    _ = collect(c, false, false)?;\n    Ok(())\n}export fn PgConnection::close(ref<PgCo"
    "nnection, exclusive> c)\n{\n    if (!c.closed)\n    {\n        Vec<u8> none = Vec::new();\n        _ = pg"
    "_write(&mut c.reader.conn, &frame(b'X', &none));\n        pg_close(&mut c.reader.conn);\n        c.clo"
    "sed = true;\n    }\n}fn JsonReader::peek(ref<JsonReader, shared> r) : u8\n{\n    if (r.at < StringView::"
    "len(r.text))\n    {\n        return r.text.bytes[r.at];\n    }\n    0\n}fn json_space_end(slice<u8, share"
    "d> b, usize at) : usize\n{\n    usize i = at;\n    while (i < slice_len(b) && (b[i] == b' ' || b[i] == "
    "b'\\t' || b[i] == b'\\n' || b[i] == b'\\r'))\n    {\n        i += 1;\n    }\n    i\n}fn json_digits_end(slic"
    "e<u8, shared> b, usize at) : usize\n{\n    usize i = at;\n    while (i < slice_len(b) && ascii_is_digit"
    "(b[i]))\n    {\n        i += 1;\n    }\n    i\n}fn JsonReader::skip_space(ref<JsonReader, exclusive> r)\n{"
    "\n    r.at = json_space_end(r.text.bytes, r.at);\n}fn JsonReader::digits(ref<JsonReader, exclusive> r)"
    " : usize\n{\n    usize start = r.at;\n    r.at = json_digits_end(r.text.bytes, r.at);\n    r.at - start\n"
    "}fn JsonReader::number(ref<JsonReader, exclusive> r) : Result<Json, ParseError>\n{\n    usize start = "
    "r.at;\n    if (JsonReader::peek(r) == b'-')\n    {\n        r.at += 1;\n    }\n    if (JsonReader::peek(r"
    ") == b'0')\n    {\n        r.at += 1;\n    }\n    else if (JsonReader::digits(r) == 0)\n    {\n        ret"
    "urn Err(Invalid(r.at));\n    }\n    if (JsonReader::peek(r) == b'.')\n    {\n        r.at += 1;\n        "
    "if (JsonReader::digits(r) == 0)\n        {\n            return Err(Invalid(r.at));\n        }\n    }\n   "
    " u8 e = JsonReader::peek(r);\n    if (e == b'e' || e == b'E')\n    {\n        r.at += 1;\n        u8 sig"
    "n = JsonReader::peek(r);\n        if (sign == b'+' || sign == b'-')\n        {\n            r.at += 1;\n"
    "        }\n        if (JsonReader::digits(r) == 0)\n        {\n            return Err(Invalid(r.at));\n "
    "       }\n    }\n    match (StringView::parse<f64>(&r.text[start..r.at]))\n    {\n        Ok(v)  : Ok(Js"
    "onNumber(v)),\n        Err(_) : Err(OutOfRange),\n    }\n}fn JsonReader::text(ref<JsonReader, exclusive"
    "> r) : Result<String, ParseError>\n{\n    JsonStr { bytes, pos, err } = json_string(r.text.bytes, r.at"
    ");\n    r.at = pos;\n    if (err > 0)\n    {\n        return Err(Invalid(err - 1));\n    }\n    // Runs of"
    " the (UTF-8) text and encoded code points: well-formed.\n    match (String::from_utf8(bytes))\n    {\n "
    "       Ok(s)  : Ok(s),\n        Err(_) : Err(Invalid(pos)),\n    }\n}fn json_hex4(array<u8, 4> q, usize"
    " at) : i64\n{\n    i64 v = 0;\n    for (usize i = 0; i < 4; i += 1)\n    {\n        usize p = at + i;\n   "
    "     u8 c = q[i];\n        i64 d = if (c >= b'0' && c <= b'9') { widen<i64>(c - b'0') }\n        else "
    "if (c >= b'a' && c <= b'f') { widen<i64>(c - b'a') + 10 }\n        else if (c >= b'A' && c <= b'F') {"
    " widen<i64>(c - b'A') + 10 }\n        else { return -1 - narrow<i64>(p); };\n        v = v * 16 + d;\n "
    "   }\n    v\n}fn json_string(slice<u8, shared> b, usize start) : JsonStr\n{\n    Vec<u8> out = Vec::new("
    ");\n    usize n = slice_len(b);\n    usize at = start;\n    usize err = 0;\n    while (true)\n    {\n     "
    "   if (at >= n)\n        {\n            err = n + 1;\n            break;\n        }\n        u8 c = b[at]"
    ";\n        if (c == b'\"')\n        {\n            at += 1;\n            break;\n        }\n        if (c <"
    " 0x20)\n        {\n            err = at + 1;\n            break;\n        }\n        if (c != b'\\\\')\n    "
    "    {\n            Vec::push(&mut out, c);\n            at += 1;\n            continue;\n        }\n     "
    "   at += 1;\n        u8 e = if (at < n) { b[at] } else { 0 };\n        at += 1;\n        if (e == b'\"')"
    " { Vec::push(&mut out, b'\"'); }\n        else if (e == b'\\\\') { Vec::push(&mut out, b'\\\\'); }\n       "
    " else if (e == b'/') { Vec::push(&mut out, b'/'); }\n        else if (e == b'b') { Vec::push(&mut out"
    ", 8); }\n        else if (e == b'f') { Vec::push(&mut out, 12); }\n        else if (e == b'n') { Vec::"
    "push(&mut out, 10); }\n        else if (e == b'r') { Vec::push(&mut out, 13); }\n        else if (e =="
    " b't') { Vec::push(&mut out, 9); }\n        else if (e == b'u')\n        {\n            array<u8, 4> q "
    "= [0; 4];\n            for (usize k = 0; k < 4 && at + k < n; k += 1)\n            {\n                q"
    "[k] = b[at + k];\n            }\n            i64 h = json_hex4(q, at);\n            if (h < 0)\n        "
    "    {\n                err = narrow<usize>(0 - h);\n                break;\n            }\n            a"
    "t += 4;\n            u32 cp = narrow<u32>(h);\n            if (cp >= 0xD800 && cp <= 0xDBFF)\n         "
    "   {\n                // A high surrogate: joined with a `\\uDC00`..`\\uDFFF` that\n                // f"
    "ollows; alone, U+FFFD.\n                usize save = at;\n                bool joined = false;\n       "
    "         if (at < n && b[at] == b'\\\\')\n                {\n                    at += 1;\n              "
    "      if (at < n && b[at] == b'u')\n                    {\n                        at += 1;\n          "
    "              array<u8, 4> q2 = [0; 4];\n                        for (usize k = 0; k < 4 && at + k < "
    "n; k += 1)\n                        {\n                            q2[k] = b[at + k];\n                "
    "        }\n                        i64 lo = json_hex4(q2, at);\n                        if (lo < 0)\n  "
    "                      {\n                            err = narrow<usize>(0 - lo);\n                   "
    "         break;\n                        }\n                        at += 4;\n                        u"
    "32 low = narrow<u32>(lo);\n                        if (low >= 0xDC00 && low <= 0xDFFF)\n              "
    "          {\n                            cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00);\n     "
