    "rees only its buffer\n}export fn Vec::insert<T>(ref<Vec<T>, exclusive> v, usize i, T x)\n    requires\n"
    "    {\n        i <= v.len, index_out_of_bounds;\n    }\n{\n    Vec::push(v, x);\n    usize k = v.len - 1;"
    "\n    while (k > i)\n    {\n        Vec::swap(v, k - 1, k);\n        k = k - 1;\n    }\n}unittest \"Vec::in"
