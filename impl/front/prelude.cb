export const str PRELUDE_BODIES =
    "fn byte_op(\n    usize which,\n    usize op,\n    usize h,\n    rawptr<u8> a,\n    usize an,\n    rawptr<u"
    "8> b,\n    usize bn,\n    rawptr<u8> out,\n    usize cap,\n) : i64\n{\n    unsafe\n    {\n        match (whi"
    "ch)\n        {\n            0 : path_op(op, h, a, an, b, bn, out, cap),\n            1 : proc_op(op, h,"
    " a, an, b, bn, out, cap),\n            _ : net_op(op, h, a, an, b, bn, out, cap),\n        }\n    }\n}fn"
    " byte_answer(usize which, usize op, usize h, slice<u8, shared> a, slice<u8, shared> b) : Result<Vec<"
    "u8>, i64>\n{\n    Vec<u8> out = Vec::new();\n    usize cap = 256;\n    while (true)\n    {\n        while "
    "(out.cap < cap)\n        {\n            Vec::grow(&mut out);\n        }\n        i64 n = byte_op(\n      "
    "      which,\n            op,\n            h,\n            bytes_ptr(a),\n            slice_len(a),\n    "
    "        bytes_ptr(b),\n            slice_len(b),\n            reinterpret_ptr<u8>(out.ptr),\n          "
    "  cap,\n        );\n        if (n < 0)\n        {\n            return Err(n);\n        }\n        usize le"
    "n = reinterpret<usize>(n);\n        if (len <= cap)\n        {\n            out.len = len;\n            "
    "return Ok(out);\n        }\n        cap = len;\n    }\n}fn bytes_ptr(slice<u8, shared> s) : rawptr<u8>\n{"
    "\n    if (slice_len(s) == 0)\n    {\n        return dangling<u8>();\n    }\n    rawptr_of(&s[0])\n}fn code"
    "_error(i64 code) : FileError\n{\n    if (code == -1)\n    {\n        return FileError::NotFound;\n    }\n "
    "   if (code == -2)\n    {\n        return FileError::Denied;\n    }\n    if (code == -5)\n    {\n        r"
    "eturn FileError::IsDirectory;\n    }\n    if (code == -6)\n    {\n        return FileError::NotDirectory"
    ";\n    }\n    if (code == -7)\n    {\n        return FileError::NoSpace;\n    }\n    if (code == -8)\n    {"
    "\n        return FileError::TooManyOpen;\n    }\n    FileError::Io\n}fn file_error(isize code) : FileErr"
    "or\n{\n    code_error(widen<i64>(code))\n}fn fs_answer(usize op, rawptr<u8> a, usize an) : Result<Vec<u"
    "8>, isize>\n{\n    Vec<u8> out = Vec::new();\n    usize cap = 256;\n    while (true)\n    {\n        while"
    " (out.cap < cap)\n        {\n            Vec::grow(&mut out);\n        }\n        isize n = unsafe\n     "
    "   {\n            fs_query(op, a, an, reinterpret_ptr<u8>(out.ptr), cap)\n        };\n        if (n < 0"
    ")\n        {\n            return Err(n);\n        }\n        usize len = reinterpret<usize>(n);\n        "
    "if (len <= cap)\n        {\n            out.len = len;\n            return Ok(out);\n        }\n        c"
    "ap = len;\n    }\n}fn path_text(StringView a, StringView b, usize op) : Option<String>\n{\n    match (by"
    "te_answer(0, op, 0, a.bytes, b.bytes))\n    {\n        Ok(v) : match (String::from_utf8(v))\n        {\n"
    "            Ok(s)  : Some(s),\n            Err(_) : None,\n        },\n        Err(_) : None,\n    }\n}fn"
    " path_result(usize op, StringView a, StringView b) : Result<i64, FileError>\n{\n    i64 r = byte_op(\n "
    "       0,\n        op,\n        0,\n        StringView::ptr(a),\n        StringView::len(a),\n        Str"
    "ingView::ptr(b),\n        StringView::len(b),\n        dangling<u8>(),\n        0,\n    );\n    if (r < 0"
    ")\n    {\n        return Err(code_error(r));\n    }\n    Ok(r)\n}export fn Option::unwrap_or<T>(Option<T>"
    " o, T d) : T\n{\n    match (o)\n    {\n        Some(v) : v,\n        None    : d,\n    }\n}export fn Option"
    "::ok_or<T, E>(Option<T> o, E e) : Result<T, E>\n{\n    match (o)\n    {\n        Some(v) : Ok(v),\n      "
    "  None    : Err(e),\n    }\n}unittest \"Option::ok_or: None becomes the error\"\n{\n    Option<i32> none ="
    " None;\n    Result<i32, u8> r = Option::ok_or(none, 7);\n    match (r)\n    {\n        Ok(_)  : assert(f"
    "alse),\n        Err(e) : assert(e == 7),\n    }\n    assert(Result::is_ok(&Option::ok_or(Some(5), 7)));"
    "\n}export fn Result::ok<T, E>(Result<T, E> r) : Option<T>\n{\n    match (r)\n    {\n        Ok(v)  : Some"
    "(v),\n        Err(_) : None,\n    }\n}unittest \"Result::ok: dropping the error\"\n{\n    Result<i32, u8> b"
    "ad = Err(4);\n    assert(Result::unwrap_or(bad, 0) == 0);\n    Result<i32, u8> good = Ok(9);\n    Optio"
    "n<i32> o = Result::ok(good);\n    assert(Option::is_some(&o) && Option::unwrap(o) == 9);\n}export fn R"
    "esult::unwrap_or<T, E>(Result<T, E> r, T d) : T\n{\n    match (r)\n    {\n        Ok(v)  : v,\n        Er"
    "r(_) : d,\n    }\n}export fn Option::unwrap<T>(Option<T> o) : T\n{\n    match (o)\n    {\n        Some(v) "
    ": v,\n        None    : fault(unwrap_failed, \"`Option::unwrap` found `None`\"),\n    }\n}export fn Optio"
    "n::expect<T>(Option<T> o, str message) : T\n{\n    match (o)\n    {\n        Some(v) : v,\n        None  "
    "  : fault(unwrap_failed, message),\n    }\n}export fn Result::unwrap<T, E>(Result<T, E> r) : T\n{\n    m"
    "atch (r)\n    {\n        Ok(v)  : v,\n        Err(_) : fault(unwrap_failed, \"`Result::unwrap` found `Er"
    "r`\"),\n    }\n}export fn Result::expect<T, E>(Result<T, E> r, str message) : T\n{\n    match (r)\n    {\n "
    "       Ok(v)  : v,\n        Err(_) : fault(unwrap_failed, message),\n    }\n}export fn Option::is_some<"
    "T>(ref<Option<T>, shared> o) : bool\n{\n    match (o)\n    {\n        Some(_) : true,\n        None    : "
    "false,\n    }\n}export fn Option::is_none<T>(ref<Option<T>, shared> o) : bool\n{\n    !Option::is_some(o"
    ")\n}export fn Result::is_ok<T, E>(ref<Result<T, E>, shared> r) : bool\n{\n    match (r)\n    {\n        O"
    "k(_)  : true,\n        Err(_) : false,\n    }\n}export fn Result::is_err<T, E>(ref<Result<T, E>, shared"
    "> r) : bool\n{\n    !Result::is_ok(r)\n}export fn swap<T>(ref<T, exclusive> a, ref<T, exclusive> b)\n{\n "
    "   swap_places(a, b);\n}export fn replace<T>(ref<T, exclusive> r, T v) : T\n{\n    auto old = v;\n    sw"
    "ap_places(r, &mut old);\n    old\n}unittest \"replace: the old value comes back\"\n{\n    i32 a = 1;\n    i"
    "32 old = replace(&mut a, 2);\n    assert(old == 1 && a == 2);\n    i32 b = 3;\n    swap(&mut a, &mut b)"
    ";\n    assert(a == 3 && b == 2);\n}export fn overwrite<T>(ref<T, exclusive> r, T v)\n{\n    drop(replace"
    "(r, v));\n}export fn Vec::new<T>() : Vec<T>\n{\n    Vec { .ptr = dangling<T>(), .len = 0, .cap = 0 }\n}e"
    "xport fn Vec::len<T>(ref<Vec<T>, shared> v) : usize\n{\n    v.len\n}export fn Vec::push<T>(ref<Vec<T>, "
    "exclusive> v, T x)\n{\n    if (v.len == v.cap)\n    {\n        Vec::grow(v);\n    }\n    unsafe\n    {\n    "
