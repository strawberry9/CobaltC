    "e`.\u{1f}\u{1f}export fn Param::new(StringView name, StringView value) : Param\n    in `std::http`\n\n    A param"
    "eter with a copy of `name` and of `value`.\n\u{1f}\u{1e}std::http\u{1f}find_param\u{1f}fn\u{1f}export fn find_param(slice<Para"
    "m, shared> params, StringView name) : Option<StringView> from params\u{1f}The value of the first paramete"
    "r named exactly `name`, or `None` when there is none.\u{1f}\u{1f}export fn find_param(slice<Param, shared> par"
    "ams, StringView name) : Option<StringView> from params\n    in `std::http`\n\n    The value of the firs"
    "t parameter named exactly `name`, or `None` when there is none.\n\n    The comparison is case-sensitiv"
    "e, unlike `find_header`'s.\n\u{1f}\u{1e}std::http\u{1f}form_decode\u{1f}fn\u{1f}export fn form_decode(StringView text) : Vec<P"
    "aram>\u{1f}The parameters of a query string (without its `?`) or of an `application/x-www-form-urlencoded"
    "` body.\u{1f}\u{1f}export fn form_decode(StringView text) : Vec<Param>\n    in `std::http`\n\n    The parameters "
    "of a query string (without its `?`) or of an `application/x-www-form-urlencoded` body.\n\n    The text"
    " is split into `name=value` pairs at `&` and `;`, and empty pairs are skipped. A pair without\n    `="
    "` has an empty value. Each name and value is read with `+` as a space and then percent-decoded; one\n"
    "    that is not UTF-8 after decoding, or holds a bad escape, is kept as given, so nothing is lost.\n\n"
    "    Example, \"form_decode: pairs, bare names and bad escapes\":\n        Vec<Param> ps = form_decode(\""
    "q=red+fish&flag&&n=%41;x=%zz\");\n        assert(Vec::len(&ps) == 4);\n        assert(Option::unwrap(fi"
    "nd_param(&ps, \"q\")) == \"red fish\");\n        assert(Option::unwrap(find_param(&ps, \"flag\")) == \"\");\n "
    "       assert(Option::unwrap(find_param(&ps, \"n\")) == \"A\");\n        assert(Option::unwrap(find_param"
    "(&ps, \"x\")) == \"%zz\");\n        assert(Option::is_none(&find_param(&ps, \"Q\")));\n\u{1f}\u{1e}std::http\u{1f}form_enco"
    "de\u{1f}fn\u{1f}export fn form_encode(slice<Param, shared> params) : String\u{1f}Encodes `params` as a query string"
    " or form body that `form_decode` reads back.\u{1f}\u{1f}export fn form_encode(slice<Param, shared> params) : S"
    "tring\n    in `std::http`\n\n    Encodes `params` as a query string or form body that `form_decode` rea"
    "ds back.\n\n    The pairs are `name=value`, joined by `&`, each name and value percent-encoded with a "
    "space as `+`.\n    There is no leading `?`.\n\n    Example, \"form_encode: spaces and reserved bytes\":\n "
    "       Vec<Param> ps = Vec::new();\n        Vec::push(&mut ps, Param::new(\"q\", \"a b&c\"));\n        Vec"
    "::push(&mut ps, Param::new(\"lang\", \"en\"));\n        String body = form_encode(&ps);\n        assert(bo"
    "dy == \"q=a+b%26c&lang=en\");\n        Vec<Param> back = form_decode(&body);\n        assert(back[0].val"
    "ue == \"a b&c\");\n\u{1f}\u{1e}std::http\u{1f}Url::query_pairs\u{1f}fn\u{1f}export fn Url::query_pairs(ref<Url, shared> u) : Vec"
