    "(h[4], e);\n    out[5] = wrapping_add(h[5], f);\n    out[6] = wrapping_add(h[6], g);\n    out[7] = wrap"
    "ping_add(h[7], hh);\n    out\n}fn sha512_absorb(Sha512 s, slice<u8, shared> data) : Sha512\n{\n    usize"
