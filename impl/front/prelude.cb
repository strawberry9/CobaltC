    "(&mut out, b'\"');\n    out\n}fn json_number(ref<String, exclusive> out, f64 x)\n{\n    if (!is_finite(x)"
    ")\n    {\n        String::append(out, \"null\");\n        return;\n    }\n    if (x == 0.0 && (reinterpret<"
    "u64>(x) >> 63) == 1)\n    {\n        String::append(out, \"-0.0\");   // the sign kept, which `0` would "
    "lose (report 221)\n        return;\n    }\n    if (x == trunc(x) && x < 9007199254740992.0 && x > -9007"
    "199254740992.0)\n    {\n        String::append(out, to_int<i64>(x));\n        return;\n    }\n    String:"
    ":append(out, x);\n}fn json_indent(ref<String, exclusive> out, usize depth)\n{\n    String::push_ascii(o"
    "ut, 10);\n    for (usize i = 0; i < depth; i += 1)\n    {\n        String::append(out, \"  \");\n    }\n}fn"
    " json_write(ref<String, exclusive> out, ref<Json, shared> j, bool indent, usize depth)\n{\n    match ("
    "j)\n    {\n        JsonNull            : String::append(out, \"null\"),\n        JsonBool(b)         : St"
    "ring::append(out, if (*b) { \"true\" } else { \"false\" }),\n        JsonNumber(x)       : json_number(ou"
    "t, *x),\n        JsonText(s)         : json_quote(out, s),\n        JsonArray(items)    :\n        {\n  "
    "          String::push_ascii(out, b'[');\n            for (usize i = 0; i < Vec::len(items); i += 1)\n"
    "            {\n                if (i > 0)\n                {\n                    String::push_ascii(ou"
    "t, b',');\n                }\n                if (indent)\n                {\n                    json_i"
    "ndent(out, depth + 1);\n                }\n                json_write(out, &items[i], indent, depth + "
    "1);\n            }\n            if (indent && Vec::len(items) > 0)\n            {\n                json_"
    "indent(out, depth);\n            }\n            String::push_ascii(out, b']');\n        },\n        Json"
    "Object(members) :\n        {\n            String::push_ascii(out, b'{');\n            for (usize i = 0;"
    " i < Vec::len(members); i += 1)\n            {\n                if (i > 0)\n                {\n         "
    "           String::push_ascii(out, b',');\n                }\n                if (indent)\n            "
    "    {\n                    json_indent(out, depth + 1);\n                }\n                json_quote("
    "out, &members[i].key);\n                String::append(out, if (indent) { \": \" } else { \":\" });\n     "
    "           json_write(out, &members[i].value, indent, depth + 1);\n            }\n            if (inde"
    "nt && Vec::len(members) > 0)\n            {\n                json_indent(out, depth);\n            }\n  "
    "          String::push_ascii(out, b'}');\n        },\n    }\n}export fn Json::text(ref<Json, shared> j)"
    " : String\n{\n    String out = String::new();\n    json_write(&mut out, j, false, 0);\n    out\n}export f"
    "n Json::pretty(ref<Json, shared> j) : String\n{\n    String out = String::new();\n    json_write(&mut o"
    "ut, j, true, 0);\n    out\n}unittest \"Json::pretty: the layout\"\n{\n    Json a = JsonArray(Vec::new());\n"
    "    Json::push(&mut a, JsonNull);\n    Json::push(&mut a, JsonText(\"x\"));\n    String p = Json::pretty"
    "(&a);\n    assert(p == \"[\\n  null,\\n  \\\"x\\\"\\n]\");\n}export fn Json::get(ref<Json, shared> j, StringVie"
    "w key) : Option<ref<Json, shared>> from j\n{\n    match (j)\n    {\n        JsonObject(members) :\n      "
    "  {\n            for (usize i = 0; i < Vec::len(members); i += 1)\n            {\n                if (m"
    "embers[i].key == key)\n                {\n                    return Some(&members[i].value);\n        "
    "        }\n            }\n            None\n        },\n        _                   : None,\n    }\n}unitt"
    "est \"Json::get: reading a document\"\n{\n    Json doc = Result::unwrap(Json::parse(\"{\\\"name\\\": \\\"ok\\\", "
    "\\\"n\\\": [1, 2.5]}\"));\n    assert(Option::unwrap(Json::as_text(Option::unwrap(Json::get(&doc, \"name\"))"
    ")) == \"ok\");\n    auto n = Option::unwrap(Json::get(&doc, \"n\"));\n    assert(Json::as_i64(Option::unwr"
    "ap(Json::at(n, 0))) == Some(1: i64));\n    assert(Json::as_i64(Option::unwrap(Json::at(n, 1))) == Non"
    "e);\n    assert(Option::is_none(&Json::get(&doc, \"missing\")));\n}export fn Json::at(ref<Json, shared> "
    "j, usize i) : Option<ref<Json, shared>>\n{\n    match (j)\n    {\n        JsonArray(items) : if (i < Vec"
    "::len(items)) { Some(&items[i]) } else { None },\n        _                : None,\n    }\n}export fn J"
    "son::lookup(ref<Json, shared> j, StringView path) : Option<ref<Json, shared>> from j\n{\n    // The pa"
    "rts are read where they are, by position: `path` is only\n    // searched, so the result holds none o"
    "f it (`from j`).\n    ref<Json, shared> cur = j;\n    usize n = StringView::len(path);\n    usize start"
    " = 0;\n    while (true)\n    {\n        usize end = match (StringView::find(&path[start..$], \".\"))\n    "
    "    {\n            Some(k) : start + k,\n            None    : n,\n        };\n        cur = match (cur)"
    "\n        {\n            JsonArray(_) : match (StringView::parse<usize>(&path[start..end]))\n          "
    "  {\n                Ok(k)  : Json::at(cur, k)?,\n                Err(_) : return None,\n            },"
    "\n            _ : Json::get(cur, &path[start..end])?,\n        };\n        if (end == n)\n        {\n    "
    "        break;\n        }\n        start = end + 1;\n    }\n    Some(cur)\n}unittest \"Json::lookup: a dot"
    "ted path\"\n{\n    Json doc = Result::unwrap(Json::parse(\"{\\\"servers\\\": [{\\\"host\\\": \\\"a\\\"}, {\\\"host\\\": "
    "\\\"b\\\"}], \\\"n\\\": 1}\"));\n    assert(Option::unwrap(Json::as_text(Option::unwrap(Json::lookup(&doc, \"se"
    "rvers.1.host\")))) == \"b\");\n    assert(Json::as_i64(Option::unwrap(Json::lookup(&doc, \"n\"))) == Some("
    "1: i64));\n    assert(Option::is_none(&Json::lookup(&doc, \"servers.2.host\")));\n    assert(Option::is_"
    "none(&Json::lookup(&doc, \"servers.x\")));\n}export fn Json::is_null(ref<Json, shared> j) : bool\n{\n    "
    "match (j)\n    {\n        JsonNull : true,\n        _        : false,\n    }\n}export fn Json::as_bool(re"
    "f<Json, shared> j) : Option<bool>\n{\n    match (j)\n    {\n        JsonBool(b) : Some(*b),\n        _   "
    "        : None,\n    }\n}export fn Json::as_f64(ref<Json, shared> j) : Option<f64>\n{\n    match (j)\n   "
    " {\n        JsonNumber(x) : Some(*x),\n        _             : None,\n    }\n}export fn Json::as_i64(ref"
    "<Json, shared> j) : Option<i64>\n{\n    match (j)\n    {\n        JsonNumber(x) : if (*x == trunc(*x) &&"
    " *x >= -9223372036854775808.0 && *x < 9223372036854775808.0) { Some(to_int<i64>(*x)) } else { None }"
    ",\n        _             : None,\n    }\n}export fn Json::as_text(ref<Json, shared> j) : Option<StringV"
    "iew>\n{\n    match (j)\n    {\n        JsonText(s) : Some(s),\n        _           : None,\n    }\n}export "
    "fn Json::as_array(ref<Json, shared> j) : Option<ref<Vec<Json>, shared>>\n{\n    match (j)\n    {\n      "
    "  JsonArray(items) : Some(items),\n        _                : None,\n    }\n}export fn Json::as_object("
    "ref<Json, shared> j) : Option<ref<Vec<JsonMember>, shared>>\n{\n    match (j)\n    {\n        JsonObject"
    "(members) : Some(members),\n        _                   : None,\n    }\n}export fn Json::set(ref<Json, "
    "exclusive> j, StringView key, Json v)\n{\n    match (j)\n    {\n        JsonObject(members) :\n        {\n"
    "            for (usize i = 0; i < Vec::len(members); i += 1)\n            {\n                if (membe"
    "rs[i].key == key)\n                {\n                    overwrite(&mut members[i].value, v);\n       "
    "             return;\n                }\n            }\n            Vec::push(members, JsonMember { .ke"
    "y = String::copy(key), .value = v });\n        },\n        _                   : assert(false, \"Json::"
    "set on a value that is not an object\"),\n    }\n}export fn Json::push_member(ref<Json, exclusive> j, S"
    "tringView key, Json v)\n{\n    match (j)\n    {\n        JsonObject(members) : Vec::push(members, JsonMe"
    "mber { .key = String::copy(key), .value = v }),\n        _                   : assert(false, \"Json::p"
    "ush_member on a value that is not an object\"),\n    }\n}export fn Json::key_index(ref<Json, shared> j)"
    " : HashMap<String, usize>\n{\n    HashMap<String, usize> at = HashMap::new();\n    match (j)\n    {\n    "
    "    JsonObject(members) :\n        {\n            for (usize i = 0; i < Vec::len(members); i += 1)\n   "
    "         {\n                if (!HashMap::contains_ref(&at, &members[i].key))\n                {\n     "
    "               _ = HashMap::insert(&mut at, String::clone(&members[i].key), i);\n                }\n  "
    "          }\n        },\n        _                   : {},\n    }\n    at\n}unittest \"Json::push_member a"
    "nd Json::key_index\"\n{\n    Json o = JsonObject(Vec::new());\n    for (usize i = 0; i < 1000; i += 1)\n "
    "   {\n        Json::push_member(&mut o, &sprintf(\"k%v\", i), JsonNumber(to_float<f64>(i)));\n    }\n    "
    "HashMap<String, usize> at = Json::key_index(&o);\n    ref<Vec<JsonMember>, shared> members = Option::"
    "unwrap(Json::as_object(&o));\n    usize k = *Option::unwrap(HashMap::get(&at, \"k777\"));\n    assert(Js"
    "on::as_f64(&members[k].value) == Some(777.0));\n}unittest \"Json::set: a key set twice\"\n{\n    Json doc"
    " = JsonObject(Vec::new());\n    Json::set(&mut doc, \"a\", JsonNumber(1.0));\n    Json::set(&mut doc, \"b"
    "\", JsonArray(Vec::new()));\n    Json::set(&mut doc, \"a\", JsonBool(true));\n    String t = Json::text(&"
    "doc);\n    assert(t == \"{\\\"a\\\":true,\\\"b\\\":[]}\");\n}export fn Json::push(ref<Json, exclusive> j, Json v"
    ")\n{\n    match (j)\n    {\n        JsonArray(items) : Vec::push(items, v),\n        _                : a"
    "ssert(false, \"Json::push on a value that is not an array\"),\n    }\n}export fn to_hex(slice<u8, shared"
    "> bytes) : String\n{\n    str digits = \"0123456789abcdef\";\n    Vec<u8> out = Vec::new();\n    Vec::rese"
    "rve(&mut out, slice_len(bytes) * 2);\n    for (usize i = 0; i < slice_len(bytes); i += 1)\n    {\n     "
    "   Vec::push(&mut out, str_byte(digits, widen<usize>(bytes[i] >> 4)));\n        Vec::push(&mut out, s"
    "tr_byte(digits, widen<usize>(bytes[i] & 15)));\n    }\n    String { .bytes = out }\n}fn hex_value(u8 b)"
    " : u8\n{\n    if (b >= b'0' && b <= b'9')\n    {\n        return b - b'0';\n    }\n    if (b >= b'a' && b "
    "<= b'f')\n    {\n        return b - b'a' + 10;\n    }\n    if (b >= b'A' && b <= b'F')\n    {\n        ret"
    "urn b - b'A' + 10;\n    }\n    255\n}export fn from_hex(StringView text) : Result<Vec<u8>, ParseError>\n"
    "{\n    hex_decode(text.bytes)\n}unittest \"from_hex: either case in, lowercase out\"\n{\n    Vec<u8> b = R"
    "esult::unwrap(from_hex(\"00FFa0\"));\n    assert(Vec::len(&b) == 3);\n    assert(b[1] == 255);\n    Strin"
    "g h = to_hex(&b);\n    assert(h == \"00ffa0\");\n    match (from_hex(\"abc\"))\n    {\n        Err(Invalid(i"
    ")) : assert(i == 3),\n        _               : assert(false),\n    }\n    // Report 287: no bytes roun"
    "d-trip.\n    assert(Vec::len(&Result::unwrap(from_hex(\"\"))) == 0);\n}fn hex_decode(slice<u8, shared> b"
    ") : Result<Vec<u8>, ParseError>\n{\n    usize n = slice_len(b);\n    Vec<u8> out = Vec::new();\n    Vec:"
    ":reserve(&mut out, n / 2);\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (hex_value(b[i]) =="
    " 255)\n        {\n            return Err(Invalid(i));\n        }\n    }\n    if (n % 2 != 0)\n    {\n      "
    "  return Err(Invalid(n));\n    }\n    for (usize i = 0; i < n; i += 2)\n    {\n        Vec::push(&mut ou"
    "t, (hex_value(b[i]) << 4) | hex_value(b[i + 1]));\n    }\n    Ok(out)\n}export fn base64_encode(slice<u"
    "8, shared> bytes) : String\n{\n    str alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxy"
    "z0123456789+/\";\n    Vec<u8> out = Vec::new();\n    usize n = slice_len(bytes);\n    Vec::reserve(&mut "
    "out, (n + 2) / 3 * 4);\n    usize i = 0;\n    while (i + 3 <= n)\n    {\n        u32 v = (widen<u32>(byt"
    "es[i]) << 16) | (widen<u32>(bytes[i + 1]) << 8) | widen<u32>(bytes[i + 2]);\n        Vec::push(&mut o"
    "ut, str_byte(alphabet, narrow<usize>((v >> 18) & 63)));\n        Vec::push(&mut out, str_byte(alphabe"
    "t, narrow<usize>((v >> 12) & 63)));\n        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v "
    ">> 6) & 63)));\n        Vec::push(&mut out, str_byte(alphabet, narrow<usize>(v & 63)));\n        i += "
    "3;\n    }\n    if (n - i == 1)\n    {\n        u32 v = widen<u32>(bytes[i]) << 16;\n        Vec::push(&mu"
    "t out, str_byte(alphabet, narrow<usize>((v >> 18) & 63)));\n        Vec::push(&mut out, str_byte(alph"
    "abet, narrow<usize>((v >> 12) & 63)));\n        Vec::push(&mut out, b'=');\n        Vec::push(&mut out"
    ", b'=');\n    }\n    else if (n - i == 2)\n    {\n        u32 v = (widen<u32>(bytes[i]) << 16) | (widen<"
    "u32>(bytes[i + 1]) << 8);\n        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 18) & 6"
    "3)));\n        Vec::push(&mut out, str_byte(alphabet, narrow<usize>((v >> 12) & 63)));\n        Vec::p"
    "ush(&mut out, str_byte(alphabet, narrow<usize>((v >> 6) & 63)));\n        Vec::push(&mut out, b'=');\n"
    "    }\n    String { .bytes = out }\n}fn base64_value(u8 b) : u8\n{\n    if (b >= b'A' && b <= b'Z')\n    "
    "{\n        return b - b'A';\n    }\n    if (b >= b'a' && b <= b'z')\n    {\n        return b - b'a' + 26;"
    "\n    }\n    if (b >= b'0' && b <= b'9')\n    {\n        return b - b'0' + 52;\n    }\n    if (b == b'+')\n"
    "    {\n        return 62;\n    }\n    if (b == b'/')\n    {\n        return 63;\n    }\n    255\n}export fn "
    "base64_decode(StringView text) : Result<Vec<u8>, ParseError>\n{\n    base64_decode_bytes(text.bytes)\n}"
    "unittest \"base64_decode: padding\"\n{\n    StringView text = \"hi!?\";\n    String e = base64_encode(Strin"
    "gView::as_bytes(text));\n    assert(e == \"aGkhPw==\");\n    Vec<u8> d = Result::unwrap(base64_decode(&e"
    "));\n    assert(Vec::len(&d) == 4);\n    match (base64_decode(\"aG=hPw==\"))\n    {\n        Err(Invalid(i"
    ")) : assert(i == 2),\n        _               : assert(false),\n    }\n    match (base64_decode(\"QR==\")"
    ")\n    {\n        Err(Invalid(i)) : assert(i == 1),\n        _               : assert(false),\n    }\n}fn"
    " base64_decode_bytes(slice<u8, shared> b) : Result<Vec<u8>, ParseError>\n{\n    usize n = slice_len(b)"
    ";\n    Vec<u8> out = Vec::new();\n    if (n == 0)\n    {\n        return Ok(Vec::new());\n    }\n    if (n"
    " % 4 != 0)\n    {\n        return Err(Invalid(n));\n    }\n    usize pad = 0;\n    if (b[n - 1] == b'=')\n"
    "    {\n        pad = 1;\n        if (b[n - 2] == b'=')\n        {\n            pad = 2;\n        }\n    }\n"
    "    Vec::reserve(&mut out, n / 4 * 3);\n    for (usize i = 0; i < n; i += 4)\n    {\n        u32 v = 0;"
    "\n        for (usize j = 0; j < 4; j += 1)\n        {\n            u8 c = b[i + j];\n            if (c ="
    "= b'=' && i + j >= n - pad)\n            {\n                v = v << 6;\n            }\n            else"
    "\n            {\n                u8 d = base64_value(c);\n                if (d == 255)\n               "
    " {\n                    return Err(Invalid(i + j));\n                }\n                v = (v << 6) | "
    "widen<u32>(d);\n            }\n        }\n        // D-0232: the bits padding leaves over are zero, as "
    "`base64_encode`\n        // writes them (RFC 4648 §3.5): one text for each byte string.\n        if ("
    "i + 4 == n && ((pad == 1 && (v & 0xff) != 0) || (pad == 2 && (v & 0xffff) != 0)))\n        {\n        "
    "    return Err(Invalid(n - 1 - pad));\n        }\n        Vec::push(&mut out, narrow_wrapping<u8>(v >>"
    " 16));\n        if (i + 4 < n || pad < 2)\n        {\n            Vec::push(&mut out, narrow_wrapping<u"
    "8>(v >> 8));\n        }\n        if (i + 4 < n || pad < 1)\n        {\n            Vec::push(&mut out, n"
    "arrow_wrapping<u8>(v));\n        }\n    }\n    Ok(out)\n}fn tnode_new(String key, u8 kind, Toml leaf) : "
    "TNode\n{\n    TNode { .key = key, .kind = kind, .leaf = leaf, .members = Vec::new(), .index = None }\n}"
    "fn tnode_find(ref<TNode, shared> n, StringView key) : Option<usize>\n{\n    match (&n.index)\n    {\n   "
    "     Some(ix) : return match (HashMap::get(ix, key))\n        {\n            Some(k) : Some(*k),\n     "
    "       None    : None,\n        },\n        None : {},\n    }\n    for (usize i = 0; i < Vec::len(&n.mem"
    "bers); i += 1)\n    {\n        if (n.members[i].key == key)\n        {\n            return Some(i);\n    "
    "    }\n    }\n    None\n}fn tnode_push(ref<TNode, exclusive> n, TNode m) : usize\n{\n    usize k = Vec::l"
    "en(&n.members);\n    match (&mut n.index)\n    {\n        Some(ix) :\n        {\n            _ = HashMap:"
    ":insert(ix, clone(&m.key), k);\n        },\n        None     : {},\n    }\n    Vec::push(&mut n.members,"
    " m);\n    if (k + 1 == TNODE_INDEX_AT)\n    {\n        HashMap<String, usize> ix = HashMap::new();\n    "
    "    for (usize i = 0; i < Vec::len(&n.members); i += 1)\n        {\n            _ = HashMap::insert(&m"
    "ut ix, clone(&n.members[i].key), i);\n        }\n        overwrite(&mut n.index, Some(ix));\n    }\n    "
    "k\n}fn tnode_define(ref<TNode, exclusive> n, ref<Vec<String>, shared> path, usize i, bool is_array) :"
    " bool\n{\n    StringView part = &path[i];\n    bool last = i + 1 == Vec::len(path);\n    usize k = match"
    " (tnode_find(n, part))\n    {\n        Some(k) : k,\n        None    :\n        {\n            if (last &"
    "& is_array)\n            {\n                TNode arr = tnode_new(String::copy(part), K_ARRAY, TomlBoo"
    "l(false));\n                Vec::push(&mut arr.members, tnode_new(String::new(), K_HEADER, TomlBool(f"
    "alse)));\n                _ = tnode_push(n, arr);\n                return true;\n            }\n        "
    "    u8 made = if (last) { K_HEADER } else { K_IMPLICIT };\n            usize at = tnode_push(n, tnode"
    "_new(String::copy(part), made, TomlBool(false)));\n            if (last)\n            {\n              "
    "  return true;\n            }\n            at\n        },\n    };\n    u8 kind = n.members[k].kind;\n    i"
    "f (kind == K_VALUE)\n    {\n        return false;\n    }\n    if (last)\n    {\n        if (is_array)\n    "
    "    {\n            if (kind != K_ARRAY)\n            {\n                return false;\n            }\n   "
    "         Vec::push(&mut n.members[k].members, tnode_new(String::new(), K_HEADER, TomlBool(false)));\n"
    "            return true;\n        }\n        if (kind != K_IMPLICIT)\n        {\n            return fals"
    "e;\n        }\n        n.members[k].kind = K_HEADER;\n        return true;\n    }\n    if (kind == K_ARRA"
    "Y)\n    {\n        usize e = Vec::len(&n.members[k].members) - 1;\n        return tnode_define(&mut n.m"
    "embers[k].members[e], path, i + 1, is_array);\n    }\n    tnode_define(&mut n.members[k], path, i + 1,"
    " is_array)\n}fn tnode_insert(\n    ref<TNode, exclusive> n,\n    ref<Vec<String>, shared> ctx,\n    usiz"
    "e ci,\n    ref<Vec<String>, shared> keys,\n    usize ki,\n    Toml v,\n) : bool\n{\n    if (ci < Vec::len("
    "ctx))\n    {\n        // Down the current table's path, made by its header.\n        usize k = match (t"
    "node_find(n, &ctx[ci]))\n        {\n            Some(k) : k,\n            None    : return false,\n     "
    "   };\n        if (n.members[k].kind == K_ARRAY)\n        {\n            usize e = Vec::len(&n.members["
    "k].members) - 1;\n            return tnode_insert(&mut n.members[k].members[e], ctx, ci + 1, keys, ki"
    ", v);\n        }\n        return tnode_insert(&mut n.members[k], ctx, ci + 1, keys, ki, v);\n    }\n    "
    "StringView part = &keys[ki];\n    bool last = ki + 1 == Vec::len(keys);\n    match (tnode_find(n, part"
    "))\n    {\n        Some(k) :\n        {\n            if (last)\n            {\n                return fals"
    "e;\n            }\n            u8 kind = n.members[k].kind;\n            if (kind != K_DOTTED && kind !"
    "= K_IMPLICIT)\n            {\n                return false;\n            }\n            n.members[k].kin"
    "d = K_DOTTED;\n            tnode_insert(&mut n.members[k], ctx, ci, keys, ki + 1, v)\n        },\n     "
    "   None    :\n        {\n            if (last)\n            {\n                _ = tnode_push(n, tnode_n"
    "ew(String::copy(part), K_VALUE, v));\n                return true;\n            }\n            usize k "
    "= tnode_push(n, tnode_new(String::copy(part), K_DOTTED, TomlBool(false)));\n            tnode_insert("
    "&mut n.members[k], ctx, ci, keys, ki + 1, v)\n        },\n    }\n}fn tnode_to_toml(TNode n) : Toml\n{\n  "
    "  TNode { key, kind, leaf, members, index } = n;\n    drop(key);\n    drop(index);\n    if (kind == K_V"
    "ALUE)\n    {\n        drop(members);\n        return leaf;\n    }\n    drop(leaf);\n    if (kind == K_ARRA"
    "Y)\n    {\n        Vec<Toml> items = Vec::new();\n        while (Some(m) = Vec::pop(&mut members))\n    "
    "    {\n            Vec::push(&mut items, tnode_to_toml(m));\n        }\n        Vec::reverse(&mut items"
    ");\n        return TomlArray(items);\n    }\n    Vec<TomlMember> out = Vec::new();\n    while (Some(m) ="
    " Vec::pop(&mut members))\n    {\n        String key = clone(&m.key);\n        Vec::push(&mut out, TomlM"
    "ember { .key = key, .value = tnode_to_toml(m) });\n    }\n    Vec::reverse(&mut out);\n    TomlTable(ou"
    "t)\n}fn TomlReader::peek(ref<TomlReader, shared> r) : u8\n{\n    if (r.at < StringView::len(r.text))\n  "
    "  {\n        return r.text.bytes[r.at];\n    }\n    0\n}fn TomlReader::peek_at(ref<TomlReader, shared> r"
    ", usize ahead) : u8\n{\n    if (r.at + ahead < StringView::len(r.text))\n    {\n        return r.text.by"
    "tes[r.at + ahead];\n    }\n    0\n}fn TomlReader::at_end(ref<TomlReader, shared> r) : bool\n{\n    r.at >"
    "= StringView::len(r.text)\n}fn TomlReader::skip_ws(ref<TomlReader, exclusive> r)\n{\n    while (true)\n "
    "   {\n        u8 c = TomlReader::peek(r);\n        if (c != b' ' && c != b'\\t')\n        {\n            "
    "return;\n        }\n        r.at += 1;\n    }\n}fn TomlReader::newline(ref<TomlReader, exclusive> r) : b"
    "ool\n{\n    u8 c = TomlReader::peek(r);\n    if (c == b'\\n')\n    {\n        r.at += 1;\n        return tr"
    "ue;\n    }\n    if (c == b'\\r' && TomlReader::peek_at(r, 1) == b'\\n')\n    {\n        r.at += 2;\n       "
    " return true;\n    }\n    false\n}fn TomlReader::comment(ref<TomlReader, exclusive> r) : Result<void, P"
    "arseError>\n{\n    r.at += 1;\n    while (!TomlReader::at_end(r))\n    {\n        u8 c = TomlReader::peek"
    "(r);\n        if (c == b'\\n' || (c == b'\\r' && TomlReader::peek_at(r, 1) == b'\\n'))\n        {\n       "
    "     return Ok(());\n        }\n        if ((c < 0x20 && c != b'\\t') || c == 0x7F)\n        {\n         "
    "   return Err(Invalid(r.at));\n        }\n        r.at += 1;\n    }\n    Ok(())\n}fn TomlReader::line_end"
    "(ref<TomlReader, exclusive> r) : Result<void, ParseError>\n{\n    TomlReader::skip_ws(r);\n    if (Toml"
    "Reader::peek(r) == b'#')\n    {\n        TomlReader::comment(r)?;\n    }\n    if (TomlReader::at_end(r) "
    "|| TomlReader::newline(r))\n    {\n        return Ok(());\n    }\n    Err(Invalid(r.at))\n}fn TomlReader:"
    ":skip_space_lines(ref<TomlReader, exclusive> r) : Result<void, ParseError>\n{\n    while (true)\n    {\n"
    "        TomlReader::skip_ws(r);\n        u8 c = TomlReader::peek(r);\n        if (c == b'#')\n        {"
    "\n            TomlReader::comment(r)?;\n            continue;\n        }\n        if (!TomlReader::newli"
    "ne(r))\n        {\n            return Ok(());\n        }\n    }\n}fn toml_is_bare(u8 c) : bool\n{\n    asci"
    "i_is_alnum(c) || c == b'_' || c == b'-'\n}fn toml_hex_digit(u8 c) : i64\n{\n    if (c >= b'0' && c <= b"
    "'9') { widen<i64>(c - b'0') }\n    else if (c >= b'a' && c <= b'f') { widen<i64>(c - b'a') + 10 }\n   "
    " else if (c >= b'A' && c <= b'F') { widen<i64>(c - b'A') + 10 }\n    else { -1 }\n}fn TomlReader::unic"
    "ode_escape(\n    ref<TomlReader, exclusive> r,\n    usize n,\n    ref<String, exclusive> out,\n) : Resul"
    "t<void, ParseError>\n{\n    i64 v = 0;\n    for (usize i = 0; i < n; i += 1)\n    {\n        i64 d = toml"
    "_hex_digit(TomlReader::peek(r));\n        if (d < 0)\n        {\n            return Err(Invalid(r.at));"
    "\n        }\n        v = v * 16 + d;\n        r.at += 1;\n    }\n    if ((v >= 0xD800 && v <= 0xDFFF) || "
    "v > 0x10FFFF)\n    {\n        return Err(Invalid(r.at - n));\n    }\n    String::push_code_point(out, na"
    "rrow<u32>(v));\n    Ok(())\n}fn TomlReader::basic(ref<TomlReader, exclusive> r, bool multi) : Result<S"
    "tring, ParseError>\n{\n    String out = String::new();\n    if (multi)\n    {\n        // A newline right"
    " after the opening delimiter is not part of the text.\n        TomlReader::newline(r);\n    }\n    whil"
    "e (true)\n    {\n        if (TomlReader::at_end(r))\n        {\n            return Err(Invalid(r.at));\n "
    "       }\n        u8 c = TomlReader::peek(r);\n        if (c == b'\"')\n        {\n            if (!multi"
    ")\n            {\n                r.at += 1;\n                return Ok(out);\n            }\n           "
    " // The closing `\"\"\"`, with up to two more quotes before it as text.\n            usize run = 0;\n    "
    "        while (TomlReader::peek_at(r, run) == b'\"')\n            {\n                run += 1;\n        "
    "    }\n            if (run < 3)\n            {\n                for (usize i = 0; i < run; i += 1)\n    "
    "            {\n                    String::push_ascii(&mut out, b'\"');\n                }\n            "
    "    r.at += run;\n                continue;\n            }\n            if (run > 5)\n            {\n    "
    "            return Err(Invalid(r.at + 5));\n            }\n            for (usize i = 3; i < run; i +="
    " 1)\n            {\n                String::push_ascii(&mut out, b'\"');\n            }\n            r.at"
    " += run;\n            return Ok(out);\n        }\n        if (c == b'\\\\')\n        {\n            r.at +="
    " 1;\n            u8 e = TomlReader::peek(r);\n            if (e == b'\"') { String::push_ascii(&mut out"
    ", b'\"'); }\n            else if (e == b'\\\\') { String::push_ascii(&mut out, b'\\\\'); }\n            els"
    "e if (e == b'b') { String::push_ascii(&mut out, 8); }\n            else if (e == b't') { String::push"
    "_ascii(&mut out, 9); }\n            else if (e == b'n') { String::push_ascii(&mut out, 10); }\n       "
    "     else if (e == b'f') { String::push_ascii(&mut out, 12); }\n            else if (e == b'r') { Str"
    "ing::push_ascii(&mut out, 13); }\n            else if (e == b'u' || e == b'U')\n            {\n        "
    "        r.at += 1;\n                // Bound first: an `if` argument beside the `ref` to the reader\n "
    "               // made every program that calls `Toml::parse` keep run-time\n                // track"
    "ing (report 174).\n                usize digits = if (e == b'u') { 4 } else { 8 };\n                To"
    "mlReader::unicode_escape(r, digits, &mut out)?;\n                continue;\n            }\n            "
    "else if (multi && (e == b' ' || e == b'\\t' || e == b'\\n' || e == b'\\r'))\n            {\n             "
    "   // A line-ending backslash: the whitespace and newlines up to\n                // the next text ar"
    "e dropped; a newline must be among them.\n                usize save = r.at;\n                TomlRead"
    "er::skip_ws(r);\n                if (!TomlReader::newline(r))\n                {\n                    r"
    "eturn Err(Invalid(save));\n                }\n                while (true)\n                {\n         "
    "           TomlReader::skip_ws(r);\n                    if (!TomlReader::newline(r))\n                "
    "    {\n                        break;\n                    }\n                }\n                continu"
    "e;\n            }\n            else\n            {\n                return Err(Invalid(r.at));\n         "
    "   }\n            r.at += 1;\n            continue;\n        }\n        if (c == b'\\n' || c == b'\\r')\n  "
    "      {\n            if (!multi)\n            {\n                return Err(Invalid(r.at));\n           "
    " }\n            if (c == b'\\r')\n            {\n                if (TomlReader::peek_at(r, 1) != b'\\n')"
    "\n                {\n                    return Err(Invalid(r.at));\n                }\n                "
    "String::push_ascii(&mut out, b'\\r');\n                r.at += 1;\n            }\n            String::pu"
    "sh_ascii(&mut out, b'\\n');\n            r.at += 1;\n            continue;\n        }\n        if ((c < 0"
    "x20 && c != b'\\t') || c == 0x7F)\n        {\n            return Err(Invalid(r.at));\n        }\n        "
    "// Any other byte, of a multi-byte character too: the text is UTF-8\n        // and every byte the fo"
    "rmat treats apart is ASCII, so a character's\n        // bytes are copied whole.\n        Vec::push(&m"
    "ut out.bytes, c);\n        r.at += 1;\n    }\n}fn TomlReader::literal(ref<TomlReader, exclusive> r, boo"
    "l multi) : Result<String, ParseError>\n{\n    String out = String::new();\n    if (multi)\n    {\n       "
    " TomlReader::newline(r);\n    }\n    while (true)\n    {\n        if (TomlReader::at_end(r))\n        {\n "
    "           return Err(Invalid(r.at));\n        }\n        u8 c = TomlReader::peek(r);\n        if (c =="
    " b'\\'')\n        {\n            if (!multi)\n            {\n                r.at += 1;\n                r"
    "eturn Ok(out);\n            }\n            usize run = 0;\n            while (TomlReader::peek_at(r, ru"
    "n) == b'\\'')\n            {\n                run += 1;\n            }\n            if (run < 3)\n        "
    "    {\n                for (usize i = 0; i < run; i += 1)\n                {\n                    Strin"
    "g::push_ascii(&mut out, b'\\'');\n                }\n                r.at += run;\n                conti"
    "nue;\n            }\n            if (run > 5)\n            {\n                return Err(Invalid(r.at + "
    "5));\n            }\n            for (usize i = 3; i < run; i += 1)\n            {\n                Stri"
    "ng::push_ascii(&mut out, b'\\'');\n            }\n            r.at += run;\n            return Ok(out);\n"
    "        }\n        if (c == b'\\n' || c == b'\\r')\n        {\n            if (!multi)\n            {\n    "
    "            return Err(Invalid(r.at));\n            }\n            if (c == b'\\r')\n            {\n     "
    "           if (TomlReader::peek_at(r, 1) != b'\\n')\n                {\n                    return Err("
    "Invalid(r.at));\n                }\n                String::push_ascii(&mut out, b'\\r');\n             "
    "   r.at += 1;\n            }\n            String::push_ascii(&mut out, b'\\n');\n            r.at += 1;\n"
    "            continue;\n        }\n        if ((c < 0x20 && c != b'\\t') || c == 0x7F)\n        {\n       "
    "     return Err(Invalid(r.at));\n        }\n        // Any other byte, of a multi-byte character too: "
    "the text is UTF-8\n        // and every byte the format treats apart is ASCII, so a character's\n     "
    "   // bytes are copied whole.\n        Vec::push(&mut out.bytes, c);\n        r.at += 1;\n    }\n}fn Tom"
    "lReader::key_part(ref<TomlReader, exclusive> r) : Result<String, ParseError>\n{\n    u8 c = TomlReader"
    "::peek(r);\n    if (c == b'\"')\n    {\n        r.at += 1;\n        if (TomlReader::peek(r) == b'\"' && To"
    "mlReader::peek_at(r, 1) == b'\"')\n        {\n            return Err(Invalid(r.at));\n        }\n        "
    "return TomlReader::basic(r, false);\n    }\n    if (c == b'\\'')\n    {\n        r.at += 1;\n        if (T"
    "omlReader::peek(r) == b'\\'' && TomlReader::peek_at(r, 1) == b'\\'')\n        {\n            return Err("
    "Invalid(r.at));\n        }\n        return TomlReader::literal(r, false);\n    }\n    usize start = r.at"
    ";\n    while (toml_is_bare(TomlReader::peek(r)))\n    {\n        r.at += 1;\n    }\n    if (r.at == start"
    ")\n    {\n        return Err(Invalid(r.at));\n    }\n    Ok(String::copy(&r.text[start..r.at]))\n}fn Toml"
    "Reader::key(ref<TomlReader, exclusive> r) : Result<Vec<String>, ParseError>\n{\n    Vec<String> parts "
    "= Vec::new();\n    while (true)\n    {\n        Vec::push(&mut parts, TomlReader::key_part(r)?);\n      "
    "  TomlReader::skip_ws(r);\n        if (TomlReader::peek(r) != b'.')\n        {\n            return Ok(p"
    "arts);\n        }\n        r.at += 1;\n        TomlReader::skip_ws(r);\n    }\n}fn TomlReader::digits(ref"
    "<TomlReader, exclusive> r, ref<String, exclusive> out) : Result<usize, ParseError>\n{\n    usize count"
    " = 0;\n    while (true)\n    {\n        u8 c = TomlReader::peek(r);\n        if (ascii_is_digit(c))\n    "
    "    {\n            String::push_ascii(out, c);\n            count += 1;\n            r.at += 1;\n       "
    "     continue;\n        }\n        if (c == b'_' && count > 0 && ascii_is_digit(TomlReader::peek_at(r,"
    " 1)))\n        {\n            r.at += 1;\n            continue;\n        }\n        if (c == b'_')\n      "
    "  {\n            return Err(Invalid(r.at));\n        }\n        return Ok(count);\n    }\n}fn TomlReader:"
    ":prefixed(ref<TomlReader, exclusive> r, i64 base) : Result<Toml, ParseError>\n{\n    i64 v = 0;\n    us"
    "ize count = 0;\n    while (true)\n    {\n        u8 c = TomlReader::peek(r);\n        i64 d = toml_hex_d"
    "igit(c);\n        if (d >= 0 && d < base)\n        {\n            match (checked_mul(v, base))\n        "
    "    {\n                Some(m) : match (checked_add(m, d))\n                {\n                    Some"
    "(s) : v = s,\n                    None    : return Err(OutOfRange),\n                },\n              "
    "  None : return Err(OutOfRange),\n            }\n            count += 1;\n            r.at += 1;\n      "
    "      continue;\n        }\n        if (c == b'_' && count > 0)\n        {\n            i64 next = toml_"
    "hex_digit(TomlReader::peek_at(r, 1));\n            if (next >= 0 && next < base)\n            {\n      "
    "          r.at += 1;\n                continue;\n            }\n        }\n        if (count == 0 || c ="
    "= b'_')\n        {\n            return Err(Invalid(r.at));\n        }\n        return Ok(TomlInteger(v))"
    ";\n    }\n}fn TomlReader::number(ref<TomlReader, exclusive> r) : Result<Toml, ParseError>\n{\n    String"
    " text = String::new();\n    u8 c = TomlReader::peek(r);\n    bool negative = false;\n    bool signed = "
    "false;\n    if (c == b'+' || c == b'-')\n    {\n        negative = c == b'-';\n        signed = true;\n  "
    "      if (negative)\n        {\n            String::push_ascii(&mut text, b'-');\n        }\n        r.a"
    "t += 1;\n        c = TomlReader::peek(r);\n    }\n    if (c == b'i' || c == b'n')\n    {\n        bool in"
    "f = TomlReader::word(r, \"inf\");\n        if (!inf && !TomlReader::word(r, \"nan\"))\n        {\n         "
    "   return Err(Invalid(r.at));\n        }\n        f64 x = if (inf) { 1.0 / 0.0 } else { 0.0 / 0.0 };\n "
    "       return Ok(TomlFloat(if (negative) { 0.0 - x } else { x }));\n    }\n    if (c == b'0' && !signe"
    "d)\n    {\n        u8 p = TomlReader::peek_at(r, 1);\n        if (p == b'x' || p == b'o' || p == b'b')\n"
    "        {\n            r.at += 2;\n            i64 base = if (p == b'x') { 16 } else if (p == b'o') { "
    "8 } else { 2 };   // bound first, as in `basic`\n            return TomlReader::prefixed(r, base);\n  "
    "      }\n    }\n    usize start = r.at;\n    usize n = TomlReader::digits(r, &mut text)?;\n    if (n == "
    "0)\n    {\n        return Err(Invalid(r.at));\n    }\n    if (n > 1 && r.text.bytes[start] == b'0')\n    "
    "{\n        return Err(Invalid(start + 1));\n    }\n    bool float = false;\n    if (TomlReader::peek(r) "
    "== b'.')\n    {\n        float = true;\n        String::push_ascii(&mut text, b'.');\n        r.at += 1;"
    "\n        if (!ascii_is_digit(TomlReader::peek(r)))\n        {\n            return Err(Invalid(r.at));\n"
    "        }\n        TomlReader::digits(r, &mut text)?;\n    }\n    c = TomlReader::peek(r);\n    if (c =="
    " b'e' || c == b'E')\n    {\n        float = true;\n        String::push_ascii(&mut text, b'e');\n       "
    " r.at += 1;\n        c = TomlReader::peek(r);\n        if (c == b'+' || c == b'-')\n        {\n         "
    "   String::push_ascii(&mut text, c);\n            r.at += 1;\n        }\n        if (!ascii_is_digit(To"
    "mlReader::peek(r)))\n        {\n            return Err(Invalid(r.at));\n        }\n        TomlReader::d"
    "igits(r, &mut text)?;\n    }\n    if (float)\n    {\n        return match (StringView::parse<f64>(&text)"
    ")\n        {\n            Ok(x)  : Ok(TomlFloat(x)),\n            Err(_) : Err(OutOfRange),\n        };\n"
    "    }\n    match (StringView::parse<i64>(&text))\n    {\n        Ok(i)  : Ok(TomlInteger(i)),\n        E"
    "rr(_) : Err(OutOfRange),\n    }\n}fn TomlReader::fixed(ref<TomlReader, exclusive> r, usize n) : i64\n{\n"
    "    i64 v = 0;\n    for (usize i = 0; i < n; i += 1)\n    {\n        u8 c = TomlReader::peek_at(r, i);\n"
    "        if (!ascii_is_digit(c))\n        {\n            return -1;\n        }\n        v = v * 10 + wide"
    "n<i64>(c - b'0');\n    }\n    r.at += n;\n    v\n}fn toml_days_in_month(i64 year, i64 month) : i64\n{\n   "
    " if (month == 2)\n    {\n        bool leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;\n  "
    "      return if (leap) { 29 } else { 28 };\n    }\n    if (month == 4 || month == 6 || month == 9 || m"
    "onth == 11) { 30 } else { 31 }\n}fn TomlReader::time_part(ref<TomlReader, exclusive> r, ref<TomlDateT"
    "ime, exclusive> d) : Result<void, ParseError>\n{\n    usize at = r.at;\n    i64 hour = TomlReader::fixe"
    "d(r, 2);\n    if (hour < 0 || TomlReader::peek(r) != b':')\n    {\n        return Err(Invalid(r.at));\n "
    "   }\n    r.at += 1;\n    i64 minute = TomlReader::fixed(r, 2);\n    if (minute < 0 || TomlReader::peek"
    "(r) != b':')\n    {\n        return Err(Invalid(r.at));\n    }\n    r.at += 1;\n    i64 second = TomlRead"
    "er::fixed(r, 2);\n    if (second < 0)\n    {\n        return Err(Invalid(r.at));\n    }\n    if (hour > 2"
    "3 || minute > 59 || second > 60)\n    {\n        r.why = TOML_RANGE;\n        return Err(Invalid(at));\n"
    "    }\n    d.hour = narrow<u8>(hour);\n    d.minute = narrow<u8>(minute);\n    d.second = narrow<u8>(se"
    "cond);\n    if (TomlReader::peek(r) == b'.')\n    {\n        r.at += 1;\n        if (!ascii_is_digit(Tom"
    "lReader::peek(r)))\n        {\n            return Err(Invalid(r.at));\n        }\n        u32 nanos = 0;"
    "\n        usize digits = 0;\n        while (ascii_is_digit(TomlReader::peek(r)))\n        {\n           "
    " if (digits < 9)\n            {\n                nanos = nanos * 10 + widen<u32>(TomlReader::peek(r) -"
    " b'0');\n            }\n            digits += 1;\n            r.at += 1;\n        }\n        while (digit"
    "s < 9)\n        {\n            nanos = nanos * 10;\n            digits += 1;\n        }\n        d.nanose"
    "conds = nanos;\n    }\n    Ok(())\n}fn TomlReader::datetime(ref<TomlReader, exclusive> r, bool has_date"
    ") : Result<Toml, ParseError>\n{\n    TomlDateTime d = TomlDateTime {\n        .kind = TomlLocalTime,\n  "
    "      .year = 0,\n        .month = 0,\n        .day = 0,\n        .hour = 0,\n        .minute = 0,\n     "
    "   .second = 0,\n        .nanoseconds = 0,\n        .offset_minutes = 0,\n    };\n    if (!has_date)\n   "
    " {\n        TomlReader::time_part(r, &mut d)?;\n        return Ok(TomlDateTime(d));\n    }\n    usize st"
    "art = r.at;\n    i64 year = TomlReader::fixed(r, 4);\n    if (year < 0 || TomlReader::peek(r) != b'-')"
    "\n    {\n        return Err(Invalid(r.at));\n    }\n    r.at += 1;\n    i64 month = TomlReader::fixed(r, "
    "2);\n    if (month < 0 || TomlReader::peek(r) != b'-')\n    {\n        return Err(Invalid(r.at));\n    }"
    "\n    r.at += 1;\n    i64 day = TomlReader::fixed(r, 2);\n    if (day < 0)\n    {\n        return Err(Inv"
    "alid(r.at));\n    }\n    if (month < 1 || month > 12 || day < 1 || day > toml_days_in_month(year, mont"
    "h))\n    {\n        r.why = TOML_RANGE;\n        return Err(Invalid(start));\n    }\n    d.year = year;\n "
    "   d.month = narrow<u8>(month);\n    d.day = narrow<u8>(day);\n    d.kind = TomlLocalDate;\n    u8 c = "
    "TomlReader::peek(r);\n    if (c == b'T' || c == b't' || (c == b' ' && ascii_is_digit(TomlReader::peek"
    "_at(r, 1))))\n    {\n        r.at += 1;\n        TomlReader::time_part(r, &mut d)?;\n        d.kind = To"
    "mlLocalDateTime;\n        c = TomlReader::peek(r);\n        if (c == b'Z' || c == b'z')\n        {\n    "
    "        r.at += 1;\n            d.kind = TomlOffsetDateTime;\n        }\n        else if (c == b'+' || "
    "c == b'-')\n        {\n            usize at = r.at;\n            r.at += 1;\n            i64 oh = TomlRe"
    "ader::fixed(r, 2);\n            if (oh < 0 || TomlReader::peek(r) != b':')\n            {\n            "
    "    return Err(Invalid(r.at));\n            }\n            r.at += 1;\n            i64 om = TomlReader:"
    ":fixed(r, 2);\n            if (om < 0)\n            {\n                return Err(Invalid(r.at));\n     "
    "       }\n            if (oh > 23 || om > 59)\n            {\n                r.why = TOML_RANGE;\n     "
    "           return Err(Invalid(at));\n            }\n            i64 minutes = oh * 60 + om;\n          "
    "  d.offset_minutes = narrow<i32>(if (c == b'-') { 0 - minutes } else { minutes });\n            d.kin"
    "d = TomlOffsetDateTime;\n        }\n    }\n    Ok(TomlDateTime(d))\n}fn TomlReader::date_ahead(ref<TomlR"
    "eader, shared> r) : bool\n{\n    for (usize i = 0; i < 4; i += 1)\n    {\n        if (!ascii_is_digit(To"
    "mlReader::peek_at(r, i)))\n        {\n            return false;\n        }\n    }\n    TomlReader::peek_a"
    "t(r, 4) == b'-'\n}fn TomlReader::time_ahead(ref<TomlReader, shared> r) : bool\n{\n    ascii_is_digit(To"
    "mlReader::peek(r)) && ascii_is_digit(TomlReader::peek_at(\n        r,\n        1,\n    )) && TomlReader"
    "::peek_at(r, 2) == b':'\n}fn TomlReader::word(ref<TomlReader, exclusive> r, str word) : bool\n{\n    us"
    "ize n = str_len(word);\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (TomlReader::peek_at(r,"
    " i) != str_byte(word, i))\n        {\n            return false;\n        }\n    }\n    r.at += n;\n    tru"
    "e\n}fn TomlReader::inline_table(ref<TomlReader, exclusive> r, usize depth) : Result<Toml, ParseError>"
    "\n{\n    TNode table = tnode_new(String::new(), K_HEADER, TomlBool(false));\n    Vec<String> ctx = Vec:"
    ":new();\n    TomlReader::skip_ws(r);\n    if (TomlReader::peek(r) == b'}')\n    {\n        r.at += 1;\n  "
    "      return Ok(tnode_to_toml(table));\n    }\n    while (true)\n    {\n        TomlReader::skip_ws(r);\n"
    "        usize key_at = r.at;\n        Vec<String> keys = TomlReader::key(r)?;\n        if (TomlReader:"
    ":peek(r) != b'=')\n        {\n            return Err(Invalid(r.at));\n        }\n        r.at += 1;\n    "
    "    TomlReader::skip_ws(r);\n        // Each part of a dotted key is a table one level deeper (report"
    " 218).\n        usize below = depth + Vec::len(&keys);\n        if (below > TOML_MAX_DEPTH)\n        {\n"
    "            return Err(OutOfRange);\n        }\n        Toml v = TomlReader::value(r, below)?;\n       "
    " if (!tnode_insert(&mut table, &ctx, 0, &keys, 0, v))\n        {\n            r.why = TOML_TWICE;\n    "
    "        return Err(Invalid(key_at));\n        }\n        TomlReader::skip_ws(r);\n        u8 c = TomlRe"
    "ader::peek(r);\n        r.at += 1;\n        if (c == b'}')\n        {\n            return Ok(tnode_to_to"
    "ml(table));\n        }\n        if (c != b',')\n        {\n            return Err(Invalid(r.at - 1));\n  "
    "      }\n    }\n}fn TomlReader::array_value(ref<TomlReader, exclusive> r, usize depth) : Result<Toml, "
    "ParseError>\n{\n    Vec<Toml> items = Vec::new();\n    while (true)\n    {\n        TomlReader::skip_spac"
    "e_lines(r)?;\n        if (TomlReader::peek(r) == b']')\n        {\n            r.at += 1;\n            r"
    "eturn Ok(TomlArray(items));\n        }\n        Toml v = TomlReader::value(r, depth + 1)?;\n        Vec"
    "::push(&mut items, v);\n        TomlReader::skip_space_lines(r)?;\n        u8 c = TomlReader::peek(r);"
    "\n        if (c == b']')\n        {\n            r.at += 1;\n            return Ok(TomlArray(items));\n  "
    "      }\n        if (c != b',')\n        {\n            return Err(Invalid(r.at));\n        }\n        r."
    "at += 1;\n    }\n}fn TomlReader::value(ref<TomlReader, exclusive> r, usize depth) : Result<Toml, Parse"
    "Error>\n{\n    u8 c = TomlReader::peek(r);\n    if (c == b'\"')\n    {\n        r.at += 1;\n        if (Tom"
    "lReader::peek(r) == b'\"' && TomlReader::peek_at(r, 1) == b'\"')\n        {\n            r.at += 2;\n    "
    "        return Ok(TomlString(TomlReader::basic(r, true)?));\n        }\n        return Ok(TomlString(T"
    "omlReader::basic(r, false)?));\n    }\n    if (c == b'\\'')\n    {\n        r.at += 1;\n        if (TomlRe"
    "ader::peek(r) == b'\\'' && TomlReader::peek_at(r, 1) == b'\\'')\n        {\n            r.at += 2;\n     "
    "       return Ok(TomlString(TomlReader::literal(r, true)?));\n        }\n        return Ok(TomlString("
    "TomlReader::literal(r, false)?));\n    }\n    if (c == b'[' || c == b'{')\n    {\n        if (depth >= T"
    "OML_MAX_DEPTH)\n        {\n            return Err(OutOfRange);\n        }\n        r.at += 1;\n        re"
    "turn if (c == b'[') { TomlReader::array_value(r, depth) } else { TomlReader::inline_table(r, depth) "
    "};\n    }\n    if (TomlReader::word(r, \"true\"))\n    {\n        return Ok(TomlBool(true));\n    }\n    if "
    "(TomlReader::word(r, \"false\"))\n    {\n        return Ok(TomlBool(false));\n    }\n    if (TomlReader::d"
    "ate_ahead(r))\n    {\n        return TomlReader::datetime(r, true);\n    }\n    if (TomlReader::time_ahe"
    "ad(r))\n    {\n        return TomlReader::datetime(r, false);\n    }\n    if (c == b'+' || c == b'-' || "
    "c == b'i' || c == b'n' || ascii_is_digit(c))\n    {\n        return TomlReader::number(r);\n    }\n    E"
    "rr(Invalid(r.at))\n}export fn Toml::parse(StringView text) : Result<Toml, ParseError>\n{\n    TomlReade"
    "r r = TomlReader { .text = text, .at = 0, .why = 0 };\n    Toml::read(&mut r)\n}export fn Toml::descri"
    "be_error(ref<ParseError, shared> e, StringView text) : String\n{\n    TomlReader r = TomlReader { .tex"
    "t = text, .at = 0, .why = 0 };\n    usize k = match (Toml::read(&mut r))\n    {\n        Err(Invalid(k)"
    ") : k,\n        _               : return ParseError::describe(e, text),\n    };\n    match (e)\n    {\n  "
    "      Invalid(i) : if (*i != k || r.why == 0)\n        {\n            return ParseError::describe(e, t"
    "ext);\n        },\n        _ : return ParseError::describe(e, text),\n    }\n    // The line and column "
    "`describe` gives, without its \"unexpected …\".\n    String place = ParseError::describe(e, text);\n  "
    "  usize cut = match (StringView::find(&place, \": \"))\n    {\n        Some(c) : c,\n        None    : St"
    "ringView::len(&place),\n    };\n    String::truncate(&mut place, cut);\n    // The key, or the date, as"
    " written: up to `=`, `]`, a space outside\n    // quotes, `,`, `}` or the line's end.\n    usize n = S"
    "tringView::len(text);\n    usize end = k;\n    bool quoted = false;\n    while (end < n)\n    {\n        "
    "u8 b = text.bytes[end];\n        if (b == b'\"' || b == b'\\'')\n        {\n            quoted = !quoted;"
    "\n        }\n        else if (!quoted && (b == b'=' || b == b']' || b == b',' || b == b'}' || b == b'\\"
    "n' || b == b'\\r' || b == b'#'))\n        {\n            break;\n        }\n        end += 1;\n    }\n    w"
    "hile (end > k && (text.bytes[end - 1] == b' ' || text.bytes[end - 1] == b'\\t'))\n    {\n        end -="
    " 1;\n    }\n    String what = match (StringView::from_utf8(&text.bytes[k..end]))\n    {\n        Ok(w)  "
    ": String::copy(w),\n        Err(_) : String::new(),\n    };\n    if (r.why == TOML_TWICE)\n    {\n       "
    " sprintf(\"%s: %s is defined twice\", &place, &what)\n    }\n    else\n    {\n        sprintf(\"%s: %s is n"
    "ot a date or time (a field beyond its range)\", &place, &what)\n    }\n}fn Toml::read(ref<TomlReader, e"
    "xclusive> r) : Result<Toml, ParseError>\n{\n    TNode root = tnode_new(String::new(), K_HEADER, TomlBo"
    "ol(false));\n    Vec<String> ctx = Vec::new();\n    while (true)\n    {\n        TomlReader::skip_ws(r);"
    "\n        if (TomlReader::at_end(r))\n        {\n            break;\n        }\n        u8 c = TomlReader"
    "::peek(r);\n        if (c == b'#')\n        {\n            TomlReader::comment(r)?;\n            continu"
    "e;\n        }\n        if (TomlReader::newline(r))\n        {\n            continue;\n        }\n        i"
    "f (c == b'[')\n        {\n            r.at += 1;\n            bool is_array = TomlReader::peek(r) == b'"
    "[';\n            if (is_array)\n            {\n                r.at += 1;\n            }\n            Tom"
    "lReader::skip_ws(r);\n            usize key_at = r.at;\n            Vec<String> parts = TomlReader::ke"
    "y(r)?;\n            if (TomlReader::peek(r) != b']' || (is_array && TomlReader::peek_at(r, 1) != b']'"
    "))\n            {\n                return Err(Invalid(r.at));\n            }\n            r.at += if (is"
    "_array) { 2 } else { 1 };\n            if (Vec::len(&parts) > TOML_MAX_DEPTH)\n            {\n         "
    "       return Err(OutOfRange);   // each part a table one level deeper (report 218)\n            }\n  "
    "          if (!tnode_define(&mut root, &parts, 0, is_array))\n            {\n                r.why = T"
    "OML_TWICE;\n                return Err(Invalid(key_at));\n            }\n            overwrite(&mut ctx"
    ", parts);\n            TomlReader::line_end(r)?;\n            continue;\n        }\n        usize key_at"
    " = r.at;\n        Vec<String> keys = TomlReader::key(r)?;\n        if (TomlReader::peek(r) != b'=')\n  "
    "      {\n            return Err(Invalid(r.at));\n        }\n        r.at += 1;\n        TomlReader::skip"
    "_ws(r);\n        usize below = Vec::len(&ctx) + Vec::len(&keys);\n        if (below > TOML_MAX_DEPTH)\n"
    "        {\n            return Err(OutOfRange);   // the header's parts and the key's, each a table on"
    "e level deeper (report 218)\n        }\n        Toml v = TomlReader::value(r, below)?;\n        if (!tn"
    "ode_insert(&mut root, &ctx, 0, &keys, 0, v))\n        {\n            r.why = TOML_TWICE;\n            r"
    "eturn Err(Invalid(key_at));\n        }\n        TomlReader::line_end(r)?;\n    }\n    Ok(tnode_to_toml(r"
    "oot))\n}unittest \"Toml::parse: a configuration file\"\n{\n    Toml doc = Result::unwrap(Toml::parse(\"tit"
    "le = \\\"Example\\\"\\n[owner]\\nname = \\\"Tom\\\"\\ndob = 1979-05-27T07:32:00-08:00\\n[database]\\nports = [ 80"
    "01, 8001, 8002 ]\\nenabled = true\\ntemp_targets = { cpu = 79.5, case = 72.0 }\\n[[servers]]\\nip = \\\"10"
    ".0.0.1\\\"\\n[[servers]]\\nip = \\\"10.0.0.2\\\"\\n\"));\n    assert(Option::unwrap(Toml::as_text(Option::unwra"
    "p(Toml::lookup(&doc, \"owner.name\")))) == \"Tom\");\n    assert(Toml::as_i64(Option::unwrap(Toml::lookup"
    "(&doc, \"database.ports.2\"))) == Some(8002: i64));\n    assert(Toml::as_f64(Option::unwrap(Toml::looku"
    "p(&doc, \"database.temp_targets.cpu\"))) == Some(79.5));\n    assert(Option::unwrap(Toml::as_text(Optio"
    "n::unwrap(Toml::lookup(&doc, \"servers.1.ip\")))) == \"10.0.0.2\");\n    TomlDateTime dob = Option::unwra"
    "p(Toml::as_datetime(Option::unwrap(Toml::lookup(&doc, \"owner.dob\"))));\n    assert(dob.year == 1979 &"
    "& dob.hour == 7 && dob.offset_minutes == -480);\n}unittest \"Toml::parse: where the error is\"\n{\n    ma"
    "tch (Toml::parse(\"a = 1\\nb = \\n\"))\n    {\n        Err(Invalid(i)) : assert(i == 10),\n        _       "
    "        : assert(false),\n    }\n    match (Toml::parse(\"a = 1\\na = 2\\n\"))\n    {\n        Err(Invalid(i"
    ")) : assert(i == 6),\n        _               : assert(false),\n    }\n    // Report 328: `describe_err"
    "or` names the duplicate, and a date beyond its range.\n    str twice = \"[server]\\nport = 80\\n\\n[serve"
    "r]\\nhost = \\\"h\\\"\\n\";\n    match (Toml::parse(twice))\n    {\n        Err(e) : assert(Toml::describe_err"
    "or(&e, twice) == \"line 4, column 2: server is defined twice\"),\n        Ok(_)  : assert(false),\n    }"
    "\n    str day = \"day = 2026-13-01\\n\";\n    match (Toml::parse(day))\n    {\n        Err(e) : assert(Toml"
    "::describe_error(&e, day) == \"line 1, column 7: 2026-13-01 is not a date or time (a field beyond its"
    " range)\"),\n        Ok(_)  : assert(false),\n    }\n    str bad = \"a = \\n\";\n    match (Toml::parse(bad)"
    ")\n    {\n        Err(e) : assert(Toml::describe_error(&e, bad) == ParseError::describe(&e, bad)),\n   "
    "     Ok(_)  : assert(false),\n    }\n    match (Toml::parse(\"n = 9223372036854775808\"))\n    {\n        "
    "Err(OutOfRange) : {},\n        _               : assert(false),\n    }\n}fn toml_quote(ref<String, excl"
    "usive> out, StringView s)\n{\n    str digits = \"0123456789ABCDEF\";\n    String::push_ascii(out, b'\"');\n"
    "    for (usize i = 0; i < StringView::len(s); i += 1)\n    {\n        u8 b = s.bytes[i];\n        if (b"
    " >= 0x20 && b != b'\"' && b != b'\\\\' && b != 0x7F)\n        {\n            Vec::push(&mut out.bytes, b)"
    ";          // a multi-byte character's bytes, whole\n            continue;\n        }\n        String::"
    "push_ascii(out, b'\\\\');\n        if (b == b'\"') { String::push_ascii(out, b'\"'); }\n        else if (b"
    " == b'\\\\') { String::push_ascii(out, b'\\\\'); }\n        else if (b == 10) { String::push_ascii(out, b"
    "'n'); }\n        else if (b == 13) { String::push_ascii(out, b'r'); }\n        else if (b == 9) { Stri"
    "ng::push_ascii(out, b't'); }\n        else if (b == 8) { String::push_ascii(out, b'b'); }\n        els"
    "e if (b == 12) { String::push_ascii(out, b'f'); }\n        else\n        {\n            String::append("
    "out, \"u00\");\n            String::push_ascii(out, str_byte(digits, widen<usize>(b >> 4)));\n          "
    "  String::push_ascii(out, str_byte(digits, widen<usize>(b & 15)));\n        }\n    }\n    String::push_"
    "ascii(out, b'\"');\n}fn toml_key(ref<String, exclusive> out, StringView key)\n{\n    bool bare = StringV"
    "iew::len(key) > 0;\n    for (usize i = 0; i < StringView::len(key); i += 1)\n    {\n        if (!toml_i"
    "s_bare(key.bytes[i]))\n        {\n            bare = false;\n        }\n    }\n    if (bare)\n    {\n      "
    "  String::append(out, key);\n    }\n    else\n    {\n        toml_quote(out, key);\n    }\n}fn toml_float("
    "ref<String, exclusive> out, f64 x)\n{\n    if (x != x)\n    {\n        String::append(out, \"nan\");\n    }"
    "\n    else if (!is_finite(x))\n    {\n        String::append(out, if (x > 0.0) { \"inf\" } else { \"-inf\" "
    "});\n    }\n    else\n    {\n        String::append(out, x);\n    }\n}fn toml_two_digits(ref<String, exclu"
    "sive> out, u8 v)\n{\n    String::push_ascii(out, b'0' + v / 10);\n    String::push_ascii(out, b'0' + v "
    "% 10);\n}export fn TomlDateTime::text(ref<TomlDateTime, shared> d) : String\n{\n    String out = String"
    "::new();\n    bool date = match (d.kind)\n    {\n        TomlLocalTime : false,\n        _             :"
    " true,\n    };\n    bool time = match (d.kind)\n    {\n        TomlLocalDate : false,\n        _         "
    "    : true,\n    };\n    if (date)\n    {\n        i64 y = d.year;\n        if (y < 0)\n        {\n        "
    "    String::push_ascii(&mut out, b'-');\n            y = 0 - y;\n        }\n        if (y < 1000) { Str"
    "ing::push_ascii(&mut out, b'0'); }\n        if (y < 100) { String::push_ascii(&mut out, b'0'); }\n    "
    "    if (y < 10) { String::push_ascii(&mut out, b'0'); }\n        String::append(&mut out, y);\n       "
    " String::push_ascii(&mut out, b'-');\n        toml_two_digits(&mut out, d.month);\n        String::pus"
    "h_ascii(&mut out, b'-');\n        toml_two_digits(&mut out, d.day);\n    }\n    if (date && time)\n    {"
    "\n        String::push_ascii(&mut out, b'T');\n    }\n    if (time)\n    {\n        toml_two_digits(&mut "
    "out, d.hour);\n        String::push_ascii(&mut out, b':');\n        toml_two_digits(&mut out, d.minute"
    ");\n        String::push_ascii(&mut out, b':');\n        toml_two_digits(&mut out, d.second);\n        "
    "if (d.nanoseconds > 0)\n        {\n            String::push_ascii(&mut out, b'.');\n            u32 n ="
    " d.nanoseconds;\n            u32 scale = 100000000;\n            while (n > 0)\n            {\n         "
    "       String::push_ascii(&mut out, b'0' + narrow<u8>(n / scale));\n                n = n % scale;\n  "
    "              scale = scale / 10;\n            }\n        }\n    }\n    match (d.kind)\n    {\n        Tom"
    "lOffsetDateTime :\n        {\n            if (d.offset_minutes == 0)\n            {\n                Str"
    "ing::push_ascii(&mut out, b'Z');\n            }\n            else\n            {\n                i32 m "
    "= d.offset_minutes;\n                String::push_ascii(&mut out, if (m < 0) { b'-' } else { b'+' });"
    "\n                if (m < 0)\n                {\n                    m = 0 - m;\n                }\n     "
    "           toml_two_digits(&mut out, narrow<u8>(m / 60));\n                String::push_ascii(&mut ou"
    "t, b':');\n                toml_two_digits(&mut out, narrow<u8>(m % 60));\n            }\n        },\n  "
    "      _                  : {},\n    }\n    out\n}unittest \"TomlDateTime::text: the four forms\"\n{\n    St"
    "ring text = \"a = 1979-05-27T07:32:00.999999Z\\nb = 1979-05-27T00:32:00.5-07:00\\nc = 1979-05-27T07:32:"
    "00\\nd = 1979-05-27\\ne = 07:32:00\\n\";\n    Toml doc = Result::unwrap(Toml::parse(&text));\n    assert(T"
    "oml::text(&doc) == text);\n    TomlDateTime b = Option::unwrap(Toml::as_datetime(Option::unwrap(Toml:"
    ":get(&doc, \"b\"))));\n    assert(b.nanoseconds == 500000000 && b.offset_minutes == -420 && TomlDateTim"
    "e::text(&b) == \"1979-05-27T00:32:00.5-07:00\");\n}fn toml_is_table(ref<Toml, shared> v) : bool\n{\n    m"
    "atch (v)\n    {\n        TomlTable(_) : true,\n        _            : false,\n    }\n}fn toml_is_table_ar"
    "ray(ref<Toml, shared> v) : bool\n{\n    match (v)\n    {\n        TomlArray(items) :\n        {\n         "
    "   if (Vec::len(items) == 0)\n            {\n                return false;\n            }\n            f"
    "or (usize i = 0; i < Vec::len(items); i += 1)\n            {\n                if (!toml_is_table(&item"
    "s[i]))\n                {\n                    return false;\n                }\n            }\n         "
    "   true\n        },\n        _                : false,\n    }\n}fn toml_inline(ref<String, exclusive> ou"
    "t, ref<Toml, shared> v)\n{\n    match (v)\n    {\n        TomlString(s)      : toml_quote(out, s),\n     "
    "   TomlInteger(i)     : String::append(out, *i),\n        TomlFloat(x)       : toml_float(out, *x),\n "
    "       TomlBool(b)        : String::append(out, if (*b) { \"true\" } else { \"false\" }),\n        TomlDa"
    "teTime(d)    : String::append(out, &TomlDateTime::text(d)),\n        TomlArray(items)   :\n        {\n "
    "           String::push_ascii(out, b'[');\n            for (usize i = 0; i < Vec::len(items); i += 1)"
    "\n            {\n                if (i > 0)\n                {\n                    String::append(out, "
    "\", \");\n                }\n                toml_inline(out, &items[i]);\n            }\n            Stri"
    "ng::push_ascii(out, b']');\n        },\n        TomlTable(members) :\n        {\n            String::pus"
    "h_ascii(out, b'{');\n            for (usize i = 0; i < Vec::len(members); i += 1)\n            {\n     "
    "           String::append(out, if (i > 0) { \", \" } else { \" \" });\n                toml_key(out, &mem"
    "bers[i].key);\n                String::append(out, \" = \");\n                toml_inline(out, &members["
    "i].value);\n            }\n            String::append(out, if (Vec::len(members) > 0) { \" }\" } else { "
    "\"}\" });\n        },\n    }\n}fn toml_write_table(ref<String, exclusive> out, ref<Vec<TomlMember>, share"
    "d> members, ref<String, shared> path)\n{\n    for (usize i = 0; i < Vec::len(members); i += 1)\n    {\n "
    "       ref<Toml, shared> v = &members[i].value;\n        if (toml_is_table(v) || toml_is_table_array("
    "v))\n        {\n            continue;\n        }\n        toml_key(out, &members[i].key);\n        String"
    "::append(out, \" = \");\n        toml_inline(out, v);\n        String::push_ascii(out, b'\\n');\n    }\n   "
    " for (usize i = 0; i < Vec::len(members); i += 1)\n    {\n        ref<Toml, shared> v = &members[i].va"
    "lue;\n        bool table = toml_is_table(v);\n        if (!table && !toml_is_table_array(v))\n        {"
    "\n            continue;\n        }\n        String sub = clone(path);\n        if (StringView::len(&sub)"
    " > 0)\n        {\n            String::push_ascii(&mut sub, b'.');\n        }\n        toml_key(&mut sub,"
    " &members[i].key);\n        match (v)\n        {\n            TomlTable(inner) :\n            {\n        "
    "        if (StringView::len(out) > 0)\n                {\n                    String::push_ascii(out, "
    "b'\\n');\n                }\n                String::push_ascii(out, b'[');\n                String::app"
    "end(out, &sub);\n                String::append(out, \"]\\n\");\n                toml_write_table(out, in"
    "ner, &sub);\n            },\n            TomlArray(items) :\n            {\n                for (usize k"
    " = 0; k < Vec::len(items); k += 1)\n                {\n                    if (StringView::len(out) > "
    "0)\n                    {\n                        String::push_ascii(out, b'\\n');\n                   "
    " }\n                    String::append(out, \"[[\");\n                    String::append(out, &sub);\n   "
    "                 String::append(out, \"]]\\n\");\n                    match (&items[k])\n                "
    "    {\n                        TomlTable(inner) : toml_write_table(out, inner, &sub),\n               "
    "         _                : {},\n                    }\n                }\n            },\n            _"
    "                : {},\n        }\n    }\n}export fn Toml::text(ref<Toml, shared> t) : String\n{\n    Stri"
    "ng out = String::new();\n    match (t)\n    {\n        TomlTable(members) :\n        {\n            Strin"
    "g path = String::new();\n            toml_write_table(&mut out, members, &path);\n        },\n        _"
    "                  : toml_inline(&mut out, t),\n    }\n    out\n}unittest \"Toml::text: the layout\"\n{\n   "
    " Toml doc = Result::unwrap(Toml::parse(\"[server]\\nhost = \\\"example.org\\\"\\nports = [80, 443]\\n[server"
    ".tls]\\ncert = 'a b'\\n[[users]]\\nname = \\\"ann\\\"\\n[[users]]\\nname = \\\"bob\\\"\\n\"));\n    String t = Toml:"
    ":text(&doc);\n    assert(t == \"[server]\\nhost = \\\"example.org\\\"\\nports = [80, 443]\\n\\n[server.tls]\\nc"
    "ert = \\\"a b\\\"\\n\\n[[users]]\\nname = \\\"ann\\\"\\n\\n[[users]]\\nname = \\\"bob\\\"\\n\");\n    assert(Toml::text(&"
    "Result::unwrap(Toml::parse(&t))) == t);\n}export fn Toml::get(ref<Toml, shared> t, StringView key) : "
    "Option<ref<Toml, shared>> from t\n{\n    match (t)\n    {\n        TomlTable(members) :\n        {\n      "
    "      for (usize i = 0; i < Vec::len(members); i += 1)\n            {\n                if (members[i]."
    "key == key)\n                {\n                    return Some(&members[i].value);\n                }\n"
    "            }\n            None\n        },\n        _                  : None,\n    }\n}export fn Toml::"
    "at(ref<Toml, shared> t, usize i) : Option<ref<Toml, shared>>\n{\n    match (t)\n    {\n        TomlArray"
    "(items) : if (i < Vec::len(items)) { Some(&items[i]) } else { None },\n        _                : Non"
    "e,\n    }\n}export fn Toml::lookup(ref<Toml, shared> t, StringView path) : Option<ref<Toml, shared>> f"
    "rom t\n{\n    // The parts are read where they are, by position: `path` is only\n    // searched, so th"
    "e result holds none of it (`from t`).\n    ref<Toml, shared> cur = t;\n    usize n = StringView::len(p"
    "ath);\n    usize start = 0;\n    while (true)\n    {\n        usize end = match (StringView::find(&path["
    "start..$], \".\"))\n        {\n            Some(k) : start + k,\n            None    : n,\n        };\n    "
    "    cur = match (cur)\n        {\n            TomlArray(_) : match (StringView::parse<usize>(&path[sta"
    "rt..end]))\n            {\n                Ok(k)  : Toml::at(cur, k)?,\n                Err(_) : return"
    " None,\n            },\n            _ : Toml::get(cur, &path[start..end])?,\n        };\n        if (end"
    " == n)\n        {\n            break;\n        }\n        start = end + 1;\n    }\n    Some(cur)\n}export f"
    "n Toml::as_text(ref<Toml, shared> t) : Option<StringView>\n{\n    match (t)\n    {\n        TomlString(s"
    ") : Some(s),\n        _             : None,\n    }\n}export fn Toml::as_i64(ref<Toml, shared> t) : Opti"
    "on<i64>\n{\n    match (t)\n    {\n        TomlInteger(i) : Some(*i),\n        _              : None,\n    "
    "}\n}export fn Toml::as_f64(ref<Toml, shared> t) : Option<f64>\n{\n    match (t)\n    {\n        TomlFloat"
    "(x) : Some(*x),\n        _            : None,\n    }\n}export fn Toml::as_bool(ref<Toml, shared> t) : O"
    "ption<bool>\n{\n    match (t)\n    {\n        TomlBool(b) : Some(*b),\n        _           : None,\n    }\n"
    "}export fn Toml::as_datetime(ref<Toml, shared> t) : Option<TomlDateTime>\n{\n    match (t)\n    {\n     "
    "   TomlDateTime(d) : Some(*d),\n        _               : None,\n    }\n}export fn Toml::as_array(ref<T"
    "oml, shared> t) : Option<ref<Vec<Toml>, shared>>\n{\n    match (t)\n    {\n        TomlArray(items) : So"
    "me(items),\n        _                : None,\n    }\n}export fn Toml::as_table(ref<Toml, shared> t) : O"
    "ption<ref<Vec<TomlMember>, shared>>\n{\n    match (t)\n    {\n        TomlTable(members) : Some(members)"
    ",\n        _                  : None,\n    }\n}export fn Toml::set(ref<Toml, exclusive> t, StringView k"
    "ey, Toml v)\n{\n    match (t)\n    {\n        TomlTable(members) :\n        {\n            for (usize i = "
    "0; i < Vec::len(members); i += 1)\n            {\n                if (members[i].key == key)\n         "
    "       {\n                    overwrite(&mut members[i].value, v);\n                    return;\n      "
    "          }\n            }\n            Vec::push(members, TomlMember { .key = String::copy(key), .val"
    "ue = v });\n        },\n        _                  : assert(false, \"Toml::set on a value that is not a"
    " table\"),\n    }\n}export fn Toml::push(ref<Toml, exclusive> t, Toml v)\n{\n    match (t)\n    {\n        "
    "TomlArray(items) : Vec::push(items, v),\n        _                : assert(false, \"Toml::push on a va"
    "lue that is not an array\"),\n    }\n}unittest \"Toml::set: building a document\"\n{\n    Toml doc = TomlTa"
    "ble(Vec::new());\n    Toml::set(&mut doc, \"name\", TomlString(\"demo\"));\n    Toml ports = TomlArray(Vec"
    "::new());\n    Toml::push(&mut ports, TomlInteger(8080));\n    Toml::push(&mut ports, TomlInteger(8081"
    "));\n    Toml server = TomlTable(Vec::new());\n    Toml::set(&mut server, \"ports\", ports);\n    Toml::s"
    "et(&mut server, \"debug\", TomlBool(false));\n    Toml::set(&mut doc, \"server\", server);\n    Toml::set("
    "&mut doc, \"name\", TomlString(\"demo 2\"));\n    assert(Toml::text(&doc) == \"name = \\\"demo 2\\\"\\n\\n[serve"
    "r]\\nports = [8080, 8081]\\ndebug = false\\n\");\n}export fn CompressError::text(ref<CompressError, share"
    "d> e) : str\n{\n    match (e)\n    {\n        Corrupt(_) : \"corrupt compressed data\",\n        Truncated "
    " : \"compressed data ends early\",\n        Oversize   : \"decompressed data too large\",\n    }\n}fn BitRe"
    "ader::take(ref<BitReader, exclusive> r, u32 n) : Result<u32, CompressError>\n{\n    while (r.count < n"
    ")\n    {\n        if (r.at >= slice_len(r.data))\n        {\n            return Err(Truncated);\n        "
    "}\n        r.bits = r.bits | (widen<u32>(r.data[r.at]) << r.count);\n        r.at += 1;\n        r.coun"
    "t += 8;\n    }\n    u32 v = r.bits & ((1: u32 << n) - 1);\n    r.bits = r.bits >> n;\n    r.count -= n;\n"
    "    Ok(v)\n}fn BitReader::align(ref<BitReader, exclusive> r)\n{\n    r.bits = 0;\n    r.count = 0;\n}fn H"
    "uffman::build(slice<u8, shared> lengths) : Option<Huffman>\n{\n    array<u16, 16> counts = [0; 16];\n  "
    "  for (usize i = 0; i < slice_len(lengths); i += 1)\n    {\n        counts[widen<usize>(lengths[i])] +"
    "= 1;\n    }\n    counts[0] = 0;\n    i32 left = 1;\n    for (usize len = 1; len < 16; len += 1)\n    {\n  "
    "      left = left * 2 - widen<i32>(counts[len]);\n        if (left < 0)\n        {\n            return "
    "None;\n        }\n    }\n    array<u16, 16> offs = [0; 16];\n    for (usize len = 1; len < 15; len += 1)"
    "\n    {\n        offs[len + 1] = offs[len] + counts[len];\n    }\n    array<u16, 320> symbols = [0; 320]"
    ";\n    for (usize i = 0; i < slice_len(lengths); i += 1)\n    {\n        if (lengths[i] != 0)\n        {"
    "\n            symbols[widen<usize>(offs[widen<usize>(lengths[i])])] = narrow<u16>(i);\n            off"
    "s[widen<usize>(lengths[i])] += 1;\n        }\n    }\n    Some(Huffman { .counts = counts, .symbols = sy"
    "mbols })\n}fn Huffman::decode(ref<Huffman, shared> h, ref<BitReader, exclusive> r) : Result<u16, Comp"
    "ressError>\n{\n    HuffStep s = huff_step(r.data, h, r.at, r.bits, r.count);\n    r.at = s.at;\n    r.bi"
    "ts = s.bits;\n    r.count = s.count;\n    if (s.sym == -1)\n    {\n        return Err(Truncated);\n    }\n"
    "    if (s.sym < 0)\n    {\n        return Err(Corrupt(r.at));\n    }\n    Ok(narrow<u16>(s.sym))\n}fn huf"
    "f_step(slice<u8, shared> data, ref<Huffman, shared> h, usize at, u32 bits, u32 count) : HuffStep\n{\n "
    "   usize n = slice_len(data);\n    usize p = at;\n    u32 bb = bits;\n    u32 bc = count;\n    i32 code "
    "= 0;\n    i32 first = 0;\n    i32 index = 0;\n    for (usize len = 1; len < 16; len += 1)\n    {\n       "
    " if (bc == 0)\n        {\n            if (p >= n)\n            {\n                return HuffStep { .sym"
    " = -1, .at = p, .bits = bb, .count = bc };\n            }\n            bb = widen<u32>(data[p]);\n     "
    "       p += 1;\n            bc = 8;\n        }\n        code = code | narrow<i32>(bb & 1);\n        bb ="
    " bb >> 1;\n        bc -= 1;\n        i32 c = widen<i32>(h.counts[len]);\n        if (code - c < first)\n"
    "        {\n            return HuffStep { .sym = widen<i32>(h.symbols[narrow<usize>(index + (code - fi"
    "rst))]), .at = p, .bits = bb, .count = bc };\n        }\n        index += c;\n        first += c;\n     "
    "   first = first << 1;\n        code = code << 1;\n    }\n    HuffStep { .sym = -2, .at = p, .bits = bb"
    ", .count = bc }\n}fn bits_step(slice<u8, shared> data, usize at, u32 bits, u32 count, u32 need) : Bit"
    "sStep\n{\n    usize p = at;\n    u32 bb = bits;\n    u32 bc = count;\n    while (bc < need)\n    {\n       "
    " if (p >= slice_len(data))\n        {\n            return BitsStep { .ok = false, .v = 0, .at = p, .bi"
    "ts = bb, .count = bc };\n        }\n        bb = bb | (widen<u32>(data[p]) << bc);\n        p += 1;\n   "
    "     bc += 8;\n    }\n    u32 v = bb & ((1: u32 << need) - 1);\n    BitsStep { .ok = true, .v = v, .at "
    "= p, .bits = bb >> need, .count = bc - need }\n}fn fixed_codes() : Huffman\n{\n    Vec<u8> lit = Vec::f"
    "illed(288, 8: u8);\n    for (usize i = 144; i < 256; i += 1)\n    {\n        lit[i] = 9;\n    }\n    for "
    "(usize i = 256; i < 280; i += 1)\n    {\n        lit[i] = 7;\n    }\n    Option::unwrap(Huffman::build(&"
    "lit))\n}fn fixed_distances() : Huffman\n{\n    Vec<u8> d = Vec::filled(30, 5: u8);\n    Option::unwrap(H"
    "uffman::build(&d))\n}fn inflate_codes(\n    ref<BitReader, exclusive> r,\n    ref<Vec<u8>, exclusive> o"
    "ut,\n    ref<Huffman, shared> lit,\n    ref<Huffman, shared> dist,\n    usize max,\n) : Result<void, Com"
    "pressError>\n{\n    Vec<u8> o = replace(out, Vec::new());\n    InflateRun { bytes, pos, bitbuf, nbits, "
    "status } = inflate_run(r.data, lit, dist, o, r.at, r.bits, r.count, max);\n    r.at = pos;\n    r.bits"
    " = bitbuf;\n    r.count = nbits;\n    overwrite(out, bytes);\n    if (status == 1)\n    {\n        return"
    " Err(Truncated);\n    }\n    if (status == 2)\n    {\n        return Err(Corrupt(r.at));\n    }\n    if (s"
    "tatus == 3)\n    {\n        return Err(Oversize);\n    }\n    Ok(())\n}fn inflate_run(\n    slice<u8, shar"
    "ed> data,\n    ref<Huffman, shared> lit,\n    ref<Huffman, shared> dist,\n    Vec<u8> out,\n    usize at"
    "0,\n    u32 bits0,\n    u32 count0,\n    usize max,\n) : InflateRun\n{\n    usize at = at0;\n    u32 bits ="
    " bits0;\n    u32 count = count0;\n    u32 status = 0;\n    while (true)\n    {\n        HuffStep s = huff"
    "_step(data, lit, at, bits, count);\n        at = s.at;\n        bits = s.bits;\n        count = s.count"
    ";\n        if (s.sym < 0)\n        {\n            status = if (s.sym == -1) { 1 } else { 2 };\n         "
    "   break;\n        }\n        if (s.sym < 256)\n        {\n            if (Vec::len(&out) >= max)\n      "
    "      {\n                status = 3;\n                break;\n            }\n            Vec::push(&mut "
    "out, narrow<u8>(s.sym));\n            continue;\n        }\n        if (s.sym == 256)\n        {\n       "
    "     break;\n        }\n        usize li = narrow<usize>(s.sym) - 257;\n        if (li >= 29)\n        {"
    "\n            status = 2;\n            break;\n        }\n        BitsStep e = bits_step(data, at, bits,"
    " count, widen<u32>(LENGTH_EXTRA[li]));\n        at = e.at;\n        bits = e.bits;\n        count = e.c"
    "ount;\n        if (!e.ok)\n        {\n            status = 1;\n            break;\n        }\n        usiz"
    "e len = widen<usize>(LENGTH_BASE[li]) + narrow<usize>(e.v);\n        HuffStep d = huff_step(data, dis"
    "t, at, bits, count);\n        at = d.at;\n        bits = d.bits;\n        count = d.count;\n        if ("
    "d.sym < 0)\n        {\n            status = if (d.sym == -1) { 1 } else { 2 };\n            break;\n    "
    "    }\n        usize di = narrow<usize>(d.sym);\n        if (di >= 30)\n        {\n            status = "
    "2;\n            break;\n        }\n        BitsStep f = bits_step(data, at, bits, count, widen<u32>(DIS"
    "T_EXTRA[di]));\n        at = f.at;\n        bits = f.bits;\n        count = f.count;\n        if (!f.ok)"
    "\n        {\n            status = 1;\n            break;\n        }\n        usize distance = widen<usize"
    ">(DIST_BASE[di]) + narrow<usize>(f.v);\n        if (distance > Vec::len(&out))\n        {\n            "
    "status = 2;\n            break;\n        }\n        if (Vec::len(&out) + len > max)\n        {\n         "
    "   status = 3;\n            break;\n        }\n        usize from = Vec::len(&out) - distance;\n        "
    "for (usize k = 0; k < len; k += 1)\n        {\n            u8 b = out[from + k];\n            Vec::push"
    "(&mut out, b);\n        }\n    }\n    InflateRun { .bytes = out, .pos = at, .bitbuf = bits, .nbits = co"
    "unt, .status = status }\n}fn read_dynamic(\n    ref<BitReader, exclusive> r,\n    ref<Option<Huffman>, "
    "exclusive> lit,\n    ref<Option<Huffman>, exclusive> dist,\n) : Result<void, CompressError>\n{\n    usiz"
    "e nlen = narrow<usize>(BitReader::take(r, 5)?) + 257;\n    usize ndist = narrow<usize>(BitReader::tak"
    "e(r, 5)?) + 1;\n    usize ncode = narrow<usize>(BitReader::take(r, 4)?) + 4;\n    if (nlen > 286 || nd"
    "ist > 30)\n    {\n        return Err(Corrupt(r.at));\n    }\n    Vec<u8> clens = Vec::filled(19, 0: u8);"
    "\n    for (usize i = 0; i < ncode; i += 1)\n    {\n        clens[widen<usize>(CLEN_ORDER[i])] = narrow<"
    "u8>(BitReader::take(r, 3)?);\n    }\n    Huffman ccode = match (Huffman::build(&clens))\n    {\n        "
    "Some(h) : h,\n        None    : return Err(Corrupt(r.at)),\n    };\n    Vec<u8> lengths = Vec::new();\n "
    "   while (Vec::len(&lengths) < nlen + ndist)\n    {\n        u16 sym = Huffman::decode(&ccode, r)?;\n  "
    "      if (sym < 16)\n        {\n            Vec::push(&mut lengths, narrow<u8>(sym));\n            cont"
    "inue;\n        }\n        u8 value = 0;\n        usize repeat = 0;\n        if (sym == 16)\n        {\n   "
    "         if (Vec::len(&lengths) == 0)\n            {\n                return Err(Corrupt(r.at));\n     "
    "       }\n            value = lengths[Vec::len(&lengths) - 1];\n            repeat = 3 + narrow<usize>"
    "(BitReader::take(r, 2)?);\n        }\n        else if (sym == 17)\n        {\n            repeat = 3 + n"
    "arrow<usize>(BitReader::take(r, 3)?);\n        }\n        else\n        {\n            repeat = 11 + nar"
    "row<usize>(BitReader::take(r, 7)?);\n        }\n        if (Vec::len(&lengths) + repeat > nlen + ndist"
    ")\n        {\n            return Err(Corrupt(r.at));\n        }\n        for (usize k = 0; k < repeat; k"
    " += 1)\n        {\n            Vec::push(&mut lengths, value);\n        }\n    }\n    if (lengths[256] =="
    " 0)\n    {\n        return Err(Corrupt(r.at));\n    }\n    match (Huffman::build(&lengths[0..nlen]))\n   "
    " {\n        Some(h) : overwrite(lit, Some(h)),\n        None    : return Err(Corrupt(r.at)),\n    }\n   "
    " match (Huffman::build(&lengths[nlen..nlen + ndist]))\n    {\n        Some(h) : overwrite(dist, Some(h"
    ")),\n        None    : return Err(Corrupt(r.at)),\n    }\n    Ok(())\n}fn inflate_from(\n    slice<u8, sh"
    "ared> data,\n    usize start,\n    ref<Vec<u8>, exclusive> out,\n    usize max,\n) : Result<usize, Compr"
    "essError>\n{\n    BitReader r = BitReader { .data = data, .at = start, .bits = 0, .count = 0 };\n    Hu"
    "ffman fixed_lit = fixed_codes();\n    Huffman fixed_dist = fixed_distances();\n    while (true)\n    {\n"
    "        u32 last = BitReader::take(&mut r, 1)?;\n        u32 kind = BitReader::take(&mut r, 2)?;\n    "
    "    if (kind == 0)\n        {\n            BitReader::align(&mut r);\n            if (r.at + 4 > slice_"
    "len(data))\n            {\n                return Err(Truncated);\n            }\n            usize len "
    "= widen<usize>(read_le<u16>(data, r.at));\n            usize nlen = widen<usize>(read_le<u16>(data, r"
    ".at + 2));\n            if (len != (nlen ^ 0xFFFF))\n            {\n                return Err(Corrupt("
    "r.at));\n            }\n            r.at += 4;\n            if (r.at + len > slice_len(data))\n         "
    "   {\n                return Err(Truncated);\n            }\n            if (Vec::len(out) + len > max)"
    "\n            {\n                return Err(Oversize);\n            }\n            Vec::extend_from(out,"
    " &data[r.at..r.at + len]);\n            r.at += len;\n        }\n        else if (kind == 1)\n        {\n"
    "            inflate_codes(&mut r, out, &fixed_lit, &fixed_dist, max)?;\n        }\n        else if (ki"
    "nd == 2)\n        {\n            Option<Huffman> lit = None;\n            Option<Huffman> dist = None;\n"
    "            read_dynamic(&mut r, &mut lit, &mut dist)?;\n            inflate_codes(&mut r, out, &Opti"
    "on::unwrap(lit), &Option::unwrap(dist), max)?;\n        }\n        else\n        {\n            return E"
    "rr(Corrupt(r.at));\n        }\n        if (last == 1)\n        {\n            // The bits left in the re"
    "ader's buffer belong to no block; the\n            // position after the block is the next whole byte"
    ".\n            return Ok(r.at);\n        }\n    }\n}export fn inflate(slice<u8, shared> data, usize max)"
    " : Result<Vec<u8>, CompressError>\n{\n    Vec<u8> out = Vec::new();\n    inflate_from(data, 0, &mut out"
    ", max)?;\n    Ok(out)\n}fn BitWriter::put(ref<BitWriter, exclusive> w, u32 value, u32 n)\n{\n    w.bits "
    "= w.bits | (widen<u64>(value) << w.count);\n    w.count += n;\n    while (w.count >= 8)\n    {\n        "
    "Vec::push(&mut w.out, narrow_wrapping<u8>(w.bits));\n        w.bits = w.bits >> 8;\n        w.count -="
    " 8;\n    }\n}fn BitWriter::put_code(ref<BitWriter, exclusive> w, u32 code, u32 len)\n{\n    u32 rev = 0;"
    "\n    for (u32 i = 0; i < len; i += 1)\n    {\n        rev = (rev << 1) | ((code >> i) & 1);\n    }\n    "
    "BitWriter::put(w, rev, len);\n}fn BitWriter::flush(ref<BitWriter, exclusive> w)\n{\n    if (w.count > 0"
    ")\n    {\n        Vec::push(&mut w.out, narrow_wrapping<u8>(w.bits));\n        w.bits = 0;\n        w.co"
    "unt = 0;\n    }\n}fn code_lengths(slice<u32, shared> freq, usize limit) : Vec<u8>\n{\n    usize n = slic"
    "e_len(freq);\n    Vec<u8> lengths = Vec::filled(n, 0: u8);\n    Vec<u32> f = Vec::from_slice(freq);\n  "
    "  usize used = 0;\n    for (usize i = 0; i < n; i += 1)\n    {\n        if (f[i] > 0)\n        {\n       "
    "     used += 1;\n        }\n    }\n    if (used == 0)\n    {\n        return lengths;\n    }\n    if (used "
    "== 1)\n    {\n        for (usize i = 0; i < n; i += 1)\n        {\n            if (f[i] > 0)\n           "
    " {\n                lengths[i] = 1;\n            }\n        }\n        return lengths;\n    }\n    while ("
    "true)\n    {\n        // Nodes 0..n are the symbols, n.. the merges; each node's weight,\n        // pa"
    "rent and depth.\n        Vec<u64> weight = Vec::new();\n        Vec<usize> parent = Vec::new();\n      "
    "  Vec<bool> alive = Vec::new();\n        for (usize i = 0; i < n; i += 1)\n        {\n            Vec::"
    "push(&mut weight, widen<u64>(f[i]));\n            Vec::push(&mut parent, 0);\n            Vec::push(&m"
    "ut alive, f[i] > 0);\n        }\n        usize live = used;\n        while (live > 1)\n        {\n       "
    "     usize a = n * 2;\n            usize b = n * 2;\n            for (usize i = 0; i < Vec::len(&weigh"
    "t); i += 1)\n            {\n                if (!alive[i])\n                {\n                    conti"
    "nue;\n                }\n                if (a == n * 2 || weight[i] < weight[a])\n                {\n  "
    "                  b = a;\n                    a = i;\n                }\n                else if (b == "
    "n * 2 || weight[i] < weight[b])\n                {\n                    b = i;\n                }\n     "
    "       }\n            usize m = Vec::len(&weight);\n            Vec::push(&mut weight, weight[a] + wei"
    "ght[b]);\n            Vec::push(&mut parent, 0);\n            Vec::push(&mut alive, true);\n           "
    " alive[a] = false;\n            alive[b] = false;\n            parent[a] = m;\n            parent[b] = "
    "m;\n            live -= 1;\n        }\n        usize root = Vec::len(&weight) - 1;\n        usize deepes"
    "t = 0;\n        for (usize i = 0; i < n; i += 1)\n        {\n            if (f[i] == 0)\n            {\n "
    "               continue;\n            }\n            usize d = 0;\n            usize at = i;\n          "
    "  while (at != root)\n            {\n                at = parent[at];\n                d += 1;\n        "
    "    }\n            lengths[i] = narrow<u8>(d);\n            if (d > deepest)\n            {\n           "
    "     deepest = d;\n            }\n        }\n        if (deepest <= limit)\n        {\n            return"
    " lengths;\n        }\n        for (usize i = 0; i < n; i += 1)\n        {\n            if (f[i] > 0)\n   "
    "         {\n                f[i] = (f[i] >> 1) | 1;\n            }\n        }\n    }\n}fn canonical_codes"
    "(slice<u8, shared> lengths) : Vec<u32>\n{\n    array<u32, 16> count = [0; 16];\n    for (usize i = 0; i"
    " < slice_len(lengths); i += 1)\n    {\n        count[widen<usize>(lengths[i])] += 1;\n    }\n    count[0"
    "] = 0;\n    array<u32, 16> next = [0; 16];\n    u32 code = 0;\n    for (usize len = 1; len < 16; len +="
    " 1)\n    {\n        code = (code + count[len - 1]) << 1;\n        next[len] = code;\n    }\n    Vec<u32> "
    "codes = Vec::filled(slice_len(lengths), 0: u32);\n    for (usize i = 0; i < slice_len(lengths); i += "
    "1)\n    {\n        usize l = widen<usize>(lengths[i]);\n        if (l != 0)\n        {\n            codes"
    "[i] = next[l];\n            next[l] += 1;\n        }\n    }\n    codes\n}fn length_code(usize len) : usiz"
    "e\n{\n    usize c = 28;\n    for (usize i = 0; i < 28; i += 1)\n    {\n        if (len < widen<usize>(LEN"
    "GTH_BASE[i + 1]))\n        {\n            c = i;\n            break;\n        }\n    }\n    c\n}fn distance"
    "_code(usize d) : usize\n{\n    usize c = 29;\n    for (usize i = 0; i < 29; i += 1)\n    {\n        if (d"
    " < widen<usize>(DIST_BASE[i + 1]))\n        {\n            c = i;\n            break;\n        }\n    }\n "
    "   c\n}fn hash3(slice<u8, shared> d, usize i) : usize\n{\n    ((widen<usize>(d[i]) << 10) ^ (widen<usiz"
    "e>(d[i + 1]) << 5) ^ widen<usize>(d[i + 2])) & (HASH_SIZE - 1)\n}fn token_counts(slice<Token, shared>"
    " tokens) : TokenCounts\n{\n    array<u32, 286> lit = [0; 286];\n    array<u32, 30> dist = [0; 30];\n    "
    "u64 extra = 0;\n    for (usize k = 0; k < slice_len(tokens); k += 1)\n    {\n        u16 l = tokens[k]."
    "lit;\n        lit[widen<usize>(l)] += 1;\n        if (l >= 256)\n        {\n            dist[widen<usize"
    ">(tokens[k].dist_code)] += 1;\n            extra += widen<u64>(tokens[k].len_extra_bits) + widen<u64>"
    "(tokens[k].dist_extra_bits);\n        }\n    }\n    TokenCounts { .lit = lit, .dist = dist, .extra = ex"
    "tra }\n}fn write_block(ref<BitWriter, exclusive> w, slice<Token, shared> tokens, slice<u8, shared> ra"
    "w, bool last)\n{\n    // Frequencies, with the end-of-block symbol.\n    TokenCounts counts = token_cou"
    "nts(tokens);\n    Vec<u32> lf = Vec::from_slice(&counts.lit);\n    Vec<u32> df = Vec::from_slice(&coun"
    "ts.dist);\n    lf[256] += 1;\n    Vec<u8> ll = code_lengths(&lf, 15);\n    Vec<u8> dl = code_lengths(&d"
    "f, 15);\n    // The fixed code's lengths, for its cost.\n    Vec<u8> fl = Vec::filled(288, 8: u8);\n   "
    " for (usize i = 144; i < 256; i += 1)\n    {\n        fl[i] = 9;\n    }\n    for (usize i = 256; i < 280"
    "; i += 1)\n    {\n        fl[i] = 7;\n    }\n    u64 extra = counts.extra;\n    u64 cost_fixed = extra;\n "
    "   u64 cost_dyn = extra;\n    for (usize i = 0; i < 286; i += 1)\n    {\n        cost_fixed += widen<u6"
    "4>(lf[i]) * widen<u64>(fl[i]);\n        cost_dyn += widen<u64>(lf[i]) * widen<u64>(ll[i]);\n    }\n    "
    "for (usize i = 0; i < 30; i += 1)\n    {\n        cost_fixed += widen<u64>(df[i]) * 5;\n        cost_dy"
    "n += widen<u64>(df[i]) * widen<u64>(dl[i]);\n    }\n    // The dynamic header: the code lengths run-le"
    "ngth coded.\n    usize nlen = 286;\n    while (nlen > 257 && ll[nlen - 1] == 0)\n    {\n        nlen -= "
    "1;\n    }\n    usize ndist = 30;\n    while (ndist > 1 && dl[ndist - 1] == 0)\n    {\n        ndist -= 1;"
    "\n    }\n    Vec<u8> all = Vec::new();\n    Vec::extend_from(&mut all, &ll[0..nlen]);\n    Vec::extend_f"
    "rom(&mut all, &dl[0..ndist]);\n    // Run-length symbols: (symbol, extra value, extra bits).\n    Vec<"
    "u8> rl_sym = Vec::new();\n    Vec<u8> rl_val = Vec::new();\n    Vec<u8> rl_bits = Vec::new();\n    usiz"
    "e i = 0;\n    while (i < Vec::len(&all))\n    {\n        u8 v = all[i];\n        usize run = 1;\n        "
    "while (i + run < Vec::len(&all) && all[i + run] == v)\n        {\n            run += 1;\n        }\n    "
    "    if (v == 0 && run >= 3)\n        {\n            usize r = if (run > 138) { 138 } else { run };\n   "
    "         if (r <= 10)\n            {\n                Vec::push(&mut rl_sym, 17);\n                Vec:"
    ":push(&mut rl_val, narrow<u8>(r - 3));\n                Vec::push(&mut rl_bits, 3);\n            }\n   "
    "         else\n            {\n                Vec::push(&mut rl_sym, 18);\n                Vec::push(&m"
    "ut rl_val, narrow<u8>(r - 11));\n                Vec::push(&mut rl_bits, 7);\n            }\n          "
    "  i += r;\n        }\n        else if (v != 0 && run >= 4)\n        {\n            Vec::push(&mut rl_sym"
    ", v);\n            Vec::push(&mut rl_val, 0);\n            Vec::push(&mut rl_bits, 0);\n            usi"
    "ze r = if (run - 1 > 6) { 6 } else { run - 1 };\n            Vec::push(&mut rl_sym, 16);\n            "
    "Vec::push(&mut rl_val, narrow<u8>(r - 3));\n            Vec::push(&mut rl_bits, 2);\n            i += "
    "1 + r;\n        }\n        else\n        {\n            Vec::push(&mut rl_sym, v);\n            Vec::push"
    "(&mut rl_val, 0);\n            Vec::push(&mut rl_bits, 0);\n            i += 1;\n        }\n    }\n    Ve"
    "c<u32> cf = Vec::filled(19, 0: u32);\n    foreach (s in &rl_sym)\n    {\n        cf[widen<usize>(*s)] +"
    "= 1;\n    }\n    Vec<u8> cl = code_lengths(&cf, 7);\n    usize ncode = 19;\n    while (ncode > 4 && cl[w"
    "iden<usize>(CLEN_ORDER[ncode - 1])] == 0)\n    {\n        ncode -= 1;\n    }\n    cost_dyn += 14 + widen"
    "<u64>(ncode) * 3;\n    for (usize k = 0; k < Vec::len(&rl_sym); k += 1)\n    {\n        cost_dyn += wid"
    "en<u64>(cl[widen<usize>(rl_sym[k])]) + widen<u64>(rl_bits[k]);\n    }\n    u64 cost_stored = widen<u64"
    ">(slice_len(raw)) * 8 + 40 * (widen<u64>(slice_len(raw)) / 65535 + 1);\n    if (cost_stored <= cost_f"
    "ixed && cost_stored <= cost_dyn)\n    {\n        // Stored blocks of at most 65535 bytes, the last mar"
    "ked.\n        usize at = 0;\n        while (true)\n        {\n            usize take = if (slice_len(raw"
    ") - at > 65535) { 65535 } else { slice_len(raw) - at };\n            bool final = last && at + take ="
    "= slice_len(raw);\n            BitWriter::put(w, if (final) { 1 } else { 0 }, 1);\n            BitWrit"
    "er::put(w, 0, 2);\n            BitWriter::flush(w);\n            Vec::push_le(&mut w.out, narrow<u16>("
    "take));\n            Vec::push_le(&mut w.out, narrow<u16>(take ^ 0xFFFF));\n            Vec::extend_fr"
    "om(&mut w.out, &raw[at..at + take]);\n            at += take;\n            if (at >= slice_len(raw))\n "
    "           {\n                return;\n            }\n        }\n    }\n    BitWriter::put(w, if (last) {"
    " 1 } else { 0 }, 1);\n    Vec<u32> lcodes = Vec::new();\n    Vec<u8> llens = Vec::new();\n    Vec<u32> "
    "dcodes = Vec::new();\n    Vec<u8> dlens = Vec::new();\n    if (cost_fixed <= cost_dyn)\n    {\n        B"
    "itWriter::put(w, 1, 2);\n        overwrite(&mut lcodes, canonical_codes(&fl));\n        overwrite(&mut"
    " llens, fl);\n        Vec<u8> fd = Vec::filled(30, 5: u8);\n        overwrite(&mut dcodes, canonical_c"
    "odes(&fd));\n        overwrite(&mut dlens, fd);\n    }\n    else\n    {\n        BitWriter::put(w, 2, 2);"
    "\n        BitWriter::put(w, narrow<u32>(nlen - 257), 5);\n        BitWriter::put(w, narrow<u32>(ndist "
    "- 1), 5);\n        BitWriter::put(w, narrow<u32>(ncode - 4), 4);\n        for (usize k = 0; k < ncode;"
    " k += 1)\n        {\n            BitWriter::put(w, widen<u32>(cl[widen<usize>(CLEN_ORDER[k])]), 3);\n  "
    "      }\n        Vec<u32> ccodes = canonical_codes(&cl);\n        for (usize k = 0; k < Vec::len(&rl_s"
    "ym); k += 1)\n        {\n            usize s = widen<usize>(rl_sym[k]);\n            BitWriter::put_cod"
    "e(w, ccodes[s], widen<u32>(cl[s]));\n            if (rl_bits[k] > 0)\n            {\n                Bi"
    "tWriter::put(w, widen<u32>(rl_val[k]), widen<u32>(rl_bits[k]));\n            }\n        }\n        over"
    "write(&mut lcodes, canonical_codes(&ll));\n        overwrite(&mut llens, ll);\n        overwrite(&mut "
    "dcodes, canonical_codes(&dl));\n        overwrite(&mut dlens, dl);\n    }\n    Vec<u8> o = replace(&mut"
    " w.out, Vec::new());\n    BitOut { buf, acc, nacc } = put_tokens(\n        o,\n        w.bits,\n        "
    "w.count,\n        tokens,\n        &lcodes,\n        &llens,\n        &dcodes,\n        &dlens,\n    );\n  "
    "  overwrite(&mut w.out, buf);\n    w.bits = acc;\n    w.count = nacc;\n}fn put_tokens(\n    Vec<u8> out,"
    "\n    u64 bits0,\n    u32 count0,\n    slice<Token, shared> tokens,\n    slice<u32, shared> lcodes,\n    "
    "slice<u8, shared> llens,\n    slice<u32, shared> dcodes,\n    slice<u8, shared> dlens,\n) : BitOut\n{\n  "
    "  u64 bits = bits0;\n    u32 count = count0;\n    usize nt = slice_len(tokens);\n    for (usize k = 0; "
    "k <= nt; k += 1)\n    {\n        // Up to four fields per token: its code (or, after the last, the\n   "
    "     // end code), then for a match the length's extra bits, the\n        // distance's code and its "
    "extra bits. A code goes most\n        // significant bit first: reversed.\n        usize s = if (k < n"
    "t) { widen<usize>(tokens[k].lit) } else { 256 };\n        for (usize f = 0; f < 4; f += 1)\n        {\n"
    "            u32 v = 0;\n            u32 n = 0;\n            if (f == 0)\n            {\n                "
    "u32 code = lcodes[s];\n                n = widen<u32>(llens[s]);\n                for (u32 i = 0; i < "
    "n; i += 1)\n                {\n                    v = (v << 1) | ((code >> i) & 1);\n                }"
    "\n            }\n            else if (s >= 257)\n            {\n                if (f == 1)\n            "
    "    {\n                    v = widen<u32>(tokens[k].len_extra);\n                    n = widen<u32>(to"
    "kens[k].len_extra_bits);\n                }\n                else if (f == 2)\n                {\n      "
    "              usize d = widen<usize>(tokens[k].dist_code);\n                    u32 code = dcodes[d];"
    "\n                    n = widen<u32>(dlens[d]);\n                    for (u32 i = 0; i < n; i += 1)\n  "
    "                  {\n                        v = (v << 1) | ((code >> i) & 1);\n                    }\n"
    "                }\n                else\n                {\n                    v = widen<u32>(tokens[k"
    "].dist_extra);\n                    n = widen<u32>(tokens[k].dist_extra_bits);\n                }\n    "
    "        }\n            if (n == 0)\n            {\n                continue;\n            }\n            "
    "bits = bits | (widen<u64>(v) << count);\n            count += n;\n            while (count >= 8)\n     "
    "       {\n                Vec::push(&mut out, narrow_wrapping<u8>(bits));\n                bits = bits"
    " >> 8;\n                count -= 8;\n            }\n        }\n    }\n    BitOut { .buf = out, .acc = bit"
    "s, .nacc = count }\n}fn deflate_scan(slice<u8, shared> data, Vec<usize> head, Vec<usize> prev, Vec<To"
    "ken> tokens, usize start) : DeflateScan\n{\n    usize n = slice_len(data);\n    usize i = start;\n    wh"
    "ile (i < n && Vec::len(&tokens) < MAX_TOKENS)\n    {\n        usize best_len = 0;\n        usize best_d"
    "ist = 0;\n        if (i + 3 <= n)\n        {\n            usize h = ((widen<usize>(data[i]) << 10) ^ (w"
    "iden<usize>(data[i + 1]) << 5) ^ widen<usize>(data[i + 2])) & (HASH_SIZE - 1);\n            usize can"
    "d = head[h];\n            usize chain = 0;\n            usize limit = if (n - i > 258) { 258 } else { "
    "n - i };\n            while (cand != max_value<usize>() && i - cand <= WINDOW && chain < CHAIN_LIMIT)"
    "\n            {\n                if (data[cand + best_len] == data[i + best_len])\n                {\n  "
    "                  usize l = 0;\n                    while (l < limit && data[cand + l] == data[i + l]"
    ")\n                    {\n                        l += 1;\n                    }\n                    if"
    " (l > best_len)\n                    {\n                        best_len = l;\n                        "
    "best_dist = i - cand;\n                        if (l == limit)\n                        {\n            "
    "                break;\n                        }\n                    }\n                }\n           "
    "     usize next = prev[cand & (WINDOW - 1)];\n                if (next == max_value<usize>() || next "
    ">= cand)\n                {\n                    break;\n                }\n                cand = next;"
    "\n                chain += 1;\n            }\n            prev[i & (WINDOW - 1)] = head[h];\n           "
    " head[h] = i;\n        }\n        if (best_len >= 3)\n        {\n            usize lc = length_code(best"
    "_len);\n            usize dc = distance_code(best_dist);\n            Vec::push(&mut tokens, Token {\n "
    "               .lit = narrow<u16>(257 + lc),\n                .len_extra = narrow<u16>(best_len - wid"
    "en<usize>(LENGTH_BASE[lc])),\n                .len_extra_bits = LENGTH_EXTRA[lc],\n                .di"
    "st_code = narrow<u8>(dc),\n                .dist_extra = narrow<u16>(best_dist - widen<usize>(DIST_BA"
    "SE[dc])),\n                .dist_extra_bits = DIST_EXTRA[dc],\n            });\n            // The byte"
    "s inside the match enter the hash chains too.\n            for (usize k = 1; k < best_len; k += 1)\n  "
    "          {\n                if (i + k + 3 <= n)\n                {\n                    usize h = ((wi"
    "den<usize>(data[i + k]) << 10) ^ (widen<usize>(data[i + k + 1]) << 5) ^ widen<usize>(data[i + k + 2]"
    ")) & (HASH_SIZE - 1);\n                    prev[(i + k) & (WINDOW - 1)] = head[h];\n                  "
    "  head[h] = i + k;\n                }\n            }\n            i += best_len;\n        }\n        else"
    "\n        {\n            Vec::push(\n                &mut tokens,\n                Token { .lit = widen<"
    "u16>(data[i]), .len_extra = 0, .len_extra_bits = 0, .dist_code = 0, .dist_extra = 0, .dist_extra_bit"
    "s = 0 },\n            );\n            i += 1;\n        }\n    }\n    DeflateScan { .head = head, .prev = "
    "prev, .tokens = tokens, .end = i }\n}export fn deflate(slice<u8, shared> data) : Vec<u8>\n{\n    BitWri"
    "ter w = BitWriter { .out = Vec::new(), .bits = 0, .count = 0 };\n    usize n = slice_len(data);\n    i"
    "f (n == 0)\n    {\n        // One empty fixed block.\n        BitWriter::put(&mut w, 1, 1);\n        Bit"
    "Writer::put(&mut w, 1, 2);\n        BitWriter::put(&mut w, 0, 7);\n        BitWriter::flush(&mut w);\n "
    "       BitWriter { out, bits, count } = w;\n        return out;\n    }\n    Vec<usize> heads = Vec::fil"
    "led(HASH_SIZE, max_value<usize>());\n    Vec<usize> chains = Vec::filled(WINDOW, max_value<usize>());"
    "\n    DeflateScan s = DeflateScan { .head = heads, .prev = chains, .tokens = Vec::new(), .end = 0 };\n"
    "    while (s.end < n)\n    {\n        usize block_start = s.end;\n        DeflateScan { head, prev, tok"
    "ens, end } = s;\n        s = deflate_scan(data, head, prev, tokens, end);\n        write_block(&mut w,"
    " &s.tokens, &data[block_start..s.end], s.end >= n);\n        Vec::clear(&mut s.tokens);\n    }\n    Bit"
    "Writer::flush(&mut w);\n    BitWriter { out, bits, count } = w;\n    out\n}unittest \"deflate: empty dat"
    "a, and adler32\"\n{\n    Vec<u8> nothing = Vec::new();\n    Vec<u8> empty = deflate(&nothing);\n    asser"
    "t(Vec::len(&empty) == 2 && empty[0] == 0x03 && empty[1] == 0x00);\n    assert(Vec::len(&Result::unwra"
    "p(inflate(&empty, 0))) == 0);\n    assert(adler32(b\"Wikipedia\") == 300286872);\n    assert(adler32(&no"
    "thing) == 1);\n}export fn adler32(slice<u8, shared> data) : u32\n{\n    u32 a = 1;\n    u32 b = 0;\n    u"
    "size i = 0;\n    usize n = slice_len(data);\n    while (i < n)\n    {\n        // 5552 bytes at a time f"
    "it the sums in a `u32` before reducing.\n        usize end = if (n - i > 5552) { i + 5552 } else { n "
    "};\n        while (i < end)\n        {\n            a += widen<u32>(data[i]);\n            b += a;\n     "
    "       i += 1;\n        }\n        a = a % 65521;\n        b = b % 65521;\n    }\n    (b << 16) | a\n}expo"
    "rt fn zlib_deflate(slice<u8, shared> data) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n    Vec::push(&"
    "mut out, 0x78);\n    Vec::push(&mut out, 0x9C);\n    Vec::append(&mut out, deflate(data));\n    Vec::pu"
    "sh_be(&mut out, adler32(data));\n    out\n}export fn zlib_inflate(slice<u8, shared> data, usize max) :"
    " Result<Vec<u8>, CompressError>\n{\n    if (slice_len(data) < 6)\n    {\n        return Err(Truncated);\n"
    "    }\n    u8 cmf = data[0];\n    u8 flg = data[1];\n    if ((cmf & 0x0F) != 8 || (widen<u32>(cmf) * 25"
    "6 + widen<u32>(flg)) % 31 != 0 || (flg & 0x20) != 0)\n    {\n        return Err(Corrupt(0));\n    }\n   "
    " Vec<u8> out = Vec::new();\n    usize end = inflate_from(data, 2, &mut out, max)?;\n    if (end + 4 > "
    "slice_len(data))\n    {\n        return Err(Truncated);\n    }\n    if (read_be<u32>(data, end) != adler"
    "32(&out))\n    {\n        return Err(Corrupt(end));\n    }\n    Ok(out)\n}unittest \"zlib_inflate: a wrong"
    " checksum\"\n{\n    Vec<u8> z = zlib_deflate(b\"hello hello hello\");\n    usize last = Vec::len(&z) - 1;\n"
    "    z[last] = z[last] ^ 1;\n    match (zlib_inflate(&z, 100))\n    {\n        Err(Corrupt(at)) : assert"
    "(at == last - 3),\n        _                : assert(false),\n    }\n}export fn gzip(slice<u8, shared> "
    "data) : Vec<u8>\n{\n    Vec<u8> out = Vec::new();\n    array<u8, 10> header = [0x1F, 0x8B, 8, 0, 0, 0, "
    "0, 0, 0, 255];\n    Vec::extend_from(&mut out, &header);\n    Vec::append(&mut out, deflate(data));\n  "
    "  Vec::push_le(&mut out, crc32(data));\n    Vec::push_le(&mut out, narrow_wrapping<u32>(slice_len(dat"
    "a)));\n    out\n}export fn gunzip(slice<u8, shared> data, usize max) : Result<Vec<u8>, CompressError>\n"
    "{\n    Vec<u8> out = Vec::new();\n    usize at = 0;\n    usize n = slice_len(data);\n    while (true)\n  "
    "  {\n        if (at + 10 > n)\n        {\n            return Err(Truncated);\n        }\n        if (data"
    "[at] != 0x1F || data[at + 1] != 0x8B || data[at + 2] != 8)\n        {\n            return Err(Corrupt("
    "at));\n        }\n        u8 flags = data[at + 3];\n        usize p = at + 10;\n        if ((flags & 4) "
    "!= 0)\n        {\n            if (p + 2 > n)\n            {\n                return Err(Truncated);\n    "
    "        }\n            p += 2 + widen<usize>(read_le<u16>(data, p));\n        }\n        if ((flags & 8"
    ") != 0)\n        {\n            while (p < n && data[p] != 0)\n            {\n                p += 1;\n  "
    "          }\n            p += 1;\n        }\n        if ((flags & 16) != 0)\n        {\n            while"
    " (p < n && data[p] != 0)\n            {\n                p += 1;\n            }\n            p += 1;\n   "
    "     }\n        if ((flags & 2) != 0)\n        {\n            p += 2;\n        }\n        if (p > n)\n    "
    "    {\n            return Err(Truncated);\n        }\n        // Each member is a stream of its own, so"
    " a distance reaches back\n        // into its own output only (report 220): a member after the first "
    "is\n        // inflated apart and then appended.\n        usize before = Vec::len(&out);\n        Vec<u"
    "8> member = Vec::new();\n        usize end = if (before == 0)\n        {\n            inflate_from(data"
    ", p, &mut out, max)?\n        }\n        else\n        {\n            inflate_from(data, p, &mut member,"
    " max - before)?\n        };\n        if (end + 8 > n)\n        {\n            return Err(Truncated);\n   "
    "     }\n        usize produced = if (before == 0) { Vec::len(&out) } else { Vec::len(&member) };\n    "
    "    u32 sum = if (before == 0) { crc32(&out) } else { crc32(&member) };\n        if (read_le<u32>(dat"
    "a, end) != sum || read_le<u32>(data, end + 4) != narrow_wrapping<u32>(produced))\n        {\n         "
    "   return Err(Corrupt(end));\n        }\n        Vec::append(&mut out, member);\n        at = end + 8;\n"
    "        // The end, or zero bytes after the last member, as a tape or a block\n        // device pads"
    " a file (gzip reads them as the end too).\n        usize z = at;\n        while (z < n && data[z] == 0"
    ")\n        {\n            z += 1;\n        }\n        if (z >= n)\n        {\n            return Ok(out);\n"
    "        }\n    }\n}unittest \"gunzip: round trip and the size limit\"\n{\n    Vec<u8> data = Vec::filled(1"
    "000, b'a');\n    Vec<u8> packed = gzip(&data);\n    assert(Vec::len(&packed) < 100);\n    Vec<u8> back "
    "= Result::unwrap(gunzip(&packed, 1000));\n    assert(Vec::len(&back) == 1000 && back[999] == b'a');\n "
    "   match (gunzip(&packed, 999))\n    {\n        Err(Oversize) : {},\n        _             : assert(fal"
    "se),\n    }\n}export fn NulError::text(ref<NulError, shared> e) : str\n{\n    \"holds a NUL byte\"\n}export"
    " fn CString::from_bytes(slice<u8, shared> b) : Result<CString, NulError>\n{\n    usize n = slice_len(b"
    ");\n    Vec<u8> bytes = Vec::new();\n    Vec::reserve(&mut bytes, n + 1);\n    for (usize i = 0; i < n;"
    " i += 1)\n    {\n        if (b[i] == 0)\n        {\n            return Err(NulError { .offset = i });\n  "
    "      }\n        Vec::push(&mut bytes, b[i]);\n    }\n    Vec::push(&mut bytes, 0);\n    Ok(CString { .b"
    "ytes = bytes })\n}export fn CString::new(StringView s) : Result<CString, NulError>\n{\n    CString::fro"
    "m_bytes(StringView::as_bytes(s))\n}export fn CString::ptr(ref<CString, shared> c) : rawptr<u8>\n{\n    "
    "rawptr_of(&c.bytes[0])\n}export fn CString::len(ref<CString, shared> c) : usize\n{\n    Vec::len(&c.byt"
    "es) - 1\n}export fn CString::as_bytes(ref<CString, shared> c) : slice<u8, shared>\n{\n    &c.bytes[0 .."
    " Vec::len(&c.bytes) - 1]\n}export fn copy_to_raw<T: plain>(slice<T, shared> s, rawptr<T> p)\n{\n    usi"
    "ze n = slice_len(s);\n    if (n == 0)\n    {\n        return;\n    }\n    if (p == null_rawptr<T>())\n    "
    "{\n        fault(null_pointer, \"`copy_to_raw`: `p` is C's `NULL`, where the slice's elements were to "
    "be copied to\");\n    }\n    // trusted: [Copy-Raw] of the slice's n * sizeof<T>() bytes (readable: the"
    " slice's own path covers them) to `p`, the caller's assertion in its `unsafe` that `p` has room for "
    "them and that no live object's cells lie there (a [Trusted-Call], spec/20 §1); T is `plain`, so the"
    " bytes are the elements.\n    unsafe\n    {\n        copy_raw(reinterpret_ptr<u8>(p), reinterpret_ptr<u"
    "8>(rawptr_of(&s[0])), n * sizeof<T>());\n    }\n}export fn is_null<T>(rawptr<T> p) : bool\n{\n    p == n"
    "ull_rawptr<T>()\n}";

