    ");\n        auto n = Option::unwrap(Json::get(&doc, \"n\"));\n        assert(Json::as_i64(Option::unwrap"
    "(Json::at(n, 0))) == Some(1: i64));\n        assert(Json::as_i64(Option::unwrap(Json::at(n, 1))) == N"
    "one);\n        assert(Option::is_none(&Json::get(&doc, \"missing\")));\n\u{1f}\u{1e}std::encoding::json\u{1f}Json::at\u{1f}f"
