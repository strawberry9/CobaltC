    "id(r.at));\n    }\n    for (usize i = 0; i < wn; i += 1)\n    {\n        if (r.at + i >= StringView::len"
    "(r.text))\n        {\n            return Err(Invalid(r.at + i));\n        }\n        if (r.text.bytes[r."
    "at + i] != str_byte(word, i))\n        {\n            return Err(Invalid(r.at + i));\n        }\n    }\n "
    "   r.at += wn;\n    if (b == b't') { Ok(JsonBool(true)) } else if (b == b'f') { Ok(JsonBool(false)) }"
    " else { Ok(JsonNull) }\n}export fn Json::parse(StringView text) : Result<Json, ParseError>\n{\n    Json"
    "Reader r = JsonReader { .text = text, .at = 0 };\n    JsonReader::skip_space(&mut r);\n    if (r.at >="
