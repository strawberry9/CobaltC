    "::unwrap_or(Vec::binary_search(&v, present), 99) == 1);\n    match (Vec::binary_search(&v, absent))\n "
    "   {\n        Ok(_)  : assert(false),\n        Err(i) : assert(i == 3),\n    }\n}fn Vec::take_raw<T>(ref"
    "<Vec<T>, exclusive> v, usize i) : T\n{\n    unsafe\n    {\n        rawptr<T> p = v.ptr + reinterpret<isi"
    "ze>(i);\n        auto x = *p;\n        release(reinterpret_ptr<u8>(p), sizeof<T>());\n        x\n    }\n}"
    "export fn Vec::clear<T>(ref<Vec<T>, exclusive> v)\n{\n    usize i = 0;\n    while (i < v.len)\n    {\n   "
