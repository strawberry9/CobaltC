    "ec<i32> a = Vec::new();\n    Vec::push(&mut a, 1);\n    Vec::push(&mut a, 2);\n    Vec::push(&mut a, 3)"
    ";\n    Vec::push(&mut a, 4);\n    Vec<i32> b = Vec::clone(&a);\n    assert(Vec::remove(&mut a, 0) == 1)"
    ";\n    assert(a[0] == 2 && a[1] == 3 && a[2] == 4);\n    assert(Vec::swap_remove(&mut b, 0) == 1);\n   "
    " assert(b[0] == 4 && b[1] == 2 && b[2] == 3);\n}export fn Vec::clone<T: clone>(ref<Vec<T>, shared> v)"
    " : Vec<T>\n{\n    Vec<T> out = Vec::new();\n    Vec::reserve(&mut out, v.len);\n    for (usize i = 0; i "
    "< v.len; i += 1)\n    {\n        Vec::push(&mut out, clone(Vec::index_shared(v, i)));\n    }\n    out\n}e"
    "xport fn Vec::from_slice<T: clone>(slice<T, shared> s) : Vec<T>\n{\n    Vec<T> out = Vec::new();\n    V"
