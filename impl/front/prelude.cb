    "128 t2 = a0 * b2 + a1 * b1 + a2 * b0 + a3 * b4_19 + a4 * b3_19;\n    u128 t3 = a0 * b3 + a1 * b2 + a2"
    " * b1 + a3 * b0 + a4 * b4_19;\n    u128 t4 = a0 * b4 + a1 * b3 + a2 * b2 + a3 * b1 + a4 * b0;\n    u12"
    "8 m = 0x7ffffffffffff;\n    t1 += t0 >> 51;\n    t2 += t1 >> 51;\n    t3 += t2 >> 51;\n    t4 += t3 >> 5"
    "1;\n    u128 r0 = (t0 & m) + (t4 >> 51) * 19;\n    u128 r1 = (t1 & m) + (r0 >> 51);\n    array<u64, 5> "
    "r = [\n        narrow<u64>(r0 & m),\n        narrow<u64>(r1),\n        narrow<u64>(t2 & m),\n        nar"
    "row<u64>(t3 & m),\n        narrow<u64>(t4 & m),\n    ];\n    fe_carry(r)\n}fn fe_cswap(ref<array<u64, 5>"
    ", exclusive> a, ref<array<u64, 5>, exclusive> b, u64 swap)\n{\n    u64 mask = wrapping_sub(0, swap);\n "
    "   for (usize i = 0; i < 5; i += 1)\n    {\n        u64 x = mask & (a[i] ^ b[i]);\n        a[i] = a[i] "
