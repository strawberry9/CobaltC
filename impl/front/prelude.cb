    " }))\n        {\n            Ok(_)  : assert(false),\n            Err(v) : assert(v == -6),\n        }\n\n"
    "    Example, \"Atomic::wait: woken by notify_all\":\n        AtomicBool done = AtomicBool::new(false);\n"
