    "  }, &o, &runs));\n        }\n        foreach (h in hs)\n        {\n            assert(join(h));\n       "
    " }\n        assert(Atomic::load(&runs) == 1 && Once::is_done(&o));\n\u{1f}\u{1e}std::random\u{1f}Rng\u{1f}struct\u{1f}export st"
    "ruct Rng\u{1f}A general-purpose pseudo-random generator: xoshiro256** seeded through splitmix64.\u{1f}\u{1f}export "
    "struct Rng\n    in `std::random`\n\n    A general-purpose pseudo-random generator: xoshiro256** seeded "
