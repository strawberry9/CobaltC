    "ate is U+FFFD.\n            u32 u = if (cp >= 0xD800 && cp <= 0xDFFF) { 0xFFFD } else { cp };\n       "
    "     if (u < 0x80)\n            {\n                Vec::push(&mut out, narrow<u8>(u));\n            }\n "
    "           else if (u < 0x800)\n            {\n                Vec::push(&mut out, 0xC0 | narrow<u8>(u"
    " >> 6));\n                Vec::push(&mut out, 0x80 | narrow<u8>(u & 0x3F));\n            }\n           "
    " else if (u < 0x10000)\n            {\n                Vec::push(&mut out, 0xE0 | narrow<u8>(u >> 12))"
    ";\n                Vec::push(&mut out, 0x80 | narrow<u8>((u >> 6) & 0x3F));\n                Vec::push"
    "(&mut out, 0x80 | narrow<u8>(u & 0x3F));\n            }\n            else\n            {\n              "
    "  Vec::push(&mut out, 0xF0 | narrow<u8>(u >> 18));\n                Vec::push(&mut out, 0x80 | narrow"
    "<u8>((u >> 12) & 0x3F));\n                Vec::push(&mut out, 0x80 | narrow<u8>((u >> 6) & 0x3F));\n  "
    "              Vec::push(&mut out, 0x80 | narrow<u8>(u & 0x3F));\n            }\n        }\n        else"
    "\n        {\n            err = at;\n            break;\n        }\n    }\n    JsonStr { .bytes = out, .pos"
    " = at, .err = err }\n}fn JsonReader::value(ref<JsonReader, exclusive> r, usize depth) : Result<Json, "
    "ParseError>\n{\n    JsonReader::skip_space(r);\n    u8 b = JsonReader::peek(r);\n    if (b == b'{')\n    "
    "{\n        if (depth >= MAX_DEPTH)\n        {\n            return Err(OutOfRange);\n        }\n        r."
    "at += 1;\n        Vec<JsonMember> members = Vec::new();\n        JsonReader::skip_space(r);\n        if"
