export const str PRELUDE_BODIES =
    "fn byte_op(\n    usize which,\n    usize op,\n    usize h,\n    rawptr<u8> a,\n    usize an,\n    rawptr<u"
    "8> b,\n    usize bn,\n    rawptr<u8> out,\n    usize cap,\n) : i64\n{\n    unsafe\n    {\n        match (whi"
    "ch)\n        {\n            0 : path_op(op, h, a, an, b, bn, out, cap),\n            1 : proc_op(op, h,"
    " a, an, b, bn, out, cap),\n            _ : net_op(op, h, a, an, b, bn, out, cap),\n        }\n    }\n}fn"
    " byte_answer(usize which, usize op, usize h, slice<u8, shared> a, slice<u8, shared> b) : Result<Vec<"
    "u8>, i64>\n{\n    Vec<u8> out = Vec::new();\n    usize cap = 256;\n    while (true)\n    {\n        while "
    "(out.cap < cap)\n        {\n            Vec::grow(&mut out);\n        }\n        i64 n = byte_op(\n      "
    "      which,\n            op,\n            h,\n            bytes_ptr(a),\n            slice_len(a),\n    "
    "        bytes_ptr(b),\n            slice_len(b),\n            reinterpret_ptr<u8>(out.ptr),\n          "
    "  cap,\n        );\n        if (n < 0)\n        {\n            return Err(n);\n        }\n        usize le"
    "n = reinterpret<usize>(n);\n        if (len <= cap)\n        {\n            out.len = len;\n            "
    "return Ok(out);\n        }\n        cap = len;\n    }\n}fn bytes_ptr(slice<u8, shared> s) : rawptr<u8>\n{"
    "\n    if (slice_len(s) == 0)\n    {\n        return dangling<u8>();\n    }\n    rawptr_of(&s[0])\n}fn code"
    "_error(i64 code) : FileError\n{\n    if (code == -1)\n    {\n        return FileError::NotFound;\n    }\n "
    "   if (code == -2)\n    {\n        return FileError::Denied;\n    }\n    if (code == -5)\n    {\n        r"
    "eturn FileError::IsDirectory;\n    }\n    if (code == -6)\n    {\n        return FileError::NotDirectory"
    ";\n    }\n    if (code == -7)\n    {\n        return FileError::NoSpace;\n    }\n    if (code == -8)\n    {"
    "\n        return FileError::TooManyOpen;\n    }\n    if (code == -9)\n    {\n        return FileError::No"
    "tEmpty;\n    }\n    if (code == -10)\n    {\n        return FileError::LinkLoop;\n    }\n    if (code == -"
    "11)\n    {\n        return FileError::SameFile;\n    }\n    // Report 326: the runtime's FILEIO_CROSS_DE"
    "VICE … FILEIO_ARGS_TOO_LONG.\n    if (code == -12)\n    {\n        return FileError::CrossDevice;\n   "
    " }\n    if (code == -13)\n    {\n        return FileError::NameTooLong;\n    }\n    if (code == -14)\n    "
    "{\n        return FileError::InvalidName;\n    }\n    if (code == -15)\n    {\n        return FileError::"
    "NotOpenForThat;\n    }\n    if (code == -16)\n    {\n        return FileError::ArgsTooLong;\n    }\n    Fi"
    "leError::Io\n}fn file_error(isize code) : FileError\n{\n    code_error(widen<i64>(code))\n}fn fs_answer("
    "usize op, rawptr<u8> a, usize an) : Result<Vec<u8>, isize>\n{\n    Vec<u8> out = Vec::new();\n    usize"
    " cap = 256;\n    while (true)\n    {\n        while (out.cap < cap)\n        {\n            Vec::grow(&mu"
    "t out);\n        }\n        isize n = unsafe\n        {\n            fs_query(op, a, an, reinterpret_ptr"
    "<u8>(out.ptr), cap)\n        };\n        if (n < 0)\n        {\n            return Err(n);\n        }\n   "
    "     usize len = reinterpret<usize>(n);\n        if (len <= cap)\n        {\n            out.len = len;"
    "\n            return Ok(out);\n        }\n        cap = len;\n    }\n}fn path_text(StringView a, StringVi"
    "ew b, usize op) : Option<String>\n{\n    match (byte_answer(0, op, 0, a.bytes, b.bytes))\n    {\n       "
    " Ok(v) : match (String::from_utf8(v))\n        {\n            Ok(s)  : Some(s),\n            Err(_) : N"
    "one,\n        },\n        Err(_) : None,\n    }\n}fn path_result(usize op, StringView a, StringView b) :"
    " Result<i64, FileError>\n{\n    i64 r = byte_op(\n        0,\n        op,\n        0,\n        StringView:"
    ":ptr(a),\n        StringView::len(a),\n        StringView::ptr(b),\n        StringView::len(b),\n       "
    " dangling<u8>(),\n        0,\n    );\n    if (r < 0)\n    {\n        return Err(code_error(r));\n    }\n   "
    " Ok(r)\n}export fn Option::unwrap_or<T>(Option<T> o, T d) : T\n{\n    match (o)\n    {\n        Some(v) :"
    " v,\n        None    : d,\n    }\n}export fn Option::ok_or<T, E>(Option<T> o, E e) : Result<T, E>\n{\n   "
    " match (o)\n    {\n        Some(v) : Ok(v),\n        None    : Err(e),\n    }\n}unittest \"Option::ok_or: "
    "None becomes the error\"\n{\n    Option<i32> none = None;\n    Result<i32, u8> r = Option::ok_or(none, 7"
    ");\n    match (r)\n    {\n        Ok(_)  : assert(false),\n        Err(e) : assert(e == 7),\n    }\n    as"
    "sert(Result::is_ok(&Option::ok_or(Some(5), 7)));\n}export fn Result::ok<T, E>(Result<T, E> r) : Optio"
    "n<T>\n{\n    match (r)\n    {\n        Ok(v)  : Some(v),\n        Err(_) : None,\n    }\n}unittest \"Result:"
    ":ok: dropping the error\"\n{\n    Result<i32, u8> bad = Err(4);\n    assert(Result::unwrap_or(bad, 0) =="
    " 0);\n    Result<i32, u8> good = Ok(9);\n    Option<i32> o = Result::ok(good);\n    assert(Option::is_s"
    "ome(&o) && Option::unwrap(o) == 9);\n}export fn Result::unwrap_or<T, E>(Result<T, E> r, T d) : T\n{\n  "
    "  match (r)\n    {\n        Ok(v)  : v,\n        Err(_) : d,\n    }\n}export fn Option::unwrap<T>(Option<"
    "T> o) : T\n{\n    match (o)\n    {\n        Some(v) : v,\n        None    : fault(unwrap_failed, \"`Option"
    "::unwrap` found `None`\"),\n    }\n}export fn Option::expect<T>(Option<T> o, str message) : T\n{\n    mat"
    "ch (o)\n    {\n        Some(v) : v,\n        None    : fault(unwrap_failed, message),\n    }\n}export fn "
    "Result::unwrap<T, E>(Result<T, E> r) : T\n{\n    match (r)\n    {\n        Ok(v)  : v,\n        Err(e) : "
    "unwrap_failed_with(&e, \"`Result::unwrap` found `Err`\"),\n    }\n}export fn Result::expect<T, E>(Result"
    "<T, E> r, str message) : T\n{\n    match (r)\n    {\n        Ok(v)  : v,\n        Err(e) : unwrap_failed_"
    "with(&e, message),\n    }\n}export fn Option::is_some<T>(ref<Option<T>, shared> o) : bool\n{\n    match "
    "(o)\n    {\n        Some(_) : true,\n        None    : false,\n    }\n}export fn Option::is_none<T>(ref<O"
    "ption<T>, shared> o) : bool\n{\n    !Option::is_some(o)\n}export fn Result::is_ok<T, E>(ref<Result<T, E"
    ">, shared> r) : bool\n{\n    match (r)\n    {\n        Ok(_)  : true,\n        Err(_) : false,\n    }\n}exp"
    "ort fn Result::is_err<T, E>(ref<Result<T, E>, shared> r) : bool\n{\n    !Result::is_ok(r)\n}export fn s"
    "wap<T>(ref<T, exclusive> a, ref<T, exclusive> b)\n{\n    swap_places(a, b);\n}export fn replace<T>(ref<"
    "T, exclusive> r, T v) : T\n{\n    auto old = v;\n    swap_places(r, &mut old);\n    old\n}unittest \"repla"
    "ce: the old value comes back\"\n{\n    i32 a = 1;\n    i32 old = replace(&mut a, 2);\n    assert(old == 1"
    " && a == 2);\n    i32 b = 3;\n    swap(&mut a, &mut b);\n    assert(a == 3 && b == 2);\n}export fn overw"
    "rite<T>(ref<T, exclusive> r, T v)\n{\n    drop(replace(r, v));\n}export fn Vec::new<T>() : Vec<T>\n{\n   "
    " Vec { .ptr = dangling<T>(), .len = 0, .cap = 0 }\n}export fn Vec::len<T>(ref<Vec<T>, shared> v) : us"
    "ize\n{\n    v.len\n}export fn Vec::push<T>(ref<Vec<T>, exclusive> v, T x)\n{\n    if (v.len == v.cap)\n   "
    " {\n        Vec::grow(v);\n    }\n    unsafe\n    {\n        *(v.ptr + reinterpret<isize>(v.len)) = x;\n  "
    "  }\n    v.len = v.len + 1;\n}export fn Vec::pop<T>(ref<Vec<T>, exclusive> v) : Option<T>\n{\n    if (v."
    "len == 0)\n    {\n        return None;\n    }\n    v.len = v.len - 1;\n    unsafe\n    {\n        rawptr<T>"
    " p = v.ptr + reinterpret<isize>(v.len);\n        auto x = *p;\n        release(reinterpret_ptr<u8>(p),"
    " sizeof<T>());\n        Some(x)\n    }\n}export fn Vec::index_shared<T>(ref<Vec<T>, shared> v, usize i)"
    " : ref<T, shared>\n    requires\n    {\n        i < v.len, index_out_of_bounds;\n    }\n{\n    unsafe\n    "
    "{\n        &reclaim<T>(v.ptr + reinterpret<isize>(i))\n    }\n}export fn Vec::index_exclusive<T>(ref<Ve"
    "c<T>, exclusive> v, usize i) : ref<T, exclusive>\n    requires\n    {\n        i < v.len, index_out_of_"
    "bounds;\n    }\n{\n    // D-0222: element i of `*v` is accessed exclusively through `v`, as `[Index-Vec"
    "]` checks `(*v)[i]`\n    // written: a live shared path to the vector, or a slice holding i, meets it"
    ".\n    _ = &mut (*v)[i .. i + 1];\n    unsafe\n    {\n        &mut reclaim<T>(v.ptr + reinterpret<isize>"
    "(i))\n    }\n}fn Vec::grow<T>(ref<Vec<T>, exclusive> v)\n{\n    usize new_cap = if (v.cap == 0)\n    {\n  "
    "      4\n    }\n    else\n    {\n        v.cap * 2\n    };\n    usize bytes = new_cap * sizeof<T>();\n    r"
    "awptr<u8> p = match (allocate(bytes, alignof<T>()))\n    {\n        Ok(p)  : p,\n        Err(_) : fault"
    "(alloc_failure),\n    };\n    rawptr<u8> old = reinterpret_ptr<u8>(v.ptr);\n    usize old_cap = v.cap;\n"
    "    unsafe\n    {\n        copy_raw(p, old, v.len * sizeof<T>());\n    }\n    // The two checked writes "
    "before the old cells go (CHG-0332): a write\n    // that faults (this exclusive path's first write me"
    "eting a shared path\n    // of the same `Vec`, D-0022) leaves `v` as it was, so the unwind's\n    // `"
    "Vec::drop` frees the old cells once; the new block is then lost\n    // with the thread.\n    v.ptr = "
    "reinterpret_ptr<T>(p);\n    v.cap = new_cap;\n    unsafe\n    {\n        if (old_cap > 0)\n        {\n    "
    "        deallocate(old, old_cap * sizeof<T>(), alignof<T>());\n        }\n    }\n}export fn Vec::reserv"
    "e<T>(ref<Vec<T>, exclusive> v, usize n)\n{\n    usize need = v.len + n;\n    if (need <= v.cap)\n    {\n "
    "       return;\n    }\n    usize new_cap = if (v.cap > need - v.cap)\n    {\n        v.cap * 2\n    }\n   "
    " else\n    {\n        need\n    };\n    usize bytes = new_cap * sizeof<T>();\n    rawptr<u8> p = match (a"
    "llocate(bytes, alignof<T>()))\n    {\n        Ok(p)  : p,\n        Err(_) : fault(alloc_failure),\n    }"
    ";\n    rawptr<u8> old = reinterpret_ptr<u8>(v.ptr);\n    usize old_cap = v.cap;\n    unsafe\n    {\n     "
    "   copy_raw(p, old, v.len * sizeof<T>());\n    }\n    // The two checked writes before the old cells g"
    "o (CHG-0332): a write\n    // that faults (this exclusive path's first write meeting a shared path\n  "
    "  // of the same `Vec`, D-0022) leaves `v` as it was, so the unwind's\n    // `Vec::drop` frees the o"
    "ld cells once; the new block is then lost\n    // with the thread.\n    v.ptr = reinterpret_ptr<T>(p);"
    "\n    v.cap = new_cap;\n    unsafe\n    {\n        if (old_cap > 0)\n        {\n            deallocate(old"
    ", old_cap * sizeof<T>(), alignof<T>());\n        }\n    }\n}export fn Vec::drop<T>(ref<Vec<T>, exclusiv"
    "e> self)\n{\n    usize mut_i = 0;\n    while (mut_i < self.len)\n    {\n        unsafe\n        {\n        "
    "    drop(reclaim<T>(self.ptr + reinterpret<isize>(mut_i)));\n        }\n        mut_i = mut_i + 1;\n   "
    " }\n    if (self.cap > 0)\n    {\n        unsafe\n        {\n            deallocate(reinterpret_ptr<u8>(s"
    "elf.ptr), self.cap * sizeof<T>(), alignof<T>());\n        }\n    }\n}fn key_before<T>(ref<T, shared> a,"
    " ref<T, shared> b) : bool\n{\n    key_less(a, b)\n}fn Vec::sorted_order<T>(ref<Vec<T>, shared> v, fn(re"
    "f<T, shared>, ref<T, shared>) : bool less) : Vec<usize>\n{\n    usize n = v.len;\n    Vec<usize> a = Ve"
    "c::new();\n    Vec<usize> b = Vec::new();\n    usize i = 0;\n    while (i < n)\n    {\n        Vec::push("
    "&mut a, i);\n        Vec::push(&mut b, 0);\n        i += 1;\n    }\n    usize width = 1;\n    while (widt"
    "h < n)\n    {\n        usize lo = 0;\n        while (lo < n)\n        {\n            usize mid = if (n - "
    "lo > width)\n            {\n                lo + width\n            }\n            else\n            {\n  "
    "              n\n            };\n            usize hi = if (n - mid > width)\n            {\n           "
    "     mid + width\n            }\n            else\n            {\n                n\n            };\n     "
    "       usize l = lo;\n            usize r = mid;\n            usize k = lo;\n            while (k < hi)"
    "\n            {\n                // From the left run unless the right one's element is\n              "
    "  // strictly less: equal elements keep their order.\n                bool take_left = l < mid && (r "
    ">= hi || !less(Vec::index_shared(v, a[r]), Vec::index_shared(v, a[l])));\n                if (take_le"
    "ft)\n                {\n                    b[k] = a[l];\n                    l += 1;\n                }"
    "\n                else\n                {\n                    b[k] = a[r];\n                    r += 1;"
    "\n                }\n                k += 1;\n            }\n            lo = hi;\n        }\n        swap"
    "(&mut a, &mut b);\n        width = if (width > n)\n        {\n            n\n        }\n        else\n    "
    "    {\n            width * 2\n        };\n    }\n    a\n}fn Vec::sorted_order_keys<T>(ref<Vec<T>, shared>"
    " v) : Vec<usize>\n{\n    usize n = v.len;\n    Vec<usize> a = Vec::new();\n    Vec<usize> b = Vec::new()"
    ";\n    usize i = 0;\n    while (i < n)\n    {\n        Vec::push(&mut a, i);\n        Vec::push(&mut b, 0"
    ");\n        i += 1;\n    }\n    usize width = 1;\n    while (width < n)\n    {\n        usize lo = 0;\n    "
    "    while (lo < n)\n        {\n            usize mid = if (n - lo > width)\n            {\n             "
    "   lo + width\n            }\n            else\n            {\n                n\n            };\n        "
    "    usize hi = if (n - mid > width)\n            {\n                mid + width\n            }\n        "
    "    else\n            {\n                n\n            };\n            usize l = lo;\n            usize "
    "r = mid;\n            usize k = lo;\n            while (k < hi)\n            {\n                bool tak"
    "e_left = l < mid && (r >= hi || !key_less_at(v, a[r], a[l]));\n                if (take_left)\n       "
    "         {\n                    b[k] = a[l];\n                    l += 1;\n                }\n          "
    "      else\n                {\n                    b[k] = a[r];\n                    r += 1;\n          "
    "      }\n                k += 1;\n            }\n            lo = hi;\n        }\n        swap(&mut a, &m"
    "ut b);\n        width = if (width > n)\n        {\n            n\n        }\n        else\n        {\n     "
    "       width * 2\n        };\n    }\n    a\n}fn Vec::apply_order<T>(ref<Vec<T>, exclusive> v, ref<Vec<us"
    "ize>, shared> order)\n{\n    Vec<T> out = Vec::new();\n    foreach (p in order)\n    {\n        Vec::push"
    "(&mut out, Vec::take_raw(v, *p));\n    }\n    v.len = 0;\n    swap(v, &mut out);\n}export fn Vec::sort_b"
    "y<T>(ref<Vec<T>, exclusive> v, fn(ref<T, shared>, ref<T, shared>) : bool less)\n{\n    if (v.len < 2)\n"
    "    {\n        return;\n    }\n    Vec<usize> order = Vec::sorted_order(v, less);\n    Vec::apply_order("
    "v, &order);\n}unittest \"Vec::sort_by: stable\"\n{\n    Vec<i32> v = Vec::new();\n    Vec::push(&mut v, 13"
    ");\n    Vec::push(&mut v, 21);\n    Vec::push(&mut v, 12);\n    Vec::push(&mut v, 25);\n    Vec::sort_by"
    "(&mut v, [](ref<i32, shared> a, ref<i32, shared> b) : bool { *a / 10 < *b / 10 });\n    assert(v[0] ="
    "= 13 && v[1] == 12 && v[2] == 21 && v[3] == 25);\n}export fn Vec::sort<T>(ref<Vec<T>, exclusive> v)\n{"
    "\n    if (v.len < 2)\n    {\n        return;\n    }\n    Vec<usize> order = Vec::sorted_order_keys(v);\n  "
    "  Vec::apply_order(v, &order);\n}export fn Vec::binary_search_by<T>(\n    ref<Vec<T>, shared> v,\n    r"
    "ef<T, shared> key,\n    fn(ref<T, shared>, ref<T, shared>) : bool less,\n) : Result<usize, usize>\n{\n  "
    "  usize lo = 0;\n    usize hi = v.len;\n    while (lo < hi)\n    {\n        usize mid = lo + (hi - lo) /"
    " 2;\n        if (less(Vec::index_shared(v, mid), key))\n        {\n            lo = mid + 1;\n        }\n"
    "        else\n        {\n            hi = mid;\n        }\n    }\n    if (lo < v.len && !less(key, Vec::i"
    "ndex_shared(v, lo)))\n    {\n        return Ok(lo);\n    }\n    Err(lo)\n}export fn Vec::binary_search<T>"
    "(ref<Vec<T>, shared> v, probe<T> key) : Result<usize, usize>\n{\n    // `binary_search_by`'s search, t"
    "he key a probe (D-0312).\n    usize lo = 0;\n    usize hi = v.len;\n    while (lo < hi)\n    {\n        u"
    "size mid = lo + (hi - lo) / 2;\n        if (key_less(Vec::index_shared(v, mid), key))\n        {\n     "
    "       lo = mid + 1;\n        }\n        else\n        {\n            hi = mid;\n        }\n    }\n    if ("
    "lo < v.len && !key_less(key, Vec::index_shared(v, lo)))\n    {\n        return Ok(lo);\n    }\n    Err(l"
    "o)\n}unittest \"Vec::binary_search: found and missing\"\n{\n    Vec<i32> v = Vec::new();\n    Vec::push(&m"
    "ut v, 10);\n    Vec::push(&mut v, 20);\n    Vec::push(&mut v, 20);\n    Vec::push(&mut v, 30);\n    i32 "
    "present = 20;\n    i32 absent = 25;\n    assert(Result::unwrap_or(Vec::binary_search(&v, present), 99)"
    " == 1);\n    match (Vec::binary_search(&v, absent))\n    {\n        Ok(_)  : assert(false),\n        Err"
    "(i) : assert(i == 3),\n    }\n}fn Vec::take_raw<T>(ref<Vec<T>, exclusive> v, usize i) : T\n{\n    unsafe"
    "\n    {\n        rawptr<T> p = v.ptr + reinterpret<isize>(i);\n        auto x = *p;\n        release(rei"
    "nterpret_ptr<u8>(p), sizeof<T>());\n        x\n    }\n}export fn Vec::clear<T>(ref<Vec<T>, exclusive> v"
    ")\n{\n    usize i = 0;\n    while (i < v.len)\n    {\n        drop(Vec::take_raw(v, i));\n        i = i + "
    "1;\n    }\n    v.len = 0;\n}fn Vec::drain<T>(Vec<T> v) : Drain<T>\n{\n    Drain { .v = v, .next = 0 }\n}fn"
    " Drain::total<T>(ref<Drain<T>, shared> d) : usize\n{\n    d.v.len\n}fn Drain::take<T>(ref<Drain<T>, exc"
    "lusive> d) : T\n{\n    auto x = Vec::take_raw(&mut d.v, d.next);\n    d.next = d.next + 1;\n    x\n}fn Dr"
    "ain::drop<T>(ref<Drain<T>, exclusive> self)\n{\n    while (self.next < self.v.len)\n    {\n        drop("
