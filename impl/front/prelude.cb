    "    }\n    if (b == b'[')\n    {\n        if (depth >= MAX_DEPTH)\n        {\n            return Err(OutO"
    "fRange);\n        }\n        r.at += 1;\n        Vec<Json> items = Vec::new();\n        JsonReader::skip"
    "_space(r);\n        if (JsonReader::peek(r) == b']')\n        {\n            r.at += 1;\n            ret"
    "urn Ok(JsonArray(items));\n        }\n        while (true)\n        {\n            Json v = JsonReader::"
    "value(r, depth + 1)?;\n            Vec::push(&mut items, v);\n            JsonReader::skip_space(r);\n "
