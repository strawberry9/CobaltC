    "f<Vec<T>, exclusive> v) : Option<T>\n{\n    if (v.len == 0)\n    {\n        return None;\n    }\n    v.len"
    " = v.len - 1;\n    unsafe\n    {\n        rawptr<T> p = v.ptr + reinterpret<isize>(v.len);\n        auto"
    " x = *p;\n        release(reinterpret_ptr<u8>(p), sizeof<T>());\n        Some(x)\n    }\n}export fn Vec:"
    ":index_shared<T>(ref<Vec<T>, shared> v, usize i) : ref<T, shared>\n    requires\n    {\n        i < v.l"
    "en, index_out_of_bounds;\n    }\n{\n    unsafe\n    {\n        &reclaim<T>(v.ptr + reinterpret<isize>(i))"
    "\n    }\n}export fn Vec::index_exclusive<T>(ref<Vec<T>, exclusive> v, usize i) : ref<T, exclusive>\n   "
    " requires\n    {\n        i < v.len, index_out_of_bounds;\n    }\n{\n    // D-0222: element i of `*v` is "
    "accessed exclusively through `v`, as `[Index-Vec]` checks `(*v)[i]`\n    // written: a live shared pa"
    "th to the vector, or a slice holding i, meets it.\n    _ = &mut (*v)[i .. i + 1];\n    unsafe\n    {\n  "
    "      &mut reclaim<T>(v.ptr + reinterpret<isize>(i))\n    }\n}fn Vec::grow<T>(ref<Vec<T>, exclusive> v"
    ")\n{\n    usize new_cap = if (v.cap == 0)\n    {\n        4\n    }\n    else\n    {\n        v.cap * 2\n    }"
    ";\n    usize bytes = new_cap * sizeof<T>();\n    rawptr<u8> p = match (allocate(bytes, alignof<T>()))\n"
    "    {\n        Ok(p)  : p,\n        Err(_) : fault(alloc_failure),\n    };\n    rawptr<u8> old = reinter"
    "pret_ptr<u8>(v.ptr);\n    usize old_cap = v.cap;\n    unsafe\n    {\n        copy_raw(p, old, v.len * si"
    "zeof<T>());\n    }\n    // The two checked writes before the old cells go (CHG-0332): a write\n    // t"
    "hat faults (this exclusive path's first write meeting a shared path\n    // of the same `Vec`, D-0022"
    ") leaves `v` as it was, so the unwind's\n    // `Vec::drop` frees the old cells once; the new block i"
    "s then lost\n    // with the thread.\n    v.ptr = reinterpret_ptr<T>(p);\n    v.cap = new_cap;\n    unsa"
    "fe\n    {\n        if (old_cap > 0)\n        {\n            deallocate(old, old_cap * sizeof<T>(), align"
    "of<T>());\n        }\n    }\n}export fn Vec::reserve<T>(ref<Vec<T>, exclusive> v, usize n)\n{\n    usize "
    "need = v.len + n;\n    if (need <= v.cap)\n    {\n        return;\n    }\n    usize new_cap = if (v.cap >"
    " need - v.cap)\n    {\n        v.cap * 2\n    }\n    else\n    {\n        need\n    };\n    usize bytes = ne"
    "w_cap * sizeof<T>();\n    rawptr<u8> p = match (allocate(bytes, alignof<T>()))\n    {\n        Ok(p)  :"
    " p,\n        Err(_) : fault(alloc_failure),\n    };\n    rawptr<u8> old = reinterpret_ptr<u8>(v.ptr);\n "
    "   usize old_cap = v.cap;\n    unsafe\n    {\n        copy_raw(p, old, v.len * sizeof<T>());\n    }\n    "
    "// The two checked writes before the old cells go (CHG-0332): a write\n    // that faults (this exclu"
    "sive path's first write meeting a shared path\n    // of the same `Vec`, D-0022) leaves `v` as it was"
    ", so the unwind's\n    // `Vec::drop` frees the old cells once; the new block is then lost\n    // wit"
    "h the thread.\n    v.ptr = reinterpret_ptr<T>(p);\n    v.cap = new_cap;\n    unsafe\n    {\n        if (o"
    "ld_cap > 0)\n        {\n            deallocate(old, old_cap * sizeof<T>(), alignof<T>());\n        }\n  "
    "  }\n}export fn Vec::drop<T>(ref<Vec<T>, exclusive> self)\n{\n    usize mut_i = 0;\n    while (mut_i < s"
    "elf.len)\n    {\n        unsafe\n        {\n            drop(reclaim<T>(self.ptr + reinterpret<isize>(mu"
    "t_i)));\n        }\n        mut_i = mut_i + 1;\n    }\n    if (self.cap > 0)\n    {\n        unsafe\n      "
    "  {\n            deallocate(reinterpret_ptr<u8>(self.ptr), self.cap * sizeof<T>(), alignof<T>());\n   "
    "     }\n    }\n}fn key_before<T>(ref<T, shared> a, ref<T, shared> b) : bool\n{\n    key_less(a, b)\n}fn V"
    "ec::sorted_order<T>(ref<Vec<T>, shared> v, fn(ref<T, shared>, ref<T, shared>) : bool less) : Vec<usi"
    "ze>\n{\n    usize n = v.len;\n    Vec<usize> a = Vec::new();\n    Vec<usize> b = Vec::new();\n    usize i"
    " = 0;\n    while (i < n)\n    {\n        Vec::push(&mut a, i);\n        Vec::push(&mut b, 0);\n        i "
    "+= 1;\n    }\n    usize width = 1;\n    while (width < n)\n    {\n        usize lo = 0;\n        while (lo"
    " < n)\n        {\n            usize mid = if (n - lo > width)\n            {\n                lo + width"
    "\n            }\n            else\n            {\n                n\n            };\n            usize hi "
    "= if (n - mid > width)\n            {\n                mid + width\n            }\n            else\n    "
    "        {\n                n\n            };\n            usize l = lo;\n            usize r = mid;\n    "
    "        usize k = lo;\n            while (k < hi)\n            {\n                // From the left run "
    "unless the right one's element is\n                // strictly less: equal elements keep their order."
    "\n                bool take_left = l < mid && (r >= hi || !less(Vec::index_shared(v, a[r]), Vec::inde"
    "x_shared(v, a[l])));\n                if (take_left)\n                {\n                    b[k] = a[l"
    "];\n                    l += 1;\n                }\n                else\n                {\n            "
    "        b[k] = a[r];\n                    r += 1;\n                }\n                k += 1;\n         "
    "   }\n            lo = hi;\n        }\n        swap(&mut a, &mut b);\n        width = if (width > n)\n   "
    "     {\n            n\n        }\n        else\n        {\n            width * 2\n        };\n    }\n    a\n}"
    "fn Vec::sorted_order_keys<T>(ref<Vec<T>, shared> v) : Vec<usize>\n{\n    usize n = v.len;\n    Vec<usiz"
    "e> a = Vec::new();\n    Vec<usize> b = Vec::new();\n    usize i = 0;\n    while (i < n)\n    {\n        V"
    "ec::push(&mut a, i);\n        Vec::push(&mut b, 0);\n        i += 1;\n    }\n    usize width = 1;\n    wh"
    "ile (width < n)\n    {\n        usize lo = 0;\n        while (lo < n)\n        {\n            usize mid ="
    " if (n - lo > width)\n            {\n                lo + width\n            }\n            else\n       "
    "     {\n                n\n            };\n            usize hi = if (n - mid > width)\n            {\n  "
    "              mid + width\n            }\n            else\n            {\n                n\n           "
    " };\n            usize l = lo;\n            usize r = mid;\n            usize k = lo;\n            while"
    " (k < hi)\n            {\n                bool take_left = l < mid && (r >= hi || !key_less_at(v, a[r]"
    ", a[l]));\n                if (take_left)\n                {\n                    b[k] = a[l];\n        "
    "            l += 1;\n                }\n                else\n                {\n                    b[k"
    "] = a[r];\n                    r += 1;\n                }\n                k += 1;\n            }\n      "
    "      lo = hi;\n        }\n        swap(&mut a, &mut b);\n        width = if (width > n)\n        {\n    "
    "        n\n        }\n        else\n        {\n            width * 2\n        };\n    }\n    a\n}fn Vec::app"
    "ly_order<T>(ref<Vec<T>, exclusive> v, ref<Vec<usize>, shared> order)\n{\n    Vec<T> out = Vec::new();\n"
    "    foreach (p in order)\n    {\n        Vec::push(&mut out, Vec::take_raw(v, *p));\n    }\n    v.len = "
    "0;\n    swap(v, &mut out);\n}export fn Vec::sort_by<T>(ref<Vec<T>, exclusive> v, fn(ref<T, shared>, re"
    "f<T, shared>) : bool less)\n{\n    if (v.len < 2)\n    {\n        return;\n    }\n    Vec<usize> order = V"
    "ec::sorted_order(v, less);\n    Vec::apply_order(v, &order);\n}unittest \"Vec::sort_by: stable\"\n{\n    V"
    "ec<i32> v = Vec::new();\n    Vec::push(&mut v, 13);\n    Vec::push(&mut v, 21);\n    Vec::push(&mut v, "
    "12);\n    Vec::push(&mut v, 25);\n    Vec::sort_by(&mut v, [](ref<i32, shared> a, ref<i32, shared> b) "
    ": bool { *a / 10 < *b / 10 });\n    assert(v[0] == 13 && v[1] == 12 && v[2] == 21 && v[3] == 25);\n}ex"
    "port fn Vec::sort<T>(ref<Vec<T>, exclusive> v)\n{\n    if (v.len < 2)\n    {\n        return;\n    }\n    "
    "Vec<usize> order = Vec::sorted_order_keys(v);\n    Vec::apply_order(v, &order);\n}export fn Vec::binar"
    "y_search_by<T>(\n    ref<Vec<T>, shared> v,\n    ref<T, shared> key,\n    fn(ref<T, shared>, ref<T, sha"
    "red>) : bool less,\n) : Result<usize, usize>\n{\n    usize lo = 0;\n    usize hi = v.len;\n    while (lo "
    "< hi)\n    {\n        usize mid = lo + (hi - lo) / 2;\n        if (less(Vec::index_shared(v, mid), key)"
    ")\n        {\n            lo = mid + 1;\n        }\n        else\n        {\n            hi = mid;\n       "
    " }\n    }\n    if (lo < v.len && !less(key, Vec::index_shared(v, lo)))\n    {\n        return Ok(lo);\n  "
    "  }\n    Err(lo)\n}export fn Vec::binary_search<T>(ref<Vec<T>, shared> v, probe<T> key) : Result<usize"
    ", usize>\n{\n    // `binary_search_by`'s search, the key a probe (D-0312).\n    usize lo = 0;\n    usize"
    " hi = v.len;\n    while (lo < hi)\n    {\n        usize mid = lo + (hi - lo) / 2;\n        if (key_less("
    "Vec::index_shared(v, mid), key))\n        {\n            lo = mid + 1;\n        }\n        else\n        "
    "{\n            hi = mid;\n        }\n    }\n    if (lo < v.len && !key_less(key, Vec::index_shared(v, lo"
    ")))\n    {\n        return Ok(lo);\n    }\n    Err(lo)\n}unittest \"Vec::binary_search: found and missing\""
    "\n{\n    Vec<i32> v = Vec::new();\n    Vec::push(&mut v, 10);\n    Vec::push(&mut v, 20);\n    Vec::push("
