    ": flags, options, the rest\":\n        Vec<String> items = Vec::new();\n        Vec::push(&mut items, \""
    "-v\");\n        Vec::push(&mut items, \"--out=a.txt\");\n        Vec::push(&mut items, \"in.txt\");\n       "
    " Args a = Args::from(items, \"prog [options] FILE\");\n        assert(Args::flag(&mut a, \"verbose\", \"v\""
    ", \"say more\"));\n        assert(Option::unwrap(Args::option(&mut a, \"out\", \"o\", \"FILE\", \"where to wri"
