    "u64, 5> b) : array<u64, 5>\n{\n    fe_carry([\n        a[0] + 0x1fffffffffffb4 - b[0],\n        a[1] + 0"
    "x1ffffffffffffc - b[1],\n        a[2] + 0x1ffffffffffffc - b[2],\n        a[3] + 0x1ffffffffffffc - b["
    "3],\n        a[4] + 0x1ffffffffffffc - b[4],\n    ])\n}fn fe_mul(array<u64, 5> a, array<u64, 5> b) : ar"
    "ray<u64, 5>\n{\n    u128 a0 = widen<u128>(a[0]);\n    u128 a1 = widen<u128>(a[1]);\n    u128 a2 = widen<"
    "u128>(a[2]);\n    u128 a3 = widen<u128>(a[3]);\n    u128 a4 = widen<u128>(a[4]);\n    u128 b0 = widen<u"
    "128>(b[0]);\n    u128 b1 = widen<u128>(b[1]);\n    u128 b2 = widen<u128>(b[2]);\n    u128 b3 = widen<u1"
    "28>(b[3]);\n    u128 b4 = widen<u128>(b[4]);\n    u128 b1_19 = b1 * 19;\n    u128 b2_19 = b2 * 19;\n    "
    "u128 b3_19 = b3 * 19;\n    u128 b4_19 = b4 * 19;\n    u128 t0 = a0 * b0 + a1 * b4_19 + a2 * b3_19 + a3"
