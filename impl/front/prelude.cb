    "nvalid(r.at));\n            }\n            r.at += 1;\n            Json v = JsonReader::value(r, depth "
    "+ 1)?;\n            Vec::push(&mut members, JsonMember { .key = key, .value = v });\n            JsonR"
    "eader::skip_space(r);\n            u8 c = JsonReader::peek(r);\n            r.at += 1;\n            if "
    "(c == b'}')\n            {\n                return Ok(JsonObject(members));\n            }\n            "
