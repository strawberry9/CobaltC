    ", 0)?;\n    JsonReader::skip_space(&mut r);\n    if (r.at < StringView::len(text))\n    {\n        retur"
    "n Err(Invalid(r.at));\n    }\n    Ok(v)\n}unittest \"Json::parse: where the error is\"\n{\n    match (Json:"
    ":parse(\"[1, 2\"))\n    {\n        Err(Invalid(i)) : assert(i == 5),\n        _               : assert(fa"
    "lse),\n    }\n    match (Json::parse(\"[1] x\"))\n    {\n        Err(Invalid(i)) : assert(i == 4),\n       "
