    ":len(&v) == 3);\n    Vec::truncate(&mut v, 1);\n    assert(Vec::len(&v) == 1);\n}export fn Vec::clone_b"
    "y<T>(ref<Vec<T>, shared> v, fn(ref<T, shared>) : T copy) : Vec<T>\n{\n    Vec<T> out = Vec::new();\n   "
