    " Vec::swap(v, k, k + 1);\n        k = k + 1;\n    }\n    match (Vec::pop(v))\n    {\n        Some(x) : x,"
    "\n        None    : fault(index_out_of_bounds),\n    }\n}export fn Vec::swap_remove<T>(ref<Vec<T>, excl"
    "usive> v, usize i) : T\n    requires\n    {\n        i < v.len, index_out_of_bounds;\n    }\n{\n    usize "
    "last = v.len - 1;\n    Vec::swap(v, i, last);\n    match (Vec::pop(v))\n    {\n        Some(x) : x,\n    "
