    "..19]) })\n}export fn UdpSocket::drop(ref<UdpSocket, exclusive> self)\n{\n    i64 r = net_num(14, self."
    "id, StringView::of(\"\").bytes, StringView::of(\"\").bytes, 0);\n}export fn TcpStream::set_keepalive(ref<"
    "TcpStream, exclusive> s, bool on)\n{\n    i64 r = net_num(20, s.id, StringView::of(\"\").bytes, StringVi"
