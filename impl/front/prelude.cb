    "   }\n{\n    Vec::push(v, x);\n    usize k = v.len - 1;\n    while (k > i)\n    {\n        Vec::swap(v, k "
    "- 1, k);\n        k = k - 1;\n    }\n}unittest \"Vec::insert: middle and end\"\n{\n    Vec<i32> v = Vec::ne"
    "w();\n    Vec::push(&mut v, 1);\n    Vec::push(&mut v, 3);\n    Vec::insert(&mut v, 1, 2);\n    Vec::ins"
    "ert(&mut v, 3, 4);\n    assert(Vec::len(&v) == 4);\n    assert(v[0] == 1 && v[1] == 2 && v[2] == 3 && "
    "v[3] == 4);\n}export fn Vec::remove<T>(ref<Vec<T>, exclusive> v, usize i) : T\n    requires\n    {\n    "
