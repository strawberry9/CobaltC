    "aled = aes_gcm_seal(&key, &nonce, &none, &plain);\n    String want = \"0388dace60b6a392f328c2b971b2fe7"
    "8\";\n    String::append(&mut want, \"ab6e47d42cec13bdf53a67b21257bddf\");\n    assert((to_hex(&sealed) ="
    "= want));\n    Vec<u8> opened = Option::unwrap(aes_gcm_open(&key, &nonce, &none, &sealed));\n    asser"
    "t(slice_eq(&opened, &plain));\n    assert(Option::is_none(&aes_gcm_open(&key, &nonce, b\"aad\", &sealed"
    ")));\n}export fn aes_gcm_open(\n    slice<u8, shared> key,\n    slice<u8, shared> nonce,\n    slice<u8, "
    "shared> aad,\n    slice<u8, shared> sealed,\n) : Option<Vec<u8>>\n{\n    array<u8, 16> j0 = gcm_j0(nonce"
    ");\n    AesKey k = aes_expand(key);\n    usize n = slice_len(sealed);\n    if (n < 16)\n    {\n        re"
    "turn None;\n    }\n    array<u8, 16> want = gcm_tag(&k, j0, aad, &sealed[0..n - 16]);\n    if (!digest_"
    "eq(&want, &sealed[n - 16..n]))\n    {\n        return None;\n    }\n    Some(gcm_ctr(&k, j0, &sealed[0.."
    "n - 16]))\n}fn fe_carry(array<u64, 5> f) : array<u64, 5>\n{\n    array<u64, 5> r = f;\n    for (usize i "
    "= 0; i < 4; i += 1)\n    {\n        r[i + 1] += r[i] >> 51;\n        r[i] = r[i] & FE_MASK;\n    }\n    u"
    "64 c = r[4] >> 51;\n    r[4] = r[4] & FE_MASK;\n    r[0] += c * 19;\n    r[1] += r[0] >> 51;\n    r[0] ="
