            },
            None    :
            {
                any_unknown = true;
                open_failed = true;
            },
        }
    }
    Flow nf_33783 = Option::unwrap_or(joined, base);
    flow_assign(b, nf_33783);
    // The binders' views of a scrutinee temporary end with the `match`.
    foreach (a in arms)
    {
        match (&a.binder)
        {
            Some(bn) :
            {
                _ = HashMap::remove(&mut b.temp_views, bn);
            },
            None     : {},
        }
    }
    if (any_unknown)
    {
        if (!open_failed)
        {
            match (&open_arms)
            {
                Some(o) :
                {
                    Option<Type> filled = match (&result)
                    {
                        Some(r) : if (is_never(r)) { Some(clone(o)) } else { merge_open(o, r, 0) },
                        None    : Some(clone(o)),
                    };
                    match (filled)
                    {
                        Some(t) :
                        {
                            if (!has_unresolved_marker(&t))
                            {
                                return Ok(Some(t));
                            }
                        },
                        None    : {},
                    }
                },
                None    : {},
            }
        }
        return Ok(None);
    }
    Ok(result)
}

fn sets_eq(ref<HashSet<String>, shared> a, ref<HashSet<String>, shared> c) : bool
{
    if (HashSet::len(a) != HashSet::len(c))
    {
        return false;
    }
    for (usize i = 0; i < HashSet::len(a); i += 1)
    {
        if (!HashSet::contains(c, HashSet::key_at(a, i)))
        {
            return false;
        }
    }
    true
}

// `diag.capture-list-mismatch` (`rule.fn.closure`, spec/15 §6) and the
// closure's body, checked as a body of its own.
fn check_closure(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    bool is_move,
    ref<Vec<String>, shared> captures,
    ref<Vec<ParamDecl>, shared> params,
    ref<Option<Type>, shared> declared_ret0,
    ref<Block, shared> body,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // D-0323: a closure's body is no statement of the function's.
    bool nested = replace(&mut b.recover_nested, false);
    Result<Option<Type>, String> r = check_closure_body(b, it, is_move, captures, params, declared_ret0, body, expected);
    b.recover_nested = nested;
    r
}

fn check_closure_body(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    bool is_move,
    ref<Vec<String>, shared> captures,
    ref<Vec<ParamDecl>, shared> params,
    ref<Option<Type>, shared> declared_ret0,
    ref<Block, shared> body,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // Free variables computed against only the parameters as bound.
    HashSet<String> bound = HashSet::new();
    for (usize i = 0; i < Vec::len(params); i += 1)
    {
        HashSet::insert(&mut bound, String::clone(&params[i].name));
    }
    HashSet<String> free0 = HashSet::new();
    collect_free_vars_block(body, &mut bound, &mut free0);
    // An item named by a bare identifier is not a free variable; nor a hidden
    // name (`$each_range`, a range `foreach`'s), which no program can write in
    // its capture list (CHG-0452).
    HashSet<String> free = HashSet::new();
    for (usize i = 0; i < HashSet::len(&free0); i += 1)
    {
        ref<String, shared> n = HashSet::key_at(&free0, i);
        if (!is_item_name(it, n) && !StringView::starts_with(n, "$"))
        {
            HashSet::insert(&mut free, String::clone(n));
        }
    }
    HashSet<String> declared = HashSet::new();
    for (usize i = 0; i < Vec::len(captures); i += 1)
    {
        HashSet::insert(&mut declared, String::clone(&captures[i]));
    }
    if (!sets_eq(&free, &declared))
    {
        // CHG-0452: which names, and the list to write.
        Vec<String> used = Vec::new();
        Vec<String> missing = Vec::new();
        Vec<String> extra = Vec::new();
        for (usize i = 0; i < HashSet::len(&free); i += 1)
        {
            ref<String, shared> n = HashSet::key_at(&free, i);
            Vec::push(&mut used, String::clone(n));
            if (!HashSet::contains(&declared, n))
            {
                Vec::push(&mut missing, String::clone(n));
            }
        }
        for (usize i = 0; i < HashSet::len(&declared); i += 1)
        {
            ref<String, shared> n = HashSet::key_at(&declared, i);
            if (!HashSet::contains(&free, n))
            {
                Vec::push(&mut extra, String::clone(n));
            }
        }
        Vec::sort(&mut used);
        Vec::sort(&mut missing);
        Vec::sort(&mut extra);
        Vec<String> why = Vec::new();
        if (Vec::len(&missing) > 0)
        {
            Vec::push(&mut why, sprintf("the body uses %s without listing it", &quoted_list(&missing)));
        }
        if (Vec::len(&extra) > 0)
        {
            Vec::push(&mut why, sprintf("%s is listed but not used", &quoted_list(&extra)));
        }
        String msg = sprintf(
            "a closure lists exactly the outer locals its body uses, here `[%s]`: %s",
            &String::join(&used, ", "),
            &String::join(&why, ", and "),
        );
        return Err(named_diag("diag.capture-list-mismatch", &msg));
    }
    // Forming the closure, in the enclosing body's flow.
    for (usize i = 0; i < Vec::len(captures); i += 1)
    {
        ref<String, shared> c = &captures[i];
        fl_lit(&mut b.flow, c, None);
        if (!flow_is_tracked(&b.flow, c))
        {
            continue;
        }
        match (HashMap::get(&b.flow.valid, c))
        {
            Some(Tri::F) :
            {
                String msg = sprintf(
                    "`%s` was moved or dropped before this closure captures it",
                    shown_name(c),
                );
                refute(b, &named_diag("diag.stale-binding", &msg))?;
            },
            Some(Tri::U) :
            {
                String msg = sprintf(
                    "`%s` may have been moved or dropped (on some path to here) before this closure captures it",
                    shown_name(c),
                );
                refute(b, &named_diag("diag.stale-binding", &msg))?;
            },
            _            : {},
        }
        if (is_move)
        {
            if (place_is_resource(b, it, c, &Vec::new()))
            {
                flow_consume(b, it, c, "diag.move-while-aliased")?;
            }
            else
            {
                if (!tri_is(&b.flow.init, c, Tri::T))
                {
                    refute(b, &uninit_msg(c))?;
                }
                flow_clash(b, it, c, &Vec::new(), Mode::Shared, "diag.aliasing-conflict")?;
            }
        }
        else
        {
            // A borrow capture borrows the binding: it must have a value, as
            // for `&c` (CHG-0438).
            if (!tri_is(&b.flow.init, c, Tri::T))
            {
                refute(b, &uninit_msg(c))?;
            }
            Mode mode = if (closure_body_writes(body, c)) { Mode::Exclusive } else { Mode::Shared };
            flow_clash(b, it, c, &Vec::new(), mode, "diag.aliasing-conflict")?;
        }
    }
    // The body, checked as a body of its own; a captured name's type is the
    // outer binding's.
    HashMap<String, Option<Type>> outer_capture_types = HashMap::new();
    for (usize i = 0; i < Vec::len(captures); i += 1)
    {
        HashMap::insert(&mut outer_capture_types, String::clone(&captures[i]), lookup_local(b, &captures[i]));
    }
    HashMap<String, Type> saved_gamma = replace(&mut b.gamma, HashMap::new());
    usize gamma_mark = Vec::len(&b.gamma_log);
    for (usize i = 0; i < HashMap::len(&outer_capture_types); i += 1)
    {
        match (HashMap::value_at(&outer_capture_types, i))
        {
            Some(t) :
            {
                gamma_set(b, HashMap::key_at(&outer_capture_types, i), Some(clone(t)));
            },
            None    : {},
        }
    }
    Flow nf_33993 = new_flow();
    Flow saved_flow = flow_swap(b, nf_33993);
    HashMap<String, Option<Type>> saved_move_captures = replace(
        &mut b.move_captures,
        if (is_move) { outer_capture_types } else { HashMap::new() },
    );
    HashSet<String> saved_capture_names = replace(&mut b.capture_names, clone(&declared));
    Vec<Vec<ScopeEntry>> fresh_scopes = Vec::new();
    Vec::push(&mut fresh_scopes, Vec::new());
    Vec<Vec<ScopeEntry>> saved_scopes = replace(&mut b.scopes, fresh_scopes);
    Vec<LoopCtx> saved_loops = replace(&mut b.loops, Vec::new());
    u32 saved_depth = b.while_depth;
    usize root = b.next_block;
    b.next_block += 1;
    Vec<usize> fresh_blocks = Vec::new();
    Vec::push(&mut fresh_blocks, root);
    Vec<usize> saved_blocks = replace(&mut b.block_stack, fresh_blocks);
    HashMap<String, usize> saved_decl = replace(&mut b.decl_block, HashMap::new());
    HashMap<String, Option<Referent>> saved_origin = replace(&mut b.ref_origin, HashMap::new());
    HashSet<String> param_names = HashSet::new();
    for (usize i = 0; i < Vec::len(params); i += 1)
    {
        HashSet::insert(&mut param_names, String::clone(&params[i].name));
    }
    HashSet<String> saved_params = replace(&mut b.params, param_names);
    // A closure's parameters are not the function's: what its body stores
    // is no part of the function's summary (its callers are unknown, and a
    // call of a `fn` value is judged by its arguments' parts).
    HashMap<String, usize> saved_param_idx = replace(&mut b.param_idx, HashMap::new());
    b.while_depth = 0;
    for (usize i = 0; i < Vec::len(params); i += 1)
    {
        gamma_set(b, &params[i].name, Some(apply_subst(&params[i].ty, &b.subst)));
        declare(b, &params[i].name, true);
    }
    // The result the closure is expected to give.
    Option<Type> exp_ret = match (expected)
    {
        Some(Type::TFn(fb)) :
        {
            ref<FnTy, shared> f = Box::get(fb);
            if (Vec::len(&f.params) == Vec::len(params) && !has_unresolved_marker(&f.ret)) { Some(clone(&f.ret)) } else { None }
        },
        _                   : None,
    };
    Vec<Type> ptys = Vec::new();
    for (usize i = 0; i < Vec::len(params); i += 1)
    {
        Vec::push(&mut ptys, apply_subst(&params[i].ty, &b.subst));
    }
    // D-0081: a written result type is what the body is checked against.
    Option<Type> declared_ret = match (declared_ret0)
    {
        Some(t) : Some(apply_subst(t, &b.subst)),
        None    : None,
    };
    Result<Option<Type>, String> r = Ok(None);
    bool bad_decl = false;
    match (&declared_ret)
    {
        Some(d) : match (&exp_ret)
        {
            Some(want) :
            {
                if (!ty_compat(d, want))
                {
                    // Bug 122: the closure's whole signature against the one
                    // expected, each as written.
                    Type expected_fn = match (expected)
                    {
                        Some(t) : clone(t),
                        None    : fn_of(clone(&ptys), clone(want)),
                    };
                    bool params_differ = match (&expected_fn)
                    {
                        Type::TFn(fb) : !types_all_eq(&Box::get(fb).params, &ptys),
                        _             : false,
                    };
                    r = Err(mismatch(sprintf(
                        "the closure is `%s`, but `%s` is expected: its %s",
                        &type_display(&fn_of(clone(&ptys), clone(d))),
                        &type_display(&expected_fn),
                        if (params_differ) { "parameters and its result differ" } else { "result differs" },
                    )));
                    bad_decl = true;
                }
            },
            None       : {},
        },
        None : {},
    }
    Option<Type> exp_final = or_type(declared_ret, exp_ret);
    Vec<ClosureExitAt> exits = Vec::new();
    if (!bad_decl)
    {
        Option<Option<Type>> saved_closure_ret = replace(&mut b.closure_ret, Some(clone(&exp_final)));
        Vec<ClosureExitAt> saved_exits = replace(&mut b.closure_exits, Vec::new());
        r = check_nested_block(b, it, body, &exp_final);
        b.closure_ret = saved_closure_ret;
        exits = replace(&mut b.closure_exits, saved_exits);
    }
    b.move_captures = saved_move_captures;
    b.capture_names = saved_capture_names;
    b.params = saved_params;
    b.param_idx = saved_param_idx;
    b.ref_origin = saved_origin;
    b.decl_block = saved_decl;
    b.block_stack = saved_blocks;
    b.while_depth = saved_depth;
    b.loops = saved_loops;
    b.scopes = saved_scopes;
    Flow nf_34090 = saved_flow;
    flow_assign(b, nf_34090);
    b.gamma = saved_gamma;
    // The closure's own writes were to its own `gamma`.
    Vec::truncate(&mut b.gamma_log, gamma_mark);
    Option<Type> bt = r?;
    // Without a result given beforehand, the body's type is the closure's
    // (spec/15 §6), and each `return` and `?` in it is checked against that
    // type, as against a written one (CHG-0439).
    if (Option::is_none(&exp_final))
    {
        bt = closure_exits_agree(bt, &exits)?;
    }
    // A closure is a value of type `fn(P…) : R`, R its body's type (D-0073).
    bool ptys_open = false;
    for (usize i = 0; i < Vec::len(&ptys); i += 1)
    {
        if (has_unresolved_marker(&ptys[i]))
        {
            ptys_open = true;
        }
    }
    match (bt)
    {
        Some(t) : match (exp_final)
        {
            Some(want) :
            {
                if (!has_unresolved_marker(&t) && !is_never(&t) && !ty_compat(&t, &want))
                {
                    return Err(mismatch(sprintf(
                        "the closure's body gives `%s`, but `%s` is expected",
                        &type_display(&t),
                        &type_display(&fn_of(ptys, want)),
                    )));
                }
                if (is_never(&t))
                {
                    return Ok(Some(fn_of(ptys, want)));
                }
                if (!has_unresolved_marker(&t) && !ptys_open)
                {
                    return Ok(Some(fn_of(ptys, t)));
                }
                Ok(None)
            },
            None       :
            {
                if (!has_unresolved_marker(&t) && !is_never(&t) && !ptys_open)
                {
                    return Ok(Some(fn_of(ptys, t)));
                }
                Ok(None)
            },
        },
        None : Ok(None),
    }
}

// The element type of what `x[i]` and `&x[lo .. hi]` index (D-0047).
fn indexed_elem(ref<Type, shared> t) : Option<Type>
{
    match (t)
    {
        Type::TArray(ab) : Some(clone(&Box::get(ab).inner)),
        Type::TSlice(sb) : Some(clone(&Box::get(sb).inner)),
        Type::TNamed(nb) :
        {
            if (Box::get(nb).name == "std::Vec" && Vec::len(&Box::get(nb).args) > 0)
            {
                return Some(clone(&Box::get(nb).args[0]));
            }
            None
        },
        Type::TRef(rb) : match (&Box::get(rb).inner)
        {
            Type::TRef(_) : None,
            other         : indexed_elem(other),
        },
        _                : None,
    }
}

// `rule.stdlib.print`'s printable types (`never` too).
fn is_printable(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TStr     : true,
        Type::TInt(_)  : true,
        Type::TF32     : true,
        Type::TF64     : true,
        Type::TBool    : true,
        Type::TNever   : true,
        Type::TRef(rb) : Box::get(rb).mode == Mode::Shared && named_is(&Box::get(rb).inner, "std::String"),
        _              : named_is(t, "std::StringView"),
    }
}

// D-0258: an initializer written out as literals.
export fn literal_tree(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EInt(_)         : true,
        ExprKind::EFloat(_)       : true,
        ExprKind::EBool(_)        : true,
        ExprKind::EUnary(ub) : Box::get(ub).op == UnOp::Neg && match (&Box::get(ub).e.kind)
        {
            ExprKind::EInt(_)   : true,
            ExprKind::EFloat(_) : true,
            _                   : false,
        },
        ExprKind::EParen(x)       : literal_tree(Box::get(x)),
        ExprKind::EArrayLit(es)   :
        {
            for (usize i = 0; i < Vec::len(es); i += 1)
            {
                if (!literal_tree(&es[i]))
                {
                    return false;
                }
            }
            true
        },
        ExprKind::EArrayRepeat(r) : literal_tree(&Box::get(r).value),
        ExprKind::EStructLit(sb)  :
        {
            ref<StructLitExpr, shared> s = Box::get(sb);
            for (usize i = 0; i < Vec::len(&s.fields); i += 1)
            {
                if (!literal_tree(&s.fields[i].value))
                {
                    return false;
                }
            }
            true
        },
        _                         : false,
    }
}

// D-0090: the types a bound admits, for messages.
fn bound_members(Bound bd) : str
{
    match (bd)
    {
        Bound::BEq      : "a number, `bool`, `str`, `String`, or a struct or enum whose fields are integers, `bool`s, text or such types, with no floating-point field",
        Bound::BOrdered : "a number, `bool`, `str`, `String`, or a struct or enum whose fields are integers, `bool`s, text or such types, with no floating-point field",
        Bound::BNumber  : "an integer or floating-point type",
        Bound::BInteger : "an integer type",
        Bound::BClone   : "a plain type, `String`, `Rc<T>`, `Box<T: clone>`, `Vec<T: clone>`, a hash table of them, a type with its own `T::clone`, or a struct or enum of `clone` types",
        Bound::BPlain   : "a number, `bool`, a raw pointer, a `simd`, or an array, struct or enum of those",
    }
}

// D-0111: for each statement, the bindings whose last mention it is.
struct EarlyPlan
{
    // The id of each statement's expression (`stmt_expr_id`): which block
    // the plan is of.
    Vec<usize> ids;
    Vec<Vec<Waiting>> ends;
    Vec<HashSet<String>> mentions;
    HashSet<String> tail;
    // Bug 021: for each name, the statements that mention it, in order;
    // for each statement `j`, the first statement from `j` on that may
    // leave the block (`stmt_may_leave`; the number of statements for
    // none); for each name, the statements that overwrite it
    // (`stmt_overwrites`), in order.
    HashMap<String, Vec<usize>> at;
    Vec<usize> next_leave;
    HashMap<String, Vec<usize>> overwrites_at;
    // Report 265: the bindings the block declares once (not named by its
    // tail), of which those holding references whose end frees memory alone
    // end after its last statement (`end_quiet_holders`).
    Vec<String> at_close;
    // Report 292: the bindings the block declares once, or takes as extras,
    // that its tail names (`nest_into_tail`).
    Vec<String> tail_names;
}

struct DeclCount
{
    usize first;
    usize count;
}

fn early_end_plan(ref<Block, shared> blk) : EarlyPlan
{
    early_end_plan_with(blk, &Vec::new())
}

// `extra`: bindings made before the block's first statement (a `match`
// arm's binder, report 052), which end after their last mention in it.
fn early_end_plan_with(ref<Block, shared> blk, ref<Vec<String>, shared> extra) : EarlyPlan
{
    usize n = Vec::len(&blk.stmts);
    Vec<Vec<Waiting>> plan = Vec::new();
    Vec<HashSet<String>> mentions = Vec::new();
    HashMap<String, Vec<usize>> at = HashMap::new();
    HashMap<String, Vec<usize>> overwrites_at = HashMap::new();
    for (usize i = 0; i < n; i += 1)
    {
        Vec::push(&mut plan, Vec::new());
        HashSet<String> ms = stmt_mentions(&blk.stmts[i]);
        foreach (m in &ms)
        {
            Vec::push(HashMap::entry(&mut at, m, Vec::new()), i);
        }
        Vec::push(&mut mentions, ms);
        match (overwritten_name(&blk.stmts[i]))
        {
            Some(m) : Vec::push(HashMap::entry(&mut overwrites_at, &m, Vec::new()), i),
            None    : {},
        }
    }
    Vec<usize> next_leave = Vec::new();
    for (usize i = 0; i < n; i += 1)
    {
        Vec::push(&mut next_leave, n);
    }
    usize nl = n;
    for (usize i = n; i > 0; i -= 1)
    {
        if (stmt_may_leave(&blk.stmts[i - 1]))
        {
            nl = i - 1;
        }
        next_leave[i - 1] = nl;
    }
    HashSet<String> tail = HashSet::new();
    match (&blk.tail)
    {
        Some(e) :
        {
            HashSet<String> bound = HashSet::new();
            collect_free_vars_expr(Box::get(e), &mut bound, &mut tail);
        },
        None    : {},
    }
    HashSet<String> captured = HashSet::new();
    for (usize i = 0; i < n; i += 1)
    {
        closure_captures_stmt(&blk.stmts[i], &mut captured);
    }
    match (&blk.tail)
    {
        Some(e) : closure_captures_expr(Box::get(e), &mut captured),
        None    : {},
    }
    HashMap<String, DeclCount> declared = HashMap::new();
    Vec<String> at_close = Vec::new();
    for (usize i = 0; i < n; i += 1)
    {
        match (&blk.stmts[i])
        {
            Stmt::SLet(l) :
            {
                ref<DeclCount, exclusive> dc = HashMap::entry(
                    &mut declared,
                    &Box::get(l).name,
                    DeclCount { .first = i, .count = 0 },
                );
                dc.count += 1;
            },
            _             : {},
        }
    }
    Vec<String> tail_names = Vec::new();
    for (usize k = 0; k < HashMap::len(&declared); k += 1)
    {
        ref<String, shared> name = HashMap::key_at(&declared, k);
        ref<DeclCount, shared> dc = HashMap::value_at(&declared, k);
        if (dc.count == 1 && !StringView::starts_with(name, "$") && HashSet::contains(&tail, name) && !HashSet::contains(&captured, name))
        {
            Vec::push(&mut tail_names, String::clone(name));
        }
        if (dc.count != 1 || StringView::starts_with(
            name,
            "$",
        ) || HashSet::contains(&tail, name) || HashSet::contains(&captured, name))
        {
            continue;
        }
        usize d = dc.first;
        usize last = d;
        match (HashMap::get(&at, name))
        {
            Some(v) :
            {
                if (Vec::len(v) > 0 && v[Vec::len(v) - 1] > d)
                {
                    last = v[Vec::len(v) - 1];
                }
            },
            None    : {},
        }
        // Report 265: one last mentioned by the last statement ends there
        // too, before the block's exit destroys what it may refer to.
        Vec::push(&mut plan[last], Waiting { .name = String::clone(name), .decl = d });
        Vec::push(&mut at_close, String::clone(name));
    }
    for (usize xi = 0; xi < Vec::len(extra); xi += 1)
    {
        String name = String::clone(&extra[xi]);
        bool hidden = StringView::starts_with(&name, "$");
        if (!hidden && !HashMap::contains(&declared, &name) && HashSet::contains(&tail, &name) && !HashSet::contains(&captured, &name))
        {
            Vec::push(&mut tail_names, String::clone(&name));
        }
        if (n == 0 || hidden || HashMap::contains(&declared, &name) || HashSet::contains(&tail, &name) || HashSet::contains(&captured, &name))
        {
            continue;
        }
        usize last = 0;
        match (HashMap::get(&at, &name))
        {
            Some(v) :
            {
                if (Vec::len(v) > 0)
                {
                    last = v[Vec::len(v) - 1];
                }
            },
            None    : {},
        }
        Vec::push(&mut plan[last], Waiting { .name = String::clone(&name), .decl = 0 });
    }
    for (usize i = 0; i < n; i += 1)
    {
        sort_waiting(&mut plan[i]);
    }
    Vec<usize> ids = Vec::new();
    for (usize i = 0; i < n; i += 1)
    {
        Vec::push(&mut ids, stmt_expr_id(&blk.stmts[i]));
    }
    EarlyPlan {
        .ids = ids,
        .ends = plan,
        .mentions = mentions,
        .tail = tail,
        .at = at,
        .next_leave = next_leave,
        .overwrites_at = overwrites_at,
        .at_close = at_close,
        .tail_names = tail_names,
    }
}

// The order of Rust's `(String, usize)` tuples.
fn sort_waiting(ref<Vec<Waiting>, exclusive> v)
{
    for (usize i = 1; i < Vec::len(v); i += 1)
    {
        usize j = i;
        while (j > 0 && ((v[j].name < (v[j - 1].name)) || ((v[j].name == (v[j - 1].name)) && v[j].decl < v[j - 1].decl)))
        {
            Vec::swap(v, j - 1, j);
            j -= 1;
        }
    }
}

// The names statement `s` mentions.
fn stmt_mentions(ref<Stmt, shared> s) : HashSet<String>
{
    HashSet<String> free = HashSet::new();
    HashSet<String> bound = HashSet::new();
    match (s)
    {
        Stmt::SLet(l)         :
        {
            match (&Box::get(l).init)
            {
                Some(e) : collect_free_vars_expr(e, &mut bound, &mut free),
                None    : {},
            }
        },
        Stmt::SDestructure(d) : collect_free_vars_expr(&Box::get(d).init, &mut bound, &mut free),
        Stmt::SExpr(e)        : collect_free_vars_expr(Box::get(e), &mut bound, &mut free),
        Stmt::SBlockLike(e)   : collect_free_vars_expr(Box::get(e), &mut bound, &mut free),
    }
    free
}

fn closure_captures_stmt(ref<Stmt, shared> s, ref<HashSet<String>, exclusive> out)
{
    // A `move` closure bound whole (`auto f = move […]…`, `f = move […]…`)
    // holds a copy of each capture, and its binding the facts the capture
    // held (`closure_facts_of`): the capture may end before it. A closure
    // anywhere else (an argument, `spawn`'s, a callee) carries no facts,
    // so what it captures stays alive.
    Option<ref<Expr, shared>> bound = match (s)
    {
        Stmt::SLet(l) : match (&Box::get(l).init)
        {
            Some(e) : Some(e),
            None    : None,
        },
        Stmt::SExpr(e) : match (&strip_parens_tc(Box::get(e)).kind)
        {
            ExprKind::EAssign(pb) : match (one_seg(strip_parens_tc(&Box::get(pb).a)))
            {
                Some(_) : Some(&Box::get(pb).b),
                None    : None,
            },
            _ : None,
        },
        _ : None,
    };
    match (bound)
    {
        Some(e) : match (&strip_parens_tc(e).kind)
        {
            ExprKind::EClosure(cb) :
            {
                if (Box::get(cb).is_move)
                {
                    closure_captures_block(&Box::get(cb).body, out);
                    return;
                }
            },
            _                      : {},
        },
        None : {},
    }
    match (s)
    {
        Stmt::SLet(l)         :
        {
            match (&Box::get(l).init)
            {
                Some(e) : closure_captures_expr(e, out),
                None    : {},
            }
        },
        Stmt::SDestructure(d) : closure_captures_expr(&Box::get(d).init, out),
        Stmt::SExpr(e)        : closure_captures_expr(Box::get(e), out),
        Stmt::SBlockLike(e)   : closure_captures_expr(Box::get(e), out),
    }
}

fn closure_captures_block(ref<Block, shared> blk, ref<HashSet<String>, exclusive> out)
{
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        closure_captures_stmt(&blk.stmts[i], out);
    }
    match (&blk.tail)
    {
        Some(t) : closure_captures_expr(Box::get(t), out),
        None    : {},
    }
}

// Every name a closure anywhere in `e` captures.
fn closure_captures_expr(ref<Expr, shared> e, ref<HashSet<String>, exclusive> out)
{
    match (&e.kind)
    {
        ExprKind::EClosure(cb)    :
        {
            ref<ClosureExpr, shared> c = Box::get(cb);
            for (usize i = 0; i < Vec::len(&c.captures); i += 1)
            {
                HashSet::insert(out, String::clone(&c.captures[i]));
            }
            closure_captures_block(&c.body, out);
        },
        ExprKind::ESliceOf(sb)    :
        {
            ref<SliceExpr, shared> s = Box::get(sb);
            closure_captures_expr(&s.base, out);
            closure_captures_expr(&s.lo, out);
            closure_captures_expr(&s.hi, out);
        },
        ExprKind::EUnary(ub)      : closure_captures_expr(&Box::get(ub).e, out),
        ExprKind::EDeref(x)       : closure_captures_expr(Box::get(x), out),
        ExprKind::EField(fb)      : closure_captures_expr(&Box::get(fb).e, out),
        ExprKind::EParen(x)       : closure_captures_expr(Box::get(x), out),
        ExprKind::EPropagate(x)   : closure_captures_expr(Box::get(x), out),
        ExprKind::EBorrow(bb)     : closure_captures_expr(&Box::get(bb).e, out),
        ExprKind::EArrayRepeat(r) : closure_captures_expr(&Box::get(r).value, out),
        ExprKind::EBinary(bb)     :
        {
            closure_captures_expr(&Box::get(bb).a, out);
            closure_captures_expr(&Box::get(bb).b, out);
        },
        ExprKind::EIndex(pb)      :
        {
            closure_captures_expr(&Box::get(pb).a, out);
            closure_captures_expr(&Box::get(pb).b, out);
        },
        ExprKind::EAssign(pb)     :
        {
            closure_captures_expr(&Box::get(pb).a, out);
            closure_captures_expr(&Box::get(pb).b, out);
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            closure_captures_expr(&c.callee, out);
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                closure_captures_expr(&c.args[i], out);
            }
        },
        ExprKind::EStructLit(sb)  :
        {
            ref<StructLitExpr, shared> s = Box::get(sb);
            for (usize i = 0; i < Vec::len(&s.fields); i += 1)
            {
                closure_captures_expr(&s.fields[i].value, out);
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            for (usize i = 0; i < Vec::len(es); i += 1)
            {
                closure_captures_expr(&es[i], out);
            }
        },
        ExprKind::EBlock(blk)     : closure_captures_block(blk, out),
        ExprKind::EUnsafe(blk)    : closure_captures_block(blk, out),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            closure_captures_expr(&x.cond, out);
            closure_captures_block(&x.then_, out);
            match (&x.else_)
            {
                Some(el) : closure_captures_expr(el, out),
                None     : {},
            }
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            closure_captures_expr(&x.cond, out);
            closure_captures_block(&x.body, out);
            match (&x.step)
            {
                Some(s) : closure_captures_expr(s, out),
                None    : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> x = Box::get(mb);
            closure_captures_expr(&x.scrut, out);
            for (usize i = 0; i < Vec::len(&x.arms); i += 1)
            {
                closure_captures_expr(Box::get(&x.arms[i].body), out);
            }
        },
        ExprKind::EReturn(opt)    :
        {
            match (opt)
            {
                Some(v) : closure_captures_expr(Box::get(v), out),
                None    : {},
            }
        },
        _                         : {},
    }
}

fn collect_free_vars_block(
    ref<Block, shared> blk,
    ref<HashSet<String>, exclusive> bound,
    ref<HashSet<String>, exclusive> free,
)
{
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        match (&blk.stmts[i])
        {
            Stmt::SLet(lb)        :
            {
                ref<LetStmt, shared> l = Box::get(lb);
                match (&l.init)
                {
                    Some(e) : collect_free_vars_expr(e, bound, free),
                    None    : {},
                }
                HashSet::insert(bound, String::clone(&l.name));
            },
            Stmt::SDestructure(d) :
            {
                collect_free_vars_expr(&Box::get(d).init, bound, free);
                for (usize k = 0; k < Vec::len(&Box::get(d).fields); k += 1)
                {
                    HashSet::insert(bound, String::clone(&Box::get(d).fields[k]));
                }
            },
            Stmt::SExpr(e)        : collect_free_vars_expr(Box::get(e), bound, free),
            Stmt::SBlockLike(e)   : collect_free_vars_expr(Box::get(e), bound, free),
        }
    }
    match (&blk.tail)
    {
        Some(e) : collect_free_vars_expr(Box::get(e), bound, free),
        None    : {},
    }
}

fn collect_free_vars_expr(
    ref<Expr, shared> e,
    ref<HashSet<String>, exclusive> bound,
    ref<HashSet<String>, exclusive> free,
)
{
    match (&e.kind)
    {
        ExprKind::ESliceOf(sb)    :
        {
            ref<SliceExpr, shared> s = Box::get(sb);
            collect_free_vars_expr(&s.base, bound, free);
            collect_free_vars_expr(&s.lo, bound, free);
            collect_free_vars_expr(&s.hi, bound, free);
        },
        ExprKind::EPath(pb)       :
        {
            ref<Vec<String>, shared> segs = &Box::get(pb).segs;
            if (Vec::len(segs) == 1 && !HashSet::contains(bound, &segs[0]))
            {
                HashSet::insert(free, String::clone(&segs[0]));
            }
        },
        ExprKind::EUnary(ub)      : collect_free_vars_expr(&Box::get(ub).e, bound, free),
        ExprKind::EDeref(x)       : collect_free_vars_expr(Box::get(x), bound, free),
        ExprKind::EField(fb)      : collect_free_vars_expr(&Box::get(fb).e, bound, free),
        ExprKind::EParen(x)       : collect_free_vars_expr(Box::get(x), bound, free),
        ExprKind::EPropagate(x)   : collect_free_vars_expr(Box::get(x), bound, free),
        ExprKind::EBorrow(bb)     : collect_free_vars_expr(&Box::get(bb).e, bound, free),
        ExprKind::EBinary(bb)     :
        {
            collect_free_vars_expr(&Box::get(bb).a, bound, free);
            collect_free_vars_expr(&Box::get(bb).b, bound, free);
        },
        ExprKind::EIndex(pb)      :
        {
            collect_free_vars_expr(&Box::get(pb).a, bound, free);
            collect_free_vars_expr(&Box::get(pb).b, bound, free);
        },
        ExprKind::EAssign(pb)     :
        {
            collect_free_vars_expr(&Box::get(pb).a, bound, free);
            collect_free_vars_expr(&Box::get(pb).b, bound, free);
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            collect_free_vars_expr(&c.callee, bound, free);
            // `fault(name, …)`'s first argument is a diagnostic's name.
            bool names_a_diag = match (path_segs(&c.callee))
            {
                Some(segs) : Vec::len(segs) == 1 && (segs[0] == "fault" || segs[0] == "$require_fail"),
                None       : false,
            };
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                if (names_a_diag && i == 0)
                {
                    continue;
                }
                collect_free_vars_expr(&c.args[i], bound, free);
            }
        },
        ExprKind::EStructLit(sb)  :
        {
            ref<StructLitExpr, shared> s = Box::get(sb);
            for (usize i = 0; i < Vec::len(&s.fields); i += 1)
            {
                collect_free_vars_expr(&s.fields[i].value, bound, free);
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            for (usize i = 0; i < Vec::len(es); i += 1)
            {
                collect_free_vars_expr(&es[i], bound, free);
            }
        },
        ExprKind::EArrayRepeat(r) : collect_free_vars_expr(&Box::get(r).value, bound, free),
        ExprKind::EBlock(blk)     :
        {
            HashSet<String> inner = HashSet::clone(bound);
            collect_free_vars_block(blk, &mut inner, free);
        },
        ExprKind::EUnsafe(blk)    :
        {
            HashSet<String> inner = HashSet::clone(bound);
            collect_free_vars_block(blk, &mut inner, free);
        },
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            collect_free_vars_expr(&x.cond, bound, free);
            HashSet<String> inner = HashSet::clone(bound);
            collect_free_vars_block(&x.then_, &mut inner, free);
            match (&x.else_)
            {
                Some(el) : collect_free_vars_expr(el, bound, free),
                None     : {},
            }
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            collect_free_vars_expr(&x.cond, bound, free);
            HashSet<String> inner = HashSet::clone(bound);
            collect_free_vars_block(&x.body, &mut inner, free);
            match (&x.step)
            {
                Some(s) : collect_free_vars_expr(s, bound, free),
                None    : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> x = Box::get(mb);
            collect_free_vars_expr(&x.scrut, bound, free);
            for (usize i = 0; i < Vec::len(&x.arms); i += 1)
            {
                HashSet<String> inner = HashSet::clone(bound);
                match (&x.arms[i].binder)
                {
                    Some(bn) :
                    {
                        HashSet::insert(&mut inner, String::clone(bn));
                    },
                    None     : {},
                }
                collect_free_vars_expr(Box::get(&x.arms[i].body), &mut inner, free);
            }
        },
        ExprKind::EReturn(opt)    :
        {
            match (opt)
            {
                Some(v) : collect_free_vars_expr(Box::get(v), bound, free),
                None    : {},
            }
        },
        // A nested closure's own capture list is the set of outer names
        // it needs.
        ExprKind::EClosure(cb)    :
        {
            ref<ClosureExpr, shared> c = Box::get(cb);
            for (usize i = 0; i < Vec::len(&c.captures); i += 1)
            {
                if (!HashSet::contains(bound, &c.captures[i]))
                {
                    HashSet::insert(free, String::clone(&c.captures[i]));
                }
            }
        },
        _                         : {},
    }
}

fn is_pure_intrinsic(ref<String, shared> n) : bool
{
    foreach (x in [
        "min_value",
        "max_value",
        "sizeof",
        "alignof",
        "widen",
        "narrow",
        "narrow_wrapping",
        "reinterpret",
        "to_float",
        "to_int",
        "wrapping_add",
        "wrapping_sub",
        "wrapping_mul",
        "saturating_add",
        "saturating_sub",
        "saturating_mul",
    ])
    {
        if (*n == x)
        {
            return true;
        }
    }
    false
}

fn const_is_variant(ref<Items, shared> it, ref<Vec<String>, shared> segs) : bool
{
    usize n = Vec::len(segs);
    if (n == 0)
    {
        return HashMap::contains(&it.enum_of_variant, &String::new());
    }
    ref<String, shared> last = &segs[n - 1];
    if (n >= 2)
    {
        Vec<String> head = Vec::new();
        for (usize i = 0; i + 1 < n; i += 1)
        {
            Vec::push(&mut head, String::clone(&segs[i]));
        }
        match (HashMap::get(&it.enums, &String::join(&head, "::")))
        {
            Some(en) : return Option::is_some(&variant_index_of(en, last)),
            None     : {},
        }
    }
    HashMap::contains(&it.enum_of_variant, last)
}

// Whether `e` is a constant expression (D-0036, D-0066).
fn const_expr(ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EInt(_)         : true,
        ExprKind::EFloat(_)       : true,
        ExprKind::EBool(_)        : true,
        ExprKind::EStr(_)         : true,
        ExprKind::EUnit           : true,
        ExprKind::EParen(x)       : const_expr(it, Box::get(x)),
        ExprKind::EUnary(ub)      : const_expr(it, &Box::get(ub).e),
        ExprKind::EBinary(bb)     : const_expr(it, &Box::get(bb).a) && const_expr(it, &Box::get(bb).b),
        ExprKind::EArrayLit(es)   :
        {
            for (usize i = 0; i < Vec::len(es); i += 1)
            {
                if (!const_expr(it, &es[i]))
                {
                    return false;
                }
            }
            true
        },
        ExprKind::EArrayRepeat(r) : const_expr(it, &Box::get(r).value),
        ExprKind::EStructLit(sb)  :
        {
            ref<StructLitExpr, shared> s = Box::get(sb);
            for (usize i = 0; i < Vec::len(&s.fields); i += 1)
            {
                if (!const_expr(it, &s.fields[i].value))
                {
                    return false;
                }
            }
            true
        },
        // D-0066: a field of a constant struct, an element of a constant
        // array at a constant index.
        ExprKind::EField(fb)      : const_expr(it, &Box::get(fb).e),
        ExprKind::EIndex(pb)      : const_expr(it, &Box::get(pb).a) && const_expr(it, &Box::get(pb).b),
        ExprKind::EPath(pb)       :
        {
            ref<Vec<String>, shared> segs = &Box::get(pb).segs;
            if (const_is_variant(it, segs))
            {
                return true;
            }
            match (HashMap::get(&it.fns, &String::join(segs, "::")))
            {
                Some(f) : !f.is_const,
                None    : false,
            }
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            ref<Vec<String>, shared> segs = match (path_segs(&c.callee))
            {
                Some(s) : s,
                None    : return false,
            };
            String name = String::join(segs, "::");
            bool args_ok = true;
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                if (!const_expr(it, &c.args[i]))
                {
                    args_ok = false;
                }
            }
            match (HashMap::get(&it.fns, &name))
            {
                Some(f) : f.is_const && Vec::len(&c.args) == 0,
                None    : args_ok && (const_is_variant(it, segs) || is_pure_intrinsic(&name)),
            }
        },
        _                         : false,
    }
}

// ---- `check_call`'s `$fmt` (`rule.stdlib.format`) ----

fn is_enum_or_ref_enum(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(nb) : HashMap::contains(&it.enums, &Box::get(nb).name),
        Type::TRef(rb) : match (&Box::get(rb).inner)
        {
            Type::TNamed(nb) : HashMap::contains(&it.enums, &Box::get(nb).name),
            _                : false,
        },
        _                : false,
    }
}

// `printf` and `String::appendf` after `modres` (spec/21 §2f, D-0038): the
// format a string literal, one argument of its kind per specifier.
fn check_fmt(ref<Body, exclusive> b, ref<Items, shared> it, ref<Vec<Expr>, shared> args) : Result<Option<Type>, String>
{
    String f = match (if (Vec::len(args) > 0) { Some(&args[0].kind) } else { None })
    {
        Some(ExprKind::EStr(s)) : String::clone(s),
        Some(_)                 :
        {
            // Bug 250: C's `printf(s)`; the text goes through `%s`.
            String shown = arg_text(&args[0]);
            return Err(named_diag(
                "diag.format-invalid",
                &with_repair(
                    &sprintf(
                        "the format must be a string literal, checked when the program is compiled; to print text, pass it through `%%s`: `printf(\"%%s\", %s)`",
                        &shown,
                    ),
                    "",
                ),
            ));
        },
        None : return Err(named_diag(
            "diag.format-invalid",
            "the format is a string literal, checked when the program is compiled",
        )),
    };
    Vec<FmtKind> specs = match (fmt_arg_kinds(StringView::as_bytes(&f)))
    {
        Ok(k)  : k,
        Err(m) : return Err(named_diag("diag.format-invalid", &m)),
    };
    usize given = Vec::len(args) - 1;
    if (Vec::len(&specs) != given && Option::is_some(&StringView::find(&f, "{}")))
    {
        // Bug 250: Rust's and Python's `{}`.
        return Err(named_diag(
            "diag.format-invalid",
            &with_repair(
                "`{}` is not a conversion here: a format's conversions start with `%`; `%v` prints any printable value as it is (`%d`, `%s`, `%f` name the kind)",
                "write `%v` for each `{}`",
            ),
        ));
    }
    if (Vec::len(&specs) != given)
    {
        return Err(mismatch(sprintf(
            "the format takes %v argument%s, but %v follow%s",
            Vec::len(&specs),
            plural(Vec::len(&specs)),
            given,
            if (Vec::len(args) == 2) { "s" } else { "" },
        )));
    }
    for (usize i = 0; i < Vec::len(&specs); i += 1)
    {
        FmtKind k = specs[i];
        ref<Expr, shared> a = &args[i + 1];
        b.arg_temp_ok = true;
        // Report 400: a literal `*` width or precision is the `usize` its
        // place takes (`printf("%*d", 8, 42)`), in the checker and, by the
        // settled type, the lowering.
        bool width_literal = k == FmtKind::FWidth && Option::is_some(&literal_value(a));
        Option<Type> want = if (width_literal) { Some(Type::TInt(IntTy::Usize)) } else { None };
        if (width_literal)
        {
            HashMap::insert(&mut b.facts.settled, a.id, Type::TInt(IntTy::Usize));
        }
        Result<Option<Type>, String> t0 = check_store_operand(b, it, a, &want);
        b.arg_temp_ok = false;
        Option<Type> t1 = t0?;
        uninferred(b, it, a, &t1)?;
        // A reference is formatted as the value it refers to (D-0042).
        Option<Type> t = match (t1)
        {
            Some(Type::TRef(rb)) :
            {
                ModedTy { inner, mode } = Box::into_inner(rb);
                if (named_is(&inner, "std::String"))
                {
                    Some(ref_of(inner, Mode::Shared))
                }
                else
                {
                    // Bug 047: a `StringView` too, a `foreach` binder over
                    // `StringView::split`'s parts.
                    bool plain = match (&inner)
                    {
                        Type::TInt(_) : true,
                        Type::TF32    : true,
                        Type::TF64    : true,
                        Type::TBool   : true,
                        Type::TStr    : true,
                        _             : named_is(&inner, "std::StringView"),
                    };
                    if (plain) { Some(inner) } else { Some(ref_of(inner, mode)) }
                }
            },
            other                : other,
        };
        // `[Read-Resource-Rejected]` (CHG-0438): an enum that holds a
        // resource is lent to `%v`, as a `String` is.
        match (&t)
        {
            Some(x) :
            {
                bool enum_named = match (x)
                {
                    Type::TNamed(nb) : HashMap::contains(&it.enums, &Box::get(nb).name),
                    _                : false,
                };
                if (k == FmtKind::FValue && enum_named && is_resource_ty(it, x))
                {
                    return Err(named_diag(
                        "diag.read-of-resource",
                        &sprintf(
                            "argument %v is `%s`, which holds a resource, so `%%v` reads it through a reference: write `&` before it (bind a call's result first)",
                            i + 1,
                            &type_display(x),
                        ),
                    ));
                }
            },
            None    : {},
        }
        bool ok = match (&t)
        {
            None    : true,
            Some(x) :
            {
                if (has_unresolved_marker(x) || is_never(x))
                {
                    true
                }
                else if (k == FmtKind::FWidth)
                {
                    type_eq(x, &Type::TInt(IntTy::Usize))
                }
                else if (k == FmtKind::FValue)
                {
                    is_printable(x) || is_enum_or_ref_enum(it, x)
                }
                else
                {
                    match (x)
                    {
                        Type::TInt(_) : k == FmtKind::FInt,
                        Type::TF32    : k == FmtKind::FFloat,
                        Type::TF64    : k == FmtKind::FFloat,
                        Type::TStr    : k == FmtKind::FText,
                        Type::TBool   : k == FmtKind::FText,
                        Type::TRef(rb) : k == FmtKind::FText && Box::get(rb).mode == Mode::Shared && named_is(
                            &Box::get(rb).inner,
                            "std::String",
                        ),
                        _             : named_is(x, "std::StringView") && k == FmtKind::FText,
                    }
                }
            },
        };
        if (!ok)
        {
            Type tt = Option::expect(t, "a known type");
            String why = if (k == FmtKind::FWidth)
            {
                sprintf("a `*` width or precision takes a `usize`, and argument %v is `%s`", i + 1, &type_display(&tt))
            }
            else if (k == FmtKind::FValue)
            {
                sprintf(
                    "`%%v` prints numbers, `bool`, text, an enum's variant name, and references to them; argument %v is `%s`%s",
                    i + 1,
                    &type_display(&tt),
                    if (plain_named_ty(&tt, "std::String"))
                {
                    "; `printf` reads a `String` through a reference: write `&s`"
                }
                else
                {
                    // Report 046: what to print instead.
                    "; print what it holds: each field (`p.x`), each element (`foreach`), or an enum's payload (`match`)"
                },
                )
            }
            else
            {
                str takes = if (k == FmtKind::FInt) { "an integer" } else if (k == FmtKind::FFloat) { "a floating-point number" } else { "text: a `str`, a `StringView`, a `bool` or a borrowed `String` (`&s`)" };
                str hint = if (named_is(
                    &tt,
                    "std::String",
                ) && k == FmtKind::FText) { "; a `String` is passed by reference -- `&s`, or bind a `String` result first and pass `&name`" } else if (named_is(
                    &tt,
                    "std::String",
                )) { "; print text with `%s`" } else if (k == FmtKind::FText && is_int_ty(&tt)) { "; a number prints with `%d` (or `%v`)" } else if (k == FmtKind::FText && is_numeric_ty(&tt)) { "; a number prints with `%f` (or `%v`)" } else { "" };
                sprintf("argument %v is `%s`, but its specifier takes %s%s", i + 1, &type_display(&tt), takes, hint)
            };
            // Bug 250: the specifier is what to change, not the value.
            return Err(mismatch(with_repair(&why, "use the specifier of the argument's kind, or `%v` for any printable value")));
        }
    }
    Ok(Some(Type::TStr))
}

// ---- D-0162: the checker's rewrites ----

// D-0314: a literal's value as text: numbers as Rust's `{}`, an array
// `[a,b]`, a repeat `[a;n]`, a struct `{f:a,g:b}` in written order.
fn canon(ref<Expr, shared> e, ref<String, exclusive> out)
{
    match (&e.kind)
    {
        ExprKind::EInt(b)         : String::append(out, &sprintf("%v", Box::get(b).v)),
        ExprKind::EFloat(b)       : String::append(out, &rust_float_text(Box::get(b).v)),
        ExprKind::EBool(x)        : String::append(out, if (*x) { "true" } else { "false" }),
        ExprKind::EUnary(b)       :
        {
            String::append(out, "-");
            canon(&Box::get(b).e, out);
        },
        ExprKind::EParen(x)       : canon(Box::get(x), out),
        ExprKind::EArrayLit(xs)   :
        {
            String::append(out, "[");
            for (usize i = 0; i < Vec::len(xs); i += 1)
            {
                if (i > 0)
                {
                    String::append(out, ",");
                }
                canon(&xs[i], out);
            }
            String::append(out, "]");
        },
        ExprKind::EArrayRepeat(b) :
        {
            String::append(out, "[");
            canon(&Box::get(b).value, out);
            String::append(out, &sprintf(";%v]", Box::get(b).n));
        },
        ExprKind::EStructLit(b)   :
        {
            String::append(out, "{");
            ref<StructLitExpr, shared> st = Box::get(b);
            for (usize i = 0; i < Vec::len(&st.fields); i += 1)
            {
                if (i > 0)
                {
                    String::append(out, ",");
                }
                String::append(out, &st.fields[i].name);
                String::append(out, ":");
                canon(&st.fields[i].value, out);
            }
            String::append(out, "}");
        },
        _                         : String::append(out, "?"),
    }
}

// The rewrite D-0322 asks for on an `assert` whose comparison `id` is, if
// any.
fn assert_rewrite(ref<RewriteSets, shared> s, usize id) : Option<AssertValuesRewrite>
{
    match (HashMap::get(&s.rw, id))
    {
        Some(Rewrite::AssertValues(v)) : Some(AssertValuesRewrite { .lt = clone(&v.lt), .rt = clone(&v.rt) }),
        _                              : None,
    }
}

fn kind_of(Expr e) : ExprKind
{
    Expr { kind, .. } = e;
    kind
}

fn hidden_path(StringView n, usize line, usize col) : Expr
{
    Vec<String> segs = Vec::new();
    Vec::push(&mut segs, String::copy(n));
    mk(ExprKind::EPath(Box::new(PathExpr { .segs = segs, .targs = Vec::new() })), line, col)
}

// D-0322 (`Rewrite::AssertValues`): `assert(l OP r)`, which `modres` made
// `if (!(l OP r)) { $assert_fail(m); }`, becomes
//
//     { τl $assert_l = l; τr $assert_r = r;
//       if ($assert_l OP $assert_r) { } else { $assert_fail($fmt(F, …, $assert_l, $assert_r)); } }
//
// each operand bound once, in order, at the type the checker gave it, and F
// `assertion failed: %v OP %v`, or the program's own format followed by
// ` (%v OP %v)`.
fn assert_values(ref<Expr, exclusive> e, ref<RewriteSets, exclusive> s)
{
    usize line = e.line;
    usize col = e.col;
    Option<AssertValuesRewrite> found = None;
    match (&e.kind)
    {
        ExprKind::EIf(ib) :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            if (Option::is_none(&x.else_) && Vec::len(&x.then_.stmts) == 1)
            {
                match (&x.cond.kind)
                {
                    ExprKind::EUnary(ub) :
                    {
                        ref<UnaryExpr, shared> u = Box::get(ub);
                        if (u.op == UnOp::Not)
                        {
                            match (&u.e.kind)
                            {
                                ExprKind::EParen(pb) : found = assert_rewrite(&*s, Box::get(pb).id),
                                _                    : {},
                            }
                        }
                    },
                    _                    : {},
                }
            }
        },
        _                 : {},
    }
    AssertValuesRewrite v = match (found)
    {
        Some(v) : v,
        None    : return,
    };
    ExprKind old = replace(&mut e.kind, ExprKind::EUnit);
    IfExpr x = match (old)
    {
        ExprKind::EIf(ib) : Box::into_inner(ib),
        _                 : return,
    };
    IfExpr { cond, then_, .. } = x;
    UnaryExpr u = match (kind_of(cond))
    {
        ExprKind::EUnary(ub) : Box::into_inner(ub),
        _                    : return,
    };
    UnaryExpr { e: inner, .. } = u;
    Expr cmp = match (kind_of(inner))
    {
        ExprKind::EParen(pb) : Box::into_inner(pb),
        _                    : return,
    };
    BinaryExpr bx = match (kind_of(cmp))
    {
        ExprKind::EBinary(bb) : Box::into_inner(bb),
        _                     : return,
    };
    BinaryExpr { op, a, b } = bx;
    Block { stmts, .. } = then_;
    Vec<Expr> msg = Vec::new();
    match (Vec::remove(&mut stmts, 0))
    {
        Stmt::SExpr(xb) :
        {
            match (kind_of(Box::into_inner(xb)))
            {
                ExprKind::ECall(cb) :
                {
                    CallExpr { args, .. } = Box::into_inner(cb);
                    msg = args;
                },
                _                   : {},
            }
        },
        _               : {},
    }
    str shown = if (op == BinOp::Eq) { "==" } else if (op == BinOp::Ne) { "!=" } else if (op == BinOp::Lt) { "<" } else if (op == BinOp::Le) { "<=" } else if (op == BinOp::Gt) { ">" } else { ">=" };
    Vec<Stmt> out = Vec::new();
    AssertValuesRewrite { lt, rt } = v;
    Vec::push(&mut out, Stmt::SLet(Box::new(LetStmt { .ty = Some(lt), .name = "$assert_l", .init = Some(a), .line = line, .col = 0 })));
    Expr lv = hidden_path("$assert_l", line, col);
    Vec::push(&mut out, Stmt::SLet(Box::new(LetStmt { .ty = Some(rt), .name = "$assert_r", .init = Some(b), .line = line, .col = 0 })));
    Expr rv = hidden_path("$assert_r", line, col);
    Vec<Expr> args = Vec::new();
    bool given = false;
    match (Vec::pop(&mut msg))
    {
        Some(m) :
        {
            match (kind_of(m))
            {
                ExprKind::ECall(cb) :
                {
                    CallExpr { args: fargs, .. } = Box::into_inner(cb);
                    bool lit = Vec::len(&fargs) > 0 && match (&fargs[0].kind)
                    {
                        ExprKind::EStr(_) : true,
                        _                 : false,
                    };
                    if (lit)
                    {
                        match (&mut fargs[0].kind)
                        {
                            ExprKind::EStr(t) : String::appendf(t, " (%%v %v %%v)", shown),
                            _                 : {},
                        }
                        args = fargs;
                        given = true;
                    }
                },
                _                   : {},
            }
        },
        None    : {},
    }
    if (!given)
    {
        Vec::push(&mut args, mk(ExprKind::EStr(sprintf("assertion failed: %%v %v %%v", shown)), line, col));
    }
    Vec::push(&mut args, clone(&lv));
    Vec::push(&mut args, clone(&rv));
    Expr fmt = mk(ExprKind::ECall(Box::new(CallExpr { .callee = hidden_path("$fmt", line, col), .args = args })), line, col);
    Vec<Expr> fail_args = Vec::new();
    Vec::push(&mut fail_args, fmt);
    Expr fail = mk(ExprKind::ECall(Box::new(CallExpr { .callee = hidden_path("$assert_fail", line, col), .args = fail_args })), line, col);
    Vec<Stmt> else_stmts = Vec::new();
    Vec::push(&mut else_stmts, Stmt::SExpr(Box::new(fail)));
    Expr otherwise = mk(ExprKind::EBlock(Block { .stmts = else_stmts, .tail = None }), line, col);
    Expr test = mk(ExprKind::EBinary(Box::new(BinaryExpr { .op = op, .a = lv, .b = rv })), line, col);
    Expr iff = mk(
        ExprKind::EIf(Box::new(IfExpr { .cond = test, .then_ = Block { .stmts = Vec::new(), .tail = None }, .else_ = Some(otherwise) })),
        line,
        col,
    );
    Vec::push(&mut out, Stmt::SExpr(Box::new(iff)));
    set_kind(e, ExprKind::EBlock(Block { .stmts = out, .tail = None }));
}

struct RewriteSets
{
    HashSet<usize> literals;
    HashMap<usize, Rewrite> rw;
    // D-0314: the `[Coerce-Slice-Literal]` nodes' array types, and the
    // constants the rewrite adds.
    HashMap<usize, Type> slice_types;
    Vec<FnDecl> added;
}

fn rw_path(usize line, usize col, str a, str b2, str c) : Expr
{
    Vec<String> segs = Vec::new();
    Vec::push(&mut segs, String::copy(a));
    Vec::push(&mut segs, String::copy(b2));
    Vec::push(&mut segs, String::copy(c));
    mk(ExprKind::EPath(Box::new(PathExpr { .segs = segs, .targs = Vec::new() })), line, col)
}

// D-0324: the mode a destructuring's `PatternFields` rewrite gives, if it has
// one.
fn pattern_fields_of(ref<Stmt, shared> st, ref<RewriteSets, shared> s) : Option<Mode>
{
    match (st)
    {
        Stmt::SDestructure(d) : match (HashMap::get(&s.rw, Box::get(d).init.id))
        {
            Some(Rewrite::PatternFields(x)) : Some(if (*x) { Mode::Exclusive } else { Mode::Shared }),
            _                               : None,
        },
        _ : None,
    }
}

fn rw_block(ref<Block, exclusive> blk, ref<RewriteSets, exclusive> s)
{
    // D-0324 `[Struct-Pattern-By-Ref]`: a struct pattern reached through a
    // reference is `auto x = &p.f;` (`&mut p.f`) for each named field.
    bool any_fields = false;
    foreach (st in &blk.stmts)
    {
        if (Option::is_some(&pattern_fields_of(st, s)))
        {
            any_fields = true;
        }
    }
    if (any_fields)
    {
        Vec<Stmt> old = replace(&mut blk.stmts, Vec::new());
        foreach (st in old)
        {
            match (pattern_fields_of(&st, s))
            {
                Some(m) :
                {
                    match (&st)
                    {
                        Stmt::SDestructure(db) :
                        {
                            ref<DestructureStmt, shared> d = Box::get(db);
                            for (usize k = 0; k < Vec::len(&d.names) && k < Vec::len(&d.fields); k += 1)
                            {
                                Vec::push(&mut blk.stmts, field_borrow_let(&d.init, &d.names[k], &d.fields[k], m));
                            }
                        },
                        _                      : {},
                    }
                },
                None    : Vec::push(&mut blk.stmts, st),
            }
        }
    }
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        match (&mut blk.stmts[i])
        {
            Stmt::SLet(l)         :
            {
                match (&mut Box::get_mut(l).init)
                {
                    Some(e) : rw_expr(e, s),
                    None    : {},
                }
            },
            Stmt::SDestructure(d) : rw_expr(&mut Box::get_mut(d).init, s),
            Stmt::SExpr(e)        : rw_expr(Box::get_mut(e), s),
            Stmt::SBlockLike(e)   : rw_expr(Box::get_mut(e), s),
        }
    }
    match (&mut blk.tail)
    {
        Some(t) : rw_expr(Box::get_mut(t), s),
        None    : {},
    }
}

fn rw_expr(ref<Expr, exclusive> e, ref<RewriteSets, exclusive> s)
{
    usize line = e.line;
    usize col = e.col;
    bool is_str = match (&e.kind)
    {
        ExprKind::EStr(_) : true,
        _                 : false,
    };
    if (is_str && HashSet::contains(&s.literals, e.id))
    {
        wrap_owned(e);
        return;
    }
    Option<Rewrite> r = match (HashMap::get(&s.rw, e.id))
    {
        Some(x) : Some(clone(x)),
        None    : None,
    };
    match (r)
    {
        // D-0314 `[Coerce-Slice-Literal]`: the literal becomes the constant
        // `__slice_literal_H` (a root item; `H` the FNV-1a hash, 64 bits, of
        // the type and the value), and `e` is `&(*&K)[0..$]`.
        // D-0312 §2: `&t[lo..hi]` of a `str` `t`: `t` is `StringView::of(t)`.
        // D-0322: applied at the `if` around the comparison
        // (`assert_values`).
        Some(Rewrite::AssertValues(_))  : {},
        // D-0324: applied to the block around the destructuring (`rw_block`).
        Some(Rewrite::PatternFields(_)) : {},
        Some(Rewrite::CallTypeArgs(ts)) :
        {
            match (&mut e.kind)
            {
                ExprKind::ECall(cb) : match (&mut Box::get_mut(cb).callee.kind)
                {
                    ExprKind::EPath(pb) :
                    {
                        if (Vec::len(&Box::get(pb).targs) == 0)
                        {
                            Box::get_mut(pb).targs = ts;
                        }
                    },
                    _                   : {},
                },
                _ : {},
            }
        },
        Some(Rewrite::StrView)          :
        {
            Expr inner = replace(e, mk(ExprKind::EUnit, line, col));
            Vec<Expr> of_args = Vec::new();
            Vec::push(&mut of_args, inner);
            set_kind(e, ExprKind::ECall(Box::new(CallExpr { .callee = rw_path(line, col, "std", "StringView", "of"), .args = of_args })));
            return;
        },
        Some(Rewrite::SliceLiteral)     :
        {
            match (HashMap::swap_remove(&mut s.slice_types, e.id))
            {
                Some(t) :
                {
                    Expr lit = replace(e, mk(ExprKind::EUnit, line, col));
                    String text = sprintf("%s=", &type_display(&t));
                    canon(&lit, &mut text);
                    u64 h = 0xcbf29ce484222325;
                    foreach (c in StringView::as_bytes(&text))
                    {
                        h = wrapping_mul(h ^ widen<u64>(*c), 0x100000001b3);
                    }
                    String name = sprintf("__slice_literal_%v", h);
                    bool had = false;
                    foreach (a in &s.added)
                    {
                        if (a.name == name)
                        {
                            had = true;
                        }
                    }
                    if (!had)
                    {
                        Vec::push(&mut s.added, FnDecl {
                            .export_ = false,
                            .assoc_type = None,
                            .name = String::clone(&name),
                            .type_params = Vec::new(),
                            .type_bounds = Vec::new(),
                            .params = Vec::new(),
                            .ret = t,
                            .body = Block { .stmts = Vec::new(), .tail = Some(Box::new(lit)) },
                            .line = line,
                            .is_const = true,
                            .auto_type = false,
                            .derived = false,
                            .c_entry = false,
                            .source = Vec::new(),
                            .requires = Vec::new(),
                            .retired = Retired::Live,
                        });
                    }
                    Vec<String> segs = Vec::new();
                    Vec::push(&mut segs, name);
                    Expr callee = mk(ExprKind::EPath(Box::new(PathExpr { .segs = segs, .targs = Vec::new() })), line, col);
                    Expr call = mk(ExprKind::ECall(Box::new(CallExpr { .callee = callee, .args = Vec::new() })), line, col);
                    Expr bw = mk(ExprKind::EBorrow(Box::new(BorrowExpr { .mode = Mode::Shared, .e = call })), line, col);
                    Expr root = mk(ExprKind::EDeref(Box::new(bw)), line, col);
                    set_kind(e, ExprKind::ESliceOf(Box::new(SliceExpr { .mode = Mode::Shared, .base = root, .lo = mk(
                        ExprKind::EInt(Box::new(IntLit { .v = 0, .sfx = None })),
                        line,
                        0,
                    ), .hi = mk(ExprKind::EDollar, line, col) })));
                    return;
                },
                None    : {},
            }
        },
        // D-0164: `s == t` with a `String` and a `str` or `StringView`.
        Some(Rewrite::TextEq(te))       :
        {
            bool binary = match (&e.kind)
            {
                ExprKind::EBinary(_) : true,
                _                    : false,
            };
            if (binary)
            {
                ExprKind old = replace(&mut e.kind, ExprKind::EUnit);
                BinaryExpr bx = match (old)
                {
                    ExprKind::EBinary(bb) : Box::into_inner(bb),
                    _                     : return,
                };
                rw_expr(&mut bx.a, s);
                rw_expr(&mut bx.b, s);
                BinaryExpr { a, b, .. } = bx;
                Expr sx = mk(ExprKind::EUnit, line, col);
                Expr tx = mk(ExprKind::EUnit, line, col);
                if (te.string_left)
                {
                    sx = a;
                    tx = b;
                }
                else
                {
                    sx = b;
                    tx = a;
                }
                Vec<Expr> args = Vec::new();
                Vec::push(
                    &mut args,
                    mk(ExprKind::EBorrow(Box::new(BorrowExpr { .mode = Mode::Shared, .e = sx })), line, col),
                );
                Vec::push(&mut args, tx);
                Expr call = mk(
                    ExprKind::ECall(Box::new(CallExpr { .callee = rw_path(
                        line,
                        col,
                        "std",
                        "String",
                        if (te.other_is_str) { "same_str" } else { "same_view" },
                    ), .args = args })),
                    line,
                    col,
                );
                if (te.negate)
                {
                    set_kind(e, ExprKind::EUnary(Box::new(UnaryExpr { .op = UnOp::Not, .e = mk(
                        ExprKind::EParen(Box::new(call)),
                        line,
                        col,
                    ) })));
                }
                else
                {
                    Expr { kind, .. } = call;
                    e.kind = kind;
                    e.lit = literal_kind(&e.kind);
                }
                return;
            }
        },
        // D-0312 `[Cmp-Through-Shared-Ref]`: the reference operand, `*e`.
        Some(Rewrite::DerefOperand)     :
        {
            // Its parts first: the operand keeps its id, so it is not visited
            // again once wrapped.
            rw_parts(e, s);
            Expr old = replace(e, mk(ExprKind::EUnit, line, col));
            set_kind(e, ExprKind::EParen(Box::new(mk(ExprKind::EDeref(Box::new(old)), line, col))));
            e.lit = false;
            return;
        },
        // D-0312 `[Cmp-Text]`: mixed text ordered by `StringView::less`.
        Some(Rewrite::TextOrder(to))    :
        {
            bool binary = match (&e.kind)
            {
                ExprKind::EBinary(_) : true,
                _                    : false,
            };
            if (binary)
            {
                ExprKind old = replace(&mut e.kind, ExprKind::EUnit);
                BinaryExpr bx = match (old)
                {
                    ExprKind::EBinary(bb) : Box::into_inner(bb),
                    _                     : return,
                };
                rw_expr(&mut bx.a, s);
                rw_expr(&mut bx.b, s);
                BinaryExpr { a, b, .. } = bx;
                Expr x = a;
                Expr y = b;
                if (to.borrow_left)
                {
                    x = mk(ExprKind::EBorrow(Box::new(BorrowExpr { .mode = Mode::Shared, .e = x })), line, col);
                }
                if (to.borrow_right)
                {
                    y = mk(ExprKind::EBorrow(Box::new(BorrowExpr { .mode = Mode::Shared, .e = y })), line, col);
                }
                Vec<Expr> args = Vec::new();
                if (to.swap)
                {
                    Vec::push(&mut args, y);
                    Vec::push(&mut args, x);
                }
                else
                {
                    Vec::push(&mut args, x);
                    Vec::push(&mut args, y);
                }
                Expr call = mk(
                    ExprKind::ECall(Box::new(CallExpr { .callee = rw_path(line, col, "std", "StringView", "less"), .args = args })),
                    line,
                    col,
                );
                if (to.negate)
                {
                    set_kind(e, ExprKind::EUnary(Box::new(UnaryExpr { .op = UnOp::Not, .e = mk(
                        ExprKind::EParen(Box::new(call)),
                        line,
                        col,
                    ) })));
                }
                else
                {
                    Expr { kind, .. } = call;
                    e.kind = kind;
                    e.lit = literal_kind(&e.kind);
                }
                return;
            }
        },
        // D-0225: a text literal as a variant's `StringView` payload.
        Some(Rewrite::LiteralView)      :
        {
            ExprKind lit = replace(&mut e.kind, ExprKind::EUnit);
            Vec<Expr> args = Vec::new();
            Vec::push(&mut args, mk(lit, line, col));
            set_kind(e, ExprKind::ECall(Box::new(CallExpr { .callee = rw_path(
                line,
                col,
                "std",
                "StringView",
                "of",
            ), .args = args })));
            return;
        },
        // D-0218: `&*e`, or `&e[0..$]` for a slice; `e`'s own parts are
        // rewritten first (the wrapped node keeps its number).
        Some(Rewrite::SharedRef)        :
        {
            rw_parts(e, s);
            Expr old = replace(e, mk(ExprKind::EUnit, line, col));
            set_kind(e, ExprKind::EBorrow(Box::new(BorrowExpr { .mode = Mode::Shared, .e = mk(
                ExprKind::EDeref(Box::new(old)),
                line,
                col,
            ) })));
            return;
        },
        Some(Rewrite::SharedSlice)      :
        {
            rw_parts(e, s);
            Expr old = replace(e, mk(ExprKind::EUnit, line, col));
            set_kind(e, ExprKind::ESliceOf(Box::new(SliceExpr { .mode = Mode::Shared, .base = old, .lo = mk(
                ExprKind::EInt(Box::new(IntLit { .v = 0, .sfx = None })),
                line,
                0,
            ), .hi = mk(ExprKind::EDollar, line, col) })));
            return;
        },
        // D-0301: a `*x` binder's call, `Box::get_mut` or `Box::into_inner`.
        Some(Rewrite::BoxGetMut)        : rw_box_call(e, "get_mut"),
        Some(Rewrite::BoxIntoInner)     : rw_box_call(e, "into_inner"),
        // D-0302: `&e` is `&e[0..$]`.
        Some(Rewrite::RefStringView)    :
        {
            rw_parts(e, s);
            ExprKind old = replace(&mut e.kind, ExprKind::EUnit);
            Expr base = match (old)
            {
                ExprKind::EBorrow(bb) :
                {
                    BorrowExpr { e: inner, .. } = Box::into_inner(bb);
                    inner
                },
                other                 : mk(other, line, col),
            };
            set_kind(e, ExprKind::ESliceOf(Box::new(SliceExpr { .mode = Mode::Shared, .base = base, .lo = mk(
                ExprKind::EInt(Box::new(IntLit { .v = 0, .sfx = None })),
                line,
                0,
            ), .hi = mk(ExprKind::EDollar, line, col) })));
            return;
        },
        // D-0312 `[Coerce-Slice]`: `&v` is `&v[0..$]`, in the slice's mode.
        Some(Rewrite::SeqSlice(x))      :
        {
            rw_parts(e, s);
            ExprKind old = replace(&mut e.kind, ExprKind::EUnit);
            Expr base = match (old)
            {
                ExprKind::EBorrow(bb) :
                {
                    BorrowExpr { e: inner, .. } = Box::into_inner(bb);
                    inner
                },
                other                 : mk(other, line, col),
            };
            Mode m = if (x) { Mode::Exclusive } else { Mode::Shared };
            set_kind(e, ExprKind::ESliceOf(Box::new(SliceExpr { .mode = m, .base = base, .lo = mk(
                ExprKind::EInt(Box::new(IntLit { .v = 0, .sfx = None })),
                line,
                0,
            ), .hi = mk(ExprKind::EDollar, line, col) })));
            return;
        },
        // D-0312 `[Coerce-Slice]`: a reference `e` to a `Vec` or an array is
        // `&(*e)[0..$]`, in the slice's mode.
        Some(Rewrite::SeqPlaceSlice(x)) :
        {
            rw_parts(e, s);
            Expr old = replace(e, mk(ExprKind::EUnit, line, col));
            Mode m = if (x) { Mode::Exclusive } else { Mode::Shared };
            set_kind(e, ExprKind::ESliceOf(Box::new(SliceExpr { .mode = m, .base = mk(
                ExprKind::EDeref(Box::new(old)),
                line,
                col,
            ), .lo = mk(ExprKind::EInt(Box::new(IntLit { .v = 0, .sfx = None })), line, 0), .hi = mk(
                ExprKind::EDollar,
                line,
                col,
            ) })));
            return;
        },
        // D-0302: a place `r` of type `ref<String, shared>` is `&(*r)[0..$]`.
        Some(Rewrite::RefPlaceView)     :
        {
            rw_parts(e, s);
            Expr old = replace(e, mk(ExprKind::EUnit, line, col));
            set_kind(e, ExprKind::ESliceOf(Box::new(SliceExpr { .mode = Mode::Shared, .base = mk(
                ExprKind::EDeref(Box::new(old)),
                line,
                col,
            ), .lo = mk(ExprKind::EInt(Box::new(IntLit { .v = 0, .sfx = None })), line, 0), .hi = mk(
                ExprKind::EDollar,
                line,
                col,
            ) })));
            return;
        },
        // Report 242: a `str` at a `probe<StringView>` is
        // `&StringView::of(t)`, a borrowed temporary view.
        Some(Rewrite::ProbeViewRef)     :
        {
            rw_parts(e, s);
            Expr old = replace(e, mk(ExprKind::EUnit, line, col));
            Vec<Expr> args = Vec::new();
            Vec::push(&mut args, old);
            Expr call = mk(ExprKind::ECall(Box::new(CallExpr { .callee = rw_path(
                line,
                col,
                "std",
                "StringView",
                "of",
            ), .args = args })), line, col);
            set_kind(e, ExprKind::EBorrow(Box::new(BorrowExpr { .mode = Mode::Shared, .e = call })));
            return;
        },
        // D-0302: a `str` value `t` is `StringView::of(t)`.
        Some(Rewrite::StrValueView)     :
        {
            rw_parts(e, s);
            Expr old = replace(e, mk(ExprKind::EUnit, line, col));
            Vec<Expr> args = Vec::new();
            Vec::push(&mut args, old);
            set_kind(e, ExprKind::ECall(Box::new(CallExpr { .callee = rw_path(
                line,
                col,
                "std",
                "StringView",
                "of",
            ), .args = args })));
            return;
        },
        None                            : {},
    }
    rw_parts(e, s);
}

// D-0301: the last segment of a `*x` binder's `Box::get` path, renamed.
fn rw_box_call(ref<Expr, exclusive> e, str f)
{
    match (&mut e.kind)
    {
        ExprKind::EPath(pb) :
        {
            ref<PathExpr, exclusive> x = Box::get_mut(pb);
            usize n = Vec::len(&x.segs);
            x.segs[n - 1] = String::copy(f);
        },
        _                   : {},
    }
}

// The rewrites in `e`'s parts.
fn rw_parts(ref<Expr, exclusive> e, ref<RewriteSets, exclusive> s)
{
    bool was_if = false;
    match (&mut e.kind)
    {
        ExprKind::EStructLit(sb)  :
        {
            ref<StructLitExpr, exclusive> x = Box::get_mut(sb);
            for (usize i = 0; i < Vec::len(&x.fields); i += 1)
            {
                rw_expr(&mut x.fields[i].value, s);
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            for (usize i = 0; i < Vec::len(es); i += 1)
            {
                rw_expr(&mut es[i], s);
            }
        },
        ExprKind::EArrayRepeat(r) : rw_expr(&mut Box::get_mut(r).value, s),
        ExprKind::EUnary(ub)      : rw_expr(&mut Box::get_mut(ub).e, s),
        ExprKind::EBorrow(bb)     : rw_expr(&mut Box::get_mut(bb).e, s),
        ExprKind::EDeref(x)       : rw_expr(Box::get_mut(x), s),
        ExprKind::EField(fb)      : rw_expr(&mut Box::get_mut(fb).e, s),
        ExprKind::EPropagate(x)   : rw_expr(Box::get_mut(x), s),
        ExprKind::EParen(x)       : rw_expr(Box::get_mut(x), s),
        ExprKind::EBinary(bb)     :
        {
            rw_expr(&mut Box::get_mut(bb).a, s);
            rw_expr(&mut Box::get_mut(bb).b, s);
        },
        ExprKind::EIndex(pb)      :
        {
            rw_expr(&mut Box::get_mut(pb).a, s);
            rw_expr(&mut Box::get_mut(pb).b, s);
        },
        ExprKind::EAssign(pb)     :
        {
            rw_expr(&mut Box::get_mut(pb).a, s);
            rw_expr(&mut Box::get_mut(pb).b, s);
        },
        ExprKind::ESliceOf(sb)    :
        {
            ref<SliceExpr, exclusive> x = Box::get_mut(sb);
            rw_expr(&mut x.base, s);
            rw_expr(&mut x.lo, s);
            rw_expr(&mut x.hi, s);
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, exclusive> c = Box::get_mut(cb);
            rw_expr(&mut c.callee, s);
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                rw_expr(&mut c.args[i], s);
            }
        },
        ExprKind::EBlock(blk)     : rw_block(blk, s),
        ExprKind::EUnsafe(blk)    : rw_block(blk, s),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, exclusive> x = Box::get_mut(ib);
            rw_expr(&mut x.cond, s);
            rw_block(&mut x.then_, s);
            match (&mut x.else_)
            {
                Some(el) : rw_expr(el, s),
                None     : {},
            }
            was_if = true;
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, exclusive> x = Box::get_mut(wb);
            rw_expr(&mut x.cond, s);
            rw_block(&mut x.body, s);
            match (&mut x.step)
            {
                Some(st) : rw_expr(st, s),
                None     : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, exclusive> x = Box::get_mut(mb);
            rw_expr(&mut x.scrut, s);
            for (usize i = 0; i < Vec::len(&x.arms); i += 1)
            {
                ref<Arm, exclusive> arm = &mut x.arms[i];
                match (&mut arm.lit)
                {
                    Some(l) : rw_expr(Box::get_mut(l), s),
                    None    : {},
                }
                rw_expr(Box::get_mut(&mut arm.body), s);
            }
        },
        ExprKind::EReturn(opt)    :
        {
            match (opt)
            {
                Some(v) : rw_expr(Box::get_mut(v), s),
                None    : {},
            }
        },
        ExprKind::EClosure(cb)    : rw_block(&mut Box::get_mut(cb).body, s),
        _                         : {},
    }
    // D-0322: an `assert` of two scalars, its operands' own rewrites applied
    // first; after the match, whose arm holds a binder into `e` to its end.
    if (was_if)
    {
        assert_values(e, s);
    }
}

// D-0162: the literals the check typed as `String` through a generic
// parameter (and never otherwise), and the other rewrites, applied to every
// function's body; whether there were any.
export fn apply_rewrites(ref<Items, exclusive> it, ref<Facts, exclusive> f) : bool
{
    HashSet<usize> lits = HashSet::new();
    for (usize i = 0; i < HashSet::len(&f.literal_yes); i += 1)
    {
        ref<usize, shared> id = HashSet::key_at(&f.literal_yes, i);
        if (!HashSet::contains(&f.literal_no, *id))
        {
            HashSet::insert(&mut lits, *id);
        }
    }
    if (HashSet::len(&lits) == 0 && HashMap::len(&f.rewrites) == 0)
    {
        return false;
    }
    HashMap<usize, Type> slice_types = HashMap::new();
    for (usize i = 0; i < HashMap::len(&f.slice_literals); i += 1)
    {
        match (&HashMap::value_at(&f.slice_literals, i).t)
        {
            Some(t) :
            {
                _ = HashMap::insert(&mut slice_types, *HashMap::key_at(&f.slice_literals, i), clone(t));
            },
            None    : {},
        }
    }
    HashMap::clear(&mut f.slice_literals);
    RewriteSets s = RewriteSets { .literals = lits, .rw = replace(&mut f.rewrites, HashMap::new()), .slice_types = slice_types, .added = Vec::new() };
    Vec<String> keys = Vec::new();
    for (usize i = 0; i < HashMap::len(&it.fns); i += 1)
    {
        Vec::push(&mut keys, String::clone(HashMap::key_at(&it.fns, i)));
    }
    for (usize i = 0; i < Vec::len(&keys); i += 1)
    {
        ref<FnDecl, exclusive> fd = Option::expect(HashMap::get_mut(&mut it.fns, &keys[i]), "a function");
        rw_block(&mut fd.body, &mut s);
    }
    while (true)
    {
        match (Vec::pop(&mut s.added))
        {
            Some(c) :
            {
                // One a literal of an earlier round already made is the same.
                if (!HashMap::contains(&it.fns, &c.name))
                {
                    _ = HashMap::insert(&mut it.fns, String::clone(&c.name), c);
                }
            },
            None    : break,
        }
    }
    true
}

// After the second check: a literal still typed as `String` is one a
// generic function's instantiations disagree about.
export fn literal_still_string(ref<Facts, shared> f) : bool
{
    for (usize i = 0; i < HashSet::len(&f.literal_yes); i += 1)
    {
        if (!HashSet::contains(&f.literal_no, *HashSet::key_at(&f.literal_yes, i)))
        {
            return true;
        }
    }
    false
}

// `[Generic-Instantiation-Unbounded]` (CHG-0357): how deep a type argument
// may nest, and how many concrete instantiations a program may need.
const usize INSTANCE_DEPTH = 64;
const u32 MAX_INSTANCES = 100000;
// How many type constructors in all a type argument may have (bug 043: a
// type argument that doubles at each call, `f(Two { .a = x, .b = x })`,
// is exponential in size long before it is 64 deep).
const usize INSTANCE_SIZE = 4096;

// Whether `t` has more than `limit` type constructors; it stops counting
// there, so a huge type costs no more than the limit.
fn type_size_over(ref<Type, shared> t, usize limit) : bool
{
    usize left = limit;
    !type_size_within(t, &mut left)
}

fn type_size_within(ref<Type, shared> t, ref<usize, exclusive> left) : bool
{
    if (*left == 0)
    {
        return false;
    }
    *left -= 1;
    match (t)
    {
        Type::TNamed(nb) :
        {
            for (usize i = 0; i < Vec::len(&Box::get(nb).args); i += 1)
            {
                if (!type_size_within(&Box::get(nb).args[i], left))
                {
                    return false;
                }
            }
            true
        },
        Type::TRef(rb)   : type_size_within(&Box::get(rb).inner, left),
        Type::TSlice(sb) : type_size_within(&Box::get(sb).inner, left),
        Type::TArray(ab) : type_size_within(&Box::get(ab).inner, left),
        Type::TSimd(ab)  : type_size_within(&Box::get(ab).inner, left),
        Type::TRawptr(x) : type_size_within(Box::get(x), left),
        Type::THandle(x) : type_size_within(Box::get(x), left),
        Type::TMutex(x)  : type_size_within(Box::get(x), left),
        Type::TGuard(x)  : type_size_within(Box::get(x), left),
        Type::TFn(fb)    :
        {
            if (!type_size_within(&Box::get(fb).ret, left))
            {
                return false;
            }
            for (usize i = 0; i < Vec::len(&Box::get(fb).params); i += 1)
            {
                if (!type_size_within(&Box::get(fb).params[i], left))
                {
                    return false;
                }
            }
            true
        },
        _                : true,
    }
}

// The first `n` characters of `t`'s display (for the messages).
fn type_display_cut(ref<Type, shared> t, usize n) : String
{
    String d = type_display(t);
    Vec<StringView> cs = StringView::chars(&d);
    String cut = String::new();
    for (usize k = 0; k < Vec::len(&cs) && k < n; k += 1)
    {
        String::append(&mut cut, cs[k]);
    }
    cut
}

// How many type constructors a type nests (`i32` 1, `Box<Vec<i32>>` 3).
fn type_depth(ref<Type, shared> t) : usize
{
    usize inner = match (t)
    {
        Type::TNamed(nb) :
        {
            usize m = 0;
            for (usize i = 0; i < Vec::len(&Box::get(nb).args); i += 1)
            {
                m = max(m, type_depth(&Box::get(nb).args[i]));
            }
            m
        },
        Type::TRef(rb)   : type_depth(&Box::get(rb).inner),
        Type::TSlice(sb) : type_depth(&Box::get(sb).inner),
        Type::TArray(ab) : type_depth(&Box::get(ab).inner),
        Type::TSimd(ab)  : type_depth(&Box::get(ab).inner),
        Type::TRawptr(x) : type_depth(Box::get(x)),
        Type::THandle(x) : type_depth(Box::get(x)),
        Type::TMutex(x)  : type_depth(Box::get(x)),
        Type::TGuard(x)  : type_depth(Box::get(x)),
        Type::TFn(fb)    :
        {
            usize m = type_depth(&Box::get(fb).ret);
            for (usize i = 0; i < Vec::len(&Box::get(fb).params); i += 1)
            {
                m = max(m, type_depth(&Box::get(fb).params[i]));
            }
            m
        },
        _                : 0,
    };
    1 + inner
}

// An f64 as Rust's `{}` writes it (for the messages): the shortest digits
// that read back, never an exponent, no `.0` on a whole number.
fn rust_float_text(f64 x) : String
{
    String v = sprintf("%v", x);
    if (!is_finite(x))
    {
        return v;
    }
    StringView t = &v;
    String out = String::new();
    match (StringView::strip_prefix(t, "-"))
    {
        Some(r) :
        {
            String::push_ascii(&mut out, b'-');
            t = r;
        },
        None    : {},
    }
    // Mantissa digits and the position of the point in them.
    slice<u8, shared> b = StringView::as_bytes(t);
    String digits = String::new();
    i64 point = -1;
    i64 exp = 0;
    usize i = 0;
    while (i < slice_len(b))
    {
        u8 c = b[i];
        if (c == b'.')
        {
            point = narrow<i64>(StringView::len(&digits));
        }
        else if (c == b'e')
        {
            exp = Result::unwrap_or(StringView::parse<i64>(&t[i + 1..slice_len(b)]), 0);
            break;
        }
        else
        {
            String::push_ascii(&mut digits, c);
        }
        i += 1;
    }
    if (point < 0)
    {
        point = narrow<i64>(StringView::len(&digits));
    }
    point += exp;
    slice<u8, shared> d = StringView::as_bytes(&digits);
    i64 n = narrow<i64>(slice_len(d));
    // Leading and trailing zeros of the digits do not count.
    i64 lo = 0;
    while (lo < n - 1 && d[narrow<usize>(lo)] == b'0' && lo < point - 1)
    {
        lo += 1;
    }
    i64 hi = n;
    while (hi > lo + 1 && d[narrow<usize>(hi - 1)] == b'0' && hi > point)
    {
        hi -= 1;
    }
    if (point <= 0)
    {
        String::push_ascii(&mut out, b'0');
        String::push_ascii(&mut out, b'.');
        for (i64 k = point; k < 0; k += 1)
        {
            String::push_ascii(&mut out, b'0');
        }
        for (i64 k = lo; k < hi; k += 1)
        {
            String::push_ascii(&mut out, d[narrow<usize>(k)]);
        }
        return out;
    }
    for (i64 k = lo; k < point; k += 1)
    {
        String::push_ascii(&mut out, if (k < hi) { d[narrow<usize>(k)] } else { b'0' });
    }
    if (hi > point)
    {
        String::push_ascii(&mut out, b'.');
        for (i64 k = point; k < hi; k += 1)
        {
            String::push_ascii(&mut out, d[narrow<usize>(k)]);
        }
    }
    out
}

// D-0312: every value `body` gives as its result (its tail and each `return`,
// through blocks, `if` branches and `match` arms) is a view of static text: a
// literal, a `str` parameter, or `StringView::of(t)` (the pass's
// `gives_only_static_views`).
fn gives_only_static_views(ref<Block, shared> body, ref<Vec<ParamDecl>, shared> params) : bool
{
    HashSet<String> strs = HashSet::new();
    foreach (p in params)
    {
        if (matches_str(&p.ty))
        {
            HashSet::insert(&mut strs, String::clone(&p.name));
        }
    }
    bool tail_ok = match (&body.tail)
    {
        Some(t) : static_view_expr(Box::get(t), &strs),
        None    : last_stmt_returns(body, false),
    };
    tail_ok && returns_static(body, &strs)
}

// The block's last statement is a `return` (with a value, when `valued`).
fn last_stmt_returns(ref<Block, shared> b, bool valued) : bool
{
    usize n = Vec::len(&b.stmts);
    if (n == 0)
    {
        return false;
    }
    match (&b.stmts[n - 1])
    {
        Stmt::SExpr(x)      : is_return_expr(Box::get(x), valued),
        Stmt::SBlockLike(x) : is_return_expr(Box::get(x), valued),
        _                   : false,
    }
}

fn is_return_expr(ref<Expr, shared> e, bool valued) : bool
{
    match (&e.kind)
    {
        ExprKind::EReturn(v) : !valued || Option::is_some(v),
        _                    : false,
    }
}

fn static_view_expr(ref<Expr, shared> e, ref<HashSet<String>, shared> strs) : bool
{
    match (&e.kind)
    {
        ExprKind::EParen(x)  : static_view_expr(Box::get(x), strs),
        ExprKind::EStr(_)    : true,
        ExprKind::EPath(p)   : Vec::len(&Box::get(p).segs) == 1 && HashSet::contains(strs, &Box::get(p).segs[0]),
        ExprKind::ECall(c) : match (&Box::get(c).callee.kind)
        {
            ExprKind::EPath(p) : String::join(&Box::get(p).segs, "::") == "std::StringView::of",
            _                  : false,
        },
        ExprKind::EBlock(b)  : block_gives_static(b, strs),
        ExprKind::EUnsafe(b) : block_gives_static(b, strs),
        ExprKind::EIf(i)     :
        {
            ref<IfExpr, shared> x = Box::get(i);
            block_gives_static(&x.then_, strs) && match (&x.else_)
            {
                Some(f) : static_view_expr(f, strs),
                None    : false,
            }
        },
        ExprKind::EMatch(m)  :
        {
            bool all = true;
            foreach (a in &Box::get(m).arms)
            {
                all = all && (static_view_expr(Box::get(&a.body), strs) || is_return_expr(Box::get(&a.body), false));
            }
            all
        },
        ExprKind::EReturn(v) : match (v)
        {
            Some(x) : static_view_expr(Box::get(x), strs),
            None    : false,
        },
        _                    : false,
    }
}

fn block_gives_static(ref<Block, shared> b, ref<HashSet<String>, shared> strs) : bool
{
    match (&b.tail)
    {
        Some(t) : static_view_expr(Box::get(t), strs),
        None    : last_stmt_returns(b, true),
    }
}

fn returns_static(ref<Block, shared> b, ref<HashSet<String>, shared> strs) : bool
{
    bool ok = true;
    foreach (st in &b.stmts)
    {
        match (st)
        {
            Stmt::SExpr(x)        : ok = ok && returns_in(Box::get(x), strs),
            Stmt::SBlockLike(x)   : ok = ok && returns_in(Box::get(x), strs),
            Stmt::SLet(l) : match (&Box::get(l).init)
            {
                Some(x) : ok = ok && returns_in(x, strs),
                None    : {},
            },
            Stmt::SDestructure(d) : ok = ok && returns_in(&Box::get(d).init, strs),
        }
    }
    ok && match (&b.tail)
    {
        Some(t) : returns_in(Box::get(t), strs),
        None    : true,
    }
}

// Every `return e` inside `e`, not inside a closure, gives a static view.
fn returns_in(ref<Expr, shared> e, ref<HashSet<String>, shared> strs) : bool
{
    match (&e.kind)
    {
        ExprKind::EReturn(v) : match (v)
        {
            Some(x) : static_view_expr(Box::get(x), strs) && returns_in(Box::get(x), strs),
            None    : false,
        },
        ExprKind::EClosure(_)   : true,
        ExprKind::EBlock(b)     : returns_static(b, strs),
        ExprKind::EUnsafe(b)    : returns_static(b, strs),
        ExprKind::EIf(i)        :
        {
            ref<IfExpr, shared> x = Box::get(i);
            returns_in(&x.cond, strs) && returns_static(&x.then_, strs) && match (&x.else_)
            {
                Some(f) : returns_in(f, strs),
                None    : true,
            }
        },
        ExprKind::EWhile(w)     :
        {
            ref<WhileExpr, shared> x = Box::get(w);
            returns_in(&x.cond, strs) && returns_static(&x.body, strs) && match (&x.step)
            {
                Some(st) : returns_in(st, strs),
                None     : true,
            }
        },
        ExprKind::EMatch(m)     :
        {
            bool all = returns_in(&Box::get(m).scrut, strs);
            foreach (a in &Box::get(m).arms)
            {
                all = all && returns_in(Box::get(&a.body), strs);
            }
            all
        },
        ExprKind::EParen(x)     : returns_in(Box::get(x), strs),
        ExprKind::EUnary(u)     : returns_in(&Box::get(u).e, strs),
        ExprKind::EBorrow(bb)   : returns_in(&Box::get(bb).e, strs),
        ExprKind::EDeref(x)     : returns_in(Box::get(x), strs),
        ExprKind::EField(f)     : returns_in(&Box::get(f).e, strs),
        ExprKind::EPropagate(x) : returns_in(Box::get(x), strs),
        ExprKind::EBinary(bx)   : returns_in(&Box::get(bx).a, strs) && returns_in(&Box::get(bx).b, strs),
        ExprKind::EIndex(px)    : returns_in(&Box::get(px).a, strs) && returns_in(&Box::get(px).b, strs),
        ExprKind::EAssign(px)   : returns_in(&Box::get(px).a, strs) && returns_in(&Box::get(px).b, strs),
        ExprKind::ECall(c)      :
        {
            bool all = returns_in(&Box::get(c).callee, strs);
            foreach (a in &Box::get(c).args)
            {
                all = all && returns_in(a, strs);
            }
            all
        },
        _                       : true,
    }
}

// D-0312: one of the three text types.
fn is_any_text_ty(ref<Type, shared> t) : bool
{
    matches_str(t) || plain_named_ty(t, "std::String") || plain_named_ty(t, "std::StringView")
}
// Report 228, D-0339: the C library's functions that take a variable
// argument list, and how many fixed parameters each has. A declaration of
// one of them without `...` is refused (`[Extern-Variadic-Without-Ellipsis]`):
// the D-0336 form that listed the calls' arguments in place of `...` is gone.
fn c_variadic_fixed(StringView name) : Option<usize>
{
    foreach (n in ["semctl", "strfmon", "error"])
    {
        if (name == n)
        {
            return Some(3);
        }
    }
    foreach (n in ["strfmon_l", "mremap"])
    {
        if (name == n)
        {
            return Some(4);
        }
    }
    if (name == "error_at_line")
    {
        return Some(5);
    }
    foreach (n in ["printf", "scanf", "wprintf", "wscanf", "syscall", "prctl", "ptrace", "execl", "execlp", "execle", "err", "errx",
        "warn", "warnx", "ulimit"])
    {
        if (name == n)
        {
            return Some(if (name == "execl" || name == "execlp" || name == "execle" || name == "err" || name == "errx") { 2 } else { 1 });
        }
    }
    foreach (n in ["fprintf", "sprintf", "dprintf", "asprintf", "fscanf", "sscanf", "fwprintf", "fwscanf", "swscanf", "open",
        "open64", "fcntl", "fcntl64", "ioctl", "syslog", "mq_open", "sem_open"])
    {
        if (name == n)
        {
            return Some(2);
        }
    }
    foreach (n in ["snprintf", "swprintf", "openat", "openat64"])
    {
        if (name == n)
        {
            return Some(3);
        }
    }
    None
}
