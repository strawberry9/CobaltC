// The static pass: spec/12's typing rules, spec/06's literal typing and
// range checks, and `rule.control.flow-analysis` (spec/14 §6), the forward
// dataflow over each body with `valid(x)`, `init(x)` and `deriv(r, x.π, m)`
// in {T, F, ?}, joined at merges and iterated to a fixed point around
// `while`. Generics are checked per concrete instantiation, from a
// worklist that starts at `main`. What is recorded of an expression is
// keyed by its id (`items::number`).

import std;
import ast;
import items;
import modres;
import hints;
import prelude;
import each;
import fmtcheck;
import views;
import libc_names;

// D-0282: the access summaries, a module of their own.
module tier "tier.cb";

import tier;
import self_tail;

// ---- part 1 ----

// [Extern-Non-Ffi-Type] (spec/20 rule.trust.extern-call): `FfiType ::=
// integer types | f32 | f64 | bool | void | rawptr<tau>`.
fn is_ffi_type(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TInt(_)    : true,
        Type::TF32       : true,
        Type::TF64       : true,
        Type::TBool      : true,
        Type::TVoid      : true,
        Type::TRawptr(_) : true,
        _                : false,
    }
}

// D-0254: the intrinsics whose two operands are one `simd` type.
fn is_simd_pair_intrinsic(StringView name) : bool
{
    foreach (n in ["simd_eq", "simd_ne", "simd_lt", "simd_le", "simd_gt", "simd_ge", "simd_min", "simd_max"])
    {
        if (name == n)
        {
            return true;
        }
    }
    false
}

fn simd_of(Type lane, u128 n) : Type
{
    Type::TSimd(Box::new(SizedTy { .inner = lane, .n = n }))
}

// D-0254: a `simd`'s mask type: signed integer lanes of the lanes' width.
fn simd_mask_of(ref<Type, shared> t) : Option<Type>
{
    match (t)
    {
        Type::TSimd(b) :
        {
            ref<SizedTy, shared> s = Box::get(b);
            IntTy m = match (&s.inner)
            {
                Type::TInt(i) :
                {
                    if (*i == IntTy::I8 || *i == IntTy::U8)
                    {
                        IntTy::I8
                    }
                    else if (*i == IntTy::I16 || *i == IntTy::U16)
                    {
                        IntTy::I16
                    }
                    else if (*i == IntTy::I32 || *i == IntTy::U32)
                    {
                        IntTy::I32
                    }
                    else
                    {
                        IntTy::I64
                    }
                },
                Type::TF32    : IntTy::I32,
                _             : IntTy::I64,
            };
            Some(simd_of(Type::TInt(m), s.n))
        },
        _              : None,
    }
}

fn is_simd(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TSimd(_) : true,
        _              : false,
    }
}

fn is_never(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNever : true,
        _            : false,
    }
}

fn lane_of(ref<Type, shared> t) : Type
{
    match (t)
    {
        Type::TSimd(b) : clone(&Box::get(b).inner),
        _              : Type::TVoid,
    }
}

// D-0312 `[Coerce-Slice]`: the slice `simd_load`'s or `simd_store`'s first
// argument is taken as when it is a reference to a whole `Vec` or array:
// `slice<τ, m>` of its elements, in the reference's mode for a load and
// `exclusive` for a store; `None` for any other argument.
fn simd_seq_slice(StringView name, ref<Vec<Option<Type>>, shared> arg_tys) : Option<Type>
{
    match (simd_arg(arg_tys, 0))
    {
        Some(Type::TRef(rb)) :
        {
            ref<ModedTy, shared> g = Box::get(&rb);
            match (seq_elem(&g.inner))
            {
                Some(x) :
                {
                    Mode m = if (name == "simd_store") { Mode::Exclusive } else { g.mode };
                    Some(Type::TSlice(Box::new(ModedTy { .inner = x, .mode = m })))
                },
                None    : None,
            }
        },
        _                    : None,
    }
}

// The known, resolved type of argument `k`.
fn simd_arg(ref<Vec<Option<Type>>, shared> arg_tys, usize k) : Option<Type>
{
    if (k >= Vec::len(arg_tys))
    {
        return None;
    }
    match (&arg_tys[k])
    {
        Some(t) :
        {
            if (has_unresolved_marker(t) || is_never(t))
            {
                return None;
            }
            Some(clone(t))
        },
        None    : None,
    }
}

fn need_simd(StringView name, ref<Vec<Option<Type>>, shared> arg_tys, usize k) : Result<Option<Type>, String>
{
    match (simd_arg(arg_tys, k))
    {
        None    : Ok(None),
        Some(t) :
        {
            if (is_simd(&t))
            {
                return Ok(Some(t));
            }
            Err(mismatch(sprintf("`%s` takes a `simd`, and this is `%s`", name, &type_display(&t))))
        },
    }
}

fn simd_same(StringView name, ref<Option<Type>, shared> a, ref<Option<Type>, shared> b) : Result<void, String>
{
    match (a)
    {
        Some(x) : match (b)
        {
            Some(y) :
            {
                if (!type_eq(x, y))
                {
                    return Err(mismatch(sprintf(
                        "`%s` takes two of one `simd` type, and these are `%s` and `%s`",
                        name,
                        &type_display(x),
                        &type_display(y),
                    )));
                }
            },
            None    : {},
        },
        None : {},
    }
    Ok(())
}

fn or_type(Option<Type> a, Option<Type> b) : Option<Type>
{
    match (a)
    {
        Some(t) : Some(t),
        None    : b,
    }
}

// D-0254 `rule.stdlib.simd` (spec/21 §0): the type of a lane-wise
// intrinsic, or `None` for an intrinsic that is not one.
fn simd_intrinsic_type(
    StringView name,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Option<Type>>, shared> arg_tys,
) : Result<Option<Type>, String>
{
    bool wrap_sat = name == "wrapping_add" || name == "wrapping_sub" || name == "wrapping_mul" || name == "saturating_add" || name == "saturating_sub";
    bool any_simd = match (simd_arg(arg_tys, 0))
    {
        Some(t) : is_simd(&t),
        None    : false,
    } || match (simd_arg(arg_tys, 1))
    {
        Some(t) : is_simd(&t),
        None    : false,
    };
    if (wrap_sat && any_simd)
    {
        Option<Type> a = need_simd(name, arg_tys, 0)?;
        Option<Type> b = need_simd(name, arg_tys, 1)?;
        simd_same(name, &a, &b)?;
        Type t = Option::expect(or_type(a, b), "a simd operand");
        match (lane_of(&t))
        {
            Type::TInt(_) : {},
            _             : return Err(mismatch(sprintf("`%s` on a `simd` takes integer lanes", name))),
        }
        return Ok(Some(t));
    }
    if (is_simd_pair_intrinsic(name))
    {
        Option<Type> a = need_simd(name, arg_tys, 0)?;
        Option<Type> b = need_simd(name, arg_tys, 1)?;
        simd_same(name, &a, &b)?;
        return match (or_type(a, b))
        {
            Some(t) :
            {
                if (name == "simd_min" || name == "simd_max")
                {
                    return Ok(Some(t));
                }
                Ok(simd_mask_of(&t))
            },
            None    : Ok(None),
        };
    }
    if (name == "simd_select")
    {
        Option<Type> m = need_simd(name, arg_tys, 0)?;
        Option<Type> a = need_simd(name, arg_tys, 1)?;
        Option<Type> b = need_simd(name, arg_tys, 2)?;
        simd_same(name, &a, &b)?;
        Option<Type> t = match (&a)
        {
            Some(x) : Some(clone(x)),
            None    : clone(&b),
        };
        match (&m)
        {
            Some(mm) : match (&t)
            {
                Some(tt) :
                {
                    Option<Type> want = simd_mask_of(tt);
                    bool same = match (&want)
                    {
                        Some(w) : type_eq(w, mm),
                        None    : false,
                    };
                    if (!same)
                    {
                        return Err(mismatch(sprintf(
                            "`simd_select` takes a mask of `%s`'s shape, `%s`, and this is `%s`",
                            &type_display(tt),
                            &type_display(&Option::expect(want, "a mask")),
                            &type_display(mm),
                        )));
                    }
                },
                None     : {},
            },
            None : {},
        }
        return Ok(or_type(a, b));
    }
    if (name == "simd_any" || name == "simd_all")
    {
        match (need_simd(name, arg_tys, 0)?)
        {
            Some(m) :
            {
                bool signed_lanes = match (lane_of(&m))
                {
                    Type::TInt(i) : int_ty_signed(i),
                    _             : false,
                };
                if (!signed_lanes)
                {
                    return Err(mismatch(sprintf(
                        "`%s` tests a mask (signed integer lanes, -1 or 0), and this is `%s`",
                        name,
                        &type_display(&m),
                    )));
                }
            },
            None    : {},
        }
        return Ok(Some(Type::TBool));
    }
    if (name == "simd_sum" || name == "simd_reduce_min" || name == "simd_reduce_max")
    {
        return match (need_simd(name, arg_tys, 0)?)
        {
            Some(t) : Ok(Some(lane_of(&t))),
            None    : Ok(None),
        };
    }
    if (name == "simd_load")
    {
        bool is_vec = Vec::len(targs) > 0 && is_simd(&targs[0]);
        if (!is_vec)
        {
            return Err(mismatch("`simd_load` names the vector type it makes: `simd_load<simd<f32, 4>>(s, i)`"));
        }
        ref<Type, shared> v = &targs[0];
        Type lane = lane_of(v);
        match (simd_arg(arg_tys, 0))
        {
            Some(Type::TSlice(sb)) :
            {
                if (!type_eq(&Box::get(&sb).inner, &lane))
                {
                    return Err(mismatch(sprintf(
                        "`simd_load<%s>` reads a `slice<%s, _>`, and this is `%s`",
                        &type_display(v),
                        &type_display(&lane),
                        &type_display(&Type::TSlice(sb)),
                    )));
                }
            },
            Some(t) : return Err(mismatch(sprintf(
                "`simd_load<%s>` reads a `slice<%s, _>`, and this is `%s`",
                &type_display(v),
                &type_display(&lane),
                &type_display(&t),
            ))),
            None                   : {},
        }
        return Ok(Some(clone(v)));
    }
    if (name == "simd_store")
    {
        Option<Type> a0 = simd_arg(arg_tys, 0);
        bool slice0 = match (&a0)
        {
            Some(Type::TSlice(_)) : true,
            _                     : false,
        };
        if (slice0)
        {
            match (need_simd(name, arg_tys, 2)?)
            {
                Some(v) :
                {
                    match (&a0)
                    {
                        Some(Type::TSlice(sb)) :
                        {
                            ref<ModedTy, shared> s = Box::get(sb);
                            if (s.mode != Mode::Exclusive || !type_eq(&s.inner, &lane_of(&v)))
                            {
                                return Err(mismatch(sprintf(
                                    "`simd_store` writes a `%s` into a `slice<%s, exclusive>`, and this is `slice<%s, %s>`",
                                    &type_display(&v),
                                    &type_display(&lane_of(&v)),
                                    &type_display(&s.inner),
                                    if (s.mode == Mode::Exclusive) { "exclusive" } else { "shared" },
                                )));
                            }
                        },
                        _                      : {},
                    }
                },
                None    : {},
            }
        }
        else
        {
            match (a0)
            {
                Some(t) : return Err(mismatch(sprintf(
                    "`simd_store` writes into a `slice<τ, exclusive>`, and this is `%s`",
                    &type_display(&t),
                ))),
                None : {},
            }
        }
        return Ok(Some(Type::TVoid));
    }
    Ok(None)
}

fn op_symbol(BinOp op) : str
{
    match (op)
    {
        BinOp::Add    : "+",
        BinOp::Sub    : "-",
        BinOp::Mul    : "*",
        BinOp::Div    : "/",
        BinOp::Rem    : "%",
        BinOp::Shl    : "<<",
        BinOp::Shr    : ">>",
        BinOp::BitAnd : "&",
        BinOp::BitOr  : "|",
        BinOp::BitXor : "^",
        BinOp::Eq     : "==",
        BinOp::Ne     : "!=",
        BinOp::Lt     : "<",
        BinOp::Le     : "<=",
        BinOp::Gt     : ">",
        BinOp::Ge     : ">=",
        BinOp::And    : "&&",
        BinOp::Or     : "||",
    }
}

// D-0254 `[T-Simd-Op]`: an operator with a `simd` operand.
fn simd_binary_type(BinOp op, ref<Option<Type>, shared> at, ref<Option<Type>, shared> bt) : Result<Option<Type>, String>
{
    ref<Type, shared> ta = match (at)
    {
        Some(t) : t,
        None    : return Ok(clone(bt)),
    };
    ref<Type, shared> tb = match (bt)
    {
        Some(t) : t,
        None    : return Ok(clone(at)),
    };
    if (has_unresolved_marker(ta) || has_unresolved_marker(tb) || is_never(ta) || is_never(tb))
    {
        return Ok(Some(if (is_simd(ta)) { clone(ta) } else { clone(tb) }));
    }
    str sym = op_symbol(op);
    if (!type_eq(ta, tb))
    {
        return Err(mismatch(sprintf(
            "`%s` on a `simd` takes two of one type, lane by lane, and these are `%s` and `%s`; a scalar is made a vector with `[x; N]`",
            sym,
            &type_display(ta),
            &type_display(tb),
        )));
    }
    bool int = match (lane_of(ta))
    {
        Type::TInt(_) : true,
        _             : false,
    };
    if (op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul)
    {
        return Ok(Some(clone(ta)));
    }
    if (op == BinOp::Div && !int)
    {
        return Ok(Some(clone(ta)));
    }
    if (op == BinOp::Div || op == BinOp::Rem)
    {
        return Err(mismatch(sprintf(
            "`%s` on a `simd` is defined for float lanes only: no processor divides integer lanes at once; divide lane by lane",
            sym,
        )));
    }
    if (op == BinOp::BitAnd || op == BinOp::BitOr || op == BinOp::BitXor || op == BinOp::Shl || op == BinOp::Shr)
    {
        if (int)
        {
            return Ok(Some(clone(ta)));
        }
        return Err(mismatch(sprintf("`%s` on a `simd` is defined for integer lanes only", sym)));
    }
    if (op == BinOp::Eq || op == BinOp::Ne)
    {
        return Ok(Some(Type::TBool));
    }
    if (op == BinOp::Lt || op == BinOp::Le || op == BinOp::Gt || op == BinOp::Ge)
    {
        return Err(mismatch(sprintf(
            "`%s` does not order two vectors; compare them lane by lane with `simd_lt`, `simd_le`, `simd_gt` or `simd_ge`, which give a mask",
            sym,
        )));
    }
    Err(mismatch(sprintf("`%s` takes `bool`s; masks combine with `&` and `|`", sym)))
}

fn named_is(ref<Type, shared> t, StringView name) : bool
{
    match (t)
    {
        Type::TNamed(b) : Box::get(b).name == name,
        _               : false,
    }
}

fn named_args(ref<Type, shared> t) : Vec<Type>
{
    match (t)
    {
        Type::TNamed(b) : clone(&Box::get(b).args),
        _               : Vec::new(),
    }
}

fn rawptr_of(Type t) : Type
{
    Type::TRawptr(Box::new(t))
}

fn ref_of(Type t, Mode m) : Type
{
    Type::TRef(Box::new(ModedTy { .inner = t, .mode = m }))
}

fn slice_of(Type t, Mode m) : Type
{
    Type::TSlice(Box::new(ModedTy { .inner = t, .mode = m }))
}

fn array_of(Type t, u128 n) : Type
{
    Type::TArray(Box::new(SizedTy { .inner = t, .n = n }))
}

fn fn_of(Vec<Type> params, Type ret) : Type
{
    Type::TFn(Box::new(FnTy { .params = params, .ret = ret }))
}

// D-0249, D-0253: the type of an atomic's one cell, from the type of a
// reference to it: `T` for `Atomic<T>`, `rawptr<T>` for `AtomicPtr<T>`.
fn atomic_cell_ty(ref<Type, shared> t) : Option<Type>
{
    match (t)
    {
        Type::TRef(b) :
        {
            ref<Type, shared> a = &Box::get(b).inner;
            Vec<Type> args = named_args(a);
            if (named_is(a, "std::Atomic"))
            {
                return if (Vec::len(&args) > 0) { Some(clone(&args[0])) } else { None };
            }
            if (named_is(a, "std::AtomicPtr"))
            {
                return if (Vec::len(&args) > 0) { Some(rawptr_of(clone(&args[0]))) } else { None };
            }
            None
        },
        _             : None,
    }
}

export struct FfiProblem
{
    export Vec<String> path;
    export String what;
}

fn ffi_here(String what) : Option<FfiProblem>
{
    Some(FfiProblem { .path = Vec::new(), .what = what })
}

// D-0252: `FfiType` also has every `ffi-struct`. `None` when `t` crosses;
// otherwise the field path to the part C could not receive and what that
// part is, for the message.
fn ffi_type_problem(ref<Items, shared> it, ref<Type, shared> t, bool top) : Option<FfiProblem>
{
    match (t)
    {
        Type::TVoid : if (top) { return None; },
        _           : {},
    }
    bool void_t = match (t)
    {
        Type::TVoid : true,
        _           : false,
    };
    if (is_ffi_type(t) && !void_t)
    {
        return None;
    }
    match (t)
    {
        Type::TArray(b) :
        {
            if (!top && Box::get(b).n > 0)
            {
                return ffi_type_problem(it, &Box::get(b).inner, false);
            }
            if (top)
            {
                return ffi_here(sprintf(
                    "`%s`, an array, which C passes only as a pointer (`rawptr`)",
                    &type_display(t),
                ));
            }
        },
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (HashMap::contains(&it.enums, &n.name))
            {
                return ffi_here(sprintf("`%s`, an enum (a C enum is an integer type here)", &type_display(t)));
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    if (s.resource_ || (StringView::starts_with(&n.name, "std::") && is_resource_ty(it, t)))
                    {
                        return ffi_here(sprintf("`%s`, a resource", &type_display(t)));
                    }
                    if (Option::is_some(&s.bits))
                    {
                        return ffi_here(sprintf(
                            "`%s`, a bitstruct (it crosses as its backing integer)",
                            &type_display(t),
                        ));
                    }
                    if (Vec::len(&s.fields) == 0)
                    {
                        return ffi_here(sprintf("`%s`, a struct with no fields", &type_display(t)));
                    }
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        match (ffi_type_problem(it, &apply_subst(&s.fields[i].ty, &subst), false))
                        {
                            Some(p) :
                            {
                                FfiProblem { path, what } = p;
                                Vec::insert(&mut path, 0, String::clone(&s.fields[i].name));
                                return Some(FfiProblem { .path = path, .what = what });
                            },
                            None    : {},
                        }
                    }
                    return None;
                },
                None    : {},
            }
        },
        _               : {},
    }
    ffi_here(sprintf("`%s`", &type_display(t)))
}

// `params` zipped with `args` (the shorter's length) as a substitution.
export fn zip_subst(ref<Vec<String>, shared> params, ref<Vec<Type>, shared> args) : HashMap<String, Type>
{
    HashMap<String, Type> m = HashMap::new();
    for (usize i = 0; i < Vec::len(params) && i < Vec::len(args); i += 1)
    {
        HashMap::insert(&mut m, String::clone(&params[i]), clone(&args[i]));
    }
    m
}

// The module part of an item's qualified key: one trailing segment for
// `m::f`, two for an associated `m::T::name`.
fn declaring_module(StringView key, bool assoc) : String
{
    Vec<StringView> segs = StringView::split(key, "::");
    Vec::pop(&mut segs);
    if (assoc)
    {
        Vec::pop(&mut segs);
    }
    StringView::join(&segs, "::")
}

// `rule.module.visibility` `[Field-Not-Visible]`: a field is visible where
// its struct's module is, or anywhere if `export`.
fn field_visible(StringView struct_key, bool export_, StringView from_module) : bool
{
    if (export_)
    {
        return true;
    }
    StringView decl_module = match (rfind_sep(struct_key))
    {
        Some(k) : &struct_key[0..k],
        None    : "",
    };
    if (StringView::len(decl_module) == 0 || (from_module == decl_module))
    {
        return true;
    }
    String prefix = sprintf("%s::", decl_module);
    StringView::starts_with(from_module, &prefix)
}

// The position of the last `::` in `s`.
fn rfind_sep(StringView s) : Option<usize>
{
    slice<u8, shared> b = StringView::as_bytes(s);
    usize n = StringView::len(s);
    usize k = n;
    while (k >= 2)
    {
        k -= 1;
        if (b[k] == b':' && b[k - 1] == b':')
        {
            return Some(k - 1);
        }
    }
    None
}

fn types_contain(ref<Vec<Type>, shared> v, ref<Type, shared> t) : bool
{
    for (usize i = 0; i < Vec::len(v); i += 1)
    {
        if (type_eq(&v[i], t))
        {
            return true;
        }
    }
    false
}

// `[Type-Recursive]` (D-0045): a struct or enum that contains itself by
// value has no finite size; 64 levels deep counts as recursive.
fn contains_by_value(ref<Items, shared> it, ref<Type, shared> t, ref<Vec<Type>, exclusive> stack) : bool
{
    match (t)
    {
        Type::TArray(b) : contains_by_value(it, &Box::get(b).inner, stack),
        Type::TMutex(b) : contains_by_value(it, Box::get(b), stack),
        Type::TNamed(b) :
        {
            if (types_contain(stack, t) || Vec::len(stack) > 64)
            {
                return true;
            }
            ref<NamedTy, shared> n = Box::get(b);
            Vec<String> params = Vec::new();
            Vec<Type> parts = Vec::new();
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    params = Vec::clone(&s.type_params);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        Vec::push(&mut parts, clone(&s.fields[i].ty));
                    }
                },
                None : match (HashMap::get(&it.enums, &n.name))
                {
                    Some(e) :
                    {
                        params = Vec::clone(&e.type_params);
                        for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                        {
                            match (&e.variants[i].payload)
                            {
                                Some(p) : Vec::push(&mut parts, clone(p)),
                                None    : {},
                            }
                        }
                    },
                    None    : return false,
                },
            }
            HashMap<String, Type> sub = zip_subst(&params, &n.args);
            Vec::push(stack, clone(t));
            bool found = false;
            for (usize i = 0; i < Vec::len(&parts) && !found; i += 1)
            {
                found = contains_by_value(it, &apply_subst(&parts[i], &sub), stack);
            }
            Vec::pop(stack);
            found
        },
        _               : false,
    }
}

struct DeclRef
{
    String key;
    Vec<String> params;
    usize line;
}

struct KeyLine
{
    String key;
    usize line;
}

// The first (by name) struct or enum that contains itself by value.
fn recursive_type(ref<Items, shared> it) : Option<KeyLine>
{
    Vec<String> keys = Vec::new();
    for (usize i = 0; i < HashMap::len(&it.structs); i += 1)
    {
        Vec::push(&mut keys, String::clone(HashMap::key_at(&it.structs, i)));
    }
    for (usize i = 0; i < HashMap::len(&it.enums); i += 1)
    {
        Vec::push(&mut keys, String::clone(HashMap::key_at(&it.enums, i)));
    }
    Vec::sort(&mut keys);
    for (usize i = 0; i < Vec::len(&keys); i += 1)
    {
        ref<String, shared> k = &keys[i];
        Vec<String> params = Vec::new();
        usize line = 0;
        match (HashMap::get(&it.structs, k))
        {
            Some(s) :
            {
                params = Vec::clone(&s.type_params);
                line = s.line;
            },
            None    :
            {
                ref<EnumDecl, shared> e = Option::expect(HashMap::get(&it.enums, k), "an enum");
                params = Vec::clone(&e.type_params);
                line = e.line;
            },
        }
        Vec<Type> args = Vec::new();
        for (usize p = 0; p < Vec::len(&params); p += 1)
        {
            Vec::push(&mut args, named(&params[p], Vec::new()));
        }
        Type t = named(k, args);
        Vec<Type> stack = Vec::new();
        if (contains_by_value(it, &t, &mut stack))
        {
            return Some(KeyLine { .key = String::clone(k), .line = line });
        }
    }
    None
}

// Bug 042 (`[Type-Recursion-Expanding]`, spec/16 §1): a generic struct or
// enum whose fields name it again (directly or through other generic
// types) at a type argument that holds one of its parameters inside a
// larger type (`Nest<T>` holding `Nest<Option<T>>`) has instantiations
// that never end. Each type parameter of each generic declaration is a
// node; an occurrence `E<…, a_j, …>` in the fields of `D<…, T_i, …>` is an
// edge from `T_i` to `E`'s j-th parameter, a growing one unless `a_j` is
// `T_i` itself. The program is rejected when a growing edge lies on a
// cycle (the finite-closure test of ECMA-335 II.9.2).
struct TypeEdge
{
    usize from;
    usize to;
    bool grows;
    usize decl;
    Type at;
}

struct Expanding
{
    String key;
    Vec<String> params;
    Type at;
    usize line;
}

fn expanding_type(ref<Items, shared> it) : Option<Expanding>
{
    Vec<String> keys = Vec::new();
    for (usize i = 0; i < HashMap::len(&it.structs); i += 1)
    {
        if (Vec::len(&HashMap::value_at(&it.structs, i).type_params) > 0)
        {
            Vec::push(&mut keys, String::clone(HashMap::key_at(&it.structs, i)));
        }
    }
    for (usize i = 0; i < HashMap::len(&it.enums); i += 1)
    {
        if (Vec::len(&HashMap::value_at(&it.enums, i).type_params) > 0)
        {
            Vec::push(&mut keys, String::clone(HashMap::key_at(&it.enums, i)));
        }
    }
    if (Vec::len(&keys) == 0)
    {
        return None;
    }
    Vec::sort(&mut keys);
    Vec<DeclRef> decls = Vec::new();
    HashMap<String, usize> bases = HashMap::new();
    usize nodes = 0;
    for (usize d = 0; d < Vec::len(&keys); d += 1)
    {
        ref<String, shared> k = &keys[d];
        DeclRef r = match (HashMap::get(&it.structs, k))
        {
            Some(s) : DeclRef { .key = String::clone(k), .params = Vec::clone(&s.type_params), .line = s.line },
            None    :
            {
                ref<EnumDecl, shared> e = Option::expect(HashMap::get(&it.enums, k), "an enum");
                DeclRef { .key = String::clone(k), .params = Vec::clone(&e.type_params), .line = e.line }
            },
        };
        HashMap::insert(&mut bases, String::clone(k), nodes);
        nodes += Vec::len(&r.params);
        Vec::push(&mut decls, r);
    }
    Vec<TypeEdge> edges = Vec::new();
    usize base = 0;
    for (usize d = 0; d < Vec::len(&decls); d += 1)
    {
        match (HashMap::get(&it.structs, &decls[d].key))
        {
            Some(s) :
            {
                for (usize f = 0; f < Vec::len(&s.fields); f += 1)
                {
                    type_edges(&bases, &decls[d].params, base, d, &s.fields[f].ty, &mut edges);
                }
            },
            None    :
            {
                ref<EnumDecl, shared> e = Option::expect(HashMap::get(&it.enums, &decls[d].key), "an enum");
                for (usize v = 0; v < Vec::len(&e.variants); v += 1)
                {
                    match (&e.variants[v].payload)
                    {
                        Some(p) : type_edges(&bases, &decls[d].params, base, d, p, &mut edges),
                        None    : {},
                    }
                }
            },
        }
        base += Vec::len(&decls[d].params);
    }
    Vec<Vec<usize>> out = Vec::new();
    for (usize n = 0; n < nodes; n += 1)
    {
        Vec::push(&mut out, Vec::new());
    }
    bool any = false;
    for (usize k = 0; k < Vec::len(&edges); k += 1)
    {
        Vec::push(&mut out[edges[k].from], edges[k].to);
        any = any || edges[k].grows;
    }
    if (!any)
    {
        return None;
    }
    // The first growing edge (by declaration name) whose target reaches
    // its source.
    for (usize k = 0; k < Vec::len(&edges); k += 1)
    {
        if (!edges[k].grows)
        {
            continue;
        }
        Vec<bool> seen = Vec::new();
        for (usize n = 0; n < nodes; n += 1)
        {
            Vec::push(&mut seen, false);
        }
        Vec<usize> todo = Vec::new();
        Vec::push(&mut todo, edges[k].to);
        seen[edges[k].to] = true;
        bool back = false;
        while (!back && Vec::len(&todo) > 0)
        {
            usize n = Option::unwrap(Vec::pop(&mut todo));
            if (n == edges[k].from)
            {
                back = true;
            }
            for (usize m = 0; m < Vec::len(&out[n]); m += 1)
            {
                usize x = out[n][m];
                if (!seen[x])
                {
                    seen[x] = true;
                    Vec::push(&mut todo, x);
                }
            }
        }
        if (back)
        {
            ref<DeclRef, shared> d = &decls[edges[k].decl];
            return Some(Expanding { .key = String::clone(&d.key), .params = Vec::clone(&d.params), .at = clone(&edges[k].at), .line = d.line });
        }
    }
    None
}

// The edges of one field's type `t` in declaration `decl` (`expanding_type`).
fn type_edges(
    ref<HashMap<String, usize>, shared> bases,
    ref<Vec<String>, shared> params,
    usize base,
    usize decl,
    ref<Type, shared> t,
    ref<Vec<TypeEdge>, exclusive> edges,
)
{
    match (t)
    {
        Type::TNamed(nb) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            match (HashMap::get(bases, &n.name))
            {
                Some(tb) :
                {
                    for (usize j = 0; j < Vec::len(&n.args); j += 1)
                    {
                        for (usize i = 0; i < Vec::len(params); i += 1)
                        {
                            bool same = match (&n.args[j])
                            {
                                Type::TNamed(ab) : Box::get(ab).name == params[i] && Vec::len(&Box::get(ab).args) == 0,
                                _                : false,
                            };
                            if (same || mentions_param(&n.args[j], &params[i]))
                            {
                                Vec::push(
                                    edges,
                                    TypeEdge { .from = base + i, .to = *tb + j, .grows = !same, .decl = decl, .at = clone(t) },
                                );
                            }
                        }
                    }
                },
                None     : {},
            }
            for (usize j = 0; j < Vec::len(&n.args); j += 1)
            {
                type_edges(bases, params, base, decl, &n.args[j], edges);
            }
        },
        Type::TRef(rb)   : type_edges(bases, params, base, decl, &Box::get(rb).inner, edges),
        Type::TSlice(sb) : type_edges(bases, params, base, decl, &Box::get(sb).inner, edges),
        Type::TArray(ab) : type_edges(bases, params, base, decl, &Box::get(ab).inner, edges),
        Type::TSimd(ab)  : type_edges(bases, params, base, decl, &Box::get(ab).inner, edges),
        Type::TRawptr(x) : type_edges(bases, params, base, decl, Box::get(x), edges),
        Type::THandle(x) : type_edges(bases, params, base, decl, Box::get(x), edges),
        Type::TMutex(x)  : type_edges(bases, params, base, decl, Box::get(x), edges),
        Type::TGuard(x)  : type_edges(bases, params, base, decl, Box::get(x), edges),
        Type::TFn(fb)    :
        {
            type_edges(bases, params, base, decl, &Box::get(fb).ret, edges);
            for (usize i = 0; i < Vec::len(&Box::get(fb).params); i += 1)
            {
                type_edges(bases, params, base, decl, &Box::get(fb).params[i], edges);
            }
        },
        _                : {},
    }
}

// Whether type parameter `p` occurs in `t`.
fn mentions_param(ref<Type, shared> t, ref<String, shared> p) : bool
{
    match (t)
    {
        Type::TNamed(nb) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (n.name == *p && Vec::len(&n.args) == 0)
            {
                return true;
            }
            for (usize j = 0; j < Vec::len(&n.args); j += 1)
            {
                if (mentions_param(&n.args[j], p))
                {
                    return true;
                }
            }
            false
        },
        Type::TRef(rb)   : mentions_param(&Box::get(rb).inner, p),
        Type::TSlice(sb) : mentions_param(&Box::get(sb).inner, p),
        Type::TArray(ab) : mentions_param(&Box::get(ab).inner, p),
        Type::TSimd(ab)  : mentions_param(&Box::get(ab).inner, p),
        Type::TRawptr(x) : mentions_param(Box::get(x), p),
        Type::THandle(x) : mentions_param(Box::get(x), p),
        Type::TMutex(x)  : mentions_param(Box::get(x), p),
        Type::TGuard(x)  : mentions_param(Box::get(x), p),
        Type::TFn(fb)    :
        {
            if (mentions_param(&Box::get(fb).ret, p))
            {
                return true;
            }
            for (usize i = 0; i < Vec::len(&Box::get(fb).params); i += 1)
            {
                if (mentions_param(&Box::get(fb).params[i], p))
                {
                    return true;
                }
            }
            false
        },
        _                : false,
    }
}

fn tagged_at(String d, usize line) : String
{
    sprintf("%s@%v", &d, line)
}

fn named_diag(str id, StringView msg) : String
{
    sprintf("%s\u{1}%s", id, msg)
}

fn sorted_keys_of_fns(ref<HashMap<String, FnDecl>, shared> m) : Vec<String>
{
    Vec<String> keys = Vec::new();
    for (usize i = 0; i < HashMap::len(m); i += 1)
    {
        Vec::push(&mut keys, String::clone(HashMap::key_at(m, i)));
    }
    Vec::sort(&mut keys);
    keys
}

// Whether `v` (a literal's value) fits integer type `t`.
fn in_range(IntTy t, i128 v) : bool
{
    if (t == IntTy::U128)
    {
        return true;
    }
    IntRange r = int_range(t);
    v >= r.min && v <= r.max
}

// The checker's facts for the back end that lowers the program, each keyed
// by an expression's id, and the D-0162 records.
export struct Facts
{
    export HashMap<String, bool> checked_fns;
    export HashMap<usize, Type> match_hints;
    export HashSet<usize> temp_borrows;
    // D-0309 (`[Call-Self-Tail]`): the self tail calls (`self_tail.cb`).
    export HashSet<usize> self_tails;
    export HashSet<usize> shared_fn_reads;
    export HashMap<usize, Vec<String>> early_ends;
    // D-0341 (report 418): by a statement's key, the `ref` bindings of an
    // enclosing block whose loan ends after it: their next mention is a
    // whole reassignment, so the old loan is not read again.
    export HashMap<usize, Vec<String>> releases;
    // Report 114 (D-0111): the reference bindings that end right after an
    // `if`'s condition, their last use, by the condition's id.
    export HashMap<usize, Vec<String>> cond_ends;
    // Report 268: by an `if`'s condition's id, the bindings that end at the
    // start of its then branch.
    export HashMap<usize, Vec<String>> then_ends;
    // Report 292: by a nested block's statement's key, the bindings of an
    // enclosing block that end after it (their last mention there).
    export HashMap<usize, Vec<String>> nested_ends;
    // Report 292: by an `if`'s condition's id, the bindings that end at the
    // start of its else branch.
    export HashMap<usize, Vec<String>> else_ends;
    // Report 052: the `match` arm binders that end after a statement of the
    // arm's block, by the statement's key: bound in the arm's scope, around
    // the block's own (`end_ref_bindings` in the back end).
    export HashMap<usize, Vec<String>> binder_ends;
    export HashMap<usize, Type> closure_types;
    export HashSet<usize> number_literals;
    export HashSet<String> const_addrs;
    // D-0103: `f().x` moving a field out of a temporary, and the block
    // that is run instead.
    export HashMap<usize, Expr> temp_moves;
    // D-0053: the expressions that are `StringView` operations.
    export HashMap<usize, ViewOp> view_ops;
    // D-0340 §1: the value of an integer expression of known operands, by its
    // id, so an enclosing operator folds through it in one step.
    HashMap<usize, i128> folded;
    // D-0340 §9: the type the checker settled for an array literal, an `if`,
    // a `match` or a struct literal holding an `Option` or a `Result` whose
    // type arguments only unification across its parts fixes, by id (in a
    // body that is not generic): the lowering takes it where nothing else
    // gives one.
    export HashMap<usize, Type> settled;
    // An `if`'s type when its expected type is fixed only by one branch,
    // by the `if`'s id.
    export HashMap<usize, Type> if_hints;
    // D-0162: text literals typed as `String` through a generic
    // parameter (`literal_yes`) and otherwise (`literal_no`), and the
    // rewrites the checker asks for (D-0164, D-0218, D-0225).
    export HashSet<usize> literal_yes;
    export HashSet<usize> literal_no;
    export HashMap<usize, Rewrite> rewrites;
    // D-0312: text an instantiation of a generic body checked at a declared
    // type without `[Coerce-Text]`, by id, with its place (`note_unrewritten`).
    export HashMap<usize, TextAt> unrewritten;
    // D-0314: each `[Coerce-Slice-Literal]` node's array type and place, by
    // id; no type once two instantiations of a generic body disagree.
    export HashMap<usize, SliceLit> slice_literals;
    // While `check_more` runs: its literal records and rewrites are not kept.
    export bool silent;
    // D-0322: the comparisons, by id, that are an `assert`'s whole condition.
    export HashSet<usize> assert_cmps;
    // Each block's `early_end_plan`, by `block_key`: it depends on the
    // block's text alone, and a block is checked again and again.
    HashMap<usize, EarlyPlan> plans;
    // D-0290: `holder_type`, `data_type` and `stores_refs` of each type
    // asked about, and `may_hold_excl_ref`, by `type_code`: they depend on
    // the type alone.
    HashMap<String, TypeKinds> type_memo;
    HashMap<String, bool> excl_memo;
    // D-0303: the warnings `--allow-deprecated` collects for fields and for
    // variants named in a pattern.
    export Vec<RetiredNote> retired_notes;
    // Bug 014 (spec/14 §6, the part-store summary): for each function by
    // name, the pairs `t:s` of its parameters such that its body may store
    // into what parameter `t` reaches a reference into a part of what
    // parameter `s` refers to (`part_stores`); the functions that may store
    // any (`part_stores_all`); those whose body was checked
    // (`part_summarized`); and the calls that gave an argument exclusively
    // judged by its own type, each standing while its callee's summary has
    // no such pair (`part_assumes`, settled by `part_resolve`), with the
    // self tail calls of the bodies that made one (`part_tails`).
    HashMap<String, HashSet<String>> part_stores;
    HashSet<String> part_stores_all;
    HashSet<String> part_summarized;
    Vec<PartAssume> part_assumes;
    HashMap<String, Vec<usize>> part_tails;
}

// Bug 014: a call in the body `body` (of function `func`) that judged its
// argument `s`, given exclusively, by its own type beside its argument `t`,
// as `callee` stores no reference into a part of parameter `s` into what
// parameter `t` reaches.
struct PartAssume
{
    String body;
    String func;
    String callee;
    usize t;
    usize s;
    usize line;
    bool failed;
}

// D-0312: where a node is (`Facts::unrewritten`).
export struct TextAt
{
    export usize line;
    export usize col;
}

export struct SliceLit
{
    export Option<Type> t;
    export usize line;
    export usize col;
}

export fn new_facts() : Facts
{
    Facts {
        .checked_fns = HashMap::new(),
        .match_hints = HashMap::new(),
        .temp_borrows = HashSet::new(),
        .self_tails = HashSet::new(),
        .shared_fn_reads = HashSet::new(),
        .early_ends = HashMap::new(),
        .releases = HashMap::new(),
        .cond_ends = HashMap::new(),
        .then_ends = HashMap::new(),
        .nested_ends = HashMap::new(),
        .else_ends = HashMap::new(),
        .binder_ends = HashMap::new(),
        .closure_types = HashMap::new(),
        .number_literals = HashSet::new(),
        .const_addrs = HashSet::new(),
        .temp_moves = HashMap::new(),
        .view_ops = HashMap::new(),
        .folded = HashMap::new(),
        .settled = HashMap::new(),
        .if_hints = HashMap::new(),
        .literal_yes = HashSet::new(),
        .literal_no = HashSet::new(),
        .rewrites = HashMap::new(),
        .slice_literals = HashMap::new(),
        .unrewritten = HashMap::new(),
        .silent = false,
        .assert_cmps = HashSet::new(),
        .plans = HashMap::new(),
        .type_memo = HashMap::new(),
        .excl_memo = HashMap::new(),
        .retired_notes = Vec::new(),
        .part_stores = HashMap::new(),
        .part_stores_all = HashSet::new(),
        .part_summarized = HashSet::new(),
        .part_assumes = Vec::new(),
        .part_tails = HashMap::new(),
    }
}

// Whether every item is checked, `std`'s included (`COBALTC_CHECK_ALL=1`),
// or only the program's own items and the `std` items they reach.
fn check_all() : bool
{
    match (env_var("COBALTC_CHECK_ALL"))
    {
        Ok(Some(v)) : StringView::len(&v) > 0 && v != "0",
        _           : false,
    }
}

// An item of `std`.
fn is_std_key(ref<String, shared> key) : bool
{
    StringView::starts_with(key, "std::")
}

/// A `static_assert` (D-0052) to compute once the static pass accepts the
/// program.
// Where a diagnostic's line inside `std` begins: `STD_LINE + N` is line N of
// the prelude (`PRELUDE_STD_ORIGINS` places it in `std`'s files).
export const usize STD_LINE = 1099511627776;

export struct StaticAssert
{
    String key_code;
    export Expr cond;
    export HashMap<String, Type> subst;
    export usize line;
    export Option<String> message;
    export Option<Expr> message_fmt;
}

struct WorkItem
{
    String name;
    Vec<Type> targs;
    // Bug 090: the line of the call that asked for this instantiation (0
    // for none), for its errors to name.
    usize at_line;
}

fn work(StringView name, Vec<Type> targs) : WorkItem
{
    WorkItem { .name = String::copy(name), .targs = targs, .at_line = 0 }
}

export fn work_code(ref<String, shared> name, ref<Vec<Type>, shared> targs) : String
{
    sprintf("%s|%s", name, &types_code(targs))
}

struct Ck
{
    HashSet<String> checked;
    Vec<WorkItem> worklist;
    // `[Generic-Instantiation-Unbounded]` (CHG-0357): concrete
    // instantiations checked so far.
    u32 instances;
    Vec<StaticAssert> static_asserts;
    HashSet<String> static_assert_keys;
}

// A function the lowering asks for that the static pass has not checked
// (`printf`'s helpers, `Vec`'s growth, a destructor): checked now, its body
// loaded first, nothing it records about literals kept (`check_more`).
export fn check_more(
    ref<Items, exclusive> it,
    ref<Front, shared> front,
    ref<Facts, exclusive> facts,
    ref<String, shared> name,
    ref<Vec<Type>, shared> targs,
) : Result<void, String>
{
    Vec<WorkItem> wl = Vec::new();
    Vec::push(&mut wl, work(name, clone(targs)));
    // D-0315: the functions checked so far are the facts' record, which
    // `ck_run` asks too (no copy of it per call).
    Ck ck = new_ck(wl);
    bool was = facts.silent;
    facts.silent = true;
    Result<void, String> r = ck_run(&mut ck, it, front, facts);
    facts.silent = was;
    r
}

fn new_ck(Vec<WorkItem> worklist) : Ck
{
    Ck {
        .checked = HashSet::new(),
        .worklist = worklist,
        .instances = 0,
        .static_asserts = Vec::new(),
        .static_assert_keys = HashSet::new(),
    }
}

export fn check_program(
    ref<Items, exclusive> it,
    ref<Front, shared> front,
    ref<Facts, exclusive> facts,
) : Result<Vec<StaticAssert>, String>
{
    match (recursive_type(it))
    {
        Some(kl) :
        {
            StringView shown = last_segment(&kl.key);
            String msg = sprintf(
                "`%s` contains a `%s` by value (directly or through its fields), so it would have no finite size; hold the inner one through `Box<%s>` (`Option<Box<%s>>` for \"none\"), `Rc<%s>`, or an index into a `Vec`",
                shown,
                shown,
                shown,
                shown,
                shown,
            );
            return Err(tagged_at(named_diag("diag.recursive-type", &msg), kl.line));
        },
        None     : {},
    }
    match (expanding_type(it))
    {
        Some(x) :
        {
            Vec<Type> args = Vec::new();
            for (usize p = 0; p < Vec::len(&x.params); p += 1)
            {
                Vec::push(&mut args, named(&x.params[p], Vec::new()));
            }
            String own = type_display(&named(&x.key, args));
            String msg = sprintf(
                "`%s` holds `%s`, which leads back to `%s` at a larger type argument each time, so its instantiations never end; on the way back name the type with its own parameters (`%s`), or keep the growing part in a type that does not depend on them",
                &own,
                &type_display(&x.at),
                last_segment(&x.key),
                &own,
            );
            return Err(tagged_at(named_diag("diag.instantiation-unbounded", &msg), x.line));
        },
        None    : {},
    }
    Vec<String> keys = sorted_keys_of_fns(&it.fns);
    // `[Const-Not-Constant]` (D-0036).
    for (usize i = 0; i < Vec::len(&keys); i += 1)
    {
        ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &keys[i]), "a function");
        if (f.is_const)
        {
            bool init_ok = match (&f.body.tail)
            {
                Some(e) : const_expr(it, Box::get(e)),
                None    : false,
            };
            if (is_resource_ty(it, &f.ret) || !init_ok)
            {
                return Err(sprintf("diag.const-not-constant@%v", f.line));
            }
        }
    }
    // D-0258 `[Static-Well-Formed]`, each reported where it is declared.
    Vec<KeyLine> statics = Vec::new();
    for (usize i = 0; i < HashMap::len(&it.statics); i += 1)
    {
        Vec::push(
            &mut statics,
            KeyLine { .key = String::clone(HashMap::key_at(
                &it.statics,
                i,
            )), .line = HashMap::value_at(&it.statics, i).line },
        );
    }
    sort_by_line(&mut statics);
    for (usize i = 0; i < Vec::len(&statics); i += 1)
    {
        ref<StaticDecl, shared> s = Option::expect(HashMap::get(&it.statics, &statics[i].key), "a static");
        Option<Type> lane = static_lane(&s.ty);
        bool ok_init = match (&lane)
        {
            Some(Type::TInt(_)) : match (&s.init.kind)
            {
                ExprKind::EInt(_) : true,
                ExprKind::EUnary(u) : Box::get(u).op == UnOp::Neg && match (&Box::get(u).e.kind)
                {
                    ExprKind::EInt(_) : true,
                    _                 : false,
                },
                _                 : false,
            },
            Some(Type::TBool) : match (&s.init.kind)
            {
                ExprKind::EBool(_) : true,
                _                  : false,
            },
            _ : false,
        };
        match (&lane)
        {
            None     :
            {
                String msg = sprintf(
                    "a `static` holds an atomic, `Atomic<T>` (`T` an integer type) or `AtomicBool`, which every thread may change; `%s` is not one (a constant is `const`, and any other value lives in `main` and is passed on)",
                    &type_display(&s.ty),
                );
                return Err(tagged_at(named_diag("diag.type-mismatch", &msg), s.line));
            },
            Some(lt) :
            {
                if (!ok_init)
                {
                    String msg = sprintf(
                        "a `static`'s first value is a literal of `%s`: `static %s %s = 0;`",
                        &type_display(lt),
                        &type_display(&s.ty),
                        &s.name,
                    );
                    return Err(tagged_at(named_diag("diag.type-mismatch", &msg), s.line));
                }
                match (lt)
                {
                    Type::TInt(itx) :
                    {
                        match (&s.init.kind)
                        {
                            ExprKind::EInt(lb) :
                            {
                                u128 v = Box::get(lb).v;
                                if (!in_range(*itx, reinterpret<i128>(v)))
                                {
                                    String msg = sprintf(
                                        "`%v` does not fit `%s`, the static's lane type",
                                        v,
                                        &type_display(lt),
                                    );
                                    return Err(tagged_at(named_diag("diag.literal-out-of-range", &msg), s.line));
                                }
                            },
                            _                  : {},
                        }
                    },
                    _               : {},
                }
            },
        }
    }
    // `[Extern-Non-Ffi-Type]` on every declared extern fn.
    Vec<KeyLine> exts = Vec::new();
    for (usize i = 0; i < HashMap::len(&it.externs); i += 1)
    {
        Vec::push(
            &mut exts,
            KeyLine { .key = String::clone(HashMap::key_at(
                &it.externs,
                i,
            )), .line = HashMap::value_at(&it.externs, i).line },
        );
    }
    sort_by_line(&mut exts);
    // Bugs 120, 231: the declaration errors that do not stop the bodies'
    // check (an extern's signature, the missing `main`), reported with its
    // errors.
    Vec<String> held = Vec::new();
    Option<String> held_no_main = None;
    for (usize i = 0; i < Vec::len(&exts); i += 1)
    {
        ref<ExternDecl, shared> ext = Option::expect(HashMap::get(&it.externs, &exts[i].key), "an extern");
        Vec<Type> tys = Vec::new();
        for (usize p = 0; p < Vec::len(&ext.params); p += 1)
        {
            Vec::push(&mut tys, clone(&ext.params[p].ty));
        }
        Vec::push(&mut tys, clone(&ext.ret));
        for (usize k = 0; k < Vec::len(&tys); k += 1)
        {
            match (ffi_type_problem(it, &tys[k], true))
            {
                Some(p) :
                {
                    String part = ffi_part(&tys[k], p);
                    String msg = sprintf(
                        "`%s` cannot cross to C: its signature has %s; an extern's types are integers, `f32`, `f64`, `bool`, `rawptr<T>` and plain structs of those (D-0252)",
                        &ext.name,
                        &part,
                    );
                    Vec::push(&mut held, tagged_at(named_diag("diag.extern-non-ffi-type", &msg), ext.line));
                    break;
                },
                None    : {},
            }
        }
        if (!ext.variadic)
        {
            match (c_variadic_fixed(&ext.name))
            {
                Some(k) :
                {
                    String msg = sprintf(
                        "`%s` is a C function that takes a variable argument list: declare it as C does, with its %v fixed parameter%s and then `...` (`unsafe extern fn %s(…, ...) : …;`)",
                        &ext.name,
                        k,
                        if (k == 1) { "" } else { "s" },
                        &ext.name,
                    );
                    Vec::push(&mut held, tagged_at(named_diag("diag.extern-variadic-without-ellipsis", &msg), ext.line));
                },
                None    : {},
            }
        }
    }
    // D-0257 `[Extern-Entry]`.
    Vec<KeyLine> entries = Vec::new();
    for (usize i = 0; i < Vec::len(&keys); i += 1)
    {
        ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &keys[i]), "a function");
        if (f.c_entry)
        {
            Vec::push(&mut entries, KeyLine { .key = String::clone(&keys[i]), .line = f.line });
        }
    }
    sort_by_line(&mut entries);
    HashMap<String, String> entry_names = HashMap::new();
    for (usize i = 0; i < Vec::len(&entries); i += 1)
    {
        ref<String, shared> key = &entries[i].key;
        ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, key), "a function");
        Vec<Type> tys = Vec::new();
        for (usize p = 0; p < Vec::len(&f.params); p += 1)
        {
            Vec::push(&mut tys, clone(&f.params[p].ty));
        }
        Vec::push(&mut tys, clone(&f.ret));
        for (usize k = 0; k < Vec::len(&tys); k += 1)
        {
            match (ffi_type_problem(it, &tys[k], true))
            {
                Some(p) :
                {
                    String part = ffi_part(&tys[k], p);
                    String msg = sprintf(
                        "`%s` cannot be called from C: its signature has %s; a function C calls takes and gives integers, `f32`, `f64`, `bool`, `rawptr<T>` and plain structs of those (D-0257)",
                        &f.name,
                        &part,
                    );
                    return Err(tagged_at(named_diag("diag.extern-non-ffi-type", &msg), f.line));
                },
                None    : {},
            }
        }
        if (StringView::starts_with(&f.name, "cb_") || StringView::starts_with(&f.name, "cobalt_"))
        {
            String msg = sprintf(
                "`%s` is a C name the runtime reserves (`cb_…` and `cobalt_…`); choose another for a function C calls",
                &f.name,
            );
            return Err(tagged_at(named_diag("diag.duplicate-item", &with_repair(&msg, "rename the entry; a module does not change the name C calls it by")), f.line));
        }
        // An entry is a C symbol in C's one name space: a C library's name
        // (`libc_names`) would be refused by the C compiler or would take the
        // library function's place for the whole process; one that begins
        // with `_` is the C implementation's (C11 7.1.3).
        if (StringView::starts_with(&f.name, "_") || c_library_name(&f.name))
        {
            String msg = sprintf(
                "`%s` is a name the C library or C itself has; a function C calls by `%s` would take its place for the whole program, the runtime's own calls included: choose another name",
                &f.name,
                &f.name,
            );
            return Err(tagged_at(named_diag("diag.duplicate-item", &with_repair(&msg, "")), f.line));
        }
        match (HashMap::insert(&mut entry_names, String::clone(&f.name), String::clone(key)))
        {
            Some(other) :
            {
                String msg = sprintf(
                    "`%s` and `%s` would both be C's `%s`: two functions C calls cannot share a name",
                    &other,
                    key,
                    &f.name,
                );
                return Err(tagged_at(named_diag("diag.duplicate-item", &with_repair(&msg, "rename one of the two entries; a module does not change the name C calls it by")), f.line));
            },
            None        : {},
        }
    }
    bool is_library = Vec::len(&entries) > 0 && !HashMap::contains(&it.fns, &String::copy("main"));
    // `rule.fn.program` `[Program-No-Main]`.
    bool has_main = false;
    match (HashMap::get(&it.fns, &String::copy("main")))
    {
        Some(m) :
        {
            bool ret_ok = match (&m.ret)
            {
                Type::TVoid   : true,
                Type::TInt(i) : *i == IntTy::U8,
                _             : false,
            };
            if (Vec::len(&m.type_params) == 0 && Vec::len(&m.params) == 0 && ret_ok)
            {
                has_main = true;
            }
            else
            {
                // CHG-0452: what this `main` has that one cannot.
                String why = if (Vec::len(&m.type_params) > 0)
                {
                    "is generic"
                }
                else if (Vec::len(&m.params) > 0)
                {
                    "takes parameters"
                }
                else
                {
                    sprintf("returns `%s`", &type_display(&m.ret))
                };
                String msg = sprintf(
                    "`main` takes no parameters and returns nothing or a `u8`, and this one %s: the exit status is `fn main() : u8`'s result or `exit(n)`, and the arguments are `arg_count()` and `arg(i)`",
                    &why,
                );
                return Err(tagged_at(named_diag("diag.no-main", &msg), m.line));
            }
        },
        None    :
        {
            if (!is_library)
            {
                held_no_main = Some("diag.no-main");
            }
        },
    }
    // `diag.bad-destructor-signature` (spec/07 §1), in the table's order.
    for (usize i = 0; i < HashMap::len(&it.fns); i += 1)
    {
        ref<String, shared> key = HashMap::key_at(&it.fns, i);
        ref<FnDecl, shared> f = HashMap::value_at(&it.fns, i);
        if (f.name == "drop" && Option::is_some(&f.assoc_type))
        {
            StringView t = Option::unwrap_or(StringView::strip_suffix(key, "::drop"), key);
            bool ok = Vec::len(&f.params) == 1 && match (&f.params[0].ty)
            {
                Type::TRef(rb) : Box::get(rb).mode == Mode::Exclusive && match (&Box::get(rb).inner)
                {
                    Type::TNamed(nb) : Box::get(nb).name == t,
                    _                : false,
                },
                _ : false,
            } && match (&f.ret)
            {
                Type::TVoid : true,
                _           : false,
            };
            if (!ok)
            {
                return Err("diag.bad-destructor-signature");
            }
            // D-0075: a destructor's type must be a resource in every
            // instantiation.
            String tk = String::copy(t);
            // Bug 081: an enum's destructor would never run; it is refused.
            if (HashMap::contains(&it.enums, &tk))
            {
                StringView shown = Option::unwrap_or(StringView::strip_prefix(t, "std::"), t);
                String msg = sprintf(
                    "`%s` is an enum, and an enum has no destructor, so this one would never run: wrap the enum in a `resource struct` (`resource struct Held { %s v; }`) and declare its `drop`",
                    shown,
                    shown,
                );
                return Err(tagged_at(named_diag("diag.destructor-on-plain-type", &with_repair(&msg, "")), f.line));
            }
            Vec<String> params = match (HashMap::get(&it.structs, &tk))
            {
                Some(s) : Vec::clone(&s.type_params),
                None : match (HashMap::get(&it.enums, &tk))
                {
                    Some(e) : Vec::clone(&e.type_params),
                    None    : Vec::new(),
                },
            };
            Vec<Type> plain_args = Vec::new();
            for (usize p = 0; p < Vec::len(&params); p += 1)
            {
                Vec::push(&mut plain_args, Type::TInt(IntTy::I32));
            }
            if (!is_resource_ty(it, &named(t, plain_args)))
            {
                StringView shown = Option::unwrap_or(StringView::strip_prefix(t, "std::"), t);
                String msg = sprintf(
                    "`%s` has a destructor but is not a resource, so it would never run; declare `resource struct %s` (an enum has no destructor: wrap it in a `resource struct`)",
                    shown,
                    shown,
                );
                return Err(tagged_at(named_diag("diag.destructor-on-plain-type", &msg), f.line));
            }
        }
    }
    Vec<WorkItem> start = Vec::new();
    if (has_main)
    {
        Vec::push(&mut start, work("main", Vec::new()));
    }
    else
    {
        for (usize i = 0; i < Vec::len(&entries); i += 1)
        {
            Vec::push(&mut start, work(&entries[i].key, Vec::new()));
        }
    }
    Ck ck = new_ck(start);
    // Every item of the program is checked, called or not; `std`'s as the
    // worklist reaches them (unless `check_all`). The generic bodies,
    // with their type parameters opaque, are pushed last, so checked first.
    bool all = check_all();
    Vec<WorkItem> generic = Vec::new();
    for (usize i = 0; i < Vec::len(&keys); i += 1)
    {
        ref<String, shared> key = &keys[i];
        ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, key), "a function");
        if (!all && is_std_key(key))
        {
            continue;
        }
        if (Vec::len(&f.type_params) == 0)
        {
            Vec::push(&mut ck.worklist, work(key, Vec::new()));
        }
        else
        {
            Vec::push(&mut generic, work(key, opaque_args(f)));
        }
    }
    Vec::reverse(&mut generic);
    Vec::append(&mut ck.worklist, generic);
    // `[Result-Source-Form]` (D-0312): a declaration-level fact, before the
    // bodies, whose probe-only check assumes a well-formed clause.
    check_result_source_forms(it)?;
    check_requires_places(it)?;
    // Bug 283: a signature's missing `from` clause before the bodies, whose
    // errors at its callers it causes.
    check_elision(it, &keys, true)?;
    match (held_no_main)
    {
        Some(d) : Vec::push(&mut held, d),
        None    : {},
    }
    match (ck_run(&mut ck, it, front, facts))
    {
        Ok(_)  :
        {
            if (Vec::len(&held) > 0)
            {
                return Err(String::join(&held, "\u{2}"));
            }
        },
        Err(e) :
        {
            if (Vec::len(&held) > 0)
            {
                // The externs' errors first (at their declarations), then
                // the bodies', then the missing `main`, which has no place.
                Vec<String> all = Vec::new();
                usize n = Vec::len(&held);
                bool last_no_main = held[n - 1] == "diag.no-main";
                for (usize k = 0; k + 1 < n || (k < n && !last_no_main); k += 1)
                {
                    Vec::push(&mut all, String::clone(&held[k]));
                }
                Vec::push(&mut all, e);
                if (last_no_main)
                {
                    Vec::push(&mut all, "diag.no-main");
                }
                return Err(String::join(&all, "\u{2}"));
            }
            return Err(e);
        },
    }
    check_elision(it, &keys, false)?;
    Ck { static_asserts, .. } = ck;
    Ok(static_asserts)
}

// [Call-Multi-Ref-Return-Rejected] (spec/10 rule.temporal.elision), checked
// before the bodies (bug 283).
fn check_elision(ref<Items, shared> it, ref<Vec<String>, shared> keys, bool early) : Result<void, String>
{
    // [Call-Multi-Ref-Return-Rejected] (spec/10 rule.temporal.elision): a
    // function returning a reference has exactly one reference parameter;
    // the first by line (then key) is reported.
    Option<KeyLine> bad = None;
    for (usize i = 0; i < Vec::len(keys); i += 1)
    {
        ref<String, shared> key = &keys[i];
        ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, key), "a function");
        // D-0134: `StringView::of` refers to a `str`'s text, which never
        // ends.
        // D-0312: a `from` clause names the sources; the count does not apply.
        // D-0319: a result that holds references without being one (an
        // `Option<ref<T, shared>>`, a `Vec<StringView>`, a struct with a
        // reference field, a closure) from two or more reference parameters
        // names its sources too.
        usize nref = borrow_params(f);
        bool holder_result = !is_borrow_ty(&f.ret) && nref >= 2 && may_hold_ref(it, &f.ret, 0);
        if (*key == "std::StringView::of" || Vec::len(&f.source) > 0 || (!holder_result && (!is_borrow_ty(&f.ret) || nref == 1)))
        {
            continue;
        }
        // Before the bodies only a choice among several reference
        // parameters (bug 283): a function that takes none is reported after
        // them, where its body's own error (`&x` of a parameter) comes first.
        if (early && nref == 0)
        {
            continue;
        }
        // D-0312: a view a function taking no reference returns, every value
        // it gives a view of static text, borrows nothing.
        if (borrow_params(f) == 0 && plain_named_ty(&f.ret, "std::StringView") && gives_only_static_views(&f.body, &f.params))
        {
            continue;
        }
        bool better = match (&bad)
        {
            Some(b) : f.line < b.line,
            None    : true,
        };
        if (better)
        {
            bad = Some(KeyLine { .key = String::clone(key), .line = f.line });
        }
    }
    match (bad)
    {
        Some(kl) :
        {
            ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &kl.key), "a function");
            Vec<String> refs = Vec::new();
            Vec<String> names = Vec::new();
            for (usize p = 0; p < Vec::len(&f.params); p += 1)
            {
                if (is_borrow_ty(&f.params[p].ty))
                {
                    Vec::push(&mut refs, sprintf("`%s`", &f.params[p].name));
                    Vec::push(&mut names, String::clone(&f.params[p].name));
                }
            }
            StringView shown = Option::unwrap_or(StringView::strip_prefix(&kl.key, "std::"), &kl.key);
            String msg = if (Vec::len(&refs) == 0)
            {
                sprintf(
                    "`%s` returns a reference but takes none, so there is nothing it could refer to; return an owned value",
                    shown,
                )
            }
            else if (!is_borrow_ty(&f.ret))
            {
                sprintf(
                    "`%s` returns a `%s`, which holds references, and takes %v reference parameters (%s), so which ones it holds is not known; name the ones its result may come from with `from` (`from %s`), take the others by value, or return owned values",
                    shown,
                    &type_display(&f.ret),
                    Vec::len(&refs),
                    &String::join(&refs, ", "),
                    &String::join(&names, ", "),
                )
            }
            else
            {
                sprintf(
                    "`%s` returns a reference but takes %v reference parameters (%s), so which one it borrows from is not known; name the ones it may come from with `from` (`from %s`), take the others by value, or return an owned value",
                    shown,
                    Vec::len(&refs),
                    &String::join(&refs, ", "),
                    &String::join(&names, ", "),
                )
            };
            return Err(tagged_at(named_diag("diag.lifetime-elision-ambiguous", &msg), f.line));
        },
        None     : {},
    }
    Ok(())
}

// D-0312 `[Result-Source-Form]` and `[Result-Source-Probe-Only]` (spec/10
// `rule.temporal.elision`): a function declared `: τ from p` returns
// references of `p` alone. Its clause names a parameter of reference type,
// on a result that may hold a reference; and in each instantiation, every
// other parameter whose type may hold a reference is only *probed*: each
// occurrence, through derivations (a field, an element, `*`, a borrow, a
// call whose result may hold a reference), ends as an operator's operand,
// a read of a value holding no reference, or an argument of a named
// function whose result holds no reference (or whose own `from` clause
// names another parameter) and none of whose parameters can receive one.
// Anything else -- a binding, a store, the result, a capture, a `match`
// over it, a call through a `fn` value -- keeps it. No flow is followed:
// a type parameter counts as one that may hold a reference, and a local
// copy of the parameter is kept however it is then used.

struct KeptAt
{
    usize line;
    usize col;
    // Report 183: kept by an assignment to this existing local.
    Option<String> into;
}

// Whether a value of `t` may hold a reference, a type parameter (an opaque
// marker, or one of `tparams` before instantiation) counting as one that
// may.
fn may_hold_ref_or_param(ref<Items, shared> it, ref<Type, shared> t, ref<Vec<String>, shared> tparams) : bool
{
    may_hold_ref(it, t, 0) || has_unresolved_marker(t) || type_mentions(t, tparams)
}

fn may_hold_ref_inst(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    may_hold_ref(it, t, 0) || has_unresolved_marker(t)
}

fn type_mentions(ref<Type, shared> t, ref<Vec<String>, shared> names) : bool
{
    match (t)
    {
        Type::TNamed(nb)  :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (Vec::contains(names, &n.name))
            {
                return true;
            }
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (type_mentions(&n.args[i], names))
                {
                    return true;
                }
            }
            false
        },
        Type::TRef(m)     : type_mentions(&Box::get(m).inner, names),
        Type::TSlice(m)   : type_mentions(&Box::get(m).inner, names),
        Type::TRawptr(x)  : type_mentions(Box::get(x), names),
        Type::TArray(a)   : type_mentions(&Box::get(a).inner, names),
        Type::TSimd(a)    : type_mentions(&Box::get(a).inner, names),
        Type::THandle(x)  : type_mentions(Box::get(x), names),
        Type::TMutex(x)   : type_mentions(Box::get(x), names),
        Type::TGuard(x)   : type_mentions(Box::get(x), names),
        Type::TFn(fb)     :
        {
            ref<FnTy, shared> ft = Box::get(fb);
            for (usize i = 0; i < Vec::len(&ft.params); i += 1)
            {
                if (type_mentions(&ft.params[i], names))
                {
                    return true;
                }
            }
            type_mentions(&ft.ret, names)
        },
        Type::TClosure(_) : true,
        _                 : false,
    }
}

fn any_may_hold(ref<Items, shared> it, ref<Vec<Type>, shared> ts, ref<Vec<String>, shared> tparams) : bool
{
    for (usize i = 0; i < Vec::len(ts); i += 1)
    {
        if (may_hold_ref_or_param(it, &ts[i], tparams))
        {
            return true;
        }
    }
    false
}

// Whether a callee could leave a reference in what an argument of type `t`
// reaches: through an exclusive reference or slice to a value that may hold
// one; a raw pointer, by value or behind an exclusive reference; a `mutex`,
// a guard, a `Channel` or an `AtomicPtr` whose content may, behind any
// reference; or a `fn` value or a closure, which may be called with it.
fn can_receive(ref<Items, shared> it, ref<Type, shared> t, ref<Vec<String>, shared> tparams, bool shared, u32 depth) : bool
{
    HashSet<String> seen = HashSet::new();
    can_receive_go(it, t, tparams, shared, depth, &mut seen)
}

// `seen`: the struct and enum types being opened, with the mode; one met
// again inside itself (a tree's `Vec<Node>`) adds nothing to what is being
// found (report 082).
fn can_receive_go(
    ref<Items, shared> it,
    ref<Type, shared> t,
    ref<Vec<String>, shared> tparams,
    bool shared,
    u32 depth,
    ref<HashSet<String>, exclusive> seen,
) : bool
{
    if (depth > 16)
    {
        return true;
    }
    match (t)
    {
        Type::TRef(m)     : can_receive_moded(it, Box::get(m), tparams, shared, depth, seen),
        Type::TSlice(m)   : can_receive_moded(it, Box::get(m), tparams, shared, depth, seen),
        Type::TRawptr(x)  : !shared && (may_hold_ref_or_param(it, Box::get(x), tparams) || can_receive_go(it, Box::get(x), tparams, false, depth + 1, seen)),
        Type::TMutex(x)   : may_hold_ref_or_param(it, Box::get(x), tparams) || can_receive_go(it, Box::get(x), tparams, false, depth + 1, seen),
        Type::TGuard(x)   : may_hold_ref_or_param(it, Box::get(x), tparams) || can_receive_go(it, Box::get(x), tparams, false, depth + 1, seen),
        Type::THandle(x)  : can_receive_go(it, Box::get(x), tparams, shared, depth + 1, seen),
        Type::TArray(a)   : can_receive_go(it, &Box::get(a).inner, tparams, shared, depth + 1, seen),
        Type::TFn(_)      : true,
        Type::TClosure(_) : true,
        Type::TNamed(nb)  :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (Vec::contains(tparams, &n.name) || (Vec::len(&n.args) == 0 && StringView::starts_with(&n.name, "$")) || n.name == "std::StringView")
            {
                return false;
            }
            if (n.name == "std::Channel" || n.name == "std::AtomicPtr")
            {
                return any_may_hold(it, &n.args, tparams);
            }
            String key = sprintf("%s%s", &type_display(t), if (shared) { " s" } else { " x" });
            if (HashSet::contains(seen, &key))
            {
                return false;
            }
            HashSet::insert(seen, key);
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        if (can_receive_go(it, &apply_subst(&s.fields[i].ty, &subst), tparams, shared, depth + 1, seen))
                        {
                            return true;
                        }
                    }
                    return false;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(pt) :
                            {
                                if (can_receive_go(it, &apply_subst(pt, &subst), tparams, shared, depth + 1, seen))
                                {
                                    return true;
                                }
                            },
                            None     : {},
                        }
                    }
                    return false;
                },
                None    : {},
            }
            // A type the tables do not open (`probe<K>`, a `Vec<T>` by value) can receive what its arguments can, not
            // whatever may hold a reference: a lookup's `probe<K>` receives nothing (D-0316).
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (can_receive_go(it, &n.args[i], tparams, shared, depth + 1, seen))
                {
                    return true;
                }
            }
            false
        },
        _                 : false,
    }
}

// `rule.conc.thread-confined` (bug 031): the type confined to one thread
// that a value of `t` holds or reaches -- an `Rc` or a `Weak`, whose counts
// are not synchronised -- in itself, through a reference, a raw pointer, a
// `mutex`, a handle, an array, or a struct's field or an enum's payload, the
// type's arguments among them. A type parameter's marker holds none: each
// instantiation is checked with its own types.
fn thread_confined(ref<Items, shared> it, ref<Type, shared> t, ref<HashSet<String>, exclusive> seen, u32 depth) : Option<String>
{
    if (depth > 24)
    {
        return None;
    }
    match (t)
    {
        Type::TRef(m)    : thread_confined(it, &Box::get(m).inner, seen, depth + 1),
        Type::TSlice(m)  : thread_confined(it, &Box::get(m).inner, seen, depth + 1),
        Type::TRawptr(x) : thread_confined(it, Box::get(x), seen, depth + 1),
        Type::TMutex(x)  : thread_confined(it, Box::get(x), seen, depth + 1),
        // D-0340 §9: a guard is affine to the thread that locked it.
        Type::TGuard(_)  : Some(type_display(t)),
        Type::THandle(x) : thread_confined(it, Box::get(x), seen, depth + 1),
        Type::TArray(a)  : thread_confined(it, &Box::get(a).inner, seen, depth + 1),
        Type::TNamed(nb) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (n.name == "std::Rc" || n.name == "std::Weak")
            {
                return Some(type_display(t));
            }
            String key = type_display(t);
            if (HashSet::contains(seen, &key))
            {
                return None;
            }
            HashSet::insert(seen, key);
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                match (thread_confined(it, &n.args[i], seen, depth + 1))
                {
                    Some(x) : return Some(x),
                    None    : {},
                }
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        match (thread_confined(it, &apply_subst(&s.fields[i].ty, &subst), seen, depth + 1))
                        {
                            Some(x) : return Some(x),
                            None    : {},
                        }
                    }
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(pt) : match (thread_confined(it, &apply_subst(pt, &subst), seen, depth + 1))
                            {
                                Some(x) : return Some(x),
                                None    : {},
                            },
                            None : {},
                        }
                    }
                },
                None    : {},
            }
            None
        },
        _                : None,
    }
}

// `[Thread-Confined]` refuted: `what` (an argument, a capture, the thread's
// result) of type `t` would take `found` to another thread.
fn thread_confined_err(ref<Items, shared> it, ref<Type, shared> t, StringView what) : Result<void, String>
{
    HashSet<String> seen = HashSet::new();
    match (thread_confined(it, t, &mut seen, 0))
    {
        Some(found) :
        {
            String shown = type_display(t);
            String through = if (shown == found) { String::new() } else { sprintf(" (`%s` holds one)", &shown) };
            if (StringView::starts_with(&found, "guard<"))
            {
                String gmsg = sprintf(
                    "%s would take `%s`%s to another thread, but a guard stays on the thread that locked it; pass `&m` and call `lock(m)` in the thread",
                    what,
                    &found,
                    &through,
                );
                return Err(named_diag("diag.thread-affine-moved", &gmsg));
            }
            String msg = sprintf(
                "%s would take `%s` to another thread%s: its count is not synchronised; share the value across threads as `Arc<T>`, or as `ref<mutex<T>, shared>`",
                what,
                &found,
                &through,
            );
            Err(named_diag("diag.not-thread-safe", &msg))
        },
        None        : Ok(()),
    }
}

fn thread_confined_closure_err(StringView name) : Result<void, String>
{
    String msg = sprintf(
        "the closure `%s` captured an `Rc`, a `Weak` or a guard, which `spawn` would take to another thread: an `Rc`'s count is not synchronised, and a guard stays on the thread that locked it; share the value as `Arc<T>` or `ref<mutex<T>, shared>`, and lock in the thread",
        name,
    );
    Err(named_diag("diag.not-thread-safe", &msg))
}

// Whether closure literal `c` captures a value confined to one thread, or a
// closure binding that did.
fn captures_confined(ref<Body, shared> b, ref<Items, shared> it, ref<ClosureExpr, shared> c) : bool
{
    foreach (cap in &c.captures)
    {
        if (HashSet::contains(&b.closure_confined, cap))
        {
            return true;
        }
        match (lookup_local(b, cap))
        {
            Some(t) :
            {
                HashSet<String> seen = HashSet::new();
                if (Option::is_some(&thread_confined(it, &t, &mut seen, 0)))
                {
                    return true;
                }
            },
            None    : {},
        }
    }
    false
}

fn can_receive_moded(
    ref<Items, shared> it,
    ref<ModedTy, shared> m,
    ref<Vec<String>, shared> tparams,
    bool shared,
    u32 depth,
    ref<HashSet<String>, exclusive> seen,
) : bool
{
    bool excl = match (&m.mode)
    {
        Mode::Exclusive : true,
        Mode::Shared    : false,
    };
    if (excl && !shared)
    {
        return may_hold_ref_or_param(it, &m.inner, tparams) || can_receive_go(it, &m.inner, tparams, false, depth + 1, seen);
    }
    can_receive_go(it, &m.inner, tparams, true, depth + 1, seen)
}

// The intrinsics that read their arguments for a value holding no
// reference; any other intrinsic's result is taken to derive from them.
// `probe_key(k)` copies the key a probe names; a key type holds no
// reference (D-0110), so the copy keeps nothing of `k`.
fn probing_intrinsic(ref<String, shared> n) : bool
{
    *n == "str_len" || *n == "slice_len" || *n == "str_byte" || *n == "sizeof" || *n == "alignof" || *n == "count_ones" || *n == "leading_zeros" || *n == "trailing_zeros" || *n == "key_hash" || *n == "probe_key" || *n == "widen" || *n == "narrow" || *n == "narrow_wrapping" || *n == "checked_narrow" || *n == "to_float" || *n == "to_int" || *n == "min_value" || *n == "max_value" || *n == "text_write" || *n == "parse_check"
}

fn param_position(ref<FnDecl, shared> f, ref<String, shared> name) : Option<usize>
{
    for (usize i = 0; i < Vec::len(&f.params); i += 1)
    {
        if (f.params[i].name == *name)
        {
            return Some(i);
        }
    }
    None
}

// The parameters a call's reference result comes from, in order: the ones
// the `from` clause names (D-0312, D-0318), else the one reference-typed
// parameter (D-0011); empty when there is neither.
fn source_positions(ref<FnDecl, shared> f) : Vec<usize>
{
    Vec<usize> out = Vec::new();
    bool named = Vec::len(&f.source) > 0;
    for (usize i = 0; i < Vec::len(&f.params); i += 1)
    {
        bool source = if (named) { Vec::contains(&f.source, &f.params[i].name) } else { is_borrow_ty(&f.params[i].ty) };
        if (source)
        {
            Vec::push(&mut out, i);
        }
    }
    if (!named && Vec::len(&out) != 1)
    {
        Vec::clear(&mut out);
    }
    out
}

// `[Result-Source-Form]`, for every function with a clause, the first by line.
// D-0317 (cobc's `check_requires_places`): where a `requires` block may not
// stand: `main`, a type's `drop`, a function C calls.
fn check_requires_places(ref<Items, shared> it) : Result<void, String>
{
    Vec<String> keys = sorted_keys_of_fns(&it.fns);
    Option<KeyLine> bad = None;
    String msg = String::new();
    for (usize i = 0; i < Vec::len(&keys); i += 1)
    {
        ref<String, shared> key = &keys[i];
        ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, key), "a function");
        if (Vec::len(&f.requires) == 0)
        {
            continue;
        }
        StringView shown = Option::unwrap_or(StringView::strip_prefix(key, "std::"), key);
        Option<String> problem = if (Option::is_none(&f.assoc_type) && f.name == "main")
        {
            Some("`main` has no `requires` block: no call of it could be blamed")
        }
        else if (Option::is_some(&f.assoc_type) && f.name == "drop")
        {
            Some(sprintf("`%s` has no `requires` block: the language calls a destructor, not a caller", shown))
        }
        else if (f.c_entry)
        {
            Some(sprintf("`%s` has no `requires` block: C calls it (`extern fn` with a body)", shown))
        }
        else
        {
            None
        };
        match (problem)
        {
            Some(m) :
            {
                bool first = match (&bad)
                {
                    Some(kl) : f.line < kl.line || (f.line == kl.line && *key < kl.key),
                    None     : true,
                };
                if (first)
                {
                    bad = Some(KeyLine { .key = String::clone(key), .line = f.line });
                    msg = m;
                }
            },
            None    : {},
        }
    }
    match (bad)
    {
        Some(kl) : Err(tagged_at(named_diag("diag.requires-misplaced", &msg), kl.line)),
        None     : Ok(()),
    }
}

fn check_result_source_forms(ref<Items, shared> it) : Result<void, String>
{
    Vec<String> keys = sorted_keys_of_fns(&it.fns);
    Option<KeyLine> bad = None;
    String msg = String::new();
    for (usize i = 0; i < Vec::len(&keys); i += 1)
    {
        ref<String, shared> key = &keys[i];
        ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, key), "a function");
        if (Vec::len(&f.source) == 0)
        {
            continue;
        }
        StringView shown = Option::unwrap_or(StringView::strip_prefix(key, "std::"), key);
        String clause = String::join(&f.source, ", ");
        Option<String> problem = None;
        for (usize s = 0; s < Vec::len(&f.source) && Option::is_none(&problem); s += 1)
        {
            ref<String, shared> src = &f.source[s];
            bool twice = false;
            for (usize e = 0; e < s; e += 1)
            {
                if (f.source[e] == *src)
                {
                    twice = true;
                }
            }
            if (twice)
            {
                problem = Some(sprintf("`%s`'s `from %s` names `%s` twice; name each parameter the result's references come from once", shown, &clause, src));
                continue;
            }
            match (param_position(f, src))
            {
                None    :
                {
                    problem = Some(sprintf("`%s`'s `from %s` names `%s`, which is no parameter; name the parameters the result's references come from", shown, &clause, src));
                },
                Some(k) :
                {
                    if (!is_borrow_ty(&f.params[k].ty))
                    {
                        problem = Some(sprintf(
                            "`%s`'s `from %s` names `%s`, a parameter of type `%s`, which is no reference the result could come from",
                            shown,
                            &clause,
                            src,
                            &type_display(&f.params[k].ty),
                        ));
                    }
                },
            }
        }
        if (Option::is_none(&problem) && !may_hold_ref_or_param(it, &f.ret, &f.type_params))
        {
            problem = Some(sprintf(
                "`%s` returns `%s`, which holds no reference, so it has no source to name; drop `from %s`",
                shown,
                &type_display(&f.ret),
                &clause,
            ));
        }
        match (problem)
        {
            Some(m) :
            {
                bool better = match (&bad)
                {
                    Some(b) : f.line < b.line || (f.line == b.line && *key < b.key),
                    None    : true,
                };
                if (better)
                {
                    bad = Some(KeyLine { .key = String::clone(key), .line = f.line });
                    msg = m;
                }
            },
            None    : {},
        }
    }
    match (bad)
    {
        Some(b) : Err(tagged_at(named_diag("diag.result-source-invalid", &msg), b.line)),
        None    : Ok(()),
    }
}

// `[Result-Source-Probe-Only]` for one instantiation: the first kept
// occurrence of a parameter the clause does not name.
fn check_result_source_probe_only(ref<Items, shared> it, ref<FnDecl, shared> f, ref<HashMap<String, Type>, shared> subst) : Result<void, String>
{
    if (Vec::len(&f.source) == 0)
    {
        return Ok(());
    }
    for (usize i = 0; i < Vec::len(&f.params); i += 1)
    {
        ref<ParamDecl, shared> q = &f.params[i];
        Type qty = apply_subst(&q.ty, subst);
        if (Vec::contains(&f.source, &q.name) || !may_hold_ref_inst(it, &qty))
        {
            continue;
        }
        match (pw_block(it, &q.name, &qty, &f.body, true, false))
        {
            Some(at) :
            {
                usize n = Vec::len(&f.source);
                String from = sprintf("`%s`", &f.source[n - 1]);
                if (n > 1)
                {
                    Vec<String> head = Vec::new();
                    for (usize s = 0; s + 1 < n; s += 1)
                    {
                        Vec::push(&mut head, sprintf("`%s`", &f.source[s]));
                    }
                    from = sprintf("%s and %s", &String::join(&head, ", "), &from);
                }
                String msg = sprintf(
                    "`%s` keeps `%s` here, but `from %s` says its result comes from %s alone, so `%s` may only be probed: compare it, measure it, search it, or pass it where nothing can keep it; or name `%s` in the clause",
                    &fn_shown(f),
                    &q.name,
                    &String::join(&f.source, ", "),
                    &from,
                    &q.name,
                    &q.name,
                );
                // Report 183: kept by reassigning an existing binding, which
                // the check does not follow as it follows a new one.
                match (&at.into)
                {
                    Some(l) :
                    {
                        msg = sprintf(
                            "`%s` keeps `%s` here by assigning a value made from it to `%s`: a value made from `%s` is followed through a binding declared from it, not through one assigned it later; declare a new binding for it (`StringView rest = &%s[…];`), or name `%s` in the clause",
                            &fn_shown(f),
                            &q.name,
                            l,
                            &q.name,
                            &q.name,
                            &q.name,
                        );
                    },
                    None    : {},
                }
                return Err(sprintf("%s%s", &named_diag("diag.result-source-kept", &msg), &diag_at(at.line, at.col)));
            },
            None     : {},
        }
    }
    Ok(())
}

// `kept`: whether the block's value is kept; `shadow`: whether a local
// named as the parameter hides it here.
// Whether `e` mentions the local `n`.
fn mentions_name(ref<Expr, shared> e, ref<String, shared> n) : bool
{
    HashSet<String> free = HashSet::new();
    HashSet<String> bound = HashSet::new();
    collect_free_vars_expr(e, &mut bound, &mut free);
    HashSet::contains(&free, n)
}

fn pw_block(ref<Items, shared> it, ref<String, shared> q, ref<Type, shared> qty, ref<Block, shared> blk, bool kept, bool shadow) : Option<KeptAt>
{
    pw_block_from(it, q, qty, blk, 0, kept, shadow)
}

// From statement `start` on.
fn pw_block_from(
    ref<Items, shared> it,
    ref<String, shared> q,
    ref<Type, shared> qty,
    ref<Block, shared> blk,
    usize start,
    bool kept,
    bool shadow,
) : Option<KeptAt>
{
    bool sh = shadow;
    for (usize i = start; i < Vec::len(&blk.stmts); i += 1)
    {
        match (&blk.stmts[i])
        {
            Stmt::SLet(lb)         :
            {
                ref<LetStmt, shared> l = Box::get(lb);
                // Report 183: a value made from the parameter (`StringView
                // key = path;`, a `foreach`'s hidden `$d =
                // StringView::as_bytes(path)` and its elements) is kept where
                // that value is: the rest of the block is looked at for it,
                // and the rest of its initializer as not kept.
                // (Only a value that may hold a reference: a written type
                // that holds none, `usize n = StringView::len(path)`, is a
                // probe's result, checked as before.)
                bool refish = match (&l.ty)
                {
                    Some(t) : may_hold_ref_inst(it, t),
                    None    : true,
                };
                // (And only one whose initializer would keep the parameter:
                // one that only probes it, `HashMap::get(&m, key)?`, is
                // checked as before.)
                bool alias = !sh && refish && l.name != *q && match (&l.init)
                {
                    Some(ie) : mentions_name(ie, q) && Option::is_some(&pw_expr(it, q, qty, ie, true, sh)),
                    None     : false,
                };
                if (alias)
                {
                    match (&l.init)
                    {
                        Some(ie) :
                        {
                            bool plain_copy = match (one_seg(strip_parens_tc(ie)))
                            {
                                Some(n) : *n == *q,
                                None    : false,
                            };
                            if (!plain_copy)
                            {
                                match (pw_expr(it, q, qty, ie, false, sh))
                                {
                                    Some(p) : return Some(p),
                                    None    : {},
                                }
                            }
                        },
                        None     : {},
                    }
                    match (pw_block_from(it, &l.name, qty, blk, i + 1, kept, false))
                    {
                        Some(p) : return Some(p),
                        None    : {},
                    }
                    continue;
                }
                match (&l.init)
                {
                    Some(ie) :
                    {
                        match (pw_expr(it, q, qty, ie, true, sh))
                        {
                            Some(p) : return Some(p),
                            None    : {},
                        }
                    },
                    None     : {},
                }
                if (l.name == *q)
                {
                    sh = true;
                }
            },
            Stmt::SDestructure(db) :
            {
                ref<DestructureStmt, shared> d = Box::get(db);
                match (pw_expr(it, q, qty, &d.init, true, sh))
                {
                    Some(p) : return Some(p),
                    None    : {},
                }
                if (Vec::contains(&d.names, q))
                {
                    sh = true;
                }
            },
            Stmt::SExpr(x)         :
            {
                match (pw_expr(it, q, qty, Box::get(x), false, sh))
                {
                    Some(p) : return Some(p),
                    None    : {},
                }
            },
            Stmt::SBlockLike(x)    :
            {
                match (pw_expr(it, q, qty, Box::get(x), false, sh))
                {
                    Some(p) : return Some(p),
                    None    : {},
                }
            },
        }
    }
    match (&blk.tail)
    {
        Some(t) : pw_expr(it, q, qty, Box::get(t), kept, sh),
        None    : None,
    }
}

fn pw_all(ref<Items, shared> it, ref<String, shared> q, ref<Type, shared> qty, ref<Vec<Expr>, shared> es, bool kept, bool shadow) : Option<KeptAt>
{
    for (usize i = 0; i < Vec::len(es); i += 1)
    {
        match (pw_expr(it, q, qty, &es[i], kept, shadow))
        {
            Some(p) : return Some(p),
            None    : {},
        }
    }
    None
}

// A read of a value holding no reference is a probe; any other field,
// element or referent is a derivation.
fn pw_plain(ref<Items, shared> it, ref<String, shared> q, ref<Type, shared> qty, ref<Expr, shared> e, bool shadow) : bool
{
    match (pw_chain_type(it, q, qty, e, shadow))
    {
        Some(t) : !may_hold_ref_inst(it, &t),
        None    : false,
    }
}

// Report 407: whether place `e` is a part of parameter `q` (its fields,
// elements and what it refers to: `b[0]`, `b.text`, `(*b).x`).
fn pw_place_of(ref<String, shared> q, ref<Expr, shared> e) : bool
{
    ref<Expr, shared> x = strip_parens_tc(e);
    bool part = false;
    while (true)
    {
        match (&x.kind)
        {
            ExprKind::EField(fb) :
            {
                x = strip_parens_tc(&Box::get(fb).e);
                part = true;
            },
            ExprKind::EIndex(pb) :
            {
                x = strip_parens_tc(&Box::get(pb).a);
                part = true;
            },
            ExprKind::EDeref(d)  :
            {
                x = strip_parens_tc(Box::get(d));
                part = true;
            },
            _                    : break,
        }
    }
    if (!part)
    {
        return false;
    }
    match (one_seg(x))
    {
        Some(n) : *n == *q,
        None    : false,
    }
}

fn pw_expr(ref<Items, shared> it, ref<String, shared> q, ref<Type, shared> qty, ref<Expr, shared> e, bool kept, bool shadow) : Option<KeptAt>
{
    match (&e.kind)
    {
        ExprKind::EPath(pb)        :
        {
            ref<PathExpr, shared> px = Box::get(pb);
            if (kept && !shadow && Vec::len(&px.segs) == 1 && px.segs[0] == *q)
            {
                return Some(KeptAt { .line = e.line, .col = e.col, .into = None });
            }
            None
        },
        ExprKind::EParen(x)        : pw_expr(it, q, qty, Box::get(x), kept, shadow),
        ExprKind::EPropagate(x)    : pw_expr(it, q, qty, Box::get(x), kept, shadow),
        ExprKind::EField(fb)       :
        {
            bool k = kept && !pw_plain(it, q, qty, e, shadow);
            pw_expr(it, q, qty, &Box::get(fb).e, k, shadow)
        },
        ExprKind::EDeref(x)        :
        {
            bool k = kept && !pw_plain(it, q, qty, e, shadow);
            pw_expr(it, q, qty, Box::get(x), k, shadow)
        },
        ExprKind::EIndex(pb)       :
        {
            ref<PairExpr, shared> px = Box::get(pb);
            bool k = kept && !pw_plain(it, q, qty, e, shadow);
            match (pw_expr(it, q, qty, &px.a, k, shadow))
            {
                Some(p) : return Some(p),
                None    : {},
            }
            pw_expr(it, q, qty, &px.b, false, shadow)
        },
        ExprKind::EBorrow(bb)      :
        {
            // Report 407 (D-0339): a borrow of a part of the parameter
            // (`&b[0]`, `&b.text`) keeps the parameter's referent, even when
            // the part's own value would be plain (a read of `b[0]` is a
            // probe, its borrow is not).
            ref<Expr, shared> inner = &Box::get(bb).e;
            if (kept && !shadow && pw_place_of(q, inner))
            {
                return Some(KeptAt { .line = e.line, .col = e.col, .into = None });
            }
            pw_expr(it, q, qty, inner, kept, shadow)
        },
        ExprKind::ESliceOf(sb)     :
        {
            ref<SliceExpr, shared> sx = Box::get(sb);
            match (pw_expr(it, q, qty, &sx.base, kept, shadow))
            {
                Some(p) : return Some(p),
                None    : {},
            }
            match (pw_expr(it, q, qty, &sx.lo, false, shadow))
            {
                Some(p) : return Some(p),
                None    : {},
            }
            pw_expr(it, q, qty, &sx.hi, false, shadow)
        },
        ExprKind::EUnary(ub)       : pw_expr(it, q, qty, &Box::get(ub).e, false, shadow),
        ExprKind::EBinary(bb)      :
        {
            ref<BinaryExpr, shared> bx = Box::get(bb);
            match (pw_expr(it, q, qty, &bx.a, false, shadow))
            {
                Some(p) : return Some(p),
                None    : {},
            }
            pw_expr(it, q, qty, &bx.b, false, shadow)
        },
        ExprKind::EAssign(pb)      :
        {
            ref<PairExpr, shared> px = Box::get(pb);
            match (pw_expr(it, q, qty, &px.a, false, shadow))
            {
                Some(p) : return Some(p),
                None    : {},
            }
            match (pw_expr(it, q, qty, &px.b, true, shadow))
            {
                Some(p) : match (one_seg(strip_parens_tc(&px.a)))
                {
                    Some(n) : Some(KeptAt { .line = p.line, .col = p.col, .into = Some(String::clone(n)) }),
                    None    : Some(p),
                },
                None : None,
            }
        },
        ExprKind::ECall(cb)        :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            pw_call(it, q, qty, &c.callee, &c.args, kept, shadow)
        },
        ExprKind::EStructLit(sb)   :
        {
            ref<StructLitExpr, shared> sl = Box::get(sb);
            for (usize i = 0; i < Vec::len(&sl.fields); i += 1)
            {
                match (pw_expr(it, q, qty, &sl.fields[i].value, true, shadow))
                {
                    Some(p) : return Some(p),
                    None    : {},
                }
            }
            None
        },
        ExprKind::EArrayLit(items) : pw_all(it, q, qty, items, true, shadow),
        ExprKind::EArrayRepeat(rb) : pw_expr(it, q, qty, &Box::get(rb).value, true, shadow),
        ExprKind::EBlock(b)        : pw_block(it, q, qty, b, kept, shadow),
        ExprKind::EUnsafe(b)       : pw_block(it, q, qty, b, kept, shadow),
        ExprKind::EIf(ib)          :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            match (pw_expr(it, q, qty, &x.cond, false, shadow))
            {
                Some(p) : return Some(p),
                None    : {},
            }
            match (pw_block(it, q, qty, &x.then_, kept, shadow))
            {
                Some(p) : return Some(p),
                None    : {},
            }
            match (&x.else_)
            {
                Some(el) : pw_expr(it, q, qty, el, kept, shadow),
                None     : None,
            }
        },
        ExprKind::EWhile(wb)       :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            match (pw_expr(it, q, qty, &x.cond, false, shadow))
            {
                Some(p) : return Some(p),
                None    : {},
            }
            match (pw_block(it, q, qty, &x.body, false, shadow))
            {
                Some(p) : return Some(p),
                None    : {},
            }
            match (&x.step)
            {
                Some(st) : pw_expr(it, q, qty, st, false, shadow),
                None     : None,
            }
        },
        ExprKind::EMatch(mb)       :
        {
            ref<MatchExpr, shared> m = Box::get(mb);
            // Report 183: a scrutinee that would keep the parameter
            // (`StringView::strip_prefix(path, "x.")`) keeps it only in the
            // arms' binders, which are looked at for it in their arms, as a
            // binding declared from it is (`pw_block_from`). A binder's
            // type is not known here: `void` reads none of its parts as a
            // probe, so each counts as kept where it would be.
            bool binders = false;
            foreach (a in &m.arms)
            {
                match (&a.binder)
                {
                    Some(bn) :
                    {
                        if (*bn != *q)
                        {
                            binders = true;
                        }
                    },
                    None     : {},
                }
            }
            bool alias = !shadow && binders && mentions_name(&m.scrut, q) && Option::is_some(&pw_expr(it, q, qty, &m.scrut, true, shadow));
            if (alias)
            {
                match (pw_expr(it, q, qty, &m.scrut, false, shadow))
                {
                    Some(p) : return Some(p),
                    None    : {},
                }
                Type unknown = Type::TVoid;
                foreach (a in &m.arms)
                {
                    match (&a.binder)
                    {
                        Some(bn) :
                        {
                            if (*bn == *q)
                            {
                                return pw_expr(it, q, qty, &m.scrut, true, shadow);
                            }
                            match (pw_expr(it, bn, &unknown, Box::get(&a.body), kept, false))
                            {
                                Some(p) : return Some(p),
                                None    : {},
                            }
                        },
                        None     : {},
                    }
                }
            }
            else
            {
                match (pw_expr(it, q, qty, &m.scrut, true, shadow))
                {
                    Some(p) : return Some(p),
                    None    : {},
                }
            }
            for (usize i = 0; i < Vec::len(&m.arms); i += 1)
            {
                bool bound_here = match (&m.arms[i].binder)
                {
                    Some(bn) : *bn == *q,
                    None     : false,
                };
                bool sh = shadow || bound_here;
                match (pw_expr(it, q, qty, Box::get(&m.arms[i].body), kept, sh))
                {
                    Some(p) : return Some(p),
                    None    : {},
                }
            }
            None
        },
        ExprKind::EReturn(x)       :
        {
            match (x)
            {
                Some(xb) : pw_expr(it, q, qty, Box::get(xb), true, shadow),
                None     : None,
            }
        },
        ExprKind::EClosure(clb)    :
        {
            ref<ClosureExpr, shared> cl = Box::get(clb);
            // Report 183: a closure that is itself kept keeps what it
            // captures; one given where nothing keeps it (`Vec::position`'s
            // predicate) keeps only what its body does.
            if (!shadow && kept && Vec::contains(&cl.captures, q))
            {
                return Some(KeptAt { .line = e.line, .col = e.col, .into = None });
            }
            bool sh = shadow;
            for (usize i = 0; i < Vec::len(&cl.params); i += 1)
            {
                if (cl.params[i].name == *q)
                {
                    sh = true;
                }
            }
            pw_block(it, q, qty, &cl.body, true, sh)
        },
        _                          : None,
    }
}

fn pw_call(ref<Items, shared> it, ref<String, shared> q, ref<Type, shared> qty, ref<Expr, shared> callee, ref<Vec<Expr>, shared> args, bool kept, bool shadow) : Option<KeptAt>
{
    ref<PathExpr, shared> px = match (&callee.kind)
    {
        ExprKind::EPath(pb) : Box::get(pb),
        // Through a `fn` value or a closure: what it does is not known.
        _                   : return pw_all(it, q, qty, args, true, shadow),
    };
    String name = String::join(&px.segs, "::");
    String key = if (HashMap::contains(&it.fns, &name))
    {
        String::clone(&name)
    }
    else
    {
        sprintf("std::%s", &name)
    };
    match (HashMap::get(&it.fns, &key))
    {
        Some(g) :
        {
            // Type arguments written at the call (`StringView::parse<usize>`)
            // are what the parameters and the result are made of.
            bool written = Vec::len(&px.targs) > 0 && Vec::len(&px.targs) == Vec::len(&g.type_params);
            HashMap<String, Type> sub = if (written) { zip_subst(&g.type_params, &px.targs) } else { HashMap::new() };
            Vec<String> open = if (written) { Vec::new() } else { clone(&g.type_params) };
            Vec<bool> receiving = Vec::new();
            for (usize i = 0; i < Vec::len(&g.params); i += 1)
            {
                Vec::push(&mut receiving, can_receive(it, &apply_subst(&g.params[i].ty, &sub), &open, false, 0));
            }
            bool plain_ret = !may_hold_ref_or_param(it, &apply_subst(&g.ret, &sub), &open);
            for (usize j = 0; j < Vec::len(args); j += 1)
            {
                bool other_source = Vec::len(&g.source) > 0 && j < Vec::len(&g.params) && !Vec::contains(&g.source, &g.params[j].name);
                // Kept when another parameter may receive it: the one that may
                // receive references is given them, not kept itself (CHG-0439).
                bool receives = false;
                for (usize i = 0; i < Vec::len(&receiving); i += 1)
                {
                    if (receiving[i] && i != j)
                    {
                        receives = true;
                    }
                }
                // A `probe<K>` is only compared and hashed: a key type holds
                // no reference, so what a lookup stores is a copy (`entry`),
                // never the probe (report 113).
                bool probe_param = j < Vec::len(&g.params) && is_probe(&g.params[j].ty);
                bool k = !probe_param && (receives || (kept && !plain_ret && !other_source));
                match (pw_expr(it, q, qty, &args[j], k, shadow))
                {
                    Some(p) : return Some(p),
                    None    : {},
                }
            }
            return None;
        },
        None    : {},
    }
    // A variant's payload is part of the value made.
    if (Vec::len(&px.segs) <= 2 && HashMap::contains(&it.enum_of_variant, &px.segs[Vec::len(&px.segs) - 1]))
    {
        return pw_all(it, q, qty, args, true, shadow);
    }
    if (is_intrinsic_name_tc(&name))
    {
        bool probe = probing_intrinsic(&name);
        return pw_all(it, q, qty, args, kept && !probe, shadow);
    }
    pw_all(it, q, qty, args, true, shadow)
}

fn strip_refs(ref<Type, shared> t) : Type
{
    match (t)
    {
        Type::TRef(m) : strip_refs(&Box::get(m).inner),
        _             : clone(t),
    }
}

// The type of a chain of derivations rooted at the parameter, when it can
// be read from the types alone.
fn pw_chain_type(ref<Items, shared> it, ref<String, shared> q, ref<Type, shared> qty, ref<Expr, shared> e, bool shadow) : Option<Type>
{
    match (&e.kind)
    {
        ExprKind::EPath(pb)  :
        {
            ref<PathExpr, shared> px = Box::get(pb);
            if (!shadow && Vec::len(&px.segs) == 1 && px.segs[0] == *q)
            {
                Some(clone(qty))
            }
            else
            {
                None
            }
        },
        ExprKind::EParen(x)  : pw_chain_type(it, q, qty, Box::get(x), shadow),
        ExprKind::EDeref(x)  :
        {
            Option<Type> inner = pw_chain_type(it, q, qty, Box::get(x), shadow);
            match (&inner)
            {
                Some(t) :
                {
                    match (t)
                    {
                        Type::TRef(m) : Some(clone(&Box::get(m).inner)),
                        _             : None,
                    }
                },
                None    : None,
            }
        },
        ExprKind::EIndex(pb) :
        {
            Option<Type> base = pw_chain_type(it, q, qty, &Box::get(pb).a, shadow);
            match (&base)
            {
                Some(t) : indexed_elem(t),
                None    : None,
            }
        },
        ExprKind::EField(fb) :
        {
            ref<FieldExpr, shared> fx = Box::get(fb);
            Option<Type> base = pw_chain_type(it, q, qty, &fx.e, shadow);
            match (&base)
            {
                Some(t0) :
                {
                    Type t = strip_refs(t0);
                    match (&t)
                    {
                        Type::TNamed(nb) :
                        {
                            ref<NamedTy, shared> n = Box::get(nb);
                            match (HashMap::get(&it.structs, &n.name))
                            {
                                Some(s) :
                                {
                                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                                    {
                                        if (s.fields[i].name == fx.name)
                                        {
                                            return Some(apply_subst(&s.fields[i].ty, &subst));
                                        }
                                    }
                                    None
                                },
                                None    : None,
                            }
                        },
                        _                : None,
                    }
                },
                None     : None,
            }
        },
        _                    : None,
    }
}

fn borrow_params(ref<FnDecl, shared> f) : usize
{
    usize n = 0;
    for (usize p = 0; p < Vec::len(&f.params); p += 1)
    {
        if (is_borrow_ty(&f.params[p].ty))
        {
            n += 1;
        }
    }
    n
}

fn ffi_part(ref<Type, shared> t, FfiProblem p) : String
{
    FfiProblem { path, what } = p;
    if (Vec::len(&path) == 0)
    {
        return what;
    }
    sprintf("`%s`, whose field `%s` is %s", &type_display(t), &String::join(&path, "."), &what)
}

fn sort_by_line(ref<Vec<KeyLine>, exclusive> v)
{
    // Insertion sort, stable: the lines first, the table's order between
    // equal lines.
    for (usize i = 1; i < Vec::len(v); i += 1)
    {
        usize j = i;
        while (j > 0 && v[j - 1].line > v[j].line)
        {
            Vec::swap(v, j - 1, j);
            j -= 1;
        }
    }
}

fn last_segment(StringView key) : StringView
{
    match (rfind_sep(key))
    {
        Some(k) : &key[k + 2..$],
        None    : key,
    }
}

/// A generic function's type parameters as the opaque markers its body is
/// checked with (`rule.type.kind`).
export fn opaque_args(ref<FnDecl, shared> f) : Vec<Type>
{
    Vec<Type> out = Vec::new();
    for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
    {
        Vec::push(&mut out, named(&marker_name(&f.type_params[i]), Vec::new()));
    }
    out
}

// ---- helpers needed from here on ----

fn marker_name(StringView n) : String
{
    sprintf("$%s", n)
}

fn is_marker(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(b) : Vec::len(&Box::get(b).args) == 0 && StringView::starts_with(&Box::get(b).name, "$"),
        _               : false,
    }
}

// D-0341 (report 409): the type a variant literal's payload fixes, the rest
// open (`$open`): `Ok(e)` is `Result<τe, $open>`, `Err(e)` `Result<$open, τe>`,
// `Some(e)` `Option<τe>`, `None` `Option<$open>`. The payload is checked on a
// snapshot of the body, which is put back.
fn partial_variant_type(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Type>
{
    Type open = Type::TNamed(Box::new(NamedTy { .name = "$open", .args = Vec::new() }));
    ref<Expr, shared> v = strip_parens_tc(e);
    match (path_segs(v))
    {
        Some(segs) :
        {
            if (Vec::len(segs) >= 1 && segs[Vec::len(segs) - 1] == "None")
            {
                Vec<Type> a = Vec::new();
                Vec::push(&mut a, open);
                return Some(Type::TNamed(Box::new(NamedTy { .name = "std::Option", .args = a })));
            }
            return None;
        },
        None       : {},
    }
    ref<CallExpr, shared> call = match (&v.kind)
    {
        ExprKind::ECall(cb) : Box::get(cb),
        _                   : return None,
    };
    if (Vec::len(&call.args) != 1)
    {
        return None;
    }
    String last = match (path_segs(&call.callee))
    {
        Some(segs) : if (Vec::len(segs) >= 1) { String::clone(&segs[Vec::len(segs) - 1]) } else { return None },
        None       : return None,
    };
    if (!(last == "Ok" || last == "Err" || last == "Some"))
    {
        return None;
    }
    Body snap = body_snapshot(b);
    Result<Option<Type>, String> pt = check_expr(b, it, &call.args[0], &None);
    body_restore(b, snap);
    Type p = match (pt)
    {
        Ok(Some(t)) : t,
        _           : return None,
    };
    if (has_unresolved_marker(&p) || is_never(&p))
    {
        return None;
    }
    Vec<Type> a = Vec::new();
    if (last == "Some")
    {
        Vec::push(&mut a, p);
        return Some(Type::TNamed(Box::new(NamedTy { .name = "std::Option", .args = a })));
    }
    if (last == "Ok")
    {
        Vec::push(&mut a, p);
        Vec::push(&mut a, open);
    }
    else
    {
        Vec::push(&mut a, open);
        Vec::push(&mut a, p);
    }
    Some(Type::TNamed(Box::new(NamedTy { .name = "std::Result", .args = a })))
}

// D-0341 (report 409): `a` and `c` with each one's open slots (unresolved
// markers) filled from the other; `None` where they differ otherwise.
fn merge_open(ref<Type, shared> a, ref<Type, shared> c, u32 depth) : Option<Type>
{
    if (depth > 16)
    {
        return None;
    }
    bool a_open = match (a)
    {
        Type::TNamed(ab) : Vec::len(&Box::get(ab).args) == 0 && StringView::starts_with(&Box::get(ab).name, "$"),
        _                : false,
    };
    bool c_open = match (c)
    {
        Type::TNamed(cb) : Vec::len(&Box::get(cb).args) == 0 && StringView::starts_with(&Box::get(cb).name, "$"),
        _                : false,
    };
    if (a_open)
    {
        return Some(clone(c));
    }
    if (c_open)
    {
        return Some(clone(a));
    }
    match (a)
    {
        Type::TNamed(ab) : match (c)
        {
            Type::TNamed(cb) :
            {
                ref<NamedTy, shared> an = Box::get(ab);
                ref<NamedTy, shared> cn = Box::get(cb);
                if (an.name != cn.name || Vec::len(&an.args) != Vec::len(&cn.args))
                {
                    return None;
                }
                Vec<Type> args = Vec::new();
                for (usize i = 0; i < Vec::len(&an.args); i += 1)
                {
                    Vec::push(&mut args, merge_open(&an.args[i], &cn.args[i], depth + 1)?);
                }
                Some(Type::TNamed(Box::new(NamedTy { .name = String::clone(&an.name), .args = args })))
            },
            _                : None,
        },
        _ : if (type_eq(a, c)) { Some(clone(a)) } else { None },
    }
}

// Report 415: every reference `t` holds is a shared view or a shared
// reference (an `Option` or `Result` of them, a struct or enum of them, no
// container): a copy of it is shared, whatever path it was read through.
fn shared_views_only(ref<Items, shared> it, ref<Type, shared> t, u32 depth) : bool
{
    if (depth > 8)
    {
        return false;
    }
    if (!holds_ref(it, t))
    {
        return true;
    }
    match (t)
    {
        Type::TRef(rb)   : Box::get(rb).mode == Mode::Shared && !holds_ref(it, &Box::get(rb).inner),
        Type::TSlice(sb) : Box::get(sb).mode == Mode::Shared && !holds_ref(it, &Box::get(sb).inner),
        Type::TNamed(nb) :
        {
            if (is_view_type(t))
            {
                return true;
            }
            ref<NamedTy, shared> n = Box::get(nb);
            if (n.name == "std::Option" || n.name == "std::Result")
            {
                foreach (a in &n.args)
                {
                    if (!shared_views_only(it, a, depth + 1))
                    {
                        return false;
                    }
                }
                return true;
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(sd) :
                {
                    if (Vec::len(&n.args) > 0)
                    {
                        return false;
                    }
                    foreach (f in &sd.fields)
                    {
                        if (!shared_views_only(it, &f.ty, depth + 1))
                        {
                            return false;
                        }
                    }
                    true
                },
                None     : false,
            }
        },
        _                : false,
    }
}

fn has_unresolved_marker(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(b)  :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (Vec::len(&n.args) == 0 && StringView::starts_with(&n.name, "$"))
            {
                return true;
            }
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (has_unresolved_marker(&n.args[i]))
                {
                    return true;
                }
            }
            false
        },
        Type::TRef(b)    : has_unresolved_marker(&Box::get(b).inner),
        Type::TSlice(b)  : has_unresolved_marker(&Box::get(b).inner),
        Type::TRawptr(b) : has_unresolved_marker(Box::get(b)),
        Type::TArray(b)  : has_unresolved_marker(&Box::get(b).inner),
        Type::THandle(b) : has_unresolved_marker(Box::get(b)),
        Type::TMutex(b)  : has_unresolved_marker(Box::get(b)),
        Type::TGuard(b)  : has_unresolved_marker(Box::get(b)),
        Type::TFn(b)     :
        {
            ref<FnTy, shared> f = Box::get(b);
            for (usize i = 0; i < Vec::len(&f.params); i += 1)
            {
                if (has_unresolved_marker(&f.params[i]))
                {
                    return true;
                }
            }
            has_unresolved_marker(&f.ret)
        },
        _                : false,
    }
}

fn is_borrow_ty(ref<Type, shared> t) : bool
{
    // D-0053: a `StringView` is a borrow as a slice is (it holds one).
    match (t)
    {
        Type::TRef(_)   : true,
        Type::TSlice(_) : true,
        _               : named_is(t, "std::StringView"),
    }
}

fn static_lane(ref<Type, shared> t) : Option<Type>
{
    match (t)
    {
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (n.name == "std::Atomic" && Vec::len(&n.args) == 1)
            {
                return match (&n.args[0])
                {
                    Type::TInt(i) : if (*i != IntTy::I128 && *i != IntTy::U128) { Some(clone(&n.args[0])) } else { None },
                    _             : None,
                };
            }
            if (n.name == "std::AtomicBool" && Vec::len(&n.args) == 0)
            {
                return Some(Type::TBool);
            }
            None
        },
        _               : None,
    }
}

fn literal_value_go(ref<Expr, shared> e, bool neg) : Option<i128>
{
    match (&e.kind)
    {
        ExprKind::EInt(b)   :
        {
            u128 v = Box::get(b).v;
            u128 top = 1;
            top = top << 127;
            if (neg)
            {
                return if (v <= top) { Some(wrapping_sub(0, reinterpret<i128>(v))) } else { None };
            }
            if (v < top) { Some(reinterpret<i128>(v)) } else { None }
        },
        ExprKind::EParen(x) : literal_value_go(Box::get(x), neg),
        ExprKind::EUnary(b) :
        {
            if (Box::get(b).op == UnOp::Neg)
            {
                return literal_value_go(&Box::get(b).e, !neg);
            }
            None
        },
        _                   : None,
    }
}

fn literal_value(ref<Expr, shared> e) : Option<i128>
{
    literal_value_go(e, false)
}

export struct IntRange
{
    export i128 min;
    export i128 max;
}

// An integer type's least and greatest values (a `u128`'s maximum is
// `i128`'s: the range is kept in `i128`).
export fn int_range(IntTy t) : IntRange
{
    u32 bw = int_ty_bits(t, 64);
    i128 one = 1;
    if (int_ty_signed(t))
    {
        if (bw >= 128)
        {
            return IntRange { .min = min_value<i128>(), .max = max_value<i128>() };
        }
        return IntRange { .min = 0 - (one << (bw - 1)), .max = (one << (bw - 1)) - 1 };
    }
    if (bw >= 127)
    {
        return IntRange { .min = 0, .max = max_value<i128>() };
    }
    IntRange { .min = 0, .max = (one << bw) - 1 }
}

// ---- part 2 ----

export fn apply_subst(ref<Type, shared> ty, ref<HashMap<String, Type>, shared> subst) : Type
{
    match (ty)
    {
        Type::TNamed(b)  :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (Vec::len(&n.args) == 0)
            {
                match (HashMap::get(subst, &n.name))
                {
                    Some(t) : return clone(t),
                    None    : {},
                }
            }
            if (is_probe(ty))
            {
                return subst_probe(&n.args[0], apply_subst(&n.args[0], subst));
            }
            Vec<Type> args = Vec::new();
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                Vec::push(&mut args, apply_subst(&n.args[i], subst));
            }
            named(&n.name, args)
        },
        Type::TRef(b)    : ref_of(apply_subst(&Box::get(b).inner, subst), Box::get(b).mode),
        Type::TSlice(b)  : slice_of(apply_subst(&Box::get(b).inner, subst), Box::get(b).mode),
        Type::TRawptr(b) : rawptr_of(apply_subst(Box::get(b), subst)),
        Type::TArray(b)  : array_of(apply_subst(&Box::get(b).inner, subst), Box::get(b).n),
        Type::TFn(b)     :
        {
            ref<FnTy, shared> f = Box::get(b);
            Vec<Type> ps = Vec::new();
            for (usize i = 0; i < Vec::len(&f.params); i += 1)
            {
                Vec::push(&mut ps, apply_subst(&f.params[i], subst));
            }
            fn_of(ps, apply_subst(&f.ret, subst))
        },
        Type::THandle(b) : Type::THandle(Box::new(apply_subst(Box::get(b), subst))),
        Type::TMutex(b)  : Type::TMutex(Box::new(apply_subst(Box::get(b), subst))),
        Type::TGuard(b)  : Type::TGuard(Box::new(apply_subst(Box::get(b), subst))),
        _                : clone(ty),
    }
}

fn is_std_string(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(b) : Box::get(b).name == "std::String" && Vec::len(&Box::get(b).args) == 0,
        _               : false,
    }
}

fn is_resource_ty(ref<Items, shared> it, ref<Type, shared> ty) : bool
{
    match (ty)
    {
        Type::THandle(_) : true,
        Type::TMutex(_)  : true,
        Type::TGuard(_)  : true,
        Type::TArray(b)  : is_resource_ty(it, &Box::get(b).inner),
        Type::TNamed(b)  :
        {
            ref<NamedTy, shared> n = Box::get(b);
            // The table (`items::ref_infos`), where it is exact.
            match (HashMap::get(&it.res_info, &n.name))
            {
                Some(r) :
                {
                    if (r.exact && Vec::len(&n.args) == r.arity)
                    {
                        if (r.own)
                        {
                            return true;
                        }
                        for (usize k = 0; k < Vec::len(&r.params); k += 1)
                        {
                            if (is_resource_ty(it, &n.args[r.params[k]]))
                            {
                                return true;
                            }
                        }
                        return false;
                    }
                },
                None    : return false,
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    if (s.resource_)
                    {
                        return true;
                    }
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        if (is_resource_ty(it, &apply_subst(&s.fields[i].ty, &subst)))
                        {
                            return true;
                        }
                    }
                    return false;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    if (e.resource_)
                    {
                        return true;
                    }
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) :
                            {
                                if (is_resource_ty(it, &apply_subst(p, &subst)))
                                {
                                    return true;
                                }
                            },
                            None    : {},
                        }
                    }
                    false
                },
                None    : false,
            }
        },
        _                : false,
    }
}

fn is_memory_type(ref<String, shared> name) : bool
{
    foreach (m in [
        "std::String",
        "std::Vec",
        "std::HashMap",
        "std::HashSet",
        "std::Queue",
        "std::Box",
        "std::Json",
        "std::JsonMember",
        "std::Option",
        "std::Result",
    ])
    {
        if (*name == m)
        {
            return true;
        }
    }
    false
}

fn quiet_go(ref<Items, shared> it, ref<Type, shared> ty, ref<Vec<String>, exclusive> seen) : bool
{
    match (ty)
    {
        Type::TInt(_)    : true,
        Type::TF32       : true,
        Type::TF64       : true,
        Type::TBool      : true,
        Type::TStr       : true,
        Type::TVoid      : true,
        Type::TRawptr(_) : true,
        // Report 161 (D-0336): a shared reference or slice (and so a
        // `StringView`) is a plain value whose end runs nothing.
        Type::TRef(b)    : Box::get(b).mode == Mode::Shared,
        Type::TSlice(b)  : Box::get(b).mode == Mode::Shared,
        Type::TArray(b)  : quiet_go(it, &Box::get(b).inner, seen),
        Type::TNamed(b)  :
        {
            ref<NamedTy, shared> n = Box::get(b);
            // Report 092 (D-0336): a `Weak` or `ArcWeak` never keeps its
            // value, so destroying one only frees memory, whatever `T` is
            // (the value itself ended with its last strong handle).
            if (n.name == "std::Weak" || n.name == "std::ArcWeak")
            {
                return true;
            }
            if (is_memory_type(&n.name))
            {
                for (usize i = 0; i < Vec::len(&n.args); i += 1)
                {
                    if (!quiet_go(it, &n.args[i], seen))
                    {
                        return false;
                    }
                }
                if (!(n.name == "std::Option" || n.name == "std::Result" || n.name == "std::Json" || n.name == "std::JsonMember"))
                {
                    return true;
                }
            }
            else if (type_is_owner(it, &n.name))
            {
                return false;
            }
            // A recursive type (`Json`) is quiet if the rest is.
            String key = type_display(ty);
            if (Vec::contains(seen, &key))
            {
                return true;
            }
            Vec::push(seen, key);
            bool ok = match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    bool all = true;
                    for (usize i = 0; i < Vec::len(&s.fields) && all; i += 1)
                    {
                        all = quiet_go(it, &apply_subst(&s.fields[i].ty, &subst), seen);
                    }
                    all
                },
                None : match (HashMap::get(&it.enums, &n.name))
                {
                    Some(e) :
                    {
                        HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                        bool all = true;
                        for (usize i = 0; i < Vec::len(&e.variants) && all; i += 1)
                        {
                            match (&e.variants[i].payload)
                            {
                                Some(p) : all = quiet_go(it, &apply_subst(p, &subst), seen),
                                None    : {},
                            }
                        }
                        all
                    },
                    None    : false,
                },
            };
            Vec::pop(seen);
            ok
        },
        _                : false,
    }
}

// D-0194: whether destroying any value of `ty` only frees memory.
export fn quiet_ty(ref<Items, shared> it, ref<Type, shared> ty) : bool
{
    Vec<String> seen = Vec::new();
    quiet_go(it, ty, &mut seen)
}

// D-0049: a struct or enum that owns something by itself, whatever its
// fields hold: declared `resource`, or with a destructor.
export fn type_is_owner(ref<Items, shared> it, ref<String, shared> name) : bool
{
    match (HashMap::get(&it.structs, name))
    {
        Some(s) :
        {
            if (s.resource_)
            {
                return true;
            }
        },
        None    : {},
    }
    match (HashMap::get(&it.enums, name))
    {
        Some(e) :
        {
            if (e.resource_)
            {
                return true;
            }
        },
        None    : {},
    }
    HashMap::contains(&it.fns, &sprintf("%s::drop", name))
}

// D-0049: whether every value of `ty` owns a resource.
export fn always_owns(ref<Items, shared> it, ref<Type, shared> ty) : bool
{
    match (ty)
    {
        Type::THandle(_) : true,
        Type::TGuard(_)  : true,
        Type::TMutex(_)  : true,
        Type::TArray(b)  : Box::get(b).n > 0 && always_owns(it, &Box::get(b).inner),
        Type::TNamed(b)  :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (!is_resource_ty(it, ty))
            {
                return false;
            }
            if (type_is_owner(it, &n.name))
            {
                return true;
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        if (always_owns(it, &apply_subst(&s.fields[i].ty, &subst)))
                        {
                            return true;
                        }
                    }
                    return false;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    if (Vec::len(&e.variants) == 0)
                    {
                        return false;
                    }
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        bool owns = match (&e.variants[i].payload)
                        {
                            Some(p) : always_owns(it, &apply_subst(p, &subst)),
                            None    : false,
                        };
                        if (!owns)
                        {
                            return false;
                        }
                    }
                    true
                },
                None    : false,
            }
        },
        _                : false,
    }
}

enum OperandKind
{
    Place,
    Temporary,
    NonPlace,
}

fn is_reclaim_call(ref<Expr, shared> callee) : bool
{
    match (&callee.kind)
    {
        ExprKind::EPath(p) : Vec::len(&Box::get(p).segs) == 1 && Box::get(p).segs[0] == "reclaim",
        _                  : false,
    }
}

const str TEXT_ORDER_HELP = "`<`, `<=`, `>`, `>=` order two `StringView`s (or two `str`s, two `String`s), not a view and a `str`; make both views";

const str MOVE_OUT_HELP = "a resource cannot be moved out of part of a struct: move the whole struct, take it apart (`Name { f1, f2 } = x;`), or exchange the part with `replace(&mut x.f, v)`";

// A binding's name as the program wrote it (a local constant's or a
// shadowing binding's hidden name ends in `$…`).
fn shown_name(StringView x) : StringView
{
    match (StringView::find(x, "$"))
    {
        Some(k) : if (k > 0) { &x[0..k] } else { x },
        None    : x,
    }
}

// The holder of a borrow, as a message names it: `foreach`'s hidden
// bindings are the loop.
fn is_loop_holder(StringView h) : bool
{
    StringView::starts_with(h, "$c") || StringView::starts_with(h, "$d") || StringView::starts_with(h, "$e")
}

fn holder_text(StringView h) : String
{
    if (is_loop_holder(h))
    {
        return "the `foreach` loop";
    }
    sprintf("`%s`", shown_name(h))
}

// A value that is a fresh temporary: a call's result or an aggregate
// literal (D-0073), an operator's result or a literal (D-0084), `f()?`.
// D-0308: `e` is a text literal, in parentheses or not.
fn is_text_literal(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EParen(x) : is_text_literal(Box::get(x)),
        ExprKind::EStr(_)   : true,
        _                   : false,
    }
}

export fn is_temp_value(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EParen(x)       : is_temp_value(Box::get(x)),
        ExprKind::ECall(c)        : !is_reclaim_call(&Box::get(c).callee),
        ExprKind::EStructLit(_)   : true,
        ExprKind::EArrayLit(_)    : true,
        ExprKind::EArrayRepeat(_) : true,
        ExprKind::EBinary(_)      : true,
        ExprKind::EUnary(_)       : true,
        ExprKind::EInt(_)         : true,
        ExprKind::EFloat(_)       : true,
        ExprKind::EBool(_)        : true,
        ExprKind::EPropagate(_)   : true,
        _                         : false,
    }
}

fn root_local_name(ref<Expr, shared> e) : Option<String>
{
    match (&e.kind)
    {
        ExprKind::EPath(p)  :
        {
            ref<PathExpr, shared> x = Box::get(p);
            if (Vec::len(&x.segs) == 1)
            {
                return Some(String::clone(&x.segs[0]));
            }
            None
        },
        ExprKind::EParen(x) : root_local_name(Box::get(x)),
        _                   : None,
    }
}

// ---- part 1b ----

// The checker's state for one function body (`Body`).
// What is recorded of an expression is keyed by its id.
// A way out of a closure whose result type is taken from its body.
enum ClosureExit
{
    Return(Option<Type>),
    Propagate(Type),
}

struct BlockLocalFacts
{
    String name;
    Option<Vec<DerivFact>> facts;
}

struct ClosureExitAt
{
    ClosureExit exit;
    usize line;
}

// Inside a closure body with no result given beforehand (`closure_ret` is
// `Some(None)`).
fn closure_result_open(ref<Body, shared> b) : bool
{
    match (&b.closure_ret)
    {
        Some(r) : Option::is_none(r),
        None    : false,
    }
}

// The result of a closure whose type is taken from its body: the body's own
// type, or, where the body ends in a `return` (`Never`), the first `return`'s
// value. Every `return` must give that type and every `?` must be of its
// kind (`[Propagate]`, `[Propagate-Option]`, spec/18).
fn closure_exits_agree(Option<Type> bt, ref<Vec<ClosureExitAt>, shared> exits) : Result<Option<Type>, String>
{
    Option<Type> result = None;
    bool from_body = match (&bt)
    {
        Some(t) : !is_never(t),
        None    : false,
    };
    if (from_body)
    {
        result = clone(&bt);
    }
    else
    {
        for (usize i = 0; i < Vec::len(exits) && Option::is_none(&result); i += 1)
        {
            match (&exits[i].exit)
            {
                ClosureExit::Return(o) : match (o)
                {
                    Some(t) :
                    {
                        if (!is_never(t))
                        {
                            result = Some(clone(t));
                        }
                    },
                    None    : result = Some(Type::TVoid),
                },
                _ : {},
            }
        }
    }
    if (Option::is_none(&result))
    {
        return Ok(bt);
    }
    Type want = Option::unwrap(result);
    if (has_unresolved_marker(&want))
    {
        return Ok(bt);
    }
    bool want_void = type_eq(&want, &Type::TVoid);
    for (usize i = 0; i < Vec::len(exits); i += 1)
    {
        usize line = exits[i].line;
        match (&exits[i].exit)
        {
            ClosureExit::Return(o) : match (o)
            {
                Some(t) :
                {
                    if (!is_never(t) && !has_unresolved_marker(t) && !ty_compat(t, &want))
                    {
                        String msg = if (want_void)
                        {
                            sprintf("this `return` gives `%s`, but the closure's body gives no result", &type_display(t))
                        }
                        else
                        {
                            sprintf(
                                "this `return` gives `%s`, but the closure's body gives `%s`",
                                &type_display(t),
                                &type_display(&want),
                            )
                        };
                        return Err(tagged_at(mismatch(msg), line));
                    }
                },
                None    :
                {
                    if (!want_void && !is_never(&want))
                    {
                        return Err(tagged_at(
                            mismatch(sprintf(
                                "a bare `return` gives no value, but the closure's body gives `%s`",
                                &type_display(&want),
                            )),
                            line,
                        ));
                    }
                },
            },
            ClosureExit::Propagate(t) :
            {
                bool is_option = named_is(t, "std::Option");
                bool is_result = named_is(t, "std::Result");
                if (is_option || is_result)
                {
                    bool ok = if (is_option)
                    {
                        named_is(&want, "std::Option")
                    }
                    else if (!named_is(&want, "std::Result"))
                    {
                        false
                    }
                    else
                    {
                        Vec<Type> args = named_args(t);
                        Vec<Type> wargs = named_args(&want);
                        if (Vec::len(&args) > 1 && Vec::len(&wargs) > 1 && !has_unresolved_marker(&args[1])
                            && !has_unresolved_marker(&wargs[1]))
                        {
                            ty_compat(&args[1], &wargs[1])
                        }
                        else
                        {
                            true
                        }
                    };
                    if (!ok)
                    {
                        str kind = if (is_option) { "an `Option`" } else { "a `Result`" };
                        String gives = if (want_void) { sprintf("no result") } else { sprintf("`%s`", &type_display(&want)) };
                        String msg = sprintf(
                            "`?` on %s returns from the closure, so the closure must return %s; its body gives %s",
                            kind,
                            kind,
                            &gives,
                        );
                        return Err(tagged_at(named_diag("diag.propagate-outside-fallible-context", &msg), line));
                    }
                }
            },
        }
    }
    Ok(bt)
}

struct Body
{
    // D-0073: an argument of a call whose result is not a reference, so
    // `&` of a temporary may be taken there.
    bool arg_temp_ok;
    bool cur_temp_ok;
    // D-0312: `[Coerce-Text]` is not applied to the expression checked next
    // (a comparison's operand), taken by `check_expr` on entry.
    bool no_coerce;
    // D-0291: the argument being checked goes to a reference or slice
    // parameter, whose reach the call-site rule follows (`arg_ref_param`;
    // `cur_arg_ref_param` for that one expression, as `cur_temp_ok`).
    bool arg_ref_param;
    bool cur_arg_ref_param;
    // The first argument of a call checked as a borrowed temporary
    // (`&f(…)`), by node id:
    // `&String::copy("…")` where a `ref<String, shared>` is declared is no
    // literal where a `String` is (`diag.text-copy-literal`).
    usize borrowed_call_arg;
    // The module lexically containing the function being checked.
    String module_;
    HashMap<String, Type> gamma;
    // What each write to `gamma` replaced, in order, so a block's bindings
    // are undone when it ends (`gamma_undo`) instead of `gamma` being
    // copied before it.
    Vec<GammaUndo> gamma_log;
    Flow flow;
    // One entry per open block: the names it declared, each with the facts
    // of the same-named binding it shadowed.
    Vec<Vec<ScopeEntry>> scopes;
    usize next_block;
    Vec<usize> block_stack;
    // Report 313: the block each loop being checked is in, innermost last.
    Vec<usize> loop_marks;
    HashMap<usize, usize> block_parent;
    HashMap<String, usize> decl_block;
    HashMap<String, Option<Referent>> ref_origin;
    HashSet<String> params;
    HashMap<usize, Option<Referent>> borrow_referents;
    bool infer_poisoned;
    bool privileged;
    // D-0303: no use of a retired field or variant counts in this body.
    bool retired_exempt;
    HashMap<String, bool> closure_moves;
    // D-0289: the `spawn` calls (their callee's site, `site_key`) whose
    // handle a binding of the frame takes; whether a `join`/`drop` call is
    // checked.
    HashSet<String> bound_spawns;
    // D-0291: spawns a `let`'s value is or wraps (`Some(spawn(…))`, a
    // `match`'s arms): the facts each was lent, found where the spawn is
    // checked; `None` when one names a binding of a scope the `let` does
    // not see. `spawn_let_depth`: the scope depth at each open `let`.
    HashMap<String, Option<Vec<DerivFact>>> tail_spawns;
    Vec<usize> spawn_let_depth;
    bool joining;
    // D-0289: a handle moved where its facts follow it (a `let` of a
    // handle taken out of a `Vec` of them, a `foreach`'s drain), and the
    // calls whose handle result is so bound (`Vec::pop(&mut hs)`).
    bool handing;
    HashSet<String> taken_handles;
    bool handle_borrow_ok;
    // `r = pass(r)`: what `r` held before this assignment cleared it.
    Option<PrevFacts> prev_facts;
    // D-0290: the locals of this frame that hold references in data (a
    // struct with a reference field, a `Vec<StringView>`): each holds the
    // union of what was stored into it, and what is read out of it holds
    // that. `holding`: a holder moved where its facts follow it.
    HashSet<String> holders;
    bool holding;
    // `holder_type` and `data_type` of each type asked about, by
    // `type_code`.
    // D-0282: the per-body state of the frame-reference rules and their
    // report.
    Rep rep;
    // The binders of the matches by reference whose arms are being checked
    // (`spec/14` §6: such a binder's fact holds "in the arm"). They are not
    // `let` bindings, so `[Ref-Binding-Last-Use]` does not end them: one
    // not mentioned again still borrows the scrutinee's place to the arm's
    // end, as the run's record has it (CHG-0462).
    HashSet<String> arm_binders;
    // Report 056: the locals a condition guarding the code being checked
    // names (`if (d != 0) { 10 / d }`), by how many guards name them: their
    // known values are not folded there, where the guard may exclude them.
    HashMap<String, usize> guard_names;
    // Report 181: the error type of the `Result` a `?` directly on a call
    // passes on, for that call's deferred literal (`Option::ok_or(o,
    // "msg")?` in a function whose error is a `String`); taken by the call.
    Option<Type> propagate_err;
    // Report 052: a `match` arm's binder, for the plan of the arm's block
    // (`check_block_stmts` takes it): it ends after its last use there, as a
    // `let` reference of that block does (D-0111).
    Vec<String> plan_extra;
    // The arm binders of each block being checked (`plan_extra` as taken).
    Vec<Vec<String>> extra_stack;
    // Report 292: whether `plan_extra` (and each `extra_stack` entry) are
    // bindings of an enclosing block whose last mention is in this nested
    // branch block, which end after it there (`Facts.nested_ends`).
    bool plan_nested;
    Vec<bool> extra_nested;
    // By an `if`'s condition's id: the waiting bindings its then and else
    // blocks end after their last mention there (`nest_into_branches`).
    HashMap<usize, NestEnds> nest_branches;
    // D-0135 (reports 136 and the escape found with it): the bindings that
    // hold a view of a `match` scrutinee's temporary, by the last position of
    // that `match` (the temporary's end); `cur_match_end` while a binder of
    // such a `match` takes its facts.
    HashMap<String, Pos> temp_views;
    Option<Pos> cur_match_end;
    // Report 114: the statement being checked is an `if` (its condition's
    // id), and the bindings of the block that end after it (D-0111).
    Option<usize> cond_end_id;
    Vec<String> cond_end_names;
    // Those ended after a condition, which their statement's end skips.
    HashSet<String> cond_ended;
    // Report 268: an `else if` chain's condition (its id) after which the
    // bindings listed end, they being mentioned in no branch after it.
    HashMap<usize, Vec<String>> chain_ends;
    HashMap<usize, Vec<String>> then_start_ends;
    // The point checks this body records and whether it has one, moved
    // into `Items` when the body is done (`tier_flush`).
    Vec<PointAt> point_checks_made;
    bool point_check_fn;
    HashSet<String> closure_self_writes;
    HashSet<String> closure_copied;
    // D-0282: reference bindings that are copies of another (`auto r2 =
    // r1;`): a copy of a reference carries the same path, so the two never
    // conflict with each other.
    HashMap<String, String> ref_copies;
    // D-0281 step 4c: the hidden reference of `[Compound-Assign]` (`{ auto
    // t = &mut p; *t = *t op e; }`) while `e` is checked: it is live
    // through `e`, though its uses have the position of `p`.
    Vec<String> compound_held;
    HashSet<String> closure_owning;
    // Bug 031: a closure binding whose literal captured a value confined to
    // one thread (`thread_confined`), which `spawn` refuses.
    HashSet<String> closure_confined;
    HashMap<String, usize> closure_arity;
    // Report 109: the captures of each closure binding whose literal had no
    // `move` (it borrows them), so storing the binding where it outlives one
    // is refused as storing the literal is.
    HashMap<String, Vec<String>> closure_borrows;
    // Report 311: the locals whose value never changes once declared
    // (`stable_bound_names`), which name a range bound in a path.
    HashSet<String> stable_bounds;
    HashMap<String, Option<Type>> move_captures;
    HashSet<String> capture_names;
    // Bug 014: the function whose body this is, and the index of each of its
    // parameters by name (empty inside a closure literal), for the
    // part-store summary (`Facts::part_stores`).
    String fn_name;
    HashMap<String, usize> param_idx;
    Vec<LoopCtx> loops;
    // Bug 019: each loop's last fixed points (up to `LOOPS_SEEN` of them,
    // the oldest given up first), by its condition's id (`check_while`).
    HashMap<usize, Vec<LoopSeen>> loops_seen;
    bool report;
    bool place_pos;
    bool read_exempt;
    Option<String> reinit_target;
    Type ret;
    Option<Option<Type>> closure_ret;
    // Inside a closure whose result nothing gives beforehand: each `return`'s
    // value type and each `?`'s operand type, with its line, checked against
    // the body's type once it is known (CHG-0439).
    Vec<ClosureExitAt> closure_exits;
    // While `inherited_facts` reads a block expression's tail once the block
    // has been checked: each binding of the block, with what its initializer
    // holds (CHG-0439).
    Vec<BlockLocalFacts> block_local_facts;
    // D-0309: every binding the function's own frame declares (not a closure
    // body's), with its type.
    Vec<FrameBinding> frame_types;
    HashMap<String, Bound> marker_bounds;
    // Report 346: the type parameters bound `eq` (or `ordered`), by name.
    HashSet<String> eq_params;
    HashMap<String, Type> subst;
    Vec<WorkItem> new_instantiations;
    Vec<StaticAssert> static_asserts;
    u32 unsafe_depth;
    u32 while_depth;
    usize current_line;
    usize current_col;
    // Bug 062: where each binding was last moved (its line), for
    // `diag.stale-binding` to say.
    HashMap<String, usize> moved_at;
    // The facts, lent to the body while it is checked.
    Facts facts;
    // The ids given to expressions the checker builds itself (a
    // `foreach` expansion, a `$fmt` call), apart from the program's.
    usize fresh_id;
    // D-0323: the second walk of a body that failed, which goes on after a
    // failed statement of the body's own block (`recover`); the errors after
    // the first, in the order found (`recovered`); the locals whose state a
    // failed statement left unknown (`poisoned`); and whether a statement or
    // the tail was left unchecked (`skipped`).
    bool recover;
    Vec<String> recovered;
    HashSet<String> poisoned;
    bool skipped;
    // A function the front end derived (`T::clone`, D-0116): it makes and
    // matches a variant with fields by its hidden payload (D-0324).
    bool derived;
    // D-0323 (nested blocks): while a statement in statement position that
    // holds blocks is checked on the second walk, its blocks recover too; not
    // a block in value position, nor a closure's body.
    bool recover_nested;
}

// What `r` held before an assignment cleared it (`Body.prev_facts`).
struct PrevFacts
{
    String name;
    HashMap<String, DerivFact> facts;
}

fn number_fresh(ref<Body, exclusive> b, ref<Expr, exclusive> e)
{
    number_expr(e, &mut b.fresh_id);
}

// A referent: the block it lives in and its root binding.
struct Referent
{
    usize block;
    String root;
}

// The state a body is checked in (`Body`), its facts lent; D-0323
// builds it a second time for a body that failed.
fn new_body(
    ref<Items, shared> it,
    ref<WorkItem, shared> w,
    ref<FnDecl, shared> f,
    ref<HashMap<String, Type>, shared> subst,
    ref<Type, shared> ret,
    Facts facts,
) : Body
{
    HashMap<String, Type> gamma = HashMap::new();
    for (usize i = 0; i < Vec::len(&f.params); i += 1)
    {
        HashMap::insert(&mut gamma, String::clone(&f.params[i].name), apply_subst(&f.params[i].ty, subst));
    }
    HashSet<String> params = HashSet::new();
    HashMap<String, usize> param_idx = HashMap::new();
    for (usize i = 0; i < Vec::len(&f.params); i += 1)
    {
        HashSet::insert(&mut params, String::clone(&f.params[i].name));
        HashMap::insert(&mut param_idx, String::clone(&f.params[i].name), i);
    }
    HashMap<String, Bound> marker_bounds = HashMap::new();
    HashSet<String> eq_params = HashSet::new();
    for (usize i = 0; i < Vec::len(&f.type_params) && i < Vec::len(&f.type_bounds); i += 1)
    {
        match (f.type_bounds[i])
        {
            Some(bd) :
            {
                if (bound_implies(bd, Bound::BEq))
                {
                    HashSet::insert(&mut eq_params, String::clone(&f.type_params[i]));
                }
            },
            None     : {},
        }
    }
    for (usize i = 0; i < Vec::len(&f.type_params) && i < Vec::len(&f.type_bounds) && i < Vec::len(&w.targs); i += 1)
    {
        match (f.type_bounds[i])
        {
            Some(bd) : match (&w.targs[i])
            {
                Type::TNamed(nb) :
                {
                    ref<NamedTy, shared> n = Box::get(nb);
                    if (Vec::len(&n.args) == 0 && (n.name == marker_name(&f.type_params[i])))
                    {
                        HashMap::insert(&mut marker_bounds, String::clone(&n.name), bd);
                    }
                },
                _                : {},
            },
            None : {},
        }
    }
    Vec<usize> block_stack = Vec::new();
    Vec::push(&mut block_stack, 0);
    Vec<Vec<ScopeEntry>> scopes = Vec::new();
    Vec::push(&mut scopes, Vec::new());
    Body {
            .arg_temp_ok = false,
            .cur_temp_ok = false,
            .no_coerce = false,
            .arg_ref_param = false,
            .cur_arg_ref_param = false,
            .borrowed_call_arg = 0,
            .module_ = declaring_module(&w.name, Option::is_some(&f.assoc_type)),
            .gamma = gamma,
            .gamma_log = Vec::new(),
            .flow = new_flow(),
            .scopes = scopes,
            .next_block = 1,
            .block_stack = block_stack,
            .loop_marks = Vec::new(),
            .block_parent = HashMap::new(),
            .decl_block = HashMap::new(),
            .ref_origin = HashMap::new(),
            .params = params,
            .borrow_referents = HashMap::new(),
            .infer_poisoned = false,
            .privileged = false,
            .retired_exempt = HashSet::contains(&it.retired_exempt, &w.name) || f.derived,
            .closure_moves = HashMap::new(),
            .bound_spawns = HashSet::new(),
            .tail_spawns = HashMap::new(),
            .spawn_let_depth = Vec::new(),
            .joining = false,
            .handing = false,
            .taken_handles = HashSet::new(),
            .handle_borrow_ok = false,
            .prev_facts = None,
            .holders = HashSet::new(),
            .holding = false,
            .rep = rep_new(String::new()),
            .arm_binders = HashSet::new(),
            .guard_names = HashMap::new(),
            .propagate_err = None,
            .plan_extra = Vec::new(),
            .extra_stack = Vec::new(),
            .plan_nested = false,
            .extra_nested = Vec::new(),
            .nest_branches = HashMap::new(),
            .temp_views = HashMap::new(),
            .cur_match_end = None,
            .cond_end_id = None,
            .cond_end_names = Vec::new(),
            .cond_ended = HashSet::new(),
            .chain_ends = HashMap::new(),
            .then_start_ends = HashMap::new(),
            .point_checks_made = Vec::new(),
            .point_check_fn = false,
            .closure_self_writes = HashSet::new(),
            .closure_copied = HashSet::new(),
            .ref_copies = HashMap::new(),
            .compound_held = Vec::new(),
            .closure_owning = HashSet::new(),
            .closure_confined = HashSet::new(),
            .closure_arity = HashMap::new(),
            .closure_borrows = HashMap::new(),
            .stable_bounds = stable_bound_names(f),
            .move_captures = HashMap::new(),
            .capture_names = HashSet::new(),
            .fn_name = String::clone(&w.name),
            .param_idx = param_idx,
            .loops = Vec::new(),
            .loops_seen = HashMap::new(),
            .report = true,
            .place_pos = false,
            .read_exempt = false,
            .reinit_target = None,
            .ret = clone(ret),
            .closure_ret = None,
            .closure_exits = Vec::new(),
            .block_local_facts = Vec::new(),
            .frame_types = Vec::new(),
            .marker_bounds = marker_bounds,
            .eq_params = eq_params,
            .subst = clone(subst),
            .new_instantiations = Vec::new(),
            .static_asserts = Vec::new(),
            .unsafe_depth = 0,
            .while_depth = 0,
            .current_line = 0,
            .moved_at = HashMap::new(),
            .current_col = 0,
            .facts = facts,
            .fresh_id = fresh_base(),
            .recover = false,
            .recovered = Vec::new(),
            .poisoned = HashSet::new(),
            .skipped = false,
            .derived = f.derived,
            .recover_nested = false,
    }
}

fn ck_run(
    ref<Ck, exclusive> ck,
    ref<Items, exclusive> it,
    ref<Front, shared> front,
    ref<Facts, exclusive> facts,
) : Result<void, String>
{
    // D-0282: the access summaries, once per program (every function is
    // declared by now).
    if (Option::is_none(&it.tier_summaries))
    {
        Summaries sums = tier::compute(&*it);
        it.tier_summaries = Some(sums);
    }
    // Every function is checked, and of the errors found the one earliest
    // in the source is reported (one without a location, last). D-0321: the
    // others are reported after it, one for each function (its earliest), in
    // source order (`error_fns` names each error's function).
    Vec<String> errors = Vec::new();
    Vec<String> error_fns = Vec::new();
    while (true)
    {
        WorkItem w = match (Vec::pop(&mut ck.worklist))
        {
            Some(w) : w,
            None    : break,
        };
        String key = work_code(&w.name, &w.targs);
        if (HashSet::contains(&ck.checked, &key) || HashMap::contains(&facts.checked_fns, &key))
        {
            continue;
        }
        if (is_pending(it, &w.name))
        {
            load_body(it, front, &w.name)?;
        }
        ref<Items, shared> its = &*it;
        ref<FnDecl, shared> f = match (HashMap::get(&its.fns, &w.name))
        {
            Some(f) : f,
            None    : continue,
        };
        if (Vec::len(&f.type_params) != Vec::len(&w.targs))
        {
            continue;
        }
        // A generic's body is checked with its type parameters opaque
        // before any instantiation of it.
        if (Vec::len(&w.targs) > 0)
        {
            Vec<Type> opaque = opaque_args(f);
            String okey = work_code(&w.name, &opaque);
            if (!types_eq_list(&opaque, &w.targs) && !HashSet::contains(&ck.checked, &okey) && !HashMap::contains(&facts.checked_fns, &okey))
            {
                Vec::push(&mut ck.worklist, work(&w.name, clone(&w.targs)));
                Vec::push(&mut ck.worklist, work(&w.name, opaque));
                continue;
            }
        }
        // `[Generic-Instantiation-Unbounded]` (spec/15 §5): a type argument
        // nested too deep, or too many instantiations, is a family that does
        // not end; it is rejected, never left partly unchecked.
        bool concrete = Vec::len(&w.targs) > 0;
        for (usize i = 0; i < Vec::len(&w.targs); i += 1)
        {
            if (has_unresolved_marker(&w.targs[i]))
            {
                concrete = false;
            }
        }
        if (concrete)
        {
            ck.instances += 1;
            Option<usize> deep = None;
            Option<usize> big = None;
            for (usize i = 0; i < Vec::len(&w.targs) && Option::is_none(&deep) && Option::is_none(&big); i += 1)
            {
                if (type_depth(&w.targs[i]) > INSTANCE_DEPTH)
                {
                    deep = Some(i);
                }
                else if (type_size_over(&w.targs[i], INSTANCE_SIZE))
                {
                    big = Some(i);
                }
            }
            if (Option::is_some(&big))
            {
                StringView shown = Option::unwrap_or(StringView::strip_prefix(&w.name, "std::"), &w.name);
                String why = sprintf(
                    "`%s` is instantiated at a type argument of more than %v type constructors (`%s…`): it calls itself, or a function that calls it, at a larger type each time, so its instantiations never end; pass the larger value as a type the function already has (a `Vec`, a `Box` of one fixed type) or split the function",
                    shown,
                    INSTANCE_SIZE,
                    &type_display_cut(&w.targs[Option::unwrap(big)], 60),
                );
                return Err(tagged_at(named_diag("diag.instantiation-unbounded", &why), f.line));
            }
            if (Option::is_some(&deep) || ck.instances > MAX_INSTANCES)
            {
                StringView shown = Option::unwrap_or(StringView::strip_prefix(&w.name, "std::"), &w.name);
                String why = match (deep)
                {
                    Some(i) :
                    {
                        String t = type_display(&w.targs[i]);
                        Vec<StringView> cs = StringView::chars(&t);
                        String cut = String::new();
                        for (usize k = 0; k < Vec::len(&cs) && k < 60; k += 1)
                        {
                            String::append(&mut cut, cs[k]);
                        }
                        sprintf(
                            "`%s` is instantiated at a type argument nested more than %v deep (`%s…`): it calls itself, or a function that calls it, at a larger type each time, so its instantiations never end; pass the larger value as a type the function already has (a `Vec`, a `Box` of one fixed type) or split the function",
                            shown,
                            INSTANCE_DEPTH,
                            &cut,
                        )
                    },
                    None : sprintf(
                        "the program needs more than %v instantiations of its generic functions (`%s` among them), so they do not end",
                        MAX_INSTANCES,
                        shown,
                    ),
                };
                return Err(tagged_at(named_diag("diag.instantiation-unbounded", &why), f.line));
            }
        }
        HashSet::insert(&mut ck.checked, String::clone(&key));
        HashMap::insert(&mut facts.checked_fns, key, true);
        HashMap<String, Type> subst = zip_subst(&f.type_params, &w.targs);
        Type ret = apply_subst(&f.ret, &subst);
        usize f_line = f.line;
        // `[Result-Source-Probe-Only]` (D-0312): with a `from` clause, every
        // parameter it does not name that may hold a reference is only
        // probed here.
        if (Vec::len(&f.source) > 0)
        {
            match (check_result_source_probe_only(its, f, &subst))
            {
                Err(d) :
                {
                    Vec::push(&mut errors, d);
                    Vec::push(&mut error_fns, String::clone(&w.name));
                    continue;
                },
                Ok(_)  : {},
            }
        }
        Body body = new_body(its, &w, f, &subst, &ret, replace(facts, new_facts()));
        // D-0116: a derived `T::clone` whose `T` is not `clone` is never
        // reached, so its body is not checked.
        if (f.derived && Option::is_some(&clone_problem(&mut body, its, &ret)))
        {
            *facts = replace(&mut body.facts, new_facts());
            continue;
        }
        // Entry state (spec/14 §6): parameters `valid = T`, `init = T`.
        for (usize i = 0; i < Vec::len(&f.params); i += 1)
        {
            declare(&mut body, &f.params[i].name, true);
        }
        String body_key_ = body_key(&w.name, &w.targs);
        body.rep = rep_begin(String::clone(&body_key_), &f.body);
        usize assumes_at = Vec::len(&body.facts.part_assumes);
        Result<Option<Type>, String> res = check_fn_body(&mut body, its, &f.body, &ret);
        // Bug 014: its pairs are in the part-store summary now.
        HashSet::insert(&mut body.facts.part_summarized, String::clone(&w.name));
        // CHG-0445: a last expression written with `;`.
        usize nstmts = Vec::len(&f.body.stmts);
        bool semi_tail = Option::is_none(&f.body.tail) && nstmts > 0 && match (&f.body.stmts[nstmts - 1])
        {
            Stmt::SExpr(_) : true,
            _              : false,
        };
        match (&res)
        {
            Err(d) : body.rep.error = Some(String::clone(d)),
            Ok(_)  : {},
        }
        // D-0323: the body again, going on after each failed statement of its
        // own block. Its errors stand only when its first is the one this walk
        // found (else the first alone, as D-0321 gave it); each is keyed by its
        // place, so two instantiations give one.
        Vec<String> again_found = Vec::new();
        bool again_skipped = false;
        match (&res)
        {
            Err(d) :
            {
                Body again = new_body(its, &w, f, &subst, &ret, replace(&mut body.facts, new_facts()));
                again.recover = true;
                for (usize i = 0; i < Vec::len(&f.params); i += 1)
                {
                    declare(&mut again, &f.params[i].name, true);
                }
                again.rep = rep_begin(String::clone(&body_key_), &f.body);
                Result<Option<Type>, String> escaped = check_fn_body(&mut again, its, &f.body, &ret);
                body.facts = replace(&mut again.facts, new_facts());
                Vec<String> found = replace(&mut again.recovered, Vec::new());
                match (escaped)
                {
                    Err(e) :
                    {
                        if (!Vec::contains(&found, &e))
                        {
                            Vec::push(&mut found, e);
                        }
                    },
                    Ok(_)  : {},
                }
                if (Vec::len(&found) > 0 && found[0] == *d)
                {
                    again_found = found;
                    again_skipped = again.skipped;
                }
                else
                {
                    Vec::push(&mut again_found, String::clone(d));
                }
            },
            Ok(_)  : {},
        }
        // D-0309 (`[Call-Self-Tail]`): the body's self tail calls, kept below
        // if the body leaves nothing to the run.
        Vec<usize> tail_calls = Vec::new();
        bool point_checked = body.point_check_fn;
        if (Vec::len(&w.targs) == 0)
        {
            Vec<FrameBinding> frame = Vec::new();
            foreach (p in &f.params)
            {
                Vec::push(&mut frame, FrameBinding { .name = String::clone(&p.name), .ty = clone(&p.ty) });
            }
            Vec::append(&mut frame, replace(&mut body.frame_types, Vec::new()));
            bool kept = false;
            foreach (fb in &frame)
            {
                if (is_resource_ty(its, &fb.ty) || contains_fn(its, &fb.ty))
                {
                    kept = true;
                }
            }
            tail_calls = self_tail_calls(&w.name, f, &frame, kept);
        }
        // Bugs 244, 248, 251: a body-result mismatch's hints and place, from
        // the body's last expression (read here, before `it` is written).
        String result_hints = String::new();
        Option<LineCol> result_place = None;
        match (&res)
        {
            Ok(rt) : match (rt)
            {
                Some(t) :
                {
                    if (!ty_compat(t, &ret))
                    {
                        bool gives_void = match (t)
                        {
                            Type::TVoid : true,
                            _           : false,
                        };
                        result_hints = body_result_hints(&w.name, &ret, t, gives_void, semi_tail, &f.body);
                        result_place = body_last_place(&f.body);
                    }
                },
                None    : {},
            },
            Err(_) : {},
        }
        bool left = tier_flush(&mut body, it, &body_key_);
        *facts = replace(&mut body.facts, new_facts());
        Option<Type> bt = match (res)
        {
            Ok(t)  : t,
            Err(_) :
            {
                foreach (e in again_found)
                {
                    DiagAt at = split_location_col(&e);
                    Vec::push(&mut error_fns, error_place_key(&w.name, &at));
                    Vec::push(&mut errors, in_instance(e, &w));
                }
                if (again_skipped)
                {
                    Vec::push(&mut errors, UNCHECKED_NOTE);
                    Vec::push(&mut error_fns, sprintf("%s\u{1}unchecked", &w.name));
                }
                continue;
            },
        };
        match (&bt)
        {
            Some(t) :
            {
                if (is_never(&ret) && !is_never(t))
                {
                    // D-0340 §13: every path of a `: never` body ends in a
                    // `never` call or a loop without `break`.
                    String msg = sprintf(
                        "`%s` is declared `: never`, but a path through its body reaches the end; end every path with a `never` call (`exit(1)`, another `: never` function) or a loop without `break`",
                        &w.name,
                    );
                    String at = match (result_place)
                    {
                        Some(lc) : diag_at(lc.line, lc.col),
                        None     : diag_at(f_line, 1),
                    };
                    Vec::push(&mut errors, sprintf("%s%s", &named_diag("diag.never-returns", &msg), &at));
                    Vec::push(&mut error_fns, String::clone(&w.name));
                    continue;
                }
                if (!ty_compat(t, &ret))
                {
                    ShownPair sp = shown_apart(&ret, t);
                    String msg = sprintf(
                        "`%s` returns `%s`, but its body gives `%s`%s",
                        &w.name,
                        &sp.a,
                        &sp.b,
                        &result_hints,
                    );
                    // Bug 251: at the body's last expression.
                    String at = match (result_place)
                    {
                        Some(lc) : diag_at(lc.line, lc.col),
                        None     : diag_at(body.current_line, body.current_col),
                    };
                    Vec::push(&mut errors, sprintf("%s%s", &mismatch(msg), &at));
                    Vec::push(&mut error_fns, String::clone(&w.name));
                    continue;
                }
            },
            None    : {},
        }
        // D-0309 (`[Call-Self-Tail]`): a decided body's self tail calls
        // (condition 6: nothing left to the run, no point check), found above.
        if (!left && !point_checked)
        {
            foreach (id in &tail_calls)
            {
                HashSet::insert(&mut facts.self_tails, *id);
            }
            // Bug 014: kept only while its part-store assumptions stand.
            if (Vec::len(&facts.part_assumes) > assumes_at && Vec::len(&tail_calls) > 0)
            {
                ref<Vec<usize>, exclusive> ids = HashMap::entry(&mut facts.part_tails, &body_key_, Vec::new());
                Vec::append(ids, clone(&tail_calls));
            }
        }
        Body { new_instantiations, static_asserts, .. } = body;
        Vec::append(&mut ck.worklist, new_instantiations);
        Vec::reverse(&mut static_asserts);
        while (true)
        {
            StaticAssert a = match (Vec::pop(&mut static_asserts))
            {
                Some(a) : a,
                None    : break,
            };
            if (HashSet::insert(&mut ck.static_assert_keys, String::clone(&a.key_code)))
            {
                Vec::push(&mut ck.static_asserts, a);
            }
        }
    }
    if (Vec::len(&errors) == 0)
    {
        // Bug 014: every body reached is checked; the calls that judged an
        // argument given exclusively by its own type are settled.
        part_resolve(it, facts);
        return Ok(());
    }
    Err(earliest_first(&errors, &error_fns))
}

// A block's last expression: its tail, or its last statement's expression.
fn block_last(ref<Block, shared> bl) : Option<ref<Expr, shared>>
{
    match (&bl.tail)
    {
        Some(te) : Some(Box::get(te)),
        None     :
        {
            usize n = Vec::len(&bl.stmts);
            if (n == 0)
            {
                return None;
            }
            match (&bl.stmts[n - 1])
            {
                Stmt::SExpr(x)      : Some(Box::get(x)),
                Stmt::SBlockLike(x) : Some(Box::get(x)),
                _                   : None,
            }
        },
    }
}

struct LineCol
{
    usize line;
    usize col;
}

fn body_last_place(ref<Block, shared> bl) : Option<LineCol>
{
    match (block_last(bl))
    {
        Some(e) : Some(LineCol { .line = e.line, .col = e.col }),
        None    : None,
    }
}

// The hints of a body-result mismatch: the conversion, then why.
fn body_result_hints(
    ref<String, shared> name,
    ref<Type, shared> ret,
    ref<Type, shared> got,
    bool gives_void,
    bool semi,
    ref<Block, shared> bl,
) : String
{
    Option<ref<Expr, shared>> last = block_last(bl);
    String conv = conversion_hint(ret, got, last);
    String why = body_result_hint(name, ret, gives_void, semi, last);
    sprintf("%s%s", &conv, &why)
}

// Whether `e` is an `if` whose chain of `else if`s ends with no `else`.
fn if_without_else(ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EIf(ib) : match (&Box::get(ib).else_)
        {
            Some(x) : if_without_else(x),
            None    : true,
        },
        _ : false,
    }
}

// Bugs 244 and 251: why a body gives the wrong result, from its last
// expression `last` (`semi` when it ends with `;`).
fn body_result_hint(
    ref<String, shared> name,
    ref<Type, shared> ret,
    bool gives_void,
    bool semi,
    Option<ref<Expr, shared>> last,
) : String
{
    if (gives_void)
    {
        match (last)
        {
            Some(le) :
            {
                if (if_without_else(le))
                {
                    return "; this `if` has no `else`, so it gives no value when no branch runs: end the chain with `else { … }`, or end the body with a value after it";
                }
            },
            None     : {},
        }
        Vec<Type> args = named_args(ret);
        if (named_is(ret, "std::Result") && Vec::len(&args) == 2 && type_eq(&args[0], &Type::TVoid))
        {
            return "; a `Result<void, E>` function ends with its success value: end the body with `Ok(())`";
        }
        if (*name == "main" && is_numeric_ty(ret))
        {
            return "; `main`'s `u8` is the exit status: end the body with `0` for success";
        }
        // Bug 244: the `;` is the fault only when what it ends is a value;
        // a call's or an assignment's is the function's own.
        bool value_like = match (last)
        {
            Some(le) : match (&strip_parens_tc(le).kind)
            {
                ExprKind::ECall(_)   : false,
                ExprKind::EAssign(_) : false,
                ExprKind::EWhile(_)  : false,
                ExprKind::EReturn(_) : false,
                _                    : true,
            },
            None : false,
        };
        if (semi && value_like)
        {
            return "; a block's value is its last expression, written without `;` (or `return x;`)";
        }
        return "";
    }
    match (last)
    {
        Some(le) : match (&strip_parens_tc(le).kind)
        {
            ExprKind::EMatch(_) : sprintf(
                "; a `match` gives the value of the arm that runs: each arm that does not `return` must give a `%s`",
                &type_display(ret),
            ),
            ExprKind::EIf(_) : sprintf(
                "; an `if` gives the value of the branch that runs: each branch must give a `%s`",
                &type_display(ret),
            ),
            _ : String::new(),
        },
        None : String::new(),
    }
}

// D-0323: kept among a program's other static errors when a statement that
// depends on a failed one was not checked; `render_static` shows it as one
// line after the count, not as an error.
export const str UNCHECKED_NOTE = "\u{3}unchecked";

fn types_all_eq(ref<Vec<Type>, shared> a, ref<Vec<Type>, shared> b) : bool
{
    if (Vec::len(a) != Vec::len(b))
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(a); i += 1)
    {
        if (!type_eq(&a[i], &b[i]))
        {
            return false;
        }
    }
    true
}

// Bug 348: the first field of `root` that `bl` reads (`root.f`, `(*root).f`).
fn field_read_in_block(StringView root, ref<Block, shared> bl) : Option<String>
{
    foreach (st in &bl.stmts)
    {
        Option<String> r = match (st)
        {
            Stmt::SLet(l) : match (&Box::get(l).init)
            {
                Some(e) : field_read_in(root, e),
                None    : None,
            },
            Stmt::SDestructure(d) : field_read_in(root, &Box::get(d).init),
            Stmt::SExpr(e)        : field_read_in(root, Box::get(e)),
            Stmt::SBlockLike(e)   : field_read_in(root, Box::get(e)),
        };
        if (Option::is_some(&r))
        {
            return r;
        }
    }
    match (&bl.tail)
    {
        Some(t) : field_read_in(root, Box::get(t)),
        None    : None,
    }
}

fn field_read_in(StringView root, ref<Expr, shared> e) : Option<String>
{
    match (&e.kind)
    {
        ExprKind::EField(fb)  :
        {
            ref<FieldExpr, shared> f = Box::get(fb);
            ref<Expr, shared> base = match (&strip_parens_tc(&f.e).kind)
            {
                ExprKind::EDeref(x) : strip_parens_tc(Box::get(x)),
                _                   : strip_parens_tc(&f.e),
            };
            if (simple_name(base) == Some(String::copy(root)))
            {
                return Some(String::clone(&f.name));
            }
            field_read_in(root, &f.e)
        },
        ExprKind::EBinary(bb) :
        {
            Option<String> l = field_read_in(root, &Box::get(bb).a);
            if (Option::is_some(&l)) { l } else { field_read_in(root, &Box::get(bb).b) }
        },
        ExprKind::EUnary(ub)  : field_read_in(root, &Box::get(ub).e),
        ExprKind::EParen(x)   : field_read_in(root, Box::get(x)),
        ExprKind::EDeref(x)   : field_read_in(root, Box::get(x)),
        ExprKind::EBorrow(bb) : field_read_in(root, &Box::get(bb).e),
        ExprKind::ECall(cb)   :
        {
            foreach (a in &Box::get(cb).args)
            {
                Option<String> r = field_read_in(root, a);
                if (Option::is_some(&r))
                {
                    return r;
                }
            }
            None
        },
        ExprKind::EBlock(bl)  : field_read_in_block(root, bl),
        ExprKind::EIf(ib)     :
        {
            Option<String> r = field_read_in(root, &Box::get(ib).cond);
            if (Option::is_some(&r))
            {
                return r;
            }
            field_read_in_block(root, &Box::get(ib).then_)
        },
        ExprKind::EReturn(o) : match (o)
        {
            Some(x) : field_read_in(root, Box::get(x)),
            None    : None,
        },
        _                     : None,
    }
}

// Bug 253: in a generic body's instantiation, the type parameter that
// stands for `t`, which the generic code names.
fn subst_param_of(ref<Body, shared> b, ref<Type, shared> t) : Option<String>
{
    for (usize i = 0; i < HashMap::len(&b.subst); i += 1)
    {
        if (type_eq(HashMap::value_at(&b.subst, i), t))
        {
            return Some(String::clone(HashMap::key_at(&b.subst, i)));
        }
    }
    None
}

// Bug 119: `*r` moved out of what `r` only refers to: a copy is what
// can be taken.
fn moved_out_msg(ref<String, shared> n, bool generic) : String
{
    StringView x = shown_name(n);
    // Bug 253: generic code copies with `clone`, given the bound.
    if (generic)
    {
        return with_repair(
            &sprintf(
                "`*%s` would move the value out of what `%s` only refers to, which keeps it: take a copy, `clone(%s)` (the type parameter's bound `clone` gives it), or move the value itself where it is owned",
                x,
                x,
                x,
            ),
            "",
        );
    }
    with_repair(
        &sprintf(
            "`*%s` would move the value out of what `%s` only refers to, which keeps it: take a copy, `clone(%s)` (`String::clone(%s)` for text), or move the value itself where it is owned",
            x,
            x,
            x,
            x,
        ),
        "",
    )
}

// Report 318: `*g` moved out of the mutex a guard `g` holds.
fn moved_out_of_guard_msg(ref<String, shared> n) : String
{
    StringView x = shown_name(n);
    with_repair(
        &sprintf(
            "`*%s` would move the value out of the mutex `%s` guards, which keeps it: exchange it for another value, `replace(&mut *%s, v)` (`replace(&mut *%s, Vec::new())` for a `Vec`), or take a copy, `clone(&*%s)`",
            x,
            x,
            x,
            x,
            x,
        ),
        "",
    )
}

// Bug 189: whether every value `e` can give is an unsuffixed integer
// literal or an operator on such values (`(if (c) { 0 } else { 1 }) + 2`):
// its `i32` is then the literals' default, not a variable's type.
fn literal_valued(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EInt(ib)    : Option::is_none(&Box::get(ib).sfx),
        ExprKind::EParen(pb)  : literal_valued(Box::get(pb)),
        ExprKind::EUnary(ub)  : literal_valued(&Box::get(ub).e),
        ExprKind::EBinary(bb) : literal_valued(&Box::get(bb).a) && literal_valued(&Box::get(bb).b),
        ExprKind::EBlock(bl)  : block_literal_valued(bl),
        ExprKind::EIf(ib)     :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            block_literal_valued(&x.then_) && match (&x.else_)
            {
                Some(el) : literal_valued(el),
                None     : false,
            }
        },
        ExprKind::EMatch(mb)  :
        {
            bool all = Vec::len(&Box::get(mb).arms) > 0;
            foreach (a in &Box::get(mb).arms)
            {
                all = all && literal_valued(Box::get(&a.body));
            }
            all
        },
        _                     : false,
    }
}

fn block_literal_valued(ref<Block, shared> bl) : bool
{
    match (&bl.tail)
    {
        Some(t) : Vec::len(&bl.stmts) == 0 && literal_valued(Box::get(t)),
        None    : false,
    }
}

// Bug 090: an error found in one instantiation of a generic function says
// which one, and where the call that made it is: `\u{4}N\u{4}` stands for
// line N's place, which the driver writes as `file:line`.
fn in_instance(String e, ref<WorkItem, shared> w) : String
{
    if (Vec::len(&w.targs) == 0 || w.at_line == 0 || StringView::starts_with(&w.name, "std::") || !StringView::starts_with(&e, "diag."))
    {
        return e;
    }
    // Before the location the error ends with (`@N`, `@N:C`).
    usize cut = StringView::len(&e);
    usize k = cut;
    while (k > 0)
    {
        k -= 1;
        u8 c = StringView::as_bytes(&e)[k];
        if (c == b'@')
        {
            cut = k;
            break;
        }
        if (!((c >= b'0' && c <= b'9') || c == b':'))
        {
            break;
        }
    }
    Vec<String> shown = Vec::new();
    foreach (t in &w.targs)
    {
        Vec::push(&mut shown, type_display(t));
    }
    String note = sprintf(
        " (in `%s<%s>`, the instantiation the call at \u{4}%v\u{4} makes)",
        shown_name(&w.name),
        &String::join(&shown, ", "),
        w.at_line,
    );
    // A message with its own repair (`\u{3}…\u{3}`) keeps it after the note.
    usize at = match (StringView::find(&e[0..cut], "\u{3}"))
    {
        Some(r) : r,
        None    : cut,
    };
    if (!StringView::contains(&e[0..cut], "\u{1}"))
    {
        return e;
    }
    sprintf("%s%s%s", &e[0..at], &note, &e[at..$])
}

// D-0323: the key of a body's error in `earliest_first`: its function and its
// place, so each statement gives one error however many instantiations reach
// it.
fn error_place_key(ref<String, shared> name, ref<DiagAt, shared> at) : String
{
    match (at.line)
    {
        Some(l) : sprintf("%s\u{1}Some(%v):%v", name, l, at.col),
        None    : sprintf("%s\u{1}None:%v", name, at.col),
    }
}

// An error's place in the report: its line (none last), column and the
// order it was found in.
struct ErrorAt
{
    usize line;
    usize col;
    usize index;
}

fn error_before(ref<ErrorAt, shared> a, ref<ErrorAt, shared> b) : bool
{
    a.line < b.line || (a.line == b.line && (a.col < b.col || (a.col == b.col && a.index < b.index)))
}

// D-0321: of the errors (`fns[i]` names the function of `errors[i]`), the
// earliest in the source (least line, column, order found), then the
// earliest of each other function, in the same order, each after `\u{2}`.
// A function's later errors are dropped (they may follow from its first).
fn earliest_first(ref<Vec<String>, shared> errors, ref<Vec<String>, shared> fns) : String
{
    Vec<ErrorAt> order = Vec::new();
    for (usize i = 0; i < Vec::len(errors); i += 1)
    {
        DiagAt at = split_location_col(&errors[i]);
        Vec::push(&mut order, ErrorAt { .line = Option::unwrap_or(at.line, max_value<usize>()), .col = at.col, .index = i });
    }
    Vec::sort_by(&mut order, error_before);
    HashSet<String> seen = HashSet::new();
    HashSet<String> texts = HashSet::new();
    Vec<String> out = Vec::new();
    foreach (e in &order)
    {
        if (HashSet::contains(&seen, &fns[e.index]) || HashSet::contains(&texts, &errors[e.index]))
        {
            continue;
        }
        HashSet::insert(&mut seen, String::clone(&fns[e.index]));
        HashSet::insert(&mut texts, String::clone(&errors[e.index]));
        Vec::push(&mut out, String::clone(&errors[e.index]));
    }
    modres::join_more(&out)
}

// The first id of the expressions the checker builds: far above any the
// program's numbering gives.
fn fresh_base() : usize
{
    usize one = 1;
    one << 48
}

fn types_eq_list(ref<Vec<Type>, shared> a, ref<Vec<Type>, shared> b) : bool
{
    if (Vec::len(a) != Vec::len(b))
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(a); i += 1)
    {
        if (!type_eq(&a[i], &b[i]))
        {
            return false;
        }
    }
    true
}

// A diagnostic's location: `@42`, or `@42:7` when the column is known.
fn diag_at(usize line, usize col) : String
{
    if (col == 0)
    {
        return sprintf("@%v", line);
    }
    sprintf("@%v:%v", line, col)
}

struct DiagAt
{
    Option<usize> line;
    usize col;
}

// The line and column after the last `@` (`@42` or `@42:7`), when they
// are numbers.
fn split_location_col(ref<String, shared> raw) : DiagAt
{
    StringView s = raw;
    slice<u8, shared> bytes = StringView::as_bytes(s);
    usize k = StringView::len(s);
    while (k > 0)
    {
        k -= 1;
        if (bytes[k] == b'@')
        {
            StringView n = &s[k + 1..$];
            match (StringView::find(n, ":"))
            {
                Some(m) :
                {
                    match (StringView::parse<usize>(&n[0..m]))
                    {
                        Ok(l) : match (StringView::parse<usize>(&n[m + 1..$]))
                        {
                            Ok(c)  : return DiagAt { .line = Some(l), .col = c },
                            Err(_) : return DiagAt { .line = None, .col = 0 },
                        },
                        Err(_) : return DiagAt { .line = None, .col = 0 },
                    }
                },
                None : match (StringView::parse<usize>(n))
                {
                    Ok(l)  : return DiagAt { .line = Some(l), .col = 0 },
                    Err(_) : return DiagAt { .line = None, .col = 0 },
                },
            }
        }
    }
    DiagAt { .line = None, .col = 0 }
}

fn is_numeric_ty(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TInt(_) : true,
        Type::TF32    : true,
        Type::TF64    : true,
        _             : false,
    }
}

// The variant of a type, as `std::mem::discriminant` compares them.
fn type_tag(ref<Type, shared> t) : u8
{
    match (t)
    {
        Type::TInt(_)     : 0,
        Type::TF32        : 1,
        Type::TF64        : 2,
        Type::TBool       : 3,
        Type::TStr        : 4,
        Type::TVoid       : 5,
        Type::TNever      : 6,
        Type::TRef(_)     : 7,
        Type::TSlice(_)   : 8,
        Type::TRawptr(_)  : 9,
        Type::TArray(_)   : 10,
        Type::TSimd(_)    : 11,
        Type::TFn(_)      : 12,
        Type::THandle(_)  : 13,
        Type::TMutex(_)   : 14,
        Type::TGuard(_)   : 15,
        Type::TNamed(_)   : 16,
        Type::TClosure(_) : 17,
    }
}

// The one type inside a wrapper type (`ref`, `slice`, `array`, `rawptr`,
// `handle`, `mutex`, `guard`).
fn inner_of(ref<Type, shared> t) : Option<Type>
{
    match (t)
    {
        Type::TRef(b)    : Some(clone(&Box::get(b).inner)),
        Type::TSlice(b)  : Some(clone(&Box::get(b).inner)),
        Type::TArray(b)  : Some(clone(&Box::get(b).inner)),
        Type::TRawptr(b) : Some(clone(Box::get(b))),
        Type::THandle(b) : Some(clone(Box::get(b))),
        Type::TMutex(b)  : Some(clone(Box::get(b))),
        Type::TGuard(b)  : Some(clone(Box::get(b))),
        _                : None,
    }
}

// Whether `actual` cannot be `decl` whatever the type parameters in
// `params` become: different constructors, or different named types.
fn shape_conflict(ref<Type, shared> decl, ref<Type, shared> actual, ref<HashSet<String>, shared> params) : bool
{
    match (decl)
    {
        Type::TNamed(b) :
        {
            if (Vec::len(&Box::get(b).args) == 0 && HashSet::contains(params, &Box::get(b).name))
            {
                return false;
            }
        },
        _               : {},
    }
    if (has_unresolved_marker(actual))
    {
        return false;
    }
    if (is_numeric_ty(decl) && is_numeric_ty(actual))
    {
        return false;
    }
    match (decl)
    {
        Type::TNamed(b1) : match (actual)
        {
            Type::TNamed(b2) :
            {
                ref<NamedTy, shared> n1 = Box::get(b1);
                ref<NamedTy, shared> n2 = Box::get(b2);
                if (n1.name != n2.name || Vec::len(&n1.args) != Vec::len(&n2.args))
                {
                    return true;
                }
                for (usize i = 0; i < Vec::len(&n1.args); i += 1)
                {
                    if (shape_conflict(&n1.args[i], &n2.args[i], params))
                    {
                        return true;
                    }
                }
                return false;
            },
            _                : {},
        },
        Type::TFn(f1) : match (actual)
        {
            Type::TFn(f2) :
            {
                ref<FnTy, shared> a = Box::get(f1);
                ref<FnTy, shared> c = Box::get(f2);
                if (Vec::len(&a.params) != Vec::len(&c.params))
                {
                    return true;
                }
                for (usize i = 0; i < Vec::len(&a.params); i += 1)
                {
                    if (shape_conflict(&a.params[i], &c.params[i], params))
                    {
                        return true;
                    }
                }
                return shape_conflict(&a.ret, &c.ret, params);
            },
            _             : {},
        },
        _ : {},
    }
    // Two of one wrapper: their insides.
    u8 td = type_tag(decl);
    u8 ta = type_tag(actual);
    if (td == ta && td != 11)
    {
        match (inner_of(decl))
        {
            Some(di) : return shape_conflict(&di, &Option::expect(inner_of(actual), "the same wrapper"), params),
            None     : {},
        }
    }
    td != ta
}

// Binds the type parameters named in `params` that `decl_ty` mentions to
// what `actual` has in their places.
fn unify_type_shape(
    ref<Type, shared> decl_ty,
    ref<Type, shared> actual,
    ref<HashMap<String, Type>, exclusive> m,
    ref<Vec<String>, shared> params,
)
{
    // D-0312: a probe's argument is fixed by the other parameters.
    if (is_probe(decl_ty))
    {
        return;
    }
    match (decl_ty)
    {
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (Vec::len(&n.args) == 0 && Vec::contains(params, &n.name))
            {
                if (!HashMap::contains(m, &n.name))
                {
                    HashMap::insert(m, String::clone(&n.name), clone(actual));
                }
                return;
            }
        },
        _               : {},
    }
    match (decl_ty)
    {
        Type::TRef(d) : match (actual)
        {
            Type::TRef(a) : unify_type_shape(&Box::get(d).inner, &Box::get(a).inner, m, params),
            _             : {},
        },
        Type::TSlice(d) : match (actual)
        {
            Type::TSlice(a) : unify_type_shape(&Box::get(d).inner, &Box::get(a).inner, m, params),
            // D-0312 `[Coerce-Slice]`: a `Vec`'s or an array's elements fix
            // a slice parameter's.
            Type::TRef(a) : match (seq_elem(&Box::get(a).inner))
            {
                Some(x) : unify_type_shape(&Box::get(d).inner, &x, m, params),
                None    : {},
            },
            _               : {},
        },
        Type::TRawptr(d) : match (actual)
        {
            Type::TRawptr(a) : unify_type_shape(Box::get(d), Box::get(a), m, params),
            _                : {},
        },
        Type::TArray(d) : match (actual)
        {
            Type::TArray(a) : unify_type_shape(&Box::get(d).inner, &Box::get(a).inner, m, params),
            _               : {},
        },
        Type::THandle(d) : match (actual)
        {
            Type::THandle(a) : unify_type_shape(Box::get(d), Box::get(a), m, params),
            _                : {},
        },
        Type::TMutex(d) : match (actual)
        {
            Type::TMutex(a) : unify_type_shape(Box::get(d), Box::get(a), m, params),
            _               : {},
        },
        Type::TGuard(d) : match (actual)
        {
            Type::TGuard(a) : unify_type_shape(Box::get(d), Box::get(a), m, params),
            _               : {},
        },
        Type::TFn(d) : match (actual)
        {
            Type::TFn(a) :
            {
                ref<FnTy, shared> df = Box::get(d);
                ref<FnTy, shared> af = Box::get(a);
                if (Vec::len(&df.params) == Vec::len(&af.params))
                {
                    for (usize i = 0; i < Vec::len(&df.params); i += 1)
                    {
                        unify_type_shape(&df.params[i], &af.params[i], m, params);
                    }
                    unify_type_shape(&df.ret, &af.ret, m, params);
                }
            },
            _            : {},
        },
        Type::TNamed(d) : match (actual)
        {
            Type::TNamed(a) :
            {
                ref<NamedTy, shared> dn = Box::get(d);
                ref<NamedTy, shared> an = Box::get(a);
                for (usize i = 0; i < Vec::len(&dn.args) && i < Vec::len(&an.args); i += 1)
                {
                    unify_type_shape(&dn.args[i], &an.args[i], m, params);
                }
            },
            _               : {},
        },
        _ : {},
    }
}

// Structural type equality for a mismatch diagnostic, `never` accepted at
// any expected type (`[T-Never]`).
fn ty_compat(ref<Type, shared> a, ref<Type, shared> b) : bool
{
    type_eq(a, b) || is_never(a) || is_never(b)
}

// ---- rule.control.flow-analysis (spec/14 §6) ----

enum Tri
{
    T,
    F,
    U,
}

fn tri_join(Tri a, Tri b) : Tri
{
    if (a == b) { a } else { Tri::U }
}

// D-0282 (`rule.control.frame-references`): the state the rules for
// frame-held references keep per function body (its uses, for liveness by
// last use), and the report D-0281's measurements read: with
// COBALTC_TIER_REPORT=FILE the static pass appends to FILE, for each body,
// the conflict checks it made, those it could decide neither way, the
// point checks left to the run, and the reference bindings it gave no
// origin. The report changes nothing. The body being checked owns it
// (`Body.rep`).

// A position in the source, as `(line, col)` orders.
struct Pos
{
    usize line;
    usize col;
}

fn pos_le(ref<Pos, shared> a, ref<Pos, shared> b) : bool
{
    a.line < b.line || (a.line == b.line && a.col <= b.col)
}

fn pos_max(ref<Pos, shared> a, ref<Pos, shared> b) : Pos
{
    if (pos_le(a, b)) { clone(b) } else { clone(a) }
}

// A binding as liveness sees it: its name, where it is declared and where
// its scope ends (D-0111's last use, by lexical scope).
struct Decl
{
    String name;
    Pos pos;
    Pos end;
}

// A use of a name, by position, and the declaration it resolves to
// (`REP_PARAM` for a parameter or anything declared outside the body).
struct Use
{
    String name;
    usize line;
    usize col;
    usize decl;
    // D-0341 (report 392): the use reads an element of the binding
    // (`name[i]`): a container that has none faults there too.
    bool elem;
}

// The extent of a loop: its first and last line.
struct LoopExtent
{
    usize a;
    usize b;
}

const usize REP_PARAM = 18446744073709551615;

struct Rep
{
    Vec<Use> uses;
    Vec<Decl> decls;
    Vec<LoopExtent> loops;
    String func;
    usize checks;
    usize undecided;
    usize unknown_origin;
    usize inherited;
    usize tier_d;
    usize point_checks;
    // D-0281 step 4c: the first conflict left to the run's tracking.
    Option<String> left;
    // D-0299: every distinct conflict left to the run, in the order found
    // (the certificate lists them all; `left` is the first).
    Vec<String> lefts;
    Option<String> error;
    Vec<String> events;
    // `uses` and `decls` by name (indices, in order): what `live_after`
    // looks through.
    HashMap<String, Vec<usize>> uses_by;
    HashMap<String, Vec<usize>> decls_by;
}

fn rep_new(String func) : Rep
{
    Rep {
        .uses = Vec::new(),
        .decls = Vec::new(),
        .loops = Vec::new(),
        .func = func,
        .checks = 0,
        .undecided = 0,
        .unknown_origin = 0,
        .inherited = 0,
        .tier_d = 0,
        .point_checks = 0,
        .left = None,
        .lefts = Vec::new(),
        .error = None,
        .events = Vec::new(),
        .uses_by = HashMap::new(),
        .decls_by = HashMap::new(),
    }
}

fn rep_kind_of(ref<Expr, shared> e) : String
{
    match (&e.kind)
    {
        ExprKind::EParen(i)   : rep_kind_of(Box::get(i)),
        ExprKind::ECall(cb) : match (&Box::get(cb).callee.kind)
        {
            ExprKind::EPath(p) : sprintf("call %s", &String::join(&Box::get(p).segs, "::")),
            _                  : "call (value)",
        },
        ExprKind::EPath(p)    : sprintf("name %s", &String::join(&Box::get(p).segs, "::")),
        ExprKind::EField(f)   : sprintf("field .%s", &Box::get(f).name),
        ExprKind::EIndex(_)   : "index",
        ExprKind::EDeref(_)   : "deref",
        ExprKind::EBorrow(_)  : "borrow",
        ExprKind::ESliceOf(_) : "slice-of",
        ExprKind::EIf(_)      : "if",
        ExprKind::EMatch(_)   : "match",
        ExprKind::EBlock(_)   : "block",
        ExprKind::EStr(_)     : "literal",
        _                     : "other",
    }
}

// The report's beginning: the body's uses, declarations and loops.
fn rep_begin(String func, ref<Block, shared> body) : Rep
{
    Walker w = Walker { .rep = rep_new(func), .visible = HashMap::new(), .elem_use = false };
    wk_block(&mut w, body);
    Walker { rep, .. } = w;
    rep
}

// Whether the binding `name` visible at (line, col) is used after that
// point, or anywhere in a loop that contains the point and that its
// declaration precedes (a binding declared in a loop's body is a new
// binding each time round).
fn rep_live_after(ref<Rep, shared> r, StringView name, usize line, usize col) : bool
{
    rep_used_after(r, name, line, col, false)
}

// D-0341 (report 392): as `rep_live_after`, counting only the uses that
// read an element of the binding (`name[i]`).
fn rep_elem_read_after(ref<Rep, shared> r, StringView name, usize line, usize col) : bool
{
    rep_used_after(r, name, line, col, true)
}

fn rep_used_after(ref<Rep, shared> r, StringView name, usize line, usize col, bool elem_only) : bool
{
    Pos at = Pos { .line = line, .col = col };
    String key = String::copy(name);
    Vec<usize> none = Vec::new();
    ref<Vec<usize>, shared> dix = match (HashMap::get(&r.decls_by, &key))
    {
        Some(v) : v,
        None    : &none,
    };
    ref<Vec<usize>, shared> uix = match (HashMap::get(&r.uses_by, &key))
    {
        Some(v) : v,
        None    : return false,
    };
    usize decl = REP_PARAM;
    for (usize di = 0; di < Vec::len(dix); di += 1)
    {
        usize i = dix[di];
        ref<Decl, shared> d = &r.decls[i];
        if (pos_le(&d.pos, &at) && pos_le(&at, &d.end))
        {
            // `max_by_key`: the last of the greatest.
            if (decl == REP_PARAM || pos_le(&r.decls[decl].pos, &d.pos))
            {
                decl = i;
            }
        }
    }
    usize decl_line = if (decl == REP_PARAM) { 0 } else { r.decls[decl].pos.line };
    Vec<LoopExtent> in_loops = Vec::new();
    for (usize i = 0; i < Vec::len(&r.loops); i += 1)
    {
        ref<LoopExtent, shared> l = &r.loops[i];
        if (l.a <= line && line <= l.b && decl_line < l.a)
        {
            Vec::push(&mut in_loops, clone(l));
        }
    }
    for (usize ui = 0; ui < Vec::len(uix); ui += 1)
    {
        ref<Use, shared> u = &r.uses[uix[ui]];
        if (u.decl != decl || (elem_only && !u.elem))
        {
            continue;
        }
        if (u.line > line || (u.line == line && u.col > col))
        {
            return true;
        }
        for (usize k = 0; k < Vec::len(&in_loops); k += 1)
        {
            if (in_loops[k].a <= u.line && u.line <= in_loops[k].b)
            {
                return true;
            }
        }
    }
    false
}

// The last position inside an expression or a block: a scope's end.
// (The greatest of the uses, declarations and loop ends a `Walker` would
// record over `e`; `rep_pos_in` finds it without recording them.)
fn rep_end_e(ref<Expr, shared> e, ref<Pos, exclusive> m)
{
    pos_up(m, e.line, e.col);
    rep_pos_in(e, m);
}

fn pos_up(ref<Pos, exclusive> m, usize line, usize col)
{
    if (line > m.line || (line == m.line && col > m.col))
    {
        m.line = line;
        m.col = col;
    }
}

// The greatest position the `Walker` would record inside `e`: a use, a
// declaration, a loop's end (its last line, any column).
fn rep_pos_in(ref<Expr, shared> e, ref<Pos, exclusive> m)
{
    match (&e.kind)
    {
        ExprKind::EPath(p)        :
        {
            if (Vec::len(&Box::get(p).segs) == 1)
            {
                pos_up(m, e.line, e.col);
            }
        },
        ExprKind::EParen(x)       : rep_pos_in(Box::get(x), m),
        ExprKind::EUnary(u)       : rep_pos_in(&Box::get(u).e, m),
        ExprKind::EPropagate(x)   : rep_pos_in(Box::get(x), m),
        ExprKind::EDeref(x)       : rep_pos_in(Box::get(x), m),
        ExprKind::EBorrow(bb)     : rep_pos_in(&Box::get(bb).e, m),
        ExprKind::EField(f)       : rep_pos_in(&Box::get(f).e, m),
        ExprKind::EArrayRepeat(r) : rep_pos_in(&Box::get(r).value, m),
        ExprKind::EBinary(bb)     :
        {
            rep_pos_in(&Box::get(bb).a, m);
            rep_pos_in(&Box::get(bb).b, m);
        },
        ExprKind::EIndex(pb)      :
        {
            rep_pos_in(&Box::get(pb).a, m);
            rep_pos_in(&Box::get(pb).b, m);
        },
        ExprKind::EAssign(pb)     :
        {
            rep_pos_in(&Box::get(pb).a, m);
            rep_pos_in(&Box::get(pb).b, m);
        },
        ExprKind::ESliceOf(sb)    :
        {
            rep_pos_in(&Box::get(sb).base, m);
            rep_pos_in(&Box::get(sb).lo, m);
            rep_pos_in(&Box::get(sb).hi, m);
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            rep_pos_in(&c.callee, m);
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                rep_pos_in(&c.args[i], m);
            }
        },
        ExprKind::EStructLit(sl)  :
        {
            ref<Vec<FieldInit>, shared> fs = &Box::get(sl).fields;
            for (usize i = 0; i < Vec::len(fs); i += 1)
            {
                rep_pos_in(&fs[i].value, m);
            }
        },
        ExprKind::EArrayLit(xs)   :
        {
            for (usize i = 0; i < Vec::len(xs); i += 1)
            {
                rep_pos_in(&xs[i], m);
            }
        },
        ExprKind::EBlock(blk)     : rep_pos_block(blk, m),
        ExprKind::EUnsafe(blk)    : rep_pos_block(blk, m),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            rep_pos_in(&x.cond, m);
            rep_pos_block(&x.then_, m);
            match (&x.else_)
            {
                Some(e2) : rep_pos_in(e2, m),
                None     : {},
            }
        },
        // Everything inside a loop is before its end.
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            Pos end = Pos { .line = e.line, .col = e.col };
            rep_end_e(&x.cond, &mut end);
            end = pos_max(&end, &rep_end_b(&x.body));
            match (&x.step)
            {
                Some(st) : rep_end_e(st, &mut end),
                None     : {},
            }
            pos_up(m, end.line, REP_PARAM);
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> mt = Box::get(mb);
            rep_pos_in(&mt.scrut, m);
            for (usize i = 0; i < Vec::len(&mt.arms); i += 1)
            {
                ref<Expr, shared> body = Box::get(&mt.arms[i].body);
                if (Option::is_some(&mt.arms[i].binder))
                {
                    pos_up(m, body.line, 0);
                }
                rep_pos_in(body, m);
            }
        },
        ExprKind::EReturn(v) : match (v)
        {
            Some(x) : rep_pos_in(Box::get(x), m),
            None    : {},
        },
        ExprKind::EClosure(cb)    :
        {
            ref<ClosureExpr, shared> c = Box::get(cb);
            if (Vec::len(&c.captures) > 0)
            {
                pos_up(m, e.line, e.col);
            }
            rep_pos_block(&c.body, m);
        },
        _                         : {},
    }
}

fn rep_pos_block(ref<Block, shared> b, ref<Pos, exclusive> m)
{
    for (usize i = 0; i < Vec::len(&b.stmts); i += 1)
    {
        match (&b.stmts[i])
        {
            Stmt::SLet(lb)         :
            {
                ref<LetStmt, shared> l = Box::get(lb);
                match (&l.init)
                {
                    Some(e) : rep_pos_in(e, m),
                    None    : {},
                }
                pos_up(m, l.line, l.col);
            },
            Stmt::SDestructure(db) :
            {
                ref<DestructureStmt, shared> d = Box::get(db);
                rep_pos_in(&d.init, m);
                if (Vec::len(&d.names) > 0)
                {
                    pos_up(m, d.init.line, d.init.col);
                }
            },
            Stmt::SExpr(e)         : rep_pos_in(Box::get(e), m),
            Stmt::SBlockLike(e)    : rep_pos_in(Box::get(e), m),
        }
    }
    match (&b.tail)
    {
        Some(t) : rep_pos_in(Box::get(t), m),
        None    : {},
    }
}

fn rep_end_b(ref<Block, shared> b) : Pos
{
    Pos m = Pos { .line = 0, .col = 0 };
    for (usize i = 0; i < Vec::len(&b.stmts); i += 1)
    {
        match (&b.stmts[i])
        {
            Stmt::SLet(lb)        :
            {
                ref<LetStmt, shared> l = Box::get(lb);
                m = pos_max(&m, &Pos { .line = l.line, .col = l.col });
                match (&l.init)
                {
                    Some(e) : rep_end_e(e, &mut m),
                    None    : {},
                }
            },
            Stmt::SDestructure(d) : rep_end_e(&Box::get(d).init, &mut m),
            Stmt::SExpr(e)        : rep_end_e(Box::get(e), &mut m),
            Stmt::SBlockLike(e)   : rep_end_e(Box::get(e), &mut m),
        }
    }
    match (&b.tail)
    {
        Some(t) : rep_end_e(Box::get(t), &mut m),
        None    : {},
    }
    m
}

struct Walker
{
    Rep rep;
    // The declarations in scope, innermost last, by name.
    HashMap<String, Vec<usize>> visible;
    // The next use recorded is the base of an index (`Use.elem`).
    bool elem_use;
}

fn wk_declare(ref<Walker, exclusive> w, ref<String, shared> name, Pos pos, Pos end, ref<Vec<String>, exclusive> scope)
{
    Vec::push(&mut w.rep.decls, Decl { .name = String::clone(name), .pos = pos, .end = end });
    usize ix = Vec::len(&w.rep.decls) - 1;
    Vec::push(HashMap::entry(&mut w.rep.decls_by, name, Vec::new()), ix);
    ref<Vec<usize>, exclusive> v = HashMap::entry(&mut w.visible, name, Vec::new());
    Vec::push(v, ix);
    Vec::push(scope, String::clone(name));
}

fn wk_close(ref<Walker, exclusive> w, Vec<String> scope)
{
    for (usize i = 0; i < Vec::len(&scope); i += 1)
    {
        match (HashMap::get_mut(&mut w.visible, &scope[i]))
        {
            Some(v) :
            {
                Vec::pop(v);
            },
            None    : {},
        }
    }
}

// `x` or `x.f.g`: a place whose first use the walker records is `x`'s.
fn field_chain_of_path(ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EPath(p)  : Vec::len(&Box::get(p).segs) == 1,
        ExprKind::EField(f) : field_chain_of_path(&Box::get(f).e),
        _                   : false,
    }
}

fn wk_use_name(ref<Walker, exclusive> w, ref<String, shared> name, usize line, usize col)
{
    usize d = match (HashMap::get(&w.visible, name))
    {
        Some(v) : if (Vec::len(v) > 0) { v[Vec::len(v) - 1] } else { REP_PARAM },
        None    : REP_PARAM,
    };
    Vec::push(&mut w.rep.uses, Use { .name = String::clone(name), .line = line, .col = col, .decl = d, .elem = w.elem_use });
    w.elem_use = false;
    usize ix = Vec::len(&w.rep.uses) - 1;
    Vec::push(HashMap::entry(&mut w.rep.uses_by, name, Vec::new()), ix);
}

fn wk_block(ref<Walker, exclusive> w, ref<Block, shared> b)
{
    Pos end = rep_end_b(b);
    Vec<String> scope = Vec::new();
    for (usize i = 0; i < Vec::len(&b.stmts); i += 1)
    {
        match (&b.stmts[i])
        {
            Stmt::SLet(lb)         :
            {
                ref<LetStmt, shared> l = Box::get(lb);
                match (&l.init)
                {
                    Some(e) : wk_expr(w, e),
                    None    : {},
                }
                wk_declare(w, &l.name, Pos { .line = l.line, .col = l.col }, clone(&end), &mut scope);
            },
            Stmt::SDestructure(db) :
            {
                ref<DestructureStmt, shared> d = Box::get(db);
                wk_expr(w, &d.init);
                for (usize k = 0; k < Vec::len(&d.names); k += 1)
                {
                    wk_declare(w, &d.names[k], Pos { .line = d.init.line, .col = d.init.col }, clone(&end), &mut scope);
                }
            },
            Stmt::SExpr(e)         : wk_expr(w, Box::get(e)),
            Stmt::SBlockLike(e)    : wk_expr(w, Box::get(e)),
        }
    }
    match (&b.tail)
    {
        Some(t) : wk_expr(w, Box::get(t)),
        None    : {},
    }
    wk_close(w, scope);
}

fn wk_expr(ref<Walker, exclusive> w, ref<Expr, shared> e)
{
    match (&e.kind)
    {
        ExprKind::EPath(p)        :
        {
            ref<Vec<String>, shared> segs = &Box::get(p).segs;
            if (Vec::len(segs) == 1)
            {
                wk_use_name(w, &segs[0], e.line, e.col);
            }
        },
        ExprKind::EParen(x)       : wk_expr(w, Box::get(x)),
        ExprKind::EUnary(u)       : wk_expr(w, &Box::get(u).e),
        ExprKind::EPropagate(x)   : wk_expr(w, Box::get(x)),
        ExprKind::EDeref(x)       : wk_expr(w, Box::get(x)),
        ExprKind::EBorrow(bb)     : wk_expr(w, &Box::get(bb).e),
        ExprKind::EField(f)       : wk_expr(w, &Box::get(f).e),
        ExprKind::EArrayRepeat(r) : wk_expr(w, &Box::get(r).value),
        ExprKind::EBinary(bb)     :
        {
            wk_expr(w, &Box::get(bb).a);
            wk_expr(w, &Box::get(bb).b);
        },
        ExprKind::EIndex(pb)      :
        {
            w.elem_use = field_chain_of_path(&Box::get(pb).a);
            wk_expr(w, &Box::get(pb).a);
            w.elem_use = false;
            wk_expr(w, &Box::get(pb).b);
        },
        ExprKind::EAssign(pb)     :
        {
            wk_expr(w, &Box::get(pb).a);
            wk_expr(w, &Box::get(pb).b);
        },
        ExprKind::ESliceOf(sb)    :
        {
            ref<SliceExpr, shared> s = Box::get(sb);
            wk_expr(w, &s.base);
            wk_expr(w, &s.lo);
            wk_expr(w, &s.hi);
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            wk_expr(w, &c.callee);
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                wk_expr(w, &c.args[i]);
            }
        },
        ExprKind::EStructLit(sl)  :
        {
            ref<Vec<FieldInit>, shared> fs = &Box::get(sl).fields;
            for (usize i = 0; i < Vec::len(fs); i += 1)
            {
                wk_expr(w, &fs[i].value);
            }
        },
        ExprKind::EArrayLit(xs)   :
        {
            for (usize i = 0; i < Vec::len(xs); i += 1)
            {
                wk_expr(w, &xs[i]);
            }
        },
        ExprKind::EBlock(blk)     : wk_block(w, blk),
        ExprKind::EUnsafe(blk)    : wk_block(w, blk),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            wk_expr(w, &x.cond);
            wk_block(w, &x.then_);
            match (&x.else_)
            {
                Some(e2) : wk_expr(w, e2),
                None     : {},
            }
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            Pos end = Pos { .line = e.line, .col = e.col };
            rep_end_e(&x.cond, &mut end);
            end = pos_max(&end, &rep_end_b(&x.body));
            match (&x.step)
            {
                Some(st) : rep_end_e(st, &mut end),
                None     : {},
            }
            Vec::push(&mut w.rep.loops, LoopExtent { .a = e.line, .b = end.line });
            wk_expr(w, &x.cond);
            wk_block(w, &x.body);
            match (&x.step)
            {
                Some(st) : wk_expr(w, st),
                None     : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> m = Box::get(mb);
            wk_expr(w, &m.scrut);
            for (usize i = 0; i < Vec::len(&m.arms); i += 1)
            {
                ref<Arm, shared> a = &m.arms[i];
                ref<Expr, shared> body = Box::get(&a.body);
                // A binder is declared for its arm's body.
                Vec<String> scope = Vec::new();
                match (&a.binder)
                {
                    Some(bn) :
                    {
                        Pos end = Pos { .line = body.line, .col = body.col };
                        rep_end_e(body, &mut end);
                        wk_declare(w, bn, Pos { .line = body.line, .col = 0 }, end, &mut scope);
                    },
                    None     : {},
                }
                wk_expr(w, body);
                wk_close(w, scope);
            }
        },
        ExprKind::EReturn(v) : match (v)
        {
            Some(x) : wk_expr(w, Box::get(x)),
            None    : {},
        },
        ExprKind::EClosure(cb)    :
        {
            ref<ClosureExpr, shared> c = Box::get(cb);
            for (usize i = 0; i < Vec::len(&c.captures); i += 1)
            {
                wk_use_name(w, &c.captures[i], e.line, e.col);
            }
            wk_block(w, &c.body);
        },
        _                         : {},
    }
}

// D-0291: a `std` body whose rule decides it. `std::slice_parts` pushes
// reborrows of its slice into its result, each checked against those
// already there; `[Slice-Parts]` makes them disjoint, so no check of the
// body can fault, and its result reaches what its slice does.
fn rep_trusted(ref<String, shared> func) : bool
{
    *func == "std::slice_parts" || StringView::starts_with(func, "std::slice_parts<")
}

// Whether the body being checked is one its rule decides: its point
// checks are not made, as none can fault.
fn rep_in_trusted(ref<Body, shared> b) : bool
{
    rep_trusted(&b.rep.func)
}

// A conflict this body leaves to the run's tracking, `why` (the first is
// kept).
fn rep_left(ref<Body, exclusive> b, String why)
{
    if (rep_trusted(&b.rep.func))
    {
        return;
    }
    if (!Vec::contains(&b.rep.lefts, &why))
    {
        Vec::push(&mut b.rep.lefts, String::clone(&why));
    }
    if (Option::is_none(&b.rep.left))
    {
        b.rep.left = Some(why);
    }
}

// The body's end: the report written, and what it left to the run, into
// `Items` (`tracking_needed`, `point_check_fns`, `point_checks`: staged in
// the body as it is checked and moved over once it is done).
// Whether the body left anything to the run (D-0309's condition 6).
fn tier_flush(ref<Body, exclusive> b, ref<Items, exclusive> it, ref<String, shared> key) : bool
{
    Rep r = replace(&mut b.rep, rep_new(String::new()));
    bool left = Option::is_some(&r.left);
    match (&r.left)
    {
        Some(why) :
        {
            if (!HashMap::contains(&it.tracking_needed, key))
            {
                HashMap::insert(&mut it.tracking_needed, String::clone(key), String::clone(why));
            }
        },
        None      : {},
    }
    if (b.point_check_fn)
    {
        HashSet::insert(&mut it.point_check_fns, String::clone(key));
        b.point_check_fn = false;
    }
    Vec<PointAt> made = replace(&mut b.point_checks_made, Vec::new());
    for (usize i = 0; i < Vec::len(&made); i += 1)
    {
        ref<Vec<PointCheck>, exclusive> v = HashMap::entry(
            &mut it.point_checks,
            &made[i].site,
            Vec::new(),
        );
        bool present = false;
        for (usize k = 0; k < Vec::len(v) && !present; k += 1)
        {
            present = point_check_eq(&v[k], &made[i].pc);
        }
        if (!present)
        {
            Vec::push(v, clone(&made[i].pc));
        }
        it.any_point_checks = true;
    }
    // D-0299: the certificate's raw records for this body (`--certificate
    // FILE` names the file in `Items.certificate`; cobc's `cert_finish` gives
    // them their final form once the whole program is known).
    match (&it.certificate)
    {
        Some(cpath) :
        {
            String rec = sprintf("fn\t%s\n", &r.func);
            foreach (why in &r.lefts)
            {
                String::appendf(&mut rec, "left\t%s\n", &StringView::replace(why, "\n", " "));
            }
            foreach (e in &r.events)
            {
                String::appendf(&mut rec, "ev\t%s\n", e);
            }
            match (&r.error)
            {
                Some(e) : String::appendf(&mut rec, "error\t%s\n", &StringView::replace(e, "\n", " ")),
                None    : {},
            }
            String::append(&mut rec, "end\n");
            match (File::append(cpath))
            {
                Ok(f)  :
                {
                    _ = File::write_text(&mut f, &rec);
                    _ = File::close(f);
                },
                Err(_) : {},
            }
        },
        None        : {},
    }
    Option<String> path_opt = match (env_var("COBALTC_TIER_REPORT"))
    {
        Ok(Some(p)) : if (StringView::len(&p) > 0) { Some(p) } else { None },
        _           : None,
    };
    String path = match (path_opt)
    {
        Some(p) : p,
        None    : return left,
    };
    String out = sprintf(
        "F\t%s\t%v\t%v\t%v\t%v\t%v\t%v\n",
        &r.func,
        r.checks,
        r.undecided,
        r.unknown_origin,
        r.inherited,
        r.tier_d,
        r.point_checks,
    );
    match (&r.error)
    {
        Some(e) : String::appendf(&mut out, "E\t%s\n", &StringView::replace(e, "\n", " ")),
        None    : {},
    }
    for (usize i = 0; i < Vec::len(&r.events); i += 1)
    {
        String::append(&mut out, &r.events[i]);
        String::append(&mut out, "\n");
    }
    match (File::append(&path))
    {
        Ok(f)  :
        {
            _ = File::write_text(&mut f, &out);
            _ = File::close(f);
        },
        Err(_) : {},
    }
    left
}

fn point_other_eq(ref<PointOther, shared> a, ref<PointOther, shared> b) : bool
{
    match (a)
    {
        PointOther::Arg(i) : match (b)
        {
            PointOther::Arg(j) : *i == *j,
            _                  : false,
        },
        PointOther::Holder(h) : match (b)
        {
            PointOther::Holder(g) : (*h == *g),
            _                     : false,
        },
    }
}

fn point_check_eq(ref<PointCheck, shared> a, ref<PointCheck, shared> b) : bool
{
    if (a.arg != b.arg || a.mode != b.mode || a.other_mode != b.other_mode || a.callee != b.callee)
    {
        return false;
    }
    if (!point_other_eq(&a.other, &b.other) || Vec::len(&a.fields) != Vec::len(&b.fields))
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(&a.fields); i += 1)
    {
        if (a.fields[i] != b.fields[i])
        {
            return false;
        }
    }
    true
}

// A point check recorded: staged until the body is done.
fn record_point_check(ref<Body, exclusive> b, String site, PointCheck pc)
{
    Vec::push(&mut b.point_checks_made, PointAt { .site = site, .pc = pc });
}

// A point check at a call's site, staged (`record_point_check`).
struct PointAt
{
    String site;
    PointCheck pc;
}

// An empty set of names, of a type the static pass knows (a `seen` set
// given beside a reference: `HashSet::new()`'s `K` is not known there, so
// the reference might be stored in it, D-0290).
fn new_name_set() : HashSet<String>
{
    HashSet::new()
}

// Rust's `trim_start_matches('*')`: a root without its leading stars.
fn strip_stars(StringView s) : StringView
{
    StringView r = s;
    while (true)
    {
        match (StringView::strip_prefix(r, "*"))
        {
            Some(t) : r = t,
            None    : break,
        }
    }
    r
}

fn mode_debug(Mode m) : str
{
    if (m == Mode::Exclusive) { "Exclusive" } else { "Shared" }
}

struct RangeLit
{
    u128 lo;
    u128 hi;
}

// One element of a syntactic projection path: a field name, an index (its
// literal value, or none), or (D-0070) a slice's range.
enum PElem
{
    PField(String),
    PIndex(Option<u128>),
    PRange(Option<RangeLit>),
    // Report 311: a range whose bounds are not both literals, each bound
    // named by `stable_bound_key` ("" when it has no key).
    PSpan(SpanKeys),
}

struct SpanKeys
{
    String lo;
    String hi;
}

// Report 311: the key of a range bound whose value is the same wherever
// the frame names it: a literal (`#5`), or a local `stable_bounds` lists;
// else "".
fn stable_bound_key(ref<Body, shared> b, ref<Expr, shared> e) : String
{
    match (literal_value(e))
    {
        Some(v) : return sprintf("#%v", v),
        None    : {},
    }
    match (one_seg(strip_parens_tc(e)))
    {
        Some(n) : if (HashSet::contains(&b.stable_bounds, n)) { String::clone(n) } else { String::new() },
        None    : String::new(),
    }
}

// Report 311: two spans one of which ends where the other starts, by the
// same key (`[a .. m]` and `[m .. b]`), share no element.
fn spans_adjacent(ref<SpanKeys, shared> x, ref<SpanKeys, shared> y) : bool
{
    (StringView::len(&x.hi) > 0 && x.hi == y.lo) || (StringView::len(&x.lo) > 0 && x.lo == y.hi)
}

// A slice's range as a path step: its bounds when both are literals; a
// span of keyed bounds when one of them has a key (report 311).
fn range_elem_in(ref<Body, shared> b, ref<Expr, shared> lo, ref<Expr, shared> hi) : PElem
{
    match (range_elem(lo, hi))
    {
        PElem::PRange(Some(r)) : PElem::PRange(Some(r)),
        _                      :
        {
            String kl = stable_bound_key(b, lo);
            String kh = stable_bound_key(b, hi);
            if (StringView::len(&kl) == 0 && StringView::len(&kh) == 0)
            {
                PElem::PRange(None)
            }
            else
            {
                PElem::PSpan(SpanKeys { .lo = kl, .hi = kh })
            }
        },
    }
}

// Report 311: the locals of a function whose value never changes once
// declared, so that two mentions of one name in the frame are one value:
// each declared once in the function (a parameter or a `let` outside every
// loop and closure body, no other binding of its name anywhere in it),
// never assigned, never borrowed, captured by no closure without `move`.
fn stable_bound_names(ref<FnDecl, shared> f) : HashSet<String>
{
    HashMap<String, usize> decls = HashMap::new();
    HashSet<String> unstable = HashSet::new();
    foreach (q in &f.params)
    {
        sb_declare(&mut decls, &mut unstable, &q.name, false);
    }
    sb_block(&f.body, false, &mut decls, &mut unstable);
    Vec<String> written = Vec::new();
    Vec<String> none = Vec::new();
    bool dummy = false;
    ve_block(&f.body, 4, &mut written, &none, &mut dummy);
    ve_block(&f.body, 5, &mut written, &none, &mut dummy);
    HashSet<String> out = HashSet::new();
    for (usize i = 0; i < HashMap::len(&decls); i += 1)
    {
        ref<String, shared> n = HashMap::key_at(&decls, i);
        if (*HashMap::value_at(&decls, i) == 1 && !HashSet::contains(&unstable, n) && !Vec::contains(&written, n))
        {
            HashSet::insert(&mut out, String::clone(n));
        }
    }
    out
}

fn sb_declare(ref<HashMap<String, usize>, exclusive> decls, ref<HashSet<String>, exclusive> unstable, ref<String, shared> n, bool repeated)
{
    ref<usize, exclusive> c = HashMap::entry(decls, n, 0);
    *c += 1;
    if (repeated)
    {
        HashSet::insert(unstable, String::clone(n));
    }
}

// `repeated`: inside a loop or a closure body, whose declarations run more
// than once in a frame.
fn sb_block(ref<Block, shared> blk, bool repeated, ref<HashMap<String, usize>, exclusive> decls, ref<HashSet<String>, exclusive> unstable)
{
    foreach (st in &blk.stmts)
    {
        match (st)
        {
            Stmt::SLet(lb)         :
            {
                ref<LetStmt, shared> l = Box::get(lb);
                sb_declare(decls, unstable, &l.name, repeated);
                match (&l.init)
                {
                    Some(e) : sb_expr(e, repeated, decls, unstable),
                    None    : {},
                }
            },
            Stmt::SDestructure(db) :
            {
                ref<DestructureStmt, shared> d = Box::get(db);
                foreach (n in &d.names)
                {
                    sb_declare(decls, unstable, n, repeated);
                }
                sb_expr(&d.init, repeated, decls, unstable);
            },
            Stmt::SExpr(x)         : sb_expr(Box::get(x), repeated, decls, unstable),
            Stmt::SBlockLike(x)    : sb_expr(Box::get(x), repeated, decls, unstable),
        }
    }
    match (&blk.tail)
    {
        Some(t) : sb_expr(Box::get(t), repeated, decls, unstable),
        None    : {},
    }
}

fn sb_expr(ref<Expr, shared> e, bool repeated, ref<HashMap<String, usize>, exclusive> decls, ref<HashSet<String>, exclusive> unstable)
{
    match (&e.kind)
    {
        ExprKind::EParen(x)       : sb_expr(Box::get(x), repeated, decls, unstable),
        ExprKind::EUnary(u)       : sb_expr(&Box::get(u).e, repeated, decls, unstable),
        ExprKind::EDeref(x)       : sb_expr(Box::get(x), repeated, decls, unstable),
        ExprKind::EField(fb)      : sb_expr(&Box::get(fb).e, repeated, decls, unstable),
        ExprKind::EBorrow(bb)     : sb_expr(&Box::get(bb).e, repeated, decls, unstable),
        ExprKind::EPropagate(x)   : sb_expr(Box::get(x), repeated, decls, unstable),
        ExprKind::EArrayRepeat(r) : sb_expr(&Box::get(r).value, repeated, decls, unstable),
        ExprKind::EReturn(v) : match (v)
        {
            Some(x) : sb_expr(Box::get(x), repeated, decls, unstable),
            None    : {},
        },
        ExprKind::ESliceOf(sb)    :
        {
            ref<SliceExpr, shared> sx = Box::get(sb);
            sb_expr(&sx.base, repeated, decls, unstable);
            sb_expr(&sx.lo, repeated, decls, unstable);
            sb_expr(&sx.hi, repeated, decls, unstable);
        },
        ExprKind::EBinary(bb)     :
        {
            sb_expr(&Box::get(bb).a, repeated, decls, unstable);
            sb_expr(&Box::get(bb).b, repeated, decls, unstable);
        },
        ExprKind::EIndex(pb)      :
        {
            sb_expr(&Box::get(pb).a, repeated, decls, unstable);
            sb_expr(&Box::get(pb).b, repeated, decls, unstable);
        },
        ExprKind::EAssign(pb)     :
        {
            sb_expr(&Box::get(pb).a, repeated, decls, unstable);
            sb_expr(&Box::get(pb).b, repeated, decls, unstable);
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            sb_expr(&c.callee, repeated, decls, unstable);
            foreach (a in &c.args)
            {
                sb_expr(a, repeated, decls, unstable);
            }
        },
        ExprKind::EArrayLit(xs)   :
        {
            foreach (x in xs)
            {
                sb_expr(x, repeated, decls, unstable);
            }
        },
        ExprKind::EStructLit(sl)  :
        {
            foreach (fi in &Box::get(sl).fields)
            {
                sb_expr(&fi.value, repeated, decls, unstable);
            }
        },
        ExprKind::EBlock(bk)      : sb_block(bk, repeated, decls, unstable),
        ExprKind::EUnsafe(bk)     : sb_block(bk, repeated, decls, unstable),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            sb_expr(&x.cond, repeated, decls, unstable);
            sb_block(&x.then_, repeated, decls, unstable);
            match (&x.else_)
            {
                Some(e2) : sb_expr(e2, repeated, decls, unstable),
                None     : {},
            }
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            sb_expr(&x.cond, true, decls, unstable);
            sb_block(&x.body, true, decls, unstable);
            match (&x.step)
            {
                Some(st) : sb_expr(st, true, decls, unstable),
                None     : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> m = Box::get(mb);
            sb_expr(&m.scrut, repeated, decls, unstable);
            foreach (a in &m.arms)
            {
                match (&a.binder)
                {
                    Some(n) : sb_declare(decls, unstable, n, true),
                    None    : {},
                }
                sb_expr(Box::get(&a.body), repeated, decls, unstable);
            }
        },
        ExprKind::EClosure(cb)    :
        {
            ref<ClosureExpr, shared> c = Box::get(cb);
            foreach (q in &c.params)
            {
                sb_declare(decls, unstable, &q.name, true);
            }
            sb_block(&c.body, true, decls, unstable);
        },
        _                         : {},
    }
}

// A slice's range as a path step: its bounds when both are literals.
fn range_elem(ref<Expr, shared> lo, ref<Expr, shared> hi) : PElem
{
    match (literal_value(lo))
    {
        Some(a) : match (literal_value(hi))
        {
            Some(b) :
            {
                if (a >= 0 && b >= a)
                {
                    return PElem::PRange(Some(RangeLit { .lo = reinterpret<u128>(a), .hi = reinterpret<u128>(b) }));
                }
            },
            None    : {},
        },
        None : {},
    }
    PElem::PRange(None)
}

// D-0282: overlap for the rules of frame-held references. `Yes` when the
// two paths certainly meet (equal fields and literal indices, one a prefix
// of the other, every element in the longer one's remainder present);
// `Maybe` when they meet only for some values (an index or a range bound
// that is not a literal, a range in the remainder that may be empty): a
// point check at run time; `No` when they cannot meet.
enum Ov
{
    OvNo,
    OvMaybe,
    OvYes,
}

// The local an untyped `clone` argument starts from: `x` itself, or the
// root of a borrowed place `&x.f`, `&x[i]`, `&(*x).f` (report 341).
fn untyped_clone_root(ref<Expr, shared> e) : Option<String>
{
    match (&e.kind)
    {
        ExprKind::EPath(_) : match (one_seg(e))
        {
            Some(n) : Some(String::clone(n)),
            None    : None,
        },
        ExprKind::EBorrow(bb) : borrowed_place_root(&Box::get(bb).e),
        _                     : None,
    }
}

fn borrowed_place_root(ref<Expr, shared> e) : Option<String>
{
    match (&e.kind)
    {
        ExprKind::EPath(_) : match (one_seg(e))
        {
            Some(n) : Some(String::clone(n)),
            None    : None,
        },
        ExprKind::EField(f)  : borrowed_place_root(&Box::get(f).e),
        ExprKind::EIndex(ie) : borrowed_place_root(&Box::get(ie).a),
        ExprKind::EParen(x)  : borrowed_place_root(Box::get(x)),
        ExprKind::EDeref(x)  : borrowed_place_root(Box::get(x)),
        _                    : None,
    }
}

fn one_seg(ref<Expr, shared> e) : Option<ref<String, shared>>
{
    match (&e.kind)
    {
        ExprKind::EPath(p) :
        {
            ref<Vec<String>, shared> segs = &Box::get(p).segs;
            if (Vec::len(segs) == 1) { Some(&segs[0]) } else { None }
        },
        _                  : None,
    }
}

fn segs_eq(ref<Vec<String>, shared> a, ref<Vec<String>, shared> b) : bool
{
    if (Vec::len(a) != Vec::len(b))
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(a); i += 1)
    {
        if (a[i] != b[i])
        {
            return false;
        }
    }
    true
}

// Two place (or borrow) expressions that name the same place, written the
// same way: a name, fields, literal or same-name indices, dereferences.
fn same_place(ref<Expr, shared> a0, ref<Expr, shared> b0) : bool
{
    ref<Expr, shared> a = strip_parens_tc(a0);
    ref<Expr, shared> b = strip_parens_tc(b0);
    match (&a.kind)
    {
        ExprKind::EPath(x) : match (&b.kind)
        {
            ExprKind::EPath(y) : segs_eq(&Box::get(x).segs, &Box::get(y).segs),
            _                  : false,
        },
        ExprKind::EBorrow(x) : match (&b.kind)
        {
            ExprKind::EBorrow(y) : Box::get(x).mode == Box::get(y).mode && same_place(&Box::get(x).e, &Box::get(y).e),
            _                    : false,
        },
        ExprKind::EField(x) : match (&b.kind)
        {
            ExprKind::EField(y) : ((Box::get(x).name) == (Box::get(y).name)) && same_place(&Box::get(x).e, &Box::get(y).e),
            _                   : false,
        },
        ExprKind::EDeref(x) : match (&b.kind)
        {
            ExprKind::EDeref(y) : same_place(Box::get(x), Box::get(y)),
            _                   : false,
        },
        ExprKind::EIndex(x) : match (&b.kind)
        {
            ExprKind::EIndex(y) :
            {
                if (!same_place(&Box::get(x).a, &Box::get(y).a))
                {
                    return false;
                }
                ref<Expr, shared> i = strip_parens_tc(&Box::get(x).b);
                ref<Expr, shared> j = strip_parens_tc(&Box::get(y).b);
                match (&i.kind)
                {
                    ExprKind::EInt(u) : match (&j.kind)
                    {
                        ExprKind::EInt(v) : Box::get(u).v == Box::get(v).v && option_string_eq(
                            &Box::get(u).sfx,
                            &Box::get(v).sfx,
                        ),
                        _ : false,
                    },
                    ExprKind::EPath(p) : match (&j.kind)
                    {
                        ExprKind::EPath(q) : segs_eq(&Box::get(p).segs, &Box::get(q).segs),
                        _                  : false,
                    },
                    _ : false,
                }
            },
            _                   : false,
        },
        _ : false,
    }
}

fn option_string_eq(ref<Option<String>, shared> a, ref<Option<String>, shared> b) : bool
{
    match (a)
    {
        Some(x) : match (b)
        {
            Some(y) : (*x == *y),
            None    : false,
        },
        None : Option::is_none(b),
    }
}

fn overlap3(ref<Vec<PElem>, shared> a, ref<Vec<PElem>, shared> b) : Ov
{
    Ov ov = Ov::OvYes;
    for (usize i = 0; i < Vec::len(a) && i < Vec::len(b); i += 1)
    {
        match (&a[i])
        {
            PElem::PField(f) : match (&b[i])
            {
                PElem::PField(g) :
                {
                    if (*f != *g)
                    {
                        return Ov::OvNo;
                    }
                },
                PElem::PRange(_) : ov = Ov::OvMaybe,
                PElem::PIndex(_) : ov = Ov::OvMaybe,
                PElem::PSpan(_)  : ov = Ov::OvMaybe,
            },
            PElem::PIndex(x) : match (&b[i])
            {
                PElem::PIndex(y) : match (x)
                {
                    Some(p) : match (y)
                    {
                        Some(q) :
                        {
                            if (*p != *q)
                            {
                                return Ov::OvNo;
                            }
                        },
                        None    : ov = Ov::OvMaybe,
                    },
                    None : ov = Ov::OvMaybe,
                },
                PElem::PRange(r) : match (r)
                {
                    Some(rl) : match (x)
                    {
                        Some(p) :
                        {
                            if (!(rl.lo <= *p && *p < rl.hi))
                            {
                                return Ov::OvNo;
                            }
                        },
                        None    : ov = Ov::OvMaybe,
                    },
                    None : ov = Ov::OvMaybe,
                },
                PElem::PField(_) : ov = Ov::OvMaybe,
                PElem::PSpan(_)  : ov = Ov::OvMaybe,
            },
            PElem::PRange(r) : match (&b[i])
            {
                PElem::PIndex(y) : match (r)
                {
                    Some(rl) : match (y)
                    {
                        Some(q) :
                        {
                            if (!(rl.lo <= *q && *q < rl.hi))
                            {
                                return Ov::OvNo;
                            }
                        },
                        None    : ov = Ov::OvMaybe,
                    },
                    None : ov = Ov::OvMaybe,
                },
                PElem::PRange(s) : match (r)
                {
                    Some(r1) : match (s)
                    {
                        Some(r2) :
                        {
                            u128 lo = if (r1.lo > r2.lo) { r1.lo } else { r2.lo };
                            u128 hi = if (r1.hi < r2.hi) { r1.hi } else { r2.hi };
                            if (lo >= hi)
                            {
                                return Ov::OvNo;
                            }
                        },
                        None     : ov = Ov::OvMaybe,
                    },
                    None : ov = Ov::OvMaybe,
                },
                PElem::PField(_) : ov = Ov::OvMaybe,
                PElem::PSpan(_)  : ov = Ov::OvMaybe,
            },
            // Report 311: `[a .. m]` and `[m .. b]` by one key meet nowhere.
            PElem::PSpan(x) : match (&b[i])
            {
                PElem::PSpan(y) :
                {
                    if (spans_adjacent(x, y))
                    {
                        return Ov::OvNo;
                    }
                    ov = Ov::OvMaybe;
                },
                _               : ov = Ov::OvMaybe,
            },
        }
    }
    // The longer path's remainder: a literal empty range touches nothing;
    // any other range may be empty.
    ref<Vec<PElem>, shared> longer = if (Vec::len(a) > Vec::len(b)) { a } else { b };
    usize from = if (Vec::len(a) > Vec::len(b)) { Vec::len(b) } else { Vec::len(a) };
    for (usize i = from; i < Vec::len(longer); i += 1)
    {
        match (&longer[i])
        {
            // An empty range still meets its container's fields
            // (`conf.empty-slice-meets-vec-fields`) but not always its
            // elements: the run decides.
            PElem::PRange(r) : match (r)
            {
                Some(rl) :
                {
                    if (rl.lo >= rl.hi)
                    {
                        ov = Ov::OvMaybe;
                    }
                },
                None     : ov = Ov::OvMaybe,
            },
            PElem::PSpan(_) : ov = Ov::OvMaybe,
            _               : {},
        }
    }
    ov
}

// A place as a message names it: its root and fields, an element as `[…]`.
fn shown_place(StringView root, ref<Vec<PElem>, shared> path) : String
{
    String out = String::copy(shown_name(root));
    // `(*r)[0 .. 1]`, not `*r[0 .. 1]`.
    if (StringView::starts_with(&out, "*") && Vec::len(path) > 0)
    {
        bool elem = match (&path[0])
        {
            PElem::PField(_) : false,
            _                : true,
        };
        if (elem)
        {
            out = sprintf("(%s)", &out);
        }
    }
    for (usize i = 0; i < Vec::len(path); i += 1)
    {
        match (&path[i])
        {
            PElem::PField(f) :
            {
                String::append(&mut out, ".");
                String::append(&mut out, f);
            },
            PElem::PIndex(x) : match (x)
            {
                Some(v) : String::appendf(&mut out, "[%v]", *v),
                None    : String::append(&mut out, "[…]"),
            },
            PElem::PRange(r) : match (r)
            {
                Some(rl) : String::appendf(&mut out, "[%v .. %v]", rl.lo, rl.hi),
                None     : String::append(&mut out, "[… .. …]"),
            },
            PElem::PSpan(k) : String::appendf(
                &mut out,
                "[%s .. %s]",
                span_bound_shown(&k.lo),
                span_bound_shown(&k.hi),
            ),
        }
    }
    out
}

fn span_bound_shown(ref<String, shared> k) : StringView
{
    if (StringView::len(k) == 0)
    {
        return "…";
    }
    match (StringView::strip_prefix(k, "#"))
    {
        Some(v) : v,
        None    : shown_name(k),
    }
}

// A callee as a message names it: without `std::`.
fn shown_callee(StringView key) : StringView
{
    Option::unwrap_or(StringView::strip_prefix(key, "std::"), key)
}

fn shown_access(Mode m) : str
{
    if (m == Mode::Exclusive) { "writes" } else { "reads" }
}

// ---- D-0290/D-0291 type facts the code generator asks for
// (`keeps_refs_in_data`, `keeps_refs_in_data_by`, `frame_holdable`) ----

// A `fn` value's signature without modes, as `pathless_blocker` collects
// the closures' (`modeless`): what `keeps_refs_in_data_by` tests a
// `Type::TFn` against.
export struct FnSig
{
    export Vec<Type> params;
    export Type ret;
}

// How a `fn` or closure type counts for `keeps_refs_in_data_by`: a fixed
// answer (`keeps_refs_in_data`'s `fn_refs`), or by the signatures.
struct FnRefs
{
    bool by_sigs;
    bool value;
}

// cobc's `modeless`: `t` with every reference and slice made shared.
fn modeless(ref<Type, shared> t) : Type
{
    match (t)
    {
        Type::TRef(b)   : ref_of(modeless(&Box::get(b).inner), Mode::Shared),
        Type::TSlice(b) : slice_of(modeless(&Box::get(b).inner), Mode::Shared),
        Type::TArray(b) : array_of(modeless(&Box::get(b).inner), Box::get(b).n),
        Type::TNamed(b) :
        {
            Vec<Type> args = Vec::new();
            for (usize i = 0; i < Vec::len(&Box::get(b).args); i += 1)
            {
                Vec::push(&mut args, modeless(&Box::get(b).args[i]));
            }
            named(&Box::get(b).name, args)
        },
        Type::TFn(b)    :
        {
            Vec<Type> ps = Vec::new();
            for (usize i = 0; i < Vec::len(&Box::get(b).params); i += 1)
            {
                Vec::push(&mut ps, modeless(&Box::get(b).params[i]));
            }
            fn_of(ps, modeless(&Box::get(b).ret))
        },
        other           : clone(other),
    }
}

fn fn_refs_answer(ref<FnRefs, shared> fr, ref<Vec<FnSig>, shared> sigs, ref<Type, shared> t) : bool
{
    if (!fr.by_sigs)
    {
        return fr.value;
    }
    match (t)
    {
        Type::TFn(b) :
        {
            Vec<Type> ps = Vec::new();
            for (usize i = 0; i < Vec::len(&Box::get(b).params); i += 1)
            {
                Vec::push(&mut ps, modeless(&Box::get(b).params[i]));
            }
            Type r = modeless(&Box::get(b).ret);
            for (usize i = 0; i < Vec::len(sigs); i += 1)
            {
                if (types_eq_list(&sigs[i].params, &ps) && type_eq(&sigs[i].ret, &r))
                {
                    return true;
                }
            }
            false
        },
        _            : Vec::len(sigs) > 0,
    }
}

// D-0281 step 4c: whether a value of type `ty` keeps a reference in data
// -- a field, an element, a payload, a container's cells -- rather than
// being one itself as a frame holds it (a reference, a slice, a view, an
// `Option` or `Result` of one, a `fn` value): tier D, whose conflicts
// only the run's tracking finds. A `fn` value in data counts when
// `fn_refs`: some closure of the program keeps a reference in its
// environment.
export fn keeps_refs_in_data(ref<Items, shared> it, ref<Type, shared> ty, bool fn_refs) : bool
{
    keeps_refs_by(it, ty, &FnRefs { .by_sigs = false, .value = fn_refs }, &Vec::new())
}

// `keeps_refs_in_data`, with `sigs` deciding for each `fn` or closure
// type whether a value of it may keep references (D-0291: whether a
// closure of that signature does).
export fn keeps_refs_in_data_by(ref<Items, shared> it, ref<Type, shared> ty, ref<Vec<FnSig>, shared> sigs) : bool
{
    keeps_refs_by(it, ty, &FnRefs { .by_sigs = true, .value = false }, sigs)
}

fn keeps_refs_by(
    ref<Items, shared> it,
    ref<Type, shared> ty,
    ref<FnRefs, shared> fr,
    ref<Vec<FnSig>, shared> sigs,
) : bool
{
    bool frame_held = match (ty)
    {
        Type::TRef(_)     : true,
        Type::TSlice(_)   : true,
        Type::TClosure(_) : true,
        Type::TFn(_)      : true,
        // D-0289: a thread's handle or a lock's guard held by a frame is
        // the borrows it was formed with, ended by `join`, by `drop` or at
        // the frame's end (spec/19: no thread outlives its handle's frame).
        Type::THandle(b)  : !keeps_in(it, Box::get(b), fr, sigs, &mut new_name_set()),
        Type::TGuard(b)   : !keeps_in(it, Box::get(b), fr, sigs, &mut new_name_set()),
        Type::TNamed(b)   :
        {
            ref<NamedTy, shared> n = Box::get(b);
            // D-0287: `foreach`'s holder of a view's parts, as a view.
            if (n.name == "std::StringView" || n.name == "std::Parts")
            {
                Vec::len(&n.args) == 0
            }
            else if (n.name == "std::Option" || n.name == "std::Result")
            {
                bool first_ref = Vec::len(&n.args) > 0 && is_ref_or_view(&n.args[0]);
                bool rest_plain = true;
                for (usize i = 1; i < Vec::len(&n.args); i += 1)
                {
                    if (keeps_in(it, &n.args[i], fr, sigs, &mut new_name_set()))
                    {
                        rest_plain = false;
                    }
                }
                first_ref && rest_plain
            }
            else
            {
                false
            }
        },
        _                 : false,
    };
    if (frame_held)
    {
        return false;
    }
    keeps_in(it, ty, fr, sigs, &mut new_name_set())
}

// A reference, a slice, or a `StringView`.
fn is_ref_or_view(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(_)   : true,
        Type::TSlice(_) : true,
        _               : named_is(t, "std::StringView"),
    }
}

fn keeps_in(
    ref<Items, shared> it,
    ref<Type, shared> t,
    ref<FnRefs, shared> fr,
    ref<Vec<FnSig>, shared> sigs,
    ref<HashSet<String>, exclusive> seen,
) : bool
{
    match (t)
    {
        Type::TRef(_)     : true,
        Type::TSlice(_)   : true,
        Type::TGuard(_)   : true,
        // D-0289: a handle in data lends nothing (a spawn that lends has a
        // binding of the frame hold its handle, or is the run's), so it
        // keeps only what its result does.
        Type::THandle(b)  : keeps_in(it, Box::get(b), fr, sigs, seen),
        Type::TClosure(_) : fn_refs_answer(fr, sigs, t),
        Type::TFn(_)      : fn_refs_answer(fr, sigs, t),
        Type::TArray(b)   : keeps_in(it, &Box::get(b).inner, fr, sigs, seen),
        Type::TRawptr(b)  : keeps_in(it, Box::get(b), fr, sigs, seen),
        Type::TMutex(b)   : keeps_in(it, Box::get(b), fr, sigs, seen),
        Type::TNamed(b)   :
        {
            if (is_borrow_ty(t))
            {
                return true;
            }
            if (!HashSet::insert(seen, type_code(t)))
            {
                return false;
            }
            ref<NamedTy, shared> n = Box::get(b);
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (keeps_in(it, &n.args[i], fr, sigs, seen))
                {
                    return true;
                }
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        if (keeps_in(it, &apply_subst(&s.fields[i].ty, &subst), fr, sigs, seen))
                        {
                            return true;
                        }
                    }
                    return false;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) :
                            {
                                if (keeps_in(it, &apply_subst(p, &subst), fr, sigs, seen))
                                {
                                    return true;
                                }
                            },
                            None    : {},
                        }
                    }
                    false
                },
                None    : false,
            }
        },
        _                 : false,
    }
}

// D-0282: whether storage of type `ty` keeps references: in itself, or
// as a container's elements (`Vec<ref<T>>`, whose cells sit behind a raw
// pointer `holds_ref` does not follow).
fn stores_refs(ref<Items, shared> it, ref<Type, shared> ty) : bool
{
    holds_stores(it, ty).stores
}

// `holds_ref` and `stores_refs` of a type, found in one walk (bug 044: each
// level of `Option<Option<…>>` asked `holds_ref` of the whole type below it).
struct HoldsStores
{
    bool holds;
    bool stores;
}

fn holds_stores(ref<Items, shared> it, ref<Type, shared> ty) : HoldsStores
{
    match (ty)
    {
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            Vec<HoldsStores> parts = Vec::new();
            bool stores = false;
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                HoldsStores p = holds_stores(it, &n.args[i]);
                stores = stores || p.stores;
                Vec::push(&mut parts, p);
            }
            // `holds_ref`, with the arguments' answers.
            bool holds = match (HashMap::get(&it.ref_info, &n.name))
            {
                Some(r) :
                {
                    if (!r.exact || Vec::len(&n.args) != r.arity)
                    {
                        any_part(it, ty, 2)
                    }
                    else if (r.own)
                    {
                        true
                    }
                    else
                    {
                        bool any = false;
                        for (usize k = 0; k < Vec::len(&r.params) && !any; k += 1)
                        {
                            any = parts[r.params[k]].holds;
                        }
                        any
                    }
                },
                None    : false,
            };
            HoldsStores { .holds = holds, .stores = holds || stores }
        },
        Type::TArray(b) : holds_stores(it, &Box::get(b).inner),
        _               :
        {
            bool holds = holds_ref(it, ty);
            HoldsStores { .holds = holds, .stores = is_borrow_ty(ty) || holds }
        },
    }
}

// D-0289: whether a value of type `t` holds a thread's handle.
fn holds_handle(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::THandle(_) : true,
        Type::TArray(b)  : holds_handle(&Box::get(b).inner),
        Type::TNamed(b)  :
        {
            ref<Vec<Type>, shared> args = &Box::get(b).args;
            for (usize i = 0; i < Vec::len(args); i += 1)
            {
                if (holds_handle(&args[i]))
                {
                    return true;
                }
            }
            false
        },
        _                : false,
    }
}

// D-0289: whether a value of type `t` holds a lock's guard.
fn holds_guard(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TGuard(_) : true,
        Type::TArray(b) : holds_guard(&Box::get(b).inner),
        Type::TNamed(b) :
        {
            ref<Vec<Type>, shared> args = &Box::get(b).args;
            for (usize i = 0; i < Vec::len(args); i += 1)
            {
                if (holds_guard(&args[i]))
                {
                    return true;
                }
            }
            false
        },
        _               : false,
    }
}

// D-0290: whether a value of type `t` holds no `fn` value, guard, lock or
// thread handle anywhere (a field, a payload, a type argument).
fn holder_free(ref<Items, shared> it, ref<Type, shared> t, ref<HashSet<String>, exclusive> seen) : bool
{
    match (t)
    {
        Type::TFn(_)      : false,
        Type::TClosure(_) : false,
        Type::TGuard(_)   : false,
        Type::TMutex(_)   : false,
        Type::THandle(_)  : false,
        Type::TArray(b)   : holder_free(it, &Box::get(b).inner, seen),
        Type::TRef(b)     : holder_free(it, &Box::get(b).inner, seen),
        Type::TSlice(b)   : holder_free(it, &Box::get(b).inner, seen),
        Type::TRawptr(b)  : holder_free(it, Box::get(b), seen),
        Type::TNamed(b)   :
        {
            if (!HashSet::insert(seen, type_code(t)))
            {
                return true;
            }
            ref<NamedTy, shared> n = Box::get(b);
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (!holder_free(it, &n.args[i], seen))
                {
                    return false;
                }
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        if (!holder_free(it, &apply_subst(&s.fields[i].ty, &subst), seen))
                        {
                            return false;
                        }
                    }
                    return true;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) :
                            {
                                if (!holder_free(it, &apply_subst(p, &subst), seen))
                                {
                                    return false;
                                }
                            },
                            None    : {},
                        }
                    }
                    true
                },
                None    : true,
            }
        },
        _                 : true,
    }
}

// D-0290: the kinds of reference a value of type `t` keeps, by what they
// refer to (`(false, T)` for `ref<T, _>`, `(true, T)` for `slice<T, _>`; a
// `StringView` keeps a `slice<u8>`): what a value given to a call can be
// stored as in data of another type. A leaf is coded `r:` or `s:` and the
// referent's `type_code`.
fn ref_leaf(bool as_slice, ref<Type, shared> t) : String
{
    sprintf("%s%s", if (as_slice) { "s:" } else { "r:" }, &type_code(t))
}

fn ref_leaves(
    ref<Items, shared> it,
    ref<Type, shared> t,
    ref<HashSet<String>, exclusive> out,
    ref<HashSet<String>, exclusive> seen,
)
{
    match (t)
    {
        // What is kept through a reference can be copied out of it too.
        Type::TRef(b)    :
        {
            HashSet::insert(out, ref_leaf(false, &Box::get(b).inner));
            ref_leaves(it, &Box::get(b).inner, out, seen);
        },
        Type::TSlice(b)  :
        {
            HashSet::insert(out, ref_leaf(true, &Box::get(b).inner));
            ref_leaves(it, &Box::get(b).inner, out, seen);
        },
        Type::TArray(b)  : ref_leaves(it, &Box::get(b).inner, out, seen),
        Type::TRawptr(b) : ref_leaves(it, Box::get(b), out, seen),
        Type::TNamed(b)  :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (n.name == "std::StringView" && Vec::len(&n.args) == 0)
            {
                HashSet::insert(out, ref_leaf(true, &Type::TInt(IntTy::U8)));
                return;
            }
            if (!HashSet::insert(seen, type_code(t)))
            {
                return;
            }
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                ref_leaves(it, &n.args[i], out, seen);
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        ref_leaves(it, &apply_subst(&s.fields[i].ty, &subst), out, seen);
                    }
                    return;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) : ref_leaves(it, &apply_subst(p, &subst), out, seen),
                            None    : {},
                        }
                    }
                },
                None    : {},
            }
        },
        _                : {},
    }
}

// D-0290: whether a value of type `t` reaches an exclusive reference
// through a shared one (`ref<ref<T, exclusive>, shared>`, a shared
// reference to a struct keeping one): a thread lent it reads through a
// path its lender's thread holds exclusively, which the run checks.
fn excl_under_shared(
    ref<Items, shared> it,
    ref<Type, shared> t,
    bool under,
    ref<HashSet<String>, exclusive> seen,
) : bool
{
    match (t)
    {
        Type::TRef(b)    :
        {
            if (under && Box::get(b).mode == Mode::Exclusive)
            {
                return true;
            }
            excl_under_shared(it, &Box::get(b).inner, under || Box::get(b).mode == Mode::Shared, seen)
        },
        Type::TSlice(b)  :
        {
            if (under && Box::get(b).mode == Mode::Exclusive)
            {
                return true;
            }
            excl_under_shared(it, &Box::get(b).inner, under || Box::get(b).mode == Mode::Shared, seen)
        },
        Type::TArray(b)  : excl_under_shared(it, &Box::get(b).inner, under, seen),
        Type::TRawptr(b) : excl_under_shared(it, Box::get(b), under, seen),
        Type::TNamed(b)  :
        {
            if (!HashSet::insert(seen, sprintf("%s%s", if (under) { "u" } else { "n" }, &type_code(t))))
            {
                return false;
            }
            ref<NamedTy, shared> n = Box::get(b);
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (excl_under_shared(it, &n.args[i], under, seen))
                {
                    return true;
                }
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        if (excl_under_shared(it, &apply_subst(&s.fields[i].ty, &subst), under, seen))
                        {
                            return true;
                        }
                    }
                    return false;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) :
                            {
                                if (excl_under_shared(it, &apply_subst(p, &subst), under, seen))
                                {
                                    return true;
                                }
                            },
                            None    : {},
                        }
                    }
                    false
                },
                None    : false,
            }
        },
        _                : false,
    }
}

// D-0290: whether a value of type `t` may be held by a frame as a holder
// of the references it keeps (no `fn` value, guard, lock or handle).
export fn frame_holdable(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    holder_free(it, t, &mut new_name_set())
}

// D-0291: the spawns whose handle `e`'s value is, or wraps in `Some`,
// through a `match`'s arms, an `if`'s branches and a block's tail; and
// whether every path that gives a value gives one of them (an arm that
// leaves by `return`, `break` or `continue` gives none).
struct TailSite
{
    String key;
    usize line;
}

fn tail_spawn_sites(ref<Expr, shared> e0, ref<Vec<TailSite>, exclusive> out) : bool
{
    ref<Expr, shared> e = strip_parens_tc(e0);
    match (&e.kind)
    {
        ExprKind::ECall(cb)   :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            if (is_spawn_call(e))
            {
                Vec::push(out, TailSite { .key = site_key(c.callee.line, c.callee.col), .line = c.callee.line });
                return true;
            }
            bool some = match (path_segs(&c.callee))
            {
                Some(segs) : Vec::len(segs) > 0 && segs[Vec::len(segs) - 1] == "Some",
                None       : false,
            };
            if (Vec::len(&c.args) == 1 && some)
            {
                return tail_spawn_sites(&c.args[0], out);
            }
            tss_leaves(e)
        },
        ExprKind::EMatch(mb)  :
        {
            bool all = true;
            ref<Vec<Arm>, shared> arms = &Box::get(mb).arms;
            for (usize i = 0; i < Vec::len(arms); i += 1)
            {
                bool one = tail_spawn_sites(Box::get(&arms[i].body), out);
                all = one && all;
            }
            all
        },
        ExprKind::EIf(ib)     :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            match (&x.else_)
            {
                Some(f) :
                {
                    bool t = tss_block(&x.then_, out);
                    bool fl = tail_spawn_sites(f, out);
                    t && fl
                },
                None    : tss_leaves(e),
            }
        },
        ExprKind::EBlock(blk) : tss_block(blk, out),
        _                     : tss_leaves(e),
    }
}

fn tss_block(ref<Block, shared> b, ref<Vec<TailSite>, exclusive> out) : bool
{
    match (&b.tail)
    {
        Some(t) : tail_spawn_sites(Box::get(t), out),
        None    :
        {
            usize n = Vec::len(&b.stmts);
            if (n == 0)
            {
                return false;
            }
            match (&b.stmts[n - 1])
            {
                Stmt::SExpr(e)      : tss_leaves(Box::get(e)),
                Stmt::SBlockLike(e) : tss_leaves(Box::get(e)),
                _                   : false,
            }
        },
    }
}

fn tss_leaves(ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EReturn(_) : true,
        ExprKind::EBreak     : true,
        ExprKind::EContinue  : true,
        _                    : false,
    }
}

// The `m` for which `s` is `m = e;` with `e` not reading `m`
// (`stmt_overwrites`), if any.
fn overwritten_name(ref<Stmt, shared> s) : Option<String>
{
    ref<Expr, shared> e = match (s)
    {
        Stmt::SExpr(e) : Box::get(e),
        _              : return None,
    };
    ref<PairExpr, shared> p = match (&strip_parens_tc(e).kind)
    {
        ExprKind::EAssign(pb) : Box::get(pb),
        _                     : return None,
    };
    match (one_seg(strip_parens_tc(&p.a)))
    {
        Some(m) : if (stmt_overwrites(s, m)) { Some(String::clone(m)) } else { None },
        None    : None,
    }
}

// Whether `s` is `m = e;` with `e` not reading `m`: it ends what `m` held.
fn stmt_overwrites(ref<Stmt, shared> s, ref<String, shared> m) : bool
{
    ref<Expr, shared> e = match (s)
    {
        Stmt::SExpr(e) : Box::get(e),
        _              : return false,
    };
    ref<PairExpr, shared> p = match (&strip_parens_tc(e).kind)
    {
        ExprKind::EAssign(pb) : Box::get(pb),
        _                     : return false,
    };
    bool lhs_is_m = match (one_seg(strip_parens_tc(&p.a)))
    {
        Some(n) : (*n == *m),
        None    : false,
    };
    if (!lhs_is_m)
    {
        return false;
    }
    HashSet<String> free = HashSet::new();
    HashSet<String> bound = HashSet::new();
    collect_free_vars_expr(&p.b, &mut bound, &mut free);
    !HashSet::contains(&free, m)
}

// Whether `s` may leave its block other than by running to its end: a
// `break`, `continue`, `return` or `?` anywhere in it.
fn stmt_may_leave(ref<Stmt, shared> s) : bool
{
    match (s)
    {
        Stmt::SLet(l) : match (&Box::get(l).init)
        {
            Some(e) : has_leave(e),
            None    : false,
        },
        Stmt::SDestructure(d) : has_leave(&Box::get(d).init),
        Stmt::SExpr(e)        : has_leave(Box::get(e)),
        Stmt::SBlockLike(e)   : has_leave(Box::get(e)),
    }
}

fn has_leave_block(ref<Block, shared> b) : bool
{
    for (usize i = 0; i < Vec::len(&b.stmts); i += 1)
    {
        if (stmt_may_leave(&b.stmts[i]))
        {
            return true;
        }
    }
    match (&b.tail)
    {
        Some(t) : has_leave(Box::get(t)),
        None    : false,
    }
}

// Whether `e` holds a `break`, `continue`, `return` or `?` (closures'
// bodies included).
fn has_leave(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EBreak          : true,
        ExprKind::EContinue       : true,
        ExprKind::EReturn(_)      : true,
        ExprKind::EPropagate(_)   : true,
        ExprKind::EUnary(u)       : has_leave(&Box::get(u).e),
        ExprKind::EBorrow(b)      : has_leave(&Box::get(b).e),
        ExprKind::EDeref(a)       : has_leave(Box::get(a)),
        ExprKind::EField(f)       : has_leave(&Box::get(f).e),
        ExprKind::EParen(a)       : has_leave(Box::get(a)),
        ExprKind::EBinary(bb)     : has_leave(&Box::get(bb).a) || has_leave(&Box::get(bb).b),
        ExprKind::EIndex(p)       : has_leave(&Box::get(p).a) || has_leave(&Box::get(p).b),
        ExprKind::EAssign(p)      : has_leave(&Box::get(p).a) || has_leave(&Box::get(p).b),
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            if (has_leave(&c.callee))
            {
                return true;
            }
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                if (has_leave(&c.args[i]))
                {
                    return true;
                }
            }
            false
        },
        ExprKind::EStructLit(sl)  :
        {
            ref<Vec<FieldInit>, shared> fs = &Box::get(sl).fields;
            for (usize i = 0; i < Vec::len(fs); i += 1)
            {
                if (has_leave(&fs[i].value))
                {
                    return true;
                }
            }
            false
        },
        ExprKind::EArrayLit(xs)   :
        {
            for (usize i = 0; i < Vec::len(xs); i += 1)
            {
                if (has_leave(&xs[i]))
                {
                    return true;
                }
            }
            false
        },
        ExprKind::EArrayRepeat(r) : has_leave(&Box::get(r).value),
        ExprKind::ESliceOf(sb)    : has_leave(&Box::get(sb).base) || has_leave(&Box::get(sb).lo) || has_leave(&Box::get(sb).hi),
        ExprKind::EBlock(b)       : has_leave_block(b),
        ExprKind::EUnsafe(b)      : has_leave_block(b),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            has_leave(&x.cond) || has_leave_block(&x.then_) || match (&x.else_)
            {
                Some(e2) : has_leave(e2),
                None     : false,
            }
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            has_leave(&x.cond) || has_leave_block(&x.body) || match (&x.step)
            {
                Some(st) : has_leave(st),
                None     : false,
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> m = Box::get(mb);
            if (has_leave(&m.scrut))
            {
                return true;
            }
            for (usize i = 0; i < Vec::len(&m.arms); i += 1)
            {
                if (has_leave(Box::get(&m.arms[i].body)))
                {
                    return true;
                }
            }
            false
        },
        ExprKind::EClosure(cb)    : has_leave_block(&Box::get(cb).body),
        _                         : false,
    }
}

fn is_closure(ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EClosure(_) : true,
        _                     : false,
    }
}

// ---- walks over every expression of an expression (one for each of the
// three uses in `tier_call_rule`), and the exclusive borrows in one ----

// The single names assigned anywhere in `e` (`x = …`).
fn assigned_names(ref<Expr, shared> e, ref<Vec<String>, exclusive> out)
{
    match (&e.kind)
    {
        ExprKind::EAssign(pb) :
        {
            match (one_seg(strip_parens_tc(&Box::get(pb).a)))
            {
                Some(n) : Vec::push(out, String::clone(n)),
                None    : {},
            }
        },
        _                     : {},
    }
    Vec<String> none = Vec::new();
    bool dummy = false;
    ve_children(e, 0, out, &none, &mut dummy);
}

// Whether `e` borrows a place rooted at one of `names` (`&y`, `&y.f[i]`).
fn borrows_one_of(ref<Expr, shared> e, ref<Vec<String>, shared> names) : bool
{
    bool found = false;
    Vec<String> sink = Vec::new();
    ve_visit(e, 3, &mut sink, names, &mut found);
    found
}

// Whether a single-name path in `e` names one of `names`.
fn mentions_one_of(ref<Expr, shared> e, ref<Vec<String>, shared> names) : bool
{
    bool found = false;
    Vec<String> sink = Vec::new();
    ve_visit(e, 1, &mut sink, names, &mut found);
    found
}

// `tier_call_rule`'s `acts`: an assignment whose root local is one of
// `roots`, or a call given one of them by name.
fn acts_on(ref<Expr, shared> e, ref<Vec<String>, shared> roots) : bool
{
    bool found = false;
    Vec<String> sink = Vec::new();
    ve_visit(e, 2, &mut sink, roots, &mut found);
    found
}

// One visit: `which` 0 collects assigned names into `out`, 1 tests the
// paths against `names`, 2 tests `acts_on`, 3 `borrows_one_of`, 4 collects
// the bindings written into `out` (`push_block_locals`).
fn ve_visit(
    ref<Expr, shared> e,
    u8 which,
    ref<Vec<String>, exclusive> out,
    ref<Vec<String>, shared> names,
    ref<bool, exclusive> found,
)
{
    if (which == 0)
    {
        match (&e.kind)
        {
            ExprKind::EAssign(pb) :
            {
                match (one_seg(strip_parens_tc(&Box::get(pb).a)))
                {
                    Some(n) : Vec::push(out, String::clone(n)),
                    None    : {},
                }
            },
            _                     : {},
        }
    }
    else if (which == 1)
    {
        match (one_seg(e))
        {
            Some(n) :
            {
                if (Vec::contains(names, n))
                {
                    *found = true;
                }
            },
            None    : {},
        }
    }
    else if (which == 4)
    {
        // The bindings `e` may write: an assignment's root (through fields
        // and elements), an exclusive borrow's, a capture without `move`.
        Option<ref<Expr, shared>> place = match (&e.kind)
        {
            ExprKind::EAssign(pb)  : Some(&Box::get(pb).a),
            ExprKind::EBorrow(bb)  : if (Box::get(bb).mode == Mode::Exclusive) { Some(&Box::get(bb).e) } else { None },
            ExprKind::ESliceOf(sb) : if (Box::get(sb).mode == Mode::Exclusive) { Some(&Box::get(sb).base) } else { None },
            _                      : None,
        };
        match (place)
        {
            Some(p0) :
            {
                ref<Expr, shared> r = strip_parens_tc(p0);
                bool walking = true;
                while (walking)
                {
                    match (&r.kind)
                    {
                        ExprKind::EField(f) : r = strip_parens_tc(&Box::get(f).e),
                        ExprKind::EIndex(x) : r = strip_parens_tc(&Box::get(x).a),
                        _                   : walking = false,
                    }
                }
                match (one_seg(r))
                {
                    Some(n) : Vec::push(out, String::clone(n)),
                    None    : {},
                }
            },
            None     : {},
        }
        match (&e.kind)
        {
            ExprKind::EClosure(cb) :
            {
                if (!Box::get(cb).is_move)
                {
                    for (usize i = 0; i < Vec::len(&Box::get(cb).captures); i += 1)
                    {
                        Vec::push(out, String::clone(&Box::get(cb).captures[i]));
                    }
                }
            },
            _                      : {},
        }
    }
    else if (which == 5)
    {
        // Report 311: the root of every borrow, shared or exclusive.
        Option<ref<Expr, shared>> place = match (&e.kind)
        {
            ExprKind::EBorrow(bb)  : Some(&Box::get(bb).e),
            ExprKind::ESliceOf(sb) : Some(&Box::get(sb).base),
            _                      : None,
        };
        match (place)
        {
            Some(p0) :
            {
                ref<Expr, shared> r = strip_parens_tc(p0);
                bool walking = true;
                while (walking)
                {
                    match (&r.kind)
                    {
                        ExprKind::EField(f) : r = strip_parens_tc(&Box::get(f).e),
                        ExprKind::EIndex(x) : r = strip_parens_tc(&Box::get(x).a),
                        _                   : walking = false,
                    }
                }
                match (one_seg(r))
                {
                    Some(n) : Vec::push(out, String::clone(n)),
                    None    : {},
                }
            },
            None     : {},
        }
    }
    else if (which == 3)
    {
        // A borrow whose place is rooted (through fields and elements) at one
        // of `names`.
        Option<ref<Expr, shared>> place = match (&e.kind)
        {
            ExprKind::EBorrow(bb)  : Some(&Box::get(bb).e),
            ExprKind::ESliceOf(sb) : Some(&Box::get(sb).base),
            _                      : None,
        };
        match (place)
        {
            Some(p0) :
            {
                ref<Expr, shared> r = strip_parens_tc(p0);
                bool walking = true;
                while (walking)
                {
                    match (&r.kind)
                    {
                        ExprKind::EField(f) : r = strip_parens_tc(&Box::get(f).e),
                        ExprKind::EIndex(x) : r = strip_parens_tc(&Box::get(x).a),
                        _                   : walking = false,
                    }
                }
                match (one_seg(r))
                {
                    Some(n) :
                    {
                        if (Vec::contains(names, n))
                        {
                            *found = true;
                        }
                    },
                    None    : {},
                }
            },
            None     : {},
        }
    }
    else
    {
        match (&e.kind)
        {
            ExprKind::EAssign(pb) : match (root_local_name(&Box::get(pb).a))
            {
                Some(r) :
                {
                    if (Vec::contains(names, &r))
                    {
                        *found = true;
                    }
                },
                None    : {},
            },
            ExprKind::ECall(cb) :
            {
                ref<Vec<Expr>, shared> xs = &Box::get(cb).args;
                for (usize i = 0; i < Vec::len(xs); i += 1)
                {
                    match (one_seg(strip_parens_tc(&xs[i])))
                    {
                        Some(n) :
                        {
                            if (Vec::contains(names, n))
                            {
                                *found = true;
                            }
                        },
                        None    : {},
                    }
                }
            },
            _                   : {},
        }
    }
    ve_children(e, which, out, names, found);
}

fn ve_block(
    ref<Block, shared> b,
    u8 which,
    ref<Vec<String>, exclusive> out,
    ref<Vec<String>, shared> names,
    ref<bool, exclusive> found,
)
{
    for (usize i = 0; i < Vec::len(&b.stmts); i += 1)
    {
        match (&b.stmts[i])
        {
            Stmt::SExpr(x)        : ve_visit(Box::get(x), which, out, names, found),
            Stmt::SBlockLike(x)   : ve_visit(Box::get(x), which, out, names, found),
            Stmt::SLet(l) : match (&Box::get(l).init)
            {
                Some(x) : ve_visit(x, which, out, names, found),
                None    : {},
            },
            Stmt::SDestructure(d) : ve_visit(&Box::get(d).init, which, out, names, found),
        }
    }
    match (&b.tail)
    {
        Some(t) : ve_visit(Box::get(t), which, out, names, found),
        None    : {},
    }
}

fn ve_children(
    ref<Expr, shared> e,
    u8 which,
    ref<Vec<String>, exclusive> out,
    ref<Vec<String>, shared> names,
    ref<bool, exclusive> found,
)
{
    match (&e.kind)
    {
        ExprKind::EParen(x)       : ve_visit(Box::get(x), which, out, names, found),
        ExprKind::EUnary(u)       : ve_visit(&Box::get(u).e, which, out, names, found),
        ExprKind::EDeref(x)       : ve_visit(Box::get(x), which, out, names, found),
        ExprKind::EField(f)       : ve_visit(&Box::get(f).e, which, out, names, found),
        ExprKind::EBorrow(bb)     : ve_visit(&Box::get(bb).e, which, out, names, found),
        ExprKind::EPropagate(x)   : ve_visit(Box::get(x), which, out, names, found),
        ExprKind::EArrayRepeat(r) : ve_visit(&Box::get(r).value, which, out, names, found),
        ExprKind::EReturn(v) : match (v)
        {
            Some(x) : ve_visit(Box::get(x), which, out, names, found),
            None    : {},
        },
        ExprKind::ESliceOf(sb)    :
        {
            ref<SliceExpr, shared> s = Box::get(sb);
            ve_visit(&s.base, which, out, names, found);
            ve_visit(&s.lo, which, out, names, found);
            ve_visit(&s.hi, which, out, names, found);
        },
        ExprKind::EBinary(bb)     :
        {
            ve_visit(&Box::get(bb).a, which, out, names, found);
            ve_visit(&Box::get(bb).b, which, out, names, found);
        },
        ExprKind::EIndex(pb)      :
        {
            ve_visit(&Box::get(pb).a, which, out, names, found);
            ve_visit(&Box::get(pb).b, which, out, names, found);
        },
        ExprKind::EAssign(pb)     :
        {
            ve_visit(&Box::get(pb).a, which, out, names, found);
            ve_visit(&Box::get(pb).b, which, out, names, found);
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            ve_visit(&c.callee, which, out, names, found);
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                ve_visit(&c.args[i], which, out, names, found);
            }
        },
        ExprKind::EArrayLit(xs)   :
        {
            for (usize i = 0; i < Vec::len(xs); i += 1)
            {
                ve_visit(&xs[i], which, out, names, found);
            }
        },
        ExprKind::EStructLit(sl)  :
        {
            ref<Vec<FieldInit>, shared> fs = &Box::get(sl).fields;
            for (usize i = 0; i < Vec::len(fs); i += 1)
            {
                ve_visit(&fs[i].value, which, out, names, found);
            }
        },
        ExprKind::EBlock(b)       : ve_block(b, which, out, names, found),
        ExprKind::EUnsafe(b)      : ve_block(b, which, out, names, found),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            ve_visit(&x.cond, which, out, names, found);
            ve_block(&x.then_, which, out, names, found);
            match (&x.else_)
            {
                Some(e2) : ve_visit(e2, which, out, names, found),
                None     : {},
            }
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            ve_visit(&x.cond, which, out, names, found);
            ve_block(&x.body, which, out, names, found);
            match (&x.step)
            {
                Some(st) : ve_visit(st, which, out, names, found),
                None     : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> m = Box::get(mb);
            ve_visit(&m.scrut, which, out, names, found);
            for (usize i = 0; i < Vec::len(&m.arms); i += 1)
            {
                ve_visit(Box::get(&m.arms[i].body), which, out, names, found);
            }
        },
        ExprKind::EClosure(cb)    : ve_block(&Box::get(cb).body, which, out, names, found),
        _                         : {},
    }
}

// The exclusive borrows written in `e` (`&mut x`, `&mut x[a..b]`), for the
// D-0282 order rules.
fn excl_borrows_in(ref<Expr, shared> e, ref<Vec<Expr>, exclusive> out)
{
    match (&e.kind)
    {
        ExprKind::EBorrow(bb)     :
        {
            // An exclusive borrow is taken whole, its operand not looked
            // into; a shared one is walked through.
            if (Box::get(bb).mode == Mode::Exclusive)
            {
                Vec::push(out, clone(e));
            }
            else
            {
                excl_borrows_in(&Box::get(bb).e, out);
            }
        },
        ExprKind::ESliceOf(sb)    :
        {
            ref<SliceExpr, shared> s = Box::get(sb);
            if (s.mode == Mode::Exclusive)
            {
                Vec::push(
                    out,
                    mk(
                        ExprKind::EBorrow(Box::new(BorrowExpr { .mode = Mode::Exclusive, .e = clone(&s.base) })),
                        e.line,
                        e.col,
                    ),
                );
            }
            excl_borrows_in(&s.base, out);
            excl_borrows_in(&s.lo, out);
            excl_borrows_in(&s.hi, out);
        },
        ExprKind::EParen(x)       : excl_borrows_in(Box::get(x), out),
        ExprKind::EUnary(u)       : excl_borrows_in(&Box::get(u).e, out),
        ExprKind::EDeref(x)       : excl_borrows_in(Box::get(x), out),
        ExprKind::EField(f)       : excl_borrows_in(&Box::get(f).e, out),
        ExprKind::EPropagate(x)   : excl_borrows_in(Box::get(x), out),
        ExprKind::EArrayRepeat(r) : excl_borrows_in(&Box::get(r).value, out),
        ExprKind::EReturn(v) : match (v)
        {
            Some(x) : excl_borrows_in(Box::get(x), out),
            None    : {},
        },
        ExprKind::EBinary(bb)     :
        {
            excl_borrows_in(&Box::get(bb).a, out);
            excl_borrows_in(&Box::get(bb).b, out);
        },
        ExprKind::EIndex(pb)      :
        {
            excl_borrows_in(&Box::get(pb).a, out);
            excl_borrows_in(&Box::get(pb).b, out);
        },
        ExprKind::EAssign(pb)     :
        {
            excl_borrows_in(&Box::get(pb).a, out);
            excl_borrows_in(&Box::get(pb).b, out);
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            excl_borrows_in(&c.callee, out);
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                excl_borrows_in(&c.args[i], out);
            }
        },
        ExprKind::EArrayLit(xs)   :
        {
            for (usize i = 0; i < Vec::len(xs); i += 1)
            {
                excl_borrows_in(&xs[i], out);
            }
        },
        ExprKind::EStructLit(sl)  :
        {
            ref<Vec<FieldInit>, shared> fs = &Box::get(sl).fields;
            for (usize i = 0; i < Vec::len(fs); i += 1)
            {
                excl_borrows_in(&fs[i].value, out);
            }
        },
        ExprKind::EBlock(b)       : excl_borrows_block(b, out),
        ExprKind::EUnsafe(b)      : excl_borrows_block(b, out),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            excl_borrows_in(&x.cond, out);
            excl_borrows_block(&x.then_, out);
            match (&x.else_)
            {
                Some(f) : excl_borrows_in(f, out),
                None    : {},
            }
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            excl_borrows_in(&x.cond, out);
            excl_borrows_block(&x.body, out);
            match (&x.step)
            {
                Some(st) : excl_borrows_in(st, out),
                None     : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> m = Box::get(mb);
            excl_borrows_in(&m.scrut, out);
            for (usize i = 0; i < Vec::len(&m.arms); i += 1)
            {
                excl_borrows_in(Box::get(&m.arms[i].body), out);
            }
        },
        _                         : {},
    }
}

fn excl_borrows_block(ref<Block, shared> b, ref<Vec<Expr>, exclusive> out)
{
    for (usize i = 0; i < Vec::len(&b.stmts); i += 1)
    {
        match (&b.stmts[i])
        {
            Stmt::SExpr(x)        : excl_borrows_in(Box::get(x), out),
            Stmt::SBlockLike(x)   : excl_borrows_in(Box::get(x), out),
            Stmt::SLet(l) : match (&Box::get(l).init)
            {
                Some(x) : excl_borrows_in(x, out),
                None    : {},
            },
            Stmt::SDestructure(d) : excl_borrows_in(&Box::get(d).init, out),
        }
    }
    match (&b.tail)
    {
        Some(t) : excl_borrows_in(Box::get(t), out),
        None    : {},
    }
}

// Two paths overlap iff one is a prefix of the other, literal indices
// compared by value, a non-literal index overlapping every index.
// Report 313: whether the access is in a loop the holder `h` is declared
// outside of: what `h` holds may be a thread lent on an earlier round.
// (A handle that may lend on some paths only, joined in one branch, is
// still the run's: `conf.spawn-join-in-branch-dynamic`.)
fn held_across_rounds(ref<Body, shared> b, ref<String, shared> h) : bool
{
    if (Vec::len(&b.loop_marks) == 0)
    {
        return false;
    }
    usize mark = b.loop_marks[Vec::len(&b.loop_marks) - 1];
    match (HashMap::get(&b.decl_block, h))
    {
        Some(db) : *db == mark || strictly_encloses(b, *db, mark),
        None     : false,
    }
}

fn paths_overlap(ref<Vec<PElem>, shared> a, ref<Vec<PElem>, shared> b) : bool
{
    for (usize i = 0; i < Vec::len(a) && i < Vec::len(b); i += 1)
    {
        match (&a[i])
        {
            PElem::PField(f) : match (&b[i])
            {
                PElem::PField(g) :
                {
                    if (*f != *g)
                    {
                        return false;
                    }
                },
                _                : return false,
            },
            PElem::PIndex(x) : match (&b[i])
            {
                PElem::PIndex(y) :
                {
                    match (x)
                    {
                        Some(p) : match (y)
                        {
                            Some(q) :
                            {
                                if (*p != *q)
                                {
                                    return false;
                                }
                            },
                            None    : {},
                        },
                        None : {},
                    }
                },
                PElem::PRange(r) :
                {
                    match (x)
                    {
                        Some(p) : match (r)
                        {
                            Some(rl) :
                            {
                                if (!(rl.lo <= *p && *p < rl.hi))
                                {
                                    return false;
                                }
                            },
                            None     : return false,
                        },
                        None : return false,
                    }
                },
                _                : return false,
            },
            PElem::PRange(r) : match (&b[i])
            {
                PElem::PIndex(y) :
                {
                    match (r)
                    {
                        Some(rl) : match (y)
                        {
                            Some(q) :
                            {
                                if (!(rl.lo <= *q && *q < rl.hi))
                                {
                                    return false;
                                }
                            },
                            None    : return false,
                        },
                        None : return false,
                    }
                },
                PElem::PRange(s) :
                {
                    match (r)
                    {
                        Some(r1) : match (s)
                        {
                            Some(r2) :
                            {
                                u128 lo = if (r1.lo > r2.lo) { r1.lo } else { r2.lo };
                                u128 hi = if (r1.hi < r2.hi) { r1.hi } else { r2.hi };
                                if (lo >= hi)
                                {
                                    return false;
                                }
                            },
                            None     : return false,
                        },
                        None : return false,
                    }
                },
                _                : return false,
            },
            PElem::PSpan(_) : return false,
        }
    }
    true
}

// D-0071: the referent of a reference or guard binding `r` is a root of
// its own, `*r`.
fn referent_root(StringView r) : String
{
    sprintf("*%s", r)
}

// The binding a root belongs to: `r` for `*r`.
fn root_binding(StringView root) : StringView
{
    Option::unwrap_or(StringView::strip_prefix(root, "*"), root)
}

// `deriv(r, x.π, m)`: `r` holds a reference derived from `x`'s object at
// path `π` with mode `m`.
struct DerivKey
{
    String root;
    Vec<PElem> path;
    Mode mode;
}

// A `DerivKey` as a map key: its parts, written out exactly.
fn deriv_code(ref<DerivKey, shared> k) : String
{
    String o = sprintf("%v:%s|", StringView::len(&k.root), &k.root);
    for (usize i = 0; i < Vec::len(&k.path); i += 1)
    {
        match (&k.path[i])
        {
            PElem::PField(f) : String::appendf(&mut o, "f%v:%s", StringView::len(f), f),
            PElem::PIndex(x) : match (x)
            {
                Some(v) : String::appendf(&mut o, "i%v;", *v),
                None    : String::append(&mut o, "i?;"),
            },
            PElem::PRange(r) : match (r)
            {
                Some(rl) : String::appendf(&mut o, "r%v,%v;", rl.lo, rl.hi),
                None     : String::append(&mut o, "r?;"),
            },
            PElem::PSpan(k) : String::appendf(
                &mut o,
                "R%v:%s,%v:%s;",
                StringView::len(&k.lo),
                &k.lo,
                StringView::len(&k.hi),
                &k.hi,
            ),
        }
    }
    String::append(&mut o, if (k.mode == Mode::Shared) { "|s" } else { "|x" });
    o
}

// One `deriv` fact: its key and its value.
struct DerivFact
{
    DerivKey key;
    Tri v;
}

// The flow facts at a program point.
struct Flow
{
    // The point is not reachable: no fact is asserted.
    bool unreachable;
    HashMap<String, Tri> valid;
    HashMap<String, Tri> init;
    // For each reference binding, its facts by `deriv_code`.
    HashMap<String, HashMap<String, DerivFact>> deriv;
    // Bug 021: for each root, the holders that may have a fact of it
    // (`rooted`), and those that may have an exclusive one (`excl_rooted`):
    // a holder is listed when it gets one (`note_root`), and a root's list
    // goes when its facts do (`flow_clear_rooted`), so a holder listed may
    // have none any more, but one not listed has none. What holds a root is
    // found without a walk over every holder.
    HashMap<String, HashSet<String>> rooted;
    HashMap<String, HashSet<String>> excl_rooted;
    // Whether `rooted` and `excl_rooted` are kept: only once the flow has
    // more than `INDEX_FROM` holders (`index_if_large`); below, a walk over
    // the few holders answers (`holders_of`) and a flow costs nothing more to
    // copy.
    bool indexed;
    // spec/14's value-range row: a binding bound to a literal with no
    // intervening write.
    HashMap<String, i128> lits;
    // Report 150: while `logging` is not 0 (an `if`'s branches being
    // checked, `check_if_fast`), each change to `valid`, `init` and `lits`
    // records the value it replaced, so the state before a branch is had
    // back by undoing, not by copying every binding's facts per branch.
    Vec<FlowUndo> undo;
    usize logging;
}

// One replaced value of `Flow.valid` (`map` 0), `init` (1) or `lits` (2).
struct FlowUndo
{
    u8 map;
    String key;
    Option<Tri> t;
    Option<i128> l;
}

fn new_flow() : Flow
{
    Flow {
        .unreachable = false,
        .valid = HashMap::new(),
        .init = HashMap::new(),
        .deriv = HashMap::new(),
        .rooted = HashMap::new(),
        .excl_rooted = HashMap::new(),
        .indexed = false,
        .lits = HashMap::new(),
        .undo = Vec::new(),
        .logging = 0,
    }
}

// `valid` (`map` 0) or `init` (1) of `key` set to `v` (`None` removes it),
// the old value recorded while logging.
fn fl_tri(ref<Flow, exclusive> f, u8 map, ref<String, shared> key, Option<Tri> v)
{
    if (f.logging > 0)
    {
        Option<Tri> old = match (if (map == 0) { HashMap::get(&f.valid, key) } else { HashMap::get(&f.init, key) })
        {
            Some(t) : Some(*t),
            None    : None,
        };
        Vec::push(&mut f.undo, FlowUndo { .map = map, .key = String::clone(key), .t = old, .l = None });
    }
    match (v)
    {
        Some(t) :
        {
            if (map == 0)
            {
                HashMap::insert(&mut f.valid, String::clone(key), t);
            }
            else
            {
                HashMap::insert(&mut f.init, String::clone(key), t);
            }
        },
        None    :
        {
            if (map == 0)
            {
                HashMap::swap_remove(&mut f.valid, key);
            }
            else
            {
                HashMap::swap_remove(&mut f.init, key);
            }
        },
    }
}

// `lits` of `key` set to `v` (`None` removes it), recorded while logging.
fn fl_lit(ref<Flow, exclusive> f, ref<String, shared> key, Option<i128> v)
{
    if (f.logging > 0)
    {
        Option<i128> old = match (HashMap::get(&f.lits, key))
        {
            Some(x) : Some(*x),
            None    : None,
        };
        Vec::push(&mut f.undo, FlowUndo { .map = 2, .key = String::clone(key), .t = None, .l = old });
    }
    match (v)
    {
        Some(x) :
        {
            HashMap::insert(&mut f.lits, String::clone(key), x);
        },
        None    :
        {
            HashMap::swap_remove(&mut f.lits, key);
        },
    }
}

// The whole flow replaced by `nf` (a loop's head, a saved state): while
// logging, each value of `valid`, `init` and `lits` that changes is
// recorded, and the log stays with the flow.
fn flow_assign(ref<Body, exclusive> b, Flow nf)
{
    if (b.flow.logging > 0)
    {
        log_differences(&mut b.flow, &nf);
    }
    nf.undo = replace(&mut b.flow.undo, Vec::new());
    nf.logging = b.flow.logging;
    b.flow = nf;
}

// `flow_assign`, giving back the flow replaced.
fn flow_swap(ref<Body, exclusive> b, Flow nf) : Flow
{
    if (b.flow.logging > 0)
    {
        log_differences(&mut b.flow, &nf);
    }
    nf.undo = replace(&mut b.flow.undo, Vec::new());
    nf.logging = b.flow.logging;
    Flow old = replace(&mut b.flow, nf);
    old.logging = 0;
    old
}

fn log_differences(ref<Flow, exclusive> f, ref<Flow, shared> nf)
{
    for (usize i = 0; i < HashMap::len(&f.valid); i += 1)
    {
        ref<String, shared> k = HashMap::key_at(&f.valid, i);
        Tri o = *HashMap::value_at(&f.valid, i);
        bool same = match (HashMap::get(&nf.valid, k))
        {
            Some(t) : *t == o,
            None    : false,
        };
        if (!same)
        {
            Vec::push(&mut f.undo, FlowUndo { .map = 0, .key = String::clone(k), .t = Some(o), .l = None });
        }
    }
    for (usize i = 0; i < HashMap::len(&nf.valid); i += 1)
    {
        ref<String, shared> k = HashMap::key_at(&nf.valid, i);
        if (!HashMap::contains(&f.valid, k))
        {
            Vec::push(&mut f.undo, FlowUndo { .map = 0, .key = String::clone(k), .t = None, .l = None });
        }
    }
    for (usize i = 0; i < HashMap::len(&f.init); i += 1)
    {
        ref<String, shared> k = HashMap::key_at(&f.init, i);
        Tri o = *HashMap::value_at(&f.init, i);
        bool same = match (HashMap::get(&nf.init, k))
        {
            Some(t) : *t == o,
            None    : false,
        };
        if (!same)
        {
            Vec::push(&mut f.undo, FlowUndo { .map = 1, .key = String::clone(k), .t = Some(o), .l = None });
        }
    }
    for (usize i = 0; i < HashMap::len(&nf.init); i += 1)
    {
        ref<String, shared> k = HashMap::key_at(&nf.init, i);
        if (!HashMap::contains(&f.init, k))
        {
            Vec::push(&mut f.undo, FlowUndo { .map = 1, .key = String::clone(k), .t = None, .l = None });
        }
    }
    for (usize i = 0; i < HashMap::len(&f.lits); i += 1)
    {
        ref<String, shared> k = HashMap::key_at(&f.lits, i);
        i128 o = *HashMap::value_at(&f.lits, i);
        bool same = match (HashMap::get(&nf.lits, k))
        {
            Some(x) : *x == o,
            None    : false,
        };
        if (!same)
        {
            Vec::push(&mut f.undo, FlowUndo { .map = 2, .key = String::clone(k), .t = None, .l = Some(o) });
        }
    }
    for (usize i = 0; i < HashMap::len(&nf.lits); i += 1)
    {
        ref<String, shared> k = HashMap::key_at(&nf.lits, i);
        if (!HashMap::contains(&f.lits, k))
        {
            Vec::push(&mut f.undo, FlowUndo { .map = 2, .key = String::clone(k), .t = None, .l = None });
        }
    }
}

// The holders past which a flow keeps its index of roots (`Flow.indexed`).
const usize INDEX_FROM = 24;

// A flow not yet indexed that has more than `INDEX_FROM` holders gets its
// index, made from every fact it has.
fn index_if_large(ref<Flow, exclusive> f)
{
    if (f.indexed || HashMap::len(&f.deriv) <= INDEX_FROM)
    {
        return;
    }
    f.indexed = true;
    Vec<String> hs = Vec::new();
    for (usize i = 0; i < HashMap::len(&f.deriv); i += 1)
    {
        Vec::push(&mut hs, String::clone(HashMap::key_at(&f.deriv, i)));
    }
    foreach (h in &hs)
    {
        note_roots(f, h);
    }
}

// Bug 021: `holder` has a fact of `key` (`Flow.rooted`).
fn note_root(ref<Flow, exclusive> f, ref<String, shared> holder, ref<DerivKey, shared> key)
{
    if (!f.indexed)
    {
        index_if_large(f);
        return;
    }
    HashSet::insert(HashMap::entry(&mut f.rooted, &key.root, HashSet::new()), String::clone(holder));
    if (key.mode == Mode::Exclusive)
    {
        HashSet::insert(HashMap::entry(&mut f.excl_rooted, &key.root, HashSet::new()), String::clone(holder));
    }
}

// Bug 021: every fact `holder` has, listed (`note_root`).
fn note_roots(ref<Flow, exclusive> f, ref<String, shared> holder)
{
    if (!f.indexed)
    {
        index_if_large(f);
        return;
    }
    Vec<DerivKey> keys = Vec::new();
    match (HashMap::get(&f.deriv, holder))
    {
        Some(m) :
        {
            for (usize k = 0; k < HashMap::len(m); k += 1)
            {
                Vec::push(&mut keys, clone(&HashMap::value_at(m, k).key));
            }
        },
        None    : {},
    }
    foreach (k in &keys)
    {
        note_root(f, holder, k);
    }
}

fn names_set(Vec<String> v) : HashSet<String>
{
    HashSet<String> out = HashSet::new();
    foreach (n in v)
    {
        HashSet::insert(&mut out, n);
    }
    out
}

// Bug 021: the holders that may have a fact of root `x` (an exclusive one,
// when `excl`), in no particular order.
fn holders_of(ref<Flow, shared> f, StringView x, bool excl) : Vec<String>
{
    Vec<String> out = Vec::new();
    if (!f.indexed)
    {
        // Few holders: each one that has such a fact.
        for (usize i = 0; i < HashMap::len(&f.deriv); i += 1)
        {
            ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&f.deriv, i);
            for (usize k = 0; k < HashMap::len(facts); k += 1)
            {
                ref<DerivKey, shared> d = &HashMap::value_at(facts, k).key;
                if (d.root == x && (!excl || d.mode == Mode::Exclusive))
                {
                    Vec::push(&mut out, String::clone(HashMap::key_at(&f.deriv, i)));
                    break;
                }
            }
        }
        return out;
    }
    ref<HashMap<String, HashSet<String>>, shared> m = if (excl) { &f.excl_rooted } else { &f.rooted };
    match (HashMap::get(m, x))
    {
        Some(hs) :
        {
            for (usize k = 0; k < HashSet::len(hs); k += 1)
            {
                Vec::push(&mut out, String::clone(HashSet::key_at(hs, k)));
            }
        },
        None     : {},
    }
    out
}

// A shadowed binding's facts, kept aside while the shadowing block is
// open.
struct RootedFact
{
    String holder;
    DerivKey key;
    Tri v;
}

struct SavedFacts
{
    Tri valid;
    Tri init;
    Option<HashMap<String, DerivFact>> own_deriv;
    Vec<RootedFact> rooted;
    Option<i128> lit;
}

struct LoopCtx
{
    Vec<Flow> breaks;
    Vec<Flow> continues;
}

// How many fixed points of one loop are kept (`Body::loops_seen`).
const usize LOOPS_SEEN = 8;

// A loop's fixed point (`check_while`): the flow it was entered with, the
// head the rounds settled on, and the flow after it.
struct LoopSeen
{
    Flow entry;
    Flow head;
    Flow exit;
}

struct ScopeEntry
{
    String name;
    Option<SavedFacts> flow;
    Option<usize> decl_block;
    Option<Option<Referent>> ref_origin;
}

fn flow_is_tracked(ref<Flow, shared> f, ref<String, shared> name) : bool
{
    HashMap::contains(&f.valid, name)
}

// A declaration: `valid(x) := T`, `init(x) := T` or `F`; facts about a
// previous binding of the name are dropped.
fn flow_declare(ref<Flow, exclusive> f, ref<String, shared> name, bool initialized)
{
    fl_lit(f, name, None);
    fl_tri(f, 0, name, Some(Tri::T));
    fl_tri(f, 1, name, Some(if (initialized) { Tri::T } else { Tri::F }));
    HashMap::remove(&mut f.deriv, name);
    flow_clear_rooted(f, name);
    flow_clear_rooted(f, &referent_root(name));
}

// Every `deriv(·, x.·, ·) := F`.
fn flow_clear_rooted(ref<Flow, exclusive> f, StringView x)
{
    Vec<String> empty = Vec::new();
    // Bug 021: only the holders listed for `x` (`Flow.rooted`); each is
    // cleared alone, and the holders left with none are removed in the
    // facts' order whatever order they are found in.
    Vec<String> hs = holders_of(f, x, false);
    if (Vec::len(&hs) == 0)
    {
        return;
    }
    foreach (h in hs)
    {
        ref<HashMap<String, DerivFact>, exclusive> facts = match (HashMap::get_mut(&mut f.deriv, &h))
        {
            Some(m) : m,
            None    : continue,
        };
        Vec<String> gone = Vec::new();
        for (usize k = 0; k < HashMap::len(facts); k += 1)
        {
            if (HashMap::value_at(facts, k).key.root == x)
            {
                Vec::push(&mut gone, String::clone(HashMap::key_at(facts, k)));
            }
        }
        for (usize k = 0; k < Vec::len(&gone); k += 1)
        {
            HashMap::remove(facts, &gone[k]);
        }
        if (HashMap::len(facts) == 0)
        {
            Vec::push(&mut empty, h);
        }
    }
    for (usize i = 0; i < Vec::len(&empty); i += 1)
    {
        HashMap::remove(&mut f.deriv, &empty[i]);
    }
    HashMap::swap_remove(&mut f.rooted, x);
    HashMap::swap_remove(&mut f.excl_rooted, x);
}

// Block exit for a binding declared in the block: it is untracked.
fn flow_remove(ref<Flow, exclusive> f, ref<String, shared> name)
{
    fl_lit(f, name, None);
    fl_tri(f, 0, name, None);
    fl_tri(f, 1, name, None);
    HashMap::remove(&mut f.deriv, name);
    flow_clear_rooted(f, name);
    flow_clear_rooted(f, &referent_root(name));
}

fn tri_or_u(Option<ref<Tri, shared>> t) : Tri
{
    match (t)
    {
        Some(v) : *v,
        None    : Tri::U,
    }
}

fn flow_save(ref<Flow, shared> f, ref<String, shared> name) : SavedFacts
{
    Vec<RootedFact> rooted = Vec::new();
    // Bug 021: the walk, in the facts' order, only when a holder is listed
    // for the name (`Flow.rooted`).
    usize walk = if (!f.indexed || HashMap::contains(&f.rooted, name)) { HashMap::len(&f.deriv) } else { 0 };
    for (usize i = 0; i < walk; i += 1)
    {
        ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&f.deriv, i);
        for (usize k = 0; k < HashMap::len(facts); k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            if (d.key.root == *name)
            {
                Vec::push(
                    &mut rooted,
                    RootedFact { .holder = String::clone(HashMap::key_at(
                        &f.deriv,
                        i,
                    )), .key = clone(&d.key), .v = d.v },
                );
            }
        }
    }
    SavedFacts {
        .valid = tri_or_u(HashMap::get(&f.valid, name)),
        .init = tri_or_u(HashMap::get(&f.init, name)),
        .own_deriv = match (HashMap::get(&f.deriv, name))
        {
            Some(d) : Some(clone(d)),
            None    : None,
        },
        .rooted = rooted,
        .lit = match (HashMap::get(&f.lits, name))
        {
            Some(v) : Some(*v),
            None    : None,
        },
    }
}

fn flow_restore(ref<Flow, exclusive> f, ref<String, shared> name, SavedFacts s)
{
    SavedFacts { valid, init, own_deriv, rooted, lit } = s;
    fl_tri(f, 0, name, Some(valid));
    fl_tri(f, 1, name, Some(init));
    match (own_deriv)
    {
        Some(d) :
        {
            HashMap::insert(&mut f.deriv, String::clone(name), d);
        },
        None    : {},
    }
    note_roots(f, name);
    for (usize i = 0; i < Vec::len(&rooted); i += 1)
    {
        ref<RootedFact, shared> r = &rooted[i];
        ref<HashMap<String, DerivFact>, exclusive> facts = HashMap::entry(
            &mut f.deriv,
            &r.holder,
            HashMap::new(),
        );
        HashMap::insert(facts, deriv_code(&r.key), DerivFact { .key = clone(&r.key), .v = r.v });
        note_root(f, &r.holder, &r.key);
    }
    match (lit)
    {
        Some(v) : fl_lit(f, name, Some(v)),
        None    : {},
    }
}

fn deriv_v(ref<Flow, shared> f, ref<String, shared> holder, ref<String, shared> code) : Tri
{
    match (HashMap::get(&f.deriv, holder))
    {
        Some(facts) : match (HashMap::get(facts, code))
        {
            Some(d) : d.v,
            None    : Tri::F,
        },
        None : Tri::F,
    }
}

// The pointwise join at a merge point; an unreachable side is the
// identity. A name tracked on only one side is dropped.
// D-0300: the widening of a loop's head: a fact whose path is longer than
// `max` stands for a fact `?` on its prefix of `max` steps.
fn flow_truncated(Flow f, usize max) : Flow
{
    Flow out = f;
    Vec<String> rs = Vec::new();
    for (usize i = 0; i < HashMap::len(&out.deriv); i += 1)
    {
        Vec::push(&mut rs, String::clone(HashMap::key_at(&out.deriv, i)));
    }
    for (usize i = 0; i < Vec::len(&rs); i += 1)
    {
        ref<HashMap<String, DerivFact>, exclusive> m = match (HashMap::get_mut(&mut out.deriv, &rs[i]))
        {
            Some(m) : m,
            None    : continue,
        };
        Vec<DerivFact> long = Vec::new();
        for (usize k = 0; k < HashMap::len(m); k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(m, k);
            if (Vec::len(&d.key.path) > max)
            {
                Vec::push(&mut long, clone(d));
            }
        }
        for (usize k = 0; k < Vec::len(&long); k += 1)
        {
            HashMap::remove(m, &deriv_code(&long[k].key));
            DerivKey nk = clone(&long[k].key);
            Vec::truncate(&mut nk.path, max);
            String code = deriv_code(&nk);
            _ = HashMap::insert(m, code, DerivFact { .key = nk, .v = Tri::U });
        }
    }
    out
}

fn flow_join(ref<Flow, shared> a, ref<Flow, shared> b) : Flow
{
    if (a.unreachable)
    {
        return clone(b);
    }
    if (b.unreachable)
    {
        return clone(a);
    }
    Flow out = new_flow();
    for (usize i = 0; i < HashMap::len(&a.lits); i += 1)
    {
        ref<String, shared> n = HashMap::key_at(&a.lits, i);
        i128 v = *HashMap::value_at(&a.lits, i);
        match (HashMap::get(&b.lits, n))
        {
            Some(w) :
            {
                if (*w == v)
                {
                    HashMap::insert(&mut out.lits, String::clone(n), v);
                }
            },
            None    : {},
        }
    }
    for (usize i = 0; i < HashMap::len(&a.valid); i += 1)
    {
        ref<String, shared> n = HashMap::key_at(&a.valid, i);
        Tri va = *HashMap::value_at(&a.valid, i);
        match (HashMap::get(&b.valid, n))
        {
            Some(vb) :
            {
                HashMap::insert(&mut out.valid, String::clone(n), tri_join(va, *vb));
                Tri ia = tri_or_u(HashMap::get(&a.init, n));
                Tri ib = tri_or_u(HashMap::get(&b.init, n));
                HashMap::insert(&mut out.init, String::clone(n), tri_join(ia, ib));
            },
            None     : {},
        }
    }
    HashSet<String> holders = HashSet::new();
    for (usize i = 0; i < HashMap::len(&a.deriv); i += 1)
    {
        HashSet::insert(&mut holders, String::clone(HashMap::key_at(&a.deriv, i)));
    }
    for (usize i = 0; i < HashMap::len(&b.deriv); i += 1)
    {
        HashSet::insert(&mut holders, String::clone(HashMap::key_at(&b.deriv, i)));
    }
    HashMap<String, DerivFact> empty = HashMap::new();
    for (usize i = 0; i < HashSet::len(&holders); i += 1)
    {
        ref<String, shared> r = HashSet::key_at(&holders, i);
        if (!HashMap::contains(&out.valid, r))
        {
            continue;
        }
        ref<HashMap<String, DerivFact>, shared> fa = Option::unwrap_or(HashMap::get(&a.deriv, r), &empty);
        ref<HashMap<String, DerivFact>, shared> fb = Option::unwrap_or(HashMap::get(&b.deriv, r), &empty);
        HashMap<String, DerivFact> merged = HashMap::new();
        for (usize side = 0; side < 2; side += 1)
        {
            ref<HashMap<String, DerivFact>, shared> src = if (side == 0) { fa } else { fb };
            for (usize k = 0; k < HashMap::len(src); k += 1)
            {
                ref<String, shared> code = HashMap::key_at(src, k);
                if (HashMap::contains(&merged, code))
                {
                    continue;
                }
                ref<DerivFact, shared> d = HashMap::value_at(src, k);
                if (!HashMap::contains(&out.valid, &String::copy(root_binding(&d.key.root))))
                {
                    continue;
                }
                Tri pa = match (HashMap::get(fa, code))
                {
                    Some(x) : x.v,
                    None    : Tri::F,
                };
                Tri pb = match (HashMap::get(fb, code))
                {
                    Some(x) : x.v,
                    None    : Tri::F,
                };
                Tri v = tri_join(pa, pb);
                if (v != Tri::F)
                {
                    HashMap::insert(&mut merged, String::clone(code), DerivFact { .key = clone(&d.key), .v = v });
                }
            }
        }
        if (HashMap::len(&merged) > 0)
        {
            HashMap::insert(&mut out.deriv, String::clone(r), merged);
            note_roots(&mut out, r);
        }
    }
    out
}

fn tri_maps_eq(ref<HashMap<String, Tri>, shared> a, ref<HashMap<String, Tri>, shared> b) : bool
{
    if (HashMap::len(a) != HashMap::len(b))
    {
        return false;
    }
    for (usize i = 0; i < HashMap::len(a); i += 1)
    {
        match (HashMap::get(b, HashMap::key_at(a, i)))
        {
            Some(v) :
            {
                if (*v != *HashMap::value_at(a, i))
                {
                    return false;
                }
            },
            None    : return false,
        }
    }
    true
}

// `Flow == Flow`, the maps compared as maps.
fn flow_eq(ref<Flow, shared> a, ref<Flow, shared> b) : bool
{
    if (a.unreachable != b.unreachable || !tri_maps_eq(&a.valid, &b.valid) || !tri_maps_eq(&a.init, &b.init))
    {
        return false;
    }
    if (HashMap::len(&a.lits) != HashMap::len(&b.lits) || HashMap::len(&a.deriv) != HashMap::len(&b.deriv))
    {
        return false;
    }
    for (usize i = 0; i < HashMap::len(&a.lits); i += 1)
    {
        match (HashMap::get(&b.lits, HashMap::key_at(&a.lits, i)))
        {
            Some(v) :
            {
                if (*v != *HashMap::value_at(&a.lits, i))
                {
                    return false;
                }
            },
            None    : return false,
        }
    }
    for (usize i = 0; i < HashMap::len(&a.deriv); i += 1)
    {
        ref<HashMap<String, DerivFact>, shared> fa = HashMap::value_at(&a.deriv, i);
        ref<HashMap<String, DerivFact>, shared> fb = match (HashMap::get(&b.deriv, HashMap::key_at(&a.deriv, i)))
        {
            Some(m) : m,
            None    : return false,
        };
        if (HashMap::len(fa) != HashMap::len(fb))
        {
            return false;
        }
        for (usize k = 0; k < HashMap::len(fa); k += 1)
        {
            match (HashMap::get(fb, HashMap::key_at(fa, k)))
            {
                Some(d) :
                {
                    if (d.v != HashMap::value_at(fa, k).v)
                    {
                        return false;
                    }
                },
                None    : return false,
            }
        }
    }
    true
}

// Whether a value of `ty` is or holds a function value (`[Eq-Fn]`).
fn contains_fn(ref<Items, shared> it, ref<Type, shared> ty) : bool
{
    match (ty)
    {
        Type::TFn(_)      : true,
        Type::TClosure(_) : true,
        Type::TArray(b)   : contains_fn(it, &Box::get(b).inner),
        Type::TNamed(_)   : any_part(it, ty, 0),
        _                 : false,
    }
}

// Whether a struct's fields or an enum's payloads (substituted) satisfy
// `which` (0 contains_fn, 1 contains_slice, 2 holds_ref).
fn any_part(ref<Items, shared> it, ref<Type, shared> ty, u8 which) : bool
{
    ref<NamedTy, shared> n = match (ty)
    {
        Type::TNamed(b) : Box::get(b),
        _               : return false,
    };
    Vec<Type> parts = Vec::new();
    HashMap<String, Type> subst = HashMap::new();
    bool made = false;
    Vec<String> params = Vec::new();
    match (HashMap::get(&it.structs, &n.name))
    {
        Some(s) :
        {
            params = clone(&s.type_params);
            for (usize i = 0; i < Vec::len(&s.fields); i += 1)
            {
                Vec::push(&mut parts, clone(&s.fields[i].ty));
            }
        },
        None : match (HashMap::get(&it.enums, &n.name))
        {
            Some(e) :
            {
                params = clone(&e.type_params);
                for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                {
                    match (&e.variants[i].payload)
                    {
                        Some(p) : Vec::push(&mut parts, clone(p)),
                        None    : {},
                    }
                }
            },
            None    : return false,
        },
    }
    for (usize i = 0; i < Vec::len(&parts); i += 1)
    {
        // Bug 044: a part that is a type parameter is its argument, asked as
        // it is (`apply_subst` copied it, at every level of `Option<Option<…>>`).
        bool hit = match (param_index(&parts[i], &params, Vec::len(&n.args)))
        {
            Some(k) : part_has(it, &n.args[k], which),
            None    :
            {
                // (The substitution, made once, when a part needs it.)
                if (!made)
                {
                    subst = zip_subst(&params, &n.args);
                    made = true;
                }
                part_has(it, &apply_subst(&parts[i], &subst), which)
            },
        };
        if (hit)
        {
            return true;
        }
    }
    false
}

fn part_has(ref<Items, shared> it, ref<Type, shared> t, u8 which) : bool
{
    if (which == 0)
    {
        contains_fn(it, t)
    }
    else if (which == 1) { contains_slice(it, t) } else { holds_ref(it, t) }
}

// `t`'s name, when it is one of `params` (as `unify_type_shape` takes it).
fn type_param_named(ref<Type, shared> t, ref<Vec<String>, shared> params) : Option<String>
{
    match (t)
    {
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (Vec::len(&n.args) == 0 && Vec::contains(params, &n.name)) { Some(String::clone(&n.name)) } else { None }
        },
        _               : None,
    }
}

// The place of the argument `t` stands for, when `t` is one of `params`
// (`zip_subst`'s pairing with `nargs` arguments).
fn param_index(ref<Type, shared> t, ref<Vec<String>, shared> params, usize nargs) : Option<usize>
{
    match (t)
    {
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            if (Vec::len(&n.args) != 0)
            {
                return None;
            }
            for (usize i = 0; i < Vec::len(params) && i < nargs; i += 1)
            {
                if (params[i] == n.name)
                {
                    return Some(i);
                }
            }
            None
        },
        _               : None,
    }
}

// Whether `[Eq-Struct]`'s field-by-field comparison would reach a slice.
fn contains_slice(ref<Items, shared> it, ref<Type, shared> ty) : bool
{
    match (ty)
    {
        Type::TSlice(_) : true,
        Type::TArray(b) : contains_slice(it, &Box::get(b).inner),
        Type::TNamed(_) : any_part(it, ty, 1),
        _               : false,
    }
}

fn fn_shown(ref<FnDecl, shared> f) : String
{
    String n = match (&f.assoc_type)
    {
        Some(a) : sprintf("%s::%s", a, &f.name),
        None    : String::clone(&f.name),
    };
    String::copy(Option::unwrap_or(StringView::strip_prefix(&n, "std::"), &n))
}

fn mismatch(String msg) : String
{
    sprintf("diag.type-mismatch\u{1}%s", &msg)
}

// Bug 029: the repair for a declaration of `exp` whose initializer is
// `actual`, where the registry's ("convert explicitly") does not fit: a
// conversion is between numbers.
fn declared_repair(ref<Type, shared> exp, ref<Type, shared> actual, ref<ShownPair, shared> sp) : Option<String>
{
    if ((is_numeric_ty(exp) || match (exp)
    {
        Type::TBool : true,
        _           : false,
    }) && is_numeric_ty(actual))
    {
        return None;
    }
    bool holds = Vec::len(&named_args(actual)) > 0 && type_eq(&named_args(actual)[0], exp);
    if (holds && named_is(actual, "std::Option"))
    {
        return Some(sprintf(
            "take the value out of the `Option`: `match (o) { Some(x) : x, None : … }`, `if (Some(x) = o) { … }`, or `Option::unwrap_or(o, d)`",
        ));
    }
    if (holds && named_is(actual, "std::Result"))
    {
        return Some(sprintf(
            "take the value out of the `Result`: `?` in a function that returns a `Result`, or `match (r) { Ok(x) : x, Err(e) : … }`",
        ));
    }
    Some(sprintf("declare it `%s`, or give it a value of type `%s`", &sp.b, &sp.a))
}

// Bug 029: `msg` with the repair its situation calls for, which `cobc`
// prints in place of the registry's one line for the diagnostic's id; an
// empty `r` prints none, where the message's own words are the repair.
fn with_repair(StringView msg, StringView r) : String
{
    sprintf("%s\u{3}%s\u{3}", msg, r)
}

// Whether a value of `ty` holds a reference or slice.
fn holds_ref(ref<Items, shared> it, ref<Type, shared> ty) : bool
{
    match (ty)
    {
        Type::TRef(_)   : true,
        Type::TSlice(_) : true,
        Type::TArray(b) : holds_ref(it, &Box::get(b).inner),
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            match (HashMap::get(&it.ref_info, &n.name))
            {
                Some(r) :
                {
                    if (!r.exact || Vec::len(&n.args) != r.arity)
                    {
                        return any_part(it, ty, 2);
                    }
                    if (r.own)
                    {
                        return true;
                    }
                    for (usize k = 0; k < Vec::len(&r.params); k += 1)
                    {
                        if (holds_ref(it, &n.args[r.params[k]]))
                        {
                            return true;
                        }
                    }
                    false
                },
                None    : false,
            }
        },
        _               : false,
    }
}

// D-0218: whether a value of `ty` holds an exclusive reference or slice in
// itself.
fn holds_excl_ref(ref<Items, shared> it, ref<Type, shared> ty, u32 depth) : bool
{
    if (depth > 32)
    {
        return false;
    }
    match (ty)
    {
        Type::TRef(b)   : Box::get(b).mode == Mode::Exclusive,
        Type::TSlice(b) : Box::get(b).mode == Mode::Exclusive,
        Type::TArray(b) : holds_excl_ref(it, &Box::get(b).inner, depth + 1),
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        if (holds_excl_ref(it, &apply_subst(&s.fields[i].ty, &subst), depth + 1))
                        {
                            return true;
                        }
                    }
                    return false;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) :
                            {
                                if (holds_excl_ref(it, &apply_subst(p, &subst), depth + 1))
                                {
                                    return true;
                                }
                            },
                            None    : {},
                        }
                    }
                    false
                },
                None    : false,
            }
        },
        _               : false,
    }
}

// D-0111, D-0133 `[Ref-Binding-Last-Use]`: a local of this type may end
// after its last use.
export fn ends_at_last_use(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(_)     : return true,
        Type::TSlice(_)   : return true,
        Type::TRawptr(_)  : return false,
        Type::TFn(_)      : return false,
        Type::TClosure(_) : return false,
        _                 : {},
    }
    if (named_is(t, "std::StringView"))
    {
        return true;
    }
    may_hold_ref(it, t, 0) && !is_resource_ty(it, t) && !contains_fn(it, t)
}

// Report 265: a holder of references that is a resource only by the
// memory it owns (`Vec<StringView>`, `Vec<ref<T, shared>>`): its end reads
// nothing it refers to, so it may end after its block's last statement.
export fn quiet_holder(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    !ends_at_last_use(it, t) && is_resource_ty(it, t) && may_hold_ref(it, t, 0) && !contains_fn(it, t) && quiet_ty(it, t)
}

// D-0204: whether a value of `t` may hold an exclusive reference through
// which its holder could change data that is not its own.
export fn may_hold_excl_ref(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    excl_ref_in(it, t, 0)
}

fn excl_ref_in(ref<Items, shared> it, ref<Type, shared> t, usize depth) : bool
{
    if (depth > 16)
    {
        return true;
    }
    match (t)
    {
        Type::TRef(b)     : Box::get(b).mode == Mode::Exclusive,
        Type::TSlice(b)   : Box::get(b).mode == Mode::Exclusive,
        Type::TClosure(_) : true,
        Type::TArray(b)   : excl_ref_in(it, &Box::get(b).inner, depth + 1),
        Type::TRawptr(b)  : excl_ref_in(it, Box::get(b), depth + 1),
        Type::THandle(b)  : excl_ref_in(it, Box::get(b), depth + 1),
        Type::TMutex(b)   : excl_ref_in(it, Box::get(b), depth + 1),
        Type::TGuard(b)   : excl_ref_in(it, Box::get(b), depth + 1),
        Type::TNamed(b)   :
        {
            ref<NamedTy, shared> n = Box::get(b);
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (excl_ref_in(it, &n.args[i], depth + 1))
                {
                    return true;
                }
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        if (excl_ref_in(it, &apply_subst(&s.fields[i].ty, &subst), depth + 1))
                        {
                            return true;
                        }
                    }
                    return false;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) :
                            {
                                if (excl_ref_in(it, &apply_subst(p, &subst), depth + 1))
                                {
                                    return true;
                                }
                            },
                            None    : {},
                        }
                    }
                    false
                },
                None    : false,
            }
        },
        _                 : false,
    }
}

fn may_hold_ref(ref<Items, shared> it, ref<Type, shared> t, usize depth) : bool
{
    if (depth > 16)
    {
        return true;
    }
    match (t)
    {
        Type::TRef(_)     : true,
        Type::TSlice(_)   : true,
        Type::TFn(_)      : true,
        Type::TClosure(_) : true,
        Type::TArray(b)   : may_hold_ref(it, &Box::get(b).inner, depth + 1),
        Type::TRawptr(b)  : may_hold_ref(it, Box::get(b), depth + 1),
        Type::THandle(b)  : may_hold_ref(it, Box::get(b), depth + 1),
        Type::TMutex(b)   : may_hold_ref(it, Box::get(b), depth + 1),
        Type::TGuard(b)   : may_hold_ref(it, Box::get(b), depth + 1),
        Type::TNamed(b)   :
        {
            if (holds_ref(it, t))
            {
                return true;
            }
            ref<NamedTy, shared> n = Box::get(b);
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (may_hold_ref(it, &n.args[i], depth + 1))
                {
                    return true;
                }
            }
            false
        },
        _                 : false,
    }
}

// D-0109: shared if either is.
fn weaker_mode(Option<Mode> a, Mode b) : Mode
{
    if (let_shared(a) || b == Mode::Shared) { Mode::Shared } else { Mode::Exclusive }
}

fn let_shared(Option<Mode> a) : bool
{
    match (a)
    {
        Some(m) : m == Mode::Shared,
        None    : false,
    }
}

// ---- part 3 ----

fn bound_rank(Bound b) : u8
{
    match (b)
    {
        Bound::BEq      : 0,
        Bound::BOrdered : 1,
        Bound::BNumber  : 2,
        Bound::BInteger : 3,
        Bound::BClone   : 0,
        Bound::BPlain   : 0,
    }
}

// Whether every type satisfying `a` satisfies `other`.
fn bound_implies(Bound a, Bound other) : bool
{
    if (other == Bound::BClone)
    {
        return true;
    }
    if (a == Bound::BPlain || other == Bound::BPlain)
    {
        return a == other;
    }
    if (a == Bound::BClone)
    {
        return false;
    }
    bound_rank(a) >= bound_rank(other)
}

// Whether a concrete type satisfies the bound, from the type alone.
fn bound_holds_for(Bound b, ref<Type, shared> t) : bool
{
    if (b == Bound::BClone)
    {
        return match (t)
        {
            Type::TInt(_)    : true,
            Type::TF32       : true,
            Type::TF64       : true,
            Type::TBool      : true,
            Type::TStr       : true,
            Type::TRef(_)    : true,
            Type::TRawptr(_) : true,
            Type::TSlice(_)  : true,
            _                : is_std_string(t),
        };
    }
    if (b == Bound::BPlain)
    {
        return match (t)
        {
            Type::TInt(_)    : true,
            Type::TF32       : true,
            Type::TF64       : true,
            Type::TBool      : true,
            Type::TRawptr(_) : true,
            Type::TSimd(_)   : true,
            _                : false,
        };
    }
    match (t)
    {
        Type::TInt(_) : true,
        Type::TF32    : b != Bound::BInteger,
        Type::TF64    : b != Bound::BInteger,
        Type::TBool   : b == Bound::BEq || b == Bound::BOrdered,
        Type::TStr    : b == Bound::BEq || b == Bound::BOrdered,
        // D-0336 (report 098): a `StringView` compares and orders by its
        // text, as `==` and `<` on it do; it is not a key (a table of views
        // would hold borrows of the text it does not own).
        _             : (is_std_string(t) || plain_named_ty(t, "std::StringView")) && (b == Bound::BEq || b == Bound::BOrdered),
    }
}

fn marker_of(ref<Type, shared> t) : Option<String>
{
    match (t)
    {
        Type::TNamed(b) : Some(String::clone(&Box::get(b).name)),
        _               : None,
    }
}

// D-0090: an operator on a type parameter's value (one operand a marker):
// allowed when its bound provides it.
fn check_bounded_binary(
    ref<Body, exclusive> b,
    BinOp op,
    ref<Option<Type>, shared> at,
    ref<Option<Type>, shared> bt,
    bool b_literal,
) : Result<Option<Type>, String>
{
    Type m = match (at)
    {
        Some(a) :
        {
            if (is_marker(a))
            {
                clone(a)
            }
            else
            {
                match (bt)
                {
                    Some(x) : clone(x),
                    None    : return Err(unbounded_msg("an operator")),
                }
            }
        },
        None : match (bt)
        {
            Some(x) : clone(x),
            None    : return Err(unbounded_msg("an operator")),
        },
    };
    String mn = match (marker_of(&m))
    {
        Some(n) : n,
        None    : return Err(unbounded_msg("an operator")),
    };
    Bound need = Bound::BEq;
    if (op == BinOp::Eq || op == BinOp::Ne)
    {
        need = Bound::BEq;
    }
    else if (op == BinOp::Lt || op == BinOp::Le || op == BinOp::Gt || op == BinOp::Ge)
    {
        need = Bound::BOrdered;
    }
    else if (op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul || op == BinOp::Div || op == BinOp::Rem)
    {
        need = Bound::BNumber;
    }
    else if (op == BinOp::BitAnd || op == BinOp::BitOr || op == BinOp::BitXor || op == BinOp::Shl || op == BinOp::Shr)
    {
        need = Bound::BInteger;
    }
    else
    {
        return Err(unbounded_msg("a logical operator"));
    }
    str sym = op_symbol(op);
    bool has = match (HashMap::get(&b.marker_bounds, &mn))
    {
        Some(have) : bound_implies(*have, need),
        None       : false,
    };
    if (!has)
    {
        return Err(bound_msg(b, &mn, sym, need));
    }
    // Both operands of the parameter's type (a shift's amount is a `u32`, as
    // always, and a literal amount takes the shifted operand's type, as
    // `x >> 3` does on a concrete integer: CHG-0439).
    bool same_a = match (at)
    {
        Some(t) : type_eq(t, &m),
        None    : true,
    };
    if (op == BinOp::Shl || op == BinOp::Shr)
    {
        bool amount_ok = b_literal || match (bt)
        {
            Some(t) : type_eq(t, &Type::TInt(IntTy::U32)),
            None    : true,
        };
        if (!is_marker_opt(at) || !amount_ok)
        {
            return Err(mismatch(sprintf(
                "a shift amount is a `u32`, and this is `%s`: convert it to `u32`",
                &operand_shown(bt),
            )));
        }
    }
    else
    {
        bool same_b = match (bt)
        {
            Some(t) : type_eq(t, &m),
            None    : true,
        };
        if (!(same_a && same_b))
        {
            return Err(mismatch(sprintf(
                "the operands of `%s` are `%s` and `%s`; both must be the type parameter's type",
                sym,
                &operand_shown(at),
                &operand_shown(bt),
            )));
        }
    }
    if (op == BinOp::Eq || op == BinOp::Ne || op == BinOp::Lt || op == BinOp::Le || op == BinOp::Gt || op == BinOp::Ge)
    {
        return Ok(Some(Type::TBool));
    }
    Ok(Some(m))
}

// An item's key as a message shows it: `std::Option` as `Option`.
fn shown_key(StringView key) : String
{
    if (StringView::starts_with(key, "std::")) { String::copy(&key[5..$]) } else { String::copy(key) }
}

// An operand's type as a message shows it: a type parameter by its name.
fn operand_shown(ref<Option<Type>, shared> t) : String
{
    match (t)
    {
        Some(x) :
        {
            if (is_marker(x))
            {
                match (marker_of(x))
                {
                    Some(n) : String::copy(&n[1..$]),
                    None    : type_display(x),
                }
            }
            else
            {
                type_display(x)
            }
        },
        None    : "?",
    }
}

// D-0271: whether the concrete type `t` satisfies `bd`.
fn bound_holds(ref<Body, shared> b, ref<Items, shared> it, Bound bd, ref<Type, shared> t) : bool
{
    bound_holds_for(bd, t) || ((bd == Bound::BEq || bd == Bound::BOrdered) && named_key_type(it, t))
}

// D-0271: a place of a struct or enum key type that holds a `String`.
fn is_resource_key_place(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    match (static_place_type(b, it, e))
    {
        Some(t) : named_key_type(it, &t) && is_resource_ty(it, &t),
        None    : false,
    }
}

// A struct or enum key type (not `String`).
fn named_key_type(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(_) : !is_std_string(t) && is_key_type(it, t),
        _               : false,
    }
}

fn bound_msg(ref<Body, shared> b, ref<String, shared> marker, str sym, Bound need) : String
{
    StringView n = &marker[1..$];
    match (HashMap::get(&b.marker_bounds, marker))
    {
        Some(have) :
        {
            String msg = sprintf(
                "`%s` on a `%s` needs `%s: %s`, but `%s` is declared `%s`",
                sym,
                n,
                n,
                bound_name(need),
                n,
                bound_name(*have),
            );
            // Bug 116: the repair names the bound this operator needs.
            String rep = sprintf("declare `<%s: %s>` (D-0090), or pass the operation in as a `fn` parameter", n, bound_name(need));
            named_diag("diag.unbounded-type-parameter", &with_repair(&msg, &rep))
        },
        None       :
        {
            String msg = sprintf(
                "`%s` on a `%s` needs a bound: declare `<%s: %s>` (D-0090), or pass the operation in as a `fn` parameter",
                sym,
                n,
                n,
                bound_name(need),
            );
            // Bug 116: the message names the bound; no repair line repeats it.
            named_diag("diag.unbounded-type-parameter", &with_repair(&msg, ""))
        },
    }
}

fn record_instantiation(ref<Body, exclusive> b, ref<String, shared> name, ref<Vec<Type>, shared> targs)
{
    for (usize i = 0; i < Vec::len(targs); i += 1)
    {
        if (has_unresolved_marker(&targs[i]))
        {
            return;
        }
    }
    WorkItem w = work(name, clone(targs));
    w.at_line = b.current_line;
    Vec::push(&mut b.new_instantiations, w);
}

// `K`, a constant named (a call of no arguments to a `const` item).
fn const_call(ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::ECall(cb) :
        {
            if (Vec::len(&Box::get(cb).args) != 0)
            {
                return false;
            }
            match (resolve_fn_path(it, &Box::get(cb).callee))
            {
                Some(k) : Option::expect(HashMap::get(&it.fns, &k), "a function").is_const,
                None    : false,
            }
        },
        _                   : false,
    }
}

// Report 293: an array literal of text literals (`["a", "b"]`).
fn text_literal_array(ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EArrayLit(es) :
        {
            foreach (x in es)
            {
                match (&strip_parens_tc(x).kind)
                {
                    ExprKind::EStr(_) : {},
                    _                 : return false,
                }
            }
            true
        },
        _                       : false,
    }
}

// Report 293: the array type of a `const` borrowed shared (`&NAMES`).
fn const_array_borrowed(ref<Items, shared> it, ref<Expr, shared> e) : Option<Type>
{
    ref<Expr, shared> inner = match (&strip_parens_tc(e).kind)
    {
        ExprKind::EBorrow(bb) : if (Box::get(bb).mode == Mode::Shared) { &Box::get(bb).e } else { return None; },
        _                     : return None,
    };
    if (!const_call(it, inner))
    {
        return None;
    }
    match (&strip_parens_tc(inner).kind)
    {
        ExprKind::ECall(cb) : match (resolve_fn_path(it, &Box::get(cb).callee))
        {
            Some(k) :
            {
                ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &k), "a function");
                match (&f.ret)
                {
                    Type::TArray(_) : Some(clone(&f.ret)),
                    _               : None,
                }
            },
            None    : None,
        },
        _ : None,
    }
}

// The key of the function a callee path names, when it names one.
fn resolve_fn_path(ref<Items, shared> it, ref<Expr, shared> callee) : Option<String>
{
    match (&callee.kind)
    {
        ExprKind::EPath(p) :
        {
            String name = String::join(&Box::get(p).segs, "::");
            if (HashMap::contains(&it.fns, &name))
            {
                return Some(name);
            }
            None
        },
        _                  : None,
    }
}

// ---- rule.control.flow-analysis: scopes, places, discharge ----

// A flow-analysis refutation, suppressed while a loop body is iterated to
// its fixed point and at an unreachable point.
fn refute(ref<Body, shared> b, StringView diag) : Result<void, String>
{
    if (b.report && !b.flow.unreachable)
    {
        return Err(String::copy(diag));
    }
    Ok(())
}

fn declare(ref<Body, exclusive> b, ref<String, shared> name, bool initialized)
{
    ScopeEntry entry = ScopeEntry {
        .name = String::clone(name),
        .flow = if (flow_is_tracked(&b.flow, name)) { Some(flow_save(&b.flow, name)) } else { None },
        .decl_block = match (HashMap::get(&b.decl_block, name))
        {
            Some(x) : Some(*x),
            None    : None,
        },
        .ref_origin = match (HashMap::get(&b.ref_origin, name))
        {
            Some(o) : Some(clone(o)),
            None    : None,
        },
    };
    flow_declare(&mut b.flow, name, initialized);
    HashSet::remove(&mut b.holders, name);
    usize n = Vec::len(&b.block_stack);
    usize here = if (n > 0) { b.block_stack[n - 1] } else { 0 };
    HashMap::insert(&mut b.decl_block, String::clone(name), here);
    HashMap::swap_remove(&mut b.ref_origin, name);
    usize ns = Vec::len(&b.scopes);
    if (ns > 0)
    {
        Vec::push(&mut b.scopes[ns - 1], entry);
    }
}

fn enter_scope(ref<Body, exclusive> b)
{
    usize id = b.next_block;
    b.next_block += 1;
    usize n = Vec::len(&b.block_stack);
    if (n > 0)
    {
        HashMap::insert(&mut b.block_parent, id, b.block_stack[n - 1]);
    }
    Vec::push(&mut b.block_stack, id);
    Vec::push(&mut b.scopes, Vec::new());
}

// `[Block-Exit]`'s transfer: every binding the block declared ends.
fn exit_scope(ref<Body, exclusive> b)
{
    Vec<ScopeEntry> sc = Option::unwrap_or(Vec::pop(&mut b.scopes), Vec::new());
    Vec::pop(&mut b.block_stack);
    while (true)
    {
        ScopeEntry e = match (Vec::pop(&mut sc))
        {
            Some(e) : e,
            None    : break,
        };
        ScopeEntry { name, flow, decl_block, ref_origin } = e;
        HashMap::swap_remove(&mut b.closure_arity, &name);
        HashMap::swap_remove(&mut b.closure_borrows, &name);
        hand_over_referent(b, &name);
        flow_remove(&mut b.flow, &name);
        HashMap::swap_remove(&mut b.decl_block, &name);
        HashMap::swap_remove(&mut b.ref_origin, &name);
        match (flow)
        {
            Some(f) : flow_restore(&mut b.flow, &name, f),
            None    : {},
        }
        match (decl_block)
        {
            Some(d) :
            {
                HashMap::insert(&mut b.decl_block, String::clone(&name), d);
            },
            None    : {},
        }
        match (ref_origin)
        {
            Some(o) :
            {
                HashMap::insert(&mut b.ref_origin, String::clone(&name), o);
            },
            None    : {},
        }
    }
}

// The function body block: its trailing expression is the function's
// result, which escapes to the caller.
fn check_fn_body(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    ref<Type, shared> ret,
) : Result<Option<Type>, String>
{
    usize gamma_mark = Vec::len(&b.gamma_log);
    enter_scope(b);
    Option<Type> last_stmt_ty = None;
    Result<Option<Type>, String> r = Ok(None);
    if (b.recover)
    {
        // D-0323: the statements' errors are in `recovered`; the tail is
        // checked as one more statement.
        bool ended = check_block_stmts_recovering(b, it, blk).ended;
        match (&blk.tail)
        {
            Some(eb) :
            {
                ref<Expr, shared> e = Box::get(eb);
                if (!ended)
                {
                    HashSet<String> mentions = HashSet::new();
                    HashSet<String> bound = HashSet::new();
                    collect_free_vars_expr(e, &mut bound, &mut mentions);
                    if (mentions_poisoned(b, &mentions))
                    {
                        b.skipped = true;
                    }
                    else
                    {
                        Option<Type> rt0 = Some(clone(ret));
                        Result<void, String> esc = check_escape_to_caller(b, it, e);
                        if (Result::is_ok(&esc))
                        {
                            esc = check_holder_escape_to_caller(b, it, e, &rt0);
                        }
                        Result<Option<Type>, String> t = match (esc)
                        {
                            Err(d) : Err(sprintf("%s%s", &d, &diag_at(e.line, e.col))),
                            Ok(_)  :
                            {
                                Option<Type> rt = Some(clone(ret));
                                check_store_operand(b, it, e, &rt)
                            },
                        };
                        match (t)
                        {
                            Err(d) : Vec::push(&mut b.recovered, d),
                            Ok(_)  : {},
                        }
                    }
                }
            },
            None     : {},
        }
        exit_scope(b);
        gamma_undo(b, gamma_mark);
        return Ok(Some(Type::TNever));
    }
    match (check_block_stmts(b, it, blk))
    {
        Ok(t)  : last_stmt_ty = t,
        Err(e) : r = Err(e),
    }
    if (Result::is_ok(&r))
    {
        r = match (&blk.tail)
        {
            Some(eb) :
            {
                ref<Expr, shared> e = Box::get(eb);
                Option<Type> rt0 = Some(clone(ret));
                Result<void, String> esc = check_escape_to_caller(b, it, e);
                if (Result::is_ok(&esc))
                {
                    esc = check_holder_escape_to_caller(b, it, e, &rt0);
                }
                match (esc)
                {
                    Err(d) : Err(sprintf("%s%s", &d, &diag_at(e.line, e.col))),
                    Ok(_)  :
                    {
                        Option<Type> rt = Some(clone(ret));
                        result_ref_reach(b, it, e, &rt);
                        bool ok = result_reach_ok(b, it, e, &rt);
                        bool saved_holding = replace(&mut b.holding, ok);
                        Result<Option<Type>, String> t = check_store_operand(b, it, e, &rt);
                        b.holding = saved_holding;
                        t
                    },
                }
            },
            None     :
            {
                bool nev = match (&last_stmt_ty)
                {
                    Some(Type::TNever) : true,
                    _                  : false,
                };
                Ok(Some(if (nev) { Type::TNever } else { Type::TVoid }))
            },
        };
    }
    if (Result::is_ok(&r))
    {
        match (check_unjoined_handles(b))
        {
            Err(e) : r = Err(e),
            Ok(_)  : {},
        }
    }
    exit_scope(b);
    gamma_undo(b, gamma_mark);
    r
}

// ---- rule.temporal.ref-escape (spec/10 §2, §3) ----

// Report 109 (D-0336): a closure without `move` stored into a container
// declared outside the block of one of its captures (`foreach (i in 0..3) {
// Vec::push(&mut fs, [i]() : usize { i * 10 }); }`) would keep a borrow of
// that capture after its block ends; `fn` values are no holders (D-0290), so
// the store itself is refused, naming the closure and the container.
fn closure_into_outer_container(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> callee, ref<Vec<Expr>, shared> args) : Result<void, String>
{
    if (!b.report || b.flow.unreachable || Vec::len(args) < 2)
    {
        return Ok(());
    }
    bool stores = is_std_fn(it, callee, "std::Vec::push") || is_std_fn(it, callee, "std::Vec::insert") || is_std_fn(
        it,
        callee,
        "std::HashMap::insert",
    ) || is_std_fn(it, callee, "std::Queue::push_back") || is_std_fn(it, callee, "std::Queue::push_front");
    if (!stores)
    {
        return Ok(());
    }
    String container = match (&strip_parens_tc(&args[0]).kind)
    {
        ExprKind::EBorrow(bb) : match (one_seg(strip_parens_tc(&Box::get(bb).e)))
        {
            Some(n) : String::clone(n),
            None    : return Ok(()),
        },
        _ : return Ok(()),
    };
    usize cb = match (HashMap::get(&b.decl_block, &container))
    {
        Some(k) : *k,
        None    : return Ok(()),
    };
    for (usize i = 1; i < Vec::len(args); i += 1)
    {
        closure_outlived(b, &args[i], cb, &container)?;
    }
    Ok(())
}

// The captures a closure value borrows: a literal's without `move`, or
// those of a binding such a literal was given to (`auto c = [i]() …;`).
fn closure_borrowed_caps(ref<Body, shared> b, ref<Expr, shared> e) : Option<Vec<String>>
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EClosure(c) :
        {
            ref<ClosureExpr, shared> cl = Box::get(c);
            if (cl.is_move) { None } else { Some(Vec::clone(&cl.captures)) }
        },
        _ : match (one_seg(strip_parens_tc(e)))
        {
            Some(n) : match (HashMap::get(&b.closure_borrows, n))
            {
                Some(cs) : Some(Vec::clone(cs)),
                None     : None,
            },
            None : None,
        },
    }
}

// The binding a field or element place is a part of (`fs[0]`, `s.cb`), not
// through a dereference; `None` for a whole binding.
fn projected_root_name(ref<Expr, shared> e) : Option<String>
{
    ref<Expr, shared> cur = strip_parens_tc(e);
    bool projected = false;
    while (true)
    {
        match (&cur.kind)
        {
            ExprKind::EField(fb) :
            {
                cur = strip_parens_tc(&Box::get(fb).e);
            },
            ExprKind::EIndex(ib) :
            {
                cur = strip_parens_tc(&Box::get(ib).a);
            },
            _                    : break,
        }
        projected = true;
    }
    if (!projected)
    {
        return None;
    }
    match (one_seg(cur))
    {
        Some(n) : Some(String::clone(n)),
        None    : None,
    }
}

// Report 109: refuses storing the closure `e` in `container`, declared in
// block `cb`, when `e` borrows a capture of a block `cb` strictly encloses.
fn closure_outlived(ref<Body, shared> b, ref<Expr, shared> e, usize cb, ref<String, shared> container) : Result<void, String>
{
    Vec<String> caps = match (closure_borrowed_caps(b, e))
    {
        Some(cs) : cs,
        None     : return Ok(()),
    };
    foreach (cap in &caps)
    {
        match (HashMap::get(&b.decl_block, cap))
        {
            Some(k) :
            {
                if (strictly_encloses(b, cb, *k))
                {
                    StringView c = shown_name(cap);
                    String msg = sprintf(
                        "the closure `[%s](…)` borrows `%s`, which ends with its block, but it is stored in `%s`, which lives on after that block; capture it by value: `move [%s](…)`",
                        c,
                        c,
                        shown_name(container),
                        c,
                    );
                    return Err(sprintf("%s%s", &named_diag("diag.destroy-while-aliased", &msg), &diag_at(e.line, e.col)));
                }
            },
            None    : {},
        }
    }
    Ok(())
}

// Does block `outer` strictly lexically enclose block `inner`?
fn strictly_encloses(ref<Body, shared> b, usize outer, usize inner) : bool
{
    usize cur = inner;
    while (true)
    {
        match (HashMap::get(&b.block_parent, cur))
        {
            Some(p) :
            {
                if (*p == outer)
                {
                    return true;
                }
                cur = *p;
            },
            None    : return false,
        }
    }
    false
}

fn referent(usize block, ref<String, shared> root) : Option<Referent>
{
    Some(Referent { .block = block, .root = String::clone(root) })
}

// `referent-block(e)` for a borrow expression, with the referent's root
// binding; `None` = unknown.
fn referent_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Referent>
{
    match (HashMap::get(&b.borrow_referents, e.id))
    {
        Some(r) : return clone(r),
        None    : {},
    }
    match (&e.kind)
    {
        ExprKind::EParen(x)   : referent_of(b, it, Box::get(x)),
        ExprKind::EBorrow(x)  : referent_of_place(b, it, &Box::get(x).e),
        // `&v[lo .. hi]` on a `StringView` is `StringView::part(v, lo, hi)`
        // (`[View-Form]`), a call taking the view by value: it borrows no
        // place of its own, as the call does not (D-0308).
        ExprKind::ESliceOf(x) : if (is_view_slice_base(b, it, &Box::get(x).base)) { None } else { referent_of_place(b, it, &Box::get(x).base) },
        ExprKind::ECall(cb)   :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            String key = match (resolve_fn_path(it, &c.callee))
            {
                Some(k) : k,
                None    : return None,
            };
            ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &key), "a function");
            // A result that is a reference, or holds one as a frame holds a
            // reference (`Option<ref<T, m>>`, a struct with a reference
            // field), refers to what its sources do (CHG-0439).
            // Report 291: one that keeps references in data (`Vec<StringView>`
            // of `split_whitespace`) does as well.
            if (!is_borrow_ty(&f.ret) && !frame_ref_type(it, &f.ret) && !holds_ref(it, &f.ret) && !may_hold_ref(it, &f.ret, 0))
            {
                return None;
            }
            // D-0318: with several sources, the innermost of those known:
            // the result may be any of them, so it lives no longer than that
            // one.
            Vec<usize> ks = source_positions(f);
            Option<Referent> inner = None;
            for (usize i = 0; i < Vec::len(&ks); i += 1)
            {
                if (ks[i] >= Vec::len(&c.args))
                {
                    continue;
                }
                match (source_arg_referent(b, it, &c.args[ks[i]]))
                {
                    Some(r) :
                    {
                        bool keep = match (&inner)
                        {
                            Some(o) : !strictly_encloses(b, o.block, r.block),
                            None    : false,
                        };
                        if (!keep)
                        {
                            inner = Some(r);
                        }
                    },
                    None    : {},
                }
            }
            inner
        },
        _                     : None,
    }
}

// The referent of an elided call's source argument: a borrow's, or the
// declaring block of a reference-typed binding a visible borrow initialized.
fn source_arg_referent(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> arg) : Option<Referent>
{
    match (&arg.kind)
    {
        ExprKind::EBorrow(_)  : referent_of(b, it, arg),
        ExprKind::ESliceOf(_) : referent_of(b, it, arg),
        ExprKind::EPath(p)    :
        {
            ref<PathExpr, shared> px = Box::get(p);
            if (Vec::len(&px.segs) != 1)
            {
                return None;
            }
            ref<String, shared> x = &px.segs[0];
            bool borrow_local = match (HashMap::get(&b.gamma, x))
            {
                Some(t) : is_borrow_ty(t),
                None    : false,
            };
            bool visible = match (HashMap::get(&b.ref_origin, x))
            {
                Some(o) : Option::is_some(o),
                None    : false,
            };
            if (borrow_local && visible)
            {
                return match (HashMap::get(&b.decl_block, x))
                {
                    Some(db) : referent(*db, x),
                    None     : None,
                };
            }
            None
        },
        _                     : None,
    }
}

fn origin_of(ref<Body, shared> b, ref<String, shared> x) : Option<Referent>
{
    match (HashMap::get(&b.ref_origin, x))
    {
        Some(o) : clone(o),
        None    : None,
    }
}

fn referent_of_place(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Referent>
{
    match (&e.kind)
    {
        ExprKind::EParen(x)  : referent_of_place(b, it, Box::get(x)),
        ExprKind::EField(x)  : referent_of_place(b, it, &Box::get(x).e),
        ExprKind::EIndex(x)  : referent_of_place(b, it, &Box::get(x).a),
        ExprKind::EDeref(xb) :
        {
            ref<Expr, shared> inner = Box::get(xb);
            match (&inner.kind)
            {
                ExprKind::EPath(p)  :
                {
                    if (Vec::len(&Box::get(p).segs) == 1)
                    {
                        return origin_of(b, &Box::get(p).segs[0]);
                    }
                    None
                },
                ExprKind::EParen(p) :
                {
                    Expr d = mk(ExprKind::EDeref(Box::new(clone(Box::get(p)))), e.line, e.col);
                    referent_of_place(b, it, &d)
                },
                _                   : None,
            }
        },
        ExprKind::EPath(p)   :
        {
            ref<PathExpr, shared> px = Box::get(p);
            if (Vec::len(&px.segs) != 1)
            {
                return None;
            }
            ref<String, shared> x = &px.segs[0];
            match (HashMap::get(&b.gamma, x))
            {
                Some(t) :
                {
                    if (is_borrow_ty(t))
                    {
                        return origin_of(b, x);
                    }
                    match (HashMap::get(&b.decl_block, x))
                    {
                        Some(db) : referent(*db, x),
                        None     : None,
                    }
                },
                None    : None,
            }
        },
        _                    : None,
    }
}

// A stored borrow: its referent block and root, and whether a closure
// holds it.
struct StoredBorrow
{
    usize block;
    String root;
    bool closure;
}

// The referents of the references `e` stores.
fn collect_stored_borrows(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Vec<StoredBorrow>, exclusive> out,
)
{
    match (&e.kind)
    {
        ExprKind::EBorrow(_)      : push_referent(b, it, e, out),
        ExprKind::ESliceOf(_)     : push_referent(b, it, e, out),
        ExprKind::EClosure(cb)    :
        {
            ref<ClosureExpr, shared> c = Box::get(cb);
            if (!c.is_move)
            {
                // A closure without `move` borrows each capture's binding, a
                // reference binding too (CHG-0438).
                for (usize i = 0; i < Vec::len(&c.captures); i += 1)
                {
                    ref<String, shared> name = &c.captures[i];
                    bool owned = HashMap::contains(&b.gamma, name);
                    if (owned)
                    {
                        match (HashMap::get(&b.decl_block, name))
                        {
                            Some(db) : Vec::push(
                                out,
                                StoredBorrow { .block = *db, .root = String::clone(name), .closure = true },
                            ),
                            None : {},
                        }
                    }
                }
            }
        },
        ExprKind::EParen(x)       : collect_stored_borrows(b, it, Box::get(x), out),
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            match (&c.callee.kind)
            {
                ExprKind::EPath(p) :
                {
                    ref<Vec<String>, shared> segs = &Box::get(p).segs;
                    usize n = Vec::len(segs);
                    if (Vec::len(&c.args) == 1 && n > 0 && HashMap::contains(
                        &it.enum_of_variant,
                        &segs[n - 1],
                    ) && !HashMap::contains(&it.fns, &String::join(segs, "::")))
                    {
                        collect_stored_borrows(b, it, &c.args[0], out);
                        return;
                    }
                },
                _                  : {},
            }
            push_referent(b, it, e, out);
        },
        ExprKind::EStructLit(sb)  :
        {
            ref<StructLitExpr, shared> s = Box::get(sb);
            for (usize i = 0; i < Vec::len(&s.fields); i += 1)
            {
                collect_stored_borrows(b, it, &s.fields[i].value, out);
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            for (usize i = 0; i < Vec::len(es); i += 1)
            {
                collect_stored_borrows(b, it, &es[i], out);
            }
        },
        ExprKind::EArrayRepeat(r) : collect_stored_borrows(b, it, &Box::get(r).value, out),
        ExprKind::EBlock(blk)     : tail_stored_borrows(b, it, blk, out),
        ExprKind::EUnsafe(blk)    : tail_stored_borrows(b, it, blk, out),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            tail_stored_borrows(b, it, &x.then_, out);
            match (&x.else_)
            {
                Some(el) : collect_stored_borrows(b, it, el, out),
                None     : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> x = Box::get(mb);
            for (usize i = 0; i < Vec::len(&x.arms); i += 1)
            {
                collect_stored_borrows(b, it, Box::get(&x.arms[i].body), out);
            }
        },
        _                         : {},
    }
}

fn push_referent(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e, ref<Vec<StoredBorrow>, exclusive> out)
{
    match (referent_of(b, it, e))
    {
        Some(r) :
        {
            Referent { block, root, .. } = r;
            Vec::push(out, StoredBorrow { .block = block, .root = root, .closure = false });
        },
        None    : {},
    }
}

fn tail_stored_borrows(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    ref<Vec<StoredBorrow>, exclusive> out,
)
{
    match (&blk.tail)
    {
        Some(t) : collect_stored_borrows(b, it, Box::get(t), out),
        None    : {},
    }
}

// `[Ref-Escape-Rejected]`, a store into a binding whose decl-block is
// `dest`.
fn check_escape_into(ref<Body, shared> b, ref<Items, shared> it, usize dest, ref<Expr, shared> e) : Result<void, String>
{
    Vec<StoredBorrow> bs = Vec::new();
    collect_stored_borrows(b, it, e, &mut bs);
    for (usize i = 0; i < Vec::len(&bs); i += 1)
    {
        if (strictly_encloses(b, dest, bs[i].block))
        {
            String msg = if (bs[i].closure)
            {
                sprintf(
                    "this stores a closure that borrows `%s` in a place that outlives it; capture by value with `move [...]`, or keep the closure inside that block",
                    shown_name(&bs[i].root),
                )
            }
            else
            {
                "this stores a reference in a place that outlives what it refers to, which ends with its own block; store an owned value instead, or keep the reference inside that block"
            };
            return Err(named_diag("diag.reference-escapes-scope", &msg));
        }
    }
    Ok(())
}

// `[Ref-Escape-Rejected]`, the function's result: rejected when the
// referent's root binding is not a reference-typed parameter.
fn check_escape_to_caller(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Result<void, String>
{
    // D-0340 §7: a handle returned from the frame that owns what its thread
    // borrows: the thread may still run when that ends.
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::ECall(cb) :
        {
            ref<CallExpr, shared> call = Box::get(cb);
            bool spawn = match (path_segs(&call.callee))
            {
                Some(segs) : Vec::len(segs) == 1 && segs[0] == "spawn" && !is_local(b, &segs[0]),
                None       : false,
            };
            if (spawn && Option::is_none(&b.closure_ret))
            {
                for (usize a = 0; a < Vec::len(&call.args); a += 1)
                {
                    Vec<StoredBorrow> lent = Vec::new();
                    collect_stored_borrows(b, it, &call.args[a], &mut lent);
                    foreach (sb in &lent)
                    {
                        bool ref_param = !sb.closure && HashSet::contains(&b.params, &sb.root) && match (HashMap::get(&b.gamma, &sb.root))
                        {
                            Some(t) : is_borrow_ty(t),
                            None    : false,
                        };
                        if (!ref_param)
                        {
                            String msg = sprintf(
                                "the returned handle's thread borrows `%s`, which ends when this function returns, while the thread may still run; move the value into the thread, share it as `Arc<T>`, or `join` before returning",
                                shown_name(&sb.root),
                            );
                            return Err(named_diag("diag.reference-escapes-scope", &msg));
                        }
                    }
                }
            }
        },
        _                   : {},
    }
    Vec<StoredBorrow> bs = Vec::new();
    collect_stored_borrows(b, it, e, &mut bs);
    for (usize i = 0; i < Vec::len(&bs); i += 1)
    {
        ref<String, shared> root = &bs[i].root;
        // A reference parameter's referent outlives the call; the parameter
        // itself, which a closure borrows, does not.
        bool ref_param = !bs[i].closure && HashSet::contains(&b.params, root) && match (HashMap::get(&b.gamma, root))
        {
            Some(t) : is_borrow_ty(t),
            None    : false,
        };
        if (!ref_param)
        {
            String msg = if (bs[i].closure)
            {
                sprintf(
                    "the returned closure borrows `%s`, which ends when this function returns; capture it by value with `move [...]`",
                    shown_name(root),
                )
            }
            else
            {
                sprintf(
                    "the result refers to `%s`, which ends when this function returns; a returned reference must come from a reference parameter -- return an owned value instead",
                    shown_name(root),
                )
            };
            return Err(named_diag("diag.reference-escapes-scope", &msg));
        }
    }
    Ok(())
}

// Report 291: a result that keeps references in data (`Vec<StringView>`, a
// `Vec` of structs holding views) whose facts reach an owner of this frame
// (`String src` it was split from) would refer to what ends when the
// function returns: refused, as a returned reference to it is.
fn check_holder_escape_to_caller(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e, ref<Option<Type>, shared> rt) : Result<void, String>
{
    // D-0340 §2: a reference or view returned through a binding too: its
    // facts on any path reaching a local of this frame are refused.
    bool borrow = match (rt)
    {
        Some(t) : is_borrow_ty(t) || match (t)
        {
            Type::THandle(_) : true,
            _                : false,
        },
        None : false,
    };
    // A reference result with no reference parameter is the signature's
    // error (`diag.lifetime-elision-ambiguous`), reported first.
    if (borrow)
    {
        bool any_ref_param = false;
        for (usize i = 0; i < HashSet::len(&b.params); i += 1)
        {
            match (HashMap::get(&b.gamma, HashSet::key_at(&b.params, i)))
            {
                Some(t) :
                {
                    if (is_borrow_ty(t))
                    {
                        any_ref_param = true;
                    }
                },
                None    : {},
            }
        }
        if (!any_ref_param && !Option::is_some(&b.closure_ret))
        {
            // (A `StringView` result may be static text: no elision error.)
            match (rt)
            {
                Some(Type::TRef(_))   : borrow = false,
                Some(Type::TSlice(_)) : borrow = false,
                _                     : {},
            }
        }
    }
    bool data = match (rt)
    {
        Some(t) : data_type(b, it, t),
        None    : false,
    } || borrow;
    // D-0340 §2: a closure without `move` given to a binding, returned.
    match (one_seg(strip_parens_tc(e)))
    {
        Some(n) :
        {
            if (!b.flow.unreachable && Option::is_none(&b.closure_ret) && !StringView::starts_with(&b.fn_name, "std::"))
            {
                match (HashMap::get(&b.closure_borrows, n))
                {
                    Some(cs) :
                    {
                        if (Vec::len(cs) > 0)
                        {
                            String msg = sprintf(
                                "the returned closure `%s` borrows `%s`, which ends when this function returns; capture it by value with `move [...]`",
                                shown_name(n),
                                shown_name(&cs[0]),
                            );
                            return Err(named_diag("diag.reference-escapes-scope", &msg));
                        }
                    },
                    None     : {},
                }
            }
        },
        None    : {},
    }
    if (!data || b.flow.unreachable || Option::is_some(&b.closure_ret) || StringView::starts_with(&b.fn_name, "std::"))
    {
        return Ok(());
    }
    Vec<DerivFact> v = match (inherited_facts(b, it, e, 0))
    {
        Some(v) : v,
        None    : return Ok(()),
    };
    Vec<String> owners = Vec::new();
    foreach (f in &v)
    {
        if (f.v != Tri::F)
        {
            frame_owners_reached(b, it, &f.key.root, 0, &mut owners);
        }
    }
    if (Vec::len(&owners) == 0)
    {
        return Ok(());
    }
    if (borrow)
    {
        String rmsg = sprintf(
            "the result refers to `%s` (on some path through this function), which ends when this function returns; a returned reference must come from a reference parameter -- return an owned value instead (a `String`, `StringView::to_string`)",
            shown_name(&owners[0]),
        );
        return Err(named_diag("diag.reference-escapes-scope", &rmsg));
    }
    String msg = sprintf(
        "the result holds references to `%s`, which ends when this function returns; a returned reference must come from a reference parameter -- return owned values instead (`String::copy` each part)",
        shown_name(&owners[0]),
    );
    Err(named_diag("diag.reference-escapes-scope", &msg))
}

// The owners of this frame (no reference, no holder of references, no
// parameter) a fact's root reaches, following the facts of the frame's
// references and holders it names (`*$d` of a `foreach` over a splitter's
// call: the text that loop's holder views). A reference with no facts
// reaches nothing known: none.
fn frame_owners_reached(ref<Body, shared> b, ref<Items, shared> it, StringView root, usize depth, ref<Vec<String>, exclusive> out)
{
    if (depth > 8 || StringView::starts_with(root, "<"))
    {
        return;
    }
    String rs = match (StringView::strip_prefix(root, "*"))
    {
        Some(r) : String::copy(r),
        None    : String::copy(root),
    };
    if (StringView::starts_with(&rs, "*") || StringView::starts_with(&rs, "<") || HashSet::contains(&b.params, &rs) || !HashMap::contains(&b.decl_block, &rs))
    {
        return;
    }
    bool holder = match (HashMap::get(&b.gamma, &rs))
    {
        // A raw pointer owns nothing its end destroys (`Rc { .ptr = bp }`).
        Some(Type::TRawptr(_)) : return,
        Some(t)                : is_borrow_ty(t) || stores_refs(it, t),
        None                   : return,
    };
    if (!holder)
    {
        // `*o` of an owner is no place `o` refers through: only `o` itself.
        if (!StringView::starts_with(root, "*") && !Vec::contains(out, &rs))
        {
            Vec::push(out, rs);
        }
        return;
    }
    match (HashMap::get(&b.flow.deriv, &rs))
    {
        Some(f) :
        {
            for (usize i = 0; i < HashMap::len(f); i += 1)
            {
                ref<DerivFact, shared> d = HashMap::value_at(f, i);
                if (d.v != Tri::F && d.key.root != rs)
                {
                    frame_owners_reached(b, it, &d.key.root, depth + 1, out);
                }
            }
        },
        None    : {},
    }
}

// A place: its root binding and its path.
struct Place
{
    String root;
    Vec<PElem> path;
}

fn is_named_ty(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(_) : true,
        _               : false,
    }
}

fn is_array_or_simd(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TArray(_) : true,
        Type::TSimd(_)  : true,
        _               : false,
    }
}

fn literal_index(ref<Expr, shared> idx) : Option<u128>
{
    match (literal_value(idx))
    {
        Some(v) : if (v >= 0) { Some(reinterpret<u128>(v)) } else { None },
        None    : None,
    }
}

fn single_tracked(ref<Body, shared> b, ref<Expr, shared> e) : Option<String>
{
    match (&e.kind)
    {
        ExprKind::EPath(p) :
        {
            ref<PathExpr, shared> x = Box::get(p);
            if (Vec::len(&x.segs) == 1 && flow_is_tracked(&b.flow, &x.segs[0]))
            {
                return Some(String::clone(&x.segs[0]));
            }
            None
        },
        _                  : None,
    }
}

// The syntactic place `x.π` an expression denotes, when its root is a
// tracked binding reached without crossing a reference.
fn place_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Place>
{
    match (&e.kind)
    {
        ExprKind::EParen(x)  : place_of(b, it, Box::get(x)),
        ExprKind::EPath(_) : match (single_tracked(b, e))
        {
            Some(x) : Some(Place { .root = x, .path = Vec::new() }),
            None    : None,
        },
        ExprKind::EField(fb) :
        {
            ref<FieldExpr, shared> f = Box::get(fb);
            Place p = place_of(b, it, &f.e)?;
            Type t = place_type(b, it, &p.root, &p.path)?;
            if (!is_named_ty(&t))
            {
                return None;
            }
            Vec::push(&mut p.path, PElem::PField(String::clone(&f.name)));
            Some(p)
        },
        ExprKind::EIndex(ib) :
        {
            ref<PairExpr, shared> x = Box::get(ib);
            Place p = place_of(b, it, &x.a)?;
            Type t = place_type(b, it, &p.root, &p.path)?;
            if (!is_array_or_simd(&t))
            {
                return None;
            }
            Vec::push(&mut p.path, PElem::PIndex(literal_index(&x.b)));
            Some(p)
        },
        _                    : None,
    }
}

fn is_ref_or_guard(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(_)   : true,
        Type::TGuard(_) : true,
        _               : false,
    }
}

// The root `*r` for a tracked reference or guard binding `r`.
fn deref_root(ref<Body, shared> b, ref<Expr, shared> base) : Option<Place>
{
    String x = single_tracked(b, strip_parens_tc(base))?;
    Type t = lookup_local(b, &x)?;
    if (is_ref_or_guard(&t))
    {
        return Some(Place { .root = referent_root(&x), .path = Vec::new() });
    }
    None
}

fn deref_through(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> base) : Option<Place>
{
    match (deref_place_of(b, it, base))
    {
        Some(p) : return Some(p),
        None    : {},
    }
    deref_root(b, base)
}

// D-0071: a place reached through a tracked reference or guard binding
// `r`, as a path from the root `*r`.
fn deref_place_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Place>
{
    match (&e.kind)
    {
        ExprKind::EParen(x)  : deref_place_of(b, it, Box::get(x)),
        ExprKind::EDeref(x)  : deref_root(b, Box::get(x)),
        ExprKind::EField(fb) :
        {
            ref<FieldExpr, shared> f = Box::get(fb);
            Place p = deref_through(b, it, &f.e)?;
            Type t = place_type(b, it, &p.root, &p.path)?;
            if (!is_named_ty(&t))
            {
                return None;
            }
            Vec::push(&mut p.path, PElem::PField(String::clone(&f.name)));
            Some(p)
        },
        ExprKind::EIndex(ib) :
        {
            ref<PairExpr, shared> x = Box::get(ib);
            Place p = deref_through(b, it, &x.a)?;
            Type t = place_type(b, it, &p.root, &p.path)?;
            if (!is_array_or_simd(&t))
            {
                return None;
            }
            Vec::push(&mut p.path, PElem::PIndex(literal_index(&x.b)));
            Some(p)
        },
        _                    : None,
    }
}

// A struct's field type, substituted.
fn field_type(
    ref<Items, shared> it,
    ref<String, shared> sname,
    ref<Vec<Type>, shared> args,
    ref<String, shared> fname,
) : Option<Type>
{
    ref<StructDecl, shared> sd = HashMap::get(&it.structs, sname)?;
    HashMap<String, Type> subst = zip_subst(&sd.type_params, args);
    for (usize i = 0; i < Vec::len(&sd.fields); i += 1)
    {
        if (sd.fields[i].name == *fname)
        {
            return Some(apply_subst(&sd.fields[i].ty, &subst));
        }
    }
    None
}

// The static type at `x.π`, from `gamma` and the declarations.
fn place_type(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<String, shared> x,
    ref<Vec<PElem>, shared> path,
) : Option<Type>
{
    // The root's type is read in place; only what the path reaches is a copy.
    String deref_name = String::new();
    bool deref = match (StringView::strip_prefix(x, "*"))
    {
        Some(r) :
        {
            deref_name = String::copy(r);
            true
        },
        None    : false,
    };
    ref<Type, shared> root = if (deref)
    {
        match (HashMap::get(&b.gamma, &deref_name)?)
        {
            Type::TRef(rb)   : &Box::get(rb).inner,
            Type::TGuard(gb) : Box::get(gb),
            _                : return None,
        }
    }
    else { HashMap::get(&b.gamma, x)? };
    if (Vec::len(path) == 0)
    {
        return Some(clone(root));
    }
    Type t = place_step(it, root, &path[0])?;
    for (usize i = 1; i < Vec::len(path); i += 1)
    {
        t = place_step(it, &t, &path[i])?;
    }
    Some(t)
}

// The type one step of a place's path reaches from `t`.
fn place_step(ref<Items, shared> it, ref<Type, shared> t, ref<PElem, shared> step) : Option<Type>
{
    match (step)
    {
        PElem::PField(f) : match (t)
        {
            Type::TNamed(nb) : field_type(it, &Box::get(nb).name, &Box::get(nb).args, f),
            _                : None,
        },
        PElem::PIndex(_) : match (t)
        {
            Type::TArray(ab) : Some(clone(&Box::get(ab).inner)),
            Type::TSimd(ab)  : Some(clone(&Box::get(ab).inner)),
            _                : None,
        },
        _ : None,
    }
}

fn through_ref_or_guard(Type t) : Type
{
    match (t)
    {
        Type::TRef(b)   : ModedTy::take_inner(b),
        Type::TGuard(b) : Box::into_inner(b),
        other           : other,
    }
}

// The static type of a place-shaped expression, computed without walking
// it.
fn static_place_type(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Type>
{
    match (&e.kind)
    {
        ExprKind::EParen(x)  : static_place_type(b, it, Box::get(x)),
        ExprKind::EPath(p)   :
        {
            if (Vec::len(&Box::get(p).segs) == 1)
            {
                return lookup_local(b, &Box::get(p).segs[0]);
            }
            None
        },
        ExprKind::EDeref(x)  :
        {
            match (static_place_type(b, it, Box::get(x))?)
            {
                Type::TRef(rb)    : Some(ModedTy::take_inner(rb)),
                Type::TGuard(gb)  : Some(Box::into_inner(gb)),
                Type::TRawptr(pb) : Some(Box::into_inner(pb)),
                _                 : None,
            }
        },
        ExprKind::EField(fb) :
        {
            ref<FieldExpr, shared> f = Box::get(fb);
            Type bt = through_ref_or_guard(static_place_type(b, it, &f.e)?);
            match (&bt)
            {
                Type::TNamed(nb) : field_type(it, &Box::get(nb).name, &Box::get(nb).args, &f.name),
                _                : None,
            }
        },
        ExprKind::EIndex(ib) :
        {
            Type bt = through_ref_or_guard(static_place_type(b, it, &Box::get(ib).a)?);
            bool is_array = match (&bt)
            {
                Type::TArray(_) : true,
                _               : false,
            };
            if (!is_array)
            {
                match (indexed_elem(&bt))
                {
                    Some(t) : return Some(t),
                    None    : {},
                }
            }
            match (bt)
            {
                Type::TArray(ab) : Some(SizedTy::take_inner(ab)),
                Type::TSimd(ab)  : Some(SizedTy::take_inner(ab)),
                _                : None,
            }
        },
        ExprKind::ECall(cb)  :
        {
            String key = resolve_fn_path(it, &Box::get(cb).callee)?;
            ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &key), "a function");
            if (Vec::len(&f.type_params) == 0)
            {
                return Some(clone(&f.ret));
            }
            match (&f.ret)
            {
                // A generic call's reference result, its type arguments read
                // off its arguments' shapes, so a field or element through it
                // is a place (`Box::get(p).segs[0]`); where they stay unknown
                // only its mode is ever consulted.
                Type::TRef(_) :
                {
                    HashMap<String, Type> m = HashMap::new();
                    ref<Vec<Expr>, shared> args = &Box::get(cb).args;
                    for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(args); i += 1)
                    {
                        Option<Type> shape = match (&strip_parens_tc(&args[i]).kind)
                        {
                            ExprKind::EBorrow(bb) : match (static_place_type(b, it, &Box::get(bb).e))
                            {
                                Some(t) : Some(Type::TRef(Box::new(ModedTy { .inner = t, .mode = Box::get(bb).mode }))),
                                None    : None,
                            },
                            _ : static_place_type(b, it, &args[i]),
                        };
                        match (&shape)
                        {
                            Some(t) : unify_type_shape(&f.params[i].ty, t, &mut m, &f.type_params),
                            None    : {},
                        }
                    }
                    Some(apply_subst(&f.ret, &m))
                },
                _             : None,
            }
        },
        _                    : None,
    }
}

// D-0053: whether `&base[..]` makes a `StringView`: `Some(true)` for a
// `String`, `Some(false)` for a `StringView`.
// D-0308: `base`, sliced, is a `StringView` (`[View-Form]`'s second form).
fn is_view_slice_base(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> base) : bool
{
    match (view_base(b, it, base))
    {
        Some(on_string) : !on_string,
        None            : false,
    }
}

fn view_base(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> base) : Option<bool>
{
    // A generic call's result too (`&Option::unwrap_or(o, d)[0..$]`, as
    // D-0302 writes `&Option::unwrap_or(o, d)` where a view is declared).
    // And `*e` of a reference a call gives (`&(*h(&s))[0..$]`, which
    // `[Coerce-Text]` writes for a `ref<String, _>` result).
    Type t = match (static_place_type(b, it, base))
    {
        Some(x) : x,
        None : match (&strip_parens_tc(base).kind)
        {
            ExprKind::EDeref(inner) :
            {
                // `*&x` too (`[Cmp-Through-Shared-Ref]` writes `&(*&s)[0..$]`).
                match (&strip_parens_tc(Box::get(inner)).kind)
                {
                    ExprKind::EBorrow(bb) :
                    {
                        return match (static_place_type(b, it, &Box::get(bb).e))
                        {
                            Some(x) : view_kind(&x),
                            None    : view_kind(&value_shape(b, it, &Box::get(bb).e)?),
                        };
                    },
                    _                     : {},
                }
                Type rt = match (static_place_type(b, it, Box::get(inner)))
                {
                    Some(x) : x,
                    None    : value_shape(b, it, Box::get(inner))?,
                };
                match (rt)
                {
                    Type::TRef(rb)   : ModedTy::take_inner(rb),
                    // `[Guard-Deref]`: `*e` of a guard, a temporary too.
                    Type::TGuard(gb) : Box::into_inner(gb),
                    _                : return None,
                }
            },
            _                       : value_shape(b, it, base)?,
        },
    };
    view_kind(&t)
}

// `Some(true)` for a `String` (through a reference too), `Some(false)` for a
// `StringView`, else `None`.
fn view_kind(ref<Type, shared> t) : Option<bool>
{
    ref<Type, shared> u = match (t)
    {
        Type::TRef(rb) : &Box::get(rb).inner,
        _              : t,
    };
    if (named_is(u, "std::String"))
    {
        return Some(true);
    }
    if (named_is(u, "std::StringView"))
    {
        return Some(false);
    }
    None
}

fn ref_mode_of(ref<Option<Type>, shared> t) : Option<Mode>
{
    match (t)
    {
        Some(Type::TRef(rb)) : Some(Box::get(rb).mode),
        _                    : None,
    }
}

// Does evaluating `e` as a place cross a `ref<_, shared>`?
fn crosses_shared(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EParen(x)  : crosses_shared(b, it, Box::get(x)),
        ExprKind::EDeref(x)  :
        {
            // D-0314: so is `*&e` (`[Ref-Form-Const]`'s `(*&K)[…]` among them):
            // what a shared borrow reaches is read-only however it is reached;
            // `*&mut e` crosses what `e` does.
            match (&strip_parens_tc(Box::get(x)).kind)
            {
                ExprKind::EBorrow(bb) :
                {
                    return Box::get(bb).mode == Mode::Shared || crosses_shared(b, it, &Box::get(bb).e);
                },
                _                     : {},
            }
            Option<Type> t = static_place_type(b, it, Box::get(x));
            match (ref_mode_of(&t))
            {
                Some(Mode::Shared)    : true,
                Some(Mode::Exclusive) : crosses_shared(b, it, Box::get(x)),
                None                  : false,
            }
        },
        ExprKind::EField(fb) : base_crosses(b, it, &Box::get(fb).e),
        ExprKind::EIndex(ib) : base_crosses(b, it, &Box::get(ib).a),
        _                    : false,
    }
}

fn base_crosses(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> base) : bool
{
    bool shared_ref = match (static_place_type(b, it, base))
    {
        Some(Type::TRef(rb))   : Box::get(&rb).mode == Mode::Shared,
        Some(Type::TSlice(sb)) : Box::get(&sb).mode == Mode::Shared,
        _                      : false,
    };
    shared_ref || crosses_shared(b, it, base)
}

fn place_is_resource(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<String, shared> x,
    ref<Vec<PElem>, shared> path,
) : bool
{
    match (place_type(b, it, x, path))
    {
        Some(t) : is_resource_ty(it, &t),
        None    : false,
    }
}

// `¬clash(a, m)` for an access at place `x.π`.
fn flow_clash(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> x,
    ref<Vec<PElem>, shared> path,
    Mode mode,
    str diag,
) : Result<void, String>
{
    flow_clash_saying(b, it, x, path, mode, diag, None)
}

fn permitted(Mode m1, Mode m2) : bool
{
    m1 == Mode::Shared && m2 == Mode::Shared
}

// `flow_clash`, the message naming the access (`need`) when it is not a
// plain read, write or borrow.
fn flow_clash_saying(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> x,
    ref<Vec<PElem>, shared> path,
    Mode mode,
    str diag,
    Option<str> need,
) : Result<void, String>
{
    flow_clash_report(b, it, x, path, mode);
    Option<String> best = None;
    Mode best_mode = Mode::Shared;
    bool best_maybe = false;
    // Bug 021: the holders listed for `x` (for a shared access, those with
    // an exclusive fact: a shared one is permitted); the first by name.
    Vec<String> hs = holders_of(&b.flow, x, mode == Mode::Shared);
    foreach (h in &hs)
    {
        ref<HashMap<String, DerivFact>, shared> facts = match (HashMap::get(&b.flow.deriv, h))
        {
            Some(m) : m,
            None    : continue,
        };
        for (usize k = 0; k < HashMap::len(facts); k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            // Report 313: a thread that may hold it (lent on an earlier round
            // of a loop, on some paths) conflicts or not as the threads run:
            // the program's outcome would depend on timing, so it is refused.
            // D-0340 §8: element places too; two indices are one place unless
            // both are known and differ (`paths_overlap`).
            bool maybe_thread = d.v == Tri::U && thread_holder(b, h) && held_across_rounds(b, h);
            // D-0341 (report 392): a holder of references in data that may
            // hold `x` here, and that has an element read later (`h[i]`): on
            // that path the read faults whatever the holder holds (no element:
            // out of bounds; the element: the reference written through), so
            // the conflict is certain there. A holder only measured later
            // (`Vec::len(&h)`) after a `pop` may hold nothing: the run's; so
            // is a loan of one element (`&v[0]`), which a write elsewhere
            // in `v` (`Vec::swap(&mut v, 1, 2)`) may leave alone.
            bool maybe_data = d.v == Tri::U && !maybe_thread && !thread_holder(b, h) && d.key.root == *x && Vec::len(&d.key.path) == 0 && data_type_root(b, it, h) && paths_overlap(&d.key.path, path) && !permitted(mode, d.key.mode) && rep_elem_read_after(&b.rep, h, b.current_line, b.current_col);
            if ((d.v == Tri::T || maybe_thread || maybe_data) && (d.key.root == *x) && paths_overlap(&d.key.path, path) && !permitted(mode, d.key.mode))
            {
                bool better = match (&best)
                {
                    Some(bh) : (*h < *bh),
                    None     : true,
                };
                if (better)
                {
                    best = Some(String::clone(h));
                    best_mode = d.key.mode;
                    best_maybe = d.v != Tri::T;
                }
            }
        }
    }
    // The first holder by name, so the message is the same every run.
    match (best)
    {
        Some(h) :
        {
            String need_text = match (need)
            {
                Some(n) : String::copy(n),
                None    :
                {
                    if (diag == "diag.aliasing-conflict" && mode == Mode::Exclusive)
                    {
                        "so it cannot be written or borrowed `mut` here"
                    }
                    else if (diag == "diag.aliasing-conflict")
                    {
                        "so it cannot be read here"
                    }
                    else
                    {
                        "so it cannot be moved or destroyed here"
                    }
                },
            };
            bool excl = best_mode == Mode::Exclusive;
            StringView xs = shown_name(x);
            String who = if (is_loop_holder(&h))
            {
                if (excl)
                {
                    sprintf(
                        "the `foreach` loop over `%s` borrows it exclusively",
                        xs,
                    )
                }
                else { sprintf("the `foreach` loop over `%s` still borrows it", xs) }
            }
            else if (thread_holder(b, &h))
            {
                // A thread's handle, or a `Vec` of them: what `spawn` lent the
                // thread (D-0213), said so (session finding 001-C4).
                if (best_maybe)
                {
                    sprintf(
                        "`%s` may still be lent%s to a thread %s holds (`spawn`, D-0213; lent on an earlier round of the loop), and whether that thread has ended depends on timing",
                        xs,
                        if (excl) { " exclusively" } else { "" },
                        &holder_text(&h),
                    )
                }
                else if (excl)
                {
                    sprintf("`%s` is lent exclusively to a thread %s holds (`spawn`, D-0213)", xs, &holder_text(&h))
                }
                else { sprintf("`%s` is lent to a thread %s holds (`spawn`, D-0213)", xs, &holder_text(&h)) }
            }
            else
            {
                if (excl)
                {
                    sprintf(
                        "%s borrows `%s` exclusively",
                        &holder_text(&h),
                        xs,
                    )
                }
                else if (best_maybe)
                {
                    sprintf("%s may still borrow `%s` (on some path to here), and an element of it is read later", &holder_text(&h), xs)
                }
                else { sprintf("%s still borrows `%s`", &holder_text(&h), xs) }
            };
            // Bug 255: a closure holds what it captures for as long as it
            // exists; the way to end that is its scope or `drop`.
            bool closure_holder = match (HashMap::get(&b.gamma, &h))
            {
                Some(Type::TFn(_)) : true,
                _                  : false,
            };
            if (closure_holder && !is_loop_holder(&h) && !thread_holder(b, &h))
            {
                StringView hs = shown_name(&h);
                bool through_ref = match (HashMap::get(&b.gamma, x))
                {
                    Some(Type::TRef(_)) : true,
                    _                   : false,
                };
                String cmsg = sprintf(
                    "the closure `%s` %s `%s`, and borrows it%s for as long as `%s` exists, %s",
                    hs,
                    if (excl && through_ref) { "writes through" } else if (excl) { "writes" } else { "reads" },
                    xs,
                    if (excl) { " exclusively" } else { "" },
                    hs,
                    &need_text,
                );
                String crep = sprintf(
                    "put `%s` and its calls in a `{ }` block of their own that ends before this, or `drop(%s);` before this",
                    hs,
                    hs,
                );
                refute(b, &named_diag(diag, &with_repair(&cmsg, &crep)))?;
                return Ok(());
            }
            String msg = sprintf("%s, %s; end that borrow first", &who, &need_text);
            refute(b, &named_diag(diag, &msg))?;
        },
        None    : {},
    }
    Ok(())
}

// `solitary(a_x)`: refuted when some `deriv(·, x.·, ·) = T`.
fn flow_solitary(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> x, str diag) : Result<void, String>
{
    Option<String> best = None;
    // Bug 021: the holders listed for `x`; the first by name.
    Vec<String> hs = holders_of(&b.flow, x, false);
    bool unsure = false;
    foreach (h in &hs)
    {
        ref<HashMap<String, DerivFact>, shared> facts = match (HashMap::get(&b.flow.deriv, h))
        {
            Some(m) : m,
            None    : continue,
        };
        for (usize k = 0; k < HashMap::len(facts); k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            if (d.v == Tri::U && (d.key.root == *x))
            {
                unsure = true;
            }
            if (d.v == Tri::T && (d.key.root == *x))
            {
                bool better = match (&best)
                {
                    Some(bh) : (*h < *bh),
                    None     : true,
                };
                if (better)
                {
                    best = Some(String::clone(h));
                }
            }
        }
    }
    // A reference that may reach it, on some paths: the run's (the first
    // in the facts' order; looked for when a listed holder has one).
    if (Option::is_none(&best) && unsure && b.report && !b.flow.unreachable)
    {
        Option<String> maybe = None;
        for (usize i = 0; i < HashMap::len(&b.flow.deriv) && Option::is_none(&maybe); i += 1)
        {
            ref<String, shared> h = HashMap::key_at(&b.flow.deriv, i);
            ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&b.flow.deriv, i);
            bool any = false;
            for (usize k = 0; k < HashMap::len(facts) && !any; k += 1)
            {
                ref<DerivFact, shared> d = HashMap::value_at(facts, k);
                any = d.v == Tri::U && (d.key.root == *x);
            }
            if (any && holder_live_after(b, it, h))
            {
                maybe = Some(String::clone(h));
            }
        }
        match (maybe)
        {
            Some(h) :
            {
                usize line = b.current_line;
                b.rep.checks += 1;
                b.rep.undecided += 1;
                Vec::push(&mut b.rep.events, sprintf("U\t%v\t%s\tmove\t%s\t%v", line, x, &h, line));
                rep_left(
                    b,
                    sprintf(
                        "line %v: a move of `%s` that a reference may reach on some paths",
                        line,
                        shown_name(x),
                    ),
                );
            },
            None    : {},
        }
    }
    match (best)
    {
        Some(h) :
        {
            StringView xs = shown_name(x);
            String who = if (is_loop_holder(&h))
            {
                sprintf(
                    "the `foreach` loop over `%s` still borrows it",
                    xs,
                )
            }
            else { sprintf("%s still borrows `%s`", &holder_text(&h), xs) };
            String msg = sprintf("%s, so it cannot be moved or destroyed here; end that borrow first", &who);
            refute(b, &named_diag(diag, &msg))?;
        },
        None    : {},
    }
    Ok(())
}

// D-0282: `flow_clash`'s report: the check made, those a fact of `?`
// leaves undecided, and the places only values decide (a point check).
fn flow_clash_report(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> x,
    ref<Vec<PElem>, shared> path,
    Mode mode,
)
{
    if (!b.report || b.flow.unreachable)
    {
        return;
    }
    Vec<String> undecided = Vec::new();
    bool maybe = false;
    // Bug 021: the holders listed for `x`, as in `flow_clash_saying` (what
    // is found is sorted).
    Vec<String> hs = holders_of(&b.flow, x, mode == Mode::Shared);
    foreach (h in &hs)
    {
        ref<HashMap<String, DerivFact>, shared> facts = match (HashMap::get(&b.flow.deriv, h))
        {
            Some(m) : m,
            None    : continue,
        };
        Option<bool> live = None;
        for (usize k = 0; k < HashMap::len(facts); k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            if (d.v == Tri::F || d.key.root != *x || permitted(mode, d.key.mode))
            {
                continue;
            }
            bool undec = d.v == Tri::U && paths_overlap(&d.key.path, path);
            bool mb = overlap3(&d.key.path, path) == Ov::OvMaybe;
            if (!undec && !mb)
            {
                continue;
            }
            bool is_live = match (live)
            {
                Some(l) : l,
                None    :
                {
                    bool l = holder_live_after(b, it, h);
                    live = Some(l);
                    l
                },
            };
            if (!is_live)
            {
                continue;
            }
            if (undec)
            {
                Vec::push(&mut undecided, sprintf("U\t%v\t%s\t%s\t%s", b.current_line, x, mode_debug(d.key.mode), h));
            }
            if (mb)
            {
                maybe = true;
            }
        }
    }
    Vec::sort(&mut undecided);
    usize line = b.current_line;
    if (maybe)
    {
        b.rep.point_checks += 1;
        Vec::push(&mut b.rep.events, sprintf("P\t%v\t%s\taccess", line, x));
        rep_left(
            b,
            sprintf("line %v: an access to `%s` that only values decide", line, shown_name(x)),
        );
    }
    b.rep.checks += 1;
    if (Vec::len(&undecided) > 0)
    {
        b.rep.undecided += 1;
        Vec::push(&mut b.rep.events, sprintf("%s\t%v", &undecided[0], line));
        rep_left(
            b,
            sprintf(
                "line %v: an access to `%s` that a reference may reach on some paths",
                line,
                shown_name(x),
            ),
        );
    }
}

fn tri_is(ref<HashMap<String, Tri>, shared> m, ref<String, shared> x, Tri want) : bool
{
    match (HashMap::get(m, x))
    {
        Some(t) : *t == want,
        None    : false,
    }
}

// `[Read]` of a place in value position: definite assignment,
// `[Read-Resource-Rejected]`, and `¬clash(a, shared)`.
fn flow_read(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e) : Result<void, String>
{
    Place p = match (place_of(b, it, e))
    {
        Some(p) : p,
        None : match (deref_place_of(b, it, e))
        {
            Some(dp) : return flow_clash(b, it, &dp.root, &dp.path, Mode::Shared, "diag.aliasing-conflict"),
            None     :
            {
                holder_deref_access(b, it, e, Mode::Shared);
                return Ok(());
            },
        },
    };
    if (!tri_is(&b.flow.init, &p.root, Tri::T))
    {
        refute(b, &uninit_msg(&p.root))?;
    }
    if (place_is_resource(b, it, &p.root, &p.path))
    {
        // A name the desugaring made is not the program's to see.
        String shown = if (StringView::starts_with(&p.root, "$"))
        {
            "this value"
        }
        else if (Vec::len(&p.path) == 0)
        {
            sprintf("`%s`", &p.root)
        }
        else
        {
            sprintf("this part of `%s`", &p.root)
        };
        // Bug 118: a `mutex` and an `Atomic` are read and changed through
        // their own operations, never copied.
        Option<Type> rt = if (Vec::len(&p.path) == 0) { lookup_local(b, &p.root) } else { None };
        bool is_mutex = match (&rt)
        {
            Some(Type::TMutex(_)) : true,
            _                     : false,
        };
        bool is_atomic = match (&rt)
        {
            Some(t) : named_is(t, "std::Atomic"),
            None    : false,
        };
        String msg = if (is_mutex)
        {
            sprintf(
                "diag.read-of-resource\u{1}%s is a `mutex`, whose value is read and changed through its lock: `*lock(&%s) += 1`, `i32 now = *lock(&%s);`\u{3}\u{3}",
                &shown,
                &p.root,
                &p.root,
            )
        }
        else if (is_atomic)
        {
            sprintf(
                "diag.read-of-resource\u{1}%s is an `Atomic`, read and changed by its functions: `Atomic::load(&%s)`, `Atomic::fetch_add(&%s, 1)`, `Atomic::store(&%s, v)`\u{3}\u{3}",
                &shown,
                &p.root,
                &p.root,
                &p.root,
            )
        }
        else
        {
            sprintf(
                "diag.read-of-resource\u{1}%s holds a resource, which is never copied: move it, lend it (`&`), or make a copy with its type's `clone`",
                &shown,
            )
        };
        refute(b, &msg)?;
    }
    flow_clash(b, it, &p.root, &p.path, Mode::Shared, "diag.aliasing-conflict")
}

// D-0340 §5: the `lits` value that says an `Option` binding is `None` on
// every path here (no integer binding is given it: `known_value` reads it as
// unknown).
fn empty_mark() : i128
{
    min_value<i128>()
}

fn is_none_literal(ref<Expr, shared> e) : bool
{
    match (path_segs(strip_parens_tc(e)))
    {
        Some(segs) : Vec::len(segs) >= 1 && segs[Vec::len(segs) - 1] == "None",
        None       : false,
    }
}

// D-0340 §5: an `Option<R>` binding whose `R` always owns something and
// does more than free memory may hold one unless `None` on every path.
fn option_resource_payload(ref<Items, shared> it, ref<Type, shared> t) : Option<Type>
{
    match (t)
    {
        Type::TNamed(nb) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (n.name == "std::Option" && Vec::len(&n.args) == 1)
            {
                ref<Type, shared> x = &n.args[0];
                if (always_owns(it, x) && !quiet_ty(it, x) && !has_unresolved_marker(x))
                {
                    return Some(clone(x));
                }
            }
            None
        },
        _                : None,
    }
}

// `[Write]` to a place.
fn flow_write(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> lhs) : Result<void, String>
{
    bool known_empty = false;
    match (place_of(b, it, lhs))
    {
        Some(p) :
        {
            known_empty = Vec::len(&p.path) == 0 && match (HashMap::get(&b.flow.lits, &p.root))
            {
                Some(v) : *v == empty_mark(),
                None    : false,
            };
            fl_lit(&mut b.flow, &p.root, None);
        },
        None    : {},
    }
    // Report 356 (D-0339): an element of a `Vec` or a slice exists when the
    // write reaches it (an index past the end faults first), so a value that
    // always owns something there is live, and `=` would lose it.
    match (&strip_parens_tc(lhs).kind)
    {
        ExprKind::EIndex(ib) :
        {
            Option<Type> elem = match (static_place_type(b, it, &Box::get(ib).a))
            {
                Some(t) :
                {
                    Type under = strip_refs(&t);
                    let_elem_of(&under)
                },
                None    : None,
            };
            match (elem)
            {
                Some(et) :
                {
                    if (always_owns(it, &et) && !quiet_ty(it, &et) && !has_unresolved_marker(&et))
                    {
                        refute(b, &sprintf(
                            "diag.overwrite-of-live-resource\u{1}this element still holds a `%s`, which this assignment would lose; write `overwrite(&mut place, v)` to destroy the old value, or `replace(&mut place, v)` to keep it",
                            &type_display(&et),
                        ))?;
                    }
                },
                None     : {},
            }
        },
        _                    : {},
    }
    Place p = match (place_of(b, it, lhs))
    {
        Some(p) : p,
        None : match (deref_place_of(b, it, lhs))
        {
            Some(dp) :
            {
                // D-0095: a write through a valid exclusive reference
                // reaches a live object.
                if (deref_ref_valid(b, it, lhs))
                {
                    refute_live_part_overwrite(b, it, &dp.root, &dp.path, lhs)?;
                }
                return flow_clash(b, it, &dp.root, &dp.path, Mode::Exclusive, "diag.aliasing-conflict");
            },
            None     :
            {
                holder_deref_access(b, it, lhs, Mode::Exclusive);
                return Ok(());
            },
        },
    };
    Vec<PElem> none = Vec::new();
    if (Vec::len(&p.path) == 0)
    {
        // D-0049: statically only where every value of the type owns
        // something.
        bool owns = match (place_type(b, it, &p.root, &none))
        {
            // Report 288: a type naming a type parameter (`Vec<T>`) is judged
            // in each instantiation, as a bare `T` is.
            Some(t) : always_owns(it, &t) && !quiet_ty(it, &t) && !has_unresolved_marker(&t),
            None    : false,
        };
        if (place_is_resource(
            b,
            it,
            &p.root,
            &none,
        ) && owns && tri_is(&b.flow.valid, &p.root, Tri::T) && tri_is(&b.flow.init, &p.root, Tri::T))
        {
            String ty = match (place_type(b, it, &p.root, &none))
            {
                Some(t) : type_display(&t),
                None    : String::new(),
            };
            StringView shown = last_segment(&p.root);
            refute(
                b,
                &sprintf(
                    "diag.overwrite-of-live-resource\u{1}`%s` still holds a `%s`, which this assignment would lose",
                    shown,
                    &ty,
                ),
            )?;
        }
        else if (!known_empty && b.report && !b.flow.unreachable && !tri_is(&b.flow.valid, &p.root, Tri::F) && !tri_is(&b.flow.init, &p.root, Tri::F))
        {
            match (place_type(b, it, &p.root, &none))
            {
                Some(t) : match (option_resource_payload(it, &t))
                {
                    Some(x) :
                    {
                        StringView shown = last_segment(&p.root);
                        refute(
                            b,
                            &sprintf(
                                "diag.overwrite-of-live-resource\u{1}`%s` may still hold a `%s` here (it is not `None` on every path to here), which this assignment would lose; write `overwrite(&mut %s, v)` to destroy the old value, or `replace(&mut %s, v)` to keep it",
                                shown,
                                &type_display(&x),
                                shown,
                                shown,
                            ),
                        )?;
                    },
                    None    : {},
                },
                None : {},
            }
        }
    }
    else if (!tri_is(&b.flow.init, &p.root, Tri::T))
    {
        // Bug 256: a part set before the whole has a value (C's field-by-
        // field initialisation) is a write, said so.
        StringView n = shown_name(&p.root);
        String part = Option::unwrap_or(place_text(lhs), "this part");
        String whole = match (place_type(b, it, &p.root, &none))
        {
            Some(t) :
            {
                bool is_struct = match (&t)
                {
                    Type::TNamed(nb) : HashMap::contains(&it.structs, &Box::get(nb).name),
                    _                : false,
                };
                if (is_struct)
                {
                    String tn = type_display(&t);
                    sprintf("a struct is given its value whole: `%s %s = %s { .field = …, … };`", &tn, n, &tn)
                }
                else
                {
                    sprintf("`%s` is given its value whole, where it is declared (`… %s = …;`)", n, n)
                }
            },
            None    : sprintf("`%s` is given its value whole, where it is declared (`… %s = …;`)", n, n),
        };
        String msg = sprintf(
            "`%s` is set here, but `%s` has no value yet on some path to here, and a part is set only in a value that exists; %s",
            &part,
            n,
            &whole,
        );
        refute(b, &named_diag("diag.use-of-uninitialized", &with_repair(&msg, "")))?;
    }
    else if (tri_is(&b.flow.valid, &p.root, Tri::T))
    {
        refute_live_part_overwrite(b, it, &p.root, &p.path, lhs)?;
    }
    flow_clash(b, it, &p.root, &p.path, Mode::Exclusive, "diag.aliasing-conflict")?;
    if (Vec::len(&p.path) == 0 && !b.flow.unreachable)
    {
        fl_tri(&mut b.flow, 1, &p.root, Some(Tri::T));
    }
    Ok(())
}

// D-0095: `[Write-Resource-Overwrite-Rejected]` refuted statically for a
// part of a live object.
// Report 356: the element type of a `Vec` or a slice.
fn let_elem_of(ref<Type, shared> t) : Option<Type>
{
    match (t)
    {
        Type::TSlice(_) : indexed_elem(t),
        _               : if (named_is(t, "std::Vec")) { indexed_elem(t) } else { None },
    }
}

fn refute_live_part_overwrite(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> x,
    ref<Vec<PElem>, shared> path,
    ref<Expr, shared> lhs,
) : Result<void, String>
{
    // Report 356: a `Vec` element's type, which `place_type` does not step to.
    Option<Type> vec_elem = None;
    for (usize i = 0; i < Vec::len(path); i += 1)
    {
        match (&path[i])
        {
            PElem::PField(_)  : {},
            PElem::PIndex(ix) :
            {
                // Report 356 (D-0339): an element of a `Vec` or a slice that
                // the write reaches exists (an index past the end faults
                // first), so it holds a live value whatever the index.
                Vec<PElem> before = Vec::new();
                for (usize j = 0; j < i; j += 1)
                {
                    Vec::push(&mut before, clone(&path[j]));
                }
                bool elements_live = match (place_type(b, it, x, &before))
                {
                    Some(Type::TSlice(_)) : true,
                    Some(t)               : named_is(&t, "std::Vec"),
                    None                  : false,
                };
                if (elements_live)
                {
                    if (i + 1 == Vec::len(path))
                    {
                        vec_elem = match (place_type(b, it, x, &before))
                        {
                            Some(t) : indexed_elem(&t),
                            None    : None,
                        };
                    }
                    continue;
                }
                match (ix)
                {
                    Some(k) :
                    {
                        Vec<PElem> prefix = Vec::new();
                        for (usize j = 0; j < i; j += 1)
                        {
                            Vec::push(&mut prefix, clone(&path[j]));
                        }
                        bool inside = match (place_type(b, it, x, &prefix))
                        {
                            Some(Type::TArray(ab)) : narrow_wrapping<u64>(*k) < narrow_wrapping<u64>(Box::get(&ab).n),
                            Some(Type::TSimd(ab))  : narrow_wrapping<u64>(*k) < narrow_wrapping<u64>(Box::get(&ab).n),
                            _                      : false,
                        };
                        if (!inside)
                        {
                            return Ok(());
                        }
                    },
                    None    : return Ok(()),
                }
            },
            PElem::PRange(_)  : return Ok(()),
            PElem::PSpan(_)   : return Ok(()),
        }
    }
    Type ty = match (place_type(b, it, x, path))
    {
        Some(t) : t,
        None : match (vec_elem)
        {
            Some(t) : t,
            None    : return Ok(()),
        },
    };
    // Report 288: judged in each instantiation when it names a type
    // parameter.
    if (!always_owns(it, &ty) || quiet_ty(it, &ty) || has_unresolved_marker(&ty))
    {
        return Ok(());
    }
    str place = match (&strip_parens_tc(lhs).kind)
    {
        ExprKind::EDeref(_) : "the place this reference reaches",
        _                   : "this field or element",
    };
    refute(b, &sprintf(
        "diag.overwrite-of-live-resource\u{1}%s still holds a `%s`, which this assignment would lose; write `overwrite(&mut place, v)` to destroy the old value, or `replace(&mut place, v)` to keep it",
        place,
        &type_display(&ty),
    ))
}

// ---- helpers ----

fn strip_parens_tc(ref<Expr, shared> e) : ref<Expr, shared>
{
    match (&e.kind)
    {
        ExprKind::EParen(x) : strip_parens_tc(Box::get(x)),
        _                   : e,
    }
}

fn uninit_msg(StringView x) : String
{
    StringView n = shown_name(x);
    String msg = sprintf(
        "`%s` is read here, but on some path to here it was never given a value; give it one where it is declared (`… %s = …;`) or on every path before this",
        n,
        n,
    );
    named_diag("diag.use-of-uninitialized", &msg)
}

// `rule.stdlib.hashmap`'s key types (spec/21 §1a, D-0041).
export fn is_key_type(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    Option::is_none(&key_type_problem(it, t, 0))
}

// D-0181: what `Vec::sort` and `PriorityQueue::new` order.
fn is_sort_type(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TF32 : true,
        Type::TF64 : true,
        // D-0336 (report 098): a view orders by its text.
        _          : is_key_type(it, t) || plain_named_ty(t, "std::StringView"),
    }
}

// Why `t` is not a key type (None when it is).
fn key_type_problem(ref<Items, shared> it, ref<Type, shared> t, usize depth) : Option<String>
{
    match (t)
    {
        Type::TInt(_) : return None,
        Type::TBool   : return None,
        Type::TStr    : return None,
        Type::TNever  : return None,
        _             : {},
    }
    if (named_is(t, "std::String"))
    {
        return None;
    }
    if (depth > 16)
    {
        return Some(sprintf("`%s` nests too deeply", &type_display(t)));
    }
    match (t)
    {
        Type::TNamed(nb) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            bool resource_ = match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) : s.resource_,
                None    : false,
            } || match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) : e.resource_,
                None    : false,
            };
            if (resource_)
            {
                return Some("it is declared `resource`");
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> sub = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        Type ft = apply_subst(&s.fields[i].ty, &sub);
                        if (Option::is_some(&key_type_problem(it, &ft, depth + 1)))
                        {
                            return Some(sprintf("its field `%s` is `%s`", &s.fields[i].name, &type_display(&ft)));
                        }
                    }
                    return None;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> sub = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) :
                            {
                                Type pt = apply_subst(p, &sub);
                                if (Option::is_some(&key_type_problem(it, &pt, depth + 1)))
                                {
                                    return Some(sprintf(
                                        "its variant `%s` holds `%s`",
                                        &e.variants[i].name,
                                        &type_display(&pt),
                                    ));
                                }
                            },
                            None    : {},
                        }
                    }
                    return None;
                },
                None    : {},
            }
        },
        _                : {},
    }
    Some(String::new())
}

// The message's tail naming why `t` is not a key type.
fn key_problem_text(ref<Items, shared> it, ref<Type, shared> t) : String
{
    match (key_type_problem(it, t, 0))
    {
        Some(r) : if (StringView::len(&r) > 0) { sprintf(": %s", &r) } else { String::new() },
        None    : String::new(),
    }
}

fn variant_has_payload(ref<EnumDecl, shared> e, ref<String, shared> name) : Option<bool>
{
    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
    {
        if (e.variants[i].name == *name)
        {
            return Some(Option::is_some(&e.variants[i].payload));
        }
    }
    None
}

// The type of the payload-less variant `segs` of `enum_name` written as a
// value: the enum, when it has no type parameters and (for a bare name) no
// other enum has a variant of that name (reports 142, 159, 210).
fn unit_variant_type(ref<Items, shared> it, ref<String, shared> enum_name, ref<Vec<String>, shared> segs) : Option<Type>
{
    match (HashMap::get(&it.enums, enum_name))
    {
        Some(e) :
        {
            if (Vec::len(&e.type_params) != 0)
            {
                return None;
            }
        },
        None    : return None,
    }
    if (Vec::len(segs) == 1)
    {
        for (usize i = 0; i < HashMap::len(&it.enums); i += 1)
        {
            if (*HashMap::key_at(&it.enums, i) != *enum_name && Option::is_some(&variant_has_payload(
                HashMap::value_at(&it.enums, i),
                &segs[0],
            )))
            {
                return None;
            }
        }
    }
    Some(Type::TNamed(Box::new(NamedTy { .name = String::clone(enum_name), .args = Vec::new() })))
}

// Whether the variant `segs` names has a payload: `Some(b)` when that is
// certain, `None` when enums disagree.
fn variant_arity(ref<Items, shared> it, ref<String, shared> enum_name, ref<Vec<String>, shared> segs) : Option<bool>
{
    usize n = Vec::len(segs);
    if (n == 0)
    {
        return None;
    }
    ref<String, shared> last = &segs[n - 1];
    if (n >= 2)
    {
        return match (HashMap::get(&it.enums, enum_name))
        {
            Some(e) : variant_has_payload(e, last),
            None    : None,
        };
    }
    match (HashMap::get(&it.variant_payload, last))
    {
        Some(p) : *p,
        None    : None,
    }
}

fn is_variant_path(ref<Body, shared> b, ref<Items, shared> it, ref<Vec<String>, shared> segs) : bool
{
    Option::is_some(&variant_enum(it, segs)) && !(Vec::len(segs) == 1 && HashMap::contains(&b.gamma, &segs[0]))
}

// Whether an expression is, by its form alone, a value and not a
// reference.
fn plainly_a_value(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EInt(_)         : true,
        ExprKind::EFloat(_)       : true,
        ExprKind::EBool(_)        : true,
        ExprKind::EStructLit(_)   : true,
        ExprKind::EArrayLit(_)    : true,
        ExprKind::EArrayRepeat(_) : true,
        ExprKind::EParen(x)       : plainly_a_value(b, it, Box::get(x)),
        ExprKind::EPath(p)        : is_variant_path(b, it, &Box::get(p).segs),
        ExprKind::ECall(cb) : match (&Box::get(cb).callee.kind)
        {
            ExprKind::EPath(p) : is_variant_path(b, it, &Box::get(p).segs),
            _                  : false,
        },
        _                         : false,
    }
}

// The enum of module `prefix` with a variant `vname`, when exactly one.
fn module_variant_enum(ref<Items, shared> it, StringView prefix, ref<String, shared> vname) : Option<String>
{
    String mk = String::copy(prefix);
    String::append(&mut mk, "\u{1}");
    String::append(&mut mk, vname);
    match (HashMap::get(&it.module_variant, &mk))
    {
        Some(e) : clone(e),
        None    : None,
    }
}

fn variant_enum(ref<Items, shared> it, ref<Vec<String>, shared> segs) : Option<String>
{
    usize n = Vec::len(segs);
    if (n == 0)
    {
        return None;
    }
    ref<String, shared> last = &segs[n - 1];
    if (n >= 2)
    {
        String key = String::clone(&segs[0]);
        for (usize i = 1; i + 1 < n; i += 1)
        {
            String::append(&mut key, "::");
            String::append(&mut key, &segs[i]);
        }
        match (HashMap::get(&it.enums, &key))
        {
            Some(e) : return if (Option::is_some(&variant_has_payload(e, last))) { Some(key) } else { None },
            None    : {},
        }
        // `m::V`: the enum of module `m` with that variant.
        match (module_variant_enum(it, &key, last))
        {
            Some(e) : return Some(e),
            None    : {},
        }
        // `E::V` for an enum whose key ends in `E` (`Option::None` is
        // `std::Option`'s). Any other qualifier names no enum with that
        // variant (CHG-0438).
        String suffix = sprintf("::%s", &key);
        match (HashMap::get(&it.enum_of_variant, last))
        {
            Some(e) : if (StringView::ends_with(e, &suffix)) { return Some(String::clone(e)); },
            None    : {},
        }
        Vec<String> found = Vec::new();
        for (usize i = 0; i < HashMap::len(&it.enums); i += 1)
        {
            ref<String, shared> k = HashMap::key_at(&it.enums, i);
            if (StringView::ends_with(k, &suffix) && Option::is_some(&variant_has_payload(HashMap::value_at(&it.enums, i), last)))
            {
                Vec::push(&mut found, String::clone(k));
            }
        }
        if (Vec::len(&found) == 1)
        {
            return Some(String::clone(&found[0]));
        }
        if (Vec::len(&found) == 0)
        {
            return None;
        }
        return match (HashMap::get(&it.enum_of_variant, last))
        {
            Some(e) : if (Vec::contains(&found, e)) { Some(String::clone(e)) } else { None },
            None    : None,
        };
    }
    match (HashMap::get(&it.enum_of_variant, last))
    {
        Some(e) : Some(String::clone(e)),
        None    : None,
    }
}

fn is_intrinsic_any(ref<String, shared> n) : bool
{
    String spaced = sprintf(" %s ", n);
    StringView::contains(PRELUDE_ALL_INTRINSICS, &spaced)
}

fn is_item_name(ref<Items, shared> it, ref<String, shared> n) : bool
{
    HashMap::contains(
        &it.fns,
        n,
    ) || HashMap::contains(
        &it.externs,
        n,
    ) || HashMap::contains(
        &it.statics,
        n,
    ) || HashMap::contains(
        &it.enum_of_variant,
        n,
    ) || HashMap::contains(&it.structs, n) || HashMap::contains(&it.enums, n) || is_intrinsic_any(n)
}

fn f_key(ref<FnDecl, shared> f) : String
{
    match (&f.assoc_type)
    {
        Some(t) : sprintf("%s::%s", t, &f.name),
        None    : String::clone(&f.name),
    }
}

// ---- part 4 ----

fn valid_ref_path(ref<Body, shared> b, ref<Vec<String>, shared> segs) : bool
{
    Vec::len(segs) == 1 && tri_is(&b.flow.valid, &segs[0], Tri::T)
}

// D-0095: whether `lhs` writes through a reference binding the flow
// analysis knows is valid here.
fn deref_ref_valid(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> lhs) : bool
{
    ref<Expr, shared> e = strip_parens_tc(lhs);
    while (true)
    {
        match (&e.kind)
        {
            ExprKind::EField(fb) : e = strip_parens_tc(&Box::get(fb).e),
            ExprKind::EIndex(ib) : e = strip_parens_tc(&Box::get(ib).a),
            ExprKind::EDeref(x)  :
            {
                return match (&strip_parens_tc(Box::get(x)).kind)
                {
                    ExprKind::EPath(p) : valid_ref_path(b, &Box::get(p).segs),
                    _                  : false,
                };
            },
            ExprKind::EPath(p)   :
            {
                ref<Vec<String>, shared> segs = &Box::get(p).segs;
                if (Vec::len(segs) != 1)
                {
                    return false;
                }
                bool is_ref = match (HashMap::get(&b.gamma, &segs[0]))
                {
                    Some(Type::TRef(_)) : true,
                    _                   : false,
                };
                return is_ref && valid_ref_path(b, segs);
            },
            _                    : return false,
        }
    }
    false
}

// `[Borrow]` of a place: `¬clash(a0, m)`.
fn flow_borrow(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> inner, Mode mode) : Result<void, String>
{
    match (place_of(b, it, inner))
    {
        Some(p) :
        {
            fl_lit(&mut b.flow, &p.root, None);
            // `[Definite-Assignment-Rejected]` (CHG-0438): a borrow of a
            // binding that may have no value is a use of it.
            if (!tri_is(&b.flow.init, &p.root, Tri::T))
            {
                refute(b, &uninit_msg(&p.root))?;
            }
        },
        None    : {},
    }
    Option<Place> p = match (place_of(b, it, inner))
    {
        Some(p) : Some(p),
        None    : deref_place_of(b, it, inner),
    };
    match (p)
    {
        Some(p) : flow_clash(b, it, &p.root, &p.path, mode, "diag.aliasing-conflict")?,
        None    : {},
    }
    Ok(())
}

// A consuming use of a whole resource binding: `solitary(a_x)`, then
// `valid(x) := F` and every `deriv(·, x, ·) := F`.
fn flow_consume(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> x, str diag) : Result<void, String>
{
    flow_solitary(b, it, x, diag)?;
    if (!b.flow.unreachable)
    {
        fl_tri(&mut b.flow, 0, x, Some(Tri::F));
        HashMap::insert(&mut b.moved_at, String::clone(x), b.current_line);
        // Bug 261: a later move is not the `foreach`'s (`check_let`).
        _ = HashMap::remove(&mut b.moved_at, &sprintf("%s\u{1}foreach", x));
        flow_clear_rooted(&mut b.flow, x);
        // D-0071: what a moved guard or handle held goes with it, out of
        // this analysis' sight: the run's to check (D-0289), unless `join`,
        // `try_join` or `drop` ends it here.
        bool lends = match (HashMap::get(&b.gamma, x))
        {
            Some(t) : holds_handle(t) || holds_guard(t),
            None    : false,
        };
        if (!b.joining && !b.handing && has_live_fact(b, x) && lends)
        {
            rep_left(b, sprintf("line %v: `%s` leaves this frame holding what it was lent", b.current_line, x));
        }
        holder_leaves(b, it, x);
        flow_clear_rooted(&mut b.flow, &referent_root(x));
        HashMap::remove(&mut b.flow.deriv, x);
    }
    Ok(())
}

// An expression in a store position: a resource-typed whole binding is
// moved rather than read; a resource-typed field of a live object may not
// be moved out.
fn check_store_operand(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // D-0282: a value moved out through a reference (`drop(*r)`,
    // `Atomic<u64> c = *r`): the reference still holds the place, so the
    // move conflicts with it, always.
    if (b.report && !b.flow.unreachable)
    {
        match (&strip_parens_tc(e).kind)
        {
            ExprKind::EDeref(inner) : match (one_seg(strip_parens_tc(Box::get(inner))))
            {
                Some(n) :
                {
                    bool moves = match (static_place_type(b, it, e))
                    {
                        Some(t) : is_resource_ty(
                            it,
                            &t,
                        ) || named_is(&t, "std::Atomic") || named_is(&t, "std::Vec") || named_is(&t, "std::String"),
                        None : false,
                    };
                    // Report 318: a guard keeps its mutex's value as a
                    // reference keeps its referent.
                    bool via_guard = match (HashMap::get(&b.gamma, n))
                    {
                        Some(Type::TGuard(_)) : true,
                        _                     : false,
                    };
                    bool is_ref = via_guard || match (HashMap::get(&b.gamma, n))
                    {
                        Some(Type::TRef(_)) : true,
                        _                   : false,
                    };
                    if (moves && is_ref)
                    {
                        String msg = if (via_guard) { moved_out_of_guard_msg(n) } else { moved_out_msg(n, HashMap::len(&b.subst) > 0) };
                        String diag = sprintf(
                            "%s%s",
                            &named_diag("diag.move-while-aliased", &msg),
                            &diag_at(e.line, e.col),
                        );
                        refute(b, &diag)?;
                    }
                },
                None    : {},
            },
            _ : {},
        }
    }
    // Tagged with the operand's line, as `check_expr` tags its own.
    Option<Type> t = match (check_store_operand_inner(b, it, e, expected))
    {
        Ok(t)  : t,
        Err(d) :
        {
            if (!StringView::contains(&d, "@"))
            {
                return Err(sprintf("%s%s", &d, &diag_at(e.line, e.col)));
            }
            return Err(d);
        },
    };
    // D-0071: a binding that holds borrows without being a reference,
    // stored elsewhere, takes them out of sight. A closure that owns no
    // resource is copied, not moved, and keeps them (CHG-0299).
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EPath(p) :
        {
            ref<Vec<String>, shared> segs = &Box::get(p).segs;
            // D-0282: a view (or an `Option`/`Result` of a reference) is
            // copied, not moved, and keeps its borrow.
            bool copied_view = match (HashMap::get(&b.gamma, &segs[0]))
            {
                Some(t) : copied_view_type(t),
                None    : false,
            };
            // D-0290: a holder that owns no resource is copied, and keeps
            // what it holds; a copy given away is the run's.
            bool copied_holder = Vec::len(segs) == 1 && is_holder(
                b,
                it,
                &segs[0],
            ) && match (HashMap::get(&b.gamma, &segs[0]))
            {
                Some(t) : !is_resource_ty(it, t),
                None    : false,
            };
            if (copied_holder)
            {
                holder_leaves(b, it, &segs[0]);
            }
            else if (Vec::len(segs) == 1 && !copied_view && !b.flow.unreachable && HashMap::contains(
                &b.flow.deriv,
                &segs[0],
            ))
            {
                bool refish = match (HashMap::get(&b.gamma, &segs[0]))
                {
                    Some(Type::TRef(_))   : true,
                    Some(Type::TSlice(_)) : true,
                    _                     : false,
                };
                if (!refish && !HashSet::contains(&b.closure_copied, &segs[0]))
                {
                    holder_leaves(b, it, &segs[0]);
                    HashMap::remove(&mut b.flow.deriv, &segs[0]);
                }
            }
        },
        _                  : {},
    }
    Ok(t)
}

// A view, or an `Option`/`Result` of a reference: copied, not moved; so
// is `foreach`'s holder of a view's parts (D-0287), which `$each_len($d)`
// was taken to move (CHG-0438).
fn copied_view_type(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(nb) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (n.name == "std::StringView" || n.name == "std::Parts")
            {
                return Vec::len(&n.args) == 0;
            }
            if (n.name == "std::Option" || n.name == "std::Result")
            {
                return Vec::len(&n.args) > 0 && is_ref_or_view(&n.args[0]);
            }
            false
        },
        _                : false,
    }
}

// Inside a closure without `move`, a capture is a borrow of the outer
// binding, live while the closure runs (`[Closure-Form-Borrow]`, spec/15): a
// resource reached by it, the capture or a part of it, cannot be moved out or
// destroyed there (CHG-0439).
fn borrowed_capture_kept(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e, str diag, str what) : Result<void, String>
{
    ref<Expr, shared> whole = strip_parens_tc(e);
    ref<Expr, shared> root = whole;
    bool walking = true;
    while (walking)
    {
        match (&root.kind)
        {
            ExprKind::EField(f) : root = strip_parens_tc(&Box::get(f).e),
            ExprKind::EIndex(p) : root = strip_parens_tc(&Box::get(p).a),
            _                   : walking = false,
        }
    }
    String name = match (one_seg(root))
    {
        Some(n) : String::clone(n),
        None    : return Ok(()),
    };
    if (!HashSet::contains(&b.capture_names, &name) || HashMap::contains(&b.move_captures, &name))
    {
        return Ok(());
    }
    Option<Type> t = match (static_place_type(b, it, e))
    {
        Some(x) : Some(x),
        None    : if (root.id == whole.id) { lookup_local(b, &name) } else { None },
    };
    bool holds_resource = match (&t)
    {
        Some(x) : is_resource_ty(it, x),
        None    : false,
    };
    bool is_ref = match (HashMap::get(&b.gamma, &name))
    {
        Some(Type::TRef(_))   : true,
        Some(Type::TSlice(_)) : true,
        _                     : false,
    };
    if (!holds_resource || is_ref)
    {
        return Ok(());
    }
    StringView c = shown_name(&name);
    String msg = sprintf(
        "`%s` is captured by reference (`[%s]`), and the closure's borrow of it lasts while the closure runs, so it cannot be %s here; capture it by value with `move [%s]`, or work on a clone",
        c,
        c,
        what,
        c,
    );
    Err(named_diag(diag, &msg))
}

fn check_store_operand_inner(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    match (root_local_name(e))
    {
        Some(name) : match (HashMap::get(&b.move_captures, &name))
        {
            Some(Some(t)) :
            {
                if (is_resource_ty(it, t))
                {
                    return Err("diag.move-out-of-field");
                }
            },
            _             : {},
        },
        None : {},
    }
    borrowed_capture_kept(b, it, e, "diag.move-while-aliased", "moved")?;
    match (place_of(b, it, e))
    {
        Some(p) :
        {
            if (place_is_resource(
                b,
                it,
                &p.root,
                &p.path,
            ) || (Vec::len(&p.path) == 0 && HashSet::contains(&b.closure_owning, &p.root)))
            {
                b.place_pos = true;
                Option<Type> t = check_expr(b, it, e, expected)?;
                if (Vec::len(&p.path) == 0)
                {
                    flow_consume(b, it, &p.root, "diag.move-while-aliased")?;
                }
                else
                {
                    refute(b, &named_diag("diag.move-out-of-field", MOVE_OUT_HELP))?;
                }
                return Ok(t);
            }
        },
        None    : {},
    }
    // `[Store-Binding-Place-Transfer-Sub]` on a temporary's field.
    bool projection = match (&strip_parens_tc(e).kind)
    {
        ExprKind::EField(_) : true,
        ExprKind::EIndex(_) : true,
        _                   : false,
    };
    if (projection && borrow_operand_kind(b, it, e) == OperandKind::Temporary)
    {
        // D-0103: a resource field of a temporary struct (without a
        // destructor) is moved out, the temporary's other fields ended at
        // once: `f().x` is `{ S { x, y, … } = f(); x }`.
        match (&strip_parens_tc(e).kind)
        {
            ExprKind::EField(fb) :
            {
                ref<FieldExpr, shared> fe = Box::get(fb);
                Flow saved = clone(&b.flow);
                Result<Option<Type>, String> bt = check_expr(b, it, &fe.e, &None);
                Flow nf_11615 = saved;
                flow_assign(b, nf_11615);
                match (bt)
                {
                    Ok(Some(Type::TNamed(nb))) :
                    {
                        String sname = String::clone(&Box::get(&nb).name);
                        bool has_drop = HashMap::contains(&it.fns, &sprintf("%s::drop", &sname));
                        match (HashMap::get(&it.structs, &sname))
                        {
                            Some(sd) :
                            {
                                bool resource_field = false;
                                for (usize i = 0; i < Vec::len(&sd.fields); i += 1)
                                {
                                    if (sd.fields[i].name == fe.name)
                                    {
                                        resource_field = is_resource_ty(it, &sd.fields[i].ty);
                                        break;
                                    }
                                }
                                if (!has_drop && resource_field)
                                {
                                    usize line = e.line;
                                    usize col = e.col;
                                    Vec<String> fields = Vec::new();
                                    for (usize i = 0; i < Vec::len(&sd.fields); i += 1)
                                    {
                                        Vec::push(&mut fields, String::clone(&sd.fields[i].name));
                                    }
                                    Vec<Stmt> stmts = Vec::new();
                                    Vec::push(&mut stmts, Stmt::SDestructure(Box::new(DestructureStmt {
                                        .struct_name = String::clone(&sname),
                                        .names = Vec::clone(&fields),
                                        .fields = fields,
                                        .rest = false,
                                        .init = clone(&fe.e),
                                    })));
                                    Vec<String> tail_segs = Vec::new();
                                    Vec::push(&mut tail_segs, String::clone(&fe.name));
                                    Expr tail = mk(
                                        ExprKind::EPath(Box::new(PathExpr { .segs = tail_segs, .targs = Vec::new() })),
                                        line,
                                        col,
                                    );
                                    Expr rep = mk(
                                        ExprKind::EBlock(Block { .stmts = stmts, .tail = Some(Box::new(tail)) }),
                                        line,
                                        col,
                                    );
                                    number_fresh(b, &mut rep);
                                    Option<Type> t = check_expr(b, it, &rep, expected)?;
                                    HashMap::insert(&mut b.facts.temp_moves, e.id, rep);
                                    return Ok(t);
                                }
                            },
                            None     : {},
                        }
                    },
                    _                          : {},
                }
            },
            _                    : {},
        }
        Option<Type> t = check_expr(b, it, e, expected)?;
        bool res = match (&t)
        {
            Some(x) : is_resource_ty(it, x),
            None    : false,
        };
        if (res)
        {
            return Err(sprintf(
                "%s%s",
                &named_diag("diag.move-out-of-field", MOVE_OUT_HELP),
                &diag_at(e.line, e.col),
            ));
        }
        return Ok(t);
    }
    // Report 108: a resource part reached through a reference
    // (`p.name`, `p` a `ref<Person, …>`) is never moved out: the
    // reference's owner keeps it.
    if (projection && b.report && !b.flow.unreachable && part_through_ref(b, it, e))
    {
        Option<Type> t = check_expr(b, it, e, expected)?;
        bool res = match (&t)
        {
            Some(Type::TRef(_)) : false,
            Some(x)             : is_resource_ty(it, x),
            None                : false,
        };
        if (res)
        {
            String shown = match (place_text(strip_parens_tc(e)))
            {
                Some(s) : s,
                None    : String::copy("this part"),
            };
            String msg = sprintf(
                "`%s` is reached through a reference, so it cannot be moved out: take a copy (`clone(&%s)`), return a reference to it, or exchange it through an exclusive reference (`replace(&mut %s, v)`)",
                &shown,
                &shown,
                &shown,
            );
            return Err(sprintf("%s%s", &named_diag("diag.move-out-of-field", &msg), &diag_at(e.line, e.col)));
        }
        return Ok(t);
    }
    check_expr(b, it, e, expected)
}

// Whether the place `e` (a field or an element) is reached through a
// reference somewhere along its projections.
fn part_through_ref(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    ref<Expr, shared> cur = strip_parens_tc(e);
    while (true)
    {
        ref<Expr, shared> base = match (&cur.kind)
        {
            ExprKind::EField(fb) : &Box::get(fb).e,
            ExprKind::EIndex(ib) : &Box::get(ib).a,
            _                    : return false,
        };
        // Report 318: a guard's field is the mutex's (`g.name`); report
        // 108: a slice's element is its owner's (`ps[0].name`).
        bool via_guard = match (static_place_type(b, it, base))
        {
            Some(Type::TGuard(_)) : true,
            Some(Type::TSlice(_)) : true,
            _                     : false,
        };
        if (via_guard || operand_is_ref(b, it, base))
        {
            return true;
        }
        cur = strip_parens_tc(base);
    }
    false
}

// spec/13 §1's place kinds, the projections' bases taken through a
// reference when `static_place_type` or `returns_ref` says it is one.
fn borrow_operand_kind(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : OperandKind
{
    operand_root(b, it, e, false)
}

fn operand_is_ref(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> x) : bool
{
    match (static_place_type(b, it, x))
    {
        Some(Type::TRef(_)) : true,
        _                   : returns_ref(b, it, x),
    }
}

fn operand_root(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e, bool projected) : OperandKind
{
    match (&e.kind)
    {
        ExprKind::EParen(x)       : operand_root(b, it, Box::get(x), projected),
        ExprKind::EPath(_)        : OperandKind::Place,
        ExprKind::EDeref(_)       : OperandKind::Place,
        ExprKind::EField(fb)      :
        {
            ref<Expr, shared> base = &Box::get(fb).e;
            if (operand_is_ref(b, it, base)) { OperandKind::Place } else { operand_root(b, it, base, true) }
        },
        ExprKind::EIndex(ib)      :
        {
            ref<Expr, shared> base = &Box::get(ib).a;
            if (operand_is_ref(b, it, base)) { OperandKind::Place } else { operand_root(b, it, base, true) }
        },
        ExprKind::ECall(cb)       :
        {
            if (is_reclaim_call(&Box::get(cb).callee))
            {
                return OperandKind::Place;
            }
            if (projected) { OperandKind::Temporary } else { OperandKind::NonPlace }
        },
        ExprKind::EStructLit(_)   : if (projected) { OperandKind::Temporary } else { OperandKind::NonPlace },
        ExprKind::EArrayLit(_)    : if (projected) { OperandKind::Temporary } else { OperandKind::NonPlace },
        ExprKind::EArrayRepeat(_) : if (projected) { OperandKind::Temporary } else { OperandKind::NonPlace },
        _                         : OperandKind::NonPlace,
    }
}

fn deriv_key(Place p, Mode m) : DerivKey
{
    Place { root, path } = p;
    DerivKey { .root = root, .path = path, .mode = m }
}

fn place_or_deref(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> inner) : Option<Place>
{
    match (place_of(b, it, inner))
    {
        Some(p) : Some(p),
        None    : deref_place_of(b, it, inner),
    }
}

// The source arguments' positions of a call whose result is a reference
// (D-0011's elided call, or the parameters a `from` clause names, D-0312,
// D-0318), in order; empty when there are none.
fn elided_ref_args(ref<Items, shared> it, ref<CallExpr, shared> c) : Vec<usize>
{
    Vec<usize> out = Vec::new();
    String key = match (resolve_fn_path(it, &c.callee))
    {
        Some(k) : k,
        None    : return out,
    };
    ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &key), "a function");
    if (!is_borrow_ty(&f.ret))
    {
        return out;
    }
    Vec<usize> ks = source_positions(f);
    for (usize i = 0; i < Vec::len(&ks); i += 1)
    {
        if (ks[i] < Vec::len(&c.args))
        {
            Vec::push(&mut out, ks[i]);
        }
    }
    out
}

// The `deriv`-forming initializers of a reference-typed binding: a visible
// borrow, or an elided call whose source arguments are such borrows, one
// fact for each (D-0318). Empty when it is neither.
fn deriv_facts_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Vec<DerivKey>
{
    Vec<DerivKey> out = Vec::new();
    match (&e.kind)
    {
        ExprKind::EParen(x) : return deriv_facts_of(b, it, Box::get(x)),
        ExprKind::ECall(cb) :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            Vec<usize> ks = elided_ref_args(it, c);
            for (usize i = 0; i < Vec::len(&ks); i += 1)
            {
                match (source_arg_fact(b, it, &c.args[ks[i]]))
                {
                    Some(k) : Vec::push(&mut out, k),
                    None    : {},
                }
            }
        },
        _                   :
        {
            match (borrow_fact_of(b, it, e))
            {
                Some(k) : Vec::push(&mut out, k),
                None    : {},
            }
        },
    }
    out
}

// A visible borrow's `deriv` fact.
fn borrow_fact_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<DerivKey>
{
    match (&e.kind)
    {
        ExprKind::EBorrow(x)  :
        {
            Place p = borrowed_place(b, it, &Box::get(x).e)?;
            Some(deriv_key(p, Box::get(x).mode))
        },
        // D-0070: a slice derives from its range of the source; `&v[lo ..
        // hi]` on a `StringView`, from what `v` holds (`inherited_facts_in`).
        ExprKind::ESliceOf(x) :
        {
            ref<SliceExpr, shared> s = Box::get(x);
            if (is_view_slice_base(b, it, &s.base))
            {
                return None;
            }
            Place p = slice_source(b, it, &s.base)?;
            Vec::push(&mut p.path, range_elem_in(b, &s.lo, &s.hi));
            Some(deriv_key(p, s.mode))
        },
        _                     : None,
    }
}

// An elided call's source argument's `deriv` fact, when it is a borrow.
fn source_arg_fact(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> arg) : Option<DerivKey>
{
    match (&arg.kind)
    {
        ExprKind::EBorrow(x)  :
        {
            Place p = place_or_deref(b, it, &Box::get(x).e)?;
            Some(deriv_key(p, Box::get(x).mode))
        },
        ExprKind::ESliceOf(x) :
        {
            ref<SliceExpr, shared> s = Box::get(x);
            // Report 396: `&v[lo .. hi]` of a `StringView` views what `v`
            // views, not `v` (as `borrow_fact_of` has it): its facts are
            // inherited (`inherited_facts_in`), so `StringView::trim(&line[0..i])`
            // stored past `line`'s block refers to the text, not to `line`.
            if (is_view_slice_base(b, it, &s.base))
            {
                return None;
            }
            Place p = place_or_deref(b, it, &s.base)?;
            Vec::push(&mut p.path, range_elem_in(b, &s.lo, &s.hi));
            Some(deriv_key(p, s.mode))
        },
        _                     : None,
    }
}

// A call whose result is a reference (`StringView::as_bytes(&s)`).
fn returns_ref(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    match (value_shape(b, it, e))
    {
        Some(Type::TRef(_)) : true,
        _                   : false,
    }
}

fn is_unwrapping(ref<String, shared> key) : bool
{
    *key == "std::Option::unwrap" || *key == "std::Option::expect" || *key == "std::Result::unwrap" || *key == "std::Result::expect"
}

// The type an expression's value has, as far as its declaration shows it:
// a local's type, a call's declared result, and through `unwrap`/`expect`
// the payload of their argument's shape.
fn value_shape(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Type>
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EPath(p)      :
        {
            if (Vec::len(&Box::get(p).segs) == 1)
            {
                return lookup_local(b, &Box::get(p).segs[0]);
            }
            None
        },
        // Report 229: a block's value (`&unsafe { String::from_c(p) }`
        // where a view is declared) when it declares no binding its tail
        // could name.
        ExprKind::EBlock(bk)    : block_value_shape(b, it, bk),
        ExprKind::EUnsafe(bk)   : block_value_shape(b, it, bk),
        // `e?` is the payload of `e`'s `Option` or `Result`, as `unwrap` of
        // it is (`show(&dir()?)` where a view is declared: `[Coerce-Text]`
        // has no exception for `?`, CHG-0462).
        ExprKind::EPropagate(x) :
        {
            Type t = value_shape(b, it, Box::get(x))?;
            if (named_is(&t, "std::Option") || named_is(&t, "std::Result"))
            {
                Vec<Type> args = named_args(&t);
                return if (Vec::len(&args) > 0) { Some(clone(&args[0])) } else { None };
            }
            None
        },
        ExprKind::ECall(cb)     :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            // `lock(m)` gives a guard of the mutex's type (bug 006: a
            // `String` through a temporary guard was not seen as text).
            bool is_lock = match (one_seg(&c.callee))
            {
                Some(n) : *n == "lock" && !is_local(b, n),
                None    : false,
            };
            if (is_lock && Vec::len(&c.args) == 1)
            {
                Type mt = match (&strip_parens_tc(&c.args[0]).kind)
                {
                    ExprKind::EBorrow(bb) : shape_or_place(b, it, &Box::get(bb).e)?,
                    _ : match (shape_or_place(b, it, &c.args[0])?)
                    {
                        Type::TRef(rb) : ModedTy::take_inner(rb),
                        _              : return None,
                    },
                };
                return match (mt)
                {
                    Type::TMutex(x) : Some(Type::TGuard(x)),
                    _               : None,
                };
            }
            String key = resolve_fn_path(it, &c.callee)?;
            if (is_unwrapping(&key) && Vec::len(&c.args) > 0)
            {
                Type t = value_shape(b, it, &c.args[0])?;
                if (named_is(&t, "std::Option") || named_is(&t, "std::Result"))
                {
                    Vec<Type> args = named_args(&t);
                    return if (Vec::len(&args) > 0) { Some(clone(&args[0])) } else { None };
                }
                return None;
            }
            ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &key), "a function");
            // A generic's result with its type parameters bound from the
            // arguments (`Vec::index_exclusive(&mut v, 0)` of a `Vec<i32>`
            // is a `ref<i32, exclusive>`, not a `ref<T, …>`); one not bound
            // is not known.
            if (Vec::len(&f.type_params) == 0)
            {
                return Some(clone(&f.ret));
            }
            HashSet<String> tps = HashSet::new();
            for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
            {
                HashSet::insert(&mut tps, String::clone(&f.type_params[i]));
            }
            if (!mentions_any(&f.ret, &tps))
            {
                return Some(clone(&f.ret));
            }
            HashMap<String, Type> m = match (&c.callee.kind)
            {
                ExprKind::EPath(pb) : if (Vec::len(&Box::get(pb).targs) > 0)
                {
                    explicit_subst(
                        f,
                        &Box::get(pb).targs,
                    )
                }
                else { HashMap::new() },
                _ : HashMap::new(),
            };
            for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(&c.args); i += 1)
            {
                Option<Type> at = match (&strip_parens_tc(&c.args[i]).kind)
                {
                    ExprKind::EBorrow(bb) : match (shape_or_place(b, it, &Box::get(bb).e))
                    {
                        Some(t) : Some(ref_of(t, Box::get(bb).mode)),
                        None    : None,
                    },
                    _ : shape_or_place(b, it, &c.args[i]),
                };
                match (&at)
                {
                    Some(t) : unify_type_shape(&f.params[i].ty, t, &mut m, &f.type_params),
                    None    : {},
                }
            }
            Type ret = apply_subst(&f.ret, &m);
            if (mentions_any(&ret, &tps)) { None } else { Some(ret) }
        },
        _                       : None,
    }
}

fn block_value_shape(ref<Body, shared> b, ref<Items, shared> it, ref<Block, shared> bk) : Option<Type>
{
    foreach (st in &bk.stmts)
    {
        match (st)
        {
            Stmt::SExpr(_)      : {},
            Stmt::SBlockLike(_) : {},
            _                   : return None,
        }
    }
    match (&bk.tail)
    {
        Some(t) : value_shape(b, it, Box::get(t)),
        None    : None,
    }
}

// The source a slice `&m base[lo .. hi]` takes its range of: `base`'s
// place, or for a reference binding `r` its referent `*r`.
fn slice_source(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> base) : Option<Place>
{
    match (single_tracked(b, strip_parens_tc(base)))
    {
        Some(x) :
        {
            bool is_ref = match (HashMap::get(&b.gamma, &x))
            {
                Some(Type::TRef(_)) : true,
                _                   : false,
            };
            if (is_ref)
            {
                return Some(Place { .root = referent_root(&x), .path = Vec::new() });
            }
        },
        None    : {},
    }
    borrowed_place(b, it, base)
}

fn borrowed_place(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> inner) : Option<Place>
{
    match (place_of(b, it, inner))
    {
        Some(p) : return Some(p),
        None    : {},
    }
    match (vec_element_root(b, it, inner))
    {
        Some(p) : return Some(p),
        None    : {},
    }
    deref_place_of(b, it, inner)
}

fn call_args(ref<Expr, shared> e) : Option<ref<Vec<Expr>, shared>>
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::ECall(cb) : Some(&Box::get(cb).args),
        _                   : None,
    }
}

// D-0071: `spawn(f, a1, …)`: a handle bound to it carries the arguments'
// visible borrows.
fn spawn_facts_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Vec<DerivKey>
{
    Vec<DerivKey> v = Vec::new();
    ref<Vec<Expr>, shared> args = match (call_args(e))
    {
        Some(a) : a,
        None    : return v,
    };
    for (usize i = 1; i < Vec::len(args); i += 1)
    {
        Vec::append(&mut v, deriv_facts_of(b, it, &args[i]));
    }
    Vec::append(&mut v, spawn_lent_refs(b, it, args));
    v
}

// D-0213 `[Thread-Lend]`: a reference binding passed to `spawn` whole is
// lent to the thread.
fn spawn_lent_refs(ref<Body, shared> b, ref<Items, shared> it, ref<Vec<Expr>, shared> args) : Vec<DerivKey>
{
    Vec<DerivKey> out = Vec::new();
    for (usize i = 1; i < Vec::len(args); i += 1)
    {
        match (single_tracked(b, strip_parens_tc(&args[i])))
        {
            // D-0291: a slice binding lent whole, as a reference; an
            // exclusive one is lent exclusively whatever the parameter takes
            // (`[Thread-Lend]` lends before binding).
            Some(x) : match (local_ref_mode(b, &x))
            {
                Some(mode) : Vec::push(
                    &mut out,
                    DerivKey { .root = referent_root(&x), .path = Vec::new(), .mode = mode },
                ),
                None : {},
            },
            None : {},
        }
    }
    out
}

// D-0088: a call whose result holds a reference without being one is
// taken to borrow from the call's first reference argument.
fn contained_ref_facts(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Vec<DerivKey>
{
    Vec<DerivKey> out = Vec::new();
    ref<CallExpr, shared> c = match (&strip_parens_tc(e).kind)
    {
        ExprKind::ECall(cb)     : Box::get(cb),
        ExprKind::EPropagate(x) : return contained_ref_facts(b, it, Box::get(x)),
        _                       : return out,
    };
    String key = match (resolve_fn_path(it, &c.callee))
    {
        Some(k) : k,
        None    : return out,
    };
    if (is_unwrapping(&key) && Vec::len(&c.args) > 0)
    {
        return contained_ref_facts(b, it, &c.args[0]);
    }
    ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &key), "a function");
    if (is_borrow_ty(&f.ret) || !holds_ref(it, &f.ret))
    {
        return out;
    }
    // The first reference argument, or with a `from` clause the ones it
    // names (D-0312, D-0318).
    bool named = Vec::len(&f.source) > 0;
    for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(&c.args); i += 1)
    {
        if (!is_borrow_ty(&f.params[i].ty) || (named && !Vec::contains(&f.source, &f.params[i].name)))
        {
            continue;
        }
        match (&strip_parens_tc(&c.args[i]).kind)
        {
            ExprKind::EBorrow(x)  :
            {
                match (borrowed_place(b, it, &Box::get(x).e))
                {
                    Some(p) : Vec::push(&mut out, deriv_key(p, Box::get(x).mode)),
                    None    : {},
                }
            },
            ExprKind::ESliceOf(x) :
            {
                ref<SliceExpr, shared> s = Box::get(x);
                match (borrowed_place(b, it, &s.base))
                {
                    Some(p) :
                    {
                        Vec::push(&mut p.path, range_elem_in(b, &s.lo, &s.hi));
                        Vec::push(&mut out, deriv_key(p, s.mode));
                    },
                    None    : {},
                }
            },
            _                     : {},
        }
        if (!named)
        {
            break;
        }
    }
    out
}

// `auto r = e;` / `r = e;` for a reference-typed `r`: the `deriv` facts.
fn set_deriv(ref<Body, exclusive> b, ref<String, shared> r, Vec<DerivKey> facts)
{
    if (b.flow.unreachable)
    {
        return;
    }
    HashMap::remove(&mut b.ref_copies, r);
    handle_lend_through(b, r);
    // D-0300: a fact another binding holds through `r`'s old referent (a
    // copy, `w = r`) now holds what `r` held, each `?`.
    hand_over_referent_as(b, r, false);
    HashMap::remove(&mut b.flow.deriv, r);
    // What was borrowed through `r`'s old referent is not borrowed through
    // its new one (D-0071).
    flow_clear_rooted(&mut b.flow, &referent_root(r));
    if (Vec::len(&facts) > 0)
    {
        HashMap<String, DerivFact> m = HashMap::new();
        for (usize i = 0; i < Vec::len(&facts); i += 1)
        {
            HashMap::insert(&mut m, deriv_code(&facts[i]), DerivFact { .key = clone(&facts[i]), .v = Tri::T });
        }
        HashMap::insert(&mut b.flow.deriv, String::clone(r), m);
        note_roots(&mut b.flow, r);
    }
}

// ---- D-0282..D-0291: helpers over the facts ----

fn local_is_ref(ref<Body, shared> b, ref<String, shared> name) : bool
{
    match (HashMap::get(&b.gamma, name))
    {
        Some(Type::TRef(_))   : true,
        Some(Type::TSlice(_)) : true,
        _                     : false,
    }
}

fn local_ref_mode(ref<Body, shared> b, ref<String, shared> name) : Option<Mode>
{
    match (HashMap::get(&b.gamma, name))
    {
        Some(Type::TRef(x))   : Some(Box::get(x).mode),
        Some(Type::TSlice(x)) : Some(Box::get(x).mode),
        _                     : None,
    }
}

fn fact(String root, Vec<PElem> path, Mode mode, Tri v) : DerivFact
{
    DerivFact { .key = DerivKey { .root = root, .path = path, .mode = mode }, .v = v }
}

// The facts of holder `n`, those that may hold (`v != F`) when `live`.
fn facts_of(ref<Body, shared> b, ref<String, shared> n, bool live) : Vec<DerivFact>
{
    Vec<DerivFact> out = Vec::new();
    match (HashMap::get(&b.flow.deriv, n))
    {
        Some(m) :
        {
            for (usize k = 0; k < HashMap::len(m); k += 1)
            {
                ref<DerivFact, shared> d = HashMap::value_at(m, k);
                if (!live || d.v != Tri::F)
                {
                    Vec::push(&mut out, clone(d));
                }
            }
        },
        None    : {},
    }
    out
}

// D-0290: a holder's facts that may hold.
fn holder_facts(ref<Body, shared> b, ref<String, shared> n) : Vec<DerivFact>
{
    facts_of(b, n, true)
}

// Whether holder `n` has a fact that may hold.
fn has_live_fact(ref<Body, shared> b, ref<String, shared> n) : bool
{
    match (HashMap::get(&b.flow.deriv, n))
    {
        Some(m) :
        {
            for (usize k = 0; k < HashMap::len(m); k += 1)
            {
                if (HashMap::value_at(m, k).v != Tri::F)
                {
                    return true;
                }
            }
            false
        },
        None    : false,
    }
}

// The holders' names, in the facts' order.
fn holder_names(ref<Body, shared> b) : Vec<String>
{
    Vec<String> out = Vec::new();
    for (usize i = 0; i < HashMap::len(&b.flow.deriv); i += 1)
    {
        Vec::push(&mut out, String::clone(HashMap::key_at(&b.flow.deriv, i)));
    }
    out
}

fn is_tier_d_root(ref<String, shared> root) : bool
{
    *root == "<tier D>" || *root == "<temporary>"
}

// Whether every fact has a root of this frame (not `<tier D>`, not
// `<temporary>`), and there is one.
fn facts_known(ref<Vec<DerivFact>, shared> v) : bool
{
    if (Vec::len(v) == 0)
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(v); i += 1)
    {
        if (is_tier_d_root(&v[i].key.root))
        {
            return false;
        }
    }
    true
}

fn any_root(ref<Vec<DerivFact>, shared> v, str root) : bool
{
    for (usize i = 0; i < Vec::len(v); i += 1)
    {
        if (v[i].key.root == root)
        {
            return true;
        }
    }
    false
}

// Every fact with `v = U`.
fn all_unsure(Vec<DerivFact> v) : Vec<DerivFact>
{
    for (usize i = 0; i < Vec::len(&v); i += 1)
    {
        v[i].v = Tri::U;
    }
    v
}

// D-0291: a reference or slice binding leaving its scope while something
// else holds a fact through its referent `*r` (a thread's handle, a
// closure, a copy): that fact now holds what `r` reached.
fn hand_over_referent(ref<Body, exclusive> b, ref<String, shared> r)
{
    hand_over_referent_as(b, r, true);
}

// D-0300: at an assignment the facts handed over are each `?` (`sure`
// false): what the old referent was lent to or copied into may have let it
// go already, so the run decides.
fn hand_over_referent_as(ref<Body, exclusive> b, ref<String, shared> r, bool sure)
{
    if (!local_is_ref(b, r))
    {
        return;
    }
    String rr = referent_root(r);
    Vec<DerivFact> own = holder_facts(b, r);
    if (Vec::len(&own) == 0)
    {
        return;
    }
    // Bug 021: the holders listed for `rr` (each is handled alone), and the
    // facts they get then listed.
    Vec<String> hs = holders_of(&b.flow, &rr, false);
    for (usize i = 0; i < Vec::len(&hs); i += 1)
    {
        if (hs[i] == *r)
        {
            continue;
        }
        ref<HashMap<String, DerivFact>, exclusive> facts = match (HashMap::get_mut(&mut b.flow.deriv, &hs[i]))
        {
            Some(m) : m,
            None    : continue,
        };
        Vec<DerivFact> through = Vec::new();
        for (usize k = 0; k < HashMap::len(facts); k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            if ((d.key.root == rr) && d.v != Tri::F)
            {
                Vec::push(&mut through, clone(d));
            }
        }
        for (usize k = 0; k < Vec::len(&through); k += 1)
        {
            HashMap::remove(facts, &deriv_code(&through[k].key));
            for (usize o = 0; o < Vec::len(&own); o += 1)
            {
                DerivKey nk = clone(&own[o].key);
                Vec::append(&mut nk.path, clone(&through[k].key.path));
                if (through[k].key.mode == Mode::Shared)
                {
                    nk.mode = Mode::Shared;
                }
                Tri nt = if (sure && through[k].v == Tri::T && own[o].v == Tri::T) { Tri::T } else { Tri::U };
                // D-0300: a path longer than eight steps stands for `?` on its
                // prefix.
                if (Vec::len(&nk.path) > 8)
                {
                    Vec::truncate(&mut nk.path, 8);
                    nt = Tri::U;
                }
                String code = deriv_code(&nk);
                ref<DerivFact, exclusive> e = HashMap::entry(
                    facts,
                    &code,
                    DerivFact { .key = nk, .v = nt },
                );
                if (e.v != nt)
                {
                    e.v = if (e.v == Tri::T || nt == Tri::T) { Tri::T } else { Tri::U };
                }
            }
        }
    }
    foreach (h in &hs)
    {
        note_roots(&mut b.flow, h);
    }
}

// Whether holder `h` still holds its facts after this point: past its
// last mention for a binding that ends there (D-0111), and to the end of
// its scope for one that does not -- a thread's handle, a guard, a `Vec`
// of handles, whose end waits or releases (D-0289).
fn holder_live_after(ref<Body, shared> b, ref<Items, shared> it, ref<String, shared> h) : bool
{
    holder_live_from(b, it, h, 0)
}

// ... or while a live holder reaches it (`auto hr = &h`: what `h` holds
// lives as long as `hr` does).
fn holder_live_from(ref<Body, shared> b, ref<Items, shared> it, ref<String, shared> h, usize depth) : bool
{
    if (rep_live_after(&b.rep, h, b.current_line, b.current_col))
    {
        return true;
    }
    match (HashMap::get(&b.gamma, h))
    {
        Some(t) :
        {
            if (!ends_at_last_use(it, t))
            {
                return true;
            }
        },
        None    : {},
    }
    if (depth > 4)
    {
        return false;
    }
    String rh = referent_root(h);
    for (usize i = 0; i < HashMap::len(&b.flow.deriv); i += 1)
    {
        ref<String, shared> g = HashMap::key_at(&b.flow.deriv, i);
        if (*g == *h)
        {
            continue;
        }
        ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&b.flow.deriv, i);
        bool reaches = false;
        for (usize k = 0; k < HashMap::len(facts) && !reaches; k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            reaches = d.v != Tri::F && ((d.key.root == *h) || (d.key.root == rh));
        }
        if (reaches && holder_live_from(b, it, g, depth + 1))
        {
            return true;
        }
    }
    false
}

// The root binding of a field/index chain (`s` in `s[i].f`), unwrapped of
// parentheses.
fn chain_root(ref<Expr, shared> e) : ref<Expr, shared>
{
    ref<Expr, shared> x = strip_parens_tc(e);
    while (true)
    {
        match (&x.kind)
        {
            ExprKind::EField(f) : x = strip_parens_tc(&Box::get(f).e),
            ExprKind::EIndex(p) : x = strip_parens_tc(&Box::get(p).a),
            _                   : break,
        }
    }
    x
}

// D-0291: a reborrow of a slice binding's elements (`&mut s[a .. b]`,
// `&s[i]`) reaches `*s` as a copy does (`tier_referent_reach`), in the
// borrow's mode.
fn tier_slice_reborrow(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> base, Mode mode)
{
    match (one_seg(chain_root(base)))
    {
        Some(n) :
        {
            bool is_slice = match (HashMap::get(&b.gamma, n))
            {
                Some(Type::TSlice(_)) : true,
                _                     : false,
            };
            if (is_slice)
            {
                String name = String::clone(n);
                tier_referent_reach(b, it, &name, Some(mode));
            }
        },
        None    : {},
    }
}

// D-0291: a reference or slice binding `r` read whole (copied, stored)
// while another live holder holds what it refers to (`*r`, a thread lent
// it, a closure captured it): the copy reaches `*r` under no fact, so what
// it does there is the run's. A copy goes in `r`'s mode; one passed to a
// reference or slice parameter is the call-site rule's. A hidden binding
// (`$c`, a `foreach`'s) is read by the desugaring, not copied: what is
// borrowed from it is checked where it is borrowed.
fn tier_referent_reach(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> r, Option<Mode> mode)
{
    if (!b.report || b.flow.unreachable || !flow_is_tracked(&b.flow, r) || StringView::starts_with(r, "$"))
    {
        return;
    }
    Mode m = match (local_ref_mode(b, r))
    {
        Some(rm) : Option::unwrap_or(mode, rm),
        None     : return,
    };
    String root = referent_root(r);
    bool held = false;
    // Bug 021: the holders listed for the root (`Flow.rooted`).
    Vec<String> hs = holders_of(&b.flow, &root, m == Mode::Shared);
    for (usize i = 0; i < Vec::len(&hs) && !held; i += 1)
    {
        ref<String, shared> h = &hs[i];
        if (*h == *r)
        {
            continue;
        }
        ref<HashMap<String, DerivFact>, shared> facts = match (HashMap::get(&b.flow.deriv, h))
        {
            Some(f) : f,
            None    : continue,
        };
        bool any = false;
        for (usize k = 0; k < HashMap::len(facts) && !any; k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            any = d.v != Tri::F && (d.key.root == root) && !permitted(m, d.key.mode);
        }
        if (any && holder_live_after(b, it, h))
        {
            held = true;
        }
    }
    if (held)
    {
        rep_left(
            b,
            sprintf("line %v: `%s` is read while a thread or a closure holds what it refers to", b.current_line, r),
        );
    }
}

// D-0290: an access through a reference read out of a holder or out of a
// reference's referent (`*s.inner`, `*v[i]`): the reference may be any of
// those stored there, so a live holder of another binding whose fact meets
// one of them in a clashing mode is a conflict on some paths, the run's.
fn holder_deref_access(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e, Mode mode)
{
    if (!b.report || b.flow.unreachable)
    {
        return;
    }
    ref<Expr, shared> base = chain_root(e);
    // D-0291: an element of a slice binding `s` that a thread or a closure
    // holds (`*s`, lent or captured), or a reborrow of it (`&mut s[a ..
    // b]`, rooted at `s`): no place names it, the run's.
    match (one_seg(base))
    {
        Some(sn) :
        {
            bool slice_binding = flow_is_tracked(&b.flow, sn) && match (HashMap::get(&b.gamma, sn))
            {
                Some(Type::TSlice(_)) : true,
                _                     : false,
            };
            if (!slice_binding)
            {
                return;
            }
            String s = String::clone(sn);
            String root = referent_root(&s);
            // The element `s[i]` against a reborrow's range of `s`.
            Vec<PElem> elem = Vec::new();
            Vec::push(&mut elem, PElem::PIndex(None));
            ref<Expr, shared> x = strip_parens_tc(e);
            while (true)
            {
                match (&x.kind)
                {
                    ExprKind::EIndex(p) :
                    {
                        ref<Expr, shared> y = strip_parens_tc(&Box::get(p).a);
                        if (y.id == base.id && y.line == base.line && y.col == base.col)
                        {
                            elem[0] = PElem::PIndex(literal_index(&Box::get(p).b));
                            break;
                        }
                        x = y;
                    },
                    ExprKind::EField(f) : x = strip_parens_tc(&Box::get(f).e),
                    _                   : break,
                }
            }
            bool held = false;
            for (usize i = 0; i < HashMap::len(&b.flow.deriv) && !held; i += 1)
            {
                ref<String, shared> h = HashMap::key_at(&b.flow.deriv, i);
                if ((*h == s) || !holder_live_after(b, it, h))
                {
                    continue;
                }
                ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&b.flow.deriv, i);
                for (usize k = 0; k < HashMap::len(facts) && !held; k += 1)
                {
                    ref<DerivFact, shared> d = HashMap::value_at(facts, k);
                    bool meets = (d.key.root == root) || ((d.key.root == s) && overlap3(&d.key.path, &elem) != Ov::OvNo);
                    held = d.v != Tri::F && meets && !permitted(mode, d.key.mode);
                }
            }
            if (held)
            {
                usize line = b.current_line;
                b.rep.checks += 1;
                b.rep.undecided += 1;
                Vec::push(&mut b.rep.events, sprintf("U\t%v\t%s\t%s\t%s\t%v", line, &root, mode_debug(mode), &s, line));
                rep_left(b, sprintf("line %v: an element of `%s`, which a thread or a closure holds", line, &s));
            }
            return;
        },
        None     : {},
    }
    ref<Expr, shared> inner = match (&base.kind)
    {
        ExprKind::EDeref(x) : Box::get(x),
        _                   : return,
    };
    match (&strip_parens_tc(inner).kind)
    {
        ExprKind::EPath(_) : return,
        _                  : {},
    }
    Vec<DerivFact> stored = match (stored_facts(b, it, inner, 0))
    {
        Some(v) : v,
        None    : return,
    };
    Option<String> through = None;
    ref<Expr, shared> x = strip_parens_tc(inner);
    while (true)
    {
        match (&x.kind)
        {
            ExprKind::EField(f) : x = strip_parens_tc(&Box::get(f).e),
            ExprKind::EDeref(y) : x = strip_parens_tc(Box::get(y)),
            ExprKind::EIndex(p) : x = strip_parens_tc(&Box::get(p).a),
            ExprKind::EPath(_)  :
            {
                match (one_seg(x))
                {
                    Some(n) : through = Some(String::clone(n)),
                    None    : {},
                }
                break;
            },
            _                   : break,
        }
    }
    for (usize si = 0; si < Vec::len(&stored); si += 1)
    {
        if (stored[si].v == Tri::F)
        {
            continue;
        }
        ref<DerivKey, shared> sk = &stored[si].key;
        for (usize i = 0; i < HashMap::len(&b.flow.deriv); i += 1)
        {
            ref<String, shared> h = HashMap::key_at(&b.flow.deriv, i);
            bool is_through = match (&through)
            {
                Some(t) : (*t == *h),
                None    : false,
            };
            if (is_through || !holder_live_after(b, it, h))
            {
                continue;
            }
            // A reference to the holder itself may reach what it keeps.
            ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&b.flow.deriv, i);
            bool clash = false;
            for (usize k = 0; k < HashMap::len(facts) && !clash; k += 1)
            {
                ref<DerivFact, shared> d = HashMap::value_at(facts, k);
                bool through_root = match (&through)
                {
                    Some(t) : (*t == d.key.root),
                    None    : false,
                };
                bool meets = through_root || ((d.key.root == sk.root) && overlap3(&d.key.path, &sk.path) != Ov::OvNo);
                clash = d.v != Tri::F && meets && !permitted(mode, d.key.mode);
            }
            if (clash)
            {
                usize line = b.current_line;
                String root = String::clone(&sk.root);
                String hn = String::clone(h);
                String tn = match (&through)
                {
                    Some(t) : String::clone(t),
                    None    : String::new(),
                };
                b.rep.checks += 1;
                b.rep.undecided += 1;
                Vec::push(
                    &mut b.rep.events,
                    sprintf("U\t%v\t%s\t%s\t%s\t%v", line, &root, mode_debug(mode), &hn, line),
                );
                rep_left(
                    b,
                    sprintf(
                        "line %v: an access through a reference that `%s` keeps, which a reference may reach",
                        line,
                        shown_name(&tn),
                    ),
                );
                return;
            }
        }
    }
}

// CHG-0438: a result that is a reference, a slice, a view, or what a frame
// holds as one (an `Option` of a reference, a closure), whose borrow is not
// visible, passes `[Ref-Escape-Rejected]` and is checked by the run (spec/10
// §2). That is only so if the run keeps its record: when what it inherits
// may be a binding of this frame, it is the run's.
fn result_ref_reach(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e, ref<Option<Type>, shared> rt)
{
    bool reference = match (rt)
    {
        Some(t) : is_borrow_ty(t) || (frame_ref_type(it, t) && match (t)
        {
            Type::THandle(_) : false,
            Type::TGuard(_)  : false,
            _                : true,
        }),
        None : false,
    };
    if (!reference || !b.report || b.flow.unreachable)
    {
        return;
    }
    match (inherited_facts(b, it, e, 0))
    {
        Some(v) :
        {
            bool local = false;
            for (usize i = 0; i < Vec::len(&v) && !local; i += 1)
            {
                local = v[i].key.root == ENDED_ROOT || frame_local_root(b, it, &v[i].key.root, 0);
            }
            if (local)
            {
                rep_left(b, sprintf("line %v: the result may refer to what ends with this frame", b.current_line));
            }
        },
        None    : {},
    }
}

// A fact's root that is a binding of this frame itself (not a parameter,
// not `<tier D>`): what ends when the frame or its block does. `*r` of a
// local reference binding `r` is what `r`'s own facts reach: one of those,
// or nothing known when it has none. A local that is itself a reference, a
// slice or a view, or that stores references: what is read through it or
// copied out of it refers where its facts do; none known, the record is as
// it was.
fn frame_local_root(ref<Body, shared> b, ref<Items, shared> it, StringView root, usize depth) : bool
{
    Vec<usize> blocks = Vec::new();
    frame_local_blocks(b, it, root, depth, &mut blocks);
    Vec::len(&blocks) > 0
}

// The blocks of the bindings of this frame `frame_local_root` finds `root`
// may reach, each binding's own; for `*r` of a reference `r` whose facts are
// unknown, `r`'s block.
fn frame_local_blocks(ref<Body, shared> b, ref<Items, shared> it, StringView root, usize depth, ref<Vec<usize>, exclusive> out)
{
    if (depth > 8)
    {
        return;
    }
    match (StringView::strip_prefix(root, "*"))
    {
        Some(r) :
        {
            String rs = String::copy(r);
            if (StringView::starts_with(r, "*") || HashSet::contains(&b.params, &rs))
            {
                return;
            }
            usize rb = match (HashMap::get(&b.decl_block, &rs))
            {
                Some(x) : *x,
                None    : return,
            };
            bool live = false;
            match (HashMap::get(&b.flow.deriv, &rs))
            {
                Some(f) :
                {
                    for (usize i = 0; i < HashMap::len(f); i += 1)
                    {
                        ref<DerivFact, shared> d = HashMap::value_at(f, i);
                        if (d.v != Tri::F)
                        {
                            live = true;
                            frame_local_blocks(b, it, &d.key.root, depth + 1, out);
                        }
                    }
                },
                None    : {},
            }
            if (!live && unknown_holder_reach(b, &rs))
            {
                Vec::push(out, rb);
            }
            return;
        },
        None    : {},
    }
    String rs = String::copy(root);
    if (StringView::starts_with(root, "<") || HashSet::contains(&b.params, &rs))
    {
        return;
    }
    usize db = match (HashMap::get(&b.decl_block, &rs))
    {
        Some(x) : *x,
        None    : return,
    };
    match (HashMap::get(&b.gamma, &rs))
    {
        Some(t) :
        {
            if (is_borrow_ty(t) || stores_refs(it, t))
            {
                match (HashMap::get(&b.flow.deriv, &rs))
                {
                    Some(f) :
                    {
                        for (usize i = 0; i < HashMap::len(f); i += 1)
                        {
                            ref<DerivFact, shared> d = HashMap::value_at(f, i);
                            if (d.v != Tri::F && d.key.root != rs)
                            {
                                frame_local_blocks(b, it, &d.key.root, depth + 1, out);
                            }
                        }
                    },
                    None    : {},
                }
                return;
            }
            Vec::push(out, db);
        },
        None    : Vec::push(out, db),
    }
}

// `*r` of a local `r` whose facts are unknown: what it reaches may be this
// frame's when `r` is a reference; a holder that is no reference itself
// (`Parts`, the hidden iterator of a `foreach` over a splitter's call) is as
// a local holder in `frame_local_root`: the record as it was.
fn unknown_holder_reach(ref<Body, shared> b, ref<String, shared> r) : bool
{
    match (HashMap::get(&b.gamma, r))
    {
        Some(t) : is_borrow_ty(t),
        None    : true,
    }
}

// CHG-0438: a reference stored into a binding declared in block `dest`
// whose borrow is not visible is the run's to check when what it inherits
// may be a local of a block `dest` strictly encloses.
fn escape_into_reach(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    usize dest,
    ref<Expr, shared> e,
    Option<Option<Vec<DerivFact>>> before,
)
{
    if (!b.report || b.flow.unreachable)
    {
        return;
    }
    // A closure holds what its captures reach (CHG-0439); another value what
    // it reached before the store moved it.
    bool is_closure = match (&strip_parens_tc(e).kind)
    {
        ExprKind::EClosure(_) : true,
        _                     : false,
    };
    Option<Vec<DerivFact>> got = match (before)
    {
        Some(v) : v,
        None    : if (is_closure) { Some(closure_facts_of(b, it, e)) } else { inherited_facts(b, it, e, 0) },
    };
    match (got)
    {
        Some(v) :
        {
            // The blocks of the bindings what it inherits may reach: through
            // a part of a `foreach` over a splitter's call, `*$d` reaches the
            // text the loop's holder views, whose own block is the one to
            // compare.
            bool inner = false;
            for (usize i = 0; i < Vec::len(&v) && !inner; i += 1)
            {
                if (v[i].key.root == ENDED_ROOT)
                {
                    inner = true;
                    break;
                }
                Vec<usize> blocks = Vec::new();
                frame_local_blocks(b, it, &v[i].key.root, 0, &mut blocks);
                for (usize j = 0; j < Vec::len(&blocks) && !inner; j += 1)
                {
                    inner = strictly_encloses(b, dest, blocks[j]);
                }
            }
            if (inner)
            {
                rep_left(b, sprintf("line %v: the stored reference may refer to what ends before the place it is stored in", b.current_line));
            }
        },
        None    : {},
    }
}

// D-0290: whether a result that holds references in data reaches only
// what the parameters do (`*p`), which is what a caller takes it to hold;
// one holding this frame's places, or what is unknown, is not. A result
// holding no references needs no test. Reported to the run when it does
// not; `true` when a holder it moves out has its facts followed so.
fn result_reach_ok(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Option<Type>, shared> rt,
) : bool
{
    bool data = match (rt)
    {
        Some(t) : data_type(b, it, t),
        None    : false,
    };
    if (!data || !b.report || b.flow.unreachable)
    {
        return false;
    }
    bool ok = Option::is_none(&b.closure_ret);
    if (ok)
    {
        match (inherited_facts(b, it, e, 0))
        {
            None    : {},
            Some(v) :
            {
                ok = Vec::len(&v) > 0;
                for (usize i = 0; i < Vec::len(&v) && ok; i += 1)
                {
                    ok = match (StringView::strip_prefix(&v[i].key.root, "*"))
                    {
                        Some(p) : !StringView::starts_with(
                            p,
                            "*",
                        ) && HashSet::contains(&b.params, &String::copy(p)),
                        None : false,
                    };
                }
            },
        }
    }
    if (!ok)
    {
        rep_left(
            b,
            sprintf("line %v: the result holds references to what is not a parameter's (D-0290)", b.current_line),
        );
    }
    ok
}

// D-0290: the binding a place written belongs to, and whether the place is
// reached through a reference (`*r`, `r.f`, `p[i]` of a reference `p`, a
// raw pointer), not a place of the binding itself. A whole reference
// binding assigned (`r = &x`) is rebound, not written through.
struct StoreTarget
{
    String name;
    bool through;
}

fn store_target(ref<Body, shared> b, ref<Expr, shared> lhs) : Option<StoreTarget>
{
    ref<Expr, shared> e = strip_parens_tc(lhs);
    bool through = false;
    bool projected = false;
    while (true)
    {
        match (&e.kind)
        {
            ExprKind::EField(f)  :
            {
                projected = true;
                e = strip_parens_tc(&Box::get(f).e);
            },
            ExprKind::EIndex(p)  :
            {
                projected = true;
                e = strip_parens_tc(&Box::get(p).a);
            },
            ExprKind::EDeref(x)  :
            {
                through = true;
                e = strip_parens_tc(Box::get(x));
            },
            // A raw pointer moved along (`*(v.ptr + i)`): its base.
            ExprKind::EBinary(x) :
            {
                if (!through)
                {
                    return Some(StoreTarget { .name = String::new(), .through = true });
                }
                e = strip_parens_tc(&Box::get(x).a);
            },
            ExprKind::EPath(_) : match (one_seg(e))
            {
                Some(n) :
                {
                    bool via_ref = match (HashMap::get(&b.gamma, n))
                    {
                        Some(Type::TRef(_))    : true,
                        Some(Type::TSlice(_))  : true,
                        Some(Type::TRawptr(_)) : true,
                        Some(Type::TGuard(_))  : true,
                        _                      : false,
                    };
                    return Some(StoreTarget { .name = String::clone(n), .through = through || (projected && via_ref) || !is_local(
                        b,
                        n,
                    ) });
                },
                None    : return Some(StoreTarget { .name = String::new(), .through = true }),
            },
            _                    : return Some(StoreTarget { .name = String::new(), .through = true }),
        }
    }
    None
}

// D-0290: a value holding references (`facts`, what it holds) stored into
// a holder `n` (whole when `whole`) or through a reference. Into a holder
// its facts are added -- an element or field replaced may have held any
// of the old ones, which then hold on some paths only; a whole assignment
// replaces them. Through a reference it is an escape, the run's, unless
// what it holds was read out of that same data (`**q`).
fn holder_store(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> n,
    bool through,
    bool whole,
    ref<Expr, shared> rhs,
    Option<Vec<DerivFact>> facts,
) : Result<void, String>
{
    if (b.flow.unreachable)
    {
        return Ok(());
    }
    bool report = b.report;
    if (!through && is_holder(b, it, n))
    {
        if (whole)
        {
            Option<HashMap<String, DerivFact>> prev = match (HashMap::get(&b.flow.deriv, n))
            {
                Some(m) : if (HashMap::len(m) > 0) { Some(HashMap::clone(m)) } else { None },
                None    : None,
            };
            set_deriv(b, n, Vec::new());
            b.prev_facts = match (prev)
            {
                Some(m) : Some(PrevFacts { .name = String::clone(n), .facts = m }),
                None    : None,
            };
            Result<void, String> r = match (facts)
            {
                Some(v) :
                {
                    if (facts_known(&v))
                    {
                        b.prev_facts = None;
                        Vec<DerivFact> w = through_refs(b, v);
                        set_deriv_tri(b, n, w);
                        Ok(())
                    }
                    else
                    {
                        tier_inherit(b, it, n, Some(rhs))
                    }
                },
                None    : tier_inherit(b, it, n, Some(rhs)),
            };
            b.prev_facts = None;
            return r;
        }
        match (HashMap::get_mut(&mut b.flow.deriv, n))
        {
            Some(m) :
            {
                for (usize k = 0; k < HashMap::len(m); k += 1)
                {
                    ref<String, shared> code = HashMap::key_at(m, k);
                    String c = String::clone(code);
                    ref<DerivFact, exclusive> d = Option::expect(HashMap::get_mut(m, &c), "a fact");
                    if (d.v == Tri::T)
                    {
                        d.v = Tri::U;
                    }
                }
            },
            None    : {},
        }
        match (facts)
        {
            None    : {},
            Some(v) :
            {
                if (facts_known(&v))
                {
                    Vec<DerivFact> w = through_refs(b, v);
                    add_deriv_tri(b, n, w);
                }
                else if (report)
                {
                    rep_left(
                        b,
                        sprintf(
                            "line %v: what is stored into `%s` holds references not known before the run",
                            b.current_line,
                            n,
                        ),
                    );
                }
            },
        }
        return Ok(());
    }
    String own = sprintf("**%s", n);
    bool inside = match (&facts)
    {
        None    : true,
        Some(v) :
        {
            bool all = Vec::len(v) > 0;
            for (usize i = 0; i < Vec::len(v) && all; i += 1)
            {
                all = (v[i].key.root == own);
            }
            all
        },
    };
    if (!inside && through && HashSet::contains(&b.params, n) && caller_sees(b, &facts))
    {
        inside = true;
        // What the caller adds for it: the summary's pairs (bug 014). A
        // parameter stored whole is the reference it is, which the caller
        // counts by its type.
        bool whole_param = match (one_seg(strip_parens_tc(rhs)))
        {
            Some(x) : HashSet::contains(&b.params, x),
            None    : false,
        };
        if (!whole_param)
        {
            note_part_stores(b, n, &facts);
        }
    }
    bool data = match (HashMap::get(&b.gamma, n))
    {
        Some(t) :
        {
            Type tt = clone(t);
            data_type(b, it, &tt)
        },
        None    : true,
    };
    if (!inside && report && (through || data))
    {
        rep_left(
            b,
            sprintf("line %v: a reference is stored where this frame does not hold it (D-0290)", b.current_line),
        );
        // Its callers, which see no pair for it, are left to the run too
        // (bug 014).
        if (through)
        {
            HashSet::insert(&mut b.facts.part_stores_all, String::clone(&b.fn_name));
        }
    }
    Ok(())
}

// D-0290: facts a holder takes, with each rooted at `*q` for a reference
// binding `q` of this frame that holds facts replaced by those: the
// holder keeps what `q` reaches after `q` ends.
fn through_refs(ref<Body, shared> b, Vec<DerivFact> v) : Vec<DerivFact>
{
    Vec<DerivFact> out = Vec::new();
    for (usize i = 0; i < Vec::len(&v); i += 1)
    {
        ref<DerivFact, shared> f = &v[i];
        Option<String> q = match (StringView::strip_prefix(&f.key.root, "*"))
        {
            Some(qv) :
            {
                String qs = String::copy(qv);
                if (!StringView::starts_with(qv, "*") && !HashSet::contains(&b.params, &qs) && local_is_ref(b, &qs))
                {
                    Some(qs)
                }
                else
                {
                    None
                }
            },
            None     : None,
        };
        Vec<DerivFact> held = match (&q)
        {
            Some(qs) : facts_of(b, qs, false),
            None     : Vec::new(),
        };
        if (Vec::len(&held) == 0)
        {
            Vec::push(&mut out, clone(f));
            continue;
        }
        for (usize k = 0; k < Vec::len(&held); k += 1)
        {
            if (held[k].v == Tri::F)
            {
                continue;
            }
            Vec<PElem> p = clone(&held[k].key.path);
            Vec::append(&mut p, clone(&f.key.path));
            Mode m = if (f.key.mode == Mode::Shared) { Mode::Shared } else { held[k].key.mode };
            Tri t = if (f.v == Tri::T) { held[k].v } else { Tri::U };
            Vec::push(&mut out, fact(String::clone(&held[k].key.root), p, m, t));
        }
        // A copy of an exclusive reference `q` (`H { .m = q }`, `[q]`) is an
        // exclusive borrow of `*q` as well, as the copy `n = q` is (CHG-0439,
        // F09).
        if (f.key.mode == Mode::Exclusive)
        {
            Vec::push(&mut out, clone(f));
        }
    }
    out
}

// Bug 014 (spec/14 §6, the part-store summary): a value holding `facts`
// stored where parameter `target` reaches, accepted as what the caller sees
// given: for each parameter `q` whose referent it may refer into (`*q`), the
// pair `target:q` of this function's summary. What a parameter's referent
// keeps (`**q`) is a reference the caller counts as kept there, not a part.
fn note_part_stores(ref<Body, exclusive> b, ref<String, shared> target, ref<Option<Vec<DerivFact>>, shared> facts)
{
    usize t = match (HashMap::get(&b.param_idx, target))
    {
        Some(i) : *i,
        None    : return,
    };
    ref<Vec<DerivFact>, shared> v = match (facts)
    {
        Some(v) : v,
        None    : return,
    };
    for (usize i = 0; i < Vec::len(v); i += 1)
    {
        ref<String, shared> root = &v[i].key.root;
        StringView rest = match (StringView::strip_prefix(root, "*"))
        {
            Some(r) : r,
            None    : continue,
        };
        if (StringView::starts_with(rest, "*"))
        {
            continue;
        }
        String qs = String::copy(rest);
        match (HashMap::get(&b.param_idx, &qs))
        {
            Some(s) :
            {
                if (*s != t)
                {
                    String code = sprintf("%v:%v", t, *s);
                    ref<HashSet<String>, exclusive> pairs = HashMap::entry(
                        &mut b.facts.part_stores,
                        &b.fn_name,
                        HashSet::new(),
                    );
                    HashSet::insert(pairs, code);
                }
            },
            None    : {},
        }
    }
}

// Bug 014: whether `callee`'s summary lets it store into what its parameter
// `t` reaches a reference into a part of what its parameter `s` refers to.
// `known`: the summaries found so far (a pair found is final; one not yet
// found is settled when every body is checked, `part_resolve`).
fn part_store_known(ref<Facts, shared> facts, ref<String, shared> callee, usize t, usize s) : bool
{
    if (HashSet::contains(&facts.part_stores_all, callee))
    {
        return true;
    }
    match (HashMap::get(&facts.part_stores, callee))
    {
        Some(p) : HashSet::contains(p, &sprintf("%v:%v", t, s)),
        None    : false,
    }
}

// Bug 014: once every body is checked, each call that judged an argument
// given exclusively by its own type stands if its callee's summary has no
// such pair; one that does not stand leaves its body to the run (its frame
// may lack facts it should have taken), and its function, whose own summary
// may then lack pairs, is taken to store any (`part_stores_all`), until
// nothing changes. A callee whose body was not checked is taken to store any.
fn part_resolve(ref<Items, exclusive> it, ref<Facts, exclusive> facts)
{
    bool changed = true;
    while (changed)
    {
        changed = false;
        for (usize i = 0; i < Vec::len(&facts.part_assumes); i += 1)
        {
            if (facts.part_assumes[i].failed)
            {
                continue;
            }
            PartAssume a = clone(&facts.part_assumes[i]);
            bool fails = !HashSet::contains(&facts.part_summarized, &a.callee) || part_store_known(
                &*facts,
                &a.callee,
                a.t,
                a.s,
            );
            if (!fails)
            {
                continue;
            }
            facts.part_assumes[i].failed = true;
            if (!HashMap::contains(&it.tracking_needed, &a.body))
            {
                StringView shown = Option::unwrap_or(StringView::strip_prefix(&a.callee, "std::"), &a.callee);
                String why = sprintf(
                    "line %v: `%s` may store a reference into a part of its argument %v, given exclusively, where its argument %v reaches (D-0290)",
                    a.line,
                    shown,
                    a.s + 1,
                    a.t + 1,
                );
                HashMap::insert(&mut it.tracking_needed, String::clone(&a.body), why);
            }
            Vec<usize> ids = match (HashMap::get(&facts.part_tails, &a.body))
            {
                Some(v) : clone(v),
                None    : Vec::new(),
            };
            for (usize k = 0; k < Vec::len(&ids); k += 1)
            {
                HashSet::remove(&mut facts.self_tails, ids[k]);
            }
            if (HashSet::insert(&mut facts.part_stores_all, String::clone(&a.func)))
            {
                changed = true;
            }
        }
    }
}

// D-0290: whether a value stored through a reference holds only what the
// caller sees given (a parameter's referent `*q`, what one keeps `**q`)
// or static data: every call adds what its other arguments reach to a
// holder it gives exclusively, and leaves to the run one it gives that is
// no holder of its own.
fn caller_sees(ref<Body, shared> b, ref<Option<Vec<DerivFact>>, shared> facts) : bool
{
    match (facts)
    {
        None    : true,
        Some(v) :
        {
            if (Vec::len(v) == 0)
            {
                return false;
            }
            for (usize i = 0; i < Vec::len(v); i += 1)
            {
                ref<String, shared> root = &v[i].key.root;
                StringView p = strip_stars(root);
                usize stars = StringView::len(root) - StringView::len(p);
                if (!(StringView::starts_with(
                    root,
                    "*",
                ) && stars <= 2 && HashSet::contains(&b.params, &String::copy(p))))
                {
                    return false;
                }
            }
            true
        },
    }
}

// D-0290: a holder moved anywhere its facts do not follow (an argument, a
// field, a `return`) takes what it holds out of this analysis' sight: the
// run's, unless `drop` ends it here.
fn holder_leaves(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> x)
{
    if (!b.holding && !b.joining && b.report && is_holder(b, it, x) && has_live_fact(b, x))
    {
        rep_left(b, sprintf("line %v: `%s` leaves this frame holding references (D-0290)", b.current_line, x));
    }
}

// D-0289: whether `callee` is the `std` function `key`.
fn is_std_fn(ref<Items, shared> it, ref<Expr, shared> callee, str key) : bool
{
    match (resolve_fn_path(it, callee))
    {
        Some(k) : k == key,
        None    : false,
    }
}

fn is_std_fn_in(ref<Items, shared> it, ref<Expr, shared> callee, slice<str, shared> keys) : bool
{
    String found = match (resolve_fn_path(it, callee))
    {
        Some(k) : k,
        None    : return false,
    };
    foreach (k in keys)
    {
        if (found == *k)
        {
            return true;
        }
    }
    false
}

// Whether a resolved callee is one of `keys`.
fn key_in(ref<Option<String>, shared> k, slice<str, shared> keys) : bool
{
    match (k)
    {
        Some(found) :
        {
            foreach (x in keys)
            {
                if (*found == *x)
                {
                    return true;
                }
            }
            false
        },
        None        : false,
    }
}

// `may_hold_excl_ref`, worked out once per type.
fn excl_cached(ref<Body, exclusive> b, ref<Items, shared> it, ref<Type, shared> t) : bool
{
    String code = type_code(t);
    match (HashMap::get(&b.facts.excl_memo, &code))
    {
        Some(v) : return *v,
        None    : {},
    }
    bool v = may_hold_excl_ref(it, t);
    HashMap::insert(&mut b.facts.excl_memo, code, v);
    v
}

// D-0289: the local holding thread handles that `e` names or takes handles
// out of (`hs`, `&mut hs`, `Vec::pop(&mut hs)`, a `foreach`'s drain and
// take of it), and the facts it holds: a handle taken out of it holds what
// its thread was lent.
struct HandleHolder
{
    String name;
    Vec<DerivFact> facts;
}

fn handle_holder_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e0) : Option<HandleHolder>
{
    ref<Expr, shared> e = strip_parens_tc(e0);
    String name = match (&e.kind)
    {
        ExprKind::EPath(_) : match (one_seg(e))
        {
            Some(n) : if (is_local(b, n)) { String::clone(n) } else { return None },
            None    : return None,
        },
        ExprKind::EBorrow(x) : return handle_holder_of(b, it, &Box::get(x).e),
        ExprKind::EIndex(p)  : return handle_holder_of(b, it, &Box::get(p).a),
        ExprKind::ECall(cb)  :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            if (Vec::len(&c.args) == 0)
            {
                return None;
            }
            bool internal = match (one_seg(&c.callee))
            {
                Some(n) : *n == "$each_drain" || *n == "$each_take",
                None    : false,
            };
            bool takes = is_std_fn_in(
                it,
                &c.callee,
                &[
                    "std::Vec::pop",
                    "std::Vec::remove",
                    "std::Vec::swap_remove",
                    "std::Vec::drain",
                    "std::Drain::take",
                    "std::Option::unwrap",
                    "std::Option::expect",
                ],
            );
            if (!(internal || takes))
            {
                return None;
            }
            return handle_holder_of(b, it, &c.args[0]);
        },
        _                    : return None,
    };
    Type t = lookup_local(b, &name)?;
    if (!holds_handle(&t))
    {
        return None;
    }
    if (!HashMap::contains(&b.flow.deriv, &name))
    {
        return None;
    }
    Vec<DerivFact> facts = holder_facts(b, &name);
    if (Vec::len(&facts) == 0)
    {
        return None;
    }
    Some(HandleHolder { .name = name, .facts = facts })
}

// D-0289: `r` holds `facts` besides what it held (a handle pushed onto a
// `Vec` of handles).
fn add_deriv_tri(ref<Body, exclusive> b, ref<String, shared> r, Vec<DerivFact> facts)
{
    if (b.flow.unreachable || Vec::len(&facts) == 0)
    {
        return;
    }
    ref<HashMap<String, DerivFact>, exclusive> m = HashMap::entry(&mut b.flow.deriv, r, HashMap::new());
    for (usize i = 0; i < Vec::len(&facts); i += 1)
    {
        Tri v = facts[i].v;
        String code = deriv_code(&facts[i].key);
        ref<DerivFact, exclusive> e = HashMap::entry(m, &code, clone(&facts[i]));
        if (e.v != v)
        {
            e.v = if (e.v == Tri::T || v == Tri::T) { Tri::T } else { Tri::U };
        }
    }
    foreach (f in &facts)
    {
        note_root(&mut b.flow, r, &f.key);
    }
}

// D-0289: what a thread's handle holds: what `spawn_facts_of` gives, and
// what the closure it runs captured (D-0288), with their truth.
fn spawn_facts_tri_of(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e) : Vec<DerivFact>
{
    Vec<DerivFact> v = Vec::new();
    Vec<DerivKey> keys = spawn_facts_of(b, it, e);
    for (usize i = 0; i < Vec::len(&keys); i += 1)
    {
        Vec::push(&mut v, DerivFact { .key = clone(&keys[i]), .v = Tri::T });
    }
    match (call_args(e))
    {
        Some(args) :
        {
            if (Vec::len(args) > 0)
            {
                ref<Expr, shared> f = &args[0];
                if (is_closure(f))
                {
                    Vec::append(&mut v, closure_facts_of(b, it, f));
                }
                else
                {
                    bool local_fn = match (one_seg(strip_parens_tc(f)))
                    {
                        Some(n) : is_local(b, n),
                        None    : false,
                    };
                    if (local_fn)
                    {
                        Vec::append(&mut v, fn_value_facts(b, it, f));
                    }
                }
            }
        },
        None       : {},
    }
    v
}

// D-0289: `r` takes a new value while a thread's handle holds a lend
// through it (`spawn(f, r)`, a closure capturing `r`): the fact names
// `*r`, which now means something else, and the thread still holds the
// old referent. The run checks it.
fn handle_lend_through(ref<Body, exclusive> b, ref<String, shared> r)
{
    if (!b.report || b.flow.unreachable)
    {
        return;
    }
    String rr = referent_root(r);
    bool held = false;
    // Bug 021: the holders listed for `rr` (`Flow.rooted`).
    Vec<String> hs = holders_of(&b.flow, &rr, false);
    for (usize i = 0; i < Vec::len(&hs) && !held; i += 1)
    {
        ref<String, shared> h = &hs[i];
        if (*h == *r)
        {
            continue;
        }
        bool is_handle = match (HashMap::get(&b.gamma, h))
        {
            Some(Type::THandle(_)) : true,
            _                      : false,
        };
        if (!is_handle)
        {
            continue;
        }
        ref<HashMap<String, DerivFact>, shared> f = match (HashMap::get(&b.flow.deriv, h))
        {
            Some(m) : m,
            None    : continue,
        };
        for (usize k = 0; k < HashMap::len(f) && !held; k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(f, k);
            held = (d.key.root == rr) && d.v != Tri::F;
        }
    }
    if (held)
    {
        rep_left(
            b,
            sprintf(
                "line %v: `%s` is given a new referent while a thread holds what it was lent through it",
                b.current_line,
                r,
            ),
        );
    }
}

// The declared parameter types of the function `e` names, if any.
fn fn_param_types(ref<Items, shared> it, ref<Expr, shared> e) : Option<Vec<Type>>
{
    String k = resolve_fn_path(it, e)?;
    ref<FnDecl, shared> fd = Option::expect(HashMap::get(&it.fns, &k), "a function");
    Vec<Type> ps = Vec::new();
    for (usize i = 0; i < Vec::len(&fd.params); i += 1)
    {
        Vec::push(&mut ps, clone(&fd.params[i].ty));
    }
    Some(ps)
}

fn local_type_holds_guard(ref<Body, shared> b, ref<String, shared> n) : bool
{
    match (HashMap::get(&b.gamma, n))
    {
        Some(t) : holds_guard(t),
        None    : false,
    }
}

// D-0289 scoped lending: a thread is lent what it reaches statically only
// while a binding of this frame holds its handle (no thread outlives its
// handle's frame, spec/19). A spawn whose handle goes anywhere else while
// it lends, or whose closure takes a guard to another thread (D-0240: a
// lock path stays its locking thread's), is the run's to check.
fn tier_spawn_rule(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> callee, ref<Vec<Expr>, shared> args)
{
    if (!b.report || b.flow.unreachable || Vec::len(args) == 0)
    {
        return;
    }
    Expr whole = mk(
        ExprKind::ECall(Box::new(CallExpr { .callee = clone(callee), .args = clone(args) })),
        callee.line,
        callee.col,
    );
    bool lends = Vec::len(&spawn_facts_tri_of(b, it, &whole)) > 0;
    for (usize i = 1; i < Vec::len(args) && !lends; i += 1)
    {
        lends = arg_may_be_reference(b, it, &args[i]);
    }
    // A lent argument that forms no fact (a slice or a view binding passed
    // whole, D-0247; a value holding references) is not seen.
    for (usize i = 1; i < Vec::len(args); i += 1)
    {
        ref<Expr, shared> a = &args[i];
        bool visible = Vec::len(&deriv_facts_of(b, it, a)) > 0;
        bool lent_ref = match (one_seg(strip_parens_tc(a)))
        {
            Some(n) : flow_is_tracked(&b.flow, n) && local_is_ref(b, n),
            None    : false,
        };
        if (arg_may_be_reference(b, it, a) && !visible && !lent_ref)
        {
            rep_left(b, sprintf("line %v: a thread is lent a reference no fact describes", callee.line));
            break;
        }
    }
    // A thread reading, through a shared reference it is lent, an exclusive
    // one this thread holds: the run's.
    Option<Vec<Type>> params = fn_param_types(it, &args[0]);
    for (usize i = 1; i < Vec::len(args); i += 1)
    {
        Option<Type> t = match (&params)
        {
            Some(ps) : if (i - 1 < Vec::len(ps)) { Some(clone(&ps[i - 1])) } else { value_shape(b, it, &args[i]) },
            None     : value_shape(b, it, &args[i]),
        };
        bool bad = match (&t)
        {
            Some(tt) : excl_under_shared(it, tt, false, &mut new_name_set()),
            None     : false,
        };
        if (bad)
        {
            rep_left(b, sprintf("line %v: a thread is lent an exclusive reference through a shared one", callee.line));
            break;
        }
    }
    match (&strip_parens_tc(&args[0]).kind)
    {
        ExprKind::EClosure(cb) :
        {
            ref<Vec<String>, shared> caps = &Box::get(cb).captures;
            bool bad = false;
            for (usize i = 0; i < Vec::len(caps) && !bad; i += 1)
            {
                bad = match (HashMap::get(&b.gamma, &caps[i]))
                {
                    Some(t) : excl_under_shared(it, t, false, &mut new_name_set()),
                    None    : false,
                };
            }
            if (bad)
            {
                rep_left(
                    b,
                    sprintf("line %v: a thread is lent an exclusive reference through a shared one", callee.line),
                );
            }
        },
        _                      : {},
    }
    if (lends && !HashSet::contains(&b.bound_spawns, &site_key(callee.line, callee.col)))
    {
        rep_left(
            b,
            sprintf("line %v: a thread is lent references and its handle is not held by this frame", callee.line),
        );
    }
    // A guard given to the thread as an argument goes there as one captured
    // does.
    bool guard_param = match (&strip_parens_tc(&args[0]).kind)
    {
        ExprKind::EClosure(cb) :
        {
            ref<Vec<ParamDecl>, shared> ps = &Box::get(cb).params;
            bool any = false;
            for (usize i = 0; i < Vec::len(ps) && !any; i += 1)
            {
                any = holds_guard(&ps[i].ty);
            }
            any
        },
        _ : match (&params)
        {
            Some(ps) :
            {
                bool any = false;
                for (usize i = 0; i < Vec::len(ps) && !any; i += 1)
                {
                    any = holds_guard(&ps[i]);
                }
                any
            },
            None     : false,
        },
    };
    bool guard_arg = false;
    for (usize i = 1; i < Vec::len(args) && !guard_arg; i += 1)
    {
        guard_arg = match (one_seg(strip_parens_tc(&args[i])))
        {
            Some(n) : local_type_holds_guard(b, n),
            None    : false,
        };
    }
    if (guard_param || guard_arg)
    {
        rep_left(b, sprintf("line %v: a guard is taken to another thread", callee.line));
    }
    match (&strip_parens_tc(&args[0]).kind)
    {
        ExprKind::EClosure(cb) :
        {
            ref<Vec<String>, shared> caps = &Box::get(cb).captures;
            bool any = false;
            for (usize i = 0; i < Vec::len(caps) && !any; i += 1)
            {
                any = local_type_holds_guard(b, &caps[i]);
            }
            if (any)
            {
                rep_left(b, sprintf("line %v: a guard is taken to another thread", callee.line));
            }
        },
        _                      :
        {
            bool named_fn = match (path_segs(strip_parens_tc(&args[0])))
            {
                Some(segs) : Option::is_some(&resolve_fn_path(
                    it,
                    strip_parens_tc(&args[0]),
                )) && !(Vec::len(segs) == 1 && is_local(b, &segs[0])),
                None : false,
            };
            if (!named_fn)
            {
                rep_left(
                    b,
                    sprintf("line %v: a thread runs a `fn` value, whose captures only the run knows", callee.line),
                );
            }
        },
    }
}

// A closure holds what a captured reference, view or closure reaches: a
// reference its referent `*r`, as a copy of it does (D-0071), anything
// else the capture's own facts (D-0288). A captured reference is borrowed
// itself (spec/15 §6): the binding may not be assigned while the closure
// lives.
fn closure_facts_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Vec<DerivFact>
{
    Vec<DerivFact> facts = Vec::new();
    ref<ClosureExpr, shared> c = match (&strip_parens_tc(e).kind)
    {
        ExprKind::EClosure(cb) : Box::get(cb),
        _                      : return facts,
    };
    for (usize i = 0; i < Vec::len(&c.captures); i += 1)
    {
        ref<String, shared> name = &c.captures[i];
        Option<Type> t = lookup_local(b, name);
        match (&t)
        {
            Some(Type::TRef(x)) : Vec::push(
                &mut facts,
                fact(referent_root(name), Vec::new(), Box::get(x).mode, Tri::T),
            ),
            Some(Type::TSlice(x)) : Vec::push(
                &mut facts,
                fact(referent_root(name), Vec::new(), Box::get(x).mode, Tri::T),
            ),
            Some(tt) :
            {
                if (may_hold_ref(it, tt, 0) && HashMap::contains(&b.flow.deriv, name))
                {
                    Vec<DerivFact> held = facts_of(b, name, false);
                    for (usize k = 0; k < Vec::len(&held); k += 1)
                    {
                        if (!is_tier_d_root(&held[k].key.root))
                        {
                            Vec::push(&mut facts, clone(&held[k]));
                        }
                    }
                }
            },
            None     : {},
        }
        if (!c.is_move && flow_is_tracked(&b.flow, name) && Option::is_some(&t))
        {
            Mode m = if (closure_body_writes(&c.body, name)) { Mode::Exclusive } else { Mode::Shared };
            Vec::push(&mut facts, fact(String::clone(name), Vec::new(), m, Tri::T));
        }
    }
    facts
}

// What a value copied out of a binding (not a reference) holds: the
// binding's facts, and nothing of the binding itself; anything else what it
// inherits (`fn_value_facts`'s `held`).
fn held_facts(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> a) : Vec<DerivFact>
{
    match (one_seg(strip_parens_tc(a)))
    {
        Some(n) :
        {
            if (!local_is_ref(b, n))
            {
                return facts_of(b, n, false);
            }
        },
        None    : {},
    }
    Option::unwrap_or(inherited_facts(b, it, a, 0), Vec::new())
}

// What a `fn` value that is no closure literal holds: a copy of one what
// it holds; a call's result, a closure that may have kept any argument
// that can hold a reference, what those reach, not known before the run
// (`Tri::U`: the run decides, D-0288).
fn fn_value_facts(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e) : Vec<DerivFact>
{
    ref<CallExpr, shared> c = match (&strip_parens_tc(e).kind)
    {
        ExprKind::ECall(cb) : Box::get(cb),
        _                   :
        {
            Vec<DerivFact> held = held_facts(b, it, e);
            Vec<DerivFact> out = Vec::new();
            for (usize i = 0; i < Vec::len(&held); i += 1)
            {
                if (!is_tier_d_root(&held[i].key.root))
                {
                    Vec::push(&mut out, clone(&held[i]));
                }
            }
            return out;
        },
    };
    Option<Vec<Type>> params = fn_param_types(it, &c.callee);
    Vec<DerivFact> facts = Vec::new();
    for (usize j = 0; j < Vec::len(&c.args); j += 1)
    {
        bool plain = match (&params)
        {
            Some(ps) : j < Vec::len(ps) && !may_hold_ref(it, &ps[j], 0),
            None     : false,
        };
        if (plain)
        {
            continue;
        }
        Vec<DerivFact> held = held_facts(b, it, &c.args[j]);
        for (usize i = 0; i < Vec::len(&held); i += 1)
        {
            if (!is_tier_d_root(&held[i].key.root))
            {
                Vec::push(&mut facts, DerivFact { .key = clone(&held[i].key), .v = Tri::U });
            }
        }
    }
    facts
}

// `&v[i]` on a `Vec` is `Vec::index_shared(&v, i)` (`[Index-Vec]`), an
// elided call on a borrow of `v`: derived from `v` as that call is.
fn vec_element_root(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Place>
{
    ref<PairExpr, shared> ix = match (&strip_parens_tc(e).kind)
    {
        ExprKind::EIndex(ib) : Box::get(ib),
        _                    : return None,
    };
    ref<Expr, shared> base = &ix.a;
    // A `Vec` reached through a reference (`v[i]` with `v` one, auto-
    // dereferenced, or `(*v)[i]`, `r.f[i]`): the element of its referent.
    Type bt = static_place_type(b, it, base)?;
    Type vt = clone(&bt);
    Option<Place> root = None;
    bool through = match (&bt)
    {
        Type::TRef(rb)   :
        {
            vt = clone(&Box::get(rb).inner);
            true
        },
        Type::TGuard(gb) :
        {
            vt = clone(Box::get(gb));
            true
        },
        _                : false,
    };
    if (through)
    {
        root = match (one_seg(strip_parens_tc(base)))
        {
            Some(n) : if (flow_is_tracked(
                &b.flow,
                n,
            )) { Some(Place { .root = referent_root(n), .path = Vec::new() }) } else { None },
            None : None,
        };
    }
    else
    {
        root = match (place_of(b, it, base))
        {
            Some(p) : Some(p),
            None    : deref_place_of(b, it, base),
        };
    }
    if (!named_is(&vt, "std::Vec"))
    {
        return None;
    }
    Place p = root?;
    // D-0282: the element, so two of them are told apart. D-0217: every
    // element of a `Vec` of a zero-sized type is the one object anchored at
    // its buffer, one place; an element type not known here may be one.
    Vec<Type> targs = named_args(&vt);
    Option<u128> lit = if (Vec::len(&targs) > 0)
    {
        match (zero_sized(it, &targs[0], 0))
        {
            Some(false) : literal_index(&ix.b),
            Some(true)  : Some(0),
            None        : None,
        }
    }
    else { None };
    Vec::push(&mut p.path, PElem::PIndex(lit));
    Some(p)
}

// Whether `root.path` is an element of a `Vec` of a zero-sized type.
fn zero_sized_vec_element(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<String, shared> root,
    ref<Vec<PElem>, shared> path,
) : bool
{
    usize n = Vec::len(path);
    if (n == 0)
    {
        return false;
    }
    match (&path[n - 1])
    {
        PElem::PIndex(_) : {},
        _                : return false,
    }
    Vec<PElem> pre = Vec::new();
    for (usize i = 0; i + 1 < n; i += 1)
    {
        Vec::push(&mut pre, clone(&path[i]));
    }
    match (place_type(b, it, root, &pre))
    {
        Some(t) :
        {
            if (!named_is(&t, "std::Vec"))
            {
                return false;
            }
            Vec<Type> a = named_args(&t);
            Vec::len(&a) > 0 && match (zero_sized(it, &a[0], 0))
            {
                Some(z) : z,
                None    : false,
            }
        },
        None    : false,
    }
}

// Whether `t` is zero-sized (`spec/05`, D-0217): a struct whose fields
// all are, or an array of none or of a zero-sized element. `None` when it
// is not known here: a type parameter.
fn zero_sized(ref<Items, shared> it, ref<Type, shared> t, usize depth) : Option<bool>
{
    if (depth > 16)
    {
        return None;
    }
    match (t)
    {
        Type::TVoid     : Some(true),
        Type::TArray(b) :
        {
            if (Box::get(b).n == 0) { Some(true) } else { zero_sized(it, &Box::get(b).inner, depth + 1) }
        },
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(sd) :
                {
                    if (Option::is_some(&sd.bits))
                    {
                        return Some(false);
                    }
                    HashMap<String, Type> subst = zip_subst(&sd.type_params, &n.args);
                    Option<bool> all = Some(true);
                    for (usize i = 0; i < Vec::len(&sd.fields); i += 1)
                    {
                        match (zero_sized(it, &apply_subst(&sd.fields[i].ty, &subst), depth + 1))
                        {
                            Some(true)  : {},
                            Some(false) : return Some(false),
                            None        : all = None,
                        }
                    }
                    all
                },
                None     :
                {
                    if (HashMap::contains(
                        &it.enums,
                        &n.name,
                    ) || StringView::starts_with(&n.name, "std::")) { Some(false) } else { None }
                },
            }
        },
        _               : Some(false),
    }
}

fn tier_d_fact() : DerivFact
{
    fact("<tier D>", Vec::new(), Mode::Shared, Tri::T)
}

fn tier_d_facts() : Option<Vec<DerivFact>>
{
    Vec<DerivFact> v = Vec::new();
    Vec::push(&mut v, tier_d_fact());
    Some(v)
}

fn one_fact(DerivFact f) : Option<Vec<DerivFact>>
{
    Vec<DerivFact> v = Vec::new();
    Vec::push(&mut v, f);
    Some(v)
}

// `value_shape`, or the static place type.
fn shape_or_place(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Type>
{
    match (value_shape(b, it, e))
    {
        Some(t) : Some(t),
        None    : static_place_type(b, it, e),
    }
}

fn is_view_type(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(nb) : Box::get(nb).name == "std::StringView" && Vec::len(&Box::get(nb).args) == 0,
        _                : false,
    }
}

// Every fact's path extended by `r`, its mode set when `mode` says so.
fn facts_extended(Vec<DerivFact> v, ref<PElem, shared> r, Option<Mode> mode) : Vec<DerivFact>
{
    for (usize i = 0; i < Vec::len(&v); i += 1)
    {
        match (mode)
        {
            Some(m) : v[i].key.mode = m,
            None    : {},
        }
        Vec::push(&mut v[i].key.path, clone(r));
    }
    v
}

// D-0282: the facts a reference value inherits from where it came from
// when it is not a visible borrow -- another reference binding (its facts,
// or its referent `*r` when it has none), a field or a dereference of one,
// a single-reference call on one (D-0011), `foreach`'s hidden helpers, a
// `match`/`if`/block's results. `None` when the value comes from nothing
// that can hold a reference of this frame (a call with no reference
// argument: static data), `Some(empty)` when its source is unknown (tier
// D: a reference read out of a container or a struct).
fn inherited_facts(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    usize depth,
) : Option<Vec<DerivFact>>
{
    inherited_facts_in(b, it, e, depth, None, None)
}

// `inherited_facts` inside a `match` arm: `bname` stands for what the
// scrutinee `bscrut` holds.
fn inherited_facts_in(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e0,
    usize depth,
    Option<ref<String, shared>> bname,
    Option<ref<Expr, shared>> bscrut,
) : Option<Vec<DerivFact>>
{
    if (depth > 12)
    {
        return Some(Vec::new());
    }
    ref<Expr, shared> e = strip_parens_tc(e0);
    // A sub-view (`String::part(&s, lo, hi)`, `StringView::part`): the range
    // of its source it covers.
    match (&e.kind)
    {
        ExprKind::ECall(cb)    :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            match (path_segs(&c.callee))
            {
                Some(segs) :
                {
                    String k = String::join(segs, "::");
                    if ((k == "std::String::part" || k == "std::StringView::part") && Vec::len(&c.args) == 3)
                    {
                        PElem r = range_elem_in(b, &c.args[1], &c.args[2]);
                        Vec<DerivFact> v = inherited_facts_in(b, it, &c.args[0], depth + 1, bname, bscrut)?;
                        return Some(facts_extended(v, &r, None));
                    }
                },
                None       : {},
            }
        },
        // D-0290: a range of a view's bytes (`&v.bytes[i..j]`) reaches what
        // the view does, not the binding holding it. `&v[lo .. hi]` on a
        // `StringView` is `StringView::part(v, lo, hi)` (`[View-Form]`): the
        // range of what `v` reaches, as the call's result above (D-0308).
        ExprKind::ESliceOf(sb) :
        {
            ref<SliceExpr, shared> s = Box::get(sb);
            if (is_view_slice_base(b, it, &s.base))
            {
                PElem r = range_elem_in(b, &s.lo, &s.hi);
                Vec<DerivFact> v = inherited_facts_in(b, it, &s.base, depth + 1, bname, bscrut)?;
                return Some(facts_extended(v, &r, None));
            }
            match (&strip_parens_tc(&s.base).kind)
            {
                ExprKind::EField(fb) :
                {
                    ref<FieldExpr, shared> f = Box::get(fb);
                    bool view = match (shape_or_place(b, it, &f.e))
                    {
                        Some(t) : is_view_type(&t),
                        None    : false,
                    };
                    if (f.name == "bytes" && view)
                    {
                        PElem r = range_elem_in(b, &s.lo, &s.hi);
                        Vec<DerivFact> w = inherited_facts_in(b, it, &f.e, depth + 1, bname, bscrut)?;
                        return Some(facts_extended(w, &r, Some(s.mode)));
                    }
                },
                _                    : {},
            }
        },
        _                      : {},
    }
    Vec<DerivKey> ks = deriv_facts_of(b, it, e);
    if (Vec::len(&ks) > 0)
    {
        Vec<DerivFact> fs = Vec::new();
        foreach (k in ks)
        {
            Vec::push(&mut fs, DerivFact { .key = k, .v = Tri::T });
        }
        return Some(fs);
    }
    match (&e.kind)
    {
        ExprKind::EPath(pb)      :
        {
            ref<Vec<String>, shared> segs = &Box::get(pb).segs;
            if (Vec::len(segs) == 1)
            {
                usize nl = Vec::len(&b.block_local_facts);
                for (usize q = nl; q > 0; q -= 1)
                {
                    if (b.block_local_facts[q - 1].name == segs[0])
                    {
                        return clone(&b.block_local_facts[q - 1].facts);
                    }
                }
                bool is_binder = match (bname)
                {
                    Some(bn) : (*bn == segs[0]),
                    None     : false,
                };
                if (is_binder)
                {
                    return match (bscrut)
                    {
                        Some(sc) : inherited_facts_in(b, it, sc, depth + 1, None, None),
                        None     : None,
                    };
                }
            }
            // A name that is no local of this frame (`None`, a constant):
            // static data.
            if (Vec::len(segs) != 1 || !HashMap::contains(&b.gamma, &segs[0]))
            {
                return None;
            }
            ref<String, shared> r = &segs[0];
            // Through a reference binding: a reborrow of its referent `*r`
            // (D-0071), which keeps `r` itself alive; a copied view or
            // `Option` of a reference holds what it holds.
            if (!local_is_ref(b, r))
            {
                if (HashMap::contains(&b.flow.deriv, r))
                {
                    return Some(facts_of(b, r, false));
                }
                // A holder holding nothing (D-0290).
                if (is_holder(b, it, r))
                {
                    return None;
                }
            }
            Type t = Option::expect(lookup_local(b, r), "a local");
            match (&t)
            {
                Type::TRef(x) : return one_fact(fact(
                    referent_root(r),
                    Vec::new(),
                    Box::get(x).mode,
                    Tri::T,
                )),
                Type::TSlice(x) : return one_fact(fact(
                    referent_root(r),
                    Vec::new(),
                    Box::get(x).mode,
                    Tri::T,
                )),
                _ : {},
            }
            if (holds_ref(it, &t))
            {
                return one_fact(fact(referent_root(r), Vec::new(), Mode::Shared, Tri::T));
            }
            // D-0291: a parameter given by value that keeps references in
            // data holds what its caller put there.
            if (HashSet::contains(&b.params, r) && data_type(b, it, &t))
            {
                return one_fact(fact(referent_root(r), Vec::new(), Mode::Shared, Tri::T));
            }
            // An owner of this frame (`&v[0].f` reaches `v`).
            if (flow_is_tracked(&b.flow, r))
            {
                return one_fact(fact(String::clone(r), Vec::new(), Mode::Shared, Tri::T));
            }
            Some(Vec::new())
        },
        ExprKind::EField(fb)     :
        {
            ref<Expr, shared> base = &Box::get(fb).e;
            // A reference read out of a field of an aggregate that holds
            // references (`h.r` of a `struct Hold`): a stored reference,
            // which reaches what its holder holds (D-0290), else tier D.
            bool data = match (shape_or_place(b, it, base))
            {
                Some(t) : data_type(b, it, &t),
                None    : false,
            };
            if (data && sole_ref_field(b, it, base, &Box::get(fb).name))
            {
                return stored_facts(b, it, e, 0);
            }
            if (data)
            {
                return match (stored_facts(b, it, base, 0))
                {
                    Some(v) : if (Vec::len(&v) == 0) { None } else { Some(v) },
                    None    : tier_d_facts(),
                };
            }
            // Report 075: a shared view, slice or reference copied out of
            // a field reaches what that field refers to, shared, whatever
            // the mode of the path it was read through (`c.text` of a
            // `ref<Cur, exclusive> c`): a shared fact on that field alone.
            // Report 415: so is a value whose references are all shared
            // views (`Option<StringView>`, a struct of views).
            bool shared_field = match (shape_or_place(b, it, e))
            {
                Some(Type::TRef(rb))   : Box::get(&rb).mode == Mode::Shared,
                Some(Type::TSlice(sb)) : Box::get(&sb).mode == Mode::Shared,
                Some(t)                : is_view_type(&t) || (holds_ref(it, &t) && shared_views_only(it, &t, 0)),
                None                   : false,
            };
            if (shared_field)
            {
                // Report 267: read through a reference parameter `c`
                // (`c.rest`), the copy refers where the field does, to what
                // `*c` keeps (`**c`, D-0290), not to the field: `c.rest =
                // &r[1..$]` then writes no place it reaches.
                Option<String> pn = match (&strip_parens_tc(base).kind)
                {
                    ExprKind::EPath(_) : match (one_seg(strip_parens_tc(base)))
                    {
                        Some(n) : Some(String::clone(n)),
                        None    : None,
                    },
                    ExprKind::EDeref(db) : match (one_seg(strip_parens_tc(Box::get(db))))
                    {
                        Some(n) : Some(String::clone(n)),
                        None    : None,
                    },
                    _ : None,
                };
                match (pn)
                {
                    Some(n) :
                    {
                        match (deep_root(b, it, &n))
                        {
                            Some(f) :
                            {
                                if (f.v == Tri::T && f.key.mode == Mode::Shared)
                                {
                                    return one_fact(f);
                                }
                            },
                            None    : {},
                        }
                    },
                    None    : {},
                }
                Vec<DerivFact> v = inherited_facts_in(b, it, base, depth + 1, bname, bscrut)?;
                return Some(facts_extended(v, &PElem::PField(String::clone(&Box::get(fb).name)), Some(Mode::Shared)));
            }
            inherited_facts_in(b, it, base, depth + 1, bname, bscrut)
        },
        ExprKind::EDeref(x)      : inherited_facts_in(b, it, Box::get(x), depth + 1, bname, bscrut),
        // D-0291: `e?` gives `e`'s payload, which holds what `e` holds.
        ExprKind::EPropagate(x)  : inherited_facts_in(b, it, Box::get(x), depth + 1, bname, bscrut),
        ExprKind::EBorrow(bb)    : inherited_borrow(b, it, &Box::get(bb).e, Box::get(bb).mode, depth, bname, bscrut),
        ExprKind::ESliceOf(sb)   : inherited_borrow(b, it, &Box::get(sb).base, Box::get(sb).mode, depth, bname, bscrut),
        ExprKind::ECall(cb)      : inherited_call(b, it, Box::get(cb), depth, bname, bscrut),
        ExprKind::EIf(ib)        :
        {
            // A branch that does not complete (or holds nothing of this
            // frame) adds nothing; the facts are certain when one branch
            // gives them all, unknown when branches differ.
            // The `then` block is read as a block expression (CHG-0439).
            ref<IfExpr, shared> x = Box::get(ib);
            Vec<Vec<DerivFact>> parts = Vec::new();
            match (&x.then_.tail)
            {
                Some(_) : match (block_facts(b, it, &x.then_, depth, bname, bscrut))
                {
                    Some(v) :
                    {
                        if (Vec::len(&v) == 0)
                        {
                            return Some(Vec::new());
                        }
                        Vec::push(&mut parts, v);
                    },
                    None    : {},
                },
                None : {},
            }
            match (&x.else_)
            {
                Some(e2) : match (inherited_facts_in(b, it, e2, depth + 1, bname, bscrut))
                {
                    Some(v) :
                    {
                        if (Vec::len(&v) == 0)
                        {
                            return Some(Vec::new());
                        }
                        Vec::push(&mut parts, v);
                    },
                    None    : {},
                },
                None : {},
            }
            // Every branch static data (`if (b) { "x" } else { "y" }`): so
            // is the result, not an unknown source.
            if (Vec::len(&parts) == 0)
            {
                return None;
            }
            Some(flatten_parts(parts))
        },
        ExprKind::EBlock(blk)    : block_facts(b, it, blk, depth, bname, bscrut),
        ExprKind::EMatch(mb)     :
        {
            ref<MatchExpr, shared> m = Box::get(mb);
            Vec<Vec<DerivFact>> out = Vec::new();
            for (usize i = 0; i < Vec::len(&m.arms); i += 1)
            {
                ref<Arm, shared> a = &m.arms[i];
                ref<Expr, shared> body = strip_parens_tc(Box::get(&a.body));
                // An arm whose result is its binder gives what the
                // scrutinee holds.
                bool binder_result = match (&a.binder)
                {
                    Some(bn) : match (&body.kind)
                    {
                        ExprKind::EPath(_) : match (one_seg(body))
                        {
                            Some(n) : (*n == *bn),
                            None    : false,
                        },
                        ExprKind::EBlock(blk) : Vec::len(&blk.stmts) == 0 && match (&blk.tail)
                        {
                            Some(t) : match (one_seg(strip_parens_tc(Box::get(t))))
                            {
                                Some(n) : (*n == *bn),
                                None    : false,
                            },
                            None : false,
                        },
                        _ : false,
                    },
                    None : false,
                };
                Option<Vec<DerivFact>> got = if (binder_result)
                {
                    inherited_facts_in(b, it, &m.scrut, depth + 1, bname, bscrut)
                }
                else
                {
                    match (&a.binder)
                    {
                        Some(bn) : inherited_facts_in(b, it, Box::get(&a.body), depth + 1, Some(bn), Some(&m.scrut)),
                        None     : inherited_facts_in(b, it, Box::get(&a.body), depth + 1, bname, bscrut),
                    }
                };
                match (got)
                {
                    Some(v) :
                    {
                        if (Vec::len(&v) == 0)
                        {
                            return Some(Vec::new());
                        }
                        Vec::push(&mut out, v);
                    },
                    None    : {},
                }
            }
            if (Vec::len(&out) == 0)
            {
                return None;
            }
            Some(flatten_parts(out))
        },
        // A branch that does not complete gives nothing.
        ExprKind::EReturn(_)     : None,
        ExprKind::EBreak         : None,
        ExprKind::EContinue      : None,
        ExprKind::EStr(_)        : None,
        // An element read out of a container of references, or a reference
        // out of a struct's field (a value, not a binding of this frame): a
        // stored reference, which reaches what its holder holds (D-0290),
        // else tier D.
        ExprKind::EIndex(pb) : match (stored_facts(b, it, &Box::get(pb).a, 0))
        {
            Some(v) : if (Vec::len(&v) == 0) { None } else { Some(v) },
            None    : tier_d_facts(),
        },
        // A literal holds what its parts hold (D-0290).
        ExprKind::EStructLit(sl) :
        {
            Vec<ref<Expr, shared>> parts = Vec::new();
            ref<Vec<FieldInit>, shared> fs = &Box::get(sl).fields;
            for (usize i = 0; i < Vec::len(fs); i += 1)
            {
                Vec::push(&mut parts, &fs[i].value);
            }
            union_facts(b, it, &parts, depth, bname, bscrut)
        },
        ExprKind::EArrayLit(xs)  :
        {
            Vec<ref<Expr, shared>> parts = Vec::new();
            for (usize i = 0; i < Vec::len(xs); i += 1)
            {
                Vec::push(&mut parts, &xs[i]);
            }
            union_facts(b, it, &parts, depth, bname, bscrut)
        },
        // A closure literal holds what its captures reach (D-0288): a `move`
        // closure returned, passed through a call or a block's tail, carries
        // the facts of a captured reference, view or slice (bug 004). None
        // known: unknown, as before.
        ExprKind::EClosure(_)    : Some(closure_facts_of(b, it, e)),
        _                        : Some(Vec::new()),
    }
}

// Several branches' facts as one: certain when one branch gives them all,
// unknown when branches differ.
// The root of a fact for what a binding of an ended block held (CHG-0439).
const str ENDED_ROOT = "<ended>";

// What block expression `blk` gives: its tail's facts. A tail that names a
// binding of the block itself is asked once the block has been checked, when
// that binding has ended (CHG-0439): a binding of the block holds what its
// initializer does, which outlives the block, and the tail is read with each
// standing for that. A place of the block the tail (or an initializer)
// borrows has ended.
fn block_facts(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    usize depth,
    Option<ref<String, shared>> bname,
    Option<ref<Expr, shared>> bscrut,
) : Option<Vec<DerivFact>>
{
    ref<Expr, shared> t = match (&blk.tail)
    {
        Some(t) : Box::get(t),
        None    : return None,
    };
    if (!mentions_block_local(blk, t))
    {
        return inherited_facts_in(b, it, t, depth + 1, bname, bscrut);
    }
    match (push_block_locals(b, it, blk, depth, bname, bscrut))
    {
        Some(pushed) :
        {
            Option<Vec<DerivFact>> r = inherited_facts_in(b, it, t, depth + 1, bname, bscrut);
            usize keep = Vec::len(&b.block_local_facts) - pushed;
            Vec::truncate(&mut b.block_local_facts, keep);
            r
        },
        None         : one_fact(fact(ENDED_ROOT, Vec::new(), Mode::Shared, Tri::U)),
    }
}

// For a block expression's tail: push each binding of `blk` with what its
// initializer holds, in order; `None` (nothing pushed) when the tail or an
// initializer borrows a binding of the block that is not itself a reference
// (a place of the block, which has ended), or names one with no initializer,
// a destructured part, or one that may hold a reference and that the block
// writes after its initializer. The count pushed.
fn push_block_locals(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    usize depth,
    Option<ref<String, shared>> bname,
    Option<ref<Expr, shared>> bscrut,
) : Option<usize>
{
    Vec<String> values = Vec::new();
    Vec<String> unknown = Vec::new();
    Vec<usize> with_init = Vec::new();
    // The bindings whose written type may hold a reference (`auto` ones too:
    // their type is not read here).
    Vec<String> holding = Vec::new();
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        match (&blk.stmts[i])
        {
            Stmt::SLet(lb)        :
            {
                ref<LetStmt, shared> l = Box::get(lb);
                match (&l.init)
                {
                    Some(init) :
                    {
                        bool is_ref = match (&l.ty)
                        {
                            Some(t) : is_borrow_ty(t),
                            None : match (&strip_parens_tc(init).kind)
                            {
                                ExprKind::EBorrow(_)  : true,
                                ExprKind::ESliceOf(_) : true,
                                _                     : returns_ref(b, it, init),
                            },
                        };
                        if (!is_ref)
                        {
                            Vec::push(&mut values, String::clone(&l.name));
                        }
                        bool may_hold = match (&l.ty)
                        {
                            Some(t) : may_hold_ref(it, t, 0),
                            None    : true,
                        };
                        if (may_hold)
                        {
                            Vec::push(&mut holding, String::clone(&l.name));
                        }
                        Vec::push(&mut with_init, i);
                    },
                    None       : Vec::push(&mut unknown, String::clone(&l.name)),
                }
            },
            Stmt::SDestructure(d) :
            {
                for (usize k = 0; k < Vec::len(&Box::get(d).fields); k += 1)
                {
                    Vec::push(&mut unknown, String::clone(&Box::get(d).fields[k]));
                }
            },
            _                     : {},
        }
    }
    // A binding the block writes after its initializer (`t = &y`, `h.p = &y`,
    // `Vec::push(&mut v, &y)`, a closure that captures it) may hold more than
    // that initializer did: what it holds is not known here (CHG-0439: it was
    // taken for the initializer's, and a decided program read the ended
    // block's slot).
    Vec<String> written = Vec::new();
    Vec<String> no_names = Vec::new();
    bool unused = false;
    ve_block(blk, 4, &mut written, &no_names, &mut unused);
    for (usize i = 0; i < Vec::len(&written); i += 1)
    {
        if (Vec::contains(&holding, &written[i]))
        {
            Vec::push(&mut unknown, String::clone(&written[i]));
        }
    }
    ref<Expr, shared> tail = match (&blk.tail)
    {
        Some(t) : Box::get(t),
        None    : return None,
    };
    if (mentions_one_of(tail, &unknown) || borrows_one_of(tail, &values))
    {
        return None;
    }
    for (usize k = 0; k < Vec::len(&with_init); k += 1)
    {
        match (&blk.stmts[with_init[k]])
        {
            Stmt::SLet(lb) :
            {
                match (&Box::get(lb).init)
                {
                    Some(init) :
                    {
                        if (mentions_one_of(init, &unknown) || borrows_one_of(init, &values))
                        {
                            return None;
                        }
                    },
                    None       : {},
                }
            },
            _              : {},
        }
    }
    for (usize k = 0; k < Vec::len(&with_init); k += 1)
    {
        match (&blk.stmts[with_init[k]])
        {
            Stmt::SLet(lb) :
            {
                ref<LetStmt, shared> l = Box::get(lb);
                match (&l.init)
                {
                    Some(init) :
                    {
                        Option<Vec<DerivFact>> f = inherited_facts_in(b, it, init, depth + 1, bname, bscrut);
                        Vec::push(&mut b.block_local_facts, BlockLocalFacts { .name = String::clone(&l.name), .facts = f });
                    },
                    None       : {},
                }
            },
            _              : {},
        }
    }
    Some(Vec::len(&with_init))
}

// Whether `tail` names a binding a statement of block `blk` declares.
fn mentions_block_local(ref<Block, shared> blk, ref<Expr, shared> tail) : bool
{
    Vec<String> own = Vec::new();
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        match (&blk.stmts[i])
        {
            Stmt::SLet(l)         : Vec::push(&mut own, String::clone(&Box::get(l).name)),
            Stmt::SDestructure(d) :
            {
                for (usize k = 0; k < Vec::len(&Box::get(d).fields); k += 1)
                {
                    Vec::push(&mut own, String::clone(&Box::get(d).fields[k]));
                }
            },
            _                     : {},
        }
    }
    Vec::len(&own) > 0 && mentions_one_of(tail, &own)
}

fn flatten_parts(Vec<Vec<DerivFact>> parts) : Vec<DerivFact>
{
    bool single = Vec::len(&parts) == 1;
    Vec<DerivFact> out = Vec::new();
    for (usize i = 0; i < Vec::len(&parts); i += 1)
    {
        for (usize k = 0; k < Vec::len(&parts[i]); k += 1)
        {
            DerivFact f = clone(&parts[i][k]);
            if (!single)
            {
                f.v = Tri::U;
            }
            Vec::push(&mut out, f);
        }
    }
    out
}

// `inherited_facts_in` of a borrow or slice: the projection down to the
// reference it goes through: its fields, cut at the first index (an
// element is inside the container the path names so far).
fn inherited_borrow(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> inner,
    Mode m,
    usize depth,
    Option<ref<String, shared>> bname,
    Option<ref<Expr, shared>> bscrut,
) : Option<Vec<DerivFact>>
{
    ref<Expr, shared> base = strip_parens_tc(inner);
    Vec<String> fields = Vec::new();
    while (true)
    {
        match (&base.kind)
        {
            ExprKind::EField(fb) :
            {
                Vec::push(&mut fields, String::clone(&Box::get(fb).name));
                base = strip_parens_tc(&Box::get(fb).e);
            },
            ExprKind::EIndex(pb) :
            {
                Vec::clear(&mut fields);
                base = strip_parens_tc(&Box::get(pb).a);
            },
            ExprKind::EDeref(x)  : base = strip_parens_tc(Box::get(x)),
            _                    : break,
        }
    }
    Vec::reverse(&mut fields);
    // A borrow of a temporary (`&padded()[0 .. $]`): it ends with the
    // statement (D-0135).
    match (&base.kind)
    {
        ExprKind::ECall(cb) :
        {
            // A constant (`&HALF`) is static data, not a temporary.
            bool is_const = match (resolve_fn_path(it, &Box::get(cb).callee))
            {
                Some(k) : Option::expect(HashMap::get(&it.fns, &k), "a function").is_const,
                None    : false,
            };
            bool plain_value = match (value_shape(b, it, base))
            {
                Some(t) : !is_borrow_ty(&t) && !holds_ref(it, &t),
                None    : false,
            };
            // A guard `lock(&m)` gives holds no reference: what is reached
            // through it is reached while it lives, and it ends with the
            // statement, unlocking (`[Guard-Drop]`; bug 005: taken for
            // static data, `ref<T, shared> r = &*lock(&m);` outlived it).
            bool via_guard = match (one_seg(&Box::get(cb).callee))
            {
                Some(n) : *n == "lock" && !is_local(b, n),
                None    : false,
            };
            if (!is_const && (plain_value || via_guard))
            {
                return one_fact(fact("<temporary>", Vec::new(), m, Tri::T));
            }
        },
        _                   : {},
    }
    Vec<DerivFact> v = inherited_facts_in(b, it, base, depth + 1, bname, bscrut)?;
    for (usize i = 0; i < Vec::len(&v); i += 1)
    {
        v[i].key.mode = m;
        for (usize k = 0; k < Vec::len(&fields); k += 1)
        {
            Vec::push(&mut v[i].key.path, PElem::PField(String::clone(&fields[k])));
        }
    }
    Some(v)
}

// `[Guard-Drop]` (bug 005): guard `g` ends here (dropped, or at its block's
// end), unlocking its mutex; a binding that surely holds a reference reached
// through it (a fact rooted at `*g`) and is used later is refuted.
fn guard_end_kept(ref<Body, exclusive> b, ref<String, shared> g) : Result<void, String>
{
    if (!b.report || b.flow.unreachable)
    {
        return Ok(());
    }
    String rr = referent_root(g);
    Option<String> held = None;
    for (usize i = 0; i < HashMap::len(&b.flow.deriv); i += 1)
    {
        ref<String, shared> r = HashMap::key_at(&b.flow.deriv, i);
        if (*r == *g)
        {
            continue;
        }
        ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&b.flow.deriv, i);
        for (usize k = 0; k < HashMap::len(facts); k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            if (d.key.root == rr && d.v == Tri::T && rep_live_after(&b.rep, r, b.current_line, b.current_col))
            {
                held = Some(String::clone(r));
            }
        }
    }
    match (held)
    {
        Some(r) :
        {
            String msg = sprintf(
                "`%s` refers into a mutex through the guard `%s`, which ends here, unlocking it, and `%s` is used later (`[Guard-Drop]`); end `%s` first, or keep the guard",
                shown_name(&r),
                shown_name(g),
                shown_name(&r),
                shown_name(&r),
            );
            String diag = sprintf("%s%s", &named_diag("diag.destroy-while-aliased", &msg), &diag_at(b.current_line, b.current_col));
            refute(b, &diag)
        },
        None    : Ok(()),
    }
}

// Whether `e` reaches its place through a temporary guard: `&*lock(&m)`,
// `&(*lock(&m)).f`, a slice of one.
fn through_temp_guard(ref<Body, shared> b, ref<Expr, shared> e) : bool
{
    ref<Expr, shared> x = strip_parens_tc(e);
    while (true)
    {
        match (&x.kind)
        {
            ExprKind::EBorrow(bb)  : x = strip_parens_tc(&Box::get(bb).e),
            ExprKind::ESliceOf(sb) : x = strip_parens_tc(&Box::get(sb).base),
            ExprKind::EField(fb)   : x = strip_parens_tc(&Box::get(fb).e),
            ExprKind::EIndex(pb)   : x = strip_parens_tc(&Box::get(pb).a),
            ExprKind::EDeref(d)    : x = strip_parens_tc(Box::get(d)),
            ExprKind::ECall(cb) : return match (one_seg(&Box::get(cb).callee))
            {
                Some(n) : *n == "lock" && !is_local(b, n),
                None    : false,
            },
            _                      : return false,
        }
    }
    false
}

fn is_hashmap_ref(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(Type::TRef(rb)) : named_is(&Box::get(rb).inner, "std::HashMap"),
        _                    : false,
    }
}

// What the references stored in the place the first reference argument
// reaches hold (D-0290): a holder's facts, `**q` through a parameter `q`;
// `None`, tier D.
fn stored_in(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> a) : Option<Vec<DerivFact>>
{
    match (&strip_parens_tc(a).kind)
    {
        ExprKind::EBorrow(x)  : stored_facts(b, it, &Box::get(x).e, 0),
        ExprKind::ESliceOf(x) : stored_facts(b, it, &Box::get(x).base, 0),
        _                     : stored_facts(b, it, a, 0),
    }
}

fn is_plain_literal(ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EInt(_)   : true,
        ExprKind::EFloat(_) : true,
        ExprKind::EBool(_)  : true,
        ExprKind::EStr(_)   : true,
        ExprKind::EUnit     : true,
        _                   : false,
    }
}

// `inherited_facts_in` of a call.
fn inherited_call(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<CallExpr, shared> c,
    usize depth,
    Option<ref<String, shared>> bname,
    Option<ref<Expr, shared>> bscrut,
) : Option<Vec<DerivFact>>
{
    ref<Vec<Expr>, shared> args = &c.args;
    match (one_seg(&c.callee))
    {
        Some(n) :
        {
            if (StringView::starts_with(n, "$each"))
            {
                // What the loop walks: its reference arguments (a hidden
                // index is a number, not a source). Over a `HashMap`, a key
                // binder reaches the `key` of its `entries` and a value
                // binder their `value` (D-0331); the hidden entry (`$p`,
                // `$each_slot`) reaches `entries`.
                Option<Type> a0 = if (Vec::len(args) > 0) { shape_or_place(b, it, &args[0]) } else { None };
                Option<str> map_field = None;
                bool of_map = is_hashmap_ref(&a0);
                if (of_map)
                {
                    if (*n == "$each_take_key" || *n == "$each_key")
                    {
                        map_field = Some("key");
                    }
                    else if (*n == "$each_take" || *n == "$each_at" || *n == "$each_at_mut")
                    {
                        map_field = Some("value");
                    }
                }
                bool in_entries = of_map && (Option::is_some(&map_field) || *n == "$each_slot");
                Vec<DerivFact> out = Vec::new();
                for (usize i = 0; i < Vec::len(args); i += 1)
                {
                    ref<Expr, shared> a = strip_parens_tc(&args[i]);
                    bool is_value = match (&a.kind)
                    {
                        ExprKind::EPath(_) : match (one_seg(a))
                        {
                            Some(p) : match (HashMap::get(&b.gamma, p))
                            {
                                Some(t) : !is_borrow_ty(t) && !holds_ref(it, t) && !is_named_ty(t),
                                None    : false,
                            },
                            None : false,
                        },
                        ExprKind::EInt(_)    : true,
                        ExprKind::EBinary(_) : true,
                        _                    : false,
                    };
                    if (is_value)
                    {
                        continue;
                    }
                    Vec::append(
                        &mut out,
                        Option::unwrap_or(inherited_facts_in(b, it, a, depth + 1, bname, bscrut), Vec::new()),
                    );
                    // An element of a holder (D-0290): what it holds.
                    ref<Expr, shared> place = match (&a.kind)
                    {
                        ExprKind::EBorrow(x) : &Box::get(x).e,
                        _                    : a,
                    };
                    bool data = match (shape_or_place(b, it, place))
                    {
                        Some(t) : data_type(b, it, &t),
                        None    : false,
                    };
                    if (data)
                    {
                        match (stored_facts(b, it, place, 0))
                        {
                            Some(v) : Vec::append(&mut out, v),
                            None    : return tier_d_facts(),
                        }
                    }
                }
                if (in_entries)
                {
                    for (usize i = 0; i < Vec::len(&out); i += 1)
                    {
                        Vec::push(&mut out[i].key.path, PElem::PField("entries"));
                    }
                }
                match (map_field)
                {
                    Some(fl) :
                    {
                        for (usize i = 0; i < Vec::len(&out); i += 1)
                        {
                            Vec::push(&mut out[i].key.path, PElem::PField(String::copy(fl)));
                        }
                    },
                    None     : {},
                }
                return Some(out);
            }
        },
        None    : {},
    }
    // A call through a `fn` value or a closure (a local): its result may hold
    // what any reference argument reaches, or what the closure holds
    // (CHG-0439).
    match (one_seg(&c.callee))
    {
        Some(fname) :
        {
            bool fn_local = match (HashMap::get(&b.gamma, fname))
            {
                Some(Type::TFn(_))      : true,
                Some(Type::TClosure(_)) : true,
                _                       : false,
            };
            if (fn_local)
            {
                Vec<Vec<DerivFact>> parts = Vec::new();
                for (usize i = 0; i < Vec::len(args); i += 1)
                {
                    if (!arg_may_be_reference(b, it, &args[i]))
                    {
                        continue;
                    }
                    match (inherited_facts_in(b, it, &args[i], depth + 1, bname, bscrut))
                    {
                        Some(v) :
                        {
                            if (Vec::len(&v) == 0)
                            {
                                return Some(Vec::new());
                            }
                            Vec::push(&mut parts, v);
                        },
                        None    : {},
                    }
                }
                Vec<DerivFact> held = facts_of(b, fname, true);
                if (Vec::len(&held) > 0)
                {
                    Vec::push(&mut parts, held);
                }
                if (Vec::len(&parts) == 0)
                {
                    return None;
                }
                return Some(flatten_parts(parts));
            }
        },
        None        : {},
    }
    String key = match (resolve_fn_path(it, &c.callee))
    {
        Some(k) : k,
        None    :
        {
            // A variant made of its payload (`Some(v)`, `Ok(r)`) holds what
            // the payload holds; it was taken for static data, and
            // `Some(String::as_view(&s))` held nothing (D-0288).
            ref<Vec<String>, shared> segs = path_segs(&c.callee)?;
            if (Vec::len(segs) == 0)
            {
                return None;
            }
            ref<String, shared> last = &segs[Vec::len(segs) - 1];
            bool variant = HashMap::contains(&it.enum_of_variant, last);
            if (!variant && Vec::len(segs) > 1)
            {
                String en = String::join(&segs[0..Vec::len(segs) - 1], "::");
                match (HashMap::get(&it.enums, &en))
                {
                    Some(ed) :
                    {
                        for (usize i = 0; i < Vec::len(&ed.variants) && !variant; i += 1)
                        {
                            variant = (ed.variants[i].name == *last);
                        }
                    },
                    None     : {},
                }
            }
            if (!variant)
            {
                return None;
            }
            Option<Vec<DerivFact>> out = None;
            for (usize i = 0; i < Vec::len(args); i += 1)
            {
                bool plain = is_plain_literal(&args[i]) || match (value_shape(b, it, &args[i]))
                {
                    Some(t) : !may_hold_ref(it, &t, 0),
                    None    : false,
                };
                if (plain)
                {
                    continue;
                }
                match (inherited_facts_in(b, it, &args[i], depth + 1, bname, bscrut))
                {
                    Some(v) :
                    {
                        if (Vec::len(&v) == 0)
                        {
                            return Some(Vec::new());
                        }
                        match (&mut out)
                        {
                            Some(o) : Vec::append(o, v),
                            None    : out = Some(v),
                        }
                    },
                    None    : {},
                }
            }
            return out;
        },
    };
    ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &key), "a function");
    // `Option::unwrap(e)` and the like hold what `e` holds, as in
    // `contained_ref_facts`.
    if (is_unwrapping(&key) && Vec::len(args) > 0)
    {
        return inherited_facts_in(b, it, &args[0], depth + 1, bname, bscrut);
    }
    // `Option::unwrap_or(o, d)`: what `o` holds or what `d` does.
    if ((key == "std::Option::unwrap_or" || key == "std::Result::unwrap_or") && Vec::len(args) == 2)
    {
        Option<Vec<DerivFact>> out = None;
        for (usize i = 0; i < Vec::len(args); i += 1)
        {
            match (inherited_facts_in(b, it, &args[i], depth + 1, bname, bscrut))
            {
                Some(v) :
                {
                    if (Vec::len(&v) == 0)
                    {
                        return Some(Vec::new());
                    }
                    match (&mut out)
                    {
                        Some(o) : Vec::append(o, v),
                        None    : out = Some(v),
                    }
                },
                None    : {},
            }
        }
        return out;
    }
    Option<usize> first_ref = None;
    for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(args) && Option::is_none(&first_ref); i += 1)
    {
        if (is_borrow_ty(&f.params[i].ty))
        {
            first_ref = Some(i);
        }
    }
    // A generic whose declared result holds a reference only through a
    // type argument (`Vec::pop` of a `Vec<ref<T>>`) gives back a reference
    // that was stored: what its holder holds, else tier D.
    if (!is_borrow_ty(&f.ret) && !holds_ref(it, &f.ret) && !data_type(b, it, &f.ret))
    {
        // Given no reference, it can give back only what its values hold
        // (`Vec::new()`: nothing; `Vec::filled(n, v)`: what `v` holds).
        match (first_ref)
        {
            None    :
            {
                Vec<ref<Expr, shared>> vals = Vec::new();
                for (usize i = 0; i < Vec::len(args); i += 1)
                {
                    if (arg_may_be_reference(b, it, &args[i]))
                    {
                        Vec::push(&mut vals, &args[i]);
                    }
                }
                bool single = Vec::len(&vals) == 1;
                return match (union_facts(b, it, &vals, depth, bname, bscrut))
                {
                    Some(v) : if (!single) { Some(all_unsure(v)) } else { Some(v) },
                    None    : None,
                };
            },
            Some(k) :
            {
                return match (stored_in(b, it, &args[k]))
                {
                    Some(v) : if (Vec::len(&v) == 0) { None } else { Some(v) },
                    None    : tier_d_facts(),
                };
            },
        }
    }
    Vec<usize> refs = Vec::new();
    for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(args); i += 1)
    {
        if (is_borrow_ty(&f.params[i].ty) || holds_ref(it, &f.params[i].ty))
        {
            Vec::push(&mut refs, i);
        }
    }
    if (Vec::len(&refs) == 0)
    {
        return None;
    }
    // A `from` clause names the arguments the result may hold (D-0312,
    // D-0318), each of them for as long as the result is used: the others
    // are only probed (CHG-0439: the result was taken to hold the first
    // reference argument's, whatever the clause said).
    if (Vec::len(&f.source) > 0)
    {
        Vec<usize> named = source_positions(f);
        bool made_n = data_type(b, it, &f.ret);
        Vec<DerivFact> out_n = Vec::new();
        bool any_n = false;
        for (usize q = 0; q < Vec::len(&named); q += 1)
        {
            usize i = named[q];
            if (i >= Vec::len(args))
            {
                continue;
            }
            bool sh = match (&f.params[i].ty)
            {
                Type::TRef(x)   : Box::get(x).mode == Mode::Shared,
                Type::TSlice(x) : Box::get(x).mode == Mode::Shared,
                _               : false,
            };
            match (inherited_facts_in(b, it, &args[i], depth + 1, bname, bscrut))
            {
                Some(v) :
                {
                    if (Vec::len(&v) == 0)
                    {
                        return Some(Vec::new());
                    }
                    any_n = true;
                    for (usize j = 0; j < Vec::len(&v); j += 1)
                    {
                        DerivFact d = clone(&v[j]);
                        if (sh)
                        {
                            d.key.mode = Mode::Shared;
                        }
                        if (made_n)
                        {
                            d.v = Tri::U;
                        }
                        Vec::push(&mut out_n, d);
                    }
                },
                None    : {},
            }
        }
        return if (any_n) { Some(out_n) } else { None };
    }
    // D-0290: an aggregate holding references made from several reference
    // arguments (`Vec<StringView>` of two texts) may hold what any of them
    // reaches.
    if (Vec::len(&refs) > 1 && data_type(b, it, &f.ret))
    {
        Vec<DerivFact> out = Vec::new();
        bool any = false;
        for (usize i = 0; i < Vec::len(&refs); i += 1)
        {
            match (inherited_facts_in(b, it, &args[refs[i]], depth + 1, bname, bscrut))
            {
                Some(v) :
                {
                    if (Vec::len(&v) == 0)
                    {
                        return Some(Vec::new());
                    }
                    any = true;
                    Vec::append(&mut out, all_unsure(v));
                },
                None    : {},
            }
        }
        return if (any) { Some(out) } else { None };
    }
    // Through a reference to storage that itself holds references (a
    // `Vec<ref<T>>`, a struct with a reference field), the result may be
    // one of those stored references, which reaches what it reaches, not
    // that storage: tier D.
    ref<Expr, shared> r0 = &args[refs[0]];
    Option<Type> referent = match (&strip_parens_tc(r0).kind)
    {
        ExprKind::EBorrow(x) : static_place_type(b, it, &Box::get(x).e),
        // `&v[lo .. hi]` of a `StringView` is a view of what `v` reaches,
        // not a reference to the binding (D-0308).
        ExprKind::ESliceOf(x) : if (is_view_slice_base(b, it, &Box::get(x).base)) { None } else
        {
            static_place_type(b, it, &Box::get(x).base)
        },
        ExprKind::EPath(_) : match (one_seg(strip_parens_tc(r0)))
        {
            Some(n) : match (HashMap::get(&b.gamma, n))
            {
                Some(Type::TRef(x))   : Some(clone(&Box::get(x).inner)),
                Some(Type::TSlice(x)) : Some(clone(&Box::get(x).inner)),
                _                     : None,
            },
            None : None,
        },
        _ : match (value_shape(b, it, r0))
        {
            Some(Type::TRef(x))   : Some(ModedTy::take_inner(x)),
            Some(Type::TSlice(x)) : Some(ModedTy::take_inner(x)),
            _                     : None,
        },
    };
    bool reaches_stored = match (&referent)
    {
        Some(t) : stores_refs(it, t),
        None    : false,
    };
    if (reaches_stored)
    {
        // D-0290: what its holder holds; a reference into the storage
        // itself (`Vec::index_shared`) borrows it too.
        Vec<DerivFact> v = match (stored_in(b, it, r0))
        {
            Some(v) : v,
            None    : return tier_d_facts(),
        };
        if (is_borrow_ty(&f.ret))
        {
            match (inherited_facts_in(b, it, r0, depth + 1, bname, bscrut))
            {
                Some(w) :
                {
                    if (Vec::len(&w) == 0)
                    {
                        return Some(Vec::new());
                    }
                    Vec::append(&mut v, w);
                },
                None    : {},
            }
        }
        return if (Vec::len(&v) == 0) { None } else { Some(v) };
    }
    // The result borrows from the first reference argument (D-0011; D-0088
    // for a result that holds one), not from the others (a key, a needle):
    // through a shared parameter, shared. An aggregate made so
    // (`String::split`) may hold none of it (D-0290).
    bool shared_param = match (&f.params[refs[0]].ty)
    {
        Type::TRef(x)   : Box::get(x).mode == Mode::Shared,
        Type::TSlice(x) : Box::get(x).mode == Mode::Shared,
        _               : false,
    };
    bool made = data_type(b, it, &f.ret);
    Vec<DerivFact> out = Vec::new();
    match (inherited_facts_in(b, it, r0, depth + 1, bname, bscrut))
    {
        Some(v) :
        {
            if (Vec::len(&v) == 0)
            {
                return Some(Vec::new());
            }
            for (usize i = 0; i < Vec::len(&v); i += 1)
            {
                DerivFact d = clone(&v[i]);
                if (shared_param)
                {
                    d.key.mode = Mode::Shared;
                }
                if (made)
                {
                    d.v = Tri::U;
                }
                Vec::push(&mut out, d);
            }
        },
        // Static data (a literal where a view is expected): so is what the
        // result borrows.
        None    : return None,
    }
    Some(out)
}

// D-0281 §7: a type that holds a reference without being one (a view, an
// `Option`/`Result` of a reference, a closure): an aggregate kept in
// data, tier D, whose conflicts are checked when the program runs.
fn tier_d_type(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    !frame_ref_type(it, t) && holds_ref(it, t)
}

// D-0290: a type that keeps references in data, its elements' among them
// (`Vec<StringView>`), and is not held as a reference is.
fn data_type(ref<Body, exclusive> b, ref<Items, shared> it, ref<Type, shared> t) : bool
{
    type_kinds(b, it, t).data
}

// A type whose value a frame holds as a reference (D-0282, D-0287,
// D-0289): its facts are a reference binding's.
fn frame_ref_type(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(_)     : true,
        Type::TSlice(_)   : true,
        Type::TClosure(_) : true,
        Type::TFn(_)      : true,
        // D-0289: a handle or a guard held by the frame.
        Type::THandle(x)  : !holds_ref(it, Box::get(x)),
        Type::TGuard(x)   : !holds_ref(it, Box::get(x)),
        Type::TNamed(nb)  :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            // D-0287: `foreach`'s holder of a view's parts is a view of the
            // same text.
            if (n.name == "std::StringView" || n.name == "std::Parts")
            {
                return Vec::len(&n.args) == 0;
            }
            if (n.name == "std::Option" || n.name == "std::Result")
            {
                return Vec::len(&n.args) > 0 && is_ref_or_view(&n.args[0]);
            }
            false
        },
        _                 : false,
    }
}

// D-0290: what a literal's parts hold, together: `None` when every part
// is static data or a plain value, unknown when one is.
fn union_facts(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Vec<ref<Expr, shared>>, shared> parts,
    usize depth,
    Option<ref<String, shared>> bname,
    Option<ref<Expr, shared>> bscrut,
) : Option<Vec<DerivFact>>
{
    Option<Vec<DerivFact>> out = None;
    for (usize i = 0; i < Vec::len(parts); i += 1)
    {
        ref<Expr, shared> a = parts[i];
        bool plain = match (&strip_parens_tc(a).kind)
        {
            ExprKind::EInt(_)    : true,
            ExprKind::EFloat(_)  : true,
            ExprKind::EBool(_)   : true,
            ExprKind::EUnit      : true,
            ExprKind::EBinary(_) : true,
            ExprKind::EUnary(_)  : true,
            _                    : false,
        };
        if (!plain)
        {
            plain = match (shape_or_place(b, it, a))
            {
                Some(t) : !may_hold_ref(it, &t, 0),
                None    : false,
            };
        }
        if (plain)
        {
            continue;
        }
        match (inherited_facts_in(b, it, a, depth + 1, bname, bscrut))
        {
            Some(v) :
            {
                if (Vec::len(&v) == 0)
                {
                    return Some(Vec::new());
                }
                match (&mut out)
                {
                    Some(o) : Vec::append(o, v),
                    None    : out = Some(v),
                }
            },
            None    : {},
        }
    }
    out
}

// D-0290: whether a local of type `t` is a holder: it keeps references in
// data (tier D by its type) and holds no `fn` value, lock, guard or
// thread, whose reach the facts do not follow.
fn holder_type(ref<Body, exclusive> b, ref<Items, shared> it, ref<Type, shared> t) : bool
{
    type_kinds(b, it, t).holder
}

// (`holder_type`, `data_type`, `stores_refs`) of `t`, worked out once per
// type.
struct TypeKinds
{
    bool holder;
    bool data;
    bool stores;
}

fn type_kinds(ref<Body, exclusive> b, ref<Items, shared> it, ref<Type, shared> t) : TypeKinds
{
    String code = type_code(t);
    match (HashMap::get(&b.facts.type_memo, &code))
    {
        Some(k) : return clone(k),
        None    : {},
    }
    bool stores = stores_refs(it, t);
    bool data = stores && !frame_ref_type(it, t);
    TypeKinds k = TypeKinds { .holder = data && holder_free(
        it,
        t,
        &mut new_name_set(),
    ), .data = data, .stores = stores };
    HashMap::insert(&mut b.facts.type_memo, code, clone(&k));
    k
}

// D-0290: whether `n` is a holder of this frame: a local (not a parameter,
// not a capture) bound when its type made it one.
fn is_holder(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> n) : bool
{
    if (!HashSet::contains(&b.holders, n) || HashSet::contains(&b.capture_names, n))
    {
        return false;
    }
    match (lookup_local(b, n))
    {
        Some(t) : holder_type(b, it, &t),
        None    : false,
    }
}

// D-0290: what the references kept in `*q` reach, for a reference
// parameter `q` given no other referent: a root of its own, `**q`,
// disjoint from this frame's places and from what the other parameters
// reach, as `*q` is (the caller's call rule makes it so). Two of those
// references may be one: an exclusive one is unsure.
fn deep_root(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> q) : Option<DerivFact>
{
    if (!HashSet::contains(&b.params, q))
    {
        return None;
    }
    match (HashMap::get(&b.flow.deriv, q))
    {
        Some(f) :
        {
            if (HashMap::len(f) > 0)
            {
                return None;
            }
        },
        None    : {},
    }
    bool excl = match (HashMap::get(&b.gamma, q))
    {
        Some(Type::TRef(x))   :
        {
            Type inner = clone(&Box::get(x).inner);
            Box::get(x).mode == Mode::Exclusive && excl_cached(b, it, &inner)
        },
        Some(Type::TSlice(x)) :
        {
            Type inner = clone(&Box::get(x).inner);
            Box::get(x).mode == Mode::Exclusive && excl_cached(b, it, &inner)
        },
        _                     : return None,
    };
    Some(fact(
        sprintf("**%s", q),
        Vec::new(),
        if (excl) { Mode::Exclusive } else { Mode::Shared },
        if (excl) { Tri::U } else { Tri::T },
    ))
}

// D-0290: what the references stored at a root reach: a holder's facts, or
// `**q` for the referent `*q` of a reference parameter.
fn reach_of_root(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> root) : Option<Vec<DerivFact>>
{
    if (is_holder(b, it, root))
    {
        return Some(holder_facts(b, root));
    }
    String q = String::copy(StringView::strip_prefix(root, "*")?);
    DerivFact f = deep_root(b, it, &q)?;
    one_fact(f)
}

// D-0290: what the references stored in the aggregate `base` (a holder,
// its field or element, or one reached through a reference) reach.
// `None`: not known before the run (tier D).
// Whether `base.f` is, of a holder `base` of a struct type, the one field
// that may hold references, and is a reference, a slice or a view itself.
fn sole_ref_field(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> base, ref<String, shared> f) : bool
{
    String h = match (one_seg(strip_parens_tc(base)))
    {
        Some(n) : String::clone(n),
        None    : return false,
    };
    if (!is_holder(b, it, &h))
    {
        return false;
    }
    match (HashMap::get(&b.gamma, &h))
    {
        Some(Type::TNamed(nb)) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    usize count = 0;
                    bool hit = false;
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        Type ft = apply_subst(&s.fields[i].ty, &subst);
                        if (may_hold_ref(it, &ft, 0))
                        {
                            count += 1;
                            hit = s.fields[i].name == *f && is_borrow_ty(&ft);
                        }
                    }
                    count == 1 && hit
                },
                None    : false,
            }
        },
        _                      : false,
    }
}

fn stored_facts(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> base,
    usize depth,
) : Option<Vec<DerivFact>>
{
    if (depth > 8)
    {
        return None;
    }
    ref<Expr, shared> e = strip_parens_tc(base);
    match (&e.kind)
    {
        // The one field of a holder's struct that holds references, a
        // reference itself: what the holder surely holds, it holds (a store
        // to part of the holder makes its facts unsure, so a sure one came
        // in whole). CHG-0439, F09.
        ExprKind::EField(f) :
        {
            if (sole_ref_field(b, it, &Box::get(f).e, &Box::get(f).name))
            {
                return match (one_seg(strip_parens_tc(&Box::get(f).e)))
                {
                    Some(n) :
                    {
                        String name = String::clone(n);
                        Some(holder_facts(b, &name))
                    },
                    None    : None,
                };
            }
            stored_facts(b, it, &Box::get(f).e, depth + 1)
        },
        ExprKind::EIndex(p) : stored_facts(b, it, &Box::get(p).a, depth + 1),
        ExprKind::EDeref(x) : match (one_seg(strip_parens_tc(Box::get(x))))
        {
            Some(n) :
            {
                String name = String::clone(n);
                stored_through_ref(b, it, &name)
            },
            None    : None,
        },
        ExprKind::EPath(_) : match (one_seg(e))
        {
            Some(n) :
            {
                String name = String::clone(n);
                // One element or field may reach any of what the holder
                // does, or nothing: on some paths only.
                if (is_holder(b, it, &name))
                {
                    return Some(all_unsure(holder_facts(b, &name)));
                }
                stored_through_ref(b, it, &name)
            },
            None    : None,
        },
        _                   : None,
    }
}

// `stored_facts` through the reference binding `r`: what the roots it
// reaches keep.
fn stored_through_ref(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> r) : Option<Vec<DerivFact>>
{
    if (!HashMap::contains(&b.gamma, r) || !local_is_ref(b, r))
    {
        return None;
    }
    match (deep_root(b, it, r))
    {
        Some(f) : return one_fact(f),
        None    : {},
    }
    if (!HashMap::contains(&b.flow.deriv, r))
    {
        return None;
    }
    Vec<DerivFact> facts = facts_of(b, r, false);
    if (Vec::len(&facts) == 0)
    {
        return None;
    }
    Vec<DerivFact> out = Vec::new();
    for (usize i = 0; i < Vec::len(&facts); i += 1)
    {
        if (facts[i].v == Tri::F)
        {
            continue;
        }
        Vec<DerivFact> held = reach_of_root(b, it, &facts[i].key.root)?;
        bool sure = facts[i].v == Tri::T && !is_holder(b, it, &facts[i].key.root);
        for (usize k = 0; k < Vec::len(&held); k += 1)
        {
            DerivFact h = clone(&held[k]);
            if (!sure)
            {
                h.v = Tri::U;
            }
            Vec::push(&mut out, h);
        }
    }
    Some(out)
}

// The binding whose path a reference binding carries: itself, or what it
// was copied from.
fn path_id(ref<Body, shared> b, ref<String, shared> r) : String
{
    String cur = String::clone(r);
    for (usize i = 0; i < 64; i += 1)
    {
        match (HashMap::get(&b.ref_copies, &cur))
        {
            Some(n) :
            {
                if (*n == cur)
                {
                    break;
                }
                cur = String::clone(n);
            },
            None    : break,
        }
    }
    cur
}

// `set_deriv` with facts of any truth value (inherited facts).
fn set_deriv_tri(ref<Body, exclusive> b, ref<String, shared> r, Vec<DerivFact> facts)
{
    if (b.flow.unreachable)
    {
        return;
    }
    handle_lend_through(b, r);
    // D-0300: as in `set_deriv`.
    hand_over_referent_as(b, r, false);
    HashMap::remove(&mut b.flow.deriv, r);
    flow_clear_rooted(&mut b.flow, &referent_root(r));
    if (Vec::len(&facts) > 0)
    {
        HashMap<String, DerivFact> m = HashMap::new();
        for (usize i = 0; i < Vec::len(&facts); i += 1)
        {
            Tri v = facts[i].v;
            String code = deriv_code(&facts[i].key);
            ref<DerivFact, exclusive> e = HashMap::entry(&mut m, &code, clone(&facts[i]));
            if (e.v != v)
            {
                e.v = Tri::U;
            }
        }
        HashMap::insert(&mut b.flow.deriv, String::clone(r), m);
        note_roots(&mut b.flow, r);
    }
}

// D-0282: at a binding `set_deriv` gave no fact: inherit, or record the
// binding as of unknown (or static) origin.
fn tier_inherit_binder(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> bn,
    ref<Expr, shared> scrut,
    ref<Expr, shared> whole,
) : Result<void, String>
{
    Pos end = Pos { .line = whole.line, .col = whole.col };
    rep_end_e(whole, &mut end);
    Option<Pos> saved = replace(&mut b.cur_match_end, Some(end));
    Result<void, String> r = tier_inherit(b, it, bn, Some(scrut));
    b.cur_match_end = saved;
    r
}

// D-0135: `r` made from `e`, which names a binding holding a view of a
// `match` scrutinee's temporary: refused when `r` is used after that
// `match` ends (the temporary, a guard's lock with it, is gone); else `r`
// holds the view too, to the same end.
fn temp_view_copied(ref<Body, exclusive> b, ref<String, shared> r, Option<ref<Expr, shared>> e) : Result<void, String>
{
    if (HashMap::len(&b.temp_views) == 0)
    {
        return Ok(());
    }
    // A new value: what `r` held before is gone.
    _ = HashMap::remove(&mut b.temp_views, r);
    if (!b.report || b.flow.unreachable)
    {
        return Ok(());
    }
    ref<Expr, shared> x = match (e)
    {
        Some(v) : v,
        None    : return Ok(()),
    };
    HashSet<String> free = HashSet::new();
    HashSet<String> bound = HashSet::new();
    collect_free_vars_expr(x, &mut bound, &mut free);
    foreach (n in &free)
    {
        if (*n == *r)
        {
            continue;
        }
        Pos end = match (HashMap::get(&b.temp_views, n))
        {
            Some(p) : clone(p),
            None    : continue,
        };
        if (rep_live_after(&b.rep, r, end.line, end.col))
        {
            StringView rs = shown_name(r);
            String msg = sprintf(
                "`%s` holds a view of a temporary of the `match` (or `if (… = …)`) that `%s` was bound by, and is used after it ends (D-0135); bind the value first (`auto v = …;`) and match on the binding",
                rs,
                shown_name(n),
            );
            return refute(b, &sprintf("%s%s", &named_diag("diag.destroy-while-aliased", &msg), &diag_at(x.line, x.col)));
        }
        HashMap::insert(&mut b.temp_views, String::clone(r), end);
    }
    Ok(())
}

fn tier_inherit(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> r,
    Option<ref<Expr, shared>> e,
) : Result<void, String>
{
    temp_view_copied(b, r, e)?;
    // D-0290: a local of this frame that holds references in data and no
    // `fn` value, lock or thread is a holder: it holds what it was made
    // from, as a reference binding does.
    Option<Type> rt = lookup_local(b, r);
    bool holder = match (&rt)
    {
        Some(t) : holder_type(b, it, t),
        None    : false,
    } && !HashSet::contains(&b.params, r) && !HashSet::contains(&b.capture_names, r);
    if (holder)
    {
        HashSet::insert(&mut b.holders, String::clone(r));
    }
    // The facts are made on every pass over a loop's body, the report only
    // on the last: a fact made in the body reaches the loop's head and exit
    // (`check_while`'s fixed point) only so.
    if (b.flow.unreachable || HashMap::contains(&b.flow.deriv, r))
    {
        return Ok(());
    }
    bool report = b.report;
    match (e)
    {
        Some(ex) : match (one_seg(strip_parens_tc(ex)))
        {
            Some(n) :
            {
                if (*n != *r && local_is_ref(b, n) && local_is_ref(b, r))
                {
                    String id = path_id(b, n);
                    HashMap::insert(&mut b.ref_copies, String::clone(r), id);
                }
            },
            None    : {},
        },
        None : {},
    }
    usize line = b.current_line;
    String ty = match (&rt)
    {
        Some(t) : type_display(t),
        None    : String::new(),
    };
    String kind = match (e)
    {
        Some(ex) : rep_kind_of(ex),
        None     : "binder",
    };
    // A binding whose type is an aggregate holding a reference (a struct,
    // an array, an enum other than `Option`/`Result` of one) is tier D by
    // its type (D-0281 §7), whatever it was made from.
    match (&rt)
    {
        Some(t) :
        {
            if (!holder && tier_d_type(it, t))
            {
                if (report)
                {
                    b.rep.tier_d += 1;
                    Vec::push(&mut b.rep.events, sprintf("D\t%v\t%s\t%s\t%s", line, r, &ty, &kind));
                    rep_left(b, sprintf("line %v: `%s` keeps references in data (tier D)", line, r));
                }
                return Ok(());
            }
        },
        None    : {},
    }
    // `r = pass(r)`: what the old `r` reached is not a fact rooted at the
    // new `r`'s own referent (the old facts were cleared when `r` was
    // assigned, so `r` here is known only as `*r`).
    String own = referent_root(r);
    // A fact rooted at the old `r`'s referent (`r = StringView::part(r, …)`)
    // is what the old `r` held: the new value lies within it.
    Option<HashMap<String, DerivFact>> prev = match (replace(&mut b.prev_facts, None))
    {
        Some(pf) :
        {
            PrevFacts { name, facts } = pf;
            if (name == *r) { Some(facts) } else { None }
        },
        None     : None,
    };
    // An old `r` that held nothing held static data (a parameter: what its
    // caller gave, `*r` still): so does the new value (D-0290).
    bool param = HashSet::contains(&b.params, r);
    // `inherited`: `None` for no initializer, `Some(None)` for static data,
    // `Some(Some(v))` otherwise.
    bool has_init = Option::is_some(&e);
    Option<Vec<DerivFact>> inherited = match (e)
    {
        Some(ex) : match (inherited_facts(b, it, ex, 0))
        {
            Some(v) :
            {
                Vec<DerivFact> out = Vec::new();
                bool dropped = false;
                for (usize i = 0; i < Vec::len(&v); i += 1)
                {
                    ref<DerivFact, shared> f = &v[i];
                    if (f.key.root != own)
                    {
                        Vec::push(&mut out, clone(f));
                    }
                    else
                    {
                        match (&prev)
                        {
                            Some(p) :
                            {
                                for (usize k = 0; k < HashMap::len(p); k += 1)
                                {
                                    ref<DerivFact, shared> pf = HashMap::value_at(p, k);
                                    if (pf.v == Tri::F)
                                    {
                                        continue;
                                    }
                                    Vec::push(
                                        &mut out,
                                        DerivFact { .key = clone(&pf.key), .v = if (f.v == Tri::T) { pf.v } else { Tri::U } },
                                    );
                                }
                            },
                            None    :
                            {
                                if (param)
                                {
                                    Vec::push(&mut out, clone(f));
                                }
                                else
                                {
                                    dropped = true;
                                }
                            },
                        }
                    }
                }
                if (dropped && Vec::len(&out) == 0) { None } else { Some(out) }
            },
            None    : None,
        },
        None : None,
    };
    match (inherited)
    {
        None    :
        {
            if (has_init)
            {
                // Static data.
                if (report)
                {
                    Vec::push(&mut b.rep.events, sprintf("S\t%v\t%s\t%s\t%s", line, r, &ty, &kind));
                }
                return Ok(());
            }
        },
        Some(v) :
        {
            if (any_root(&v, "<tier D>"))
            {
                if (!report)
                {
                    return Ok(());
                }
                b.rep.tier_d += 1;
                Vec::push(&mut b.rep.events, sprintf("D\t%v\t%s\t%s\t%s", line, r, &ty, &kind));
                rep_left(b, sprintf("line %v: `%s` was read out of data that keeps references (tier D)", line, r));
                return Ok(());
            }
            if (any_root(&v, ENDED_ROOT))
            {
                if (report)
                {
                    rep_left(b, sprintf("line %v: `%s` may hold a reference into a block that has ended", line, r));
                }
                return Ok(());
            }
            if (any_root(&v, "<temporary>") && holder)
            {
                // A holder may hold none of the temporary (D-0290).
                if (report)
                {
                    rep_left(
                        b,
                        sprintf("line %v: `%s` may hold a view of a temporary that ends with this statement", line, r),
                    );
                }
                return Ok(());
            }
            if (any_root(&v, "<temporary>"))
            {
                // A `foreach`'s hidden holder (`$e`, `$d`) is used by the
                // loop after the statement that makes it, always; every
                // node of the expansion has the `foreach`'s position, so
                // `rep_live_after` cannot tell (session finding 009-A1).
                if (is_loop_holder(r))
                {
                    usize l = b.current_line;
                    usize c = b.current_col;
                    if (Some(x) = e)
                    {
                        l = x.line;
                        c = x.col;
                    }
                    String diag = sprintf(
                        "%s%s",
                        &named_diag(
                            "diag.destroy-while-aliased",
                            "the `foreach` loop walks views of a temporary that ends before the loop's first round (D-0135); bind the value first (`String s = …;`) and walk views of the binding",
                        ),
                        &diag_at(l, c),
                    );
                    refute(b, &diag)?;
                    return Ok(());
                }
                // A `match` binder (an `if (P = e)` one too): the temporary
                // lives through the whole `match` (D-0135), the binder only
                // in its arm; a copy of it is checked where it is made
                // (`temp_view_copied`).
                match (&b.cur_match_end)
                {
                    Some(end) :
                    {
                        HashMap::insert(&mut b.temp_views, String::clone(r), clone(end));
                        return Ok(());
                    },
                    None      : {},
                }
                if (rep_live_after(&b.rep, r, b.current_line, b.current_col))
                {
                    bool via_guard = match (e)
                    {
                        Some(ex) : through_temp_guard(b, ex),
                        None     : false,
                    };
                    String msg = if (via_guard)
                    {
                        sprintf(
                            "`%s` refers into a mutex through a guard that ends with this statement, unlocking it, and is used later (`[Guard-Drop]`); hold the guard instead (`guard<T> g = lock(&m);`) and reach the value through it, `&*g`",
                            r,
                        )
                    }
                    else
                    {
                        sprintf("`%s` holds a view of a temporary that ends with this statement, and is used later (D-0135)", r)
                    };
                    String diag = sprintf(
                        "%s%s",
                        &named_diag("diag.destroy-while-aliased", &msg),
                        &diag_at(b.current_line, b.current_col),
                    );
                    refute(b, &diag)?;
                }
                return Ok(());
            }
            if (Vec::len(&v) > 0)
            {
                if (report)
                {
                    b.rep.inherited += 1;
                }
                Vec<DerivFact> w = if (holder) { through_refs(b, v) } else { v };
                set_deriv_tri(b, r, w);
                return Ok(());
            }
        },
    }
    if (!report)
    {
        return Ok(());
    }
    b.rep.unknown_origin += 1;
    Vec::push(&mut b.rep.events, sprintf("O\t%v\t%s\t%s\t%s", line, r, &ty, &kind));
    rep_left(b, sprintf("line %v: what `%s` borrows is not known before the run", line, r));
    Ok(())
}

// `[Block-Exit]` destroys what the block declared. A binding declared
// outside it that holds a reference to one of those (a `deriv` fact rooted
// there) conflicts with that destroy: when it surely does and is used
// later, an error (D-0282); when it may, the run decides.
struct HeldAtExit
{
    String r;
    String x;
    Tri t;
}

// D-0340 §6: a `handle<Result<…>>` of the innermost scope still held as
// it ends (on some path neither joined nor moved) loses its thread's
// `Result`: `diag.result-discarded`.
fn check_unjoined_handles(ref<Body, exclusive> b) : Result<void, String>
{
    if (!b.report || b.flow.unreachable)
    {
        return Ok(());
    }
    usize ns = Vec::len(&b.scopes);
    if (ns == 0)
    {
        return Ok(());
    }
    for (usize i = 0; i < Vec::len(&b.scopes[ns - 1]); i += 1)
    {
        ref<String, shared> name = &b.scopes[ns - 1][i].name;
        bool result_handle = match (lookup_local(b, name))
        {
            Some(Type::THandle(x)) : match (Box::get(&x))
            {
                Type::TNamed(nb) : Box::get(nb).name == "std::Result",
                _                : false,
            },
            _ : false,
        };
        if (!result_handle)
        {
            continue;
        }
        bool held = match (HashMap::get(&b.flow.valid, name))
        {
            Some(t) : *t != Tri::F,
            None    : false,
        } && match (HashMap::get(&b.flow.init, name))
        {
            Some(t) : *t != Tri::F,
            None    : true,
        };
        if (held)
        {
            StringView n = shown_name(name);
            String msg = sprintf(
                "`%s` may end here without `join`, and its thread's `Result` is lost when it does; `join(%s)` and handle the `Result` (`?`, `match`), on every path",
                n,
                n,
            );
            return Err(sprintf("%s%s", &named_diag("diag.result-discarded", &msg), &diag_at(b.current_line, b.current_col)));
        }
    }
    Ok(())
}

fn check_block_exit(ref<Body, exclusive> b) : Result<void, String>
{
    if (!b.report || b.flow.unreachable)
    {
        return Ok(());
    }
    usize ns = Vec::len(&b.scopes);
    if (ns == 0)
    {
        return Ok(());
    }
    HashSet<String> dying = HashSet::new();
    Vec<String> guards = Vec::new();
    for (usize i = 0; i < Vec::len(&b.scopes[ns - 1]); i += 1)
    {
        HashSet::insert(&mut dying, String::clone(&b.scopes[ns - 1][i].name));
        match (lookup_local(b, &b.scopes[ns - 1][i].name))
        {
            Some(Type::TGuard(_)) : Vec::push(&mut guards, String::clone(&b.scopes[ns - 1][i].name)),
            _                     : {},
        }
    }
    // `[Guard-Drop]` (bug 005): a guard of the block unlocks at its end.
    foreach (g in &guards)
    {
        guard_end_kept(b, g)?;
    }
    check_unjoined_handles(b)?;
    Vec<HeldAtExit> held = Vec::new();
    for (usize i = 0; i < HashMap::len(&b.flow.deriv); i += 1)
    {
        ref<String, shared> r = HashMap::key_at(&b.flow.deriv, i);
        if (HashSet::contains(&dying, r))
        {
            continue;
        }
        ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&b.flow.deriv, i);
        for (usize k = 0; k < HashMap::len(facts); k += 1)
        {
            ref<DerivFact, shared> d = HashMap::value_at(facts, k);
            if (HashSet::contains(&dying, &d.key.root) && d.v != Tri::F)
            {
                Vec::push(&mut held, HeldAtExit { .r = String::clone(r), .x = String::clone(&d.key.root), .t = d.v });
            }
        }
    }
    // Sorted by (r, x).
    for (usize i = 1; i < Vec::len(&held); i += 1)
    {
        usize j = i;
        while (j > 0 && ((held[j].r < (held[j - 1].r)) || ((held[j].r == (held[j - 1].r)) && (held[j].x < (held[j - 1].x)))))
        {
            Vec::swap(&mut held, j - 1, j);
            j -= 1;
        }
    }
    usize line = b.current_line;
    usize col = b.current_col;
    for (usize i = 0; i < Vec::len(&held); i += 1)
    {
        StringView r = shown_name(&held[i].r);
        StringView x = shown_name(&held[i].x);
        // D-0340 §3: a holder that refers to it on some path (`?`: a loop's
        // round, a branch) and is used later is refused as a sure one is.
        if (rep_live_after(&b.rep, &held[i].r, line, col))
        {
            String msg = if (held[i].t == Tri::T)
            {
                sprintf(
                    "`%s` is destroyed at the end of its block while `%s` still refers to it, and `%s` is used later",
                    x,
                    r,
                    r,
                )
            }
            else
            {
                sprintf(
                    "`%s` is destroyed at the end of its block while `%s` may still refer to it (on some path through the block), and `%s` is used later; keep owned values in `%s` (`StringView::to_string`), or keep `%s` outside the block",
                    x,
                    r,
                    r,
                    r,
                    x,
                )
            };
            String diag = sprintf("%s%s", &named_diag("diag.destroy-while-aliased", &msg), &diag_at(line, col));
            return refute(b, &diag);
        }
        rep_left(b, sprintf("line %v: `%s` may refer to `%s` when its block ends", line, r, x));
    }
    Ok(())
}

fn check_block(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // D-0323: a nested block of a statement, on the second walk; one that
    // ended at a failed statement has no tail to check.
    Option<Type> last_stmt_ty = None;
    if (b.recover && b.recover_nested && !is_expansion(blk))
    {
        RecoveredBlock { last, ended } = check_nested_recovering(b, it, blk);
        if (ended)
        {
            return Ok(Some(Type::TNever));
        }
        last_stmt_ty = last;
    }
    else
    {
        last_stmt_ty = check_block_stmts(b, it, blk)?;
    }
    match (&blk.tail)
    {
        Some(e) : check_store_operand(b, it, Box::get(e), expected),
        // `[T-Block]` (spec/12 §5): no trailing expression is `unit`,
        // except after a last statement of type `never`.
        None    :
        {
            bool nev = match (&last_stmt_ty)
            {
                Some(Type::TNever) : true,
                _                  : false,
            };
            Ok(Some(if (nev) { Type::TNever } else { Type::TVoid }))
        },
    }
}

// Report 056: the locals condition `cond` names, now guarding (`guard_names`).
fn guard_push(ref<Body, exclusive> b, ref<Expr, shared> cond) : Vec<String>
{
    HashSet<String> free = HashSet::new();
    HashSet<String> bound = HashSet::new();
    collect_free_vars_expr(cond, &mut bound, &mut free);
    Vec<String> names = Vec::new();
    foreach (n in &free)
    {
        if (HashMap::contains(&b.flow.lits, n))
        {
            String name = String::clone(n);
            usize c = match (HashMap::get(&b.guard_names, &name))
            {
                Some(k) : *k,
                None    : 0,
            };
            HashMap::insert(&mut b.guard_names, String::clone(&name), c + 1);
            Vec::push(&mut names, name);
        }
    }
    names
}

fn guard_pop(ref<Body, exclusive> b, ref<Vec<String>, shared> names)
{
    foreach (n in names)
    {
        bool last = match (HashMap::get_mut(&mut b.guard_names, n))
        {
            Some(c) :
            {
                *c -= 1;
                *c == 0
            },
            None    : false,
        };
        if (last)
        {
            _ = HashMap::remove(&mut b.guard_names, n);
        }
    }
}

// An early end waiting: the binding and the statement that declared it.
struct Waiting
{
    String name;
    usize decl;
}

// A block's statements, each checked in turn; after each, the local
// reference bindings whose last use it was end (D-0111).
fn check_block_stmts(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
) : Result<Option<Type>, String>
{
    Vec<String> extra = replace(&mut b.plan_extra, Vec::new());
    bool nested = replace(&mut b.plan_nested, false);
    usize key = block_key(blk);
    EarlyPlan plan = match (if (key == 0) { None } else { HashMap::swap_remove(&mut b.facts.plans, key) })
    {
        Some(p) : p,
        None    : early_end_plan_with(blk, &extra),
    };
    // A plan cached under this key by another block (the key is an
    // expression's id, which a rewritten copy of a block keeps) is made again.
    if (!plan_is_of(&plan, blk))
    {
        plan = early_end_plan_with(blk, &extra);
    }
    Vec::push(&mut b.extra_stack, extra);
    Vec::push(&mut b.extra_nested, nested);
    Result<Option<Type>, String> r = check_planned_stmts(b, it, blk, &plan);
    _ = Vec::pop(&mut b.extra_stack);
    _ = Vec::pop(&mut b.extra_nested);
    if (key != 0)
    {
        HashMap::insert(&mut b.facts.plans, key, plan);
    }
    r
}

// A block's key in `Facts.plans`: the id of the expression of its first
// statement that has one, or of its tail (0: none).
// The id of the expression a statement is about, 0 for none.
fn stmt_expr_id(ref<Stmt, shared> st) : usize
{
    match (st)
    {
        Stmt::SLet(l) : match (&Box::get(l).init)
        {
            Some(e) : e.id,
            None    : 0,
        },
        Stmt::SDestructure(d) : Box::get(d).init.id,
        Stmt::SExpr(e)        : Box::get(e).id,
        Stmt::SBlockLike(e)   : Box::get(e).id,
    }
}

fn block_key(ref<Block, shared> blk) : usize
{
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        usize id = stmt_expr_id(&blk.stmts[i]);
        if (id != 0)
        {
            return id;
        }
    }
    match (&blk.tail)
    {
        Some(e) : Box::get(e).id,
        None    : 0,
    }
}

// Whether `plan` was made for `blk`: a plan is kept under its block's key, an
// expression's id, which a rewritten copy of a block keeps; the ids of all
// the statements say whether it is the same block.
fn plan_is_of(ref<EarlyPlan, shared> plan, ref<Block, shared> blk) : bool
{
    if (Vec::len(&plan.ids) != Vec::len(&blk.stmts) || Vec::len(&plan.ends) != Vec::len(&blk.stmts))
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        if (plan.ids[i] != stmt_expr_id(&blk.stmts[i]))
        {
            return false;
        }
    }
    true
}

fn check_planned_stmts(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    ref<EarlyPlan, shared> plan,
) : Result<Option<Type>, String>
{
    Option<Type> last_stmt_ty = None;
    EndQueue q = end_queue();
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        let_cond_end(b, &blk.stmts[i], plan, i);
        nest_into_branches(b, &blk.stmts[i], plan, i);
        Result<Option<Type>, String> sr = check_stmt(b, it, &blk.stmts[i]);
        b.cond_end_id = None;
        Vec::clear(&mut b.cond_end_names);
        last_stmt_ty = sr?;
        for (usize k = 0; k < Vec::len(&plan.ends[i]); k += 1)
        {
            end_queue_push(&mut q, clone(&plan.ends[i][k]));
        }
        end_waiting(b, it, blk, plan, i, &mut q);
        release_before_reassign(b, it, blk, plan, i);
    }
    end_quiet_holders(b, it, blk, plan);
    nest_into_tail(b, blk, plan);
    Ok(last_stmt_ty)
}

// Report 265: after a block's last statement, the holders it declares
// whose end frees memory alone (`Vec<StringView>`, a `Vec` of shared
// references) end, so the block's exit destroys what they refer to after
// them, in the checker and the run alike (`Facts.early_ends`).
fn end_quiet_holders(ref<Body, exclusive> b, ref<Items, shared> it, ref<Block, shared> blk, ref<EarlyPlan, shared> plan)
{
    usize n = Vec::len(&blk.stmts);
    if (n == 0 || Vec::len(&plan.at_close) == 0 || b.flow.unreachable)
    {
        return;
    }
    Vec<String> names = Vec::new();
    foreach (m in &plan.at_close)
    {
        bool quiet = match (HashMap::get(&b.gamma, m))
        {
            Some(t) : quiet_holder(it, t),
            None    : false,
        };
        if (quiet)
        {
            Vec::push(&mut names, String::clone(m));
        }
    }
    if (Vec::len(&names) > 0)
    {
        _ = end_ref_bindings_keyed(b, it, stmt_key(&blk.stmts[n - 1]), &names, 3);
    }
}

// Report 292: the bindings of the plan's statement `i`, an `if`, not named
// in its condition and named in one branch block only, end in that block
// after their last mention there too (as an arm binder does, report 052):
// `if (k == b'\n') { push(&mut e.lines, clone(buf)); e.mode = Normal; }`.
// They still end after the statement, on the other path.
struct NestEnds
{
    Vec<String> then_names;
    Vec<String> else_names;
    // Those the other branch does not name, ended at its start.
    Vec<String> then_start;
    Vec<String> else_start;
}

fn nest_into_branches(ref<Body, exclusive> b, ref<Stmt, shared> st, ref<EarlyPlan, shared> plan, usize i)
{
    if (Vec::len(&plan.ends[i]) == 0)
    {
        return;
    }
    ref<Expr, shared> e = match (st)
    {
        Stmt::SExpr(x)      : Box::get(x),
        Stmt::SBlockLike(x) : Box::get(x),
        _                   : return,
    };
    Vec<String> names = Vec::new();
    foreach (w in &plan.ends[i])
    {
        Vec::push(&mut names, String::clone(&w.name));
    }
    nest_into_if(b, e, &names);
}

// Report 292: a block's tail `if` (`{ if (k) { …; e.mode = Normal; } }`)
// takes the block's bindings it names as a statement would.
fn nest_into_tail(ref<Body, exclusive> b, ref<Block, shared> blk, ref<EarlyPlan, shared> plan)
{
    match (&blk.tail)
    {
        Some(t) :
        {
            if (Vec::len(&plan.tail_names) > 0)
            {
                nest_into_if(b, Box::get(t), &plan.tail_names);
            }
        },
        None    : {},
    }
}

fn nest_into_if(ref<Body, exclusive> b, ref<Expr, shared> e, ref<Vec<String>, shared> names)
{
    ref<IfExpr, shared> x = match (&strip_parens_tc(e).kind)
    {
        ExprKind::EIf(ib) : Box::get(ib),
        _                 : return,
    };
    HashSet<String> in_cond = HashSet::new();
    HashSet<String> bound = HashSet::new();
    collect_free_vars_expr(&x.cond, &mut bound, &mut in_cond);
    HashSet<String> in_then = HashSet::new();
    HashSet<String> bound2 = HashSet::new();
    collect_free_vars_block(&x.then_, &mut bound2, &mut in_then);
    HashSet<String> in_else = HashSet::new();
    HashSet<String> bound3 = HashSet::new();
    bool else_block = match (&x.else_)
    {
        Some(e2) :
        {
            collect_free_vars_expr(e2, &mut bound3, &mut in_else);
            match (&strip_parens_tc(e2).kind)
            {
                ExprKind::EBlock(_) : true,
                _                   : false,
            }
        },
        None     : false,
    };
    NestEnds ne = NestEnds { .then_names = Vec::new(), .else_names = Vec::new(), .then_start = Vec::new(), .else_start = Vec::new() };
    foreach (n in names)
    {
        if (HashSet::contains(&in_cond, n))
        {
            continue;
        }
        bool t = HashSet::contains(&in_then, n);
        bool f = HashSet::contains(&in_else, n);
        if (t && !f)
        {
            Vec::push(&mut ne.then_names, String::clone(n));
            if (Option::is_some(&x.else_))
            {
                Vec::push(&mut ne.else_start, String::clone(n));
            }
        }
        else if (f && !t && else_block)
        {
            Vec::push(&mut ne.else_names, String::clone(n));
            Vec::push(&mut ne.then_start, String::clone(n));
        }
    }
    if (Vec::len(&ne.then_names) > 0 || Vec::len(&ne.else_names) > 0)
    {
        HashMap::insert(&mut b.nest_branches, x.cond.id, ne);
    }
}

// Report 292: before an `if`'s branch block is checked, the bindings
// `nest_into_branches` gave it (`then` true: the then block).
fn nest_branch_extra(ref<Body, exclusive> b, ref<IfExpr, shared> x, bool then)
{
    b.plan_extra = Vec::new();
    b.plan_nested = false;
    match (HashMap::get(&b.nest_branches, x.cond.id))
    {
        Some(ne) :
        {
            Vec<String> v = if (then) { clone(&ne.then_names) } else { clone(&ne.else_names) };
            if (Vec::len(&v) > 0)
            {
                b.plan_extra = v;
                b.plan_nested = true;
            }
        },
        None     : {},
    }
}

// Report 292: at the start of an `if`'s branch, the bindings
// `nest_into_branches` ends in the other branch, which this one does not
// name (`Facts.then_ends`, `Facts.else_ends`).
fn nest_branch_start(ref<Body, exclusive> b, ref<Items, shared> it, ref<IfExpr, shared> x, bool then)
{
    Vec<String> names = match (HashMap::get(&b.nest_branches, x.cond.id))
    {
        Some(ne) : if (then) { clone(&ne.then_start) } else { clone(&ne.else_start) },
        None     : return,
    };
    if (Vec::len(&names) > 0 && !b.flow.unreachable)
    {
        _ = end_ref_bindings_keyed(b, it, x.cond.id, &names, if (then) { 2 } else { 4 });
    }
}

fn nest_branch_done(ref<Body, exclusive> b)
{
    b.plan_extra = Vec::new();
    b.plan_nested = false;
}

// Report 114: statement `i` is an `if`; the bindings the plan ends after it
// may end after its condition instead (`check_if`).
fn let_cond_end(ref<Body, exclusive> b, ref<Stmt, shared> st, ref<EarlyPlan, shared> plan, usize i)
{
    b.cond_end_id = None;
    Vec::clear(&mut b.cond_end_names);
    if (Vec::len(&plan.ends[i]) == 0)
    {
        return;
    }
    ref<Expr, shared> e = match (st)
    {
        Stmt::SExpr(x)      : Box::get(x),
        Stmt::SBlockLike(x) : Box::get(x),
        _                   : return,
    };
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EIf(ib)     :
        {
            b.cond_end_id = Some(Box::get(ib).cond.id);
            foreach (w in &plan.ends[i])
            {
                Vec::push(&mut b.cond_end_names, String::clone(&w.name));
            }
        },
        // Report 114: a `match` on an integer or `bool`, as an `if`'s
        // condition (`end_after_scrutinee`).
        ExprKind::EMatch(mb)  :
        {
            b.cond_end_id = Some(Box::get(mb).scrut.id);
            foreach (w in &plan.ends[i])
            {
                Vec::push(&mut b.cond_end_names, String::clone(&w.name));
            }
        },
        // Report 114: an assignment whose value is the last use of a
        // reference, and whose place can be found before it with no effect
        // (`v[0] = *it + 1;`): the reference ends once the value is made.
        ExprKind::EAssign(pb) :
        {
            if (value_first_assign(&Box::get(pb).a, &Box::get(pb).b))
            {
                b.cond_end_id = Some(Box::get(pb).b.id);
                foreach (w in &plan.ends[i])
                {
                    Vec::push(&mut b.cond_end_names, String::clone(&w.name));
                }
            }
        },
        _                     : {},
    }
}

// Report 114: an assignment `p = v` whose place is a local, or fields and
// elements of one at a literal or local index, and whose value does not
// name that local: making the value before the place changes nothing the
// program can see but which references are live when the place is
// written (the place's bounds are checked first, `lower_assign`).
export fn value_first_assign(ref<Expr, shared> lhs, ref<Expr, shared> rhs) : bool
{
    ref<Expr, shared> cur = strip_parens_tc(lhs);
    String root = String::new();
    bool walking = true;
    usize indices = 0;
    while (walking)
    {
        match (&cur.kind)
        {
            ExprKind::EPath(p)   :
            {
                if (Vec::len(&Box::get(p).segs) != 1)
                {
                    return false;
                }
                root = String::clone(&Box::get(p).segs[0]);
                walking = false;
            },
            ExprKind::EField(f)  : cur = strip_parens_tc(&Box::get(f).e),
            ExprKind::EIndex(ix) :
            {
                ref<Expr, shared> k = strip_parens_tc(&Box::get(ix).b);
                bool plain = match (&k.kind)
                {
                    ExprKind::EInt(_)  : true,
                    ExprKind::EPath(q) : Vec::len(&Box::get(q).segs) == 1,
                    _                  : false,
                };
                if (!plain)
                {
                    return false;
                }
                indices += 1;
                cur = strip_parens_tc(&Box::get(ix).a);
            },
            _                    : return false,
        }
    }
    // (One index at most: the bounds checked first are the outer one's.)
    if (indices > 1)
    {
        return false;
    }
    !mentions_name(rhs, &root)
}

// Report 114 (D-0111): after an assignment's value (`value_first_assign`),
// the bindings whose last use it is (named in it, not in the place) end,
// here and in the run (`Facts.cond_ends`, by the value's id).
fn end_after_value(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> lhs, ref<Expr, shared> rhs)
{
    bool mine = match (b.cond_end_id)
    {
        Some(k) : k == rhs.id,
        None    : false,
    };
    if (!mine || Vec::len(&b.cond_end_names) == 0 || b.flow.unreachable)
    {
        return;
    }
    Vec<String> names = Vec::new();
    foreach (n in &b.cond_end_names)
    {
        if (mentions_name(rhs, n) && !mentions_name(lhs, n))
        {
            Vec::push(&mut names, String::clone(n));
        }
    }
    b.cond_end_id = None;
    if (Vec::len(&names) > 0)
    {
        Vec<String> rooted = end_ref_bindings_keyed(b, it, rhs.id, &names, 1);
        foreach (n in &names)
        {
            if (!Vec::contains(&rooted, n))
            {
                HashSet::insert(&mut b.cond_ended, String::clone(n));
            }
        }
    }
}

// Report 114 (D-0111): after a `match`'s scrutinee whose value is an
// integer or `bool` (read into a temporary before any arm is tried), the
// bindings whose last use it is (named in it, in no arm's pattern or body,
// ending after this statement) end, here and in the run (`Facts.cond_ends`,
// by the scrutinee's id), as after an `if`'s condition.
fn end_after_scrutinee(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> scrut,
    ref<Vec<Arm>, shared> arms,
    ref<Option<Type>, shared> st,
)
{
    bool mine = match (b.cond_end_id)
    {
        Some(k) : k == scrut.id,
        None    : false,
    };
    if (!mine)
    {
        return;
    }
    b.cond_end_id = None;
    bool scalar = match (st)
    {
        Some(Type::TInt(_)) : true,
        Some(Type::TBool)   : true,
        _                   : false,
    };
    if (!scalar || Vec::len(&b.cond_end_names) == 0 || b.flow.unreachable)
    {
        return;
    }
    HashSet<String> in_scrut = HashSet::new();
    HashSet<String> bound = HashSet::new();
    collect_free_vars_expr(scrut, &mut bound, &mut in_scrut);
    HashSet<String> in_arms = HashSet::new();
    foreach (a in arms)
    {
        HashSet<String> bound2 = HashSet::new();
        collect_free_vars_expr(Box::get(&a.body), &mut bound2, &mut in_arms);
        match (&a.lit)
        {
            Some(l) : collect_free_vars_expr(Box::get(l), &mut bound2, &mut in_arms),
            None    : {},
        }
    }
    Vec<String> names = Vec::new();
    foreach (n in &b.cond_end_names)
    {
        if (HashSet::contains(&in_scrut, n) && !HashSet::contains(&in_arms, n))
        {
            Vec::push(&mut names, String::clone(n));
        }
    }
    if (Vec::len(&names) > 0)
    {
        Vec<String> rooted = end_ref_bindings_keyed(b, it, scrut.id, &names, 1);
        foreach (n in &names)
        {
            if (!Vec::contains(&rooted, n))
            {
                HashSet::insert(&mut b.cond_ended, String::clone(n));
            }
        }
    }
}

// Report 114 (D-0111): after an `if`'s condition, the bindings whose last
// use it is (named in it, in neither branch, ending after this statement)
// end, here and in the run (`Facts.cond_ends`). Report 268: one named only
// in the conditions of an `else if` chain ends at the start of each branch
// it is not named after (`Facts.then_ends`) and after the last condition
// that names it (`chain_ends`).
fn end_after_condition(ref<Body, exclusive> b, ref<Items, shared> it, ref<IfExpr, shared> x)
{
    bool mine = match (b.cond_end_id)
    {
        Some(k) : k == x.cond.id,
        None    : false,
    };
    Vec<String> cands = match (HashMap::swap_remove(&mut b.chain_ends, x.cond.id))
    {
        Some(v) : v,
        None    : Vec::new(),
    };
    if (mine)
    {
        foreach (n in &b.cond_end_names)
        {
            if (!Vec::contains(&cands, n))
            {
                Vec::push(&mut cands, String::clone(n));
            }
        }
    }
    if (Vec::len(&cands) == 0 || b.flow.unreachable)
    {
        return;
    }
    HashSet<String> in_cond = HashSet::new();
    HashSet<String> bound = HashSet::new();
    collect_free_vars_expr(&x.cond, &mut bound, &mut in_cond);
    HashSet<String> in_then = HashSet::new();
    HashSet<String> bound2 = HashSet::new();
    collect_free_vars_block(&x.then_, &mut bound2, &mut in_then);
    HashSet<String> in_else = HashSet::new();
    HashSet<String> bound3 = HashSet::new();
    match (&x.else_)
    {
        Some(e2) : collect_free_vars_expr(e2, &mut bound3, &mut in_else),
        None     : {},
    }
    Vec<String> names = Vec::new();
    Vec<String> chained = Vec::new();
    foreach (n in &cands)
    {
        if (HashSet::contains(&in_then, n))
        {
            continue;
        }
        if (!HashSet::contains(&in_else, n))
        {
            if (HashSet::contains(&in_cond, n))
            {
                Vec::push(&mut names, String::clone(n));
            }
            continue;
        }
        match (&x.else_)
        {
            Some(e2) : match (&strip_parens_tc(e2).kind)
            {
                ExprKind::EIf(ib) :
                {
                    if (chain_end_ok(Box::get(ib), n))
                    {
                        Vec::push(&mut chained, String::clone(n));
                    }
                },
                _                 : {},
            },
            None : {},
        }
    }
    if (mine)
    {
        b.cond_end_id = None;
    }
    if (Vec::len(&names) > 0)
    {
        Vec<String> rooted = end_ref_bindings_keyed(b, it, x.cond.id, &names, 1);
        foreach (n in &names)
        {
            if (!Vec::contains(&rooted, n))
            {
                HashSet::insert(&mut b.cond_ended, String::clone(n));
            }
        }
    }
    if (Vec::len(&chained) > 0)
    {
        match (&x.else_)
        {
            Some(e2) : match (&strip_parens_tc(e2).kind)
            {
                ExprKind::EIf(ib) :
                {
                    HashMap::insert(&mut b.chain_ends, Box::get(ib).cond.id, clone(&chained));
                    HashMap::insert(&mut b.then_start_ends, x.cond.id, chained);
                },
                _                 : {},
            },
            None : {},
        }
    }
}

// Report 268: whether `n`, named in the `else if` `x` and in no branch
// before it, is named in no branch after the last condition that names it.
fn chain_end_ok(ref<IfExpr, shared> x, ref<String, shared> n) : bool
{
    HashSet<String> in_then = HashSet::new();
    HashSet<String> bound = HashSet::new();
    collect_free_vars_block(&x.then_, &mut bound, &mut in_then);
    if (HashSet::contains(&in_then, n))
    {
        return false;
    }
    match (&x.else_)
    {
        None     : true,
        Some(e2) :
        {
            HashSet<String> in_else = HashSet::new();
            HashSet<String> bound2 = HashSet::new();
            collect_free_vars_expr(e2, &mut bound2, &mut in_else);
            if (!HashSet::contains(&in_else, n))
            {
                return true;
            }
            match (&strip_parens_tc(e2).kind)
            {
                ExprKind::EIf(ib) : chain_end_ok(Box::get(ib), n),
                _                 : false,
            }
        },
    }
}

// Report 268: at the start of an `if`'s then branch, the bindings of an
// `else if` chain that it does not name end (`end_after_condition`).
fn end_at_then_start(ref<Body, exclusive> b, ref<Items, shared> it, ref<IfExpr, shared> x)
{
    match (HashMap::swap_remove(&mut b.then_start_ends, x.cond.id))
    {
        Some(names) :
        {
            if (!b.flow.unreachable)
            {
                _ = end_ref_bindings_keyed(b, it, x.cond.id, &names, 2);
            }
        },
        None        : {},
    }
}

// Bug 021: the bindings waiting to end after their last mention (D-0111),
// in the order they began to wait (`seq`). One whose end is blocked
// (`ref_end_until`) is parked until the statement before which the binding
// that blocks it is mentioned (`parked`, by that statement), and looked at
// again only then, or when a statement declares its blocker again (whose
// new type then decides): each waiting binding is looked at a few times, not
// after every statement (the cost was the statements times the bindings
// waiting).
struct Parked
{
    Waiting w;
    usize seq;
    String blocker;
}

struct EndQueue
{
    usize seq;
    // To be looked at after the next statement.
    Vec<Parked> fresh;
    // By the statement after which to look again.
    HashMap<usize, Vec<Parked>> parked;
    // The statements before `from` have been looked after.
    usize from;
    // How many parked bindings each blocker blocks.
    HashMap<String, usize> blockers;
}

fn end_queue() : EndQueue
{
    EndQueue { .seq = 0, .fresh = Vec::new(), .parked = HashMap::new(), .from = 0, .blockers = HashMap::new() }
}

fn end_queue_push(ref<EndQueue, exclusive> q, Waiting w)
{
    Vec::push(&mut q.fresh, Parked { .w = w, .seq = q.seq, .blocker = String::new() });
    q.seq += 1;
}

fn parked_before(ref<Parked, shared> x, ref<Parked, shared> y) : bool
{
    x.seq < y.seq
}

// After statement `i`: the waiting bindings that may end end
// (`end_ref_bindings`), in the order they began to wait; one another
// binding's facts are still rooted in waits again for those to end (`f =
// move [b]() …` drops what the old `f` copied out of `r`).
fn end_waiting(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    ref<EarlyPlan, shared> plan,
    usize i,
    ref<EndQueue, exclusive> q,
)
{
    if (Vec::len(&q.fresh) == 0 && HashMap::len(&q.parked) == 0)
    {
        q.from = i + 1;
        return;
    }
    Vec<Parked> cands = replace(&mut q.fresh, Vec::new());
    // (A statement skipped by the recovering walks is looked after with
    // the next one.)
    for (usize k = q.from; k <= i && HashMap::len(&q.parked) > 0; k += 1)
    {
        match (HashMap::swap_remove(&mut q.parked, k))
        {
            Some(v) : Vec::append(&mut cands, v),
            None    : {},
        }
    }
    q.from = i + 1;
    if (HashMap::len(&q.blockers) > 0)
    {
        foreach (n in stmt_declares(&blk.stmts[i]))
        {
            if (!HashMap::contains(&q.blockers, &n))
            {
                continue;
            }
            Vec<usize> keys = Vec::new();
            for (usize k = 0; k < HashMap::len(&q.parked); k += 1)
            {
                Vec::push(&mut keys, *HashMap::key_at(&q.parked, k));
            }
            foreach (k in &keys)
            {
                Vec<Parked> v = Option::expect(HashMap::swap_remove(&mut q.parked, *k), "a parked statement");
                Vec<Parked> keep = Vec::new();
                foreach (p in v)
                {
                    if (p.blocker == n)
                    {
                        Vec::push(&mut cands, p);
                    }
                    else
                    {
                        Vec::push(&mut keep, p);
                    }
                }
                if (Vec::len(&keep) > 0)
                {
                    HashMap::insert(&mut q.parked, *k, keep);
                }
            }
        }
    }
    foreach (p in &cands)
    {
        if (StringView::len(&p.blocker) > 0)
        {
            usize left = {
                ref<usize, exclusive> c = Option::expect(HashMap::get_mut(&mut q.blockers, &p.blocker), "a blocker");
                *c -= 1;
                *c
            };
            if (left == 0)
            {
                HashMap::swap_remove(&mut q.blockers, &p.blocker);
            }
        }
    }
    if (Vec::len(&cands) == 0)
    {
        return;
    }
    Vec::sort_by(&mut cands, parked_before);
    Vec<String> now = Vec::new();
    Vec<Waiting> now_w = Vec::new();
    foreach (p in cands)
    {
        Parked { w, seq, blocker } = p;
        Option<EndBlock> eb = ref_end_until(b, it, blk, &w.name, w.decl, i, plan);
        match (eb)
        {
            Some(e) :
            {
                EndBlock { until, blocker } = e;
                *HashMap::entry(&mut q.blockers, &blocker, 0) += 1;
                Vec::push(HashMap::entry(&mut q.parked, until, Vec::new()), Parked { .w = w, .seq = seq, .blocker = blocker });
            },
            None    :
            {
                Vec::push(&mut now, String::clone(&w.name));
                Vec::push(&mut now_w, w);
            },
        }
    }
    if (Vec::len(&now) > 0)
    {
        Vec<String> rooted = end_ref_bindings(b, it, &blk.stmts[i], &now);
        foreach (w in now_w)
        {
            if (Vec::contains(&rooted, &w.name))
            {
                end_queue_push(q, w);
            }
        }
    }
}

// D-0341 (report 418): after statement `i` of `blk`, a `ref` binding that
// `i` mentions and whose next mention in `blk` is a
// whole reassignment (`stmt_overwrites`), with nothing between that may
// leave the block, holds a loan no path reads again: the loan ends here
// (`Facts.releases`; the run empties the binding's slot), and the binding
// is given a new one by the assignment. Assigning a reference is no use of
// the loan it held.
fn release_before_reassign(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    ref<EarlyPlan, shared> plan,
    usize i,
)
{
    if (!b.report || b.flow.unreachable || i >= Vec::len(&plan.mentions))
    {
        return;
    }
    Vec<String> names = Vec::new();
    for (usize k = 0; k < HashSet::len(&plan.mentions[i]); k += 1)
    {
        Vec::push(&mut names, String::clone(HashSet::key_at(&plan.mentions[i], k)));
    }
    Vec::sort(&mut names);
    Vec<String> released = Vec::new();
    foreach (x in &names)
    {
        if (!is_local(b, x) || !HashMap::contains(&b.flow.deriv, x))
        {
            continue;
        }
        bool plain_ref = match (HashMap::get(&b.gamma, x))
        {
            Some(t) : match (t)
            {
                Type::TRef(_) : ends_at_last_use(it, t),
                _             : false,
            },
            None : false,
        };
        if (!plain_ref)
        {
            continue;
        }
        // Not captured by a closure that may read it later.
        bool captured = false;
        for (usize c = 0; c < HashMap::len(&b.closure_borrows); c += 1)
        {
            if (Vec::contains(HashMap::value_at(&b.closure_borrows, c), x))
            {
                captured = true;
            }
        }
        if (captured)
        {
            continue;
        }
        // Its next mention in this block.
        Option<usize> next = None;
        match (HashMap::get(&plan.at, x))
        {
            Some(v) :
            {
                foreach (j in v)
                {
                    if (*j > i)
                    {
                        next = Some(*j);
                        break;
                    }
                }
            },
            None    : {},
        }
        usize j = match (next)
        {
            Some(j) : j,
            None    : continue,
        };
        if (!stmt_overwrites(&blk.stmts[j], x) || stmt_may_leave(&blk.stmts[j]))
        {
            continue;
        }
        if (i + 1 < Vec::len(&plan.next_leave) && plan.next_leave[i + 1] < j)
        {
            continue;
        }
        // No other binding's facts are rooted in it (a copy of it).
        String rr = referent_root(x);
        Vec<String> hs = holders_of(&b.flow, x, false);
        Vec::append(&mut hs, holders_of(&b.flow, &rr, false));
        bool rooted = false;
        foreach (h in &hs)
        {
            if (*h == *x)
            {
                continue;
            }
            match (HashMap::get(&b.flow.deriv, h))
            {
                Some(fs) :
                {
                    for (usize k = 0; k < HashMap::len(fs); k += 1)
                    {
                        ref<String, shared> root = &HashMap::value_at(fs, k).key.root;
                        if (*root == *x || *root == rr)
                        {
                            rooted = true;
                        }
                    }
                },
                None     : {},
            }
        }
        if (rooted)
        {
            continue;
        }
        HashMap::remove(&mut b.flow.deriv, x);
        Vec::push(&mut released, String::clone(x));
    }
    if (Vec::len(&released) > 0)
    {
        ref<Vec<String>, exclusive> e = HashMap::entry(&mut b.facts.releases, stmt_key(&blk.stmts[i]), Vec::new());
        foreach (x in released)
        {
            if (!Vec::contains(e, &x))
            {
                Vec::push(e, x);
            }
        }
    }
}

// What blocks a waiting binding's end (`ref_end_until`): a binding that may
// hold its path, and the statement before which that one is mentioned.
struct EndBlock
{
    usize until;
    String blocker;
}

// Whether `n` (declared by statement `d`) must outlive statement `i` although
// no later statement mentions it, and what makes it: another binding that
// statement `d` or a statement mentioning `n` mentions (or declares), that
// may hold `n`'s path and is mentioned after `i` (`mentioned_until`); of
// those, the one mentioned latest. Only statement `d` and those that mention
// `n` are looked at (bug 021: each statement from `d` to `i` was, for each
// waiting binding, after each statement). `n` stays blocked after every
// statement before `until` while the blocker's type is what it is: the
// statements looked at are those up to `n`'s last mention, all before `i`.
fn ref_end_until(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    ref<String, shared> n,
    usize d,
    usize i,
    ref<EarlyPlan, shared> plan,
) : Option<EndBlock>
{
    Option<EndBlock> best = None;
    ref_end_until_at(b, it, blk, n, d, plan, &mut best);
    match (HashMap::get(&plan.at, n))
    {
        Some(v) :
        {
            for (usize x = first_at_least(v, d + 1); x < Vec::len(v) && v[x] <= i; x += 1)
            {
                ref_end_until_at(b, it, blk, n, v[x], plan, &mut best);
            }
        },
        None    : {},
    }
    match (best)
    {
        Some(e) : if (e.until > i) { Some(e) } else { None },
        None    : None,
    }
}

// `ref_end_until` for statement `j`, keeping in `best` the blocker mentioned
// latest.
fn ref_end_until_at(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    ref<String, shared> n,
    usize j,
    ref<EarlyPlan, shared> plan,
    ref<Option<EndBlock>, exclusive> best,
)
{
    Option<ref<String, shared>> declared = match (&blk.stmts[j])
    {
        Stmt::SLet(l) : Some(&Box::get(l).name),
        _             : None,
    };
    usize count = HashSet::len(&plan.mentions[j]);
    for (usize k = 0; k <= count; k += 1)
    {
        ref<String, shared> m = if (k < count)
        {
            HashSet::key_at(&plan.mentions[j], k)
        }
        else
        {
            match (declared)
            {
                Some(dn) : dn,
                None     : break,
            }
        };
        if (*m == *n)
        {
            continue;
        }
        bool is_decl = match (declared)
        {
            Some(dn) : (*dn == *m),
            None     : false,
        };
        bool holds = match (HashMap::get(&b.gamma, m))
        {
            Some(t) : may_hold_ref(it, t, 0) && (is_decl || !inert_ref(it, t) || stmt_rebinds(&blk.stmts[j], m)),
            None    : false,
        };
        if (!holds)
        {
            continue;
        }
        usize t = mentioned_until(plan, j, m);
        bool better = match (&*best)
        {
            Some(e) : t > e.until,
            None    : true,
        };
        if (better)
        {
            *best = Some(EndBlock { .until = t, .blocker = String::clone(m) });
        }
    }
}

// Whether `m`, as statement `j` left it, is mentioned after statement `i`,
// as the first `i` for which it is not (`usize::MAX`: none, the block's tail
// mentions it): a later statement that assigns `m` whole from a value that
// does not read it ends what `m` got at `j`, when nothing may leave the block
// on the way (`plan.next_leave`; `f = move [vb]() …` after `f = move [va]()
// …`); then only the mentions before that statement count.
fn mentioned_until(ref<EarlyPlan, shared> plan, usize j, ref<String, shared> m) : usize
{
    usize leave = plan.next_leave[j];
    Option<usize> over = match (HashMap::get(&plan.overwrites_at, m))
    {
        Some(v) :
        {
            usize x = first_at_least(v, j + 1);
            if (x < Vec::len(v) && v[x] <= leave) { Some(v[x]) } else { None }
        },
        None    : None,
    };
    match (over)
    {
        Some(k) :
        {
            if (k != leave)
            {
                // A mention after `i` and before `k`.
                return match (HashMap::get(&plan.at, m))
                {
                    Some(v) :
                    {
                        usize p = first_at_least(v, k);
                        if (p == 0) { 0 } else { v[p - 1] }
                    },
                    None    : 0,
                };
            }
        },
        None    : {},
    }
    // A mention after `i`, or in the tail.
    if (HashSet::contains(&plan.tail, m))
    {
        return max_value<usize>();
    }
    match (HashMap::get(&plan.at, m))
    {
        Some(v) : if (Vec::len(v) > 0) { v[Vec::len(v) - 1] } else { 0 },
        None    : 0,
    }
}

// D-0323: whether any of `names` is poisoned.
fn mentions_poisoned(ref<Body, shared> b, ref<HashSet<String>, shared> names) : bool
{
    foreach (n in names)
    {
        if (HashSet::contains(&b.poisoned, n))
        {
            return true;
        }
    }
    false
}

// D-0323: the state before a statement, to put back if it fails. The facts,
// the report and the fresh ids go on.
fn body_snapshot(ref<Body, exclusive> b) : Body
{
    Facts lent = replace(&mut b.facts, new_facts());
    Rep r = replace(&mut b.rep, rep_new(String::new()));
    Body s = clone(&*b);
    b.facts = lent;
    b.rep = r;
    s
}

fn body_restore(ref<Body, exclusive> b, Body s)
{
    Facts lent = replace(&mut b.facts, new_facts());
    Rep r = replace(&mut b.rep, rep_new(String::new()));
    usize id = b.fresh_id;
    *b = s;
    b.facts = lent;
    b.rep = r;
    b.fresh_id = id;
}

// Bug 191: whether the statement `s` may write the local `n`: anything but
// a declaration whose initializer neither assigns `n`, nor borrows it, nor
// passes it to a call by name.
fn let_may_write(ref<Stmt, shared> s, ref<String, shared> n) : bool
{
    Vec<String> names = Vec::new();
    Vec::push(&mut names, String::clone(n));
    match (s)
    {
        Stmt::SLet(lb) : match (&Box::get(lb).init)
        {
            Some(e) : acts_on(e, &names) || borrows_one_of(e, &names),
            None    : false,
        },
        _ : true,
    }
}

// D-0323: the body's own block on the second walk of a body that failed. A
// statement that mentions a poisoned local is not checked; one that fails is
// undone (the state put back to what it was before it) and recorded, and what
// it declares and what it left unknown are settled by `after_failed`. After a
// failed `return`, `break`, `continue`, `exit` or `fault` the rest of the block
// is not checked (the result: the block ended there).
// What the recovering walk of a block gives: its last statement's type, and
// whether it ended at a failed `return` (or the like).
struct RecoveredBlock
{
    Option<Type> last;
    bool ended;
}

fn check_block_stmts_recovering(ref<Body, exclusive> b, ref<Items, shared> it, ref<Block, shared> blk) : RecoveredBlock
{
    Option<Type> last_stmt_ty = None;
    usize key = block_key(blk);
    EarlyPlan plan = match (if (key == 0) { None } else { HashMap::swap_remove(&mut b.facts.plans, key) })
    {
        Some(p) : p,
        None    : early_end_plan(blk),
    };
    // As in `check_block_stmts`: a plan of another block is made again.
    if (!plan_is_of(&plan, blk))
    {
        plan = early_end_plan(blk);
    }
    bool ended = false;
    EndQueue q = end_queue();
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        ref<Stmt, shared> s = &blk.stmts[i];
        if (mentions_poisoned(b, &plan.mentions[i]))
        {
            b.skipped = true;
            Vec<String> unknown = Vec::new();
            foreach (n in &plan.mentions[i])
            {
                if (is_local(b, n))
                {
                    Vec::push(&mut unknown, String::clone(n));
                }
            }
            after_failed(b, s, unknown);
            continue;
        }
        Body before = body_snapshot(b);
        bool block_like = match (s)
        {
            Stmt::SBlockLike(_) : true,
            _                   : false,
        };
        bool nested = replace(&mut b.recover_nested, block_like);
        Result<Option<Type>, String> checked = check_stmt(b, it, s);
        b.recover_nested = nested;
        // A statement whose own blocks recorded an error is a failed statement
        // too, its errors those (D-0323, nested blocks).
        if (Vec::len(&b.recovered) > Vec::len(&before.recovered) && Result::is_ok(&checked))
        {
            checked = Err(String::new());
        }
        match (checked)
        {
            Ok(t)  :
            {
                last_stmt_ty = t;
                foreach (n in stmt_declares(s))
                {
                    HashSet::remove(&mut b.poisoned, &n);
                }
            },
            Err(d) :
            {
                // What the statement mentions whose state it may have changed:
                // a local not valid and initialised before it (which it may
                // have given a value), one whose value the pass knew from a
                // literal (spec/14's value-range row; it may have written
                // another), or one that may hold a reference (whose borrows it
                // may have ended or moved). Anything else it did to a local (a
                // move, a borrow, a write) is undone with it.
                Vec<String> unknown = Vec::new();
                foreach (n in &plan.mentions[i])
                {
                    if (flow_is_tracked(&before.flow, n))
                    {
                        // Bug 191: a literal-known value stays known when the
                        // statement is a declaration that cannot write it.
                        bool lit_known = !HashMap::contains(&before.flow.lits, n) || !let_may_write(s, n);
                        bool known = tri_is(&before.flow.valid, n, Tri::T) && tri_is(&before.flow.init, n, Tri::T) && lit_known && match (lookup_local(&before, n))
                        {
                            Some(t) : !may_hold_ref(it, &t, 0),
                            None    : false,
                        };
                        if (!known)
                        {
                            Vec::push(&mut unknown, String::clone(n));
                        }
                    }
                }
                Vec<String> found = replace(&mut b.recovered, Vec::new());
                bool skipped = b.skipped;
                body_restore(b, before);
                b.recovered = found;
                b.skipped = b.skipped || skipped;
                if (StringView::len(&d) > 0)
                {
                    Vec::push(&mut b.recovered, d);
                }
                after_failed(b, s, unknown);
                if (stmt_ends_block(s))
                {
                    if (i + 1 < Vec::len(&blk.stmts) || Option::is_some(&blk.tail))
                    {
                        b.skipped = true;
                    }
                    ended = true;
                    break;
                }
                continue;
            },
        }
        for (usize k = 0; k < Vec::len(&plan.ends[i]); k += 1)
        {
            if (!HashSet::contains(&b.poisoned, &plan.ends[i][k].name) && is_local(b, &plan.ends[i][k].name))
            {
                end_queue_push(&mut q, clone(&plan.ends[i][k]));
            }
        }
        end_waiting(b, it, blk, &plan, i, &mut q);
        release_before_reassign(b, it, blk, &plan, i);
    }
    if (key != 0)
    {
        HashMap::insert(&mut b.facts.plans, key, plan);
    }
    RecoveredBlock { .last = if (ended) { Some(Type::TNever) } else { last_stmt_ty }, .ended = ended }
}

// D-0323 (nested blocks): a block of a statement in statement position, on the
// second walk. A failed statement is undone and recorded, and ends the block as a
// `return` would: the rest is not checked, and the point is unreachable, so
// nothing after it reaches a join (the end of the `if`, the loop's next round).
fn check_nested_recovering(ref<Body, exclusive> b, ref<Items, shared> it, ref<Block, shared> blk) : RecoveredBlock
{
    usize key = block_key(blk);
    EarlyPlan plan = match (if (key == 0) { None } else { HashMap::swap_remove(&mut b.facts.plans, key) })
    {
        Some(p) : p,
        None    : early_end_plan(blk),
    };
    // As in `check_block_stmts`: a plan of another block is made again.
    if (!plan_is_of(&plan, blk))
    {
        plan = early_end_plan(blk);
    }
    Option<Type> last_stmt_ty = None;
    bool ended = false;
    EndQueue q = end_queue();
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        ref<Stmt, shared> s = &blk.stmts[i];
        Body before = body_snapshot(b);
        bool block_like = match (s)
        {
            Stmt::SBlockLike(_) : true,
            _                   : false,
        };
        bool nested = replace(&mut b.recover_nested, block_like);
        Result<Option<Type>, String> checked = check_stmt(b, it, s);
        b.recover_nested = nested;
        match (checked)
        {
            Ok(t)  : last_stmt_ty = t,
            Err(d) :
            {
                Vec<String> found = replace(&mut b.recovered, Vec::new());
                bool skipped = b.skipped;
                body_restore(b, before);
                b.recovered = found;
                b.skipped = b.skipped || skipped;
                Vec::push(&mut b.recovered, d);
                if (i + 1 < Vec::len(&blk.stmts) || Option::is_some(&blk.tail))
                {
                    b.skipped = true;
                }
                b.flow.unreachable = true;
                ended = true;
                break;
            },
        }
        for (usize k = 0; k < Vec::len(&plan.ends[i]); k += 1)
        {
            end_queue_push(&mut q, clone(&plan.ends[i][k]));
        }
        end_waiting(b, it, blk, &plan, i, &mut q);
        release_before_reassign(b, it, blk, &plan, i);
    }
    if (key != 0)
    {
        HashMap::insert(&mut b.facts.plans, key, plan);
    }
    RecoveredBlock { .last = if (ended) { Some(Type::TNever) } else { last_stmt_ty }, .ended = ended }
}

// D-0323: a block the front end made of one statement of the program (a
// compound assignment's `{ auto $vN = &mut p; *$vN = … }`): its first statement
// declares a hidden name. It is not recovered statement by statement.
fn is_expansion(ref<Block, shared> blk) : bool
{
    if (Vec::len(&blk.stmts) == 0)
    {
        return false;
    }
    match (&blk.stmts[0])
    {
        Stmt::SLet(l) : StringView::starts_with(&Box::get(l).name, "$"),
        _             : false,
    }
}

// D-0323: after statement `s` failed (or was not checked): a local it declares
// with a written type is declared at that type, initialised; every other local
// it declares, and each of `unknown`, is poisoned.
fn after_failed(ref<Body, exclusive> b, ref<Stmt, shared> s, Vec<String> unknown)
{
    foreach (n in unknown)
    {
        HashSet::insert(&mut b.poisoned, n);
    }
    match (s)
    {
        Stmt::SLet(lb) :
        {
            ref<LetStmt, shared> l = Box::get(lb);
            match (&l.ty)
            {
                Some(t) :
                {
                    Type at = apply_subst(t, &b.subst);
                    gamma_set(b, &l.name, Some(at));
                    declare(b, &l.name, Option::is_some(&l.init));
                    HashSet::remove(&mut b.poisoned, &l.name);
                },
                None    :
                {
                    HashSet::insert(&mut b.poisoned, String::clone(&l.name));
                },
            }
        },
        _              :
        {
            foreach (n in stmt_declares(s))
            {
                HashSet::insert(&mut b.poisoned, n);
            }
        },
    }
}

// D-0323: the locals statement `s` declares in its block.
fn stmt_declares(ref<Stmt, shared> s) : Vec<String>
{
    Vec<String> out = Vec::new();
    match (s)
    {
        Stmt::SLet(l)         : Vec::push(&mut out, String::clone(&Box::get(l).name)),
        // The binders (`fields`), not the fields they bind (`names`).
        Stmt::SDestructure(d) :
        {
            foreach (n in &Box::get(d).fields)
            {
                Vec::push(&mut out, String::clone(n));
            }
        },
        _                     : {},
    }
    out
}

// D-0323: whether statement `s` leaves its block (what follows it would not be
// reached): a `return`, `break` or `continue`, or a call of `exit` or `fault`,
// as the whole statement.
fn stmt_ends_block(ref<Stmt, shared> s) : bool
{
    ref<Expr, shared> e = match (s)
    {
        Stmt::SExpr(e)      : strip_parens_tc(Box::get(e)),
        Stmt::SBlockLike(e) : strip_parens_tc(Box::get(e)),
        _                   : return false,
    };
    match (&e.kind)
    {
        ExprKind::EReturn(_) : true,
        ExprKind::EBreak     : true,
        ExprKind::EContinue  : true,
        ExprKind::ECall(cb) : match (&strip_parens_tc(&Box::get(cb).callee).kind)
        {
            ExprKind::EPath(pb) :
            {
                ref<PathExpr, shared> p = Box::get(pb);
                usize n = Vec::len(&p.segs);
                n > 0 && (p.segs[n - 1] == "exit" || p.segs[n - 1] == "fault")
            },
            _                   : false,
        },
        _                    : false,
    }
}

// The first place in `v` (ascending) whose value is at least `x`.
fn first_at_least(ref<Vec<usize>, shared> v, usize x) : usize
{
    usize lo = 0;
    usize hi = Vec::len(v);
    while (lo < hi)
    {
        usize mid = lo + (hi - lo) / 2;
        if (v[mid] < x)
        {
            lo = mid + 1;
        }
        else
        {
            hi = mid;
        }
    }
    lo
}

// D-0275: a reference, slice or `StringView` whose referent holds no
// reference and no `fn` value: it can take another binding's path only by
// being rebound (`stmt_rebinds`), never through what it reaches.
fn inert_ref(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(m)   : !may_hold_ref(it, &Box::get(m).inner, 0),
        Type::TSlice(m) : !may_hold_ref(it, &Box::get(m).inner, 0),
        Type::TNamed(n) : Box::get(n).name == "std::StringView" && Vec::len(&Box::get(n).args) == 0,
        _               : false,
    }
}

// Whether statement `s` may rebind `m`: it assigns `m` whole, borrows it
// whole exclusively, or a closure in it captures it (D-0275).
fn stmt_rebinds(ref<Stmt, shared> s, ref<String, shared> m) : bool
{
    bool found = false;
    match (s)
    {
        Stmt::SLet(l)         :
        {
            match (&Box::get(l).init)
            {
                Some(e) : rb_expr(e, m, &mut found),
                None    : {},
            }
        },
        Stmt::SDestructure(d) : rb_expr(&Box::get(d).init, m, &mut found),
        Stmt::SExpr(e)        : rb_expr(Box::get(e), m, &mut found),
        Stmt::SBlockLike(e)   : rb_expr(Box::get(e), m, &mut found),
    }
    found
}

fn rb_is(ref<Expr, shared> e, ref<String, shared> m) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EPath(p) : Vec::len(&Box::get(p).segs) == 1 && ((Box::get(p).segs[0]) == *m),
        _                  : false,
    }
}

fn rb_block(ref<Block, shared> blk, ref<String, shared> m, ref<bool, exclusive> found)
{
    foreach (st in &blk.stmts)
    {
        match (st)
        {
            Stmt::SLet(l)         :
            {
                match (&Box::get(l).init)
                {
                    Some(e) : rb_expr(e, m, found),
                    None    : {},
                }
            },
            Stmt::SDestructure(d) : rb_expr(&Box::get(d).init, m, found),
            Stmt::SExpr(e)        : rb_expr(Box::get(e), m, found),
            Stmt::SBlockLike(e)   : rb_expr(Box::get(e), m, found),
        }
    }
    match (&blk.tail)
    {
        Some(t) : rb_expr(Box::get(t), m, found),
        None    : {},
    }
}

// Every expression in `e`, closures' bodies included.
fn rb_expr(ref<Expr, shared> e, ref<String, shared> m, ref<bool, exclusive> found)
{
    match (&e.kind)
    {
        ExprKind::EUnary(u)       : rb_expr(&Box::get(u).e, m, found),
        ExprKind::EBorrow(bb)     :
        {
            if (Box::get(bb).mode == Mode::Exclusive && rb_is(&Box::get(bb).e, m))
            {
                *found = true;
            }
            rb_expr(&Box::get(bb).e, m, found);
        },
        ExprKind::EDeref(x)       : rb_expr(Box::get(x), m, found),
        ExprKind::EField(fb)      : rb_expr(&Box::get(fb).e, m, found),
        ExprKind::EPropagate(x)   : rb_expr(Box::get(x), m, found),
        ExprKind::EParen(x)       : rb_expr(Box::get(x), m, found),
        ExprKind::EBinary(bb)     :
        {
            rb_expr(&Box::get(bb).a, m, found);
            rb_expr(&Box::get(bb).b, m, found);
        },
        ExprKind::EIndex(ib)      :
        {
            rb_expr(&Box::get(ib).a, m, found);
            rb_expr(&Box::get(ib).b, m, found);
        },
        ExprKind::EAssign(pb)     :
        {
            if (rb_is(&Box::get(pb).a, m))
            {
                *found = true;
            }
            rb_expr(&Box::get(pb).a, m, found);
            rb_expr(&Box::get(pb).b, m, found);
        },
        ExprKind::ECall(cb)       :
        {
            rb_expr(&Box::get(cb).callee, m, found);
            foreach (a in &Box::get(cb).args)
            {
                rb_expr(a, m, found);
            }
        },
        ExprKind::EStructLit(sb)  :
        {
            foreach (f in &Box::get(sb).fields)
            {
                rb_expr(&f.value, m, found);
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            foreach (x in es)
            {
                rb_expr(x, m, found);
            }
        },
        ExprKind::EArrayRepeat(r) : rb_expr(&Box::get(r).value, m, found),
        ExprKind::ESliceOf(sl)    :
        {
            rb_expr(&Box::get(sl).base, m, found);
            rb_expr(&Box::get(sl).lo, m, found);
            rb_expr(&Box::get(sl).hi, m, found);
        },
        ExprKind::EBlock(blk)     : rb_block(blk, m, found),
        ExprKind::EUnsafe(blk)    : rb_block(blk, m, found),
        ExprKind::EIf(ib)         :
        {
            rb_expr(&Box::get(ib).cond, m, found);
            rb_block(&Box::get(ib).then_, m, found);
            match (&Box::get(ib).else_)
            {
                Some(el) : rb_expr(el, m, found),
                None     : {},
            }
        },
        ExprKind::EWhile(wb)      :
        {
            rb_expr(&Box::get(wb).cond, m, found);
            rb_block(&Box::get(wb).body, m, found);
            match (&Box::get(wb).step)
            {
                Some(st) : rb_expr(st, m, found),
                None     : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            rb_expr(&Box::get(mb).scrut, m, found);
            foreach (a in &Box::get(mb).arms)
            {
                rb_expr(Box::get(&a.body), m, found);
            }
        },
        ExprKind::EReturn(opt)    :
        {
            match (opt)
            {
                Some(x) : rb_expr(Box::get(x), m, found),
                None    : {},
            }
        },
        ExprKind::EClosure(cb)    :
        {
            foreach (c in &Box::get(cb).captures)
            {
                if (*c == *m)
                {
                    *found = true;
                }
            }
            rb_block(&Box::get(cb).body, m, found);
        },
        _                         : {},
    }
}

// Whether a closure's body writes `name`: a conservative syntactic scan;
// any assignment, exclusive borrow or `drop` whose place root is `name`.
fn closure_body_writes(ref<Block, shared> body, StringView name) : bool
{
    bool found = false;
    cbw_block(body, name, &mut found);
    found
}

fn cbw_root_is(ref<Expr, shared> e, StringView name) : bool
{
    match (&e.kind)
    {
        ExprKind::EPath(p)   : Vec::len(&Box::get(p).segs) == 1 && Box::get(p).segs[0] == name,
        ExprKind::EField(fb) : cbw_root_is(&Box::get(fb).e, name),
        ExprKind::EIndex(ib) : cbw_root_is(&Box::get(ib).a, name),
        ExprKind::EDeref(x)  : cbw_root_is(Box::get(x), name),
        _                    : false,
    }
}

fn cbw_block(ref<Block, shared> blk, StringView name, ref<bool, exclusive> found)
{
    for (usize i = 0; i < Vec::len(&blk.stmts); i += 1)
    {
        match (&blk.stmts[i])
        {
            Stmt::SExpr(e)      : cbw_expr(Box::get(e), name, found),
            Stmt::SBlockLike(e) : cbw_expr(Box::get(e), name, found),
            Stmt::SLet(l)       :
            {
                match (&Box::get(l).init)
                {
                    Some(e) : cbw_expr(e, name, found),
                    None    : {},
                }
            },
            _                   : {},
        }
    }
    match (&blk.tail)
    {
        Some(t) : cbw_expr(Box::get(t), name, found),
        None    : {},
    }
}

fn cbw_expr(ref<Expr, shared> e, StringView name, ref<bool, exclusive> found)
{
    match (&e.kind)
    {
        ExprKind::EAssign(pb)     :
        {
            ref<PairExpr, shared> x = Box::get(pb);
            if (cbw_root_is(&x.a, name))
            {
                *found = true;
            }
            cbw_expr(&x.a, name, found);
            cbw_expr(&x.b, name, found);
        },
        ExprKind::EBorrow(bb)     :
        {
            ref<BorrowExpr, shared> x = Box::get(bb);
            if (x.mode == Mode::Exclusive)
            {
                if (cbw_root_is(&x.e, name))
                {
                    *found = true;
                }
                cbw_expr(&x.e, name, found);
            }
        },
        ExprKind::ECall(cb)       :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            cbw_expr(&c.callee, name, found);
            for (usize i = 0; i < Vec::len(&c.args); i += 1)
            {
                cbw_expr(&c.args[i], name, found);
            }
            match (&c.callee.kind)
            {
                ExprKind::EPath(p) :
                {
                    ref<Vec<String>, shared> segs = &Box::get(p).segs;
                    usize n = Vec::len(segs);
                    if (n > 0 && segs[n - 1] == "drop" && Vec::len(&c.args) > 0 && cbw_root_is(&c.args[0], name))
                    {
                        *found = true;
                    }
                },
                _                  : {},
            }
        },
        ExprKind::EBinary(bb)     :
        {
            cbw_expr(&Box::get(bb).a, name, found);
            cbw_expr(&Box::get(bb).b, name, found);
        },
        ExprKind::EUnary(u)       : cbw_expr(&Box::get(u).e, name, found),
        ExprKind::EDeref(x)       : cbw_expr(Box::get(x), name, found),
        ExprKind::EField(fb)      : cbw_expr(&Box::get(fb).e, name, found),
        ExprKind::EIndex(ib)      :
        {
            cbw_expr(&Box::get(ib).a, name, found);
            cbw_expr(&Box::get(ib).b, name, found);
        },
        ExprKind::EParen(x)       : cbw_expr(Box::get(x), name, found),
        ExprKind::EPropagate(x)   : cbw_expr(Box::get(x), name, found),
        ExprKind::EBlock(blk)     : cbw_block(blk, name, found),
        ExprKind::EUnsafe(blk)    : cbw_block(blk, name, found),
        ExprKind::EIf(ib)         :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            cbw_expr(&x.cond, name, found);
            cbw_block(&x.then_, name, found);
            match (&x.else_)
            {
                Some(el) : cbw_expr(el, name, found),
                None     : {},
            }
        },
        ExprKind::EWhile(wb)      :
        {
            ref<WhileExpr, shared> x = Box::get(wb);
            cbw_expr(&x.cond, name, found);
            cbw_block(&x.body, name, found);
            match (&x.step)
            {
                Some(s) : cbw_expr(s, name, found),
                None    : {},
            }
        },
        ExprKind::EMatch(mb)      :
        {
            ref<MatchExpr, shared> x = Box::get(mb);
            cbw_expr(&x.scrut, name, found);
            for (usize i = 0; i < Vec::len(&x.arms); i += 1)
            {
                cbw_expr(Box::get(&x.arms[i].body), name, found);
            }
        },
        ExprKind::EReturn(opt)    :
        {
            match (opt)
            {
                Some(x) : cbw_expr(Box::get(x), name, found),
                None    : {},
            }
        },
        ExprKind::EStructLit(sb)  :
        {
            ref<StructLitExpr, shared> s = Box::get(sb);
            for (usize i = 0; i < Vec::len(&s.fields); i += 1)
            {
                cbw_expr(&s.fields[i].value, name, found);
            }
        },
        ExprKind::EArrayLit(es)   :
        {
            for (usize i = 0; i < Vec::len(es); i += 1)
            {
                cbw_expr(&es[i], name, found);
            }
        },
        ExprKind::EArrayRepeat(r) : cbw_expr(&Box::get(r).value, name, found),
        // A nested closure literal is part of this body's text.
        ExprKind::EClosure(cb)    :
        {
            ref<ClosureExpr, shared> c = Box::get(cb);
            bool captured = false;
            for (usize i = 0; i < Vec::len(&c.captures); i += 1)
            {
                if (c.captures[i] == name)
                {
                    captured = true;
                }
            }
            if (captured)
            {
                cbw_block(&c.body, name, found);
            }
        },
        _                         : {},
    }
}

// ---- part 5 ----

// A statement's key for the facts kept of it: its expression's id, or for
// `τ x;` its position.
export fn stmt_key(ref<Stmt, shared> s) : usize
{
    match (s)
    {
        Stmt::SLet(l) : match (&Box::get(l).init)
        {
            Some(e) : e.id,
            None    : max_value<usize>() - ((Box::get(l).line << 20) | Box::get(l).col),
        },
        Stmt::SDestructure(d) : Box::get(d).init.id,
        Stmt::SExpr(e)        : Box::get(e).id,
        Stmt::SBlockLike(e)   : Box::get(e).id,
    }
}

// The names another binding's facts are still rooted in, which do not end
// yet.
fn end_ref_bindings(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Stmt, shared> s,
    ref<Vec<String>, shared> names,
) : Vec<String>
{
    end_ref_bindings_keyed(b, it, stmt_key(s), names, 0)
}

// `kind` 1: recorded in `Facts.cond_ends` (by a condition's id), 2: in
// `Facts.then_ends` (by the `if`'s condition's id, report 268), 0: in
// `early_ends` (by a statement's key).
fn end_ref_bindings_keyed(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    usize key,
    ref<Vec<String>, shared> names,
    u8 kind,
) : Vec<String>
{
    bool cond = kind != 0;
    Vec<String> rooted = Vec::new();
    if (b.flow.unreachable)
    {
        return rooted;
    }
    Vec<String> ended = Vec::new();
    // Until nothing more ends: one that ends here may have held the facts
    // another was rooted in (`h = H { .m = r }`, both last mentioned in one
    // statement: `h` held `*r`, CHG-0439).
    Vec<String> pending = clone(names);
    while (true)
    {
        bool progress = false;
        Vec::clear(&mut rooted);
        Vec<String> now = replace(&mut pending, Vec::new());
        for (usize i = 0; i < Vec::len(&now); i += 1)
        {
            ref<String, shared> n = &now[i];
            // Ended after an `if`'s condition already (report 114).
            if (!cond && HashSet::remove(&mut b.cond_ended, n))
            {
                continue;
            }
            bool is_ref = match (HashMap::get(&b.gamma, n))
            {
                Some(t) : if (kind == 3) { quiet_holder(it, t) } else { ends_at_last_use(it, t) },
                None    : false,
            };
            if (!is_ref)
            {
                continue;
            }
            String rr = referent_root(n);
            bool rooted_here = false;
            // Bug 021: the holders listed for `n` or `rr` (`Flow.rooted`).
            Vec<String> hs = holders_of(&b.flow, n, false);
            Vec::append(&mut hs, holders_of(&b.flow, &rr, false));
            for (usize h = 0; h < Vec::len(&hs) && !rooted_here; h += 1)
            {
                if (hs[h] == *n)
                {
                    continue;
                }
                ref<HashMap<String, DerivFact>, shared> fs = match (HashMap::get(&b.flow.deriv, &hs[h]))
                {
                    Some(m) : m,
                    None    : continue,
                };
                for (usize k = 0; k < HashMap::len(fs); k += 1)
                {
                    ref<String, shared> root = &HashMap::value_at(fs, k).key.root;
                    if ((*root == *n) || (*root == rr))
                    {
                        rooted_here = true;
                        break;
                    }
                }
            }
            if (rooted_here)
            {
                Vec::push(&mut rooted, String::clone(n));
                continue;
            }
            HashMap::remove(&mut b.flow.deriv, n);
            Vec::push(&mut ended, String::clone(n));
            progress = true;
        }
        if (!progress || Vec::len(&rooted) == 0)
        {
            break;
        }
        pending = clone(&rooted);
    }
    // Report 052: an arm binder of this block ends through its own list.
    if (!cond && Vec::len(&ended) > 0 && Vec::len(&b.extra_stack) > 0)
    {
        usize top = Vec::len(&b.extra_stack) - 1;
        Vec<String> binders = Vec::new();
        Vec<String> rest = Vec::new();
        foreach (n in ended)
        {
            if (Vec::contains(&b.extra_stack[top], &n))
            {
                Vec::push(&mut binders, n);
            }
            else
            {
                Vec::push(&mut rest, n);
            }
        }
        ended = rest;
        if (Vec::len(&binders) > 0)
        {
            bool nested = top < Vec::len(&b.extra_nested) && b.extra_nested[top];
            ref<Vec<String>, exclusive> be = if (nested) { HashMap::entry(&mut b.facts.nested_ends, key, Vec::new()) } else
            {
                HashMap::entry(&mut b.facts.binder_ends, key, Vec::new())
            };
            foreach (n in binders)
            {
                if (!Vec::contains(be, &n))
                {
                    Vec::push(be, n);
                }
            }
        }
    }
    if (Vec::len(&ended) > 0)
    {
        ref<Vec<String>, exclusive> e = if (kind == 1) { HashMap::entry(&mut b.facts.cond_ends, key, Vec::new()) } else if (kind == 2)
        {
            HashMap::entry(&mut b.facts.then_ends, key, Vec::new())
        }
        else if (kind == 4)
        {
            HashMap::entry(&mut b.facts.else_ends, key, Vec::new())
        }
        else
        {
            HashMap::entry(&mut b.facts.early_ends, key, Vec::new())
        };
        for (usize i = 0; i < Vec::len(&ended); i += 1)
        {
            if (!Vec::contains(e, &ended[i]))
            {
                Vec::push(e, String::clone(&ended[i]));
            }
        }
    }
    rooted
}

// A nested block opens a scope: the bindings it declares end at its exit.
fn check_nested_block(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Block, shared> blk,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    usize gamma_mark = Vec::len(&b.gamma_log);
    enter_scope(b);
    Result<Option<Type>, String> r = check_block(b, it, blk, expected);
    r = match (r)
    {
        Ok(t) : match (check_block_exit(b))
        {
            Ok(_)  : Ok(t),
            Err(e) : Err(e),
        },
        Err(e) : Err(e),
    };
    exit_scope(b);
    gamma_undo(b, gamma_mark);
    r
}

// A statement: its expression's type for an expression statement, `None`
// for a declaration; an untagged fault tagged with the last line looked at.
fn check_stmt(ref<Body, exclusive> b, ref<Items, shared> it, ref<Stmt, shared> s) : Result<Option<Type>, String>
{
    match (check_stmt_inner(b, it, s))
    {
        Err(d) :
        {
            if (!StringView::contains(&d, "@"))
            {
                return Err(sprintf("%s%s", &d, &diag_at(b.current_line, b.current_col)));
            }
            Err(d)
        },
        Ok(t)  : Ok(t),
    }
}

fn path_segs(ref<Expr, shared> e) : Option<ref<Vec<String>, shared>>
{
    match (&e.kind)
    {
        ExprKind::EPath(p) : Some(&Box::get(p).segs),
        _                  : None,
    }
}

fn check_let(ref<Body, exclusive> b, ref<Items, shared> it, ref<LetStmt, shared> l) : Result<Option<Type>, String>
{
    ref<String, shared> name = &l.name;
    match (&l.init)
    {
        Some(e) :
        {
            if (is_spawn_call(e))
            {
                match (&strip_parens_tc(e).kind)
                {
                    ExprKind::ECall(cb) :
                    {
                        HashSet::insert(
                            &mut b.bound_spawns,
                            site_key(Box::get(cb).callee.line, Box::get(cb).callee.col),
                        );
                    },
                    _                   : {},
                }
            }
        },
        None    : {},
    }
    // D-0291: a spawn whose handle the value wraps, on every path or some:
    // the binding holds it, as a handle binding does.
    Vec<TailSite> tails = Vec::new();
    bool tails_all = match (&l.init)
    {
        Some(e) : if (!is_spawn_call(e)) { tail_spawn_sites(e, &mut tails) } else { false },
        None    : false,
    };
    for (usize i = 0; i < Vec::len(&tails); i += 1)
    {
        HashSet::insert(&mut b.bound_spawns, String::clone(&tails[i].key));
        HashMap::insert(&mut b.tail_spawns, String::clone(&tails[i].key), None);
    }
    // `foreach (x in &f())` (D-0042): the hidden `$c` binding would borrow
    // a temporary.
    if (StringView::starts_with(name, "$c"))
    {
        match (&l.init)
        {
            Some(e) : match (&e.kind)
            {
                ExprKind::EBorrow(bb) :
                {
                    // Report 445: `&K` of a constant is a reference to its object
                    // (`[Ref-Form-Const]`, spec/09), as `auto r = &K;` is.
                    if (is_temp_value(&Box::get(bb).e) && !const_call(it, &Box::get(bb).e))
                    {
                        // Bug 115: a call of a name that names nothing is
                        // reported as that first.
                        match (&strip_parens_tc(&Box::get(bb).e).kind)
                        {
                            ExprKind::ECall(cb) :
                            {
                                match (&Box::get(cb).callee.kind)
                                {
                                    ExprKind::EPath(pb) :
                                    {
                                        ref<Vec<String>, shared> segs = &Box::get(pb).segs;
                                        bool known = (Vec::len(segs) == 1 && is_local(b, &segs[0])) || Option::is_some(&resolve_fn_path(it, &Box::get(cb).callee)) || is_intrinsic_name_tc(&String::join(segs, "::"));
                                        if (!known)
                                        {
                                            check_path(b, it, segs)?;
                                        }
                                    },
                                    _                   : {},
                                }
                            },
                            _                   : {},
                        }
                        return Err(named_diag(
                            "diag.borrow-of-non-place",
                            "`foreach (x in &e)` borrows only a place, and this is a value: a call's result, a literal, or a constant (which stands for its value); iterate it by value, `foreach (x in e)`, or bind it first",
                        ));
                    }
                },
                _                     : {},
            },
            None : {},
        }
    }
    Option<Type> expected = match (&l.ty)
    {
        Some(t) : Some(apply_subst(t, &b.subst)),
        None    : None,
    };
    Option<HandleHolder> hand = match (&l.init)
    {
        Some(e) : handle_holder_of(b, it, e),
        None    : None,
    };
    if (Option::is_some(&hand))
    {
        match (&l.init)
        {
            Some(e) : mark_taken(b, it, e),
            None    : {},
        }
    }
    bool saved_handing = replace(&mut b.handing, Option::is_some(&hand));
    // D-0290: a holder moved into a new binding: its facts follow.
    Option<Vec<DerivFact>> held = match (&l.init)
    {
        Some(e) : match (&strip_parens_tc(e).kind)
        {
            ExprKind::EPath(_) : match (one_seg(strip_parens_tc(e)))
            {
                Some(n) : if (is_holder(b, it, n)) { Some(holder_facts(b, n)) } else { None },
                None    : None,
            },
            // D-0291: a consuming `foreach`'s drain of its hidden holder
            // (`auto $d = $each_drain($e, n)`) holds it.
            ExprKind::ECall(cb) :
            {
                ref<CallExpr, shared> c = Box::get(cb);
                bool drain = match (one_seg(&c.callee))
                {
                    Some(n) : *n == "$each_drain",
                    None    : false,
                };
                if (drain && Vec::len(&c.args) > 0)
                {
                    match (one_seg(strip_parens_tc(&c.args[0])))
                    {
                        Some(n) : if (is_holder(b, it, n)) { Some(holder_facts(b, n)) } else { None },
                        None    : None,
                    }
                }
                else
                {
                    None
                }
            },
            _                   : None,
        },
        None : None,
    };
    bool saved_holding = replace(&mut b.holding, Option::is_some(&held));
    Vec::push(&mut b.spawn_let_depth, Vec::len(&b.scopes));
    Result<Option<Type>, String> ity0 = match (&l.init)
    {
        Some(e) : check_store_operand(b, it, e, &expected),
        None    : Ok(None),
    };
    Vec::pop(&mut b.spawn_let_depth);
    b.handing = saved_handing;
    b.holding = saved_holding;
    // Bug 261: a consuming `foreach (x in v)` moves `v` into its hidden
    // `$eN`; the stale-binding message names the loop then.
    if (StringView::starts_with(name, "$e") && Result::is_ok(&ity0))
    {
        match (&l.init)
        {
            Some(e) : match (simple_name(e))
            {
                Some(src) :
                {
                    _ = HashMap::insert(&mut b.moved_at, sprintf("%s\u{1}foreach", &src), l.line);
                },
                None      : {},
            },
            None : {},
        }
    }
    Option<Type> ity = ity0?;
    // Report 302: `_ = spawn(…);` ends the handle at once, and a handle's
    // end joins its thread: the statement waits for the thread, which reads
    // as "start it and go on". Said so, with the written forms.
    if (l.name == "$discard" && !b.facts.silent && !StringView::starts_with(&b.fn_name, "std::"))
    {
        match (&ity)
        {
            Some(Type::THandle(_)) : Vec::push(
                &mut b.facts.retired_notes,
                RetiredNote {
                    .line = l.line,
                    .col = l.col,
                    .text = "warning[diag.handle-discarded]: `_ =` ends the thread's handle here, and a handle's end waits for its thread: this statement runs the thread to its end; to let it run on, keep the handle (`handle<T> h = spawn(…);`, or push it onto a `Vec` of handles) and `join` it later",
                },
            ),
            _ : {},
        }
    }
    match (&expected)
    {
        Some(exp) : match (&ity)
        {
            Some(actual) :
            {
                match (&l.init)
                {
                    Some(e) :
                    {
                        if (ty_compat(exp, actual))
                        {
                            whole_slice_lint(b, it, exp, e);
                        }
                    },
                    None    : {},
                }
                // D-0302: text viewed where a `StringView` is declared.
                bool viewed = match (&l.init)
                {
                    Some(e) : !has_unresolved_marker(exp) && !has_unresolved_marker(actual) && !ty_compat(exp, actual) && view_of_text(b, it, exp, actual, e),
                    None    : false,
                };
                if (!viewed && !has_unresolved_marker(exp) && !has_unresolved_marker(actual) && !ty_compat(exp, actual))
                {
                    ShownPair sp = shown_apart(exp, actual);
                    Option<ref<Expr, shared>> init_ref = match (&l.init)
                    {
                        Some(e) : Some(e),
                        None    : None,
                    };
                    String hint = conversion_hint(exp, actual, init_ref);
                    // Bug 191: an `if`, `match` or block whose last statement
                    // ends with `;` gives no value.
                    bool void_block = match (actual)
                    {
                        Type::TVoid : match (init_ref)
                        {
                            Some(ie) : match (&strip_parens_tc(ie).kind)
                            {
                                ExprKind::EIf(_)    : true,
                                ExprKind::EMatch(_) : true,
                                ExprKind::EBlock(_) : true,
                                _                   : false,
                            },
                            None : false,
                        },
                        _ : false,
                    };
                    if (void_block && StringView::len(&hint) == 0)
                    {
                        hint = "; a block's value is its last expression, written without `;`: `{ 1 }`, not `{ 1; }` (in each branch)";
                    }
                    // Bug 189: an `i32` that only unsuffixed literals make.
                    if (StringView::len(&hint) == 0 || StringView::contains(&hint, "narrow"))
                    {
                        match (init_ref)
                        {
                            Some(ie) :
                            {
                                if (literal_valued(ie) && is_numeric_ty(exp) && type_eq(actual, &Type::TInt(IntTy::I32)))
                                {
                                    hint = sprintf("; its literals are `i32` here: type one of them, `0: %s`, and the others take its type", &type_display(exp));
                                }
                            },
                            None     : {},
                        }
                    }
                    String msg = sprintf(
                        "`%s` is declared `%s`, but its initializer is `%s`%s",
                        name,
                        &sp.a,
                        &sp.b,
                        &hint,
                    );
                    // Bug 097: at the initializer, not at its last operand.
                    String place = match (init_ref)
                    {
                        Some(ie) : diag_at(ie.line, ie.col),
                        None     : String::new(),
                    };
                    // Bug 029: the message's own hint is the repair.
                    return Err(sprintf("%s%s", &mismatch(match (declared_repair(exp, actual, &sp))
                    {
                        Some(r) :
                        {
                            String rr = if (StringView::len(&hint) > 0) { String::new() } else { r };
                            with_repair(&msg, &rr)
                        },
                        None    : msg,
                    }), &place));
                }
            },
            None         : {},
        },
        None : {},
    }
    if (Option::is_none(&expected) && Option::is_some(&ity))
    {
        match (&l.init)
        {
            Some(e) : uninferred(b, it, e, &ity)?,
            None    : {},
        }
    }
    // `[T-Item-Value-Uninferable]` (D-0093).
    if (Option::is_none(&expected) && Option::is_none(&ity))
    {
        match (&l.init)
        {
            Some(e) :
            {
                match (&e.kind)
                {
                    ExprKind::EPath(pb) :
                    {
                        ref<PathExpr, shared> p = Box::get(pb);
                        if (Vec::len(&p.targs) == 0)
                        {
                            String n = String::join(&p.segs, "::");
                            bool generic = match (HashMap::get(&it.fns, &n))
                            {
                                Some(f) : Vec::len(&f.type_params) > 0,
                                None    : false,
                            };
                            if (generic)
                            {
                                String msg = sprintf(
                                    "nothing here fixes the type parameters of `%s` as a value: write `%s<…>`, or declare the binding's `fn(...)` type",
                                    &n,
                                    &n,
                                );
                                return Err(named_diag("diag.cannot-infer-type-parameter", &msg));
                            }
                        }
                    },
                    _                   : {},
                }
                // A variant of a generic enum whose type arguments nothing
                // fixes (`auto o = None;`).
                Option<Vec<String>> variant = match (&strip_parens_tc(e).kind)
                {
                    ExprKind::EPath(pb) : Some(clone(&Box::get(pb).segs)),
                    ExprKind::ECall(cb) : match (path_segs(&Box::get(cb).callee))
                    {
                        Some(segs) : Some(clone(segs)),
                        None       : None,
                    },
                    _                   : None,
                };
                match (variant)
                {
                    Some(segs) : match (variant_enum(it, &segs))
                    {
                        Some(en) :
                        {
                            bool generic = match (HashMap::get(&it.enums, &en))
                            {
                                Some(ed) : Vec::len(&ed.type_params) > 0,
                                None     : false,
                            };
                            if (generic)
                            {
                                String msg = sprintf(
                                    "nothing here fixes the type of `%s`: declare the binding's type (`Option<i32> x = None;`, `Result<i32, str> r = Ok(5);`)",
                                    &segs[Vec::len(&segs) - 1],
                                );
                                return Err(named_diag("diag.cannot-infer-type-parameter", &msg));
                            }
                        },
                        None     : {},
                    },
                    None : {},
                }
            },
            None    : {},
        }
    }
    Option<Type> final_ty = or_type(expected, ity);
    match (&final_ty)
    {
        Some(t) :
        {
            if (Option::is_none(&b.closure_ret))
            {
                Vec::push(&mut b.frame_types, FrameBinding { .name = String::clone(name), .ty = clone(t) });
            }
        },
        None    : {},
    }
    gamma_set(b, name, clone(&final_ty));
    // D-0340 §9: an `auto` binding's value fixed only across its parts.
    match (&l.init)
    {
        Some(ie) : match (&final_ty)
        {
            Some(ft) : note_settled(b, ie, ft),
            None     : {},
        },
        None : {},
    }
    declare(b, name, Option::is_some(&l.init));
    match (&l.init)
    {
        Some(e) : match (literal_value(e))
        {
            Some(v) :
            {
                if (!b.flow.unreachable)
                {
                    fl_lit(&mut b.flow, name, Some(v));
                }
            },
            None    :
            {
                if (!b.flow.unreachable && is_none_literal(e))
                {
                    fl_lit(&mut b.flow, name, Some(empty_mark()));
                }
            },
        },
        None : {},
    }
    HashMap::remove(&mut b.closure_moves, name);
    HashMap::swap_remove(&mut b.closure_arity, name);
    HashMap::swap_remove(&mut b.closure_borrows, name);
    HashSet::remove(&mut b.closure_self_writes, name);
    HashSet::remove(&mut b.closure_copied, name);
    HashSet::remove(&mut b.closure_owning, name);
    HashSet::remove(&mut b.closure_confined, name);
    match (&l.init)
    {
        Some(e) :
        {
            usize n = Vec::len(&b.block_stack);
            usize here = if (n > 0) { b.block_stack[n - 1] } else { 0 };
            check_escape_into(b, it, here, e)?;
            match (&e.kind)
            {
                ExprKind::EClosure(cb) :
                {
                    ref<ClosureExpr, shared> c = Box::get(cb);
                    HashMap::insert(&mut b.closure_moves, String::clone(name), c.is_move);
                    HashMap::insert(&mut b.closure_arity, String::clone(name), Vec::len(&c.params));
                    if (!c.is_move)
                    {
                        HashMap::insert(&mut b.closure_borrows, String::clone(name), Vec::clone(&c.captures));
                    }
                    bool writes = false;
                    bool owns = false;
                    for (usize k = 0; k < Vec::len(&c.captures); k += 1)
                    {
                        if (closure_body_writes(&c.body, &c.captures[k]))
                        {
                            writes = true;
                        }
                        if (place_is_resource(b, it, &c.captures[k], &Vec::new()))
                        {
                            owns = true;
                        }
                    }
                    if (c.is_move && writes)
                    {
                        HashSet::insert(&mut b.closure_self_writes, String::clone(name));
                    }
                    if (captures_confined(b, it, c))
                    {
                        HashSet::insert(&mut b.closure_confined, String::clone(name));
                    }
                    if (!c.is_move || !owns)
                    {
                        HashSet::insert(&mut b.closure_copied, String::clone(name));
                    }
                    else
                    {
                        HashSet::insert(&mut b.closure_owning, String::clone(name));
                    }
                },
                // `auto d = c;` moves the closure, and its arity with it.
                ExprKind::EPath(pb)    :
                {
                    ref<Vec<String>, shared> segs = &Box::get(pb).segs;
                    if (Vec::len(segs) == 1)
                    {
                        Option<usize> arity = match (HashMap::get(&b.closure_arity, &segs[0]))
                        {
                            Some(n) : Some(*n),
                            None    : None,
                        };
                        match (arity)
                        {
                            Some(k) :
                            {
                                HashMap::insert(&mut b.closure_arity, String::clone(name), k);
                            },
                            None    : {},
                        }
                        if (HashSet::contains(&b.closure_confined, &segs[0]))
                        {
                            HashSet::insert(&mut b.closure_confined, String::clone(name));
                        }
                        Option<Vec<String>> borrows = match (HashMap::get(&b.closure_borrows, &segs[0]))
                        {
                            Some(cs) : Some(Vec::clone(cs)),
                            None     : None,
                        };
                        match (borrows)
                        {
                            Some(cs) :
                            {
                                HashMap::insert(&mut b.closure_borrows, String::clone(name), cs);
                            },
                            None     : {},
                        }
                    }
                },
                _                      : {},
            }
        },
        None    : {},
    }
    bool borrow_typed = match (&final_ty)
    {
        Some(t) : is_borrow_ty(t),
        None    : false,
    };
    bool holds = match (&final_ty)
    {
        Some(t) : holds_ref(it, t),
        None    : false,
    };
    bool holder_ty = match (&final_ty)
    {
        Some(t) : holder_type(b, it, t),
        None    : false,
    };
    if (borrow_typed)
    {
        Vec<DerivKey> facts = Vec::new();
        match (&l.init)
        {
            Some(e) :
            {
                facts = deriv_facts_of(b, it, e);
                if (Vec::len(&facts) == 0)
                {
                    facts = contained_ref_facts(b, it, e);
                }
            },
            None    : {},
        }
        set_deriv(b, name, facts);
        Option<ref<Expr, shared>> init_ref = match (&l.init)
        {
            Some(e) : Some(e),
            None    : None,
        };
        tier_inherit(b, it, name, init_ref)?;
        Option<Referent> origin = match (&l.init)
        {
            Some(e) : referent_of(b, it, e),
            None    : None,
        };
        HashMap::insert(&mut b.ref_origin, String::clone(name), origin);
    }
    else if (Option::is_some(&held) && holder_ty)
    {
        set_deriv_tri(b, name, Option::unwrap(held));
        HashSet::insert(&mut b.holders, String::clone(name));
    }
    else
    {
        match (&l.init)
        {
            Some(e) :
            {
                if (holds || holder_ty)
                {
                    // D-0088: a value holding a reference from a call
                    // borrows from its arguments; a holder holds what its
                    // initializer holds (D-0290).
                    Vec<DerivKey> facts = if (holder_ty) { Vec::new() } else { contained_ref_facts(b, it, e) };
                    set_deriv(b, name, facts);
                    tier_inherit(b, it, name, Some(e))?;
                }
                else if (Option::is_some(&hand))
                {
                    HandleHolder { facts, .. } = Option::unwrap(hand);
                    set_deriv_tri(b, name, facts);
                }
                else if (is_spawn_call(e))
                {
                    Vec<DerivFact> facts = spawn_facts_tri_of(b, it, e);
                    set_deriv_tri(b, name, facts);
                }
                else if (Vec::len(&tails) > 0)
                {
                    Vec<DerivFact> facts = Vec::new();
                    for (usize i = 0; i < Vec::len(&tails); i += 1)
                    {
                        match (HashMap::remove(&mut b.tail_spawns, &tails[i].key))
                        {
                            Some(Some(f)) : Vec::append(&mut facts, f),
                            _ : rep_left(
                                b,
                                sprintf(
                                    "line %v: a thread is lent references and its handle is not held by this frame",
                                    tails[i].line,
                                ),
                            ),
                        }
                    }
                    // A thread on some paths only: what it was lent is held
                    // on those paths.
                    if (!(tails_all && Vec::len(&tails) == 1))
                    {
                        facts = all_unsure(facts);
                    }
                    set_deriv_tri(b, name, facts);
                }
                else if (is_closure(e))
                {
                    Vec<DerivFact> facts = closure_facts_of(b, it, e);
                    set_deriv_tri(b, name, facts);
                }
                else
                {
                    bool fnish = match (&final_ty)
                    {
                        Some(Type::TFn(_))      : true,
                        Some(Type::TClosure(_)) : true,
                        _                       : false,
                    };
                    if (fnish)
                    {
                        Vec<DerivFact> facts = fn_value_facts(b, it, e);
                        set_deriv_tri(b, name, facts);
                    }
                }
            },
            None    : {},
        }
    }
    Ok(None)
}

fn sorted_unique_count(ref<Vec<String>, shared> v) : usize
{
    Vec<String> s = Vec::clone(v);
    Vec::sort(&mut s);
    Vec::dedup(&mut s);
    Vec::len(&s)
}

fn check_destructure(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<DestructureStmt, shared> d,
) : Result<Option<Type>, String>
{
    ref<String, shared> struct_name = &d.struct_name;
    StringView shown = Option::unwrap_or(StringView::strip_prefix(struct_name, "std::"), struct_name);
    // D-0118: a bitstruct is read field by field, not taken apart.
    bool bits = match (HashMap::get(&it.structs, struct_name))
    {
        Some(s) : Option::is_some(&s.bits),
        None    : false,
    };
    if (bits)
    {
        return Err(mismatch(sprintf(
            "`%s` is a `bitstruct`, which is not taken apart; read its fields (`x.f`) instead",
            shown,
        )));
    }
    Type sty = named(struct_name, Vec::new());
    Option<Type> st = Result::unwrap_or(check_store_operand(b, it, &d.init, &Some(sty)), None);
    // CHG-0347: a name that is no struct is reported here.
    if (!HashMap::contains(&it.structs, struct_name))
    {
        if (HashMap::contains(&it.enums, struct_name))
        {
            return Err(mismatch(sprintf(
                "`%s` is an enum; destructuring (`Name { f, … } = v;`) takes a struct apart, and an enum's value is taken apart by `match`",
                shown,
            )));
        }
        String msg = sprintf(
            "no struct named `%s` is declared here; destructuring (`Name { f, … } = v;`) names the struct it takes apart",
            shown,
        );
        return Err(named_diag("diag.unbound-name", &msg));
    }
    // `[T-Let-Destructure]`: the value is a `struct_name`.
    String shown_s = shown_type_name(shown);
    bool pattern = match (&d.init.kind)
    {
        ExprKind::EPath(pb) : Vec::len(&Box::get(pb).segs) == 1 && StringView::starts_with(
            &Box::get(pb).segs[0],
            "__pattern",
        ),
        _ : false,
    };
    // D-0324 `[Struct-Pattern-By-Ref]`: a pattern reached through a reference
    // binds references to the fields.
    Option<Mode> by_ref = None;
    match (&st)
    {
        Some(t) :
        {
            Option<Mode> ref_to = match (t)
            {
                Type::TRef(rb) : if (named_is(&Box::get(rb).inner, struct_name)) { Some(Box::get(rb).mode) } else { None },
                _              : None,
            };
            // A reference to the struct is one whatever its type arguments
            // are: in a generic body they are the parameters' markers.
            if ((Option::is_some(&ref_to) || !has_unresolved_marker(t)) && !named_is(t, struct_name))
            {
                match (ref_to)
                {
                    Some(m) :
                    {
                        if (pattern)
                        {
                            if (b.facts.silent)
                            {
                                return Err(mismatch(sprintf(
                                    "a struct pattern through a reference, in a body checked after the program was built (D-0324): bind the `%s` whole (`Some(q)`) and read its fields through it (`q.f`)",
                                    &shown_s,
                                )));
                            }
                            by_ref = Some(m);
                        }
                        else
                        {
                            return Err(mismatch(sprintf(
                                "destructuring takes a `%s` by value, and this is a reference to one; read its fields through it (`r.f`), or destructure the value itself",
                                &shown_s,
                            )));
                        }
                    },
                    None    :
                    {
                        return Err(mismatch(sprintf(
                            "%s names `%s`, but the value is a `%s`",
                            if (pattern) { "the struct pattern" } else { "the destructuring" },
                            &shown_s,
                            &type_display(t),
                        )));
                    },
                }
            }
        },
        None    : {},
    }
    ref<StructDecl, shared> sdecl = Option::expect(HashMap::get(&it.structs, struct_name), "a struct");
    for (usize i = 0; i < Vec::len(&d.names); i += 1)
    {
        bool known = false;
        for (usize k = 0; k < Vec::len(&sdecl.fields); k += 1)
        {
            if (sdecl.fields[k].name == d.names[i])
            {
                known = true;
            }
        }
        if (!known)
        {
            return Err(mismatch(sprintf("`%s` has no field `%s`", &shown_s, &d.names[i])));
        }
    }
    // A struct with its own destructor keeps its fields (taken by reference,
    // nothing leaves it).
    if (Option::is_none(&by_ref) && HashMap::contains(&it.fns, &sprintf("%s::drop", struct_name)))
    {
        String msg = sprintf(
            "`%s` has a destructor, which needs its fields, so it cannot be taken apart; move it whole, or `replace` a field",
            &type_display(&named(struct_name, Vec::new())),
        );
        return Err(named_diag("diag.move-out-of-field", &msg));
    }
    // `[Let-Destructure]` (D-0044): every field, each once, or some then
    // `..` (D-0104).
    if (sorted_unique_count(&d.names) != Vec::len(&d.names))
    {
        return Err(mismatch(sprintf("a field of `%s` is named twice", &shown_s)));
    }
    if (!d.rest && Vec::len(&d.names) != Vec::len(&sdecl.fields))
    {
        Vec<String> missing = Vec::new();
        for (usize k = 0; k < Vec::len(&sdecl.fields); k += 1)
        {
            if (!Vec::contains(&d.names, &sdecl.fields[k].name))
            {
                Vec::push(&mut missing, String::clone(&sdecl.fields[k].name));
            }
        }
        bool one = Vec::len(&missing) == 1;
        return Err(mismatch(sprintf(
            "%s names every field of `%s`; `%s` %s missing — name %s or end with `..` for the rest (D-0104)",
            if (pattern) { "a struct pattern" } else { "destructuring" },
            &shown_s,
            &String::join(&missing, "`, `"),
            if (one) { "is" } else { "are" },
            if (one) { "it" } else { "them" },
        )));
    }
    if (sorted_unique_count(&d.fields) != Vec::len(&d.fields))
    {
        return Err(mismatch("two fields are bound to one name"));
    }
    // The struct's own type arguments, from the value.
    Vec<Type> targs = match (&st)
    {
        Some(Type::TRef(rb)) : named_args(&Box::get(rb).inner),
        Some(t)              : named_args(t),
        None                 : Vec::new(),
    };
    Vec<Stmt> lets = Vec::new();
    HashMap<String, Type> tsub = zip_subst(&sdecl.type_params, &targs);
    Vec<String> decl_names = Vec::new();
    for (usize k = 0; k < Vec::len(&sdecl.fields); k += 1)
    {
        Vec::push(&mut decl_names, String::clone(&sdecl.fields[k].name));
    }
    Vec<NamePair> pairs = destructure_pairs(&d.names, &d.fields, d.rest, &decl_names);
    for (usize i = 0; i < Vec::len(&pairs); i += 1)
    {
        ref<String, shared> field = &pairs[i].field;
        ref<String, shared> binder = &pairs[i].binder;
        Option<usize> fi = None;
        for (usize k = 0; k < Vec::len(&sdecl.fields); k += 1)
        {
            if (sdecl.fields[k].name == *field)
            {
                fi = Some(k);
            }
        }
        ref<FieldDecl, shared> fd = match (fi)
        {
            Some(k) : &sdecl.fields[k],
            None    : return Err(mismatch(sprintf("`%s` has no field `%s`", &shown_s, field))),
        };
        // A private field is not visible where it is named; one `..` skips
        // (its hidden `$rest` binder) names nothing (report 185).
        if (!b.privileged && !StringView::starts_with(binder, "$") && !field_visible(struct_name, fd.export_, &b.module_))
        {
            String msg = sprintf("field `%s` of `%s` is not exported", field, &shown_s);
            return Err(named_diag("diag.name-not-visible", &msg));
        }
        field_use(b, it, struct_name, field, &fd.retired, d.init.line)?;
        match (by_ref)
        {
            Some(m) :
            {
                // `..` binds nothing through a reference.
                if (!StringView::starts_with(binder, "$rest_"))
                {
                    Vec::push(&mut lets, field_borrow_let(&d.init, field, binder, m));
                }
                continue;
            },
            None    : {},
        }
        Type ft = apply_subst(&apply_subst(&fd.ty, &tsub), &b.subst);
        if (Option::is_none(&b.closure_ret))
        {
            Vec::push(&mut b.frame_types, FrameBinding { .name = String::clone(binder), .ty = clone(&ft) });
        }
        gamma_set(b, binder, Some(ft));
        declare(b, binder, true);
    }
    match (by_ref)
    {
        Some(m) :
        {
            // Checked as the declarations it is rewritten to, each numbered
            // apart from the program's (their ids key what the check
            // records).
            note_rewrite(b, &d.init, Rewrite::PatternFields(m == Mode::Exclusive));
            foreach (l in lets)
            {
                Stmt s = l;
                match (&mut s)
                {
                    Stmt::SLet(lb) :
                    {
                        match (&mut Box::get_mut(lb).init)
                        {
                            Some(e) : number_fresh(b, e),
                            None    : {},
                        }
                    },
                    _              : {},
                }
                check_stmt(b, it, &s)?;
            }
        },
        None    : {},
    }
    Ok(None)
}

// D-0324: `auto x = &p.f;` (`&mut p.f`), a field of a struct pattern reached
// through a reference (`views`'s rewrite of the destructuring).
fn field_borrow_let(ref<Expr, shared> init, ref<String, shared> field, ref<String, shared> binder, Mode m) : Stmt
{
    usize line = init.line;
    usize col = init.col;
    Expr place = mk(ExprKind::EField(Box::new(FieldExpr { .e = clone(init), .name = String::clone(field) })), line, col);
    Expr borrow = mk(ExprKind::EBorrow(Box::new(BorrowExpr { .mode = m, .e = place })), line, col);
    Stmt::SLet(Box::new(LetStmt { .ty = None, .name = String::clone(binder), .init = Some(borrow), .line = line, .col = 0 }))
}

fn check_stmt_inner(ref<Body, exclusive> b, ref<Items, shared> it, ref<Stmt, shared> s) : Result<Option<Type>, String>
{
    match (s)
    {
        Stmt::SLet(l)         : check_let(b, it, Box::get(l)),
        Stmt::SDestructure(d) : check_destructure(b, it, Box::get(d)),
        Stmt::SExpr(e)        : check_expr_stmt(b, it, Box::get(e), true),
        Stmt::SBlockLike(e)   : check_expr_stmt(b, it, Box::get(e), false),
    }
}

fn check_expr_stmt(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e, bool value) : Result<Option<Type>, String>
{
    Option<Type> t = check_expr(b, it, e, &None)?;
    if (value)
    {
        uninferred(b, it, e, &t)?;
    }
    // `[Stmt-Result-Discarded]` (D-0099).
    bool result = match (&t)
    {
        Some(x) : named_is(x, "std::Result"),
        None    : false,
    };
    if (result)
    {
        // Bug 097: at the call whose result is dropped.
        return Err(sprintf(
            "%s%s",
            &named_diag(
                "diag.result-discarded",
                "this `Result` is discarded, so an error it carries would be lost: handle it (`?`, `match`), or discard it on purpose with `_ = …;`",
            ),
            &diag_at(e.line, e.col),
        ));
    }
    // Reports 350, 380 (D-0339): a thread's handle as a statement's value
    // ends there, and its end waits for the thread: `spawn(f, x);` in a loop
    // runs each thread to its end before the next starts. A thread that gives
    // a `Result` would lose it, as any discarded `Result` (D-0099).
    match (&t)
    {
        Some(Type::THandle(hb)) :
        {
            if (named_is(Box::get(hb), "std::Result"))
            {
                return Err(sprintf(
                    "%s%s",
                    &named_diag(
                        "diag.result-discarded",
                        "this thread's handle ends here, unjoined, and the `Result` its thread gives would be lost: keep the handle (`auto h = spawn(…);`) and `join(h)` it later (`?`, `match`), or discard the result on purpose with `_ = spawn(…);`",
                    ),
                    &diag_at(e.line, e.col),
                ));
            }
            if (!b.facts.silent && !StringView::starts_with(&b.fn_name, "std::"))
            {
                Vec::push(&mut b.facts.retired_notes, RetiredNote {
                    .line = e.line,
                    .col = e.col,
                    .text = "warning[diag.handle-discarded]: this statement ends the thread's handle at once, and a handle's end waits for its thread: the statement runs the thread to its end; to let it run on, keep the handle (`auto h = spawn(…);`, or push it onto a `Vec` of handles) and `join` it later",
                });
            }
        },
        _                       : {},
    }
    // Issue 125: a statement whose value is its only effect.
    if (!b.facts.silent && !StringView::starts_with(&b.fn_name, "std::"))
    {
        match (no_effect_note(e))
        {
            Some(m) : Vec::push(&mut b.facts.retired_notes, RetiredNote { .line = e.line, .col = e.col, .text = m }),
            None    : {},
        }
    }
    Ok(t)
}

// Issue 125 (D-0336): the warning for an expression statement that computes
// a value and does nothing else: a comparison, a name, a field or a literal
// (a call may have effects, and arithmetic may fault, so neither is one).
fn no_effect_note(ref<Expr, shared> e) : Option<String>
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EBinary(bb) :
        {
            // Arithmetic is left alone: it can fault, which a test may mean
            // (`x / y;`).
            BinOp op = Box::get(bb).op;
            if (op == BinOp::Eq)
            {
                return Some("warning[diag.no-effect]: this `==` compares, and its result is not used: to assign, write `=`; to discard a value on purpose, `_ = …;`");
            }
            if (is_cmp_op(op))
            {
                return Some(sprintf(
                    "warning[diag.no-effect]: this `%s` compares, and its result is not used, so the statement does nothing; to discard a value on purpose, `_ = …;`",
                    op_symbol(op),
                ));
            }
            None
        },
        ExprKind::EPath(_)    : Some("warning[diag.no-effect]: this statement only names a value, so it does nothing; to discard a value on purpose, write `_ = …;`"),
        ExprKind::EField(_)   : Some("warning[diag.no-effect]: this statement only reads a field, so it does nothing; to discard a value on purpose, write `_ = …;`"),
        ExprKind::EInt(_)     : Some("warning[diag.no-effect]: this statement is a literal, so it does nothing"),
        ExprKind::EFloat(_)   : Some("warning[diag.no-effect]: this statement is a literal, so it does nothing"),
        ExprKind::EStr(_)     : Some("warning[diag.no-effect]: this statement is a literal, so it does nothing"),
        ExprKind::EBool(_)    : Some("warning[diag.no-effect]: this statement is a literal, so it does nothing"),
        _                     : None,
    }
}

// Bug 068 (D-0336): a comparison of an unsigned value with `0` that cannot
// be false (`i >= 0`, `0 <= i`) or cannot be true (`i < 0`, `0 > i`): a
// warning of `--check`, for a count-down loop that can end only by faulting.
fn unsigned_zero_note(ref<Body, exclusive> b, BinOp op, ref<Expr, shared> a, ref<Expr, shared> c, ref<Option<Type>, shared> at, ref<Option<Type>, shared> bt)
{
    if (b.facts.silent || StringView::starts_with(&b.fn_name, "std::"))
    {
        return;
    }
    bool zero_right = is_zero_literal(c);
    bool zero_left = is_zero_literal(a);
    ref<Option<Type>, shared> ut = if (zero_right) { at } else { bt };
    ref<Expr, shared> ue = if (zero_right) { a } else { c };
    if (!(zero_right || zero_left))
    {
        return;
    }
    str ty = match (ut)
    {
        Some(Type::TInt(i)) : if (int_ty_signed(*i)) { return; } else { int_ty_name(*i) },
        _                   : return,
    };
    // Bug 269: in a generic body's instantiation, a value of a type
    // parameter's type is unsigned in this instantiation only; the generic
    // code's comparison is meant for the others.
    match (ut)
    {
        Some(t) :
        {
            if (Option::is_some(&subst_param_of(b, t)))
            {
                return;
            }
        },
        None    : {},
    }
    bool always = (zero_right && op == BinOp::Ge) || (zero_left && op == BinOp::Le);
    bool never_ = (zero_right && op == BinOp::Lt) || (zero_left && op == BinOp::Gt);
    if (!always && !never_)
    {
        return;
    }
    String verdict = sprintf("this comparison is always %s", if (always) { "true" } else { "false" });
    // Bug 270: `a - b >= 0` (C's "is there enough"): the subtraction
    // faults where it would be negative, and `a >= b` is the test.
    match (&strip_parens_tc(ue).kind)
    {
        ExprKind::EBinary(sb) :
        {
            ref<BinaryExpr, shared> sub = Box::get(sb);
            if (sub.op == BinOp::Sub)
            {
                String x = arg_text(&sub.a);
                String y = arg_text(&sub.b);
                String text = sprintf(
                    "warning[diag.comparison-constant]: %s: `%s - %s` is a `%s`, which is never below 0 (the subtraction faults when `%s > %s`); compare the operands, `%s %s %s`",
                    &verdict,
                    &x,
                    &y,
                    ty,
                    &y,
                    &x,
                    &x,
                    if (always) { ">=" } else { "<" },
                    &y,
                );
                Vec::push(&mut b.facts.retired_notes, RetiredNote { .line = a.line, .col = a.col, .text = text });
                return;
            }
        },
        _                     : {},
    }
    String text = match (simple_text(ue))
    {
        Some(n) : sprintf(
            "warning[diag.comparison-constant]: %s: `%s` is a `%s`, which is never below 0; to count down to 0, write `while (%s > 0) { %s -= 1; … }`, or count up, `foreach (k in 0..n)` with the index `n - 1 - k`",
            &verdict,
            &n,
            ty,
            &n,
            &n,
        ),
        None : sprintf(
            "warning[diag.comparison-constant]: %s: the value compared is a `%s`, which is never below 0",
            &verdict,
            ty,
        ),
    };

    Vec::push(&mut b.facts.retired_notes, RetiredNote { .line = a.line, .col = a.col, .text = text });
}

// A type parameter's marker as the program names it (`T`).
fn marker_shown(ref<String, shared> m) : StringView
{
    Option::unwrap_or(StringView::strip_prefix(m, "$"), m)
}

// Report 346: `x == v` of two references compares where they refer
// (identity, spec/09), not the values; where the values could be compared
// (both refer to a type parameter `T` bound `eq` or `ordered`), that is
// rarely what is meant: a warning of `--check` naming `*x == *v`.
fn ref_identity_note(ref<Body, exclusive> b, BinOp op, ref<Expr, shared> a, ref<Expr, shared> c, ref<Option<Type>, shared> at, ref<Option<Type>, shared> bt)
{
    if (b.facts.silent || StringView::starts_with(&b.fn_name, "std::") || !(op == BinOp::Eq || op == BinOp::Ne))
    {
        return;
    }
    Type ta = match (at)
    {
        Some(Type::TRef(r)) : clone(&Box::get(r).inner),
        _                   : return,
    };
    Type tc = match (bt)
    {
        Some(Type::TRef(r)) : clone(&Box::get(r).inner),
        _                   : return,
    };
    if (!type_eq(&ta, &tc))
    {
        return;
    }
    // The referent is a type parameter bound `eq`: a marker in the generic
    // body, or what an instantiation put in its place.
    bool comparable = match (marker_of(&ta))
    {
        Some(m) : match (HashMap::get(&b.marker_bounds, &m))
        {
            Some(have) : bound_implies(*have, Bound::BEq),
            None       : false,
        },
        None : false,
    };
    String ma = match (marker_of(&ta))
    {
        Some(m) : String::copy(marker_shown(&m)),
        None    : String::new(),
    };
    for (usize i = 0; i < HashMap::len(&b.subst) && !comparable; i += 1)
    {
        comparable = HashSet::contains(&b.eq_params, HashMap::key_at(&b.subst, i)) && type_eq(HashMap::value_at(&b.subst, i), &ta);
        if (comparable)
        {
            ma = String::clone(HashMap::key_at(&b.subst, i));
        }
    }
    if (!comparable)
    {
        return;
    }
    String l = Option::unwrap_or(simple_text(a), "a");
    String r = Option::unwrap_or(simple_text(c), "b");
    str sym = if (op == BinOp::Eq) { "==" } else { "!=" };
    String text = sprintf(
        "warning[diag.reference-identity]: `%s %s %s` compares two references, so it asks whether they refer to the same place, not whether the `%s` values are equal; for the values write `*%s %s *%s`, for the place `rawptr_of(%s) %s rawptr_of(%s)`",
        &l,
        sym,
        &r,
        &ma,
        &l,
        sym,
        &r,
        &l,
        sym,
        &r,
    );
    Vec::push(&mut b.facts.retired_notes, RetiredNote { .line = a.line, .col = a.col, .text = text });
}

fn is_zero_literal(ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EInt(ib) : Box::get(ib).v == 0,
        _                  : false,
    }
}

struct GammaUndo
{
    String name;
    Option<Type> prev;
}

// `name`'s type in `gamma` set (`None`: removed), the type it replaced logged.
fn gamma_set(ref<Body, exclusive> b, ref<String, shared> name, Option<Type> t)
{
    Option<Type> prev = match (t)
    {
        Some(t) : HashMap::insert(&mut b.gamma, String::clone(name), t),
        None    : HashMap::swap_remove(&mut b.gamma, name),
    };
    Vec::push(&mut b.gamma_log, GammaUndo { .name = String::clone(name), .prev = prev });
}

// `gamma` as it was when the log was `mark` long.
fn gamma_undo(ref<Body, exclusive> b, usize mark)
{
    while (Vec::len(&b.gamma_log) > mark)
    {
        GammaUndo u = Option::expect(Vec::pop(&mut b.gamma_log), "a logged write");
        GammaUndo { name, prev } = u;
        match (prev)
        {
            Some(t) :
            {
                HashMap::insert(&mut b.gamma, name, t);
            },
            None    :
            {
                HashMap::swap_remove(&mut b.gamma, &name);
            },
        }
    }
}

// Whether holder `h` is a thread's handle or a `Vec` of them (D-0289; the
// pass's `thread_holder`).
fn thread_holder(ref<Body, shared> b, ref<String, shared> h) : bool
{
    match (lookup_local(b, h))
    {
        Some(Type::THandle(_)) : true,
        Some(Type::TNamed(n))  :
        {
            Box::get(&n).name == "std::Vec" && Vec::len(&Box::get(&n).args) > 0 && match (&Box::get(&n).args[0])
            {
                Type::THandle(_) : true,
                _                : false,
            }
        },
        _                      : false,
    }
}

fn lookup_local(ref<Body, shared> b, ref<String, shared> name) : Option<Type>
{
    match (HashMap::get(&b.gamma, name))
    {
        Some(t) : Some(clone(t)),
        None    : None,
    }
}

// A binding in scope, whether or not this pass knows its type.
// `[Generic-Call-Uninferable]` (CHG-0438): a value whose type still has a
// type argument nothing fixed, where nothing later can fix it: a generic
// variant left untyped (`None`), an empty array literal, or a type holding a
// marker that is not one of this body's own type parameters.
fn uninferred(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e, ref<Option<Type>, shared> t) : Result<void, String>
{
    bool open = match (t)
    {
        // An empty array literal is typed by its declaration
        // (`[Array-Construct]` with `N = 0`); this pass's `array<i32, 0>`
        // for one with none is only a placeholder.
        Some(x) : foreign_marker(b, x) || empty_array_lit(e),
        None    :
        {
            ref<Expr, shared> x = strip_parens_tc(e);
            bool more = true;
            while (more)
            {
                more = false;
                match (&x.kind)
                {
                    ExprKind::EBlock(blk) :
                    {
                        if (Vec::len(&blk.stmts) == 0)
                        {
                            match (&blk.tail)
                            {
                                Some(tl) :
                                {
                                    x = strip_parens_tc(Box::get(tl));
                                    more = true;
                                },
                                None     : {},
                            }
                        }
                    },
                    _                     : {},
                }
            }
            match (&x.kind)
            {
                ExprKind::EPath(pb)        : generic_variant_path(b, it, &Box::get(pb).segs),
                ExprKind::ECall(cb) : match (&Box::get(cb).callee.kind)
                {
                    ExprKind::EPath(pb) : generic_variant_path(b, it, &Box::get(pb).segs),
                    _                   : false,
                },
                ExprKind::EArrayLit(items) : Vec::len(items) == 0,
                _                          : false,
            }
        },
    };
    if (open)
    {
        return Err(named_diag(
            "diag.cannot-infer-type-parameter",
            "nothing here fixes a type argument of this value (`None`, `Vec::new()`, `[]`): declare the type where it is bound, or write the type arguments (`Vec::new<i32>()`)",
        ));
    }
    Ok(())
}

// `[]`, in parentheses or not.
fn empty_array_lit(ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EArrayLit(items) : Vec::len(items) == 0,
        _                          : false,
    }
}

// A value nothing types by itself (CHG-0438): a generic variant with no
// payload to fix it, an empty array literal, a call of a generic function
// with no type arguments written whose own arguments are such values or none.
fn open_ctor(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    ref<Expr, shared> x = strip_parens_tc(e);
    match (&x.kind)
    {
        ExprKind::EPath(pb)        : generic_variant_path(b, it, &Box::get(pb).segs),
        ExprKind::EArrayLit(items) : Vec::len(items) == 0,
        ExprKind::EBorrow(bb)      : open_ctor(b, it, &Box::get(bb).e),
        ExprKind::ECall(cb)        :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            match (&c.callee.kind)
            {
                ExprKind::EPath(pb) :
                {
                    ref<PathExpr, shared> p = Box::get(pb);
                    if (Vec::len(&p.targs) > 0)
                    {
                        return false;
                    }
                    bool generic_variant = match (variant_enum(it, &p.segs))
                    {
                        Some(en) : match (HashMap::get(&it.enums, &en))
                        {
                            Some(d) : Vec::len(&d.type_params) > 0,
                            None    : false,
                        },
                        None : false,
                    };
                    String name = String::join(&p.segs, "::");
                    String fkey = if (HashMap::contains(&it.fns, &name)) { name } else { sprintf("std::%s", &name) };
                    bool generic_fn = match (HashMap::get(&it.fns, &fkey))
                    {
                        Some(g) : Vec::len(&g.type_params) > 0,
                        None    : false,
                    };
                    if (!generic_variant && !generic_fn)
                    {
                        return false;
                    }
                    for (usize i = 0; i < Vec::len(&c.args); i += 1)
                    {
                        if (!open_ctor(b, it, &c.args[i]))
                        {
                            return false;
                        }
                    }
                    true
                },
                _                   : false,
            }
        },
        _                          : false,
    }
}

fn generic_variant_path(ref<Body, shared> b, ref<Items, shared> it, ref<Vec<String>, shared> segs) : bool
{
    if (Vec::len(segs) == 1 && is_local(b, &segs[0]))
    {
        return false;
    }
    match (variant_enum(it, segs))
    {
        Some(en) : match (HashMap::get(&it.enums, &en))
        {
            Some(d) : Vec::len(&d.type_params) > 0,
            None    : false,
        },
        None : false,
    }
}

fn foreign_marker(ref<Body, shared> b, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(nb) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (Vec::len(&n.args) == 0 && StringView::starts_with(&n.name, "$"))
            {
                for (usize i = 0; i < HashMap::len(&b.subst); i += 1)
                {
                    match (HashMap::value_at(&b.subst, i))
                    {
                        Type::TNamed(vb) : if (Vec::len(&Box::get(vb).args) == 0 && Box::get(vb).name == n.name) { return false; },
                        _                : {},
                    }
                }
                return true;
            }
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (foreign_marker(b, &n.args[i]))
                {
                    return true;
                }
            }
            false
        },
        Type::TRef(x)    : foreign_marker(b, &Box::get(x).inner),
        Type::TSlice(x)  : foreign_marker(b, &Box::get(x).inner),
        Type::TRawptr(x) : foreign_marker(b, Box::get(x)),
        Type::TArray(x)  : foreign_marker(b, &Box::get(x).inner),
        Type::THandle(x) : foreign_marker(b, Box::get(x)),
        Type::TMutex(x)  : foreign_marker(b, Box::get(x)),
        Type::TGuard(x)  : foreign_marker(b, Box::get(x)),
        Type::TFn(x)     :
        {
            ref<FnTy, shared> f = Box::get(x);
            for (usize i = 0; i < Vec::len(&f.params); i += 1)
            {
                if (foreign_marker(b, &f.params[i]))
                {
                    return true;
                }
            }
            foreign_marker(b, &f.ret)
        },
        _                : false,
    }
}

fn is_local(ref<Body, shared> b, ref<String, shared> name) : bool
{
    HashMap::contains(&b.gamma, name) || flow_is_tracked(&b.flow, name) || HashSet::contains(&b.capture_names, name)
}

fn is_value_read_shape(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EField(_) : true,
        ExprKind::EIndex(_) : true,
        ExprKind::EDeref(_) : true,
        _                   : false,
    }
}

// Tags the first untagged fault that passes through with this
// expression's own line.
fn check_expr(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    b.current_line = e.line;
    b.current_col = e.col;
    b.cur_temp_ok = replace(&mut b.arg_temp_ok, false);
    bool coerce = !replace(&mut b.no_coerce, false);
    b.cur_arg_ref_param = replace(&mut b.arg_ref_param, false);
    // D-0218: a field, element or `*r` read as a value through a shared
    // reference.
    bool exempt = replace(&mut b.read_exempt, false) || b.place_pos;
    match (&e.kind)
    {
        ExprKind::EParen(_) : b.read_exempt = exempt,
        _                   : {},
    }
    bool value_read = !exempt && is_value_read_shape(e);
    Result<Option<Type>, String> r = check_expr_inner(b, it, e, expected);
    r = match (r)
    {
        Ok(Some(t)) : if (value_read) { read_through_shared(b, it, e, t, expected) } else { Ok(Some(t)) },
        other       : other,
    };
    // D-0312 `[Coerce-Text]`: text that does not fit the type its position
    // declares, where the rule makes it fit, is the expression the rule
    // writes, and has that type.
    Option<Type> coerced = None;
    match (&r)
    {
        Ok(Some(t)) : match (expected)
        {
            Some(w) :
            {
                if (ty_compat(t, w))
                {
                    whole_slice_lint(b, it, w, e);
                }
                if (coerce && !ty_compat(t, w) && coerce_text(b, it, w, t, e))
                {
                    coerced = Some(clone(w));
                }
                // A shared reference too: `&k` where a `probe<K>` is declared
                // is viewed for a `String` key and kept for another (D-0312).
                else if (HashMap::len(&b.subst) > 0 && !has_unresolved_marker(w) && (matches_str(t) || is_shared_ref_ty(t)))
                {
                    note_unrewritten(b, e);
                }
            },
            None    : {},
        },
        _ : {},
    }
    if (Option::is_some(&coerced))
    {
        r = Ok(coerced);
    }
    match (&r)
    {
        Ok(Some(t)) : note_settled(b, e, t),
        _           : {},
    }
    match (r)
    {
        Err(d) :
        {
            if (!StringView::contains(&d, "@"))
            {
                return Err(sprintf("%s%s", &d, &diag_at(e.line, e.col)));
            }
            Err(d)
        },
        Ok(t)  : Ok(t),
    }
}

// D-0340 §9: `settled`'s entry for `e`.
fn note_settled(ref<Body, exclusive> b, ref<Expr, shared> e, ref<Type, shared> t)
{
    if (HashMap::len(&b.subst) > 0 || b.flow.unreachable)
    {
        return;
    }
    bool kind = match (&e.kind)
    {
        ExprKind::EArrayLit(_)  : true,
        ExprKind::EIf(_)        : true,
        ExprKind::EMatch(_)     : true,
        ExprKind::EStructLit(_) : true,
        _                       : false,
    };
    // CHG-0485: `[]`, typed only by what was expected of it (a slice
    // parameter's element type), whatever that type is.
    bool empty = match (&e.kind)
    {
        ExprKind::EArrayLit(items) : Vec::len(items) == 0,
        _                          : false,
    };
    // (The bounded test first: a type 100,000 deep is not walked at each level.)
    if (!kind || (!empty && !mentions_option_or_result(t, 0)) || has_unresolved_marker(t))
    {
        return;
    }
    HashMap::insert(&mut b.facts.settled, e.id, clone(t));
}

fn mentions_option_or_result(ref<Type, shared> t, u32 depth) : bool
{
    if (depth > 8)
    {
        return false;
    }
    match (t)
    {
        Type::TNamed(nb) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (n.name == "std::Option" || n.name == "std::Result")
            {
                return true;
            }
            foreach (a in &n.args)
            {
                if (mentions_option_or_result(a, depth + 1))
                {
                    return true;
                }
            }
            false
        },
        Type::TArray(a)  : mentions_option_or_result(&Box::get(a).inner, depth + 1),
        _                : false,
    }
}

fn is_excl_ref_or_slice(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(Type::TRef(rb))   : Box::get(rb).mode == Mode::Exclusive,
        Some(Type::TSlice(sb)) : Box::get(sb).mode == Mode::Exclusive,
        _                      : false,
    }
}

fn copies_excl_msg(ref<Type, shared> t) : String
{
    String msg = sprintf(
        "this copies a `%s`, which holds an exclusive reference, out through a shared reference (D-0218): the copy could write what the shared reference reaches; borrow it instead (`&e`), or pass the owner by `ref<_, exclusive>`",
        &type_display(t),
    );
    named_diag("diag.borrow-exceeds-source", &msg)
}

// `[Read-Ref-Through-Shared]` and `[Read-Exclusive-Through-Shared]`
// (spec/08, D-0218).
fn read_through_shared(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    Type t,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    if (has_unresolved_marker(&t) || !crosses_shared(b, it, e))
    {
        return Ok(Some(t));
    }
    bool excl = match (&t)
    {
        Type::TRef(rb)   : Box::get(rb).mode == Mode::Exclusive,
        Type::TSlice(sb) : Box::get(sb).mode == Mode::Exclusive,
        _                : false,
    };
    if (excl)
    {
        bool slc = match (&t)
        {
            Type::TSlice(_) : true,
            _               : false,
        };
        if (is_excl_ref_or_slice(expected))
        {
            return Err(named_diag(
                "diag.borrow-exceeds-source",
                "this exclusive reference is read through a shared reference, so it is shared here (D-0218): what a shared reference reaches cannot be written, at any depth; pass the struct by `ref<_, exclusive>` to write through it",
            ));
        }
        if (b.facts.silent)
        {
            return Err(named_diag(
                "diag.borrow-exceeds-source",
                "an exclusive reference read through a shared reference in a body checked after the program was built",
            ));
        }
        note_rewrite(b, e, if (slc) { Rewrite::SharedSlice } else { Rewrite::SharedRef });
        Type inner = Option::expect(inner_of(&t), "a reference's referent");
        return Ok(Some(if (slc) { slice_of(inner, Mode::Shared) } else { ref_of(inner, Mode::Shared) }));
    }
    if (contains_fn(it, &t))
    {
        // A `fn` type does not show its closure's captures: each tool
        // checks where this is read or called (`[Read-Fn-Through-Shared]`).
        HashSet::insert(&mut b.facts.shared_fn_reads, e.id);
        if (holds_excl_ref(it, &t, 0))
        {
            return Err(copies_excl_msg(&t));
        }
        return Ok(Some(t));
    }
    if (holds_excl_ref(it, &t, 0))
    {
        return Err(copies_excl_msg(&t));
    }
    Ok(Some(t))
}

// Bug 129: what a condition or an index of the wrong type is written as.
fn expect_hint(ref<Type, shared> want, ref<Type, shared> got, ref<Expr, shared> e) : String
{
    String n = Option::unwrap_or(simple_text(e), "x");
    if (type_eq(want, &Type::TBool))
    {
        match (got)
        {
            Type::TInt(_)    : return sprintf("; a number is not a condition: compare it, `%s != 0`", &n),
            Type::TF32       : return sprintf("; a number is not a condition: compare it, `%s != 0.0`", &n),
            Type::TF64       : return sprintf("; a number is not a condition: compare it, `%s != 0.0`", &n),
            Type::TNamed(nb) :
            {
                ref<String, shared> name = &Box::get(nb).name;
                if (*name == "std::Option")
                {
                    return "; an `Option` is not a condition: test it with a pattern, `while (Some(x) = …)` / `if (Some(x) = …)`, or `Option::is_some(&o)`";
                }
                if (*name == "std::Result")
                {
                    return "; a `Result` is not a condition: test it with a pattern, `if (Ok(x) = …)`, or `Result::is_ok(&r)`";
                }
                if (*name == "std::String" || *name == "std::StringView")
                {
                    return sprintf("; text is not a condition: test its length, `StringView::len(&%s) > 0`", &n);
                }
            },
            _                : {},
        }
        return String::new();
    }
    // Bug 069: an index of another integer type.
    if (type_eq(want, &Type::TInt(IntTy::Usize)))
    {
        match (got)
        {
            Type::TInt(g) :
            {
                IntRange gr = int_range(*g);
                IntRange ur = int_range(IntTy::Usize);
                if (ur.min <= gr.min && gr.max <= ur.max)
                {
                    return sprintf("; an index is a `usize`: `widen<usize>(%s)`, or count in `usize` from the start", &n);
                }
                return sprintf("; an index is a `usize`: `narrow<usize>(%s)` (checked: faults when it is negative), or count in `usize` from the start", &n);
            },
            _             : {},
        }
    }
    String::new()
}

// An operand whose type the rule fixes: an `if`/`while` condition, an
// index or a slice bound.
fn check_expect(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Type, shared> want,
) : Result<void, String>
{
    Option<Type> t = check_expr(b, it, e, &Some(clone(want)))?;
    match (&t)
    {
        Some(x) :
        {
            if (!has_unresolved_marker(x) && !ty_compat(x, want))
            {
                bool assign = match (&strip_parens_tc(e).kind)
                {
                    ExprKind::EAssign(_) : true,
                    _                    : false,
                };
                String hint = if (type_eq(
                    want,
                    &Type::TBool,
                ) && assign) { "; `=` assigns (its value is `void`) -- compare with `==`" } else { expect_hint(want, x, e) };
                return Err(sprintf(
                    "%s%s",
                    &mismatch(sprintf("expected `%s`, found `%s`%s", &type_display(want), &type_display(x), &hint)),
                    &diag_at(e.line, e.col),
                ));
            }
        },
        None    : {},
    }
    Ok(())
}

// ---- helpers ----

export struct NamePair
{
    export String field;
    export String binder;
}

// A destructuring's pairs: each named field with its binder, and with
// `..` the others, bound to hidden names.
export fn destructure_pairs(
    ref<Vec<String>, shared> names,
    ref<Vec<String>, shared> binders,
    bool rest,
    ref<Vec<String>, shared> decl_fields,
) : Vec<NamePair>
{
    Vec<NamePair> out = Vec::new();
    for (usize i = 0; i < Vec::len(names) && i < Vec::len(binders); i += 1)
    {
        Vec::push(&mut out, NamePair { .field = String::clone(&names[i]), .binder = String::clone(&binders[i]) });
    }
    if (rest)
    {
        for (usize i = 0; i < Vec::len(decl_fields); i += 1)
        {
            if (!Vec::contains(names, &decl_fields[i]))
            {
                Vec::push(
                    &mut out,
                    NamePair { .field = String::clone(&decl_fields[i]), .binder = sprintf(
                        "$rest_%s",
                        &decl_fields[i],
                    ) },
                );
            }
        }
    }
    out
}

// D-0322 (`Rewrite::AssertValues`): the types of an `assert`'s comparison's
// operands, each bound first at its type.
export struct AssertValuesRewrite
{
    export Type lt;
    export Type rt;
}

export struct TextEqRewrite
{
    export bool string_left;
    export bool other_is_str;
    export bool negate;
}

/// A front-end rewrite the checker asks for (D-0164), keyed by the node.
export enum Rewrite
{
    // D-0322: an `assert` whose condition compares two scalars, recorded on
    // the comparison with the operands' types: each operand is bound first,
    // in order, at its type, and a failure shows both values
    // (`assert_values`).
    AssertValues(AssertValuesRewrite),
    // D-0312 §2: `&t[lo..hi]` of a `str` `t` is `&StringView::of(t)[lo..hi]`, a
    // view of static text; recorded on `t`.
    StrView,
    // D-0314 `[Coerce-Slice-Literal]`: an array literal of literals where a
    // shared slice is declared: `&(*&K)[0..$]` of a constant `K` the rewrite
    // adds, of the type `slice_literals` records.
    SliceLiteral,
    TextEq(TextEqRewrite),
    // D-0218: an exclusive reference read through a shared one: `&*e`.
    SharedRef,
    // D-0218: the same for a slice: `&e[0..$]`.
    SharedSlice,
    // D-0225: a text literal where a variant's payload is a `StringView`.
    LiteralView,
    // D-0301: a `*x` binder's `Box::get(b)` that is `Box::get_mut(b)` or
    // `Box::into_inner(b)`, `[Match-Through-Box]`; on the callee's path.
    BoxGetMut,
    BoxIntoInner,
    // D-0302 `[Ref-String-View]`: `&e` where a `StringView` is declared is
    // `&e[0..$]`, a place `r` of type `ref<String, shared>` is
    // `&(*r)[0..$]`; `[Str-Value-View]`: a `str` value `t` is
    // `StringView::of(t)`.
    RefStringView,
    RefPlaceView,
    StrValueView,
    // D-0312 `[Cmp-Through-Shared-Ref]`: a reference operand compared with a
    // value of what it refers to: `*e`, on the operand.
    DerefOperand,
    // D-0312 `[Cmp-Text]`: two texts of different types ordered:
    // `StringView::less` of the two, on the comparison.
    TextOrder(TextOrderRewrite),
    // D-0312 `[Coerce-Slice]`: `&v` of a `Vec` or an array where a slice is
    // declared is `&v[0..$]` (`&mut v[0..$]`, exclusive); a reference `e` to
    // one is `&(*e)[0..$]`.
    SeqSlice(bool),
    SeqPlaceSlice(bool),
    // D-0324 `[Struct-Pattern-By-Ref]`: a struct pattern reached through a
    // reference binds each name to a reference to its field: the
    // destructuring becomes `auto x = &p.f;` (`&mut p.f;` when exclusive) for
    // each named field, in order; on the destructuring's value.
    PatternFields(bool),
    // Report 242: a `str` where a `probe<StringView>` (a
    // `ref<StringView, shared>`) is declared: `&StringView::of(t)`.
    ProbeViewRef,
    // Report 307: a generic call's type arguments the checker inferred from
    // where it stands (`&Vec::new()` where a slice is expected), written on
    // its path, so `[Coerce-Slice]`'s `&Vec::new()[0..$]` keeps them.
    CallTypeArgs(Vec<Type>),
}

export struct TextOrderRewrite
{
    export bool swap;
    export bool negate;
    export bool borrow_left;
    export bool borrow_right;
}

// D-0308: `ref<String, shared>`.
// `ref<τ, shared>`.
fn is_shared_ref_ty(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(m) : Box::get(m).mode == Mode::Shared,
        _             : false,
    }
}

// D-0312 §4: whether `--check`'s text lints are reported (cobc's driver
// sets it for `--check`).
static AtomicBool TEXT_LINTS = false;
static AtomicBool TEXT_LINTS_STD = false;

export fn report_text_lints()
{
    AtomicBool::store(&TEXT_LINTS, true);
}

// `COBALTC_TEXT_LINTS=all`: the lints in `std`'s own bodies too (the
// migration of `std` itself; a program's `--check` leaves `std` alone).
export fn report_text_lints_in_std()
{
    AtomicBool::store(&TEXT_LINTS_STD, true);
}

fn text_lints_on() : bool
{
    AtomicBool::load(&TEXT_LINTS)
}

fn text_lints_in_std() : bool
{
    AtomicBool::load(&TEXT_LINTS_STD)
}

// D-0312 §3.2, the lint of `--check` (`diag.slice-of-whole`): `&x[0..$]` where
// a slice or a `StringView` is declared is the whole of `x`, which
// `[Coerce-Slice]` and `[Coerce-Text]` make `&x` there; a view, a slice or a
// `str` is passed as it is, and a reference to a sequence too. `[lo..hi]` is
// for a part. Not on a slice the front end wrote itself (its `0` has column
// 0), nor in `std` unless asked (`text_lints_in_std`).
fn whole_slice_lint(ref<Body, exclusive> b, ref<Items, shared> it, ref<Type, shared> want, ref<Expr, shared> e0)
{
    if (!text_lints_on() || b.facts.silent || (!text_lints_in_std() && (b.module_ == "std" || StringView::starts_with(&b.module_, "std::"))))
    {
        return;
    }
    // The wanted type first (bug 044): stripping the parentheses at each
    // level of `((…))` checked against an `i32` was quadratic.
    bool view_wanted = plain_named_ty(want, "std::StringView");
    bool slice_wanted = match (want)
    {
        Type::TSlice(_) : true,
        _               : false,
    };
    if (!view_wanted && !slice_wanted)
    {
        return;
    }
    ref<Expr, shared> e = strip_parens_tc(e0);
    ref<SliceExpr, shared> sl = match (&e.kind)
    {
        ExprKind::ESliceOf(sb) : Box::get(sb),
        _                      : return,
    };
    bool lo_zero = match (&sl.lo.kind)
    {
        ExprKind::EInt(lb) : Box::get(lb).v == 0,
        _                  : false,
    };
    bool hi_end = match (&sl.hi.kind)
    {
        ExprKind::EDollar : true,
        _                 : false,
    };
    if (!lo_zero || sl.lo.col == 0 || !hi_end)
    {
        return;
    }
    ref<Expr, shared> base = strip_parens_tc(&sl.base);
    str mode = if (sl.mode == Mode::Exclusive) { "mut " } else { "" };
    str which = if (view_wanted) { "`StringView`" } else { "slice" };
    match (&base.kind)
    {
        // A temporary sliced as an argument: `&f()[0..$]` is `&f()` there; not
        // the call the `str` rewrite made (`StringView::of(t)`).
        ExprKind::ECall(cb)       :
        {
            match (&Box::get(cb).callee.kind)
            {
                ExprKind::EPath(pb) :
                {
                    if (String::join(&Box::get(pb).segs, "::") == "std::StringView::of")
                    {
                        return;
                    }
                },
                _                   : {},
            }
            // A call whose result is already the slice or the view: the call
            // itself, without `&` and `[0..$]`.
            match (value_shape(b, it, base))
            {
                Some(t) :
                {
                    bool is_slice = match (&t)
                    {
                        Type::TSlice(_) : true,
                        _               : false,
                    };
                    if (is_slice && slice_wanted)
                    {
                        Vec::push(&mut b.facts.retired_notes, RetiredNote { .line = e.line, .col = e.col, .text = "warning[diag.slice-of-whole]: the call's result is already a slice: write the call, without `&` and `[0..$]`" });
                        return;
                    }
                    if (view_wanted && plain_named_ty(&t, "std::StringView"))
                    {
                        Vec::push(&mut b.facts.retired_notes, RetiredNote { .line = e.line, .col = e.col, .text = "warning[diag.slice-of-whole]: the call's result is already a `StringView`: write the call, without `&` and `[0..$]`" });
                        return;
                    }
                    if (!lint_seq(&t) && !plain_named_ty(&t, "std::String"))
                    {
                        return;
                    }
                },
                None    : return,
            }
            Vec::push(&mut b.facts.retired_notes, RetiredNote { .line = e.line, .col = e.col, .text = sprintf(
                "warning[diag.slice-of-whole]: `&%s…[0..$]` is the whole of the call's result, which `&%s…` is where a %s is declared (`[Coerce-Slice]`, `[Coerce-Text]`, D-0312): write it without `[0..$]`",
                mode,
                mode,
                which,
            ) });
            return;
        },
        // An array literal: `&[…]` is the slice as an argument, and one of
        // literals is the slice itself wherever a shared slice is declared
        // (`[Coerce-Slice-Literal]`, D-0314).
        ExprKind::EArrayLit(_)    :
        {
            array_literal_lint(b, want, e, base, sl.mode, slice_wanted, mode);
            return;
        },
        ExprKind::EArrayRepeat(_) :
        {
            array_literal_lint(b, want, e, base, sl.mode, slice_wanted, mode);
            return;
        },
        _                         : {},
    }
    // `&(*r)[0..$]`: `r` itself refers to the whole of it.
    match (&base.kind)
    {
        ExprKind::EDeref(inner) :
        {
            // `&K[0..$]` of a constant array (`&(*&K)[0..$]` by
            // `[Ref-Form-Const-Place]`): `&K`.
            match (&strip_parens_tc(Box::get(inner)).kind)
            {
                ExprKind::EBorrow(kb) :
                {
                    ref<BorrowExpr, shared> k = Box::get(kb);
                    if (k.mode == Mode::Shared)
                    {
                        bool seq = match (value_shape(b, it, &k.e))
                        {
                            Some(t) : lint_seq(&t),
                            None    : false,
                        };
                        if (slice_wanted && sl.mode == Mode::Shared && const_call(it, &k.e) && seq)
                        {
                            String x = match (&strip_parens_tc(&k.e).kind)
                            {
                                ExprKind::ECall(kc) : Option::unwrap_or(place_text(&Box::get(kc).callee), "…"),
                                _                   : "…",
                            };
                            Vec::push(&mut b.facts.retired_notes, RetiredNote { .line = e.line, .col = e.col, .text = sprintf(
                                "warning[diag.slice-of-whole]: `&%s[0..$]` is the whole of `%s`, which `&%s` is where a slice is declared (`[Coerce-Slice]`, D-0312): write it without `[0..$]`",
                                &x,
                                &x,
                                &x,
                            ) });
                        }
                        return;
                    }
                },
                _                     : {},
            }
            match (static_place_type(b, it, Box::get(inner)))
            {
                Some(Type::TRef(rb)) :
                {
                    ref<ModedTy, shared> r = Box::get(&rb);
                    if ((lint_seq(&r.inner) && slice_wanted && (sl.mode == Mode::Shared || r.mode == Mode::Exclusive)) || (plain_named_ty(&r.inner, "std::String") && view_wanted))
                    {
                        String x = Option::unwrap_or(place_text(Box::get(inner)), "…");
                        Vec::push(&mut b.facts.retired_notes, RetiredNote { .line = e.line, .col = e.col, .text = sprintf(
                            "warning[diag.slice-of-whole]: `%s` already refers to the whole of it, and is the %s where one is declared (`[Coerce-Slice]`, `[Coerce-Text]`, D-0312): write `%s`, without `&`, `*` and `[0..$]`",
                            &x,
                            which,
                            &x,
                        ) });
                    }
                    return;
                },
                _                    : {},
            }
        },
        _                       : {},
    }
    String x = Option::unwrap_or(place_text(base), "…");
    Type bt = match (static_place_type(b, it, base))
    {
        Some(t) : t,
        None    : return,
    };
    Option<String> msg = if (lint_seq(&bt) && slice_wanted)
    {
        Some(sprintf(
            "warning[diag.slice-of-whole]: `&%s%s[0..$]` is the whole of `%s`, which `&%s%s` is where a slice is declared (`[Coerce-Slice]`, D-0312): write it without `[0..$]`",
            mode,
            &x,
            &x,
            mode,
            &x,
        ))
    }
    else if (plain_named_ty(&bt, "std::String") && view_wanted)
    {
        Some(sprintf(
            "warning[diag.slice-of-whole]: `&%s[0..$]` is the whole of `%s`, which `&%s` is where a `StringView` is declared (`[Coerce-Text]`, D-0312): write it without `[0..$]`",
            &x,
            &x,
            &x,
        ))
    }
    else if (plain_named_ty(&bt, "std::StringView") && view_wanted)
    {
        Some(sprintf("warning[diag.slice-of-whole]: `%s` is already a `StringView`: write `%s`, without `&` and `[0..$]`", &x, &x))
    }
    else
    {
        match (&bt)
        {
            Type::TSlice(_) : if (slice_wanted) { Some(sprintf("warning[diag.slice-of-whole]: `%s` is already a slice: write `%s`, without `&` and `[0..$]`", &x, &x)) } else { None },
            Type::TStr      : if (view_wanted) { Some(sprintf("warning[diag.slice-of-whole]: `%s` is a `str`, a view where a `StringView` is declared (`[Coerce-Text]`, D-0312): write `%s`, without `&` and `[0..$]`", &x, &x)) } else { None },
            Type::TRef(rb)  :
            {
                ref<ModedTy, shared> r = Box::get(rb);
                if ((lint_seq(&r.inner) && slice_wanted && (sl.mode == Mode::Shared || r.mode == Mode::Exclusive)) || (plain_named_ty(&r.inner, "std::String") && view_wanted))
                {
                    Some(sprintf(
                        "warning[diag.slice-of-whole]: `%s` already refers to the whole of it, and is the %s where one is declared (`[Coerce-Slice]`, `[Coerce-Text]`, D-0312): write `%s`, without `&` and `[0..$]`",
                        &x,
                        which,
                        &x,
                    ))
                }
                else
                {
                    None
                }
            },
            _               : None,
        }
    };
    match (msg)
    {
        Some(m) : Vec::push(&mut b.facts.retired_notes, RetiredNote { .line = e.line, .col = e.col, .text = m }),
        None    : {},
    }
}

// A text as Rust's `{:?}` writes it (the messages quote a literal so):
// in double quotes, `\\`, `"`, newline, return, tab and NUL escaped, any
// other control byte as `\u{…}`; other bytes as they are.
fn rust_debug_text(ref<String, shared> s) : String
{
    String out = "\"";
    foreach (b in StringView::as_bytes(s))
    {
        u8 c = *b;
        if (c == b'\\')
        {
            String::append(&mut out, "\\\\");
        }
        else if (c == b'"')
        {
            String::append(&mut out, "\\\"");
        }
        else if (c == b'\n')
        {
            String::append(&mut out, "\\n");
        }
        else if (c == b'\r')
        {
            String::append(&mut out, "\\r");
        }
        else if (c == b'\t')
        {
            String::append(&mut out, "\\t");
        }
        else if (c == 0)
        {
            String::append(&mut out, "\\0");
        }
        else if (c < 32 || c == 127)
        {
            String::appendf(&mut out, "\\u{%x}", c);
        }
        else
        {
            String::push_ascii(&mut out, c);
        }
    }
    String::append(&mut out, "\"");
    out
}

fn array_literal_lint(ref<Body, exclusive> b, ref<Type, shared> want, ref<Expr, shared> e, ref<Expr, shared> base, Mode m, bool slice_wanted, str mode)
{
    if (slice_wanted && m == Mode::Shared && literal_tree(base) && !has_unresolved_marker(want))
    {
        Vec::push(&mut b.facts.retired_notes, RetiredNote { .line = e.line, .col = e.col, .text = "warning[diag.slice-of-whole]: an array literal of literals (`b\"…\"` is one) is the slice where a shared slice is declared (`[Coerce-Slice-Literal]`, D-0314): write it without `&` and `[0..$]`" });
    }
    else if (slice_wanted)
    {
        Vec::push(&mut b.facts.retired_notes, RetiredNote { .line = e.line, .col = e.col, .text = sprintf(
            "warning[diag.slice-of-whole]: `&%s[…][0..$]` is the whole of the array, which `&%s[…]` is where a slice is declared (`[Coerce-Slice]`, D-0312): write it without `[0..$]`",
            mode,
            mode,
        ) });
    }
}

// An array or a `Vec`: what `[Coerce-Slice]` slices.
fn lint_seq(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TArray(_)  : true,
        Type::TNamed(nb) : Box::get(nb).name == "std::Vec",
        _                : false,
    }
}

// An argument as the program spells it, for a message: a place, `&` or
// `&mut` of one, a literal; `…` for anything else.
fn arg_text(ref<Expr, shared> e) : String
{
    match (&e.kind)
    {
        ExprKind::EBorrow(bb) :
        {
            ref<BorrowExpr, shared> br = Box::get(bb);
            match (place_text(&br.e))
            {
                Some(t) : sprintf("%s%s", if (br.mode == Mode::Exclusive) { "&mut " } else { "&" }, &t),
                None    : "…",
            }
        },
        ExprKind::EInt(lb)    : sprintf("%v", Box::get(lb).v),
        _ : match (place_text(e))
        {
            Some(t) : t,
            None    : "…",
        },
    }
}

fn is_void_ty(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TVoid : true,
        _           : false,
    }
}

// Whether `t` is an integer type.
fn is_int_ty(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TInt(_) : true,
        _             : false,
    }
}

// A place as the program spells it, for a message: a name, a field, an
// element by a name or a literal, `*r`; `None` for anything else.
fn place_text(ref<Expr, shared> e) : Option<String>
{
    match (&e.kind)
    {
        ExprKind::EParen(x) : match (place_text(Box::get(x)))
        {
            Some(t) : Some(sprintf("(%s)", &t)),
            None    : None,
        },
        ExprKind::EPath(pb)  :
        {
            ref<PathExpr, shared> pth = Box::get(pb);
            if (Vec::len(&pth.targs) != 0)
            {
                return None;
            }
            if (Vec::len(&pth.segs) == 1)
            {
                return Some(String::copy(shown_name(&pth.segs[0])));
            }
            Some(String::join(&pth.segs, "::"))
        },
        ExprKind::EField(fb) : match (place_text(&Box::get(fb).e))
        {
            Some(t) : Some(sprintf("%s.%s", &t, &Box::get(fb).name)),
            None    : None,
        },
        ExprKind::EIndex(ib) :
        {
            ref<PairExpr, shared> pr = Box::get(ib);
            String idx = match (&pr.b.kind)
            {
                ExprKind::EInt(lb) : sprintf("%v", Box::get(lb).v),
                _                  : place_text(&pr.b)?,
            };
            match (place_text(&pr.a))
            {
                Some(t) : Some(sprintf("%s[%s]", &t, &idx)),
                None    : None,
            }
        },
        ExprKind::EDeref(x) : match (place_text(Box::get(x)))
        {
            Some(t) : Some(sprintf("*%s", &t)),
            None    : None,
        },
        _                    : None,
    }
}

fn is_shared_string_ref(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(rb) :
        {
            ref<ModedTy, shared> m = Box::get(rb);
            m.mode == Mode::Shared && match (&m.inner)
            {
                Type::TNamed(nb) : Box::get(nb).name == "std::String" && Vec::len(&Box::get(nb).args) == 0,
                _                : false,
            }
        },
        _              : false,
    }
}

fn is_shared_ref_to_view(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(m) : Box::get(m).mode == Mode::Shared && plain_named_ty(&Box::get(m).inner, "std::StringView"),
        _             : false,
    }
}

fn matches_str(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TStr : true,
        _          : false,
    }
}

// `t` is the named type `n` with no type arguments.
fn plain_named_ty(ref<Type, shared> t, str n) : bool
{
    match (t)
    {
        Type::TNamed(nb) : Box::get(nb).name == n && Vec::len(&Box::get(nb).args) == 0,
        _                : false,
    }
}

// D-0312 `[Coerce-Text]` (spec/12; the pass's `coerce_text`): `e0`, of type
// `got`, at a position whose expected type is `want`. A literal where
// `String` is declared is the `String` of its bytes (D-0162's rewrite); a
// literal or a `str` value where `StringView` is declared is a view of
// static text; `&s` of a `String` place, or a place of type
// `ref<String, shared>`, there is `&s[0..$]` (`&(*r)[0..$]`). Nothing else.
fn coerce_text(ref<Body, exclusive> b, ref<Items, shared> it, ref<Type, shared> want, ref<Type, shared> got, ref<Expr, shared> e0) : bool
{
    if (b.facts.silent || has_unresolved_marker(want) || has_unresolved_marker(got))
    {
        return false;
    }
    ref<Expr, shared> e = strip_parens_tc(e0);
    bool literal = match (&e.kind)
    {
        ExprKind::EStr(_) : true,
        _                 : false,
    };
    if (plain_named_ty(want, "std::String"))
    {
        if (matches_str(got) && literal)
        {
            note_literal_as_string(b, e, true);
            return true;
        }
        return false;
    }
    if (plain_named_ty(want, "std::StringView"))
    {
        Option<Rewrite> r = None;
        if (matches_str(got))
        {
            r = Some(if (literal) { Rewrite::LiteralView } else { Rewrite::StrValueView });
        }
        else if (is_string_ref_any(got))
        {
            // An exclusive reference's text too: a view only reads it. A
            // reference a binding, a field or a call gives: `&(*r)[0..$]`.
            r = match (&e.kind)
            {
                ExprKind::EBorrow(bb) : if (Box::get(bb).mode == Mode::Shared && is_shared_string_ref(got)) { Some(Rewrite::RefStringView) } else { None },
                _                     : Some(Rewrite::RefPlaceView),
            };
        }
        match (r)
        {
            Some(rw) :
            {
                note_rewrite(b, e, rw);
                return true;
            },
            None     : return false,
        }
    }
    // D-0312 `[Coerce-Slice]`: a `Vec<T>` or `array<T, N>` where a
    // `slice<T, m>` is declared: `&v` (`&mut v`) is `&v[0..$]` (`&mut
    // v[0..$]`), and a reference to one that the mode permits is
    // `&(*e)[0..$]`.
    match (want)
    {
        Type::TSlice(ws) :
        {
            ref<ModedTy, shared> w = Box::get(ws);
            match (got)
            {
                Type::TRef(gr)   :
                {
                    ref<ModedTy, shared> g = Box::get(gr);
                    bool fits = match (seq_elem(&g.inner))
                    {
                        Some(x) : type_eq(&x, &w.inner),
                        None    : false,
                    };
                    if (!fits || (w.mode == Mode::Exclusive && g.mode != Mode::Exclusive))
                    {
                        return false;
                    }
                    bool exclusive = w.mode == Mode::Exclusive;
                    Option<Rewrite> r = match (&e.kind)
                    {
                        // `&K` of a constant is `&(*&K)[0..$]` (`[Ref-Form-Const-Place]`).
                        ExprKind::EBorrow(bb) :
                        {
                            if (!exclusive && Box::get(bb).mode == Mode::Shared && const_call(it, &Box::get(bb).e))
                            {
                                Some(Rewrite::SeqPlaceSlice(exclusive))
                            }
                            else if (Box::get(bb).mode == w.mode)
                            {
                                Some(Rewrite::SeqSlice(exclusive))
                            }
                            else
                            {
                                None
                            }
                        },
                        _                     : Some(Rewrite::SeqPlaceSlice(exclusive)),
                    };
                    match (r)
                    {
                        Some(rw) :
                        {
                            note_rewrite(b, e, rw);
                            return true;
                        },
                        None     : return false,
                    }
                },
                // D-0314 `[Coerce-Slice-Literal]`: an array literal written out
                // as literals (`b"…"` is one) where a `slice<T, shared>` is
                // declared is `&K[0..$]` of an unnamed constant `K` of its value:
                // one object with program extent (`[Ref-Form-Const]`).
                Type::TArray(ga) :
                {
                    bool is_lit = match (&e.kind)
                    {
                        ExprKind::EArrayLit(_)    : true,
                        ExprKind::EArrayRepeat(_) : true,
                        _                         : false,
                    };
                    if (w.mode == Mode::Shared && is_lit && type_eq(&Box::get(ga).inner, &w.inner) && literal_tree(e) && Option::is_none(&plain_problem(b, it, &w.inner)))
                    {
                        note_rewrite(b, e, Rewrite::SliceLiteral);
                        note_slice_literal(b, e, clone(got));
                        return true;
                    }
                    return false;
                },
                _                : return false,
            }
        },
        _                :
        {},
    }
    false
}

fn note_slice_literal(ref<Body, exclusive> b, ref<Expr, shared> e, Type t)
{
    if (b.facts.silent)
    {
        return;
    }
    match (HashMap::get_mut(&mut b.facts.slice_literals, e.id))
    {
        Some(had) :
        {
            bool same = match (&had.t)
            {
                Some(x) : type_eq(x, &t),
                None    : false,
            };
            if (!same)
            {
                had.t = None;
            }
        },
        None      :
        {
            HashMap::insert(&mut b.facts.slice_literals, e.id, SliceLit { .t = Some(t), .line = e.line, .col = e.col });
        },
    }
}

// D-0314: the place of a `[Coerce-Slice-Literal]` node two instantiations of a
// generic body typed differently.
export fn slice_literal_disagreed(ref<Facts, shared> f) : Option<String>
{
    Option<TextAt> first = None;
    for (usize i = 0; i < HashMap::len(&f.slice_literals); i += 1)
    {
        ref<SliceLit, shared> l = HashMap::value_at(&f.slice_literals, i);
        if (Option::is_none(&l.t))
        {
            bool earlier = match (&first)
            {
                Some(a) : l.line < a.line || (l.line == a.line && l.col < a.col),
                None    : true,
            };
            if (earlier)
            {
                first = Some(TextAt { .line = l.line, .col = l.col });
            }
        }
    }
    match (first)
    {
        Some(a) : Some(sprintf(
            "diag.type-mismatch\u{1}this array literal is a slice of one element type in one instantiation of the generic function around it and of another in another (`[Coerce-Slice-Literal]`); bind the array first (`array<T, N> a = […];`) and borrow it, `&a`%s",
            &diag_at(a.line, a.col),
        )),
        None : None,
    }
}

// The element type of a `Vec<T>` or an `array<T, N>`.
fn seq_elem(ref<Type, shared> t) : Option<Type>
{
    match (t)
    {
        Type::TNamed(n) : if (Box::get(n).name == "std::Vec" && Vec::len(&Box::get(n).args) == 1) { Some(clone(&Box::get(n).args[0])) } else { None },
        Type::TArray(a) : Some(clone(&Box::get(a).inner)),
        _               : None,
    }
}

// `ref<String, m>`, either mode.
fn is_string_ref_any(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(m) : plain_named_ty(&Box::get(m).inner, "std::String"),
        _             : false,
    }
}

// D-0312: text an instantiation of a generic body left as it is.
fn note_unrewritten(ref<Body, exclusive> b, ref<Expr, shared> e0)
{
    if (b.facts.silent)
    {
        return;
    }
    ref<Expr, shared> e = strip_parens_tc(e0);
    HashMap::insert(&mut b.facts.unrewritten, e.id, TextAt { .line = e.line, .col = e.col });
}

// D-0312: where some node `[Coerce-Text]` rewrote in one instantiation of a
// generic body was left as it is in another: its place (the first by line,
// then column), as `diag_at` writes it.
export fn rewrite_disagreed(ref<Facts, shared> f) : Option<String>
{
    Option<TextAt> best = None;
    for (usize i = 0; i < HashMap::len(&f.rewrites); i += 1)
    {
        ref<usize, shared> id = HashMap::key_at(&f.rewrites, i);
        bool text = match (HashMap::value_at(&f.rewrites, i))
        {
            Rewrite::LiteralView      : true,
            Rewrite::StrValueView     : true,
            Rewrite::RefStringView    : true,
            Rewrite::RefPlaceView     : true,
            Rewrite::SeqSlice(_)      : true,
            Rewrite::SeqPlaceSlice(_) : true,
            _                         : false,
        };
        if (!text)
        {
            continue;
        }
        match (HashMap::get(&f.unrewritten, *id))
        {
            Some(at) :
            {
                bool better = match (&best)
                {
                    Some(x) : at.line < x.line || (at.line == x.line && at.col < x.col),
                    None    : true,
                };
                if (better)
                {
                    best = Some(TextAt { .line = at.line, .col = at.col });
                }
            },
            None     : {},
        }
    }
    match (best)
    {
        Some(at) : Some(diag_at(at.line, at.col)),
        None     : None,
    }
}

// D-0322: an integer, a float or a `bool`, whose value an `assert` shows.
fn is_scalar_opt(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(Type::TInt(_)) : true,
        Some(Type::TF32)    : true,
        Some(Type::TF64)    : true,
        Some(Type::TBool)   : true,
        _                   : false,
    }
}

// D-0322: the comparison that is the whole condition of an `assert` as
// `modres` rewrote it, `if (!(a OP b)) { $assert_fail(…); }`: its id.
fn assert_comparison(ref<Expr, shared> c, ref<Block, shared> t) : Option<usize>
{
    ref<UnaryExpr, shared> u = match (&c.kind)
    {
        ExprKind::EUnary(ub) : Box::get(ub),
        _                    : return None,
    };
    if (u.op != UnOp::Not)
    {
        return None;
    }
    ref<Expr, shared> cmp = match (&u.e.kind)
    {
        ExprKind::EParen(pb) : Box::get(pb),
        _                    : return None,
    };
    BinOp op = match (&cmp.kind)
    {
        ExprKind::EBinary(bx) : Box::get(bx).op,
        _                     : return None,
    };
    if (!is_cmp_op(op) || Option::is_some(&t.tail) || Vec::len(&t.stmts) != 1)
    {
        return None;
    }
    ref<Expr, shared> call = match (&t.stmts[0])
    {
        Stmt::SExpr(xb) : Box::get(xb),
        _               : return None,
    };
    ref<CallExpr, shared> cx = match (&call.kind)
    {
        ExprKind::ECall(cb) : Box::get(cb),
        _                   : return None,
    };
    match (&cx.callee.kind)
    {
        ExprKind::EPath(pb) :
        {
            ref<PathExpr, shared> p = Box::get(pb);
            if (Vec::len(&p.segs) == 1 && p.segs[0] == "$assert_fail")
            {
                return Some(cmp.id);
            }
            None
        },
        _                   : None,
    }
}

fn note_rewrite(ref<Body, exclusive> b, ref<Expr, shared> e, Rewrite r)
{
    if (b.facts.silent)
    {
        return;
    }
    HashMap::insert(&mut b.facts.rewrites, e.id, r);
}

// D-0304: the text literals `e` gives (itself, or the tails of the blocks,
// `if` branches and `match` arms it is, D-0155) in a position whose type is
// `want`, `String` or `StringView`: each is recorded for the rewrite and
// the program is checked again, so the value is taken as `want`. False
// when `e` gives no literal, or the type is neither.
fn literal_in_position(ref<Body, exclusive> b, ref<Type, shared> want, ref<Expr, shared> e) : bool
{
    bool owned = named_is(want, "std::String") && Vec::len(&named_args(want)) == 0;
    bool view = named_is(want, "std::StringView") && Vec::len(&named_args(want)) == 0;
    if (!(owned || view) || b.facts.silent)
    {
        return false;
    }
    note_literal_tails(b, e, owned)
}

fn note_literal_tails(ref<Body, exclusive> b, ref<Expr, shared> e, bool owned) : bool
{
    match (&e.kind)
    {
        ExprKind::EParen(x) : note_literal_tails(b, Box::get(x), owned),
        ExprKind::EStr(_)   :
        {
            if (owned)
            {
                note_literal_as_string(b, e, true);
            }
            else
            {
                note_rewrite(b, e, Rewrite::LiteralView);
            }
            true
        },
        ExprKind::EBlock(bl) : match (&bl.tail)
        {
            Some(t) : note_literal_tails(b, Box::get(t), owned),
            None    : false,
        },
        ExprKind::EUnsafe(bl) : match (&bl.tail)
        {
            Some(t) : note_literal_tails(b, Box::get(t), owned),
            None    : false,
        },
        ExprKind::EIf(x)    :
        {
            ref<IfExpr, shared> i = Box::get(x);
            bool found = match (&i.then_.tail)
            {
                Some(t) : note_literal_tails(b, Box::get(t), owned),
                None    : false,
            };
            match (&i.else_)
            {
                Some(el) :
                {
                    if (note_literal_tails(b, el, owned))
                    {
                        found = true;
                    }
                },
                None     : {},
            }
            found
        },
        ExprKind::EMatch(x) :
        {
            bool found = false;
            foreach (a in &Box::get(x).arms)
            {
                if (note_literal_tails(b, Box::get(&a.body), owned))
                {
                    found = true;
                }
            }
            found
        },
        _                   : false,
    }
}

fn note_literal_as_string(ref<Body, exclusive> b, ref<Expr, shared> e, bool as_string)
{
    if (b.facts.silent)
    {
        return;
    }
    ref<Expr, shared> x = strip_parens_tc(e);
    if (as_string)
    {
        HashSet::insert(&mut b.facts.literal_yes, x.id);
    }
    else
    {
        HashSet::insert(&mut b.facts.literal_no, x.id);
    }
}

fn is_float_type(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TF32 : true,
        Type::TF64 : true,
        _          : false,
    }
}

// What to write when a value of type `got` stands where `want` is
// required: the conversion, borrow or constructor that gives one.
// CHG-0452: whether `o` is `Option<t>`.
fn option_of_ty(ref<Type, shared> o, ref<Type, shared> t) : bool
{
    match (o)
    {
        Type::TNamed(nb) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            n.name == "std::Option" && Vec::len(&n.args) == 1 && type_eq(&n.args[0], t)
        },
        _                : false,
    }
}

// CHG-0452: whether `r` is a reference to `t`.
fn ref_of_ty(ref<Type, shared> r, ref<Type, shared> t) : bool
{
    match (r)
    {
        Type::TRef(rb) : type_eq(&Box::get(rb).inner, t),
        _              : false,
    }
}

// The program's own text of `e` when it is a name or a number literal
// (bugs 069, 124, 130), for a hint to show the form to write.
fn simple_text(ref<Expr, shared> e) : Option<String>
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EPath(pb) :
        {
            if (Vec::len(&Box::get(pb).segs) == 1) { Some(String::copy(shown_name(&Box::get(pb).segs[0]))) } else { None }
        },
        ExprKind::EInt(ib)  : Some(sprintf("%v", Box::get(ib).v)),
        _                   : None,
    }
}

fn int_literal_text(ref<Expr, shared> e) : Option<String>
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EInt(ib) : if (Option::is_none(&Box::get(ib).sfx)) { Some(sprintf("%v", Box::get(ib).v)) } else { None },
        _                  : None,
    }
}

// CHG-0452: what makes two operands of an arithmetic operator one type: an
// `Option`'s value, a reference's, or a conversion; bugs 069, 124 and 130:
// the conversion that fits, by the operands' names.
fn operand_hint(ref<Type, shared> a, ref<Type, shared> b, ref<Expr, shared> ea, ref<Expr, shared> eb) : String
{
    if (option_of_ty(a, b) || option_of_ty(b, a))
    {
        return "one is an `Option`, a value that may be absent: take its value with `Option::unwrap(x)` (a fault when it is `None`), `Option::unwrap_or(x, d)`, or `match`";
    }
    if (ref_of_ty(a, b) || ref_of_ty(b, a))
    {
        ref<Expr, shared> r = if (ref_of_ty(a, b)) { ea } else { eb };
        return match (simple_text(r))
        {
            Some(n) : sprintf("`%s` is a reference: its value is `*%s` (and `*%s += 1` changes what it refers to)", &n, &n, &n),
            None    : "one is a reference: its value is `*` of it",
        };
    }
    bool af = is_float_type(a);
    bool bf = is_float_type(b);
    // Bug 124: an integer literal in float arithmetic.
    if (af != bf)
    {
        ref<Expr, shared> ie = if (af) { eb } else { ea };
        ref<Type, shared> ft = if (af) { a } else { b };
        match (int_literal_text(ie))
        {
            Some(t) : return sprintf("write the literal as a float: `%s.0`", &t),
            None    : {},
        }
        return match (simple_text(ie))
        {
            Some(n) : sprintf("convert the integer: `to_float<%s>(%s)`", &type_display(ft), &n),
            None    : sprintf("convert the integer with `to_float<%s>(…)`", &type_display(ft)),
        };
    }
    // Bug 069: two integer types; the conversion that keeps every value.
    match (a)
    {
        Type::TInt(ia) : match (b)
        {
            Type::TInt(ib) :
            {
                IntRange ra = int_range(*ia);
                IntRange rb = int_range(*ib);
                String na = Option::unwrap_or(simple_text(ea), "x");
                String nb = Option::unwrap_or(simple_text(eb), "y");
                if (ra.min <= rb.min && rb.max <= ra.max)
                {
                    return sprintf("convert one: `widen<%v>(%s)` keeps every value", int_ty_name(*ia), &nb);
                }
                if (rb.min <= ra.min && ra.max <= rb.max)
                {
                    return sprintf("convert one: `widen<%v>(%s)` keeps every value", int_ty_name(*ib), &na);
                }
                return sprintf(
                    "convert one: `narrow<%v>(%s)` (checked: faults when the value does not fit) to compute in `%v`, or `narrow<%v>(%s)` to compute in `%v`",
                    int_ty_name(*ia),
                    &nb,
                    int_ty_name(*ia),
                    int_ty_name(*ib),
                    &na,
                    int_ty_name(*ib),
                );
            },
            _              : {},
        },
        _ : {},
    }
    "convert one (`widen`, `narrow`, `to_float`)"
}

// A one-segment path's shown name.
fn simple_name(ref<Expr, shared> e) : Option<String>
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EPath(pb) :
        {
            if (Vec::len(&Box::get(pb).segs) == 1) { Some(String::copy(shown_name(&Box::get(pb).segs[0]))) } else { None }
        },
        _                   : None,
    }
}

// Bug 297: the literal itself with a point.
fn float_literal_hint(Option<ref<Expr, shared>> e) : String
{
    String lit = match (e)
    {
        Some(ex) : Option::unwrap_or(int_literal_text(ex), "3"),
        None     : "3",
    };
    sprintf("; an integer literal is not a float -- write it with a point (`%s.0`)", &lit)
}

// Bug 245: `a * b` (or `+`, `-`, `<<`) where a wider integer is wanted:
// the operands widened, since widening the result keeps the narrow
// arithmetic, which faults when the result does not fit.
fn widened_operands(Option<ref<Expr, shared>> e, str w) : Option<String>
{
    ref<Expr, shared> ex = match (e)
    {
        Some(x) : strip_parens_tc(x),
        None    : return None,
    };
    match (&ex.kind)
    {
        ExprKind::EBinary(bb) :
        {
            ref<BinaryExpr, shared> bin = Box::get(bb);
            if (bin.op != BinOp::Add && bin.op != BinOp::Sub && bin.op != BinOp::Mul)
            {
                return None;
            }
            String a = arg_text(&bin.a);
            String c = arg_text(&bin.b);
            Some(sprintf(
                "; convert the operands, `widen<%s>(%s) %s widen<%s>(%s)`: `widen<%s>(…)` of the result would keep the narrower arithmetic, which faults when the result does not fit",
                w,
                &a,
                op_symbol(bin.op),
                w,
                &c,
                w,
            ))
        },
        _                     : None,
    }
}

// Bug 063: the hint for an integer `/` (or `%`) where a float is wanted:
// convert the operands, since converting the quotient keeps its truncation.
fn int_division(Option<ref<Expr, shared>> e) : Option<String>
{
    match (e)
    {
        Some(ex) : match (&strip_parens_tc(ex).kind)
        {
            ExprKind::EBinary(bb) :
            {
                ref<BinaryExpr, shared> bin = Box::get(bb);
                if (bin.op != BinOp::Div && bin.op != BinOp::Rem)
                {
                    return None;
                }
                Option<String> l = int_literal_text(&bin.a);
                Option<String> r = int_literal_text(&bin.b);
                if (Option::is_some(&l) && Option::is_some(&r))
                {
                    return Some(sprintf(
                        "; this divides two integers, which drops the fraction: write the literals as floats, `%s.0 %s %s.0`",
                        &Option::unwrap(l),
                        if (bin.op == BinOp::Div) { "/" } else { "%" },
                        &Option::unwrap(r),
                    ));
                }
                String a = Option::unwrap_or(simple_text(&bin.a), "a");
                String c = Option::unwrap_or(simple_text(&bin.b), "b");
                Some(sprintf(
                    "; this divides two integers, which drops the fraction: convert the operands, `to_float<f64>(%s) %s to_float<f64>(%s)`",
                    &a,
                    if (bin.op == BinOp::Div) { "/" } else { "%" },
                    &c,
                ))
            },
            _                     : None,
        },
        None : None,
    }
}

fn conversion_hint(ref<Type, shared> want, ref<Type, shared> got, Option<ref<Expr, shared>> e) : String
{
    bool int_literal = match (e)
    {
        Some(x) : match (&strip_parens_tc(x).kind)
        {
            ExprKind::EInt(_) : true,
            _                 : false,
        },
        None : false,
    };
    // Bug 087: `&id` written where `id` itself is wanted.
    bool borrowed_name = match (e)
    {
        Some(ex) : match (&strip_parens_tc(ex).kind)
        {
            ExprKind::EBorrow(bb) : Option::is_some(&simple_name(&Box::get(bb).e)),
            _                     : false,
        },
        None : false,
    };
    // Bug 130: no name to show (a call's result): the hint names none.
    bool unnamed = match (e)
    {
        Some(ex) : Option::is_none(&simple_name(ex)) && !borrowed_name,
        None     : true,
    };
    String x = match (e)
    {
        Some(ex) : match (&strip_parens_tc(ex).kind)
        {
            ExprKind::EPath(pb) :
            {
                if (Vec::len(&Box::get(pb).segs) == 1) { String::copy(shown_name(&Box::get(pb).segs[0])) } else { "x" }
            },
            ExprKind::EBorrow(bb) : match (&strip_parens_tc(&Box::get(bb).e).kind)
            {
                ExprKind::EPath(pb) :
                {
                    if (Vec::len(&Box::get(pb).segs) == 1) { String::copy(shown_name(&Box::get(pb).segs[0])) } else { "x" }
                },
                _                   : "x",
            },
            _                   : "x",
        },
        None : "x",
    };
    // Bug 248: a plain value where an `Option` or a `Result` of it is
    // declared is wrapped, never converted.
    String wrapped = if (unnamed && !borrowed_name)
    {
        match (e)
        {
            Some(ex) : arg_text(ex),
            None     : "…",
        }
    }
    else { String::clone(&x) };
    Vec<Type> want_args = if (is_void_ty(got)) { Vec::new() } else { named_args(want) };
    if (named_is(want, "std::Option") && Vec::len(&want_args) == 1 && type_eq(&want_args[0], got))
    {
        return sprintf("; an `Option` holds its value in `Some`: wrap it, `Some(%s)`", &wrapped);
    }
    if (named_is(want, "std::Result") && Vec::len(&want_args) == 2)
    {
        bool as_ok = type_eq(&want_args[0], got);
        bool as_err = type_eq(&want_args[1], got);
        if (as_ok && as_err)
        {
            return sprintf("; a `Result` holds its value in `Ok` or its error in `Err`: wrap it, `Ok(%s)` or `Err(%s)`", &wrapped, &wrapped);
        }
        if (as_ok)
        {
            return sprintf("; a `Result` holds its value in `Ok`: wrap it, `Ok(%s)`", &wrapped);
        }
        if (as_err)
        {
            return sprintf("; a `Result` holds its error in `Err`: wrap it, `Err(%s)`", &wrapped);
        }
    }
    match (want)
    {
        Type::TInt(w) : match (got)
        {
            Type::TInt(g) :
            {
                IntRange wr = int_range(*w);
                IntRange gr = int_range(*g);
                if (wr.min <= gr.min && gr.max <= wr.max)
                {
                    // Bug 245: widening a sum or product keeps its narrow
                    // arithmetic, which faults first; widen the operands.
                    match (widened_operands(e, int_ty_name(*w)))
                    {
                        Some(h) : return h,
                        None    : {},
                    }
                    return sprintf("; convert it: `widen<%s>(…)`", int_ty_name(*w));
                }
                return sprintf(
                    "; convert it: `narrow<%s>(…)` (checked: faults when the value does not fit) or `narrow_wrapping<%s>(…)`",
                    int_ty_name(*w),
                    int_ty_name(*w),
                );
            },
            Type::TF32 : return sprintf(
                "; convert it with `to_int<%s>(…)`, which drops the fraction (toward zero, checked)",
                &type_display(want),
            ),
            Type::TF64 : return sprintf(
                "; convert it with `to_int<%s>(…)`, which drops the fraction (toward zero, checked)",
                &type_display(want),
            ),
            _             : {},
        },
        Type::TF32 : match (got)
        {
            Type::TInt(_) : return if (int_literal) { float_literal_hint(e) } else if (Option::is_some(&int_division(e)))
            {
                Option::unwrap(int_division(e))
            }
            else
            {
                sprintf(
                    "; convert it with `to_float<%s>(…)`",
                    &type_display(want),
                )
            },
            Type::TF64 : return sprintf("; convert it with `to_float<%s>(…)`", &type_display(want)),
            _          : {},
        },
        Type::TF64 : match (got)
        {
            Type::TInt(_) : return if (int_literal) { float_literal_hint(e) } else if (Option::is_some(&int_division(e)))
            {
                Option::unwrap(int_division(e))
            }
            else
            {
                sprintf(
                    "; convert it with `to_float<%s>(…)`",
                    &type_display(want),
                )
            },
            Type::TF32 : return sprintf("; convert it with `to_float<%s>(…)`", &type_display(want)),
            _          : {},
        },
        Type::TBool : match (got)
        {
            Type::TInt(_) : return "; a number is not a `bool` -- compare it (`x != 0`)",
            _             : {},
        },
        _ : {},
    }
    match (want)
    {
        Type::TNamed(nb) :
        {
            ref<String, shared> n = &Box::get(nb).name;
            match (got)
            {
                Type::TStr     :
                {
                    if (*n == "std::String")
                    {
                        return "; a `str` value becomes a `String` with `String::copy(…)` (a literal is one already where a `String` is declared, D-0149)";
                    }
                    if (*n == "std::StringView")
                    {
                        // D-0312: a `str` is a view where a `StringView` is declared;
                        // this position's type is a type parameter, which the rule
                        // does not reach.
                        String shown = match (e)
                        {
                            Some(ex) : match (&strip_parens_tc(ex).kind)
                            {
                                ExprKind::EStr(lit) : rust_debug_text(lit),
                                _                   : String::clone(&x),
                            },
                            None : String::clone(&x),
                        };
                        return sprintf(
                            "; a `str` is a view where a `StringView` is declared (`[Coerce-Text]`), but this position's type is a type parameter, which the rule does not reach: write `StringView::of(%s)`",
                            &shown,
                        );
                    }
                },
                Type::TRef(rb) :
                {
                    // D-0302: a view is shared; `&s` is one where a `StringView` is declared.
                    if (*n == "std::StringView" && named_is(&Box::get(rb).inner, "std::String") && Box::get(
                        rb,
                    ).mode == Mode::Exclusive)
                    {
                        return sprintf("; a view only reads the text: pass `&%s` (D-0302)", &x);
                    }
                    if (*n == "std::StringView" && named_is(&Box::get(rb).inner, "std::String"))
                    {
                        return sprintf(
                            "; a `ref<String, shared>` is the text's view where a `StringView` is declared (`[Coerce-Text]`), but this position's type is a type parameter, which the rule does not reach: write `&(*%s)[0..$]`",
                            &x,
                        );
                    }
                },
                _              : {},
            }
        },
        Type::TRef(rb)   :
        {
            ref<ModedTy, shared> r = Box::get(rb);
            if (type_eq(&r.inner, got))
            {
                return sprintf(
                    "; pass a reference: `%s%s`",
                    if (r.mode == Mode::Exclusive) { "&mut " } else { "&" },
                    &x,
                );
            }
            // D-0312: a literal, a `str` or a view where a `String` reference is declared.
            if (plain_named_ty(&r.inner, "std::String") && (matches_str(got) || plain_named_ty(got, "std::StringView")))
            {
                return "; a literal, a `str` or a view is no reference to a `String`: declare `str` for a constant or `StringView` for any text, or make a `String` to refer to (`String::copy(…)`)";
            }
            match (got)
            {
                Type::TRef(gb) :
                {
                    if (r.mode == Mode::Exclusive && Box::get(gb).mode == Mode::Shared && type_eq(
                        &r.inner,
                        &Box::get(gb).inner,
                    ))
                    {
                        return sprintf("; the parameter writes through it -- pass `&mut %s`", &x);
                    }
                },
                _              : {},
            }
        },
        _                : {},
    }
    // D-0312: text that `[Coerce-Text]` does not make fit, and what does.
    match (got)
    {
        Type::TRef(gb)  :
        {
            ref<ModedTy, shared> g = Box::get(gb);
            if (is_any_text_ty(want) && plain_named_ty(&g.inner, "std::StringView"))
            {
                if (!borrowed_name && !unnamed)
                {
                    return sprintf("; `%s` is a reference to a `StringView` (a `foreach` binder is one): pass its value, `*%s`", &x, &x);
                }
                return sprintf("; a `StringView` is passed as it is, with no `&`: write `%s`", &x);
            }
            // CHG-0452: a `Box`'s value is reached by a call.
            match (want)
            {
                Type::TRef(wb) :
                {
                    ref<ModedTy, shared> w = Box::get(wb);
                    bool boxed = match (box_payload(&g.inner))
                    {
                        Some(t) : type_eq(&t, &w.inner),
                        None    : false,
                    };
                    if (boxed)
                    {
                        bool excl = w.mode == Mode::Exclusive;
                        StringView call = if (excl) { "get_mut" } else { "get" };
                        bool borrowed = match (e)
                        {
                            Some(ex) : match (&strip_parens_tc(ex).kind)
                            {
                                ExprKind::EBorrow(_) : true,
                                _                    : false,
                            },
                            None : false,
                        };
                        if (borrowed)
                        {
                            return sprintf(
                                "; a `Box`'s value is reached by a call: `Box::%s(%s%s)`",
                                call,
                                if (excl) { "&mut " } else { "&" },
                                &x,
                            );
                        }
                        return sprintf(
                            "; a `Box`'s value is reached by a call: `Box::%s(%s)`, and a match binder can bind through the box, `V(*%s)`",
                            call,
                            &x,
                            &x,
                        );
                    }
                },
                _              : {},
            }
            bool ref_ref = match (&g.inner)
            {
                Type::TRef(_) : true,
                _             : false,
            };
            if (ref_ref)
            {
                return sprintf("; `%s` is already a reference: write `%s`, with no `&`", &x, &x);
            }
            // CHG-0452: a reference where its value is wanted.
            bool named_want = match (want)
            {
                Type::TNamed(_) : true,
                _               : false,
            };
            if (!named_want && type_eq(&g.inner, want))
            {
                if (borrowed_name)
                {
                    return sprintf("; pass the value itself: `%s`, without `&`", &x);
                }
                // Bug 295: `&e.hour`, a field lent where its value is wanted.
                match (e)
                {
                    Some(ex) : match (&strip_parens_tc(ex).kind)
                    {
                        ExprKind::EBorrow(bb) : match (place_text(&Box::get(bb).e))
                        {
                            Some(t) : return sprintf("; pass the value itself: `%s`, without `&`", &t),
                            None    : {},
                        },
                        _ : {},
                    },
                    None : {},
                }
                if (unnamed)
                {
                    return "; this is a reference to one: write `*` before it for its value (`*f(…)`)";
                }
                return sprintf("; `%s` is a reference to one: its value is `*%s`", &x, &x);
            }
            if (plain_named_ty(want, "std::String") && plain_named_ty(&g.inner, "std::String"))
            {
                return "; a copy of the text is `String::clone(…)`";
            }
        },
        Type::TNamed(_) :
        {
            // CHG-0452: a `Box` where a reference to its value is declared.
            match (want)
            {
                Type::TRef(wb) :
                {
                    ref<ModedTy, shared> w = Box::get(wb);
                    bool boxed = match (box_payload(got))
                    {
                        Some(t) : type_eq(&t, &w.inner),
                        None    : false,
                    };
                    if (boxed)
                    {
                        bool excl = w.mode == Mode::Exclusive;
                        return sprintf(
                            "; a `Box`'s value is reached by a call: `Box::%s(%s%s)`",
                            if (excl) { "get_mut" } else { "get" },
                            if (excl) { "&mut " } else { "&" },
                            &x,
                        );
                    }
                },
                _              : {},
            }
        },
        _               : {},
    }
    // Bug 261: an array literal where a `Vec` is declared.
    match (got)
    {
        Type::TArray(ab) :
        {
            if (named_is(want, "std::Vec") && Vec::len(&named_args(want)) == 1)
            {
                Vec<Type> wa = named_args(want);
                if (type_eq(&Box::get(ab).inner, &wa[0]))
                {
                    return "; a `Vec` is made from an array's elements by `Vec::from_slice(&[…])`";
                }
                if (plain_named_ty(&wa[0], "std::String"))
                {
                    return "; a `Vec<String>` is made empty, `Vec::new()`, and filled by `Vec::push(&mut v, \"…\")` (a literal is the `String` there)";
                }
            }
        },
        _                : {},
    }
    // Bug 193: an array or a `Vec` passed by name where a slice is wanted.
    match (want)
    {
        Type::TSlice(sb) :
        {
            bool exclusive = Box::get(sb).mode == Mode::Exclusive;
            bool holds = match (got)
            {
                Type::TArray(ab) : type_eq(&Box::get(ab).inner, &Box::get(sb).inner),
                Type::TNamed(nb) : Box::get(nb).name == "std::Vec" && Vec::len(&Box::get(nb).args) == 1 && type_eq(&Box::get(nb).args[0], &Box::get(sb).inner),
                _                : false,
            };
            if (holds)
            {
                return sprintf("; lend it: `%s%s`", if (exclusive) { "&mut " } else { "&" }, &x);
            }
            // Bug 071: `&[]`, an empty literal, has no element to type it.
            bool empty_array = match (got)
            {
                Type::TRef(gb) : match (&Box::get(gb).inner)
                {
                    Type::TArray(ab) : Box::get(ab).n == 0,
                    _                : false,
                },
                _ : false,
            };
            if (empty_array)
            {
                String elem = type_display(&Box::get(sb).inner);
                return sprintf(
                    "; an array literal's type comes from its elements, so `[]` here is an `array<i32, 0>`: for an empty `%s`, declare `array<%s, 0> none = [];` and pass `&none`",
                    &type_display(want),
                    &elem,
                );
            }
        },
        _                : {},
    }
    if (plain_named_ty(want, "std::String") && plain_named_ty(got, "std::StringView"))
    {
        return sprintf("; a copy of the text is `String::copy(%s)`", &x);
    }
    if (plain_named_ty(want, "std::StringView") && plain_named_ty(got, "std::String"))
    {
        return sprintf("; view it: `&%s`", &x);
    }
    bool ref_owned = match (got)
    {
        Type::TRef(gb) : plain_named_ty(&Box::get(gb).inner, "std::String"),
        _              : false,
    };
    if (matches_str(want) && (is_any_text_ty(got) || ref_owned))
    {
        return "; a `str` is a literal's value, and nothing else becomes one: declare `StringView` to take any text";
    }
    match (want)
    {
        Type::TRef(wb) :
        {
            if (Box::get(wb).mode == Mode::Shared && plain_named_ty(&Box::get(wb).inner, "std::String") && plain_named_ty(got, "std::StringView"))
            {
                return sprintf(
                    "; a view has no `String` behind it to borrow: declare `StringView`, or copy it, `String::copy(%s)`",
                    &x,
                );
            }
        },
        _              : {},
    }
    String::new()
}

fn compare_hint(ref<Type, shared> a, ref<Type, shared> b) : String
{
    match (a)
    {
        Type::TInt(_) : match (b)
        {
            Type::TInt(_) : return "; convert one side first (`widen<T>(…)` or `narrow<T>(…)`) so both have one type",
            Type::TF32    : return "; convert one side first (`to_float<T>(…)` or `to_int<T>(…)`)",
            Type::TF64    : return "; convert one side first (`to_float<T>(…)` or `to_int<T>(…)`)",
            _             : {},
        },
        Type::TF32 : match (b)
        {
            Type::TInt(_) : return "; convert one side first (`to_float<T>(…)` or `to_int<T>(…)`)",
            _             : {},
        },
        Type::TF64 : match (b)
        {
            Type::TInt(_) : return "; convert one side first (`to_float<T>(…)` or `to_int<T>(…)`)",
            _             : {},
        },
        _ : {},
    }
    String::new()
}

fn slice_of_value_msg() : String
{
    named_diag(
        "diag.borrow-of-non-place",
        "`&e[lo .. hi]` slices a place (a binding, a field, an element, `*r`); `e` here is a value (a call's result or a literal), which can be sliced only as an argument of a call whose result is not a reference; elsewhere, bind it first, then slice the binding",
    )
}

fn is_spawn_call(ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::ECall(cb) : match (path_segs(&Box::get(cb).callee))
        {
            Some(segs) : Vec::len(segs) == 1 && segs[0] == "spawn",
            None       : false,
        },
        _ : false,
    }
}

fn is_bare_num_literal(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EInt(lb) : match (&Box::get(lb).sfx)
        {
            Some(s) : *s == "byte",
            None    : true,
        },
        ExprKind::EFloat(fb) : Option::is_none(&Box::get(fb).sfx),
        ExprKind::EUnary(u)  : Box::get(u).op == UnOp::Neg && is_bare_num_literal(&Box::get(u).e),
        ExprKind::EParen(x)  : is_bare_num_literal(Box::get(x)),
        _                    : false,
    }
}

fn mentions_any(ref<Type, shared> ty, ref<HashSet<String>, shared> names) : bool
{
    match (ty)
    {
        Type::TNamed(nb) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (Vec::len(&n.args) == 0 && HashSet::contains(names, &n.name))
            {
                return true;
            }
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                if (mentions_any(&n.args[i], names))
                {
                    return true;
                }
            }
            false
        },
        Type::TFn(fb)    :
        {
            ref<FnTy, shared> f = Box::get(fb);
            for (usize i = 0; i < Vec::len(&f.params); i += 1)
            {
                if (mentions_any(&f.params[i], names))
                {
                    return true;
                }
            }
            mentions_any(&f.ret, names)
        },
        _ : match (inner_of(ty))
        {
            Some(t) : mentions_any(&t, names),
            None    : false,
        },
    }
}

// ---- part 6 (`check_expr_inner`) ----

export struct ViewEq
{
    export bool view_left;
    export bool other_is_str;
    export bool negate;
}

export struct ViewLess
{
    export bool swap;
    export bool negate;
}

/// A `StringView` operation written with the language's own syntax
/// (D-0053).
export enum ViewOp
{
    SliceString,
    SliceView,
    VEq(ViewEq),
    TextCmp,
    VLess(ViewLess),
    KeyCmp,
}

fn temp_msg() : String
{
    named_diag(
        "diag.borrow-of-temporary",
        "this is part of a temporary (a call's result or a literal), which ends with the statement; bind the value first, then borrow from the binding",
    )
}

fn deref_to(Option<Type> t) : Option<Type>
{
    match (t)
    {
        Some(x) : Some(through_ref_or_guard(x)),
        None    : None,
    }
}

fn opt_is_ref(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(Type::TRef(_)) : true,
        _                   : false,
    }
}

fn check_expr_inner(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    bool in_place = replace(&mut b.place_pos, false);
    match (&e.kind)
    {
        ExprKind::EInt(lb)         :
        {
            ref<IntLit, shared> lit = Box::get(lb);
            // D-0090: a literal marked by the generic pass, at a
            // floating-point instantiation of its `number` parameter.
            if (Option::is_none(&lit.sfx) && is_float_opt(expected) && HashSet::contains(
                &b.facts.number_literals,
                e.id,
            ))
            {
                return Ok(clone(expected));
            }
            Option<Type> t = check_int_lit(b, lit.v, &lit.sfx, expected)?;
            match (&t)
            {
                Some(m) :
                {
                    if (is_marker(m))
                    {
                        HashSet::insert(&mut b.facts.number_literals, e.id);
                    }
                },
                None    : {},
            }
            Ok(t)
        },
        ExprKind::EFloat(fb)       :
        {
            ref<FloatLit, shared> lit = Box::get(fb);
            Type t = match (&lit.sfx)
            {
                Some(s) : if (*s == "f32") { Type::TF32 } else if (*s == "f64") { Type::TF64 } else { float_from_expected(expected) },
                None    : float_from_expected(expected),
            };
            // `[Literal-Out-Of-Range]`: a literal beyond the type's largest
            // finite magnitude.
            bool f32_ = match (&t)
            {
                Type::TF32 : true,
                _          : false,
            };
            f64 v = if (f32_) { widen<f64>(to_float<f32>(lit.v)) } else { lit.v };
            if (!is_finite(v) && !is_nan(v))
            {
                String msg = sprintf("this literal is beyond `%s`'s largest finite value", &type_display(&t));
                return Err(named_diag("diag.literal-out-of-range", &msg));
            }
            Ok(Some(t))
        },
        // `[T-Lit-Str]`: always `str`; takes no expected type.
        ExprKind::EStr(_)          : Ok(Some(Type::TStr)),
        ExprKind::EBool(_)         : Ok(Some(Type::TBool)),
        ExprKind::EUnit            : Ok(Some(Type::TVoid)),
        ExprKind::EParen(x)        :
        {
            // A parenthesized place is the same place.
            b.place_pos = in_place;
            check_expr(b, it, Box::get(x), expected)
        },
        ExprKind::EPath(pb)        :
        {
            ref<PathExpr, shared> p = Box::get(pb);
            String joined_name = String::join(&p.segs, "::");
            // D-0258: a static is never read or moved whole.
            if (!in_place && HashMap::contains(&it.statics, &joined_name))
            {
                String msg = sprintf(
                    "`%s` is a static: it is borrowed (`&%s`) and changed through its operations, never read or moved whole",
                    &joined_name,
                    &joined_name,
                );
                return Err(named_diag("diag.read-of-resource", &msg));
            }
            Option<Type> t = check_path(b, it, &p.segs)?;
            // A payload-less variant, typed or not, is checked against the
            // expected type by name first (its message names the variant).
            bool variant_typed = match (&t)
            {
                Some(Type::TNamed(_)) : HashMap::contains(&it.enum_of_variant, &p.segs[Vec::len(&p.segs) - 1]),
                _                     : false,
            };
            if ((Option::is_none(&t) || variant_typed) && !(Vec::len(&p.segs) == 1 && is_local(b, &p.segs[0])))
            {
                match (variant_enum(it, &p.segs))
                {
                    Some(en) : variant_fits_expected(b, it, &en, &p.segs, expected)?,
                    None     : {},
                }
            }
            if (Option::is_none(&t))
            {
                // `[T-Item-Generic]` (D-0093): a generic item as a value.
                t = generic_item_value(b, it, &p.segs, &p.targs, expected)?;
            }
            if (!in_place)
            {
                if (Vec::len(&p.segs) == 1 && !replace(&mut b.cur_arg_ref_param, false))
                {
                    tier_referent_reach(b, it, &p.segs[0], None);
                }
                flow_read(b, it, e)?;
            }
            Ok(t)
        },
        ExprKind::EUnary(ub)       : check_unary(b, it, Box::get(ub).op, &Box::get(ub).e, expected),
        ExprKind::EBinary(bb) : check_binary(
            b,
            it,
            Box::get(bb).op,
            &Box::get(bb).a,
            &Box::get(bb).b,
            e,
            expected,
        ),
        ExprKind::EBorrow(bb)      : check_borrow(b, it, e, Box::get(bb).mode, &Box::get(bb).e, expected),
        ExprKind::ESliceOf(sb)     :
        {
            ref<SliceExpr, shared> s = Box::get(sb);
            if (Option::is_some(&view_base(b, it, &s.base)))
            {
                return check_view_slice(b, it, e, s);
            }
            check_slice(b, it, e, s, expected)
        },
        ExprKind::EDollar          : Ok(Some(Type::TInt(IntTy::Usize))),
        ExprKind::EDeref(xb)       :
        {
            ref<Expr, shared> inner = Box::get(xb);
            // `*g` through a guard accesses the guarded value in place.
            bool through_guard = match (static_place_type(b, it, inner))
            {
                Some(Type::TGuard(_)) : true,
                _                     : false,
            };
            // CHG-0452: `*b` on a `Box` names the calls that reach its value
            // (before the read of `b`, which a resource refuses).
            Option<Type> boxed = match (static_place_type(b, it, inner))
            {
                Some(t) : box_payload(&t),
                None    : None,
            };
            match (boxed)
            {
                Some(t) :
                {
                    return Err(mismatch(sprintf(
                        "`*` does not read through a `Box<%s>`: its value is `Box::get(&b)` (`Box::get_mut(&mut b)` to change it), moved out it is `Box::into_inner(b)`, and in a pattern `V(*x)` binds through one",
                        &type_display(&t),
                    )));
                },
                None    : {},
            }
            if (through_guard)
            {
                b.place_pos = true;
                match (place_of(b, it, inner))
                {
                    Some(p) :
                    {
                        if (!tri_is(&b.flow.init, &p.root, Tri::T))
                        {
                            refute(b, &uninit_msg(&p.root))?;
                        }
                    },
                    None    : {},
                }
            }
            b.read_exempt = true;
            Option<Type> ti = check_expr(b, it, inner, &None)?;
            match (&ti)
            {
                Some(t) :
                {
                    if (is_marker(t))
                    {
                        return Err(unbounded_msg("`*` (dereference)"));
                    }
                },
                None    : {},
            }
            bool raw = match (&ti)
            {
                Some(Type::TRawptr(_)) : true,
                _                      : false,
            };
            if (raw && b.unsafe_depth == 0)
            {
                return Err("diag.trusted-outside-unsafe");
            }
            Option<Type> ty = match (ti)
            {
                Some(Type::TRef(rb))    : Some(ModedTy::take_inner(rb)),
                Some(Type::TGuard(gb))  : Some(Box::into_inner(gb)),
                Some(Type::TRawptr(pb)) : Some(Box::into_inner(pb)),
                // `*e` of a value that is no reference, guard or raw pointer.
                Some(t)                 :
                {
                    bool plain = match (&t)
                    {
                        Type::TInt(_)    : true,
                        Type::TF32       : true,
                        Type::TF64       : true,
                        Type::TBool      : true,
                        Type::TStr       : true,
                        Type::TArray(_)  : true,
                        Type::TSimd(_)   : true,
                        Type::THandle(_) : true,
                        Type::TMutex(_)  : true,
                        Type::TVoid      : true,
                        Type::TNamed(_)  : true,
                        _                : false,
                    };
                    if (!has_unresolved_marker(&t) && plain)
                    {
                        // Bug 261: `*HashMap::get(…)`, an `Option` of a
                        // reference, which may be `None`.
                        if (named_is(&t, "std::Option"))
                        {
                            return Err(mismatch(with_repair(
                                &sprintf(
                                    "`*` needs a reference, a guard or a raw pointer, but this is `%s`, which may be `None`: take the reference out first, `match (o) { Some(r) : *r, None : … }`, `if (Some(r) = o) { … }`, or `*Option::unwrap_or(o, &d)` with a default `d`",
                                    &type_display(&t),
                                ),
                                "",
                            )));
                        }
                        return Err(mismatch(sprintf(
                            "`*` needs a reference, a guard or a raw pointer, but this is `%s`",
                            &type_display(&t),
                        )));
                    }
                    None
                },
                None                    : None,
            };
            // `*r` read in value position is a `[Read]` of the place `*r`.
            if (!in_place)
            {
                flow_read(b, it, e)?;
            }
            Ok(ty)
        },
        ExprKind::EField(fb)       :
        {
            b.place_pos = true;
            Option<Type> t = check_field(b, it, &Box::get(fb).e, &Box::get(fb).name)?;
            if (!in_place)
            {
                flow_read(b, it, e)?;
            }
            Ok(t)
        },
        ExprKind::EIndex(ib)       : check_index(b, it, e, &Box::get(ib).a, &Box::get(ib).b, in_place),
        ExprKind::ECall(cb)        :
        {
            Option<Type> t = check_call(b, it, &Box::get(cb).callee, &Box::get(cb).args, expected)?;
            if (opt_is_ref(&t))
            {
                Option<Referent> r = referent_of(b, it, e);
                HashMap::insert(&mut b.borrow_referents, e.id, r);
            }
            Ok(t)
        },
        ExprKind::EStructLit(sb) : check_struct_lit(
            b,
            it,
            &Box::get(sb).segs,
            &Box::get(sb).targs,
            &Box::get(sb).fields,
            expected,
        ),
        ExprKind::EArrayLit(es)    : check_array_lit(b, it, es, expected),
        // `[v; N]` (D-0072): v is read once and copied into every element,
        // so its type is plain.
        ExprKind::EArrayRepeat(rb) : check_array_repeat(b, it, &Box::get(rb).value, Box::get(rb).n, expected),
        ExprKind::EAssign(pb)      : check_assign(b, it, &Box::get(pb).a, &Box::get(pb).b),
        ExprKind::EPropagate(x)    : check_propagate(b, it, Box::get(x), e.line),
        ExprKind::EBlock(blk)      : check_nested_block(b, it, blk, expected),
        ExprKind::EUnsafe(blk)     :
        {
            b.unsafe_depth += 1;
            Result<Option<Type>, String> r = check_nested_block(b, it, blk, expected);
            b.unsafe_depth -= 1;
            r
        },
        ExprKind::EIf(ib)          : check_if(b, it, e, Box::get(ib), expected),
        ExprKind::EWhile(wb)       :
        {
            ref<WhileExpr, shared> w = Box::get(wb);
            Option<ref<Expr, shared>> step = match (&w.step)
            {
                Some(s) : Some(s),
                None    : None,
            };
            check_while(b, it, &w.cond, &w.body, step)
        },
        ExprKind::EMatch(mb)       : check_match(b, it, e, &Box::get(mb).scrut, &Box::get(mb).arms, expected),
        ExprKind::EReturn(opt)     : check_return(b, it, opt, e.line),
        ExprKind::EBreak           : check_break(b, true),
        ExprKind::EContinue        : check_break(b, false),
        ExprKind::EClosure(cb)     :
        {
            ref<ClosureExpr, shared> c = Box::get(cb);
            Option<Type> t = check_closure(b, it, c.is_move, &c.captures, &c.params, &c.ret, &c.body, expected)?;
            // D-0073: the back end gives the body's value this result type.
            match (&t)
            {
                Some(ft) : match (ft)
                {
                    Type::TFn(_) :
                    {
                        if (!has_unresolved_marker(ft) && HashMap::len(&b.subst) == 0)
                        {
                            HashMap::insert(&mut b.facts.closure_types, e.id, clone(ft));
                        }
                    },
                    _            : {},
                },
                None : {},
            }
            Ok(t)
        },
    }
}

fn is_float_opt(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(Type::TF32) : true,
        Some(Type::TF64) : true,
        _                : false,
    }
}

fn float_from_expected(ref<Option<Type>, shared> expected) : Type
{
    match (expected)
    {
        Some(Type::TF32) : Type::TF32,
        _                : Type::TF64,
    }
}

// Report 307: a call of a generic function giving a `Vec` (`Vec::new()`),
// borrowed where a slice is expected: the slice's element type fixes it.
fn one_vec_arg(ref<Option<Type>, shared> t) : Option<Type>
{
    match (t)
    {
        Some(x) :
        {
            Vec<Type> args = named_args(x);
            if (named_is(x, "std::Vec") && Vec::len(&args) == 1) { Vec::pop(&mut args) } else { None }
        },
        None    : None,
    }
}

fn vec_of_one(Type t) : Vec<Type>
{
    Vec<Type> v = Vec::new();
    Vec::push(&mut v, t);
    v
}

fn is_generic_call_temp(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::ECall(cb) : match (resolve_fn_path(it, &Box::get(cb).callee))
        {
            Some(k) : match (HashMap::get(&it.fns, &k))
            {
                Some(f) :
                {
                    if (Vec::len(&f.type_params) != 1)
                    {
                        return false;
                    }
                    Vec<Type> ra = named_args(&f.ret);
                    Type tp = named(&f.type_params[0], Vec::new());
                    named_is(&f.ret, "std::Vec") && Vec::len(&ra) == 1 && type_eq(&ra[0], &tp)
                },
                None    : false,
            },
            None : false,
        },
        _ : false,
    }
}

fn check_borrow(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    Mode m,
    ref<Expr, shared> inner,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // Report 443 (D-0339): a function item is a value, not a place.
    match (path_segs(strip_parens_tc(inner)))
    {
        Some(segs) :
        {
            String n = String::join(segs, "::");
            bool item = !(Vec::len(segs) == 1 && is_local(b, &segs[0])) && match (HashMap::get(&it.fns, &n))
            {
                Some(f) : !f.is_const,
                None    : false,
            };
            if (item)
            {
                return Err(mismatch(sprintf(
                    "`%s` is a function, a value of a `fn(…)` type, not a place, so it is not borrowed: pass `%s` itself, and declare the parameter `fn(…) : …` rather than a reference to one",
                    &n,
                    &n,
                )));
            }
        },
        None       : {},
    }
    tier_elem_access(b, it, inner, m)?;
    tier_slice_reborrow(b, it, inner, m);
    // D-0289: through an exclusive reference to what holds a lending
    // thread's handle the handle can be moved out of this analysis' sight
    // (swapped into longer-lived data): only the `Vec` operations that
    // keep it here may have one.
    if (m == Mode::Exclusive && !replace(&mut b.handle_borrow_ok, false) && b.report && !b.flow.unreachable)
    {
        Option<String> holder_name = match (&strip_parens_tc(inner).kind)
        {
            ExprKind::EPath(_) : match (handle_holder_of(b, it, inner))
            {
                Some(hh) :
                {
                    HandleHolder { name, .. } = hh;
                    Some(name)
                },
                None     : None,
            },
            _ : None,
        };
        match (holder_name)
        {
            Some(n) :
            {
                String why = sprintf(
                    "line %v: `%s` is borrowed exclusively while it holds what its threads were lent",
                    b.current_line,
                    shown_name(&n),
                );
                rep_left(b, why);
            },
            None    : {},
        }
    }
    // D-0218: a closure called through a shared reference may not write
    // through what it captured; which closure a `fn` value is, the run
    // knows (D-0288).
    if (m == Mode::Shared && b.report && !b.flow.unreachable)
    {
        match (one_seg(strip_parens_tc(inner)))
        {
            Some(n) :
            {
                bool fnish = match (HashMap::get(&b.gamma, n))
                {
                    Some(Type::TFn(_))      : true,
                    Some(Type::TClosure(_)) : true,
                    _                       : false,
                };
                if (fnish)
                {
                    rep_left(
                        b,
                        sprintf(
                            "line %v: the `fn` value `%s` is reached through a shared reference, and only the run knows whether it writes what it captured (D-0218)",
                            b.current_line,
                            shown_name(n),
                        ),
                    );
                }
            },
            None    : {},
        }
    }
    // D-0258 `[Ref-Form-Static]`: `&NAME` of a static.
    match (path_segs(strip_parens_tc(inner)))
    {
        Some(segs) :
        {
            match (HashMap::get(&it.statics, &String::join(segs, "::")))
            {
                Some(s) :
                {
                    if (m == Mode::Exclusive)
                    {
                        String msg = sprintf(
                            "`%s` is a static, shared by every thread: borrow it `&%s` and change it through its operations",
                            &s.name,
                            &s.name,
                        );
                        return Err(named_diag("diag.write-through-shared", &msg));
                    }
                    return Ok(Some(ref_of(clone(&s.ty), Mode::Shared)));
                },
                None    : {},
            }
        },
        None       : {},
    }
    // D-0258 `[Ref-Form-Const]`: `&K` of a constant of plain data written
    // as a literal.
    match (&strip_parens_tc(inner).kind)
    {
        ExprKind::ECall(cb) :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            match (path_segs(&c.callee))
            {
                Some(segs) :
                {
                    if (Vec::len(&c.args) == 0)
                    {
                        String key = String::join(segs, "::");
                        match (HashMap::get(&it.fns, &key))
                        {
                            Some(f) :
                            {
                                if (f.is_const)
                                {
                                    bool literal = match (&f.body.tail)
                                    {
                                        Some(t) : literal_tree(Box::get(t)),
                                        None    : false,
                                    };
                                    // Report 293: an array of text literals
                                    // (`const array<str, 3> NAMES`) is static
                                    // data as a plain one is.
                                    bool text_array = match (&f.ret)
                                    {
                                        Type::TArray(ab) : match (&Box::get(ab).inner)
                                        {
                                            Type::TStr : true,
                                            _          : false,
                                        },
                                        _ : false,
                                    };
                                    bool text_literals = text_array && match (&f.body.tail)
                                    {
                                        Some(t) : text_literal_array(Box::get(t)),
                                        None    : false,
                                    };
                                    if ((literal && Option::is_none(&plain_problem(b, it, &f.ret))) || text_literals)
                                    {
                                        if (m == Mode::Exclusive)
                                        {
                                            String msg = sprintf(
                                                "`%s` is a constant: borrow it `&%s`; it cannot be written",
                                                &f.name,
                                                &f.name,
                                            );
                                            return Err(named_diag("diag.borrow-of-non-place", &msg));
                                        }
                                        HashSet::insert(&mut b.facts.const_addrs, key);
                                        return Ok(Some(ref_of(clone(&f.ret), Mode::Shared)));
                                    }
                                }
                            },
                            None    : {},
                        }
                    }
                },
                None       : {},
            }
        },
        _                   : {},
    }
    // D-0254: nor has a lane of a `simd`.
    match (&strip_parens_tc(inner).kind)
    {
        ExprKind::EIndex(ib) :
        {
            Option<Type> bt = deref_to(static_place_type(b, it, &Box::get(ib).a));
            match (&bt)
            {
                Some(st) :
                {
                    if (is_simd(st))
                    {
                        String msg = sprintf(
                            "a lane of a `%s` is not a place of its own: read it (`v[i]`), assign it (`v[i] = x`), or borrow the whole vector",
                            &type_display(st),
                        );
                        return Err(named_diag("diag.borrow-of-non-place", &msg));
                    }
                },
                None     : {},
            }
        },
        _                    : {},
    }
    // D-0118: a bit field has no address of its own.
    match (bitfield_of(b, it, inner))
    {
        Some(bf) :
        {
            String fname = match (&strip_parens_tc(inner).kind)
            {
                ExprKind::EField(fb) : String::clone(&Box::get(fb).name),
                _                    : String::new(),
            };
            StringView sn = Option::unwrap_or(StringView::strip_prefix(&bf.sname, "std::"), &bf.sname);
            String msg = sprintf(
                "field `%s` of `bitstruct %s` is a run of bits, not a place: read it (`x.%s`), assign it (`x.%s = v`), or borrow the whole `%s`",
                &fname,
                sn,
                &fname,
                &fname,
                sn,
            );
            return Err(named_diag("diag.borrow-of-non-place", &msg));
        },
        None     : {},
    }
    // D-0073: as an argument of a call whose result is not a reference, a
    // temporary is borrowed until the statement ends.
    bool temp_ok = replace(&mut b.cur_temp_ok, false);
    // D-0103: a field or element of such a temporary, as an argument.
    if (temp_ok && !is_temp_value(inner) && borrow_operand_kind(b, it, inner) == OperandKind::Temporary)
    {
        b.place_pos = true;
        Option<Type> ti = check_expr(b, it, inner, &None)?;
        HashSet::insert(&mut b.facts.temp_borrows, e.id);
        return Ok(match (ti)
        {
            Some(t) : Some(ref_of(t, m)),
            None    : None,
        });
    }
    // A payload-less variant (`&None`) is a value, not a place.
    bool variant_value = match (path_segs(strip_parens_tc(inner)))
    {
        Some(segs) : !is_local(b, &segs[0]) && Option::is_some(&variant_enum(it, segs)),
        None       : false,
    };
    if (variant_value && !temp_ok)
    {
        return Err(named_diag(
            "diag.borrow-of-non-place",
            "a variant is a value, which can be borrowed only as an argument of a call whose result is not a reference; elsewhere, bind it first",
        ));
    }
    // Report 229: a block's value (`&unsafe { Vec::from_c_bytes(p) }`) is a
    // temporary as a call's result is.
    bool block_value = match (&strip_parens_tc(inner).kind)
    {
        ExprKind::EUnsafe(bk) : Option::is_some(&bk.tail),
        ExprKind::EBlock(bk)  : Option::is_some(&bk.tail),
        _                     : false,
    };
    if (temp_ok && (is_temp_value(inner) || variant_value || block_value))
    {
        // The referent type the argument's parameter expects (D-0084).
        Option<Type> pointee = match (expected)
        {
            Some(Type::TRef(rb))   : if (!has_unresolved_marker(&Box::get(rb).inner)) { Some(clone(&Box::get(rb).inner)) } else { None },
            // Report 307: where a slice is expected, a temporary `Vec` is
            // borrowed whole as one (`[Coerce-Slice]`): `f(&Vec::new())`.
            Some(Type::TSlice(sb)) : if (!has_unresolved_marker(&Box::get(sb).inner) && is_generic_call_temp(b, it, inner)) { Some(named("std::Vec", vec_of_one(clone(&Box::get(sb).inner)))) } else { None },
            _                      : None,
        };
        usize saved_arg = b.borrowed_call_arg;
        match (&strip_parens_tc(inner).kind)
        {
            ExprKind::ECall(cb) :
            {
                if (Vec::len(&Box::get(cb).args) > 0)
                {
                    b.borrowed_call_arg = Box::get(cb).args[0].id;
                }
            },
            _                   : {},
        }
        Result<Option<Type>, String> tr = check_expr(b, it, inner, &pointee);
        b.borrowed_call_arg = saved_arg;
        Option<Type> ti = tr?;
        // Report 307: `&Vec::new()` typed by the slice it is passed as keeps
        // its type argument through `[Coerce-Slice]`'s rewrite.
        match (expected)
        {
            Some(Type::TSlice(_)) :
            {
                if (HashMap::len(&b.subst) == 0 && Option::is_some(&pointee))
                {
                    match (one_vec_arg(&ti))
                    {
                        Some(t) : note_rewrite(b, strip_parens_tc(inner), Rewrite::CallTypeArgs(vec_of_one(t))),
                        None    : {},
                    }
                }
            },
            _                     : {},
        }
        if (opt_is_ref(&ti))
        {
            return Err("diag.borrow-of-non-place");
        }
        HashSet::insert(&mut b.facts.temp_borrows, e.id);
        return Ok(match (ti)
        {
            Some(t) : Some(ref_of(t, m)),
            None    : None,
        });
    }
    // `[Ref-Form-Not-Place]` / `[Ref-Form-Temporary]` (spec/09 §2).
    match (borrow_operand_kind(b, it, inner))
    {
        OperandKind::NonPlace  :
        {
            if (is_temp_value(inner))
            {
                return Err(named_diag(
                    "diag.borrow-of-non-place",
                    "a temporary can be borrowed only as an argument of a call whose result is not a reference; elsewhere, bind it first",
                ));
            }
            if (is_text_literal(inner))
            {
                return Err(named_diag(
                    "diag.borrow-of-non-place",
                    "`&` borrows a place, and a text literal is not one; where a `StringView` is declared, write the literal without `&`: it is the view (`[Coerce-Text]`, D-0312)",
                ));
            }
            // Bug 101: an `if` or `match` is not borrowed in place, even
            // as an argument; report 229: a block's value is, as an
            // argument only.
            bool block_like = match (&strip_parens_tc(inner).kind)
            {
                ExprKind::EIf(_)    : true,
                ExprKind::EMatch(_) : true,
                _                   : false,
            };
            bool block_arg = match (&strip_parens_tc(inner).kind)
            {
                ExprKind::EBlock(bk)  : Option::is_some(&bk.tail),
                ExprKind::EUnsafe(bk) : Option::is_some(&bk.tail),
                _                     : false,
            };
            if (block_arg)
            {
                return Err(named_diag(
                    "diag.borrow-of-non-place",
                    &with_repair(
                        "`&` of a block's value (`&{ … }`, `&unsafe { … }`) is allowed only as an argument of a call whose result is not a reference, as a call's result is; elsewhere, bind the value first",
                        "`auto t = unsafe { … }; f(&t);`",
                    ),
                ));
            }
            if (block_like)
            {
                return Err(named_diag(
                    "diag.borrow-of-non-place",
                    &with_repair(
                        "`&` of an `if` or a `match` is not allowed, even as an argument (an argument borrows a call's result or a block's value in place, `&sprintf(…)`, but not the value of a branch); bind the value first",
                        "`String t = if (…) { … } else { … }; printf(\"%s\", &t);`",
                    ),
                ));
            }
            return Err(named_diag(
                "diag.borrow-of-non-place",
                "`&` borrows a place (a binding, a field, an element, `*r`); this is a value, which can be borrowed only as an argument of a call whose result is not a reference; elsewhere, bind it first",
            ));
        },
        OperandKind::Temporary : return Err(temp_msg()),
        OperandKind::Place     : {},
    }
    // `[Borrow-Exceeds-Source]` (spec/08).
    if (m == Mode::Exclusive && crosses_shared(b, it, inner))
    {
        return Err("diag.borrow-exceeds-source");
    }
    b.place_pos = true;
    Option<Type> ti = check_expr(b, it, inner, &None)?;
    flow_borrow(b, it, inner, m)?;
    Option<Referent> r = referent_of(b, it, e);
    HashMap::insert(&mut b.borrow_referents, e.id, r);
    Ok(match (ti)
    {
        Some(t) : Some(ref_of(t, m)),
        None    : None,
    })
}

fn check_view_slice(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<SliceExpr, shared> s,
) : Result<Option<Type>, String>
{
    // D-0053: `&s[lo .. hi]` on a `String` or a `StringView` is a
    // `StringView`; shared only.
    bool on_string = match (view_base(b, it, &s.base))
    {
        Some(x) : x,
        None    : false,
    };
    // D-0135: as an argument, a temporary `String` may be viewed.
    bool temp_ok = replace(&mut b.cur_temp_ok, false);
    if (s.mode == Mode::Exclusive)
    {
        return Err("diag.type-mismatch");
    }
    if (on_string)
    {
        bool through_ref = returns_ref(b, it, &s.base);
        OperandKind k = if (through_ref) { OperandKind::Place } else { borrow_operand_kind(b, it, &s.base) };
        if ((k == OperandKind::NonPlace || k == OperandKind::Temporary) && temp_ok)
        {
            HashSet::insert(&mut b.facts.temp_borrows, e.id);
            b.place_pos = k == OperandKind::Temporary;
            check_expr(b, it, &s.base, &None)?;
        }
        else if (k == OperandKind::NonPlace)
        {
            return Err(slice_of_value_msg());
        }
        else if (k == OperandKind::Temporary)
        {
            return Err(temp_msg());
        }
        else
        {
            b.place_pos = true;
            check_expr(b, it, &s.base, &None)?;
            flow_borrow(b, it, &s.base, s.mode)?;
        }
    }
    else
    {
        check_expr(b, it, &s.base, &None)?;
    }
    check_expect(b, it, &s.lo, &Type::TInt(IntTy::Usize))?;
    check_expect(b, it, &s.hi, &Type::TInt(IntTy::Usize))?;
    HashMap::insert(&mut b.facts.view_ops, e.id, if (on_string) { ViewOp::SliceString } else { ViewOp::SliceView });
    Ok(Some(named("std::StringView", Vec::new())))
}

fn check_slice(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<SliceExpr, shared> s,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // D-0254: a `simd` is a value, not a run of places.
    match (deref_to(static_place_type(b, it, &s.base)))
    {
        Some(st) :
        {
            if (is_simd(&st))
            {
                String msg = sprintf(
                    "a `%s` is not sliced: its lanes are not places of their own; read them with `v[i]`, or copy the vector into an array or a `Vec` with `simd_store`",
                    &type_display(&st),
                );
                return Err(named_diag("diag.borrow-of-non-place", &msg));
            }
        },
        None     : {},
    }
    // D-0312 §2: a `str` is sliced as its view, `&StringView::of(t)[lo..hi]`,
    // whatever `t` is (a literal, a binding, a constant): static text needs no
    // place. The rewrite is recorded on `t`.
    bool str_lit = match (&strip_parens_tc(&s.base).kind)
    {
        ExprKind::EStr(_) : true,
        _                 : false,
    };
    bool str_base = str_lit || match (static_place_type(b, it, &s.base))
    {
        Some(Type::TStr) : true,
        Some(_)          : false,
        None : match (value_shape(b, it, &s.base))
        {
            Some(Type::TStr) : true,
            _                : false,
        },
    };
    if (str_base)
    {
        if (s.mode == Mode::Exclusive)
        {
            return Err(mismatch("a `str` is read-only text: its view is shared, `&t[lo .. hi]`"));
        }
        if (b.facts.silent)
        {
            return Err(mismatch("a `str` is sliced as its view, `&StringView::of(t)[lo .. hi]`, in a body checked after the program was built"));
        }
        check_expect(b, it, &s.lo, &Type::TInt(IntTy::Usize))?;
        check_expect(b, it, &s.hi, &Type::TInt(IntTy::Usize))?;
        note_rewrite(b, &s.base, Rewrite::StrView);
        return Ok(Some(named("std::StringView", Vec::new())));
    }
    // `[Slice-Form]` (D-0047); D-0103: as an argument, a temporary may be
    // sliced.
    bool temp_ok = replace(&mut b.cur_temp_ok, false);
    bool through_ref = returns_ref(b, it, &s.base);
    OperandKind k = if (through_ref) { OperandKind::Place } else { borrow_operand_kind(b, it, &s.base) };
    if ((k == OperandKind::NonPlace || k == OperandKind::Temporary) && temp_ok)
    {
        HashSet::insert(&mut b.facts.temp_borrows, e.id);
    }
    else if (k == OperandKind::NonPlace)
    {
        return Err(slice_of_value_msg());
    }
    else if (k == OperandKind::Temporary)
    {
        return Err(temp_msg());
    }
    b.place_pos = true;
    tier_slice_reborrow(b, it, &s.base, s.mode);
    // Report 307: `[Coerce-Slice]` of `&Vec::new()` where a slice is
    // expected: the slice's element type fixes the `Vec`'s.
    Option<Type> base_expected = match (expected)
    {
        Some(Type::TSlice(sb)) : if (!has_unresolved_marker(&Box::get(sb).inner) && is_generic_call_temp(b, it, &s.base)) { Some(named("std::Vec", vec_of_one(clone(&Box::get(sb).inner)))) } else { None },
        _                      : None,
    };
    Option<Type> bt = check_expr(b, it, &s.base, &base_expected)?;
    bool shared_bt = match (&bt)
    {
        Some(Type::TRef(rb))   : Box::get(rb).mode == Mode::Shared,
        Some(Type::TSlice(sb)) : Box::get(sb).mode == Mode::Shared,
        _                      : false,
    };
    if (s.mode == Mode::Exclusive && (crosses_shared(b, it, &s.base) || shared_bt))
    {
        return Err("diag.borrow-exceeds-source");
    }
    check_expect(b, it, &s.lo, &Type::TInt(IntTy::Usize))?;
    check_expect(b, it, &s.hi, &Type::TInt(IntTy::Usize))?;
    Type elem = match (&bt)
    {
        None    : return Ok(None),
        Some(t) :
        {
            if (has_unresolved_marker(t))
            {
                return Ok(None);
            }
            match (indexed_elem(t))
            {
                Some(el) : el,
                None     :
                {
                    // `&s[0..2]` on a `str`: its view is sliced (session
                    // findings 010-B1, 005-B5).
                    bool str_t = match (t)
                    {
                        Type::TStr : true,
                        _          : false,
                    };
                    if (str_t)
                    {
                        // D-0312 §2: a `str` is a sequence of text: `&t[lo..hi]` is
                        // `&StringView::of(t)[lo..hi]`, a view of static text.
                        if (b.facts.silent)
                        {
                            return Err(mismatch("a `str` is sliced as its view, `&StringView::of(t)[lo .. hi]`, in a body checked after the program was built"));
                        }
                        note_rewrite(b, &s.base, Rewrite::StrView);
                        return Ok(Some(Type::TNamed(Box::new(NamedTy { .name = "std::StringView", .args = Vec::new() }))));
                    }
                    // Text reached here is in a form the text slice does not
                    // see through: say so, not that text is not sliced.
                    if (Option::is_some(&view_kind(t)))
                    {
                        return Err(mismatch(sprintf(
                            "this `%s` is not sliced in this form: bind a reference to it first (`ref<%s, shared> r = …;`) and slice that, `&r[lo .. hi]`",
                            &type_display(t),
                            &type_display(t),
                        )));
                    }
                    return Err(mismatch(sprintf(
                        "`%s` is not sliced: a slice is of an array, a `Vec`, a `String` or a `StringView`",
                        &type_display(t),
                    )));
                },
            }
        },
    };
    // Literal bounds on an array are checked now.
    Option<u128> n = match (&bt)
    {
        Some(Type::TArray(ab)) : Some(Box::get(ab).n),
        Some(Type::TRef(rb)) : match (&Box::get(rb).inner)
        {
            Type::TArray(ab) : Some(Box::get(ab).n),
            _                : None,
        },
        _                      : None,
    };
    match (n)
    {
        Some(len) : match (literal_value(&s.lo))
        {
            Some(lo) : match (literal_value(&s.hi))
            {
                Some(hi) :
                {
                    if (lo < 0 || hi < lo || reinterpret<u128>(hi) > len)
                    {
                        return Err("diag.index-out-of-bounds");
                    }
                },
                None     : {},
            },
            None : {},
        },
        None : {},
    }
    // D-0070: the slice borrows its range of `base`.
    Option<Place> src = match (slice_source(b, it, &s.base))
    {
        Some(p) :
        {
            if (StringView::starts_with(
                &p.root,
                "*",
            ) && Vec::len(&p.path) == 0) { Some(p) } else { place_of(b, it, &s.base) }
        },
        None    : place_of(b, it, &s.base),
    };
    match (src)
    {
        Some(p) :
        {
            Vec::push(&mut p.path, range_elem_in(b, &s.lo, &s.hi));
            flow_clash(b, it, &p.root, &p.path, s.mode, "diag.aliasing-conflict")?;
        },
        None    : {},
    }
    Ok(Some(slice_of(elem, s.mode)))
}

struct ArrLen
{
    Type elem;
    u128 n;
}

fn check_index(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Expr, shared> base,
    ref<Expr, shared> idx,
    bool in_place,
) : Result<Option<Type>, String>
{
    tier_elem_access(b, it, e, Mode::Shared)?;
    b.place_pos = true;
    Option<Type> bt0 = check_expr(b, it, base, &None)?;
    // D-0064: `g[i]` through a guard is `(*g)[i]`.
    Option<Type> bt = match (bt0)
    {
        Some(Type::TGuard(gb)) : Some(Box::into_inner(gb)),
        other                  : other,
    };
    match (&bt)
    {
        Some(t) :
        {
            if (is_marker(t))
            {
                return Err(unbounded_msg("indexing"));
            }
        },
        None    : {},
    }
    if (opt_is_ref(&bt))
    {
        // The reference itself is read.
        flow_read(b, it, base)?;
    }
    // Bug 129: `m["a"]` on a hash table.
    match (&bt)
    {
        Some(t) :
        {
            ref<Type, shared> under = match (t)
            {
                Type::TRef(rb) : &Box::get(rb).inner,
                _              : t,
            };
            if (named_is(under, "std::HashMap") || named_is(under, "std::BTreeMap"))
            {
                return Err(sprintf(
                    "%s%s",
                    &mismatch(with_repair(
                        "a hash table is not indexed: its value for a key is `HashMap::get(&m, k)`, an `Option` (`HashMap::get_mut` to change it), and `HashMap::insert(&mut m, k, v)` sets one",
                        "",
                    )),
                    &diag_at(idx.line, idx.col),
                ));
            }
        },
        None    : {},
    }
    check_expect(b, it, idx, &Type::TInt(IntTy::Usize))?;
    Option<ArrLen> arr = match (&bt)
    {
        Some(Type::TArray(ab)) : Some(ArrLen { .elem = clone(&Box::get(ab).inner), .n = Box::get(ab).n }),
        Some(Type::TSimd(ab))  : Some(ArrLen { .elem = clone(&Box::get(ab).inner), .n = Box::get(ab).n }),
        Some(Type::TRef(rb)) : match (&Box::get(rb).inner)
        {
            Type::TArray(ab) : Some(ArrLen { .elem = clone(&Box::get(ab).inner), .n = Box::get(ab).n }),
            Type::TSimd(ab)  : Some(ArrLen { .elem = clone(&Box::get(ab).inner), .n = Box::get(ab).n }),
            _                : None,
        },
        _                      : None,
    };
    // D-0047: a `Vec` or a slice is indexed too.
    if (Option::is_none(&arr))
    {
        Option<Type> elem = match (&bt)
        {
            Some(t) : indexed_elem(t),
            None    : None,
        };
        match (elem)
        {
            Some(t) :
            {
                // A resource cannot be moved out of a `Vec` or a slice.
                if (!in_place && is_resource_ty(it, &t))
                {
                    String shown = match (&t)
                    {
                        Type::TNamed(nb) : String::copy(Option::unwrap_or(
                            StringView::strip_prefix(&Box::get(nb).name, "std::"),
                            &(Box::get(nb).name),
                        )),
                        _ : "T",
                    };
                    // Bug 253: the element as written, and in a generic
                    // body the generic forms, which every instantiation takes.
                    String place = Option::unwrap_or(place_text(e), "v[i]");
                    String msg = match (subst_param_of(b, &t))
                    {
                        Some(tp) : sprintf(
                            "this would move a `%s` out of an element, leaving a hole; copy it, `clone(&%s)` (the bound `%s: clone` gives `clone`), borrow it, `&%s`, or take it out of a `Vec` with `Vec::remove`/`Vec::pop`",
                            &tp,
                            &place,
                            &tp,
                            &place,
                        ),
                        None : sprintf(
                            "this would move a `%s` out of an element, leaving a hole; take it out with `Vec::remove`/`Vec::pop`, exchange it with `replace(&mut %s, x)`, copy it (`%s::clone(&%s)`), or borrow it (`&%s`)",
                            &type_display(&t),
                            &place,
                            &shown,
                            &place,
                            &place,
                        ),
                    };
                    return Err(named_diag("diag.move-out-of-field", &msg));
                }
                if (!in_place)
                {
                    flow_read(b, it, e)?;
                }
                return Ok(Some(t));
            },
            None    : {},
        }
    }
    // `[Index-Checked]`'s bound when the index is a literal.
    match (&arr)
    {
        Some(a) : match (known_value(b, idx))
        {
            Some(v) :
            {
                if (v < 0 || reinterpret<u128>(v) >= a.n)
                {
                    return Err("diag.index-out-of-bounds");
                }
            },
            None    : {},
        },
        None : {},
    }
    // `[T-Index]`: anything else of a known type is not indexed.
    if (Option::is_none(&arr))
    {
        match (&bt)
        {
            Some(t) :
            {
                if (!has_unresolved_marker(t) && !is_never(t))
                {
                    if (named_is(t, "std::String"))
                    {
                        return Err(mismatch("a `String` is not indexed; its bytes are `StringView::as_bytes(&s)[i]`, and its text is a view, `&s[lo..hi]`"));
                    }
                    bool ref_string = match (t)
                    {
                        Type::TRef(rb) : named_is(&Box::get(rb).inner, "std::String"),
                        _              : false,
                    };
                    if (ref_string)
                    {
                        return Err(mismatch("a `String` is not indexed; its bytes are `StringView::as_bytes(s)[i]`, and its text is a view, `&s[lo..hi]`"));
                    }
                    // CHG-0452.
                    if (named_is(t, "std::StringView"))
                    {
                        return Err(mismatch("a `StringView` is not indexed; its bytes are `StringView::as_bytes(v)[i]`, and part of its text is a view, `&v[lo..hi]`"));
                    }
                    return Err(mismatch(sprintf(
                        "a `%s` cannot be indexed; arrays, `Vec`s and slices can",
                        &type_display(t),
                    )));
                }
            },
            None    : {},
        }
    }
    if (!in_place)
    {
        flow_read(b, it, e)?;
    }
    Ok(match (arr)
    {
        Some(a) :
        {
            ArrLen { elem, .. } = a;
            Some(elem)
        },
        None    : None,
    })
}

fn check_array_lit(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Vec<Expr>, shared> es,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    Option<Type> ety = None;
    // D-0254: an array literal where a `simd` is expected is one.
    Option<ArrLen> lanes = match (expected)
    {
        Some(Type::TSimd(sb)) : Some(ArrLen { .elem = clone(&Box::get(sb).inner), .n = Box::get(sb).n }),
        _                     : None,
    };
    // D-0314: where a shared slice is declared, the literal's elements are of
    // its element type (`[Coerce-Slice-Literal]`).
    Option<Type> elem_expected = match (expected)
    {
        Some(Type::TArray(ab)) : Some(clone(&Box::get(ab).inner)),
        Some(Type::TSimd(ab))  : Some(clone(&Box::get(ab).inner)),
        Some(Type::TSlice(sb)) : if (Box::get(sb).mode == Mode::Shared) { Some(clone(&Box::get(sb).inner)) } else { None },
        _                      : None,
    };
    bool unknown = false;
    for (usize i = 0; i < Vec::len(es); i += 1)
    {
        Option<Type> want = match (&elem_expected)
        {
            Some(t) : Some(clone(t)),
            None    : clone(&ety),
        };
        // D-0304: a text literal element of an array whose element type is
        // declared `String` or `StringView`.
        bool lit_here = match (&elem_expected)
        {
            Some(w) : literal_in_position(b, w, &es[i]),
            None    : false,
        };
        Option<Type> t = if (lit_here) { clone(&elem_expected) } else { check_store_operand(b, it, &es[i], &want)? };
        // `[T-Array]`: every element has one type.
        match (&t)
        {
            Some(tt) : match (&want)
            {
                Some(w) :
                {
                    if (!has_unresolved_marker(tt) && !has_unresolved_marker(w) && !is_never(tt) && !is_never(w) && !ty_compat(
                        tt,
                        w,
                    ))
                    {
                        return Err(mismatch(sprintf(
                            "an array's elements have one type: `%s`, and this one is `%s`%s",
                            &type_display(w),
                            &type_display(tt),
                            &conversion_hint(w, tt, Some(&es[i])),
                        )));
                    }
                },
                None    : {},
            },
            None : {},
        }
        if (Option::is_none(&t))
        {
            unknown = true;
        }
        if (Option::is_none(&ety))
        {
            ety = t;
        }
    }
    u128 count = widen<u128>(Vec::len(es));
    match (lanes)
    {
        Some(sl) :
        {
            if (count != sl.n)
            {
                return Err(mismatch(sprintf(
                    "a `simd<%s, %v>` is written with %v lanes, and this literal has %v",
                    &type_display(&sl.elem),
                    sl.n,
                    sl.n,
                    Vec::len(es),
                )));
            }
            ArrLen { elem, n } = sl;
            return Ok(Some(simd_of(elem, n)));
        },
        None     : {},
    }
    // An element this pass cannot type takes the expected element type;
    // with none, the array's type is unknown too.
    match (ety)
    {
        Some(t) : Ok(Some(array_of(t, count))),
        None : match (elem_expected)
        {
            Some(t) : Ok(Some(array_of(t, count))),
            None    : if (unknown) { Ok(None) } else { Ok(Some(array_of(Type::TInt(IntTy::I32), count))) },
        },
    }
}

fn check_array_repeat(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> v,
    u128 n,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // D-0314: of a declared shared slice's element type too.
    Option<Type> elem_expected = match (expected)
    {
        Some(Type::TArray(ab)) : Some(clone(&Box::get(ab).inner)),
        Some(Type::TSimd(ab))  : Some(clone(&Box::get(ab).inner)),
        Some(Type::TSlice(sb)) : if (Box::get(sb).mode == Mode::Shared) { Some(clone(&Box::get(sb).inner)) } else { None },
        _                      : None,
    };
    // D-0254: `[x; N]` where a `simd<τ, N>` is expected: every lane `x`.
    match (expected)
    {
        Some(Type::TSimd(sb)) :
        {
            ref<SizedTy, shared> st = Box::get(sb);
            if (st.n != n)
            {
                return Err(mismatch(sprintf(
                    "a `simd<%s, %v>` has %v lanes, and this is `[v; %v]`",
                    &type_display(&st.inner),
                    st.n,
                    st.n,
                    n,
                )));
            }
            check_expect(b, it, v, &st.inner)?;
            return Ok(Some(simd_of(clone(&st.inner), st.n)));
        },
        _                     : {},
    }
    Option<Type> t = check_expr(b, it, v, &elem_expected)?;
    match (&t)
    {
        Some(tt) :
        {
            if (!has_unresolved_marker(tt))
            {
                Option<str> what = if (is_resource_ty(it, tt))
                {
                    Some("is a resource")
                }
                else if (holds_ref(it, tt))
                {
                    Some("is or holds a reference")
                }
                else if (contains_fn(it, tt))
                {
                    Some("is or holds a function value")
                }
                else
                {
                    None
                };
                match (what)
                {
                    Some(w) : return Err(mismatch(sprintf(
                        "`[v; %v]` copies `v` into every element, but `%s` %s",
                        n,
                        &type_display(tt),
                        w,
                    ))),
                    None : {},
                }
            }
        },
        None     : {},
    }
    match (or_type(t, elem_expected))
    {
        Some(x) : Ok(Some(array_of(x, n))),
        None    : Ok(None),
    }
}

// `spec/22`: the left side of `=` is a place.
fn is_place_expr(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EPath(_)  : true,
        ExprKind::EField(_) : true,
        ExprKind::EIndex(_) : true,
        ExprKind::EDeref(_) : true,
        ExprKind::EParen(x) : is_place_expr(Box::get(x)),
        _                   : false,
    }
}

// Reports 440, 441, 442 (D-0339): a place whose root is not a variable
// (no `*` on the way): a constant (`DAYS[1] = 29`), a call's result that is
// no reference (`find(&v).qty = 0`), a variant (`None = o`) or a `static`
// (`HITS = …`). Each assignment would change nothing, or what cannot be
// changed, and cobc either dropped it or failed.
fn assign_root_problem(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> lhs) : Option<String>
{
    ref<Expr, shared> x = strip_parens_tc(lhs);
    bool part = false;
    while (true)
    {
        match (&x.kind)
        {
            ExprKind::EField(fb) :
            {
                x = strip_parens_tc(&Box::get(fb).e);
                part = true;
            },
            ExprKind::EIndex(pb) :
            {
                x = strip_parens_tc(&Box::get(pb).a);
                part = true;
            },
            _                    : break,
        }
    }
    match (&x.kind)
    {
        ExprKind::ECall(cb) :
        {
            if (!part)
            {
                return None;
            }
            match (resolve_fn_path(it, &Box::get(cb).callee))
            {
                Some(k) :
                {
                    if (Option::expect(HashMap::get(&it.fns, &k), "a function").is_const)
                    {
                        return Some(mismatch(sprintf(
                            "`%s` is a constant, which stands for its value, so a part of it cannot be assigned; copy it into a variable to change the copy (`auto d = %s;`)",
                            &k,
                            &k,
                        )));
                    }
                },
                None    : {},
            }
            bool through_ref = match (value_shape(b, it, x))
            {
                Some(Type::TRef(_))    : true,
                Some(Type::TGuard(_))  : true,
                Some(Type::TRawptr(_)) : true,
                Some(_)                : false,
                None                   : true,
            };
            if (through_ref)
            {
                return None;
            }
            Some(mismatch("the left side of `=` is a part of a call's result, a temporary that ends with this statement, so the assignment would change nothing; bind the result first (`auto x = f(…); x.f = …;`), or have the function give a reference (`ref<T, exclusive>`)"))
        },
        ExprKind::EPath(pb) :
        {
            ref<Vec<String>, shared> segs = &Box::get(pb).segs;
            if (Vec::len(segs) == 1 && is_local(b, &segs[0]))
            {
                return None;
            }
            String n = String::join(segs, "::");
            StringView last = &segs[Vec::len(segs) - 1];
            match (HashMap::get(&it.fns, &n))
            {
                Some(f) :
                {
                    if (f.is_const)
                    {
                        return Some(mismatch(sprintf(
                            "`%s` is a constant, which stands for its value, so %s cannot be assigned; copy it into a variable to change the copy (`auto d = %s;`)",
                            &n,
                            if (part) { "a part of it" } else { "it" },
                            &n,
                        )));
                    }
                },
                None    : {},
            }
            if (HashMap::contains(&it.statics, &n))
            {
                return Some(named_diag("diag.static-assigned", &sprintf(
                    "`%s` is a `static`, which is never assigned or destroyed: it is changed through what it holds (`Atomic::store(&%s, x)`, `*lock(&%s) = x`)",
                    &n,
                    &n,
                    &n,
                )));
            }
            if (Vec::len(segs) <= 2 && HashMap::contains(&it.enum_of_variant, &String::copy(last)))
            {
                return Some(mismatch(sprintf(
                    "`%s` is a variant, a value, not a variable, so it cannot be assigned; to test a value against it, `if (x == %s)` or `match`",
                    &n,
                    &n,
                )));
            }
            None
        },
        _                   : None,
    }
}

fn check_assign(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> lhs,
    ref<Expr, shared> rhs,
) : Result<Option<Type>, String>
{
    match (one_seg(strip_parens_tc(lhs)))
    {
        Some(_) :
        {
            if (is_spawn_call(rhs))
            {
                match (&strip_parens_tc(rhs).kind)
                {
                    ExprKind::ECall(cb) :
                    {
                        HashSet::insert(
                            &mut b.bound_spawns,
                            site_key(Box::get(cb).callee.line, Box::get(cb).callee.col),
                        );
                    },
                    _                   : {},
                }
            }
        },
        None    : {},
    }
    tier_assign_rules(b, it, lhs, rhs)?;
    // `[Write-Not-Exclusive]` (spec/08).
    if (crosses_shared(b, it, lhs))
    {
        return Err(named_diag(
            "diag.write-through-shared",
            "this writes through a shared reference (`ref<T, shared>`, `&x`); writing needs an exclusive one (`ref<T, exclusive>`, `&mut x`)",
        ));
    }
    if (!is_place_expr(lhs))
    {
        return Err(mismatch("the left side of `=` is a value -- a literal, a call's result, or a constant (which stands for its value) -- not a variable, a field, an element or `*r`, so it cannot be assigned"));
    }
    match (assign_root_problem(b, it, lhs))
    {
        Some(m) : return Err(m),
        None    : {},
    }
    // A function (an item, not a binding) is a value too.
    match (path_segs(strip_parens_tc(lhs)))
    {
        Some(segs) :
        {
            String n = String::join(segs, "::");
            if (!(Vec::len(segs) == 1 && is_local(
                b,
                &segs[0],
            )) && (HashMap::contains(&it.fns, &n) || HashMap::contains(&it.externs, &n)))
            {
                return Err(mismatch(sprintf(
                    "`%s` is a function, not a variable, so it cannot be assigned; a variable of type `fn(…)` can be",
                    &n,
                )));
            }
        },
        None       : {},
    }
    // D-0033 (1): `x = e` for a whole binding gives it a new value.
    Option<String> reinit = match (path_segs(lhs))
    {
        Some(segs) :
        {
            if (Vec::len(segs) == 1 && is_local(
                b,
                &segs[0],
            ) && (flow_is_tracked(&b.flow, &segs[0]) || !HashSet::contains(&b.capture_names, &segs[0])))
            {
                Some(String::clone(&segs[0]))
            }
            else
            {
                None
            }
        },
        None       : None,
    };
    b.place_pos = true;
    b.reinit_target = clone(&reinit);
    Result<Option<Type>, String> lt0 = check_expr(b, it, lhs, &None);
    // D-0118: a write into a bit field must fit its width.
    match (bitfield_of(b, it, lhs))
    {
        Some(bf) :
        {
            String fname = match (&strip_parens_tc(lhs).kind)
            {
                ExprKind::EField(fb) : String::clone(&Box::get(fb).name),
                _                    : String::new(),
            };
            StringView sn = Option::unwrap_or(StringView::strip_prefix(&bf.sname, "std::"), &bf.sname);
            check_bitfield_literal(b, rhs, bf.width, &sprintf("field `%s` of `%s`", &fname, sn))?;
        },
        None     : {},
    }
    b.reinit_target = None;
    Option<Type> lt = match (lt0)
    {
        Ok(t)  : t,
        Err(e) : return Err(e),
    };
    Option<String> held_c = match (&strip_parens_tc(lhs).kind)
    {
        ExprKind::EDeref(t) : match (one_seg(strip_parens_tc(Box::get(t))))
        {
            Some(n) : if (StringView::starts_with(n, "__compound")) { Some(String::clone(n)) } else { None },
            None    : None,
        },
        _ : None,
    };
    match (&held_c)
    {
        Some(t) : Vec::push(&mut b.compound_held, String::clone(t)),
        None    : {},
    }
    // D-0290: what a value holding references stored here holds, found
    // before it is moved; into a holder, its facts follow.
    Option<StoreTarget> into = store_target(b, lhs);
    // Into a holder of the frame, a value that may hold references (`r = v`
    // of a `Vec<ref<…>>`): its facts follow too.
    bool into_holder = match (&into)
    {
        Some(st) : !st.through && is_holder(b, it, &st.name) && match (&lt)
        {
            Some(t) : may_hold_ref(it, t, 0),
            None    : false,
        },
        None : false,
    };
    bool lt_refish = match (&lt)
    {
        Some(t) : is_borrow_ty(t) || holds_ref(it, t) || into_holder,
        None    : false,
    };
    Option<Option<Vec<DerivFact>>> stored = if (lt_refish && Option::is_some(&into))
    {
        Some(inherited_facts(
            b,
            it,
            rhs,
            0,
        ))
    }
    else { None };
    bool follows = match (&into)
    {
        Some(st) : !st.through && is_holder(b, it, &st.name),
        None     : false,
    };
    // What the value reaches, for `escape_into_reach` below: found before it
    // is moved (`r = v` of a `Vec` a reference into an inner block was
    // pushed into, CHG-0439). A closure literal's is read once it is checked.
    bool closure_lit = match (&strip_parens_tc(rhs).kind)
    {
        ExprKind::EClosure(_) : true,
        _                     : false,
    };
    bool reach_wanted = match (&lt)
    {
        Some(t) :
        {
            bool fn_value = match (t)
            {
                Type::TFn(_)      : true,
                Type::TClosure(_) : true,
                _                 : false,
            };
            is_borrow_ty(t) || holds_ref(it, t) || ((closure_lit || !fn_value) && may_hold_ref(it, t, 0))
        },
        None    : false,
    };
    Option<Option<Vec<DerivFact>>> reach = if (reach_wanted && !closure_lit && b.report) { Some(inherited_facts(b, it, rhs, 0)) } else { None };
    bool saved_holding = replace(&mut b.holding, follows);
    // D-0304: a text literal assigned to a `String` or `StringView` place is
    // typed by the place.
    bool lit_here = match (&lt)
    {
        Some(l) : literal_in_position(b, l, rhs),
        None    : false,
    };
    Result<Option<Type>, String> rt0 = if (lit_here) { Ok(clone(&lt)) } else { check_store_operand(b, it, rhs, &lt) };
    b.holding = saved_holding;
    if (Option::is_some(&held_c))
    {
        Vec::pop(&mut b.compound_held);
    }
    Option<Type> rt = rt0?;
    // (A place of plain data only: a resource's write keeps its order, and
    // a place that may hold a reference may be given the very reference
    // being ended, `a = &Box::get(f).e`.)
    bool plain_place = match (&lt)
    {
        Some(l) : !is_resource_ty(it, l) && !may_hold_ref_inst(it, l),
        None    : false,
    };
    if (plain_place)
    {
        end_after_value(b, it, lhs, rhs);
    }
    // D-0281 step 4c: a write to an element of a `Vec` is an exclusive
    // access, against the live holders, as a borrow of it is (D-0282).
    tier_elem_access(b, it, lhs, Mode::Exclusive)?;
    match (&lt)
    {
        Some(l) : match (&rt)
        {
            Some(r) :
            {
                if (ty_compat(l, r))
                {
                    whole_slice_lint(b, it, l, rhs);
                }
                if (!has_unresolved_marker(l) && !has_unresolved_marker(r) && !ty_compat(l, r))
                {
                    // `a = b = 3`: C's chained assignment.
                    bool chained = match (&strip_parens_tc(rhs).kind)
                    {
                        ExprKind::EAssign(_) : true,
                        _                    : false,
                    };
                    if (chained)
                    {
                        return Err(mismatch("an assignment has no value, so `a = b = 3` does not assign `a`: write `b = 3; a = b;`"));
                    }
                    // D-0304: `&s` or a `str` value assigned to a `StringView`
                    // place is its view (D-0302).
                    if (!view_of_text(b, it, l, r, rhs))
                    {
                        // Bug 130: a reference assigned its referent's type
                        // is written through.
                        String hint = match (l)
                        {
                            Type::TRef(lb) :
                            {
                                if (Box::get(lb).mode == Mode::Exclusive && ty_compat(&Box::get(lb).inner, r))
                                {
                                    String n = Option::unwrap_or(simple_text(lhs), "r");
                                    sprintf("; `%s` is a reference: write through it, `*%s = …;`", &n, &n)
                                }
                                else
                                {
                                    conversion_hint(l, r, Some(rhs))
                                }
                            },
                            _              : conversion_hint(l, r, Some(rhs)),
                        };
                        return Err(mismatch(sprintf(
                            "the place is `%s`, but the value assigned is `%s`%s",
                            &type_display(l),
                            &type_display(r),
                            &hint,
                        )));
                    }
                }
            },
            None    : {},
        },
        None : {},
    }
    flow_write(b, it, lhs)?;
    if (!b.flow.unreachable && is_none_literal(rhs))
    {
        match (path_segs(strip_parens_tc(lhs)))
        {
            Some(segs) :
            {
                if (Vec::len(segs) == 1 && is_local(b, &segs[0]))
                {
                    fl_lit(&mut b.flow, &segs[0], Some(empty_mark()));
                }
            },
            None       : {},
        }
    }
    match (&reinit)
    {
        Some(x) :
        {
            if (!b.flow.unreachable)
            {
                fl_tri(&mut b.flow, 0, x, Some(Tri::T));
            }
        },
        None    : {},
    }
    // Report 109: a closure stored into an element of a container
    // (`fs[0] = [i]() …`), which `place_of` does not follow.
    if (b.report && !b.flow.unreachable)
    {
        match (projected_root_name(lhs))
        {
            Some(root) : match (HashMap::get(&b.decl_block, &root))
            {
                Some(dest) : closure_outlived(b, rhs, *dest, &root)?,
                None       : {},
            },
            None : {},
        }
    }
    match (place_of(b, it, lhs))
    {
        Some(p) : match (HashMap::get(&b.decl_block, &p.root))
        {
            Some(dest) :
            {
                usize d = *dest;
                check_escape_into(b, it, d, rhs)?;
                // A closure literal too, and a value that may hold references
                // in its cells (`Vec<ref<…>>`, `Vec<StringView>`) (CHG-0439).
                if (reach_wanted)
                {
                    escape_into_reach(b, it, d, rhs, reach);
                }
            },
            None       : {},
        },
        None : {},
    }
    bool lhs_path = match (&strip_parens_tc(lhs).kind)
    {
        ExprKind::EPath(_) : true,
        _                  : false,
    };
    match (into)
    {
        Some(st) : match (stored)
        {
            Some(facts) :
            {
                StoreTarget { name, through } = st;
                holder_store(b, it, &name, through, lhs_path, rhs, facts)?;
            },
            None        : {},
        },
        None : {},
    }
    match (root_local_name(lhs))
    {
        Some(name) :
        {
            if (is_holder(b, it, &name))
            {
                return Ok(Some(Type::TVoid));
            }
            bool tracked = flow_is_tracked(&b.flow, &name);
            bool borrow_lt = match (&lt)
            {
                Some(t) : is_borrow_ty(t),
                None    : false,
            };
            bool fn_lt = match (&lt)
            {
                Some(Type::TFn(_))      : true,
                Some(Type::TClosure(_)) : true,
                _                       : false,
            };
            // A value holding a reference without being one (`Option<ref<…>>`,
            // `Result<StringView, E>`), assigned whole: what it now holds, as
            // its declaration's (bug 008: it kept the old value's facts).
            bool holds_lt = lhs_path && !borrow_lt && !fn_lt && match (&lt)
            {
                Some(t) : holds_ref(it, t),
                None    : false,
            };
            if (tracked && (borrow_lt || holds_lt))
            {
                Vec<DerivKey> facts = if (borrow_lt) { deriv_facts_of(b, it, rhs) } else { Vec::new() };
                if (Vec::len(&facts) == 0)
                {
                    facts = contained_ref_facts(b, it, rhs);
                }
                Option<HashMap<String, DerivFact>> prev = match (HashMap::get(&b.flow.deriv, &name))
                {
                    Some(m) : if (HashMap::len(m) > 0) { Some(HashMap::clone(m)) } else { None },
                    None    : None,
                };
                set_deriv(b, &name, facts);
                b.prev_facts = match (prev)
                {
                    Some(m) : Some(PrevFacts { .name = String::clone(&name), .facts = m }),
                    None    : None,
                };
                Result<void, String> r = tier_inherit(b, it, &name, Some(rhs));
                b.prev_facts = None;
                r?;
                if (borrow_lt)
                {
                    Option<Referent> origin = referent_of(b, it, rhs);
                    HashMap::insert(&mut b.ref_origin, name, origin);
                }
            }
            else if (tracked && is_spawn_call(rhs) && lhs_path)
            {
                Vec<DerivFact> facts = spawn_facts_tri_of(b, it, rhs);
                set_deriv_tri(b, &name, facts);
            }
            else if (tracked && is_closure(rhs) && lhs_path)
            {
                Vec<DerivFact> facts = closure_facts_of(b, it, rhs);
                set_deriv_tri(b, &name, facts);
            }
            else if (tracked && fn_lt && lhs_path)
            {
                Vec<DerivFact> facts = fn_value_facts(b, it, rhs);
                set_deriv_tri(b, &name, facts);
            }
        },
        None       : {},
    }
    Ok(Some(Type::TVoid))
}

fn check_propagate(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> inner,
    usize line,
) : Result<Option<Type>, String>
{
    // D-0273: a whole binding that holds a resource is used by value, as an
    // argument is: `x?` moves it.
    bool whole_resource = match (place_of(b, it, inner))
    {
        Some(p) : Vec::len(&p.path) == 0 && place_is_resource(b, it, &p.root, &p.path),
        None    : false,
    };
    // The result `?` returns from: a closure's own inside one (CHG-0438).
    Option<Type> fallible = match (&b.closure_ret)
    {
        Some(r) : clone(r),
        None    : Some(clone(&b.ret)),
    };
    // Report 181: a call directly under `?` may take its `Result`'s error
    // type from the function's (`propagate_err`).
    bool direct_call = match (&strip_parens_tc(inner).kind)
    {
        ExprKind::ECall(_) : true,
        _                  : false,
    };
    b.propagate_err = match (&fallible)
    {
        Some(ft) : if (direct_call && named_is(ft, "std::Result") && Vec::len(&named_args(ft)) == 2 && !has_unresolved_marker(ft))
        {
            Vec<Type> na = named_args(ft);
            Some(clone(&na[1]))
        }
        else { None },
        None : None,
    };
    Result<Option<Type>, String> tir = if (whole_resource)
    {
        check_store_operand(b, it, inner, &None)
    }
    else { check_expr(b, it, inner, &None) };
    b.propagate_err = None;
    Option<Type> ti = tir?;
    // A variant whose type arguments nothing fixed (`None?`, `Ok(3)?`) is
    // still of its enum.
    if (Option::is_none(&ti))
    {
        ref<Expr, shared> x = strip_parens_tc(inner);
        Option<String> en = match (&x.kind)
        {
            ExprKind::EPath(pb) :
            {
                ref<Vec<String>, shared> segs = &Box::get(pb).segs;
                if (Vec::len(segs) == 1 && is_local(b, &segs[0])) { None } else { variant_enum(it, segs) }
            },
            ExprKind::ECall(cb) : match (&Box::get(cb).callee.kind)
            {
                ExprKind::EPath(pb) : variant_enum(it, &Box::get(pb).segs),
                _                   : None,
            },
            _                   : None,
        };
        match (en)
        {
            Some(n) : ti = Some(Type::TNamed(Box::new(NamedTy { .name = n, .args = Vec::new() }))),
            None    : {},
        }
    }
    if (closure_result_open(b))
    {
        match (&ti)
        {
            Some(t) : Vec::push(&mut b.closure_exits, ClosureExitAt { .exit = ClosureExit::Propagate(clone(t)), .line = line }),
            None    : {},
        }
    }
    match (&ti)
    {
        Some(t) :
        {
            Vec<Type> args = named_args(t);
            bool fallible_result = match (&fallible)
            {
                Some(f) : named_is(f, "std::Result"),
                None    : false,
            };
            if (named_is(t, "std::Result") && Option::is_some(&fallible) && !fallible_result)
            {
                // Bug 067: `main` returns nothing or a `u8`, never a `Result`.
                if (b.fn_name == "main" && Option::is_none(&b.closure_ret))
                {
                    return Err(named_diag(
                        "diag.propagate-outside-fallible-context",
                        &with_repair(
                            "`?` on a `Result` returns its error, and `main` cannot return a `Result` (it returns nothing or a `u8`): put the body in a function that does, `fn run() : Result<void, E>`, and in `main` take its result apart",
                            "`fn main() : u8 { match (run()) { Ok(_) : 0, Err(e) : { eprintf(\"%v\\n\", …); 1 }, } }`",
                        ),
                    ));
                }
                // Bug 249: in a function returning an `Option`, the
                // `Result` turns into one with `Result::ok(r)?`.
                bool fallible_option = match (&fallible)
                {
                    Some(f) : named_is(f, "std::Option"),
                    None    : false,
                };
                if (fallible_option)
                {
                    return Err(named_diag(
                        "diag.propagate-outside-fallible-context",
                        &with_repair(
                            "`?` on a `Result` returns its error, and this function (or closure) returns an `Option`, which has no error to return",
                            "turn the `Result` into an `Option` first, `Result::ok(r)?` (its error is dropped), change the return type to a `Result`, or `match` the result",
                        ),
                    ));
                }
                return Err(named_diag(
                    "diag.propagate-outside-fallible-context",
                    "`?` on a `Result` returns its error, so the function (or closure) must return a `Result`",
                ));
            }
            if (named_is(t, "std::Result"))
            {
                // [Propagate-Err-Mismatch] (spec/18): the function returns
                // Result<_, E'> with E' exactly this Result's E, once known.
                if (Vec::len(&args) > 1)
                {
                    bool matching = match (&fallible)
                    {
                        Some(f) :
                        {
                            Vec<Type> rargs = named_args(f);
                            named_is(f, "std::Result") && Vec::len(&rargs) > 1 && type_eq(&rargs[1], &args[1])
                        },
                        None    : true,
                    };
                    if (!matching)
                    {
                        // CHG-0452: both error types, and the conversion
                        // written out.
                        Option<Type> theirs = match (&fallible)
                        {
                            Some(f) :
                            {
                                Vec<Type> rargs = named_args(f);
                                if (Vec::len(&rargs) > 1) { Some(clone(&rargs[1])) } else { None }
                            },
                            None    : None,
                        };
                        return match (theirs)
                        {
                            Some(want) :
                            {
                                String e = type_display(&args[1]);
                                String w = type_display(&want);
                                String msg = sprintf(
                                    "`?` passes on this `Result`'s error, a `%s`, and the function returns a `Result` whose error is a `%s`: convert it first, `Result::map_err(r, [](%s x) : %s { … })?`, or `match` the result",
                                    &e,
                                    &w,
                                    &e,
                                    &w,
                                );
                                Err(named_diag("diag.propagate-outside-fallible-context", &msg))
                            },
                            None       : Err("diag.propagate-outside-fallible-context"),
                        };
                    }
                }
                return Ok(if (Vec::len(&args) > 0) { Some(clone(&args[0])) } else { None });
            }
            // D-0130 `[Propagate-Option]` (spec/18).
            if (named_is(t, "std::Option"))
            {
                bool fallible_option = match (&fallible)
                {
                    Some(f) : named_is(f, "std::Option"),
                    None    : true,
                };
                if (fallible_option)
                {
                    return Ok(if (Vec::len(&args) > 0) { Some(clone(&args[0])) } else { None });
                }
                return Err(named_diag(
                    "diag.propagate-outside-fallible-context",
                    "`?` on an `Option` returns `None`, so the function must return an `Option`; to return an error instead, write `Option::ok_or(o, e)?`",
                ));
            }
            // Bug 249: name what `?` takes.
            bool plain = match (t)
            {
                Type::TInt(_) : true,
                Type::TBool   : true,
                Type::TF32    : true,
                Type::TF64    : true,
                Type::TStr    : true,
                _             : false,
            };
            if (plain)
            {
                String msg = sprintf(
                    "`?` takes a `Result` or an `Option`, and this is a `%s`, which has no error or `None` to pass on",
                    &type_display(t),
                );
                return Err(named_diag(
                    "diag.type-mismatch",
                    &with_repair(&msg, "drop the `?`: the value is used as it is"),
                ));
            }
            Ok(None)
        },
        None    : Ok(None),
    }
}

fn check_if(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<IfExpr, shared> x,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // D-0322: `assert(a OP b)`, as `modres` rewrote it.
    Option<usize> assert_cmp = assert_comparison(&x.cond, &x.then_);
    match (assert_cmp)
    {
        Some(k) :
        {
            _ = HashSet::insert(&mut b.facts.assert_cmps, k);
        },
        None    : {},
    }
    Result<void, String> checked = check_expect(b, it, &x.cond, &Type::TBool);
    match (assert_cmp)
    {
        Some(k) :
        {
            _ = HashSet::remove(&mut b.facts.assert_cmps, k);
        },
        None    : {},
    }
    checked?;
    end_after_condition(b, it, x);
    // Report 056: the condition's locals are not folded in the branches.
    Vec<String> guarded = guard_push(b, &x.cond);
    Result<Option<Type>, String> r = check_if_branches(b, it, e, x, expected);
    guard_pop(b, &guarded);
    r
}

fn check_if_branches(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<IfExpr, shared> x,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // Two successors; the branch states join afterwards. D-0049: with no
    // expected type, a branch that is only a literal takes the other
    // branch's type (checked first).
    bool else_first = Option::is_none(expected) && is_literal_block(&x.then_) && match (&x.else_)
    {
        Some(fe) : !is_literal_branch(fe),
        None     : false,
    };
    if (!else_first)
    {
        return check_if_fast(b, it, e, x, expected);
    }
    Flow before = clone(&b.flow);
    Option<Type> tt = None;
    Option<Type> ft = None;
    Flow after_t = new_flow();
    // A branch checked against the other's type (the hint) that comes out
    // untyped (a generic variant such as `None`) has that type.
    Option<Type> hinted = None;
    if (else_first)
    {
        ref<Expr, shared> fe = match (&x.else_)
        {
            Some(f) : f,
            None    : return Ok(None),
        };
        ft = check_expr(b, it, fe, &None)?;
        Flow nf_22584 = before;
        Flow after_f = flow_swap(b, nf_22584);
        Option<Type> hint = match (&ft)
        {
            Some(h) : if (!is_never(h) && !has_unresolved_marker(h)) { Some(clone(h)) } else { None },
            None    : None,
        };
        match (&hint)
        {
            Some(h) :
            {
                HashMap::insert(&mut b.facts.if_hints, e.id, clone(h));
            },
            None    : {},
        }
        end_at_then_start(b, it, x);
        tt = check_nested_block(b, it, &x.then_, &hint)?;
        Flow nf_22599 = after_f;
        after_t = flow_swap(b, nf_22599);
        if (Option::is_none(&tt))
        {
            hinted = hint;
        }
    }
    else
    {
        end_at_then_start(b, it, x);
        tt = check_nested_block(b, it, &x.then_, expected)?;
        Flow nf_22608 = before;
        after_t = flow_swap(b, nf_22608);
        Option<Type> hint = if (Option::is_none(expected))
        {
            match (&tt)
            {
                Some(h) : if (!is_never(h) && !type_eq(
                    h,
                    &Type::TVoid,
                ) && !has_unresolved_marker(h)) { Some(clone(h)) } else { None },
                None : None,
            }
        }
        else
        {
            None
        };
        match (&hint)
        {
            Some(h) : match (&x.else_)
            {
                Some(fe) :
                {
                    if (is_literal_branch(fe))
                    {
                        HashMap::insert(&mut b.facts.if_hints, e.id, clone(h));
                    }
                },
                None     : {},
            },
            None : {},
        }
        ft = match (&x.else_)
        {
            Some(fe) :
            {
                Option<Type> want = match (expected)
                {
                    Some(t) : Some(clone(t)),
                    None    : clone(&hint),
                };
                check_expr(b, it, fe, &want)?
            },
            None     : Some(Type::TVoid),
        };
        if (Option::is_none(&ft) && Option::is_some(&x.else_))
        {
            hinted = hint;
        }
    }
    Flow nf_22657 = flow_join(&after_t, &b.flow);
    flow_assign(b, nf_22657);
    if_result(x, else_first, tt, ft, hinted)
}

// The type of an `if` from its branches' (`check_if_branches`).
fn if_result(ref<IfExpr, shared> x, bool else_first, Option<Type> tt, Option<Type> ft, Option<Type> hinted) : Result<Option<Type>, String>
{
    match (hinted)
    {
        Some(h) :
        {
            if (else_first)
            {
                tt = Some(h);
            }
            else
            {
                ft = Some(h);
            }
        },
        None    : {},
    }
    match (tt)
    {
        Some(a) : match (ft)
        {
            Some(c) :
            {
                if (has_unresolved_marker(&a) || has_unresolved_marker(&c))
                {
                    // D-0341 (report 409): what one branch leaves open
                    // (`Ok(true)`'s error type) the other may fix (`Err("…")`):
                    // each fills the other's open slots, and the `if` has the
                    // type when none is left open.
                    if (Option::is_some(&x.else_) && !is_never(&a) && !is_never(&c))
                    {
                        Option<Type> filled = merge_open(&a, &c, 0);
                        match (filled)
                        {
                            Some(t) :
                            {
                                if (!has_unresolved_marker(&t))
                                {
                                    return Ok(Some(t));
                                }
                            },
                            None    : {},
                        }
                    }
                    return Ok(None);
                }
                if (Option::is_none(&x.else_))
                {
                    // `[T-If]`: no `else` makes the `if` `()`.
                    if (!type_eq(&a, &Type::TVoid) && !is_never(&a))
                    {
                        return Err(mismatch(sprintf(
                            "an `if` without `else` has no value, but this branch gives `%s`: add an `else`, or end the branch's last expression with `;`",
                            &type_display(&a),
                        )));
                    }
                    return Ok(Some(Type::TVoid));
                }
                // A diverging branch takes the other's type: `if (c) {
                // return 1; } else { … }` with a `void` `else` is `void`,
                // not the function's type (report 106).
                if (is_never(&a))
                {
                    return Ok(Some(c));
                }
                if (is_never(&c) || ty_compat(&a, &c))
                {
                    return Ok(Some(a));
                }
                // Bug 099: what the two branches give, and how they meet.
                Err(mismatch(sprintf(
                    "the `if` branch gives `%s` and the `else` branch `%s`; both give one type%s",
                    &type_display(&a),
                    &type_display(&c),
                    &branches_hint(&a, &c),
                )))
            },
            None    : Ok(None),
        },
        None : Ok(None),
    }
}

// Bug 099: how two branches or arms of different types meet, when one is
// owned text and the other a view or literal: `String::copy` of the view.
fn branches_hint(ref<Type, shared> a, ref<Type, shared> c) : String
{
    bool sa = plain_named_ty(a, "std::String");
    bool sc = plain_named_ty(c, "std::String");
    bool va = matches_str(a) || plain_named_ty(a, "std::StringView");
    bool vc = matches_str(c) || plain_named_ty(c, "std::StringView");
    if ((sa && vc) || (sc && va))
    {
        return "; a `str` or `StringView` becomes a `String` with `String::copy(…)` (a literal is one already where a `String` is wanted)";
    }
    if (is_numeric_ty(a) && is_numeric_ty(c))
    {
        return "; convert one (`widen`, `narrow`, `to_float`), or type a literal (`0: u64`)";
    }
    String::new()
}

// A binding's `valid`, `init` and `lits` entries.
struct NameFacts
{
    Option<Tri> v;
    Option<Tri> i;
    Option<i128> l;
}

fn name_facts(ref<Flow, shared> f, ref<String, shared> n) : NameFacts
{
    NameFacts {
        .v = match (HashMap::get(&f.valid, n))
        {
            Some(t) : Some(*t),
            None    : None,
        },
        .i = match (HashMap::get(&f.init, n))
        {
            Some(t) : Some(*t),
            None    : None,
        },
        .l = match (HashMap::get(&f.lits, n))
        {
            Some(x) : Some(*x),
            None    : None,
        },
    }
}

// The names the log records from `mark` on, each once.
fn logged_names(ref<Flow, shared> f, usize mark) : Vec<String>
{
    HashSet<String> seen = HashSet::new();
    Vec<String> out = Vec::new();
    for (usize k = mark; k < Vec::len(&f.undo); k += 1)
    {
        if (HashSet::insert(&mut seen, String::clone(&f.undo[k].key)))
        {
            Vec::push(&mut out, String::clone(&f.undo[k].key));
        }
    }
    out
}

// Undoes the log back to `mark`.
fn undo_to(ref<Flow, exclusive> f, usize mark)
{
    while (Vec::len(&f.undo) > mark)
    {
        FlowUndo { map, key, t, l } = Option::unwrap(Vec::pop(&mut f.undo));
        if (map == 2)
        {
            match (l)
            {
                Some(x) :
                {
                    HashMap::insert(&mut f.lits, key, x);
                },
                None    :
                {
                    HashMap::swap_remove(&mut f.lits, &key);
                },
            }
        }
        else
        {
            match (t)
            {
                Some(tv) :
                {
                    if (map == 0)
                    {
                        HashMap::insert(&mut f.valid, key, tv);
                    }
                    else
                    {
                        HashMap::insert(&mut f.init, key, tv);
                    }
                },
                None     :
                {
                    if (map == 0)
                    {
                        HashMap::swap_remove(&mut f.valid, &key);
                    }
                    else
                    {
                        HashMap::swap_remove(&mut f.init, &key);
                    }
                },
            }
        }
    }
}

// The flow without its per-binding maps (`valid`, `init`, `lits`, the log):
// what a branch's state is besides them, copied whole.
fn flow_small(ref<Flow, shared> f) : Flow
{
    Flow {
        .unreachable = f.unreachable,
        .valid = HashMap::new(),
        .init = HashMap::new(),
        .deriv = clone(&f.deriv),
        .rooted = clone(&f.rooted),
        .excl_rooted = clone(&f.excl_rooted),
        .indexed = f.indexed,
        .lits = HashMap::new(),
        .undo = Vec::new(),
        .logging = 0,
    }
}

// The `deriv` holders of `f` and the root bindings of their facts.
fn deriv_names(ref<Flow, shared> f) : Vec<String>
{
    HashSet<String> seen = HashSet::new();
    Vec<String> out = Vec::new();
    for (usize k = 0; k < HashMap::len(&f.deriv); k += 1)
    {
        String h = String::clone(HashMap::key_at(&f.deriv, k));
        if (HashSet::insert(&mut seen, String::clone(&h)))
        {
            Vec::push(&mut out, h);
        }
        ref<HashMap<String, DerivFact>, shared> facts = HashMap::value_at(&f.deriv, k);
        for (usize i = 0; i < HashMap::len(facts); i += 1)
        {
            String r = String::copy(root_binding(&HashMap::value_at(facts, i).key.root));
            if (HashSet::insert(&mut seen, String::clone(&r)))
            {
                Vec::push(&mut out, r);
            }
        }
    }
    out
}

// `names`' facts set in `f` (logged), each name's three entries.
fn put_facts(ref<Flow, exclusive> f, ref<String, shared> n, ref<NameFacts, shared> nf)
{
    NameFacts cur = name_facts(f, n);
    if (cur.v != nf.v)
    {
        fl_tri(f, 0, n, nf.v);
    }
    if (cur.i != nf.i)
    {
        fl_tri(f, 1, n, nf.i);
    }
    if (cur.l != nf.l)
    {
        fl_lit(f, n, nf.l);
    }
}

// Report 150: `check_if_branches` for an `if` whose `then` branch is
// checked first, with the per-binding maps not copied: the then branch's
// changes are recorded (`Flow.undo`) and undone for the else branch, and
// the join visits only the names either branch changed (`flow_join` for the
// rest: the `deriv` facts and the indexes, copied as before). The result is
// `flow_join`'s: a name both branches leave alone keeps its facts, which the
// join of two equal states keeps.
fn check_if_fast(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<IfExpr, shared> x,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    usize mark = Vec::len(&b.flow.undo);
    b.flow.logging += 1;
    Result<Option<Type>, String> r = check_if_fast_in(b, it, e, x, expected, mark);
    b.flow.logging -= 1;
    if (b.flow.logging == 0)
    {
        Vec::truncate(&mut b.flow.undo, 0);
    }
    r
}

fn check_if_fast_in(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<IfExpr, shared> x,
    ref<Option<Type>, shared> expected,
    usize mark,
) : Result<Option<Type>, String>
{
    Flow small_before = flow_small(&b.flow);
    end_at_then_start(b, it, x);
    nest_branch_start(b, it, x, true);
    nest_branch_extra(b, x, true);
    // D-0341: a branch its condition's known value never takes is not
    // reached: what it would do is no fault of the program (a correct
    // program is accepted).
    Option<bool> known_cond = const_bool(b, &x.cond, 0);
    bool dead_then = match (known_cond)
    {
        Some(v) : !v,
        None    : false,
    };
    bool dead_else = match (known_cond)
    {
        Some(v) : v,
        None    : false,
    };
    if (dead_then)
    {
        b.flow.unreachable = true;
    }
    Result<Option<Type>, String> tt0 = check_nested_block(b, it, &x.then_, expected);
    nest_branch_done(b);
    Option<Type> tt = tt0?;
    // The then branch's state: its per-binding changes, and the rest.
    Vec<String> then_names = logged_names(&b.flow, mark);
    Vec<NameFacts> then_facts = Vec::new();
    foreach (n in &then_names)
    {
        Vec::push(&mut then_facts, name_facts(&b.flow, n));
    }
    Flow small_then = flow_small(&b.flow);
    undo_to(&mut b.flow, mark);
    // Back to the state before the branch.
    Vec<NameFacts> then_before = Vec::new();
    foreach (n in &then_names)
    {
        Vec::push(&mut then_before, name_facts(&b.flow, n));
    }
    b.flow.unreachable = small_before.unreachable;
    b.flow.deriv = clone(&small_before.deriv);
    b.flow.rooted = clone(&small_before.rooted);
    b.flow.excl_rooted = clone(&small_before.excl_rooted);
    b.flow.indexed = small_before.indexed;
    Option<Type> hint = if (Option::is_none(expected))
    {
        match (&tt)
        {
            Some(h) : if (!is_never(h) && !type_eq(h, &Type::TVoid) && !has_unresolved_marker(h)) { Some(clone(h)) } else { None },
            None    : None,
        }
    }
    else
    {
        None
    };
    match (&hint)
    {
        Some(h) : match (&x.else_)
        {
            Some(fe) :
            {
                if (is_literal_branch(fe))
                {
                    HashMap::insert(&mut b.facts.if_hints, e.id, clone(h));
                }
            },
            None     : {},
        },
        None : {},
    }
    Option<Type> ft = match (&x.else_)
    {
        Some(fe) :
        {
            Option<Type> want = match (expected)
            {
                Some(t) : Some(clone(t)),
                None    : clone(&hint),
            };
            nest_branch_start(b, it, x, false);
            nest_branch_extra(b, x, false);
            if (dead_else)
            {
                b.flow.unreachable = true;
            }
            Result<Option<Type>, String> ft0 = check_expr(b, it, fe, &want);
            // (The branch's state stays unreachable: the join takes the
            // other's, so what only the taken branch did, an `x = 1;`, holds
            // after the `if`.)
            nest_branch_done(b);
            ft0?
        },
        None     : Some(Type::TVoid),
    };
    Option<Type> hinted = None;
    if (Option::is_none(&ft) && Option::is_some(&x.else_))
    {
        hinted = hint;
    }
    // The names the else branch changed, with their facts before it (the
    // first record of each), and every name either branch changed.
    Vec<String> else_names = logged_names(&b.flow, mark);
    HashMap<String, NameFacts> before_of = HashMap::new();
    for (usize k = 0; k < Vec::len(&then_names); k += 1)
    {
        HashMap::insert(&mut before_of, String::clone(&then_names[k]), clone(&then_before[k]));
    }
    {
        // Unwound on a copy: the facts each else-changed name had before.
        HashMap<String, NameFacts> firsts = HashMap::new();
        for (usize k = Vec::len(&b.flow.undo); k > mark; k -= 1)
        {
            ref<FlowUndo, shared> u = &b.flow.undo[k - 1];
            if (HashMap::contains(&before_of, &u.key))
            {
                continue;
            }
            ref<NameFacts, exclusive> nf = HashMap::entry(&mut firsts, &u.key, name_facts(&b.flow, &u.key));
            if (u.map == 0)
            {
                nf.v = u.t;
            }
            else if (u.map == 1)
            {
                nf.i = u.t;
            }
            else
            {
                nf.l = u.l;
            }
        }
        for (usize k = 0; k < HashMap::len(&firsts); k += 1)
        {
            HashMap::insert(&mut before_of, String::clone(HashMap::key_at(&firsts, k)), clone(HashMap::value_at(&firsts, k)));
        }
    }
    HashMap<String, NameFacts> then_of = HashMap::new();
    for (usize k = 0; k < Vec::len(&then_names); k += 1)
    {
        HashMap::insert(&mut then_of, String::clone(&then_names[k]), clone(&then_facts[k]));
    }
    Vec<String> all = clone(&then_names);
    foreach (n in &else_names)
    {
        if (!HashMap::contains(&then_of, n))
        {
            Vec::push(&mut all, String::clone(n));
        }
    }
    bool small_then_unreach = small_then.unreachable;
    // The rest by `flow_join`, over flows that carry each `deriv` holder's
    // `valid` (its join tests it) as the branches had it.
    Flow fa = small_then;
    Flow fb = flow_small(&b.flow);
    // Each holder's and each of its facts' root binding's `valid`
    // (`flow_join` keeps a fact only where both are valid on both sides).
    // (Both sides' names on both sides: a fact one side has keeps its root
    // valid on the other too, as `flow_join` over the whole maps has it.)
    Vec<String> a_names = deriv_names(&fa);
    Vec<String> fb_names = deriv_names(&fb);
    foreach (h in &fb_names)
    {
        if (!Vec::contains(&a_names, h))
        {
            Vec::push(&mut a_names, String::clone(h));
        }
    }
    Vec<String> b_names = clone(&a_names);
    foreach (h in &a_names)
    {
        Option<Tri> hv = match (HashMap::get(&then_of, h))
        {
            Some(f) : f.v,
            None : match (HashMap::get(&before_of, h))
            {
                Some(f) : f.v,
                None    : name_facts(&b.flow, h).v,
            },
        };
        match (hv)
        {
            Some(t) :
            {
                HashMap::insert(&mut fa.valid, String::clone(h), t);
            },
            None    : {},
        }
    }
    foreach (h in &b_names)
    {
        match (name_facts(&b.flow, h).v)
        {
            Some(t) :
            {
                HashMap::insert(&mut fb.valid, String::clone(h), t);
            },
            None    : {},
        }
    }
    Flow joined = flow_join(&fa, &fb);
    bool t_unreach = small_then_unreach;
    bool f_unreach = b.flow.unreachable;
    // The per-binding join, `flow_join`'s rows for one name.
    foreach (n in &all)
    {
        NameFacts tn = match (HashMap::get(&then_of, n))
        {
            Some(f) : clone(f),
            None    : clone(Option::unwrap(HashMap::get(&before_of, n))),
        };
        NameFacts fn_ = name_facts(&b.flow, n);
        NameFacts j = if (t_unreach)
        {
            fn_
        }
        else if (f_unreach)
        {
            tn
        }
        else
        {
            NameFacts out = NameFacts { .v = None, .i = None, .l = None };
            match (tn.v)
            {
                Some(va) : match (fn_.v)
                {
                    Some(vb) :
                    {
                        out.v = Some(tri_join(va, vb));
                        Tri ia = match (tn.i)
                        {
                            Some(t) : t,
                            None    : Tri::U,
                        };
                        Tri ib = match (fn_.i)
                        {
                            Some(t) : t,
                            None    : Tri::U,
                        };
                        out.i = Some(tri_join(ia, ib));
                    },
                    None     : {},
                },
                None : {},
            }
            match (tn.l)
            {
                Some(la) : match (fn_.l)
                {
                    Some(lb) :
                    {
                        if (la == lb)
                        {
                            out.l = Some(la);
                        }
                    },
                    None     : {},
                },
                None : {},
            }
            out
        };
        put_facts(&mut b.flow, n, &j);
    }
    Flow { unreachable, deriv, rooted, excl_rooted, indexed, .. } = joined;
    b.flow.unreachable = unreachable;
    b.flow.deriv = deriv;
    b.flow.rooted = rooted;
    b.flow.excl_rooted = excl_rooted;
    b.flow.indexed = indexed;
    // D-0341 (report 409): a branch that is a variant literal nothing typed
    // (`Ok(true)`) has the type its payload fixes, its other slots open, for
    // `if_result` to fill from the other branch.
    if (Option::is_none(&tt) && Option::is_none(expected))
    {
        match (&x.then_.tail)
        {
            Some(t) : tt = partial_variant_type(b, it, Box::get(t)),
            None    : {},
        }
    }
    if (Option::is_none(&ft) && Option::is_none(expected))
    {
        match (&x.else_)
        {
            Some(fe) :
            {
                ref<Expr, shared> last = match (&strip_parens_tc(fe).kind)
                {
                    ExprKind::EBlock(bl) : match (&bl.tail)
                    {
                        Some(t) : Box::get(t),
                        None    : fe,
                    },
                    _ : fe,
                };
                ft = partial_variant_type(b, it, last);
            },
            None     : {},
        }
    }
    if_result(x, false, tt, ft, hinted)
}

fn check_return(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Option<Box<Expr>>, shared> v,
    usize line,
) : Result<Option<Type>, String>
{
    Option<Type> rt = match (&b.closure_ret)
    {
        Some(r) : clone(r),
        None    : Some(clone(&b.ret)),
    };
    // `[T-Return]`: the value's type is the enclosing function's (or
    // closure's) result type; a bare `return` gives `()`.
    str what = if (Option::is_some(&b.closure_ret)) { "closure" } else { "function" };
    // D-0340 §13: a `: never` function does not return.
    if (Option::is_none(&b.closure_ret) && is_never(&b.ret))
    {
        return Err(named_diag(
            "diag.never-returns",
            &with_repair(
                "this function is declared `: never`, so it does not return; end this path with a `never` call (`exit(1)`, …) instead of `return`",
                "",
            ),
        ));
    }
    match (v)
    {
        Some(eb) :
        {
            ref<Expr, shared> e = Box::get(eb);
            check_escape_to_caller(b, it, e)?;
            check_holder_escape_to_caller(b, it, e, &rt)?;
            result_ref_reach(b, it, e, &rt);
            bool ok = result_reach_ok(b, it, e, &rt);
            bool saved_holding = replace(&mut b.holding, ok);
            Result<Option<Type>, String> t0 = check_store_operand(b, it, e, &rt);
            b.holding = saved_holding;
            Option<Type> t = t0?;
            if (closure_result_open(b))
            {
                match (&t)
                {
                    Some(tt) : Vec::push(&mut b.closure_exits, ClosureExitAt { .exit = ClosureExit::Return(Some(clone(tt))), .line = line }),
                    None     : {},
                }
            }
            match (&t)
            {
                Some(tt) : match (&rt)
                {
                    Some(want) :
                    {
                        if (!has_unresolved_marker(tt) && !has_unresolved_marker(want) && !is_never(tt) && !ty_compat(
                            tt,
                            want,
                        ))
                        {
                            if (type_eq(want, &Type::TVoid))
                            {
                                return Err(mismatch(sprintf(
                                    "this %s has no result, so `return` takes no value (this one gives `%s`)",
                                    what,
                                    &type_display(tt),
                                )));
                            }
                            // Bug 248: the hint names the value as written,
                            // and is the repair when there is one.
                            String hint = conversion_hint(want, tt, Some(e));
                            String m = sprintf(
                                "this `return` gives `%s`, but the %s's result is `%s`%s",
                                &type_display(tt),
                                what,
                                &type_display(want),
                                &hint,
                            );
                            return Err(mismatch(if (StringView::len(&hint) > 0) { with_repair(&m, "") } else { m }));
                        }
                    },
                    None       : {},
                },
                None : {},
            }
        },
        None     :
        {
            if (closure_result_open(b))
            {
                Vec::push(&mut b.closure_exits, ClosureExitAt { .exit = ClosureExit::Return(None), .line = line });
            }
            match (&rt)
            {
                Some(want) :
                {
                    if (!type_eq(want, &Type::TVoid) && !is_never(want) && !has_unresolved_marker(want))
                    {
                        return Err(mismatch(sprintf(
                            "a bare `return` gives no value, but the %s's result is `%s`: write `return value;`",
                            what,
                            &type_display(want),
                        )));
                    }
                },
                None       : {},
            }
        },
    }
    // An edge to the function exit: nothing follows here.
    b.flow.unreachable = true;
    Ok(Some(Type::TNever))
}

// Bug 258 (D-0337): C's `break;` at the end of a `switch` case, written at
// the end of a `match` arm's block inside a loop, leaves the loop: a
// warning when the arm reads as a `switch` case: its pattern is a bare
// literal (an integer, a byte, a `bool`, text; not `Some(true)`) and its block does something before
// the `break;` (`1 : { …; break; }`). A variant's arm that leaves the loop
// (`None : { …; break; }`, `Err(e) : { log(e); break; }`), an arm that is
// only `{ break; }`, and `break` written as the block's value (no `;`) or as
// the arm's value never warn.
fn match_arm_break_notes(ref<Body, exclusive> b, ref<Vec<Arm>, shared> arms)
{
    if (b.while_depth == 0 || b.facts.silent || StringView::starts_with(&b.fn_name, "std::"))
    {
        return;
    }
    Vec<LineCol> at = Vec::new();
    Vec<bool> literal = Vec::new();
    foreach (arm in arms)
    {
        match (arm_ending_break(Box::get(&arm.body)))
        {
            Some(lc) :
            {
                Vec::push(&mut at, lc);
                Vec::push(&mut literal, Option::is_some(&arm.lit) && Option::is_none(&arm.variant));
            },
            None     : {},
        }
    }
    for (usize i = 0; i < Vec::len(&at); i += 1)
    {
        if (literal[i])
        {
            Vec::push(&mut b.facts.retired_notes, RetiredNote { .line = at[i].line, .col = at[i].col, .text = String::copy(
                "warning[diag.match-arm-break]: this `break` leaves the enclosing loop, not only the `match`: an arm never runs on into the next, so it needs no `break`; delete it, or, to leave the loop, write `break` as the block's value, without `;` (`{ …; break }`)",
            ) });
        }
    }
}

// Where an arm's block ends with the statement `break;` after others, if
// it does.
fn arm_ending_break(ref<Expr, shared> body) : Option<LineCol>
{
    ref<Block, shared> bl = match (&body.kind)
    {
        ExprKind::EBlock(bl) : bl,
        _                    : return None,
    };
    usize n = Vec::len(&bl.stmts);
    // `{ break; }` alone is a deliberate stop; C's case does work first.
    if (Option::is_some(&bl.tail) || n < 2)
    {
        return None;
    }
    match (&bl.stmts[n - 1])
    {
        Stmt::SExpr(x) : match (&Box::get(x).kind)
        {
            ExprKind::EBreak : Some(LineCol { .line = Box::get(x).line, .col = Box::get(x).col }),
            _                : None,
        },
        _ : None,
    }
}

fn check_break(ref<Body, exclusive> b, bool is_break) : Result<Option<Type>, String>
{
    if (b.while_depth == 0)
    {
        // Bug 258: `break` and `continue` leave a loop; a `match` arm
        // needs no `break`.
        return Err(named_diag(
            "diag.break-outside-loop",
            &with_repair(
                &sprintf(
                    "`%s` leaves a loop, and there is none around it here",
                    if (is_break) { "break" } else { "continue" },
                ),
                "move it into the loop it is meant to leave; a `match` arm needs no `break` (an arm never runs on into the next), and `return` leaves the function",
            ),
        ));
    }
    // An edge to the loop exit / the loop test.
    Flow st = clone(&b.flow);
    usize n = Vec::len(&b.loops);
    if (n > 0)
    {
        if (is_break)
        {
            Vec::push(&mut b.loops[n - 1].breaks, st);
        }
        else
        {
            Vec::push(&mut b.loops[n - 1].continues, st);
        }
    }
    b.flow.unreachable = true;
    Ok(Some(Type::TNever))
}

// ---- part 7 ----

fn step_stmt(ref<Expr, shared> s) : Stmt
{
    Stmt::SExpr(Box::new(clone(s)))
}

// `while (c) b`: a back edge from the end of the body (and every
// `continue`) to the test; the exit is the test's false edge joined with
// every `break`. The head state is iterated to its fixed point with
// refutations suppressed, then the body is walked once more. A `for`
// loop's `step` runs on the state after the body joined with every
// `continue`'s.
// Report 313: the block a loop is in, while its rounds are checked
// (`Body.loop_marks`).
fn check_while(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> c,
    ref<Block, shared> body,
    Option<ref<Expr, shared>> step,
) : Result<Option<Type>, String>
{
    usize top = b.block_stack[Vec::len(&b.block_stack) - 1];
    Vec::push(&mut b.loop_marks, top);
    Result<Option<Type>, String> r = check_while_in(b, it, c, body, step);
    _ = Vec::pop(&mut b.loop_marks);
    r
}

fn check_while_in(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> c,
    ref<Block, shared> body,
    Option<ref<Expr, shared>> step,
) : Result<Option<Type>, String>
{
    Flow entry = clone(&b.flow);
    Flow head = clone(&entry);
    // D-0175: `while (true)` leaves only by `break`.
    bool forever = match (&c.kind)
    {
        ExprKind::EBool(v) : *v,
        _                  : false,
    };
    bool outer_report = b.report;
    Flow exit = new_flow();
    usize iterations = 0;
    // Bug 019: a loop entered again with a flow it was entered with before
    // (in an enclosing loop's later round, or its reporting pass) has the
    // same fixed point, so its rounds are not run again: each round of a
    // loop ran every round of the loops inside it from the start, which was
    // exponential in the depth of nesting.
    bool known = false;
    if (c.id != 0)
    {
        match (HashMap::get(&b.loops_seen, c.id))
        {
            Some(seen) :
            {
                for (usize k = 0; k < Vec::len(seen) && !known; k += 1)
                {
                    if (flow_eq(&seen[k].entry, &entry))
                    {
                        known = true;
                        head = clone(&seen[k].head);
                        exit = clone(&seen[k].exit);
                    }
                }
                // Else the rounds start from the fixed point of an entry
                // below this one (that the join with this one leaves this
                // one), joined with this one: it lies between this entry
                // and this entry's fixed point, so the rounds reach the
                // same fixed point, in fewer rounds (an enclosing loop's
                // later round enters with less known than its first).
                for (usize k = Vec::len(seen); k > 0 && !known; k -= 1)
                {
                    ref<LoopSeen, shared> sk = &seen[k - 1];
                    if (flow_eq(&flow_join(&sk.entry, &entry), &entry))
                    {
                        head = flow_join(&entry, &sk.head);
                        break;
                    }
                }
            },
            None       : {},
        }
    }
    while (!known)
    {
        b.report = false;
        Flow nf_22913 = clone(&head);
        flow_assign(b, nf_22913);
        Result<Option<Type>, String> cond_r = check_expr(b, it, c, &Some(Type::TBool));
        Flow after_cond = clone(&b.flow);
        Vec::push(&mut b.loops, LoopCtx { .breaks = Vec::new(), .continues = Vec::new() });
        b.while_depth += 1;
        Result<Option<Type>, String> r = check_nested_block(b, it, body, &None);
        b.while_depth -= 1;
        LoopCtx ctx = Option::unwrap_or(
            Vec::pop(&mut b.loops),
            LoopCtx { .breaks = Vec::new(), .continues = Vec::new() },
        );
        // Bug 247 (D-0323): when the body fails too, the condition's error,
        // the earlier, is the one reported.
        if (Result::is_err(&r))
        {
            cond_r?;
        }
        r?;
        Flow end = clone(&b.flow);
        for (usize i = 0; i < Vec::len(&ctx.continues); i += 1)
        {
            end = flow_join(&end, &ctx.continues[i]);
        }
        match (step)
        {
            Some(s) :
            {
                Flow nf_22934 = end;
                flow_assign(b, nf_22934);
                check_stmt(b, it, &step_stmt(s))?;
                end = clone(&b.flow);
            },
            None    : {},
        }
        b.report = outer_report;
        Flow new_head = flow_join(&entry, &end);
        exit = after_cond;
        if (forever)
        {
            exit.unreachable = true;
        }
        for (usize i = 0; i < Vec::len(&ctx.breaks); i += 1)
        {
            exit = flow_join(&exit, &ctx.breaks[i]);
        }
        iterations += 1;
        if (flow_eq(&new_head, &head))
        {
            break;
        }
        // D-0300: a head still moving after 16 rounds is joined with what the
        // body gives it from then on, so the round it stops at is the least
        // fixed point.
        if (iterations > 16)
        {
            Flow widened = flow_truncated(flow_join(&head, &new_head), 8);
            if (flow_eq(&widened, &head))
            {
                break;
            }
            if (iterations > 4096)
            {
                return Err("internal: the flow analysis of a loop did not reach a fixed point (rule.control.flow-analysis)");
            }
            head = widened;
            continue;
        }
        head = new_head;
    }
    b.report = outer_report;
    if (!known && c.id != 0)
    {
        ref<Vec<LoopSeen>, exclusive> seen = HashMap::entry(&mut b.loops_seen, c.id, Vec::new());
        if (Vec::len(seen) >= LOOPS_SEEN)
        {
            drop(Vec::remove(seen, 0));
        }
        Vec::push(seen, LoopSeen { .entry = entry, .head = clone(&head), .exit = clone(&exit) });
    }
    if (outer_report)
    {
        Flow nf_22987 = head;
        flow_assign(b, nf_22987);
        check_expect(b, it, c, &Type::TBool)?;
        Flow after_cond = clone(&b.flow);
        Vec::push(&mut b.loops, LoopCtx { .breaks = Vec::new(), .continues = Vec::new() });
        b.while_depth += 1;
        Result<Option<Type>, String> r = check_nested_block(b, it, body, &None);
        b.while_depth -= 1;
        LoopCtx ctx = Option::unwrap_or(
            Vec::pop(&mut b.loops),
            LoopCtx { .breaks = Vec::new(), .continues = Vec::new() },
        );
        r?;
        match (step)
        {
            Some(s) :
            {
                Flow end = clone(&b.flow);
                for (usize i = 0; i < Vec::len(&ctx.continues); i += 1)
                {
                    end = flow_join(&end, &ctx.continues[i]);
                }
                Flow nf_23008 = end;
                flow_assign(b, nf_23008);
                check_stmt(b, it, &step_stmt(s))?;
            },
            None    : {},
        }
        exit = after_cond;
        if (forever)
        {
            exit.unreachable = true;
        }
        for (usize i = 0; i < Vec::len(&ctx.breaks); i += 1)
        {
            exit = flow_join(&exit, &ctx.breaks[i]);
        }
    }
    bool nev = forever && exit.unreachable;
    Flow nf_23024 = exit;
    flow_assign(b, nf_23024);
    Ok(Some(if (nev) { Type::TNever } else { Type::TVoid }))
}

struct LitTy
{
    IntTy t;
    bool defaulted;
}

// A literal's integer type from its suffix and the type its context
// expects, and whether it was defaulted.
fn int_of_literal(ref<Option<String>, shared> suffix, ref<Option<Type>, shared> expected) : LitTy
{
    match (suffix)
    {
        Some(s) :
        {
            if (*s == "byte")
            {
                return match (expected)
                {
                    Some(Type::TInt(t)) : if (!int_ty_signed(*t)) { LitTy { .t = *t, .defaulted = false } } else { LitTy { .t = IntTy::U8, .defaulted = false } },
                    _                   : LitTy { .t = IntTy::U8, .defaulted = false },
                };
            }
            match (int_ty_from(s))
            {
                Some(t) : LitTy { .t = t, .defaulted = false },
                None    : LitTy { .t = IntTy::I32, .defaulted = true },
            }
        },
        None : match (expected)
        {
            Some(Type::TInt(t)) : LitTy { .t = *t, .defaulted = false },
            _                   : LitTy { .t = IntTy::I32, .defaulted = true },
        },
    }
}

fn int_lit_fits(IntTy t, u128 v) : bool
{
    if (t == IntTy::U128)
    {
        return true;
    }
    IntRange r = int_range(t);
    if (int_ty_signed(t))
    {
        return reinterpret<i128>(v) <= r.max && r.min < 0;
    }
    v <= reinterpret<u128>(r.max)
}

fn int_lit_range_msg(StringView text, IntTy t, bool defaulted) : String
{
    IntRange r = int_range(t);
    String why = if (defaulted)
    {
        sprintf(
            "; nothing here fixes its type, so it is `%s` -- write `%s: T` for the type you mean",
            int_ty_name(t),
            text,
        )
    }
    else
    {
        String::new()
    };
    String msg = sprintf("`%s` does not fit `%s` (%v to %v)%s", text, int_ty_name(t), r.min, r.max, &why);
    named_diag("diag.literal-out-of-range", &msg)
}

fn unbounded_msg(str what) : String
{
    String msg = sprintf(
        "%s on a value of a type parameter: a generic `T` has no operations of its own; give it a bound (`T: eq`, `ordered`, `number` or `integer`, D-0090), or pass the operation in as a `fn` parameter, as `Vec::sort_by` takes `less`",
        what,
    );
    named_diag("diag.unbounded-type-parameter", &msg)
}

// Whether a branch is a literal expression, through parentheses and a
// block (`is_literal_block`: no statements, its tail such a branch).
fn is_literal_branch(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EBlock(blk) : is_literal_block(blk),
        ExprKind::EParen(x)   : is_literal_branch(Box::get(x)),
        _                     : is_literal_expr(e),
    }
}

fn is_literal_block(ref<Block, shared> blk) : bool
{
    Vec::len(&blk.stmts) == 0 && match (&blk.tail)
    {
        Some(t) : is_literal_branch(Box::get(t)),
        None    : false,
    }
}

// A marker type the expected type is, when its bound is `number` (D-0090).
fn number_marker(ref<Body, shared> b, ref<Option<Type>, shared> expected) : Option<Type>
{
    match (expected)
    {
        Some(m) :
        {
            if (!is_marker(m))
            {
                return None;
            }
            String mn = Option::expect(marker_of(m), "a marker");
            match (HashMap::get(&b.marker_bounds, &mn))
            {
                Some(have) : if (bound_implies(*have, Bound::BNumber)) { Some(clone(m)) } else { None },
                None       : None,
            }
        },
        None    : None,
    }
}

// `[T-Bound-Literal]` for a call argument (report 338): the parameter type of
// argument `i` with the type parameters the checked arguments and the
// expected result fix, markers included, when that is a `number` marker.
fn bound_literal_hint(
    ref<Body, shared> b,
    ref<FnDecl, shared> f,
    ref<Vec<Option<Type>>, shared> by_index,
    ref<Vec<bool>, shared> checked,
    ref<Vec<Type>, shared> explicit,
    ref<Option<Type>, shared> expected,
    usize i,
) : Option<Type>
{
    HashMap<String, Type> mk = explicit_subst(f, explicit);
    for (usize j = 0; j < Vec::len(by_index); j += 1)
    {
        if (checked[j] && j < Vec::len(&f.params))
        {
            match (&by_index[j])
            {
                Some(t) : unify_type_shape(&f.params[j].ty, t, &mut mk, &f.type_params),
                None    : {},
            }
        }
    }
    match (expected)
    {
        Some(exp) : unify_type_shape(&f.ret, exp, &mut mk, &f.type_params),
        None      : {},
    }
    Option<Type> h = Some(apply_subst(&f.params[i].ty, &mk));
    match (number_marker(b, &h))
    {
        Some(m) : Some(m),
        None    : None,
    }
}

fn check_int_lit(
    ref<Body, shared> b,
    u128 v,
    ref<Option<String>, shared> suffix,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // D-0090: an unsuffixed literal where a `number` type parameter is
    // expected is of that type.
    if (Option::is_none(suffix))
    {
        match (number_marker(b, expected))
        {
            Some(m) : return Ok(Some(m)),
            None    : {},
        }
        // Bug 345: `[T-Bound-Literal]` gives a literal the type of a type
        // parameter only when its bound implies `number`; refused where it
        // is written, not at an instantiation that cannot take it.
        match (expected)
        {
            Some(m) :
            {
                if (is_marker(m))
                {
                    match (subst_param_of(b, m))
                    {
                        Some(tp) :
                        {
                            return Err(mismatch(with_repair(
                                &sprintf(
                                    "an integer literal where `%s` is expected needs the bound `%s: number` (or `integer`), which gives a type parameter its literals (`[T-Bound-Literal]`); `%s` has no such bound",
                                    &tp,
                                    &tp,
                                    &tp,
                                ),
                                &sprintf("declare `<%s: number>`, or pass the starting value in as a parameter", &tp),
                            )));
                        },
                        None     : {},
                    }
                }
            },
            None    : {},
        }
    }
    LitTy lt = int_of_literal(suffix, expected);
    if (!int_lit_fits(lt.t, v))
    {
        return Err(int_lit_range_msg(&sprintf("%v", v), lt.t, lt.defaulted));
    }
    Ok(Some(Type::TInt(lt.t)))
}

fn check_unary(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    UnOp op,
    ref<Expr, shared> inner,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // The most negative literal (`-2147483648`): its negated value is
    // checked here, before the bare positive literal would be.
    if (op == UnOp::Neg)
    {
        match (&inner.kind)
        {
            ExprKind::EInt(lb) :
            {
                ref<IntLit, shared> lit = Box::get(lb);
                if (Option::is_none(&lit.sfx))
                {
                    // D-0090: `-1` where a `number` type parameter is expected.
                    match (number_marker(b, expected))
                    {
                        Some(m) :
                        {
                            HashSet::insert(&mut b.facts.number_literals, inner.id);
                            return Ok(Some(m));
                        },
                        None    : {},
                    }
                    if (is_float_opt(expected) && HashSet::contains(&b.facts.number_literals, inner.id))
                    {
                        return Ok(clone(expected));
                    }
                }
                LitTy lt = int_of_literal(&lit.sfx, expected);
                // `[T-Neg]`: unary minus needs a signed or float operand.
                if (!int_ty_signed(lt.t))
                {
                    // Bug 128: Python's `v[-1]`.
                    str last = if (lt.t == IntTy::Usize) { "; an index is a `usize`, counted from 0: the last element is `v[$ - 1]`" } else { "" };
                    return Err(mismatch(sprintf(
                        "`-` needs a signed or floating-point operand, but this is `%s`%s",
                        int_ty_name(lt.t),
                        last,
                    )));
                }
                u32 bw = int_ty_bits(lt.t, 64);
                u128 top = 1;
                top = top << 127;
                String text = sprintf("-%v", lit.v);
                i128 neg = 0;
                if (bw >= 128)
                {
                    if (lit.v == top)
                    {
                        neg = min_value<i128>();
                    }
                    else if (lit.v < top)
                    {
                        neg = 0 - reinterpret<i128>(lit.v);
                    }
                    else
                    {
                        return Err(int_lit_range_msg(&text, lt.t, lt.defaulted));
                    }
                }
                else
                {
                    neg = wrapping_sub(0, reinterpret<i128>(lit.v));
                }
                IntRange r = int_range(lt.t);
                if (neg < r.min || neg > r.max)
                {
                    return Err(int_lit_range_msg(&text, lt.t, lt.defaulted));
                }
                return Ok(Some(Type::TInt(lt.t)));
            },
            _                  : {},
        }
    }
    Option<Type> ti = check_expr(b, it, inner, expected)?;
    match (&ti)
    {
        Some(m) :
        {
            if (is_marker(m))
            {
                // D-0090: `-x` needs `number`, `~x` `integer`.
                String mn = Option::expect(marker_of(m), "a marker");
                if (op == UnOp::Not)
                {
                    return Err(unbounded_msg("a unary operator"));
                }
                Bound need = if (op == UnOp::Neg) { Bound::BNumber } else { Bound::BInteger };
                str sym = if (op == UnOp::Neg) { "-" } else { "~" };
                bool has = match (HashMap::get(&b.marker_bounds, &mn))
                {
                    Some(have) : bound_implies(*have, need),
                    None       : false,
                };
                if (has)
                {
                    return Ok(Some(clone(m)));
                }
                return Err(bound_msg(b, &mn, sym, need));
            }
        },
        None    : {},
    }
    // D-0254: `-` on a `simd` of a signed integer or a float, `~` on one of
    // an integer, lane by lane.
    match (&ti)
    {
        Some(Type::TSimd(sb)) :
        {
            ref<Type, shared> lt = &Box::get(sb).inner;
            bool ok = if (op == UnOp::Neg)
            {
                match (lt)
                {
                    Type::TF32    : true,
                    Type::TF64    : true,
                    Type::TInt(t) : int_ty_signed(*t),
                    _             : false,
                }
            }
            else if (op == UnOp::BitNot)
            {
                match (lt)
                {
                    Type::TInt(_) : true,
                    _             : false,
                }
            }
            else
            {
                false
            };
            if (!ok)
            {
                str sym = if (op == UnOp::Neg) { "-" } else if (op == UnOp::BitNot) { "~" } else { "!" };
                return Err(mismatch(sprintf(
                    "`%s` does not apply to a `%s`: `-` takes a simd of a signed integer or a float, `~` one of an integer; a mask is inverted with `~`",
                    sym,
                    &type_display(&Option::expect(clone(&ti), "a simd")),
                )));
            }
            return Ok(clone(&ti));
        },
        _                     : {},
    }
    match (&ti)
    {
        Some(t) :
        {
            if (op == UnOp::Neg)
            {
                match (t)
                {
                    Type::TInt(i) :
                    {
                        if (!int_ty_signed(*i))
                        {
                            return Err(mismatch(sprintf(
                                "`-` needs a signed or floating-point operand, but this is `%s`",
                                int_ty_name(*i),
                            )));
                        }
                    },
                    Type::TF32    : {},
                    Type::TF64    : {},
                    Type::TNever  : {},
                    _             :
                    {
                        if (!has_unresolved_marker(t))
                        {
                            return Err(mismatch(sprintf(
                                "`-` needs a signed or floating-point operand, but this is `%s`",
                                &type_display(t),
                            )));
                        }
                    },
                }
            }
            else if (op == UnOp::BitNot)
            {
                match (t)
                {
                    Type::TBool   : return Err(mismatch("`~` inverts an integer's bits; for a `bool` write `!`")),
                    Type::TInt(_) : {},
                    Type::TNever  : {},
                    _             :
                    {
                        if (!has_unresolved_marker(t))
                        {
                            return Err(mismatch(sprintf("`~` needs an integer, but this is `%s`", &type_display(t))));
                        }
                    },
                }
            }
            else
            {
                match (t)
                {
                    Type::TBool : return Ok(Some(Type::TBool)),
                    _           :
                    {
                        if (!has_unresolved_marker(t))
                        {
                            bool int_t = match (t)
                            {
                                Type::TInt(_) : true,
                                _             : false,
                            };
                            return Err(mismatch(sprintf(
                                "`!` needs a `bool`, but this is `%s`%s",
                                &type_display(t),
                                if (int_t) { "; for the bitwise complement of an integer write `~`" } else { "" },
                            )));
                        }
                    },
                }
            }
        },
        None    : {},
    }
    Ok(ti)
}

// An operand whose type comes from the other operand: an unsuffixed
// literal, or an enum literal whose type arguments are left to context.
fn takes_expected(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::ECall(cb) :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            if (Vec::len(&c.args) == 1)
            {
                return match (&c.callee.kind)
                {
                    ExprKind::EPath(pb) : Vec::len(&Box::get(pb).targs) == 0 && Option::is_some(&variant_enum(
                        it,
                        &Box::get(pb).segs,
                    )),
                    _ : false,
                };
            }
            is_bare_num_literal(e)
        },
        ExprKind::EParen(x) : takes_expected(b, it, Box::get(x)),
        _                   : is_bare_num_literal(e),
    }
}

fn place_is_string(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    match (static_place_type(b, it, e))
    {
        Some(t) : named_is(&t, "std::String"),
        None    : false,
    }
}

// D-0108: a comparison's operand, a `String` place borrowed shared.
fn check_text_operand(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e, ref<Option<Type>, shared> expected) : Result<Option<Type>, String>
{
    if (!text_place_operand(b, it, e))
    {
        return check_expr(b, it, e, expected);
    }
    b.place_pos = true;
    Option<Type> t = check_expr(b, it, e, &None)?;
    flow_borrow(b, it, e, Mode::Shared)?;
    Ok(t)
}

// A `String` or resource key place, borrowed for a comparison.
fn text_place_operand(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    (place_is_string(b, it, e) || is_resource_key_place(b, it, e)) && borrow_operand_kind(b, it, e) == OperandKind::Place
}

// Report 339: the type a comparison operand that is a variant or struct
// literal (`Some("a")`, `Pair { … }`) takes from the other operand; none
// for anything else (a text literal stays a `str`, `[Cmp-Text]`).
fn literal_operand_expected(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e, ref<Option<Type>, shared> other) : Option<Type>
{
    bool lit = match (&strip_parens_tc(e).kind)
    {
        ExprKind::EStructLit(_) : true,
        ExprKind::ECall(_)      : takes_expected(b, it, strip_parens_tc(e)),
        _                       : false,
    };
    if (lit) { clone(other) } else { None }
}

fn is_text_operand(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : bool
{
    if (place_is_string(b, it, e))
    {
        return true;
    }
    match (value_shape(b, it, e))
    {
        Some(t) :
        {
            if (named_is(&t, "std::String"))
            {
                return true;
            }
        },
        None    : {},
    }
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EStr(_) : true,
        _                 : false,
    }
}

fn is_cmp_op(BinOp op) : bool
{
    op == BinOp::Eq || op == BinOp::Ne || op == BinOp::Lt || op == BinOp::Le || op == BinOp::Gt || op == BinOp::Ge
}

fn is_order_op(BinOp op) : bool
{
    op == BinOp::Lt || op == BinOp::Le || op == BinOp::Gt || op == BinOp::Ge
}

fn is_view_opt(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(x) : named_is(x, "std::StringView"),
        None    : false,
    }
}

fn is_string_opt(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(x) : is_std_string(x),
        None    : false,
    }
}

fn is_str_opt(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(Type::TStr) : true,
        _                : false,
    }
}

fn is_marker_opt(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(x) : is_marker(x),
        None    : false,
    }
}

fn is_simd_opt(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(x) : is_simd(x),
        None    : false,
    }
}

// A text type: `str`, `String` or `StringView`.
fn is_text_opt(ref<Option<Type>, shared> t) : bool
{
    is_str_opt(t) || is_view_opt(t) || is_string_opt(t)
}

// Which text type (`is_text_opt`): 1 `str`, 2 `String`, 3 `StringView`.
fn text_kind(ref<Option<Type>, shared> t) : u8
{
    if (is_str_opt(t))
    {
        return 1;
    }
    if (is_string_opt(t))
    {
        return 2;
    }
    if (is_view_opt(t))
    {
        return 3;
    }
    0
}

// D-0312 `[Cmp-Through-Shared-Ref]`: `r` a shared reference compared with
// `other`, a value of what `r` refers to (or both text).
fn through_ref_cmp(ref<Items, shared> it, ref<Option<Type>, shared> r, ref<Option<Type>, shared> other) : bool
{
    match (r)
    {
        Some(Type::TRef(rb)) :
        {
            ref<ModedTy, shared> m = Box::get(rb);
            if (m.mode != Mode::Shared)
            {
                return false;
            }
            match (other)
            {
                Some(o) :
                {
                    bool o_ref = match (o)
                    {
                        Type::TRef(_) : true,
                        _             : false,
                    };
                    if (o_ref || has_unresolved_marker(&m.inner) || has_unresolved_marker(o))
                    {
                        return false;
                    }
                    Option<Type> inner = Some(clone(&m.inner));
                    (ty_compat(&m.inner, o) && (!is_resource_ty(it, &m.inner) || is_text_opt(&inner)) && !contains_fn(it, &m.inner)) || (is_text_opt(&inner) && is_text_opt(other))
                },
                None    : false,
            }
        },
        _                    : false,
    }
}

// Bug 162 (D-0336): a literal compared with a shared reference to a number
// takes the number's type, as `[Cmp-Through-Shared-Ref]` compares the
// number: `count > 5` for a `foreach` binder `count: ref<u32, shared>`.
fn cmp_literal_expected(BinOp op, ref<Expr, shared> lit, ref<Option<Type>, shared> other) : Option<Type>
{
    if (is_cmp_op(op) && is_literal_expr(lit))
    {
        match (other)
        {
            Some(Type::TRef(rb)) :
            {
                ref<ModedTy, shared> m = Box::get(rb);
                if (m.mode == Mode::Shared && is_numeric_ty(&m.inner))
                {
                    return Some(clone(&m.inner));
                }
            },
            _                    : {},
        }
    }
    clone(other)
}

fn check_binary(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    BinOp op,
    ref<Expr, shared> a,
    ref<Expr, shared> c,
    ref<Expr, shared> whole,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // D-0340 §1: a value folded on an earlier pass (a loop's) is not this one's.
    _ = HashMap::remove(&mut b.facts.folded, whole.id);
    // D-0037: an operator on literal expressions only takes the type its
    // context expects, when that is a number.
    Option<Type> numeric = match (expected)
    {
        Some(t) : if (is_numeric_ty(t)) { Some(clone(t)) } else { None },
        None    : None,
    };
    // D-0073: `+` does not join text.
    if (op == BinOp::Add && (is_text_operand(b, it, a) || is_text_operand(b, it, c)))
    {
        // Bug 260: its own diagnostic, whose `--explain` is about joining.
        return Err(named_diag(
            "diag.text-join",
            &with_repair(
                "`+` does not join text; append to a `String` with `String::append(&mut s, &t)` (or a `str`, a number), or build one with `sprintf(\"%s%s\", &s, &t)`",
                "",
            ),
        ));
    }
    // `==` on a resource other than text: say what to compare.
    if (op == BinOp::Eq || op == BinOp::Ne)
    {
        for (usize side = 0; side < 2; side += 1)
        {
            ref<Expr, shared> x = if (side == 0) { a } else { c };
            match (static_place_type(b, it, x))
            {
                Some(t) :
                {
                    if (!named_is(&t, "std::String") && !named_key_type(it, &t) && is_resource_ty(it, &t))
                    {
                        // Bug 058: what compares this type, and why `==` does not.
                        str sym = if (op == BinOp::Eq) { "==" } else { "!=" };
                        str neg = if (op == BinOp::Eq) { "" } else { "!" };
                        String msg = if (named_is(&t, "std::Vec"))
                        {
                            sprintf(
                                "`%s` compares numbers, `bool`s, text, and structs, enums and `Option`s of those, and a `%s` is none of these: compare two vectors with `%sVec::eq(&a, &b)` (their elements need `==`)",
                                sym,
                                &type_display(&t),
                                neg,
                            )
                        }
                        else
                        {
                            // Bug 343: the field that keeps it from `==`, a
                            // float among text too (a key type, D-0271).
                            String why = match (key_type_problem(it, &t, 0))
                            {
                                Some(pr) : pr,
                                None     : "it holds something else (a `Vec`, a `Box`, a hash table, a handle)",
                            };
                            bool float_field = StringView::ends_with(&why, "`f64`") || StringView::ends_with(&why, "`f32`");
                            if (float_field)
                            {
                                sprintf(
                                    "`%s` on a struct that holds text compares it as a key type (D-0271), whose fields are integers, `bool`s, text and such structs, and in `%s` %s, a float, whose `==` is no equivalence (NaN is not equal to itself): compare it field by field (`a.f == b.f && …`), or in a function of its own (`fn %s::eq(…) : bool`)",
                                    sym,
                                    &type_display(&t),
                                    &why,
                                    &type_display(&t),
                                )
                            }
                            else
                            {
                                sprintf(
                                    "`%s` compares numbers, `bool`s, text, and structs, enums and `Option`s of those, and in `%s` %s: compare it field by field, with `Vec::eq(&a.f, &b.f)` for a `Vec` field, or in a function of its own (`fn %s::eq(…) : bool`)",
                                    sym,
                                    &type_display(&t),
                                    &why,
                                    &type_display(&t),
                                )
                            }
                        };
                        return Err(named_diag("diag.read-of-resource", &with_repair(&msg, "")));
                    }
                },
                None    : {},
            }
        }
    }
    bool arith_op = op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul || op == BinOp::Div || op == BinOp::Rem || op == BinOp::BitAnd || op == BinOp::BitOr || op == BinOp::BitXor || op == BinOp::Shl || op == BinOp::Shr;
    bool literal_op = arith_op && is_literal_expr(whole);
    // D-0254: where a `simd` is expected, an arithmetic operator's operands
    // are of that type.
    bool simd_op = op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul || op == BinOp::Div || op == BinOp::BitAnd || op == BinOp::BitOr || op == BinOp::BitXor || op == BinOp::Shl || op == BinOp::Shr;
    Option<Type> simd_expected = if (simd_op && is_simd_opt(expected)) { clone(expected) } else { None };
    bool shift = op == BinOp::Shl || op == BinOp::Shr;
    Option<Type> at = None;
    Option<Type> bt = None;
    if (op == BinOp::And || op == BinOp::Or)
    {
        // `[And-True]`, `[Or-False]` (spec/13 §4): the right operand runs
        // only when the left does not decide, so the two states join, as an
        // `if` without `else` (CHG-0438).
        at = check_expr(b, it, a, &None)?;
        Flow before = clone(&b.flow);
        Vec<String> guarded = guard_push(b, a);
        Result<Option<Type>, String> br = check_expr(b, it, c, &clone(&at));
        guard_pop(b, &guarded);
        bt = br?;
        Flow nf_23665 = flow_join(&before, &b.flow);
        flow_assign(b, nf_23665);
    }
    else if (Option::is_some(&simd_expected))
    {
        at = check_expr(b, it, a, &simd_expected)?;
        bt = check_expr(b, it, c, &simd_expected)?;
    }
    else if (Option::is_some(&numeric) && literal_op)
    {
        at = check_expr(b, it, a, &numeric)?;
        bt = if (shift) { check_expr(b, it, c, &clone(&at))? } else { check_expr(b, it, c, &numeric)? };
    }
    else if (!shift && (takes_expected(b, it, a) || is_literal_expr(a)) && !takes_expected(b, it, c) && !is_literal_expr(c))
    {
        // (D-0037: a literal expression on the left takes the right
        // operand's type as a bare literal does.) A text or key place on
        // the right is borrowed for the comparison (report 339).
        bt = if (is_cmp_op(op) && text_place_operand(b, it, c)) { check_text_operand(b, it, c, &None)? } else { check_expr(b, it, c, &None)? };
        b.no_coerce = is_cmp_op(op);
        at = check_expr(b, it, a, &cmp_literal_expected(op, a, &bt))?;
    }
    else if (is_cmp_op(op) && (place_is_string(
        b,
        it,
        a,
    ) || place_is_string(b, it, c) || is_resource_key_place(b, it, a) || is_resource_key_place(b, it, c)))
    {
        // D-0108 `[Cmp-Text]`, D-0271 `[Cmp-Key]`: borrowed shared for the
        // comparison, not read whole. A variant or struct literal on the
        // other side takes the place's type (`o == Some("a")` with `o` an
        // `Option<String>`, report 339).
        if (!text_place_operand(b, it, a) && text_place_operand(b, it, c))
        {
            bt = check_text_operand(b, it, c, &None)?;
            at = check_text_operand(b, it, a, &literal_operand_expected(b, it, a, &bt))?;
        }
        else
        {
            at = check_text_operand(b, it, a, &None)?;
            bt = check_text_operand(b, it, c, &literal_operand_expected(b, it, c, &at))?;
        }
    }
    else
    {
        at = check_expr(b, it, a, &None)?;
        b.no_coerce = is_cmp_op(op);
        // Report 437: where the left operand's type is not known here (a
        // generic body's `foreach` index over a `Vec<T>`), a literal on the
        // right takes the type the context expects, as it would beside a
        // known operand of that type.
        bool left_open = match (&at)
        {
            Some(t) : has_unresolved_marker(t),
            None    : true,
        };
        Option<Type> right_want = if (left_open && arith_op && is_literal_expr(c) && Option::is_some(&numeric)) { clone(&numeric) } else { cmp_literal_expected(op, c, &at) };
        bt = check_expr(b, it, c, &right_want)?;
    }
    if (Option::is_none(&at))
    {
        // Report 358 (D-0339): a shift's left operand is not typed by the
        // amount: a literal there is of the expected type, else `i32`
        // (`[Literal-Default]`), as in C, Rust and Go.
        Option<Type> guide = if (shift)
        {
            match (&numeric)
            {
                Some(t) : Some(clone(t)),
                None    : Some(Type::TInt(IntTy::I32)),
            }
        }
        else { clone(&bt) };
        at = reguess(b, it, a, &guide);
    }
    // D-0322: an `assert`'s comparison of two scalars, outside a generic body
    // (whose instantiations could disagree), shows both values when it fails.
    if (is_cmp_op(op) && is_scalar_opt(&at) && is_scalar_opt(&bt) && HashMap::len(&b.subst) == 0 && HashSet::contains(&b.facts.assert_cmps, whole.id))
    {
        note_rewrite(
            b,
            whole,
            Rewrite::AssertValues(AssertValuesRewrite { .lt = Option::expect(clone(&at), "a scalar"), .rt = Option::expect(clone(&bt), "a scalar") }),
        );
    }
    // A variant compared with a value of another type (`1 == None`,
    // CHG-0438): checked against the other side's type.
    if (is_cmp_op(op))
    {
        if (Option::is_none(&bt))
        {
            variant_operand_fits(b, it, c, &at)?;
        }
        if (Option::is_none(&at))
        {
            variant_operand_fits(b, it, a, &bt)?;
        }
        ref_identity_note(b, op, a, c, &at, &bt);
    }
    if (is_marker_opt(&at) || is_marker_opt(&bt))
    {
        // `rule.type.kind`: an operator on a type parameter's value is the
        // bound's (D-0090).
        return check_bounded_binary(b, op, &at, &bt, is_literal_expr(c));
    }
    // `[T-Rawptr-Offset]` (spec/12 §5): `rawptr<τ> + isize : rawptr<τ>`.
    if (op == BinOp::Add)
    {
        match (&at)
        {
            Some(Type::TRawptr(_)) :
            {
                if (b.unsafe_depth == 0)
                {
                    return Err("diag.trusted-outside-unsafe");
                }
                return Ok(at);
            },
            _                      : {},
        }
    }
    // D-0254: an operator on a `simd` works lane by lane.
    if (is_simd_opt(&at) || is_simd_opt(&bt))
    {
        return simd_binary_type(op, &at, &bt);
    }
    // D-0312 `[Cmp-Through-Shared-Ref]`: a shared reference compared with a
    // value of what it refers to (text: of any text type) compares what it
    // refers to: `r` is `*r`. Two references keep `[Eq-Ref]`'s identity.
    if (is_cmp_op(op) && !b.facts.silent)
    {
        bool ra = through_ref_cmp(it, &at, &bt);
        bool rb = through_ref_cmp(it, &bt, &at);
        if (ra || rb)
        {
            note_rewrite(b, if (ra) { a } else { c }, Rewrite::DerefOperand);
            return Ok(Some(Type::TBool));
        }
    }
    // D-0312 §3.2: a whole text sliced as an operand is the text itself.
    if (is_text_opt(&at) && is_text_opt(&bt) && is_cmp_op(op))
    {
        Type view = Type::TNamed(Box::new(NamedTy { .name = "std::StringView", .args = Vec::new() }));
        whole_slice_lint(b, it, &view, a);
        whole_slice_lint(b, it, &view, c);
    }
    // D-0312 `[Cmp-Text]`: two texts of different types are ordered by their
    // bytes: `StringView::less` of their views.
    bool mixed = is_text_opt(&at) && is_text_opt(&bt) && text_kind(&at) != text_kind(&bt);
    if (mixed && is_order_op(op) && !b.facts.silent)
    {
        note_rewrite(
            b,
            whole,
            Rewrite::TextOrder(TextOrderRewrite { .swap = op == BinOp::Gt || op == BinOp::Le, .negate = op == BinOp::Le || op == BinOp::Ge, .borrow_left = is_string_opt(&at), .borrow_right = is_string_opt(&bt) }),
        );
        return Ok(Some(Type::TBool));
    }
    // D-0164: `==`/`!=` between a `String` and a `str` or a `StringView`
    // compares their text, rewritten to `String::eq_str`/`eq_view`.
    if ((is_string_opt(&at) && (is_str_opt(&bt) || is_view_opt(&bt))) || (is_string_opt(&bt) && (is_str_opt(&at) || is_view_opt(&at))))
    {
        bool string_left = is_string_opt(&at);
        bool other_is_str = if (string_left) { is_str_opt(&bt) } else { is_str_opt(&at) };
        if (op == BinOp::Eq || op == BinOp::Ne)
        {
            note_rewrite(
                b,
                whole,
                Rewrite::TextEq(TextEqRewrite { .string_left = string_left, .other_is_str = other_is_str, .negate = op == BinOp::Ne }),
            );
            return Ok(Some(Type::TBool));
        }
        if (is_order_op(op))
        {
            return Err(mismatch("`<`, `<=`, `>`, `>=` order texts by their bytes, any two of `str`, `String` and `StringView` (`[Cmp-Text]`, D-0312)"));
        }
        return Err(mismatch(sprintf(
            "the operands are `%s` and `%s`, which cannot be combined",
            &type_display(&Option::expect(clone(&at), "a type")),
            &type_display(&Option::expect(clone(&bt), "a type")),
        )));
    }
    // D-0053: `==`/`!=` with a `StringView` compares text; D-0108: two
    // views are ordered by their bytes.
    if (is_view_opt(&at) || is_view_opt(&bt))
    {
        bool view_left = is_view_opt(&at);
        bool other_is_str = if (view_left) { is_str_opt(&bt) } else { is_str_opt(&at) };
        bool other_view = if (view_left) { is_view_opt(&bt) } else { is_view_opt(&at) };
        if (!(other_is_str || other_view))
        {
            return Err("diag.type-mismatch");
        }
        ViewOp vo = ViewOp::KeyCmp;
        if (op == BinOp::Eq || op == BinOp::Ne)
        {
            vo = ViewOp::VEq(ViewEq { .view_left = view_left, .other_is_str = other_is_str, .negate = op == BinOp::Ne });
        }
        else if (is_order_op(op) && !other_is_str)
        {
            vo = ViewOp::VLess(ViewLess { .swap = op == BinOp::Gt || op == BinOp::Le, .negate = op == BinOp::Le || op == BinOp::Ge });
        }
        else if (is_order_op(op))
        {
            return Err(mismatch(TEXT_ORDER_HELP));
        }
        else
        {
            return Err(mismatch("a `StringView` has `==`, `!=`, `<`, `<=`, `>`, `>=` only"));
        }
        HashMap::insert(&mut b.facts.view_ops, whole.id, vo);
        return Ok(Some(Type::TBool));
    }
    // `[Eq-Str]` and `[Cmp-Text]` are the only operators on `str`.
    if ((is_str_opt(&at) || is_str_opt(&bt)) && !is_cmp_op(op))
    {
        // Bug 260: `"a" + "b"` gets the joining forms too.
        if (op == BinOp::Add)
        {
            return Err(named_diag(
                "diag.text-join",
                &with_repair(
                    "`+` does not join text, and `str` has only the comparisons; build a `String` with `sprintf(\"%s%s\", a, b)`, or append to one with `String::append(&mut s, t)`",
                    "",
                ),
            ));
        }
        return Err(mismatch("`str` has only the comparisons `==`, `!=`, `<`, `<=`, `>`, `>=`"));
    }
    if (op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul || op == BinOp::Div || op == BinOp::Rem || op == BinOp::BitAnd || op == BinOp::BitOr || op == BinOp::BitXor)
    {
        match (&at)
        {
            Some(ta) : match (&bt)
            {
                Some(tb) :
                {
                    if (!has_unresolved_marker(ta) && !has_unresolved_marker(tb))
                    {
                        if (!ty_compat(ta, tb))
                        {
                            return Err(mismatch(sprintf(
                                "the operands are `%s` and `%s`; %s",
                                &type_display(ta),
                                &type_display(tb),
                                &operand_hint(ta, tb, a, c),
                            )));
                        }
                        // `[T-Arith]`: an integer type, or a float for
                        // `+ - * /` only.
                        str sym = op_symbol(op);
                        match (ta)
                        {
                            Type::TInt(i) : check_literal_fold_overflow(b, op, *i, a, c, whole.id)?,
                            Type::TNever  : {},
                            Type::TF32    : check_float_arith(op, ta, sym)?,
                            Type::TF64    : check_float_arith(op, ta, sym)?,
                            Type::TBool   :
                            {
                                if (op == BinOp::BitAnd || op == BinOp::BitOr || op == BinOp::BitXor)
                                {
                                    return Err(mismatch(sprintf(
                                        "`%s` is defined for integers only; for `bool` write `&&`, `||` or `!=`",
                                        sym,
                                    )));
                                }
                                return Err(mismatch(sprintf(
                                    "`%s` is arithmetic, defined for numbers, not `%s`",
                                    sym,
                                    &type_display(ta),
                                )));
                            },
                            _ : return Err(mismatch(sprintf(
                                "`%s` is arithmetic, defined for numbers, not `%s`",
                                sym,
                                &type_display(ta),
                            ))),
                        }
                    }
                },
                None     : {},
            },
            None : {},
        }
        return Ok(or_type(at, bt));
    }
    if (shift)
    {
        // `[T-Shift]`: the shifted operand is an integer.
        match (&at)
        {
            Some(t) :
            {
                bool int_or_never = match (t)
                {
                    Type::TInt(_) : true,
                    Type::TNever  : true,
                    _             : false,
                };
                if (!int_or_never && !has_unresolved_marker(t))
                {
                    str tail = if (is_float_type(t)) { "; a float's bits are `reinterpret<u64>(x)` (or `u32` for `f32`)" } else { "" };
                    return Err(mismatch(sprintf(
                        "`%s` shifts an integer's bits, and this is `%s`%s",
                        if (op == BinOp::Shl) { "<<" } else { ">>" },
                        &type_display(t),
                        tail,
                    )));
                }
            },
            None    : {},
        }
        // `[T-Shift]`: the amount is a `u32` (a literal takes it).
        match (&bt)
        {
            Some(Type::TInt(k)) :
            {
                if (*k != IntTy::U32 && !is_literal_expr(c))
                {
                    return Err(mismatch(sprintf(
                        "a shift amount is a `u32`, and this is `%s`: convert it with `%s<u32>(n)`",
                        int_ty_name(*k),
                        if (int_ty_bits(*k, 64) < 32) { "widen" } else { "narrow" },
                    )));
                }
            },
            _                   : {},
        }
        // `[Shift-Amount-Invalid]`: a literal amount at or beyond the bit
        // width is rejected here.
        match (&at)
        {
            Some(Type::TInt(i)) : match (known_value(b, c))
            {
                Some(n) :
                {
                    if (n < 0 || n >= widen<i128>(int_ty_bits(*i, 64)))
                    {
                        return Err("diag.shift-amount-out-of-range");
                    }
                },
                None    : {},
            },
            _ : {},
        }
        return Ok(at);
    }
    if (is_cmp_op(op))
    {
        return check_comparison(b, it, op, a, c, whole, &at, &bt);
    }
    // `[T-Logic]`: both operands `bool`.
    str sym = if (op == BinOp::And) { "&&" } else { "||" };
    for (usize side = 0; side < 2; side += 1)
    {
        ref<Option<Type>, shared> ot = if (side == 0) { &at } else { &bt };
        match (ot)
        {
            Some(t) :
            {
                bool ok = match (t)
                {
                    Type::TBool  : true,
                    Type::TNever : true,
                    _            : false,
                };
                if (!ok && !has_unresolved_marker(t))
                {
                    return Err(mismatch(match (t)
                    {
                        Type::TInt(_) : sprintf(
                            "`%s` joins `bool`s, and this is `%s`; for a number write `n != 0`",
                            sym,
                            &type_display(t),
                        ),
                        _ : sprintf("`%s` joins `bool`s, and this is `%s`", sym, &type_display(t)),
                    }));
                }
            },
            None    : {},
        }
    }
    Ok(Some(Type::TBool))
}

fn check_float_arith(BinOp op, ref<Type, shared> ta, str sym) : Result<void, String>
{
    if (op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul || op == BinOp::Div)
    {
        return Ok(());
    }
    if (op == BinOp::Rem)
    {
        return Err(mismatch(sprintf(
            "`%%` is defined for integers only; a `%s` has `+ - * /` (a float remainder is `a - b * trunc(a / b)`)",
            &type_display(ta),
        )));
    }
    Err(mismatch(sprintf(
        "`%s` is defined for integers only; a float's bits are `reinterpret<u64>(x)` (or `u32` for `f32`)",
        sym,
    )))
}

fn callable_operand(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e, ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(x) :
        {
            if (contains_fn(it, x))
            {
                return true;
            }
        },
        None    : {},
    }
    match (&e.kind)
    {
        ExprKind::EClosure(_) : true,
        ExprKind::EPath(pb) : Vec::len(&Box::get(pb).segs) == 1 && HashMap::contains(
            &b.closure_moves,
            &Box::get(pb).segs[0],
        ),
        _                     : false,
    }
}

fn is_slice_opt(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(Type::TSlice(_)) : true,
        _                     : false,
    }
}

// Bug 247: the name of a signed counter compared with a `…::len(…)` call.
fn length_counter(ref<Expr, shared> a, ref<Expr, shared> c, ref<Type, shared> ta, ref<Type, shared> tb) : Option<String>
{
    for (usize side = 0; side < 2; side += 1)
    {
        ref<Expr, shared> name_e = if (side == 0) { a } else { c };
        ref<Expr, shared> len_e = if (side == 0) { c } else { a };
        ref<Type, shared> name_t = if (side == 0) { ta } else { tb };
        ref<Type, shared> len_t = if (side == 0) { tb } else { ta };
        bool is_len = match (&strip_parens_tc(len_e).kind)
        {
            ExprKind::ECall(cb) : match (path_segs(&Box::get(cb).callee))
            {
                Some(segs) : Vec::len(segs) > 0 && (segs[Vec::len(segs) - 1] == "len" || segs[Vec::len(segs) - 1] == "slice_len"),
                None       : false,
            },
            _ : false,
        };
        bool signed_counter = match (name_t)
        {
            Type::TInt(i) : int_ty_signed(*i),
            _             : false,
        };
        if (is_len && signed_counter && type_eq(len_t, &Type::TInt(IntTy::Usize)))
        {
            match (simple_name(name_e))
            {
                Some(n) : return Some(n),
                None    : {},
            }
        }
    }
    None
}

fn check_comparison(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    BinOp op,
    ref<Expr, shared> a,
    ref<Expr, shared> c,
    ref<Expr, shared> whole,
    ref<Option<Type>, shared> at,
    ref<Option<Type>, shared> bt,
) : Result<Option<Type>, String>
{
    unsigned_zero_note(b, op, a, c, at, bt);
    // `[Eq-Fn]` (spec/12 §4): no equality on function values.
    if (callable_operand(b, it, a, at) || callable_operand(b, it, c, bt))
    {
        // Bug 347: say so, and how an optional function is tested.
        bool a_opt = match (at)
        {
            Some(t) : named_is(t, "std::Option"),
            None    : false,
        };
        bool c_opt = match (bt)
        {
            Some(t) : named_is(t, "std::Option"),
            None    : false,
        };
        if ((op == BinOp::Eq || op == BinOp::Ne) && (a_opt || c_opt))
        {
            ref<Expr, shared> oe = if (a_opt) { a } else { c };
            String o = Option::unwrap_or(place_text(oe), "o");
            return Err(mismatch(with_repair(
                &sprintf(
                    "a function value has no `==` (`[Eq-Fn]`), so neither has an `Option` of one: test it with `Option::%s(&%s)`, or `match` it",
                    if (op == BinOp::Eq) { "is_none" } else { "is_some" },
                    &o,
                ),
                "",
            )));
        }
        return Err(mismatch(with_repair(
            "a function value has no `==` or order (`[Eq-Fn]`): two function values cannot be told apart; compare what they compute, or keep an id beside each",
            "",
        )));
    }
    // No comparison of slices (D-0047).
    if (is_slice_opt(at) || is_slice_opt(bt))
    {
        return Err("diag.type-mismatch");
    }
    // Nor of an aggregate holding one, a `StringView` included.
    for (usize side = 0; side < 2; side += 1)
    {
        ref<Option<Type>, shared> ot = if (side == 0) { at } else { bt };
        match (ot)
        {
            Some(t) :
            {
                if (!has_unresolved_marker(t) && contains_slice(it, t))
                {
                    return Err(mismatch(sprintf(
                        "`==` and `!=` compare a `%s` field by field, and it holds a `StringView` or a slice, which compares only on its own: compare the parts (`Option::unwrap(a) == b`, or a `match`)",
                        &type_display(t),
                    )));
                }
            },
            None    : {},
        }
    }
    match (at)
    {
        Some(ta) : match (bt)
        {
            Some(tb) :
            {
                if (!has_unresolved_marker(ta) && !has_unresolved_marker(tb) && !ty_compat(ta, tb))
                {
                    // Bug 247: a counter compared with a length counts in
                    // `usize` from the start.
                    String hint = match (length_counter(a, c, ta, tb))
                    {
                        Some(n) : sprintf(
                            "; `%s` is compared with a length, a `usize`: declare it `usize` from the start (`usize %s = 0`), which an index takes too",
                            &n,
                            &n,
                        ),
                        None : compare_hint(ta, tb),
                    };
                    return Err(mismatch(sprintf(
                        "the operands are `%s` and `%s`, which cannot be compared%s",
                        &type_display(ta),
                        &type_display(tb),
                        &hint,
                    )));
                }
                // `[T-Cmp]`: `< <= > >=` need an ordered τ.
                if (is_order_op(op) && !has_unresolved_marker(ta) && !is_never(ta) && !bound_holds(
                    b,
                    it,
                    Bound::BOrdered,
                    ta,
                ))
                {
                    return Err(mismatch(sprintf(
                        "`<`, `<=`, `>`, `>=` order numbers, `bool`, `str`, `String`, and a struct or enum of those; a `%s` is compared with `==` and `!=` only%s",
                        &type_display(ta),
                        &key_problem_text(it, ta),
                    )));
                }
                // D-0108 `[Cmp-Text]`: two `String`s compare by their bytes.
                if (!has_unresolved_marker(ta) && is_std_string(ta))
                {
                    bool keycmp = match (HashMap::get(&b.facts.view_ops, whole.id))
                    {
                        Some(ViewOp::KeyCmp) : true,
                        _                    : false,
                    };
                    if (!keycmp)
                    {
                        HashMap::insert(&mut b.facts.view_ops, whole.id, ViewOp::TextCmp);
                    }
                    return Ok(Some(Type::TBool));
                }
                // `[T-Cmp]`: "not resource".
                if (!has_unresolved_marker(ta) && !named_key_type(it, ta) && is_resource_ty(it, ta))
                {
                    String msg = sprintf(
                        "a comparison reads both operands whole, and `%s` is a resource; compare what it holds (an element at a time, text with `==`, or through a view or slice)",
                        &type_display(ta),
                    );
                    return Err(named_diag("diag.read-of-resource", &msg));
                }
            },
            None     : {},
        },
        None : {},
    }
    // D-0271 `[Cmp-Key]`: from whichever operand's type is known.
    Option<Type> known = None;
    for (usize side = 0; side < 2 && Option::is_none(&known); side += 1)
    {
        ref<Option<Type>, shared> ot = if (side == 0) { at } else { bt };
        match (ot)
        {
            Some(t) :
            {
                if (!has_unresolved_marker(t) && is_named_ty(t) && !is_std_string(t))
                {
                    known = Some(clone(t));
                }
            },
            None    : {},
        }
    }
    match (&known)
    {
        Some(t) :
        {
            bool ordering = is_order_op(op);
            if (named_key_type(it, t))
            {
                if (ordering || is_resource_ty(it, t))
                {
                    HashMap::insert(&mut b.facts.view_ops, whole.id, ViewOp::KeyCmp);
                }
            }
            else if (ordering && !named_is(t, "std::StringView"))
            {
                return Err(mismatch(sprintf(
                    "`<`, `<=`, `>`, `>=` order numbers, `bool`, `str`, `String`, and a struct or enum of those; a `%s` is compared with `==` and `!=` only%s",
                    &type_display(t),
                    &key_problem_text(it, t),
                )));
            }
        },
        None    : {},
    }
    Ok(Some(Type::TBool))
}

// A best-effort retry from the other side.
fn reguess(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    ref<Option<Type>, shared> hint,
) : Option<Type>
{
    match (check_expr(b, it, e, hint))
    {
        Ok(t)  : t,
        Err(_) : None,
    }
}

// A literal, or a literal-bound local (spec/14, CHG-0092), consulted only
// when refutations are reported.
fn known_value(ref<Body, shared> b, ref<Expr, shared> e) : Option<i128>
{
    match (literal_value(e))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (path_segs(strip_parens_tc(e)))
    {
        Some(segs) :
        {
            if (Vec::len(segs) == 1 && b.report && !b.flow.unreachable && !HashMap::contains(&b.guard_names, &segs[0]))
            {
                return match (HashMap::get(&b.flow.lits, &segs[0]))
                {
                    Some(v) : if (*v == empty_mark()) { None } else { Some(*v) },
                    None    : None,
                };
            }
            None
        },
        None       : None,
    }
}

// D-0317 (cobc's `check_requires_known`): the requirement row. Each
// requirement in order, with the by-value integer parameters it names bound
// to their arguments' known values: `false` rejects the call; anything not
// decided leaves it and every later one to the run.
fn check_requires_known(ref<Body, shared> b, ref<FnDecl, shared> f, ref<Vec<Expr>, shared> args) : Result<void, String>
{
    HashMap<String, KnownInt> env = HashMap::new();
    for (usize i = 0; i < Vec::len(&f.params); i += 1)
    {
        match (&f.params[i].ty)
        {
            Type::TInt(t) :
            {
                match (known_value(b, &args[i]))
                {
                    Some(v) :
                    {
                        HashMap::insert(&mut env, String::clone(&f.params[i].name), KnownInt { .v = v, .t = Some(*t) });
                    },
                    None    : {},
                }
            },
            _             : {},
        }
    }
    for (usize k = 0; k < Vec::len(&f.requires); k += 1)
    {
        Folded r = fold_requirement(&f.requires[k].cond, &env);
        if (r.kind == FoldKind::FBool && r.b)
        {
            continue;
        }
        if (r.kind == FoldKind::FBool)
        {
            String msg = sprintf("these arguments do not meet requirement %v of `%s`, so the call can never be made", k + 1, &fn_shown(f));
            return Err(named_diag("diag.precondition-failed", &msg));
        }
        return Ok(());
    }
    Ok(())
}

// D-0317: a requirement's value over known parameters: an integer with the
// type of the parameter it came from, if any (`FInt`), a `bool` (`FBool`), or
// not foldable here (`FNone`).
struct KnownInt
{
    i128 v;
    Option<IntTy> t;
}

enum FoldKind
{
    FNone,
    FInt,
    FBool,
}

struct Folded
{
    FoldKind kind;
    i128 v;
    Option<IntTy> t;
    bool b;
}

fn fold_none() : Folded
{
    Folded { .kind = FoldKind::FNone, .v = 0, .t = None, .b = false }
}

fn fold_bool(bool x) : Folded
{
    Folded { .kind = FoldKind::FBool, .v = 0, .t = None, .b = x }
}

fn fold_int_of(i128 v, Option<IntTy> t) : Folded
{
    if (!fits_int(v, &t))
    {
        return fold_none();
    }
    Folded { .kind = FoldKind::FInt, .v = v, .t = t, .b = false }
}

fn fits_int(i128 v, ref<Option<IntTy>, shared> t) : bool
{
    match (t)
    {
        Some(it) :
        {
            IntRange r = int_range(*it);
            v >= r.min && v <= r.max
        },
        None     : true,
    }
}

fn fold_requirement(ref<Expr, shared> e, ref<HashMap<String, KnownInt>, shared> env) : Folded
{
    ref<Expr, shared> x = strip_parens_tc(e);
    match (&x.kind)
    {
        ExprKind::EBool(v)    : return fold_bool(*v),
        ExprKind::EUnary(ub)  :
        {
            ref<UnaryExpr, shared> u = Box::get(ub);
            Folded a = fold_requirement(&u.e, env);
            if (u.op == UnOp::Not)
            {
                return if (a.kind == FoldKind::FBool) { fold_bool(!a.b) } else { fold_none() };
            }
            if (u.op == UnOp::Neg && a.kind == FoldKind::FInt)
            {
                return match (checked_sub(0, a.v))
                {
                    Some(r) : fold_int_of(r, a.t),
                    None    : fold_none(),
                };
            }
            return fold_none();
        },
        ExprKind::EBinary(bb) :
        {
            ref<BinaryExpr, shared> bx = Box::get(bb);
            if (bx.op == BinOp::And || bx.op == BinOp::Or)
            {
                Folded a = fold_requirement(&bx.a, env);
                if (a.kind != FoldKind::FBool)
                {
                    return fold_none();
                }
                // `&&` and `||` stop where the run stops.
                if ((bx.op == BinOp::And && !a.b) || (bx.op == BinOp::Or && a.b))
                {
                    return a;
                }
                Folded c = fold_requirement(&bx.b, env);
                return if (c.kind == FoldKind::FBool) { c } else { fold_none() };
            }
            Folded p = fold_requirement(&bx.a, env);
            Folded q = fold_requirement(&bx.b, env);
            if (p.kind != FoldKind::FInt || q.kind != FoldKind::FInt)
            {
                return fold_none();
            }
            Option<IntTy> t = if (Option::is_some(&p.t)) { p.t } else { q.t };
            if (!fits_int(p.v, &t) || !fits_int(q.v, &t))
            {
                return fold_none();
            }
            Option<i128> r = None;
            if (bx.op == BinOp::Add)
            {
                r = checked_add(p.v, q.v);
            }
            else if (bx.op == BinOp::Sub)
            {
                r = checked_sub(p.v, q.v);
            }
            else if (bx.op == BinOp::Mul)
            {
                r = checked_mul(p.v, q.v);
            }
            else if (bx.op == BinOp::Div && q.v != 0)
            {
                r = checked_div(p.v, q.v);
            }
            else if (bx.op == BinOp::Rem && q.v != 0)
            {
                r = checked_rem(p.v, q.v);
            }
            else if (bx.op == BinOp::Eq)
            {
                return fold_bool(p.v == q.v);
            }
            else if (bx.op == BinOp::Ne)
            {
                return fold_bool(p.v != q.v);
            }
            else if (bx.op == BinOp::Lt)
            {
                return fold_bool(p.v < q.v);
            }
            else if (bx.op == BinOp::Le)
            {
                return fold_bool(p.v <= q.v);
            }
            else if (bx.op == BinOp::Gt)
            {
                return fold_bool(p.v > q.v);
            }
            else if (bx.op == BinOp::Ge)
            {
                return fold_bool(p.v >= q.v);
            }
            return match (r)
            {
                Some(v) : fold_int_of(v, t),
                None    : fold_none(),
            };
        },
        _                     : {},
    }
    match (path_segs(x))
    {
        Some(segs) :
        {
            if (Vec::len(segs) == 1)
            {
                return match (HashMap::get(env, &segs[0]))
                {
                    Some(k) : Folded { .kind = FoldKind::FInt, .v = k.v, .t = k.t, .b = false },
                    None    : fold_none(),
                };
            }
            return fold_none();
        },
        None       : {},
    }
    match (literal_value(e))
    {
        Some(v) : Folded { .kind = FoldKind::FInt, .v = v, .t = None, .b = false },
        None    : fold_none(),
    }
}

// An integer expression's value when it is made of known values, unary
// minus, `+ - * / %`, and `widen`/`narrow` of one.
fn fold_int(ref<Body, shared> b, ref<Expr, shared> e) : Option<i128>
{
    match (known_value(b, e))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EUnary(ub)  :
        {
            if (Box::get(ub).op != UnOp::Neg)
            {
                return None;
            }
            i128 x = fold_int(b, &Box::get(ub).e)?;
            checked_sub(0, x)
        },
        ExprKind::EBinary(bb) :
        {
            ref<BinaryExpr, shared> x = Box::get(bb);
            i128 p = fold_int(b, &x.a)?;
            i128 q = fold_int(b, &x.b)?;
            if (x.op == BinOp::Add)
            {
                return checked_add(p, q);
            }
            if (x.op == BinOp::Sub)
            {
                return checked_sub(p, q);
            }
            if (x.op == BinOp::Mul)
            {
                return checked_mul(p, q);
            }
            if (x.op == BinOp::Div && q != 0)
            {
                return checked_div(p, q);
            }
            if (x.op == BinOp::Rem && q != 0)
            {
                if (p == min_value<i128>() && q == -1)
                {
                    return None;
                }
                return checked_rem(p, q);
            }
            None
        },
        ExprKind::ECall(cb)   :
        {
            ref<CallExpr, shared> call = Box::get(cb);
            if (Vec::len(&call.args) != 1)
            {
                return None;
            }
            match (path_segs(&call.callee))
            {
                Some(segs) :
                {
                    if (Vec::len(segs) == 1 && (segs[0] == "widen" || segs[0] == "narrow"))
                    {
                        return fold_int(b, &call.args[0]);
                    }
                    None
                },
                None       : None,
            }
        },
        _                     : None,
    }
}

enum ArithErr
{
    Overflow,
    DivByZero,
    DivOverflow,
}

// `x op y` in integer type `t`, checked (a `u128`'s value is its bit
// pattern in the `i128`).
fn value_checked(BinOp op, IntTy t, i128 x, i128 y) : Result<i128, ArithErr>
{
    if (op == BinOp::Div || op == BinOp::Rem)
    {
        if (y == 0)
        {
            return Err(ArithErr::DivByZero);
        }
        if (t == IntTy::U128)
        {
            u128 p = reinterpret<u128>(x);
            u128 q = reinterpret<u128>(y);
            return Ok(reinterpret<i128>(if (op == BinOp::Div) { p / q } else { p % q }));
        }
        if (int_ty_signed(t) && x == int_range(t).min && y == -1)
        {
            return Err(ArithErr::DivOverflow);
        }
        return Ok(if (op == BinOp::Div) { x / y } else { x % y });
    }
    if (t == IntTy::U128)
    {
        u128 p = reinterpret<u128>(x);
        u128 q = reinterpret<u128>(y);
        Option<u128> r = if (op == BinOp::Add)
        {
            checked_add(
                p,
                q,
            )
        }
        else if (op == BinOp::Sub) { checked_sub(p, q) } else { checked_mul(p, q) };
        return match (r)
        {
            Some(v) : Ok(reinterpret<i128>(v)),
            None    : Err(ArithErr::Overflow),
        };
    }
    Option<i128> r = if (op == BinOp::Add)
    {
        checked_add(
            x,
            y,
        )
    }
    else if (op == BinOp::Sub) { checked_sub(x, y) } else { checked_mul(x, y) };
    match (r)
    {
        Some(v) : if (in_range(t, v)) { Ok(v) } else { Err(ArithErr::Overflow) },
        None    : Err(ArithErr::Overflow),
    }
}

fn operand_text(ref<Expr, shared> e, i128 v) : String
{
    match (path_segs(strip_parens_tc(e)))
    {
        Some(segs) :
        {
            if (Vec::len(segs) == 1)
            {
                return sprintf("%s (here %v)", shown_name(&segs[0]), v);
            }
            sprintf("%v", v)
        },
        None       : sprintf("%v", v),
    }
}

// `rule.control.flow-analysis` §6's literal-operand constant-fold
// refutation: both operands known, the result is checked now.
//
// D-0340 §1: an operand that is itself an operator on known operands has the
// value recorded when it was checked (`folded`), so `100 * 99999 * 100000`
// and `1 / (1 - 1)` are decided wherever they stand, each node once.
fn known_or_folded(ref<Body, shared> b, ref<Expr, shared> e) : Option<i128>
{
    match (known_value(b, e))
    {
        Some(v) : return Some(v),
        None    : {},
    }
    match (HashMap::get(&b.facts.folded, strip_parens_tc(e).id))
    {
        Some(v) : Some(*v),
        None    : None,
    }
}

// D-0341: a condition's value where the operands decide it: `true`,
// `false`, `!c`, `&&`, `||`, and a comparison of known integers.
fn const_bool(ref<Body, shared> b, ref<Expr, shared> e, u32 depth) : Option<bool>
{
    if (depth > 64)
    {
        return None;
    }
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EBool(v)    : Some(*v),
        ExprKind::EUnary(ub)  :
        {
            if (Box::get(ub).op != UnOp::Not)
            {
                return None;
            }
            Some(!const_bool(b, &Box::get(ub).e, depth + 1)?)
        },
        ExprKind::EBinary(bb) :
        {
            ref<BinaryExpr, shared> x = Box::get(bb);
            if (x.op == BinOp::And || x.op == BinOp::Or)
            {
                Option<bool> l = const_bool(b, &x.a, depth + 1);
                Option<bool> r = const_bool(b, &x.b, depth + 1);
                bool l_false = match (l)
                {
                    Some(v) : !v,
                    None    : false,
                };
                bool r_false = match (r)
                {
                    Some(v) : !v,
                    None    : false,
                };
                bool l_true = match (l)
                {
                    Some(v) : v,
                    None    : false,
                };
                bool r_true = match (r)
                {
                    Some(v) : v,
                    None    : false,
                };
                if (x.op == BinOp::And && (l_false || r_false))
                {
                    return Some(false);
                }
                if (x.op == BinOp::Or && (l_true || r_true))
                {
                    return Some(true);
                }
                bool lv = l?;
                bool rv = r?;
                return Some(if (x.op == BinOp::And) { lv && rv } else { lv || rv });
            }
            i128 p = known_or_folded(b, &x.a)?;
            i128 q = known_or_folded(b, &x.b)?;
            if (x.op == BinOp::Eq)
            {
                return Some(p == q);
            }
            if (x.op == BinOp::Ne)
            {
                return Some(p != q);
            }
            if (x.op == BinOp::Lt)
            {
                return Some(p < q);
            }
            if (x.op == BinOp::Le)
            {
                return Some(p <= q);
            }
            if (x.op == BinOp::Gt)
            {
                return Some(p > q);
            }
            if (x.op == BinOp::Ge)
            {
                return Some(p >= q);
            }
            None
        },
        _                     : None,
    }
}

fn check_literal_fold_overflow(
    ref<Body, exclusive> b,
    BinOp op,
    IntTy t,
    ref<Expr, shared> a,
    ref<Expr, shared> c,
    usize whole,
) : Result<void, String>
{
    // A branch that is never reached (`const_bool`) holds no fault.
    if (b.flow.unreachable)
    {
        return Ok(());
    }
    i128 av = match (known_or_folded(b, a))
    {
        Some(v) : v,
        None    : return Ok(()),
    };
    i128 bv = match (known_or_folded(b, c))
    {
        Some(v) : v,
        None    : return Ok(()),
    };
    if (!(op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul || op == BinOp::Div || op == BinOp::Rem))
    {
        return Ok(());
    }
    if ((op == BinOp::Div || op == BinOp::Rem) && bv == 0)
    {
        return Err("diag.div-by-zero");
    }
    match (value_checked(op, t, av, bv))
    {
        Ok(v)                      :
        {
            HashMap::insert(&mut b.facts.folded, whole, v);
            Ok(())
        },
        Err(ArithErr::DivOverflow) : Err("diag.div-overflow"),
        Err(_)                     :
        {
            IntRange r = int_range(t);
            // Bug 121: an unsigned difference below 0 fits no wider unsigned
            // type either.
            if (op == BinOp::Sub && !int_ty_signed(t) && av < bv)
            {
                String na = operand_text(a, av);
                String nc = operand_text(c, bv);
                String ia = Option::unwrap_or(simple_text(a), sprintf("%v", av));
                String ic = Option::unwrap_or(simple_text(c), sprintf("%v", bv));
                str signed_ty = match (t)
                {
                    IntTy::U8  : "i16",
                    IntTy::U16 : "i32",
                    IntTy::U32 : "i64",
                    _          : "i128",
                };
                String neg = sprintf(
                    "%s - %s is negative, which `%s` cannot hold (0 to %v): check first (`if (%s >= %s) { … }`), compute in a signed type (`widen<%v>(%s) - widen<%v>(%s)`), or use `checked_sub`/`saturating_sub`",
                    &na,
                    &nc,
                    int_ty_name(t),
                    r.max,
                    &ia,
                    &ic,
                    signed_ty,
                    &ia,
                    signed_ty,
                    &ic,
                );
                return Err(named_diag("diag.arith-overflow", &with_repair(&neg, "")));
            }
            String msg = sprintf(
                "%s %s %s is outside `%s` (%v to %v); compute in a wider type (`widen<u64>(x)`, the result declared wider too) or use `wrapping_*`/`checked_*`/`saturating_*`",
                &operand_text(a, av),
                op_symbol(op),
                &operand_text(c, bv),
                int_ty_name(t),
                r.min,
                r.max,
            );
            Err(named_diag("diag.arith-overflow", &msg))
        },
    }
}

// D-0303: a use of the field `f` (whose standing is `st`) of the struct
// `s`, at `line`; the error is tagged by the caller as every check's is.
fn field_use(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> s,
    ref<String, shared> f,
    ref<Retired, shared> st,
    usize line,
) : Result<void, String>
{
    if (!it.any_retired || Retired::is_live(st))
    {
        return Ok(());
    }
    StringView shown = s;
    match (StringView::strip_prefix(shown, "std::"))
    {
        Some(x) : shown = x,
        None    : {},
    }
    String what = sprintf("the field `%s` of `%s`", f, shown);
    bool exempt = b.retired_exempt || b.privileged;
    retired_verdict(Some(clone(st)), &what, line, exempt, &mut b.facts.retired_notes)
}

// D-0303: a use of the variant `v` of the enum `e` in a pattern.
fn variant_use(ref<Body, exclusive> b, ref<Items, shared> it, ref<String, shared> e, ref<String, shared> v, usize line) : Result<void, String>
{
    if (!it.any_retired)
    {
        return Ok(());
    }
    StringView shown = e;
    match (StringView::strip_prefix(shown, "std::"))
    {
        Some(x) : shown = x,
        None    : {},
    }
    String what = sprintf("`%s::%s`", shown, v);
    bool exempt = b.retired_exempt || b.privileged;
    retired_verdict(standing(&it.retired, &sprintf("%s::%s", e, v)), &what, line, exempt, &mut b.facts.retired_notes)
}

fn check_field(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> base,
    ref<String, shared> name,
) : Result<Option<Type>, String>
{
    Option<Type> bt0 = check_expr(b, it, base, &None)?;
    // `[Field-Access-Auto-Deref]`: through a reference, and (D-0064)
    // through a guard -- again through a reference to a reference (a binder
    // of `match (&o)` with `o` an `Option<ref<S>>`), as the tools read it.
    Option<Type> bt = deref_to(bt0);
    while (opt_is_ref(&bt))
    {
        bt = deref_to(bt);
    }
    if (is_marker_opt(&bt))
    {
        return Err(unbounded_msg("a field access"));
    }
    match (&bt)
    {
        Some(Type::TNamed(nb)) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(sdecl) :
                {
                    HashMap<String, Type> subst = zip_subst(&sdecl.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&sdecl.fields); i += 1)
                    {
                        ref<FieldDecl, shared> fd = &sdecl.fields[i];
                        if (fd.name == *name)
                        {
                            if (!b.privileged && !field_visible(
                                &n.name,
                                fd.export_,
                                &b.module_,
                            ))
                            {
                                // CHG-0445: `v.len()` reaches `Vec`'s own field.
                                // Bug 246: the function meant, as a call of
                                // the receiver as written.
                                String hint = method_hint(it, &n.name, name, base);
                                String msg = sprintf(
                                    "field `%s` of `%s` is not exported%s",
                                    name,
                                    &type_display(&named(&n.name, Vec::new())),
                                    &hint,
                                );
                                // Bug 029: not "mark `export`" for a call
                                // meant, or for a field of `std`'s.
                                if (StringView::len(&hint) > 0)
                                {
                                    msg = with_repair(&msg, "");
                                }
                                else if (StringView::starts_with(&n.name, "std::"))
                                {
                                    String tn = type_display(&named(&n.name, Vec::new()));
                                    msg = with_repair(&msg, &sprintf("use the functions `std` gives for `%s` (`--doc %s` lists them)", &tn, &tn));
                                }
                                return Err(named_diag("diag.name-not-visible", &msg));
                            }
                            field_use(b, it, &n.name, &fd.name, &fd.retired, base.line)?;
                            return Ok(Some(apply_subst(&fd.ty, &subst)));
                        }
                    }
                    // CHG-0452: a field of the value a `Box` holds.
                    bool boxed_field = n.name == "std::Box" && Vec::len(&n.args) > 0 && match (&n.args[0])
                    {
                        Type::TNamed(ib) : match (HashMap::get(&it.structs, &Box::get(ib).name))
                        {
                            Some(d) :
                            {
                                bool has = false;
                                foreach (f in &d.fields)
                                {
                                    if (f.name == *name)
                                    {
                                        has = true;
                                    }
                                }
                                has
                            },
                            None    : false,
                        },
                        _ : false,
                    };
                    String hint = if (boxed_field)
                    {
                        String bn = match (&strip_parens_tc(base).kind)
                        {
                            ExprKind::EPath(pb) :
                            {
                                if (Vec::len(&Box::get(pb).segs) == 1) { String::copy(shown_name(&Box::get(pb).segs[0])) } else { "b" }
                            },
                            _                   : "b",
                        };
                        sprintf(
                            "; the field of the value it holds is `Box::get(&%s).%s` (`Box::get_mut(&mut %s).%s` to change it)",
                            &bn,
                            name,
                            &bn,
                            name,
                        )
                    }
                    else
                    {
                        method_hint(it, &n.name, name, base)
                    };
                    // Bug 029: the repair names the fields there are.
                    String fields_here = String::new();
                    Vec<String> field_names = Vec::new();
                    foreach (f in &sdecl.fields)
                    {
                        if (b.privileged || field_visible(&n.name, f.export_, &b.module_))
                        {
                            String::appendf(&mut fields_here, "%s`%s`", if (StringView::len(&fields_here) == 0) { "" } else { ", " }, &f.name);
                            Vec::push(&mut field_names, String::clone(&f.name));
                        }
                    }
                    // Bug 050: the field meant, by case or spelling.
                    if (StringView::len(&hint) == 0)
                    {
                        match (hints::nearest(name, &field_names))
                        {
                            Some(m) : hint = sprintf("; did you mean `%s`?", &m),
                            None    : {},
                        }
                    }
                    String shown_bt = type_display(Option::expect(match (&bt)
                    {
                        Some(t) : Some(t),
                        None    : None,
                    }, "a type"));
                    String repair = if (StringView::len(&hint) > 0)
                    {
                        String::new()
                    }
                    else if (StringView::len(&fields_here) == 0)
                    {
                        sprintf("`%s` has no field this code can read; use its functions", &shown_bt)
                    }
                    else
                    {
                        sprintf("name one of `%s`'s fields: %s", &shown_bt, &fields_here)
                    };
                    Err(mismatch(with_repair(&sprintf("`%s` has no field `%s`%s", &shown_bt, name, &hint), &repair)))
                },
                None        :
                {
                    if (HashMap::contains(&it.enums, &n.name))
                    {
                        // An enum value has no fields: its payload is
                        // reached by `match`.
                        return Err(mismatch(sprintf(
                            "`%s` is an enum and has no field `%s`%s",
                            &type_display(&named(&n.name, clone(&n.args))),
                            name,
                            &method_hint(it, &n.name, name, base),
                        )));
                    }
                    Ok(None)
                },
            }
        },
        Some(t)                :
        {
            bool plain = match (t)
            {
                Type::TInt(_)    : true,
                Type::TF32       : true,
                Type::TF64       : true,
                Type::TBool      : true,
                Type::TStr       : true,
                Type::TVoid      : true,
                Type::TArray(_)  : true,
                Type::TSlice(_)  : true,
                Type::TFn(_)     : true,
                Type::THandle(_) : true,
                Type::TMutex(_)  : true,
                Type::TRawptr(_) : true,
                _                : false,
            };
            if (plain)
            {
                return Err(mismatch(sprintf(
                    "a value of type `%s` has no field `%s`; there is no method-call syntax: a function is called with its value as an argument, `T::name(x, …)` (`--doc` lists them)",
                    &type_display(t),
                    name,
                )));
            }
            Ok(None)
        },
        None                   : Ok(None),
    }
}

// CobaltC has no method-call syntax: when `T::f` is a function, say how to
// call it. CHG-0445: when it is not, the function of `T` another language's
// name means (`size` for `len`), or the nearest name of `T`'s.
fn method_hint(
    ref<Items, shared> it,
    ref<String, shared> tname,
    ref<String, shared> name,
    ref<Expr, shared> base,
) : String
{
    // Bug 246: the call as written with the receiver's own text, `&s`
    // or `&mut s` as the function's first parameter takes it.
    String recv = match (place_text(base))
    {
        Some(t) : t,
        None    : "x",
    };
    bool text = *tname == "std::String" || *tname == "std::StringView";
    if (text && (*name == "equals" || *name == "eq" || *name == "equals_str" || *name == "compare" || *name == "compareTo"))
    {
        return sprintf(
            "; there is no method-call syntax, and texts compare with `==`, `!=`, `<`, …: `%s == t` (`[Cmp-Text]`)",
            &recv,
        );
    }
    if (*tname == "std::String" && (*name == "push_str" || *name == "append" || *name == "concat" || *name == "extend" || *name == "add"))
    {
        return sprintf("; there is no method-call syntax -- append with `String::append(&mut %s, t)`", &recv);
    }
    // Bug 254: what a `Vec` writes for Rust's accessors it does not have.
    if (*tname == "std::Vec")
    {
        match (hints::vec_form(name, &recv))
        {
            Some(h) : return h,
            None    : {},
        }
    }
    String f = sprintf("%s::%s", tname, name);
    Option<String> meant = if (HashMap::contains(&it.fns, &f)) { Some(f) } else { function_meant(it, tname, name) };
    // A `String`'s text is read through its view's functions.
    if (Option::is_none(&meant) && *tname == "std::String")
    {
        Vec<str> cands = Vec::new();
        Vec::push(&mut cands, "");
        Vec::append(&mut cands, hints::fn_name(name));
        for (usize k = 0; k < Vec::len(&cands) && Option::is_none(&meant); k += 1)
        {
            String vf = if (k == 0) { sprintf("std::StringView::%s", name) } else { sprintf("std::StringView::%s", cands[k]) };
            bool exported = match (HashMap::get(&it.fns, &vf))
            {
                Some(d) : d.export_,
                None    : false,
            };
            if (exported)
            {
                meant = Some(vf);
            }
        }
    }
    match (meant)
    {
        Some(m) : sprintf(
            "; there is no method-call syntax -- call the function as `%s`",
            &call_form(it, &m, &recv, *tname == "std::String"),
        ),
        None : String::new(),
    }
}

// Bug 246: `F(&x, …)`, the call of the function `fname` with `recv` as
// its first argument, lent as its first parameter takes it.
fn call_form(ref<Items, shared> it, ref<String, shared> fname, ref<String, shared> recv, bool owned_text) : String
{
    String shown = String::copy(Option::unwrap_or(StringView::strip_prefix(fname, "std::"), fname));
    match (HashMap::get(&it.fns, fname))
    {
        Some(d) :
        {
            if (Vec::len(&d.params) == 0)
            {
                return sprintf("%s()", &shown);
            }
            str lend = match (&d.params[0].ty)
            {
                Type::TRef(rb)   : if (Box::get(rb).mode == Mode::Exclusive) { "&mut " } else { "&" },
                Type::TSlice(sb) : if (Box::get(sb).mode == Mode::Exclusive) { "&mut " } else { "&" },
                _                : if (owned_text && named_is(&d.params[0].ty, "std::StringView")) { "&" } else { "" },
            };
            sprintf("%s(%s%s%s)", &shown, lend, recv, if (Vec::len(&d.params) > 1) { ", …" } else { "" })
        },
        None    : sprintf("%s(%s, …)", &shown, recv),
    }
}

// CHG-0445: the function `T::m` that `T::name`, which names nothing, means:
// another language's name for it (`hints::fn_name`), else the nearest of
// `T`'s functions' names.
fn function_meant(ref<Items, shared> it, StringView tname, StringView name) : Option<String>
{
    Vec<str> alts = hints::fn_name(name);
    foreach (alt in &alts)
    {
        String f = sprintf("%v::%v", tname, alt);
        if (HashMap::contains(&it.fns, &f))
        {
            return Some(f);
        }
    }
    String prefix = sprintf("%v::", tname);
    Vec<String> names = Vec::new();
    for (usize i = 0; i < HashMap::len(&it.fns); i += 1)
    {
        ref<String, shared> k = HashMap::key_at(&it.fns, i);
        ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, k), "a key");
        if (!f.export_ && StringView::starts_with(k, "std::"))
        {
            continue;
        }
        match (StringView::strip_prefix(k, &prefix))
        {
            Some(rest) :
            {
                if (Option::is_none(&StringView::find(rest, "::")))
                {
                    Vec::push(&mut names, String::copy(rest));
                }
            },
            None       : {},
        }
    }
    Vec::sort(&mut names);
    match (hints::nearest(name, &names))
    {
        Some(m) : return Some(sprintf("%s%s", &prefix, &m)),
        None    : {},
    }
    // Bug 050: a misspelling that keeps the start of the name (`lenght`
    // for `len`): the one function whose name begins it.
    Option<String> start = None;
    foreach (n in &names)
    {
        if (StringView::len(n) >= 3 && StringView::len(name) > StringView::len(n) && StringView::starts_with(name, n))
        {
            if (Option::is_some(&start))
            {
                return None;
            }
            start = Some(sprintf("%s%s", &prefix, n));
        }
    }
    start
}

// Where the last `::` of a path begins, if it has one.
fn last_path_sep(StringView s) : Option<usize>
{
    Option<usize> at = None;
    usize from = 0;
    while (true)
    {
        match (StringView::find(&s[from..$], "::"))
        {
            Some(k) :
            {
                at = Some(from + k);
                from = from + k + 2;
            },
            None    : break,
        }
    }
    at
}

// Bug 050: the path `prefix::last` was meant to be, when `prefix` is no
// type: an item named `last` under a prefix spelt nearly as `prefix`
// (`HashMap::new` for `Hashmap::new`, `shapes::PI` for `shape::PI`).
fn path_meant(ref<Items, shared> it, StringView prefix, StringView last) : Option<String>
{
    Vec<String> heads = Vec::new();
    for (usize i = 0; i < HashMap::len(&it.fns); i += 1)
    {
        ref<String, shared> k = HashMap::key_at(&it.fns, i);
        ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, k), "a key");
        StringView shown = match (StringView::strip_prefix(k, "std::"))
        {
            Some(rest) :
            {
                if (!f.export_)
                {
                    continue;
                }
                rest
            },
            None       : k,
        };
        match (last_path_sep(shown))
        {
            Some(j) :
            {
                if (&shown[j + 2..$] == last && &shown[0..j] != prefix)
                {
                    Vec::push(&mut heads, String::copy(&shown[0..j]));
                }
            },
            None    : {},
        }
    }
    Vec::sort(&mut heads);
    Vec::dedup(&mut heads);
    match (hints::nearest(prefix, &heads))
    {
        Some(h) : Some(sprintf("%s::%v", &h, last)),
        None    : None,
    }
}

// CHG-0445: the name a plain name that names nothing was meant to be: the
// nearest of the locals in scope and the functions it could name.
fn name_meant(ref<Body, shared> b, ref<Items, shared> it, StringView name) : Option<String>
{
    Vec<String> names = Vec::new();
    for (usize i = 0; i < HashMap::len(&b.gamma); i += 1)
    {
        ref<String, shared> k = HashMap::key_at(&b.gamma, i);
        if (Option::is_none(&StringView::find(k, "$")))
        {
            Vec::push(&mut names, String::clone(k));
        }
    }
    for (usize i = 0; i < HashMap::len(&it.fns); i += 1)
    {
        ref<String, shared> k = HashMap::key_at(&it.fns, i);
        ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, k), "a key");
        if (Option::is_some(&f.assoc_type) || StringView::starts_with(&f.name, "$"))
        {
            continue;
        }
        match (StringView::strip_prefix(k, "std::"))
        {
            Some(rest) :
            {
                if (f.export_ && Option::is_none(&StringView::find(rest, "::")))
                {
                    Vec::push(&mut names, String::copy(rest));
                }
            },
            None       :
            {
                if (Option::is_none(&StringView::find(k, "::")))
                {
                    Vec::push(&mut names, String::clone(k));
                }
            },
        }
    }
    foreach (n in ["printf", "sprintf", "eprintf", "assert"])
    {
        Vec::push(&mut names, String::copy(n));
    }
    Vec::sort(&mut names);
    Vec::dedup(&mut names);
    hints::nearest(name, &names)
}

// ---- part 8 ----

fn is_intrinsic_name_tc(ref<String, shared> n) : bool
{
    is_intrinsic_any(n)
}

fn is_float_fn(ref<String, shared> key) : bool
{
    match (StringView::strip_prefix(key, "std::"))
    {
        Some(rest) :
        {
            if (is_float2_fn(key))
            {
                return false;
            }
            Vec<StringView> fs = StringView::split_whitespace(PRELUDE_FLOAT_FNS);
            for (usize i = 0; i < Vec::len(&fs); i += 1)
            {
                if (fs[i] == rest)
                {
                    return true;
                }
            }
            false
        },
        None       : false,
    }
}

fn is_float2_fn(ref<String, shared> key) : bool
{
    *key == "std::atan2" || *key == "std::powf"
}

// D-0252: the functions of `std` called only inside `unsafe`.
fn is_trusted_std_call(ref<String, shared> name) : bool
{
    foreach (n in ["std::String::from_c", "std::Vec::from_c_bytes", "std::Vec::from_raw", "std::copy_to_raw"])
    {
        if (*name == n)
        {
            return true;
        }
    }
    false
}

// How far line `l` is from the current line `cur`, for a message.
fn lines_away(usize cur, usize l) : String
{
    if (l == cur)
    {
        return "on this line";
    }
    if (l < cur)
    {
        usize n = cur - l;
        return if (n == 1) { "on the line above" } else { sprintf("%v lines above", n) };
    }
    usize n = l - cur;
    if (n == 1) { "on the line below, in an earlier pass of the loop" } else { sprintf("%v lines below, in an earlier pass of the loop", n) }
}

fn check_path(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Vec<String>, shared> segs,
) : Result<Option<Type>, String>
{
    if (Vec::len(segs) == 1)
    {
        // `[Binding-Lookup]`'s `temporally-valid(a_x)`: refuted when
        // `valid(x)` is `F`, or (D-0089) `U`.
        Option<Tri> v = match (HashMap::get(&b.flow.valid, &segs[0]))
        {
            Some(t) : Some(*t),
            None    : None,
        };
        bool stale = match (v)
        {
            Some(Tri::F) : true,
            Some(Tri::U) : true,
            _            : false,
        };
        bool reinit = match (&b.reinit_target)
        {
            Some(r) : (*r == segs[0]),
            None    : false,
        };
        if (stale && !reinit)
        {
            StringView n = shown_name(&segs[0]);
            // Bug 062: where it was moved, and the remedies for a move.
            Option<usize> at = match (HashMap::get(&b.moved_at, &segs[0]))
            {
                Some(l) : Some(*l),
                None    : None,
            };
            String where_ = match (at)
            {
                Some(l) : sprintf(" (moved %s)", &lines_away(b.current_line, l)),
                None    : String::new(),
            };
            bool later = match (at)
            {
                Some(l) : l >= b.current_line,
                None    : true,
            };
            // Bug 344: a function value has no copy; bug 261: a collection
            // a `foreach` took by value.
            bool fn_value = match (HashMap::get(&b.gamma, &segs[0]))
            {
                Some(Type::TFn(_)) : true,
                _                  : false,
            };
            bool collection = HashMap::contains(&b.moved_at, &sprintf("%s\u{1}foreach", &segs[0]));
            String foreach_note = if (collection)
            {
                sprintf("; the `foreach (x in %s)` moved it, each element to the loop: loop over `&%s` to keep it", n, n)
            }
            else
            {
                String::new()
            };
            String msg = match (v)
            {
                Some(Tri::F) : if (fn_value)
                {
                    sprintf(
                        "`%s` was moved or dropped before this use%s, and holds no value here; a function value has no copy (no `clone`): write the closure without `move`, so that passing it lends what it captures, make a new closure for each use, or use it before the move",
                        n,
                        &where_,
                    )
                }
                else
                {
                    sprintf(
                        "`%s` was moved or dropped before this use%s, and holds no value here; give it a new value first (`%s = …;`), move a copy there (`clone(&%s)`), or use it before the move%s",
                        n,
                        &where_,
                        n,
                        n,
                        &foreach_note,
                    )
                },
                _ : sprintf(
                    "`%s` may have been moved or dropped before this use%s -- on some path to here%s -- so it may hold no value; move a copy there (`clone(&%s)`), use it before the move, or give it a new value on every path first (`%s = …;`)",
                    n,
                    &where_,
                    if (later) { ", or in an earlier pass of the loop" } else { "" },
                    n,
                    n,
                ),
            };
            refute(b, &named_diag("diag.stale-binding", &with_repair(&msg, "")))?;
        }
        match (lookup_local(b, &segs[0]))
        {
            Some(t) : return Ok(Some(t)),
            None    : {},
        }
        // Bound, but of a type this pass could not determine.
        if (flow_is_tracked(&b.flow, &segs[0]) || HashSet::contains(&b.capture_names, &segs[0]))
        {
            return Ok(None);
        }
    }
    String name = String::join(segs, "::");
    // D-0258: a static is a place of its type (`[Static-Use]`).
    match (HashMap::get(&it.statics, &name))
    {
        Some(s) : return Ok(Some(clone(&s.ty))),
        None    : {},
    }
    match (variant_enum(it, segs))
    {
        Some(enum_name) :
        {
            // D-0303: a variant named as a value is a use of it.
            variant_use(b, it, &enum_name, &segs[Vec::len(segs) - 1], b.current_line)?;
            // `[T-Enum]`: a variant with a payload written without one.
            bool payload = match (variant_arity(it, &enum_name, segs))
            {
                Some(p) : p,
                None    : false,
            };
            if (payload && !HashMap::contains(&it.fns, &name))
            {
                ref<String, shared> v = &segs[Vec::len(segs) - 1];
                // CHG-0452: a variant with fields is made by naming them.
                if (enum_variant_has_fields(it, &enum_name, v))
                {
                    String en = shown_type_name(Option::unwrap_or(StringView::strip_prefix(&enum_name, "std::"), &enum_name));
                    return Err(mismatch(sprintf(
                        "`%s::%s` has fields, and is made by naming them: `%s::%s { .f = …, … }` (D-0324)",
                        &en,
                        v,
                        &en,
                        v,
                    )));
                }
                return Err(mismatch(sprintf(
                    "`%s` carries a value; write `%s(value)` (a variant without `(…)` is one that carries none)",
                    v,
                    v,
                )));
            }
            // A payload-less variant of an enum without type parameters is
            // of that enum, where the name is not also another enum's
            // variant (the expected type picks one then); a generic enum's
            // type parameters are left opaque (`None`).
            return Ok(unit_variant_type(it, &enum_name, segs));
        },
        None            : {},
    }
    if (Vec::len(segs) == 1 && !HashSet::contains(
        &b.capture_names,
        &segs[0],
    ) && !HashMap::contains(
        &it.fns,
        &name,
    ) && !HashMap::contains(&it.externs, &name) && !is_intrinsic_name_tc(&segs[0]))
    {
        // `[Binding-Lookup-Unbound]` / `[Resolve-Unbound]`: a private
        // function of the same name in another module (not `std`'s) is
        // named.
        Option<String> hidden = None;
        for (usize i = 0; i < HashMap::len(&it.fns); i += 1)
        {
            ref<String, shared> k = HashMap::key_at(&it.fns, i);
            ref<FnDecl, shared> f = HashMap::value_at(&it.fns, i);
            if (!f.export_ && Option::is_none(&f.assoc_type) && !f.is_const && StringView::contains(
                k,
                "::",
            ) && !StringView::starts_with(
                k,
                "std::",
            ) && (last_segment(k) == segs[0]))
            {
                bool better = match (&hidden)
                {
                    Some(h) : (*k < *h),
                    None    : true,
                };
                if (better)
                {
                    hidden = Some(String::clone(k));
                }
            }
        }
        // A function of `std` the module did not import.
        String std_key = sprintf("std::%s", &segs[0]);
        bool in_std = match (HashMap::get(&it.fns, &std_key))
        {
            Some(f) : f.export_,
            None    : false,
        } || is_float_fn(&std_key) || is_float2_fn(&std_key) || std_key == "std::printf" || std_key == "std::sprintf" || std_key == "std::eprintf" || std_key == "std::assert";
        String msg = match (hidden)
        {
            Some(k) : sprintf("nothing named `%s` is visible here; `%s` is not exported from its module", &segs[0], &k),
            None    :
            {
                if (in_std)
                {
                    sprintf(
                        "nothing named `%s` is declared here; the standard library's `%s` is brought in by `import std;`",
                        &segs[0],
                        &segs[0],
                    )
                }
                else
                {
                    match (hints::plain_name(&segs[0]))
                    {
                        Some(h) : sprintf("nothing named `%s` is declared here%v", &segs[0], h),
                        None : match (name_meant(&*b, it, &segs[0]))
                        {
                            Some(m) : sprintf("nothing named `%s` is declared here; did you mean `%s`?", &segs[0], &m),
                            None    : sprintf("nothing named `%s` is declared here", &segs[0]),
                        },
                    }
                }
            },
        };
        return Err(named_diag("diag.unbound-name", &msg));
    }
    // A built-in operation named where a value is wanted.
    if (Vec::len(segs) == 1 && is_intrinsic_name_tc(&segs[0]) && !HashSet::contains(
        &b.capture_names,
        &segs[0],
    ) && !HashMap::contains(&it.fns, &name) && !HashMap::contains(&it.externs, &name))
    {
        String msg = sprintf(
            "`%s` is a built-in operation, only called (`%s(…)`); it is not a value",
            &segs[0],
            &segs[0],
        );
        return Err(named_diag("diag.unbound-name", &msg));
    }
    if (Vec::len(segs) > 1 && !HashMap::contains(
        &it.fns,
        &name,
    ) && !HashMap::contains(&it.externs, &name) && !is_intrinsic_name_tc(&name))
    {
        // A qualified path is an item, an `Enum::Variant`, or unbound.
        Vec<String> head = Vec::new();
        for (usize i = 0; i + 1 < Vec::len(segs); i += 1)
        {
            Vec::push(&mut head, String::clone(&segs[i]));
        }
        String prefix = String::join(&head, "::");
        bool is_variant = match (HashMap::get(&it.enums, &prefix))
        {
            Some(e) : Option::is_some(&variant_has_payload(e, &segs[Vec::len(segs) - 1])),
            None    : false,
        };
        if (!is_variant)
        {
            // CHG-0445: the function meant, or where to find `T`'s. A name
            // `modres` did not resolve is as written (`Vec::psh`).
            String std_prefix = sprintf("std::%s", &prefix);
            bool has_plain = HashMap::contains(&it.structs, &prefix) || HashMap::contains(&it.enums, &prefix);
            if (!has_plain && (HashMap::contains(&it.structs, &std_prefix) || HashMap::contains(&it.enums, &std_prefix)))
            {
                prefix = std_prefix;
            }
            bool is_type = HashMap::contains(&it.structs, &prefix) || HashMap::contains(&it.enums, &prefix);
            ref<String, shared> last = &segs[Vec::len(segs) - 1];
            // CHG-0452: what a `String` reads is a view's function, `&s` passed
            // where the view is declared; a literal is the `String` itself; a
            // `Channel` is shared, not copied.
            Option<String> view_fn = None;
            if (prefix == "std::String")
            {
                Vec<str> cands = Vec::new();
                Vec::push(&mut cands, "");
                Vec::append(&mut cands, hints::fn_name(last));
                for (usize k = 0; k < Vec::len(&cands) && Option::is_none(&view_fn); k += 1)
                {
                    String f = if (k == 0) { String::clone(last) } else { String::copy(cands[k]) };
                    bool exported = match (HashMap::get(&it.fns, &sprintf("std::StringView::%s", &f)))
                    {
                        Some(d) : d.export_,
                        None    : false,
                    };
                    if (exported)
                    {
                        view_fn = Some(f);
                    }
                }
            }
            // Bugs 261 and 349: a type parameter has no functions: a trait
            // habit (`T::speak(x)`, `T::clone(x)`).
            if (Vec::len(segs) == 2 && HashMap::contains(&b.subst, &segs[0]))
            {
                ref<String, shared> tp = &segs[0];
                String msg = if (*last == "clone")
                {
                    sprintf(
                        "nothing named `%s::clone`: `%s` is a type parameter, which has no functions of its own; a copy of its value is `clone(x)` (the bound `%s: clone` gives it)",
                        tp,
                        tp,
                        tp,
                    )
                }
                else if (*last == "eq" || *last == "cmp" || *last == "partial_cmp" || *last == "lt")
                {
                    sprintf(
                        "nothing named `%s::%s`: `%s` is a type parameter, which has no functions of its own; its values compare with `==` (the bound `%s: eq`) or `<` (the bound `%s: ordered`)",
                        tp,
                        last,
                        tp,
                        tp,
                        tp,
                    )
                }
                else
                {
                    sprintf(
                        "nothing named `%s::%s`: `%s` is a type parameter, which has no functions of its own (there are no traits); pass the operation as a `fn` parameter, `fn g<%s>(%s x, fn(ref<%s, shared>) : … %s)`, and call it, `%s(&x)`",
                        tp,
                        last,
                        tp,
                        tp,
                        tp,
                        tp,
                        last,
                        last,
                    )
                };
                return Err(named_diag("diag.unbound-name", &with_repair(&msg, "")));
            }
            // Bug 254: Rust's `Vec` accessors.
            Option<String> vec_form = if (prefix == "std::Vec") { hints::vec_form(last, "v") } else { None };
            String hint = if (Option::is_some(&vec_form))
            {
                Option::unwrap(vec_form)
            }
            else if (prefix == "std::String" && *last == "from")
            {
                "; a literal is the `String` where one is declared (`String s = \"text\";`), and `String::copy(v)` copies a view's text"
            }
            else if (prefix == "std::Channel" && *last == "clone")
            {
                "; a `Channel` is not copied: every thread uses the one channel through a reference, `&ch`"
            }
            else
            {
                match (view_fn)
                {
                    Some(f) :
                    {
                        bool more = match (HashMap::get(&it.fns, &sprintf("std::StringView::%s", &f)))
                        {
                            Some(d) : Vec::len(&d.params) > 1,
                            None    : false,
                        };
                        sprintf(
                            "; a `String`'s text is read through its view: `StringView::%s(&s%s)`, `&s` being the view where a `StringView` is declared",
                            &f,
                            if (more) { ", …" } else { "" },
                        )
                    },
                    None : match (function_meant(it, &prefix, last))
                    {
                        Some(f) : sprintf("; did you mean `%s`?", Option::unwrap_or(StringView::strip_prefix(&f, "std::"), &f)),
                        None    :
                        {
                            if (is_type)
                            {
                                sprintf("; `--doc %s` lists its functions", Option::unwrap_or(StringView::strip_prefix(&prefix, "std::"), &prefix))
                            }
                            else
                            {
                                match (path_meant(it, &prefix, last))
                                {
                                    Some(m) : sprintf("; did you mean `%s`?", &m),
                                    None    : String::new(),
                                }
                            }
                        },
                    },
                }
            };
            String msg = sprintf(
                "nothing named `%s`%s",
                Option::unwrap_or(StringView::strip_prefix(&name, "std::"), &name),
                &hint,
            );
            return Err(named_diag("diag.unbound-name", &msg));
        }
    }
    if (is_trusted_std_call(&name))
    {
        String msg = sprintf(
            "`%s` is only called, inside `unsafe { }`, never used as a value",
            Option::unwrap_or(StringView::strip_prefix(&name, "std::"), &name),
        );
        return Err(named_diag("diag.trusted-outside-unsafe", &msg));
    }
    match (HashMap::get(&it.fns, &name))
    {
        Some(f) :
        {
            // `[T-Item]`: a non-generic function item is a value of its
            // `fn(...) : τ` type, and its body is reached.
            if (Vec::len(&f.type_params) == 0)
            {
                record_instantiation(b, &name, &Vec::new());
                return Ok(Some(fn_type_of(f)));
            }
            return Ok(None);
        },
        None    : {},
    }
    if (HashMap::contains(&it.externs, &name))
    {
        // D-0252: an `extern fn` is only called, inside `unsafe`.
        String msg = sprintf(
            "`%s` is a C function: it is only called, inside `unsafe { }`, never used as a value",
            Option::unwrap_or(StringView::strip_prefix(&name, "std::"), &name),
        );
        return Err(named_diag("diag.trusted-outside-unsafe", &msg));
    }
    Ok(None)
}

fn fn_type_of(ref<FnDecl, shared> f) : Type
{
    Vec<Type> ps = Vec::new();
    for (usize i = 0; i < Vec::len(&f.params); i += 1)
    {
        Vec::push(&mut ps, clone(&f.params[i].ty));
    }
    fn_of(ps, clone(&f.ret))
}

fn plural(usize n) : str
{
    if (n == 1) { "" } else { "s" }
}

fn is_are(usize n) : str
{
    if (n == 1) { "is" } else { "are" }
}

// `[T-Item-Generic]` (D-0093): the type of a generic function item used as
// a value, when this position instantiates it.
fn generic_item_value(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Vec<String>, shared> segs,
    ref<Vec<Type>, shared> targs,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    String name = String::join(segs, "::");
    ref<FnDecl, shared> f = match (HashMap::get(&it.fns, &name))
    {
        Some(f) : f,
        None    : return Ok(None),
    };
    if (Vec::len(&f.type_params) == 0)
    {
        return Ok(None);
    }
    Type decl = fn_type_of(f);
    if (Vec::len(targs) > 0)
    {
        // `[Generic-Call-Arity]`'s analog.
        if (Vec::len(targs) != Vec::len(&f.type_params))
        {
            return Err(mismatch(sprintf(
                "`%s` takes %v type argument%s, and %v %s given",
                &name,
                Vec::len(&f.type_params),
                plural(Vec::len(&f.type_params)),
                Vec::len(targs),
                is_are(Vec::len(targs)),
            )));
        }
        HashMap<String, Type> m = HashMap::new();
        for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
        {
            HashMap::insert(&mut m, String::clone(&f.type_params[i]), apply_subst(&targs[i], &b.subst));
        }
        return Ok(Some(apply_subst(&decl, &m)));
    }
    match (expected)
    {
        Some(exp) : match (exp)
        {
            Type::TFn(eb) :
            {
                if (!has_unresolved_marker(exp))
                {
                    if (Vec::len(&Box::get(eb).params) != Vec::len(&f.params))
                    {
                        return Err(mismatch(sprintf(
                            "`%s` takes %v parameter%s, but `%s` is expected",
                            &name,
                            Vec::len(&f.params),
                            plural(Vec::len(&f.params)),
                            &type_display(exp),
                        )));
                    }
                    HashMap<String, Type> m = HashMap::new();
                    unify_type_shape(&decl, exp, &mut m, &f.type_params);
                    bool all = true;
                    for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
                    {
                        if (!HashMap::contains(&m, &f.type_params[i]))
                        {
                            all = false;
                        }
                    }
                    if (all)
                    {
                        Type inst = apply_subst(&decl, &m);
                        if (type_eq(&inst, exp))
                        {
                            return Ok(Some(inst));
                        }
                        return Err(mismatch(sprintf(
                            "`%s` cannot have the type `%s`: it would be `%s`",
                            &name,
                            &type_display(exp),
                            &type_display(&inst),
                        )));
                    }
                }
            },
            _             : {},
        },
        None : {},
    }
    Ok(None)
}

fn is_bare_str_literal(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EStr(_)   : true,
        ExprKind::EParen(x) : is_bare_str_literal(Box::get(x)),
        _                   : false,
    }
}

// `[T-Enum]`: a variant is a value of its enum, whatever type arguments are
// left for the context to fix (`None`, `Ok(3)`), so where a type is expected
// that is not that enum it does not fit. A type parameter, `never` and
// `void` expect nothing here.
fn variant_fits_expected(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<String, shared> enum_name,
    ref<Vec<String>, shared> segs,
    ref<Option<Type>, shared> expected,
) : Result<void, String>
{
    ref<Type, shared> exp = match (expected)
    {
        Some(t) : t,
        None    : return Ok(()),
    };
    bool open = match (exp)
    {
        Type::TNamed(nb) :
        {
            ref<String, shared> n = &Box::get(nb).name;
            *n == *enum_name || is_marker(exp) || HashMap::contains(&b.subst, n) || !(HashMap::contains(&it.enums, n) || HashMap::contains(&it.structs, n))
        },
        Type::TNever     : true,
        Type::TVoid      : true,
        _                : false,
    };
    if (open)
    {
        return Ok(());
    }
    ref<String, shared> v = &segs[Vec::len(segs) - 1];
    StringView shown = Option::unwrap_or(StringView::strip_prefix(enum_name, "std::"), enum_name);
    Err(mismatch(sprintf("`%s` is a value of `%s`, where `%s` is expected", v, shown, &type_display(exp))))
}

fn variant_operand_fits(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e, ref<Option<Type>, shared> other) : Result<void, String>
{
    ref<Expr, shared> x = strip_parens_tc(e);
    ref<Vec<String>, shared> segs = match (&x.kind)
    {
        ExprKind::EPath(pb) : &Box::get(pb).segs,
        ExprKind::ECall(cb) : match (&Box::get(cb).callee.kind)
        {
            ExprKind::EPath(pb) : &Box::get(pb).segs,
            _                   : return Ok(()),
        },
        _                   : return Ok(()),
    };
    if (Vec::len(segs) == 1 && is_local(b, &segs[0]))
    {
        return Ok(());
    }
    match (variant_enum(it, segs))
    {
        Some(en) : variant_fits_expected(b, it, &en, segs, other),
        None     : Ok(()),
    }
}

fn variant_index_of(ref<EnumDecl, shared> e, ref<String, shared> name) : Option<usize>
{
    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
    {
        if (e.variants[i].name == *name)
        {
            return Some(i);
        }
    }
    None
}

// Enum variant construction, `Vi(e)`; `None` when the call is not one.
// CHG-0452: `a`, `b`, the names quoted and listed.
fn quoted_list(ref<Vec<String>, shared> v) : String
{
    Vec<String> q = Vec::new();
    foreach (n in v)
    {
        Vec::push(&mut q, sprintf("`%s`", n));
    }
    String::join(&q, ", ")
}

// CHG-0452: `T` of a `Box<T>`.
fn box_payload(ref<Type, shared> t) : Option<Type>
{
    match (t)
    {
        Type::TNamed(nb) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (n.name == "std::Box" && Vec::len(&n.args) == 1) { Some(clone(&n.args[0])) } else { None }
        },
        _                : None,
    }
}

// D-0324: whether variant `vn` of enum `ek` is written with named fields.
fn enum_variant_has_fields(ref<Items, shared> it, ref<String, shared> ek, ref<String, shared> vn) : bool
{
    match (HashMap::get(&it.enums, ek))
    {
        Some(e) :
        {
            foreach (v in &e.variants)
            {
                if (v.name == *vn && v.fields)
                {
                    return true;
                }
            }
            false
        },
        None    : false,
    }
}

fn variant_call_arity(ref<Body, shared> b, ref<Items, shared> it, ref<Vec<String>, shared> segs, usize n) : Result<void, String>
{
    if (Vec::len(segs) == 1 && is_local(b, &segs[0]))
    {
        return Ok(());
    }
    String enum_name = match (variant_enum(it, segs))
    {
        Some(e) : e,
        None    : return Ok(()),
    };
    if (HashMap::contains(&it.fns, &String::join(segs, "::")))
    {
        return Ok(());
    }
    ref<String, shared> v = &segs[Vec::len(segs) - 1];
    String written = String::join(segs, "::");
    if (enum_variant_has_fields(it, &enum_name, v))
    {
        return Err(mismatch(sprintf("`%s` has fields, and is made by naming them: `%s { .f = …, … }` (D-0324)", v, &written)));
    }
    match (variant_arity(it, &enum_name, segs))
    {
        Some(false) : Err(mismatch(sprintf("`%s` carries no value: write `%s`, without `()`", v, &written))),
        Some(true)  : Err(mismatch(sprintf("`%s` carries one value: write `%s(value)`", v, &written))),
        None        : Ok(()),
    }
}

fn check_variant_call(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Vec<String>, shared> segs,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    ref<Option<Type>, shared> expected,
    usize line,
) : Option<Result<Option<Type>, String>>
{
    String enum_name = variant_enum(it, segs)?;
    // D-0303: a variant's constructor is a use of it.
    match (variant_use(b, it, &enum_name, &segs[Vec::len(segs) - 1], line))
    {
        Err(d) : return Some(Err(d)),
        Ok(_)  : {},
    }
    match (variant_fits_expected(b, it, &enum_name, segs, expected))
    {
        Err(d) : return Some(Err(d)),
        Ok(_)  : {},
    }
    ref<EnumDecl, shared> e = HashMap::get(&it.enums, &enum_name)?;
    usize vi = variant_index_of(e, &segs[Vec::len(segs) - 1])?;
    // `[T-Enum]`: a payload-less `Vi` is written bare.
    match (variant_arity(it, &enum_name, segs))
    {
        Some(false) : return Some(Err("diag.type-mismatch")),
        _           : {},
    }
    // D-0324: a variant with fields is made by naming them (`modres` made
    // `E::V { … }` this call of its hidden struct's literal).
    if (e.variants[vi].fields && !b.derived && Vec::len(args) == 1)
    {
        bool made = match (&args[0].kind)
        {
            ExprKind::EStructLit(sb) :
            {
                ref<Vec<String>, shared> ss = &Box::get(sb).segs;
                Vec::len(ss) > 0 && StringView::contains(&ss[Vec::len(ss) - 1], "$")
            },
            _                        : false,
        };
        if (!made)
        {
            String en = shown_type_name(Option::unwrap_or(StringView::strip_prefix(&enum_name, "std::"), &enum_name));
            ref<String, shared> vn = &e.variants[vi].name;
            return Some(Err(mismatch(sprintf(
                "`%s::%s` has fields, and is made by naming them: `%s::%s { .f = …, … }` (D-0324)",
                &en,
                vn,
                &en,
                vn,
            ))));
        }
    }
    ref<Type, shared> raw_payload = match (&e.variants[vi].payload)
    {
        Some(p) : p,
        None    : return None,
    };
    Some(check_variant_payload(b, it, &enum_name, e, raw_payload, segs, targs, args, expected))
}

fn check_variant_payload(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> enum_name,
    ref<EnumDecl, shared> e,
    ref<Type, shared> raw_payload,
    ref<Vec<String>, shared> segs,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    HashMap<String, Type> m = HashMap::new();
    for (usize i = 0; i < Vec::len(&e.type_params) && i < Vec::len(targs); i += 1)
    {
        HashMap::insert(&mut m, String::clone(&e.type_params[i]), apply_subst(&targs[i], &b.subst));
    }
    // `rule.type.expected`: an expected type of this enum supplies the
    // type arguments not written.
    match (expected)
    {
        Some(Type::TNamed(nb)) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if ((n.name == *enum_name) && Vec::len(&n.args) == Vec::len(&e.type_params))
            {
                for (usize i = 0; i < Vec::len(&e.type_params); i += 1)
                {
                    if (!HashMap::contains(&m, &e.type_params[i]) && !has_unresolved_marker(&n.args[i]))
                    {
                        HashMap::insert(&mut m, String::clone(&e.type_params[i]), clone(&n.args[i]));
                    }
                }
            }
        },
        _                      : {},
    }
    HashSet<String> remaining = HashSet::new();
    for (usize i = 0; i < Vec::len(&e.type_params); i += 1)
    {
        if (!HashMap::contains(&m, &e.type_params[i]))
        {
            HashSet::insert(&mut remaining, String::clone(&e.type_params[i]));
        }
    }
    Type hint = apply_subst(raw_payload, &m);
    Option<Type> at = None;
    if (mentions_any(&hint, &remaining))
    {
        bool saved = b.infer_poisoned;
        b.infer_poisoned = true;
        Result<Option<Type>, String> r = check_store_operand(b, it, &args[0], &None);
        b.infer_poisoned = saved;
        at = r?;
    }
    else if (literal_in_position(b, &hint, &args[0]))
    {
        // D-0225, D-0304: `[Str-Literal-View]` and `[Str-Literal-String]`
        // through the constructor.
        at = Some(clone(&hint));
    }
    else
    {
        Option<Type> t = check_store_operand(b, it, &args[0], &Some(clone(&hint)))?;
        bool viewed = false;
        // `[T-Enum]`: the payload has the variant's type.
        match (&t)
        {
            Some(tt) :
            {
                if (ty_compat(tt, &hint))
                {
                    whole_slice_lint(b, it, &hint, &args[0]);
                }
                if (!has_unresolved_marker(tt) && !has_unresolved_marker(&hint) && !is_never(tt) && !ty_compat(
                    tt,
                    &hint,
                ))
                {
                    // D-0302: text viewed where the payload is a `StringView`
                    // once the expected type has fixed it, as for a literal (D-0225).
                    if (view_of_text(b, it, &hint, tt, &args[0]))
                    {
                        viewed = true;
                    }
                    else
                    {
                        return Err(mismatch(sprintf(
                            "`%s` holds a `%s`, but this is `%s`%s",
                            &segs[Vec::len(segs) - 1],
                            &type_display(&hint),
                            &type_display(tt),
                            &conversion_hint(&hint, tt, Some(&args[0])),
                        )));
                    }
                }
            },
            None     : {},
        }
        at = if (viewed) { Some(clone(&hint)) } else { t };
    }
    // Bug 044: the payload's type, and the arguments, moved, not copied (at
    // every level of `Some(Some(…))` they were).
    match (at)
    {
        Some(a) :
        {
            match (type_param_named(raw_payload, &e.type_params))
            {
                Some(pn) :
                {
                    if (!HashMap::contains(&m, &pn))
                    {
                        HashMap::insert(&mut m, pn, a);
                    }
                },
                None     : unify_type_shape(raw_payload, &a, &mut m, &e.type_params),
            }
        },
        None    : {},
    }
    Vec<Type> targs_c = Vec::new();
    for (usize i = 0; i < Vec::len(&e.type_params); i += 1)
    {
        match (HashMap::swap_remove(&mut m, &e.type_params[i]))
        {
            Some(t) : Vec::push(&mut targs_c, t),
            None    : return Ok(None),
        }
    }
    Ok(Some(named(enum_name, targs_c)))
}

struct Shape
{
    usize tmin;
    usize tmax;
    usize amin;
    usize amax;
    str form;
}

fn shape(usize tmin, usize tmax, usize amin, usize amax, str form) : Option<Shape>
{
    Some(Shape { .tmin = tmin, .tmax = tmax, .amin = amin, .amax = amax, .form = form })
}

// WI-15's intrinsic shapes: an intrinsic's type and value arity, and how
// it is written.
fn intrinsic_shape(StringView n) : Option<Shape>
{
    foreach (x in ["sizeof", "alignof", "dangling", "null_rawptr"])
    {
        if (n == x)
        {
            return shape(1, 1, 0, 0, "<T>()");
        }
    }
    if (n == "min_value" || n == "max_value")
    {
        return shape(0, 1, 0, 0, "<T>()");
    }
    foreach (x in ["widen", "narrow", "narrow_wrapping", "reinterpret", "to_float", "to_int", "checked_narrow"])
    {
        if (n == x)
        {
            return shape(1, 1, 1, 1, "<T>(x)");
        }
    }
    if (n == "reinterpret_ptr" || n == "reclaim")
    {
        return shape(1, 1, 1, 1, "<T>(p)");
    }
    if (n == "rawptr_of")
    {
        return shape(0, 1, 1, 1, "(r)");
    }
    if (n == "rawptr_from_address")
    {
        return shape(1, 1, 1, 1, "<T>(a)");
    }
    if (n == "rawptr_address")
    {
        return shape(0, 1, 1, 1, "(p)");
    }
    foreach (x in ["count_ones", "leading_zeros", "trailing_zeros"])
    {
        if (n == x)
        {
            return shape(0, 0, 1, 1, "(x)");
        }
    }
    if (n == "checked_neg")
    {
        return shape(0, 1, 1, 1, "(x)");
    }
    if (n == "rotate_left" || n == "rotate_right")
    {
        return shape(0, 0, 2, 2, "(x, k)");
    }
    foreach (x in [
        "wrapping_add",
        "wrapping_sub",
        "wrapping_mul",
        "saturating_add",
        "saturating_sub",
        "saturating_mul",
        "checked_add",
        "checked_sub",
        "checked_mul",
        "checked_div",
        "checked_rem",
    ])
    {
        if (n == x)
        {
            return shape(0, 1, 2, 2, "(a, b)");
        }
    }
    foreach (x in ["str_len", "str_ptr", "slice_len"])
    {
        if (n == x)
        {
            return shape(0, 0, 1, 1, "(s)");
        }
    }
    if (n == "str_byte")
    {
        return shape(0, 0, 2, 2, "(s, i)");
    }
    // Report 066: `Result::unwrap`'s and `expect`'s fault, naming the error.
    if (n == "unwrap_failed_with")
    {
        return shape(0, 0, 2, 2, "(&e, head)");
    }
    if (n == "drop")
    {
        return shape(0, 1, 1, 1, "(x)");
    }
    foreach (x in ["join", "cancel", "lock"])
    {
        if (n == x)
        {
            return shape(0, 1, 1, 1, "(h)");
        }
    }
    if (n == "allocate")
    {
        return shape(0, 0, 2, 2, "(bytes, align)");
    }
    if (n == "deallocate")
    {
        return shape(0, 0, 3, 3, "(p, bytes, align)");
    }
    if (n == "release")
    {
        return shape(0, 0, 2, 2, "(p, n)");
    }
    if (n == "copy_raw")
    {
        return shape(0, 0, 3, 3, "(dst, src, n)");
    }
    if (n == "join_status")
    {
        return shape(0, 1, 2, 2, "(&h, mode)");
    }
    if (n == "Mutex::new")
    {
        return shape(0, 1, 1, 1, "(x)");
    }
    if (n == "std::Result::map_err")
    {
        return shape(0, 2, 2, 2, "(r, f)");
    }
    if (n == "spawn")
    {
        return shape(0, 0, 1, max_value<usize>(), "(f, a…)");
    }
    if (n == "atomic_op")
    {
        return shape(0, 0, 4, 4, "(a, op, x, y)");
    }
    if (n == "atomic_wait_op")
    {
        return shape(0, 0, 3, 3, "(a, op, seen)");
    }
    if (n == "cpu_op")
    {
        return shape(0, 0, 1, 1, "(op)");
    }
    // D-0254
    if (n == "simd_load")
    {
        return shape(1, 1, 2, 2, "<V>(s, i)");
    }
    if (n == "simd_store")
    {
        return shape(0, 0, 3, 3, "(s, i, v)");
    }
    if (is_simd_pair_intrinsic(n))
    {
        return shape(0, 0, 2, 2, "(a, b)");
    }
    if (n == "simd_select")
    {
        return shape(0, 0, 3, 3, "(mask, a, b)");
    }
    foreach (x in ["simd_any", "simd_all", "simd_sum", "simd_reduce_min", "simd_reduce_max"])
    {
        if (n == x)
        {
            return shape(0, 0, 1, 1, "(v)");
        }
    }
    None
}

fn is_std_only_intrinsic(StringView n) : bool
{
    foreach (x in [
        "str_slice",
        "append_native",
        "text_write",
        "parse_check",
        "parse_value",
        "key_hash",
        "key_eq",
        "key_less",
        "key_less_at",
        "probe_key",
        "probe_eq",
        "swap_places",
        "lend_places",
        "atomic_op",
        "atomic_wait_op",
        "cpu_op",
        "unwrap_failed_with",
    ])
    {
        if (n == x)
        {
            return true;
        }
    }
    false
}

fn is_trusted_intrinsic(StringView n) : bool
{
    foreach (x in [
        "reclaim",
        "release",
        "copy_raw",
        "deallocate",
        "text_write",
        "parse_check",
        "parse_value",
        "read_volatile",
        "write_volatile",
        "rawptr_from_address",
        "rawptr_address",
    ])
    {
        if (n == x)
        {
            return true;
        }
    }
    false
}

// `rule.arith.alt`'s operations, whose two operands share one type.
fn is_alt_intrinsic(StringView n) : bool
{
    foreach (x in [
        "wrapping_add",
        "wrapping_sub",
        "wrapping_mul",
        "saturating_add",
        "saturating_sub",
        "saturating_mul",
        "checked_add",
        "checked_sub",
        "checked_mul",
        "checked_div",
        "checked_rem",
    ])
    {
        if (n == x)
        {
            return true;
        }
    }
    false
}

// The diagnostics that can happen at run time (phase `dynamic` or `both`
// in spec/registry/diagnostics.md), for `fault`.
fn is_dynamic_diag(ref<String, shared> id) : bool
{
    String spaced = sprintf(" %s ", id);
    StringView::contains(PRELUDE_DYNAMIC_DIAGS, &spaced)
}

fn pelem_eq(ref<PElem, shared> a, ref<PElem, shared> b) : bool
{
    match (a)
    {
        PElem::PField(f) : match (b)
        {
            PElem::PField(g) : (*f == *g),
            _                : false,
        },
        PElem::PIndex(x) : match (b)
        {
            PElem::PIndex(y) : match (x)
            {
                Some(p) : match (y)
                {
                    Some(q) : *p == *q,
                    None    : false,
                },
                None : Option::is_none(y),
            },
            _ : false,
        },
        PElem::PRange(r) : match (b)
        {
            PElem::PRange(s) : match (r)
            {
                Some(r1) : match (s)
                {
                    Some(r2) : r1.lo == r2.lo && r1.hi == r2.hi,
                    None     : false,
                },
                None : Option::is_none(s),
            },
            _ : false,
        },
        PElem::PSpan(x) : match (b)
        {
            PElem::PSpan(y) : x.lo == y.lo && x.hi == y.hi,
            _               : false,
        },
    }
}

// Whether path `p` starts with path `q`.
fn path_starts_with(ref<Vec<PElem>, shared> p, ref<Vec<PElem>, shared> q) : bool
{
    if (Vec::len(q) > Vec::len(p))
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(q); i += 1)
    {
        if (!pelem_eq(&p[i], &q[i]))
        {
            return false;
        }
    }
    true
}

// Whether `k` lies within one of the unsure places.
fn unsure_covers(ref<Vec<Place>, shared> unsure, ref<DerivKey, shared> k) : bool
{
    for (usize i = 0; i < Vec::len(unsure); i += 1)
    {
        if ((unsure[i].root == k.root) && path_starts_with(&k.path, &unsure[i].path))
        {
            return true;
        }
    }
    false
}

// D-0282: an access to `root.path` in `mode` (a `Vec` element read or
// borrowed), against the live holders other than those the access goes
// through.
fn tier_access(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> root,
    ref<Vec<PElem>, shared> path,
    Mode mode,
    ref<HashSet<String>, shared> through,
) : Result<void, String>
{
    bool point = false;
    // Bug 021: only the holders listed for the root (`Flow.rooted`; for a
    // shared access those with an exclusive fact) can conflict; they are
    // taken in the facts' order, and none is walked when none is listed.
    Vec<String> listed = holders_of(&b.flow, root, mode == Mode::Shared);
    if (Vec::len(&listed) == 0)
    {
        return Ok(());
    }
    HashSet<String> cand = names_set(listed);
    Vec<String> hs = holder_names(b);
    for (usize hi = 0; hi < Vec::len(&hs); hi += 1)
    {
        ref<String, shared> h = &hs[hi];
        if (!HashSet::contains(&cand, h) || HashSet::contains(through, h))
        {
            continue;
        }
        bool tier_d = match (HashMap::get(&b.gamma, h))
        {
            Some(t) : tier_d_type(it, t),
            None    : false,
        };
        if (tier_d && !is_holder(b, it, h))
        {
            continue;
        }
        // Liveness (`holder_live_after` follows who reaches `h`) is asked
        // only of a holder with a fact at this root.
        Option<bool> live = None;
        Vec<DerivFact> facts = facts_of(b, h, false);
        for (usize k = 0; k < Vec::len(&facts); k += 1)
        {
            ref<DerivFact, shared> d = &facts[k];
            if (d.v == Tri::F || d.key.root != *root || permitted(mode, d.key.mode))
            {
                continue;
            }
            bool compound = Vec::contains(&b.compound_held, h);
            if (!compound)
            {
                bool is_live = match (live)
                {
                    Some(l) : l,
                    None    :
                    {
                        bool l = holder_live_after(b, it, h);
                        live = Some(l);
                        l
                    },
                };
                if (!is_live)
                {
                    break;
                }
            }
            match (overlap3(&d.key.path, path))
            {
                Ov::OvNo    : {},
                Ov::OvMaybe : point = true,
                Ov::OvYes   :
                {
                    // The hidden reference's fact may be its whole
                    // container (`&mut v[f(x)]`): which element is a value.
                    // D-0340 §8: an element a thread may hold, lent on an
                    // earlier round of a loop, is the same element: refused
                    // as a sure one is (whether the thread has ended depends
                    // on timing).
                    if (compound)
                    {
                        point = true;
                    }
                    else if (d.v != Tri::T && !(thread_holder(b, h) && held_across_rounds(b, h)))
                    {
                        point = true;
                    }
                    else if (d.v != Tri::T)
                    {
                        String msg = sprintf(
                            "`%s` may still be lent to a thread %s holds (`spawn`, D-0213; lent on an earlier round of the loop), and whether that thread has ended depends on timing, so it cannot be %s here",
                            &shown_place(&d.key.root, &d.key.path),
                            &holder_text(h),
                            if (mode == Mode::Exclusive) { "written or borrowed `mut`" } else { "read" },
                        );
                        return refute(b, &named_diag("diag.aliasing-conflict", &msg));
                    }
                    else
                    {
                        String msg = sprintf(
                            "%s still borrows `%s`, so it cannot be %s here",
                            &holder_text(h),
                            &shown_place(&d.key.root, &d.key.path),
                            if (mode == Mode::Exclusive) { "written or borrowed `mut`" } else { "read" },
                        );
                        if (zero_sized_vec_element(b, it, &d.key.root, &d.key.path))
                        {
                            String::append(&mut msg, " (every element of a `Vec` of a zero-sized type is one place)");
                        }
                        return refute(b, &named_diag("diag.aliasing-conflict", &msg));
                    }
                },
            }
        }
    }
    if (point)
    {
        usize line = b.current_line;
        b.rep.point_checks += 1;
        Vec::push(&mut b.rep.events, sprintf("P\t%v\t%s\telement", line, root));
        rep_left(
            b,
            sprintf("line %v: an element of `%s` that only values decide", line, shown_name(root)),
        );
    }
    Ok(())
}

// An element of a `Vec` read (`v[i]`, `v[i].f`) or borrowed: what it
// reaches, for `tier_access`.
fn tier_elem_access(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> e,
    Mode mode,
) : Result<void, String>
{
    if (!b.report || b.flow.unreachable)
    {
        return Ok(());
    }
    ref<Expr, shared> x = strip_parens_tc(e);
    while (true)
    {
        match (&x.kind)
        {
            ExprKind::EField(f) : x = strip_parens_tc(&Box::get(f).e),
            _                   : break,
        }
    }
    match (vec_element_root(b, it, x))
    {
        Some(p) :
        {
            HashSet<String> through = HashSet::new();
            match (&x.kind)
            {
                ExprKind::EIndex(ib) :
                {
                    ref<Expr, shared> y = strip_parens_tc(&Box::get(ib).a);
                    while (true)
                    {
                        match (&y.kind)
                        {
                            ExprKind::EField(f) : y = strip_parens_tc(&Box::get(f).e),
                            ExprKind::EDeref(d) : y = strip_parens_tc(Box::get(d)),
                            ExprKind::EIndex(p) : y = strip_parens_tc(&Box::get(p).a),
                            ExprKind::EPath(_)  :
                            {
                                match (one_seg(y))
                                {
                                    Some(n) :
                                    {
                                        HashSet::insert(&mut through, String::clone(n));
                                    },
                                    None    : {},
                                }
                                break;
                            },
                            _                   : break,
                        }
                    }
                },
                _                    : {},
            }
            return tier_access(b, it, &p.root, &p.path, mode, &through);
        },
        None    : {},
    }
    Ok(())
}

// D-0282: rules at an assignment. (1) Its place is found before its value
// is computed (D-0007): a value that takes the place's container
// exclusively (`v[0].x = grow(&mut v)`) may move the place, which is a
// conflict decided here. (2) A place that holds a resource is checked,
// when written, for the value it holds: a test of that value (a
// discriminant), with no tracking state: a point check.
fn tier_assign_rules(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> lhs,
    ref<Expr, shared> rhs,
) : Result<void, String>
{
    if (!b.report || b.flow.unreachable)
    {
        return Ok(());
    }
    usize line = b.current_line;
    // The container the place is found in: its root's keys, extended by the
    // fields from the root to the root-most index (`p.cpu.r` of
    // `p.cpu.r[0]`); only a value taking that or a place around it
    // exclusively may move the element. Through a dereference, the whole
    // referent.
    ref<Expr, shared> base = strip_parens_tc(lhs);
    bool elem = false;
    Vec<String> fields = Vec::new();
    while (true)
    {
        match (&base.kind)
        {
            ExprKind::EField(f)  :
            {
                Vec::push(&mut fields, String::clone(&Box::get(f).name));
                base = strip_parens_tc(&Box::get(f).e);
            },
            ExprKind::EDeref(x)  :
            {
                Vec::clear(&mut fields);
                base = strip_parens_tc(Box::get(x));
            },
            ExprKind::EIndex(p)  :
            {
                elem = true;
                Vec::clear(&mut fields);
                base = strip_parens_tc(&Box::get(p).a);
            },
            ExprKind::ECall(cb)  :
            {
                // `*Vec::index_exclusive(&mut v, i) = …`
                ref<CallExpr, shared> c = Box::get(cb);
                bool indexer = match (path_segs(&c.callee))
                {
                    Some(segs) : Vec::len(segs) > 0 && StringView::starts_with(&segs[Vec::len(segs) - 1], "index"),
                    None       : false,
                };
                if (indexer && Vec::len(&c.args) > 0)
                {
                    elem = true;
                    Vec::clear(&mut fields);
                    base = strip_parens_tc(&c.args[0]);
                }
                else
                {
                    break;
                }
            },
            ExprKind::EBorrow(x) : base = strip_parens_tc(&Box::get(x).e),
            _                    : break,
        }
    }
    Vec<DerivFact> through_elem = Vec::new();
    if (elem)
    {
        through_elem = Option::unwrap_or(inherited_facts(b, it, base, 0), Vec::new());
        for (usize i = 0; i < Vec::len(&through_elem); i += 1)
        {
            for (usize k = Vec::len(&fields); k > 0; k -= 1)
            {
                Vec::push(&mut through_elem[i].key.path, PElem::PField(String::clone(&fields[k - 1])));
            }
        }
    }
    if (Vec::len(&through_elem) > 0)
    {
        Vec<DerivKey> excl = Vec::new();
        Vec<Expr> bs = Vec::new();
        excl_borrows_in(rhs, &mut bs);
        for (usize i = 0; i < Vec::len(&bs); i += 1)
        {
            match (inherited_facts(b, it, &bs[i], 0))
            {
                Some(v) :
                {
                    for (usize k = 0; k < Vec::len(&v); k += 1)
                    {
                        Vec::push(&mut excl, clone(&v[k].key));
                    }
                },
                None    : {},
            }
        }
        for (usize i = 0; i < Vec::len(&through_elem); i += 1)
        {
            ref<DerivKey, shared> k = &through_elem[i].key;
            for (usize x = 0; x < Vec::len(&excl); x += 1)
            {
                if ((excl[x].root == k.root) && overlap3(&excl[x].path, &k.path) != Ov::OvNo)
                {
                    String msg = sprintf(
                        "the place is found before the value is computed, and the value takes `%s` exclusively, which may move the place (evaluation order, D-0007)",
                        shown_name(&k.root),
                    );
                    return refute(b, &named_diag("diag.stale-binding", &msg));
                }
            }
        }
    }
    bool res_place = match (static_place_type(b, it, lhs))
    {
        Some(t) : is_resource_ty(it, &t),
        None    : false,
    };
    if (res_place)
    {
        b.rep.point_checks += 1;
        Vec::push(&mut b.rep.events, sprintf("P\t%v\tresource place written: its value is tested", line));
    }
    Ok(())
}

// Whether a call argument may be or hold a reference: a borrow, a slice,
// or a value whose type may hold one (unknown types may).
fn arg_may_be_reference(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> a) : bool
{
    match (&strip_parens_tc(a).kind)
    {
        ExprKind::EBorrow(_)  : true,
        ExprKind::ESliceOf(_) : true,
        ExprKind::EInt(_)     : false,
        ExprKind::EBool(_)    : false,
        ExprKind::EFloat(_)   : false,
        // Report 131: arithmetic, a comparison or a logical operator gives
        // a number or a `bool`, never a reference; so does a conversion.
        ExprKind::EBinary(_)  : false,
        ExprKind::EUnary(_)   : false,
        ExprKind::ECall(c) : match (one_seg(&Box::get(c).callee))
        {
            Some(n) : if (!is_local(b, n) && (*n == "widen" || *n == "narrow" || *n == "narrow_wrapping" || *n == "to_float" || *n == "to_int" || *n == "reinterpret"))
            {
                false
            }
            else
            {
                match (shape_or_place(b, it, a))
                {
                    Some(t) : is_borrow_ty(&t) || may_hold_ref(it, &t, 0),
                    None    : true,
                }
            },
            None : match (shape_or_place(b, it, a))
            {
                Some(t) : is_borrow_ty(&t) || may_hold_ref(it, &t, 0),
                None    : true,
            },
        },
        ExprKind::EBlock(bk) : match (&bk.tail)
        {
            Some(t) : arg_may_be_reference(b, it, Box::get(t)),
            None    : false,
        },
        ExprKind::EIf(ib)     :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            match (&x.then_.tail)
            {
                Some(t) : arg_may_be_reference(b, it, Box::get(t)) || match (&x.else_)
                {
                    Some(e2) : arg_may_be_reference(b, it, e2),
                    None     : false,
                },
                None : true,
            }
        },
        _ : match (shape_or_place(b, it, a))
        {
            Some(t) : is_borrow_ty(&t) || may_hold_ref(it, &t, 0),
            None    : true,
        },
    }
}

// The bindings a reference argument is formed through (`r` in `&mut r.x`,
// `Vec::index_shared(&*r, 0)`, `r` itself): reaching through them is not
// a conflict with them. A binding named only in an index or a value
// argument is checked as any other holder.
fn roots_in(ref<Expr, shared> e, ref<HashSet<String>, exclusive> out)
{
    match (&e.kind)
    {
        ExprKind::EPath(_) : match (one_seg(e))
        {
            Some(n) :
            {
                HashSet::insert(out, String::clone(n));
            },
            None    : {},
        },
        ExprKind::EParen(x)   : roots_in(Box::get(x), out),
        ExprKind::EDeref(x)   : roots_in(Box::get(x), out),
        ExprKind::EField(f)   : roots_in(&Box::get(f).e, out),
        ExprKind::EBorrow(x)  : roots_in(&Box::get(x).e, out),
        ExprKind::EIndex(p)   : roots_in(&Box::get(p).a, out),
        ExprKind::ESliceOf(s) : roots_in(&Box::get(s).base, out),
        // A call on a reference (D-0011): its reference arguments, not its
        // values (`String::part(&s, h.lo, h.hi)` reaches through `s`, not
        // `h`).
        ExprKind::ECall(cb)   :
        {
            ref<Vec<Expr>, shared> xs = &Box::get(cb).args;
            for (usize i = 0; i < Vec::len(xs); i += 1)
            {
                bool follow = match (&strip_parens_tc(&xs[i]).kind)
                {
                    ExprKind::EBorrow(_)  : true,
                    ExprKind::ESliceOf(_) : true,
                    ExprKind::EPath(_)    : true,
                    ExprKind::ECall(_)    : true,
                    _                     : false,
                };
                if (follow)
                {
                    roots_in(&xs[i], out);
                }
            }
        },
        _                     : {},
    }
}

// What a call reaches through one argument (`tier_call_rule`).
struct Access
{
    usize idx;
    Option<String> holder;
    Vec<DerivKey> whole;
    Vec<DerivKey> proj;
    // The summary's field path of each `proj` key (D-0283's point check
    // extends the argument's place by it).
    Vec<Vec<String>> fields;
    // The whole keys whose facts hold on some paths only (`?`): a conflict
    // through them is the run's to decide.
    Vec<Place> unsure;
}

fn is_borrow_or_slice_expr(ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EBorrow(_)  : true,
        ExprKind::ESliceOf(_) : true,
        _                     : false,
    }
}

fn borrow_expr_mode(ref<Expr, shared> e) : Option<Mode>
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::EBorrow(x)  : Some(Box::get(x).mode),
        ExprKind::ESliceOf(x) : Some(Box::get(x).mode),
        _                     : None,
    }
}

fn is_type_param(ref<Type, shared> t, ref<Vec<String>, shared> type_params) : bool
{
    match (t)
    {
        Type::TNamed(nb) : Vec::len(&Box::get(nb).args) == 0 && Vec::contains(type_params, &Box::get(nb).name),
        _                : false,
    }
}

fn shared_ref_param(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TRef(x)   : Box::get(x).mode == Mode::Shared,
        Type::TSlice(x) : Box::get(x).mode == Mode::Shared,
        _               : false,
    }
}

// Whether some live holder other than `h` holds a fact rooted at `*h`.
fn kept_alive_through(ref<Body, shared> b, ref<String, shared> h) : bool
{
    String rh = referent_root(h);
    for (usize i = 0; i < HashMap::len(&b.flow.deriv); i += 1)
    {
        ref<String, shared> o = HashMap::key_at(&b.flow.deriv, i);
        if ((*o == *h) || !rep_live_after(&b.rep, o, b.current_line, b.current_col))
        {
            continue;
        }
        ref<HashMap<String, DerivFact>, shared> fs = HashMap::value_at(&b.flow.deriv, i);
        for (usize k = 0; k < HashMap::len(fs); k += 1)
        {
            if (((HashMap::value_at(fs, k).key.root) == rh))
            {
                return true;
            }
        }
    }
    false
}

fn point_check(
    usize arg,
    ref<Vec<String>, shared> fields,
    Mode mode,
    PointOther other,
    Mode other_mode,
    StringView callee,
) : PointCheck
{
    PointCheck { .arg = arg, .fields = clone(fields), .mode = mode, .other = other, .other_mode = other_mode, .callee = String::copy(callee) }
}

// D-0282: the call-site rule. Each argument that is or holds a reference
// reaches places of this frame (its *whole* keys, in its parameter's
// mode). The callee's access summary says what it does through that
// parameter (its *projected* keys). A live holder of the caller conflicts
// with what the callee does (use-time, D-0018); two arguments conflict
// when what is done through one meets the other's whole referent, which
// lives for the call. A certain conflict is reported as the static pass
// reports one; one that depends on values (an index, a range) is a point
// check.
fn tier_call_rule(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> callee,
    ref<Vec<Expr>, shared> args,
) : Result<void, String>
{
    if (!b.report || b.flow.unreachable)
    {
        return Ok(());
    }
    // An argument that reads a reference binding is a copy of it: a later
    // argument that assigns the binding leaves that copy with no name, so
    // what it reaches is the run's to check.
    for (usize i = 1; i < Vec::len(args); i += 1)
    {
        Vec<String> assigned = Vec::new();
        assigned_names(&args[i], &mut assigned);
        if (Vec::len(&assigned) == 0)
        {
            continue;
        }
        bool read = false;
        for (usize k = 0; k < i && !read; k += 1)
        {
            read = mentions_one_of(&args[k], &assigned);
        }
        if (!read)
        {
            continue;
        }
        for (usize k = 0; k < Vec::len(&assigned); k += 1)
        {
            bool holds = match (HashMap::get(&b.gamma, &assigned[k]))
            {
                Some(t) : holds_ref(it, t),
                None    : false,
            };
            if (holds)
            {
                rep_left(
                    b,
                    sprintf(
                        "line %v: an argument assigns `%s` after an earlier one read it",
                        b.current_line,
                        &assigned[k],
                    ),
                );
                break;
            }
        }
    }
    // A reference argument is formed before the later arguments are
    // computed (D-0007). One of them that takes its root exclusively,
    // assigns into it or moves it may move what it reaches (`set(&mut
    // v[0], grow(&mut v))`): the run's stale-binding check decides. Only an
    // argument that is or holds a reference is formed early: a value
    // (`f(x, g(x))`, `q.flag`) is copied and reaches nothing. A later
    // argument that is itself a borrow is formed in place, after which the
    // call is made: two borrows that meet are the call-site rule's below;
    // only what its operand runs first (an index, a call) can act, and
    // only on a place that overlaps what was reached.
    for (usize i = 0; i + 1 < Vec::len(args); i += 1)
    {
        if (!arg_may_be_reference(b, it, &args[i]))
        {
            continue;
        }
        Vec<DerivFact> facts = match (inherited_facts(b, it, &args[i], 0))
        {
            Some(v) : v,
            None    : continue,
        };
        Vec<String> roots = Vec::new();
        for (usize k = 0; k < Vec::len(&facts); k += 1)
        {
            Vec::push(&mut roots, String::clone(&facts[k].key.root));
        }
        if (Vec::len(&roots) == 0)
        {
            continue;
        }
        bool acts = false;
        for (usize j = i + 1; j < Vec::len(args); j += 1)
        {
            ref<Expr, shared> a = strip_parens_tc(&args[j]);
            Vec<Expr> bs = Vec::new();
            match (&a.kind)
            {
                ExprKind::EBorrow(x)  : excl_borrows_in(&Box::get(x).e, &mut bs),
                ExprKind::ESliceOf(s) :
                {
                    excl_borrows_in(&Box::get(s).base, &mut bs);
                    excl_borrows_in(&Box::get(s).lo, &mut bs);
                    excl_borrows_in(&Box::get(s).hi, &mut bs);
                },
                _                     : excl_borrows_in(a, &mut bs),
            }
            for (usize x = 0; x < Vec::len(&bs); x += 1)
            {
                match (inherited_facts(b, it, &bs[x], 0))
                {
                    Some(v) :
                    {
                        for (usize k = 0; k < Vec::len(&v) && !acts; k += 1)
                        {
                            for (usize f = 0; f < Vec::len(&facts) && !acts; f += 1)
                            {
                                acts = (facts[f].key.root == v[k].key.root) && overlap3(&facts[f].key.path, &v[k].key.path) != Ov::OvNo;
                            }
                        }
                    },
                    None    : {},
                }
            }
            if (acts_on(a, &roots))
            {
                acts = true;
            }
        }
        if (acts)
        {
            rep_left(
                b,
                sprintf("line %v: a later argument acts on what an earlier reference argument reaches", b.current_line),
            );
            break;
        }
    }
    // A call through a local `fn` value: whether it was emptied (moved
    // from) is a test of the value itself, a point check.
    match (one_seg(callee))
    {
        Some(n) :
        {
            bool fn_local = match (HashMap::get(&b.gamma, n))
            {
                Some(Type::TFn(_))      : true,
                Some(Type::TClosure(_)) : true,
                _                       : false,
            };
            if (fn_local)
            {
                usize line = b.current_line;
                b.rep.point_checks += 1;
                Vec::push(&mut b.rep.events, sprintf("P\t%v\tfn value called: its state is tested", line));
            }
        },
        None    : {},
    }
    // `drop(*r)` and the like: moved out through a reference.
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        ref<Expr, shared> a = &args[i];
        match (&strip_parens_tc(a).kind)
        {
            ExprKind::EDeref(inner) : match (one_seg(strip_parens_tc(Box::get(inner))))
            {
                Some(n) :
                {
                    bool moves = match (static_place_type(b, it, a))
                    {
                        Some(t) : is_resource_ty(
                            it,
                            &t,
                        ) || named_is(&t, "std::Atomic") || named_is(&t, "std::Vec") || named_is(&t, "std::String"),
                        None : false,
                    };
                    // Report 318: a guard keeps its mutex's value as a
                    // reference keeps its referent.
                    bool via_guard = match (HashMap::get(&b.gamma, n))
                    {
                        Some(Type::TGuard(_)) : true,
                        _                     : false,
                    };
                    bool is_ref = via_guard || match (HashMap::get(&b.gamma, n))
                    {
                        Some(Type::TRef(_)) : true,
                        _                   : false,
                    };
                    if (moves && is_ref)
                    {
                        String msg = if (via_guard) { moved_out_of_guard_msg(n) } else { moved_out_msg(n, HashMap::len(&b.subst) > 0) };
                        return refute(
                            b,
                            &sprintf("%s%s", &named_diag("diag.move-while-aliased", &msg), &diag_at(a.line, a.col)),
                        );
                    }
                },
                None    : {},
            },
            _ : {},
        }
    }
    String key = match (resolve_fn_path(it, callee))
    {
        Some(k) : k,
        None    : return Ok(()),
    };
    ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &key), "a function");
    HashSet<String> through = HashSet::new();
    for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(args); i += 1)
    {
        ref<Type, shared> pt = &f.params[i].ty;
        // A type parameter's argument counts only when its value is or
        // holds a reference (`*r` given to `Vec::push` is a copy).
        bool generic_ref = is_type_param(
            pt,
            &f.type_params,
        ) && (is_borrow_or_slice_expr(&args[i]) || match (shape_or_place(b, it, &args[i]))
        {
            Some(t) : is_borrow_ty(&t) || holds_ref(it, &t),
            None    : false,
        });
        if (is_borrow_ty(pt) || holds_ref(it, pt) || generic_ref)
        {
            roots_in(&args[i], &mut through);
        }
    }
    ref<Summaries, shared> sums = Option::expect(match (&it.tier_summaries)
    {
        Some(s) : Some(s),
        None    : None,
    }, "the access summaries");
    Vec<Access> accesses = Vec::new();
    for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(args); i += 1)
    {
        ref<Type, shared> pt = &f.params[i].ty;
        ref<Expr, shared> a = strip_parens_tc(&args[i]);
        // A closure literal given as an argument holds, for the whole call,
        // what its captures reach, each in its own mode (D-0288: one without
        // `move` borrows each captured binding, exclusively when its body
        // writes it), as a bound closure does (bug 009).
        if (is_closure(a))
        {
            Vec<DerivFact> cf = closure_facts_of(b, it, a);
            Vec<DerivKey> cw = Vec::new();
            Vec<Vec<String>> cfields = Vec::new();
            Vec<Place> cunsure = Vec::new();
            for (usize k = 0; k < Vec::len(&cf); k += 1)
            {
                if (is_tier_d_root(&cf[k].key.root) || cf[k].v == Tri::F)
                {
                    continue;
                }
                if (cf[k].v == Tri::U)
                {
                    Vec::push(
                        &mut cunsure,
                        Place { .root = String::clone(&cf[k].key.root), .path = clone(&cf[k].key.path) },
                    );
                }
                Vec::push(&mut cw, clone(&cf[k].key));
                Vec::push(&mut cfields, Vec::new());
            }
            if (Vec::len(&cw) > 0)
            {
                Vec::push(
                    &mut accesses,
                    Access { .idx = i, .holder = None, .whole = clone(&cw), .proj = cw, .fields = cfields, .unsure = cunsure },
                );
            }
            continue;
        }
        Mode mode = match (pt)
        {
            Type::TRef(x)   : Box::get(x).mode,
            Type::TSlice(x) : Box::get(x).mode,
            _               :
            {
                if (holds_ref(it, pt))
                {
                    Mode::Shared
                }
                else if (is_type_param(pt, &f.type_params))
                {
                    // A type parameter: the argument's own value, when it is
                    // or holds a reference (a number is copied).
                    match (borrow_expr_mode(a))
                    {
                        // `&x` given to `T b`: `T` is the borrow's type.
                        Some(m) : m,
                        None : match (shape_or_place(b, it, a))
                        {
                            Some(t) : if (is_borrow_ty(&t) || holds_ref(it, &t)) { Mode::Shared } else { continue },
                            None    : continue,
                        },
                    }
                }
                else
                {
                    continue
                }
            },
        };
        Option<String> holder = match (one_seg(a))
        {
            Some(n) : if (flow_is_tracked(&b.flow, n)) { Some(String::clone(n)) } else { None },
            None    : None,
        };
        Vec<DerivKey> whole = Vec::new();
        Vec<Place> unsure = Vec::new();
        match (&holder)
        {
            Some(h) :
            {
                bool refish = match (HashMap::get(&b.gamma, h))
                {
                    Some(Type::TRef(_))   : true,
                    Some(Type::TSlice(_)) : true,
                    Some(t)               : holds_ref(it, t),
                    None                  : false,
                };
                if (!refish)
                {
                    continue; // a value passed by copy or move
                }
                Vec::push(
                    &mut whole,
                    DerivKey { .root = referent_root(h), .path = Vec::new(), .mode = mode },
                );
                Vec<DerivFact> fs = facts_of(b, h, false);
                for (usize k = 0; k < Vec::len(&fs); k += 1)
                {
                    Vec::push(
                        &mut whole,
                        DerivKey { .root = String::clone(&fs[k].key.root), .path = clone(&fs[k].key.path), .mode = mode },
                    );
                    if (fs[k].v == Tri::U)
                    {
                        Vec::push(
                            &mut unsure,
                            Place { .root = String::clone(&fs[k].key.root), .path = clone(&fs[k].key.path) },
                        );
                    }
                }
            },
            None : match (inherited_facts(b, it, a, 0))
            {
                Some(v) :
                {
                    for (usize k = 0; k < Vec::len(&v); k += 1)
                    {
                        if (v[k].key.root == "<tier D>")
                        {
                            continue;
                        }
                        if (v[k].v == Tri::U)
                        {
                            Vec::push(
                                &mut unsure,
                                Place { .root = String::clone(&v[k].key.root), .path = clone(&v[k].key.path) },
                            );
                        }
                        Vec::push(
                            &mut whole,
                            DerivKey { .root = String::clone(&v[k].key.root), .path = clone(&v[k].key.path), .mode = mode },
                        );
                    }
                },
                None    : {},
            },
        }
        if (Vec::len(&whole) == 0)
        {
            continue;
        }
        // D-0290: what the references kept where an argument reaches reach
        // (a holder's facts, `**q` through a parameter `q`): the callee
        // reaches them through it, in no stronger mode. Only references the
        // parameter's referent type can hold are reached through it: none,
        // or shared ones only.
        HashSet<String> tparams = HashSet::new();
        for (usize k = 0; k < Vec::len(&f.type_params); k += 1)
        {
            HashSet::insert(&mut tparams, String::clone(&f.type_params[k]));
        }
        Option<ref<Type, shared>> reach_t = match (pt)
        {
            Type::TRef(x) : if (!mentions_any(
                &Box::get(x).inner,
                &tparams,
            )) { Some(&Box::get(x).inner) } else { None },
            Type::TSlice(x) : if (!mentions_any(
                &Box::get(x).inner,
                &tparams,
            )) { Some(&Box::get(x).inner) } else { None },
            _ : None,
        };
        bool reach_known = Option::is_some(&reach_t);
        bool reach_any = match (reach_t)
        {
            Some(t) : may_hold_ref(it, t, 0),
            None    : false,
        };
        bool reach_excl = match (reach_t)
        {
            Some(t) : excl_cached(b, it, t),
            None    : false,
        };
        Vec<DerivFact> deep = Vec::new();
        for (usize k = 0; k < Vec::len(&whole); k += 1)
        {
            if (is_holder(b, it, &whole[k].root))
            {
                HashSet::insert(&mut through, String::clone(&whole[k].root));
            }
            if (reach_known && !reach_any)
            {
                continue;
            }
            match (reach_of_root(b, it, &whole[k].root))
            {
                Some(v) :
                {
                    for (usize x = 0; x < Vec::len(&v); x += 1)
                    {
                        DerivFact d = clone(&v[x]);
                        if (mode == Mode::Shared || (reach_known && !reach_excl))
                        {
                            d.key.mode = Mode::Shared;
                        }
                        Vec::push(&mut deep, d);
                    }
                },
                None    : {},
            }
        }
        // What the callee does through this parameter.
        Vec<DerivKey> proj = Vec::new();
        Vec<Vec<String>> fields = Vec::new();
        bool by_summary = match (pt)
        {
            Type::TRef(_)   : true,
            Type::TSlice(_) : true,
            _               : false,
        };
        Option<ref<ParamAccess, shared>> acc = if (by_summary) { summary_param(sums, &key, i) } else { None };
        match (acc)
        {
            Some(ac) :
            {
                bool shared_param = shared_ref_param(pt);
                for (usize k = 0; k < Vec::len(&whole); k += 1)
                {
                    for (usize w = 0; w < Vec::len(&ac.writes); w += 1)
                    {
                        DerivKey q = clone(&whole[k]);
                        // Through a shared parameter a write is interior
                        // mutability (`Atomic`, a guard): still shared.
                        q.mode = if (shared_param) { Mode::Shared } else { Mode::Exclusive };
                        for (usize x = 0; x < Vec::len(&ac.writes[w]); x += 1)
                        {
                            Vec::push(&mut q.path, PElem::PField(String::clone(&ac.writes[w][x])));
                        }
                        Vec::push(&mut proj, q);
                        Vec::push(&mut fields, clone(&ac.writes[w]));
                    }
                    for (usize r = 0; r < Vec::len(&ac.reads); r += 1)
                    {
                        DerivKey q = clone(&whole[k]);
                        q.mode = Mode::Shared;
                        for (usize x = 0; x < Vec::len(&ac.reads[r]); x += 1)
                        {
                            Vec::push(&mut q.path, PElem::PField(String::clone(&ac.reads[r][x])));
                        }
                        Vec::push(&mut proj, q);
                        Vec::push(&mut fields, clone(&ac.reads[r]));
                    }
                }
            },
            None     :
            {
                proj = clone(&whole);
                for (usize k = 0; k < Vec::len(&whole); k += 1)
                {
                    Vec::push(&mut fields, Vec::new());
                }
            },
        }
        // An exclusive reference given where a shared one is taken is
        // borrowed again, shared and whole, as `&*h` is: the run's record
        // has that borrow whatever the callee reads through it, so a live
        // exclusive holder of a part of the referent conflicts here
        // (CHG-0462: `x = &mut e.n; g(e); *x += 1;`, `g` taking
        // `ref<E, shared>`, ran in the default form and faulted with every
        // check).
        bool lowered_mode = mode == Mode::Shared && Option::is_some(&acc) && match (&holder)
        {
            Some(h) : match (HashMap::get(&b.gamma, h))
            {
                Some(Type::TRef(x))   : Box::get(x).mode == Mode::Exclusive,
                Some(Type::TSlice(x)) : Box::get(x).mode == Mode::Exclusive,
                _                     : false,
            },
            None : false,
        };
        if (lowered_mode)
        {
            Vec::push(&mut proj, clone(&whole[0]));
            Vec::push(&mut fields, Vec::new());
        }
        for (usize k = 0; k < Vec::len(&deep); k += 1)
        {
            if (deep[k].v != Tri::T)
            {
                Vec::push(
                    &mut unsure,
                    Place { .root = String::clone(&deep[k].key.root), .path = clone(&deep[k].key.path) },
                );
            }
            Vec::push(&mut whole, clone(&deep[k].key));
            Vec::push(&mut proj, clone(&deep[k].key));
            Vec::push(&mut fields, Vec::new());
        }
        Vec::push(
            &mut accesses,
            Access { .idx = i, .holder = holder, .whole = whole, .proj = proj, .fields = fields, .unsure = unsure },
        );
    }
    Vec<String> point_checks = Vec::new();
    String site = site_key(callee.line, callee.col);
    Vec<PointCheck> pcs = Vec::new();
    StringView shown_key = shown_callee(&key);
    // What the callee does, against the caller's live holders. An argument
    // that is a visible borrow is checked against them where it is formed
    // (`rule.control.flow-analysis`), which refutes every conflict this
    // would, and names the borrow.
    // Bug 021: for each access only the holders listed for its root (as in
    // `tier_access`), in the facts' order.
    Vec<String> hs = Vec::new();
    bool named = false;
    for (usize ai = 0; ai < Vec::len(&accesses); ai += 1)
    {
        ref<Access, shared> acc = &accesses[ai];
        // A closure literal's captures are checked where it is formed.
        if (is_borrow_or_slice_expr(&args[acc.idx]) || is_closure(&args[acc.idx]))
        {
            continue;
        }
        for (usize pi = 0; pi < Vec::len(&acc.proj); pi += 1)
        {
            ref<DerivKey, shared> k = &acc.proj[pi];
            ref<Vec<String>, shared> kf = &acc.fields[pi];
            Vec<String> listed = holders_of(&b.flow, &k.root, k.mode == Mode::Shared);
            if (Vec::len(&listed) == 0)
            {
                continue;
            }
            HashSet<String> cand = names_set(listed);
            if (!named)
            {
                hs = holder_names(b);
                named = true;
            }
            for (usize hi = 0; hi < Vec::len(&hs) && HashSet::len(&cand) > 0; hi += 1)
            {
                ref<String, shared> h = &hs[hi];
                if (!HashSet::contains(&cand, h))
                {
                    continue;
                }
                bool is_own = false;
                bool same_path = false;
                match (&acc.holder)
                {
                    Some(ah) :
                    {
                        is_own = (*ah == *h);
                        same_path = (path_id(b, ah) == path_id(b, h));
                    },
                    None     : {},
                }
                bool another = false;
                for (usize x = 0; x < Vec::len(&accesses) && !another; x += 1)
                {
                    another = match (&accesses[x].holder)
                    {
                        Some(xh) : (*xh == *h),
                        None     : false,
                    };
                }
                if (is_own || same_path || HashSet::contains(&through, h) || another)
                {
                    continue;
                }
                // A tier-D holder's conflicts are the run's to check; a
                // holder of this frame's are not (D-0290).
                bool tier_d = match (HashMap::get(&b.gamma, h))
                {
                    Some(t) : tier_d_type(it, t),
                    None    : false,
                };
                if (tier_d && !is_holder(b, it, h))
                {
                    continue;
                }
                // A holder past its last use has ended (D-0111) -- as are
                // the holders only it keeps alive: one rooted at its
                // referent is checked through it. A binder of a match by
                // reference is no `let` binding and holds to its arm's end.
                if (!HashSet::contains(&b.arm_binders, h) && !rep_live_after(
                    &b.rep,
                    h,
                    b.current_line,
                    b.current_col,
                ) && !kept_alive_through(b, h))
                {
                    continue;
                }
                Vec<DerivFact> facts = facts_of(b, h, false);
                for (usize fi = 0; fi < Vec::len(&facts); fi += 1)
                {
                    ref<DerivFact, shared> d = &facts[fi];
                    if (d.v == Tri::F || d.key.root != k.root || permitted(k.mode, d.key.mode))
                    {
                        continue;
                    }
                    bool sure = d.v == Tri::T && !unsure_covers(&acc.unsure, k);
                    match (overlap3(&d.key.path, &k.path))
                    {
                        Ov::OvNo    : {},
                        Ov::OvMaybe :
                        {
                            Vec::push(
                                &mut point_checks,
                                sprintf("P\t%v\t%s\t%s", b.current_line, shown_name(&k.root), h),
                            );
                            Vec::push(
                                &mut pcs,
                                point_check(
                                    acc.idx,
                                    kf,
                                    k.mode,
                                    PointOther::Holder(String::clone(h)),
                                    d.key.mode,
                                    shown_key,
                                ),
                            );
                        },
                        Ov::OvYes   :
                        {
                            if (!sure)
                            {
                                Vec::push(
                                    &mut point_checks,
                                    sprintf(
                                        "P\t%v\t%s\t%s (on some paths)",
                                        b.current_line,
                                        shown_name(&k.root),
                                        h,
                                    ),
                                );
                                Vec::push(
                                    &mut pcs,
                                    point_check(
                                        acc.idx,
                                        kf,
                                        k.mode,
                                        PointOther::Holder(String::clone(h)),
                                        d.key.mode,
                                        shown_key,
                                    ),
                                );
                            }
                            else
                            {
                                String msg = sprintf(
                                    "`%s` %s `%s` through argument %v while %s still borrows `%s`; end that borrow first",
                                    shown_key,
                                    shown_access(k.mode),
                                    &shown_place(&k.root, &k.path),
                                    acc.idx + 1,
                                    &holder_text(h),
                                    &shown_place(&d.key.root, &d.key.path),
                                );
                                return refute(b, &named_diag("diag.aliasing-conflict", &msg));
                            }
                        },
                    }
                }
            }
        }
    }
    // Between the arguments.
    bool swap = key == "std::swap" || key == "std::swap_places";
    for (usize ai = 0; ai < Vec::len(&accesses); ai += 1)
    {
        for (usize bi = ai + 1; bi < Vec::len(&accesses); bi += 1)
        {
            ref<Access, shared> a = &accesses[ai];
            ref<Access, shared> c = &accesses[bi];
            // `[Swap-Places]`: a place swapped with itself is no conflict.
            if (swap && Vec::len(args) == 2 && same_place(&args[0], &args[1]))
            {
                continue;
            }
            // One reference passed twice, or a copy of it beside it: one
            // path, which does not conflict with itself.
            match (&a.holder)
            {
                Some(x) : match (&c.holder)
                {
                    Some(y) :
                    {
                        if (local_is_ref(b, x) && local_is_ref(b, y) && (path_id(b, x) == path_id(b, y)))
                        {
                            continue;
                        }
                    },
                    None    : {},
                },
                None : {},
            }
            // Each pair: what the callee does through one argument (`x`,
            // with its summary fields), the other's whole referent (`y`).
            for (usize side = 0; side < 2; side += 1)
            {
                ref<Access, shared> p = if (side == 0) { a } else { c };
                ref<Access, shared> q = if (side == 0) { c } else { a };
                for (usize pi = 0; pi < Vec::len(&p.proj); pi += 1)
                {
                    ref<DerivKey, shared> x = &p.proj[pi];
                    ref<Vec<String>, shared> xf = &p.fields[pi];
                    for (usize qi = 0; qi < Vec::len(&q.whole); qi += 1)
                    {
                        ref<DerivKey, shared> y = &q.whole[qi];
                        if (x.root != y.root || permitted(x.mode, y.mode))
                        {
                            continue;
                        }
                        bool unsure = unsure_covers(
                            &a.unsure,
                            x,
                        ) || unsure_covers(&c.unsure, x) || unsure_covers(&a.unsure, y) || unsure_covers(&c.unsure, y);
                        // A closure argument's captures meeting another
                        // argument: refuted when certain; otherwise the
                        // run's, at the access (no point check names a
                        // capture).
                        bool p_closure = is_closure(&args[p.idx]);
                        bool q_closure = is_closure(&args[q.idx]);
                        if (p_closure || q_closure)
                        {
                            Ov ov = overlap3(&x.path, &y.path);
                            if (ov == Ov::OvYes && !unsure)
                            {
                                usize ci = if (p_closure) { p.idx } else { q.idx };
                                usize oi = if (p_closure) { q.idx } else { p.idx };
                                // Bug 348: a closure captures a variable
                                // whole; the part it reads, copied to a local
                                // first, is what it can capture instead.
                                StringView root0 = shown_name(&x.root);
                                StringView root = Option::unwrap_or(StringView::strip_prefix(root0, "*"), root0);
                                Option<String> read = match (&strip_parens_tc(&args[ci]).kind)
                                {
                                    ExprKind::EClosure(cb) : field_read_in_block(root, &Box::get(cb).body),
                                    _                      : None,
                                };
                                String msg = match (read)
                                {
                                    Some(fname) : with_repair(
                                        &sprintf(
                                            "the closure given as argument %v captures `%s` whole, and argument %v of `%s` reaches `%s` through it, and one of them writes it: a closure captures whole variables, not their fields",
                                            ci + 1,
                                            root,
                                            oi + 1,
                                            shown_key,
                                            &shown_place(&x.root, &x.path),
                                        ),
                                        &sprintf(
                                            "copy what the closure reads into a local first, `auto %s = %s.%s;`, and capture that (`[%s]`)",
                                            &fname,
                                            root,
                                            &fname,
                                            &fname,
                                        ),
                                    ),
                                    None : sprintf(
                                        "the closure given as argument %v captures `%s`, which argument %v of `%s` also reaches, and one of them writes it; let the closure take it as a parameter instead of capturing it, or copy what it reads into a local first and capture that",
                                        ci + 1,
                                        &shown_place(&x.root, &x.path),
                                        oi + 1,
                                        shown_key,
                                    ),
                                };
                                return refute(b, &named_diag("diag.aliasing-conflict", &msg));
                            }
                            if (ov != Ov::OvNo)
                            {
                                rep_left(
                                    b,
                                    sprintf(
                                        "line %v: a closure argument captures what another argument may reach",
                                        b.current_line,
                                    ),
                                );
                            }
                            continue;
                        }
                        // `[Swap-Places]`: the two places of a `swap`, of
                        // one type, are one place (no conflict) or disjoint;
                        // the values deciding which needs no check.
                        match (overlap3(&x.path, &y.path))
                        {
                            Ov::OvNo    : {},
                            Ov::OvMaybe :
                            {
                                if (!swap)
                                {
                                    Vec::push(
                                        &mut point_checks,
                                        sprintf(
                                            "P\t%v\t%s\targuments %v and %v",
                                            b.current_line,
                                            shown_name(&x.root),
                                            a.idx + 1,
                                            c.idx + 1,
                                        ),
                                    );
                                    Vec::push(
                                        &mut pcs,
                                        point_check(p.idx, xf, x.mode, PointOther::Arg(q.idx), y.mode, shown_key),
                                    );
                                }
                            },
                            Ov::OvYes   :
                            {
                                if (swap && unsure)
                                {
                                    continue;
                                }
                                if (unsure)
                                {
                                    Vec::push(
                                        &mut point_checks,
                                        sprintf(
                                            "P\t%v\t%s\targuments %v and %v (on some paths)",
                                            b.current_line,
                                            shown_name(&x.root),
                                            a.idx + 1,
                                            c.idx + 1,
                                        ),
                                    );
                                    Vec::push(
                                        &mut pcs,
                                        point_check(p.idx, xf, x.mode, PointOther::Arg(q.idx), y.mode, shown_key),
                                    );
                                }
                                else
                                {
                                    String msg = if (x.mode == Mode::Exclusive)
                                    {
                                        sprintf(
                                            "`%s` writes `%s` through argument %v, which argument %v also reaches",
                                            shown_key,
                                            &shown_place(&x.root, &x.path),
                                            p.idx + 1,
                                            q.idx + 1,
                                        )
                                    }
                                    else
                                    {
                                        sprintf(
                                            "`%s` reads `%s` through argument %v, which argument %v reaches exclusively",
                                            shown_key,
                                            &shown_place(&x.root, &x.path),
                                            p.idx + 1,
                                            q.idx + 1,
                                        )
                                    };
                                    return refute(b, &named_diag("diag.aliasing-conflict", &msg));
                                }
                            },
                        }
                    }
                }
            }
        }
    }
    if (rep_in_trusted(b))
    {
        return Ok(());
    }
    if (Vec::len(&pcs) > 0)
    {
        b.point_check_fn = true;
    }
    // In the order they were found.
    Vec::reverse(&mut pcs);
    while (true)
    {
        match (Vec::pop(&mut pcs))
        {
            Some(pc) : record_point_check(b, String::clone(&site), pc),
            None     : break,
        }
    }
    if (Vec::len(&point_checks) > 0)
    {
        Vec::sort(&mut point_checks);
        Vec<String> deduped = Vec::new();
        for (usize i = 0; i < Vec::len(&point_checks); i += 1)
        {
            if (i == 0 || !(point_checks[i] == (point_checks[i - 1])))
            {
                Vec::push(&mut deduped, String::clone(&point_checks[i]));
            }
        }
        usize line = b.current_line;
        b.rep.point_checks += Vec::len(&deduped);
        Vec::append(&mut b.rep.events, deduped);
        rep_left(b, sprintf("line %v: a call checked when it is made (D-0283)", line));
    }
    Ok(())
}

// D-0289: the call that takes a handle out of a `Vec` of them in `e`
// (`Vec::pop(&mut hs)`, through `Option::unwrap`) has its result bound
// here, where the handle's facts follow it.
fn mark_taken(ref<Body, exclusive> b, ref<Items, shared> it, ref<Expr, shared> e)
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::ECall(cb) :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            if (is_std_fn_in(it, &c.callee, &["std::Option::unwrap", "std::Option::expect"]))
            {
                if (Vec::len(&c.args) > 0)
                {
                    mark_taken(b, it, &c.args[0]);
                }
            }
            else
            {
                HashSet::insert(&mut b.taken_handles, site_key(c.callee.line, c.callee.col));
            }
        },
        _                   : {},
    }
}

// D-0290: for each argument `&mut a.π` of a call, `a` a holder, what the
// call does to `a`: whether it only adds (`Vec::push`, `insert`) or keeps
// (`len`, `sort`) what `a` holds, and what the other arguments that may
// hold references hold (`None` inside: not known).
struct HolderOp
{
    String n;
    bool adds;
    bool keeps;
    Vec<Option<Vec<DerivFact>>> kept;
}

// Bug 014: a callee as its part-store summary sees it: a function with a
// body, by name (`Facts::part_stores`); an intrinsic, which moves values and
// forms no reference into a part of one; anything else (a `fn` value, a
// closure, a C function), which may store any.
enum PartCallee
{
    Named(String),
    Moves,
    Unknown,
}

fn part_callee_kind(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> callee) : PartCallee
{
    match (one_seg(callee))
    {
        Some(n) :
        {
            if (is_local(b, n))
            {
                return PartCallee::Unknown;
            }
        },
        None    : {},
    }
    match (resolve_fn_path(it, callee))
    {
        Some(k) : return PartCallee::Named(k),
        None    : {},
    }
    match (one_seg(callee))
    {
        Some(n) : if (is_intrinsic_any(n)) { PartCallee::Moves } else { PartCallee::Unknown },
        None    : PartCallee::Unknown,
    }
}

// Whether `e` is a parameter of the body named as it is.
fn bare_param(ref<Body, shared> b, ref<Expr, shared> e) : bool
{
    match (one_seg(strip_parens_tc(e)))
    {
        Some(n) : HashSet::contains(&b.params, n),
        None    : false,
    }
}

// Bug 014: how `kept_from` judged a reference argument: whether what it
// gives counts references into parts of its referent (`parts`), and whether,
// given exclusively, it was judged by its own type where its parts would
// give more (`narrowed`).
struct KeptHow
{
    bool parts;
    bool narrowed;
}

fn arg_holds(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> a) : bool
{
    match (&strip_parens_tc(a).kind)
    {
        ExprKind::EBorrow(_)  : true,
        ExprKind::ESliceOf(_) : true,
        ExprKind::EInt(_)     : false,
        ExprKind::EBool(_)    : false,
        ExprKind::EFloat(_)   : false,
        ExprKind::EStr(_)     : false,
        ExprKind::EBinary(_)  : false,
        ExprKind::EUnary(_)   : false,
        // Report 174: an `if` holds what one of its branches' values may.
        ExprKind::EBlock(bk) : match (&bk.tail)
        {
            Some(t) : arg_holds(b, it, Box::get(t)),
            None    : false,
        },
        ExprKind::EIf(ib)     :
        {
            ref<IfExpr, shared> x = Box::get(ib);
            match (&x.then_.tail)
            {
                Some(t) : arg_holds(b, it, Box::get(t)) || match (&x.else_)
                {
                    Some(e2) : arg_holds(b, it, e2),
                    None     : false,
                },
                None : true,
            }
        },
        _ : match (shape_or_place(b, it, a))
        {
            Some(t) : is_borrow_ty(&t) || may_hold_ref(it, &t, 0),
            None    : true,
        },
    }
}

// D-0290: `holder_call_facts`. An exclusive reference to data that keeps
// references and is not a holder of this frame, given beside such an
// argument, may come to keep it: an escape, the run's.
fn holder_call_facts(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> callee,
    ref<Vec<Expr>, shared> args,
) : Vec<HolderOp>
{
    Vec<HolderOp> out = Vec::new();
    if (b.flow.unreachable)
    {
        return out;
    }
    bool report = b.report;
    // Only a call given an exclusive reference can store into data.
    bool any = false;
    for (usize i = 0; i < Vec::len(args) && !any; i += 1)
    {
        any = match (&strip_parens_tc(&args[i]).kind)
        {
            ExprKind::EBorrow(x)  : Box::get(x).mode == Mode::Exclusive,
            ExprKind::ESliceOf(x) : Box::get(x).mode == Mode::Exclusive,
            ExprKind::EPath(_)    : true,
            ExprKind::EField(_)   : true,
            ExprKind::ECall(_)    : true,
            _                     : false,
        };
    }
    if (!any)
    {
        return out;
    }
    // Which `std` operation it is, found once and only for a holder.
    Option<bool> adds_memo = None;
    bool keeps_memo = false;
    // What the callee is, for its part-store summary (bug 014), found once
    // and only for an argument that may hold references.
    Option<PartCallee> callee_kind = None;
    for (usize j = 0; j < Vec::len(args); j += 1)
    {
        ref<Expr, shared> a = strip_parens_tc(&args[j]);
        Option<ref<Expr, shared>> inner = None;
        bool excl = match (&a.kind)
        {
            ExprKind::EBorrow(x)  :
            {
                inner = Some(&Box::get(x).e);
                Box::get(x).mode == Mode::Exclusive
            },
            ExprKind::ESliceOf(x) :
            {
                inner = Some(&Box::get(x).base);
                Box::get(x).mode == Mode::Exclusive
            },
            _ : match (shape_or_place(b, it, a))
            {
                Some(Type::TRef(x))    : Box::get(&x).mode == Mode::Exclusive,
                Some(Type::TSlice(x))  : Box::get(&x).mode == Mode::Exclusive,
                Some(Type::TRawptr(_)) : true,
                _                      : false,
            },
        };
        if (!excl)
        {
            continue;
        }
        // The data the reference reaches, and the arguments whose
        // references it can keep.
        Option<Type> referent = match (inner)
        {
            Some(x) : shape_or_place(b, it, x),
            None : match (shape_or_place(b, it, a))
            {
                Some(Type::TRef(x))    : Some(ModedTy::take_inner(x)),
                Some(Type::TSlice(x))  : Some(ModedTy::take_inner(x)),
                Some(Type::TRawptr(x)) : Some(Box::into_inner(x)),
                _                      : None,
            },
        };
        Option<String> target = match (inner)
        {
            Some(x) : match (store_target(b, x))
            {
                Some(st) :
                {
                    StoreTarget { name, through } = st;
                    if (!through && is_holder(b, it, &name)) { Some(name) } else { None }
                },
                None     : None,
            },
            None : None,
        };
        // Data that keeps no references can keep nothing given beside it.
        bool stores = match (&referent)
        {
            Some(t) : type_kinds(b, it, t).stores,
            None    : true,
        };
        if (Option::is_none(&target) && !stores)
        {
            continue;
        }
        // What each other argument gives that the data can keep.
        Vec<Option<Vec<DerivFact>>> kept = Vec::new();
        // Bug 014: for each, whether it gives references into its parts.
        Vec<bool> kept_parts = Vec::new();
        for (usize i = 0; i < Vec::len(args); i += 1)
        {
            if (i == j || !arg_holds(b, it, &args[i]))
            {
                continue;
            }
            Option<ref<Type, shared>> rt = match (&referent)
            {
                Some(t) : Some(t),
                None    : None,
            };
            // An argument given exclusively gives references into its parts
            // when the callee's summary says it may store one where argument
            // `j` reaches; a callee not known (a `fn` value, a closure, a C
            // function) may.
            if (Option::is_none(&callee_kind))
            {
                callee_kind = Some(part_callee_kind(b, it, callee));
            }
            bool excl_parts = match (&callee_kind)
            {
                Some(PartCallee::Named(g)) : part_store_known(&b.facts, g, j, i),
                Some(PartCallee::Moves)    : false,
                _                          : true,
            };
            KeptHow how = KeptHow { .parts = false, .narrowed = false };
            match (kept_from(b, it, rt, &args[i], excl_parts, &mut how))
            {
                Some(k) :
                {
                    Vec::push(&mut kept, k);
                    Vec::push(&mut kept_parts, how.parts);
                },
                None    : {},
            }
            // Judged by its own type where its parts would give more: it
            // stands if the callee's summary, once every body is checked,
            // has no such pair (`part_resolve`).
            if (how.narrowed && report && !rep_in_trusted(b))
            {
                match (&callee_kind)
                {
                    Some(PartCallee::Named(g)) :
                    {
                        PartAssume pa = PartAssume {
                            .body = String::clone(&b.rep.func),
                            .func = String::clone(&b.fn_name),
                            .callee = String::clone(g),
                            .t = j,
                            .s = i,
                            .line = b.current_line,
                            .failed = false,
                        };
                        Vec::push(&mut b.facts.part_assumes, pa);
                    },
                    _                          : {},
                }
            }
        }
        match (target)
        {
            Some(n) :
            {
                bool adds = match (adds_memo)
                {
                    Some(v) : v,
                    None    :
                    {
                        bool v = is_std_fn(it, callee, "std::Vec::push") || is_std_fn(it, callee, "std::Vec::insert");
                        keeps_memo = is_std_fn_in(
                            it,
                            callee,
                            &[
                                "std::Vec::len",
                                "std::Vec::is_empty",
                                "std::Vec::reserve",
                                "std::Vec::capacity",
                                "std::Vec::sort",
                                "std::Vec::sort_by",
                                "std::Vec::reverse",
                                "std::Vec::swap",
                            ],
                        ) || match (one_seg(callee))
                        {
                            Some(cn) : *cn == "$each_len" || *cn == "$each_at" || *cn == "$each_at_mut",
                            None     : false,
                        };
                        adds_memo = Some(v);
                        v
                    },
                };
                Vec::push(&mut out, HolderOp { .n = n, .adds = adds, .keeps = keeps_memo, .kept = kept });
            },
            None    :
            {
                if (Vec::len(&kept) == 0)
                {
                    continue;
                }
                Option<String> own = match (inner)
                {
                    Some(x) : match (store_target(b, x))
                    {
                        Some(st) : Some(sprintf("**%s", &st.name)),
                        None     : None,
                    },
                    None : match (one_seg(a))
                    {
                        Some(n) : Some(sprintf("**%s", n)),
                        None    : None,
                    },
                };
                // Through a parameter, the caller sees what is given.
                bool param = match (&own)
                {
                    Some(o) : HashSet::contains(&b.params, &String::copy(strip_stars(o))),
                    None    : false,
                };
                String own_param = match (&own)
                {
                    Some(o) : String::copy(strip_stars(o)),
                    None    : String::new(),
                };
                bool inside = true;
                for (usize k = 0; k < Vec::len(&kept) && inside; k += 1)
                {
                    bool ok = param && caller_sees(b, &kept[k]);
                    // What the caller adds for it: the summary's pairs (bug
                    // 014), when the argument gives references into its parts.
                    if (ok && kept_parts[k])
                    {
                        note_part_stores(b, &own_param, &kept[k]);
                    }
                    if (!ok)
                    {
                        ok = match (&kept[k])
                        {
                            None    : true,
                            Some(v) :
                            {
                                bool all = Vec::len(v) > 0;
                                for (usize x = 0; x < Vec::len(v) && all; x += 1)
                                {
                                    all = match (&own)
                                    {
                                        Some(o) : (v[x].key.root == *o),
                                        None    : false,
                                    };
                                }
                                all
                            },
                        };
                    }
                    inside = ok;
                }
                if (!inside && report)
                {
                    rep_left(
                        b,
                        sprintf(
                            "line %v: a reference may be stored where this frame does not hold it (D-0290)",
                            b.current_line,
                        ),
                    );
                    // Its callers, which see no pair for it, are left to the
                    // run too (bug 014).
                    HashSet::insert(&mut b.facts.part_stores_all, String::clone(&b.fn_name));
                }
            },
        }
    }
    out
}

// D-0290: what data of type `referent` can come to keep of an argument
// `b2` given beside it: the reference `b2` is, when the data keeps that
// kind; what the references kept where `b2` reaches reach, when it keeps
// those (`swap(v, &mut out)` moves `out`'s contents, not `&mut out`); a
// value's own facts. `None`: nothing; `Some(None)`: static data;
// `Some(Some(v))`, `v` empty when not known.
fn kept_from(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    Option<ref<Type, shared>> referent,
    ref<Expr, shared> b2,
    bool excl_parts,
    ref<KeptHow, exclusive> how,
) : Option<Option<Vec<DerivFact>>>
{
    Option<Type> given = match (&strip_parens_tc(b2).kind)
    {
        ExprKind::EBorrow(x) : match (shape_or_place(b, it, &Box::get(x).e))
        {
            Some(t) : Some(ref_of(t, Box::get(x).mode)),
            None    : None,
        },
        _ : shape_or_place(b, it, b2),
    };
    HashSet<String> tl = HashSet::new();
    match (referent)
    {
        Some(t) : ref_leaves(it, t, &mut tl, &mut new_name_set()),
        None    : {},
    }
    bool top = true;
    bool deep = true;
    // Bug 014: a reference to a place that itself keeps a reference, where the
    // callee can form a reference into a part of that reference's referent.
    bool through = false;
    if (Option::is_some(&referent))
    {
        match (&given)
        {
            // A reference gives itself, and every reference the callee can
            // form into a part of its referent (`*slot = &v[0]` given `&v`, a
            // view of a `String` given `&s`; bug 014). Given exclusively, the
            // parts count only where the callee's summary says it may store
            // one there (`excl_parts`, spec/14 §6): the parts of `&mut out`
            // beside a struct that keeps a slice are what most calls pass
            // (`inflate_codes(&mut r, out, …)`), and few callees store one.
            Some(Type::TRef(x))   :
            {
                ref<Type, shared> inner = &Box::get(x).inner;
                top = kept_top(it, inner, false, Box::get(x).mode, excl_parts, &tl, how);
                through = through_parts_meet(it, inner, &tl);
                deep = leaves_meet(it, inner, &tl) || through;
            },
            Some(Type::TSlice(x)) :
            {
                ref<Type, shared> inner = &Box::get(x).inner;
                top = kept_top(it, inner, true, Box::get(x).mode, excl_parts, &tl, how);
                through = through_parts_meet(it, inner, &tl);
                deep = leaves_meet(it, inner, &tl) || through;
            },
            Some(t)               :
            {
                // A value that keeps a reference can form a reference into a
                // part of its referent (`&(*s.v)[0]`): the facts it has are
                // that reference's (bug 014).
                top = leaves_meet(it, t, &tl) || through_parts_meet(it, t, &tl);
                deep = false;
            },
            None                  : {},
        }
    }
    // Anything but a parameter given whole may itself be (or keep) a
    // reference into a part of what the facts name (`&mut v[0]`, a view).
    if (top && !bare_param(b, b2))
    {
        how.parts = true;
    }
    if (!top && !deep)
    {
        return None;
    }
    Vec<DerivFact> v = match (inherited_facts(b, it, b2, 0))
    {
        Some(v) : v,
        None    : return Some(None),
    };
    Vec<DerivFact> out = if (top) { clone(&v) } else { Vec::new() };
    if (through)
    {
        // What the borrowed place keeps is what the callee's reference into
        // a part of its referent refers to.
        match (&strip_parens_tc(b2).kind)
        {
            ExprKind::EBorrow(x) : match (inherited_facts(b, it, &Box::get(x).e, 0))
            {
                Some(w) :
                {
                    for (usize k = 0; k < Vec::len(&w); k += 1)
                    {
                        Vec::push(&mut out, clone(&w[k]));
                    }
                    how.parts = true;
                },
                None    : {},
            },
            _ : {},
        }
    }
    if (deep)
    {
        for (usize i = 0; i < Vec::len(&v); i += 1)
        {
            match (reach_of_root(b, it, &v[i].key.root))
            {
                Some(w) :
                {
                    for (usize k = 0; k < Vec::len(&w); k += 1)
                    {
                        DerivFact d = clone(&w[k]);
                        if (v[i].v != Tri::T)
                        {
                            d.v = Tri::U;
                        }
                        Vec::push(&mut out, d);
                    }
                },
                None    :
                {
                    if (!top && data_type_root(b, it, &v[i].key.root))
                    {
                        return Some(Some(Vec::new()));
                    }
                },
            }
        }
    }
    if (Vec::len(&out) == 0 && Vec::len(&v) > 0 && !top)
    {
        return None;
    }
    Some(Some(out))
}

// Bug 014: whether a reference (a slice when `is_slice`) of `mode` to an
// `inner` gives what data keeping the leaves `tl` can keep: itself, and,
// given shared or where `excl_parts`, a reference into a part of `*inner`.
fn kept_top(
    ref<Items, shared> it,
    ref<Type, shared> inner,
    bool is_slice,
    Mode mode,
    bool excl_parts,
    ref<HashSet<String>, shared> tl,
    ref<KeptHow, exclusive> how,
) : bool
{
    if (mode == Mode::Shared || excl_parts)
    {
        bool top = part_leaves_meet(it, inner, tl);
        how.parts = top;
        return top;
    }
    bool own = HashSet::contains(tl, &ref_leaf(is_slice, inner));
    how.narrowed = !own && part_leaves_meet(it, inner, tl);
    own
}

// Whether a reference into a part of a value of `t` (the value itself, a
// field, an element, a payload, a slice of its elements, a view of its
// text) is one of the leaves `tl`: what a callee given a reference to a
// `t` can store where it may keep such a leaf. A reference kept in `t` is
// `leaves_meet`'s.
fn part_leaves_meet(ref<Items, shared> it, ref<Type, shared> t, ref<HashSet<String>, shared> tl) : bool
{
    HashSet<String> l = HashSet::new();
    part_leaves(it, t, &mut l, &mut new_name_set());
    for (usize i = 0; i < HashSet::len(&l); i += 1)
    {
        if (HashSet::contains(tl, HashSet::key_at(&l, i)))
        {
            return true;
        }
    }
    false
}

fn part_leaves(
    ref<Items, shared> it,
    ref<Type, shared> t,
    ref<HashSet<String>, exclusive> out,
    ref<HashSet<String>, exclusive> seen,
)
{
    if (!HashSet::insert(seen, type_code(t)))
    {
        return;
    }
    HashSet::insert(out, ref_leaf(false, t));
    HashSet::insert(out, ref_leaf(true, t));
    match (t)
    {
        Type::TArray(b) : part_leaves(it, &Box::get(b).inner, out, seen),
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            // A `String` owns its text, so a view of it is a part; a
            // `StringView` does not, and what it refers to is `leaves_meet`'s.
            if (n.name == "std::String")
            {
                HashSet::insert(out, ref_leaf(true, &Type::TInt(IntTy::U8)));
                HashSet::insert(out, ref_leaf(false, &Type::TInt(IntTy::U8)));
                return;
            }
            if (n.name == "std::StringView")
            {
                return;
            }
            // A container's elements (`Vec<T>`'s, behind a raw pointer) and
            // every other type argument's parts.
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                part_leaves(it, &n.args[i], out, seen);
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        part_leaves(it, &apply_subst(&s.fields[i].ty, &subst), out, seen);
                    }
                    return;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) : part_leaves(it, &apply_subst(p, &subst), out, seen),
                            None    : {},
                        }
                    }
                },
                None    : {},
            }
        },
        _               : {},
    }
}

// Bug 014: the references into parts of what the references kept in a value
// of `t` refer to (a callee given `ref<ref<Vec<String>>>` forms `&(**q)[0]`,
// a `ref<String>`), as `part_leaves` collects them.
fn through_part_leaves(
    ref<Items, shared> it,
    ref<Type, shared> t,
    ref<HashSet<String>, exclusive> out,
    ref<HashSet<String>, exclusive> seen,
)
{
    if (!HashSet::insert(seen, type_code(t)))
    {
        return;
    }
    match (t)
    {
        Type::TRef(b)   :
        {
            part_leaves(it, &Box::get(b).inner, out, &mut new_name_set());
            through_part_leaves(it, &Box::get(b).inner, out, seen);
        },
        Type::TSlice(b) :
        {
            part_leaves(it, &Box::get(b).inner, out, &mut new_name_set());
            through_part_leaves(it, &Box::get(b).inner, out, seen);
        },
        Type::TArray(b) : through_part_leaves(it, &Box::get(b).inner, out, seen),
        Type::TNamed(b) :
        {
            ref<NamedTy, shared> n = Box::get(b);
            for (usize i = 0; i < Vec::len(&n.args); i += 1)
            {
                through_part_leaves(it, &n.args[i], out, seen);
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        through_part_leaves(it, &apply_subst(&s.fields[i].ty, &subst), out, seen);
                    }
                    return;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(p) : through_part_leaves(it, &apply_subst(p, &subst), out, seen),
                            None    : {},
                        }
                    }
                },
                None    : {},
            }
        },
        _               : {},
    }
}

fn through_parts_meet(ref<Items, shared> it, ref<Type, shared> t, ref<HashSet<String>, shared> tl) : bool
{
    HashSet<String> l = HashSet::new();
    through_part_leaves(it, t, &mut l, &mut new_name_set());
    for (usize i = 0; i < HashSet::len(&l); i += 1)
    {
        if (HashSet::contains(tl, HashSet::key_at(&l, i)))
        {
            return true;
        }
    }
    false
}

// Whether a reference kept by a value of `t` is one of the leaves `tl`.
fn leaves_meet(ref<Items, shared> it, ref<Type, shared> t, ref<HashSet<String>, shared> tl) : bool
{
    HashSet<String> l = HashSet::new();
    ref_leaves(it, t, &mut l, &mut new_name_set());
    for (usize i = 0; i < HashSet::len(&l); i += 1)
    {
        if (HashSet::contains(tl, HashSet::key_at(&l, i)))
        {
            return true;
        }
    }
    false
}

// Whether the root `root` is a binding whose storage keeps references.
fn data_type_root(ref<Body, shared> b, ref<Items, shared> it, ref<String, shared> root) : bool
{
    String name = String::copy(strip_stars(root));
    match (HashMap::get(&b.gamma, &name))
    {
        Some(Type::TRef(x))   : stores_refs(it, &Box::get(x).inner),
        Some(Type::TSlice(x)) : stores_refs(it, &Box::get(x).inner),
        Some(t)               : stores_refs(it, t),
        None                  : true,
    }
}

// D-0290: `holder_call_facts` applied after the call.
fn holder_call(ref<Body, exclusive> b, Vec<HolderOp> ops)
{
    for (usize o = 0; o < Vec::len(&ops); o += 1)
    {
        HolderOp { n, adds, keeps, kept } = clone(&ops[o]);
        if (keeps)
        {
            continue;
        }
        if (!adds)
        {
            match (HashMap::get_mut(&mut b.flow.deriv, &n))
            {
                Some(m) :
                {
                    for (usize k = 0; k < HashMap::len(m); k += 1)
                    {
                        String code = String::clone(HashMap::key_at(m, k));
                        ref<DerivFact, exclusive> d = Option::expect(HashMap::get_mut(m, &code), "a fact");
                        if (d.v == Tri::T)
                        {
                            d.v = Tri::U;
                        }
                    }
                },
                None    : {},
            }
        }
        for (usize i = 0; i < Vec::len(&kept); i += 1)
        {
            match (&kept[i])
            {
                None    : {},
                Some(v) :
                {
                    if (facts_known(v))
                    {
                        Vec<DerivFact> w = through_refs(b, clone(v));
                        if (!adds)
                        {
                            w = all_unsure(w);
                        }
                        add_deriv_tri(b, &n, w);
                    }
                    else if (b.report)
                    {
                        rep_left(
                            b,
                            sprintf(
                                "line %v: what is stored into `%s` holds references not known before the run",
                                b.current_line,
                                &n,
                            ),
                        );
                    }
                },
            }
        }
    }
}

// D-0301 `[Match-Through-Box]`: the parser wrote `V(*x)`'s arm as
// `V($boxN)` beginning `auto x = Box::get($boxN);`. By the hidden binder's
// type that is `Box::get` (a shared reference to the box), `Box::get_mut`
// (an exclusive one) or `Box::into_inner` (the box by value): the callee
// to check the call as, rewritten to it; `None` when it is `Box::get`, or
// not such a call.
fn box_through_callee(ref<Body, exclusive> b, ref<Expr, shared> callee, ref<Vec<Expr>, shared> args) : Result<Option<Expr>, String>
{
    if (Vec::len(args) != 1)
    {
        return Ok(None);
    }
    ref<Vec<String>, shared> segs = match (path_segs(callee))
    {
        Some(x) : x,
        None    : return Ok(None),
    };
    usize n = Vec::len(segs);
    if (n < 2 || segs[n - 1] != "get" || segs[n - 2] != "Box")
    {
        return Ok(None);
    }
    String an = match (&args[0].kind)
    {
        ExprKind::EPath(pb) :
        {
            if (Vec::len(&Box::get(pb).segs) != 1 || !StringView::starts_with(&Box::get(pb).segs[0], "$box"))
            {
                return Ok(None);
            }
            String::clone(&Box::get(pb).segs[0])
        },
        _                   : return Ok(None),
    };
    Option<Type> bt = lookup_local(b, &an);
    Option<Type> shown = None;
    str f = "get";
    match (&bt)
    {
        Some(Type::TRef(rb)) :
        {
            ref<ModedTy, shared> m = Box::get(rb);
            if (is_box_ty(&m.inner))
            {
                if (m.mode == Mode::Exclusive)
                {
                    f = "get_mut";
                }
            }
            else
            {
                shown = Some(clone(&m.inner));
            }
        },
        Some(t)              :
        {
            if (is_box_ty(t))
            {
                f = "into_inner";
            }
            else
            {
                shown = Some(clone(t));
            }
        },
        None                 : {},
    }
    match (&shown)
    {
        Some(t) :
        {
            return Err(mismatch(sprintf(
                "`*x` binds through a `Box`, and this payload is `%s`; bind it as `x` (D-0301)",
                &type_display(t),
            )));
        },
        None    : {},
    }
    if (f == "get")
    {
        return Ok(None);
    }
    if (b.facts.silent)
    {
        return Err(mismatch("a `*x` binder through an exclusive reference or by value, in a body checked after the program was built (D-0301): bind the box as `b` and write `Box::get_mut(b)` or `Box::into_inner(b)`"));
    }
    note_rewrite(b, callee, if (f == "get_mut") { Rewrite::BoxGetMut } else { Rewrite::BoxIntoInner });
    Vec<String> real = Vec::clone(segs);
    real[n - 1] = String::copy(f);
    Vec<Type> targs = match (&callee.kind)
    {
        ExprKind::EPath(pb) : clone(&Box::get(pb).targs),
        _                   : Vec::new(),
    };
    Ok(Some(mk(ExprKind::EPath(Box::new(PathExpr { .segs = real, .targs = targs })), callee.line, callee.col)))
}

// D-0301: the hidden binder of `V(*x)` is `$box<n>_x`, a name no program
// can write; a message names it as the `x` the program wrote.
export fn unhide_binders(StringView m) : String
{
    slice<u8, shared> bs = StringView::as_bytes(m);
    usize n = StringView::len(m);
    String out = String::new();
    usize start = 0;
    usize i = 0;
    while (i + 4 <= n)
    {
        if (bs[i] == b'$' && bs[i + 1] == b'b' && bs[i + 2] == b'o' && bs[i + 3] == b'x')
        {
            usize j = i + 4;
            while (j < n && ascii_is_digit(bs[j]))
            {
                j += 1;
            }
            if (j > i + 4 && j < n && bs[j] == b'_')
            {
                String::append(&mut out, &m[start..i]);
                i = j + 1;
                start = i;
                continue;
            }
        }
        i += 1;
    }
    String::append(&mut out, &m[start..n]);
    out
}

fn is_box_ty(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(nb) : Box::get(nb).name == "std::Box" && Vec::len(&Box::get(nb).args) == 1,
        _                : false,
    }
}

// D-0302: whether `e`, of type `got`, stands where the declared type
// `want` is `StringView` and is admitted there by `[Ref-String-View]` or
// `[Str-Value-View]`: then the rewrite to the view form is recorded and
// the value is a `StringView`. `want` is the type as declared, so a type
// parameter fixed as `StringView` admits nothing (as for literals, D-0134).
// The positions that compare a value's type with a declared one after
// checking it without the expected type: `[Coerce-Text]` there too.
fn view_of_text(ref<Body, exclusive> b, ref<Items, shared> it, ref<Type, shared> want, ref<Type, shared> got, ref<Expr, shared> e) : bool
{
    coerce_text(b, it, want, got, e)
}

fn check_call(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> callee,
    ref<Vec<Expr>, shared> args,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    match (box_through_callee(b, callee, args)?)
    {
        Some(real) : return check_call(b, it, &real, args, expected),
        None       : {},
    }
    tier_call_rule(b, it, callee, args)?;
    Option<String> callee_key = resolve_fn_path(it, callee);
    bool joining = match (path_segs(callee))
    {
        Some(segs) :
        {
            StringView last = &segs[Vec::len(segs) - 1];
            !(Vec::len(segs) == 1 && is_local(
                b,
                &segs[0],
            )) && (last == "join" || last == "drop" || last == "try_join")
        },
        None       : false,
    };
    if (joining && Vec::len(args) > 0)
    {
        mark_taken(b, it, &args[0]);
    }
    // D-0289: `Vec::push(&mut hs, spawn(…))` binds the spawn as a `let`
    // does: `hs`, a local of this frame, holds what the thread was lent,
    // and so does a handle pushed there.
    Option<HandleHolder> pushed = None;
    bool handing = false;
    if (Vec::len(args) == 2 && key_in(&callee_key, &["std::Vec::push"]))
    {
        match (&strip_parens_tc(&args[0]).kind)
        {
            ExprKind::EBorrow(bb) :
            {
                if (Box::get(bb).mode == Mode::Exclusive)
                {
                    match (one_seg(strip_parens_tc(&Box::get(bb).e)))
                    {
                        Some(n) :
                        {
                            bool handles = is_local(b, n) && match (HashMap::get(&b.gamma, n))
                            {
                                Some(t) : holds_handle(t),
                                None    : false,
                            };
                            if (handles)
                            {
                                if (is_spawn_call(&args[1]))
                                {
                                    match (&strip_parens_tc(&args[1]).kind)
                                    {
                                        ExprKind::ECall(cb) :
                                        {
                                            HashSet::insert(
                                                &mut b.bound_spawns,
                                                site_key(Box::get(cb).callee.line, Box::get(cb).callee.col),
                                            );
                                        },
                                        _                   : {},
                                    }
                                    String hn = String::clone(n);
                                    Vec<DerivFact> fs = spawn_facts_tri_of(b, it, &args[1]);
                                    pushed = Some(HandleHolder { .name = hn, .facts = fs });
                                }
                                else
                                {
                                    match (handle_holder_of(b, it, &args[1]))
                                    {
                                        Some(hh) :
                                        {
                                            HandleHolder { facts, .. } = hh;
                                            mark_taken(b, it, &args[1]);
                                            handing = true;
                                            pushed = Some(HandleHolder { .name = String::clone(n), .facts = facts });
                                        },
                                        None     : {},
                                    }
                                }
                            }
                        },
                        None    : {},
                    }
                }
            },
            _                     : {},
        }
    }
    // The `Vec` operations that keep a lending handle in this frame.
    String callee_site = site_key(callee.line, callee.col);
    bool keeps = key_in(&callee_key, &[
            "std::Vec::push",
            "std::Vec::len",
            "std::Vec::is_empty",
            "std::Vec::clear",
            "std::Vec::truncate",
            "std::Vec::reserve",
    ],
    )
        || (key_in(&callee_key, &[
            "std::Vec::pop",
            "std::Vec::remove",
            "std::Vec::swap_remove",
            "std::Drain::take",
        ],
        ) && HashSet::contains(&b.taken_handles, &callee_site))
        || match (one_seg(callee))
        {
            Some(n) : *n == "$each_take" || *n == "$each_take_key" || *n == "$each_len",
            None    : false,
        };
    if (keeps && Vec::len(args) > 0)
    {
        match (&strip_parens_tc(&args[0]).kind)
        {
            ExprKind::EBorrow(bb) :
            {
                if (Box::get(bb).mode == Mode::Exclusive)
                {
                    b.handle_borrow_ok = true;
                }
            },
            _                     : {},
        }
    }
    bool spawn_callee = match (one_seg(callee))
    {
        Some(n) : *n == "spawn" && !is_local(b, n),
        None    : false,
    };
    if (spawn_callee)
    {
        tier_spawn_rule(b, it, callee, args);
    }
    if (HashMap::contains(&b.tail_spawns, &callee_site))
    {
        Expr whole = mk(
            ExprKind::ECall(Box::new(CallExpr { .callee = clone(callee), .args = clone(args) })),
            callee.line,
            callee.col,
        );
        Vec<DerivFact> facts = spawn_facts_tri_of(b, it, &whole);
        usize depth = if (Vec::len(&b.spawn_let_depth) > 0) { b.spawn_let_depth[Vec::len(&b.spawn_let_depth) - 1] } else { 0 };
        HashSet<String> inner = HashSet::new();
        for (usize si = depth; si < Vec::len(&b.scopes); si += 1)
        {
            for (usize k = 0; k < Vec::len(&b.scopes[si]); k += 1)
            {
                HashSet::insert(&mut inner, String::clone(&b.scopes[si][k].name));
            }
        }
        bool seen = true;
        for (usize i = 0; i < Vec::len(&facts) && seen; i += 1)
        {
            ref<String, shared> root = &facts[i].key.root;
            seen = !StringView::starts_with(
                root,
                "<",
            ) && !HashSet::contains(&inner, &String::copy(strip_stars(root)));
        }
        HashMap::insert(&mut b.tail_spawns, String::clone(&callee_site), if (seen) { Some(facts) } else { None });
    }
    bool saved_joining = replace(&mut b.joining, joining);
    bool handing2 = handing || b.handing;
    bool saved_handing = replace(&mut b.handing, handing2);
    // D-0290: what a call may store into a holder, found before the
    // arguments are moved.
    Vec<HolderOp> holder_ops = holder_call_facts(b, it, callee, args);
    Result<Option<Type>, String> r = check_call_in(b, it, callee, args, expected);
    b.joining = saved_joining;
    b.handing = saved_handing;
    b.handle_borrow_ok = false;
    if (Result::is_ok(&r))
    {
        holder_call(b, holder_ops);
        match (pushed)
        {
            Some(hh) :
            {
                HandleHolder { name, facts } = hh;
                add_deriv_tri(b, &name, facts);
            },
            None     : {},
        }
    }
    r
}

fn check_call_in(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> callee,
    ref<Vec<Expr>, shared> args,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    closure_into_outer_container(b, it, callee, args)?;
    // Enum variant construction, `Vi(e)`.
    match (&callee.kind)
    {
        ExprKind::EPath(pb) :
        {
            if (Vec::len(args) == 1)
            {
                match (check_variant_call(b, it, &Box::get(pb).segs, &Box::get(pb).targs, args, expected, callee.line))
                {
                    Some(r) : return r,
                    None    : {},
                }
            }
            else
            {
                // `[T-Enum]`: a variant is called with exactly its one
                // value, and one without a value is written bare (report 107).
                variant_call_arity(b, it, &Box::get(pb).segs, Vec::len(args))?;
            }
        },
        _                   : {},
    }
    // `[Resolve-Unqualified]`: a local binding comes before an item, and an
    // item before an intrinsic of the same name.
    bool local_callee = match (path_segs(callee))
    {
        Some(segs) : Vec::len(segs) == 1 && is_local(b, &segs[0]),
        None       : false,
    };
    match (&callee.kind)
    {
        ExprKind::EPath(pb) :
        {
            if (!local_callee)
            {
                return check_named_call(b, it, callee, &Box::get(pb).segs, &Box::get(pb).targs, args, expected);
            }
        },
        _                   : {},
    }
    // The callee is itself an expression (a closure value, etc.).
    Option<usize> arity = match (&callee.kind)
    {
        ExprKind::EClosure(cb) : Some(Vec::len(&Box::get(cb).params)),
        ExprKind::EPath(pb)    :
        {
            if (Vec::len(&Box::get(pb).segs) == 1)
            {
                match (HashMap::get(&b.closure_arity, &Box::get(pb).segs[0]))
                {
                    Some(n) : Some(*n),
                    None    : None,
                }
            }
            else
            {
                None
            }
        },
        _                      : None,
    };
    match (arity)
    {
        Some(n) :
        {
            if (n != Vec::len(args))
            {
                return Err(mismatch(with_repair(
                    &sprintf(
                        "the closure takes %v argument%s, but %v %s given",
                        n,
                        plural(n),
                        Vec::len(args),
                        is_are(Vec::len(args)),
                    ),
                    "pass one argument for each of its parameters, in their order",
                )));
            }
        },
        None    : {},
    }
    // `[Closure-Call]` of a binding holding a `move` closure that writes a
    // capture: `self` is an exclusive borrow of its place (D-0239, D-0245).
    match (path_segs(callee))
    {
        Some(segs) :
        {
            if (Vec::len(segs) == 1 && HashSet::contains(
                &b.closure_self_writes,
                &segs[0],
            ) && flow_is_tracked(&b.flow, &segs[0]))
            {
                flow_clash_saying(
                    b,
                    it,
                    &segs[0],
                    &Vec::new(),
                    Mode::Exclusive,
                    "diag.aliasing-conflict",
                    Some("so it cannot be called here: the call changes what it captured"),
                )?;
            }
        },
        None       : {},
    }
    Option<Type> ct = check_expr(b, it, callee, &None)?;
    if (is_marker_opt(&ct))
    {
        return Err(unbounded_msg("a call"));
    }
    // Each argument at its parameter's type, as for a named function.
    Vec<Option<Type>> ptys = Vec::new();
    bool fits = match (&ct)
    {
        Some(Type::TFn(fb)) : Vec::len(&Box::get(fb).params) == Vec::len(args),
        _                   : false,
    };
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        if (fits)
        {
            match (&ct)
            {
                Some(Type::TFn(fb)) :
                {
                    ref<Type, shared> p = &Box::get(fb).params[i];
                    Vec::push(&mut ptys, if (has_unresolved_marker(p)) { None } else { Some(clone(p)) });
                },
                _                   : Vec::push(&mut ptys, None),
            }
        }
        else
        {
            Vec::push(&mut ptys, None);
        }
    }
    // `[T-Call]`'s premise for a function value.
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        Option<Type> at = check_store_operand(b, it, &args[i], &ptys[i])?;
        match (&ptys[i])
        {
            Some(pt) : match (&at)
            {
                Some(a) :
                {
                    // An integer literal takes an integer parameter's type, not a
                    // float's (D-0006, CHG-0438).
                    bool literal_fits = match (pt)
                    {
                        Type::TInt(_) : true,
                        _             : false,
                    };
                    if (!type_eq(
                        pt,
                        a,
                    ) && !weakens_to(
                        a,
                        pt,
                    ) && !is_never(a) && !has_unresolved_marker(a) && !(literal_fits && is_bare_int_literal(&args[i])))
                    {
                        return Err(mismatch(sprintf(
                            "argument %v is `%s`, but the function value's parameter is `%s`%s",
                            i + 1,
                            &type_display(a),
                            &type_display(pt),
                            &conversion_hint(pt, a, Some(&args[i])),
                        )));
                    }
                },
                None    : {},
            },
            None : {},
        }
    }
    // `[T-Call]`: the callee is callable, with one argument per parameter.
    match (ct)
    {
        Some(Type::TFn(fb)) :
        {
            FnTy { params, ret } = Box::into_inner(fb);
            if (Vec::len(&params) != Vec::len(args))
            {
                return Err(mismatch(with_repair(
                    &sprintf(
                        "the function value takes %v argument%s, but %v %s given",
                        Vec::len(&params),
                        plural(Vec::len(&params)),
                        Vec::len(args),
                        is_are(Vec::len(args)),
                    ),
                    "pass one argument for each of its parameters, in their order",
                )));
            }
            Ok(Some(ret))
        },
        Some(t)             :
        {
            bool not_callable = match (&t)
            {
                Type::TInt(_)    : true,
                Type::TF32       : true,
                Type::TF64       : true,
                Type::TBool      : true,
                Type::TStr       : true,
                Type::TVoid      : true,
                Type::TArray(_)  : true,
                Type::TRawptr(_) : true,
                Type::THandle(_) : true,
                Type::TMutex(_)  : true,
                Type::TGuard(_)  : true,
                Type::TNamed(nb) : !StringView::starts_with(&Box::get(nb).name, "$"),
                _                : false,
            };
            if (not_callable)
            {
                // Bug 029: say what is called.
                String what = match (path_segs(callee))
                {
                    Some(segs) : if (Vec::len(segs) == 1) { sprintf("`%s`", shown_name(&segs[0])) } else { "this" },
                    None       : "this",
                };
                return Err(mismatch(with_repair(
                    &sprintf(
                        "%s is of type `%s`, not a function: only a function's name or a `fn` value (a closure) is called",
                        &what,
                        &type_display(&t),
                    ),
                    "",
                )));
            }
            Ok(None)
        },
        None                : Ok(None),
    }
}

fn arg_ty(ref<Vec<Option<Type>>, shared> v, usize k) : Option<Type>
{
    if (k < Vec::len(v)) { clone(&v[k]) } else { None }
}

// A call through a path that is not a local: a function, an extern, or an
// intrinsic.
fn check_named_call(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> callee,
    ref<Vec<String>, shared> segs,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    String name = String::join(segs, "::");
    StringView nv = &name;
    match (HashMap::get(&it.fns, &name))
    {
        Some(f) :
        {
            if (is_trusted_std_call(&name) && b.unsafe_depth == 0)
            {
                String msg = sprintf(
                    "`%s` reads through a raw pointer, so it is called inside `unsafe { }`",
                    Option::unwrap_or(StringView::strip_prefix(&name, "std::"), nv),
                );
                return Err(named_diag("diag.trusted-outside-unsafe", &msg));
            }
            if (f.name == "drop" && Option::is_some(&f.assoc_type))
            {
                // spec/07 §1: a destructor is only ever run by `[Destroy]`.
                return Err("diag.direct-destructor-call");
            }
            return check_user_call(b, it, &name, targs, args, expected);
        },
        None    : {},
    }
    match (HashMap::get(&it.externs, &name))
    {
        Some(ext) :
        {
            if (b.unsafe_depth == 0)
            {
                return Err("diag.trusted-outside-unsafe");
            }
            usize fixed = Vec::len(&ext.params);
            if (Vec::len(args) != fixed && !(ext.variadic && Vec::len(args) > fixed))
            {
                return Err(mismatch(sprintf(
                    "`%s` takes %s%v argument%s, and this call passes %v",
                    &name,
                    if (ext.variadic) { "at least " } else { "" },
                    fixed,
                    if (fixed == 1) { "" } else { "s" },
                    Vec::len(args),
                )));
            }
            // `[Extern-Call]`: each argument is of its declared parameter
            // type, as for any call (report 104).
            Vec<Option<Type>> ext_tys = Vec::new();
            for (usize i = 0; i < fixed; i += 1)
            {
                Vec::push(&mut ext_tys, check_expr(b, it, &args[i], &Some(clone(&ext.params[i].ty)))?);
            }
            // Report 228 `[Extern-Call-Variadic]`: an argument after the
            // fixed ones is of the type its own text gives it (a literal's
            // own: `i32`, `f64`), an FfiType other than `void`, as a
            // parameter's.
            for (usize i = fixed; i < Vec::len(args); i += 1)
            {
                Option<Type> at = check_expr(b, it, &args[i], &None)?;
                match (&at)
                {
                    Some(t) :
                    {
                        bool skip = match (t)
                        {
                            Type::TNever : true,
                            _            : false,
                        };
                        Option<FfiProblem> problem = match (t)
                        {
                            Type::TVoid : ffi_here(String::copy("`void`, which is no value")),
                            _           : if (skip) { None } else { ffi_type_problem(it, t, true) },
                        };
                        if (Some(p) = problem)
                        {
                            String msg = sprintf(
                                "argument %v of `%s` is %s, which cannot cross to C: an argument after a C function's fixed parameters is of an extern's types, integers, `f32`, `f64`, `bool`, `rawptr<T>` and plain structs of those (D-0252)",
                                i + 1,
                                Option::unwrap_or(StringView::strip_prefix(&name, "std::"), &name),
                                &ffi_part(t, p),
                            );
                            return Err(named_diag("diag.extern-non-ffi-type", &msg));
                        }
                    },
                    None    : {},
                }
                Vec::push(&mut ext_tys, at);
            }
            check_arg_exact_types(b, it, "", &ext.params, args, &ext_tys, &HashMap::new(), &HashSet::new())?;
            return Ok(Some(clone(&ext.ret)));
        },
        None      : {},
    }
    // `std`'s own helpers: not names anywhere else.
    if (is_std_only_intrinsic(nv) && b.module_ != "std")
    {
        return Err("diag.unbound-name");
    }
    if (is_trusted_intrinsic(nv) && b.unsafe_depth == 0)
    {
        return Err("diag.trusted-outside-unsafe");
    }
    // A reclaimed object's references are checked by the run against the
    // record of raw storage (`[Reclaim]`), which the static pass does not
    // follow: the program is not decided (D-0284). `std`'s own uses are its
    // containers' bookkeeping.
    if (nv == "reclaim" && b.module_ != "std" && !StringView::starts_with(&b.module_, "std::"))
    {
        rep_left(b, sprintf("line %v: a reference to a reclaimed object is checked by the run", b.current_line));
    }
    // WI-15: an intrinsic of a fixed shape called in another.
    match (intrinsic_shape(nv))
    {
        Some(s) :
        {
            if (Vec::len(targs) < s.tmin || Vec::len(targs) > s.tmax || Vec::len(args) < s.amin || Vec::len(args) > s.amax)
            {
                String msg = sprintf("`%s` is written `%s%s`", &name, &name, s.form);
                return Err(named_diag("diag.type-mismatch", &msg));
            }
        },
        None    : {},
    }
    if (nv == "drop" && Vec::len(args) == 1)
    {
        match (root_local_name(&args[0]))
        {
            Some(n) :
            {
                if (HashMap::contains(&b.move_captures, &n))
                {
                    // `drop(self.f_i)`: `[Destroy-Projection]`.
                    return Err("diag.move-out-of-field");
                }
            },
            None    : {},
        }
        // `[Guard-Drop]` (bug 005): dropping a guard unlocks its mutex; a
        // reference reached through it (`&*g`) used later would outlive the
        // lock.
        match (one_seg(strip_parens_tc(&args[0])))
        {
            Some(g) :
            {
                bool is_guard = match (lookup_local(b, g))
                {
                    Some(Type::TGuard(_)) : true,
                    _                     : false,
                };
                if (is_guard)
                {
                    guard_end_kept(b, g)?;
                }
            },
            None    : {},
        }
        // Report 442: a `static` is never destroyed.
        match (path_segs(strip_parens_tc(&args[0])))
        {
            Some(segs) :
            {
                String sn = String::join(segs, "::");
                if (!(Vec::len(segs) == 1 && is_local(b, &segs[0])) && HashMap::contains(&it.statics, &sn))
                {
                    return Err(named_diag("diag.static-assigned", &sprintf(
                        "`%s` is a `static`, which is never assigned or destroyed: it lives as long as the program",
                        &sn,
                    )));
                }
            },
            None       : {},
        }
        borrowed_capture_kept(b, it, &args[0], "diag.destroy-while-aliased", "destroyed")?;
        // `[Destroy]` on a place: then the binding is consumed. Report 439
        // (D-0339): an element or a field (`drop(v[i])`, `drop(r.f)`) is
        // moved out to be destroyed, as `consume(v[i])` moves it, and is
        // checked as that move is.
        b.place_pos = Option::is_some(&one_seg(strip_parens_tc(&args[0])));
        check_expr(b, it, &args[0], &None)?;
        match (place_of(b, it, &args[0]))
        {
            Some(p) :
            {
                if (Vec::len(&p.path) == 0)
                {
                    flow_consume(b, it, &p.root, "diag.destroy-while-aliased")?;
                }
                else if (place_is_resource(b, it, &p.root, &p.path))
                {
                    refute(b, "diag.move-out-of-field")?;
                }
            },
            None    : {},
        }
        return Ok(Some(Type::TVoid));
    }
    if (nv == "fault")
    {
        // `fault(d)` / `fault(d, message)` (spec/21 §0, D-0083).
        String d = match (if (Vec::len(args) > 0) { path_segs(&args[0]) } else { None })
        {
            Some(ds) :
            {
                if (Vec::len(ds) != 1)
                {
                    return Err(mismatch("`fault` takes a diagnostic's name, as in `fault(index_out_of_bounds)`, and optionally a `str` message"));
                }
                String::clone(&ds[0])
            },
            None     : return Err(mismatch("`fault` takes a diagnostic's name, as in `fault(index_out_of_bounds)`, and optionally a `str` message")),
        };
        String id = sprintf("diag.%s", &StringView::replace(&d, "_", "-"));
        if (!is_dynamic_diag(&id))
        {
            String msg = sprintf(
                "`%s` names no run-time fault; `fault` takes a dynamic diagnostic of the registry with `_` for `-`, such as `assert_failed`, `index_out_of_bounds`, `unwrap_failed` or `alloc_failure`",
                &d,
            );
            return Err(named_diag("diag.unbound-name", &msg));
        }
        if (Vec::len(args) > 2)
        {
            return Err(mismatch("`fault` takes a diagnostic's name and at most one `str` message"));
        }
        if (Vec::len(args) > 1)
        {
            Option<Type> t = check_expr(b, it, &args[1], &Some(Type::TStr))?;
            match (&t)
            {
                Some(Type::TStr) : {},
                None             : {},
                _                : return Err(mismatch("`fault`'s message is a `str`")),
            }
        }
        return Ok(Some(Type::TNever));
    }
    if (nv == "spawn" && !b.flow.unreachable)
    {
        // D-0213: lending `r` to the thread borrows `*r`.
        Vec<DerivKey> lent = spawn_lent_refs(b, it, args);
        for (usize i = 0; i < Vec::len(&lent); i += 1)
        {
            flow_clash(b, it, &lent[i].root, &lent[i].path, lent[i].mode, "diag.aliasing-conflict")?;
        }
    }
    if (nv == "spawn" && Vec::len(args) > 0)
    {
        // `rule.conc.spawn`: the callee is a fn value or a `move` closure;
        // report 320: or a closure that captures nothing (`[]`), which
        // borrows nothing.
        bool borrowing = match (&args[0].kind)
        {
            ExprKind::EClosure(cb) : !Box::get(cb).is_move && Vec::len(&Box::get(cb).captures) > 0,
            ExprKind::EPath(pb) : Vec::len(&Box::get(pb).segs) == 1 && match (HashMap::get(
                &b.closure_moves,
                &Box::get(pb).segs[0],
            ))
            {
                Some(mv) : !*mv,
                None     : false,
            },
            _                      : false,
        };
        if (borrowing)
        {
            return Err("diag.spawn-borrow-closure");
        }
        // `[Thread-Confined]` (bug 031): what a `move` closure captures goes
        // to the thread, and so does a closure binding's.
        match (&args[0].kind)
        {
            ExprKind::EClosure(cb) :
            {
                foreach (cap in &Box::get(cb).captures)
                {
                    match (lookup_local(b, cap))
                    {
                        Some(t) :
                        {
                            thread_confined_err(it, &t, &sprintf("the capture `%s`", cap))?;
                        },
                        None    : {},
                    }
                    if (HashSet::contains(&b.closure_confined, cap))
                    {
                        thread_confined_closure_err(cap)?;
                    }
                }
            },
            ExprKind::EPath(pb)    :
            {
                ref<Vec<String>, shared> segs = &Box::get(pb).segs;
                if (Vec::len(segs) == 1 && HashSet::contains(&b.closure_confined, &segs[0]))
                {
                    thread_confined_closure_err(&segs[0])?;
                }
            },
            _                      : {},
        }
    }
    if (nv == "join" && Vec::len(args) == 1)
    {
        // D-0071: the thread has finished; what it borrowed is free.
        match (path_segs(strip_parens_tc(&args[0])))
        {
            Some(hs) :
            {
                if (Vec::len(hs) == 1 && !b.flow.unreachable)
                {
                    HashMap::remove(&mut b.flow.deriv, &hs[0]);
                }
            },
            None     : {},
        }
    }
    if (nv == "Mutex::new" && Vec::len(args) == 1)
    {
        // `Mutex::new<T>(T v) : mutex<T>`, typed as the generic call it is.
        Option<Type> hint = if (Vec::len(targs) > 0)
        {
            Some(apply_subst(&targs[0], &b.subst))
        }
        else
        {
            match (expected)
            {
                Some(Type::TMutex(mb)) : if (!has_unresolved_marker(Box::get(mb))) { Some(clone(Box::get(mb))) } else { None },
                _                      : None,
            }
        };
        Option<Type> t = check_store_operand(b, it, &args[0], &hint)?;
        return Ok(match (or_type(hint, t))
        {
            Some(x) : Some(Type::TMutex(Box::new(x))),
            None    : None,
        });
    }
    if (is_each_name(nv))
    {
        // `foreach` (D-0042): the expansion for the collection's type,
        // checked as the code it is.
        Option<Type> t0 = match (if (Vec::len(args) > 0) { path_segs(&args[0]) } else { None })
        {
            Some(s0) :
            {
                if (Vec::len(s0) == 1)
                {
                    match (HashMap::get(&b.gamma, &s0[0]))
                    {
                        Some(t) : Some(apply_subst(t, &b.subst)),
                        None    : None,
                    }
                }
                else
                {
                    None
                }
            },
            None     : None,
        };
        Type t0v = match (t0)
        {
            Some(t) : if (has_unresolved_marker(&t)) { return Ok(None); } else { t },
            None    : return Ok(None),
        };
        Expr x = each_expand(nv, &t0v, args, callee.line, callee.col)?;
        number_fresh(b, &mut x);
        bool saved = b.privileged;
        b.privileged = true;
        Result<Option<Type>, String> r = check_expr(b, it, &x, expected);
        b.privileged = saved;
        return r;
    }
    if (nv == "std::exit")
    {
        // `[Exit]` (D-0150): one `u8`; of type `never`.
        if (Vec::len(args) != 1)
        {
            return Err(mismatch("`exit` takes one argument, the program's exit status (a `u8`)"));
        }
        check_expect(b, it, &args[0], &Type::TInt(IntTy::U8))?;
        return Ok(Some(Type::TNever));
    }
    if (nv == "std::print")
    {
        // `rule.stdlib.print` (spec/21 §2a): one argument, printable.
        if (Vec::len(args) != 1)
        {
            return Err("diag.type-mismatch");
        }
        Option<Type> t = check_store_operand(b, it, &args[0], &None)?;
        bool printable = match (&t)
        {
            None    : true,
            Some(x) : has_unresolved_marker(x) || is_printable(x),
        };
        return if (printable) { Ok(Some(Type::TVoid)) } else { Err("diag.type-mismatch") };
    }
    if (nv == "$require_fail")
    {
        // D-0317: a requirement that does not hold, after `modres`
        // (`rule.fn.requires`): the diagnostic it names, as `fault`'s, and its
        // message.
        String d = match (if (Vec::len(args) > 0) { path_segs(&args[0]) } else { None })
        {
            Some(ds) :
            {
                if (Vec::len(ds) != 1)
                {
                    return Err("diag.type-mismatch");
                }
                String::clone(&ds[0])
            },
            None     : return Err("diag.type-mismatch"),
        };
        String id = sprintf("diag.%s", &StringView::replace(&d, "_", "-"));
        if (!is_dynamic_diag(&id))
        {
            String msg = sprintf(
                "`%s` names no run-time fault; a requirement names a dynamic diagnostic of the registry with `_` for `-`, as `fault` does, such as `index_out_of_bounds`",
                &d,
            );
            return Err(named_diag("diag.unbound-name", &msg));
        }
        if (Vec::len(args) > 2)
        {
            return Err("diag.type-mismatch");
        }
        if (Vec::len(args) == 2)
        {
            check_expect(b, it, &args[1], &Type::TStr)?;
        }
        return Ok(Some(Type::TNever));
    }
    if (nv == "$assert_fail")
    {
        // `assert` after `modres` (D-0065).
        if (Vec::len(args) > 1)
        {
            return Err("diag.type-mismatch");
        }
        if (Vec::len(args) == 1)
        {
            check_expect(b, it, &args[0], &Type::TStr)?;
        }
        return Ok(Some(Type::TNever));
    }
    if (nv == "std::assert")
    {
        // An `assert` `modres` did not rewrite: without a condition.
        return Err("diag.type-mismatch");
    }
    if (nv == "$fmt")
    {
        return check_fmt(b, it, args);
    }
    if (nv == "min_value" || nv == "max_value")
    {
        // `rule.arith.limits` (spec/06 §5a).
        if (Vec::len(args) > 0)
        {
            return Err("diag.type-mismatch");
        }
        if (Vec::len(targs) == 0)
        {
            return Err("diag.cannot-infer-type-parameter");
        }
        Type t = apply_subst(&targs[0], &b.subst);
        if (is_numeric_ty(&t) || has_unresolved_marker(&t))
        {
            return Ok(Some(t));
        }
        return Err("diag.type-mismatch");
    }
    if (nv == "static_assert")
    {
        return check_static_assert(b, it, args);
    }
    if (!is_intrinsic_name_tc(&name))
    {
        // Not an item, not an intrinsic: resolve it as a name first.
        check_path(b, it, segs)?;
    }
    bool saved = b.infer_poisoned;
    b.infer_poisoned = true;
    // `[T-Alt]`: a bare literal operand of an alternative operation takes
    // its type from the other operand, which is checked first.
    bool alt = is_alt_intrinsic(nv) && Vec::len(args) == 2;
    bool lit_first = alt && is_bare_num_literal(&args[0]) && !is_bare_num_literal(&args[1]);
    Vec<usize> order = Vec::new();
    if (lit_first)
    {
        Vec::push(&mut order, 1);
        Vec::push(&mut order, 0);
    }
    else
    {
        for (usize i = 0; i < Vec::len(args); i += 1)
        {
            Vec::push(&mut order, i);
        }
    }
    Vec<Option<Type>> by_index = Vec::new();
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        Vec::push(&mut by_index, None);
    }
    Result<void, String> r = Ok(());
    for (usize oi = 0; oi < Vec::len(&order); oi += 1)
    {
        usize i = order[oi];
        Option<Type> hint = intrinsic_arg_hint(nv, i, alt, args, &by_index, expected);
        // Report 293: `slice_len(&NAMES)` of a `const` array is its length,
        // a value of the array's type; nothing is borrowed.
        if (nv == "slice_len" && i == 0)
        {
            match (const_array_borrowed(it, &args[0]))
            {
                Some(t) :
                {
                    by_index[i] = Some(ref_of(t, Mode::Shared));
                    continue;
                },
                None    : {},
            }
        }
        match (check_store_operand(b, it, &args[i], &hint))
        {
            Ok(t)  : by_index[i] = t,
            Err(d) :
            {
                r = Err(d);
                break;
            },
        }
    }
    b.infer_poisoned = saved;
    r?;
    Vec<Option<Type>> arg_tys = by_index;
    // D-0312 `[Coerce-Slice]` for `simd_load`'s and `simd_store`'s slice
    // parameter: `&v` of a whole `Vec` or array is `&v[0..$]`.
    if ((nv == "simd_load" || nv == "simd_store") && Vec::len(args) > 0)
    {
        match (simd_seq_slice(nv, &arg_tys))
        {
            Some(want) :
            {
                match (simd_arg(&arg_tys, 0))
                {
                    Some(got) :
                    {
                        if (coerce_text(b, it, &want, &got, &args[0]))
                        {
                            arg_tys[0] = Some(want);
                        }
                    },
                    None      : {},
                }
            },
            None       :
            {
                // §3.2's lint: `&v[0..$]` there is `&v`.
                match (simd_arg(&arg_tys, 0))
                {
                    Some(Type::TSlice(sb)) : whole_slice_lint(b, it, &Type::TSlice(sb), &args[0]),
                    _                      : {},
                }
            },
        }
    }
    // D-0254: the lane-wise intrinsics.
    match (simd_intrinsic_type(nv, targs, &arg_tys)?)
    {
        Some(t) : return Ok(Some(t)),
        None    : {},
    }
    check_integer_intrinsic_operands(b, nv, targs, args, &arg_tys)?;
    return check_intrinsic_result(b, it, nv, targs, args, &arg_tys, alt);
}

// The type an intrinsic's argument `i` is checked at, from the others.
fn intrinsic_arg_hint(
    StringView name,
    usize i,
    bool alt,
    ref<Vec<Expr>, shared> args,
    ref<Vec<Option<Type>>, shared> by_index,
    ref<Option<Type>, shared> expected,
) : Option<Type>
{
    bool simd_two = is_simd_pair_intrinsic(name) || alt;
    // Report 135: `spawn(f, a…)` gives each `a` the type `f` declares for
    // it, as a call of `f` does (`spawn(work, 1000 * 1000)`).
    if (name == "spawn" && i >= 1)
    {
        return match (&by_index[0])
        {
            Some(Type::TFn(fb)) :
            {
                ref<FnTy, shared> ft = Box::get(fb);
                if (i - 1 < Vec::len(&ft.params) && !has_unresolved_marker(&ft.params[i - 1]))
                {
                    Some(clone(&ft.params[i - 1]))
                }
                else
                {
                    None
                }
            },
            _                   : None,
        };
    }
    if (alt && is_bare_num_literal(&args[i]))
    {
        return match (&by_index[1 - i])
        {
            Some(Type::TInt(t)) : Some(Type::TInt(*t)),
            // `[T-Bound-Literal]` (report 338): `wrapping_sub(v, 1)` with
            // `v : T`, `T` a `number` type parameter.
            Some(t)             : if (is_marker(t)) { Some(clone(t)) } else { None },
            _                   : None,
        };
    }
    if (simd_two && i == 1 && is_simd_opt(&by_index[0]))
    {
        // D-0254: the second operand of a lane-wise operation is the
        // first one's type.
        return clone(&by_index[0]);
    }
    if ((i == 0 && (name == "simd_min" || name == "simd_max")) || (i == 1 && name == "simd_select"))
    {
        return if (is_simd_opt(expected)) { clone(expected) } else { None };
    }
    if (name == "simd_select" && i == 2)
    {
        return if (is_simd_opt(&by_index[1])) { clone(&by_index[1]) } else { None };
    }
    if (name == "simd_store" && i == 2)
    {
        // A literal vector stored into a slice of `τ` is a `simd<τ, N>`.
        Option<u128> n = match (&strip_parens_tc(&args[2]).kind)
        {
            ExprKind::EArrayLit(es)   : Some(widen<u128>(Vec::len(es))),
            ExprKind::EArrayRepeat(r) : Some(Box::get(r).n),
            _                         : None,
        };
        // `[Coerce-Slice]`: a reference to a whole `Vec` or array is its slice.
        Option<Type> s0 = match (simd_seq_slice(name, by_index))
        {
            Some(t) : Some(t),
            None    : clone(&by_index[0]),
        };
        return match (&s0)
        {
            Some(Type::TSlice(sb)) : match (n)
            {
                Some(k) : Some(simd_of(clone(&Box::get(sb).inner), k)),
                None    : None,
            },
            _ : None,
        };
    }
    if ((name == "simd_load" && i == 1) || (name == "simd_store" && i == 1))
    {
        return Some(Type::TInt(IntTy::Usize));
    }
    if ((name == "atomic_op" || name == "atomic_wait_op") && i == 1)
    {
        return Some(Type::TInt(IntTy::U8));
    }
    if (name == "atomic_wait_op" && i == 2)
    {
        return Some(Type::TInt(IntTy::U64));
    }
    if (name == "cpu_op")
    {
        return Some(Type::TInt(IntTy::U8));
    }
    if (name == "atomic_op" && i >= 2)
    {
        // D-0249, D-0253: the operands are the atomic's cell type.
        return match (&by_index[0])
        {
            Some(t) : atomic_cell_ty(t),
            None    : None,
        };
    }
    None
}

fn is_ref_to_handle(ref<Option<Type>, shared> t) : bool
{
    match (t)
    {
        Some(Type::TRef(rb)) : match (&Box::get(rb).inner)
        {
            Type::THandle(_) : true,
            _                : false,
        },
        _ : false,
    }
}

// What an intrinsic gives, its operands checked (the rest of `check_call`'s
// intrinsic branch).
fn check_intrinsic_result(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    StringView name,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    ref<Vec<Option<Type>>, shared> arg_tys,
    bool alt,
) : Result<Option<Type>, String>
{
    String nm = String::copy(name);
    // D-0091: `sqrt` and the others of an `f32` or `f64`, of that type.
    if (is_float_fn(&nm))
    {
        StringView short = Option::unwrap_or(StringView::strip_prefix(name, "std::"), name);
        if (Vec::len(args) != 1)
        {
            return Err(mismatch(sprintf("`%s` takes one argument", short)));
        }
        return match (arg_ty(arg_tys, 0))
        {
            Some(t) :
            {
                if (is_float_type(&t))
                {
                    return Ok(Some(t));
                }
                if (has_unresolved_marker(&t))
                {
                    return Err(mismatch(sprintf(
                        "`%s` takes an `f32` or `f64`; a type parameter's value is neither, whatever its bound",
                        short,
                    )));
                }
                // Bug 124: an integer literal is written as a float.
                match (int_literal_text(&args[0]))
                {
                    Some(lt) :
                    {
                        return Err(mismatch(sprintf(
                            "`%s` takes an `f32` or `f64`, and this is `%s`; write the literal as a float: `%s.0`",
                            short,
                            &type_display(&t),
                            &lt,
                        )));
                    },
                    None     : {},
                }
                Err(mismatch(sprintf(
                    "`%s` takes an `f32` or `f64`, and this is `%s`; convert an integer with `to_float<f64>(…)`",
                    short,
                    &type_display(&t),
                )))
            },
            None    : Ok(None),
        };
    }
    // D-0101: `atan2(y, x)`, `powf(x, y)`: two operands of one float type.
    if (is_float2_fn(&nm))
    {
        StringView short = Option::unwrap_or(StringView::strip_prefix(name, "std::"), name);
        if (Vec::len(args) != 2)
        {
            return Err(mismatch(sprintf("`%s` takes two arguments", short)));
        }
        Option<Type> a0 = arg_ty(arg_tys, 0);
        Option<Type> a1 = arg_ty(arg_tys, 1);
        match (&a0)
        {
            Some(a) : match (&a1)
            {
                Some(c) :
                {
                    if (is_float_type(a) && type_eq(a, c))
                    {
                        return Ok(Some(clone(a)));
                    }
                    if (is_float_type(a) && is_float_type(c))
                    {
                        return Err(mismatch(sprintf(
                            "`%s` takes two operands of one type, and these are `%s` and `%s`; a literal is `f64` unless suffixed (`1.0: f32`)",
                            short,
                            &type_display(a),
                            &type_display(c),
                        )));
                    }
                },
                None    : {},
            },
            None : {},
        }
        for (usize k = 0; k < 2; k += 1)
        {
            match (if (k == 0) { &a0 } else { &a1 })
            {
                Some(t) :
                {
                    if (!is_float_type(t) && !has_unresolved_marker(t))
                    {
                        match (int_literal_text(&args[k]))
                        {
                            Some(lt) :
                            {
                                return Err(mismatch(sprintf(
                                    "`%s` takes `f32` or `f64` operands, and this is `%s`; write the literal as a float: `%s.0`",
                                    short,
                                    &type_display(t),
                                    &lt,
                                )));
                            },
                            None     : {},
                        }
                        return Err(mismatch(sprintf(
                            "`%s` takes `f32` or `f64` operands, and this is `%s`; convert an integer with `to_float<f64>(…)`",
                            short,
                            &type_display(t),
                        )));
                    }
                },
                None    : {},
            }
        }
        return Ok(None);
    }
    if (alt)
    {
        // `[T-Alt]`'s result: the operands' type τ, or `Option<τ>` for the
        // `checked_` family.
        Option<Type> t = None;
        for (usize k = 0; k < Vec::len(arg_tys) && Option::is_none(&t); k += 1)
        {
            match (&arg_tys[k])
            {
                Some(Type::TInt(i)) : t = Some(Type::TInt(*i)),
                _                   : {},
            }
        }
        return Ok(match (t)
        {
            Some(x) :
            {
                if (StringView::starts_with(name, "checked_"))
                {
                    Vec<Type> a = Vec::new();
                    Vec::push(&mut a, x);
                    Some(named("std::Option", a))
                }
                else
                {
                    Some(x)
                }
            },
            None    : None,
        });
    }
    // `[Spawn]`, `[Join]` (spec/19 §1).
    if (name == "spawn" && Vec::len(args) > 0)
    {
        // `[Thread-Confined]` (bug 031): the thread's arguments, and its
        // result, which `join` takes to the joining thread.
        for (usize i = 1; i < Vec::len(arg_tys); i += 1)
        {
            match (&arg_tys[i])
            {
                Some(t) :
                {
                    thread_confined_err(it, t, &sprintf("argument %v of `spawn`", i + 1))?;
                },
                None    : {},
            }
        }
        match (&arg_tys[0])
        {
            Some(Type::TFn(fb)) :
            {
                thread_confined_err(it, &Box::get(fb).ret, "the thread's result")?;
            },
            _                   : {},
        }
        match (spawn_callee_params(b, it, args, arg_tys))
        {
            Some(sp) :
            {
                if (Vec::len(&sp.params) != Vec::len(args) - 1)
                {
                    return Err(mismatch(sprintf(
                        "`spawn(f, …)` passes its other arguments to `f`, which takes %v and is given %v",
                        Vec::len(&sp.params),
                        Vec::len(args) - 1,
                    )));
                }
                HashMap<String, Type> m = HashMap::new();
                for (usize i = 0; i < Vec::len(&sp.params); i += 1)
                {
                    match (&arg_tys[i + 1])
                    {
                        Some(a) : unify_type_shape(&sp.params[i].ty, a, &mut m, &sp.type_params),
                        None    : {},
                    }
                }
                HashSet<String> tset = HashSet::new();
                for (usize i = 0; i < Vec::len(&sp.type_params); i += 1)
                {
                    HashSet::insert(&mut tset, String::clone(&sp.type_params[i]));
                }
                Vec<Expr> rest_args = Vec::new();
                Vec<Option<Type>> rest_tys = Vec::new();
                for (usize i = 1; i < Vec::len(args); i += 1)
                {
                    Vec::push(&mut rest_args, clone(&args[i]));
                    // D-0149: a text literal where the thread's function
                    // declares a `String` is that `String`, as in a call of
                    // it, made by D-0162's rewrite (session finding 001-C5;
                    // CHG-0412).
                    Type want = apply_subst(&sp.params[i - 1].ty, &m);
                    bool string_param = match (&want)
                    {
                        Type::TNamed(n) : Box::get(n).name == "std::String" && Vec::len(&Box::get(n).args) == 0,
                        _               : false,
                    };
                    if (is_bare_str_literal(&args[i]) && string_param)
                    {
                        note_literal_as_string(b, &args[i], true);
                        Vec::push(&mut rest_tys, Some(want));
                    }
                    else
                    {
                        Vec::push(&mut rest_tys, clone(&arg_tys[i]));
                    }
                }
                check_arg_exact_types(b, it, "", &sp.params, &rest_args, &rest_tys, &m, &tset)?;
            },
            None     : {},
        }
        match (&arg_tys[0])
        {
            Some(Type::TFn(fb)) :
            {
                if (!has_unresolved_marker(&Box::get(fb).ret))
                {
                    return Ok(Some(Type::THandle(Box::new(clone(&Box::get(fb).ret)))));
                }
            },
            _                   : {},
        }
        // WI-15: what the thread runs is a function.
        match (&arg_tys[0])
        {
            Some(t) :
            {
                bool runnable = match (t)
                {
                    Type::TFn(_)      : true,
                    Type::TClosure(_) : true,
                    Type::TNever      : true,
                    _                 : false,
                };
                if (!runnable && !has_unresolved_marker(t))
                {
                    String msg = sprintf(
                        "`spawn` runs a function: its first argument is a fn value or a `move` closure, not `%s`",
                        &type_display(t),
                    );
                    return Err(named_diag("diag.type-mismatch", &msg));
                }
            },
            None    : {},
        }
    }
    if (name == "join")
    {
        match (arg_ty(arg_tys, 0))
        {
            Some(Type::THandle(h)) : return Ok(Some(Box::into_inner(h))),
            _                      : {},
        }
    }
    // D-0204: `cancel` and `join_status`.
    if (name == "join_status" && is_ref_to_handle(&arg_ty(arg_tys, 0)))
    {
        return Ok(Some(Type::TInt(IntTy::U64)));
    }
    if (name == "cancel" && is_ref_to_handle(&arg_ty(arg_tys, 0)))
    {
        return Ok(Some(Type::TVoid));
    }
    // WI-15: the operand a thread or raw intrinsic takes, where known.
    match (arg_ty(arg_tys, 0))
    {
        Some(t) :
        {
            Option<bool> fits = None;
            if (name == "lock")
            {
                fits = Some(match (&t)
                {
                    Type::TRef(rb) : match (&Box::get(rb).inner)
                    {
                        Type::TMutex(_) : true,
                        _               : false,
                    },
                    _ : false,
                });
            }
            else if (name == "join")
            {
                fits = Some(match (&t)
                {
                    Type::THandle(_) : true,
                    _                : false,
                });
            }
            else if (name == "cancel" || name == "join_status")
            {
                fits = Some(is_ref_to_handle(&Some(clone(&t))));
            }
            else if (name == "rawptr_of")
            {
                fits = Some(match (&t)
                {
                    Type::TRef(_) : true,
                    _             : false,
                });
            }
            match (fits)
            {
                Some(false) :
                {
                    if (!is_never(&t) && !has_unresolved_marker(&t))
                    {
                        str want = if (name == "lock") { "a reference to a mutex: `lock(&m)`" } else if (name == "join") { "the handle `spawn` gave" } else if (name == "rawptr_of") { "a reference: `rawptr_of(&x)`" } else { "a reference to the handle `spawn` gave" };
                        String msg = sprintf("`%s` takes %s, not `%s`", name, want, &type_display(&t));
                        return Err(named_diag("diag.type-mismatch", &msg));
                    }
                },
                _           : {},
            }
        },
        None    : {},
    }
    // D-0249 `rule.conc.atomic`, std-only.
    if (name == "atomic_op")
    {
        Option<Type> cell = match (arg_ty(arg_tys, 0))
        {
            Some(t) : atomic_cell_ty(&t),
            None    : None,
        };
        Type t = match (cell)
        {
            Some(t) : t,
            None    : return Err(mismatch("`atomic_op` takes a reference to an `Atomic` or an `AtomicPtr` first")),
        };
        for (usize k = 2; k < 4; k += 1)
        {
            match (arg_ty(arg_tys, k))
            {
                Some(vt) :
                {
                    if (!has_unresolved_marker(&vt) && !has_unresolved_marker(&t) && !ty_compat(
                        &vt,
                        &t,
                    ) && !is_bare_num_literal(&args[k]))
                    {
                        return Err(mismatch(sprintf(
                            "`atomic_op` on an `Atomic<%s>` takes `%s` operands, not `%s`",
                            &type_display(&t),
                            &type_display(&t),
                            &type_display(&vt),
                        )));
                    }
                },
                None     : {},
            }
        }
        return Ok(Some(t));
    }
    if (name == "atomic_wait_op")
    {
        bool ok = match (arg_ty(arg_tys, 0))
        {
            Some(Type::TRef(rb)) : named_is(&Box::get(&rb).inner, "std::Atomic"),
            _                    : false,
        };
        if (!ok)
        {
            return Err(mismatch("`atomic_wait_op` takes a reference to an `Atomic` first"));
        }
        return Ok(Some(Type::TInt(IntTy::U64)));
    }
    if (name == "cpu_op")
    {
        return Ok(Some(Type::TVoid));
    }
    // `[Lock]` (spec/19 §2).
    if (name == "lock")
    {
        match (arg_ty(arg_tys, 0))
        {
            Some(Type::TRef(rb)) : match (&Box::get(&rb).inner)
            {
                Type::TMutex(mb) : return Ok(Some(Type::TGuard(Box::new(clone(Box::get(mb)))))),
                _                : {},
            },
            _ : {},
        }
    }
    // D-0123: a rotation keeps its operand's type.
    if (name == "rotate_left" || name == "rotate_right")
    {
        match (arg_ty(arg_tys, 0))
        {
            Some(Type::TInt(i)) : return Ok(Some(Type::TInt(i))),
            _                   : {},
        }
    }
    // D-0121: `read_volatile(p) : τ` and `write_volatile(p, v)`.
    if (name == "read_volatile" || name == "write_volatile")
    {
        bool read = name == "read_volatile";
        usize want = if (read) { 1 } else { 2 };
        if (Vec::len(args) != want)
        {
            return Err(mismatch(sprintf(
                "`%s` takes %v argument%s",
                name,
                want,
                if (want == 1) { ": a raw pointer" } else { "s: a raw pointer and the value to write" },
            )));
        }
        Type t = match (arg_ty(arg_tys, 0))
        {
            Some(Type::TRawptr(pb)) : Box::into_inner(pb),
            _                       : return Err(mismatch(sprintf("`%s` takes a `rawptr<T>` first", name))),
        };
        if (!has_unresolved_marker(&t) && is_resource_ty(it, &t))
        {
            return Err(mismatch(sprintf(
                "`%s` moves nothing: `%s` is a resource, which crosses raw memory by `*p` (moved in or out)",
                name,
                &type_display(&t),
            )));
        }
        if (!read)
        {
            match (arg_ty(arg_tys, 1))
            {
                Some(vt) :
                {
                    if (!has_unresolved_marker(&vt) && !has_unresolved_marker(&t) && !ty_compat(
                        &vt,
                        &t,
                    ) && !is_bare_num_literal(&args[1]))
                    {
                        return Err(mismatch(sprintf(
                            "`write_volatile` through a `rawptr<%s>` writes a `%s`, but the value is `%s`",
                            &type_display(&t),
                            &type_display(&t),
                            &type_display(&vt),
                        )));
                    }
                },
                None     : {},
            }
            return Ok(Some(Type::TVoid));
        }
        return Ok(Some(t));
    }
    // D-0258: `rawptr_from_address<T>(a)` and `rawptr_address(p)`.
    if (name == "rawptr_from_address")
    {
        match (arg_ty(arg_tys, 0))
        {
            Some(t) :
            {
                if (!has_unresolved_marker(&t) && !type_eq(
                    &t,
                    &Type::TInt(IntTy::Usize),
                ) && !is_bare_num_literal(&args[0]))
                {
                    return Err(mismatch(sprintf(
                        "`rawptr_from_address` takes the address as a `usize`, not `%s`",
                        &type_display(&t),
                    )));
                }
            },
            None    : {},
        }
        return Ok(if (Vec::len(targs) > 0) { Some(rawptr_of(apply_subst(&targs[0], &b.subst))) } else { None });
    }
    if (name == "rawptr_address")
    {
        match (arg_ty(arg_tys, 0))
        {
            Some(t) :
            {
                bool ok = match (&t)
                {
                    Type::TRawptr(_) : true,
                    Type::TNever     : true,
                    _                : false,
                };
                if (!has_unresolved_marker(&t) && !ok)
                {
                    return Err(mismatch(sprintf("`rawptr_address` takes a raw pointer, not `%s`", &type_display(&t))));
                }
            },
            None    : {},
        }
        return Ok(Some(Type::TInt(IntTy::Usize)));
    }
    // D-0312: `probe_key(k)`, the key a probe names, copied
    // (`HashMap::entry`): a view's text as a new `String`
    // (`String::copy`), a reference's referent cloned, a number, `bool`
    // or `str` itself.
    if (name == "probe_key")
    {
        match (arg_ty(arg_tys, 0))
        {
            Some(t) :
            {
                if (plain_named_ty(&t, "std::StringView"))
                {
                    record_instantiation(b, &String::copy("std::String::copy"), &Vec::new());
                    return Ok(Some(named("std::String", Vec::new())));
                }
                match (t)
                {
                    Type::TRef(rb) :
                    {
                        Type k = ModedTy::take_inner(rb);
                        if (!has_unresolved_marker(&k))
                        {
                            match (clone_problem(b, it, &k))
                            {
                                Some(problem) : return Err(mismatch(sprintf(
                                    "a key is copied when it is added (`HashMap::entry`), and `%s` has no clone: %s",
                                    &type_display(&k),
                                    &problem,
                                ))),
                                None : {},
                            }
                        }
                        return Ok(Some(k));
                    },
                    Type::TInt(i)  : return Ok(Some(Type::TInt(i))),
                    Type::TBool    : return Ok(Some(Type::TBool)),
                    Type::TF32     : return Ok(Some(Type::TF32)),
                    Type::TF64     : return Ok(Some(Type::TF64)),
                    Type::TStr     : return Ok(Some(Type::TStr)),
                    _              : return Ok(None),
                }
            },
            None    : return Ok(None),
        }
    }
    // Report 066 (D-0336): `unwrap_failed_with(&e, head)` faults
    // `diag.unwrap-failed` with `head` and what `%v` prints of the error
    // when it prints one (a number, `bool`, text, an enum's variant), else
    // the error's type (the lowering's choice by the error's type).
    if (name == "unwrap_failed_with")
    {
        return Ok(Some(Type::TNever));
    }
    // D-0312: `probe_eq(a, k)`, whether `*a` is what `k` probes: for a view,
    // `String::same_view(a, k)`; for a reference, `*a == *k`; for a value,
    // `*a == k`.
    if (name == "probe_eq")
    {
        match (arg_ty(arg_tys, 1))
        {
            Some(t) :
            {
                if (plain_named_ty(&t, "std::StringView"))
                {
                    record_instantiation(b, &String::copy("std::String::same_view"), &Vec::new());
                }
            },
            None    : {},
        }
        return Ok(Some(Type::TBool));
    }
    // D-0116: `clone(&x) : T` for `x : T` with `T` clone.
    if (name == "clone")
    {
        if (Vec::len(args) != 1)
        {
            return Err(mismatch("`clone` takes one argument, a reference: `clone(&x)`"));
        }
        Type t = match (arg_ty(arg_tys, 0))
        {
            Some(Type::TRef(rb)) : ModedTy::take_inner(rb),
            // Not typed by this pass (a generic body's `foreach` element):
            // each instantiation is checked with its types (report 049).
            // So is `&p.f` or `&row[j]` of one (report 341).
            None : match (untyped_clone_root(strip_parens_tc(&args[0])))
            {
                Some(n) : if (is_local(b, &n)) { return Ok(None); } else
                {
                    return Err(mismatch("`clone` takes a reference to the value to copy: `clone(&x)`"));
                },
                None : return Err(mismatch("`clone` takes a reference to the value to copy: `clone(&x)`")),
            },
            _                    : return Err(mismatch("`clone` takes a reference to the value to copy: `clone(&x)`")),
        };
        if (!is_marker(&t) && has_unresolved_marker(&t))
        {
            return Ok(Some(t));
        }
        match (clone_problem(b, it, &t))
        {
            Some(problem) : return Err(mismatch(sprintf(
                "`clone` needs its `T` to be `clone` (%s), and `%s` is not: %s",
                bound_members(Bound::BClone),
                &type_display(&t),
                &problem,
            ))),
            None : {},
        }
        return Ok(Some(t));
    }
    // D-0312 `[Coerce-Slice]` for `slice_len`'s argument, whose parameter is a
    // shared slice: `&v` of a `Vec` or an array, or a reference to one, is
    // `&v[0..$]` (`&(*e)[0..$]`), as at any slice position; and §3.2's lint:
    // `slice_len(&v[0..$])` is `slice_len(&v)`.
    if (name == "slice_len" && Vec::len(args) == 1)
    {
        match (arg_ty(arg_tys, 0))
        {
            Some(Type::TRef(rb)) :
            {
                // Report 293: a `const` array's length is read as it is,
                // with nothing borrowed (`const_array_borrowed`).
                if (lint_seq(&Box::get(&rb).inner) && !b.facts.silent && Option::is_none(&const_array_borrowed(it, &args[0])))
                {
                    bool borrowed = match (&strip_parens_tc(&args[0]).kind)
                    {
                        ExprKind::EBorrow(bb) : Box::get(bb).mode == Mode::Shared && !const_call(it, &Box::get(bb).e),
                        _                     : false,
                    };
                    note_rewrite(b, &args[0], if (borrowed) { Rewrite::SeqSlice(false) } else { Rewrite::SeqPlaceSlice(false) });
                }
            },
            _                    : {},
        }
        whole_slice_lint(b, it, &Type::TSlice(Box::new(ModedTy { .inner = Type::TInt(IntTy::U8), .mode = Mode::Shared })), &args[0]);
    }
    Ok(check_known_intrinsic(b, name, targs))
}

struct SpawnCallee
{
    Vec<ParamDecl> params;
    Vec<String> type_params;
}

fn spawn_callee_params(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<Vec<Expr>, shared> args,
    ref<Vec<Option<Type>>, shared> arg_tys,
) : Option<SpawnCallee>
{
    match (resolve_fn_path(it, &args[0]))
    {
        Some(k) :
        {
            ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, &k), "a function");
            return Some(SpawnCallee { .params = clone(&f.params), .type_params = Vec::clone(&f.type_params) });
        },
        None    : {},
    }
    match (&arg_tys[0])
    {
        Some(Type::TFn(fb)) :
        {
            Vec<ParamDecl> ps = Vec::new();
            for (usize i = 0; i < Vec::len(&Box::get(fb).params); i += 1)
            {
                Vec::push(&mut ps, ParamDecl { .ty = clone(&Box::get(fb).params[i]), .name = sprintf("#%v", i + 1) });
            }
            Some(SpawnCallee { .params = ps, .type_params = Vec::new() })
        },
        _                   : None,
    }
}

// `static_assert(c, …)` (D-0052, D-0067, D-0068).
fn check_static_assert(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Vec<Expr>, shared> args,
) : Result<Option<Type>, String>
{
    if (Vec::len(args) == 0)
    {
        return Err("diag.type-mismatch");
    }
    // `[Static-Assert-Not-Constant]` (D-0067).
    Option<Type> ct = check_expr(b, it, &args[0], &Some(Type::TBool))?;
    match (&ct)
    {
        Some(t) :
        {
            bool ok = match (t)
            {
                Type::TBool  : true,
                Type::TNever : true,
                _            : false,
            };
            if (!ok)
            {
                return Err("diag.static-assert-not-constant");
            }
        },
        None    : {},
    }
    if (!const_expr(it, &args[0]))
    {
        return Err("diag.static-assert-not-constant");
    }
    // The message: a string literal, or (D-0068) a format and its
    // arguments, each a constant expression.
    Option<Expr> message_fmt = None;
    Option<String> msg = None;
    if (Vec::len(args) > 1)
    {
        match (&args[1].kind)
        {
            ExprKind::EStr(m) :
            {
                if (Vec::len(args) == 2)
                {
                    msg = Some(String::clone(m));
                }
                else
                {
                    for (usize i = 2; i < Vec::len(args); i += 1)
                    {
                        if (!const_expr(it, &args[i]))
                        {
                            return Err("diag.static-assert-not-constant");
                        }
                    }
                    usize line = args[1].line;
                    usize col = args[1].col;
                    Vec<Expr> fargs = Vec::new();
                    for (usize i = 1; i < Vec::len(args); i += 1)
                    {
                        Vec::push(&mut fargs, clone(&args[i]));
                    }
                    Vec<String> fs = Vec::new();
                    Vec::push(&mut fs, "$fmt");
                    Expr fmt = mk(
                        ExprKind::ECall(Box::new(CallExpr { .callee = mk(
                            ExprKind::EPath(Box::new(PathExpr { .segs = fs, .targs = Vec::new() })),
                            line,
                            col,
                        ), .args = fargs })),
                        line,
                        col,
                    );
                    number_fresh(b, &mut fmt);
                    check_expr(b, it, &fmt, &None)?;
                    message_fmt = Some(fmt);
                }
            },
            _                 : return Err("diag.type-mismatch"),
        }
    }
    // A generic body checked with its type parameters opaque cannot compute
    // it; each concrete instantiation does.
    bool opaque = false;
    for (usize i = 0; i < HashMap::len(&b.subst); i += 1)
    {
        if (has_unresolved_marker(HashMap::value_at(&b.subst, i)))
        {
            opaque = true;
        }
    }
    if (!opaque && b.report)
    {
        Vec<String> names = Vec::new();
        for (usize i = 0; i < HashMap::len(&b.subst); i += 1)
        {
            Vec::push(&mut names, String::clone(HashMap::key_at(&b.subst, i)));
        }
        Vec::sort(&mut names);
        String key = sprintf("%v|", args[0].id);
        for (usize i = 0; i < Vec::len(&names); i += 1)
        {
            String::appendf(
                &mut key,
                "%s=%s;",
                &names[i],
                &type_code(Option::expect(HashMap::get(&b.subst, &names[i]), "a type")),
            );
        }
        Vec::push(&mut b.static_asserts, StaticAssert {
            .key_code = key,
            .cond = clone(&args[0]),
            .subst = clone(&b.subst),
            // An assertion of `std`'s is reported at its prelude line past
            // `STD_LINE`, apart from the program's lines: `line 0` in a
            // dump, `<std>/FILE:LINE` in a report.
            .line = if (b.module_ == "std" || StringView::starts_with(&b.module_, "std::")) { STD_LINE + args[0].line } else { args[0].line },
            .message = msg,
            .message_fmt = message_fmt,
        });
    }
    Ok(Some(Type::TVoid))
}

fn opaque_or_never(ref<Type, shared> t) : bool
{
    is_never(t) || has_unresolved_marker(t)
}

fn int_or_opaque(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TInt(_) : true,
        _             : opaque_or_never(t),
    }
}

fn float_or_opaque(ref<Type, shared> t) : bool
{
    is_float_type(t) || opaque_or_never(t)
}

fn num_or_opaque(ref<Type, shared> t) : bool
{
    int_or_opaque(t) || float_or_opaque(t)
}

fn bitwidth_of(ref<Type, shared> t) : Option<u32>
{
    match (t)
    {
        Type::TInt(i) : Some(int_ty_bits(*i, 64)),
        Type::TF32    : Some(32),
        Type::TF64    : Some(64),
        _             : None,
    }
}

fn hinted(String m) : Result<void, String>
{
    Err(sprintf("diag.type-mismatch\u{1}%s", &m))
}

// The operand and target types `rule.arith.alt` and `rule.arith.convert`
// name (spec/06 §4, §5), per instantiation.
fn check_integer_intrinsic_operands(
    ref<Body, shared> b,
    StringView name,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    ref<Vec<Option<Type>>, shared> arg_tys,
) : Result<void, String>
{
    if (is_alt_intrinsic(name))
    {
        for (usize i = 0; i < Vec::len(arg_tys); i += 1)
        {
            match (&arg_tys[i])
            {
                Some(t) :
                {
                    if (!int_or_opaque(t))
                    {
                        return Err("diag.type-mismatch");
                    }
                },
                None    : {},
            }
        }
        // A bare literal takes its type from the other operand.
        match (arg_ty(arg_tys, 0))
        {
            Some(Type::TInt(a)) : match (arg_ty(arg_tys, 1))
            {
                Some(Type::TInt(c)) :
                {
                    if (a != c && !is_bare_num_literal(&args[0]) && !is_bare_num_literal(&args[1]))
                    {
                        return Err("diag.type-mismatch");
                    }
                },
                _                   : {},
            },
            _ : {},
        }
        return Ok(());
    }
    // D-0123: an integer operand; a rotation's amount is a `u32`.
    if (name == "count_ones" || name == "leading_zeros" || name == "trailing_zeros" || name == "rotate_left" || name == "rotate_right")
    {
        match (arg_ty(arg_tys, 0))
        {
            Some(t) :
            {
                if (!int_or_opaque(&t))
                {
                    String msg = sprintf(
                        "`%s` counts or rotates the bits of an integer; `%s` is not one",
                        name,
                        &type_display(&t),
                    );
                    return Err(named_diag("diag.type-mismatch", &msg));
                }
            },
            None    : {},
        }
        if (StringView::starts_with(name, "rotate"))
        {
            match (arg_ty(arg_tys, 1))
            {
                Some(k) :
                {
                    if (!opaque_or_never(&k) && !type_eq(&k, &Type::TInt(IntTy::U32)) && !is_bare_num_literal(&args[1]))
                    {
                        String msg = sprintf("`%s`'s amount is a `u32`, not `%s`", name, &type_display(&k));
                        return Err(named_diag("diag.type-mismatch", &msg));
                    }
                },
                None    : {},
            }
        }
        return Ok(());
    }
    bool convert = name == "widen" || name == "narrow" || name == "narrow_wrapping" || name == "reinterpret" || name == "to_float" || name == "to_int" || name == "checked_narrow";
    if (!convert)
    {
        return Ok(());
    }
    // `[T-Convert]`'s kind premises.
    bool is_narrow = name == "narrow" || name == "narrow_wrapping";
    match (arg_ty(arg_tys, 0))
    {
        Some(a) :
        {
            bool src_ok = if (name == "widen" || name == "reinterpret" || name == "to_float") { num_or_opaque(&a) } else if (name == "to_int") { float_or_opaque(&a) } else { int_or_opaque(&a) };
            if (!src_ok)
            {
                if (is_narrow && float_or_opaque(&a))
                {
                    return hinted(sprintf(
                        "`%s` converts between integer types, and this is `%s`: a float becomes an integer with `to_int<T>(x)`",
                        name,
                        &type_display(&a),
                    ));
                }
                if (name == "to_int" && !float_or_opaque(&a) && int_or_opaque(&a))
                {
                    return hinted(sprintf(
                        "`to_int` converts a float, and this is `%s`: between integer types use `narrow<T>(x)` or `widen<T>(x)`",
                        &type_display(&a),
                    ));
                }
                return hinted(sprintf("`%s` converts a number, not `%s`", name, &type_display(&a)));
            }
        },
        None    : {},
    }
    if (Vec::len(targs) == 0)
    {
        return Ok(());
    }
    Type t = apply_subst(&targs[0], &b.subst);
    bool dst_ok = if (name == "widen" || name == "reinterpret") { num_or_opaque(&t) } else if (name == "to_float") { float_or_opaque(&t) } else { int_or_opaque(&t) };
    if (!dst_ok)
    {
        String ts = type_display(&t);
        if (is_narrow && float_or_opaque(&t))
        {
            return hinted(sprintf(
                "`%s` gives an integer type, not `%s`: to get a float use `to_float<%s>(x)`",
                name,
                &ts,
                &ts,
            ));
        }
        if (name == "to_float" && !float_or_opaque(&t) && int_or_opaque(&t))
        {
            return hinted(sprintf(
                "`to_float` gives `f32` or `f64`, not `%s`: to get an integer from a float use `to_int<%s>(x)`",
                &ts,
                &ts,
            ));
        }
        if (name == "to_int" && float_or_opaque(&t))
        {
            return hinted(sprintf(
                "`to_int` gives an integer type, not `%s`: between floats use `widen<%s>(x)` or `to_float<%s>(x)`",
                &ts,
                &ts,
                &ts,
            ));
        }
        return hinted(sprintf("`%s<%s>`: `%s` is not a number type", name, &ts, &ts));
    }
    // The pair premises of `widen` and `reinterpret`.
    match (arg_ty(arg_tys, 0))
    {
        Some(src) :
        {
            bool bad = false;
            if (name == "widen")
            {
                match (&src)
                {
                    Type::TInt(si) : match (&t)
                    {
                        Type::TInt(di) :
                        {
                            u32 sw = int_ty_bits(*si, 64);
                            u32 dw = int_ty_bits(*di, 64);
                            bool ss = int_ty_signed(*si);
                            bool ds = int_ty_signed(*di);
                            bool fits = if (ss == ds) { sw <= dw } else if (!ss && ds) { sw < dw } else { false };
                            bad = !fits;
                        },
                        Type::TF32     : bad = true,
                        Type::TF64     : bad = true,
                        _              : {},
                    },
                    Type::TF64 : match (&t)
                    {
                        Type::TF32    : bad = true,
                        Type::TInt(_) : bad = true,
                        _             : {},
                    },
                    Type::TF32 : match (&t)
                    {
                        Type::TInt(_) : bad = true,
                        _             : {},
                    },
                    _ : {},
                }
            }
            else if (name == "reinterpret")
            {
                match (&src)
                {
                    Type::TInt(si) : match (&t)
                    {
                        Type::TInt(di) : bad = !option_u32_eq(
                            bitwidth_of(&src),
                            bitwidth_of(&t),
                        ) || int_ty_signed(*si) == int_ty_signed(*di),
                        Type::TF32 : bad = !option_u32_eq(bitwidth_of(&src), bitwidth_of(&t)),
                        Type::TF64 : bad = !option_u32_eq(bitwidth_of(&src), bitwidth_of(&t)),
                        _          : {},
                    },
                    Type::TF32 : match (&t)
                    {
                        Type::TF32    : bad = true,
                        Type::TF64    : bad = true,
                        Type::TInt(_) : bad = !option_u32_eq(bitwidth_of(&src), bitwidth_of(&t)),
                        _             : {},
                    },
                    Type::TF64 : match (&t)
                    {
                        Type::TF32    : bad = true,
                        Type::TF64    : bad = true,
                        Type::TInt(_) : bad = !option_u32_eq(bitwidth_of(&src), bitwidth_of(&t)),
                        _             : {},
                    },
                    _ : {},
                }
            }
            if (bad)
            {
                String ss = type_display(&src);
                String ts = type_display(&t);
                if (name == "widen")
                {
                    match (&src)
                    {
                        Type::TInt(_) : match (&t)
                        {
                            Type::TInt(_) : return hinted(sprintf(
                                "`widen` converts only where every value fits, and not every `%s` fits in `%s`: use `narrow<%s>(x)` (checked) or `narrow_wrapping<%s>(x)`",
                                &ss,
                                &ts,
                                &ts,
                                &ts,
                            )),
                            _ : return hinted(sprintf(
                                "`widen` does not turn an integer into a float: use `to_float<%s>(x)`",
                                &ts,
                            )),
                        },
                        Type::TF64 : match (&t)
                        {
                            Type::TF32 : return hinted("`widen` cannot shrink `f64` to `f32`: use `to_float<f32>(x)`"),
                            _          : {},
                        },
                        _ : {},
                    }
                    match (&t)
                    {
                        Type::TInt(_) : return hinted(sprintf(
                            "`widen` does not turn a float into an integer: use `to_int<%s>(x)` (checked)",
                            &ts,
                        )),
                        _ : {},
                    }
                }
                return hinted(sprintf(
                    "`reinterpret` keeps the bits, so `%s` and `%s` must have the same width and differ in signedness or in being a float",
                    &ss,
                    &ts,
                ));
            }
        },
        None      : {},
    }
    // `[Narrow-Overflow]`, `[Float-To-Int-Invalid]`: static where the
    // operand is constant.
    match (&t)
    {
        Type::TInt(di) :
        {
            if (Vec::len(args) > 0)
            {
                IntRange r = int_range(*di);
                String ts = type_display(&t);
                if (name == "narrow")
                {
                    match (fold_int(b, &args[0]))
                    {
                        Some(v) :
                        {
                            if (v < r.min || v > r.max)
                            {
                                String nhi = if (*di == IntTy::U128) { sprintf("%v", max_value<u128>()) } else { sprintf("%v", r.max) };
                                String msg = sprintf(
                                    "`narrow<%s>` of %v does not fit (`%s` is %v to %s); `narrow_wrapping<%s>` keeps the low bits",
                                    &ts,
                                    v,
                                    &ts,
                                    r.min,
                                    &nhi,
                                    &ts,
                                );
                                return Err(named_diag("diag.narrowing-overflow", &msg));
                            }
                        },
                        None    : {},
                    }
                }
                if (name == "to_int")
                {
                    Option<f64> lit = match (&strip_parens_tc(&args[0]).kind)
                    {
                        ExprKind::EFloat(fb) : Some(Box::get(fb).v),
                        ExprKind::EUnary(ub) : if (Box::get(ub).op == UnOp::Neg)
                        {
                            match (&strip_parens_tc(&Box::get(ub).e).kind)
                            {
                                ExprKind::EFloat(fb) : Some(-Box::get(fb).v),
                                _                    : None,
                            }
                        }
                        else { None },
                        _                    : None,
                    };
                    match (lit)
                    {
                        Some(x) :
                        {
                            f64 tr = trunc(x);
                            // Report 234: the bounds exactly, as powers of
                            // two (`max + 1` is one; `i64::MAX` as an `f64`
                            // rounds up to it, and `u128`'s is beyond `i128`).
                            u32 bw = int_ty_bits(*di, 64);
                            bool sgn = int_ty_signed(*di);
                            f64 top = 1.0;
                            for (u32 q = 0; q < (if (sgn) { bw - 1 } else { bw }); q += 1)
                            {
                                top = top * 2.0;
                            }
                            f64 bottom = if (sgn) { -top } else { 0.0 };
                            if (!is_finite(x) || tr < bottom || tr >= top)
                            {
                                // Rust's `{}` of an f64: no `.0` on a whole number.
                                String xs = rust_float_text(x);
                                String hi = if (*di == IntTy::U128) { sprintf("%v", max_value<u128>()) } else { sprintf("%v", r.max) };
                                String msg = sprintf(
                                    "`to_int<%s>` of %s does not fit (`%s` is %v to %s)",
                                    &ts,
                                    &xs,
                                    &ts,
                                    r.min,
                                    &hi,
                                );
                                return Err(named_diag("diag.narrowing-overflow", &msg));
                            }
                        },
                        None    : {},
                    }
                }
            }
        },
        _              : {},
    }
    Ok(())
}

fn option_u32_eq(Option<u32> a, Option<u32> c) : bool
{
    match (a)
    {
        Some(x) : match (c)
        {
            Some(y) : x == y,
            None    : false,
        },
        None : Option::is_none(&c),
    }
}

struct Bitfield
{
    u32 width;
    IntTy backing;
    String sname;
}

// D-0118: `e` is `base.f` with `base` a `bitstruct`: the field's width and
// the backing type.
fn bitfield_of(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> e) : Option<Bitfield>
{
    ref<FieldExpr, shared> fe = match (&strip_parens_tc(e).kind)
    {
        ExprKind::EField(fb) : Box::get(fb),
        _                    : return None,
    };
    Type bt = through_ref_or_guard(static_place_type(b, it, &fe.e)?);
    String sname = match (&bt)
    {
        Type::TNamed(nb) : String::clone(&Box::get(nb).name),
        _                : return None,
    };
    ref<StructDecl, shared> sd = HashMap::get(&it.structs, &sname)?;
    IntTy backing = sd.bits?;
    for (usize i = 0; i < Vec::len(&sd.fields); i += 1)
    {
        if (sd.fields[i].name == fe.name)
        {
            u32 w = sd.fields[i].width?;
            return Some(Bitfield { .width = w, .backing = backing, .sname = sname });
        }
    }
    None
}

// D-0118: a literal written into a bit field must fit its width.
fn check_bitfield_literal(
    ref<Body, shared> b,
    ref<Expr, shared> value,
    u32 width,
    ref<String, shared> what,
) : Result<void, String>
{
    Option<i128> v = match (literal_value(value))
    {
        Some(x) : Some(x),
        None    : fold_int(b, value),
    };
    match (v)
    {
        Some(x) :
        {
            i128 one = 1;
            i128 limit = if (width >= 127) { max_value<i128>() } else { (one << width) - 1 };
            if (x < 0 || x > limit)
            {
                String msg = sprintf("%s is %v bits wide, so it holds 0 to %v; %v does not fit", what, width, limit, x);
                return Err(named_diag("diag.narrowing-overflow", &msg));
            }
        },
        None    : {},
    }
    Ok(())
}

// D-0116: why `t` is not `clone`, or `None` when it is.
fn clone_problem(ref<Body, shared> b, ref<Items, shared> it, ref<Type, shared> t) : Option<String>
{
    HashSet<String> seen = HashSet::new();
    clone_problem_in(b, it, t, &mut seen)
}

// D-0257: why `t` is not `plain`, or `None` when it is.
fn plain_problem(ref<Body, shared> b, ref<Items, shared> it, ref<Type, shared> t) : Option<String>
{
    HashSet<String> seen = HashSet::new();
    plain_problem_in(b, it, t, &mut seen)
}

fn short_name(ref<String, shared> n) : StringView
{
    Option::unwrap_or(StringView::strip_prefix(n, "std::"), n)
}

fn plain_problem_in(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<Type, shared> t,
    ref<HashSet<String>, exclusive> seen,
) : Option<String>
{
    match (t)
    {
        Type::TNamed(nb)  :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (Vec::len(&n.args) == 0 && StringView::starts_with(&n.name, "$"))
            {
                bool plain = match (HashMap::get(&b.marker_bounds, &n.name))
                {
                    Some(bd) : *bd == Bound::BPlain,
                    None     : false,
                };
                if (plain)
                {
                    return None;
                }
                return Some(sprintf(
                    "type parameter `%s` is not declared `plain`",
                    &n.name[1..$],
                ));
            }
            if (is_resource_ty(it, t))
            {
                return Some(sprintf("`%s` is a resource", short_name(&n.name)));
            }
            if (!HashSet::insert(seen, type_code(t)))
            {
                return None;
            }
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(s) :
                {
                    HashMap<String, Type> subst = zip_subst(&s.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                    {
                        Type ft = apply_subst(&s.fields[i].ty, &subst);
                        match (plain_problem_in(b, it, &ft, seen))
                        {
                            Some(p) : return Some(sprintf(
                                "field `%s` of `%s`: %s",
                                &s.fields[i].name,
                                short_name(&n.name),
                                &p,
                            )),
                            None : {},
                        }
                    }
                    return None;
                },
                None    : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(e) :
                {
                    HashMap<String, Type> subst = zip_subst(&e.type_params, &n.args);
                    for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                    {
                        match (&e.variants[i].payload)
                        {
                            Some(pt) :
                            {
                                Type ft = apply_subst(pt, &subst);
                                match (plain_problem_in(b, it, &ft, seen))
                                {
                                    Some(p) : return Some(sprintf(
                                        "variant `%s` of `%s`: %s",
                                        &e.variants[i].name,
                                        short_name(&n.name),
                                        &p,
                                    )),
                                    None : {},
                                }
                            },
                            None     : {},
                        }
                    }
                    return None;
                },
                None    : {},
            }
            None
        },
        Type::TInt(_)     : None,
        Type::TF32        : None,
        Type::TF64        : None,
        Type::TBool       : None,
        Type::TRawptr(_)  : None,
        Type::TSimd(_)    : None,
        Type::TNever      : None,
        Type::TVoid       : Some("`void` is no data"),
        Type::TStr        : Some("`str` names text the program holds, not bytes of its own"),
        Type::TRef(_)     : Some("a reference reaches storage that is not its own"),
        Type::TSlice(_)   : Some("a reference reaches storage that is not its own"),
        Type::TFn(_)      : Some("a function value is not data"),
        Type::TClosure(_) : Some("a function value is not data"),
        Type::THandle(_)  : Some("a thread handle is not data"),
        Type::TMutex(_)   : Some("a mutex is not plain data"),
        Type::TGuard(_)   : Some("a lock guard is not plain data"),
        Type::TArray(ab)  : plain_problem_in(b, it, &Box::get(ab).inner, seen),
    }
}

fn clone_problem_in(
    ref<Body, shared> b,
    ref<Items, shared> it,
    ref<Type, shared> t,
    ref<HashSet<String>, exclusive> seen,
) : Option<String>
{
    match (t)
    {
        Type::TNamed(nb)  :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            if (Vec::len(&n.args) == 0 && StringView::starts_with(&n.name, "$"))
            {
                bool ok = match (HashMap::get(&b.marker_bounds, &n.name))
                {
                    Some(have) : bound_implies(*have, Bound::BClone),
                    None       : false,
                };
                if (ok)
                {
                    return None;
                }
                return Some(sprintf(
                    "type parameter `%s` is not declared `clone`",
                    &n.name[1..$],
                ));
            }
            if (!is_resource_ty(it, t))
            {
                if (holds_excl_ref(it, t, 0))
                {
                    return Some(sprintf("`%s` holds an exclusive reference, which has no clone", short_name(&n.name)));
                }
                return None;
            }
            if (!HashSet::insert(seen, type_code(t)))
            {
                return None;
            }
            String key = sprintf("%s::clone", &n.name);
            ref<FnDecl, shared> f = match (HashMap::get(&it.fns, &key))
            {
                Some(f) : f,
                None : return Some(sprintf(
                    "`%s` is a resource with no `%s::clone`",
                    short_name(&n.name),
                    short_name(&n.name),
                )),
            };
            if (f.derived)
            {
                Vec<String> params = match (HashMap::get(&it.structs, &n.name))
                {
                    Some(s) : Vec::clone(&s.type_params),
                    None : match (HashMap::get(&it.enums, &n.name))
                    {
                        Some(e) : Vec::clone(&e.type_params),
                        None    : Vec::new(),
                    },
                };
                HashMap<String, Type> m = zip_subst(&params, &n.args);
                match (HashMap::get(&it.structs, &n.name))
                {
                    Some(s) :
                    {
                        for (usize i = 0; i < Vec::len(&s.fields); i += 1)
                        {
                            match (clone_problem_in(b, it, &apply_subst(&s.fields[i].ty, &m), seen))
                            {
                                Some(p) : return Some(sprintf("its field `%s` is not: %s", &s.fields[i].name, &p)),
                                None    : {},
                            }
                        }
                        return None;
                    },
                    None    : {},
                }
                match (HashMap::get(&it.enums, &n.name))
                {
                    Some(e) :
                    {
                        for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                        {
                            match (&e.variants[i].payload)
                            {
                                Some(pt) : match (clone_problem_in(b, it, &apply_subst(pt, &m), seen))
                                {
                                    Some(p) : return Some(sprintf(
                                        "its variant `%s` holds a value that is not: %s",
                                        &e.variants[i].name,
                                        &p,
                                    )),
                                    None : {},
                                },
                                None : {},
                            }
                        }
                    },
                    None    : {},
                }
                return None;
            }
            for (usize i = 0; i < Vec::len(&f.type_params) && i < Vec::len(&f.type_bounds) && i < Vec::len(&n.args); i += 1)
            {
                Bound bd = match (f.type_bounds[i])
                {
                    Some(x) : x,
                    None    : continue,
                };
                ref<Type, shared> a = &n.args[i];
                ref<String, shared> tp = &f.type_params[i];
                Option<String> bad = None;
                if (bd == Bound::BClone)
                {
                    bad = clone_problem_in(b, it, a, seen);
                }
                else
                {
                    bool bare_marker = match (a)
                    {
                        Type::TNamed(ab) : Vec::len(&Box::get(ab).args) == 0 && StringView::starts_with(
                            &Box::get(ab).name,
                            "$",
                        ),
                        _ : false,
                    };
                    if (bare_marker)
                    {
                        String an = Option::expect(marker_of(a), "a marker");
                        bool ok = match (HashMap::get(&b.marker_bounds, &an))
                        {
                            Some(have) : bound_implies(*have, bd),
                            None       : false,
                        };
                        if (!ok)
                        {
                            bad = Some(sprintf("type parameter `%s` is not declared `%s`", tp, bound_name(bd)));
                        }
                    }
                    else if (!bound_holds(b, it, bd, a))
                    {
                        bad = Some(sprintf("`%s` is not `%s`", &type_display(a), bound_name(bd)));
                    }
                }
                match (bad)
                {
                    Some(p) : return Some(sprintf(
                        "`%s::clone` needs its `%s` to be `%s`: %s",
                        short_name(&n.name),
                        tp,
                        bound_name(bd),
                        &p,
                    )),
                    None : {},
                }
            }
            None
        },
        // D-0218: an exclusive reference copied out of a shared one.
        Type::TRef(rb)    :
        {
            if (Box::get(rb).mode == Mode::Exclusive)
            {
                return Some("an exclusive reference has no clone: a copy made through a shared reference could write what it reaches");
            }
            None
        },
        Type::TSlice(sb)  :
        {
            if (Box::get(sb).mode == Mode::Exclusive)
            {
                return Some("an exclusive reference has no clone: a copy made through a shared reference could write what it reaches");
            }
            None
        },
        Type::TArray(ab)  :
        {
            ref<Type, shared> e = &Box::get(ab).inner;
            if (is_resource_ty(it, e))
            {
                return Some(sprintf(
                    "an array of `%s` (a resource) has no clone; a `Vec` of them does",
                    &type_display(e),
                ));
            }
            clone_problem_in(b, it, e, seen)
        },
        Type::TFn(_)      : Some("a function value has no clone"),
        Type::TClosure(_) : Some("a function value has no clone"),
        Type::THandle(_)  : Some("a thread handle has no clone"),
        Type::TMutex(_)   : Some("a mutex has no clone"),
        Type::TGuard(_)   : Some("a lock guard has no clone"),
        _                 : None,
    }
}

fn check_known_intrinsic(ref<Body, shared> b, StringView name, ref<Vec<Type>, shared> targs) : Option<Type>
{
    Option<Type> t0 = if (Vec::len(targs) > 0) { Some(apply_subst(&targs[0], &b.subst)) } else { None };
    if (name == "sizeof" || name == "alignof")
    {
        return Some(Type::TInt(IntTy::Usize));
    }
    foreach (x in ["widen", "narrow", "narrow_wrapping", "reinterpret", "to_float", "to_int", "parse_value"])
    {
        if (name == x)
        {
            return t0;
        }
    }
    // D-0122: the narrowed value, or `None`.
    if (name == "checked_narrow")
    {
        return match (t0)
        {
            Some(t) :
            {
                Vec<Type> a = Vec::new();
                Vec::push(&mut a, t);
                Some(named("std::Option", a))
            },
            None    : None,
        };
    }
    // D-0123: a count of bits.
    if (name == "count_ones" || name == "leading_zeros" || name == "trailing_zeros")
    {
        return Some(Type::TInt(IntTy::U32));
    }
    foreach (x in [
        "write_volatile",
        "drop",
        "release",
        "copy_raw",
        "deallocate",
        "append_native",
        "swap_places",
        "lend_places",
    ])
    {
        if (name == x)
        {
            return Some(Type::TVoid);
        }
    }
    foreach (x in ["rawptr_of", "rawptr_from_address", "reinterpret_ptr", "dangling", "null_rawptr"])
    {
        if (name == x)
        {
            return match (t0)
            {
                Some(t) : Some(rawptr_of(t)),
                None    : None,
            };
        }
    }
    if (name == "rawptr_address" || name == "str_len" || name == "slice_len" || name == "text_write")
    {
        return Some(Type::TInt(IntTy::Usize));
    }
    // `[Allocate]` (spec/21 §3b): `Result<rawptr<u8>, AllocError>`.
    if (name == "allocate")
    {
        Vec<Type> a = Vec::new();
        Vec::push(&mut a, rawptr_of(Type::TInt(IntTy::U8)));
        Vec::push(&mut a, named("std::AllocError", Vec::new()));
        return Some(named("std::Result", a));
    }
    if (name == "str_byte")
    {
        return Some(Type::TInt(IntTy::U8));
    }
    if (name == "parse_check")
    {
        return Some(Type::TInt(IntTy::Isize));
    }
    if (name == "key_hash")
    {
        return Some(Type::TInt(IntTy::U64));
    }
    if (name == "key_eq" || name == "key_less" || name == "key_less_at")
    {
        return Some(Type::TBool);
    }
    if (name == "str_ptr")
    {
        return Some(rawptr_of(Type::TInt(IntTy::U8)));
    }
    // D-0134: a `str`'s bytes as a slice.
    if (name == "str_slice")
    {
        return Some(slice_of(Type::TInt(IntTy::U8), Mode::Shared));
    }
    None
}

// ---- part 9 ----

fn explicit_subst(ref<FnDecl, shared> f, ref<Vec<Type>, shared> explicit) : HashMap<String, Type>
{
    zip_subst(&f.type_params, explicit)
}

fn weakens_to(ref<Type, shared> arg, ref<Type, shared> param) : bool
{
    match (arg)
    {
        Type::TRef(a) : match (param)
        {
            Type::TRef(p) : Box::get(a).mode == Mode::Exclusive && Box::get(p).mode == Mode::Shared && type_eq(
                &Box::get(a).inner,
                &Box::get(p).inner,
            ),
            _ : false,
        },
        Type::TSlice(a) : match (param)
        {
            Type::TSlice(p) : Box::get(a).mode == Mode::Exclusive && Box::get(p).mode == Mode::Shared && type_eq(
                &Box::get(a).inner,
                &Box::get(p).inner,
            ),
            _ : false,
        },
        _ : false,
    }
}

// An integer literal without a type suffix (`300`, `-1`); `300: u16` has
// its suffix's type, here as everywhere (report 105).
fn is_bare_int_literal(ref<Expr, shared> e) : bool
{
    match (&e.kind)
    {
        ExprKind::EInt(lb) : unsuffixed_int(Box::get(lb)),
        ExprKind::EUnary(u) : Box::get(u).op == UnOp::Neg && match (&Box::get(u).e.kind)
        {
            ExprKind::EInt(lb) : unsuffixed_int(Box::get(lb)),
            _                  : false,
        },
        _                  : false,
    }
}

fn unsuffixed_int(ref<IntLit, shared> l) : bool
{
    match (&l.sfx)
    {
        Some(s) : *s == "byte",
        None    : true,
    }
}

fn all_fixed(ref<Vec<String>, shared> params, ref<HashMap<String, Type>, shared> m) : bool
{
    for (usize i = 0; i < Vec::len(params); i += 1)
    {
        if (!HashMap::contains(m, &params[i]))
        {
            return false;
        }
    }
    true
}

// Report 408: `Ok(x)`, `Err(e)` or `Some(x)` as written.
fn is_variant_literal_call(ref<Expr, shared> e) : bool
{
    match (&strip_parens_tc(e).kind)
    {
        ExprKind::ECall(cb) :
        {
            ref<CallExpr, shared> c = Box::get(cb);
            Vec::len(&c.args) == 1 && match (one_seg(&c.callee))
            {
                Some(n) : *n == "Ok" || *n == "Err" || *n == "Some",
                None    : false,
            }
        },
        _                   : false,
    }
}

fn check_user_call(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<String, shared> key,
    ref<Vec<Type>, shared> targs,
    ref<Vec<Expr>, shared> args,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    Option<Type> prop_err = replace(&mut b.propagate_err, None);
    ref<FnDecl, shared> f = Option::expect(HashMap::get(&it.fns, key), "a function");
    // `[T-Call]`: one argument per parameter.
    if (Vec::len(args) != Vec::len(&f.params))
    {
        String msg = sprintf(
            "`%s` takes %v argument%s, but %v %s given",
            &fn_shown(f),
            Vec::len(&f.params),
            plural(Vec::len(&f.params)),
            Vec::len(args),
            is_are(Vec::len(args)),
        );
        String r = sprintf("pass one argument for each of `%s`'s parameters, in their order", &fn_shown(f));
        return Err(mismatch(with_repair(&msg, &r)));
    }
    // D-0317 (`spec/14` §6, the requirement row): a requirement the call's
    // known arguments decide to be false rejects the program here.
    if (Vec::len(&f.requires) > 0 && b.report && !b.flow.unreachable)
    {
        check_requires_known(b, f, args)?;
    }
    Vec<Type> explicit = Vec::new();
    for (usize i = 0; i < Vec::len(targs); i += 1)
    {
        Vec::push(&mut explicit, apply_subst(&targs[i], &b.subst));
    }
    // Type arguments a function does not take.
    if (Vec::len(&explicit) > Vec::len(&f.type_params))
    {
        String std_key = sprintf("std::%s", &f_key(f));
        bool shadows = match (HashMap::get(&it.fns, &std_key))
        {
            Some(g) : std_key != *key && Vec::len(&g.type_params) > 0,
            None    : false,
        };
        String msg = if (Vec::len(&f.type_params) == 0)
        {
            sprintf("`%s` takes no type arguments", &fn_shown(f))
        }
        else
        {
            sprintf(
                "`%s` takes %v type argument%s, but %v %s given",
                &fn_shown(f),
                Vec::len(&f.type_params),
                plural(Vec::len(&f.type_params)),
                Vec::len(&explicit),
                is_are(Vec::len(&explicit)),
            )
        };
        String hint = if (shadows)
        {
            sprintf(
                "; this is the program's own `%s`, which hides `%s` — write `%s<…>(…)` for the standard one",
                &fn_shown(f),
                &std_key,
                &std_key,
            )
        }
        else { String::new() };
        return Err(mismatch(sprintf("%s%s", &msg, &hint)));
    }
    HashSet<String> type_param_set = HashSet::new();
    for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
    {
        HashSet::insert(&mut type_param_set, String::clone(&f.type_params[i]));
    }
    // D-0079: an unsuffixed literal argument whose parameter is not yet
    // known is checked after the others.
    HashMap<String, Type> ex_subst = explicit_subst(f, &explicit);
    Vec<bool> deferred = Vec::new();
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        // Report 408 (D-0339): so is a variant literal (`Ok(x)`, `Err(e)`,
        // `Some(x)`): the other arguments and the expected result fix the
        // type parameters it leaves open, and it is checked against them
        // (`map_ok(Ok(small), [](f64 x) …)` took `T` from the closure and
        // never compared it with `small`'s `u8`).
        bool d = Vec::len(&f.type_params) > 0 && (is_bare_num_literal(&args[i]) || is_bare_str_literal(&args[i]) || is_variant_literal_call(&args[i])) && i < Vec::len(&f.params) && mentions_any(
            &apply_subst(&f.params[i].ty, &ex_subst),
            &type_param_set,
        );
        Vec::push(&mut deferred, d);
    }
    Vec<usize> order = Vec::new();
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        if (!deferred[i])
        {
            Vec::push(&mut order, i);
        }
    }
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        if (deferred[i])
        {
            Vec::push(&mut order, i);
        }
    }
    Vec<Option<Type>> by_index = Vec::new();
    Vec<bool> checked = Vec::new();
    for (usize i = 0; i < Vec::len(args); i += 1)
    {
        Vec::push(&mut by_index, None);
        Vec::push(&mut checked, false);
    }
    bool ret_is_ref = match (&f.ret)
    {
        Type::TRef(_) : true,
        _             : false,
    };
    for (usize oi = 0; oi < Vec::len(&order); oi += 1)
    {
        usize i = order[oi];
        ref<Expr, shared> a = &args[i];
        // The type parameters the arguments already checked have fixed
        // count as known.
        HashMap<String, Type> known = explicit_subst(f, &explicit);
        for (usize j = 0; j < Vec::len(&by_index); j += 1)
        {
            if (checked[j] && j < Vec::len(&f.params))
            {
                match (&by_index[j])
                {
                    Some(t) :
                    {
                        if (!has_unresolved_marker(t))
                        {
                            unify_type_shape(&f.params[j].ty, t, &mut known, &f.type_params);
                        }
                    },
                    None    : {},
                }
            }
        }
        if (deferred[i])
        {
            match (expected)
            {
                Some(exp) :
                {
                    if (!has_unresolved_marker(exp))
                    {
                        unify_type_shape(&f.ret, exp, &mut known, &f.type_params);
                    }
                },
                None      : {},
            }
            // Report 181: under `?`, a `Result`'s error type parameter is the
            // error the enclosing function passes on.
            match (&prop_err)
            {
                Some(pe) :
                {
                    if (named_is(&f.ret, "std::Result"))
                    {
                        Vec<Type> ra = named_args(&f.ret);
                        if (Vec::len(&ra) == 2)
                        {
                            unify_type_shape(&ra[1], pe, &mut known, &f.type_params);
                        }
                    }
                },
                None     : {},
            }
        }
        Option<Type> raw_hint = if (i < Vec::len(&f.params))
        {
            Some(apply_subst(
                &f.params[i].ty,
                &known,
            ))
        }
        else { None };
        bool poisoned = match (&raw_hint)
        {
            Some(t) : mentions_any(t, &type_param_set),
            None    : true,
        };
        // `rule.type.expected` (report 340): a variant or struct literal
        // argument whose parameter the other arguments leave open takes it
        // from the expected result: `Box<Option<u64>> c = Box::new(Some(3))`.
        if (poisoned && !deferred[i] && i < Vec::len(&f.params) && Option::is_some(&literal_operand_expected(b, it, a, &Some(Type::TBool))))
        {
            match (expected)
            {
                Some(exp) :
                {
                    if (!has_unresolved_marker(exp))
                    {
                        HashMap<String, Type> k2 = clone(&known);
                        unify_type_shape(&f.ret, exp, &mut k2, &f.type_params);
                        Type h2 = apply_subst(&f.params[i].ty, &k2);
                        if (!mentions_any(&h2, &type_param_set))
                        {
                            raw_hint = Some(h2);
                            poisoned = false;
                        }
                    }
                },
                None      : {},
            }
        }
        // `[T-Bound-Literal]` (report 338): a bare integer literal whose
        // parameter the other arguments (or the expected result) fix as the
        // enclosing generic's own `number` type parameter is of that type:
        // `max(x, 0)`, `Vec::push(v, 0)`, `Vec<T> v = Vec::filled(n, 0)`.
        if (poisoned && deferred[i] && is_bare_num_literal(a) && i < Vec::len(&f.params))
        {
            Option<Type> mh = bound_literal_hint(b, f, &by_index, &checked, &explicit, expected, i);
            if (Option::is_some(&mh))
            {
                raw_hint = mh;
                poisoned = false;
            }
        }
        Option<Type> hint = if (poisoned) { None } else { raw_hint };
        bool saved = b.infer_poisoned;
        if (poisoned)
        {
            b.infer_poisoned = true;
        }
        // D-0162: a text literal whose parameter is `String` once the
        // type parameters are fixed is that `String`.
        if (deferred[i] && is_bare_str_literal(a))
        {
            bool wants_string = match (&hint)
            {
                Some(t) : is_std_string(t),
                None    : false,
            };
            note_literal_as_string(b, a, wants_string);
            if (wants_string)
            {
                b.infer_poisoned = saved;
                by_index[i] = clone(&hint);
                checked[i] = true;
                continue;
            }
        }
        // Report 190: a temporary given where the result cannot reach it
        // (a `probe<K>`, never kept; a parameter its `from` clause leaves
        // out) is borrowed for the statement, as for a plain result.
        bool unkept = i < Vec::len(&f.params) && (is_probe(&f.params[i].ty) || (Vec::len(&f.source) > 0 && !Vec::contains(
            &f.source,
            &f.params[i].name,
        )));
        b.arg_temp_ok = !ret_is_ref || unkept;
        b.arg_ref_param = i < Vec::len(&f.params) && match (&f.params[i].ty)
        {
            Type::TRef(_)   : true,
            Type::TSlice(_) : true,
            _               : false,
        };
        Result<Option<Type>, String> r = check_store_operand(b, it, a, &hint);
        b.arg_temp_ok = false;
        b.arg_ref_param = false;
        b.infer_poisoned = saved;
        by_index[i] = r?;
        checked[i] = true;
    }
    Vec<Option<Type>> arg_types = by_index;
    // D-0312 §4: the text lints of `--check` (`String::copy` of a literal
    // where a `String` is declared, or of a whole `String`).
    if (text_lints_on() && !b.facts.silent && b.module_ != "std" && !StringView::starts_with(&b.module_, "std::") && *key == "std::String::copy" && Vec::len(args) == 1)
    {
        ref<Expr, shared> a = strip_parens_tc(&args[0]);
        bool lit = match (&a.kind)
        {
            ExprKind::EStr(_) : true,
            _                 : false,
        };
        bool wants_string = match (expected)
        {
            Some(t) : plain_named_ty(t, "std::String"),
            None    : false,
        };
        if (lit && wants_string && args[0].id != b.borrowed_call_arg)
        {
            Vec::push(&mut b.facts.retired_notes, RetiredNote { .line = a.line, .col = a.col, .text = "warning[diag.text-copy-literal]: a literal is the `String` where one is declared (`[Coerce-Text]`): write the literal, not `String::copy(\"…\")`" });
        }
        else
        {
            match (&a.kind)
            {
                ExprKind::EBorrow(bb) :
                {
                    bool whole = Box::get(bb).mode == Mode::Shared && match (static_place_type(b, it, &Box::get(bb).e))
                    {
                        Some(t) : plain_named_ty(&t, "std::String"),
                        None    : false,
                    };
                    if (whole)
                    {
                        Vec::push(&mut b.facts.retired_notes, RetiredNote { .line = a.line, .col = a.col, .text = "warning[diag.text-copy-whole]: `String::copy(&s)` copies a whole `String`: write `String::clone(&s)`" });
                    }
                },
                _                     : {},
            }
        }
    }
    if (Vec::len(&f.type_params) == 0)
    {
        // D-0006: every argument's type exactly matches its parameter.
        check_arg_exact_types(b, it, key, &f.params, args, &arg_types, &HashMap::new(), &type_param_set)?;
        record_instantiation(b, key, &Vec::new());
        return Ok(Some(clone(&f.ret)));
    }
    HashMap<String, Type> m = HashMap::new();
    for (usize i = 0; i < Vec::len(&f.type_params) && i < Vec::len(&explicit); i += 1)
    {
        HashMap::insert(&mut m, String::clone(&f.type_params[i]), clone(&explicit[i]));
    }
    if (!all_fixed(&f.type_params, &m))
    {
        for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(&arg_types); i += 1)
        {
            match (&arg_types[i])
            {
                Some(at) : unify_type_shape(&f.params[i].ty, at, &mut m, &f.type_params),
                None     : {},
            }
        }
    }
    if (!all_fixed(&f.type_params, &m))
    {
        match (expected)
        {
            Some(exp) : unify_type_shape(&f.ret, exp, &mut m, &f.type_params),
            None      : {},
        }
    }
    // D-0006: every concrete parameter, after what substitution is known.
    check_arg_exact_types(b, it, key, &f.params, args, &arg_types, &m, &type_param_set)?;
    if (all_fixed(&f.type_params, &m))
    {
        Vec<Type> targs_c = Vec::new();
        for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
        {
            Vec::push(&mut targs_c, clone(Option::expect(HashMap::get(&m, &f.type_params[i]), "a type argument")));
        }
        // `[Append-Not-Printable]`, `[Parse-Not-Numeric]` (spec/21 §2d):
        // `T` checked at the call.
        if (Vec::len(&targs_c) > 0 && !has_unresolved_marker(&targs_c[0]))
        {
            match (call_bound_problem(it, key, f, &targs_c))
            {
                Some(msg) : return Err(mismatch(msg)),
                None      : {},
            }
        }
        // D-0090: each bounded type parameter's type satisfies its bound.
        for (usize i = 0; i < Vec::len(&f.type_params) && i < Vec::len(&f.type_bounds) && i < Vec::len(&targs_c); i += 1)
        {
            Bound bd = match (f.type_bounds[i])
            {
                Some(x) : x,
                None    : continue,
            };
            ref<Type, shared> t = &targs_c[i];
            bool bare_marker = match (t)
            {
                Type::TNamed(nb) : Vec::len(&Box::get(nb).args) == 0 && StringView::starts_with(&Box::get(nb).name, "$"),
                _                : false,
            };
            bool ok = false;
            Option<String> why = None;
            if (bare_marker)
            {
                ok = match (HashMap::get(&b.marker_bounds, &Option::expect(marker_of(t), "a marker")))
                {
                    Some(have) : bound_implies(*have, bd),
                    None       : false,
                };
            }
            else if (bd == Bound::BClone)
            {
                why = clone_problem(b, it, t);
                ok = Option::is_none(&why);
            }
            else if (bd == Bound::BPlain)
            {
                why = plain_problem(b, it, t);
                ok = Option::is_none(&why);
            }
            else
            {
                ok = bound_holds(b, it, bd, t);
                // Bug 163: the field that keeps a struct or enum out.
                bool named = match (t)
                {
                    Type::TNamed(_) : true,
                    _               : false,
                };
                if (!ok && named && (bd == Bound::BEq || bd == Bound::BOrdered))
                {
                    why = key_type_problem(it, t, 0);
                }
            }
            if (!ok)
            {
                String what = if (bare_marker)
                {
                    String mn = Option::expect(marker_of(t), "a marker");
                    String declared = match (HashMap::get(&b.marker_bounds, &mn))
                    {
                        Some(h) : sprintf(" (declared `%s`)", bound_name(*h)),
                        None    : " (declared without a bound)",
                    };
                    sprintf(
                        "type parameter `%s`%s",
                        &mn[1..$],
                        &declared,
                    )
                }
                else
                {
                    sprintf("`%s`", &type_display(t))
                };
                String tail = match (why)
                {
                    Some(w) : sprintf(": %s", &w),
                    None    : String::new(),
                };
                return Err(mismatch(sprintf(
                    "`%s` needs its `%s` to be `%s` (%s), and %s is not%s",
                    &f.name,
                    &f.type_params[i],
                    bound_name(bd),
                    bound_members(bd),
                    &what,
                    &tail,
                )));
            }
        }
        record_instantiation(b, key, &targs_c);
        return Ok(Some(apply_subst(&f.ret, &m)));
    }
    bool any_none = false;
    for (usize i = 0; i < Vec::len(&arg_types); i += 1)
    {
        if (Option::is_none(&arg_types[i]))
        {
            any_none = true;
        }
    }
    bool expected_open = match (expected)
    {
        Some(t) : has_unresolved_marker(t),
        None    : false,
    };
    // An expected type not yet fixed (or a poisoned hint) can fix only a
    // parameter the result mentions (session finding 010-A1:
    // `Vec::len(&Result::unwrap(o))` with `o` an `Option`).
    bool ret_fixes = true;
    for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
    {
        if (!HashMap::contains(&m, &f.type_params[i]))
        {
            HashSet<String> one = HashSet::new();
            HashSet::insert(&mut one, String::clone(&f.type_params[i]));
            if (!mentions_any(&f.ret, &one))
            {
                ret_fixes = false;
            }
        }
    }
    if (((b.infer_poisoned || expected_open) && ret_fixes) || any_none)
    {
        // Not decidable by this pass, unless every argument it leaves
        // untyped is itself a value nothing types and nothing outside can fix
        // the rest (CHG-0438: `id(Vec::new())`).
        bool unfixed = false;
        for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
        {
            if (!HashMap::contains(&m, &f.type_params[i]))
            {
                unfixed = true;
            }
        }
        bool all_open = true;
        for (usize i = 0; i < Vec::len(&arg_types) && i < Vec::len(args); i += 1)
        {
            if (Option::is_none(&arg_types[i]) && !open_ctor(b, it, &args[i]))
            {
                all_open = false;
            }
        }
        if (unfixed && !(b.infer_poisoned || expected_open) && all_open && any_none)
        {
            return Err(named_diag(
                "diag.cannot-infer-type-parameter",
                &sprintf(
                    "nothing here fixes the type parameters of `%s`: an argument is a value nothing types (`None`, `[]`, `Vec::new()`); declare its type, or write the type arguments",
                    &f_key(f),
                ),
            ));
        }
        // Not decidable by this pass.
        return Ok(None);
    }
    // `[Generic-Call-Uninferable]` (spec/15 §5).
    Vec<String> open = Vec::new();
    for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
    {
        if (!HashMap::contains(&m, &f.type_params[i]))
        {
            Vec::push(&mut open, sprintf("`%s`", &f.type_params[i]));
        }
    }
    String fname = f_key(f);
    Option<String> hint = None;
    // The usual cause: a value passed where the parameter is a reference.
    for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(&arg_types) && Option::is_none(&hint); i += 1)
    {
        match (&f.params[i].ty)
        {
            Type::TRef(pb) : match (&arg_types[i])
            {
                Some(t) :
                {
                    bool refish = match (t)
                    {
                        Type::TRef(_)   : true,
                        Type::TSlice(_) : true,
                        _               : false,
                    };
                    if (!refish)
                    {
                        bool excl = Box::get(pb).mode == Mode::Exclusive;
                        hint = Some(sprintf(
                            "argument %v is `%s`, not a reference, but `%s` takes %s: pass `%s…`",
                            i + 1,
                            &type_display(t),
                            &fname,
                            if (excl) { "an exclusive reference there" } else { "a reference there" },
                            if (excl) { "&mut " } else { "&" },
                        ));
                    }
                },
                None    : {},
            },
            _ : {},
        }
    }
    // Or an argument of another type altogether than its parameter (bug
    // 117: behind a reference too, `Result::is_ok(&o)` of an `Option`): a
    // type mismatch, not a type parameter left open.
    for (usize i = 0; i < Vec::len(&f.params) && i < Vec::len(&arg_types) && Option::is_none(&hint); i += 1)
    {
        ref<Type, shared> pt = match (&f.params[i].ty)
        {
            Type::TRef(rb) : &Box::get(rb).inner,
            other          : other,
        };
        Option<Type> at = match (&arg_types[i])
        {
            Some(Type::TRef(rb)) : match (&f.params[i].ty)
            {
                Type::TRef(_) : Some(clone(&Box::get(rb).inner)),
                _             : clone(&arg_types[i]),
            },
            other : clone(other),
        };
        match (pt)
        {
            Type::TNamed(pnb) : match (&at)
            {
                Some(t) :
                {
                    ref<String, shared> pn = &Box::get(pnb).name;
                    bool same_name = match (t)
                    {
                        Type::TNamed(anb) : ((Box::get(anb).name) == *pn),
                        _                 : false,
                    };
                    if (!HashSet::contains(&type_param_set, pn) && !has_unresolved_marker(t) && !same_name)
                    {
                        // Bug 306: the argument's type as given, a
                        // reference too.
                        String given = match (&arg_types[i])
                        {
                            Some(g) : type_display(g),
                            None    : type_display(t),
                        };
                        String msg = sprintf(
                            "argument %v is `%s`, but `%s` takes `%s` there%s",
                            i + 1,
                            &given,
                            &fname,
                            &type_display(&f.params[i].ty),
                            &family_hint(it, &fname, t),
                        );
                        return Err(mismatch(with_repair(&msg, "")));
                    }
                },
                None    : {},
            },
            _ : {},
        }
    }
    String advice = match (hint)
    {
        Some(h) : h,
        None : sprintf(
            "write `%s<%s>(…)`, or use the result where its type is declared",
            &fname,
            &String::join(&f.type_params, ", "),
        ),
    };
    Err(sprintf(
        "diag.cannot-infer-type-parameter\u{1}nothing here fixes %s of `%s`: %s",
        &String::join(&open, " and "),
        &fname,
        &advice,
    ))
}

// Bug 117: the function of the argument's own type that does what `fname`
// does for its type: `Option::is_some` for `Result::is_ok`.
fn family_hint(ref<Items, shared> it, ref<String, shared> fname, ref<Type, shared> arg) : String
{
    String an = match (arg)
    {
        Type::TNamed(nb) : String::clone(&Box::get(nb).name),
        _                : return String::new(),
    };
    StringView last = fname;
    match (last_path_sep(fname))
    {
        Some(k) : last = &fname[k + 2..$],
        None    : {},
    }
    StringView mapped = if (an == "std::Option" && last == "is_ok") { "is_some" } else if (an == "std::Option" && last == "is_err") { "is_none" } else if (an == "std::Result" && last == "is_some") { "is_ok" } else if (an == "std::Result" && last == "is_none") { "is_err" } else { last };
    String f = sprintf("%s::%v", &an, mapped);
    if (HashMap::contains(&it.fns, &f))
    {
        StringView sn = Option::unwrap_or(StringView::strip_prefix(&an, "std::"), &an);
        str article = if (StringView::starts_with(sn, "O") || StringView::starts_with(sn, "A") || StringView::starts_with(sn, "E") || StringView::starts_with(sn, "I") || StringView::starts_with(sn, "U")) { "an" } else { "a" };
        return sprintf("; for %v `%s` use `%s`", article, sn, Option::unwrap_or(StringView::strip_prefix(&f, "std::"), &f));
    }
    String::new()
}

// The checks `check_user_call` makes of a `std` function's `T` at the call
// (`[Append-Not-Printable]`, `[Parse-Not-Numeric]`, sorting, `[Key-Not-
// Hashable]`).
fn call_bound_problem(
    ref<Items, shared> it,
    ref<String, shared> key,
    ref<FnDecl, shared> f,
    ref<Vec<Type>, shared> targs_c,
) : Option<String>
{
    ref<Type, shared> t = &targs_c[0];
    if (*key == "std::String::append")
    {
        if (is_printable(t))
        {
            return None;
        }
        if (named_is(t, "std::String"))
        {
            return Some("`String::append` takes a `String` by reference, not by value: `String::append(&mut out, &s)` (a call's result too: `&sprintf(...)`)");
        }
        match (t)
        {
            Type::TRef(rb)   :
            {
                // Bug 084: `&s` of a binder that is already a reference.
                match (&Box::get(rb).inner)
                {
                    Type::TRef(ib) :
                    {
                        if (named_is(&Box::get(ib).inner, "std::String"))
                        {
                            return Some(sprintf(
                                "`String::append` takes a `String` by reference, and this `%s` is a reference to one: it is already a reference (a binder of `match (&o)` or `foreach (x in &v)` is one), so write it without `&`",
                                &type_display(t),
                            ));
                        }
                    },
                    _              : {},
                }
                if (is_printable(&Box::get(rb).inner))
                {
                    return Some(sprintf(
                        "`String::append` takes a `String` by reference, and anything else it writes by value: pass `*r` for this `%s`",
                        &type_display(t),
                    ));
                }
            },
            Type::TNamed(nb) :
            {
                // Report 159: an enum's variant name is written by `%v`.
                if (HashMap::contains(&it.enums, &Box::get(nb).name) && !named_is(t, "std::Option") && !named_is(t, "std::Result"))
                {
                    return Some(sprintf(
                        "`String::append` writes a number, a `bool`, a `str`, a `StringView` or a `String` by reference, not an enum such as `%s`; `String::appendf(&mut s, \"%%v\", x)` writes its variant's name",
                        &type_display(t),
                    ));
                }
            },
            _                : {},
        }
        return Some(sprintf(
            "`String::append` writes a number, a `bool`, a `str` or a `StringView`, or a `String` by reference (`&s`); `%s` is none of these",
            &type_display(t),
        ));
    }
    if (*key == "std::StringView::parse")
    {
        // D-0181: `bool` too.
        bool ok = match (t)
        {
            Type::TInt(_) : true,
            Type::TF32    : true,
            Type::TF64    : true,
            Type::TBool   : true,
            _             : false,
        };
        return if (ok) { None } else
        {
            Some(sprintf(
                "`StringView::parse` reads a number or a `bool`; `%s` is neither",
                &type_display(t),
            ))
        };
    }
    if (*key == "std::Vec::sort" || *key == "std::Vec::binary_search")
    {
        if (is_sort_type(it, t))
        {
            return None;
        }
        return Some(sprintf(
            "`Vec::%s` orders by the key types' own order (integers, `bool`, `str`, `String`, and structs and enums of them) or a float's; `%s` is not one%s, so pass the order: `Vec::%s_by`",
            &f.name,
            &type_display(t),
            &key_problem_text(it, t),
            &f.name,
        ));
    }
    if (*key == "std::PriorityQueue::new")
    {
        if (is_sort_type(it, t))
        {
            return None;
        }
        return Some(sprintf(
            "`PriorityQueue::new` orders by the key types' own order (integers, `bool`, `str`, `String`, and structs and enums of them) or a float's; `%s` is not one%s, so pass the order: `PriorityQueue::new_by`",
            &type_display(t),
            &key_problem_text(it, t),
        ));
    }
    match (&f.assoc_type)
    {
        Some(a) :
        {
            if ((*a == "HashMap" || *a == "HashSet") && (*key == sprintf("std::%s::%s", a, &f.name)))
            {
                // `[Key-Not-Hashable]` (spec/21 §1a): `K` at every call.
                for (usize i = 0; i < Vec::len(&f.type_params); i += 1)
                {
                    if (f.type_params[i] == "K")
                    {
                        ref<Type, shared> k = &targs_c[i];
                        if (!has_unresolved_marker(k) && !is_key_type(it, k))
                        {
                            return Some(sprintf(
                                "a `%s` key is an integer, `bool`, `str`, `String`, or a struct or enum of them; `%s` is not one%s",
                                a,
                                &type_display(k),
                                &key_problem_text(it, k),
                            ));
                        }
                        return None;
                    }
                }
            }
        },
        None    : {},
    }
    None
}

// Bug 123: when argument `i` and another integer argument each have the
// other's parameter type, the two look swapped: the hint says so before any
// conversion (converting both compiles and does the wrong thing).
fn swapped_hint(
    ref<Vec<Expr>, shared> args,
    ref<Vec<Option<Type>>, shared> arg_types,
    ref<Vec<ParamDecl>, shared> params,
    ref<HashMap<String, Type>, shared> subst,
    usize i,
    String otherwise,
) : String
{
    Option<Type> ai = arg_ty(arg_types, i);
    Type pi = apply_subst(&params[i].ty, subst);
    for (usize j = 0; j < Vec::len(params) && j < Vec::len(args); j += 1)
    {
        if (j == i)
        {
            continue;
        }
        Option<Type> aj = arg_ty(arg_types, j);
        Type pj = apply_subst(&params[j].ty, subst);
        bool ints = match (&pi)
        {
            Type::TInt(_) : match (&pj)
            {
                Type::TInt(_) : true,
                _             : false,
            },
            _ : false,
        };
        if (!ints || type_eq(&pi, &pj))
        {
            continue;
        }
        match (&ai)
        {
            Some(x) : match (&aj)
            {
                Some(y) :
                {
                    if (type_eq(x, &pj) && type_eq(y, &pi))
                    {
                        usize lo = min(i, j);
                        usize hi = max(i, j);
                        return sprintf(
                            "; arguments %v (`%s`) and %v (`%s`) look swapped: each has the other's parameter type",
                            lo + 1,
                            &params[lo].name,
                            hi + 1,
                            &params[hi].name,
                        );
                    }
                },
                None    : {},
            },
            None : {},
        }
    }
    otherwise
}

// D-0006: a concrete parameter type exactly matches its argument's type.
fn check_arg_exact_types(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    StringView fkey,
    ref<Vec<ParamDecl>, shared> params,
    ref<Vec<Expr>, shared> args,
    ref<Vec<Option<Type>>, shared> arg_types,
    ref<HashMap<String, Type>, shared> subst,
    ref<HashSet<String>, shared> type_param_set,
) : Result<void, String>
{
    for (usize i = 0; i < Vec::len(params); i += 1)
    {
        ref<ParamDecl, shared> p = &params[i];
        // A value where the parameter is a reference is wrong whatever the
        // type parameters are.
        match (&p.ty)
        {
            Type::TRef(rb) :
            {
                Option<String> shown = match (arg_ty(arg_types, i))
                {
                    Some(at) :
                    {
                        bool skip = match (&at)
                        {
                            Type::TRef(_) : true,
                            Type::TNever  : true,
                            _             : is_marker(&at),
                        };
                        if (skip) { None } else { Some(sprintf("`%s`", &type_display(&at))) }
                    },
                    None     :
                    {
                        if (i < Vec::len(arg_types) && i < Vec::len(args) && plainly_a_value(
                            b,
                            it,
                            &args[i],
                        )) { Some("a value") } else { None }
                    },
                };
                match (shown)
                {
                    Some(sh) :
                    {
                        bool excl = Box::get(rb).mode == Mode::Exclusive;
                        Type pty2 = apply_subst(&p.ty, subst);
                        // D-0312: text where a `String` reference is declared cannot
                        // be borrowed into one; the repair names what can.
                        bool text_arg = match (arg_ty(arg_types, i))
                        {
                            Some(at) : matches_str(&at) || plain_named_ty(&at, "std::StringView"),
                            None     : false,
                        } || (i < Vec::len(args) && match (&strip_parens_tc(&args[i]).kind)
                        {
                            ExprKind::EStr(_) : true,
                            _                 : false,
                        });
                        bool to_string_ref = match (&pty2)
                        {
                            Type::TRef(pb) : plain_named_ty(&Box::get(pb).inner, "std::String"),
                            _              : false,
                        };
                        if (text_arg && to_string_ref)
                        {
                            str how = if (excl)
                            {
                                "a `String` to write is borrowed `&mut s`: bind one first (`String s = …;`)"
                            }
                            else
                            {
                                "a function that reads text takes a `StringView`, and the text is passed as it is; a `String` place is borrowed `&s`, and `String::copy(…)` makes one"
                            };
                            String msg = sprintf(
                                "argument %v (`%s`) is %s, not a reference, but the parameter is `%s`: %s",
                                i + 1,
                                &p.name,
                                &sh,
                                &type_display(&pty2),
                                how,
                            );
                            return Err(mismatch(with_repair(&msg, "")));
                        }
                        // Bug 072: the parameter as this argument makes it,
                        // not as the other arguments' literals would.
                        Type pty_shown = match (arg_ty(arg_types, i))
                        {
                            Some(at) :
                            {
                                bool same_head = match (&Box::get(rb).inner)
                                {
                                    Type::TNamed(pn) : named_is(&at, &Box::get(pn).name),
                                    _                : false,
                                };
                                if (same_head) { ref_of(at, Box::get(rb).mode) } else { pty2 }
                            },
                            None     : pty2,
                        };
                        String msg = sprintf(
                            "argument %v (`%s`) is %s, not a reference, but the parameter is `%s`: pass `%s…`",
                            i + 1,
                            &p.name,
                            &sh,
                            &type_display(&pty_shown),
                            if (excl) { "&mut " } else { "&" },
                        );
                        return Err(mismatch(with_repair(&msg, "")));
                    },
                    None     : {},
                }
            },
            _              : {},
        }
        Type pty = apply_subst(&p.ty, subst);
        // D-0312: a probe whose argument is a marker (`probe<$K>`, a generic
        // body checked before its instantiations) is judged in each
        // instantiation, where it is a type.
        if (mentions_any(&pty, type_param_set) || is_probe(&pty))
        {
            continue;
        }
        // A bare integer literal takes the parameter's type where it could.
        // An integer literal is not a float (D-0006, CHG-0438).
        bool literal_fits = match (&pty)
        {
            Type::TInt(_)    : true,
            Type::TNamed(nb) : Vec::len(&Box::get(nb).args) == 0 && StringView::starts_with(&Box::get(nb).name, "$"),
            _                : false,
        };
        if (i < Vec::len(args) && is_bare_int_literal(&args[i]) && literal_fits)
        {
            continue;
        }
        match (arg_ty(arg_types, i))
        {
            Some(at) :
            {
                // Report 242: a `str` (a literal) where a `StringView` key's
                // probe, a `ref<StringView, shared>`, is declared is a
                // borrowed view of it: `Vec::contains(&words, "fig")` is
                // `Vec::contains(&words, &StringView::of("fig"))`.
                if (i < Vec::len(args) && matches_str(&at) && is_probe(&p.ty) && is_shared_ref_to_view(&pty) && HashMap::len(&b.subst) == 0)
                {
                    note_rewrite(b, &args[i], Rewrite::ProbeViewRef);
                    continue;
                }
                bool to_slice = match (&pty)
                {
                    Type::TSlice(_) : true,
                    _               : false,
                };
                if (type_eq(&pty, &at) && i < Vec::len(args))
                {
                    whole_slice_lint(b, it, &pty, &args[i]);
                }
                // D-0312: the type `[Coerce-Text]` judges is the resolved one for a
                // `String` reference, a slice and a probe (`probe<String>` is a
                // `StringView`); the declared one otherwise, so a type parameter
                // fixed as `StringView` admits nothing.
                ref<Type, shared> want = if (is_shared_string_ref(&pty) || to_slice || is_probe(&p.ty)) { &pty } else { &p.ty };
                if (!type_eq(&pty, &at) && !weakens_to(&at, &pty) && !(i < Vec::len(args) && view_of_text(b, it, want, &at, &args[i])))
                {
                    Option<ref<Expr, shared>> ae = if (i < Vec::len(args)) { Some(&args[i]) } else { None };
                    // Bug 053: `pow`'s exponent is a whole number.
                    bool float_exp = p.name == "exp" && match (&pty)
                    {
                        Type::TInt(_) : true,
                        _             : false,
                    } && is_float_type(&at);
                    // Bug 241: a key held by reference in generic code: the
                    // `_ref` lookup takes it for every key type, where `*k`
                    // and `k` each fit only some.
                    String ref_fn = sprintf("%s_ref", fkey);
                    bool generic_probe = HashMap::len(&b.subst) > 0 && is_probe(&p.ty) && StringView::len(fkey) > 0 && HashMap::contains(&it.fns, &ref_fn);
                    String hint = if (float_exp)
                    {
                        "; `pow` takes a whole-number exponent: for a floating-point exponent use `powf(x, y)` (converting the exponent would drop its fraction)"
                    }
                    else if (StringView::ends_with(fkey, "::clone") && has_unresolved_marker(&at))
                    {
                        // Bug 253: `String::clone(&xs[0])` in generic code.
                        "; a value of a type parameter is copied in generic code with `clone(&…)`, which the bound `clone` gives"
                    }
                    else if (generic_probe)
                    {
                        String held = match (ae)
                        {
                            Some(x) : match (&strip_parens_tc(x).kind)
                            {
                                ExprKind::EDeref(d) : arg_text(Box::get(d)),
                                _                   : arg_text(x),
                            },
                            None : "k",
                        };
                        sprintf(
                            "; a key held by reference is looked up in generic code with `%s(…, %s)`, which takes a `ref<K, shared>` for every key type (`*%s` fits only some)",
                            Option::unwrap_or(StringView::strip_prefix(&ref_fn, "std::"), &ref_fn),
                            &held,
                            &held,
                        )
                    }
                    else if (is_probe(&p.ty) && HashMap::len(&b.subst) > 0)
                    {
                        // Report 342: a probe has no one spelling for every
                        // key type; the `_ref` forms take `&k` for any.
                        sprintf(
                            "%s; in generic code, a key held as `K` is looked up with the `_ref` form, which takes `&k` for every key type (`HashMap::get_ref`, `get_mut_ref`, `contains_ref`, `remove_ref`), and counted with `HashMap::entry_owned(&mut m, k, …)`, which takes the key itself",
                            &conversion_hint(&pty, &at, ae),
                        )
                    }
                    else
                    {
                        swapped_hint(args, arg_types, params, subst, i, conversion_hint(&pty, &at, ae))
                    };
                    // Bugs 295 and 297: at the argument, which the hint is
                    // about.
                    String place = match (ae)
                    {
                        Some(x) : diag_at(x.line, x.col),
                        None    : String::new(),
                    };
                    return Err(sprintf("%s%s", &mismatch(sprintf(
                        "argument %v (`%s`) is `%s`, but the parameter is `%s`%s",
                        i + 1,
                        &p.name,
                        &type_display(&at),
                        &type_display(&pty),
                        &hint,
                    )), &place));
                }
            },
            None     : {},
        }
    }
    Ok(())
}

fn check_struct_lit(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Vec<String>, shared> segs,
    ref<Vec<Type>, shared> targs,
    ref<Vec<FieldInit>, shared> fields,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    String name = String::join(segs, "::");
    ref<StructDecl, shared> sdecl = match (HashMap::get(&it.structs, &name))
    {
        Some(s) : s,
        // `[Resolve-Unbound]` (CHG-0438): no struct of that name.
        None    : return Err(named_diag("diag.unbound-name", &sprintf("there is no struct named `%s` here", &name))),
    };
    HashMap<String, Type> m = HashMap::new();
    for (usize i = 0; i < Vec::len(&sdecl.type_params) && i < Vec::len(targs); i += 1)
    {
        HashMap::insert(&mut m, String::clone(&sdecl.type_params[i]), apply_subst(&targs[i], &b.subst));
    }
    if (!all_fixed(&sdecl.type_params, &m))
    {
        match (expected)
        {
            Some(exp) :
            {
                Vec<Type> gargs = Vec::new();
                for (usize i = 0; i < Vec::len(&sdecl.type_params); i += 1)
                {
                    Vec::push(&mut gargs, named(&sdecl.type_params[i], Vec::new()));
                }
                Type generic_self = named(&name, gargs);
                unify_type_shape(&generic_self, exp, &mut m, &sdecl.type_params);
            },
            None      : {},
        }
    }
    String shown_ty = type_display(&named(&name, Vec::new()));
    HashSet<String> seen = HashSet::new();
    for (usize fi = 0; fi < Vec::len(fields); fi += 1)
    {
        ref<String, shared> fname = &fields[fi].name;
        ref<Expr, shared> fexpr = &fields[fi].value;
        if (!HashSet::insert(&mut seen, String::clone(fname)))
        {
            return Err(mismatch(sprintf("field `%s` of `%s` is given twice", fname, &shown_ty)));
        }
        Option<usize> idx = None;
        for (usize k = 0; k < Vec::len(&sdecl.fields); k += 1)
        {
            if (sdecl.fields[k].name == *fname)
            {
                idx = Some(k);
                break;
            }
        }
        usize ix = match (idx)
        {
            Some(k) : k,
            None    : return Err(mismatch(sprintf("`%s` has no field `%s`", &shown_ty, fname))),
        };
        if (!field_visible(&name, sdecl.fields[ix].export_, &b.module_))
        {
            String msg = sprintf("field `%s` of `%s` is not exported", fname, &shown_ty);
            return Err(named_diag("diag.name-not-visible", &msg));
        }
        field_use(b, it, &name, fname, &sdecl.fields[ix].retired, fexpr.line)?;
        HashSet<String> remaining = HashSet::new();
        for (usize k = 0; k < Vec::len(&sdecl.type_params); k += 1)
        {
            if (!HashMap::contains(&m, &sdecl.type_params[k]))
            {
                HashSet::insert(&mut remaining, String::clone(&sdecl.type_params[k]));
            }
        }
        Type hint = apply_subst(&sdecl.fields[ix].ty, &m);
        Option<Type> at = None;
        if (mentions_any(&hint, &remaining))
        {
            bool saved = b.infer_poisoned;
            b.infer_poisoned = true;
            Result<Option<Type>, String> r0 = check_store_operand(b, it, fexpr, &None);
            b.infer_poisoned = saved;
            Option<Type> r = r0?;
            // `[T-Struct]` by shape.
            match (&r)
            {
                Some(t) :
                {
                    if (!is_never(t) && shape_conflict(&hint, t, &remaining))
                    {
                        return Err(mismatch(sprintf(
                            "field `%s` of `%s` is `%s`, but the value is `%s`",
                            fname,
                            &shown_ty,
                            &type_display(&hint),
                            &type_display(t),
                        )));
                    }
                },
                None    : {},
            }
            at = r;
        }
        else if (literal_in_position(b, &hint, fexpr))
        {
            // D-0304: a text literal in a field whose type the expected type
            // has fixed as `String` or `StringView`.
            at = Some(clone(&hint));
        }
        else
        {
            Option<Type> t = check_store_operand(b, it, fexpr, &Some(clone(&hint)))?;
            bool viewed = false;
            // `[T-Struct]`: the value has the field's type.
            match (&t)
            {
                Some(tt) :
                {
                    if (ty_compat(tt, &hint))
                    {
                        whole_slice_lint(b, it, &hint, fexpr);
                    }
                    if (!has_unresolved_marker(tt) && !has_unresolved_marker(&hint) && !is_never(tt) && !ty_compat(
                        tt,
                        &hint,
                    ))
                    {
                        // D-0302: text viewed where the field is a `StringView`.
                        if (view_of_text(b, it, &sdecl.fields[ix].ty, tt, fexpr))
                        {
                            viewed = true;
                        }
                        else
                        {
                            return Err(mismatch(sprintf(
                                "field `%s` of `%s` is `%s`, but the value is `%s`%s",
                                fname,
                                &shown_ty,
                                &type_display(&hint),
                                &type_display(tt),
                                &conversion_hint(&hint, tt, Some(fexpr)),
                            )));
                        }
                    }
                },
                None     : {},
            }
            at = if (viewed) { Some(clone(&hint)) } else { t };
        }
        match (&at)
        {
            Some(a) :
            {
                if (!has_unresolved_marker(a))
                {
                    unify_type_shape(&sdecl.fields[ix].ty, a, &mut m, &sdecl.type_params);
                }
            },
            None    : {},
        }
        // D-0118: a bit field's initial value must fit its width.
        match (sdecl.fields[ix].width)
        {
            Some(w) : check_bitfield_literal(b, fexpr, w, &sprintf("field `%s` of `%s`", fname, short_name(&name)))?,
            None    : {},
        }
    }
    if (HashSet::len(&seen) != Vec::len(&sdecl.fields))
    {
        // CHG-0452: the fields not given, by name.
        Vec<String> missing = Vec::new();
        foreach (f in &sdecl.fields)
        {
            if (!HashSet::contains(&seen, &f.name))
            {
                Vec::push(&mut missing, String::clone(&f.name));
            }
        }
        return Err(mismatch(sprintf(
            "a literal of `%s` gives every field; `%s` %s not given",
            &type_display(&named(&name, Vec::new())),
            &String::join(&missing, "`, `"),
            if (Vec::len(&missing) == 1) { "is" } else { "are" },
        )));
    }
    if (all_fixed(&sdecl.type_params, &m))
    {
        Vec<Type> targs_c = Vec::new();
        for (usize i = 0; i < Vec::len(&sdecl.type_params); i += 1)
        {
            Vec::push(&mut targs_c, clone(Option::expect(HashMap::get(&m, &sdecl.type_params[i]), "a type argument")));
        }
        return Ok(Some(named(&name, targs_c)));
    }
    Ok(None)
}

// ---- part 10 ----

fn arm_chain(ref<Arm, shared> a) : Vec<String>
{
    Vec<String> c = Vec::new();
    match (&a.variant)
    {
        Some(v) : Vec::push(&mut c, String::clone(v)),
        None    : {},
    }
    for (usize i = 0; i < Vec::len(&a.nested); i += 1)
    {
        Vec::push(&mut c, String::clone(&a.nested[i]));
    }
    c
}

fn is_int_or_bool(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TInt(_) : true,
        Type::TBool   : true,
        _             : false,
    }
}

// `str`, `String` or `StringView`: a level a text literal is matched
// against (D-0127).
export fn is_text_ty(ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TStr       : true,
        Type::TNamed(nb) : Box::get(nb).name == "std::String" || Box::get(nb).name == "std::StringView",
        _                : false,
    }
}

fn is_enum_ty(ref<Items, shared> it, ref<Type, shared> t) : bool
{
    match (t)
    {
        Type::TNamed(nb) : HashMap::contains(&it.enums, &Box::get(nb).name),
        _                : false,
    }
}

// The payload type of variant `vn` of the enum type `t` (`None` inside for
// a variant without one); `None` when `t` is not an enum with it.
fn variant_payload(ref<Items, shared> it, ref<Type, shared> t, ref<String, shared> vn) : Option<Option<Type>>
{
    ref<NamedTy, shared> n = match (t)
    {
        Type::TNamed(nb) : Box::get(nb),
        _                : return None,
    };
    ref<EnumDecl, shared> e = HashMap::get(&it.enums, &n.name)?;
    usize vi = variant_index_of(e, vn)?;
    HashMap<String, Type> sub = zip_subst(&e.type_params, &n.args);
    match (&e.variants[vi].payload)
    {
        Some(p) : Some(Some(apply_subst(p, &sub))),
        None    : Some(None),
    }
}

fn detail_err(String m) : Result<Option<Type>, String>
{
    Err(sprintf("diag.type-mismatch\u{1}%s", &m))
}

// Rust's `{:?}` of a string: quoted, with `\\`, `"` and the control
// characters escaped.
fn debug_str(ref<String, shared> t) : String
{
    String o = "\"";
    Vec<StringView> cs = StringView::chars(t);
    for (usize i = 0; i < Vec::len(&cs); i += 1)
    {
        StringView c = cs[i];
        u32 cp = Option::unwrap_or(StringView::code_point(c), 0);
        if (c == "\"")
        {
            String::append(&mut o, "\\\"");
        }
        else if (c == "\\")
        {
            String::append(&mut o, "\\\\");
        }
        else if (cp == 10)
        {
            String::append(&mut o, "\\n");
        }
        else if (cp == 13)
        {
            String::append(&mut o, "\\r");
        }
        else if (cp == 9)
        {
            String::append(&mut o, "\\t");
        }
        else if (cp == 0)
        {
            String::append(&mut o, "\\0");
        }
        else if (cp < 32 || cp == 127)
        {
            String::appendf(&mut o, "\\u{%x}", cp);
        }
        else
        {
            String::append(&mut o, c);
        }
    }
    String::append(&mut o, "\"");
    o
}

// A pattern literal's value as text: `-3`, `97` for `b'a'`, `true`.
export fn literal_key(ref<Expr, shared> l) : String
{
    match (&l.kind)
    {
        ExprKind::EInt(lb) : sprintf("%v", Box::get(lb).v),
        ExprKind::EUnary(ub) : match (&Box::get(ub).e.kind)
        {
            ExprKind::EInt(lb) : if (Box::get(ub).op == UnOp::Neg)
            {
                sprintf(
                    "-%v",
                    Box::get(lb).v,
                )
            }
            else { String::new() },
            _ : String::new(),
        },
        ExprKind::EBool(v) : if (*v) { "true" } else { "false" },
        // D-0127: a text literal, quoted (distinct from every number).
        ExprKind::EStr(t)  : debug_str(t),
        _                  : String::new(),
    }
}

// An arm's pattern as elements: its variants, then its literal as `=`
// and the literal's value (D-0057).
fn pattern_elems(ref<Arm, shared> a) : Vec<String>
{
    Vec<String> e = arm_chain(a);
    match (&a.lit)
    {
        Some(l) : Vec::push(&mut e, sprintf("=%s", &literal_key(Box::get(l)))),
        None    : {},
    }
    e
}

// D-0324: the last `::` segment of `n`.
fn last_name_seg(StringView n) : StringView
{
    match (StringView::rfind(n, "::"))
    {
        Some(k) : &n[k + 2 .. $],
        None    : n,
    }
}

// D-0324: whether `n` is a variant's hidden struct (`E$V`, the part after the
// `$` a name, not a local type's number).
fn is_fields_struct(StringView n) : bool
{
    StringView last = last_name_seg(n);
    match (StringView::find(last, "$"))
    {
        Some(k) :
        {
            slice<u8, shared> b = StringView::as_bytes(last);
            k > 0 && k + 1 < slice_len(b) && ((b[k + 1] >= b'a' && b[k + 1] <= b'z') || (b[k + 1] >= b'A' && b[k + 1] <= b'Z'))
        },
        None    : false,
    }
}

// `Ok(Some(_))` for the elements `Ok`, `Some` whose last variant has a
// payload; a literal element is written as its value.
fn render_pattern(ref<Vec<String>, shared> chain, bool payload) : String
{
    if (Vec::len(chain) == 0)
    {
        return "_";
    }
    Vec<StringView> shown = Vec::new();
    for (usize i = 0; i < Vec::len(chain); i += 1)
    {
        StringView e = &chain[i];
        Vec::push(&mut shown, Option::unwrap_or(StringView::strip_prefix(e, "="), e));
    }
    String s = StringView::join(&shown, "(");
    if (payload)
    {
        String::append(&mut s, "(_)");
    }
    for (usize i = 1; i < Vec::len(chain); i += 1)
    {
        String::append(&mut s, ")");
    }
    s
}

fn starts_with_elems(ref<Vec<String>, shared> whole, ref<Vec<String>, shared> prefix) : bool
{
    if (Vec::len(prefix) > Vec::len(whole))
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(prefix); i += 1)
    {
        if (whole[i] != prefix[i])
        {
            return false;
        }
    }
    true
}

// The type of the level after the pattern elements `elems` in `t0`.
fn elems_type(ref<Items, shared> it, ref<Type, shared> t0, ref<Vec<String>, shared> elems) : Option<Type>
{
    Option<Type> t = Some(clone(t0));
    for (usize i = 0; i < Vec::len(elems); i += 1)
    {
        if (StringView::starts_with(&elems[i], "="))
        {
            return None;
        }
        // D-0109: a reference to an enum is matched through.
        Option<Type> level = match (t)
        {
            Some(Type::TRef(rb)) :
            {
                Type inner = ModedTy::take_inner(rb);
                if (is_enum_ty(it, &inner)) { Some(inner) } else { Some(ref_of(inner, Mode::Shared)) }
            },
            other                : other,
        };
        Type lv = level?;
        if (!is_enum_ty(it, &lv))
        {
            return None;
        }
        t = variant_payload(it, &lv, &elems[i])?;
    }
    t
}

// D-0056/D-0057: a value whose pattern elements begin with `prefix` that
// none of `arms` matches, written as a pattern; `None` when the arms
// match every such value.
fn pattern_missing(
    ref<Items, shared> it,
    ref<Vec<String>, shared> prefix,
    Option<Type> t,
    ref<Vec<Vec<String>>, shared> arms,
    bool payload,
) : Option<String>
{
    for (usize i = 0; i < Vec::len(arms); i += 1)
    {
        if (Vec::len(&arms[i]) <= Vec::len(prefix) && starts_with_elems(prefix, &arms[i]))
        {
            return None;
        }
    }
    bool extends = false;
    for (usize i = 0; i < Vec::len(arms); i += 1)
    {
        if (Vec::len(&arms[i]) > Vec::len(prefix) && starts_with_elems(&arms[i], prefix))
        {
            extends = true;
        }
    }
    if (!extends)
    {
        // D-0324: a variant with fields is shown as it is matched.
        Option<String> fields = match (&t)
        {
            Some(Type::TNamed(nb)) : if (is_fields_struct(&Box::get(nb).name)) { Some(String::clone(&Box::get(nb).name)) } else { None },
            Some(Type::TRef(rb)) : match (&Box::get(rb).inner)
            {
                Type::TNamed(nb) : if (is_fields_struct(&Box::get(nb).name)) { Some(String::clone(&Box::get(nb).name)) } else { None },
                _                : None,
            },
            _                      : None,
        };
        match (fields)
        {
            Some(n) :
            {
                if (payload && Vec::len(prefix) > 0)
                {
                    Vec<String> shown = Vec::new();
                    foreach (e in prefix)
                    {
                        Vec::push(&mut shown, String::copy(Option::unwrap_or(StringView::strip_prefix(e, "="), e)));
                    }
                    usize last = Vec::len(&shown) - 1;
                    shown[last] = shown_type_name(last_name_seg(&n));
                    String out = String::join(&shown, "(");
                    String::append(&mut out, " { .. }");
                    for (usize i = 1; i < Vec::len(prefix); i += 1)
                    {
                        String::append(&mut out, ")");
                    }
                    return Some(out);
                }
            },
            None    : {},
        }
        return Some(render_pattern(prefix, payload));
    }
    // D-0109: below the first level, a reference to an enum (or a `bool`)
    // is split as its referent is.
    Option<Type> tt = match (t)
    {
        Some(Type::TRef(rb)) :
        {
            Type inner = ModedTy::take_inner(rb);
            if (Vec::len(prefix) > 0 && (is_enum_ty(
                it,
                &inner,
            ) || type_eq(&inner, &Type::TBool))) { Some(inner) } else { Some(ref_of(inner, Mode::Shared)) }
        },
        other                : other,
    };
    match (&tt)
    {
        Some(Type::TNamed(nb)) :
        {
            if (HashMap::contains(&it.enums, &Box::get(nb).name))
            {
                ref<EnumDecl, shared> e = Option::expect(HashMap::get(&it.enums, &Box::get(nb).name), "an enum");
                ref<Type, shared> level = Option::expect(match (&tt)
                {
                    Some(x) : Some(x),
                    None    : None,
                }, "a level");
                for (usize i = 0; i < Vec::len(&e.variants); i += 1)
                {
                    Vec<String> p = Vec::clone(prefix);
                    Vec::push(&mut p, String::clone(&e.variants[i].name));
                    Option<Type> pt = variant_payload(it, level, &e.variants[i].name)?;
                    bool has = Option::is_some(&pt);
                    match (pattern_missing(it, &p, pt, arms, has))
                    {
                        Some(m) : return Some(m),
                        None    : {},
                    }
                }
                return None;
            }
            Some(render_pattern(prefix, payload))
        },
        Some(Type::TBool)      :
        {
            foreach (bv in ["=true", "=false"])
            {
                Vec<String> p = Vec::clone(prefix);
                Vec::push(&mut p, String::copy(bv));
                match (pattern_missing(it, &p, None, arms, false))
                {
                    Some(m) : return Some(m),
                    None    : {},
                }
            }
            None
        },
        _                      : Some(render_pattern(prefix, payload)),
    }
}

// The place a match by reference looks into.
fn match_referent(ref<Body, shared> b, ref<Items, shared> it, ref<Expr, shared> scrut) : Option<Place>
{
    match (&strip_parens_tc(scrut).kind)
    {
        ExprKind::EBorrow(bb) : borrowed_place(b, it, &Box::get(bb).e),
        ExprKind::EPath(_)    :
        {
            String x = single_tracked(b, strip_parens_tc(scrut))?;
            match (HashMap::get(&b.gamma, &x)?)
            {
                Type::TRef(_) : Some(Place { .root = referent_root(&x), .path = Vec::new() }),
                _             : None,
            }
        },
        _                     : None,
    }
}

fn weaker_into(ref<Vec<Option<Mode>>, exclusive> crossed, Mode m)
{
    usize n = Vec::len(crossed);
    Mode w = weaker_mode(crossed[n - 1], m);
    crossed[n - 1] = Some(w);
}

// Exhaustiveness (`rule.agg.match`) checked statically when the
// scrutinee's enum is known.
// Report 273 (as 056 for `if`): the scrutinee's locals are not folded in
// the arms, which a pattern may have excluded the known value from.
fn check_match(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> whole,
    ref<Expr, shared> scrut,
    ref<Vec<Arm>, shared> arms,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    match_arm_break_notes(b, arms);
    Vec<String> guarded = guard_push(b, scrut);
    Result<Option<Type>, String> r = check_match_in(b, it, whole, scrut, arms, expected);
    guard_pop(b, &guarded);
    r
}

fn check_match_in(
    ref<Body, exclusive> b,
    ref<Items, shared> it,
    ref<Expr, shared> whole,
    ref<Expr, shared> scrut,
    ref<Vec<Arm>, shared> arms,
    ref<Option<Type>, shared> expected,
) : Result<Option<Type>, String>
{
    // The scrutinee is a place position (spec/13 §1).
    b.place_pos = true;
    Option<HandleHolder> hand = handle_holder_of(b, it, scrut);
    if (Option::is_some(&hand))
    {
        mark_taken(b, it, scrut);
    }
    Option<Type> st0 = check_expr(b, it, scrut, &None)?;
    uninferred(b, it, scrut, &st0)?;
    // D-0218: a scrutinee that is an exclusive reference read through a
    // shared one is a shared borrow.
    bool scrut_shared = crosses_shared(b, it, scrut);
    Option<Type> st = match (st0)
    {
        Some(Type::TRef(rb)) :
        {
            if (Box::get(&rb).mode == Mode::Exclusive && scrut_shared)
            {
                if (b.facts.silent)
                {
                    return Err(named_diag(
                        "diag.borrow-exceeds-source",
                        "an exclusive reference read through a shared reference in a body checked after the program was built",
                    ));
                }
                note_rewrite(b, scrut, Rewrite::SharedRef);
                Some(ref_of(ModedTy::take_inner(rb), Mode::Shared))
            }
            else
            {
                Some(Type::TRef(rb))
            }
        },
        other                : other,
    };
    // D-0049: a resource binding matched by value is consumed only by an
    // arm that moves its payload out.
    Option<String> consume_x = None;
    if (Option::is_none(&place_of(b, it, scrut)))
    {
        match (deref_place_of(b, it, scrut))
        {
            Some(p) : flow_clash(b, it, &p.root, &p.path, Mode::Shared, "diag.aliasing-conflict")?,
            None    : {},
        }
    }
    match (place_of(b, it, scrut))
    {
        Some(p) :
        {
            if (!tri_is(&b.flow.init, &p.root, Tri::T))
            {
                refute(b, &uninit_msg(&p.root))?;
            }
            flow_clash(b, it, &p.root, &p.path, Mode::Shared, "diag.aliasing-conflict")?;
            if (Vec::len(&p.path) == 0 && place_is_resource(b, it, &p.root, &Vec::new()))
            {
                consume_x = Some(String::clone(&p.root));
            }
        },
        None    : {},
    }
    end_after_scrutinee(b, it, scrut, arms, &st);
    Option<Type> enum_named = match (&st)
    {
        Some(t) :
        {
            if (is_enum_ty(it, t))
            {
                Some(clone(t))
            }
            else
            {
                match (t)
                {
                    Type::TRef(rb) : if (is_enum_ty(
                        it,
                        &Box::get(rb).inner,
                    )) { Some(clone(&Box::get(rb).inner)) } else { None },
                    _ : None,
                }
            }
        },
        None    : None,
    };
    // `[Match-By-Ref]` (D-0046).
    Option<Mode> by_ref = match (&st)
    {
        Some(Type::TRef(rb)) : Some(Box::get(rb).mode),
        _                    : None,
    };
    // D-0056/D-0057: each arm's pattern, typed level by level.
    Option<Type> level0 = match (&enum_named)
    {
        Some(t) : Some(clone(t)),
        None : match (&st)
        {
            Some(t) : if (is_int_or_bool(t) || is_text_ty(t)) { Some(clone(t)) } else { None },
            None    : None,
        },
    };
    // A reference to an integer, `bool` or text has no variants.
    bool any_pattern = false;
    for (usize i = 0; i < Vec::len(arms); i += 1)
    {
        if (Option::is_some(&arms[i].variant) || Option::is_some(&arms[i].lit))
        {
            any_pattern = true;
        }
    }
    if (Option::is_none(&level0) && any_pattern)
    {
        match (&st)
        {
            Some(Type::TRef(rb)) :
            {
                ref<Type, shared> inner = &Box::get(rb).inner;
                if (is_int_or_bool(inner) || is_text_ty(inner))
                {
                    return Err(sprintf("diag.type-mismatch\u{1}a literal is matched against a reference, `%s`: `match (*r)` reads the value", &type_display(Option::expect(match (&st)
                    {
                        Some(x) : Some(x),
                        None    : None,
                    }, "a type"))));
                }
            },
            _                    : {},
        }
    }
    Vec<Option<Type>> binder_ty = Vec::new();
    // D-0109: the mode of the references each arm's pattern looks through.
    Vec<Option<Mode>> crossed = Vec::new();
    for (usize ai = 0; ai < Vec::len(arms); ai += 1)
    {
        ref<Arm, shared> arm = &arms[ai];
        Vec::push(&mut crossed, None);
        // D-0058: a binder alone binds the whole scrutinee.
        if (Option::is_none(&arm.variant) && Option::is_none(&arm.lit) && Option::is_some(&arm.binder))
        {
            Option<Type> bt = match (&st)
            {
                Some(Type::TRef(rb)) : if (Option::is_some(&by_ref)) { Some(clone(&Box::get(rb).inner)) } else { clone(&st) },
                _                    : clone(&st),
            };
            Vec::push(&mut binder_ty, bt);
            continue;
        }
        Type t0 = match (&level0)
        {
            Some(t) : clone(t),
            None    :
            {
                // A scrutinee this pass knows that is not an enum, an
                // integer, `bool` or text has no value a pattern names.
                match (&st)
                {
                    Some(t) :
                    {
                        match (&arm.lit)
                        {
                            Some(l) : return detail_err(sprintf(
                                "the literal `%s` is matched against `%s`, which is not an integer, `bool` or text",
                                &literal_key(Box::get(l)),
                                &type_display(t),
                            )),
                            None : {},
                        }
                        match (&arm.variant)
                        {
                            Some(v) : return detail_err(sprintf(
                                "the pattern `%s` is matched against `%s`, which is not an enum",
                                v,
                                &type_display(t),
                            )),
                            None : {},
                        }
                    },
                    None    : {},
                }
                Vec::push(&mut binder_ty, None);
                continue;
            },
        };
        Option<Type> cur = Some(t0);
        Vec<String> chain = arm_chain(arm);
        for (usize k = 0; k < Vec::len(&chain); k += 1)
        {
            ref<String, shared> vn = &chain[k];
            // D-0109: a level below the first that is a reference to an
            // enum is matched through the reference.
            if (k > 0)
            {
                match (clone(&cur))
                {
                    Some(Type::TRef(rb)) :
                    {
                        ModedTy { inner, mode } = Box::into_inner(rb);
                        if (is_enum_ty(it, &inner))
                        {
                            weaker_into(&mut crossed, mode);
                            cur = Some(inner);
                        }
                        else
                        {
                            cur = Some(ref_of(inner, mode));
                        }
                    },
                    _                    : {},
                }
            }
            Type level = match (&cur)
            {
                Some(c) :
                {
                    if (is_enum_ty(it, c))
                    {
                        clone(c)
                    }
                    else
                    {
                        return detail_err(sprintf(
                            "the pattern `%s` is matched against `%s`, which is not an enum",
                            vn,
                            &type_display(c),
                        ));
                    }
                },
                None    : return Err("diag.type-mismatch"),
            };
            match (variant_payload(it, &level, vn))
            {
                Some(p) :
                {
                    match (&level)
                    {
                        Type::TNamed(lb) :
                        {
                            ref<String, shared> ek = &Box::get(lb).name;
                            variant_use(b, it, ek, vn, Box::get(&arm.body).line)?;
                            // D-0324: a variant with fields is matched by naming
                            // them, never by one binder for all.
                            bool one_binder = match (&arm.binder)
                            {
                                Some(bn) : !StringView::starts_with(bn, "__pattern"),
                                None     : false,
                            };
                            if (k + 1 == Vec::len(&chain) && !b.derived && one_binder && enum_variant_has_fields(it, ek, vn))
                            {
                                String en = shown_type_name(Option::unwrap_or(StringView::strip_prefix(ek, "std::"), ek));
                                return detail_err(sprintf(
                                    "`%s::%s` has fields, and is matched by naming them: `%s::%s { f, … }` (`%s::%s { .. }` for none)",
                                    &en,
                                    vn,
                                    &en,
                                    vn,
                                    &en,
                                    vn,
