                    Vec<StringView> sparts = StringView::split(&aq.written, "::");
                    Vec<String> segs = Vec::new();
                    for (usize k = 0; k < Vec::len(&sparts); k += 1)
                    {
                        Vec::push(&mut segs, String::copy(sparts[k]));
