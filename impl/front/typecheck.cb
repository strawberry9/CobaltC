                    {
                        Some(lt) :
                        {
                            match (marker_of(lt))
                            {
                                Some(ln) :
                                {
                                    if (ln != enk && is_enum_ty(it, lt))
                                    {
                                        String msg = sprintf(
                                            "the pattern names `%s`, a variant of `%s`, but the value matched there is of type `%s`",
                                            &shown_key(&aq.written),
                                            &shown_key(&enk),
                                            &type_display(lt),
                                        );
                                        return Err(sprintf("%s%s", &mismatch(msg), &diag_at(abody.line, abody.col)));
                                    }
                                },
                                None     : {},
                            }
                        },
                        None     : {},
                    }
                }
            }
        },
        None     : {},
    }
    // A scrutinee with no variants and no literals (a struct, a float, a
