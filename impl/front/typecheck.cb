        ref<Expr, shared> body1 = Box::get(&arms[1].body);
        return Err(sprintf("diag.unreachable-arm%s", &diag_at(body1.line, body1.col)));
    }
    // `[Match-Non-Exhaustive]` and `[Match-Unreachable]` (D-0056).
    match (&level0)
    {
        Some(t0) :
        {
