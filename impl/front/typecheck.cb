                    String::appendf(&mut pk, "%v:%s;", StringView::len(&prev[q]), &prev[q]);
                }
                HashSet::insert(&mut whole_keys, pk);
                Vec::push(&mut earlier, Vec::clone(prev));
                bool covered = false;
                String ck = String::new();
                for (usize q = 0; q <= Vec::len(&chains[k]) && !covered; q += 1)
                {
                    covered = HashSet::contains(&whole_keys, &ck);
