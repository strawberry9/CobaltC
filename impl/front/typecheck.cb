                        Vec<String> head = Vec::new();
                        for (usize k = 0; k + 1 < n; k += 1)
                        {
                            Vec::push(&mut head, String::clone(&segs[k]));
                        }
                        String msg = sprintf(
                            "nothing named `%s`: no enum `%s` has a variant `%s`",
                            &shown_key(&aq.written),
                            &String::join(&head, "::"),
                            &segs[n - 1],
                        );
                        return Err(sprintf("%s%s", &named_diag("diag.unbound-name", &msg), &diag_at(abody.line, abody.col)));
                    }
