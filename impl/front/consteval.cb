// `rule.module.static-assert` (D-0052): each `static_assert` the type
// checker recorded, computed before the program runs. A constant
// expression (`spec/17` §1a) is literals, constants, their fields and
// elements, the operators over them (`spec/06`'s checked arithmetic and
// shifts, IEEE-754 arithmetic in the operands' float type, comparisons of
// numbers, truth values and text), `sizeof`, `alignof`, `min_value`,
// `max_value`, `widen`, `narrow`, `narrow_wrapping`, `reinterpret`,
// `to_float`, `to_int`, `wrapping_*` and `saturating_*` (D-0036, D-0066),
// which this evaluates directly. A false assertion is
// `diag.static-assert-failed` with its message; a checked failure in the
// condition is that failure, at the assertion.

import std;
import ast;
import items;
import typecheck;

struct IntVal
{
    i128 v;
    // `None`: a literal whose type its context gives.
    Option<IntTy> t;
}

// A float and its type: 32 or 64, or 0 for a literal whose type its
// context gives (an `f32`'s value is held rounded to `f32`).
struct FloatC
{
    f64 v;
    u32 w;
}

struct FieldVal
{
    String name;
    CVal v;
}

enum CVal
{
    VInt(IntVal),
    VBool(bool),
    VFloat(FloatC),
    VStr(String),
    VStruct(Vec<FieldVal>),
    VArr(Vec<CVal>),
}

struct Ev
{
    HashMap<String, Type> subst;
    u32 depth;
    // The type an operation of literals alone has: the constant's declared
    // integer type while its initialiser is computed, else `i32`.
    Option<IntTy> lit;
}

fn lit_or_i32(ref<Ev, shared> ev) : IntTy
{
    Option::unwrap_or(ev.lit, IntTy::I32)
}

fn int_of_ty(ref<Type, shared> t) : Option<IntTy>
{
    match (t)
    {
        Type::TInt(k) : Some(*k),
        _             : None,
    }
}

fn not_const() : Result<CVal, String>
{
    Err("diag.const-not-constant")
}

fn fits(i128 v, IntTy t) : bool
{
    IntRange r = int_range(t);
    v >= r.min && v <= r.max
}

fn round32(f64 v) : f64
{
    widen<f64>(to_float<f32>(v))
}

fn fl(f64 v, u32 w) : CVal
{
    CVal::VFloat(FloatC { .v = if (w == 32) { round32(v) } else { v }, .w = w })
}

fn lit_ty(ref<Option<String>, shared> sfx) : Option<IntTy>
{
    match (sfx)
    {
        Some(s) : if (*s == "byte") { Some(IntTy::U8) } else { int_ty_from(s) },
        None    : None,
    }
}

// `x mod 2^bitwidth(k)`, reinterpreted per `k`'s signedness (`spec/06`
// [Narrow-Wrapping], [Wrapping], [Shl-Checked]).
fn wrapped(u128 x, IntTy k) : Result<CVal, String>
{
    u32 bw = int_ty_bits(k, 64);
    u128 one = 1;
    u128 m = if (bw >= 128) { x } else { x & ((one << bw) - 1) };
    if (int_ty_signed(k))
    {
        i128 s = reinterpret<i128>(m);
        if (bw < 128)
        {
            i128 ione = 1;
            if (s >= (ione << (bw - 1)))
            {
                s = s - (ione << bw);
            }
        }
        return typed(s, Some(k));
    }
    // A `u128` above `i128`'s maximum is not held (`int_range`).
    if (m > reinterpret<u128>(max_value<i128>()))
    {
        return Err("diag.unsupported-in-selfhost");
    }
    typed(reinterpret<i128>(m), Some(k))
}

fn typed(i128 v, Option<IntTy> t) : Result<CVal, String>
{
    match (t)
    {
        Some(k) :
        {
            if (!fits(v, k))
            {
                return Err("diag.arith-overflow");
            }
        },
        None    : {},
    }
    Ok(CVal::VInt(IntVal { .v = v, .t = t }))
}

struct SizeAlign
{
    u128 size;
    u128 align;
}

fn round_up(u128 x, u128 a) : u128
{
    (x + a - 1) / a * a
}

// `sizeof` and `alignof` (spec/06 §4, spec/16 §1): fields in order at
// their alignment; an enum's discriminant (4 bytes) then its largest
// payload; `None` for a type this does not lay out.
fn size_align(ref<Items, shared> it, ref<Type, shared> t) : Option<SizeAlign>
{
    match (t)
    {
        Type::TInt(k)    :
        {
            u128 n = widen<u128>(int_ty_bits(*k, 64) / 8);
            Some(SizeAlign { .size = n, .align = n })
        },
        Type::TBool      : Some(SizeAlign { .size = 1, .align = 1 }),
        Type::TF32       : Some(SizeAlign { .size = 4, .align = 4 }),
        Type::TF64       : Some(SizeAlign { .size = 8, .align = 8 }),
        Type::TStr       : Some(SizeAlign { .size = 16, .align = 8 }),
        Type::TSlice(_)  : Some(SizeAlign { .size = 24, .align = 8 }),
        Type::TRef(_)    : Some(SizeAlign { .size = 8, .align = 8 }),
        Type::TRawptr(_) : Some(SizeAlign { .size = 8, .align = 8 }),
        Type::TFn(_)     : Some(SizeAlign { .size = 8, .align = 8 }),
        Type::THandle(_) : Some(SizeAlign { .size = 8, .align = 8 }),
        Type::TGuard(_)  : Some(SizeAlign { .size = 8, .align = 8 }),
        Type::TArray(ab) :
        {
            SizeAlign e = size_align(it, &Box::get(ab).inner)?;
            Some(SizeAlign { .size = e.size * Box::get(ab).n, .align = e.align })
        },
        Type::TSimd(ab)  :
        {
            SizeAlign e = size_align(it, &Box::get(ab).inner)?;
            u128 n = e.size * Box::get(ab).n;
            Some(SizeAlign { .size = n, .align = max(n, 1) })
        },
        Type::TMutex(x)  :
        {
            SizeAlign e = size_align(it, Box::get(x))?;
            u128 align = max(e.align, 8);
            Some(SizeAlign { .size = round_up(round_up(e.size, 8) + 8, align), .align = align })
        },
        Type::TNamed(nb) :
        {
            ref<NamedTy, shared> n = Box::get(nb);
            match (HashMap::get(&it.structs, &n.name))
            {
                Some(sd) :
                {
                    // D-0118: a bitstruct is its backing integer.
                    match (sd.bits)
                    {
                        Some(k) :
                        {
                            u128 w = widen<u128>(int_ty_bits(k, 64) / 8);
                            return Some(SizeAlign { .size = w, .align = min(w, 8) });
                        },
                        None    : {},
                    }
                    HashMap<String, Type> sub = zip_subst(&sd.type_params, &n.args);
                    u128 off = 0;
                    // D-0251: `align(N)` raises the alignment, never lowers it.
                    u128 align = match (sd.align)
                    {
                        Some(a) : widen<u128>(a),
                        None    : 1,
                    };
                    for (usize i = 0; i < Vec::len(&sd.fields); i += 1)
                    {
                        SizeAlign f = size_align(it, &apply_subst(&sd.fields[i].ty, &sub))?;
                        align = max(align, f.align);
                        off = round_up(off, f.align) + f.size;
                    }
                    return Some(SizeAlign { .size = round_up(off, align), .align = align });
                },
                None     : {},
            }
            match (HashMap::get(&it.enums, &n.name))
            {
                Some(ed) :
                {
                    HashMap<String, Type> sub = zip_subst(&ed.type_params, &n.args);
                    // `[Layout-Enum-Niche]` (D-0298): two variants, one with
                    // no payload and one a `Box`, are the `Box` alone.
                    if (Vec::len(&ed.variants) == 2)
                    {
                        Option<Type> boxed = match (&ed.variants[0].payload)
                        {
                            Some(p) : if (Option::is_none(&ed.variants[1].payload)) { Some(apply_subst(p, &sub)) } else { None },
                            None : match (&ed.variants[1].payload)
                            {
                                Some(p) : Some(apply_subst(p, &sub)),
                                None    : None,
                            },
                        };
                        match (&boxed)
                        {
                            Some(Type::TNamed(b)) :
                            {
                                if (Box::get(b).name == "std::Box")
                                {
                                    return Some(SizeAlign { .size = 8, .align = 8 });
                                }
                            },
                            _                     : {},
                        }
                    }
                    u128 pa = 1;
                    u128 ps = 0;
                    for (usize i = 0; i < Vec::len(&ed.variants); i += 1)
                    {
                        match (&ed.variants[i].payload)
                        {
                            Some(p) :
                            {
                                SizeAlign f = size_align(it, &apply_subst(p, &sub))?;
                                pa = max(pa, f.align);
                                ps = max(ps, f.size);
                            },
                            None    : {},
                        }
                    }
                    u128 align = max(pa, 4);
                    return Some(SizeAlign { .size = round_up(round_up(4, pa) + ps, align), .align = align });
                },
                None     : {},
            }
            None
        },
        _                : None,
    }
}

fn eval(ref<Ev, exclusive> ev, ref<Items, shared> it, ref<Expr, shared> e) : Result<CVal, String>
{
    match (&e.kind)
    {
        ExprKind::EInt(lb)         :
        {
            ref<IntLit, shared> l = Box::get(lb);
            if (l.v > reinterpret<u128>(max_value<i128>()))
            {
                return not_const();
            }
            typed(reinterpret<i128>(l.v), lit_ty(&l.sfx))
        },
        ExprKind::EBool(v)         : Ok(CVal::VBool(*v)),
        ExprKind::EFloat(fb)       :
        {
            ref<FloatLit, shared> l = Box::get(fb);
            u32 w = match (&l.sfx)
            {
                Some(s) : if (*s == "f32") { 32 } else { 64 },
                None    : 0,
            };
            Ok(fl(l.v, w))
        },
        ExprKind::EStr(s)          : Ok(CVal::VStr(String::clone(s))),
        ExprKind::EParen(x)        : eval(ev, it, Box::get(x)),
        ExprKind::EUnary(ub)       :
        {
            ref<UnaryExpr, shared> u = Box::get(ub);
            // `-L` is the literal's negative, range-checked as one value
            // (`spec/06` [Literal-Negated]: `-2147483648: i32` is `min(i32)`).
            if (u.op == UnOp::Neg)
            {
                match (&u.e.kind)
                {
                    ExprKind::EInt(lb) : return neg_literal(Box::get(lb)),
                    _                  : {},
                }
            }
            CVal x = eval(ev, it, &u.e)?;
            match (x)
            {
                CVal::VInt(iv)  :
                {
                    if (u.op == UnOp::Neg)
                    {
                        if (iv.v == min_value<i128>())
                        {
                            return Err("diag.arith-overflow");
                        }
                        return typed(0 - iv.v, iv.t);
                    }
                    if (u.op == UnOp::BitNot)
                    {
                        IntTy k = Option::unwrap_or(iv.t, lit_or_i32(ev));
                        if (int_ty_signed(k))
                        {
                            return typed(-1 - iv.v, Some(k));
                        }
                        return typed(int_range(k).max - iv.v, Some(k));
                    }
                    not_const()
                },
                CVal::VBool(bv) : if (u.op == UnOp::Not) { Ok(CVal::VBool(!bv)) } else { not_const() },
                CVal::VFloat(f) : if (u.op == UnOp::Neg) { Ok(fl(-f.v, f.w)) } else { not_const() },
                _               : not_const(),
            }
        },
        ExprKind::EBinary(bb)      : eval_binary(ev, it, Box::get(bb)),
        ExprKind::EField(fb)       :
        {
            CVal x = eval(ev, it, &Box::get(fb).e)?;
            match (x)
            {
                CVal::VStruct(fs) :
                {
                    for (usize i = 0; i < Vec::len(&fs); i += 1)
                    {
                        if ((fs[i].name == (Box::get(fb).name)))
                        {
                            return Ok(clone(&fs[i].v));
                        }
                    }
                    not_const()
                },
                _                 : not_const(),
            }
        },
        ExprKind::EIndex(pb)       :
        {
            CVal a = eval(ev, it, &Box::get(pb).a)?;
            CVal k = eval(ev, it, &Box::get(pb).b)?;
            match (a)
            {
                CVal::VArr(xs) : match (k)
                {
                    CVal::VInt(iv) :
                    {
                        if (iv.v < 0 || iv.v >= widen<i128>(Vec::len(&xs)))
                        {
                            return Err("diag.index-out-of-bounds");
                        }
                        Ok(clone(&xs[narrow<usize>(iv.v)]))
                    },
                    _              : not_const(),
                },
                _ : not_const(),
            }
        },
        ExprKind::EArrayLit(es)    :
        {
            Vec<CVal> xs = Vec::new();
            for (usize i = 0; i < Vec::len(es); i += 1)
            {
                Vec::push(&mut xs, eval(ev, it, &es[i])?);
            }
            Ok(CVal::VArr(xs))
        },
        ExprKind::EArrayRepeat(rb) :
        {
            CVal x = eval(ev, it, &Box::get(rb).value)?;
            Vec<CVal> xs = Vec::new();
            for (u128 i = 0; i < Box::get(rb).n; i += 1)
            {
                Vec::push(&mut xs, clone(&x));
            }
            Ok(CVal::VArr(xs))
        },
        ExprKind::EStructLit(sb)   :
        {
            ref<StructLitExpr, shared> sl = Box::get(sb);
            Vec<FieldVal> fs = Vec::new();
            for (usize i = 0; i < Vec::len(&sl.fields); i += 1)
            {
                Vec::push(
                    &mut fs,
                    FieldVal { .name = String::clone(&sl.fields[i].name), .v = eval(ev, it, &sl.fields[i].value)? },
                );
            }
            Ok(CVal::VStruct(fs))
        },
        ExprKind::EBlock(blk)      :
        {
            if (Vec::len(&blk.stmts) != 0)
            {
                return not_const();
            }
            match (&blk.tail)
            {
                Some(t) : eval(ev, it, Box::get(t)),
                None    : not_const(),
            }
        },
        ExprKind::ECall(cb)        : eval_call(ev, it, Box::get(cb)),
        _                          : not_const(),
    }
}

fn neg_literal(ref<IntLit, shared> l) : Result<CVal, String>
{
    u128 lim = reinterpret<u128>(max_value<i128>()) + 1;
    if (l.v > lim)
    {
        return not_const();
    }
    i128 v = if (l.v == lim) { min_value<i128>() } else { 0 - reinterpret<i128>(l.v) };
    typed(v, lit_ty(&l.sfx))
}

fn eval_call(ref<Ev, exclusive> ev, ref<Items, shared> it, ref<CallExpr, shared> c) : Result<CVal, String>
{
    ref<PathExpr, shared> p = match (&c.callee.kind)
    {
        ExprKind::EPath(pb) : Box::get(pb),
        _                   : return not_const(),
    };
    String name = String::join(&p.segs, "::");
    // A constant item (`const τ K = e;` that did not fold to a literal).
    match (HashMap::get(&it.fns, &name))
    {
        Some(f) :
        {
            if (f.is_const && Vec::len(&c.args) == 0)
            {
                if (ev.depth > 200)
                {
                    return not_const();
                }
                ev.depth += 1;
                Option<IntTy> saved_lit = ev.lit;
                ev.lit = int_of_ty(&f.ret);
                Result<CVal, String> r = eval_block(ev, it, &f.body);
                ev.lit = saved_lit;
                ev.depth -= 1;
                CVal v = r?;
                // The constant's declared type types a literal.
                return match (v)
                {
                    CVal::VInt(iv) : match (&f.ret)
                    {
                        Type::TInt(k) : typed(iv.v, Some(*k)),
                        _             : Ok(CVal::VInt(iv)),
                    },
                    other : Ok(other),
                };
            }
            return not_const();
        },
        None    : {},
    }
    Option<Type> ta = if (Vec::len(&p.targs) == 1) { Some(apply_subst_ce(&p.targs[0], &ev.subst)) } else { None };
    if (name == "sizeof" || name == "alignof")
    {
        match (&ta)
        {
            Some(t) : match (size_align(it, t))
            {
                Some(sa) : return typed(
                    reinterpret<i128>(if (name == "sizeof") { sa.size } else { sa.align }),
                    Some(IntTy::Usize),
                ),
                None : return Err("diag.unsupported-in-selfhost"),
            },
            None : return not_const(),
        }
    }
    if (name == "min_value" || name == "max_value")
    {
        match (&ta)
        {
            Some(Type::TInt(k)) :
            {
                IntRange r = int_range(*k);
                return typed(if (name == "min_value") { r.min } else { r.max }, Some(*k));
            },
            // D-0051: the largest finite value and its negation.
            Some(Type::TF32)    :
            {
                f64 m = widen<f64>(max_value<f32>());
                return Ok(fl(if (name == "min_value") { -m } else { m }, 32));
            },
            Some(Type::TF64)    :
            {
                f64 m = max_value<f64>();
                return Ok(fl(if (name == "min_value") { -m } else { m }, 64));
            },
            _                   : return not_const(),
        }
    }
    if ((name == "widen" || name == "narrow") && Vec::len(&c.args) == 1)
    {
        CVal x = eval(ev, it, &c.args[0])?;
        match (ta)
        {
            Some(Type::TInt(k)) : match (x)
            {
                CVal::VInt(iv) :
                {
                    if (!fits(iv.v, k))
                    {
                        return Err("diag.narrowing-overflow");
                    }
                    return typed(iv.v, Some(k));
                },
                _              : return not_const(),
            },
            _ : return not_const(),
        }
    }
    if ((name == "narrow_wrapping" || name == "reinterpret" || name == "to_float" || name == "to_int") && Vec::len(&c.args) == 1)
    {
        CVal x = eval(ev, it, &c.args[0])?;
        return match (ta)
        {
            Some(t) : convert(&name, &t, x),
            None    : not_const(),
        };
    }
    if ((StringView::starts_with(&name, "wrapping_") || StringView::starts_with(&name, "saturating_")) && Vec::len(&c.args) == 2)
    {
        CVal a = eval(ev, it, &c.args[0])?;
        CVal b = eval(ev, it, &c.args[1])?;
        return match (a)
        {
            CVal::VInt(p) : match (b)
            {
                CVal::VInt(q) : alt_op(&name, p, q),
                _             : not_const(),
            },
            _ : not_const(),
        };
    }
    // `$fmt(F, …)`: the message of a failed assertion (D-0068).
    if (name == "$fmt" && Vec::len(&c.args) > 0)
    {
        String f = match (&c.args[0].kind)
        {
            ExprKind::EStr(s) : String::clone(s),
            _                 : return not_const(),
        };
        Vec<CVal> vals = Vec::new();
        for (usize i = 1; i < Vec::len(&c.args); i += 1)
        {
            Vec::push(&mut vals, eval(ev, it, &c.args[i])?);
        }
        return Ok(CVal::VStr(render(&f, &vals)?));
    }
    Err("diag.unsupported-in-selfhost")
}

// `narrow_wrapping`, `reinterpret`, `to_float` and `to_int` to `t`
// (`spec/06` §4).
fn convert(ref<String, shared> name, ref<Type, shared> t, CVal x) : Result<CVal, String>
{
    if (*name == "narrow_wrapping")
    {
        return match (t)
        {
            Type::TInt(k) : match (x)
            {
                CVal::VInt(iv) : wrapped(reinterpret<u128>(iv.v), *k),
                _              : not_const(),
            },
            _ : not_const(),
        };
    }
    if (*name == "reinterpret")
    {
        return match (t)
        {
            Type::TInt(k) : match (x)
            {
                CVal::VInt(iv)  : wrapped(reinterpret<u128>(iv.v), *k),
                // [Reinterpret-Float]: the float's IEEE-754 bits.
                CVal::VFloat(f) :
                {
                    if (int_ty_bits(*k, 64) == 32)
                    {
                        return wrapped(widen<u128>(reinterpret<u32>(to_float<f32>(f.v))), *k);
                    }
                    wrapped(widen<u128>(reinterpret<u64>(f.v)), *k)
                },
                _               : not_const(),
            },
            Type::TF32 : match (x)
            {
                CVal::VInt(iv) :
                {
                    u128 m = reinterpret<u128>(iv.v) & 0xffff_ffff;
                    Ok(fl(widen<f64>(reinterpret<f32>(narrow<u32>(m))), 32))
                },
                _              : not_const(),
            },
            Type::TF64 : match (x)
            {
                CVal::VInt(iv) :
                {
                    u128 m = reinterpret<u128>(iv.v) & 0xffff_ffff_ffff_ffff;
                    Ok(fl(reinterpret<f64>(narrow<u64>(m)), 64))
                },
                _              : not_const(),
            },
            _ : not_const(),
        };
    }
    if (*name == "to_float")
    {
        u32 w = match (t)
        {
            Type::TF32 : 32,
            Type::TF64 : 64,
            _          : return not_const(),
        };
        return match (x)
        {
            // [Int-To-Float]: the nearest value, ties to even (to `f32`
            // directly, not through `f64`).
            CVal::VInt(iv)  : if (w == 32) { Ok(fl(widen<f64>(to_float<f32>(iv.v)), 32)) } else { Ok(fl(to_float<f64>(iv.v), 64)) },
            CVal::VFloat(f) : Ok(fl(f.v, w)),
            _               : not_const(),
        };
    }
    // `to_int` ([Float-To-Int-Checked]): the value truncated, when finite
    // and in the target's domain.
    IntTy k = match (t)
    {
        Type::TInt(k) : *k,
        _             : return not_const(),
    };
    f64 v = match (x)
    {
        CVal::VFloat(f) : f.v,
        _               : return not_const(),
    };
    f64 lim = 1.7014118346046923e38;
    if (!(v >= -lim && v < lim))
    {
        if (k == IntTy::U128 && v >= lim && v < 2.0 * lim)
        {
            return Err("diag.unsupported-in-selfhost");
        }
        return Err("diag.narrowing-overflow");
    }
    i128 r = to_int<i128>(v);
    if (!fits(r, k))
    {
        return Err("diag.narrowing-overflow");
    }
    typed(r, Some(k))
}

// `wrapping_op` and `saturating_op` for `op` in add, sub, mul (`spec/06`
// §5), in the operands' type.
fn alt_op(ref<String, shared> name, IntVal p, IntVal q) : Result<CVal, String>
{
    IntTy k = Option::unwrap_or(join_ty(p.t, q.t), IntTy::I32);
    bool wrap = StringView::starts_with(name, "wrapping_");
    String op = String::copy(if (wrap) { &name[9..StringView::len(name)] } else { &name[11..StringView::len(name)] });
    if (wrap)
    {
        u128 a = reinterpret<u128>(p.v);
        u128 b = reinterpret<u128>(q.v);
        if (op == "add")
        {
            return wrapped(wrapping_add(a, b), k);
        }
        if (op == "sub")
        {
            return wrapped(wrapping_sub(a, b), k);
        }
        if (op == "mul")
        {
            return wrapped(wrapping_mul(a, b), k);
        }
        return not_const();
    }
    Option<i128> r = None;
    // Where the exact value leaves `i128`, its sign: `true` above.
    bool up = false;
    if (op == "add")
    {
        r = checked_add(p.v, q.v);
        up = p.v > 0;
    }
    else if (op == "sub")
    {
        r = checked_sub(p.v, q.v);
        up = p.v >= 0;
    }
    else if (op == "mul")
    {
        r = checked_mul(p.v, q.v);
        up = (p.v < 0) == (q.v < 0);
    }
    else
    {
        return not_const();
    }
    IntRange lim = int_range(k);
    i128 v = match (r)
    {
        Some(v) : if (v > lim.max) { lim.max } else if (v < lim.min) { lim.min } else { v },
        None    : if (up) { lim.max } else { lim.min },
    };
    typed(v, Some(k))
}

fn eval_block(ref<Ev, exclusive> ev, ref<Items, shared> it, ref<Block, shared> blk) : Result<CVal, String>
{
    if (Vec::len(&blk.stmts) != 0)
    {
        return Err("diag.unsupported-in-selfhost");
    }
    match (&blk.tail)
    {
        Some(t) : eval(ev, it, Box::get(t)),
        None    : not_const(),
    }
}

fn apply_subst_ce(ref<Type, shared> t, ref<HashMap<String, Type>, shared> subst) : Type
{
    match (t)
    {
        Type::TNamed(nb) :
        {
            if (Vec::len(&Box::get(nb).args) == 0)
            {
                match (HashMap::get(subst, &Box::get(nb).name))
                {
                    Some(x) : return clone(x),
                    None    : {},
                }
            }
            clone(t)
        },
        _                : clone(t),
    }
}

// Two integers' common type: a literal's is the other operand's.
fn join_ty(Option<IntTy> a, Option<IntTy> b) : Option<IntTy>
{
    match (a)
    {
        Some(k) : Some(k),
        None    : b,
    }
}

fn eval_binary(ref<Ev, exclusive> ev, ref<Items, shared> it, ref<BinaryExpr, shared> x) : Result<CVal, String>
{
    BinOp op = x.op;
    // `&&` and `||` evaluate their right operand only when it decides.
    if (op == BinOp::And || op == BinOp::Or)
    {
        bool l = match (eval(ev, it, &x.a)?)
        {
            CVal::VBool(v) : v,
            _              : return not_const(),
        };
        if ((op == BinOp::And && !l) || (op == BinOp::Or && l))
        {
            return Ok(CVal::VBool(l));
        }
        return match (eval(ev, it, &x.b)?)
        {
            CVal::VBool(v) : Ok(CVal::VBool(v)),
            _              : not_const(),
        };
    }
    CVal a = eval(ev, it, &x.a)?;
    CVal b = eval(ev, it, &x.b)?;
    bool cmp = op == BinOp::Eq || op == BinOp::Ne || op == BinOp::Lt || op == BinOp::Le || op == BinOp::Gt || op == BinOp::Ge;
    match (a)
    {
        CVal::VInt(p)   :
        {
            IntVal q = match (b)
            {
                CVal::VInt(q) : q,
                _             : return not_const(),
            };
            // A shift is its left operand's type (`spec/06` §3).
            if (op == BinOp::Shl || op == BinOp::Shr)
            {
                return shift(op, p.v, q.v, Option::unwrap_or(p.t, lit_or_i32(ev)));
            }
            Option<IntTy> t = join_ty(p.t, q.t);
            if (cmp)
            {
                return Ok(CVal::VBool(holds(op, compare_i(p.v, q.v))));
            }
            // An operation of two literals is an `i32`'s.
            Option<IntTy> tt = match (t)
            {
                Some(k) : Some(k),
                None    : Some(lit_or_i32(ev)),
            };
            int_op(op, p.v, q.v, Option::unwrap_or(tt, lit_or_i32(ev)), if (Option::is_some(&p.t)) { p.t } else { tt })
        },
        CVal::VBool(p)  :
        {
            bool q = match (b)
            {
                CVal::VBool(q) : q,
                _              : return not_const(),
            };
            if (op == BinOp::Eq)
            {
                return Ok(CVal::VBool(p == q));
            }
            if (op == BinOp::Ne)
            {
                return Ok(CVal::VBool(p != q));
            }
            not_const()
        },
        CVal::VFloat(p) :
        {
            FloatC q = match (b)
            {
                CVal::VFloat(q) : q,
                _               : return not_const(),
            };
            // A literal takes the other operand's type.
            u32 w = if (p.w != 0) { p.w } else { q.w };
            f64 x = if (w == 32) { round32(p.v) } else { p.v };
            f64 y = if (w == 32) { round32(q.v) } else { q.v };
            if (cmp)
            {
                return Ok(CVal::VBool(fholds(op, x, y)));
            }
            if (w == 32)
            {
                f32 a = to_float<f32>(x);
                f32 c = to_float<f32>(y);
                return match (op)
                {
                    BinOp::Add : Ok(fl(widen<f64>(a + c), 32)),
                    BinOp::Sub : Ok(fl(widen<f64>(a - c), 32)),
                    BinOp::Mul : Ok(fl(widen<f64>(a * c), 32)),
                    BinOp::Div : Ok(fl(widen<f64>(a / c), 32)),
                    _          : Err("diag.unsupported-in-selfhost"),
                };
            }
            match (op)
            {
                BinOp::Add : Ok(fl(x + y, w)),
                BinOp::Sub : Ok(fl(x - y, w)),
                BinOp::Mul : Ok(fl(x * y, w)),
                BinOp::Div : Ok(fl(x / y, w)),
                _          : Err("diag.unsupported-in-selfhost"),
            }
        },
        // Text compares byte by byte (`spec/21`).
        CVal::VStr(p)   :
        {
            String q = match (b)
            {
                CVal::VStr(q) : q,
                _             : return not_const(),
            };
            if (cmp)
            {
                return Ok(CVal::VBool(holds(op, compare_text(&p, &q))));
            }
            not_const()
        },
        _               : Err("diag.unsupported-in-selfhost"),
    }
}

fn fholds(BinOp op, f64 x, f64 y) : bool
{
    match (op)
    {
        BinOp::Eq : x == y,
        BinOp::Ne : x != y,
        BinOp::Lt : x < y,
        BinOp::Le : x <= y,
        BinOp::Gt : x > y,
        _         : x >= y,
    }
}

fn compare_text(ref<String, shared> p, ref<String, shared> q) : i32
{
    slice<u8, shared> a = StringView::as_bytes(p);
    slice<u8, shared> b = StringView::as_bytes(q);
    usize n = min(slice_len(a), slice_len(b));
    for (usize i = 0; i < n; i += 1)
    {
        if (a[i] != b[i])
        {
            return if (a[i] < b[i]) { -1 } else { 1 };
        }
    }
    compare_i(widen<i128>(slice_len(a)), widen<i128>(slice_len(b)))
}

// `<<` and `>>` (`spec/06` [Shl-Checked], [Shr-Checked]): the amount
// below the operand's width; a left shift discards the high bits.
fn shift(BinOp op, i128 v, i128 n, IntTy k) : Result<CVal, String>
{
    u32 bw = int_ty_bits(k, 64);
    if (n < 0 || n >= widen<i128>(bw))
    {
        return Err("diag.shift-amount-out-of-range");
    }
    u32 s = narrow<u32>(n);
    if (op == BinOp::Shr)
    {
        return typed(v >> s, Some(k));
    }
    wrapped(reinterpret<u128>(v) << s, k)
}

fn compare_i(i128 p, i128 q) : i32
{
    if (p < q) { -1 } else if (p > q) { 1 } else { 0 }
}

fn holds(BinOp op, i32 o) : bool
{
    match (op)
    {
        BinOp::Eq : o == 0,
        BinOp::Ne : o != 0,
        BinOp::Lt : o < 0,
        BinOp::Le : o <= 0,
        BinOp::Gt : o > 0,
        _         : o >= 0,
    }
}

// `spec/06`'s checked operation in type `k` (the result typed `rt`).
fn int_op(BinOp op, i128 p, i128 q, IntTy k, Option<IntTy> rt) : Result<CVal, String>
{
    Option<i128> r = None;
    if (op == BinOp::Add)
    {
        r = checked_add(p, q);
    }
    else if (op == BinOp::Sub)
    {
        r = checked_sub(p, q);
    }
    else if (op == BinOp::Mul)
    {
        r = checked_mul(p, q);
    }
    else if (op == BinOp::Div || op == BinOp::Rem)
    {
        if (q == 0)
        {
            return Err("diag.div-by-zero");
        }
        if (int_ty_signed(k) && q == -1 && p == int_range(k).min)
        {
            return Err("diag.div-overflow");
        }
        r = if (op == BinOp::Div) { checked_div(p, q) } else { checked_rem(p, q) };
    }
    else if (op == BinOp::BitAnd)
    {
        r = Some(p & q);
    }
    else if (op == BinOp::BitOr)
    {
        r = Some(p | q);
    }
    else if (op == BinOp::BitXor)
    {
        r = Some(p ^ q);
    }
    else
    {
        return Err("diag.unsupported-in-selfhost");
    }
    match (r)
    {
        Some(v) : typed(v, Some(k)),
        None    : Err("diag.arith-overflow"),
    }
}

fn shown(ref<CVal, shared> v) : Result<String, String>
{
    match (v)
    {
        CVal::VInt(iv) : Ok(sprintf("%v", iv.v)),
        CVal::VBool(b) : Ok(if (*b) { "true" } else { "false" }),
        CVal::VStr(s)  : Ok(String::clone(s)),
        _              : Err("diag.unsupported-in-selfhost"),
    }
}

// The message: `%v`, `%d`, `%s` and `%%` (other specifiers are not met in
// a static assertion's message yet).
fn render(ref<String, shared> f, ref<Vec<CVal>, shared> vals) : Result<String, String>
{
    slice<u8, shared> b = StringView::as_bytes(f);
    usize n = slice_len(b);
    String out = String::new();
    usize k = 0;
    usize i = 0;
    usize start = 0;
    while (i < n)
    {
        if (b[i] != b'%')
        {
            i += 1;
            continue;
        }
        String::append(&mut out, &f[start..i]);
        if (i + 1 < n && b[i + 1] == b'%')
        {
            String::append(&mut out, "%");
            i += 2;
            start = i;
            continue;
        }
        if (i + 1 >= n || !(b[i + 1] == b'v' || b[i + 1] == b'd' || b[i + 1] == b's' || b[i + 1] == b'i' || b[i + 1] == b'u'))
        {
            return Err("diag.unsupported-in-selfhost");
        }
        if (k >= Vec::len(vals))
        {
            return not_const_s();
        }
        String::append(&mut out, &shown(&vals[k])?);
        k += 1;
        i += 2;
        start = i;
    }
    String::append(&mut out, &f[start..n]);
    Ok(out)
}

fn not_const_s() : Result<String, String>
{
    Err("diag.const-not-constant")
}

// Each assertion in turn: the first false one, or the first whose
// condition fails, is the program's error (at its line).
export fn check_static_asserts(ref<Items, shared> it, ref<Vec<StaticAssert>, shared> asserts) : Result<void, String>
{
    for (usize i = 0; i < Vec::len(asserts); i += 1)
    {
        ref<StaticAssert, shared> a = &asserts[i];
        Ev ev = Ev { .subst = clone(&a.subst), .depth = 0, .lit = None };
        match (eval(&mut ev, it, &a.cond))
        {
            Ok(CVal::VBool(true))  : {},
            Ok(CVal::VBool(false)) :
            {
                Option<String> text = match (&a.message_fmt)
                {
                    Some(fe) : match (eval(&mut ev, it, fe))
                    {
                        Ok(CVal::VStr(t)) : Some(t),
                        Ok(_)             : return Err(sprintf("diag.type-mismatch@%v", a.line)),
                        Err(d)            : return Err(sprintf("%s@%v", &d, a.line)),
                    },
                    None : clone(&a.message),
                };
                return Err(match (text)
                {
                    Some(m) : sprintf("diag.static-assert-failed\u{1}%s@%v", &m, a.line),
                    None    : sprintf("diag.static-assert-failed@%v", a.line),
                });
            },
            Ok(_)                  : return Err(sprintf("diag.type-mismatch@%v", a.line)),
            Err(d)                 : return Err(sprintf("%s@%v", &d, a.line)),
        }
    }
    Ok(())
}

// `[Const-Checked-Failure]` (`rule.module.const`, spec/17 §1a): each of the
// program's constants that did not fold to a literal (one using `min_value`,
// `sizeof`, `widen`, … of constants) computed as an assertion's condition
// is; a checked failure in it (an overflow, a division by zero, a value
// that does not fit) is the program's error, at the constant (the first in
// the source). A form this does not compute is left to the run, as before.
export fn check_const_items(ref<Items, shared> it) : Result<void, String>
{
    Option<String> first = None;
    usize first_line = 0;
    for (usize i = 0; i < HashMap::len(&it.fns); i += 1)
    {
        ref<FnDecl, shared> f = HashMap::value_at(&it.fns, i);
        if (!f.is_const || Vec::len(&f.type_params) != 0 || StringView::starts_with(HashMap::key_at(&it.fns, i), "std::"))
        {
            continue;
        }
        Ev ev = Ev { .subst = HashMap::new(), .depth = 0, .lit = int_of_ty(&f.ret) };
        String d = match (eval_block(&mut ev, it, &f.body))
        {
            Ok(_)  : String::new(),
            Err(e) : e,
        };
        if (StringView::len(&d) == 0)
        {
            continue;
        }
        if (d == "diag.const-not-constant" || d == "diag.unsupported-in-selfhost")
        {
            continue;
        }
        if (Option::is_none(&first) || f.line < first_line)
        {
            first = Some(d);
            first_line = f.line;
        }
    }
    match (first)
    {
        Some(d) : Err(sprintf("%s@%v", &d, first_line)),
        None    : Ok(()),
    }
}

// Bug 013: the value of the constant `name` of the program (an array length
// the parser deferred, `alen$N`), computed over `it` as a `usize`.
export fn const_usize(ref<Items, shared> it, ref<String, shared> name) : Result<u128, String>
{
    ref<FnDecl, shared> f = match (HashMap::get(&it.fns, name))
    {
        Some(x) : x,
        None    : return Err("diag.const-not-constant"),
    };
    Ev ev = Ev { .subst = HashMap::new(), .depth = 0, .lit = Some(IntTy::Usize) };
    match (eval_block(&mut ev, it, &f.body)?)
    {
        CVal::VInt(iv) : if (iv.v >= 0) { Ok(reinterpret<u128>(iv.v)) } else { Err("diag.const-not-constant") },
        _              : Err("diag.type-mismatch"),
    }
}
