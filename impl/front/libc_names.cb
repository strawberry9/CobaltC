// The C names an entry point (`extern fn` with a body, spec/20 [Extern-Entry])
// cannot take: C's keywords and the macros the generated C's headers define,
// the functions and objects of the C library (GNU libc 2.35's libc and libm,
// which hold the threads' and the dynamic loader's functions too), and the
// names the runtime itself calls on every target it is built for. An entry
// is a C symbol in the one name space C has: with one of these names it would
// be refused by the C compiler, or would silently take the C library's place
// for the whole process, the runtime's own calls included.

import std;

// Whether `name` is one of them (a name that begins with `_` is the C
// implementation's in any case, C11 7.1.3, and the caller refuses it apart).
export fn c_library_name(StringView name) : bool
{
    slice<u8, shared> b = StringView::as_bytes(name);
    if (slice_len(b) == 0)
    {
        return false;
    }
    StringView group = c_names_from(b[0]);
    slice<u8, shared> gb = StringView::as_bytes(group);
    usize n = slice_len(b);
    usize len = slice_len(gb);
    usize i = 0;
    while (i < len)
    {
        usize j = i;
        while (j < len && gb[j] != b' ')
        {
            j += 1;
        }
        if (j - i == n && &group[i..j] == name)
        {
            return true;
        }
        i = j + 1;
    }
    false
}

// The names that begin with the byte `c`, one space between, sorted.
fn c_names_from(u8 c) : StringView
{
    match (c)
    {
        b'A' : "AcquireSRWLockExclusive AcquireSRWLockShared",
        b'B' : "BCryptGenRandom",
        b'C' : "CloseHandle CompareStringOrdinal CopyFileExW CreateDirectoryW CreateFileW CreatePipe CreateProcessW CreateThread",
        b'D' : "DeleteFileW DuplicateHandle",
        b'E' : "EOF EXIT_FAILURE EXIT_SUCCESS",
        b'F' : "FP_ILOGB0 FP_ILOGBNAN FP_INFINITE FP_NAN FP_NORMAL FP_SUBNORMAL FP_ZERO FindClose FindFirstFileW FindNextFileW FlsAlloc FlsGetValue FlsSetValue FlushFileBuffers FreeEnvironmentStringsW",
        b'G' : "GLIBC_PRIVATE GetCommandLineW GetComputerNameExW GetConsoleMode GetCurrentDirectoryW GetCurrentProcess GetCurrentProcessId GetCurrentThreadId GetEnvironmentStringsW GetEnvironmentVariableW GetExitCodeProcess GetFileAttributesW GetFileInformationByHandle GetFileInformationByHandleEx GetFileSizeEx GetFileType GetFinalPathNameByHandleW GetFullPathNameW GetLastError GetModuleFileNameW GetModuleHandleW GetProcAddress GetStdHandle GetSystemDirectoryW GetSystemInfo GetSystemTimeAsFileTime GetTempPathW GetTimeZoneInformationForYear GetWindowsDirectoryW",
        b'H' : "HUGE_VAL HUGE_VALF HUGE_VALL",
        b'I' : "INFINITY INT16_MAX INT16_MIN INT32_MAX INT32_MIN INT64_MAX INT64_MIN INT8_MAX INT8_MIN INTMAX_MAX INTMAX_MIN INTPTR_MAX INTPTR_MIN InitOnceExecuteOnce InitializeConditionVariable InitializeSRWLock",
        b'M' : "MATH_ERREXCEPT MATH_ERRNO MB_CUR_MAX M_1_PI M_2_PI M_2_SQRTPI M_E M_LN10 M_LN2 M_LOG10E M_LOG2E M_PI M_PI_2 M_PI_4 M_SQRT1_2 M_SQRT2 MoveFileExW",
        b'N' : "NAN NULL",
        b'P' : "PTRDIFF_MAX PTRDIFF_MIN",
        b'Q' : "QueryPerformanceCounter QueryPerformanceFrequency",
        b'R' : "RAND_MAX ReadConsoleW ReadFile ReleaseSRWLockExclusive ReleaseSRWLockShared RemoveDirectoryW",
        b'S' : "SIG_ATOMIC_MAX SIG_ATOMIC_MIN SIZE_MAX SetConsoleCtrlHandler SetConsoleMode SetCurrentDirectoryW SetFileAttributesW SetFilePointerEx SetHandleInformation SetLastError Sleep SleepConditionVariableSRW SwitchToThread SystemTimeToTzSpecificLocalTime",
        b'T' : "TerminateProcess TryAcquireSRWLockExclusive TryAcquireSRWLockShared",
        b'U' : "UINT16_MAX UINT32_MAX UINT64_MAX UINT8_MAX UINTMAX_MAX UINTPTR_MAX",
        b'V' : "VirtualQuery",
        b'W' : "WCHAR_MAX WCHAR_MIN WINT_MAX WINT_MIN WSADuplicateSocketW WSAGetLastError WSAPoll WSASocketW WSAStartup WaitForSingleObject WakeAllConditionVariable WakeConditionVariable WriteConsoleW WriteFile",
        b'a' : "a64l abort abs accept accept4 access acct acos acosf acosf128 acosf32 acosf32x acosf64 acosf64x acosh acoshf acoshf128 acoshf32 acoshf32x acoshf64 acoshf64x acoshl acosl addmntent addseverity adjtime adjtimex advance aio_cancel aio_cancel64 aio_error aio_error64 aio_fsync aio_fsync64 aio_init aio_read aio_read64 aio_return aio_return64 aio_suspend aio_suspend64 aio_write aio_write64 alarm alignas aligned_alloc alignof alphasort alphasort64 arch_prctl argp_err_exit_status argp_error argp_failure argp_help argp_parse argp_program_bug_address argp_program_version argp_program_version_hook argp_state_help argp_usage argz_add argz_add_sep argz_append argz_count argz_create argz_create_sep argz_delete argz_extract argz_insert argz_next argz_replace argz_stringify asctime asctime_r asin asinf asinf128 asinf32 asinf32x asinf64 asinf64x asinh asinhf asinhf128 asinhf32 asinhf32x asinhf64 asinhf64x asinhl asinl asm asprintf assert atan atan2 atan2f atan2f128 atan2f32 atan2f32x atan2f64 atan2f64x atan2l atanf atanf128 atanf32 atanf32x atanf64 atanf64x atanh atanhf atanhf128 atanhf32 atanhf32x atanhf64 atanhf64x atanhl atanl atof atoi atol atoll authdes_create authdes_getucred authdes_pk_create authnone_create authunix_create authunix_create_default auto",
