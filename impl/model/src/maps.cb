// Ordered maps and sets: the keys kept sorted in a `Vec` (a key type's
// own order, which is that of Rust's derived `Ord`: field by field, an
// enum by its variants' order), found by binary search. Iteration is in
// key order. Every module of the model that needs such a collection uses
// these.

import std;

export struct SMap<K, V>
{
    export Vec<K> keys;
    export Vec<V> vals;
}

export fn SMap::new<K, V>() : SMap<K, V>
{
    SMap { .keys = Vec::new(), .vals = Vec::new() }
}

export fn SMap::len<K, V>(ref<SMap<K, V>, shared> m) : usize
{
    Vec::len(&m.keys)
}

// The position of `k`, or where it would go.
export fn SMap::search<K: ordered, V>(ref<SMap<K, V>, shared> m, ref<K, shared> k) : Result<usize, usize>
{
    usize lo = 0;
    usize hi = Vec::len(&m.keys);
    while (lo < hi)
    {
        usize mid = lo + (hi - lo) / 2;
        if (m.keys[mid] < *k)
        {
            lo = mid + 1;
        }
        else
        {
            hi = mid;
        }
    }
    if (lo < Vec::len(&m.keys) && m.keys[lo] == *k)
    {
        return Ok(lo);
    }
    Err(lo)
}

export fn SMap::find<K: ordered, V>(ref<SMap<K, V>, shared> m, ref<K, shared> k) : Option<usize>
{
    match (SMap::search(m, k))
    {
        Ok(i)  : Some(i),
        Err(_) : None,
    }
}

export fn SMap::contains<K: ordered, V>(ref<SMap<K, V>, shared> m, ref<K, shared> k) : bool
{
    match (SMap::search(m, k))
    {
        Ok(_)  : true,
        Err(_) : false,
    }
}

// Inserts or replaces; the position of the entry.
export fn SMap::insert<K: ordered, V>(ref<SMap<K, V>, exclusive> m, K k, V v) : usize
{
    match (SMap::search(m, &k))
    {
        Ok(i)  :
        {
            m.vals[i] = v;
            i
        },
        Err(i) :
        {
            Vec::insert(&mut m.keys, i, k);
            Vec::insert(&mut m.vals, i, v);
            i
        },
    }
}

export fn SMap::remove<K: ordered, V>(ref<SMap<K, V>, exclusive> m, ref<K, shared> k) : Option<V>
{
    match (SMap::search(m, k))
    {
        Ok(i)  :
        {
            _ = Vec::remove(&mut m.keys, i);
            Some(Vec::remove(&mut m.vals, i))
        },
        Err(_) : None,
    }
}

export fn SMap::remove_at<K, V>(ref<SMap<K, V>, exclusive> m, usize i) : V
{
    _ = Vec::remove(&mut m.keys, i);
    Vec::remove(&mut m.vals, i)
}

export fn SMap::clear<K, V>(ref<SMap<K, V>, exclusive> m)
{
    Vec::clear(&mut m.keys);
    Vec::clear(&mut m.vals);
}

export struct SSet<K>
{
    export Vec<K> keys;
}

export fn SSet::new<K>() : SSet<K>
{
    SSet { .keys = Vec::new() }
}

export fn SSet::len<K>(ref<SSet<K>, shared> s) : usize
{
    Vec::len(&s.keys)
}

export fn SSet::search<K: ordered>(ref<SSet<K>, shared> s, ref<K, shared> k) : Result<usize, usize>
{
    usize lo = 0;
    usize hi = Vec::len(&s.keys);
    while (lo < hi)
    {
        usize mid = lo + (hi - lo) / 2;
        if (s.keys[mid] < *k)
        {
            lo = mid + 1;
        }
        else
        {
            hi = mid;
        }
    }
    if (lo < Vec::len(&s.keys) && s.keys[lo] == *k)
    {
        return Ok(lo);
    }
    Err(lo)
}

export fn SSet::contains<K: ordered>(ref<SSet<K>, shared> s, ref<K, shared> k) : bool
{
    match (SSet::search(s, k))
    {
        Ok(_)  : true,
        Err(_) : false,
    }
}

// Adds `k`: whether it was new.
export fn SSet::insert<K: ordered>(ref<SSet<K>, exclusive> s, K k) : bool
{
    match (SSet::search(s, &k))
    {
        Ok(_)  : false,
        Err(i) :
        {
            Vec::insert(&mut s.keys, i, k);
            true
        },
    }
}

export fn SSet::remove<K: ordered>(ref<SSet<K>, exclusive> s, ref<K, shared> k) : bool
{
    match (SSet::search(s, k))
    {
        Ok(i)  :
        {
            _ = Vec::remove(&mut s.keys, i);
            true
        },
        Err(_) : false,
    }
}

export fn SSet::eq<K: eq>(ref<SSet<K>, shared> a, ref<SSet<K>, shared> b) : bool
{
    Vec::eq(&a.keys, &b.keys)
}

// `contains` of a set of names, by a view of the name.
export fn sset_has(ref<SSet<String>, shared> s, StringView k) : bool
{
    usize lo = 0;
    usize hi = Vec::len(&s.keys);
    while (lo < hi)
    {
        usize mid = lo + (hi - lo) / 2;
        StringView x = &s.keys[mid];
        if (x < k)
        {
            lo = mid + 1;
        }
        else
        {
            hi = mid;
        }
    }
    if (lo < Vec::len(&s.keys))
    {
        StringView x = &s.keys[lo];
        return x == k;
    }
    false
}

export fn SSet::clear<K>(ref<SSet<K>, exclusive> s)
{
    Vec::clear(&mut s.keys);
}
