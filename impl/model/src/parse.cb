// Reads the fragment's concrete syntax: what `print.cb` writes, and
// hand-written cases in the same subset. Anything outside the subset is an
// error naming the line, never a guess.

import std;
import ast;

enum Tok
{
    Ident(String),
    Int(i64),
    Str(String),
    Punct(str),
}

struct TokL
{
    Tok tok;
    usize line;
}

const usize NPUNCTS = 19;

fn puncts() : array<str, 19>
{
    ["::", "{", "}", "(", ")", ";", ",", "..", ".", "=", "+", ">", "<", "&", "*", ":", "[", "]", "_"]
}

// Rust's `u8::is_ascii_whitespace`: space, tab, line feed, form feed and
// carriage return (not the vertical tab).
fn rust_space(u8 c) : bool
{
    c == b' ' || c == b'\t' || c == b'\n' || c == 0x0C || c == b'\r'
}

fn starts_with_at(slice<u8, shared> b, usize i, str p) : bool
{
    usize n = str_len(p);
    if (i + n > slice_len(b))
    {
        return false;
    }
    for (usize k = 0; k < n; k += 1)
    {
        if (b[i + k] != str_byte(p, k))
        {
            return false;
        }
    }
    true
}

// A byte as Rust's `c as char` writes it: the code point of that value.
fn push_byte_char(ref<String, exclusive> s, u8 c)
{
    String::push_code_point(s, widen<u32>(c));
}

fn lex(StringView src) : Result<Vec<TokL>, String>
{
    slice<u8, shared> b = StringView::as_bytes(src);
    usize n = slice_len(b);
    usize i = 0;
    usize line = 1;
    Vec<TokL> toks = Vec::new();
    while (i < n)
    {
        u8 c = b[i];
        if (c == b'\n')
        {
            line += 1;
            i += 1;
        }
        else if (rust_space(c))
        {
            i += 1;
        }
        else if (c == b'/' && i + 1 < n && b[i + 1] == b'/')
        {
            while (i < n && b[i] != b'\n')
            {
                i += 1;
            }
        }
        else if (ascii_is_digit(c))
        {
            usize s = i;
            while (i < n && ascii_is_digit(b[i]))
            {
                i += 1;
            }
            match (StringView::parse<i64>(&src[s..i]))
            {
                Ok(k)  : Vec::push(&mut toks, TokL { .tok = Tok::Int(k), .line = line }),
                Err(_) : return Err(sprintf("line %d: bad number", line)),
            }
        }
        else if (ascii_is_alpha(c) || (c == b'_' && i + 1 < n && ascii_is_alnum(b[i + 1])))
        {
            usize s = i;
            while (i < n && (ascii_is_alnum(b[i]) || b[i] == b'_'))
            {
                i += 1;
            }
            Vec::push(&mut toks, TokL { .tok = Tok::Ident(String::copy(&src[s..i])), .line = line });
        }
        else if (c == b'"')
        {
            usize s = i + 1;
            i += 1;
            while (i < n && b[i] != b'"')
            {
                if (b[i] == b'\\')
                {
                    i += 1;
                }
                i += 1;
            }
            usize e = i;
            if (e > n)
            {
                e = n;
            }
            Vec::push(&mut toks, TokL { .tok = Tok::Str(String::copy(&src[s..e])), .line = line });
            i += 1;
        }
        else
        {
            bool found = false;
            foreach (p in puncts())
            {
                if (!found && starts_with_at(b, i, p))
                {
                    Vec::push(&mut toks, TokL { .tok = Tok::Punct(p), .line = line });
                    i += str_len(p);
                    found = true;
                }
            }
            if (!found)
            {
                String m = sprintf("line %d: unexpected `", line);
                push_byte_char(&mut m, c);
                String::append(&mut m, "`");
                return Err(m);
            }
        }
    }
    Ok(toks)
}

// Rust's `{:?}` of a string: quoted, with its escapes.
export fn debug_str(StringView s) : String
{
    String o = "\"";
    slice<u8, shared> bytes = StringView::as_bytes(s);
    usize n = slice_len(bytes);
    usize i = 0;
    while (i < n)
    {
        u8 x = bytes[i];
        i += 1;
        if (x >= 0x80)
        {
            // Report 438: a character beyond ASCII is kept as it is, as
            // Rust's `{:?}` keeps it (the run of its bytes ends at the next
            // ASCII byte, a character boundary).
            usize from = i - 1;
            while (i < n && bytes[i] >= 0x80)
            {
                i += 1;
            }
            String::append(&mut o, &s[from..i]);
        }
        else if (x == b'"')
        {
            String::append(&mut o, "\\\"");
        }
        else if (x == b'\\')
        {
            String::append(&mut o, "\\\\");
        }
        else if (x == b'\n')
        {
            String::append(&mut o, "\\n");
        }
        else if (x == b'\r')
        {
            String::append(&mut o, "\\r");
        }
        else if (x == b'\t')
        {
            String::append(&mut o, "\\t");
        }
        else if (x == 0)
        {
            String::append(&mut o, "\\0");
        }
        else if (x < 0x20 || x == 0x7F)
        {
            String::appendf(&mut o, "\\u{%x}", x);
        }
        else
        {
            String::push_ascii(&mut o, x);
        }
    }
    String::push_ascii(&mut o, b'"');
    o
}

// The bytes of `o` taken whole: a valid string stays valid.
fn tok_debug(ref<Tok, shared> t) : String
{
    match (t)
    {
        Tok::Ident(s) : sprintf("Ident(%s)", &debug_str(s)),
        Tok::Int(k)   : sprintf("Int(%d)", *k),
        Tok::Str(s)   : sprintf("Str(%s)", &debug_str(s)),
        Tok::Punct(p) : sprintf("Punct(%s)", &debug_str(*p)),
    }
}

struct P
{
    Vec<TokL> toks;
    usize i;
}

fn P::peek(ref<P, shared> p) : Option<Tok>
{
    if (p.i < Vec::len(&p.toks))
    {
        return Some(clone(&p.toks[p.i].tok));
    }
    None
}

fn P::peek2(ref<P, shared> p) : Option<Tok>
{
    if (p.i + 1 < Vec::len(&p.toks))
    {
        return Some(clone(&p.toks[p.i + 1].tok));
    }
    None
}

fn P::at_end(ref<P, shared> p) : bool
{
    p.i >= Vec::len(&p.toks)
}

fn P::line(ref<P, shared> p) : usize
{
    if (p.i < Vec::len(&p.toks))
    {
        return p.toks[p.i].line;
    }
    usize n = Vec::len(&p.toks);
    if (n > 0)
    {
        return p.toks[n - 1].line;
    }
    0
}

fn P::err(ref<P, shared> p, StringView what) : String
{
    String found = match (P::peek(p))
    {
        Some(t) : sprintf("Some(%s)", &tok_debug(&t)),
        None    : "None",
    };
    sprintf("line %d: %s (found %s)", P::line(p), what, &found)
}

fn P::is(ref<P, shared> p, str q) : bool
{
    if (p.i >= Vec::len(&p.toks))
    {
        return false;
    }
    match (&p.toks[p.i].tok)
    {
        Tok::Punct(x) : *x == q,
        _             : false,
    }
}

fn P::is_word(ref<P, shared> p, StringView w) : bool
{
    if (p.i >= Vec::len(&p.toks))
    {
        return false;
    }
    match (&p.toks[p.i].tok)
    {
        Tok::Ident(x) : *x == w,
        _             : false,
    }
}

fn P::eat(ref<P, exclusive> p, str q) : Result<void, String>
{
    if (P::is(p, q))
    {
        p.i += 1;
        return Ok(());
    }
    Err(P::err(p, &sprintf("expected `%s`", q)))
}

fn P::eat_word(ref<P, exclusive> p, str w) : Result<void, String>
{
    if (P::is_word(p, w))
    {
        p.i += 1;
        return Ok(());
    }
    Err(P::err(p, &sprintf("expected `%s`", w)))
}

fn P::ident(ref<P, exclusive> p) : Result<String, String>
{
    match (P::peek(p))
    {
        Some(Tok::Ident(s)) :
        {
            p.i += 1;
            Ok(s)
        },
        _                   : Err(P::err(p, "expected a name")),
    }
}

fn P::int_lit(ref<P, shared> p) : Option<i64>
{
    match (P::peek(p))
    {
        Some(Tok::Int(k)) : Some(k),
        _                 : None,
    }
}

fn P::mode(ref<P, exclusive> p) : Result<Mode, String>
{
    String w = P::ident(p)?;
    if (w == "shared")
    {
        return Ok(Mode::Shared);
    }
    if (w == "exclusive")
    {
        return Ok(Mode::Excl);
    }
    Err(sprintf("line %d: expected a mode", P::line(p)))
}

fn P::ty(ref<P, exclusive> p) : Result<Ty, String>
{
    String w = P::ident(p)?;
    if (w == "i32")
    {
        return Ok(Ty::I32);
    }
    if (w == "void")
    {
        return Ok(Ty::Unit);
    }
    if (w == "Hold")
    {
        return Ok(Ty::Hold);
    }
    if (w == "Job")
    {
        return Ok(Ty::Job);
    }
    if (w == "array")
    {
        P::eat(p, "<")?;
        P::eat_word(p, "i32")?;
        P::eat(p, ",")?;
        match (P::int_lit(p))
        {
            Some(2) : p.i += 1,
            _       : return Err(P::err(p, "the fragment's arrays are array<i32, 2>")),
        }
        P::eat(p, ">")?;
        return Ok(Ty::Arr);
    }
    if (w == "handle")
    {
        P::eat(p, "<")?;
        Ty t = P::ty(p)?;
        P::eat(p, ">")?;
        return Ok(Ty::Handle(Box::new(t)));
    }
    if (w == "slice")
    {
        P::eat(p, "<")?;
        P::eat_word(p, "i32")?;
        P::eat(p, ",")?;
        Mode m = P::mode(p)?;
        P::eat(p, ">")?;
        return Ok(Ty::Slice(m));
    }
    // `fn() : τ`
    if (w == "fn")
    {
        P::eat(p, "(")?;
        P::eat(p, ")")?;
        P::eat(p, ":")?;
        Ty t = P::ty(p)?;
        return Ok(Ty::Fn(Box::new(t)));
    }
    if (w == "Channel")
    {
        P::eat(p, "<")?;
        Ty t = P::ty(p)?;
        P::eat(p, ">")?;
        return Ok(Ty::Chan(Box::new(t)));
    }
    if (w == "mutex")
    {
        P::eat(p, "<")?;
        P::eat_word(p, "i32")?;
        P::eat(p, ">")?;
        return Ok(Ty::Mutex);
    }
    if (w == "Atomic")
    {
        P::eat(p, "<")?;
        P::eat_word(p, "i32")?;
        P::eat(p, ">")?;
        return Ok(Ty::Atomic);
    }
    if (w == "Vec")
    {
        P::eat(p, "<")?;
        Ty t = P::ty(p)?;
        P::eat(p, ">")?;
        if (ty_eq(&t, &Ty::I32))
        {
            return Ok(Ty::Vec);
        }
        if (ty_eq(&t, &Ty::refi(Mode::Excl)))
        {
            return Ok(Ty::VecR);
        }
        if (ty_eq(&t, &Ty::handle_of(Ty::Unit)))
        {
            return Ok(Ty::VecH);
        }
        return Err(sprintf("line %d: Vec<%s> is outside the fragment", P::line(p), &Ty::text(&t)));
    }
    if (w == "ref")
    {
        P::eat(p, "<")?;
        Ty t = P::ty(p)?;
        P::eat(p, ",")?;
        Mode m = P::mode(p)?;
        P::eat(p, ">")?;
        return Ok(Ty::Ref { .t = Box::new(t), .m = m });
    }
    Err(sprintf("line %d: type `%s` is outside the fragment", P::line(p), &w))
}

fn P::starts_type(ref<P, shared> p) : bool
{
    Option<Tok> a = P::peek(p);
    Option<Tok> b = P::peek2(p);
    match (&a)
    {
        Some(Tok::Ident(w)) : match (&b)
        {
            Some(Tok::Ident(_)) : *w == "i32" || *w == "Hold" || *w == "Job",
            Some(Tok::Punct(q)) :
            {
                if (*q == "<")
                {
                    return *w == "ref" || *w == "Vec" || *w == "mutex" || *w == "Channel" || *w == "handle" || *w == "slice" || *w == "array" || *w == "Atomic";
                }
                if (*q == "(")
                {
                    return *w == "fn";
                }
                false
            },
            _                   : false,
        },
        _ : false,
    }
}

fn P::block(ref<P, exclusive> p) : Result<Block, String>
{
    P::eat(p, "{")?;
    Block b = Block::empty();
    while (true)
    {
        if (P::is(p, "}"))
        {
            b.end_line = P::line(p);
            p.i += 1;
            return Ok(b);
        }
        usize line = P::line(p);
        // A trailing expression: an expression followed by `}`.
        usize save = p.i;
        if (!P::is(p, "{") && !P::is(p, "_") && !P::is_word(p, "if") && !P::is_word(p, "while") && !P::is_word(p, "match") && !P::is_word(p, "auto") && !P::is_word(p, "printf") && !P::starts_type(p))
        {
            Expr e = P::expr(p)?;
            if (P::is(p, "}"))
            {
                b.tail = Some(e);
                b.tail_line = line;
                continue;
            }
            p.i = save;
        }
        Stmt s = P::stmt(p)?;
        Vec::push(&mut b.stmts, s);
    }
    Ok(b)
}

fn P::stmt(ref<P, exclusive> p) : Result<Stmt, String>
{
    usize line = P::line(p);
    StmtK kind = StmtK::Break;
    if (P::is(p, "{"))
    {
        kind = StmtK::Block(P::block(p)?);
    }
    else if (P::is(p, "_"))
    {
        p.i += 1;
        P::eat(p, "=")?;
        Expr e = P::expr(p)?;
        P::eat(p, ";")?;
        kind = StmtK::Discard(e);
    }
    else if (P::is_word(p, "match"))
    {
        p.i += 1;
        P::eat(p, "(")?;
        Expr scrut = P::expr(p)?;
        P::eat(p, ")")?;
        P::eat(p, "{")?;
        P::eat_word(p, "Some")?;
        P::eat(p, "(")?;
        String binder = P::ident(p)?;
        P::eat(p, ")")?;
        P::eat(p, ":")?;
        Block some = P::block(p)?;
        P::eat(p, ",")?;
        P::eat_word(p, "None")?;
        P::eat(p, ":")?;
        Block none = P::block(p)?;
        P::eat(p, ",")?;
        P::eat(p, "}")?;
        kind = StmtK::Match { .scrut = scrut, .binder = binder, .some = some, .none = none };
    }
    else if (P::is_word(p, "if"))
    {
        p.i += 1;
        P::eat(p, "(")?;
        Expr cond = P::expr(p)?;
        P::eat(p, ")")?;
        Block thn = P::block(p)?;
        Option<Block> els = None;
        if (P::is_word(p, "else"))
        {
            p.i += 1;
            els = Some(P::block(p)?);
        }
        kind = StmtK::If { .cond = cond, .thn = thn, .els = els };
    }
    else if (P::is_word(p, "break") || P::is_word(p, "continue"))
    {
        if (P::is_word(p, "break"))
        {
            kind = StmtK::Break;
        }
        else
        {
            kind = StmtK::Continue;
        }
        p.i += 1;
        P::eat(p, ";")?;
    }
    else if (P::is_word(p, "while"))
    {
        p.i += 1;
        P::eat(p, "(")?;
        Expr cond = P::expr(p)?;
        P::eat(p, ")")?;
        Block body = P::block(p)?;
        kind = StmtK::While { .cond = cond, .body = body };
    }
    else if (P::is_word(p, "auto") || P::starts_type(p))
    {
        Option<Ty> ty = None;
        if (P::is_word(p, "auto"))
        {
            p.i += 1;
        }
        else
        {
            ty = Some(P::ty(p)?);
        }
        String name = P::ident(p)?;
        P::eat(p, "=")?;
        Expr init = P::expr(p)?;
        P::eat(p, ";")?;
        kind = StmtK::Let { .name = name, .ty = ty, .init = init };
    }
    else if (P::is_word(p, "printf"))
    {
        p.i += 1;
        P::eat(p, "(")?;
        bool ok = match (P::peek(p))
        {
            Some(Tok::Str(s)) : s == "%v\\n",
            _                 : false,
        };
        if (!ok)
        {
            return Err(P::err(p, "expected \"%v\\n\""));
        }
        p.i += 1;
        P::eat(p, ",")?;
        Expr e = P::expr(p)?;
        P::eat(p, ")")?;
        P::eat(p, ";")?;
        kind = StmtK::Print(e);
    }
    else
    {
        Expr e = P::expr(p)?;
        if (P::is(p, "="))
        {
            p.i += 1;
            Expr v = P::expr(p)?;
            P::eat(p, ";")?;
            kind = StmtK::Assign { .place = e, .value = v };
        }
        else
        {
            P::eat(p, ";")?;
            kind = StmtK::Expr(e);
        }
    }
    Ok(Stmt { .id = 0, .k = kind, .line = line })
}

fn P::expr(ref<P, exclusive> p) : Result<Expr, String>
{
    Expr a = P::add(p)?;
    if (P::is(p, ">"))
    {
        p.i += 1;
        Expr b = P::add(p)?;
        return Ok(mk(ExprK::Gt { .a = Box::new(a), .b = Box::new(b) }));
    }
    Ok(a)
}

fn P::add(ref<P, exclusive> p) : Result<Expr, String>
{
    Expr a = P::unary(p)?;
    while (P::is(p, "+"))
    {
        p.i += 1;
        Expr b = P::unary(p)?;
        a = mk(ExprK::Add { .a = Box::new(a), .b = Box::new(b) });
    }
    Ok(a)
}

fn P::unary(ref<P, exclusive> p) : Result<Expr, String>
{
    if (P::is(p, "&"))
    {
        p.i += 1;
        Mode m = Mode::Shared;
        if (P::is_word(p, "mut"))
        {
            p.i += 1;
            m = Mode::Excl;
        }
        Expr e = P::unary(p)?;
        // `&_m v[lo .. hi]` is a slice (`[Slice-Form]`), not a borrow
        // of a place.
        match (&e.k)
        {
            ExprK::Call { f, xs } :
            {
                if (*f == "$range")
                {
                    String v = match (&xs[0].k)
                    {
                        ExprK::Var(n) : clone(n),
                        _             : "",
                    };
                    i64 lo = match (&xs[1].k)
                    {
                        ExprK::Int(k) : *k,
                        _             : 0,
                    };
                    i64 hi = match (&xs[2].k)
                    {
                        ExprK::Int(k) : *k,
                        _             : 0,
                    };
                    return Ok(mk(ExprK::Slice { .m = m, .v = v, .lo = lo, .hi = hi }));
                }
            },
            _                     : {},
        }
        return Ok(mk(ExprK::Borrow { .m = m, .e = Box::new(e) }));
    }
    if (P::is(p, "*"))
    {
        p.i += 1;
        Expr e = P::unary(p)?;
        return Ok(mk(ExprK::Deref(Box::new(e))));
    }
    P::postfix(p)
}

fn P::args(ref<P, exclusive> p) : Result<Vec<Expr>, String>
{
    P::eat(p, "(")?;
    Vec<Expr> xs = Vec::new();
    while (!P::is(p, ")"))
    {
        Vec::push(&mut xs, P::expr(p)?);
        if (P::is(p, ","))
        {
            p.i += 1;
        }
    }
    p.i += 1;
    Ok(xs)
}

fn is_deref(ref<Expr, shared> e) : bool
{
    match (&e.k)
    {
        ExprK::Deref(_) : true,
        _               : false,
    }
}

fn P::postfix(ref<P, exclusive> p) : Result<Expr, String>
{
    Expr e = P::primary(p)?;
    while (true)
    {
        if (P::is(p, "."))
        {
            p.i += 1;
            P::eat_word(p, "r")?;
            e = mk(ExprK::Field(Box::new(e)));
        }
        else if (P::is(p, "["))
        {
            String v = match (&e.k)
            {
                ExprK::Var(n) : clone(n),
                _             : return Err(P::err(p, "an index applies to a Vec binding")),
            };
            p.i += 1;
            i64 k = match (P::int_lit(p))
            {
                Some(k) : k,
                None    : return Err(P::err(p, "expected a literal index")),
            };
            p.i += 1;
            if (P::is(p, ".."))
            {
                // A range, only as `&`'s operand (`[Slice-Not-Borrowed]`).
                p.i += 1;
                i64 hi = match (P::int_lit(p))
                {
                    Some(k) : k,
                    None    : return Err(P::err(p, "expected a literal bound")),
                };
                p.i += 1;
                P::eat(p, "]")?;
                Vec<Expr> xs = Vec::new();
                Vec::push(&mut xs, ex_var(&v));
                Vec::push(&mut xs, ex_int(k));
                Vec::push(&mut xs, ex_int(hi));
                e = mk(ExprK::Call { .f = "$range", .xs = xs });
                continue;
            }
            P::eat(p, "]")?;
            e = mk(ExprK::Index { .v = v, .k = k });
        }
        else if (P::is(p, "(") && is_deref(&e))
        {
            // `(*f)()`: a call of the closure `*f` reaches.
            Vec<Expr> xs = P::args(p)?;
            if (Vec::len(&xs) != 0)
            {
                return Err(P::err(p, "a closure of the fragment takes no arguments"));
            }
            e = mk(ExprK::CallVal(Box::new(e)));
        }
        else
        {
            return Ok(e);
        }
    }
    Ok(e)
}

fn P::primary(ref<P, exclusive> p) : Result<Expr, String>
{
    match (P::peek(p))
    {
        Some(Tok::Int(k))   :
        {
            p.i += 1;
            Ok(ex_int(k))
        },
        Some(Tok::Punct(q)) :
        {
            if (q == "(")
            {
                p.i += 1;
                Expr e = P::expr(p)?;
                P::eat(p, ")")?;
                return Ok(e);
            }
            if (q == "[" && P::closure_ahead(p))
            {
                return P::closure(p, false);
            }
            if (q == "[")
            {
                p.i += 1;
                Vec<Expr> xs = Vec::new();
                while (!P::is(p, "]"))
                {
                    Vec::push(&mut xs, P::expr(p)?);
                    if (P::is(p, ","))
                    {
                        p.i += 1;
                    }
                }
                p.i += 1;
                return Ok(mk(ExprK::ArrLit(xs)));
            }
            Err(P::err(p, "expected an expression"))
        },
        Some(Tok::Ident(w)) :
        {
            p.i += 1;
            if (w == "Vec" || w == "Mutex" || w == "Channel" || w == "Atomic")
            {
                P::eat(p, "::")?;
                String f = P::ident(p)?;
                Vec<Expr> xs = P::args(p)?;
                return Ok(mk(ExprK::Call { .f = sprintf("%s::%s", &w, &f), .xs = xs }));
            }
            if (w == "move")
            {
                return P::closure(p, true);
            }
            if (w == "Job")
            {
                P::eat(p, "{")?;
                P::eat(p, ".")?;
                P::eat_word(p, "h")?;
                P::eat(p, "=")?;
                Expr e = P::expr(p)?;
                P::eat(p, "}")?;
                return Ok(mk(ExprK::JobLit(Box::new(e))));
            }
            if (w == "Hold")
            {
                P::eat(p, "{")?;
                P::eat(p, ".")?;
                P::eat_word(p, "r")?;
                P::eat(p, "=")?;
                Expr e = P::expr(p)?;
                P::eat(p, "}")?;
                return Ok(mk(ExprK::HoldLit(Box::new(e))));
            }
            if (w == "spawn")
            {
                P::eat(p, "(")?;
                if (P::is(p, "[") || P::is_word(p, "move"))
                {
                    Expr c = P::primary(p)?;
                    P::eat(p, ")")?;
                    return Ok(mk(ExprK::SpawnClo(Box::new(c))));
                }
                String f = P::ident(p)?;
                Vec<Expr> xs = Vec::new();
                while (P::is(p, ","))
                {
                    p.i += 1;
                    Vec::push(&mut xs, P::expr(p)?);
                }
                P::eat(p, ")")?;
                return Ok(mk(ExprK::Spawn { .f = f, .xs = xs }));
            }
            if (w == "join")
            {
                P::eat(p, "(")?;
                String t = P::ident(p)?;
                P::eat(p, ")")?;
                return Ok(mk(ExprK::Join(t)));
            }
            if (P::is(p, "("))
            {
                Vec<Expr> xs = P::args(p)?;
                return Ok(mk(ExprK::Call { .f = w, .xs = xs }));
            }
            Ok(mk(ExprK::Var(w)))
        },
        _                   : Err(P::err(p, "expected an expression")),
    }
}

// `[x, …](`: a closure's capture list, not an array literal.
fn P::closure_ahead(ref<P, shared> p) : bool
{
    usize j = p.i + 1;
    while (true)
    {
        if (j >= Vec::len(&p.toks))
        {
            return false;
        }
        match (&p.toks[j].tok)
        {
            Tok::Ident(_) : j += 1,
            Tok::Punct(q) :
            {
                if (*q == ",")
                {
                    j += 1;
                }
                else if (*q == "]")
                {
                    if (j + 1 >= Vec::len(&p.toks))
                    {
                        return false;
                    }
                    return match (&p.toks[j + 1].tok)
                    {
                        Tok::Punct(r) : *r == "(",
                        _             : false,
                    };
                }
                else
                {
                    return false;
                }
            },
            _             : return false,
        }
    }
    false
}

// `move? [x, …]() (: τ)? { … }` (the `move` already read when `mv`).
fn P::closure(ref<P, exclusive> p, bool mv) : Result<Expr, String>
{
    P::eat(p, "[")?;
    Vec<String> caps = Vec::new();
    while (!P::is(p, "]"))
    {
        Vec::push(&mut caps, P::ident(p)?);
        if (P::is(p, ","))
        {
            p.i += 1;
        }
    }
    p.i += 1;
    P::eat(p, "(")?;
    P::eat(p, ")")?;
    Ty ret = Ty::Unit;
    if (P::is(p, ":"))
    {
        p.i += 1;
        ret = P::ty(p)?;
    }
    Block body = P::block(p)?;
    Ok(mk(ExprK::Closure(Box::new(Clo { .id = 0, .mv = mv, .caps = caps, .ret = ret, .body = body }))))
}

fn P::func(ref<P, exclusive> p) : Result<Func, String>
{
    usize line = P::line(p);
    P::eat_word(p, "fn")?;
    String name = P::ident(p)?;
    P::eat(p, "(")?;
    Vec<ParamDecl> params = Vec::new();
    while (!P::is(p, ")"))
    {
        Ty t = P::ty(p)?;
        String n = P::ident(p)?;
        Vec::push(&mut params, ParamDecl { .ty = t, .name = n });
        if (P::is(p, ","))
        {
            p.i += 1;
        }
    }
    p.i += 1;
    Ty ret = Ty::Unit;
    if (P::is(p, ":"))
    {
        p.i += 1;
        ret = P::ty(p)?;
    }
    // D-0312: `from p`, the parameter the result's references come from.
    usize src = 0;
    if (P::is_word(p, "from"))
    {
        p.i += 1;
        String n = P::ident(p)?;
        for (usize k = 0; k < Vec::len(&params); k += 1)
        {
            if (params[k].name == n)
            {
                src = k;
                break;
            }
        }
    }
    Block body = P::block(p)?;
    Ok(Func { .name = name, .params = params, .ret = ret, .body = body, .line = line, .src = src })
}

fn is_word_tok(ref<Option<Tok>, shared> t, StringView w) : bool
{
    match (t)
    {
        Some(Tok::Ident(x)) : *x == w,
        _                   : false,
    }
}

export fn parse(StringView src) : Result<Program, String>
{
    Vec<TokL> toks = lex(src)?;
    P p = P { .toks = toks, .i = 0 };
    Program prog = Program::empty();
    while (!P::at_end(&p))
    {
        if (P::is_word(&p, "import"))
        {
            p.i += 1;
            P::eat_word(&mut p, "std")?;
            P::eat(&mut p, ";")?;
        }
        else if (P::is_word(&p, "struct") && is_word_tok(&P::peek2(&p), "Job"))
        {
            p.i += 2;
            P::eat(&mut p, "{")?;
            Ty t = P::ty(&mut p)?;
            if (!ty_eq(&t, &Ty::handle_of(Ty::Unit)))
            {
                return Err(P::err(&p, "Job's field is handle<void>"));
            }
            P::eat_word(&mut p, "h")?;
            P::eat(&mut p, ";")?;
            P::eat(&mut p, "}")?;
            prog.job = true;
        }
        else if (P::is_word(&p, "static"))
        {
            // D-0258: `static Atomic<i32> NAME = k;`
            p.i += 1;
            P::eat_word(&mut p, "Atomic")?;
            P::eat(&mut p, "<")?;
            P::eat_word(&mut p, "i32")?;
            P::eat(&mut p, ">")?;
            String name = P::ident(&mut p)?;
            P::eat(&mut p, "=")?;
            bool neg = P::is(&p, "-");
            if (neg)
            {
                p.i += 1;
            }
            i64 k = match (P::int_lit(&p))
            {
                Some(k) : k,
                None    : return Err(P::err(&p, "a static's first value is a literal")),
            };
            p.i += 1;
            P::eat(&mut p, ";")?;
            if (neg)
            {
                k = -k;
            }
            Vec::push(&mut prog.statics, StaticDecl { .name = name, .k = k });
        }
        else if (P::is_word(&p, "struct"))
        {
            p.i += 1;
            P::eat_word(&mut p, "Hold")?;
            P::eat(&mut p, "{")?;
            Ty t = P::ty(&mut p)?;
            if (!ty_eq(&t, &Ty::refi(Mode::Excl)))
            {
                return Err(P::err(&p, "Hold's field is ref<i32, exclusive>"));
            }
            P::eat_word(&mut p, "r")?;
            P::eat(&mut p, ";")?;
            P::eat(&mut p, "}")?;
            prog.hold = true;
        }
        else
        {
            Vec::push(&mut prog.funcs, P::func(&mut p)?);
        }
    }
    if (!Program::has_func(&prog, "main"))
    {
        return Err("no `fn main()`");
    }
    resolve(&mut prog);
    number_program(&mut prog);
    Ok(prog)
}

fn builtins() : array<str, 20>
{
    [
        "Vec::new",
        "Vec::push",
        "Vec::pop",
        "Vec::index_exclusive",
        "Mutex::new",
        "lock",
        "Channel::new",
        "Channel::send",
        "Channel::recv",
        "Channel::close",
        "swap",
        "replace",
        "$range",
        "print",
        "Atomic::new",
        "Atomic::load",
        "Atomic::store",
        "Atomic::fetch_add",
        "Atomic::wait",
        "Atomic::notify_all",
    ]
}

fn is_builtin(StringView f) : bool
{
    foreach (b in builtins())
    {
        if (f == b)
        {
            return true;
        }
    }
    false
}

// After the whole program is read: `c()` naming no function is a call of
// the closure binding `c`, and `spawn(c)` a thread running it; closure
// literals are numbered in source order.
fn resolve(ref<Program, exclusive> prog)
{
    Vec<String> fnames = Vec::new();
    foreach (f in &prog.funcs)
    {
        Vec::push(&mut fnames, clone(&f.name));
    }
    usize next = 0;
    foreach (f in &mut prog.funcs)
    {
        res_block(&mut f.body, &fnames, &mut next);
    }
}

fn res_expr(ref<Expr, exclusive> e, ref<Vec<String>, shared> fnames, ref<usize, exclusive> next)
{
    Option<ExprK> repl = None;
    match (&mut e.k)
    {
        ExprK::Call { f, xs }     :
        {
            if (Vec::len(xs) == 0 && !contains_str(fnames, f) && !is_builtin(f))
            {
                repl = Some(ExprK::CallVal(Box::new(ex_var(f))));
            }
            else
            {
                foreach (x in xs)
                {
                    res_expr(x, fnames, next);
                }
            }
        },
        ExprK::Spawn { f, xs }    :
        {
            if (Vec::len(xs) == 0 && !contains_str(fnames, f))
            {
                repl = Some(ExprK::SpawnClo(Box::new(ex_var(f))));
            }
            else
            {
                foreach (x in xs)
                {
                    res_expr(x, fnames, next);
                }
            }
        },
        ExprK::ArrLit(xs)         :
        {
            foreach (x in xs)
            {
                res_expr(x, fnames, next);
            }
        },
        ExprK::Closure(c)         :
        {
            Box::get_mut(c).id = *next;
            *next += 1;
            res_block(&mut Box::get_mut(c).body, fnames, next);
        },
        ExprK::Deref(a)           : res_expr(Box::get_mut(a), fnames, next),
        ExprK::Field(a)           : res_expr(Box::get_mut(a), fnames, next),
        ExprK::Borrow { m, e: a } : res_expr(Box::get_mut(a), fnames, next),
        ExprK::HoldLit(a)         : res_expr(Box::get_mut(a), fnames, next),
        ExprK::JobLit(a)          : res_expr(Box::get_mut(a), fnames, next),
        ExprK::CallVal(a)         : res_expr(Box::get_mut(a), fnames, next),
        ExprK::SpawnClo(a)        : res_expr(Box::get_mut(a), fnames, next),
        ExprK::Add { a, b }       :
        {
            res_expr(Box::get_mut(a), fnames, next);
            res_expr(Box::get_mut(b), fnames, next);
        },
        ExprK::Gt { a, b }        :
        {
            res_expr(Box::get_mut(a), fnames, next);
            res_expr(Box::get_mut(b), fnames, next);
        },
        _                         : {},
    }
    match (repl)
    {
        Some(k) : e.k = k,
        None    : {},
    }
}

fn res_stmt(ref<Stmt, exclusive> s, ref<Vec<String>, shared> fnames, ref<usize, exclusive> next)
{
    match (&mut s.k)
    {
        StmtK::Let { name, ty, init }              : res_expr(init, fnames, next),
        StmtK::Assign { place, value }             :
        {
            res_expr(place, fnames, next);
            res_expr(value, fnames, next);
        },
        StmtK::Expr(e)                             : res_expr(e, fnames, next),
        StmtK::Print(e)                            : res_expr(e, fnames, next),
        StmtK::Discard(e)                          : res_expr(e, fnames, next),
        StmtK::Block(b)                            : res_block(b, fnames, next),
        StmtK::If { cond, thn, els }               :
        {
            res_expr(cond, fnames, next);
            res_block(thn, fnames, next);
            match (els)
            {
                Some(b) : res_block(b, fnames, next),
                None    : {},
            }
        },
        StmtK::While { cond, body }                :
        {
            res_expr(cond, fnames, next);
            res_block(body, fnames, next);
        },
        StmtK::Match { scrut, binder, some, none } :
        {
            res_expr(scrut, fnames, next);
            res_block(some, fnames, next);
            res_block(none, fnames, next);
        },
        StmtK::Break                               : {},
        StmtK::Continue                            : {},
    }
}

fn res_block(ref<Block, exclusive> b, ref<Vec<String>, shared> fnames, ref<usize, exclusive> next)
{
    foreach (s in &mut b.stmts)
    {
        res_stmt(s, fnames, next);
    }
    match (&mut b.tail)
    {
        Some(t) : res_expr(t, fnames, next),
        None    : {},
    }
}
