// hand-written case: a move closure holding an exclusive reference called through a shared reference ([Read-Fn-Through-Shared])
// MODEL: diag.borrow-exceeds-source (dynamic) line 12
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn call_shared(ref<fn() : void, shared> f)
{
    (*f)();
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    {
        auto r = &mut x;
        auto k = move [r]() { *r = *r + 1; };
        call_shared(&k);
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
