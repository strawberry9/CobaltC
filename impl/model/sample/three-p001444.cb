// the three-statement enumeration
// MODEL: [1 3] ok
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<i32> v1 = Vec::new();
    if (x > 1)
    {
        bump(&mut y);
    }
    else
    {
        y = y + 1;
    }
    Hold h1 = Hold { .r = &mut x };
    printf("%v\n", x);
    printf("%v\n", y);
}
