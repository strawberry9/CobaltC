// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 15
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = &mut x;
    auto r2 = &mut x;
    Hold h1 = Hold { .r = r1 };
    printf("%v\n", x);
    printf("%v\n", y);
}
