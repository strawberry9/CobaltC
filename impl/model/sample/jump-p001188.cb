import std;

struct Job
{
    handle<void> h;
}

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Job j1 = Job { .h = spawn(bump, &mut x) };
    {
        i32 i = 0;
        while (2 > i)
        {
            i = i + 1;
            auto t9 = spawn(bump, &mut x);
            if (i > 1)
            {
                break;
            }
        }
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
