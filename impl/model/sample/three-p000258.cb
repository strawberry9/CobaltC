// the three-statement enumeration
// MODEL: [1] diag.aliasing-conflict (dynamic) line 19
// MODEL: [1 3] ok
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = &mut y;
    auto t1 = spawn(bump, r1);
    r1 = &mut x;
    printf("%v\n", x);
    printf("%v\n", y);
}
