// hand-written case: a spawned move closure is lent its captured reference; the spawner writes through it meanwhile
// MODEL: diag.aliasing-conflict (dynamic) line 18
// MODEL: [9 2] ok
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    {
        auto r = &mut x;
        auto t = spawn(move [r]() { *r = *r + 7; });
        *r = *r + 1;
        join(t);
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
