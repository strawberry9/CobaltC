// hand-written case: a move closure copies x while a Vec holds an exclusive reference to it (CHG-0301: coby took the copy unchecked)
// MODEL: diag.aliasing-conflict (dynamic) line 10
import std;

fn main()
{
    i32 x = 1;
    Vec<ref<i32, exclusive>> w1 = Vec::new();
    Vec::push(&mut w1, &mut x);
    auto mk1 = move [x]() : i32 { x = x + 1; x };
    printf("%v\n", mk1());
    *w1[0] = 5;
    printf("%v\n", mk1());
}
