// hand-written case
// MODEL: diag.aliasing-conflict (dynamic) line 7
import std;

fn set(ref<Vec<i32>, exclusive> v)
{
    *Vec::index_exclusive(v, 0) = 9;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<i32> w = Vec::new();
    Vec::push(&mut w, 1);
    auto r = &mut w;
    auto s = &*r;
    set(r);
    _ = s;
    printf("%v\n", x);
    printf("%v\n", y);
}
