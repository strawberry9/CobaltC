// MODEL: diag.aliasing-conflict (static) line 16
import std;

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = pass(&mut y);
    auto r2 = &mut *r1;
    printf("%v\n", *r1);
    printf("%v\n", x);
    printf("%v\n", y);
}
