// the three-statement enumeration
// MODEL: [2 2] diag.deadlock (dynamic) line 12
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn take_one(ref<Channel<ref<i32, exclusive>>, shared> ch)
{
    match (Channel::recv(ch))
    {
        Some(r) : { *r = *r + 100; },
        None    : {},
    }
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Channel<ref<i32, exclusive>> c1 = Channel::new(1);
    auto t1 = spawn(take_one, &c1);
    bump(&mut x);
    printf("%v\n", x);
    printf("%v\n", y);
}
