// hand-written case: a slice of an array beside a write to the element outside it
// MODEL: [6 7] ok
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn bump_slice(slice<i32, exclusive> s)
{
    s[0] = s[0] + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    array<i32, 2> a = [1, 2];
    auto s = &mut a[0 .. 1];
    a[1] = a[1] + 5;
    s[0] = s[0] + 5;
    printf("%v\n", a[0]);
    printf("%v\n", a[1]);
}
