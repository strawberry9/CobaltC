// hand-written case: a borrow and a thread declared in the loop body end with each pass
// MODEL: [3 4] ok
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    {
        i32 i = 0;
        while (2 > i)
        {
            auto r9 = &mut x;
            *r9 = *r9 + 1;
            auto t9 = spawn(bump, &mut y);
            i = i + 1;
        }
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
