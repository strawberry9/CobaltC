// the three-statement enumeration
// MODEL: [1] diag.aliasing-conflict (dynamic) line 29
// MODEL: [1 3] ok
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn bump_hold(Hold h)
{
    *h.r = *h.r + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = pass(&mut y);
    Hold h1 = Hold { .r = r1 };
    auto t1 = spawn(bump_hold, h1);
    printf("%v\n", x);
    printf("%v\n", y);
}
