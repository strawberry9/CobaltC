// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 15
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto t1 = spawn(bump, &mut x);
    auto t2 = spawn(bump, &mut x);
    Vec<i32> v1 = Vec::new();
    printf("%v\n", x);
    printf("%v\n", y);
}
