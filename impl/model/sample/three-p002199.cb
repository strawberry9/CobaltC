// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 16
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<ref<i32, exclusive>> w1 = Vec::new();
    auto t1 = spawn(bump, &mut x);
    Vec::push(&mut w1, &mut x);
    printf("%v\n", x);
    printf("%v\n", y);
}
