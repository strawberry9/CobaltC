// hand-written case: the same place pushed into a Vec of exclusive references on each pass
// MODEL: diag.aliasing-conflict (dynamic) line 19
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<ref<i32, exclusive>> w1 = Vec::new();
    {
        i32 i = 0;
        while (2 > i)
        {
            Vec::push(&mut w1, &mut x);
            i = i + 1;
        }
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
