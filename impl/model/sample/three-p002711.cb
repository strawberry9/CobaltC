// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 21
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    bump(&mut y);
    auto t1 = spawn(bump, &mut y);
    {
        auto w = &mut x;
        *w = *w + 1;
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
