// hand-written case: a closure without move borrows its capture exclusively and is called twice (rule.fn.closure)
// MODEL: [3 2] ok
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    {
        auto c = [x]() { x = x + 1; };
        c();
        c();
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
