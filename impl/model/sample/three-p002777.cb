// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 23
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn two(ref<i32, exclusive> a, ref<i32, exclusive> b)
{
    *a = *a + 1;
    *b = *b + 10;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    two(&mut x, &mut y);
    Hold h1 = Hold { .r = &mut x };
    auto q1 = &h1;
    printf("%v\n", x);
    printf("%v\n", y);
}
