// hand-written case: an element lent to a thread, then written: refuted
// MODEL: diag.aliasing-conflict (static) line 22
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn bump_slice(slice<i32, exclusive> s)
{
    s[0] = s[0] + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    array<i32, 2> a = [1, 2];
    a[0] = a[0] + a[1];
    auto t = spawn(bump, &mut a[0]);
    a[0] = 7;
    join(t);
    printf("%v\n", a[0]);
    printf("%v\n", a[1]);
}
