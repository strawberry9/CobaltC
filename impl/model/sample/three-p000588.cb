// the three-statement enumeration
// MODEL: [1 2] ok
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = pass(&mut y);
    Hold h1 = Hold { .r = &mut x };
    r1 = &mut x;
    printf("%v\n", x);
    printf("%v\n", y);
}
