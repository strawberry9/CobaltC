// disagreed once (deadlock detection, containment, block-exit lines, Vec places: D-0219)
// MODEL: [1 2] diag.deadlock (dynamic) line 8
// MODEL: [1 2] diag.deadlock (dynamic) line 20
import std;

fn add_locked(ref<mutex<i32>, shared> m)
{
    auto g = lock(m);
    *g = *g + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    mutex<i32> m1 = Mutex::new(0);
    auto g1 = lock(&m1);
    auto t1 = spawn(add_locked, &m1);
    printf("%v\n", x);
    printf("%v\n", y);
}
