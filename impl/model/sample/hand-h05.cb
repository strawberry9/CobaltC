// hand-written case
// MODEL: diag.aliasing-conflict (static) line 13
import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    Vec::push(&mut v, 3);
    Vec::push(&mut v, 4);
    Hold h = Hold { .r = &mut v[0] };
    Vec::push(&mut v, 5);
    *h.r = 9;
    printf("%v\n", v[0]);
}

struct Hold
{
    ref<i32, exclusive> r;
}
