// the three-statement enumeration
// MODEL: diag.index-out-of-bounds (dynamic) line 14
import std;

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<ref<i32, exclusive>> w1 = Vec::new();
    {
        auto w = &mut x;
        *w = *w + 1;
    }
    *w1[0] = 5;
    printf("%v\n", x);
    printf("%v\n", y);
}
