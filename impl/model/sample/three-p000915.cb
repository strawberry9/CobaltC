// the three-statement enumeration
// MODEL: diag.aliasing-conflict (dynamic) line 17
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Hold h1 = Hold { .r = &mut x };
    auto r1 = &mut y;
    auto q1 = &h1;
    printf("%v\n", x);
    printf("%v\n", y);
}
