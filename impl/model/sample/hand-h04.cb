// hand-written case
// MODEL: diag.aliasing-conflict (dynamic) line 21
// MODEL: [5] ok
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn bump_hold(Hold h)
{
    *h.r = *h.r + 1;
}

fn main()
{
    i32 x = 1;
    Hold h = Hold { .r = &mut x };
    auto t = spawn(bump_hold, h);
    *h.r = 5;
    join(t);
    printf("%v\n", x);
}
