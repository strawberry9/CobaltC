// hand-written (round 6, break/continue): break after redirecting a reference: the loop's exit joins the break's facts (spec/14 §5)
// MODEL: diag.aliasing-conflict (dynamic) line 20
import std;

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r = &mut y;
    i32 i = 0;
    while (2 > i)
    {
        if (i > 0)
        {
            r = &mut x;
            break;
        }
        i = i + 1;
    }
    x = 5;
    *r = *r + 1;
    printf("%v\n", x);
    printf("%v\n", y);
}
