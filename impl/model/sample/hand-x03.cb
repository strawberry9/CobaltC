// hand-written case: a slice copied into a spawned move closure, written by the spawner meanwhile
// MODEL: diag.aliasing-conflict (dynamic) line 20
// MODEL: [1 2] ok
import std;

fn bump_slice(slice<i32, exclusive> s)
{
    s[0] = s[0] + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<i32> v1 = Vec::new();
    Vec::push(&mut v1, 5);
    Vec::push(&mut v1, 6);
    auto sl1 = &mut v1[0 .. 1];
    auto t = spawn(move [sl1]() { sl1[0] = sl1[0] + 1; });
    sl1[0] = 9;
    join(t);
    printf("%v\n", x);
    printf("%v\n", y);
}
