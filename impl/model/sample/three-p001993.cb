// the three-statement enumeration
// MODEL: diag.aliasing-conflict (dynamic) line 17
import std;

fn peek(ref<i32, shared> p) : i32
{
    *p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Channel<ref<i32, exclusive>> c1 = Channel::new(1);
    _ = Channel::send(&c1, &mut x);
    auto t1 = spawn(peek, &y);
    printf("%v\n", x);
    printf("%v\n", y);
}
