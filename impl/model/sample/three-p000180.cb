// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 18
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = &mut y;
    auto r2 = &mut x;
    auto t1 = spawn(bump, r1);
    printf("%v\n", x);
    printf("%v\n", y);
}
