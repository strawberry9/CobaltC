// hand-written case: the review of 2026-10-15, F-01 Program A: a reference copied into a struct, then ended by last use (D-0236)
// MODEL: diag.aliasing-conflict (dynamic) line 17
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r = &mut x;
    Hold h = Hold { .r = r };
    auto q = &h;
    x = 5;
    printf("%v\n", *q.r);
    printf("%v\n", x);
    printf("%v\n", y);
}
