// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 21
import std;

fn peek(ref<i32, shared> p) : i32
{
    *p
}

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = pass(&mut x);
    auto t1 = spawn(peek, &y);
    r1 = &mut y;
    printf("%v\n", x);
    printf("%v\n", y);
}
