// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 21
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Hold h1 = Hold { .r = &mut x };
    auto q1 = &h1;
    bump(&mut x);
    printf("%v\n", x);
    printf("%v\n", y);
}
