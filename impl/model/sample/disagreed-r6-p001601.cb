import std;

fn two(ref<i32, exclusive> a, ref<i32, exclusive> b)
{
    *a = *a + 1;
    *b = *b + 10;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<i32> v1 = Vec::new();
    printf("%v\n", v1[0]);
    auto r1 = &mut v1[0];
    auto r2 = &mut v1[0];
    printf("%v\n", v1[0]);
    two(r1, &mut x);
    printf("%v\n", x);
    printf("%v\n", y);
}
