// hand-written case (D-0253): an exclusive borrow of an atomic a thread holds shared
// MODEL: diag.aliasing-conflict (static) line 13
import std;

fn main()
{
    Atomic<i32> a1 = Atomic::new(0);
    auto r1 = &a1;
    auto h1 = spawn(move [r1]()
    {
        _ = Atomic::fetch_add(r1, 1);
    });
    auto r2 = &mut a1;
    join(h1);
}
