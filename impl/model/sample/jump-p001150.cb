// MODEL: diag.aliasing-conflict (static) line 22
// refused statically since report 313 (D-0337, spec/14 §6): until then a dynamic fault in some schedules, [3 2] ok in others
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<handle<void>> hv1 = Vec::new();
    {
        i32 i = 0;
        while (2 > i)
        {
            i = i + 1;
            if (i > 1)
            {
                Vec::push(&mut hv1, spawn(bump, &mut x));
                continue;
            }
            bump(&mut x);
        }
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
