// hand-written case: a slice written while a thread waits holding its lent reborrow (D-0248)
// MODEL: diag.aliasing-conflict (dynamic) line 18
import std;

fn wait_then_bump(ref<Channel<i32>, shared> c, slice<i32, exclusive> s)
{
    _ = Channel::recv(c);
    s[0] = s[0] + 1;
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 5);
    Channel<i32> ch = Channel::new(1);
    auto s = &mut v[0 .. 1];
    auto t = spawn(wait_then_bump, &ch, s);
    s[0] = 9;
    _ = Channel::send(&ch, 1);
    join(t);
    printf("%v\n", v[0]);
}
