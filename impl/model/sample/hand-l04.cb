// hand-written case: a Vec's element pushed onto it (D-0242: the element borrow ends with its read)
// MODEL: [10 2] ok
import std;

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 10);
    Vec::push(&mut v, v[0]);
    printf("%v\n", v[1]);
    printf("%v\n", y);
}
