// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 21
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn peek(ref<i32, shared> p) : i32
{
    *p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto t1 = spawn(peek, &x);
    auto t2 = spawn(bump, &mut y);
    bump(&mut x);
    printf("%v\n", x);
    printf("%v\n", y);
}
