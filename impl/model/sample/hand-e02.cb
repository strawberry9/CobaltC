// hand-written case: handles in a Vec and in a struct: their holders' destruction waits for each thread (CHG-0293)
// MODEL: [2 3] ok
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

struct Job
{
    handle<void> h;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    {
        Vec<handle<void>> hs = Vec::new();
        Vec::push(&mut hs, spawn(bump, &mut x));
        Job j = Job { .h = spawn(bump, &mut y) };
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
