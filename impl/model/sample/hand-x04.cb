// hand-written case: a closure writing through a captured slice, beside a thread lent the other half
// MODEL: [7 1 2] ok
import std;

fn bump_slice(slice<i32, exclusive> s)
{
    s[0] = s[0] + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<i32> v1 = Vec::new();
    Vec::push(&mut v1, 5);
    Vec::push(&mut v1, 6);
    {
        auto sl1 = &mut v1[0 .. 1];
        auto cl = [sl1]() { sl1[0] = sl1[0] + 1; };
        cl();
        auto t = spawn(bump_slice, &mut v1[1 .. 2]);
        cl();
        join(t);
    }
    printf("%v\n", v1[0]);
    printf("%v\n", x);
    printf("%v\n", y);
}
