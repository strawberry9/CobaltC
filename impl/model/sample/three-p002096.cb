// the three-statement enumeration
// MODEL: diag.channel-deadlock (dynamic) line 16
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Channel<ref<i32, exclusive>> c1 = Channel::new(1);
    bump(&mut y);
    match (Channel::recv(&c1))
    {
        Some(k) : { *k = *k + 1; },
        None    : {},
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
