// the three-statement enumeration
// MODEL: [1 3] ok
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn peek(ref<i32, shared> p) : i32
{
    *p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Hold h1 = Hold { .r = &mut x };
    bump(&mut y);
    auto t1 = spawn(peek, &y);
    printf("%v\n", x);
    printf("%v\n", y);
}
