// hand-written case: an owning closure moved within call_twice, then called empty ([Fn-Value-Empty-Call])
// MODEL: diag.stale-binding (dynamic) line 9
import std;

fn call_twice(fn() : void f)
{
    auto g = f;
    g();
    f();
}

fn main()
{
    i32 x = 1;
    Vec<i32> v1 = Vec::new();
    auto mk = move [v1]() { Vec::push(&mut v1, 1); };
    call_twice(mk);
    printf("%v\n", x);
}
