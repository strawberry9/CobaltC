// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 23
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn peek(ref<i32, shared> p) : i32
{
    *p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto t1 = spawn(peek, &y);
    mutex<i32> m1 = Mutex::new(0);
    if (x > 1)
    {
        bump(&mut y);
    }
    else
    {
        y = y + 1;
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
