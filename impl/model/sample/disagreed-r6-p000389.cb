// disagreed once (deadlock detection, containment, block-exit lines, Vec places: D-0219)
// MODEL: diag.deadlock (dynamic) line 18
// MODEL: diag.deadlock (dynamic) line 34
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn peek(ref<i32, shared> p) : i32
{
    *p
}

fn take_one(ref<Channel<ref<i32, exclusive>>, shared> ch)
{
    match (Channel::recv(ch))
    {
        Some(r) : { *r = *r + 100; },
        None    : {},
    }
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Channel<ref<i32, exclusive>> c1 = Channel::new(1);
    bump(&mut x);
    auto s1 = &x;
    auto t1 = spawn(peek, &y);
    auto t2 = spawn(take_one, &c1);
    match (Channel::recv(&c1))
    {
        Some(k) : { *k = *k + 1; },
        None    : {},
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
