// hand-written case: the review's F-02: swap through a reference passed on beside a shared reborrow (D-0235)
// MODEL: diag.aliasing-conflict (dynamic) line 11
import std;

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = &mut x;
    auto s1 = &*r1;
    swap(r1, &mut y);
    printf("%v\n", *s1);
    printf("%v\n", y);
}
