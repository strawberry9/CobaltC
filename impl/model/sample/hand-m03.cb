// hand-written case
// MODEL: [1] diag.mutex-poisoned (dynamic) line 19
// MODEL: [1 0] diag.aliasing-conflict (dynamic) line 14
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn lock_add_hold(ref<mutex<i32>, shared> m, ref<Hold, shared> h)
{
    auto g = lock(m);
    *g = *g + *h.r;
}

fn read_locked(ref<mutex<i32>, shared> m) : i32
{
    auto g = lock(m);
    *g
}

fn main()
{
    i32 x = 5;
    Hold h1 = Hold { .r = &mut x };
    mutex<i32> m1 = Mutex::new(0);
    auto t1 = spawn(lock_add_hold, &m1, &h1);
    printf("%v\n", 1);
    printf("%v\n", read_locked(&m1));
    join(t1);
}
