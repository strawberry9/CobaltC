// cobc ran it unchecked before D-0219's fix (an argument passed on while reborrowed)
// MODEL: diag.aliasing-conflict (dynamic) line 7
import std;

fn two(ref<i32, exclusive> a, ref<i32, exclusive> b)
{
    *a = *a + 1;
    *b = *b + 10;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = &mut y;
    auto s1 = &*r1;
    two(r1, &mut x);
    printf("%v\n", x);
    printf("%v\n", y);
}
