// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 20
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn bump_hold(Hold h)
{
    *h.r = *h.r + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Hold h1 = Hold { .r = &mut x };
    x = x + 1;
    auto t1 = spawn(bump_hold, h1);
    printf("%v\n", x);
    printf("%v\n", y);
}
