// hand-written case: a reference pushed into a vector, then its block ends (D-0236)
// MODEL: diag.aliasing-conflict (dynamic) line 14
import std;

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<ref<i32, exclusive>> v = Vec::new();
    {
        auto r = &mut x;
        Vec::push(&mut v, r);
    }
    x = 5;
    printf("%v\n", x);
    printf("%v\n", y);
}
