// hand-written case: a guard moved into a spawned closure: its lock path is not lent (D-0240)
// MODEL: diag.aliasing-conflict (dynamic) line 17
import std;

fn bump_slice(slice<i32, exclusive> s)
{
    s[0] = s[0] + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    mutex<i32> m1 = Mutex::new(0);
    {
        auto g1 = lock(&m1);
        auto t = spawn(move [g1]() { *g1 = *g1 + 1; });
        join(t);
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
