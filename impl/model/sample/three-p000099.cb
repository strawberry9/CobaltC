// the three-statement enumeration
// MODEL: diag.channel-deadlock (dynamic) line 11
import std;

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = &mut x;
    Channel<ref<i32, exclusive>> c1 = Channel::new(1);
    match (Channel::recv(&c1))
    {
        Some(k) : { *k = *k + 1; },
        None    : {},
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
