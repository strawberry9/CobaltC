// hand-written case: a closure writing through a captured guard; the mutex locked again after
// MODEL: [2 1 2] ok
import std;

fn bump_slice(slice<i32, exclusive> s)
{
    s[0] = s[0] + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    mutex<i32> m1 = Mutex::new(0);
    {
        auto g1 = lock(&m1);
        auto cl = [g1]() { *g1 = *g1 + 1; };
        cl();
        cl();
    }
    auto g2 = lock(&m1);
    printf("%v\n", *g2);
    printf("%v\n", x);
    printf("%v\n", y);
}
