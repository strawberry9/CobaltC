import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<ref<i32, exclusive>> w1 = Vec::new();
    Hold h1 = Hold { .r = &mut x };
    *w1[0] = 5;
    printf("%v\n", x);
    printf("%v\n", y);
}
