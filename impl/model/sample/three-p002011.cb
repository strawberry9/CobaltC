// the three-statement enumeration
// MODEL: diag.aliasing-conflict (dynamic) line 16
import std;

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Channel<ref<i32, exclusive>> c1 = Channel::new(1);
    _ = Channel::send(&c1, &mut y);
    auto r1 = pass(&mut y);
    printf("%v\n", x);
    printf("%v\n", y);
}
