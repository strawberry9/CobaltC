// hand-written case: a reference reassigned in a loop to a place it already borrows: the old loan
// ends at its last read (D-0341 `[Ref-Reassign-Releases]`), so the program runs
// MODEL: [2 13] ok
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = &mut x;
    {
        i32 i = 0;
        while (2 > i)
        {
            *r1 = *r1 + 1;
            r1 = &mut y;
            i = i + 1;
        }
    }
    *r1 = *r1 + 10;
    printf("%v\n", x);
    printf("%v\n", y);
}
