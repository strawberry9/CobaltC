// hand-written case
// MODEL: diag.deadlock (dynamic) line 8
// MODEL: diag.deadlock (dynamic) line 17
import std;

fn add_locked(ref<mutex<i32>, shared> m)
{
    auto g = lock(m);
    *g = *g + 1;
}

fn main()
{
    mutex<i32> m1 = Mutex::new(0);
    auto g1 = lock(&m1);
    auto t1 = spawn(add_locked, &m1);
    join(t1);
    printf("%v\n", *g1);
}
