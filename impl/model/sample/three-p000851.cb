// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 23
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto s1 = &y;
    auto t1 = spawn(bump, &mut y);
    Hold h1 = Hold { .r = &mut x };
    printf("%v\n", x);
    printf("%v\n", y);
}
