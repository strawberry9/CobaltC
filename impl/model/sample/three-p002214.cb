// the three-statement enumeration
// MODEL: diag.index-out-of-bounds (dynamic) line 16
import std;

fn peek(ref<i32, shared> p) : i32
{
    *p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<ref<i32, exclusive>> w1 = Vec::new();
    auto t1 = spawn(peek, &y);
    *w1[0] = 5;
    printf("%v\n", x);
    printf("%v\n", y);
}
