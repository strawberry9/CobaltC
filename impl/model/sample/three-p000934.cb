// the three-statement enumeration
// MODEL: diag.aliasing-conflict (dynamic) line 28
// MODEL: [2 2] ok
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn bump_hold(Hold h)
{
    *h.r = *h.r + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Hold h1 = Hold { .r = &mut x };
    auto r1 = pass(&mut y);
    auto t1 = spawn(bump_hold, h1);
    printf("%v\n", x);
    printf("%v\n", y);
}
