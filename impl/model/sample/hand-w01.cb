// hand-written case: a reference reassigned inside a loop: deriv facts joined at the back edge leave the second pass's write dynamic
// MODEL: diag.aliasing-conflict (dynamic) line 19
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = &mut y;
    {
        i32 i = 0;
        while (2 > i)
        {
            x = x + 1;
            r1 = &mut x;
            *r1 = 3;
            i = i + 1;
        }
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
