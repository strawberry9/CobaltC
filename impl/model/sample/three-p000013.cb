// the three-statement enumeration
// MODEL: diag.aliasing-conflict (dynamic) line 7
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = &mut x;
    auto r2 = &mut *r1;
    bump(r1);
    printf("%v\n", x);
    printf("%v\n", y);
}
