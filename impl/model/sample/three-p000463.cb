// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 17
import std;

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = pass(&mut x);
    Vec<ref<i32, exclusive>> w1 = Vec::new();
    Vec::push(&mut w1, &mut x);
    printf("%v\n", x);
    printf("%v\n", y);
}
