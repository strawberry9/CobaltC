// hand-written case: a thread spawned on each pass into a Vec of handles, each lent the same place
// MODEL: diag.aliasing-conflict (dynamic) line 20
// MODEL: [3 2] ok
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    {
        Vec<handle<void>> hs = Vec::new();
        i32 i = 0;
        while (2 > i)
        {
            Vec::push(&mut hs, spawn(bump, &mut x));
            i = i + 1;
        }
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
