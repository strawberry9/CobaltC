// the three-statement enumeration
// MODEL: diag.aliasing-conflict (dynamic) line 23
// MODEL: [2 2] ok
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = pass(&mut x);
    auto t1 = spawn(bump, r1);
    r1 = &mut y;
    printf("%v\n", x);
    printf("%v\n", y);
}
