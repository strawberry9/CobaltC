// hand-written case: a closure that locks a mutex the caller already holds
// MODEL: diag.mutex-reentrant-lock (dynamic) line 16
import std;

fn bump_slice(slice<i32, exclusive> s)
{
    s[0] = s[0] + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    mutex<i32> m1 = Mutex::new(0);
    auto g1 = lock(&m1);
    auto cl = [m1]() { auto g9 = lock(&m1); *g9 = *g9 + 1; };
    cl();
    printf("%v\n", x);
    printf("%v\n", y);
}
