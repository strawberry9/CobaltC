// hand-written case: a slice binding sent on a channel, then written by the sender while the receiver may hold it
// MODEL: diag.aliasing-conflict (dynamic) line 25
// MODEL: [1 2] ok
import std;

fn take_slice(ref<Channel<slice<i32, exclusive>>, shared> ch)
{
    match (Channel::recv(ch))
    {
        Some(s) : { s[0] = s[0] + 100; },
        None    : {},
    }
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<i32> v1 = Vec::new();
    Vec::push(&mut v1, 5);
    Channel<slice<i32, exclusive>> cs1 = Channel::new(1);
    auto sl1 = &mut v1[0 .. 1];
    _ = Channel::send(&cs1, sl1);
    auto t1 = spawn(take_slice, &cs1);
    sl1[0] = 9;
    join(t1);
    printf("%v\n", x);
    printf("%v\n", y);
}
