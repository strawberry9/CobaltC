// the three-statement enumeration
// MODEL: [2 2] diag.index-out-of-bounds (dynamic) line 12
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn bump_first(Vec<ref<i32, exclusive>> w)
{
    *w[0] = 9;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<ref<i32, exclusive>> w1 = Vec::new();
    auto t1 = spawn(bump_first, w1);
    bump(&mut x);
    printf("%v\n", x);
    printf("%v\n", y);
}
