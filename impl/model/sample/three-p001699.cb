// the three-statement enumeration
// MODEL: diag.aliasing-conflict (dynamic) line 28
// MODEL: [2 2] ok
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn peek(ref<i32, shared> p) : i32
{
    *p
}

fn bump_hold(Hold h)
{
    *h.r = *h.r + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto t1 = spawn(peek, &y);
    Hold h1 = Hold { .r = &mut x };
    auto t2 = spawn(bump_hold, h1);
    printf("%v\n", x);
    printf("%v\n", y);
}
