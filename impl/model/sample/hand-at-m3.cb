// hand-written case (D-0253): a store without a notification: the wait may sleep through it and deadlock
// MODEL: diag.deadlock (dynamic) line 14
// MODEL: [1] ok
import std;

fn main()
{
    Atomic<i32> a1 = Atomic::new(0);
    auto r1 = &a1;
    auto h1 = spawn(move [r1]()
    {
        Atomic::store(r1, 1);
    });
    Atomic::wait(&a1, 0);
    printf("%v\n", Atomic::load(&a1));
    join(h1);
}
