// hand-written case (D-0253): a spawned thread waits until the main thread stores and notifies
// MODEL: [11] ok
import std;

fn main()
{
    Atomic<i32> a1 = Atomic::new(0);
    auto r1 = &a1;
    auto h1 = spawn(move [r1]()
    {
        Atomic::wait(r1, 0);
        _ = Atomic::fetch_add(r1, 10);
    });
    Atomic::store(&a1, 1);
    Atomic::notify_all(&a1);
    join(h1);
    printf("%v\n", Atomic::load(&a1));
}
