// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 27
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn peek(ref<i32, shared> p) : i32
{
    *p
}

fn two(ref<i32, exclusive> a, ref<i32, exclusive> b)
{
    *a = *a + 1;
    *b = *b + 10;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Hold h1 = Hold { .r = &mut x };
    auto t1 = spawn(peek, &x);
    two(&mut x, &mut y);
    printf("%v\n", x);
    printf("%v\n", y);
}
