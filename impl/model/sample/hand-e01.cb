// hand-written case: a handle moved into a Vec; the referent its thread was lent is written in the same block (D-0244)
// MODEL: diag.aliasing-conflict (dynamic) line 19
// MODEL: [3 2] ok
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    {
        Vec<handle<void>> hs = Vec::new();
        auto t1 = spawn(bump, &mut x);
        Vec::push(&mut hs, t1);
        x = x + 1;
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
