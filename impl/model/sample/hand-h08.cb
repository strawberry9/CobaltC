// hand-written case
// MODEL: diag.aliasing-conflict (static) line 25
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn peek(ref<i32, shared> p) : i32
{
    *p
}

fn two(ref<i32, exclusive> a, ref<i32, exclusive> b)
{
    *a = *a + 1;
    *b = *b + 10;
}

fn main()
{
    i32 x = 1;
    printf("%v\n", peek(&x) + peek(&x));
    two(&mut x, &mut x);
    printf("%v\n", x);
}
