// hand-written case: a closure captures the reference r itself; r reassigned while it lives (D-0243: the table proved the write)
// MODEL: diag.aliasing-conflict (dynamic) line 17
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    {
        auto r = &mut x;
        auto c = [r]() { *r = *r + 1; };
        r = &mut y;
        c();
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
