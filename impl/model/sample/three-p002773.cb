// the three-statement enumeration
// MODEL: [2 12] ok
import std;

fn two(ref<i32, exclusive> a, ref<i32, exclusive> b)
{
    *a = *a + 1;
    *b = *b + 10;
}

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    two(&mut x, &mut y);
    auto s1 = &y;
    auto r1 = pass(&mut y);
    printf("%v\n", x);
    printf("%v\n", y);
}
