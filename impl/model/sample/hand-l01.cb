// hand-written case: two slices of one Vec, one lent to a thread, the other written meanwhile (D-0070, D-0238)
// MODEL: [11 21] ok
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn bump_slice(slice<i32, exclusive> s)
{
    s[0] = s[0] + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 10);
    Vec::push(&mut v, 20);
    auto a = &mut v[0 .. 1];
    auto b = &mut v[1 .. 2];
    auto t = spawn(bump_slice, a);
    b[0] = b[0] + 1;
    join(t);
    printf("%v\n", v[0]);
    printf("%v\n", v[1]);
}
