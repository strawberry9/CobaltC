// the three-statement enumeration
// MODEL: diag.index-out-of-bounds (dynamic) line 15
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<ref<i32, exclusive>> w1 = Vec::new();
    *w1[0] = 5;
    bump(&mut x);
    printf("%v\n", x);
    printf("%v\n", y);
}
