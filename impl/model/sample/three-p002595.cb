// the three-statement enumeration
// MODEL: [2 13] ok
import std;

fn two(ref<i32, exclusive> a, ref<i32, exclusive> b)
{
    *a = *a + 1;
    *b = *b + 10;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    y = y + 1;
    auto r1 = &mut y;
    two(&mut x, &mut y);
    printf("%v\n", x);
    printf("%v\n", y);
}
