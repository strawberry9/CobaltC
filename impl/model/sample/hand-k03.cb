// hand-written case: a self-writing move closure called while a shared borrow of it lives (D-0245: static, as the text says)
// MODEL: diag.aliasing-conflict (static) line 17
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    {
        auto c = move [x]() { x = x + 1; };
        auto f = &c;
        c();
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
