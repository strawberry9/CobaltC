// hand-written (round 6, break/continue): a binding declared in the body ends at the break
// MODEL: [3 2] ok
import std;

fn main()
{
    i32 x = 1;
    i32 y = 2;
    i32 i = 0;
    while (3 > i)
    {
        auto r = &mut x;
        i = i + 1;
        if (i > 1)
        {
            break;
        }
        *r = *r + 1;
    }
    x = x + 1;
    printf("%v\n", x);
    printf("%v\n", y);
}
