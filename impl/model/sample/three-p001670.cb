// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 16
import std;

fn peek(ref<i32, shared> p) : i32
{
    *p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto t1 = spawn(peek, &x);
    {
        auto w = &mut x;
        *w = *w + 1;
    }
    {
        auto w = &mut x;
        *w = *w + 1;
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
