// the three-statement enumeration
// MODEL: diag.aliasing-conflict (dynamic) line 12
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn read_hold(ref<Hold, shared> h) : i32
{
    *h.r
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Hold h1 = Hold { .r = &mut x };
    auto t1 = spawn(read_hold, &h1);
    printf("%v\n", join(t1));
    printf("%v\n", x);
    printf("%v\n", y);
}
