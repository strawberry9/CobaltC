// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 24
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn read_locked(ref<mutex<i32>, shared> m) : i32
{
    auto g = lock(m);
    *g
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    mutex<i32> m1 = Mutex::new(0);
    auto t1 = spawn(bump, &mut y);
    printf("%v\n", read_locked(&m1));
    printf("%v\n", x);
    printf("%v\n", y);
}
