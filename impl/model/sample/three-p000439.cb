// the three-statement enumeration
// MODEL: [1 2] ok
import std;

fn peek(ref<i32, shared> p) : i32
{
    *p
}

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = pass(&mut x);
    auto t1 = spawn(peek, &x);
    auto s1 = &y;
    printf("%v\n", x);
    printf("%v\n", y);
}
