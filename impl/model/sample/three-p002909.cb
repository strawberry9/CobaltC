// the three-statement enumeration
// MODEL: [3 3] ok
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    {
        auto w = &mut x;
        *w = *w + 1;
    }
    bump(&mut y);
    bump(&mut x);
    printf("%v\n", x);
    printf("%v\n", y);
}
