// hand-written case (D-0253): a store with no notification: the waiter may sleep through it, and its contained deadlock reaches join
// MODEL: diag.deadlock (dynamic) line 12
// MODEL: [1] ok
import std;

fn main()
{
    Atomic<i32> a1 = Atomic::new(0);
    auto r1 = &a1;
    auto h1 = spawn(move [r1]()
    {
        Atomic::wait(r1, 0);
    });
    Atomic::store(&a1, 1);
    join(h1);
    printf("%v\n", Atomic::load(&a1));
}
