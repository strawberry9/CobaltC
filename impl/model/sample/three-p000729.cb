// the three-statement enumeration
// MODEL: [2 2] ok
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto s1 = &x;
    auto r1 = pass(&mut x);
    bump(&mut x);
    printf("%v\n", x);
    printf("%v\n", y);
}
