// the three-statement enumeration
// MODEL: diag.aliasing-conflict (dynamic) line 26
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn two(ref<i32, exclusive> a, ref<i32, exclusive> b)
{
    *a = *a + 1;
    *b = *b + 10;
}

fn read_hold(ref<Hold, shared> h) : i32
{
    *h.r
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Hold h1 = Hold { .r = &mut x };
    two(&mut x, &mut y);
    auto t1 = spawn(read_hold, &h1);
    printf("%v\n", x);
    printf("%v\n", y);
}
