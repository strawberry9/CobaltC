// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 15
import std;

fn peek(ref<i32, shared> p) : i32
{
    *p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto t1 = spawn(peek, &x);
    auto r1 = &mut x;
    x = x + 1;
    printf("%v\n", x);
    printf("%v\n", y);
}
