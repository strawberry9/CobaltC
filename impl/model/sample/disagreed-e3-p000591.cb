// disagreed with the model once (model or tool fixed since, D-0219)
// MODEL: diag.aliasing-conflict (dynamic) line 7
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = pass(&mut x);
    auto s1 = &*r1;
    bump(r1);
    printf("%v\n", x);
    printf("%v\n", y);
}
