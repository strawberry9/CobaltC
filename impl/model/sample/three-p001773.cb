// the three-statement enumeration
// MODEL: [0 1 2] ok
import std;

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn read_locked(ref<mutex<i32>, shared> m) : i32
{
    auto g = lock(m);
    *g
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    mutex<i32> m1 = Mutex::new(0);
    auto r1 = pass(&mut y);
    printf("%v\n", read_locked(&m1));
    printf("%v\n", x);
    printf("%v\n", y);
}
