// the three-statement enumeration
// MODEL: [2] diag.aliasing-conflict (dynamic) line 16
import std;

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Channel<ref<i32, exclusive>> c1 = Channel::new(1);
    _ = Channel::send(&c1, &mut y);
    {
        auto w = &mut x;
        *w = *w + 1;
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
