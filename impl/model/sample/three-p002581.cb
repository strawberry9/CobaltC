// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 23
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn two(ref<i32, exclusive> a, ref<i32, exclusive> b)
{
    *a = *a + 1;
    *b = *b + 10;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    bump(&mut x);
    two(&mut x, &mut y);
    auto t1 = spawn(bump, &mut x);
    printf("%v\n", x);
    printf("%v\n", y);
}
