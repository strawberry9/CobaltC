// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 23
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn read_hold(ref<Hold, shared> h) : i32
{
    *h.r
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = &mut y;
    Hold h1 = Hold { .r = r1 };
    auto t1 = spawn(read_hold, &h1);
    printf("%v\n", x);
    printf("%v\n", y);
}
