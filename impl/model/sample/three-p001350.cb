// the three-statement enumeration
// MODEL: diag.index-out-of-bounds (dynamic) line 16
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<i32> v1 = Vec::new();
    bump(&mut x);
    v1[0] = 3;
    printf("%v\n", x);
    printf("%v\n", y);
}
