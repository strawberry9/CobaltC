// hand-written case: a reference read in a loop while the loop writes its referent: refuted at the fixed point
// MODEL: diag.aliasing-conflict (static) line 20
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = &mut x;
    {
        i32 i = 0;
        while (2 > i)
        {
            printf("%v\n", *r1);
            x = x + 1;
            i = i + 1;
        }
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
