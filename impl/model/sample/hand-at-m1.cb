// hand-written case (D-0253): two threads add to one atomic: no increment lost
// MODEL: [2] ok
import std;

fn main()
{
    Atomic<i32> a1 = Atomic::new(0);
    auto r1 = &a1;
    auto h1 = spawn(move [r1]()
    {
        _ = Atomic::fetch_add(r1, 1);
    });
    _ = Atomic::fetch_add(&a1, 1);
    join(h1);
    printf("%v\n", Atomic::load(&a1));
}
