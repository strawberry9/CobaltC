// the three-statement enumeration
// MODEL: diag.aliasing-conflict (dynamic) line 25
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn bump_hold(Hold h)
{
    *h.r = *h.r + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Hold h1 = Hold { .r = &mut x };
    if (x > 1)
    {
        bump(&mut y);
    }
    else
    {
        y = y + 1;
    }
    auto t1 = spawn(bump_hold, h1);
    printf("%v\n", x);
    printf("%v\n", y);
}
