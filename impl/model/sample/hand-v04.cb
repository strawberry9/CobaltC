// hand-written case
// MODEL: diag.aliasing-conflict (dynamic) line 7
import std;

fn bump_first(Vec<ref<i32, exclusive>> w)
{
    *w[0] = 9;
}

fn main()
{
    i32 x = 7;
    Vec<ref<i32, exclusive>> w1 = Vec::new();
    Vec::push(&mut w1, &mut x);
    auto t1 = spawn(bump_first, w1);
    join(t1);
    printf("%v\n", x);
}
