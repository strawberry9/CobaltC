// hand-written case: replace through a reference passed on beside a shared reborrow (D-0235)
// MODEL: diag.aliasing-conflict (static) line 11
import std;

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = &mut x;
    auto s1 = &*r1;
    _ = replace(r1, 9);
    printf("%v\n", *s1);
    printf("%v\n", y);
}
