// hand-written case: an owning closure passed by value, then called (CHG-0302: consumed, static)
// MODEL: diag.stale-binding (static) line 16
import std;

fn call_val(fn() : void f)
{
    f();
}

fn main()
{
    i32 x = 1;
    Vec<i32> v1 = Vec::new();
    auto mk = move [v1]() { Vec::push(&mut v1, 1); };
    call_val(mk);
    mk();
    printf("%v\n", x);
}
