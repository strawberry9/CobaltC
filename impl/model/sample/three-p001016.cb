// the three-statement enumeration
// MODEL: diag.aliasing-conflict (dynamic) line 28
// MODEL: [3 12] ok
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn two(ref<i32, exclusive> a, ref<i32, exclusive> b)
{
    *a = *a + 1;
    *b = *b + 10;
}

fn bump_hold(Hold h)
{
    *h.r = *h.r + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Hold h1 = Hold { .r = &mut x };
    auto t1 = spawn(bump_hold, h1);
    two(&mut x, &mut y);
    printf("%v\n", x);
    printf("%v\n", y);
}
