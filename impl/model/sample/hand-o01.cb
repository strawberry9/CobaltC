// hand-written case: a move closure that owns a vector, called, then passed by value (moved)
// MODEL: [1 2] ok
import std;

fn call_val(fn() : void f)
{
    f();
}

fn call_twice(fn() : void f)
{
    auto g = f;
    g();
    f();
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<i32> v1 = Vec::new();
    auto mk = move [v1]() { Vec::push(&mut v1, 1); };
    mk();
    call_val(mk);
    printf("%v\n", x);
    printf("%v\n", y);
}
