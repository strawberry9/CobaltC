// the three-statement enumeration
// MODEL: diag.aliasing-conflict (dynamic) line 7
import std;

fn two(ref<i32, exclusive> a, ref<i32, exclusive> b)
{
    *a = *a + 1;
    *b = *b + 10;
}

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = pass(&mut x);
    auto r2 = &mut *r1;
    two(r1, r1);
    printf("%v\n", x);
    printf("%v\n", y);
}
