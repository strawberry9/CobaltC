// the three-statement enumeration
// MODEL: diag.reference-escapes-scope (static) line 18
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto t1 = spawn(bump, &mut x);
    auto r1 = &mut y;
    {
        i32 z = 3;
        r1 = &mut z;
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
