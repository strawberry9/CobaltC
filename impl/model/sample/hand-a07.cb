// hand-written case: a shared slice of the whole array, then an exclusive element borrow: refuted
// MODEL: diag.aliasing-conflict (static) line 21
import std;

fn bump(ref<i32, exclusive> p)
{
    *p = *p + 1;
}

fn bump_slice(slice<i32, exclusive> s)
{
    s[0] = s[0] + 1;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    array<i32, 2> a = [1, 2];
    auto s = &a[0 .. 2];
    auto r = &mut a[1];
    *r = s[0];
    printf("%v\n", a[0]);
    printf("%v\n", a[1]);
}
