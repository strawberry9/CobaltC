// hand-written case: swap in another thread through a reference stored in a moved vector (D-0235)
// MODEL: diag.aliasing-conflict (dynamic) line 19
// MODEL: [1 2] diag.aliasing-conflict (dynamic) line 9
import std;

fn swap_first(Vec<ref<i32, exclusive>> w)
{
    i32 z = 100;
    swap(*Vec::index_exclusive(&mut w, 0), &mut z);
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    Vec<ref<i32, exclusive>> w1 = Vec::new();
    Vec::push(&mut w1, &mut x);
    auto t1 = spawn(swap_first, w1);
    printf("%v\n", x);
    printf("%v\n", y);
}
