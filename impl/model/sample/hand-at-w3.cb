// hand-written case (D-0253): two waiters woken by one notify_all
// MODEL: [5] ok
import std;

fn main()
{
    Atomic<i32> a1 = Atomic::new(0);
    auto r1 = &a1;
    auto h1 = spawn(move [r1]()
    {
        Atomic::wait(r1, 0);
    });
    auto h2 = spawn(move [r1]()
    {
        Atomic::wait(r1, 0);
    });
    Atomic::store(&a1, 5);
    Atomic::notify_all(&a1);
    join(h1);
    join(h2);
    printf("%v\n", Atomic::load(&a1));
}
