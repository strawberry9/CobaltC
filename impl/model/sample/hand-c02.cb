// hand-written case
// MODEL: diag.aliasing-conflict (dynamic) line 21
// MODEL: [5] ok
import std;

fn take_one(ref<Channel<ref<i32, exclusive>>, shared> ch)
{
    match (Channel::recv(ch))
    {
        Some(r) : { *r = *r + 100; },
        None    : {},
    }
}

fn main()
{
    i32 x = 1;
    Channel<ref<i32, exclusive>> c1 = Channel::new(1);
    auto t1 = spawn(take_one, &c1);
    _ = Channel::send(&c1, &mut x);
    x = 5;
    join(t1);
    printf("%v\n", x);
}
