// the three-statement enumeration
// MODEL: diag.aliasing-conflict (static) line 20
import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = pass(&mut x);
    Hold h1 = Hold { .r = &mut x };
    auto r2 = &mut *r1;
    printf("%v\n", x);
    printf("%v\n", y);
}
