// the three-statement enumeration
// MODEL: diag.reference-escapes-scope (static) line 18
import std;

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r1 = pass(&mut x);
    r1 = &mut y;
    {
        i32 z = 3;
        r1 = &mut z;
    }
    printf("%v\n", x);
    printf("%v\n", y);
}
