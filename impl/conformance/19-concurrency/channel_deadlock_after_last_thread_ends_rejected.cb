// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.channel [Channel-Deadlock] [Recv]; D-0063; conf.channel-deadlock-late
// kind: negative
// expect: diag.channel-deadlock (dynamic)
//
// The main thread starts waiting on an empty channel while the only
// other thread may still be running; that thread ends without sending
// again. The wait can never finish, which is detected when the thread
// ends, not only when the wait begins.

import std;

fn one(ref<Channel<i32>, shared> ch) : i64
{
    _ = Channel::send(ch, 1);
    i64 s = 0;
    i64 i = 0;
    while (i < 3000)
    {
        s = s + i;
        i = i + 1;
    }
    s
}

fn main()
{
    Channel<i32> ch = Channel::new(1);
    auto h = spawn(one, &ch);
    Channel::recv(&ch);
    Channel::recv(&ch);
    join(h);
}
