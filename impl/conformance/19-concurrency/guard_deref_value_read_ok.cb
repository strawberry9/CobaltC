// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.lock (reading the guarded value through `*g`)
// kind: positive
// expect: ok
//
// `i32 w = *g;` and a function whose tail is `*g`: reading the guarded
// value copies an `i32`. The static pass checked `g` itself in value
// position, as `*r` reads a reference `r`, and a guard is a resource, so
// both were rejected `diag.read-of-resource`. Found by real-world
// testing.

import std;

fn locked(i32 start) : i32
{
    mutex<i32> m = Mutex::new(start);
    guard<i32> g = lock(&m);
    *g
}

fn main()
{
    mutex<i32> m = Mutex::new(7);
    {
        guard<i32> g = lock(&m);
        *g = *g * 6;
    }
    guard<i32> h = lock(&m);
    i32 w = *h;
    if (w != 42 || locked(3) != 3)
    {
        1 / (1 - 1);
    }
}
