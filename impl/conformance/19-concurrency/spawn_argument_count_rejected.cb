// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Spawn] (as many arguments as the function's parameters); conf.spawn-argument-count (D-0232)
// kind: negative
// expect: diag.type-mismatch (static)

fn twice(i32 x) : i32
{
    x * 2
}

fn main()
{
    auto h = spawn(twice, 1, 2);
    _ = join(h);
}
