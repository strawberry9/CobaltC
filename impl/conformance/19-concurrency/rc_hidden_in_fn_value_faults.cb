// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Thread-Confined]; rule.stdlib.rc; diag.not-thread-safe; conf.rc-hidden-in-fn-value
// kind: negative
// expect: diag.not-thread-safe (dynamic)
//
// The static rule sees a capture only where the closure literal reaches
// `spawn`; here the closure is a plain `fn() : usize` value, whose type
// says nothing of what it captured. The `Rc` is used in a thread other
// than the one that made it, which faults (bug 031).

import std;

fn start(fn() : usize f) : handle<usize>
{
    spawn(f)
}

fn main()
{
    Rc<String> a = Rc::new("shared");
    Rc<String> b = Rc::clone(&a);
    handle<usize> h = start(move [b]() : usize { StringView::len(Rc::get(&b)) });
    printf("%v\n", join(h));
}
