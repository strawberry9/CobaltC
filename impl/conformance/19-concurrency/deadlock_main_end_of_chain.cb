// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.guarantee [Deadlock] (b) (the main thread an end of a chain, D-0219, CHG-0258); conf.deadlock-main-end-of-chain
// kind: negative
// expect: diag.deadlock (dynamic)
//
// `take` waits on `a`, `main` on `b`; nothing will send to either. Every
// live thread waits and none can go on, with no cycle: both are ends of a
// chain of waits and both fault. `take`'s fault is contained; `main`'s
// ends the program, at `main`'s wait. Both implementations, once `take`'s
// contained fault had left `main` the only running thread, took `main`'s
// wait for `[Channel-Deadlock]` instead, depending on which woke first.

import std;

fn take(ref<Channel<i32>, shared> ch)
{
    match (Channel::recv(ch))
    {
        Some(v) : printf("%v\n", v),
        None    : {},
    }
}

fn main()
{
    Channel<i32> a = Channel::new(1);
    Channel<i32> b = Channel::new(1);
    auto t = spawn(take, &a);
    match (Channel::recv(&b))
    {
        Some(v) : printf("%v\n", v),
        None    : {},
    }
    join(t);
}
