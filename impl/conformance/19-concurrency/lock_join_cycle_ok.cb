// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: conf.lock-join-cycle; rule.conc.deadlock [Deadlock], [Join-Failed], [Lock-Poisoned] (D-0204, D-0210, CHG-0248)
// kind: positive
// expect: ok
// expect-stdout-hex: 6661696c656420310a
//
// A cycle of two waits: the owner holds the mutex and joins a thread
// that waits for that mutex. Whichever wait comes second closes the
// cycle and that member faults diag.deadlock, contained; the other
// member's wait then ends through [Join-Failed] or [Lock-Poisoned]. The
// owner fails either way -- its own deadlock, or its join of the
// deadlocked locker -- so main counts one failure whatever the timing.

import std;

fn locker(ref<mutex<i32>, shared> m) : i32
{
    auto g = lock(m);
    *g
}

fn owner(ref<mutex<i32>, shared> m) : i32
{
    auto g = lock(m);
    auto h = spawn(locker, m);
    sleep_ms(50);
    i32 r = join(h);
    *g + r
}

fn main()
{
    mutex<i32> m = Mutex::new(1);
    auto o = spawn(owner, &m);
    usize failed = 0;
    match (try_join(o))
    {
        Ok(v)  : printf("ok %v\n", v),
        Err(e) : { failed = failed + 1; },
    }
    printf("failed %v\n", failed);
}
