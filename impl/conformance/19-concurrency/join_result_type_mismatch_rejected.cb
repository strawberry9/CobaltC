// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.join [Join]; rule.type.typing; conf.join-result-type-mismatch
// kind: negative
// expect: diag.type-mismatch (static)
//
// `join(h)` for `h : handle<u32>` is a `u32`, which does not initialize
// an `i64` (no implicit widening, spec/06 §5).

import std;

fn square(u32 a) : u32
{
    a * a
}

fn main()
{
    auto h = spawn(square, 7);
    i64 x = join(h);
}
