// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.stdlib.waiting `Barrier::wait`; [Deadlock] (b) (D-0204, D-0260); conf.barrier-short
// kind: negative
// expect: diag.deadlock (dynamic)
//
// A barrier for three threads that only two ever reach: both wait, main
// waits in `join`, and no thread can notify, so the wait is a deadlock
// diagnostic, not a hang.

import std;

fn arrive(ref<Barrier, shared> b) : bool
{
    Barrier::wait(b)
}

fn main()
{
    Barrier b = Barrier::new(3);
    handle<bool> h = spawn(arrive, &b);
    _ = arrive(&b);
    _ = join(h);
}
