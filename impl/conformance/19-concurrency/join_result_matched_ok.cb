// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.join [Join]; rule.agg.match; conf.join-result-matched
// kind: positive
// expect: ok
// expect-stdout-hex: 6a6f622038206661696c65640a6a6f6220676176652033300a370a
//
// A thread's `Result` (and a struct) comes back through `join` as a value
// of the thread's result type: a `match` reads its payload, and a field
// is read from it, without first binding it.

import std;

struct Pair
{
    u32 a;
    u64 b;
}

fn checked(u32 id) : Result<u64, u32>
{
    if (id % 4 == 0)
    {
        return Err(id);
    }
    Ok(widen<u64>(id) * 10)
}

fn pair(u32 x) : Pair
{
    Pair { .a = x, .b = 7 }
}

fn main()
{
    auto k = spawn(checked, 8);
    match (join(k))
    {
        Ok(_)  : printf("ok\n"),
        Err(e) : printf("job %v failed\n", e),
    }
    auto j = spawn(checked, 3);
    match (join(j))
    {
        Ok(v)  : printf("job gave %v\n", v),
        Err(_) : printf("failed\n"),
    }
    auto p = spawn(pair, 5);
    printf("%v\n", join(p).b);
}
