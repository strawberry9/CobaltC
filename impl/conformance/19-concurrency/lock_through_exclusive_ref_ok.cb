// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.lock [Lock] (base := the locking reference); CHG-0072; conf.lock-through-exclusive-ref
// kind: positive
// expect: ok
// expect-stdout-hex: 62616c616e63652031350a636c6f73696e6720776974682031350a
//
// Locking a mutex field through an exclusive reference to its struct --
// a parameter, and a destructor's `self` -- forms the lock path from
// that reference, which is then its ancestor, not a competitor.

import std;

resource struct Account
{
    mutex<i64> balance;
}

fn Account::drop(ref<Account, exclusive> self)
{
    auto g = lock(&self.balance);
    printf("closing with %v\n", *g);
}

fn deposit(ref<Account, exclusive> a, i64 n)
{
    auto g = lock(&a.balance);
    *g = *g + n;
}

fn main()
{
    Account a = Account { .balance = Mutex::new(10: i64) };
    deposit(&mut a, 5);
    {
        auto g = lock(&a.balance);
        printf("balance %v\n", *g);
    }
}
