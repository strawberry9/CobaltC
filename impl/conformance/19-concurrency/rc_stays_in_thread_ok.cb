// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Thread-Confined]; rule.stdlib.arc; conf.rc-stays-in-thread
// kind: positive
// expect: ok
//
// An `Rc` made and ended inside a thread never crosses, and an `Arc` may:
// neither is refused.

import std;

fn local_rc(u64 v) : u64
{
    Rc<u64> a = Rc::new(v);
    Rc<u64> b = Rc::clone(&a);
    *Rc::get(&b)
}

fn main()
{
    Arc<u64> a = Arc::new(5: u64);
    Arc<u64> b = Arc::clone(&a);
    handle<u64> h1 = spawn(local_rc, 5);
    handle<u64> h2 = spawn(move [b]() { *Arc::get(&b) });
    u64 x = join(h1);
    u64 y = join(h2);
    assert(x == 5 && y == 5);
    printf("%v %v\n", x, y);
}
