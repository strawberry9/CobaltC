// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.stdlib.waiting [Barrier-Zero-Parties] (D-0260); conf.barrier-zero-parties
// kind: negative
// expect: diag.barrier-zero-parties (dynamic)
//
// A barrier needs at least one party. The count is 0 only when the program
// runs (a literal 0 is rejected before the run: `Barrier::new`'s requirement,
// D-0317, conf.requires-std-literal).

import std;

fn main()
{
    Vec<u8> none = Vec::new();
    Barrier b = Barrier::new(Vec::len(&none));
    _ = Barrier::wait(&b);
}
