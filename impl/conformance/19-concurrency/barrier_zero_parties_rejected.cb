// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.stdlib.waiting [Barrier-Zero-Parties] (D-0260); conf.barrier-zero-parties
// kind: negative
// expect: diag.barrier-zero-parties (dynamic)
//
// A barrier needs at least one party.

import std;

fn main()
{
    Barrier b = Barrier::new(0);
    _ = Barrier::wait(&b);
}
