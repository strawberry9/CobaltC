// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.lock sync-exempt (two lock-derived paths); CHG-0072; conf.guard-interior-borrow-conflict
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `sync-exempt` exempts a lock path only from paths outside the mutex:
// a shared borrow of the guarded value, held while the value is written
// through the guard, conflicts as any two paths do. Both are formed
// through `g` in this body, so the conflict is found before running
// (D-0071).

import std;

struct Pair
{
    Vec<i32> v;
    i32 n;
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    auto m = Mutex::new(Pair { .v = v, .n = 0 });
    auto g = lock(&m);
    ref<Vec<i32>, shared> r = &(*g).v;
    Vec::push(&mut (*g).v, 2);
    printf("%v\n", Vec::len(r));
}
