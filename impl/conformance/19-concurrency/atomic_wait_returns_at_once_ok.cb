// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.atomic [Atomic-Wait]; D-0253; conf.atomic-wait-at-once
// kind: positive
// expect: ok
// expect-stdout-hex: 330a
//
// `Atomic::wait` returns at once when the atomic does not hold the value
// given, with no other thread at all; a `notify` with no waiter does
// nothing.

import std;

fn main()
{
    Atomic<i32> a = Atomic::new(3: i32);
    Atomic::wait(&a, 4);
    Atomic::notify_one(&a);
    Atomic::notify_all(&a);
    AtomicBool f = AtomicBool::new(true);
    AtomicBool::wait(&f, false);
    AtomicBool::notify_all(&f);
    printf("%d\n", Atomic::load(&a));
}
