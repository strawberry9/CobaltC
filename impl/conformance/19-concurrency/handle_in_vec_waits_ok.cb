// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.join [Handle-Destructor]; spec/21 Vec::drop; CHG-0293; conf.handle-in-vec-waits
// kind: positive
// expect: ok
// expect-stdout-hex: 540a4d20320a
//
// A handle stored in a `Vec` is destroyed by the vector's destructor at its
// block's exit, and `[Handle-Destructor]` waits for its thread there, as for
// a handle held by a binding: the thread's line comes first, and its lent
// reference has ended when `x` is read. Before CHG-0293 coby read a reclaimed
// element's placeholder instead of its value, did not wait, and faulted at
// the read with the thread still running.

import std;

fn slow(ref<i32, exclusive> p)
{
    usize s = 0;
    for (usize i = 0; i < 3000; i += 1)
    {
        s += 1;
    }
    *p = *p + 1;
    printf("T\n");
}

fn main()
{
    i32 x = 1;
    {
        Vec<handle<void>> hs = Vec::new();
        Vec::push(&mut hs, spawn(slow, &mut x));
    }
    printf("M %v\n", x);
}
