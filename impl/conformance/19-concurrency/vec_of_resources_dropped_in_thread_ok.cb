// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr [Reclaim] (re-attachment takes the destroy authority, CHG-0030); conf.thread-vec-of-resources-dropped
// kind: positive
// expect: ok
//
// The inner Vec is pushed by main, so its element object's authority
// starts in main; spawn moves only the outer Vec's. The spawned thread
// destroys the element through Vec::drop's reclaim, which takes the
// authority for that thread.

import std;

fn consume(Vec<Vec<i32>> vv) : usize
{
    Vec::len(Vec::index_shared(&vv, 0))
}

fn main()
{
    Vec<Vec<i32>> vv = Vec::new();
    Vec<i32> inner = Vec::new();
    Vec::push(&mut inner, 1);
    Vec::push(&mut inner, 2);
    Vec::push(&mut vv, inner);
    auto h = spawn(consume, vv);
    if (join(h) != 2)
    {
        1 / (1 - 1);
    }
}
