// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Spawn] (arguments are evaluated before the thread exists)
// kind: positive
// expect: ok
//
// Threads spawned in a loop, each given the loop's variable, a resource
// moved in from a binding of the loop body, and a call's result: each
// argument is taken when `spawn` runs. coby once handed the new thread
// the places themselves, read or moved only when it first ran -- after
// the loop body could have ended them (a host panic, timing-dependent).

import std;

fn work(usize k, Vec<u64> v, String s) : u64
{
    widen<u64>(k) * 100 + widen<u64>(Vec::len(&v)) * 10 + widen<u64>(String::len(&s))
}

fn label(usize k) : String
{
    String s = String::new();
    for (usize i = 0; i < k; i += 1)
    {
        String::push_ascii(&mut s, b'x');
    }
    s
}

fn main()
{
    Vec<handle<u64>> hs = Vec::new();
    for (usize k = 0; k < 6; k += 1)
    {
        Vec<u64> v = Vec::new();
        for (usize j = 0; j < k; j += 1)
        {
            Vec::push(&mut v, widen<u64>(j));
        }
        Vec::push(&mut hs, spawn(work, k, v, label(k)));
    }
    u64 total = 0;
    while (Vec::len(&hs) > 0)
    {
        match (Vec::pop(&mut hs))
        {
            Some(h) : { total += join(h); },
            None : {},
        }
    }
    if (total != 1500 + 150 + 15)
    {
        fault(index_out_of_bounds);
    }
}
