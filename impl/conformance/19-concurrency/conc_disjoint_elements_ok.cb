// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.guarantee [Conc-No-Race] [Conc-Interleaving]; D-0203; conf.conc-disjoint-elements
// kind: positive
// expect: ok
// expect-stdout-hex: 3720380a
//
// As `conc_race_detected_rejected`, but the main thread reads another
// element (chosen at run time) while the thread holds the first: the
// accesses do not conflict, so there is nothing to order, and the result
// is the same in every run.

import std;

fn bump(ref<i64, exclusive> x, ref<Channel<u8>, shared> go)
{
    _ = Channel::recv(go);
    *x += 1;
}

fn main()
{
    Vec<i64> v = Vec::filled(4, 7: i64);
    Channel<u8> go = Channel::new(1);
    usize i = Vec::len(&v) - 3;
    {
        auto h = spawn(bump, &mut v[0], &go);
        i64 seen = v[i];
        _ = Channel::send(&go, 1);
        join(h);
        printf("%v %v\n", seen, v[0]);
    }
}
