// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [T-Spawn]; D-0071; D-0094; conf.spawn-ref-result-source-written-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// The handle of a thread whose result is a reference holds the
// argument's borrow like any other handle (D-0071): writing the
// source before the join is refuted.

import std;

fn head(ref<Vec<i32>, shared> v) : ref<i32, shared>
{
    Vec::index_shared(v, 0)
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 5);
    auto h = spawn(head, &v);
    Vec::push(&mut v, 6);
    printf("%v\n", *join(h));
}
