// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.stdlib.atomic; D-0249; conf.atomic-op-std-only
// kind: negative
// expect: diag.unbound-name (static)
//
// `atomic_op` is the std-only intrinsic under `Atomic`'s functions; a
// program cannot name it.

import std;

fn main()
{
    Atomic<u64> a = Atomic::new(1: u64);
    u64 x = atomic_op(&a, 0, 0, 0);
}
