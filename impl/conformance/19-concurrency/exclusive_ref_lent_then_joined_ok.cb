// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: conf.exclusive-ref-lent-then-joined; rule.conc.spawn [Thread-Lend], spec/08 [Thread-Affine] (D-0213, CHG-0251)
// kind: positive
// expect: ok
// expect-stdout-hex: 32300a330a
//
// What lending allows: a reference lent to one thread at a time, and the
// spawner's copy used again once the thread is joined (its path ended with
// it); a shared reference lent to several threads at once, each reading;
// and a reference a thread formed and returned, used by the joiner (the
// thread that formed it has ended, so the joiner takes it over).

import std;

fn bump(ref<i32, exclusive> a)
{
    *a = *a + 10;
}

fn read(ref<i32, shared> a) : i32
{
    *a
}

struct Pair
{
    i32 a;
    i32 b;
}

fn second(ref<Pair, exclusive> p) : ref<i32, exclusive>
{
    &mut p.b
}

fn main()
{
    i32 x = 0;
    ref<i32, exclusive> r = &mut x;
    auto h1 = spawn(bump, r);
    join(h1);
    auto h2 = spawn(bump, r);
    join(h2);
    ref<i32, shared> s = &*r;
    auto g1 = spawn(read, s);
    auto g2 = spawn(read, s);
    i32 total = join(g1);
    total = total - join(g2) + *s;
    printf("%v\n", total);
    Pair p = Pair { .a = 1, .b = 2 };
    auto h3 = spawn(second, &mut p);
    auto q = join(h3);
    *q = *q + 1;
    printf("%v\n", p.b);
}
