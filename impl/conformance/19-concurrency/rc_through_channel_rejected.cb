// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Thread-Confined]; rule.stdlib.rc; diag.not-thread-safe; conf.rc-through-channel
// kind: negative
// expect: diag.not-thread-safe (static)
//
// An `Rc` sent through a `Channel` to another thread is refused where the
// static rule sees it: the channel the thread is given holds an `Rc`.

import std;

fn take(ref<Channel<Rc<u64>>, shared> ch) : u64
{
    match (Channel::recv(ch))
    {
        Some(r) : *Rc::get(&r),
        None    : 0,
    }
}

fn main()
{
    Channel<Rc<u64>> c = Channel::new(1);
    handle<u64> t = spawn(take, &c);
    _ = Channel::send(&c, Rc::new(9: u64));
    Channel::close(&c);
    printf("%v\n", join(t));
}
