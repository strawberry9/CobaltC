// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.channel [Recv] (the value received is re-stamped into the receiver's statement, D-0219, CHG-0258); [Thread-Lend]; conf.channel-lent-ref-received
// kind: positive
// expect: ok
//
// An exclusive reference sent through a channel is lent: a path borrowed
// from the sender's, in transit, formed in the sender's statement. The
// receiver takes it out of the channel and binds it in its arm; between
// the two, nothing holds it. The value moves into the receiver's
// statement, as a joined thread's result moves into the joiner's, so the
// sender's later statement exits do not end it, whatever the schedule.

import std;

fn take_one(ref<Channel<ref<i32, exclusive>>, shared> ch)
{
    match (Channel::recv(ch))
    {
        Some(r) : { *r = *r + 100; },
        None    : {},
    }
}

fn main() : u8
{
    i32 x = 1;
    {
        Channel<ref<i32, exclusive>> c = Channel::new(1);
        auto t = spawn(take_one, &c);
        _ = Channel::send(&c, &mut x);
        i32 y = 2;
        y = y + 1;
        Channel::close(&c);
        join(t);
    }
    if (x != 101)
    {
        return 1;
    }
    0
}
