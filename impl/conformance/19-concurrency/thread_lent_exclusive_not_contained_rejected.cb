// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.fail.fault-contain [Fault-Contain]; D-0204; conf.thread-lent-exclusive
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// A thread lent an exclusive reference to the main thread's data faults,
// after writing through it. Its fault is not contained -- the data it was
// changing belongs to a thread still running -- so the program ends at once,
// `try_join` notwithstanding.

import std;

fn bad(ref<i32, exclusive> x, usize i) : i32
{
    *x = 7;
    Vec<i32> v = Vec::new();
    v[i]
}

fn main()
{
    i32 x = 0;
    auto h = spawn(bad, &mut x, 2);
    match (try_join(h))
    {
        Ok(v)  : printf("value %v\n", v),
        Err(f) : printf("contained?! %v\n", x),
    }
}
