// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Spawn]; rule.conc.join [Join]; rule.type.expected (a literal takes the other operand's type); conf.join-result-typed
// kind: positive
// expect: ok
//
// `spawn(f, …)` is a `handle<R>` for `f : fn(…) : R`, and `join` of it
// is an `R`, so `2 + join(h)` adds two `u32`s and `auto r = join(g)` is
// a `u32` (CHG-0093).

import std;

fn square(u32 a) : u32
{
    a * a
}

fn main()
{
    auto h = spawn(square, 7);
    u32 total = 2 + join(h);
    auto g = spawn(square, 3);
    auto r = join(g);
    u64 wide = widen<u64>(r) + 1;
    handle<u32> k = spawn(square, 4);
    u32 sum = join(k) + 0;
    assert(total == 51 && wide == 10 && sum == 16, "%v %v %v", total, wide, sum);
}
