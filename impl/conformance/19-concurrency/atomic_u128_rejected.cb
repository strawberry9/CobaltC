// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.stdlib.atomic; rule.module.static-assert; D-0249; conf.atomic-u128
// kind: negative
// expect: diag.static-assert-failed (static)
//
// An atomic holds an integer of at most 64 bits: `Atomic::new` asserts it,
// so `Atomic<u128>` is rejected when the program is checked.

import std;

fn main()
{
    Atomic<u128> a = Atomic::new(1: u128);
    printf("%v\n", Atomic::load(&a));
}
