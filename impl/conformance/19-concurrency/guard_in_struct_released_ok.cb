// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.mutex [Guard-Drop]; spec/07 [Destroy-Composite]; CHG-0293; conf.guard-in-struct-released
// kind: positive
// expect: ok
// expect-stdout-hex: 360a
//
// A guard held in a struct field or a `Vec` unlocks its mutex when what holds
// it is destroyed, so the later `lock` succeeds. Before CHG-0293 coby skipped
// the guard's built-in destructor there, and the later `lock` faulted
// `diag.mutex-reentrant-lock`.

import std;

struct Held
{
    guard<i32> g;
}

fn main()
{
    mutex<i32> m = Mutex::new(5);
    {
        Held h = Held { .g = lock(&m) };
        *h.g = *h.g + 1;
    }
    {
        Vec<guard<i32>> gs = Vec::new();
        Vec::push(&mut gs, lock(&m));
    }
    auto g = lock(&m);
    printf("%v\n", *g);
}
