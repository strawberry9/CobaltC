// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: conf.channel-wait-sleeper; rule.conc.deadlock [Deadlock], [Channel-Deadlock], rule.stdlib.sync Channel::recv, sleep_ms (D-0204, D-0210, CHG-0248)
// kind: positive
// expect: ok
// expect-stdout-hex: 676f742034320a
//
// The main thread waits on a channel while the only other thread is
// asleep: a sleeping thread can go on, so neither [Deadlock] nor
// [Channel-Deadlock] applies, and the receive completes when the sleeper
// sends.

import std;

fn sleeper(ref<Channel<i32>, shared> ch)
{
    sleep_ms(60);
    _ = Channel::send(ch, 42);
}

fn main()
{
    Channel<i32> ch = Channel::new(1);
    auto h = spawn(sleeper, &ch);
    match (Channel::recv(&ch))
    {
        Some(v) : printf("got %v\n", v),
        None    : printf("closed\n"),
    }
    join(h);
}
