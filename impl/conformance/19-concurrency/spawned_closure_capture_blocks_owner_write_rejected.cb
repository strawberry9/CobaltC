// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (scoped lending, D-0289); rule.control.flow-analysis (the spawn row); conf.spawned-closure-capture-blocks-owner-write
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `c` holds what its view `v` reaches, `s` (the closure row, D-0288), and
// `spawn(c)` hands it to a thread whose handle `h` the frame holds: `h`
// holds it now, until `join(h)`, after `c` and `v` have ended with their
// block. Appending to `s` while the thread may read through the view
// conflicts, and is found before the run.

import std;

fn main()
{
    String s = String::from_str("abc");
    auto h = spawn(move []() : usize
    {
        0
    });
    {
        StringView v = String::as_view(&s);
        auto c = move [v]() : usize
        {
            StringView::len(v)
        };
        _ = join(h);
        h = spawn(c);
    }
    String::append(&mut s, "def");
    printf("%v\n", join(h));
}
