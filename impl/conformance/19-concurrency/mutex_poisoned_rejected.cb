// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.lock [Lock-Poisoned]; D-0204; conf.mutex-poisoned
// kind: negative
// expect: diag.mutex-poisoned (dynamic)
//
// A thread faults while it holds a mutex's lock, after changing its
// interior. Its fault is contained, and the mutex poisoned: the main thread's
// `lock` faults rather than see what the failed thread may have left
// half-changed.

import std;

fn bad(ref<mutex<i32>, shared> m, usize i) : i32
{
    auto g = lock(m);
    *g += 1;
    Vec<i32> v = Vec::new();
    v[i]
}

fn main()
{
    auto m = Mutex::new(0);
    auto h = spawn(bad, &m, 4);
    match (try_join(h))
    {
        Ok(v)  : printf("value %v\n", v),
        Err(f) : printf("failed: %s\n", &ThreadFailure::diagnostic(&f)),
    }
    auto g = lock(&m);
    printf("never %v\n", *g);
}
