// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Thread-Lend]; rule.control.frame-references (a wrapped handle, D-0291); conf.wrapped-handle-lent
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `fed` holds the handle in an `Option`, and with it what the thread was
// lent: `&mut x`, on every path. Writing `x` before the handle is joined
// conflicts on every run (D-0291), as it does for a handle binding (D-0289).

import std;

fn bump(ref<u32, exclusive> p) : u8
{
    *p += 1;
    1
}

fn main() : void
{
    u32 x = 0;
    Option<handle<u8>> fed = Some(spawn(bump, &mut x));
    x = 5;
    match (fed)
    {
        Some(h) : { _ = join(h); },
        None    : {},
    }
    printf("%v\n", x);
}
