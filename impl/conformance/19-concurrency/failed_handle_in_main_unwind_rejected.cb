// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: conf.failed-handle-in-main-unwind; rule.fail.fault-unwind [Fault-Unwind], rule.conc.handle-destructor [Handle-Destructor], [Join-Failed] (D-0204, D-0210, CHG-0248)
// kind: negative
// expect: diag.div-by-zero (dynamic)
// expect-stdout-hex: 6d61696e206661756c7473206e6f770a
//
// The main thread faults while it owns the handle of a thread that has
// failed (or is still running): the fault that began the unwind is the
// program's, diag.div-by-zero; the handle is destroyed in that unwind
// and the failure it holds, diag.index-out-of-bounds, is discarded. The
// divisor and the index are bound through functions so that the static
// analysis refutes neither.

import std;

fn bad() : i32
{
    array<i32, 2> a = [1, 2];
    usize i = five();
    a[i]
}

fn main()
{
    auto h = spawn(bad);
    sleep_ms(50);
    i32 z = zero();
    printf("main faults now\n");
    i32 q = 1 / z;
    printf("%v\n", q);
}

fn five() : usize
{
    5
}

fn zero() : i32
{
    0
}
