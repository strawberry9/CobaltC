// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.atomic [Atomic-Op]; rule.stdlib.atomic; D-0249; conf.atomic-counter-threads
// kind: positive
// expect: ok
// expect-stdout-hex: 31303030300a
//
// Four threads add to one `Atomic<u64>` through shared references, with no
// lock: each `fetch_add` is one step, so no increment is lost and the total
// is exact however the threads interleave.

import std;

fn worker(ref<Atomic<u64>, shared> hits, u64 times) : u64
{
    foreach (i in 0..times)
    {
        _ = Atomic::fetch_add(hits, 1);
    }
    times
}

fn main()
{
    Atomic<u64> hits = Atomic::new(0: u64);
    u64 expected = 0;
    {
        auto a = spawn(worker, &hits, 2500);
        auto b = spawn(worker, &hits, 3000);
        auto c = spawn(worker, &hits, 3500);
        auto d = spawn(worker, &hits, 1000);
        expected = join(a) + join(b) + join(c) + join(d);
    }
    assert(Atomic::load(&hits) == expected);
    printf("%v\n", Atomic::load(&hits));
}
