// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Spawn] [Join]; D-0202; conf.spawn-threads-reused
// kind: positive
// expect: ok
// expect-stdout-hex: 3335333220742d3439392d310a
//
// Five hundred threads spawned and joined one after another (`cbrt` runs
// each on an operating-system thread that finished an earlier one, when
// one waits), each moved a `String` and a `Vec` and handing a `String`
// back: every thread starts fresh, whatever ran before it on the same
// operating-system thread.

import std;

fn shape(String s, Vec<u64> v, u64 k) : String
{
    u64 t = 0;
    foreach (x in &v)
    {
        t += *x;
    }
    String out = String::clone(&s);
    String::append(&mut out, &sprintf("-%v-%v", k, t));
    out
}

fn main()
{
    u64 total = 0;
    String last = String::new();
    foreach (k in 0..500: u64)
    {
        Vec<u64> v = Vec::new();
        foreach (i in 0..(k % 7))
        {
            Vec::push(&mut v, i);
        }
        String r = join(spawn(shape, String::from_str("t"), v, k));
        total += narrow<u64>(String::len(&r));
        last = r;
    }
    printf("%v %s\n", total, &last);
}
