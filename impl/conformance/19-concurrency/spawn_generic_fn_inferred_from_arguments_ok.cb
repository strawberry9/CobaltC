// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [T-Spawn] (CHG-0100)
// kind: positive
// expect: ok
//
// A generic function spawned without type arguments takes them from the
// spawn's arguments, as a call would. cobc required them written
// ("cannot infer type arguments of `run_chunk` as a value"). Found by
// real-world testing (a generic parallel map).

import std;

fn run_chunk<T, U>(Vec<T> chunk, fn(T) : U f) : Vec<U>
{
    Vec<U> out = Vec::new();
    foreach (x in chunk)
    {
        Vec::push(&mut out, f(x));
    }
    out
}

fn double(i64 x) : i64
{
    x * 2
}

fn main() : u8
{
    Vec<i64> v = Vec::new();
    Vec::push(&mut v, 3);
    Vec::push(&mut v, 4);
    auto t = spawn(run_chunk, v, double);
    Vec<i64> r = join(t);
    if (Vec::len(&r) != 2 || r[0] != 6 || r[1] != 8)
    {
        return 1;
    }
    0
}
