// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Thread-Confined]; rule.stdlib.rc; conf.rc-in-its-own-thread
// kind: positive
// expect: ok
//
// An `Rc` and a `Weak` are used freely in the thread that made them: in
// the main thread before, between and after threads run, and in a thread
// that makes its own, reached through a plain `fn` value. An `Arc` carried
// the same way crosses threads.

import std;

fn local_rc(u64 v) : u64
{
    Rc<u64> a = Rc::new(v);
    Rc<u64> b = Rc::clone(&a);
    Weak<u64> w = Rc::downgrade(&b);
    drop(a);
    match (Weak::upgrade(&w))
    {
        Some(c) : *Rc::get(&c) + *Rc::get(&b),
        None    : 0,
    }
}

fn start(fn() : u64 f) : handle<u64>
{
    spawn(f)
}

fn main()
{
    Rc<u64> a = Rc::new(7: u64);
    Rc<u64> b = Rc::clone(&a);
    handle<u64> h1 = start(move []() : u64 { local_rc(5) });
    Arc<u64> s = Arc::new(3: u64);
    Arc<u64> t = Arc::clone(&s);
    handle<u64> h2 = start(move [t]() : u64 { *Arc::get(&t) });
    Rc<u64> c = Rc::clone(&a);
    u64 x = join(h1);
    u64 y = join(h2);
    Weak<u64> w = Rc::downgrade(&c);
    u64 z = *Rc::get(&b) + *Rc::get(&c);
    assert(x == 10 && y == 3 && z == 14);
    assert(Option::is_some(&Weak::upgrade(&w)));
    printf("%v %v %v\n", x, y, z);
}
