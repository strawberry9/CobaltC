// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.lock [Guard-Drop]; rule.control.flow-analysis; conf.ref-through-dropped-guard-kept
// kind: negative
// expect: diag.destroy-while-aliased (static)
//
// A reference reached through a bound guard and used after `drop(g)` would
// read the mutex's value unlocked, while a second lock may change it; it is
// refuted at the `drop` (bug 005).

import std;

fn main()
{
    mutex<String> m = Mutex::new("short");
    guard<String> g = lock(&m);
    ref<String, shared> r = &*g;
    drop(g);
    {
        guard<String> g2 = lock(&m);
        String::append(&mut *g2, "-grow-the-buffer-so-it-reallocates");
    }
    printf("%v\n", StringView::len(r));
}
