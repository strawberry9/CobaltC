// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Thread-Step]; rule.conc.lock [Lock] (serialization under real interleaving)
// kind: positive
// expect: ok
//
// Two threads (main and a worker) each take the lock fifty times while
// the other is live; the evaluator yields between statements, so their
// steps genuinely interleave, and the mutex still serializes every
// increment.

fn count(ref<mutex<i32>, shared> m) : i32
{
    i32 i = 0;
    while (i < 50)
    {
        {
            auto g = lock(m);
            *g = *g + 1;
        }
        i = i + 1;
    }
    0
}

fn main()
{
    auto m = Mutex::new(0);
    auto h = spawn(count, &m);
    i32 i = 0;
    while (i < 50)
    {
        {
            auto g = lock(&m);
            *g = *g + 1;
        }
        i = i + 1;
    }
    join(h);
    if (*lock(&m) != 100)
    {
        1 / (1 - 1);
    }
}
