// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.cancel [Cancel]; D-0204; conf.thread-cancel-waits
// kind: positive
// expect: ok
// expect-stdout-hex: 7761697465723a20646961672e7468726561642d63616e63656c6c65640a6e61707065723a20646961672e7468726561642d63616e63656c6c65640a
//
// Two threads are cancelled while they wait -- one on an empty channel, one
// asleep for a minute: each wait ends at once with `diag.thread-cancelled`,
// contained, and `try_join` reports it.

import std;

fn waiter(ref<Channel<u8>, shared> c) : u8
{
    match (Channel::recv(c))
    {
        Some(v) : v,
        None    : 0,
    }
}

fn napper(u64 ms) : u8
{
    sleep_ms(ms);
    1
}

fn main()
{
    Channel<u8> c = Channel::new(1);
    auto h = spawn(waiter, &c);
    auto n = spawn(napper, 60000);
    sleep_ms(50);
    cancel(&h);
    cancel(&n);
    match (try_join(h))
    {
        Ok(v)  : printf("value %v\n", v),
        Err(f) : printf("waiter: %s\n", &ThreadFailure::diagnostic(&f)),
    }
    match (try_join(n))
    {
        Ok(v)  : printf("value %v\n", v),
        Err(f) : printf("napper: %s\n", &ThreadFailure::diagnostic(&f)),
    }
}
