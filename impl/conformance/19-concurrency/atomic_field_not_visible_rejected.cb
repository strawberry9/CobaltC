// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.stdlib.atomic; rule.module.visibility [Field-Not-Visible]; D-0249; conf.atomic-field-not-visible
// kind: negative
// expect: diag.name-not-visible (static)
//
// An atomic's integer is a field private to `std`: a program cannot read or
// write it except through the operations, so no plain access can race one.

import std;

fn main()
{
    Atomic<u64> a = Atomic::new(1: u64);
    printf("%v\n", a.atomic_value);
}
