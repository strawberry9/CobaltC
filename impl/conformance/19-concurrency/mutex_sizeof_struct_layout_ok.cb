// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.sizeof [Sizeof-Mutex] (the layout of struct { τ inner; usize state; } per [Layout-Struct])
// kind: positive
// expect: ok
//
// The state cells sit at the next multiple of usize's alignment after
// `inner`, and the whole is rounded to the struct's alignment -- not
// sizeof(τ) + 8.

fn main()
{
    if (sizeof<mutex<i32>>() != 16 || alignof<mutex<i32>>() != 8)
    {
        1 / (1 - 1);
    }
    if (sizeof<mutex<u8>>() != 16 || sizeof<mutex<array<u8, 9>>>() != 24)
    {
        1 / (1 - 1);
    }
    if (sizeof<mutex<i64>>() != 16 || sizeof<mutex<i128>>() != 32 || alignof<mutex<i128>>() != 16)
    {
        1 / (1 - 1);
    }
}
