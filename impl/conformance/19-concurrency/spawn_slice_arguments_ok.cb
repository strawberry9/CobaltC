// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn (reference arguments in flight); conf.spawn-slice-arguments
// kind: positive
// expect: ok
// expect-stdout-hex: 33303732300a
//
// Each round spawns four threads, each given a shared reference to one
// Vec and an exclusive slice of a disjoint range of another, then joins
// them. A thread's arguments are received after the spawning statement
// may already have ended; the borrows they carry stay valid until the
// thread's call returns.

import std;

const usize W = 48;

fn band(ref<Vec<u8>, shared> cur, slice<u8, exclusive> out, usize first) : u32
{
    u32 alive = 0;
    for (usize k = 0; k < slice_len(out); k += 1)
    {
        u8 me = cur[first * W + k];
        out[k] = me;
        alive = alive + widen<u32>(me);
    }
    alive
}

fn main()
{
    Vec<u8> cur = Vec::new();
    Vec<u8> next = Vec::new();
    for (usize i = 0; i < W * 32; i += 1)
    {
        Vec::push(&mut cur, narrow_wrapping<u8>(i % 2));
        Vec::push(&mut next, 0);
    }
    u32 t = 0;
    for (usize g = 0; g < 40; g += 1)
    {
        usize q = 8 * W;
        auto a = spawn(band, &cur, &mut next[0 .. q], 0);
        auto b = spawn(band, &cur, &mut next[q .. 2 * q], 8);
        auto c = spawn(band, &cur, &mut next[2 * q .. 3 * q], 16);
        auto d = spawn(band, &cur, &mut next[3 * q .. $], 24);
        t = t + join(a) + join(b) + join(c) + join(d);
    }
    assert(t == 30720);
    printf("%v\n", t);
}
