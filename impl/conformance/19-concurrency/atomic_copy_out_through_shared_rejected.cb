// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.atomic; rule.stdlib.atomic; D-0249; conf.atomic-copy-out-through-shared
// kind: negative
// expect: diag.move-while-aliased (dynamic)
//
// An `Atomic` is a resource, never copied: `*r` through a shared reference
// would move it out from under the reference, and is refused, so no copy can
// be read without an operation.

import std;

fn take(ref<Atomic<u64>, shared> r) : u64
{
    Atomic<u64> c = *r;
    Atomic::load(&c)
}

fn main()
{
    Atomic<u64> a = Atomic::new(1: u64);
    printf("%v\n", take(&a));
}
