// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.guarantee [Deadlock] (a); [Handle-Destructor] (a block exit's wait, located, D-0219, CHG-0258); conf.deadlock-at-block-exit-located
// kind: negative
// expect: diag.deadlock (dynamic)
//
// `main` holds the lock `add` waits for; at the end of `main`'s block the
// handle `t`, established after the guard, ends first, and its destructor
// waits for `add`: that wait closes a cycle, so it faults in `main`. The
// fault is reported at the block's last statement, as for any fault a
// block's exit raises (`coby` reported it with no location).

import std;

fn add(ref<mutex<i32>, shared> m)
{
    auto g = lock(m);
    *g = *g + 1;
}

fn main()
{
    mutex<i32> m = Mutex::new(0);
    auto g = lock(&m);
    auto t = spawn(add, &m);
    sleep_ms(200);
    printf("%v\n", *g);
}
