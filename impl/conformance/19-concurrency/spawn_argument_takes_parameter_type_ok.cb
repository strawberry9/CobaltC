// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Spawn] (arguments bound as for a call, rule.fn.bind-param); conf.spawn-argument-parameter-type
// kind: positive
// expect: ok
// expect-stdout-hex: 3930383833343737340a373030393830303832313637373632303430340a
//
// A literal argument to `spawn` takes its type from the parameter, as in
// a call: `spawn(t, 1)` with `fn t(u64 seed)` passes a `u64`, so the
// arithmetic on it is `u64` arithmetic (a literal beyond `i32`'s range
// beside it is in range). The same for a `move` closure's parameter.

import std;

fn next(ref<u64, exclusive> s) : u64
{
    *s = wrapping_add(wrapping_mul(*s, 6364136223846793005), 1442695040888963407);
    *s >> 33
}

fn t(u64 seed) : u64
{
    u64 s = seed;
    next(&mut s)
}

fn main()
{
    auto h = spawn(t, 1);
    printf("%v\n", join(h));
    u64 base = 3;
    auto c = spawn(move [base](u64 n)
    {
        wrapping_mul(n + base, 6364136223846793005)
    }, 1);
    printf("%v\n", join(c));
}
