// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.join [Join]; rule.agg.array-construct (an element the static pass does not type)
// kind: positive
// expect: ok
//
// `array<T, 2> ts = [join(a), join(b)];`: the static pass has no type for
// `join(h)` (the handle's), and an array literal of such elements was
// typed `array<i32, N>` and rejected `diag.type-mismatch`; it now takes
// the expected element type. Found by real-world testing.

import std;

struct Tally
{
    u32 lines;
}

fn work(u32 n) : Tally
{
    Tally { .lines = n * 2 }
}

fn main()
{
    auto a = spawn(work, 3);
    auto b = spawn(work, 4);
    array<Tally, 2> ts = [join(a), join(b)];
    if (ts[0].lines + ts[1].lines != 14)
    {
        1 / (1 - 1);
    }
}
