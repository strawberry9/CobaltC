// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.join [Handle-Destructor] [Join-Failed]; D-0204; conf.thread-failure-handle-end
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// A spawned thread faults and nothing joins it: its handle's end, at its
// block's end, raises the failure again in the thread that ends the handle.

import std;

fn bad(usize i) : i32
{
    Vec<i32> v = Vec::new();
    v[i]
}

fn main()
{
    {
        auto h = spawn(bad, 3);
        printf("in block\n");
    }
    printf("never\n");
}
