// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.join [Handle-Destructor] [Join-Failed]; D-0204; conf.thread-failure-nested
// kind: positive
// expect: ok
// expect-stdout-hex: 6368696c64206661696c65643a20646961672e696e6465782d6f75742d6f662d626f756e64730a6d61696e20676f6573206f6e0a
//
// A thread's own thread faults and is never joined: its handle's end, as the
// middle thread returns, raises the failure there, which makes the middle
// thread fail in turn; the main thread takes that failure with `try_join`.

import std;

fn grand(usize i) : i32
{
    Vec<i32> v = Vec::new();
    v[i]
}

fn child(usize i) : i32
{
    auto g = spawn(grand, i);
    5
}

fn main()
{
    auto h = spawn(child, 9);
    match (try_join(h))
    {
        Ok(v)  : printf("value %v\n", v),
        Err(f) : printf("child failed: %s\n", &ThreadFailure::diagnostic(&f)),
    }
    printf("main goes on\n");
}
