// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Thread-Lend]; rule.agg.slice [Slice-Index]; conf.slice-lent-copy-written
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// `s` is lent to the thread, which waits on the channel. `w` is a copy of
// `s`: it reaches what the thread holds under no fact of the static pass, so
// writing `w[0]` is the run's to check (D-0291), and it conflicts with the
// lent path.

import std;

fn wait_then_bump(ref<Channel<i32>, shared> c, slice<i32, exclusive> s)
{
    _ = Channel::recv(c);
    s[0] = s[0] + 1;
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 5);
    Vec::push(&mut v, 6);
    Channel<i32> ch = Channel::new(1);
    auto s = &mut v[0 .. 2];
    auto t = spawn(wait_then_bump, &ch, s);
    auto w = s;
    w[0] = 3;
    _ = Channel::send(&ch, 1);
    join(t);
    printf("%v\n", v[0]);
}
