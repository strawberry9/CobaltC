// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.guarantee [Deadlock] (b) (judged again when a thread ends, D-0219, CHG-0258); conf.deadlock-after-last-thread-ends
// kind: negative
// expect: diag.deadlock (dynamic)
//
// `take` waits on a channel nothing will send to, and `main` joins it.
// While `nap` sleeps, that is no deadlock: a sleeping thread can go on.
// When `nap` ends, every live thread waits and none can go on: `take`, at
// the end of the chain of waits, faults, and `main`'s `join` raises it.
// Both implementations looked for a deadlock only when a wait began, so
// the program hung once `nap` ended. Found by the model (D-0219).

import std;

fn take(ref<Channel<i32>, shared> ch)
{
    match (Channel::recv(ch))
    {
        Some(v) : printf("%v\n", v),
        None    : {},
    }
}

fn nap()
{
    sleep_ms(300);
}

fn main()
{
    Channel<i32> c = Channel::new(1);
    auto t1 = spawn(take, &c);
    auto t2 = spawn(nap);
    join(t1);
    join(t2);
}
