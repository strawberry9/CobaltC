// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Thread-Confined]; diag.not-thread-safe; conf.rc-spawn-argument
// kind: negative
// expect: diag.not-thread-safe (static)
//
// An `Rc`'s count is not synchronised: an `Rc` given to a thread as an
// argument, while this thread keeps a clone, would race on it (bug 031).

import std;

fn churn(Rc<String> r) : usize
{
    Rc<String> c = Rc::clone(&r);
    StringView::len(Rc::get(&c))
}

fn main()
{
    Rc<String> a = Rc::new("shared across threads");
    handle<usize> h = spawn(churn, Rc::clone(&a));
    printf("%v %v\n", join(h), StringView::len(Rc::get(&a)));
}
