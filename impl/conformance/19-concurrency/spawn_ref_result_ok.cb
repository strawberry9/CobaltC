// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [T-Spawn]; D-0094; conf.spawn-ref-result
// kind: positive
// expect: ok
// expect-stdout-hex: 34310a32300a
//
// A spawned thread whose result is a bare reference: a shared element
// reference read after the join, and an exclusive reference — the
// function returns its own reference parameter, so the result token
// is the argument's — written through after the join. `handle<ref<…>>`
// carries the borrow (D-0071), and the reference outlives the thread
// because its source does.

import std;

fn head(ref<Vec<i32>, shared> v) : ref<i32, shared>
{
    Vec::index_shared(v, 0)
}

fn bump(ref<i32, exclusive> n) : ref<i32, exclusive>
{
    *n += 1;
    n
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 41);
    {
        auto h = spawn(head, &v);
        ref<i32, shared> r = join(h);
        printf("%v\n", *r);
    }
    i32 n = 9;
    {
        auto h = spawn(bump, &mut n);
        ref<i32, exclusive> r = join(h);
        *r += 10;
    }
    printf("%v\n", n);
}
