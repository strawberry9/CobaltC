// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.lock [Lock-Reentrant]
// kind: negative
// expect: diag.mutex-reentrant-lock (dynamic)
//
// A thread that already holds a mutex's lock cannot lock it again --
// this is a reentrant-lock fault, not a deadlock.

fn main()
{
    mutex<i32> m = Mutex::new(0);
    auto g1 = lock(&m);
    auto g2 = lock(&m);
}
