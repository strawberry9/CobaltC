// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.control.flow-analysis consumption row; rule.conc.spawn [Thread-Lend]; D-0244; conf.handle-moved-into-vec-then-referent-written
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// The thread `t` is lent `&mut x` and waits on the channel. Moving its handle
// into the vector forgets `t`'s fact on `x` and marks `x` escaped (D-0244):
// the thread still holds the lent path, so `x = x + 1` is checked, and meets
// it. Read literally before D-0244, the moved `t` kept its fact and the write
// was rejected statically; both tools checked it at run time.

import std;

fn wait_then_bump(ref<Channel<i32>, shared> c, ref<i32, exclusive> p)
{
    _ = Channel::recv(c);
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    Channel<i32> ch = Channel::new(1);
    {
        Vec<handle<void>> hs = Vec::new();
        auto t = spawn(wait_then_bump, &ch, &mut x);
        Vec::push(&mut hs, t);
        x = x + 1;
        _ = Channel::send(&ch, 1);
    }
    printf("%v\n", x);
}
