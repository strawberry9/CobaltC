// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.control.flow-analysis consumption row; rule.conc.spawn [Thread-Lend]; D-0244; CHG-0384; conf.handle-moved-into-vec-then-referent-written
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// The thread `t` is lent `&mut x` and waits on the channel. Moving its handle
// into the vector hands `t`'s fact on `x` to `hs` (CHG-0384): a `Vec` of
// handles holds what every handle pushed there holds until its end, which
// waits for the thread. `x = x + 1` meets that fact and is rejected before
// the run. Under D-0244 alone the move forgot the fact and marked `x`
// escaped, and both tools checked the write at run time.

import std;

fn wait_then_bump(ref<Channel<i32>, shared> c, ref<i32, exclusive> p)
{
    _ = Channel::recv(c);
    *p = *p + 1;
}

fn main()
{
    i32 x = 1;
    Channel<i32> ch = Channel::new(1);
    {
        Vec<handle<void>> hs = Vec::new();
        auto t = spawn(wait_then_bump, &ch, &mut x);
        Vec::push(&mut hs, t);
        x = x + 1;
        _ = Channel::send(&ch, 1);
    }
    printf("%v\n", x);
}
