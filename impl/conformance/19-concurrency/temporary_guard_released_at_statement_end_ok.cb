// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.lock [Lock] [Guard-Drop]; rule.control.stmt (temporaries end with their statement); conf.temporary-guard-released
// kind: positive
// expect: ok
// expect-stdout-hex: 320a313035203130300a
//
// A guard that is only a temporary (`*lock(&m)`) is destroyed at the end
// of its statement, unlocking the mutex: the next statement can lock it
// again, and a `Vec` of mutexes read this way is destroyed normally.

import std;

fn main()
{
    auto m = Mutex::new(1: i64);
    i64 t = *lock(&m);
    i64 u = *lock(&m);
    printf("%v\n", t + u);

    Vec<mutex<i64>> accounts = Vec::new();
    Vec::push(&mut accounts, Mutex::new(100: i64));
    Vec::push(&mut accounts, Mutex::new(5: i64));
    i64 total = 0;
    foreach (acct in &accounts)
    {
        total = total + *lock(acct);
    }
    printf("%v %v\n", total, *lock(&accounts[0]));
}
