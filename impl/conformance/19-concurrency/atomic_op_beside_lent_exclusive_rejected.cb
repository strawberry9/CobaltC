// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.atomic [Atomic-Op]; rule.alias.thread-affine; D-0249; conf.atomic-op-beside-lent-exclusive
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// An atomic operation checks its reference as a shared access: while a
// thread holds an element exclusively, the spawner's `load` of the same
// element, chosen at run time, is a conflict, as any read would be.

import std;

fn hold(ref<Atomic<u64>, exclusive> w, ref<Channel<u8>, shared> go)
{
    _ = Channel::recv(go);
    Atomic::store(w, 5);
}

fn main()
{
    Vec<Atomic<u64>> v = Vec::new();
    Vec::push(&mut v, Atomic::new(1: u64));
    Vec::push(&mut v, Atomic::new(2: u64));
    Channel<u8> go = Channel::new(1);
    usize i = Vec::len(&v) - 2;
    {
        auto h = spawn(hold, &mut v[0], &go);
        u64 seen = Atomic::load(&v[i]);         // ✗ the thread holds v[0]
        _ = Channel::send(&go, 1);
        join(h);
        printf("%v\n", seen);
    }
}
