// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: conf.exclusive-ref-lent-twice-dynamic; rule.conc.spawn [Thread-Lend], spec/08 [Thread-Affine] (D-0213, CHG-0251)
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// The same reference lent to two threads through a helper the analysis
// does not follow: the second lend is checked when it happens. Its borrow
// from `r` clashes with the path the first thread holds, which is not one
// of its ancestors, so the second `spawn` faults. The first thread is
// still running then (it waits for `go`, sent only after both spawns): a
// thread that has ended holds nothing, and a second lend after it would
// pass.

import std;

fn bump(ref<i32, exclusive> a, ref<Channel<i32>, shared> go)
{
    *a = *a + 1;
    _ = Channel::recv(go);
}

fn start(ref<i32, exclusive> r, ref<Channel<i32>, shared> go) : handle<void>
{
    spawn(bump, r, go)
}

fn main()
{
    i32 x = 0;
    ref<i32, exclusive> r = &mut x;
    Channel<i32> go = Channel::new(2);
    auto h1 = start(r, &go);
    auto h2 = start(r, &go);
    _ = Channel::send(&go, 1);
    _ = Channel::send(&go, 1);
    join(h1);
    join(h2);
}
