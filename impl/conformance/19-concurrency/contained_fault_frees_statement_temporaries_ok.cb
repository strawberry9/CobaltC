// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: [Fault-Contain] (D-0204, D-0269, D-0315); conf.contained-fault-frees-statement-temporaries
// kind: positive
// expect: ok
// expect-stdout-hex: 6f6b2032343534206661696c656420330a
//
// A spawned thread faults while a statement's temporaries are live: a
// borrowed call result and a discarded one. Its fault is contained and its
// frames unwind, ending them as `[Fault-Unwind]` does; the program goes on.
// (Their release is observed by cobc's sanitizer run: no leak.)

import std;

fn big(usize n) : String
{
    String s = sprintf("buffer %v:", n);
    foreach (i in 0..40)
    {
        String::append(&mut s, "0123456789");
    }
    s
}

fn risky(StringView text, usize n) : usize
{
    assert(n % 3 != 0, "job %v refuses", n);
    StringView::len(text)
}

fn job(usize n) : usize
{
    big(n + 1000);
    risky(&big(n), n)
}

fn main()
{
    usize ok = 0;
    usize failed = 0;
    foreach (n in 1..10)
    {
        match (try_join(spawn(job, n)))
        {
            Ok(k)  : ok += k,
            Err(_) : failed += 1,
        }
    }
    printf("ok %v failed %v\n", ok, failed);
}
