// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.guarantee [Conc-No-Race]; inv.concurrency-validity; D-0203; conf.conc-race-detected
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// A thread holds an exclusive reference to an element while it waits;
// the main thread reads the same element, chosen at run time, before
// letting it go on. The two accesses would race: the read is a fault, in
// every run and every implementation, however the threads are timed.

import std;

fn bump(ref<i64, exclusive> x, ref<Channel<u8>, shared> go)
{
    _ = Channel::recv(go);
    *x += 1;
}

fn main()
{
    Vec<i64> v = Vec::filled(4, 0: i64);
    Channel<u8> go = Channel::new(1);
    usize i = Vec::len(&v) - 4;
    {
        auto h = spawn(bump, &mut v[0], &go);
        i64 seen = v[i];                         // ✗ the thread still holds v[0]
        _ = Channel::send(&go, 1);
        join(h);
        printf("%v\n", seen);
    }
}
