// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (scoped lending, D-0289); conf.pool-vec-lend-blocks-owner-write
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// Two threads lent `x` are pushed onto the frame's `Vec` of handles, which
// holds what they were lent until its end (CHG-0384); taking one handle out
// and joining it leaves the other lending, so writing `x` conflicts, and is
// found before the run.

import std;

fn look(ref<i64, shared> x) : i64
{
    *x
}

fn main()
{
    i64 x = 3;
    Vec<handle<i64>> hs = Vec::new();
    Vec::push(&mut hs, spawn(look, &x));
    Vec::push(&mut hs, spawn(look, &x));
    i64 t = join(Option::unwrap(Vec::pop(&mut hs)));
    x = 10;
    printf("%v %v\n", t, x);
}
