// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.stdlib.atomic `atomic_fence`, `spin_hint`; D-0253; conf.atomic-fence-spin
// kind: positive
// expect: ok
// expect-stdout-hex: 390a
//
// A worker spins on an atomic with `spin_hint` in the loop until the main
// thread stores to it; `atomic_fence` changes nothing a program without
// `unsafe` can see. Under `--explore` a spin hint is a point where a
// schedule may pass the turn.

import std;

fn main()
{
    Atomic<u32> go = Atomic::new(0: u32);
    {
        handle<u32> h = spawn(move [](ref<Atomic<u32>, shared> go) : u32
        {
            while (Atomic::load(go) == 0)
            {
                spin_hint();
            }
            atomic_fence();
            Atomic::load(go)
        }, &go);
        atomic_fence();
        Atomic::store(&go, 9);
        printf("%d\n", join(h));
    }
}
