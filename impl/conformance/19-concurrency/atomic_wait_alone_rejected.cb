// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.guarantee [Deadlock] (b); rule.conc.atomic [Atomic-Wait]; D-0253; conf.atomic-wait-alone
// kind: negative
// expect: diag.deadlock (dynamic)
//
// The main thread waits on an atomic no other thread exists to change:
// the end of a chain of waits, so `[Deadlock]` (b) faults it. (A channel's
// wait alone is `[Channel-Deadlock]`; an atomic's is the general rule.)

import std;

fn main()
{
    Atomic<u32> a = Atomic::new(0: u32);
    Atomic::wait(&a, 0);
}
