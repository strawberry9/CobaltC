// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.atomic [Atomic-Op]; rule.stdlib.atomic; D-0249; conf.atomic-wrapping-bitwise
// kind: positive
// expect: ok
// expect-stdout-hex: 323535202d31340a
//
// The other operations, each giving the value it found: `store`, `swap`,
// `and`, `or`, `xor`, and the wrapping add and subtract at the type's width,
// signed and unsigned.

import std;

fn main()
{
    Atomic<u8> f = Atomic::new(0: u8);
    assert(Atomic::fetch_or(&f, 0x05) == 0);
    assert(Atomic::fetch_and(&f, 0x0c) == 0x05);
    assert(Atomic::fetch_xor(&f, 0x0f) == 0x04);
    assert(Atomic::fetch_add_wrapping(&f, 250) == 0x0b);
    assert(Atomic::fetch_sub_wrapping(&f, 6) == 5);
    Atomic<i16> s = Atomic::new(-32768: i16);
    assert(Atomic::fetch_sub_wrapping(&s, 1) == -32768);
    assert(Atomic::swap(&s, -7) == 32767);
    Atomic::store(&s, Atomic::load(&s) * 2);
    printf("%v %v\n", Atomic::load(&f), Atomic::load(&s));
}
