// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.atomic [Atomic-Op]; rule.stdlib.atomic; D-0249; conf.atomic-stop-flag
// kind: positive
// expect: ok
// expect-stdout-hex: 320a
//
// Two workers spin until the spawner stores 1 in a shared `Atomic<u8>`, then
// count themselves out. A schedule passes the turn at atomic operations, so
// under `--explore` too the spawner runs and the workers stop.

import std;

fn worker(ref<Atomic<u8>, shared> stop, ref<Atomic<u64>, shared> done) : u64
{
    u64 spins = 0;
    while (Atomic::load(stop) == 0)
    {
        spins = spins + 1;
    }
    _ = Atomic::fetch_add(done, 1);
    spins
}

fn main()
{
    Atomic<u8> stop = Atomic::new(0: u8);
    Atomic<u64> done = Atomic::new(0: u64);
    {
        auto a = spawn(worker, &stop, &done);
        auto b = spawn(worker, &stop, &done);
        Atomic::store(&stop, 1);
        _ = join(a);
        _ = join(b);
    }
    printf("%v\n", Atomic::load(&done));
}
