// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.join [Handle-Destructor]; spec/07 [Destroy-Composite]; CHG-0293; conf.handle-in-option-waits
// kind: positive
// expect: ok
// expect-stdout-hex: 540a4d20320a540a4d20330a
//
// A handle held as an `Option's payload, or as an array element, is destroyed
// with what holds it, and its destructor waits for the thread (CHG-0293).

import std;

fn slow(ref<i32, exclusive> p)
{
    usize s = 0;
    for (usize i = 0; i < 3000; i += 1)
    {
        s += 1;
    }
    *p = *p + 1;
    printf("T\n");
}

fn main()
{
    i32 x = 1;
    {
        Option<handle<void>> o = Some(spawn(slow, &mut x));
    }
    printf("M %v\n", x);
    {
        array<handle<void>, 1> a = [spawn(slow, &mut x)];
    }
    printf("M %v\n", x);
}
