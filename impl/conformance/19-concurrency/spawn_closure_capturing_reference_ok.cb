// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn; rule.resauth.destroy [Destroy-Not-Solitary]; conf.spawn-closure-capturing-reference
// kind: positive
// expect: ok
// expect-stdout-hex: 330a340a646f6e650a
//
// A `move` closure capturing a reference is spawned and joined; the
// thread's closure ends with the thread, so the referent's destruction
// at its block's end is solitary. A closure in a binding can be spawned
// twice (each thread gets a copy).

import std;

fn main()
{
    String s = String::from_str("abc");
    {
        ref<String, shared> r = &s;
        auto h = spawn(move [r]() : usize { String::len(r) });
        printf("%d\n", join(h));
    }
    String t = String::from_str("abcd");
    {
        ref<String, shared> r = &t;
        auto c = move [r]() : usize { String::len(r) };
        auto h1 = spawn(c);
        auto h2 = spawn(c);
        usize a = join(h1);
        usize b = join(h2);
        if (a == b)
        {
            printf("%d\n", a);
        }
    }
    printf("done\n");
}
