// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: conf.try-join-resource-result; rule.conc.join [Join], rule.stdlib.sync try_join, rule.fn.generic-call (D-0204, D-0208, CHG-0246)
// kind: positive
// expect: ok
// expect-stdout-hex: 6f6b20370a64726f7020370a656e640a6f6b20380a64726f7020380a
//
// A thread's resource result taken through try_join: the Ok payload is
// the resource, owned by the arm's binding and destroyed once, at the
// arm's end. The same through a generic function of the program's own
// that joins a handle<R> parameter: R is inferred from the handle's
// result type. Found a coby divergence (D-0208): spawn stored a void
// placeholder as the handle's result type, so a generic callee inferred
// R as void and read the joined resource as a plain value.

import std;

resource struct Noisy
{
    i32 id;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("drop %v\n", self.id);
}

fn make(i32 id) : Noisy
{
    Noisy { .id = id }
}

fn take<R>(handle<R> h) : Result<R, i32>
{
    Ok(join(h))
}

fn main()
{
    auto h = spawn(make, 7);
    match (try_join(h))
    {
        Ok(n)  : printf("ok %v\n", n.id),
        Err(f) : printf("failed\n"),
    }
    printf("end\n");
    auto h2 = spawn(make, 8);
    match (take(h2))
    {
        Ok(n)  : printf("ok %v\n", n.id),
        Err(e) : printf("err\n"),
    }
}
