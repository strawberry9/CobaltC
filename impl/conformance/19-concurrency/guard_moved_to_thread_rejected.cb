// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.lock; [Thread-Lend]; rule.alias.thread-affine [Thread-Affine]; D-0240; conf.guard-moved-to-thread
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// A guard moved to a spawned thread: its lock path is not lent
// (`[Thread-Lend]`, D-0240) and stays `main`'s, so the thread's access
// through it faults while `main` runs, in every order.

import std;

fn hold(guard<i32> g)
{
    *g = *g + 1;
}

fn main()
{
    mutex<i32> m = Mutex::new(0);
    auto g = lock(&m);
    auto h = spawn(hold, g);
    join(h);
    auto g2 = lock(&m);
    printf("%v\n", *g2);
}
