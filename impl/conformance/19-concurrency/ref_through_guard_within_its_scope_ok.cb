// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.lock [Guard-Drop]; conf.ref-through-guard-within-its-scope
// kind: positive
// expect: ok
//
// A reference reached through a bound guard and used while the guard lives,
// and one through a temporary guard used within its statement, are fine:
// the refusals of bug 005 are only for a use after the unlock.

import std;

fn main()
{
    mutex<String> m = Mutex::new("hello");
    usize n = 0;
    {
        guard<String> g = lock(&m);
        ref<String, shared> r = &*g;
        n = StringView::len(r);
    }
    usize k = StringView::len(&*lock(&m)) + Vec::len(&Vec::from_slice(&[1: u8, 2]));
    assert(n == 5 && k == 7);
    printf("%v %v\n", n, k);
}
