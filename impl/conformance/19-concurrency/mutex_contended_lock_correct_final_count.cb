// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.lock [Lock]
// kind: positive
// expect: ok
//
// Several threads incrementing one mutex-guarded counter under real
// contention must still produce the exact correct final count -- a
// genuine mutual-exclusion property, not merely "doesn't crash".

fn worker(ref<mutex<i32>, shared> m) : i32
{
    auto g = lock(m);
    *g = *g + 1;
    0
}

fn main()
{
    mutex<i32> counter = Mutex::new(0);
    auto h0 = spawn(worker, &counter);
    auto h1 = spawn(worker, &counter);
    auto h2 = spawn(worker, &counter);
    auto h3 = spawn(worker, &counter);
    join(h0);
    join(h1);
    join(h2);
    join(h3);
    auto g = lock(&counter);
    if (*g != 4)
    {
        1 / (1 - 1);
    }
}
