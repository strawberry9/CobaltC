// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.fail.fault-contain `contained`; D-0204; conf.thread-channel-exclusive
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// A thread receives, through a channel, an exclusive reference to the main
// thread's vector, writes through it, and faults. Receiving locks the
// channel, a mutex whose interior may hold an exclusive reference: the
// thread is lent another's data, as if it had been given the reference at
// `spawn`, so its fault is not contained -- `try_join` notwithstanding,
// the program ends. (Both tools once contained it; found 2026-10-10.)

import std;

fn worker(ref<Channel<ref<Vec<u64>, exclusive>>, shared> c) : u64
{
    auto r = Option::unwrap(Channel::recv(c));
    Vec::push(r, 5);
    Vec<u64> e = Vec::new();
    e[3]
}

fn main()
{
    Vec<u64> v = Vec::new();
    Channel<ref<Vec<u64>, exclusive>> c = Channel::new(1);
    auto h = spawn(worker, &c);
    _ = Channel::send(&c, &mut v);
    match (try_join(h))
    {
        Ok(_)  : printf("ok\n"),
        Err(f) : printf("contained: %s\n", &ThreadFailure::diagnostic(&f)),
    }
    printf("len %v\n", Vec::len(&v));
}
