// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.channel [Send] [Recv]; D-0063; conf.channel-fifo-bounded
// kind: positive
// expect: ok
// expect-stdout-hex: 73656e74203230302c2072656365697665642032303020696e206f726465720a
//
// A producer thread sends 200 numbered strings through a channel of
// capacity 1, so it waits after nearly every send; the receiver finds
// them all, in the order they were sent. The producer's result is how
// many sends succeeded.

import std;

fn produce(ref<Channel<String>, shared> ch, u32 n) : u32
{
    u32 i = 0;
    while (i < n)
    {
        String s = String::new();
        String::appendf(&mut s, "v%v", i);
        match (Channel::send(ch, s))
        {
            Ok(_)  : {},
            Err(_) : return i,
        }
        i = i + 1;
    }
    Channel::close(ch);
    n
}

fn main() : u8
{
    Channel<String> ch = Channel::new(1);
    u32 expected = 0;
    u32 sent = 0;
    {
        auto h = spawn(produce, &ch, 200);
        while (true)
        {
            match (Channel::recv(&ch))
            {
                Some(s) :
                {
                    String want = sprintf("v%v", expected);
                    StringView got = String::view(&s, 0, String::len(&s));
                    if (got != String::view(&want, 0, String::len(&want)))
                    {
                        return 1;
                    }
                    expected = expected + 1;
                },
                None    : break,
            }
        }
        sent = join(h);
    }
    printf("sent %v, received %v in order\n", sent, expected);
    0
}
