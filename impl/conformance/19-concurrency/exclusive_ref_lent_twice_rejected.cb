// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: conf.exclusive-ref-lent-twice; rule.conc.spawn [Thread-Lend], rule.control.flow-analysis (D-0213, CHG-0251)
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// One exclusive reference passed whole to two threads. Spawning lends it:
// the first thread holds a path borrowed from it until it is joined, so the
// second lend is a second exclusive borrow of what `r` reaches while the
// first lives -- seen here by the analysis, which treats `spawn(…, r)` as
// a borrow of `*r` held by the handle.

import std;

fn bump(ref<i32, exclusive> a)
{
    *a = *a + 1;
}

fn main()
{
    i32 x = 0;
    ref<i32, exclusive> r = &mut x;
    auto h1 = spawn(bump, r);
    auto h2 = spawn(bump, r);
    join(h1);
    join(h2);
}
