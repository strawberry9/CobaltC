// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.fail.fault-unwind [Fault-Unwind] rule.conc.join [Handle-Destructor] (D-0009, D-0063); conf.fault-with-live-thread
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// A thread is asleep for a minute when the main thread faults. The fault
// unwinds main's frames, and the handle's destructor among them does not
// wait for the sleeping thread: the program ends at once, reporting the
// fault (before this clarification both tools waited for the thread).

import std;

fn nap(u64 ms) : u8
{
    sleep_ms(ms);
    0
}

fn main() : u8
{
    auto t = spawn(nap, 60000);
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    i32 x = v[arg_count() + 5];
    printf("%v\n", x);
    join(t)
}
