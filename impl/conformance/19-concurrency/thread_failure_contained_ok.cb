// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.fail.fault-contain [Fault-Contain]; std::try_join; D-0204; conf.thread-failure-contained
// kind: positive
// expect: ok
// expect-stdout-hex: 636f6e7461696e65643a20646961672e696e6465782d6f75742d6f662d626f756e64730a7374696c6c2072756e6e696e672c207468656e20310a
//
// A spawned thread faults (an index out of bounds); its fault is contained
// to it, and `try_join` hands it over as a value: the program goes on, and a
// second thread of the same function runs to its end.

import std;

fn bad(usize i) : i32
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    v[i]
}

fn main()
{
    auto h = spawn(bad, 5);
    match (try_join(h))
    {
        Ok(x)  : printf("ok %v\n", x),
        Err(f) : printf("contained: %s\n", &ThreadFailure::diagnostic(&f)),
    }
    auto g = spawn(bad, 0);
    printf("still running, then %v\n", join(g));
}
