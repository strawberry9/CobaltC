// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.join [Handle-Destructor]; spec/07 [Destroy-Composite]; CHG-0293; conf.handle-in-struct-waits
// kind: positive
// expect: ok
// expect-stdout-hex: 540a4d20320a
//
// A handle held in a struct field is destroyed with the struct, and its
// destructor waits for the thread (`[Destroy-Composite]` runs each resource
// field's destructor). Before CHG-0293 coby ran only a field's user `drop`,
// never a built-in destructor, so the struct ended without waiting.

import std;

fn slow(ref<i32, exclusive> p)
{
    usize s = 0;
    for (usize i = 0; i < 3000; i += 1)
    {
        s += 1;
    }
    *p = *p + 1;
    printf("T\n");
}

struct Job
{
    handle<void> h;
}

fn main()
{
    i32 x = 1;
    {
        Job j = Job { .h = spawn(slow, &mut x) };
    }
    printf("M %v\n", x);
}
