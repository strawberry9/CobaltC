// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Thread-Lend]; std::collections::slice_parts [Slice-Parts]; conf.slice-parts-lent-to-threads
// kind: positive
// expect: ok
// expect-stdout-hex: 333620380a
// decided: yes
//
// Each part `slice_parts` gives is lent to a thread of its own; the parts
// are disjoint (`[Slice-Parts]`), so no thread meets another's, and `v` is
// read only after every handle is joined. `slice_parts`' body is decided by
// its rule (D-0291), so `cobc` decides the whole program.

import std;

fn fill(slice<u64, exclusive> part, u64 first) : u64
{
    u64 sum = 0;
    for (usize i = 0; i < slice_len(part); i += 1)
    {
        part[i] = first + narrow<u64>(i) + 1;
        sum += part[i];
    }
    sum
}

fn main()
{
    Vec<u64> v = Vec::filled(8, 0: u64);
    u64 total = 0;
    {
        Vec<slice<u64, exclusive>> parts = slice_parts(&mut v[0..$], 3);
        Vec<handle<u64>> hs = Vec::new();
        u64 first = 0;
        while (Vec::len(&parts) > 0)
        {
            slice<u64, exclusive> c = Vec::remove(&mut parts, 0);
            u64 len = narrow<u64>(slice_len(c));
            Vec::push(&mut hs, spawn(fill, c, first));
            first += len;
        }
        foreach (h in hs)
        {
            total += join(h);
        }
    }
    printf("%v %v\n", total, v[7]);
}
