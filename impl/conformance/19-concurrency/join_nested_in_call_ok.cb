// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.join [Join] (blocking inside a nested call and inside an expression)
// kind: positive
// expect: ok
//
// A wait may happen at any depth: inside a helper the caller invoked,
// with committed statements before it, and nested inside an
// expression. Neither shape re-runs anything already executed. (The
// earlier unwind-and-retry blocking mechanism could resume only at a
// thread's outermost statement list.)

fn work(i32 n) : i32
{
    n * 2
}

fn helper() : i32
{
    i32 before = 1;
    auto h = spawn(work, 21);
    i32 r = join(h);
    before + r
}

fn check(bool ok)
{
    i32 z = if (ok)
    {
        1
    }
    else
    {
        0
    };
    1 / z;
}

fn main()
{
    check(helper() == 43);
    check(helper() == 43);
    auto h = spawn(work, 5);
    check(1 + join(h) == 11);
}
