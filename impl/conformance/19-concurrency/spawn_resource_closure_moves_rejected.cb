// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Spawn]; rule.fn.closure; rule.resauth.transfer
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// A `move` closure that owns a resource is itself a resource (spec/15:
// a closure is a struct), so `spawn` moves it into the new thread; the
// spawner's binding is moved from, and calling it again is stale.

import std;

fn main()
{
    String s = String::from_str("abc");
    auto work = move [s]() { String::len(&s) };
    auto h = spawn(work);
    printf("%v\n", join(h));
    printf("%v\n", work());
}
