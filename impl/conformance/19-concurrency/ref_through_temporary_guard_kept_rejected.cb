// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.lock [Guard-Drop]; rule.control.frame-references; D-0135; conf.ref-through-temporary-guard-kept
// kind: negative
// expect: diag.destroy-while-aliased (static)
//
// `&*lock(&m)` reaches the mutex's value through a guard that is a
// temporary: it ends, unlocking, with the statement, so a reference taken
// through it and used later is refuted (bug 005: it was taken for static
// data, and a later lock's write freed what it referred to).

import std;

fn main()
{
    mutex<String> m = Mutex::new("hello, original buffer");
    ref<String, shared> r = &*lock(&m);
    {
        guard<String> g = lock(&m);
        String::append(&mut *g, "-grow-the-buffer-so-it-reallocates");
    }
    printf("%v\n", StringView::len(r));
}
