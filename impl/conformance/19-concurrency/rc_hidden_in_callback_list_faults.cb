// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Thread-Confined]; rule.stdlib.rc; diag.not-thread-safe; conf.rc-hidden-in-callback-list
// kind: negative
// expect: diag.not-thread-safe (dynamic)
//
// A closure kept in a `Vec` of callbacks and run by a thread: the `Rc`
// it captured is cloned in a thread other than its maker's, which
// faults, so the two threads never update the count together.

import std;

fn run_all(Vec<fn() : usize> fs) : usize
{
    usize n = 0;
    foreach (f in &fs)
    {
        n += (*f)();
    }
    n
}

fn main()
{
    Rc<String> a = Rc::new("shared");
    Rc<String> b = Rc::clone(&a);
    Vec<fn() : usize> fs = Vec::new();
    Vec::push(&mut fs, move [b]() : usize
    {
        Rc<String> c = Rc::clone(&b);
        StringView::len(Rc::get(&c))
    });
    handle<usize> h = spawn(run_all, fs);
    printf("%v\n", join(h));
}
