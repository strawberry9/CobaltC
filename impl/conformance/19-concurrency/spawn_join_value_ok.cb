// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Spawn]; rule.conc.join [Join]
// kind: positive
// expect: ok
//
// spawn starts a genuine OS thread (impl/STATUS.md); join retrieves
// its result correctly.

fn work(i32 n) : i32
{
    n * 2
}

fn main()
{
    auto h = spawn(work, 21);
    if (join(h) != 42)
    {
        1 / (1 - 1);
    }
}
