// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.cancel [Cancel]; rule.conc.guarantee [Deadlock]; D-0204; conf.thread-cancel-lock
// kind: positive
// expect: ok
// expect-stdout-hex: 74616b65723a20646961672e7468726561642d63616e63656c6c65640a6d61696e207374696c6c20686f6c647320350a
//
// A thread waits for a mutex the main thread holds; the main thread cancels
// it and then joins it, still holding the lock. The cancelled thread's wait
// ends -- the join waits on a thread that will stop, so there is no cycle --
// and the main thread goes on.

import std;

fn taker(ref<mutex<i32>, shared> m) : i32
{
    auto g = lock(m);
    *g
}

fn main()
{
    auto m = Mutex::new(5);
    auto g = lock(&m);
    auto h = spawn(taker, &m);
    sleep_ms(30);
    cancel(&h);
    match (try_join(h))
    {
        Ok(v)  : printf("value %v\n", v),
        Err(e) : printf("taker: %s\n", &ThreadFailure::diagnostic(&e)),
    }
    printf("main still holds %v\n", *g);
}
