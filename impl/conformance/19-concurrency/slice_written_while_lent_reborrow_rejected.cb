// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.agg.slice [Slice-Index]; rule.conc.spawn [Thread-Lend]; D-0248; conf.slice-written-while-lent-reborrow
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// The thread is lent a reborrow of `s` and waits on the channel. Writing
// `s[0]` meanwhile meets that reborrow on the vector: `[Slice-Index]` checks
// the element's index there (D-0248). Before D-0248 the rule checked only the
// element's own object, and coby wrote the element from both threads.

import std;

fn wait_then_bump(ref<Channel<i32>, shared> c, slice<i32, exclusive> s)
{
    _ = Channel::recv(c);
    s[0] = s[0] + 1;
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 5);
    Channel<i32> ch = Channel::new(1);
    auto s = &mut v[0 .. 1];
    auto t = spawn(wait_then_bump, &ch, s);
    s[0] = 9;
    _ = Channel::send(&ch, 1);
    join(t);
    printf("%v\n", v[0]);
}
