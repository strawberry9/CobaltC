// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: [Thread-Lend] (an exclusive reference behind a shared one is not lent); spec/14 scoped lending; conf.thread-lent-exclusive-through-shared
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// The thread is lent `&r`, a shared reference to an exclusive one. Only
// the exclusive paths in an argument's own value are lent (`[Thread-Lend]`),
// so `r`'s path stays this thread's, and the thread's read through it
// faults while this thread runs. The static pass leaves it to the run.

import std;

fn read2(ref<ref<i32, exclusive>, shared> h) : i32
{
    **h
}

fn main()
{
    i32 x = 1;
    ref<i32, exclusive> r = &mut x;
    auto t1 = spawn(read2, &r);
    printf("%v\n", join(t1));
}
