// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Thread-Lend]; rule.control.frame-references (a wrapped handle, D-0291); conf.wrapped-handle-maybe-lent
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// `fed` holds a handle on one path only, and what its thread was lent with
// it (a fact `?`): writing `x` meanwhile conflicts on that path, so the run
// checks it, and the program is not decided. With no argument the thread is
// spawned, and waits on the channel, so the write faults.

import std;

fn bump(ref<Channel<i32>, shared> c, ref<u32, exclusive> p) : u8
{
    _ = Channel::recv(c);
    *p += 1;
    1
}

fn main() : void
{
    u32 x = 0;
    Channel<i32> ch = Channel::new(1);
    bool go = arg_count() == 0;
    Option<handle<u8>> fed = if (go) { Some(spawn(bump, &ch, &mut x)) } else { None };
    x = 5;
    _ = Channel::send(&ch, 1);
    match (fed)
    {
        Some(h) : { _ = join(h); },
        None    : {},
    }
    printf("%v\n", x);
}
