// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Thread-Confined]; diag.not-thread-safe; conf.rc-move-capture
// kind: negative
// expect: diag.not-thread-safe (static)
//
// A `move` closure capturing an `Rc` takes it to the thread it runs on
// (bug 031).

import std;

fn main()
{
    Rc<String> a = Rc::new("shared across threads");
    Rc<String> b = Rc::clone(&a);
    handle<usize> h = spawn(move [b]() { Rc<String> c = Rc::clone(&b); StringView::len(Rc::get(&c)) });
    printf("%v %v\n", join(h), StringView::len(Rc::get(&a)));
}
