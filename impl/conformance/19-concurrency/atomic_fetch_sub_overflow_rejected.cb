// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.atomic [Atomic-Overflow]; D-0249; conf.atomic-fetch-sub-overflow
// kind: negative
// expect: diag.arith-overflow (dynamic)
//
// `fetch_sub` below zero on an unsigned atomic is an overflow, a fault at
// the call, as `-` would be.

import std;

fn main()
{
    Atomic<u32> a = Atomic::new(3: u32);
    u32 n = Atomic::load(&a) + 1;
    _ = Atomic::fetch_sub(&a, n);
}
