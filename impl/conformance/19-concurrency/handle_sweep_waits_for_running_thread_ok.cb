// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.join [Handle-Destructor] (automatic sweep waits)
// kind: positive
// expect: ok
//
// An unjoined handle's automatic destruction at block exit waits for
// the thread exactly as `join` would ("a thread can never outlive the
// frame that owns its handle"), so the worker's 2000 increments are
// all complete before the block ends.

fn slow(ref<mutex<i32>, shared> m) : i32
{
    i32 i = 0;
    while (i < 2000)
    {
        auto g = lock(m);
        *g = *g + 1;
        i = i + 1;
    }
    0
}

fn check(bool ok)
{
    i32 z = if (ok)
    {
        1
    }
    else
    {
        0
    };
    1 / z;
}

fn main()
{
    auto m = Mutex::new(0);
    {
        auto h = spawn(slow, &m);
    }
    check(*lock(&m) == 2000);
}
