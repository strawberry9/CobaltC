// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.atomic [Atomic-Overflow]; rule.stdlib.atomic; D-0249; conf.atomic-fetch-add-overflow-unchanged
// kind: positive
// expect: ok
// expect-stdout-hex: 646961672e61726974682d6f766572666c6f770a3235350a
//
// A `fetch_add` whose sum does not fit faults as `+` would, and stores
// nothing: the thread's contained failure is `diag.arith-overflow`, and the
// atomic still holds what it held.

import std;

fn bump(ref<Atomic<u8>, shared> a) : u8
{
    Atomic::fetch_add(a, 10)
}

fn main()
{
    Atomic<u8> a = Atomic::new(250: u8);
    {
        auto h = spawn(bump, &a);
        match (try_join(h))
        {
            Ok(_)  : assert(false),
            Err(f) : printf("%s\n", &ThreadFailure::diagnostic(&f)),
        }
    }
    assert(Atomic::load(&a) == 250);
    assert(Atomic::fetch_add(&a, 5) == 250);
    printf("%v\n", Atomic::load(&a));
}
