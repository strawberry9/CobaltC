// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.atomic; rule.resauth.transfer; D-0249; conf.atomic-moved-while-shared
// kind: negative
// expect: diag.move-while-aliased (static)
//
// Moving an atomic while a reference to it is still used is refused, as for
// any resource.

import std;

fn main()
{
    Atomic<u64> a = Atomic::new(1: u64);
    auto r = &a;
    Atomic<u64> b = a;
    printf("%v %v\n", Atomic::load(r), Atomic::load(&b));
}
