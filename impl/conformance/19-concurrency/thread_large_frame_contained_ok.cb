// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: [Call-Stack-Exhausted] [Join-Failed]; D-0204; conf.thread-large-frame-contained
// kind: positive
// expect: ok
// expect-stdout-hex: 7468726561642030206661696c65643a20646961672e737461636b2d6578686175737465640a7468726561642031206661696c65643a20646961672e737461636b2d6578686175737465640a7468726561642032206661696c65643a20646961672e737461636b2d6578686175737465640a736d616c6c20370a6d61696e20676f6573206f6e0a
//
// Bug 032: a thread whose one frame is larger than its whole stack fails
// with `diag.stack-exhausted`, which `try_join` contains, three times in a
// row (on Windows the stack's guard is made again after each), and a thread
// after them runs as usual.

import std;

fn big() : u8
{
    array<u8, 100000000> a = [3; 100000000];
    usize i = arg_count() + 99999999;
    a[i]
}

fn main()
{
    for (u32 k = 0; k < 3; k += 1)
    {
        handle<u8> h = spawn(big);
        match (try_join(h))
        {
            Ok(v)  : printf("thread %v gave %v\n", k, v),
            Err(f) : printf("thread %v failed: %v\n", k, &ThreadFailure::diagnostic(&f)),
        }
    }
    handle<u8> s = spawn(move []() { 7: u8 });
    match (try_join(s))
    {
        Ok(v)  : printf("small %v\n", v),
        Err(f) : printf("small failed: %v\n", &ThreadFailure::diagnostic(&f)),
    }
    printf("main goes on\n");
}
