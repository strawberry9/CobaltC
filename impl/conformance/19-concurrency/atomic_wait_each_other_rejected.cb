// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.guarantee [Deadlock] (b); rule.conc.atomic [Atomic-Wait]; D-0253; conf.atomic-wait-each-other
// kind: negative
// expect: diag.deadlock (dynamic)
//
// Each thread waits for the other to store first. Every live thread waits,
// none on a thread or a mutex, so each is the end of a chain of waits and
// faults; the main thread's fault is the program's, whatever the timing.

import std;

fn main()
{
    Atomic<u32> a = Atomic::new(0: u32);
    Atomic<u32> b = Atomic::new(0: u32);
    {
        handle<void> h = spawn(move [](ref<Atomic<u32>, shared> a, ref<Atomic<u32>, shared> b)
        {
            Atomic::wait(b, 0);
            Atomic::store(a, 1);
            Atomic::notify_all(a);
        }, &a, &b);
        Atomic::wait(&a, 0);
        Atomic::store(&b, 1);
        Atomic::notify_all(&b);
        join(h);
    }
}
