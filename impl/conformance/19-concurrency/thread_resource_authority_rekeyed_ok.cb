// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Spawn] (argument transfer, ℓ2 ≠ ℓ); rule.conc.join [Join] (result re-keyed to the joiner); conf.spawn-join-resource-result
// kind: positive
// expect: ok
//
// Destroy authority is per thread: a resource passed to a spawned
// thread is destroyed there; a resource returned from one is re-keyed
// to the joiner, which may then drop it. The interpreter tracks the
// owning thread per object and would fault diag.no-destroy-authority
// otherwise.

import std;

fn make() : Vec<i32>
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 5);
    v
}

fn takes(Vec<i32> v) : usize
{
    Vec::len(&v)
}

fn check(bool ok)
{
    i32 z = if (ok)
    {
        1
    }
    else
    {
        0
    };
    1 / z;
}

fn main()
{
    auto h1 = spawn(make);
    auto v1 = join(h1);
    check(Vec::len(&v1) == 1);
    drop(v1);
    Vec<i32> w = Vec::new();
    Vec::push(&mut w, 3);
    auto h2 = spawn(takes, w);
    check(join(h2) == 1);
    Vec<i32> z = Vec::new();
    Vec::push(&mut z, 4);
    auto h3 = spawn(move [z]()
    {
        Vec::len(&z)
    });
    check(join(h3) == 1);
}
