// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.lock [Lock-Reentrant]; D-0202; conf.mutex-bare-guard-reentrant
// kind: negative
// expect: diag.mutex-reentrant-lock (dynamic)
//
// The same mutex reached through two references, locked through each in
// turn in one block, by guards used only as `*g` (which `cobc` takes and
// gives back without a guard object): the second lock is still a
// reentrant-lock fault, not a deadlock.

fn bump(ref<mutex<i32>, shared> a, ref<mutex<i32>, shared> b)
{
    auto g = lock(a);
    *g += 1;
    auto h = lock(b);
    *h += 1;
}

fn main()
{
    mutex<i32> m = Mutex::new(0);
    bump(&m, &m);
}
