// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.join [Fault-Contain], [Fault-Unwind] (D-0315); conf.contained-fault-runs-table-destructors
// kind: positive
// expect: ok
// expect-stdout-hex: 5b676f6e655d5b335d5b325d5b315d20636f6e7461696e65640a5b676f6e655d5b335d5b325d5b315d616674657220300a
//
// A spawned thread faults with three locals live at three depths (and one
// already dropped): exactly those three destructors run, innermost first,
// and the program goes on.

import std;

resource struct Noisy
{
    String name;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("[%v]", &self.name);
}

fn make(StringView name) : Noisy
{
    Noisy { .name = String::copy(name) }
}

fn d3(u8 k) : u8
{
    Noisy c = make("3");
    assert(k == 0, "deep");
    k
}

fn d2(u8 k) : u8
{
    Noisy b = make("2");
    Noisy gone = make("gone");
    drop(gone);
    d3(k)
}

fn d1(u8 k) : u8
{
    Noisy a = make("1");
    d2(k)
}

fn main()
{
    match (try_join(spawn(d1, 1)))
    {
        Ok(_)  : printf(" returned\n"),
        Err(_) : printf(" contained\n"),
    }
    printf("after %v\n", d1(0));
}
