// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Thread-Lend]; rule.control.flow-analysis (Forgetting hands over, D-0291); conf.ref-lent-in-loop-handle-kept-written
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// Each pass lends a reference to an element of `v` to a thread whose handle
// is kept in `hs` past the loop; the threads wait on a channel. When `r`'s
// block ends, what the handle holds through `r` is handed to what `r`
// referred to (D-0291), so writing `v[0]` after the loop meets the first
// thread's lent path. Before D-0291 the fact ended with `r`, and `cobc`
// decided the program and wrote with no check.

import std;

fn bump(ref<Channel<i32>, shared> c, ref<u64, exclusive> p) : u64
{
    _ = Channel::recv(c);
    *p += 1;
    *p
}

fn main() : void
{
    Vec<u64> v = Vec::filled(4, 0: u64);
    Channel<i32> ch = Channel::new(2);
    Vec<handle<u64>> hs = Vec::new();
    for (usize i = 0; i < 2; i += 1)
    {
        ref<u64, exclusive> r = Vec::index_exclusive(&mut v, i);
        Vec::push(&mut hs, spawn(bump, &ch, r));
    }
    v[0] = 7;
    _ = Channel::send(&ch, 1);
    _ = Channel::send(&ch, 1);
    u64 t = 0;
    foreach (h in hs)
    {
        t += join(h);
    }
    printf("%v\n", t);
}
