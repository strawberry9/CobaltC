// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: conf.exclusive-ref-sent-then-used; rule.conc.channel [Send] [Thread-Lend] (D-0213, CHG-0251)
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// A thread receives an exclusive reference through a channel while the
// sender keeps its own copy. `Channel::send` lends what it carries: the
// value in the channel, then the receiver, holds a path borrowed from the
// sender's reference, so the sender's next write through its copy clashes
// with it, whether the value is still in the channel or received: the
// receiver uses it again after `main` lets it go, which `main` never
// reaches, so it holds it throughout (a reference binding ends at its last
// use, D-0111).

import std;

fn take(ref<Channel<ref<i32, exclusive>>, shared> c, ref<Channel<i32>, shared> go)
{
    auto p = Option::unwrap(Channel::recv(c));
    *p = *p + 1;
    _ = Channel::recv(go);
    *p = *p + 1;
}

fn main()
{
    i32 x = 0;
    ref<i32, exclusive> r = &mut x;
    Channel<ref<i32, exclusive>> c = Channel::new(1);
    Channel<i32> go = Channel::new(1);
    auto h = spawn(take, &c, &go);
    _ = Channel::send(&c, r);
    *r = *r + 1;
    _ = Channel::send(&go, 1);
    join(h);
}
