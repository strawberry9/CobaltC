// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Thread-Confined]; diag.not-thread-safe; conf.rc-closure-binding-spawned
// kind: negative
// expect: diag.not-thread-safe (static)
//
// A closure binding whose literal captured an `Rc`, spawned: what it
// captured goes to the thread with it (bug 031).

import std;

fn main()
{
    Rc<u64> a = Rc::new(5: u64);
    Rc<u64> b = Rc::clone(&a);
    auto c = move [b]() { *Rc::get(&b) };
    handle<u64> h = spawn(c);
    printf("%v %v\n", join(h), *Rc::get(&a));
}
