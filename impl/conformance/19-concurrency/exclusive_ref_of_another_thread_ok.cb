// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: conf.exclusive-ref-of-another-thread; spec/08 [Thread-Affine] (D-0213, CHG-0251), [Read-Ref-Through-Shared] (D-0218, CHG-0257)
// kind: positive
// expect: ok
// expect-stdout-hex: 6469616720646961672e616c696173696e672d636f6e666c6963740a6469616720646961672e616c696173696e672d636f6e666c6963740a
//
// Two threads lent a shared reference to a struct that holds an exclusive
// reference `main` formed, each reading through it. The exclusive path is
// `main`'s, and `main` is running: reading through it, the thread borrows
// from it (D-0218: what a shared reference reaches is shared), and a
// borrow from it by another thread is `diag.aliasing-conflict`, whatever
// the timing -- an exclusive reference is used only by the thread it
// belongs to, and reaches another thread only lent, at `spawn` or through
// a channel. Each thread's fault is contained (neither was lent an
// exclusive reference) and `try_join` reports it. (A write through it, as
// this case had before D-0218, is now rejected statically.)

import std;

struct Holder
{
    ref<i32, exclusive> inner;
}

fn add(ref<Holder, shared> h)
{
    i32 seen = *h.inner;
    assert(seen >= 0);
}

fn main()
{
    i32 x = 0;
    Holder h = Holder { .inner = &mut x };
    auto t1 = spawn(add, &h);
    auto t2 = spawn(add, &h);
    match (try_join(t1))
    {
        Ok(_)  : printf("ok\n"),
        Err(f) : printf("diag %s\n", &ThreadFailure::diagnostic(&f)),
    }
    match (try_join(t2))
    {
        Ok(_)  : printf("ok\n"),
        Err(f) : printf("diag %s\n", &ThreadFailure::diagnostic(&f)),
    }
}
