// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.agg.field [Guard-Auto-Deref]; D-0064; conf.guard-auto-deref-stale
// kind: negative
// expect: diag.stale-binding (static)
//
// `g.n` reaches through the guard, which must still be alive: after
// `drop(g)` the mutex is unlocked and the guard gone.

import std;

struct S
{
    usize n;
}

fn main()
{
    auto m = Mutex::new(S { .n = 1 });
    auto g = lock(&m);
    drop(g);
    printf("%v\n", g.n);
}
