// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.trust.reclaim [Reclaim] (re-attachment hands authority to the reclaiming thread, CHG-0030)
// kind: positive
// expect: ok
//
// A worker changes a resource element of a `Vec` behind a mutex; after
// `join`, the owner's `Vec::drop` destroys it. coby once left the
// element's destroy authority with the worker that first reached it,
// and the owner's destruction failed (diag.no-destroy-authority).

import std;

struct Account
{
    String owner;
    i64 cents;
}

fn deposit(ref<mutex<Vec<Account>>, shared> bank) : i64
{
    auto g = lock(bank);
    auto a = &mut (*g)[0];
    a.cents += 5;
    a.cents
}

fn main()
{
    Vec<Account> v = Vec::new();
    Vec::push(&mut v, Account { .owner = String::from_str("ada"), .cents = 10 });
    auto bank = Mutex::new(v);
    auto h = spawn(deposit, &bank);
    if (join(h) != 15)
    {
        fault(index_out_of_bounds);
    }
}
