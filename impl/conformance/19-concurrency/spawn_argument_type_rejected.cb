// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Spawn] (the arguments are the call's: each of its parameter's type); conf.spawn-argument-type (D-0232)
// kind: negative
// expect: diag.type-mismatch (static)
//
// `spawn(f, a…)` runs `f(a…)` in a new thread, so each argument is typed
// against `f`'s parameter, as in a call: a `bool` is not an `i32`.

fn twice(i32 x) : i32
{
    x * 2
}

fn main()
{
    auto h = spawn(twice, true);
    _ = join(h);
}
