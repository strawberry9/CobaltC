// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.agg.field [Guard-Auto-Deref]; rule.conc.lock [Guard-Deref]; D-0064; conf.guard-auto-deref
// kind: positive
// expect: ok
// expect-stdout-hex: 682030206c6f672036207061697220330a30203220323020320a320a
//
// Through a guard, `g.f` is `(*g).f` and `g[i]` is `(*g)[i]`: fields of
// a guarded struct read, written and borrowed (`&mut g.v`, `&g.v`),
// an element of a `Vec` field and of an array field, and elements of a
// guarded `Vec` and a guarded array. The arithmetic on `g.head` takes
// the field's type (`usize`).

import std;

struct S
{
    usize head;
    Vec<i32> v;
    array<u8, 3> a;
}

struct Board
{
    mutex<S> s;
    mutex<Vec<u64>> log;
    mutex<array<i32, 2>> pair;
}

fn bump(ref<Board, shared> b) : usize
{
    auto g = lock(&b.s);
    g.head = (g.head + 1) % 7;
    g.a[1] = g.a[1] + 2;
    Vec::push(&mut g.v, 3);
    g.v[0] = g.v[0] * 2;
    g.head
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 10);
    Board b = Board { .s = Mutex::new(S { .head = 6, .v = v, .a = [0, 0, 0] }), .log = Mutex::new(Vec::new()), .pair = Mutex::new([1, 2]) };
    usize h = bump(&b);
    {
        auto l = lock(&b.log);
        Vec::push(&mut *l, 5);
        l[0] = l[0] + 1;
        auto p = lock(&b.pair);
        p[1] = p[0] + p[1];
        printf("h %v log %v pair %v\n", h, l[0], p[1]);
    }
    auto g = lock(&b.s);
    printf("%v %v %v %v\n", g.head, g.a[1], g.v[0], Vec::len(&g.v));
    ref<Vec<i32>, shared> r = &g.v;
    printf("%v\n", Vec::len(r));
}
