// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Thread-Lend]; conf.exclusive-ref-lent-to-shared-param
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `[Thread-Lend]` lends every exclusive reference among the arguments before
// the parameters are bound: `s` is lent exclusively although `show` takes a
// shared reference, so reading `s.a` while the thread holds the lent path
// conflicts with it on every run (D-0291). Before D-0291 the lend was taken
// as shared, and the program was decided.

import std;

struct P
{
    i32 a;
}

fn show(ref<Channel<i32>, shared> c, ref<P, shared> s)
{
    _ = Channel::recv(c);
    printf("%v\n", s.a);
}

fn main()
{
    P p = P { .a = 5 };
    Channel<i32> ch = Channel::new(1);
    auto s = &mut p;
    auto t = spawn(show, &ch, s);
    printf("%v\n", s.a);
    _ = Channel::send(&ch, 1);
    join(t);
}
