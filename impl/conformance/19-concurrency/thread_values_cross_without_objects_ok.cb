// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Spawn], [Join], [Lock], [Guard-Drop] (D-0315); conf.thread-values-cross-without-objects
// kind: positive
// expect: ok
// expect-stdout-hex: 613a783a310a623a79323a320a3320320a
//
// A decided program's thread values with no runtime object (D-0315 step 4):
// `String`s moved into a thread, its `String` result joined, a handle joined
// straight from `spawn` and one bound first, handles in an array that end
// with their block (each waiting for its thread), a mutex
// made from an empty vector and locked by a guard that ends (unlocking) with
// each call, a guard's temporary read in place.

import std;

fn label(String a, String s, usize n) : String
{
    sprintf("%v:%v:%v", &a, &s, n)
}

fn add(ref<mutex<Vec<String>>, shared> m, usize n) : usize
{
    auto g = lock(m);
    Vec::push(&mut *g, sprintf("w%v", n));
    Vec::len(&*g)
}

fn main()
{
    String r = join(spawn(label, String::copy("a"), String::copy("x"), 1));
    printf("%v\n", &r);
    String b = String::copy("b");
    auto h = spawn(label, b, sprintf("%v%v", "y", 2), 2);
    printf("%v\n", &join(h));
    mutex<Vec<String>> m = Mutex::new(Vec::new());
    auto h1 = spawn(add, &m, 1);
    auto h2 = spawn(add, &m, 2);
    usize first = join(h1) + join(h2);
    {
        // `[Handle-Destructor]`: each waits for its thread and ends its result.
        array<handle<String>, 2> hs = [spawn(label, String::copy("c"), String::copy("z"), 3), spawn(
            label,
            String::copy("d"),
            String::copy("w"),
            4,
        )];
    }
    printf("%v %v\n", first, Vec::len(&*lock(&m)));
}
