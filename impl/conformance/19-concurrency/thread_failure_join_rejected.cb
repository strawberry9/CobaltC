// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.join [Join-Failed]; D-0204; conf.thread-failure-join
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// A spawned thread faults; `join` raises its fault again, in the joiner, at
// the thread's own location: a program that does not ask for the failure as
// a value fails as a whole.

import std;

fn bad(usize i) : i32
{
    Vec<i32> v = Vec::new();
    v[i]
}

fn main()
{
    auto h = spawn(bad, 3);
    printf("before join\n");
    i32 x = join(h);
    printf("never %v\n", x);
}
