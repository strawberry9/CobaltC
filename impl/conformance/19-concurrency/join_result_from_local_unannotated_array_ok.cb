// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.join [Join]; rule.agg.array-construct
// kind: positive
// expect: ok
//
// A thread whose result is a struct held in a local (not a struct
// literal), joined inside an array literal with no annotation, from a
// function and from a move closure: the result is typed by the callee's
// declared result type. coby typed it from the value alone, which does
// not name its struct (`void`), and reading a field faulted
// `diag.type-mismatch`. Found by real-world testing (a bank simulation).

import std;

struct Tally
{
    usize done;
    usize refused;
}

fn work(usize rounds) : Tally
{
    Tally t = Tally { .done = 0, .refused = 0 };
    usize k = 0;
    while (k < rounds)
    {
        t.done += 1;
        k += 1;
    }
    t
}

fn main()
{
    usize n = 4;
    usize sum = 0;
    {
        auto a = spawn(work, 3);
        auto b = spawn(move [n]()
        {
            Tally t = Tally { .done = n, .refused = 1 };
            t
        });
        foreach (r in [join(a), join(b)])
        {
            sum += r.done + r.refused;
        }
    }
    assert(sum == 8);
}
