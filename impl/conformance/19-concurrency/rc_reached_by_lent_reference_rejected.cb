// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Thread-Confined]; diag.not-thread-safe; conf.rc-reached-by-lent-reference
// kind: negative
// expect: diag.not-thread-safe (static)
//
// A type that refers to an `Rc` is thread-confined too: a shared reference
// to a struct holding a `Weak`, lent to a thread, would let it upgrade and
// clone (bug 031).

import std;

struct Node
{
    u64 id;
    Weak<u64> parent;
}

fn peek(ref<Node, shared> n) : bool
{
    Option::is_some(&Weak::upgrade(&n.parent))
}

fn main()
{
    Rc<u64> a = Rc::new(1: u64);
    Node n = Node { .id = 1, .parent = Rc::downgrade(&a) };
    handle<bool> h = spawn(peek, &n);
    printf("%v\n", join(h));
}
