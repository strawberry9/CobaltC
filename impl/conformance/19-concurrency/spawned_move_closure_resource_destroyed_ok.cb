// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn (a spawned move closure ends with its thread); rule.resauth.destroy-composite
// kind: positive
// expect: ok
//
// The closure owns `x`; it is destroyed when its thread finishes, so the
// destructor prints before `join` returns and "joined" is printed.

import std;

resource struct Noisy
{
    i32 n;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("dropped\n");
}

fn main()
{
    Noisy x = Noisy { .n = 3 };
    auto h = spawn(move [x]()
    {
        x.n
    });
    i32 r = join(h);
    printf("joined\n");
}
