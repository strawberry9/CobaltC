// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.stdlib.swap [Swap-Places-Conflict]; rule.alias.thread-affine [Thread-Affine]; D-0213, D-0235; conf.swap-through-another-threads-ref
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// An exclusive reference to `main`'s `x` reaches `swapper` inside a `Vec`
// moved to it, so it is not lent and stays `main`'s (`[Thread-Affine]`).
// `swap` through it writes `x` by `[Write]` (D-0235) and faults while
// `main` runs, in every order (`cobc --explore 40`: one outcome). Before
// D-0235 both threads wrote `x` with no fault.

import std;

fn swapper(Vec<ref<i32, exclusive>> v)
{
    i32 z = 100;
    swap(*Vec::index_exclusive(&mut v, 0), &mut z);
    printf("%v\n", z);
}

fn main()
{
    i32 x = 1;
    auto r = &mut x;
    Vec<ref<i32, exclusive>> w = Vec::new();
    Vec::push(&mut w, r);
    auto h = spawn(swapper, w);
    *r = *r + 1;
    join(h);
    printf("%v\n", x);
}
