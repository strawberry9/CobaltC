// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.channel [Channel-Zero-Capacity]; D-0063; conf.channel-zero-capacity
// kind: negative
// expect: diag.channel-zero-capacity (dynamic)
//
// A channel holds at least one value.

import std;

fn main()
{
    usize cap = 0;
    Channel<i32> ch = Channel::new(cap);
    _ = Channel::send(&ch, 1);
}
