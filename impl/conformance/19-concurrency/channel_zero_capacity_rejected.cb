// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.channel [Channel-Zero-Capacity]; D-0063; conf.channel-zero-capacity
// kind: negative
// expect: diag.channel-zero-capacity (dynamic)
//
// A channel holds at least one value. The capacity is 0 only when the program
// runs (a literal 0 is rejected before the run: `Channel::new`'s requirement,
// D-0317).

import std;

fn main()
{
    Vec<u8> none = Vec::new();
    usize cap = Vec::len(&none);
    Channel<i32> ch = Channel::new(cap);
    _ = Channel::send(&ch, 1);
}
