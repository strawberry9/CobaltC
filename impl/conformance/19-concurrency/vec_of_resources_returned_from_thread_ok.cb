// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr [Reclaim] (re-attachment takes the destroy authority, CHG-0030); conf.thread-vec-of-resources-returned
// kind: positive
// expect: ok
//
// The elements are established in the spawned thread; join re-keys only
// the outer Vec's authority to main (CHG-0015). Main destroys the
// elements through Vec::drop's reclaim, which takes their authority.

import std;

fn make() : Vec<String>
{
    Vec<String> words = Vec::new();
    Vec::push(&mut words, String::from_str("a"));
    Vec::push(&mut words, String::from_str("bc"));
    words
}

fn main()
{
    auto h = spawn(make);
    auto words = join(h);
    if (Vec::len(&words) != 2 || String::len(Vec::index_shared(&words, 1)) != 2)
    {
        1 / (1 - 1);
    }
}
