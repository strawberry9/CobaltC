// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.channel [Channel-Deadlock] [Recv]; D-0063; conf.channel-deadlock
// kind: negative
// expect: diag.channel-deadlock (dynamic)
//
// The main thread, with no other thread running, waits on an empty
// channel that is not closed: nothing could ever send to it.

import std;

fn main()
{
    Channel<i32> ch = Channel::new(2);
    _ = Channel::send(&ch, 1);
    Channel::recv(&ch);
    Channel::recv(&ch);
}
