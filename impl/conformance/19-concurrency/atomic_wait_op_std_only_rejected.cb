// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.stdlib.atomic; D-0253; conf.atomic-wait-op-std-only
// kind: negative
// expect: diag.unbound-name (static)
//
// `atomic_wait_op` and `cpu_op` are the std-only intrinsics under
// `Atomic::wait`, the notifications, `atomic_fence` and `spin_hint`; a
// program cannot name them.

import std;

fn main()
{
    Atomic<u32> a = Atomic::new(0: u32);
    u64 seen = atomic_wait_op(&a, 0, 0);
}
