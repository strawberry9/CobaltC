// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: conf.exclusive-ref-in-struct-two-threads; rule.conc.spawn [Thread-Lend] (D-0213, CHG-0251)
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// One exclusive reference copied into two structs, each moved to a thread
// of its own. Spawning lends every exclusive reference an argument holds,
// however deep in it: the second lend borrows from the same reference
// while the first thread's path lives, and faults at the second `spawn`.

import std;

struct Job
{
    ref<i32, exclusive> target;
    i32 times;
}

fn work(Job j)
{
    foreach (i in 0..j.times)
    {
        *j.target = *j.target + 1;
    }
}

fn main()
{
    i32 x = 0;
    ref<i32, exclusive> r = &mut x;
    Job a = Job { .target = r, .times = 1000 };
    Job b = Job { .target = r, .times = 1000 };
    auto h1 = spawn(work, a);
    auto h2 = spawn(work, b);
    join(h1);
    join(h2);
}
