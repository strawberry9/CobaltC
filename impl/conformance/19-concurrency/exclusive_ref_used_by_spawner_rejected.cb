// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: conf.exclusive-ref-used-by-spawner; rule.conc.spawn [Thread-Lend], rule.control.flow-analysis (D-0213, CHG-0251)
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// A thread is lent `r`; the spawner then writes through its own copy
// before joining. The thread's path, borrowed from `r`, lives until the
// join, so the write is to what another live exclusive path reaches.

import std;

fn bump(ref<i32, exclusive> a)
{
    *a = *a + 1;
}

fn main()
{
    i32 x = 0;
    ref<i32, exclusive> r = &mut x;
    auto h = spawn(bump, r);
    *r = 5;
    join(h);
}
