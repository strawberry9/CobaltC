// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Spawn] (D-0200); conf.spawn-in-raw-form
// kind: positive
// expect: ok
// expect-stdout-hex: 3920342031370a
//
// Two functions that spawn threads, one of them returning a `Vec` its
// caller binds with no runtime object (so `cobc` also lowers its `__raw`
// form): each spawn keeps a thread body of its own.

import std;

fn square_all(Vec<u64> v) : Vec<u64>
{
    Vec<u64> out = Vec::new();
    foreach (x in &v)
    {
        Vec::push(&mut out, *x * *x);
    }
    out
}

fn squares(u64 n) : Vec<u64>
{
    Vec<u64> v = Vec::new();
    for (u64 i = 0; i < n; i += 1)
    {
        Vec::push(&mut v, i);
    }
    auto h = spawn(square_all, v);
    join(h)
}

fn total(u64 n) : u64
{
    auto h = spawn(square_all, squares(n));
    Vec<u64> r = join(h);
    u64 t = 0;
    foreach (x in &r)
    {
        t += *x;
    }
    t
}

fn main() : u8
{
    Vec<u64> s = squares(4);
    printf("%v %v %v\n", s[3], Vec::len(&s), total(3));
    0
}
