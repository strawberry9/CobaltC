// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.lock [Guard-Deref]; rule.type.coerce-text; conf.text-through-temporary-guard-argument
// kind: positive
// expect: ok
//
// A `String` reached through a temporary guard is viewed and sliced as an
// argument, as through a bound guard: the guard lives to the end of the
// statement (bug 006: "`String` is not sliced").

import std;

fn main()
{
    mutex<String> m = Mutex::new("hello");
    usize a = StringView::len(&(*lock(&m))[0..2]);
    usize b = StringView::len(&*lock(&m));
    assert(a == 2 && b == 5);
    printf("%v %v\n", a, b);
}
