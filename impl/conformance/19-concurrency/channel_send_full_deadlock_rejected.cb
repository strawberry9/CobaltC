// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.channel [Channel-Deadlock] [Send]; D-0063; conf.channel-deadlock
// kind: negative
// expect: diag.channel-deadlock (dynamic)
//
// The main thread waits to send into a full channel after the only
// other thread has finished: nothing could ever receive from it.

import std;

fn nothing(i32 x) : i32
{
    x
}

fn main()
{
    Channel<i32> ch = Channel::new(1);
    {
        auto h = spawn(nothing, 1);
        join(h);
    }
    _ = Channel::send(&ch, 1);
    _ = Channel::send(&ch, 2);
}
