// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.guarantee [Deadlock]; D-0204; conf.deadlock-all-waiting
// kind: negative
// expect: diag.deadlock (dynamic)
//
// The main thread joins a thread that waits on a channel nobody sends to:
// every thread waits, and none can end its wait. There is no cycle, so the
// end of the chain of waits -- the thread waiting on the channel -- faults
// with `diag.deadlock`, and `join` raises its failure again in the main
// thread: one outcome, however the threads are timed.

import std;

fn waiter(ref<Channel<u8>, shared> c) : u8
{
    match (Channel::recv(c))
    {
        Some(v) : v,
        None    : 0,
    }
}

fn main()
{
    Channel<u8> c = Channel::new(1);
    auto h = spawn(waiter, &c);
    printf("%v\n", join(h));
}
