// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Spawn] with rule.fn.generic-call (a generic function's type arguments fixed by the arguments); conf.spawn-generic-from-constructor (D-0232)
// kind: positive
// expect: ok
//
// A generic function spawned without type arguments takes them from the
// arguments, as a call does, when an argument is a constructor too:
// `Some(5)` fixes `Option::unwrap`'s `T` as `i32`.

import std;

fn main() : u8
{
    auto h = spawn(Option::unwrap, Some(5));
    auto g = spawn(Option::unwrap_or, Some(true), false);
    if (join(h) == 5 && join(g))
    {
        0
    }
    else
    {
        1
    }
}
