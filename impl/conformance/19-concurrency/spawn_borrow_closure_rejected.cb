// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Spawn]
// kind: negative
// expect: diag.spawn-borrow-closure (static)
//
// spawn requires its callee to be a fn value or a move closure -- a
// borrowing closure could let the spawned thread outlive data it only
// holds a reference to. This was previously accepted without
// rejection.

fn main()
{
    i32 x = 5;
    auto h = spawn([x](i32 n)
    {
        n + x
    }, 1);
    join(h);
}
