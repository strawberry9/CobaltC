// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.lock [Guard-Drop]; D-0240; conf.guard-moved-to-thread-and-dropped
// kind: positive
// expect: ok
// expect-stdout-hex: 68656c640a350a
//
// A guard moved to a spawned thread that does not use it: the thread's
// frame ends it, which releases the mutex (`[Guard-Drop]`), and `main`
// locks it again after the join.

import std;

fn hold(guard<i32> g)
{
    printf("held\n");
}

fn main()
{
    mutex<i32> m = Mutex::new(0);
    auto g = lock(&m);
    auto h = spawn(hold, g);
    join(h);
    auto g2 = lock(&m);
    *g2 = 5;
    printf("%v\n", *g2);
}
