// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.conc.spawn [Spawn]; rule.fn.closure (a closure is a struct)
// kind: positive
// expect: ok
//
// A `move` closure bound in a loop body and spawned: the thread runs its
// own closure object, so the loop body's exit does not end it under the
// thread. A closure owning no resource is copied, so the spawner may
// still call its own. coby once shared the spawner's object, which the
// block's exit could end first (a host panic in the thread).

import std;

fn sum_to(u64 n) : u64
{
    u64 s = 0;
    u64 i = 0;
    while (i < n)
    {
        s = s + i;
        i = i + 1;
    }
    s
}

fn main()
{
    Vec<handle<u64>> hs = Vec::new();
    u64 k = 0;
    while (k < 4)
    {
        u64 n = 10 + k;
        auto work = move [n]() { sum_to(n) };
        Vec::push(&mut hs, spawn(work));
        if (work() != sum_to(n))
        {
            fault(index_out_of_bounds);
        }
        k = k + 1;
    }
    u64 total = 0;
    while (Vec::len(&hs) > 0)
    {
        match (Vec::pop(&mut hs))
        {
            Some(h) : { total = total + join(h); },
            None : {},
        }
    }
    printf("%v\n", total);
}
