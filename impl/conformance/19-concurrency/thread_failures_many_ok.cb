// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: rule.fail.fault-contain [Fault-Contain]; std::try_join; D-0204; conf.thread-failures-many
// kind: positive
// expect: ok
// expect-stdout-hex: 6f6b20383539206661696c65642036370a
//
// Two hundred threads, a third of them faulting: every failure contained,
// every result taken.

import std;

fn job(u64 k) : u64
{
    String s = sprintf("job %v", k);
    if (k % 3 == 0)
    {
        Vec<u64> v = Vec::new();
        return v[narrow<usize>(k)];
    }
    narrow<u64>(String::len(&s))
}

fn main()
{
    Vec<handle<u64>> hs = Vec::new();
    foreach (k in 0..200: u64)
    {
        Vec::push(&mut hs, spawn(job, k));
    }
    u64 ok = 0;
    u64 failed = 0;
    while (Vec::len(&hs) > 0)
    {
        match (try_join(Option::unwrap(Vec::pop(&mut hs))))
        {
            Ok(v)  : ok += v,
            Err(e) : failed += 1,
        }
    }
    printf("ok %v failed %v\n", ok, failed);
}
