// CONFORMANCE-CASE
// spec: 19-concurrency
// facility: [Thread-Lend] (an exclusive reference behind a shared one is not lent); spec/14 scoped lending; conf.thread-closure-lent-exclusive-through-shared
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// As `conf.thread-lent-exclusive-through-shared`, with the shared reference
// captured by the thread's closure: `hr` reaches the exclusive reference
// `h1` keeps, which is not lent and stays this thread's.

import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn main()
{
    i32 x = 1;
    Hold h1 = Hold { .r = &mut x };
    ref<Hold, shared> hr = &h1;
    auto t1 = spawn(move [hr]() : i32 { *hr.r });
    printf("%v\n", join(t1));
}
