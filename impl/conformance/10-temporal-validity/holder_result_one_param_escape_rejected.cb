// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision [Call-Elided-Lifetime] (D-0011, D-0088; CHG-0439): a result that holds a reference from the one reference parameter, stored past its argument's block; conf.holder-result-one-param-escape
// kind: negative
// expect: diag.reference-escapes-scope (static)
//
// As a reference result is (`conf.reference-escape-rejected`); the run
// checked it before.

import std;

fn pick(ref<i32, shared> a) : Option<ref<i32, shared>>
{
    Some(a)
}

fn main()
{
    Option<ref<i32, shared>> o = None;
    {
        i32 y = 2;
        o = pick(&y);
    }
    match (o)
    {
        Some(r) : printf("%v\n", *r),
        None    : {},
    }
}
