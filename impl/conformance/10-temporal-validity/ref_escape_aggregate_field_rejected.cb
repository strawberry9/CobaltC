// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape [Ref-Escape-Rejected] (a reference stored into a field of an escaping aggregate)
// kind: negative
// expect: diag.reference-escapes-scope (static)
//
// A reference stored into a field of an aggregate escapes wherever
// the aggregate's own value does: here into `h`, declared outside the
// block that declares the referent.

struct H
{
    ref<i32, shared> r;
}

fn main()
{
    i32 x0 = 0;
    H h = H { .r = &x0 };
    {
        i32 x = 1;
        h = H { .r = &x };
    }
}
