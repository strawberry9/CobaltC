// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape [Ref-Escape-Rejected]
// kind: negative
// expect: diag.reference-escapes-scope (static)
//
// Assigning a reference to a block-local object into a binding
// declared in an enclosing block is a lexically visible escape: the
// destination's decl-block strictly encloses the referent's, so the
// program is rejected before it runs (spec/10 §2 covers stores by
// assignment as well as by declaration).

fn main()
{
    i32 outer = 0;
    ref<i32, shared> escaped = &outer;
    {
        i32 local = 5;
        escaped = &local;
    }
    if (*escaped != 5)
    {
        1 / (1 - 1);
    }
}
