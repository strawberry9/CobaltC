// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision `[Call-Elided-Lifetime]` (D-0318): the result borrows every argument the clause names; conf.result-source-several-borrows-each
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `longer(&x, &y)` gives `x` when run, but its clause says the result
// may be either argument, so `y` stays borrowed while the result is used:
// changing it is rejected, whichever argument the result turns out to be.

import std;

fn longer(ref<String, shared> a, ref<String, shared> b) : ref<String, shared> from a, b
{
    if (StringView::len(a) >= StringView::len(b))
    {
        a
    }
    else
    {
        b
    }
}

fn main()
{
    String x = "abc";
    String y = "de";
    ref<String, shared> l = longer(&x, &y);
    String::append(&mut y, "!");
    printf("%s\n", l);
}
