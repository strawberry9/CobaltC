// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision [Call-Multi-Ref-Return-Rejected]; conf.elision-multi-param-rejected; conf.lifetime-elision-two-params
// kind: negative
// expect: diag.lifetime-elision-ambiguous (static)
//
// A function with two reference-typed parameters returning a reference
// is rejected at its declaration when no `from` clause names the ones the
// result may come from: the language will not guess which argument the
// result depends on. A declaration-level fact, so the program is
// rejected whether or not the result would actually dangle.

fn pick(ref<i32, shared> p1, ref<i32, shared> p2) : ref<i32, shared>
{
    p2
}

fn main()
{
    i32 a = 1;
    ref<i32, shared> result = &a;
    {
        i32 b = 2;
        result = pick(&a, &b);
    }
    if (*result != 2)
    {
        1 / (1 - 1);
    }
}
