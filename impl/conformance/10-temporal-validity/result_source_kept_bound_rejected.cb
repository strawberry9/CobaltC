// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision `[Result-Source-Probe-Only]` (D-0312): a binding of the other parameter, followed as it, keeps it when given as the result; conf.result-source-kept-bound
// kind: negative
// expect: diag.result-source-kept (static)
//
// A binding initialized with `b` is followed as `b` through the rest of
// the block (report 183, CHG-0479): measuring it keeps nothing, but
// giving it as the result keeps `b`.

import std;

fn bad(StringView a, StringView b) : StringView from a
{
    StringView c = b;
    if (StringView::len(c) > StringView::len(a))
    {
        return c;
    }
    &a[0..StringView::len(c)]
}

fn main()
{
    printf("%s\n", bad("xyz", "y"));
}
