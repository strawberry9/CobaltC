// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision `[Result-Source-Probe-Only]` (D-0312): a binding of the other parameter keeps it; conf.result-source-kept-bound
// kind: negative
// expect: diag.result-source-kept (static)
//
// A binding initialized with `b` holds a view of it, and what the body
// does with the binding is not followed: the occurrence is kept, even
// though the binding is then only measured.

import std;

fn bad(StringView a, StringView b) : StringView from a
{
    StringView c = b;
    &a[0..StringView::len(c)]
}

fn main()
{
    printf("%s\n", bad("xyz", "y"));
}
