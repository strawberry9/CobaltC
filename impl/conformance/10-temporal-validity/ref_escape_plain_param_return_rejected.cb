// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape [Ref-Escape-Rejected] (B = caller)
// kind: negative
// expect: diag.reference-escapes-scope (static)
//
// A by-value parameter is a binding of the callee's own body; a
// reference to it returned to the caller escapes. The exemption for
// `B = caller` applies only to a *reference-typed* parameter's referent.

fn f(i32 x) : ref<i32, shared>
{
    &x
}

fn main()
{
    i32 a = 1;
    f(a);
}
