// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision `[Result-Source-Probe-Only]` (D-0312): an argument of a call that can receive it keeps it; conf.result-source-kept-pushed
// kind: negative
// expect: diag.result-source-kept (static)
//
// `Vec::push(&mut out, b)` returns nothing, but its first argument is an
// exclusive reference to a `Vec<StringView>`, which can receive the view:
// the parts would hold a view of `b`.

import std;

fn bad(StringView a, StringView b) : Vec<StringView> from a
{
    Vec<StringView> out = Vec::new();
    Vec::push(&mut out, a);
    Vec::push(&mut out, b);
    out
}

fn main()
{
    printf("%v\n", Vec::len(&bad("x", "y")));
}
