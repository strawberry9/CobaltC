// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape; CHG-0113; conf.closure-move-escape-ok
// kind: positive
// expect: ok
// expect-stdout-hex: 3320340a
//
// A `move` closure owns its captures, so it may leave the function or
// block that made them; a closure capturing a reference parameter may
// be returned too (it borrows what the caller owns only through it).

import std;

fn counter(usize start) : fn() : usize
{
    String tag = String::from_str("abc");
    move [start, tag]() : usize { start + String::len(&tag) - 3 }
}

fn main()
{
    auto f = counter(3);
    fn() : usize g = []() : usize { 0 };
    {
        usize w = 4;
        g = move [w]() : usize { w };
    }
    printf("%d %d\n", f(), g());
}
