// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision [Call-Elided-Lifetime] (D-0312, D-0319, CHG-0439): a result that holds references, from the parameter its clause names, stored past that argument's block; conf.holder-result-from-escape
// kind: negative
// expect: diag.reference-escapes-scope (static)
//
// `from b`: the result holds `y`, which ends first. The clause was not
// read for a result that holds references (the first argument was taken),
// and the compiled program read `y`'s dead slot.

import std;

fn pick(ref<i32, shared> a, ref<i32, shared> b) : Option<ref<i32, shared>> from b
{
    if (*a > 100) { None } else { Some(b) }
}

fn main()
{
    i32 x = 1;
    Option<ref<i32, shared>> o = None;
    {
        i32 y = 2;
        o = pick(&x, &y);
    }
    match (o)
    {
        Some(r) : printf("%v\n", *r),
        None    : {},
    }
}
