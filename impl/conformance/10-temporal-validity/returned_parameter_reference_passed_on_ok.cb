// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision (a returned reference borrows from the one reference parameter); CHG-0358; conf.returned-parameter-reference-passed-on
// kind: positive
// expect: ok
// expect-stdout-hex: 343020380a
//
// `same` returns its reference parameter itself, and `source` passes the
// result straight on (`peek(same(base))`), then uses `base` again. The
// reference `same` returns is `base`'s own path; it ends with the
// statement that used it, and `base`, a parameter, is still valid after
// it, and again through an exclusive parameter, which is then written
// (`twice`).

import std;

struct E
{
    i32 v;
}

fn same(ref<E, shared> e) : ref<E, shared>
{
    e
}

fn peek(ref<E, shared> e) : i32
{
    e.v
}

fn source(ref<E, shared> base) : i32
{
    i32 a = peek(same(base));
    a + peek(base)
}

fn twice(ref<E, exclusive> base) : i32
{
    i32 a = peek(same(base));
    base.v = 4;
    a / 5 + peek(base)
}

fn main() : u8
{
    E e = E { .v = 20 };
    E f = E { .v = 20 };
    printf("%v %v\n", source(&e), twice(&mut f));
    0
}
