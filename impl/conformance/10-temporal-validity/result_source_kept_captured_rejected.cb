// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision `[Result-Source-Probe-Only]` (D-0312): a closure capturing the other parameter keeps it; conf.result-source-kept-captured
// kind: negative
// expect: diag.result-source-kept (static)
//
// A closure capturing `b` holds it, whatever the closure then does.

import std;

fn bad(StringView a, StringView b) : StringView from a
{
    auto f = [b]() : usize { StringView::len(b) };
    &a[0..f()]
}

fn main()
{
    printf("%s\n", bad("xyz", "y"));
}
