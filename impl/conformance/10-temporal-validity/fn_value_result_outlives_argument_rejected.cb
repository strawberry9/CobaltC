// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape, rule.control.flow-analysis (CHG-0439): a reference returned through a `fn` value, kept past its argument's block; conf.fn-value-result-outlives-argument
// kind: negative
// expect: diag.destroy-while-aliased (static)
//
// A call through a `fn` value holds what its reference arguments reach; it
// was taken for static data, and the compiled program read `y`'s dead slot.

import std;

fn first(ref<i32, shared> a) : ref<i32, shared>
{
    a
}

fn main()
{
    i32 z = 0;
    ref<i32, shared> r = &z;
    fn(ref<i32, shared>) : ref<i32, shared> f = first;
    {
        i32 y = 2;
        r = f(&y);
    }
    printf("%v\n", *r);
}
