// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape; CHG-0113; conf.closure-borrow-escapes-block
// kind: negative
// expect: diag.reference-escapes-scope (static)
//
// A closure borrowing `w` is stored into `g`, declared in an enclosing
// block, and would outlive `w`.

import std;

fn main()
{
    fn() : usize g = []() : usize { 0 };
    {
        usize w = 3;
        g = [w]() : usize { w };
    }
    printf("%d\n", g());
}
