// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape (spec/10 §2), D-0284 (CHG-0438): a result whose borrow is not visible is the run's; conf.result-through-if-checked-at-run
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// `r` may be `&z`, a local; no visible borrow shows it, so the run checks
// the result. The compiled program called this decided and kept no
// record: it read the dead local.

import std;

fn f(ref<i32, shared> a) : ref<i32, shared>
{
    i32 z = 3;
    ref<i32, shared> r = if (*a > 0) { &z } else { a };
    r
}

fn main()
{
    i32 x = 1;
    printf("%v\n", *f(&x));
}
