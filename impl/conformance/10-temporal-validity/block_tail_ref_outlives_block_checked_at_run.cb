// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape (spec/10 §2), D-0284 (CHG-0439): a block expression's own binding, written after its initializer and given as the tail, stored past the block; conf.block-tail-ref-outlives-block-checked-at-run
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// `t` is written after its initializer (`t = &y`), so what it holds is not
// known once the block has ended, and the store is the run's: it was taken
// for the initializer's (`&z`), and the compiled program read `y`'s dead
// slot.

import std;

fn main()
{
    i32 z = 0;
    ref<i32, shared> r = &z;
    {
        i32 y = 2;
        r = {
            ref<i32, shared> t = &z;
            t = &y;
            t
        };
    }
    printf("%v\n", *r);
}
