// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision `[Result-Source-Probe-Only]` (D-0312): a type parameter may be a view, so a `T` parameter is probed in the one body; conf.result-source-kept-type-parameter
// kind: negative
// expect: diag.result-source-kept (static)
//
// `keep` is only ever called at `i32`, where `b` holds no reference; but
// `T` may be a view, and the body is checked once for every `T`.

import std;

fn keep<T>(StringView a, T b) : Option<T> from a
{
    if (StringView::len(a) > 0)
    {
        Some(b)
    }
    else
    {
        None
    }
}

fn main()
{
    Option<i32> n = keep("x", 1);
    printf("%v\n", Option::is_some(&n));
}
