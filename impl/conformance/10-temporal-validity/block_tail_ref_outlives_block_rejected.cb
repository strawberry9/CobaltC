// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape (spec/10 §2), D-0284 (CHG-0439): a reference a block expression gives from its own binding, stored past the block; conf.block-tail-ref-outlives-block-rejected
// kind: negative
// expect: diag.destroy-while-aliased (static)
//
// The block's `t` holds what its initializer borrowed, `y`: `r` holds `y`
// past `y`'s block. It was taken for static data, and the compiled program
// read `y`'s dead slot.

import std;

fn main()
{
    i32 z = 0;
    ref<i32, shared> r = &z;
    {
        i32 y = 2;
        r = {
            ref<i32, shared> t = &y;
            t
        };
    }
    printf("%v\n", *r);
}
