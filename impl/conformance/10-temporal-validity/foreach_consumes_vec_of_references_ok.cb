// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.validity; D-0042 `foreach (x in v)` consuming a `Vec`
// kind: positive
// expect: ok
//
// `foreach` over a `Vec` of references, consuming it (and over one a
// function returns), gives each reference, still valid, to the body.
// cobc ended each reference as it was taken: the element was read out of
// the buffer into a local of an `unsafe` block and handed out as the
// block's result, and a path no statement owned was not kept for that
// result, so it ended with the block's local (`diag.stale-binding`).
// Found by real-world testing (an LRU cache's key list).

import std;

fn refs(ref<Vec<String>, shared> names) : Vec<ref<String, shared>>
{
    Vec<ref<String, shared>> out = Vec::new();
    foreach (n in names)
    {
        Vec::push(&mut out, n);
    }
    out
}

fn main()
{
    Vec<String> names = Vec::new();
    Vec::push(&mut names, String::from_str("a"));
    Vec::push(&mut names, String::from_str("bc"));
    Vec<ref<String, shared>> v = refs(&names);
    usize total = 0;
    foreach (s in v)
    {
        total += String::len(s);
    }
    foreach (s in refs(&names))
    {
        total += String::len(s);
    }
    assert(total == 6);
}
