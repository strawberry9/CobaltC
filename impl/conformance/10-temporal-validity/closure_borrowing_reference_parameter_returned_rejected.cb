// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape [Ref-Escape-Rejected] (CHG-0438): a returned closure borrows a reference parameter's binding; conf.closure-borrowing-reference-parameter-returned
// kind: negative
// expect: diag.reference-escapes-scope (static)
//
// A closure without `move` borrows each capture's binding, `p` too, and
// `p` ends with the call: the returned closure would read a dead binding.
// `move [p]` copies the reference instead.

import std;

fn mk(ref<i32, shared> p) : fn() : i32
{
    [p]() : i32 { *p }
}

fn main()
{
    i32 x = 3;
    auto f = mk(&x);
    printf("%v\n", f());
}
