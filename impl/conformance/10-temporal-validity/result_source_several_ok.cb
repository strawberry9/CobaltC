// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision `[Call-Elided-Lifetime]` with a `from` clause naming several parameters (D-0318); conf.result-source-several
// kind: positive
// expect: ok
// expect-stdout-hex: 6162630a646464640a
//
// `longer`'s result is either argument, decided at run time, and its
// clause names both; `longest` names four. Every named parameter may be
// kept, and the call borrows each argument the clause names.

import std;

fn longer(ref<String, shared> a, ref<String, shared> b) : ref<String, shared> from a, b
{
    if (StringView::len(a) >= StringView::len(b))
    {
        a
    }
    else
    {
        b
    }
}

fn longest(StringView a, StringView b, StringView c, StringView d) : StringView from a, b, c, d
{
    StringView best = a;
    if (StringView::len(b) > StringView::len(best))
    {
        best = b;
    }
    if (StringView::len(c) > StringView::len(best))
    {
        best = c;
    }
    if (StringView::len(d) > StringView::len(best))
    {
        best = d;
    }
    best
}

fn main()
{
    String x = "abc";
    String y = "de";
    ref<String, shared> l = longer(&x, &y);
    printf("%s\n", l);
    printf("%s\n", longest("a", "bbb", "cc", "dddd"));
}
