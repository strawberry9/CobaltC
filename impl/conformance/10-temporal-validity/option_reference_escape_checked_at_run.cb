// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape (spec/10 §2), D-0284 (CHG-0438): an `Option` of a view stored past its text's block; conf.option-reference-escape-checked-at-run
// kind: negative
// expect: diag.destroy-while-aliased (dynamic)
//
// `u` outlives `s`, and holds a view of it through `t`; the compiled
// program printed freed memory.

import std;

fn main()
{
    Option<StringView> u = None;
    {
        String s = "abc";
        Option<StringView> t = Some(&s);
        u = t;
    }
    match (u)
    {
        Some(r) : printf("%s\n", r),
        None    : {},
    }
}
