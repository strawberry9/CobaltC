// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape (spec/10 §2), D-0284 (CHG-0438): an `Option` of a view stored past its text's block; conf.option-reference-escape-checked-at-run
// kind: negative
// expect: diag.destroy-while-aliased (static)
//
// `u` outlives `s`, and holds a view of it through `t`; the compiled
// program printed freed memory. Since D-0332 the assignment `u = t`
// records what `t` borrows, so the end of `s`'s block is refused before
// the run (the case's name is from when only the run could see it).

import std;

fn main()
{
    Option<StringView> u = None;
    {
        String s = "abc";
        Option<StringView> t = Some(&s);
        u = t;
    }
    match (u)
    {
        Some(r) : printf("%s\n", r),
        None    : {},
    }
}
