// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision [Result-Source-Probe-Only] (CHG-0439): a parameter the clause leaves out, given values by the one call parameter that may receive references; conf.result-source-probe-receiving-param
// kind: positive
// expect: ok
// stdout: 2 2 3
//
// `Vec::push(starts, i)` gives `starts` an index: the parameter that may
// receive references does not keep the argument it is given. And
// `StringView::parse<usize>` holds no reference: its type argument is
// written.

import std;

fn words(StringView text, ref<Vec<usize>, exclusive> starts, StringView count) : Vec<StringView> from text
{
    Vec<StringView> out = Vec::new();
    usize n = Result::unwrap_or(StringView::parse<usize>(count), 0);
    Vec<StringView> all = StringView::split(text, " ");
    for (usize i = 0; i < Vec::len(&all) && i < n; i += 1)
    {
        Vec::push(&mut out, all[i]);
        Vec::push(starts, i);
    }
    out
}

fn main()
{
    String t = "ab cd ef";
    Vec<usize> at = Vec::new();
    Vec<StringView> w = words(&t, &mut at, "2");
    printf("%v %v %v\n", Vec::len(&w), Vec::len(&at), StringView::len(w[1]) + 1);
}
