// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape `[Ref-Escape-Rejected]` through `[Call-Elided-Lifetime]` with several sources (D-0318): the result lives no longer than the innermost; conf.result-source-several-escape
// kind: negative
// expect: diag.reference-escapes-scope (static)
//
// The result may be a reference to `y`, which ends with the inner block,
// so storing it in `l`, declared outside that block, is rejected, though
// the run would give `x`.

import std;

fn longer(ref<String, shared> a, ref<String, shared> b) : ref<String, shared> from a, b
{
    if (StringView::len(a) >= StringView::len(b))
    {
        a
    }
    else
    {
        b
    }
}

fn main()
{
    String x = "abc";
    ref<String, shared> l = &x;
    {
        String y = "de";
        l = longer(&x, &y);
    }
    printf("%s\n", l);
}
