// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision `[Result-Source-Probe-Only]` (D-0312): the parameter the clause does not name is the result; conf.result-source-kept-returned
// kind: negative
// expect: diag.result-source-kept (static)
//
// `from a` says the result is a view of `a`; giving `b` is rejected at the
// declaration, whatever a caller passes.

import std;

fn bad(StringView a, StringView b) : StringView from a
{
    b
}

fn main()
{
    printf("%s\n", bad("x", "y"));
}
