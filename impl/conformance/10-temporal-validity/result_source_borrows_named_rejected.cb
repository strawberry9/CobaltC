// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision `[Call-Elided-Lifetime]` with a `from` clause (D-0312): the result borrows the named argument; conf.result-source-borrows-named
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// The result of a call of `after` borrows the argument its `from` clause
// names, as the result of a one-reference-parameter call borrows that
// argument: changing `line` while the view is used is rejected.

import std;

fn after(StringView line, StringView key) : StringView from line
{
    match (StringView::find(line, key))
    {
        Some(i) : &line[i + StringView::len(key)..$],
        None    : &line[0..0],
    }
}

fn main()
{
    String line = "name=ada";
    StringView v = after(&line, "name=");
    String::append(&mut line, "!");
    printf("%s\n", v);
}
