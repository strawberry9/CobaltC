// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape (spec/10 §2), D-0287, D-0284 (CHG-0438): a part of a `foreach` over a splitter's call stored past its text's block; conf.foreach-part-stored-past-text-checked-at-run
// kind: negative
// expect: diag.destroy-while-aliased (dynamic)
//
// `kept`, outside the block, holds a part of `s` when `s` ends; the
// compiled program printed freed memory.

import std;

fn main()
{
    StringView kept = "";
    {
        String s = "ab cd";
        foreach (w in StringView::split_whitespace(&s))
        {
            kept = w;
        }
    }
    printf("[%s]\n", kept);
}
