// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision [Call-Elided-Lifetime]; D-0011
// kind: positive
// expect: ok
//
// A function with exactly one reference-typed parameter returning a
// reference needs no explicit lifetime annotation: the returned
// reference's origin is elided to that one parameter.

struct Pair
{
    i32 a;
    i32 b;
}

fn first(ref<Pair, shared> p) : ref<i32, shared>
{
    &p.a
}

fn main()
{
    Pair pr = Pair { .a = 1, .b = 2 };
    auto y = first(&pr);
    if (*y != 1)
    {
        1 / (1 - 1);
    }
}
