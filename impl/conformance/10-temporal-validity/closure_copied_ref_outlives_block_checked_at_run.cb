// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape (spec/10 §2), [Closure-Form-Move] (CHG-0439): a `move` closure holding a reference into an inner block, stored past it; conf.closure-copied-ref-outlives-block-checked-at-run
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// The closure holds what its captured reference reaches; a store of a
// closure was not checked, and the compiled program read `x`'s dead slot.

import std;

fn main()
{
    i32 z = 0;
    fn() : i32 g = move [z]() : i32 { z };
    {
        i32 x = 4;
        ref<i32, shared> p = &x;
        g = move [p]() : i32 { *p };
    }
    printf("%v\n", g());
}
