// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision `[Call-Elided-Lifetime]` with a `from` clause (D-0312); conf.result-source-ok
// kind: positive
// expect: ok
// expect-stdout-hex: 61646120390a
//
// `after` takes two views and returns a view of the first, as its `from`
// clause says; the key is only probed (searched for, measured). So the
// caller's key is free as soon as the call returns: it is changed while
// the result is still used, and the result is a view of `line` alone.

import std;

fn after(StringView line, StringView key) : StringView from line
{
    match (StringView::find(line, key))
    {
        Some(i) : &line[i + StringView::len(key)..$],
        None    : &line[0..0],
    }
}

fn main()
{
    String line = "name=ada";
    String key = "name=";
    StringView v = after(&line, &key);
    String::append(&mut key, "!");
    printf("%s %v\n", v, StringView::len(&line) + 1);
}
