// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision `[Call-Multi-Ref-Return-Rejected]` does not apply with a `from` clause (D-0312); conf.result-source-two-references
// kind: positive
// expect: ok
// expect-stdout-hex: 3220310a
//
// Two reference parameters and a reference result: with `from p` the
// declaration is well formed, and `q` is only read for an `i32`.

import std;

struct Pair
{
    i32 a;
    i32 b;
}

fn pick(ref<Pair, shared> p, ref<Pair, shared> q) : ref<i32, shared> from p
{
    if (q.a > 0)
    {
        &p.b
    }
    else
    {
        &p.a
    }
}

fn main()
{
    Pair x = Pair { .a = 1, .b = 2 };
    Pair y = Pair { .a = 5, .b = 6 };
    ref<i32, shared> r = pick(&x, &y);
    y.a = 0;
    ref<i32, shared> s = pick(&x, &y);
    printf("%v %v\n", *r, *s);
}
