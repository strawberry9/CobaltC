// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape (spec/10 §2), D-0290, D-0284 (CHG-0439): a call's `Vec<ref<…>>` result, which may hold its argument's referent, stored past that referent's block; conf.vec-of-refs-result-outlives-argument-checked-at-run
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// `mk(&y)` may hold `y` (a `Vec` from a call may also hold none of its
// sources, D-0290), so the store into `r`, which outlives `y`, is the run's.
// It was not checked, and the compiled program read `y`'s dead slot.

import std;

fn mk(ref<i32, shared> y) : Vec<ref<i32, shared>>
{
    Vec<ref<i32, shared>> v = Vec::new();
    Vec::push(&mut v, y);
    v
}

fn main()
{
    Vec<ref<i32, shared>> r = Vec::new();
    drop(r);
    {
        i32 y = 2;
        r = mk(&y);
    }
    printf("%v\n", *r[0]);
}
