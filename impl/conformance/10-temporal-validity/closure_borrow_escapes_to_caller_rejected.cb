// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape; CHG-0113; conf.closure-borrow-escapes-to-caller
// kind: negative
// expect: diag.reference-escapes-scope (static)
//
// A closure without `move` borrows its captures ([Closure-Form-Borrow],
// spec/15): returning it returns a borrow of the local `edge`.

import std;

fn framer(usize width) : fn(ref<String, shared>) : String
{
    String edge = String::new();
    String::append(&mut edge, "+");
    [edge](ref<String, shared> t) : String
    {
        String s = String::clone(&edge);
        String::append(&mut s, t);
        s
    }
}

fn main()
{
    auto f = framer(10);
    String x = String::from_str("x");
    String framed = f(&x);
    printf("%s\n", &framed);
}
