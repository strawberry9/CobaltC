// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision `[Result-Source-Probe-Only]` (D-0316): `HashMap::get`'s result comes `from m`, so a key passed to it is probed; conf.result-source-lookup-through-map
// kind: positive
// expect: ok
// expect-stdout-hex: 372030206e6f6e650a
//
// A lookup over a stack of scopes returns the value where it lies, `from`
// the table; the name is only handed to `HashMap::get`, whose result comes
// from the map alone, so the caller may change its name while the result
// is still used.

import std;

struct Scopes
{
    Vec<HashMap<String, i32>> maps;
}

fn find(ref<Scopes, shared> s, StringView name) : Option<ref<i32, shared>> from s
{
    usize k = Vec::len(&s.maps);
    while (k > 0)
    {
        k -= 1;
        match (HashMap::get(&s.maps[k], name))
        {
            Some(r) : return Some(r),
            None    : {},
        }
    }
    None
}

fn show(Option<ref<i32, shared>> r)
{
    match (r)
    {
        Some(v) : printf("%v", *v),
        None    : printf("none"),
    }
}

fn main()
{
    Scopes s = Scopes { .maps = Vec::new() };
    Vec::push(&mut s.maps, HashMap::new());
    Vec::push(&mut s.maps, HashMap::new());
    HashMap::insert(&mut s.maps[0], "a", 3);
    HashMap::insert(&mut s.maps[0], "b", 0);
    HashMap::insert(&mut s.maps[1], "a", 7);
    String name = "a";
    Option<ref<i32, shared>> inner = find(&s, &name);
    String::push_ascii(&mut name, b'x');
    show(inner);
    printf(" ");
    show(find(&s, "b"));
    printf(" ");
    show(find(&s, &name));
    printf("\n");
}
