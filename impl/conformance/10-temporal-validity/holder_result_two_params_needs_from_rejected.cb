// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision [Call-Multi-Ref-Return-Rejected] (D-0319, CHG-0439): a result that holds references from two reference parameters, with no `from` clause; conf.holder-result-two-params-needs-from
// kind: negative
// expect: diag.lifetime-elision-ambiguous (static)
//
// The call was taken to hold what its first reference argument reaches:
// `pick(&x, &y)` stored past `y`'s block was found nothing left to the
// run, and the compiled program read `y`'s dead slot.

import std;

fn pick(ref<i32, shared> a, ref<i32, shared> b) : Option<ref<i32, shared>>
{
    if (*a > *b) { Some(a) } else { Some(b) }
}

fn main()
{
    i32 x = 1;
    Option<ref<i32, shared>> o = None;
    {
        i32 y = 2;
        o = pick(&x, &y);
    }
    match (o)
    {
        Some(r) : printf("%v\n", *r),
        None    : {},
    }
}
