// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision [Call-Elided-Lifetime]; rule.temporal.ref-escape (referent-block through a visible borrow)
// kind: positive
// expect: ok
//
// A reference obtained from a single-reference-parameter call, stored
// in the same block as its referent, then reborrowed in an inner block
// and passed through an identity elision: none of these escape.

fn id(ref<i32, shared> p) : ref<i32, shared>
{
    p
}

fn main()
{
    i32 x = 1;
    auto y = id(&x);
    {
        i32 z = 2;
        auto y2 = &*y;
        if (*y2 + z != 3)
        {
            1 / (1 - 1);
        }
    }
    if (*y != 1)
    {
        1 / (1 - 1);
    }
}
