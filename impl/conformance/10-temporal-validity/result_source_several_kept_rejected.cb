// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision `[Result-Source-Probe-Only]` (D-0318): a parameter a several-name clause leaves out is only probed; conf.result-source-several-kept
// kind: negative
// expect: diag.result-source-kept (static)
//
// `from a, b` says the result is a view of `a` or of `b`; giving `c` is
// rejected at the declaration.

import std;

fn pick(StringView a, StringView b, StringView c) : StringView from a, b
{
    if (StringView::len(a) > 0)
    {
        a
    }
    else
    {
        c
    }
}

fn main()
{
    printf("%s\n", pick("x", "y", "z"));
}
