// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision `[Result-Source-Form]` (D-0312): the result holds no reference; conf.result-source-invalid-plain-result
// kind: negative
// expect: diag.result-source-invalid (static)
//
import std;

fn bad(StringView a, StringView b) : usize from a
{
    StringView::len(a) + StringView::len(b)
}

fn main()
{
    printf("%v\n", bad("x", "y"));
}
