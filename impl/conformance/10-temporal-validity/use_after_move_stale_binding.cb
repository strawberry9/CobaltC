// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: diag.stale-binding [Binding-Lookup-Stale]
// kind: negative
// expect: diag.stale-binding (static)
//
// A binding whose resource has been moved out is no longer a valid
// access path; using it again is a use of stale storage.

resource struct R
{
    i32 v;
}

fn takes(R x)
{
}

fn main()
{
    R r = R { .v = 1 };
    takes(r);
    takes(r);
}
