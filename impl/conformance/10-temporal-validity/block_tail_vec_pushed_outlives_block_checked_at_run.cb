// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape (spec/10 §2), D-0290, D-0284 (CHG-0439): a `Vec` of references a block expression fills and gives, stored past the referent's block; conf.block-tail-vec-pushed-outlives-block-checked-at-run
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// `v` is made empty and given `&y` by `Vec::push(&mut v, …)`: what the block
// gives is not known once it has ended, and a store of a `Vec<ref<…>>` was
// not checked. The compiled program read `y`'s dead slot.

import std;

fn main()
{
    Vec<ref<i32, shared>> r = Vec::new();
    drop(r);
    {
        i32 y = 2;
        r = {
            Vec<ref<i32, shared>> v = Vec::new();
            Vec::push(&mut v, &y);
            v
        };
    }
    printf("%v\n", *r[0]);
}
