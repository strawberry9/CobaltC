// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.ref-escape (spec/10 §2), D-0290, D-0284 (CHG-0439): an `if` whose `then` block fills its own `Vec` of references and gives it, stored past the referent's block; conf.if-branch-vec-outlives-block-checked-at-run
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// The `then` block is read as a block expression: its `v` is written after
// its initializer, so what the `if` gives is the run's. Its tail was looked
// up outside the block and taken for static data, and the compiled program
// read `y`'s dead slot.

import std;

fn main()
{
    Vec<ref<i32, shared>> r = Vec::new();
    drop(r);
    {
        i32 y = 2;
        r = if (y > 1)
        {
            Vec<ref<i32, shared>> v = Vec::new();
            Vec::push(&mut v, &y);
            v
        }
        else
        {
            Vec::new()
        };
    }
    printf("%v\n", *r[0]);
}
