// CONFORMANCE-CASE
// spec: 10-temporal-validity
// facility: rule.temporal.elision `[Result-Source-Probe-Only]` (D-0316): a key passed as a lookup's `probe<K>` is probed, a probe receiving no reference; conf.result-source-key-probed-by-lookup
// kind: positive
// expect: ok
// expect-stdout-hex: 6265746120320a
//
// `most` asks a set whether `word` is a stop word and counts it in a map:
// both lookups take the key as a `probe<K>`, which can store nothing, so
// `word` is only probed and the result comes from `words` alone.

import std;

fn most(ref<Vec<StringView>, shared> words, ref<HashSet<String>, shared> stop, StringView word) : StringView from words
{
    HashMap<String, usize> n = HashMap::new();
    foreach (x in words)
    {
        if (!HashSet::contains(stop, *x))
        {
            *HashMap::entry(&mut n, *x, 0) += 1;
        }
    }
    StringView best = words[0];
    usize top = 0;
    foreach (x in words)
    {
        usize c = match (HashMap::get(&n, *x))
        {
            Some(v) : *v,
            None    : 0,
        };
        if (c > top || (c == top && *x == word && !HashSet::contains(stop, word)))
        {
            best = *x;
            top = c;
        }
    }
    best
}

fn main()
{
    String text = "the alpha beta the beta gamma the";
    Vec<StringView> words = StringView::split(&text, " ");
    HashSet<String> stop = HashSet::new();
    HashSet::insert(&mut stop, "the");
    String pick = "beta";
    StringView m = most(&words, &stop, &pick);
    String::push_ascii(&mut pick, b'!');
    printf("%v %v\n", m, Vec::len(&StringView::split(&text, m)) - 1);
}
