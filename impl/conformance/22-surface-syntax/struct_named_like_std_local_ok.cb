// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: §2 disambiguation (4), the program's types (CHG-0444); conf.struct-named-like-std-local
// kind: positive
// expect: ok
// expect-stdout-hex: 6e20310a
//
// A type the program declares is a type in the program's own text only: a
// struct named `n` does not change how `std`'s text, which names a local
// `n`, is read (coby and cobc rejected this program with a syntax error in
// std/text.cb).

import std;

struct n
{
    i32 a;
}

fn main()
{
    n x = n { .a = 1 };
    printf("n %v\n", x.a);
}
