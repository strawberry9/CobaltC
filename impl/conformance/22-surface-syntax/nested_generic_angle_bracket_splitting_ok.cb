// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: spec/22 section 2 (nested-generic >> splitting)
// kind: positive
// expect: ok
//
// `Vec<Vec<i32>>`'s trailing `>>` must be split into two closing
// angle brackets, not lexed as a single shift-right token.

import std;

fn main()
{
    Vec<Vec<i32>> outer = Vec::new();
    Vec<i32> inner = Vec::new();
    Vec::push(&mut inner, 1);
    Vec::push(&mut outer, inner);
    if (Vec::len(&outer) != 1)
    {
        1 / (1 - 1);
    }
}
