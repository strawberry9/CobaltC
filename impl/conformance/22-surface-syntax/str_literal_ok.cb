// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: rule.stdlib.str [Str-Literal], [Str-Len], [Str-Byte]; [T-Lit-Str]; inv.str.utf8-validity; conf.str-literal-type; conf.str-byte
// kind: positive
// expect: ok
//
// A str-literal has type `str` and denotes exactly its decoded bytes:
// every escape in the str-escape set, raw non-ASCII source text, and
// `\u{...}` each contribute the UTF-8 bytes the grammar says they do.

fn main()
{
    str s = "hi";
    if (str_len(s) != 2) { 1 / (1 - 1); }
    if (str_byte(s, 0) != 104) { 1 / (1 - 1); }
    if (str_byte(s, 1) != 105) { 1 / (1 - 1); }

    str esc = "\n\r\t\0\\\"";
    if (str_len(esc) != 6) { 1 / (1 - 1); }
    if (str_byte(esc, 0) != 10) { 1 / (1 - 1); }
    if (str_byte(esc, 1) != 13) { 1 / (1 - 1); }
    if (str_byte(esc, 2) != 9) { 1 / (1 - 1); }
    if (str_byte(esc, 3) != 0) { 1 / (1 - 1); }
    if (str_byte(esc, 4) != 92) { 1 / (1 - 1); }
    if (str_byte(esc, 5) != 34) { 1 / (1 - 1); }

    str raw = "é";
    if (str_len(raw) != 2) { 1 / (1 - 1); }
    if (str_byte(raw, 0) != 195) { 1 / (1 - 1); }
    if (str_byte(raw, 1) != 169) { 1 / (1 - 1); }

    str uni = "\u{e9}\u{20AC}";
    if (str_len(uni) != 5) { 1 / (1 - 1); }
    if (str_byte(uni, 2) != 226) { 1 / (1 - 1); }

    str empty = "";
    if (str_len(empty) != 0) { 1 / (1 - 1); }
}
