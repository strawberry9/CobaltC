// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: the diagnostic registry's reporting order with several errors in one body (D-0323); conf.several-errors-in-a-body-first
// kind: negative
// expect: diag.unbound-name (static)
//
// Three statements of one body each with an error that stands on its own:
// all three are reported, the earliest first (D-0323); the statement that
// uses `z`, which a failed `auto` declaration would have declared, is not
// checked.

import std;

fn main()
{
    usize x = nope;
    auto z = 3 + true;
    printf("%v\n", z);
    u8 y = also_nope;
    printf("%v %v\n", x, y);
}
