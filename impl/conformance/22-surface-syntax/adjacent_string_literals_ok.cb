// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: spec/22 §1 (adjacent str-literals, D-0078); rule.stdlib.format; conf.adjacent-string-literals; conf.adjacent-string-literals-inline
// kind: positive
// expect: ok
//
// Adjacent string literals are one literal, joined before parsing,
// with comments and line breaks between them allowed. A joined literal
// is still a literal wherever one is required: a `printf` format, a
// constant's initializer.

import std;

const str USAGE = "usage: tool [-v] FILE\n"
                  "  -v  say what is done\n";

fn main()
{
    str joined = "ab"   // a comment between the pieces
                 "cd"
                 "";
    printf("%v items, "
           "%v bytes\n", 3, 1024);
    assert(str_len(joined) == 4 && str_byte(joined, 2) == b'c', "joined %v", joined);
    assert(str_len(USAGE) == 45, "usage is %v bytes", str_len(USAGE));
    printf("%v", USAGE);
}
