// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: spec/22 slice form; rule.control.foreach-range; conf.slice-inclusive-range
// kind: negative
// expect: diag.syntax-error (static)
//
// `..=` is a `foreach`'s range only: a slice's range leaves out its end,
// and the message says to write `hi + 1`.

import std;

fn main()
{
    Vec<u8> v = Vec::from_slice(&[1, 2, 3]);
    slice<u8, shared> s = &v[0 ..= 1];
}
