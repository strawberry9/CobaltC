// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: spec/22 match-expr (`arm (',' arm)* ','?`, at least one arm); conf.match-without-arms
// kind: negative
// expect: diag.syntax-error (static)
//
// A `match` has at least one arm (spec/22's grammar), even on a value of an
// enum with no variants: `match (n) { }` does not parse (bug 011).

enum Never
{
}

fn absurd(Never n) : i32
{
    match (n) { }
}

fn main()
{
}
