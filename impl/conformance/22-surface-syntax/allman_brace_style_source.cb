// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: spec/22 section 1 (Allman brace style)
// kind: positive
// expect: ok
//
// This file is itself an example of the required Allman-brace,
// 4-space-indent source style spec/22 section 1 mandates for
// standalone CobaltC code -- every opening brace on its own line.

fn classify(i32 n) : i32
{
    if (n < 0)
    {
        -1
    }
    else if (n == 0)
    {
        0
    }
    else
    {
        1
    }
}

fn main()
{
    if (classify(-5) != -1)
    {
        1 / (1 - 1);
    }
    if (classify(0) != 0)
    {
        1 / (1 - 1);
    }
    if (classify(5) != 1)
    {
        1 / (1 - 1);
    }
}
