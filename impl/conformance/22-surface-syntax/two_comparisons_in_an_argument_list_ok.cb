// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: spec/22 §2 disambiguation (1) (type arguments unless the token after `>` begins an operand); conf.two-comparisons-in-an-argument-list
// kind: positive
// expect: ok
//
// `f(a < b, c > d)` holds two comparisons: after `c >` comes `d`, a name,
// which no generic-argument list is followed by, so `a < b, c >` is not
// read as `a<b, c>`. `id<i32>(x)` and `Vec<i32>::new()` stay type
// arguments.

import std;

fn both(bool x, bool y) : bool
{
    x && y
}

fn id<T>(T x) : T
{
    x
}

fn main()
{
    i32 a = 1;
    i32 b = 2;
    i32 c = 3;
    i32 d = 0;
    assert(both(a < b, c > d));
    assert(both(a < b, c > -d));
    assert(both(a < 2, 3 > d));
    Vec<i32> v = Vec<i32>::new();
    assert(Vec::len(&v) == 0);
    assert(id<i32>(c) == 3);
}
