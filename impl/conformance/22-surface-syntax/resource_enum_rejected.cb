// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: spec/22 enum-decl (no `resource`); conf.resource-enum-rejected
// kind: negative
// expect: diag.syntax-error (static)
//
// An enum is not declared `resource`: one whose payload holds a resource
// is one already, and an enum has no destructor. The message names the
// `resource struct` that wraps it.

import std;

resource enum Slot
{
    Empty,
    Busy(u32),
}

fn main()
{
}
