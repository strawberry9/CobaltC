// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: spec/22 match-expr; [Match-Exhaustive]; conf.match-empty-enum-wildcard
// kind: positive
// expect: ok
// expect-stdout-hex: 6f6b0a
//
// A function of a value of an enum with no variants, which no program can
// make, takes it apart with the one arm `_ : …`.

import std;

enum Never
{
}

fn absurd(Never n) : i32
{
    match (n)
    {
        _ : 0,
    }
}

fn main()
{
    printf("ok\n");
}
