// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: the diagnostic registry's reporting order with errors in a statement's blocks (D-0323 amended, CHG-0455); conf.several-errors-in-nested-blocks
// kind: negative
// expect: diag.unbound-name (static)
//
// Each branch of an `if` and a loop's body have an error of their own: each
// is reported, the earliest first; a failed statement ends its block, so the
// statement after it in the loop's body is not checked.

import std;

fn main()
{
    usize n = arg_count();
    if (arg_count() > 0)
    {
        n = first_nope;
    }
    else
    {
        n = second_nope;
    }
    foreach (i in 0..3: usize)
    {
        u8 x = third_nope;
        n += widen<usize>(x);
    }
    printf("%v\n", n);
}
