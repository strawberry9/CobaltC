// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: rule.init.let [Let-Destructure]
// kind: positive
// expect: ok
//
// A one-field struct can be destructured directly in a `let`-shaped
// declaration, binding the field's own value.

struct Wrapper
{
    i32 value;
}

fn main()
{
    Wrapper w = Wrapper { .value = 9 };
    Wrapper { value } = w;
    if (value != 9)
    {
        1 / (1 - 1);
    }
}
