// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: spec/22 length; D-0074, D-0126; conf.array-length-not-constant
// kind: negative
// expect: diag.syntax-error (static)
//
// A length is a constant expression (D-0126): `N + 1` would be one, but
// `k` is a local variable, whose value is not known before the program
// runs.

import std;

const usize N = 4;

fn main()
{
    usize k = N + 1;
    array<i32, k> a = [0; 5];
    printf("%v\n", a[0]);
}
