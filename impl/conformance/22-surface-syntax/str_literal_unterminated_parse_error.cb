// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: spec/22 §1 str-literal (lexical ill-formedness)
// kind: negative
// expect: parse-error
//
// A str-literal must close on the line it opens: a newline inside the
// quotes is a lexical failure, caught before any semantic analysis.

fn main()
{
    str s = "hello
    ";
}
