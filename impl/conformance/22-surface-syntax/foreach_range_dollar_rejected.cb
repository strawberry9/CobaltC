// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: rule.control.foreach-range; D-0097; conf.foreach-range-dollar-rejected
// kind: negative
// expect: diag.syntax-error (static)
//
// `$` is written only inside `[…]`: a range has no length to name.

import std;

fn main()
{
    foreach (v in 0..$)
    {
        printf("%v\n", v);
    }
}
