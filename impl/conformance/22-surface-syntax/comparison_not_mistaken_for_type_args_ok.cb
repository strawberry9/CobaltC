// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: spec/22 §2 disambiguation (1) (`identifier '<' type … '>'` is a generic-argument list; anything else is a comparison)
// kind: positive
// expect: ok
//
// `a < b || b > a` contains `<` … `>` but `b || b` is not a type list,
// so the `<` is a comparison. Decided by speculatively parsing a type
// list after `<` and backtracking, not by scanning ahead for a `>`.

fn main()
{
    i32 a = 1;
    i32 b = 2;
    u8 byte = 50;
    bool lo_or_hi = byte < 48 || byte > 57;
    if (lo_or_hi)
    {
        1 / (1 - 1);
    }
    if (a < b && b > a)
    {
        if ((a < b) || (b > a))
        {
            return;
        }
    }
    1 / (1 - 1);
}
