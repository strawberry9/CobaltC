// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: spec/22 §1 byte-char-literal, float-literal exponent; rule.arith.literal; D-0033
// kind: positive
// expect: ok
//
// Every escape a `byte-char-literal` admits, and float literals with
// exponents in each form the grammar allows, including `print`'s own
// output forms, which read back as the same value.

fn main()
{
    if (b'a' != 97 || b'\n' != 10 || b'\r' != 13 || b'\t' != 9 || b'\0' != 0)
    {
        1 / (1 - 1);
    }
    if (b'\\' != 92 || b'\'' != 39 || b'"' != 34 || b'\x7f' != 127 || b'\xFF' != 255)
    {
        1 / (1 - 1);
    }
    if (1e5 != 100000.0 || 2.5E3 != 2500.0 || 1.0e-7 != 0.0000001 || 7E+2 != 700.0)
    {
        1 / (1 - 1);
    }
    if (1.0e21 != 1000000000000000000000.0 || 3.4028235e38: f32 != 340282350000000000000000000000000000000.0: f32)
    {
        1 / (1 - 1);
    }
}
