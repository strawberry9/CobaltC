// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: rule.agg.array-construct [Array-Construct]; [T-Lit-Str]; conf.byte-literal-array; conf.byte-literal-desugars-to-array
// kind: positive
// expect: ok
//
// A byte-literal is `array<u8, N>` with N its byte count -- pure sugar
// for [Array-Construct] on suffixed u8 literals, so it can be declared
// with that annotation, indexed, and written through `write` exactly as
// a hand-spelled array can; `\xNN` yields any byte value.

fn main()
{
    array<u8, 3> b = b"hi\n";
    if (b[0] != 104) { std::assert(false); }
    if (b[1] != 105) { std::assert(false); }
    if (b[2] != 10) { std::assert(false); }

    auto raw = b"\x00\xff!";
    if (raw[0] != 0) { std::assert(false); }
    if (raw[1] != 255) { std::assert(false); }
    if (raw[2] != 33) { std::assert(false); }

    if (b"a"[0] != 97) { std::assert(false); }
    if (sizeof<array<u8, 4>>() != 4) { std::assert(false); }
}
