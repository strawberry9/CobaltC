// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: rule.agg.array-construct [Array-Construct]; [T-Lit-Str]; conf.byte-literal-array
// kind: positive
// expect: ok
//
// A byte-literal is `array<u8, N>` with N its byte count -- pure sugar
// for [Array-Construct] on suffixed u8 literals, so it can be declared
// with that annotation, indexed, and written through `write` exactly as
// a hand-spelled array can; `\xNN` yields any byte value.

fn main()
{
    array<u8, 3> b = b"hi\n";
    if (b[0] != 104) { 1 / (1 - 1); }
    if (b[1] != 105) { 1 / (1 - 1); }
    if (b[2] != 10) { 1 / (1 - 1); }

    auto raw = b"\x00\xff!";
    if (raw[0] != 0) { 1 / (1 - 1); }
    if (raw[1] != 255) { 1 / (1 - 1); }
    if (raw[2] != 33) { 1 / (1 - 1); }

    if (b"a"[0] != 97) { 1 / (1 - 1); }
    if (sizeof<array<u8, 4>>() != 4) { 1 / (1 - 1); }
}
