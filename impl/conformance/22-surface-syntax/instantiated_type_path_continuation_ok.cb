// CONFORMANCE-CASE
// spec: 22-surface-syntax
// facility: spec/22 §2 disambiguation (1) (`Vec<i32>::new()`: a further path segment after a generic-argument list)
// kind: positive
// expect: ok
//
// A generic-argument list may be followed by another path segment;
// the arguments instantiate the type the associated function belongs
// to.

import std;

fn main()
{
    auto v = Vec<i32>::new();
    Vec::push(&mut v, 1);
    if (Vec::len(&v) != 1)
    {
        1 / (1 - 1);
    }
}
