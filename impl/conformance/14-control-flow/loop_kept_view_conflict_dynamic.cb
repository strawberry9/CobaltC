// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (facts of a loop's body reach its head, D-0287); conf.loop-kept-view-conflict-dynamic
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// `keep` is given a view of `text` at the end of one iteration and read
// at the start of the next, so it is live across the `append` that
// changes `text`. On the first iteration it still holds static data, so
// the fact is `?` at the `append` and the run decides: the second
// iteration faults.

import std;

fn main() : u8
{
    String text = String::from_str("ab");
    StringView keep = "";
    usize i = 0;
    while (i < 3)
    {
        printf("%d\n", StringView::len(keep));
        String::append(&mut text, "x");
        keep = &text[0..$];
        i += 1;
    }
    0
}
