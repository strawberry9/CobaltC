// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis; [Stmt-Exit]; rule.stdlib.text `sprintf`, `String::len`
// kind: positive
// expect: ok
//
// String locals that are only read, left by `return`, `continue`,
// `break` and the end of their block, in nested loops and blocks, a name
// shadowed in an inner block, and a local never read: each ends exactly
// once, on whichever path leaves it, many times over.

import std;

fn find(usize n, usize stop) : usize
{
    usize t = 0;
    foreach (i in 0..n)
    {
        String s = sprintf("item-%v", i);
        if (i == stop)
        {
            return t + String::len(&s);
        }
        if (i % 3 == 0)
        {
            continue;
        }
        t += String::len(&s);
        if (t > 100000)
        {
            break;
        }
    }
    t
}

fn nested(usize n) : usize
{
    usize t = 0;
    foreach (i in 0..n)
    {
        String a = sprintf("%v", i);
        {
            String b = sprintf("<%v>", i);
            foreach (j in 0..3)
            {
                String c = sprintf("%v.%v", i, j);
                if (j == 1)
                {
                    break;
                }
                t += String::len(&c);
            }
            t += String::len(&b);
        }
        t += String::len(&a);
    }
    t
}

fn shadow(usize n) : usize
{
    usize t = 0;
    String s = sprintf("outer");
    {
        String s = sprintf("inner-%v", n);
        t += String::len(&s);
    }
    t + String::len(&s)
}

fn unused(usize n) : usize
{
    String s = sprintf("never read %v", n);
    n
}

fn main()
{
    printf("%v\n", find(50, 1000));
    printf("%v\n", find(50, 7));
    printf("%v\n", nested(20));
    printf("%v\n", shadow(3));
    printf("%v\n", unused(4));
    usize t = 0;
    foreach (k in 0..2000)
    {
        t += find(5, 3) + nested(1);
    }
    printf("%v\n", t);
}
