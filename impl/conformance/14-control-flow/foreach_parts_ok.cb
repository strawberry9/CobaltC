// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.foreach-parts [Foreach-Parts] (D-0287); conf.foreach-parts
// kind: positive
// expect: ok
// expect-stdout-hex: 5b68c3a96c6c6f5d0a31340a303d5b785d20313d5b795d20323d5b5d20333d5b7a5d203c6162633e0a303a5b6f6e655d20313a5b74776f5d20323a5b5d20333a5b6c6173745d200a6b657074205b6c6173745d0a330a
//
// A consuming `foreach` over a splitter's call visits the parts the
// splitter's `Vec` would hold, in its order, without making it: a return
// from the loop, positions, an empty separator, an empty text, `String`
// forms, and a part kept after its loop, a view of the text.

import std;

fn first_word(StringView v) : StringView
{
    foreach (w in StringView::split_whitespace(v))
    {
        return w;
    }
    StringView::of("")
}

fn main() : u8
{
    String text = String::from_str("  héllo wörld ");
    printf("[%s]\n", first_word(&text[0..$]));
    usize n = 0;
    foreach (c in String::chars(&text))
    {
        n += 1;
    }
    printf("%d\n", n);
    foreach (k, f in StringView::split("x::y::::z", "::"))
    {
        printf("%d=[%s] ", k, f);
    }
    foreach (f in StringView::split("abc", ""))
    {
        printf("<%s>", f);
    }
    foreach (l in StringView::lines(""))
    {
        printf("never\n");
    }
    printf("\n");
    String doc = String::from_str("one\r\ntwo\n\nlast");
    StringView kept = "";
    foreach (k, l in String::lines(&doc))
    {
        printf("%d:[%s] ", k, l);
        kept = l;
    }
    printf("\nkept [%s]\n", kept);
    usize words = 0;
    foreach (w in String::split_whitespace(&doc))
    {
        words += 1;
    }
    printf("%d\n", words);
    0
}
