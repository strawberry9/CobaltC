// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (a result holding what the parameters reach, CHG-0438; D-0288); conf.returned-move-closure-over-parameter
// kind: positive
// expect: ok
// decided: yes
//
// A `move` closure that captured a reference parameter, and one passed
// through a generic call, reach only what the caller gave: the result
// refers to nothing of `make`'s frame, and the program is decided.

import std;

fn id<T>(T x) : T
{
    x
}

fn make(ref<String, shared> s) : fn() : usize
{
    move [s]() { StringView::len(s) }
}

fn make2(ref<String, shared> s) : fn() : usize
{
    id(move [s]() { StringView::len(s) + 1 })
}

fn main()
{
    String s = "abc";
    auto f = make(&s);
    auto g = make2(&s);
    assert(f() == 3);
    assert(g() == 4);
}
