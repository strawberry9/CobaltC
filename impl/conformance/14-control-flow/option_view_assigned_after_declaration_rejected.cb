// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references; D-0288; conf.option-view-assigned-after-declaration
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// The same for an `Option<StringView>` assigned a view of a local after its
// declaration: writing the local while the `Option` is used later is
// refuted (bug 008).

import std;

fn main()
{
    String s = "a string that lives on the heap";
    Option<StringView> o = None;
    o = Some(&s);
    String::clear(&mut s);
    printf("<%s>\n", Option::unwrap(o));
}
