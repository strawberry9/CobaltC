// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis (§6, a call's arguments); [Ref-Binding-Last-Use]; rule.fn.bind-param (D-0049); conf.call-after-borrows-end
// kind: positive
// expect: ok
// expect-stdout-hex: 35203520352039360a
//
// What stays accepted beside `conf.match-binder-holds-at-call` and
// `conf.exclusive-given-as-shared-borrows-whole`: a `let` reference past
// its last use has ended, so the whole reference is given to a call,
// shared or exclusive; an exclusive reference given as exclusive is no new
// borrow, and the function may read the fields nothing else borrows; a
// match binder's arm may call with what the binder does not borrow; and
// after the match the reference is whole again.

import std;

enum Kind
{
    Count(i32),
    Empty,
}

struct Entry
{
    Kind kind;
    i32 n;
}

fn read_n(ref<Entry, shared> e) : i32
{
    e.n
}

fn take_n(ref<Entry, exclusive> e) : i32
{
    e.n
}

fn after_last_use(ref<Entry, exclusive> e) : i32
{
    ref<i32, exclusive> x = &mut e.n;
    *x += 1;
    read_n(e)
}

fn exclusive_as_exclusive(ref<Entry, exclusive> e) : i32
{
    i32 r = 0;
    match (&mut e.kind)
    {
        Kind::Count(c) :
        {
            *c += 1;
            r = take_n(e);
        },
        Kind::Empty    : {},
    }
    r
}

fn after_the_match(ref<Entry, exclusive> e) : i32
{
    i32 r = 0;
    match (&mut e.kind)
    {
        Kind::Count(c) : *c += 100,
        Kind::Empty    : {},
    }
    r += read_n(e);
    match (&e.kind)
    {
        Kind::Count(c) : r += *c,
        Kind::Empty    : {},
    }
    r
}

fn main()
{
    Entry e = Entry { .kind = Kind::Count(-10), .n = 4 };
    printf("%v ", after_last_use(&mut e));
    printf("%v ", exclusive_as_exclusive(&mut e));
    printf("%v ", take_n(&mut e));
    printf("%v\n", after_the_match(&mut e));
}
