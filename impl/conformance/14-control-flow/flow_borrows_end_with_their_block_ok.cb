// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis (block exit clears deriv facts of the block's bindings)
// kind: positive
// expect: ok
//
// `deriv(r, x, shared)` and `deriv(r1, x, exclusive)` end with the
// blocks that declared `r` and `r1`; the owner's later write and read
// are accepted, and the inner reborrow `&*r1` is rooted at a
// dereference, so it forms no fact at all.

fn main()
{
    i32 x = 1;
    {
        auto r = &x;
        i32 a = *r;
    }
    x = 2;
    {
        auto r1 = &mut x;
        {
            auto r2 = &*r1;
            i32 b = *r2;
        }
        *r1 = 3;
    }
    if (x != 3)
    {
        1 / (1 - 1);
    }
}
