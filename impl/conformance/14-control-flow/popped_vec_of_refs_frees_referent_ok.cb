// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (frame-held aggregates, D-0290); conf.popped-vec-of-refs-frees-referent
// kind: positive
// expect: ok
// expect-stdout-hex: 3220300a
//
// Popping the one reference `v` held removes it: the run then holds no path
// of `x` for `v`, and the write to `x` meets nothing. What `v` held is `?`
// after the pop, so the static pass leaves the access to the run, which
// finds no conflict.

import std;

fn main()
{
    i32 x = 1;
    Vec<ref<i32, exclusive>> v = Vec::new();
    Vec::push(&mut v, &mut x);
    match (Vec::pop(&mut v))
    {
        Some(r) : { *r = 5; },
        None    : {},
    }
    x = 2;
    printf("%v %v\n", x, Vec::len(&v));
}
