// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (frame-held aggregates: a callee stores a reference into a part of what its argument's referent keeps, bug 014); conf.out-parameter-through-reference-part-shared
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// `set_it` is given `rv`, which keeps a reference to `v`, lent shared, and
// stores `&(**q)[0]` into `*slot`: a reference into a part of what `q`'s
// referent keeps. After the call `r` refers into `v`; `rv` ends with its block
// and `v` is cleared while `r` is still used, so the run finds it: a fault
// at the read through `r` (in the default form as with every check).

import std;

fn set_it(ref<ref<String, shared>, exclusive> slot, ref<ref<Vec<String>, shared>, shared> q)
{
    *slot = &(**q)[0];
}

fn main()
{
    String other = "other";
    ref<String, shared> r = &other;
    Vec<String> v = Vec::new();
    Vec::push(&mut v, "a string that lives on the heap");
    {
        ref<Vec<String>, shared> rv = &v;
        set_it(&mut r, &rv);
    }
    Vec::clear(&mut v);
    Vec<String> nz = Vec::new();
    foreach (z in 0..8)
    {
        Vec::push(&mut nz, sprintf("noise %v ......................", z));
    }
    printf("<%s>\n", r);
}
