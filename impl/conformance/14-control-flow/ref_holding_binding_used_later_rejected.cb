// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.block [Ref-Binding-Last-Use]; D-0133; conf.ref-holding-binding-used-later-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// The lookup is used after the map is written: it still borrows the map.

import std;
fn main()
{
    HashMap<String, u32> m = HashMap::new();
    *HashMap::entry(&mut m, String::from_str("x"), 0) += 1;
    String k = String::from_str("x");
    Option<ref<u32, shared>> hit = HashMap::get(&m, &k);
    *HashMap::entry(&mut m, String::from_str("y"), 0) += 1;   // `hit` is used below: conflict
    printf("%v\n", Option::is_some(&hit));
}
