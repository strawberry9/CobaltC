// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: [Fault-Unwind] [Block-Exit] [Stmt-Exit] rule.arith.checked
// kind: negative
// expect: diag.arith-overflow (dynamic)
//
// A fault raised inside nested blocks and branch tails that bind and form
// nothing of their own still unwinds every live resource, innermost first:
// `b` of the current iteration, then `a`. Each earlier iteration's `b`
// ends with its block before the next begins.

import std;

resource struct Tracer
{
    str name;
}

fn Tracer::drop(ref<Tracer, exclusive> self)
{
    printf("drop %v\n", self.name);
}

fn make(str name) : Tracer
{
    Tracer { .name = name }
}

fn step(u8 x) : u8
{
    if (x > 100)
    {
        x + x
    }
    else
    {
        x + 20
    }
}

fn main()
{
    auto a = make("a");
    u8 n = 60;
    while (true)
    {
        auto b = make("b");
        {
            u8 m = if (n % 2 == 0)
            {
                n
            }
            else
            {
                n + 1
            };
            n = step(m);
        }
        printf("iter\n");
    }
}
