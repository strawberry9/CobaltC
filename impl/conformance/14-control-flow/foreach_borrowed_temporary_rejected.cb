// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.foreach (D-0042); [Ref-Form-Not-Place]; conf.foreach-borrowed-temporary
// kind: negative
// expect: diag.borrow-of-non-place (static)
//
// `foreach (x in &c)` borrows `c`, which must be a place. A call's
// result is iterated by consuming it, `foreach (x in f())`; the message
// says so.

import std;

fn evens() : Vec<u32>
{
    Vec<u32> v = Vec::new();
    Vec::push(&mut v, 2);
    Vec::push(&mut v, 4);
    v
}

fn main()
{
    foreach (x in &evens())
    {
        printf("%v\n", *x);
    }
}
