// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (point checks at the call); D-0283; conf.point-check-at-call-dynamic
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 5b64726f7020315d
//
// A pair of arguments that overlap only for some values (two computed
// indexes of one `Vec`) is checked when the call is made, from the
// callee's access summary (D-0283): `maybe_set` may write through `a`, so
// the call faults before its body runs, although on this run the body
// would not write (`go` is false): `[in]` is not printed. (Checked at the
// callee's first conflicting use instead, the fault would come at its read
// of `*b`, after `[in]`.) The fault unwinds `main`; the resource's
// destructor shows it.

import std;

resource struct R
{
    i64 id;
}

fn R::drop(ref<R, exclusive> self)
{
    printf("[drop %v]", self.id);
}

fn maybe_set(ref<i64, exclusive> a, ref<i64, shared> b, bool go) : i64
{
    printf("[in]");
    if (go)
    {
        *a = 5;
    }
    *b
}

fn main() : u8
{
    R r = R { .id = 1: i64 };
    Vec<i64> v = Vec::filled(4, 7: i64);
    usize i = Vec::len(&v) - 1;
    usize j = i * 1;
    i64 n = maybe_set(&mut v[i], &v[j], false);
    printf("unreached %v\n", n);
    0
}
