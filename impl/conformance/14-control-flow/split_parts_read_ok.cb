// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (frame-held aggregates, D-0290); conf.split-parts-read
// kind: positive
// expect: ok
// expect-stdout-hex: 627c610a
// decided: yes
//
// A part read out of the frame's `Vec<StringView>` holds what the `Vec` does
// (the text `s`), not unknown storage: reading it conflicts with
// nothing, and the program is decided.

import std;

fn main()
{
    String s = String::from_str("a,b");
    Vec<StringView> parts = String::split(&s, ",");
    StringView last = parts[Vec::len(&parts) - 1];
    printf("%v|%v\n", last, parts[0]);
}
