// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references; spec/14 deriv (D-0288); conf.option-of-view-blocks-owner-write
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `Some(v)` holds what the view `v` reaches: while the `Option` is used
// later, the string it views may not be written. Before D-0288 a variant
// built in place was taken for static data, and a decided build read the
// view after the write.

import std;

fn main()
{
    String s = String::from_str("abc");
    Option<StringView> o = Some(String::as_view(&s));
    String::append(&mut s, "x");
    match (o)
    {
        Some(v) : printf("%v\n", StringView::len(v)),
        None    : printf("none\n"),
    }
}
