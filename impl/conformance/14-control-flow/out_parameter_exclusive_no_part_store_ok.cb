// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (frame-held aggregates: the part-store summary of a callee given an argument exclusively, bug 014); conf.out-parameter-exclusive-no-part-store
// kind: positive
// expect: ok
// decided: yes
//
// `copy_out` is given a reader that keeps a slice, and the output
// exclusively; its signature would let it store a slice of the output
// into the reader, but its body stores none (its part-store summary is
// empty), so the call adds nothing to the reader, and clearing the
// output after it is decided.

import std;

struct Reader
{
    slice<u8, shared> data;
    usize pos;
}

fn copy_out(ref<Reader, exclusive> rd, ref<Vec<u8>, exclusive> out)
{
    while (rd.pos < slice_len(rd.data))
    {
        Vec::push(out, rd.data[rd.pos]);
        rd.pos += 1;
    }
}

fn main()
{
    Vec<u8> src = Vec::new();
    Vec::push(&mut src, 65);
    Vec::push(&mut src, 66);
    Reader rd = Reader { .data = &src, .pos = 0 };
    Vec<u8> out = Vec::new();
    copy_out(&mut rd, &mut out);
    Vec::clear(&mut out);
    printf("%v %v\n", Vec::len(&out), rd.pos);
}
