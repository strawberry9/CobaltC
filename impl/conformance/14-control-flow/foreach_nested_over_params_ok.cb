// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.foreach (D-0042): nested two-variable loops over reference parameters
// kind: positive
// expect: ok
// expect-stdout-hex: 3520323020323020300a
//
// A loop inside a loop, each over a `Vec` reached through a reference
// parameter, with the index and the element bound: the product of two
// numbers by digits, as a schoolbook multiplication. (A regression case:
// the compiler once read the inner loop's holder under a stale name.)

import std;

fn mul(ref<Vec<u32>, shared> a, ref<Vec<u32>, shared> b) : Vec<u32>
{
    Vec<u32> r = Vec::filled(Vec::len(a) + Vec::len(b), 0);
    foreach (i, x in a)
    {
        foreach (j, y in b)
        {
            r[i + j] += *x * *y;
        }
    }
    r
}

fn main()
{
    Vec<u32> a = Vec::filled(3, 2);
    Vec<u32> b = Vec::filled(2, 5);
    Vec<u32> r = mul(&a, &b);
    printf("%v %v %v %v\n", Vec::len(&r), r[1], r[2], r[4]);
}
