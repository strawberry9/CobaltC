// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.stmt [Stmt-Exit]
// kind: positive
// expect: ok
//
// A match on a call's temporary result that holds a reference (here an
// Option<ref<String, shared>>) ends that temporary with its statement,
// or with the block's trailing expression, so the String it refers to
// can be destroyed afterwards. coby once kept the temporary, and its
// reference, alive until the referent's destruction failed.

import std;

fn first(ref<Vec<String>, shared> v) : Option<ref<String, shared>>
{
    if (Vec::len(v) == 0)
    {
        return None;
    }
    Some(Vec::index_shared(v, 0))
}

fn in_statement()
{
    Vec<String> names = Vec::new();
    Vec::push(&mut names, String::from_str("a"));
    match (first(&names))
    {
        Some(s) :
        {
            String::len(s);
        },
        None : {},
    }
    usize n = 0;
    n = n + 1;
}

fn in_tail()
{
    Vec<String> names = Vec::new();
    Vec::push(&mut names, String::from_str("a"));
    match (first(&names))
    {
        Some(s) :
        {
            String::len(s);
        },
        None : {},
    }
}

fn main()
{
    in_statement();
    in_tail();
}
