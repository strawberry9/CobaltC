// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis (value-range row: literal-bound local); conf.literal-bound-local-written
// kind: positive
// expect: ok
//
// A write, a borrow, a closure capture, or a join with a path that
// wrote ends the literal binding (CHG-0092). None of these operations
// overflows when it runs, and none may be refuted from the declaration's
// literal. An inner binding's literal never reaches the outer one it
// shadows.

import std;

fn main()
{
    u8 a = 200;
    a = 20;
    u8 b = a + 100;

    u8 c = 250;
    if (arg_count() == 0)
    {
        c = 5;
    }
    u8 d = c + 100;

    u8 e = 250;
    while (e > 100)
    {
        e = e - 100;
    }
    u8 f = e + 100;

    u8 g = 250;
    {
        auto r = &mut g;
        *r = 1;
    }
    u8 h = g + 100;

    u8 s = 1;
    {
        u8 s = 250;
    }
    u8 t = s + 10;

    i32 zero = 0;
    zero += 2;
    i32 q = 10 / zero;

    assert(b == 120 && d == 105 && f == 150 && h == 101 && t == 11 && q == 5, "wrong values");
}
