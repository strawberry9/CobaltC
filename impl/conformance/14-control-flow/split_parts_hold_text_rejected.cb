// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (frame-held aggregates, D-0290); conf.split-parts-hold-text
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// The parts `String::split` gives are views of `s`, kept in a `Vec` of this
// frame, which may hold them (`?`: split could give none). Clearing `s` while
// `parts` holds views of it is left to the run, which finds the conflict: the
// split gave two parts.

import std;

fn main()
{
    String s = String::from_str("a,b");
    Vec<StringView> parts = String::split(&s, ",");
    String::clear(&mut s);
    printf("%v\n", Vec::len(&parts));
}
