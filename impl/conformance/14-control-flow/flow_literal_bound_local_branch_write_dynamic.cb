// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis (value-range row: literal-bound local); rule.arith.checked [Arith-Checked-Overflow]
// kind: negative
// expect: diag.arith-overflow (dynamic)
//
// One branch writes `c`, so after the join `c` is no longer bound to
// its literal: the condition is unknown, and the runtime check fails
// on the path that did not write (CHG-0092).

import std;

fn main()
{
    u8 c = 250;
    if (arg_count() > 0)
    {
        c = 5;
    }
    u8 d = c + 100;
}
