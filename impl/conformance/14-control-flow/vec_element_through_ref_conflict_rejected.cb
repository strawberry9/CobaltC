// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (an element through a reference, CHG-0380); conf.vec-element-through-ref-conflict-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `e0` and `e1` both borrow `(*v)[0]` exclusively, `v` a reference
// parameter; `e0` is used after `e1` is formed. A view of `*e0` would
// read the `String` that writing `*e1` destroys.

import std;

fn both(ref<Vec<String>, exclusive> v)
{
    ref<String, exclusive> e0 = &mut v[0];
    ref<String, exclusive> e1 = &mut v[0];
    StringView sv = String::view(&*e0, 0, 3);
    *e1 = String::from_str("new");
    printf("%v\n", sv);
}

fn main()
{
    Vec<String> v = Vec::new();
    Vec::push(&mut v, String::from_str("old"));
    both(&mut v);
}
