// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.agg.match
// kind: positive
// expect: ok
//
// Twelve matches, each nested in the arm of the last. `cobc` lowered each
// arm twice (once only to learn its type) at every level, so compile
// time doubled per level; it is linear now.

import std;

fn check(bool ok)
{
    i32 z = if (ok)
    {
        1
    }
    else
    {
        0
    };
    1 / z;
}

fn depth(Option<i32> o) : i32
{
    match (o)
    {
        Some(v) : match (o)
        {
            Some(v) : match (o)
            {
                Some(v) : match (o)
                {
                    Some(v) : match (o)
                    {
                        Some(v) : match (o)
                        {
                            Some(v) : match (o)
                            {
                                Some(v) : match (o)
                                {
                                    Some(v) : match (o)
                                    {
                                        Some(v) : match (o)
                                        {
                                            Some(v) : match (o)
                                            {
                                                Some(v) : match (o)
                                                {
                                                    Some(v) : 1 + v,
                                                    None : 0,
                                                } + v,
                                                None : 0,
                                            } + v,
                                            None : 0,
                                        } + v,
                                        None : 0,
                                    } + v,
                                    None : 0,
                                } + v,
                                None : 0,
                            } + v,
                            None : 0,
                        } + v,
                        None : 0,
                    } + v,
                    None : 0,
                } + v,
                None : 0,
            } + v,
            None : 0,
        } + v,
        None : 0,
    }
}

fn main()
{
    check(depth(Some(2)) == 25);
    check(depth(None) == 0);
}
