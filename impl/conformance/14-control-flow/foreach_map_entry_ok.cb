// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.foreach [Foreach-Borrowed-Entry] [Foreach-Borrowed] [Foreach-Consumed] (D-0331); rule.stdlib.hashmap; D-0134 (remove); conf.foreach-map-entry
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// A map's entries are a key and a value side by side. A loop over
// `&mut m` gives a shared reference to each key and an exclusive one to
// its value, both from one borrow of the entry; so does a loop over a map
// that is an exclusive reference, written without `&`. Loops over `&m`,
// with two names and with three, and over a shared reference; a consuming
// loop, left early, whose remaining values are destroyed in order;
// `clear`, which destroys the values in the entries' order; and, beside
// them, two-name loops over a `Vec` and a set, which are as they were.

import std;

resource struct Noisy
{
    u32 id;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("drop %v\n", self.id);
}

fn bump_all(ref<HashMap<String, usize>, exclusive> m)
{
    foreach (k, v in m)
    {
        *v += StringView::len(k);
    }
}

fn total(ref<HashMap<String, usize>, shared> m) : usize
{
    usize t = 0;
    foreach (k, v in m)
    {
        t += *v + StringView::len(k);
    }
    t
}

fn main()
{
    HashMap<String, usize> m = HashMap::new();
    foreach (i in 0..10)
    {
        HashMap::insert(&mut m, sprintf("key%v", i * i), i);
    }
    foreach (k, v in &mut m)
    {
        *v = *v * 2 + StringView::len(k);
    }
    foreach (i, k, v in &mut m)
    {
        *v += i;
    }
    bump_all(&mut m);
    usize sum = 0;
    foreach (k, v in &m)
    {
        sum += *v + StringView::len(k);
    }
    foreach (i, k, v in &m)
    {
        sum += i + *v;
    }
    printf("sum %v total %v\n", sum, total(&m));
    Vec<usize> xs = Vec::new();
    foreach (i in 0..5)
    {
        Vec::push(&mut xs, i);
    }
    foreach (i, x in &mut xs)
    {
        *x += i;
    }
    usize s2 = 0;
    foreach (i, x in xs)
    {
        s2 += x * (i + 1);
    }
    printf("vec %v\n", s2);
    foreach (k, v in m)
    {
        if (v > 30)
        {
            printf("%v=%v\n", &k, v);
        }
    }
    HashMap<usize, Noisy> n = HashMap::new();
    foreach (i in 0..4)
    {
        HashMap::insert(&mut n, i, Noisy { .id = narrow<u32>(i) });
    }
    drop(HashMap::remove(&mut n, 1));
    printf("removed\n");
    foreach (k, v in n)
    {
        printf("take %v\n", k);
        if (k == 2)
        {
            break;
        }
    }
    printf("after loop\n");
    HashMap<String, Noisy> q = HashMap::new();
    HashMap::insert(&mut q, "a", Noisy { .id = 10 });
    HashMap::insert(&mut q, "b", Noisy { .id = 11 });
    HashMap::clear(&mut q);
    printf("cleared\n");
    HashMap::insert(&mut q, "c", Noisy { .id = 12 });
    HashSet<String> hs = HashSet::new();
    HashSet::insert(&mut hs, "x");
    HashSet::insert(&mut hs, "y");
    foreach (i, k in &hs)
    {
        printf("%v:%v\n", i, k);
    }
    foreach (k in hs)
    {
        printf("%v\n", &k);
    }
}
