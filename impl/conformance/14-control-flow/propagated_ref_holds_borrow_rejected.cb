// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis (inherited facts: `e?`, D-0291); conf.propagated-ref-holds-borrow
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `d` is the reference `HashMap::get_mut(m, k)?` gives: it holds what the
// call's `Option` holds, a borrow of `*m` (D-0291). Clearing the map while
// `d` is live conflicts with that borrow on every run.

import std;

struct D
{
    u32 w;
}

fn bump(ref<HashMap<String, D>, exclusive> m, ref<String, shared> k) : Option<u32>
{
    ref<D, exclusive> d = HashMap::get_mut(m, k)?;
    HashMap::clear(m);
    d.w += 1;
    Some(d.w)
}

fn main() : void
{
    HashMap<String, D> m = HashMap::new();
    HashMap::insert(&mut m, String::from_str("a"), D { .w = 3 });
    String k = String::from_str("a");
    match (bump(&mut m, &k))
    {
        Some(w) : printf("%v\n", w),
        None    : printf("none\n"),
    }
}
