// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (frame-held aggregates: a call given `&mut` of what keeps references, D-0290); conf.out-parameter-reference-slot-dynamic
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// `set_it` stores into `*slot` a reference to an element of what its
// other argument refers to, which its own rules allow: the caller sees
// what it gave. So after `set_it(&mut r, &v)`, `r` may refer into `v`;
// clearing `v` while `r` is still used is the run's to find, and it
// faults at the read through `r` (in the default form as with every
// check).

import std;

fn set_it(ref<ref<String, shared>, exclusive> slot, ref<Vec<String>, shared> v)
{
    *slot = &v[0];
}

fn main()
{
    String other = "other";
    ref<String, shared> r = &other;
    Vec<String> v = Vec::new();
    Vec::push(&mut v, "a string that lives on the heap");
    set_it(&mut r, &v);
    Vec::clear(&mut v);
    printf("<%s>\n", r);
}
