// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.stmt [Stmt-Exit] (D-0315); conf.stmt-temps-end-descending
// kind: positive
// expect: ok
// expect-stdout-hex: 63616c6c206669727374207365636f6e642074330a656e64207365636f6e640a656e642066697273740a61667465722031310a656e64206469736361726465640a6e6578740a676f74206f6b0a656e64206f6b0a6f6b20320a657272203520697320746f6f206269670a
//
// The temporaries of a statement end where it ends, the last made first,
// whether they are borrowed by a call, discarded, or the scrutinee of a `?`;
// ones whose end frees memory alone end with them, unseen.

import std;

resource struct Noisy
{
    String name;
}

fn Noisy::drop(ref<Noisy, exclusive> n)
{
    printf("end %v\n", &n.name);
}

fn mk(str name) : Noisy
{
    Noisy { .name = String::copy(name) }
}

fn both(ref<Noisy, shared> a, ref<Noisy, shared> b, StringView c) : usize
{
    printf("call %v %v %v\n", &a.name, &b.name, c);
    StringView::len(&a.name) + StringView::len(&b.name)
}

fn text(u64 n) : String
{
    sprintf("t%v", n)
}

fn checked(u64 n) : Result<Noisy, String>
{
    if (n > 2)
    {
        return Err(sprintf("%v is too big", n));
    }
    Ok(mk("ok"))
}

fn twice(u64 n) : Result<usize, String>
{
    Noisy x = checked(n)?;
    printf("got %v\n", &x.name);
    Ok(StringView::len(&x.name))
}

fn main()
{
    usize n = both(&mk("first"), &mk("second"), &text(3));
    printf("after %v\n", n);
    mk("discarded");
    printf("next\n");
    match (twice(1))
    {
        Ok(k)  : printf("ok %v\n", k),
        Err(e) : printf("err %v\n", &e),
    }
    match (twice(5))
    {
        Ok(k)  : printf("ok %v\n", k),
        Err(e) : printf("err %v\n", &e),
    }
}
