// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis (§6, a call's arguments); rule.fn.bind-param with spec/12 §2 (D-0049: an exclusive argument for a shared parameter is the shared reborrow `&*e`); conf.exclusive-given-as-shared-borrows-whole
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// An exclusive reference given where a shared one is taken is passed as
// `&*e`: a shared borrow of the whole referent, whatever the function
// reads through it. While `x` borrows `e.n` exclusively and is used
// later, that borrow conflicts, as the written `total(&*e)` does. (The
// run's record always had it; the static pass once judged the call by the
// fields `total` reads, and the default form ran this.)

import std;

struct Entry
{
    i32 kind;
    i32 n;
}

fn total(ref<Entry, shared> e) : i32
{
    e.kind
}

fn bump(ref<Entry, exclusive> e) : i32
{
    ref<i32, exclusive> x = &mut e.n;
    i32 r = total(e);
    *x += 1;
    r
}

fn main()
{
    Entry e = Entry { .kind = 4, .n = 1 };
    printf("%v\n", bump(&mut e));
}
