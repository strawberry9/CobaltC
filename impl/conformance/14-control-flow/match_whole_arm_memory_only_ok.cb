// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.agg.match (D-0058, D-0315); conf.match-whole-arm-memory-only
// kind: positive
// expect: ok
// expect-stdout-hex: 2d3120657272206e656761746976650a30206f6b20330a31206f6b20360a3220657272206e6f7420612070726f6365647572653a206c697374206f6620320a3320657272206e6f7420612070726f6365647572653a20330a3420657272206e6f7420612070726f6365647572653a20340a
//
// A local enum whose end frees memory alone, matched with payload arms and an
// arm binding the whole value: each arm gets the value whole, and every value
// ends once.

import std;

enum Value
{
    Nil,
    Int(i64),
    List(Vec<Value>),
    Closure(Lambda),
    Builtin(String),
}

struct Lambda
{
    Vec<String> params;
    Vec<Value> body;
    usize env;
}

fn make(i64 n) : Result<Value, String>
{
    if (n < 0)
    {
        return Err("negative");
    }
    if (n == 0)
    {
        return Ok(Builtin("car"));
    }
    if (n == 1)
    {
        Vec<String> ps = Vec::new();
        Vec::push(&mut ps, "x");
        Vec::push(&mut ps, "y");
        Vec<Value> body = Vec::new();
        Vec::push(&mut body, Int(7));
        return Ok(Closure(Lambda { .params = ps, .body = body, .env = 3 }));
    }
    if (n == 2)
    {
        Vec<Value> xs = Vec::new();
        Vec::push(&mut xs, Int(1));
        Vec::push(&mut xs, Builtin("cdr"));
        return Ok(List(xs));
    }
    Ok(Int(n))
}

fn show(ref<Value, shared> v) : String
{
    match (v)
    {
        Int(n)  : sprintf("%v", *n),
        List(x) : sprintf("list of %v", Vec::len(x)),
        Nil     : "nil",
        _       : "?",
    }
}

fn run(i64 n) : Result<i64, String>
{
    Value f = make(n)?;
    match (f)
    {
        Closure(l)    :
        {
            return Ok(reinterpret<i64>(l.env) + reinterpret<i64>(Vec::len(&l.params)) + reinterpret<i64>(Vec::len(&l.body)));
        },
        Builtin(name) : { return Ok(reinterpret<i64>(StringView::len(&name))); },
        other         : { return Err(sprintf("not a procedure: %v", &show(&other))); },
    }
}

fn main()
{
    for (i64 i = -1; i < 5; i += 1)
    {
        match (run(i))
        {
            Ok(v)  : printf("%v ok %v\n", i, v),
            Err(e) : printf("%v err %v\n", i, &e),
        }
    }
}
