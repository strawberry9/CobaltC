// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.block ([Block-Exit], D-0327); rule.init.let ([Let-Uninit]); conf.unwritten-binding-ends-with-nothing
// kind: positive
// expect: ok
// expect-stdout-hex: 64726f7020370a3720300a3120300a6661696c656420617420370a64726f7020390a6f6b20390a
//
// A binding declared with no value that meets its scope's end, or a
// contained fault, before its first assignment was never written: no
// destructor runs on it and nothing in it is destroyed. One that was
// assigned ends as any other does. Before D-0327 the default form ran the
// destructor on memory never written (`drop` printed what the stack
// held), and with every check the destructor's first read faulted
// `diag.use-of-uninitialized`.

import std;

resource struct Noisy
{
    i32 id;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("drop %v\n", self.id);
}

fn pick(bool c) : i32
{
    Noisy n;
    if (c)
    {
        n = Noisy { .id = 7 };
        return n.id;
    }
    0
}

fn names(bool c) : usize
{
    Vec<String> v;
    if (c)
    {
        v = Vec::new();
        Vec::push(&mut v, String::copy("a"));
        return Vec::len(&v);
    }
    0
}

fn refuse(usize n) : usize
{
    assert(n != 7, "refused %v", n);
    n
}

fn late(usize at) : i32
{
    Noisy n;
    refuse(at);
    n = Noisy { .id = 9 };
    n.id
}

fn main()
{
    printf("%v %v\n", pick(true), pick(false));
    printf("%v %v\n", names(true), names(false));
    foreach (at in [7: usize, 6])
    {
        match (try_join(spawn(late, at)))
        {
            Ok(k)  : printf("ok %v\n", k),
            Err(_) : printf("failed at %v\n", at),
        }
    }
}
