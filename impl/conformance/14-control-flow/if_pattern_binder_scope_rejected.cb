// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.if `[If-Pattern]` (D-0115): the binder is the arm's, in scope in the block only; conf.if-pattern-binder-scope-rejected
// kind: negative
// expect: diag.unbound-name (static)

import std;

fn main()
{
    Option<i32> o = Some(1);
    if (Some(x) = o)
    {
        printf("%v\n", x);
    }
    printf("%v\n", x);
}
