// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references; D-0288; conf.option-ref-assigned-after-declaration
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// An `Option` of a reference assigned after its declaration holds what the
// assigned value holds, as one initialised with it does: `o = Some(&v[0])`
// borrows `v`, so clearing `v` while `o` is used later is refuted (bug 008:
// the assignment kept the declaration's `None`, static data).

import std;

fn main()
{
    Vec<String> v = Vec::new();
    Vec::push(&mut v, "a string that lives on the heap");
    Option<ref<String, shared>> o = None;
    o = Some(&v[0]);
    Vec::clear(&mut v);
    printf("<%s>\n", Option::unwrap(o));
}
