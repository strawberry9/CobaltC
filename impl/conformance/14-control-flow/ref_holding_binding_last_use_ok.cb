// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.block [Ref-Binding-Last-Use] for a reference-holding local; D-0133; conf.ref-holding-binding-ends-at-last-use
// kind: positive
// expect: ok
// expect-stdout-hex: 747275650a3220332031300a
//
// A local that holds references and nothing to destroy (a map lookup's
// `Option<ref<…>>`, a struct of references) stops holding them after its
// last use, as a reference binding does (D-0111).

import std;
struct Pair { ref<i32, shared> a; ref<i32, shared> b; }
fn main()
{
    HashMap<String, u32> m = HashMap::new();
    *HashMap::entry(&mut m, String::from_str("x"), 0) += 1;
    String k = "x";
    Option<ref<u32, shared>> hit = HashMap::get(&m, &k);
    printf("%v\n", Option::is_some(&hit));
    *HashMap::entry(&mut m, String::from_str("y"), 0) += 1;   // `hit` is not used again: fine (D-0133)
    i32 x = 1;
    i32 y = 2;
    Pair p = Pair { .a = &x, .b = &y };
    i32 s = *p.a + *p.b;
    x = 10;                                                    // `p` is not used again: fine
    printf("%v %v %v\n", HashMap::len(&m), s, x);
}
