// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.if `[If-Pattern]` (D-0115): a bare name on the left of `=` is the assignment, not a pattern, rejected by `[T-If]` as before; conf.if-assignment-still-rejected
// kind: negative
// expect: diag.type-mismatch (static)

import std;

fn main()
{
    i32 x = 0;
    i32 y = 1;
    if (x = y)
    {
        printf("assigned\n");
    }
}
