// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis (§6: a binder of a pattern matched by reference); `if (pattern = e)`; conf.if-pattern-binder-holds-at-call
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `if (Some(n) = &mut e.count)` is a match by reference: its binder
// borrows `e.count` until its last use in the block (D-0336), so a call
// that reads `e.count` through `e` before that use conflicts with it.

import std;

struct Entry
{
    Option<i32> count;
}

fn total(ref<Entry, exclusive> e) : i32
{
    Option::unwrap_or(e.count, 0)
}

fn bump(ref<Entry, exclusive> e) : i32
{
    if (Some(n) = &mut e.count)
    {
        *n += 1;
        i32 t = total(e);
        *n += 1;
        return t;
    }
    0
}

fn main()
{
    Entry e = Entry { .count = Some(4) };
    printf("%v\n", bump(&mut e));
}
