// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.if
// kind: positive
// expect: ok
//
// Sixteen `if`s, each inside the last one's block. `cobc` lowered every
// block twice (once to learn its type) at every level, doubling compile
// time per level; the probe is cached now.

import std;

fn check(bool ok)
{
    i32 z = if (ok)
    {
        1
    }
    else
    {
        0
    };
    1 / z;
}

fn f(u32 x) : u32
{
    u32 y = 0;
    if (x > 16)
    {
        if (x > 15)
        {
            if (x > 14)
            {
                if (x > 13)
                {
                    if (x > 12)
                    {
                        if (x > 11)
                        {
                            if (x > 10)
                            {
                                if (x > 9)
                                {
                                    if (x > 8)
                                    {
                                        if (x > 7)
                                        {
                                            if (x > 6)
                                            {
                                                if (x > 5)
                                                {
                                                    if (x > 4)
                                                    {
                                                        if (x > 3)
                                                        {
                                                            if (x > 2)
                                                            {
                                                                if (x > 1)
                                                                {
                                                                    y = y + 1;
                                                                }
                                                                else
                                                                {
                                                                    y = y + 2;
                                                                }
                                                            }
                                                            else
                                                            {
                                                                y = y + 2;
                                                            }
                                                        }
                                                        else
                                                        {
                                                            y = y + 2;
                                                        }
                                                    }
                                                    else
                                                    {
                                                        y = y + 2;
                                                    }
                                                }
                                                else
                                                {
                                                    y = y + 2;
                                                }
                                            }
                                            else
                                            {
                                                y = y + 2;
                                            }
                                        }
                                        else
                                        {
                                            y = y + 2;
                                        }
                                    }
                                    else
                                    {
                                        y = y + 2;
                                    }
                                }
                                else
                                {
                                    y = y + 2;
                                }
                            }
                            else
                            {
                                y = y + 2;
                            }
                        }
                        else
                        {
                            y = y + 2;
                        }
                    }
                    else
                    {
                        y = y + 2;
                    }
                }
                else
                {
                    y = y + 2;
                }
            }
            else
            {
                y = y + 2;
            }
        }
        else
        {
            y = y + 2;
        }
    }
    else
    {
        y = y + 2;
    }
    y
}

fn main()
{
    check(f(20) == 1);
    check(f(0) == 2);
}
