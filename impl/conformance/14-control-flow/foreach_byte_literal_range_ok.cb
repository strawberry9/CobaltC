// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.foreach-range (both bounds byte literals: `T` is `u8`); conf.foreach-byte-literal-range
// kind: positive
// expect: ok
//
// `foreach (c in b'a' ..= b'z')` visits the letters as `u8`s, so each is
// compared with a byte and stored in a `u8` with no conversion; a range of
// two integer literals stays `usize`.

import std;

fn main()
{
    u8 orig = b'c';
    usize others = 0;
    Vec<u8> seen = Vec::new();
    foreach (c in b'a' ..= b'z')
    {
        if (c != orig)
        {
            others += 1;
        }
        Vec::push(&mut seen, c);
    }
    assert(others == 25);
    assert(Vec::len(&seen) == 26 && seen[25] == b'z');
    foreach (i in 0 .. 2)
    {
        usize k = i;
        assert(k < 2);
    }
}
