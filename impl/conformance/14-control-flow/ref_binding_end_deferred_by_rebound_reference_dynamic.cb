// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.block [Ref-Binding-Last-Use] (D-0275, CHG-0365): a reference rebound in the statement still defers an end; conf.ref-binding-end-deferred-by-rebound-reference
// kind: negative
// expect: diag.destroy-while-aliased (dynamic)
//
// `q` is a reference to an `i32`, but `r`'s declaring statement assigns it
// whole, so it may hold a path the statement formed: `r`'s end waits while
// `q` is mentioned, and `r` is still live when `take` destroys the Box it
// points into.

import std;

struct Holder
{
    Box<String> b;
}

fn take(Holder h) : usize
{
    1
}

fn run(Holder h, bool early) : usize
{
    i32 z = 7;
    i32 w = 8;
    ref<i32, shared> q = &z;
    ref<String, shared> r = if (!early)
    {
        q = &w;
        Box::get(&h.b)
    }
    else
    {
        return 0;
    };
    usize n = String::len(r);
    printf("%v\n", n);
    usize k = take(h);
    printf("%v\n", *q);
    n + k
}

fn main()
{
    Holder h = Holder { .b = Box::new(String::from_str("abc")) };
    printf("%v\n", run(h, false));
}
