// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.stmt [Stmt-Exit] (a temporary read through -- `make().f` -- ends with its statement)
// kind: positive
// expect: ok

resource struct Flagger
{
    ref<i32, exclusive> flag;
    i32 tag;
}

fn Flagger::drop(ref<Flagger, exclusive> self)
{
    *self.flag = *self.flag + 1;
}

fn make(ref<i32, exclusive> flag, i32 tag) : Flagger
{
    Flagger { .flag = flag, .tag = tag }
}

fn main()
{
    i32 dropped = 0;
    i32 t = make(&mut dropped, 5).tag;       // the temporary ends here, after the read
    if (t != 5 || dropped != 1)
    {
        1 / (1 - 1);
    }
}
