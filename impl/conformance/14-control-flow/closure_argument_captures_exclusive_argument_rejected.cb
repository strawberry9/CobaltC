// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (the call-site rule, rule 2; D-0288); conf.closure-argument-captures-exclusive-argument-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// Argument 1 lends `v` exclusively for the whole call, and argument 2 is a
// closure without `move` whose body writes `v`: it borrows `v`
// exclusively too, for the whole call, as a bound closure would. The
// callee could hold a reference into `v` while the closure clears it.

import std;

fn hold_and_call(ref<Vec<String>, exclusive> v, fn() : void cb)
{
    ref<String, shared> first = &v[0];
    cb();
    printf("%s\n", first);
}

fn main()
{
    Vec<String> v = Vec::new();
    Vec::push(&mut v, "the first element");
    hold_and_call(&mut v, [v]() { Vec::clear(&mut v); });
}
