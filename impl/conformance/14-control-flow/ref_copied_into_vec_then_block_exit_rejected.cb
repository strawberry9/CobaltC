// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis Forgetting; rule.control.block [Block-Exit]; D-0236; conf.ref-copied-into-vec-then-block-exit
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// The inner block ends `r`, but the `Vec` `v` holds its path. Block exit
// forgets `r`'s fact on `x` and marks `x` escaped (D-0236), so `x = 5`
// is checked and meets the path in `v`.
//
// D-0290: the reference is stored by a call (`keep_in`), so the frame holds it
// only as `?` (it may hold none of it), and the run checks the access; the
// same program storing it directly is refuted before the run.

import std;

fn keep_in(ref<Vec<ref<i32, exclusive>>, exclusive> keep, ref<i32, exclusive> r)
{
    Vec::push(keep, r);
}

fn main()
{
    i32 x = 0;
    Vec<ref<i32, exclusive>> v = Vec::new();
    {
        auto r = &mut x;
        keep_in(&mut v, r);
    }
    x = 5;
    printf("%v\n", *v[0]);
}
