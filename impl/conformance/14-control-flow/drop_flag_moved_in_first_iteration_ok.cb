// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.while [Block-Exit], [Fault-Contain] (D-0315); conf.drop-flag-moved-in-first-iteration
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// A local moved into a call in a loop's first iteration, which then leaves
// the loop: the local ends once, in the callee; an iteration's own local ends
// with each iteration; a fault before the move, in the loop or after it ends
// what is still live, last bound first.

import std;

resource struct Noisy
{
    String name;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("[%v]", &self.name);
}

fn make(StringView name) : Noisy
{
    Noisy { .name = String::copy(name) }
}

fn take(Noisy n) : usize
{
    StringView::len(&n.name)
}

fn first(usize at, usize move_at) : usize
{
    Noisy x = make("x");
    Noisy w = make("w");
    usize n = 0;
    usize i = 0;
    while (i < 3)
    {
        Noisy z = make("z");
        assert(at != 10 + i, "in the loop");
        if (i == move_at)
        {
            n = take(x);
            break;
        }
        i += 1;
    }
    assert(at != 1, "after the loop");
    n + i
}

fn main()
{
    foreach (at in [0: usize, 10, 11, 1])
    {
        foreach (move_at in [0: usize, 1, 5])
        {
            match (try_join(spawn(first, at, move_at)))
            {
                Ok(v)  : printf(" ok %v\n", v),
                Err(_) : printf(" failed\n"),
            }
        }
    }
    printf("%v\n", first(0, 0));
}
