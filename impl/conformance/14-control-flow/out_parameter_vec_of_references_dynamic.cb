// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (frame-held aggregates: a call given `&mut a` adds what its other arguments give, D-0290); conf.out-parameter-vec-of-references-dynamic
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// `add` pushes into the holder `keep` a reference to an element of what
// its other argument refers to. What the call gives `keep` is not only
// `&v` itself but every reference into a part of `v` of the type `keep`
// holds: `keep` may hold a reference into `v`, so clearing `v` while
// `keep` is used is the run's to find.

import std;

fn add(ref<Vec<ref<String, shared>>, exclusive> out, ref<Vec<String>, shared> v)
{
    Vec::push(out, &v[0]);
}

fn main()
{
    Vec<ref<String, shared>> keep = Vec::new();
    Vec<String> v = Vec::new();
    Vec::push(&mut v, "a string that lives on the heap");
    add(&mut keep, &v);
    Vec::clear(&mut v);
    printf("<%s>\n", keep[0]);
}
