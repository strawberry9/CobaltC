// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis (the loop's least fixed point, D-0300); conf.ref-copy-chain-longer-than-loop-rounds
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// A fact moves one copy along `r1 = r2; …; r19 = r20;` each time round the
// loop, so the head's fixed point takes twenty rounds to reach. The analysis
// widens a head still moving after sixteen (D-0300) and so reaches `r1`'s
// fact on `x`: the write to `x` after the loop is the run's. Before D-0300
// the iteration stopped at sixteen rounds, short of the fixed point, the
// program was decided, and `cobc` wrote with no check.

import std;

fn main()
{
    i32 x = 1;
    i32 y = 2;
    ref<i32, shared> r1 = &y;
    ref<i32, shared> r2 = &y;
    ref<i32, shared> r3 = &y;
    ref<i32, shared> r4 = &y;
    ref<i32, shared> r5 = &y;
    ref<i32, shared> r6 = &y;
    ref<i32, shared> r7 = &y;
    ref<i32, shared> r8 = &y;
    ref<i32, shared> r9 = &y;
    ref<i32, shared> r10 = &y;
    ref<i32, shared> r11 = &y;
    ref<i32, shared> r12 = &y;
    ref<i32, shared> r13 = &y;
    ref<i32, shared> r14 = &y;
    ref<i32, shared> r15 = &y;
    ref<i32, shared> r16 = &y;
    ref<i32, shared> r17 = &y;
    ref<i32, shared> r18 = &y;
    ref<i32, shared> r19 = &y;
    ref<i32, shared> r20 = &y;
    i32 i = 0;
    while (i < 30)
    {
        r1 = r2;
        r2 = r3;
        r3 = r4;
        r4 = r5;
        r5 = r6;
        r6 = r7;
        r7 = r8;
        r8 = r9;
        r9 = r10;
        r10 = r11;
        r11 = r12;
        r12 = r13;
        r13 = r14;
        r14 = r15;
        r15 = r16;
        r16 = r17;
        r17 = r18;
        r18 = r19;
        r19 = r20;
        r20 = &x;
        i = i + 1;
    }
    x = 5;
    printf("%v\n", *r1);
}
