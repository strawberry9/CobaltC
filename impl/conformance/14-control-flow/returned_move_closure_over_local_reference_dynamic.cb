// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (a result holding what ends with the frame, CHG-0438; D-0288); conf.returned-move-closure-over-local-reference-dynamic
// kind: negative
// expect: diag.destroy-while-aliased (dynamic)
//
// `make` returns a `move` closure that captured an exclusive reference to
// its own local `v`. The closure holds what the reference reaches, so the
// result refers to what ends with the frame: the program is not decided,
// and the run faults where `v` is destroyed while the closure still
// refers to it (in the default form as with every check).

import std;

fn make() : fn() : usize
{
    Vec<u8> v = Vec::from_slice(&[1: u8, 2, 3]);
    ref<Vec<u8>, exclusive> r = &mut v;
    move [r]()
    {
        Vec::push(r, 9);
        Vec::len(r)
    }
}

fn main()
{
    auto f = make();
    printf("%v\n", f());
}
