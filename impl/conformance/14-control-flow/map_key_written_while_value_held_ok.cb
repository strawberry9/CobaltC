// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis deriv (D-0088); conf.map-key-written-while-value-held
// kind: positive
// expect: ok
//
// A reference out of `HashMap::get`'s `Option<ref<V>>` borrows the map,
// its first reference argument, and not the key: the key may be
// rewritten while the reference is held. Found by real-world testing (a
// text adventure moving to the room it has just looked up).

import std;

fn main() : u8
{
    HashMap<String, u32> doors = HashMap::new();
    HashMap::insert(&mut doors, String::from_str("hall"), 2);
    HashMap::insert(&mut doors, String::from_str("cellar"), 1);
    String here = "hall";
    ref<u32, shared> n = Option::unwrap(HashMap::get(&doors, &here));
    overwrite(&mut here, String::from_str("cellar"));
    if (*n != 2 || !String::eq_str(&here, "cellar")) { return 1; }
    0
}
