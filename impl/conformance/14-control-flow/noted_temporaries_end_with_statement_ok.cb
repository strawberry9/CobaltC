// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.stmt [Stmt-Exit], [Fault-Contain] (D-0315); conf.noted-temporaries-end-with-statement
// kind: positive
// expect: ok
// expect-stdout-hex: 5b74656d705d5b6172675d5b6c6174655d5b626f756e645d5b6265666f72655d2031350a5b74656d705d5b6172675d5b6c6174655d5b626f756e645d5b6265666f72655d206f6b2031350a5b74656d705d5b6265666f72655d206661696c65640a5b74656d705d5b6172675d5b6c6174655d5b626f756e645d5b6265666f72655d206661696c65640a
//
// A temporary whose type has a destructor of its own, read in part
// (`make().f`): it ends where its statement ends, after a value the
// statement binds and before the locals bound earlier; a fault later in the
// statement ends it before those locals, once; the program goes on.

import std;

resource struct Noisy
{
    String name;
    usize n;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("[%v]", &self.name);
}

fn make(StringView name, usize n) : Noisy
{
    Noisy { .name = String::copy(name), .n = n }
}

fn check(usize n, u8 at) : usize
{
    assert(at != 1, "refused %v", n);
    n
}

fn run(u8 at) : usize
{
    Noisy before = make("before", 1);
    usize k = make("temp", 2).n + check(3, at);
    Noisy bound = make(StringView::of("bound"), make("arg", 4).n);
    usize m = check(make("late", 5).n, if (at == 2) { 1 } else { 0 });
    k + m + bound.n + before.n
}

fn main()
{
    printf(" %v\n", run(0));
    foreach (at in [0: u8, 1, 2])
    {
        match (try_join(spawn(run, at)))
        {
            Ok(v)  : printf(" ok %v\n", v),
            Err(_) : printf(" failed\n"),
        }
    }
}
