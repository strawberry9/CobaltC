// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis (deriv via D-0011 elided call); conf.vec-ref-then-push-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `Vec::index_shared` has exactly one reference parameter and returns
// a reference, so `auto r = Vec::index_shared(&v, 0)` sets
// `deriv(r, v, shared) = T` exactly as `auto r = &v` would; the later
// exclusive borrow `&mut v` is refuted.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    auto r = Vec::index_shared(&v, 0);
    Vec::push(&mut v, 2);
    i32 y = *r;
}
