// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (point checks at the call); [Swap-Places]; D-0283; conf.point-check-swap-same-place
// kind: positive
// expect: ok
// expect-stdout-hex: 3320370a
//
// `swap(&mut v[i], &mut v[j])` with `i == j` computed: the two places of a
// swap, of one type, are one place (`[Swap-Places]`: no conflict, nothing
// moves) or disjoint, so the call needs no point check (D-0283), and runs.

import std;

fn main() : u8
{
    Vec<i64> v = Vec::filled(4, 7: i64);
    v[1] = 3;
    usize i = Vec::len(&v) - 3;
    usize j = i * 1;
    swap(&mut v[i], &mut v[j]);
    Vec::swap(&mut v, i, j);
    printf("%v %v\n", v[1], v[0]);
    0
}
