// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.if
// kind: positive
// expect: ok
//
// A chain of 20 `else if`s. `cobc` once lowered each `else` branch twice
// (once only to learn its type) at every level, so compiling a chain of n
// took time 2^n; this one would take hours. It compiles at once now.

import std;

fn check(bool ok)
{
    i32 z = if (ok)
    {
        1
    }
    else
    {
        0
    };
    1 / z;
}

fn pick(u32 x) : u32
{
    u32 y = 0;
    if (x == 0)
    {
        y = 100;
    }
    else if (x == 1)
    {
        y = 101;
    }
    else if (x == 2)
    {
        y = 102;
    }
    else if (x == 3)
    {
        y = 103;
    }
    else if (x == 4)
    {
        y = 104;
    }
    else if (x == 5)
    {
        y = 105;
    }
    else if (x == 6)
    {
        y = 106;
    }
    else if (x == 7)
    {
        y = 107;
    }
    else if (x == 8)
    {
        y = 108;
    }
    else if (x == 9)
    {
        y = 109;
    }
    else if (x == 10)
    {
        y = 110;
    }
    else if (x == 11)
    {
        y = 111;
    }
    else if (x == 12)
    {
        y = 112;
    }
    else if (x == 13)
    {
        y = 113;
    }
    else if (x == 14)
    {
        y = 114;
    }
    else if (x == 15)
    {
        y = 115;
    }
    else if (x == 16)
    {
        y = 116;
    }
    else if (x == 17)
    {
        y = 117;
    }
    else if (x == 18)
    {
        y = 118;
    }
    else if (x == 19)
    {
        y = 119;
    }
    else
    {
        y = 0;
    }
    y
}

fn main()
{
    check(pick(0) == 100);
    check(pick(19) == 119);
    check(pick(25) == 0);
}
