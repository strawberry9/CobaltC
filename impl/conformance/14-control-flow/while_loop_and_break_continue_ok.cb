// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.while
// kind: positive
// expect: ok
//
// `break`/`continue` inside a `while` behave as usual: continue skips
// to the next condition check, break exits the loop entirely.

fn main()
{
    i32 sum = 0;
    i32 i = 0;
    while (i < 10)
    {
        i = i + 1;
        if (i == 3)
        {
            continue;
        }
        if (i == 7)
        {
            break;
        }
        sum = sum + i;
    }
    if (sum != 18)
    {
        1 / (1 - 1);
    }
}
