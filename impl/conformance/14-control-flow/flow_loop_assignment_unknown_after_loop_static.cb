// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis (loop fixed point); rule.init.definite-assignment
// kind: negative
// expect: diag.use-of-uninitialized (static)
//
// The loop head joins the entry state (`init(x) = F`) with the back
// edge (`init(x) = T`) to `?`, and the exit inherits it; a read after
// the loop is rejected even though the loop body always runs here.

fn main()
{
    i32 x;
    i32 i = 0;
    while (i < 3)
    {
        x = i;
        i = i + 1;
    }
    i32 y = x;
}
