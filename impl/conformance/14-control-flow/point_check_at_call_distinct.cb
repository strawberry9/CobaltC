// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (point checks at the call); D-0283; conf.point-check-at-call-distinct
// kind: positive
// expect: ok
// expect-stdout-hex: 3520370a
//
// The point check at a call passes when the values keep the places apart:
// `&mut v[i]` and `&v[j]` with `i != j` are distinct elements, so the
// callee runs and writes through one while reading the other (D-0283).

import std;

fn set_and_read(ref<i64, exclusive> a, ref<i64, shared> b) : i64
{
    *a = 5;
    *b
}

fn main() : u8
{
    Vec<i64> v = Vec::filled(4, 7: i64);
    usize i = Vec::len(&v) - 1;
    usize j = i - 1;
    i64 n = set_and_read(&mut v[i], &v[j]);
    printf("%v %v\n", v[i], n);
    0
}
