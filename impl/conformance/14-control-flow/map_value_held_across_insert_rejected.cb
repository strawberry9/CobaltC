// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis deriv (D-0088); conf.map-value-held-across-insert-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// A reference into a map's value, held across an `insert` into the same
// map. Before D-0088 this faulted only when the insert grew the table,
// so a small test passed; the reference now borrows the map (the first
// reference argument of `HashMap::get`) and the insert is refuted.

import std;

fn main()
{
    HashMap<u32, String> m = HashMap::new();
    HashMap::insert(&mut m, 1, String::from_str("one"));
    ref<String, shared> first = Option::unwrap(HashMap::get(&m, &1));
    HashMap::insert(&mut m, 2, String::from_str("two"));
    printf("%s\n", first);
}
