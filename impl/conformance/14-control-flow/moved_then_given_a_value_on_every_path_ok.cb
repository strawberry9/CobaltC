// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis (valid(v) after re-establishment); D-0087
// kind: positive
// expect: ok
//
// The other side of D-0087: a binding moved in a loop's body or in a
// branch may be used again once every path has given it a new value.

import std;

fn takes(Vec<i32> v) : usize
{
    Vec::len(&v)
}

fn main() : u8
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    usize total = 0;
    u32 i = 0;
    while (i < 3)
    {
        total += takes(v);
        v = Vec::new();
        Vec::push(&mut v, 2);
        Vec::push(&mut v, 3);
        i += 1;
    }
    bool c = total > 3;
    if (c)
    {
        total += takes(v);
        v = Vec::new();
    }
    else
    {
        Vec::push(&mut v, 4);
    }
    total += Vec::len(&v);
    if (total != 7) { return 1; }
    0
}
