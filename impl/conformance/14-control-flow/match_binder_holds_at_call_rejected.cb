// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis (§6: the arm of a match by reference, its binder's fact "in the arm"); [Ref-Binding-Last-Use] for a binder (D-0336); conf.match-binder-holds-at-call
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// The binder of a match by reference borrows the scrutinee's place until
// its last use in the arm's block (D-0336, as a `let` reference ends at its
// last use, D-0111). A call that reads that place through another argument
// while the binder is still used after it conflicts with it.

import std;

enum Kind
{
    Count(i32),
    Empty,
}

struct Entry
{
    Kind kind;
}

fn total(ref<Entry, exclusive> e) : i32
{
    match (&e.kind)
    {
        Kind::Count(n) : *n,
        Kind::Empty    : 0,
    }
}

fn bump(ref<Entry, exclusive> e) : i32
{
    i32 r = 0;
    match (&mut e.kind)
    {
        Kind::Count(n) :
        {
            *n += 1;
            r = total(e);
            *n += 1;
        },
        Kind::Empty    : {},
    }
    r
}

fn main()
{
    Entry e = Entry { .kind = Kind::Count(4) };
    printf("%v\n", bump(&mut e));
}
