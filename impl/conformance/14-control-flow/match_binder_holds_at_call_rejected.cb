// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis (§6: the arm of a match by reference, its binder's fact "in the arm"); [Ref-Binding-Last-Use] is for `let` bindings; conf.match-binder-holds-at-call
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// The binder of a match by reference borrows the scrutinee's place for
// the whole arm: it is not a `let` binding, so it does not end at its last
// use. A call that reads that place through another argument while the
// arm runs conflicts with it, though the binder is not mentioned again.
// (The run's record always had the borrow; the static pass once took the
// binder as ended and the default form ran this.)

import std;

enum Kind
{
    Count(i32),
    Empty,
}

struct Entry
{
    Kind kind;
}

fn total(ref<Entry, exclusive> e) : i32
{
    match (&e.kind)
    {
        Kind::Count(n) : *n,
        Kind::Empty    : 0,
    }
}

fn bump(ref<Entry, exclusive> e) : i32
{
    i32 r = 0;
    match (&mut e.kind)
    {
        Kind::Count(n) :
        {
            *n += 1;
            r = total(e);
        },
        Kind::Empty    : {},
    }
    r
}

fn main()
{
    Entry e = Entry { .kind = Kind::Count(4) };
    printf("%v\n", bump(&mut e));
}
