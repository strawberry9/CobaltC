// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.resauth.destroy [Block-Exit], [Fault-Contain] (D-0315); conf.drop-flag-moved-in-one-branch
// kind: positive
// expect: ok
// expect-stdout-hex: 5b795d5b785d206f6b20310a5b785d5b795d206f6b20320a5b795d5b785d206661696c65640a5b785d5b795d206661696c65640a5b785d5b795d5b795d5b785d330a
//
// A local moved into a call on one branch only: where it was moved its
// destructor runs once, in the callee; where it was not, at the body's end
// or at a fault after the branch, last bound first.

import std;

resource struct Noisy
{
    String name;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("[%v]", &self.name);
}

fn make(StringView name) : Noisy
{
    Noisy { .name = String::copy(name) }
}

fn take(Noisy n) : usize
{
    StringView::len(&n.name)
}

fn branch(bool mv, u8 at) : usize
{
    Noisy x = make("x");
    Noisy y = make("y");
    usize n = 0;
    if (mv)
    {
        n = take(x);
    }
    assert(at != 1, "at 1");
    n + 1
}

fn main()
{
    foreach (at in [0: u8, 1])
    {
        foreach (mv in [false, true])
        {
            match (try_join(spawn(branch, mv, at)))
            {
                Ok(v)  : printf(" ok %v\n", v),
                Err(_) : printf(" failed\n"),
            }
        }
    }
    printf("%v\n", branch(true, 0) + branch(false, 0));
}
