// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (a result holding what ends with the frame, CHG-0438; D-0288); conf.move-closure-over-local-slice-through-call-dynamic
// kind: negative
// expect: diag.destroy-while-aliased (dynamic)
//
// The closure that captures a slice of the local `v` leaves `make` through
// a generic call (`id`) and through an early `return`: either way the
// result holds what the slice reaches, which ends with the frame. The
// program is not decided, and the run faults where `v` is destroyed.

import std;

fn id<T>(T x) : T
{
    x
}

fn make(bool early) : fn() : u8
{
    Vec<u8> v = Vec::filled(64, 7: u8);
    slice<u8, shared> s = &v[0 .. $];
    if (early)
    {
        return move [s]() { s[63] };
    }
    id(move [s]() { s[0] })
}

fn main()
{
    auto f = make(false);
    printf("%v\n", f());
}
