// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.stmt [Stmt-Exit] (D-0315); conf.stmt-temp-in-short-circuit
// kind: positive
// expect: ok
// expect-stdout-hex: 363120370a
//
// A temporary borrowed in the right operand of `&&` or `||` is made only when
// that operand is evaluated, and ends with its statement either way: a
// compiler that ends it with the statement must end it only where it was
// made.

import std;

fn label(usize i) : String
{
    sprintf("item-%v", i)
}

fn long(StringView s) : bool
{
    StringView::len(s) > 6
}

fn main()
{
    u64 both = 0;
    u64 either = 0;
    foreach (i in 0..12)
    {
        bool even = i % 2 == 0;
        if (even && long(&label(i)))
        {
            both += 1;
        }
        if (even || long(&label(i)))
        {
            either += 1;
        }
        bool b = !even && StringView::len(&label(i * 100)) > 7;
        if (b)
        {
            both += 10;
        }
    }
    printf("%v %v\n", both, either);
}
