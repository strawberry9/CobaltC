// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis (value-range row: literal-bound local; loop entry)
// kind: positive
// expect: ok
//
// A counter declared `= 0` is written on the loop's back edge (the
// step, or a write later in the body), so inside the body it is not
// literal-bound: `i - 1` behind `i > 0` must not be refuted from the
// declaration's 0 (CHG-0092).

import std;

fn main()
{
    array<i32, 5> a = [4, 8, 15, 16, 23];
    i32 rises = 0;
    for (usize i = 0; i < 5; i += 1)
    {
        if (i > 0 && a[i - 1] < a[i])
        {
            rises += 1;
        }
    }
    usize k = 0;
    usize last = 0;
    while (k < 5)
    {
        if (k > 0)
        {
            last = k - 1;
        }
        k += 1;
    }
    assert(rises == 4 && last == 3, "rises %v, last %v", rises, last);
}
