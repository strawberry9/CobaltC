// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis Forgetting; D-0236; conf.ref-copied-into-struct-then-reassigned
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// Reassigning `r` to `&mut y` forgets its fact on `x` (D-0236): `h` still
// holds the first path, so `x = 5` is checked and faults.

import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn main()
{
    i32 x = 0;
    i32 y = 0;
    auto r = &mut x;
    Hold h = Hold { .r = r };
    r = &mut y;
    *r = 1;
    x = 5;
    printf("%v\n", *h.r);
}
