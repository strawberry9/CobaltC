// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis Forgetting; D-0236; conf.ref-copied-into-struct-then-reassigned
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// Reassigning `r` to `&mut y` forgets its fact on `x` (D-0236): `h` still
// holds the first path, so `x = 5` is checked and faults.
//
// D-0290: the reference is stored by a call (`hold`), so the frame holds it
// only as `?` (it may hold none of it), and the run checks the access; the
// same program storing it directly is refuted before the run.

import std;

struct Hold
{
    ref<i32, exclusive> r;
}

fn hold(ref<i32, exclusive> r) : Hold
{
    Hold { .r = r }
}

fn main()
{
    i32 x = 0;
    i32 y = 0;
    auto r = &mut x;
    Hold h = hold(r);
    r = &mut y;
    *r = 1;
    x = 5;
    printf("%v\n", *h.r);
}
