// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis (value-range row: literal-bound local); rule.arith.checked [Arith-Checked-Overflow]; conf.literal-bound-local-overflow-static
// kind: negative
// expect: diag.arith-overflow (static)
//
// `x` is bound by its declaration to a literal and nothing writes,
// borrows or captures it before the addition, so the value-range
// condition is decided from the literals and refuted (CHG-0092).

fn main()
{
    u8 x = 200;
    u8 y = x + 100;
}
