// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (frame-held aggregates, D-0290); conf.vec-of-refs-holds-pushed-ref
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `v`, a `Vec<ref<i32, exclusive>>` of this frame, holds what is pushed onto
// it until its end: the run keeps the pushed reference's path until it is
// removed or `v` is destroyed. Writing `x` while `v` holds `&mut x` conflicts,
// and is found before the run (before D-0290 the run found it).

import std;

fn main()
{
    i32 x = 1;
    Vec<ref<i32, exclusive>> v = Vec::new();
    Vec::push(&mut v, &mut x);
    x = 2;
    printf("%v %v\n", x, Vec::len(&v));
}
