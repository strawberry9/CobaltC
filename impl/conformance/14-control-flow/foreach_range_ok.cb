// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.foreach; conf.foreach-range-output
// kind: positive
// expect: ok
// expect-stdout-hex: 31203220332034200a303a313020313a313120323a3132200a6c6f206869202d32202d312030200a746f207538206d61783a20350a3939203939203939200a3030203031203032203131203132203232200a
//
// `foreach` over an integer range (D-0097): literal and computed bounds,
// with and without the position; each bound evaluated once, `lo` first;
// a literal bound taking the other bound's type; a range ending at its
// type's largest value; an empty range; `continue` and `break`; and the
// value name a copy the loop does not read back.

import std;

fn bound(str which, i64 v) : i64
{
    printf("%s ", which);
    v
}

fn main() : u8
{
    foreach (v in 1..5)
    {
        printf("%d ", v);
    }
    printf("\n");
    foreach (i, v in 10..13)
    {
        printf("%d:%d ", i, v);
    }
    printf("\n");
    foreach (v in bound("lo", -2)..bound("hi", 1))
    {
        printf("%d ", v);
    }
    printf("\n");
    u8 top = 255;
    u32 n = 0;
    foreach (b in 250..top)
    {
        n += 1;
    }
    printf("to u8 max: %d\n", n);
    foreach (v in 5..2)
    {
        printf("never\n");
    }
    foreach (v in 0..10)
    {
        if (v == 1)
        {
            continue;
        }
        if (v == 4)
        {
            break;
        }
        v = 99;
        printf("%d ", v);
    }
    printf("\n");
    foreach (a in 0..3)
    {
        foreach (b in a..3)
        {
            printf("%d%d ", a, b);
        }
    }
    printf("\n");
    0
}
