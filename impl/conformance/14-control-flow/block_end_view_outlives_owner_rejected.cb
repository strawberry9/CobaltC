// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (a block's end, D-0287); conf.block-end-view-outlives-owner-rejected
// kind: negative
// expect: diag.destroy-while-aliased (static)
//
// `keep`, declared outside the block, is given a view of `text`, which
// the block declares and destroys at its end; `keep` is used after it.

import std;

fn main() : u8
{
    StringView keep = "";
    {
        String text = String::from_str("ab cd");
        StringView v = &text[0..$];
        keep = v;
    }
    printf("%s\n", keep);
    0
}
