// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (frame-held aggregates, D-0290); conf.struct-of-ref-copy-keeps-borrow
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// A struct with a reference field, made from `&mut x`, holds that borrow; a
// copy of it holds it too, and the original, copied rather than moved, still
// does. Writing `x` while `h`, used after, holds `&mut x` conflicts.

import std;

struct H
{
    ref<i32, exclusive> r;
}

fn main()
{
    i32 x = 1;
    H h = H { .r = &mut x };
    H h2 = h;
    x = 2;
    *h.r = 3;
    printf("%v\n", x);
}
