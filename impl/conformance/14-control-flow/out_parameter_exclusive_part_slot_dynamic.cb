// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (frame-held aggregates: the part-store summary of a callee given an argument exclusively, bug 014); conf.out-parameter-exclusive-part-slot
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// `set_it` is given `v` exclusively and stores into `*slot` a reference
// to an element of it, through `pass_on`, which hands both on. A callee
// given an argument exclusively is judged by the argument's own type
// unless its part-store summary says it may store a reference into a
// part of it: here it may, so after `pass_on(&mut r, &mut v)` `r` may
// refer into `v`, and clearing `v` while `r` is still used is the run's
// to find. It faults at the read through `r` (in the default form as with
// every check).

import std;

fn main()
{
    String other = "other";
    ref<String, shared> r = &other;
    Vec<String> v = Vec::new();
    Vec::push(&mut v, "a string that lives on the heap");
    pass_on(&mut r, &mut v, 3);
    Vec::clear(&mut v);
    printf("<%s>\n", r);
}

fn pass_on(ref<ref<String, shared>, exclusive> slot, ref<Vec<String>, exclusive> v, u32 n)
{
    if (n == 0)
    {
        set_it(slot, v);
    }
    else
    {
        pass_on(slot, v, n - 1);
    }
}

fn set_it(ref<ref<String, shared>, exclusive> slot, ref<Vec<String>, exclusive> v)
{
    *slot = &v[0];
}
