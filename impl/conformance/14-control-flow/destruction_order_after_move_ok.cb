// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.block [Block-Exit] (the frame's objects end last bound first, D-0008, D-0233); conf.destruction-order-after-move
// kind: positive
// expect: ok
// expect-stdout-hex: 6d6f7665640a64726f7020310a64726f7020320a
//
// A block ends its objects in reverse order of the bindings that hold
// them. `c = a` moves `a`'s object into `c`, a binding formed after `b`'s,
// so the object ends first, with `c`: ticket 1, then ticket 2. The
// object's own origin, before `b`'s, does not decide.

import std;

resource struct Ticket
{
    i32 id;
}

fn Ticket::drop(ref<Ticket, exclusive> self)
{
    printf("drop %v\n", self.id);
}

fn main()
{
    Ticket a = Ticket { .id = 1 };
    Ticket b = Ticket { .id = 2 };
    Ticket c = a;
    printf("moved\n");
}
