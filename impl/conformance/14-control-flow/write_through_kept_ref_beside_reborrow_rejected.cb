// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (frame-held aggregates, D-0290); conf.write-through-kept-ref-beside-reborrow
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// `r` borrows, through the reference `s` keeps, what that reference
// reaches. Writing through the kept reference again while `r` is live
// conflicts with `r`. The reference read out of `s` may be any `s` keeps,
// so the static pass leaves the access to the run, and the program is not
// decided.

import std;

struct S
{
    ref<i32, exclusive> inner;
}

fn main()
{
    i32 x = 1;
    S s = S { .inner = &mut x };
    auto r = &*s.inner;
    *s.inner = 5;
    printf("%v\n", *r);
}
