fn count_words(StringView text) : usize
{
    usize n = 0;
    foreach (raw in StringView::lines(text))
    {
        foreach (w in StringView::split_whitespace(raw))
        {
            n += StringView::len(w);
        }
    }
    n
}

fn main()
{
    match (read_rows("1 2 # c\n3 4\n"))
    {
        Ok(r)  : printf("%v rows\n", Vec::len(&r)),
        Err(e) : printf("%v\n", &e),
    }
    printf("%v\n", Vec::len(&Result::unwrap(read_rows8("1\n"))));
    printf("%v\n", count_words("ab cd\nefg\n"));
}
