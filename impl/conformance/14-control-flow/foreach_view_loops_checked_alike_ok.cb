// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.foreach (D-0042) over a view's parts (D-0287), nested, with a reference reassigned in the body; [Ref-Escape-Rejected] not applicable; conf.foreach-view-loops-checked-alike
// kind: positive
// expect: ok
// expect-stdout-hex: 3220726f77730a310a370a
//
// Eight functions of one shape: a `foreach` over `StringView::lines` of a
// parameter, a view reassigned to a part of the line, a nested `foreach`
// over a `Vec` of views, and a `return` from inside it. Nothing stores a
// reference past what it refers to, so the program is accepted, and it is
// accepted on every run. Before the session findings of 2026-11-06 the
// static pass's per-expression facts were keyed by the addresses of
// `foreach` expansions it had freed, so a later expression at a reused
// address took a stale referent and the program was rejected with
// `diag.reference-escapes-scope` in most runs, at the outer `foreach`.

import std;

fn find_char(StringView s, u8 c) : Option<usize>
{
    for (usize i = 0; i < StringView::len(s); i += 1)
    {
        if (StringView::as_bytes(s)[i] == c)
        {
            return Some(i);
        }
    }
    None
}

fn read_rows(StringView source) : Result<Vec<Vec<f64>>, String>
{
    Vec<Vec<f64>> rows = Vec::new();
    usize line_no = 0;
    foreach (line in StringView::lines(source))
    {
        line_no += 1;
        StringView body = line;
        Option<usize> hash = find_char(line, b'#');
        if (Some(k) = hash)
        {
            body = &line[0..k];
        }
        Vec<StringView> words = StringView::split_whitespace(body);
        if (Vec::len(&words) == 0)
        {
            continue;
        }
        Vec<f64> row = Vec::new();
        foreach (w in &words)
        {
            match (StringView::parse<f64>(*w))
            {
                Ok(v)  : Vec::push(&mut row, v),
                Err(_) : { return Err(sprintf("line %v: '%v' is not a number", line_no, *w)); },
            }
        }
        Vec::push(&mut rows, row);
    }
    Ok(rows)
}

