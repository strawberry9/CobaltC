// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.foreach-range [Foreach-Range-Inclusive]; conf.foreach-inclusive-range
// kind: positive
// expect: ok
// expect-stdout-hex: 3235362033323634300a303a3320313a3420323a352032353620323535203020350a
//
// `foreach (x in lo ..= hi)` visits `hi` too: every `u8` from 0 to 255
// without an overflow, `i8` from its least to its largest value, a range of
// variables, one value when `lo == hi` and none when `lo > hi`, the position
// with two names, and `continue`, which still steps.

import std;

fn main()
{
    u32 n = 0;
    u32 sum = 0;
    foreach (b in 0 ..= 255: u8)
    {
        n += 1;
        sum += widen<u32>(b);
    }
    printf("%v %v\n", n, sum);
    i32 m = 0;
    foreach (x in min_value<i8>() ..= max_value<i8>())
    {
        m += 1;
    }
    u8 lo = 3;
    u8 hi = 5;
    foreach (k, x in lo ..= hi)
    {
        printf("%v:%v ", k, x);
    }
    u8 top = 255;
    u8 last = 0;
    foreach (x in top ..= top)
    {
        last = x;
    }
    u32 none = 0;
    foreach (x in hi ..= lo)
    {
        none += 1;
    }
    u32 odd = 0;
    foreach (x in 1 ..= 9)
    {
        if (x % 2 == 0)
        {
            continue;
        }
        odd += 1;
    }
    printf("%v %v %v %v\n", m, last, none, odd);
}
