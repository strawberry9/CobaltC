// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references; D-0288; conf.result-ref-assigned-after-declaration
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// A `Result` of a reference assigned in a loop, after its declaration, from
// the elements a `foreach` walks, under an `if`: it may borrow the vector
// (its facts are `?`), which is then cleared while the `Result` is used. The
// run decides, so the program is not decided and its default form keeps the
// check (bug 008: it was decided, and read the freed `String`).

import std;

fn main()
{
    Vec<String> v = Vec::new();
    foreach (i in 0..3)
    {
        Vec::push(&mut v, sprintf("item %v padded padded padded", i));
    }
    Result<ref<String, shared>, u8> best = Err(0);
    foreach (s in &v)
    {
        if (StringView::len(s) > 10)
        {
            best = Ok(s);
        }
    }
    Vec::clear(&mut v);
    match (best)
    {
        Ok(b)  : printf("<%s>\n", b),
        Err(_) : {},
    }
}
