// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (the call-site rule, rule 2; D-0288); conf.closure-argument-reads-sorted-vec-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `Vec::sort_by` takes `v` exclusively, and its comparator, a closure
// written in the call, reads `v` through its capture: a read of what
// argument 1 reaches exclusively, in either order of the arguments.

import std;

fn main()
{
    Vec<u32> v = Vec::from_slice(&[3: u32, 1, 2]);
    Vec::sort_by(&mut v, [v](ref<u32, shared> a, ref<u32, shared> b) { (v[0] < 100) && *a < *b });
    printf("%v %v %v\n", v[0], v[1], v[2]);
}
