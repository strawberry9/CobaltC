// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.foreach (D-0315); conf.foreach-by-value-memory-only
// kind: positive
// expect: ok
// expect-stdout-hex: 2d3120657272206e656761746976650a3020746f74616c20300a3120746f74616c20320a3220746f74616c20340a3320746f74616c20360a34206572722073746f702061742077330a35206572722073746f702061742077330a36206572722073746f702061742077330a7731300a6e6f6e650a7365656e20320a
//
// `foreach` by value over a local vector and over a map whose elements free
// memory alone, left early by `?`, `break` and `return`: each element taken
// arrives whole, and the ones not taken end with the loop.

import std;

fn words(i64 n) : Result<Vec<String>, String>
{
    if (n < 0)
    {
        return Err("negative");
    }
    Vec<String> v = Vec::new();
    for (i64 i = 0; i < n; i += 1)
    {
        Vec::push(&mut v, sprintf("w%v", i));
    }
    Ok(v)
}

fn check(String w) : Result<usize, String>
{
    if (w == "w3")
    {
        return Err(sprintf("stop at %v", &w));
    }
    Ok(StringView::len(&w))
}

fn total(i64 n) : Result<usize, String>
{
    Vec<String> ws = words(n)?;
    usize t = 0;
    foreach (w in ws)
    {
        t += check(w)?;
    }
    Ok(t)
}

fn first_long(i64 n) : String
{
    Vec<String> ws = match (words(n))
    {
        Ok(v)  : v,
        Err(_) : Vec::new(),
    };
    foreach (w in ws)
    {
        if (StringView::len(&w) > 2)
        {
            return w;
        }
    }
    "none"
}

fn main()
{
    for (i64 n = -1; n < 7; n += 1)
    {
        match (total(n))
        {
            Ok(t)  : printf("%v total %v\n", n, t),
            Err(e) : printf("%v err %v\n", n, &e),
        }
    }
    printf("%v\n", &first_long(15));
    printf("%v\n", &first_long(3));
    HashMap<String, Vec<String>> m = HashMap::new();
    HashMap::insert(&mut m, "a", Vec::new());
    HashMap::insert(&mut m, "b", Vec::new());
    HashMap::insert(&mut m, "c", Vec::new());
    usize seen = 0;
    foreach (k, v in m)
    {
        seen += StringView::len(&k) + Vec::len(&v);
        if (k == "b")
        {
            break;
        }
    }
    printf("seen %v\n", seen);
}
