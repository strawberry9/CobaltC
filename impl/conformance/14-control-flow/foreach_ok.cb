// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.foreach; conf.foreach-output
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// Every form of `foreach` over every collection: a Vec read, indexed,
// consumed (each String moved into a function) and changed in place; an
// array by reference, in place and by value; a HashMap changed in place,
// read and consumed; a HashSet read and consumed; and a consuming loop
// left by `break`, whose remaining elements are destroyed once, at
// the loop's end.

import std;

resource struct Tag
{
    str name;
}

fn Tag::drop(ref<Tag, exclusive> self)
{
    printf("drop %s\n", self.name);
}

fn take(String s)
{
    printf("took %s\n", &s);
}

fn main()
{
    Vec<String> names = Vec::new();
    Vec::push(&mut names, String::from_str("ada"));
    Vec::push(&mut names, String::from_str("lin"));
    foreach (name in &names)
    {
        printf("Name: %s\n", name);
    }
    foreach (i, name in &names)
    {
        printf("%d: %s\n", i, name);
    }
    foreach (name in names)
    {
        take(name);
    }

    Vec<i32> numbers = Vec::new();
    for (i32 k = 1; k <= 4; k += 1)
    {
        Vec::push(&mut numbers, k);
    }
    foreach (n in &mut numbers)
    {
        *n *= 2;
    }
    foreach (n in &numbers)
    {
        printf("%d ", *n);
    }
    printf("\n");

    array<i32, 3> a = [5, 6, 7];
    foreach (i, x in &a)
    {
        printf("a[%d]=%d ", i, *x);
    }
    foreach (x in &mut a)
    {
        *x += 100;
    }
    foreach (x in a)
    {
        printf("%d ", x);
    }
    printf("\n");

    HashMap<String, i32> ages = HashMap::new();
    HashMap::insert(&mut ages, String::from_str("ada"), 36);
    HashMap::insert(&mut ages, String::from_str("lin"), 29);
    foreach (k, v in &mut ages)
    {
        *v += 1;
    }
    foreach (k, v in &ages)
    {
        printf("%s=%d ", k, *v);
    }
    foreach (k, v in ages)
    {
        printf("[%s %d]", &k, v);
    }
    printf("\n");

    HashSet<u8> s = HashSet::new();
    HashSet::insert(&mut s, 3);
    HashSet::insert(&mut s, 9);
    foreach (i, x in &s)
    {
        printf("s%d=%d ", i, *x);
    }
    foreach (x in s)
    {
        printf("<%d>", x);
    }
    printf("\n");

    // break leaves the rest destroyed once
    Vec<Tag> tags = Vec::new();
    Vec::push(&mut tags, Tag { .name = "t1" });
    Vec::push(&mut tags, Tag { .name = "t2" });
    Vec::push(&mut tags, Tag { .name = "t3" });
    foreach (t in tags)
    {
        printf("got %s\n", t.name);
        if (true)
        {
            break;
        }
    }
    printf("end\n");
}
