// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.block (a temporary ends with its statement, D-0103); a match arm's bindings end with the arm (D-0008); CHG-0391; conf.nested-match-arm-temporaries-end
// kind: positive
// expect: ok
// expect-stdout-hex: 6e0a
//
// A `match` that is an arm's whole value is the arm's last evaluation, as a
// block's tail `match` is: the view of `hh.name` made for `sprintf` is a
// temporary of the inner arm's statement, so it ends before `hh` does, at
// the inner arm's end. Before CHG-0391 a compiled program that keeps its
// paths (`note` below makes it keep them: a reference beside a temporary the
// frame does not hold) left the view to the outer arm's statement, which
// outlives `hh`, and faulted `diag.destroy-while-aliased` at the arm's end.

import std;

struct Body
{
    Option<String> left;
}

struct Holder
{
    String name;
}

fn holder_of(ref<Body, shared> b, StringView n) : Option<Holder>
{
    Some(Holder { .name = String::from_view(n) })
}

fn left(ref<Body, exclusive> b, String why)
{
    b.left = Some(why);
}

fn nested_form(ref<Body, exclusive> b, bool k)
{
    match (k)
    {
        true : match (holder_of(b, "n"))
        {
            Some(hh) : left(b, sprintf("%s", String::as_view(&hh.name))),
            None     : {},
        },
        false : {},
    }
}

fn note(ref<String, shared> t, ref<HashSet<String>, exclusive> out)
{
    HashSet::insert(out, String::clone(t));
}

fn main() : u8
{
    String s0 = String::from_str("x");
    note(&s0, &mut HashSet::new());
    Body b = Body { .left = None };
    nested_form(&mut b, true);
    match (&b.left)
    {
        Some(w) : printf("%s\n", w),
        None    : printf("none\n"),
    }
    0
}
