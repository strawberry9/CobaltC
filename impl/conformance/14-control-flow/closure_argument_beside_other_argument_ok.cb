// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (the call-site rule; D-0288); conf.closure-argument-beside-other-argument
// kind: positive
// expect: ok
// decided: yes
//
// A closure written as an argument that captures bindings the other
// arguments do not reach, or reads one another argument reaches only
// shared, conflicts with nothing: the program is decided.

import std;

fn apply(ref<Vec<u32>, exclusive> v, fn(u32) : u32 f)
{
    for (usize i = 0; i < Vec::len(v); i += 1)
    {
        v[i] = f(v[i]);
    }
}

fn count(ref<Vec<u32>, shared> v, fn(u32) : bool keep) : usize
{
    usize n = 0;
    for (usize i = 0; i < Vec::len(v); i += 1)
    {
        if (keep(v[i]))
        {
            n += 1;
        }
    }
    n
}

fn main()
{
    Vec<u32> v = Vec::from_slice(&[3: u32, 1, 2]);
    u32 k = 10;
    apply(&mut v, [k](u32 x) { x + k });
    Vec::sort_by(&mut v, [k](ref<u32, shared> a, ref<u32, shared> b) { *a + k < *b + k });
    assert(count(&v, [v](u32 x) { x > v[0] }) == 2);
    assert(v[0] == 11 && v[1] == 12 && v[2] == 13);
}
