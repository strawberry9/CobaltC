// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.frame-references (point checks at the call); [Slice-Form]; D-0283; conf.point-check-empty-view
// kind: positive
// expect: ok
// expect-stdout-hex: 6162630a630a
//
// `String::append(&mut s, String::view(&s, k, k))` with `k` computed: the
// view is empty and reaches none of `s`, so the point check at the call
// passes (D-0283) and the append adds nothing.

import std;

fn main() : u8
{
    String s = String::from_str("abc");
    usize k = String::len(&s) - 1;
    String::append(&mut s, String::view(&s, k, k));
    printf("%v\n", &s);
    StringView w = String::view(&s, k, k + 1);
    printf("%v\n", w);
    0
}
