// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.flow-analysis; rule.init.definite-assignment; conf.definite-assignment-missing-branch
// kind: negative
// expect: diag.use-of-uninitialized (static)
//
// `init(x)` is T on the then-edge and F on the fall-through edge, so it
// joins to `?` at the merge; definite assignment is the one rule where
// `unknown` rejects rather than deferring to a run-time check -- and it
// does so whatever `c` happens to be at run time.

fn main()
{
    bool c = true;
    i32 x;
    if (c)
    {
        x = 1;
    }
    i32 y = x;
}
