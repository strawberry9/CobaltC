// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.foreach (D-0200: chars, split_whitespace); conf.fused-text-loops
// kind: positive
// expect: ok
// expect-stdout-hex: 3520776f7264732031342062797465730a3134206f6e652d627974652063686172730a320a300a
//
// `foreach` over `chars` and `split_whitespace` of a `String` and of a
// `StringView`: empty text, text of only spaces, multi-byte characters,
// `break` and `continue` in the body, a nested loop, and the pieces' lengths.

import std;

fn main()
{
    String s = String::from_str("  a bc\tdéf\n日本  x ");
    usize n = 0;
    usize bytes = 0;
    foreach (w in String::split_whitespace(&s))
    {
        n += 1;
        bytes += StringView::len(w);
    }
    printf("%v words %v bytes\n", n, bytes);
    usize c = 0;
    foreach (ch in String::chars(&s))
    {
        if (StringView::len(ch) > 1)
        {
            continue;
        }
        c += 1;
    }
    printf("%v one-byte chars\n", c);
    StringView v = StringView::of("x y z w");
    usize k = 0;
    foreach (w in StringView::split_whitespace(v))
    {
        if (k == 2)
        {
            break;
        }
        foreach (ch in StringView::chars(w))
        {
            k += StringView::len(ch);
        }
    }
    printf("%v\n", k);
    usize e = 0;
    foreach (w in StringView::split_whitespace(StringView::of("   ")))
    {
        e += 1;
    }
    foreach (ch in StringView::chars(StringView::of("")))
    {
        e += 1;
    }
    printf("%v\n", e);
}
