// CONFORMANCE-CASE
// spec: 14-control-flow
// facility: rule.control.block [Ref-Binding-Last-Use] (D-0275, CHG-0365): a reference to reference-free storage does not defer an end; conf.ref-binding-end-not-deferred-by-plain-reference
// kind: positive
// expect: ok
// stdout: 3
// stdout: 4
//
// `r` shares its declaring statement with `log`, which is mentioned again,
// but `log` is a reference to a `Vec<i32>`: nothing it reaches can hold a
// reference, and the statement does not rebind it, so it cannot hold `r`'s
// path. `r` ends after its last mention, and `take` destroys the Box `r`
// pointed into with no reference to it live. Before D-0275 `r` lived to the
// block's exit and the Box's destruction faulted `diag.destroy-while-aliased`.

import std;

struct Holder
{
    Box<String> b;
}

fn take(Holder h) : usize
{
    1
}

fn run(ref<Vec<i32>, exclusive> log, Holder h, bool early) : usize
{
    ref<String, shared> r = if (!early) { Box::get(&h.b) } else
    {
        Vec::push(log, 1);
        return 0;
    };
    usize n = String::len(r);
    printf("%v\n", n);
    usize k = take(h);
    Vec::push(log, 2);
    n + k
}

fn main()
{
    Vec<i32> log = Vec::new();
    Holder h = Holder { .b = Box::new(String::from_str("abc")) };
    printf("%v\n", run(&mut log, h, false));
}
