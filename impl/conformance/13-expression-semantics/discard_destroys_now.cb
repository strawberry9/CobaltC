// CONFORMANCE-CASE
// spec: 13-expression-semantics
// facility: rule.expr.seq [Discard] (D-0099)
// kind: positive
// expect: ok
// expect-stdout-hex: 6d616b650a64726f700a6166746572206469736361726420310a656e640a
//
// `_ = e;` ends the value at once: its destructor runs before the next
// statement (the output is "make", "drop", "after discard 1", "end").

import std;

resource struct Noisy
{
    i32 n;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("drop\n");
}

fn make() : Result<Noisy, str>
{
    printf("make\n");
    Ok(Noisy { .n = 1 })
}

fn main()
{
    _ = make();
    printf("after discard %d\n", 1);
    printf("end\n");
}
