// CONFORMANCE-CASE
// spec: 13-expression-semantics
// facility: rule.expr.lvalue-to-rvalue [LValue-To-RValue]; rule.fn.call [Call]; D-0007; conf.eval-order-reads
// kind: positive
// expect: ok
// expect-stdout-hex: 31322031340a3131203120330a
//
// A place in value position is read when it is evaluated, before the
// arguments (or fields) to its right run: a later argument that writes the
// same variable or element does not change what was passed. Covers a
// function call, a closure call, an element argument and struct literal
// fields.

import std;

struct Pair
{
    i32 a;
    i32 b;
}

fn two(i32 a, i32 b) : i32
{
    a * 10 + b
}

fn main()
{
    i32 x = 1;
    i32 f = two(x, {
        x = 5;
        2
    });
    x = 1;
    auto c = [](i32 a, i32 b) { a * 10 + b };
    i32 g = c(x, {
        x = 9;
        4
    });
    printf("%v %v\n", f, g);
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    i32 h = two(v[0], {
        v[0] = 8;
        1
    });
    x = 1;
    Pair p = Pair { .a = x, .b = {
        x = 7;
        3
    } };
    printf("%v %v %v\n", h, p.a, p.b);
}
