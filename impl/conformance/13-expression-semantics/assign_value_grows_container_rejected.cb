// CONFORMANCE-CASE
// spec: 13-expression-semantics
// facility: D-0007 (the place before the value), rule.control.frame-references (D-0282, D-0284); conf.assign-value-grows-container-rejected
// kind: negative
// expect: diag.stale-binding (static)
//
// The place `v[0]` is found before the value is computed. The value, a
// struct literal, takes `v` exclusively in one of its fields, which may
// move the place: rejected before the run, as `v[0].x = grow(&mut v)` is.

import std;

struct P
{
    i64 x;
    i64 y;
}

fn grow(ref<Vec<P>, exclusive> v) : i64
{
    Vec::push(v, P { .x = 0, .y = 0 });
    7
}

fn main()
{
    Vec<P> v = Vec::new();
    Vec::push(&mut v, P { .x = 1, .y = 2 });
    v[0] = P { .x = grow(&mut v), .y = 0 };
    printf("%v\n", v[0].x);
}
