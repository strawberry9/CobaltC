// CONFORMANCE-CASE
// spec: 13-expression-semantics
// facility: D-0007 (strict left-to-right evaluation order)
// kind: positive
// expect: ok
//
// Sub-expressions of a compound expression evaluate strictly left to
// right; a side effect in the left operand is visible to the right
// operand's own evaluation.

fn bump(ref<i32, exclusive> counter) : i32
{
    *counter = *counter + 1;
    *counter
}

fn main()
{
    i32 counter = 0;
    i32 left = bump(&mut counter);
    i32 right = bump(&mut counter);
    if (left != 1)
    {
        1 / (1 - 1);
    }
    if (right != 2)
    {
        1 / (1 - 1);
    }
}
