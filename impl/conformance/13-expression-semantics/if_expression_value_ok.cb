// CONFORMANCE-CASE
// spec: 13-expression-semantics
// facility: rule.type.typing [T-If]
// kind: positive
// expect: ok
//
// `if` is an expression: both arms must agree on type, and the whole
// construct produces the taken arm's value.

fn main()
{
    bool c = true;
    i32 x = if (c)
    {
        1
    }
    else
    {
        2
    };
    if (x != 1)
    {
        1 / (1 - 1);
    }
}
