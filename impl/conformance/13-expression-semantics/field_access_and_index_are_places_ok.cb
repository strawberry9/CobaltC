// CONFORMANCE-CASE
// spec: 13-expression-semantics
// facility: rule.type.typing [T-Field], [T-Index]
// kind: positive
// expect: ok
//
// A struct field and an array element are both places: writable
// through direct assignment, not merely readable.

struct Pair
{
    i32 a;
    array<i32,3> items;
}

fn main()
{
    Pair p = Pair { .a = 1, .items = [10, 20, 30] };
    p.a = 99;
    p.items[1] = 200;
    if (p.a != 99)
    {
        1 / (1 - 1);
    }
    if (p.items[1] != 200)
    {
        1 / (1 - 1);
    }
}
