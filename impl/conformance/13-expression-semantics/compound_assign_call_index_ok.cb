// CONFORMANCE-CASE
// spec: 13-expression-semantics
// facility: [Compound-Assign] (D-0035); conf.compound-assign-call-index
// kind: positive
// expect: ok
// expect-stdout-hex: 343020313020372032310a35203220332031340a3920300a340a
//
// `v[f(x)] op= e` on a local `Vec`: the target holds a call, so it is
// reached once, through a hidden exclusive reference; the right-hand side
// a literal, a local, or an expression. Also an element's field, a nested
// `Vec`, and a `Vec` reached through a reference parameter.

import std;

struct Point
{
    i64 x;
    i64 y;
}

fn k(usize i) : usize
{
    i
}

fn bump(ref<Vec<u64>, exclusive> v)
{
    (*v)[k(1)] += 1;
    u64 z = 2;
    (*v)[k(1)] *= z;
}

fn main()
{
    Vec<u64> counts = Vec::filled(4, 0: u64);
    for (u64 n = 0; n < 40; n += 1)
    {
        counts[narrow<usize>(n % 4)] += 1;
    }
    u64 d = 3;
    counts[k(2)] -= d;
    counts[k(3)] += counts[k(0)] + 1;
    u32 s = 2;
    counts[k(0)] <<= s;
    printf("%v %v %v %v\n", counts[0], counts[1], counts[2], counts[3]);

    Vec<Point> ps = Vec::new();
    Vec::push(&mut ps, Point { .x = 1, .y = 2 });
    Vec::push(&mut ps, Point { .x = 3, .y = 4 });
    ps[k(1)].y += 10;
    i64 m = 5;
    ps[k(0)].x *= m;
    printf("%v %v %v %v\n", ps[0].x, ps[0].y, ps[1].x, ps[1].y);

    Vec<Vec<u64>> grid = Vec::new();
    Vec::push(&mut grid, Vec::filled(3, 0: u64));
    Vec::push(&mut grid, Vec::filled(3, 0: u64));
    grid[k(1)][k(2)] += 9;
    printf("%v %v\n", grid[1][2], grid[0][2]);

    Vec<u64> w = Vec::filled(3, 1: u64);
    bump(&mut w);
    printf("%v\n", w[1]);
}
