// CONFORMANCE-CASE
// spec: 13-expression-semantics
// facility: [Eq-Enum] (`==` on an enum key type); rule.type.expected (the other operand's type fixes a payloadless variant's type arguments); conf.eq-against-untyped-variant
// kind: positive
// expect: ok
// expect-stdout-hex: 747275652066616c73650a7472756520747275650a7472756520747275652066616c73650a
//
// `f(0) == Err(Bad)`, `o == None` and `None == o`: a variant with no
// payload to type it takes its type arguments from the other operand,
// whichever side it is on, for a plain `Option<usize>` and for a resource
// (`Option<String>`, an error enum with a `String` variant), compared where
// it stands. (Before the session findings of 2026-11-06 `cobc` stopped with
// an internal error, "cannot infer type arguments", on each resource form
// and on a variant on the left.)

import std;

enum E
{
    Bad,
    Carry(String),
}

fn f(usize n) : Result<usize, E>
{
    if (n == 0)
    {
        return Err(Bad);
    }
    Ok(n)
}

fn g(bool some) : Option<String>
{
    if (some)
    {
        return Some(String::copy("x"));
    }
    None
}

fn main()
{
    Option<usize> o = None;
    printf("%v %v\n", f(0) == Err(Bad), f(1) == Err(Bad));
    printf("%v %v\n", o == None, None == o);
    printf("%v %v %v\n", g(false) == None, None != g(true), g(true) == None);
}
