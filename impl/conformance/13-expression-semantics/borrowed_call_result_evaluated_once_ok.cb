// CONFORMANCE-CASE
// spec: 13-expression-semantics
// facility: D-0073 (a temporary borrowed as a call's argument is an object of the statement); rule.expr.seq (each operand evaluated once, in order); conf.borrowed-call-result-evaluated-once
// kind: positive
// expect: ok
// expect-stdout-hex: 74616b650a320a
//
// `Vec::len(&take(p))`: the call is evaluated once, its result borrowed for
// `len`. `take` prints each time it runs and consumes `p`, which a second
// evaluation would find moved. (Before the fix, found while checking the
// session findings of 2026-11-06, `cobc` evaluated the call twice there:
// it printed `take` twice and the second faulted `diag.stale-binding`.)

import std;

struct Parser
{
    String pattern;
    Vec<usize> prog;
}

fn take(Parser p) : Vec<usize>
{
    printf("take\n");
    Parser { prog, .. } = p;
    prog
}

fn main()
{
    Vec<usize> v = Vec::new();
    Vec::push(&mut v, 3);
    Vec::push(&mut v, 4);
    Parser p = Parser { .pattern = "ab", .prog = v };
    printf("%v\n", Vec::len(&take(p)));
}
