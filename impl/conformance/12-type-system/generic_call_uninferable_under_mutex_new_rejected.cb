// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.fn.generic-call [Generic-Call-Uninferable] (an argument of `Mutex::new<T>`)
// kind: negative
// expect: diag.cannot-infer-type-parameter (static)
//
// `Mutex::new<T>(T v)` is an ordinary generic call: with `auto`, no
// expected type reaches it, so its parameter gives `Vec::new()` none
// either, and nothing else fixes `Vec`'s T.

import std;

fn main()
{
    auto m = Mutex::new(Vec::new());
}
