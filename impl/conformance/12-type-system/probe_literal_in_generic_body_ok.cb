// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.probe (D-0312); rule.type.coerce-text [Coerce-Text]; conf.probe-literal-in-generic-body
// kind: positive
// expect: ok
// expect-stdout-hex: 31313120310a
//
// In a generic body whose map has a `String` key and an open value type, a
// lookup by a literal, a `str` or `&s` takes the key's probe, a view, as it
// does outside generic code. Before CHG-0416 the literal was judged against
// the declared `probe<K>` and refused.

import std;

fn has<V>(ref<HashMap<String, V>, shared> m, str k, ref<String, shared> s) : u32
{
    u32 n = 0;
    if (HashMap::contains(m, "one")) { n += 1; }
    if (HashMap::contains(m, k)) { n += 10; }
    if (Option::is_some(&HashMap::get(m, s))) { n += 100; }
    n
}

fn main()
{
    HashMap<String, i32> m = HashMap::new();
    HashMap::insert(&mut m, "one", 1);
    HashMap::insert(&mut m, "two", 2);
    String two = "two";
    HashMap<String, bool> f = HashMap::new();
    HashMap::insert(&mut f, "one", true);
    printf("%v %v\n", has(&m, "two", &two), has(&f, "two", &two));
}
