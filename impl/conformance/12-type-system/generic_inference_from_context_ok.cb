// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.fn.generic-call [Generic-Call-Inferred], [Generic-Call-Expected-Type]; rule.type.expected
// kind: positive
// expect: ok
//
// Every route to a type argument: an explicit list, an argument's
// shape, the declared type of the receiving binding, a field type
// inside a struct literal, a nested generic call whose own T is
// fixed only once the enclosing call's argument shapes are known, and
// `Mutex::new<T>`'s parameter, fixed by the binding's `mutex<τ>` and
// passed on to the argument (a nested generic call, or a literal).

import std;

struct Box<T>
{
    T value;
}

fn boxed<T>(T x) : Box<T>
{
    Box { .value = x }
}

fn id<T>(T x) : T
{
    x
}

fn main()
{
    Vec<i32> a = Vec::new();
    i64 w = id<i64>(3);
    auto s = id(5);
    Box<Vec<u8>> c = boxed(Vec::new());
    Vec<Vec<i32>> vv = Vec::new();
    Vec::push(&mut vv, Vec::new());
    mutex<Vec<u8>> m = Mutex::new(Vec::new());
    mutex<i64> big = Mutex::new(5000000000);
    Box<i32> b = Box { .value = id(7) };
    if (w != 3 || s != 5 || b.value != 7)
    {
        1 / (1 - 1);
    }
    if (Vec::len(&a) + Vec::len(&c.value) + Vec::len(&vv) != 1)
    {
        1 / (1 - 1);
    }
}
