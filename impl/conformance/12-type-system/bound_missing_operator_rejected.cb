// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.bound [Bound-Missing] (D-0090); conf.bound-missing-rejected
// kind: negative
// expect: diag.unbounded-type-parameter (static)
//
// `ordered` gives comparisons, not arithmetic: `+` needs `number`.

fn add<T: ordered>(T a, T b) : T
{
    a + b
}

fn main()
{
    add(1, 2);
}
