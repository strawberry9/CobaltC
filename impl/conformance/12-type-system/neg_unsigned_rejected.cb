// CONFORMANCE-CASE
// spec: 12-type-system
// facility: [T-Neg] (conf.neg-unsigned-rejected)
// kind: negative
// expect: diag.type-mismatch (static)
//
// Unary minus needs a signed or float operand. On an unsigned value it
// is ill-typed, whatever the value, rather than an overflow found at
// run time.

fn ng(u8 m) : u8
{
    -m
}

fn main()
{
    ng(0);
}
