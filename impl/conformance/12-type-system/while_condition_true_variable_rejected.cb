// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.typing [T-While] [T-While-Forever] (D-0175); conf.while-true-literal-only
// kind: negative
// expect: diag.type-mismatch (static)
//
// Only the literal `true` makes a loop that never completes: a condition
// that is merely always true at run time does not, so the function's
// value is missing.

import std;

fn f() : i32
{
    bool forever = true;
    while (forever)
    {
        return 1;
    }
}

fn main()
{
    printf("%v\n", f());
}
