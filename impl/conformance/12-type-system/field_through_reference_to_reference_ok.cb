// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.agg.field `[Field-Access-Auto-Deref]` (D-0312, found implementing it): a field read through a reference to a reference, a binder of `match (&o)` with `o` an `Option<ref<S>>`, is typed, and its text viewed where a view is declared; conf.field-through-reference-to-reference
// kind: positive
// expect: ok
// expect-stdout-hex: 747275650a
//

import std;

struct Sk
{
    Option<String> ov;
}

struct X
{
    HashSet<String> raw_sinks;
}

fn f(bool d, ref<X, exclusive> x, Option<ref<Sk, shared>> sink) : bool
{
    bool raw_sink = d && match (&sink)
    {
        Some(sk) : match (&sk.ov)
        {
            Some(o) : HashSet::contains(&x.raw_sinks, o),
            None    : false,
        },
        None : false,
    };
    raw_sink
}

fn main()
{
    X x = X { .raw_sinks = HashSet::new() };
    HashSet::insert(&mut x.raw_sinks, "a");
    Sk s = Sk { .ov = Some("a") };
    printf("%v\n", f(true, &mut x, Some(&s)));
}
