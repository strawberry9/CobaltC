// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.bound `clone-holds`, rule.agg.derived-clone (D-0116); conf.clone-field-not-clone-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// A struct is `clone` only if every field is: `Owner` holds a `Handle`
// with no clone, so `Owner` has none either; the message names the field.

import std;

resource struct Handle { u32 fd; }
fn Handle::drop(ref<Handle, exclusive> self)
{
}
struct Owner { String name; Handle h; }

fn main()
{
    Owner o = Owner { .name = String::new(), .h = Handle { .fd = 1 } };
    Owner o2 = clone(&o);
}
