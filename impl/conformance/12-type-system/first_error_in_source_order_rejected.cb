// CONFORMANCE-CASE
// spec: 12-type-system
// facility: the diagnostic registry's reporting order (CHG-0130); conf.first-error-in-source-order-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// Of a program's static errors, the one earliest in the source is
// reported: `helper`'s type mismatch comes before `main`'s use of a
// moved binding, whichever function a checker reaches first.

import std;

fn helper() : i32
{
    i32 x = true;
    x
}

fn main()
{
    String s = String::new();
    String t = s;
    printf("%s %v\n", &s, helper());
}
