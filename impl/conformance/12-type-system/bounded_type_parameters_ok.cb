// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.bound [T-Bound-Op], [T-Bound-Literal] (D-0090); conf.bound-ordered, conf.bound-number-literal-float
// kind: positive
// expect: ok
//
// Each built-in bound gives a type parameter the operators its types
// share: `ordered` comparisons, `number` arithmetic and literals (a
// float one at a floating-point type), `integer` bitwise operators, `eq`
// equality; a generic caller passes its own bound on to a callee whose
// bound it implies.

import std;

fn largest<T: ordered>(slice<T, shared> xs) : T
{
    T best = xs[0];
    foreach (x in xs)
    {
        if (*x > best) { best = *x; }
    }
    best
}

fn smallest<T: ordered>(slice<T, shared> xs) : T
{
    T best = xs[0];
    foreach (x in xs)
    {
        if (*x < best) { best = *x; }
    }
    best
}

fn total<T: number>(slice<T, shared> xs) : T
{
    T sum = 0;
    foreach (x in xs)
    {
        sum += *x;
    }
    sum
}

fn span<T: number>(slice<T, shared> xs) : T
{
    largest(xs) - smallest(xs)
}

fn bits<T: integer>(T x) : u32
{
    T v = x;
    u32 n = 0;
    while (v != 0)
    {
        v = v & (v - 1);
        n += 1;
    }
    n
}

fn count<T: eq>(slice<T, shared> xs, T v) : usize
{
    usize n = 0;
    foreach (x in xs)
    {
        if (*x == v) { n += 1; }
    }
    n
}

fn main() : u8
{
    array<i32, 4> a = [3, -7, 12, 12];
    array<f64, 3> f = [1.5, -2.25, 9.0];
    array<bool, 3> b = [true, false, true];
    if (largest(&a[0..$]) != 12 || largest(&f[0..$]) != 9.0) { return 1; }
    if (total(&a[0..$]) != 20 || total(&f[0..$]) != 8.25) { return 2; }
    if (span(&a[0..$]) != 19 || span(&f[0..$]) != 11.25) { return 3; }
    if (bits(255: u8) != 8 || bits(1024: u32) != 1) { return 4; }
    if (count(&a[0..$], 12) != 2 || count(&b[0..$], true) != 2) { return 5; }
    0
}
