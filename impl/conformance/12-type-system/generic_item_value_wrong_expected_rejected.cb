// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.typing [T-Item-Generic]; D-0093; conf.generic-item-value-wrong-expected
// kind: negative
// expect: diag.type-mismatch (static)
//
// The expected fn type instantiates a generic item ([T-Item-Generic]),
// and the instantiation must equal it: with `T := i32`, `id` is
// `fn(i32) : i32`, never `fn(i32) : bool`.

fn id<T>(T x) : T
{
    x
}

fn main()
{
    fn(i32) : bool f = id;
    f(1);
}
