// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.typing [T-Enum] (CHG-0438): a variant qualified by another enum; conf.variant-qualifier-other-enum
// kind: negative
// expect: diag.type-mismatch (static)
//
// `B::Z` is a variant of `B`, so it is not an `A`. The checker took the
// variant by its last name alone and accepted it; `coby` printed `Z`'s
// position in `A` and `cobc` wrote C that does not compile.

import std;

enum A
{
    X,
    Y,
}

enum B
{
    X,
    Z,
}

fn main()
{
    A a = B::Z;
    printf("%v\n", a);
}
