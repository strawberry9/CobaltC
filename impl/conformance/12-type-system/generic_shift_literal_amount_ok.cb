// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.kind (D-0090), [T-Shift] (CHG-0439): a literal shift amount on a `T: integer`; conf.generic-shift-literal-amount
// kind: positive
// expect: ok
// stdout: 155 315 30
//
// A literal amount takes the shifted operand's type, as `x >> 3` does on a
// concrete integer; it was rejected with empty type names.

import std;

fn z<T: integer>(T a, u32 n) : T
{
    (a >> 3) + (a >> n) - (a & 0)
}

fn main()
{
    printf("%v %v %v\n", z(248: u8, 1), z(504: i64, 1), z(48: u16, 1));
}
