// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.typing [T-While-Forever] (D-0175); conf.while-true-never
// kind: positive
// expect: ok
// expect-stdout-hex: 3420332034300a
//
// A `while (true)` that no `break` leaves never completes: its type is
// `never`, so a function may end with it and needs no value after it.
// A `break` belonging to an inner loop does not count; code after a loop
// that a `break` does leave runs as before.

import std;

fn first_even(ref<Vec<i32>, shared> v) : i32
{
    usize i = 0;
    while (true)
    {
        if (v[i] % 2 == 0)
        {
            return v[i];
        }
        i += 1;
    }
}

fn rounds() : i32
{
    i32 n = 0;
    while (true)
    {
        while (true)
        {
            break;
        }
        n += 1;
        if (n == 3)
        {
            return n;
        }
    }
}

fn count_to(i32 n) : i32
{
    i32 i = 0;
    while (true)
    {
        if (i == n)
        {
            break;
        }
        i += 1;
    }
    i * 10
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 3);
    Vec::push(&mut v, 4);
    printf("%v %v %v\n", first_even(&v), rounds(), count_to(4));
}
