// CONFORMANCE-CASE
// spec: 12-type-system
// facility: D-0006 (no implicit conversion); rule.type.typing [T-Call]
// kind: negative
// expect: diag.type-mismatch (static)
//
// D-0006 ("no implicit conversion or subtyping anywhere") was not
// enforced for function-call arguments of different concrete integer
// widths: an i32 binding passed where an i64 parameter is declared was
// silently accepted, the value round-tripping as if implicitly
// widened. [T-Call]'s own Gamma |- ei : ti requires an exact type
// match; a bare integer literal is exempt (rule.arith.literal lets it
// take on whatever concrete type context requires), but an
// already-typed binding is not.

fn takes_i64(i64 x) : i64
{
    x
}

fn main()
{
    i32 y = 5;
    takes_i64(y);
}
