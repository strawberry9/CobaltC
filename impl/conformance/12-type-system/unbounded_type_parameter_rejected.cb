// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.kind; conf.unbounded-type-parameter-rejected
// kind: negative
// expect: diag.unbounded-type-parameter (static)
//
// A generic body may store, pass, reference and move a bare T, but
// not add, compare, project, index, dereference or call it: there is
// no bound system. Checked once per generic declaration with T
// opaque, so it is rejected even for a call whose T would have been
// i32.

fn add<T>(T a, T b) : T
{
    a + b
}

fn main()
{
    i32 x = add(1, 2);
}
