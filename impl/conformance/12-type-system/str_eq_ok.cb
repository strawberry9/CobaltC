// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.eq [Eq-Str]; [T-Cmp]; conf.str-eq
// kind: positive
// expect: ok
//
// `==`/`!=` on str compare bytewise: equal lengths and equal bytes;
// different bytes or different lengths are unequal, and a literal on
// either side compares the same.

fn main()
{
    if (!(("ab" == "ab") && ("ab" != "ba"))) { 1 / (1 - 1); }
    str s = "ab";
    if (s != "ab") { 1 / (1 - 1); }
    if ("ab" != s) { 1 / (1 - 1); }
    if (s == "abc") { 1 / (1 - 1); }
    if (s == "") { 1 / (1 - 1); }
    if ("" != "") { 1 / (1 - 1); }
}
