// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.eq [Eq-Str]; [T-Cmp]; conf.str-eq; conf.12-str-eq
// kind: positive
// expect: ok
//
// `==`/`!=` on str compare bytewise: equal lengths and equal bytes;
// different bytes or different lengths are unequal, and a literal on
// either side compares the same.

fn main()
{
    if (!(("ab" == "ab") && ("ab" != "ba"))) { std::assert(false); }
    str s = "ab";
    if (s != "ab") { std::assert(false); }
    if ("ab" != s) { std::assert(false); }
    if (s == "abc") { std::assert(false); }
    if (s == "") { std::assert(false); }
    if ("" != "") { std::assert(false); }
}
