// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.bound [Bound-Unsatisfied] (D-0271); conf.bound-ordered-float-field-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// `ordered` admits a struct or enum of key types; one with a float field
// is not a key type, so the instantiation is rejected.

import std;

struct P3
{
    i32 x;
    f64 z;
}

fn larger<T: ordered>(T a, T b) : T
{
    if (a > b) { a } else { b }
}

fn main()
{
    P3 c = larger(P3 { .x = 1, .z = 2.0 }, P3 { .x = 1, .z = 3.0 });
    assert(c.x == 1);
}
