// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.typing [T-Cmp]; rule.arith.cmp [Cmp-Text] (D-0108); type.str; conf.str-ordering
// kind: positive
// expect: ok
//
// `<`, `<=`, `>`, `>=` order two `str`s by their bytes, a prefix first.

fn main()
{
    str s = "ab";
    if (!("a" < "b")) { 1 / (1 - 1); }
    if (!(s > "a")) { 1 / (1 - 1); }
    if ("b" <= "abc") { 1 / (1 - 1); }
    if (!(s >= s) || (s < s)) { 1 / (1 - 1); }
    if (!("" < s)) { 1 / (1 - 1); }
}
