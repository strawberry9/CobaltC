// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.coerce-text [Coerce-Text] (`&e`, `e` a `String`, where a `StringView` is declared); `e?`; conf.coerce-text-of-propagated-call
// kind: positive
// expect: ok
// expect-stdout-hex: 34203420310a6e6f20686f6d650a
//
// `&f()?` where a `StringView` is declared, `f()` a `Result<String, _>`
// or an `Option<String>`: `[Coerce-Text]` has no exception for `?`, so
// the view is of the `String` the `?` gives, which lives to the end of
// the statement, as `&f()` of a call that gives a `String` does. (It was
// rejected: "`String` is not sliced".)

import std;

fn dir(bool there) : Result<String, String>
{
    if (there) { Ok("home") } else { Err("no home") }
}

fn maybe() : Option<String>
{
    Some("x")
}

fn show(StringView s) : usize
{
    StringView::len(s)
}

fn lengths(bool there) : Result<usize, String>
{
    usize a = show(&dir(there)?);
    usize b = show(&dir(there)?[0..$]);
    printf("%v %v ", a, b);
    Ok(a + b)
}

fn first() : Option<usize>
{
    Some(show(&maybe()?))
}

fn main()
{
    match (lengths(true))
    {
        Ok(_)  : {},
        Err(e) : printf("%s\n", &e),
    }
    printf("%v\n", Option::unwrap_or(first(), 0));
    match (lengths(false))
    {
        Ok(_)  : {},
        Err(e) : printf("%s\n", &e),
    }
}
