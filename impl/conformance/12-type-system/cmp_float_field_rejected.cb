// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.arith.cmp [Cmp-Key] (D-0271); rule.type.bound; conf.cmp-float-field-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// A struct with a float field is not a key type (D-0110: float equality is
// not an equivalence), so it is not ordered; the message names the field.

import std;

struct P3
{
    i32 x;
    f64 z;
}

fn main()
{
    P3 a = P3 { .x = 1, .z = 2.0 };
    P3 b = P3 { .x = 1, .z = 3.0 };
    assert(a == b || a < b);
}
