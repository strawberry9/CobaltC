// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.expected, D-0012 §3c (type arguments from the context), D-0079
// kind: positive
// expect: ok
// expect-stdout-hex: 6f6b0a
//
// A variant of a generic enum passed where the parameter is a type
// parameter -- `None`, `Ok(5)`, `Some(None)` -- has its full type from the
// call's expected type, as a literal does: `T` below is the declared
// `Option<usize>`, `Result<u64, u8>`, `Option<Option<u8>>`, not a default,
// and `Vec::filled(3, None)` builds three separate `Option<usize>`
// elements (coby once laid them out at a defaulted type's size, so they
// overlapped).

import std;

fn same<T>(T x) : T
{
    x
}

fn main()
{
    Vec<Option<usize>> v = Vec::filled(3, None);
    v[1] = Some(5);
    assert(Option::is_none(&v[0]) && Option::is_some(&v[1]) && Option::is_none(&v[2]));
    Option<usize> n = same(None);
    Result<u64, u8> r = same(Ok(5));
    Option<Option<u8>> o = same(Some(None));
    assert(Option::is_none(&n) && Result::unwrap_or(r, 0) == 5 && Option::is_some(&o));
    printf("ok\n");
}
