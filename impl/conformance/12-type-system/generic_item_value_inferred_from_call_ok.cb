// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.typing [T-Item-Generic]; D-0093
// kind: positive
// expect: ok
// expect-stdout-hex: 31300a322e350a3230300a370a3120322e350a6e65787420310a66616c73650a
//
// A generic item passed as an argument takes its type arguments from
// the rest of the call: another argument (a literal at its default
// type, a variable, `None`), or the call's expected type. cobc once
// exited 3 here (`unsupported: cannot infer type arguments of `id` as
// a value here`); coby always ran it. The other arguments still run
// once, in order.

import std;

module m
{
    export fn id<T>(T x) : T
    {
        x
    }
}

fn id<T>(T x) : T
{
    x
}

fn pair<A, B>(A a, B b) : B
{
    printf("%v ", a);
    b
}

fn twice<T>(fn(T) : T f, T x) : T
{
    f(f(x))
}

fn twice_after<T>(T x, fn(T) : T f) : T
{
    f(f(x))
}

fn both<A, B>(fn(A, B) : B f, A a, B b) : B
{
    f(a, b)
}

fn next(ref<i32, exclusive> c) : i32
{
    *c += 1;
    printf("next ");
    *c
}

fn main()
{
    printf("%v\n", twice(id, 10));
    printf("%v\n", twice_after(2.5, id));
    u8 small = twice(id, 200);
    printf("%v\n", small);
    printf("%v\n", twice(m::id, 7));
    printf("%v\n", both(pair, 1, 2.5));
    i32 c = 0;
    printf("%v\n", twice(id, next(&mut c)));
    Option<i32> o = twice(id, None);
    printf("%v\n", Option::is_some(&o));
}
