// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.expected (the other operand's type) with D-0037 (literal expressions)
// kind: positive
// expect: ok
//
// `k & ((1 << 40) - 1)` where nothing outside gives a type (an argument
// of `printf`, of `reinterpret`): the literal expression's expected type
// is the other operand's, `u64`, so the mask is computed in `u64`. Both
// tools computed it in `i32` unless the whole expression had an expected
// type, and `1 << 40` faulted `diag.shift-amount-out-of-range`. Likewise
// with the literal expression on the left, and for floats. Found by
// real-world testing (packing grid coordinates into a key).

import std;

fn main()
{
    u64 k = 5000000000000;
    String s = sprintf("%d %d", k & ((1 << 40) - 1), ((1 << 40) - 1) & k);
    assert(String::eq_str(&s, "601953488896 601953488896"));
    assert(reinterpret<i64>(k & ((1 << 21) - 1)) == 1658880);
    assert((k >> 30) == (1 << 12) + 560);
    f32 x = 3.0;
    assert(x * (1.0 / 4.0) == 0.75);
}
