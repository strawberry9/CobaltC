// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.generic-infer [Callable-Closure] (D-0073); conf.generic-constructor-closure-payload
// kind: positive
// expect: ok
// expect-stdout-hex: 34320a61210a34320a34320a34320a34320a
//
// A closure literal as the payload of a generic enum's variant, or a field
// of a generic struct, with no type expected: its signature fixes the type
// parameter, and the payload is that `fn` value.

import std;

enum Op<T>
{
    Apply(fn(T) : T),
    Keep,
}

struct W<T>
{
    fn(T) : T f;
}

fn go<T>(Op<T> o, T x) : T
{
    match (o)
    {
        Apply(f) : f(x),
        Keep     : x,
    }
}

fn call_opt<T>(Option<fn(T) : T> o, T x) : T
{
    match (o)
    {
        Some(f) : f(x),
        None    : x,
    }
}

fn call_res<T>(Result<fn(T) : T, u8> r, T x) : T
{
    match (r)
    {
        Ok(f)  : f(x),
        Err(_) : x,
    }
}

fn run<T>(W<T> w, T x) : T
{
    (w.f)(x)
}

fn main()
{
    printf("%v\n", go(Op::Apply([](i32 x) { x + 1 }), 41));
    printf("%s\n", &go(Op::Apply([](String s) { sprintf("%s!", &s) }), String::copy("a")));
    printf("%v\n", call_opt(Some([](i32 x) { x * 2 }), 21));
    printf("%v\n", call_res(Ok([](i32 x) { x + 2 }), 40));
    printf("%v\n", run(W { .f = [](i32 x) { x - 1 } }, 43));
    i32 k = 40;
    printf("%v\n", go(Op::Apply(move [k](i32 x) { x + k }), 2));
}
