// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.bound `[Clone-Unsatisfied]` (D-0116); conf.clone-resource-without-clone-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// A `resource` type with a destructor and no `Handle::clone` is not
// `clone`: only it knows how to copy what it manages.

import std;

resource struct Handle { u32 fd; }
fn Handle::drop(ref<Handle, exclusive> self)
{
}

fn main()
{
    Handle h = Handle { .fd = 1 };
    Handle h2 = clone(&h);
}
