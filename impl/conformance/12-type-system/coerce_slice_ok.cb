// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.coerce-slice `[Coerce-Slice]` (D-0312): `&v` and `&mut v` of a `Vec` or an array where a slice is declared, a reference to a `Vec` handed on as a slice, and a generic slice parameter's element fixed by the argument; conf.coerce-slice
// kind: positive
// expect: ok
// expect-stdout-hex: 37203620370a3420350a330a
//

import std;

fn sum(slice<i32, shared> s) : i32
{
    i32 t = 0;
    foreach (x in s)
    {
        t += *x;
    }
    t
}

fn zero(slice<i32, exclusive> s)
{
    s[0] = 0;
}

fn via(ref<Vec<i32>, shared> r) : i32
{
    sum(r)
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 3);
    Vec::push(&mut v, 4);
    array<i32, 3> a = [1, 2, 3];
    printf("%v %v %v\n", sum(&v), sum(&a), via(&v));
    zero(&mut v);
    zero(&mut a);
    printf("%v %v\n", sum(&v), sum(&a));
    Vec<u8> b = Vec::from_slice(&[5: u8, 6, 7]);
    printf("%v\n", Vec::len(&b));
}
