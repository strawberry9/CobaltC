// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.eq [Eq-Struct] (structs, arrays elementwise, enums: same variant and equal payload)
// kind: positive
// expect: ok
//
// `==` and `!=` on plain aggregates compare by value, recursively:
// nested and generic structs, a str field, nested arrays, user enums
// and Option. A NaN field makes a struct unequal to itself ([Eq-Float]),
// and a reference field compares by identity ([Eq-Ref]).

import std;

struct Point
{
    i32 x;
    i32 y;
}

struct Seg
{
    Point from;
    Point to;
    str label;
    f64 w;
}

struct Pair<T>
{
    T a;
    T b;
}

enum Shape
{
    Dot(Point),
    Line(Seg),
    Empty
}

struct Grid
{
    array<array<u8, 2>, 2> cells;
}

fn main()
{
    auto p = Point { .x = 1, .y = 2 };
    auto q = Point { .x = 1, .y = 2 };
    auto r = Point { .x = 1, .y = 3 };
    if (!(p == q))
    {
        1 / (1 - 1);
    }
    if (!(p != r))
    {
        1 / (1 - 1);
    }
    if (p == r)
    {
        1 / (1 - 1);
    }

    auto s1 = Seg { .from = p, .to = r, .label = "a", .w = 0.5 };
    auto s2 = Seg { .from = q, .to = r, .label = "a", .w = 0.5 };
    auto s3 = Seg { .from = q, .to = r, .label = "b", .w = 0.5 };
    if (!(s1 == s2))
    {
        1 / (1 - 1);
    }
    if (!(s1 != s3))
    {
        1 / (1 - 1);
    }

    Pair<i64> g1 = Pair { .a = 5, .b = 6 };
    Pair<i64> g2 = Pair { .a = 5, .b = 7 };
    if (!(g1 != g2))
    {
        1 / (1 - 1);
    }

    if (!(Dot(p) == Dot(q)))
    {
        1 / (1 - 1);
    }
    if (!(Dot(p) != Dot(r)))
    {
        1 / (1 - 1);
    }
    if (!(Dot(p) != Empty))
    {
        1 / (1 - 1);
    }
    if (!(Line(s1) == Line(s2)))
    {
        1 / (1 - 1);
    }
    if (!(Empty == Empty))
    {
        1 / (1 - 1);
    }

    Option<i32> o1 = Some(3);
    Option<i32> o2 = Some(3);
    Option<i32> o3 = None;
    if (!(o1 == o2))
    {
        1 / (1 - 1);
    }
    if (!(o1 != o3))
    {
        1 / (1 - 1);
    }

    auto a1 = [1, 2, 3];
    auto a2 = [1, 2, 3];
    auto a3 = [1, 2, 4];
    if (!(a1 == a2))
    {
        1 / (1 - 1);
    }
    if (!(a1 != a3))
    {
        1 / (1 - 1);
    }

    auto gr1 = Grid { .cells = [[1, 2], [3, 4]] };
    auto gr2 = Grid { .cells = [[1, 2], [3, 4]] };
    auto gr3 = Grid { .cells = [[1, 2], [3, 5]] };
    if (!(gr1 == gr2))
    {
        1 / (1 - 1);
    }
    if (!(gr1 != gr3))
    {
        1 / (1 - 1);
    }

    f64 zero = 0.0;
    auto n1 = Seg { .from = p, .to = r, .label = "a", .w = zero / zero };
    if (n1 == n1)                     // a NaN field makes the struct unequal to itself
    {
        1 / (1 - 1);
    }

    i32 k = 7;
    auto rp1 = Pair { .a = &k, .b = &k };
    if (rp1 != rp1)                   // reference fields compare by identity
    {
        1 / (1 - 1);
    }
}
