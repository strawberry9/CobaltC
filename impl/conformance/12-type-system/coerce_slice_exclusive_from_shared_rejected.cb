// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.coerce-slice `[Coerce-Slice]` (D-0312): a shared borrow is no exclusive slice; conf.coerce-slice-exclusive-from-shared-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//

import std;

fn zero(slice<i32, exclusive> s)
{
    s[0] = 0;
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    zero(&v);
}
