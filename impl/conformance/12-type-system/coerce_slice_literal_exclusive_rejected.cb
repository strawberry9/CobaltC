// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.coerce-slice [Coerce-Slice-Literal] (D-0314); conf.coerce-slice-literal-exclusive-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// `[Coerce-Slice-Literal]` gives a shared slice only: a literal's object is
// no one's to write, so a `byte-literal` is no `slice<u8, exclusive>`.

import std;

fn main()
{
    slice<u8, exclusive> s = b"ab";
    s[0] = 1;
}
