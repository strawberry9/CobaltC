// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.expected (function result, if branches, match arms, block value)
// kind: positive
// expect: ok
//
// An unsuffixed literal in a function body's trailing position, in
// either branch of an `if`, in a `match` arm or as a block's value
// takes the type expected of the whole construct -- here i64, so none
// of these literals is an i32 overflow.

import std;

fn g() : i64
{
    5000000000
}

fn h(bool c) : i64
{
    if (c)
    {
        6000000000
    }
    else
    {
        7000000000
    }
}

fn k(Option<i32> o) : i64
{
    match (o)
    {
        Some(_) : 8000000000,
        None : 9000000000,
    }
}

fn check(bool ok)
{
    i32 z = if (ok)
    {
        1
    }
    else
    {
        0
    };
    1 / z;
}

fn main()
{
    check(g() == 5000000000);
    check(h(true) == 6000000000);
    check(h(false) == 7000000000);
    check(k(None) == 9000000000);
    i64 b =
    {
        10000000000
    };
    check(b == 10000000000);
}
