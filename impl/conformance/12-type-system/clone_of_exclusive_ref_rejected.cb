// CONFORMANCE-CASE
// spec: 12-type-system
// facility: conf.clone-of-exclusive-ref; spec/12 clone-holds, spec/08 [Read-Exclusive-Through-Shared] (D-0218, CHG-0257)
// kind: negative
// expect: diag.type-mismatch (static)
//
// `clone` reads through a shared reference; an exclusive reference, and a
// struct holding one, has no clone: the copy could write what the shared
// reference reaches.

import std;

struct S
{
    ref<i32, exclusive> inner;
}

fn dup(ref<S, shared> s)
{
    S t = clone(s);
    *t.inner = 9;
}

fn main()
{
    i32 x = 0;
    S s = S { .inner = &mut x };
    dup(&s);
}
