// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.expected; D-0049; conf.if-variant-branch-takes-sibling-type
// kind: positive
// expect: ok
// expect-stdout-hex: 35207472756520370a
//
// With no expected type, an `if` whose `then` branch is a payloadless
// variant of a generic enum (`{ None }`) has the `else` branch's type, as
// a literal branch does (D-0049): as a `match` scrutinee, as an `auto`
// binding's value and as a generic call's argument.

import std;

fn first<T>(Option<T> o, T d) : T
{
    match (o)
    {
        Some(v) : v,
        None    : d,
    }
}

fn main() : u8
{
    HashMap<usize, i32> m = HashMap::new();
    HashMap::insert(&mut m, 1, 5);
    usize key = 1;
    i32 v = match (if (key == 0) { None } else { HashMap::swap_remove(&mut m, &key) })
    {
        Some(p) : p,
        None    : 0,
    };
    auto w = if (key == 1) { None } else { Some(String::from_str("x")) };
    i32 n = first(if (key == 2) { None } else { Some(7) }, 1);
    printf("%v %v %v\n", v, Option::is_none(&w), n);
    0
}
