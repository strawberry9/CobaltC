// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.typing [T-While] [T-While-Forever] (D-0175); conf.while-true-break-needs-value
// kind: negative
// expect: diag.type-mismatch (static)
//
// A `break` that leaves the `while (true)` makes the loop complete, with
// type `unit`: the function's `i32` result is then missing.

import std;

fn f(i32 n) : i32
{
    i32 i = 0;
    while (true)
    {
        if (i == n)
        {
            break;
        }
        i += 1;
    }
}

fn main()
{
    printf("%v\n", f(2));
}
