// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.typing (any [T-*] premise failing)
// kind: negative
// expect: diag.type-mismatch (static)
//
// Matching variants against a value that has none is a type error. A
// reference to an enum is matched on the enum (D-0046); a reference to
// an `i32` has no variants, which the static pass rejects since D-0057
// (it was caught only at run time before).

import std;

fn main()
{
    Option<i32> o = Some(1);
    match (o)
    {
        Some(x) :
        {
            if (x != 1)
            {
                1 / (1 - 1);
            }
        },
        None :
        {
            1 / (1 - 1);
        },
    }
    i32 n = 5;
    auto bad = &n;
    match (bad)
    {
        Some(x) :
        {
        },
        None :
        {
        },
    }
}
