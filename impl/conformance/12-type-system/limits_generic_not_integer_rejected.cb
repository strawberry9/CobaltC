// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.kind; [Limits-Not-Integer] (conf.limits-generic-not-integer)
// kind: negative
// expect: diag.type-mismatch (static)
//
// A generic body may pass its `T` to `min_value`, which is then typed at
// each instantiation. With `T = bool` it is not an integer type, and the
// program is rejected before it runs.

fn lo<T>() : T
{
    min_value<T>()
}

fn main()
{
    lo<bool>();
}
