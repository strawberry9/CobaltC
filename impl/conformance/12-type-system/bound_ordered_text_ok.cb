// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.bound (D-0108); rule.arith.cmp [Cmp-Text], [Cmp-Bool]; conf.bound-ordered-text
// kind: positive
// expect: ok
//
// `String`, `str` and `bool` satisfy `ordered`. At `String` the
// comparison borrows both parameters, so the larger one can then be
// moved out; `std`'s `min` and `max` take text too.

import std;

fn larger<T: ordered>(T a, T b) : T
{
    if (a > b) { a } else { b }
}

fn main()
{
    String w = larger(String::from_str("pear"), String::from_str("apple"));
    if (!String::eq_str(&w, "pear")) { 1 / (1 - 1); }
    if (larger("a", "b") != "b") { 1 / (1 - 1); }
    if (!larger(false, true)) { 1 / (1 - 1); }
    String m = min(String::from_str("b"), String::from_str("a"));
    if (m != String::from_str("a")) { 1 / (1 - 1); }
}
