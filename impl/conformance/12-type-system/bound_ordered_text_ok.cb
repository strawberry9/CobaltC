// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.bound (D-0108); rule.arith.cmp [Cmp-Text], [Cmp-Bool]; conf.bound-ordered-text; conf.12-bound-ordered-text
// kind: positive
// expect: ok
//
// `String`, `str` and `bool` satisfy `ordered`. At `String` the
// comparison borrows both parameters, so the larger one can then be
// moved out; `std`'s `min` and `max` take text too.

import std;

fn larger<T: ordered>(T a, T b) : T
{
    if (a > b) { a } else { b }
}

fn main()
{
    String w = larger("pear", "apple");
    if (w != "pear") { 1 / (1 - 1); }
    if (larger("a", "b") != "b") { 1 / (1 - 1); }
    if (!larger(false, true)) { 1 / (1 - 1); }
    String m = min("b", "a");
    if (m != "a") { 1 / (1 - 1); }
}
