// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.coerce-slice [Coerce-Slice-Literal-Generic-Disagree] (D-0314); conf.coerce-slice-literal-generic-disagree-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// One literal in a generic body is one constant: two instantiations that
// give it two element types (`u8` and `u16`) cannot share it.

import std;

fn h<T: integer>(T x) : usize
{
    slice<T, shared> s = [1, 2];
    slice_len(s)
}

fn main()
{
    printf("%v %v\n", h(1: u8), h(1: u16));
}
