// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.expected; D-0049; conf.if-variant-else-branch-takes-sibling-type
// kind: positive
// expect: ok
// expect-stdout-hex: 74727565207472756520370a
//
// With no expected type, an `if` whose `else` branch is a payloadless
// variant of a generic enum (`{ None }`) has the `then` branch's type, as
// when the `then` branch is (`conf.if-variant-branch-takes-sibling-type`):
// as a `match` scrutinee whose binder holds a resource compared as text,
// as an `auto` binding's value and as a generic call's argument.

import std;

fn first<T>(Option<T> o, T d) : T
{
    match (o)
    {
        Some(v) : v,
        None    : d,
    }
}

fn main() : u8
{
    bool c = true;
    bool same = match (if (c) { Some(String::from_str("x")) } else { None })
    {
        Some(a) : a == "x",
        None    : false,
    };
    auto w = if (!c) { Some(String::from_str("y")) } else { None };
    i32 n = first(if (c) { Some(7) } else { None }, 1);
    printf("%v %v %v\n", same, Option::is_none(&w), n);
    0
}
