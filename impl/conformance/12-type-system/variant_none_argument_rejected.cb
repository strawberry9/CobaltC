// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.typing [T-Enum] (CHG-0438): a payload-less variant as an argument, and as a function's result; conf.variant-none-argument
// kind: negative
// expect: diag.type-mismatch (static)
//
// Both positions expect an `i32`: the argument of `twice` and the result of
// `give`.

import std;

fn twice(i32 x) : i32
{
    x * 2
}

fn give() : i32
{
    None
}

fn main()
{
    printf("%v %v\n", twice(None), give());
}
