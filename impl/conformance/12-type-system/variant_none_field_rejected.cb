// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.typing [T-Enum] (CHG-0438): a payload-less variant as a field of another type; conf.variant-none-field
// kind: negative
// expect: diag.type-mismatch (static)
//
// The field is a `Vec<String>`; `None` is an `Option`.

import std;

struct S
{
    Vec<String> v;
}

fn main()
{
    S s = S { .v = None };
    printf("%v\n", Vec::len(&s.v));
}
