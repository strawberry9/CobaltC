// CONFORMANCE-CASE
// spec: 12-type-system
// facility: [Generic-Call-Uninferable] (CHG-0438): a type argument left open inside a generic call's result; conf.open-type-through-generic-call
// kind: negative
// expect: diag.cannot-infer-type-parameter (static)
//
// `id`'s `T` is `Vec<U>` with `U` fixed by nothing.

import std;

fn id<T>(T x) : T
{
    x
}

fn main()
{
    auto v = id(Vec::new());
    printf("%v\n", 1);
}
