// CONFORMANCE-CASE
// spec: 12-type-system
// facility: D-0006; rule.type.typing [T-Call] (CHG-0438): through a `fn` value, an integer literal for a float parameter; conf.int-literal-float-fn-value-argument
// kind: negative
// expect: diag.type-mismatch (static)
//
// The same through a `fn` value: its parameter is an `f64`.

import std;

fn half(f64 a) : f64
{
    a / 2.0
}

fn main()
{
    fn(f64) : f64 f = half;
    printf("%v\n", f(3));
}
