// CONFORMANCE-CASE
// spec: 12-type-system
// facility: D-0006 (no implicit conversion); rule.type.typing [T-Call] (CHG-0438): an integer literal for a float parameter; conf.int-literal-float-argument
// kind: negative
// expect: diag.type-mismatch (static)
//
// An integer literal is not a float anywhere else (`f64 x = 3;` is
// rejected), and not as an argument either: `half(3)` was accepted, then
// `coby` faulted and `cobc` printed `1.5`.

import std;

fn half(f64 a) : f64
{
    a / 2.0
}

fn main()
{
    printf("%v\n", half(3));
}
