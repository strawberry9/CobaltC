// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.coerce-slice [Coerce-Slice-Literal] (D-0314); conf.coerce-slice-literal-not-literal-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// An array literal with an element that is not a literal is not a constant:
// it is no slice where one is declared (bind the array first).

import std;

fn main()
{
    u8 x = 1;
    slice<u8, shared> s = [x, 2];
    printf("%v\n", slice_len(s));
}
