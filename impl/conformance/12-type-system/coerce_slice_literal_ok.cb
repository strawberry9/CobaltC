// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.coerce-slice [Coerce-Slice-Literal] (D-0314); conf.coerce-slice-literal
// kind: positive
// expect: ok
// expect-stdout-hex: 342037302033303020313632203320340a323934203620360a74727565202d35202d302e3235203220302e352033203720330a
//
// An array literal written out as literals where a `slice<T, shared>` is
// declared is a slice of static data, one object with program extent: a
// `byte-literal` in a binding, a field, an argument and a function's result
// through its parameter's source; elements typed by the slice's element
// type (`[1, 2, 300]` of `u16`), negative numbers, floats, structs, nested
// arrays and a repeat; the same literal in two generic instantiations of
// one element type; two equal literals.

import std;

struct Hdr
{
    slice<u8, shared> magic;
    u32 n;
}

struct Px
{
    i16 x;
    f32 y;
}

fn sum(slice<u8, shared> s) : u32
{
    u32 t = 0;
    foreach (b in s)
    {
        t += widen<u32>(*b);
    }
    t
}

fn total(slice<f64, shared> s) : f64
{
    f64 t = 0.0;
    foreach (v in s)
    {
        t += *v;
    }
    t
}

fn pick(slice<u8, shared> d, bool own) : slice<u8, shared>
{
    if (own) { b"yes" } else { d }
}

fn gen<T>(T x) : u32
{
    slice<u8, shared> s = [1, 2, 3];
    sum(s)
}

fn main()
{
    slice<u8, shared> s = b"\x7fELF";
    slice<u16, shared> w = [1, 2, 300];
    Hdr h = Hdr { .magic = b"PK\x03\x04", .n = 4 };
    printf("%v %v %v %v %v %v\n", slice_len(s), s[3], w[2], sum(h.magic), slice_len(pick(s, true)), slice_len(pick(s, false)));
    printf("%v %v %v\n", sum(b"abc"), gen(1), gen(true));
    slice<u8, shared> a = b"ab";
    slice<u8, shared> b = b"ab";
    slice<i16, shared> n = [-3, 4, -5];
    slice<f64, shared> f = [0.5, 1.25, -2.0];
    slice<Px, shared> p = [Px { .x = -1, .y = 0.5 }, Px { .x = 2, .y = 1.5 }];
    slice<array<u8, 2>, shared> g = [[1, 2], [3, 4]];
    slice<u8, shared> z = [7; 3];
    printf("%v %v %v %v %v %v %v %v\n", a[1] == b[1], n[2], total(f), p[1].x, p[0].y, g[1][0], z[2], slice_len(z));
}
