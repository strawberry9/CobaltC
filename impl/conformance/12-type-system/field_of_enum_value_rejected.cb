// CONFORMANCE-CASE
// spec: 12-type-system
// facility: [T-Field] (CHG-0100); conf.field-of-enum-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// An enum value has no fields, and CobaltC has no method-call syntax:
// `o.unwrap()` is a call of a field `unwrap` of `o`. It reached the
// interpreter as a dynamic type mismatch and crashed the compiler; the
// checker now rejects it and names `Option::unwrap(o)`. Found by
// real-world testing (a Sudoku solver).

import std;

fn main()
{
    Vec<u8> v = Vec::new();
    Vec::push(&mut v, 3);
    u8 x = Vec::pop(&mut v).unwrap();
}
