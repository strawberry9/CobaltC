// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.kind; [T-Alt] (conf.alt-generic-non-integer-rejected)
// kind: negative
// expect: diag.type-mismatch (static)
//
// `wrapping_add` on a generic body's `T` is typed at the instantiation.
// With `T = bool` its operands are not integers, which is a static type
// error rather than a fault at run time.

fn f<T>(T a, T b) : T
{
    wrapping_add(a, b)
}

fn main()
{
    f(true, false);
}
