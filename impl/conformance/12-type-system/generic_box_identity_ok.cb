// CONFORMANCE-CASE
// spec: 12-type-system
// facility: D-0010 (user-defined generics); rule.fn.generic-call
// kind: positive
// expect: ok
//
// A generic identity function infers its type parameter from its
// argument and returns a value of that same concrete type.

fn identity<T>(T x) : T
{
    x
}

fn main()
{
    if (identity(5) != 5)
    {
        1 / (1 - 1);
    }
}
