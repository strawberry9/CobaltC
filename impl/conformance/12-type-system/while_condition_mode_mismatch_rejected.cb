// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.typing [T-While]; rule.fn.call argument types
// kind: negative
// expect: diag.type-mismatch (static)
//
// A call in a `while` condition has its arguments checked as anywhere
// else: a `ref<Vec<i32>, shared>` is not the `ref<Vec<i32>, exclusive>`
// that `Vec::pop` takes (the reverse direction, exclusive for shared,
// is a shared reborrow, D-0049).

import std;

fn drain(ref<Vec<i32>, shared> v) : usize
{
    usize i = 0;
    while (Vec::pop(v) != None)
    {
        i = i + 1;
    }
    i
}

fn main()
{
    Vec<i32> v = Vec::new();
    drain(&v);
}
