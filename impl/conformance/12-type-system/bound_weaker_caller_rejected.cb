// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.bound [Bound-Unsatisfied] (D-0090); conf.bound-weaker-caller-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// A generic caller passes its own type parameter on only where its bound
// implies the callee's: `eq` does not imply `ordered`.

fn larger<T: ordered>(T a, T b) : T
{
    if (a > b) { a } else { b }
}

fn pick<U: eq>(U a, U b) : U
{
    larger(a, b)
}

fn main()
{
    pick(1, 2);
}
