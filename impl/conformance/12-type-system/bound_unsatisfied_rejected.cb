// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.bound [Bound-Unsatisfied] (D-0090); conf.bound-unsatisfied-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// `Option<i32>` has equality but no order, so it does not satisfy
// `ordered`.

import std;

fn larger<T: ordered>(T a, T b) : T
{
    if (a > b) { a } else { b }
}

fn main()
{
    larger(Some(1), Some(2));
}
