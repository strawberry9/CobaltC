// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.bound [Bound-Unsatisfied] (D-0090); conf.bound-unsatisfied-rejected; conf.bound-unsatisfied
// kind: negative
// expect: diag.type-mismatch (static)
//
// `Option<f64>` is not a key type (a float is not), so it does not satisfy
// `ordered`; `Option<i32>`, a key type, does (D-0271).

import std;

fn larger<T: ordered>(T a, T b) : T
{
    if (a > b) { a } else { b }
}

fn main()
{
    larger(Some(1.5), Some(2.5));
}
