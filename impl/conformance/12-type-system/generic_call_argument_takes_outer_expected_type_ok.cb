// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.expected; D-0013; conf.generic-call-argument-takes-outer-expected-type
// kind: positive
// expect: ok
//
// A generic call as another generic call's argument (`Arc::new(Channel::new(4))`)
// takes its type arguments from what the outer call's expected type fixes for
// that parameter: the channel is a `Channel<u32>`, its slots sized for
// `Option<u32>`, so destroying it with the `Arc` destroys exactly what it made
// (CHG-0384: `coby` sized them for a default and faulted
// `diag.destroy-while-aliased` at the `Arc`'s end).

import std;

fn take(Arc<Channel<u32>> c) : u32
{
    Option::unwrap(Channel::recv(Arc::get(&c)))
}

fn main()
{
    Arc<Channel<u32>> c = Arc::new(Channel::new(4));
    handle<u32> h = spawn(take, Arc::clone(&c));
    _ = Channel::send(Arc::get(&c), 7);
    Arc<Vec<Option<u32>>> v = Arc::new(Vec::filled(4, None));
    assert(join(h) == 7);
    assert(Vec::len(Arc::get(&v)) == 4);
}
