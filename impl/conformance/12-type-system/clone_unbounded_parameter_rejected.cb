// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.bound `[Bound-Missing]` for `clone` (D-0116); conf.clone-unbounded-parameter-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// A type parameter without `clone` grants no `clone(&t)`: the body is
// checked once against its bounds.

import std;

fn dup<T>(ref<T, shared> x) : T
{
    clone(x)
}

fn main()
{
    i32 v = dup(&3);
}
