// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.expected (conf.enum-literal-expected-type)
// kind: positive
// expect: ok
//
// An enum literal of a generic enum (`Some(…)`, `Ok(…)`) takes its type
// arguments from the expected type wherever there is one, so its payload
// literal is typed by it: a declaration, an assignment (through a
// reference too), a return, an argument (to a generic function, once the
// arguments to its left fix `T`), a field, a nested literal, and the other
// operand of `==`/`!=` on either side. 5000000000 does not fit the i32 a
// payload literal would otherwise default to.

import std;

fn check(bool ok)
{
    i32 z = if (ok)
    {
        1
    }
    else
    {
        0
    };
    1 / z;
}

struct Holder
{
    Option<u64> o;
}

fn make() : Option<u64>
{
    return Some(5000000000);
}

fn takes(Option<u64> o) : bool
{
    o == Some(5000000000)
}

fn main()
{
    Option<u64> x = Some(5000000000);                 // declaration
    check(x == Some(5000000000));                     // == with the literal on the right
    check(Some(5000000000) == x);                     // and on the left
    check(x != Some(0));

    Option<u64> y = None;
    y = Some(5000000000);                             // assignment
    check(y == x);
    {
        auto p = &mut y;
        *p = Some(0);                                 // through a reference
    }
    check(y == Some(0));

    check(make() == x);                               // return
    check(takes(Some(5000000000)));                   // argument
    Holder h = Holder { .o = Some(5000000000) };      // field
    check(h.o == x);

    Vec<Option<u64>> v = Vec::new();
    Vec::push(&mut v, Some(5000000000));              // generic argument: v fixes T
    check(*Vec::index_shared(&v, 0) == x);

    Option<Option<u64>> nested = None;
    nested = Some(Some(5000000000));                  // nested literal
    check(nested == Some(Some(5000000000)));

    Result<u64, i32> r = Ok(5000000000);
    check(r == Ok(5000000000));
    check(r != Err(1));
}
