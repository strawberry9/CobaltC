// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.typing [T-Item-Value-Uninferable]; D-0093; conf.generic-item-value-uninferable
// kind: negative
// expect: diag.cannot-infer-type-parameter (static)
//
// A generic item bound as a value with nothing to fix its type
// parameters: no explicit arguments, no expected fn type. A binding
// is never polymorphic (one implementation ran `f` at two types
// before D-0093 made the rejection explicit).

fn id<T>(T x) : T
{
    x
}

fn main()
{
    auto f = id;
    if (f(3) != 3)
    {
        1 / (1 - 1);
    }
}
