// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.coerce-slice [Coerce-Slice] [Ref-Form-Const-Place] (D-0312, D-0314); conf.coerce-slice-of-constant
// kind: positive
// expect: ok
// expect-stdout-hex: 342036392033303320340a31323720656c660a
//
// `&K` of a constant array where a `slice<T, shared>` is declared is
// `&(*&K)[0..$]`, a slice of the constant's one object with program extent:
// in a binding, a field, an argument, `slice_len`'s argument and a
// function's result through its parameter's source.

import std;

const array<u8, 4> ELF = [0x7f, 0x45, 0x4c, 0x46];
const array<u16, 3> WIDE = [1, 2, 300];

struct Format
{
    str name;
    slice<u8, shared> magic;
}

fn sum(slice<u16, shared> s) : u32
{
    u32 t = 0;
    foreach (x in s)
    {
        t += widen<u32>(*x);
    }
    t
}

fn first(slice<u8, shared> s) : slice<u8, shared>
{
    &s[0..1]
}

fn main()
{
    slice<u8, shared> e = &ELF;
    Format f = Format { .name = "elf", .magic = &ELF };
    printf("%v %v %v %v\n", slice_len(e), f.magic[1], sum(&WIDE), slice_len(&ELF));
    printf("%v %v\n", first(&ELF)[0], f.name);
}
