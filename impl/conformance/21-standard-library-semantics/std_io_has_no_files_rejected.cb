// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.prelude rule.module.resolve [Resolve-Unbound] (D-0176); conf.std-io-has-no-files
// kind: negative
// expect: diag.unbound-name (static)
//
// `std::io` is the standard streams only: `read_file` is in `std::fs`
// (D-0176), so importing `std::io` alone does not name it.

import std::io;

fn main()
{
    printf("%v\n", read_file("x.txt"));
}
