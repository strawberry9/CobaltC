// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.process [Exit]; rule.fn.program [Terminate-Exit] (D-0150); conf.exit-runs-destructors
// kind: positive
// expect: exit 3
// expect-stdout-hex: 696e6e6572203220726561636865640a6c6f636b20322072656c65617365640a6c6f636b20312072656c65617365640a
//
// `exit(3)` three calls deep: the calling thread's scopes and frames are
// unwound innermost first, so `inner`'s destructor runs before `outer`'s,
// nothing after the call runs, and the program's status is 3. `exit` has
// type `never`, so it stands in a `match` arm where a value is expected.

import std;

resource struct Lock
{
    i32 id;
}

fn Lock::drop(ref<Lock, exclusive> self)
{
    printf("lock %d released\n", self.id);
}

fn deepest(Option<i32> o) : i32
{
    match (o)
    {
        Some(v) : v,
        None    : exit(3),
    }
}

fn deeper() : i32
{
    Lock inner = Lock { .id = 2 };
    printf("inner %d reached\n", inner.id);
    i32 r = deepest(None);
    printf("not printed %d\n", r);
    r
}

fn main() : u8
{
    Lock outer = Lock { .id = 1 };
    i32 r = deeper();
    printf("not printed either %d\n", r);
    0
}
