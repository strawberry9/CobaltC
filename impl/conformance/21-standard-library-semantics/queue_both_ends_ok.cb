// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.queue [Queue] (D-0137); conf.queue-both-ends
// kind: positive
// expect: ok
// expect-stdout-hex: 6120650a650a616263640a3120392032203820332037203420362035200a
//
// A queue works at both ends: `push_front` puts an element before the
// front, `pop_back` takes the last. Taking from the two ends in turn
// keeps the order from both sides (the queue moves half its elements
// from one part to the other when a part empties).

import std;

fn main()
{
    Queue<String> q = Queue::new();
    Queue::push_back(&mut q, String::from_str("c"));
    Queue::push_front(&mut q, String::from_str("b"));
    Queue::push_front(&mut q, String::from_str("a"));
    Queue::push_back(&mut q, String::from_str("d"));
    Queue::push_back(&mut q, String::from_str("e"));
    printf("%s %s\n", Option::unwrap(Queue::front(&q)), Option::unwrap(Queue::back(&q)));
    String last = Option::unwrap(Queue::pop_back(&mut q));
    printf("%s\n", &last);
    while (Queue::len(&q) > 0)
    {
        String s = Option::unwrap(Queue::pop_front(&mut q));
        printf("%s", &s);
    }
    printf("\n");
    assert(Option::is_none(&Queue::pop_back(&mut q)));

    Queue<i32> n = Queue::new();
    for (i32 i = 1; i <= 9; i += 1)
    {
        Queue::push_back(&mut n, i);
    }
    while (Queue::len(&n) > 0)
    {
        printf("%d ", Option::unwrap(Queue::pop_front(&mut n)));
        if (Some(x) = Queue::pop_back(&mut n))
        {
            printf("%d ", x);
        }
    }
    printf("\n");
}
