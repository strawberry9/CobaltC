// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.text [Hex] [Base64] (std::encoding, D-0198); rule.module.use (re-export); conf.std-encoding-hex-base64-paths
// kind: positive
// expect: ok
// expect-stdout-hex: 34643631366520346436313665203464363136650a5457467520545746750a3131302037370a
//
// Hexadecimal is `std::encoding::hex` and base64 `std::encoding::base64`
// (D-0198), each re-exported by `std::encoding` and by `std`'s root, so
// `std::encoding::hex::to_hex`, `std::encoding::to_hex` and `to_hex` are
// one function. A program may import an encoding alone.

import std::io;
import std::core;
import std::encoding::hex;
import std::encoding::base64;

fn main()
{
    array<u8, 3> b = [0x4d, 0x61, 0x6e];
    printf("%v %v %v\n", &std::encoding::hex::to_hex(&b[0..$]), &std::encoding::to_hex(&b[0..$]), &to_hex(&b[0..$]));
    printf("%v %v\n", &base64_encode(&b[0..$]), &std::encoding::base64::base64_encode(&b[0..$]));
    auto h = Result::unwrap(from_hex(std::StringView::of("4D616e")));
    auto d = Result::unwrap(std::encoding::base64_decode(std::StringView::of("TWFu")));
    printf("%v %v\n", h[2], d[0]);
}
