// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str `[Str-Literal-String]` (D-0149); rule.type.identity (D-0006); conf.string-of-str-binding-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// `[Str-Literal-String]` types a literal only. `t` is a `str` binding,
// and no conversion of a value is implicit: a `String` is made from it
// by `String::from_str(t)`.

import std;

fn main()
{
    str t = "abc";
    String s = t;
}
