// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.option (unwrap) D-0082; conf.option-unwrap-ref-none
// kind: negative
// expect: diag.unwrap-failed (dynamic)
//
// `Option::unwrap` of a `None` that would have held a reference.

import std;

fn main()
{
    HashMap<String, u64> m = HashMap::new();
    _ = HashMap::insert(&mut m, String::from_str("a"), 1);
    String k = String::from_str("b");
    u64 n = *Option::unwrap(HashMap::get(&m, &k));
    printf("%v\n", n);
}
