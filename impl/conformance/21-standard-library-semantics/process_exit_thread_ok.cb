// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.process [Exit]; rule.fn.program [Terminate-Exit] (D-0150); conf.exit-from-thread
// kind: positive
// expect: exit 4
// expect-stdout-hex: 776f726b657220726561636865640a6c6f636b20392072656c65617365640a
//
// `exit(4)` in a spawned thread ends the whole program with status 4: the
// worker's own frames are unwound (its lock's destructor runs), while
// `main`, waiting in `join`, takes no further step and its frames are not
// unwound (`outer`'s destructor does not run), as under a fault.

import std;

resource struct Lock
{
    i32 id;
}

fn Lock::drop(ref<Lock, exclusive> self)
{
    printf("lock %d released\n", self.id);
}

fn worker() : i32
{
    Lock mine = Lock { .id = 9 };
    printf("worker reached\n");
    exit(4);
}

fn main() : u8
{
    Lock outer = Lock { .id = 1 };
    auto h = spawn(worker);
    i32 r = join(h);
    printf("not printed %d\n", r);
    0
}
