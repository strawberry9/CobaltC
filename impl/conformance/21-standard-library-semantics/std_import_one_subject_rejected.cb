// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.prelude (std's submodules, D-0136); [Resolve-Unbound]; conf.std-import-one-subject-only
// kind: negative
// expect: diag.unbound-name (static)
//
// `import std::text;` brings in `std::text` only: `Vec` is
// `std::collections`'s.

import std::text;

fn main()
{
    Vec<u8> v = Vec::new();
}
