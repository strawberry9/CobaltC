// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §1 Vec; conf.vec-string-search
// kind: positive
// expect: ok
// expect-stdout-hex: 747275652066616c73650a310a6170706c65206170706c652062616e616e6120666967206b6977692070656172200a6170706c653d4f6b302062616e616e613d4f6b3220623d45727232207a7a3d4572723620613d45727230206669673d4f6b3320666967733d45727234200a66616c736520747275650a7472756520300a
//
// contains, index_of and binary_search over Vec<String> (keys a place and
// temporaries, empty vectors, empty strings), and Vec::clone of Strings
// (D-0192)

import std;

fn main()
{
    Vec<String> v = Vec::new();
    foreach (w in StringView::split(StringView::of("pear apple fig apple banana kiwi"), " "))
    {
        Vec::push(&mut v, String::from_view(w));
    }
    String k = String::from_str("apple");
    printf("%v %v\n", Vec::contains(&v, &k), Vec::contains(&v, &String::from_str("grape")));
    printf("%v\n", Option::unwrap(Vec::index_of(&v, &k)));
    Vec<String> s = Vec::clone(&v);
    Vec::sort(&mut s);
    foreach (w in &s)
    {
        printf("%s ", w);
    }
    printf("\n");
    foreach (q in StringView::split(StringView::of("apple banana b zz a fig figs"), " "))
    {
        match (Vec::binary_search(&s, &String::from_view(q)))
        {
            Ok(i)  : printf("%s=Ok%v ", q, i),
            Err(i) : printf("%s=Err%v ", q, i),
        }
    }
    printf("\n");
    Vec<String> e = Vec::new();
    printf("%v %v\n", Vec::contains(&e, &k), Result::is_err(&Vec::binary_search(&e, &k)));
    Vec<String> blanks = Vec::filled(3, String::new());
    printf("%v %v\n", Vec::contains(&blanks, &String::new()), Option::unwrap(Vec::index_of(&blanks, &String::new())));
}
