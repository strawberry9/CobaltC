// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `Vec::contains`, `Vec::index_of` (D-0112), `[Bound-Unsatisfied]` (D-0090); conf.vec-contains-not-eq-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// `contains` and `index_of` compare with `==` under the `eq` bound, which
// a struct satisfies only when it is a key type (D-0271); one with a float
// field is not: rejected at the call. `Vec::position` with a predicate is
// the form for such a struct.

import std;

struct P
{
    f64 x;
}

fn main()
{
    Vec<P> v = Vec::new();
    Vec::push(&mut v, P { .x = 1.0 });
    bool b = Vec::contains(&v, &P { .x = 1.0 });
}
