// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.read [Read]; read_line; ReadError; conf.read-line-invalid-utf8
// kind: positive
// expect: ok
// stdin-hex: 61ff0a6f6b0a
// expect-stdout-hex: 310a6f6b0a
//
// Input `a\xff\nok\n`: the first line is not UTF-8, so `read_line` is
// `Err(Utf8(e))` with `e.offset` 1, the bad byte's offset in the line.
// The whole line was consumed: the next call reads `ok`.

import std;

fn main()
{
    match (read_line())
    {
        Ok(_) :
        {
            1 / (1 - 1);
        },
        Err(e) :
        {
            match (e)
            {
                Io :
                {
                    1 / (1 - 1);
                },
                Utf8(u) :
                {
                    printf("%v\n", u.offset);
                },
            }
        },
    }
    match (read_line())
    {
        Ok(line) :
        {
            match (line)
            {
                Some(s) :
                {
                    printf("%v\n", &s);
                },
                None :
                {
                    1 / (1 - 1);
                },
            }
        },
        Err(_) :
        {
            1 / (1 - 1);
        },
    }
}
