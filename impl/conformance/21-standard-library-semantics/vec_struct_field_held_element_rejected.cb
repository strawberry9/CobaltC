// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: [Read-Conflict], D-0189; conf.vec-struct-field-held-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 66697273742031320a
//
// An exclusive reference to g.cells[2], kept where the analysis cannot
// follow it, is live when sum(&mut g) reads g.cells in a loop: the read
// of g.cells[2] meets it. The first call, with no such reference,
// completes. (D-0189's entry test finds the element's object and runs the
// checked body.)

import std;

struct Grid
{
    Vec<i64> cells;
    i64 total;
}

fn sum(ref<Grid, exclusive> g)
{
    for (usize i = 0; i < Vec::len(&g.cells); i += 1)
    {
        g.total += g.cells[i];
    }
}

fn main() : u8
{
    Grid g = Grid { .cells = Vec::filled(4, 3: i64), .total = 0 };
    sum(&mut g);
    printf("first %v\n", g.total);
    Vec<ref<i64, exclusive>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &mut g.cells[2]);
    }
    sum(&mut g);
    printf("second %v\n", g.total);
    *held[0] = 1;
    0
}
