// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: [Read-Conflict], D-0190; conf.vec-struct-in-vec-inner-held
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// An exclusive reference to bags[0].items[1] lives while work(&mut
// bags[0]) reads the field in a loop: the read meets it.

import std;

struct Bag
{
    Vec<i64> items;
    i64 total;
}

fn work(ref<Bag, exclusive> b)
{
    for (usize i = 0; i < Vec::len(&b.items); i += 1)
    {
        b.total += b.items[i];
    }
}

fn main() : u8
{
    Vec<Bag> bags = Vec::new();
    Vec::push(&mut bags, Bag { .items = Vec::filled(3, 1: i64), .total = 0 });
    Vec<ref<i64, exclusive>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &mut bags[0].items[1]);
    }
    work(&mut bags[0]);
    printf("after %v\n", bags[0].total);
    *held[0] = 4;
    0
}
