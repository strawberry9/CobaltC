// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview [Ref-String-View] [Str-Value-View] (D-0302); conf.ref-string-view; conf.str-value-view
// kind: positive
// expect: ok
// expect-stdout-hex: 5b616263206465665d0a5b616263206465665d0a5b6c69745d0a5b68656c6c6f5d0a5b616e6e5d0a5b312d325d0a350a5b6162635d0a5b616263206465665d0a5b616263206465665d0a5b616263206465665d0a5b616263206465665d0a747275650a66616c73650a5b61626320646566215d0a
//
// Where a `StringView` is declared, `&s` of a `String` is `&s[0..$]`: a
// local, a field through a reference, a call's result as an argument
// (`[View-Form-Temporary-Argument]`); a `ref<String, shared>` binding or
// field is `&(*r)[0..$]`; a `str` value is `StringView::of(t)`. Each in the
// positions of `[Str-Literal-View]`: an argument, a local's written type, a
// struct literal's field, a variant's payload (fixed as `StringView` by the
// expected type too). The view borrows `s` until its last use, and a write
// after it is allowed.

import std;

struct Person
{
    String name;
}

struct Label
{
    StringView text;
}

struct Holder
{
    ref<String, shared> r;
}

enum Msg
{
    Say(StringView),
}

const str GREETING = "hello";

fn show(StringView v)
{
    printf("[%s]\n", v);
}

fn pass_on(ref<String, shared> r)
{
    show(r);
}

fn of_str(str t)
{
    show(t);
}

fn through(ref<Person, shared> p)
{
    show(&p.name);
}

fn first_word(StringView v) : StringView
{
    return match (StringView::find(v, " "))
    {
        Some(i) : &v[0..i],
        None    : v,
    };
}

fn main() : u8
{
    String s = "abc def";
    show(&s);
    pass_on(&s);
    of_str("lit");
    str t = GREETING;
    show(t);
    Person p = Person { .name = "ann" };
    through(&p);
    show(&sprintf("%d-%d", 1, 2));
    printf("%d\n", StringView::len(&sprintf("xyz%d", 42)));
    StringView w = &s;
    show(first_word(w));
    Label l = Label { .text = &s };
    show(l.text);
    ref<String, shared> rr = &s;
    show(rr);
    Holder h = Holder { .r = &s };
    show(h.r);
    Msg m = Msg::Say(&s);
    match (m)
    {
        Msg::Say(v) : show(v),
    }
    Option<StringView> o = Some(&s);
    printf("%v\n", Option::is_some(&o));
    printf("%v\n", StringView::contains(&s, &p.name));
    String::append(&mut s, "!");
    show(&s);
    return 0;
}
