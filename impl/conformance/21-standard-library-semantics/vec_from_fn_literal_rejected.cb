// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §1 Vec; conf.vec-from-fn-literal
// kind: negative
// expect: diag.narrowing-overflow (dynamic)
// expect-stdout-hex: 3620302032350a313030203130330a6330206331206332200a332034203720330a300a3239393939350a623020623120623220623320
//
// Vec::from_fn with closure literals: capturing, a capture written per
// call, struct elements, zero length, a long vector, and a conversion
// fault from inside the closure after earlier calls printed (D-0192)

import std;

struct P
{
    i64 a;
    u8 b;
}

fn main()
{
    Vec<i64> sq = Vec::from_fn(6, [](usize i) : i64 { narrow<i64>(i * i) });
    printf("%v %v %v\n", Vec::len(&sq), sq[0], sq[5]);
    i64 base = 100;
    Vec<i64> off = Vec::from_fn(4, [base](usize i) : i64 { base + narrow<i64>(i) });
    printf("%v %v\n", off[0], off[3]);
    i64 calls = 0;
    Vec<P> ps = Vec::from_fn(
        3,
        [calls](usize i) : P { calls += 1; printf("c%v ", i); P { .a = narrow<i64>(i) * 2, .b = 7 } },
    );
    printf("\n%v %v %v %v\n", calls, ps[2].a, ps[1].b, Vec::len(&ps));
    Vec<i64> none = Vec::from_fn(0, [](usize i) : i64 { 1 });
    printf("%v\n", Vec::len(&none));
    Vec<i64> big = Vec::from_fn(100000, [](usize i) : i64 { narrow<i64>(i % 7) });
    i64 t = 0;
    foreach (x in &big)
    {
        t += *x;
    }
    printf("%v\n", t);
    Vec<u8> bad = Vec::from_fn(5, [](usize i) : u8 { printf("b%v ", i); narrow<u8>(250 + i * 2) });
    printf("%v\n", Vec::len(&bad));
}
