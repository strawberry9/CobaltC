// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `Vec::filled<T: clone>` (D-0112, D-0116); conf.vec-filled-resource-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// `filled` copies `x` into every element with `clone`, so a `T` with no
// clone is rejected at the call; `from_fn` makes each element instead.

import std;

resource struct Handle
{
    u32 fd;
}

fn Handle::drop(ref<Handle, exclusive> self)
{
}

fn main()
{
    Vec<Handle> v = Vec::filled(2, Handle { .fd = 1 });
}
