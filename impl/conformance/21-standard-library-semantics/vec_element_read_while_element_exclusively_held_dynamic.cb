// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: D-0023 D-0018 rule.alias.borrow [Borrow-Denied]
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// A read of an element at once conflicts with an exclusive reference to
// that element held in another Vec.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec<ref<i32, exclusive>> h = Vec::new();
    Vec::push(&mut h, Vec::index_exclusive(&mut v, 0));
    printf("held\n");
    i32 a = *Vec::index_shared(&v, 0);
}
