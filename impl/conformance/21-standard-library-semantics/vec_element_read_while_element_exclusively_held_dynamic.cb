// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: D-0023 D-0018 rule.alias.borrow [Borrow-Denied]; conf.vec-element-read-while-element-exclusively-held-dynamic
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// A read of an element at once conflicts with an exclusive reference to
// that element held in another Vec.
//
// D-0290: the reference is stored by a call (`keep_in`), so the frame holds it
// only as `?` (it may hold none of it), and the run checks the access; the
// same program storing it directly is refuted before the run.

import std;

fn keep_in(ref<Vec<ref<i32, exclusive>>, exclusive> keep, ref<i32, exclusive> r)
{
    Vec::push(keep, r);
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec<ref<i32, exclusive>> h = Vec::new();
    keep_in(&mut h, Vec::index_exclusive(&mut v, 0));
    printf("held\n");
    i32 a = *Vec::index_shared(&v, 0);
}
