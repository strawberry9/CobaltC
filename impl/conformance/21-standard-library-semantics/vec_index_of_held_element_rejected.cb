// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `index_of`, [Read-Conflict]; conf.vec-index-of-held-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 6265666f726520310a
//
// Vec::index_of reads each element through the shared vector; an
// exclusive reference to v[0], live, clashes at that read. (cobc's native
// index_of skipped the clash before 2026-10-08.)

import std;

fn main() : u8
{
    Vec<i64> v = Vec::filled(4, 2: i64);
    v[2] = 1;
    Vec::reserve(&mut v, 10);
    Vec<ref<i64, exclusive>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &mut v[0]);
    }
    printf("before %v\n", Vec::len(&held));
    printf("%v\\n", Option::is_some(&Vec::index_of(&v, &1)));
    printf("after %v\n", *held[0]);
    0
}
