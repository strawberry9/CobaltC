// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.hashmap: `HashSet::union`, `intersection`, `difference` (D-0138); conf.hashset-union, conf.hashset-intersection, conf.hashset-difference
// kind: positive
// expect: ok
// expect-stdout-hex: 756e696f6e3a207065617220666967206170706c65206b69776920706c756d20646174650a696e74657273656374696f6e3a2070656172206b6977690a61202d20623a20666967206170706c650a62202d20613a20706c756d20646174650a613a207065617220666967206170706c65206b6977690a623a20706c756d206b697769207065617220646174650a
//
// The set operations make new sets and leave their arguments as they
// were. Their keys keep the first set's order; `union` then adds the
// second set's keys that the first lacks, in the second's order. The
// keys are copied (`clone`), so a set of `String`s gives a set of its own.

import std;

fn show(str name, ref<HashSet<String>, shared> s)
{
    printf("%s:", name);
    foreach (i in 0..HashSet::len(s))
    {
        printf(" %s", HashSet::key_at(s, i));
    }
    printf("\n");
}

fn main()
{
    HashSet<String> a = HashSet::new();
    HashSet<String> b = HashSet::new();
    foreach (w in ["pear", "fig", "apple", "kiwi"])
    {
        HashSet::insert(&mut a, String::from_str(w));
    }
    foreach (w in ["plum", "kiwi", "pear", "date"])
    {
        HashSet::insert(&mut b, String::from_str(w));
    }
    show("union", &HashSet::union(&a, &b));
    show("intersection", &HashSet::intersection(&a, &b));
    show("a - b", &HashSet::difference(&a, &b));
    show("b - a", &HashSet::difference(&b, &a));
    show("a", &a);
    show("b", &b);

    HashSet<String> none = HashSet::new();
    assert(HashSet::len(&HashSet::intersection(&a, &none)) == 0);
    assert(HashSet::len(&HashSet::union(&none, &a)) == 4);
    assert(HashSet::len(&HashSet::difference(&a, &a)) == 0);
    assert(HashSet::len(&HashSet::union(&a, &a)) == 4);
}
