// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.hashmap [Key-Not-Hashable] (D-0110); conf.hashmap-key-float-field-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// A struct with a field that is not a key type (here `f64`) is not one;
// the message names the field.

import std;

struct P
{
    i32 id;
    f64 w;
}

fn main()
{
    HashMap<P, u32> m = HashMap::new();
    HashMap::insert(&mut m, P { .id = 1, .w = 0.5 }, 1);
}
