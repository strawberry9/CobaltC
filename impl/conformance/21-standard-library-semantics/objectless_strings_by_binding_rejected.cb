// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/05, D-0196; conf.objectless-strings-by-binding
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
// expect-stdout-hex: 31322031380a233939e29c932834292023313030e29c93283529202331283229202331283229200a233120796573206e6f0a3720747275652066616c736520747275650a5b7a5d0a
//
// String locals declared under the same name in several blocks, built
// with append/truncate/push_code_point/clear/push_ascii and returned from
// several places, a function whose result is not its own local, HashMap
// lookups by str (get_str, contains_str, remove_str), and truncate past
// the end faulting (D-0196: cobc keeps such Strings without runtime
// objects)

import std;

// The same name declared in several blocks: each binding on its own.
fn per_binding(u32 mode) : usize
{
    usize n = 0;
    if (mode == 0)
    {
        String s = String::from_str("first");
        n += String::len(&s);
    }
    else
    {
        String s = String::from_str("second one");
        String::append(&mut s, "!");
        n += String::len(&s);
    }
    for (usize i = 0; i < 3; i += 1)
    {
        String s = sprintf("%v", i * 111);
        n += String::len(&s);
    }
    n
}

// Built with builders, returned from several places.
fn tag(u64 i) : String
{
    String t = String::from_str("#");
    String::append(&mut t, i);
    if (i > 100)
    {
        String::truncate(&mut t, 2);
        return t;
    }
    String::push_code_point(&mut t, 0x2713);
    t
}

// A result that is not a local of its own: no raw form.
fn pick(bool b) : String
{
    if (b)
    {
        return String::from_str("yes");
    }
    String n = String::from_str("no");
    n
}

fn main()
{
    printf("%v %v\n", per_binding(0), per_binding(1));
    Vec<String> kept = Vec::new();
    for (u64 i = 99; i < 103; i += 1)
    {
        String a = tag(i);
        printf("%s(%v) ", &a, String::char_count(&a));
        Vec::push(&mut kept, tag(i * 2));
    }
    printf("\n%s %s %s\n", &kept[0], &pick(true), &pick(false));
    HashMap<String, u64> m = HashMap::new();
    _ = HashMap::insert(&mut m, String::from_str("k7"), 7);
    _ = HashMap::insert(&mut m, String::from_str("é"), 9);
    printf(
        "%v %v %v %v\n",
        Option::unwrap_or(HashMap::get_str(&m, "k7"), &0),
        HashMap::contains_str(&m, "é"),
        HashMap::contains_str(&m, "k8"),
        Option::is_some(&HashMap::remove_str(&mut m, "k7")),
    );
    String c = String::from_str("abc");
    String::clear(&mut c);
    String::push_ascii(&mut c, b'z');
    printf("[%s]\n", &c);
    String last = tag(7);
    String::truncate(&mut last, 9);
    printf("unreached %s\n", &last);
}
