// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview [Ref-String-View] (D-0302); conf.ref-string-view-borrow-clash-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `StringView w = &s;` borrows `s` as `&s[0..$]` does, until `w`'s last
// use: appending to `s` before that use clashes.

import std;

fn main() : u8
{
    String s = "abc";
    StringView w = &s;
    String::append(&mut s, "x");
    printf("%s\n", w);
    return 0;
}
