// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: [Cmp-Text] (D-0312: the three text types compared by their bytes, equality and order, either way round); conf.text-mixed-order
// kind: positive
// expect: ok
// expect-stdout-hex: 7472756520747275652066616c736520747275650a7472756520747275652066616c736520747275650a6162630a
//
// `String`, `str` and `StringView` are ordered by their bytes in any
// combination, either side, as each is with itself; a `String` operand is
// borrowed for the comparison, not moved (`s` is used after). Before D-0312
// two texts of different types compared with `==` and `!=` only.

import std;

fn main()
{
    String s = "abc";
    StringView v = "abd";
    str t = "abb";
    printf("%v %v %v %v\n", (s < v), (v > s), (s <= t), (t < v));
    printf("%v %v %v %v\n", (v >= t), (s > t), (s == v), (t != s));
    printf("%v\n", &s);
}
