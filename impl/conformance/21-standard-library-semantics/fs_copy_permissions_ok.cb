// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.path [Copy-Permissions] (D-0272); conf.fs-copy-permissions
// kind: positive
// expect: ok
// expect-stdout-hex: 636f706965640a73616d6520726561642d6f6e6c7920666c61673a20747275650a66726f6d3a204e6f74466f756e640a746f3a204e6f74466f756e640a
//
// `copy_permissions(a, b)` gives `b` the permissions of `a` (its mode bits
// on Unix, its read-only flag on Windows), as the write-then-rename pattern
// needs; `Err(NotFound)` when nothing is at either path. The files live in
// a directory of their own under the system's temporary directory.

import std;

fn main() : u8
{
    String tmp = temp_dir();
    String dir = path_join(String::as_view(&tmp), String::as_view(&sprintf("cb-conf-perm-%v", process_id())));
    _ = make_dir_all(String::as_view(&dir));
    String a = path_join(String::as_view(&dir), "a.txt");
    String b = path_join(String::as_view(&dir), "b.txt");
    String gone = path_join(String::as_view(&dir), "gone.txt");
    _ = write_file(String::as_view(&a), "a");
    _ = write_file(String::as_view(&b), "b");
    match (copy_permissions(String::as_view(&a), String::as_view(&b)))
    {
        Ok(_)  : printf("copied\n"),
        Err(e) : printf("failed: %s\n", FileError::text(&e)),
    }
    bool ra = Result::unwrap(file_info(String::as_view(&a))).readonly;
    bool rb = Result::unwrap(file_info(String::as_view(&b))).readonly;
    printf("same read-only flag: %v\n", ra == rb);
    match (copy_permissions(String::as_view(&gone), String::as_view(&b)))
    {
        Err(NotFound) : printf("from: NotFound\n"),
        _             : printf("from: unexpected\n"),
    }
    match (copy_permissions(String::as_view(&a), String::as_view(&gone)))
    {
        Err(NotFound) : printf("to: NotFound\n"),
        _             : printf("to: unexpected\n"),
    }
    _ = remove_dir_all(String::as_view(&dir));
    0
}
