// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.bigint [BigUint] (D-0157); conf.bigint-arithmetic, conf.bigint-text
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// `BigUint` arithmetic against Python's integers: sum, difference,
// product, quotient and remainder, a modular power, shifts, comparison,
// decimal text both ways, and big-endian bytes both ways.

import std;

fn main() : u8
{
    BigUint a = Result::unwrap_or(
        BigUint::parse("1606938044258990275541962092341162602522215339461694069869266"),
        BigUint::zero(),
    );
    BigUint b = Result::unwrap_or(BigUint::parse("987654321987654321987654321"), BigUint::zero());
    BigUint m = Result::unwrap_or(BigUint::parse("170141183460469231731687303715884105727"), BigUint::zero());
    printf("%s\n", &BigUint::text(&BigUint::add(&a, &b)));
    printf("%s\n", &BigUint::text(&BigUint::sub(&a, &b)));
    printf("%s\n", &BigUint::text(&BigUint::mul(&a, &b)));
    BigDivision d = BigUint::div_rem(&a, &b);
    printf("%s %s\n", &BigUint::text(&d.quotient), &BigUint::text(&d.remainder));
    printf("%s\n", &BigUint::text(&BigUint::mod_pow(&a, &b, &m)));
    printf("%s %s\n", &BigUint::text(&BigUint::shift_left(&b, 70)), &BigUint::text(&BigUint::shift_right(&a, 70)));
    printf(
        "%v %v %v %u\n",
        BigUint::less(&b, &a),
        BigUint::eq(&a, &a),
        BigUint::is_zero(&BigUint::zero()),
        BigUint::bit_len(&a),
    );
    Vec<u8> bytes = BigUint::to_bytes_be(&b);
    printf("%s %v\n", &to_hex(&bytes[0..$]), BigUint::eq(&BigUint::from_bytes_be(&bytes[0..$]), &b));
    printf(
        "%s %s\n",
        &to_hex(&BigUint::to_bytes_be_padded(&BigUint::from_u64(258), 4)[0..$]),
        &BigUint::text(&BigUint::zero()),
    );
    match (BigUint::parse("12x4"))
    {
        Ok(_)  : printf("parsed?\n"),
        Err(e) : printf("12x4: %s\n", ParseError::text(&e)),
    }
    0
}
