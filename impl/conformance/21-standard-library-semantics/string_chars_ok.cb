// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview `String::chars`, `StringView::chars` (D-0128); conf.string-chars, conf.stringview-chars, conf.string-chars-empty
// kind: positive
// expect: ok
// expect-stdout-hex: 6f6b0a
//
// The characters of a text, in order, each a view of that one character's
// bytes (one to four); the views compare, match and print as text, and
// borrow the `String` as any view does. Empty text has no characters.

import std;

fn main()
{
    String s = "caf\u{e9} \u{1F600}!";          // é is 2 bytes, the emoji 4
    Vec<StringView> cs = String::chars(&s);
    assert(Vec::len(&cs) == 7 && String::len(&s) == 11);
    assert(cs[0] == "c" && cs[3] == "\u{e9}" && cs[5] == "\u{1F600}" && cs[6] == "!");
    assert(StringView::len(cs[3]) == 2 && StringView::len(cs[5]) == 4);

    // Every byte is in exactly one character, in order.
    String again = String::new();
    foreach (c in &cs)
    {
        String::append(&mut again, *c);
    }
    assert(again == s);

    // Reversed by characters, not bytes: the multi-byte ones stay whole.
    Vec::reverse(&mut cs);
    String r = String::new();
    foreach (c in &cs)
    {
        String::append(&mut r, *c);
    }
    assert(String::eq_str(&r, "!\u{1F600} \u{e9}fac"));

    // A view's characters: here of the second word.
    Vec<StringView> words = String::split(&s, " ");
    Vec<StringView> ws = StringView::chars(words[1]);
    assert(Vec::len(&ws) == 2 && ws[0] == "\u{1F600}");

    // Text patterns on a character.
    i32 k = match (String::chars(&s)[3])
    {
        "e"      : 1,
        "\u{e9}" : 2,
        _        : 0,
    };
    assert(k == 2);

    // Empty text: no characters.
    String empty = String::new();
    assert(Vec::len(&String::chars(&empty)) == 0);
    assert(Vec::len(&StringView::chars(&s[0 .. 0])) == 0);
    printf("ok\n");
}
