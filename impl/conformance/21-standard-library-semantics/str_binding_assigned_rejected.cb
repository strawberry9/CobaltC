// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str [Str-Literal-String] (D-0304, D-0006): a `str` binding is not a literal; conf.str-binding-assigned-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// `s = t;` with `t` a `str`: the value is converted by nothing; a copy is
// written `String::from_view(t)`.

import std;

fn main()
{
    str t = "x";
    String s = "a";
    s = t;
}
