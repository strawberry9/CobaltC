// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.swap [Swap-Places] (p = q: unchanged); D-0022
// kind: positive
// expect: ok
//
// `swap(&mut a, &mut a)` passes two exclusive references to one place;
// D-0022 admits that at the call, and `[Swap-Places]` has no conflict
// premise: the place is left as it is. cobc once faulted
// (diag.aliasing-conflict) where coby, and the rule, do not.

import std;

struct P
{
    i64 x;
    i64 y;
}

fn main()
{
    i64 a = 7;
    swap(&mut a, &mut a);
    P p = P { .x = 1, .y = 2 };
    swap(&mut p.x, &mut p.x);
    swap(&mut p.x, &mut p.y);
    array<i64, 2> arr = [3, 4];
    swap(&mut arr[1], &mut arr[1]);
    if (a != 7 || p.x != 2 || p.y != 1 || arr[1] != 4)
    {
        fault(index_out_of_bounds);
    }
}
