// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: diag.index-out-of-bounds
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// A vector used only through push and element writes: the writes inside
// its length succeed, and the first past it faults.

import std;

fn main()
{
    Vec<u8> v = Vec::new();
    usize i = 0;
    while (i < 3)
    {
        Vec::push(&mut v, 1);
        i = i + 1;
    }
    usize k = 0;
    while (k <= 3)
    {
        *Vec::index_exclusive(&mut v, k) = 2;
        printf("set\n");
        k = k + 1;
    }
}
