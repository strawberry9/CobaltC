// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `swap`, `reverse`, `insert`, `truncate`, `clone`, `append`, `binary_search`, `extend_from`, `reserve`; conf.vec-element-moves
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// Vec's element-moving operations on plain elements, at their edges
// (equal positions, empty and one-element vectors, insertion at both ends
// and with growth, truncation past the end, appending an empty vector,
// binary search over runs of equal keys, bool and empty vectors), on
// elements that have been borrowed before, and on a struct element type.
// (cobc's native bodies, 2026-10-08, must leave what the prelude's leave.)

import std;

struct P
{
    i32 a;
    u8 b;
}

fn show(ref<Vec<i64>, shared> v) : String
{
    String s = String::new();
    foreach (x in v)
    {
        String::append(&mut s, *x);
        String::append(&mut s, " ");
    }
    s
}

fn bump(ref<i64, exclusive> x)
{
    *x += 100;
}

fn main()
{
    Vec<i64> v = Vec::new();
    foreach (i in 0..7: i64)
    {
        Vec::push(&mut v, i * 3);
    }
    bump(&mut v[2]);
    Vec::swap(&mut v, 0, 6);
    Vec::swap(&mut v, 3, 3);
    printf("swap: %s\n", &show(&v));
    Vec::reverse(&mut v);
    printf("reverse: %s\n", &show(&v));
    Vec<i64> e = Vec::new();
    Vec::reverse(&mut e);
    Vec<i64> one = Vec::filled(1, 9: i64);
    Vec::reverse(&mut one);
    printf("reverse small: %v %v\n", Vec::len(&e), one[0]);
    Vec::insert(&mut v, 0, -1);
    Vec::insert(&mut v, Vec::len(&v), 77);
    Vec::insert(&mut v, 4, 55);
    printf("insert: %s\n", &show(&v));
    Vec<i64> grown = Vec::new();
    foreach (i in 0..40: i64)
    {
        Vec::insert(&mut grown, narrow<usize>(i / 2), i);
    }
    printf("insert grow: %v %v %v %v\n", Vec::len(&grown), grown[0], grown[20], grown[39]);
    Vec<i64> c = Vec::clone(&v);
    c[0] = 1000;
    printf("clone: %s| %s\n", &show(&c), &show(&v));
    Vec<i64> ce = Vec::clone(&e);
    printf("clone empty: %v\n", Vec::len(&ce));
    bump(&mut v[1]);
    Vec::truncate(&mut v, 20);
    printf("truncate past: %v\n", Vec::len(&v));
    Vec::truncate(&mut v, 3);
    printf("truncate: %s\n", &show(&v));
    Vec::push(&mut v, 5);
    printf("after: %s\n", &show(&v));
    Vec<i64> b = Vec::filled(30, 4: i64);
    bump(&mut b[29]);
    Vec::append(&mut v, b);
    Vec::append(&mut v, Vec::new());
    printf("append: %v %v %v\n", Vec::len(&v), v[4], v[33]);
    Vec<i64> sorted = Vec::new();
    foreach (i in 0..10: i64)
    {
        Vec::push(&mut sorted, (i / 2) * 10);
    }
    foreach (k in -5..50: i64)
    {
        match (Vec::binary_search(&sorted, &k))
        {
            Ok(i)  : printf("%v=Ok%v ", k, i),
            Err(i) : if (k % 10 == 5) { printf("%v=Err%v ", k, i); },
        }
    }
    printf("\n");
    Vec<bool> bs = Vec::new();
    Vec::push(&mut bs, false);
    Vec::push(&mut bs, true);
    printf(
        "bool search: %v %v\n",
        Result::is_ok(&Vec::binary_search(&bs, &true)),
        Result::unwrap(Vec::binary_search(&bs, &false)),
    );
    printf("empty search: %v\n", Result::is_err(&Vec::binary_search(&e, &3)));
    Vec<P> ps = Vec::filled(3, P { .a = 1, .b = 2 });
    ps[2].a = 9;
    Vec::reverse(&mut ps);
    Vec::insert(&mut ps, 1, P { .a = 7, .b = 7 });
    Vec<P> pc = Vec::clone(&ps);
    Vec::swap(&mut pc, 0, 3);
    Vec::truncate(&mut pc, 2);
    printf("structs: %v %v %v %v\n", ps[0].a, ps[1].a, pc[0].a, Vec::len(&pc));
    Vec<i64> big = Vec::new();
    Vec::reserve(&mut big, 3);
    foreach (i in 0..3000: i64)
    {
        Vec::push(&mut big, i);
    }
    bump(&mut big[1500]);
    Vec::reserve(&mut big, 500000);
    Vec<i64> big2 = Vec::new();
    foreach (r in 0..5)
    {
        Vec::extend_from(&mut big2, &big[0..$]);
    }
    printf("big: %v %v %v\n", big[1500], Vec::len(&big2), big2[4500]);
    Vec::retain(&mut big2, [](ref<i64, shared> x) : bool { *x % 1000 == 0 });
    Vec::dedup(&mut big2);
    printf("retain/dedup: %v\n", Vec::len(&big2));
    Vec::clear(&mut big);
    printf("clear: %v\n", Vec::len(&big));
}
