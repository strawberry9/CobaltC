// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.arith.float-fns [Float-Fn-Operand]; conf.float-fn-int-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// `sqrt` and the rounding functions take `f32` or `f64` only; an integer
// is converted explicitly with `to_float<f64>(…)`.

import std;

fn main()
{
    i32 n = 16;
    f64 r = sqrt(n);
    printf("%v\n", r);
}
