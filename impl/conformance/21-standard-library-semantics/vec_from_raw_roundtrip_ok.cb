// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.ffi `Vec::from_raw`, `copy_to_raw` (D-0257); [Trusted-Call]; conf.vec-from-raw-roundtrip
// kind: positive
// expect: ok
// expect-stdout-hex: 3130203230203330203430200a34303030300a
//
// Plain data crosses raw memory whole: `copy_to_raw` writes a slice's
// elements into storage from `allocate`, and `Vec::from_raw` copies them
// back into a `Vec` the checks then cover; both inside `unsafe`, the
// program vouching for the storage.

import std;

struct Cell
{
    u16 id;
    u32 value;
}

fn main()
{
    Vec<u32> tens = Vec::new();
    for (u32 i = 1; i <= 4; i += 1)
    {
        Vec::push(&mut tens, i * 10);
    }
    rawptr<u8> raw = Result::unwrap(allocate(16, 4));
    rawptr<u32> p = reinterpret_ptr<u32>(raw);
    unsafe
    {
        copy_to_raw(&tens[0 .. $], p);
    }
    Vec<u32> back = unsafe { Vec::from_raw(p, 4) };
    foreach (x in &back)
    {
        printf("%v ", *x);
    }
    printf("\n");
    unsafe
    {
        deallocate(raw, 16, 4);
    }
    Vec<Cell> cells = Vec::new();
    Vec::push(&mut cells, Cell { .id = 1, .value = 40000 });
    rawptr<u8> raw2 = Result::unwrap(allocate(sizeof<Cell>(), alignof<Cell>()));
    rawptr<Cell> q = reinterpret_ptr<Cell>(raw2);
    unsafe
    {
        copy_to_raw(&cells[0 .. $], q);
    }
    Vec<Cell> back2 = unsafe { Vec::from_raw(q, 1) };
    printf("%v\n", back2[0].value);
    unsafe
    {
        deallocate(raw2, sizeof<Cell>(), alignof<Cell>());
    }
}
