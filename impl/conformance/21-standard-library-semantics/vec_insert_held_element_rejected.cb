// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `insert`, [Borrow-Denied]; conf.vec-insert-held-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 6265666f726520310a
//
// Vec::insert(&mut v, 0, 5) with room to spare moves every element up by
// swaps; the swap that borrows v[0] clashes with a live shared reference
// to it. (With no room, the growth would end v[0]'s object first and the
// reference would be stale at its next use instead.)

import std;

fn main() : u8
{
    Vec<i64> v = Vec::filled(4, 2: i64);
    v[2] = 1;
    Vec::reserve(&mut v, 10);
    Vec<ref<i64, shared>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &v[0]);
    }
    printf("before %v\n", Vec::len(&held));
    Vec::insert(&mut v, 0, 5);
    printf("after %v\n", *held[0]);
    0
}
