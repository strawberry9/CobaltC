// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview `[Str-Value-View]` (D-0302); conf.view-of-str-binding
// kind: positive
// expect: ok
// expect-stdout-hex: 6162630a
//
// A `str` binding has type `str`; where a local is declared `StringView` it
// is `StringView::of(t)` (D-0302). Under D-0134 alone this was rejected.

import std;

fn main()
{
    str t = "abc";
    StringView v = t;
    printf("%s\n", v);
}
