// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.collections `slice_parts`; D-0204; conf.slice-parts
// kind: positive
// expect: ok
// expect-stdout-hex: 332070617274733a2034203320330a31322070617274733a2031203120312031203120312031203120312031203020300a302070617274733a0a313131313232323333330a
//
// `slice_parts` splits an exclusive slice into consecutive, disjoint runs as
// nearly equal as they can be, the first ones one longer: 10 elements in 3
// parts are 4, 3 and 3; in 12, ten of one and two empty; in 0, none. The
// parts are exclusive slices at once, and each can go to a thread of its
// own, which writes its run while the others write theirs.

import std;

fn lengths(ref<Vec<u64>, exclusive> v, usize parts) : String
{
    Vec<slice<u64, exclusive>> ps = slice_parts(&mut v[0..$], parts);
    String out = sprintf("%v parts:", Vec::len(&ps));
    foreach (p in &ps)
    {
        String::append(&mut out, &sprintf(" %v", slice_len(*p)));
    }
    out
}

fn mark(slice<u64, exclusive> s, u64 k)
{
    for (usize i = 0; i < slice_len(s); i += 1)
    {
        s[i] = k;
    }
}

fn main()
{
    Vec<u64> v = Vec::filled(10, 0: u64);
    printf("%s\n", &lengths(&mut v, 3));
    printf("%s\n", &lengths(&mut v, 12));
    printf("%s\n", &lengths(&mut v, 0));
    {
        Vec<slice<u64, exclusive>> ps = slice_parts(&mut v[0..$], 3);
        Vec<handle<void>> hs = Vec::new();
        u64 k = 1;
        while (Vec::len(&ps) > 0)
        {
            Vec::push(&mut hs, spawn(mark, Vec::remove(&mut ps, 0), k));
            k += 1;
        }
        foreach (h in hs)
        {
            join(h);
        }
    }
    foreach (x in &v)
    {
        printf("%v", *x);
    }
    printf("\n");
}
