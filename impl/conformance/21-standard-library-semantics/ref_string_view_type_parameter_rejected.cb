// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview [Ref-String-View] (D-0302); conf.ref-string-view-type-parameter-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// A parameter whose type is a type parameter is not declared `StringView`,
// even where `T` is given as one: the argument is what fixes `T`, as for a
// literal (D-0134).

import std;

fn id<T>(T x) : T
{
    return x;
}

fn main() : u8
{
    String s = "abc";
    StringView w = id<StringView>(&s);
    printf("%s\n", w);
    return 0;
}
