// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.view [View-Sub] (D-0053); conf.view-sub-not-char-boundary
// kind: negative
// expect: diag.not-char-boundary (dynamic)
//
// `StringView::sub` takes whole characters: an end inside the two bytes
// of `é` is the fault, after the bounds check has passed.

import std;

fn main()
{
    StringView v = "é!";
    printf("%u\n", StringView::len(StringView::sub(v, 0, 2)));
    printf("%u\n", StringView::len(StringView::sub(v, 0, 1)));
}
