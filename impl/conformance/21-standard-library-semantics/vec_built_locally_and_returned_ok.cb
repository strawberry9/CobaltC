// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: D-0023 rule.stdlib.vec
// kind: positive
// expect: ok
//
// A vector filled only through push and returned as the function's
// result; the caller then holds a reference to one of its elements.

import std;

fn build(usize n) : Vec<u64>
{
    Vec<u64> v = Vec::new();
    usize i = 0;
    while (i < n)
    {
        Vec::push(&mut v, widen<u64>(i) * 3);
        i = i + 1;
    }
    v
}

fn main()
{
    Vec<u64> w = build(100);
    ref<u64, shared> r = Vec::index_shared(&w, 99);
    if (*r != 297)
    {
        1 / (1 - 1);
    }
}
