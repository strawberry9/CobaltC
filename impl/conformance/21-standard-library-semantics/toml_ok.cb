// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.toml [Toml-Parse] [Toml-Tables] [Toml-Text] [Toml-Get] [Toml-Set] [Toml-Error] (D-0268); conf.toml-parse, conf.toml-tables, conf.toml-text, conf.toml-tree, conf.toml-errors
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// A document with every kind of value (the four string forms and their
// escapes, integers in four bases with underscores, floats with an
// exponent, `inf` and `nan`, the four date-time forms, arrays over several
// lines with comments and a trailing comma, inline tables), tables, dotted
// and quoted keys, arrays of tables, and a sub-table of an array element;
// read with `get`/`at`/`lookup`/`as_*`, built with `set`/`push`, written
// back and read again; and each kind of refusal with its position.

import std;

fn show(ref<Toml, shared> t) : String
{
    match (t)
    {
        TomlString(s)      : sprintf("%v", s),
        TomlInteger(i)     : sprintf("%v", *i),
        TomlFloat(x)       : sprintf("%v", *x),
        TomlBool(b)        : sprintf("%v", *b),
        TomlDateTime(d)    :
        {
            TomlDateKind kind = d.kind;
            str form = match (kind)
            {
                TomlOffsetDateTime : "offset",
                TomlLocalDateTime  : "local date-time",
                TomlLocalDate      : "local date",
                TomlLocalTime      : "local time",
            };
            sprintf("%v (%v) %v", d.kind, form, &TomlDateTime::text(d))
        },
        TomlArray(items)   : sprintf("array of %v", Vec::len(items)),
        TomlTable(members) : sprintf("table of %v", Vec::len(members)),
    }
}

fn at(ref<Toml, shared> doc, str path) : String
{
    match (Toml::lookup(doc, StringView::of(path)))
    {
        Some(v) : show(v),
        None    : String::from_str("none"),
    }
}

fn refusal(str text) : String
{
    match (Toml::parse(StringView::of(text)))
    {
        Ok(_)           : String::from_str("accepted"),
        Err(Invalid(i)) : sprintf("invalid at %v", i),
        Err(Empty)      : String::from_str("empty"),
        Err(OutOfRange) : String::from_str("out of range"),
    }
}

fn main()
{
    String source = "# a document\ntitle = \"TOML \\\"Example\\\"\\t\\u00e9\\U0001F600\"\nlit = 'C:\\Users\\n'\nml = \"\"\"\nRoses\\n  are \\\n    red\"\"\"\nmll = '''\nno \\escapes here\n'''\n\n[numbers]\nint = +1_000\nneg = -17\nhex = 0xDEAD_beef\noct = 0o755\nbin = 0b1010\nflt = 6.626e-34\nexp = 1E2\ninf = -inf\nnan = nan\nzero = -0.0\n\n[dates]\nodt = 1979-05-27T07:32:00.999Z\nodt2 = 1979-05-27 00:32:00-07:00\nldt = 1979-05-27T07:32:00\nld = 1979-05-27\nlt = 07:32:00.5\n\n[arrays]\nints = [ 1, 2, 3, ]\nnested = [ [ 1, 2 ], [\"a\", \"b\"] ] # mixed nesting\nmulti = [\n  1,  # one\n  2,\n]\nmixed = [1, 1.5, \"x\", true]\n\n[inline]\npoint = { x = 1, y = 2 }\nnested.deep = { a.b = \"c\" }\n\"quoted key\" = 'yes'\n'literal.key' = 2\n\n[[servers]]\nname = \"alpha\"\nip = \"10.0.0.1\"\n[servers.limits]\nmax = 10\n[[servers]]\nname = \"beta\"\n\n[a.b.c]\nd = 1\n[a]\ne = 2\n";
    Toml doc = Result::unwrap(Toml::parse(String::as_view(&source)));
    printf("%v\n%v\n%v\n%v\n", &at(&doc, "title"), &at(&doc, "lit"), &at(&doc, "ml"), &at(&doc, "mll"));
    printf(
        "%v %v %v %v %v\n",
        &at(&doc, "numbers.int"),
        &at(&doc, "numbers.neg"),
        &at(&doc, "numbers.hex"),
        &at(&doc, "numbers.oct"),
        &at(&doc, "numbers.bin"),
    );
    printf(
        "%v %v %v %v %v\n",
        &at(&doc, "numbers.flt"),
        &at(&doc, "numbers.exp"),
        &at(&doc, "numbers.inf"),
        &at(&doc, "numbers.nan"),
        &at(&doc, "numbers.zero"),
    );
    printf(
        "%v\n%v\n%v\n%v\n%v\n",
        &at(&doc, "dates.odt"),
        &at(&doc, "dates.odt2"),
        &at(&doc, "dates.ldt"),
        &at(&doc, "dates.ld"),
        &at(&doc, "dates.lt"),
    );
    printf(
        "%v | %v %v | %v %v | %v %v\n",
        &at(&doc, "arrays.ints"),
        &at(&doc, "arrays.nested"),
        &at(&doc, "arrays.nested.1.0"),
        &at(&doc, "arrays.multi"),
        &at(&doc, "arrays.multi.1"),
        &at(&doc, "arrays.mixed"),
        &at(&doc, "arrays.mixed.1"),
    );
    printf(
        "%v %v %v %v\n",
        &at(&doc, "inline.point.y"),
        &at(&doc, "inline.nested.deep.a.b"),
        &at(&doc, "inline.quoted key"),
        &at(&doc, "inline.literal.key"),
    );
    printf(
        "%v | %v %v %v | %v %v\n",
        &at(&doc, "servers"),
        &at(&doc, "servers.0.name"),
        &at(&doc, "servers.0.limits.max"),
        &at(&doc, "servers.1.name"),
        &at(&doc, "a.b.c.d"),
        &at(&doc, "a.e"),
    );
    printf("%v %v %v\n", &at(&doc, "inline.literal"), &at(&doc, "servers.2"), &at(&doc, "numbers.int.x"));
    TomlDateTime odt = Option::unwrap(Toml::as_datetime(Option::unwrap(Toml::lookup(&doc, "dates.odt2"))));
    printf(
        "%v %v %v %v %v %v %v %v\n",
        odt.year,
        odt.month,
        odt.day,
        odt.hour,
        odt.minute,
        odt.second,
        odt.nanoseconds,
        odt.offset_minutes,
    );

    // The tree read directly, and `as_*` on the wrong kind.
    Toml top = TomlTable(Vec::new());
    match (Toml::as_table(&doc))
    {
        Some(members) :
        {
            ref<TomlMember, shared> first = &members[0];
            printf(
                "%v members, first %v = %v\n",
                Vec::len(members),
                &first.key,
                Option::unwrap(Toml::as_text(&first.value)),
            );
        },
        None          : printf("not a table\n"),
    }
    printf(
        "%v %v %v\n",
        Option::unwrap(Toml::as_bool(Option::unwrap(Toml::lookup(&doc, "arrays.mixed.3")))),
        Option::is_none(&Toml::as_bool(&doc)),
        Vec::len(Option::unwrap(Toml::as_array(Option::unwrap(Toml::lookup(
            &doc,
            "arrays.ints",
        ))))) + widen<usize>(if (Option::is_none(&Toml::as_array(&doc))) { 100: u8 } else { 0 }),
    );
    Json j = Result::unwrap(Json::parse("{\"servers\": [{\"host\": \"a\"}, {\"host\": \"b\"}]}"));
    printf(
        "json lookup %v %v\n",
        Option::unwrap(Json::as_text(Option::unwrap(Json::lookup(&j, "servers.1.host")))),
        Option::is_none(&Json::lookup(&j, "servers.2")),
    );
    ref<Toml, shared> nums = Option::unwrap(Toml::get(&doc, "numbers"));
    printf(
        "%v %v %v %v\n",
        Option::is_none(&Toml::as_i64(Option::unwrap(Toml::get(nums, "flt")))),
        Option::is_none(&Toml::as_f64(Option::unwrap(Toml::get(nums, "int")))),
        Option::is_none(&Toml::get(nums, "missing")),
        Option::is_none(&Toml::at(nums, 0)),
    );

    // Built, written, read back: the plain members of a table before its sub-tables.
    Toml::set(&mut top, "name", TomlString(String::from_str("x \"y\"\n")));
    Toml ports = TomlArray(Vec::new());
    Toml::push(&mut ports, TomlInteger(80));
    Toml::push(&mut ports, TomlInteger(443));
    Toml server = TomlTable(Vec::new());
    Toml::set(&mut server, "ports", ports);
    Toml::set(&mut server, "ratio", TomlFloat(0.5));
    Toml::set(&mut server, "when", TomlDateTime(odt));
    Toml::set(&mut top, "server", server);
    Toml::set(&mut top, "a b", TomlBool(true));
    Toml users = TomlArray(Vec::new());
    Toml u = TomlTable(Vec::new());
    Toml::set(&mut u, "name", TomlString(String::from_str("ann")));
    Toml::push(&mut users, u);
    Toml::set(&mut top, "users", users);
    Toml::set(&mut top, "name", TomlString(String::from_str("renamed")));
    String text = Toml::text(&top);
    printf("%v", &text);
    printf("round trip: %v\n", Toml::text(&Result::unwrap(Toml::parse(String::as_view(&text)))) == text);
    printf("%v\n", &Toml::text(Option::unwrap(Toml::lookup(&doc, "arrays.mixed"))));
    printf("%v\n", &Toml::text(Option::unwrap(Toml::lookup(&doc, "inline.point"))));
    printf("%v\n", &Toml::text(&Result::unwrap(Toml::parse(""))));

    // Refusals.
    printf(
        "%v | %v | %v | %v\n",
        &refusal("a = 1\na = 2"),
        &refusal("[t]\n[t]"),
        &refusal("t = {}\n[t.u]"),
        &refusal("[t]\nx.y = 1\n[t.x]"),
    );
    printf(
        "%v | %v | %v | %v\n",
        &refusal("a = \"\\q\""),
        &refusal("a = 'line\nbreak'"),
        &refusal("a = 1 b = 2"),
        &refusal("a = 01"),
    );
    printf(
        "%v | %v | %v | %v\n",
        &refusal("n = 9223372036854775808"),
        &refusal("x = 0xFFFF_FFFF_FFFF_FFFF"),
        &refusal("f = 1e400"),
        &refusal("d = 1979-02-30"),
    );
    printf(
        "%v | %v | %v | %v\n",
        &refusal("a = {b = 1,}"),
        &refusal("a = [1 2]"),
        &refusal("# bad \u{1} byte"),
        &refusal("a = \"\\uD800\""),
    );
    printf(
        "%v | %v | %v | %v\n",
        &refusal("[[t]]\n[t]"),
        &refusal("t = [1]\n[[t]]"),
        &refusal("a.b = 1\n[a.b.c]\nd = 1\n[a.b]"),
        &refusal("[a.b.c]\nz = 9\n[a]\nb.c.t = 1"),
    );
    printf("%v | %v | %v\n", &refusal("a = 1_\n"), &refusal("key = \"ok\"\r\nnext = 2\rbad = 3"), &refusal("= 1"));
}
