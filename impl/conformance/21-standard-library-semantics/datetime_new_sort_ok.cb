// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.time `DateTime::new`, `DateTime::eq`, `DateTime::less`, [Unix-Ms] (D-0140); conf.datetime-new, conf.datetime-sort, conf.unix-ms
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// `new` refuses fields that name no moment; `less` sorts a `Vec` of
// `DateTime`s by `Vec::sort_by`, earliest first, and `eq` finds equal
// moments. `unix_ms() / 1000` is within a second of `unix_seconds()`.

import std;

fn main()
{
    printf(
        "%v %v %v %v %v %v\n",
        Option::is_some(&DateTime::new(2024, 2, 29, 0, 0, 0)),
        Option::is_some(&DateTime::new(2023, 2, 29, 0, 0, 0)),
        Option::is_some(&DateTime::new(2026, 4, 31, 0, 0, 0)),
        Option::is_some(&DateTime::new(2026, 1, 1, 24, 0, 0)),
        Option::is_some(&DateTime::new(2026, 1, 1, 0, 60, 0)),
        Option::is_some(&DateTime::new(2026, 1, 0, 0, 0, 0)),
    );
    Vec<DateTime> v = Vec::new();
    foreach (s in ["2026-10-03T10:17:00Z", "1969-12-31T23:59:59Z", "2026-10-03T10:16:59Z", "-0044-03-15", "2026-10-03"])
    {
        Vec::push(&mut v, Result::unwrap(DateTime::from_iso(StringView::of(s))));
    }
    Vec::sort_by(&mut v, DateTime::less);
    foreach (t in &v)
    {
        String iso = DateTime::to_iso(t);
        printf("%s\n", &iso);
    }
    DateTime a = DateTime::from_unix(1791022620);
    printf("eq %v %v\n", DateTime::eq(&a, &v[4]), DateTime::eq(&a, &v[3]));
    i64 diff = unix_ms() / 1000 - unix_seconds();
    printf("unix_ms agrees: %v\n", diff >= -1 && diff <= 1);
}
