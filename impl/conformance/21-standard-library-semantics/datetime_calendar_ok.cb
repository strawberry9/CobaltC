// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.time [From-Unix] [To-Unix] [Weekday] [To-Iso] (D-0140); conf.datetime-from-unix, conf.datetime-to-unix-limits, conf.datetime-weekday
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// Fixed vectors: the epoch and the second before it; a leap day; 1900,
// which is not a leap year, so 1 March follows 28 February; year 0 (1 BC,
// a leap year) and year -1; the last second of 9999. Every `i64` second
// names a moment, and `to_unix` gives it back, the extremes included.
// Weekdays of three known dates, and of the far ends.

import std;

fn show(i64 s)
{
    DateTime t = DateTime::from_unix(s);
    String iso = DateTime::to_iso(&t);
    Weekday w = DateTime::weekday(&t);
    printf("%d %s %s %v\n", s, &iso, Weekday::text(&w), DateTime::to_unix(&t) == s);
}

fn main()
{
    show(0);
    show(-1);
    show(951782400);
    show(-2203977600);
    show(-2203891200);
    show(-62167219200);
    show(-62198755200);
    show(253402300799);
    show(max_value<i64>());
    show(min_value<i64>());
    foreach (d in ["1970-01-01", "2000-01-01", "2026-10-03"])
    {
        DateTime t = Result::unwrap(DateTime::from_iso(StringView::of(d)));
        Weekday w = DateTime::weekday(&t);
        printf("%s is a %s\n", d, Weekday::text(&w));
    }
}
