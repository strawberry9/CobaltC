// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str `[Str-Literal-String-Ref]` (D-0308) is written without `&`: `&L` borrows no place (spec/09 `[Ref-Form-Not-Place]`); conf.literal-string-ref-no-amp
// kind: negative
// expect: diag.borrow-of-non-place (static)
//
// A literal is not a place, so it is not borrowed; where a
// `ref<String, shared>` is declared the literal itself is the reference.

import std;

fn main()
{
    HashMap<String, i32> m = HashMap::new();
    HashMap::insert(&mut m, "k", 1);
    bool b = HashMap::contains(&m, &"k");
}
