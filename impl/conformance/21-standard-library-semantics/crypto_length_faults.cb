// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Crypto-Length] (D-0153); conf.crypto-length
// kind: negative
// expect: diag.crypto-length (dynamic)
//
// A ChaCha20-Poly1305 key is 32 bytes; 31 is a programming error, not a
// condition of the data.

import std;

fn main()
{
    Vec<u8> key = Vec::filled(31, 1: u8);
    Vec<u8> nonce = Vec::filled(12, 2: u8);
    Vec<u8> none = Vec::new();
    Vec<u8> sealed = chacha20_poly1305_seal(&key[0..$], &nonce[0..$], &none[0..$], &none[0..$]);
}
