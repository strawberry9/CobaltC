// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.postgres [Pg-Connect] [Pg-Error] (`PgConnection::connect`, `PgServerError`) (CHG-0265); conf.postgres-connect-refused
// kind: positive
// expect: ok
// expect-stdout-hex: 50674e65744661696c7572652852656675736564290a74686520636f6e6e656374696f6e2055524c206973206d616c666f726d65640a4552524f523a2072656c6174696f6e2022742220646f6573206e6f7420657869737420283432503031290a
//
// `PgConnection::connect` with the default roots, to a loopback port no
// server listens on, is `PgNetFailure(Refused)`; a malformed URL is
// `BadConnectionUrl` before any connection is tried. A server's error, a
// `PgServerError` inside `Server`, reads as its message with its code.
import std;

fn what(Result<PgConnection, PgError> r) : String
{
    match (r)
    {
        Ok(_)                      : String::from_str("connected"),
        Err(PgNetFailure(Refused)) : String::from_str("PgNetFailure(Refused)"),
        Err(e)                     : PgError::text(&e),
    }
}

fn main()
{
    printf("%v\n", &what(PgConnection::connect("postgres://nobody@127.0.0.1:1/none?sslmode=disable")));
    printf("%v\n", &what(PgConnection::connect("mysql://nobody@127.0.0.1/none")));
    PgServerError s = PgServerError {
        .severity = String::from_str("ERROR"),
        .code = String::from_str("42P01"),
        .message = String::from_str("relation \"t\" does not exist"),
        .detail = None,
        .hint = Some(String::from_str("check the name")),
        .position = Some(15),
    };
    PgError e = Server(s);
    printf("%v\n", &PgError::text(&e));
}
