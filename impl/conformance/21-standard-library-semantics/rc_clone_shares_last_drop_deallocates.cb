// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.rc (new, clone, get, drop)
// kind: positive
// expect: ok
//
// Rc::clone shares one allocation; the inner value stays reachable
// through every live clone and only the last drop deallocates it.

import std;

fn main()
{
    Vec<i32> payload = Vec::new();
    Vec::push(&mut payload, 42);
    auto a = Rc::new(payload);
    auto b = Rc::clone(&a);
    if (Vec::len(Rc::get(&b)) != 1)
    {
        1 / (1 - 1);
    }
    drop(a);
    if (Vec::len(Rc::get(&b)) != 1)
    {
        1 / (1 - 1);
    }
    drop(b);
}
