// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.hashmap `remove` (D-0134); conf.hashmap-remove-near-end
// kind: positive
// expect: ok
//
// `remove` keeps the other entries' order wherever the removed entry is:
// the last one, one of the last few (whose cells are found by their
// hashes), or one far from the end (every cell looked at). A map of
// numbers and a map of texts are emptied from the end back, then from
// near the end, then from the middle, against a list of the keys left in
// order; every key left is found with its value and every removed one is
// absent.

import std;

fn check_u(ref<HashMap<u64, u64>, shared> m, ref<Vec<u64>, shared> want) : bool
{
    if (HashMap::len(m) != Vec::len(want))
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(want); i += 1)
    {
        if (*HashMap::key_at(m, i) != want[i] || *Option::unwrap(HashMap::get(m, want[i])) != want[i] * 3)
        {
            return false;
        }
    }
    true
}

fn check_s(ref<HashMap<String, u64>, shared> m, ref<Vec<u64>, shared> want) : bool
{
    if (HashMap::len(m) != Vec::len(want))
    {
        return false;
    }
    for (usize i = 0; i < Vec::len(want); i += 1)
    {
        String k = sprintf("k%v", want[i]);
        if (*HashMap::key_at(m, i) != k || *Option::unwrap(HashMap::get(m, &k)) != want[i])
        {
            return false;
        }
    }
    true
}

fn take(ref<Vec<u64>, exclusive> want, u64 k)
{
    usize i = Result::unwrap(Vec::binary_search(&*want, k));
    drop(Vec::remove(want, i));
}

fn main() : u8
{
    HashMap<u64, u64> mu = HashMap::new();
    HashMap<String, u64> ms = HashMap::new();
    Vec<u64> want = Vec::new();
    for (u64 k = 0; k < 2000; k += 1)
    {
        HashMap::insert(&mut mu, k, k * 3);
        HashMap::insert(&mut ms, sprintf("k%v", k), k);
        Vec::push(&mut want, k);
    }
    bool ok = true;
    u32 steps = 0;
    // From the end back: each the last entry.
    for (u64 k = 1999; k >= 1900; k -= 1)
    {
        ok = ok && Option::unwrap(HashMap::remove(&mut mu, k)) == k * 3;
        ok = ok && Option::unwrap(HashMap::remove(&mut ms, &sprintf("k%v", k))) == k;
        take(&mut want, k);
        steps += 1;
    }
    ok = ok && check_u(&mu, &want) && check_s(&ms, &want);
    // Near the end: a few entries after each.
    for (u64 k = 1850; k < 1890; k += 2)
    {
        ok = ok && Option::unwrap(HashMap::remove(&mut mu, k)) == k * 3;
        ok = ok && Option::unwrap(HashMap::remove(&mut ms, &sprintf("k%v", k))) == k;
        take(&mut want, k);
        steps += 1;
        ok = ok && check_u(&mu, &want) && check_s(&ms, &want);
    }
    // Far from the end.
    for (u64 k = 100; k < 1000; k += 37)
    {
        ok = ok && Option::unwrap(HashMap::remove(&mut mu, k)) == k * 3;
        ok = ok && Option::unwrap(HashMap::remove(&mut ms, &sprintf("k%v", k))) == k;
        take(&mut want, k);
        steps += 1;
    }
    ok = ok && check_u(&mu, &want) && check_s(&ms, &want);
    ok = ok && Option::is_none(&HashMap::remove(&mut mu, 1999)) && Option::is_none(&HashMap::remove(&mut ms, "k100"));
    // Added again, at the end.
    HashMap::insert(&mut mu, 1999, 1999 * 3);
    HashMap::insert(&mut ms, "k1999", 1999);
    Vec::push(&mut want, 1999);
    ok = ok && check_u(&mu, &want) && check_s(&ms, &want);
    printf("%v steps, %v left, %v\n", steps, HashMap::len(&mu), ok);
    if (ok) { 0 } else { 1 }
}
