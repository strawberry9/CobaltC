// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.hashmap (D-0200); conf.map-get-unwrap-read
// kind: positive
// expect: ok
// expect-stdout-hex: 3231202d33390a6b3230206b3131206b33200a
//
// `*Option::unwrap(HashMap::get(&m, k))` read at once, for text and
// integer keys, inside a comparator that captures the map, and after the
// map has grown.

import std;

fn main() : u8
{
    HashMap<String, u64> m = HashMap::new();
    HashMap<i32, i64> n = HashMap::new();
    for (i32 i = 0; i < 40; i += 1)
    {
        _ = HashMap::insert(&mut m, sprintf("k%v", i), narrow<u64>(i * 3));
        _ = HashMap::insert(&mut n, i, -(widen<i64>(i)));
    }
    String k = "k7";
    u64 a = *Option::unwrap(HashMap::get(&m, &k));
    i64 b = *Option::unwrap(HashMap::get(&n, &39));
    printf("%v %v\n", a, b);
    Vec<String> words = Vec::new();
    Vec::push(&mut words, "k3");
    Vec::push(&mut words, "k20");
    Vec::push(&mut words, "k11");
    Vec::sort_by(&mut words, [m](ref<String, shared> x, ref<String, shared> y) : bool
    {
        *Option::unwrap(HashMap::get(&m, x)) > *Option::unwrap(HashMap::get(&m, y))
    });
    foreach (w in &words)
    {
        printf("%s ", w);
    }
    printf("\n");
    0
}
