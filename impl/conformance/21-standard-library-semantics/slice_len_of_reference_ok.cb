// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.type.coerce-slice [Coerce-Slice] (D-0312); rule.stdlib.slice; conf.slice-len-of-reference
// kind: positive
// expect: ok
// expect-stdout-hex: 3420332038203720340a
//
// `slice_len`'s argument is a shared slice: `&v` of a `Vec` or an array, an
// array element that is an array, and a reference to one are the whole as a
// slice (`[Coerce-Slice]`), as at any slice position. Before CHG-0416
// `slice_len(&rows[0])` was accepted and faulted at run time.

import std;

fn count(ref<Vec<u8>, shared> r, ref<array<u16, 3>, shared> a) : usize
{
    slice_len(r) + slice_len(a)
}

fn main()
{
    Vec<u8> v = Vec::from_slice(b"abcd");
    array<u16, 3> a = [1, 2, 3];
    array<array<u8, 8>, 2> rows = [[0; 8], [1; 8]];
    slice<u8, shared> whole = &v;
    printf("%v %v %v %v %v\n", slice_len(&v), slice_len(&a), slice_len(&rows[0]), count(&v, &a), slice_len(whole));
}
