// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §1 Vec, §2p; conf.vec-swap-remove
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
// expect-stdout-hex: 3130203330205b305d5b34305d5b32305d0a676f7420303b205b335d5b315d5b325d0a6f6e6c7920300a5b68c3a96c6c6f5d0a747275650a64726f7020302064726f7020332064726f7020312064726f70203220
//
// Vec::swap_remove on numbers, resources (the last element moving into
// the hole, nothing dropped) and a one-element Vec; Response::text of
// UTF-8 and of bytes that are not; swap_remove past the end faults
// (D-0193)

import std;

resource struct N
{
    i64 id;
}

fn N::drop(ref<N, exclusive> self)
{
    printf("drop %v ", self.id);
}

fn main()
{
    Vec<i64> v = Vec::from_fn(5, [](usize i) : i64 { narrow<i64>(i) * 10 });
    printf("%v ", Vec::swap_remove(&mut v, 1));
    printf("%v ", Vec::swap_remove(&mut v, 3));
    foreach (x in &v)
    {
        printf("[%v]", *x);
    }
    printf("\n");
    Vec<N> ns = Vec::new();
    foreach (i in 0..4: i64)
    {
        Vec::push(&mut ns, N { .id = i });
    }
    N g = Vec::swap_remove(&mut ns, 0);
    printf("got %v; ", g.id);
    foreach (n in &ns)
    {
        printf("[%v]", n.id);
    }
    printf("\n");
    Vec<String> s = Vec::new();
    Vec::push(&mut s, String::from_str("only"));
    printf("%s %v\n", &Vec::swap_remove(&mut s, 0), Vec::len(&s));
    Response r = Response { .status = 200, .reason = String::from_str("OK"), .headers = Vec::new(), .body = Vec::new() };
    Vec::extend_from(&mut r.body, StringView::as_bytes(StringView::of("héllo")));
    printf("[%s]\n", &Result::unwrap(Response::text(&r)));
    Vec::push(&mut r.body, 0xff);
    printf("%v\n", Result::is_err(&Response::text(&r)));
    _ = Vec::swap_remove(&mut v, 7);
}
