// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str `[Text-Mixed-Eq]` (D-0164); conf.text-mixed-eq
// kind: positive
// expect: ok
// expect-stdout-hex: 74727565207472756520747275652066616c73650a747275652066616c7365207472756520747275650a7368613235360a
//
// `==` and `!=` compare a `String` with a `str` or a `StringView`, either
// way round, by their bytes: a literal, a `str` binding, a view, a
// temporary `String`; nothing is moved or copied.

import std;

fn main() : u8
{
    String s = "sha256";
    StringView v = "sha256";
    StringView w = "sha384";
    str t = "other";
    printf("%v %v %v %v\n", s == "sha256", "sha256" == s, s != t, t == s);
    printf("%v %v %v %v\n", s == v, w == s, s != w, String::from_str("x") == "x");
    String still = s;
    printf("%s\n", &still);
    0
}
