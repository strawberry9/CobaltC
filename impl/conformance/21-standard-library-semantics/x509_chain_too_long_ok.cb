fn show(str what, Result<void, CertError> r)
{
    match (r)
    {
        Ok(_)  : printf("%s: ok\n", what),
        Err(e) : printf("%s: %s\n", what, CertError::text(&e)),
    }
}

fn one(str pem) : Certificate
{
    Vec<Certificate> v = certificates_from_pem(StringView::of(pem));
    Vec::remove(&mut v, 0)
}

fn main() : u8
{
    TrustStore store = TrustStore::new();
    TrustStore::add(&mut store, one(ROOT));
    Vec<Certificate> mids = Vec::new();
    Vec::push(&mut mids, one(M1));
    Vec::push(&mut mids, one(M2));
    Vec::push(&mut mids, one(M3));
    Vec::push(&mut mids, one(M4));
    Vec::push(&mut mids, one(M5));
    Vec::push(&mut mids, one(M6));
    Vec::push(&mut mids, one(M7));
    Vec::push(&mut mids, one(M8));
    Vec::push(&mut mids, one(M9));
    Vec::push(&mut mids, one(M10));
    DateTime at = Option::unwrap(DateTime::new(2030, 6, 1, 0, 0, 0));
    Certificate leaf9 = one(LEAF9);
    Certificate leaf10 = one(LEAF10);
    printf("intermediates: %v\n", Vec::len(&mids));
    show("nine deep", verify_chain(&leaf9, &mids[0..$], &store, "deep.example", &at));
    show("ten deep", verify_chain(&leaf10, &mids[0..$], &store, "deep.example", &at));
    0
}
