// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview [Strip-Prefix] [Lines] [Split-Whitespace] [Code-Point] rule.stdlib.text [Parse-Bool] (D-0181); conf.text-strip-prefix-suffix, conf.text-lines-words, conf.text-code-points, conf.parse-bool
// kind: positive
// expect: ok
// expect-stdout-hex: 76616c75657c747275657c2d2d6e616d653d0a343a5b6f6e655d5b74776f5d5b5d5b74687265655d203020320a343a5b615d5b62625d5b6363635d5b645d20300a39372032333320383336342031323835313220747275650a7472756520313620360a747275652066616c7365207472756520747275650a696e76616c696420617420340a
//
// `strip_prefix`/`strip_suffix` give the rest or None; `lines` drops a
// `\r` before each `\n` and no empty line follows a final `\n`;
// `split_whitespace` skips every run of ASCII whitespace; `code_point`
// reads the first character and `push_code_point` writes one (a
// surrogate becomes U+FFFD); `parse<bool>` reads exactly `true`/`false`.

import std;

fn main()
{
    String s = "--name=value";
    printf(
        "%v|%v|%v\n",
        Option::unwrap_or(String::strip_prefix(&s, "--name="), StringView::of("?")),
        Option::is_none(&String::strip_prefix(&s, "-x")),
        Option::unwrap_or(String::strip_suffix(&s, "value"), StringView::of("?")),
    );
    String t = "one\r\ntwo\n\nthree\n";
    Vec<StringView> ls = String::lines(&t);
    printf("%v:", Vec::len(&ls));
    foreach (l in &ls)
    {
        printf("[%v]", *l);
    }
    String empty = "";
    printf(" %v %v\n", Vec::len(&String::lines(&empty)), Vec::len(&StringView::lines("\n\n")));
    String w = " \t a  bb\tccc \n d";
    Vec<StringView> ws = String::split_whitespace(&w);
    printf("%v:", Vec::len(&ws));
    foreach (x in &ws)
    {
        printf("[%v]", *x);
    }
    printf(" %v\n", Vec::len(&StringView::split_whitespace("   ")));
    String e = "aé€😀";
    foreach (c in String::chars(&e))
    {
        printf("%v ", Option::unwrap_or(StringView::code_point(c), 0));
    }
    printf("%v\n", Option::is_none(&String::code_point(&empty)));
    String back = String::new();
    String::push_code_point(&mut back, 0x61);
    String::push_code_point(&mut back, 0xe9);
    String::push_code_point(&mut back, 0x20ac);
    String::push_code_point(&mut back, 0x1F600);
    String::push_code_point(&mut back, 0xD800);
    String::push_code_point(&mut back, 0x110000);
    printf("%v %v %v\n", back == "aé€😀\u{FFFD}\u{FFFD}", String::len(&back), Vec::len(&String::chars(&back)));
    String b = "true";
    printf(
        "%v %v %v %v\n",
        Result::unwrap_or(String::parse<bool>(&b), false),
        Result::unwrap_or(StringView::parse<bool>("false"), true),
        Result::is_err(&StringView::parse<bool>("tru")),
        Result::is_err(&StringView::parse<bool>("True")),
    );
    match (StringView::parse<bool>("fals"))
    {
        Err(Invalid(i)) : printf("invalid at %v\n", i),
        _               : printf("?\n"),
    }
}
