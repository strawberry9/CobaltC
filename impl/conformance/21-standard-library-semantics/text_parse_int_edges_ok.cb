// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §2d; conf.text-parse-int-edges
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// StringView::parse and String::parse at every integer width: limits and
// one past them, signs, empty text, white space, digit separators,
// invalid bytes and where (D-0193: views parsed in place; cobc's native
// integer parse)

import std;

fn show<T>(str s)
{
    match (StringView::parse<T>(StringView::of(s)))
    {
        Ok(v)  : printf("[%s]=%v ", s, v),
        Err(e) : printf("[%s]=%s ", s, ParseError::text(&e)),
    }
    String owned = String::from_str(s);
    match (String::parse<T>(&owned))
    {
        Ok(v)            : printf("(%v) ", v),
        Err(Invalid(at)) : printf("(invalid at %v) ", at),
        Err(e)           : printf("(%s) ", ParseError::text(&e)),
    }
}

fn main()
{
    array<str, 16> xs = [
        "0",
        "42",
        "-1",
        "+7",
        "",
        " 5",
        "5 ",
        "18446744073709551615",
        "18446744073709551616",
        "-9223372036854775808",
        "-9223372036854775809",
        "127",
        "128",
        "-128",
        "-129",
        "1_000",
    ];
    foreach (x in xs)
    {
        show<u64>(x);
        show<i64>(x);
        show<i8>(x);
        show<u8>(x);
        printf("\n");
    }
    show<i128>("-170141183460469231731687303715884105728");
    show<u128>("340282366920938463463374607431768211455");
    show<u16>("65536");
    show<u32>("4294967295");
    show<isize>("abc");
    printf("\n");
    String line = String::from_str("12 -3 x9");
    foreach (w in String::split_whitespace(&line))
    {
        show<i32>("z");
        printf("%v ", Result::is_ok(&StringView::parse<i32>(w)));
    }
    printf("\n");
}
