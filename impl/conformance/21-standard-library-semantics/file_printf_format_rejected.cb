// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.file-handle [File-Printf]; [Format-Arg-Mismatch]; D-0059; conf.file-printf-format
// kind: negative
// expect: diag.type-mismatch (static)
//
// `File::printf`'s format is checked against its arguments when compiled,
// as `printf`'s is: `%d` is not for a `str`.

import std;

fn main()
{
    String p = String::from_str("never-written.txt");
    File f = match (File::create(&p[0..$]))
    {
        Ok(f)  : f,
        Err(_) : fault(assert_failed),
    };
    Result::unwrap_or(File::printf(&mut f, "%d\n", "no"), ());
}
