// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.text `String::append` (every kind of value it takes); rule.stdlib.stringview `String::as_view`, `String::view`, `StringView::of`
// kind: positive
// expect: ok
//
// `String::append` of integers at their extremes (128-bit too), floats,
// `bool`, empty and non-empty `str`, views (of a literal, of a String, of
// part of one, empty) and Strings, through a reference parameter as well,
// and enough appends to grow the String many times. The text must be
// exactly what was appended, in order.

import std;

fn add_all(ref<String, exclusive> out, StringView v)
{
    String::append(out, v);
    String::append(out, "|");
}

fn main()
{
    String s = String::new();
    String::append(&mut s, "");
    String::append(&mut s, "start:");
    String::append(&mut s, min_value<i8>());
    String::append(&mut s, ",");
    String::append(&mut s, max_value<u128>());
    String::append(&mut s, ",");
    String::append(&mut s, min_value<i128>());
    String::append(&mut s, ",");
    String::append(&mut s, max_value<u64>());
    String::append(&mut s, ",");
    String::append(&mut s, -0.5);
    String::append(&mut s, ",");
    f32 g = 3.25;
    String::append(&mut s, g);
    String::append(&mut s, ",");
    String::append(&mut s, true);
    String::append(&mut s, false);
    assert(s == "start:-128,340282366920938463463374607431768211455,-170141183460469231731687303715884105728,18446744073709551615,-0.5,3.25,truefalse");
    String t = String::from_str("hello world");
    String u = String::new();
    String::append(&mut u, String::view(&t, 6, 11));
    String::append(&mut u, String::view(&t, 3, 3));
    String::append(&mut u, StringView::of("-lit-"));
    String::append(&mut u, String::as_view(&t));
    String::append(&mut u, &t);
    add_all(&mut u, String::view(&t, 0, 5));
    add_all(&mut u, StringView::of(""));
    assert(u == "world-lit-hello worldhello worldhello||");
    String big = String::new();
    foreach (i in 0..300)
    {
        String::append(&mut big, "abcdefghij");
        String::append(&mut big, i);
    }
    String::append(&mut big, String::as_view(&u));
    // 300 * 10 + 10 one-digit + 90 two-digit * 2 + 200 three-digit * 3, then u.
    assert(String::len(&big) == 3000 + 10 + 180 + 600 + String::len(&u));
    String r = String::new();
    foreach (i in 0..5)
    {
        String::append(&mut r, String::as_view(&big));
    }
    assert(String::len(&r) == 5 * String::len(&big));
    String::clear(&mut s);
    u8 small = 42;
    String::append(&mut s, small);
    assert(s == "42");
    printf("ok\n");
}
