// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Hkdf] (D-0152); conf.hkdf-vectors, conf.hkdf-bound
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// HKDF-SHA-256 against RFC 5869's test cases A.1 (short salt and info, 42
// bytes), A.2 (80-byte inputs, 82 bytes, more than two blocks) and A.3
// (empty salt and info): the pseudorandom key of `hkdf_extract` and the
// output of `hkdf_expand`, and `hkdf_sha256` doing both. The bound: 8160
// bytes come out whole, and the one-shot form agrees with the two steps.

import std;

fn range(usize from, usize to) : Vec<u8>
{
    Vec<u8> v = Vec::new();
    for (usize i = from; i < to; i += 1)
    {
        Vec::push(&mut v, narrow_wrapping<u8>(i));
    }
    v
}

fn check(
    str name,
    slice<u8, shared> salt,
    slice<u8, shared> ikm,
    slice<u8, shared> info,
    usize len,
    str prk_want,
    str okm_want,
)
{
    array<u8, 32> prk = hkdf_extract(salt, ikm);
    Vec<u8> okm = hkdf_expand(&prk[0..$], info, len);
    Vec<u8> once = hkdf_sha256(salt, ikm, info, len);
    bool prk_ok = String::eq_str(&to_hex(&prk[0..$]), prk_want);
    bool okm_ok = String::eq_str(&to_hex(&okm[0..$]), okm_want);
    printf(
        "%s: prk %v, okm %v (%u bytes), one-shot agrees %v\n",
        name,
        prk_ok,
        okm_ok,
        Vec::len(&okm),
        digest_eq(&okm[0..$], &once[0..$]),
    );
}

fn main() : u8
{
    Vec<u8> ikm1 = Vec::filled(22, 0x0b);
    check(
        "A.1",
        &range(0, 13)[0..$],
        &ikm1[0..$],
        &range(0xf0, 0xfa)[0..$],
        42,
        "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5",
        "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865",
    );
    check(
        "A.2",
        &range(0x60, 0xb0)[0..$],
        &range(0, 0x50)[0..$],
        &range(0xb0, 0x100)[0..$],
        82,
        "06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244",
        "b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87",
    );
    Vec<u8> none = Vec::new();
    check(
        "A.3",
        &none[0..$],
        &ikm1[0..$],
        &none[0..$],
        42,
        "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04",
        "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8",
    );
    Vec<u8> most = hkdf_sha256(&none[0..$], &ikm1[0..$], &none[0..$], 8160);
    Vec<u8> zero = hkdf_sha256(&none[0..$], &ikm1[0..$], &none[0..$], 0);
    printf(
        "bound: %u bytes; zero: %u bytes; prefix of the bound is A.3's output: %v\n",
        Vec::len(&most),
        Vec::len(&zero),
        String::eq_str(
            &to_hex(&most[0..42]),
            "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8",
        ),
    );
    0
}
