// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.format [Printf] [Appendf] [Sprintf]; conf.format-in-place
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// The formats a compiler writes in place (D-0297: `%v`, `%d`, `%i`, `%u`,
// `%x` and `%X` of an integer up to 64 bits, with a width and the `-` and
// `0` flags, `%v` and `%s` of text with no width, and `%%`) print what the
// formatter prints: the extremes of each width, padding wider than the
// text, a sign before zeros, `-` over `0`, a width past the frame's bound,
// every kind of text argument, and formats with none of these beside them.

import std;

fn main()
{
    i8 a = -128;
    i64 b = min_value<i64>();
    u64 c = max_value<u64>();
    i32 d = -42;
    u8 e = 255;
    usize z = 0;
    i16 h = -1;
    String s = String::from_str("héllo");
    StringView v = String::as_view(&s);
    String empty = String::new();
    bool t = true;
    printf("plain\n");
    printf("100%%\n");
    printf("%%\n");
    printf("");
    printf("%v %v %v %v %v %v %d %i %u\n", a, b, c, d, e, z, h, h, h);
    printf("[%5d] [%-5d] [%05d] [%5v] [%-05d] [%1d] [%03u]\n", d, d, d, e, d, d, e);
    printf("[%x] [%X] [%x] [%08x] [%-6x] [%3x] [%x] [%x]\n", d, e, b, e, a, c, h, z);
    printf("[%300d]\n", d);
    printf("%s|%v|%s|%v|%s|%s\n", &s, v, "lit", t, &empty, "");
    printf("%v%v%v%%%v\n", false, t, a, e);
    String r = sprintf("w%v", c);
    String::appendf(&mut r, "/%v/%s/%x/%-4d|", d, &s, e, h);
    printf("%s %v\n", &r, String::len(&r));
    String n1 = sprintf("%v", 1);
    String n2 = sprintf("%v", 2);
    String n3 = sprintf("%s%s", &n1, &n2);
    printf("%s [%5s] %+d %.2f %v\n", &n3, "ab", d, 1.5, -5: i128);
}
