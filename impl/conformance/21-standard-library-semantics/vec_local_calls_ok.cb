// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec; conf.vec-local-calls
// kind: positive
// expect: ok
// expect-stdout-hex: 30203130302032372031352031300a747275652066616c73650a330a31383420313030340a666f756e642031320a3120310a39203320330a747275650a
//
// swap, reverse, insert, remove, truncate, clear, contains, index_of,
// binary_search and sort on local vectors and through a reference
// parameter, plain and struct elements, interleaved with indexing and
// push (calls that keep a local vector confined in cobc, D-0189).

import std;

struct P
{
    i32 a;
    u8 b;
}

fn helper(ref<Vec<i64>, exclusive> v) : i64
{
    Vec::push(v, 5);
    Vec::swap(v, 0, 1);
    Vec::reverse(v);
    Vec::insert(v, 1, 40);
    i64 r = Vec::remove(v, 0);
    Vec::truncate(v, 6);
    if (Vec::contains(v, &40))
    {
        r += 1000;
    }
    match (Vec::index_of(v, &5))
    {
        Some(k) : r += narrow<i64>(k) * 10,
        None    : r -= 1,
    }
    r
}

fn main()
{
    Vec<i64> v = Vec::new();
    foreach (i in 0..10: i64)
    {
        Vec::push(&mut v, i * 3);
    }
    Vec::swap(&mut v, 0, 9);
    Vec::reverse(&mut v);
    Vec::insert(&mut v, 3, 100);
    i64 gone = Vec::remove(&mut v, 5);
    printf("%v %v %v %v %v\n", v[0], v[3], v[9], gone, Vec::len(&v));
    printf("%v %v\n", Vec::contains(&v, &100), Vec::contains(&v, &101));
    printf("%v\n", Option::unwrap(Vec::index_of(&v, &100)));
    Vec::truncate(&mut v, 7);
    i64 s = 0;
    for (usize i = 0; i < Vec::len(&v); i += 1)
    {
        s += v[i];
        v[i] = v[i] * 2;
    }
    printf("%v %v\n", s, helper(&mut v));
    Vec<i64> w = Vec::new();
    foreach (i in 0..20: i64)
    {
        Vec::push(&mut w, i / 3);
    }
    match (Vec::binary_search(&w, &4))
    {
        Ok(k)  : printf("found %v\n", k),
        Err(k) : printf("missing %v\n", k),
    }
    Vec::clear(&mut w);
    Vec::push(&mut w, 1);
    printf("%v %v\n", Vec::len(&w), w[0]);
    Vec<P> ps = Vec::new();
    Vec::push(&mut ps, P { .a = 1, .b = 2 });
    Vec::push(&mut ps, P { .a = 3, .b = 4 });
    Vec::swap(&mut ps, 0, 1);
    Vec::insert(&mut ps, 0, P { .a = 9, .b = 9 });
    printf("%v %v %v\n", ps[0].a, ps[1].a, Vec::len(&ps));
    Vec<bool> bs = Vec::new();
    Vec::push(&mut bs, false);
    Vec::push(&mut bs, true);
    printf("%v\n", Vec::contains(&bs, &true));
}
