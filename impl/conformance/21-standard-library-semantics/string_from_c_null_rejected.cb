// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.ffi [From-C-Null] (D-0252); conf.string-from-c-null
// kind: negative
// expect: diag.null-pointer (dynamic)
//
// C's `NULL` is checked rather than read: `String::from_c` of it faults.

import std;

fn main()
{
    rawptr<u8> p = null_rawptr<u8>();
    Result<String, Utf8Error> s = unsafe
    {
        String::from_c(p)
    };
}
