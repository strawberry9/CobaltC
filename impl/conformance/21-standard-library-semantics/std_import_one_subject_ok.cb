// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.prelude (std's submodules, D-0136); rule.module.use; conf.std-import-one-subject
// kind: positive
// expect: ok
// expect-stdout-hex: 68656c6c6f2c20350a
//
// A module may import one subject of `std`: `import std::text;` brings in
// `String` and its functions, `import std::io;` `printf`.

import std::text;
import std::io;

fn main()
{
    String s = "hello";
    printf("%s, %v\n", &s, String::len(&s));
}
