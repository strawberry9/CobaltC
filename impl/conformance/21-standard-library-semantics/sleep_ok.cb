// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: `[Sleep]` (D-0124); conf.sleep-at-least
// kind: positive
// expect: ok
//
// `sleep_ms(30)` takes at least 30 ms by the monotonic clock, and another
// thread runs meanwhile.

import std;

fn tick(ref<mutex<u32>, shared> m) : u32
{
    foreach (k in 0..5)
    {
        auto g = lock(m);
        *g = *g + 1;
        drop(g);
        sleep_ms(1);
    }
    5
}

fn main()
{
    auto m = Mutex::new(0: u32);
    u64 t0 = monotonic_ns();
    auto h = spawn(tick, &m);
    sleep_ms(30);
    u64 t1 = monotonic_ns();
    assert(t1 - t0 >= 30000000);
    u32 n = join(h);
    assert(n == 5 && *lock(&m) == 5);
    printf("ok\n");
}
