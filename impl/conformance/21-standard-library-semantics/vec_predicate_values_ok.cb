// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `retain`, `position`, `binary_search_by`, rule.fn.value; conf.vec-predicate-values
// kind: positive
// expect: ok
// expect-stdout-hex: 6530206533206536206539206531322065313520653138206532312065323420653237200a6e616d656420350a76616c7565203520330a636c6f737572652076616c756520617420300a6530200a726561737369676e656420617420300a666f756e6420340a6d697373696e6720350a390a300a
//
// Named functions, fn values holding a named function or a closure, a fn
// value reassigned between calls, and binary_search_by with a named
// function, a fn value and a closure literal, keys a place and a
// temporary: each predicate given the elements in the prelude's order (a
// printing one shows it). (cobc calls a function that keeps nothing of
// its arguments with bare addresses, D-0191.)

import std;

fn is_even(ref<i64, shared> x) : bool
{
    printf("e%v ", *x);
    *x % 2 == 0
}

fn below(ref<i64, shared> a, ref<i64, shared> b) : bool
{
    *a < *b
}

fn keep_odd(ref<i64, shared> x) : bool
{
    *x % 2 == 1
}

fn main()
{
    Vec<i64> v = Vec::new();
    foreach (i in 0..10: i64)
    {
        Vec::push(&mut v, i * 3);
    }
    Vec<i64> a = Vec::clone(&v);
    Vec::retain(&mut a, is_even);
    printf("\nnamed %v\n", Vec::len(&a));
    fn(ref<i64, shared>) : bool p = keep_odd;
    Vec<i64> b = Vec::clone(&v);
    Vec::retain(&mut b, p);
    printf("value %v %v\n", Vec::len(&b), b[0]);
    Vec<ref<i64, shared>> seen = Vec::new();
    i64 lim = 10;
    fn(ref<i64, shared>) : bool q = [lim](ref<i64, shared> x) : bool { *x < lim };
    match (Vec::position(&v, q))
    {
        Some(k) : printf("closure value at %v\n", k),
        None    : printf("none\n"),
    }
    p = is_even;
    match (Vec::position(&v, p))
    {
        Some(k) : printf("\nreassigned at %v\n", k),
        None    : printf("none\n"),
    }
    i64 key = 12;
    match (Vec::binary_search_by(&v, &key, below))
    {
        Ok(k)  : printf("found %v\n", k),
        Err(k) : printf("missing %v\n", k),
    }
    match (Vec::binary_search_by(&v, &13, [](ref<i64, shared> x, ref<i64, shared> y) : bool { *x < *y }))
    {
        Ok(k)  : printf("found %v\n", k),
        Err(k) : printf("missing %v\n", k),
    }
    fn(ref<i64, shared>, ref<i64, shared>) : bool l = below;
    printf("%v\n", Result::unwrap(Vec::binary_search_by(&v, &27, l)));
    printf("%v\n", Vec::len(&seen));
}
