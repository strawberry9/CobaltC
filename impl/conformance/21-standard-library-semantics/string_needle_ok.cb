// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview: the text sought is a `StringView` (D-0134); conf.string-needle
// kind: positive
// expect: ok
//
// `find`, `starts_with` and `ends_with` look for a `String`'s text as
// readily as a literal's: `&s[0..$]` is its whole-string view.

import std;

fn main()
{
    String hay = "abcabcab";
    String needle = "cab";
    assert(String::find(&hay, &needle[0..$]) == Some(2));
    assert(StringView::find(&hay[3..$], &needle[0..$]) == Some(2));
    assert(String::starts_with(&hay, &hay[0..3]) && String::ends_with(&hay, &needle[1..$]));
    assert(String::find(&hay, &needle[0..0]) == Some(0));
    assert(String::find(&needle, &hay[0..$]) == None);
}
