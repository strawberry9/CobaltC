// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str [Str-Literal-String] (D-0304): a generic struct literal's field fixed by the expected type; conf.str-literal-string-generic-field
// kind: positive
// expect: ok
// stdout: a b
//
// `Pair<String> p = Pair { .first = "a", .second = "b" };`: the expected
// type fixes `T` as `String`, and each literal is that `String`.

import std;

struct Pair<T>
{
    T first;
    T second;
}

fn main()
{
    Pair<String> p = Pair { .first = "a", .second = "b" };
    printf("%s %s\n", &p.first, &p.second);
}
