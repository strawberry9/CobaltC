// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `reverse`, [Borrow-Denied]; conf.vec-reverse-held-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 6265666f726520310a
//
// Vec::reverse swaps v[0] with the last element; a live exclusive
// reference to v[0] clashes with the swap's borrow.

import std;

fn main() : u8
{
    Vec<i64> v = Vec::filled(4, 2: i64);
    v[2] = 1;
    Vec::reserve(&mut v, 10);
    Vec<ref<i64, exclusive>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &mut v[0]);
    }
    printf("before %v\n", Vec::len(&held));
    Vec::reverse(&mut v);
    printf("after %v\n", *held[0]);
    0
}
