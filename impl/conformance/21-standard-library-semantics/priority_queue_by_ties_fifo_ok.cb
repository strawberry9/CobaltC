// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.priority-queue [Priority-Queue] (D-0137); conf.priority-queue-by, conf.priority-queue-ties
// kind: positive
// expect: ok
// expect-stdout-hex: 610a746f70206220632064206d6964206c6f77206c617374200a
//
// `PriorityQueue::new_by` takes the order as a function, as `sort_by`
// does: here "greater", so the largest comes out first. Elements the
// order calls equal come out in the order they went in, also after
// others have come and gone between them.

import std;

struct Job
{
    u32 pri;
    str name;
}

fn more_urgent(ref<Job, shared> a, ref<Job, shared> b) : bool
{
    a.pri > b.pri
}

fn main()
{
    PriorityQueue<Job> q = PriorityQueue::new_by(more_urgent);
    PriorityQueue::push(&mut q, Job { .pri = 1, .name = "low" });
    PriorityQueue::push(&mut q, Job { .pri = 5, .name = "a" });
    PriorityQueue::push(&mut q, Job { .pri = 3, .name = "mid" });
    PriorityQueue::push(&mut q, Job { .pri = 5, .name = "b" });
    Job first = Option::unwrap(PriorityQueue::pop(&mut q));
    printf("%s\n", first.name);
    PriorityQueue::push(&mut q, Job { .pri = 5, .name = "c" });
    PriorityQueue::push(&mut q, Job { .pri = 9, .name = "top" });
    PriorityQueue::push(&mut q, Job { .pri = 5, .name = "d" });
    PriorityQueue::push(&mut q, Job { .pri = 1, .name = "last" });
    while (Some(j) = PriorityQueue::pop(&mut q))
    {
        printf("%s ", j.name);
    }
    printf("\n");
}
