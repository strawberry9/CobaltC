// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.hashmap [Key-Bytes] (D-0110); rule.stdlib.sort [Sort]; conf.hashmap-struct-key, conf.hashmap-enum-key, conf.sort-struct-key
// kind: positive
// expect: ok
//
// A struct whose fields, or an enum whose payloads, are all key types is
// a key type: a `HashMap` finds an equal key whatever its storage, a
// `String` field included, and `Vec::sort` orders field by field in
// declaration order (an enum by variant order, then payload).

import std;

struct Pos
{
    i32 x;
    i32 y;
}

struct Name
{
    String first;
    u8 n;
}

enum Shape
{
    Dot,
    Square(u32),
    Label(String),
}

fn main()
{
    HashMap<Pos, u32> grid = HashMap::new();
    HashMap::insert(&mut grid, Pos { .x = 1, .y = -2 }, 10);
    HashMap::insert(&mut grid, Pos { .x = -2, .y = 1 }, 20);
    HashMap::insert(&mut grid, Pos { .x = 1, .y = -2 }, 30);
    if (HashMap::len(&grid) != 2) { 1 / (1 - 1); }
    Pos k = Pos { .x = 1, .y = -2 };
    match (HashMap::get(&grid, &k))
    {
        Some(v) : { if (*v != 30) { 1 / (1 - 1); } },
        None    : { 1 / (1 - 1); },
    }

    HashSet<Name> names = HashSet::new();
    HashSet::insert(&mut names, Name { .first = "ab", .n = 1 });
    HashSet::insert(&mut names, Name { .first = "a", .n = 1 });
    HashSet::insert(&mut names, Name { .first = "ab", .n = 1 });
    if (HashSet::len(&names) != 2) { 1 / (1 - 1); }
    Name probe = Name { .first = "a", .n = 1 };
    if (!HashSet::contains(&names, &probe)) { 1 / (1 - 1); }

    HashMap<Shape, i32> shapes = HashMap::new();
    HashMap::insert(&mut shapes, Dot, 1);
    HashMap::insert(&mut shapes, Square(3), 2);
    HashMap::insert(&mut shapes, Label(String::from_str("x")), 3);
    Shape q = Square(3);
    match (HashMap::get(&shapes, &q))
    {
        Some(2) : {},
        _       : { 1 / (1 - 1); },
    }

    Vec<Pos> ps = Vec::new();
    Vec::push(&mut ps, Pos { .x = 2, .y = 0 });
    Vec::push(&mut ps, Pos { .x = -1, .y = 5 });
    Vec::push(&mut ps, Pos { .x = 2, .y = -3 });
    Vec::sort(&mut ps);
    if (ps[0].x != -1 || ps[1].y != -3 || ps[2].y != 0) { 1 / (1 - 1); }

    Vec<Shape> ss = Vec::new();
    Vec::push(&mut ss, Label(String::from_str("b")));
    Vec::push(&mut ss, Square(9));
    Vec::push(&mut ss, Label(String::from_str("a")));
    Vec::push(&mut ss, Dot);
    Vec::sort(&mut ss);
    i32 order = 0;
    foreach (s in &ss)
    {
        order = order * 10 + match (s)
        {
            Dot       : 1,
            Square(_) : 2,
            Label(t)  : if (String::eq_str(t, "a")) { 3 } else { 4 },
        };
    }
    if (order != 1234) { 1 / (1 - 1); }
}
