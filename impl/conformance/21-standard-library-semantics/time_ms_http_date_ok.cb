// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.time [Iso-Ms] [From-Iso] [Http-Date] (D-0181); conf.time-iso-ms, conf.time-http-date
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// Milliseconds written and read in ISO text (a fraction of any length
// read to the millisecond, dropped by `from_iso`), and HTTP dates in the
// three forms RFC 9110 requires a recipient to accept, with the refusals.

import std;

fn show(Result<DateTime, ParseError> r) : String
{
    match (r)
    {
        Ok(t) : DateTime::to_iso(&t),
        Err(e) : match (e)
        {
            Empty      : String::from_str("empty"),
            Invalid(i) : sprintf("invalid at %v", i),
            OutOfRange : String::from_str("out of range"),
        },
    }
}

fn main()
{
    printf("%v %v %v\n", &iso_from_unix_ms(1791022620123), &iso_from_unix_ms(-1), &iso_from_unix_ms(0));
    printf(
        "%v %v %v\n",
        Result::unwrap_or(unix_ms_from_iso("2026-10-07T12:34:56.5Z"), 0),
        Result::unwrap_or(unix_ms_from_iso("2026-10-07T12:34:56.1234Z"), 0),
        Result::unwrap_or(unix_ms_from_iso("2026-10-07"), 0),
    );
    printf(
        "%v %v\n",
        &show(DateTime::from_iso("1994-11-06T08:49:37.9Z")),
        &show(DateTime::from_iso("1994-11-06T08:49:37.Z")),
    );
    printf(
        "%v %v\n",
        &show(DateTime::from_iso("1994-11-06T08:49:37.25")),
        match (unix_ms_from_iso("+300000000-01-01T00:00:00Z")) { Err(OutOfRange) : "out of range", _ : "?" },
    );
    DateTime t = Result::unwrap(DateTime::from_iso("1994-11-06T08:49:37Z"));
    printf("%v\n", &DateTime::to_http_date(&t));
    printf("%v\n", &DateTime::to_http_date(&Result::unwrap(DateTime::from_iso("2026-02-01T00:00:00Z"))));
    printf(
        "%v %v %v\n",
        &show(DateTime::from_http_date("Sun, 06 Nov 1994 08:49:37 GMT")),
        &show(DateTime::from_http_date("Sunday, 06-Nov-94 08:49:37 GMT")),
        &show(DateTime::from_http_date("Sun Nov  6 08:49:37 1994")),
    );
    printf(
        "%v %v\n",
        &show(DateTime::from_http_date("Tue, 05-Mar-30 01:02:03 GMT")),
        &show(DateTime::from_http_date("  Mon, 01 Jan 2024 00:00:00 GMT  ")),
    );
    printf(
        "%v | %v | %v | %v\n",
        &show(DateTime::from_http_date("")),
        &show(DateTime::from_http_date("Sun, 06 Nov 1994 08:49:37 UTC")),
        &show(DateTime::from_http_date("Sun, 31 Feb 1994 08:49:37 GMT")),
        &show(DateTime::from_http_date("Sun, 06 Nvo 1994 08:49:37 GMT")),
    );
}
