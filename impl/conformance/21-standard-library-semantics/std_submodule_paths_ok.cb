// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.prelude (std's submodules, D-0136); rule.module.use (re-export); conf.std-submodule-path
// kind: positive
// expect: ok
// expect-stdout-hex: 3220332061620a
//
// Each item of `std` has its submodule's path as well as its short one,
// and the two name one item: a `std::collections::Vec` is a `Vec`, a
// `std::text::String` a `String`, and `std::math::sqrt` is `sqrt`.

import std;

fn total(ref<Vec<i32>, shared> v) : i32
{
    i32 t = 0;
    foreach (x in v)
    {
        t += *x;
    }
    t
}

fn main()
{
    std::collections::Vec<i32> v = std::Vec::new();
    std::collections::Vec::push(&mut v, 2);
    Vec::push(&mut v, 0);
    std::text::String s = String::from_str("a");
    std::String::append(&mut s, "b");
    std::core::Option<i32> o = std::Some(3);
    f64 r = std::math::sqrt(4.0);
    assert(r == sqrt(4.0) && std::core::Option::is_some(&o));
    printf("%v %v %s\n", total(&v), Option::unwrap(o), &s);
}
