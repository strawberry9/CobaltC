// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: [Cmp-Text] (D-0108); conf.vec-string-elements-compared
// kind: positive
// expect: ok
// expect-stdout-hex: 312073616d652c2031206c6573730a3320616e64203320656c656d656e74730a
//
// A `Vec<String>` local bound from a call, its elements compared by `==`
// and `<` (`ca[i] == cb[i]`). Each comparison borrows the two elements
// shared; nothing borrows an element otherwise (`&ca[i]` would keep the
// local tracked from the start). `cobc` stopped here with an internal
// error ("a resource binding without an object", CHG-0345): it took the
// call's result without its object, as for a local it leaves untracked,
// and then tracked the local, an indexed `Vec` of `String`s.

import std;

fn texts(str a, str b, str c) : Vec<String>
{
    Vec<String> out = Vec::new();
    Vec::push(&mut out, String::from_str(a));
    Vec::push(&mut out, String::from_str(b));
    Vec::push(&mut out, String::from_str(c));
    out
}

fn main() : u8
{
    Vec<String> ca = texts("apple", "fig", "pear");
    Vec<String> cb = texts("apple", "date", "plum");
    usize same = 0;
    usize less = 0;
    for (usize i = 0; i < Vec::len(&ca); i += 1)
    {
        if (ca[i] == cb[i])
        {
            same += 1;
        }
        if (ca[i] < cb[i])
        {
            less += 1;
        }
    }
    printf("%v same, %v less\n", same, less);
    printf("%v and %v elements\n", Vec::len(&ca), Vec::len(&cb));
    0
}
