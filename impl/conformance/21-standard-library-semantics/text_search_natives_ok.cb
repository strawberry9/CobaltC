// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.text (find, contains, starts_with, ends_with, view, from_view, append); conf.text-search-edges
// kind: positive
// expect: ok
// expect-stdout-hex: 30203020322036202d0a3131203820300a747275652066616c736520747275652066616c73650a747275652066616c736520747275652066616c73650a747275652066616c736520747275652066616c73650a5b616263c3a95d20350a5bc3a9e697a55d205b5d0a3e616263c3a920360a
//
// `find`, `contains`, `starts_with` and `ends_with` of a `String` and of a
// `StringView` at their edges: an empty needle (found at 0), a needle
// longer than the text, at the start, at the end, repeated, multi-byte
// text; `String::view` and `String::from_view` of it, and `append` of a
// view of another `String`, empty ones included.

import std;

fn show(Option<usize> o) : String
{
    match (o)
    {
        Some(i) : sprintf("%v", i),
        None    : String::from_str("-"),
    }
}

fn main()
{
    String s = String::from_str("abcabcé日x");
    StringView v = String::as_view(&s);
    printf(
        "%s %s %s %s %s\n",
        &show(String::find(&s, "")),
        &show(String::find(&s, "abc")),
        &show(String::find(&s, "cab")),
        &show(String::find(&s, "é日")),
        &show(String::find(&s, "abcabcé日xx")),
    );
    printf(
        "%s %s %s\n",
        &show(StringView::find(v, "x")),
        &show(StringView::find(v, "日x")),
        &show(StringView::find(StringView::of(""), "")),
    );
    printf(
        "%v %v %v %v\n",
        String::contains(&s, "c"),
        String::contains(&s, "zz"),
        StringView::contains(v, ""),
        StringView::contains(StringView::of(""), "a"),
    );
    printf(
        "%v %v %v %v\n",
        String::starts_with(&s, "abca"),
        String::starts_with(&s, "b"),
        StringView::starts_with(v, ""),
        StringView::starts_with(StringView::of("a"), "ab"),
    );
    printf(
        "%v %v %v %v\n",
        String::ends_with(&s, "日x"),
        String::ends_with(&s, "x日"),
        StringView::ends_with(v, ""),
        StringView::ends_with(StringView::of("b"), "ab"),
    );
    StringView w = String::view(&s, 3, 8);
    printf("[%s] %v\n", w, StringView::len(w));
    String c = String::from_view(String::view(&s, 6, 11));
    String e = String::from_view(String::view(&s, 2, 2));
    printf("[%s] [%s]\n", &c, &e);
    String t = String::from_str(">");
    String::append(&mut t, String::view(&s, 0, 3));
    String::append(&mut t, String::view(&s, 4, 4));
    String::append(&mut t, String::view(&c, 0, 2));
    printf("%s %v\n", &t, String::len(&t));
}
