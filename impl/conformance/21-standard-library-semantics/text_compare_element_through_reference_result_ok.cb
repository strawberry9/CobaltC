// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.expr.cmp [Cmp-Text] (CHG-0366): a `String` element of a field reached through a generic call's reference result is compared where it is; conf.text-compare-element-through-reference-result
// kind: positive
// expect: ok
// stdout: true false
//
// `Box::get(p).segs[0]` is a place through the reference `Box::get` returns:
// `==` borrows it, as it borrows `p.segs[0]`, and moves nothing. coby's checker
// took it for a value and rejected the comparison `diag.move-out-of-field`.

import std;

struct Path
{
    Vec<String> segs;
}

fn first_is(ref<Box<Path>, shared> p, ref<String, shared> m) : bool
{
    Box::get(p).segs[0] == *m
}

fn main()
{
    Vec<String> v = Vec::new();
    Vec::push(&mut v, String::from_str("std"));
    Box<Path> p = Box::new(Path { .segs = v });
    String a = String::from_str("std");
    String b = String::from_str("io");
    printf("%v %v\n", first_is(&p, &a), first_is(&p, &b));
}
