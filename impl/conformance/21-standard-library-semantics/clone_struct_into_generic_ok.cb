// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.type.bound [T-Clone] (`clone(&x)` is a value of x's type); D-0116; CHG-0359; conf.clone-struct-into-generic
// kind: positive
// expect: ok
// expect-stdout-hex: 3420322035203120332031300a
//
// A copy made by `clone` is a value of the cloned type, whatever takes it:
// here a generic whose type parameter it fixes. `Box::clone` of a `Box`
// of a struct (`Box::new(clone(Box::get(b)))` in `std`), `Box::new(clone(&s))`
// and an enum holding a boxed struct, cloned, each give the struct's
// fields back. (`coby` once read such a copy with no type, so `Box::new`
// allocated for none and the fields came back as other memory.)

import std;

struct IntVal
{
    i32 t;
    i128 v;
}

enum Val
{
    VInt(Box<IntVal>),
    VBool(bool),
}

fn tens(Val w) : i128
{
    match (w)
    {
        Val::VInt(b) : widen<i128>(Box::get(&b).t) * 10 + Box::get(&b).v,
        _            : -1,
    }
}

fn main() : u8
{
    Box<IntVal> bx = Box::new(IntVal { .t = 4, .v = 2 });
    Box<IntVal> by = clone(&bx);
    IntVal s = IntVal { .t = 5, .v = 1 };
    Box<IntVal> bs = Box::new(clone(&s));
    Val v = Val::VInt(Box::new(IntVal { .t = 3, .v = 1 }));
    printf(
        "%v %v %v %v %v %v\n",
        Box::get(&by).t,
        Box::get(&by).v,
        Box::get(&bs).t,
        Box::get(&bs).v,
        tens(clone(&v)) / 10,
        tens(clone(&v)) - 21,
    );
    0
}
