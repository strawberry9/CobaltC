// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: D-0018 rule.alias.borrow [Borrow-Denied]; conf.vec-len-while-exclusively-held-dynamic
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// The length is read through a reference parameter while nothing else
// holds the vector; once another Vec holds an exclusive reference to it,
// the shared borrow `&v` for `Vec::len` conflicts.
//
// D-0290: the reference is stored by a call (`keep_in`), so the frame holds it
// only as `?` (it may hold none of it), and the run checks the access; the
// same program storing it directly is refuted before the run.

import std;

fn size(ref<Vec<i32>, shared> s) : usize
{
    Vec::len(s)
}

fn keep_in(ref<Vec<ref<Vec<i32>, exclusive>>, exclusive> keep, ref<Vec<i32>, exclusive> r)
{
    Vec::push(keep, r);
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    if (size(&v) != 1)
    {
        1 / (1 - 1);
    }
    printf("sized\n");
    Vec<ref<Vec<i32>, exclusive>> h = Vec::new();
    keep_in(&mut h, &mut v);
    usize n = Vec::len(&v);
}
