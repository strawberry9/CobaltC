// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.file [Read-File] [Write-File]; conf.file-round-trip
// kind: positive
// expect: ok
// expect-stdout-hex: 31382062797465732072656164206261636b0a6c696e65206f6e650a6c696e652074776f0a7265706c616365640a4e6f74466f756e640a77726974653a204e6f74466f756e640a5574663820320a
// args: $TMP file_fixtures/not_utf8.txt
//
// Argument 0 is a fresh, empty directory; argument 1 a fixture beside
// this file whose third byte is 0xFF. `write_file` creates a file and
// `read_file` reads back exactly its text; a second `write_file`
// replaces it. A missing file is `NotFound`, for reading and for
// writing into a directory that does not exist; the fixture is
// `Utf8(e)` with `e.offset = 2`. Prints one line per step.

import std;

fn path_in(ref<String, shared> dir, str name) : String
{
    String p = String::new();
    String::append(&mut p, dir);
    String::append(&mut p, "/");
    String::append(&mut p, name);
    p
}

// The error `read_file` gives, as a word (a success is a failure here).
fn read_error(ref<String, shared> path)
{
    match (read_file(path))
    {
        Ok(_) :
        {
            1 / (1 - 1);
        },
        Err(e) :
        {
            match (e)
            {
                NotFound :
                {
                    printf("NotFound\n");
                },
                Denied :
                {
                    printf("Denied\n");
                },
                Io :
                {
                    printf("Io\n");
                },
                Utf8(u) :
                {
                    printf("Utf8 %v\n", u.offset);
                },
            }
        },
    }
}

fn main()
{
    String dir = Result::unwrap_or(arg(0), String::new());
    String fixture = Result::unwrap_or(arg(1), String::new());
    String notes = path_in(&dir, "notes.txt");

    String first = String::from_str("line one\nline two\n");
    match (write_file(&notes, &first))
    {
        Ok(_) :
        {
        },
        Err(_) :
        {
            1 / (1 - 1);
        },
    }
    String back = Result::unwrap_or(read_file(&notes), String::new());
    printf("%v bytes read back\n", String::len(&back));
    printf("%v", &back);

    String second = String::from_str("replaced\n");
    Result::unwrap_or(write_file(&notes, &second), ());
    String again = Result::unwrap_or(read_file(&notes), String::new());
    printf("%v", &again);

    String missing = path_in(&dir, "missing.txt");
    read_error(&missing);
    String nowhere = path_in(&dir, "no-such-dir/x.txt");
    match (write_file(&nowhere, &first))
    {
        Ok(_) :
        {
            1 / (1 - 1);
        },
        Err(e) :
        {
            match (e)
            {
                NotFound :
                {
                    printf("write: NotFound\n");
                },
                _ :
                {
                    1 / (1 - 1);
                },
            }
        },
    }
    read_error(&fixture);
}
