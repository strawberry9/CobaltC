// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec, rule.agg.field-access; conf.vec-struct-in-vec-loops
// kind: positive
// expect: ok
// expect-stdout-hex: 323735203432352031320a
//
// A function looping over the Vec field of a struct it is given by
// reference, called on the elements of a Vec of such structs, its plain
// field updated in the same loop (cobc runs it unchecked after one entry
// test, the struct's own path admitted over an element, D-0190).

import std;

struct Bag
{
    Vec<i64> items;
    i64 total;
}

fn work(ref<Bag, exclusive> b)
{
    for (usize i = 0; i < Vec::len(&b.items); i += 1)
    {
        b.items[i] = b.items[i] + 1;
        b.total += b.items[i];
    }
}

fn main()
{
    Vec<Bag> bags = Vec::new();
    foreach (k in 0..4: i64)
    {
        Vec::push(&mut bags, Bag { .items = Vec::filled(5, k), .total = 0 });
    }
    foreach (r in 0..10)
    {
        foreach (k in 0..4)
        {
            work(&mut bags[k]);
        }
    }
    printf("%v %v %v\n", bags[0].total, bags[3].total, bags[2].items[4]);
}
