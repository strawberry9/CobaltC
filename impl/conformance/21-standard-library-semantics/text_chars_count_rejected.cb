// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §2h; conf.text-chars-count
// kind: negative
// expect: diag.not-char-boundary (dynamic)
// expect-stdout-hex: 30203020303a0a31203120313a205b615d0a36203520353a205b685d205bc3a95d205b6c5d205b6c5d205b6f5d0a39203320333a205be697a55d205be69cac5d205be8aa9e5d0a39203320333a205bf09f99825d205b785d205bf09f99825d0a35203520353a205b615d205b095d205b625d205b0a5d205b635d0a3720370a
//
// StringView::chars and char_count over empty, ASCII, two-, three- and
// four-byte characters and control bytes; String::char_count and chars
// agree; a view cut inside a character faults (D-0193: cobc's native
// chars)

import std;

fn main()
{
    array<str, 6> ts = ["", "a", "héllo", "日本語", "🙂x🙂", "a\tb\nc"];
    foreach (t in ts)
    {
        StringView v = StringView::of(t);
        Vec<StringView> cs = StringView::chars(v);
        printf("%v %v %v:", StringView::len(v), StringView::char_count(v), Vec::len(&cs));
        foreach (c in &cs)
        {
            printf(" [%s]", *c);
        }
        printf("\n");
    }
    String s = String::from_str("ünïcödé");
    printf("%v %v\n", String::char_count(&s), Vec::len(&String::chars(&s)));
    StringView mid = String::view(&s, 2, 7);
    foreach (c in StringView::chars(mid))
    {
        printf("<%s>", c);
    }
    printf("\n");
}
