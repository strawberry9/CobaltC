// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.sort [Sort]; [Cmp-Key] (D-0271, text by its bytes, a prefix first); D-0297; conf.sort-many-texts
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// `Vec::sort` of many texts gives the order `<` gives, whatever the texts
// share: short words with repeats, texts holding zero bytes (a text and
// the same text with a zero byte after it are different, the shorter
// first), one long prefix shared by all, two long prefixes that differ in
// their last byte, texts that are prefixes of one another over many
// bytes, long texts that differ early, groups alike in their first eight
// bytes beside texts that are not, and texts of zero bytes alone, which
// differ in length only. Each vector is sorted twice,
// by `Vec::sort` and by an insertion sort written here with `<`, and the
// two results are the same text for text. A `Vec<str>` of literals
// likewise, and a vector short enough for the runtime's plain merge.

import std;

fn text(ref<Rng, exclusive> rng, str prefix, slice<u8, shared> letters, u64 most) : String
{
    Vec<u8> b = Vec::new();
    foreach (c in StringView::as_bytes(prefix))
    {
        Vec::push(&mut b, *c);
    }
    u64 n = Rng::below(rng, most + 1);
    foreach (i in 0..n)
    {
        Vec::push(&mut b, letters[narrow<usize>(Rng::below(rng, widen<u64>(slice_len(letters))))]);
    }
    Result::unwrap(String::from_utf8(b))
}

fn by_less(ref<Vec<String>, exclusive> v)
{
    foreach (i in 1..Vec::len(v))
    {
        usize j = i;
        while (j > 0 && v[j] < v[j - 1])
        {
            Vec::swap(v, j, j - 1);
            j -= 1;
        }
    }
}

// Sorts `v` both ways and prints how many texts, how many places agree,
// and a sum over the sorted bytes that depends on their order.
fn check(str what, Vec<String> v)
{
    Vec<String> slow = Vec::clone(&v);
    by_less(&mut slow);
    Vec::sort(&mut v);
    usize same = 0;
    u64 sum = 0;
    foreach (i in 0..Vec::len(&v))
    {
        if (v[i] == slow[i])
        {
            same += 1;
        }
        foreach (c in StringView::as_bytes(&v[i]))
        {
            sum = (sum * 31 + widen<u64>(*c) + 1) % 1000000007;
        }
        sum = (sum * 31 + 7) % 1000000007;
    }
    printf("%v: %v texts, %v in place, sum %v\n", what, Vec::len(&v), same, sum);
}

fn main()
{
    Rng rng = Rng::new(20261117);
    array<u8, 2> ab = [97, 98];
    array<u8, 2> zero_a = [0, 97];
    array<u8, 1> a = [97];
    array<u8, 1> zero = [0];
    array<u8, 26> az = [97, 98, 99, 100, 101, 102, 103, 104, 105, 106, 107, 108, 109, 110, 111, 112, 113, 114, 115, 116, 117, 118, 119, 120, 121, 122];

    Vec<String> v = Vec::new();
    foreach (i in 0..300)
    {
        Vec::push(&mut v, text(&mut rng, "", &ab, 6));
    }
    check("short words", v);

    v = Vec::new();
    foreach (i in 0..300)
    {
        Vec::push(&mut v, text(&mut rng, "", &zero_a, 10));
    }
    check("zero bytes", v);

    v = Vec::new();
    foreach (i in 0..300)
    {
        Vec::push(&mut v, text(&mut rng, "the/prefix/they/all/share/", &ab, 12));
    }
    check("one prefix", v);

    v = Vec::new();
    foreach (i in 0..300)
    {
        if (Rng::below(&mut rng, 2) == 0)
        {
            Vec::push(&mut v, text(&mut rng, "aaaaaaaaaaaaaaaaaaaaaaaa", &ab, 9));
        }
        else
        {
            Vec::push(&mut v, text(&mut rng, "aaaaaaaaaaaaaaaaaaaaaaab", &ab, 9));
        }
    }
    check("two prefixes", v);

    v = Vec::new();
    foreach (i in 0..300)
    {
        Vec::push(&mut v, text(&mut rng, "", &a, 60));
    }
    check("prefixes of one another", v);

    v = Vec::new();
    foreach (i in 0..300)
    {
        Vec::push(&mut v, text(&mut rng, "", &az, 30));
    }
    check("long texts", v);

    v = Vec::new();
    foreach (i in 0..300)
    {
        match (Rng::below(&mut rng, 3))
        {
            0 : Vec::push(&mut v, text(&mut rng, "aaaaaaaa", &ab, 12)),
            1 : Vec::push(&mut v, text(&mut rng, "bbbbbbbb", &ab, 12)),
            _ : Vec::push(&mut v, text(&mut rng, "ab", &ab, 12)),
        }
    }
    check("groups alike in eight bytes", v);

    v = Vec::new();
    foreach (i in 0..300)
    {
        Vec::push(&mut v, text(&mut rng, "", &zero, 20));
    }
    check("zero bytes alone", v);

    v = Vec::new();
    foreach (i in 0..31)
    {
        Vec::push(&mut v, text(&mut rng, "aaaaaaaaaaaa", &ab, 12));
    }
    check("a short vector", v);

    v = Vec::new();
    foreach (i in 0..200)
    {
        Vec::push(&mut v, sprintf("line %v", i + 1000));
    }
    check("in order already", v);

    Vec<str> names = Vec::new();
    array<str, 36> src = ["pear", "apple", "app", "", "apple pie", "apple", "banana", "band", "ban", "bandage", "a long name that goes on", "a long name that goes on and on", "a long name that goes", "a long name that goes on.", "zebra", "Zebra", "apricot", "apricots", "appl", "applesauce", "b", "a", "ba", "ab", "aa", "bb", "pea", "peach", "pearl", "pears", "a long name", "a long nam", "a long name that", "a long name that goes off", "cherry", "cherries"];
    foreach (s in src)
    {
        Vec::push(&mut names, s);
    }
    Vec::sort(&mut names);
    usize ordered = 0;
    foreach (i in 1..Vec::len(&names))
    {
        if (!(names[i] < names[i - 1]))
        {
            ordered += 1;
        }
    }
    printf("literals: %v, %v pairs in order, first [%v] [%v] [%v], last [%v]\n", Vec::len(&names), ordered, names[0], names[1], names[2], names[35]);
}
