// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `Vec::filled`; conf.vec-filled-element-kinds
// kind: positive
// expect: ok
// expect-stdout-hex: 36203320372031202d3220747275650a2d392032303020312e35203320300a6c6967687420340a686920320a3130303030300a
//
// `Vec::filled(n, x)`: n clones of x, for bytes, wider integers, bool, a
// struct, an array, an enum with a payload, none at all, and a resource
// (`String`, cloned); the vector then grows and is written as any other.
// (`cobc` fills a plain element type at once, 2026-10-08.)

import std;

struct P
{
    i32 a;
    u8 b;
    f64 c;
}

enum Shade
{
    Dark,
    Light(u16),
}

fn main()
{
    Vec<u8> a = Vec::filled(5, 7: u8);
    Vec<i64> b = Vec::filled(3, -2: i64);
    Vec<bool> c = Vec::filled(4, true);
    Vec<P> d = Vec::filled(2, P { .a = -9, .b = 200, .c = 1.5 });
    array<u16, 3> e3 = [1, 2, 3];
    Vec<array<u16, 3>> e = Vec::filled(2, e3);
    Vec<Shade> g = Vec::filled(3, Shade::Light(4));
    Vec<u32> z = Vec::filled(0, 1: u32);
    Vec<String> s = Vec::filled(2, String::from_str("hi"));
    Vec::push(&mut a, 1);
    a[0] = 3;
    printf("%v %v %v %v %v %v\n", Vec::len(&a), a[0], a[1], a[5], b[2], c[3]);
    printf("%v %v %v %v %v\n", d[1].a, d[1].b, d[1].c, e[1][2], Vec::len(&z));
    match (g[2])
    {
        Shade::Light(n) : printf("light %v\n", n),
        Shade::Dark     : printf("dark\n"),
    }
    printf("%v %v\n", &s[1], Vec::len(&s));
    Vec<u64> big = Vec::filled(20000, 5: u64);
    u64 t = 0;
    foreach (i in 0..Vec::len(&big))
    {
        t += big[i];
    }
    printf("%v\n", t);
}
