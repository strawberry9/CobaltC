// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.arith.float-fns (std::math's since D-0136); rule.module.resolve [Resolve-Unqualified]; conf.float-fn-name-own-item
// kind: positive
// expect: ok
// expect-stdout-hex: 3520332e300a
//
// A program's own `round` is an ordinary item: the root calls it, and
// the module `m`, which imports `std`, calls `std::math`'s.

import std;

fn round(i32 x) : i32
{
    x + 1
}

module m
{
    import std;

    export fn half_up() : f64
    {
        round(2.5)
    }
}

fn main()
{
    printf("%v %v\n", round(4), m::half_up());
}
