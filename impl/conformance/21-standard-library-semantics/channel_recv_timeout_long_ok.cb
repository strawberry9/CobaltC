// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.channel (D-0063, D-0232: a wait too long for the clock waits as long as it can); conf.channel-recv-timeout-long
// kind: positive
// expect: ok
//
// `Channel::recv_timeout_ms` with the largest `u64` waits for the value a
// thread sends a little later. Before, the milliseconds wrapped round in
// nanoseconds to a deadline in the past, and the wait ended at once with
// `Ok(None)`.

import std;

fn later(ref<Channel<i32>, shared> ch) : u8
{
    sleep_ms(50);
    _ = Channel::send(ch, 7);
    0
}

fn main() : u8
{
    Channel<i32> ch = Channel::new(1);
    auto h = spawn(later, &ch);
    auto got = Channel::recv_timeout_ms(&ch, max_value<u64>());
    _ = join(h);
    match (got)
    {
        Ok(Some(7)) : 0,
        _           : 1,
    }
}
