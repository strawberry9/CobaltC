// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.time [Local-Offset] [To-Local] (D-0147); conf.local-offset-range, conf.to-local-consistent
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// The machine's offset is the platform's and is never printed; what holds
// of it everywhere is: within 18 hours of UTC, whole minutes, the same
// when asked twice, and `to_local` is `from_unix` of the moment plus the
// offset. A moment far outside any zone's records converts too (the
// offset now).

import std;

fn main() : u8
{
    i64 now = unix_seconds();
    i64 o = local_offset_seconds(now);
    printf(
        "within 18 hours: %v, whole minutes: %v, same twice: %v\n",
        o >= -64800 && o <= 64800,
        o % 60 == 0,
        o == local_offset_seconds(now),
    );
    DateTime t = DateTime::from_unix(1791022620);
    i64 s = DateTime::to_unix(&t);
    DateTime l = DateTime::to_local(&t);
    DateTime shifted = DateTime::from_unix(s + local_offset_seconds(s));
    printf("to_local is the shifted moment: %v\n", DateTime::eq(&l, &shifted));
    DateTime later = DateTime::to_local(&DateTime::from_unix(1791022621));
    printf("a second later: %v\n", DateTime::to_unix(&later) - DateTime::to_unix(&l) == 1);
    DateTime ancient = DateTime::to_local(&DateTime::from_unix(-377705116800));
    DateTime far = DateTime::to_local(&DateTime::from_unix(253402300799));
    printf("far moments convert: %v %v\n", ancient.year <= -9999, far.year >= 9999);
    0
}
