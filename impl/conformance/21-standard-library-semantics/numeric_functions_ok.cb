// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.arith.float-fns, D-0091 `min` `max` `abs` `pow` `HashMap::clear`; conf.hashmap-clear conf.min-max conf.pow-checked conf.float-fns
// kind: positive
// expect: ok
//
// The numeric functions at integer and floating-point types, their edge
// cases, and a map emptied and used again.

import std;

fn main() : u8
{
    if (min(3, -4) != -4 || max(7: u8, 9: u8) != 9 || min(2.5, -0.5) != -0.5) { return 1; }
    if (abs(-7) != 7 || abs(7: u32) != 7 || abs(-2.5) != 2.5) { return 2; }
    if (pow(2, 10) != 1024 || pow(-2, 31) != -2147483648 || pow(1.5, 3) != 3.375 || pow(10.0, 0) != 1.0) { return 3; }
    if (sqrt(144.0) != 12.0 || floor(-2.5) != -3.0 || ceil(-2.5) != -2.0) { return 4; }
    if (round(2.5) != 3.0 || round(-2.5) != -3.0 || round(0.49999999999999994) != 0.0 || trunc(-2.7) != -2.0) { return 5; }
    if (sqrt(2.0: f32) * sqrt(2.0: f32) == 2.0: f32) { return 6; }
    HashMap<String, u32> m = HashMap::new();
    usize i = 0;
    while (i < 100)
    {
        HashMap::insert(&mut m, sprintf("k%d", i), 1);
        i += 1;
    }
    HashMap::clear(&mut m);
    if (HashMap::len(&m) != 0 || HashMap::contains(&m, &String::from_str("k5"))) { return 7; }
    HashMap::insert(&mut m, String::from_str("again"), 2);
    if (HashMap::len(&m) != 1) { return 8; }
    0
}
