// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `Vec::any`, `Vec::all`, `Vec::count` (D-0325); conf.vec-any, conf.vec-all, conf.vec-count
// kind: positive
// expect: ok
//
// The three predicate questions of D-0325 on plain and resource elements:
// `any` stops at the first element the predicate holds for and `all` at
// the first it fails for (a counting predicate shows how many calls each
// made); `count` calls it once per element; an empty `Vec` gives `false`,
// `true` and `0`; a predicate that captures a value is a closure like any.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 4);
    Vec::push(&mut v, 9);
    Vec::push(&mut v, 6);
    Vec::push(&mut v, 12);
    i32 calls = 0;
    assert(Vec::any(&v, [calls](ref<i32, shared> x) : bool
    {
        calls += 1;
        *x > 5
    }));
    assert(calls == 2);
    calls = 0;
    assert(!Vec::all(&v, [calls](ref<i32, shared> x) : bool
    {
        calls += 1;
        *x > 5
    }));
    assert(calls == 1);
    calls = 0;
    assert(Vec::count(&v, [calls](ref<i32, shared> x) : bool
    {
        calls += 1;
        *x > 5
    }) == 3);
    assert(calls == 4);

    Vec<i32> none = Vec::new();
    assert(!Vec::any(&none, [](ref<i32, shared> x) : bool { *x > 5 }));
    assert(Vec::all(&none, [](ref<i32, shared> x) : bool { *x > 5 }));
    assert(Vec::count(&none, [](ref<i32, shared> x) : bool { *x > 5 }) == 0);

    Vec<String> words = Vec::new();
    Vec::push(&mut words, "alpha");
    Vec::push(&mut words, "be");
    Vec::push(&mut words, "gamma");
    usize lim = 3;
    assert(Vec::count(&words, [lim](ref<String, shared> s) : bool { StringView::len(s) > lim }) == 2);
    assert(Vec::all(&words, [](ref<String, shared> s) : bool { StringView::len(s) > 0 }));
    assert(!Vec::any(&words, [](ref<String, shared> s) : bool { *s == "delta" }));
    printf("%v %v\n", Vec::len(&v), Vec::len(&words));
}
