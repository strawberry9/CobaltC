// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.file-handle [File-Read-Line]; D-0092; conf.file-read-line-crlf
// kind: positive
// expect: ok
// expect-stdout-hex: 61627c7c63640d7c0a
// args: $TMP
//
// Argument 0 is a fresh, empty directory. A file holding
// `ab\r\n\ncd\r` reads as three lines -- `ab` (the `\r` before the
// `\n` is consumed with it, D-0092), an empty line, and `cd\r`, which
// ends at the end of the file without a `\n`, so its `\r` stays --
// then `Ok(None)`: `File::read_line` and `read_line` on standard
// input agree.

import std;

fn expect_line(ref<File, exclusive> f, usize len)
{
    match (File::read_line(f))
    {
        Ok(line) :
        {
            match (line)
            {
                Some(s) :
                {
                    if (String::len(&s) != len)
                    {
                        1 / (1 - 1);
                    }
                    printf("%v|", &s);
                },
                None    :
                {
                    1 / (1 - 1);
                },
            }
        },
        Err(_)   :
        {
            1 / (1 - 1);
        },
    }
}

fn main()
{
    String dir = Result::unwrap_or(arg(0), String::new());
    String p = String::new();
    String::append(&mut p, &dir);
    String::append(&mut p, "/crlf.txt");
    String text = "ab\r\n\ncd\r";
    match (write_file(&p[0..$], &text[0..$]))
    {
        Ok(_)  :
        {
        },
        Err(_) :
        {
            1 / (1 - 1);
        },
    }
    File f = match (File::open(&p[0..$]))
    {
        Ok(f)  : f,
        Err(_) : fault(assert_failed),
    };
    expect_line(&mut f, 2);
    expect_line(&mut f, 0);
    expect_line(&mut f, 3);
    match (File::read_line(&mut f))
    {
        Ok(line) :
        {
            match (line)
            {
                Some(_) :
                {
                    1 / (1 - 1);
                },
                None    :
                {
                },
            }
        },
        Err(_)   :
        {
            1 / (1 - 1);
        },
    }
    printf("\n");
}
