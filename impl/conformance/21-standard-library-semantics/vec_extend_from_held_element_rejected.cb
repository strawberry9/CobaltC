// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `extend_from`, [Read-Conflict]; conf.vec-extend-from-held-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 6265666f726520310a
//
// Vec::extend_from(&mut c, &v[0..2]) reads v[1] while an exclusive
// reference to it lives.

import std;

fn main() : u8
{
    Vec<i64> v = Vec::filled(4, 2: i64);
    v[2] = 1;
    Vec::reserve(&mut v, 10);
    Vec<ref<i64, exclusive>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &mut v[1]);
    }
    printf("before %v\n", Vec::len(&held));
    Vec<i64> c = Vec::new();
    Vec::extend_from(&mut c, &v[0..2]);
    printf("%v\\n", Vec::len(&c));
    printf("after %v\n", *held[0]);
    0
}
