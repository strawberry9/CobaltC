// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview [Ref-String-View] (D-0302); conf.ref-string-view-mut-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// A view only reads its text, so `&mut s` is not admitted where a
// `StringView` is declared; the message says to pass `&s`.

import std;

fn show(StringView v)
{
    printf("[%s]\n", v);
}

fn main() : u8
{
    String s = "abc";
    show(&mut s);
    return 0;
}
