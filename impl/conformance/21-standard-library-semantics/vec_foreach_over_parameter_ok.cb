// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.control.foreach, D-0190; conf.vec-foreach-over-parameter
// kind: positive
// expect: ok
// expect-stdout-hex: 31302033203133350a34312031390a302031300a
//
// foreach (x in v) over ref<Vec<i64>, exclusive> and ref<Vec<i64>,
// shared> parameters: continue and break, an empty vector, nested loops
// over the same vector shared.

import std;

fn bump(ref<Vec<i64>, exclusive> v, i64 k)
{
    foreach (x in v)
    {
        if (*x == 3)
        {
            continue;
        }
        *x += k;
        if (*x > 40)
        {
            break;
        }
    }
}

fn total(ref<Vec<i64>, shared> v) : i64
{
    i64 t = 0;
    foreach (x in v)
    {
        t += *x;
    }
    t
}

fn pairs(ref<Vec<i64>, shared> a, ref<Vec<i64>, shared> b) : i64
{
    i64 n = 0;
    foreach (x in a)
    {
        foreach (y in b)
        {
            if (*x == *y)
            {
                n += 1;
            }
        }
    }
    n
}

fn main()
{
    Vec<i64> v = Vec::new();
    foreach (i in 0..10: i64)
    {
        Vec::push(&mut v, i);
    }
    bump(&mut v, 10);
    printf("%v %v %v\n", v[0], v[3], total(&v));
    bump(&mut v, 30);
    printf("%v %v\n", v[1], v[9]);
    Vec<i64> e = Vec::new();
    bump(&mut e, 1);
    printf("%v %v\n", total(&e), pairs(&v, &v));
}
