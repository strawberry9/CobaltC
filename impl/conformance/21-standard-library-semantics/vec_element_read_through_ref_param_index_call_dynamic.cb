// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: diag.index-out-of-bounds [Call]
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// An element read at once through a reference parameter, with an index
// computed by a call: the call runs (and prints) before the bounds check,
// both times.

import std;

fn pick(u64 k) : usize
{
    printf("pick\n");
    narrow<usize>(k)
}

fn get(ref<Vec<i32>, shared> s, u64 k) : i32
{
    *Vec::index_shared(s, pick(k))
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 4);
    if (get(&v, 0) != 4)
    {
        1 / (1 - 1);
    }
    get(&v, 3);
}
