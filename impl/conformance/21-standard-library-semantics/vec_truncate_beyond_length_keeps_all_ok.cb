// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `Vec::truncate` (D-0085); conf.vec-truncate-beyond-length
// kind: positive
// expect: ok
//
// `Vec::truncate(v, n)` keeps at most `n` elements: a length at or
// beyond the `Vec`'s changes nothing.

import std;

fn main() : u8
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    Vec::truncate(&mut v, 5);
    Vec::truncate(&mut v, 2);
    if (Vec::len(&v) != 2 || v[1] != 2) { return 1; }
    Vec::truncate(&mut v, 0);
    Vec::truncate(&mut v, 1);
    if (Vec::len(&v) != 0) { return 2; }
    0
}
