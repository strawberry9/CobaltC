// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.type.probe `probe<K>` (D-0312): a generic function takes the key's probe and hands it on; each instantiation's probe is its key's; conf.probe-generic-parameter
// kind: positive
// expect: ok
// expect-stdout-hex: 747275652066616c736520747275650a
//

import std;

fn has<K>(ref<HashMap<K, i32>, shared> m, probe<K> k) : bool
{
    HashMap::contains(m, k)
}

fn main()
{
    HashMap<String, i32> a = HashMap::new();
    HashMap::insert(&mut a, "x", 1);
    HashMap<i64, i32> b = HashMap::new();
    HashMap::insert(&mut b, 3, 1);
    String s = "x";
    printf("%v %v %v\n", has(&a, &s), has(&a, "y"), has(&b, 3));
}
