// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.file-handle [File-Drop]; rule.resauth.destroy-composite; D-0054; conf.file-destructor-closes
// kind: positive
// expect: ok
// expect-stdout-hex: 3232323030300a3131312031303720323535202f20313131203130370a
//
// A `File` the program never closes is closed by its destructor at the
// end of its scope: the fixture is opened 2000 times, more than a common
// limit of open files (1024), and each open succeeds. Two files open at
// once keep their own positions.

import std;

fn opened(ref<String, shared> path) : File
{
    match (File::open(path))
    {
        Ok(f) : f,
        Err(_) : fault(assertion_failed),
    }
}

fn first_byte(ref<String, shared> path) : u8
{
    File f = opened(path);
    Vec<u8> b = Vec::new();
    Result::unwrap_or(File::read(&mut f, &mut b, 1), 0);
    b[0]
}

fn main()
{
    String path = String::from_str("file_fixtures/not_utf8.txt");
    usize sum = 0;
    usize i = 0;
    while (i < 2000)
    {
        sum = sum + widen<usize>(first_byte(&path));
        i = i + 1;
    }
    printf("%v\n", sum);

    File one = opened(&path);
    File two = opened(&path);
    Vec<u8> a = Vec::new();
    Vec<u8> b = Vec::new();
    Result::unwrap_or(File::read(&mut one, &mut a, 2), 0);
    Result::unwrap_or(File::read(&mut two, &mut b, 1), 0);
    Result::unwrap_or(File::read(&mut one, &mut a, 1), 0);
    Result::unwrap_or(File::read(&mut two, &mut b, 1), 0);
    printf("%v %v %v / %v %v\n", a[0], a[1], a[2], b[0], b[1]);
}
