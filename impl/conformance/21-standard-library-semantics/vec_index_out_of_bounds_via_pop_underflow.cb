// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec (index_shared bounds); conf.vec-index-out-of-bounds-via-pop-underflow
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// Indexing past a Vec's current length is rejected dynamically, using
// the same fault the fixed-size array bounds check uses.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::index_shared(&v, 5);
}
