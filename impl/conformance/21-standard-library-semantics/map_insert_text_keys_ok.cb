// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.hashmap `HashMap::insert` (D-0315); conf.map-insert-text-keys
// kind: positive
// expect: ok
// expect-stdout-hex: 6f6c64203230350a323520656e74726965732c20746f74616c20353739300a6b657937203233320a32342066616c73650a
//
// `HashMap::insert` with `String` keys made at run time, new and already
// present: a new key is kept, a present one is ended at once, the old value
// comes back, and every key reads back whole after the map grows.

import std;

fn main()
{
    HashMap<String, usize> m = HashMap::new();
    for (usize round = 0; round < 3; round += 1)
    {
        for (usize i = 0; i < 40; i += 1)
        {
            String k = sprintf("key%v", i % 25);
            match (HashMap::insert(&mut m, k, i + round * 100))
            {
                Some(old) : { if (i == 30 && round == 2) { printf("old %v\n", old); } },
                None      : {},
            }
        }
    }
    usize total = 0;
    foreach (k, v in &m)
    {
        total += StringView::len(k) + *v;
    }
    printf("%v entries, total %v\n", HashMap::len(&m), total);
    printf("key7 %v\n", *Option::unwrap(HashMap::get(&m, "key7")));
    _ = HashMap::remove(&mut m, "key7");
    printf("%v %v\n", HashMap::len(&m), HashMap::contains(&m, "key7"));
}
