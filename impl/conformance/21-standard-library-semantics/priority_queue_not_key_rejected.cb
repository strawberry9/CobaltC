// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.priority-queue [Priority-Queue-Not-Key] (D-0137); conf.priority-queue-not-key
// kind: negative
// expect: diag.type-mismatch (static)
//
// `PriorityQueue::new` orders by the key types' own order (and a
// float's, since D-0181), which a `Vec` does not have; `new_by` with a
// comparison is the way, as `sort_by` is for `sort`.

import std;

fn main()
{
    PriorityQueue<Vec<u8>> q = PriorityQueue::new();
    PriorityQueue::push(&mut q, Vec::new());
}
