// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.string (from_utf8)
// kind: positive
// expect: ok
//
// A valid multi-byte UTF-8 sequence is accepted (Ok); a truncated
// multi-byte sequence is rejected (Err), without a host panic either
// way.

import std;

fn main()
{
    Vec<u8> good = Vec::new();
    Vec::push(&mut good, 226);
    Vec::push(&mut good, 130);
    Vec::push(&mut good, 172);
    match (String::from_utf8(good))
    {
        Ok(_) :
        {
        },
        Err(_) :
        {
            1 / (1 - 1);
        },
    }
    Vec<u8> bad = Vec::new();
    Vec::push(&mut bad, 226);
    Vec::push(&mut bad, 130);
    match (String::from_utf8(bad))
    {
        Ok(_) :
        {
            1 / (1 - 1);
        },
        Err(_) :
        {
        },
    }
}
