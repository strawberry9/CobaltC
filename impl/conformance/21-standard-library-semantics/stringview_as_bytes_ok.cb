// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview `[View-As-Bytes]` (D-0163); conf.stringview-as-bytes
// kind: positive
// expect: ok
// expect-stdout-hex: 626137383136626638663031636665613431343134306465356461653232323362303033363161333936313737613963623431306666363166323030313561640a3133203620313935203131310a396365396536626639656261393431343263653261616566346137303539653431313931646238346563373864383636666538613665623633653237356162630a
//
// `StringView::as_bytes` gives a view's bytes as a slice, without copying,
// to whatever takes `slice<u8, shared>`: from a literal (a view in that
// position), a `String`'s view, and a part of one.

import std;

fn main() : u8
{
    array<u8, 32> d = sha256(StringView::as_bytes("abc"));
    printf("%s\n", &to_hex(&d[0..$]));
    String s = "héllo, world";
    slice<u8, shared> all = StringView::as_bytes(String::as_view(&s));
    slice<u8, shared> part = StringView::as_bytes(String::view(&s, 0, 6));
    printf("%u %u %u %u\n", slice_len(all), slice_len(part), all[1], part[5]);
    printf("%s\n", &to_hex(&hmac_sha256(StringView::as_bytes("key"), StringView::as_bytes(String::as_view(&s)))[0..$]));
    0
}
