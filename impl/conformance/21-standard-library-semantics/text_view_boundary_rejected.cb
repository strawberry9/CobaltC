// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.text (from_view, view); conf.text-substring-not-char-boundary
// kind: negative
// expect: diag.not-char-boundary (dynamic)
//
// A copy of part of a `String` whose end falls inside a character.

import std;

fn main()
{
    String s = String::from_str("aé");
    String c = String::from_view(String::view(&s, 0, 2));
    printf("%s\n", &c);
}
