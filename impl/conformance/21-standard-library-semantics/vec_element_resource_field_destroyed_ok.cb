// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec (Vec::drop destroys each element); rule.resauth.destroy-composite on a reclaimed object
// kind: positive
// expect: ok
//
// An element type with no destructor of its own but a resource field:
// destroying the Vec destroys that field in every element.

import std;

resource struct Flagger
{
    ref<i32, exclusive> flag;
}

fn Flagger::drop(ref<Flagger, exclusive> self)
{
    *self.flag = *self.flag + 1;
}

struct Holder
{
    Flagger f;
    i32 tag;
}

fn main()
{
    i32 a = 0;
    i32 b = 0;
    {
        Vec<Holder> v = Vec::new();
        Vec::push(&mut v, Holder { .f = Flagger { .flag = &mut a }, .tag = 1 });
        Vec::push(&mut v, Holder { .f = Flagger { .flag = &mut b }, .tag = 2 });
    }
    if (a != 1 || b != 1)
    {
        1 / (1 - 1);
    }
}
