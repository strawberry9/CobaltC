// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.print [Print-Buffer]; D-0178; conf.stdout-buffer-boundary
// kind: positive
// expect: ok
//
// Writes that cross the buffer's boundaries, and one larger than any
// buffer, arrive whole and in order. `cobc/tests/compiled_suite.rs`
// checks that `cobc`'s bytes are `coby`'s; the counts are chosen so the
// text is not a multiple of a power of two.

import std;

fn main()
{
    i32 i = 0;
    while (i < 1_500)
    {
        printf("%d,", i);
        i += 1;
    }
    printf("\n");
    String big = String::new();
    i = 0;
    while (i < 9_000)
    {
        String::append(&mut big, "xyz");
        i += 1;
    }
    printf("%v|\n", &big);
    eprintf("between\n");
    printf("end %d\n", i);
}
