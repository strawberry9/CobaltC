// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Ecdsa] (D-0159); conf.ecdsa-p384
// kind: positive
// expect: ok
// slow: interpreted big-number arithmetic takes well over the 10-second budget
// expect-stdout-hex: 76616c69643a20747275650a6f6666207468652063757276653a2066616c73650a7472756e6361746564207369676e61747572653a2066616c73650a
//
// ECDSA verification on P384 with vectors made by Python's
// `cryptography`: a valid signature, a point not on the curve, and a
// malformed signature (s changed: crypto_ecdsa_p384_tamper_ok.cb).

import std;

fn bytes_of(str t) : Vec<u8>
{
    Result::unwrap_or(from_hex(StringView::of(t)), Vec::new())
}

fn main() : u8
{
    Vec<u8> key = bytes_of("046a87c2b23292165cfc008d99fb999a995dfed73ce55abecbb3b53f74c1a9a6f294414e44790e3754a35a7114e1c4a8c664e3b0c347c67bea66abf8c3098bd73512cd799d449b21aed15085b63f802bd78d95ccb1b82983997044d406c814b7c2");
    Vec<u8> digest = bytes_of("92d59d637fd3957bbf11b104b2e7fb507d8b20e493db92466d7d7ee3b83078bbf787070ec6d482d83de0bbc145ecafba");
    Vec<u8> good = bytes_of("30650231008589e564ee173f7016148b2f469e782abb9ceb3456b626c7c06c22d3593b2b68bc0df6b1fecacf169616e408c8f3c33202302468a13f6c99d32bb42b51ce95a629512e92240a2c429a8ef52ec198106500b2efd07d416ba0f50628c385fdeda5e27e");
    printf("valid: %v\n", ecdsa_verify(P384, &key[0..$], &digest[0..$], &good[0..$]));
    Vec<u8> off = Vec::clone(&key);
    usize last = Vec::len(&off) - 1;
    off[last] = off[last] ^ 1;
    printf("off the curve: %v\n", ecdsa_verify(P384, &off[0..$], &digest[0..$], &good[0..$]));
    Vec<u8> cut = Vec::from_slice(&good[0..Vec::len(&good) - 1]);
    printf("truncated signature: %v\n", ecdsa_verify(P384, &key[0..$], &digest[0..$], &cut[0..$]));
    0
}
