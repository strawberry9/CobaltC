// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.agg.match (a binder of the whole scrutinee, D-0058); rule.stdlib.hashmap `HashMap::get_mut`
// kind: positive
// expect: ok
//
// A match on a call that returns `Option<ref<T>>`, with an arm that binds
// the whole value and matches it again: the reference it holds is live in
// that binding, so writing through it and reading the map afterwards both
// see the write.

import std;

fn main()
{
    HashMap<String, u32> m = HashMap::new();
    String k = String::from_str("a");
    _ = HashMap::insert(&mut m, String::clone(&k), 1);
    match (HashMap::get_mut(&mut m, &k))
    {
        None : printf("none\n"),
        other : {
            match (other)
            {
                Some(c) : { *c += 41; printf("%v\n", *c); },
                None    : {},
            }
        },
    }
    printf("%v\n", *Option::unwrap(HashMap::get(&m, &k)));
}
