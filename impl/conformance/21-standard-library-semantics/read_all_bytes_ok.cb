// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.read [Read-All] (D-0145); conf.read-all-bytes
// kind: positive
// expect: ok
// expect-stdout-hex: 342062797465733a2030302066662030612034310a617320746578743a206e6f74205554462d38206174206279746520310a
// stdin-hex: 00ff0a41
//
// `read_all_bytes` gives every byte, whatever they are, even bytes that
// are not UTF-8.

import std;

fn main()
{
    match (read_all_bytes())
    {
        Ok(b)  :
        {
            printf("%u bytes:", Vec::len(&b));
            foreach (x in &b)
            {
                printf(" %02x", *x);
            }
            printf("\n");
            match (String::from_utf8(b))
            {
                Ok(_)  : printf("text?\n"),
                Err(e) : printf("as text: not UTF-8 at byte %u\n", e.offset),
            }
        },
        Err(e) : printf("read_all_bytes: %s\n", FileError::text(&e)),
    }
}
