// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.tls [Tls-Server] (D-0186); conf.tls-short-key-share
// kind: positive
// expect: ok
// slow: a TLS handshake takes seconds interpreted
//
// Hermetic: a TLS 1.3 server in one thread (the self-signed Ed25519
// certificate of conf.tls-server), raw clients in the main thread. A
// ClientHello whose X25519 key share is 31 bytes, and a second
// ClientHello, after the server's HelloRetryRequest for P-256, whose
// share is 64 bytes: each is answered with the alert illegal_parameter
// (47) and `TlsStream::server` is `Err(HandshakeFailed)` -- the process
// goes on (a share of the wrong length once reached `x25519`, which
// faults). A real client is then served, its stream's timeouts set
// (`TlsStream::set_read_timeout_ms`, `set_write_timeout_ms`).

import std;

const str KEY = "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIG/xpX/23qwZ8iDRpzBtyYErXB+yw1ePRPCeOrMbHv6h\n-----END PRIVATE KEY-----\n";
const str CRT = "-----BEGIN CERTIFICATE-----\nMIIBfzCCATGgAwIBAgIUT5+4C2nK5/ckjqCAbHutlwq/fFowBQYDK2VwMBQxEjAQ\nBgNVBAMMCWxvY2FsaG9zdDAgFw0yNjEwMDcwNTE1MDFaGA8yMTAwMDkwOTA1MTUw\nMVowFDESMBAGA1UEAwwJbG9jYWxob3N0MCowBQYDK2VwAyEAegP8qkgXtxseLdoQ\nVA0JHXycpuJ8Pngy7dgQ3xsz552jgZIwgY8wHQYDVR0OBBYEFDSsOJwWBXtwFB5F\nALP2IghQZGKuMB8GA1UdIwQYMBaAFDSsOJwWBXtwFB5FALP2IghQZGKuMA8GA1Ud\nEwEB/wQFMAMBAf8wCwYDVR0PBAQDAgKEMBMGA1UdJQQMMAoGCCsGAQUFBwMBMBoG\nA1UdEQQTMBGCCWxvY2FsaG9zdIcEfwAAATAFBgMrZXADQQBo4o2RWAyOEsn05+06\n9J3Dk9EvdsEp2cq67rhtYhNMNEEOvAUQ3bY3x/ykp+tcRbGW/RKox3FHoJUKTkw8\ng2AG\n-----END CERTIFICATE-----\n";

fn serve(TcpListener l, PrivateKey key, Vec<Certificate> chain) : String
{
    String log = String::new();
    for (usize i = 0; i < 3; i += 1)
    {
        TcpStream tcp = Result::unwrap(TcpListener::accept(&mut l));
        TcpStream::set_read_timeout_ms(&mut tcp, 20000);
        match (TlsStream::server(tcp, &key, &chain))
        {
            Ok(s)  :
            {
                String::append(&mut log, "server: served\n");
                _ = TlsStream::write_text(&mut s, "hello\n");
                _ = TlsStream::close(&mut s);
            },
            Err(e) : String::append(&mut log, &sprintf("server: %s\n", TlsError::text(&e))),
        }
    }
    log
}

fn ext(ref<Vec<u8>, exclusive> out, u16 kind, slice<u8, shared> data)
{
    Vec::push_be(out, kind);
    Vec::push_be(out, narrow<u16>(slice_len(data)));
    Vec::extend_from(out, data);
}

// A ClientHello record: TLS 1.3, TLS_AES_128_GCM_SHA256, the group
// `group` supported, a key share of `share_len` bytes for it (none when
// 0), a fixed random and session id.
fn client_hello(u16 group, usize share_len) : Vec<u8>
{
    Vec<u8> e = Vec::new();
    Vec<u8> groups = Vec::new();
    Vec::push_be<u16>(&mut groups, 2);
    Vec::push_be(&mut groups, group);
    ext(&mut e, 0x000a, &groups);
    ext(&mut e, 0x000d, b"\x00\x02\x08\x07");
    ext(&mut e, 0x002b, b"\x02\x03\x04");
    Vec<u8> ks = Vec::new();
    if (share_len > 0)
    {
        Vec::push_be(&mut ks, narrow<u16>(4 + share_len));
        Vec::push_be(&mut ks, group);
        Vec::push_be(&mut ks, narrow<u16>(share_len));
        Vec::extend_from(&mut ks, &Vec::filled(share_len, 0x42: u8));
    }
    else
    {
        Vec::push_be<u16>(&mut ks, 0);
    }
    ext(&mut e, 0x0033, &ks);
    Vec<u8> body = Vec::new();
    Vec::extend_from(&mut body, b"\x03\x03");
    Vec::extend_from(&mut body, &Vec::filled(32, 0x11: u8));
    Vec::push(&mut body, 32);
    Vec::extend_from(&mut body, &Vec::filled(32, 0x22: u8));
    Vec::extend_from(&mut body, b"\x00\x02\x13\x01\x01\x00");
    Vec::push_be(&mut body, narrow<u16>(Vec::len(&e)));
    Vec::extend_from(&mut body, &e);
    Vec<u8> m = Vec::new();
    Vec::push(&mut m, 1);
    Vec::push(&mut m, 0);
    Vec::push_be(&mut m, narrow<u16>(Vec::len(&body)));
    Vec::extend_from(&mut m, &body);
    Vec<u8> rec = Vec::new();
    Vec::extend_from(&mut rec, b"\x16\x03\x01");
    Vec::push_be(&mut rec, narrow<u16>(Vec::len(&m)));
    Vec::extend_from(&mut rec, &m);
    rec
}

// Whether the bytes end with a fatal plaintext alert, and its code.
fn alert_of(ref<Vec<u8>, shared> got) : String
{
    usize n = Vec::len(got);
    if (n >= 7 && got[n - 7] == 21 && got[n - 3] == 2)
    {
        return sprintf("alert %v", got[n - 1]);
    }
    "no alert"
}

fn read_some(ref<TcpStream, exclusive> t) : Vec<u8>
{
    Vec<u8> got = Vec::new();
    _ = TcpStream::read(t, &mut got, 65536);
    got
}

fn read_all(ref<TcpStream, exclusive> t) : Vec<u8>
{
    Vec<u8> got = Vec::new();
    while (true)
    {
        match (TcpStream::read(t, &mut got, 65536))
        {
            Ok(n)  : if (n == 0) { break; },
            Err(_) : break,
        }
    }
    got
}

fn main() : u8
{
    PrivateKey key = Result::unwrap(PrivateKey::from_pem(KEY));
    Vec<Certificate> chain = certificates_from_pem(CRT);
    TcpListener l = Result::unwrap(TcpListener::bind(SocketAddr::new(IpAddr::localhost_v4(), 0)));
    SocketAddr a = TcpListener::local_addr(&l);
    auto h = spawn(serve, l, key, Vec::clone(&chain));
    // A 31-byte X25519 share.
    TcpStream t = Result::unwrap(TcpStream::connect(a));
    TcpStream::set_read_timeout_ms(&mut t, 20000);
    _ = TcpStream::write(&mut t, &client_hello(0x001d, 31));
    printf("a 31-byte X25519 share: %s\n", &alert_of(&read_all(&mut t)));
    // No share, so a HelloRetryRequest for P-256, then a 64-byte share.
    TcpStream u = Result::unwrap(TcpStream::connect(a));
    TcpStream::set_read_timeout_ms(&mut u, 20000);
    _ = TcpStream::write(&mut u, &client_hello(0x0017, 0));
    Vec<u8> hrr = read_some(&mut u);
    printf("no share: a HelloRetryRequest: %v\n", Vec::len(&hrr) > 5 && hrr[0] == 22);
    _ = TcpStream::write(&mut u, &client_hello(0x0017, 64));
    printf("then a 64-byte P-256 share: %s\n", &alert_of(&read_all(&mut u)));
    // A real client.
    TrustStore roots = TrustStore { .roots = chain };
    TcpStream v = Result::unwrap(TcpStream::connect(a));
    match (TlsStream::client(v, "localhost", &roots))
    {
        Ok(s)  :
        {
            TlsStream::set_read_timeout_ms(&mut s, 20000);
            TlsStream::set_write_timeout_ms(&mut s, 20000);
            Option<String> line = Result::unwrap_or(TlsStream::read_line(&mut s), None);
            printf("a real client reads: %s\n", &Option::unwrap_or(line, String::new()));
        },
        Err(e) : printf("a real client: %s\n", TlsError::text(&e)),
    }
    printf("%s", &join(h));
    0
}
