// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.toml [Toml-Error] [Toml-Tables] (reports 218, 219); conf.toml-deep-keys-many-members
// kind: positive
// expect: ok
//
// Each part of a dotted key or a header is a table one level deeper, and
// counts against the 512 levels as an array or an inline table does: a key
// of 300,000 parts or a header of a million is `OutOfRange`, not the end of
// the program, and 512 parts are read. A table of 40,000 keys is read in
// time proportional to its size (its members are indexed by key once it has
// a few), where it took minutes.

import std;

fn dotted(usize parts, str sep) : String
{
    String s = String::new();
    for (usize i = 0; i < parts; i += 1)
    {
        if (i > 0)
        {
            String::append(&mut s, sep);
        }
        String::append(&mut s, "a");
    }
    s
}

fn kind(Result<Toml, ParseError> r) : str
{
    match (r)
    {
        Ok(_)           : "ok",
        Err(OutOfRange) : "out of range",
        Err(_)          : "other error",
    }
}

fn main()
{
    String key = dotted(300000, ".");
    String::append(&mut key, " = 1\n");
    printf("a dotted key of 300000 parts: %s\n", kind(Toml::parse(&key)));
    String header = String::copy("[");
    String::append(&mut header, &dotted(1000000, "."));
    String::append(&mut header, "]\n");
    printf("a header of 1000000 parts: %s\n", kind(Toml::parse(&header)));
    String fits = dotted(512, ".");
    String::append(&mut fits, " = 1\n");
    printf("512 parts: %s\n", kind(Toml::parse(&fits)));
    String over = dotted(513, ".");
    String::append(&mut over, " = 1\n");
    printf("513 parts: %s\n", kind(Toml::parse(&over)));
    String inside = String::copy("[t]\n");
    String::append(&mut inside, &dotted(511, "."));
    String::append(&mut inside, " = 1\n");
    printf("a header and 511 parts: %s\n", kind(Toml::parse(&inside)));

    String doc = String::copy("[big]\n");
    for (u32 i = 0; i < 40000; i += 1)
    {
        String::appendf(&mut doc, "key%v = %v\n", i, i);
    }
    String::append(&mut doc, "key17 = 0\n");
    printf("40000 keys and one again: %s\n", match (Toml::parse(&doc)) { Err(Invalid(_)) : "the repeat refused", _ : "wrong" });
    Toml t = Result::unwrap(Toml::parse(&doc[0..StringView::len(&doc) - 10]));
    ref<Toml, shared> big = Option::unwrap(Toml::get(&t, "big"));
    usize members = Vec::len(Option::unwrap(Toml::as_table(big)));
    i64 last = Option::unwrap(Toml::as_i64(Option::unwrap(Toml::get(big, "key39999"))));
    printf("members %v, key39999 = %v\n", members, last);
}
