// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.print [Print-Buffer]; D-0178; conf.stdout-buffer-order
// kind: positive
// expect: ok
// expect-stdout-hex: 610a630a
//
// Standard output is buffered, and a write to standard error writes the
// buffer out first, so the two streams keep the program's order.
// `impl/tests/print_output.rs` runs this case with both streams sent to
// one file and checks that it holds `a`, `b`, `c` in that order.

import std;

fn main()
{
    printf("a\n");
    eprintf("b\n");
    printf("c\n");
}
