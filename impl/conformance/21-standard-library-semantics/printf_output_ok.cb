// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.format [Printf] [Appendf]; conf.printf-output
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// Every conversion and flag of `printf`, with the text C's `printf`
// prints for the same format and values (the numeric lines byte for
// byte, except `%#o`, which writes CobaltC's octal prefix `0o`: a
// leading `0` alone is not octal here), and `String::appendf` building
// text into a `String`. `%d` prints any integer type; `%x`, `%o`, `%b` print the
// value's bits in its own width.

import std;

fn main()
{
    printf("[%d|%5d|%-5d|%05d|%+d|% d]\n", 42, 42, 42, -42, 42, 42);
    printf("[%.3d|%8.3d|%.0d|%i|%u]\n", 7, -7, 0, -1, 4000000000: u32);
    printf("[%x|%X|%#x|%#06x|%o|%#o|%b|%#b]\n", 255, 255, 255, 255, 8, 8, 5, 5);
    printf("[%x|%x|%x]\n", -1: i8, -1: i32, -1: i64);
    printf("[%f|%.2f|%8.3f|%-8.1f|%08.2f|%.0f|%#.0f]\n", 3.14159, 3.14159, -3.14159, 2.5, -2.5, 2.5, 3.0);
    printf("[%e|%.2E|%e|%+.1e]\n", 1234.5, 0.000123, 0.0, 1.0e10);
    printf("[%g|%g|%g|%g|%.3g|%#g|%G|%g]\n", 100000.0, 1000000.0, 0.0001, 0.00001, 3.14159, 1.5, 1.0e-10, 0.1: f32);
    printf("[%s|%6s|%-6s|%.2s|%3s|%s]\n", "hi", "hi", "hi", "h\u{e9}llo", "\u{e9}", false);
    printf("[100%%]\n");
    String line = String::new();
    String::appendf(&mut line, "%-6s|%6.2f|%#x", "total", 21.5, 3000);
    printf("%s (%d bytes)\n", &line, String::len(&line));
}
