// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview [View-Form] (D-0312 §2); conf.str-sliced
// kind: positive
// expect: ok
// expect-stdout-hex: 656c2063646566206520656c6c20350a
//
// A `str` is sliced as any text is: `&t[lo..hi]` is a `StringView` of the
// static text, which never ends, so the view may be kept, returned through a
// parameter's source, and sliced again; `$` is the text's length in bytes.

import std;

fn tail_of(StringView v) : StringView from v
{
    &v[1..$]
}

fn main()
{
    str t = "hello";
    StringView a = &t[1..3];
    StringView b = &"abcdef"[2..$];
    StringView c = &a[0..1];
    printf("%v %v %v %v %v\n", a, b, c, tail_of(&t[0..4]), StringView::len(&t[0..$]));
}
