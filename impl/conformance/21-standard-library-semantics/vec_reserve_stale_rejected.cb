// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `Vec::reserve` (D-0129): the cells move when it grows; conf.vec-reserve-stale
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// When `reserve` grows a `Vec`, its elements move to new cells, as when
// `push` grows it: a reference into the old cells, held across the call,
// is stale afterwards.
//
// D-0290: the reference is stored by a call (`keep_in`), so the frame holds it
// only as `?` (it may hold none of it), and the run checks the access; the
// same program storing it directly is refuted before the run.

import std;

fn keep_in(ref<Vec<ref<i32, shared>>, exclusive> keep, ref<i32, shared> r)
{
    Vec::push(keep, r);
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 7);
    Vec<ref<i32, shared>> keep = Vec::new();
    keep_in(&mut keep, &v[0]);
    Vec::reserve(&mut v, 1000);
    printf("%v\n", *keep[0]);
}
