// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview `StringView::split`, `String::split` (D-0113)
// kind: positive
// expect: ok
//
// `split` at its edges: empty text, a separator at either end or
// repeated, a separator of several bytes or characters, one longer than
// the text, an empty separator, multi-byte UTF-8 text, a view of part of
// a String, and a piece split again. Both tools must print the same
// pieces.

import std;

fn show(StringView whole, str sep)
{
    Vec<StringView> parts = StringView::split(whole, sep);
    printf("%v:", Vec::len(&parts));
    foreach (p in &parts)
    {
        printf(" [%v]", *p);
    }
    printf("\n");
}

fn main()
{
    show(StringView::of(""), ",");
    show(StringView::of(","), ",");
    show(StringView::of("a,b,,c,"), ",");
    show(StringView::of(",a"), ",");
    show(StringView::of("a::b::::c"), "::");
    show(StringView::of("ab"), "abc");
    show(StringView::of("abc"), "");
    show(StringView::of("héllo wörld ünïcode"), " ");
    show(StringView::of("x€y€€z"), "€");
    String s = String::from_str("one two  three");
    Vec<StringView> ws = String::split(&s, " ");
    usize total = 0;
    foreach (w in &ws)
    {
        total += StringView::len(*w);
    }
    printf("%v %v\n", Vec::len(&ws), total);
    StringView mid = String::view(&s, 4, 13);
    show(mid, " ");
    Vec<StringView> again = StringView::split(ws[2], "e");
    printf("%v\n", Vec::len(&again));
}
