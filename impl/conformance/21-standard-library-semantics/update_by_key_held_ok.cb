// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: `HashMap::entry_owned`, `HashMap::get_mut_ref`, `HashMap::remove_ref`, `HashSet::remove_ref`: a generic body counts, updates and removes by a key it holds as `K`, for a `String` key and an integer key alike, as `contains_ref` and `get_ref` look up (conf.lookup-by-key-held); conf.update-by-key-held
// kind: positive
// expect: ok
// expect-stdout-hex: 32203120747275652066616c73650a31322033203120300a747275652066616c736520300a
//

import std;

fn count_by<T, K: eq>(ref<Vec<T>, shared> v, fn(ref<T, shared>) : K key) : HashMap<K, usize>
{
    HashMap<K, usize> out = HashMap::new();
    foreach (x in v)
    {
        K k = key(x);
        *HashMap::entry_owned(&mut out, k, 0) += 1;
    }
    out
}

fn bump<K>(ref<HashMap<K, usize>, exclusive> m, ref<K, shared> k) : bool
{
    match (HashMap::get_mut_ref(m, k))
    {
        Some(v) :
        {
            *v += 10;
            true
        },
        None    : false,
    }
}

fn take<K>(ref<HashMap<K, usize>, exclusive> m, ref<K, shared> k) : usize
{
    match (HashMap::remove_ref(m, k))
    {
        Some(v) : v,
        None    : 0,
    }
}

fn forget<K>(ref<HashSet<K>, exclusive> s, ref<K, shared> k) : bool
{
    HashSet::remove_ref(s, k)
}

fn main()
{
    Vec<String> words = Vec::new();
    Vec::push(&mut words, "tea");
    Vec::push(&mut words, "jam");
    Vec::push(&mut words, "tea");
    HashMap<String, usize> a = count_by(&words, [](ref<String, shared> w) : String { String::clone(w) });
    HashMap<usize, usize> b = count_by(&words, [](ref<String, shared> w) : usize { StringView::len(w) });
    String tea = "tea";
    usize three = 3;
    usize four = 4;
    printf("%v %v %v %v\n", HashMap::len(&a), HashMap::len(&b), bump(&mut a, &tea), bump(&mut b, &four));
    printf("%v %v %v %v\n", take(&mut a, &tea), take(&mut b, &three), HashMap::len(&a), HashMap::len(&b));
    HashSet<String> s = HashSet::new();
    HashSet::insert(&mut s, "x");
    String x = "x";
    printf("%v %v %v\n", forget(&mut s, &x), forget(&mut s, &x), HashSet::len(&s));
}
