// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.type.probe `probe<K>` (D-0312): a `u64` key is its own probe, so a literal is none; conf.map-get-literal-non-string-key-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// The key parameter of a `HashMap<u64, i32>` is its probe, a `u64`: a
// text literal is none, and the call is an ordinary type error.

import std;

fn main()
{
    HashMap<u64, i32> m = HashMap::new();
    HashMap::insert(&mut m, 7, 1);
    bool b = HashMap::contains(&m, "k");
}
