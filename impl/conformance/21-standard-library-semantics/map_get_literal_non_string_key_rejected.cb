// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str `[Str-Literal-String-Ref]` (D-0308): only where a `ref<String, shared>` is declared; conf.map-get-literal-non-string-key-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// The key parameter of a `HashMap<u64, i32>` is a `ref<u64, shared>`: a
// literal is no reference to a `u64`, and the call is an ordinary type
// error.

import std;

fn main()
{
    HashMap<u64, i32> m = HashMap::new();
    HashMap::insert(&mut m, 7, 1);
    bool b = HashMap::contains(&m, "k");
}
