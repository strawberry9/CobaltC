// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.control.flow-analysis diag.stale-binding; D-0087
// kind: negative
// expect: diag.stale-binding (static)
//
// `Vec::len(&v)` on the first pass reads the length; the move at the end
// of that pass would leave `v` stale for the second. `v` may have been
// moved at the loop's head, so the borrow is refuted (D-0087).

import std;

fn takes(Vec<i32> v)
{
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    usize total = 0;
    i32 i = 0;
    while (i < 2)
    {
        total = total + Vec::len(&v);
        printf("counted\n");
        takes(v);
        i = i + 1;
    }
}
