// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.ffi `Vec::from_raw` (D-0257); spec/12 §1 bound `plain`; conf.vec-from-raw-not-plain
// kind: negative
// expect: diag.type-mismatch (static)
//
// Only plain data crosses raw memory whole: a `String` is a resource, so
// `Vec::from_raw<String>` is rejected by its `plain` bound.

import std;

fn main()
{
    rawptr<String> p = null_rawptr<String>();
    Vec<String> v = unsafe { Vec::from_raw(p, 0) };
}
