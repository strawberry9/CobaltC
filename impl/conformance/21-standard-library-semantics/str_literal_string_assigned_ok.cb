// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str [Str-Literal-String] [Str-Literal-View] (D-0304): an assigned value; conf.str-literal-string-assigned
// kind: positive
// expect: ok
// stdout: x y z w
// stdout: v u
//
// A text literal assigned to a place whose type is `String` is that
// `String`: a local, a field, an element and a place through a reference,
// and through an `if` (D-0155). One assigned to a `StringView` place is
// the view, and so is `&s` of a `String` (D-0302).

import std;

struct P
{
    String name;
}

fn set(ref<String, exclusive> r)
{
    *r = "w";
}

fn main()
{
    String s = "a";
    s = "x";
    P p = P { .name = "b" };
    p.name = "y";
    Vec<String> v = Vec::new();
    Vec::push(&mut v, "c");
    v[0] = if (Vec::len(&v) == 1) { "z" } else { "never" };
    String t = "d";
    set(&mut t);
    printf("%s %s %s %s\n", &s, &p.name, &v[0], &t);
    StringView a = "e";
    a = "v";
    String held = "u";
    StringView b = "f";
    b = &held;
    printf("%s %s\n", a, b);
}
