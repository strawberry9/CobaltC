// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str `[Str-Literal-String-Ref]` (D-0308): not where a `ref<String, exclusive>` is declared (the literal's `String` is never written); conf.literal-string-ref-exclusive-rejected
// kind: negative
// expect: diag.type-mismatch (static)

import std;

fn clear(ref<String, exclusive> s)
{
    String::clear(s);
}

fn main()
{
    clear("text");
}
