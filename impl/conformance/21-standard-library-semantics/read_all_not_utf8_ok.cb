// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.read [Read-All] (D-0145); conf.read-all-not-utf8
// kind: positive
// expect: ok
// expect-stdout-hex: 6e6f74205554462d38206174206279746520310a
// stdin-hex: 41ff42
//
// Input that is not UTF-8 is `Err(Utf8(e))` from `read_all`, with the
// offset of the first byte that is not.

import std;

fn main()
{
    match (read_all())
    {
        Ok(_)        : printf("text?\n"),
        Err(Utf8(e)) : printf("not UTF-8 at byte %u\n", e.offset),
        Err(e)       : printf("read_all: %s\n", FileError::text(&e)),
    }
}
