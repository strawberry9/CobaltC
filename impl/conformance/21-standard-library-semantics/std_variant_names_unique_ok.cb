// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: §0 `std`'s enums; `[Resolve-Unqualified]`, `[Resolve-Ambiguous]` (D-0143, D-0144); conf.std-variant-names-unique
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// No two of `std`'s enums share a variant name, so a variant written
// unqualified as a value, where no expected type picks the enum, names
// one enum: `FileError`'s `NotFound`, `Denied`, `Io` (also for a failure
// to run a program, D-0143) and `NetError`'s `UnknownHost`, `Refused`,
// `TimedOut`, `Failed` (D-0144), with `import std;` bringing in all.

import std;

fn file_failure(u8 k) : Result<u8, FileError>
{
    if (k == 0)
    {
        return Err(NotFound);
    }
    if (k == 1)
    {
        return Err(Denied);
    }
    Err(Io)
}

fn net_failure(u8 k) : Result<u8, NetError>
{
    if (k == 0)
    {
        return Err(UnknownHost);
    }
    if (k == 1)
    {
        return Err(Refused);
    }
    if (k == 2)
    {
        return Err(TimedOut);
    }
    Err(Failed)
}

fn main()
{
    for (u8 k = 0; k < 3; k += 1)
    {
        match (file_failure(k))
        {
            Err(e) : printf("%s; ", FileError::text(&e)),
            Ok(_)  : printf("?; "),
        }
    }
    printf("\n");
    for (u8 k = 0; k < 4; k += 1)
    {
        match (net_failure(k))
        {
            Err(e) : printf("%s; ", NetError::text(&e)),
            Ok(_)  : printf("?; "),
        }
    }
    printf("\n");
    Command none = Command::new("/surely/not/a/program");
    if (Err(NotFound) = Command::status(&none))
    {
        printf("a missing program is the FileError NotFound\n");
    }
}
