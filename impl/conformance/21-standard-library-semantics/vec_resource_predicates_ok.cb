// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §1 Vec; conf.vec-resource-predicates
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// retain, position and binary_search_by literals over Vec<String> and
// Vec<resource>: calls in the prelude's order, a capture read, dropped
// elements' destructors (D-0192)

import std;

resource struct Noisy
{
    i64 id;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("drop %v ", self.id);
}

fn main()
{
    Vec<String> v = Vec::new();
    foreach (w in StringView::split(StringView::of("pear apple fig banana kiwi plum date"), " "))
    {
        Vec::push(&mut v, String::from_view(w));
    }
    Vec::retain(&mut v, [](ref<String, shared> s) : bool { printf("[%s]", s); String::len(s) > 3 });
    printf("\n%v:", Vec::len(&v));
    foreach (s in &v)
    {
        printf(" %s", s);
    }
    usize lim = 4;
    match (Vec::position(&v, [lim](ref<String, shared> s) : bool { String::len(s) == lim }))
    {
        Some(k) : printf("\nat %v\n", k),
        None    : printf("\nnone\n"),
    }
    Vec::sort(&mut v);
    String key = String::from_str("kiwi");
    match (Vec::binary_search_by(
        &v,
        &key,
        [](
            ref<String, shared> a,
            ref<String, shared> b,
        ) : bool { String::len(a) < String::len(b) || (String::len(a) == String::len(b) && *a < *b) },
    ))
    {
        Ok(k)  : printf("found %v\n", k),
        Err(k) : printf("missing %v\n", k),
    }
    Vec<Noisy> ns = Vec::new();
    foreach (i in 0..7: i64)
    {
        Vec::push(&mut ns, Noisy { .id = i });
    }
    Vec::retain(&mut ns, [](ref<Noisy, shared> n) : bool { n.id % 3 != 0 });
    printf("\nkept %v\n", Vec::len(&ns));
}
