// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Ec-Keys] [Ecdh] [Ecdsa-Sign] (D-0168); conf.ecdsa-sign-p384, conf.ecdh-p384
// kind: positive
// expect: ok
// slow: interpreted big-number arithmetic takes well over the 10-second budget
// expect-stdout-hex: 
//
// RFC 6979 A.2.6: the P-384 key's signature of SHA-384("sample"), r and s as
// the RFC lists them, verified; RFC 5903 §8.2's P-384 exchange: i with the
// peer's g^r gives g^ir's x-coordinate.

import std;

fn bytes(str hex) : Vec<u8>
{
    Result::unwrap_or(from_hex(StringView::of(hex)), Vec::new())
}

fn main() : u8
{
    Vec<u8> x = bytes("6B9D3DAD2E1B8C1C05B19875B6659F4DE23C3B667BF297BA9AA47740787137D896D5724E4C70A825F872C9EA60D2EDF5");
    array<u8, 48> digest = sha384(&b"sample"[0..$]);
    Vec<u8> sig = Option::unwrap(ecdsa_sign(P384, &x[0..$], &digest[0..$]));
    printf("signature %s\n", &to_hex(&sig[0..$]));
    Vec<u8> q = bytes("04EC3A4E415B4E19A4568618029F427FA5DA9A8BC4AE92E02E06AAE5286B300C64DEF8F0EA9055866064A254515480BC138015D9B72D7D57244EA8EF9AC0C621896708A59367F9DFB9F54CA84B3F1C9DB1288B231C3AE0D4FE7344FD2533264720");
    printf("verifies %v\n", ecdsa_verify(P384, &q[0..$], &digest[0..$], &sig[0..$]));
    Vec<u8> i = bytes("099F3C7034D4A2C699884D73A375A67F7624EF7C6B3C0F160647B67414DCE655E35B538041E649EE3FAEF896783AB194");
    Vec<u8> gr = bytes("04E558DBEF53EECDE3D3FCCFC1AEA08A89A987475D12FD950D83CFA41732BC509D0D1AC43A0336DEF96FDA41D0774A3571DCFBEC7AACF3196472169E838430367F66EEBE3C6E70C416DD5F0C68759DD1FFF83FA40142209DFF5EAAD96DB9E6386C");
    printf("ecdh %s\n", &to_hex(&Option::unwrap(ecdh(P384, &i[0..$], &gr[0..$]))[0..$]));
    0
}
