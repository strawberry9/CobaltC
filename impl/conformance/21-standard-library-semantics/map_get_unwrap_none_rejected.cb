// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.hashmap (D-0200); conf.map-get-unwrap-none
// kind: negative
// expect: diag.unwrap-failed (dynamic)
// expect-stdout-hex: 310a
//
// `*Option::unwrap(HashMap::get(&m, k))` for a key the map lacks: the
// unwrap's fault, after the output before it.

import std;

fn main() : u8
{
    HashMap<String, u64> m = HashMap::new();
    _ = HashMap::insert(&mut m, "here", 1);
    String k = "here";
    printf("%v\n", *Option::unwrap(HashMap::get(&m, &k)));
    String g = "gone";
    printf("%v\n", *Option::unwrap(HashMap::get(&m, &g)));
    0
}
