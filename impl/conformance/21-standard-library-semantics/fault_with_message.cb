// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §0 `fault` [Fault] (D-0083); conf.fault-with-message
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// A program implementing its own container raises the standard fault,
// with a message of its own.

import std;

struct Ring
{
    array<u32, 4> slots;
    usize len;
}

fn Ring::at(ref<Ring, shared> r, usize i) : u32
{
    if (i >= r.len)
    {
        fault(index_out_of_bounds, "ring position past its length");
    }
    r.slots[i]
}

fn main()
{
    Ring r = Ring { .slots = [0; 4], .len = 1 };
    u32 x = Ring::at(&r, 2);
}
