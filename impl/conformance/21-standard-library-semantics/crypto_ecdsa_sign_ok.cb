// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Ec-Keys] [Ecdh] [Ecdsa-Sign] (D-0168); conf.ecdsa-sign-vectors, conf.ec-key-refusals
// kind: positive
// expect: ok
// slow: interpreted big-number arithmetic takes well over the 10-second budget
// expect-stdout-hex: 
//
// RFC 6979 A.2.5: the P-256 key's public point and its signature of
// SHA-256("sample"), r and s as the RFC lists them, verified by
// `ecdsa_verify`; RFC 5903 §8.1's P-256 exchange through the curve-generic
// functions; a private key of zero or of n, and a 48-byte key on P-256,
// are refused or faulted as the rules say (the fault is a separate case).

import std;

fn bytes(str hex) : Vec<u8>
{
    Result::unwrap_or(from_hex(StringView::of(hex)), Vec::new())
}

fn main() : u8
{
    Vec<u8> x = bytes("C9AFA9D845BA75166B5C215767B1D6934E50C3DB36E89B127B8A622B120F6721");
    Vec<u8> q = Option::unwrap(ec_public_key(P256, &x[0..$]));
    printf("public %s\n", &to_hex(&q[0..$]));
    array<u8, 32> digest = sha256(&b"sample"[0..$]);
    Vec<u8> sig = Option::unwrap(ecdsa_sign(P256, &x[0..$], &digest[0..$]));
    printf("signature %s\n", &to_hex(&sig[0..$]));
    Vec<u8> again = Option::unwrap(ecdsa_sign(P256, &x[0..$], &digest[0..$]));
    printf(
        "verifies %v, deterministic %v\n",
        ecdsa_verify(P256, &q[0..$], &digest[0..$], &sig[0..$]),
        digest_eq(&sig[0..$], &again[0..$]),
    );
    Vec<u8> i = bytes("c88f01f510d9ac3f70a292daa2316de544e9aab8afe84049c62a9c57862d1433");
    Vec<u8> gr = bytes("04d12dfb5289c8d4f81208b70270398c342296970a0bccb74c736fc7554494bf6356fbf3ca366cc23e8157854c13c58d6aac23f046ada30f8353e74f33039872ab");
    printf("ecdh %s\n", &to_hex(&Option::unwrap(ecdh(P256, &i[0..$], &gr[0..$]))[0..$]));
    array<u8, 32> zero = [0; 32];
    Vec<u8> n = bytes("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551");
    Vec<u8> off = Vec::clone(&gr);
    off[64] = off[64] ^ 1;
    printf(
        "refused: %v %v %v %v\n",
        Option::is_none(&ec_public_key(P256, &zero[0..$])),
        Option::is_none(&ecdsa_sign(P256, &n[0..$], &digest[0..$])),
        Option::is_none(&ecdh(P256, &i[0..$], &off[0..$])),
        Option::is_none(&ecdh(P256, &zero[0..$], &gr[0..$])),
    );
    Vec<u8> fresh = ec_private_key(P256);
    printf(
        "fresh key %v bytes, public %v bytes\n",
        Vec::len(&fresh),
        Vec::len(&Option::unwrap(ec_public_key(P256, &fresh[0..$]))),
    );
    0
}
