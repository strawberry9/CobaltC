// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: `[View-Form-Temporary-Argument]` (D-0135): a `String` a call returns, or part of a temporary, viewed as an argument; conf.view-of-temporary-argument
// kind: positive
// expect: ok

import std;

struct Rec
{
    String name;
    i32 n;
}

fn word() : String
{
    String::from_str("abcdef")
}

fn rec() : Rec
{
    Rec { .name = String::from_str("hello"), .n = 1 }
}

fn joined(StringView a, StringView b) : String
{
    String s = String::new();
    String::append(&mut s, a);
    String::append(&mut s, b);
    s
}

fn main()
{
    // a call's result, whole and in part
    assert(StringView::len(&word()[0..$]) == 6);
    assert(StringView::eq_str(&word()[1..3], "bc"));
    // a field of a temporary
    assert(StringView::len(&rec().name[0..$]) == 5);
    // the inner call's result viewed for the outer call
    String j = joined(&joined("ab", "cd")[0..$], "ef");
    assert(String::eq_str(&j, "abcdef"));
    // a needle, and a view returned and used within the statement
    assert(String::starts_with(&j, &word()[0..2]));
    assert(StringView::len(StringView::trim(&sprintf("  %v  ", 42)[0..$])) == 2);
    // a computed path
    String dir = String::from_str("/nonexistent-cobaltc-dir");
    bool nf = match (read_file(&sprintf("%s/%s", &dir, "x.txt")[0..$]))
    {
        Ok(_)  : false,
        Err(e) : match (e) { NotFound : true, _ : false },
    };
    assert(nf);
}
