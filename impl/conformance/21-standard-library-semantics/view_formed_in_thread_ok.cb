// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview `[View-Form]`; rule.conc.spawn (D-0134: found on the way); conf.view-in-thread
// kind: positive
// expect: ok
// expect-stdout-hex: 330a
//
// A view formed inside a spawned thread, of a `String` the thread owns:
// the thread runs the function's own body, so every form the checker
// recorded in it (`&s[lo .. hi]` on a `String` here) means the same as
// in the main thread.

import std;

fn worker(i32 n) : usize
{
    String line = String::from_str("one two three");
    StringView v = &line[0..$];
    Vec<StringView> words = StringView::split(v, " ");
    assert(StringView::find(v, "two") == Some(4) && words[1] == "two");
    widen<usize>(narrow<u32>(n)) + Vec::len(&words) - 1
}

fn main()
{
    handle<usize> h = spawn(worker, 1);
    usize words = join(h);
    printf("%v\n", words);
}
