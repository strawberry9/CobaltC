// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str `[Str-Literal-View]`; rule.stdlib.stringview `StringView::of` (D-0134); conf.str-literal-as-view, conf.view-of-str
// kind: positive
// expect: ok
// expect-stdout-hex: 6f6b0a
//
// A literal where a `StringView` is declared is a view of it: as an
// argument, as a local's initializer, as a struct literal's field, and
// as a `str` constant's use. A `str` binding is viewed with
// `StringView::of`. Such a view is valid for the rest of the program:
// it can be sliced again, kept in a struct, returned through a
// function taking it, and compared.

import std;

const str GREETING = "hello, world";

struct Label
{
    StringView text;
    u32 width;
}

fn first(StringView v, usize n) : StringView
{
    &v[0..n]
}

fn label_of(str t) : Label
{
    Label { .text = StringView::of(t), .width = narrow<u32>(str_len(t)) }
}

fn main()
{
    StringView a = "abc";
    assert(StringView::len(a) == 3 && a == "abc");
    StringView g = GREETING;
    assert(first(g, 5) == "hello");
    assert(&g[7..$] == "world");
    Label l = Label { .text = "fixed", .width = 5 };
    assert(l.text == "fixed" && l.width == 5);
    Label m = label_of("from a str");
    assert(m.text == "from a str" && m.width == 10);
    str t = "x,y,z";
    Vec<StringView> parts = StringView::split(StringView::of(t), ",");
    assert(Vec::len(&parts) == 3 && parts[2] == "z");
    assert(StringView::find("needle in haystack", "hay") == Some(10));
    assert(StringView::starts_with(StringView::of(t), "x,") && StringView::ends_with(g, "world"));
    assert(StringView::of("") == "" && StringView::len("") == 0);
    // the same text viewed twice is equal; a view of a literal outlives the block
    StringView kept = "outer";
    {
        StringView inner = "outer";
        assert(inner == kept);
        kept = StringView::of("inner");     // an assignment is not a declared position
    }
    assert(kept == "inner");
    printf("ok\n");
}
