// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.text [Base64] (D-0232: the bits padding leaves over are zero); conf.base64-canonical-padding
// kind: positive
// expect: ok
//
// One text for each byte string, as RFC 4648 §3.5 allows a decoder to
// require: "QQ==" is "A", and "QR==", whose last character leaves a bit
// over that is not zero, is refused at that character.

import std;

fn main() : u8
{
    Vec<u8> a = Result::unwrap(base64_decode("QQ=="));
    if (Vec::len(&a) != 1 || a[0] != 65)
    {
        return 1;
    }
    match (base64_decode("QR=="))
    {
        Err(Invalid(1)) : {},
        _               : return 2,
    }
    match (base64_decode("QUJ="))
    {
        Err(Invalid(2)) : {},
        _               : return 3,
    }
    0
}
