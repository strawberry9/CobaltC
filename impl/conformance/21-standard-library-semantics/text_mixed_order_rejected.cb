// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str `[Text-Mixed-Eq]` (D-0164); conf.text-mixed-order-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// A `String` and a `str` compare with `==` and `!=` only; ordering them is
// not defined (D-0108 keeps orderings within one text type).

import std;

fn main()
{
    String s = "a";
    bool b = s < "b";
}
