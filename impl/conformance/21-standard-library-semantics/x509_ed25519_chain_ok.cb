// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.x509 [Cert-Parse] [Verify-Chain] (D-0171); conf.x509-ed25519
// kind: positive
// expect: ok
// expect-stdout-hex: 706172736564203120310a6b657920656432353531392c20736368656d6520656432353531390a636861696e20747275650a6f74686572206e616d6520747275650a
//
// A leaf for ed.example with an Ed25519 key, signed with Ed25519 by an
// Ed25519 root: both parse, the chain verifies against the root for
// ed.example in 2030, and not for another name.

import std;

const str ROOT = "-----BEGIN CERTIFICATE-----\n"
    "MIIBbTCCAR+gAwIBAgIUbVrN1P+Mso4/1VyUYHU7Mm9vqUwwBQYDK2VwMCQxIjAg\n"
    "BgNVBAMMGUNvYmFsdEMgRWQyNTUxOSBUZXN0IFJvb3QwHhcNMjYxMDA0MjI1MjQy\n"
    "WhcNMzYxMDAxMjI1MjQyWjAkMSIwIAYDVQQDDBlDb2JhbHRDIEVkMjU1MTkgVGVz\n"
    "dCBSb290MCowBQYDK2VwAyEAWX1jnsQL23CLM4xJOpRleo+5JBcgHVKFGR9Icr0A\n"
    "OxijYzBhMB0GA1UdDgQWBBStHNmIEovQvbaxIDsZYeygxGCftjAfBgNVHSMEGDAW\n"
    "gBStHNmIEovQvbaxIDsZYeygxGCftjAPBgNVHRMBAf8EBTADAQH/MA4GA1UdDwEB\n"
    "/wQEAwIBBjAFBgMrZXADQQBVgl5kUi4vATdQkVT47Ib6w1b10vFIV5Lsl7E5hyfy\n"
    "h3LUql/QV8iTv790CCx5flWYOiKaDGQqDeDiK/nuqLAN\n"
    "-----END CERTIFICATE-----\n";

const str LEAF = "-----BEGIN CERTIFICATE-----\n"
    "MIIBjzCCAUGgAwIBAgIUBincQgqCh8LvbLw5mAN/8kbP4o4wBQYDK2VwMCQxIjAg\n"
    "BgNVBAMMGUNvYmFsdEMgRWQyNTUxOSBUZXN0IFJvb3QwHhcNMjYxMDA0MjI1MjQz\n"
    "WhcNMzYxMDAxMjI1MjQzWjAVMRMwEQYDVQQDDAplZC5leGFtcGxlMCowBQYDK2Vw\n"
    "AyEAZZ9k2emgdIZuPd5cBgGckKXgE+RI4yqUS+WypoD1gBWjgZMwgZAwDAYDVR0T\n"
    "AQH/BAIwADAOBgNVHQ8BAf8EBAMCB4AwEwYDVR0lBAwwCgYIKwYBBQUHAwEwGwYD\n"
    "VR0RBBQwEoIKZWQuZXhhbXBsZYcEfwAAATAdBgNVHQ4EFgQU5uM160SLHIFXXuR/\n"
    "2pA+qmE7tScwHwYDVR0jBBgwFoAUrRzZiBKL0L22sSA7GWHsoMRgn7YwBQYDK2Vw\n"
    "A0EAacSUnw2zkKhC50MiMxnAiNb5U8McjU2c+a3+g7gs8NF1JXJoUMsCSGqWC2T5\n"
    "/F0AOsng7RobiC+ghkx3jwh0DA==\n"
    "-----END CERTIFICATE-----\n";

fn main() : u8
{
    Vec<Certificate> roots = certificates_from_pem(StringView::of(ROOT));
    Vec<Certificate> leaves = certificates_from_pem(StringView::of(LEAF));
    printf("parsed %v %v\n", Vec::len(&roots), Vec::len(&leaves));
    Certificate leaf = Vec::remove(&mut leaves, 0);
    printf(
        "key %s, scheme %s\n",
        match (&leaf.key) { Ed25519Key(_) : "ed25519", _ : "other" },
        match (&leaf.scheme) { Ed25519 : "ed25519", _ : "other" },
    );
    TrustStore store = TrustStore::new();
    TrustStore::add(&mut store, Vec::remove(&mut roots, 0));
    DateTime at = Option::unwrap(DateTime::new(2030, 6, 1, 0, 0, 0));
    Vec<Certificate> mids = Vec::new();
    printf("chain %v\n", Result::is_ok(&verify_chain(&leaf, &mids[0..$], &store, "ed.example", &at)));
    printf("other name %v\n", Result::is_err(&verify_chain(&leaf, &mids[0..$], &store, "other.example", &at)));
    0
}
