// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.hashmap (`HashMap::insert` borrows the map's parts exclusively through its reference; cobc's native body did not, D-0222, CHG-0261); conf.hashmap-insert-while-map-shared
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `s` is a shared reborrow of `r`; `set` is given `r` and calls
// `HashMap::insert(m, …)`, whose body borrows the map's vectors exclusively
// through `m` (`&mut m.values`, `&mut m.slots`, …), which meets `s`.
// `coby` always faulted; `cobc`'s native body made only the shared reads
// through `m` and let the write past `s` (D-0222).
//
// D-0282: the static pass rejects this program before it runs (it was found
// at run time before): `set` writes `*r` through argument 1 while `s` still
// borrows `*r`.

import std;

fn set(ref<HashMap<i32, i32>, exclusive> m, i32 x)
{
    _ = HashMap::insert(m, 2, x);
}

fn main()
{
    HashMap<i32, i32> w = HashMap::new();
    HashMap::insert(&mut w, 1, 1);
    auto r = &mut w;
    auto s = &*r;
    set(r, 9);
    printf("%v\n", HashMap::len(s));
}
