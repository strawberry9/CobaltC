// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.ffi; rule.trust.extern-call [Extern-Call] (D-0252); conf.cstring-libc
// kind: positive
// expect: ok
// cobc-only: passes raw pointers to C
// expect-stdout-hex: 7374726c656e2031320a61667465722074686520736c6173683a202f66696c652e7478740a6e6f74207365740a7468726f75676820707574730a
//
// C's own string functions read a `CString` and hand back `char *`
// results that `String::from_c` copies; `getenv` of a name that is not
// set gives `NULL`, which `is_null` sees.

import std;

unsafe extern fn strlen(rawptr<u8> s) : usize;
unsafe extern fn strchr(rawptr<u8> s, i32 c) : rawptr<u8>;
unsafe extern fn getenv(rawptr<u8> name) : rawptr<u8>;
unsafe extern fn puts(rawptr<u8> s) : i32;

fn main()
{
    CString path = Result::expect(CString::new("dir/file.txt"), "no NUL");
    usize n = unsafe
    {
        strlen(CString::ptr(&path))
    };
    printf("strlen %d\n", n);
    rawptr<u8> slash = unsafe
    {
        strchr(CString::ptr(&path), 47)
    };
    String rest = Result::expect(unsafe { String::from_c(slash) }, "UTF-8");
    printf("after the slash: %s\n", &rest);
    CString name = Result::expect(CString::new("COBALTC_D0252_NEVER_SET"), "no NUL");
    rawptr<u8> v = unsafe
    {
        getenv(CString::ptr(&name))
    };
    if (is_null(v))
    {
        printf("not set\n");
    }
    flush_stdout();
    CString line = Result::expect(CString::new("through puts"), "no NUL");
    unsafe
    {
        puts(CString::ptr(&line));
    }
}
