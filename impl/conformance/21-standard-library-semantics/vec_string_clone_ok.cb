// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §1 Vec; conf.vec-string-clone
// kind: positive
// expect: ok
// expect-stdout-hex: 5b616c7068615d5b5d5b6e34325d0a5b616c706861215d5b785d5b6e34325d5b65787472615d0a3320340a300a
//
// Vec::clone of Strings is a deep copy: writes through either vector
// leave the other unchanged (D-0192)

import std;

fn main()
{
    Vec<String> v = Vec::new();
    Vec::push(&mut v, String::from_str("alpha"));
    Vec::push(&mut v, String::new());
    Vec::push(&mut v, sprintf("n%v", 42));
    Vec<String> c = Vec::clone(&v);
    String::append(&mut c[0], "!");
    String::append(&mut c[1], "x");
    Vec::push(&mut c, String::from_str("extra"));
    foreach (s in &v)
    {
        printf("[%s]", s);
    }
    printf("\n");
    foreach (s in &c)
    {
        printf("[%s]", s);
    }
    printf("\n%v %v\n", Vec::len(&v), Vec::len(&c));
    Vec<String> e = Vec::new();
    Vec<String> ec = Vec::clone(&e);
    printf("%v\n", Vec::len(&ec));
}
