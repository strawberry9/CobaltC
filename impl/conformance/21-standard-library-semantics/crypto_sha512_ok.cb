// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Sha512] (D-0156); conf.sha512-vectors, conf.sha384-vectors
// kind: positive
// expect: ok
// expect-stdout-hex: 73686135313220656d7074793a206f6b0a736861353132206162633a206f6b0a736861353132203131322062797465733a206f6b0a73686133383420656d7074793a206f6b0a736861333834206162633a206f6b0a736861333834203131322062797465733a206f6b0a73747265616d696e673a207472756520747275650a686173683a2033322034382036340a
//
// SHA-512 and SHA-384 against FIPS 180-4's vectors (the empty message,
// "abc", the 112-byte message) and a thousand `a` in pieces through the
// streaming form, which must agree with the one-shot form.

import std;

fn check(str name, ref<String, shared> got, str want)
{
    printf("%s: %s\n", name, if (String::eq_str(got, want)) { "ok" } else { "WRONG" });
}

fn main() : u8
{
    Vec<u8> none = Vec::new();
    Vec<u8> m112 = String::into_bytes("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu");
    check(
        "sha512 empty",
        &to_hex(&sha512(&none[0..$])[0..$]),
        "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e",
    );
    check(
        "sha512 abc",
        &to_hex(&sha512(&b"abc"[0..$])[0..$]),
        "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
    );
    check(
        "sha512 112 bytes",
        &to_hex(&sha512(&m112[0..$])[0..$]),
        "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909",
    );
    check(
        "sha384 empty",
        &to_hex(&sha384(&none[0..$])[0..$]),
        "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b",
    );
    check(
        "sha384 abc",
        &to_hex(&sha384(&b"abc"[0..$])[0..$]),
        "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7",
    );
    check(
        "sha384 112 bytes",
        &to_hex(&sha384(&m112[0..$])[0..$]),
        "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039",
    );
    Vec<u8> thousand = Vec::filled(1000, b'a');
    Sha512 s = Sha512::new();
    Sha512::update(&mut s, &thousand[0..127]);
    Sha512::update(&mut s, &thousand[127..$]);
    Sha384 t = Sha384::new();
    Sha384::update(&mut t, &thousand[0..500]);
    Sha384::update(&mut t, &thousand[500..$]);
    printf(
        "streaming: %v %v\n",
        digest_eq(&Sha512::finish(s)[0..$], &sha512(&thousand[0..$])[0..$]),
        digest_eq(&Sha384::finish(t)[0..$], &sha384(&thousand[0..$])[0..$]),
    );
    printf(
        "hash: %u %u %u\n",
        Vec::len(&hash(Sha2_256, &none[0..$])),
        Vec::len(&hash(Sha2_384, &none[0..$])),
        Vec::len(&hash(Sha2_512, &none[0..$])),
    );
    0
}
