// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: §0 every error enum's `::text` (D-0134); `NetError`, `TlsError`, `HttpError`, `PgError`, `CertError`, `Utf8Error`; `Weekday`; conf.std-error-variants-text
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// Every variant of std's error enums written unqualified, as the bare
// names are unique (D-0223), and described by its enum's `::text`; the
// texts are the library's own, so a change to one shows here. The days
// of the week from known dates, Monday 2024-01-01 onward.
import std;

fn net(NetError e)
{
    printf("net: %v\n", NetError::text(&e));
}

fn tls(TlsError e)
{
    printf("tls: %v\n", TlsError::text(&e));
}

fn http(HttpError e)
{
    printf("http: %v\n", HttpError::text(&e));
}

fn pg(PgError e)
{
    printf("pg: %v\n", &PgError::text(&e));
}

fn cert(CertError e)
{
    printf("cert: %v\n", CertError::text(&e));
}

fn main()
{
    net(Refused);
    net(Reset);
    net(TimedOut);
    net(Unreachable);
    net(AddrInUse);
    net(AddrNotAvailable);
    net(UnknownHost);
    net(NotPermitted);
    net(Closed);
    net(NotUtf8(Utf8Error { .offset = 3 }));
    tls(TlsNetFailure(Reset));
    tls(CertRejected(Expired));
    tls(HandshakeFailed);
    tls(ProtocolError);
    tls(PeerAlert(40));
    tls(PeerAlert(1));
    tls(RecordRejected);
    http(HttpNetFailure(TimedOut));
    http(HttpTlsFailure(HandshakeFailed));
    http(BadUrl);
    http(UnsupportedScheme);
    http(NoRoots);
    http(BadMessage);
    http(TooLarge);
    http(TooManyRedirects);
    http(ConnectionClosed);
    pg(PgNetFailure(Refused));
    pg(PgTlsFailure(RecordRejected));
    pg(TlsRefused);
    pg(NoTrustedRoots);
    pg(BadConnectionUrl);
    pg(UnsupportedAuth);
    pg(AuthRefused);
    pg(AuthFailed);
    pg(ProtocolViolation);
    pg(ResultTooLarge);
    pg(Disconnected);
    cert(BadEncoding);
    cert(Expired);
    cert(NotYetValid);
    cert(UnknownAuthority);
    cert(HostMismatch);
    cert(BadSignature);
    cert(NotAuthority);
    cert(UnsupportedAlgorithm);
    cert(UnhandledCritical);
    cert(WrongUsage);
    cert(ChainTooLong);
    Utf8Error u = Utf8Error { .offset = 7 };
    printf("utf8: %v at %v\n", Utf8Error::text(&u), u.offset);
    for (i64 d = 0; d < 7; d += 1)
    {
        DateTime t = DateTime::from_unix(1704067200 + d * 86400);
        Weekday w = DateTime::weekday(&t);
        bool named = match (w)
        {
            Monday    : true,
            Tuesday   : true,
            Wednesday : true,
            Thursday  : true,
            Friday    : true,
            Saturday  : true,
            Sunday    : true,
        };
        printf("%v %v %v\n", &DateTime::to_iso(&t), Weekday::text(&w), named);
    }
}
