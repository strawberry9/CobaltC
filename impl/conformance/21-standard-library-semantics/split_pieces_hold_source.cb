// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview `String::split` (D-0113); [Write-Conflict]
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// The pieces `split` returns borrow the String they were cut from, for as
// long as the Vec holding them lives: changing the String while they do is
// an aliasing conflict, found at the change.

import std;

fn main()
{
    String s = String::from_str("a,b");
    Vec<StringView> ps = String::split(&s, ",");
    String::append(&mut s, ",c");
    printf("%v\n", ps[0]);
}
