// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview `StringView::split` (D-0113); [Write-Conflict]; conf.split-pieces-hold-source
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// The pieces `split` returns borrow the String they were cut from, for as
// long as the Vec holding them lives: changing the String while they do is
// an aliasing conflict, found at the change.
// D-0341 (CHG-0484) §2.2: a holder of the whole text or vector is read after the
// write, which faults whatever it holds: refused at the check.

import std;

fn main()
{
    String s = "a,b";
    Vec<StringView> ps = StringView::split(&s, ",");
    String::append(&mut s, ",c");
    printf("%v\n", ps[0]);
}
