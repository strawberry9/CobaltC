// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.rc (Rc::drop of the last owner destroys the value); rule.resauth.destroy-composite on a reclaimed object
// kind: positive
// expect: ok
//
// The box behind an Rc has no destructor of its own; destroying it must
// still destroy the resource in its `value` field, exactly once.

import std;

resource struct Flagger
{
    ref<i32, exclusive> flag;
}

fn Flagger::drop(ref<Flagger, exclusive> self)
{
    *self.flag = *self.flag + 1;
}

fn main()
{
    i32 dropped = 0;
    {
        auto a = Rc::new(Flagger { .flag = &mut dropped });
        auto b = Rc::clone(&a);
    }
    if (dropped != 1)
    {
        1 / (1 - 1);
    }
}
