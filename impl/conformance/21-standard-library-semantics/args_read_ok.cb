// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.args [Arg-Bytes]; arg_count; arg; conf.args-read
// kind: positive
// expect: ok
// args: one "" w\xc3\xb6rld
// expect-stdout-hex: 337c6f6e657c7c77c3b6726c640a
//
// Three arguments -- `one`, an empty one, and `wörld` (two-byte UTF-8)
// -- give `arg_count() = 3`, and each `arg(i)` is `Ok` with exactly
// the argument's bytes. Argument 0 is the first after the program:
// the program's own name is not an argument (D-0031). Prints
// `3|one||wörld`.

import std;

fn show(usize i)
{
    printf("|");
    match (arg(i))
    {
        Ok(s) :
        {
            printf("%v", &s);
        },
        Err(_) :
        {
            1 / (1 - 1);
        },
    }
}

fn main()
{
    usize n = arg_count();
    if (n != 3)
    {
        1 / (1 - 1);
    }
    printf("%v", n);
    usize i = 0;
    while (i < n)
    {
        show(i);
        i = i + 1;
    }
    printf("\n");
}
