// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.type.probe `probe<K>` (D-0312): `&k` of a `ref<K, shared>` probes a `String` key (its view) but not an integer key, which is its own probe, so a generic body handing `&k` on is rejected at the integer instantiation; it takes `probe<K>` instead (conf.probe-generic-parameter); conf.probe-generic-lookup-disagrees-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//

import std;

fn has<K>(ref<HashMap<K, i32>, shared> m, ref<K, shared> k) : bool
{
    HashMap::contains(m, k)
}

fn main()
{
    HashMap<String, i32> a = HashMap::new();
    HashMap<i64, i32> b = HashMap::new();
    String s = "x";
    i64 n = 3;
    bool x = has(&a, &s) && has(&b, &n);
}
