// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.args [Args-Flag] [Args-Option] [Args-Finish] [Args-Help] (D-0184); conf.args-flags-options, conf.args-finish, conf.args-help
// kind: positive
// expect: ok
// args: -v --output=out.txt -I inc1 --include inc2 first -- -not-an-option --help
// expect-stdout-hex: 
//
// Flags, options with `=` and with a following value, repeated options,
// `--` ending the options, the help text; then, over arguments given
// with `Args::from`: an unknown option refused, an option missing its
// value refused, a lone `-` kept, a flag declared after `finish`.

import std;

fn main()
{
    Args a = Result::unwrap(Args::new("demo [options] FILE..."));
    bool verbose = Args::flag(&mut a, "verbose", "v", "say more");
    bool help = Args::flag(&mut a, "help", "", "show this help");
    Option<String> out = Args::option(&mut a, "output", "o", "FILE", "where to write");
    Vec<String> incs = Args::options(&mut a, "include", "I", "DIR", "a directory to search");
    Vec<String> rest = Result::unwrap(Args::finish(&mut a));
    printf(
        "verbose=%v help=%v output=%v includes=%v rest=%v\n",
        verbose,
        help,
        &Option::unwrap_or(out, String::from_str("-")),
        Vec::len(&incs),
        Vec::len(&rest),
    );
    foreach (i in &incs)
    {
        printf("inc %v\n", i);
    }
    foreach (r in &rest)
    {
        printf("rest %v\n", r);
    }
    printf("%v", &Args::help(&a));
    Vec<String> given = Vec::new();
    foreach (s in ["x", "--bogus", "-"])
    {
        Vec::push(&mut given, String::from_str(s));
    }
    Args b = Args::from(given, "p");
    match (Args::finish(&mut b))
    {
        Ok(_)  : printf("ok?\n"),
        Err(m) : printf("%v\n", &m),
    }
    Vec<String> given2 = Vec::new();
    foreach (s in ["-n", "5", "-n"])
    {
        Vec::push(&mut given2, String::from_str(s));
    }
    Args c = Args::from(given2, "p");
    Option<String> n = Args::option(&mut c, "number", "n", "N", "a number");
    printf("%v ", &Option::unwrap_or(n, String::new()));
    match (Args::finish(&mut c))
    {
        Ok(_)  : printf("ok?\n"),
        Err(m) : printf("%v\n", &m),
    }
    Vec<String> given3 = Vec::new();
    foreach (s in ["-", "--", "--", "-x"])
    {
        Vec::push(&mut given3, String::from_str(s));
    }
    Args d = Args::from(given3, "p");
    Vec<String> rest3 = Result::unwrap(Args::finish(&mut d));
    printf("%v %v %v %v\n", Vec::len(&rest3), &rest3[0], &rest3[1], &rest3[2]);
    printf("%v", &Args::help(&d));
}
