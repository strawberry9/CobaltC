// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.hashmap `remove` (D-0134, bug 045), `key_at`, `value_at`, `foreach`, `clone`, `swap_remove`, `clear`; conf.hashmap-remove-in-order
// kind: positive
// expect: ok
//
// `remove` keeps the other entries' order in any order of removals, and a
// map emptied one key at a time from its first entry on takes time in
// proportion to its size (the later entries are not moved at each removal).
// Through thousands of random steps a map is checked against a list of
// its pairs in order: removals of the first entry, of one at random and of
// the last, insertions, `swap_remove`, `key_at`/`value_at` at random
// positions, a loop over `&m`, one over `&mut m` that changes values, a
// copy, `clear` and a consuming loop. Values with a destructor show that
// a removed value is destroyed when the removal's result is, and that the
// entries left are destroyed in order, first to last, by `clear` and when
// the map is.

import std;

resource struct Noisy
{
    u32 id;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("drop %v\n", self.id);
}

// Where `k` is in `keys`, or its length.
fn find(ref<Vec<u64>, shared> keys, u64 k) : usize
{
    usize i = 0;
    while (i < Vec::len(keys) && keys[i] != k)
    {
        i += 1;
    }
    i
}

fn same(ref<HashMap<u64, u64>, shared> m, ref<Vec<u64>, shared> keys, ref<Vec<u64>, shared> vals) : bool
{
    if (HashMap::len(m) != Vec::len(keys))
    {
        return false;
    }
    usize i = 0;
    foreach (k, v in m)
    {
        if (*k != keys[i] || *v != vals[i] || *HashMap::key_at(m, i) != keys[i] || *HashMap::value_at(m, i) != vals[i])
        {
            return false;
        }
        i += 1;
    }
    i == Vec::len(keys)
}

fn model_steps(usize steps) : usize
{
    Rng rng = Rng::new(45);
    HashMap<u64, u64> m = HashMap::new();
    Vec<u64> keys = Vec::new();
    Vec<u64> vals = Vec::new();
    u64 next = 1;
    usize checked = 0;
    foreach (step in 0..steps)
    {
        u64 r = Rng::below(&mut rng, 100);
        if (r < 30 || Vec::len(&keys) == 0)
        {
            u64 k = wrapping_mul(next, 0x9E3779B97F4A7C15) >> 8;
            next += 1;
            u64 v = Rng::below(&mut rng, 1000);
            assert(Option::is_none(&HashMap::insert(&mut m, k, v)));
            Vec::push(&mut keys, k);
            Vec::push(&mut vals, v);
        }
        else if (r < 55)
        {
            // The first entry, as a queue's oldest.
            u64 k = keys[0];
            assert(Option::unwrap(HashMap::remove(&mut m, k)) == vals[0]);
            Vec::remove(&mut keys, 0);
            Vec::remove(&mut vals, 0);
        }
        else if (r < 70)
        {
            usize i = narrow<usize>(Rng::below(&mut rng, widen<u64>(Vec::len(&keys))));
            u64 k = keys[i];
            assert(Option::unwrap(HashMap::remove(&mut m, k)) == vals[i]);
            Vec::remove(&mut keys, i);
            Vec::remove(&mut vals, i);
        }
        else if (r < 75)
        {
            usize i = Vec::len(&keys) - 1;
            u64 k = keys[i];
            assert(Option::unwrap(HashMap::remove(&mut m, k)) == vals[i]);
            Vec::pop(&mut keys);
            Vec::pop(&mut vals);
        }
        else if (r < 80)
        {
            usize i = narrow<usize>(Rng::below(&mut rng, widen<u64>(Vec::len(&keys))));
            u64 k = keys[i];
            assert(Option::unwrap(HashMap::swap_remove(&mut m, k)) == vals[i]);
            Vec::swap_remove(&mut keys, i);
            Vec::swap_remove(&mut vals, i);
        }
        else if (r < 85)
        {
            u64 k = keys[narrow<usize>(Rng::below(&mut rng, widen<u64>(Vec::len(&keys))))];
            u64 gone = k ^ 1;
            assert(Option::is_none(&HashMap::remove(&mut m, gone)) == (find(&keys, gone) == Vec::len(&keys)));
            assert(*Option::unwrap(HashMap::get(&m, k)) == vals[find(&keys, k)]);
        }
        else if (r < 92)
        {
            usize i = narrow<usize>(Rng::below(&mut rng, widen<u64>(Vec::len(&keys))));
            assert(*HashMap::key_at(&m, i) == keys[i] && *HashMap::value_at(&m, i) == vals[i]);
            assert(HashMap::contains(&m, keys[i]));
        }
        else if (r < 95)
        {
            foreach (k, v in &mut m)
            {
                *v = *v + (*k & 1);
            }
            foreach (i in 0..Vec::len(&vals))
            {
                vals[i] = vals[i] + (keys[i] & 1);
            }
        }
        else if (r < 99)
        {
            HashMap<u64, u64> c = HashMap::clone(&m);
            assert(same(&c, &keys, &vals));
            u64 k = wrapping_mul(next, 0x9E3779B97F4A7C15) >> 8;
            HashMap::insert(&mut c, k, 1);
            assert(*HashMap::key_at(&c, Vec::len(&keys)) == k && HashMap::len(&m) == Vec::len(&keys));
        }
        else
        {
            HashMap::clear(&mut m);
            Vec::clear(&mut keys);
            Vec::clear(&mut vals);
        }
        if (step % 97 == 0)
        {
            assert(same(&m, &keys, &vals));
            checked += 1;
        }
    }
    assert(same(&m, &keys, &vals));
    // A consuming loop takes the entries in order.
    usize i = 0;
    foreach (k, v in m)
    {
        assert(k == keys[i] && v == vals[i]);
        i += 1;
    }
    assert(i == Vec::len(&keys));
    checked
}

// A queue of a hundred thousand keys emptied from the front: each removal
// would move every later entry if `remove` moved them at once.
fn emptied_from_the_front(usize n) : bool
{
    HashMap<String, usize> m = HashMap::new();
    foreach (i in 0..n)
    {
        HashMap::insert(&mut m, sprintf("k%v", i), i);
    }
    bool ok = true;
    foreach (i in 0..n)
    {
        ok = ok && Option::unwrap(HashMap::remove(&mut m, &sprintf("k%v", i))) == i;
        if (i % 9999 == 0 && i + 1 < n)
        {
            ok = ok && *HashMap::key_at(&m, 0) == sprintf("k%v", i + 1) && HashMap::len(&m) == n - 1 - i;
        }
    }
    ok && HashMap::len(&m) == 0
}

fn main()
{
    printf("checked %v times\n", model_steps(20000));
    printf("emptied from the front: %v\n", emptied_from_the_front(100000));
    HashMap<u32, Noisy> m = HashMap::new();
    foreach (i in 1..8)
    {
        HashMap::insert(&mut m, narrow<u32>(i), Noisy { .id = narrow<u32>(i) });
    }
    u32 two = 2;
    u32 five = 5;
    u32 one = 1;
    printf("remove 2\n");
    HashMap::remove(&mut m, two);
    printf("remove 5\n");
    HashMap::remove(&mut m, five);
    printf("remove 1\n");
    HashMap::remove(&mut m, one);
    printf("left:");
    foreach (k, v in &m)
    {
        printf(" %v", v.id);
    }
    printf("\n");
    HashMap<u32, Noisy> n = HashMap::new();
    foreach (i in 10..14)
    {
        HashMap::insert(&mut n, narrow<u32>(i), Noisy { .id = narrow<u32>(i) });
    }
    u32 eleven = 11;
    HashMap::remove(&mut n, eleven);
    printf("clear\n");
    HashMap::clear(&mut n);
    printf("end\n");
}
