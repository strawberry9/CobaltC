// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: `[Destroy-Not-Solitary]` in `Box::drop`'s `drop(reclaim<T>(ptr))`: a reference `Box::get` gave is still live when the Box's holder, moved into a call, is destroyed; conf.box-destroyed-while-contents-referenced
// kind: negative
// expect: diag.destroy-while-aliased (dynamic)

import std;

struct Holder
{
    Box<String> b;
}

fn take(Holder h) : usize
{
    1
}

fn run(ref<Vec<StringView>, exclusive> log, Holder h, bool early) : usize
{
    // `r` shares its declaring statement with `log`, which is mentioned
    // again and may be given a reference through what it reaches (its
    // views), so `r`'s end is deferred to the block's: it is live at `take`
    ref<String, shared> r = if (!early) { Box::get(&h.b) } else
    {
        Vec::push(log, StringView::of("early"));
        return 0;
    };
    usize n = String::len(r);
    printf("%v\n", n);
    usize k = take(h);
    Vec::push(log, StringView::of("late"));
    n + k
}

fn main()
{
    Vec<StringView> log = Vec::new();
    Holder h = Holder { .b = Box::new(String::from_str("abc")) };
    printf("%v\n", run(&mut log, h, false));
}
