// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec rule.alias.borrow D-0018
// kind: positive
// expect: ok
//
// Vectors passed to helpers that take them by reference, and pushed onto,
// beside plain locals whose last use is that call: the helper's work
// through its parameter, the push, and later reads all see the same
// vector.

import std;

fn fill(ref<Vec<i32>, exclusive> v, i32 n)
{
    foreach (k in 0..n)
    {
        Vec::push(v, k);
    }
}

fn mark(ref<Vec<i32>, exclusive> v, usize from, i32 x)
{
    foreach (m in from..Vec::len(v))
    {
        v[m] = x;
    }
}

fn sum_from(ref<Vec<i32>, shared> v, usize i) : i64
{
    i64 t = 0;
    foreach (k in i..Vec::len(v))
    {
        t += widen<i64>(v[k]);
    }
    t
}

fn main()
{
    i32 n = 6;
    usize from = 2;
    i32 x = 10;
    i32 last = 7;
    usize start = 1;
    Vec<i32> v = Vec::new();
    fill(&mut v, n);
    mark(&mut v, from, x);
    Vec::push(&mut v, last);
    i64 s = sum_from(&v, start);
    if (Vec::len(&v) != 7 || v[0] != 0 || v[1] != 1 || v[5] != 10 || s != 48)
    {
        1 / (1 - 1);
    }
}
