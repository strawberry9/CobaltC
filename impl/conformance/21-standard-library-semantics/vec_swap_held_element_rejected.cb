// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `swap`, [Borrow-Denied]; conf.vec-swap-held-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 6265666f726520310a
//
// A shared reference to v[0], kept where the static analysis cannot
// follow it, is live when Vec::swap(&mut v, 0, 1) borrows the two
// elements exclusively: the borrow of v[0] clashes.

import std;

fn main() : u8
{
    Vec<i64> v = Vec::filled(4, 2: i64);
    Vec<ref<i64, shared>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &v[0]);
    }
    printf("before %v\n", Vec::len(&held));
    Vec::swap(&mut v, 0, 1);
    printf("after %v\n", *held[0]);
    0
}
