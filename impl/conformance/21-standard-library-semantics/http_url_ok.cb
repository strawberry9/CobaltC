// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.http [Url-Parse] [Percent] [Header-Find] (D-0173); conf.url-parse, conf.percent-encoding, conf.http-headers
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// URLs taken apart and put back: case folded, default and explicit
// ports, an empty path, a query, a dropped fragment, a bracketed IPv6
// host; the malformed ones refused. Percent-encoding of every byte class
// and its decoding; a `%` without two hex digits is None. Headers found
// whatever their case, and a request's defaults.

import std;

fn parsed(str text)
{
    match (Url::parse(StringView::of(text)))
    {
        Ok(u) : printf(
            "%-36s scheme=%s host=%s port=%u path=%s query=[%s] target=%s text=%s\n",
            text,
            &u.scheme,
            &u.host,
            u.port,
            &u.path,
            &u.query,
            &Url::target(&u),
            &Url::text(&u),
        ),
        Err(e) : printf("%-36s refused: %s\n", text, HttpError::text(&e)),
    }
}

fn main() : u8
{
    parsed("http://example.com");
    parsed("HTTPS://Example.COM:8443/a/b?q=1&r=2#frag");
    parsed("https://example.com:443/");
    parsed("http://[::1]:8080/x?y");
    parsed("http://host/path#only-fragment");
    parsed("example.com/no-scheme");
    parsed("http:///no-host");
    parsed("http://user@host/");
    parsed("http://host:99999/");
    parsed("http://host:abc/");
    printf("encode: %s\n", &percent_encode(&b"a b/c?d=e&f~g_h-i.j\x00\xff"[0..$]));
    printf(
        "decode: %s\n",
        &Result::unwrap_or(String::from_utf8(Option::unwrap(percent_decode("a%20b%2Fc%3f"))), String::new()),
    );
    printf("decode bad: %v %v\n", Option::is_none(&percent_decode("abc%2")), Option::is_none(&percent_decode("%zz")));
    Vec<Header> hs = Vec::new();
    Vec::push(&mut hs, Header::new("Content-Type", "text/plain"));
    Vec::push(&mut hs, Header::new("X-Twice", "first"));
    Vec::push(&mut hs, Header::new("x-twice", "second"));
    printf(
        "find: %s %s %s %v\n",
        Option::unwrap_or(find_header(&hs[0..$], "CONTENT-TYPE"), StringView::of("-")),
        Option::unwrap_or(find_header(&hs[0..$], "x-twice"), StringView::of("-")),
        Option::unwrap_or(find_header(&hs[0..$], "X-TWICE"), StringView::of("-")),
        Option::is_none(&find_header(&hs[0..$], "missing")),
    );
    Request r = Request::new("GET", "http://h/p");
    printf(
        "request: %s %s %v headers %v body bytes, header %v\n",
        &r.method,
        &r.url,
        Vec::len(&r.headers),
        Vec::len(&r.body),
        Option::is_none(&Request::header(&r, "host")),
    );
    printf(
        "reasons: %s / %s / %s / [%s]\n",
        reason_phrase(200),
        reason_phrase(404),
        reason_phrase(503),
        reason_phrase(299),
    );
    0
}
