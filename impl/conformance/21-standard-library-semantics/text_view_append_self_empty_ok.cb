// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.text (append, view); conf.text-append-empty-view-of-self
// kind: positive
// expect: ok
// expect-stdout-hex: 68656c6c6f0a
//
// An empty view of a `String` appended to that same `String`: `append`
// of no bytes changes nothing and borrows nothing, so it does not clash.

import std;

fn main()
{
    String s = "hello";
    String::append(&mut s, &s[2..2]);
    printf("%s\n", &s);
}
