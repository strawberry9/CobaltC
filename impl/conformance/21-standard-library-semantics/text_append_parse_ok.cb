// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.text [Append] [Parse]; conf.text-round-trip
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// For every integer type's limits and for floats whose shortest text
// takes each of print's forms, `String::append` gives the text `print`
// writes, and `parse` reads it back to the same value (the text of the
// parsed value is byte-for-byte the same). Then each kind of
// `ParseError`: `Empty`, `Invalid(k)` at the first byte that cannot
// continue a number (or at the end), and `OutOfRange`, including an
// invalid byte after digits that are already out of range. Prints one
// line per check.

import std;

fn same(ref<String, shared> a, ref<String, shared> b) : bool
{
    auto x = String::as_bytes(a);
    auto y = String::as_bytes(b);
    usize n = Vec::len(x);
    if (n != Vec::len(y))
    {
        return false;
    }
    usize i = 0;
    while (i < n)
    {
        if (*Vec::index_shared(x, i) != *Vec::index_shared(y, i))
        {
            return false;
        }
        i = i + 1;
    }
    true
}

fn round_trip<T>(T v)
{
    String a = String::new();
    String::append(&mut a, v);
    String b = String::new();
    match (parse<T>(&a))
    {
        Ok(w) :
        {
            String::append(&mut b, w);
        },
        Err(_) :
        {
            1 / (1 - 1);
        },
    }
    if (!same(&a, &b))
    {
        1 / (1 - 1);
    }
    printf("%v\n", &a);
}

// A float from its text (a literal has no exponent form); `zero` only
// gives `T`, since a failure faults.
fn float_of<T>(str text, T zero) : T
{
    String s = String::from_str(text);
    match (parse<T>(&s))
    {
        Ok(v) : v,
        Err(_) :
        {
            1 / (1 - 1);
            zero
        },
    }
}

// The error `parse<T>` gives for `text`, as a line: `Empty`,
// `Invalid k` or `OutOfRange`; a number is a failure.
fn error_of<T>(str text)
{
    String s = String::from_str(text);
    match (parse<T>(&s))
    {
        Ok(_) :
        {
            1 / (1 - 1);
        },
        Err(e) :
        {
            match (e)
            {
                Empty :
                {
                    printf("Empty");
                },
                Invalid(k) :
                {
                    printf("Invalid %v", k);
                },
                OutOfRange :
                {
                    printf("OutOfRange");
                },
            }
        },
    }
    printf("\n");
}

fn main()
{
    round_trip(min_value<i8>());
    round_trip(max_value<u8>());
    round_trip(min_value<i32>());
    round_trip(max_value<i64>());
    round_trip(max_value<u64>());
    round_trip(min_value<i128>());
    round_trip(max_value<u128>());
    round_trip(0.1);
    round_trip(-2.5);
    round_trip(float_of("1.0e-7", 0.0));
    round_trip(float_of("1.0e21", 0.0));
    round_trip(float_of("1.7976931348623157e308", 0.0));
    round_trip(float_of("5.0e-324", 0.0));
    round_trip(0.1: f32);
    round_trip(float_of("3.4028235e38", 0.0: f32));
    error_of<i32>("");
    error_of<i32>("-");
    error_of<i32>("12x4");
    error_of<i32>(" 1");
    error_of<i32>("1 ");
    error_of<i32>("0x10");
    error_of<i32>("1_000");
    error_of<u8>("-0");
    error_of<i8>("128");
    error_of<i8>("-129");
    error_of<i32>("99999999999999999999x");
    error_of<f64>(".5");
    error_of<f64>("5.");
    error_of<f64>("1e");
    error_of<f64>("-NaN");
    error_of<f64>("1e400");
    error_of<f32>("1e39");
}
