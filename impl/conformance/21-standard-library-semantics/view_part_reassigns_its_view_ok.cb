// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview [View-Form] (D-0053, D-0308); conf.view-part-reassigns-its-view
// kind: positive
// expect: ok
//
// `&v[lo .. hi]` of a `StringView` binding is `StringView::part(v, lo, hi)`,
// which takes the view by value: the part borrows what `v` borrows (the
// `String`), not `v`, so `v` may be given the part, or a part of it,
// while the part is live.

import std;

fn main()
{
    String s = "a`bc`d`";
    StringView rest = &s;
    usize n = 0;
    while (true)
    {
        usize at = match (StringView::find(rest, "`"))
        {
            Some(k) : k,
            None    : break,
        };
        StringView after = &rest[at + 1..$];
        n += 1;
        rest = &after[0..$];
    }
    assert(n == 3 && rest == "");
    StringView v = &s[2..$];
    StringView w = &v[1..3];
    v = w;
    assert(v == "c`");
    printf("%v %v\n", n, v);
}
