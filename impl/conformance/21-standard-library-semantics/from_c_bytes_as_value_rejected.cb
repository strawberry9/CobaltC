// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.ffi; rule.trust.unsafe [Unsafe-Rejected] (D-0252); conf.from-c-bytes-as-value
// kind: negative
// expect: diag.trusted-outside-unsafe (static)
//
// A `fn` value's call needs no `unsafe`, so the functions that read a C
// pointer are never values, even inside `unsafe`.

import std;

fn main()
{
    unsafe
    {
        fn(rawptr<u8>) : Vec<u8> f = Vec::from_c_bytes;
    }
}
