// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec, rule.agg.field-access; conf.vec-struct-field-loops
// kind: positive
// expect: ok
// expect-stdout-hex: 3320323320312034323220672b2b0a636f756e7420330a736872696e6b203233330a3620313920393920350a696e20612076656320372031360a
//
// Functions that loop over the Vec fields of a struct they are given by
// reference (indexing, push, pop, insert, swap, reverse, truncate, len),
// beside its other fields (a String appended to, counters), for a local
// struct and for one inside a Vec. (cobc runs such a body unchecked after
// one entry test, D-0189; the results must be the prelude's.)

import std;

struct Grid
{
    String name;
    Vec<i64> cells;
    Vec<u8> marks;
    usize width;
    i64 total;
}

fn fill(ref<Grid, exclusive> g, usize n)
{
    for (usize i = 0; i < n; i += 1)
    {
        Vec::push(&mut g.cells, narrow<i64>(i % 7));
        Vec::push(&mut g.marks, 0);
    }
    g.width = n;
}

fn step(ref<Grid, exclusive> g)
{
    for (usize i = 0; i < Vec::len(&g.cells); i += 1)
    {
        g.cells[i] = g.cells[i] * 2 + 1;
        if (g.cells[i] % 3 == 0)
        {
            g.marks[i] = g.marks[i] + 1;
        }
        g.total += g.cells[i];
    }
    Vec::swap(&mut g.cells, 0, g.width - 1);
    String::append(&mut g.name, "+");
}

fn shrink(ref<Grid, exclusive> g) : i64
{
    i64 t = 0;
    while (Vec::len(&g.cells) > 5)
    {
        match (Vec::pop(&mut g.cells))
        {
            Some(x) : t += x,
            None    : break,
        }
    }
    Vec::insert(&mut g.cells, 0, 99);
    Vec::reverse(&mut g.cells);
    Vec::truncate(&mut g.marks, 5);
    t
}

fn count(ref<Grid, shared> g, i64 want) : usize
{
    usize n = 0;
    for (usize i = 0; i < Vec::len(&g.cells); i += 1)
    {
        if (g.cells[i] == want)
        {
            n += 1;
        }
    }
    n
}

fn main()
{
    Grid g = Grid { .name = String::from_str("g"), .cells = Vec::new(), .marks = Vec::new(), .width = 0, .total = 0 };
    fill(&mut g, 20);
    step(&mut g);
    step(&mut g);
    printf("%v %v %v %v %s\n", g.cells[0], g.cells[19], g.marks[3], g.total, &g.name);
    printf("count %v\n", count(&g, 7));
    printf("shrink %v\n", shrink(&mut g));
    printf("%v %v %v %v\n", Vec::len(&g.cells), g.cells[0], g.cells[5], Vec::len(&g.marks));
    Vec<Grid> gs = Vec::new();
    Vec::push(
        &mut gs,
        Grid { .name = String::from_str("in"), .cells = Vec::new(), .marks = Vec::new(), .width = 0, .total = 0 },
    );
    fill(&mut gs[0], 4);
    step(&mut gs[0]);
    printf("in a vec %v %v\n", gs[0].cells[0], gs[0].total);
}
