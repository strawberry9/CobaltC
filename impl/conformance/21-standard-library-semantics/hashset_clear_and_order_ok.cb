// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.hashmap: `remove` keeps order, `swap_remove` moves the last entry, `HashSet::clear`, `HashSet::key_at` (D-0134); conf.hashset-clear, conf.hashset-remove-keeps-order
// kind: positive
// expect: ok
// expect-stdout-hex: 6220632064202f206220640a
//
// The two removals of a set, and `clear`: `remove` keeps the others in
// insertion order, `swap_remove` moves the last key into the hole; a
// cleared set is empty and usable again.

import std;

fn show(ref<HashSet<str>, shared> s)
{
    foreach (i in 0..HashSet::len(s))
    {
        printf("%s%s", if (i > 0) { " " } else { "" }, *HashSet::key_at(s, i));
    }
}

fn main()
{
    HashSet<str> s = HashSet::new();
    foreach (k in ["a", "b", "c", "d"])
    {
        HashSet::insert(&mut s, k);
    }
    str a = "a";
    str b = "b";
    str c = "c";
    assert(HashSet::remove(&mut s, &a));
    show(&s);
    printf(" / ");
    assert(HashSet::swap_remove(&mut s, &c) && !HashSet::swap_remove(&mut s, &c));
    show(&s);
    printf("\n");
    HashSet::clear(&mut s);
    assert(HashSet::len(&s) == 0 && !HashSet::contains(&s, &b));
    assert(HashSet::insert(&mut s, "e") && HashSet::len(&s) == 1);
}
