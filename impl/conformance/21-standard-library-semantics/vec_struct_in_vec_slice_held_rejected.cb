// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: [Borrow-Denied], D-0190; conf.vec-struct-in-vec-slice-held
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 666972737420360a
//
// A shared slice over bags[0..2] lives while &mut bags[1] is formed for a
// call: the borrow clashes with it, before the function's entry test.

import std;

struct Bag
{
    Vec<i64> items;
    i64 total;
}

fn work(ref<Bag, exclusive> b)
{
    for (usize i = 0; i < Vec::len(&b.items); i += 1)
    {
        b.total += b.items[i];
    }
}

fn main() : u8
{
    Vec<Bag> bags = Vec::new();
    Vec::push(&mut bags, Bag { .items = Vec::filled(3, 1: i64), .total = 0 });
    Vec::push(&mut bags, Bag { .items = Vec::filled(3, 2: i64), .total = 0 });
    work(&mut bags[1]);
    printf("first %v\n", bags[1].total);
    Vec<slice<Bag, shared>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &bags[0..2]);
    }
    work(&mut bags[1]);
    printf("second %v %v\n", bags[1].total, held[0][1].total);
    0
}
