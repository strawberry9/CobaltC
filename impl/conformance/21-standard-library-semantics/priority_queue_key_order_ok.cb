// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.priority-queue [Priority-Queue] (D-0137); conf.priority-queue-key-order
// kind: positive
// expect: ok
// expect-stdout-hex: 6c656e2031302c207065656b202d320a2d32203020312033203320352036203720382039200a2830203929202832203329202832203529202837203129200a6170706c65206669672070656172200a
//
// `PriorityQueue::new` orders by the key types' own order, as
// `Vec::sort` does: `pop` gives the least element first. A struct of keys
// is ordered field by field, so a shortest-path search needs no
// comparison function. `peek` looks without taking.

import std;

struct Visit
{
    u64 dist;
    usize node;
}

fn main()
{
    PriorityQueue<i32> q = PriorityQueue::new();
    assert(Option::is_none(&PriorityQueue::pop(&mut q)) && Option::is_none(&PriorityQueue::peek(&q)));
    foreach (x in [5, 1, 9, 3, 3, 7, -2, 8, 0, 6])
    {
        PriorityQueue::push(&mut q, x);
    }
    printf("len %d, peek %d\n", PriorityQueue::len(&q), *Option::unwrap(PriorityQueue::peek(&q)));
    while (Some(x) = PriorityQueue::pop(&mut q))
    {
        printf("%d ", x);
    }
    printf("\n");

    PriorityQueue<Visit> v = PriorityQueue::new();
    PriorityQueue::push(&mut v, Visit { .dist = 7, .node = 1 });
    PriorityQueue::push(&mut v, Visit { .dist = 2, .node = 5 });
    PriorityQueue::push(&mut v, Visit { .dist = 2, .node = 3 });
    PriorityQueue::push(&mut v, Visit { .dist = 0, .node = 9 });
    while (Some(x) = PriorityQueue::pop(&mut v))
    {
        printf("(%d %d) ", x.dist, x.node);
    }
    printf("\n");

    PriorityQueue<String> w = PriorityQueue::new();
    foreach (s in ["pear", "apple", "fig"])
    {
        PriorityQueue::push(&mut w, String::from_str(s));
    }
    while (Some(s) = PriorityQueue::pop(&mut w))
    {
        printf("%s ", &s);
    }
    printf("\n");
}
