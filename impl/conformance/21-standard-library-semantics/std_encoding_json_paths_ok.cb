// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.prelude (std::encoding, D-0197); rule.module.use (re-export); conf.std-encoding-json-paths
// kind: positive
// expect: ok
// expect-stdout-hex: 5b312c747275652c7b226b223a6e756c6c7d5d0a
//
// JSON is `std::encoding::json`, re-exported by `std::encoding` and by
// `std`'s root, so `std::encoding::json::Json`, `std::encoding::Json`
// and `Json` are one type. A program may import the format alone
// (`import std::encoding::json;`).

import std;
import std::encoding::json;

fn main()
{
    std::encoding::json::Json a = Result::unwrap(std::encoding::Json::parse(StringView::of("[1,true]")));
    Json b = Result::unwrap(Json::parse(StringView::of("{\"k\":null}")));
    std::encoding::json::Json::push(&mut a, b);
    printf("%v\n", &Json::text(&a));
}
