// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stats [Stats-Sum] [Stats-Mean] [Stats-Variance] [Stats-Median] [Stats-Percentile] [Stats-Extremes] [Stats-Describe] (D-0267); conf.stats-sum, conf.stats-moments, conf.stats-order, conf.stats-describe
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// `sum` in the slice's own type (integers of three widths and floats, an
// empty slice); `mean`, `variance`, `stddev` and the sample forms on the
// textbook values, with the exact results two-pass arithmetic gives, and
// their `None` cases; `median` and `percentile` on odd and even counts,
// at the ends and between neighbours, with a NaN ordered last; `minimum`
// and `maximum` with a NaN passed over; `describe` as one `Summary`.

import std;

fn show(Option<f64> x) : String
{
    match (x)
    {
        Some(v) : sprintf("%v", v),
        None    : String::from_str("none"),
    }
}

fn main()
{
    array<u8, 4> bytes = [200, 50, 5, 0];
    array<i64, 3> big = [4_000_000_000, 4_000_000_000, -1];
    array<f32, 3> halves = [0.5, 0.25, 0.125];
    Vec<i32> none = Vec::new();
    printf("%v %v %v %v\n", sum(&bytes[0..$]), sum(&big[0..$]), sum(&halves[0..$]), sum(&none[0..$]));

    array<u32, 8> a = [2, 4, 4, 4, 5, 5, 7, 9];
    printf("%v %v %v\n", &show(mean(&a[0..$])), &show(variance(&a[0..$])), &show(stddev(&a[0..$])));
    printf("%v %v\n", &show(sample_variance(&a[0..$])), &show(sample_stddev(&a[0..$])));
    array<f64, 3> thirds = [0.1, 0.2, 0.3];
    printf("%v %v\n", &show(mean(&thirds[0..$])), &show(variance(&thirds[0..$])));
    printf(
        "%v %v %v %v\n",
        &show(mean(&a[0..0])),
        &show(variance(&a[0..1])),
        &show(sample_variance(&a[0..1])),
        &show(sample_stddev(&a[0..2])),
    );

    array<i64, 5> odd = [15, 20, 35, 40, 50];
    printf(
        "%v %v %v %v\n",
        &show(median(&odd[0..$])),
        &show(median(&odd[0..4])),
        &show(median(&odd[0..1])),
        &show(median(&odd[0..0])),
    );
    printf(
        "%v %v %v %v %v\n",
        &show(percentile(&odd[0..$], 0.0)),
        &show(percentile(&odd[0..$], 25.0)),
        &show(percentile(&odd[0..$], 40.0)),
        &show(percentile(&odd[0..$], 50.0)),
        &show(percentile(&odd[0..$], 100.0)),
    );
    printf("%v %v\n", &show(percentile(&odd[0..1], 75.0)), &show(percentile(&odd[0..0], 75.0)));
    f64 nan = 0.0 / 0.0;
    array<f64, 4> withnan = [3.0, nan, 1.0, 2.0];
    printf(
        "%v %v %v\n",
        &show(median(&withnan[0..$])),
        &show(percentile(&withnan[0..$], 100.0)),
        &show(percentile(&withnan[0..3], 50.0)),
    );

    array<i16, 4> ends = [7, -3, 12, 0];
    printf(
        "%v %v %v %v\n",
        &show(minimum(&ends[0..$])),
        &show(maximum(&ends[0..$])),
        &show(minimum(&ends[0..0])),
        &show(maximum(&ends[0..0])),
    );
    printf(
        "%v %v %v\n",
        &show(minimum(&withnan[0..$])),
        &show(maximum(&withnan[0..$])),
        &show(minimum(&withnan[1..2])),
    );

    array<u32, 6> ms = [12, 15, 11, 40, 13, 14];
    match (describe(&ms[0..$]))
    {
        Some(s) :
        {
            Summary copy = s;
            printf("%v %v %v %v %v %v\n", copy.count, copy.minimum, copy.maximum, copy.mean, copy.stddev, copy.median);
        },
        None    : printf("none\n"),
    }
    printf("%v\n", Option::is_none(&describe(&none[0..$])));
}
