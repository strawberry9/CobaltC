// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.print `printf`, `eprintf`, `sprintf` (D-0038, D-0040)
// kind: positive
// expect: ok
//
// String locals formatted by `printf`, `sprintf` and `eprintf`: one only
// read and printed (left by `break`), one appended to between prints, one
// formatted twice by the same call and into another String. Each prints
// the text it holds at that call.

import std;

fn lines(usize n) : usize
{
    usize t = 0;
    foreach (i in 0..n)
    {
        String s = sprintf("row %v", i);
        printf("%v|", &s);
        t += String::len(&s);
        if (i == 3)
        {
            break;
        }
    }
    printf("\n");
    t
}

fn grows()
{
    String s = String::from_str("a");
    foreach (i in 0..3)
    {
        String::append(&mut s, i);
        printf("[%v]", &s);
    }
    printf("\n");
}

fn twice()
{
    String s = sprintf("x%v", 1);
    printf("%v-%v\n", &s, &s);
    String t = sprintf("%v and %v", &s, 2);
    eprintf("%v\n", &t);
    printf("%v\n", &t);
}

fn main()
{
    printf("%v\n", lines(10));
    grows();
    twice();
}
