// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.swap [Swap-Places] [Swap-Places-Conflict]; D-0235; CHG-0371; conf.replace-string-passed-ref-beside-shared-reborrow
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `conf.replace-passed-ref-beside-shared-reborrow` with a `String`: `replace`
// writes `*r` through `swap_places`, which takes `[Write]`'s premises
// (D-0235), whatever the type; the call faults where `s` would otherwise
// have seen the new text.
//
// D-0282: the static pass rejects this program before it runs (it was found
// at run time before): `replace` writes `*r` through argument 1 while `s`
// still borrows `*r`.

import std;

fn main()
{
    String x = String::from_str("a");
    auto r = &mut x;
    auto s = &*r;
    String old = replace(r, String::from_str("b"));
    printf("%v %v\n", String::as_view(s), String::as_view(&old));
}
