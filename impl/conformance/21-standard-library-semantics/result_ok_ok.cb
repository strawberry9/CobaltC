// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.result `Result::ok` (D-0205); conf.result-ok
// kind: positive
// expect: ok
// expect-stdout-hex: 343220747275652041410a
//
// `Result::ok` gives the value as `Some`, or `None` for an error -- which
// then ends, its resources with it.

import std;

fn main()
{
    Option<u64> a = Result::ok(String::parse<u64>(&String::from_str("42")));
    Option<u64> b = Result::ok(String::parse<u64>(&String::from_str("4x2")));
    Option<String> c = Result::ok(String::from_utf8(Vec::filled(2, 0x41: u8)));
    printf("%v %v %s\n", Option::unwrap(a), Option::is_none(&b), &Option::unwrap(c));
}
