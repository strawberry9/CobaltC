// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Ecdsa] (D-0159); conf.ecdsa-p256
// kind: positive
// expect: ok
// slow: interpreted big-number arithmetic takes well over the 10-second budget
// expect-stdout-hex: 76616c69643a20747275650a73206368616e6765643a2066616c73650a6f6666207468652063757276653a2066616c73650a7472756e6361746564207369676e61747572653a2066616c73650a
//
// ECDSA verification on P256 with vectors made by Python's
// `cryptography`: a valid signature, the same with s changed, a point not
// on the curve, and a malformed signature.

import std;

fn bytes_of(str t) : Vec<u8>
{
    Result::unwrap_or(from_hex(StringView::of(t)), Vec::new())
}

fn main() : u8
{
    Vec<u8> key = bytes_of("04bb643d2a6b2d2651117fc983f16055644a914686c884f8c1e7585841361b1e9b2157b64f65f68c81352c3c878b9c9da24193ccc2a5d7826088322c1daa5c838e");
    Vec<u8> digest = bytes_of("8d1d525f8b727e3e677117aafd1edc2fe9ccd55d4610b8ad434db2ee18ac4783");
    Vec<u8> good = bytes_of("3046022100cece68ec589b55828148d553897857d0a093412736c386d38fcc183824aa8f1f0221008e735079ac503ed2a9b9a8fc09c898f41dfc943090f17352d563b7317c187dac");
    Vec<u8> bad = bytes_of("3046022100cece68ec589b55828148d553897857d0a093412736c386d38fcc183824aa8f1f0221008e735079ac503ed2a9b9a8fc09c898f41dfc943090f17352d563b7317c187dad");
    printf("valid: %v\n", ecdsa_verify(P256, &key[0..$], &digest[0..$], &good[0..$]));
    printf("s changed: %v\n", ecdsa_verify(P256, &key[0..$], &digest[0..$], &bad[0..$]));
    Vec<u8> off = Vec::clone(&key);
    usize last = Vec::len(&off) - 1;
    off[last] = off[last] ^ 1;
    printf("off the curve: %v\n", ecdsa_verify(P256, &off[0..$], &digest[0..$], &good[0..$]));
    Vec<u8> cut = Vec::from_slice(&good[0..Vec::len(&good) - 1]);
    printf("truncated signature: %v\n", ecdsa_verify(P256, &key[0..$], &digest[0..$], &cut[0..$]));
    0
}
