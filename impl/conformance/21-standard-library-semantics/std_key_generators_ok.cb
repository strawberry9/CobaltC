// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: §2 `std::crypto` (`p256_private_key`, `ed25519_private_key`, `ec_private_key`, `EcCurve`); conf.std-key-generators
// kind: positive
// expect: ok
// expect-stdout-hex: 7032353620747275650a6564323535313920747275650a656320343820333220747275650a
// slow: interpreted big-number arithmetic takes well over the 10-second budget
//
// The key generators make keys of the right length whose public keys
// derive (each run's keys differ, so only that is printed).
import std;

fn main()
{
    array<u8, 32> k1 = p256_private_key();
    printf("p256 %v\n", Option::is_some(&p256_public_key(&k1[0..$])));
    array<u8, 32> k2 = ed25519_private_key();
    array<u8, 32> pub2 = ed25519_public_key(&k2[0..$]);
    printf("ed25519 %v\n", pub2 == ed25519_public_key(&k2[0..$]));
    EcCurve curves = P384;
    Vec<u8> k3 = ec_private_key(curves);
    Vec<u8> k4 = ec_private_key(P256);
    printf("ec %v %v %v\n", Vec::len(&k3), Vec::len(&k4), Option::is_some(&ec_public_key(P256, &k4[0..$])));
}
