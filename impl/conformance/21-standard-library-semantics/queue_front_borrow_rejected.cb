// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.queue [Queue] (D-0137); rule.temporal.elision; conf.queue-front-borrows
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `front` gives a reference that borrows the queue, as `HashMap::get`'s
// does: the queue cannot change while it is in use. A push could move
// every element to a new buffer.

import std;

fn main()
{
    Queue<i32> q = Queue::new();
    Queue::push_back(&mut q, 1);
    ref<i32, shared> f = Option::unwrap(Queue::front(&q));
    Queue::push_back(&mut q, 2);
    printf("%d\n", *f);
}
