// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `position`, rule.fn.closure, [Borrow-Denied]; conf.vec-predicate-value-keeps-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 747275650a
//
// A fn value holding a closure that keeps the element references it is
// given (pushing them into a captured Vec): the kept reference reads 2; a
// push onto the vector while it lives clashes.

import std;

fn main() : u8
{
    Vec<i64> v = Vec::filled(4, 2: i64);
    Vec<ref<i64, shared>> kept = Vec::new();
    fn(ref<i64, shared>) : bool p = [kept](ref<i64, shared> x) : bool { Vec::push(&mut kept, x); true };
    printf("%v\n", Option::is_some(&Vec::position(&v, p)));
    printf("%v\n", *kept[0]);
    Vec::push(&mut v, 3);
    printf("%v\n", *kept[0]);
    0
}
