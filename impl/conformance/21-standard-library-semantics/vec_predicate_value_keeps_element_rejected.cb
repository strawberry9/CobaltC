// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `position`, rule.fn.closure, [Release]; conf.vec-predicate-value-keeps-element
// kind: negative
// expect: diag.stale-binding (dynamic)
// expect-stdout-hex: 747275650a320a
//
// A fn value holding a closure that keeps the element references it is
// given (pushing them into a captured Vec): the kept reference reads 2; a
// push that grows the vector moves its elements, and the kept reference is
// stale at its next read. The fn value lives in its own block, so that its
// own hold of `kept` (a closure holds what it captures while it exists,
// D-0288, D-0291) has ended when `kept` is read; before D-0291 that hold
// was taken to end at the fn value's last use, and the first read of
// `kept` faulted `diag.aliasing-conflict` at run time.

import std;

fn main() : u8
{
    Vec<i64> v = Vec::filled(4, 2: i64);
    Vec<ref<i64, shared>> kept = Vec::new();
    {
        fn(ref<i64, shared>) : bool p = [kept](ref<i64, shared> x) : bool { Vec::push(&mut kept, x); true };
        printf("%v\n", Option::is_some(&Vec::position(&v, p)));
    }
    printf("%v\n", *kept[0]);
    Vec::push(&mut v, 3);
    printf("%v\n", *kept[0]);
    0
}
