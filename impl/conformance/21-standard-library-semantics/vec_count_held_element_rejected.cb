// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `count`, [Read-Conflict]; conf.vec-count-held-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// Vec::count borrows each element for its predicate, as Vec::position
// does; the shared borrow of v[3] clashes with a live exclusive reference
// to it.

import std;

fn main() : u8
{
    Vec<i64> v = Vec::filled(5, 2: i64);
    Vec<ref<i64, exclusive>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &mut v[3]);
    }
    printf("%v\n", Vec::count(&v, [](ref<i64, shared> x) : bool { *x == 9 }));
    *held[0] = 1;
    0
}
