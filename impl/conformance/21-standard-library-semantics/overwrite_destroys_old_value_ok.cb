// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §3b `overwrite` (D-0080); conf.overwrite-destroys-old-value
// kind: positive
// expect: ok
//
// `overwrite(&mut x, v)` stores `v` and destroys what was there during
// the call: the old value's destructor runs before the next statement.

import std;

resource struct Noisy
{
    u32 id;
    ref<Channel<u32>, shared> log;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    _ = Channel::send(self.log, self.id);
}

fn main()
{
    Channel<u32> log = Channel::new(8);
    {
        Noisy a = Noisy { .id = 1, .log = &log };
        overwrite(&mut a, Noisy { .id = 2, .log = &log });
        // 1 was destroyed by the call, before this line
        assert(Option::unwrap(Channel::recv(&log)) == 1, "old value first");
    }
    assert(Option::unwrap(Channel::recv(&log)) == 2, "new value at block end");
    String s = String::from_str("old");
    overwrite(&mut s, String::from_str("new"));
    Vec<String> v = Vec::new();
    Vec::push(&mut v, String::from_str("a"));
    overwrite(Vec::index_exclusive(&mut v, 0), String::from_str("b"));
    assert(String::eq_str(&s, "new") && String::eq_str(&v[0], "b"), "strings");
}
