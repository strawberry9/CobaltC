// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.file-handle [Create-New] [Flush] [Position] (D-0181); conf.file-create-new, conf.file-flush-position
// kind: positive
// expect: ok
// args: $TMP
// expect-stdout-hex: 616761696e3a20747275650a6469723a20747275650a6d697373696e6720706172656e743a20747275650a30203130203220747275652036203820747275650a31323334350a6162630a0a
//
// `File::create_new` makes a file only when nothing is there (`Ok(None)`
// for a file or a directory already there, `Err` for a missing parent);
// `position` follows writes, reads, read lines and seeks; `flush` makes
// the bytes durable and reports nothing on a file open for writing.

import std;

fn main()
{
    String dir = Result::unwrap(arg(0));
    String p = path_join(&dir, "lock.pid");
    _ = remove_file(&p);                  // the harness may give every tool one directory
    File f = Option::unwrap(Result::unwrap(File::create_new(&p)));
    printf("again: %v\n", Option::is_none(&Result::unwrap(File::create_new(&p))));
    printf("dir: %v\n", Option::is_none(&Result::unwrap(File::create_new(&dir))));
    printf(
        "missing parent: %v\n",
        Result::is_err(&File::create_new(&path_join(&dir, "no/such/file"))),
    );
    printf("%v ", Result::unwrap(File::position(&f)));
    _ = File::write_text(&mut f, "12345\nabc\n");
    printf("%v ", Result::unwrap(File::position(&f)));
    _ = File::seek(&mut f, 2);
    printf("%v ", Result::unwrap(File::position(&f)));
    printf("%v ", Result::is_ok(&File::flush(&mut f)));
    _ = File::close(f);
    File g = Result::unwrap(File::open(&p));
    _ = File::read_line(&mut g);
    printf("%v ", Result::unwrap(File::position(&g)));
    Vec<u8> two = Vec::new();
    _ = File::read(&mut g, &mut two, 2);
    printf("%v ", Result::unwrap(File::position(&g)));
    printf("%v\n", Result::is_err(&File::flush(&mut g)));
    printf("%v\n", &Result::unwrap(read_file(&p)));
}
