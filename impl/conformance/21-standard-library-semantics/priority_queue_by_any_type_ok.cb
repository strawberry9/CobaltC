// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.priority-queue [Priority-Queue] (D-0137); conf.priority-queue-by-any-type
// kind: positive
// expect: ok
// expect-stdout-hex: 3120322032203520382039200a6170706c65206669670a6b6570740a
//
// `new_by` orders any element type, not only the key types: here
// references, and `Rc` handles that the queue owns. Moving elements
// within the heap keeps what they hold: the references stay valid and
// the handles keep their values alive until the queue lets them go.

import std;

fn ref_less(ref<ref<i32, shared>, shared> a, ref<ref<i32, shared>, shared> b) : bool
{
    **a < **b
}

fn rc_less(ref<Rc<String>, shared> a, ref<Rc<String>, shared> b) : bool
{
    String::less(Rc::get(a), Rc::get(b))
}

fn main()
{
    array<i32, 6> xs = [5, 2, 8, 2, 9, 1];
    PriorityQueue<ref<i32, shared>> rq = PriorityQueue::new_by(ref_less);
    foreach (x in &xs)
    {
        PriorityQueue::push(&mut rq, x);
    }
    while (Some(x) = PriorityQueue::pop(&mut rq))
    {
        printf("%d ", *x);
    }
    printf("\n");

    Rc<String> keep = Rc::new(String::from_str("kept"));
    PriorityQueue<Rc<String>> cq = PriorityQueue::new_by(rc_less);
    foreach (w in ["pear", "fig", "apple", "kiwi"])
    {
        PriorityQueue::push(&mut cq, Rc::new(String::from_str(w)));
    }
    PriorityQueue::push(&mut cq, Rc::clone(&keep));
    Rc<String> first = Option::unwrap(PriorityQueue::pop(&mut cq));
    printf("%s %s\n", Rc::get(&first), Rc::get(Option::unwrap(PriorityQueue::peek(&cq))));
    PriorityQueue::clear(&mut cq);
    printf("%s\n", Rc::get(&keep));
}
