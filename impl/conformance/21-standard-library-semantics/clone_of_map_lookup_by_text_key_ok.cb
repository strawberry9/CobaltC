// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.type.bound [T-Clone] (`clone(&x)` is a value of x's type), `HashMap::get`; conf.clone-of-map-lookup-by-text-key
// kind: positive
// expect: ok
// expect-stdout-hex: 340a340a340a
//
// `clone(Option::unwrap(HashMap::get(m, k)))` copies the value a map holds
// under a text key, whatever the key is written as: a `foreach` element, a
// temporary text borrowed in place inside a loop, the same outside one.
// Until Update 215 the compiler stopped on an internal assert for each of
// the three (`clone` lowers a copy of its argument, and the copy lost the
// record by which the key, a view of a text, is known as one).
import std;

struct NF
{
    i64 v;
    i64 i;
}

fn by_element(ref<HashMap<String, NF>, shared> m, ref<Vec<String>, shared> all) : i64
{
    i64 t = 0;
    foreach (n in all)
    {
        NF tn = clone(Option::unwrap(HashMap::get(m, n)));
        t += tn.v;
    }
    t
}

fn by_temporary_in_loop(ref<HashMap<String, NF>, shared> m, ref<Vec<String>, shared> all) : i64
{
    i64 t = 0;
    foreach (n in all)
    {
        NF tn = clone(Option::unwrap(HashMap::get(m, &String::clone(n))));
        t += tn.v;
    }
    t
}

fn by_temporary(ref<HashMap<String, NF>, shared> m, ref<String, shared> k) : i64
{
    NF tn = clone(Option::unwrap(HashMap::get(m, &String::clone(k))));
    tn.v
}

fn main()
{
    HashMap<String, NF> b = HashMap::new();
    HashMap::insert(&mut b, "x", NF { .v = 4, .i = 0 });
    Vec<String> all = Vec::new();
    Vec::push(&mut all, "x");
    String k = "x";
    printf("%v\n", by_element(&b, &all));
    printf("%v\n", by_temporary_in_loop(&b, &all));
    printf("%v\n", by_temporary(&b, &k));
}
