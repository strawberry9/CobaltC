// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.prelude (D-0136, D-0177); conf.std-bytes-subjects
// kind: positive
// expect: ok
// expect-stdout-hex: 72656164206261636b3a20313639303930363020313032370a63726333323a20333035373434393933330a
//
// Integers as bytes and back are one subject, `std::collections`
// (`Vec::push_be`, `read_be`, `read_le`); `crc32` is in `std::crypto`
// (D-0177). Neither needs `std::text`.

import std::collections;
import std::crypto;
import std::io;

fn main()
{
    Vec<u8> v = Vec::new();
    Vec::push_be(&mut v, 0x01020304: u32);
    printf("read back: %v %v\n", read_be<u32>(&v[0..$], 0), read_le<u16>(&v[0..$], 2));
    printf("crc32: %v\n", crc32(&v[0..$]));
}
