// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §0 `Option::unwrap`, `Result::unwrap`, `Option::expect`, `Result::expect`, `Vec::clone`, `Vec::clone_by` (D-0082); conf.unwrap-some; conf.vec-clone
// kind: positive
// expect: ok
//
// The values come out when they are there; a clone is independent of
// its original; `clone_by` copies resource elements with the function.

import std;

fn main()
{
    Option<u32> o = Some(4);
    Result<String, u8> r = Ok("x");
    u32 a = Option::unwrap(o);
    String b = Result::expect(r, "never shown");
    Vec<u64> v = Vec::new();
    Vec::push(&mut v, 7);
    Vec<u64> w = Vec::clone(&v);
    Vec::push(&mut w, 8);
    Vec<String> names = Vec::new();
    Vec::push(&mut names, "ada");
    Vec<String> copy = Vec::clone_by(&names, String::clone);
    overwrite(Vec::index_exclusive(&mut copy, 0), "grace");
    assert(a == 4 && b == "x" && Vec::len(&v) == 1 && Vec::len(&w) == 2, "values");
    assert(names[0] == "ada" && copy[0] == "grace", "clone_by");
}
