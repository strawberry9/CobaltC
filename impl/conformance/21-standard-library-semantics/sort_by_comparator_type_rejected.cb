// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.sort [Sort-By] (the comparison's type); D-0062; conf.sort-by-comparator-type
// kind: negative
// expect: diag.type-mismatch (static)
//
// The comparison takes references to the element type: a comparison of
// `i64`s cannot sort a `Vec<i32>`.

import std;
fn cmp(ref<i64, shared> a, ref<i64, shared> b) : bool
{
    *a < *b
}
fn main()
{
    Vec<i32> v = Vec::new();
    Vec::sort_by(&mut v, cmp);
}
