// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Rsa-Pkcs1v15] [Rsa-Pss] (D-0158); conf.rsa-pss-3072
// kind: positive
// expect: ok
// slow: interpreted big-number arithmetic takes well over the 10-second budget
// expect-stdout-hex: 70737320333037322d626974207368613531323a20747275650a
//
// RSA-PSS over SHA-512 with a 3072-bit key: a signature made by Python's
// `cryptography` (OpenSSL) verifies. (Apart from crypto_rsa_ok.cb so each
// case stays quick under the interpreter's debug build.)

import std;

fn bytes_of(str t) : Vec<u8>
{
    Result::unwrap_or(from_hex(StringView::of(t)), Vec::new())
}

fn check(str name, str scheme, str bits, str n, str e, str digest, str sig)
{
    String ee = if (str_len(e) % 2 == 1) { "0" } else { "" };
    String::append(&mut ee, e);
    RsaPublicKey key = RsaPublicKey { .n = BigUint::from_bytes_be(&bytes_of(n)[0..$]), .e = BigUint::from_bytes_be(&Result::unwrap_or(
        from_hex(String::as_view(&ee)),
        Vec::new(),
    )[0..$]) };
    HashKind h = if (str_byte(bits, 0) == b'5') { Sha2_512 } else { Sha2_256 };
    Vec<u8> d = bytes_of(digest);
    Vec<u8> s = bytes_of(sig);
    bool ok = if (str_byte(
        scheme,
        0,
    ) == b'r')
    {
        rsa_verify_pkcs1v15(
            &key,
            h,
            &d[0..$],
            &s[0..$],
        )
    }
    else { rsa_verify_pss(&key, h, &d[0..$], &s[0..$]) };
    printf("%s: %v\n", name, ok);
}

fn main() : u8
{
    check(
        "pss 3072-bit sha512",
        "pss",
        "512",
        "",
        "10001",
        "3f349fb363d76549b20b0149ad6d604e6c42d9968c6ec86b582ee6882a03f32be9a7252f6d922975c5c26077a8abca0e1dcb9d36f3fff3ae22a74286717e98f9",
        "",
    );
    0
}
