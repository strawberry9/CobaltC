// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: diag.index-out-of-bounds [Call]; CHG-0362; conf.std-call-through-ref-fault-after-argument-call
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// The same through a reference parameter: `Vec::insert(v, pick(9), 2)`
// faults at the call once `pick` has run.

import std;

fn pick(u64 k) : usize
{
    printf("pick\n");
    narrow<usize>(k)
}

fn put(ref<Vec<i32>, exclusive> v, u64 k)
{
    Vec::insert(v, pick(k), 2);
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    put(&mut v, 0);
    put(&mut v, 9);
}
