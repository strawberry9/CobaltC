// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str [Str-Byte-Out-Of-Bounds]; conf.str-byte-out-of-bounds
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// `str_byte` is `checked` like [Index-Checked]: an index equal to the
// byte count faults. The index is a parameter, so flow analysis cannot
// refute it and the guard runs dynamically.

fn at(str s, usize i) : u8
{
    str_byte(s, i)
}

fn main()
{
    u8 b = at("hi", 2);
}
