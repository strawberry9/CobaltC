// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: `HashMap::contains_ref`, `HashMap::get_ref`, `HashSet::contains_ref`, `Vec::contains_ref` (D-0336): a generic body looks up a key it holds by reference, for a `String` key and an integer key alike, where `probe<K>` has no one spelling (conf.probe-generic-lookup-disagrees-rejected); conf.lookup-by-key-held
// kind: positive
// expect: ok
// expect-stdout-hex: 312032203120320a747275652066616c736520747275652066616c73650a
//

import std;

fn count_known<K>(ref<HashMap<K, i32>, shared> m, slice<K, shared> keys) : usize
{
    usize n = 0;
    foreach (k in keys)
    {
        if (HashMap::contains_ref(m, k))
        {
            n += 1;
        }
    }
    n
}

fn value_of<K>(ref<HashMap<K, i32>, shared> m, ref<K, shared> k) : i32
{
    match (HashMap::get_ref(m, k))
    {
        Some(v) : *v,
        None    : 0,
    }
}

fn seen<K>(ref<HashSet<K>, shared> s, ref<K, shared> k) : bool
{
    HashSet::contains_ref(s, k)
}

fn holds<T: eq>(ref<Vec<T>, shared> v, ref<T, shared> x) : bool
{
    Vec::contains_ref(v, x)
}

fn main()
{
    HashMap<String, i32> m = HashMap::new();
    HashMap::insert(&mut m, "a", 2);
    Vec<String> ks = Vec::new();
    Vec::push(&mut ks, "a");
    Vec::push(&mut ks, "b");
    HashMap<u32, i32> n = HashMap::new();
    HashMap::insert(&mut n, 3, 2);
    array<u32, 2> nk = [3, 4];
    printf("%v %v %v %v\n", count_known(&m, &ks[0..$]), value_of(&m, &ks[0]), count_known(&n, &nk[0..$]), value_of(&n, &nk[0]));
    HashSet<String> s = HashSet::new();
    HashSet::insert(&mut s, "a");
    Vec<u32> v = Vec::from_slice(&[1: u32, 2]);
    u32 two = 2;
    u32 five = 5;
    printf("%v %v %v %v\n", seen(&s, &ks[0]), seen(&s, &ks[1]), holds(&v, &two), holds(&v, &five));
}
