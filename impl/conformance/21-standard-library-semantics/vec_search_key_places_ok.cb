// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §1 Vec; conf.vec-search-key-places
// kind: positive
// expect: ok
// expect-stdout-hex: 747275652066616c7365207472756520747275650a3920340a7472756520310a7472756520370a747275652066616c73652066616c7365200a
//
// search keys that are fields, elements of another Vec, an element of the
// searched Vec, locals in a loop, and keys searched in a Vec no longer
// confined (D-0192)

import std;

struct Q
{
    i64 k;
    String name;
}

fn desc(ref<i64, shared> a, ref<i64, shared> b) : bool
{
    *a > *b
}

fn main()
{
    Vec<i64> v = Vec::new();
    foreach (i in 0..10: i64)
    {
        Vec::push(&mut v, i * 3);
    }
    Vec<i64> w = Vec::new();
    Vec::push(&mut w, 9);
    Vec::push(&mut w, 10);
    Q q = Q { .k = 12, .name = String::from_str("b") };
    i64 local = 27;
    printf(
        "%v %v %v %v\n",
        Vec::contains(&v, &w[0]),
        Vec::contains(&v, &w[1]),
        Vec::contains(&v, &q.k),
        Vec::contains(&v, &v[4]),
    );
    printf("%v %v\n", Option::unwrap(Vec::index_of(&v, &local)), Result::unwrap_or(Vec::binary_search(&v, &q.k), 99));
    Vec<String> s = Vec::new();
    Vec::push(&mut s, String::from_str("a"));
    Vec::push(&mut s, String::from_str("b"));
    Vec::push(&mut s, String::from_str("c"));
    printf("%v %v\n", Vec::contains(&s, &q.name), Result::unwrap_or(Vec::binary_search(&s, &q.name), 99));
    Vec::sort_by(&mut v, desc);
    i64 k2 = 6;
    printf("%v %v\n", Vec::contains(&v, &k2), Option::unwrap(Vec::index_of(&v, &k2)));
    foreach (i in 0..3: i64)
    {
        i64 probe = i * 13;
        printf("%v ", Vec::contains(&v, &probe));
    }
    printf("\n");
}
