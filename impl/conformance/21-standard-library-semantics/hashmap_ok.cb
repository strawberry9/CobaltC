// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.hashmap; conf.hashmap-output
// kind: positive
// expect: ok
// expect-stdout-hex: 746f3d322062653d32206f723d31206e6f743d3120746861743d312069733d312069743d31200a3220310a746f206974206f72206e6f74206973200a31303030203130333034310a64726f70207965730a64726f7020756e757365640a64726f70206e6f0a73657420310a64726f70205945530a
//
// HashMap and HashSet end to end: String keys counted with `entry`
// and listed in insertion order; `remove` moving the last entry into
// the gap and `remove_ordered` keeping the order; a thousand integer
// keys through several growths; resource values destroyed exactly once
// (replaced, unused, removed, or with the map); a HashSet of bytes.

import std;

resource struct Tag
{
    str name;
}

fn Tag::drop(ref<Tag, exclusive> self)
{
    printf("drop %s\n", self.name);
}

fn main()
{
    // Word counts: String keys, in insertion order.
    array<str, 9> words = ["to", "be", "or", "not", "to", "be", "that", "is", "it"];
    HashMap<String, u32> counts = HashMap::new();
    for (usize i = 0; i < 9; i += 1)
    {
        *HashMap::entry(&mut counts, String::from_str(words[i]), 0) += 1;
    }
    for (usize i = 0; i < HashMap::len(&counts); i += 1)
    {
        printf("%s=%d ", HashMap::key_at(&counts, i), *HashMap::value_at(&counts, i));
    }
    printf("\n");

    // remove moves the last entry into the gap; remove_ordered keeps order.
    String be = String::from_str("be");
    String that = String::from_str("that");
    printf("%d %d\n", Option::unwrap_or(HashMap::remove(&mut counts, &be), 0), Option::unwrap_or(HashMap::remove_ordered(&mut counts, &that), 0));
    for (usize i = 0; i < HashMap::len(&counts); i += 1)
    {
        printf("%s ", HashMap::key_at(&counts, i));
    }
    printf("\n");

    // Growth: many integer keys, every one still found.
    HashMap<i64, i64> sq = HashMap::new();
    for (i64 i = -500; i < 500; i += 1)
    {
        HashMap::insert(&mut sq, i, i * i);
    }
    i64 k = -321;
    printf("%d %d\n", HashMap::len(&sq), *Option::unwrap_or(HashMap::get(&sq, &k), HashMap::value_at(&sq, 0)));

    // Resource values: each destroyed once, when replaced, unused, removed, or with the map.
    HashMap<bool, Tag> tags = HashMap::new();
    HashMap::insert(&mut tags, true, Tag { .name = "yes" });
    HashMap::insert(&mut tags, false, Tag { .name = "no" });
    HashMap::insert(&mut tags, true, Tag { .name = "YES" });
    HashMap::entry(&mut tags, false, Tag { .name = "unused" });
    bool f = false;
    HashMap::remove(&mut tags, &f);
    HashSet<u8> set = HashSet::new();
    HashSet::insert(&mut set, b'a');
    HashSet::insert(&mut set, b'a');
    printf("set %d\n", HashSet::len(&set));
}
