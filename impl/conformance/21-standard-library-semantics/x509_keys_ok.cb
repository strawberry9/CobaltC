// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.x509 [Key-Der] [Key-Pem] [Sign] (D-0171); `PrivateKey`, `CertKey` and `SignatureScheme` variants, `CertKey::to_pem`, `der_read` (CHG-0265); conf.key-formats, conf.sign-verify
// kind: positive
// expect: ok
// slow: interpreted big-number arithmetic: parsing, signing and verifying keys takes minutes
// expect-stdout-hex: 
//
// Three keys openssl made (RSA 1024, P-256 in the SEC 1 form, Ed25519):
// each read from PEM gives the public key openssl wrote beside it, survives
// a DER and a PEM round trip as PKCS #8, and signs a message that
// `verify_signature` accepts under its scheme and rejects under another
// key's; garbage is `BadEncoding`. Each key's kind is read through every
// variant of `PrivateKey` and `CertKey`, the public key survives a PEM
// round trip (`CertKey::to_pem`), its DER is a SEQUENCE (`der_read`), and
// an RSA-PSS signature does not verify as PKCS #1 v1.5.

import std;

const str RSA_KEY = "-----BEGIN PRIVATE KEY-----\n"
    "MIICdgIBADANBgkqhkiG9w0BAQEFAASCAmAwggJcAgEAAoGBAMJa7a/fwjWxCYMe\n"
    "Z1oU/7Faf/U5pU7fCnMSLPUu0fb/Kek4LYvb2JI8ue+VdX29DjA9M/grIqobOgbU\n"
    "WkP/GEogbrpSvUFSktCvBqTJiFT6bTDeI3ieT7hV9uKHi8UL5NMLwc2A7EtDf+w2\n"
    "fcf7EoBI771i3mBCFD0n9gKvHQLjAgMBAAECgYA+Ztd96of+mTMGqFJit+9I0FfZ\n"
    "MoMDCdXfEGzi4/+CIHcibGkjSJkGivzgEcrBblwJ3Py8p4zftRIycyfwQQ1Y4ETk\n"
    "+MTGZYxutbtmIcbg7xPDB9kHdBbknOqbnORn5F+dWmIB+/yGO35iU36or+niwz4f\n"
    "fiSKLTP52W0at/bz0QJBAOIZ6MW6sBYopePGY90/bEhkqKRGXCC3JCbIiPsY6Azd\n"
    "X2CqDN7a1uRc5vdifhESOC/xEPCVfF1S6wF1rQFj0w0CQQDcDlZP13wpCT+e0aQD\n"
    "m2949zTLnQdO0zxGKQO8F1DO9Fq0FES7rxOT23xawqsXGy9WhTjjn8bkgo4cx/eY\n"
    "03GvAkBdeGKPY4cqEfHKgRiFvZNxNhO1ndS2PZ/3XI2saHZ94wJr/sDFXGjcDT/6\n"
    "Y0BEpGiQATOEkffQyNeYSeKUoYT9AkB6DOWoYO73X67Oqp3adlKMeCfrKswL1zMe\n"
    "As+UeiYSswq/yGIa6s7j+h9tw3zbUvOdfESCU3Mf+J1Tr0FPnS73AkEAm8ju/kTJ\n"
    "heYC2PkZ7XSN902WyvDG7uqWNDL6O0D5TYgxaHSGCwtHIMQDZ7LVomt2fBcElmD0\n"
    "lbBjPbxbgq2xcw==\n"
    "-----END PRIVATE KEY-----\n";

const str RSA_PUB = "-----BEGIN PUBLIC KEY-----\n"
    "MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDCWu2v38I1sQmDHmdaFP+xWn/1\n"
    "OaVO3wpzEiz1LtH2/ynpOC2L29iSPLnvlXV9vQ4wPTP4KyKqGzoG1FpD/xhKIG66\n"
    "Ur1BUpLQrwakyYhU+m0w3iN4nk+4Vfbih4vFC+TTC8HNgOxLQ3/sNn3H+xKASO+9\n"
    "Yt5gQhQ9J/YCrx0C4wIDAQAB\n"
    "-----END PUBLIC KEY-----\n";

const str EC_KEY = "-----BEGIN EC PRIVATE KEY-----\n"
    "MHcCAQEEIPV5Jtiw88y54+sUdXWKjugvaIsM6VhrcBjrTb8ucl7goAoGCCqGSM49\n"
    "AwEHoUQDQgAEHABTrP85kqwPdCeSL8tjqaSkOOB4G4OfR38M7Rg3BVf6jCdawa0F\n"
    "fqEsIIapOgPHESf70U1t80GiGxgJFVHOyA==\n"
    "-----END EC PRIVATE KEY-----\n";

const str EC_PUB = "-----BEGIN PUBLIC KEY-----\n"
    "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEHABTrP85kqwPdCeSL8tjqaSkOOB4\n"
    "G4OfR38M7Rg3BVf6jCdawa0FfqEsIIapOgPHESf70U1t80GiGxgJFVHOyA==\n"
    "-----END PUBLIC KEY-----\n";

const str ED_KEY = "-----BEGIN PRIVATE KEY-----\n"
    "MC4CAQAwBQYDK2VwBCIEIJt9DfzAO7tbLgwVlYU2PeFFUXoj+j5ZpA5Hv388S6oE\n"
    "-----END PRIVATE KEY-----\n";

const str ED_PUB = "-----BEGIN PUBLIC KEY-----\n"
    "MCowBQYDK2VwAyEA0+uAX+eQwvxrx1lmPGGDTBEKa9AJb0G6wzqBamnENOI=\n"
    "-----END PUBLIC KEY-----\n";

// Which kind each key is, by every variant of `PrivateKey` and `CertKey`;
// the public key's PEM round trip; the DER's outer element.
fn kinds(str label, ref<PrivateKey, shared> key, ref<CertKey, shared> public)
{
    str private_kind = match (key)
    {
        RsaPrivate(_)     : "rsa",
        EcPrivate(ec)     :
        {
            ref<EcPrivateKey, shared> k = ec;
            match (k.curve)
            {
                P256 : "ec p256",
                P384 : "ec p384",
            }
        },
        Ed25519Private(_) : "ed25519",
    };
    str public_kind = match (public)
    {
        RsaKey(_)      : "rsa",
        EcKey(ec)      :
        {
            ref<EcPublicKey, shared> k = ec;
            if (Vec::len(&k.point) == 65) { "ec 65" } else { "ec" }
        },
        Ed25519Key(_)  : "ed25519",
        UnsupportedKey : "unsupported",
    };
    String pem = Option::unwrap(CertKey::to_pem(public));
    CertKey back = Result::unwrap(CertKey::from_pem(String::as_view(&pem)));
    Vec<u8> der = Option::unwrap(CertKey::to_der(public));
    Option<Der> outer = der_read(&der[0..$], 0);
    printf(
        "%s: kinds %s/%s, public pem round trip %v, outer tag %v\n",
        label,
        private_kind,
        public_kind,
        digest_eq(&der[0..$], &Option::unwrap(CertKey::to_der(&back))[0..$]),
        match (outer)
    {
        Some(d) : d.tag,
        None    : 0,
    },
    );
}

fn check(str label, str key_pem, str pub_pem, SignatureScheme scheme)
{
    PrivateKey key = Result::unwrap(PrivateKey::from_pem(StringView::of(key_pem)));
    CertKey public = PrivateKey::public_key(&key);
    CertKey from_file = Result::unwrap(CertKey::from_pem(StringView::of(pub_pem)));
    Vec<u8> mine = Option::unwrap(CertKey::to_der(&public));
    Vec<u8> theirs = Option::unwrap(CertKey::to_der(&from_file));
    Vec<u8> der = PrivateKey::to_der(&key);
    PrivateKey again = Result::unwrap(PrivateKey::from_der(&der[0..$]));
    String pem = PrivateKey::to_pem(&key);
    PrivateKey third = Result::unwrap(PrivateKey::from_pem(String::as_view(&pem)));
    printf(
        "%s: public matches %v, der round trip %v, pem round trip %v, pem label %v\n",
        label,
        digest_eq(&mine[0..$], &theirs[0..$]),
        digest_eq(&der[0..$], &PrivateKey::to_der(&again)[0..$]),
        digest_eq(&der[0..$], &PrivateKey::to_der(&third)[0..$]),
        String::starts_with(&pem, "-----BEGIN PRIVATE KEY-----\n"),
    );
    kinds(label, &key, &public);
    Vec<u8> message = Vec::from_slice(&b"a message to sign"[0..$]);
    Vec<u8> sig = Option::unwrap(sign(&key, &scheme, &message[0..$]));
    if (String::eq_str(&String::from_str(label), "rsa"))
    {
        // A PSS signature is not a PKCS #1 v1.5 one.
        printf(
            "rsa: pkcs1 accepts the pss signature %v\n",
            verify_signature(&public, &RsaPkcs1(Sha2_256), &message[0..$], &sig[0..$]),
        );
    }
    printf(
        "%s: verifies %v, other message %v, other scheme %v\n",
        label,
        verify_signature(&public, &scheme, &message[0..$], &sig[0..$]),
        verify_signature(&public, &scheme, &message[1..$], &sig[0..$]),
        Option::is_none(&sign(&key, &UnsupportedSignature, &message[0..$])),
    );
}

fn main() : u8
{
    check("rsa", RSA_KEY, RSA_PUB, RsaPss(Sha2_256));
    check("ec", EC_KEY, EC_PUB, Ecdsa(Sha2_256));
    check("ed25519", ED_KEY, ED_PUB, Ed25519);
    printf(
        "garbage %v %v\n",
        Result::is_err(&PrivateKey::from_pem("-----BEGIN PRIVATE KEY-----\nAAAA\n-----END PRIVATE KEY-----\n")),
        Result::is_err(&CertKey::from_der(&b"nonsense"[0..$])),
    );
    0
}
