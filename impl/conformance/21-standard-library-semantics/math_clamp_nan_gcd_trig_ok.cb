// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §0 [Clamp] [Is-Nan] [Is-Finite] [Gcd] rule.arith.float-fns [Float-Transcendental] (D-0181); conf.math-clamp, conf.math-nan-finite, conf.math-gcd, conf.float-inverse-trig
// kind: positive
// expect: ok
// expect-stdout-hex: 31302030203520312e300a37206b0a747275652066616c73652066616c736520747275652066616c73652066616c73650a66616c73652074727565207472756520747275650a31322031322035203020310a36203120323235313739393831333638353234380a312e35373037393620302e30303030303020302e37383533393820302e3532333539390a7472756520747275650a
//
// `clamp` on integers, floats and text; `is_nan`/`is_finite` on floats
// and integers; `gcd` on signed and unsigned values; `asin`, `acos` and
// `atan` at the values whose results are exact or well known.

import std;

fn main()
{
    printf("%v %v %v %v\n", clamp(15, 0, 10), clamp(-3, 0, 10), clamp(5, 0, 10), clamp(2.5, 0.0, 1.0));
    printf("%v %v\n", clamp(7: u8, 7, 7), clamp("m", "a", "k"));
    f64 nan = 0.0 / 0.0;
    f64 inf = 1.0 / 0.0;
    printf(
        "%v %v %v %v %v %v\n",
        is_nan(nan),
        is_nan(1.0),
        is_nan(3),
        is_finite(1.5),
        is_finite(inf),
        is_finite(0.0 - inf),
    );
    printf("%v %v %v %v\n", is_finite(nan), is_finite(42), is_finite(max_value<i64>()), is_nan(0.0: f32 / 0.0));
    printf("%v %v %v %v %v\n", gcd(84, 36), gcd(-84, 36), gcd(0, 5), gcd(0, 0), gcd(17: u64, 5));
    printf("%v %v %v\n", gcd(12: i8, -18), gcd(1_000_000_007: u64, 998_244_353), gcd(2: u128 << 100, 2 << 50));
    printf("%.6f %.6f %.6f %.6f\n", asin(1.0), acos(1.0), atan(1.0), asin(0.5: f32));
    printf("%v %v\n", is_nan(asin(2.0)), atan(1.0 / 0.0) * 2.0 == acos(-1.0));
}
