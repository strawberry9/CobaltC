// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.prelude rule.module.resolve [Resolve-Unbound] (D-0198); conf.std-text-has-no-hex
// kind: negative
// expect: diag.unbound-name (static)
//
// `std::text` is text: `to_hex` is in `std::encoding::hex` (D-0198), so
// importing `std::text` alone does not name it.

import std::text;
import std::io;

fn main()
{
    array<u8, 1> b = [1];
    printf("%v\n", &to_hex(&b[0..$]));
}
