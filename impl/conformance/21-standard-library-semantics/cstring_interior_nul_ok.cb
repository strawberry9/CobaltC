// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.ffi `CString::new`, `CString::from_bytes`, `NulError` (D-0252); conf.cstring-interior-nul
// kind: positive
// expect: ok
// expect-stdout-hex: 4e554c20617420323a20686f6c64732061204e554c20627974650a4e554c20617420300a
//
// Text that already holds a NUL would end early in C, so `CString::new`
// refuses it with the NUL's position.

import std;

fn main()
{
    match (CString::new("ab\0cd"))
    {
        Ok(_)  : printf("accepted\n"),
        Err(e) : printf("NUL at %d: %s\n", e.offset, NulError::text(&e)),
    }
    Vec<u8> b = Vec::new();
    Vec::push(&mut b, 0: u8);
    match (CString::from_bytes(&b[0 .. 1]))
    {
        Ok(_)  : printf("accepted\n"),
        Err(e) : printf("NUL at %d\n", e.offset),
    }
}
