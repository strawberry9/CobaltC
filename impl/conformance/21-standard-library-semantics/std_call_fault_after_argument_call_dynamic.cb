// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: diag.index-out-of-bounds [Call]; CHG-0362; conf.std-call-fault-after-argument-call
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// A `std` call whose arguments call a function of the program: the
// arguments run first (and print), then the call's own check faults, and
// the fault is reported at the call, not inside the function an argument
// called.

import std;

fn pick(u64 k) : usize
{
    printf("pick\n");
    narrow<usize>(k)
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::swap(&mut v, pick(0), pick(5));
}
