// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [P256-Ecdh] (D-0165); conf.p256-ecdh-vectors, conf.p256-ecdh-refusals
// kind: positive
// expect: ok
// slow: interpreted big-number arithmetic takes well over the 10-second budget
// expect-stdout-hex: 
//
// RFC 5903 §8.1's P-256 exchange: the public key of i is g^i, and i with
// the peer's g^r gives g^ir's x-coordinate. A key of zero or of n is no
// private key; a peer point off the curve, compressed, or the wrong length
// is refused before any multiplication.

import std;

fn bytes(str hex) : Vec<u8>
{
    Result::unwrap_or(from_hex(StringView::of(hex)), Vec::new())
}

fn main() : u8
{
    Vec<u8> i = bytes("c88f01f510d9ac3f70a292daa2316de544e9aab8afe84049c62a9c57862d1433");
    Vec<u8> gr = bytes(
        "04d12dfb5289c8d4f81208b70270398c342296970a0bccb74c736fc7554494bf6356fbf3ca366cc23e8157854c13c58d6aac23f046ada30f8353e74f33039872ab",
    );
    match (p256_public_key(&i[0..$]))
    {
        Some(q) : printf("g^i: %s\n", &to_hex(&q[0..$])),
        None    : printf("g^i: none\n"),
    }
    match (p256_ecdh(&i[0..$], &gr[0..$]))
    {
        Some(z) : printf("g^ir x: %s\n", &to_hex(&z[0..$])),
        None    : printf("g^ir: none\n"),
    }
    array<u8, 32> zero = [0; 32];
    Vec<u8> n = bytes("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551");
    printf(
        "zero refused: %v, n refused: %v\n",
        Option::is_none(&p256_public_key(&zero[0..$])),
        Option::is_none(&p256_ecdh(&n[0..$], &gr[0..$])),
    );
    Vec<u8> off = Vec::clone(&gr);
    off[64] = off[64] ^ 1;
    Vec<u8> compressed = Vec::from_slice(&gr[0..33]);
    compressed[0] = 0x03;
    printf(
        "off the curve refused: %v, compressed refused: %v, short refused: %v\n",
        Option::is_none(&p256_ecdh(&i[0..$], &off[0..$])),
        Option::is_none(&p256_ecdh(&i[0..$], &compressed[0..$])),
        Option::is_none(&p256_ecdh(&i[0..$], &gr[0..64])),
    );
    0
}
