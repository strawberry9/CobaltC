// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.process [Child-Streams] [Output] (D-0143); conf.process-closed-pipe
// kind: positive
// expect: ok
// expect-stdout-hex: 
// platform: unix
//
// A write to a child that has ended is `Err(Io)`, and a program that
// exits without reading its input still gives `output_with_input` its
// status: neither ends this program (on Unix the broken pipe raises
// SIGPIPE, which a first compiled version died of).

import std;

fn main() : u8
{
    Command sh = Command::new("/bin/sh");
    Command::arg(&mut sh, "-c");
    Command::arg(&mut sh, "exit 0");
    Child c = match (Command::spawn(&sh))
    {
        Ok(c)  : c,
        Err(_) : return 1,
    };
    printf("ended: %d\n", Result::unwrap_or(Child::wait(&mut c), 99));
    Vec<u8> big = Vec::filled(100_000, 120: u8);
    match (Child::write_input(&mut c, &big[0..$]))
    {
        Ok(_)  : printf("write_input after wait: ok\n"),
        Err(e) : printf("write_input after wait: %s\n", FileError::text(&e)),
    }
    Child d = match (Command::spawn(&sh))
    {
        Ok(c)  : c,
        Err(_) : return 2,
    };
    sleep_ms(200);
    match (Child::write_input(&mut d, &big[0..$]))
    {
        Ok(_)  : printf("write_input to a child that has ended: ok\n"),
        Err(e) : printf("write_input to a child that has ended: %s\n", FileError::text(&e)),
    }
    printf("its status: %d\n", Result::unwrap_or(Child::wait(&mut d), 99));
    Command five = Command::new("/bin/sh");
    Command::arg(&mut five, "-c");
    Command::arg(&mut five, "exit 5");
    match (Command::output_with_input(&five, &big[0..$]))
    {
        Ok(o)  : printf("exit 5 without reading its input: status %d, %u bytes out\n", o.status, Vec::len(&o.stdout)),
        Err(e) : printf("exit 5 without reading its input: %s\n", FileError::text(&e)),
    }
    printf("still running\n");
    0
}
