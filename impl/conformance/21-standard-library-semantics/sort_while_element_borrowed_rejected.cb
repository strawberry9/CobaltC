// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.sort [Sort] (an exclusive borrow of the Vec); rule.alias.borrow; D-0062; conf.sort-element-borrowed
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// Sorting borrows the Vec exclusively: a reference to an element still
// in use afterwards conflicts.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 2);
    Vec::push(&mut v, 1);
    ref<i32, shared> first = &v[0];
    Vec::sort(&mut v);
    i32 x = *first;
}
