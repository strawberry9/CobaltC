// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str [Str-Literal] (D-0304): `auto` gives no position; conf.str-literal-string-auto-is-str
// kind: positive
// expect: ok
// stdout: 3
//
// `auto s = "abc";` declares a `str`: no type is written, so the literal
// keeps its own.

import std;

fn main()
{
    auto s = "abc";
    printf("%d\n", str_len(s));
}
