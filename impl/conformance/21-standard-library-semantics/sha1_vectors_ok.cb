// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Sha1] [Hmac] [Hash-Kind] (D-0181); conf.sha1, conf.hmac-sha1
// kind: positive
// expect: ok
// slow: long hash vectors under the interpreter take a minute
// expect-stdout-hex: 
//
// FIPS 180-4's SHA-1 vectors ("abc", the empty message, the 56-byte
// message, a million `a`s), `Hasher` and `hash` over `Sha1`, RFC 2202's
// HMAC-SHA-1 vectors, PBKDF2 over SHA-1 (RFC 6070), and the RFC 6238
// time-based one-time password with the default HMAC-SHA-1.

import std;

fn main()
{
    printf("%v\n", &to_hex(&sha1(&b"abc"[0..$])[0..$]));
    Vec<u8> none = Vec::new();
    printf("%v\n", &to_hex(&sha1(&none[0..$])[0..$]));
    printf("%v\n", &to_hex(&sha1(&b"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"[0..$])[0..$]));
    Sha1 s = Sha1::new();
    Vec<u8> chunk = Vec::filled(1000, b'a');
    foreach (i in 0..1000)
    {
        Sha1::update(&mut s, &chunk[0..$]);
    }
    printf("%v\n", &to_hex(&Sha1::finish(s)[0..$]));
    Hasher h = Hasher::new(Sha1);
    Hasher::update(&mut h, &b"ab"[0..$]);
    Hasher::update(&mut h, &b"c"[0..$]);
    printf("%v %v\n", &to_hex(&Hasher::finish(h)[0..$]), Vec::len(&hash(Sha1, &b"x"[0..$])));
    printf("%v\n", &to_hex(&hmac(Sha1, &b"key"[0..$], &b"The quick brown fox jumps over the lazy dog"[0..$])[0..$]));
    Vec<u8> k = Vec::filled(20, 0x0b: u8);
    printf("%v\n", &to_hex(&hmac(Sha1, &k[0..$], &b"Hi There"[0..$])[0..$]));
    Vec<u8> k80 = Vec::filled(80, 0xaa: u8);
    printf(
        "%v\n",
        &to_hex(&hmac(Sha1, &k80[0..$], &b"Test Using Larger Than Block-Size Key - Hash Key First"[0..$])[0..$]),
    );
    printf("%v\n", &to_hex(&pbkdf2(Sha1, &b"password"[0..$], &b"salt"[0..$], 2, 20)[0..$]));
    // RFC 6238 appendix B: the SHA-1 secret "12345678901234567890" at
    // time 59 (counter 1) gives 94287082.
    Vec<u8> counter = Vec::new();
    Vec::push_be(&mut counter, 1: u64);
    Vec<u8> mac = hmac(Sha1, &b"12345678901234567890"[0..$], &counter[0..$]);
    usize off = widen<usize>(mac[19] & 0x0F);
    u32 code = (read_be<u32>(&mac[0..$], off) & 0x7FFFFFFF) % 100000000;
    printf("%08u\n", code);
}
