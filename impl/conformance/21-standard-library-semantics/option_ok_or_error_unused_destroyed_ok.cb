// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: `Option::ok_or` (D-0114); conf.option-ok-or-error-unused-destroyed
// kind: positive
// expect: ok
//
// The error argument is evaluated before the call, whichever variant `o`
// holds; on `Some` it is unused and destroyed at the statement's end, on
// `None` it is the `Err` payload and lives on.

import std;

resource struct Noisy
{
    u32 id;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("drop %d\n", self.id);
}

fn pick(Option<i32> o, u32 id) : Result<i32, Noisy>
{
    i32 v = Option::ok_or(o, Noisy { .id = id })?;      // Some: Noisy dropped here; None: returned
    printf("got %d\n", v);
    Ok(v)
}

fn main()
{
    match (pick(Some(3), 1)) { Ok(v) : assert(v == 3), Err(_) : assert(false), }   // drop 1, got 3
    match (pick(None, 2)) { Ok(_) : assert(false), Err(n) : assert(n.id == 2), }   // drop 2 after the arm
    printf("end\n");
}
