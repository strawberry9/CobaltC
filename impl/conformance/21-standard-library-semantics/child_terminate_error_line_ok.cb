// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.process [Child-Terminate] [Child-Streams] (D-0181); conf.child-terminate, conf.child-read-error-line
// kind: positive
// expect: ok
// platform: unix
// expect-stdout-hex: 6f6e650a74776f0a74687265650a6f75740a2d313520747275650a747275650a
//
// `read_error_line` reads the child's standard error a line at a time
// (and `read_error` takes what was read ahead); `terminate` sends
// SIGTERM, which `wait` reports as -15, and does nothing to a child that
// has ended.

import std;

fn main()
{
    Command c = Command::new("sh");
    Command::arg(&mut c, "-c");
    Command::arg(&mut c, "echo one >&2; printf 'two\\r\\nthree' >&2; echo out; sleep 5");
    Child ch = Result::unwrap(Command::spawn(&c));
    printf("%v\n", &Option::unwrap_or(Result::unwrap(Child::read_error_line(&mut ch)), String::new()));
    printf("%v\n", &Option::unwrap_or(Result::unwrap(Child::read_error_line(&mut ch)), String::new()));
    Vec<u8> rest = Vec::new();
    _ = Child::read_error(&mut ch, &mut rest, 100);
    printf("%v\n", &Result::unwrap(String::from_utf8(rest)));
    printf("%v\n", &Option::unwrap_or(Result::unwrap(Child::read_output_line(&mut ch)), String::new()));
    _ = Child::terminate(&mut ch);
    i32 status = Result::unwrap(Child::wait(&mut ch));
    printf("%v %v\n", status, Result::is_ok(&Child::terminate(&mut ch)));
    printf("%v\n", Option::is_none(&Result::unwrap(Child::read_error_line(&mut ch))));
}
