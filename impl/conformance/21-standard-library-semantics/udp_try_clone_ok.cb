// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.net `UdpSocket::try_clone` (D-0205); conf.udp-try-clone
// kind: positive
// expect: ok
// expect-stdout-hex: 72656365697665643a20746f207468652077616974696e672068616e646c650a66726f6d207468652073616d6520616464726573733a20747275650a
//
// A clone of a UDP socket is the same socket: a thread waits for datagrams
// on one handle while the main thread sends on the other, from the same
// address.

import std;

fn waiter(UdpSocket s) : String
{
    Datagram { data, from } = Result::unwrap(UdpSocket::recv_from(&mut s, 64));
    Result::unwrap(String::from_utf8(data))
}

fn main()
{
    UdpSocket a = Result::unwrap(UdpSocket::bind(SocketAddr::new(IpAddr::localhost_v4(), 0)));
    UdpSocket b = Result::unwrap(UdpSocket::bind(SocketAddr::new(IpAddr::localhost_v4(), 0)));
    SocketAddr at_b = UdpSocket::local_addr(&b);
    UdpSocket a2 = Result::unwrap(UdpSocket::try_clone(&a));
    auto h = spawn(waiter, a);
    _ = Result::unwrap(UdpSocket::send_to(
        &mut b,
        StringView::as_bytes("to the waiting handle"),
        UdpSocket::local_addr(&a2),
    ));
    printf("received: %s\n", &join(h));
    _ = Result::unwrap(UdpSocket::send_to(&mut a2, StringView::as_bytes("from the clone"), at_b));
    Datagram d = Result::unwrap(UdpSocket::recv_from(&mut b, 64));
    printf("from the same address: %v\n", SocketAddr::text(&d.from) == SocketAddr::text(&UdpSocket::local_addr(&a2)));
}
