// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.process [Command] [Output] [Status] (D-0143); conf.process-output, conf.process-input, conf.process-status, conf.process-signal-status, conf.process-not-found, conf.process-dir-env
// kind: positive
// expect: ok
// expect-stdout-hex: 
// platform: unix
//
// Programs every Unix system has, run with no shell between: arguments
// reach `echo` as given (one with a space stays one); `sh -c` is asked for
// by name. `output` captures both streams and the status (3); a signal's
// status is minus its number (-9); a missing program is `NotFound`;
// `output_with_input` feeds `cat`; `current_dir` and `clear_env` with
// `env` change where and with what the child starts.

import std;

fn show(ref<Command, shared> c)
{
    match (Command::output(c))
    {
        Ok(o)  :
        {
            String out = Result::unwrap_or(String::from_utf8(Vec::clone(&o.stdout)), String::new());
            String err = Result::unwrap_or(String::from_utf8(Vec::clone(&o.stderr)), String::new());
            printf("status %d, stdout [%s], stderr [%s]\n", o.status, &out, &err);
        },
        Err(e) : printf("error: %s\n", FileError::text(&e)),
    }
}

fn main()
{
    Command echo = Command::new("/bin/echo");
    Command::arg(&mut echo, "hello");
    Command::arg(&mut echo, "two words");
    show(&echo);
    Command sh = Command::new("/bin/sh");
    Command::arg(&mut sh, "-c");
    Command::arg(&mut sh, "echo out; echo err >&2; exit 3");
    show(&sh);
    Command k = Command::new("/bin/sh");
    Command::arg(&mut k, "-c");
    Command::arg(&mut k, "kill -9 $$");
    match (Command::status(&k))
    {
        Ok(s)  : printf("killed by a signal: status %d\n", s),
        Err(e) : printf("error: %s\n", FileError::text(&e)),
    }
    Command none = Command::new("/surely/not/a/program");
    show(&none);
    match (Command::status(&none))
    {
        Err(NotFound) : printf("status: NotFound\n"),
        _             : printf("status: ?\n"),
    }
    Command cat = Command::new("/bin/cat");
    match (Command::output_with_input(&cat, &b"fed through standard input\n"[0..$]))
    {
        Ok(o)  :
        {
            String out = Result::unwrap_or(String::from_utf8(Vec::clone(&o.stdout)), String::new());
            printf("cat: %s", &out);
        },
        Err(e) : printf("cat: %s\n", FileError::text(&e)),
    }
    Command pwd = Command::new("/bin/sh");
    Command::arg(&mut pwd, "-c");
    Command::arg(&mut pwd, "pwd");
    Command::current_dir(&mut pwd, "/");
    show(&pwd);
    Command env = Command::new("/bin/sh");
    Command::arg(&mut env, "-c");
    Command::arg(&mut env, "echo \"X=$X HOME=$HOME\"");
    Command::clear_env(&mut env);
    Command::env(&mut env, "X", "42");
    show(&env);
}
