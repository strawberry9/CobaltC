// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.swap [Swap-Places]; D-0235; CHG-0371; conf.replace-values
// kind: positive
// expect: ok
// expect-stdout-hex: 31203220330a330a31203220332034203520360a7820790a3120320a
//
// `replace(r, v)` returns the old value and leaves `v` in the place, for a
// number, a struct of plain data, a `String` and a `Vec`, through a fresh
// borrow and through a reference passed on whole once the shared reborrow
// beside it has ended.

import std;

struct P
{
    i32 a;
    i32 b;
}

fn main()
{
    i32 n = 1;
    i32 n0 = replace(&mut n, 2);
    auto rn = &mut n;
    i32 n1 = replace(rn, 3);
    printf("%v %v %v\n", n0, n1, n);

    P p = P { .a = 1, .b = 2 };
    P p0 = replace(&mut p, P { .a = 3, .b = 4 });
    auto rp = &mut p;
    {
        auto s = &(*rp).a;
        printf("%v\n", *s);
    }
    P p1 = replace(rp, P { .a = 5, .b = 6 });
    printf("%v %v %v %v %v %v\n", p0.a, p0.b, p1.a, p1.b, p.a, p.b);

    String t = String::from_str("x");
    String t0 = replace(&mut t, String::from_str("y"));
    printf("%v %v\n", String::as_view(&t0), String::as_view(&t));

    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec<i32> w = Vec::new();
    Vec::push(&mut w, 2);
    Vec::push(&mut w, 3);
    Vec<i32> v0 = replace(&mut v, w);
    printf("%v %v\n", Vec::len(&v0), Vec::len(&v));
}
