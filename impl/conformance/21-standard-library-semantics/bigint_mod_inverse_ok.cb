// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.bigint [Big-Mod-Inverse] (D-0169); conf.bigint-mod-inverse
// kind: positive
// expect: ok
// expect-stdout-hex: 340a7472756520747275650a310a747275650a
//
// 3⁻¹ mod 11 is 4; 6 has no inverse mod 9, nor anything mod 1; a 200-bit
// inverse multiplied back is 1; clone copies the value.

import std;

fn main() : u8
{
    BigUint three = BigUint::from_u64(3);
    BigUint eleven = BigUint::from_u64(11);
    printf("%s\n", &BigUint::text(&Option::unwrap(BigUint::mod_inverse(&three, &eleven))));
    printf(
        "%v %v\n",
        Option::is_none(&BigUint::mod_inverse(&BigUint::from_u64(6), &BigUint::from_u64(9))),
        Option::is_none(&BigUint::mod_inverse(&three, &BigUint::from_u64(1))),
    );
    BigUint a = Result::unwrap_or(
        BigUint::parse("1234567890123456789012345678901234567890123456789012345678901"),
        BigUint::zero(),
    );
    BigUint m = Result::unwrap_or(
        BigUint::parse("1606938044258990275541962092341162602522202993782792835301611"),
        BigUint::zero(),
    );
    BigUint inv = Option::unwrap(BigUint::mod_inverse(&a, &m));
    printf("%s\n", &BigUint::text(&BigUint::rem(&BigUint::mul(&a, &inv), &m)));
    BigUint c = BigUint::clone(&a);
    printf("%v\n", BigUint::eq(&a, &c));
    0
}
