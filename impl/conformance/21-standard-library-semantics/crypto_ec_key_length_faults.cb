// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Crypto-Length] (D-0168); conf.ec-key-length
// kind: negative
// expect: diag.crypto-length (dynamic)
//
// A 32-byte private key on P-384 is no key of that curve's length.

import std;

fn main() : u8
{
    array<u8, 32> k = [1; 32];
    printf("%v\n", Option::is_some(&ec_public_key(P384, &k[0..$])));
    0
}
