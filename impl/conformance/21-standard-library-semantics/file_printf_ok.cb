// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.file-handle [File-Printf]; rule.stdlib.format; D-0059; conf.file-printf
// kind: positive
// expect: ok
// expect-stdout-hex: 7769646765743a20202020343220756e69747320617420332e31340a706c61696e206c696e650a74727565202d372066660a726561642d6f6e6c793a20496f0a
// args: $TMP
//
// `File::printf(&mut f, format, …)` writes formatted text to a file, as
// `String::appendf` appends it to a `String`: widths, precision, `%v`,
// `%x`; an empty format writes nothing; on a file opened for reading it
// is `Err(Io)`.

import std;

fn main() : u8
{
    String dir = Result::unwrap_or(arg(0), String::new());
    String p = sprintf("%s/out.txt", &dir);
    File f = match (File::create(&p[0..$]))
    {
        Ok(f)  : f,
        Err(_) : return 1,
    };
    String name = String::from_str("widget");
    match (File::printf(&mut f, "%s: %5d units at %.2f\n", &name, 42, 3.14159))
    {
        Ok(_)  :
        {
        },
        Err(_) : return 2,
    }
    Result::unwrap_or(File::printf(&mut f, "plain line\n"), ());
    Result::unwrap_or(File::printf(&mut f, "%v %v %x\n", true, -7, 255), ());
    Result::unwrap_or(File::printf(&mut f, ""), ());
    Result::unwrap_or(File::close(f), ());
    String back = Result::unwrap_or(read_file(&p[0..$]), String::new());
    printf("%s", &back);
    File ro = match (File::open(&p[0..$]))
    {
        Ok(f)  : f,
        Err(_) : return 3,
    };
    match (File::printf(&mut ro, "x"))
    {
        Ok(_)   : printf("?\n"),
        Err(Io) : printf("read-only: Io\n"),
        Err(_)  : printf("other\n"),
    }
    0
}
