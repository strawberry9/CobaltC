// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.box (`Box::get_mut` takes the box exclusively through its reference, D-0222, CHG-0261); conf.box-get-mut-while-box-shared
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// As `conf.vec-index-exclusive-while-container-shared`, for a `Box`:
// `Box::get_mut(b)` read the box's pointer through `b` and handed out an
// exclusive reference to its value, which then changed under the shared
// `s`. Its body now accesses the box exclusively through `b`
// (`_ = &mut *b;`, D-0222), which meets `s`.
//
// D-0282: the static pass rejects this program before it runs (it was found
// at run time before): `set` writes `*r` through argument 1 while `s` still
// borrows `*r`.

import std;

fn set(ref<Box<i32>, exclusive> b, i32 x)
{
    *Box::get_mut(b) = x;
}

fn main()
{
    Box<i32> w = Box::new(1);
    auto r = &mut w;
    auto s = &*r;
    set(r, 9);
    printf("%v\n", *Box::get(s));
}
