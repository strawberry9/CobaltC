// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.type.probe `probe<K>` (D-0312): an integer key is its own probe, so a reference to one is no probe; conf.probe-int-key-by-reference-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//

import std;

fn main()
{
    HashMap<i32, i32> m = HashMap::new();
    HashMap::insert(&mut m, 1, 2);
    i32 k = 1;
    bool b = HashMap::contains(&m, &k);
}
