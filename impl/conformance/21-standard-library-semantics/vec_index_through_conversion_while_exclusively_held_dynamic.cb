// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: D-0018 rule.alias.borrow [Borrow-Denied]; conf.vec-index-through-conversion-while-exclusively-held-dynamic
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// A shared element access whose index is a conversion that cannot fail,
// made while another Vec holds an exclusive reference to the vector,
// conflicts with that reference at the borrow of `&v`.
//
// D-0290: the reference is stored by a call (`keep_in`), so the frame holds it
// only as `?` (it may hold none of it), and the run checks the access; the
// same program storing it directly is refuted before the run.

import std;

fn keep_in(ref<Vec<ref<Vec<u32>, exclusive>>, exclusive> keep, ref<Vec<u32>, exclusive> r)
{
    Vec::push(keep, r);
}

fn main()
{
    Vec<u32> v = Vec::new();
    Vec::push(&mut v, 7);
    u64 k = 0;
    Vec<ref<Vec<u32>, exclusive>> h = Vec::new();
    keep_in(&mut h, &mut v);
    u32 x = *Vec::index_shared(&v, narrow<usize>(k));
}
