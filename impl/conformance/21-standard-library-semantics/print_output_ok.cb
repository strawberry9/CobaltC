// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.print [Print] [Print-Int] [Print-Float] (conf.print-output)
// kind: positive
// expect: ok
//
// `print` writes every printable type. Its exact output is checked by
// impl/tests/print_output.rs, and `cobc`'s against `coby`'s by the
// compiled suite.

import std;

fn show<T>(T x)
{
    printf("%v\n", x);
}

fn main()
{
    show("text");
    show(-42);
    show(0);
    show(max_value<u128>());
    show(min_value<i128>());
    show(true);
    show(false);
    show(0.1);
    show(1.0);
    show(-0.0);
    show(1.0 / 3.0);
    show(0.000001);
    show(0.0000001);
    show(100000000000000000000.0);
    show(1000000000000000000000.0);
    show(161305489493093.125);
    f64 z = 0.0;
    show(z / z);
    show(1.0 / z);
    show(-1.0 / z);
    show(0.1: f32);
    show(1.0: f32 / 3.0: f32);
    String s = String::from_str("owned");
    show(&s);
}
