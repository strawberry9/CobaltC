// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: `[Rng]` (D-0120); conf.rng-check-values, conf.rng-below-range, conf.rng-unit-range
// kind: positive
// expect: ok
//
// The normative sequence's check values; `below` in range and unbiased
// over a run; `unit_f64` in [0, 1). An independent model (Python, in
// stress/drafts-f5/) gives the same numbers.

import std;

fn main()
{
    Rng r = Rng::new(42);
    assert(Rng::next_u64(&mut r) == 1546998764402558742);
    assert(Rng::next_u64(&mut r) == 6990951692964543102);
    assert(Rng::next_u64(&mut r) == 12544586762248559009);
    Rng z = Rng::new(0);
    assert(Rng::next_u64(&mut z) == 11091344671253066420);
    Rng b = Rng::new(42);
    assert(Rng::below(&mut b, 10) == 2 && Rng::below(&mut b, 10) == 2 && Rng::below(&mut b, 6) == 5);
    assert(Rng::below(&mut b, 1000000007) == 779106270 && Rng::below(&mut b, 1) == 0);
    Rng f = Rng::new(42);
    f64 u = Rng::unit_f64(&mut f);
    assert(u == 0.083862971059882163);

    Rng g = Rng::new(7);
    array<u32, 6> counts = [0, 0, 0, 0, 0, 0];
    foreach (k in 0..6000)
    {
        u64 v = Rng::below(&mut g, 6);
        assert(v < 6);
        counts[narrow<usize>(v)] += 1;
        f64 x = Rng::unit_f64(&mut g);
        assert(x >= 0.0 && x < 1.0);
    }
    foreach (c in &counts)
    {
        assert(*c > 800 && *c < 1200);                     // each face about a sixth of 6000
    }
    Rng again = Rng::new(7);
    Rng same = Rng::new(7);
    assert(Rng::next_u64(&mut again) == Rng::next_u64(&mut same));
    printf("ok\n");
}
