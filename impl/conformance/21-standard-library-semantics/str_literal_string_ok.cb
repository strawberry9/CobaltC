// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str `[Str-Literal-String]` (D-0149); conf.str-literal-as-string
// kind: positive
// expect: ok
// expect-stdout-hex: 6d7920737472696e6773203130207c206164612033207c2068657921207c2068656c6c6f2074686572650a7a65726f206f6e652074776f206d616e79207461696c0a7374696c6c2061207374722031310a
//
// A literal where a `String` is declared is `String::from_str` of it: as
// a local's initializer, a struct literal's field, an argument whose
// parameter is a `String`, a `str` constant's use, and what a function
// declared `: String` returns (`return`, the tail, an `if` branch, a
// `match` arm). Each is an owned `String`: it can be appended to and
// its length asked. `auto` keeps a literal a `str`.

import std;

const str GREETING = "hello";

struct Named
{
    String name;
    i32 n;
}

fn shout(String s) : String
{
    String::append(&mut s, "!");
    s
}

fn pick(i32 k) : String
{
    if (k == 0)
    {
        return "zero";
    }
    match (k)
    {
        1 : "one",
        2 : if (true) { "two" } else { "not two" },
        _ : "many",
    }
}

fn plain() : String
{
    "tail"
}

fn main() : u8
{
    String s = "my string";
    String::append(&mut s, "s");
    Named a = Named { .name = "ada", .n = 1 };
    String g = GREETING;
    String::append(&mut g, " there");
    printf("%s %u | %s %u | %s | %s\n", &s, String::len(&s), &a.name, String::len(&a.name), &shout("hey"), &g);
    printf("%s %s %s %s %s\n", &pick(0), &pick(1), &pick(2), &pick(7), &plain());
    auto t = "still a str";
    printf("%s %u\n", t, str_len(t));
    0
}
