// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.args [Arg-Bytes]; arg; conf.arg-invalid-utf8
// kind: positive
// expect: ok
// args: a\xffb ok
// expect-stdout-hex: 310a6f6b0a
//
// Argument 0 is `a`, the byte 0xFF, `b`: not UTF-8, so `arg(0)` is
// `Err(e)` with `e.offset = 1`, the bad byte's offset. Argument 1 is
// unaffected: `arg(1)` is `Ok(ok)`. Prints `1` and `ok`.

import std;

fn main()
{
    match (arg(0))
    {
        Ok(_) :
        {
            1 / (1 - 1);
        },
        Err(e) :
        {
            printf("%v\n", e.offset);
        },
    }
    match (arg(1))
    {
        Ok(s) :
        {
            printf("%v\n", &s);
        },
        Err(_) :
        {
            1 / (1 - 1);
        },
    }
}
