// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.net [Udp] (D-0144); conf.net-udp-truncate
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// `recv_from(u, max)` of a datagram longer than `max` gives exactly its
// first `max` bytes and the sender; the rest of that datagram is lost and
// the next one follows whole. (A first version gave more bytes than asked
// for, some of them not the datagram's.)

import std;

fn receive(ref<UdpSocket, exclusive> b, ref<UdpSocket, shared> a, usize max)
{
    match (UdpSocket::recv_from(b, max))
    {
        Ok(d)  :
        {
            bool prefix = true;
            for (usize i = 0; i < Vec::len(&d.data); i += 1)
            {
                prefix = prefix && d.data[i] == 65 + narrow<u8>(i % 26);
            }
            printf(
                "max %u: %u bytes, the datagram's first: %v, from the sender: %v\n",
                max,
                Vec::len(&d.data),
                prefix,
                d.from.port == UdpSocket::local_addr(a).port,
            );
        },
        Err(e) : printf("max %u: %s\n", max, NetError::text(&e)),
    }
}

fn main() : u8
{
    UdpSocket a = match (UdpSocket::bind(SocketAddr::new(IpAddr::localhost_v4(), 0)))
    {
        Ok(u)  : u,
        Err(_) : return 1,
    };
    UdpSocket b = match (UdpSocket::bind(SocketAddr::new(IpAddr::localhost_v4(), 0)))
    {
        Ok(u)  : u,
        Err(_) : return 2,
    };
    UdpSocket::set_read_timeout_ms(&mut b, 5000);
    Vec<u8> big = Vec::new();
    for (usize i = 0; i < 100; i += 1)
    {
        Vec::push(&mut big, 65 + narrow<u8>(i % 26));
    }
    SocketAddr to = UdpSocket::local_addr(&b);
    array<usize, 5> sizes = [10, 90, 99, 100, 1000];
    foreach (max in &sizes)
    {
        _ = UdpSocket::send_to(&mut a, &big[0..$], to);
        receive(&mut b, &a, *max);
    }
    // `max` 0 takes the whole datagram and keeps none of it; the next
    // datagram follows whole.
    _ = UdpSocket::send_to(&mut a, &big[0..$], to);
    receive(&mut b, &a, 0);
    _ = UdpSocket::send_to(&mut a, &big[0..$], to);
    receive(&mut b, &a, 50);
    0
}
