// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `swap`; conf.vec-swap-beside-held-element
// kind: positive
// expect: ok
// expect-stdout-hex: 6265666f726520310a616674657220320a
//
// The same reference to v[0] beside Vec::swap(&mut v, 1, 2): neither
// element it borrows is v[0], so nothing clashes and the reference still
// reads 2.

import std;

fn main() : u8
{
    Vec<i64> v = Vec::filled(4, 2: i64);
    v[2] = 1;
    Vec::reserve(&mut v, 10);
    Vec<ref<i64, shared>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &v[0]);
    }
    printf("before %v\n", Vec::len(&held));
    Vec::swap(&mut v, 1, 2);
    printf("after %v\n", *held[0]);
    0
}
