// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview `&s` as a view, `StringView::len` (D-0134); conf.as-view-argument
// kind: positive
// expect: ok
//
// `&s` passed straight to functions that only read the
// view, alone and beside other arguments (other views, plain values, a
// call), in a loop and after the String has changed: each view is of the
// String as it is at that call.

import std;

fn len2(StringView a, StringView b, usize n) : usize
{
    StringView::len(a) + StringView::len(b) + n
}

fn is_world(StringView v) : bool
{
    v == "world!"
}

fn main()
{
    String s = "hello";
    String t = "world!";
    assert(len2(&s, &t, 3) == 14);
    assert(StringView::len(&s) == 5);
    usize total = 0;
    foreach (i in 0..1000)
    {
        total += len2(&s, "x", i % 2);
    }
    assert(total == 6500);
    String::append(&mut s, "!!");
    Vec<i64> v = Vec::new();
    Vec::push(&mut v, 1);
    assert(len2(&s, &t, Vec::len(&v)) == 14);
    assert(is_world(&t));
    assert(!is_world(&s));
    printf("ok\n");
}
