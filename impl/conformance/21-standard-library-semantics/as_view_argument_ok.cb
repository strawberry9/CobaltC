// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview `String::as_view`, `StringView::len` (D-0134)
// kind: positive
// expect: ok
//
// `String::as_view(&s)` passed straight to functions that only read the
// view, alone and beside other arguments (other views, plain values, a
// call), in a loop and after the String has changed: each view is of the
// String as it is at that call.

import std;

fn len2(StringView a, StringView b, usize n) : usize
{
    StringView::len(a) + StringView::len(b) + n
}

fn is_world(StringView v) : bool
{
    StringView::eq_str(v, "world!")
}

fn main()
{
    String s = String::from_str("hello");
    String t = String::from_str("world!");
    assert(len2(String::as_view(&s), String::as_view(&t), 3) == 14);
    assert(StringView::len(String::as_view(&s)) == 5);
    usize total = 0;
    foreach (i in 0..1000)
    {
        total += len2(String::as_view(&s), StringView::of("x"), i % 2);
    }
    assert(total == 6500);
    String::append(&mut s, "!!");
    Vec<i64> v = Vec::new();
    Vec::push(&mut v, 1);
    assert(len2(String::as_view(&s), String::as_view(&t), Vec::len(&v)) == 14);
    assert(is_world(String::as_view(&t)));
    assert(!is_world(String::as_view(&s)));
    printf("ok\n");
}
