// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.time [From-Iso] [To-Iso] (D-0140); conf.datetime-iso
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// `from_iso` reads what `to_iso` writes and a bare date, and nothing
// else: each `ParseError` with the byte it names. A fraction of the
// seconds is read and dropped (D-0181). A 30 February, a second 60 and a
// month 13 name no moment (`OutOfRange`); a lower-case `z`, an offset, a
// short field and an unsigned five-digit year do not fit (`Invalid`).

import std;

fn main()
{
    foreach (s in [
        "2026-10-03T10:17:00Z",
        "2026-10-03",
        "0000-01-01",
        "-0001-12-31T23:59:59Z",
        "+10000-01-01T00:00:00Z",
        "",
        "2024-02-29",
        "2023-02-29",
        "2024-02-30",
        "2024-02-29T23:59:60Z",
        "2026-13-01",
        "2026-00-10",
        "2024-02-29T24:00:00Z",
        "2024-02-29T23:59:59.5Z",
        "2024-02-29T23:59:59z",
        "2024-02-29T23:59:59+01:00",
        "2026-1-01",
        "20261-01-01",
        "2026-10-03T",
        "2026/10/03",
        "x",
        "+99999999999999999999-01-01",
    ])
    {
        match (DateTime::from_iso(StringView::of(s)))
        {
            Ok(t)           :
            {
                String iso = DateTime::to_iso(&t);
                printf("'%s' -> %s\n", s, &iso);
            },
            Err(Invalid(i)) : printf("'%s' -> Invalid(%u)\n", s, i),
            Err(e)          : printf("'%s' -> %s\n", s, ParseError::text(&e)),
        }
    }
}
