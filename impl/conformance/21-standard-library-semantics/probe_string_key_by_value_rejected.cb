// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.type.probe `probe<K>` (D-0312): a `String` key's probe is a view, and a `String` by value is none (`[Coerce-Text]`): `&k`; conf.probe-string-key-by-value-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//

import std;

fn main()
{
    HashMap<String, i32> m = HashMap::new();
    HashMap::insert(&mut m, "a", 2);
    String k = "a";
    bool b = HashMap::contains(&m, k);
}
