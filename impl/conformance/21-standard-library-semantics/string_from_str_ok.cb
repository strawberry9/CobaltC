// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.string String::from_str; inv.string.utf8-validity; inv.str.utf8-validity; conf.string-from-str
// kind: positive
// expect: ok
//
// `String::from_str` copies a str's bytes into an owned String without
// running the UTF-8 validator (the str invariant carries over); the
// result round-trips through `into_bytes` with the same bytes, and the
// source str is still usable afterwards (copied, not consumed).

import std;

fn main()
{
    str s = "caf\u{e9}";
    String owned = String::from_str(s);
    if (String::len(&owned) != 5) { 1 / (1 - 1); }
    if (str_len(s) != 5) { 1 / (1 - 1); }
    Vec<u8> bytes = String::into_bytes(owned);
    usize i = 0;
    while (i < 5)
    {
        if (*Vec::index_shared(&bytes, i) != str_byte(s, i)) { 1 / (1 - 1); }
        i = i + 1;
    }
}
