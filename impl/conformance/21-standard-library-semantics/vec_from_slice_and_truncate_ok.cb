// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `Vec::from_slice`, `Vec::truncate` (D-0085); conf.vec-from-slice, conf.vec-truncate
// kind: positive
// expect: ok
//
// A slice copied into a `Vec` of its own, and a `Vec` of resources
// shortened: the elements past `n` are destroyed, last first. Found by
// real-world testing (a UTF-8 decoder, a Huffman decoder's corrupt-file
// test), which had to write both as loops.

import std;

resource struct Noisy
{
    u32 id;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("drop %d\n", self.id);
}

fn main()
{
    array<u8, 5> a = [1, 2, 3, 4, 5];
    Vec<u8> v = Vec::from_slice(&a[1..4]);
    assert(Vec::len(&v) == 3 && v[0] == 2 && v[2] == 4);
    Vec<u8> w = Vec::from_slice(&v[0..$]);
    Vec::truncate(&mut w, 2);
    assert(Vec::len(&w) == 2 && w[1] == 3);
    Vec<Noisy> ns = Vec::new();
    Vec::push(&mut ns, Noisy { .id = 1 });
    Vec::push(&mut ns, Noisy { .id = 2 });
    Vec::push(&mut ns, Noisy { .id = 3 });
    Vec::truncate(&mut ns, 1);                  // drop 3, drop 2
    assert(Vec::len(&ns) == 1);
    Vec::truncate(&mut ns, 1);                  // nothing to do
}
