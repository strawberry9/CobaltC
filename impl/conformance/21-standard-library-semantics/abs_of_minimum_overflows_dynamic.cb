// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: D-0091 `abs` is checked; conf.abs-min-overflows
// kind: negative
// expect: diag.arith-overflow (dynamic)
//
// The magnitude of a signed type's minimum does not fit the type, so
// `abs` of it faults like the negation it performs.

import std;

fn magnitude(i32 x) : i32
{
    abs(x)
}

fn main()
{
    i32 m = -2147483647 - 1;
    printf("%d\n", magnitude(m));
}
