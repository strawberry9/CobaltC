// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Ed25519-Sign] [Ed25519-Verify] (D-0167); conf.ed25519-vectors, conf.ed25519-refusals
// kind: positive
// expect: ok
// slow: interpreted big-number arithmetic takes well over the 10-second budget
// expect-stdout-hex: 
//
// RFC 8032 §7.1's tests 1 to 3: the public key and the signature of each
// private key and message, verified; then a changed R, a changed S, another
// message, another key, an S equal to L, and a 63-byte signature, all
// refused.

import std;

fn bytes(str hex) : Vec<u8>
{
    Result::unwrap_or(from_hex(StringView::of(hex)), Vec::new())
}

fn main() : u8
{
    array<str, 3> keys = [
        "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
        "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb",
        "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7",
    ];
    array<str, 3> messages = ["", "72", "af82"];
    for (usize i = 0; i < 3; i += 1)
    {
        Vec<u8> k = bytes(keys[i]);
        Vec<u8> m = bytes(messages[i]);
        array<u8, 32> pk = ed25519_public_key(&k[0..$]);
        array<u8, 64> sig = ed25519_sign(&k[0..$], &m[0..$]);
        printf(
            "%v %s %s %v\n",
            i + 1,
            &to_hex(&pk[0..$]),
            &to_hex(&sig[0..$]),
            ed25519_verify(&pk[0..$], &m[0..$], &sig[0..$]),
        );
    }
    Vec<u8> k = bytes(keys[2]);
    Vec<u8> m = bytes("af82");
    array<u8, 32> pk = ed25519_public_key(&k[0..$]);
    array<u8, 64> sig = ed25519_sign(&k[0..$], &m[0..$]);
    array<u8, 64> bad_r = sig;
    bad_r[3] = bad_r[3] ^ 0x40;
    array<u8, 64> bad_s = sig;
    bad_s[40] = bad_s[40] ^ 1;
    array<u8, 32> other = ed25519_public_key(&bytes(keys[1])[0..$]);
    Vec<u8> big_s = Vec::from_slice(&sig[0..32]);
    Vec::extend_from(&mut big_s, &bytes("edd3f55c1a631258d69cf7a2def9de1400000000000000000000000000000010")[0..$]);
    printf(
        "refused: %v %v %v %v %v %v\n",
        !ed25519_verify(&pk[0..$], &m[0..$], &bad_r[0..$]),
        !ed25519_verify(&pk[0..$], &m[0..$], &bad_s[0..$]),
        !ed25519_verify(&pk[0..$], &bytes("af83")[0..$], &sig[0..$]),
        !ed25519_verify(&other[0..$], &m[0..$], &sig[0..$]),
        !ed25519_verify(&pk[0..$], &m[0..$], &big_s[0..$]),
        !ed25519_verify(&pk[0..$], &m[0..$], &sig[0..63]),
    );
    0
}
