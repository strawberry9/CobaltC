// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: [Coerce-Text] (D-0312; a type parameter the type arguments fix is a declared type); conf.ref-string-view-type-parameter
// kind: positive
// expect: ok
// expect-stdout-hex: 6162630a
//
// `id<StringView>(&s)`: the type argument fixes `T` as `StringView`, so the
// parameter is declared `StringView` there and `&s` is the view of `s`
// (`[Coerce-Text]`, whose positions are `rule.type.expected`'s, a type
// parameter fixed by the other arguments, the type arguments or the
// expected type included). Before D-0312 this was rejected: only a
// parameter written `StringView` took a view.

import std;

fn id<T>(T x) : T
{
    return x;
}

fn main() : u8
{
    String s = "abc";
    StringView w = id<StringView>(&s);
    printf("%s\n", w);
    return 0;
}
