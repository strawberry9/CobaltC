// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.prelude §0; [Resolve-Unqualified] (conf.item-shadows-intrinsic, conf.local-shadows-intrinsic)
// kind: positive
// expect: ok
//
// An intrinsic's name is not reserved. A program's own function, or a
// local binding, with that name is what the name means, and the
// intrinsic is reached only where nothing else is.

import std;

fn check(bool ok)
{
    i32 z = if (ok)
    {
        1
    }
    else
    {
        0
    };
    1 / z;
}

fn widen(i32 a) : i32
{
    a + 1
}

fn main()
{
    check(widen(1) == 2);
    auto max_value = [](i32 a)
    {
        a * 2
    };
    check(max_value(4) == 8);
    check(min_value<i8>() == -128);
}
