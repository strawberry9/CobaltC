fn one(str pem) : Certificate
{
    Vec<Certificate> v = certificates_from_pem(StringView::of(pem));
    Vec::remove(&mut v, 0)
}

fn show(str what, Result<void, CertError> r)
{
    match (r)
    {
        Ok(_)  : printf("%s: ok\n", what),
        Err(e) : printf("%s: %s\n", what, CertError::text(&e)),
    }
}

fn main() : u8
{
    Certificate root = one(ROOT);
    Certificate inter = one(INTER);
    Certificate leaf = one(LEAF);
    Certificate short = one(SHORT);
    TrustStore store = TrustStore::new();
    TrustStore::add(&mut store, Certificate::clone(&root));
    Vec<Certificate> mids = Vec::new();
    Vec::push(&mut mids, Certificate::clone(&inter));
    DateTime at = Option::unwrap(DateTime::new(2030, 6, 1, 0, 0, 0));
    show("other host", verify_chain(&leaf, &mids[0..$], &store, "other.example", &at));
    show("expired leaf", verify_chain(&short, &mids[0..$], &store, "test.example", &at));
    DateTime early = Option::unwrap(DateTime::new(2020, 1, 1, 0, 0, 0));
    show("before validity", verify_chain(&leaf, &mids[0..$], &store, "test.example", &early));
    Vec<Certificate> none = Vec::new();
    show("no intermediate", verify_chain(&leaf, &none[0..$], &store, "test.example", &at));
    TrustStore empty = TrustStore::new();
    show("no roots", verify_chain(&leaf, &mids[0..$], &empty, "test.example", &at));
    match (Certificate::parse(&leaf.der[0..Vec::len(&leaf.der) - 1]))
    {
        Ok(_)  : printf("truncated: parsed?\n"),
        Err(e) : printf("truncated: %s\n", CertError::text(&e)),
    }
    array<u8, 4> long_form = [0x04, 0x81, 0x01, 0x00];
    printf("non-minimal length refused: %v\n", Option::is_none(&der_read(&long_form[0..$], 0)));
    0
}
