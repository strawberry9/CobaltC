// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `Vec::filled`, `Vec::from_fn`, `Vec::append`, `Vec::extend_from`, `Vec::position`, `Vec::index_of`, `Vec::contains`, `Vec::reverse` (D-0112); conf.vec-filled, conf.vec-from-fn, conf.vec-append, conf.vec-extend-from, conf.vec-position, conf.vec-index-of, conf.vec-contains, conf.vec-reverse
// kind: positive
// expect: ok
//
// The seven helpers of D-0112 on plain and resource elements: `filled`
// copies a plain value; `from_fn` makes each element (a grid of Vecs, a
// Vec of Strings, a Vec of resources); `append` moves another Vec's
// elements in and consumes it; `extend_from` copies from a slice;
// `position` takes a predicate, `index_of`/`contains` an `eq` value by
// reference; `reverse` swaps in place and destroys nothing.

import std;

resource struct Noisy
{
    u32 id;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("drop %d\n", self.id);
}

fn main()
{
    Vec<u8> a = Vec::filled(3, 7: u8);
    Vec<bool> flags = Vec::filled(2, false);
    assert(Vec::len(&a) == 3 && a[2] == 7 && Vec::len(&flags) == 2 && !flags[1]);
    Vec<u8> none = Vec::filled(0, 1: u8);
    assert(Vec::len(&none) == 0);

    Vec<Vec<u8>> grid = Vec::from_fn(2, [](usize r) : Vec<u8> { Vec::filled(3, narrow<u8>(r)) });
    assert(Vec::len(&grid) == 2 && grid[1][2] == 1 && grid[0][0] == 0);
    Vec<String> names = Vec::from_fn(3, [](usize i) : String { sprintf("n%d", i) });
    assert(Vec::len(&names) == 3 && String::eq_str(&names[2], "n2"));

    Vec<String> more = Vec::new();
    Vec::push(&mut more, String::from_str("x"));
    Vec::push(&mut more, String::from_str("y"));
    Vec::append(&mut names, more);                       // more is consumed
    assert(Vec::len(&names) == 5 && String::eq_str(&names[4], "y"));

    array<u8, 4> bytes = [1, 2, 3, 4];
    Vec::extend_from(&mut a, &bytes[1..3]);
    assert(Vec::len(&a) == 5 && a[3] == 2 && a[4] == 3);
    Vec<u8> b = Vec::filled(2, 9: u8);
    Vec::extend_from(&mut a, &b[0..$]);                  // b stays usable
    assert(Vec::len(&a) == 7 && a[6] == 9 && Vec::len(&b) == 2);

    String key = "n1";
    assert(Vec::position(&names, [key](ref<String, shared> s) : bool { *s == key }) == Some(1));
    assert(Vec::position(&a, [](ref<u8, shared> x) : bool { *x > 100 }) == None);
    assert(Vec::index_of(&names, &key) == Some(1));
    assert(Vec::index_of(&a, &(9: u8)) == Some(5));      // the first of two
    assert(Vec::index_of(&a, &(0: u8)) == None);
    assert(Vec::contains(&a, &(2: u8)) && !Vec::contains(&names, &String::from_str("zz")));

    Vec::reverse(&mut a);
    assert(a[0] == 9 && a[6] == 7 && Vec::len(&a) == 7);
    Vec<Noisy> ns = Vec::from_fn(3, [](usize i) : Noisy { Noisy { .id = narrow<u32>(i) } });
    Vec::reverse(&mut ns);                               // nothing destroyed
    assert(ns[0].id == 2 && ns[2].id == 0);
    Vec<Noisy> empty = Vec::new();
    Vec::reverse(&mut empty);
    Vec::append(&mut ns, empty);
    assert(Vec::len(&ns) == 3);
    printf("done\n");                                    // then drop 0, drop 1, drop 2
}
