// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Hmac-Sha256] [Digest-Eq] (D-0151); conf.hmac-sha256-vectors, conf.digest-eq
// kind: positive
// expect: ok
// expect-stdout-hex: 6361736520313a206f6b0a6361736520323a206f6b0a6361736520333a206f6b0a6361736520343a206f6b0a6361736520363a206f6b0a6361736520373a206f6b0a73747265616d696e673a20747275650a6469676573745f65713a20747275652066616c73652066616c736520747275650a
//
// HMAC-SHA-256 against RFC 4231's test cases 1, 2, 3, 4, 6 and 7 (keys of
// 20 bytes, 4 bytes, 25 bytes, and 131 bytes, which is longer than a block
// and hashed first); the streaming form agrees with the one-shot form;
// `digest_eq` is true only for equal lengths and bytes.

import std;

fn check(str name, slice<u8, shared> key, slice<u8, shared> data, str want)
{
    String got = to_hex(&hmac_sha256(key, data)[0..$]);
    printf("%s: %s\n", name, if (String::eq_str(&got, want)) { "ok" } else { "WRONG" });
}

fn main() : u8
{
    Vec<u8> k1 = Vec::filled(20, 0x0b);
    check("case 1", &k1[0..$], &b"Hi There"[0..$], "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7");
    check(
        "case 2",
        &b"Jefe"[0..$],
        &b"what do ya want for nothing?"[0..$],
        "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843",
    );
    Vec<u8> k3 = Vec::filled(20, 0xaa);
    Vec<u8> d3 = Vec::filled(50, 0xdd);
    check("case 3", &k3[0..$], &d3[0..$], "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe");
    Vec<u8> k4 = Vec::new();
    for (u8 i = 1; i <= 25; i += 1)
    {
        Vec::push(&mut k4, i);
    }
    Vec<u8> d4 = Vec::filled(50, 0xcd);
    check("case 4", &k4[0..$], &d4[0..$], "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b");
    Vec<u8> k6 = Vec::filled(131, 0xaa);
    check(
        "case 6",
        &k6[0..$],
        &b"Test Using Larger Than Block-Size Key - Hash Key First"[0..$],
        "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54",
    );
    check(
        "case 7",
        &k6[0..$],
        &b"This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm."[0..$],
        "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2",
    );
    // Streaming in two pieces.
    HmacSha256 m = HmacSha256::new(&b"Jefe"[0..$]);
    HmacSha256::update(&mut m, &b"what do ya want "[0..$]);
    HmacSha256::update(&mut m, &b"for nothing?"[0..$]);
    array<u8, 32> whole = hmac_sha256(&b"Jefe"[0..$], &b"what do ya want for nothing?"[0..$]);
    printf("streaming: %v\n", digest_eq(&HmacSha256::finish(m)[0..$], &whole[0..$]));
    // digest_eq: equal, one bit off at the end, a prefix, two empty slices.
    Vec<u8> none = Vec::new();
    array<u8, 32> other = whole;
    other[31] = other[31] ^ 1;
    printf(
        "digest_eq: %v %v %v %v\n",
        digest_eq(&whole[0..$], &whole[0..$]),
        digest_eq(&whole[0..$], &other[0..$]),
        digest_eq(&whole[0..$], &whole[0..31]),
        digest_eq(&none[0..$], &none[0..$]),
    );
    0
}
