// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.ffi; rule.trust.unsafe [Unsafe-Rejected] (D-0252); conf.string-from-c-outside-unsafe
// kind: negative
// expect: diag.trusted-outside-unsafe (static)
//
// `String::from_c` reads where its pointer points, so, like a
// dereference, it is written inside `unsafe`.

import std;

fn main()
{
    CString c = Result::expect(CString::new("x"), "no NUL");
    Result<String, Utf8Error> s = String::from_c(CString::ptr(&c));
}
