// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: §2a [Str-Literal-View] through an enum constructor (D-0225); conf.str-literal-view-in-variant
// kind: positive
// expect: ok
// expect-stdout-hex: 760a770a780a790a6e65737465640a696e206120707573680a
//
// A text literal is a `StringView` where a variant's payload is expected to
// be one: `Some("v")` for an `Option<StringView>` declared, passed or
// pushed, nested (`Ok(Some("nested"))`), and a program's own enum's
// `StringView` payload. The expected type comes from the declaration, the
// parameter, or the enclosing constructor.
import std;

enum Tag
{
    Named(StringView),
    Anon,
}

fn show(Option<StringView> v)
{
    match (v)
    {
        Some(t) : printf("%v\n", t),
        None    : printf("none\n"),
    }
}

fn main()
{
    Option<StringView> a = Some("v");
    show(a);
    show(Some("w"));
    Tag t = Named("x");
    match (t)
    {
        Named(n) : printf("%v\n", n),
        Anon     : {},
    }
    Result<StringView, u8> r = Ok("y");
    printf("%v\n", Result::unwrap(r));
    Result<Option<StringView>, u8> r2 = Ok(Some("nested"));
    match (r2)
    {
        Ok(Some(v)) : printf("%v\n", v),
        _           : printf("other\n"),
    }
    Vec<Option<StringView>> vs = Vec::new();
    Vec::push(&mut vs, Some("in a push"));
    printf("%v\n", Option::unwrap(Option::unwrap(Vec::pop(&mut vs))));
}
