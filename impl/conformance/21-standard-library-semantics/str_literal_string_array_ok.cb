// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str [Str-Literal-String] [Str-Literal-View] (D-0304): an array literal's elements; conf.str-literal-string-array
// kind: positive
// expect: ok
// stdout: x y 1
// stdout: p q
//
// Each text literal element of an array whose element type is declared
// `String` is a `String`; of one declared `StringView`, a view.

import std;

fn main()
{
    array<String, 2> a = ["x", "y"];
    printf("%s %s %d\n", &a[0], &a[1], StringView::len(&a[0]));
    array<StringView, 2> v = ["p", "q"];
    printf("%s %s\n", v[0], v[1]);
}
