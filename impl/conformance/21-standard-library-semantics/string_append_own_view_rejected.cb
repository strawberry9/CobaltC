// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.text `String::append` (D-0053), rule.agg.slice `[Write-Conflict]`; conf.string-append-own-view-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// A `String` appended to itself through a view of it: the view's path is
// live while the append writes the `String`, and the two clash. (Through
// `String::clone` first, the same text appends without a clash.)
//
// D-0282: the static pass rejects this program before it runs (it was found
// at run time before): `String::append` writes `s` through argument 1,
// which argument 2 also reaches.

import std;

fn main()
{
    String s = String::from_str("abc");
    String t = String::clone(&s);
    String::append(&mut s, String::as_view(&t));
    printf("%s\n", &s);
    String::append(&mut s, String::as_view(&s));
    printf("%s\n", &s);
}
