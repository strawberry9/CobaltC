// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: D-0023 rule.stdlib.vec
// kind: positive
// expect: ok
//
// The index of an element read is computed by a block that pushes onto
// the same vector, reallocating it: the element is found in the new
// buffer, after the index is known.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 7);
    i32 x = *Vec::index_shared(&v, {
        Vec::push(&mut v, 1);
        Vec::push(&mut v, 2);
        Vec::push(&mut v, 3);
        Vec::push(&mut v, 4);
        0
    });
    if (x != 7 || Vec::len(&v) != 5)
    {
        1 / (1 - 1);
    }
}
