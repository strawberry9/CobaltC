// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.args [Args-Command] [Args-Finish] (reports 325, 330, 333); conf.args-command, conf.args-finish-forms
// kind: positive
// expect: ok
// args: -C repo -v commit -v -m hello file.txt
//
// A git-style program: `Args::command` takes the command and what follows
// it before the global options are declared, so the global `-v` and the
// command's own `-v` are two options, and `-C`'s value is not taken for
// the command. Then the messages for `-o=x` (the value without its `=`)
// and for `-` followed by a non-ASCII character (an unknown option, not a
// fault).

import std;

fn finish_of(str item) : String
{
    Vec<String> items = Vec::new();
    Vec::push(&mut items, String::copy(item));
    Args a = Args::from(items, "prog");
    _ = Args::option(&mut a, "output", "o", "FILE", "where to write");
    match (Args::finish(&mut a))
    {
        Ok(_)  : "ok",
        Err(m) : m,
    }
}

fn main() : u8
{
    Args a = Result::unwrap(Args::new("tool [-v] [-C DIR] COMMAND [ARGS]"));
    Vec<String> cmd = Args::command(&mut a, "-C --dir");
    bool verbose = Args::flag(&mut a, "verbose", "v", "say more");
    Option<String> dir = Args::option(&mut a, "dir", "C", "DIR", "where to work");
    Vec<String> rest = Result::unwrap(Args::finish(&mut a));
    printf("global: verbose=%v dir=%s rest=%v\n", verbose, &Option::unwrap_or(dir, "-"), Vec::len(&rest));
    Args c = Args::from(cmd, "tool commit [-v] -m MSG FILE...");
    bool diff = Args::flag(&mut c, "verbose", "v", "show the diff");
    Option<String> msg = Args::option(&mut c, "message", "m", "MSG", "the message");
    Vec<String> files = Result::unwrap(Args::finish(&mut c));
    printf("command %s: verbose=%v message=%s files=%v\n", &files[0], diff, &Option::unwrap_or(msg, "-"), Vec::len(&files) - 1);
    Args none = Args::from(Vec::new(), "tool");
    printf("no command: %v\n", Vec::len(&Args::command(&mut none, "")));
    printf("%s\n", &finish_of("-o=x"));
    printf("%s\n", &finish_of("-\u{e9}t\u{e9}.txt"));
    0
}
