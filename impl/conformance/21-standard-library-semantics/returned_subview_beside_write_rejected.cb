// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview sub-view returned by a function, then `[Write]` of its root beside it (CHG-0372); conf.returned-view-beside-write
// kind: negative
// expect: diag.aliasing-conflict (dynamic)

import std;

fn head(StringView v) : StringView
{
    &v[0 .. 1]
}

fn main()
{
    String s = "hello";
    StringView h = head(String::as_view(&s));
    printf("%v\n", h);
    String::append(&mut s, "!");
    printf("%v\n", h);
}
