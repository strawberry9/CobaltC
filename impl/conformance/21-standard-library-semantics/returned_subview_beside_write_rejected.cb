// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview sub-view returned by a function, then `[Write]` of its root beside it (CHG-0372); conf.returned-view-beside-write
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// D-0282: the static pass rejects this program before it runs (it was found
// at run time before): `String::append` writes `s` through argument 1 while
// `h` still borrows `s`.

import std;

fn head(StringView v) : StringView
{
    &v[0 .. 1]
}

fn main()
{
    String s = "hello";
    StringView h = head(String::as_view(&s));
    printf("%v\n", h);
    String::append(&mut s, "!");
    printf("%v\n", h);
}
