// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [X25519] (D-0154); conf.x25519-vectors, conf.x25519-exchange, conf.x25519-small-order
// kind: positive
// expect: ok
// slow: interpreted big-number arithmetic takes well over the 10-second budget
// expect-stdout-hex: 
//
// RFC 7748's vectors: §5.2's two scalar multiplications and the iterated
// vector after one round; §6.1's exchange (Alice's and Bob's public keys,
// and the same shared secret computed from either side); the all-zero
// point gives `None`; a fresh private key gives a public key that agrees
// with an exchange.

import std;
fn hex(str t) : Vec<u8>
{
    Result::unwrap_or(from_hex(StringView::of(t)), Vec::new())
}

fn check(str name, Option<array<u8, 32>> got, str want)
{
    match (got)
    {
        Some(g) :
        {
            String h = to_hex(&g[0..$]);
            printf("%s: %s\n", name, if (String::eq_str(&h, want)) { "ok" } else { "WRONG" });
            if (!String::eq_str(&h, want))
            {
                printf("  got  %s\n", &h);
            }
        },
        None    : printf("%s: None\n", name),
    }
}

fn main() : u8
{
    check(
        "7748 5.2 #1",
        x25519(
            &hex("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4")[0..$],
            &hex("e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c")[0..$],
        ),
        "c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552",
    );
    check(
        "7748 5.2 #2",
        x25519(
            &hex("4b66e9d4d1b4673c5ad22691957d6af5c11b6421e0ea01d42ca4169e7918ba0d")[0..$],
            &hex("e5210f12786811d3f4b7959d0538ae2c31dbe7106fc03c3efc4cd549c715a493")[0..$],
        ),
        "95cbde9476e8907d7aade45cb4b873f88b595a68799fa152e6f8f7647aac7957",
    );
    Vec<u8> alice = hex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a");
    Vec<u8> bob = hex("5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb");
    array<u8, 32> pa = x25519_public_key(&alice[0..$]);
    array<u8, 32> pb = x25519_public_key(&bob[0..$]);
    check("alice public", Some(pa), "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a");
    check("bob public", Some(pb), "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f");
    check(
        "alice shared",
        x25519(&alice[0..$], &pb[0..$]),
        "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742",
    );
    check(
        "bob shared",
        x25519(&bob[0..$], &pa[0..$]),
        "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742",
    );
    array<u8, 32> k = [0; 32];
    k[0] = 9;
    array<u8, 32> u = k;
    array<u8, 32> next = Option::unwrap(x25519(&k[0..$], &u[0..$]));
    check("iterated once", Some(next), "422c8e7a6227d7bca1350b3e2bb7279f7897b87bb6854b783c60e80311ae3079");
    array<u8, 32> zero = [0; 32];
    printf("small-order point refused: %v\n", Option::is_none(&x25519(&alice[0..$], &zero[0..$])));
    array<u8, 32> mine = x25519_private_key();
    array<u8, 32> theirs = x25519_private_key();
    array<u8, 32> pm = x25519_public_key(&mine[0..$]);
    array<u8, 32> pt = x25519_public_key(&theirs[0..$]);
    array<u8, 32> s1 = Option::unwrap(x25519(&mine[0..$], &pt[0..$]));
    array<u8, 32> s2 = Option::unwrap(x25519(&theirs[0..$], &pm[0..$]));
    printf("fresh keys agree: %v\n", digest_eq(&s1[0..$], &s2[0..$]));
    0
}
