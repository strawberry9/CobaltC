// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.fs [Path-Join] [Path-Parts] [Path-Normalize] (D-0141); conf.path-join, conf.path-parts, conf.path-normalize
// kind: positive
// expect: ok
// expect-stdout-hex: 
// platform: unix
//
// The part functions read a path's text by the platform's grammar (here
// Unix's) and never touch the file system. `.bashrc` is a stem with no
// extension; `archive.tar.gz`'s extension is `gz`; `..`, `/` and `` have
// no file name; a root and the empty path have no parent, and a single
// relative name has the empty one. `path_normalize` removes `.`, resolves
// `x/..`, keeps a leading `..`, and gives `.` for nothing left. An
// absolute tail replaces the base in `path_join`.

import std;

fn opt(Option<String> o) : String
{
    match (o)
    {
        Some(s) : sprintf("'%s'", &s),
        None    : "None",
    }
}

fn main()
{
    foreach (q in ["/a/b/c.txt", "a/../b", "./x", "/", "", "..", ".bashrc", "archive.tar.gz", "a//b/", "../../x/y/.."])
    {
        StringView p = StringView::of(q);
        String parent = opt(path_parent(p));
        String name = opt(path_file_name(p));
        String stem = opt(path_stem(p));
        String ext = opt(path_extension(p));
        String norm = path_normalize(p);
        printf(
            "'%s': parent %s, name %s, stem %s, extension %s, absolute %v, normalized '%s'\n",
            q,
            &parent,
            &name,
            &stem,
            &ext,
            path_is_absolute(p),
            &norm,
        );
    }
    String a = path_join("logs", "app.log");
    String b = path_join("/var/log/", "app.log");
    String c = path_join("logs", "/etc/passwd");
    printf("%s %s %s\n", &a, &b, &c);
}
