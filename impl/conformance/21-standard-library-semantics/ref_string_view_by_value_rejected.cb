// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview [Ref-String-View] (D-0302); conf.ref-string-view-by-value-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// A `String` by value is not a view: the borrow is written (`&s`), as at
// every call that borrows.

import std;

fn show(StringView v)
{
    printf("[%s]\n", v);
}

fn main() : u8
{
    String s = "abc";
    show(s);
    return 0;
}
