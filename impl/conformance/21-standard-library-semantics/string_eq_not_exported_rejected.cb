// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.string (D-0312): `String::eq` is `std`'s own; programs write `a == b`; conf.string-eq-not-exported
// kind: negative
// expect: diag.name-not-visible (static)
//

import std;

fn main()
{
    String a = "x";
    String b = "x";
    bool e = String::eq(&a, &b);
}
