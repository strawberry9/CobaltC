// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.env [Current-Exe] [Hostname] rule.stdlib.process [Process-Id] (D-0181); conf.env-current-exe, conf.env-hostname, conf.process-id
// kind: positive
// expect: ok
// expect-stdout-hex: 7472756520747275650a7472756520747275650a747275650a
//
// `current_exe` is an absolute path to a file; `hostname` is non-empty
// text without spaces; `process_id` is positive and is what a child sees
// as its parent (checked through the shell, where there is one).

import std;

fn main()
{
    String exe = Result::unwrap(current_exe());
    printf(
        "%v %v\n",
        path_is_absolute(String::as_view(&exe)),
        match (path_kind(String::as_view(&exe))) { Ok(File(_)) : true, _ : false },
    );
    String h = Result::unwrap(hostname());
    printf("%v %v\n", String::len(&h) > 0, Option::is_none(&String::find(&h, " ")));
    printf("%v\n", process_id() > 0);
}
