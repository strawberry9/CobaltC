// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.type.probe `probe<K>` (D-0312): a `String`-keyed map and set looked up by a literal, `&s`, a reference, a `str` and a view; an integer key by value, a struct key by reference; `entry` copying only an absent key; `Vec` searches by a probe; conf.probe-lookups
// kind: positive
// expect: ok
// expect-stdout-hex: 3320322032203120320a66616c7365203320330a31310a3320747275650a360a747275652066616c736520747275650a310a7472756520312066616c73650a312037370a747275650a372031352034203020320a
//

import std;

struct Pt
{
    i32 x;
    i32 y;
}

fn count_words(str text) : HashMap<String, i32>
{
    HashMap<String, i32> m = HashMap::new();
    foreach (w in StringView::split(text, " "))
    {
        *HashMap::entry(&mut m, w, 0) += 1;
    }
    m
}

fn main()
{
    HashMap<String, i32> m = count_words("a b a c b a");
    String b = "b";
    ref<String, shared> rb = &b;
    str t = "c";
    StringView v = &b;
    printf("%v %v %v %v %v\n", *Option::unwrap(HashMap::get(&m, "a")), *Option::unwrap(HashMap::get(&m, &b)), *Option::unwrap(HashMap::get(&m, rb)), *Option::unwrap(HashMap::get(&m, t)), *Option::unwrap(HashMap::get(&m, v)));
    printf("%v %v %v\n", HashMap::contains(&m, "z"), HashMap::len(&m), Option::unwrap(HashMap::remove(&mut m, "a")));
    *Option::unwrap(HashMap::get_mut(&mut m, "c")) += 10;
    printf("%v\n", *Option::unwrap(HashMap::get(&m, "c")));
    HashMap<i64, i32> n = HashMap::new();
    i64 k = 7;
    *HashMap::entry(&mut n, k, 1) += 1;
    *HashMap::entry(&mut n, k, 1) += 1;
    printf("%v %v\n", *Option::unwrap(HashMap::get(&n, k)), HashMap::contains(&n, 7));
    HashMap<Pt, i32> q = HashMap::new();
    Pt p = Pt { .x = 1, .y = 2 };
    *HashMap::entry(&mut q, &p, 5) += 1;
    printf("%v\n", *Option::unwrap(HashMap::get(&q, &p)));
    HashSet<String> s = HashSet::new();
    HashSet::insert(&mut s, "x");
    HashSet::insert(&mut s, "y");
    printf("%v %v %v\n", HashSet::contains(&s, "x"), HashSet::contains(&s, v), HashSet::remove(&mut s, "y"));
    HashSet<String> s2 = HashSet::new();
    HashSet::insert(&mut s2, "x");
    printf("%v\n", HashSet::len(&HashSet::union(&s, &s2)));
    Vec<String> vs = Vec::new();
    Vec::push(&mut vs, "a");
    Vec::push(&mut vs, "b");
    Vec::push(&mut vs, "d");
    printf("%v %v %v\n", Vec::contains(&vs, "b"), Option::unwrap(Vec::index_of(&vs, &b)), Vec::contains(&vs, t));
    printf("%v %v\n", Result::unwrap(Vec::binary_search(&vs, "b")), Result::unwrap_or(Vec::binary_search(&vs, "c"), 77));
    Vec<f64> fs = Vec::new();
    Vec::push(&mut fs, 1.5);
    f64 h = 1.5;
    printf("%v\n", Vec::contains(&fs, h));
    extra();
}

fn extra()
{
    HashMap<u8, u32> m = HashMap::new();
    for (u8 i = 0; i < 100; i += 1)
    {
        *HashMap::entry(&mut m, i % 7, 0) += 1;
    }
    HashMap<str, i32> sm = HashMap::new();
    HashMap::insert(&mut sm, "k", 4);
    Vec<i64> vi = Vec::new();
    Vec::push(&mut vi, -5);
    Vec::push(&mut vi, 3);
    Vec::push(&mut vi, 9);
    printf("%v %v %v %v %v\n", HashMap::len(&m), *HashMap::value_at(&m, 0), *Option::unwrap(HashMap::get(&sm, "k")), Result::unwrap(Vec::binary_search(&vi, -5)), Option::unwrap(Vec::index_of(&vi, 9)));
}
