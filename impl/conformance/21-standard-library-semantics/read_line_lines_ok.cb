// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.read [Read]; read_line; conf.read-line-lines
// kind: positive
// expect: ok
// stdin-hex: 61620d0a0a63
// expect-stdout-hex: 61620d7c7c637c0a
//
// Input `ab\r\n\nc`: three lines -- `ab\r` (a `\r` is kept; only `\n`
// ends a line), an empty line, and `c`, which ends at the end of input
// without a `\n` -- then `Ok(None)`. Both implementations read standard
// input (`rule.stdlib.read`, D-0050).

import std;

fn next() : Option<String>
{
    match (read_line())
    {
        Ok(line) : line,
        Err(_) :
        {
            1 / (1 - 1);
            None
        },
    }
}

fn expect_line(usize len)
{
    match (next())
    {
        Some(s) :
        {
            if (String::len(&s) != len)
            {
                1 / (1 - 1);
            }
            printf("%v|", &s);
        },
        None :
        {
            1 / (1 - 1);
        },
    }
}

fn main()
{
    expect_line(3);
    expect_line(0);
    expect_line(1);
    match (next())
    {
        Some(_) :
        {
            1 / (1 - 1);
        },
        None :
        {
        },
    }
    printf("\n");
}
