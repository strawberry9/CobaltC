// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.read [Read]; read_line; D-0092; conf.read-line-lines
// kind: positive
// expect: ok
// stdin-hex: 61620d0a0a610d620d0a630d
// expect-stdout-hex: 61627c7c610d627c630d7c0a
//
// Input `ab\r\n\na\rb\r\nc\r`: four lines -- `ab` (a `\r` before the
// `\n` is consumed with it, D-0092), an empty line, `a\rb` (any other
// `\r` is kept), and `c\r`, which ends at the end of input without a
// `\n`, so its `\r` stays -- then `Ok(None)`. Both implementations
// read standard input (`rule.stdlib.read`, D-0050).

import std;

fn next() : Option<String>
{
    match (read_line())
    {
        Ok(line) : line,
        Err(_)   :
        {
            1 / (1 - 1);
            None
        },
    }
}

fn expect_line(usize len)
{
    match (next())
    {
        Some(s) :
        {
            if (String::len(&s) != len)
            {
                1 / (1 - 1);
            }
            printf("%v|", &s);
        },
        None    :
        {
            1 / (1 - 1);
        },
    }
}

fn main()
{
    expect_line(2);
    expect_line(0);
    expect_line(3);
    expect_line(2);
    match (next())
    {
        Some(_) :
        {
            1 / (1 - 1);
        },
        None    :
        {
        },
    }
    printf("\n");
}
