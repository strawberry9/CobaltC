// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `retain`, `position`, rule.fn.closure; conf.vec-capturing-predicates
// kind: positive
// expect: ok
// expect-stdout-hex: 6b30206b35206b33206b31206b36206b34206b32206b30206b35206b33206b31206b36200a370a617420330a3720350a
//
// retain and position with closure literals that capture: a value and a
// String (printing each element given, in order), a value compared, and a
// counter captured and written (by exclusive borrow) once per call.

import std;

fn main()
{
    Vec<i64> v = Vec::new();
    foreach (i in 0..12: i64)
    {
        Vec::push(&mut v, (i * 5) % 7);
    }
    i64 limit = 4;
    String tag = String::from_str("k");
    Vec::retain(&mut v, [limit, tag](ref<i64, shared> x) : bool { printf("%s%v ", &tag, *x); *x < limit });
    printf("\n%v\n", Vec::len(&v));
    i64 want = 2;
    match (Vec::position(&v, [want](ref<i64, shared> x) : bool { *x == want }))
    {
        Some(k) : printf("at %v\n", k),
        None    : printf("none\n"),
    }
    i64 count = 0;
    Vec::retain(&mut v, [count](ref<i64, shared> x) : bool { count += 1; *x != 0 });
    printf("%v %v\n", count, Vec::len(&v));
}
