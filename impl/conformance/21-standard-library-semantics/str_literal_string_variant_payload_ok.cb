// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str [Str-Literal-String] (D-0304): a variant constructor's payload fixed by the expected type; conf.str-literal-string-variant-payload
// kind: positive
// expect: ok
// stdout: some x
// stdout: ok y
// stdout: err z
// stdout: 1 42
// stdout: shape sq
// stdout: some w
//
// `Some(L)` where an `Option<String>` is expected, `Ok(L)` and `Err(L)` as
// a function's result, a payload fixed by the call it is an argument of,
// a program's own enum, nested, and an assigned value.

import std;

enum Shape
{
    Named(String),
    Plain,
}

fn get(bool ok) : Result<String, String>
{
    if (ok)
    {
        return Ok("y");
    }
    Err("z")
}

fn show(ref<Result<String, String>, shared> r)
{
    match (r)
    {
        Ok(s)  : printf("ok %s\n", s),
        Err(s) : printf("err %s\n", s),
    }
}

fn main()
{
    Option<String> o = Some("x");
    match (&o)
    {
        Some(s) : printf("some %s\n", s),
        None    : printf("none\n"),
    }
    show(&get(true));
    show(&get(false));
    Vec<Option<String>> cells = Vec::new();
    Vec::push(&mut cells, Some("42"));
    match (&cells[0])
    {
        Some(s) : printf("%d %s\n", Vec::len(&cells), s),
        None    : printf("none\n"),
    }
    Shape sh = Named("sq");
    match (&sh)
    {
        Named(n) : printf("shape %s\n", n),
        Plain    : printf("plain\n"),
    }
    Result<Option<String>, i32> nested = Ok(Some("w"));
    o = None;
    match (&nested)
    {
        Ok(Some(s)) : printf("some %s\n", s),
        _           : printf("other\n"),
    }
}
