// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.x509 [Cert-Parse] (D-0160), rule.stdlib.x509 key formats (D-0171); conf.hostile-pem-not-ascii (D-0211, CHG-0249)
// kind: positive
// expect: ok
// expect-stdout-hex: 6365727469666963617465733a20300a70726976617465206b65793a206d616c666f726d65642063657274696669636174650a7075626c6963206b65793a206d616c666f726d65642063657274696669636174650a
//
// A PEM block whose body holds a byte that is not ASCII -- so not base64
// either -- is malformed input, not a fault: certificates_from_pem skips
// the block, PrivateKey::from_pem and CertKey::from_pem are BadEncoding.
// Found by the hostile-input round (D-0211): both readers pushed the body
// through String::push_ascii and faulted diag.not-ascii on such a byte.

import std;

const str KEY = "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIG/xpX/23qwZ8iDRpzBt\u{1F600}YErXB+yw1ePRPCeOrMbHv6h\n-----END PRIVATE KEY-----\n";
const str CRT = "-----BEGIN CERTIFICATE-----\nMIIBfzCCATGgAwIBAgIUT5+4C2nK5\u{e9}/ckjqCAbHutlwq/fFowBQYDK2VwMBQxEjAQBgNV\n-----END CERTIFICATE-----\n";
const str PUB = "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA\u{e9}\u{e9}\u{e9}\n-----END PUBLIC KEY-----\n";

fn main() : u8
{
    printf("certificates: %v\n", Vec::len(&certificates_from_pem(CRT)));
    match (PrivateKey::from_pem(KEY))
    {
        Ok(_)  : printf("private key: ok\n"),
        Err(e) : printf("private key: %s\n", CertError::text(&e)),
    }
    match (CertKey::from_pem(PUB))
    {
        Ok(_)  : printf("public key: ok\n"),
        Err(e) : printf("public key: %s\n", CertError::text(&e)),
    }
    0
}
