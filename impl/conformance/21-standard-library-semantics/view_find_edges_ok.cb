// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview `StringView::find`, `StringView::contains`
// kind: positive
// expect: ok
//
// `find` at its edges: an empty needle (found at 0, even in empty text),
// a needle longer than the text, a match at either end, a partial match
// before the real one, multi-byte UTF-8 text, a view of part of a String
// (positions count from the view's start), and a scan that finds every
// separator by searching what is left. coby carries `find` out natively;
// its result must be the body's. `contains` is `find(…) != None`.

import std;

fn main()
{
    assert(StringView::find("hello", "") == Some(0));
    assert(StringView::find("", "") == Some(0));
    assert(StringView::find("", "a") == None);
    assert(StringView::find("hello", "hello") == Some(0));
    assert(StringView::find("hello", "hello!") == None);
    assert(StringView::find("hello", "h") == Some(0));
    assert(StringView::find("hello", "o") == Some(4));
    assert(StringView::find("hello", "lo") == Some(3));
    assert(StringView::find("hello", "x") == None);
    assert(StringView::find("aaab", "aab") == Some(1));
    assert(StringView::find("abababc", "ababc") == Some(2));
    assert(StringView::find("héllo wörld", "wö") == Some(7));

    String s = "one, two, three, two";
    StringView whole = String::as_view(&s);
    StringView tail = StringView::sub(whole, 6, StringView::len(whole));
    assert(StringView::find(tail, "two") == Some(11));
    assert(StringView::find(StringView::sub(whole, 6, 8), "two") == None);
    assert(StringView::find(StringView::sub(whole, 5, 8), "two") == Some(0));
    assert(StringView::contains(whole, "three") && !StringView::contains(tail, "one"));

    usize count = 0;
    usize at = 0;
    while (true)
    {
        StringView rest = StringView::sub(whole, at, StringView::len(whole));
        match (StringView::find(rest, ", "))
        {
            Some(i) :
            {
                count += 1;
                at = at + i + 2;
            },
            None    : break,
        }
    }
    assert(count == 3 && at == 17);
}
