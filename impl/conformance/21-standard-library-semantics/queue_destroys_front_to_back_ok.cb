// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.queue [Queue] (D-0137); conf.queue-destroy
// kind: positive
// expect: ok
// expect-stdout-hex: 746f6f6b20340a636c6561720a64726f7020310a64726f7020320a64726f7020330a656e640a64726f7020340a64726f7020350a64726f7020360a
//
// A queue owns its elements. Those left when it ends are destroyed front
// to back, and `clear` destroys them the same way and leaves the queue
// usable. An element taken out is the taker's.

import std;

resource struct Tracked
{
    u32 id;
}

fn Tracked::drop(ref<Tracked, exclusive> self)
{
    printf("drop %d\n", self.id);
}

fn main()
{
    {
        Queue<Tracked> q = Queue::new();
        Queue::push_back(&mut q, Tracked { .id = 2 });
        Queue::push_back(&mut q, Tracked { .id = 3 });
        Queue::push_front(&mut q, Tracked { .id = 1 });
        Queue::push_back(&mut q, Tracked { .id = 4 });
        Tracked t = Option::unwrap(Queue::pop_back(&mut q));
        printf("took %d\n", t.id);
        printf("clear\n");
        Queue::clear(&mut q);
        Queue::push_back(&mut q, Tracked { .id = 6 });
        Queue::push_front(&mut q, Tracked { .id = 5 });
        printf("end\n");
    }
}
