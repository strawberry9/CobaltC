// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `retain`, [Borrow-Denied]; conf.vec-retain-held-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// Vec::retain moves the kept v[4] down by a swap whose exclusive borrow
// clashes with a live shared reference to it.

import std;

fn main() : u8
{
    Vec<i64> v = Vec::new();
    foreach (i in 0..6: i64)
    {
        Vec::push(&mut v, i);
    }
    Vec<ref<i64, shared>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &v[4]);
    }
    Vec::retain(&mut v, [](ref<i64, shared> x) : bool { *x % 2 == 0 });
    printf("after %v\n", *held[0]);
    0
}
