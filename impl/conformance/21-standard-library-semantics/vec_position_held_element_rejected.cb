// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `position`, [Read-Conflict]; conf.vec-position-held-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// Vec::position borrows each element for its predicate; the shared borrow
// of v[3] clashes with a live exclusive reference to it.

import std;

fn main() : u8
{
    Vec<i64> v = Vec::filled(5, 2: i64);
    Vec<ref<i64, exclusive>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &mut v[3]);
    }
    printf("%v\n", Option::is_some(&Vec::position(&v, [](ref<i64, shared> x) : bool { *x == 9 })));
    *held[0] = 1;
    0
}
