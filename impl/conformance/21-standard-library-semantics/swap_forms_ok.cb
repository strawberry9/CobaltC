// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.swap [Swap-Places]; D-0022, D-0235; conf.swap-forms
// kind: positive
// expect: ok
// expect-stdout-hex: 372031203220322031206220747275650a
//
// The forms of exchange D-0235 leaves as they were: two locals, a place
// with itself (no access), two fields of one struct, `replace` through a
// reference with no other live path, `Vec::swap` of resource elements, and
// `replace` of an `Option<String>`.

import std;

struct P
{
    i32 a;
    i32 b;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    swap(&mut x, &mut y);
    swap(&mut x, &mut x);
    auto r = &mut x;
    i32 old = replace(r, 7);
    P p = P { .a = 1, .b = 2 };
    swap(&mut p.a, &mut p.b);
    Vec<String> v = Vec::new();
    Vec::push(&mut v, String::from_str("a"));
    Vec::push(&mut v, String::from_str("b"));
    Vec::swap(&mut v, 0, 1);
    Option<String> o = Some(String::from_str("z"));
    Option<String> t = replace(&mut o, None);
    printf("%v %v %v %v %v %v %v\n", x, y, old, p.a, p.b, String::as_view(&v[0]), Option::is_some(&t));
}
