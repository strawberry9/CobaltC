// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.swap [Swap-Places] [Swap-Places-Conflict]; D-0235; CHG-0371; conf.replace-struct-beside-field-reborrow
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// `replace(r, v)` writes the whole of `*r`: a live shared reborrow of one
// of its fields conflicts with that write, for a struct of plain data too.

import std;

struct P
{
    i32 a;
    i32 b;
}

fn main()
{
    P x = P { .a = 1, .b = 2 };
    auto r = &mut x;
    auto s = &(*r).a;
    P old = replace(r, P { .a = 7, .b = 8 });
    printf("%v %v\n", *s, old.a);
}
