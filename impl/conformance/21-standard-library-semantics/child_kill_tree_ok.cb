// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.process `Child::kill_tree` (D-0205); conf.child-kill-tree
// kind: positive
// expect: ok
// platform: linux
// expect-stdout-hex: 736c65657073206c6566743a20300a
//
// `Child::kill_tree` ends the child and the processes it started: a shell
// waiting on two `sleep`s it began is ended with both of them, and a
// second shell then finds no `sleep 47` left.

import std;

fn main()
{
    Command c = Command::new("/bin/sh");
    Command::arg(&mut c, "-c");
    Command::arg(&mut c, "sleep 47 & sleep 47 & wait");
    Child ch = Result::unwrap(Command::spawn(&c));
    sleep_ms(300);
    Result::unwrap(Child::kill_tree(&mut ch));
    _ = Child::wait(&mut ch);
    Command look = Command::new("/bin/sh");
    Command::arg(&mut look, "-c");
    Command::arg(&mut look, "sleep 0.2; ps -eo args | grep -c '^sleep 47$'");
    Output { status, stdout, stderr } = Result::unwrap(Command::output(&look));
    printf("sleeps left: %s", &Result::unwrap(String::from_utf8(stdout)));
}
