// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.file-handle [File-Read-Line] (D-0200); conf.file-read-line-utf8-error
// kind: positive
// expect: ok
// expect-stdout-hex: 6c696e65205b6f6b5d0a7574663820617420300a6c696e65205b6c6173745d0a656e640a
// args: $TMP
//
// Argument 0 is a fresh, empty directory. A file holding `ok\n`, a line
// starting with a byte that is not UTF-8, and `last` with no `\n` reads
// as `ok`, then `Err(Utf8)` at offset 0 (the bad line consumed), then
// `last`, then `Ok(None)`.

import std;

fn show(ref<File, exclusive> f)
{
    match (File::read_line(f))
    {
        Ok(Some(s))             : printf("line [%s]\n", &s),
        Ok(None)                : printf("end\n"),
        Err(FileError::Utf8(e)) : printf("utf8 at %v\n", e.offset),
        Err(_)                  : printf("other\n"),
    }
}

fn main() : u8
{
    String dir = Result::unwrap(arg(0));
    String path = path_join(String::as_view(&dir), StringView::of("t.txt"));
    File w = Result::unwrap(File::create(String::as_view(&path)));
    Vec<u8> bytes = Vec::new();
    Vec::push(&mut bytes, b'o');
    Vec::push(&mut bytes, b'k');
    Vec::push(&mut bytes, 10);
    Vec::push(&mut bytes, 255);
    Vec::push(&mut bytes, b'A');
    Vec::push(&mut bytes, 10);
    Vec::push(&mut bytes, b'l');
    Vec::push(&mut bytes, b'a');
    Vec::push(&mut bytes, b's');
    Vec::push(&mut bytes, b't');
    Result::unwrap(File::write(&mut w, &bytes[0..$]));
    Result::unwrap(File::close(w));
    File r = Result::unwrap(File::open(String::as_view(&path)));
    for (usize i = 0; i < 4; i += 1)
    {
        show(&mut r);
    }
    0
}
