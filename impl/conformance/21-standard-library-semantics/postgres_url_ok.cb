// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.postgres [Pg-Url] [Pg-Query] (D-0180); conf.postgres-url, conf.postgres-values
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// `PgUrl::parse`: a full URL, the defaults (port 5432, the database the
// user, verify-full), a bracketed IPv6 host, percent-encoded user,
// password and database, `postgresql://`, sslmode=disable; refused: a
// wrong scheme, no user, no host, a bad port, an unknown sslmode and an
// unknown query key. The text each `PgValue` is sent as.

import std;

fn mode_text(PgSslMode m) : str
{
    match (m)
    {
        Disable    : "disable",
        VerifyFull : "verify-full",
    }
}

fn password_text(ref<Option<String>, shared> p) : StringView
{
    match (p)
    {
        Some(s) : String::as_view(s),
        None    : StringView::of("-"),
    }
}

fn show(str url)
{
    match (PgUrl::parse(StringView::of(url)))
    {
        Ok(u) : printf(
            "%s -> user=%s password=%s host=%s port=%u database=%s sslmode=%s\n",
            url,
            &u.user,
            password_text(&u.password),
            &u.host,
            u.port,
            &u.database,
            mode_text(u.sslmode),
        ),
        Err(e) : printf("%s -> %s\n", url, &PgError::text(&e)),
    }
}

fn value(str label, PgValue v)
{
    match (PgValue::text(&v))
    {
        Some(t) : printf("%s: [%s]\n", label, &t),
        None    : printf("%s: NULL\n", label),
    }
}

fn main() : u8
{
    show("postgres://alice:s3cret@db.example.com:5433/shop?sslmode=disable");
    show("postgres://alice@db.example.com");
    show("postgresql://alice:pw@[::1]:6000/x?sslmode=verify-full");
    show("postgres://al%40ice:p%3Aw%2Fd@localhost/my%20db");
    show("postgres://bob:@localhost/");
    show("postgres://bob:pw@localhost/?sslmode=disable");
    printf("\n");
    show("mysql://alice@localhost/db");
    show("postgres://localhost/db");
    show("postgres://alice@/db");
    show("postgres://alice@localhost:port/db");
    show("postgres://alice@localhost/db?sslmode=require");
    show("postgres://alice@localhost/db?sslmod=disable");
    show("postgres://alice@localhost/db?sslmode=disable&timeout=3");
    show("postgres://al%zzice@localhost/db");
    printf("\n");
    value("null", Null);
    value("text", Text(String::from_str("it's")));
    value("int", Int(-42));
    value("float", Float(2.5));
    value("float tenth", Float(0.1));
    value("float inf", Float(1.0 / 0.0));
    value("float -inf", Float(-1.0 / 0.0));
    value("float nan", Float(0.0 / 0.0));
    value("bool t", Bool(true));
    value("bool f", Bool(false));
    value("bytes", Bytes(Vec::from_slice(&b"\x00\x01\xff"[0..$])));
    value("bytes empty", Bytes(Vec::new()));
    0
}
