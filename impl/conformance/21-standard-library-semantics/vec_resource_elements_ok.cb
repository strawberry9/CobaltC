// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §1 Vec; conf.vec-resource-elements
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// Vec<String> and Vec<resource> through swap, reverse, insert (front,
// middle, end), remove, pop (Some and None), truncate, clear: destructors
// run in the prelude's order (last first for truncate and clear), the
// moved-out values intact (D-0192)

import std;

resource struct Noisy
{
    i64 id;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("drop %v ", self.id);
}

fn show(ref<Vec<String>, shared> v) : String
{
    String s = String::new();
    foreach (x in v)
    {
        String::append(&mut s, x);
        String::append(&mut s, ",");
    }
    s
}

fn main()
{
    Vec<String> v = Vec::new();
    foreach (i in 0..6)
    {
        Vec::push(&mut v, sprintf("s%v", i));
    }
    Vec::swap(&mut v, 0, 5);
    Vec::reverse(&mut v);
    Vec::insert(&mut v, 2, String::from_str("new"));
    Vec::insert(&mut v, 0, String::from_str("first"));
    Vec::insert(&mut v, Vec::len(&v), String::from_str("last"));
    printf("%s\n", &show(&v));
    String r = Vec::remove(&mut v, 3);
    printf("removed %s; %s\n", &r, &show(&v));
    match (Vec::pop(&mut v))
    {
        Some(x) : printf("popped %s\n", &x),
        None    : printf("none\n"),
    }
    Vec::truncate(&mut v, 4);
    printf("%s %v\n", &show(&v), Vec::len(&v));
    Vec::clear(&mut v);
    printf("cleared %v\n", Vec::len(&v));
    match (Vec::pop(&mut v))
    {
        Some(x) : printf("popped %s\n", &x),
        None    : printf("empty pop\n"),
    }
    Vec<Noisy> ns = Vec::new();
    foreach (i in 0..6: i64)
    {
        Vec::push(&mut ns, Noisy { .id = i });
    }
    Vec::swap(&mut ns, 1, 4);
    Vec::reverse(&mut ns);
    Vec::insert(&mut ns, 1, Noisy { .id = 99 });
    printf("\n");
    Noisy gone = Vec::remove(&mut ns, 0);
    printf("removed %v\n", gone.id);
    Vec::truncate(&mut ns, 3);
    printf("\ntruncated\n");
    match (Vec::pop(&mut ns))
    {
        Some(n) : printf("popped %v\n", n.id),
        None    : {},
    }
    printf("\n");
    Vec::clear(&mut ns);
    printf("\ncleared\n");
    Vec::push(&mut ns, Noisy { .id = 7 });
}
