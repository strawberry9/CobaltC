// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Hkdf-Expand-Label] (D-0161); conf.hkdf-expand-label
// kind: positive
// expect: ok
// expect-stdout-hex: 6561726c793a20747275650a646572697665643a20747275650a6b65793a20747275650a69763a20747275650a74726166666963207570643a20747275650a
//
// TLS 1.3's key schedule pieces: the early secret and its "derived"
// secret are RFC 8448's (§3); traffic key, IV and key update from a fixed
// secret against an independent HKDF over Python's hmac.

import std;

fn main() : u8
{
    Vec<u8> none = Vec::new();
    array<u8, 32> zeros = [0; 32];
    array<u8, 32> early = hkdf_extract(&none[0..$], &zeros[0..$]);
    array<u8, 32> empty_hash = sha256(&none[0..$]);
    Vec<u8> derived = hkdf_expand_label(&early[0..$], "derived", &empty_hash[0..$], 32);
    printf(
        "early: %v\n",
        String::eq_str(&to_hex(&early[0..$]), "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a"),
    );
    printf(
        "derived: %v\n",
        String::eq_str(&to_hex(&derived[0..$]), "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba"),
    );
    Vec<u8> secret = Vec::new();
    for (u8 i = 0; i < 32; i += 1)
    {
        Vec::push(&mut secret, i);
    }
    printf(
        "key: %v\n",
        String::eq_str(
            &to_hex(&hkdf_expand_label(&secret[0..$], "key", &none[0..$], 32)[0..$]),
            "2ffbc449e87844051c7768f61ffd8ad070830f01ec2c520ef65f08e8296dffa0",
        ),
    );
    printf(
        "iv: %v\n",
        String::eq_str(
            &to_hex(&hkdf_expand_label(&secret[0..$], "iv", &none[0..$], 12)[0..$]),
            "2f41c846a431a163814bcd71",
        ),
    );
    printf(
        "traffic upd: %v\n",
        String::eq_str(
            &to_hex(&hkdf_expand_label(&secret[0..$], "traffic upd", &none[0..$], 32)[0..$]),
            "2cecd0a17506ef5fa73edc062d6e7b5397cf074ec1b4d8f99a120772932f0b45",
        ),
    );
    0
}
