// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.hashmap (`HashMap::get_mut(&mut x, k)` while a shared path to `x` is kept where only the run sees it, D-0222, CHG-0261); conf.hashmap-get-mut-local-while-shared-path-kept
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// `keep` holds a shared reference to `m`, which the flow analysis does not
// follow into the vector's element. `HashMap::get_mut(&mut m, &k)` then
// borrows `m` exclusively: the borrow meets the kept reference at the call.
// `cobc` leaves the body's own check of `m.values` out when the call has
// checked `&mut m` itself (D-0222's `_x` variants); this case keeps that
// call-site check honest.

import std;

fn main()
{
    HashMap<String, u32> m = HashMap::new();
    String a = "a";
    _ = HashMap::insert(&mut m, a, 1);
    String k = "a";
    Vec<ref<HashMap<String, u32>, shared>> keep = Vec::new();
    Vec::push(&mut keep, &m);
    match (HashMap::get_mut(&mut m, &k))
    {
        Some(c) : { *c += 1; },
        None    : {},
    }
    printf("%v\n", HashMap::len(*Vec::index_shared(&keep, 0)));
}
