// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.args [Args-Flag] [Args-Option] (report 330); conf.args-declared-twice
// kind: negative
// expect: diag.assert-failed (dynamic)
//
// Two declarations with the same short letter: the second is refused at
// its call (the first would take every `-v`, and the help list two).

import std;

fn main()
{
    Args a = Args::from(Vec::new(), "prog");
    bool verbose = Args::flag(&mut a, "verbose", "v", "say more");
    Option<String> version = Args::option(&mut a, "version", "v", "V", "the version to build");
    printf("%v %v\n", verbose, Option::is_some(&version));
}
