// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `Vec::extend_from` (D-0112), rule.agg.slice `[Write-Conflict]`, D-0107; conf.vec-extend-from-alias-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `std`'s own `Vec::extend_from` given a slice of the vector it extends:
// the slice's first element is read while the exclusive borrow of the
// vector is live, and the two clash, as with a loop written by hand
// (`conf.slice-argument-held-across-push-rejected`). An empty slice reads
// nothing and extends nothing.
//
// D-0282: the static pass rejects this program before it runs (it was found
// at run time before): `Vec::extend_from` writes `a` through argument 1,
// which argument 2 also reaches.

import std;

fn main()
{
    Vec<u8> a = Vec::filled(3, 7: u8);
    Vec::extend_from(&mut a, &a[1..1]);
    printf("%u\n", Vec::len(&a));
    Vec::extend_from(&mut a, &a[0..2]);
    printf("%u\n", Vec::len(&a));
}
