// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `Vec::reserve` (D-0129): `len + n` overflowing `usize`; conf.vec-reserve-overflow
// kind: negative
// expect: diag.arith-overflow (dynamic)
//
// Room for more than `usize` can count is an arithmetic overflow, found
// before anything is allocated.

import std;

fn main()
{
    Vec<u8> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::reserve(&mut v, max_value<usize>());
}
