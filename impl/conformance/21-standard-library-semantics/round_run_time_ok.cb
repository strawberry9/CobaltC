// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.arith.float-fns (D-0091, D-0255); conf.round-run-time
// kind: positive
// expect: ok
// expect-stdout-hex: 302e30202d302e3020332e30202d332e300a343530333539393632373337303439372e30202d312e3020312e300a302e3020322e30202d312e300a
//
// `round` halves away from zero at values the C compiler cannot fold:
// the largest double below 0.5 rounds to 0 (a C library's `round` on
// Windows gave 1), and a value past 2^52 is already whole.

import std;

// The same values whatever the arguments, but read only at run time.
fn pick(f64 x) : f64
{
    if (arg_count() > 99)
    {
        return 0.0;
    }
    x
}

fn pick32(f32 x) : f32
{
    if (arg_count() > 99)
    {
        return 0.0: f32;
    }
    x
}

fn main()
{
    printf(
        "%v %v %v %v\n",
        round(pick(0.49999999999999994)),
        round(pick(-0.49999999999999994)),
        round(pick(2.5)),
        round(pick(-2.5)),
    );
    printf("%v %v %v\n", round(pick(4503599627370497.0)), round(pick(-0.5)), round(pick(1.4999999999999998)));
    printf("%v %v %v\n", round(pick32(0.49999997: f32)), round(pick32(1.5: f32)), round(pick32(-0.5: f32)));
}
