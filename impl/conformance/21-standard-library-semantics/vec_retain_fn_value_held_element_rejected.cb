// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `retain`, [Read-Conflict]; conf.vec-retain-fn-value-held-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// retain with a fn value holding a named function: its borrow of v[3] for
// the predicate meets a live exclusive reference to it.

import std;

fn small(ref<i64, shared> x) : bool
{
    *x < 3
}

fn main() : u8
{
    Vec<i64> v = Vec::filled(5, 2: i64);
    Vec<ref<i64, exclusive>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &mut v[3]);
    }
    fn(ref<i64, shared>) : bool p = small;
    Vec::retain(&mut v, p);
    *held[0] = 1;
    0
}
