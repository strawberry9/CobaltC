// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: §0 the frozen module map (D-0223); `[Resolve-Unqualified]`; conf.std-error-wrapper-variants-unique
// kind: positive
// expect: ok
// expect-stdout-hex: 636c6f7365640a746c7320636f6e6e656374696f6e20726566757365640a6e65742074696d6564206f75740a756e6b6e6f776e20686f73740a544c532068616e647368616b65206661696c65640a
//
// The variants that wrap another module's error carry their own enum's
// name (D-0223): `TlsNetFailure`, `HttpNetFailure`, `HttpTlsFailure`,
// `PgNetFailure`, `PgTlsFailure`. Each is unique in `std`, so it is
// written unqualified, as a value and as a pattern; before D-0223 three
// enums shared `NetFailure` and two `TlsFailure`, and a bare one was
// `diag.ambiguous-name`.
import std;

fn kind(ref<HttpError, shared> e) : str
{
    match (e)
    {
        HttpNetFailure(_) : "net",
        HttpTlsFailure(_) : "tls",
        _                 : "other",
    }
}

fn main()
{
    TlsError t = TlsNetFailure(Closed);
    HttpError h = HttpTlsFailure(TlsNetFailure(Refused));
    HttpError n = HttpNetFailure(TimedOut);
    PgError p = PgNetFailure(UnknownHost);
    PgError q = PgTlsFailure(HandshakeFailed);
    printf("%v\n", TlsError::text(&t));
    printf("%v %v\n", kind(&h), HttpError::text(&h));
    printf("%v %v\n", kind(&n), HttpError::text(&n));
    printf("%v\n", &PgError::text(&p));
    printf("%v\n", &PgError::text(&q));
}
