// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.fs `FileError`, rule.stdlib.net `NetError` (D-0332 §2.12, issue 041; reports 076, 095, 096, 326); conf.error-variants-text
// kind: positive
// expect: ok
//
// The variants `FileError` and `NetError` gained for the common causes the
// system reports (a directory where a file is needed, a full device, too
// many files open, a datagram too large) each have their own text, and a
// `match` names them as any other variant.

import std;

fn kind(ref<FileError, shared> e) : str
{
    match (e)
    {
        FileError::IsDirectory    : "directory",
        FileError::NotDirectory   : "not a directory",
        FileError::NoSpace        : "full",
        FileError::TooManyOpen    : "too many",
        FileError::NotEmpty       : "not empty",
        FileError::LinkLoop       : "loop",
        FileError::SameFile       : "same",
        FileError::CrossDevice    : "other file system",
        FileError::NameTooLong    : "long name",
        FileError::InvalidName    : "invalid",
        FileError::NotOpenForThat : "not open for that",
        FileError::ArgsTooLong    : "too many arguments",
        _                         : "other",
    }
}

fn main()
{
    Vec<FileError> fs = Vec::new();
    Vec::push(&mut fs, FileError::IsDirectory);
    Vec::push(&mut fs, FileError::NotDirectory);
    Vec::push(&mut fs, FileError::NoSpace);
    Vec::push(&mut fs, FileError::TooManyOpen);
    Vec::push(&mut fs, FileError::NotEmpty);
    Vec::push(&mut fs, FileError::LinkLoop);
    Vec::push(&mut fs, FileError::SameFile);
    Vec::push(&mut fs, FileError::CrossDevice);
    Vec::push(&mut fs, FileError::NameTooLong);
    Vec::push(&mut fs, FileError::InvalidName);
    Vec::push(&mut fs, FileError::NotOpenForThat);
    Vec::push(&mut fs, FileError::ArgsTooLong);
    Vec::push(&mut fs, FileError::NotFound);
    foreach (e in &fs)
    {
        printf("%s: %s\n", kind(e), FileError::text(e));
    }
    Vec<NetError> ns = Vec::new();
    Vec::push(&mut ns, NetError::NoDescriptors);
    Vec::push(&mut ns, NetError::MessageTooLong);
    foreach (e in &ns)
    {
        printf("%s\n", NetError::text(e));
    }
}
