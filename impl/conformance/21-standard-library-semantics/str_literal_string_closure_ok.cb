// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str [Str-Literal-String] (D-0304): a closure declared `: String`; conf.str-literal-string-closure
// kind: positive
// expect: ok
// stdout: a b
//
// What a closure declared `: String` gives, by `return` or as its tail,
// is a `String`, as for a function so declared (D-0149).

import std;

fn main()
{
    auto pick = [](bool c) : String
    {
        if (c)
        {
            return "a";
        }
        "b"
    };
    String x = pick(true);
    String y = pick(false);
    printf("%s %s\n", &x, &y);
}
