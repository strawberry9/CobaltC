// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Rsa-Generate] [Crypto-Length] (D-0169); conf.rsa-generate-size
// kind: negative
// expect: diag.crypto-length (dynamic)
//
// 1000 bits is not a key size: below 1024 and not a multiple of 64. (A key
// is generated and used by the stress harness, stress/d0166; it takes
// minutes under an interpreter.)

import std;

fn main() : u8
{
    RsaPrivateKey k = rsa_generate_key(1000);
    printf("%v\n", BigUint::bit_len(&k.n));
    0
}
