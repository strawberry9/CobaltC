// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.type.probe `probe<K>` (D-0312): a struct key is probed by reference, `&k`; conf.probe-struct-key-by-value-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//

import std;

struct P
{
    i32 x;
}

fn main()
{
    HashMap<P, i32> m = HashMap::new();
    HashMap::insert(&mut m, P { .x = 1 }, 2);
    P k = P { .x = 1 };
    bool b = HashMap::contains(&m, k);
}
