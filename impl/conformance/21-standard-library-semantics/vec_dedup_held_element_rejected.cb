// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `dedup`, [Borrow-Denied]; conf.vec-dedup-held-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// Vec::dedup moves a kept element into v[2]'s place by a swap whose
// exclusive borrow clashes with a live shared reference to v[2].

import std;

fn main() : u8
{
    Vec<i64> v = Vec::new();
    foreach (i in 0..6: i64)
    {
        Vec::push(&mut v, i / 2);
    }
    Vec<ref<i64, shared>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &v[2]);
    }
    Vec::dedup(&mut v);
    printf("after %v\n", *held[0]);
    0
}
