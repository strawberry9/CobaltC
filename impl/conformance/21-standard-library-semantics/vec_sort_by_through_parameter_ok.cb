// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `sort_by`; conf.vec-sort-by-through-parameter
// kind: positive
// expect: ok
// expect-stdout-hex: 323c3020313c3420303c3320313c3020313c3220343c3220303c3020303c3120333c3120333c3220333c34200a30203220340a
//
// Vec::sort_by with a closure literal on a vector reached through an
// exclusive reference parameter: the comparisons are made in the
// prelude's order (the comparator prints each), and the result is sorted
// stably. (cobc compiles the closure into its sort, for a local since
// D-0062 and through a parameter since D-0189.)

import std;

fn order(ref<Vec<i64>, exclusive> v)
{
    Vec::sort_by(v, [](ref<i64, shared> a, ref<i64, shared> b) : bool { printf("%v<%v ", *a, *b); *a < *b });
    printf("\n");
}

fn main()
{
    Vec<i64> v = Vec::new();
    foreach (i in 0..6: i64)
    {
        Vec::push(&mut v, (i * 7) % 5);
    }
    order(&mut v);
    printf("%v %v %v\n", v[0], v[3], v[5]);
}
