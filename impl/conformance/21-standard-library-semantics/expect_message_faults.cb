// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §0 `Result::expect` (D-0082); conf.expect-message
// kind: negative
// expect: diag.unwrap-failed (dynamic)
//
// `expect` of an `Err` faults at the call, with the program's message.

import std;

fn main()
{
    Result<u32, ParseError> r = String::parse<u32>(&String::from_str("12x"));
    u32 n = Result::expect(r, "the count must be a number");
}
