// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: `[Bytes-LE]` (D-0119): fewer than sizeof<T>() bytes from `at`; conf.bytes-short-buffer-faults
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)

import std;

fn main()
{
    Vec<u8> v = Vec::filled(3, 1: u8);
    u16 a = read_le<u16>(&v[0..$], 1);              // bytes 1, 2: fine
    u16 b = read_le<u16>(&v[0..$], 2);              // one byte left
}
