// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.process [Interrupt-Flag] (D-0143); conf.interrupt-flag
// kind: positive
// expect: ok
// expect-stdout-hex: 6265666f7265207761746368696e673a2066616c73650a7761746368696e673a2066616c73650a
//
// Watching interrupts changes nothing until one arrives: the flag is
// false. (Sending one is tested outside the suite, by a program that
// signals itself through a child.)

import std;

fn main()
{
    printf("before watching: %v\n", interrupt_requested());
    watch_interrupts();
    printf("watching: %v\n", interrupt_requested());
}
