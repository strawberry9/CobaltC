// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec (push, growth, index_shared)
// kind: positive
// expect: ok
//
// Vec grows across its capacity-doubling boundary (0 -> 4 -> 8) while
// preserving every previously-pushed element's value.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    i32 i = 0;
    while (i < 9)
    {
        Vec::push(&mut v, i);
        i = i + 1;
    }
    if (Vec::len(&v) != 9)
    {
        1 / (1 - 1);
    }
    if (*Vec::index_shared(&v, 8) != 8)
    {
        1 / (1 - 1);
    }
    if (*Vec::index_shared(&v, 0) != 0)
    {
        1 / (1 - 1);
    }
}
