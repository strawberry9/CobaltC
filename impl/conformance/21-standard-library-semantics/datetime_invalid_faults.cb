// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.time [Invalid-DateTime] (D-0140); conf.datetime-invalid
// kind: negative
// expect: diag.invalid-datetime (dynamic)
//
// A struct literal can hold a month 13; `to_unix` of it is misuse.

import std;

fn main()
{
    DateTime t = DateTime { .year = 2026, .month = 13, .day = 1, .hour = 0, .minute = 0, .second = 0 };
    i64 s = DateTime::to_unix(&t);
}
