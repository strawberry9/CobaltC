// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: D-0023 D-0018 rule.alias.borrow
// kind: positive
// expect: ok
//
// Elements read and written at once while another Vec holds a shared
// reference to element 0: a read of element 0 and a write of element 1
// agree with it, and the held reference still reads the value it saw.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    Vec<ref<i32, shared>> h = Vec::new();
    Vec::push(&mut h, Vec::index_shared(&v, 0));
    i32 a = *Vec::index_shared(&v, 0);
    *Vec::index_exclusive(&mut v, 1) = 7;
    i32 b = **Vec::index_shared(&h, 0);
    if (a + b + *Vec::index_shared(&v, 1) != 9)
    {
        1 / (1 - 1);
    }
}
