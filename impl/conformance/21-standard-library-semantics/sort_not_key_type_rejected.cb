// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.sort [Sort-Not-Key]; D-0062; conf.sort-not-key-type
// kind: negative
// expect: diag.type-mismatch (static)
//
// `Vec::sort` orders the key types (and, since D-0181, floats) only; a
// struct with a float field has no such order (`sort_by` with a
// comparison is the way).

import std;

struct Reading
{
    f64 value;
}

fn main()
{
    Vec<Reading> v = Vec::new();
    Vec::push(&mut v, Reading { .value = 1.5 });
    Vec::sort(&mut v);
}
