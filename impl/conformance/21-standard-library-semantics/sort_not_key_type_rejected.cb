// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.sort [Sort-Not-Key]; D-0062; conf.sort-not-key-type
// kind: negative
// expect: diag.type-mismatch (static)
//
// `Vec::sort` orders the key types only; an `f64` has no such order
// (`sort_by` with a comparison is the way).

import std;

fn main()
{
    Vec<f64> v = Vec::new();
    Vec::push(&mut v, 1.5);
    Vec::sort(&mut v);
}
