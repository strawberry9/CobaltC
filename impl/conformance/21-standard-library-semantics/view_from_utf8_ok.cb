// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview `StringView::from_utf8` (D-0205); conf.view-from-utf8
// kind: positive
// expect: ok
// expect-stdout-hex: 68c3a96c6c6f2c20362062797465730a6e6f74205554462d3820617420320a7061727420c3a90a
//
// `StringView::from_utf8` views bytes as text without copying them, after
// the check `String::from_utf8` makes; bytes that are not UTF-8 give the
// offset of the first bad one.

import std;

fn main()
{
    Vec<u8> good = Vec::new();
    Vec::extend_from(&mut good, StringView::as_bytes("héllo"));
    Vec<u8> bad = Vec::clone(&good);
    bad[2] = 0xff;
    match (StringView::from_utf8(&good[0..$]))
    {
        Ok(t)  : printf("%v, %v bytes\n", t, StringView::len(t)),
        Err(e) : printf("error at %v\n", e.offset),
    }
    match (StringView::from_utf8(&bad[0..$]))
    {
        Ok(t)  : printf("accepted %v\n", t),
        Err(e) : printf("not UTF-8 at %v\n", e.offset),
    }
    match (StringView::from_utf8(&good[1..3]))
    {
        Ok(t)  : printf("part %v\n", t),
        Err(e) : printf("part not UTF-8 at %v\n", e.offset),
    }
}
