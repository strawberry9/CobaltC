// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.json [Json-Parse] [Json-Text] [Json-Pretty] [Json-Get] [Json-Set] [Json-Error] (D-0182); conf.json-parse, conf.json-text, conf.json-tree, conf.json-errors
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// A document read and written back compact and indented, every kind of
// value, every escape (a surrogate pair joined, a lone surrogate U+FFFD),
// numbers whole and not, the tree read with `get`/`at`/`as_*`, built
// with `set`/`push`, and each kind of refusal with its position.

import std;

fn show(Result<Json, ParseError> r) : String
{
    match (r)
    {
        Ok(j) : Json::text(&j),
        Err(e) : match (e)
        {
            Empty      : String::from_str("empty"),
            Invalid(i) : sprintf("invalid at %v", i),
            OutOfRange : String::from_str("out of range"),
        },
    }
}

fn main()
{
    String src = " {\"name\": \"Ada\", \"age\": 36, \"tags\": [\"x\", \"y\\u00e9\\ud83d\\ude00\\n\\\"\\\\\\/\\b\\f\\r\\t\\u0001\"], \"ok\": true, \"none\": null, \"pi\": 3.25e0, \"big\": 1e21, \"neg\": -0.5, \"zero\": -0, \"empty\": {}, \"list\": [], \"lone\": \"\\ud800x\"} ";
    Json j = Result::unwrap(Json::parse(String::as_view(&src)));
    String compact = Json::text(&j);
    printf("%v\n", &compact);
    printf("%v\n", String::eq(&Json::text(&Result::unwrap(Json::parse(String::as_view(&compact)))), &compact));
    printf("%v\n", &Json::pretty(&j));
    printf(
        "%v %v %v %v\n",
        Option::unwrap_or(Json::as_text(Option::unwrap(Json::get(&j, "name"))), StringView::of("?")),
        Option::unwrap_or(Json::as_i64(Option::unwrap(Json::get(&j, "age"))), 0),
        Option::unwrap_or(Json::as_f64(Option::unwrap(Json::get(&j, "pi"))), 0.0),
        Option::unwrap_or(Json::as_bool(Option::unwrap(Json::get(&j, "ok"))), false),
    );
    printf(
        "%v %v %v %v\n",
        Json::is_null(Option::unwrap(Json::get(&j, "none"))),
        Option::is_none(&Json::get(&j, "missing")),
        Option::is_none(&Json::as_i64(Option::unwrap(Json::get(&j, "pi")))),
        Option::is_none(&Json::as_i64(Option::unwrap(Json::get(&j, "big")))),
    );
    ref<Json, shared> tags = Option::unwrap(Json::get(&j, "tags"));
    printf(
        "%v %v %v %v\n",
        Vec::len(Option::unwrap(Json::as_array(tags))),
        Option::unwrap_or(Json::as_text(Option::unwrap(Json::at(tags, 0))), StringView::of("?")),
        Option::is_none(&Json::at(tags, 2)),
        Option::is_none(&Json::at(&j, 0)),
    );
    printf("%v %v\n", Vec::len(Option::unwrap(Json::as_object(&j))), Option::is_none(&Json::as_object(tags)));
    Json obj = JsonObject(Vec::new());
    Json arr = JsonArray(Vec::new());
    Json::push(&mut arr, JsonNumber(1.0));
    Json::push(&mut arr, JsonNumber(2.5));
    Json::push(&mut arr, JsonNumber(0.0 / 0.0));
    Json::push(&mut arr, JsonNumber(9007199254740993.0));
    Json::set(&mut obj, "a", arr);
    Json::set(&mut obj, "b", JsonText(String::from_str("tab\there")));
    Json::set(&mut obj, "a", JsonBool(false));
    Json::set(&mut obj, "c", JsonNull);
    printf("%v\n", &Json::text(&obj));
    printf("%v\n", &Json::pretty(&JsonArray(Vec::new())));
    foreach (bad in [
        "",
        "   ",
        "[1,]",
        "{\"a\" 1}",
        "tru",
        "\"abc",
        "[1] x",
        "1e999",
        "\"a\tb\"",
        "{\"k\":1,}",
        "01",
        "1.",
        "-",
        "[1 2]",
        "\"\\x\"",
        "\"\\u12G4\"",
        "nul",
        "[",
        "{\"a\":",
    ])
    {
        printf("%s | ", bad);
        printf("%v\n", &show(Json::parse(StringView::of(bad))));
    }
    String deep = String::new();
    foreach (i in 0..512)
    {
        String::append(&mut deep, "[");
    }
    foreach (i in 0..512)
    {
        String::append(&mut deep, "]");
    }
    printf("%v ", Result::is_ok(&Json::parse(String::as_view(&deep))));
    String deeper = String::from_str("[");
    String::append(&mut deeper, &deep);
    String::append(&mut deeper, "]");
    printf("%v\n", &show(Json::parse(String::as_view(&deeper))));
}
