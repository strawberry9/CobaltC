// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.read [Read]; read_line; conf.read-line-end-of-input
// kind: positive
// expect: ok
// stdin-hex:
// expect-stdout-hex: 646f6e650a
//
// Empty input: `read_line` is `Ok(None)` at once, and again on a second
// call -- the end of input is not an error and does not go away.

import std;

fn at_end() : bool
{
    match (read_line())
    {
        Ok(line) :
        {
            match (line)
            {
                Some(_) : false,
                None : true,
            }
        },
        Err(_) : false,
    }
}

fn main()
{
    if (!at_end() || !at_end())
    {
        1 / (1 - 1);
    }
    printf("done\n");
}
