// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: type.str; rule.type.is-resource; [Store-Binding-Place-Copy]; conf.str-copy-no-move; conf.str-literal-type
// kind: positive
// expect: ok
//
// A str is a plain value: binding it to a second name, passing it to
// functions, storing it in a struct field, and sending it to a thread
// all copy it, and every earlier binding remains valid -- no
// diag.stale-binding anywhere, no destructor ever runs.

struct Named
{
    str name;
    i32 n;
}

fn takes(str s) : usize
{
    str_len(s)
}

fn worker(str s) : usize
{
    str_len(s)
}

fn main()
{
    str s = "hi";
    str t = s;
    if (str_len(s) + str_len(t) != 4) { 1 / (1 - 1); }
    if (takes(s) != 2) { 1 / (1 - 1); }
    if (takes(s) != 2) { 1 / (1 - 1); }
    auto named = Named { .name = s, .n = 1 };
    auto copy = named;
    if (str_len(copy.name) != str_len(named.name)) { 1 / (1 - 1); }
    auto h = spawn(worker, s);
    if (join(h) != 2) { 1 / (1 - 1); }
    if (s != t) { 1 / (1 - 1); }
}
