// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.postgres [Pg-Cell] (D-0181); conf.postgres-typed-cells
// kind: positive
// expect: ok
// expect-stdout-hex: 3432202d37207472756520747275650a332e35207472756520696e66202d696e6620747275650a747275652066616c7365207472756520747275650a3030666631302074727565207472756520747275650a2d3120312e350a300a
//
// A row's cells read as values, in the server's text forms: integers,
// floats with PostgreSQL's spellings of the non-finite values, `t`/`f`,
// bytea's hex form (`\\x` alone is the empty bytea); NULL, a column past the end and text of another form
// are `None`.

import std;

fn main()
{
    Vec<Option<String>> cells = Vec::new();
    foreach (t in ["42", "-7", "3.5", "NaN", "Infinity", "-Infinity", "t", "f", "\\x00ff10", "\\xzz", "abc", "1.5"])
    {
        Vec::push(&mut cells, Some(String::from_str(t)));
    }
    Vec::push(&mut cells, None);
    Vec::push(&mut cells, Some(String::from_str("\\x")));
    PgRow r = PgRow { .cells = cells };
    printf(
        "%v %v %v %v\n",
        Option::unwrap_or(PgRow::get_i64(&r, 0), 0),
        Option::unwrap_or(PgRow::get_i64(&r, 1), 0),
        Option::is_none(&PgRow::get_i64(&r, 2)),
        Option::is_none(&PgRow::get_i64(&r, 12)),
    );
    printf(
        "%v %v %v %v %v\n",
        Option::unwrap_or(PgRow::get_f64(&r, 2), 0.0),
        is_nan(Option::unwrap_or(PgRow::get_f64(&r, 3), 0.0)),
        Option::unwrap_or(PgRow::get_f64(&r, 4), 0.0),
        Option::unwrap_or(PgRow::get_f64(&r, 5), 0.0),
        Option::is_none(&PgRow::get_f64(&r, 10)),
    );
    printf(
        "%v %v %v %v\n",
        Option::unwrap_or(PgRow::get_bool(&r, 6), false),
        Option::unwrap_or(PgRow::get_bool(&r, 7), true),
        Option::is_none(&PgRow::get_bool(&r, 0)),
        Option::is_none(&PgRow::get_bool(&r, 99)),
    );
    printf(
        "%v %v %v %v\n",
        &to_hex(&Option::unwrap_or(PgRow::get_bytes(&r, 8), Vec::new())[0..$]),
        Option::is_none(&PgRow::get_bytes(&r, 9)),
        Option::is_none(&PgRow::get_bytes(&r, 10)),
        Option::is_none(&PgRow::get_bytes(&r, 12)),
    );
    printf("%v %v\n", Option::unwrap_or(PgRow::get_i64(&r, 11), -1), Option::unwrap_or(PgRow::get_f64(&r, 11), -1.0));
    printf("%v\n", match (PgRow::get_bytes(&r, 13)) { Some(v) : Vec::len(&v), None : 99 });
}
