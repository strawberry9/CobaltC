// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: diag.index-out-of-bounds diag.narrowing-overflow
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// Element indices written as integer conversions: a `widen`, and a
// `narrow` that cannot fail, reach the elements they name; a fallible
// `narrow` that fits does too; then a `narrow` that cannot fail names an
// index past the end.

import std;

fn main()
{
    Vec<u32> v = Vec::new();
    Vec::push(&mut v, 7);
    Vec::push(&mut v, 9);
    u64 k = 1;
    u8 s = 0;
    i64 q = 1;
    u32 x = *Vec::index_shared(&v, narrow<usize>(k));
    u32 y = *Vec::index_shared(&v, widen<usize>(s));
    u32 w = *Vec::index_shared(&v, narrow<usize>(q));
    if (x + y + w != 25)
    {
        1 / (1 - 1);
    }
    u64 past = 2;
    u32 z = *Vec::index_shared(&v, narrow<usize>(past));
}
