// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.queue [Queue] (D-0137); conf.queue-fifo, conf.queue-empty
// kind: positive
// expect: ok
// expect-stdout-hex: 3120320a6c656e20382c2066726f6e7420332c206261636b2031300a33203420352036203720382039203130200a
//
// `push_back` and `pop_front` keep arrival order: first in, first out,
// also when elements are added while earlier ones are still being taken
// (the queue moves its back part to the front part as it empties).
// `front` and `back` look without taking; an empty queue gives `None`.

import std;

fn main()
{
    Queue<i32> q = Queue::new();
    assert(Queue::len(&q) == 0);
    assert(Option::is_none(&Queue::pop_front(&mut q)));
    assert(Option::is_none(&Queue::front(&q)) && Option::is_none(&Queue::back(&q)));
    for (i32 i = 1; i <= 3; i += 1)
    {
        Queue::push_back(&mut q, i);
    }
    printf("%d ", Option::unwrap(Queue::pop_front(&mut q)));
    printf("%d\n", Option::unwrap(Queue::pop_front(&mut q)));
    // Added while 3 is still waiting to be taken.
    for (i32 i = 4; i <= 10; i += 1)
    {
        Queue::push_back(&mut q, i);
    }
    printf("len %d, front %d, back %d\n", Queue::len(&q), *Option::unwrap(Queue::front(&q)), *Option::unwrap(Queue::back(&q)));
    while (Some(x) = Queue::pop_front(&mut q))
    {
        printf("%d ", x);
    }
    printf("\n");
    assert(Queue::len(&q) == 0 && Option::is_none(&Queue::pop_front(&mut q)));
}
