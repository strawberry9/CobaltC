// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: D-0023 D-0018 rule.alias.borrow [Borrow-Denied]; conf.vec-element-write-while-element-shared-held-dynamic
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// With a shared reference to element 1 held in another Vec, reading the
// element at once agrees with it; writing it does not.
//
// D-0290: the reference is stored by a call (`keep_in`), so the frame holds it
// only as `?` (it may hold none of it), and the run checks the access; the
// same program storing it directly is refuted before the run.

import std;

fn keep_in(ref<Vec<ref<i32, shared>>, exclusive> keep, ref<i32, shared> r)
{
    Vec::push(keep, r);
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    Vec<ref<i32, shared>> h = Vec::new();
    keep_in(&mut h, Vec::index_shared(&v, 1));
    i32 a = *Vec::index_shared(&v, 1);
    *Vec::index_exclusive(&mut v, 1) = 9;
}
