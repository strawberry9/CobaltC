// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `Vec::extend_from<T: clone>` (D-0112, D-0116); conf.vec-extend-from-resource-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// `extend_from` copies each element of the slice with `clone`; a `T` with
// no clone is rejected at the call (`Vec::append` moves them instead).

import std;

resource struct Handle
{
    u32 fd;
}

fn Handle::drop(ref<Handle, exclusive> self)
{
}

fn main()
{
    Vec<Handle> v = Vec::new();
    Vec::push(&mut v, Handle { .fd = 1 });
    Vec<Handle> w = Vec::new();
    Vec::extend_from(&mut w, &v[0..$]);
}
