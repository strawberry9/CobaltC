// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Blake2b] [Pbkdf2] [Argon2id] [Password-Hash] (D-0170); conf.blake2b-vectors, conf.pbkdf2-vectors, conf.argon2id-vectors, conf.password-hash
// kind: positive
// expect: ok
// slow: interpreted big-number arithmetic takes well over the 10-second budget
// expect-stdout-hex: 
//
// BLAKE2b: RFC 7693 Appendix A ("abc", 64 bytes), the empty message, a
// 20-byte digest, and the official keyed test (key 00..3f, empty message),
// streamed in pieces; PBKDF2-HMAC-SHA-256: RFC 7914 §11's first vector;
// Argon2id with small parameters, as the reference implementation
// (argon2-cffi) computes them; a PHC string from that implementation
// verifies with its password and not another, and a malformed one is false.

import std;

fn main() : u8
{
    printf("blake2b abc %s\n", &to_hex(&blake2b(&b"abc"[0..$], 64)[0..$]));
    Vec<u8> none = Vec::new();
    printf("blake2b empty %s\n", &to_hex(&blake2b(&none[0..$], 64)[0..$]));
    printf("blake2b-160 abc %s\n", &to_hex(&blake2b(&b"abc"[0..$], 20)[0..$]));
    Vec<u8> key = Vec::new();
    for (u8 i = 0; i < 64; i += 1)
    {
        Vec::push(&mut key, i);
    }
    Blake2b keyed = Blake2b::new_keyed(&key[0..$], 64);
    printf("blake2b keyed %s\n", &to_hex(&Blake2b::finish(keyed)[0..$]));
    Blake2b pieces = Blake2b::new(64);
    Blake2b::update(&mut pieces, &b"a"[0..$]);
    Blake2b::update(&mut pieces, &b"bc"[0..$]);
    printf("pieces agree %v\n", digest_eq(&Blake2b::finish(pieces)[0..$], &blake2b(&b"abc"[0..$], 64)[0..$]));
    printf("pbkdf2 %s\n", &to_hex(&pbkdf2(Sha2_256, &b"passwd"[0..$], &b"salt"[0..$], 1, 64)[0..$]));
    Vec<u8> pw = Vec::from_slice(&b"correct horse battery staple"[0..$]);
    Vec<u8> salt = Vec::from_slice(&b"somesalt12345678"[0..$]);
    printf("argon2id 1 %s\n", &to_hex(&argon2id(&pw[0..$], &salt[0..$], 1, 8, 1, 32)[0..$]));
    printf("argon2id 2 %s\n", &to_hex(&argon2id(&pw[0..$], &salt[0..$], 3, 32, 4, 32)[0..$]));
    StringView stored = "$argon2id$v=19$m=64,t=1,p=2$UFrMR9dIXVY$9Ovz4hZBCsn5wOejdF0dDQ";
    printf(
        "password %v %v %v %v\n",
        verify_password(stored, &b"pw-one"[0..$]),
        verify_password(stored, &b"pw-two"[0..$]),
        verify_password("$argon2i$v=19$m=64,t=1,p=2$UFrMR9dIXVY$9Ovz4hZBCsn5wOejdF0dDQ", &b"pw-one"[0..$]),
        verify_password("not a hash", &b"pw-one"[0..$]),
    );
    0
}
