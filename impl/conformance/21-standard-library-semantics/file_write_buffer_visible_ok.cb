// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.file-handle [File-Buffer] (D-0201); conf.file-write-buffer-visible
// kind: positive
// expect: ok
// expect-stdout-hex: 5b6162630a5d0a340a6c696e65205b6162635d0a3720370a5b6162630a6465666768695d0a
// args: $TMP
//
// Argument 0 is a fresh, empty directory. Bytes written to a `File` are
// buffered, but the program itself always sees them: through
// `read_file`, `file_info`, a second handle, the writing handle's own
// `position` and `len`, and after a handle is destroyed without `close`.

import std;

fn main() : u8
{
    String dir = Result::unwrap(arg(0));
    String p = path_join(String::as_view(&dir), StringView::of("t.txt"));
    File f = Result::unwrap(File::create(String::as_view(&p)));
    Result::unwrap(File::write_text(&mut f, "abc\n"));
    printf("[%s]\n", &Result::unwrap(read_file(String::as_view(&p))));
    printf("%v\n", Result::unwrap(file_info(String::as_view(&p))).len);
    File r = Result::unwrap(File::open(String::as_view(&p)));
    match (File::read_line(&mut r))
    {
        Ok(Some(l)) : printf("line [%s]\n", &l),
        _           : printf("no line\n"),
    }
    Result::unwrap(File::write_text(&mut f, "def"));
    printf("%v %v\n", Result::unwrap(File::position(&f)), Result::unwrap(File::len(&f)));
    {
        File g = Result::unwrap(File::append(String::as_view(&p)));
        Result::unwrap(File::write_text(&mut g, "ghi"));
    }
    printf("[%s]\n", &Result::unwrap(read_file(String::as_view(&p))));
    Result::unwrap(File::close(f));
    Result::unwrap(File::close(r));
    0
}
