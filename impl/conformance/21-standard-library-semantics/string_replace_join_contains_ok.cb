// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview: `contains`, `replace`, `join` (D-0139); conf.string-contains, conf.string-replace, conf.string-join
// kind: positive
// expect: ok
// expect-stdout-hex: 612063617420736174206f6e2061206d61740a74686520632073206f6e20746865206d0a6261206161616161610a68c3a96c6c6f20776f726c642068656c6c6f0a7468652d6361742d7361742d6f6e2d7468652d6d61740a746865205b5d0a78797a20782079207a0a
//
// `contains` is `find` with a `bool` answer; `replace` makes a new
// `String` with every occurrence of `from`, found left to right without
// overlap, replaced by `to` (an empty `from` occurs nowhere); `join`
// puts `sep` between the texts of a slice of views or of `String`s, so
// `split` and `join` round-trip.

import std;

fn main()
{
    String s = "the cat sat on the mat";
    assert(String::contains(&s, "cat") && String::contains(&s, "the mat") && String::contains(&s, ""));
    assert(!String::contains(&s, "dog"));
    assert(StringView::contains(&s[4..$], "sat") && !StringView::contains(&s[4..$], "the cat"));

    printf("%s\n", &String::replace(&s, "the", "a"));
    printf("%s\n", &String::replace(&s, "at", ""));
    assert(String::replace(&s, "", "x") == s);
    String aaa = "aaa";
    printf("%s %s\n", &String::replace(&aaa, "aa", "b"), &String::replace(&aaa, "a", "aa"));
    String uni = "héllo wörld";
    printf("%s %s\n", &String::replace(&uni, "ö", "o"), &StringView::replace(&uni[0..6], "é", "e"));
    String empty = String::new();
    assert(String::len(&String::replace(&empty, "a", "b")) == 0);

    Vec<StringView> parts = String::split(&s, " ");
    printf("%s\n", &StringView::join(&parts[0..$], "-"));
    printf("%s [%s]\n", &StringView::join(&parts[0..1], ", "), &StringView::join(&parts[0..0], ", "));
    Vec<String> owned = Vec::new();
    Vec::push(&mut owned, String::from_str("x"));
    Vec::push(&mut owned, String::from_str("y"));
    Vec::push(&mut owned, String::from_str("z"));
    printf("%s %s\n", &String::join(&owned[0..$], ""), &String::join(&owned[0..$], &s[3..4]));
    String csv = "a,b,,c";
    assert(StringView::join(&String::split(&csv, ",")[0..$], ",") == csv);
}
