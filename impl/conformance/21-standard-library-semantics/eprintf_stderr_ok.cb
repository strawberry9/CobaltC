// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.format [Eprintf]; conf.eprintf-stderr
// kind: positive
// expect: ok
// expect-stdout-hex: 6f757420310a6f757420322e350a
//
// `eprintf` writes `printf`'s text to standard error: standard output
// holds only the two `printf` lines. `impl/tests/print_output.rs`
// checks standard error, and cobc/tests/compiled_suite.rs that `cobc`'s
// standard error is `coby`'s.

import std;

fn main()
{
    printf("out %d\n", 1);
    eprintf("warning: %s at line %d\n", "odd input", 7);
    printf("out %v\n", 2.5);
}
