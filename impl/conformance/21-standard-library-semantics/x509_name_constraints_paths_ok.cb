    "GD5HQ+fhYtC7I1rOHjb22mOJTP65UCpTSiDv4eM=\n"
    "-----END CERTIFICATE-----\n";
fn cert(str pem) : Certificate
{
    Vec<Certificate> v = certificates_from_pem(StringView::of(pem));
    Vec::remove(&mut v, 0)
}

fn check(str what, str leaf, slice<str, shared> mids, str root, str host)
{
    Vec<Certificate> ms = Vec::new();
    foreach (m in mids)
    {
        Vec::push(&mut ms, cert(*m));
    }
    TrustStore roots = TrustStore { .roots = Vec::new() };
    Vec::push(&mut roots.roots, cert(root));
    DateTime now = Option::unwrap(DateTime::new(2030, 1, 1, 0, 0, 0));
    match (verify_chain(&cert(leaf), &ms, &roots, StringView::of(host), &now))
    {
        Ok(_)  : printf("%-44s ok\n", what),
        Err(e) : printf("%-44s %s\n", what, CertError::text(&e)),
    }
}

fn main() : u8
{
    array<str, 0> none = [];
    check("names inside the constraints", NC_GOOD, &[INT_NC], ROOT, "a.good.test");
    check("a name outside the permitted subtree", NC_EVIL, &[INT_NC], ROOT, "evil.example");
    check("a name in the excluded subtree", NC_EXCLUDED, &[INT_NC], ROOT, "bad.good.test");
    check("a wildcard, for a host inside", NC_WILDCARD, &[INT_NC], ROOT, "x.good.test");
    check("the wildcard, for the excluded host", NC_WILDCARD, &[INT_NC], ROOT, "bad.good.test");
    check("an address inside the permitted range", NC_IP_IN, &[INT_NC], ROOT, "10.1.2.3");
    check("an address outside it", NC_IP_OUT, &[INT_NC], ROOT, "good.test");
    check("a directoryName constraint", DN_LEAF, &[INT_DN], ROOT, "good.test");
    check("the expired intermediate first", EK_LEAF, &[INT_EXPIRED, INT_RENEWED], ROOT, "good.test");
    check("the renewed intermediate first", EK_LEAF, &[INT_RENEWED, INT_EXPIRED], ROOT, "good.test");
    check("the expired intermediate alone", EK_LEAF, &[INT_EXPIRED], ROOT, "good.test");
    check("a root with path length 0, directly", PL0_LEAF, &none, ROOT_PL0, "good.test");
    check("a root with path length 0, one below", PL0_DEEP_LEAF, &[INT_UNDER_PL0], ROOT_PL0, "good.test");
    check("an intermediate for clientAuth only", CLIENT_ONLY_LEAF, &[INT_CLIENT_ONLY], ROOT, "good.test");
    0
}
