// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.bigint [BigUint] (D-0157); conf.bigint-sub-underflow
// kind: negative
// expect: diag.arith-overflow (dynamic)
//
// An unsigned difference below zero is `diag.arith-overflow`, as for any
// unsigned integer.

import std;

fn main()
{
    BigUint small = BigUint::from_u64(3);
    BigUint big = BigUint::from_u64(4);
    BigUint d = BigUint::sub(&small, &big);
}
