// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec rule.alias.borrow D-0018
// kind: positive
// expect: ok
//
// Vectors used only through helpers that take them by reference: passed
// on in both forms (`v`, `&mut *v`), recursively, two distinct ones to
// one call, with a push onto the passed vector inside another argument
// of the same call (it reallocates before the call begins), and with a
// nested call as another argument.

import std;

fn fill(ref<Vec<i32>, exclusive> v, i32 n)
{
    i32 k = 0;
    while (k < n)
    {
        Vec::push(v, k);
        k = k + 1;
    }
}

fn fill_twice(ref<Vec<i32>, exclusive> v, i32 n)
{
    fill(v, n);
    fill(&mut *v, n);
}

fn sum_from(ref<Vec<i32>, shared> v, usize i) : i64
{
    if (i >= Vec::len(v))
    {
        0
    }
    else
    {
        widen<i64>(*Vec::index_shared(v, i)) + sum_from(v, i + 1)
    }
}

fn set(ref<Vec<i32>, exclusive> v, usize i, i32 x)
{
    *Vec::index_exclusive(v, i) = x;
}

fn append_first(ref<Vec<i32>, exclusive> a, ref<Vec<i32>, shared> b)
{
    Vec::push(a, *Vec::index_shared(b, 0));
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec<i32> w = Vec::new();
    fill_twice(&mut v, 3);
    fill(&mut w, 2);
    append_first(&mut v, &w);
    set(&mut v, {
        Vec::push(&mut v, 7);
        Vec::push(&mut v, 8);
        Vec::push(&mut v, 9);
        Vec::push(&mut v, 10);
        Vec::push(&mut v, 11);
        0
    }, narrow<i32>(sum_from(&w, 0)) + 40);
    if (Vec::len(&v) != 12 || sum_from(&v, 0) != 92)
    {
        1 / (1 - 1);
    }
}
