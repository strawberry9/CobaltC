// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §0 [Rng-Shuffle] [Uuid-V4] (D-0181); conf.rng-shuffle, conf.uuid-v4
// kind: positive
// expect: ok
// expect-stdout-hex: 37203320382039203520362034203120302032207c2034350a616364620a3720300a74727565207472756520747275650a
//
// `Rng::shuffle` gives the same permutation for the same seed in every
// implementation (Fisher-Yates over `below`), keeps every element, and
// moves resources without copying; `uuid_v4` has the RFC 9562 shape and
// two draws differ.

import std;

fn main()
{
    Rng r = Rng::new(42);
    Vec<u32> v = Vec::new();
    foreach (i in 0..10)
    {
        Vec::push(&mut v, narrow<u32>(i));
    }
    Rng::shuffle(&mut r, &mut v[0..$]);
    foreach (x in &v)
    {
        printf("%v ", *x);
    }
    u32 sum = 0;
    foreach (x in &v)
    {
        sum += *x;
    }
    printf("| %v\n", sum);
    Vec<String> names = Vec::new();
    foreach (n in ["a", "b", "c", "d"])
    {
        Vec::push(&mut names, String::from_str(n));
    }
    Rng::shuffle(&mut r, &mut names[0..$]);
    printf("%v%v%v%v\n", &names[0], &names[1], &names[2], &names[3]);
    Vec<u8> one = Vec::new();
    Vec::push(&mut one, 7);
    Rng::shuffle(&mut r, &mut one[0..$]);
    Vec<u8> none = Vec::new();
    Rng::shuffle(&mut r, &mut none[0..$]);
    printf("%v %v\n", one[0], Vec::len(&none));
    String u = uuid_v4();
    String u2 = uuid_v4();
    slice<u8, shared> b = StringView::as_bytes(String::as_view(&u));
    bool shape = String::len(&u) == 36 && b[8] == b'-' && b[13] == b'-' && b[18] == b'-' && b[23] == b'-' && b[14] == b'4';
    u8 y = b[19];
    printf("%v %v %v\n", shape, y == b'8' || y == b'9' || y == b'a' || y == b'b', !String::eq(&u, &u2));
}
