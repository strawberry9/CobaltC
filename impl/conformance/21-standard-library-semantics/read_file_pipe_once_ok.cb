// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.file [Read-File]; CHG-0442; conf.read-file-pipe-once
// kind: positive
// expect: ok
// platform: unix
// expect-stdout-hex: 3432303020747275650a
// stdin-hex: 
//
// `read_file` of a pipe longer than 4096 bytes: the whole input, read once.
// It read the file at most 4096 bytes at a first call and again in full at
// a second, and the second read of a pipe found nothing (`Ok` of an empty
// `String`).

import std;

fn main()
{
    match (read_file("/dev/stdin"))
    {
        Ok(s)  :
        {
            StringView v = &s;
            printf("%v %v\n", StringView::len(v), StringView::ends_with(v, "abab"));
        },
        Err(e) : printf("%s\n", FileError::text(&e)),
    }
}
