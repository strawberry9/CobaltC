// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: D-0018 D-0022 rule.alias.borrow [Write-Conflict]; conf.vec-passed-twice-to-helper-dynamic
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// One vector passed to a helper as both its exclusive and its shared
// reference: the two parameters alias, and the push through the
// exclusive one conflicts with the shared one inside the helper
// (D-0022). Distinct vectors in the same call run to completion.
//
// D-0282: the static pass rejects this program before it runs (it was found
// at run time before): `append_first` writes `v` through argument 1, which
// argument 2 also reaches.

import std;

fn append_first(ref<Vec<i32>, exclusive> a, ref<Vec<i32>, shared> b)
{
    Vec::push(a, *Vec::index_shared(b, 0));
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec<i32> w = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut w, 2);
    append_first(&mut v, &w);
    printf("distinct\n");
    append_first(&mut v, &v);
}
