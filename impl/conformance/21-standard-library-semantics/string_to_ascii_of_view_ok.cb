// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.string (D-0312): `StringView::to_ascii_lower`/`to_ascii_upper` take any text's view: `&s`, a view, a literal; conf.string-to-ascii-of-view
// kind: positive
// expect: ok
// expect-stdout-hex: 6d69786564204d49204f4b0a
//

import std;

fn main()
{
    String s = "MiXeD";
    StringView v = &s[0..2];
    String a = StringView::to_ascii_lower(&s);
    String b = StringView::to_ascii_upper(v);
    String c = StringView::to_ascii_upper("ok");
    printf("%v %v %v\n", &a, &b, &c);
}
