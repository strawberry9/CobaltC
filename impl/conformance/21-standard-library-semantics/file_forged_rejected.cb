// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.file-handle; rule.module.visibility [Field-Not-Visible]; D-0054; conf.file-forged-rejected
// kind: negative
// expect: diag.name-not-visible (static)
//
// A program cannot make a `File` from a number: its fields are private
// to `std`, so every `File` comes from opening a file.

import std;

fn main()
{
    File f = File { .id = 0, .open = true };
}
