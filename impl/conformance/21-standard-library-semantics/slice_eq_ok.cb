// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.collections `slice_eq` (D-0205); conf.slice-eq
// kind: positive
// expect: ok
// expect-stdout-hex: 747275652066616c73652066616c736520747275650a747275652066616c73650a
//
// `slice_eq` compares two slices element by element: the same length and
// equal elements in order. A `Vec` through `&v[0..$]`, an array, text's
// bytes, `String`s compared by their text.

import std;

fn main()
{
    Vec<u64> v = Vec::filled(3, 7: u64);
    Vec<u64> w = Vec::filled(3, 7: u64);
    array<u64, 3> x = [7, 7, 8];
    Vec<String> s1 = Vec::new();
    Vec::push(&mut s1, String::from_str("x"));
    Vec<String> s2 = Vec::new();
    Vec::push(&mut s2, String::from_str("x"));
    printf(
        "%v %v %v %v\n",
        slice_eq(&v[0..$], &w[0..$]),
        slice_eq(&v[0..2], &w[0..$]),
        slice_eq(&v[0..$], &x[0..$]),
        slice_eq(&s1[0..$], &s2[0..$]),
    );
    printf(
        "%v %v\n",
        slice_eq(StringView::as_bytes("ab"), StringView::as_bytes("ab")),
        slice_eq(StringView::as_bytes(""), StringView::as_bytes("a")),
    );
}
