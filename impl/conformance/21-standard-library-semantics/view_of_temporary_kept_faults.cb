// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: `[View-Form-Temporary-Argument]` (D-0135): a view returned from a temporary's view and kept past the statement; conf.view-of-temporary-kept-faults
// kind: negative
// expect: diag.destroy-while-aliased (static)
//
// D-0282: the static pass rejects this program before it runs (it was found
// at run time before): `w` holds a view of a temporary that ends with this
// statement, and is used later (D-0135).

import std;

fn padded() : String
{
    "  abc  "
}

fn main()
{
    // `trim`'s view points into `padded()`'s String, which ends with the statement
    StringView w = StringView::trim(&padded()[0..$]);
    printf("%v\n", StringView::len(w));
}
