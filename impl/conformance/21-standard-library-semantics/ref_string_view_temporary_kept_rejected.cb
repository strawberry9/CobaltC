// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview [Ref-String-View] (D-0302); conf.ref-string-view-temporary-kept-rejected
// kind: negative
// expect: diag.borrow-of-non-place (static)
//
// `&sprintf(…)` is `&sprintf(…)[0..$]`, a view of a temporary, which
// `[View-Form-Temporary-Argument]` admits as a call's argument only: the
// temporary ends with its statement, so a local cannot keep the view.

import std;

fn main() : u8
{
    StringView w = &sprintf("%d", 1);
    printf("%s\n", w);
    return 0;
}
