// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview `String::chars` (D-0128), [View-Form]'s borrow; conf.string-chars-borrows
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// The views `String::chars` returns borrow the `String`, as a view does:
// while they are in use it cannot be changed.

import std;

fn main()
{
    String s = "ab";
    Vec<StringView> cs = String::chars(&s);
    String::push_ascii(&mut s, b'c');           // cs still borrows s
    printf("%v\n", cs[0]);
}
