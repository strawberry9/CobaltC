// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview `StringView::chars` of `&s` (D-0128), [View-Form]'s borrow; conf.string-chars-borrows
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// The views `StringView::chars(&s)` returns borrow the `String`, as a view does:
// while they are in use it cannot be changed.
// D-0341 (CHG-0484) §2.2: a holder of the whole text or vector is read after the
// write, which faults whatever it holds: refused at the check.

import std;

fn main()
{
    String s = "ab";
    Vec<StringView> cs = StringView::chars(&s);
    String::push_ascii(&mut s, b'c');           // cs still borrows s
    printf("%v\n", cs[0]);
}
