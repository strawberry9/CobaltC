// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `contains`, `index_of`, `binary_search`; conf.vec-search-keys
// kind: positive
// expect: ok
// expect-stdout-hex: 747275652074727565207472756520747275650a343920300a343920747275650a7472756520350a
//
// Literal and computed keys for the searches over u8, i64, u16 and i8
// vectors: each key has the element type (cobc passes a temporary key by
// address, D-0189), and a search beside a held shared element reference.

import std;

fn main()
{
    Vec<u8> a = Vec::new();
    Vec<i64> b = Vec::new();
    Vec<u16> c = Vec::new();
    Vec<i8> d = Vec::new();
    foreach (i in 0..50)
    {
        Vec::push(&mut a, narrow<u8>(i));
        Vec::push(&mut b, narrow<i64>(i) * 1000000000000);
        Vec::push(&mut c, narrow<u16>(i * 1000));
        Vec::push(&mut d, narrow<i8>(i) - 25);
    }
    printf(
        "%v %v %v %v\n",
        Vec::contains(&a, &7),
        Vec::contains(&b, &7000000000000),
        Vec::contains(&c, &7000),
        Vec::contains(&d, &-3),
    );
    printf("%v %v\n", Option::unwrap(Vec::index_of(&a, &49)), Option::unwrap(Vec::index_of(&d, &-25)));
    printf(
        "%v %v\n",
        Result::unwrap(Vec::binary_search(&b, &49000000000000)),
        Result::is_err(&Vec::binary_search(&c, &1)),
    );
    Vec<i64> held = Vec::filled(3, 5: i64);
    ref<i64, shared> h = &held[0];
    printf("%v %v\n", Vec::contains(&held, &5), *h);
}
