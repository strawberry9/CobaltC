// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Rsa-Pkcs1v15] [Rsa-Pss] (D-0158); conf.rsa-pkcs1v15, conf.rsa-pss
// kind: positive
// expect: ok
// slow: interpreted big-number arithmetic takes well over the 10-second budget
// expect-stdout-hex: 706b6373312076616c69643a20747275650a706b637331206368616e6765643a2066616c73650a7073732076616c69643a20747275650a707373206f74686572206469676573743a2066616c73650a
//
// RSA signature verification on vectors made by Python's `cryptography`
// (OpenSSL): a 2048-bit key's PKCS #1 v1.5 and PSS signatures over SHA-256
// verify, one changed signature byte and a different digest are refused
// (a 3072-bit key: crypto_rsa_3072_ok.cb).

import std;

fn bytes_of(str t) : Vec<u8>
{
    Result::unwrap_or(from_hex(StringView::of(t)), Vec::new())
}

fn check(str name, str scheme, str bits, str n, str e, str digest, str sig)
{
    String ee = if (str_len(e) % 2 == 1) { "0" } else { "" };
    String::append(&mut ee, e);
    RsaPublicKey key = RsaPublicKey { .n = BigUint::from_bytes_be(&bytes_of(n)[0..$]), .e = BigUint::from_bytes_be(&Result::unwrap_or(
        from_hex(String::as_view(&ee)),
        Vec::new(),
    )[0..$]) };
    HashKind h = if (str_byte(bits, 0) == b'5') { Sha2_512 } else { Sha2_256 };
    Vec<u8> d = bytes_of(digest);
    Vec<u8> s = bytes_of(sig);
    bool ok = if (str_byte(
        scheme,
        0,
    ) == b'r')
    {
        rsa_verify_pkcs1v15(
            &key,
            h,
            &d[0..$],
            &s[0..$],
        )
    }
    else { rsa_verify_pss(&key, h, &d[0..$], &s[0..$]) };
    printf("%s: %v\n", name, ok);
}

fn main() : u8
{
    check(
        "pkcs1 valid",
        "rsa1",
        "256",
        "",
        "10001",
        "12cbc4837ea967e3080457d1c0ce565b65bfcb65677a683847aef44db614a41c",
        "",
    );
    check(
        "pkcs1 changed",
        "rsa1",
        "256",
        "",
        "10001",
        "12cbc4837ea967e3080457d1c0ce565b65bfcb65677a683847aef44db614a41c",
        "",
    );
    check(
        "pss valid",
        "pss",
        "256",
        "",
        "10001",
        "12cbc4837ea967e3080457d1c0ce565b65bfcb65677a683847aef44db614a41c",
        "",
    );
    check(
        "pss other digest",
        "pss",
        "256",
        "",
        "10001",
        "1ca414b64df4ae4738687a6765cbbf655b56cec0d1570408e367a97e83c4cb12",
        "",
    );
    0
}
