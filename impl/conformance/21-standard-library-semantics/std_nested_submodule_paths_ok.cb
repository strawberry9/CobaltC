// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.prelude (std's nested submodules, D-0187); rule.module.use (re-export); conf.std-nested-submodule-path
// kind: positive
// expect: ok
// expect-stdout-hex: 3138362031373320747275650a
//
// A submodule of `std` may have submodules of its own, each re-exported
// up to `std`'s root, so every path names the one item:
// `std::crypto::digest::sha256` is `std::crypto::sha256` and `sha256`,
// `std::http::client::HttpClient` is `HttpClient`, and
// `std::database::postgres::PgSslMode` is `PgSslMode`. A program may
// import one of them alone (`import std::crypto::digest;`).

import std;
import std::crypto::digest;

fn main()
{
    array<u8, 32> a = std::crypto::digest::sha256(&b"abc"[0..$]);
    array<u8, 32> b = std::crypto::sha256(&b"abc"[0..$]);
    array<u8, 32> c = sha256(&b"abc"[0..$]);
    bool same = digest_eq(&a[0..$], &b[0..$]) && std::crypto::digest::digest_eq(&b[0..$], &c[0..$]);
    std::http::client::HttpClient client = HttpClient::new();
    std::database::postgres::PgSslMode mode = PgSslMode::Disable;
    printf("%v %v %v\n", a[0], c[31], same);
}
