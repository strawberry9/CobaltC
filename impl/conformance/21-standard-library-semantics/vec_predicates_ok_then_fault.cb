// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `retain`, `position`, `dedup`; conf.vec-predicate-literals
// kind: negative
// expect: diag.div-by-zero (dynamic)
// expect-stdout-hex: 313020300a30203520312036203420322030203520312036200a360a617420310a747275650a64656475702037203020360a656d70747920300a
//
// retain and position with closure literals (one printing each element it
// is given, in order), on a local and through a parameter, dedup over
// runs and an empty vector; then a predicate that divides by zero on the
// first element it is given: diag.div-by-zero inside retain, after
// everything before it has printed. (cobc compiles a capture-free
// predicate into the loop, D-0189.)

import std;

fn evens(ref<Vec<i64>, exclusive> v)
{
    Vec::retain(v, [](ref<i64, shared> x) : bool { printf("%v ", *x); *x % 2 == 0 });
    printf("\n");
}

fn main()
{
    Vec<i64> v = Vec::new();
    foreach (i in 0..12: i64)
    {
        Vec::push(&mut v, (i * 5) % 7);
    }
    Vec::retain(&mut v, [](ref<i64, shared> x) : bool { *x != 3 });
    printf("%v %v\n", Vec::len(&v), v[0]);
    evens(&mut v);
    printf("%v\n", Vec::len(&v));
    match (Vec::position(&v, [](ref<i64, shared> x) : bool { *x > 3 }))
    {
        Some(k) : printf("at %v\n", k),
        None    : printf("none\n"),
    }
    printf("%v\n", Option::is_none(&Vec::position(&v, [](ref<i64, shared> x) : bool { *x > 100 })));
    Vec<i64> d = Vec::new();
    foreach (i in 0..20: i64)
    {
        Vec::push(&mut d, i / 3);
    }
    Vec::dedup(&mut d);
    printf("dedup %v %v %v\n", Vec::len(&d), d[0], d[6]);
    Vec<i64> e = Vec::new();
    Vec::dedup(&mut e);
    Vec::retain(&mut e, [](ref<i64, shared> x) : bool { *x > 0 });
    printf("empty %v\n", Vec::len(&e));
    Vec<i64> z = Vec::filled(3, 1: i64);
    Vec::retain(&mut z, [](ref<i64, shared> x) : bool { 10 / (*x - 1) > 0 });
}
