// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §2i; conf.priority-queue-order
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// a queue ordered by a closure that prints each comparison, with equal
// keys leaving first in first out; signed, float and 1000 u64 keys in the
// key types' order (D-0193: cobc's native push and pop make the same
// comparisons in the same order)

import std;

struct Ev
{
    u64 at;
    u32 id;
}

fn main()
{
    PriorityQueue<Ev> q = PriorityQueue::new_by([](
        ref<Ev, shared> a,
        ref<Ev, shared> b,
    ) : bool { printf("(%v<%v)", a.id, b.id); a.at < b.at });
    array<u64, 9> ats = [5, 3, 5, 1, 3, 9, 1, 5, 2];
    for (usize i = 0; i < 9; i += 1)
    {
        PriorityQueue::push(&mut q, Ev { .at = ats[i], .id = narrow<u32>(i) });
    }
    printf("\n");
    while (Some(e) = PriorityQueue::pop(&mut q))
    {
        printf(" [%v:%v]\n", e.at, e.id);
    }
    PriorityQueue<i8> k = PriorityQueue::new();
    array<i8, 7> xs = [3, -128, 127, 0, -1, 3, -128];
    foreach (x in xs)
    {
        PriorityQueue::push(&mut k, x);
    }
    while (Some(x) = PriorityQueue::pop(&mut k))
    {
        printf("%v ", x);
    }
    printf("\n");
    PriorityQueue<f64> f = PriorityQueue::new();
    PriorityQueue::push(&mut f, 2.5);
    PriorityQueue::push(&mut f, -0.5);
    PriorityQueue::push(&mut f, 1.0);
    while (Some(x) = PriorityQueue::pop(&mut f))
    {
        printf("%v ", x);
    }
    printf("\n");
    PriorityQueue<u64> big = PriorityQueue::new();
    for (u64 i = 0; i < 1000; i += 1)
    {
        PriorityQueue::push(&mut big, (i * 7919) % 1009);
    }
    u64 prev = 0;
    bool sorted = true;
    while (Some(x) = PriorityQueue::pop(&mut big))
    {
        sorted = sorted && x >= prev;
        prev = x;
    }
    printf("sorted %v\n", sorted);
}
