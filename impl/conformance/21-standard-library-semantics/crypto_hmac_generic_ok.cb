// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Hasher] [Hmac] [Hkdf-With] (D-0166); conf.hmac-generic, conf.hkdf-generic
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// RFC 4231's test case 2 ("Jefe") under SHA-384 and SHA-512, the SHA-256
// form agreeing with `hmac_sha256`; a `Hasher` fed in pieces gives `hash`;
// HKDF over SHA-384 and SHA-512 (values confirmed with Python's hmac
// module), and over SHA-256 RFC 5869's A.1 as `hkdf_sha256` gives it.

import std;

fn bytes(str hex) : Vec<u8>
{
    Result::unwrap_or(from_hex(StringView::of(hex)), Vec::new())
}

fn main() : u8
{
    Vec<u8> key = Vec::from_slice(&b"Jefe"[0..$]);
    Vec<u8> msg = Vec::from_slice(&b"what do ya want for nothing?"[0..$]);
    printf("hmac-384 %s\n", &to_hex(&hmac(Sha2_384, &key[0..$], &msg[0..$])[0..$]));
    printf("hmac-512 %s\n", &to_hex(&hmac(Sha2_512, &key[0..$], &msg[0..$])[0..$]));
    array<u8, 32> plain = hmac_sha256(&key[0..$], &msg[0..$]);
    printf("hmac-256 agrees %v\n", digest_eq(&hmac(Sha2_256, &key[0..$], &msg[0..$])[0..$], &plain[0..$]));
    Hmac m = Hmac::new(Sha2_512, &key[0..$]);
    Hmac::update(&mut m, &msg[0..10]);
    Hmac::update(&mut m, &msg[10..$]);
    printf("streaming agrees %v\n", digest_eq(&Hmac::finish(m)[0..$], &hmac(Sha2_512, &key[0..$], &msg[0..$])[0..$]));
    Hasher h = Hasher::new(Sha2_384);
    Hasher::update(&mut h, &msg[0..3]);
    Hasher::update(&mut h, &msg[3..$]);
    printf("hasher agrees %v\n", digest_eq(&Hasher::finish(h)[0..$], &hash(Sha2_384, &msg[0..$])[0..$]));
    Vec<u8> ikm = Vec::filled(22, 0x0b: u8);
    Vec<u8> salt = bytes("000102030405060708090a0b0c");
    Vec<u8> info = bytes("f0f1f2f3f4f5f6f7f8f9");
    Vec<u8> none = Vec::new();
    printf("hkdf-384 %s\n", &to_hex(&hkdf_with(Sha2_384, &salt[0..$], &ikm[0..$], &info[0..$], 48)[0..$]));
    printf("hkdf-512 %s\n", &to_hex(&hkdf_with(Sha2_512, &none[0..$], &ikm[0..$], &none[0..$], 42)[0..$]));
    Vec<u8> a1 = hkdf_with(Sha2_256, &salt[0..$], &ikm[0..$], &info[0..$], 42);
    printf(
        "hkdf-256 %s agrees %v\n",
        &to_hex(&a1[0..$]),
        digest_eq(&a1[0..$], &hkdf_sha256(&salt[0..$], &ikm[0..$], &info[0..$], 42)[0..$]),
    );
    Vec<u8> prk = hkdf_extract_with(Sha2_384, &salt[0..$], &ikm[0..$]);
    printf(
        "extract+expand agrees %v\n",
        digest_eq(
            &hkdf_expand_with(Sha2_384, &prk[0..$], &info[0..$], 48)[0..$],
            &hkdf_with(Sha2_384, &salt[0..$], &ikm[0..$], &info[0..$], 48)[0..$],
        ),
    );
    Vec<u8> label = hkdf_expand_label_with(Sha2_256, &prk[0..32], "derived", &none[0..$], 32);
    printf(
        "label agrees %v\n",
        digest_eq(&label[0..$], &hkdf_expand_label(&prk[0..32], "derived", &none[0..$], 32)[0..$]),
    );
    0
}
