// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str `[Str-Literal-String]` (D-0162); conf.str-literal-generic-string
// kind: positive
// expect: ok
// expect-stdout-hex: 64656661756c742066616c6c6261636b21206f6e652c74776f2074727565206220780a
//
// A literal argument whose parameter is a type parameter is typed after
// the other arguments and the expected type have fixed it (D-0079); when
// that makes the parameter `String`, the literal is `String::from_str` of
// it: a default for `Result::unwrap_or` and `Option::unwrap_or`, an
// element for `Vec::push`, a key for `HashMap::insert`, an argument of a
// program's own generic function. Where nothing fixes the parameter, the
// literal stays a `str`.

import std;

fn pick<T>(bool first, T a, T b) : T
{
    if (first) { a } else { b }
}

fn main() : u8
{
    Result<String, ParseError> failed = Err(Empty);
    String r = Result::unwrap_or(failed, "default");
    Option<String> none = None;
    String o = Option::unwrap_or(none, "fallback");
    String::append(&mut o, "!");
    Vec<String> v = Vec::new();
    Vec::push(&mut v, "one");
    Vec::push(&mut v, "two");
    HashMap<String, i32> m = HashMap::new();
    HashMap::insert(&mut m, "k", 7);
    String p = pick(false, String::from_str("a"), "b");
    str s = pick(true, "x", "y");
    String joined = String::join(&v[0..$], ",");
    printf("%s %s %s %v %s %s\n", &r, &o, &joined, HashMap::contains(&m, &String::from_str("k")), &p, s);
    0
}
