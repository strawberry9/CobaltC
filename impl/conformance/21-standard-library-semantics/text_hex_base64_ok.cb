// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.text [Hex] [Base64] (D-0151); conf.hex, conf.base64
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// `to_hex`/`from_hex` round-trip bytes, read either case, and refuse a
// non-digit (at its index) or an odd count (at the length); `base64_encode`
// and `base64_decode` give RFC 4648's vectors for "f" to "foobar", round-trip
// all 256 byte values, and refuse a bad character, a misplaced `=` and a
// length that is not a multiple of four.

import std;

fn show_hex(str text)
{
    match (from_hex(StringView::of(text)))
    {
        Ok(v)  : printf("from_hex(%s) = %s\n", text, &to_hex(&v[0..$])),
        Err(e) : printf("from_hex(%s): %s\n", text, ParseError::text(&e)),
    }
}

fn show_b64(str text)
{
    match (base64_decode(StringView::of(text)))
    {
        Ok(v)  : printf("base64_decode(%s) = [%s]\n", text, &Result::unwrap_or(String::from_utf8(v), String::new())),
        Err(e) : printf("base64_decode(%s): %s\n", text, ParseError::text(&e)),
    }
}

fn main() : u8
{
    Vec<u8> all = Vec::new();
    for (usize i = 0; i < 256; i += 1)
    {
        Vec::push(&mut all, narrow_wrapping<u8>(i));
    }
    String hex = to_hex(&all[0..$]);
    printf("hex of 256 bytes: %u chars, starts %s\n", String::len(&hex), String::view(&hex, 0, 12));
    Vec<u8> back = Result::unwrap_or(from_hex(String::as_view(&hex)), Vec::new());
    printf("hex round trip: %v\n", Vec::len(&back) == 256 && digest_eq(&back[0..$], &all[0..$]));
    show_hex("00ff7F");
    show_hex("0g");
    show_hex("abc");
    show_hex("");
    Vec<u8> none = Vec::new();
    printf(
        "%s|%s|%s|%s|%s|%s|%s\n",
        &base64_encode(&none[0..$]),
        &base64_encode(&b"f"[0..$]),
        &base64_encode(&b"fo"[0..$]),
        &base64_encode(&b"foo"[0..$]),
        &base64_encode(&b"foob"[0..$]),
        &base64_encode(&b"fooba"[0..$]),
        &base64_encode(&b"foobar"[0..$]),
    );
    String b = base64_encode(&all[0..$]);
    Vec<u8> back2 = Result::unwrap_or(base64_decode(String::as_view(&b)), Vec::new());
    printf(
        "base64 of 256 bytes: %u chars, starts %s, round trip %v\n",
        String::len(&b),
        String::view(&b, 0, 16),
        Vec::len(&back2) == 256 && digest_eq(&back2[0..$], &all[0..$]),
    );
    show_b64("Zm9vYmFy");
    show_b64("Zm9vYg==");
    show_b64("Zg==");
    show_b64("");
    show_b64("Zm9v*mFy");
    show_b64("Zm=vYmFy");
    show_b64("Zm9vY");
    0
}
