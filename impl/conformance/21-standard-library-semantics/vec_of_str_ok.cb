// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec; [Repr-Str]; [Sizeof-Str]; conf.str-in-vec
// kind: positive
// expect: ok
//
// `Vec<str>` needs no special case: `T := str` is a plain element type,
// each push is a [Rawptr-Write] of represent(str, v), and reading an
// element back through index_shared yields the same bytes.

import std;

fn main()
{
    Vec<str> v = Vec::new();
    Vec::push(&mut v, "a");
    Vec::push(&mut v, "bc");
    Vec::push(&mut v, "");
    Vec::push(&mut v, "\u{20AC}");
    Vec::push(&mut v, "five!");
    if (Vec::len(&v) != 5) { 1 / (1 - 1); }
    if (str_len(*Vec::index_shared(&v, 1)) != 2) { 1 / (1 - 1); }
    if (*Vec::index_shared(&v, 1) != "bc") { 1 / (1 - 1); }
    if (str_len(*Vec::index_shared(&v, 2)) != 0) { 1 / (1 - 1); }
    if (str_byte(*Vec::index_shared(&v, 3), 0) != 226) { 1 / (1 - 1); }
    match (Vec::pop(&mut v))
    {
        Some(s) : { if (s != "five!") { 1 / (1 - 1); } },
        None : { 1 / (1 - 1); },
    }
    if (sizeof<str>() != 16) { 1 / (1 - 1); }
}
