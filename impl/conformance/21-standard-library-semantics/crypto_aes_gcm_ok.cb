// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Aes] [Aes-Gcm-Seal] [Aes-Gcm-Open] (D-0165); conf.aes-vectors, conf.aes-gcm-vectors
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// AES-128, AES-192 and AES-256 of FIPS 197 Appendix C's block; AES-GCM
// against the GCM specification's test cases 1, 2, 4 and 16 (the empty
// message, one zero block, and a 60-byte message with 20 bytes of aad
// under a 16- and a 32-byte key); `aes_gcm_open` gives the plaintext back
// and refuses a changed ciphertext, tag, aad or nonce, and a message
// shorter than a tag.

import std;

fn bytes(str hex) : Vec<u8>
{
    Result::unwrap_or(from_hex(StringView::of(hex)), Vec::new())
}

fn show(str name, str key, str nonce, str aad, str plain)
{
    Vec<u8> k = bytes(key);
    Vec<u8> n = bytes(nonce);
    Vec<u8> a = bytes(aad);
    Vec<u8> p = bytes(plain);
    Vec<u8> sealed = aes_gcm_seal(&k[0..$], &n[0..$], &a[0..$], &p[0..$]);
    printf("%s: %s\n", name, &to_hex(&sealed[0..$]));
    bool back = match (aes_gcm_open(&k[0..$], &n[0..$], &a[0..$], &sealed[0..$]))
    {
        Some(q) : Vec::len(&q) == Vec::len(&p) && digest_eq(&q[0..$], &p[0..$]),
        None    : false,
    };
    printf("  opens: %v\n", back);
}

fn main() : u8
{
    array<str, 3> keys = [
        "000102030405060708090a0b0c0d0e0f",
        "000102030405060708090a0b0c0d0e0f1011121314151617",
        "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f",
    ];
    Vec<u8> block = bytes("00112233445566778899aabbccddeeff");
    array<u8, 16> b = [0; 16];
    for (usize i = 0; i < 16; i += 1)
    {
        b[i] = block[i];
    }
    foreach (k in &keys)
    {
        Vec<u8> key = bytes(*k);
        printf("AES-%u: %s\n", 8 * Vec::len(&key), &to_hex(&aes_encrypt_block(&key[0..$], b)[0..$]));
    }
    str zeros16 = "00000000000000000000000000000000";
    str zeros12 = "000000000000000000000000";
    str p60 = "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39";
    str a20 = "feedfacedeadbeeffeedfacedeadbeefabaddad2";
    str iv = "cafebabefacedbaddecaf888";
    show("case 1", zeros16, zeros12, "", "");
    show("case 2", zeros16, zeros12, "", zeros16);
    show("case 4", "feffe9928665731c6d6a8f9467308308", iv, a20, p60);
    show("case 16", "feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308", iv, a20, p60);
    // Refusals: each change on its own.
    Vec<u8> k = bytes("feffe9928665731c6d6a8f9467308308");
    Vec<u8> n = bytes(iv);
    Vec<u8> a = bytes(a20);
    Vec<u8> p = bytes(p60);
    Vec<u8> sealed = aes_gcm_seal(&k[0..$], &n[0..$], &a[0..$], &p[0..$]);
    Vec<u8> changed = Vec::clone(&sealed);
    changed[5] = changed[5] ^ 1;
    printf(
        "changed ciphertext refused: %v\n",
        Option::is_none(&aes_gcm_open(&k[0..$], &n[0..$], &a[0..$], &changed[0..$])),
    );
    Vec<u8> tag = Vec::clone(&sealed);
    tag[Vec::len(&tag) - 1] = tag[Vec::len(&tag) - 1] ^ 0x80;
    printf("changed tag refused: %v\n", Option::is_none(&aes_gcm_open(&k[0..$], &n[0..$], &a[0..$], &tag[0..$])));
    printf("other aad refused: %v\n", Option::is_none(&aes_gcm_open(&k[0..$], &n[0..$], &a[0..19], &sealed[0..$])));
    Vec<u8> n2 = Vec::clone(&n);
    n2[11] = n2[11] ^ 1;
    printf("other nonce refused: %v\n", Option::is_none(&aes_gcm_open(&k[0..$], &n2[0..$], &a[0..$], &sealed[0..$])));
    printf("short message refused: %v\n", Option::is_none(&aes_gcm_open(&k[0..$], &n[0..$], &a[0..$], &sealed[0..15])));
    0
}
