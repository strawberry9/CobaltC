// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.print [Print-Buffer]; D-0178; conf.flush-stdout
// kind: positive
// expect: ok
// expect-stdout-hex: 70726f677265737320310a70726f677265737320320a646f6e65
//
// `flush_stdout` writes out what `printf` has written so far and changes
// nothing else: the bytes are those of the same `printf`s without it,
// and a call with nothing buffered does nothing.

import std;

fn main()
{
    flush_stdout();
    printf("progress %d\n", 1);
    flush_stdout();
    flush_stdout();
    printf("progress %d\n", 2);
    flush_stdout();
    printf("done");
}
