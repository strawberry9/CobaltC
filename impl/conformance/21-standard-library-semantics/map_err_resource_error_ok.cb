// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: map_err; conf.map-err-resource-error
// kind: positive
// expect: ok
// expect-stdout-hex: 65727220636f646520350a65727220747261636b656420370a656e640a7e370a
//
// `Result::map_err(r, f)` where `f` returns a resource: a String, and a type with
// a destructor, which runs exactly once, when the Result holding it ends.

import std;

resource struct Tracked
{
    i32 id;
}

fn Tracked::drop(ref<Tracked, exclusive> self)
{
    printf("~%d\n", self.id);
}

fn main()
{
    Result<i32, i32> r = Err(5);
    Result<i32, String> s = Result::map_err(r, [](i32 e) : String { sprintf("code %d", e) });
    match (&s) { Ok(v) : printf("ok %d\n", *v), Err(m) : printf("err %s\n", m) }
    Result<i32, i32> r2 = Err(7);
    Result<i32, Tracked> t = Result::map_err(r2, [](i32 e) : Tracked { Tracked { .id = e } });
    match (&t) { Ok(v) : printf("ok %d\n", *v), Err(x) : printf("err tracked %d\n", x.id) }
    printf("end\n");
}
