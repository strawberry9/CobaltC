// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.print; [Read-Resource-Rejected] (CHG-0438): `%v` of an enum holding a resource, by value; conf.print-resource-enum-by-value
// kind: negative
// expect: diag.read-of-resource (static)
//
// `Option<String>` holds a resource, which `%v` reads through a
// reference, as it reads a `String`.

import std;

fn main()
{
    Option<String> o = Some("a");
    printf("%v\n", o);
}
