// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.text (append, view) [Borrow-Denied]; conf.text-append-view-of-self
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// Appending to a `String` a view of that same `String`: the view holds a
// shared path to its bytes while `append` needs them exclusively.

import std;

fn main()
{
    String s = String::from_str("hello");
    String::append(&mut s, String::view(&s, 1, 3));
    printf("%s\n", &s);
}
