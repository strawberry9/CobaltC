// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.text (append, view) [Borrow-Denied]; conf.text-append-view-of-self
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// Appending to a `String` a view of that same `String`: the view holds a
// shared path to its bytes while `append` needs them exclusively.
//
// D-0282: the static pass rejects this program before it runs (it was found
// at run time before): `String::append` writes `s` through argument 1,
// which argument 2 also reaches.

import std;

fn main()
{
    String s = String::from_str("hello");
    String::append(&mut s, String::view(&s, 1, 3));
    printf("%s\n", &s);
}
