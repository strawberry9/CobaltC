// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.hashmap `HashMap::insert`, `HashMap::entry`, `HashMap::get`, `HashMap::get_mut`, `HashMap::contains`; rule.stdlib.text `String::clone`
// kind: positive
// expect: ok
//
// String keys that are only ever read: cloned into `insert` and `entry`,
// looked up with `get`, `get_mut` and `contains`, and handed to a function
// of the program's own that reads them, in a loop and out of one.

import std;

fn weight(ref<String, shared> s) : usize
{
    String::len(s) * 2
}

fn main()
{
    HashMap<String, u32> m = HashMap::new();
    String k = String::from_str("alpha");
    _ = HashMap::insert(&mut m, String::clone(&k), 1);
    match (HashMap::get_mut(&mut m, &k))
    {
        Some(c) : *c += 1,
        None    : {},
    }
    assert(*Option::unwrap(HashMap::get(&m, &k)) == 2);
    usize w = 0;
    foreach (i in 0..50)
    {
        String key = sprintf("key-%v", i % 7);
        *HashMap::entry(&mut m, String::clone(&key), 0) += 1;
        if (HashMap::contains(&m, &key))
        {
            w += weight(&key);
        }
    }
    assert(HashMap::len(&m) == 8);
    assert(*Option::unwrap(HashMap::get(&m, &k)) == 2);
    String probe = String::from_str("key-3");
    assert(*Option::unwrap(HashMap::get(&m, &probe)) == 7);
    assert(w == 50 * 10);
    printf("ok %v\n", weight(&k));
}
