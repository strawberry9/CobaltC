// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str `[Str-Literal-String-Ref]` (D-0308): the literal's `String` never ends, so a reference a call returns from it is valid after the statement; conf.literal-string-ref-returned
// kind: positive
// expect: ok
// stdout: kept kept
//
// `id` returns the reference it is given; given a literal, it returns a
// reference to the literal's `String`, an object of static storage, which
// stays valid for the rest of the run.

import std;

fn id(ref<String, shared> s) : ref<String, shared>
{
    s
}

fn main()
{
    ref<String, shared> r = id("kept");
    ref<String, shared> q = id("kept");
    printf("%s %s\n", r, q);
}
