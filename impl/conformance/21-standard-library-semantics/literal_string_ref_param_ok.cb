// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str `[Str-Literal-String-Ref]` (D-0308): a literal, a constant and a `str` value where a program's own `ref<String, shared>` parameter is declared; conf.literal-string-ref-param
// kind: positive
// expect: ok
// stdout: 5 3 4 hello
//
// The literal is the reference: no `String` is built and no binding is
// needed first, as `String s = "…";` is the `String` and a `StringView`
// parameter's literal the view.

import std;

const str GREETING = "hello";

fn bytes(ref<String, shared> s) : usize
{
    StringView::len(s)
}

fn shout(ref<String, shared> s) : String
{
    String::from_view(s)
}

fn of_str(str t) : usize
{
    bytes(t)
}

fn main()
{
    String g = shout(GREETING);
    printf("%v %v %v %s\n", bytes("hello"), bytes("abc"), of_str("four"), &g);
}
