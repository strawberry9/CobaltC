// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.read [Read-All] (D-0145); conf.read-all
// kind: positive
// expect: ok
// expect-stdout-hex: 6669727374206c696e65205b6f6e655d0a74686520726573743a2031312062797465732c20656e647320776974682061206c696e653f2066616c73650a616761696e3a20302062797465730a
// stdin-hex: 6f6e650a74776f0d0a6e6f20656e64
//
// After one `read_line`, `read_all` gives the rest of standard input at
// once, line ends and all; at the end, an empty `String`.

import std;

fn main()
{
    match (read_line())
    {
        Ok(Some(l)) : printf("first line [%s]\n", &l),
        _           : printf("no line\n"),
    }
    match (read_all())
    {
        Ok(rest) : printf(
            "the rest: %u bytes, ends with a line? %v\n",
            String::len(&rest),
            String::ends_with(&rest, "\n"),
        ),
        Err(e) : printf("read_all: %s\n", FileError::text(&e)),
    }
    match (read_all())
    {
        Ok(rest) : printf("again: %u bytes\n", String::len(&rest)),
        Err(e)   : printf("read_all: %s\n", FileError::text(&e)),
    }
}
