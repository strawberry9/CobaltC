// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.http [Http-Redirect] (D-0173, D-0232); conf.http-redirect-credentials
// kind: positive
// expect: ok
// expect-stdout-hex: 617574686f72697a6174696f6e3d79657320636f6f6b69653d7965730a617574686f72697a6174696f6e3d6e6f20636f6f6b69653d6e6f0a
//
// A redirect within the request's origin keeps its credentials; once a
// redirect leaves the origin (scheme, host and port), `Authorization`,
// `Proxy-Authorization` and `Cookie` are not sent again, whether the
// request or the client carried them. Two servers on two loopback ports
// are two origins: each answers `/check` with what it was sent.

import std;

fn seen(ref<Request, shared> r) : String
{
    sprintf(
        "authorization=%s cookie=%s",
        if (Option::is_some(&Request::header(r, "authorization"))) { "yes" } else { "no" },
        if (Option::is_some(&Request::header(r, "cookie"))) { "yes" } else { "no" },
    )
}

// Answers `count` requests, one a connection: `/same` and `/away` are
// redirects (to `/check` here, and to `away`), `/check` says what came.
fn serve(HttpServer s, usize count, String away) : u8
{
    for (usize i = 0; i < count; i += 1)
    {
        HttpConnection c = match (HttpServer::accept(&mut s))
        {
            Ok(c)  : c,
            Err(_) : return 1,
        };
        if (Ok(Some(req)) = HttpConnection::request(&mut c))
        {
            Vec<Header> h = Vec::new();
            if (req.url == "/same")
            {
                Vec::push(&mut h, Header::new("Location", "/check"));
                _ = HttpConnection::respond(&mut c, 302, &h[0..$], &b"moved"[0..$]);
            }
            else if (req.url == "/away")
            {
                Vec::push(&mut h, Header::new("Location", String::as_view(&away)));
                _ = HttpConnection::respond(&mut c, 307, &h[0..$], &b"moved"[0..$]);
            }
            else
            {
                String body = seen(&req);
                _ = HttpConnection::respond(&mut c, 200, &h[0..$], StringView::as_bytes(String::as_view(&body)));
            }
        }
        HttpConnection::close(&mut c);
    }
    0
}

fn fetch(ref<HttpClient, exclusive> c, String url)
{
    Request req = Request::new("GET", String::as_view(&url));
    Vec::push(&mut req.headers, Header::new("Authorization", "Bearer secret"));
    match (HttpClient::send(c, &req))
    {
        Ok(r)  : printf("%v\n", &Result::unwrap(Response::text(&r))),
        Err(e) : printf("%s\n", HttpError::text(&e)),
    }
}

fn main() : u8
{
    HttpServer a = Result::unwrap(HttpServer::bind(SocketAddr::new(IpAddr::localhost_v4(), 0)));
    HttpServer b = Result::unwrap(HttpServer::bind(SocketAddr::new(IpAddr::localhost_v4(), 0)));
    String base_a = sprintf("http://127.0.0.1:%u", HttpServer::local_addr(&a).port);
    String away = sprintf("http://127.0.0.1:%u/check", HttpServer::local_addr(&b).port);
    auto ha = spawn(serve, a, 3, away);
    auto hb = spawn(serve, b, 1, String::new());
    HttpClient c = HttpClient::new();
    Vec::push(&mut c.headers, Header::new("Cookie", "session=1"));
    fetch(&mut c, sprintf("%v/same", &base_a));
    fetch(&mut c, sprintf("%v/away", &base_a));
    if (join(ha) + join(hb) != 0)
    {
        return 1;
    }
    0
}
