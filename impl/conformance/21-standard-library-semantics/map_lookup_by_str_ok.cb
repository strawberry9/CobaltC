// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.hashmap `[Lookup-Str]`: `HashMap::get_str`, `get_mut_str`, `contains_str`, `remove_str`, `HashSet::contains_str`, `remove_str` (D-0113); conf.map-lookup-by-str, conf.map-remove-str, conf.set-lookup-by-str
// kind: positive
// expect: ok
//
// A map or set keyed by `String`, asked with a `str`: the same entry as
// with a `String` of the same bytes, no `String` made. `remove_str`
// keeps the order of the others, as `remove` does (D-0134).

import std;

fn main()
{
    HashMap<String, i32> m = HashMap::new();
    HashMap::insert(&mut m, String::from_str("core"), 1);
    HashMap::insert(&mut m, String::from_str("data"), 2);
    HashMap::insert(&mut m, String::from_str("ui"), 3);
    match (HashMap::get_str(&m, "data")) { Some(v) : assert(*v == 2), None : assert(false), }
    assert(HashMap::get_str(&m, "nope") == None && HashMap::get_str(&m, "") == None);
    assert(HashMap::contains_str(&m, "ui") && !HashMap::contains_str(&m, "u") && !HashMap::contains_str(&m, "ui "));
    match (HashMap::get_mut_str(&mut m, "core")) { Some(v) : { *v = 10; }, None : assert(false), }
    String core = String::from_str("core");
    match (HashMap::get(&m, &core)) { Some(v) : assert(*v == 10), None : assert(false), }
    assert(HashMap::remove_str(&mut m, "core") == Some(10));
    assert(HashMap::remove_str(&mut m, "core") == None);
    assert(HashMap::len(&m) == 2 && !HashMap::contains(&m, &core));
    assert(String::eq_str(HashMap::key_at(&m, 0), "data"));    // the others keep their order
    assert(HashMap::remove_str(&mut m, "ui") == Some(3) && HashMap::len(&m) == 1);
    HashMap::insert(&mut m, String::from_str("ui"), 4);
    assert(HashMap::contains_str(&m, "ui") && HashMap::len(&m) == 2);

    HashSet<String> s = HashSet::new();
    HashSet::insert(&mut s, String::from_str("a"));
    HashSet::insert(&mut s, String::from_str("b"));
    assert(HashSet::contains_str(&s, "a") && !HashSet::contains_str(&s, "c"));
    assert(HashSet::remove_str(&mut s, "a") && !HashSet::remove_str(&mut s, "a") && HashSet::len(&s) == 1);
    assert(String::eq_str(HashSet::key_at(&s, 0), "b"));
    printf("ok\n");
}
