// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: `[Bytes-LE]`, `[Bytes-BE]`, `[CRC32]` (D-0119); conf.bytes-le-be, conf.bytes-signed-roundtrip, conf.crc32-check, conf.crc32-empty
// kind: positive
// expect: ok
//
// Integers to bytes in both orders and back, unsigned and signed, every
// width; CRC-32/IEEE's check values (zlib agrees on all three).

import std;

fn main()
{
    Vec<u8> out = Vec::new();
    Vec::push_le(&mut out, 0x1234: u16);                   // 34 12
    Vec::push_be(&mut out, 0x1234: u16);                   // 12 34
    Vec::push_le(&mut out, -2: i8);                        // fe
    Vec::push_le(&mut out, -1: i64);                       // ff x 8
    Vec::push_be(&mut out, 0x0102030405060708: u64);       // 01 .. 08
    Vec::push_le(&mut out, 300: u32);                      // 2c 01 00 00
    Vec::push_be(&mut out, -32768: i16);                   // 80 00
    assert(Vec::len(&out) == 27 && out[0] == 0x34 && out[1] == 0x12 && out[2] == 0x12 && out[3] == 0x34 && out[4] == 0xFE);
    assert(out[13] == 1 && out[20] == 8 && out[21] == 0x2C && out[25] == 0x80 && out[26] == 0);
    assert(read_le<u16>(&out[0..$], 0) == 0x1234 && read_be<u16>(&out[0..$], 2) == 0x1234);
    assert(read_le<i8>(&out[0..$], 4) == -2 && read_le<i64>(&out[0..$], 5) == -1);
    assert(read_be<u64>(&out[0..$], 13) == 0x0102030405060708 && read_le<u32>(&out[0..$], 21) == 300);
    assert(read_be<i16>(&out[0..$], 25) == -32768 && read_le<i16>(&out[0..$], 0) == 0x1234);
    assert(read_le<u8>(&out[0..$], 4) == 0xFE && read_be<i8>(&out[0..$], 4) == -2);
    Vec<u8> w = Vec::new();
    Vec::push_le(&mut w, -1234567890123: i128);
    Vec::push_be(&mut w, 170141183460469231731687303715884105727: i128);
    assert(read_le<i128>(
        &w[0..$],
        0,
    ) == -1234567890123 && read_be<i128>(&w[0..$], 16) == 170141183460469231731687303715884105727);

    String check = "123456789";
    assert(crc32(&String::as_bytes(&check)[0..$]) == 0xCBF43926);
    assert(crc32(&out[0..0]) == 0);
    Vec<u8> run = Vec::filled(1000, 0xAB: u8);
    assert(crc32(&run[0..$]) == 0xA670F964);
    printf("ok\n");
}
