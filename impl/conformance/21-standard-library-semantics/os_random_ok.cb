// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: §0 [Os-Random] [Rng-From-Os] (D-0142); conf.os-random-bytes, conf.os-random-u64, conf.os-random-empty, conf.rng-from-os
// kind: positive
// expect: ok
// expect-stdout-hex: 74776f206469666665723a20747275650a3332206279746573206e6f7420616c6c207a65726f3a20747275650a62656c6f772031303a20747275650a
//
// The bytes are unspecified, so only what holds of every run is printed:
// two secure `u64`s differ (a false failure has probability 2^-64), 32
// secure bytes are not all zero (2^-256), an empty slice is filled with
// nothing, and an `Rng` seeded from the system draws as any `Rng` does.

import std;

fn main()
{
    u64 a = os_random_u64();
    u64 b = os_random_u64();
    printf("two differ: %v\n", a != b);
    Vec<u8> buf = Vec::filled(32, 0: u8);
    os_random_bytes(&mut buf[0..$]);
    bool any = false;
    foreach (x in &buf)
    {
        any = any || *x != 0;
    }
    printf("32 bytes not all zero: %v\n", any);
    Vec<u8> none = Vec::new();
    os_random_bytes(&mut none[0..$]);
    Rng r = Rng::from_os();
    printf("below 10: %v\n", Rng::below(&mut r, 10) < 10);
}
