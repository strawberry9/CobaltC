// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §2h; conf.text-split-trim-case
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// split_whitespace, trim, trim_start, trim_end and to_ascii_lower/upper
// over every ASCII white-space byte, UTF-8 text, empty and blank strings;
// foreach over a Vec of views and of numbers it consumes, left early
// (D-0193)

import std;

fn show(str label, ref<Vec<StringView>, shared> ws)
{
    printf("%s %v:", label, Vec::len(ws));
    foreach (w in ws)
    {
        printf(" [%s]", *w);
    }
    printf("\n");
}

fn main()
{
    String a = String::from_str("  \t héllo wörld\n");
    String::push_ascii(&mut a, 11);
    String::push_ascii(&mut a, 12);
    String::append(&mut a, " x\r ");
    Vec<StringView> ws = String::split_whitespace(&a);
    show("words", &ws);
    Vec<StringView> none = String::split_whitespace(&String::from_str(" \t\n "));
    show("blank", &none);
    Vec<StringView> empty = StringView::split_whitespace(StringView::of(""));
    show("empty", &empty);
    printf("[%s] [%s] [%s]\n", String::trim(&a), String::trim_start(&a), String::trim_end(&a));
    printf("[%s] [%s]\n", StringView::trim(StringView::of("   ")), StringView::trim_end(StringView::of("")));
    StringView inner = StringView::trim(StringView::sub(String::as_view(&a), 3, 10));
    printf("[%s] %v\n", inner, StringView::len(inner));
    printf("%s|%s\n", &String::to_ascii_lower(&a), &String::to_ascii_upper(&String::from_str("MiXeD 123 ÄÖ zZ@[`{")));
    printf("[%s]\n", &String::to_ascii_lower(&String::new()));
    // Draining a Vec of views: each word kept past its Vec.
    Vec<StringView> kept = Vec::new();
    foreach (w in String::split_whitespace(&a))
    {
        Vec::push(&mut kept, StringView::trim(w));
    }
    show("kept", &kept);
    // Draining plain values, leaving some for the destructor (break).
    Vec<i64> nums = Vec::from_fn(6, [](usize i) : i64 { narrow<i64>(i * i) });
    i64 t = 0;
    foreach (x in nums)
    {
        if (x > 9)
        {
            break;
        }
        t += x;
    }
    printf("sum %v\n", t);
    // A view of the String held across a later drain and a trim.
    StringView first = ws[0];
    foreach (w in String::split_whitespace(&a))
    {
        printf("<%s>", w);
    }
    printf(" first=%s\n", first);
}
