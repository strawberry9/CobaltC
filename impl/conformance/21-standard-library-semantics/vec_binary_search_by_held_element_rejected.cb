// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `binary_search_by`, [Read-Conflict]; conf.vec-binary-search-by-held-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 747275650a
//
// binary_search_by with a named function over a vector whose v[3] is held
// exclusively: a search that never borrows v[3] completes; one whose
// halving reaches it clashes.

import std;

fn below(ref<i64, shared> a, ref<i64, shared> b) : bool
{
    *a < *b
}

fn main() : u8
{
    Vec<i64> v = Vec::new();
    foreach (i in 0..8: i64)
    {
        Vec::push(&mut v, i);
    }
    Vec<ref<i64, exclusive>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &mut v[3]);
    }
    printf("%v\n", Result::is_ok(&Vec::binary_search_by(&v, &6, below)));
    printf("%v\n", Result::is_ok(&Vec::binary_search_by(&v, &3, below)));
    *held[0] = 1;
    0
}
