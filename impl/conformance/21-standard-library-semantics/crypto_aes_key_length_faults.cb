// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Crypto-Length] (D-0165); conf.aes-key-length
// kind: negative
// expect: diag.crypto-length (dynamic)
//
// An AES key of 20 bytes is none of AES-128, AES-192 or AES-256.

import std;

fn main() : u8
{
    array<u8, 20> key = [7; 20];
    array<u8, 12> nonce = [0; 12];
    Vec<u8> none = Vec::new();
    Vec<u8> sealed = aes_gcm_seal(&key[0..$], &nonce[0..$], &none[0..$], &none[0..$]);
    printf("%u\n", Vec::len(&sealed));
    0
}
