// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.print [Print-Buffer]; rule.stdlib.process; D-0178; conf.stdout-buffer-child
// kind: positive
// expect: ok
// expect-stdout-hex: 6265666f72650a6368696c640a6166746572
// platform: unix
//
// A child started with `Command::status` writes to the program's own
// standard output; what the program wrote before is written out first,
// so the child's line comes after it.

import std;

fn main()
{
    printf("before\n");
    Command c = Command::new("/bin/echo");
    Command::arg(&mut c, "child");
    match (Command::status(&c))
    {
        Ok(s)  : assert(s == 0),
        Err(_) : assert(false),
    }
    printf("after");
}
