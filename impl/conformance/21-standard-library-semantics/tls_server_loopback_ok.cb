// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.tls [Tls-Server] [Tls-Read-Line] [Tls-Peer-Certificate] (D-0186, D-0181); conf.tls-server, conf.tls-read-line, conf.tls-peer-certificate
// kind: positive
// expect: ok
// slow: TLS handshakes under the interpreter take over a minute
// expect-stdout-hex: 
//
// Hermetic: a TLS 1.3 server in one thread, with a self-signed Ed25519
// certificate for `localhost` (valid to 2100), and the client in the
// main thread trusting that certificate: lines both ways, the peer
// certificate seen by the client and absent on the server, close_notify
// read as the end; then a client refusing the server for another name
// (the server sees the handshake fail and goes on), and a peer that is
// not TLS. About a minute in the interpreter: two handshakes' worth of
// public-key arithmetic.

import std;

const str KEY = "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIG/xpX/23qwZ8iDRpzBtyYErXB+yw1ePRPCeOrMbHv6h\n-----END PRIVATE KEY-----\n";
const str CRT = "-----BEGIN CERTIFICATE-----\nMIIBfzCCATGgAwIBAgIUT5+4C2nK5/ckjqCAbHutlwq/fFowBQYDK2VwMBQxEjAQ\nBgNVBAMMCWxvY2FsaG9zdDAgFw0yNjEwMDcwNTE1MDFaGA8yMTAwMDkwOTA1MTUw\nMVowFDESMBAGA1UEAwwJbG9jYWxob3N0MCowBQYDK2VwAyEAegP8qkgXtxseLdoQ\nVA0JHXycpuJ8Pngy7dgQ3xsz552jgZIwgY8wHQYDVR0OBBYEFDSsOJwWBXtwFB5F\nALP2IghQZGKuMB8GA1UdIwQYMBaAFDSsOJwWBXtwFB5FALP2IghQZGKuMA8GA1Ud\nEwEB/wQFMAMBAf8wCwYDVR0PBAQDAgKEMBMGA1UdJQQMMAoGCCsGAQUFBwMBMBoG\nA1UdEQQTMBGCCWxvY2FsaG9zdIcEfwAAATAFBgMrZXADQQBo4o2RWAyOEsn05+06\n9J3Dk9EvdsEp2cq67rhtYhNMNEEOvAUQ3bY3x/ykp+tcRbGW/RKox3FHoJUKTkw8\ng2AG\n-----END CERTIFICATE-----\n";

fn serve(TcpListener l, PrivateKey key, Vec<Certificate> chain) : u8
{
    u8 failures = 0;
    foreach (i in 0..3)
    {
        TcpStream tcp = Result::unwrap(TcpListener::accept(&mut l));
        TlsStream s = match (TlsStream::server(tcp, &key, &chain[0..$]))
        {
            Ok(s)  : s,
            Err(_) :
            {
                failures += 1;
                continue;
            },
        };
        printf("server sees peer certificate: %v\n", Option::is_some(&TlsStream::peer_certificate(&s)));
        while (true)
        {
            match (TlsStream::read_line(&mut s))
            {
                Ok(Some(line)) :
                {
                    _ = TlsStream::write_text(&mut s, "echo ");
                    _ = TlsStream::write_text(&mut s, String::as_view(&line));
                    _ = TlsStream::write_text(&mut s, "\n");
                },
                Ok(None)       : break,
                Err(_)         : break,
            }
        }
        _ = TlsStream::close(&mut s);
    }
    failures
}

fn main()
{
    PrivateKey key = Result::unwrap(PrivateKey::from_pem(KEY));
    Vec<Certificate> chain = certificates_from_pem(CRT);
    TrustStore roots = TrustStore::new();
    TrustStore::add(&mut roots, Certificate::clone(&chain[0]));
    TcpListener l = Result::unwrap(TcpListener::bind(SocketAddr::new(IpAddr::localhost_v4(), 0)));
    SocketAddr addr = TcpListener::local_addr(&l);
    auto server = spawn(serve, l, key, chain);
    TlsStream c = Result::unwrap(TlsStream::connect(addr, "localhost", &roots));
    _ = TlsStream::write_text(&mut c, "one\r\ntwo\n");
    printf("%v\n", &Option::unwrap_or(Result::unwrap(TlsStream::read_line(&mut c)), String::new()));
    printf("%v\n", &Option::unwrap_or(Result::unwrap(TlsStream::read_line(&mut c)), String::new()));
    printf("peer: %v\n", &Option::unwrap(TlsStream::peer_certificate(&c)).common_name);
    _ = TlsStream::close(&mut c);
    printf("end: %v\n", Option::is_none(&Result::unwrap(TlsStream::read_line(&mut c))));
    match (TlsStream::connect(addr, "example.invalid", &roots))
    {
        Ok(_)  : printf("accepted?\n"),
        Err(e) : printf("other name: %s\n", TlsError::text(&e)),
    }
    TcpStream plain = Result::unwrap(TcpStream::connect(addr));
    _ = TcpStream::write_text(&mut plain, "GET / HTTP/1.0\r\n\r\n");
    TcpStream::set_read_timeout_ms(&mut plain, 10000);
    Vec<u8> answer = Vec::new();
    _ = TcpStream::read(&mut plain, &mut answer, 100);
    printf("not tls: %v\n", Vec::len(&answer) == 0 || answer[0] == 21);
    drop(plain);
    printf("handshakes failed: %v\n", join(server));
}
