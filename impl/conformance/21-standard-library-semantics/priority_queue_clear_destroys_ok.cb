// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.priority-queue [Priority-Queue] (D-0137); conf.priority-queue-destroy
// kind: positive
// expect: ok
// expect-stdout-hex: 746f6f6b20310a636c6561720a64726f7020340a64726f7020390a64726f7020360a656e640a64726f7020310a64726f7020370a64726f7020380a
//
// A priority queue owns its elements: `clear` destroys them and leaves
// the queue usable, and those left when it ends are destroyed with it.
// Both destroy in the order the heap holds them (the body's, §2i).

import std;

resource struct Tracked
{
    u32 id;
}

fn Tracked::drop(ref<Tracked, exclusive> self)
{
    printf("drop %d\n", self.id);
}

fn tracked_less(ref<Tracked, shared> a, ref<Tracked, shared> b) : bool
{
    a.id < b.id
}

fn main()
{
    {
        PriorityQueue<Tracked> q = PriorityQueue::new_by(tracked_less);
        PriorityQueue::push(&mut q, Tracked { .id = 9 });
        PriorityQueue::push(&mut q, Tracked { .id = 4 });
        PriorityQueue::push(&mut q, Tracked { .id = 6 });
        PriorityQueue::push(&mut q, Tracked { .id = 1 });
        Tracked t = Option::unwrap(PriorityQueue::pop(&mut q));
        printf("took %d\n", t.id);
        printf("clear\n");
        PriorityQueue::clear(&mut q);
        PriorityQueue::push(&mut q, Tracked { .id = 8 });
        PriorityQueue::push(&mut q, Tracked { .id = 7 });
        printf("end\n");
    }
}
