// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `retain`, [Borrow-Denied]; conf.vec-capturing-predicate-held-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 66616c73650a
//
// A capturing predicate writing another vector's element through its
// capture runs once per element; then a retain whose vector's v[3] is
// held exclusively elsewhere: the borrow of v[3] for the predicate
// clashes.

import std;

fn main() : u8
{
    Vec<i64> v = Vec::filled(5, 2: i64);
    Vec<i64> w = Vec::filled(5, 2: i64);
    ref<i64, exclusive> e = &mut w[2];
    printf("%v\n", Option::is_some(&Vec::position(&v, [e](ref<i64, shared> x) : bool { *e += 1; *x == 9 })));
    printf("%v\n", w[2]);
    Vec<ref<i64, exclusive>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &mut v[3]);
    }
    i64 n = 0;
    Vec::retain(&mut v, [n](ref<i64, shared> x) : bool { n += 1; *x > 0 });
    *held[0] = 1;
    0
}
