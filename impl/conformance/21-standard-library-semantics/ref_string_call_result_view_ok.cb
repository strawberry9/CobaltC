// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.type.coerce-text [Coerce-Text] (D-0312); rule.stdlib.stringview [View-Form]; conf.ref-string-call-result-view
// kind: positive
// expect: ok
// expect-stdout-hex: 616263206465666768206566207472756520747275650a
//
// A `ref<String, _>` a call gives, where a `StringView` is declared, is the
// text's view (`&(*e)[0..$]`, the form the rule writes), and so is `*&s`,
// which `[Cmp-Through-Shared-Ref]` writes for `&s < "tea"`. Before CHG-0416
// both were "`String` is not sliced".

import std;

fn same<T>(T x) : T
{
    x
}

fn same_ref(ref<String, shared> a) : ref<String, shared>
{
    a
}

fn main()
{
    String s = "abc";
    String t = "defgh";
    StringView v = same(&s);
    StringView w = same_ref(&t);
    StringView x = &(*same(&t))[1..3];
    printf("%v %v %v %v %v\n", v, w, x, &s < "tea", "zz" > &t);
}
