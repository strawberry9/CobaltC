// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `Vec::from_slice<T: clone>` (D-0085, D-0116); conf.vec-from-slice-resource-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// Copying elements that have no clone: rejected at the call, as for
// `Vec::clone`.

import std;

resource struct Handle
{
    u32 fd;
}

fn Handle::drop(ref<Handle, exclusive> self)
{
}

fn main()
{
    Vec<Handle> w = Vec::new();
    Vec::push(&mut w, Handle { .fd = 1 });
    Vec<Handle> c = Vec::from_slice(&w[0..$]);
}
