// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §0 `Option::unwrap` (D-0082); conf.unwrap-none-faults
// kind: negative
// expect: diag.unwrap-failed (dynamic)
//
// `unwrap` of a `None` faults at the call.

import std;

fn main()
{
    Vec<u32> v = Vec::new();
    u32 x = Option::unwrap(Vec::pop(&mut v));
}
