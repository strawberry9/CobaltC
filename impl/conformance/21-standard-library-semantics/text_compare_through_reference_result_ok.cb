// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.expr.cmp [Cmp-Text]; D-0108; CHG-0363; conf.text-compare-through-reference-result
// kind: positive
// expect: ok
// expect-stdout-hex: 7472756520747275652066616c73650a
//
// Two `String`s compared where each is a field reached through a call's
// reference result (`Box::get(a).name`): each is read where it is, neither
// is moved, as when the fields are reached through a binding.

import std;

struct N
{
    String name;
}

fn same(ref<Box<N>, shared> a, ref<Box<N>, shared> b) : bool
{
    Box::get(a).name == Box::get(b).name
}

fn before(ref<Box<N>, shared> a, ref<Box<N>, shared> b) : bool
{
    Box::get(a).name < Box::get(b).name
}

fn main() : u8
{
    Box<N> x = Box::new(N { .name = String::from_str("a") });
    Box<N> y = Box::new(N { .name = String::from_str("a") });
    Box<N> z = Box::new(N { .name = String::from_str("b") });
    printf("%v %v %v\n", same(&x, &y), before(&x, &z), same(&x, &z));
    0
}
