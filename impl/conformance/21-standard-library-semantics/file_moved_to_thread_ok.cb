// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.file-handle; rule.conc.spawn (a resource moved into a thread); D-0054; conf.file-moved-to-thread
// kind: positive
// expect: ok
// expect-stdout-hex: 312066726f6d2074686520776f726b65720a
// args: $TMP
//
// A `File` is a resource: it moves into a spawned thread, which writes
// to it and closes it; after `join` the main thread reads what it wrote.

import std;

fn work(File f) : i32
{
    String line = String::from_str("from the worker\n");
    Result::unwrap_or(File::write_str(&mut f, &line), ());
    match (File::close(f))
    {
        Ok(_) : 1,
        Err(_) : 0,
    }
}

fn main()
{
    String dir = Result::unwrap_or(arg(0), String::new());
    String path = String::new();
    String::append(&mut path, &dir);
    String::append(&mut path, "/worker.log");
    File f = match (File::create(&path))
    {
        Ok(f) : f,
        Err(_) : fault(assertion_failed),
    };
    auto h = spawn(work, f);
    i32 closed = join(h);
    String text = Result::unwrap_or(read_file(&path), String::new());
    printf("%v %s", closed, &text);
}
