// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.crypto [Hkdf] (D-0152); conf.hkdf-too-long
// kind: negative
// expect: diag.hkdf-length (dynamic)
//
// RFC 5869 bounds `hkdf_expand`'s output at 255 blocks of 32 bytes; one
// byte more is misuse.

import std;

fn main()
{
    Vec<u8> ikm = Vec::filled(22, 0x0b);
    Vec<u8> none = Vec::new();
    Vec<u8> too_long = hkdf_sha256(&none[0..$], &ikm[0..$], &none[0..$], 8161);
}
