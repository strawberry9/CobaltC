// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `Vec::reserve`, rule.stdlib.string `String::reserve` (D-0129); conf.vec-reserve, conf.vec-reserve-keeps, conf.string-reserve
// kind: positive
// expect: ok
// expect-stdout-hex: 6f6b0a
//
// `reserve` makes room for more without changing the length or the
// elements; reserving room already there, or none, changes nothing.
// `String::reserve` makes room for bytes; the text is unchanged.

import std;

fn main()
{
    Vec<u32> v = Vec::new();
    Vec::reserve(&mut v, 0);
    assert(Vec::len(&v) == 0);
    Vec::reserve(&mut v, 100);
    assert(Vec::len(&v) == 0);
    foreach (i in 0..100: u32)
    {
        Vec::push(&mut v, i * i);
    }
    Vec::reserve(&mut v, 3);
    Vec::reserve(&mut v, 1);
    assert(Vec::len(&v) == 100 && v[0] == 0 && v[7] == 49 && v[99] == 9801);
    Vec::push(&mut v, 1);
    assert(Vec::len(&v) == 101 && v[100] == 1);

    Vec<String> names = Vec::new();
    Vec::push(&mut names, String::from_str("ada"));
    Vec::reserve(&mut names, 10);
    Vec::push(&mut names, String::from_str("grace"));
    assert(Vec::len(&names) == 2 && String::eq_str(&names[0], "ada") && String::eq_str(&names[1], "grace"));

    String s = "caf\u{e9}";
    String::reserve(&mut s, 64);
    assert(String::eq_str(&s, "caf\u{e9}") && String::len(&s) == 5);
    String::append(&mut s, "!");
    assert(String::eq_str(&s, "caf\u{e9}!"));
    printf("ok\n");
}
