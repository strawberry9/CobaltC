// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview `StringView::of` over `[Reclaim]` (spec/20 rule.trust.rawptr); rule.stdlib.str `[Str-Literal-View]`
// kind: positive
// expect: ok
// expect-stdout-hex: 6f6b0a
//
// A literal viewed in a function is reclaimed again on every call. Here
// the first call's view ends without being read through (`find` returns
// at once: the needle is longer than the text), and the next call reads
// through a new view of the same literal. Each `[Reclaim]` gives a new
// root path, so the second view is valid. cobc once handed back the
// first call's root path, already ended: `diag.stale-binding` at the
// `find` (2026-10-03).

import std;

fn has_ti(StringView a) : bool
{
    Option::is_some(&StringView::find(a, "ti"))
}

fn reply_ms(StringView line) : Option<usize>
{
    usize at = StringView::find(line, "time=")?;
    Some(at)
}

fn main()
{
    assert(!has_ti("b"), "a needle longer than the text is not found");
    assert(has_ti("time"), "found after a call that returned early");
    assert(!has_ti(""), "not in empty text");
    assert(has_ti("tide"), "found again");

    assert(Option::is_none(&reply_ms("")), "no time= in an empty line");
    assert(Option::is_none(&reply_ms("--- statistics ---")), "none in a long line");
    assert(Option::is_some(&reply_ms("64 bytes: time=0.06 ms")), "a reply line");
    printf("ok\n");
}
