// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.ffi `CString::new`, `CString::ptr`, `String::from_c`, `Vec::from_c_bytes`, `is_null`, `null_rawptr` (D-0252); conf.cstring-roundtrip
// kind: positive
// expect: ok
// expect-stdout-hex: 6c656e20362c20627974657320360a6261636b2068c3a96c6c6f0a6e6f74205554462d3820617420300a726177203235352039370a656d70747920300a6e756c6c207965732c2074657874206e6f0a
//
// A `CString` holds the text and one NUL; reading its address back with
// `String::from_c` gives the text again, in both tools (coby reads its own
// memory). Bytes that are not UTF-8 come back as `Err` from `from_c` and
// as they are from `Vec::from_c_bytes`; the empty text is one NUL.

import std;

fn yes(bool b) : str
{
    if (b)
    {
        "yes"
    }
    else
    {
        "no"
    }
}

fn main()
{
    CString c = Result::expect(CString::new("héllo"), "no NUL");
    printf("len %d, bytes %d\n", CString::len(&c), slice_len(CString::as_bytes(&c)));
    rawptr<u8> p = CString::ptr(&c);
    String back = Result::expect(unsafe
    {
        String::from_c(p)
    }, "UTF-8");
    printf("back %s\n", &back);
    Vec<u8> bad = Vec::new();
    Vec::push(&mut bad, 0xff: u8);
    Vec::push(&mut bad, b'a');
    CString b = Result::expect(CString::from_bytes(&bad[0 .. 2]), "no NUL");
    match (unsafe { String::from_c(CString::ptr(&b)) })
    {
        Ok(_)  : printf("UTF-8?\n"),
        Err(e) : printf("not UTF-8 at %d\n", e.offset),
    }
    Vec<u8> raw = unsafe
    {
        Vec::from_c_bytes(CString::ptr(&b))
    };
    printf("raw %d %d\n", raw[0], raw[1]);
    CString empty = Result::expect(CString::new(""), "no NUL");
    String e = Result::expect(unsafe { String::from_c(CString::ptr(&empty)) }, "UTF-8");
    printf("empty %d\n", String::len(&e));
    printf("null %s, text %s\n", yes(is_null(null_rawptr<i64>())), yes(is_null(p)));
}
