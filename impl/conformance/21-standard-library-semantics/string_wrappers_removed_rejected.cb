// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.module.retired [Use-Removed] (D-0303, D-0306): `String::find` and the other `String::` text wrappers are removed; conf.std-string-wrappers-removed
// kind: negative
// expect: diag.removed-use (static)
//
// `&s` is the view of a `String` where a `StringView` is declared, so the
// `StringView::` function is written: `StringView::find(&s, "b")`.

import std;

fn main()
{
    String s = "abc";
    printf("%v\n", String::find(&s, "b") == Some(1));
}
