// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview [Ref-String-View] in a body reached through a rewrite (D-0164, D-0302, CHG-0404); conf.json-get-keys
// kind: positive
// expect: ok
// stdout: true true true false 3
//
// `Json::get` compares each member's `String` key with the `StringView` it
// is given; that `==` is a call of `std`'s `String::same_view`, whose body views its
// `String` where a `StringView` is declared. That body is first reached
// once the `==` is rewritten, and its own view is applied too, so every key
// is found and a missing one is not.

import std;
import std::encoding::json;

fn main()
{
    Json d = Result::unwrap(Json::parse("{\"n\": 1, \"ab\": 2, \"abc\": 3}"));
    bool a = Option::is_some(&Json::get(&d, "n"));
    bool b = Option::is_some(&Json::get(&d, "ab"));
    bool c = Option::is_some(&Json::get(&d, "abc"));
    bool m = Option::is_some(&Json::get(&d, "x"));
    i64 v = Option::unwrap(Json::as_i64(Option::unwrap(Json::get(&d, "abc"))));
    printf("%v %v %v %v %v\n", a, b, c, m, v);
}
