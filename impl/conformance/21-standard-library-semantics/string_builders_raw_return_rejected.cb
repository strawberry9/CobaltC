// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §2d, D-0196; conf.string-builders-raw-return
// kind: negative
// expect: diag.not-char-boundary (dynamic)
// expect-stdout-hex: 5b68c3a96c6c6f2d305d20370a5b68c3a96c6c6f2d315d20370a5b636c655d20330a5b68c3a96c6c6f2d335d20370a
//
// a String built by every std builder and returned, its caller binding
// it; truncate inside a character faults (D-0196)

import std;

fn build(u32 k) : String
{
    String s = String::from_str("héllo");
    String::push_ascii(&mut s, b'-');
    String::append(&mut s, k);
    String::push_code_point(&mut s, 0x1F600);
    if (k == 2)
    {
        String::clear(&mut s);
        String::append(&mut s, "cleared");
    }
    String::truncate(&mut s, String::len(&s) - 4);
    s
}

fn main()
{
    for (u32 k = 0; k < 4; k += 1)
    {
        String b = build(k);
        printf("[%s] %v\n", &b, String::char_count(&b));
    }
    String m = String::from_str("é");
    String::truncate(&mut m, 1);
    printf("unreached %s\n", &m);
}
