// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec (pop)
// kind: positive
// expect: ok
//
// pop removes and returns the last element as Some(v); popping an
// empty Vec returns None.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    match (Vec::pop(&mut v))
    {
        Some(x) :
        {
            if (x != 2)
            {
                1 / (1 - 1);
            }
        },
        None :
        {
            1 / (1 - 1);
        },
    }
    Vec::pop(&mut v);
    match (Vec::pop(&mut v))
    {
        Some(_) :
        {
            1 / (1 - 1);
        },
        None :
        {
        },
    }
}
