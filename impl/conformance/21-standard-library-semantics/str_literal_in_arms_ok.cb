// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.str `[Str-Literal-String]` `[Str-Literal-View]` (D-0155); conf.str-literal-in-arms
// kind: positive
// expect: ok
// expect-stdout-hex: 6e6f6e652b206c6f6e6720626c6f636b20796573206f6e6520686579210a
//
// A literal that a `match` arm, an `if` branch or a block gives, in a
// position whose declared type is `String` or `StringView`, is typed by
// that position as a literal standing there alone is: a `String` local's
// initializer, a struct literal's `String` field, an argument whose
// parameter is a `String`, and a `StringView` local.

import std;

struct Labeled
{
    String label;
    i32 n;
}

fn shout(String s) : String
{
    String::append(&mut s, "!");
    s
}

fn main() : u8
{
    Option<i32> o = None;
    String a = match (o)
    {
        Some(_) : String::from_str("some"),
        None    : "none",
    };
    String b = if (String::len(&a) > 3) { "long" } else { "short" };
    String c = {
        "block"
    };
    Labeled l = Labeled { .label = if (true) { "yes" } else { "no" }, .n = 1 };
    StringView v = match (l.n)
    {
        1 : "one",
        _ : "other",
    };
    String::append(&mut a, "+");
    printf("%s %s %s %s %s %s\n", &a, &b, &c, &l.label, v, &shout(match (l.n) { 1 : "hey", _ : "ho", }));
    0
}
