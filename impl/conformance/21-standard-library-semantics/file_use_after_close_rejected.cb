// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.file-handle [File-Close]; rule.resauth.transfer; D-0054; conf.file-use-after-close-rejected
// kind: negative
// expect: diag.stale-binding (static)
// args: $TMP
//
// `File::close` takes the `File` by value, so a closed file cannot be
// written to: the write after `close` names a moved (stale) binding.

import std;

fn main()
{
    String dir = Result::unwrap_or(arg(0), String::new());
    String path = String::new();
    String::append(&mut path, &dir);
    String::append(&mut path, "/x.log");
    File f = match (File::create(&path))
    {
        Ok(f) : f,
        Err(_) : fault(assertion_failed),
    };
    Result::unwrap_or(File::close(f), ());
    String late = String::from_str("late\n");
    Result::unwrap_or(File::write_str(&mut f, &late), ());
}
