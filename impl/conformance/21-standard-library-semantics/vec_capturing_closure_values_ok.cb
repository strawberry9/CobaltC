// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: spec/21 §1 Vec; conf.vec-capturing-closure-values
// kind: positive
// expect: ok
// expect-stdout-hex: 31320a30203120322033203420352036203720382039203130203131200a363a203120332035203720392031310a6669727374203e203320617420320a330a310a
//
// capturing closure values held in fn locals as retain, position and
// binary_search_by predicates, one reassigned between calls, and a
// closure capturing a struct holding a Vec (D-0192)

import std;

struct Box2
{
    Vec<i64> held;
}

fn main()
{
    Vec<i64> a = Vec::new();
    foreach (i in 0..20: i64)
    {
        Vec::push(&mut a, i);
    }
    i64 lim = 12;
    i64 seen = 0;
    fn(ref<i64, shared>) : bool keep = [lim](ref<i64, shared> x) : bool { *x < lim };
    Vec::retain(&mut a, keep);
    printf("%v\n", Vec::len(&a));
    fn(ref<i64, shared>) : bool odd = [lim](ref<i64, shared> x) : bool { printf("%v ", *x); *x % 2 == 1 && *x < lim };
    Vec::retain(&mut a, odd);
    printf("\n%v:", Vec::len(&a));
    foreach (x in &a)
    {
        printf(" %v", *x);
    }
    printf("\n");
    keep = [seen](ref<i64, shared> x) : bool { seen += 1; *x > 3 };
    match (Vec::position(&a, keep))
    {
        Some(k) : printf("first > 3 at %v\n", k),
        None    : printf("none\n"),
    }
    i64 key = 7;
    fn(
        ref<i64, shared>,
        ref<i64, shared>,
    ) : bool lt = [key](ref<i64, shared> p, ref<i64, shared> q) : bool { *p + 0 * key < *q };
    printf("%v\n", Result::unwrap_or(Vec::binary_search_by(&a, &key, lt), 99));
    Box2 b = Box2 { .held = Vec::new() };
    Vec::push(&mut b.held, 5);
    fn() : usize count = [b]() : usize { Vec::len(&b.held) };
    printf("%v\n", count());
}
