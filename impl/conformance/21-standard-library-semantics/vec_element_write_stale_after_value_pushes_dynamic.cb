// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.value-object.write [Write] diag.stale-binding D-0007
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// The target of an assignment is found first, then its value is
// evaluated, then the write is checked (spec/13 §1). The value's pushes
// reallocate the vector, so the element reference found first is stale
// by the time of the write.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 7);
    *Vec::index_exclusive(&mut v, 0) = {
        Vec::push(&mut v, 1);
        Vec::push(&mut v, 2);
        Vec::push(&mut v, 3);
        Vec::push(&mut v, 4);
        5
    };
}
