// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.value-object.write [Write] diag.stale-binding D-0007; conf.vec-element-write-stale-after-value-pushes-dynamic
// kind: negative
// expect: diag.stale-binding (static)
//
// The target of an assignment is found first, then its value is
// evaluated, then the write is checked (spec/13 §1). The value's pushes
// reallocate the vector, so the element reference found first is stale
// by the time of the write.
//
// D-0282: the static pass rejects this program before it runs (it was found
// at run time before): the place is found before the value is computed, and
// the value takes `v` exclusively, which may move the place (evaluation
// order, D-0007).

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 7);
    *Vec::index_exclusive(&mut v, 0) = {
        Vec::push(&mut v, 1);
        Vec::push(&mut v, 2);
        Vec::push(&mut v, 3);
        Vec::push(&mut v, 4);
        5
    };
}
