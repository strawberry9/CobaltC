// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.prelude rule.module.resolve [Resolve-Unbound] (D-0177); conf.std-text-has-no-bytes
// kind: negative
// expect: diag.unbound-name (static)
//
// `std::text` is text: `read_le` is in `std::collections` (D-0177), so
// importing `std::text` alone does not name it.

import std::text;
import std::io;

fn main()
{
    Vec<u8> v = Vec::new();
    printf("%v\n", read_le<u16>(&v[0..$], 0));
}
