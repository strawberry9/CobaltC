// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.type.probe `probe<K>` (D-0312): a `String` key's probe is a view, so `HashMap::get`, `get_mut`, `contains`, `remove` and `HashSet::contains`, `remove` take a literal; conf.map-lookup-by-literal, conf.set-lookup-by-literal
// kind: positive
// expect: ok
// stdout: ok
//
// A map or set keyed by `String`, asked with a literal: the literal is the
// view the key's probe is (D-0312), the same entry as a `String` of the same
// bytes finds, and no `String` is made. `remove`
// keeps the order of the others (D-0134).

import std;

fn main()
{
    HashMap<String, i32> m = HashMap::new();
    HashMap::insert(&mut m, "core", 1);
    HashMap::insert(&mut m, "data", 2);
    HashMap::insert(&mut m, "ui", 3);
    match (HashMap::get(&m, "data")) { Some(v) : assert(*v == 2), None : assert(false), }
    assert(HashMap::get(&m, "nope") == None && HashMap::get(&m, "") == None);
    assert(HashMap::contains(&m, "ui") && !HashMap::contains(&m, "u") && !HashMap::contains(&m, "ui "));
    match (HashMap::get_mut(&mut m, "core")) { Some(v) : { *v = 10; }, None : assert(false), }
    String core = "core";
    match (HashMap::get(&m, &core)) { Some(v) : assert(*v == 10), None : assert(false), }
    assert(HashMap::remove(&mut m, "core") == Some(10));
    assert(HashMap::remove(&mut m, "core") == None);
    assert(HashMap::len(&m) == 2 && !HashMap::contains(&m, &core));
    assert(*HashMap::key_at(&m, 0) == "data");    // the others keep their order
    assert(HashMap::remove(&mut m, "ui") == Some(3) && HashMap::len(&m) == 1);
    HashMap::insert(&mut m, "ui", 4);
    assert(HashMap::contains(&m, "ui") && HashMap::len(&m) == 2);
    HashMap<String, i32> u = HashMap::new();
    HashMap::insert(&mut u, "caf\u{e9}", 5);
    assert(*Option::unwrap(HashMap::get(&u, "caf\u{e9}")) == 5 && !HashMap::contains(&u, "cafe"));

    HashSet<String> s = HashSet::new();
    HashSet::insert(&mut s, "a");
    HashSet::insert(&mut s, "b");
    assert(HashSet::contains(&s, "a") && !HashSet::contains(&s, "c"));
    assert(HashSet::remove(&mut s, "a") && !HashSet::remove(&mut s, "a") && HashSet::len(&s) == 1);
    assert(*HashSet::key_at(&s, 0) == "b");
    printf("ok\n");
}
