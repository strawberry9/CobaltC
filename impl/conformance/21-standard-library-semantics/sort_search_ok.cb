// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.sort [Sort] [Sort-By] [Binary-Search]; D-0062; conf.sort-search
// kind: positive
// expect: ok
// expect-stdout-hex: 
//
// `Vec::sort` in the key types' order (negative integers, `u64`'s and
// `i128`'s extremes, `bool`, `String`s by their bytes), `Vec::sort_by`
// with a program's comparison (descending; records by a field, equal
// ones in their original order; `Vec`s by length), `binary_search` and
// `binary_search_by` (the first equal position, or where the key would
// go), and empty and one-element vectors.

import std;

struct Rec
{
    String name;
    i32 score;
}

fn by_score(ref<Rec, shared> a, ref<Rec, shared> b) : bool
{
    a.score < b.score
}

fn descending(ref<i64, shared> a, ref<i64, shared> b) : bool
{
    *a > *b
}

fn by_len(ref<Vec<i32>, shared> a, ref<Vec<i32>, shared> b) : bool
{
    Vec::len(a) < Vec::len(b)
}

fn show_i64(str label, ref<Vec<i64>, shared> v)
{
    printf("%s:", label);
    foreach (x in v)
    {
        printf(" %v", *x);
    }
    printf("\n");
}

fn main()
{
    Vec<i64> v = Vec::new();
    array<i64, 10> src = [5, -3, 9, 0, -3, 12, 7, 5, -100, 1];
    foreach (x in src)
    {
        Vec::push(&mut v, x);
    }
    Vec::sort(&mut v);
    show_i64("ints", &v);
    i64 seven = 7;
    i64 six = 6;
    i64 m3 = -3;
    i64 n99 = 99;
    printf("search 7: %v, search 6: %v, search -3: %v, search 99: %v\n", match (Vec::binary_search(&v, &seven))
    {
        Ok(i)  : i,
        Err(_) : 999,
    }, match (Vec::binary_search(&v, &six))
    {
        Ok(_)  : 999,
        Err(i) : i,
    }, match (Vec::binary_search(&v, &m3))
    {
        Ok(i)  : i,
        Err(_) : 999,
    }, match (Vec::binary_search(&v, &n99))
    {
        Ok(_)  : 999,
        Err(i) : i,
    });
    Vec::sort_by(&mut v, descending);
    show_i64("descending", &v);

    Vec<u64> big = Vec::new();
    Vec::push(&mut big, max_value<u64>());
    Vec::push(&mut big, 1);
    Vec::push(&mut big, 9223372036854775808);
    Vec::sort(&mut big);
    printf("u64: %v %v %v\n", big[0], big[1], big[2]);
    Vec<i128> huge = Vec::new();
    Vec::push(&mut huge, max_value<i128>());
    Vec::push(&mut huge, min_value<i128>());
    Vec::push(&mut huge, 0);
    Vec::sort(&mut huge);
    printf("i128 first negative: %v, last positive: %v\n", huge[0] < 0, huge[2] > 0);
    Vec<bool> bs = Vec::new();
    Vec::push(&mut bs, true);
    Vec::push(&mut bs, false);
    Vec::push(&mut bs, true);
    Vec::sort(&mut bs);
    printf("bools: %v %v %v\n", bs[0], bs[1], bs[2]);

    Vec<String> words = Vec::new();
    array<str, 7> ws = ["pear", "apple", "Zebra", "app", "banana", "apple", ""];
    foreach (w in ws)
    {
        Vec::push(&mut words, String::from_str(w));
    }
    Vec::sort(&mut words);
    printf("words:");
    foreach (w in &words)
    {
        printf(" [%s]", w);
    }
    printf("\n");
    String k = String::from_str("banana");
    String k2 = String::from_str("cherry");
    printf("banana at %v; cherry would go at %v\n", Result::unwrap_or(Vec::binary_search(&words, &k), 99), match (Vec::binary_search(&words, &k2))
    {
        Ok(_)  : 99,
        Err(i) : i,
    });

    // Stability: equal scores keep their order.
    Vec<Rec> rs = Vec::new();
    array<str, 6> names = ["ann", "bob", "cy", "dee", "eve", "fay"];
    array<i32, 6> scores = [3, 1, 3, 2, 1, 3];
    usize i = 0;
    while (i < 6)
    {
        Vec::push(&mut rs, Rec { .name = String::from_str(names[i]), .score = scores[i] });
        i += 1;
    }
    Vec::sort_by(&mut rs, by_score);
    printf("by score:");
    foreach (r in &rs)
    {
        printf(" %s=%v", &r.name, r.score);
    }
    printf("\n");
    Rec probe = Rec { .name = String::new(), .score = 3 };
    printf("first score 3 at %v\n", Result::unwrap_or(Vec::binary_search_by(&rs, &probe, by_score), 99));

    Vec<Vec<i32>> nested = Vec::new();
    usize n = 4;
    while (n > 0)
    {
        Vec<i32> inner = Vec::new();
        usize j = 0;
        while (j < n)
        {
            Vec::push(&mut inner, narrow<i32>(j));
            j += 1;
        }
        Vec::push(&mut nested, inner);
        n -= 1;
    }
    Vec::sort_by(&mut nested, by_len);
    printf("lengths: %v %v %v %v\n", Vec::len(&nested[0]), Vec::len(&nested[1]), Vec::len(&nested[2]), Vec::len(&nested[3]));

    Vec<i32> empty = Vec::new();
    Vec::sort(&mut empty);
    Vec<i32> one = Vec::new();
    Vec::push(&mut one, 4);
    Vec::sort(&mut one);
    i32 one_key = 1;
    printf("empty %v, one %v, search empty %v\n", Vec::len(&empty), one[0], match (Vec::binary_search(&empty, &one_key))
    {
        Ok(_)  : 99,
        Err(i) : i,
    });
}
