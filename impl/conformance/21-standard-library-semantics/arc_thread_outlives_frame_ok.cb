// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.arc `Arc<T>` (D-0259); spec/19 §2; conf.arc-thread-outlives-frame
// kind: positive
// expect: ok
// expect-stdout-hex: 35302035300a
//
// A function spawns a worker over a counter and returns the handle: the
// worker outlives the function's frame, which a reference to a local could
// not allow (the frame's end would destroy the counter while the thread
// holds a reference to it). Each thread owns its `Arc`; the function keeps
// one too and hands it back with the handle.

import std;

struct Started
{
    handle<u32> worker;
    Arc<Atomic<u32>> counter;
}

fn count(Arc<Atomic<u32>> c, u32 n) : u32
{
    for (u32 i = 0; i < n; i += 1)
    {
        _ = Atomic::fetch_add(Arc::get(&c), 1);
    }
    n
}

fn start(u32 n) : Started
{
    Arc<Atomic<u32>> counter = Arc::new(Atomic::new(0: u32));
    handle<u32> h = spawn(count, clone(&counter), n);
    Started { .worker = h, .counter = counter }
}

fn main()
{
    Started { worker, counter } = start(50);
    u32 n = join(worker);
    printf("%v %v\n", n, Atomic::load(Arc::get(&counter)));
}
