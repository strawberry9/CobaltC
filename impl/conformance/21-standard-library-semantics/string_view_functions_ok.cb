// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview `String::as_view`, `find`, `starts_with`, `ends_with`, `trim`, `trim_start`, `trim_end`, `split` (D-0113); conf.string-view-functions, conf.string-split
// kind: positive
// expect: ok
//
// The searching and splitting functions straight from a `String`: each
// is the `StringView::` one applied to `&s[0..$]`, and its result
// borrows the `String` as a view does.

import std;

fn main()
{
    String line = "  set width=80, height = 24  ";
    assert(String::find(&line, "width") == Some(6));
    assert(String::find(&line, "zzz") == None);
    assert(String::starts_with(&line, "  set") && !String::starts_with(&line, "set"));
    assert(String::ends_with(&line, "24  ") && !String::ends_with(&line, "24"));
    assert(String::trim(&line) == "set width=80, height = 24");
    assert(String::trim_start(&line) == "set width=80, height = 24  ");
    assert(String::trim_end(&line) == "  set width=80, height = 24");
    assert(String::as_view(&line) == &line[0..$]);
    Vec<StringView> parts = String::split(&line, ",");
    assert(Vec::len(&parts) == 2 && StringView::trim(parts[0]) == "set width=80" && StringView::trim(parts[1]) == "height = 24");
    String empty = String::new();
    assert(Vec::len(&String::split(
        &empty,
        ",",
    )) == 1 && String::trim(&empty) == "" && String::find(&empty, "") == Some(0));
    String word = "héllo";
    assert(String::find(&word, "llo") == Some(3) && StringView::len(String::trim(&word)) == 6);
    printf("ok\n");
}
