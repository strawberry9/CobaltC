// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.stringview `&s` as a view, `find`, `starts_with`, `ends_with`, `trim`, `trim_start`, `trim_end`, `split` (D-0113); conf.string-view-functions, conf.string-split
// kind: positive
// expect: ok
//
// The searching and splitting functions straight from a `String`: each
// is the `StringView::` one applied to `&s[0..$]`, and its result
// borrows the `String` as a view does.

import std;

fn main()
{
    String line = "  set width=80, height = 24  ";
    assert(StringView::find(&line, "width") == Some(6));
    assert(StringView::find(&line, "zzz") == None);
    assert(StringView::starts_with(&line, "  set") && !StringView::starts_with(&line, "set"));
    assert(StringView::ends_with(&line, "24  ") && !StringView::ends_with(&line, "24"));
    assert(StringView::trim(&line) == "set width=80, height = 24");
    assert(StringView::trim_start(&line) == "set width=80, height = 24  ");
    assert(StringView::trim_end(&line) == "  set width=80, height = 24");
    assert(&line[0..$] == &line[0..$]);
    Vec<StringView> parts = StringView::split(&line, ",");
    assert(Vec::len(&parts) == 2 && StringView::trim(parts[0]) == "set width=80" && StringView::trim(parts[1]) == "height = 24");
    String empty = String::new();
    assert(Vec::len(&StringView::split(
        &empty,
        ",",
    )) == 1 && StringView::trim(&empty) == "" && StringView::find(&empty, "") == Some(0));
    String word = "héllo";
    assert(StringView::find(&word, "llo") == Some(3) && StringView::len(StringView::trim(&word)) == 6);
    printf("ok\n");
}
