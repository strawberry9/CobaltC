// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.prelude (D-0136, D-0176); conf.std-subjects-fs-env
// kind: positive
// expect: ok
// expect-stdout-hex: 617267756d656e74733a20300a6d697373696e672066696c6520726566757365643a20747275650a636c6f636b20666f72776172643a20747275650a63757272656e74206469726563746f7279206b6e6f776e3a20747275650a
//
// Each subject of `std` imported alone (D-0176): files and paths from
// `std::fs`, the arguments and the environment from `std::env`, the clocks
// from `std::time`, the standard streams from `std::io`.

import std::io;
import std::fs;
import std::env;
import std::time;
import std::core;

fn main()
{
    printf("arguments: %v\n", arg_count());
    printf("missing file refused: %v\n", Result::is_err(&read_file("does-not-exist.txt")));
    u64 a = monotonic_ns();
    u64 b = monotonic_ns();
    printf("clock forward: %v\n", b >= a);
    printf("current directory known: %v\n", Result::is_ok(&current_dir()));
}
