// CONFORMANCE-CASE
// spec: 21-standard-library-semantics
// facility: rule.stdlib.vec `Vec::clone<T: clone>` (D-0082, D-0116); conf.vec-clone-resource-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// `Vec::clone` copies each element with `clone`, so `T` must be `clone`:
// a `resource` type with a destructor and no `T::clone` is not. (Before
// D-0116 the case was a `Vec<String>`; a `String` is `clone`.)

import std;

resource struct Handle
{
    u32 fd;
}

fn Handle::drop(ref<Handle, exclusive> self)
{
}

fn main()
{
    Vec<Handle> v = Vec::new();
    Vec::push(&mut v, Handle { .fd = 1 });
    Vec<Handle> c = Vec::clone(&v);
}
