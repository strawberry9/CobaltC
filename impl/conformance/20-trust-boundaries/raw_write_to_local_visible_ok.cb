// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr [Rawptr-Of], [Rawptr-Write], [Rawptr-Read] (a local's own cells)
// kind: positive
// expect: ok
//
// `rawptr_of(&mut x)` is the address of x's own cells (spec/20 §2,
// "the ordinary FFI-buffer pattern"): a raw write there is what x's
// later reads see, and x's later writes are what a raw read sees.
// Previously the pointer addressed a snapshot copy.

fn check(bool ok)
{
    i32 z = if (ok)
    {
        1
    }
    else
    {
        0
    };
    1 / z;
}

struct P
{
    i32 a;
    i32 b;
}

fn main()
{
    i32 x = 7;
    auto p = rawptr_of(&mut x);
    unsafe
    {
        *p = 9;
    }
    check(x == 9);
    x = 11;
    unsafe
    {
        check(*p == 11);
    }
    P s = P { .a = 1, .b = 2 };
    auto q = rawptr_of(&mut s.b);
    unsafe
    {
        *q = 20;
    }
    check(s.b == 20);
    check(s.a == 1);
    unsafe
    {
        auto r = &reclaim<i32>(p);
        check(*r == 11);
    }
}
