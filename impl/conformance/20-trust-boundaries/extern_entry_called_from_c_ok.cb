// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.extern-call [Extern-Entry] (D-0257); conf.extern-entry-called-from-c
// kind: positive
// expect: ok
// cobc-only: links the program's own C code
// expect-stdout-hex: 31300a31302031300a330a310a
//
// In a program with a `main`, an entry point is a C function of its name:
// the program's own C calls `weight`, which nothing in the program calls,
// `swap_pair`, which takes and gives a plain struct, and `bump`, which the
// program calls too.

import std;

extern "./extern_code/entries.c";

unsafe extern fn twice_weight(i64 i) : i64;

unsafe extern fn pair_diff(i32 a, i32 b) : i32;

struct Pair
{
    i32 a;
    i32 b;
}

static Atomic<u32> BUMPS = 0;

extern fn weight(i64 i) : i64
{
    i + 1
}

extern fn swap_pair(Pair p) : Pair
{
    Pair { .a = p.b, .b = p.a }
}

extern fn bump()
{
    _ = Atomic::fetch_add(&BUMPS, 1);
}

fn main()
{
    printf("%v\n", unsafe { twice_weight(4) });
    i64 w = weight(9);
    printf("%v %v\n", w, unsafe { twice_weight(4) });
    printf("%v\n", unsafe { pair_diff(1, 4) });
    printf("%v\n", Atomic::load(&BUMPS));
}
