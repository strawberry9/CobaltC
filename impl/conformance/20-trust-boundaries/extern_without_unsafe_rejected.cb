// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.extern-call [Extern-Decl]; spec/22 §3 extern-decl (D-0146); conf.extern-without-unsafe-rejected
// kind: negative
// expect: diag.syntax-error (static)
//
// A foreign function's signature is an unchecked claim, so its
// declaration is written `unsafe extern fn` (D-0146); without `unsafe` it
// is a syntax error, before anything runs.

import std;

extern fn abs(i32 x) : i32;

fn main()
{
    i32 a = unsafe
    {
        abs(-3)
    };
}
