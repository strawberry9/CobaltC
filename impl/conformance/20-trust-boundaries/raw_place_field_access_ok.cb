// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr (`(*p).f` -- a field of the raw place `*p`, read and written; spec/13 §1)
// kind: positive
// expect: ok

import std;

struct P
{
    i64 x;
    i64 y;
}

fn main()
{
    match (allocate(sizeof<P>(), alignof<P>()))
    {
        Ok(b) :
        {
            rawptr<P> p = reinterpret_ptr<P>(b);
            unsafe
            {
                *p = P { .x = 1, .y = 2 };
                (*p).y = 40;
                if ((*p).x + (*p).y != 41)
                {
                    1 / (1 - 1);
                }
                deallocate(b, sizeof<P>(), alignof<P>());
            }
        },
        Err(_) :
        {
        },
    }
}
