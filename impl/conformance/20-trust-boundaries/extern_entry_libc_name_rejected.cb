// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.extern-call [Extern-Entry] (D-0257); [Item-Duplicate]; conf.extern-entry-libc-name
// kind: negative
// expect: diag.duplicate-item (static)
//
// An entry point is a C symbol in C's one name space: named as a C library
// function (`write`), it would take that function's place for the whole
// program, the runtime's own output included.

import std;

extern fn write(i32 fd, rawptr<u8> buf, usize n) : isize
{
    0
}

fn main()
{
    printf("unreached\n");
}
