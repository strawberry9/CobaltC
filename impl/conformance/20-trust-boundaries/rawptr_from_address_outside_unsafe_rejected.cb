// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr `[Rawptr-From-Address]` (D-0258); [Unsafe-Rejected]; conf.rawptr-from-address-outside-unsafe
// kind: negative
// expect: diag.trusted-outside-unsafe (static)
//
// An address as a pointer is a trusted claim about what lives there, so it
// is written only inside `unsafe`.

import std;

fn main()
{
    rawptr<u32> uart = rawptr_from_address<u32>(0x10000000);
    printf("%v\n", is_null(uart));
}
