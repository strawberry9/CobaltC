// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr [Rawptr-Read]
// kind: positive
// expect: ok
//
// The same raw-pointer dereference, wrapped in `unsafe { }`, is
// accepted -- the caller is trusted to have passed a valid pointer.

fn f(rawptr<i32> p) : i32
{
    unsafe
    {
        *p
    }
}

fn main()
{
    i32 x = 7;
    if (f(rawptr_of(&x)) != 7)
    {
        1 / (1 - 1);
    }
}
