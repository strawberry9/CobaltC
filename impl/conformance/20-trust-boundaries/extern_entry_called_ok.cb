// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.extern-call [Extern-Entry] (D-0257); conf.extern-entry-called
// kind: positive
// expect: ok
// expect-stdout-hex: 32310a330a
//
// `extern fn name(…) : τ { … }` defines a function C calls by that name;
// inside the program it is an ordinary function, called as any other.
// A program with a `main` is a program, whatever entry points it also
// defines.

import std;

struct Pair
{
    i32 a;
    i32 b;
}

extern fn add_pair(Pair p) : i32
{
    p.a + p.b
}

extern fn thrice(u8 n) : u8
{
    n * 3
}

fn main()
{
    printf("%v\n", add_pair(Pair { .a = 20, .b = 1 }));
    printf("%v\n", thrice(1));
}
