// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.extern-code; rule.trust.extern-call [Extern-Call] (D-0258); conf.extern-code-asm-file
// kind: positive
// expect: ok
// cobc-only: links the program's own assembly code
// expect-stdout-hex: 32330a370a
//
// `extern "./extern_code/addmul.S";` names an assembly file to link,
// relative to this file, as a `.c` file is named; `cobc` assembles it with
// the C compiler. A `.S` file is preprocessed, so it picks the platform's
// calling convention itself. Its functions are ordinary `[Extern-Call]`s.

import std;

extern "./extern_code/addmul.S";

unsafe extern fn addmul(u64 a, u64 b, u64 c) : u64;
unsafe extern fn seven() : i32;

fn main()
{
    u64 r = unsafe { addmul(4, 5, 3) };
    printf("%v\n", r);
    printf("%v\n", unsafe { seven() });
}
