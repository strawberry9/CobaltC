// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: `[Rawptr-Read-Volatile]` takes a plain `T` (D-0121); conf.volatile-resource-rejected
// kind: negative
// expect: diag.type-mismatch (static)

import std;

fn main()
{
    String s = String::new();
    unsafe
    {
        rawptr<String> p = rawptr_of(&mut s);
        String t = read_volatile(p);
    }
}
