// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr [Rawptr-Write] (CHG-0031) + inv.alias-validity; conf.vec-holds-exclusive-ref-conflict
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// While the Vec holds `&mut x`, writing `x` directly conflicts with it.

import std;

fn main()
{
    i32 x = 1;
    Vec<ref<i32, exclusive>> v = Vec::new();
    Vec::push(&mut v, &mut x);
    x = 5;
}
