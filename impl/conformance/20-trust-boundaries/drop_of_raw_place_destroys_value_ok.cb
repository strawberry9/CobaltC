// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr [Rawptr-Move-Out] then rule.resauth.destroy (drop(*p) of raw storage)
// kind: positive
// expect: ok
//
// The resource moves out of the raw cells and is destroyed at once: its
// destructor prints before the next statement.

import std;

resource struct Noisy
{
    i32 n;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("dropped\n");
}

fn main()
{
    auto buf = allocate(sizeof<Noisy>(), alignof<Noisy>());
    match (buf)
    {
        Ok(raw) :
        {
            rawptr<Noisy> p = reinterpret_ptr<Noisy>(raw);
            unsafe
            {
                *p = Noisy { .n = 1 };
                drop(*p);
                printf("after drop\n");
                deallocate(raw, sizeof<Noisy>(), alignof<Noisy>());
            }
        },
        Err(_) :
        {
        },
    }
}
