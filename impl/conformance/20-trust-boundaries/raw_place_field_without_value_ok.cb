// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr (`(*p).f` on a struct the program never makes a value of: the raw place `*p` is the whole struct, its fields read and written through it; spec/13 §1); conf.raw-place-field-without-value
// kind: positive
// expect: ok

import std;

struct P
{
    i64 x;
    i64 y;
}

fn main()
{
    match (allocate(sizeof<P>(), alignof<P>()))
    {
        Ok(b)  :
        {
            rawptr<P> p = reinterpret_ptr<P>(b);
            unsafe
            {
                (*p).x = 1;
                (*p).y = 40;
                if ((*p).x + (*p).y != 41)
                {
                    1 / (1 - 1);
                }
                deallocate(b, sizeof<P>(), alignof<P>());
            }
        },
        Err(_) :
        {
        },
    }
}
