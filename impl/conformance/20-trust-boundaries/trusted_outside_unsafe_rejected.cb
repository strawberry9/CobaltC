// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.unsafe [Unsafe-Rejected]
// kind: negative
// expect: diag.trusted-outside-unsafe (static)
//
// Dereferencing a raw pointer lexically outside any `unsafe { }` block
// is rejected before the program runs.

fn f(rawptr<i32> p) : i32
{
    *p
}

fn main()
{
    i32 x = 7;
    f(rawptr_of(&x));
}
