// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.extern-call [Extern-Call-Variadic-Arg]; conf.extern-variadic-arg
// kind: negative
// expect: diag.extern-non-ffi-type (static)
//
// An argument after a variadic C function's fixed parameters is of an
// extern's types, as a parameter is (report 228): a reference to a
// `String` is refused (C is given a raw pointer, such as `str_ptr` of a
// literal).

import std;

unsafe extern fn snprintf(rawptr<u8> buf, usize n, rawptr<u8> fmt, ...) : i32;

fn main()
{
    rawptr<u8> buf = Result::expect(allocate(16, 1), "allocate");
    String s = "text";
    unsafe
    {
        snprintf(buf, 16, str_ptr("%s"), &s);
    }
}
