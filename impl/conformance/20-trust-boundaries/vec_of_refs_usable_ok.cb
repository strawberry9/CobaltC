// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr [Rawptr-Write] (a reference-bearing element is held by its cells' object, CHG-0031); conf.vec-of-refs-usable
// kind: positive
// expect: ok
//
// References stored in Vec elements stay valid after the pushing
// statement, whether the element is a reference or a struct holding one.

import std;

struct Pair
{
    ref<i32, shared> r;
    i32 k;
}

fn main()
{
    i32 a = 10;
    i32 b = 20;
    Vec<ref<i32, shared>> v = Vec::new();
    Vec::push(&mut v, &a);
    Vec::push(&mut v, &b);
    i32 sum = **Vec::index_shared(&v, 0) + **Vec::index_shared(&v, 1);
    Vec<Pair> w = Vec::new();
    Vec::push(&mut w, Pair { .r = &b, .k = 1 });
    i32 t = *Vec::index_shared(&w, 0).r;          // a field of a reference returned by a call
    if (sum != 30 || t != 20)
    {
        1 / (1 - 1);
    }
}
