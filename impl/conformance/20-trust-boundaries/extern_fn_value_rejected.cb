// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.extern-call [Extern-Call]; rule.trust.unsafe [Unsafe-Rejected] (D-0252); conf.extern-fn-value
// kind: negative
// expect: diag.trusted-outside-unsafe (static)
//
// An `extern fn` is called inside `unsafe` and is never a `fn` value, whose
// call would need no `unsafe`. Before D-0252 this was accepted, then
// failed when it ran.

import std;

unsafe extern fn abs(i32 x) : i32;

fn apply(fn(i32) : i32 f, i32 x) : i32
{
    f(x)
}

fn use_it() : i32
{
    apply(abs, -3)
}

fn main()
{
}
