// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.extern-call [Extern-Non-Ffi-Type] (ffi-struct, D-0252); conf.extern-struct-enum-field
// kind: negative
// expect: diag.extern-non-ffi-type (static)
//
// An enum field does not cross: its discriminant width is the
// implementation's, and a payload has no C counterpart. A C enum is an
// integer type on this side.

import std;

enum Shape
{
    Circle,
    Square,
}

struct Tagged
{
    i32 size;
    Shape shape;
}

unsafe extern fn make_tagged() : Tagged;

fn main()
{
}
