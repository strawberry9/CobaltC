// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.extern-call [Extern-Call] (real calls into libc and libm with scalar FfiTypes)
// kind: positive
// expect: ok
//
// Symbol resolution and calling convention are implementation-defined
// (spec/20 §3); both implementations resolve the declared name in libc,
// then libm, on x86-64 Linux. Integer, bool, f32 and f64 arguments and
// results cross the boundary in both directions.

extern fn labs(i64 x) : i64;
extern fn abs(i32 x) : i32;
extern fn sqrt(f64 x) : f64;
extern fn pow(f64 x, f64 y) : f64;
extern fn hypotf(f32 x, f32 y) : f32;
extern fn toupper(i32 c) : i32;
extern fn isalpha(i32 c) : i32;
extern fn fma(f64 a, f64 b, f64 c) : f64;

fn check(bool ok)
{
    i32 z = 0;
    if (!ok)
    {
        z = 1 / z;
    }
}

fn main()
{
    unsafe
    {
        check(labs(-5) == 5);
        check(abs(-2147483647) == 2147483647);
        check(sqrt(16.0) == 4.0);
        check(pow(2.0, 10.0) == 1024.0);
        check(hypotf(3.0: f32, 4.0: f32) == 5.0);
        check(toupper(97) == 65);
        check(isalpha(49) == 0 && isalpha(66) != 0);
        check(fma(2.0, 3.0, 1.0) == 7.0);
    }
}
