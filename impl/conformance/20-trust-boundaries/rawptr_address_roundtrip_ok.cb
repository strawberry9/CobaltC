// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr `[Rawptr-Address]`, `[Rawptr-From-Address]`, `[Rawptr-Offset]` (D-0258); conf.rawptr-address-roundtrip
// kind: positive
// expect: ok
// expect-stdout-hex: 33300a747275650a
//
// A place's address becomes a `usize`, is moved on by one element's size as
// an integer, becomes a pointer again and is read: the second element. The
// address of the pointer made from it is the integer it was made from. Both
// are trusted (inside `unsafe`): the program vouches for what lives there.

import std;

fn main()
{
    array<u32, 3> cells = [10, 30, 50];
    u32 second = 0;
    bool same = false;
    unsafe
    {
        usize a = rawptr_address(rawptr_of(&cells[0]));
        rawptr<u32> p = rawptr_from_address<u32>(a + sizeof<u32>());
        second = *p;
        same = rawptr_address(p) == a + 4 && rawptr_address(p + 1) == a + 8;
    }
    printf("%v\n%v\n", second, same);
}
