// CONFORMANCE-FIXTURE
// A module of extern_code_c_file_ok.cb. Its `extern "./shapes.c";` is
// resolved against this file's directory, extern_code/, and names the
// same file the case declares, so it is linked once.

import std;

extern "./shapes.c";

extern fn area(i32 w, i32 h) : i32;

export fn rect(u8 w, u8 h) : i32
{
    unsafe { area(widen<i32>(w), widen<i32>(h)) }
}
