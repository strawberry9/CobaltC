// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.extern-call [Extern-Call-Variadic]; rule.trust.extern-code; conf.extern-variadic-own-c
// kind: positive
// expect: ok
// cobc-only: links the program's own C code
// expect-stdout-hex: 322e3020312e373520302e300a332e300a
//
// A variadic function of the program's own C code is declared with `...`
// as one of the C library is, and called directly (report 228): the
// `double`s it reads with `va_arg` arrive intact, an `f32` promoted, and
// a plain struct passes by value as C passes one.

import std;

extern "./extern_code/varsum.c";

struct Pair
{
    i32 weight;
    f64 value;
}

unsafe extern fn weighted_sum(i32 count, ...) : f64;
unsafe extern fn pair_sum(i32 count, ...) : f64;

fn main()
{
    f32 quarter = 0.25;
    f64 a = unsafe { weighted_sum(2, 3, 0.5, 4, 0.125) };
    f64 b = unsafe { weighted_sum(1, 7, quarter) };
    f64 none = unsafe { weighted_sum(0) };
    printf("%v %v %v\n", a, b, none);
    Pair p = Pair { .weight = 3, .value = 1.5 };
    Pair q = Pair { .weight = -2, .value = 0.75 };
    printf("%v\n", unsafe { pair_sum(2, p, q) });
}
