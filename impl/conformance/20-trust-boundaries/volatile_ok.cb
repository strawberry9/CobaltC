// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr `[Rawptr-Read-Volatile]`, `[Rawptr-Write-Volatile]` (D-0121); conf.volatile-read-write
// kind: positive
// expect: ok
//
// A volatile write is seen by a volatile read and by the variable; a
// volatile read sees a plain write. (That the accesses are not merged
// or elided is a property of the compiled code, not observable here.)

import std;

fn main()
{
    u32 cell = 5;
    unsafe
    {
        rawptr<u32> p = rawptr_of(&mut cell);
        write_volatile(p, 77);
        u32 seen = read_volatile(p);
        write_volatile(p, seen + 1);
        assert(seen == 77 && read_volatile(p) == 78);
        *p = 100;
        assert(read_volatile(p) == 100);
    }
    assert(cell == 100);
    printf("ok\n");
}
