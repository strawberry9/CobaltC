// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr [Release] (ends the element's object and its hold, CHG-0031); conf.vec-pop-releases-ref
// kind: positive
// expect: ok
//
// Writing through the stored reference works; once `pop` releases the
// slot, the Vec holds nothing and `x` may be written directly.

import std;

fn main()
{
    i32 x = 1;
    Vec<ref<i32, exclusive>> v = Vec::new();
    Vec::push(&mut v, &mut x);
    **Vec::index_exclusive(&mut v, 0) = 7;
    Vec::pop(&mut v);
    if (x != 7)
    {
        1 / (1 - 1);
    }
    x = 5;
}
