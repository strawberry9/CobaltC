// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr [Reclaim]
// kind: positive
// expect: ok
//
// Reclaiming the same address twice re-attaches the same object
// identity: two reclaimed places at one address correctly alias each
// other, they are not treated as two independent objects.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 7);
    auto p = rawptr_of(Vec::index_shared(&v, 0));
    unsafe
    {
        auto r1 = &reclaim<i32>(p);
        if (*r1 != 7)
        {
            1 / (1 - 1);
        }
    }
}
