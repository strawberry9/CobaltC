// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.extern-call [Extern-Non-Ffi-Type] (ffi-struct, D-0252); conf.extern-struct-resource
// kind: negative
// expect: diag.extern-non-ffi-type (static)
//
// A struct that holds a `String` is a resource: C could copy it but not
// own it. The message names the field path, `inner.name`.

import std;

struct Inner
{
    i32 id;
    String name;
}

struct Outer
{
    i64 total;
    Inner inner;
}

unsafe extern fn summarize(Outer o) : i64;

fn main()
{
}
