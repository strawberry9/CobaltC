// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.extern-call [Extern-Call] (ffi-struct, D-0252); rule.agg.layout [Layout-Struct]; conf.extern-struct-by-value
// kind: positive
// expect: ok
// cobc-only: passes structs by value to the program's own C code
// expect-stdout-hex: 706f696e742031312032320a6d69786564203820332e303030303030202d3620302e3530303030300a6172726179203130360a626967203434203231300a616c69676e65642034320a6e657374656420332034203120320a646976203320320a
//
// A plain struct of FfiTypes crosses an `extern` by value, as an argument
// and as a result: two `i32`s, mixed widths with padding, an array field,
// one too large for registers, an `align(16)` struct, a generic instance
// holding structs, and libc's own `div_t`. The C side declares the same
// members in the same order (D-0250), and the C compiler applies the
// platform's calling rules.

import std;

extern "./extern_code/structs.c";

struct Point
{
    i32 x;
    i32 y;
}

struct Mixed
{
    u8 tag;
    f64 weight;
    i16 small;
    f32 f;
}

struct WithArray
{
    u16 n;
    array<i32, 3> vals;
}

struct Big
{
    i64 a;
    i64 b;
    i64 c;
    i64 d;
    i64 e;
}

struct Aligned align(16)
{
    i32 v;
}

struct Pair<T>
{
    T first;
    T second;
}

struct DivT
{
    i32 quot;
    i32 rem;
}

unsafe extern fn point_add(Point a, Point b) : Point;
unsafe extern fn mixed_twice(Mixed m) : Mixed;
unsafe extern fn array_sum(WithArray w) : i32;
unsafe extern fn big_make(i64 base) : Big;
unsafe extern fn big_sum(Big b) : i64;
unsafe extern fn aligned_inc(Aligned a) : Aligned;
unsafe extern fn nested_swap(Pair<Point> n) : Pair<Point>;
unsafe extern fn div(i32 n, i32 d) : DivT;

fn main()
{
    Point p = unsafe
    {
        point_add(Point { .x = 1, .y = 2 }, Point { .x = 10, .y = 20 })
    };
    printf("point %d %d\n", p.x, p.y);
    Mixed m = unsafe
    {
        mixed_twice(Mixed { .tag = 7, .weight = 1.5, .small = -3, .f = 0.25 })
    };
    printf("mixed %d %f %d %f\n", m.tag, m.weight, m.small, m.f);
    i32 s = unsafe
    {
        array_sum(WithArray { .n = 100, .vals = [1, 2, 3] })
    };
    printf("array %d\n", s);
    Big b = unsafe
    {
        big_make(40)
    };
    i64 t = unsafe
    {
        big_sum(b)
    };
    printf("big %d %d\n", b.e, t);
    Aligned a = unsafe
    {
        aligned_inc(Aligned { .v = 41 })
    };
    printf("aligned %d\n", a.v);
    Pair<Point> n = unsafe
    {
        nested_swap(Pair { .first = Point { .x = 1, .y = 2 }, .second = Point { .x = 3, .y = 4 } })
    };
    printf("nested %d %d %d %d\n", n.first.x, n.first.y, n.second.x, n.second.y);
    DivT d = unsafe
    {
        div(17, 5)
    };
    printf("div %d %d\n", d.quot, d.rem);
}
