// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.extern-code; conf.extern-code-library-name
// kind: positive
// expect: ok
//
// `extern "m";` names a library by name; it declares nothing, so a
// program's names are unchanged. An implementation that links foreign
// code links libm; one that does not accepts the declaration, and
// `sqrt` is found either way.

extern "m";

extern fn sqrt(f64 x) : f64;

fn main()
{
    if (unsafe { sqrt(16.0) } != 4.0)
    {
        1 / (1 - 1);
    }
}
