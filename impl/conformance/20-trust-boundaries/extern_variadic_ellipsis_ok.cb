// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.extern-call [Extern-Call-Variadic]; conf.extern-variadic-ellipsis
// kind: positive
// expect: ok
// expect-stdout-hex: 3130206974656d732c206176657261676520302e31323520283233290a6d6978656420312e3530202d332031203530303030303030303020322e350a6669786564206f6e6c790a
//
// A C function with a variable argument list is declared as C declares
// it, with `...` after its fixed parameters (report 228). Each call passes
// the fixed arguments and then scalars of their own types: a `double`
// arrives intact (on x86-64 it travels in a vector register, and the
// callee is told how many), an `f32` is promoted to `double`, an `i8` and
// a `bool` to `int`, and a pointer and an `i64` as themselves. Three calls
// pass different lists through the one declaration.

import std;

unsafe extern fn snprintf(rawptr<u8> buf, usize n, rawptr<u8> fmt, ...) : i32;

fn main()
{
    rawptr<u8> buf = Result::expect(allocate(128, 1), "allocate");
    i32 count = 10;
    f64 avg = 0.125;
    i32 w = unsafe { snprintf(buf, 128, str_ptr("%d items, average %.3f"), count, avg) };
    printf("%s (%v)\n", &Result::expect(unsafe { String::from_c(buf) }, "utf8"), w);
    f32 h = 1.5;
    i8 small = -3;
    i64 big = 5000000000;
    unsafe
    {
        snprintf(buf, 128, str_ptr("%s %.2f %d %d %lld %.1f"), str_ptr("mixed"), h, small, true, big, 2.5);
    }
    printf("%s\n", &Result::expect(unsafe { String::from_c(buf) }, "utf8"));
    unsafe
    {
        snprintf(buf, 128, str_ptr("fixed only"));
    }
    printf("%s\n", &Result::expect(unsafe { String::from_c(buf) }, "utf8"));
    unsafe
    {
        deallocate(buf, 128, 1);
    }
}
