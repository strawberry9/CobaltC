// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: `[Release]` called with one argument of its two (CHG-0275); conf.raw-intrinsic-wrong-arity-rejected
// kind: negative
// expect: diag.type-mismatch (static)

import std;

fn main()
{
    i32 x = 7;
    auto p = rawptr_of(&x);
    unsafe
    {
        release(p);
    }
}
