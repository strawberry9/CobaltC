// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.extern-call [Extern-Entry] (D-0257); [Item-Duplicate]; conf.extern-entry-duplicate
// kind: negative
// expect: diag.duplicate-item (static)
//
// Two modules may declare functions of one name, but C has one name
// space: two functions C calls cannot share a name.

import std;

module m
{
    export extern fn same(u32 a) : u32
    {
        a
    }
}

extern fn same(u32 a) : u32
{
    a + 1
}

fn main()
{
}
