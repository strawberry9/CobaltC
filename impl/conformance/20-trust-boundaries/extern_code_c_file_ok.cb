// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.extern-code; rule.trust.extern-call [Extern-Call]; conf.extern-code-c-file
// kind: positive
// expect: ok
// cobc-only: links the program's own C code
// expect-stdout-hex: 34320a302031203420390a
//
// `extern "./extern_code/shapes.c";` names C code to link, relative to
// this file; the module in extern_code/shapes.cb names the same file
// relative to its own. A C function fills storage from `allocate` (an
// extern may write only outside live objects); its count is a claim,
// checked before it is used.

import std;

module shapes "./extern_code/shapes.cb";

extern "./extern_code/shapes.c";

extern fn squares(rawptr<i64> out, i64 n) : i64;

fn main()
{
    printf("%v", shapes::rect(6, 7));
    printf("\n");
    rawptr<u8> raw = match (allocate(4 * sizeof<i64>(), alignof<i64>()))
    {
        Ok(p) : p,
        Err(_) :
        {
            return;
        },
    };
    rawptr<i64> buf = reinterpret_ptr<i64>(raw);
    i64 n = unsafe { squares(buf, 4) };
    if (n < 0 || n > 4)
    {
        1 / (1 - 1);
    }
    usize count = narrow<usize>(n);                 // checked: a negative count faults
    usize i = 0;
    while (i < count)
    {
        if (i > 0)
        {
            printf(" ");
        }
        printf("%v", unsafe { *(buf + reinterpret<isize>(i)) });
        i = i + 1;
    }
    printf("\n");
    unsafe
    {
        deallocate(raw, 4 * sizeof<i64>(), alignof<i64>());
    }
}
