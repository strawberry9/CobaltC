// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr [Rawptr-Move-In] / [Rawptr-Move-Out] (a resource holding a reference, through raw storage)
// kind: positive
// expect: ok
//
// The reference inside the resource moves with it into raw cells and back
// out; the destructor, run by `drop(*p)`, writes through it.

import std;

resource struct Flagger
{
    ref<i32, exclusive> flag;
}

fn Flagger::drop(ref<Flagger, exclusive> self)
{
    *self.flag = *self.flag + 1;
}

fn main()
{
    i32 dropped = 0;
    auto buf = allocate(sizeof<Flagger>(), alignof<Flagger>());
    match (buf)
    {
        Ok(raw) :
        {
            rawptr<Flagger> p = reinterpret_ptr<Flagger>(raw);
            unsafe
            {
                *p = Flagger { .flag = &mut dropped };
                drop(*p);
                deallocate(raw, sizeof<Flagger>(), alignof<Flagger>());
            }
        },
        Err(_) :
        {
        },
    }
    if (dropped != 1)
    {
        1 / (1 - 1);
    }
}
