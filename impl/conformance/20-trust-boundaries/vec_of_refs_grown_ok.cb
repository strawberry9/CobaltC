// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr [Copy-Raw] (a copied reference keeps a holder, D-0219, CHG-0258); [Release]; conf.vec-of-refs-grown
// kind: positive
// expect: ok
//
// A vector of exclusive references grows past its first buffer: `grow`
// copies the cells with `copy_raw` and deallocates the old buffer, which
// ends the element objects over it. Each reference was held by one of
// them; the copy into the new buffer is held by an element object over
// its new cells, so every reference stays valid and is written through.

import std;

fn main() : u8
{
    i32 a = 1;
    i32 b = 2;
    i32 c = 3;
    i32 d = 4;
    i32 e = 5;
    {
        Vec<ref<i32, exclusive>> w = Vec::new();
        Vec::push(&mut w, &mut a);
        Vec::push(&mut w, &mut b);
        Vec::push(&mut w, &mut c);
        Vec::push(&mut w, &mut d);
        Vec::push(&mut w, &mut e);
        *w[0] = *w[0] + 10;
        *w[4] = *w[4] + 10;
    }
    if (a != 11 || e != 15 || b + c + d != 9)
    {
        return 1;
    }
    0
}
