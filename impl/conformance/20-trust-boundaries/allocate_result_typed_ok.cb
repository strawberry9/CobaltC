// CONFORMANCE-CASE
// spec: 20-trust-boundaries
// facility: rule.trust.rawptr `[Allocate]`, `[T-Rawptr-Offset]` (CHG-0321); conf.allocate-result-typed
// kind: positive
// expect: ok
// expect-stdout-hex: 323620370a
//
// `allocate` gives a `Result<rawptr<u8>, AllocError>`, so the pointer a
// `match` binds from it is a `rawptr<u8>` before anything else is known about
// it: `p + i` is a pointer, written and read through, and `Vec::from_raw`
// reads the bytes back. (Both tools typed the binding by its first use and
// took `p + i` for an `isize`.)

import std;

fn main()
{
    match (allocate(4, 1))
    {
        Ok(p)  :
        {
            unsafe
            {
                for (isize i = 0; i < 4; i += 1)
                {
                    *(p + i) = narrow<u8>(5 + i);
                }
                rawptr<u8> q = p + 2;
                u8 third = *q;
                Vec<u8> back = Vec::from_raw(p, 4);
                u32 sum = 0;
                foreach (b in &back)
                {
                    sum += widen<u32>(*b);
                }
                printf("%v %v\n", sum, third);
                deallocate(p, 4, 1);
            }
        },
        Err(_) : printf("no memory\n"),
    }
}
