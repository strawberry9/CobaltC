// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const; an array length that depends on the size of the type holding it is rejected; conf.const-array-length-self-size-rejected
// kind: negative
// expect: diag.syntax-error (static)
//
// `Grow`'s array is as long as `Grow` is large, which is one byte more than
// the array: no length settles it, and the length is reported where it is
// read (bug 013).

import std;

struct Grow
{
    u8 tag;
    array<u8, sizeof<Option<Grow>>()> rest;
}

fn main()
{
    printf("%v\n", sizeof<Grow>());
}
