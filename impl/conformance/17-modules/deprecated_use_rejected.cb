// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.retired [Use-Deprecated] (D-0303); conf.deprecated-use-rejected
// kind: negative
// expect: diag.deprecated-use (static)
//
// A call of a function marked `[[deprecated("…")]]` is an error by default,
// with the attribute's message.

import std;

[[deprecated("call total instead")]]
fn sum(i32 a, i32 b) : i32
{
    a + b
}

fn total(i32 a, i32 b) : i32
{
    a + b
}

fn main()
{
    printf("%d\n", sum(1, 2) + total(3, 4));
}
