// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.use (re-export of one item, D-0136); [Resolve-Unbound]; conf.reexport-item-only
// kind: negative
// expect: diag.unbound-name (static)
//
// A re-export of one item passes on that item only: `b::eight` names
// nothing, though `a` exports `eight`.

module a
{
    export fn seven() : i32
    {
        7
    }

    export fn eight() : i32
    {
        8
    }
}

module b
{
    export import a::seven;
}

fn main()
{
    i32 x = b::eight();
}
