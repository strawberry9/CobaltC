// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.local-type; D-0069; conf.local-type-type-parameter
// kind: negative
// expect: diag.unbound-name (static)
//
// A local type has one definition, so it cannot use the enclosing
// function's type parameter.

import std;

fn wrap<T>(T x) : usize
{
    struct Holder
    {
        T inner;
    }
    1
}

fn main()
{
    printf("%v\n", wrap(1));
}
