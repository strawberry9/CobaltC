// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.visibility [Field-Not-Visible] (std)
// kind: negative
// expect: diag.name-not-visible (static)
//
// conf.std-private-field-rejected (CHG-0033): `Vec`'s fields are private
// to `std`. Before `std` was its own module, this program forged `len` in
// safe code and `Vec::index_shared` read past the buffer.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    v.len = 100000;
    i32 x = *Vec::index_shared(&v, 99999);
}
