// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.use (re-export of one item, D-0136); conf.reexport-item
// kind: positive
// expect: ok
// expect-stdout-hex: 370a
//
// `export import a::seven;` names one item: `b::seven` is `a::seven`, and
// only that item of `a` passes through `b`.

import std;

module a
{
    export fn seven() : i32
    {
        7
    }

    export fn eight() : i32
    {
        8
    }
}

module b
{
    export import a::seven;
}

fn main()
{
    printf("%v\n", b::seven());
}
