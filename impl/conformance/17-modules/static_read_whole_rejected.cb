// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.static [Static-Use] (D-0258); conf.static-read-whole
// kind: negative
// expect: diag.read-of-resource (static)
//
// A static is never read or moved whole: an atomic is a resource, and the
// static is the program's one object of it.

import std;

static Atomic<u64> COUNT = 0;

fn main()
{
    Atomic<u64> c = COUNT;
}
