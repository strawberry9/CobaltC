// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Resolve-Unqualified]; diag.type-mismatch; conf.shadowed-std-type-named
// kind: negative
// expect: diag.type-mismatch (static)
//
// A program's own `struct Vec` hides `std::Vec` (`[Resolve-Unqualified]`
// clause 1: the module's own item first). `Vec<i64> w = Vec::new();` then
// declares `w` as the program's `Vec` (which takes no type arguments) and
// initialises it with `std`'s: a type mismatch, whose message names the
// two types apart (`Vec<i64>` against `std::Vec<i64>`, CHG-0333) instead
// of showing one spelling twice.
import std;

struct Vec
{
    i64 x;
}

fn main() : u8
{
    Vec v = Vec { .x = 3: i64 };
    Vec<i64> w = Vec::new();
    printf("%v\n", v.x);
    0
}
