// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.use (imports are per module)
// kind: negative
// expect: diag.unbound-name (static)
//
// conf.std-import-per-module (CHG-0033): an `import` acts in the module
// that declares it; `m` does not see the root's `import std;`.

import std;

module m
{
    export fn f()
    {
        printf("inside m\n");
    }
}

fn main()
{
    m::f();
}
