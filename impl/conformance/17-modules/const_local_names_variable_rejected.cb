// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const [Const-Local-Not-Constant]; D-0066; conf.const-local-names-variable
// kind: negative
// expect: diag.const-not-constant (static)
//
// A local variable is not a constant, even one initialized by a
// constant expression: a local constant's initializer cannot name it.

import std;

fn main()
{
    u8 b = 200;
    const u8 D = b + 1;
    printf("%v\n", D);
}
