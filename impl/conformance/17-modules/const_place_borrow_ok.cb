// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const [Ref-Form-Const-Place] (D-0314); conf.const-place-borrow
// kind: positive
// expect: ok
// expect-stdout-hex: 32203639203320322036392037302037203220310a
//
// A borrow of a place rooted at a constant written as a literal is a borrow
// from its one object: `&K[lo..hi]` held, stored in a field and returned
// through a parameter's source; `&K[i]`, `&K.f`, `&K.f[lo..hi]` and
// `&K.f[i]`.

import std;

const array<u8, 4> MAGIC = b"\x7fELF";

struct Pt
{
    i32 x;
    array<u8, 3> tag;
}

const Pt ORIGIN = Pt { .x = 7, .tag = [1, 2, 3] };

struct Hdr
{
    slice<u8, shared> magic;
}

fn pick(slice<u8, shared> d, bool own) : slice<u8, shared>
{
    if (own) { d } else { &MAGIC[1..$] }
}

fn main()
{
    slice<u8, shared> s = &MAGIC[0..2];
    array<u8, 2> loc = [9: u8, 8];
    Hdr h = Hdr { .magic = &MAGIC[0..$] };
    ref<u8, shared> e = &MAGIC[3];
    ref<i32, shared> x = &ORIGIN.x;
    slice<u8, shared> t = &ORIGIN.tag[1..$];
    ref<u8, shared> t0 = &ORIGIN.tag[0];
    printf("%v %v %v %v %v %v %v %v %v\n", slice_len(s), s[1], slice_len(pick(&loc, false)), slice_len(pick(&loc, true)), h.magic[1], *e, *x, slice_len(t), *t0);
}
