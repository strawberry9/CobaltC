// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.visibility (export)
// kind: positive
// expect: ok
//
// An `export` item declared in one module is visible from another.

module inner
{
    export fn helper() : i32
    {
        42
    }
}

fn main()
{
    if (inner::helper() != 42)
    {
        1 / (1 - 1);
    }
}
