// CONFORMANCE-CASE
// spec: 17-modules
// facility: D-0105; conf.array-length-qualified-private-rejected
// kind: negative
// expect: diag.syntax-error (static)
//
// A module's constant that is not exported cannot be an array length
// outside its module.

import std;

module geom
{
    const usize SECRET = 7;
}

fn main()
{
    array<i32, geom::SECRET> a = [0; 7];
}
