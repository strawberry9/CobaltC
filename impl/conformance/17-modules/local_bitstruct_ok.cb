// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.local-type [Local-Type] with a bitstruct; D-0132, D-0118; conf.local-bitstruct
// kind: positive
// expect: ok
// expect-stdout-hex: 322031203235380a31203135203234310a34393434332036353532300a
//
// A `bitstruct` declared in a function is a local type: `Name::bits` and
// `Name::from_bits` are derived for it, its fields read and write as at
// item level, a function of it may be declared beside it, and an inner
// block may declare another of the same name.

import std;

fn decode(u16 raw) : u16
{
    bitstruct Header : u16
    {
        kind  : 4;
        len   : 10;
        flags : 2;
    }

    fn Header::is_long(Header h) : bool
    {
        h.len > 100
    }

    Header h = Header::from_bits(raw);
    assert(widen<u16>(h.kind) == (raw & 15));
    h.flags = 3;
    if (Header::is_long(h))
    {
        h.kind = 0;
    }
    Header::bits(h)
}

fn main()
{
    bitstruct Pair : u8
    {
        lo : 4;
        hi : 4;
    }

    Pair p = Pair { .lo = 1, .hi = 2 };
    p.hi = 15;
    {
        bitstruct Pair : u16
        {
            a : 8;
            b : 8;
        }

        Pair q = Pair::from_bits(258);
        printf("%v %v %v\n", q.a, q.b, Pair::bits(q));
    }
    printf("%v %v %v\n", p.lo, p.hi, Pair::bits(p));
    printf("%v %v\n", decode(0x0123), decode(0xFFFF));
}
