// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const [Const-Local]; D-0066; conf.const-local
// kind: positive
// expect: ok
// expect-stdout-hex: 323031203230312031350a
//
// A local constant is a constant expression (`static_assert` uses it),
// scoped like a local: it shadows an outer constant in an inner block,
// is shadowed by a variable of the same name in an inner block (in its
// own block that would be diag.duplicate-local, D-0131), needs no capture in
// a closure, and is a pattern in a `match`. Local constants may be
// declared in any function and in a loop's body.

import std;

fn scale(u64 n) : u64
{
    const u64 FACTOR = 3;
    n * FACTOR
}

fn classify(u8 c) : u32
{
    const u8 SPACE = 32;
    match (c)
    {
        SPACE : 0,
        _     : 1,
    }
}

fn main()
{
    const u8 B = 200;
    const u8 D = B + 1;
    static_assert(D == 201);
    u8 x = D;
    {
        const u8 B = 7;
        static_assert(B == 7);
        u8 y = B + x;
        assert(y == 208);
    }
    static_assert(B == 200);
    {
        i32 B = -1;
        assert(B < 0);
    }
    auto f = move [](u8 k)
    {
        k + D
    };
    assert(f(1) == 202);
    u32 total = 0;
    u32 i = 0;
    while (i < 3)
    {
        const u32 STEP = 5;
        total = total + STEP;
        i = i + 1;
    }
    assert(total == 15);
    assert(scale(5) == 15 && classify(32) == 0 && classify(65) == 1);
    printf("%v %v %v\n", D, x, total);
}
