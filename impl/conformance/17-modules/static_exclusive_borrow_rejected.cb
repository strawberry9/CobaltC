// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.static [Ref-Form-Static] (D-0258); conf.static-exclusive-borrow
// kind: negative
// expect: diag.write-through-shared (static)
//
// A static is every thread's: it is borrowed shared only, and changed
// through its atomic operations.

import std;

static Atomic<u64> COUNT = 0;

fn main()
{
    ref<Atomic<u64>, exclusive> r = &mut COUNT;
}
