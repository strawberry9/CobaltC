// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.retired [Use-Deprecated] (D-0303): an item of a deprecated module; conf.deprecated-module
// kind: negative
// expect: diag.deprecated-use (static)
//
// A deprecated module's standing is every item's it declares: `m::f()` is
// a use of `m`. Inside `m`, `g` calls `f` freely.

import std;

[[deprecated("use the module n")]]
module m
{
    export fn f() : i32
    {
        g()
    }

    fn g() : i32
    {
        1
    }
}

fn main()
{
    printf("%d\n", m::f());
}
