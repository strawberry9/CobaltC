// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.use (re-export, D-0136); rule.module.resolve [Resolve-Qualified]; conf.reexport-module
// kind: positive
// expect: ok
// expect-stdout-hex: 3320372034203520330a
//
// `export import lib::shapes;` passes on every exported item of
// `lib::shapes` as `lib`'s own: after `import lib;` they resolve
// unqualified, a struct with its associated function, an enum with its
// variants, and `lib::Square` is `lib::shapes::Square`, one type.

import std;

module lib
{
    export module shapes
    {
        export struct Square
        {
            export i32 side;
        }

        export fn Square::new(i32 side) : Square
        {
            Square { .side = side }
        }

        export enum Turn
        {
            Left,
            Right,
        }

        export fn area(ref<Square, shared> s) : i32
        {
            s.side * s.side
        }
    }

    export import lib::shapes;

    export fn twice(i32 x) : i32
    {
        x * 2 + 1
    }
}

import lib;

fn turns(Turn t) : i32
{
    match (t)
    {
        Left  : 4,
        Right : 5,
    }
}

fn main()
{
    Square a = Square::new(3);
    lib::shapes::Square b = lib::Square { .side = 2 };
    printf("%v %v %v %v %v\n", a.side, twice(3), area(&b), turns(Right), lib::shapes::Square::new(3).side);
}
