// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const; an array length cannot use a type parameter; conf.const-array-length-type-param-rejected
// kind: negative
// expect: diag.syntax-error (static)
//
// A length is one constant for every instance of a generic, so
// `sizeof<T>()` of the struct's own type parameter is not a length, though
// the size of any laid-out type is (bug 013).

import std;

struct Cell<T>
{
    array<u8, sizeof<T>()> bytes;
}

fn main()
{
    Cell<u32> c = Cell { .bytes = [0; 4] };
    printf("%v\n", slice_len(&c.bytes));
}
