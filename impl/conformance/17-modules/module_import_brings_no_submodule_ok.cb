// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Resolve-Unqualified] (2b) (no submodules, D-0136); conf.module-import-no-submodule
// kind: positive
// expect: ok
// expect-stdout-hex: 34320a
//
// The program's root module `memory` is what `memory::size` means in the
// nested module `cpu`, although `cpu` imports `std`, which has a
// submodule `std::memory`: a module import brings in a module's exported
// items, not its submodules.

module memory
{
    export fn size() : i32
    {
        42
    }
}

module cpu
{
    import std;

    export fn report()
    {
        printf("%v\n", memory::size());
    }
}

fn main()
{
    cpu::report();
}
