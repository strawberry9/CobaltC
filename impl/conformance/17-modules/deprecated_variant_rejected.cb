// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.retired [Use-Deprecated] (D-0303): a deprecated variant named in a pattern; conf.deprecated-variant
// kind: negative
// expect: diag.deprecated-use (static)
//
// A variant marked `[[deprecated("…")]]`: a pattern naming it is a use, as
// its constructor is.

import std;

enum Shape
{
    Square(i32),
    [[deprecated("write Square")]]
    Box(i32),
}

fn side(Shape s) : i32
{
    match (s)
    {
        Square(n) : n,
        Box(n)    : n,
    }
}

fn main()
{
    printf("%d\n", side(Square(2)));
}
