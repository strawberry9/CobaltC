// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.static-assert [Static-Assert-Checked-Failure]; rule.arith.shift [Shift-Amount-Invalid]; conf.static-assert-shift-amount
// kind: negative
// expect: diag.shift-amount-out-of-range (static)
//
// A shift in a `static_assert` is checked as at run time: an amount that
// is not below the operand's width is the shift's failure, reported
// before the program runs.

import std;

const u32 N = 40;

fn main()
{
    static_assert((1: i32) << N == 0);
}
