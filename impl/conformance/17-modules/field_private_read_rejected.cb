// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.visibility [Field-Not-Visible]
// kind: negative
// expect: diag.name-not-visible (static)
//
// conf.field-private-read-rejected (CHG-0027): a field without `export`
// is visible only where its struct's module is; reading it from the
// root is rejected even though the struct itself is exported.

module m
{
    export struct P
    {
        i32 a;
    }

    export fn make() : P
    {
        P { .a = 1 }
    }
}

fn main()
{
    auto p = m::make();
    auto x = p.a;
}
