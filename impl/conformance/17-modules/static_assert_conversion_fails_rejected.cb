// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.static-assert [Static-Assert-Checked-Failure]; rule.arith.convert [Float-To-Int-Invalid]; conf.static-assert-conversion-fails
// kind: negative
// expect: diag.narrowing-overflow (static)
//
// A conversion in a `static_assert` is checked as at run time: `to_int`
// of a float that is not a number has no value, which is the
// conversion's failure, reported before the program runs.

import std;

const f64 ZERO = 0.0;

fn main()
{
    static_assert(to_int<i32>(ZERO / ZERO) == 0);
}
