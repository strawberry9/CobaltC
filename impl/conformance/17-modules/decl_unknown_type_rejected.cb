// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Resolve-Unbound]; spec/22 disambiguation (4); CHG-0081; conf.decl-unknown-type
// kind: negative
// expect: diag.unbound-name (static)
//
// `int` is no CobaltC type (`i32` is): the statement is still a
// declaration, and its type is reported as an unbound name, before the
// program runs.

import std;

fn main()
{
    printf("before\n");
    int x = 10;
    printf("%v\n", x);
}
