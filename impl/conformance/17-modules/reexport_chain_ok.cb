// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.use (re-exports chain, D-0136); conf.reexport-chain
// kind: positive
// expect: ok
// expect-stdout-hex: 310a
//
// `c` re-exports `b`, which re-exports `a`: `a`'s items reach `c`, so
// `import c;` brings in `one`, declared in `a`.

import std;

module a
{
    export fn one() : i32
    {
        1
    }
}

module b
{
    export import a;
}

module c
{
    export import b;
}

import c;

fn main()
{
    printf("%v\n", one());
}
