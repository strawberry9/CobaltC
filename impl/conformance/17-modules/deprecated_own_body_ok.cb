// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.retired (D-0303): a use inside a deprecated declaration does not count; conf.deprecated-own-body-exempt
// kind: positive
// expect: ok
// stdout: 120
//
// `fact` is deprecated and calls itself; nothing outside it uses it, so
// the program is accepted without the allowance.

import std;

[[deprecated("use the loop in main")]]
fn fact(u32 n) : u32
{
    if (n == 0) { 1 } else { n * fact(n - 1) }
}

fn main()
{
    u32 r = 1;
    u32 k = 1;
    while (k <= 5)
    {
        r = r * k;
        k = k + 1;
    }
    printf("%d\n", r);
}
