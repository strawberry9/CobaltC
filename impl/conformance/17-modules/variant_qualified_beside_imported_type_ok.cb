// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Resolve-Qualified]; conf.variant-qualified-beside-imported-type
// kind: positive
// expect: ok
//
// The qualified form beside conf.variant-beside-imported-type: `E::File`
// names `E`'s variant whatever `std` exports under `File`, and a `match`
// arm's bare `File(n)` is matched against the scrutinee's own enum. The
// imported `std::File` stays usable by its name as a type (CHG-0334).
import std;

enum E
{
    File(i32),
    Other,
}

fn make() : E
{
    E::File(3)
}

fn main() : u8
{
    match (make())
    {
        File(n) : printf("%v\n", n),
        Other   : printf("other\n"),
    }
    match (File::open("no-such-file-here"))
    {
        Ok(_)  : printf("opened\n"),
        Err(_) : printf("not opened\n"),
    }
    0
}
