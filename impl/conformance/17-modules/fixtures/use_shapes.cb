// CONFORMANCE-FIXTURE
// A module file that takes apart a struct of a sibling module: parsed on
// its own (as `cobfmt` and `cobc --check-syntax` parse it), it does not
// know that `Pt` is a type, and the destructuring is recognised by its
// shape (spec/22 disambiguation (5), CHG-0347).

import shapes;

export fn sum(Pt p) : i32
{
    Pt { x, y } = p;
    x + y
}

export fn diff(shapes::Pt p) : i32
{
    shapes::Pt { x: a, y: b } = p;
    a - b
}
