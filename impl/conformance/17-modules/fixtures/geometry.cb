// CONFORMANCE-FIXTURE
// The body of the `geo` module the file_module_* cases in the
// directory above declare with `module geo "./fixtures/geometry.cb";`
// (spec/17 §5). Not a program: no `main`, and nothing here names the
// module -- the declaring file does.

export struct Rect
{
    export f64 w;                  // field visibility is per field (spec/17 §2)
    export f64 h;
}

export fn area(Rect r) : f64
{
    r.w * r.h
}

export fn square(f64 s) : f64
{
    s * s
}

fn scale_factor() : f64
{
    1.0
}
