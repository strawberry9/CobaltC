// CONFORMANCE-FIXTURE
// The body of the `sizes` module that
// file_module_intrinsic_not_inherited_ok.cb declares with
// `module sizes "./fixtures/sizes.cb";` (spec/17 §5). It calls the
// intrinsics `sizeof` and `widen`, which the declaring program also
// declares as its own functions.

export fn pair_bytes() : usize
{
    sizeof<u32>() * widen<usize>(2: u8)
}
