// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const [Ref-Form-Const-Place] (D-0314); spec/08 [Borrow-Exceeds-Source]; conf.const-place-exclusive-rejected
// kind: negative
// expect: diag.borrow-exceeds-source (static)
//
// A place rooted at a constant is reached through a shared reference to its
// one object: an exclusive slice of it is refused.

import std;

const array<u8, 2> K = [1, 2];

fn main()
{
    slice<u8, exclusive> s = &mut K[0..2];
    s[0] = 9;
}
