// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.retired (D-0303): the unittest right after a deprecated item uses it freely; conf.deprecated-unittest-exempt
// kind: positive
// expect: ok
// stdout: 3
//
// The test that immediately follows `sum` is its own; it calls `sum`
// without the allowance, under `--unittest` or not.

import std;

[[deprecated("call total instead")]]
fn sum(i32 a, i32 b) : i32
{
    a + b
}

unittest
{
    assert(sum(1, 2) == 3);
}

fn total(i32 a, i32 b) : i32
{
    a + b
}

fn main()
{
    printf("%d\n", total(1, 2));
}
