// CONFORMANCE-CASE
// spec: 17-modules
// facility: spec/22 disambiguation (4) (a type parameter as a declaration's type); CHG-0081; conf.decl-type-parameter
// kind: positive
// expect: ok
// expect-stdout-hex: 3720747275650a
//
// In a generic function, `T x = a;` declares `x` of the type parameter
// `T`.

import std;

fn copy<T>(T a) : T
{
    T x = a;
    x
}

fn main()
{
    printf("%v %v\n", copy(7), copy(true));
}
