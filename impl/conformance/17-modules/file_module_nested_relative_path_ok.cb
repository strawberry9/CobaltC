// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.file [Module-File] (path resolution)
// kind: positive
// expect: ok
//
// conf.module-file-nested-ok (CHG-0026): lib/a.cb declares
// `export module b "./b.cb";` -- that path resolves against lib/, the
// directory of the file that wrote it, not against this file's.

module a "./fixtures/lib/a.cb";

fn main()
{
    if (a::b::f() != 5)
    {
        1 / (1 - 1);
    }
}
