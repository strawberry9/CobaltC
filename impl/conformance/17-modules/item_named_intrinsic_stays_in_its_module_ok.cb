// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Resolve-Unqualified] (3); D-0055; conf.item-intrinsic-not-inherited
// kind: positive
// expect: ok
// expect-stdout-hex: 31203220332034203520360a313420390a322031203720380a6f6e650a
// args: $TMP
//
// The program's own `reinterpret`, `sizeof`, `allocate`, `widen`, `drop`
// and `dangling` are what its root code calls, but clause (3) never
// carries an intrinsic's name outward: `std`'s code (Vec, String,
// HashMap, Box, Rc, File) and the nested module `m` still reach the
// intrinsics.

import std;

fn reinterpret(i32 a) : i32
{
    a + 1
}

fn sizeof(i32 a) : i32
{
    a + 2
}

fn allocate(i32 a) : i32
{
    a + 3
}

fn widen(i32 a) : i32
{
    a + 4
}

fn drop(i32 a) : i32
{
    a + 5
}

fn dangling() : i32
{
    6
}

module m
{
    export fn cells() : usize
    {
        sizeof<u64>() + widen<usize>(1: u8)
    }
}

fn main()
{
    printf("%v %v %v %v %v %v\n", reinterpret(0), sizeof(0), allocate(0), widen(0), drop(0), dangling());
    auto f = widen;
    printf("%v %v\n", f(10), m::cells());

    Vec<String> words = Vec::new();
    Vec::push(&mut words, String::from_str("alpha"));
    Vec::push(&mut words, String::from_str("beta"));
    HashMap<String, i32> counts = HashMap::new();
    HashMap::insert(&mut counts, String::from_str("alpha"), 2);
    Box<i32> b = Box::new(7);
    Rc<i32> r = Rc::new(8);
    Rc<i32> r2 = Rc::clone(&r);
    printf("%v %v %v %v\n", Vec::len(&words), HashMap::len(&counts), *Box::get(&b), *Rc::get(&r2));

    String dir = Result::unwrap_or(arg(0), String::new());
    String path = String::new();
    String::append(&mut path, &dir);
    String::append(&mut path, "/x.txt");
    String text = String::from_str("one\ntwo\n");
    Result::unwrap_or(write_file(&path, &text), ());
    File file = match (File::open(&path))
    {
        Ok(f) : f,
        Err(_) : fault(assertion_failed),
    };
    Option<String> first = Result::unwrap_or(File::read_line(&mut file), None);
    String line = Option::unwrap_or(first, String::new());
    printf("%s\n", &line);
}
