// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const [Const-Local]; D-0066; conf.const-local-out-of-scope
// kind: negative
// expect: diag.unbound-name (static)
//
// A local constant's name ends with its block, as a local variable's
// does.

import std;

fn main()
{
    {
        const i32 C = 1;
        static_assert(C == 1);
    }
    printf("%v\n", C);
}
