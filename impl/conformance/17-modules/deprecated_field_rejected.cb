// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.retired [Use-Deprecated] (D-0303): a deprecated field; conf.deprecated-field
// kind: negative
// expect: diag.deprecated-use (static)
//
// A field marked `[[deprecated("…")]]`: its access is a use.

import std;

struct P
{
    i32 x;
    [[deprecated("read x")]]
    i32 old_x;
}

fn main()
{
    P p = P { .x = 1, .old_x = 1 };
    printf("%d\n", p.x);
}
