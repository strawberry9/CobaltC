// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.use [Resolve-Unqualified] step 2
// kind: positive
// expect: ok
//
// `import p;` makes p's last segment resolve unqualified within the
// importing module, as [Resolve-Unqualified] step 2 describes.

module inner
{
    export fn helper() : i32
    {
        42
    }
}

import inner::helper;

fn main()
{
    if (helper() != 42)
    {
        1 / (1 - 1);
    }
}
