// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.retired [Tombstone-Declares] with rule.module.resolve [Item-Duplicate] (D-0303); conf.tombstone-reserves-name
// kind: negative
// expect: diag.duplicate-item (static)
//
// A tombstone is an item: the name it keeps cannot be declared again.

import std;

[[removed("call total instead")]]
fn sum;

fn sum(i32 a, i32 b) : i32
{
    a + b
}

fn main()
{
    printf("%d\n", sum(1, 2));
}
