// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const (constant expressions: fields and elements); D-0066; conf.const-field-element
// kind: positive
// expect: ok
// expect-stdout-hex: 33303732303020370a
//
// A field of a constant struct and an element of a constant array (at a
// constant index) are constant expressions: in another constant's
// initializer, in `static_assert`, and in a local constant.

import std;

struct Size
{
    u32 w;
    u32 h;
}

const Size SCREEN = Size { .w = 640, .h = 480 };
const u32 AREA = SCREEN.w * SCREEN.h;
const array<u16, 4> PRIMES = [2, 3, 5, 7];

fn main()
{
    static_assert(AREA == 307200);
    static_assert(SCREEN.w * SCREEN.h == 307200);
    static_assert(PRIMES[2] == 5);
    const u16 LAST = PRIMES[3];
    static_assert(LAST == 7);
    printf("%v %v\n", AREA, LAST);
}
