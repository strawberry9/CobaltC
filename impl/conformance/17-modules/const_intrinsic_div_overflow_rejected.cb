// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const [Const-Checked-Failure]; conf.const-intrinsic-checked-failure
// kind: negative
// expect: diag.div-overflow (static)
//
// A constant's initialiser using `min_value` is a constant expression, and a
// checked failure in it, here `min(i64) / -1`, rejects the program at the
// constant before it runs (bug 013: it faulted at run time).

import std;

const i64 M = min_value<i64>() / -1;

fn main()
{
    printf("%v\n", M);
}
