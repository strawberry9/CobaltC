// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const [Ref-Form-Const] (D-0258); conf.const-address
// kind: positive
// expect: ok
// expect-stdout-hex: 333020313030207472756520330a2d33203720343220302e350a
//
// `&K` of a constant of plain data written as a literal is a shared
// reference to one object with program extent: a table has one address,
// held in a binding, passed to a function, indexed, nested, a struct, a
// number.

import std;

struct Point
{
    i32 x;
    i32 y;
}

const array<u32, 4> TABLE = [10, 20, 30, 40];
const array<array<u8, 2>, 2> GRID = [[1, 2], [3, 4]];
const Point ORIGIN = Point { .x = -3, .y = 7 };
const u64 N = 42;
const f64 HALF = 0.5;

fn sum(ref<array<u32, 4>, shared> t) : u32
{
    u32 s = 0;
    for (usize i = 0; i < 4; i += 1)
    {
        s += t[i];
    }
    s
}

fn same_place(ref<array<u32, 4>, shared> a, ref<array<u32, 4>, shared> b) : bool
{
    unsafe
    {
        rawptr_address(rawptr_of(a)) == rawptr_address(rawptr_of(b))
    }
}

fn main()
{
    ref<array<u32, 4>, shared> t = &TABLE;
    ref<array<array<u8, 2>, 2>, shared> g = &GRID;
    printf("%v %v %v %v\n", t[2], sum(&TABLE), same_place(&TABLE, t), g[1][0]);
    ref<Point, shared> o = &ORIGIN;
    ref<u64, shared> n = &N;
    ref<f64, shared> h = &HALF;
    printf("%v %v %v %v\n", o.x, o.y, *n, *h);
}
