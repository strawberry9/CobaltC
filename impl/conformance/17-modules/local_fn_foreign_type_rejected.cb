// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.local-type (functions only of local types); D-0069; conf.local-fn-foreign-type-rejected
// kind: negative
// expect: diag.syntax-error (static)
//
// A function declared in a block belongs to a type declared in that
// block, not to a module's type.

import std;

struct Outer
{
    i32 a;
}

fn main()
{
    fn Outer::extra(ref<Outer, shared> o) : i32
    {
        o.a
    }
    printf("ok\n");
}
