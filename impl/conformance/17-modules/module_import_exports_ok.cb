// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.use (module import)
// kind: positive
// expect: ok
//
// conf.module-import-exports-ok (CHG-0033): `import geo;` makes `geo`'s
// exported items -- including an enum's variants -- resolve unqualified,
// and `geo` itself still resolves.

module geo
{
    export enum Shape
    {
        Square(i32),
        Dot,
    }

    export fn area(Shape s) : i32
    {
        match (s)
        {
            Square(n) : n * n,
            Dot : 0,
        }
    }
}

import geo;

fn main()
{
    i32 a = area(Square(3)) + geo::area(Dot);
    if (a != 9)
    {
        i32 z = 0;
        i32 fault_now = 1 / z;
    }
}
