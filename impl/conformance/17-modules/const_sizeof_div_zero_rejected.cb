// kind: negative
// expect: diag.div-by-zero (static)
//
// `sizeof<u64>() / 0` in a constant is a division by zero found before the
// program runs.

import std;

const usize M = sizeof<u64>() / 0;

fn main()
{
    printf("%v\n", M);
}
