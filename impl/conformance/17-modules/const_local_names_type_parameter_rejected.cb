// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const [Const-Local-Not-Constant]; D-0066; conf.const-local-names-type-parameter
// kind: negative
// expect: diag.const-not-constant (static)
//
// A constant has one value; one that names the function's type
// parameter would have one per instantiation.

import std;

fn width<T>(T x) : usize
{
    const usize S = sizeof<T>();
    S
}

fn main()
{
    printf("%v\n", width(1));
}
