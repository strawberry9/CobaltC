// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Resolve-Unqualified] (3); rule.module.file; D-0055; conf.file-module-intrinsic-not-inherited
// kind: positive
// expect: ok
// expect-stdout-hex: 38203130203130300a
//
// A library file's code calls the intrinsics `sizeof` and `widen`; the
// program that loads it declares functions of those names at its root.
// The library still reaches the intrinsics (clause (3) never carries an
// intrinsic's name outward), and the program's root code its own.

import std;

module sizes "./fixtures/sizes.cb";

fn sizeof(i32 a) : i32
{
    a * 10
}

fn widen(i32 a) : i32
{
    a * 100
}

fn main()
{
    printf("%v %v %v\n", sizes::pair_bytes(), sizeof(1), widen(1));
}
