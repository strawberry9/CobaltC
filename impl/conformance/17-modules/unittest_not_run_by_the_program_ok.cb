// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.unittest (a test is checked with the program and run only by a test run: a normal run runs `main`, and no test); D-0230; conf.unittest-not-run
// kind: positive
// expect: ok
// expect-stdout-hex: 31360a

import std;

module shapes
{
    import std;

    fn area(i32 w, i32 h) : i32
    {
        w * h
    }

    // A test sees its module's private items.
    unittest "area"
    {
        assert(area(2, 3) == 6);
    }

    export fn square(i32 s) : i32
    {
        area(s, s)
    }
}

unittest "square"
{
    assert(shapes::square(3) == 9);
}

// Not run by the program: it would fail.
unittest
{
    assert(false, "a normal run runs no test");
}

fn main()
{
    printf("%v\n", shapes::square(4));
}
