// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const; an array length that uses an intrinsic and fails is reported before the run; conf.const-array-length-failure
// kind: negative
// expect: diag.syntax-error (static)
//
// `narrow<u8>(300)` does not fit `u8`: as an array length the failure is
// found while the length is read (bug 013).

import std;

fn main()
{
    array<u8, narrow<u8>(300)> a = [0; 1];
    printf("%v\n", slice_len(&a));
}
