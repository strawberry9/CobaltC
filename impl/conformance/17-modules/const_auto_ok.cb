// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const (const auto); D-0068; conf.const-auto
// kind: positive
// expect: ok
// expect-stdout-hex: 736c6f770a313034383537362033303732303020352038203432393439363732393520302e3520636f62616c7420352033203620747275650a
//
// `const auto` takes the type `auto` would: a literal's suffix or the
// default, an operand's type, a struct, array or variant literal's, a
// field's, an element's, an intrinsic's, a function's; at module level
// and in a function, where `static_assert` uses it and its message
// carries values.

import std;

struct Size
{
    u32 w;
    u32 h;
}

enum Mode
{
    Fast,
    Slow,
}

fn double(i32 x) : i32
{
    x * 2
}

const auto KIB = 1024: u64;
const auto MIB = KIB * KIB;                 // u64, from KIB
const auto COUNT = 5;                        // i32, the default
const auto HALF = 0.5;                       // f64
const auto NAME = "cobalt";                  // str
const auto ON = true;
const auto SCREEN = Size { .w = 640, .h = 480 };
const auto AREA = SCREEN.w * SCREEN.h;       // u32, from the fields
const auto PRIMES = [2: u16, 3, 5, 7];       // array<u16, 4>
const auto THIRD = PRIMES[2];                // u16
const auto BIG = max_value<u32>();
const auto WIDTH = sizeof<Size>();           // usize
const auto MODE = Mode::Slow;
const auto MAYBE = Some(3: u8);              // Option<u8>
const auto F = double;                       // fn(i32) : i32

fn main()
{
    const auto a = 200;
    static_assert(a == 200);
    const auto b = a + 1;
    static_assert(b == 201, "b is not equal to %v", b);
    static_assert(MIB == 1048576 && AREA == 307200 && THIRD == 5 && WIDTH == 8);
    u64 m = MIB;
    u32 area = AREA;
    u16 t = THIRD;
    usize w = WIDTH;
    u32 big = BIG;
    f64 h = HALF;
    str n = NAME;
    i32 c = COUNT;
    u8 inner = match (MAYBE) { Some(v) : v, None : 0, };
    i32 six = F(3);
    match (MODE)
    {
        Fast : printf("fast\n"),
        Slow : printf("slow\n"),
    }
    printf("%v %v %v %v %v %v %v %v %v %v %v\n", m, area, t, w, big, h, n, c, inner, six, ON);
}
