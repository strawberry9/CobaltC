// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const [Const-Checked-Failure]; conf.const-array-checked-failure
// kind: negative
// expect: diag.arith-overflow (static)
//
// A constant reading an element of another constant, an array holding
// `max_value<u8>()`, and adding 1 overflows `u8`: rejected at the constant.

import std;

const array<u8, 3> T = [max_value<u8>(), 0, 0];
const u8 Y = T[0] + 1;

fn main()
{
    printf("%v\n", Y);
}
