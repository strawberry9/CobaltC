// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Resolve-Qualified] (std)
// kind: positive
// expect: ok
//
// conf.std-qualified-ok (CHG-0033): `std::…` is an ordinary qualified path
// and needs no import.

fn main()
{
    std::Vec<i32> v = std::Vec::new();
    std::Vec::push(&mut v, 4);
    std::printf("qualified\n");
}
