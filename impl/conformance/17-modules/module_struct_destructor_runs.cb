// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.resauth.destroy [Run-Destructor] (a struct inside a module)
// kind: positive
// expect: ok
// expect-stdout-hex: 64726f707065640a
//
// conf.module-struct-destructor-runs (CHG-0033): `fn S::drop` declared in
// the module that declares `S` is `m::S::drop`, `S`'s destructor, and runs
// when `s` goes out of scope. (Before CHG-0033 both implementations
// rejected it as `diag.bad-destructor-signature`.)

module m
{
    import std;

    export resource struct S
    {
        export i32 x;
    }

    export fn S::drop(ref<S, exclusive> self)
    {
        printf("dropped\n");
    }
}

fn main()
{
    m::S s = m::S { .x = 1 };
}
