// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Resolve-Unqualified] (3), (4); CHG-0334; CHG-0353; conf.root-type-named-as-variant
// kind: positive
// expect: ok
// expect-stdout-hex: 32203120390a
//
// The program declares at its root an enum named as a variant of `std`'s
// (`NetError::Refused`) and of its own (`Outcome::Refused`). `std`'s
// code, which writes its variant bare, still means its variant; in the
// program, `Refused` in value position and in a pattern is
// `Outcome::Refused`, and `Refused::Yes` is a variant of the program's
// enum `Refused`.

import std;

enum Refused
{
    No,
    Yes,
}

enum Outcome
{
    Done,
    Refused,
}

fn code(Outcome o) : i32
{
    match (o)
    {
        Done    : 1,
        Refused : 2,
    }
}

fn main()
{
    Refused r = Refused::Yes;
    Outcome o = Refused;
    i32 n = match (r)
    {
        Refused::No  : 0,
        Refused::Yes : 9,
    };
    printf("%v %v %v\n", code(o), code(Done), n);
}
