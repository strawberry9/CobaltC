// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.use (a re-export cycle, D-0136); conf.reexport-cycle
// kind: positive
// expect: ok
// expect-stdout-hex: 3320340a
//
// `a` re-exports `b` and `b` re-exports `a`: each ends with both modules'
// exported items, each once.

import std;

module a
{
    export fn three() : i32
    {
        3
    }

    export import b;
}

module b
{
    export fn four() : i32
    {
        4
    }

    export import a;
}

fn main()
{
    printf("%v %v\n", b::three(), a::four());
}
