// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.retired [Use-Deprecated] (D-0303): a path through a deprecated type; conf.deprecated-type-path
// kind: negative
// expect: diag.deprecated-use (static)
//
// `Old::new()` is a use of `Old`, though `new` itself carries no attribute;
// `Old::new` may name `Old` in its own signature and body, since a use
// inside a declaration of a deprecated type does not count.

import std;

[[deprecated("use Point")]]
struct Old
{
    i32 x;
}

fn Old::new() : Old
{
    Old { .x = 1 }
}

fn main()
{
    auto o = Old::new();
    printf("%d\n", o.x);
}
