// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.local-type; D-0069; conf.local-type-fn-no-variables
// kind: negative
// expect: diag.unbound-name (static)
//
// A function of a local type is a function: it does not see the
// enclosing function's variables (a closure would).

import std;

fn main()
{
    i32 bonus = 5;
    struct P
    {
        i32 x;
    }
    fn P::get(ref<P, shared> p) : i32
    {
        p.x + bonus
    }
    P p = P { .x = 1 };
    printf("%v\n", P::get(&p));
}
