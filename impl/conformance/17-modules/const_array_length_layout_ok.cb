// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const; an array length may use sizeof and alignof of any type the program lays out; conf.const-array-length-layout
// kind: positive
// expect: ok
// expect-stdout-hex: 382036342036342038203820313620382032342037322031362031322032340a310a
//
// An array's length may use `sizeof` and `alignof` of any type whose layout
// the compiler knows once the program's items are: a generic struct's
// instance, an `align(N)` struct, a reference, a raw pointer, an enum,
// `Option`, `Box`, `Vec`, `String`, a struct of another module, a struct
// holding such a length itself, directly or through a `const` (bug 013).
// Each length agrees with the type checker's `sizeof`.

import std;

struct Pair<T>
{
    T a;
    u8 b;
}

struct Line align(64)
{
    u64 n;
}

enum Shape
{
    Dot,
    Circle(f64),
}

module geom
{
    export struct Pt
    {
        export i32 x;
        export i32 y;
        export ref<i32, shared> owner;
    }
}

const usize VEC = sizeof<Vec<u8>>();
const usize TWO_VECS = VEC * 2;

// A struct whose size holds a deferred length, used by another length.
struct Buf
{
    array<u8, sizeof<Box<u64>>()> head;
    u32 count;
}

fn main()
{
    array<u8, sizeof<Pair<u32>>()> a = [1; sizeof<Pair<u32>>()];
    array<u8, sizeof<Line>()> b = [2; sizeof<Line>()];
    array<u8, alignof<Line>()> c = [3; alignof<Line>()];
    array<u8, sizeof<ref<i32, shared>>()> d = [4; 8];
    array<u8, sizeof<rawptr<u8>>()> e = [5; 8];
    array<u8, sizeof<Shape>()> f = [6; sizeof<Shape>()];
    array<u8, sizeof<Option<u32>>()> g = [7; sizeof<Option<u32>>()];
    array<u8, VEC> h = [8; VEC];
    array<u8, TWO_VECS + sizeof<String>()> i = [9; TWO_VECS + sizeof<String>()];
    array<u8, sizeof<geom::Pt>()> j = [10; sizeof<geom::Pt>()];
    array<u8, sizeof<Buf>()> k = [11; sizeof<Buf>()];
    array<Buf, 2> l = [Buf { .head = [0; sizeof<Box<u64>>()], .count = 1 }; 2];
    static_assert(sizeof<Line>() == 64 && alignof<Line>() == 64);
    static_assert(sizeof<Buf>() == sizeof<Box<u64>>() + 4);
    printf("%v %v %v %v %v %v %v %v %v %v %v %v\n", slice_len(&a), slice_len(&b), slice_len(&c), slice_len(&d), slice_len(&e), slice_len(&f), slice_len(&g), slice_len(&h), slice_len(&i), slice_len(&j), slice_len(&k), sizeof<array<Buf, 2>>());
    printf("%v\n", l[1].count);
}
