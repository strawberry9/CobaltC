// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Resolve-Ambiguous] (two module imports)
// kind: negative
// expect: diag.ambiguous-name (static)
//
// conf.module-import-ambiguous-rejected (CHG-0033): two imported modules
// both export `f`, and `f` is used unqualified.

module a
{
    export fn f() : i32
    {
        1
    }
}

module b
{
    export fn f() : i32
    {
        2
    }
}

import a;
import b;

fn main()
{
    i32 x = f();
}
