// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.static-assert [Static-Assert-Failed] (a formatted message); D-0068; conf.static-assert-format-message
// kind: negative
// expect: diag.static-assert-failed (static)
//
// A `static_assert`'s message may carry constant values, formatted as
// `printf` formats them, when the assertion fails.

import std;

fn main()
{
    const auto a = 200;
    const auto b = a + 1;
    static_assert(b == 202, "b is %v, not %v", b, 202);
}
