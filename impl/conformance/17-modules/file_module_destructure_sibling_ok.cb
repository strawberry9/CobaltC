// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.file [Module-File]; [Let-Destructure] (D-0044); conf.module-file-destructure-sibling
// kind: positive
// expect: ok
// expect-stdout-hex: 3920350a
//
// A module file destructures a struct declared in a sibling module file,
// by its short name (imported) and by its qualified path. The module
// file parses on its own (spec/22 disambiguation (5): a name and a brace
// body opening with a bare identifier is a destructuring), so `cobfmt`
// formats it and `cobc --check-syntax` accepts it (CHG-0347).

import std;

module shapes "./fixtures/shapes.cb";
module use_shapes "./fixtures/use_shapes.cb";

fn main()
{
    shapes::Pt p = shapes::Pt { .x = 7, .y = 2 };
    printf("%v %v\n", use_shapes::sum(p), use_shapes::diff(p));
}
