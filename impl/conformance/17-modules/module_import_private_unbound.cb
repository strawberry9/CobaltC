// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.visibility (module import brings exports only)
// kind: negative
// expect: diag.unbound-name (static)
//
// conf.module-import-private-unbound (CHG-0033): a module import brings
// only exported items; a private one is not found unqualified.

module geo
{
    fn hidden() : i32
    {
        1
    }
}

import geo;

fn main()
{
    i32 x = hidden();
}
