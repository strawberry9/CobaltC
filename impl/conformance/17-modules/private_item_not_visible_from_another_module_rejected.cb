// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.visibility [Resolve-Not-Visible]
// kind: negative
// expect: diag.name-not-visible (static)
//
// A private (non-export) item is usable only from its own module and
// sub-modules -- not from an unrelated module referencing it by path.

module inner
{
    fn helper() : i32
    {
        42
    }
}

fn main()
{
    inner::helper();
}
