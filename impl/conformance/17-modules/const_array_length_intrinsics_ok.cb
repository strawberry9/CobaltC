// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const; an array length is a constant expression that may use the intrinsics; conf.const-array-length-intrinsics
// kind: positive
// expect: ok
// expect-stdout-hex: 342032353620323020382034203520342031360a
//
// An array's length may be a constant of `sizeof`, `min_value`, `max_value`,
// `widen` and `narrow` of integer types (and `sizeof` of `f32`, `f64`,
// `bool`), or the expression itself; also of a plain struct the file
// declares (bug 013).

import std;

const usize S = sizeof<u32>();
const usize M = widen<usize>(max_value<u8>()) + 1;
const usize N = sizeof<u64>() * 2 + narrow<usize>(S);

struct Pt
{
    u8 tag;
    u32 val;
    array<u16, 3> rest;
}

const usize P = sizeof<Pt>();

struct Block
{
    array<u8, S> word;
}

fn main()
{
    static_assert(P == sizeof<Pt>());
    array<u8, S> a = [1; S];
    array<u16, M> b = [0; M];
    array<bool, N> c = [true; N];
    array<u8, sizeof<u64>()> d = [7; sizeof<u64>()];
    array<f64, sizeof<f32>()> e = [0.5; sizeof<f32>()];
    array<u8, S + sizeof<bool>()> f = [2; S + sizeof<bool>()];
    array<u8, P> g = [3; P];
    Block blk = Block { .word = a };
    printf("%v %v %v %v %v %v %v %v\n", slice_len(&a), slice_len(&b), slice_len(&c), slice_len(&d), slice_len(&e), slice_len(&f), slice_len(&blk.word), slice_len(&g));
}
