// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Resolve-Ambiguous] (only where used)
// kind: positive
// expect: ok
//
// conf.module-import-unused-clash-ok (CHG-0033): the same two imports are
// not an error while `f` is not used unqualified, so a module that gains
// an export never breaks a program that does not name it.

module a
{
    export fn f() : i32
    {
        1
    }
}

module b
{
    export fn f() : i32
    {
        2
    }
}

import a;
import b;

fn main()
{
    i32 x = a::f() + b::f();
}
