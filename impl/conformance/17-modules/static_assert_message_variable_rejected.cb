// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.static-assert [Static-Assert-Not-Constant] (a message argument); D-0068; conf.static-assert-message-variable
// kind: negative
// expect: diag.static-assert-not-constant (static)
//
// The values in a `static_assert`'s message are computed before the
// program runs: a variable cannot be one of them.

import std;

fn main()
{
    i32 x = 3;
    static_assert(true, "x is %v", x);
}
