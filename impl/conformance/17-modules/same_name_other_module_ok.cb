// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Item-Duplicate] (distinct qualified names)
// kind: positive
// expect: ok
//
// conf.same-name-other-module-ok (CHG-0032): `f` and `m::f` are different
// qualified names; neither is a duplicate of the other.

import std;

module m
{
    import std;

    export fn f()
    {
        printf("m::f\n");
    }
}

fn f()
{
    printf("f\n");
}

fn main()
{
    f();
    m::f();
}
