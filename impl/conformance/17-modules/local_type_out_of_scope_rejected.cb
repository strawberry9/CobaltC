// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.local-type [Local-Type]; D-0069; conf.local-type-out-of-scope
// kind: negative
// expect: diag.unbound-name (static)
//
// A local type's name ends with its block.

import std;

fn main()
{
    {
        struct P
        {
            i32 x;
        }
    }
    P q = P { .x = 1 };
}
