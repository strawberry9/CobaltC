// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.const; [Const-Checked-Failure]; conf.const-intrinsic-forms
// kind: positive
// expect: ok
// expect-stdout-hex: 2d3436313136383630313834323733383739303420313620323536202d313238203235340a
//
// Constants built from `min_value`, `max_value`, `sizeof`, `widen` and
// `narrow` that do not fail are accepted and have their values.

import std;

const i64 A = min_value<i64>() / 2;
const usize B = sizeof<u64>() * 2;
const u16 C = widen<u16>(max_value<u8>()) + 1;
const i8 D = narrow<i8>(-128: i32);
const array<u8, 2> E = [max_value<u8>(), 1];
const u8 F = E[0] - E[1];

fn main()
{
    printf("%v %v %v %v %v\n", A, B, C, D, F);
}
