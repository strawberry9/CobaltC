// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Item-Duplicate] (an alias for a different item, D-0136); conf.reexport-conflict-rejected
// kind: negative
// expect: diag.duplicate-item (static)
//
// `m` declares `f` and re-exports `a`, which exports a different `f`.

module a
{
    export fn f() : i32
    {
        1
    }
}

module m
{
    export fn f() : i32
    {
        2
    }

    export import a;
}

fn main()
{
    i32 x = m::f();
}
