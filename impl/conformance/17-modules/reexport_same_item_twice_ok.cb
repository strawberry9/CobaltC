// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.use (re-export); rule.module.resolve [Item-Duplicate] (the same item twice, D-0136); conf.reexport-same-item-twice
// kind: positive
// expect: ok
// expect-stdout-hex: 320a
//
// `m` brings in `a::two` twice, through the module and by name, and also
// through `b`, which re-exports `a`: one item under one name, no
// duplicate.

import std;

module a
{
    export fn two() : i32
    {
        2
    }
}

module b
{
    export import a;
}

module m
{
    export import a;
    export import a::two;
    export import b;
}

fn main()
{
    printf("%v\n", m::two());
}
