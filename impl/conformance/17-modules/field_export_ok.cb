// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.visibility [Field-Not-Visible] (export)
// kind: positive
// expect: ok
//
// conf.field-export-ok (CHG-0027): an `export` field may be read,
// written, constructed and destructured from outside its module; a
// private field remains usable inside it. (Destructuring names every
// field, D-0044, so it is shown on `Q`, whose fields are all exported;
// `P`, with a private field, cannot be destructured outside `m`.)

module m
{
    export struct P
    {
        export i32 a;
        i32 hidden;
    }

    export struct Q
    {
        export i32 a;
        export i32 b;
    }

    export fn make() : P
    {
        P { .a = 1, .hidden = 2 }
    }

    export fn hidden_of(ref<P, shared> p) : i32
    {
        p.hidden                       // private field, own module: visible
    }
}

import m::P;
import m::Q;

fn main()
{
    auto p = m::make();
    p.a = p.a + 41;
    if (p.a != 42)
    {
        1 / (1 - 1);
    }
    if (m::hidden_of(&p) != 2)
    {
        1 / (1 - 1);
    }
    Q { a, b } = Q { .a = p.a, .b = 7 };
    if (a != 42 || b != 7)
    {
        1 / (1 - 1);
    }
}
