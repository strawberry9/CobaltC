// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.visibility (a re-export passes on exported items only, D-0136); conf.reexport-private-not-passed
// kind: negative
// expect: diag.unbound-name (static)
//
// `lib` re-exports `inner`, whose `helper` is private: it is not one of
// `lib`'s names, so `lib::helper` names nothing.

module lib
{
    module inner
    {
        fn helper() : i32
        {
            1
        }

        export fn api() : i32
        {
            helper()
        }
    }

    export import lib::inner;
}

fn main()
{
    i32 x = lib::api() + lib::helper();
}
