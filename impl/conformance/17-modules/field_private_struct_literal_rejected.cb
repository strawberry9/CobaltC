// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.visibility [Field-Not-Visible]
// kind: negative
// expect: diag.name-not-visible (static)
//
// conf.field-private-literal-rejected (CHG-0027): a struct literal names
// its fields, so constructing `m::P` outside `m` needs every named field
// to be visible there.

module m
{
    export struct P
    {
        i32 a;
    }
}

fn main()
{
    auto p = m::P { .a = 1 };
}
