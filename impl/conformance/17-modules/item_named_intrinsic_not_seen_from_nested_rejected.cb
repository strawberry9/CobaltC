// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Resolve-Unqualified] (3); D-0055; conf.item-intrinsic-nested-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// The root's own `sizeof` hides the intrinsic only in the root: in the
// nested module `m`, `sizeof(1)` is the intrinsic `sizeof<T>()`, which
// takes no argument.

import std;

fn sizeof(i32 a) : i32
{
    a + 1
}

module m
{
    export fn g() : i32
    {
        sizeof(1)
    }
}

fn main()
{
    i32 x = m::g();
}
