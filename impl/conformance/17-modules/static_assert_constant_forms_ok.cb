// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.static-assert, rule.module.const (constant expressions: the operators and conversions of spec/17 §1a); rule.arith.shift, rule.arith.convert, rule.arith.alt; conf.static-assert-constant-forms
// kind: positive
// expect: ok
// expect-stdout-hex: 6f6b0a
//
// A constant expression may use every operator and every conversion
// `spec/17` §1a names, computed before the program runs as `spec/06`
// computes it at run time: shifts (the left operand's type, the high
// bits discarded), a minus applied to a literal as one value,
// `narrow_wrapping`, `reinterpret` (between signs, and a float's bits),
// `to_float` (to `f32` rounded once), `to_int`, float arithmetic in the
// operands' type, the floats' limits, `wrapping_*`, `saturating_*`, and
// text compared byte by byte.

import std;

const i32 LOWEST = -2147483648;
const u32 BITS = 5;
const f64 THIRD = 1.0 / 3.0;

fn main()
{
    static_assert(1 << 4 == 16);
    static_assert(-8 >> 1 == -4);
    static_assert((200: u8) << 1 == 144);
    static_assert((1: i32) << 31 == LOWEST);
    static_assert((255: u8) >> BITS == 7);
    static_assert(LOWEST < 0 && -128: i8 == min_value<i8>());
    static_assert(narrow_wrapping<u8>(300) == 44);
    static_assert(narrow_wrapping<i8>(200) == -56);
    static_assert(reinterpret<i32>(4294967295: u32) == -1);
    static_assert(reinterpret<u32>(1.0: f32) == 0x3f80_0000: u32);
    static_assert(reinterpret<f64>(0x3ff8_0000_0000_0000: u64) == 1.5);
    static_assert(to_float<f32>(THIRD) == 0.33333334: f32);
    static_assert(to_float<f32>(16777217) == 16777216.0: f32);
    static_assert(to_int<i32>(-3.9) == -3);
    static_assert(0.1 + 0.2 != 0.3 && 0.5 * 4.0 - 1.0 == 1.0);
    static_assert(0.1: f32 + 0.2: f32 == 0.3: f32);
    static_assert(max_value<f32>() == 3.4028235e38: f32 && min_value<f64>() == -1.7976931348623157e308);
    static_assert(wrapping_add(max_value<i32>(), 1) == min_value<i32>());
    static_assert(wrapping_sub(0: u8, 1) == 255);
    static_assert(wrapping_mul(max_value<u64>(), max_value<u64>()) == 1);
    static_assert(saturating_add(max_value<i32>(), 5) == max_value<i32>());
    static_assert(saturating_sub(0: u16, 9) == 0);
    static_assert(saturating_mul(min_value<i64>(), 2) == min_value<i64>());
    static_assert("caf\u{e9}" != "cafe" && "abc" < "abd" && "ab" < "abc");
    printf("ok\n");
}
