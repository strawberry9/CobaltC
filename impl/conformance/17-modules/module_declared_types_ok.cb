// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Resolve-Qualified] (struct and enum items of a module: in type position, as literals, as variants); rule.module.use
// kind: positive
// expect: ok
//
// A struct or enum declared in a module is addressed by its qualified
// path in every position -- a declaration's type, a struct literal, a
// variant constructor -- or unqualified after an `import`; inside the
// module its own bare name resolves.

module geom
{
    export struct Point
    {
        export i32 x;
        export i32 y;
    }

    export enum Shape
    {
        Dot,
        Circle(i32)
    }

    export fn make(i32 x) : Point
    {
        Point { .x = x, .y = 0 }
    }

    export fn radius(Shape s) : i32
    {
        match (s)
        {
            Dot : 0,
            Circle(r) : r,
        }
    }
}

import geom::Shape;

fn main()
{
    geom::Point p = geom::Point { .x = 3, .y = 4 };
    auto q = geom::make(1);
    if (p.x + p.y + q.x != 8)
    {
        1 / (1 - 1);
    }
    Shape s = geom::Shape::Circle(2);
    if (geom::radius(s) != 2)
    {
        1 / (1 - 1);
    }
    if (geom::radius(Shape::Dot) != 0)
    {
        1 / (1 - 1);
    }
}
