// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Resolve-Unqualified] clause (1) before (2b)
// kind: positive
// expect: ok
//
// conf.std-own-declaration-wins-ok (CHG-0033): a module's own `printf` is
// found by clause (1) before the imported `std::printf` (clause 2b); the
// latter stays reachable by its qualified name. Not a duplicate: the two
// are `printf` and `std::printf`.

import std;

fn printf(str s)
{
    std::printf("[own] ");
    std::printf("%v", s);
}

fn main()
{
    printf("hello\n");
}
