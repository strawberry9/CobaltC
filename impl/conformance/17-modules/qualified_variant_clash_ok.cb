// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve; conf.qualified-variant-clash
// kind: positive
// expect: ok
// expect-stdout-hex: 322074616720636972636c650a
//
// `n::Circle(...)` names the variant of the enum declared in module `n`,
// even when this file has its own enum with a `Circle` variant (a bare
// `Circle` here is the local one; a pattern resolves by the scrutinee's
// enum).

import std;

module n "./qualified_variant/shapes.cb";
import n::Shape;

enum Tag
{
    Circle,
    Other,
}

fn main()
{
    Shape s = n::Circle(n::Circle { .r = 2.0 });
    f64 r = match (s) { Circle(c) : c.r, Dot : 0.0 };
    Tag t = Circle;
    printf("%g %s\n", r, match (t) { Circle : "tag circle", Other : "other" });
}
