// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Resolve-Unqualified] (in value position a module is passed over, CHG-0412); rule.module.use; conf.import-module-function-named-like-module
// kind: positive
// expect: ok
// expect-stdout-hex: 747275652066616c73652066616c73650a
//
// `module check "./fixtures/check.cb"; import check;` and then `check(5)`:
// clause (1) finds the module `check`, which is no value, so in value
// position it is passed over as a type is, and clause (2b) finds the
// module's exported function `check`. `check::check` still names it in
// full, and `other` resolves as before. (Before the session findings of
// 2026-11-06 `check(5)` was `diag.unbound-name`.)

import std;

module check "./fixtures/check.cb";

import check;

fn main()
{
    printf("%v %v %v\n", check(5), other(5), check::check(-1));
}
