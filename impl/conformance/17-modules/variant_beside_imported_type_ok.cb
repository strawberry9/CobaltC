// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.resolve [Resolve-Unqualified]; conf.variant-beside-imported-type
// kind: positive
// expect: ok
//
// `std` exports a struct `File`, which `[Resolve-Unqualified]` clause 2b
// finds for the bare `File` before clause 4 reaches the program's own
// enum's variant. In value position a type is passed over (CHG-0334,
// D-0266), so `File(3)` is `E::File`, and `File` in type position is still
// `std::File`. Before CHG-0334 the tools quietly took the call for
// `std::PathKind::File`, an enum of `std` with a variant of that name.
import std;

enum E
{
    File(i32),
    Other,
}

fn make() : E
{
    File(3)
}

fn main() : u8
{
    match (make())
    {
        File(n) : printf("%v\n", n),
        Other   : printf("other\n"),
    }
    match (File::open("no-such-file-here"))
    {
        Ok(_)  : printf("opened\n"),
        Err(_) : printf("not opened\n"),
    }
    0
}
