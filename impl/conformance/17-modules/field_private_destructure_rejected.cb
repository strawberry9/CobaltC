// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.visibility [Field-Not-Visible]
// kind: negative
// expect: diag.name-not-visible (static)
//
// conf.field-private-destructure-rejected (CHG-0027): single-field
// destructuring names the field too.

module m
{
    export struct W
    {
        i32 v;
    }

    export fn make() : W
    {
        W { .v = 3 }
    }
}

import m::W;

fn main()
{
    W { v } = m::make();
}
