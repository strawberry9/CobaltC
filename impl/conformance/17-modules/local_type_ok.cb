// CONFORMANCE-CASE
// spec: 17-modules
// facility: rule.module.local-type [Local-Type]; D-0069; conf.local-type
// kind: positive
// expect: ok
// expect-stdout-hex: 73686f727465737420617420310a636c61737365732031203220330a7472656520360a64726f7020320a64726f7020310a6e6f69737920330a73636f7065732033330a
//
// Local types: a struct with a function of its own, an enum matched by
// qualified and bare variants, a recursive struct through `Box`, a
// resource with a destructor, two types of one name in sibling blocks
// (with `sizeof` and destructuring).

import std;

fn shortest(ref<Vec<String>, shared> words) : usize
{
    struct Entry
    {
        usize len;
        usize at;
    }

    fn Entry::better(ref<Entry, shared> a, ref<Entry, shared> b) : bool
    {
        a.len < b.len || (a.len == b.len && a.at < b.at)
    }

    Entry best = Entry { .len = max_value<usize>(), .at = 0 };
    foreach (i, w in words)
    {
        Entry e = Entry { .len = String::len(w), .at = i };
        if (Entry::better(&e, &best))
        {
            best = e;
        }
    }
    best.at
}

fn classify(i32 n) : u32
{
    enum Sign
    {
        Negative,
        Zero,
        Positive(i32),
    }
    Sign s = if (n < 0) { Sign::Negative } else { if (n == 0) { Sign::Zero } else { Sign::Positive(n) } };
    match (s)
    {
        Sign::Negative : 1,
        Zero           : 2,
        Positive(v)    : 3 + narrow<u32>(v) - narrow<u32>(v),
    }
}

fn tree_sum() : i64
{
    struct Node
    {
        i64 v;
        Option<Box<Node>> next;
    }
    fn Node::sum(ref<Node, shared> n) : i64
    {
        match (&n.next)
        {
            Some(b) : n.v + Node::sum(Box::get(b)),
            None    : n.v,
        }
    }
    Node list = Node { .v = 1, .next = Some(Box::new(Node { .v = 2, .next = Some(Box::new(Node { .v = 3, .next = None })) })) };
    Node::sum(&list)
}

fn noisy() : u32
{
    resource struct Tracker
    {
        u32 id;
    }
    fn Tracker::drop(ref<Tracker, exclusive> self)
    {
        printf("drop %v\n", self.id);
    }
    {
        Tracker a = Tracker { .id = 1 };
        Tracker b = Tracker { .id = 2 };
    }
    3
}

fn two_scopes() : u32
{
    u32 total = 0;
    {
        struct P
        {
            u32 x;
        }
        P p = P { .x = 10 };
        total = total + p.x + narrow<u32>(sizeof<P>());
    }
    {
        struct P
        {
            u64 x;
            u64 y;
        }
        P p = P { .x = 1, .y = 2 };
        P { x, y } = p;
        total = total + narrow<u32>(x + y) + narrow<u32>(sizeof<P>());
    }
    total
}

fn main()
{
    Vec<String> w = Vec::new();
    Vec::push(&mut w, String::from_str("banana"));
    Vec::push(&mut w, String::from_str("fig"));
    Vec::push(&mut w, String::from_str("kiwi"));
    Vec::push(&mut w, String::from_str("pea"));
    printf("shortest at %v\n", shortest(&w));
    printf("classes %v %v %v\n", classify(-4), classify(0), classify(9));
    printf("tree %v\n", tree_sum());
    printf("noisy %v\n", noisy());
    printf("scopes %v\n", two_scopes());
}
