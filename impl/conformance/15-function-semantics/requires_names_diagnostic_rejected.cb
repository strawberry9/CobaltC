// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.requires [Requires-Fail]; D-0317; conf.requires-names-diagnostic
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// A requirement may name the fault it is, as `fault(d)` does.

import std;

fn at(ref<Vec<u64>, shared> v, usize i) : u64
    requires
    {
        i < Vec::len(v), index_out_of_bounds;
    }
{
    v[i]
}

fn main()
{
    Vec<u64> v = Vec::new();
    Vec::push(&mut v, 7);
    usize k = Vec::len(&v);
    printf("%v\n", at(&v, k));
}
