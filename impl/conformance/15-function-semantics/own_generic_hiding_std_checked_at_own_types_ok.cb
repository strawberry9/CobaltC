// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.generic-call; D-0010 (checked per instantiation); D-0024 (own declaration hides std's); conf.own-generic-hiding-std-checked-at-own-types
// kind: positive
// expect: ok
// expect-stdout-hex: 32203120330a
//
// A program's own generic `swap<T>` hides `std::swap`, and std's
// sorting instantiates *its* `swap` at `Vec<usize>` internally. Each
// instantiation is of the function the call names: the program's
// `swap` is checked only at the types the program calls it with
// (`i64` here), and std's at its own. Previously an instantiation was
// recorded under the bare name `swap`, so std's `Vec<usize>` one was
// checked against this body -- whose `*x = *y` over a live `Vec` is an
// overwrite at that type -- and the program was wrongly rejected.

import std;

fn swap<T>(ref<T, exclusive> x, ref<T, exclusive> y)
{
    auto t = *x;
    *x = *y;
    *y = t;
}

fn main()
{
    i64 a = 1;
    i64 b = 2;
    swap(&mut a, &mut b);
    Vec<usize> v = Vec::new();
    Vec::push(&mut v, 3);
    Vec::push(&mut v, 1);
    Vec::sort(&mut v);
    printf("%v %v %v\n", a, b, v[1]);
}
