// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: type.fn; rule.type.typing [T-Item]; rule.fn.call [Callable-Fn]
// kind: positive
// expect: ok
//
// A named function is a value of its fn type: it can be passed where
// a fn-typed parameter is declared, stored in a fn-typed binding, and
// called through either. Previously a binding holding a fn value was
// mistaken for a closure object when called.

fn apply(fn(i32) : i32 f, i32 x) : i32
{
    f(x)
}

fn double(i32 x) : i32
{
    x * 2
}

fn main()
{
    if (apply(double, 4) != 8)
    {
        1 / (1 - 1);
    }
    fn(i32) : i32 g = double;
    if (g(5) != 10)
    {
        1 / (1 - 1);
    }
}
