// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: [Fn-Value-Empty-Call] (D-0089); conf.fn-value-emptied-call
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// The closure of `f` owns a `String`, so `g = f` moves it and leaves
// `f` empty; calling `f` is `diag.stale-binding`. A `fn` type does not
// say what its closure owns, so this is found when the program runs.

import std;

fn make() : fn() : usize
{
    String s = "owned";
    move [s]() : usize { String::len(&s) }
}

fn main()
{
    fn() : usize f = make();
    fn() : usize g = f;
    g();
    f();
}
