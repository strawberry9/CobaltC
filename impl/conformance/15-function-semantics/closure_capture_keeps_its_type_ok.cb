// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Form]; rule.type.expected (a literal takes the other operand's type); conf.closure-capture-keeps-its-type
// kind: positive
// expect: ok
//
// Inside a closure body a captured name has its binding's type, so the
// literal in `e + 10` is a `u8` as it would be outside, not an `i32`.

import std;

fn main()
{
    u8 e = 5;
    u16 wide = 1000;
    {
        auto f = [e, wide]()
        {
            u8 t = e + 10;
            u8 s = 200 - e;
            wide = wide * 2 + 1;
            e = t + s;
        };
        f();
    }
    assert(e == 210 && wide == 2001, "e %v, wide %v", e, wide);
}
