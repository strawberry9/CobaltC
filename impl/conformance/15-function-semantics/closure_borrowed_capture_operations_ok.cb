// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Form-Borrow]; conf.closure-borrowed-capture-operations
// kind: positive
// expect: ok
// expect-stdout-hex: 35203220332031312035203320310a
//
// A closure without `move` reaches its captures through its borrow
// (`*self.f_i`): indexing a captured Vec and array, a field, a nested
// Vec, a String, a match on a captured Option and one on a captured
// resource enum (its arms move nothing) all read the captured value. (cobc once wrapped a captured Vec in a second `*`.)

import std;

struct P
{
    i32 x;
    Vec<i32> ys;
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 4);
    Vec::push(&mut v, 5);
    array<i32, 3> arr = [1, 2, 3];
    P p = P { .x = 9, .ys = Vec::new() };
    Vec::push(&mut p.ys, 11);
    String s = "hello";
    Option<i32> o = Some(3);
    auto a = [v]() : i32 { v[1] };
    auto b = [v]() : usize { Vec::len(&v) };
    auto c = [arr]() : i32 { arr[2] };
    auto d = [p]() : i32 { p.ys[0] };
    auto e = [s]() : usize { String::len(&s) };
    auto f = [o]() : i32 { match (o) { Some(k) : k, None : 0 } };
    Option<String> g0 = Some(String::from_str("x"));
    auto g = [g0]() : i32 { match (g0) { Some(_) : 1, None : 0 } };
    printf("%d %d %d %d %d %d %d\n", a(), b(), c(), d(), e(), f(), g());
}
