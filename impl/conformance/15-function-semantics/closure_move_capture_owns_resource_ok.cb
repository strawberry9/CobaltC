// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure (move capture)
// kind: positive
// expect: ok
//
// A `move` closure takes ownership of a captured resource; calling it
// twice must not double-destroy or read freed memory.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 7);
    auto reader = move [v]()
    {
        *Vec::index_shared(&v, 0)
    };
    if (reader() != 7)
    {
        1 / (1 - 1);
    }
    if (reader() != 7)
    {
        1 / (1 - 1);
    }
}
