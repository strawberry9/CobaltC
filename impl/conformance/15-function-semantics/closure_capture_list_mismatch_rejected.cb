// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Capture-List-Rejected]
// kind: negative
// expect: diag.capture-list-mismatch (static)
//
// The written capture list must equal exactly the closure body's own
// free-variable set -- naming an unused capture is rejected, not
// silently accepted.

fn main()
{
    i32 x = 1;
    i32 unused = 2;
    auto reader = [x, unused]()
    {
        x
    };
    reader();
}
