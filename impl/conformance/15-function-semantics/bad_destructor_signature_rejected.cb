// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: spec/07 §1 (diag.bad-destructor-signature)
// kind: negative
// expect: diag.bad-destructor-signature (static)
//
// `fn T::drop` must take exactly one `ref<T, exclusive>` and return
// nothing; a by-value self would let the destructor move the object
// out. A declaration-level fact, rejected whether or not R is used.

resource struct R
{
    i32 v;
}

fn R::drop(R self)
{
}

fn main()
{
}
