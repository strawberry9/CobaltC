// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.call (a `fn` value held in a field, called through a reference)
// kind: positive
// expect: ok
//
// `(t.less)(a, b)` where `t` is a reference to a generic struct whose
// field holds a `fn` value, and the same with a closure in the field.
// coby took the callee to be the whole struct the reference reaches, not
// the field's value, and faulted `diag.type-mismatch`. Found by
// real-world testing (a generic tree map with a comparison function).

import std;

struct Ordered<K>
{
    K key;
    fn(ref<K, shared>, ref<K, shared>) : bool less;
}

fn below<K>(ref<Ordered<K>, shared> t, ref<K, shared> k) : bool
{
    (t.less)(k, &t.key)
}

fn i64_less(ref<i64, shared> a, ref<i64, shared> b) : bool
{
    *a < *b
}

fn main()
{
    Ordered<i64> t = Ordered { .key = 5, .less = i64_less };
    i64 three = 3;
    i64 nine = 9;
    assert(below(&t, &three) && !below(&t, &nine));
    Ordered<i64> r = Ordered { .key = 5, .less = move [](ref<i64, shared> a, ref<i64, shared> b) : bool { *a > *b } };
    assert(below(&r, &nine) && !below(&r, &three));
}
