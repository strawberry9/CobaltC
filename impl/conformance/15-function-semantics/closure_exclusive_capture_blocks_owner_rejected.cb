// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Form-Borrow]; rule.value-object.read [Read-Conflict]
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// A borrow-capturing closure holds its captures as long as the closure
// object lives (D-0018). While `add` holds `total` exclusively, the
// owner may not read it.

fn main()
{
    i32 total = 0;
    auto add = [total](i32 x)
    {
        total = total + x;
    };
    add(5);
    i32 seen = total;
}
