// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure `[Closure-Call]`, `[Cmp-Text]` (D-0108) inside a closure body; conf.closure-compares-captured-string
// kind: positive
// expect: ok
//
// `==` on a `String` captured by borrow, inside the closure's body, is
// the in-place comparison of D-0108, as it is outside one. (The
// interpreter once faulted `diag.read-of-resource` here: it kept a copy
// of the closure's body, so the static pass's record that this `==` is
// a text comparison was not found at the call. Found 2026-09-30 by
// `Vec::position` with a captured key.)

import std;

fn main()
{
    String key = String::from_str("b");
    Vec<String> v = Vec::new();
    Vec::push(&mut v, String::from_str("a"));
    Vec::push(&mut v, String::from_str("b"));
    {
        auto same = [key](ref<String, shared> t) : bool { *t == key };
        assert(!same(&v[0]) && same(&v[1]));
        assert(Vec::position(&v, [key](ref<String, shared> t) : bool { *t == key }) == Some(1));
    }                                                    // same's borrow of key ends here
    auto by_move = move [key](ref<String, shared> t) : bool { *t == key };
    assert(by_move(&v[1]));
    printf("ok\n");
}
