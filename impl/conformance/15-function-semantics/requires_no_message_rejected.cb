// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.requires [Requires-Fail]; D-0317; conf.requires-no-message
// kind: negative
// expect: diag.precondition-failed (dynamic)
//
// A requirement with no message: the report names the function.

import std;

fn half(u64 x) : u64
    requires
    {
        x % 2 == 0;
    }
{
    x / 2
}

fn main()
{
    Vec<u64> v = Vec::new();
    Vec::push(&mut v, 7);
    printf("%v\n", half(v[0]));
}
