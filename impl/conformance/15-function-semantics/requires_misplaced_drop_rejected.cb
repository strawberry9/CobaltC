// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.requires [Requires-Place]; D-0317; conf.requires-misplaced-drop
// kind: negative
// expect: diag.requires-misplaced (static)
//
// A destructor is called by the language, not by a caller.

import std;

resource struct Guard
{
    u64 id;
}

fn Guard::drop(ref<Guard, exclusive> g)
    requires
    {
        g.id > 0;
    }
{
}

fn main()
{
    Guard g = Guard { .id = 1 };
}
