// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Fn-Value-Read]; rule.type.is-resource; rule.control.flow-analysis consumption row; CHG-0302; conf.owning-closure-passed-then-called
// kind: negative
// expect: diag.stale-binding (static)
//
// `mk` captured the vector by `move`, so it owns a resource and is one by
// derivation: passing it to `call_val` moves it, and calling it afterwards
// uses a moved binding. The flow analysis sees this, as it does for a struct
// holding a vector. Both tools faulted at the call instead (CHG-0302).

import std;

fn call_val(fn() : void f)
{
    f();
}

fn main()
{
    Vec<i32> v = Vec::new();
    auto mk = move [v]() { Vec::push(&mut v, 1); };
    call_val(mk);
    mk();
}
