// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: spec/15 dual bodies; conf.dual-body-bare-call
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
// expect-stdout-hex: 37333630203332300a31373238300a37333639203332330a37343631203333312031300a
//
// D-0188 functions called with disjoint owned locals (the bare form,
// D-0192): a struct and a slice of a Vec or array, an element of the Vec
// held across a call, and a slice out of bounds faulting at the call

import std;

struct Acc
{
    u64 sum;
    u64 n;
}

fn feed(ref<Acc, exclusive> a, slice<u8, shared> d)
{
    for (usize i = 0; i < slice_len(d); i += 1)
    {
        a.sum += widen<u64>(d[i]);
        a.n += 1;
    }
}

fn total(slice<u8, shared> d) : u64
{
    u64 t = 0;
    for (usize i = 0; i < slice_len(d); i += 1)
    {
        t += widen<u64>(d[i]);
    }
    t
}

fn main()
{
    Vec<u8> data = Vec::new();
    foreach (i in 0..64)
    {
        Vec::push(&mut data, narrow<u8>(i % 251));
    }
    Acc a = Acc { .sum = 0, .n = 0 };
    for (usize r = 0; r < 40; r += 1)
    {
        usize at = r;
        feed(&mut a, &data[at..at + 8]);
    }
    printf("%v %v\n", a.sum, a.n);
    u64 s = 0;
    for (usize r = 0; r < 40; r += 1)
    {
        s += total(&data[r..r + 16]);
    }
    printf("%v\n", s);
    array<u8, 5> arr = [1, 2, 3, 4, 5];
    feed(&mut a, &arr[1..4]);
    printf("%v %v\n", a.sum, a.n);
    {
        ref<u8, shared> held = &data[10];
        feed(&mut a, &data[8..16]);
        printf("%v %v %v\n", a.sum, a.n, *held);
    }
    usize bad = 70;
    feed(&mut a, &data[60..bad]);
    printf("unreached\n");
}
