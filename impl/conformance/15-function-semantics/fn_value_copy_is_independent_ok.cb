// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: [Fn-Value-Read] (D-0089); conf.fn-value-copy-independent
// kind: positive
// expect: ok
//
// A copy of a `fn` value is a copy of its closure, captures included:
// a closure that counts in a captured plain value counts separately in
// each copy. coby shared one closure between the two `fn` values, so
// the copy saw the original's counts.

import std;

fn main() : u8
{
    i32 start = 10;
    fn() : i32 f = move [start]() : i32
    {
        start += 1;
        start
    };
    if (f() != 11 || f() != 12) { return 1; }
    fn() : i32 g = f;
    if (g() != 13) { return 2; }
    if (f() != 13) { return 3; }
    0
}
