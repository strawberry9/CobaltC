// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Form-Move]; spec/14 deriv (D-0288); conf.move-closure-view-capture-blocks-owner-write
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// A `move` closure that copied a view holds what the view reached for as
// long as the closure lives: the string may not be written meanwhile,
// though the view's own binding has ended.

import std;

fn main()
{
    String a = String::from_str("a");
    StringView va = String::as_view(&a);
    auto f = move [va]() : usize { StringView::len(va) };
    String::append(&mut a, "x");
    printf("%v\n", f());
}
