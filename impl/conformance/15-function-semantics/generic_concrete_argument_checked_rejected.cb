// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.generic-call: a parameter's concrete type arguments are checked exactly (D-0006) while its type parameters are inferred; conf.generic-concrete-argument-checked
// kind: negative
// expect: diag.type-mismatch (static)
//
// `k<B>(P<String, B> p)` called with a `P<u64, i32>`: `B` is inferred
// as `i32`, and `String` against `u64` is a mismatch. (The checker once
// accepted this and the body read the `u64` field as a `String`; found
// 2026-09-30, CHG-0136.)

import std;

struct P<A, B>
{
    A a;
    B b;
}

fn k<B>(P<String, B> p) : B
{
    p.b
}

fn main()
{
    P<u64, i32> p = P { .a = 1, .b = 2 };
    i32 x = k(p);
}
