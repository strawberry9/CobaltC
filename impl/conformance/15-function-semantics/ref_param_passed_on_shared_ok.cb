// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.call: an exclusive reference parameter passed on where a shared one is wanted
// kind: positive
// expect: ok
// expect-stdout-hex: 3134203320310a
//
// `fill` takes its board exclusively and hands it to `count`, which wants
// it shared: the call reborrows it shared for its duration. (A regression
// case: the compiler once passed such a parameter no path, and the
// reborrow found none.)

import std;

struct Board
{
    array<u8, 4> cell;
}

fn count(ref<Board, shared> b, u8 v) : u8
{
    u8 n = 0;
    foreach (x in &b.cell)
    {
        if (*x == v)
        {
            n += 1;
        }
    }
    n
}

fn fill(ref<Board, exclusive> b) : u8
{
    u8 before = count(b, 0);
    foreach (i in 0..4)
    {
        b.cell[i] = narrow<u8>(i % 2);
    }
    before * 3 + count(b, 1)
}

fn main()
{
    Board b = Board { .cell = [0, 0, 0, 0] };
    u8 r = fill(&mut b);
    printf("%v %v %v\n", r, count(&b, 0) + 1, count(&b, 1) - 1);
}
