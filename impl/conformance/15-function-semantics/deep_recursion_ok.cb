// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.call (recursion)
// kind: positive
// expect: ok
//
// Recursion 20,000 calls deep, in the main thread and in a spawned one.
// coby once ran out of its host stack some ten thousand calls deep (a
// host crash), and each call's name lookup walked the whole stack, so a
// deep recursion took quadratic time.

import std;

fn depth(u64 n) : u64
{
    if (n == 0)
    {
        0
    }
    else
    {
        1 + depth(n - 1)
    }
}

fn main()
{
    auto h = spawn(depth, 20_000);
    if (depth(20_000) != 20_000 || join(h) != 20_000)
    {
        fault(index_out_of_bounds);
    }
}
