// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: spec/15 closures; conf.closure-captures-closure
// kind: positive
// expect: ok
// expect-stdout-hex: 64697265637420747275650a7772617070656420747275650a6c6f63616c20747275650a
//
// a closure returned by a function, wrapped by a move closure that calls
// it, and a local capturing closure wrapped the same way: the inner
// closure keeps its own captures (D-0193)

import std;

fn above(i64 lim) : fn(ref<i64, shared>) : bool
{
    move [lim](ref<i64, shared> r) : bool { *r > lim }
}

fn main()
{
    i64 x = 5;
    fn(ref<i64, shared>) : bool b = above(3);
    printf("direct %v\n", b(&x));
    fn(ref<i64, shared>) : bool w = move [b](ref<i64, shared> q) : bool { b(q) };
    printf("wrapped %v\n", w(&x));
    i64 lim = 4;
    fn(ref<i64, shared>) : bool c = move [lim](ref<i64, shared> r) : bool { *r > lim };
    fn(ref<i64, shared>) : bool w2 = move [c](ref<i64, shared> q) : bool { c(q) };
    printf("local %v\n", w2(&x));
}
