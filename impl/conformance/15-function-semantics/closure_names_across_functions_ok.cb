// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: spec/15 closures; conf.closure-names-across-functions
// kind: positive
// expect: ok
// expect-stdout-hex: 3720380a
//
// two functions whose first closures have different types: each is its
// own closure (cobc numbered closures per function, so their C names
// collided; D-0193)

import std;

fn a(u32 k) : u32
{
    fn(usize) : u32 f = [k](usize i) : u32 { k + narrow<u32>(i) };
    f(2)
}

fn c(u64 k) : u64
{
    fn(usize) : u64 f = [k](usize i) : u64 { k + narrow<u64>(i) };
    f(2)
}

fn main()
{
    printf("%v %v\n", a(5), c(6));
}
