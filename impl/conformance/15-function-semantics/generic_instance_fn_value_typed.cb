// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.call [T-Item-Generic] (D-0093, CHG-0438): a generic function's instance as a `fn` value keeps its type arguments; conf.generic-instance-fn-value-typed
// kind: negative
// expect: diag.arith-overflow (dynamic)
// expect-stdout-hex: 313030203132310a
//
// `sq<u8>` and `fn(u8) : u8 g = sq` are `u8` functions, so `id<u8>(255) + 1`
// overflows. `coby` called the generic body with no type arguments and
// printed `256`.

import std;

fn sq<T: number>(T a) : T
{
    a * a
}

fn id<T>(T x) : T
{
    x
}

fn main()
{
    auto f = sq<u8>;
    fn(u8) : u8 g = sq;
    auto h = id<u8>;
    printf("%v %v\n", f(10), g(11));
    printf("%v\n", h(255) + 1);
}
