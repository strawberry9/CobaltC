// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Capture-List-Rejected] (CHG-0324); conf.closure-fault-name-not-capture
// kind: positive
// expect: ok
// expect-stdout-hex: 380a
//
// The diagnostic name a `fault` call names is no variable: a closure that
// faults on purpose lists only the variables it uses, and the checker
// derives the same set. (The checker counted `assert_failed` as a free
// variable, so no capture list could be right.)

import std;

fn main()
{
    bool strict = false;
    u32 limit = 3;
    auto check = [strict, limit](u32 x) : u32
    {
        if (strict && x > limit)
        {
            fault(assert_failed, "over the limit");
        }
        x + limit
    };
    printf("%v\n", check(5));
}
