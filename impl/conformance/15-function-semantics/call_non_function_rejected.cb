// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.call [T-Call]; conf.call-non-function
// kind: negative
// expect: diag.type-mismatch (static)
//
// Only a function's name or a `fn` value is called: calling an `i32` local is
// rejected, and the message says that `x` is an `i32`, not a function.

fn main()
{
    i32 x = 1;
    x();
}
