// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.requires [Requires-Fail]; rule.fn.call [Call-Self-Tail]; D-0317; conf.requires-self-tail-fails
// kind: negative
// expect: diag.precondition-failed (dynamic)
//
// A requirement that fails on a self tail call is that tail call's: reported
// at its line.

import std;

fn count(u64 n, u64 acc) : u64
    requires
    {
        acc <= 1000, "acc %v", acc;
    }
{
    if (n == 0)
    {
        return acc;
    }
    count(n - 1, acc + 1)
}

fn main()
{
    printf("%v\n", count(2000, 0));
}
