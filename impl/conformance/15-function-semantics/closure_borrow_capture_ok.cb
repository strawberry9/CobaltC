// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure (borrow capture)
// kind: positive
// expect: ok
//
// A non-`move` closure captures its free variable by reference rather
// than by value, reading through that reference each call.

fn main()
{
    i32 x = 41;
    auto reader = [x]()
    {
        x
    };
    if (reader() != 41)
    {
        1 / (1 - 1);
    }
}
