// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.requires; rule.control.flow-analysis (the requirement row); D-0317; conf.requires-not-foldable
// kind: positive
// expect: ok
// expect-stdout-hex: 340a330a
//
// A requirement the static pass cannot fold (it calls a function) is left to
// the run, whatever the arguments: being foldable is not being valid. A
// fold that would overflow its type is left to the run too.

import std;

fn even(u64 x) : bool
{
    x % 2 == 0
}

fn half(u64 x) : u64
    requires
    {
        even(x);
    }
{
    x / 2
}

fn wide(u8 a) : u8
    requires
    {
        a * 2 > 0;
    }
{
    a
}

fn main()
{
    printf("%v\n", half(8));
    printf("%v\n", wide(3));
}
