// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.return; rule.control.unwind
// kind: positive
// expect: ok
//
// `return v;` from inside a nested block hands v's resource to the
// caller: the frames it leaves must not destroy it. And a call that
// returns a plain enum held in a local can be matched on directly. coby
// once destroyed the returned Vec on the way out, and could not match on
// the enum value.

import std;

fn check(bool ok)
{
    i32 z = if (ok)
    {
        1
    }
    else
    {
        0
    };
    1 / z;
}

fn keep_small(Vec<u64> v) : Vec<u64>
{
    if (Vec::len(&v) < 2)
    {
        return v;
    }
    Vec::pop(&mut v);
    v
}

fn pick(bool b) : Option<i32>
{
    Option<i32> x = if (b) { Some(7) } else { None };
    x
}

fn main()
{
    Vec<u64> one = Vec::new();
    Vec::push(&mut one, 5);
    Vec<u64> back = keep_small(one);
    check(Vec::len(&back) == 1);
    match (pick(true))
    {
        Some(v) : check(v == 7),
        None : check(false),
    }
}
