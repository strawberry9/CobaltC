// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: [T-Call] (conf.call-too-many-args)
// kind: negative
// expect: diag.type-mismatch (static)
//
// A call passes exactly one argument per parameter. An extra argument
// is a type error before the program runs, not an argument silently
// ignored.

fn f(i32 a) : i32
{
    a
}

fn main()
{
    f(1, 2);
}
