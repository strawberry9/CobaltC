// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.call
// kind: positive
// expect: ok
//
// Ordinary recursive calls work: each call gets its own frame.

fn fact(i32 n) : i32
{
    if (n <= 1)
    {
        1
    }
    else
    {
        n * fact(n - 1)
    }
}

fn main()
{
    if (fact(5) != 120)
    {
        1 / (1 - 1);
    }
}
