// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: [Closure-Form-Borrow] (spec/15 §6; CHG-0439): a capture without `move` moved out in the body; conf.borrow-capture-moved
// kind: negative
// expect: diag.move-while-aliased (static)
//
// Moving a field of a borrowed capture is moving out of what the closure
// only borrows.

import std;

struct P
{
    String a;
}

fn take(String s)
{
    printf("%s\n", &s);
}

fn main()
{
    P p = P { .a = "x" };
    auto f = [p]()
    {
        take(p.a);
    };
    f();
}
