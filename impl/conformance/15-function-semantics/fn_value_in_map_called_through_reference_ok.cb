// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.call (a `fn` value kept in a `HashMap`, called through the reference `get` gives)
// kind: positive
// expect: ok
//
// A command table: `fn` values, one of them a closure, as a map's values,
// called as `(*f)(x)` with `f` the `ref` that `HashMap::get` returns.
// coby took the callee to be the whole object behind the reference, not
// the value in the map's storage, and faulted `diag.type-mismatch`. Found
// by real-world testing (a command dispatcher).

import std;

fn inc(i64 x) : i64
{
    x + 1
}

fn dbl(i64 x) : i64
{
    x * 2
}

fn main()
{
    HashMap<String, fn(i64) : i64> cmds = HashMap::new();
    HashMap::insert(&mut cmds, String::from_str("inc"), inc);
    HashMap::insert(&mut cmds, String::from_str("dbl"), dbl);
    i64 k = 10;
    HashMap::insert(&mut cmds, String::from_str("add"), move [k](i64 x) : i64 { x + k });
    i64 acc = 1;
    foreach (name in ["inc", "dbl", "add", "dbl"])
    {
        String key = String::from_str(name);
        match (HashMap::get(&cmds, &key))
        {
            Some(f) : { acc = (*f)(acc); },
            None    : {},
        }
    }
    assert(acc == 28);
}
