// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.requires [Requires-Fail]; D-0317; conf.requires-fails-in-std-callback
// kind: negative
// expect: diag.precondition-failed (dynamic)
//
// A requirement of a function `std` calls back fails: the fault is located
// at the program's call of `std` (`Vec::retain`), not in the function's
// body, where its last call left the position (bug 036).

import std;

fn keep(ref<i64, shared> x) : bool
    requires
    {
        *x != 3;
    }
{
    true
}

fn main()
{
    Vec<i64> v = Vec::from_slice(&[1: i64, 2, 3]);
    Vec::retain(&mut v, keep);
    printf("%v\n", Vec::len(&v));
}
