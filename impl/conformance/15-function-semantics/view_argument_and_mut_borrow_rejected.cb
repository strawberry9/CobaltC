// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.call [Call]; D-0107; D-0179; conf.view-arg-not-pending
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// The view `&s` gives where a `StringView` is declared holds a shared path
// to `s`; it is a value the first argument computed, not a borrow it forms, so it is
// not pending (D-0179), and forming `&mut s` for the second argument
// meets it.
//
// D-0282: the static pass rejects this program before it runs (it was found
// at run time before): `peek` reads `s` through argument 1, which argument
// 2 reaches exclusively.

import std;

fn peek(StringView v, ref<String, exclusive> s) : usize
{
    usize n = StringView::len(v);
    overwrite(s, "a longer replacement");
    n
}

fn main()
{
    String s = "short";
    printf("%v\n", peek(&s, &mut s));
}
