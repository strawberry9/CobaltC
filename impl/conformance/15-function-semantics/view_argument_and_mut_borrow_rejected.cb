// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.call [Call]; D-0107; D-0179; conf.view-arg-not-pending
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// The view `String::as_view(&s)` returns holds a shared path to `s`; it is
// a value the first argument computed, not a borrow it forms, so it is
// not pending (D-0179), and forming `&mut s` for the second argument
// meets it.

import std;

fn peek(StringView v, ref<String, exclusive> s) : usize
{
    usize n = StringView::len(v);
    overwrite(s, String::from_str("a longer replacement"));
    n
}

fn main()
{
    String s = String::from_str("short");
    printf("%v\n", peek(String::as_view(&s), &mut s));
}
