// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.generic-call [Generic-Instantiation-Unbounded]; conf.generic-instantiation-doubling
// kind: negative
// expect: diag.instantiation-unbounded (static)
//
// `f<T>` calls itself with a `Two<T, T>`, so its type argument doubles in
// size at each step (`Two<Two<u8, u8>, Two<u8, u8>>`, …): the size limit
// rejects it while it is still far shallower than the depth limit.

import std;

struct Two<A, B>
{
    A a;
    B b;
}

fn f<T>(T x, u32 n) : u32
{
    if (n == 0)
    {
        0
    }
    else
    {
        f(Two { .a = x, .b = x }, n - 1) + 1
    }
}

fn main() : u8
{
    printf("%v\n", f(1: u8, 3));
    0
}
