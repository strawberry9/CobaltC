// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.requires [Requires]; D-0317; conf.requires-fault-in-requirement
// kind: negative
// expect: diag.arith-overflow (dynamic)
//
// A fault while a requirement is evaluated is that fault, where it happens:
// no requirement failed.

import std;

fn fits(u8 a, u8 b) : u8
    requires
    {
        a + b < 200;
    }
{
    a
}

fn main()
{
    Vec<u8> v = Vec::new();
    Vec::push(&mut v, 250);
    printf("%v\n", fits(v[0], v[0]));
}
