// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.generic-call [Generic-Call-Inferred] (D-0079); conf.literal-argument-typed-by-other-argument; conf.literal-argument-typed-by-expected-type; conf.literal-arguments-only-default
// kind: positive
// expect: ok
//
// An unsuffixed literal argument is typed by its parameter after the
// other arguments and the expected type have fixed the type parameters.
// It fixes a type parameter itself only when nothing else does.

import std;

fn pick<T>(bool first, T a, T b) : T
{
    if (first) { a } else { b }
}

fn fold<T, A>(ref<Vec<T>, shared> v, A init, fn(A, ref<T, shared>) : A step) : A
{
    A acc = init;
    foreach (x in v)
    {
        acc = step(acc, x);
    }
    acc
}

fn middle<T>(T a, T b, T c) : T
{
    b
}

fn main()
{
    i64 x = -5;
    i64 m = pick(true, 0, x);
    u8 small = pick(true, 200, 3: u8);
    Vec<i64> v = Vec::new();
    Vec::push(&mut v, 4000000000);
    Vec::push(&mut v, 1);
    i64 s = fold(&v, 0, [](i64 a, ref<i64, shared> e) { a + *e });
    u64 total = fold(&v, 7, [](u64 a, ref<i64, shared> e) { a + 1 });
    auto k = pick(false, 3, 4);
    i32 k32 = k;
    f32 f = middle(1.5, 2.5: f32, -0.5);
    u16 w = middle(1, 60000, 3);
    assert(m == 0 && small == 200 && s == 4000000001 && total == 9 && k32 == 4 && f == 2.5 && w == 60000,
        "%v %v %v %v %v %v %v", m, small, s, total, k32, f, w);
}
