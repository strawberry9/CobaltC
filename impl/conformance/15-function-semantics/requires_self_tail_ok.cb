// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.requires; rule.fn.call [Call-Self-Tail] (spec/15 §2a); D-0317; conf.requires-self-tail
// kind: positive
// expect: ok
// expect-stdout-hex: 333030303030300a
//
// A function with a requirement still makes self tail calls: each is a call
// and checks it, and the depth costs no stack.

import std;

fn count(u64 n, u64 acc) : u64
    requires
    {
        acc <= 5000000;
    }
{
    if (n == 0)
    {
        return acc;
    }
    count(n - 1, acc + 1)
}

fn main()
{
    printf("%v\n", count(3000000, 0));
}
