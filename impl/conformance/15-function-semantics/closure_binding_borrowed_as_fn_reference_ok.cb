// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Call] (CHG-0100); spec/08 [Read-Fn-Through-Shared] (D-0218, CHG-0257); conf.closure-binding-borrowed-as-fn-reference
// kind: positive
// expect: ok
//
// A closure held in an `auto` binding, borrowed as `ref<fn(…) : R, m>`
// and called through the reference (`(*f)(x)`), with and without
// captures. cobc passed the address of the closure's own storage where
// the callee reads a `fn` value, and the call crashed; a borrowed
// closure binding is now held as a `fn` value. Found by real-world
// testing (a tree walker taking its visitor by reference). A closure that
// writes what it captured is called through an exclusive reference: through
// a shared one it would write what that reference reaches (D-0218,
// `conf.shared-closure-binding-exclusive-capture`).

import std;

fn apply_all(ref<fn(i32) : i32, shared> f, i32 n) : i32
{
    i32 acc = 0;
    i32 i = 0;
    while (i < n) { acc += (*f)(i); i += 1; }
    acc
}

fn apply_all_mut(ref<fn(i32) : i32, exclusive> f, i32 n) : i32
{
    i32 acc = 0;
    i32 i = 0;
    while (i < n) { acc += (*f)(i); i += 1; }
    acc
}

fn main() : u8
{
    auto square = move [](i32 x) : i32 { x * x };
    if (apply_all(&square, 4) != 14) { return 1; }
    i32 offset = 10;
    i32 calls = 0;
    {
        auto shifted = [offset, calls](i32 x) : i32 { calls += 1; x + offset };
        if (apply_all_mut(&mut shifted, 3) != 33) { return 2; }
        if (shifted(1) != 11) { return 3; }
    }
    if (calls != 4) { return 4; }
    0
}
