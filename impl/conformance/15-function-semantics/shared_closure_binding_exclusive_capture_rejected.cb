// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: conf.shared-closure-binding-exclusive-capture; spec/08 [Read-Fn-Through-Shared] (D-0218, CHG-0257)
// kind: negative
// expect: diag.borrow-exceeds-source (dynamic)
//
// A closure binding borrowed as `ref<fn(…) : R, shared>` and called through
// it (`(*f)(x)`): the closure writes `calls`, which it captured, so the call
// would write through a shared reference. Taking the visitor as
// `ref<fn(…) : R, exclusive>` is the way to call a closure that writes.

import std;

fn apply_all(ref<fn(i32) : i32, shared> f, i32 n) : i32
{
    i32 acc = 0;
    i32 i = 0;
    while (i < n)
    {
        acc += (*f)(i);
        i += 1;
    }
    acc
}

fn main()
{
    i32 calls = 0;
    {
        auto counted = [calls](i32 x) : i32 { calls += 1; x };
        printf("%v\n", apply_all(&counted, 3));
    }
    printf("%v\n", calls);
}
