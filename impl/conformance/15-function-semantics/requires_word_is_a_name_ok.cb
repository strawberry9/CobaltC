// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: spec/22 requires; D-0317; conf.requires-word-is-a-name
// kind: positive
// expect: ok
// expect-stdout-hex: 330a350a
//
// `requires` is a contextual word: a name anywhere else.

import std;

fn requires(u64 x) : u64
{
    x + 1
}

fn main()
{
    printf("%v\n", requires(2));
    u64 requires = 5;
    printf("%v\n", requires);
}
