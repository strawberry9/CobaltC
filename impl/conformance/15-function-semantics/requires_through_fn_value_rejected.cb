// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.requires [Requires-Fail]; D-0317; conf.requires-through-fn-value
// kind: negative
// expect: diag.precondition-failed (dynamic)
//
// The check is the function's: a call through a `fn` value makes it too,
// reported at that call.

import std;

fn half(u64 x) : u64
    requires
    {
        x % 2 == 0, "%v is odd", x;
    }
{
    x / 2
}

fn main()
{
    fn(u64) : u64 g = half;
    Vec<u64> v = Vec::new();
    Vec::push(&mut v, 8);
    Vec::push(&mut v, 7);
    printf("%v\n", g(v[0]));
    printf("%v\n", g(v[1]));
}
