// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: [Call-Self-Tail] (D-0309; CHG-0439): a self tail call handing a view parameter on; conf.self-tail-view-argument-ends
// kind: positive
// expect: ok
// stdout: true
//
// The view `name` is the argument again; the text it views ends at
// `main`'s end, after every frame of `count`. `coby` kept the copy it made
// for the argument held, and faulted when `n` was destroyed.

import std;

fn count(i32 k, StringView name) : bool
{
    if (k > 0) { count(k - 1, name) } else { StringView::len(name) == 1 }
}

fn main()
{
    String n = "r";
    printf("%v\n", count(1, &n));
}
