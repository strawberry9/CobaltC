// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.alias.read-through-shared [Read-Fn-Through-Shared]; [Closure-Call] writes-self; D-0218, D-0239; conf.move-closure-writing-capture-through-shared
// kind: negative
// expect: diag.borrow-exceeds-source (dynamic)
//
// `call_it` is given a shared reference to a `fn` value whose closure
// writes a value it captured by `move`. Calling it would change what the
// shared reference reaches, so `[Read-Fn-Through-Shared]` faults (D-0239).

import std;

fn call_it(ref<fn() : i32, shared> f) : i32
{
    (*f)()
}

fn main()
{
    i32 n0 = 0;
    fn() : i32 c = move [n0]() : i32
    {
        n0 = n0 + 1;
        n0
    };
    printf("%v\n", call_it(&c));
    printf("%v\n", c());
}
