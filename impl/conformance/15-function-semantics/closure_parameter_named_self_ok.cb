// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Call]; conf.closure-parameter-named-self
// kind: positive
// expect: ok
// expect-stdout-hex: 320a333632383830300a
//
// `self` is an ordinary name: a closure's parameter may have it, as a
// function's may, and it is not the closure's own captures.

import std;

fn fix(fn(fn(u64) : u64, u64) : u64 f, u64 n) : u64
{
    f([f](u64 m) { fix(f, m) }, n)
}

fn main()
{
    auto f = [](i64 self) { self + 1 };
    printf("%v\n", f(1));
    printf("%v\n", fix([](fn(u64) : u64 self, u64 n) { if (n < 2) { 1 } else { n * self(n - 1) } }, 10));
}
