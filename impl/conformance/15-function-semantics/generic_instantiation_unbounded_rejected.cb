// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.generic-call [Generic-Instantiation-Unbounded]; CHG-0357; conf.generic-instantiation-unbounded
// kind: negative
// expect: diag.instantiation-unbounded (static)
//
// `deep<T>` calls itself with a `Box<T>`, so `deep<i32>` needs
// `deep<Box<i32>>`, which needs `deep<Box<Box<i32>>>`, and so on without
// end, however small `n` is when the program runs. The program is
// rejected statically; it is never accepted with part of it unchecked.

import std;

fn deep<T>(T x, u32 n) : u32
{
    if (n == 0)
    {
        return 0;
    }
    Box<T> b = Box::new(x);
    deep(b, n - 1) + 1
}

fn main() : u8
{
    printf("%v\n", deep(1, 3));
    0
}
