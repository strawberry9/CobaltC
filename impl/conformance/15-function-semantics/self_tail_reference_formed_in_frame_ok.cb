// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: [Call-Self-Tail] (D-0309; CHG-0439): a self tail call whose reference argument the ending frame forms, in a program whose caller keeps its paths; conf.self-tail-reference-formed-in-frame
// kind: positive
// expect: ok
// stdout: true
//
// `Box::get(x)` borrows what the parameter reaches, which outlives the
// frame. `walk` leaves a reference to the run (`q`), so `cobc` records
// paths there: the borrow was the ending statement's, and ended before the
// body ran again (`diag.stale-binding` on a valid program).

import std;

enum E
{
    Leaf(i32),
    Deref(Box<E>),
}

fn root_is(ref<E, shared> e, StringView name) : bool
{
    match (e)
    {
        E::Leaf(v)  : *v == narrow<i32>(StringView::len(name)),
        E::Deref(x) : root_is(Box::get(x), name),
    }
}

fn walk(ref<E, shared> e, StringView name) : bool
{
    i32 z = 0;
    ref<i32, shared> q = &z;
    {
        i32 y = 1;
        bool c = StringView::len(name) > 5;
        ref<i32, shared> t = &z;
        if (c)
        {
            t = &y;
        }
        q = t;
    }
    root_is(e, name)
}

fn main()
{
    E e = E::Deref(Box::new(E::Deref(Box::new(E::Leaf(1)))));
    String n = "r";
    printf("%v\n", walk(&e, &n));
}
