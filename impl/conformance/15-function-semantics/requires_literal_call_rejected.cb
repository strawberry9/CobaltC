// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.requires; rule.control.flow-analysis (the requirement row); D-0317; conf.requires-literal-call
// kind: negative
// expect: diag.precondition-failed (static)
//
// A requirement that the call's literal arguments make false rejects the
// program before it runs, at the call.

import std;

fn withdraw(u64 balance, u64 amount) : u64
    requires
    {
        amount <= balance, "too much";
    }
{
    balance - amount
}

fn main()
{
    printf("%v\n", withdraw(5, 9));
}
