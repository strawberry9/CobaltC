// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Callable-Closure] (D-0073); conf.closure-returns-closure-fn-value
// kind: positive
// expect: ok
// expect-stdout-hex: 360a350a34320a31302031312031320a370a
//
// A closure whose result is a `fn` value, called through a `fn` value: the
// closure literal it gives is that `fn` value, whether the outer closure is
// a function's result, a typed binding, gives an `Option` of one, or is a
// library callback's result.

import std;

fn adder(i64 n) : fn(i64) : fn(i64) : i64
{
    move [n](i64 m) { move [n, m](i64 k) { n + m + k } }
}

fn main()
{
    printf("%v\n", adder(1)(2)(3));
    fn(i64) : fn(i64) : i64 f = move [](i64 m) { move [m](i64 k) { m + k } };
    fn(i64) : i64 g = f(2);
    printf("%v\n", g(3));
    fn(bool) : Option<fn(i64) : i64> pick = [](bool b)
    {
        if (b)
        {
            Some([](i64 x) { x + 1 })
        }
        else
        {
            None
        }
    };
    match (pick(true))
    {
        Some(h) : printf("%v\n", h(41)),
        None    : printf("none\n"),
    }
    i64 base = 10;
    Vec<fn() : i64> fs = Vec::from_fn(3, move [base](usize i)
    {
        i64 j = widen<i64>(narrow<u8>(i));
        move [base, j]() { base + j }
    });
    printf("%v %v %v\n", fs[0](), fs[1](), fs[2]());
    auto curried = move [base](i64 a) { move [base, a](i64 b) { a + b - base } };
    printf("%v\n", curried(8)(9));
}
