// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure (spec/15 §6), [Propagate-Option-Mismatch] (spec/18; CHG-0439): `?` in a closure whose body gives no result; conf.closure-question-in-unit-body
// kind: negative
// expect: diag.propagate-outside-fallible-context (static)
//
// The closure has no written result type, so its body's type is the
// closure's: `()`. `?` on an `Option` returns from the closure, which must
// return an `Option`. It was accepted, and `coby` returned `None` from a
// closure of no result.

import std;

fn f() : Option<i32>
{
    Option<i32> o = None;
    auto c = [o]()
    {
        i32 v = o?;
        printf("in %v\n", v);
    };
    c();
    Some(1)
}

fn main()
{
    match (f())
    {
        Some(v) : printf("%v\n", v),
        None    : printf("none\n"),
    }
}
