// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.requires [Requires]; D-0317; conf.requires-holds
// kind: positive
// expect: ok
// expect-stdout-hex: 370a31320a
//
// Requirements that hold do nothing more, checked in order: the second
// relies on the first (its subtraction cannot overflow once the first has
// held).

import std;

fn inset(u64 width, u64 margin) : u64
    requires
    {
        margin <= width, "margin %v is wider than %v", margin, width;
        width - margin >= 2;
    }
{
    width - margin
}

fn main()
{
    Vec<u64> v = Vec::new();
    Vec::push(&mut v, 10);
    printf("%v\n", inset(v[0], 3));
    printf("%v\n", inset(v[0] + 2, 0));
}
