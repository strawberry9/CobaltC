// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.requires; rule.control.flow-analysis (the requirement row); rule.stdlib.waiting [Barrier-Zero-Parties]; D-0317; conf.requires-std-literal
// kind: negative
// expect: diag.precondition-failed (static)
//
// `std`'s requirements are held against a program's calls as the program's
// own are: `Barrier::new(0)` can never be made.

import std;

fn main()
{
    Barrier b = Barrier::new(0);
    _ = Barrier::wait(&b);
}
