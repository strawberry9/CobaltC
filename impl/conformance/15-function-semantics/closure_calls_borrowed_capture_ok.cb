// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Form-Borrow] [Closure-Call]; conf.closure-calls-borrowed-capture
// kind: positive
// expect: ok
// expect-stdout-hex: 3130203320310a
//
// A closure without `move` borrows what it captures: calling a captured
// `fn` value or a captured closure goes through that borrow.

import std;

fn main()
{
    fn(i64) : i64 inc = [](i64 s) : i64 { s + 1 };
    auto twice = [inc](i64 x) : i64 { inc(x) * 2 };
    auto less = [](i64 a, i64 b) : bool { a < b };
    Vec<i64> v = Vec::new();
    Vec::push(&mut v, 3);
    Vec::push(&mut v, 1);
    Vec::sort_by(&mut v, [less](ref<i64, shared> a, ref<i64, shared> b) { less(*a, *b) });
    printf("%d %d %d\n", twice(4), v[1], v[0]);
}
