// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Form-Move]
// kind: positive
// expect: ok
//
// A move closure capturing a variable of reference type owns a copy of
// the reference; `*r` in the body dereferences it as usual.

fn main()
{
    i32 x = 1;
    ref<i32, shared> r = &x;
    auto f = move [r]()
    {
        *r
    };
    if (f() != 1)
    {
        1 / (1 - 1);
    }
}
