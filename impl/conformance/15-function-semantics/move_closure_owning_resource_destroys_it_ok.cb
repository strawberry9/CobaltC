// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.type.is-resource (a closure capturing a resource is one); rule.resauth.destroy-composite
// kind: positive
// expect: ok
//
// A move closure that owns a resource is itself a resource: when it is
// destroyed — at its binding's block exit, or at the end of the statement
// that calls it as a temporary — the captured resource's destructor runs.

resource struct Flagger
{
    ref<i32, exclusive> flag;
}

fn Flagger::drop(ref<Flagger, exclusive> self)
{
    *self.flag = *self.flag + 1;
}

fn main()
{
    i32 dropped = 0;
    {
        auto f = Flagger { .flag = &mut dropped };
        auto c = move [f]()
        {
            *f.flag + 7                   // dropped is still 0 here
        };
        if (c() != 7)
        {
            1 / (1 - 1);
        }
    }                                 // c ends here, and with it f
    if (dropped != 1)
    {
        1 / (1 - 1);
    }
    {
        auto g = Flagger { .flag = &mut dropped };
        i32 v = (move [g]()
        {
            *g.flag + 8                   // dropped is 1 here
        })();                         // the called temporary ends with this statement
        if (v != 9)
        {
            1 / (1 - 1);
        }
    }
    if (dropped != 2)
    {
        1 / (1 - 1);
    }
}
