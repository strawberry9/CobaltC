// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Form-Borrow], [Closure-Call]
// kind: positive
// expect: ok
//
// A closure whose body writes a captured variable captures it by
// exclusive reference, and the write goes through that reference
// ([Closure-Call]: the body's `total` means `*self.f_i`). This used to
// be rejected as diag.aliasing-conflict: the captured name was bound
// to the referent directly, so the body's write found the closure's
// own capture reference as a conflicting live exclusive path.

import std;

fn main()
{
    i32 total = 0;
    {
        auto add = [total](i32 x)
        {
            total = total + x;
        };
        add(5);
        add(7);
    }
    if (total != 12)
    {
        1 / (1 - 1);
    }
    Vec<i32> v = Vec::new();
    {
        auto pusher = [v](i32 x)
        {
            Vec::push(&mut v, x);
        };
        pusher(1);
        pusher(2);
    }
    if (Vec::len(&v) != 2)
    {
        1 / (1 - 1);
    }
}
