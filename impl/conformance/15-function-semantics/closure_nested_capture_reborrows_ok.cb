// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Form-Borrow] (nested closure, capture mode derived through the nested literal)
// kind: positive
// expect: ok
//
// An inner closure that writes a variable captured by the outer one
// reborrows the outer capture exclusively; the outer capture mode is
// derived from the whole body text, nested literal included.

fn main()
{
    i32 total = 0;
    {
        auto outer = [total]()
        {
            auto inner = [total]()
            {
                total = total + 1;
            };
            inner();
            inner();
        };
        outer();
        outer();
    }
    if (total != 4)
    {
        1 / (1 - 1);
    }
}
