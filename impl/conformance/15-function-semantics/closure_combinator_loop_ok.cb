// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: spec/15 closures, D-0089; conf.closure-combinator-loop
// kind: positive
// expect: ok
// expect-stdout-hex: 7374657020300a7374657020310a747275650a
//
// a fn local reassigned in a loop to a closure capturing its previous
// value and a fresh closure owning a String, then called (D-0193)

import std;

fn always(ref<i64, shared> r) : bool
{
    true
}

fn above(String lim) : fn(ref<i64, shared>) : bool
{
    move [lim](ref<i64, shared> r) : bool { *r > narrow<i64>(String::len(&lim)) }
}

fn both(fn(ref<i64, shared>) : bool a, fn(ref<i64, shared>) : bool b) : fn(ref<i64, shared>) : bool
{
    move [a, b](ref<i64, shared> r) : bool { a(r) && b(r) }
}

fn main()
{
    u32 mode = 0;
    if (arg_count() > 0)
    {
        mode = Result::unwrap(String::parse<u32>(&Result::unwrap(arg(0))));
    }
    fn(ref<i64, shared>) : bool keep = always;
    usize k = 0;
    while (k < 2)
    {
        fn(ref<i64, shared>) : bool c = above(String::from_str("abc"));
        keep = both(keep, c);
        printf("step %v\n", k);
        k += 1;
    }
    i64 x = 5;
    if (mode == 0)
    {
        printf("%v\n", keep(&x));
    }
    else
    {
        Vec<i64> v = Vec::from_fn(8, [](usize i) : i64 { narrow<i64>(i) });
        Vec::retain(&mut v, keep);
        printf("%v\n", Vec::len(&v));
    }
}
