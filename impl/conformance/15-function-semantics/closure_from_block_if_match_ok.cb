// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Callable-Closure] (D-0073); conf.closure-from-block-if-match
// kind: positive
// expect: ok
// expect-stdout-hex: 360a320a3130310a320a320a
//
// A block, `if` or `match` whose value is a closure, bound with `auto`: one
// closure, two closures of different types, or a closure and a function.
// Each is the `fn` value of the closure's signature.

import std;

fn dec(i64 x) : i64
{
    x - 1
}

fn main()
{
    i64 k = 2;
    auto f = {
        i64 j = 3;
        move [k, j](i64 x) { x + k + j }
    };
    printf("%v\n", f(1));
    auto g = if (arg_count() == 0) { [](i64 x) { x + 1 } } else { [](i64 x) { x - 1 } };
    printf("%v\n", g(1));
    i64 c = 100;
    auto h = if (arg_count() == 0) { move [c](i64 x) { x + c } } else { move [k](i64 x) { x + k } };
    printf("%v\n", h(1));
    auto m = match (arg_count())
    {
        0 : move [k](i64 x) { x + k - 1 },
        _ : move [k](i64 x) { x - k },
    };
    printf("%v\n", m(1));
    auto n = if (arg_count() == 0) { [](i64 x) { x + 1 } } else { dec };
    printf("%v\n", n(1));
}
