// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure (D-0081); [T-Closure]; conf.closure-result-type-conflict
// kind: negative
// expect: diag.type-mismatch (static)
//
// Where a `fn(…) : bool` is expected, a closure whose result is written
// `i32` does not fit; the message names both types.

import std;

fn main()
{
    Vec<i64> v = Vec::new();
    Vec::sort_by(&mut v, [](ref<i64, shared> a, ref<i64, shared> b) : i32 { 0 });
}
