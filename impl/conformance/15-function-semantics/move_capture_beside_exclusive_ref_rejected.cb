// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Form-Move]; spec/05 [Read]; CHG-0301; conf.move-capture-beside-exclusive-ref
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// A `move` closure copies the value it captures: a read of `x`, while `w`
// holds an exclusive reference to `x`. The read meets that reference. Before
// CHG-0301 coby took the copy without the check (cobc always checked it), so
// the closure saw `x` while another path could change it.

import std;

fn main()
{
    i32 x = 1;
    Vec<ref<i32, exclusive>> w = Vec::new();
    Vec::push(&mut w, &mut x);
    auto next = move [x]() : i32 { x = x + 1; x };
    printf("%v\n", next());
    *w[0] = 5;
}
