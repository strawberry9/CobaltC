// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.generic-call [Generic-Call-Arity] (CHG-0100); conf.generic-call-extra-type-arguments-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// A program's own `parse` (it hid `std`'s `parse` until D-0134 made that
// `String::parse`). `parse<i64>(&s)` names the program's, which takes no
// type arguments; they were ignored,
// and the call quietly ran the wrong function. Found by real-world
// testing (an INI loader whose parser was named `parse`).

import std;

fn parse(ref<String, shared> s) : usize
{
    String::len(s)
}

fn main()
{
    String t = "12";
    i64 v = parse<i64>(&t);
}
