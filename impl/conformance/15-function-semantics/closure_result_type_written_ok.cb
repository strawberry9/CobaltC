// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure (D-0081); [T-Closure]; conf.closure-result-type-written
// kind: positive
// expect: ok
//
// A written result type is what the body is checked against: the `0`
// is an `i64`, the `a + 250` a `u8` whose overflow is checked as one,
// and a `String` result is resolved like any type name.

import std;

fn main()
{
    auto zero = [](i64 a) : i64 { 0 };
    auto near = [](u8 a) : Option<u8> { checked_add(a, 250) };
    auto name = move [](i64 n) : String
    {
        String s = "n";
        String::append(&mut s, n);
        s
    };
    Vec<i64> v = Vec::new();
    Vec::push(&mut v, 3);
    Vec::push(&mut v, 1);
    Vec::sort_by(&mut v, [](ref<i64, shared> a, ref<i64, shared> b) : bool { *a < *b });
    assert(zero(5000000000) == 0 && Option::is_none(&near(9)) && Option::is_some(&near(5)), "results");
    assert(String::eq_str(&name(7), "n7") && v[0] == 1, "name and sort");
}
