// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.requires; rule.control.flow-analysis (the requirement row); D-0317; conf.requires-literal-bound
// kind: negative
// expect: diag.precondition-failed (static)
//
// A literal-bound local is known as a literal is: the second requirement
// folds to false over `k` (the first holds).

import std;

fn pick(u32 k, u32 n) : u32
    requires
    {
        n > 0;
        k < n * 2;
    }
{
    k % n
}

fn main()
{
    u32 k = 9;
    printf("%v\n", pick(k, 4));
}
