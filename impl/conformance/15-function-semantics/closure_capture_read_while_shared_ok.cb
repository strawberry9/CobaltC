// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure spec/14 deriv (CHG-0100); conf.closure-capture-written-while-held-rejected
// kind: positive
// expect: ok
//
// The other side of spec/14's closure facts: a closure that only reads
// its capture borrows it shared, so the capture may still be read, and
// once the closure's block ends the capture may be written again.

import std;

fn main() : u8
{
    i32 base = 5;
    i32 seen = 0;
    {
        auto plus = [base](i32 x) : i32 { x + base };
        seen = plus(1) + base;
    }
    base = 7;
    auto twice = [base](i32 x) : i32 { x * 2 + base };
    if (seen != 11 || twice(1) != 9) { return 1; }
    0
}
