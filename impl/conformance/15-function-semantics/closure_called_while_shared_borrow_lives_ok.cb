// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure ([Closure-Call] borrows the closure shared, D-0221, CHG-0260); conf.closure-called-while-shared-borrow-lives
// kind: positive
// expect: ok
// stdout: 11
// stdout: 12
// stdout: 13
// stdout: 5
//
// A call borrows the closure shared (D-0221): `add` is called while `s`, a
// shared borrow of it, lives, and through `s`, since it holds no exclusive
// capture; `bump` writes its capture `total` and is called while a shared
// borrow of it lives. The writes go through the exclusive capture path,
// which is checked as any reference's is. By the text before D-0221 (an
// exclusive self-borrow) each of these calls was rejected; both tools
// always accepted them (D-0219 finding 7).

import std;

fn apply(ref<fn(i32) : i32, shared> f, i32 v) : i32
{
    (*f)(v)
}

fn main()
{
    i32 base = 10;
    auto add = [base](i32 y) { base + y };
    auto s = &add;
    printf("%v\n", add(1));
    printf("%v\n", apply(s, 2));
    printf("%v\n", add(3));
    i32 total = 0;
    {
        auto bump = [total](i32 y) : void { total += y; };
        auto b = &bump;
        bump(5);
        _ = b;
    }
    printf("%v\n", total);
}
