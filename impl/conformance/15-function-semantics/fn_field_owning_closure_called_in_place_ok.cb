// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Call] through a `fn` value held in a struct field, the closure owning a resource
// kind: positive
// expect: ok
//
// A job is a struct whose `fn() : u64` field holds a `move` closure that
// owns a `Vec`; `(t.run)()` calls it where it is. cobc read the field as
// a value first, which for a box whose closure owns a resource is a read
// of a resource (`diag.read-of-resource`, dynamic); a binding holding
// the same value was already called in place. Found by real-world testing
// (a thread pool whose jobs are closures).

import std;

struct Task
{
    usize id;
    fn() : u64 run;
}

fn run_it(ref<Task, shared> t) : u64
{
    (t.run)()
}

fn main()
{
    Vec<u64> data = Vec::new();
    Vec::push(&mut data, 4);
    Vec::push(&mut data, 5);
    Task t = Task { .id = 1, .run = move [data]() : u64 { u64 s = 0; foreach (x in &data) { s += *x; } s } };
    assert((t.run)() == 9);
    assert(run_it(&t) == 9);
    array<Task, 1> ts = [t];
    assert((ts[0].run)() == 9);
}
