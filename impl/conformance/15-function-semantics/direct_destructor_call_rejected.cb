// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: spec/07 §1 (diag.direct-destructor-call)
// kind: negative
// expect: diag.direct-destructor-call (static)
//
// A destructor is only ever run by [Destroy]; calling `T::drop`
// directly is ill-formed. `drop(x)` is the intrinsic.

resource struct R
{
    i32 v;
}

fn R::drop(ref<R, exclusive> self)
{
}

fn main()
{
    R r = R { .v = 1 };
    R::drop(&mut r);
}
