// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.requires [Requires-Fail]; D-0317; conf.requires-through-spawn
// kind: negative
// expect: diag.precondition-failed (dynamic)
//
// A spawned function's call is its `spawn`: a requirement that does not
// hold is reported there.

import std;

fn half(u64 x) : u64
    requires
    {
        x % 2 == 0;
    }
{
    x / 2
}

fn main()
{
    Vec<u64> v = Vec::new();
    Vec::push(&mut v, 7);
    auto h = spawn(half, v[0]);
    printf("%v\n", join(h));
}
