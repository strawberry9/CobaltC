// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.generic-call [Generic-Call-Inferred] (D-0079); rule.arith.literal; conf.literal-argument-out-of-range-for-inferred-type
// kind: negative
// expect: diag.literal-out-of-range (static)
//
// `x` fixes `T` as `u8`, so the literal is a `u8`, and 300 does not fit.

import std;

fn pick<T>(bool first, T a, T b) : T
{
    if (first) { a } else { b }
}

fn main()
{
    u8 x = 7;
    u8 m = pick(true, 300, x);
}
