// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.generic [T-Call] inference (CHG-0100)
// kind: positive
// expect: ok
//
// A type parameter that an argument cannot fix by itself (`Vec::new()`)
// is fixed by a later argument (`label`'s `i64`). cobc lowered the
// arguments in order and stopped at `Vec::new` ("cannot infer type
// arguments"); it now reads the later arguments' types first, without
// changing the order they are evaluated in. Found by real-world testing
// (a generic parallel map called with an empty input).

import std;

fn count<T, U>(Vec<T> v, fn(T) : U f) : usize
{
    Vec::len(&v)
}

fn label(i64 x) : String
{
    sprintf("<%d>", x)
}

fn main() : u8
{
    if (count(Vec::new(), label) != 0)
    {
        return 1;
    }
    0
}
