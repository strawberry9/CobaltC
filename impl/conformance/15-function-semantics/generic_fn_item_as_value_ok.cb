// CONFORMANCE-CASE
// spec: 12-type-system
// facility: rule.type.typing [T-Item] (a generic item as a value, instantiated by explicit arguments or the expected fn type)
// kind: positive
// expect: ok

fn id<T>(T x) : T
{
    x
}

fn twice(i32 n) : i32
{
    n * 2
}

fn pick() : fn(i32) : i32
{
    twice
}

fn main()
{
    fn(i32) : i32 f = id;             // T from the expected fn type
    auto g = id<i64>;                 // T given
    if (f(4) != 4 || g(5) != 5)
    {
        1 / (1 - 1);
    }
    if ((pick())(3) != 6)             // a fn value returned by a call, called at once
    {
        1 / (1 - 1);
    }
    i32 k = 1;
    if (([k](i32 a)
    {
        a + k
    })(2) != 3)                       // a closure called at once
    {
        1 / (1 - 1);
    }
}
