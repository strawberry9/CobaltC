// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Form-Move]; spec/14 deriv (D-0288); conf.move-closure-reassigned-lets-old-capture-end
// kind: positive
// expect: ok
// expect-stdout-hex: 310a3220320a
//
// A `move` closure holds its own copy of a captured view: the view's
// binding ends at its last use, and the closure holds what it reached.
// Assigning the binding another closure ends the old one and what it
// held, so the string the old view reached may then be written.

import std;

fn main()
{
    String a = "a";
    String b = "bb";
    StringView va = &a;
    StringView vb = &b;
    auto f = move [va]() : usize { StringView::len(va) };
    printf("%v\n", f());
    f = move [vb]() : usize { StringView::len(vb) };
    String::append(&mut a, "x");
    printf("%v %v\n", f(), StringView::len(&a));
}
