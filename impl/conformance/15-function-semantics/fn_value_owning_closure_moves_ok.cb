// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: [Fn-Value-Read] (D-0089); conf.fn-value-owning-closure-moves
// kind: positive
// expect: ok
//
// A `fn` value whose closure owns a resource moves when read by value:
// out of a struct's field (the rest of the struct stays readable), into
// a `Vec<fn…>` through `Vec::push`'s parameter, and out of a function.
// Each closure is destroyed once, with the value that last holds it.
// Before D-0089 cobc faulted `diag.read-of-resource` at the push, and
// coby destroyed the closures there.

import std;

struct Task
{
    fn() : usize run;
    u32 tag;
}

fn make(str text) : fn() : usize
{
    String s = String::from_str(text);
    move [s]() : usize { String::len(&s) }
}

fn main() : u8
{
    Task t = Task { .run = make("four"), .tag = 7 };
    Task u = t;
    if ((u.run)() != 4 || t.tag != 7 || u.tag != 7) { return 1; }
    Vec<fn() : usize> fs = Vec::new();
    Vec::push(&mut fs, make("a"));
    Vec::push(&mut fs, make("abc"));
    fn() : usize h = make("hello");
    Vec::push(&mut fs, h);
    usize total = 0;
    foreach (f in &fs) { total += (*f)(); }
    if (total != 9) { return 2; }
    0
}
