// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.requires; D-0317; conf.requires-moves-parameter
// kind: negative
// expect: diag.stale-binding (static)
//
// A requirement is the body's first statement: a parameter it moves is gone
// for the rest of the body, as in any statement.

import std;

fn consume(String s) : bool
{
    StringView::len(&s) > 0
}

fn f(String s) : usize
    requires
    {
        consume(s);
    }
{
    StringView::len(&s)
}

fn main()
{
    printf("%v\n", f(String::copy("ab")));
}
