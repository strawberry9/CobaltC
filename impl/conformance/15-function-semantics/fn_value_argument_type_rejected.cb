// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: [T-Call] (each argument at its parameter's type, rule.fn.closure); conf.fn-value-argument-type
// kind: negative
// expect: diag.type-mismatch (static)
//
// A call through a `fn` value checks each argument against the value's
// parameter types: a `bool` for an `i64` is rejected (it had run, `coby`
// printing `true` and `cobc` printing `1`).

import std;

fn apply(fn(i64) : i64 g) : i64
{
    g(true)
}

fn id(i64 v) : i64
{
    v
}

fn main()
{
    printf("%v\n", apply(id));
}
