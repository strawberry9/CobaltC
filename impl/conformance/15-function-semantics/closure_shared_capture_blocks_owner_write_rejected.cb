// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Form-Borrow]; rule.value-object.write [Write-Conflict]
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// A read-only capture is a live shared reference for as long as the
// closure lives; the owner may read alongside it but not write.

fn main()
{
    i32 x = 1;
    auto f = [x]()
    {
        x
    };
    i32 y = x + f();
    x = 2;
}
