// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure capture list with a range `foreach` in the body (CHG-0452); conf.closure-foreach-range
// kind: positive
// expect: ok
//
// A range `foreach` in a closure's body is checked through a hidden
// intrinsic no program can name; the capture list names the outer locals
// the body uses (`lo`, `hi`), and nothing else.

import std;

fn main()
{
    u64 lo = 1;
    u64 hi = 5;
    auto sum = [lo, hi]() : u64
    {
        u64 t = 0;
        foreach (n in lo..hi)
        {
            t += n;
        }
        t
    };
    assert(sum() == 10);
    printf("%v\n", sum());
}
