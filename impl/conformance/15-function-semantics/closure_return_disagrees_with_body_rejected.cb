// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure (spec/15 §6), [T-Return] (CHG-0439): a `return` in a closure whose body gives another type; conf.closure-return-disagrees-with-body
// kind: negative
// expect: diag.type-mismatch (static)
//
// Without a written result type the closure's type is its body's, `str`;
// `return 1` gives an `i32`.

import std;

fn main()
{
    bool x = true;
    auto c = [x]()
    {
        if (x)
        {
            return 1;
        }
        "a"
    };
    printf("%v\n", c());
}
