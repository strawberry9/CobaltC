// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.call [Call]; rule.control.block [Block-Exit] (the result's references are spared, D-0219, CHG-0258); conf.returned-reference-parameter
// kind: positive
// expect: ok
//
// A function returns the reference it was given. The borrow `&mut x` is
// held only by the parameter `p`; when the parameter frame exits, `p`'s
// object ends, but the reference it held is the body's result, which
// every cleanup on the way out spares, as `unwind-to` and `[Stmt-Exit]`
// spare a result. The caller's binding then holds it.

import std;

fn pass(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    p
}

fn pass_twice(ref<i32, exclusive> p) : ref<i32, exclusive>
{
    pass(p)
}

fn main() : u8
{
    i32 x = 1;
    auto q = pass(&mut x);
    *q = 4;
    auto q2 = pass_twice(&mut x);
    *q2 = *q2 + 1;
    if (x != 5)
    {
        return 1;
    }
    0
}
