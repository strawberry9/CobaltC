// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.return; rule.control.stmt (a path that is the statement's result lives on)
// kind: positive
// expect: ok
//
// `return Some(&m.v);` — a value holding a reference formed in the
// `return` statement itself. `cobc` sent the value's references to the
// caller without taking them out of the statement's scope, so ending the
// statement ended them and the caller's use was `diag.stale-binding`
// (a bare reference, and a tail expression, were right). Also through
// `v[i]` and a `foreach` element. Found by real-world testing.

import std;

struct M
{
    i32 k;
    i32 v;
}

fn field(ref<M, shared> m) : Option<ref<i32, shared>>
{
    return Some(&m.v);
}

fn by_index(ref<Vec<M>, shared> ms, i32 k) : Option<ref<i32, shared>>
{
    usize i = 0;
    while (i < Vec::len(ms))
    {
        if (ms[i].k == k)
        {
            return Some(&ms[i].v);
        }
        i += 1;
    }
    None
}

fn by_foreach(ref<Vec<M>, shared> ms, i32 k) : Option<ref<i32, shared>>
{
    foreach (m in ms)
    {
        if (m.k == k)
        {
            return Some(&m.v);
        }
    }
    None
}

fn main()
{
    M one = M { .k = 0, .v = 5 };
    Vec<M> ms = Vec::new();
    Vec::push(&mut ms, M { .k = 1, .v = 10 });
    Vec::push(&mut ms, M { .k = 2, .v = 20 });
    i32 total = 0;
    match (field(&one))
    {
        Some(r) :
        {
            total += *r;
        },
        None :
        {
        },
    }
    match (by_index(&ms, 2))
    {
        Some(r) :
        {
            total += *r;
        },
        None :
        {
        },
    }
    match (by_foreach(&ms, 1))
    {
        Some(r) :
        {
            total += *r;
        },
        None :
        {
        },
    }
    if (total != 35)
    {
        1 / (1 - 1);
    }
}
