// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Call] writes-self; D-0239; conf.move-closure-writing-capture
// kind: positive
// expect: ok
// expect-stdout-hex: 310a320a
//
// A `move` closure that writes its own capture, called twice from its
// binding: it is borrowed exclusively for each call (D-0239), and its state
// carries from one call to the next.

import std;

fn main()
{
    i32 n = 0;
    auto c = move [n]() : i32
    {
        n = n + 1;
        n
    };
    printf("%v\n", c());
    printf("%v\n", c());
}
