// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.closure [Closure-Call], rule.fn.return [Return] (CHG-0100)
// kind: positive
// expect: ok
//
// A closure's call proceeds as `[Call]` on its body, so `return` in the
// body ends that call and gives its value, whichever way the closure is
// called. `coby` let the `return` end the function the call was in
// (`main` returned `false`, printing nothing); `return 300` was typed by
// the enclosing function's result. Found by real-world testing (a
// visitor whose callback stops the scan).

import std;

struct H { fn(i32) : bool f; }

fn by_value(fn(i32) : bool f) : u32
{
    if (f(3)) { 1 } else { 2 }
}
fn by_ref(ref<fn(i32) : bool, shared> f) : u32
{
    if ((*f)(3)) { 1 } else { 2 }
}
fn by_field(ref<H, shared> h) : u32
{
    if ((h.f)(3)) { 1 } else { 2 }
}

fn main() : u8
{
    auto stop_at_3 = move [](i32 x) : bool { if (x == 3) { return false; } true };
    if (stop_at_3(3) || !stop_at_3(1)) { return 1; }
    if (by_value(stop_at_3) != 2) { return 2; }
    if (by_ref(&stop_at_3) != 2) { return 3; }
    H h = H { .f = stop_at_3 };
    if (by_field(&h) != 2) { return 4; }
    auto wide = move [](bool big) : u32 { if (big) { return 300; } 1 };
    if (wide(true) != 300) { return 5; }
    0
}
