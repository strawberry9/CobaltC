// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.generic (type arguments inferred from the arguments); D-0192; CHG-0356; conf.generic-call-reader-element-arg
// kind: positive
// expect: ok
// expect-stdout-hex: 32203120332032203320320a
//
// A generic function's type arguments are inferred from its arguments,
// whatever form an argument takes. Here each argument is `&v[j]`, an
// element of a vector reached through a shared reference parameter, and
// the element is a resource (a `HashSet<String>`, a `HashMap`, a `Vec`):
// the element is lent to the callee for the call, which reads it in place.
// `HashSet::len`, `HashMap::len`, `Vec::len` and a generic of the
// program's own each fix their type parameters from it.

import std;

fn size_of_set<T: eq>(ref<HashSet<T>, shared> s) : usize
{
    HashSet::len(s)
}

fn sets(ref<Vec<HashSet<String>>, shared> m, usize j) : usize
{
    HashSet::len(&m[j])
}

fn maps(ref<Vec<HashMap<String, i32>>, shared> m, usize j) : usize
{
    HashMap::len(&m[j])
}

fn vecs(ref<Vec<Vec<String>>, shared> m, usize j) : usize
{
    Vec::len(&m[j])
}

fn own_generic(ref<Vec<HashSet<String>>, shared> m, usize j) : usize
{
    size_of_set(&m[j])
}

fn main() : u8
{
    Vec<HashSet<String>> ss = Vec::new();
    HashSet<String> a = HashSet::new();
    HashSet::insert(&mut a, String::from_str("x"));
    HashSet::insert(&mut a, String::from_str("y"));
    Vec::push(&mut ss, a);
    HashSet<String> c = HashSet::new();
    HashSet::insert(&mut c, String::from_str("z"));
    Vec::push(&mut ss, c);
    Vec<HashMap<String, i32>> ms = Vec::new();
    HashMap<String, i32> m = HashMap::new();
    HashMap::insert(&mut m, String::from_str("p"), 1);
    HashMap::insert(&mut m, String::from_str("q"), 2);
    HashMap::insert(&mut m, String::from_str("r"), 3);
    Vec::push(&mut ms, m);
    Vec<Vec<String>> vs = Vec::new();
    Vec<String> w = Vec::new();
    Vec::push(&mut w, String::from_str("u"));
    Vec::push(&mut w, String::from_str("v"));
    Vec::push(&mut vs, w);
    Vec<String> w3 = Vec::new();
    Vec::push(&mut w3, String::from_str("a"));
    Vec::push(&mut w3, String::from_str("b"));
    Vec::push(&mut w3, String::from_str("c"));
    Vec::push(&mut vs, w3);
    printf(
        "%v %v %v %v %v %v\n",
        sets(&ss, 0),
        sets(&ss, 1),
        maps(&ms, 0),
        vecs(&vs, 0),
        vecs(&vs, 1),
        own_generic(&ss, 0),
    );
    0
}
