// CONFORMANCE-CASE
// spec: 15-function-semantics
// facility: rule.fn.requires [Requires-Fail]; D-0317; conf.requires-fails-at-call
// kind: negative
// expect: diag.precondition-failed (dynamic)
//
// A requirement that does not hold is the caller's: reported at the call,
// not in the function, with its message formatted.

import std;

fn withdraw(u64 balance, u64 amount) : u64
    requires
    {
        amount <= balance, "amount %v exceeds balance %v", amount, balance;
    }
{
    balance - amount
}

fn main()
{
    Vec<u64> v = Vec::new();
    Vec::push(&mut v, 5);
    Vec::push(&mut v, 9);
    printf("%v\n", withdraw(v[1], v[0]));
    printf("%v\n", withdraw(v[0], v[1]));
}
