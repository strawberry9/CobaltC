// CONFORMANCE-CASE
// spec: 05-value-object-semantics
// facility: spec/18 [Fault-Unwind]; conf.overwrite-fault-destroys-pending
// kind: negative
// expect: diag.overwrite-of-live-resource (dynamic)
// expect-stdout-hex: 7365740a5b64726f7020325d5b64726f7020315d
//
// a write over a live non-quiet resource faults; the value being written
// is a temporary of the statement, destroyed by the unwind first, then
// the binding's (D-0194: coby kept it)

import std;

resource struct Noisy
{
    i64 id;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("[drop %v]", self.id);
}

fn main()
{
    Option<Noisy> on = None;
    on = Some(Noisy { .id = 1 });
    printf("set\n");
    on = Some(Noisy { .id = 2 });
    printf("unreached\n");
}
