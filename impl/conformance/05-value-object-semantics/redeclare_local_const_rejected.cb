// CONFORMANCE-CASE
// spec: 05-value-object-semantics
// facility: rule.value-object.binding-form [Binding-Form-Redeclared] (a local constant and a variable share the region); D-0131, D-0066; conf.redeclared-local-const-rejected
// kind: negative
// expect: diag.duplicate-local (static)
//
// A local constant and a variable of the same name in one block.

import std;

fn main()
{
    const i32 B = 200;
    i32 B = -1;
    printf("%v\n", B);
}
