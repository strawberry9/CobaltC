// CONFORMANCE-CASE
// spec: 05-value-object-semantics
// facility: rule.value-object.binding-form [Binding-Form-Redeclared]; D-0131; conf.redeclare-allowed-forms
// kind: positive
// expect: ok
// expect-stdout-hex: 3120332033203420350a
//
// What a name may still do: a nested block shadows an enclosing block's
// local; sibling blocks, two loops in a row and two `match` arms each
// declare their own; a closure's parameter shadows a local outside it;
// and a local shadows an item.

import std;

const i32 LIMIT = 100;

fn main()
{
    i32 x = 1;
    {
        i32 x = 2;                    // a nested block: a new x
        assert(x == 2);
    }
    assert(x == 1);
    {
        i32 y = 3;
        assert(y == 3);
    }
    {
        i32 y = 4;                    // a sibling block: its own y
        assert(y == 4);
    }
    i32 sum = 0;
    for (i32 i = 0; i < 2; i += 1)
    {
        sum += i;
    }
    for (i32 i = 0; i < 2; i += 1)    // a second loop: its own i
    {
        sum += i;
    }
    Option<i32> o = Some(3);
    i32 z = match (o)
    {
        Some(v) : v,
        None    : 0,
    };
    i32 w = match (Some(4))
    {
        Some(v) : v,                  // another match: its own v
        None    : 0,
    };
    auto add = [](i32 x)              // a closure's parameter shadows x
    {
        x + 1
    };
    i32 LIMIT = 5;                    // a local shadows the item
    printf("%v %v %v %v %v\n", x, add(sum), z, w, LIMIT);
}
