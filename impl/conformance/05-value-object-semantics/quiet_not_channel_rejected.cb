// CONFORMANCE-CASE
// spec: 05-value-object-semantics
// facility: spec/05 quiet; conf.quiet-not-channel
// kind: negative
// expect: diag.overwrite-of-live-resource (static)
//
// a String is quiet and is replaced; a Channel is a std resource that is
// not quiet (its end wakes and releases waiters), so writing over a live
// one is still refuted before the program runs (D-0194)

import std;

fn main()
{
    String s = String::from_str("a");
    s = String::from_str("b");
    Channel<u8> c = Channel::new(1);
    c = Channel::new(2);
}
