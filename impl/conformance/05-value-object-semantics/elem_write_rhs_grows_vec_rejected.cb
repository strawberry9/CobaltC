// CONFORMANCE-CASE
// spec: 05-value-object-semantics
// facility: [Write-Stale]; diag.stale-binding; conf.elem-write-rhs-grows
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// `v[0].x = e` evaluates the target first: the element is reached before
// `e` runs, and `e` hands `v` to a function that pushes until the buffer
// moves. The element reached is gone, so the write is stale. (A compiler
// that keeps the element's address across `e` must not.)

import std;

struct P
{
    i64 x;
    i64 y;
}

fn grow(ref<Vec<P>, exclusive> v) : i64
{
    foreach (k in 0..1000: i64)
    {
        Vec::push(v, P { .x = k, .y = k });
    }
    7
}

fn main()
{
    Vec<P> v = Vec::new();
    Vec::push(&mut v, P { .x = 1, .y = 2 });
    v[0].x = grow(&mut v);
    printf("%v\n", v[0].x);
}
