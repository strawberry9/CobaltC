// CONFORMANCE-CASE
// spec: 05-value-object-semantics
// facility: rule.value-object.binding-form [Binding-Form-Redeclared]; D-0131; conf.redeclared-local-rejected
// kind: negative
// expect: diag.duplicate-local (static)
//
// A second `i32 total` in the same block, meant as an assignment: the
// name is declared once in its block (`total = …` changes it).

import std;

fn main()
{
    i32 total = 0;
    total += 4;
    i32 total = 10;
    printf("%v\n", total);
}
