// CONFORMANCE-CASE
// spec: 05-value-object-semantics
// facility: rule.value-object.binding-form [Binding-Form-Redeclared] (an arm's binder governs its block); D-0131; conf.redeclared-arm-binder-rejected
// kind: negative
// expect: diag.duplicate-local (static)
//
// An arm's pattern binds `v` for the arm's block: the block may not
// declare it again.

import std;

fn main()
{
    Option<i32> o = Some(1);
    match (o)
    {
        Some(v) :
        {
            i32 v = v + 1;
            printf("%v\n", v);
        },
        None    : {},
    }
}
