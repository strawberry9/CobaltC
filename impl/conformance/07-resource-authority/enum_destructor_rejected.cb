// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: spec/07 §1 (D-0075): a destructor is a resource struct's; conf.enum-destructor-rejected
// kind: negative
// expect: diag.destructor-on-plain-type (static)
//
// An enum has no destructor: a `drop` declared for one, even an enum that
// holds a `String` (a resource), would never run, so it is refused, and the
// message names the `resource struct` that wraps the enum.

import std;

enum Slot
{
    Empty,
    Busy(String),
}

fn Slot::drop(ref<Slot, exclusive> s)
{
    printf("dropped\n");
}

fn main()
{
    Slot s = Busy("x");
}
