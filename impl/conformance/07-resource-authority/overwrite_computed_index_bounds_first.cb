// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: rule.agg.index [Index-Out-Of-Bounds]; rule.value-object.write; D-0095; conf.overwrite-computed-index-bounds-first
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// D-0095 refutes an element overwrite statically only at a literal index
// inside the array: at a computed index the element may not exist, and
// then the write is out of bounds -- a fault only the run can decide,
// and it comes first. (At `a[1]` the same write is refuted statically.)

import std;

fn main()
{
    array<Vec<i32>, 2> a = [Vec::new(), Vec::new()];
    usize i = arg_count() + 5;
    a[i] = Vec::new();
}
