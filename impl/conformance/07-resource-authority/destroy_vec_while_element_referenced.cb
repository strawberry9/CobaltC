// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: rule.resauth.destroy [Destroy-Not-Solitary] in `Vec::drop`'s `drop(reclaim<T>(…))`; conf.destroy-vec-while-element-referenced
// kind: negative
// expect: diag.destroy-while-aliased (static)
//
// `drop(v)` runs `Vec::drop`, whose `drop(reclaim<Tok>(…))` is `[Destroy]` of
// the element's object while `t`, a reference to its `text`, is live: the
// element is not solitary (CHG-0370; cobc reported the move into a
// temporary, `diag.move-while-aliased`).
//
// D-0282: the static pass rejects this program before it runs (it was found
// at run time before): `t` still borrows `v`, so it cannot be moved or
// destroyed here; end that borrow first.

import std;

struct Tok
{
    u32 kind;
    String text;
}

fn main() : u8
{
    Vec<Tok> v = Vec::new();
    Vec::push(&mut v, Tok { .kind = 1, .text = String::from_str("ab") });
    Vec::push(&mut v, Tok { .kind = 2, .text = String::from_str("cde") });
    ref<String, shared> t = &v[0].text;
    printf("%d\n", String::len(t));
    drop(v);
    printf("%d\n", String::len(t));
    return 0;
}
