// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: rule.value-object.write [Write-Resource-Overwrite-Rejected]; D-0095; conf.overwrite-through-exclusive-reference
// kind: negative
// expect: diag.overwrite-of-live-resource (static)
//
// A write through a valid exclusive reference reaches a live object:
// whatever could end or empty it (a move, a reallocation) would first
// clash with the reference's live borrow. So `t.rows`, reached through
// `t`, holds a live `Vec`, and the assignment is refuted statically.

import std;

struct Table
{
    Vec<i32> rows;
}

fn reset(ref<Table, exclusive> t)
{
    t.rows = Vec::new();
}

fn main()
{
    Table t = Table { .rows = Vec::new() };
    reset(&mut t);
}
