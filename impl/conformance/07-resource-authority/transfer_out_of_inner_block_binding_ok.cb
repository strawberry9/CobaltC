// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: rule.resource.authority [Authority-Transfer] (D-0003, D-0016); conf.transfer-out-of-inner-block-binding
// kind: positive
// expect: ok
// expect-stdout-hex: 300a320a
//
// A resource moved out of a block's binding into a binding of an enclosing
// block goes with its new owner: the block that bound it first does not
// destroy it at its end. `Vec<u8> t = ps;` moves `ps`'s object (bound in the
// middle block) into `t` (the inner block), then `hold = t` moves it into
// `hold` (the outer block); `ps` takes `hold`'s old object. When the middle
// block ends, `hold`'s object is not destroyed. `coby` destroyed it before
// CHG-0416 (the middle block's record still listed the object it had bound),
// so the last read faulted; `cobc` was right.

import std;

fn main()
{
    Vec<u8> hold = Vec::new();
    {
        Vec<u8> ps = Vec::from_slice(b"ab");
        {
            Vec<u8> t = ps;
            ps = hold;
            hold = t;
        }
        printf("%v\n", Vec::len(&ps));
    }
    printf("%v\n", Vec::len(&hold));
}
