// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: [Authority-Transfer-Aliased]; conf.move-while-held-in-struct
// kind: negative
// expect: diag.move-while-aliased (dynamic)
//
// A move is a transfer, not a read: moving a binding while an exclusive
// borrow of it is held (here inside a struct a call made, which the
// frame holds only as `?`) is diag.move-while-aliased, as it is for a shared
// one. cobc once reported diag.aliasing-conflict for the exclusive case.
// `h` is used after the move: a struct of references ends after its last
// use ([Ref-Binding-Last-Use], D-0133), so an unused `h` would hold nothing.
//
// D-0290: the reference is stored by a call (`hold`), so the frame holds it
// only as `?` (it may hold none of it), and the run checks the access; the
// same program storing it directly is refuted before the run.

import std;

struct H
{
    ref<Vec<i32>, exclusive> r;
}

fn hold(ref<Vec<i32>, exclusive> r) : H
{
    H { .r = r }
}

fn f() : Option<Vec<i32>>
{
    Vec<i32> out = Vec::new();
    H h = hold(&mut out);
    Option<Vec<i32>> o = Some(out);
    Vec::push(h.r, 1);
    o
}

fn main()
{
    auto o = f();
}
