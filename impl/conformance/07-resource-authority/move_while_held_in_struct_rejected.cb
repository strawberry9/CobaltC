// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: [Authority-Transfer-Aliased]
// kind: negative
// expect: diag.move-while-aliased (dynamic)
//
// A move is a transfer, not a read: moving a binding while an exclusive
// borrow of it is held (here inside a struct, where the static analysis
// does not follow it) is diag.move-while-aliased, as it is for a shared
// one. cobc once reported diag.aliasing-conflict for the exclusive case.

import std;

struct H
{
    ref<Vec<i32>, exclusive> r;
}

fn f() : Option<Vec<i32>>
{
    Vec<i32> out = Vec::new();
    H h = H { .r = &mut out };
    Some(out)
}

fn main()
{
    auto o = f();
}
