// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: conf.early-return-destructured; rule.resauth.destroy, rule.fn.return, [Let-Destructure] (D-0208, CHG-0246)
// kind: positive
// expect: ok
// expect-stdout-hex: 64726f7020320a676f7420310a7365636f6e640a64726f7020330a676f7420340a64726f7020340a64726f7020310a
//
// A resource aggregate taken apart by destructuring, then left early by
// a return that carries one part out: the other part is destroyed
// exactly once, at the return, and the carried one lives on in the
// caller. A field of an owned local cannot be moved out
// (conf.move-out-of-field-rejected); destructuring is the way to split
// an aggregate, and this is what an early exit does to what it leaves.

import std;

resource struct Noisy
{
    i32 id;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("drop %v\n", self.id);
}

struct Pair
{
    Noisy a;
    Noisy b;
}

fn pick(Pair p, bool first) : Noisy
{
    Pair { a, b } = p;
    if (first)
    {
        return a;
    }
    printf("second\n");
    b
}

fn main()
{
    Noisy x = pick(Pair { .a = Noisy { .id = 1 }, .b = Noisy { .id = 2 } }, true);
    printf("got %v\n", x.id);
    Noisy y = pick(Pair { .a = Noisy { .id = 3 }, .b = Noisy { .id = 4 } }, false);
    printf("got %v\n", y.id);
}
