// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: rule.resauth.destroy (drop of a temporary: destroyed at once)
// kind: positive
// expect: ok

resource struct Flagger
{
    ref<i32, exclusive> flag;
}

fn Flagger::drop(ref<Flagger, exclusive> self)
{
    *self.flag = *self.flag + 1;
}

fn make(ref<i32, exclusive> flag) : Flagger
{
    Flagger { .flag = flag }
}

fn main()
{
    i32 dropped = 0;
    drop(make(&mut dropped));
    if (dropped != 1)
    {
        1 / (1 - 1);
    }
    drop(5);                          // a plain temporary simply ends
}
