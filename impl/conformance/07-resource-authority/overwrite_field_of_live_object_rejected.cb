// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: rule.value-object.write [Write-Resource-Overwrite-Rejected]; D-0095; conf.overwrite-field-of-live-object
// kind: negative
// expect: diag.overwrite-of-live-resource (static)
//
// A field of a valid, initialized object always holds its value (moving
// one out is rejected, and a trusted raw move-out may not take cells a
// live object claims), and every value of `String` owns a resource: the
// assignment would lose the old `String`, refuted before the program
// runs. The repair is `overwrite(&mut g.start, …)`.

import std;

struct Grammar
{
    String start;
}

fn main()
{
    Grammar g = Grammar { .start = String::new() };
    g.start = String::from_str("E");
}
