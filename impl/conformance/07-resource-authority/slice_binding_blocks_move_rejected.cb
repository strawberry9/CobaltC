// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: [Authority-Transfer-Aliased]; rule.control.flow-analysis (deriv facts of a slice binding)
// kind: negative
// expect: diag.move-while-aliased (static)
//
// A slice binding borrows its source exactly as a reference binding does:
// while `s` lives (it is used after, D-0111), moving `out` is rejected,
// statically, as it is for `auto s = &mut out;`.

import std;

fn f() : Option<Vec<i32>>
{
    Vec<i32> out = Vec::new();
    Vec::push(&mut out, 1);
    auto s = &mut out[0..$];
    Option<Vec<i32>> o = Some(out);
    s[0] = 2;
    o
}

fn main()
{
    auto o = f();
}
