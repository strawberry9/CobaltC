// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: rule.resauth.transfer; D-0008 automatic destruction
// kind: positive
// expect: ok
// expect-stdout-hex: 01
//
// Moving a resource into a function transfers destroy authority to
// the callee; the resource must be destroyed exactly once, at the
// callee's own scope exit, not again at the caller.

import std;

resource struct Counted
{
    u8 tag;
}

fn Counted::drop(ref<Counted, exclusive> self)
{
    auto b = [self.tag];
    rawptr<u8> p = reinterpret_ptr<u8>(rawptr_of(&b));
    unsafe
    {
        write(p, 1);
    }
}

fn consume(Counted c)
{
}

fn main()
{
    Counted c = Counted { .tag = 1 };
    consume(c);
}
