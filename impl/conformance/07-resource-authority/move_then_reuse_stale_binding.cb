// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: rule.resauth.transfer; diag.stale-binding
// kind: negative
// expect: diag.stale-binding (static)
//
// Moving a resource out through one call transfers its destroy
// authority away; using the same binding again is a use of a stale
// access path, caught before any authority question is even asked.

resource struct R
{
    i32 v;
}

fn takes(R x)
{
}

fn main()
{
    R r = R { .v = 1 };
    takes(r);
    takes(r);
}
