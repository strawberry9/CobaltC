// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: [Read-Resource-Rejected]; rule.type.typing [T-Cmp]
// kind: negative
// expect: diag.read-of-resource (static)
//
// A resource type has no value equality (=_tau is defined only for
// non-resource, non-fn types); comparing two resources with == reads
// them in value position, which is rejected -- statically, like any
// other operand, inside an `if` condition too.

resource struct R
{
    i32 v;
}

fn main()
{
    R r = R { .v = 1 };
    if (r == r)
    {
    }
}
