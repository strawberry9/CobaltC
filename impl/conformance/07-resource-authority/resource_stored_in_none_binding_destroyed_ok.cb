// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: rule.resauth.destroy [Destroy] [Destroy-Composite]; conf.resource-in-none-binding-destroyed
// kind: positive
// expect: ok
// expect-stdout-hex: 64726f7020310a616674657220610a64726f7020320a616674657220630a64726f7020330a616674657220640a656e64206f6620626c6f636b0a64726f7020340a646f6e650a
//
// A binding written `Option<Noisy>` and made from `None` is a resource
// from the start: a `Noisy` later stored in it -- by assignment, by
// `swap`, or by `replace` out of a `Vec` -- is destroyed with it, by
// `drop` or at the end of its block.

import std;

resource struct Noisy
{
    i32 id;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("drop %v\n", self.id);
}

fn main()
{
    Option<Noisy> a = None;
    a = Some(Noisy { .id = 1 });
    drop(a);
    printf("after a\n");

    Option<Noisy> b = Some(Noisy { .id = 2 });
    Option<Noisy> c = None;
    swap(&mut b, &mut c);
    drop(c);
    printf("after c\n");

    Vec<Option<Noisy>> v = Vec::new();
    Vec::push(&mut v, Some(Noisy { .id = 3 }));
    Option<Noisy> none = None;
    Option<Noisy> d = replace(&mut v[0], none);
    drop(d);
    printf("after d\n");

    {
        Option<Noisy> e = None;
        e = Some(Noisy { .id = 4 });
        printf("end of block\n");
    }
    printf("done\n");
}
