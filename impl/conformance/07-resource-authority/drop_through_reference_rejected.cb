// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: rule.resauth.destroy [Destroy-Not-Solitary]; conf.drop-through-reference
// kind: negative
// expect: diag.move-while-aliased (static)
//
// `drop(*r)` reaches the object through a reference; its owner's own
// root path is another valid path on it, so it is never solitary.
//
// D-0282: the static pass rejects this program before it runs (it was found
// at run time before): `*r` cannot be moved out: `r` still refers to it.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    auto r = &mut v;
    drop(*r);
}
