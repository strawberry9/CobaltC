// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: rule.resauth.destroy [Destroy-Not-Solitary]
// kind: negative
// expect: diag.destroy-while-aliased (dynamic)
//
// `drop(*r)` reaches the object through a reference; its owner's own
// root path is another valid path on it, so it is never solitary.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    auto r = &mut v;
    drop(*r);
}
