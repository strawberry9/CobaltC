// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: rule.resauth.destroy [Destroy-Not-Solitary]; spec/14 [Stmt-Exit]; conf.destroy-temporary-while-viewed
// kind: negative
// expect: diag.destroy-while-aliased (dynamic)
//
// The temporary String ends at its statement's end, but the views that
// `split` returned are held by `parts`, so they are still live paths
// on it: its destruction is not solitary. (Nothing uses the views
// afterwards; the fault is at the destruction, not at a later use.)

import std;

fn main()
{
    Vec<StringView> parts = StringView::split(String::view(&String::from_str("alpha,beta"), 0, 10), ",");
    printf("%d\n", Vec::len(&parts));
}
