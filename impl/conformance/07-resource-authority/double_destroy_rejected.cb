// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: rule.resauth.destroy; inv.resource-authority
// kind: negative
// expect: diag.stale-binding (static)
//
// A second drop(x) through the same binding is caught as a stale
// access before any no-destroy-authority question even arises --
// the registry's own documented ordering for this exact case.

resource struct R
{
    i32 v;
}

fn main()
{
    R r = R { .v = 1 };
    drop(r);
    drop(r);
}
