// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: [Write-Resource-Overwrite-Rejected]
// kind: negative
// expect: diag.overwrite-of-live-resource (static)
//
// Assigning a new resource value into a binding that already holds a
// live, undischarged resource would silently leak the old one -- the
// language requires an explicit drop first.

resource struct R
{
    i32 v;
}

fn main()
{
    R r = R { .v = 1 };
    r = R { .v = 2 };
}
