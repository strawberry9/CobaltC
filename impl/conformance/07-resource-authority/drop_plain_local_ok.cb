// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: rule.resauth.destroy [Destroy] (D-0315); conf.drop-of-plain-local
// kind: positive
// expect: ok
// expect-stdout-hex: 312035203020330a
//
// `drop(x)` of a local holding plain data, borrowed before it ends (a
// generic's `usize` instantiation, a map's last entry removed): its end does
// nothing, and the program goes on.

import std;

fn take_last<K>(ref<Vec<K>, exclusive> v) : usize
{
    auto k = match (Vec::pop(v))
    {
        Some(x) : x,
        None    : fault(index_out_of_bounds),
    };
    ref<K, shared> r = &k;
    _ = r;
    drop(k);
    Vec::len(v)
}

fn main()
{
    Vec<usize> v = Vec::new();
    Vec::push(&mut v, 4);
    Vec::push(&mut v, 9);
    usize n = take_last(&mut v);
    HashMap<usize, String> m = HashMap::new();
    HashMap::insert(&mut m, 7, "seven");
    usize got = match (HashMap::swap_remove(&mut m, 7))
    {
        Some(s) : StringView::len(&s),
        None    : 0,
    };
    usize x = 3;
    ref<usize, shared> rx = &x;
    usize y = *rx;
    drop(x);
    printf("%v %v %v %v\n", n, got, HashMap::len(&m), y);
}
