// CONFORMANCE-CASE
// spec: 07-resource-authority
// facility: rule.resauth.destroy [Destroy-Not-Solitary]; spec/14 [Block-Exit]; conf.destroy-local-while-viewed-outside
// kind: negative
// expect: diag.destroy-while-aliased (dynamic)
//
// `s` is destroyed when its block ends while `parts`, declared outside
// the block, still holds views of it (through a call, so the escape is
// not visible to rule.temporal.ref-escape).

import std;

fn main()
{
    Vec<StringView> parts = Vec::new();
    {
        String s = String::from_str("alpha,beta");
        overwrite(&mut parts, StringView::split(String::view(&s, 0, 10), ","));
    }
    printf("%d\n", Vec::len(&parts));
}
