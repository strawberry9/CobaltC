// CONFORMANCE-CASE
// spec: 09-identity-origin-extent
// facility: rule.ref.form [Ref-Form-Temporary]; conf.borrow-of-temporary-rejected
// kind: negative
// expect: diag.borrow-of-temporary (static)
//
// A projection of an aggregate literal is a place whose root is a
// temporary ([Temp-Root]); borrowing it is rejected rather than given
// a lifetime, since the temporary ends at the statement's end.

struct P
{
    i32 a;
}

fn main()
{
    auto r = &P { .a = 1 }.a;
}
