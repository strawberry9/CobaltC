// CONFORMANCE-CASE
// spec: 09-identity-origin-extent
// facility: rule.ref.deref [Ref-Deref-Place]
// kind: positive
// expect: ok
//
// *e is a genuine place: readable in value position and writable
// through an exclusive reference, both routed through the same
// underlying access path as a direct name would be. The owner is read
// only after the reference's block has ended: reading `x` while `r` is
// a live exclusive descendant would be [Read-Conflict]
// (spec/conformance.md, conf.reborrow-ok's derivation).

fn main()
{
    i32 x = 5;
    {
        auto r = &mut x;
        *r = *r + 1;
        if (*r != 6)
        {
            1 / (1 - 1);
        }
    }
    if (x != 6)
    {
        1 / (1 - 1);
    }
}
