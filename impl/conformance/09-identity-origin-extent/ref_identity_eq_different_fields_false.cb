// CONFORMANCE-CASE
// spec: 09-identity-origin-extent
// facility: rule.ref.identity-eq [Ref-Identity-Eq]
// kind: positive
// expect: ok
//
// References to two different fields of the same struct are never
// equal, even though they share a root object (spec/AUDIT-2.md B-16).

struct Pair
{
    i32 a;
    i32 b;
}

fn main()
{
    Pair p = Pair { .a = 1, .b = 2 };
    auto ra = &p.a;
    auto rb = &p.b;
    if (ra == rb)
    {
        1 / (1 - 1);
    }
}
