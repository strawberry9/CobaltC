// CONFORMANCE-CASE
// spec: 09-identity-origin-extent
// facility: rule.ref.identity-eq [Ref-Identity-Eq]
// kind: positive
// expect: ok
//
// Two references formed from the same field of the same object denote
// the same sub-range and must compare equal.

struct Pair
{
    i32 a;
    i32 b;
}

fn main()
{
    Pair p = Pair { .a = 1, .b = 2 };
    auto r1 = &p.a;
    auto r2 = &p.a;
    if (!(r1 == r2))
    {
        1 / (1 - 1);
    }
}
