// CONFORMANCE-CASE
// spec: 09-identity-origin-extent
// facility: rule.ref.form [Ref-Form-Temporary] (a call result of reference type); conf.field-through-unwrapped-reference-borrowed
// kind: positive
// expect: ok
//
// `&mut Option::unwrap(HashMap::get_mut(&mut m, &k)).items`: `unwrap`'s
// result type `T` is a reference here, so the field is a place through
// it, not part of a temporary. The checker looked only at a function's
// declared result type and rejected it (`diag.borrow-of-temporary`).
// Found by real-world testing (a text adventure's rooms).

import std;

struct Room
{
    Vec<u32> items;
}

fn main()
{
    HashMap<u32, Room> rooms = HashMap::new();
    HashMap::insert(&mut rooms, 1, Room { .items = Vec::new() });
    u32 k = 1;
    Vec::push(&mut Option::unwrap(HashMap::get_mut(&mut rooms, &k)).items, 7);
    {
        Result<ref<Room, exclusive>, u8> found = Ok(Option::unwrap(HashMap::get_mut(&mut rooms, &k)));
        Vec::push(&mut Result::unwrap(found).items, 8);
    }
    assert(Vec::len(&Option::unwrap(HashMap::get(&rooms, &k)).items) == 2);
}
