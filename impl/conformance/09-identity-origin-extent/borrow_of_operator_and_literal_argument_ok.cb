// CONFORMANCE-CASE
// spec: 09-identity-origin-extent
// facility: rule.ref.form [Ref-Form-Temporary-Argument] (D-0084: operator results and literals); conf.temp-borrow-operator-argument, conf.temp-borrow-literal-typed-by-parameter
// kind: positive
// expect: ok
//
// As an argument of a call whose result is not a reference, an
// operator's result (`&(k << 32 | c)`, `&(n + 1)`, `&~n`) and a number or
// `bool` literal (`&3`, `&-3`, `&true`) are temporaries of the statement,
// borrowed for the call. A literal takes the referent type the parameter
// expects: `&3` is a `ref<u64, shared>` for a `HashMap<u64, _>` and a
// `ref<i8, shared>` for a `HashSet<i8>`. Found by real-world testing (a
// Huffman decoder's map key, an LRU cache lookup).

import std;

fn value(ref<u64, shared> r) : u64
{
    *r
}

fn main()
{
    HashMap<u64, u8> m = HashMap::new();
    u64 k = 3;
    u32 c = 7;
    HashMap::insert(&mut m, (k << 32) | widen<u64>(c), 9);
    HashMap::insert(&mut m, 3, 1);
    assert(*Option::unwrap(HashMap::get(&m, &((k << 32) | widen<u64>(c)))) == 9);
    assert(*Option::unwrap(HashMap::get(&m, &3)) == 1);
    assert(!HashMap::contains(&m, &4));
    assert(value(&(k + 1)) == 4);
    assert(value(&~k) == 18446744073709551612);
    HashSet<i8> s = HashSet::new();
    HashSet::insert(&mut s, -3);
    assert(HashSet::contains(&s, &-3));
    HashSet<bool> b = HashSet::new();
    HashSet::insert(&mut b, true);
    assert(HashSet::contains(&b, &true) && !HashSet::contains(&b, &false));
}
