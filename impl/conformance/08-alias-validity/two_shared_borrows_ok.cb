// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.alias.borrow (sequential shared borrows)
// kind: positive
// expect: ok
//
// Two shared borrows of the same object, formed and used one after
// the other, never conflict -- shared/shared is always compatible.

fn main()
{
    i32 x = 5;
    {
        auto r1 = &x;
        if (*r1 != 5)
        {
            1 / (1 - 1);
        }
    }
    {
        auto r2 = &x;
        if (*r2 != 5)
        {
            1 / (1 - 1);
        }
    }
}
