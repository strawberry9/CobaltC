// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.control.block [Ref-Binding-Last-Use] (D-0111); conf.ref-binding-used-in-loop-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// A use inside a loop is a use by the whole loop statement: `first`
// lives through the loop, and the push in it clashes.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    ref<i32, shared> first = &v[0];
    i32 k = 0;
    while (k < 2)
    {
        printf("%v\n", *first);
        Vec::push(&mut v, k);
        k = k + 1;
    }
}
