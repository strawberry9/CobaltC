// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Read-Conflict] through a shared reference parameter (CHG-0237); conf.frozen-param-held-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 72656164696e6720300a72656164696e6720310a72656164696e6720320a
//
// A function reads every element of a vector through a shared reference
// parameter it never rebinds (compiled, a frozen body chosen at entry).
// The caller holds an exclusive reference to element 2: the entry test
// finds the element's object, the checked body runs, and the read of
// element 2 faults, after the reads before it.

import std;

fn total(ref<Vec<u64>, shared> v) : u64
{
    u64 t = 0;
    for (usize i = 0; i < Vec::len(v); i += 1)
    {
        printf("reading %v\n", i);
        t += v[i];
    }
    t
}

fn main() : u8
{
    Vec<u64> v = Vec::filled(4, 5: u64);
    Vec<ref<u64, exclusive>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &mut v[2]);
    }
    printf("total %v\n", total(&v));
    printf("held %v\n", *held[0]);
    0
}
