// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: conf.shared-match-exclusive-payload-write; spec/08 [Read-Ref-Through-Shared], spec/16 [Match-By-Ref] (D-0218, CHG-0257)
// kind: negative
// expect: diag.write-through-shared (static)
//
// A match through a shared reference binds `p` as a shared reference to
// the payload, an exclusive reference; `*p`, read through `p`, is shared,
// so `**p` cannot be written.

import std;

enum E
{
    A(ref<i32, exclusive>),
    B,
}

fn set(ref<E, shared> e)
{
    match (e)
    {
        A(p) : **p = 7,
        B    : {},
    }
}

fn main()
{
    i32 x = 0;
    E e = A(&mut x);
    set(&e);
}
