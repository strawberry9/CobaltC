// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.agg.slice [Slice-Index]; conf.slice-reborrow-parent-element-written
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// `u` reborrows `s[1 .. 2]` exclusively. Writing `s[1]` while `u` is live
// meets it. An element of a slice binding is no place the static pass
// names, so the run checks the write (D-0291); before D-0291 `cobc` decided
// the program and wrote with no check.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 5);
    Vec::push(&mut v, 6);
    auto s = &mut v[0 .. 2];
    auto u = &mut s[1 .. 2];
    s[1] = 3;
    u[0] = 1;
    printf("%v\n", v[1]);
}
