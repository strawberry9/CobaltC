// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: conf.direct-call-owned-locals; [Standing-Local] H5, [Borrow], [Release] (D-0209, CHG-0247)
// kind: positive
// expect: ok
// expect-stdout-hex: 362035203820340a
//
// A function that reads or writes its reference parameter directly
// (D-0188) called on borrows of the caller's own locals: an element of a
// local Vec, an element of a local array, a plain local. The storage is
// the caller's, which no other thread can reach, so a compiler may run
// the direct body with no entry test (cobc calls the direct twin itself,
// D-0209); the results are those of the checked body.

import std;

fn step(ref<i32, exclusive> a)
{
    *a = *a + 1;
}

fn peek(ref<i32, shared> a) : i32
{
    *a
}

fn main()
{
    Vec<i32> v = Vec::new();
    foreach (i in 0..4: i32) { Vec::push(&mut v, i); }
    array<i32, 3> arr = [1, 2, 3];
    i32 x = 5;
    foreach (t in 0..3)
    {
        foreach (i in 0..Vec::len(&v)) { step(&mut v[i]); }
        step(&mut arr[1]);
        step(&mut x);
    }
    printf("%v %v %v %v\n", peek(&v[3]), peek(&arr[1]), peek(&x), Vec::len(&v));
}
