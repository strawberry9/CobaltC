// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Read-Conflict] (`¬clash(a, shared)`), D-0107 (activation at first use); conf.state-and-own-field-input-rejected
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 3420390a
//
// `copy_in(&mut x, &x.b[0..4])`: the input slice is a range of the
// state's own field. The first call, with a separate input, completes;
// the second clashes at the first read of `s[i]`, which overlaps the
// live exclusive path to `x`. (D-0188: the entry test of a dual body
// finds the overlap and runs the checked body, which faults here.)

import std;

struct Buf
{
    array<u8, 16> b;
    usize n;
}

fn copy_in(ref<Buf, exclusive> d, slice<u8, shared> s)
{
    for (usize i = 0; i < slice_len(s) && d.n < 16; i += 1)
    {
        d.b[d.n] = s[i];
        d.n += 1;
    }
}

fn main()
{
    Buf x = Buf { .b = [1; 16], .n = 0 };
    array<u8, 4> other = [9; 4];
    copy_in(&mut x, &other[0..$]);
    printf("%u %u\n", x.n, x.b[0]);
    copy_in(&mut x, &x.b[0..4]);
    printf("%u\n", x.n);
}
