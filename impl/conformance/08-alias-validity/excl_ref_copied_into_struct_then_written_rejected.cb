// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.control.flow-analysis (spec/14 §6), D-0071 (CHG-0439): a write through an exclusive reference while a struct holds a copy of it; conf.excl-ref-copied-into-struct-then-written
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// A copy of an exclusive reference is an exclusive borrow of its referent,
// in a struct as in a binding (`n = m`): while `h` is used, `*m` is not
// written through `m`.

import std;

struct H
{
    ref<i32, exclusive> m;
}

fn main()
{
    i32 a = 0;
    ref<i32, exclusive> m = &mut a;
    H h = H { .m = m };
    *m = 5;
    *h.m = 6;
    printf("%v\n", a);
}
