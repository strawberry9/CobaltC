// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.agg.slice `[Slice-Form]`, [Read-Conflict]; conf.overlapping-slice-arguments-rejected
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 302031300a
//
// Two slices of one `Vec`, the first exclusive: `0..4` beside `4..8`
// are disjoint and the call completes; `0..4` beside `2..6` overlap,
// and the body's first access clashes (D-0188, as
// conf.state-and-own-field-input-rejected).

import std;

fn mix(slice<u8, exclusive> d, slice<u8, shared> s)
{
    for (usize i = 0; i < slice_len(d) && i < slice_len(s); i += 1)
    {
        d[i] = d[i] ^ s[i];
    }
}

fn main()
{
    Vec<u8> v = Vec::filled(8, 3: u8);
    v[5] = 9;
    mix(&mut v[0..4], &v[4..8]);
    printf("%u %u\n", v[0], v[1]);
    mix(&mut v[0..4], &v[2..6]);
    printf("%u\n", v[0]);
}
