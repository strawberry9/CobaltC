// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Read-Conflict], D-0107; conf.state-and-field-of-state-rejected
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// `bump_all(&mut p, &p.n)`: a shared reference to a field of the struct
// the exclusive one reaches whole. The body's first access through
// either clashes with the other (D-0188, as
// conf.state-and-own-field-input-rejected).

import std;

struct Pair
{
    array<u8, 4> a;
    u32 n;
}

fn bump_all(ref<Pair, exclusive> p, ref<u32, shared> k)
{
    p.n = p.n + *k;
}

fn main()
{
    Pair p = Pair { .a = [1; 4], .n = 7 };
    bump_all(&mut p, &p.n);
    printf("%u\n", p.n);
}
