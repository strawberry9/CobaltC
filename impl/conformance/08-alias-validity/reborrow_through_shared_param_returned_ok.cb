// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: conf.reborrow-through-shared-param-returned; spec/08 rule.alias.borrow, spec/09 [Ref-Deref-Place] (D-0218, CHG-0257)
// kind: positive
// expect: ok
// expect-stdout-hex: 310a310a
//
// `&*s.inner` is a shared borrow of the exclusive path `S` holds; returned
// and dereferenced at once (`*give(&s)`), its ancestry runs back to that
// path, which is therefore no competitor. `coby` lost the ancestry of such
// a temporary reference before the read was checked, and faulted.

import std;

struct S
{
    ref<i32, exclusive> inner;
}

fn give(ref<S, shared> s) : ref<i32, shared>
{
    &*s.inner
}

fn main()
{
    i32 x = 1;
    S s = S { .inner = &mut x };
    printf("%v\n", *give(&s));
    printf("%v\n", *give(&s));
}
