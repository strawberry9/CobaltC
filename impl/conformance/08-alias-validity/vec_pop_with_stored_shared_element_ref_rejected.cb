// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: conf.vec-pop-stored-shared-element-ref; spec/20 [Release], "Reclaimed objects" (D-0214, CHG-0252)
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// As `conf.vec-pop-stored-element-ref`, with a shared reference kept: the
// element popped ends, and reading through the kept reference is stale.
//
// D-0290: the reference is stored by a call (`keep_in`), so the frame holds it
// only as `?` (it may hold none of it), and the run checks the access; the
// same program storing it directly is refuted before the run.

import std;

fn keep_in(ref<Vec<ref<i32, shared>>, exclusive> keep, ref<i32, shared> r)
{
    Vec::push(keep, r);
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    Vec::push(&mut v, 3);
    Vec<ref<i32, shared>> keep = Vec::new();
    keep_in(&mut keep, &v[2]);
    auto t = Vec::pop(&mut v);
    printf("popped %v, %v left\n", Option::unwrap(t), Vec::len(&v));
    printf("%v\n", *keep[0]);
}
