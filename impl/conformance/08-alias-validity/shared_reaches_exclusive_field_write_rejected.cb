// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: conf.shared-reaches-exclusive-field-write; spec/08 [Read-Ref-Through-Shared] (D-0218, CHG-0257)
// kind: negative
// expect: diag.write-through-shared (static)
//
// A function given `ref<S, shared>` writes through the exclusive reference
// `S` holds. What a shared reference reaches is read-only at every depth:
// `s.inner`, read through the shared `s`, is a shared reference, so
// `*s.inner` is a place reached through a shared path and cannot be
// written.

import std;

struct S
{
    ref<i32, exclusive> inner;
}

fn bump(ref<S, shared> s)
{
    *s.inner = *s.inner + 1;
}

fn main()
{
    i32 x = 0;
    S s = S { .inner = &mut x };
    bump(&s);
}
