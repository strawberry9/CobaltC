// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: conf.direct-argument-lent-by-sibling-argument; [Standing-Local] H2/H3 at the arrival, [Write-Conflict] (D-0209, CHG-0342)
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// `g(&mut x, spawn(f, &x))`: the exclusive argument is borrowed first
// (pending until the call binds it, so the spawn's shared lend of the
// same local is not refused), then the lend is made, then `g` is
// entered with both alive. The arrival test of an elided parameter is
// made at the entry, after every argument (`spec/08` §4), so `g`'s
// write through `p` finds the lent path and faults, as a checked write
// does. The reader waits on a static flag before it reads, so it is
// alive at the write under every schedule; `g` would raise the flag
// after its write.

import std;

static Atomic<u64> GO = 0;

fn g(ref<i32, exclusive> p, handle<void> h) : i32
{
    *p = 1;                         // ✗ the spawned reader holds `x`
    Atomic::store(&GO, 1);
    join(h);
    *p
}

fn f(ref<i32, shared> q)
{
    while (Atomic::load(&GO) == 0)
    {
        sleep_ms(1);
    }
    printf("f sees %v\n", *q);
}

fn main()
{
    i32 x = 0;
    i32 r = g(&mut x, spawn(f, &x));
    printf("r %v\n", r);
}
