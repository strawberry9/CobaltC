// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.resauth.destroy [Destroy-Not-Solitary]
// kind: negative
// expect: diag.destroy-while-aliased (static)
//
// Same regression, for `solitary`: passing `r` to Vec::len (which
// auto-derefs it) used to leave `r`'s token recorded against the Vec's
// place, so a following `drop(v)` found the object "solitary" and
// destroyed it while `r` was still held; the later use then faulted as
// a stale binding instead of the destroy itself being refused.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    auto r = &v;
    usize n = Vec::len(r);
    drop(v);
    usize m = Vec::len(r);
}
