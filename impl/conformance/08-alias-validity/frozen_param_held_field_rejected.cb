// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Read-Conflict] of a field through a shared reference parameter (CHG-0237); conf.frozen-param-held-field
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// A function reads a struct's fields through a shared reference parameter
// (compiled: a frozen body chosen at entry). The caller holds an exclusive
// reference to one field, a path on the struct's own object: the shared
// borrow of the whole struct made for the call already clashes with it, so
// the fault comes before the function runs, in every tool, and no frozen
// body is ever entered. (An element held by reference is on an object of
// its own, which the borrow does not meet: conf.frozen-param-held-element.)

import std;

struct Account
{
    String name;
    u64 balance;
}

fn describe(ref<Account, shared> a) : String
{
    printf("name %s\n", &a.name);
    sprintf("%s has %v", &a.name, a.balance)
}

fn main() : u8
{
    Account a = Account { .name = String::from_str("ada"), .balance = 10 };
    Vec<ref<u64, exclusive>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &mut a.balance);
    }
    printf("%s\n", &describe(&a));
    printf("held %v\n", *held[0]);
    0
}
