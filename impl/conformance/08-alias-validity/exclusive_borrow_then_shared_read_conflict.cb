// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Borrow-Denied]
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// A live exclusive borrow excludes every other access to the same
// object, including a second, incompatible-mode borrow attempt while
// the first is still held.

fn main()
{
    i32 x = 5;
    auto r1 = &mut x;
    auto r2 = &x;
    *r1 = 6;
}
