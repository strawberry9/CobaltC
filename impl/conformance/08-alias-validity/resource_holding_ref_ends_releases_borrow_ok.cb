// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: inv.alias-validity (held-by: a path stops taking part once no live object holds it)
// kind: positive
// expect: ok
//
// A resource holding a reference is bound and then ends with its block;
// the reference it held is no longer held by anything, so writing the
// referent afterwards conflicts with nothing. (cobc once counted the
// binding's copy of the reference twice and reported a conflict here.)

resource struct Holder
{
    ref<i32, shared> r;
}

fn main()
{
    i32 y = 1;
    {
        auto h = Holder { .r = &y };
    }
    y = 2;
    if (y != 2)
    {
        1 / (1 - 1);
    }
}
