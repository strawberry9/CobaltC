// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.control.block [Ref-Binding-Last-Use] (D-0111); conf.ref-binding-used-later-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `b` is used after `String::clear(&mut cur)`, so it still holds `cur`
// there: a reference binding ends at its last use, not before.

import std;

fn main()
{
    String cur = "abc";
    slice<u8, shared> b = StringView::as_bytes(&cur);
    String::clear(&mut cur);
    printf("%v\n", slice_len(b));
}
