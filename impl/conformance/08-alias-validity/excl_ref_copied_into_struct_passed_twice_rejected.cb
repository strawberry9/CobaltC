// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.control.flow-analysis (spec/14 §6), D-0290 (CHG-0439): an exclusive reference and a struct holding a copy of it passed to one call; conf.excl-ref-copied-into-struct-passed-twice
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `h.m` is a copy of `m`, so `two` gets one exclusive reference twice.
// Both tools ran it: the struct's facts were "maybe", and at run time the
// two arguments are one reference.

import std;

fn two(ref<i32, exclusive> x, ref<i32, exclusive> y)
{
    *x = 1;
    *y = 2;
}

struct H
{
    ref<i32, exclusive> m;
}

fn main()
{
    i32 a = 0;
    ref<i32, exclusive> m = &mut a;
    H h = H { .m = m };
    two(m, h.m);
    printf("%v\n", a);
}
