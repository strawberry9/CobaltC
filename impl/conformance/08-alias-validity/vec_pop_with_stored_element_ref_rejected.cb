// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: conf.vec-pop-stored-element-ref; spec/20 [Release], "Reclaimed objects", spec/08 §4 [Standing-Local] H5 (D-0214, CHG-0252)
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// One thread: a reference to a vector's last element kept in another
// vector by a call, which the frame holds only as `?`, then the element popped.
// `pop`'s exclusive borrow of the vector does not clash with the stored
// path, which reaches the element object, not the vector; `pop` reads the
// element out and releases it, ending the object, and the stored path with
// it. Nothing else runs meanwhile, so nothing reads the element while
// `pop` does: the path is simply stale, and its next use is the fault.
//
// D-0290: the reference is stored by a call (`keep_in`), so the frame holds it
// only as `?` (it may hold none of it), and the run checks the access; the
// same program storing it directly is refuted before the run.

import std;

fn keep_in(ref<Vec<ref<i32, exclusive>>, exclusive> keep, ref<i32, exclusive> r)
{
    Vec::push(keep, r);
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    Vec::push(&mut v, 3);
    Vec<ref<i32, exclusive>> keep = Vec::new();
    keep_in(&mut keep, &mut v[2]);
    auto t = Vec::pop(&mut v);
    printf("popped %v, %v left\n", Option::unwrap(t), Vec::len(&v));
    *keep[0] = 9;
}
