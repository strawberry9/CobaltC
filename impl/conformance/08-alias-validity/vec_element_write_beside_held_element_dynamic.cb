// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Write-Conflict], rule.control.frame-references (D-0282, D-0284); conf.vec-element-write-beside-held-element-dynamic
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 370a
//
// A write to an element of a `Vec` is an exclusive access, checked against
// a live reference to an element as a borrow of it is. With the indexes
// computed, whether they are one element is a value: the first write is
// to another element and completes; the second is to the held one.

import std;

fn main()
{
    Vec<i64> v = Vec::filled(4, 7: i64);
    usize j = Vec::len(&v) - 1;
    ref<i64, shared> r = &v[j];
    v[j - 1] = 5: i64;
    printf("%v\n", *r);
    v[j * 1] = 5: i64;
    printf("%v\n", *r);
}
