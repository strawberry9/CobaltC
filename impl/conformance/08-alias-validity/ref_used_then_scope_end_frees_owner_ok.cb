// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: inv.alias-validity; rule.control.block [Block-Exit]
// kind: positive
// expect: ok
//
// The positive side of the same fix: using a reference does not make
// it conflict with itself, and once its holder's block has ended the
// owner is free again -- both for a shared reference and for an
// exclusive one used several times.

fn main()
{
    i32 x = 1;
    {
        auto r = &x;
        i32 a = *r;
        i32 b = *r;
        if (a + b != 2)
        {
            1 / (1 - 1);
        }
    }
    x = 2;
    {
        auto w = &mut x;
        *w = *w + 1;
        *w = *w + 1;
    }
    if (x != 4)
    {
        1 / (1 - 1);
    }
}
