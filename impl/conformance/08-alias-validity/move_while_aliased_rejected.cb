// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Authority-Transfer-Aliased]
// kind: negative
// expect: diag.move-while-aliased (static)
//
// A resource cannot be moved out while a live reference into it still
// exists -- moving it would leave that reference dangling.

resource struct R
{
    i32 v;
}

fn takes(R x)
{
}

fn main()
{
    R r = R { .v = 1 };
    auto ref1 = &r;
    takes(r);
}
