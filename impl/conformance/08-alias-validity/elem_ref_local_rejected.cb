// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.alias.borrow (D-0200); conf.elem-ref-local-conflict
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// A reference to an element of a local vector, and the vector then lent
// exclusively while the reference lives: the conflict is still found.

import std;

fn main() : u8
{
    Vec<i64> v = Vec::new();
    Vec::push(&mut v, 1);
    ref<i64, shared> e = &v[0];
    Vec::push(&mut v, 2);
    printf("%v\n", *e);
    0
}
