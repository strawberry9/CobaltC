// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.agg.slice `[Slice-Form]`, [Read-Conflict], rule.control.frame-references (D-0283); conf.overlapping-slice-arguments-dynamic
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 302031300a
//
// As conf.overlapping-slice-arguments-rejected, with the second range
// computed: `0..4` beside `4..8` are disjoint and the call completes;
// `0..4` beside `2..6` overlap, which only the values decide: the call
// faults when it is made (D-0283), before the body runs.

import std;

fn mix(slice<u8, exclusive> d, slice<u8, shared> s)
{
    for (usize i = 0; i < slice_len(d) && i < slice_len(s); i += 1)
    {
        d[i] = d[i] ^ s[i];
    }
}

fn main()
{
    Vec<u8> v = Vec::filled(8, 3: u8);
    v[5] = 9;
    mix(&mut v[0..4], &v[4..8]);
    printf("%u %u\n", v[0], v[1]);
    usize k = Vec::len(&v) / 4;
    mix(&mut v[0..4], &v[k..k + 4]);
    printf("%u\n", v[0]);
}
