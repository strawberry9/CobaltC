// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.alias.borrow [Borrow-Exceeds-Source] (D-0314); conf.borrow-exceeds-source-through-shared-borrow
// kind: negative
// expect: diag.borrow-exceeds-source (static)
//
// `*&x` is reached through the shared path `&x`: an exclusive slice of it is
// an exclusive borrow from a shared one. Before D-0314 the tools let
// `&mut (*&a)[0..2]` through, and the slice wrote `a`.

import std;

fn main()
{
    array<u8, 2> a = [1: u8, 2];
    slice<u8, exclusive> s = &mut (*&a)[0..2];
    s[0] = 5;
    printf("%v\n", a[0]);
}
