// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Read] through a shared reference parameter (CHG-0237); conf.frozen-param-released
// kind: positive
// expect: ok
// expect-stdout-hex: 746f74616c2032320a
//
// As `conf.frozen-param-held-element`, but the exclusive reference has
// ended before the call: every read succeeds.

import std;

fn total(ref<Vec<u64>, shared> v) : u64
{
    u64 t = 0;
    for (usize i = 0; i < Vec::len(v); i += 1)
    {
        t += v[i];
    }
    t
}

fn main() : u8
{
    Vec<u64> v = Vec::filled(4, 5: u64);
    {
        Vec<ref<u64, exclusive>> held = Vec::new();
        Vec::push(&mut held, &mut v[2]);
        *held[0] = 7;
    }
    printf("total %v\n", total(&v));
    0
}
