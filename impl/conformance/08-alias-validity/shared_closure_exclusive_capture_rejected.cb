// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: conf.shared-closure-exclusive-capture; spec/08 [Read-Fn-Through-Shared] (D-0218, CHG-0257)
// kind: negative
// expect: diag.borrow-exceeds-source (dynamic)
//
// A closure that writes its captured `x` holds an exclusive reference to
// it. Stored in a struct and called through a shared reference to the
// struct, it would write what the shared reference reaches; a `fn` type
// does not show its captures, so the call is checked where it is made.

import std;

struct H
{
    fn() : void f;
}

fn run(ref<H, shared> h)
{
    (h.f)();
}

fn main()
{
    i32 x = 0;
    {
        H h = H { .f = [x]() { x = x + 1; } };
        run(&h);
    }
    printf("%v\n", x);
}
