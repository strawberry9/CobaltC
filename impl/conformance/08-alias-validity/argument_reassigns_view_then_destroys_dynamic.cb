// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Destroy-While-Aliased], D-0007 (left-to-right evaluation), rule.control.frame-references (D-0284); conf.argument-reassigns-view-then-destroys-dynamic
// kind: negative
// expect: diag.destroy-while-aliased (dynamic)
//
// The first argument is a copy of the view `sv`. The second gives `sv` a
// new value and then destroys `text`, which the copy still reaches: the
// copy has no name the static pass follows, so the run finds it.

import std;

fn count(StringView s, usize k) : usize
{
    StringView::len(s) + k
}

fn main()
{
    String text = String::from_str("hello there, a reasonably long text");
    StringView sv = String::as_view(&text);
    usize n = count(sv, {
        sv = StringView::of("x");
        drop(text);
        0
    });
    printf("%v\n", n);
}
