// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.alias.borrow (disjoint field borrows, D-0018); conf.disjoint-field-borrows-ok
// kind: positive
// expect: ok
//
// Two exclusive borrows of two different fields of the same struct do
// not conflict -- clash is scoped by target overlap, not by shared
// ownership of the same root binding. The values are read back
// through the references (as spec/conformance.md's own case does) and
// through the owner only after the borrows' block has ended: reading
// `p.a` through the owner *while* `ra` is a live exclusive descendant
// would be [Read-Conflict] (spec/conformance.md, conf.reborrow-ok's
// derivation says so explicitly).

struct Pair
{
    i32 a;
    i32 b;
}

fn main()
{
    Pair p = Pair { .a = 1, .b = 2 };
    {
        auto ra = &mut p.a;
        auto rb = &mut p.b;
        *ra = 10;
        *rb = 20;
        if (*ra + *rb != 30)
        {
            1 / (1 - 1);
        }
    }
    if (p.a != 10)
    {
        1 / (1 - 1);
    }
    if (p.b != 20)
    {
        1 / (1 - 1);
    }
}
