// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Read-Conflict] (`¬clash(a, shared)`), rule.expr.logic; conf.implied-check-not-carried-past-label
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 310a
//
// `k > 5 && p.x > 3` never evaluates its right operand here, so the read of
// `p.x` in it is not made, and the read `i32 b = p.x;` after it is the first
// of the pass: on the second pass `keep` holds `&mut p.x` and it faults,
// before the line is printed again. Until Update 214 the compiler's pass
// that drops implied checks took the read inside the skipped operand to
// stand for the one after it, dropped that one, printed `1` twice and
// faulted only at the next borrow.

import std;

struct P
{
    i32 x;
    i32 y;
}

fn main()
{
    P p = P { .x = 1, .y = 2 };
    Option<ref<i32, exclusive>> keep = None;
    usize k = 0;
    while (k < 2)
    {
        bool big = k > 5 && p.x > 3;
        i32 b = p.x;
        printf("%d\n", b);
        if (big)
        {
            k += 1;
        }
        keep = Some(&mut p.x);
        k += 1;
    }
    match (keep)
    {
        Some(r) : *r = 5,
        None    : {},
    }
}
