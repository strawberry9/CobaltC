// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: conf.frozen-argument-lent-by-sibling-argument; [Standing-Local] H2/H3 at the arrival, [Read-Conflict] (D-0188, CHG-0342)
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// The shared twin of conf.direct-argument-lent-by-sibling-argument:
// `h(&x, spawn(w, &mut x))` lends `x` exclusively to a thread while the
// shared argument is pending, so `h`'s first read through its frozen
// parameter conflicts with the writer's path and faults; a frozen
// parameter is tested where it arrives, after every argument. The writer
// waits on a static flag before it writes, so it is alive at the read.

import std;

static Atomic<u64> GO = 0;

fn h(ref<i32, shared> p, handle<void> hd) : i32
{
    i32 a = *p;                     // ✗ the spawned writer holds `x`
    Atomic::store(&GO, 1);
    join(hd);
    a + *p
}

fn w(ref<i32, exclusive> q)
{
    while (Atomic::load(&GO) == 0)
    {
        sleep_ms(1);
    }
    *q = 5;
}

fn main()
{
    i32 x = 0;
    i32 r = h(&x, spawn(w, &mut x));
    printf("r %v\n", r);
}
