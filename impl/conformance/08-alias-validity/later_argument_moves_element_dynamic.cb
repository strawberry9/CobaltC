// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Binding-Lookup-Stale], D-0007 (left-to-right evaluation), rule.control.frame-references (D-0282, D-0284); conf.later-argument-moves-element-dynamic
// kind: negative
// expect: diag.stale-binding (dynamic)
// expect-stdout-hex: 32203120310a
//
// An argument's reference is formed before the later arguments are
// computed. `set(&mut v[0], bump(&mut v))` completes: `bump` writes the
// element but does not move it. `set(&mut v[0], grow(&mut v))` faults:
// `grow` moves the `Vec`'s storage while the element reference is
// pending, and `set` then writes through it. A lowering that leaves the
// callee's checks out must still find this (D-0284).

import std;

fn set(ref<i32, exclusive> slot, i32 value)
{
    *slot = value;
}

fn bump(ref<Vec<i32>, exclusive> v) : i32
{
    *Vec::index_exclusive(v, 0) += 1;
    2
}

fn grow(ref<Vec<i32>, exclusive> v) : i32
{
    foreach (i in 0..100)
    {
        Vec::push(v, 7);
    }
    9
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    set(&mut v[0], bump(&mut v));
    printf("%v %v %v\n", v[0], Vec::len(&v), 1);
    set(&mut v[0], grow(&mut v));
    printf("%v %v\n", v[0], Vec::len(&v));
}
