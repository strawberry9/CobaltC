// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Destroy-Not-Solitary]
// kind: negative
// expect: diag.destroy-while-aliased (static)
//
// A resource cannot be destroyed while a live reference into it still
// exists (it is used after, D-0111) -- destroying it first would leave
// that reference dangling.

resource struct R
{
    i32 v;
}

fn main()
{
    R r = R { .v = 1 };
    auto ref1 = &r;
    drop(r);
    i32 v = ref1.v;
}
