// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Binding-Lookup-Stale], D-0007 (left-to-right evaluation), rule.control.frame-references (D-0282, D-0284); conf.later-argument-replaces-vec-dynamic
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// As conf.later-argument-moves-element-dynamic, with the later argument a
// block that gives `v` a new value: the old storage, which the pending
// element reference reaches, is destroyed before `set` writes through it.

import std;

fn set(ref<i32, exclusive> slot, i32 value)
{
    *slot = value;
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    set(Vec::index_exclusive(&mut v, 0), {
        v = Vec::new();
        Vec::push(&mut v, 5);
        0
    });
    printf("%v\n", v[0]);
}
