// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.alias.borrow (persistent token_ancestors)
// kind: positive
// expect: ok
//
// A shared sub-borrow formed by dereferencing an exclusive reference
// *parameter* (&*v) must not spuriously conflict with that same
// parameter's own still-live exclusive borrow one level removed --
// the ancestor exemption must be tracked persistently per token, not
// just at the moment the sub-borrow is formed (impl/STATUS.md).

import std;

fn read_len(ref<Vec<i32>, exclusive> v) : usize
{
    auto shared_view = &*v;
    Vec::len(shared_view)
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    if (read_len(&mut v) != 2)
    {
        1 / (1 - 1);
    }
}
