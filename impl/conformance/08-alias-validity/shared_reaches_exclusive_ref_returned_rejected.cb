// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: conf.shared-reaches-exclusive-ref-returned; spec/08 [Read-Ref-Through-Shared] (D-0218, CHG-0257)
// kind: negative
// expect: diag.borrow-exceeds-source (static)
//
// The exclusive reference a struct holds, read through a shared reference
// to the struct, is a shared reference: it cannot be handed on where an
// exclusive one is expected (here, returned as one).

import std;

struct S
{
    ref<i32, exclusive> inner;
}

fn leak(ref<S, shared> s) : ref<i32, exclusive>
{
    s.inner
}

fn main()
{
    i32 x = 0;
    S s = S { .inner = &mut x };
    auto r = leak(&s);
    *r = 5;
}
