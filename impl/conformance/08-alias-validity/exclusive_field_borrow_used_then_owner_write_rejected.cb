// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.value-object.write [Write-Conflict]; conf.projection-write-while-borrowed-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// Same regression as shared_ref_used_then_owner_write_rejected.cb, for
// a projection: writing through `rb` once used to make the owner's
// later write to `p.b` skip `rb` in its clash check, leaving two live
// exclusive paths to the same cells.

struct Pair
{
    i32 a;
    i32 b;
}

fn main()
{
    Pair p = Pair { .a = 1, .b = 2 };
    auto ra = &mut p.a;
    auto rb = &mut p.b;
    *ra = 10;
    *rb = 20;
    p.b = 30;
}
