// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Read-Conflict] (`¬clash(a, shared)`), rule.control.frame-references (D-0283, point checks at the call); conf.state-and-own-field-input-dynamic
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 3420390a
//
// As conf.state-and-own-field-input-rejected, with the input range
// computed: whether it overlaps the state is decided at run time, when the
// call is made (D-0283). The first call, with a separate input, completes;
// the second faults at the call: the callee's summary reads through the
// slice, which overlaps the exclusive path to `x` passed beside it.

import std;

struct Buf
{
    array<u8, 16> b;
    usize n;
}

fn copy_in(ref<Buf, exclusive> d, slice<u8, shared> s)
{
    for (usize i = 0; i < slice_len(s) && d.n < 16; i += 1)
    {
        d.b[d.n] = s[i];
        d.n += 1;
    }
}

fn main()
{
    Buf x = Buf { .b = [1; 16], .n = 0 };
    array<u8, 4> other = [9; 4];
    copy_in(&mut x, &other[0..$]);
    printf("%u %u\n", x.n, x.b[0]);
    usize k = x.n - 4;
    copy_in(&mut x, &x.b[k..k + 4]);
    printf("%u\n", x.n);
}
