// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.alias.clash [Write-Conflict]; D-0022; rule.fail.fault-unwind [Fault-Unwind]; conf.vec-grow-fault-intact
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 5b64726f7020315d
//
// `Vec::push` through an exclusive parameter, bound beside a shared
// reference to the same `Vec` (D-0022: the conflict surfaces at the
// first conflicting access), faults at the growth's write of `v.ptr`,
// after the new cells are allocated. The fault leaves the `Vec` as it
// was: its old cells are freed exactly once, by the unwind's `Vec::drop`
// (CHG-0332: both tools once freed them before the write's check, so a
// fault there freed them twice; the sanitizer run of the fuzzer saw it).
// The resource's destructor shows the unwind ran.
import std;

resource struct R
{
    i64 id;
}

fn R::drop(ref<R, exclusive> self)
{
    printf("[drop %v]", self.id);
}

fn grow_through(ref<Vec<i64>, exclusive> e, ref<Vec<i64>, shared> s) : usize
{
    Vec::push(e, 4: i64);
    Vec::len(s)
}

fn main() : u8
{
    R a = R { .id = 1: i64 };
    Vec<i64> full = Vec::filled(3, 2: i64);
    usize n = grow_through(&mut full, &full);
    printf("unreached %v\n", n);
    0
}
