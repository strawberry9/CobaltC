// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Read-Conflict] (`¬clash(a, shared)`), rule.control.while; conf.implied-check-not-carried-into-loop
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 3120310a
//
// The read of `p.x` before the loop and the one at the top of its body are
// the same check, but the body's end comes back to its top: on the second
// pass `keep` holds `&mut p.x`, so the read `i32 b = p.x;` faults there,
// before the line is printed again. Until Update 213 the compiler's pass
// that drops implied checks carried the first read into the loop, dropped
// the second, printed `1 1` twice and faulted only at the next borrow.

import std;

struct P
{
    i32 x;
    i32 y;
}

fn main()
{
    P p = P { .x = 1, .y = 2 };
    Option<ref<i32, exclusive>> keep = None;
    i32 a = p.x;
    usize k = 0;
    while (k < 2)
    {
        i32 b = p.x;
        printf("%d %d\n", a, b);
        keep = Some(&mut p.x);
        k += 1;
    }
    match (keep)
    {
        Some(r) : *r = 5,
        None    : {},
    }
}
