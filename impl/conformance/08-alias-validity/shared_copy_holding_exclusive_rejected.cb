// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: conf.shared-copy-holding-exclusive; spec/08 [Read-Exclusive-Through-Shared] (D-0218, CHG-0257)
// kind: negative
// expect: diag.borrow-exceeds-source (static)
//
// A copy of a struct that holds an exclusive reference, read through a
// shared reference to it, would carry a writer out of what the shared
// reference reaches: rejected. (A copy out of a place the program owns is
// allowed, and `[Thread-Affine]` and `clash` govern the copies.)

import std;

struct S
{
    ref<i32, exclusive> inner;
}

fn dup(ref<S, shared> s) : S
{
    *s
}

fn main()
{
    i32 x = 0;
    S s = S { .inner = &mut x };
    S t = dup(&s);
    *t.inner = 9;
}
