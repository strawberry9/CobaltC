// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: conf.shared-vec-of-exclusive-refs-write; spec/08 [Read-Ref-Through-Shared] (D-0218, CHG-0257)
// kind: negative
// expect: diag.write-through-shared (static)
//
// An element of a `Vec` reached through a shared reference is read-only,
// and so is what an exclusive reference stored in it reaches: `v[0]` is
// read as a shared reference, and `*v[0]` cannot be written.

import std;

fn bump(ref<Vec<ref<i32, exclusive>>, shared> v)
{
    *v[0] = *v[0] + 1;
}

fn main()
{
    i32 x = 0;
    Vec<ref<i32, exclusive>> v = Vec::new();
    Vec::push(&mut v, &mut x);
    bump(&v);
}
