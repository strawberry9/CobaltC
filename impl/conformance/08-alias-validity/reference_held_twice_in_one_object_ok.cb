// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: conf.reference-held-twice-in-one-object; rule.value-object.write [Write] (kept), state.access-paths held-by (D-0215, CHG-0253)
// kind: positive
// expect: ok
// expect-stdout-hex: 3720380a3720380a
//
// One reference stored twice in one object -- in two fields of a struct,
// in two elements of an array -- and one copy overwritten: the object
// still holds the reference in the other place, so the reference stays
// valid and reads through it go on working. [Write] releases the object
// as a holder only when no copy is left anywhere in it.

import std;

struct Two
{
    ref<i32, shared> a;
    ref<i32, shared> b;
}

fn main()
{
    i32 x = 7;
    i32 y = 8;
    Two t = Two { .a = &x, .b = &y };
    t.b = t.a;
    t.a = &y;
    printf("%v %v\n", *t.b, *t.a);

    array<ref<i32, shared>, 2> arr = [&y, &y];
    arr[1] = arr[0];
    arr[0] = &x;
    arr[0] = arr[0];
    arr[1] = arr[1];
    printf("%v %v\n", *arr[0], *arr[1]);
}
