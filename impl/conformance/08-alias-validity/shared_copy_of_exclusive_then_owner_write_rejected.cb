// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: conf.shared-copy-of-exclusive-then-owner-write; spec/08 [Read-Ref-Through-Shared] (D-0218, CHG-0257)
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// `give` hands out the exclusive reference `S` holds as a shared one: a
// shared borrow of it. While that borrow lives, a write through the
// exclusive reference clashes with it, as a write through any reference
// clashes with a live shared borrow of it.

import std;

struct S
{
    ref<i32, exclusive> inner;
}

fn give(ref<S, shared> s) : ref<i32, shared>
{
    s.inner
}

fn main()
{
    i32 x = 1;
    S s = S { .inner = &mut x };
    auto r = give(&s);
    *s.inner = 5;
    printf("%v\n", *r);
}
