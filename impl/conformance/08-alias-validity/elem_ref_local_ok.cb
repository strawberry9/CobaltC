// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.alias.borrow (D-0200); conf.elem-ref-local
// kind: positive
// expect: ok
// expect-stdout-hex: 6120313020382031300a6220363420382036340a39390a
//
// References to elements of local vectors held in locals: read and written
// through, lent to readers and writers, nested indexing, fields, compound
// assignment.

import std;

struct Col
{
    String name;
    i64 sum;
    i64 count;
}

fn total(ref<Col, shared> c) : i64
{
    c.sum
}

fn bump(ref<Col, exclusive> c, i64 by)
{
    c.sum += by;
    c.count += 1;
}

fn main() : u8
{
    Vec<Col> cols = Vec::new();
    Vec::push(&mut cols, Col { .name = "a", .sum = 0, .count = 0 });
    Vec::push(&mut cols, Col { .name = "b", .sum = 0, .count = 0 });
    Vec<Vec<i64>> rows = Vec::new();
    for (i64 r = 0; r < 4; r += 1)
    {
        Vec<i64> row = Vec::new();
        Vec::push(&mut row, r);
        Vec::push(&mut row, r * 10);
        Vec::push(&mut rows, row);
    }
    for (usize r = 0; r < Vec::len(&rows); r += 1)
    {
        for (usize k = 0; k < 2; k += 1)
        {
            ref<i64, shared> v = &rows[r][k];
            ref<Col, exclusive> c = &mut cols[k];
            c.sum += *v;
            c.count = c.count + 1;
            bump(c, 1);
        }
    }
    for (usize k = 0; k < 2; k += 1)
    {
        ref<Col, shared> c = &cols[k];
        printf("%v %v %v %v\n", &c.name, c.sum, c.count, total(c));
    }
    ref<i64, exclusive> x = &mut rows[3][1];
    *x = 99;
    printf("%v\n", rows[3][1]);
    0
}
