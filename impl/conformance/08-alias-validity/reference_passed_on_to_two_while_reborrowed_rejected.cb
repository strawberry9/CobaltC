// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: rule.value-object.write [Write-Conflict]; spec/08 §4 [Standing-Local] H3 (D-0219, CHG-0258); conf.reference-passed-on-while-reborrowed; conf.reference-passed-on-to-two-while-reborrowed
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// As `reference_passed_on_while_reborrowed_rejected.cb`, through a function
// of two exclusive references. `cobc` runs such a function by one of two
// bodies, choosing the unchecked one when its arguments are disjoint from
// each other; it did not ask whether each was clash-free with the other
// live paths, so the write went past the live shared reborrow of `r`.

import std;

fn two(ref<i32, exclusive> a, ref<i32, exclusive> b)
{
    *a = *a + 1;
    *b = *b + 10;
}

fn main()
{
    i32 x = 1;
    i32 y = 2;
    auto r = &mut y;
    auto s = &*r;
    i32 before = *s;
    two(r, &mut x);
    printf("%v %v %v\n", before, *s, x);
}
