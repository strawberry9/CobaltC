// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Spawn], [Read] through shared reference parameters in several threads (CHG-0237, D-0205); conf.frozen-param-threads
// kind: positive
// expect: ok
// expect-stdout-hex: 6f6e6520746872656164203136363833332c20666f75722074687265616473203136363833330a
//
// Four threads sum bands of one vector of rows the main thread owns, each
// through a shared reference parameter, handing each row to a function that
// keeps nothing of it: the same totals as one thread, every run.

import std;

struct Row
{
    String region;
    u64 amount;
}

fn amount_if(ref<Row, shared> r, StringView region) : u64
{
    if (String::as_view(&r.region) == region) { r.amount } else { 0 }
}

fn band(ref<Vec<Row>, shared> rows, usize lo, usize hi) : u64
{
    u64 t = 0;
    for (usize i = lo; i < hi; i += 1)
    {
        t += amount_if(&rows[i], "north");
    }
    t
}

fn main() : u8
{
    Vec<Row> rows = Vec::new();
    foreach (i in 0..1000: u64)
    {
        Vec::push(
            &mut rows,
            Row { .region = String::from_str(if (i % 3 == 0) { "north" } else { "south" }), .amount = i },
        );
    }
    u64 one = band(&rows, 0, 1000);
    Vec<handle<u64>> hs = Vec::new();
    foreach (k in 0..4)
    {
        Vec::push(&mut hs, spawn(band, &rows, k * 250, k * 250 + 250));
    }
    u64 four = 0;
    foreach (h in hs)
    {
        four += join(h);
    }
    printf("one thread %v, four threads %v\n", one, four);
    0
}
