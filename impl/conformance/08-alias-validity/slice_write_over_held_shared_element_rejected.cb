// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Write-Conflict], rule.agg.slice; conf.slice-write-over-held-shared-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 746f74616c20382c2068656c6420320a616674657220612077726974652062657369646520697420313020320a
//
// A shared reference to v[1] is live. Reading it through a slice is
// permitted, and writing v[2..4] through another slice touches other
// elements; writing v[0..2] reaches v[1] and meets its shared path:
// [Write-Conflict] at that write.

import std;

fn total(slice<i64, shared> s) : i64
{
    i64 t = 0;
    for (usize i = 0; i < slice_len(s); i += 1)
    {
        t += s[i];
    }
    t
}

fn bump(slice<i64, exclusive> s)
{
    for (usize i = 0; i < slice_len(s); i += 1)
    {
        s[i] += 1;
    }
}

fn main() : u8
{
    Vec<i64> v = Vec::filled(4, 2: i64);
    Vec<ref<i64, shared>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &v[1]);
    }
    printf("total %v, held %v\n", total(&v[0..4]), *held[0]);
    bump(&mut v[2..4]);
    printf("after a write beside it %v %v\n", total(&v[0..4]), *held[0]);
    bump(&mut v[0..2]);
    printf("not reached %v\n", *held[0]);
    0
}
