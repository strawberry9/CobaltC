// CONFORMANCE-CASE
// spec: 08-alias-validity
// facility: [Read-Conflict], rule.agg.slice, D-0188; conf.slice-read-beside-held-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 6265666f726520310a
//
// An exclusive reference to v[1] is live when a slice over v[0..4] is
// read, first by a function taking state and the slice (a dual body,
// D-0188), then by one taking the slice alone (its elements read without
// the slice's own check). The read of s[1] meets the element's object and
// its exclusive path: [Read-Conflict], at the first such read. (cobc
// missed this through every slice read until 2026-10-08: the slice's
// check concerns the slice's object, not the element's.)

import std;

struct Acc
{
    i64 sum;
}

fn feed(ref<Acc, exclusive> a, slice<i64, shared> s)
{
    for (usize i = 0; i < slice_len(s); i += 1)
    {
        a.sum += s[i];
    }
}

fn total(slice<i64, shared> s) : i64
{
    i64 t = 0;
    for (usize i = 0; i < slice_len(s); i += 1)
    {
        t += s[i];
    }
    t
}

fn main() : u8
{
    Vec<i64> v = Vec::filled(4, 2: i64);
    Vec<ref<i64, exclusive>> held = Vec::new();
    if (arg_count() < 100)
    {
        Vec::push(&mut held, &mut v[1]);
    }
    printf("before %v\n", Vec::len(&held));
    Acc a = Acc { .sum = 0 };
    if (arg_count() < 50)
    {
        feed(&mut a, &v[0..4]);
    }
    printf("mid %v\n", a.sum);
    printf("total %v\n", total(&v[0..4]));
    *held[0] = 5;
    0
}
