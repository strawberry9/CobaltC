// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.assert [Assert-Fail]; rule.fail.fault-unwind; D-0065; conf.assert-fails
// kind: negative
// expect: diag.assert-failed (dynamic)
//
// A false condition is a checked fault reporting the formatted message
// (here with an `@` in it); the program unwinds, destroying `k`.

import std;

resource struct Noisy
{
    i32 id;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("drop %v\n", self.id);
}

fn main()
{
    Noisy k = Noisy { .id = 7 };
    String who = "user@example";
    usize cap = 3;
    usize n = 5;
    assert(n <= cap, "n = %v exceeds cap %v for %v", n, cap, &who);
    printf("not reached\n");
}
