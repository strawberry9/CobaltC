// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.fault-unwind [Fault-Unwind]; D-0022; conf.fault-unwind-callee-tail-conflict
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 5b64726f7020335d5b64726f7020315d
//
// A fault raised as a callee's tail place flows out of its frame (the
// `[Read]` of a parameter bound pending, D-0022, whose conflict with the
// exclusive argument beside it surfaces at this first access) unwinds
// every frame, `main`'s included: its resources' destructors run, in
// reverse order, before the program terminates (`[Fault-Unwind]`).
import std;

resource struct R
{
    i64 id;
}

fn R::drop(ref<R, exclusive> self)
{
    printf("[drop %v]", self.id);
}

fn first(ref<Vec<i64>, shared> s, ref<Vec<i64>, exclusive> e) : i64
{
    s[0]
}

fn main() : u8
{
    R a = R { .id = 1: i64 };
    Vec<i64> v = Vec::filled(2, 7: i64);
    R c = R { .id = 3: i64 };
    i64 n = first(&v, &mut v);
    printf("unreached %v\n", n);
    0
}
