// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.assert [Assert]; D-0065; conf.assert-holds
// kind: positive
// expect: ok
// expect-stdout-hex: 63616c6c7320310a
//
// A true condition does nothing more: it is evaluated exactly once, and
// the message's arguments are not evaluated at all.

import std;

fn bump(ref<i32, exclusive> n) : bool
{
    *n = *n + 1;
    true
}

fn expensive(ref<i32, exclusive> n) : i32
{
    *n = *n + 100;
    *n
}

fn main()
{
    i32 calls = 0;
    assert(bump(&mut calls), "never shown %v", expensive(&mut calls));
    assert(calls == 1, "bump ran %v times", calls);
    usize cap = 3;
    usize n = 2;
    assert(n <= cap, "n = %v exceeds cap %v", n, cap);
    printf("calls %v\n", calls);
}
