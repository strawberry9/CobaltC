// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.fault-unwind [Fault-Unwind], [Fault-Contain] with rule.conc.spawn [Spawn]; conf.fault-ends-pending-spawn-argument
// kind: positive
// expect: ok
// expect-stdout-hex: 5b656e642074656d705d5b656e64206d6f7665645d5b656e64206b6570745d206f6b2031310a5b656e642074656d705d5b656e64206d6f7665645d5b656e64206b6570745d206661696c65640a
//
// A fault raised while `spawn`'s arguments are still being evaluated, in a
// thread that contains it: the value built for an earlier argument, a
// temporary of the statement, is destroyed by the unwind, as a call's is
// (`conf.fault-ends-pending-argument`); a value moved from a local into an
// earlier argument is destroyed too. `coby` left both undestroyed
// (CHG-0420); `cobc` destroyed them.

import std;

resource struct Tag
{
    String name;
}

fn Tag::drop(ref<Tag, exclusive> self)
{
    printf("[end %v]", &self.name);
}

fn label(Tag t, Tag u, usize n) : usize
{
    StringView::len(&t.name) + StringView::len(&u.name) + n
}

fn refuse(usize n) : usize
{
    assert(n != 7, "refused %v", n);
    n
}

fn late(usize n) : usize
{
    Tag kept = Tag { .name = String::copy("kept") };
    Tag moved = Tag { .name = String::copy("moved") };
    join(spawn(label, moved, Tag { .name = String::copy("temp") }, refuse(n)))
}

fn main()
{
    foreach (n in [2: usize, 7])
    {
        match (try_join(spawn(late, n)))
        {
            Ok(k)  : printf(" ok %v\n", k),
            Err(_) : printf(" failed\n"),
        }
    }
}
