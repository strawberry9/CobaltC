// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.assert [Assert-Fail], what a failure shows (D-0322); conf.assert-and-terms-in-order
// kind: negative
// expect: diag.assert-failed (dynamic)
// expect-stdout-hex: 6669727374207365636f6e640a
//
// `assert(p && q, …)` tests `p`, then `q` only when `p` holds, as `&&` does;
// the fault is the first false term's. Here `first` holds, `second` does
// not, and `third` is never called.

import std;

fn first() : bool
{
    printf("first ");
    true
}

fn second() : bool
{
    printf("second\n");
    false
}

fn third() : bool
{
    printf("third\n");
    true
}

fn main()
{
    assert(first() && second() && third(), "a term was false");
}
