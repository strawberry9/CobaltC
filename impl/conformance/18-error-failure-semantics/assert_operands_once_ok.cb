// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.assert [Assert], what a failure shows (D-0322); conf.assert-operands-once
// kind: positive
// expect: ok
// expect-stdout-hex: 6e203320742031330a
//
// An assertion that compares two scalars binds its operands to show them if
// it fails: each is still evaluated exactly once, the left before the right,
// as the comparison evaluates them, and a true one does nothing more.

import std;

fn bump(ref<i32, exclusive> n) : i32
{
    *n = *n + 1;
    *n
}

fn main()
{
    i32 n = 0;
    i32 t = 0;
    assert(bump(&mut n) < 10);
    assert(bump(&mut n) == 2 && bump(&mut n) != 0);
    // The left operand is read before the right one changes it.
    t = 3;
    assert(t + 10 == bump(&mut t) + 9);
    printf("n %v t %v\n", n, t + 9);
}
