// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.propagate [Propagate-Option] (CHG-0438): `None?` where the function returns a `Result`; conf.propagate-open-option-in-result
// kind: negative
// expect: diag.propagate-outside-fallible-context (static)
//
// `None` is an `Option` whatever its payload, so `?` on it would return
// `None` from a function that returns a `Result`.

import std;

fn f() : Result<i32, str>
{
    i32 x = None?;
    Ok(x)
}

fn main()
{
    match (f())
    {
        Ok(v)  : printf("%v\n", v),
        Err(e) : printf("%s\n", e),
    }
}
