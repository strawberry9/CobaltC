// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.propagate [Propagate]; rule.agg.match (a temporary scrutinee ends with its statement)
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// `peek(s)?` is `match (peek(s)) { Ok(v) : v, … }`: the `Result` (which
// owns nothing) is copied out of and stays, a temporary of the enclosing
// statement, so the reference it holds is live through the outer
// `match`'s arm, where `take(s)` writes `s.v` through `&mut`. `cobc` had
// it; `coby` ended the `Result` at the `?` and ran on. Found by
// real-world testing.

import std;

struct S
{
    Option<i32> v;
}

fn peek(ref<S, exclusive> s) : Result<ref<Option<i32>, shared>, i32>
{
    Ok(&s.v)
}

fn take(ref<S, exclusive> s) : Option<i32>
{
    replace(&mut s.v, None)
}

fn f(ref<S, exclusive> s) : Result<i32, i32>
{
    match (peek(s)?)
    {
        Some(3) :
        {
            take(s);
            return Ok(1);
        },
        _ :
        {
        },
    }
    Ok(0)
}

fn main()
{
    S s = S { .v = Some(3) };
    i32 r = Result::unwrap_or(f(&mut s), 9);
}
