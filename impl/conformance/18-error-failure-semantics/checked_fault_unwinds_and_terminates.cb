// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.fault-unwind [Fault-Unwind]; D-0009
// kind: negative
// expect: diag.div-by-zero (dynamic)
//
// A checked fault is fatal: it unwinds every enclosing frame (running
// destructors along the way) and terminates the whole program -- it
// is never catchable, unlike Result/? recoverable failure.

import std;

fn d(i32 a, i32 b) : i32
{
    a / b
}

fn main()
{
    Vec<i32> v = Vec::new();
    d(1, 0);
}
