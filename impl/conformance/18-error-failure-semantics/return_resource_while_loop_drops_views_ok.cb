// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fn.return with a resource result while `[Block-Exit]` destroys a consumed `foreach`'s remaining elements
// kind: positive
// expect: ok
//
// `return Err(sprintf(…))` from inside `foreach (v in StringView::split(…))`
// with elements still unvisited: the returned `String` is on its way out
// while the loop's remaining views are destroyed, by code that itself
// passes values between calls. cobc's runtime gave the destructor the
// caller's queue of values in transit, so it took the returned value for
// its own and stopped ("receive of reference data that was not sent").
// Found by real-world testing (an assembler reporting an unknown
// instruction on its first line).

import std;

fn first_word_error(ref<String, shared> s) : Result<usize, String>
{
    foreach (v in StringView::split(&s[0..$], " "))
    {
        if (StringView::len(v) > 0)
        {
            return Err(sprintf("unknown %s", &String::from_view(v)));
        }
    }
    Ok(0)
}

fn main()
{
    String s = "frob r1 r2\n";
    match (first_word_error(&s))
    {
        Ok(_)  : assert(false),
        Err(e) : assert(String::eq_str(&e, "unknown frob")),
    }
}
