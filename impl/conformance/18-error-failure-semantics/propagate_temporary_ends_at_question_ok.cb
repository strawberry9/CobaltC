// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.propagate [Propagate] (a temporary operand ends at the `?`); D-0060; conf.propagate-temporary-consumed
// kind: positive
// expect: ok
//
// `match (peek(s)?)` where `peek` returns `Result<ref<…>, _>`: `?` consumes
// the temporary `Result`, so only the reference it held remains -- the
// match's scrutinee, which binds nothing in the arm taken -- and the arm
// may change `s` through `&mut`, as `match (peek_ref(s))` may. A named
// `Result` is copied out of and stays usable.

import std;

struct S
{
    Option<i32> v;
}

fn peek(ref<S, exclusive> s) : Result<ref<Option<i32>, shared>, i32>
{
    Ok(&s.v)
}

fn take(ref<S, exclusive> s) : Option<i32>
{
    replace(&mut s.v, None)
}

fn f(ref<S, exclusive> s) : Result<i32, i32>
{
    match (peek(s)?)
    {
        Some(3) :
        {
            take(s);
            return Ok(1);
        },
        _       :
        {
        },
    }
    Ok(0)
}

fn g() : Result<i32, i32>
{
    Result<i32, i32> r = Ok(5);
    i32 a = r?;
    i32 b = r?;
    Ok(a + b)
}

fn main()
{
    S s = S { .v = Some(3) };
    if (Result::unwrap_or(f(&mut s), 9) != 1 || s.v != None || Result::unwrap_or(g(), 0) != 10)
    {
        1 / (1 - 1);
    }
}
