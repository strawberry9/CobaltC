// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.fault-unwind [Fault-Unwind]; conf.fault-unwind-first-fault
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
// expect-stdout-hex: 696e6e65720a
//
// A fault unwinds its thread, running destructors, and the program
// reports that fault. Here the unwind runs `inner`'s `Noisy` (which
// prints), then `Bad`'s destructor, which itself faults: the reported
// fault is still the first one, and nothing is destroyed after the
// second (`main`'s `Noisy` prints nothing).

import std;

resource struct Bad
{
    i32 z;
}

fn Bad::drop(ref<Bad, exclusive> self)
{
    i32 q = 10 / self.z;
    printf("never %v\n", q);
}

resource struct Noisy
{
    str name;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("%s\n", self.name);
}

fn inner(i32 k) : i32
{
    Bad b = Bad { .z = 0 };
    Noisy n = Noisy { .name = "inner" };
    Vec<i32> v = Vec::new();
    v[narrow<usize>(k)]
}

fn main()
{
    Noisy m = Noisy { .name = "main" };
    printf("%v\n", inner(3));
}
