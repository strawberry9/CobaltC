// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: [Propagate]
// kind: positive
// expect: ok
//
// `?` on Ok unwraps and continues; on Err it returns early with the
// same Err, preserving the Result<T,E> type through the early return.

import std;

fn parse(u8 b) : Result<i32, i32>
{
    if (b > 9)
    {
        return Err(1);
    }
    Ok(widen<i32>(b))
}

fn sum(u8 a, u8 b) : Result<i32, i32>
{
    auto va = parse(a)?;
    auto vb = parse(b)?;
    Ok(va + vb)
}

fn main()
{
    match (sum(3, 4))
    {
        Ok(v) :
        {
            if (v != 7)
            {
                1 / (1 - 1);
            }
        },
        Err(_) :
        {
            1 / (1 - 1);
        },
    }
    match (sum(3, 20))
    {
        Ok(_) :
        {
            1 / (1 - 1);
        },
        Err(e) :
        {
            if (e != 1)
            {
                1 / (1 - 1);
            }
        },
    }
}
