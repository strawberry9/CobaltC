// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.fault-unwind [Fault-Unwind] (D-0315); conf.fn-parameter-closure-fault-unwinds
// kind: negative
// expect: diag.assert-failed (dynamic)
// expect-stdout-hex: 5b656e64207374657020305d5b656e64207374657020315d5b656e6420656163685d5b656e64206361705d5b656e64206f757465725d370a5b656e64207374657020305d5b656e64207374657020315d5b656e64207374657020325d5b656e64207374657020335d5b656e6420656163685d5b656e64206361705d5b656e64206f757465725d5b656e64206d61696e5d
//
// A fault inside a closure called through a `fn` parameter the callee only
// calls: the unwind ends the callee's own locals, then the closure the
// parameter holds (bound first), then the callers' locals, innermost first.

import std;

resource struct Noisy
{
    String name;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("[end %v]", &self.name);
}

fn owner(StringView name) : fn(i64) : i64
{
    Noisy n = Noisy { .name = String::copy(name) };
    move [n](i64 v) : i64
    {
        assert(v < 3, "refused %v", v);
        v + reinterpret<i64>(StringView::len(&n.name))
    }
}

fn each(fn(i64) : i64 f, i64 n) : i64
{
    Noisy e = Noisy { .name = "each" };
    i64 t = 0;
    for (i64 i = 0; i < n; i += 1)
    {
        Noisy step = Noisy { .name = sprintf("step %v", i) };
        t += f(i);
    }
    t
}

fn outer(i64 n) : i64
{
    Noisy o = Noisy { .name = "outer" };
    each(owner("cap"), n)
}

fn main()
{
    Noisy m = Noisy { .name = "main" };
    printf("%v\n", outer(2));
    printf("%v\n", outer(5));
}
