// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.propagate [Propagate-Option-Mismatch] (D-0130); conf.propagate-option-in-result-rejected
// kind: negative
// expect: diag.propagate-outside-fallible-context (static)
//
// `?` on an `Option` returns `None`, so it belongs in a function that
// returns an `Option`. In one returning a `Result` nothing converts the
// two: `Option::ok_or(o, e)?` names the error to return.

import std;

fn byte_at(str s, usize i) : Option<u8>
{
    if (i < str_len(s)) { Some(str_byte(s, i)) } else { None }
}

fn first_two(str s) : Result<u8, str>
{
    u8 b = Option::ok_or(byte_at(s, 0), "empty")?;     // the bridge: fine
    u8 c = byte_at(s, 1)?;                              // rejected
    Ok(b + c)
}

fn main()
{
    printf("%v\n", Result::unwrap_or(first_two("ab"), 0));
}
