// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.propagate; rule.agg.match [Match] (a `?` result as the scrutinee)
// kind: positive
// expect: ok
//
// `match (g()?)`: the value `?` takes out of `Ok` is itself an enum, and
// `match` reads its variant. `coby` gave `?`'s value no type, and faulted
// `diag.type-mismatch` (found by showcase/tier7/records.cb); `cobc` was
// right.

import std;

fn g(bool some) : Result<Option<i32>, i32>
{
    if (some)
    {
        Ok(Some(3))
    }
    else
    {
        Ok(None)
    }
}

fn f(bool some) : Result<i32, i32>
{
    i32 r = match (g(some)?)
    {
        Some(r) : r,
        None : return Ok(-1),
    };
    Ok(r * 2)
}

fn main()
{
    if (Result::unwrap_or(f(true), 0) != 6 || Result::unwrap_or(f(false), 0) != -1)
    {
        1 / (1 - 1);
    }
}
