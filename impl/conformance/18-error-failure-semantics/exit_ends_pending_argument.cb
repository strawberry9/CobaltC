// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.stdlib.process [Exit], rule.fn.program [Terminate-Exit] (D-0150) with rule.control.stmt (a statement's temporaries); conf.exit-ends-pending-argument
// kind: positive
// expect: exit 3
// expect-stdout-hex: 5b64726f70203930315d5b64726f7020355d5b64726f702031325d
//
// An `exit` called while a call's arguments are still being evaluated: the
// resource built for an earlier argument (`R { .id = 5 }`, a temporary of
// the statement) is destroyed by the unwind, after the faulting callee's
// own locals and before the caller's locals, as every destructor D-0008
// would run runs. `coby` left it undestroyed (CHG-0339); `cobc` destroyed
// it. Found by the fuzzer's fault-unwinding mode (seed 14, program 152).

import std;

resource struct R
{
    i64 id;
}

fn R::drop(ref<R, exclusive> self)
{
    printf("[drop %v]", self.id);
}

fn boom(i64 x) : i64
{
    R keep = R { .id = 900 + x };
    Vec<i64> z = Vec::new();
    exit(3)
}

fn take(R a, R b, i64 n) : i64
{
    a.id + b.id + n
}

fn main()
{
    R v = R { .id = 12 };
    i64 got = take(v, R { .id = 5 }, boom(1));
    printf("got %v\n", got);
}
