// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.propagate [Propagate] (D-0273); conf.propagate-moves-resource-binding
// kind: positive
// expect: ok
// expect-stdout-hex: 636f62616c7420352039206e6f0a
//
// `x?` on a binding that holds a resource moves the binding, as passing it
// by value does (D-0273): the payload is the `?`'s value, and `x` is
// consumed. A `Result` of a `String`, an `Option` of a `Vec`, and a
// `Result` whose error is the resource; a binding that holds no resource
// is read and stays (`n?` twice, `n : Option<i32>`).

import std;

fn text() : Result<String, String>
{
    Result<String, String> r = Ok(String::from_str("cobalt"));
    String s = r?;
    Ok(s)
}

fn total() : Option<i32>
{
    Option<Vec<i32>> o = Some(Vec::filled(3, 2));
    Vec<i32> v = o?;
    Some(v[0] + v[1] + v[2] - 1)
}

fn pair() : Option<i32>
{
    Option<i32> n = Some(1);
    i32 a = n?;
    i32 b = n?;
    Some(a + b)
}

fn count() : Result<i32, String>
{
    Result<i32, String> r = Ok(7);
    i32 k = r?;
    Ok(k + Option::unwrap_or(pair(), 0))
}

fn failing() : Result<i32, String>
{
    Result<i32, String> r = Err(String::from_str("no"));
    i32 k = r?;
    Ok(k)
}

fn main() : u8
{
    match (text())
    {
        Ok(s)  : printf("%s ", &s),
        Err(_) : printf("? "),
    }
    printf("%v ", Option::unwrap_or(total(), 0));
    match (count())
    {
        Ok(k)  : printf("%v ", k),
        Err(_) : printf("? "),
    }
    match (failing())
    {
        Ok(_)  : printf("?\n"),
        Err(e) : printf("%s\n", &e),
    }
    0
}
