// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.assert [Assert-Fail], what a failure shows (D-0322); conf.assert-shows-values
// kind: negative
// expect: diag.assert-failed (dynamic)
//
// A failed comparison of two scalars reports both values: `assertion
// failed: 7 == 8` (compiled_suite holds cobc's report to coby's, text and
// location).

import std;

fn seven() : u64
{
    7
}

fn main()
{
    u64 eight = 8;
    assert(seven() == eight);
}
