// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.propagate [Propagate] (a struct or array payload); D-0084 `&f()?` as an argument
// kind: positive
// expect: ok
//
// `f()?` whose payload is a `Vec`, a struct or an array: iterated by
// `foreach`, bound, projected (`pair()?.a`), borrowed as an argument
// (`Vec::len(&names()?)`), and as a statement of its own (the payload, a
// resource, is destroyed at once). coby gave such a payload as a bare
// value, which does not say what type it is, and `foreach (s in f()?)`
// faulted `diag.type-mismatch`. Found by real-world testing (a
// directory walker's `list_dir(dir)?`).

import std;

resource struct Noisy
{
    u32 id;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("drop %d\n", self.id);
}

struct Pair
{
    u32 a;
    u32 b;
}

fn names() : Result<Vec<String>, str>
{
    Vec<String> v = Vec::new();
    Vec::push(&mut v, String::from_str("x"));
    Vec::push(&mut v, String::from_str("yz"));
    Ok(v)
}

fn noisy(u32 i) : Option<Noisy>
{
    Some(Noisy { .id = i })
}

fn pair() : Option<Pair>
{
    Some(Pair { .a = 3, .b = 4 })
}

fn arr() : Option<array<u8, 3>>
{
    Some([1, 2, 3])
}

fn count() : Result<usize, str>
{
    usize n = 0;
    foreach (s in names()?)
    {
        n += String::len(&s);
    }
    Vec<String> v = names()?;
    n += Vec::len(&v);
    n += Vec::len(&names()?);
    Ok(n)
}

fn run() : Option<u32>
{
    noisy(1)?;
    Noisy k = noisy(2)?;
    u32 s = pair()?.a + pair()?.b;
    array<u8, 3> a = arr()?;
    assert(k.id == 2 && s == 7 && a[2] == 3);
    Some(noisy(3)?.id)
}

fn main()
{
    assert(Result::unwrap(count()) == 7);
    assert(Option::unwrap(run()) == 3);
}
