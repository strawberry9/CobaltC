// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.fault-unwind [Fault-Unwind], [Block-Exit] (D-0315); conf.unwind-order-mixed-tables-and-frames
// kind: negative
// expect: diag.assert-failed (dynamic)
// expect-stdout-hex: 5b63325d5b63315d5b62325d5b62315d5b61325d5b61315d5b6d61696e5d
//
// A fault three calls deep, where the bodies alternate between locals the
// compiler ends itself (noted in a table) and a body that keeps a run-time
// object (a local a closure borrows): the unwind ends every local once,
// innermost body first and last bound first within each, as `[Block-Exit]`
// orders them.

import std;

resource struct Noisy
{
    String name;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("[%v]", &self.name);
}

fn make(StringView name) : Noisy
{
    Noisy { .name = String::copy(name) }
}

fn level3(i64 k) : i64
{
    Noisy c1 = make("c1");
    Noisy c2 = make("c2");
    assert(k < 0, "refused %v", k);
    k
}

fn level2(i64 k) : i64
{
    Noisy b1 = make("b1");
    fn() : usize peek = [b1]() : usize { StringView::len(&b1.name) };
    Noisy b2 = make("b2");
    level3(k + reinterpret<i64>(peek()))
}

fn level1(i64 k) : i64
{
    Noisy a1 = make("a1");
    Noisy a2 = make("a2");
    level2(k)
}

fn main()
{
    Noisy m = make("main");
    printf("%v\n", level1(1));
}
