// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.fault-unwind [Fault-Unwind]; D-0022; conf.fault-unwind-callee-tail-conflict-dynamic
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 5b64726f7020335d5b64726f7020315d
//
// As conf.fault-unwind-callee-tail-conflict, with the two references
// chosen by indexes the program computes and the shared one kept in a
// struct, so the overlap is found by the run when the call is made (D-0283;
// D-0290: the references a struct argument keeps are checked there): the
// fault unwinds every frame, `main`'s included, and its resources'
// destructors run in reverse order before the program terminates
// (`[Fault-Unwind]`).

import std;

resource struct R
{
    i64 id;
}

fn R::drop(ref<R, exclusive> self)
{
    printf("[drop %v]", self.id);
}

struct Held
{
    ref<Vec<i64>, shared> s;
}

fn first(ref<Vec<i64>, exclusive> e, Held h) : i64
{
    (*h.s)[0]
}

fn main() : u8
{
    R a = R { .id = 1: i64 };
    Vec<Vec<i64>> vs = Vec::new();
    Vec::push(&mut vs, Vec::filled(2, 7: i64));
    R c = R { .id = 3: i64 };
    usize i = Vec::len(&vs) - 1;
    usize j = i * 1;
    i64 n = first(&mut vs[j], Held { .s = &vs[i] });
    printf("unreached %v\n", n);
    0
}
