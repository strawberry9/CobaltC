// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.propagate [Propagate-Option] (CHG-0438): `?` returns from the closure around it; conf.propagate-in-closure
// kind: negative
// expect: diag.propagate-outside-fallible-context (static)
//
// `?` inside the closure returns from the closure, whose result is an
// `i32`: it was checked against `f`'s `Option` and accepted.

import std;

fn f() : Option<i32>
{
    Option<i32> o = None;
    auto c = [o]() : i32 { o? + 1 };
    Some(c() * 2)
}

fn main()
{
    printf("%v\n", Option::is_some(&f()));
}
