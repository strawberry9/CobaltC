// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.fault-unwind contained; [Fault-Contain]; rule.alias.thread-affine; D-0204, D-0237; conf.thread-taking-over-path-not-contained
// kind: negative
// expect: diag.div-by-zero (dynamic)
//
// The first thread returns a `Vec` holding the exclusive reference to `x` it
// was lent; `main` moves it to a second thread, which was lent nothing. Its
// write through the reference takes the path over (`[Thread-Affine]`), so
// it is not contained (D-0237): its fault ends the program, and `try_join`
// never hands it over. Before D-0237 the fault was contained and `main` went
// on with `x` changed by a failed thread.

import std;

fn make(ref<i32, exclusive> a) : Vec<ref<i32, exclusive>>
{
    Vec<ref<i32, exclusive>> v = Vec::new();
    Vec::push(&mut v, a);
    v
}

fn use_it(Vec<ref<i32, exclusive>> v, i32 d)
{
    *v[0] = 7;
    i32 z = 1 / d;
    printf("%v\n", z);
}

fn main()
{
    i32 x = 0;
    auto h1 = spawn(make, &mut x);
    Vec<ref<i32, exclusive>> got = join(h1);
    auto h2 = spawn(use_it, got, 0);
    auto r = try_join(h2);
    printf("%v %v\n", x, Result::is_err(&r));
}
