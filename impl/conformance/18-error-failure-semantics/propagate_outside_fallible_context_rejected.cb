// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.propagate [Propagate-Err-Mismatch]
// kind: negative
// expect: diag.propagate-outside-fallible-context (static)
//
// `?` requires the enclosing function's own return type to be
// Result<_, E> with E exactly matching the propagated Result's own
// error type. Using `?` in a plain i32-returning function was
// previously silently accepted.

import std;

fn f() : i32
{
    Result<i32, i32> r = Ok(1);
    r?
}

fn main()
{
    f();
}
