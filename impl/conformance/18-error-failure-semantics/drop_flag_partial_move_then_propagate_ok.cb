// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.propagate [Propagate], [Let-Destructure], [Block-Exit] (D-0315); conf.drop-flag-partial-move-then-propagate
// kind: positive
// expect: ok
// expect-stdout-hex: 5b615d5b62625d206f6b2031330a5b615d5b62625d2065727220726566757365640a5b615d5b62625d206661696c65640a
//
// A value taken apart, one part moved into a call, then `?` leaving early:
// the moved part ends once, in the callee; the other ends at the `?`'s
// return, at the body's end, or at a fault, once.

import std;

resource struct Noisy
{
    String name;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("[%v]", &self.name);
}

resource struct Pair
{
    Noisy a;
    Noisy b;
}

fn make(StringView name) : Noisy
{
    Noisy { .name = String::copy(name) }
}

fn take(Noisy n) : usize
{
    StringView::len(&n.name)
}

fn check(u8 at) : Result<usize, String>
{
    if (at == 1)
    {
        return Err(String::copy("refused"));
    }
    Ok(10)
}

fn part(u8 at) : Result<usize, String>
{
    Pair p = Pair { .a = make("a"), .b = make("bb") };
    Pair { a, b } = p;
    usize n = take(a);
    usize m = check(at)?;
    assert(at != 2, "at 2");
    Ok(n + m + StringView::len(&b.name))
}

fn main()
{
    foreach (at in [0: u8, 1, 2])
    {
        match (try_join(spawn(part, at)))
        {
            Ok(Ok(v))  : printf(" ok %v\n", v),
            Ok(Err(e)) : printf(" err %v\n", &e),
            Err(_)     : printf(" failed\n"),
        }
    }
}
