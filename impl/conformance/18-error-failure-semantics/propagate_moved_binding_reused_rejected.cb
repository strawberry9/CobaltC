// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.propagate [Propagate] (D-0273); conf.propagate-moved-binding-reused
// kind: negative
// expect: diag.stale-binding (static)
//
// `r?` moves `r`, which holds a resource (D-0273), so a second `r?` uses a
// binding that no longer holds a value, as a second move of it would.

import std;

fn twice() : Result<String, String>
{
    Result<String, String> r = Ok(String::from_str("a"));
    String s = r?;
    String t = r?;
    Ok(t)
}

fn main() : u8
{
    match (twice())
    {
        Ok(_)  : {},
        Err(_) : {},
    }
    0
}
