// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.propagate on Option (`?` returns None from the enclosing function)
// kind: positive
// expect: ok

import std;

fn add_all(i64 a, i64 b, i64 c) : Option<i64>
{
    i64 ab = checked_add(a, b)?;
    Some(checked_add(ab, c)?)
}

fn main()
{
    i64 max = 9223372036854775807;
    bool ok = match (add_all(1, 2, 3))
    {
        Some(v) : v == 6,
        None : false,
    };
    bool overflowed = match (add_all(max, 1, 0))
    {
        Some(_) : false,
        None : true,
    };
    if (!ok || !overflowed)
    {
        1 / (1 - 1);
    }
}
