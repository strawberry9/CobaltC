// CONFORMANCE-CASE
// spec: 18-error-failure-semantics
// facility: rule.fail.propagate (D-0315); conf.propagate-memory-only-payloads
// kind: positive
// expect: ok
// expect-stdout-hex: 646565702031300a64656570206661696c65643a20706169723a206e65676174697665202d340a616c6c20676f6f640a636865636b3a206e65676174697665202d310a
//
// `?` on results whose payloads free memory alone (a tree of boxes, a
// `String`, `void`), in bindings, arguments, a `match`'s value and a loop;
// every value arrives whole and every error leaves whole.

import std;

enum Tree
{
    Leaf(i64),
    Node(Pair),
}

struct Pair
{
    Box<Tree> left;
    Box<Tree> right;
}

fn leaf(i64 v) : Result<Tree, String>
{
    if (v < 0)
    {
        return Err(sprintf("negative %v", v));
    }
    Ok(Tree::Leaf(v))
}

fn pair(i64 a, i64 b) : Result<Tree, String>
{
    Tree l = leaf(a)?;
    Ok(Tree::Node(Pair { .left = Box::new(l), .right = Box::new(leaf(b)?) }))
}

fn sum(ref<Tree, shared> t) : i64
{
    match (t)
    {
        Leaf(v) : *v,
        Node(p) : sum(Box::get(&p.left)) + sum(Box::get(&p.right)),
    }
}

fn check_all(usize n) : Result<void, String>
{
    foreach (i in 0..n)
    {
        leaf(5 - narrow<i64>(i))?;
    }
    Ok(())
}

fn deep(i64 a) : Result<i64, String>
{
    Tree t = match (pair(a, a + 1))
    {
        Ok(t)  : t,
        Err(e) : { return Err(sprintf("pair: %v", &e)); },
    };
    Ok(sum(&t) + sum(&pair(1, 2)?))
}

fn main()
{
    match (deep(3))
    {
        Ok(v)  : printf("deep %v\n", v),
        Err(e) : printf("deep failed: %v\n", &e),
    }
    match (deep(-4))
    {
        Ok(v)  : printf("deep %v\n", v),
        Err(e) : printf("deep failed: %v\n", &e),
    }
    match (check_all(4))
    {
        Ok(_)  : printf("all good\n"),
        Err(e) : printf("check: %v\n", &e),
    }
    match (check_all(9))
    {
        Ok(_)  : printf("all good\n"),
        Err(e) : printf("check: %v\n", &e),
    }
}
