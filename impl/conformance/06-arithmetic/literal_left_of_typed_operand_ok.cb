// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.literal [Literal-Type-From-Context] (the other operand, either side)
// kind: positive
// expect: ok
//
// An unsuffixed literal takes the other operand's determined type
// whichever side it is on; a literal has no effects, so evaluating
// the right operand first to learn that type is unobservable.

fn main()
{
    u8 d = 7;
    u8 z = 48 + d;
    if (z != 55)
    {
        1 / (1 - 1);
    }
    i64 big = 5000000000;
    if (1 + big != 5000000001)
    {
        1 / (1 - 1);
    }
    if (5000000000 != big)
    {
        1 / (1 - 1);
    }
}
