// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.alt (wrapping_add)
// kind: positive
// expect: ok
//
// wrapping_add is the explicit escape hatch from checked arithmetic:
// 255u8 wrapping-added to 1 must wrap to 0, not fault.

fn main()
{
    if (wrapping_add(255: u8, 1: u8) != 0)
    {
        1 / (1 - 1);
    }
}
