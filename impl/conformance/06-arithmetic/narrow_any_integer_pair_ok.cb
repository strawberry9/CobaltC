// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.convert [Narrow-Checked] [Narrow-Wrapping] (conf.narrow-contained-ok)
// kind: positive
// expect: ok
//
// `narrow` and `narrow_wrapping` take any two integer types (D-0027),
// including where every value fits. That is how a program converts
// between `usize` and a fixed-width type whatever the address width.

import std;

fn check(bool ok)
{
    i32 z = if (ok)
    {
        1
    }
    else
    {
        0
    };
    1 / z;
}

fn main()
{
    usize n = 12;
    check(narrow<u64>(n) == 12);
    check(narrow<usize>(12: u64) == n);
    check(narrow<i64>(5: i32) == 5);
    check(narrow_wrapping<u64>(200: u8) == 200);
    check(narrow<i32>(-7: i64) == -7);
}
