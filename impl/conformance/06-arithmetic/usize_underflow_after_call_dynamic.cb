// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.checked [Arith-Checked-Overflow]
// kind: negative
// expect: diag.arith-overflow (dynamic)
//
// `Vec::len(&v) - 1` on an empty vector underflows `usize`. The fault is
// the subtraction's, reported at its own line, although its left operand
// was a call whose body ran last.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    usize last = Vec::len(&v) - 1;
}
