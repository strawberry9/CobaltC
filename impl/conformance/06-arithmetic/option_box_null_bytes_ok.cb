// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.representation [Repr-Enum] [Layout-Enum-Niche]; conf.option-box-null-bytes
// kind: positive
// expect: ok
// expect-stdout-hex: 747275652074727565207472756520350a
//
// D-0298: the image of an `Option<Box<T>>` is the `Box`'s pointer: null
// for `None`, the boxed value's address for `Some`. Read through a
// `rawptr` to the `Option`'s cells, as C code given the address would read
// it (`spec/20`), `None` is C's `NULL` and `Some(b)` is `b`'s address.

import std;

fn main()
{
    Option<Box<i64>> none = None;
    i64 five = 5;
    Option<Box<i64>> some = Some(Box::new(five));
    rawptr<rawptr<i64>> pn = reinterpret_ptr<rawptr<i64>>(rawptr_of(&none));
    rawptr<rawptr<i64>> ps = reinterpret_ptr<rawptr<i64>>(rawptr_of(&some));
    // trusted by the test: the Option's cells are its own binding's, live for the reads below
    unsafe
    {
        rawptr<i64> a = *pn;
        rawptr<i64> b = *ps;
        bool same = false;
        if (Some(bx) = &some)
        {
            same = b == rawptr_of(Box::get(bx));
        }
        printf("%v %v %v %v\n", is_null(a), !is_null(b), same, *b);
    }
}
