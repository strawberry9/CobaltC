// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.shift (D-0086); conf.shift-binds-tighter-than-bitor, conf.shift-binds-tighter-than-bitand, conf.shift-looser-than-additive
// kind: positive
// expect: ok
//
// A shift binds tighter than `&`, `^` and `|` and looser than `+`/`-`
// (D-0086), as in C and Rust: packing, masking and testing a bit read as
// they are written.

import std;

fn main() : u8
{
    u32 hi = 0x12;
    u32 lo = 0x34;
    if (hi << 8 | lo != 0x1234) { return 1; }
    u32 x = 0xAB;
    if (x >> 4 & 0xF != 0xA) { return 2; }
    u32 flags = 0b0100;
    u32 n = 2;
    if (flags & 1 << n == 0) { return 3; }
    if (1: u32 << n + 1 != 8) { return 4; }
    if (hi << 4 ^ lo << 4 != 0x260) { return 5; }
    0
}
