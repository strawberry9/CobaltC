// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.alt [T-Alt]; [Literal-Out-Of-Range]
// kind: negative
// expect: diag.literal-out-of-range (static)
//
// The literal takes the other operand's type, u8 here, and 300 does not
// fit it.

import std;

fn main()
{
    u8 x = 1;
    wrapping_add(x, 300);
}
