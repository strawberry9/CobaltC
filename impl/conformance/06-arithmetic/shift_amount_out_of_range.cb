// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: [Shift-Amount-Invalid]
// kind: negative
// expect: diag.shift-amount-out-of-range (dynamic)
//
// Shifting a u32 by 32 (its own bitwidth) is out of range: only
// 0..bitwidth(tau) is a legal shift amount.

fn shl(u32 v, u32 amount) : u32
{
    v << amount
}

fn main()
{
    shl(1, 32);
}
