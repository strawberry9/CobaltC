// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: conf.shift-width-edges; rule.arith.shift [Shl-Checked], [Shr-Checked], [Shift-Amount-Invalid] (D-0208, CHG-0246)
// kind: negative
// expect: diag.shift-amount-out-of-range (dynamic)
// expect-stdout-hex: 2d32313437343833363438202d31203932323333373230333638353437373538303820323134373438333634380a
//
// Shifts by exactly bitwidth - 1 are in range: a signed 1 << 31 is the
// minimum (the high bits are discarded by definition, not a range
// fault), -8 >> 31 keeps the sign, and 1: u64 << 63 is the top bit.
// A shift by the bit width itself, with a computed amount, faults at
// run time where the constant form (conf.shift-out-of-range) is rejected
// statically.

import std;

fn s(u32 n) : u32
{
    1: u32 << n
}

fn main()
{
    i32 a = 1: i32 << 31: u32;
    i32 b = -8: i32 >> 31: u32;
    u64 c = 1: u64 << 63: u32;
    printf("%v %v %v %v\n", a, b, c, s(31));
    printf("%v\n", s(32));
}
