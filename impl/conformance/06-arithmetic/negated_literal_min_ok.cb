// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.literal [Literal-Negated] (conf.negated-literal-signed-mins)
// kind: positive
// expect: ok
//
// `-L` with the minus applied directly to an integer literal is
// range-checked as the one value -val(L), so every signed type's
// minimum is written the usual way even though its magnitude does not
// fit the type.

import std;

fn check(bool ok)
{
    i32 z = if (ok)
    {
        1
    }
    else
    {
        0
    };
    1 / z;
}

fn main()
{
    i8 a = -128;
    i16 b = -32768;
    i32 c = -2147483648;
    i64 d = -9223372036854775808;
    i128 e = -170141183460469231731687303715884105728;
    check(a + 127 == -1);
    check(b + 32767 == -1);
    check(c + 2147483647 == -1);
    check(d + 9223372036854775807 == -1);
    check(e + 170141183460469231731687303715884105727 == -1);
    check(-2147483648 < -2147483647);
    check(- 2147483648 == -2147483648: i32);
    check(-9223372036854775808: i64 < 0);
}
