// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: conf.impl-defined-width-observed; [Sizeof-Addr] (outcome: impl-defined), term.implementation-dependent-program, term.portable-program (D-0206, CHG-0239)
// kind: positive
// expect: ok
// expect-stdout-hex: 3820747275650a
//
// An implementation-independent program whose output is not portable:
// the first value is sizeof<usize>(), AddrWidth/8 -- `8` where
// AddrWidth = 64, `4` where it is 32; the second is a relation every
// conforming implementation satisfies, so it is `true` everywhere.

import std;

fn main()
{
    usize w = sizeof<usize>();
    bool portable = w == sizeof<rawptr<u8>>() && w == sizeof<ref<i32, shared>>() && w >= 2;
    printf("%v %v\n", w, portable);
}
