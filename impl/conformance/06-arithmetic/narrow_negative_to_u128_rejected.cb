// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.convert [Narrow-Overflow] (into u128)
// kind: negative
// expect: diag.narrowing-overflow (dynamic)
//
// i64's domain is not a subset of u128's, so the conversion is a
// checked narrowing, and a negative value does not fit. (The value comes
// through a parameter: with a literal-bound local the failure is found
// statically, conf.narrow-constant-static.)

fn to_u128(i64 x) : u128
{
    narrow<u128>(x)
}

fn main()
{
    u128 u = to_u128(-5);
}
