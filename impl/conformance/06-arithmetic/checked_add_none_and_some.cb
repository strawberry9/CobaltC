// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.alt (checked_add)
// kind: positive
// expect: ok
//
// checked_add returns None on overflow and Some(v) otherwise, letting
// a program recover from an overflow without a checked fault.

import std;

fn main()
{
    match (checked_add(255: u8, 1: u8))
    {
        Some(_) :
        {
            1 / (1 - 1);
        },
        None : {},
    }
    match (checked_add(1: u8, 1: u8))
    {
        Some(v) :
        {
            if (v != 2)
            {
                1 / (1 - 1);
            }
        },
        None :
        {
            1 / (1 - 1);
        },
    }
}
