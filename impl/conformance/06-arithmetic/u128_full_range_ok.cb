// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: type.u128; rule.arith.checked, rule.arith.alt, rule.arith.convert, rule.arith.cmp over the whole represented domain
// kind: positive
// expect: ok
//
// u128's represented domain is [0, 2^128-1]; values above 2^127-1
// were previously rejected as out of range (a representation limit,
// now fixed: the payload is the bit pattern, operated on as u128).

import std;

fn check(bool ok)
{
    i32 z = if (ok)
    {
        1
    }
    else
    {
        0
    };
    1 / z;
}

fn main()
{
    u128 big = 340282366920938463463374607431768211455;
    u128 half = 170141183460469231731687303715884105728;
    check(big > half);
    check(half + (half - 1) == big);
    check(wrapping_add(big, 1: u128) == 0);
    check(saturating_add(big, 5: u128) == big);
    check(big / half == 1);
    check(big % half == half - 1);
    check(narrow<u64>(half >> 64) == 9223372036854775808);
    check(widen<u128>(1: u64) + half > half);
    u8 small = 200;
    check(widen<u128>(small) == 200);
    check(to_int<u128>(to_float<f64>(half)) == half);
    match (checked_add(big, 1: u128))
    {
        Some(_) : { check(false); },
        None : {},
    }
}
