// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.checked [Arith-Checked]
// kind: negative
// expect: diag.arith-overflow (dynamic)
//
// The `i = i + 1` in the body is the inner `i`'s, which the loop test
// does not bound: it overflows at once.

import std;

fn main()
{
    i32 i = 0;
    while (i < 5)
    {
        i32 i = max_value<i32>();
        i = i + 1;
    }
}
