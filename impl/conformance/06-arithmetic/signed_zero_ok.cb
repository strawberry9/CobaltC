// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: conf.signed-zero; rule.arith.cmp, rule.arith.neg, rule.stdlib.print (D-0208, CHG-0246)
// kind: positive
// expect: ok
// expect-stdout-hex: 747275652066616c7365202d302e30202d302e3020747275650a
//
// IEEE 754's negative zero: it compares equal to 0.0 and not below it,
// prints with its sign, and dividing by it gives negative infinity.

import std;

fn z() : f64
{
    0.0
}

fn main()
{
    f64 n = -z();
    bool eq = n == 0.0;
    bool lt = n < 0.0;
    printf("%v %v %v %v %v\n", eq, lt, n, -0.0, 1.0 / n < 0.0);
}
