// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: conf.ref-byte-image-width; spec/06 §7 byte view, [Repr-Ref], [Repr-Rawptr], [Copy-Raw] (D-0206, CHG-0243)
// kind: positive
// expect: ok
// expect-stdout-hex: 38203820370a
//
// A reference's cells, copied whole, render the AddrWidth/8-byte image of
// its referent's address: exactly sizeof<ref<i32, shared>>() bytes, byte
// for byte the image a rawptr to the same object has. Prints the width,
// how many of its bytes agree, and the referent: `8 8 7` where
// AddrWidth = 64.

import std;

fn main()
{
    i32 x = 7;
    ref<i32, shared> r = &x;
    rawptr<i32> p = rawptr_of(r);
    array<u8, 16> buf = [0:u8; 16];
    usize n = sizeof<ref<i32, shared>>();
    unsafe
    {
        rawptr<u8> src = reinterpret_ptr<u8>(rawptr_of(&r));
        rawptr<u8> dst = reinterpret_ptr<u8>(rawptr_of(&mut buf));
        copy_raw(dst, src, n);
        rawptr<u8> q = reinterpret_ptr<u8>(rawptr_of(&p));
        usize same = 0;
        usize i = 0;
        while (i < n)
        {
            if (*(q + narrow<isize>(i)) == buf[i])
            {
                same = same + 1;
            }
            i = i + 1;
        }
        printf("%v %v %v\n", n, same, *r);
    }
}
