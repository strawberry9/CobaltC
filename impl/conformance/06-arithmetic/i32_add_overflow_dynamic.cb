// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.checked [Arith-Checked-Overflow]; conf.06-i32-add-overflow-dynamic
// kind: negative
// expect: diag.arith-overflow (dynamic)
//
// Both operands arrive as function parameters, so the static
// flow-analysis pass cannot refute the overflow ahead of time; the
// dynamic checked-arithmetic guard must catch it at run time instead.

fn add(i32 a, i32 b) : i32
{
    a + b
}

fn main()
{
    add(2147483647, 1);
}
