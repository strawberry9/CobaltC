// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.checked (IEEE 754 float comparison)
// kind: positive
// expect: ok
//
// NaN compares unequal to itself under == and equal under != per
// IEEE 754, exactly as spec/06 requires -- not the reflexive equality
// every other type in the language has.

fn nan() : f64
{
    auto zero = 0.0;
    zero / zero
}

fn main()
{
    auto n = nan();
    if (n == n)
    {
        1 / (1 - 1);
    }
    if (!(n != n))
    {
        1 / (1 - 1);
    }
}
