// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.checked [Arith-Checked]
// kind: negative
// expect: diag.arith-overflow (dynamic)
//
// Two `+= 1` per iteration: the loop test bounds only the first, and
// the second overflows when the first reaches the maximum.

import std;

fn main()
{
    i32 k = max_value<i32>() - 3;
    while (k < max_value<i32>())
    {
        k += 1;
        k += 1;
    }
}
