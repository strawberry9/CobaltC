// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: [Neg-Overflow]
// kind: negative
// expect: diag.arith-overflow (dynamic)
//
// Negating i32::MIN overflows i32's represented domain (its magnitude
// has no positive representation), caught dynamically since the
// operand arrives through a function parameter.

fn ng(i32 m) : i32
{
    -m
}

fn main()
{
    ng(-2147483647 - 1);
}
