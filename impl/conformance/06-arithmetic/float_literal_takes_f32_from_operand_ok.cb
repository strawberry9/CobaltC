// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.literal [Literal-Type-From-Context] (the other operand, either side)
// kind: positive
// expect: ok
//
// An unsuffixed float literal next to an f32 operand is an f32, on
// either side and when negated; next to an f64, or alone, it is f64.

fn main()
{
    f32 a = 2.5: f32;
    if (!(1.0 < a) || !(a > -1.0) || !(-1.0 < a))
    {
        1 / (1 - 1);
    }
    if (a * 2.0 - 1.0 != 4.0 || 3.0 - a != 0.5 || (2.0) * a != 5.0)
    {
        1 / (1 - 1);
    }
    if (to_int<i64>(a * 1000.0 + 0.5) != 2500)
    {
        1 / (1 - 1);
    }
    f64 b = 2.5;
    if (1.0 + b != 3.5)
    {
        1 / (1 - 1);
    }
}
