// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.limits [Min-Value] [Max-Value] (conf.limits-values)
// kind: positive
// expect: ok
//
// `min_value<τ>()` and `max_value<τ>()` are the bounds of every integer
// type's represented domain, the address-width types included, and a
// generic body may produce a limit of its own `T`.

import std;

fn check(bool ok)
{
    i32 z = if (ok)
    {
        1
    }
    else
    {
        0
    };
    1 / z;
}

fn or_max<T>(Option<T> r) : T
{
    match (r)
    {
        Some(x) : x,
        None : max_value<T>(),
    }
}

fn main()
{
    check(min_value<i8>() == -128);
    check(max_value<i8>() == 127);
    check(min_value<i16>() == -32768);
    check(max_value<i16>() == 32767);
    check(min_value<i32>() == -2147483648);
    check(max_value<i32>() == 2147483647);
    check(min_value<i64>() == -9223372036854775808);
    check(max_value<i64>() == 9223372036854775807);
    check(min_value<i128>() == -170141183460469231731687303715884105728);
    check(max_value<i128>() == 170141183460469231731687303715884105727);
    check(min_value<u8>() == 0);
    check(max_value<u8>() == 255);
    check(max_value<u16>() == 65535);
    check(max_value<u32>() == 4294967295);
    check(max_value<u64>() == 18446744073709551615);
    check(min_value<u128>() == 0);
    check(max_value<u128>() == 340282366920938463463374607431768211455);
    check(min_value<usize>() == 0);
    check(max_value<usize>() == ~(0: usize));
    check(max_value<isize>() == reinterpret<isize>(max_value<usize>() >> 1));
    check(min_value<isize>() == -max_value<isize>() - 1);
    check(wrapping_add(max_value<i32>(), 1) == min_value<i32>());
    check(or_max(checked_add(max_value<u8>(), 1: u8)) == 255);
    check(or_max(checked_add(2: i64, 3)) == 5);
}
