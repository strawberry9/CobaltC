// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.bitwise `[Count-Ones]`, `[Leading-Zeros]`, `[Trailing-Zeros]`, `[Rotate]` (D-0123); conf.bit-counts, conf.bit-rotate
// kind: positive
// expect: ok

import std;

fn ones<T: integer>(T x) : u32
{
    count_ones(x)
}

fn main()
{
    assert(count_ones(0xF0F0: u16) == 8 && count_ones(-1: i8) == 8 && count_ones(0: u128) == 0 && ones(255: u8) == 8);
    assert(leading_zeros(1: u32) == 31 && leading_zeros(0: u8) == 8 && leading_zeros(1: u128) == 127 && leading_zeros(-1: i64) == 0);
    assert(trailing_zeros(8: u64) == 3 && trailing_zeros(0: i16) == 16 && trailing_zeros(rotate_left(1: u128, 100)) == 100);
    assert(rotate_left(0x80: u8, 1) == 1 && rotate_right(1: u8, 1) == 128 && rotate_left(1: i32, 31) == -2147483648);
    assert(rotate_left(0xABCD: u16, 20) == 0xBCDA && rotate_right(0xABCD: u16, 16) == 0xABCD && rotate_left(1: u128, 127) == 170141183460469231731687303715884105728);
    printf("ok\n");
}
