// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.literal [Literal-Out-Of-Range]; an integer literal beyond u128 fits no type; conf.literal-beyond-u128
// kind: negative
// expect: diag.literal-out-of-range (static)
//
// A well-formed integer literal larger than `u128`'s largest value is a
// literal out of range, not a syntax error (bug 029).

import std;

fn main()
{
    u128 x = 340282366920938463463374607431768211456;
    printf("%v\n", x);
}
