// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.checked [Div-Overflow]
// kind: negative
// expect: diag.div-overflow (dynamic)
//
// i32::MIN / -1 cannot be represented in i32 and must be rejected
// dynamically, distinctly from plain division by zero.

fn d(i32 a, i32 b) : i32
{
    a / b
}

fn main()
{
    d(-2147483647 - 1, -1);
}
