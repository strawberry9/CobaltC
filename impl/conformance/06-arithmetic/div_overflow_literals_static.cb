// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.div [Div-Overflow] (conf.div-min-neg-one-static)
// kind: negative
// expect: diag.div-overflow (static)
//
// Both operands are literals, so min(i32) / -1 is refuted before the
// program runs, and it is reported as a division overflow, not as a
// general arithmetic overflow.

fn main()
{
    -2147483648 / -1;
}
