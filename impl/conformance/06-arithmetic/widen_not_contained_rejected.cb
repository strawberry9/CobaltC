// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.convert [T-Convert] (conf.widen-not-contained-rejected)
// kind: negative
// expect: diag.type-mismatch (static)
//
// `widen` promises that every value of the source fits the target. A
// negative i32 has no u64 value, so this conversion has no `[Widen]`
// rule and is rejected; `narrow<u64>` is the checked alternative.

fn w(i32 x) : u64
{
    widen<u64>(x)
}

fn main()
{
    w(-5);
}
