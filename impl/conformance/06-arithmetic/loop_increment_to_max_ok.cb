// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.checked [Arith-Checked]; rule.control.for
// kind: positive
// expect: ok
// expect-stdout-hex: 323134373438333634370a3235350a
//
// A counter stepped by `+ 1` while it is below a bound reaches the
// type's maximum without an overflow: `i + 1` is computed only when
// `i < max`. (A compiler may leave this check out, since it cannot
// fail; the cases beside this one keep the ones that can.)

import std;

fn main()
{
    i32 i = max_value<i32>() - 3;
    while (i < max_value<i32>())
    {
        i += 1;
    }
    printf("%v\n", i);
    u8 j = 250;
    for (; j < 255; j += 1)
    {
    }
    printf("%v\n", j);
}
