// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.alt [T-Alt]
// kind: positive
// expect: ok
//
// An unsuffixed literal operand of an alternative operation takes the
// other operand's type, as in a binary expression, including when that
// operand is itself such an operation. So a 64-bit constant needs no
// suffix; the checker once range-checked it as i32.

import std;

fn check(bool ok)
{
    i32 z = if (ok)
    {
        1
    }
    else
    {
        0
    };
    1 / z;
}

fn main()
{
    u64 h = 14695981039346656037;
    h = wrapping_mul(h, 1099511628211);
    u64 s = wrapping_add(wrapping_mul(h, 6364136223846793005), 1442695040888963407);
    check(s != h);
    check(wrapping_add(1, max_value<u64>()) == 0);
    match (checked_add(3: u64, 5000000000))
    {
        Some(v) : check(v == 5000000003),
        None : check(false),
    }
}
