// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.checked [Arith-Checked]
// kind: positive
// expect: ok
//
// An i32 addition whose result stays within the represented domain
// must succeed and produce the exact expected value.

fn main()
{
    if (2000000000 + 100000000 != 2100000000)
    {
        1 / (1 - 1);
    }
}
