// CONFORMANCE-CASE
// spec: 06-arithmetic
// facility: rule.arith.convert [Narrow-Overflow]
// kind: negative
// expect: diag.narrowing-overflow (dynamic)
//
// narrow<u8> on a value outside u8's represented domain must fault
// rather than silently truncate; narrow_wrapping is the explicit
// truncating alternative.

fn n(i32 x) : u8
{
    narrow<u8>(x)
}

fn main()
{
    n(300);
}
