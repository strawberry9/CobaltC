// CONFORMANCE-CASE
// spec: 11-initialization
// facility: rule.value-object.store (D-0200); conf.raw-form-move-to-call
// kind: positive
// expect: ok
// expect-stdout-hex: 3130340a
//
// A function whose result an objectless local may take (it has a
// `__raw` form) moving an objectless local into a call: the value
// moved there takes an object, as anywhere but the function's result.

import std;

fn mk(ref<Vec<u64>, shared> a, u64 k) : Vec<u64>
{
    Vec<u64> out = Vec::new();
    foreach (x in a)
    {
        Vec::push(&mut out, *x + k);
    }
    out
}

fn build(ref<Vec<u64>, shared> base) : Vec<u64>
{
    Vec<Vec<u64>> table = Vec::new();
    Vec::push(&mut table, Vec::clone(base));
    for (usize i = 1; i < 4; i += 1)
    {
        Vec<u64> next = mk(&table[i - 1], 1);
        Vec::push(&mut table, next);
    }
    mk(&table[3], 100)
}

fn main() : u8
{
    Vec<u64> b = Vec::new();
    Vec::push(&mut b, 1);
    Vec<u64> r = build(&b);
    printf("%v\n", r[0]);
    0
}
