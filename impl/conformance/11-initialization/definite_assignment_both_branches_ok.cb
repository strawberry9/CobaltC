// CONFORMANCE-CASE
// spec: 11-initialization
// facility: rule.init.definite-assignment
// kind: positive
// expect: ok
//
// A binding assigned on every path (both branches of an if) is
// definitely initialized by the time it is read.

fn main()
{
    i32 x;
    bool c = true;
    if (c)
    {
        x = 1;
    }
    else
    {
        x = 2;
    }
    if (x != 1)
    {
        1 / (1 - 1);
    }
}
