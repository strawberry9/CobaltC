// CONFORMANCE-CASE
// spec: 11-initialization
// facility: rule.value-object.binding-lookup [Binding-Lookup-Stale] (D-0200); conf.objectless-moved-then-used
// kind: negative
// expect: diag.stale-binding (static)
//
// A `Vec` local lent only to functions that keep nothing, then moved away
// on one path and lent again after: the second lending finds the binding
// stale: rejected before the program runs.

import std;

fn sink(Vec<u32> v) : usize
{
    Vec::len(&v)
}

fn main()
{
    Vec<u32> v = Vec::new();
    Vec::push(&mut v, 1);
    usize n = 0;
    if (arg_count() == 0)
    {
        n = sink(v);
    }
    Vec::push(&mut v, 2);
    printf("%v %v\n", n, Vec::len(&v));
}
