// CONFORMANCE-CASE
// spec: 11-initialization
// facility: rule.value-object.store (D-0200); conf.objectless-lend-and-move
// kind: positive
// expect: ok
// expect-stdout-hex: 3320726f77732c2037206669656c64730a3020310a
//
// Containers lent to functions that keep nothing (`push`, `replace`,
// `swap`, `len`, `clear`), moved into another container, into a variant
// and out as a result, and dropped where their scopes end, on every path
// a loop takes.

import std;

fn fill(ref<Vec<String>, exclusive> v, usize n)
{
    for (usize i = 0; i < n; i += 1)
    {
        Vec::push(v, sprintf("w%v", i));
    }
}

fn gather(usize k) : Result<Vec<Vec<String>>, usize>
{
    Vec<Vec<String>> rows = Vec::new();
    Vec<String> row = Vec::new();
    String field = String::new();
    for (usize i = 0; i < k; i += 1)
    {
        String::push_ascii(&mut field, b'a');
        Vec::push(&mut row, replace(&mut field, String::new()));
        if (Vec::len(&row) == 2)
        {
            Vec::push(&mut rows, replace(&mut row, Vec::new()));
        }
    }
    fill(&mut row, 1);
    Vec::push(&mut row, field);
    Vec::push(&mut rows, row);
    if (k == 0)
    {
        return Err(0);
    }
    Ok(rows)
}

fn main()
{
    match (gather(5))
    {
        Ok(r)  :
        {
            usize total = 0;
            for (usize i = 0; i < Vec::len(&r); i += 1)
            {
                total += Vec::len(&r[i]);
            }
            printf("%v rows, %v fields\n", Vec::len(&r), total);
        },
        Err(e) : printf("err %v\n", e),
    }
    Vec<u64> a = Vec::new();
    Vec<u64> b = Vec::new();
    Vec::push(&mut a, 1);
    swap(&mut a, &mut b);
    Vec::clear(&mut a);
    printf("%v %v\n", Vec::len(&a), Vec::len(&b));
}
