// CONFORMANCE-CASE
// spec: 11-initialization
// facility: [Let-Destructure] (D-0104); conf.destructure-rest-destroys-at-block-end
// kind: positive
// expect: ok
// expect-stdout-hex: 676f74206f757420310a64726f7020320a64726f7020310a656e640a
//
// `Store { out, .. } = st;` binds `out`; the other fields end at the
// block's end, in reverse order with `out` ("drop 2", then "drop 1").

import std;

resource struct Noisy
{
    i32 n;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("drop %d\n", self.n);
}

struct Store
{
    String path;
    Noisy out;
    Noisy inp;
    u32 size;
}

fn main()
{
    Store st = Store { .path = String::from_str("p"), .out = Noisy { .n = 1 }, .inp = Noisy { .n = 2 }, .size = 9 };
    {
        Store { out, .. } = st;
        printf("got out %d\n", out.n);
    }
    printf("end\n");
}
