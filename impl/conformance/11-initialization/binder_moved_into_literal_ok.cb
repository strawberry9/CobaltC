// CONFORMANCE-CASE
// spec: 11-initialization
// facility: rule.value-object.store (D-0200); conf.binder-moved-into-literal
// kind: positive
// expect: ok
// expect-stdout-hex: 646174612031343030303030203230303030300a646174612031343030303030203230303030300a646174612031343030303030203230303030300a6d697373696e670a
//
// A match binder taken by value with no runtime object, moved into a
// struct literal beside a `String` made with no object, the literal the
// payload of the function's result: the moved bytes belong to the result
// alone, and stay readable after the function returns.

import std;

struct Served
{
    Vec<u8> bytes;
    String kind;
}

enum Lookup
{
    Found(Served),
    Missing,
}

fn load(usize n) : Result<Vec<u8>, u32>
{
    if (n == 0)
    {
        return Err(1);
    }
    Ok(Vec::filled(n, 7: u8))
}

fn resolve(usize n) : Lookup
{
    match (load(n))
    {
        Ok(bytes) : Found(Served { .bytes = bytes, .kind = String::from_str("data") }),
        Err(_)    : Missing,
    }
}

fn main() : u8
{
    for (usize round = 0; round < 3; round += 1)
    {
        match (resolve(200000))
        {
            Found(s) :
            {
                Vec<u8> other = Vec::filled(200000, 1: u8);
                u64 sum = 0;
                foreach (b in &s.bytes)
                {
                    sum += widen<u64>(*b);
                }
                printf("%s %v %v\n", &s.kind, sum, Vec::len(&other));
            },
            Missing  : printf("missing\n"),
        }
    }
    match (resolve(0))
    {
        Found(_) : printf("found\n"),
        Missing  : printf("missing\n"),
    }
    0
}
