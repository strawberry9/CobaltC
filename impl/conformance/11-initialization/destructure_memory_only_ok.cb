// CONFORMANCE-CASE
// spec: 11-initialization
// facility: spec/11 [Let-Destructure] (D-0104, D-0315); conf.destructure-memory-only
// kind: positive
// expect: ok
// expect-stdout-hex: 783c2d6330205b305d20623020747275650a6331206f75746572302031300a783c2d6331205b315d202d20747275650a6332206f75746572312031320a783c2d6332205b325d2062322066616c73650a6333206f75746572322031340a783c2d6333205b335d202d2066616c73650a6334206f75746572332031360a
//
// A struct whose fields free memory alone, destructured from a parameter, a
// call's result and a local, its parts moved on, read, borrowed and dropped:
// each part arrives whole and ends once.

import std;

struct Place
{
    String c;
    Vec<String> projs;
    Option<String> base;
    bool is_binding;
}

fn make(i64 n) : Place
{
    Vec<String> ps = Vec::new();
    for (i64 i = 0; i < n; i += 1)
    {
        Vec::push(&mut ps, sprintf("p%v", i));
    }
    Place { .c = sprintf("c%v", n), .projs = ps, .base = if (n % 2 == 0) { Some(sprintf("b%v", n)) } else { None }, .is_binding = n > 1 }
}

fn renamed(Place p, StringView to) : Place
{
    Place { c, projs, base, is_binding } = p;
    String old = c;
    Place { .c = sprintf("%v<-%v", to, &old), .projs = projs, .base = base, .is_binding = !is_binding }
}

fn describe(ref<Place, shared> p) : String
{
    String b = match (&p.base)
    {
        Some(s) : String::clone(s),
        None    : "-",
    };
    sprintf("%v [%v] %v %v", &p.c, Vec::len(&p.projs), &b, p.is_binding)
}

fn main()
{
    for (i64 n = 0; n < 4; n += 1)
    {
        Place p = renamed(make(n), "x");
        printf("%v\n", &describe(&p));
        String c = sprintf("outer%v", n);
        Place { c: inner, projs, .. } = make(n + 1);
        usize total = StringView::len(&inner) + StringView::len(&c);
        foreach (s in &projs)
        {
            total += StringView::len(s);
        }
        drop(projs);
        printf("%v %v %v\n", &inner, &c, total);
    }
}
