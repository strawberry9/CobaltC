// CONFORMANCE-CASE
// spec: 11-initialization
// facility: rule.init.definite-assignment (whole-object write)
// kind: positive
// expect: ok
//
// A struct literal initializes every declared field at once, whole,
// not through partial per-field writes -- exactly what
// [Write-Partial-Init] would otherwise guard against.

struct Pair
{
    i32 a;
    i32 b;
}

fn main()
{
    Pair p = Pair { .a = 1, .b = 2 };
    if (p.a != 1)
    {
        1 / (1 - 1);
    }
    if (p.b != 2)
    {
        1 / (1 - 1);
    }
}
