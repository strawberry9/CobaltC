// CONFORMANCE-CASE
// spec: 11-initialization
// facility: rule.init.definite-assignment [Definite-Assignment-Rejected]; spec/13 [Or-True] (CHG-0438); conf.short-circuit-write-not-definite
// kind: negative
// expect: diag.use-of-uninitialized (static)
//
// `true || e` never runs `e`, so `x` has no value afterwards. The write in
// the right operand counted as if it always ran; `cobc` printed what was
// in `x`'s memory.

import std;

fn main()
{
    i32 x;
    bool b = true || {
        x = 1;
        true
    };
    printf("%v %v\n", b, x);
}
