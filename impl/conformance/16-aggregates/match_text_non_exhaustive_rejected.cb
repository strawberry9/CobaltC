// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match-Non-Exhaustive] (text); D-0127; conf.match-text-non-exhaustive-rejected
// kind: negative
// expect: diag.non-exhaustive-match (static)
//
// Text literals never cover a text type: without `_` the match misses every other text, and the message says `_`.

import std;

fn main()
{
    str s = "a";
    i32 x = match (s) { "a" : 1, "b" : 2, };
}
