// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match struct patterns (D-0224); [Let-Destructure] every field or `..` (D-0104); conf.struct-pattern-missing-field
// kind: negative
// expect: diag.type-mismatch (static)
//
// A struct pattern names every field, as destructuring does, or ends with
// `..`: `end` is missing.
import std;

struct Question
{
    String name;
    u32 end;
}

fn main()
{
    Option<Question> o = Some(Question { .name = "who", .end = 3 });
    match (o)
    {
        Some(Question { name }) : printf("%v\n", &name),
        None                    : {},
    }
}
