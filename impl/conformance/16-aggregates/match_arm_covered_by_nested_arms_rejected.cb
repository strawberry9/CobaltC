// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match-Unreachable] (nested); D-0056; conf.match-covered-by-nested
// kind: negative
// expect: diag.unreachable-arm (static)
//
// `Some(Some(x))` and `Some(None)` together match every `Some`, so the
// later `Some(_)` arm is unreachable.

import std;

fn main()
{
    Option<Option<i32>> o = None;
    i32 v = match (o)
    {
        Some(Some(x)) : x,
        Some(None) : 1,
        Some(_) : 2,
        None : 0,
    };
}
