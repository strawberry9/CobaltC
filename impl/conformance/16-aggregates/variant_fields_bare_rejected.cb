// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.enum a variant with named fields (D-0324): written with its enum's name; conf.variant-fields-bare-refused
// kind: negative
// expect: diag.unbound-name (static)
//
// `Rect { .w = 1, .h = 2 }` would read as a struct named `Rect`; a variant
// with fields is always written with its enum's name, `Shape::Rect { … }`.
import std;

enum Shape
{
    Rect { u32 w; u32 h; },
    Dot,
}

fn main()
{
    Shape s = Rect { .w = 1, .h = 2 };
    _ = s;
}
