// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.enum a variant with named fields (D-0324): made by naming them; conf.variant-fields-positional-refused
// kind: negative
// expect: diag.type-mismatch (static)
//
// A variant with fields is made by naming them; `Shape::Rect(x)` with one
// value for all is refused, and so is matching it with one binder (the
// pattern form is checked in variant_fields_one_binder_rejected.cb).
import std;

enum Shape
{
    Rect { u32 w; u32 h; },
    Dot,
}

fn main()
{
    Shape s = Shape::Rect(3);
    _ = s;
}
