// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.slice [Slice-Form]; spec/04 overlap meet; D-0070, D-0238; conf.empty-slice-meets-vec-fields
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// An empty slice of `*r` meets no range and no element, but the vector's
// own fields reach its whole storage (`meet`, D-0238): `Vec::push` through
// `r`, passed on, writes `len` and faults beside the live slice.

import std;

fn grow(ref<Vec<i32>, exclusive> r)
{
    auto s = &mut (*r)[1 .. 1];
    Vec::push(r, 2);
    printf("%v\n", slice_len(s));
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    grow(&mut v);
    printf("%v\n", Vec::len(&v));
}
