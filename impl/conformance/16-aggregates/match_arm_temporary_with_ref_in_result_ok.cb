// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match] (the arm body is stmt-scoped); rule.agg.slice [Slice-Form]
// kind: positive
// expect: ok
//
// A match arm whose body builds a value holding a reference -- a slice,
// or a struct with a reference field -- and wraps it in `Some` returns
// it intact. The arm body is its own statement, so its temporaries end
// with it; cobc once kept them alive past the arm's C block, whose
// storage the C compiler reused for the result, and the result's
// borrow ended with the stale temporary (diag.stale-binding at the use).

import std;

struct Holder
{
    ref<i64, shared> r;
    i64 k;
}

fn as_slice(ref<HashMap<i32, Vec<i64>>, shared> m, i32 k) : Option<slice<i64, shared>>
{
    match (HashMap::get(m, &k))
    {
        Some(v) : Some(&(*v)[0..$]),
        None : None,
    }
}

fn holder(ref<Vec<i64>, shared> w) : Option<Holder>
{
    Option<ref<Vec<i64>, shared>> o = Some(w);
    match (o)
    {
        Some(v) : Some(Holder { .r = &(*v)[0], .k = 7 }),
        None : None,
    }
}

fn main()
{
    HashMap<i32, Vec<i64>> m = HashMap::new();
    Vec<i64> v = Vec::new();
    Vec::push(&mut v, 5);
    Vec::push(&mut v, 6);
    HashMap::insert(&mut m, 1, v);
    i64 total = 0;
    match (as_slice(&m, 1))
    {
        Some(s) : { total = total + s[0] + s[$ - 1]; },
        None : { fault(index_out_of_bounds); },
    }
    Vec<i64> w = Vec::new();
    Vec::push(&mut w, 30);
    match (holder(&w))
    {
        Some(h) : { total = total + *h.r + h.k; },
        None : { fault(index_out_of_bounds); },
    }
    if (total != 48)
    {
        fault(index_out_of_bounds);
    }
}
