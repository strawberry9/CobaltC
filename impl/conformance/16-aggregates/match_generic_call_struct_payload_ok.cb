// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match] (a temporary from a generic call as the scrutinee)
// kind: positive
// expect: ok
//
// `match (Vec::pop(&mut v))` where the element is a struct (`StringView`,
// a program's own): `coby` built `Some(x)` inside `Vec::pop` with the
// payload type `void` (a struct value does not name its type) and
// returned that temporary as it was, so the arm's binder was mistyped
// and using it faulted `diag.type-mismatch`. A call's temporary now takes
// the declared return type. Found by real-world testing.

import std;

struct Point
{
    i32 x;
    i32 y;
}

fn last_word(ref<String, shared> path) : usize
{
    Vec<StringView> parts = StringView::split(&path[0..$], "/");
    match (Vec::pop(&mut parts))
    {
        Some(last) : StringView::len(last),
        None : 0,
    }
}

fn main()
{
    String p = String::from_str("a/b/c.txt");
    Vec<Point> pts = Vec::new();
    Vec::push(&mut pts, Point { .x = 3, .y = 4 });
    i32 s = match (Vec::pop(&mut pts))
    {
        Some(q) : q.x * q.y,
        None : -1,
    };
    if (last_word(&p) != 5 || s != 12)
    {
        1 / (1 - 1);
    }
}
