// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: [Pattern-Type] (a constant of another type); D-0058; conf.match-const-wrong-type
// kind: negative
// expect: diag.type-mismatch (static)
//
// A `u16` constant is not a `u8` pattern: its literal keeps its type.

import std;
const u16 W = 1;
fn main()
{
    u8 x = 1;
    i32 v = match (x) { W : 1, _ : 0, };
}
