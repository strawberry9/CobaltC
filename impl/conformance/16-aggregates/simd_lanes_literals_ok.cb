// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: type.simd; rule.agg.simd [Simd-Construct], [Simd-Lane]; rule.agg.layout [Layout-Simd]; D-0254; conf.simd-lanes
// kind: positive
// expect: ok
// expect-stdout-hex: 312e3020322e3020392e3020302e350a657175616c0a31362033322033320a302e350a
//
// A `simd` from an array literal and from `[x; N]`, lanes read and
// written, `==` over the whole value, its size and alignment, and a field
// of one in a struct (padded to the vector's 16-byte alignment).

import std;

struct Pair
{
    u8 tag;
    simd<f32, 4> v;
}

fn main()
{
    simd<f32, 4> a = [1.0, 2.0, 3.0, 4.0];
    simd<f32, 4> b = [0.5; 4];
    a[2] = 9.0;
    printf("%v %v %v %v\n", a[0], a[1], a[2], b[3]);
    simd<f32, 4> c = a;
    printf("%s\n", if (c == a) { "equal" } else { "differ" });
    Pair p = Pair { .tag = 1, .v = b };
    printf("%v %v %v\n", sizeof<simd<f32, 4>>(), alignof<simd<u8, 32>>(), sizeof<Pair>());
    printf("%v\n", p.v[1]);
}
