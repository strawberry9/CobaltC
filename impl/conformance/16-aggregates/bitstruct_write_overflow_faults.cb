// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: type.bitstruct `[Bitfield-Overflow]` (D-0118), dynamic for a computed value; conf.bitstruct-write-overflow-faults
// kind: negative
// expect: diag.narrowing-overflow (dynamic)

import std;

bitstruct B : u8 { lo : 4; hi : 4; }

fn value(u8 x) : u8
{
    x
}

fn main()
{
    B b = B { .lo = 1, .hi = 0 };
    b.lo = value(15);
    b.lo = value(16);
}
