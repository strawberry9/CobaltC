// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Pattern-Type] (a text literal against a reference); D-0127; conf.match-text-reference-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// A reference to a `String` is not matched by text literals at the top level: `match (*r)` reads the text (as `match (*r)` does for an integer, D-0057).

import std;

fn main()
{
    String s = String::from_str("a");
    ref<String, shared> r = &s;
    i32 x = match (r) { "a" : 1, _ : 0, };
}
