// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.slice `[Slice-Form]` (D-0047, D-0070), `[Write-Conflict]`, D-0107 (activation at first use); conf.slice-argument-held-across-push-rejected
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// A slice of a `Vec` passed beside `&mut` of the same `Vec`: both borrows
// are pending until bound (D-0107), and the first write through the
// exclusive one — `Vec::push`, which reaches the whole source — clashes
// with the live slice. (The interpreter once ran this: its overlap test
// held a slice's range and the `Vec`'s `len` field apart. Found
// 2026-09-30 by `Vec::extend_from(&mut a, &a[0..2])`.)

import std;

fn grow(ref<Vec<u8>, exclusive> a, slice<u8, shared> s)
{
    for (usize i = 0; i < slice_len(s); i += 1)
    {
        Vec::push(a, s[i]);
    }
}

fn main()
{
    Vec<u8> a = Vec::filled(3, 7: u8);
    grow(&mut a, &a[0..2]);
}
