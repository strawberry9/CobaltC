// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match struct patterns (D-0224); [Let-Destructure] (D-0044, D-0104); [If-Pattern], [While-Pattern] (D-0115); conf.struct-pattern
// kind: positive
// expect: ok
// expect-stdout-hex: 77686f20340a72656e616d65642077686f0a7074203120320a746f70203520360a706f7070656420322077686f0a706f7070656420312077686f0a
//
// A struct pattern stands where a binder could: in `if (Some(Q { … }) = e)`,
// inside nested variants, renaming a field, with `..`, alone at the top of
// an arm, and in `while (pattern = e)`. Its fields are taken by value, so
// the `String` field is moved out of each `Question`.
import std;

struct Question
{
    String name;
    u32 end;
}

struct Pt
{
    i32 x;
    i32 y;
}

fn ask(u32 k) : Option<Question>
{
    if (k == 0)
    {
        return None;
    }
    Some(Question { .name = "who", .end = k })
}

fn main()
{
    if (Some(Question { name, end }) = ask(4))
    {
        printf("%v %v\n", &name, end);
    }
    match (ask(7))
    {
        Some(Question { name: n, .. }) : printf("renamed %v\n", &n),
        None                           : printf("none\n"),
    }
    Result<Option<Pt>, u8> r = Ok(Some(Pt { .x = 1, .y = 2 }));
    match (r)
    {
        Ok(Some(Pt { x, y })) : printf("pt %v %v\n", x, y),
        Ok(None)              : printf("no pt\n"),
        Err(e)                : printf("err %v\n", e),
    }
    Pt p = Pt { .x = 5, .y = 6 };
    match (p)
    {
        Pt { x, y: why } : printf("top %v %v\n", x, why),
    }
    Vec<Option<Question>> qs = Vec::new();
    Vec::push(&mut qs, ask(0));
    Vec::push(&mut qs, ask(1));
    Vec::push(&mut qs, ask(2));
    while (Some(Some(Question { end, name })) = Vec::pop(&mut qs))
    {
        printf("popped %v %v\n", end, &name);
    }
}
