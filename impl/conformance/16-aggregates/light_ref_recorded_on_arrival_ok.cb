// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.control.frame-references (a reference recorded on arrival, D-0292); conf.light-ref-recorded-on-arrival
// kind: positive
// expect: ok
// expect-stdout-hex: 38203420310a
//
// `main` is decided, so the three references it forms into `o` carry no
// record; `work` is not (its element write may meet `e`), so each is
// recorded as it arrives, with the place it refers to: `p` is `o.x`, `q`
// is `o.y`, `arr` is `o.arr`. The write through `p` and the read through
// `q` are disjoint fields, and the element write misses `e`: no fault.

import std;

struct Inner
{
    u64 a;
    u64 b;
}

struct Outer
{
    Inner x;
    Inner y;
    Vec<u64> arr;
}

fn work(ref<Inner, exclusive> p, ref<Inner, shared> q, ref<Vec<u64>, exclusive> arr, usize i) : u64
{
    ref<u64, exclusive> e = &mut (*arr)[i];
    (*arr)[3] = 7;
    *e = *e + 1;
    (*p).a = (*q).a + 1;
    (*p).a + (*q).b
}

fn main()
{
    Outer o = Outer { .x = Inner { .a = 1, .b = 2 }, .y = Inner { .a = 3, .b = 4 }, .arr = Vec::filled(4, 0: u64) };
    u64 r = work(&mut o.x, &o.y, &mut o.arr, 1);
    printf("%v %v %v\n", r, o.x.a, o.arr[1]);
}
