// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Pattern-Type] (an integer literal against text); D-0127; conf.match-text-literal-type-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// An integer literal is not of a text type: a `String` level takes text literals only.

import std;

fn main()
{
    String s = "a";
    i32 x = match (s) { 1 : 1, _ : 0, };
}
