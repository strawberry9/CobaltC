// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.index [Index-Checked] (n : usize)
// kind: negative
// expect: diag.type-mismatch (static)
//
// An index is a `usize`; an `i32` binding is not one (there is no
// implicit conversion, D-0006).

fn main()
{
    array<i32, 3> a = [1, 2, 3];
    i32 i = 1;
    auto x = a[i];
}
