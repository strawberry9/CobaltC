// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: spec/21 §0 simd_load; D-0254; conf.simd-load-bounds
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// Four lanes from index 7 of eight elements: the last three are not there.

import std;

fn main()
{
    Vec<f32> v = Vec::filled(8, 0.0: f32);
    simd<f32, 4> x = simd_load<simd<f32, 4>>(&v[0 .. $], 7);
}
