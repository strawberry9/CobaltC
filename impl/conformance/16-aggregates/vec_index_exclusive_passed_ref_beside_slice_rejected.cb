// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.stdlib.vec (`Vec::index_exclusive`'s body reads `len` through its reference); rule.agg.slice (D-0070); conf.vec-index-exclusive-passed-ref-beside-slice
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// `Vec::index_exclusive(r, 1)` with `r` itself, beside a live slice of
// element 0 taken through `r`: the body's read of the vector's `len`
// through `v` meets the slice (a `Vec`'s fields reach its whole storage),
// although element 1 is outside the slice's range. `(*r)[1]`, checked as
// an access to element 1 (`[Index-Vec]`), would pass.
import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    auto r = &mut v;
    slice<i32, exclusive> sl = &mut (*r)[0 .. 1];
    *Vec::index_exclusive(r, 1) = 7;
    slice_swap(sl, 0, 0);
}
