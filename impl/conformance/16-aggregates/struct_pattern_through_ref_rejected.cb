// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match struct patterns (D-0224): by value only; [Match-By-Ref]; conf.struct-pattern-through-ref
// kind: negative
// expect: diag.type-mismatch (static)
//
// A struct pattern takes its value apart by value; `match (&o)` binds
// through a reference, so the pattern is rejected, with a hint: bind the
// payload and read its fields through it.
import std;

struct Question
{
    String name;
    u32 end;
}

fn main()
{
    Option<Question> o = Some(Question { .name = "who", .end = 3 });
    match (&o)
    {
        Some(Question { name, end }) : printf("%v\n", end),
        None                         : {},
    }
}
