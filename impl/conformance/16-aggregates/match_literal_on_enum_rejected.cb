// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Pattern-Type] (a literal where a variant is); D-0057; conf.match-literal-on-enum
// kind: negative
// expect: diag.type-mismatch (static)
//
// An enum's level is matched by its variants; `3` is not one.

import std;

fn main()
{
    Option<i32> o = None;
    i32 v = match (o)
    {
        3 : 1,
        _ : 0,
    };
}
