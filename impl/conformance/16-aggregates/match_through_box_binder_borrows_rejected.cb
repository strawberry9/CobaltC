// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match-Through-Box] [Match-By-Ref] (D-0301); conf.match-through-box-binder-borrows-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `x` is `Box::get` of a reference into `v`'s element, so `v` stays
// borrowed while `x` lives: the arm cannot push onto `v` and then read `x`.

import std;

enum E
{
    A(Box<i64>),
    B,
}

fn main() : u8
{
    Vec<E> v = Vec::new();
    Vec::push(&mut v, E::A(Box::new(5)));
    match (&v[0])
    {
        E::A(*x) :
        {
            Vec::push(&mut v, E::B);
            printf("%d\n", *x);
        },
        E::B     : {},
    }
    return 0;
}
