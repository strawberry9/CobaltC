// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match-Through-Ref] (D-0109); conf.match-through-ref-binder-borrows-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// A binder reached through `HashMap::get`'s reference borrows the map
// as that reference does, so the map cannot be written while it lives.

import std;

enum Cell
{
    Num(i64),
    Empty,
}

fn main()
{
    HashMap<u32, Cell> m = HashMap::new();
    HashMap::insert(&mut m, 1, Num(42));
    match (HashMap::get(&m, &1))
    {
        Some(Num(v)) :
        {
            HashMap::clear(&mut m);
            printf("%v\n", *v);
        },
        _            : {},
    }
}
