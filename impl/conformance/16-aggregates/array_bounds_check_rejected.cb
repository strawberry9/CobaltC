// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.index [Index-Out-Of-Bounds]
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// Indexing an array with a runtime index past its fixed length N is
// rejected dynamically.

fn get(array<i32,3> a, usize i) : i32
{
    a[i]
}

fn main()
{
    array<i32,3> a = [1, 2, 3];
    get(a, 3);
}
