// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.index-vec [Index-Vec]; rule.agg.slice [Slice-Index]; "One access"; D-0242; conf.vec-element-assigned-from-itself
// kind: positive
// expect: ok
// expect-stdout-hex: 31312032310a
//
// An element written from its own value, through the vector and through a
// slice: the target's element place, evaluated first, is pending while the
// value reads the same element, and the write ends it (D-0242). Read
// literally before D-0242, the target's element borrow met the value's read.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 10);
    Vec::push(&mut v, 20);
    v[0] = v[0] + 1;
    auto s = &mut v[1 .. 2];
    s[0] = s[0] + 1;
    printf("%v %v\n", v[0], v[1]);
}
