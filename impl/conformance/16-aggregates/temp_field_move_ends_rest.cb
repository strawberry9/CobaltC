// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: [Temp-Field-Move] (D-0103); conf.temp-field-move-ends-rest
// kind: positive
// expect: ok
// expect-stdout-hex: 64726f7020350a722068617320320a656e640a
//
// Moving a field out of a temporary takes it apart there: its other
// fields end at once ("drop 5" before "r has 2").

import std;

resource struct Noisy
{
    i32 n;
}

fn Noisy::drop(ref<Noisy, exclusive> self)
{
    printf("drop %d\n", self.n);
}

struct QR
{
    Vec<u32> q;
    Vec<u32> r;
    Noisy tag;
}

fn qr(u32 a) : QR
{
    Vec<u32> q = Vec::new();
    Vec::push(&mut q, a);
    Vec<u32> r = Vec::new();
    Vec::push(&mut r, a * 2);
    Vec::push(&mut r, a * 3);
    QR { .q = q, .r = r, .tag = Noisy { .n = narrow<i32>(a) } }
}

fn main()
{
    Vec<u32> r = qr(5).r;
    printf("r has %d\n", Vec::len(&r));
    printf("end\n");
}
