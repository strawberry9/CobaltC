// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.array-construct with rule.type.expected (the first element's type for the rest)
// kind: positive
// expect: ok
//
// `[0: u64, 1, 999999999999]` with nothing outside giving the element
// type: the first element's type is every element's, so the literals after
// it are `u64`s. coby evaluated them with no expected type, as `i32`s,
// and faulted `diag.literal-out-of-range` on `999999999999`. Found by
// real-world testing (an RSA round trip over a list of messages).

import std;

fn main()
{
    u64 total = 0;
    foreach (m in [0: u64, 1, 42, 999999999999, 12345678901234567])
    {
        total += m;
    }
    assert(total == 12346678901234609);
    i64 neg = 0;
    foreach (v in [-1: i64, -9223372036854775807, 5])
    {
        neg += v;
    }
    assert(neg == -9223372036854775803);
}
