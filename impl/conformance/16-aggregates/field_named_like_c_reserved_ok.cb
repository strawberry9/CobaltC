// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.struct [Struct-Literal]; conf.field-named-like-c-reserved
// kind: positive
// expect: ok
// expect-stdout-hex: 3320342035203620370a7472756520380a392031300a
//
// A field may have any name the grammar allows, among them the names C
// keeps for itself (`_Bool`, `__LINE__`) and their neighbours.

import std;

struct Line
{
    i32 __LINE__;
    i32 __FILE__;
    i32 __func__;
    i32 _Static_assert;
    i32 __attribute__;
}

struct Flags
{
    bool _Bool;
    i32 cb_Bool;
}

enum E
{
    V { i32 _Complex; i32 cbcb_Bool; },
}

fn main()
{
    Line l = Line { .__LINE__ = 3, .__FILE__ = 4, .__func__ = 5, ._Static_assert = 6, .__attribute__ = 7 };
    printf("%v %v %v %v %v\n", l.__LINE__, l.__FILE__, l.__func__, l._Static_assert, l.__attribute__);
    Flags f = Flags { ._Bool = true, .cb_Bool = 8 };
    printf("%v %v\n", f._Bool, f.cb_Bool);
    E e = E::V { ._Complex = 9, .cbcb_Bool = 10 };
    match (e)
    {
        E::V { _Complex, cbcb_Bool } : printf("%v %v\n", _Complex, cbcb_Bool),
    }
}
