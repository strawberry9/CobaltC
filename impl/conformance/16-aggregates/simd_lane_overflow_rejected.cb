// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: type.simd; rule.agg.simd [Simd-Op-Fault]; D-0254; conf.simd-lane-overflow
// kind: negative
// expect: diag.arith-overflow (dynamic)
//
// One lane of four overflows `i32`: the whole addition faults, as the
// scalar `+` would; `wrapping_add` is the form that wraps.

import std;

fn main()
{
    simd<i32, 4> big = [1, 1, 2147483647, 1];
    simd<i32, 4> z = big + [1; 4];
}
