// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.index-vec [Index-Vec]; [Index-Out-Of-Bounds]
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// A read past a Vec's end while a shared reference to an element is held
// faults at the read's line: an implementation that proves the read
// cannot conflict with any path still checks its bounds.

import std;

fn main()
{
    Vec<i64> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    ref<i64, shared> f = &v[0];
    usize k = Vec::len(&v);
    printf("%v\n", *f + v[k]);
}
