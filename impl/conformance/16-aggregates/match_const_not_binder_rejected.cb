// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: [Match-Non-Exhaustive] (a constant's name is not a binder); D-0058; conf.match-const-not-binder
// kind: negative
// expect: diag.non-exhaustive-match (static)
//
// `LIMIT` names a constant, so the arm compares with 9 rather than binding
// the value; the match on an integer then lacks `_`, which is how the
// mistake shows.

import std;
const u8 LIMIT = 9;
fn main()
{
    u8 limit = 3;
    i32 v = match (limit) { LIMIT : 1, };
}
