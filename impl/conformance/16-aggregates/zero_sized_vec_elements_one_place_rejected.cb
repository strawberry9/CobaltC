// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: conf.zero-sized-vec-elements-one-place; spec/20 reclaimed-at (anchor), spec/04 overlap (D-0217, CHG-0255)
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// A vector of a zero-sized type keeps every element at one address (the
// step is 0), so every element is the one reclaimed object anchored there
// (`reclaimed-at` by anchor and type): `&mut v[0]` and `&mut v[1]` are two
// exclusive paths to the same place, and the second borrow is refused.

import std;

struct Z {}

fn main()
{
    Vec<Z> v = Vec::new();
    Vec::push(&mut v, Z {});
    Vec::push(&mut v, Z {});
    Vec<ref<Z, exclusive>> held = Vec::new();
    Vec::push(&mut held, &mut v[0]);
    Vec::push(&mut held, &mut v[1]);
}
