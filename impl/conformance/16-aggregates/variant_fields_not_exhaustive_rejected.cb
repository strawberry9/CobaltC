// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match exhaustiveness with a variant with fields (D-0324); conf.variant-fields-not-exhaustive
// kind: negative
// expect: diag.non-exhaustive-match (static)
//
// A match that leaves out a variant with fields is not exhaustive; the
// message shows the missing arm as it is written, `Shape::Rect { .. }`.
import std;

enum Shape
{
    Rect { u32 w; u32 h; },
    Dot,
}

fn main()
{
    Shape s = Shape::Dot;
    match (s)
    {
        Shape::Dot : {},
    }
}
