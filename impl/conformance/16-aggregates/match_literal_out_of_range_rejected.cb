// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Pattern-Type] (a literal); rule.arith.literal; D-0057; conf.match-literal-out-of-range
// kind: negative
// expect: diag.literal-out-of-range (static)
//
// A literal is typed as any literal is: 300 is not a `u8`.

import std;

fn main()
{
    u8 x = 1;
    i32 v = match (x)
    {
        300 : 1,
        _ : 0,
    };
}
