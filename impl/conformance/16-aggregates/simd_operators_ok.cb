// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: type.simd; rule.agg.simd [Simd-Op]; D-0254; conf.simd-operators
// kind: positive
// expect: ok
// expect-stdout-hex: 312e323520322e373520342e323520352e37350a32202d323134373438333030300a3234310a322036340a
//
// The operators lane by lane: float arithmetic, signed negation, the
// bitwise operators with CobaltC's precedence, shifts by a vector of
// counts, each lane as the scalar operator.

import std;

fn main()
{
    simd<f32, 4> a = [1.0, 2.0, 3.0, 4.0];
    simd<f32, 4> b = [0.5; 4];
    simd<f32, 4> c = a * b + a - b / [2.0; 4];
    printf("%v %v %v %v\n", c[0], c[1], c[2], c[3]);
    simd<i32, 4> x = [1, -2, 3, 2147483000];
    simd<i32, 4> y = -x;
    printf("%v %v\n", y[1], y[3]);
    simd<u8, 16> m = [0x0f; 16];
    simd<u8, 16> n = ~m & [0xff; 16] ^ [1; 16];
    printf("%v\n", n[5]);
    simd<u32, 4> s = [1, 2, 3, 4];
    simd<u32, 4> t = s << [1, 2, 3, 4];
    printf("%v %v\n", t[0], t[3]);
}
