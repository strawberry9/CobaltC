// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match-Non-Exhaustive] with [Match-Through-Ref] (D-0109); conf.match-through-ref-non-exhaustive-rejected
// kind: negative
// expect: diag.non-exhaustive-match (static)
//
// Coverage looks through the reference as the pattern does: `Some(Num)`
// and `Some(Empty)` cover `Some`, and `None` is left.

import std;

enum Cell
{
    Num(i64),
    Empty,
}

fn main()
{
    HashMap<u32, Cell> m = HashMap::new();
    HashMap::insert(&mut m, 1, Num(42));
    match (HashMap::get(&m, &1))
    {
        Some(Num(v)) : printf("%v\n", *v),
        Some(Empty)  : printf("e\n"),
    }
}
