// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: [Index-Vec] through a reference: a `foreach` element's `Vec` field, and a `sort_by` comparator's parameter; conf.index-through-proven-reference
// kind: positive
// expect: ok
// expect-stdout-hex: 33340a610a620a630a
//
// `row.counts[i]` with `row` a `foreach (row in &rows)` element whose
// struct owns a `Vec`, and `a[0].path` in a comparator given to
// `Vec::sort_by`, each read where it stands. (Before the session findings
// of 2026-11-06 `cobc` stopped with "internal error: borrow of a
// temporary" on both: the element and the comparator's parameter are
// reached with no access path, every access proven, and the index call's
// borrow of the `Vec` field was taken for a temporary's.)

import std;

struct Row
{
    usize index;
    Vec<u32> counts;
}

struct Candidate
{
    String path;
}

fn row(usize i, u32 a, u32 b) : Row
{
    Vec<u32> c = Vec::new();
    Vec::push(&mut c, a);
    Vec::push(&mut c, b);
    Row { .index = i, .counts = c }
}

fn group(str p) : Vec<Candidate>
{
    Vec<Candidate> g = Vec::new();
    Vec::push(&mut g, Candidate { .path = String::copy(p) });
    g
}

fn main()
{
    Vec<Row> rows = Vec::new();
    Vec::push(&mut rows, row(0, 7, 8));
    Vec::push(&mut rows, row(1, 9, 10));
    u32 sum = 0;
    foreach (r in &rows)
    {
        sum += r.counts[0] + r.counts[1];
    }
    printf("%v\n", sum);
    Vec<Vec<Candidate>> groups = Vec::new();
    Vec::push(&mut groups, group("b"));
    Vec::push(&mut groups, group("a"));
    Vec::push(&mut groups, group("c"));
    Vec::sort_by(&mut groups, [](ref<Vec<Candidate>, shared> a, ref<Vec<Candidate>, shared> b) : bool { a[0].path < b[0].path });
    foreach (g in &groups)
    {
        printf("%v\n", &g[0].path);
    }
}
