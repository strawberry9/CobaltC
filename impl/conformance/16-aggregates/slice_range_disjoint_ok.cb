// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.slice [Slice-Form] (a range); D-0070; conf.slice-range-disjoint
// kind: positive
// expect: ok
// expect-stdout-hex: 33302031312031322032302032312032320a656d707479203020300a31303020352032303020332032203120300a
//
// Two exclusive slices of disjoint ranges of one array or Vec live
// together; a slice of a slice splits it again; two empty slices at one
// place meet nothing; an element outside a live slice's range is used.

import std;

// Reverse in place by swapping the halves' mirrored elements, then
// recursing into each half: two exclusive slices of one source at once.
fn reverse(slice<i32, exclusive> s)
{
    usize n = slice_len(s);
    if (n < 2)
    {
        return;
    }
    usize mid = n / 2;
    slice<i32, exclusive> left = &mut s[0 .. mid];
    slice<i32, exclusive> right = &mut s[n - mid .. $];
    usize i = 0;
    while (i < mid)
    {
        i32 t = left[i];
        left[i] = right[mid - 1 - i];
        right[mid - 1 - i] = t;
        i = i + 1;
    }
}

fn fill(slice<i32, exclusive> s, i32 base)
{
    usize i = 0;
    while (i < slice_len(s))
    {
        s[i] = base + narrow<i32>(i);
        i = i + 1;
    }
}

fn main()
{
    array<i32, 6> a = [1, 2, 3, 4, 5, 6];
    {
        slice<i32, exclusive> lo = &mut a[0 .. 3];
        slice<i32, exclusive> hi = &mut a[3 .. $];
        fill(lo, 10);
        fill(hi, 20);
        lo[0] = lo[0] + hi[0];
    }
    printf("%v %v %v %v %v %v\n", a[0], a[1], a[2], a[3], a[4], a[5]);

    Vec<i32> v = Vec::new();
    i32 k = 0;
    while (k < 7)
    {
        Vec::push(&mut v, k);
        k = k + 1;
    }
    reverse(&mut v[0 .. $]);
    {
        slice<i32, exclusive> all = &mut v[0 .. $];
        slice<i32, exclusive> first = &mut all[0 .. 2];
        slice<i32, exclusive> rest = &mut all[2 .. $];
        first[0] = 100;
        rest[0] = 200;
        slice<i32, exclusive> e1 = &mut rest[1 .. 1];
        slice<i32, exclusive> e2 = &mut rest[1 .. 1];
        printf("empty %v %v\n", slice_len(e1), slice_len(e2));
    }
    printf("%v %v %v %v %v %v %v\n", v[0], v[1], v[2], v[3], v[4], v[5], v[6]);
}
