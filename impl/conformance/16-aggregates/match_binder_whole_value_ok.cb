// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match (a binder at the top level); D-0058; conf.match-binder
// kind: positive
// expect: ok
// expect-stdout-hex: 3020300a77686f6c65206572726f722076616c75653a20370a6d6f7665642068656c6c6f0a30203420330a62792072656620330a7265737420320a6c656e20340a
//
// A binder alone binds the whole scrutinee, of any type: an integer's
// remaining values (`k : Err(k)`), a `String` moved into it, an enum
// after its variant arms (a resource one moved whole), through a
// reference (`r` is the reference), and a scrutinee that is a call.

import std;
enum Shape
{
    Dot,
    Line(i32),
    Name(String),
}
fn fields(usize n) : Result<i32, usize>
{
    match (n)
    {
        5 : Ok(0),
        k : Err(k),
    }
}
fn size(Shape s) : i32
{
    match (s)
    {
        Dot     : 0,
        Line(n) : n,
        other   :
        {
            match (other)
            {
                Name(t) : narrow<i32>(String::len(&t)),
                _       : -1,
            }
        },
    }
}
fn main()
{
    printf("%v %v\n", Result::unwrap_or(fields(5), 9), Result::unwrap_or(fields(3), 0));
    match (fields(7))
    {
        Ok(_) : printf("?\n"),
        e : printf("whole error value: %v\n", match (e)
        {
            Err(k) : k,
            Ok(_)  : 0,
        }),
    }
    String s = String::from_str("hello");
    match (s)
    {
        t : printf("moved %s\n", &t),
    }
    printf("%v %v %v\n", size(Dot), size(Line(4)), size(Name(String::from_str("abc"))));
    Option<i32> o = Some(3);
    match (&o)
    {
        r : printf("by ref %v\n", match (r)
        {
            Some(x) : *x,
            None    : 0,
        }),
    }
    i32 n = 12;
    match (n % 5)
    {
        0    : printf("zero\n"),
        rest : printf("rest %v\n", rest),
    }
    String abcd = String::from_str("abcd");
    match (String::len(&abcd))
    {
        len : printf("len %v\n", len),
    }
}
