// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.field-access [Field-Access]; "One access"; D-0242; conf.field-assigned-from-itself
// kind: positive
// expect: ok
// expect-stdout-hex: 3320360a
//
// A field written from its own value, a plain one and one holding an
// exclusive reference: the target's projection is pending while the value
// reads the field, and the write ends it (D-0242). Read literally before
// D-0242, the target's projection met the value's read of the same field.

import std;

struct Point
{
    i32 x;
    i32 y;
}

struct Hold
{
    ref<i32, exclusive> r;
}

fn main()
{
    Point p = Point { .x = 1, .y = 2 };
    p.x = p.x + p.y;
    i32 n = 5;
    Hold h = Hold { .r = &mut n };
    h.r = h.r;
    *h.r = *h.r + 1;
    printf("%v %v\n", p.x, n);
}
