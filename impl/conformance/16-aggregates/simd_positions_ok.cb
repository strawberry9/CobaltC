// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: type.simd; rule.agg.simd; D-0254; conf.simd-positions
// kind: positive
// expect: ok
// expect-stdout-hex: 312e35202d342e33353030303034202d31322e3730303030310a646f742032302e300a342035300a61636320362e3020342e300a7468726561642032350a7468726f756768207265662031300a
//
// A `simd` as a struct field written through `&mut`, a parameter and a
// result, `*v = …` through a reference, `+=` and `*=` on the whole and on a
// lane, the elements of a `Vec`, a thread's argument, a shared reference.

import std;

struct Particle
{
    simd<f32, 4> pos;
    simd<f32, 4> vel;
}

fn step(ref<Particle, exclusive> p, f32 dt)
{
    p.pos = p.pos + p.vel * [dt; 4];
    p.vel[1] -= 9.8 * dt;
}

fn dot(simd<f32, 4> a, simd<f32, 4> b) : f32
{
    simd_sum(a * b)
}

fn scale(ref<simd<i32, 8>, exclusive> v, i32 k)
{
    *v = *v * [k; 8];
}

fn worker(simd<i64, 2> v) : i64
{
    simd_sum(v * v)
}

fn main()
{
    Particle p = Particle { .pos = [0.0; 4], .vel = [1.0, 2.0, 0.0, 0.0] };
    for (i32 k = 0; k < 3; k += 1)
    {
        step(&mut p, 0.5);
    }
    printf("%v %v %v\n", p.pos[0], p.pos[1], p.vel[1]);
    printf("dot %v\n", dot([1.0, 2.0, 3.0, 4.0], [4.0, 3.0, 2.0, 1.0]));
    simd<i32, 8> v = [1, 2, 3, 4, 5, 6, 7, 8];
    scale(&mut v, 3);
    v += [1; 8];
    v[7] *= 2;
    printf("%v %v\n", v[0], v[7]);
    Vec<simd<f64, 2>> vs = Vec::new();
    for (i32 k = 0; k < 4; k += 1)
    {
        Vec::push(&mut vs, [to_float<f64>(k), 1.0]);
    }
    simd<f64, 2> acc = [0.0; 2];
    foreach (x in &vs)
    {
        acc = acc + *x;
    }
    printf("acc %v %v\n", acc[0], acc[1]);
    simd<i64, 2> w = [3, 4];
    handle<i64> h = spawn(worker, w);
    printf("thread %v\n", join(h));
    ref<simd<i32, 8>, shared> r = &v;
    printf("through ref %v\n", (*r)[2]);
}
