// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.enum a variant with named fields (D-0324): every field is given; conf.variant-fields-missing-field
// kind: negative
// expect: diag.type-mismatch (static)
//
// A variant with fields is made as a struct literal is: every field named
// once. The message names the variant, `Shape::Rect`.
import std;

enum Shape
{
    Rect { u32 w; u32 h; },
    Dot,
}

fn main()
{
    Shape s = Shape::Rect { .w = 3 };
    _ = s;
}
