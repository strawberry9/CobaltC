// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match a variant with named fields (D-0324): matched by naming them; conf.variant-fields-one-binder-refused
// kind: negative
// expect: diag.type-mismatch (static)
//
// A variant with fields is matched by naming them, `Shape::Rect { w, h }`;
// one binder for the whole payload would have a type the program cannot
// write.
import std;

enum Shape
{
    Rect { u32 w; u32 h; },
    Dot,
}

fn main()
{
    Shape s = Shape::Dot;
    match (s)
    {
        Shape::Rect(r) : {},
        Shape::Dot     : {},
    }
}
