// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match a variant with named fields through a reference (D-0324 [Struct-Pattern-By-Ref]); conf.variant-fields-through-shared-ref, conf.variant-fields-through-exclusive-ref
// kind: positive
// expect: ok
//
// Matched through a reference, a variant's named fields are references to
// the fields: shared through `ref<E, shared>`, exclusive through
// `ref<E, exclusive>`, through which the arm changes them in place.
import std;

enum Account
{
    Open { String owner; i64 balance; },
    Closed,
}

fn total(ref<Account, shared> a) : i64
{
    match (a)
    {
        Account::Open { balance, .. } : *balance,
        Account::Closed               : 0,
    }
}

fn deposit(ref<Account, exclusive> a, i64 amount)
{
    match (a)
    {
        Account::Open { owner, balance } :
        {
            *balance += amount;
            String::append(owner, "+");
        },
        Account::Closed                  : {},
    }
}

fn main()
{
    Account a = Account::Open { .owner = "kim", .balance = 10 };
    deposit(&mut a, 5);
    assert(total(&a) == 15);
    match (&a)
    {
        Account::Open { owner, .. } : printf("%s %v\n", owner, total(&a)),
        Account::Closed             : {},
    }
}
