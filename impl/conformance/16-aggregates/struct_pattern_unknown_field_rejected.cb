// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match struct patterns (D-0224); [T-Let-Destructure]; conf.struct-pattern-unknown-field
// kind: negative
// expect: diag.type-mismatch (static)
//
// `Question` has no field `size`; the message names it (it used to say no
// field was missing).
import std;

struct Question
{
    String name;
    u32 end;
}

fn main()
{
    Option<Question> o = Some(Question { .name = "who", .end = 3 });
    match (o)
    {
        Some(Question { name, end, size }) : printf("%v\n", &name),
        None                               : {},
    }
}
