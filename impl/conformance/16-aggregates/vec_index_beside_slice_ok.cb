// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.index-vec [Index-Vec]; rule.agg.slice [Slice-Form] through a reference; D-0070; conf.vec-index-beside-slice
// kind: positive
// expect: ok
// expect-stdout-hex: 313120333120370a
//
// `v[k]` is checked as an access to element k: a live exclusive slice of
// other elements is not in the way, read or written, with a literal index
// or one a call computes. Through a reference the same holds: a slice of
// `(*r)` or `r` borrows its range of `*r`, not `r` or the whole vector, so
// `(*r)[k]`, `r[k]` and a second slice of a disjoint range live beside it.
import std;

fn id(usize i) : usize
{
    i
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    Vec::push(&mut v, 3);
    {
        slice<i32, exclusive> sl = &mut v[0 .. 1];
        v[1] = 20;
        v[id(2)] = v[1] + 10;
        sl[0] = 10;
    }
    auto r = &mut v;
    {
        slice<i32, exclusive> sl = &mut (*r)[0 .. 1];
        (*r)[1] = r[2] + 1;
        slice<i32, exclusive> s2 = &mut r[2 .. 3];
        s2[0] = 7;
        sl[0] = sl[0] + 1;
    }
    printf("%v %v %v\n", (*r)[0], r[1], (*r)[2]);
}
