// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.field-access [Field-Access] (a projection exists for its one access, D-0219, CHG-0258); conf.projection-one-access
// kind: positive
// expect: ok
//
// One statement reaches the same field twice, as the target and in the
// value: `p.a = p.a + p.b`, `*h.r = *h.r + 1`. Each `p.a` forms its own
// exclusive projection of `p`'s path; the first, for the target, is used
// for one access (the write, made last) and the second for one read. Read
// as living to the statement's end, the target's projection would clash
// with the read's; a projection exists only for the access made through it.

import std;

struct P
{
    i32 a;
    i32 b;
}

struct Hold
{
    ref<i32, exclusive> r;
}

fn main() : u8
{
    P p = P { .a = 1, .b = 2 };
    p.a = p.a + p.b;
    p.b = p.a + p.a;
    i32 x = 5;
    Hold h = Hold { .r = &mut x };
    *h.r = *h.r + 1;
    *h.r = *h.r + *h.r;
    if (p.a != 3 || p.b != 6 || *h.r != 12)
    {
        return 1;
    }
    0
}
