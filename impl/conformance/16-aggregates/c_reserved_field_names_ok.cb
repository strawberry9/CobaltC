// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.struct; conf.c-reserved-field-names
// kind: positive
// expect: ok
// expect-stdout-hex: 353320313120322e350a66616c736520302e300a
//
// Fields named as C's keywords and as macros the C a compiler emits may
// see (`int`, `float`, `char`, `long`, `switch`, `union`, `linux`, `unix`,
// `NULL`, `INFINITY`), and one spelled as such a name with a `_` after it.
// They are ordinary CobaltC names; `cobc` gave them to C as they are, and
// the C compiler refused the program (CHG-0351).

import std;

struct K
{
    i32 int;
    f64 float;
    u8 char;
    i64 long;
    bool switch;
    i32 union;
    i32 linux;
    i32 unix;
    i32 NULL;
    f64 INFINITY;
    i32 int_;
}

enum E
{
    Unsigned(K),
    Default,
}

fn total(ref<K, shared> k) : i64
{
    widen<i64>(k.int) + widen<i64>(k.char) + k.long + widen<i64>(k.union) + widen<i64>(k.linux) + widen<i64>(k.unix) + widen<i64>(k.NULL)
        + widen<i64>(k.int_)
}

fn main()
{
    K k = K {
        .int = 1,
        .float = 2.5,
        .char = 3,
        .long = 4,
        .switch = true,
        .union = 5,
        .linux = 6,
        .unix = 7,
        .NULL = 8,
        .INFINITY = 0.5,
        .int_ = 9,
    };
    k.int += 10;
    i64 t = total(&k);
    K { int, float, .. } = k;
    printf("%v %v %v\n", t, int, float);
    E e = E::Unsigned(K { .int = 0, .float = 0.0, .char = 0, .long = 0, .switch = false, .union = 0, .linux = 0, .unix = 0, .NULL = 0, .INFINITY = 0.0, .int_ = 0 });
    match (e)
    {
        E::Unsigned(x) : printf("%v %v\n", x.switch, x.INFINITY),
        E::Default     : printf("none\n"),
    }
}
