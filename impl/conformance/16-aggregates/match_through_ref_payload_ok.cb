// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match-Through-Ref] (D-0109); conf.match-through-ref-payload, conf.match-through-ref-literal
// kind: positive
// expect: ok
//
// A pattern level whose payload is a reference to an enum matches that
// enum's variants through the reference, and the binder below it is a
// reference of the reference's mode: `HashMap::get`'s
// `Option<ref<Cell, shared>>` is matched as `Some(Num(v))`, and
// `get_mut`'s lets the arm write through `v`. A literal compares through
// a reference to an integer or `bool`; two references are looked through
// as one.

import std;

enum Cell
{
    Num(i64),
    Text(String),
    Empty,
}

fn size(Option<ref<Cell, shared>> c) : i64
{
    match (c)
    {
        Some(Num(v))  : *v,
        Some(Text(t)) : narrow<i64>(widen<u64>(String::len(t))),
        Some(Empty)   : -1,
        None          : -2,
    }
}

fn main()
{
    HashMap<u32, Cell> m = HashMap::new();
    HashMap::insert(&mut m, 1, Num(42));
    HashMap::insert(&mut m, 2, Text(String::from_str("hello")));
    HashMap::insert(&mut m, 3, Empty);
    if (size(HashMap::get(&m, &1)) != 42) { 1 / (1 - 1); }
    if (size(HashMap::get(&m, &2)) != 5) { 1 / (1 - 1); }
    if (size(HashMap::get(&m, &3)) != -1) { 1 / (1 - 1); }
    if (size(HashMap::get(&m, &4)) != -2) { 1 / (1 - 1); }
    match (HashMap::get_mut(&mut m, &1))
    {
        Some(Num(v)) : { *v = *v + 1; },
        _            : {},
    }
    if (size(HashMap::get(&m, &1)) != 43) { 1 / (1 - 1); }

    HashMap<u32, u32> n = HashMap::new();
    HashMap::insert(&mut n, 1, 5);
    i32 hit = match (HashMap::get(&n, &1))
    {
        Some(5) : 1,
        Some(_) : 2,
        None    : 3,
    };
    if (hit != 1) { 1 / (1 - 1); }

    Cell c = Num(3);
    Option<ref<Cell, shared>> inner = Some(&c);
    Option<ref<Option<ref<Cell, shared>>, shared>> outer = Some(&inner);
    i64 got = match (outer)
    {
        Some(Some(Num(x))) : *x,
        Some(Some(_))      : 0,
        Some(None)         : -1,
        None               : -2,
    };
    if (got != 3) { 1 / (1 - 1); }
}
