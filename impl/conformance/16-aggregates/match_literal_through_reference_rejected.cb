// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Pattern-Type] (a reference to an integer); D-0057; conf.match-literal-through-reference
// kind: negative
// expect: diag.type-mismatch (static)
//
// A reference to an integer has no variants and is not a literal's
// type: `match (*r)` reads the value.

import std;

fn main()
{
    i32 x = 1;
    i32 v = match (&x)
    {
        1 : 1,
        _ : 0,
    };
}
