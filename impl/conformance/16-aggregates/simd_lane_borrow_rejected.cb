// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.simd [Simd-Lane]; D-0254; conf.simd-lane-borrow
// kind: negative
// expect: diag.borrow-of-non-place (static)
//
// A lane has no address of its own (C takes no vector element's address):
// it is read and assigned, and the vector is borrowed whole.

import std;

fn main()
{
    simd<i32, 4> a = [6; 4];
    ref<i32, exclusive> r = &mut a[0];
    *r = 1;
}
