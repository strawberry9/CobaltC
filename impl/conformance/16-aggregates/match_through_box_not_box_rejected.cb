// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Pattern-Type] [Match-Through-Box] (D-0301); conf.match-through-box-not-box-rejected
// kind: negative
// expect: diag.type-mismatch (static)
//
// `*x` binds through a `Box`; `Option<i64>`'s payload is an `i64`, so the
// pattern is ill-formed and the message says to bind it as `x`.

import std;

fn main() : u8
{
    Option<i64> o = Some(3);
    match (&o)
    {
        Some(*x) : printf("%d\n", *x),
        None     : {},
    }
    return 0;
}
