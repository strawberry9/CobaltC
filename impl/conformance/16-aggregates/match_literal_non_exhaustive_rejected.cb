// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match-Non-Exhaustive] (literals); D-0057; conf.match-literal-non-exhaustive
// kind: negative
// expect: diag.non-exhaustive-match (static)
//
// Literals never cover an integer type: without `_` the match misses
// every other value, and the message says `_`.

import std;

fn main()
{
    u8 x = 1;
    i32 v = match (x)
    {
        1 : 1,
        2 : 2,
    };
}
