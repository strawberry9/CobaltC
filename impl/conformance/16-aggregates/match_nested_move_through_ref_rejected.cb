// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match-Move-Through-Ref] (nested); D-0056; conf.match-nested-move-through-ref
// kind: negative
// expect: diag.move-out-of-field (static)
//
// Binding the `String` two levels down `*r` by value would move it out
// through a reference.

import std;

fn main()
{
    Option<Option<String>> o = None;
    auto r = &o;
    match (*r)
    {
        Some(Some(s)) :
        {
            printf("%s", &s);
        },
        _ :
        {
        },
    }
}
