// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: conf.shared-match-by-value-binds-exclusive; spec/08 [Read-Exclusive-Through-Shared], spec/16 [Match] (D-0218, CHG-0257)
// kind: negative
// expect: diag.borrow-exceeds-source (static)
//
// A match by value on a place reached through a shared reference would
// bind a copy of the exclusive reference in the payload: rejected; match on
// the reference (`match (e)`) to bind it shared.

import std;

enum E
{
    A(ref<i32, exclusive>),
    B,
}

fn set(ref<E, shared> e)
{
    match (*e)
    {
        A(p) : *p = 7,
        B    : {},
    }
}

fn main()
{
    i32 x = 0;
    E e = A(&mut x);
    set(&e);
}
