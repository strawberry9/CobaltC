// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match-Unreachable]; D-0056; conf.match-duplicate-arm
// kind: negative
// expect: diag.unreachable-arm (static)
//
// The second `Some` arm can never be taken: every value it matches goes
// to the first. Accepted silently before D-0056.

import std;

fn main()
{
    Option<i32> o = Some(1);
    i32 v = match (o)
    {
        Some(x) : x,
        Some(y) : y + 1,
        None : 0,
    };
}
