// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.index-vec [Index-Vec]; "One access"; spec/21 Vec::push; D-0242; conf.vec-push-own-element
// kind: positive
// expect: ok
// expect-stdout-hex: 3720372031340a
//
// A vector's element read as the value pushed onto the same vector: the
// element borrow ends with the read, before `push` writes the vector's
// length (D-0242). Read literally before D-0242, `[Index-Vec]`'s element
// borrow was a temporary of the whole statement and met `push`'s access.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 7);
    Vec::push(&mut v, v[0]);
    Vec::push(&mut v, v[0] + v[1]);
    printf("%v %v %v\n", v[0], v[1], v[2]);
}
