// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.type.expected (an expected array<τ, N> types each element of an array literal, nested literals included)
// kind: positive
// expect: ok

fn main()
{
    array<array<i64, 2>, 2> m = [[0, -1], [1, 0]];
    i64 big = 5000000000;
    // Only an i64 element can take part in i64 arithmetic with `big`.
    if (m[0][1] + big != 4999999999 || m[1][0] * big != big)
    {
        1 / (1 - 1);
    }
    array<array<i64, 2>, 2> same = [[0, -1], [1, 0]];
    if (m != same)
    {
        1 / (1 - 1);
    }
}
