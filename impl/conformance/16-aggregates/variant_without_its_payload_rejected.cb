// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.type.typing [T-Enum]; rule.agg.enum-construct
// kind: negative
// expect: diag.type-mismatch (static)
//
// A variant with a payload written bare is `Vi(())` (`[T-Enum]`): a
// payload of the wrong type. `ParseError::Invalid` carries a `usize`.
// The checker once let this through; coby failed at run time and cobc
// with an internal error.

import std;

fn check(i64 n) : Result<i64, ParseError>
{
    if (n < 0)
    {
        return Err(ParseError::Invalid);
    }
    Ok(n)
}

fn main()
{
    auto r = check(1);
}
