// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: [T-Let-Destructure] (D-0044): the value is the struct named; conf.destructure-reference
// kind: negative
// expect: diag.type-mismatch (static)
//
// Destructuring takes the struct by value: a reference to one is a type
// error, found statically (coby used to fault when it ran, and cobc stopped
// with an internal error).
import std;

struct Q
{
    String name;
    u32 end;
}

fn main()
{
    Q q = Q { .name = "a", .end = 3 };
    ref<Q, shared> r = &q;
    Q { name, end } = r;
    printf("%v %v\n", &name, end);
}
