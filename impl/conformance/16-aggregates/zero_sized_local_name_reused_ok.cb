// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: D-0208 (zero-sized types), D-0217 (a zero-sized local has an anchor of its own); conf.zero-sized-local-name-reused
// kind: positive
// expect: ok
// expect-stdout-hex: 31310a330a
//
// Two blocks of one function each declare a local `z`: a `u32` in the
// first, a value of the zero-sized `Z` in the second. They are two objects
// of two types and the name says nothing about either. Until Update 215
// the compiler, which reads a zero-sized local through a one-byte anchor,
// could take the `u32` for the anchored one (the function is lowered in
// two forms whose locals are numbered alike, and the anchored names were
// kept past the end of the form that declared them): the C it wrote did
// not compile.
import std;

struct Z {}

struct P
{
    u32 a;
    u32 b;
}

fn touch(ref<Z, shared> z) : u32
{
    7
}

fn mix(ref<P, exclusive> a) : u32
{
    a.a = a.a + a.b;
    u32 r = a.b;
    {
        u32 z = a.b;
        r = r + z;
    }
    {
        Z z = Z {};
        r = r + touch(&z);
    }
    r
}

fn main()
{
    P x = P { .a = 1, .b = 2 };
    printf("%v\n", mix(&mut x));
    printf("%v\n", x.a);
}
