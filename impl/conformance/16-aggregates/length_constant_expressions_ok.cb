// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: type.array with `length ::= const-expr` (D-0126); conf.length-constant-expression, conf.length-later-constant, conf.length-module-expression
// kind: positive
// expect: ok

import std;

const usize N = 4;
const usize M = N * 2 + 1;
const usize LATER = EARLY - 1;          // names a constant declared after it
const usize EARLY = 10;

module geom
{
    export const usize DIM = 3;
    export const usize CELLS = DIM * DIM;
    export fn grid() : array<u8, CELLS> { [7; CELLS] }
}

fn main()
{
    array<u8, M> a = [1; M];
    array<u8, (N << 1)> b = [2; N << 1];
    Vec<array<u8, N * 2>> rows = Vec::new();
    Vec::push(&mut rows, [3; 8]);
    array<u8, LATER> c = [4; 9];
    array<u8, geom::CELLS> g = geom::grid();
    array<u8, geom::DIM * 2 - 1> h = [5; 5];
    array<u8, (12 / 3) % 3 + (1 | 2) ^ 3 & 1> k = [6; 5];
    assert(sizeof<array<u8, M>>() == 9 && slice_len(&rows[0][0..$]) == 8 && sizeof<array<u8, LATER>>() == 9);
    assert(
        sizeof<array<u8, geom::CELLS>>() == 9 && sizeof<array<u8, geom::DIM * 2 - 1>>() == 5 && sizeof<array<u8, (N << 1)>>() == 8,
    );
    assert(a[8] == 1 && b[7] == 2 && c[8] == 4 && g[8] == 7 && h[4] == 5 && k[4] == 6);
    printf("ok\n");
}
