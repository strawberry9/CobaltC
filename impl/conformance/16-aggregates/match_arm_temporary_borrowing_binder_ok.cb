// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match] (the arm body as stmt-scoped), spec/14 rule.control.stmt [Stmt-Exit], rule.ref.form [Ref-Form-Temporary-Argument]; conf.match-arm-temporary-borrowing-binder
// kind: positive
// expect: ok
// expect-stdout-hex: 747275650a747275650a320a78790a
//
// An expression arm's body is a statement of its own (`[Match]`:
// `block'(f_arm, stmt-scoped(e_i, keep))`): a temporary made inside it
// that borrows the arm's binding — an `Option<StringView>` or a
// `Vec<StringView>` into `r` — ends at the arm expression's exit, before
// the arm's frame ends and destroys `r`, so `r` is destroyed solitary.
// Only the arm's value, and what it refers into, outlives the arm. (The
// interpreter once kept such temporaries to the enclosing statement's
// end and reported `diag.destroy-while-aliased`, 2026-10-07.)

import std;

fn main()
{
    Result<String, u8> r0 = Ok(String::from_str("xy"));
    match (r0)
    {
        Ok(r)  : printf("%v\n", Option::is_some(&String::strip_prefix(&r, "x"))),
        Err(_) : {},
    }
    Option<String> o = Some(String::from_str("xy"));
    match (o)
    {
        Some(r) : printf("%v\n", Option::is_some(&String::find(&r, "y"))),
        None    : {},
    }
    Option<String> o2 = Some(String::from_str("xy"));
    match (o2)
    {
        Some(r) : printf("%v\n", Vec::len(&String::chars(&r))),
        None    : {},
    }
    // The arm's value may carry the binding's text out only as a copy.
    Option<String> o3 = Some(String::from_str("xy"));
    String back = match (o3)
    {
        Some(r) : String::from_view(Option::unwrap_or(String::strip_suffix(&r, "x"), String::as_view(&r))),
        None    : String::new(),
    };
    printf("%v\n", &back);
}
