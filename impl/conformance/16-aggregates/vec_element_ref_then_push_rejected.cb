// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.index [Index-Vec]; rule.control.flow-analysis (deriv facts)
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `&v[0]` is `Vec::index_shared(&v, 0)` ([Index-Vec]): a reference
// derived from a borrow of `v`, so `Vec::push(&mut v, …)` while it lives
// is rejected statically, as it is for the call written out. The checker
// once tracked only the call.

import std;

fn main()
{
    Vec<i64> v = Vec::new();
    Vec::push(&mut v, 1);
    auto r = &v[0];
    Vec::push(&mut v, 2);
}
