// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.slice [Slice-Form] (D-0070); rule.stdlib.vec; conf.vec-pop-through-ref-beside-slice
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// As `conf.vec-grow-through-ref-beside-slice`, with a slice taken by
// auto-deref (`r[0 .. 1]`, a range of `*r`) and `Vec::pop` writing the
// length: the vector's fields meet the slice, so the call faults.
//
// D-0282: the static pass rejects this program before it runs (it was found
// at run time before): `Vec::pop` writes `*r` through argument 1 while `sl`
// still borrows `(*r)[0 .. 1]`.
import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    auto r = &mut v;
    slice<i32, exclusive> sl = &mut r[0 .. 1];
    _ = Vec::pop(r);
    printf("%v\n", sl[0]);
}
