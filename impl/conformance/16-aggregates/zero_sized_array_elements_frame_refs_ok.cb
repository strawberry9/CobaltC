// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.control.frame-references, spec/04 overlap (D-0217, CHG-0380); conf.zero-sized-array-elements-frame-refs
// kind: positive
// expect: ok
// expect-stdout-hex: 6f6b20330a
//
// The elements of an `array<Z, N>` are N places, told apart by their
// steps (D-0217), and so are the elements of a `Vec` of a type that is
// not zero-sized: exclusive borrows of two of them may both live.

import std;

struct Z {}

fn main()
{
    array<Z, 2> a = [Z {}, Z {}];
    ref<Z, exclusive> a0 = &mut a[0];
    ref<Z, exclusive> a1 = &mut a[1];
    *a0 = Z {};
    *a1 = Z {};
    Vec<i32> w = Vec::new();
    Vec::push(&mut w, 1);
    Vec::push(&mut w, 2);
    ref<i32, exclusive> w0 = &mut w[0];
    ref<i32, exclusive> w1 = &mut w[1];
    *w0 = 1;
    *w1 = 2;
    printf("ok %v\n", w[0] + w[1]);
}
