// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.index [Index-Checked], [Slice-Index]; D-0320; conf.length-guard-long-slices
// kind: positive
// expect: ok
// expect-stdout-hex: 3230382032303820313020300a
//
// A loop whose bounds are known before the run, indexing two slice
// parameters: long enough slices, so every index is in range. The
// compilers emit the loop twice under a test of the slices' lengths
// (D-0320), each copy with every check; the program is the same either way.

import std;

const usize W = 8;
const usize H = 6;

fn blur(slice<u32, shared> src, slice<u32, exclusive> dst)
{
    for (usize y = 1; y < H - 1; y += 1)
    {
        foreach (x in 1..W - 1)
        {
            usize i = y * W + x;
            dst[i] = (src[i - W] + src[i - 1] + src[i] + src[i + 1] + src[i + W]) / 5;
        }
    }
}

fn main()
{
    Vec<u32> a = Vec::filled(W * H, 10);
    Vec<u32> b = Vec::filled(W * H + 3, 0);
    a[3 * W + 4] = 1000;
    blur(&a, &mut b);
    printf("%v %v %v %v\n", b[3 * W + 4], b[2 * W + 4], b[W + 1], b[0]);
}
