// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match (a variant of another enum in a pattern); D-0056; conf.match-nested-wrong-enum
// kind: negative
// expect: diag.type-mismatch (static)
//
// `Ok` is not a variant of `Option<i32>`, the type of `Some`'s payload.

import std;

fn main()
{
    Option<Option<i32>> o = None;
    i32 v = match (o)
    {
        Some(Ok(x)) : x,
        _ : 0,
    };
}
