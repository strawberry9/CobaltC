// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.control.foreach (element reads, and every other use of the element)
// kind: positive
// expect: ok
//
// `foreach (x in &v)` over plain elements: a body that only reads `*x`
// (which `cobc` compiles as an element read, without a reference per
// step), and bodies that borrow `x` again, pass it on, match through it,
// capture it or shadow it (compiled with the reference), all give the
// same results; so does looping over a reference parameter, a slice and
// an array, and `Vec::clear` of a Vec whose elements were read.

import std;

fn total(ref<Vec<u32>, shared> v) : u64
{
    u64 s = 0;
    foreach (x in v)
    {
        s += widen<u64>(*x);
    }
    s
}

fn deref(ref<u32, shared> r) : u32
{
    *r
}

fn main()
{
    Vec<u32> v = Vec::new();
    u32 i = 1;
    while (i <= 100)
    {
        Vec::push(&mut v, i);
        i += 1;
    }
    u64 a = 0;
    foreach (x in &v)
    {
        a += widen<u64>(*x) * 2;
    }
    u64 b = 0;
    foreach (x in &v)
    {
        ref<u32, shared> again = &*x;
        b += widen<u64>(*again) * 2;
    }
    u64 c = 0;
    foreach (x in &v)
    {
        c += widen<u64>(deref(x)) * 2;
    }
    u64 d = 0;
    foreach (x in &v)
    {
        match (*x % 2)
        {
            0 :
            {
                d += widen<u64>(*x) * 2;
            },
            _ :
            {
                d += widen<u64>(*x) * 2;
            },
        }
    }
    u64 e = 0;
    foreach (x in &v)
    {
        auto twice = [x]()
        {
            widen<u64>(*x) * 2
        };
        e += twice();
    }
    u64 f = 0;
    foreach (x in &v)
    {
        u32 x2 = *x * 2;
        f += widen<u64>(x2);
    }
    array<u32, 3> arr = [1, 2, 3];
    u64 g = 0;
    foreach (x in &arr)
    {
        g += widen<u64>(*x);
    }
    u64 h = 0;
    foreach (x in &v[10..20])
    {
        h += widen<u64>(*x);
    }
    Vec::clear(&mut v);
    Vec::push(&mut v, 7);
    if (a != 10100 || b != a || c != a || d != a || e != a || f != a || total(&v) != 7 || g != 6 || h != 155)
    {
        1 / (1 - 1);
    }
}
