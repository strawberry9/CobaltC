// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: [Destroy-Composite]; conf.destroy-composite-multi-field-order
// kind: positive
// expect: ok
// expect-stdout-hex: 5a5958
//
// Resource fields of a struct are destroyed in reverse declaration
// order at the struct's own destruction, mirroring stack unwind order.

import std;

resource struct Tagged
{
    u8 tag;
}

fn Tagged::drop(ref<Tagged, exclusive> self)
{
    auto b = [self.tag];
    rawptr<u8> p = reinterpret_ptr<u8>(rawptr_of(&b));
    unsafe
    {
        write(p, 1);
    }
}

resource struct Holder
{
    Tagged a;
    Tagged b;
    Tagged c;
}

fn main()
{
    Holder h = Holder { .a = Tagged { .tag = 88 }, .b = Tagged { .tag = 89 }, .c = Tagged { .tag = 90 } };
}
