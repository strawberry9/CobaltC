// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match-Through-Box] (D-0301), spec/22 §2 `pattern`; conf.match-through-box-top-level-rejected
// kind: negative
// expect: diag.syntax-error (static)
//
// `*x` binds a variant's payload through its `Box`, so it stands only
// inside a variant's parentheses; a whole scrutinee has no payload.

import std;

fn main() : u8
{
    Box<i64> b = Box::new(1);
    match (b)
    {
        *x : printf("%d\n", x),
    }
    return 0;
}
