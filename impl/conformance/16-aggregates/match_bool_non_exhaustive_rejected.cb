// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match-Non-Exhaustive] (a `bool` level); D-0057; conf.match-bool-non-exhaustive
// kind: negative
// expect: diag.non-exhaustive-match (static)
//
// `true` and `false` cover a `bool`; `Some(true)` and `None` leave
// `Some(false)`, which the message names.

import std;

fn main()
{
    Option<bool> o = None;
    i32 v = match (o)
    {
        Some(true) : 1,
        None : 0,
    };
}
