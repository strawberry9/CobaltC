// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.index-vec [Index-Vec]; [Index-Out-Of-Bounds]
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// Indexing a Vec field of a local struct past its end faults, at the
// index's line, in a function that uses the field only by indexing and
// `Vec::len`: an implementation that leaves out other checks there keeps
// the bounds check.

import std;

struct H
{
    Vec<i64> v;
    i64 n;
}

fn last_plus_one(usize n) : i64
{
    H h = H { .v = Vec::new(), .n = 0 };
    i64 t = 0;
    foreach (i in 0..Vec::len(&h.v))
    {
        t += h.v[i];
    }
    h.n = narrow<i64>(n);
    t + h.v[n]
}

fn main()
{
    printf("%v\n", last_plus_one(0));
}
