// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.index-vec [Index-Vec]; [Read-Conflict]; [Write-Conflict]
// kind: positive
// expect: ok
//
// Reading a Vec's elements while a shared reference to one of them is
// held, then (once it has ended) writing, pushing and popping; and the
// same reads beside an exclusive element borrow. Reads never conflict
// with a shared reference, so every value read must be the current one.

import std;

fn build(usize n) : Vec<i64>
{
    Vec<i64> v = Vec::new();
    foreach (i in 0..n)
    {
        Vec::push(&mut v, narrow<i64>(i));
    }
    v
}

fn held(usize n) : i64
{
    Vec<i64> v = build(n);
    ref<i64, shared> first = &v[0];
    ref<i64, shared> third = &v[2];
    i64 t = 0;
    foreach (i in 0..Vec::len(&v))
    {
        t += v[i] * *third;
    }
    t + *first
}

fn mixed(usize n) : i64
{
    Vec<i64> v = build(n);
    i64 t = 0;
    {
        ref<i64, shared> last = &v[n - 1];
        t += *last + v[0];
    }
    v[1] = 50;
    v[2] += v[1];
    Vec::push(&mut v, 7);
    _ = Vec::pop(&mut v);
    foreach (i in 0..Vec::len(&v))
    {
        t += v[i];
    }
    t
}

fn excl(usize n) : i64
{
    Vec<i64> v = build(n);
    ref<i64, exclusive> e = &mut v[0];
    *e = 100;
    v[0] + v[1]
}

fn main()
{
    assert(held(10) == 90);
    // 9 + 0, then 0 + 50 + 52 + 3 + … + 9.
    assert(mixed(10) == 9 + 0 + 50 + 52 + 42);
    assert(excl(5) == 101);
    printf("ok\n");
}
