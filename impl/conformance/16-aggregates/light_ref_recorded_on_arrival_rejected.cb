// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.control.frame-references (a reference recorded on arrival, D-0292); conf.light-ref-recorded-on-arrival-written
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// As `conf.light-ref-recorded-on-arrival`, with `i = 3`: `e` is the element
// the write `(*arr)[3] = 7` reaches, which only the values decide, so the
// run checks it through `arr`'s record and faults.

import std;

struct Inner
{
    u64 a;
    u64 b;
}

struct Outer
{
    Inner x;
    Inner y;
    Vec<u64> arr;
}

fn work(ref<Inner, exclusive> p, ref<Inner, shared> q, ref<Vec<u64>, exclusive> arr, usize i) : u64
{
    ref<u64, exclusive> e = &mut (*arr)[i];
    (*arr)[3] = 7;
    *e = *e + 1;
    (*p).a = (*q).a + 1;
    (*p).a + (*q).b
}

fn main()
{
    Outer o = Outer { .x = Inner { .a = 1, .b = 2 }, .y = Inner { .a = 3, .b = 4 }, .arr = Vec::filled(4, 0: u64) };
    u64 r = work(&mut o.x, &o.y, &mut o.arr, 3);
    printf("%v %v %v\n", r, o.x.a, o.arr[1]);
}
