// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: [Match-Unreachable] (D-0056, D-0224; CHG-0439): an arm after a struct pattern; conf.arm-after-struct-pattern-unreachable
// kind: negative
// expect: diag.unreachable-arm (static)
//
// A struct pattern matches every value of its struct, so the second arm is
// never reached. It was not reported: the check ran only for scrutinees
// with variants or literals.

import std;

struct P
{
    i32 a;
    i32 b;
}

fn main()
{
    P p = P { .a = 1, .b = 2 };
    match (p)
    {
        P { a, .. } : printf("%v\n", a),
        P { b, .. } : printf("%v\n", b),
    }
}
