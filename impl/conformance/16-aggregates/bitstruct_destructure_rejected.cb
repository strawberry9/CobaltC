// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: type.bitstruct `[Bitstruct-Whole]` (D-0118); conf.bitstruct-destructure-rejected
// kind: negative
// expect: diag.type-mismatch (static)

import std;

bitstruct B : u8 { lo : 4; hi : 4; }

fn main()
{
    B b = B { .lo = 1, .hi = 0 };
    B { lo, hi } = b;
}
