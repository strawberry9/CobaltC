// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: diag.index-out-of-bounds
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
//
// Indexing guarded by `i < 3` never faults; the same indexing under a
// guard of `j <= 3` faults when `j` reaches 3, after the first loop's sum
// has been checked.

fn main()
{
    array<i32, 3> a = [1, 2, 3];
    usize i = 0;
    i32 sum = 0;
    while (i < 3)
    {
        sum = sum + a[i];
        i = i + 1;
    }
    if (sum != 6)
    {
        1 / (1 - 1);
    }
    usize j = 0;
    while (j <= 3)
    {
        sum = sum + a[j];
        j = j + 1;
    }
}
