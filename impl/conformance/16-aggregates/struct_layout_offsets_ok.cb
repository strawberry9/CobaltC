// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.layout [Layout-Struct]; rule.arith.sizeof [Sizeof-Struct]; D-0250; conf.struct-layout-offsets
// kind: positive
// expect: ok
// expect-stdout-hex: 323420343020313220313020300a
//
// `[Layout-Struct]` fixes the offsets: each field at the first offset its
// alignment allows after the previous one, the end padded to the largest
// alignment. The sizes and alignments below follow from that alone.

import std;

struct A
{
    u8 a;
    u64 b;
    u16 c;
}

struct B
{
    u8 x;
    A inner;
    u8 y;
}

struct C
{
    u16 a;
    u8 b;
    u32 c;
    u8 d;
}

struct D
{
    u8 a;
    array<u16, 3> b;
    bool c;
}

struct E
{
}

fn main()
{
    assert(sizeof<A>() == 24 && alignof<A>() == 8);       // a 0, b 8, c 16, end 18 -> 24
    assert(sizeof<B>() == 40 && alignof<B>() == 8);       // x 0, inner 8, y 32 -> 40
    assert(sizeof<C>() == 12 && alignof<C>() == 4);       // a 0, b 2, c 4, d 8 -> 12
    assert(sizeof<D>() == 10 && alignof<D>() == 2);       // a 0, b 2, c 8 -> 10
    assert(sizeof<E>() == 0 && alignof<E>() == 1);
    printf("%v %v %v %v %v\n", sizeof<A>(), sizeof<B>(), sizeof<C>(), sizeof<D>(), sizeof<E>());
}
