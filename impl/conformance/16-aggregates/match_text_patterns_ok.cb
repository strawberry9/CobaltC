// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match] (text literal patterns); D-0127; conf.match-text-literals
// kind: positive
// expect: ok
// expect-stdout-hex: 3120322030202d310a61666669726d617469766520756e6b6e6f776e0a313020330a31203220330a312037203820350a31203320340a3120312031310a6279650a3220300a320a
//
// Text literal patterns (D-0127): a `match` on `str`, on a `String` (a
// binding, a field, a temporary, `*r` through a reference) and on a
// `StringView`; `Some("x")` inside a payload, through a reference
// payload too; the empty text; a binder arm after literals takes the
// whole `String`; `_` leaves it where it is; a text pattern as an `if`
// and a `while` condition (D-0115).

import std;

struct Rec { String name; StringView tag; }

fn code(str s) : i32
{
    match (s)
    {
        "get" : 1,
        "put" : 2,
        ""    : 0,
        _     : -1,
    }
}

fn kind(ref<String, shared> s) : str
{
    match (*s)
    {
        "yes" : "affirmative",
        "no"  : "negative",
        _     : "unknown",
    }
}

fn pick(Option<String> o) : i32
{
    match (o)
    {
        Some("x") : 1,
        Some(_)   : 2,
        None      : 3,
    }
}

fn next(ref<Vec<str>, exclusive> q) : str
{
    match (Vec::pop(q)) { Some(s) : s, None : "stop", }
}

fn main()
{
    printf("%d %d %d %d\n", code("get"), code("put"), code(""), code("zzz"));
    String s = "yes";
    printf("%s %s\n", kind(&s), kind(&String::from_str("maybe")));
    i32 a = match (s) { "yes" : 10, "no" : 20, _ : 30, };
    printf("%d %d\n", a, String::len(&s));
    printf("%d %d %d\n", pick(Some(String::from_str("x"))), pick(Some(String::from_str("y"))), pick(None));
    String owner = "v-tag";
    Rec r = Rec { .name = "alpha", .tag = String::as_view(&owner) };
    i32 b = match (r.name) { "alpha" : 1, "beta" : 2, _ : 0, };
    i32 c = match (r.tag) { "v-tag" : 7, _ : 0, };
    i32 d = match (StringView::sub(r.tag, 0, 1)) { "v" : 8, _ : 0, };
    printf("%d %d %d %d\n", b, c, d, String::len(&r.name));
    i32 t = match (String::from_str("k")) { "k" : 1, _ : 2, };
    usize n = match (s) { "nope" : 0, other : String::len(&other), };
    usize e = match (String::from_str("quux")) { "k" : 0, other : String::len(&other), };
    printf("%d %d %d\n", t, n, e);
    Option<ref<String, shared>> rr = Some(&owner);
    i32 q = match (rr) { Some("v-tag") : 1, Some(_) : 2, None : 3, };
    Result<String, str> res = Ok(String::from_str("x"));
    i32 f = match (&res) { Ok("x") : 1, Ok(_) : 2, Err("bad") : 3, Err(_) : 4, };
    i32 g = match (res) { Ok("y") : 1, Ok(v) : narrow<i32>(String::len(&v)) + 10, Err(_) : 4, };
    printf("%d %d %d\n", q, f, g);
    str cmd = "quit";
    if ("quit" = cmd) { printf("bye\n"); } else { printf("go\n"); }
    Vec<str> queue = Vec::new();
    Vec::push(&mut queue, "b");
    Vec::push(&mut queue, "go");
    Vec::push(&mut queue, "go");
    i32 steps = 0;
    while ("go" = next(&mut queue)) { steps = steps + 1; }
    printf("%d %d\n", steps, Vec::len(&queue));
    String s2 = "m";
    match (s2) { "m" : { String::append(&mut s2, "!"); }, _ : {}, }
    printf("%d\n", String::len(&s2));
}
