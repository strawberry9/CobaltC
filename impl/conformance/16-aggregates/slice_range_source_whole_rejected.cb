// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.slice [Slice-Form]; D-0070; conf.slice-range-source-whole
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// Anything that reaches the whole source conflicts with a live slice of
// it: `Vec::push` could move the elements the slice reaches.

import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    slice<i32, exclusive> x = &mut v[0 .. 1];
    Vec::push(&mut v, 3);
    x[0] = 7;
}
