// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: [Struct-Pattern-By-Ref]; D-0324; conf.struct-pattern-by-ref-generic
// kind: positive
// expect: ok
//
// In a generic body, a struct pattern and a variant with fields reached
// through a reference bind references to the fields when the type mentions
// the type parameter, shared and exclusive (bug 003: they bound values).

import std;

struct Sg<T>
{
    T a;
    String name;
}

struct P<T>
{
    T a;
    T b;
}

enum G<T>
{
    Leaf,
    Node { Box<G<T>> left; T value; },
}

fn name_len<T>(ref<Option<Sg<T>>, shared> o) : usize
{
    match (o)
    {
        Some(Sg { a, name }) : StringView::len(name),
        None                 : 0,
    }
}

fn swap_in<T: number>(ref<Option<P<T>>, exclusive> o)
{
    match (o)
    {
        Some(P { a, b }) :
        {
            T t = *a;
            *a = *b;
            *b = t;
        },
        None             : {},
    }
}

fn depth<T>(ref<G<T>, shared> t) : i32
{
    match (t)
    {
        G::Leaf                 : 0,
        G::Node { left, value } : 1 + depth(Box::get(left)),
    }
}

fn main()
{
    Option<Sg<u8>> g = Some(Sg { .a = 1, .name = "hi" });
    assert(name_len(&g) == 2);
    Option<P<i32>> p = Some(P { .a = 1, .b = 2 });
    swap_in(&mut p);
    match (p)
    {
        Some(q) : assert(q.a == 2 && q.b == 1),
        None    : assert(false),
    }
    G<i32> t = G::Node { .left = Box::new(G::Node { .left = Box::new(G::Leaf), .value = 2 }), .value = 1 };
    assert(depth(&t) == 2);
    printf("ok\n");
}
