// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.layout [Type-Recursion-Expanding]; conf.type-recursion-expanding
// kind: negative
// expect: diag.instantiation-unbounded (static)
//
// `Nest<T>` holds a `Nest<Option<T>>`, which holds a
// `Nest<Option<Option<T>>>`, and so on: each value has a finite size, but
// the types the program needs never end. The declaration is rejected
// where it is written, though nothing names the type.

import std;

enum Nest<T>
{
    Leaf(T),
    Deeper(Box<Nest<Option<T>>>),
}

fn main() : u8
{
    printf("ok\n");
    0
}
