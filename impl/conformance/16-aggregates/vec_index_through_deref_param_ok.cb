// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.index-vec [Index-Vec]; `(*v)[k]` on a reference parameter; conf.vec-index-through-deref-param
// kind: positive
// expect: ok
// expect-stdout-hex: 35203320380a
//
// `(*v)[k]` and `v[k]` on a `Vec` reference parameter are one access
// (`[Index-Vec]`: `*Vec::index_shared(&*v, k)`), read, written, and with a
// computed index in a loop. The native compiler once refused the
// parenthesised form on a parameter it had confined to element reads
// ("unresolved path"), while the interpreter ran it.

import std;

fn second(ref<Vec<i32>, shared> v) : i32
{
    (*v)[1]
}

fn bump(ref<Vec<i32>, exclusive> v)
{
    (*v)[0] = (*v)[0] + 1;
}

fn sum(ref<Vec<i32>, shared> v) : i32
{
    i32 s = 0;
    foreach (i in 0 .. Vec::len(v))
    {
        s += (*v)[i];
    }
    s
}

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 2);
    Vec::push(&mut v, 5);
    i32 b = second(&v);
    bump(&mut v);
    printf("%d %d %d\n", b, v[0], sum(&v));
}
