// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.layout [Layout-Struct]; D-0251; conf.struct-align
// kind: positive
// expect: ok
// expect-stdout-hex: 3139322034322031300a
//
// `align(N)` raises a struct's alignment to N and its size to a multiple of
// it, and never lowers either: on a generic struct, nested in another, as an
// array element, and below the fields' own alignment. `align` stays an
// ordinary name everywhere else.

import std;

struct Line align(64)
{
    u64 n;
}

struct Pair<T> align(16)
{
    T a;
    T b;
}

struct Low align(2)
{
    u64 n;
}

struct Holder
{
    u8 tag;
    Line l;
    u8 after;
}

fn main()
{
    usize align = 64;
    assert(sizeof<Line>() == 64 && alignof<Line>() == align);
    assert(sizeof<Pair<u8>>() == 16 && alignof<Pair<u8>>() == 16);
    assert(sizeof<Pair<u64>>() == 16 && sizeof<Pair<u128>>() == 32);
    assert(sizeof<Low>() == 8 && alignof<Low>() == 8);
    assert(sizeof<Holder>() == 192 && alignof<Holder>() == 64);
    assert(sizeof<array<Line, 3>>() == 192);
    Holder h = Holder { .tag = 1, .l = Line { .n = 41 }, .after = 2 };
    h.l.n = h.l.n + 1;
    Vec<Line> v = Vec::new();
    Vec::push(&mut v, h.l);
    Vec::push(&mut v, Line { .n = 8 });
    printf("%v %v %v\n", sizeof<Holder>(), v[0].n, v[1].n + widen<u64>(h.after));
}
