// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: spec/21 §0 simd_store; D-0254; conf.simd-store-shared
// kind: negative
// expect: diag.type-mismatch (static)
//
// `simd_store` writes, so it takes an exclusive slice.

import std;

fn main()
{
    Vec<i32> v = Vec::filled(8, 0: i32);
    simd_store(&v[0 .. $], 0, [1; 4]);
}
