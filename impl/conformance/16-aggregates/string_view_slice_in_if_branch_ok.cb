// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: D-0053 `&s[lo..hi]` on a `String`; rule.control.if
// kind: positive
// expect: ok
//
// A view of a `String` formed inside an `if` branch, and `==` between a
// view and a `str` there. cobc lowered an `if`'s then-branch from a copy
// of it, so the checker's record of each view operation (kept per
// expression) was not found, and it stopped with an internal error
// ("slice of something that is not an array, a Vec or a slice"). Found by
// real-world testing (a JSON string escaper).

import std;

fn escape(ref<String, exclusive> out, ref<String, shared> s)
{
    usize run = 0;
    usize i = 0;
    usize n = String::len(s);
    while (i < n)
    {
        if (String::as_bytes(s)[i] == b'"')
        {
            String::append(out, &s[run..i]);
            String::append(out, "\\\"");
            run = i + 1;
        }
        i += 1;
    }
    String::append(out, &s[run..n]);
}

fn main()
{
    String out = String::new();
    String s = String::from_str("say \"hi\" now");
    escape(&mut out, &s);
    assert(String::eq_str(&out, "say \\\"hi\\\" now"));
    bool seen = false;
    if (String::len(&s) > 3)
    {
        seen = &s[0..3] == "say";
    }
    assert(seen);
}
