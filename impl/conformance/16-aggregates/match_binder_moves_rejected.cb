// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match (a top-level binder moves a resource); D-0058; conf.match-binder-moves
// kind: negative
// expect: diag.stale-binding (static)
//
// The binder takes the `String`: `s` is moved, and using it afterwards
// is stale.

import std;
fn main()
{
    String s = String::from_str("x");
    match (s)
    {
        t : printf("%s\n", &t),
    }
    usize n = String::len(&s);
}
