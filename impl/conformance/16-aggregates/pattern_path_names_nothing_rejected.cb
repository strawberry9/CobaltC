// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: [Pattern-Type] (D-0058; CHG-0439): a qualified path in a pattern that names no variant and no constant; conf.pattern-path-names-nothing
// kind: negative
// expect: diag.unbound-name (static)
//
// A path is never a binder. `Foo::Q` names nothing, and was taken for a
// binder `Q`, which matched every value.

import std;

enum A
{
    X,
    Y(i32),
}

fn main()
{
    A a = A::Y(3);
    match (a)
    {
        A::X   : printf("x\n"),
        Foo::Q : printf("q\n"),
    }
}
