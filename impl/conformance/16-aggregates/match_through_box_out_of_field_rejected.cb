// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match-Through-Box] [Match-Move-Through-Ref] (D-0301); conf.match-through-box-out-of-field-rejected
// kind: negative
// expect: diag.move-out-of-field (static)
//
// By value, `E::A(*x)` moves the `Box` out of the scrutinee to take its
// value; `s.e` is part of `s`, so the box cannot be moved out of it
// (match on `&s.e` to borrow it).

import std;

enum E
{
    A(Box<i64>),
    B,
}

struct S
{
    E e;
}

fn main() : u8
{
    S s = S { .e = E::A(Box::new(5)) };
    match (s.e)
    {
        E::A(*x) : printf("%d\n", x),
        E::B     : {},
    }
    return 0;
}
