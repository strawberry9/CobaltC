// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.simd; spec/21 §0 vector intrinsics; D-0254; conf.simd-intrinsics
// kind: positive
// expect: ok
// expect-stdout-hex: 6c6f616420312e3020312e3520322e3020322e350a6d61736b2030202d31202d31202d3120616e79207920616c6c206e0a73656c65637420302e3020312e3520322e3020322e350a73756d20372e30206d696e20312e30206d617820322e350a73746f7265642031302e302032352e300a77726170203420736174203235350a6d696e20312e3020332e300a
//
// Loads from and stores to a `Vec`'s slice, masks from a comparison,
// selection, any/all, the reductions, wrapping and saturating lanes, and
// a lane-wise minimum.

import std;

fn main()
{
    Vec<f32> xs = Vec::new();
    for (i32 k = 0; k < 10; k += 1)
    {
        Vec::push(&mut xs, to_float<f32>(k) * 0.5);
    }
    simd<f32, 4> v = simd_load<simd<f32, 4>>(&xs[0 .. $], 2);
    printf("load %v %v %v %v\n", v[0], v[1], v[2], v[3]);
    simd<i32, 4> m = simd_gt(v, [1.4; 4]);
    printf(
        "mask %v %v %v %v any %s all %s\n",
        m[0],
        m[1],
        m[2],
        m[3],
        if (simd_any(m)) { "y" } else { "n" },
        if (simd_all(m)) { "y" } else { "n" },
    );
    simd<f32, 4> s = simd_select(m, v, [0.0; 4]);
    printf("select %v %v %v %v\n", s[0], s[1], s[2], s[3]);
    printf("sum %v min %v max %v\n", simd_sum(v), simd_reduce_min(v), simd_reduce_max(v));
    simd_store(&mut xs[0 .. $], 6, v * [10.0; 4]);
    printf("stored %v %v\n", xs[6], xs[9]);
    simd<u8, 16> a = [250; 16];
    simd<u8, 16> w = wrapping_add(a, [10; 16]);
    simd<u8, 16> sat = saturating_add(a, [10; 16]);
    printf("wrap %v sat %v\n", w[0], sat[0]);
    simd<f64, 2> p = simd_min([1.0, 5.0], [2.0, 3.0]);
    printf("min %v %v\n", p[0], p[1]);
}
