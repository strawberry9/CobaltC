// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.field-access [Field-Access-Auto-Deref]; rule.ref.form
// kind: positive
// expect: ok
//
// `f().x` for an `f` returning a reference is `(*f()).x`: a place reached
// through that reference, not a projection of a temporary. So `&f().x`,
// `&mut g().x`, `&f().v[0]` and `&f().v[0..$]` are borrows of places,
// exactly as their explicit `(*f())` spellings are; the checker once
// rejected them as diag.borrow-of-temporary.

import std;

struct Pair
{
    i64 x;
    Vec<i64> v;
}

fn read(ref<i64, shared> r) : i64
{
    *r
}

fn bump(ref<i64, exclusive> r)
{
    *r = *r + 10;
}

fn get(ref<Box<Pair>, shared> b) : ref<Pair, shared>
{
    Box::get(b)
}

fn main()
{
    Vec<i64> v = Vec::new();
    Vec::push(&mut v, 4);
    Box<Pair> b = Box::new(Pair { .x = 1, .v = v });
    bump(&mut Box::get_mut(&mut b).x);
    auto s = &get(&b).v[0..$];
    i64 total = read(&get(&b).x) + read(&(*get(&b)).x) + read(&get(&b).v[0]) + s[0];
    if (total != 30)
    {
        fault(index_out_of_bounds);
    }
}
