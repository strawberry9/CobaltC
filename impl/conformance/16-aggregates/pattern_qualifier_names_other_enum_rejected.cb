// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: [Pattern-Type] (D-0056; CHG-0439): a variant written with another enum's qualifier; conf.pattern-qualifier-names-other-enum
// kind: negative
// expect: diag.type-mismatch (static)
//
// `B::X` is a variant of `B`, and the value matched is an `A`; the parser
// kept only the variant's name, so both tools took it for `A::X`.

import std;

enum A
{
    X,
    Y(i32),
}

enum B
{
    X,
    Y(i32),
}

fn main()
{
    A a = A::Y(3);
    match (a)
    {
        B::X    : printf("x\n"),
        A::Y(v) : printf("%v\n", v),
    }
}
