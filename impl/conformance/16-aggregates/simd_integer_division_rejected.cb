// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: type.simd; rule.agg.simd [Simd-Op-Ill-Typed]; D-0254; conf.simd-int-div
// kind: negative
// expect: diag.type-mismatch (static)
//
// No common processor divides integer lanes at once, so `/` on a `simd` is
// for float lanes.

import std;

fn main()
{
    simd<i32, 4> a = [6; 4];
    simd<i32, 4> b = a / [2; 4];
}
