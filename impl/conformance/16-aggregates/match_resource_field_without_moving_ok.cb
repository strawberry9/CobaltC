// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match] (D-0049: consumed only by an arm that moves a payload out)
// kind: positive
// expect: ok
//
// A by-value match on a resource field, a `Vec` element and `*r`, whose
// arms move nothing out (`_`, payload-less variants, `Some(_)`): nothing
// is consumed, and each place still holds its value afterwards. cobc
// once read such a scrutinee as a value, which for a field is a move out
// of it (an internal error).

import std;

struct Holder
{
    Option<String> spare;
}

fn kind(ref<Option<String>, shared> r) : i32
{
    match (*r)
    {
        None : 0,
        Some(_) : 1,
    }
}

fn main()
{
    Holder h = Holder { .spare = Some(String::from_str("kept")) };
    i32 a = match (h.spare) { None : 0, _ : 1 };
    Vec<Option<String>> v = Vec::new();
    Vec::push(&mut v, None);
    Vec::push(&mut v, Some(String::from_str("x")));
    i32 b = match (v[1]) { Some(_) : 2, None : 0 };
    i32 c = kind(&h.spare);
    usize n = match (&h.spare) { Some(s) : String::len(s), None : 0 };
    if (a + b + c != 4 || n != 4)
    {
        fault(index_out_of_bounds);
    }
}
