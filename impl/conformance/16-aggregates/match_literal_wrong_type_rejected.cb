// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Pattern-Type] (a literal); D-0057; conf.match-literal-wrong-type
// kind: negative
// expect: diag.type-mismatch (static)
//
// A literal takes the type at its level exactly: `1` is not a `bool`.

import std;

fn main()
{
    bool b = true;
    i32 v = match (b)
    {
        1 : 1,
        _ : 0,
    };
}
