// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: [Struct-Pattern-By-Ref]; D-0324; conf.struct-pattern-by-ref-generic-move-out
// kind: negative
// expect: diag.type-mismatch (static)
//
// Through a shared reference, in a generic body, a struct pattern's field is
// a reference: giving it where a `String` is wanted would move it out from
// behind the reference, and is refused in the generic body itself (bug 003).

import std;

struct Sg<T>
{
    T a;
    String name;
}

fn steal<T>(ref<Option<Sg<T>>, shared> o) : String
{
    match (o)
    {
        Some(Sg { a, name }) : name,
        None                 : "",
    }
}

fn main()
{
    Option<Sg<u8>> g = Some(Sg { .a = 1, .name = "hello" });
    String s = steal(&g);
    printf("stolen %s\n", &s);
}
