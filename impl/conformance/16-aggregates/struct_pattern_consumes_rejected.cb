// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match struct patterns (D-0224); a resource field moved out consumes the scrutinee; conf.struct-pattern-consumes
// kind: negative
// expect: diag.stale-binding (static)
//
// The pattern moves the `String` field out of the payload, which consumes
// `o` as any binder of a resource payload does: `o` is not used again.
import std;

struct Question
{
    String name;
    u32 end;
}

fn main()
{
    Option<Question> o = Some(Question { .name = "who", .end = 3 });
    match (o)
    {
        Some(Question { name, .. }) : printf("%v\n", &name),
        None                        : {},
    }
    printf("%v\n", Option::is_some(&o));
}
