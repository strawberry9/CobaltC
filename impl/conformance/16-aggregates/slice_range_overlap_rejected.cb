// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.slice [Slice-Form] (overlapping ranges); D-0070; conf.slice-range-overlap
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
//
// Two exclusive slices whose ranges meet (element 3 is in both) conflict
// when the second is formed; its end is `$`, so the check is dynamic.

import std;

fn main()
{
    array<i32, 6> a = [1, 2, 3, 4, 5, 6];
    slice<i32, exclusive> x = &mut a[0 .. 4];
    slice<i32, exclusive> y = &mut a[3 .. $];
    x[0] = y[0];
}
