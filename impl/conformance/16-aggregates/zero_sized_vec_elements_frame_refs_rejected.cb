// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.control.frame-references, spec/04 overlap (D-0217, CHG-0380); conf.zero-sized-vec-elements-frame-refs-rejected
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// Every element of a `Vec` of a zero-sized type is the one object
// anchored at its buffer (`conf.zero-sized-vec-elements-one-place`), so
// `&mut v[0]` and `&mut v[1]` held in frame bindings are two exclusive
// borrows of one place, and both are used.

import std;

struct Z {}

fn main()
{
    Vec<Z> v = Vec::new();
    Vec::push(&mut v, Z {});
    Vec::push(&mut v, Z {});
    ref<Z, exclusive> e0 = &mut v[0];
    ref<Z, exclusive> e1 = &mut v[1];
    *e0 = Z {};
    *e1 = Z {};
}
