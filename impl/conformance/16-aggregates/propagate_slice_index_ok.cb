// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: [Propagate] (D-0060) on a `Result`/`Option` of a slice; slices (D-0047)
// kind: positive
// expect: ok
// expect-stdout-hex: 6f6b0a
//
// `f()?` whose payload is a slice is a slice like any other: it is
// indexed at once (`need(b, 1, 2)?[1]`), looped over, and passed on.
// (coby once handed it on as an untyped value, which indexing refused.)

import std;

fn need(ref<Vec<u8>, shared> b, usize at, usize n) : Option<slice<u8, shared>>
{
    if (at + n > Vec::len(b))
    {
        return None;
    }
    Some(&b[at .. at + n])
}

fn second(ref<Vec<u8>, shared> b) : Option<u8>
{
    Some(need(b, 1, 2)?[1])
}

fn total(ref<Vec<u8>, shared> b) : Option<u32>
{
    u32 t = 0;
    foreach (x in need(b, 0, 3)?)
    {
        t += widen<u32>(*x);
    }
    Some(t + widen<u32>(read_le<u16>(need(b, 1, 2)?, 0)))
}

fn main()
{
    Vec<u8> v = Vec::from_fn(4, [](usize i) : u8 { narrow<u8>(i) + 1 });   // 1 2 3 4
    assert(Option::unwrap_or(second(&v), 0) == 3);
    assert(Option::unwrap_or(total(&v), 0) == 6 + 770);               // 2 | 3 << 8
    Vec<u8> short = Vec::filled(1, 0: u8);
    assert(Option::is_none(&second(&short)));
    printf("ok\n");
}
