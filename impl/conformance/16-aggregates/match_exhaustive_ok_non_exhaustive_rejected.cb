// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match-Non-Exhaustive]
// kind: negative
// expect: diag.non-exhaustive-match (static)
//
// A match over an enum must cover every variant or supply a wildcard;
// missing a variant with no `_` arm is rejected when that variant is
// actually the one reached.

import std;

fn main()
{
    Option<i32> o = None;
    match (o)
    {
        Some(x) : {},
    }
}
