// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.slice [Slice-Form]; rule.agg.index through a slice; rule.fn.generic-call
// kind: positive
// expect: ok
//
// A generic function indexing a `slice<T, …>` of a `Vec`'s elements, and
// sorting it through a `fn` value: the element is reached as the `Vec`'s
// own element type. coby once used the slice's written type there (`T`,
// unsubstituted) and read the wrong cells (wrong values, or a
// diag.type-mismatch).

import std;

fn sort_by<T>(slice<T, exclusive> s, fn(ref<T, shared>, ref<T, shared>) : bool before)
{
    for (usize i = 1; i < slice_len(s); i += 1)
    {
        usize j = i;
        while (j > 0 && before(&s[j], &s[j - 1]))
        {
            slice_swap(s, j, j - 1);
            j -= 1;
        }
    }
}

fn sum_with<T>(slice<T, shared> s, fn(ref<T, shared>) : f64 f) : f64
{
    f64 acc = 0.0;
    foreach (x in s)
    {
        acc = acc + f(x);
    }
    acc
}

fn shorter(ref<String, shared> a, ref<String, shared> b) : bool { String::len(a) < String::len(b) }
fn sq(ref<f64, shared> x) : f64 { *x * *x }

fn main()
{
    Vec<String> w = Vec::new();
    Vec::push(&mut w, String::from_str("ccc"));
    Vec::push(&mut w, String::from_str("a"));
    Vec::push(&mut w, String::from_str("bb"));
    sort_by(&mut w[0..$], shorter);
    Vec<f64> v = Vec::new();
    Vec::push(&mut v, 0.5);
    Vec::push(&mut v, 1.5);
    if (String::len(&w[0]) != 1 || String::len(&w[2]) != 3 || sum_with(&v[0..$], sq) != 2.5)
    {
        fault(index_out_of_bounds);
    }
}
