// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match-Unreachable] (literals); D-0057; conf.match-literal-duplicate
// kind: negative
// expect: diag.unreachable-arm (static)
//
// The second `3` arm can never be taken.

import std;

fn main()
{
    u8 op = 3;
    i32 v = match (op)
    {
        3 : 1,
        4 : 2,
        3 : 3,
        _ : 0,
    };
}
