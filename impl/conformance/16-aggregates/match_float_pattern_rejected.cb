// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match (no float patterns); D-0057
// kind: negative
// expect: parse-error
//
// A float cannot be a pattern (equality on floats misleads: NaN, -0.0).

import std;

fn main()
{
    f64 f = 1.0;
    i32 v = match (f)
    {
        1.0 : 1,
        _ : 0,
    };
}
