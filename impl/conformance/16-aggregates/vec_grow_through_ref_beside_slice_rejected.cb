// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.slice [Slice-Form] (what reaches the whole source meets every slice of it, D-0070); rule.stdlib.vec; conf.vec-grow-through-ref-beside-slice
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `sl` borrows element 0 through `r`; `Vec::reserve` is given `r` itself
// (no new borrow), and its body writes the vector's own fields and may
// move the buffer `sl` views. A `Vec`'s fields reach its whole storage, so
// they meet the live slice: the call faults. Before CHG-0262 cobc's runtime
// let the fields pass beside a range, and `sl[0]` read the freed buffer.
//
// D-0282: the static pass rejects this program before it runs (it was found
// at run time before): `Vec::reserve` writes `*r` through argument 1 while
// `sl` still borrows `(*r)[0 .. 1]`.
import std;

fn main()
{
    Vec<i32> v = Vec::new();
    Vec::push(&mut v, 1);
    Vec::push(&mut v, 2);
    auto r = &mut v;
    slice<i32, exclusive> sl = &mut (*r)[0 .. 1];
    Vec::reserve(r, 100);
    printf("%v\n", sl[0]);
}
