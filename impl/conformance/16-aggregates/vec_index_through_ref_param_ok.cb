// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.index-vec (`v[i]` through a reference parameter)
// kind: positive
// expect: ok
//
// `t[i]` and `v[i] = …` where `t`/`v` is a `ref<Vec<…>>` parameter, the
// argument a local `Vec` that never escapes. `cobc` compiles such a call
// with the parameter confined (no binding object), and indexing it was
// an internal error ("unresolved path"); found by real-world testing.

import std;

fn checksum(ref<Vec<u32>, shared> t, ref<Vec<u8>, shared> b) : u32
{
    u32 c = 0;
    foreach (x in b)
    {
        c = t[widen<usize>(*x)] ^ (c << 1);
    }
    c
}

fn second(ref<Vec<u32>, shared> t) : u32
{
    t[1]
}

fn bump(ref<Vec<u32>, exclusive> v, usize i)
{
    v[i] = v[i] + 10;
    v[0] += 1;
}

fn main()
{
    Vec<u32> t = Vec::new();
    Vec::push(&mut t, 5);
    Vec::push(&mut t, 6);
    Vec<u8> b = Vec::new();
    Vec::push(&mut b, 1);
    Vec::push(&mut b, 0);
    if (checksum(&t, &b) != 9 || second(&t) != 6)
    {
        1 / (1 - 1);
    }
    bump(&mut t, 1);
    if (t[0] != 6 || t[1] != 16)
    {
        1 / (1 - 1);
    }
}
