// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.stdlib.vec (`Vec::index_exclusive` takes element i exclusively through its reference, D-0222, CHG-0261); conf.vec-index-exclusive-while-container-shared
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// `s` is a shared reborrow of `r`; `set` is given `r` itself and writes
// element 0 by an explicit `Vec::index_exclusive(v, 0)`. Its body reads
// the vector through `v` (a shared access, permitted beside `s`), so
// before D-0222 the element changed under `s` with no rule broken (D-0219
// finding 9). The body now accesses element i exclusively through `v`
// (`_ = &mut (*v)[i .. i + 1];`), which meets `s`: the call faults, as
// `(*v)[0] = x` always did.
//
// D-0282: the static pass rejects this program before it runs (it was found
// at run time before): `set` writes `*r` through argument 1 while `s` still
// borrows `*r`.

import std;

fn set(ref<Vec<i32>, exclusive> v, i32 x)
{
    *Vec::index_exclusive(v, 0) = x;
}

fn main()
{
    Vec<i32> w = Vec::new();
    Vec::push(&mut w, 1);
    auto r = &mut w;
    auto s = &*r;
    set(r, 9);
    printf("%v\n", Vec::len(s));
}
