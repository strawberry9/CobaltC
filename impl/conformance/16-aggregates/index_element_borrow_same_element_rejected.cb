// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.index-vec [Index-Vec]; D-0070; conf.index-borrow-whole-element
// kind: negative
// expect: diag.aliasing-conflict (dynamic)
// expect-stdout-hex: 6f7468657220320a
//
// `e[k]`'s borrow is checked as an access to element k: with an exclusive
// reference into element 1 live, reaching element 0 is fine (other
// elements do not conflict) and reaching element 1 is not, even for a
// different field of it.

import std;

struct Pt
{
    i32 x;
    i32 y;
}

fn main()
{
    Vec<Pt> p = Vec::new();
    Vec::push(&mut p, Pt { .x = 1, .y = 2 });
    Vec::push(&mut p, Pt { .x = 3, .y = 4 });
    {
        ref<i32, exclusive> t = &mut p[narrow<usize>(1)].x;
        i32 b = p[0].y;
        *t = b;
    }
    printf("other %v\n", p[1].x);
    {
        ref<i32, exclusive> t = &mut p[narrow<usize>(1)].y;
        i32 a = p[1].x;
        *t = a;
    }
    printf("same %v\n", p[1].y);
}
