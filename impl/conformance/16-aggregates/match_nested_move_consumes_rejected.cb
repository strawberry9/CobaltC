// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match] (a nested resource binder consumes the scrutinee); D-0056; conf.match-nested-move-consumes
// kind: negative
// expect: diag.stale-binding (static)
//
// The arm that binds the `String` two levels down moves it out and
// consumes `o`; reading `o` afterwards is stale. The `_` arm consumes
// nothing, so after the `match` `o` may have been moved, and the read is
// refuted (D-0087), as a read that may be uninitialized is (spec/11).

import std;

fn main()
{
    Option<Option<String>> o = Some(Some(String::from_str("x")));
    match (o)
    {
        Some(Some(s)) :
        {
            printf("%s\n", &s);
        },
        _             :
        {
        },
    }
    match (o)
    {
        None :
        {
        },
        _    :
        {
        },
    }
}
