// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.layout [Type-Recursion-Expanding]; conf.type-recursion-same-argument
// kind: positive
// expect: ok
//
// Recursion through another generic type at the same argument (`List<T>`
// holds a `Pair<T>`, which holds a `List<T>`) and at a fixed one
// (`Tree<T>` holds a `Tree<u8>`) needs finitely many types: accepted, and
// their derived `clone`s copy them.

import std;

struct Pair<T>
{
    T head;
    List<T> rest;
}

enum List<T>
{
    Nil,
    Cons(Box<Pair<T>>),
}

enum Tree<T>
{
    Leaf(T),
    Tag(Box<Tree<u8>>),
}

fn len<T>(ref<List<T>, shared> l) : u32
{
    match (l)
    {
        Nil     : 0,
        Cons(p) : 1 + len(&Box::get(p).rest),
    }
}

fn main() : u8
{
    List<i32> l = List::Cons(Box::new(Pair { .head = 1, .rest = List::Cons(Box::new(Pair { .head = 2, .rest = List::Nil })) }));
    List<i32> c = clone(&l);
    Tree<bool> t = Tree::Tag(Box::new(Tree::Leaf(7: u8)));
    Tree<bool> u = clone(&t);
    u8 tag = match (&u)
    {
        Tag(b) : match (Box::get(b))
        {
            Leaf(v) : *v,
            _       : 0,
        },
        _ : 0,
    };
    printf("%v %v %v\n", len(&l), len(&c), tag);
    0
}
