// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: conf.zero-sized-types; [Sizeof-Struct], [Sizeof-Array], [Layout-Struct], rule.stdlib.vec (D-0208, CHG-0246)
// kind: positive
// expect: ok
// expect-stdout-hex: 3020312033203020300a
//
// A struct with no fields and an array of length 0 occupy no bytes and
// are otherwise ordinary: the struct is aligned to 1, a Vec of it
// counts its elements, a reference to one can be formed and copied
// through, and an array of two of them is also empty.

import std;

struct Z {}

fn main()
{
    Z z = Z {};
    ref<Z, shared> r = &z;
    Vec<Z> v = Vec::new();
    Vec::push(&mut v, Z {});
    Vec::push(&mut v, Z {});
    Vec::push(&mut v, *r);
    array<Z, 2> a = [Z {}, Z {}];
    array<i32, 0> e = [];
    printf("%v %v %v %v %v\n", sizeof<Z>(), alignof<Z>(), Vec::len(&v), sizeof<array<Z, 2>>(), sizeof<array<i32, 0>>());
}
