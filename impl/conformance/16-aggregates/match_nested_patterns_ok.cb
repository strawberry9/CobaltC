// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match] [Match-By-Ref] (nested patterns); D-0056; conf.match-nested
// kind: positive
// expect: ok
// expect-stdout-hex: 332e3020342e3020302e30202d312e300a392032203120300a736f6d65206e6f6e650a6d6f7665640a34320a313a20616c7068610a323a20626574610a
// args: $TMP
//
// Nested patterns: arms tried in order, `_` and binders at any depth,
// unit variants inside a pattern (plain and qualified), three levels,
// a resource moved out from two levels down a binding, a match that moves
// nothing leaving its scrutinee usable, `&mut` changing a nested payload,
// and `File::read_line`'s `Result<Option<String>, FileError>` in one match.

import std;

enum Shape
{
    Circle(f64),
    Square(f64),
    Dot,
}

fn area(Option<Shape> s) : f64
{
    match (s)
    {
        Some(Circle(r)) : 3.0 * r * r,
        Some(Square(w)) : w * w,
        Some(Shape::Dot) : 0.0,
        None : -1.0,
    }
}

fn depth(Option<Option<Option<i32>>> o) : i32
{
    match (o)
    {
        Some(Some(Some(v))) : v,
        Some(Some(None)) : 2,
        Some(_) : 1,
        None : 0,
    }
}

fn main()
{
    printf("%v %v %v %v\n", area(Some(Circle(1.0))), area(Some(Square(2.0))), area(Some(Dot)), area(None));
    printf("%v %v %v %v\n", depth(Some(Some(Some(9)))), depth(Some(Some(None))), depth(Some(None)), depth(None));

    Option<Option<String>> keep = Some(None);
    match (keep)
    {
        Some(Some(_)) :
        {
            printf("some some\n");
        },
        Some(None) :
        {
            printf("some none\n");
        },
        None :
        {
            printf("none\n");
        },
    }
    keep = Some(Some(String::from_str("moved")));
    match (keep)
    {
        Some(Some(s)) :
        {
            printf("%s\n", &s);
        },
        _ :
        {
            printf("?\n");
        },
    }

    Result<Option<i32>, i32> r = Ok(Some(1));
    match (&mut r)
    {
        Ok(Some(x)) :
        {
            *x = *x + 41;
        },
        _ :
        {
        },
    }
    match (&r)
    {
        Ok(Some(x)) :
        {
            printf("%v\n", *x);
        },
        Ok(None) :
        {
        },
        Err(_) :
        {
        },
    }

    String dir = Result::unwrap_or(arg(0), String::new());
    String path = String::new();
    String::append(&mut path, &dir);
    String::append(&mut path, "/lines.txt");
    String text = String::from_str("alpha\nbeta\n");
    Result::unwrap_or(write_file(&path, &text), ());
    File f = match (File::open(&path))
    {
        Ok(f) : f,
        Err(_) : fault(assertion_failed),
    };
    usize n = 0;
    while (true)
    {
        match (File::read_line(&mut f))
        {
            Ok(Some(line)) :
            {
                n = n + 1;
                printf("%v: %s\n", n, &line);
            },
            Ok(None) :
            {
                break;
            },
            Err(Utf8(_)) :
            {
                printf("not text\n");
            },
            Err(_) :
            {
                break;
            },
        }
    }
}
