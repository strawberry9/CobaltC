// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.slice [Slice-Form]; rule.control.flow-analysis (a literal range); D-0070; conf.slice-range-literal-conflict
// kind: negative
// expect: diag.aliasing-conflict (static)
//
// A write to an element inside a live exclusive slice's literal range is
// rejected before the program runs; element 4, outside it, would not be.

import std;

fn main()
{
    array<i32, 6> a = [1, 2, 3, 4, 5, 6];
    slice<i32, exclusive> x = &mut a[0 .. 3];
    a[4] = 9;
    a[1] = 9;
    x[0] = 1;
}
