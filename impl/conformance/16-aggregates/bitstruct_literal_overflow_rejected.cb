// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: type.bitstruct `[Bitfield-Overflow]` (D-0118), static for a literal; conf.bitstruct-literal-overflow-rejected
// kind: negative
// expect: diag.narrowing-overflow (static)

import std;

bitstruct B : u8 { lo : 4; hi : 4; }

fn main()
{
    B b = B { .lo = 16, .hi = 0 };
}
