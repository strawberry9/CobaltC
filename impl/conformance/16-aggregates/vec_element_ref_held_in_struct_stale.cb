// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.index [Index-Vec]; [Reclaim]; [Read-Stale]
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// A reference to a `Vec`'s element, `&v[0]`, held in a struct where the
// static analysis does not follow it: the element is its own object (as
// through `Vec::index_shared`), so pushing onto `v` is admitted, the
// reallocation ends the element, and the later read is stale. cobc once
// borrowed the whole `Vec` for `v[i]` and reported diag.aliasing-conflict
// at the push instead.

import std;

struct H
{
    ref<i64, shared> r;
}

fn main()
{
    Vec<i64> v = Vec::new();
    Vec::push(&mut v, 1);
    H h = H { .r = &v[0] };
    for (i32 i = 0; i < 10; i += 1)
    {
        Vec::push(&mut v, 2);
    }
    printf("%v\n", *h.r);
}
