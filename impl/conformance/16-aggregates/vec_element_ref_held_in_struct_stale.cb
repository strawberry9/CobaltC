// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.index [Index-Vec]; [Reclaim]; [Read-Stale]; conf.vec-element-ref-held-in-struct-stale
// kind: negative
// expect: diag.stale-binding (dynamic)
//
// A reference to a `Vec`'s element, `&v[0]`, held in a struct a call made,
// which the frame holds only as `?`: the element is its own object (as
// through `Vec::index_shared`), so pushing onto `v` is admitted, the
// reallocation ends the element, and the later read is stale. cobc once
// borrowed the whole `Vec` for `v[i]` and reported diag.aliasing-conflict
// at the push instead.
//
// D-0290: the reference is stored by a call (`hold`), so the frame holds it
// only as `?` (it may hold none of it), and the run checks the access; the
// same program storing it directly is refuted before the run.

import std;

struct H
{
    ref<i64, shared> r;
}

fn hold(ref<i64, shared> r) : H
{
    H { .r = r }
}

fn main()
{
    Vec<i64> v = Vec::new();
    Vec::push(&mut v, 1);
    H h = hold(&v[0]);
    for (i32 i = 0; i < 10; i += 1)
    {
        Vec::push(&mut v, 2);
    }
    printf("%v\n", *h.r);
}
