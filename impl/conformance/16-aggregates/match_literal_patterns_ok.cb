// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match [Match] (literal patterns); D-0057; conf.match-literals
// kind: positive
// expect: ok
// expect-stdout-hex: 6c6f61642073746f7265206a756d70203f0a302031203220390a2d31203020312039390a3120300a302031202d35202d310a3220312030202d310a31203020320a3120320a34300a330a320a313120323020392031300a
//
// Literal patterns: integers (hex, negative, `u128`'s largest, `i128`'s
// smallest), bytes, `true`/`false`, at the top level (a `match` on an
// integer or `bool`, the scrutinee a computed value too) and inside
// variant patterns (`Ok(0)`, `Err(-5)`, `Some(Some(true))`), through a
// reference, with arms that `break`, `continue` and `return`. An arm
// body may begin with a name right after an integer or byte literal
// (`1 : acc + 1`), and a literal may carry its type (`3: u8 : …`).

import std;

fn op_name(u8 op) : str
{
    match (op)
    {
        1 : "load",
        2 : "store",
        0x10 : "jump",
        _ : "?",
    }
}

fn class(u8 b) : i32
{
    match (b)
    {
        b' ' : 0,
        b'\n' : 1,
        b'(' : 2,
        _ : 9,
    }
}

fn sign(i64 x) : i32
{
    match (x)
    {
        -1 : -1,
        0 : 0,
        1 : 1,
        _ : 99,
    }
}

fn flag(bool b) : i32
{
    match (b)
    {
        true : 1,
        false : 0,
    }
}

fn eof(Result<usize, i32> r) : i32
{
    match (r)
    {
        Ok(0) : 0,
        Ok(_) : 1,
        Err(-5) : -5,
        Err(_) : -1,
    }
}

fn nested(Option<Option<bool>> o) : i32
{
    match (o)
    {
        Some(Some(true)) : 2,
        Some(Some(false)) : 1,
        Some(None) : 0,
        None : -1,
    }
}

fn big(u128 v) : i32
{
    match (v)
    {
        340282366920938463463374607431768211455 : 1,
        0 : 0,
        _ : 2,
    }
}

fn small(i128 v) : i32
{
    match (v)
    {
        -170141183460469231731687303715884105728 : 1,
        _ : 2,
    }
}


// A byte tokenizer: `continue` and `break` from arms, a count per class.
fn tokens(str text) : i32
{
    i32 words = 0;
    bool inside = false;
    usize i = 0;
    while (true)
    {
        if (i == str_len(text))
        {
            break;
        }
        u8 b = str_byte(text, i);
        i += 1;
        match (b)
        {
            b' ' :
            {
                inside = false;
                continue;
            },
            b'.' :
            {
                break;
            },
            _ :
            {
            },
        }
        if (!inside)
        {
            words += 1;
            inside = true;
        }
    }
    words
}

// A literal inside a match through a reference; `return` from an arm.
fn first_zero(ref<Vec<Option<i32>>, shared> v) : i32
{
    usize i = 0;
    while (i < Vec::len(v))
    {
        match (&v[i])
        {
            Some(0) :
            {
                return narrow<i32>(i);
            },
            _ :
            {
            },
        }
        i += 1;
    }
    -1
}

fn bump(u8 op, i64 acc) : i64
{
    match (op)
    {
        1 : acc + 1,
        b'a' : acc * 2,
        3: u8 : acc - 1,
        _ : acc,
    }
}

fn main()
{
    printf("%s %s %s %s\n", op_name(1), op_name(2), op_name(16), op_name(3));
    printf("%v %v %v %v\n", class(b' '), class(b'\n'), class(b'('), class(b'x'));
    printf("%v %v %v %v\n", sign(-1), sign(0), sign(1), sign(7));
    printf("%v %v\n", flag(true), flag(false));
    printf("%v %v %v %v\n", eof(Ok(0)), eof(Ok(3)), eof(Err(-5)), eof(Err(2)));
    printf("%v %v %v %v\n", nested(Some(Some(true))), nested(Some(Some(false))), nested(Some(None)), nested(None));
    printf("%v %v %v\n", big(max_value<u128>()), big(0), big(5));
    printf("%v %v\n", small(min_value<i128>()), small(0));
    u32 n = 3;
    i32 k = match (n + 1)
    {
        4 : 40,
        _ : 0,
    };
    printf("%v\n", k);
    printf("%v\n", tokens("one two  three. four"));
    Vec<Option<i32>> v = Vec::new();
    Vec::push(&mut v, Some(4));
    Vec::push(&mut v, None);
    Vec::push(&mut v, Some(0));
    printf("%v\n", first_zero(&v));
    printf("%v %v %v %v\n", bump(1, 10), bump(b'a', 10), bump(3, 10), bump(9, 10));
}
