// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: conf.zero-sized-addresses; spec/05 [Object-Establish-Plain] anchor, spec/04 overlap, spec/20 [Rawptr-Of] [Rawptr-Offset] (D-0217, CHG-0255)
// kind: positive
// expect: ok
// expect-stdout-hex: 66616c73652074727565207472756520300a330a
//
// Zero-sized objects have addresses: an anchor each, distinct for two live
// objects, so `rawptr_of` of two `Z` locals differ. A pointer step over a
// zero-sized type does not move (`p + 1 == p`), and the elements of an
// array of them share their array's address. Two exclusive borrows of two
// elements of such an array coexist -- different places of one object,
// neither a part of the other -- though they reach no bytes. A `Vec<Z>`
// pushes and pops as any vector does.

import std;

struct Z {}

fn main()
{
    Z z1 = Z {};
    Z z2 = Z {};
    array<Z, 3> zs = [Z {}, Z {}, Z {}];
    unsafe
    {
        rawptr<Z> p1 = rawptr_of(&z1);
        rawptr<Z> p2 = rawptr_of(&z2);
        rawptr<Z> pa = rawptr_of(&zs[0]);
        rawptr<Z> pb = rawptr_of(&zs[1]);
        printf("%v %v %v %v\n", p1 == p2, p1 + 1 == p1, pa == pb, sizeof<Z>());
    }
    ref<Z, exclusive> a = &mut zs[0];
    ref<Z, exclusive> b = &mut zs[1];
    *a = Z {};
    *b = Z {};
    Vec<Z> v = Vec::new();
    foreach (i in 0..3)
    {
        Vec::push(&mut v, Z {});
    }
    usize n = 0;
    while (Vec::len(&v) > 0)
    {
        _ = Vec::pop(&mut v);
        n = n + 1;
    }
    printf("%v\n", n);
}
