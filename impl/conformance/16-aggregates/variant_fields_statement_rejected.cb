// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.enum a variant with named fields (D-0324): not taken apart by a statement; conf.variant-fields-statement-refused
// kind: negative
// expect: diag.type-mismatch (static)
//
// `Shape::Rect { w, h } = s;` would take apart a value that may be another
// variant; a variant is matched, `match` or `if (Shape::Rect { w, h } = s)`.
import std;

enum Shape
{
    Rect { u32 w; u32 h; },
    Dot,
}

fn main()
{
    Shape s = Shape::Dot;
    Shape::Rect { w, h } = s;
    printf("%v %v\n", w, h);
}
