// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match struct patterns through a reference (D-0324 [Struct-Pattern-By-Ref]); conf.struct-pattern-through-ref, conf.struct-pattern-through-exclusive-ref
// kind: positive
// expect: ok
//
// A struct pattern reached through a reference binds each name to a
// reference to its field, in the mode the value is reached: `match (&o)`
// gives shared references, `match (&mut o)` exclusive ones, through which
// the arm changes the fields in place. `..` binds nothing; nothing is
// moved out, so the struct is still whole after the match.
import std;

struct Question
{
    String name;
    u32 end;
    u32 asked;
}

fn main()
{
    Option<Question> o = Some(Question { .name = "who", .end = 3, .asked = 0 });
    match (&o)
    {
        Some(Question { name, end, .. }) :
        {
            assert(*end == 3);
            assert(*name == "who");
        },
        None                             : {},
    }
    match (&mut o)
    {
        Some(Question { name, asked: count, .. }) :
        {
            *count += 1;
            String::append(name, "?");
        },
        None                                      : {},
    }
    if (Some(Question { name, asked, .. }) = &o)
    {
        printf("%s %v\n", name, *asked);
    }
}
