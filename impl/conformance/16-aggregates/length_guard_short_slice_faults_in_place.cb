// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.index [Index-Checked], [Slice-Index]; D-0320; conf.length-guard-short-slice
// kind: negative
// expect: diag.index-out-of-bounds (dynamic)
// expect-stdout-hex: 726f7720310a726f7720320a726f7720330a
//
// The loop of `conf.length-guard-long-slices` given a `dst` one element too
// short: the length test before the loop fails, and the loop runs as it is
// written, printing each row it finishes, until the first index out of
// range faults, at that access. A guard that only picks between two copies
// of the loop, each with every check, changes nothing a program does.

import std;

const usize W = 8;
const usize H = 6;

fn blur(slice<u32, shared> src, slice<u32, exclusive> dst)
{
    for (usize y = 1; y < H - 1; y += 1)
    {
        foreach (x in 1..W - 1)
        {
            usize i = y * W + x;
            dst[i] = (src[i - W] + src[i - 1] + src[i] + src[i + 1] + src[i + W]) / 5;
        }
        printf("row %v\n", y);
    }
}

fn main()
{
    Vec<u32> a = Vec::filled(W * H, 10);
    Vec<u32> b = Vec::filled(4 * W + 6, 0);
    blur(&a, &mut b);
    printf("not reached\n");
}
