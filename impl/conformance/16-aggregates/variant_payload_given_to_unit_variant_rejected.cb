// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.type.typing [T-Enum]; rule.agg.enum-construct
// kind: negative
// expect: diag.type-mismatch (static)
//
// A payload-less variant is written bare; given an argument, the
// argument is a payload of the wrong type.

enum Colour
{
    Red,
    Green,
}

fn main()
{
    auto c = Colour::Red(3);
}
