// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match (a pattern into a type parameter); D-0056; conf.match-nested-generic-payload
// kind: negative
// expect: diag.type-mismatch (static)
//
// A pattern descends only into a payload whose type is an enum: `T` is
// a type parameter, whatever a call instantiates it with.

import std;

fn f<T>(Option<T> o) : i32
{
    match (o)
    {
        Some(Some(_)) : 1,
        _ : 0,
    }
}

fn main()
{
    i32 x = f(Some(Some(1)));
}
