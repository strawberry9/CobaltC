// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.agg.match (a constant as a literal pattern); D-0058; conf.match-const
// kind: positive
// expect: ok
// expect-stdout-hex: 7075736820616464206a756d70206e6f702068616c74203f0a31203220330a300a6f7468657220330a
//
// A `const` of integer or `bool` type in a pattern is its value:
// plain, computed (`BASE + 1`), negative, `bool`, a module's (`ops::NOP`),
// three levels down; `ON` with `false` covers a `bool`.

import std;
const u8 PUSH = 0x01;
const u8 ADD = 0x02;
const u8 HALT = 0xFF;
const i32 LOW = -5;
const bool ON = true;
const u8 BASE = 0x10;
const u8 JUMP = BASE + 1;
module ops
{
    export const u8 NOP = 0x90;
}
fn name(u8 op) : str
{
    match (op)
    {
        PUSH     : "push",
        ADD      : "add",
        JUMP     : "jump",
        ops::NOP : "nop",
        HALT     : "halt",
        _        : "?",
    }
}
fn level(Option<i32> o) : i32
{
    match (o)
    {
        Some(LOW) : 1,
        Some(_)   : 2,
        None      : 3,
    }
}
fn main()
{
    printf("%s %s %s %s %s %s\n", name(1), name(2), name(0x11), name(0x90), name(255), name(7));
    printf("%v %v %v\n", level(Some(-5)), level(Some(5)), level(None));
    bool b = false;
    printf("%v\n", match (b)
    {
        ON    : 1,
        false : 0,
    });
    Option<Option<Option<u8>>> r = Some(Some(Some(3)));
    match (r)
    {
        Some(Some(Some(PUSH))) : printf("push inside\n"),
        Some(Some(Some(k)))    : printf("other %v\n", k),
        _                      : printf("-\n"),
    }
}
