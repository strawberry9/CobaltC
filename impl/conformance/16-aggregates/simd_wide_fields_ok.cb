// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: type.simd; rule.agg.layout [Layout-Simd]; D-0254; CHG-0441; conf.simd-wide-fields
// kind: positive
// expect: ok
// expect-stdout-hex: 3320350a3132382036342036342033320a31360a
//
// Struct fields of 32- and 64-byte vectors: each is aligned to its own
// size whatever the target's vector registers (cobc's C failed its
// layout assertion under GCC without AVX / AVX-512), passed by value,
// and kept in a `Vec`.

import std;

struct Wide
{
    simd<u64, 8> a;
    simd<u64, 8> b;
}

struct Bytes
{
    u8 tag;
    simd<u8, 32> v;
}

fn total(Wide w) : u64
{
    w.a[0] + w.b[7]
}

fn main()
{
    Wide w = Wide { .a = [1; 8], .b = [2; 8] };
    Bytes b = Bytes { .tag = 1, .v = [5; 32] };
    printf("%v %v\n", total(w), b.v[31]);
    printf("%v %v %v %v\n", sizeof<Wide>(), alignof<Wide>(), sizeof<Bytes>(), alignof<Bytes>());
    Vec<Wide> v = Vec::new();
    foreach (j in 0..4)
    {
        Vec::push(&mut v, Wide { .a = [widen<u64>(j); 8], .b = [widen<u64>(j) + 1; 8] });
    }
    u64 s = 0;
    foreach (x in &v)
    {
        s += (x.a + x.b)[3];
    }
    printf("%v\n", s);
}
