// CONFORMANCE-CASE
// spec: 16-aggregates
// facility: rule.aggregate.array [Array-Construct] (D-0037); rule.arith.literal; conf.array-literal-rows-take-the-first-type
// kind: positive
// expect: ok
// expect-stdout-hex: 3838323137343038303239343731373034373920323320383431363138333537363032313538373438310a
//
// An array literal's elements have one type: with none declared, the first
// element's type is the rest's, a row of a nested literal included, so a
// later row's literals are of the first row's element type and a value that
// fits it is not out of range. `coby` evaluated the later rows' literals as
// `i32` before CHG-0416 and faulted where `cobc` ran.

import std;

fn main()
{
    auto rows = [[20: usize, 1], [3, 0x7a6d1e854c3c40af]];
    u64 total = 0;
    foreach (c in [[2: u64, 10], [5, 0x74cc4a5f1d3e560f]])
    {
        total += c[1];
    }
    printf("%v %v %v\n", rows[1][1], rows[0][0] + rows[1][0], total);
}
