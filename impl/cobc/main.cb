// `text` to the file `out`, or to standard output where there is none.
fn write_out(ref<Option<String>, shared> out, ref<String, shared> text) : u8
{
    match (out)
    {
        Some(o) :
        {
            match (write_file(o, text))
            {
                Ok(_)  : 0,
                Err(e) :
                {
                    eprintf("cobc: cannot write %s: %s\n", o, FileError::text(&e));
                    1
                },
            }
        },
        None    :
        {
            printf("%s", text);
            0
        },
    }
}

fn usage() : u8
{
    eprintf(
        "usage: cobc --emit-c [--c-name NAME] [-o OUT] FILE\n       cobc --emit-cir=core [-o OUT] FILE\n       cobc --emit-cir=proto [-o OUT] FILE\n       cobc --from-cir [--c-name NAME] [-o OUT] FILE.cir\n"
    );
    2
}

fn main() : u8
{
    // Anything but `--emit-c` first (after `--certificate FILE`, D-0299) is
    // the driver's command line (`driver.cb`).
    bool emit = false;
    bool certified = false;
    if (arg_count() > 0)
    {
        match (arg(0))
        {
            Ok(a)  : emit = a == "--emit-c" || a == "--emit-cir=core" || a == "--emit-cir=proto" || a == "--from-cir",
            Err(_) : {},
        }
    }
    if (!emit && arg_count() > 2)
    {
        match (arg(0))
        {
            Ok(a)  :
            {
                if (a == "--certificate")
                {
                    match (arg(2))
                    {
                        Ok(b)  :
                        {
                            emit = b == "--emit-c";
                            certified = emit;
                        },
                        Err(_) : {},
                    }
                }
            },
            Err(_) : {},
        }
    }
    if (!emit)
    {
        return driver_main();
    }
    Vec<String> args = Vec::new();
    for (usize i = 0; i < arg_count(); i += 1)
    {
        match (arg(i))
        {
            Ok(a)  : Vec::push(&mut args, a),
            Err(_) : return usage(),
        }
    }
    Option<String> certificate = None;
    if (certified)
    {
        String p = String::clone(&args[1]);
        match (cert_begin(&p))
        {
            Ok(_)  : {},
            Err(e) :
            {
                eprintf("cobc: %s\n", &e);
                return 2;
            },
        }
        certificate = Some(p);
        _ = Vec::remove(&mut args, 0);
        _ = Vec::remove(&mut args, 0);
    }
    // `--emit-cir=core [-o OUT] FILE` takes the same words: core CIR as text
    // in place of the C (`gen::emit_core`).
    // `--emit-cir=proto` writes protocol CIR, the lowered program as the
    // emitter takes it (`pdump::proto_text`); `--from-cir FILE.cir` prints
    // the C of one (`pdump::proto_read`, `gen::combined`).
    bool core = Vec::len(&args) > 0 && args[0] == "--emit-cir=core";
    bool proto_out = Vec::len(&args) > 0 && args[0] == "--emit-cir=proto";
    bool from_cir = Vec::len(&args) > 0 && args[0] == "--from-cir";
    if (Vec::len(&args) < 2 || (args[0] != "--emit-c" && !core && !proto_out && !from_cir))
    {
        return usage();
    }
    // `--emit-c [--c-name NAME] [-o OUT] FILE`, in any order, each once.
    Option<String> name = None;
    Option<String> to = None;
    Option<String> file_arg = None;
    usize i = 1;
    while (i < Vec::len(&args))
    {
        ref<String, shared> a = &args[i];
        if (*a == "--c-name" && Option::is_none(&name) && i + 1 < Vec::len(&args))
        {
            name = Some(String::clone(&args[i + 1]));
            i += 2;
        }
        else if (*a == "-o" && Option::is_none(&to) && i + 1 < Vec::len(&args))
        {
            to = Some(String::clone(&args[i + 1]));
            i += 2;
        }
        else if (Option::is_none(&file_arg) && !StringView::starts_with(a, "-"))
        {
            file_arg = Some(String::clone(a));
            i += 1;
        }
        else
        {
            file_arg = None;
            break;
        }
    }
    String file_s = match (file_arg)
    {
        Some(f) : f,
        None    : return usage(),
    };
    Option<String> out = match (to)
    {
        Some(o) : if (o == "-") { None } else { Some(o) },
        None    : None,
    };
    String c_name = match (name)
    {
        Some(n) : n,
        None : match (&out)
        {
            Some(o) : String::clone(o),
            None    : "a.c",
        },
    };
    StringView file = &file_s;
    String src = match (read_file(file))
    {
        Ok(s)  : s,
        Err(e) :
        {
            eprintf("cobc: %v: cannot read: %s\n", file, FileError::text(&e));
            return 2;
        },
    };
    if (from_cir)
    {
        Generated read = match (proto_read(&src))
        {
            Ok(g)  : g,
            Err(e) :
            {
                eprintf("cobc: %v: %s\n", file, &e);
                return 2;
            },
        };
        String c = combined(&read, &c_name);
        return write_out(&out, &c);
    }
    match (&certificate)
    {
        Some(_) :
        {
            match (cert_raw_start())
            {
                Ok(_)  : {},
                Err(e) :
                {
                    eprintf("cobc: %s\n", &e);
                    return 2;
                },
            }
        },
        None    : {},
    }
    match (check_text_certified(&src, file, cert_raw_of(&certificate)))
    {
        Ok(prog) :
        {
            // Report 138: no output of cobc replaces one of the program's
            // own files.
            match (&out)
            {
                Some(o) :
                {
                    match (emit_output_problem(o, file, &prog.ex, &prog.table.extern_code))
                    {
                        Some(why) :
                        {
                            eprintf("cobc: cannot write the C to %s: %s\n", o, &why);
                            return 2;
                        },
                        None      : {},
                    }
                },
                None    : {},
            }
            // D-0257: a library has no `main`; its C is `--lib`'s to write
            // (the driver's message).
            if (!HashMap::contains(&prog.table.fns, &String::copy("main")))
            {
                eprintf(
                    "cobc: %v is a library (it defines functions C calls and no `main`): build it with `cobc --lib -o lib%s.a %v`\n",
                    file,
                    &stem_of(file),
                    file,
                );
                return 2;
            }
            if (core)
            {
                String text = emit_core(prog, false);
                match (&out)
                {
                    Some(o) :
                    {
                        match (write_file(o, &text))
                        {
                            Ok(_)  : return 0,
                            Err(e) :
                            {
                                eprintf("cobc: cannot write %s: %s\n", o, FileError::text(&e));
                                return 1;
                            },
                        }
                    },
                    None    :
                    {
                        printf("%s", &text);
                        return 0;
                    },
                }
            }
            Expansion ex = clone(&prog.ex);
            // D-0284/D-0285: lowered once, and again decided where it can be
            // (`generate_program`), as the driver lowers.
            Lowered lowered = generate_program(prog, false, bootstrap_level(), false, true, false);
            match (&lowered.unsupported)
            {
                Some(what) :
                {
                    eprintf("unsupported: %s\n", what);
                    return 3;
                },
                None       : {},
            }
            match (&certificate)
            {
                Some(cp) :
                {
                    String verdict = match (&lowered.gen.kept)
                    {
                        None      : "decided",
                        Some(why) : sprintf("paths kept: %s", why),
                    };
                    match (cert_finish(cp, &ex, "cobc", file, Some(verdict)))
                    {
                        Ok(_)  : {},
                        Err(e) :
                        {
                            eprintf("cobc: cannot write %s: %s\n", cp, FileError::text(&e));
                            return 2;
                        },
                    }
                },
                None     : {},
            }
            if (proto_out)
            {
                String text = proto_text(&lowered.gen);
                return write_out(&out, &text);
            }
            String c = combined(&lowered.gen, &c_name);
            match (&out)
            {
                Some(o) :
                {
                    match (write_file(o, &c))
                    {
                        Ok(_)  : 0,
                        Err(e) :
                        {
                            eprintf("cobc: cannot write %s: %s\n", o, FileError::text(&e));
                            1
                        },
                    }
                },
                None    :
                {
                    printf("%s", &c);
                    0
                },
            }
        },
        Err(r)   :
        {
            // As the driver reports one (CHG-0443; before it,
            // `rejection_text`'s one line).
            eprintf("%s", &for_stderr(&render_static(&r.raw, &r.more, &r.ex)));
            match (&certificate)
            {
                Some(cp) :
                {
                    _ = cert_finish_rejected(cp, &r.ex, "cobc", file, &r.raw);
                },
                None     : {},
            }
            1
        },
    }
}
