// D-0255: the targets `cobc --target` compiles for, and what each one
// decides: the runtime it links and where it is, the system libraries, the
// executable's name, the default C compiler and the linker's flags. Both are
// x86-64 with 64-bit addresses and little-endian byte order, so no layout
// rule depends on which. With the runtime's link knowledge (its file's name,
// the system libraries it needs), and the path operations of Rust's `Path`
// the driver uses.

import std;
import build_info;

export enum Target
{
    LinuxX64,
    WindowsX64,
}

// Each target's name.
export fn triples() : Vec<str>
{
    Vec<str> v = Vec::new();
    Vec::push(&mut v, "x86_64-unknown-linux-gnu");
    Vec::push(&mut v, "x86_64-pc-windows-gnu");
    v
}

export fn Target::parse(StringView s) : Option<Target>
{
    if (s == "x86_64-unknown-linux-gnu")
    {
        return Some(Target::LinuxX64);
    }
    if (s == "x86_64-pc-windows-gnu")
    {
        return Some(Target::WindowsX64);
    }
    None
}

// Whether this program runs on Windows: its paths there join with `\` (a
// program written in CobaltC has no test of its platform when it is built,
// and the path grammar is the platform's).
export fn on_windows() : bool
{
    path_join("a", "b") == "a\\b"
}

// The target cobc itself runs on: its own platform's programs by default.
// Never `None`: cobc, built by cobc, runs only where cobc's programs run,
// both x86-64.
export fn Target::host() : Option<Target>
{
    if (on_windows()) { Some(Target::WindowsX64) } else { Some(Target::LinuxX64) }
}

export fn Target::eq(Target a, Target b) : bool
{
    Target::windows(a) == Target::windows(b)
}

// Whether `t` is the host (`Some(t) == Target::host()`).
export fn is_host(Target t) : bool
{
    match (Target::host())
    {
        Some(h) : Target::eq(h, t),
        None    : false,
    }
}

export fn Target::triple(Target t) : str
{
    match (t)
    {
        LinuxX64   : "x86_64-unknown-linux-gnu",
        WindowsX64 : "x86_64-pc-windows-gnu",
    }
}

export fn Target::windows(Target t) : bool
{
    match (t)
    {
        WindowsX64 : true,
        LinuxX64   : false,
    }
}

// The runtime library's file name for `triple`.
export fn lib_file_for(StringView triple) : Option<str>
{
    if (triple == "x86_64-unknown-linux-gnu" || triple == "x86_64-pc-windows-gnu")
    {
        return Some("libcbrt.a");
    }
    None
}

// The system libraries the runtime needs on `triple`, as `-l` names for the C
// compiler after `-lcbrt`, less what the C compiler links on its own (libc,
// libgcc; msvcrt).
export fn link_libs_for(StringView triple) : Option<Vec<str>>
{
    Vec<str> v = Vec::new();
    if (triple == "x86_64-unknown-linux-gnu")
    {
        Vec::push(&mut v, "pthread");
        Vec::push(&mut v, "dl");
        Vec::push(&mut v, "m");
        return Some(v);
    }
    if (triple == "x86_64-pc-windows-gnu")
    {
        Vec::push(&mut v, "kernel32");
        Vec::push(&mut v, "advapi32");
        Vec::push(&mut v, "bcrypt");
        Vec::push(&mut v, "ntdll");
        Vec::push(&mut v, "userenv");
        Vec::push(&mut v, "ws2_32");
        return Some(v);
    }
    None
}

export fn Target::lib_file(Target t) : str
{
    Option::expect(lib_file_for(Target::triple(t)), "a supported target")
}

export fn Target::link_libs(Target t) : Vec<str>
{
    Option::expect(link_libs_for(Target::triple(t)), "a supported target")
}

// `prog.cb` -> `prog` (`prog.exe` for Windows).
export fn Target::exe_name(Target t, StringView stem) : String
{
    if (Target::windows(t)) { with_extension(stem, "exe") } else { String::copy(stem) }
}

// The C compiler when `--cc` names none: the platform's own natively,
// MinGW's cross compiler for Windows from Linux.
export fn Target::default_cc(Target t, Option<Target> host) : str
{
    bool host_windows = match (host)
    {
        Some(h) : Target::windows(h),
        None    : false,
    };
    match (t)
    {
        WindowsX64 : if (host_windows) { "gcc" } else { "x86_64-w64-mingw32-gcc" },
        LinuxX64   : "cc",
    }
}

// Where the runtime for this target is: beside `cobc` for its own target
// (`target/release`), else in the directory for the triple
// (`target/<triple>/release`, from `impl/cbrt/build.sh --out …`), or
// `<triple>/` beside `cobc` in an unpacked release. `cobc_dir` is the
// directory of this executable, or the one `build_info::CBRT_DIR` names.
//
// `COBALTC_CBRT_DIR`, when set and not empty, names the directory instead,
// for every target (D-0326: an instrumented runtime, or another build of
// it, chosen at run time).
export fn Target::runtime_dir(Target t, StringView cobc_dir) : String
{
    match (env_var("COBALTC_CBRT_DIR"))
    {
        Ok(Some(d)) : if (StringView::len(&d) > 0)
        {
            return d;
        },
        _ : {},
    }
    if (is_host(t))
    {
        return String::copy(cobc_dir);
    }
    String packaged = path_join(cobc_dir, Target::triple(t));
    if (exists(&path_join(&packaged, Target::lib_file(t))))
    {
        return packaged;
    }
    match (path_parent(cobc_dir))
    {
        Some(p) : path_join(
            &path_join(&p, Target::triple(t)),
            "release",
        ),
        None : packaged,
    }
}

// The command that builds the runtime this target needs, for the messages
// when it is missing or stale.
export fn Target::runtime_build(Target t) : String
{
    if (is_host(t))
    {
        return "`impl/cbrt/build.sh --out DIR`, DIR the compiler's own directory";
    }
    match (t)
    {
        WindowsX64 : "`impl/cbrt/build.sh --cc x86_64-w64-mingw32-gcc --out impl/target/x86_64-pc-windows-gnu/release`",
        LinuxX64   : "`impl/cbrt/build.sh --out impl/target/x86_64-unknown-linux-gnu/release` on Linux",
    }
}

// ---- Rust's `Path`, as far as the driver uses it ----

// Whether anything is at `p` (`Path::exists`).
export fn exists(StringView p) : bool
{
    Result::is_ok(&path_kind(p))
}

export fn is_file(StringView p) : bool
{
    match (path_kind(p))
    {
        Ok(File(_)) : true,
        _           : false,
    }
}

export fn is_dir(StringView p) : bool
{
    match (path_kind(p))
    {
        Ok(Dir) : true,
        _       : false,
    }
}

// `base.join(tail)`, an empty `base` giving `tail` alone.
export fn pjoin(StringView base, StringView tail) : String
{
    if (StringView::len(base) == 0)
    {
        return String::copy(tail);
    }
    path_join(base, tail)
}

// `Path::parent`, `None` for a root or the empty path.
export fn parent(StringView p) : Option<String>
{
    path_parent(p)
}

// `Path::with_file_name`: `p`'s last part replaced by `name`.
export fn with_file_name(StringView p, StringView name) : String
{
    match (path_parent(p))
    {
        Some(d) : pjoin(&d, name),
        None    : String::copy(name),
    }
}

// `Path::with_extension`: `p`'s extension replaced by `ext` (removed for an
// empty one), or added where it has none.
export fn with_extension(StringView p, str ext) : String
{
    String stem = match (path_stem(p))
    {
        Some(s) : s,
        None    : return String::copy(p),
    };
    String name = if (StringView::len(ext) == 0) { stem } else { sprintf("%s.%v", &stem, ext) };
    with_file_name(p, &name)
}

// `Path::file_stem`, empty for none.
export fn stem_of(StringView p) : String
{
    Option::unwrap_or(path_stem(p), String::new())
}

// `Path::file_name`, empty for none.
export fn name_of(StringView p) : String
{
    Option::unwrap_or(path_file_name(p), String::new())
}

// `fs::canonicalize`, `None` where it fails.
export fn canonical(StringView p) : Option<String>
{
    Result::ok(path_canonical(p))
}

// The directory the runtime is looked for in (`runtime_dir`'s `cobc_dir`):
// `build_info::CBRT_DIR` when set (impl/build.sh sets it to the directory of
// the cobc that built this one, where `libcbrt.a` is), else this
// executable's.
export fn runtime_home() : Result<String, String>
{
    if (StringView::len(CBRT_DIR) > 0)
    {
        return Ok(CBRT_DIR);
    }
    exe_dir()
}

// This executable's directory.
export fn exe_dir() : Result<String, String>
{
    String here = match (current_exe())
    {
        Ok(e)  : e,
        Err(e) : return Err(String::copy(FileError::text(&e))),
    };
    match (path_parent(&here))
    {
        Some(d) : Ok(d),
        None    : Err("no parent dir"),
    }
}
